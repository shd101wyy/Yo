// # Learn Yo in 10 Minutes
// Philosophy
// A combination of Lisp and C.

// Comment is using `//` or `/* */`
// Yo is case-sensitive
{
  // Content within {...} with separator `;` is a begin block
  // which is used to group expressions together
  ();
  (); // () is a unit value
};

// In Yo, everything is a function:
{
  x := true;
  y :: 14;
};

// can be written as:
{
  (:=)(x, true);
  (::)(y, 14);
};

// (:) function is used to denote a type
// (=) function is used to update a variable with a new value, or initialize a variable with a value
// (:=) function is used to denote a runtime variable with type inferred
// (::) function is used to denote a comptime variable with type inferred

x : i32;        // Define a runtime variable
compt(x) : i32; // Define a compile-time variable
// All variables are mutable by default. There is no immutable variable, for simplicity.

// Initialize variables
(compt(x) : compt_int) = 12;
(y : i32) = 14;
(z : i32) = 16;

// can be written as:

(=)((:)(compt(x), compt_int), 12);
(=)((:)(y, i32), 14);
(=)((:)(z, i32), 16);

// They are equavalent to the following:

x :: 12;
y := 14;
z := 16;


// There is no arithmetic precedence in Yo
// Except for the "." is not taking as a operator, but it has the highest precedence.
// "." has its own parsing rules, for example a.b + c.d is parsed as (. a b) + (. c d)

// Every infix operator takes two arguments on its left and right
// so the expression below is invalid
//
//   3 + 4 - 5;
//
// needs to be written as
//
3 + (4 - 5);
//
// or
(3 + 4) - 5;
// or you can use ; to separate the expressions
3 + 4; - 5; // but apparently this is not what we meant :)
// same for
//
//   3 + 4 + 5;
//
// needs to be written as
(3 + 4) + 5;
// or
(+) 3, 4, 5;
// or
(+ 3, 4, 5); // Like in Lisp! But with commas separating the arguments

// But there is a trick with newlines and operator positioning
// to control associativity without parentheses!

// RIGHT ASSOCIATIVITY: Put operator at the end of line
3 + // Newline after the operator enforces right associativity!
  4 + 5
;
// This is equivalent to
3 + (4 + 5);

// LEFT ASSOCIATIVITY: Put operator at the start of line  
  1
+ 2
+ 3
;
// This is equivalent to
(1 + 2) + 3;

// SPECIAL CASE: Operator alone on its own line uses right associativity
// This is especially useful for assignment and function definitions
(compt(result) : (fn(x: i32, y: i32) -> i32))
=
  (x, y) -> (x + y)
;
// This is parsed as: result = ((x, y) -> (x + y))
// NOT as: (result = (x, y)) -> (x + y)

// More examples of operator positioning:

// Left associativity with chained operations
result_left :=
    100
  - 20
  - 30
  - 10
;
// Parsed as: (((100 - 20) - 30) - 10) = 40

// Right associativity for building data structures
list :=
  cons(1) ++  // operator at end of line
    cons(2) ++
      cons(3) ++
        nil
;
// Parsed as: cons(1) ++ (cons(2) ++ (cons(3) ++ nil))

// Mixed associativity in complex expressions
result_mixed :=
    a
  * b
  + (c *     // parentheses to clarify right associativity
      d +
        e)
;
// Parsed as: ((a * b) + (c * (d + e)))

// Function composition examples
// Left associativity (function application order)
transformed_value :=
    x
  |> transform1
  |> transform2
  |> transform3
;
// Parsed as: (((x |> transform1) |> transform2) |> transform3)

// Right associativity (function composition)
pipeline :=
  transform1 ∘  // operator at end of line
    transform2 ∘
      transform3
;
// Parsed as: transform1 ∘ (transform2 ∘ transform3)

// Why no precedence?
// Because it makes the language easier to parse and understand
// and it's consistent with the rest of the language
// It's explicit!

// ASSOCIATIVITY RULES IN YO:
// ===========================
// 1. RIGHT ASSOCIATIVITY: Operator at END of line
//    Example: a +
//               b + c
//    Result: a + (b + c)
//
// 2. LEFT ASSOCIATIVITY: Operator at START of line (but not alone)
//    Example:   a
//             + b
//             + c  
//    Result: (a + b) + c
//
// 3. OPERATOR ALONE: Operator alone on its own line uses RIGHT associativity
//    Example: a
//             =
//               b -> c
//    Result: a = (b -> c)
//
// 4. NO NEWLINES: Ambiguous - requires explicit parentheses
//    Example: a + b + c  // ERROR - must add parentheses
//
// This system gives you precise control over parsing through formatting!

// Let's consider the following example:
//   2 ** 3 ** 4;
// Should it be evaluated as
(2 ** 3) ** 4;
// or as
// Left exponentiation: (2 ** 3) ** 4 = 64
left_exp :=
    2
  ** 3
  ** 4
;

// Right exponentiation: 2 ** (3 ** 4) = 2417851639229258349412352
right_exp :=
  2 **  // operator at end of line
    3 **
      4
;

// NOTE: All operators are method in Yo
3 + 4;
// is equavalent to
3.(+) 4;

// define a function
add :: (fn(x: i32, y: i32)-> i32) // function type is written as fn(args...)-> return_type
  x + y // calling the function type with the body will create a function value.
;
// or define the type first, then use `_` to refer the function type:
(compt(add) : (fn(x: i32, y: i32)-> i32)) = _ // `_` here referes to the function type (x: i32, y: i32)-> i32
  x + y
;

// or with anonymous function defined with `(...)` and `->`
(compt(add) : (fn(x: i32, y: i32) -> i32)) =
  (x, y)->
    x + y
;

// or with the function type first, then the function implementation:
compt(add) : (fn(x: i32, y: i32)-> i32);          // function type is written as fn(args...)-> return_type
add = 
  (x, y) -> 
    x + y;  // function implementation is written as fn(args...) -> body

// If no function type is given, the the function implementation needs to define explicit function type
compt(get_value) :
  fn(condition: bool) -> Option(i32);
get_value =
  (condition)->
    if condition,
      then: Option(i32).Some(42),
      else: Option(i32).None;

// Named parameters in function declarations with default values
create_user :: (fn( 
    name: String,
    (age: i32) ?= 18, // Use ?= operator to define a default value
    (role: String) ?= String.from("user")
  ) -> User)
  User
    name: name,
    age: age,
    role: role
;



// call a function
add(3, 4);
// or without parens
add 3, 4;
// or use named arguments.
// NOTE: The named arguments cannot be used in any order.  
add 3, y: 5; // This is allowed.
add y: 5, x: 4; // This is not allowed, because it should be `x` before `y`.  
// Call with named parameters in any order, omitting those with defaults
user1 := create_user(name: "Alice");  // age=18, role="user" (defaults)
user2 := create_user(name: "Bob", age: 30);  // explicit values

// Yo also supports the infix function application
// 3 `add` 4; // is equivalent to add(3, 4)


// Define a custom operator
(+++) :: (fn(x: i32, y: i32)->i32)
  x + y;
3 +++ 4; // 7

modify :: (fn(x: i32)-> i32) {
  x += 1;
  x
}

// block using {...} with ";" as separator
result := {
  x := 3; // block requires to have ";" inside; otherwise we treat it as a record.
  y := 4;
  add x, y // the last expression without ";" becomes the return value
}; // result is 7
// is equavalent to call `begin`
result := begin(
  x := 3,
  y := 4,
  add x, y
);
empty_block := {}   // This is not a block! It's an anonymous struct with no fields.

// You can define the tuple type using `Tuple` keyword.  
// A tuple type can have named fields or unnamed fields.
// Like the one in JavaScript.
Person :: Tuple(name: String, age: i32);
// or
Person :: (name: String; age: i32); // Use ; as the separator
// NOTE: You cannot have labelled fields in the tuple value, it's only allowed in the tuple type.
(person : Person) = (
  "John",
  30
);
name := person.name; // "John"
age := person.age;   // 30


// Tuple value is defined using (...) with "," as separator
one_element := (1,); // tuple with one element requires extra "," at the end. Otherwise, it's considered a parenthesized expression.
                      // The "." ahead of the tuple is necessary to distinguish it from a type.
pair := (1, 2); // tuple with two elements
MyTuple :: Tuple(i32, f32);
(my_tuple : MyTuple) = (1, 2.0); // tuple with two elements
my_tuple := (1, 2.0);

NamedTuple :: Tuple(x: i32, y: i32);
(named_tuple : NamedTuple) = (x: 1, y: 2); // tuple with named elements
// or without name
(named_tuple : NamedTuple) = (1, 2); // tuple with unnamed elements

// tuple elements are ordered, so the below is not valid:
(named_tuple : NamedTuple) = (y: 2, x: 1); // error: type mismatch

// access fields using "."
// by field name
named_tuple.x; // 1
// or by index
named_tuple.0; // 1

x := 1;
y := 2;
named_tuple := (x: x, y: y);

// destructure
(a, b) := named_tuple; // a: 1, b: 2
// or destructure with name
(y: y, x: x) := named_tuple; // y: 2, x: 1
// or destructurep part of the tuple
(x: x) := named_tuple; // x: 1
// or rename the field
(x: a) := named_tuple; // a: 1

// there might be ambiguity for the function that accepts tuple as its first argument
some_func :: (fn(x: (i32, i32))-> i32) {
  return x.0 + x.1;
};

// then
some_func(1, 2); // error: expected 1 argument, got 2
// and
some_func (1, 2); // Works! The whitespace is necessary here to avoid ambiguity
                  // 3
// or call it like without whitespace between the function and '('
some_func((1, 2)); // 3

// array is defined using [...] with "," as separator.
arr := [1, 2, 3]; // Array(i32, 3)
// Array: (Type, compt(_): usize)-> Type
// is equivalent to call `array`
arr := array(1, 2, 3);

// In Yo, type is the first-class citizen,
// meaning that you can assign a type to a variable, or pass it as an argument to a function.
MyI32 :: i32; // type alias
(x : MyI32) = 12; // valid
(y: i32) = x; // valid


MyPoint :: Tuple(i32, i32); // tuple type
(p : MyPoint) = (3, 4); // valid

// In Yo, you can define a struct like below:
Point :: struct(x : i32, y : i32);
p := Point 3, 4;

Point :: struct(x : i32, y : i32);
p := Point(x: 3, y: 4);
// destructure:
Point(a, b) := p; // a: 3, b: 4
/// Exact struct name
Point(y: y) := p
/// or use "_"
/// "_" here infered to Point
_(y: y) := p;       // y: 4
/// or use curly brackets "{}"
{ y, x: z } := p; // y: 4
/// { y } gets converted to _(y: y, x: z);

Cm := struct(v : i32);
x := Cm 200;

// In Yo, struct/enum/union are nominal types.
// This means that two types with the same structure are not the same type.
// For example, the following two types are different:
Point1 :: struct(x : i32, y : i32);
Point2 :: struct(x : i32, y : i32);
Point1 == Point2; // false
p1 := Point1 3, 4;
(p2: Point2) := p1; // error: type mismatch

// Anonymous struct
p := { x : 3, y : 4 }; // Create an anonymous struct value.

// Inferred struct
// "_" here means to be a placeholder for the type that could be inferred later
(p: struct(x : i32, y : i32)) := _(3, 4);
(p : Point) := _(x: 3, y: 4);
(p: struct(a: i32, b: bool)) := _(b: true, a: 3); // Valid!

// ADT (tagged union)
Color ::
  enum
    Red, // = 0
    Green,
    Blue
;
color := Color.Red; // color is of type Color

// each variant can have one type as its argument
Animal ::
  enum
    Dog(String, f64),
    Cat(name: String, weight: f64)
;
a := Animal.Dog "Buddy", 12.5;
// or use the anonymous variant liternal:
(b : Animal) = .Cat name: "Whiskers", weight: 8.5;

// Or use the anonymous tagged union literal:
(color: (enum Red, Green, Blue)) = .Red;

// union
Result ::
  union 
    int: i64,
    float: f64,
    bool: bool;

result := Result(int:12);
result.float = 3.14;
// or use the anonymous union liternal:
(result : Result) = _( int: 12 );
(result : (union a: i32, b: f64 )) = _( a: 3 );

// A more complicated example
Shape ::
  enum
    Circle(i32),
    Rectangle(width: i32, height: i32);
s := Shape.Circle 5;
s := Shape.Rectangle width: 10, height: 20;

// type as function parameter
Option :: (fn(compt(T): Type)-> compt(Type))
  enum(
    Some(T),
    None
  );

x := Option(i32).Some(12);

/*
// GADT and HKT are in design.
// 
// generalized algebraic data types (GADT)
// By default, all variants return the same type.
// You can also specify the return type for each variant
// to make it a GADT
MyExpr :: (fn(compt(T): Type)-> compt(Type))
  enum
    IntExpr:
      (i32)=> recur(i32),
    BoolExpr:
      (bool)=> recur(bool),
    EqExpr:
      (recur(i32), recur(i32))=> recur(bool)
  ;
my_eval :: (fn(compt(T): Type, expr: MyExpr(T))-> T)
  match expr,
    .IntExpr   => expr.i,
    .BoolExpr  => expr.b,
    .EqExpr => (my_eval(expr.a) == my_eval(expr.b))
;

// higher kinded types
// are types that take other types as parameter
T1 ::
  (F: (fn(compt(Type)) -> compt(Type)), compt(A): Type)-> compt(Type)
  F(A)
;
// Assume we have the `Maybe` type,
// then we can define `Option` like below
Option ::
  (compt(T): Type)-> compt(Type)
  T1(Maybe, T)
;
*/

// module
// All the fields of the module are compile-time known by default
Id :: module
  // `Self` in module here means the receiver type. 
  id:
    fn(val : Self)-> Self
;

Stringer :: module
    to_string: (fn(val : Self)-> String)
;

/// Implement the module
IdI32 :: impl i32, Id(
  id:
    (self)-> self
);

impl(forall(T : Type, U : Type), where(T <: Stringer, U <: Stringer), 
  (T, U), Stringer(
    to_string:
      ((x, y))->
        "(" + 
        x.to_string() + 
        "," + 
        y.to_string() + 
        ")"
  ));

/// method call
12.id(); // 12
(3,4).to_string(); // "(3,4)"
// or call from the module
Id(i32).id(12); // 12
Stringer((i32, i32)).to_string((3,4)); // "(3,4)"

// Implement method to a type
Cm :: struct(
  v : i32,

  // Type method:
  M :: (fn(self : Self)-> i32) {
    return self.v / 100;
  }  
);

(x : Cm) = Cm(200);
x.M(); // 2

// `forall` can be used to define generics
// e.g. without `forall` it also works:
id :: (fn(compt(T): Type, x: T)-> T) {
  return x;
};
// but when you call it, you need to specify the type:
id(i32, 12); // 12
id(bool, 12); // true
// e.g. with `forall`:
id ::
  fn(forall(T: Type), x: T)-> T {
  return x;
}

// then you can call it without specifying the type:
id(12);   // 12
id(true); // true

// Module
// Module is a block of expressions.
// The very last expression is the return value.

// arith.yo
add :: 
  (fn(x: i32, y: i32)-> i32)
  x + y;
sub ::
  (fn(x: i32, y: i32)-> i32)
  x - y;
export
  add, sub
; // export add and sub

// main.yo
{ add, sub } :: import("./arith.yo");
add(3, 4); // 7

(s : String) = String.from("Hello"); // String is `object` type with reference semantics.
s2 := s; // s2 and s point to the same object.

// RAII (Resource Acquisition Is Initialization)
// Yo automatically insert `drop` function for Linear types that are not used anymore and implement `drop` function.

// Type universe
// - ...
// - Type 2
// - Type 1
// - Type (or Type(0))
// - symbol | bool | i32 | f64 | 
//   Union | Intersection | Variant |
//   1 | 2 | 3 | 4 | ...
//    ^ Singleton Type

// Pointer
// Yo uses * for pointer type
// Yo uses & for pointer value
x := 1;
y := 2;
swap ::
  (fn(a: *(i32), b: *(i32)) -> unit) {
  tmp := a.*; // dereference the pointer
  a.* = b.*;
  b.* = tmp;
};
swap(&(x), &(y));

// do notation
// allows us to use `<-`, `<=`, `<<=` inside a block
/// do {
///   with response <= fetch("https://api.example.com");
///   std.println(response);
///   with json <= response.json();
///   std.println(json);
/// };
/// // is equavalent to
/// {
///   fetch("https://api.example.com", (response) => {
///     std.println(response);
///     response.json((json) => {
///       std.println(json);
///     });
///   });
/// };

// malloc
// There is no null pointer in Yo.
// We have ?*(i32) for nullable pointers.
// They are just the wrapper for Option(*(i32)).
(some_ptr : Option(*(i32))) = malloc(sizeof(i32)); // allocate memory for i32
match some_ptr,
  .Some(ptr) => {
    ptr.* = 42; // dereference the pointer
    std.println(ptr.*); // print the value
  },
  .None => std.println("Memory allocation failed");
free(some_ptr); // free the memory

// Control flow
/// cond
cond  (x == 1) => std.println("x is 1"),
      (x == 2) => std.println("x is 2"),
      true     => std.println("x is not 1 or 2");

/// while
factorial ::
  (fn(x: i32)-> i32) {
  result := 1;
  while x > 1, {
    result = (result * x);
    x -= 1;
  };
  result
};

//// or
factorial ::
  (fn(x: i32)-> i32) {
  result := 1;
  while x > 1,  // condition
        x = (x - 1), // step
  { // body
    result = (result * x);
  };
  result
}

/// for
/// for loop can be used to iterate over an array or slice
arr := [1, 2, 3, 4, 5];
for arr, (element, index)=> {
  println(index);
  println(element);
};
/// or using element only
for arr, element => {
  println(element);
};

// Recursion using recur
// recur is used to call the current function recursively
factorial_rec :: (fn(x: i32)-> i32)
  if x <= 1,
    then: 1,
    else: (x * recur(x - 1));  // recur calls factorial_rec recursively

// recur can also be used with named arguments
fibonacci :: (fn(n: i32)-> i32)
  if n <= 1,
    then: n,
    else: (recur(n - 1) + recur(n - 2));

// Tail recursion for better performance
factorial_tail :: (fn(x: i32, acc: i32)-> i32)
  if x <= 1,
    then: acc,
    else: recur(x - 1, x * acc);  // tail-recursive call

/// for
for 0..=10, (x)=> std.println(x); // NOTE: The last argument is **NOT** a function

// Pattern matching
match x,
  1 => std.println("x is 1"),
  2 => std.println("x is 2"),
  _ => std.println("x is not 1 or 2")

x := Option(i32).Some(12);
match x,
  .Some(value) => std.println("x is Some with value " + value),
  .None => std.println("x is None")

// Error Handling
// Yo uses the Result type for operations that may fail
// Similar to Rust, Result is a union type with Ok and Err variants

// Define the Result type as a generic type
Result :: (fn(compt(T): Type, compt(E): Type)-> compt(Type))
  enum
    Ok(T),
    Err(E)
;

// Define a standard error type
DivisionError ::
  enum
    DivideByZero,
    Overflow;

// Example: Safe division function that returns a Result
safe_div ::
  (fn(a: i32, b: i32)-> Result(i32, DivisionError))
  if b == 0,
    then: Result(i32, DivisionError).Err(.DivideByZero),
    else: Result(i32, DivisionError).Ok(a / b);

// Pattern matching for error handling
division_result := safe_div(10, 2);
match division_result,
  .Ok(value)  => std.println("Result: " + value.to_string()),
  .Err(_) => std.println("Error: Cannot divide by zero");

// Macro function definition
// all of its parameters and return type are Expr
// The `unquote` function is only allowed to be used inside the `quote` function.  
// And if the return value is declared with `unquote`, then it's a macro function.  
if :: (fn(quote(condition): Expr, 
        quote(then): Expr,
        quote(else): Expr)
      -> unqoute(Expr))
  quote(
    cond  unquote(condition) => unquote(then),
          true => unquote(else));

if x == 1, then: std.println("x is 1"), else: std.println("x is not 1");
// will be expanded to
cond  (x == 1) => std.println("x is 1"),
      true     => std.println("x is not 1");


// Architecture
// * Lexer - Tokenizer for analyzing the syntax
// * Parser - AST Generation, without caring about semantics
// * Interpreter - Type checking & Compile-time execution as much as possible
// * Compiler - Code Generation, to `C` only now

extern "C",
  printf: (fn(format: *(char), ...) -> i32);

// Compile-time Execution
PI :: 3.14159265358979323846; // PI : compt_float;

// A function returning Type or (compt(Type)) can only be executed at compile time
// Compile-time function execution
factorial :: (fn(compt(n): compt_int)
              -> compt compt_int)
  if n <= 1, then: 1, else: (n * recur(n - 1));

// This will be computed during compilation
x :: 10; // x : compt_int;
FACTORIAL_10 :: factorial(10);  // FACTORIAL_10 : compt_int

x :: 10; // x : compt_int
(y : i32) = x; // y : i32, this is a cast from compt_int to i32
// This is not allowed
(z : compt_int) = y; // error: cannot cast i32 to compt_int for variable

// Below is another example
max :: (fn(compt(T): Type, a: T, b: T)-> T)
  cond // implicit compile-time evaluate the condition if it's known at the compile-time, and skip the branch not taken.
    (T == bool) => (a || b),
    (a > b)        => a,
    true           => b;
max(bool, false, true); // compiles to:
max :: (fn(a: bool, b: bool)-> bool) {
  {
    return (a || b);
  }
};

arr :: [1, 2, 3]; // compt(arr): Array(i32, 3);
arr(0) = 10; // Update the first element to 10

(arr: Array(i32, 3)) = [1, 2, 3]; // arr: Array(i32, 3); runtime mutable
arr := [1, 2, 3]; // arr: Array(i32, 3); runtime mutable
arr := [read_input(), 2, 3]; // arr: Array(i32, 3); runtime mutable


// Type-level computation using `compt`
// A function that returns a type is called a type function.  
// The type function requires all its parameters to be `compt`.  
// The type function is pure, which means it will be cached once executed.
Matrix :: (fn(compt(T): Type, compt(ROWS): usize, compt(COLS): usize)-> compt(Type))
  Array(Array(T, COLS), ROWS)
;

// Create a 3x3 matrix of integers
(mat : Matrix(i32, 3, 3)) = [
  [1, 2, 3],
  [4, 5, 6],
  [7, 8, 9]
];
