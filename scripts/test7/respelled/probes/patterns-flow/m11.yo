// expect: E0911
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array-list");
L :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
main :: (fn() -> unit)({
  mut(xs) := ArrayList(Option(String)).new();
  xs.push(.Some(L()));
  r := xs.index(usize(0));
  p := match(r, .Some(x) => Option(&String).Some(x), .None => Option(&String).None);
  mut(i) := 0;
  while(i < 1000, { xs.push(.None); i = (i + 1); });
  match(p, .Some(x) => println(`OUT: ${x.*}`), .None => println("OUT none"));
  ()
});
export(main);
