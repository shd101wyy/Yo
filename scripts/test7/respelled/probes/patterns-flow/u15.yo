// expect: E0911
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array-list");
L :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
HS :: struct(r : &String);
DH :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(String, p)));
impl(generic(p : Origin), DH(p), Drop(drop : (fn(self : &mut Self) -> unit)({ println(`OUT drop: ${self.r.*}`); })));
main :: (fn() -> unit)({
  mut(b) := Box.new(L());
  
  match(&b, Box(s) => {
    (f : Impl(Fn() -> usize)) = ({ y : &s.* }() => y.len()); b = Box.new(L()); println(`OUT: ${f().to_string()}`);
  });
  ()
});
export(main);
