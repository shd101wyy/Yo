// expect: E0923
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
mk :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"))));
H :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(Rc(X), p), n : i32));
A :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(b : H(p), m : i32));
main :: (fn() -> unit)({
  z := mk();
  mut(a) := A(z)(b : H(z)(r : &z, n : i32(0)), m : i32(0));
  {
    y := mk();
    a.b = H(z)(r : &y, n : a.b.n);
  };
  println(`OUT: ${a.b.r.*.*.s.len().to_string()}`);
  ()
});
export(main);
