// expect: E0911
{ String } :: import("std/string");
{ println } :: import("std/fmt");
long :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
eat :: (fn(s : String) -> unit)(println(&s));
main :: (fn() -> unit)({
  x := long();
  o := Option(&String).Some(&x);
  eat(x);
  match(o, .Some(r) => println(`OUT: ${r.*.len().to_string()}`), .None => println("none"));
  ()
});
export(main);
