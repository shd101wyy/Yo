// expect: E0911
// read-walk element captured by a closure stored in an outer slot, list grown, closure called.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array-list");
{ HashMap } :: import("std/collections/hash-map");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  mut(xs) := ArrayList(String).new();
  xs.push(String.from("hello-world-hello-world-hello-world"));
  mut(slot) := Option(&String).None;
  for(&xs, x => {
    (f : Impl(Fn() -> usize)) = ({ x }() => x.len());
    slot = .Some(x);
  });
  mut(i) := usize(0);
  while(i < usize(1000), {
    xs.push(String.from("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"));
    i = (i + usize(1));
  });
  match(slot, .Some(r) => println(`OUT: ${r.*}`), .None => println("none"));
  ()
});
export(main);
