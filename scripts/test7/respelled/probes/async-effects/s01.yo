// expect: E0911 (implicit capture of a & parameter; caller consumes the argument before awaiting)
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ yield } :: import("std/async");
LONG :: "0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz";
sink :: (fn(v : String) -> unit)({ println(`sink ${v.len().to_string()}`); });
mk :: (fn(s : &String, io : Io) -> Impl(Future(unit, Io)))(
  io.async({ s : &s.* }(io : Io) => { io.await(yield(io), io); println(`OUT: ${s.*}`); })
);
main :: (fn(io : Io) -> unit)({
  x := String.from(LONG);
  f := mk(&x, io);
  sink(x);
  io.await(f, io);
});
export(main);
