// expect: E0909
// a generic fn boxes its by-value T (:= &Rc(X)) in a Box(Dyn(Fn)) and returns it; called over a local
{ String } :: import("std/string");
{ println } :: import("std/fmt");
X :: struct(s : String);
wrapd :: (fn(generic(T : Type), x : T) -> Box(Dyn(Fn() -> usize)))(dyn(Box.new({ x }() => usize(1))));
mk :: (fn() -> Box(Dyn(Fn() -> usize)))({
  s := Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz")));
  y := &s;
  wrapd(y)
});
main :: (fn() -> unit)({
  d := mk();
  println(`OUT: ${d().to_string()}`);
});
export(main);
