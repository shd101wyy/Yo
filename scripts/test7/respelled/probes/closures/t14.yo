// expect: E0909
// (tip) implicit capture of a `&T` reference binding by a returned closure (VERDICTS-44: implicit = `{ y }`)
{ String } :: import("std/string");
{ println } :: import("std/fmt");
mk :: (fn() -> Impl(Fn() -> usize))({
  s := String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
  y := &s;
  { y }() => y.clone().len()
});
main :: (fn() -> unit)({
  g := mk();
  println(`OUT: ${g().to_string()}`);
});
export(main);
