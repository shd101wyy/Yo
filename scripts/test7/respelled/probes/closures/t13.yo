// expect: E0909
// (tip) `{ y }` reference copy over a local, boxed into a Dyn(Fn) assigned to an outer slot
{ String } :: import("std/string");
{ println } :: import("std/fmt");
main :: (fn() -> unit)({
  (mut(d) : Box(Dyn(Fn() -> usize))) = dyn(Box.new({}() => usize(0)));
  {
    s := String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz");
    y := &s;
    d = dyn(Box.new({ y }() => y.clone().len()));
  };
  println(`OUT: ${d().to_string()}`);
});
export(main);
