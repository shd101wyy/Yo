Cat :: struct(s : String);
impl(Cat, Name(name : (fn(self : &Self) -> &String)(&self.s)));
Zoo :: struct(c : Cat);
_get_opt :: (fn(d : &Dyn(Name)) -> Option(&Dyn(Name)))(Option(&Dyn(Name)).Some(d));
_fwd :: (fn(d : &Dyn(Name)) -> &Dyn(Name))(&d.*);
