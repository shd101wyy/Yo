// expect: E0912
{ String } :: import("std/string");
{ RefCell } :: import("std/sync/refcell");
{ OnceCell } :: import("std/sync/once");
mem :: import("std/mem");
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array-list");
X :: struct(s : String, n : i32);
long :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"), n : i32(1))));
longs :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
Name :: trait(name : (fn(self : &Self) -> &String));
Cat :: struct(s : String);
impl(Cat, Name(name : (fn(self : &Self) -> &String)(&self.s)));
Zoo :: struct(c : Cat);
_get_opt :: (fn(d : &Dyn(Name)) -> Option(&Dyn(Name)))(Option(&Dyn(Name)).Some(d));
_fwd :: (fn(d : &Dyn(Name)) -> &Dyn(Name))(&d.*);
gid :: (fn(generic(T : Type), v : T) -> T)(v);
Hd :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(d : &(Dyn(Name), p)));
mkhold :: (fn(d : &Dyn(Name)) -> Hd(d))(Hd(d)(d : d));
_two3 :: (fn(a : &Dyn(Name), z : &mut Zoo) -> usize)({ z.c = Cat(s : longs()); a.name().len() });
get :: (fn(b : Box(Dyn(Name))) -> &String)(&b.name());
main :: (fn() -> unit)({
  println(`OUT: ${get(dyn(Box.new(Cat(s : longs())))).len().to_string()}`);
});
export(main);
