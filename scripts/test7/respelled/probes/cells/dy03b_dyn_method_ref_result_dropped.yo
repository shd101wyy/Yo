// expect: E0911
{ String } :: import("std/string");
{ RefCell } :: import("std/sync/refcell");
{ OnceCell } :: import("std/sync/once");
mem :: import("std/mem");
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array-list");
X :: struct(s : String, n : i32);
long :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"), n : i32(1))));
longs :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
Len :: trait(len_of : (fn(self : &Self) -> usize));
Hold :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(r : &(String, p)));
impl(generic(p : Origin), Hold(p), Len(len_of : (fn(self : &Self) -> usize)(self.r.len())));
Own :: struct(s : String);
impl(Own, Len(len_of : (fn(self : &Self) -> usize)(self.s.len())));
Pick :: trait(pick : (fn(self : &Self) -> &(String, self)));
impl(Own, Pick(pick : (fn(self : &Self) -> &(String, self))(&self.s)));
main :: (fn() -> unit)({
  (d : Box(Dyn(Pick))) = dyn(Box.new(Own(s : longs())));
  r := d.pick();
  drop(d);
  println(`OUT: ${r.len().to_string()}`);
});
export(main);
