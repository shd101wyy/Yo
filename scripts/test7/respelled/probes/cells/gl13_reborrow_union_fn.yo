// expect: E0911
{ String } :: import("std/string");
{ RefCell } :: import("std/sync/refcell");
{ OnceCell } :: import("std/sync/once");
mem :: import("std/mem");
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array-list");
X :: struct(s : String, n : i32);
long :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"), n : i32(1))));
longs :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
Cell :: struct(xs : ArrayList(String));
Guard :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(c : &mut(Cell, p)));
impl(Cell, borrow_mut : (fn(self : &mut Self) -> Guard(self))(Guard(self)(c : self)));
impl(generic(p : Origin), Guard(p), get : (fn(self : &Self) -> &String)(&self.c.xs(usize(0))));
mkc :: (fn() -> Cell)({
  mut(xs) := ArrayList(String).new();
  xs.push(longs());
  Cell(xs : xs)
});
get2 :: (fn(generic(p : Origin), g : &Guard(p)) -> &String)(&g.c.xs(usize(0)));
main :: (fn() -> unit)({
  mut(c) := mkc();
  g := c.borrow_mut();
  r := get2(&g);
  g.c.xs.clear();
  println(`OUT: ${r.*}`);
});
export(main);
