// expect: E0911
{ String } :: import("std/string");
{ RefCell } :: import("std/sync/refcell");
{ OnceCell } :: import("std/sync/once");
mem :: import("std/mem");
{ println } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array-list");
X :: struct(s : String, n : i32);
long :: (fn() -> Rc(X))(Rc.new(X(s : String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"), n : i32(1))));
longs :: (fn() -> String)(String.from("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz"));
H :: (fn(comptime(p) : Origin) -> comptime(Type))(struct(m : &mut(ArrayList(String), p)));
impl(generic(p : Origin), H(p), first : (fn(self : &Self) -> &String)(&self.m(usize(0))));
mkl :: (fn() -> ArrayList(String))({
  mut(xs) := ArrayList(String).new();
  xs.push(longs());
  xs
});
grow :: (fn(xs : &mut ArrayList(String)) -> unit)({
  mut(i) := i32(0);
  while(i < i32(100), i = (i + i32(1)), { xs.push(longs()); });
});
main :: (fn() -> unit)({
  mut(xs) := mkl();
  h := H(xs)(m : &mut xs);
  r := h.m.index(usize(0));
  grow(h.m);
  println(`OUT: ${r.*}`);
});
export(main);
