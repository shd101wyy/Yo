//! io_bench — the backend comparison benchmarks of plans/reference/DROP_LIBURING.md
//! Phase 6 (G2). Run via scripts/bench-io-backends.sh, which drives it under
//! YO_IO_BACKEND=uring and =epoll and prints the ratio table against the
//! floors in scripts/bench/io-floors.env. Numbers are for ONE box; the
//! script is a merge criterion and release check, not a wall-clock CI gate.
pragma(Pragma.AllowUnsafe);
{ println } :: import("std/fmt");
{ panic } :: import("std/assert");
{ String } :: import("std/string");
{ socketpair } :: import("std/sys/socketpair");
tcp :: import("std/sys/tcp");
{ AF_UNIX, SOCK_STREAM } :: import("std/sys/socket");
{ O_NONBLOCK } :: import("std/sys/constants");
{ __yo_async_send_start, __yo_async_recv_start, __yo_sync_fcntl_getfl, __yo_sync_fcntl_setfl } :: import("std/sys/externs");
{ GlobalAllocator } :: import("std/allocator");
{ malloc } :: GlobalAllocator;
{ write_string, read_to_string } :: import("std/fs/file");
{ Path } :: import("std/path");
{ sleep } :: import("std/sys/timer");
{ Instant } :: import("std/time/instant");
{ Duration } :: import("std/time/duration");
{ Exception, IoExn } :: import("std/error");
{ env } :: import("std/env");
{ AF_INET, IPPROTO_TCP, TCP_NODELAY } :: import("std/sys/socket");
{ getsockname } :: import("std/sys/sockinfo");
{ ArrayList } :: import("std/collections/array_list");

ECHO_ROUNDS :: usize(2000);
TIMER_TICKS :: usize(20000);
FILE_ITERS :: usize(400);
FILE_SIZE :: usize(16384);
ECHO_CONNS :: usize(64);
ECHO_CONN_ROUNDS :: usize(500);
ECHO1_ROUNDS :: usize(20000);

// One side of a concurrent echo connection: `server` receives then echoes,
// the client sends then waits for the echo. Every op of every connection is
// in flight at once, so this is the batching and parking case the
// sequential ping-pongs above cannot show.
_echo_side :: (fn(fd : i32, server : bool, rounds : usize, io : Io) -> Impl(Future(i32, Io)))(
  io.async((io : Io) => {
    buf := (*u8)(malloc(usize(64)).unwrap());
    (i : usize) = usize(0);
    (bad : i32) = i32(0);
    while(i < rounds, i = (i + usize(1)), {
      if(server, {
        got := io.await(__yo_async_recv_start(fd, buf, usize(64), i32(0)), io);
        if(got != i32(32), {
          bad = (bad + i32(1));
        });
        io.await(__yo_async_send_start(fd, buf, usize(32), i32(0)), io);
      }, {
        io.await(__yo_async_send_start(fd, buf, usize(32), i32(0)), io);
        got := io.await(__yo_async_recv_start(fd, buf, usize(64), i32(0)), io);
        if(got != i32(32), {
          bad = (bad + i32(1));
        });
      });
    });
    bad
  })
);

// TCP_NODELAY on both ends, as the libuv counterpart sets it: a ping-pong
// must not wait on Nagle.
_nodelay :: (fn(fd : i32, io : Io) -> unit)({
  one := (*i32)(malloc(usize(4)).unwrap());
  one.* = i32(1);
  io.await(tcp.setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, (*u8)(one), u32(4)), io);
});
// `conns` loopback-TCP connections echoing `rounds` 32-byte messages each, all
// at once; prints `<key>_us`.
_echo_bench :: (fn(conns : usize, rounds : usize, key : str, io : Io) -> unit)({
  lfd := io.await(tcp.socket(AF_INET, SOCK_STREAM, i32(0)), io);
  laddr := tcp.make_sockaddr_in_loopback(u16(0));
  if(io.await(tcp.bind(lfd, laddr.buf, laddr.len), io) != i32(0), {
    panic(String.from("bind failed"));
  });
  io.await(tcp.listen(lfd, i32(1024)), io);
  alen := (*u32)(malloc(usize(4)).unwrap());
  alen.* = laddr.len;
  getsockname(lfd, laddr.buf, alen);
  port := tcp.get_port_in(laddr.buf);
  fds := ArrayList(i32).new();
  (k : usize) = usize(0);
  while(k < conns, k = (k + usize(1)), {
    cfd := io.await(tcp.socket(AF_INET, SOCK_STREAM, i32(0)), io);
    caddr := tcp.make_sockaddr_in_loopback(port);
    if(io.await(tcp.connect(cfd, caddr.buf, caddr.len), io) != i32(0), {
      panic(String.from("connect failed"));
    });
    tcp.free_sockaddr(caddr);
    _nodelay(cfd, io);
    peer_len := (*u32)(malloc(usize(4)).unwrap());
    peer_len.* = u32(128);
    peer := (*u8)(malloc(usize(128)).unwrap());
    sfd := io.await(tcp.accept(lfd, peer, peer_len), io);
    if(sfd < i32(0), {
      panic(String.from("accept failed"));
    });
    _nodelay(sfd, io);
    fds.push(cfd);
    fds.push(sfd);
  });
  t0c := Instant.now();
  hs := ArrayList(JoinHandle(i32)).new();
  k = usize(0);
  while(k < fds.len(), k = (k + usize(2)), {
    hs.push(io.spawn(_echo_side(fds(k + usize(1)), true, rounds, io), io));
    hs.push(io.spawn(_echo_side(fds(k), false, rounds, io), io));
  });
  k = usize(0);
  while(k < hs.len(), k = (k + usize(1)), {
    if(match(hs(k).await(io), .Some(b) => (b != i32(0)), .None => true), {
      panic(String.from("echo connection failed"));
    });
  });
  conc_us := Instant.now().duration_since(t0c).as_micros();
  println(`${key}_us ${conc_us} ops ${((conns * rounds) * usize(4))}`);
  k = usize(0);
  while(k < fds.len(), k = (k + usize(1)), {
    io.await(tcp.close(fds(k)), io);
  });
  io.await(tcp.close(lfd), io);
  tcp.free_sockaddr(laddr);
});
main :: (fn(io : Io) -> unit)({
  exn := Exception(throw : (_e -> unwind(())));

  // --- socketpair ping-pong, every op completing at once ----------------------
  // AF_UNIX, not TCP: the backends' per-op overhead, not a network stack.
  sv := (*i32)(MaybeUninit(Array(i32, usize(2))).new().as_ptr());
  if(socketpair(AF_UNIX, SOCK_STREAM, i32(0), sv) != i32(0), {
    panic(String.from("socketpair failed"));
  });
  fd_a := (sv.add(usize(0))).*;
  fd_b := (sv.add(usize(1))).*;
  __yo_sync_fcntl_setfl(fd_a, __yo_sync_fcntl_getfl(fd_a) | O_NONBLOCK);
  __yo_sync_fcntl_setfl(fd_b, __yo_sync_fcntl_getfl(fd_b) | O_NONBLOCK);
  buf := (*u8)(malloc(usize(256)).unwrap());
  msg := String.from("benchmark-payload-32-bytes-xxxxxxxx");
  t0 := Instant.now();
  i := usize(0);
  while(i < ECHO_ROUNDS, {
    io.await(__yo_async_send_start(fd_a, buf, usize(32), i32(0)), io);
    io.await(__yo_async_recv_start(fd_b, buf, usize(256), i32(0)), io);
    io.await(__yo_async_send_start(fd_b, buf, usize(32), i32(0)), io);
    io.await(__yo_async_recv_start(fd_a, buf, usize(256), i32(0)), io);
    i = (i + usize(1));
  });
  pingpong_us := Instant.now().duration_since(t0).as_micros();
  println(`pingpong_us ${pingpong_us} ops ${(ECHO_ROUNDS * usize(4))}`);

  // --- socketpair ping-pong, every recv PARKED before its peer sends ----------
  // The readiness path: registration, a blocking wait, the retry (epoll) —
  // or one SQE reaped by the wait (ring). The inline case above never parks.
  t0p := Instant.now();
  i = usize(0);
  while(i < ECHO_ROUNDS, {
    rb := __yo_async_recv_start(fd_b, buf, usize(256), i32(0));
    io.await(__yo_async_send_start(fd_a, buf, usize(32), i32(0)), io);
    io.await(rb, io);
    ra := __yo_async_recv_start(fd_a, buf, usize(256), i32(0));
    io.await(__yo_async_send_start(fd_b, buf, usize(32), i32(0)), io);
    io.await(ra, io);
    i = (i + usize(1));
  });
  parked_us := Instant.now().duration_since(t0p).as_micros();
  println(`parked_us ${parked_us} ops ${(ECHO_ROUNDS * usize(4))}`);
  // --- The same socketpair as a two-task echo: libuv's shape (a reader and a
  // writer per end), with no TCP stack under it.
  t0u := Instant.now();
  hu_s := io.spawn(_echo_side(fd_b, true, ECHO1_ROUNDS, io), io);
  hu_c := io.spawn(_echo_side(fd_a, false, ECHO1_ROUNDS, io), io);
  if(match(hu_c.await(io), .Some(b) => (b != i32(0)), .None => true), {
    panic(String.from("unix echo client failed"));
  });
  if(match(hu_s.await(io), .Some(b) => (b != i32(0)), .None => true), {
    panic(String.from("unix echo server failed"));
  });
  uecho_us := Instant.now().duration_since(t0u).as_micros();
  println(`uecho_1_us ${uecho_us} ops ${(ECHO1_ROUNDS * usize(4))}`);
  io.await(tcp.close(fd_a), io);
  io.await(tcp.close(fd_b), io);

  // --- Loopback-TCP echo: one connection, then ECHO_CONNS at once -----------
  _echo_bench(usize(1), ECHO1_ROUNDS, "echo_1", io);
  _echo_bench(ECHO_CONNS, ECHO_CONN_ROUNDS, "echo_conc", io);

  // --- Timer churn -----------------------------------------------------------
  t1 := Instant.now();
  i = usize(0);
  while(i < TIMER_TICKS, {
    io.await(sleep(u64(0)), IoExn(io : io, exn : exn));
    i = (i + usize(1));
  });
  timer_us := Instant.now().duration_since(t1).as_micros();
  println(`timer_us ${timer_us} ops ${TIMER_TICKS}`);

  // --- File write/read loop --------------------------------------------------
  data := String.from("x");
  j := usize(1);
  while(j < FILE_SIZE, {
    data.push_str("x");
    j = (j + usize(1));
  });
  // A private path (the driving script's temp dir): two concurrent runs must
  // not share one file.
  dir := match(env.get(String.from("YO_BENCH_DIR")), .Some(d) => d, .None => String.from("/tmp"));
  dir.push_str("/yo_io_bench_file");
  path := Path.new(dir);
  t2 := Instant.now();
  i = usize(0);
  while(i < FILE_ITERS, {
    io.await(write_string(path, data, io), IoExn(io : io, exn : exn));
    io.await(read_to_string(path, io), IoExn(io : io, exn : exn));
    i = (i + usize(1));
  });
  file_us := Instant.now().duration_since(t2).as_micros();
  println(`file_us ${file_us} ops ${(FILE_ITERS * usize(2))} bytes ${FILE_SIZE}`);
});
export(main);
