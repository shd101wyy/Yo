//! Build the documentation website for https://shd101wyy.github.io/Yo/
//!
//! Yo rewrite of `scripts/build-site.ts` (P2.5 blocker B7, user decision
//! 2026-08-18): the last bun island in the CI workflows. Faithful port —
//! same output structure, same link-rewrite rules, same fail-loudly
//! installer contract.
//!
//! Output structure:
//!   site/
//!     index.html        ← README.md rendered as HTML (homepage)
//!     Yo_logo.png       ← copied logo
//!     install.sh        ← installer published at the site root
//!     install.ps1
//!     std/              ← generated std library docs (`yo doc std/`)
//!
//! Usage:
//!   build_site [--output <dir>] [--version <v>] [--yo <compiler>]
//!
//! `--yo` names the compiler binary used for the `doc std/` subprocess
//! (default: `yo` on PATH). The TS original shelled out to out/cjs.
pragma(Pragma.AllowUnsafe);
open(import("std/fmt"));
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ args, cwd } :: import("std/env");
{ Path } :: import("std/path");
{ read_file, write_file, exists } :: import("std/fs/file");
{ FileType, create_dir_all, read_dir, remove_dir, remove_file } :: import("std/fs/dir");
{ Command } :: import("std/process/command");
{ exit } :: import("std/libc/stdlib");
{ Exception, IoExn } :: import("std/error");
{ markdown_to_html, Options, default_options } :: import("../vendor/markdown_yo/src/lib.yo");

GITHUB_REPO :: "https://github.com/shd101wyy/Yo";

// ── Git version detection ────────────────────────────────────────────
/// Run `git <args>` in `root` and return trimmed stdout, or None on any
/// failure (mirrors the TS try/catch-to-undefined helpers).
_git :: (fn(root : String, git_args : ArrayList(String), io : Io) -> Option(String))({
  cmd := Command.new(String.from("git"));
  cmd.arg(String.from("-C"));
  cmd.arg(root.clone());
  (i : usize) = usize(0);
  while(i < git_args.len(), {
    match(git_args.get(i), .Some(a) => cmd.arg(a), .None => ());
    i = (i + usize(1));
  });
  // Any process failure unwinds _git with None (TS try/catch-to-undefined).
  silent := Exception(throw : ((_err) -> unwind(Option(String).None)));
  out := io.await(cmd.output(io), IoExn(io : io, exn : silent));
  if(!(out.status.success()), Option(String).None, {
    s := String.from_bytes(out.stdout);
    t := s.trim();
    if(t.len() == usize(0), Option(String).None, Option(String).Some(t))
  })
});
/// Exact tag on HEAD, else "develop" — used for stable GitHub blob links.
_exact_tag_or_develop :: (fn(root : String, io : Io) -> String)({
  ga := ArrayList(String).new();
  ga.push(String.from("describe"));
  ga.push(String.from("--tags"));
  ga.push(String.from("--exact-match"));
  ga.push(String.from("HEAD"));
  match(_git(root.clone(), ga, io), .Some(t) => t, .None => String.from("develop"))
});
/// Exact tag on HEAD, else the short commit hash, else None.
_detect_git_version :: (fn(root : String, io : Io) -> Option(String))({
  ga := ArrayList(String).new();
  ga.push(String.from("describe"));
  ga.push(String.from("--tags"));
  ga.push(String.from("--exact-match"));
  ga.push(String.from("HEAD"));
  match(
    _git(root.clone(), ga, io),
    .Some(t) => Option(String).Some(t),
    .None => {
      gb := ArrayList(String).new();
      gb.push(String.from("rev-parse"));
      gb.push(String.from("--short"));
      gb.push(String.from("HEAD"));
      _git(root.clone(), gb, io)
    }
  )
});

// ── HTML helpers ─────────────────────────────────────────────────────
/// One character at `i` as a String (String.at returns a rune; the scanners
/// below compare against string literals).
_ch :: (fn(s : String, i : usize) -> String)(s.substring(i, i + usize(1)));
/// First byte of a (single-character) String — ASCII classification helper.
_byte0 :: (fn(s : String) -> u8)({
  bs := s.as_bytes();
  match(bs.get(usize(0)), .Some(b) => b, .None => u8(0))
});
_escape_html :: (fn(text : String) -> String)({
  out := String.new();
  (i : usize) = usize(0);
  n := text.len();
  while(i < n, {
    c := _ch(text, i);
    cond(
      (c == "&") => out.push_str("&amp;"),
      (c == "<") => out.push_str("&lt;"),
      (c == ">") => out.push_str("&gt;"),
      (c == "\"") => out.push_str("&quot;"),
      true => out.push_string(c)
    );
    i = (i + usize(1));
  });
  out
});
/// GitHub-compatible slug: strip tags, lowercase, spaces→hyphens, drop
/// non-alphanumerics, collapse/trim hyphens.
_slugify :: (fn(text : String) -> String)({
  // Strip HTML tags.
  stripped := String.new();
  (in_tag : bool) = false;
  (i : usize) = usize(0);
  n := text.len();
  while(i < n, {
    c := _ch(text, i);
    cond(
      (c == "<") => {
        in_tag = true;
      },
      (c == ">") => {
        in_tag = false;
      },
      !(in_tag) => stripped.push_string(c),
      true => ()
    );
    i = (i + usize(1));
  });
  lowered := stripped.trim().to_lowercase();
  // Byte-wise classification: the TS regex [^a-z0-9-] drops every non-ASCII
  // character, so scanning UTF-8 bytes yields the same slug.
  bs := lowered.as_bytes();
  slug_bytes := ArrayList(u8).new();
  (last_hyphen : bool) = true; // suppress leading hyphens
  (j : usize) = usize(0);
  m := bs.len();
  while(j < m, {
    b := match(bs.get(j), .Some(x) => x, .None => u8(0));
    is_alnum := (((b >= u8(97)) && (b <= u8(122))) || ((b >= u8(48)) && (b <= u8(57))));
    cond(
      is_alnum => {
        slug_bytes.push(b);
        last_hyphen = false;
      },
      (((b == u8(32)) || (b == u8(9))) || (b == u8(45))) => {
        if(!(last_hyphen), {
          slug_bytes.push(u8(45));
          last_hyphen = true;
        });
      },
      true => ()
    );
    j = (j + usize(1));
  });
  // Trim a trailing hyphen.
  n_slug := slug_bytes.len();
  has_trailing := match(
    slug_bytes.get(n_slug - usize(1)),
    .Some(lb) => ((n_slug > usize(0)) && (lb == u8(45))),
    .None => false
  );
  if(has_trailing, {
    _p := slug_bytes.pop();
  });
  String.from_bytes(slug_bytes)
});
/// Add `id` attributes to <h1>-<h6> so #anchor links work; duplicate slugs
/// get -1, -2, … suffixes (TS injectHeadingIds).
_inject_heading_ids :: (fn(html : String) -> String)({
  counts := HashMap(String, u32).new();
  out := String.new();
  (i : usize) = usize(0);
  n := html.len();
  while(i < n, {
    c := _ch(html, i);
    (emitted : bool) = false;
    if((c == "<") && ((i + usize(3)) < n), {
      lvl := _ch(html, i + usize(2));
      lvl_b := _byte0(lvl.clone());
      is_h := ((_ch(html, i + usize(1)) == "h") && ((lvl_b >= u8(49)) && (lvl_b <= u8(54))));
      if(is_h && (_ch(html, i + usize(3)) == ">"), {
        close := `</h${lvl}>`;
        match(
          html.index_of(close, i),
          .Some(end_i) => {
            content := html.substring(i + usize(4), end_i);
            slug := _slugify(content.clone());
            count := match(counts.get(slug.clone()), .Some(k) => k, .None => u32(0));
            _c := counts.set(slug.clone(), count + u32(1));
            final_slug := if(count > u32(0), `${slug}-${count.to_string()}`, slug);
            out.push_string(`<h${lvl} id="${final_slug}">${content}</h${lvl}>`);
            i = (end_i + close.len());
            emitted = true;
          },
          .None => ()
        );
      });
    });
    if(!(emitted), {
      out.push_string(c);
      i = (i + usize(1));
    });
  });
  out
});
/// True when `s` starts with `prefix` at offset `at`.
_starts_with_at :: (fn(s : String, prefix : str, at : usize) -> bool)({
  p := String.from(prefix);
  if((at + p.len()) > s.len(), false, s.substring(at, at + p.len()) == p)
});
/// The TS rewriteReadmeLinks URL policy for a single href/src value.
_rewrite_url :: (fn(url : String, github_blob : String, is_src : bool) -> String)({
  keep := (((_starts_with_at(url, "http", usize(0)) || _starts_with_at(url, "#", usize(0))) || _starts_with_at(url, "std/", usize(0))) || _starts_with_at(url, "mailto:", usize(0)));
  cond(
    (keep && !(is_src)) => url,
    (is_src && _starts_with_at(url, "http", usize(0))) => url,
    true => {
      rel := if(_starts_with_at(url, "./", usize(0)), url.substring(usize(2), url.len()), url.clone());
      cond(
        ((rel == "Yo_logo.png") || (rel == "path_uniqueness.png")) => rel,
        is_src => `${github_blob}/${rel}?raw=true`,
        true => `${github_blob}/${rel}`
      )
    }
  )
});
/// Rewrite one attribute's URLs (href/src) through `_rewrite_url`.
/// Manual scan — the per-match decision logic rules out Regex.replace.
_rewrite_attr :: (fn(html : String, attr : str, github_blob : String, is_src : bool) -> String)({
  needle := `${attr}="`;
  out := String.new();
  (i : usize) = usize(0);
  n := html.len();
  while(i < n, {
    match(
      html.index_of(needle.clone(), i),
      .None => {
        out.push_string(html.substring(i, n));
        i = n;
      },
      .Some(at) => {
        val_start := (at + needle.len());
        match(
          html.index_of(String.from("\""), val_start),
          .None => {
            out.push_string(html.substring(i, n));
            i = n;
          },
          .Some(val_end) => {
            out.push_string(html.substring(i, val_start));
            url := html.substring(val_start, val_end);
            out.push_string(_rewrite_url(url, github_blob.clone(), is_src));
            out.push_str("\"");
            i = (val_end + usize(1));
          }
        );
      }
    );
  });
  out
});

// ── Homepage CSS / shell (verbatim from the TS) ──────────────────────
_homepage_css :: (fn() -> String)(
  `
:root {
  --bg: #fff;
  --bg-code: #f7f7f7;
  --bg-code-block: #282c34;
  --text: #1a1a1a;
  --text-secondary: #555;
  --text-code: #abb2bf;
  --accent: #4a90d9;
  --accent-hover: #357abd;
  --border: #e0e0e0;
  --border-light: #eee;
  --shadow: rgba(0,0,0,0.05);
  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --font-mono: "SF Mono", "Cascadia Code", "Fira Code", "JetBrains Mono", Consolas, monospace;
  --max-content: 860px;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #1a1a2e;
    --bg-code: #0f3460;
    --bg-code-block: #1e1e2e;
    --text: #e0e0e0;
    --text-secondary: #a0a0a0;
    --text-code: #abb2bf;
    --accent: #6cb4ee;
    --accent-hover: #8fcbff;
    --border: #2a2a4a;
    --border-light: #252545;
    --shadow: rgba(0,0,0,0.2);
  }
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.7;
  color: var(--text);
  background: var(--bg);
}

.container {
  max-width: var(--max-content);
  margin: 0 auto;
  padding: 40px 24px 80px;
}

/* Typography */
h1 { font-size: 2.2em; margin: 1em 0 0.5em; border-bottom: 2px solid var(--border); padding-bottom: 0.3em; }
h2 { font-size: 1.6em; margin: 1.5em 0 0.5em; border-bottom: 1px solid var(--border-light); padding-bottom: 0.2em; }
h3 { font-size: 1.3em; margin: 1.2em 0 0.4em; }
h4 { font-size: 1.1em; margin: 1em 0 0.3em; }
p { margin: 0.8em 0; }
ul, ol { margin: 0.8em 0 0.8em 1.5em; }
li { margin: 0.3em 0; }

a { color: var(--accent); text-decoration: none; }
a:hover { color: var(--accent-hover); text-decoration: underline; }

img { max-width: 100%; height: auto; }

code {
  font-family: var(--font-mono);
  font-size: 0.9em;
  background: var(--bg-code);
  padding: 0.15em 0.4em;
  border-radius: 4px;
}

pre {
  background: var(--bg-code-block);
  color: var(--text-code);
  padding: 16px 20px;
  border-radius: 8px;
  overflow-x: auto;
  margin: 1em 0;
  font-size: 0.9em;
  line-height: 1.5;
}

pre code {
  background: none;
  padding: 0;
  color: inherit;
}

blockquote {
  border-left: 4px solid var(--accent);
  margin: 1em 0;
  padding: 0.5em 1em;
  background: var(--bg-code);
  border-radius: 0 4px 4px 0;
}

table {
  border-collapse: collapse;
  width: 100%;
  margin: 1em 0;
}

th, td {
  border: 1px solid var(--border);
  padding: 8px 12px;
  text-align: left;
}

th {
  background: var(--bg-code);
  font-weight: 600;
}

/* Header banner */
.site-header {
  text-align: center;
  padding: 30px 0 20px;
  border-bottom: 2px solid var(--border);
  margin-bottom: 30px;
}

.site-header img {
  width: 80px;
  height: 80px;
  margin-bottom: 10px;
}

.site-header h1 {
  border: none;
  margin: 0;
  padding: 0;
  font-size: 2.5em;
}

.site-header .tagline {
  color: var(--text-secondary);
  font-size: 1.1em;
  margin-top: 8px;
}

.version-badge {
  font-size: 0.4em;
  font-weight: 500;
  color: var(--accent);
  background: var(--bg-secondary);
  padding: 2px 10px;
  border-radius: 4px;
  vertical-align: middle;
  margin-left: 8px;
}

.site-nav {
  margin-top: 16px;
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
}

.site-nav a {
  display: inline-block;
  padding: 6px 16px;
  background: var(--accent);
  color: #fff;
  border-radius: 6px;
  font-weight: 500;
  font-size: 0.95em;
}

.site-nav a:hover {
  background: var(--accent-hover);
  text-decoration: none;
}

/* Footer */
.site-footer {
  text-align: center;
  padding: 30px 0;
  margin-top: 60px;
  border-top: 1px solid var(--border);
  color: var(--text-secondary);
  font-size: 0.9em;
}
`
);
_wrap_homepage :: (fn(title : String, body_html : String, css : String, version : Option(String), github_blob : String) -> String)({
  version_badge := match(
    version,
    .Some(v) => `<span class="version-badge">${_escape_html(v)}</span>`,
    .None => String.new()
  );

  `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>${_escape_html(title)}</title>
  <style>${css}</style>
</head>
<body>
  <div class="container">
    <div class="site-header">
      <img src="Yo_logo.png" alt="Yo logo" width="80" height="80">
      <h1>Yo Programming Language ${version_badge}</h1>
      <p class="tagline">A general-purpose, ahead-of-time compiled language with algebraic effects</p>
      <div class="site-nav">
        <a href="${GITHUB_REPO}">GitHub</a>
        <a href="std/index.html">Standard Library</a>
        <a href="${github_blob}/docs/en-US/DESIGN.md">Language Design</a>
      </div>
    </div>
    <div class="readme-content">
${body_html}
    </div>
    <div class="site-footer">
      <p>Yo Programming Language &mdash; <a href="${GITHUB_REPO}">GitHub</a> &middot; <a href="std/index.html">Std Library Docs</a></p>
    </div>
  </div>
</body>
</html>`
});

// ── Filesystem helpers ───────────────────────────────────────────────
_copy_file :: (fn(src : String, dest : String, ie : IoExn) -> unit)({
  bytes := ie.io.await(read_file(Path.new(src.clone()), ie.io), ie);
  ie.io.await(write_file(Path.new(dest.clone()), String.from_bytes(bytes), ie.io), ie);
  ()
});
_remove_dir_recursive :: (fn(dir : String, ie : IoExn) -> unit)({
  entries := ie.io.await(read_dir(Path.new(dir.clone()), ie.io), ie);
  (i : usize) = usize(0);
  while(i < entries.len(), {
    match(
      entries.get(i),
      .Some(e) => {
        child := `${dir}/${e.name}`;
        match(
          e.file_type,
          .Directory => recur(child, ie),
          _ => {
            ie.io.await(remove_file(Path.new(child.clone()), ie.io), ie);
          }
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  ie.io.await(remove_dir(Path.new(dir.clone()), ie.io), ie);
  ()
});
_dir_size_kb :: (fn(dir : String, ie : IoExn) -> u64)({
  (total : u64) = u64(0);
  entries := ie.io.await(read_dir(Path.new(dir.clone()), ie.io), ie);
  (i : usize) = usize(0);
  while(i < entries.len(), {
    match(
      entries.get(i),
      .Some(e) => {
        child := `${dir}/${e.name}`;
        match(
          e.file_type,
          .Directory => {
            total = (total + recur(child, ie));
          },
          _ => {
            bytes := ie.io.await(read_file(Path.new(child.clone()), ie.io), ie);
            total = (total + u64(bytes.len()));
          }
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  total
});
/// Inject the "← Home" link into a generated doc page's sidebar header.
_inject_home_link :: (fn(file : String, home_href : str, ie : IoExn) -> unit)({
  file_exists := ie.io.await(exists(Path.new(file.clone()), ie.io), ie.io);
  if(file_exists, {
    bytes := ie.io.await(read_file(Path.new(file.clone()), ie.io), ie);
    content := String.from_bytes(bytes);
    marker := String.from("<div class=\"sidebar-header\">");
    link := `<a href="${home_href}" style="display:block;margin-bottom:8px;font-size:0.85em;color:var(--text-secondary);text-decoration:none;">← Home</a>`;
    match(
      content.index_of(marker.clone()),
      .Some(at) => {
        updated := String.new();
        updated.push_string(content.substring(usize(0), at + marker.len()));
        updated.push_string(`\n  ${link}`);
        updated.push_string(content.substring(at + marker.len(), content.len()));
        ie.io.await(write_file(Path.new(file.clone()), updated, ie.io), ie);
      },
      .None => ()
    );
  });
  ()
});

// ── Main ─────────────────────────────────────────────────────────────
main :: (fn(io : Io) -> unit)({
  exn := Exception(
    throw : (
      (err) -> {
        eprintln(`build-site: error: ${err.to_string()}`);
        unsafe(exit(int(1)));
        unwind();
      }
    )
  );
  ie := IoExn(io : io, exn : exn);
  root := match(
    cwd(),
    .Ok(p) => p.to_string(),
    .Err(e) => {
      exn.throw(dyn(`build-site: cannot determine cwd: ${e}`));
      String.new()
    }
  );
  (output_dir : String) = `${root}/site`;
  (site_version : Option(String)) = Option(String).None;
  (yo_bin : String) = String.from("yo");
  argv := args();
  (ai : usize) = usize(1);
  while(ai < argv.len(), {
    a := match(argv.get(ai), .Some(x) => x, .None => String.new());
    next := match(argv.get(ai + usize(1)), .Some(x) => Option(String).Some(x), .None => Option(String).None);
    cond(
      (a == "--output") => match(
        next,
        .Some(v) => {
          output_dir = v;
          ai = (ai + usize(1));
        },
        .None => ()
      ),
      (a == "--version") => match(
        next,
        .Some(v) => {
          site_version = Option(String).Some(v);
          ai = (ai + usize(1));
        },
        .None => ()
      ),
      (a == "--yo") => match(
        next,
        .Some(v) => {
          yo_bin = v;
          ai = (ai + usize(1));
        },
        .None => ()
      ),
      true => ()
    );
    ai = (ai + usize(1));
  });
  if(site_version.is_none(), {
    site_version = _detect_git_version(root.clone(), io);
  });
  // Use the explicit version for blob links when it looks like a tag;
  // otherwise the exact tag on HEAD; otherwise "develop".
  looks_like_tag := match(
    site_version,
    .Some(v) => ((v.len() >= usize(2)) && ((_ch(v, usize(0)) == "v") && ((_byte0(_ch(v, usize(1))) >= u8(48)) && (_byte0(_ch(v, usize(1))) <= u8(57))))),
    .None => false
  );
  github_ref := if(
    looks_like_tag,
    match(site_version, .Some(v) => v.clone(), .None => String.from("develop")),
    _exact_tag_or_develop(root.clone(), io)
  );
  github_blob := `${GITHUB_REPO}/blob/${github_ref}`;
  println(String.from("Building documentation site..."));
  println(`  Output: ${output_dir}`);
  // Clean and create the output directory.
  out_exists := io.await(exists(Path.new(output_dir.clone()), io), io);
  if(out_exists, {
    _remove_dir_recursive(output_dir.clone(), ie);
  });
  io.await(create_dir_all(Path.new(output_dir.clone()), io), ie);
  // ── Step 1: README.md → homepage ──
  println(String.from("\n[1/3] Rendering homepage from README.md..."));
  readme_bytes := io.await(read_file(Path.new(`${root}/README.md`), io), ie);
  readme_src := String.from_bytes(readme_bytes);
  (opts : Options) = default_options();
  opts.html = true;
  opts.enable_subscript = true;
  opts.enable_superscript = true;
  opts.enable_deflist = true;
  opts.enable_admonition = true;
  opts.enable_callout = true;
  opts.enable_footnote = true;
  (readme_html : String) = markdown_to_html(readme_src.clone(), &(opts));
  readme_html = _inject_heading_ids(readme_html);
  // The generated-docs link points into the same site.
  readme_html = readme_html.replace_all(
    String.from("href=\"https://shd101wyy.github.io/Yo/\""),
    String.from("href=\"std/index.html\"")
  );
  readme_html = _rewrite_attr(readme_html, "href", github_blob.clone(), false);
  readme_html = _rewrite_attr(readme_html, "src", github_blob.clone(), true);
  homepage := _wrap_homepage(String.from("Yo Programming Language"), readme_html, _homepage_css(), site_version.clone(), github_blob.clone());
  io.await(write_file(Path.new(`${output_dir}/index.html`), homepage, io), ie);
  println(String.from("  ✓ index.html"));
  // ── Step 2: static assets ──
  println(String.from("\n[2/3] Copying static assets..."));
  logo := `${root}/Yo_logo.png`;
  logo_exists := io.await(exists(Path.new(logo.clone()), io), io);
  if(logo_exists, {
    _copy_file(logo.clone(), `${output_dir}/Yo_logo.png`, ie);
    println(String.from("  ✓ Yo_logo.png"));
  });
  pu := `${root}/path_uniqueness.png`;
  pu_exists := io.await(exists(Path.new(pu.clone()), io), io);
  if(pu_exists, {
    _copy_file(pu.clone(), `${output_dir}/path_uniqueness.png`, ie);
    println(String.from("  ✓ path_uniqueness.png"));
  });
  // Installers at the site ROOT — FAIL LOUDLY if missing: a silently absent
  // installer turns the documented one-liner into curl piping a 404 into sh.
  installers := ArrayList(String).new();
  installers.push(String.from("install.sh"));
  installers.push(String.from("install.ps1"));
  (ii : usize) = usize(0);
  while(ii < installers.len(), {
    inst := match(installers.get(ii), .Some(x) => x, .None => String.new());
    src := `${root}/scripts/${inst}`;
    src_exists := io.await(exists(Path.new(src.clone()), io), io);
    if(!(src_exists), {
      exn.throw(dyn(`build-site: scripts/${inst} is missing. The published site would serve a 404 at /${inst}, and the documented one-liner pipes that into a shell. Refusing to build.`));
    });
    _copy_file(src.clone(), `${output_dir}/${inst}`, ie);
    println(`  ✓ ${inst}`);
    ii = (ii + usize(1));
  });
  // ── Step 3: std library docs (subprocess: `yo doc std/`) ──
  println(String.from("\n[3/3] Generating standard library documentation..."));
  std_out := `${output_dir}/std`;
  doc_cmd := Command.new(yo_bin.clone());
  doc_cmd.arg(String.from("doc"));
  doc_cmd.arg(String.from("std/"));
  doc_cmd.arg(String.from("--output"));
  doc_cmd.arg(std_out.clone());
  match(
    site_version,
    .Some(v) => {
      doc_cmd.arg(String.from("--version"));
      doc_cmd.arg(v.clone());
    },
    .None => ()
  );
  doc_status := io.await(doc_cmd.status(io), ie);
  if(!(doc_status.success()), {
    exn.throw(dyn(`build-site: '${yo_bin} doc std/' failed with exit code ${doc_status.code().to_string()}`));
  });
  println(String.from("  ✓ Standard library docs generated"));
  // Post-process: "← Home" links in the sidebar headers.
  _inject_home_link(`${std_out}/index.html`, "../index.html", ie);
  module_dir := `${std_out}/module`;
  module_dir_exists := io.await(exists(Path.new(module_dir.clone()), io), io);
  (module_count : usize) = usize(0);
  if(module_dir_exists, {
    entries := io.await(read_dir(Path.new(module_dir.clone()), io), ie);
    module_count = entries.len();
    (mi : usize) = usize(0);
    while(mi < entries.len(), {
      match(
        entries.get(mi),
        .Some(e) => {
          if(e.name.ends_with(".html"), {
            _inject_home_link(`${module_dir}/${e.name}`, "../../index.html", ie);
          });
        },
        .None => ()
      );
      mi = (mi + usize(1));
    });
  });
  // ── Summary ──
  println(String.from("\n✓ Site built successfully!"));
  println(`  Homepage: ${output_dir}/index.html`);
  println(`  Std docs: ${std_out}/index.html (${module_count.to_string()} modules)`);
  size_kb := (_dir_size_kb(output_dir.clone(), ie) / u64(1024));
  println(`  Total size: ${size_kb.to_string()} KB`);
  ()
});
export(main);
