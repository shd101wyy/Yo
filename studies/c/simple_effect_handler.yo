// From ./simple_effect_handler.c

type jmp_buf: Type;

extern "C" {
  setjmp: (env: jmp_buf) -> i32;
  longjmp: (env: jmp_buf, val: i32) -> void;
}

let InitEffectOperation = 0;
let ResumeEffectOperation = 1;
let AbortEffectOperation = 2;


type EffectJmpBuf = {
  env: &jmp_buf,
  value: @any,
  root: Option<&EffectJmpBuf>, // If it's option that takes a reference, we can convert it to "void*". None means nullptr
}

let safeDivide = (
  a: i32,
  b: i32,
  parent: @EffectJmpBuf,
  throw: (msg: symbol, buffer: @EffectJmpBuf)-> unit)-> i32 {
    if (b == 0) {
      var throwEnv: jmp_buf;
      var throwResumeResult: i32;
      // var throwAbortResult: f64;
      var c: i32;
      let jmp = setjmp(throwEnv);
      if (jmp == InitEffectOperation) {
        throw("Division by zero", EffectJmpBuf {
          env: &throwEnv,
          value: @throwResumeResult,
          // abortValue: @throwAbortResult,
          root: match(parent.root) {
            Some -> parent.root,
            None -> parent
          }
        });
      } else if (jmp == ResumeEffectOperation) {
        // Resume
        c = throwResumeResult;
        println("Resumed from throw");
      } else if (jmp == AbortEffectOperation) {
        // Abort
        println("Aborted from throw");
        longjmp(parent.env, AbortEffectOperation);
      }
      a / c
    } else {
      a / b
    }
}

// Effect handler
let throw = (msg: symbol, buffer: @EffectJmpBuf)-> unit {
  // resume(1);
  (buffer.value as @i32) = 1;
  longjmp(buffer.env, InitEffectOperation);

  // abort(6.6);
  (buffer.root.value as @f64) = 6.6;
  longjmp(buffer.env, AbortEffectOperation);
}

let main = ()-> {
  var env: jmp_buf;
  // var tryResumeResult: i32;
  var tryAbortResult: f64;
  var result: f64;

  let jmp = setjmp(env);
  if (jmp == InitEffectOperation) {
    let x = safeDivide(10, 0, EffectJmpBuf {
      env: &env,
      value: @tryAbortResult,
      root: None
    }, throw);
    println("Done with safeDivide");
    result = x * 2.0;
  } else if (jmp == AbortEffectOperation) {
    println("Aborted from safeDivide");
    result = tryAbortResult;
  } else if (jmp == ResumeEffectOperation) {
    // Shouldn't enter here
  }
  println("Result: " + result);
}