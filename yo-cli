#!/usr/bin/env bash
set -euo pipefail

# Simple wrapper for running the TypeScript yo CLI via bun.
# Usage: ./yo-cli <command> [args...]

# Resolve the directory this script lives in and run from there.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# Save the user's original working directory before cd
export YO_ORIGINAL_CWD="${PWD}"

cd "$SCRIPT_DIR" || exit 1

# Allow overriding `bun` executable via the BUN environment variable.
: "${BUN:=bun}"

if ! command -v "$BUN" >/dev/null 2>&1; then
	echo "Error: 'bun' not found in PATH. Install bun or set the BUN environment variable to its path."
	exit 127
fi

if [ "$#" -eq 0 ]; then
	echo "Usage: $0 <command> [args...]"
	echo "Forwards to: $BUN run src/yo-cli.ts <command> [args...]"
	exit 2
fi

# Exec so this process is replaced by bun (pass-through of exit code).
exec "$BUN" run src/yo-cli.ts "$@"
