//! Build the Yo compiler with its own build system.
//!
//! P2.2 of `plans/archive/SELF_HOSTING_COMPLETION.md`: this file makes `yo build` the
//! canonical way to build the compiler — it replaced both `bun run build` (the
//! retired TypeScript reference) and the raw `yo compile src/main.yo
//! --optimize 2` invocation — and doubles as the P1 build-system parity
//! acceptance test.
//!
//! Steps:
//!   yo build            → compile the self-hosted compiler (install step)
//!   yo build test       → run the FAST language suite: tests/internal (each
//!                         of its 58 files compiles the whole compiler) and
//!                         tests/cli-cases (differential fixtures, not
//!                         standalone tests) are excluded via
//!                         TestSuite.exclude — same set as the CI fast-suite
//!                         jobs' `yo test ./tests --exclude ...` invocation.
build :: import("std/build");

// ReleaseSmall maps to plain `-O2` — byte-for-byte the flags of today's
// canonical `yo compile src/main.yo --optimize 2` build (release mode +
// -O2; see the `optimize_num` mapping in src/build_runner.yo —
// release-small → "2", and release-safe would instead drop the release flag).
// NOT Debug: a -O0 compiler binary hits the 1 GiB main-stack ceiling on deep
// comptime recursion (AGENTS.md "Common Pitfalls").
// Allocator per HOST platform, matching the settled release-bundle decisions:
// macOS measured vendored mimalloc v3 slower AND fatter than libsystem, so the
// macOS bundles ship `system` (release.yml seed-cross-emit matrix); Windows
// dropped mimalloc entirely (plans/reference/WINDOWS_ALLOCATOR_DECISION.md). Linux keeps
// mimalloc — the bundles are musl-only and musl's malloc is far slower — and
// that matches the Linux CI legs' explicit `--allocator mimalloc`.
// Re-measured 2026-08-22 (M4, `check ./src --std-path ./std`): mimalloc-v3
// binary 225.6 s / 16.0 GB footprint vs system 97.5 s / 14.4 GB — the v3
// abandoned-page reclaim-on-free path alone was ~40% of user CPU
// (issues/fixed/macos-yo-build-still-mimalloc-despite-settled-decision.md).
host_allocator :: cond(
  (
    (build.target_host == build.CompilationTarget.X86_64_Unknown_Linux_Gnu)
    || (build.target_host == build.CompilationTarget.X86_64_Unknown_Linux_Musl)
    || (build.target_host == build.CompilationTarget.Aarch64_Unknown_Linux_Gnu)
    || (build.target_host == build.CompilationTarget.Aarch64_Unknown_Linux_Musl)
  ) => build.Allocator.Mimalloc,
  true => build.Allocator.System
);

yo_exe :: build.executable({
  name : "yo",
  root : "./src/main.yo",
  optimize : build.Optimize.ReleaseSmall,
  allocator : host_allocator
});

tests :: build.test({
  name : "language-tests",
  root : "./tests/",
  exclude : "tests/internal,tests/cli-cases"
});

install :: build.step("install", "Build the self-hosted compiler");
install.depend_on(yo_exe);

test_step :: build.step("test", "Run the language test suite");
test_step.depend_on(tests);
