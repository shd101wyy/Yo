//! Object (reference-semantics struct) constructor emission.
//!
//! For each concrete `object(...)` type, emit `__yo_new_<cName>(...)`: malloc
//! the struct, initialize the RC header (ref_count = 1, borrow_count = 0), stamp
//! the dispose type-tag (via the dispose_type_ids side-table), and assign each
//! runtime field. Generic objects (any runtime field containing a SomeType) are
//! skipped — only concrete instantiations get constructors.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue, no_types, no_labels } :: import("../../types/definitions.yo");
{ is_reference_struct_type, is_reference_enum_type, is_unit_type, is_cell_primitive_type } :: import("../../types/guards.yo");
{ type_contains_some_type } :: import("../../types/utils.yo");
{ get_type_string, get_runtime_struct_fields, sanitize_for_c_identifier, c_variant_member_name, get_enum_variant_c_name, RuntimeStructField } :: import("../utils/index.yo");
{ FunctionGenerationContext } :: import("./context.yo");
{ get_dispose_function_for_type, dispose_function_takes_pointer } :: import("../exprs/drop_dup.yo");
/// True if any runtime field of `struct_type` contains a SomeType (generic).
_has_generic_fields :: (fn(fields : &ArrayList(RuntimeStructField)) -> bool)({
  n := fields.len();
  (mut(i) : usize) = usize(0);
  (mut(found) : bool) = false;
  while((i < n) && !found, {
    match(
      fields.get(i),
      .Some(field) => if(type_contains_some_type(&field.ty), {
        found = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// The `void*` thunk the type-tag dispose dispatch calls for a `___dispose`
/// that takes its receiver through a pointer.
///
/// The dispatch calls every entry as `void (*)(void*)`, but a `___dispose`
/// method is defined with its typed `self` pointer. Calling a function through an incompatible pointer type is
/// undefined behavior (C11 6.5.2.2p9), and UBSan's `-fsanitize=function`
/// aborted on the first release
/// (issues/fixed/runtime-callbacks-are-called-through-an-incompatible-function-pointer-type.md).
/// So the dispatch calls a `void*` thunk that forwards to the typed function.
/// Each thunk is emitted once, before the first constructor that stores it.
/// The constructor block is one contiguous region (copied verbatim into the
/// shared header in chunk mode), so emission order is first-use order. Call it
/// BEFORE the constructor's signature line.
///
/// `self_c_type` is the handle's C type when the `___dispose` takes its
/// receiver through a pointer (a `Drop` impl's `self : &mut Self`,
/// `dispose_function_takes_pointer`): the thunk then passes the address of a
/// local holding the handle. Empty for a by-value receiver.
dispose_fn_thunk :: (fn(dispose_c_name : &String, self_c_type : &String, context : &mut FunctionGenerationContext) -> String)({
  thunk := `__yo_dispose_thunk_${dispose_c_name}`;
  if(!context.base.dispose_thunks.contains(thunk.clone()), {
    context.base.dispose_thunks.insert(thunk.clone());
    if(self_c_type.is_empty(), {
      context.base.emitter.emit_string_line(`static inline void ${thunk}(void* ptr) { ${dispose_c_name}(ptr); }`);
    }, {
      context.base.emitter.emit_string_line(`static inline void ${thunk}(void* ptr) { ${self_c_type} __yo_self = (${self_c_type})ptr; ${dispose_c_name}(&__yo_self); }`);
    });
  });
  thunk
});
/// Emit the constructor function for a single concrete object type.
_generate_one_constructor :: (fn(type : &TypeValue, c_name : &String, context : &mut FunctionGenerationContext) -> unit)({
  runtime_fields := get_runtime_struct_fields(type);
  if(_has_generic_fields(&runtime_fields), {
    return();
  });
  mut(constructor_name) := String.from("__yo_new_");
  constructor_name.push_string(c_name.clone());
  // Parameter list: "<fieldType> <fieldName>, ..." — a `unit` field has no C
  // member and takes no parameter (the ctor CALL skips the same fields:
  // exprs/other_fn_call.yo, exprs/comptime_value.yo).
  mut(params) := String.from("");
  nf := runtime_fields.len();
  (mut(pi) : usize) = usize(0);
  (mut(any_param) : bool) = false;
  while(pi < nf, {
    match(
      runtime_fields.get(pi),
      .Some(field) => if(!is_unit_type(&field.ty), {
        if(any_param, {
          params.push_str(", ");
        });
        any_param = true;
        params.push_string(get_type_string(&field.ty, &mut context.base));
        params.push_str(" ");
        params.push_string(sanitize_for_c_identifier(field.label.clone(), false));
      }),
      .None => ()
    );
    pi = (pi + usize(1));
  });
  dispose_opt := get_dispose_function_for_type(type, context);
  // A `Drop` impl's `___dispose` takes `&mut Self` (a pointer): it is always
  // reached through a thunk that passes the handle's address.
  dispose_ptr := dispose_function_takes_pointer(type);
  dispose_self_c := if(dispose_ptr, get_type_string(type, &mut context.base), String.new());
  (dispose_thunk : String) = match(
    &dispose_opt,
    .Some(dn) => if(dispose_ptr, dispose_fn_thunk(&dn.*, &dispose_self_c, context), String.new()),
    .None => String.new()
  );
  // A cell primitive's constructor takes the allocator as its first
  // parameter (`__yo_cell(V)(v, alloc)`, plans/VALUES_BY_DEFAULT.md §3.5):
  // the call site passes the explicit allocator's `{ctx, vtable}`, or the
  // global one for `.None`. Every other object is global
  // (plans/backlog/ALLOCATOR_PLACEMENT.md: there is no allocation scope).
  is_cell := is_cell_primitive_type(type);
  // Signature + malloc.
  mut(sig) := String.from("static ");
  sig.push_string(c_name.clone());
  sig.push_str("* ");
  sig.push_string(constructor_name.clone());
  sig.push_str("(");
  if(is_cell, {
    sig.push_str("__yo_alloc_scope_t __yo_sc");
    if(any_param, {
      sig.push_str(", ");
    });
  });
  sig.push_string(&params);
  sig.push_str(") {");
  context.base.emitter.emit_string_line(&sig);
  mut(alloc) := String.from("  ");
  alloc.push_string(c_name.clone());
  alloc.push_str("* obj = (");
  alloc.push_string(c_name.clone());
  alloc.push_str("*)");
  alloc.push_string(if(is_cell, context.base.rc_alloc_in_call(&String.from("__yo_sc"), c_name), `__yo_rc_alloc(sizeof(${c_name}))`));
  alloc.push_str(";");
  context.base.emitter.emit_string_line(&alloc);
  // RC header.
  context.base.emitter.emit_string_line(
    if(
      is_cell,
      String.from("  obj->header.ref_count = 1u | __yo_rc_tag_of(__yo_sc);  // One reference; the tag marks an explicit allocator's block"),
      String.from("  obj->header.ref_count = 1u;  // One reference")
    )
  );
  context.base.emitter.emit_string_line(String.from("  obj->header.borrow_count = 0;  // Law-of-Exclusivity: no live interior borrows yet"));
  // Dispose type-tag.
  match(
    dispose_opt,
    .Some(dispose_c_name) => {
      dispose_id := context.base.dispose_type_id_for(if(dispose_ptr, dispose_thunk.clone(), dispose_c_name.clone()));
      line := String.from("  obj->header.type_id = ");
      line.push_string(dispose_id.to_string());
      line.push_str(";");
      context.base.emitter.emit_string_line(&line);
    },
    .None => context.base.emitter.emit_string_line(String.from("  obj->header.type_id = 0;"))
  );
  // Initialize fields (a `unit` field has no member to store into).
  (fi : usize) = usize(0);
  while(fi < nf, {
    match(
      runtime_fields.get(fi),
      .Some(field) => if(!is_unit_type(&field.ty), {
        fname := sanitize_for_c_identifier(field.label.clone(), false);
        line := String.from("  obj->");
        line.push_string(fname.clone());
        line.push_str(" = ");
        line.push_string(fname.clone());
        line.push_str(";");
        context.base.emitter.emit_string_line(&line);
      }),
      .None => ()
    );
    fi = (fi + usize(1));
  });
  context.base.emitter.emit_string_line(String.from("  return obj;"));
  context.base.emitter.emit_string_line(String.from("}"));
  context.base.emitter.emit_string_line(String.from(""));
});
/// Generate constructor implementations for every concrete object type.
generate_ref_struct_constructor_functions :: (fn(context : &mut FunctionGenerationContext) -> unit)({
  // A live cursor walk of the registry, not a borrowed `for`: the body can
  // register a late type (the on-demand hook), which a borrowed walk refuses.
  vals_cur := context.base.types.walk_start();
  while(context.base.types.walk_valid(&vals_cur), vals_cur = context.base.types.walk_next(&vals_cur), {
    vals_key := context.base.types.walk_ref(&vals_cur).key.clone();
    match(
      context.base.get_type_entry(&vals_key),
      .Some(entry) => if(is_reference_struct_type(&entry.ty), {
        _generate_one_constructor(&entry.ty, entry.c_name.clone(), context);
      }),
      .None => ()
    );
  });
});
/// Emit the per-variant constructor functions for ONE reference-semantics enum.
/// Each `__yo_new_<cName>_<variant>(fields…)` heap-allocates the RC handle,
/// initializes the reference-count header (and the dispose type-tag, mirroring
/// the object path), sets the tag and the active variant's data, and
/// returns the pointer.
_generate_one_ref_enum_constructor_set :: (fn(type : &TypeValue, c_name : &String, context : &mut FunctionGenerationContext) -> unit)({
  // Skip generic enums that still contain SomeType parameters.
  if(type_contains_some_type(type), {
    return();
  });
  // Dispose dispatch is shared across all variants (depends on the type).
  dispose_opt := get_dispose_function_for_type(type, context);
  // A `Drop` impl's `___dispose` takes `&mut Self` (a pointer): it is always
  // reached through a thunk that passes the handle's address.
  dispose_ptr := dispose_function_takes_pointer(type);
  dispose_self_c := if(dispose_ptr, get_type_string(type, &mut context.base), String.new());
  (dispose_thunk : String) = match(
    &dispose_opt,
    .Some(dn) => if(dispose_ptr, dispose_fn_thunk(&dn.*, &dispose_self_c, context), String.new()),
    .None => String.new()
  );
  match(
    type,
    Rc(.EnumT({ variant_names, variant_fields, variant_field_labels })) => {
      nv := variant_names.len();
      (vi : usize) = usize(0);
      while(vi < nv, {
        vname := match(variant_names.get_cloned(vi), .Some(v) => v, .None => String.from(""));
        fields := match(variant_fields.get(vi), .Some(f) => f, .None => no_types());
        labels := match(variant_field_labels.get(vi), .Some(l) => l, .None => no_labels());
        nf := fields.len();
        // Parameter list from the variant's non-unit fields.
        params := String.from("");
        (emitted : usize) = usize(0);
        (pi : usize) = usize(0);
        while(pi < nf, {
          match(
            fields.get(pi),
            .Some(ft) => if(!is_unit_type(&ft), {
              if(emitted > usize(0), {
                params.push_str(", ");
              });
              flabel := match(labels.get_cloned(pi), .Some(l) => l, .None => String.from(""));
              params.push_string(get_type_string(&ft, &mut context.base));
              params.push_str(" ");
              params.push_string(sanitize_for_c_identifier(&flabel, false));
              emitted = (emitted + usize(1));
            }),
            .None => ()
          );
          pi = (pi + usize(1));
        });
        // Signature + malloc.
        context.base.emitter.emit_string_line(`static ${c_name}* __yo_new_${c_name}_${vname}(${params}) {`);
        context.base.emitter.emit_string_line(`  ${c_name}* obj = (${c_name}*)__yo_rc_alloc(sizeof(${c_name}));`);
        context.base.emitter.emit_string_line(`  obj->header.ref_count = 1u;  // One reference`);
        context.base.emitter.emit_string_line(`  obj->header.borrow_count = 0;  // Law-of-Exclusivity: no live interior borrows yet`);
        // Dispose type-tag.
        match(
          dispose_opt.clone(),
          .Some(dispose_c_name) => {
            dispose_id := context.base.dispose_type_id_for(if(dispose_ptr, dispose_thunk.clone(), dispose_c_name.clone()));
            context.base.emitter.emit_string_line(`  obj->header.type_id = ${dispose_id.to_string()};`);
          },
          .None => context.base.emitter.emit_string_line(`  obj->header.type_id = 0;`)
        );
        // Tag + active variant's non-unit field assignments.
        tag_c := get_enum_variant_c_name(type, vname.clone(), &context.base);
        context.base.emitter.emit_string_line(`  obj->tag = ${tag_c};`);
        (fi : usize) = usize(0);
        while(fi < nf, {
          match(
            fields.get(fi),
            .Some(ft) => if(!is_unit_type(&ft), {
              flabel := match(labels.get_cloned(fi), .Some(l) => l, .None => String.from(""));
              fname := sanitize_for_c_identifier(&flabel, false);
              context.base.emitter.emit_string_line(`  obj->data.${c_variant_member_name(vname.clone())}.${fname} = ${fname};`);
            }),
            .None => ()
          );
          fi = (fi + usize(1));
        });
        context.base.emitter.emit_string_line(`  return obj;`);
        context.base.emitter.emit_string_line(`}`);
        context.base.emitter.emit_string_line(``);
        vi = (vi + usize(1));
      });
    },
    _ => ()
  )
});
/// Generate per-variant constructor implementations for every concrete
/// reference-semantics enum (`ref(enum(…))`).
generate_ref_enum_constructor_functions :: (fn(context : &mut FunctionGenerationContext) -> unit)({
  // A live cursor walk of the registry, not a borrowed `for`: the body can
  // register a late type (the on-demand hook), which a borrowed walk refuses.
  vals_cur := context.base.types.walk_start();
  while(context.base.types.walk_valid(&vals_cur), vals_cur = context.base.types.walk_next(&vals_cur), {
    vals_key := context.base.types.walk_ref(&vals_cur).key.clone();
    match(
      context.base.get_type_entry(&vals_key),
      .Some(entry) => if(is_reference_enum_type(&entry.ty), {
        _generate_one_ref_enum_constructor_set(&entry.ty, entry.c_name.clone(), context);
      }),
      .None => ()
    );
  });
});
/// Generate constructor implementations for closures and their Rc functions.
/// No-op: Impl(Fn(...)) closures use concrete capture structs + direct calls,
/// and Dyn(Fn(...)) uses dyn constructors generated elsewhere.
generate_closure_constructor_functions :: (fn(context : &FunctionGenerationContext) -> unit)(
  ()
);
export(dispose_fn_thunk, generate_ref_struct_constructor_functions, generate_ref_enum_constructor_functions, generate_closure_constructor_functions);
