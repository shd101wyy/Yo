//! Per-function generation context.
//!
//! Yo has no struct inheritance, so this COMPOSES the base via a `base :
//! CodeGenContext` field; functions that take a FunctionGenerationContext read
//! base fields as `ctx.base.<field>`.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ HashMap } :: import("std/collections/hash_map");
{ AstExpr } :: import("../../expr.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ replace } :: import("std/mem");
{ CapturedVariable, AwaitAnalysisResult } :: import("../../evaluator/async/await_analysis_types.yo");
{ CodeGenContext, sanitize_for_c_identifier, scope_stack_contains, fresh_local_name } :: import("../utils/index.yo");
{ Token } :: import("../../token.yo");
{ get_state_machine_field_name } :: import("../async/state_machine_naming.yo");
{ SmUnwindCatch } :: import("../exprs/async_completion.yo");
/// One closure parameter slot — a bundle value supplied at io.await/io.spawn time
/// via `__yo_future_set_bundle(fut, &value)`, stored in a dedicated `__yo_param_<i>`
/// slot on the SM struct. Defined here (not in exprs/async.yo) so
/// `DeferredAsyncBlock` can reference it without an import cycle.
ClosureParamSlot :: struct(
  field_name : String,
  c_type : String,
  param_name : String,
  param_type : TypeValue,
  /// Where the closure literal declares the parameter (`module:row:col`),
  /// or "" when unknown: the parameter's own local is the slot, not a
  /// second state-machine field.
  decl_site : String
);
// Never written after construction, so a value-like record: its Clone is the
// field-wise copy (VERDICTS-13 §12; V5 part-B target a plain struct).
derive(ClosureParamSlot, Clone);
/// A deferred async-block generation request: async blocks are generated after
/// all regular functions. `future_type` (SomeType | DynType) and
/// `future_trait_type` (FutureTraitType) both become `TypeValue`.
DeferredAsyncBlockData :: struct(
  body_expr : AstExpr,
  async_block_id : String,
  struct_name : String,
  resume_function_name : String,
  constructor_name : String,
  dispose_function_name : String,
  set_effect_function_name : String,
  future_type : TypeValue,
  future_trait_type : TypeValue,
  result_type : TypeValue,
  result_type_c_name : String,
  capture_type : Option(TypeValue),
  /// The evaluator's capture dups (`generate_captured_variable_dup_expressions`):
  /// which implicit captures are copies. A fused await site builds the
  /// capture after the wrapper's own emission took them off the closure.
  capture_dups : ArrayList(AstExpr),
  analysis : AwaitAnalysisResult,
  closure_param_slots : Option(ArrayList(ClosureParamSlot)),
  /// The `io.async(...)` call this block lowers (0 for a plain async
  /// block): an await-site fusion finds a wrapper's block by it.
  source_call_id : usize
);
// A deferred block is never written after construction, and the block list,
// the by-struct-name map and the topological sort share it: a read-only `Rc`
// (V5 part B, class R).
DeferredAsyncBlock :: Rc(DeferredAsyncBlockData);
InAsyncStateMachine :: struct(future_type : TypeValue);
derive(InAsyncStateMachine, Clone);
/// One suspension point the single-pass lowering emitted
/// (plans/ASYNC_STATE_MACHINE_GENERATION.md phase 5): what the abort hook needs
/// to cancel the future the task is suspended on in state `state`.
/// A single-pass lowering await's result field in the task struct.
InlineAwaitResultField :: struct(name : String, ty : TypeValue, expr : AstExpr);
derive(InlineAwaitResultField, Clone);
/// One `match` pattern binding in scope (`shadow_bindings`): the C local it
/// was declared as and the binding's declaration token (`.None` for a
/// pattern's hidden subject).
ShadowBinding :: struct(c_name : String, decl : Option(Token));
derive(ShadowBinding, Clone);
InlineSuspension :: struct(
  /// The state that resumes after this await (the `__yo_resume_<state>` label).
  state : usize,
  /// The awaited future was stored in the task's `__yo_await_slot` (an
  /// anonymous future the slot owns); a named future is the body's own value.
  in_slot : bool,
  /// The slot holds an I/O future (the backend can take it back).
  is_io : bool
);
derive(InlineSuspension, Copy, Clone);
/// The single-pass lowering's state while ONE async block's resume function is
/// generated: awaits are emitted inline where the expression generator reaches
/// them (`emit_inline_await`), each allocating the next state.
InlineSmLowering :: struct(
  async_block_id : String,
  resume_function_name : String,
  next_state : usize,
  /// The block's await analysis (result types of the awaits it knows).
  analysis : AwaitAnalysisResult,
  suspensions : ArrayList(InlineSuspension),
  /// Await nodes already emitted — each must suspend exactly once.
  emitted : HashSet(usize),
  /// C names of the temps whose future an await moved into
  /// `__yo_await_slot`: the slot releases the future, so the temp's own
  /// scope-end drop is not emitted.
  moved_into_slot : HashSet(String),
  /// A read that MOVES a state-machine field out (the evaluator's
  /// `consumed_at_token` is that read), by atom id: the C temp the value
  /// was taken into when its slot was zeroed.
  moved_reads : HashMap(usize, String),
  /// A pattern binding's slot (`sm->field`) → the place in another slot it
  /// was bound from, without a dup (`sm->var_r.data.Err.error`). Moving the
  /// binding out moves the value out of that place too, so a consuming read
  /// zeroes both: the abort dispose and the scrutinee's scope-end drop see
  /// an empty payload instead of releasing the moved value again.
  binding_sources : HashMap(String, String),
  /// Set while a drop or RC builtin renders its operand: a drop releases
  /// the slot's value where it stands and is emitted again on every exit
  /// path, so its operand is not a move out of the slot.
  rc_operand : bool,
  /// The block's capture list is owned by the state machine (an `FnOnce`
  /// capture struct, decision 37): its dispose drops every capture the body
  /// did not move (each has a move flag), on every path, so the body's own
  /// capture drops are not emitted.
  owns_fnonce_captures : bool
);
/// An effect-evidence parameter threaded into a function for explicit-effects
/// dispatch — the implicit-record label, the field label/path within it, the
/// field's function type, and the sanitized C parameter name.
EvidenceParameter :: struct(
  implicit_label : String,
  field_label : String,
  field_path : ArrayList(String),
  field_function_type : TypeValue,
  c_param_name : String
);
derive(EvidenceParameter, Clone);
FunctionGenerationContext :: struct(
  /// The base codegen context.
  base : CodeGenContext,
  /// Type of the current function being generated.
  current_function_type : Option(TypeValue),
  /// Variables captured by the current closure function.
  current_closure_captures : Option(ArrayList(String)),
  /// Frame level of the captured variables.
  current_closure_capture_frame_level : Option(usize),
  /// C name of the capture struct type (e.g. "__yo_struct_abc_capture").
  current_closure_capture_type_c_name : Option(String),
  /// Set when generating an effect-record member function (e.g. an
  /// Exception.throw handler).
  is_effect_record_member_function : bool,
  /// `unwind_origin_id` of the function being generated: what an `unwind`
  /// in its body stores into `__yo_unwind_target`.
  current_unwind_origin : Option(String),
  /// The handler literals whose `unwind` exits the frame being generated
  /// (the function, or the async block inside a state machine's resume
  /// function): the unwinds this frame catches.
  unwind_catches : Option(ArrayList(String)),
  /// Set while a state machine whose body installs unwinding handlers is
  /// generated: how its abort points catch those handlers' unwinds.
  sm_unwind_catch : Option(SmUnwindCatch),
  /// SSA-renamed variable id → original/canonical id (loop reassignment).
  variable_id_remapping : Option(HashMap(String, String)),
  /// Pending deferred drops from enclosing begin blocks (run before async
  /// completion / early return).
  pending_deferred_drops : Option(ArrayList(AstExpr)),
  /// Drops for RC vars consumed by return values (emitted on unwind only).
  consumed_var_pending_drops : Option(ArrayList(AstExpr)),
  /// Variables locally shadowed (e.g. match destructuring) — use the local C
  /// var, not the SM field. Keyed by the SANITIZED C name.
  local_shadowed_variables : Option(HashSet(String)),
  /// The pattern bindings in scope for each shadowed SANITIZED name,
  /// innermost last. A binding whose source C name is already declared in
  /// an open enclosing C block (an enclosing local it shadows, or an outer
  /// arm's binding) is declared under a fresh C name, so a drop the
  /// compiler emits for the enclosing value inside the arm (an early
  /// return's, an unwind's) still names it
  /// (issues/fixed/2026-11-05-a-match-arm-binding-that-shadows-a-local-is-never-dropped.md).
  shadow_bindings : Option(HashMap(String, ArrayList(ShadowBinding))),
  /// Single-pass async lowering: the state-machine slot a shadowed name
  /// (a match-arm binding) lives in. A shadowed name renders as that slot,
  /// or as the C local when it has none; never through the env, whose
  /// same-named variables are not the binding.
  shadow_slots : Option(HashMap(String, String)),
  /// The pattern bindings whose C local is a pointer to the part — a `mut`
  /// or `&` match's place binding (plans/VALUES_BY_DEFAULT.md decision 26)
  /// or a reference payload's binding — so a read or a write goes through
  /// it. Keyed by the binding's C local (`shadow_bindings`), not its source
  /// name: same-named bindings of nested arms are separate locals, and only
  /// some of them may be pointers.
  place_bindings : Option(HashSet(String)),
  /// Temp variable names already declared in the C output (avoid duplicates).
  declared_temp_vars : Option(HashSet(String)),
  /// Var names whose drops were already emitted inside short-circuit branches.
  /// CONSUME-ONCE: every reader (begin.yo, while_loop.yo, drop_dup.yo) REMOVES
  /// the entry on hit, because it means "suppress the next scope-end flush of
  /// this target, once". It is therefore useless as a dedup signal for a
  /// SECOND consideration of the same drop inside the short-circuit family —
  /// that is what `short_circuit_emitted_drop_targets` is for.
  short_circuit_handled_drop_var_names : Option(HashSet(String)),
  /// Targets the short-circuit family has already emitted a drop for in this
  /// function. MONOTONE — never removed, unlike the consume-once set above.
  /// A chain (`a || b || c` parses as nested binaries) considers the same
  /// operand temp at two emission points: the INNER node's fall-through and
  /// the OUTER node's fall-through, both at function scope, and each with a
  /// DIFFERENT drop-expr identity (the channels carry distinct exprs, so the
  /// id guard cannot see it). Without a monotone name-keyed signal the second
  /// consideration double-drops — the failure that sank two earlier attempts
  /// at the chain fix (issues/fixed/short-circuit-chain-inner-operand-temps-still-leak.md).
  short_circuit_emitted_drop_targets : Option(HashSet(String)),
  /// The OUTERMOST `||`/`&&` currently being emitted. A chain's inner node has
  /// an EMPTY deferred-drop list — its operand temps' scope drops were
  /// scheduled onto the outermost/body node — so the inner node's emission
  /// points must read the ROOT's list to find them. Set by the outermost
  /// short circuit when unset, restored on exit.
  short_circuit_root_node : Option(AstExpr),
  /// Drop code strings for effect-handler params (emitted before unwind).
  effect_handler_param_drops : Option(ArrayList(String)),
  /// Baseline pendingDeferredDrops count when entering the current loop body.
  loop_body_drops_baseline_count : Option(usize),
  /// Override C return-type string (body-derived return types).
  override_return_type_str : Option(String),
  /// C type strings of every non-unit `unwind(value)` argument (sizes the
  /// unwind-value buffer union).
  unwind_value_c_types : Option(HashSet(String)),
  /// Set when any io.async/await/spawn is encountered (emit async runtime).
  uses_async : bool,
  /// Set when any thread/worker spawn is found (emit parallelism runtime).
  uses_parallelism : bool,
  /// Set when generating code inside an async state machine.
  in_async_state_machine : Option(InAsyncStateMachine),
  /// Set while an async block is lowered by the single-pass emitter.
  sm_inline_lowering : Option(InlineSmLowering),
  /// The state-machine field that holds the capture struct an `Outer`
  /// variable is read from: `__capture`, or, while a fused wrapper's block
  /// is emitted into its caller, that site's capture slot
  /// (plans/backlog/ASYNC_AWAIT_SITE_FUSION.md, F2).
  sm_capture_slot : String,
  /// Prefixes the await-result field names while a fused wrapper's block is
  /// emitted into its caller (its awaits get the site's own fields), and
  /// keys that block's awaits in `InlineSmLowering.emitted` per site.
  /// Empty outside a fused block.
  fusion_field_prefix : String,
  /// Variables captured in the async state machine (variable id → captured
  /// variable). Read by atom emission to access `sm->var_<id>` / `sm->__capture.<name>`.
  state_machine_variables : Option(HashMap(String, CapturedVariable)),
  /// Phase-1b aliases: temp future variable id → its await_future_N SM field
  /// name (atom emission redirects SM lookups to the existing await field).
  state_machine_field_aliases : Option(HashMap(String, String)),
  /// State-machine variable ids whose slot a BORROWING match pattern
  /// binding was stored into. Such a binding reads the scrutinee's payload
  /// (no dup, no scope-end drop), so the abort dispose must not drop its slot
  /// as well as the scrutinee's: filled by every binding-store site while the
  /// resume function is generated, read by the dispose generator
  /// (issues/fixed/async-abort-dispose-double-drops-moved-enum-payload.md).
  /// A consuming match's binding owns its part, so its slot is not recorded
  /// and the dispose drops it like any named local's (`match_binds_own`).
  state_machine_binding_ids : Option(HashSet(String)),
  /// True while the arms of a consuming `match` (`MATCH_MODE_CONSUME`) are
  /// lowered: the bindings own the parts they bind (decision 26)
  /// (issues/fixed/2026-11-05-an-aborted-task-leaks-a-value-moved-into-a-match-binding-across-an-await.md).
  match_binds_own : bool,
  /// Effect-evidence parameters in scope (implicit label → evidence param), for
  /// explicit-effects dispatch / effect injection.
  current_evidence_params : Option(HashMap(String, EvidenceParameter)),
  /// Async blocks deferred to after all regular functions are generated.
  deferred_async_blocks : Option(ArrayList(DeferredAsyncBlock)),
  /// Raw name of the enclosing assignment's save-old-value temp while its
  /// RHS is being generated. The temp receives ownership of the old value
  /// only AFTER the assignment completes, so escape-path pending drops
  /// emitted inside the RHS must skip it (the local still owns the value;
  /// dropping both double-frees) — the END-of-scope envs list the
  /// not-yet-defined temp, so the skip needs this explicit flag.
  current_assignment_save_temp : Option(String),
  /// Deferred-drop expression ids (ast_expr_id) already emitted as C — the
  /// emitted-once guard for the node-list drop flushes (drop_dup.yo
  /// generate_deferred_drop_expressions, begin.yo _emit_deferred_drops). A
  /// shared single-expression begin node carries BOTH the begin's scope-end
  /// drops and the tail call's Stage-0 balancing drops (evaluator begin.yo
  /// preserves both), and such a node is flushed from more than one point —
  /// the call emitter's post-call flush and the enclosing arm/body-level
  /// flush (match.yo's arm flush). The emitters do NOT remove-on-emit:
  /// node-list membership is the pending path's "the node's own flush
  /// handles it" signal (return.yo generate_pending_deferred_drops's
  /// `already` set), which removal-on-emit would break (double emission via
  /// the pending path — the reverted idempotent-flush attempt). One set per
  /// COMPILATION is sound because one ExprInfo table maps an expr id to
  /// exactly one emitted C function (specializations clone bodies with
  /// fresh ids). Keyed by expr IDENTITY, not target name: two same-named
  /// locals in sibling C scopes are distinct drop exprs and must each emit
  /// once.
  emitted_deferred_drop_ids : HashSet(usize),
  /// The `unwind(...)` that is a bare-expression function body (a handler
  /// `e -> unwind(f(e))`). Its shared-id node carries the function's
  /// own-parameter drops, which `generate_unwind` emits AFTER evaluating
  /// the operand, not before it: the operand may read the parameter
  /// (issues/fixed/2026-10-29-a-handler-whose-body-is-a-bare-unwind-releases-its-parameter-before-the-operand-reads-it.md).
  unwind_tail_param_drops_id : Option(usize)
);
impl(
  FunctionGenerationContext,
  /// Wrap a base CodeGenContext in a fresh per-function generation context.
  new : (fn(sink(base) : CodeGenContext) -> Self)(
    Self(
      base : base,
      current_function_type : Option(TypeValue).None,
      current_closure_captures : Option(ArrayList(String)).None,
      current_closure_capture_frame_level : Option(usize).None,
      current_closure_capture_type_c_name : Option(String).None,
      is_effect_record_member_function : false,
      current_unwind_origin : Option(String).None,
      unwind_catches : Option(ArrayList(String)).None,
      sm_unwind_catch : Option(SmUnwindCatch).None,
      variable_id_remapping : Option(HashMap(String, String)).None,
      pending_deferred_drops : Option(ArrayList(AstExpr)).None,
      consumed_var_pending_drops : Option(ArrayList(AstExpr)).None,
      local_shadowed_variables : Option(HashSet(String)).None,
      shadow_bindings : Option(HashMap(String, ArrayList(ShadowBinding))).None,
      shadow_slots : Option(HashMap(String, String)).None,
      place_bindings : Option(HashSet(String)).None,
      declared_temp_vars : Option(HashSet(String)).None,
      short_circuit_handled_drop_var_names : Option(HashSet(String)).None,
      short_circuit_emitted_drop_targets : Option(HashSet(String)).None,
      short_circuit_root_node : Option(AstExpr).None,
      effect_handler_param_drops : Option(ArrayList(String)).None,
      loop_body_drops_baseline_count : Option(usize).None,
      override_return_type_str : Option(String).None,
      unwind_value_c_types : Option(HashSet(String)).None,
      uses_async : false,
      uses_parallelism : false,
      in_async_state_machine : Option(InAsyncStateMachine).None,
      sm_inline_lowering : Option(InlineSmLowering).None,
      sm_capture_slot : String.from("__capture"),
      fusion_field_prefix : String.from(""),
      state_machine_variables : Option(HashMap(String, CapturedVariable)).None,
      state_machine_field_aliases : Option(HashMap(String, String)).None,
      state_machine_binding_ids : Option(HashSet(String)).None,
      match_binds_own : false,
      current_evidence_params : Option(HashMap(String, EvidenceParameter)).None,
      deferred_async_blocks : Option(ArrayList(DeferredAsyncBlock)).None,
      current_assignment_save_temp : Option(String).None,
      emitted_deferred_drop_ids : HashSet(usize).new(),
      unwind_tail_param_drops_id : Option(usize).None
    )
  )
);
/// Resolve a variable name to its state-machine field reference when inside an
/// async or effect state machine: `sm->__capture.X` for an outer capture,
/// `sm->var_X` for a hoisted local. Returns the name unchanged outside a state
/// machine, or when it is a real C temp rather than a hoisted local.
///
/// Lives here rather than in `exprs/other_fn_call.yo` because
/// `return.yo` needs it too and `other_fn_call.yo` already imports `return.yo`
/// — the loader rejects the destructuring import cycle. Same structural
/// necessity as `state_machine_naming.yo`.
resolve_var_name_in_context :: (
  fn(var_name : &String, context : &FunctionGenerationContext) -> String
)({
  if(context.in_async_state_machine.is_none(), {
    return(var_name.clone());
  });
  match(
    &context.state_machine_variables,
    .None => var_name.clone(),
    .Some(vars) => {
      (result : String) = var_name.clone();
      for(&vars, (k, cv) => {
        if(cv.base.name == var_name, {
          // Outer captures are named by the variable's NAME
          // (`__capture.<name>`),
          // NEVER the map key: the same outer capture is registered both
          // under its numeric variable id (the re-kinded analysis entry)
          // and under its capture-struct label, and which one this name
          // scan hits first is HashMap-order — platform-dependent. Keying
          // the field off `k` emitted `sm->__capture.9087782` on the
          // Linux runner while macOS happened to hit the label entry.
          // See issues/fixed/fixpoint-linux-only-capture-field-numeric-name.md.
          result = match(
            cv.kind,
            .Outer => `sm->${context.sm_capture_slot}.${sanitize_for_c_identifier(cv.base.name.clone(), false)}`,
            .Local => `sm->${get_state_machine_field_name(k.clone(), &context.state_machine_field_aliases)}`
          );
          break;
        });
      });
      result
    }
  )
});
export(resolve_var_name_in_context);
// The context's optional name sets are written by taking the set out and
// storing it back, never through a `match` binding: a binding is a copy of
// the set once collections are values (plans/VALUES_BY_DEFAULT.md §6 V2a).
/// Record `name` in `declared_temp_vars`, creating the set on first use.
record_declared_temp_var :: (fn(context : &mut FunctionGenerationContext, name : &String) -> unit)({
  names := match(context.declared_temp_vars.take(), .Some(s) => s, .None => HashSet(String).new());
  names.insert(name.clone());
  context.declared_temp_vars = Option(HashSet(String)).Some(names);
});
/// Record `name` in `short_circuit_handled_drop_var_names` when that set is
/// active (a short-circuit family is being lowered).
note_short_circuit_handled :: (fn(context : &mut FunctionGenerationContext, name : &String) -> unit)(
  match(
    context.short_circuit_handled_drop_var_names.take(),
    .Some(s) => {
      names := s;
      names.insert(name.clone());
      context.short_circuit_handled_drop_var_names = Option(HashSet(String)).Some(names);
    },
    .None => ()
  )
);
/// Consume `target` from `short_circuit_handled_drop_var_names`: true when it
/// was there (its drop was already emitted inside a short-circuit branch).
take_short_circuit_handled :: (fn(context : &mut FunctionGenerationContext, target : &String) -> bool)(
  match(
    context.short_circuit_handled_drop_var_names.take(),
    .Some(s) => {
      names := s;
      hit := names.remove(target);
      context.short_circuit_handled_drop_var_names = Option(HashSet(String)).Some(names);
      hit
    },
    .None => false
  )
);
/// Record `id` in `state_machine_binding_ids` when that set is active and the
/// binding borrows (the arms being lowered are not a consuming match's).
note_state_machine_binding_id :: (fn(context : &mut FunctionGenerationContext, id : &String) -> unit)({
  if(context.match_binds_own, {
    return(());
  });
  match(
    context.state_machine_binding_ids.take(),
    .Some(s) => {
      ids := s;
      ids.insert(id.clone());
      context.state_machine_binding_ids = Option(HashSet(String)).Some(ids);
    },
    .None => ()
  );
});
/// The tokens `a` and `b` are the same source position.
_same_decl :: (fn(a : &Option(Token), b : &Option(Token)) -> bool)(
  match(
    a,
    .Some(ta) => match(b, .Some(tb) => ((ta.module_path.* == tb.module_path.*) && ((ta.row == tb.row) && (ta.column == tb.column))), .None => false),
    .None => false
  )
);
/// The C name a new pattern binding of the sanitized name `name` is declared
/// under: `name` itself, or a fresh name when a C local of that name is
/// declared in an open enclosing block. Declared under `name` the binding
/// would hide that local from every drop the compiler emits inside the arm
/// (`shadow_bindings`).
shadow_binding_decl_name :: (fn(context : &FunctionGenerationContext, name : &String) -> String)(
  if(context.base.declared_scopes.with({ &name }(ds) => scope_stack_contains(ds, name)), fresh_local_name(`${name}_s`, &context.base.current_function_name), name.clone())
);
/// The C local of the innermost pattern binding of the sanitized name `name`,
/// or `name` when it has none.
shadow_binding_c_name :: (fn(context : &FunctionGenerationContext, name : &String) -> String)(
  match(
    &context.shadow_bindings,
    .Some(m) => match(m.get_cloned(name.clone()), .Some(st) => match(st.last_cloned(), .Some(b) => b.c_name.clone(), .None => name.clone()), .None => name.clone()),
    .None => name.clone()
  )
);
/// The bindings of the sanitized name `name` in scope, innermost last.
shadow_bindings_of :: (fn(context : &FunctionGenerationContext, name : &String) -> ArrayList(ShadowBinding))(
  match(
    &context.shadow_bindings,
    .Some(m) => match(m.get_cloned(name.clone()), .Some(st) => st, .None => ArrayList(ShadowBinding).new()),
    .None => ArrayList(ShadowBinding).new()
  )
);
/// Bring a pattern binding of `name`, declared as `c_name` at `decl`, into
/// scope. Registering the same binding again (a binding site that also runs
/// the generic shadow registration) is a no-op.
shadow_binding_push :: (fn(context : &mut FunctionGenerationContext, name : &String, c_name : &String, decl : Option(Token)) -> unit)({
  stacks := match(context.shadow_bindings.take(), .Some(m) => m, .None => HashMap(String, ArrayList(ShadowBinding)).new());
  stack := match(stacks.get_cloned(name.clone()), .Some(st) => st, .None => ArrayList(ShadowBinding).new());
  same := match(stack.last_cloned(), .Some(top) => ((top.c_name == c_name) && _same_decl(&top.decl, &decl)), .None => false);
  if(!same, {
    stack.push(ShadowBinding(c_name : c_name.clone(), decl : decl));
  });
  stacks.insert(name.clone(), stack);
  context.shadow_bindings = Option(HashMap(String, ArrayList(ShadowBinding))).Some(stacks);
});
/// Take the innermost binding of `name` out of scope; true when an outer one
/// remains.
shadow_binding_pop :: (fn(context : &mut FunctionGenerationContext, name : &String) -> bool)({
  stacks := match(context.shadow_bindings.take(), .Some(m) => m, .None => return(false));
  stack := match(stacks.get_cloned(name.clone()), .Some(st) => st, .None => ArrayList(ShadowBinding).new());
  _top := stack.pop();
  remains := (stack.len() > usize(0));
  if(remains, {
    stacks.insert(name.clone(), stack);
  }, {
    _gone := stacks.remove(name.clone());
  });
  context.shadow_bindings = Option(HashMap(String, ArrayList(ShadowBinding))).Some(stacks);
  remains
});
/// True while lowering an `io.async` state machine that owns its capture list
/// (`InlineSmLowering.owns_fnonce_captures`).
sm_owns_fnonce_captures :: (fn(context : &FunctionGenerationContext) -> bool)(
  match(&context.sm_inline_lowering, .Some(low) => low.owns_fnonce_captures, .None => false)
);
// The single-pass lowering's state is a field of the context (`.None`
// outside a lowering); the emitters read and write it in place through these.
/// Record that await `eid` was emitted; false when it already was.
sm_lowering_note_emitted :: (fn(context : &mut FunctionGenerationContext, eid : usize) -> bool)(
  match(
    &mut context.sm_inline_lowering,
    .Some(low) => {
      fresh := !low.emitted.contains(&eid);
      low.emitted.insert(eid);
      fresh
    },
    .None => false
  )
);
/// The next resume state, reserved.
sm_lowering_next_state :: (fn(context : &mut FunctionGenerationContext) -> usize)(
  match(
    &mut context.sm_inline_lowering,
    .Some(low) => {
      k := low.next_state;
      low.next_state = (k + usize(1));
      k
    },
    .None => usize(0)
  )
);
/// The C name of a value the task's await slot now owns.
sm_lowering_note_moved_into_slot :: (fn(context : &mut FunctionGenerationContext, sink(name) : String) -> unit)(
  match(
    &mut context.sm_inline_lowering,
    .Some(low) => {
      low.moved_into_slot.insert(name);
    },
    .None => ()
  )
);
sm_lowering_push_suspension :: (fn(context : &mut FunctionGenerationContext, suspension : InlineSuspension) -> unit)(
  match(&mut context.sm_inline_lowering, .Some(low) => low.suspensions.push(suspension), .None => ())
);
/// Set the "generating a drop/dup operand" flag; returns the previous value.
sm_lowering_set_rc_operand :: (fn(context : &mut FunctionGenerationContext, value : bool) -> bool)(
  match(
    &mut context.sm_inline_lowering,
    .Some(low) => {
      prev := low.rc_operand;
      low.rc_operand = value;
      prev
    },
    .None => false
  )
);
sm_lowering_note_binding_source :: (fn(context : &mut FunctionGenerationContext, sink(slot) : String, sink(source) : String) -> unit)(
  match(
    &mut context.sm_inline_lowering,
    .Some(low) => {
      low.binding_sources.insert(slot, source);
    },
    .None => ()
  )
);
sm_lowering_note_moved_read :: (fn(context : &mut FunctionGenerationContext, eid : usize, sink(code) : String) -> unit)(
  match(
    &mut context.sm_inline_lowering,
    .Some(low) => {
      low.moved_reads.insert(eid, code);
    },
    .None => ()
  )
);
/// What a fused site's body replaced while it lowers under its own analysis
/// (`sm_lowering_enter_scope` / `sm_lowering_restore_scope`).
SmLoweringScope :: struct(analysis : AwaitAnalysisResult, emitted : HashSet(usize), moved_reads : HashMap(usize, String));
/// Lower the next statements under `analysis`, with fresh emitted-await and
/// moved-read logs; returns what they replaced.
sm_lowering_enter_scope :: (fn(context : &mut FunctionGenerationContext, analysis : AwaitAnalysisResult) -> Option(SmLoweringScope))(
  match(
    &mut context.sm_inline_lowering,
    .Some(low) => Option(SmLoweringScope).Some(
      SmLoweringScope(
        analysis : replace(&mut low.analysis, analysis),
        emitted : replace(&mut low.emitted, HashSet(usize).new()),
        moved_reads : replace(&mut low.moved_reads, HashMap(usize, String).new())
      )
    ),
    .None => Option(SmLoweringScope).None
  )
);
sm_lowering_restore_scope :: (fn(context : &mut FunctionGenerationContext, sink(saved) : Option(SmLoweringScope)) -> unit)(
  match(
    saved,
    // A binding of the consumed Option is still a borrow under the seed, so
    // the logs are copied back (they are the few entries one fused site
    // recorded).
    .Some(scope) => match(
      &mut context.sm_inline_lowering,
      .Some(low) => {
        low.analysis = scope.analysis;
        low.emitted = scope.emitted.clone();
        low.moved_reads = scope.moved_reads.clone();
      },
      .None => ()
    ),
    .None => ()
  )
);
/// The suspension analysis of the body being lowered.
sm_lowering_analysis :: (fn(context : &FunctionGenerationContext) -> Option(AwaitAnalysisResult))(
  match(&context.sm_inline_lowering, .Some(low) => Option(AwaitAnalysisResult).Some(low.analysis), .None => Option(AwaitAnalysisResult).None)
);
export(
  record_declared_temp_var,
  note_short_circuit_handled,
  take_short_circuit_handled,
  note_state_machine_binding_id,
  sm_owns_fnonce_captures,
  shadow_binding_decl_name,
  shadow_binding_c_name,
  shadow_bindings_of,
  shadow_binding_push,
  shadow_binding_pop,
  sm_lowering_note_emitted,
  sm_lowering_next_state,
  sm_lowering_note_moved_into_slot,
  sm_lowering_push_suspension,
  sm_lowering_set_rc_operand,
  sm_lowering_note_binding_source,
  sm_lowering_note_moved_read,
  sm_lowering_analysis,
  SmLoweringScope,
  sm_lowering_enter_scope,
  sm_lowering_restore_scope
);

export(
  FunctionGenerationContext,
  ShadowBinding,
  InlineSuspension,
  InlineAwaitResultField,
  InlineSmLowering,
  InAsyncStateMachine,
  EvidenceParameter,
  ClosureParamSlot,
  DeferredAsyncBlock,
  DeferredAsyncBlockData
);
