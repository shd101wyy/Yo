//! Dyn function emitters.
//!
//! Four emitters: generate_dyn_dup_drop (RC dup/drop on the fat
//! pointer), generate_dyn_box_functions (box ctor + dispose),
//! generate_dyn_wrapper_functions (unwrap self + forward to the impl method —
//! Fn `call` slot + regular trait methods) and generate_dyn_vtables (TypeId
//! statics + static vtable instances referencing the wrappers). Impl
//! funcs/types resolve via the func-id side-table (get_func_type /
//! get_function_entry); the Fn slot goes through the general
//! `box->field.call(...)` fat-pointer path.
{ String } :: import("std/string");
{ resolve_some_type_to_concrete } :: import("../exprs/closures.yo");
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ TypeValue, TypeValueNode, shared_list, no_types, t_slot_pointee, t_slot_is_mut_ref, t_slot_is_by_value } :: import("../../types/definitions.yo");
{ Emitter } :: import("../../emitter.yo");
{ should_skip_function_codegen, generate_function_prototype } :: import("./declarations.yo");
{ EvalValue, is_func_val } :: import("../../value.yo");
{ get_func_type, is_fnonce_closure_fn } :: import("../../function_value.yo");
{ is_boxed_type, is_fn_trait_type, is_function_type, is_void_type, is_pointer_type, is_some_type, is_atomic_reference_struct_type, is_atomic_reference_enum_type, cell_handle_view, is_atomic_counted_handle_type, is_cell_primitive_type } :: import("../../types/guards.yo");
{ FunctionGenerationContext } :: import("./context.yo");
{ DynImplEntry, type_key, get_type_string, dyn_slot_param_abi_string, dyn_slot_result_abi_string, dyn_concrete_func_type, dyn_concrete_c_name, dyn_impl_key_suffix, sanitize_for_c_identifier, ImplClosureCallInfo, CodegenFunctionEntry } :: import("../utils/index.yo");
{ get_drop_function_for_type, generate_drop_code_for_value, generate_dup_code_for_value } :: import("../exprs/drop_dup.yo");
{ dyn_impl_clone_fid, clone_fn_takes_self_by_ptr } :: import("../exprs/downcast.yo");
{ type_contains_rc_cell_or_move_only, dyn_member_is_method, dyn_member_unsafe_reason, is_destructor_trait_member, fn_abi_param_is_ptr, dyn_type_lists_clone } :: import("../../types/utils.yo");
/// func_id of a FuncVal EvalValue (same as collection.yo's _func_val_id).
_func_val_id :: (fn(v : &EvalValue) -> String)(
  match(v, .FuncVal(__fvd1, _) => __fvd1.func_id.clone(), _ => String.from(""))
);
/// True for the reserved dyn-method labels (___dup/___drop/___dispose), and
/// for the destructor trait's own method (`drop` of the prelude `Drop`,
/// decision 45), which the box's `___dispose` runs. A method of another trait
/// named `drop` keeps its slot.
_is_reserved_dyn_label :: (fn(label : &String, trait_ty : Option(TypeValue)) -> bool)(
  (label.* == "___dup") || (label.* == "___drop") || (label.* == "___dispose") || match(trait_ty, .Some(t) => is_destructor_trait_member(&t, label), .None => false)
);
/// The heap object a Dyn's data pointer points at: a cell handle's cell
/// (`cell_handle_view`; the handle is a C-transparent newtype, so its value
/// is the cell pointer), else the data type itself.
_dyn_data_object_type :: (fn(data_type : &TypeValue) -> TypeValue)(
  match(cell_handle_view(data_type), .Some(v) => Rc.clone(v.cell), .None => data_type.clone())
);
/// Sanitized C field name of the single field of an Rc(T) data type ("*").
/// A cell handle's is its cell's (`_dyn_data_object_type`).
_box_field_name :: (fn(data_type : &TypeValue) -> String)(
  match(
    _dyn_data_object_type(data_type),
    Rc(.Struct({ field_labels })) => match(field_labels.get(usize(0)), .Some(l) => sanitize_for_c_identifier(&l, false), .None => String.from("__0")),
    _ => String.from("__0")
  )
);
/// Drain a HashMap-key iterator into an ArrayList of the keys.
_dyn_impl_keys :: (fn(context : &FunctionGenerationContext) -> ArrayList(String))({
  mut(out) := ArrayList(String).new();
  for(&context.base.dyn_impls, (k, _v) => {
    out.push(k.clone());
  });
  out
});
/// Generate dup/drop functions for dyn types (RC on the boxed data pointer).
/// Is a Dyn's DATA object atomically reference counted? Then its vtable's
/// retain/release are the atomic RC functions.
_dyn_data_is_atomic :: (fn(data_type : &TypeValue) -> bool)(
  is_atomic_reference_struct_type(data_type) || is_atomic_reference_enum_type(data_type) || is_atomic_counted_handle_type(data_type)
);
generate_dyn_dup_drop :: (fn(context : &mut FunctionGenerationContext) -> unit)({
  generated := HashSet(String).new();
  keys := _dyn_impl_keys(context);
  n := keys.len();
  (mut(i) : usize) = usize(0);
  while(i < n, {
    key := match(keys.get_cloned(i), .Some(k) => k, .None => String.from(""));
    match(
      context.base.dyn_impls.get(key.clone()),
      .Some(impl_entry) => {
        dyn_key := type_key(impl_entry.dyn_type.clone());
        dyn_c := match(context.base.get_type_c_name(dyn_key.clone()), .Some(cn) => cn, .None => `__yo_dyn_${dyn_key}`);
        if(!generated.contains(dyn_c.clone()), {
          generated.insert(dyn_c.clone());
          context.base.emitter.emit_string_line(`${dyn_c} __yo_dup_${dyn_c}(${dyn_c} dyn) {`);
          context.base.emitter.emit_line("  __yo_dyn_retain(dyn.data, dyn.vtable);");
          context.base.emitter.emit_line("  return dyn;");
          context.base.emitter.emit_line("}");
          context.base.emitter.emit_line("");
          context.base.emitter.emit_string_line(`void __yo_drop_${dyn_c}(${dyn_c} dyn) {`);
          context.base.emitter.emit_line("  __yo_dyn_release(dyn.data, dyn.vtable);");
          context.base.emitter.emit_line("}");
          context.base.emitter.emit_line("");
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// Generate box constructor + dispose functions for dyn impls. The
/// concrete type's drop fn resolves via get_drop_function_for_type (the
/// type-method registry).
generate_dyn_box_functions :: (fn(context : &mut FunctionGenerationContext) -> unit)({
  if(context.base.dyn_impls.is_empty(), {
    return(());
  });
  context.base.emitter.emit_line("");
  context.base.emitter.emit_line("// === Dyn Box Functions ===");
  context.base.emitter.emit_line("// Constructor and dispose functions for dyn boxes");
  context.base.emitter.emit_line("");
  generated := HashSet(String).new();
  keys := _dyn_impl_keys(context);
  n := keys.len();
  (mut(i) : usize) = usize(0);
  while(i < n, {
    key := match(keys.get_cloned(i), .Some(k) => k, .None => String.from(""));
    match(
      context.base.dyn_impls.get(key.clone()),
      .Some(impl_entry) => {
        // Resolve SomeT concretes before keying — see types/generation.yo's
        // box-typedef note (the same miss emitted an undeclared
        // `__yo_dyn_box_unknown_<id>` ctor).
        dyn_concrete_res := resolve_some_type_to_concrete(impl_entry.concrete_type.clone());
        concrete_key := type_key(dyn_concrete_res.clone());
        concrete_c := match(dyn_concrete_c_name(&dyn_concrete_res, &context.base), .Some(cn) => cn, .None => `unknown_${concrete_key}`);
        box_name := `__yo_dyn_box_${concrete_c}`;
        if(!generated.contains(box_name.clone()), {
          generated.insert(box_name.clone());
          value_str := get_type_string(dyn_concrete_res.clone(), &mut context.base);
          // Late-registered dyn impl (registered during body generation, after
          // the type-decl phase's box pass): emit the missing typedef into the
          // DECLARATIONS section now — see CodeGenContext.dyn_box_typedefs.
          if(!context.base.dyn_box_typedefs.contains(box_name.clone()), {
            context.base.dyn_box_typedefs.insert(box_name.clone());
            context.base.emitter.emit_declaration_line("typedef struct {");
            context.base.emitter.emit_declaration_line("  __yo_ref_header_t header;");
            context.base.emitter.emit_declaration_string_line(`  ${value_str} value;`);
            context.base.emitter.emit_declaration_string_line(`} ${box_name};`);
            context.base.emitter.emit_declaration_line("");
            context.base.emitter.emit_declaration_string_line(`static ${box_name}* __yo_new_${box_name}(${value_str} value);`);
            context.base.emitter.emit_declaration_string_line(`static void __yo_dispose_${box_name}(void* ptr);`);
            context.base.emitter.emit_declaration_line("");
          });
          context.base.emitter.emit_string_line(`static ${box_name}* __yo_new_${box_name}(${value_str} value) {`);
          // `dyn(...)`'s own box is global (ALLOCATOR_PLACEMENT.md §2.4: a
          // placed payload is a placed `Rc`, used as the data object).
          context.base.emitter.emit_string_line(`  ${box_name}* box = (${box_name}*)__yo_rc_alloc(sizeof(${box_name}));`);
          context.base.emitter.emit_line("  box->header.ref_count = 1u;");
          context.base.emitter.emit_line("  box->header.borrow_count = 0;");
          dispose_name := `__yo_dispose_${box_name}`;
          tid := context.base.dispose_type_id_for(dispose_name.clone());
          context.base.emitter.emit_string_line(`  box->header.type_id = ${tid.to_string()};`);
          context.base.emitter.emit_line("  box->value = value;");
          context.base.emitter.emit_line("  return box;");
          context.base.emitter.emit_line("}");
          context.base.emitter.emit_line("");
          context.base.emitter.emit_string_line(`static void __yo_dispose_${box_name}(void* ptr) {`);
          context.base.emitter.emit_string_line(`  ${box_name}* box = (${box_name}*)ptr;`);
          // Release the boxed value. `get_drop_function_for_type` only finds a
          // USER `___drop` METHOD; most types (String, a value enum with RC
          // payloads, a tuple, an array, a value struct) are torn down
          // STRUCTURALLY, so a bare `.None => ()` arm emitted an EMPTY dispose
          // body and silently un-dropped every one of them — the
          // `true => ""` / silent-fallback class in the drop lowerings. Fall
          // back to the structural teardown, and look BOTH up through the
          // RESOLVED concrete (`dyn_concrete_res`), the same type the box
          // typedef and constructor above use: a concrete that arrives as a
          // `SomeT` missed the registry lookup even when a user `___drop`
          // existed. Only `box->value` is touched — the `__yo_ref_header_t` at
          // the head of the box is the allocator's, not the payload's. No dup
          // counterpart is needed: `__yo_dup___yo_t<dyn>` increments the BOX's
          // refcount only, and the box owns exactly one copy of the value.
          match(
            get_drop_function_for_type(dyn_concrete_res.clone(), context),
            .Some(drop_c) => context.base.emitter.emit_string_line(`  ${drop_c}(box->value);`),
            .None => {
              // `generate_drop_code_for_value` emits the multi-line shapes
              // (arrays, tuples, value enums/structs) straight through the
              // emitter and returns "", so "returned nothing" alone does not
              // mean "dropped nothing" — the emitted-byte delta does.
              before_len := context.base.emitter.code.len();
              dc := generate_drop_code_for_value(String.from("box->value"), dyn_concrete_res.clone(), context);
              if(dc.len() > usize(0), {
                context.base.emitter.emit_string_line(`  ${dc};`);
              }, {
                // Nothing returned AND nothing emitted, for a payload that
                // carries RC state: leave a greppable marker instead of a
                // silent no-op — the silent no-op is the class that hid this
                // bug for the whole life of the emitter.
                if((context.base.emitter.code.len() == before_len) && type_contains_rc_cell_or_move_only(dyn_concrete_res.clone()), {
                  context.base.emitter.emit_string_line(`  /* __yo_MISSING_DROP: no drop lowering for ${concrete_c} */`);
                });
              });
            }
          );
          context.base.emitter.emit_line("}");
          context.base.emitter.emit_line("");
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// The C type of the payload an impl's slot functions read, or `void` for a
/// unit payload.
_slot_payload_c :: (fn(entry : &DynImplEntry, context : &mut FunctionGenerationContext) -> String)(
  get_type_string(resolve_some_type_to_concrete(entry.concrete_type.clone()), &mut context.base)
);
/// Does this impl's vtable carry the payload slots (`drop_in_place`,
/// `payload_of`, `clone_into`)? A payload-convention instance and a boxed
/// legacy cell do; a reference payload's data word IS the object, which has
/// no payload place apart from it.
_slot_functions_exist :: (fn(entry : &DynImplEntry) -> bool)(entry.payload_convention || is_boxed_type(entry.data_type.clone()));
/// The statement lines that bind `pp`, the payload's address, from `self_ptr`.
_emit_payload_address :: (fn(entry : &DynImplEntry, vs : &String, context : &mut FunctionGenerationContext) -> unit)({
  if(entry.payload_convention, {
    context.base.emitter.emit_string_line(`  ${vs.clone()}* pp = (${vs.clone()}*)self_ptr;`);
  }, {
    boxed_cname := _boxed_c_name(entry.data_type.clone(), context);
    field_name := _box_field_name(entry.data_type.clone());
    context.base.emitter.emit_string_line(`  ${boxed_cname}* box = (${boxed_cname}*)self_ptr;`);
    context.base.emitter.emit_string_line(`  ${vs.clone()}* pp = (${vs.clone()}*)&box->${field_name};`);
  });
});
/// The vtable's payload slot functions for every impl (decision 49):
/// `__yo_dip_<impl>(data)` drops the payload in place and frees nothing,
/// `__yo_pof_<impl>(data)` is the payload's address, and
/// `__yo_cli_<impl>(data, dst)` writes the payload's `clone` at `dst` (a Dyn
/// that lists `Clone`). The same function serves a legacy cell's data word and
/// a reference-kind payload's, by the impl's convention. Prototypes go to the
/// declarations (the vtables name them), bodies to the code buffer, where the
/// payload's drop lowering emits its statements.
generate_dyn_slot_functions :: (fn(context : &mut FunctionGenerationContext) -> unit)({
  if(context.base.dyn_impls.is_empty(), {
    return(());
  });
  keys := _dyn_impl_keys(context);
  n := keys.len();
  (mut(i) : usize) = usize(0);
  while(i < n, {
    key := match(keys.get_cloned(i), .Some(k) => k, .None => String.from(""));
    match(
      context.base.dyn_impls.get(key.clone()),
      .Some(entry) => if(_slot_functions_exist(&entry), {
        res := resolve_some_type_to_concrete(entry.concrete_type.clone());
        vs := _slot_payload_c(&entry, context);
        is_unit := (vs == "void");
        context.base.emitter.emit_declaration_string_line(`static void __yo_dip_${key.clone()}(void* self_ptr);`);
        context.base.emitter.emit_declaration_string_line(`static void* __yo_pof_${key.clone()}(void* self_ptr);`);
        // drop_in_place
        context.base.emitter.emit_string_line(`static void __yo_dip_${key.clone()}(void* self_ptr) {`);
        if(is_unit, {
          context.base.emitter.emit_line("  (void)self_ptr;");
        }, {
          _emit_payload_address(&entry, &vs, context);
          match(
            get_drop_function_for_type(res.clone(), context),
            .Some(drop_c) => context.base.emitter.emit_string_line(`  ${drop_c}(*pp);`),
            .None => {
              before_len := context.base.emitter.code.len();
              dc := generate_drop_code_for_value(String.from("(*pp)"), res.clone(), context);
              if(dc.len() > usize(0), {
                context.base.emitter.emit_string_line(`  ${dc};`);
              }, {
                if((context.base.emitter.code.len() == before_len) && type_contains_rc_cell_or_move_only(res.clone()), {
                  context.base.emitter.emit_string_line(`  /* __yo_MISSING_DROP: no drop lowering for ${vs.clone()} */`);
                });
              });
            }
          );
        });
        context.base.emitter.emit_line("}");
        context.base.emitter.emit_line("");
        // payload_of
        context.base.emitter.emit_string_line(`static void* __yo_pof_${key.clone()}(void* self_ptr) {`);
        if(is_unit, {
          context.base.emitter.emit_line("  return self_ptr;");
        }, {
          _emit_payload_address(&entry, &vs, context);
          context.base.emitter.emit_line("  return (void*)pp;");
        });
        context.base.emitter.emit_line("}");
        context.base.emitter.emit_line("");
        // clone_into, for a Dyn that lists Clone
        if(dyn_type_lists_clone(entry.dyn_type.clone()), {
          req_traits := match(entry.dyn_type.clone(), Rc(.DynT({ required_trait_types })) => Rc.clone(required_trait_types), _ => no_types());
          clone_fid := dyn_impl_clone_fid(&req_traits.items, &entry.trait_values);
          context.base.emitter.emit_declaration_string_line(`static void __yo_cli_${key.clone()}(void* self_ptr, void* dst);`);
          context.base.emitter.emit_string_line(`static void __yo_cli_${key.clone()}(void* self_ptr, void* dst) {`);
          (clone_entry : Option(CodegenFunctionEntry)) = if(clone_fid.is_empty(), Option(CodegenFunctionEntry).None, context.base.get_function_entry(clone_fid.clone()));
          match(
            clone_entry,
            .Some(ce) => if(is_unit || should_skip_function_codegen(clone_fid.clone(), ce.c_name.clone(), &ce.value, &context.base), {
              context.base.emitter.emit_line("  (void)self_ptr; (void)dst;");
              if(!is_unit, {
                context.base.emitter.emit_line("  __yo_abort(); /* dyn clone unavailable: impl fn skipped (degraded type) */");
              });
            }, {
              _emit_payload_address(&entry, &vs, context);
              receiver := if(clone_fn_takes_self_by_ptr(&clone_fid), String.from("pp"), String.from("(*pp)"));
              context.base.emitter.emit_string_line(`  *(${vs.clone()}*)dst = ${ce.c_name.clone()}(${receiver});`);
            }),
            .None => {
              context.base.emitter.emit_line("  (void)self_ptr; (void)dst;");
              context.base.emitter.emit_line("  __yo_abort(); /* __yo_MISSING_CLONE: no clone function for this Dyn payload */");
            }
          );
          context.base.emitter.emit_line("}");
          context.base.emitter.emit_line("");
        });
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// Emit the wrapper-call statement for an impl method: unwraps the boxed/
/// concrete receiver (already declared) and forwards the remaining args.
/// `n_params` is the impl method's full parameter count (incl. self).
/// `arg_casts(j - 1)` is the C cast for `arg<j>` ("" for none) and
/// `ret_cast` the cast of the result ("" for none): the wrapper is defined
/// with the vtable slot's signature, and these convert to and from the impl
/// method's own C types where the two spellings differ.
_emit_wrapper_call :: (fn(em : &mut Emitter, cname : &String, first_arg : &String, n_params : usize, is_void : bool, arg_casts : &ArrayList(String), ret_cast : &String) -> unit)({
  mut(call) := String.from("");
  call.push_string(cname.clone());
  call.push_str("(");
  call.push_string(first_arg);
  (mut(j) : usize) = usize(1);
  while(j < n_params, {
    call.push_str(", ");
    match(
      arg_casts.get_cloned(j - usize(1)),
      .Some(c) => if(c.len() > usize(0), {
        call.push_str("(");
        call.push_string(c.clone());
        call.push_str(")");
      }),
      .None => ()
    );
    call.push_str("arg");
    call.push_string(j.to_string());
    j = (j + usize(1));
  });
  call.push_str(")");
  mut(line) := String.from("  ");
  if(!is_void, {
    line.push_str("return ");
    if(ret_cast.len() > usize(0), {
      line.push_str("(");
      line.push_string(ret_cast.clone());
      line.push_str(")");
    });
  });
  line.push_string(&call);
  line.push_str(";");
  em.emit_declaration_string_line(&line);
});
/// Resolve a boxed dyn payload type's SomeT fields/type-arguments through
/// their resolutions (`Rc(W)` → `Rc(<capture struct>)`). The
/// eval-side declared-param bridge (2026-07-27) registers the box spec on
/// the RESOLVED instantiation, so the collected C struct is keyed on it,
/// while the dyn impl entry recorded the wrapper-SomeT form at coercion
/// time. Unresolved SomeTs pass through unchanged.
_resolve_box_payload :: (fn(t : &TypeValue) -> TypeValue)(
  match(
    t,
    Rc(
      .Struct({
        id : rbp_id,
        name : rbp_nm,
        field_labels : rbp_fl,
        field_types : rbp_ft,
        is_reference_semantics : rbp_irs,
        is_atomic_rc : rbp_iar,
        is_newtype : rbp_inw,
        constructor_func_id : rbp_cfid,
        type_arguments : rbp_ta,
        is_source_namespace : rbp_isn
      })
    ) => {
      mut(rbp_new_ft) := ArrayList(TypeValue).new();
      (mut(rbp_i) : usize) = usize(0);
      while(rbp_i < rbp_ft.len(), {
        rbp_e := match(rbp_ft.get(rbp_i), .Some(x) => x, .None => Rc.new(TypeValueNode.Unit));
        (mut(rbp_r) : TypeValue) = Rc.clone(rbp_e);
        if(is_some_type(&rbp_e), {
          rbp_r = resolve_some_type_to_concrete(&rbp_e);
        });
        rbp_new_ft.push(rbp_r);
        rbp_i = (rbp_i + usize(1));
      });
      mut(rbp_new_ta) := ArrayList(TypeValue).new();
      (mut(rbp_j) : usize) = usize(0);
      while(rbp_j < rbp_ta.len(), {
        rbp_e2 := match(rbp_ta.get(rbp_j), .Some(x) => x, .None => Rc.new(TypeValueNode.Unit));
        (mut(rbp_r2) : TypeValue) = Rc.clone(rbp_e2);
        if(is_some_type(&rbp_e2), {
          rbp_r2 = resolve_some_type_to_concrete(&rbp_e2);
        });
        rbp_new_ta.push(rbp_r2);
        rbp_j = (rbp_j + usize(1));
      });
      Rc.new(TypeValueNode.Struct(rbp_id.clone(), rbp_nm.clone(), Rc.clone(rbp_fl), shared_list(rbp_new_ft), rbp_irs.*, rbp_iar.*, rbp_inw.*, rbp_cfid.clone(), shared_list(rbp_new_ta), rbp_isn.*))
    },
    _ => Rc.clone(t)
  )
);
/// C name for the boxed dyn payload: the raw recorded key first (the
/// pre-bridge convention), then the payload-resolved key (see
/// `_resolve_box_payload`).
_boxed_c_name :: (fn(data_type_in : &TypeValue, context : &FunctionGenerationContext) -> String)({
  data_type := _dyn_data_object_type(data_type_in);
  match(
    context.base.get_type_c_name(type_key(data_type.clone())),
    .Some(cn) => cn,
    .None => match(
      context.base.get_type_c_name(type_key(_resolve_box_payload(data_type.clone()))),
      .Some(cn2) => cn2,
      .None => `unknown_${type_key(data_type.clone())}`
    )
  )
});
/// A method wrapper's parameter list by the slot method type's C ABI
/// (`dyn_slot_param_abi_string`), `self_ptr` first.
_wrapper_params_abi :: (fn(slot_ft : &TypeValue, n : usize, start : usize, context : &mut FunctionGenerationContext) -> String)({
  mut(out) := String.from("void* self_ptr");
  (mut(j) : usize) = start;
  while(j < n, {
    out.push_str(", ");
    out.push_string(dyn_slot_param_abi_string(slot_ft, j, &mut context.base));
    out.push_str(" arg");
    out.push_string(((j - start) + usize(1)).to_string());
    j = (j + usize(1));
  });
  out
});
/// The `__yo_clone` slot's function for one impl of a `Dyn` that lists
/// `Clone` (plans/VALUES_BY_DEFAULT.md decision 7).
_dyn_clone_fn_name :: (fn(impl_key : &String) -> String)(`__yo_dyn_clone_${impl_key}`);
/// Emit `__yo_dyn_clone_<impl>(void* self_ptr)`, which `d.clone()` reaches
/// through the vtable (`__yo_dyn_clone`, functions/gc_runtime.yo): it returns
/// a fresh payload holding the impl's `clone` of this one, so the two `Dyn`s
/// share nothing. The fresh payload lands where the source lives (decision
/// 12, §3.11): a cell handle's fresh cell (V5's `Rc(T)`/`Arc(T)`) gets the
/// source's owner (`__yo_scope_of_object`) as its constructor's explicit
/// allocator; the auto-boxed `dyn(v)`'s box is global, as its source's is.
/// What the impl's `clone` allocates itself is global: there is no
/// allocation scope (plans/backlog/ALLOCATOR_PLACEMENT.md §6 B2b). A
/// reference payload is the impl's result itself.
/// The impl's `clone` comes from the `Clone` evidence the evaluator resolved
/// for this `dyn(...)` (`_resolve_dyn_trait_values`), which it guarantees for
/// a payload put into a `Dyn` that lists `Clone`.
_emit_dyn_clone_function :: (
  fn(impl_key : &String, req_traits : &ArrayList(TypeValue), trait_values : &ArrayList(EvalValue), data_type : &TypeValue, concrete_type : &TypeValue, context : &mut FunctionGenerationContext) -> unit
)({
  // The impl's `clone`: the `clone` field of the `Clone` trait's evidence.
  clone_fid := dyn_impl_clone_fid(req_traits, trait_values);
  is_boxed := is_boxed_type(data_type.clone());
  context.base.emitter.emit_declaration_string_line(`static void* ${_dyn_clone_fn_name(impl_key)}(void* self_ptr) {`);
  (clone_entry : Option(CodegenFunctionEntry)) = if(clone_fid.is_empty(), Option(CodegenFunctionEntry).None, context.base.get_function_entry(clone_fid.clone()));
  match(
    clone_entry,
    .Some(entry) => if(should_skip_function_codegen(clone_fid.clone(), entry.c_name.clone(), &entry.value, &context.base), {
      context.base.emitter.emit_declaration_line("  (void)self_ptr;");
      context.base.emitter.emit_declaration_line("  __yo_abort(); /* dyn clone unavailable: impl fn skipped (degraded type) */");
      context.base.emitter.emit_declaration_line("  return NULL;");
    }, {
      // `self : &Self` reaches the impl as `T` or as `T*` (`fn_abi_param_is_ptr`).
      self_by_ptr := clone_fn_takes_self_by_ptr(&clone_fid);
      (mut(receiver) : String) = String.new();
      if(is_boxed, {
        boxed_cname := _boxed_c_name(data_type.clone(), context);
        field_name := _box_field_name(data_type.clone());
        context.base.emitter.emit_declaration_string_line(`  ${boxed_cname}* box = (${boxed_cname}*)self_ptr;`);
        receiver = if(self_by_ptr, `&box->${field_name}`, `box->${field_name}`);
      }, {
        concrete_str := get_type_string(concrete_type.clone(), &mut context.base);
        context.base.emitter.emit_declaration_string_line(`  ${concrete_str} concrete_value = (${concrete_str})self_ptr;`);
        receiver = if(self_by_ptr, String.from("&concrete_value"), String.from("concrete_value"));
      });
      if(is_boxed, {
        boxed_cname := _boxed_c_name(data_type.clone(), context);
        // A cell primitive's constructor (a cell handle's box, V5's `Rc`/`Arc`)
        // takes the allocator first (`__yo_cell(V)(v, alloc)`,
        // functions/constructors.yo): the fresh box lands in the source's owner.
        scope_arg := if(is_cell_primitive_type(&_dyn_data_object_type(data_type)), String.from("__yo_scope_of_object(self_ptr), "), String.new());
        context.base.emitter.emit_declaration_string_line(`  ${boxed_cname}* out = __yo_new_${boxed_cname}(${scope_arg}${entry.c_name}(${receiver}));`);
      }, {
        concrete_str := get_type_string(concrete_type.clone(), &mut context.base);
        context.base.emitter.emit_declaration_string_line(`  ${concrete_str} out = ${entry.c_name}(${receiver});`);
      });
      context.base.emitter.emit_declaration_line("  return (void*)out;");
    }),
    .None => {
      context.base.emitter.emit_declaration_line("  (void)self_ptr;");
      context.base.emitter.emit_declaration_line("  __yo_abort(); /* __yo_MISSING_CLONE: no clone function for this Dyn payload */");
      context.base.emitter.emit_declaration_line("  return NULL;");
    }
  );
  context.base.emitter.emit_declaration_line("}");
  context.base.emitter.emit_declaration_line("");
});
/// Generate wrapper functions for dyn method dispatch. Each wrapper takes
/// `void* self_ptr`, unwraps it to the boxed value (is_boxed_type) or casts to
/// the concrete pointer, then calls the impl method. Two slot kinds: the Fn
/// synthetic `call` slot (FnTraitT) and regular trait methods (from the
/// TraitVal evidence records). The impl func + its type resolve via
/// the func-id side-table (get_func_type / get_function_entry). The Fn slot
/// uses the general `box->field.call(...)` fat-pointer path.
generate_dyn_wrapper_functions :: (fn(context : &mut FunctionGenerationContext) -> unit)({
  if(context.base.dyn_impls.is_empty(), {
    return(());
  });
  context.base.emitter.emit_declaration_line("");
  context.base.emitter.emit_declaration_line("// === Dyn Wrapper Functions ===");
  context.base.emitter.emit_declaration_line("// Wrappers that unwrap boxed values and call impl methods");
  context.base.emitter.emit_declaration_line("");
  keys := _dyn_impl_keys(context);
  nk := keys.len();
  // The `__yo_dyn_self_copy_<impl>` helpers already emitted (one per impl).
  self_copies := HashSet(String).new();
  (ki : usize) = usize(0);
  while(ki < nk, {
    impl_key := match(keys.get_cloned(ki), .Some(k) => k, .None => String.from(""));
    match(
      context.base.dyn_impls.get(impl_key.clone()),
      .Some(impl_entry) => {
        data_type := impl_entry.data_type.clone();
        is_boxed := is_boxed_type(data_type.clone());
        req_traits := match(impl_entry.dyn_type.clone(), Rc(.DynT({ required_trait_types })) => Rc.clone(required_trait_types), _ => no_types());
        nt := req_traits.len();
        // Pass 1: Fn synthetic `call` slot.
        (ti : usize) = usize(0);
        while(ti < nt, {
          match(
            req_traits.get(ti),
            .Some(rt) => if(is_fn_trait_type(rt.clone()), {
              match(
                Rc.clone(rt),
                Rc(.FnTraitT({ base_name : fn_base, call_param_types, call_result })) => {
                  // `Fn(...) -> &T` (N1c): the slot has the projection's ABI.
                  return_str := dyn_slot_result_abi_string(&rt, &mut context.base);
                  // A `Dyn(FnOnce(...))` call consumes the Dyn (decision 37):
                  // the wrapper releases the box after the call.
                  is_call_once := (fn_base == "FnOnce");
                  wrapper := `__yo_wrap_${impl_key}_call`;
                  params := _wrapper_params_abi(&rt, call_param_types.len(), usize(0), context);
                  context.base.emitter.emit_declaration_string_line(`static ${return_str} ${wrapper}(${params}) {`);
                  ncp := call_param_types.len();
                  // A `unit` result lowers to C `void` too: the call is a
                  // statement and nothing holds its result (a `void
                  // __yo_once_r` temp is not C,
                  // issues/fixed/a-unit-returning-dyn-fnonce-call-slot-declares-a-void-temp.md).
                  is_void := (is_void_type(&call_result) || (return_str == "void"));
                  // Dyn'd CLOSURE: the boxed payload is the closure's CAPTURE
                  // STRUCT — resolve the closure C fn via impl_closure_call_map
                  // (capture-struct id → fn name) and call it directly with
                  // `(void*)&box-><payload>` as the closure_context.
                  cc_struct_id := match(
                    impl_entry.concrete_type.clone(),
                    Rc(.Struct({ id : csid })) => csid.clone(),
                    // Impl(Fn) SOMET concrete (dyn'd closure): the capture
                    // struct rides on resolved_concrete — key the map with it.
                    Rc(.SomeT({ resolution : ccrc })) => match(
                      ccrc,
                      .Some(ccrct) => match(ccrct, Rc(.Struct({ id : csid2 })) => csid2.clone(), _ => String.from("")),
                      .None => String.from("")
                    ),
                    _ => String.from("")
                  );
                  cc_info := if(cc_struct_id.len() > usize(0), context.base.impl_closure_call_map.get(&cc_struct_id), Option(ImplClosureCallInfo).None);
                  fn_payload := dyn_concrete_func_type(impl_entry.concrete_type.clone());
                  if(impl_entry.payload_convention && match(cc_info, .Some(_) => true, .None => false), {
                    // A reference-kind Dyn over a closure (`dyn(&f)`): the data
                    // word is the capture struct's own address, and nothing is
                    // released (the Dyn borrows it).
                    cc_fn_p := match(cc_info, .Some(mp) => mp.function_c_name.clone(), .None => String.from(""));
                    call_p := String.from("  ");
                    if(!is_void, {
                      call_p.push_str("return ");
                    });
                    call_p.push_string(&cc_fn_p);
                    call_p.push_str("(self_ptr");
                    (cpi : usize) = usize(0);
                    while(cpi < ncp, {
                      call_p.push_str(", arg");
                      call_p.push_string((cpi + usize(1)).to_string());
                      cpi = (cpi + usize(1));
                    });
                    call_p.push_str(");");
                    context.base.emitter.emit_declaration_string_line(&call_p);
                  }, if(is_boxed && match(cc_info, .Some(_) => true, .None => false), {
                    boxed_cname := _boxed_c_name(data_type.clone(), context);
                    field_name := _box_field_name(data_type.clone());
                    context.base.emitter.emit_declaration_string_line(`  ${boxed_cname}* box = (${boxed_cname}*)self_ptr;`);
                    cc_fn := match(cc_info, .Some(mp) => mp.function_c_name.clone(), .None => String.from(""));
                    call := String.from("  ");
                    if(!is_void, {
                      call.push_string(if(is_call_once, `${return_str} __yo_once_r = `, String.from("return ")));
                    });
                    call.push_string(&cc_fn);
                    call.push_str("((void*)&box->");
                    call.push_string(field_name.clone());
                    (cai : usize) = usize(0);
                    while(cai < ncp, {
                      call.push_str(", arg");
                      call.push_string((cai + usize(1)).to_string());
                      cai = (cai + usize(1));
                    });
                    call.push_str(");");
                    context.base.emitter.emit_declaration_string_line(&call);
                    if(is_call_once, {
                      // The call consumed the Dyn: release the box here. A
                      // payload closure typed `FnOnce(...)` with a capture
                      // list already took its captures (its body moved or
                      // dropped them), so the box must free its memory
                      // without disposing the payload again: clear the
                      // header's dispose (the `type_id` dispatch tag). An `Fn`
                      // payload's body only borrowed its captures, so the
                      // box's ordinary dispose drops them.
                      payload_owns := match(cc_info, .Some(mp) => is_fnonce_closure_fn(mp.closure_fid.clone()), .None => false);
                      if(payload_owns, {
                        context.base.emitter.emit_declaration_line("  box->header.type_id = 0;");
                      });
                      context.base.emitter.emit_declaration_string_line(if(_dyn_data_is_atomic(data_type.clone()), String.from("  __yo_decr_rc_atomic((void*)box);"), String.from("  __yo_decr_rc((void*)box);")));
                      if(!is_void, {
                        context.base.emitter.emit_declaration_line("  return __yo_once_r;");
                      });
                    });
                  }, if(is_boxed && fn_payload.is_some(), {
                    // Dyn'd `fn(...)` VALUE (a named function, or an
                    // `Impl(Fn(...))` parameter bound to one): the boxed
                    // payload is the code pointer itself (a function-typed
                    // field is `void*`), with nothing captured. Call it
                    // through its own prototype, as a call through a
                    // `fn(...)` value is spelled (other_fn_call.yo), and hand
                    // each argument over at the pointer level the prototype
                    // takes it at (`fn_abi_param_is_ptr`: a `&mut T` and a
                    // projection's `&T` are `T*`) where the slot's spelling
                    // differs (issues/fixed/dyn-of-a-named-function-value-emits-invalid-c.md).
                    pay_fn := match(fn_payload, .Some(pf) => Rc.clone(pf), .None => Rc.new(TypeValueNode.Unit));
                    pay_ptr := fn_abi_param_is_ptr(&pay_fn);
                    boxed_cname := _boxed_c_name(data_type.clone(), context);
                    field_name := _box_field_name(data_type.clone());
                    context.base.emitter.emit_declaration_string_line(`  ${boxed_cname}* box = (${boxed_cname}*)self_ptr;`);
                    call := String.from("  ");
                    if(!is_void, {
                      call.push_string(if(is_call_once, `${return_str} __yo_once_r = `, String.from("return ")));
                    });
                    call.push_str("((");
                    call.push_string(generate_function_prototype(&pay_fn, String.from("(*)"), &mut context.base, Option(String).None, false));
                    call.push_str(")box->");
                    call.push_string(field_name.clone());
                    call.push_str(")(");
                    (fai : usize) = usize(0);
                    while(fai < ncp, {
                      if(fai > usize(0), {
                        call.push_str(", ");
                      });
                      slot_is_ptr := match(fn_abi_param_is_ptr(&rt).get(fai), .Some(b) => b, .None => false);
                      fn_is_ptr := match(pay_ptr.get(fai), .Some(b) => b, .None => false);
                      call.push_string(
                        cond(
                          (slot_is_ptr && !fn_is_ptr) => String.from("*"),
                          (!slot_is_ptr && fn_is_ptr) => String.from("&"),
                          true => String.from("")
                        )
                      );
                      call.push_str("arg");
                      call.push_string((fai + usize(1)).to_string());
                      fai = (fai + usize(1));
                    });
                    call.push_str(");");
                    context.base.emitter.emit_declaration_string_line(&call);
                    if(is_call_once, {
                      // The call consumed the Dyn: release the box. A code
                      // pointer owns nothing, so its dispose has nothing to
                      // drop.
                      context.base.emitter.emit_declaration_string_line(if(_dyn_data_is_atomic(data_type.clone()), String.from("  __yo_decr_rc_atomic((void*)box);"), String.from("  __yo_decr_rc((void*)box);")));
                      if(!is_void, {
                        context.base.emitter.emit_declaration_line("  return __yo_once_r;");
                      });
                    });
                  }, if(is_boxed && !is_some_type(resolve_some_type_to_concrete(impl_entry.concrete_type.clone())), {
                    // Gated on a RESOLVED inner: an unresolved-SomeT payload's
                    // Rc field degenerates to `void*` in C, so the fat-pointer
                    // `.call` below is invalid ("member reference base type
                    // 'void *'", the fn batch clang error). Fall through to
                    // the zeroed stub — nothing calls it, its callers were
                    // dropped by the same eval-side throw.
                    boxed_cname := _boxed_c_name(data_type.clone(), context);
                    field_name := _box_field_name(data_type.clone());
                    context.base.emitter.emit_declaration_string_line(`  ${boxed_cname}* box = (${boxed_cname}*)self_ptr;`);
                    // General fat-pointer path: box->field.call(box->field.data, args...).
                    call := String.from("  ");
                    if(!is_void, {
                      call.push_str("return ");
                    });
                    call.push_str("box->");
                    call.push_string(field_name.clone());
                    call.push_str(".call(box->");
                    call.push_string(field_name.clone());
                    call.push_str(".data");
                    (ai : usize) = usize(0);
                    while(ai < ncp, {
                      call.push_str(", arg");
                      call.push_string((ai + usize(1)).to_string());
                      ai = (ai + usize(1));
                    });
                    call.push_str(");");
                    context.base.emitter.emit_declaration_string_line(&call);
                  }, {
                    context.base.emitter.emit_declaration_string_line(`  (void)self_ptr; /* Dyn(Fn): expected Rc(...) data */`);
                    (ai2 : usize) = usize(0);
                    while(ai2 < ncp, {
                      context.base.emitter.emit_declaration_string_line(`  (void)arg${(ai2 + usize(1)).to_string()};`);
                      ai2 = (ai2 + usize(1));
                    });
                    // `void zero` is not C (the stub's only job is to compile).
                    if(is_void, {
                      context.base.emitter.emit_declaration_line("  return;");
                    }, {
                      context.base.emitter.emit_declaration_string_line(`  ${return_str} zero = (${return_str})0;`);
                      context.base.emitter.emit_declaration_line("  return zero;");
                    });
                  }))));
                  context.base.emitter.emit_declaration_line("}");
                  context.base.emitter.emit_declaration_line("");
                },
                _ => ()
              );
            }),
            .None => ()
          );
          ti = (ti + usize(1));
        });
        // Pass 2: regular trait methods (from the TraitVal evidence records).
        (mi : usize) = usize(0);
        while(mi < nt, {
          skip := match(req_traits.get(mi), .Some(rt) => is_fn_trait_type(rt.clone()), .None => true);
          if(!skip, {
            match(
              impl_entry.trait_values.get(mi),
              .Some(trait_val) => match(
                trait_val,
                .TraitVal(_, field_names, field_values) => {
                  nf := field_names.len();
                  (fi : usize) = usize(0);
                  while(fi < nf, {
                    label := match(field_names.get_cloned(fi), .Some(l) => l, .None => String.from(""));
                    // Pre-bind the owned-clone subexpression so it is declared
                    // unconditionally (a `label.clone()` inside a short-circuit
                    // `||` mis-scopes its drop).
                    label_reserved := _is_reserved_dyn_label(label.clone(), req_traits.get(mi));
                    // A wrapper only for a vtable slot (the typedef's rule):
                    // a member a Dyn cannot call has no slot to fill.
                    // The slot's member type is also the wrapper's C signature:
                    // the runtime calls the wrapper through the slot, and a
                    // call through an incompatible function type is UB.
                    (slot_ty : Option(TypeValue)) = match(
                      req_traits.get(mi),
                      .Some(rt) => match(
                        rt,
                        Rc(.TraitT({ body : tfl_body })) => {
                          tfl := tfl_body.field_labels();
                          tft := tfl_body.field_types();
                          (sl_found : Option(TypeValue)) = Option(TypeValue).None;
                          (sl_j : usize) = usize(0);
                          while((sl_j < tfl.len()) && sl_found.is_none(), {
                            if(match(tfl.get_cloned(sl_j), .Some(l) => (l == label), .None => false), {
                              sl_ty := match(tft.get_cloned(sl_j), .Some(t) => t, .None => Rc.new(TypeValueNode.Unit));
                              if(dyn_member_is_method(&sl_ty) && dyn_member_unsafe_reason(&sl_ty).is_none(), {
                                sl_found = Option(TypeValue).Some(sl_ty);
                              });
                            });
                            sl_j = (sl_j + usize(1));
                          });
                          sl_found
                        },
                        _ => Option(TypeValue).None
                      ),
                      .None => Option(TypeValue).None
                    );
                    is_slot := slot_ty.is_some();
                    is_reserved := ((label == "Self") || label_reserved || !is_slot);
                    if(!is_reserved, {
                      match(
                        field_values.get(fi),
                        .Some(opt_fv) => match(
                          opt_fv,
                          .Some(fv) => if(is_func_val(&fv), {
                            func_id := _func_val_id(&fv);
                            match(
                              context.base.get_function_entry(func_id.clone()),
                              .Some(entry) => match(
                                get_func_type(func_id.clone()),
                                Rc(.Func({ param_types, result : result_slot })) => {
                                  result := t_slot_pointee(&result_slot);
                                  impl_cname := entry.c_name.clone();
                                  // The label is sanitized like the slot's field
                                  // name: an operator member (`LogicalNot`'s `!`)
                                  // spelled raw is not a C identifier
                                  // (issues/fixed/a-dyn-over-an-operator-trait-emits-an-invalid-c-wrapper-name.md).
                                  wrapper := `__yo_wrap_${impl_key}_${sanitize_for_c_identifier(label.clone(), false)}`;
                                  impl_fn_ty := get_func_type(func_id.clone());
                                  return_str := dyn_slot_result_abi_string(&impl_fn_ty, &mut context.base);
                                  // Defined with the SLOT's signature (the vtable
                                  // initializer below takes it uncast); the impl's
                                  // own C types are reached by casts inside. A
                                  // Future-returning method is the case that
                                  // differs: the impl returns its concrete future,
                                  // the trait the Future interface pointer.
                                  slot_params_tys := match(&slot_ty, .Some(Rc(.Func({ param_types : spt }))) => Rc.clone(spt), _ => param_types.clone());
                                  slot_ret := match(&slot_ty, .Some(sft) => dyn_slot_result_abi_string(&sft.*, &mut context.base), .None => return_str.clone());
                                  slot_fn_ty := match(&slot_ty, .Some(sft) => Rc.clone(sft), .None => impl_fn_ty.clone());

                                  params := _wrapper_params_abi(&slot_fn_ty, slot_params_tys.len(), usize(1), context);
                                  arg_casts := ArrayList(String).new();
                                  (ac_j : usize) = usize(1);
                                  while(ac_j < param_types.len(), {
                                    impl_pt := dyn_slot_param_abi_string(&impl_fn_ty, ac_j, &mut context.base);
                                    slot_pt := if(ac_j < slot_params_tys.len(), dyn_slot_param_abi_string(&slot_fn_ty, ac_j, &mut context.base), String.new());
                                    arg_casts.push(if(impl_pt == slot_pt, String.new(), impl_pt));
                                    ac_j = (ac_j + usize(1));
                                  });
                                  ret_cast := if(slot_ret == return_str, String.new(), slot_ret.clone());
                                  // A projection's `self : &Self` is passed as a pointer too
                                  // (decision 34, `fn_abi_param_is_ptr`).
                                  pbp := (match(param_types.get(usize(0)), .Some(p0) => (is_pointer_type(&t_slot_pointee(&p0)) || t_slot_is_mut_ref(&p0)), .None => false) || match(fn_abi_param_is_ptr(&impl_fn_ty).get(usize(0)), .Some(b) => b, .None => false));
                                  // A by-value `self` (`LogicalNot`'s `(!)`, decision 34
                                  // as amended 2026-10-11) is OWNED by the impl, which
                                  // drops it at its end, while the Dyn keeps owning its
                                  // payload: hand the impl a copy, its RC fields
                                  // incremented, or the call frees what the Dyn still
                                  // holds (issues/fixed/a-by-value-self-called-through-a-dyn-frees-the-payload.md).
                                  // A move-only payload never reaches here: the
                                  // evaluator rejects boxing it behind a by-value slot.
                                  // Emitted before the wrapper, whose body follows in
                                  // the declarations buffer.
                                  self_owned := match(param_types.get(usize(0)), .Some(o) => t_slot_is_by_value(&o), .None => false);
                                  self_concrete := resolve_some_type_to_concrete(impl_entry.concrete_type.clone());
                                  (self_copy_fn : Option(String)) = Option(String).None;
                                  if(!pbp && self_owned && type_contains_rc_cell_or_move_only(&self_concrete), {
                                    copy_fn := `__yo_dyn_self_copy_${impl_key}`;
                                    if(!self_copies.contains(copy_fn.clone()), {
                                      self_copies.insert(copy_fn.clone());
                                      self_c := get_type_string(self_concrete.clone(), &mut context.base);
                                      context.base.emitter.emit_declaration_string_line(`static ${self_c} ${copy_fn}(${self_c} v);`);
                                      // The dup lowering may emit statements (a value
                                      // struct's per-field dups) through the CODE
                                      // buffer, so the helper is defined there.
                                      context.base.emitter.emit_string_line(`static ${self_c} ${copy_fn}(${self_c} v) {`);
                                      copy_code := generate_dup_code_for_value(String.from("v"), self_concrete.clone(), context);
                                      context.base.emitter.emit_string_line(`  return ${copy_code};`);
                                      context.base.emitter.emit_line("}");
                                      context.base.emitter.emit_line("");
                                    });
                                    self_copy_fn = Option(String).Some(copy_fn);
                                  });
                                  context.base.emitter.emit_declaration_string_line(`static ${slot_ret} ${wrapper}(${params}) {`);
                                  (first_arg : String) = String.from("");
                                  if(impl_entry.payload_convention, {
                                    // A reference-kind Dyn: the data word is the payload's address.
                                    pay_c := get_type_string(self_concrete.clone(), &mut context.base);
                                    first_arg = if(pbp, `((${pay_c}*)self_ptr)`, `(*(${pay_c}*)self_ptr)`);
                                  }, if(is_boxed, {
                                    boxed_cname := _boxed_c_name(data_type.clone(), context);
                                    field_name := _box_field_name(data_type.clone());
                                    context.base.emitter.emit_declaration_string_line(`  ${boxed_cname}* box = (${boxed_cname}*)self_ptr;`);
                                    first_arg = if(pbp, `&box->${field_name}`, `box->${field_name}`);
                                  }, {
                                    concrete_str := get_type_string(impl_entry.concrete_type.clone(), &mut context.base);
                                    context.base.emitter.emit_declaration_string_line(`  ${concrete_str} concrete_value = (${concrete_str})self_ptr;`);
                                    first_arg = if(pbp, String.from("&concrete_value"), String.from("concrete_value"));
                                  }));
                                  match(
                                    self_copy_fn,
                                    .Some(cf) => {
                                      first_arg = `${cf}(${first_arg})`;
                                    },
                                    .None => ()
                                  );
                                  // A method whose DEFINITION the generic/comptime skip drops
                                  // (a degraded registered type — the identity family) must not
                                  // be CALLED from the wrapper: the C would reference an
                                  // undeclared function and fail the whole batch. Emit a
                                  // visible runtime trap instead — every other test in the
                                  // batch compiles; only dispatching THIS method aborts.
                                  if(should_skip_function_codegen(func_id.clone(), entry.c_name.clone(), &entry.value, &context.base), {
                                    context.base.emitter.emit_declaration_string_line(`  __yo_abort(); /* dyn method unavailable: impl fn skipped (degraded type) */`);
                                  }, {
                                    _emit_wrapper_call(&mut context.base.emitter, &impl_cname, &first_arg, param_types.len(), is_void_type(&result), &arg_casts, &ret_cast);
                                  });
                                  context.base.emitter.emit_declaration_line("}");
                                  context.base.emitter.emit_declaration_line("");
                                },
                                _ => context.base.emitter.emit_declaration_string_line(`/* Warning: Module field ${label} is not a function type */`)
                              ),
                              .None => context.base.emitter.emit_declaration_string_line(`/* Warning: Impl function for ${label} not found */`)
                            );
                          }),
                          .None => context.base.emitter.emit_declaration_string_line(`/* Warning: Module field ${label} is not a function value */`)
                        ),
                        .None => ()
                      );
                    });
                    fi = (fi + usize(1));
                  });
                },
                _ => ()
              ),
              .None => context.base.emitter.emit_declaration_string_line(`/* Warning: Module value missing for module ${mi.to_string()} */`)
            );
          });
          mi = (mi + usize(1));
        });
        // Pass 3: the clone slot of a Dyn that lists Clone.
        if(dyn_type_lists_clone(impl_entry.dyn_type.clone()), {
          _emit_dyn_clone_function(&impl_key, &req_traits.items, &impl_entry.trait_values, &data_type, &impl_entry.concrete_type, context);
        });
      },
      .None => ()
    );
    ki = (ki + usize(1));
  });
});
/// Generate static vtables for dyn implementations.
/// a unique TypeId static per concrete type (its address
/// is the runtime TypeId), then one `static const <Dyn>_vtable __yo_vtable_<key>`
/// per impl whose first field is the type id and whose method slots reference the
/// wrappers emitted above (`.call` for Fn traits; `.method` for trait methods
/// whose first param is `self`).
generate_dyn_vtables :: (fn(context : &mut FunctionGenerationContext) -> unit)({
  if(context.base.dyn_impls.is_empty(), {
    return(());
  });
  context.base.emitter.emit_declaration_line("");
  context.base.emitter.emit_declaration_line("// === Dyn TypeId Statics ===");
  context.base.emitter.emit_declaration_line("// Unique static per concrete type — address is the runtime TypeId");
  context.base.emitter.emit_declaration_line("");
  keys := _dyn_impl_keys(context);
  nk := keys.len();
  // Pass 1: emit unique TypeId statics (one per concrete C name).
  generated := HashSet(String).new();
  (ti : usize) = usize(0);
  while(ti < nk, {
    impl_key := match(keys.get_cloned(ti), .Some(k) => k, .None => String.from(""));
    match(
      context.base.dyn_impls.get(impl_key.clone()),
      .Some(impl_entry) => {
        concrete_cname := match(dyn_concrete_c_name(impl_entry.concrete_type.clone(), &context.base), .Some(cn) => cn, .None => `unknown_${type_key(impl_entry.concrete_type.clone())}`);
        typeid_name := `__yo_typeid_${concrete_cname}`;
        if(!generated.contains(typeid_name.clone()) && !context.base.type_id_static_names.contains(typeid_name.clone()), {
          generated.insert(typeid_name.clone());
          context.base.type_id_static_names.insert(typeid_name.clone());
          context.base.type_id_statics.insert(type_key(impl_entry.concrete_type.clone()), typeid_name.clone());
          context.base.emit_typeid_static(typeid_name.clone(), ` // TypeId for ${concrete_cname}`);
        }, {
          // Name already emitted by the typeid/downcast expression emitters —
          // still record the key mapping so vtables reference the shared static.
          context.base.type_id_statics.insert(type_key(impl_entry.concrete_type.clone()), typeid_name.clone());
        });
      },
      .None => ()
    );
    ti = (ti + usize(1));
  });
  context.base.emitter.emit_declaration_line("");
  context.base.emitter.emit_declaration_line("// === Dyn Static Vtables ===");
  context.base.emitter.emit_declaration_line("// Static vtables for dynamic dispatch");
  context.base.emitter.emit_declaration_line("");
  // A vtable with `upcast` targets points at the payload's target vtables
  // (`__yo_up_<Tgt>`), which may be emitted after it: declare every instance
  // first. Only when the program upcasts, so no other output changes.
  if(!context.base.dyn_upcasts.is_empty(), {
    (fi : usize) = usize(0);
    while(fi < nk, {
      fkey := match(keys.get_cloned(fi), .Some(k) => k, .None => String.from(""));
      match(
        context.base.dyn_impls.get(fkey.clone()),
        .Some(fentry) => {
          f_dyn_c := match(context.base.get_type_c_name(type_key(fentry.dyn_type.clone())), .Some(cn) => cn, .None => `__yo_dyn_${type_key(fentry.dyn_type.clone())}`);
          context.base.emitter.emit_declaration_string_line(`static const ${f_dyn_c}_vtable __yo_vtable_${fkey};`);
        },
        .None => ()
      );
      fi = (fi + usize(1));
    });
    context.base.emitter.emit_declaration_line("");
  });
  // The retain and release of a reference-kind Dyn, dyn(&v): it borrows its
  // payload, so neither counts anything.
  (any_payload : bool) = false;
  for(&context.base.dyn_impls, (_pk, pe) => {
    if(pe.payload_convention, {
      any_payload = true;
    });
  });
  if(any_payload, {
    context.base.emitter.emit_declaration_line("static void* __yo_dyn_noop_retain(void* data) { return data; }");
    context.base.emitter.emit_declaration_line("static void __yo_dyn_noop_release(void* data) { (void)data; }");
    context.base.emitter.emit_declaration_line("");
  });
  // Pass 2: emit the vtable instances.
  (vi : usize) = usize(0);
  while(vi < nk, {
    impl_key := match(keys.get_cloned(vi), .Some(k) => k, .None => String.from(""));
    match(
      context.base.dyn_impls.get(impl_key.clone()),
      .Some(impl_entry) => {
        dyn_cname := match(context.base.get_type_c_name(type_key(impl_entry.dyn_type.clone())), .Some(cn) => cn, .None => `__yo_dyn_${type_key(impl_entry.dyn_type.clone())}`);
        concrete_cname := match(dyn_concrete_c_name(impl_entry.concrete_type.clone(), &context.base), .Some(cn) => cn, .None => `unknown_${type_key(impl_entry.concrete_type.clone())}`);
        vtable_name := `__yo_vtable_${impl_key}`;
        vtable_type := `${dyn_cname}_vtable`;
        typeid_name := `__yo_typeid_${concrete_cname}`;
        context.base.emitter.emit_declaration_string_line(`// Vtable for impl(${concrete_cname}, ${dyn_cname})`);
        context.base.emitter.emit_declaration_string_line(`static const ${vtable_type} ${vtable_name} = {`);
        context.base.emitter.emit_declaration_string_line(`  .__yo_type_id = (uintptr_t)&${typeid_name},`);
        // The payload's own size and alignment, and the slot functions that
        // reach it from the data word (decision 49).
        slot_vs := _slot_payload_c(&impl_entry, context);
        slot_unit := (slot_vs == "void");
        context.base.emitter.emit_declaration_string_line(if(slot_unit, String.from("  .__yo_size = 0,"), `  .__yo_size = sizeof(${slot_vs.clone()}),`));
        context.base.emitter.emit_declaration_string_line(if(slot_unit, String.from("  .__yo_align = 1,"), `  .__yo_align = _Alignof(${slot_vs.clone()}),`));
        has_slots := _slot_functions_exist(&impl_entry);
        context.base.emitter.emit_declaration_string_line(if(has_slots, `  .__yo_drop_in_place = __yo_dip_${impl_key.clone()},`, String.from("  .__yo_drop_in_place = NULL,")));
        context.base.emitter.emit_declaration_string_line(if(has_slots && dyn_type_lists_clone(impl_entry.dyn_type.clone()), `  .__yo_clone_into = __yo_cli_${impl_key.clone()},`, String.from("  .__yo_clone_into = NULL,")));
        context.base.emitter.emit_declaration_string_line(if(has_slots, `  .__yo_payload_of = __yo_pof_${impl_key.clone()},`, String.from("  .__yo_payload_of = NULL,")));
        data_atomic := _dyn_data_is_atomic(impl_entry.data_type.clone());
        context.base.emitter.emit_declaration_string_line(if(impl_entry.payload_convention, `  .__yo_retain = __yo_dyn_noop_retain,`, if(data_atomic, `  .__yo_retain = __yo_incr_rc_atomic,`, `  .__yo_retain = __yo_incr_rc,`)));
        context.base.emitter.emit_declaration_string_line(if(impl_entry.payload_convention, `  .__yo_release = __yo_dyn_noop_release,`, if(data_atomic, `  .__yo_release = __yo_decr_rc_atomic,`, `  .__yo_release = __yo_decr_rc,`)));
        // The clone slot: this impl's `__yo_dyn_clone_<impl>` for a Dyn that
        // lists Clone (emitted with the wrappers), NULL for any other Dyn,
        // which is never copied through it (decision 7).
        context.base.emitter.emit_declaration_string_line(if(dyn_type_lists_clone(impl_entry.dyn_type.clone()), `  .__yo_clone = ${_dyn_clone_fn_name(&impl_key)},`, String.from("  .__yo_clone = NULL,")));
        req_traits := match(impl_entry.dyn_type.clone(), Rc(.DynT({ required_trait_types })) => Rc.clone(required_trait_types), _ => no_types());
        nt := req_traits.len();
        processed := HashSet(String).new();
        (mi : usize) = usize(0);
        while(mi < nt, {
          match(
            req_traits.get(mi),
            .Some(rt) => if(is_fn_trait_type(rt.clone()), {
              // Uncast: the wrapper is defined from the same FnTraitT as the
              // member, so a mismatch is a C compile error, never a call
              // through an incompatible function type.
              context.base.emitter.emit_declaration_string_line(`  .call = __yo_wrap_${impl_key}_call,`);
              processed.insert(String.from("call"));
            }, {
              match(
                &rt,
                Rc(.TraitT({ body : field_labels_body })) => {
                  field_labels := field_labels_body.field_labels();
                  field_types := field_labels_body.field_types();
                  nfl := field_labels.len();
                  (fi : usize) = usize(0);
                  while(fi < nfl, {
                    label := match(field_labels.get_cloned(fi), .Some(l) => l, .None => String.from(""));
                    // Pre-bind owned-clone subexpressions (short-circuit `||`
                    // mis-scopes their drops).
                    label_reserved := _is_reserved_dyn_label(label.clone(), Option(TypeValue).Some(rt.clone()));
                    label_processed := processed.contains(label.clone());
                    is_skip := ((label == "Self") || label_reserved || label_processed);
                    if(!is_skip, {
                      processed.insert(label.clone());
                      // Only emit a slot for a method a Dyn can call: first
                      // param `self`, no `generic(...)`, `Self` only as the
                      // receiver (the vtable typedef's rule, types/utils.yo).
                      has_self := match(
                        field_types.get_cloned(fi),
                        .Some(ft) => (dyn_member_is_method(&ft) && dyn_member_unsafe_reason(&ft).is_none()),
                        .None => false
                      );
                      if(has_self, {
                        // Uncast, like `.call` above: the wrapper is defined
                        // with this member's own signature (the TRAIT's), and
                        // casts to the impl's types inside.
                        context.base.emitter.emit_declaration_string_line(`  .${sanitize_for_c_identifier(label.clone(), false)} = __yo_wrap_${impl_key}_${sanitize_for_c_identifier(label.clone(), false)},`);
                      });
                    });
                    fi = (fi + usize(1));
                  });
                },
                _ => ()
              );
            }),
            .None => ()
          );
          mi = (mi + usize(1));
        });
        // `__yo_up_<Tgt>`: this payload's vtable for each upcast target
        // (`register_dyn_upcast_targets` registered the entry).
        up_targets := context.base.dyn_upcast_targets(impl_entry.dyn_type.clone());
        (ui : usize) = usize(0);
        while(ui < up_targets.len(), {
          ut := match(up_targets.get_cloned(ui), .Some(t) => t, .None => Rc.new(TypeValueNode.Unit));
          ut_key := type_key(ut.clone());
          ut_c := match(context.base.get_type_c_name(ut_key.clone()), .Some(cn) => cn, .None => get_type_string(ut.clone(), &mut context.base));
          concrete_key := type_key(impl_entry.concrete_type.clone());
          (uk : usize) = usize(0);
          (u_found : bool) = false;
          while((uk < nk) && !u_found, {
            cand := match(keys.get_cloned(uk), .Some(k) => k, .None => String.from(""));
            match(
              context.base.dyn_impls.get(cand.clone()),
              .Some(ce) => if((type_key(ce.dyn_type.clone()) == ut_key) && (type_key(ce.concrete_type.clone()) == concrete_key) && (dyn_impl_key_suffix(ce.payload_convention, &ce.data_type) == dyn_impl_key_suffix(impl_entry.payload_convention, &impl_entry.data_type)), {
                context.base.emitter.emit_declaration_string_line(`  .__yo_up_${ut_c} = &__yo_vtable_${cand},`);
                u_found = true;
              }),
              .None => ()
            );
            uk = (uk + usize(1));
          });
          ui = (ui + usize(1));
        });
        context.base.emitter.emit_declaration_line("};");
        context.base.emitter.emit_declaration_line("");
      },
      .None => ()
    );
    vi = (vi + usize(1));
  });
});
export(generate_dyn_dup_drop, generate_dyn_box_functions, generate_dyn_slot_functions, generate_dyn_wrapper_functions, generate_dyn_vtables);
