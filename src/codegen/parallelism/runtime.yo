//! C codegen for the parallelism runtime (Thread + Worker pool).
//!
//! Emits the `__yo_thread_*` (dedicated OS thread) and `__yo_worker_*`
//! (`std/thread`'s `ThreadPool`: an owned pool handle, one shared queue plus a
//! queue per worker) C runtime. The thread/sync TYPES it references
//! (`__yo_thread_t`, `__yo_worker_pool_t`, `__yo_thread_fn`, `__YO_THREAD_TYPE`, `__YO_COND_TYPE`,
//! `__yo_raw_thread_create`, `PARALLELISM_DEBUG`, …) are emitted separately by
//! `codegen/types/generation.yo`. Wired into `generate_all_functions` (gated on
//! `uses_parallelism`), beside `generate_async_runtime`.
//!
//! NOTE: the C body is emitted as many `emit_string_line` calls (each a pure
//! literal or a single conditional value, 0 interpolations per call),
//! mirroring `async/runtime-core.yo`. A single ~380-line template with 16
//! `${}` interpolations desugars to a deep string-concat AST that the
//! compiler processes pathologically slowly; the sibling async-runtime files
//! use the same split-emit idiom for the same reason.
import("std/string");
{ Emitter } :: import("../../emitter.yo");
{ TargetInfo, is_target_macos, is_target_linux, is_target_windows } :: import("../../target.yo");
generate_parallelism_runtime :: (
  fn(emitter : &mut Emitter, debug_parallelism : bool, target_info : &TargetInfo, uses_async : bool, debug_alloc : bool) -> unit
)({
  debug_parallelism;
  // `--allocator debug`: the program's threads are counted, so the exit
  // report can wait for them (a running thread's stack is no root). Counted
  // in before the thread is created, so a thread the report races cannot be
  // missed; counted out as the thread's last act, after everything it frees.
  thread_enter_line := if(debug_alloc, `  __yo_debug_alloc_thread_enter();\n`, ``);
  thread_leave_line := if(debug_alloc, `  __yo_debug_alloc_thread_leave();\n`, ``);
  creation_failed_leave_line := if(debug_alloc, `    __yo_debug_alloc_thread_leave();\n`, ``);
  worker_enter_line := if(debug_alloc, `    __yo_debug_alloc_thread_enter();\n`, ``);
  worker_failed_leave_line := if(debug_alloc, `      __yo_debug_alloc_thread_leave();\n`, ``);
  is_windows := is_target_windows(target_info);
  _is_linux := is_target_linux(target_info);
  _is_macos := is_target_macos(target_info);
  thread_entry_signature := if(
    is_windows,
    `static unsigned __stdcall __yo_thread_entry(void* arg) {`,
    `static void* __yo_thread_entry(void* arg) {`
  );
  thread_entry_return := if(is_windows, `${thread_leave_line}  return 0;`, `${thread_leave_line}  return NULL;`);
  worker_entry_signature := if(
    is_windows,
    `static unsigned __stdcall __yo_worker_thread_entry(void* arg) {`,
    `static void* __yo_worker_thread_entry(void* arg) {`
  );
  worker_entry_return := if(is_windows, `${thread_leave_line}  return 0;`, `${thread_leave_line}  return NULL;`);
  async_init_thread := if(
    uses_async,
    `
  // Initialize per-thread async event loop (io_uring/kqueue/IOCP)
  __yo_async_scheduler_init();`,
    ``
  );
  async_wait_thread := if(
    uses_async,
    `
  // Drain per-thread event loop — wait for all async tasks spawned in this thread
  __yo_async_wait_all();
  // ...and RELEASE it. __yo_async_wait_all calls __yo_io_init, so every spawned
  // thread creates its own io_uring/kqueue/IOCP plus a notify descriptor; the
  // only other __yo_io_cleanup call is in the async-main driver, which runs on
  // the main loop thread and never sees these. Without this, each spawned
  // thread leaked a kernel ring and an fd for the life of the process, and a
  // program that spawns a few hundred threads died with
  // 'io_uring_queue_init failed: Cannot allocate memory'
  // (issues/fixed/every-spawned-thread-leaks-its-event-loop.md).
  // First wait out any other thread still inside a notify addressed to this
  // loop, which dies with the thread (rule D7).
  __yo_async_loop_quiesce();
  __yo_io_cleanup();`,
    ``
  );
  async_cleanup_worker := if(
    uses_async,
    `
  // Release this worker thread's event loop (see the Thread entry point).
  __yo_async_loop_quiesce();
  __yo_io_cleanup();`,
    ``
  );
  async_wait_worker := if(
    uses_async,
    `
      // Drain per-thread event loop — wait for all async tasks from this task
      __yo_async_wait_all();`,
    ``
  );
  // --- Thread runtime header + entry-point prologue (up to the signature) ---
  emitter.emit_string_line(
    `
// ============================================================================
// Parallelism Runtime - Thread and Worker
// ============================================================================

// ============================================================================
// Thread - Dedicated OS Thread
// ============================================================================
// Simple wrapper around pthread. Each Thread runs on its own OS thread.
// - spawn: create new OS thread with closure (returns by value)
// - join: wait for thread to complete
//
// Note: __yo_thread_t and __yo_thread_fn are defined in the runtime types section
// to ensure they're available before user struct types that depend on them.

// Thread entry point wrapper
typedef struct __yo_thread_entry_args_t {
  __yo_thread_fn fn;            // User's function
  void* closure;                // User's closure data
} __yo_thread_entry_args_t;

// Thread entry point`
  );
  emitter.emit_string_line(&thread_entry_signature);
  emitter.emit_string_line(
    `  __yo_thread_entry_args_t* args = (__yo_thread_entry_args_t*)arg;

  PARALLELISM_DEBUG("[THREAD] Thread started (tid=%zu)\\n", (size_t)__yo_get_thread_id());`
  );
  emitter.emit_string_line(&async_init_thread);
  emitter.emit_string_line(
    `
  // Call user's function with closure
  args->fn(args->closure);`
  );
  emitter.emit_string_line(&async_wait_thread);
  emitter.emit_string_line(
    `
  PARALLELISM_DEBUG("[THREAD] Thread completed (tid=%zu)\\n", (size_t)__yo_get_thread_id());

  // Note: closure data is freed by the spawn wrapper (which handles RC cleanup)

  // Free args
  __yo_free(args);

  // Release this thread's async runtime pools.
  __yo_cleanup_thread();
`
  );
  emitter.emit_string_line(&thread_entry_return);
  emitter.emit_string_line(
    `}

// Spawn a new OS thread (returns by value)
// The codegen will handle extracting the closure function pointer and data
static __yo_thread_t __yo_thread_spawn(__yo_thread_fn fn, void* closure) {
  PARALLELISM_DEBUG("[THREAD] Spawning new thread\\n");
  // Tell every event loop in the process that a wake can now come from
  // outside it (see __yo_threads_ever_spawned).
  __yo_note_spawn();

  __yo_thread_t thread;

  // Allocate entry args
  __yo_thread_entry_args_t* args = (__yo_thread_entry_args_t*)__yo_rc_alloc(sizeof(__yo_thread_entry_args_t));
  args->fn = fn;
  args->closure = closure;

  // Create OS thread
${thread_enter_line}  int ret = __yo_raw_thread_create(&thread.handle, __yo_thread_entry, args);
  if (ret != 0) {
${creation_failed_leave_line}    PARALLELISM_DEBUG("[THREAD] Failed to create thread (ret=%d); running inline\\n", ret);
    // Same contract as __yo_worker_pool_submit's inline fallback: with no OS thread
    // the closure would never run at all — its work silently dropped and its
    // reference-counted captures never released, since the wrapper that drops
    // and frees them IS the thread body
    // (issues/fixed/wasi-thread-pool-submit-deadlock.md). Run it here, then
    // hand back a zero handle that __yo_thread_join skips.
    fn(closure);
    __yo_free(args);
    thread.handle = (__YO_THREAD_TYPE){0};
    return thread;
  }

  PARALLELISM_DEBUG("[THREAD] Spawned thread\\n");
  return thread;
}

// Wait for thread to complete
static void __yo_thread_join(__yo_thread_t thread) {
  // Zero handle: __yo_thread_spawn could not create a thread and already ran
  // the task inline, so there is nothing to wait for — and pthread_join(0) is
  // undefined (issues/fixed/wasi-thread-pool-submit-deadlock.md).
  if (__YO_THREAD_HANDLE_IS_NULL(thread.handle)) {
    PARALLELISM_DEBUG("[THREAD] Join on a null handle (task ran inline)\\n");
    return;
  }
  PARALLELISM_DEBUG("[THREAD] Joining thread\\n");
  __yo_raw_thread_join(thread.handle);
  PARALLELISM_DEBUG("[THREAD] Thread joined\\n");
}

// Give up the right to join: the thread keeps running and the OS reclaims its
// bookkeeping when it finishes. std/thread's Thread calls this from Drop
// for a handle that was never joined (Rust's JoinHandle::drop); before that,
// every un-joined thread leaked a joinable pthread / an open HANDLE
// (issues/fixed/thread-join-was-re-callable-and-handles-leaked.md).
static void __yo_thread_detach(__yo_thread_t thread) {
  if (__YO_THREAD_HANDLE_IS_NULL(thread.handle)) {
    return;
  }
  PARALLELISM_DEBUG("[THREAD] Detaching thread\\n");
  __yo_raw_thread_detach(thread.handle);
}
`
  );
  emitter.emit_string_line(
    `// ============================================================================
// Worker pool - std/thread's ThreadPool
// ============================================================================
// A pool is a value (__yo_worker_pool_t, a pointer to the struct below) that
// owns exactly the worker threads __yo_worker_pool_create made. Every worker
// has its own async event loop.
//
// Unstarted tasks wait in ONE queue shared by the workers: an idle worker takes
// the next one, so a task that awaits something slow delays nothing queued
// behind it. A task submitted with __yo_worker_pool_submit_to(pool, i, ...)
// goes on worker i's own queue instead, which only worker i takes, and which
// it checks before the shared one. A worker runs one task at a time, to
// completion, including the async work that task spawned
// (__yo_async_wait_all after every task); a started task never moves to
// another thread. No work stealing, no CPU affinity.
//
// Every queue, flag and counter of a pool is guarded by the pool's one mutex.
// Each worker sleeps on its own condition variable, so a submission wakes
// exactly the worker that should take the task.

// Task node for the pool's queues
typedef struct __yo_worker_task_t {
  __yo_thread_fn fn;                    // Task function
  void* closure;                        // Task closure data
  struct __yo_worker_task_t* next;      // Next task in queue
} __yo_worker_task_t;

// One worker thread of a pool
typedef struct __yo_worker_slot_t {
  struct __yo_worker_pool_s* pool;      // The pool this worker belongs to
  size_t index;                         // Its index in the pool, 0..count-1
  __YO_THREAD_TYPE handle;              // OS thread handle (joinable)
  __YO_COND_TYPE cond;                  // Its wake-up (guarded by pool->mutex)
  __yo_worker_task_t* pinned_head;      // Tasks only this worker takes
  __yo_worker_task_t* pinned_tail;
  int waiting;                          // Asleep on cond with nothing to take
} __yo_worker_slot_t;

struct __yo_worker_pool_s {
  __YO_THREAD_SYNC_TYPE mutex;          // Guards every field below
  __yo_worker_task_t* shared_head;      // The shared intake queue
  __yo_worker_task_t* shared_tail;
  __yo_worker_slot_t* workers;          // count slots
  size_t count;                         // Workers created; fixed after create
  size_t live;                          // Workers whose loop has not ended
  int closed;                           // A worker with no task left exits
  int joining;                          // __yo_worker_pool_shutdown_join entered
  int joined;                           // ... and returned
  __YO_COND_TYPE joined_cond;           // Later shutdown_join callers wait here
  int released;                         // __yo_worker_pool_destroy called
};

// The calling thread's worker slot, NULL on a thread that is not a pool
// worker. Read by worker_id() and by the own-worker checks.
static _Thread_local __yo_worker_slot_t* __yo_worker_self = NULL;

static void __yo_worker_pool_free(struct __yo_worker_pool_s* pool) {
  for (size_t i = 0; i < pool->count; i++) {
    __yo_cond_destroy(&pool->workers[i].cond);
  }
  __yo_cond_destroy(&pool->joined_cond);
  __yo_mutex_destroy(&pool->mutex);
  __yo_free(pool->workers);
  __yo_free(pool);
}

// Wake worker i if it is asleep. Caller holds pool->mutex. Clearing `waiting`
// here, not in the worker, keeps a second submission from signalling the same
// sleeper again while another worker sleeps on.
static inline void __yo_worker_pool_wake(struct __yo_worker_pool_s* pool, size_t i) {
  __yo_worker_slot_t* w = &pool->workers[i];
  if (w->waiting) {
    w->waiting = 0;
    __yo_cond_signal(&w->cond);
  }
}

// Worker thread entry point
`
  );
  emitter.emit_string_line(&worker_entry_signature);
  emitter.emit_string_line(
    `  __yo_worker_slot_t* self = (__yo_worker_slot_t*)arg;
  struct __yo_worker_pool_s* pool = self->pool;
  __yo_worker_self = self;

  PARALLELISM_DEBUG("[WORKER] Worker %zu started (tid=%zu)\\n", self->index, (size_t)__yo_get_thread_id());`
  );
  emitter.emit_string_line(&async_init_thread);
  emitter.emit_string_line(
    `
  __yo_mutex_lock(&pool->mutex);
  for (;;) {
    // Own queue first, then the shared one.
    __yo_worker_task_t* task = self->pinned_head;
    if (task != NULL) {
      self->pinned_head = task->next;
      if (self->pinned_head == NULL) {
        self->pinned_tail = NULL;
      }
    } else if (pool->shared_head != NULL) {
      task = pool->shared_head;
      pool->shared_head = task->next;
      if (pool->shared_head == NULL) {
        pool->shared_tail = NULL;
      }
    }

    if (task != NULL) {
      __yo_mutex_unlock(&pool->mutex);
      PARALLELISM_DEBUG("[WORKER] Worker %zu executing a task\\n", self->index);
      task->fn(task->closure);`
  );
  emitter.emit_string_line(&async_wait_worker);
  emitter.emit_string_line(
    `
      // Note: closure data is freed by the spawn wrapper (which handles RC cleanup)
      __yo_free(task);
      __yo_mutex_lock(&pool->mutex);
      continue;
    }

    // Both queues are empty: a closed pool's worker is done, an open pool's
    // worker sleeps until a submission or the close wakes it.
    if (pool->closed) {
      break;
    }
    self->waiting = 1;
    __yo_cond_wait(&self->cond, &pool->mutex);
    self->waiting = 0;
  }
  // The last worker out frees a pool that was already released: the pool was
  // dropped by one of its own tasks, which could not join the worker it ran on
  // (see __yo_worker_pool_shutdown_join).
  pool->live--;
  int free_pool = (pool->live == 0 && pool->released);
  __yo_mutex_unlock(&pool->mutex);
  __yo_worker_self = NULL;
  PARALLELISM_DEBUG("[WORKER] Worker exiting (tid=%zu)\\n", (size_t)__yo_get_thread_id());
  if (free_pool) {
    __yo_worker_pool_free(pool);
  }
`
  );
  // Release this worker's event loop. Deliberately at THREAD exit and not
  // beside the per-task __yo_async_wait_all above: a pool thread runs many
  // tasks, and tearing the ring down after each one would rebuild it for the
  // next. The leak is per-THREAD, so the release belongs at thread teardown.
  emitter.emit_string_line(&async_cleanup_worker);
  // Release this worker's async runtime pools last (see the Thread entry point).
  emitter.emit_string_line(`  __yo_cleanup_thread();`);
  emitter.emit_string_line(&worker_entry_return);
  emitter.emit_string_line(
    `}

// Create a pool of exactly num_threads workers. A worker the OS refuses to
// create is not retried: the pool keeps the ones that started, and with none
// (standalone WASI has no threads) every submission runs inline on the
// submitting thread.
static __yo_worker_pool_t __yo_worker_pool_create(size_t num_threads) {
  PARALLELISM_DEBUG("[WORKER] Creating a pool of %zu workers\\n", num_threads);
  struct __yo_worker_pool_s* pool = (struct __yo_worker_pool_s*)__yo_rc_alloc(sizeof(struct __yo_worker_pool_s));
  __yo_mutex_init(&pool->mutex);
  __yo_cond_init(&pool->joined_cond);
  pool->shared_head = NULL;
  pool->shared_tail = NULL;
  pool->workers = (__yo_worker_slot_t*)__yo_rc_alloc(sizeof(__yo_worker_slot_t) * (num_threads == 0 ? 1 : num_threads));
  pool->count = 0;
  pool->live = 0;
  pool->closed = 0;
  pool->joining = 0;
  pool->joined = 0;
  pool->released = 0;

  // Held across the creations: a worker that starts at once blocks on it until
  // count and live are final.
  __yo_mutex_lock(&pool->mutex);
  for (size_t i = 0; i < num_threads; i++) {
    __yo_worker_slot_t* w = &pool->workers[i];
    w->pool = pool;
    w->index = i;
    w->pinned_head = NULL;
    w->pinned_tail = NULL;
    w->waiting = 0;
    __yo_cond_init(&w->cond);`
  );
  emitter.emit_string_line(&worker_enter_line);
  emitter.emit_string_line(
    `    int ret = __yo_raw_thread_create(&w->handle, __yo_worker_thread_entry, w);
    if (ret != 0) {`
  );
  emitter.emit_string_line(&worker_failed_leave_line);
  emitter.emit_string_line(
    `      PARALLELISM_DEBUG("[WORKER] Failed to create worker %zu (ret=%d)\\n", i, ret);
      __yo_cond_destroy(&w->cond);
      break;
    }
    pool->count++;
    pool->live++;
  }
  __yo_mutex_unlock(&pool->mutex);
  PARALLELISM_DEBUG("[WORKER] Pool has %zu workers\\n", pool->count);
  return pool;
}

// The number of workers the pool has.
static size_t __yo_worker_pool_worker_count(__yo_worker_pool_t pool) {
  return pool->count;
}

static void __yo_worker_pool_enqueue(__yo_worker_task_t** head, __yo_worker_task_t** tail, __yo_worker_task_t* task) {
  if (*tail == NULL) {
    *head = task;
  } else {
    (*tail)->next = task;
  }
  *tail = task;
}

static __yo_worker_task_t* __yo_worker_pool_task(__yo_thread_fn fn, void* closure) {
  __yo_worker_task_t* task = (__yo_worker_task_t*)__yo_rc_alloc(sizeof(__yo_worker_task_t));
  task->fn = fn;
  task->closure = closure;
  task->next = NULL;
  return task;
}

// Submit a task to the shared queue; the first idle worker takes it.
static void __yo_worker_pool_submit(__yo_worker_pool_t pool, __yo_thread_fn fn, void* closure) {
  // A pool worker can wake a loop on another thread just as a dedicated
  // thread can (see __yo_threads_ever_spawned).
  __yo_note_spawn();
  // No worker could be created (standalone WASI: pthread_create fails). Run
  // the task on the submitting thread, so the work still happens and a drain
  // always terminates (issues/fixed/wasi-thread-pool-submit-deadlock.md). The
  // spawn wrapper is thread-agnostic (call the closure, drop its captures,
  // free them); the per-task __yo_async_wait_all belongs to a worker's own
  // loop, so it is deliberately NOT run here: draining the caller's loop from
  // inside a submission would re-enter it.
  if (pool->count == 0) {
    PARALLELISM_DEBUG("[WORKER] Pool has no worker; running task inline\\n");
    fn(closure);
    return;
  }
  __yo_worker_task_t* task = __yo_worker_pool_task(fn, closure);
  __yo_mutex_lock(&pool->mutex);
  __yo_worker_pool_enqueue(&pool->shared_head, &pool->shared_tail, task);
  // Wake one sleeping worker. None asleep means every worker is running a
  // task, and each checks the shared queue before it sleeps again.
  for (size_t i = 0; i < pool->count; i++) {
    if (pool->workers[i].waiting) {
      __yo_worker_pool_wake(pool, i);
      break;
    }
  }
  __yo_mutex_unlock(&pool->mutex);
}

// Submit a task to worker i's own queue; only worker i takes it. std/thread
// checks i < count; a pool with no worker runs the task inline, as
// __yo_worker_pool_submit does.
static void __yo_worker_pool_submit_to(__yo_worker_pool_t pool, size_t i, __yo_thread_fn fn, void* closure) {
  __yo_note_spawn();
  if (pool->count == 0) {
    PARALLELISM_DEBUG("[WORKER] Pool has no worker; running pinned task inline\\n");
    fn(closure);
    return;
  }
  __yo_worker_task_t* task = __yo_worker_pool_task(fn, closure);
  __yo_mutex_lock(&pool->mutex);
  __yo_worker_slot_t* w = &pool->workers[i];
  __yo_worker_pool_enqueue(&w->pinned_head, &w->pinned_tail, task);
  __yo_worker_pool_wake(pool, i);
  __yo_mutex_unlock(&pool->mutex);
}

// True on a worker thread of this pool.
static bool __yo_worker_pool_on_own_worker(__yo_worker_pool_t pool) {
  return __yo_worker_self != NULL && __yo_worker_self->pool == pool;
}

// The calling pool worker's index in its pool, or SIZE_MAX on any other thread.
static size_t __yo_worker_current_index(void) {
  return __yo_worker_self != NULL ? __yo_worker_self->index : SIZE_MAX;
}

// Close the pool and join its workers. A worker exits once the pool is closed
// and both its queues are empty, so the join is the drain of everything
// already submitted. Idempotent and thread-safe: a later caller waits until
// the first one has joined. Called on one of the pool's own workers (a task
// shut its own pool down), it cannot join the thread it runs on: it closes the
// pool and returns, and the workers exit once the queues are empty.
static void __yo_worker_pool_shutdown_join(__yo_worker_pool_t pool) {
  int on_own_worker = __yo_worker_pool_on_own_worker(pool);
  __yo_mutex_lock(&pool->mutex);
  pool->closed = 1;
  for (size_t i = 0; i < pool->count; i++) {
    __yo_worker_pool_wake(pool, i);
  }
  if (on_own_worker) {
    __yo_mutex_unlock(&pool->mutex);
    return;
  }
  if (pool->joining) {
    while (!pool->joined) {
      __yo_cond_wait(&pool->joined_cond, &pool->mutex);
    }
    __yo_mutex_unlock(&pool->mutex);
    return;
  }
  pool->joining = 1;
  __yo_mutex_unlock(&pool->mutex);

  PARALLELISM_DEBUG("[WORKER] Joining %zu workers\\n", pool->count);
  for (size_t i = 0; i < pool->count; i++) {
    __yo_raw_thread_join(pool->workers[i].handle);
  }

  __yo_mutex_lock(&pool->mutex);
  pool->joined = 1;
  __yo_cond_broadcast(&pool->joined_cond);
  __yo_mutex_unlock(&pool->mutex);
}

// Release the handle, after __yo_worker_pool_shutdown_join (std/thread's
// ThreadPool drop). Dropped by its owner, the pool's workers are joined and it
// is freed here. Dropped inside one of its own tasks (the task held the last
// Arc(ThreadPool)), nothing will join the workers: they are detached, and the
// last one to exit frees the pool.
static void __yo_worker_pool_destroy(__yo_worker_pool_t pool) {
  int on_own_worker = __yo_worker_pool_on_own_worker(pool);
  __yo_mutex_lock(&pool->mutex);
  if (on_own_worker) {
    for (size_t i = 0; i < pool->count; i++) {
      __yo_raw_thread_detach(pool->workers[i].handle);
    }
  }
  pool->released = 1;
  int free_now = (pool->live == 0);
  __yo_mutex_unlock(&pool->mutex);
  if (free_now) {
    __yo_worker_pool_free(pool);
  }
}

// __yo_get_hardware_threads / __yo_get_cpu_id are emitted by the sys runtime
// (always present) - see runtime-io-common.yo.`
  );
});
export(generate_parallelism_runtime);
