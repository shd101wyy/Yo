    });
    // FS event close + poll operations (common POSIX). On Linux a poll handle's
    // fd also joins the backend's watch set (runtime_io_linux.yo), so a ready
    // fd ends a blocked wait instead of being noticed at the next tick.
    poll_watch_defs := cond(
      is_linux =>
        `
// The watch-set interest for fd: the union of every started poll handle on
// it (two handles may watch one fd). Called after a handle starts or stops.
static void __yo_poll_sync_watch(int fd) {
  uint32_t mask = 0;
  for (__yo_poll_t* ph = __yo_active_polls; ph; ph = ph->next) {
    if (!ph->active || ph->fd != fd) continue;
    if (ph->events & 1) mask |= EPOLLIN;
    if (ph->events & 2) mask |= EPOLLOUT;
    if (ph->events & 8) mask |= EPOLLPRI;
  }
  int32_t rc = __yo_io_watch_set(fd, mask);
  for (__yo_poll_t* ph = __yo_active_polls; ph; ph = ph->next) {
    if (ph->fd == fd) ph->unpollable = (rc == -EPERM) ? 1 : 0;
  }
}

static bool __yo_watch_needs_polling(void) {
  for (__yo_poll_t* ph = __yo_active_polls; ph; ph = ph->next) {
    if (ph->active && ph->unpollable) return true;
  }
  return false;
}`,
      is_macos =>
        `
// The watch-set interest for fd: the union of every started poll handle on it
// (two handles may watch one fd). Called after a handle starts or stops.
static void __yo_poll_sync_watch(int fd) {
  int want_read = 0, want_write = 0, want_pri = 0, any = 0;
  for (__yo_poll_t* ph = __yo_active_polls; ph; ph = ph->next) {
    if (!ph->active || ph->fd != fd) continue;
    any = 1;
    if (ph->events & 1) want_read = 1;
    if (ph->events & 2) want_write = 1;
    if (ph->events & 8) want_pri = 1;
  }
  int unpollable = 0;
  if (any) {
    struct stat st;
    if (fstat(fd, &st) == 0 && (S_ISREG(st.st_mode) || S_ISDIR(st.st_mode))) unpollable = 1;
  }
  if (!unpollable) {
    if (__yo_io_watch_set(fd, EVFILT_READ, want_read && !unpollable) < 0) unpollable = 1;
    if (__yo_io_watch_set(fd, EVFILT_WRITE, want_write && !unpollable) < 0) unpollable = 1;
  }
  if (!unpollable && want_pri) {
    // POLLPRI is kqueue's EVFILT_EXCEPT/NOTE_OOB, which only sockets accept.
    struct kevent ev;
    EV_SET(&ev, fd, EVFILT_EXCEPT, EV_ADD, NOTE_OOB, 0, NULL);
    if (__yo_watch_kq_open() < 0 || kevent(__yo_watch_kq, &ev, 1, NULL, 0, NULL) < 0) unpollable = 1;
  } else if (__yo_watch_kq >= 0) {
    struct kevent ev;
    EV_SET(&ev, fd, EVFILT_EXCEPT, EV_DELETE, 0, 0, NULL);
    (void)kevent(__yo_watch_kq, &ev, 1, NULL, 0, NULL);
  }
  if (unpollable) {
    // Whatever was added before the refusal must not keep reporting.
    (void)__yo_io_watch_set(fd, EVFILT_READ, false);
    (void)__yo_io_watch_set(fd, EVFILT_WRITE, false);
  }
  for (__yo_poll_t* ph = __yo_active_polls; ph; ph = ph->next) {
    if (ph->fd == fd) ph->unpollable = unpollable;
  }
}

// When the loop's wait must end without an event (see the backend's
// __yo_io_wait): the earliest directory rescan or missing-path check, and
// "10 ms from now" while a poll handle watches a descriptor kqueue cannot.
static uint64_t __yo_watch_next_due_ns(void) {
  uint64_t due = UINT64_MAX;
  for (__yo_fs_event_t* fse = __yo_active_fs_events; fse; fse = fse->next) {
    if (fse->active && fse->next_scan_ns < due) due = fse->next_scan_ns;
  }
  for (__yo_poll_t* ph = __yo_active_polls; ph; ph = ph->next) {
    if (ph->active && ph->unpollable) {
      uint64_t soon = __yo_mono_ns() + 10ull * 1000000ull;
      if (soon < due) due = soon;
      break;
    }
  }
  return due;
}`,
      true => String.from("")
    );
    poll_watch_sync := cond(
      (is_linux || is_macos) => String.from("  __yo_poll_sync_watch(handle->fd);"),
      true => String.from("")
    );
    // macOS: the watch set marks a handle ready, and only ready (or
    // unpollable) handles are polled by the tick.
    poll_ready_field := cond(
      is_macos => String.from("  // The watch set reported the fd since the last tick.\n  int ready;"),
      true => String.from("")
    );
    poll_start_ready := cond(
      is_macos => String.from("  // Serviced by the first tick, as when every tick polled every handle.\n  handle->ready = 1;"),
      true => String.from("")
    );
    emitter.emit_string_line(
      `
static void __yo_fs_event_close(void* h) {
  __yo_fs_event_t* handle = (__yo_fs_event_t*)h;
  if (!handle) return;
  if (handle->active) __yo_fs_event_stop(h);
  __yo_free(handle);
}

// ============================================================================
// Poll Operations (POSIX poll())
// ============================================================================

typedef struct __yo_poll_s {
  int fd;
  int events;
  void (*callback)(int32_t, int32_t, uint8_t*);
  void* user_data;
  int active;
  // The backend's watch set refused this fd (Linux: epoll's EPERM for a
  // regular file; macOS: a regular file, which poll reports always ready but
  // kqueue only before EOF, or a directory or device kqueue refuses); the loop
  // keeps polling for it.
  int unpollable;
${poll_ready_field}
  struct __yo_poll_s* next;
} __yo_poll_t;

static _Thread_local __yo_poll_t* __yo_active_polls = NULL;
${poll_watch_defs}

static void* __yo_poll_init(int32_t fd) {
  __yo_poll_t* handle = (__yo_poll_t*)__yo_rc_alloc(sizeof(__yo_poll_t));
  memset(handle, 0, sizeof(__yo_poll_t));
  handle->fd = fd;
  return handle;
}

static int32_t __yo_poll_start(void* h, int32_t events, void* callback, void* user_data) {
  __yo_poll_t* handle = (__yo_poll_t*)h;
  if (!handle || !callback) return -EINVAL;

  handle->events = events;
  handle->callback = (void (*)(int32_t, int32_t, uint8_t*))callback;
  handle->user_data = user_data;
  handle->active = 1;
${poll_start_ready}

  handle->next = __yo_active_polls;
  __yo_active_polls = handle;
  __yo_active_watch_count++;
${poll_watch_sync}
  return 0;
}

static int32_t __yo_poll_stop(void* h) {
  __yo_poll_t* handle = (__yo_poll_t*)h;
  if (!handle) return -EINVAL;
  if (!handle->active) return 0;

  handle->active = 0;
  __yo_active_watch_count--;

  __yo_poll_t** pp = &__yo_active_polls;
  while (*pp) {
    if (*pp == handle) {
      *pp = handle->next;
      break;
    }
    pp = &(*pp)->next;
  }
  handle->next = NULL;
${poll_watch_sync}
  return 0;
}

static void __yo_poll_close(void* h) {
  __yo_poll_t* handle = (__yo_poll_t*)h;
  if (!handle) return;
  if (handle->active) __yo_poll_stop(h);
  __yo_free(handle);
}
`
    );
    // --- Tick function (platform-specific FS event handling) ---
    linux_tick := cond(
      is_linux =>
        `  {
    __yo_fs_event_t* fse = __yo_active_fs_events;
    while (fse) {
      __yo_fs_event_t* next = fse->next;
      if (fse->active && fse->fd >= 0) {
        char buf[4096] __attribute__((aligned(__alignof__(struct inotify_event))));
        ssize_t len = read(fse->fd, buf, sizeof(buf));
        if (len > 0) {
          char* ptr = buf;
          while (ptr < buf + len) {
            struct inotify_event* event = (struct inotify_event*)ptr;
            int __yo_event = 0;
            if (event->mask & (IN_CREATE | IN_DELETE | IN_MOVED_FROM | IN_MOVED_TO)) {
              __yo_event = 1;
            }
            if (event->mask & (IN_MODIFY | IN_ATTRIB)) {
              __yo_event |= 2;
            }
            const char* name = (event->len > 0) ? event->name : "";
            if (fse->callback && fse->active) {
              fse->callback((uint8_t*)name, __yo_event, fse->user_data);
              count++;
            }
            ptr += sizeof(struct inotify_event) + event->len;
          }
        }
      }
      fse = next;
    }
  }`,
      true => String.from("")
    );
    macos_tick := cond(
      is_macos =>
        `  // Nothing is watched: nothing to collect, service or poll.
  if (__yo_active_watch_count == 0) return 0;
  // --- Collect what the watch set reported ---
  if (__yo_watch_ready && __yo_watch_kq >= 0) {
    __yo_watch_ready = false;
    struct kevent evs[64];
    struct timespec zero = {0, 0};
    int n;
    do {
      n = kevent(__yo_watch_kq, NULL, 0, evs, 64, &zero);
      for (int i = 0; i < n; i++) {
        int fd = (int)evs[i].ident;
        if (evs[i].filter == EVFILT_VNODE) {
          for (__yo_fs_event_t* fse = __yo_active_fs_events; fse; fse = fse->next) {
            if (fse->active && fse->fd == fd) fse->vnode_flags |= (uint32_t)evs[i].fflags;
          }
        } else {
          for (__yo_poll_t* ph = __yo_active_polls; ph; ph = ph->next) {
            if (ph->active && ph->fd == fd) ph->ready = 1;
          }
        }
      }
    } while (n == 64);
  }

  // --- Service FS event handles: reported, or due ---
  {
    uint64_t now = UINT64_MAX;
    __yo_fs_event_t* fse = __yo_active_fs_events;
    while (fse) {
      __yo_fs_event_t* next = fse->next;
      if (fse->active) {
        uint32_t fflags = fse->vnode_flags;
        bool due = false;
        if (fflags == 0 && fse->next_scan_ns != UINT64_MAX) {
          if (now == UINT64_MAX) now = __yo_mono_ns();
          due = now >= fse->next_scan_ns;
        }
        if (fflags != 0 || due) {
          fse->vnode_flags = 0;
          count += __yo_fs_event_service(fse, fflags);
        }
      }
      fse = next;
    }
  }`,
      true => String.from("")
    );
    // macOS polls only the handles the watch set reported (or cannot watch);
    // poll(2) still gives the callback its exact meaning (POLLHUP, POLLPRI, a
    // report that is no longer ready).
    poll_tick_select := cond(
      is_macos => String.from("      if (ph->active && (ph->ready || ph->unpollable)) {\n        ph->ready = 0;"),
      true => String.from("      if (ph->active) {")
    );
    emitter.emit_string_line(
      `
// ============================================================================
// Tick function: check all active poll and fs_event handles (non-blocking)
// ============================================================================

static int __yo_poll_and_fs_event_tick(void) {
  int count = 0;

  // --- Tick FS event handles ---
${linux_tick}
${macos_tick}

  // --- Tick poll handles ---
  {
    __yo_poll_t* ph = __yo_active_polls;
    while (ph) {
      __yo_poll_t* next = ph->next;
${poll_tick_select}
        struct pollfd pfd;
        pfd.fd = ph->fd;
        pfd.events = 0;
        if (ph->events & 1) pfd.events |= POLLIN;
        if (ph->events & 2) pfd.events |= POLLOUT;
        if (ph->events & 8) pfd.events |= POLLPRI;
        pfd.revents = 0;

        int ret = poll(&pfd, 1, 0);
        if (ret > 0) {
          int __yo_events = 0;
          if (pfd.revents & POLLIN)  __yo_events |= 1;
          if (pfd.revents & POLLOUT) __yo_events |= 2;
          if (pfd.revents & POLLHUP) __yo_events |= 4;
          if (pfd.revents & POLLPRI) __yo_events |= 8;
          if (ph->callback && ph->active) {
            ph->callback(__yo_events, 0, ph->user_data);
            count++;
          }
        } else if (ret < 0) {
          if (ph->callback && ph->active) {
            ph->callback(0, -errno, ph->user_data);
            count++;
          }
        }
      }
      ph = next;
    }
  }

  return count;
}`
    );
  });
});

generate_tls_runtime :: (fn(emitter : Emitter) -> unit)({
  // The ABI (std/crypto/tls.yo) is OpenSSL-shaped and BIO-based: the Yo pump
  // moves ciphertext between two opaque in-memory buffers and the socket, and
  // asks for plaintext through read/write. Both real backends present that
  // shape. The TARGET picks one in the emitted C's own preprocessor guard, so
  // one emission serves every target.
  emitter.emit_string(`\n// === TLS backend (std/crypto/tls ABI) ===\n`);
  emitter.emit_string(`#if defined(_WIN32)\n`);
  emitter.emit_string(
    `// Schannel through SSPI. The ABI above is OpenSSL-shaped, but nothing in it
// is OpenSSL-specific: the Yo pump (std/crypto/tls.yo) only moves ciphertext
// between two opaque in-memory buffers and the socket, and asks for plaintext
// through read/write. Schannel is a stream transform of the same shape —
// InitializeSecurityContext consumes a handshake token and produces one,
// EncryptMessage/DecryptMessage transform records — so this backend supplies
// the two buffers OpenSSL's memory BIOs provided, plus one for plaintext that
// DecryptMessage produced but the reader has not taken yet.
#define SECURITY_WIN32
#include <windows.h>
#include <security.h>
#include <schannel.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// The three SSL_get_error results std/crypto/tls.yo tests for; any other
// value is fatal to it and raises TlsError.
#define __YO_TLS_E_FATAL 1
#define __YO_TLS_E_WANT_READ 2
#define __YO_TLS_E_WANT_WRITE 3
#define __YO_TLS_E_ZERO_RETURN 6

// Automatic chain + hostname validation against the system trust store, and
// no revocation check — deliberately the same posture as the OpenSSL branch
// (SSL_CTX_set_verify(PEER) + default verify paths, which does not check
// revocation either), so the two backends accept and reject the same peers.
#define __YO_TLS_ISC_FLAGS \
  (ISC_REQ_SEQUENCE_DETECT | ISC_REQ_REPLAY_DETECT | ISC_REQ_CONFIDENTIALITY | \
   ISC_REQ_ALLOCATE_MEMORY | ISC_REQ_STREAM | ISC_REQ_EXTENDED_ERROR)

typedef struct {
  unsigned char* data;
  size_t len;
  size_t cap;
} __yo_tls_buf;

typedef struct {
  CredHandle cred;
} __yo_tls_cred;

typedef struct {
  __yo_tls_cred* cred;
  CtxtHandle ctxt;
  int ctxt_ok;
  SecPkgContext_StreamSizes sizes;
  int sizes_ok;
  int done;
  int peer_closed;
  int last_err;
  wchar_t* host;
  __yo_tls_buf in;      // inbound ciphertext — the "read BIO"
  __yo_tls_buf out;     // outbound ciphertext — the "write BIO"
  __yo_tls_buf plain;   // decrypted plaintext waiting for a reader
  __yo_tls_buf scratch; // header+payload+trailer staging for EncryptMessage
} __yo_tls_conn;

// The ABI's error channel has no connection argument (OpenSSL's ERR queue is
// per-thread global), so mirror that: one thread-local slot, consumed on read.
static __declspec(thread) char __yo_tls_errbuf[512];

static void __yo_tls_set_err_msg(const char* msg) {
  snprintf(__yo_tls_errbuf, sizeof(__yo_tls_errbuf), "%s", msg);
}

static void __yo_tls_set_err(const char* what, SECURITY_STATUS ss) {
  char* sysmsg = NULL;
  DWORD n = FormatMessageA(FORMAT_MESSAGE_ALLOCATE_BUFFER |
                               FORMAT_MESSAGE_FROM_SYSTEM |
                               FORMAT_MESSAGE_IGNORE_INSERTS,
                           NULL, (DWORD)ss, 0, (LPSTR)&sysmsg, 0, NULL);
  if (n > 0 && sysmsg != NULL) {
    // 13/10 rather than the escapes: this C lives inside a Yo backtick
    // literal, where a lone \\r or \\n would become a real control character
    // in the emitted source.
    while (n > 0 && (sysmsg[n - 1] == 13 || sysmsg[n - 1] == 10 ||
                     sysmsg[n - 1] == ' ' || sysmsg[n - 1] == '.')) {
      sysmsg[--n] = 0;
    }
    snprintf(__yo_tls_errbuf, sizeof(__yo_tls_errbuf), "%s: %s (0x%08lx)", what,
             sysmsg, (unsigned long)ss);
  } else {
    snprintf(__yo_tls_errbuf, sizeof(__yo_tls_errbuf),
             "%s: SECURITY_STATUS 0x%08lx", what, (unsigned long)ss);
  }
  if (sysmsg != NULL) {
    LocalFree(sysmsg);
  }
}

static int __yo_tls_buf_ensure(__yo_tls_buf* b, size_t need) {
  unsigned char* p;
  size_t want;
  if (b->cap >= need) {
    return 1;
  }
  want = b->cap != 0 ? b->cap : 4096;
  while (want < need) {
    want *= 2;
  }
  p = (unsigned char*)realloc(b->data, want);
  if (p == NULL) {
    return 0;
  }
  b->data = p;
  b->cap = want;
  return 1;
}

static int __yo_tls_buf_append(__yo_tls_buf* b, const void* src, size_t n) {
  if (n == 0) {
    return 1;
  }
  if (!__yo_tls_buf_ensure(b, b->len + n)) {
    return 0;
  }
  memcpy(b->data + b->len, src, n);
  b->len += n;
  return 1;
}

static void __yo_tls_buf_consume(__yo_tls_buf* b, size_t n) {
  if (n >= b->len) {
    b->len = 0;
    return;
  }
  memmove(b->data, b->data + n, b->len - n);
  b->len -= n;
}

static void __yo_tls_buf_free(__yo_tls_buf* b) {
  free(b->data);
  b->data = NULL;
  b->len = 0;
  b->cap = 0;
}

void* __yo_tls_ctx_new(void) {
  SCHANNEL_CRED sc;
  TimeStamp expiry;
  SECURITY_STATUS ss;
  __yo_tls_cred* c = (__yo_tls_cred*)calloc(1, sizeof(__yo_tls_cred));
  if (c == NULL) {
    __yo_tls_set_err_msg("out of memory allocating TLS credentials");
    return NULL;
  }
  memset(&sc, 0, sizeof(sc));
  sc.dwVersion = SCHANNEL_CRED_VERSION;
  // 0 = inherit the system's protocol policy. Naming versions here would
  // freeze this build's idea of "modern TLS" into every compiled program.
  sc.grbitEnabledProtocols = 0;
  sc.dwFlags = SCH_CRED_AUTO_CRED_VALIDATION | SCH_CRED_NO_DEFAULT_CREDS |
               SCH_USE_STRONG_CRYPTO;
  ss = AcquireCredentialsHandleW(NULL, (SEC_WCHAR*)UNISP_NAME_W,
                                 SECPKG_CRED_OUTBOUND, NULL, &sc, NULL, NULL,
                                 &c->cred, &expiry);
  if (ss != SEC_E_OK) {
    __yo_tls_set_err("AcquireCredentialsHandle", ss);
    free(c);
    return NULL;
  }
  return (void*)c;
}

void* __yo_tls_ssl_new(void* ctx, const char* hostname) {
  int wn;
  __yo_tls_conn* c;
  if (ctx == NULL || hostname == NULL) {
    __yo_tls_set_err_msg("TLS connection needs a credential and a hostname");
    return NULL;
  }
  c = (__yo_tls_conn*)calloc(1, sizeof(__yo_tls_conn));
  if (c == NULL) {
    __yo_tls_set_err_msg("out of memory allocating a TLS connection");
    return NULL;
  }
  c->cred = (__yo_tls_cred*)ctx;
  c->last_err = __YO_TLS_E_WANT_READ;
  // SNI and the hostname the certificate is checked against are the same
  // string; Schannel takes it as the target name, in UTF-16.
  wn = MultiByteToWideChar(CP_UTF8, 0, hostname, -1, NULL, 0);
  if (wn > 0) {
    c->host = (wchar_t*)calloc((size_t)wn, sizeof(wchar_t));
    if (c->host != NULL) {
      MultiByteToWideChar(CP_UTF8, 0, hostname, -1, c->host, wn);
    }
  }
  if (c->host == NULL) {
    __yo_tls_set_err_msg("could not convert the TLS hostname to UTF-16");
    free(c);
    return NULL;
  }
  return (void*)c;
}

int __yo_tls_handshake(void* ssl) {
  __yo_tls_conn* c = (__yo_tls_conn*)ssl;
  SecBuffer inbuf[2];
  SecBufferDesc indesc;
  SecBuffer outbuf[2];
  SecBufferDesc outdesc;
  SecBufferDesc* pinput = NULL;
  DWORD out_flags = 0;
  TimeStamp expiry;
  SECURITY_STATUS ss;
  SECURITY_STATUS qs;

  if (c == NULL) {
    __yo_tls_set_err_msg("handshake on a null TLS connection");
    return -1;
  }
  if (c->done) {
    return 1;
  }

  outbuf[0].BufferType = SECBUFFER_TOKEN;
  outbuf[0].pvBuffer = NULL;
  outbuf[0].cbBuffer = 0;
  outbuf[1].BufferType = SECBUFFER_ALERT;
  outbuf[1].pvBuffer = NULL;
  outbuf[1].cbBuffer = 0;
  outdesc.ulVersion = SECBUFFER_VERSION;
  outdesc.cBuffers = 2;
  outdesc.pBuffers = outbuf;

  // The first call takes NO input and emits the ClientHello; every later one
  // feeds ciphertext. "Do we have a context yet" is exactly that distinction,
  // so it also decides phContext/phNewContext below.
  if (c->ctxt_ok) {
    if (c->in.len == 0) {
      c->last_err = __YO_TLS_E_WANT_READ;
      return -1;
    }
    inbuf[0].BufferType = SECBUFFER_TOKEN;
    inbuf[0].pvBuffer = c->in.data;
    inbuf[0].cbBuffer = (unsigned long)c->in.len;
    inbuf[1].BufferType = SECBUFFER_EMPTY;
    inbuf[1].pvBuffer = NULL;
    inbuf[1].cbBuffer = 0;
    indesc.ulVersion = SECBUFFER_VERSION;
    indesc.cBuffers = 2;
    indesc.pBuffers = inbuf;
    pinput = &indesc;
  }

  ss = InitializeSecurityContextW(
      &c->cred->cred, c->ctxt_ok ? &c->ctxt : NULL, (SEC_WCHAR*)c->host,
      __YO_TLS_ISC_FLAGS, 0, 0, pinput, 0, c->ctxt_ok ? NULL : &c->ctxt,
      &outdesc, &out_flags, &expiry);

  // Ship whatever token came out even when the call failed: with
  // ISC_REQ_EXTENDED_ERROR that token is the alert telling the server why we
  // are hanging up, and the Yo pump flushes the write buffer before it looks
  // at our return value.
  if (outbuf[0].pvBuffer != NULL && outbuf[0].cbBuffer > 0) {
    if (!__yo_tls_buf_append(&c->out, outbuf[0].pvBuffer, outbuf[0].cbBuffer)) {
      __yo_tls_set_err_msg("out of memory buffering a TLS handshake token");
      FreeContextBuffer(outbuf[0].pvBuffer);
      if (outbuf[1].pvBuffer != NULL) {
        FreeContextBuffer(outbuf[1].pvBuffer);
      }
      c->last_err = __YO_TLS_E_FATAL;
      return -1;
    }
  }
  if (outbuf[0].pvBuffer != NULL) {
    FreeContextBuffer(outbuf[0].pvBuffer);
  }
  if (outbuf[1].pvBuffer != NULL) {
    FreeContextBuffer(outbuf[1].pvBuffer);
  }

  if (ss == SEC_E_INCOMPLETE_MESSAGE) {
    // Keep every byte: the record is not complete yet.
    c->last_err = __YO_TLS_E_WANT_READ;
    return -1;
  }

  if (ss == SEC_I_CONTINUE_NEEDED || ss == SEC_E_OK) {
    c->ctxt_ok = 1;
    if (pinput != NULL) {
      // Consume what Schannel processed. SECBUFFER_EXTRA counts the bytes it
      // did NOT take, and they sit at the end of what we handed it.
      size_t extra = 0;
      if (inbuf[1].BufferType == SECBUFFER_EXTRA) {
        extra = (size_t)inbuf[1].cbBuffer;
      }
      if (extra > c->in.len) {
        extra = c->in.len;
      }
      __yo_tls_buf_consume(&c->in, c->in.len - extra);
    }
    if (ss == SEC_E_OK) {
      qs = QueryContextAttributesW(&c->ctxt, SECPKG_ATTR_STREAM_SIZES,
                                   &c->sizes);
      if (qs != SEC_E_OK) {
        __yo_tls_set_err("QueryContextAttributes(STREAM_SIZES)", qs);
        c->last_err = __YO_TLS_E_FATAL;
        return -1;
      }
      c->sizes_ok = 1;
      c->done = 1;
      return 1;
    }
    c->last_err = __YO_TLS_E_WANT_READ;
    return -1;
  }

  __yo_tls_set_err("InitializeSecurityContext", ss);
  c->last_err = __YO_TLS_E_FATAL;
  return -1;
}

int __yo_tls_get_error(void* ssl, int ret) {
  __yo_tls_conn* c = (__yo_tls_conn*)ssl;
  (void)ret;
  return c != NULL ? c->last_err : __YO_TLS_E_FATAL;
}

int __yo_tls_read(void* ssl, void* buf, int num) {
  __yo_tls_conn* c = (__yo_tls_conn*)ssl;
  if (c == NULL || buf == NULL || num <= 0) {
    __yo_tls_set_err_msg("invalid arguments to a TLS read");
    if (c != NULL) {
      c->last_err = __YO_TLS_E_FATAL;
    }
    return -1;
  }
  for (;;) {
    SecBuffer b[4];
    SecBufferDesc d;
    SECURITY_STATUS ss;
    void* extra_ptr = NULL;
    size_t extra_len = 0;
    int i;

    if (c->plain.len > 0) {
      size_t n = c->plain.len < (size_t)num ? c->plain.len : (size_t)num;
      memcpy(buf, c->plain.data, n);
      __yo_tls_buf_consume(&c->plain, n);
      return (int)n;
    }
    if (c->peer_closed) {
      c->last_err = __YO_TLS_E_ZERO_RETURN;
      return 0;
    }
    if (!c->done) {
      // Either the caller read before connecting, or the peer asked to
      // renegotiate below. Drive the handshake; its own WANT_READ reaches the
      // pump, which flushes and feeds before calling us again.
      if (__yo_tls_handshake(ssl) != 1) {
        return -1;
      }
      continue;
    }
    if (!c->sizes_ok) {
      __yo_tls_set_err_msg("TLS stream sizes are unknown");
      c->last_err = __YO_TLS_E_FATAL;
      return -1;
    }
    if (c->in.len == 0) {
      c->last_err = __YO_TLS_E_WANT_READ;
      return -1;
    }

    // DecryptMessage works IN PLACE: the output buffers point into c->in, so
    // the plaintext is copied out before c->in is touched.
    b[0].BufferType = SECBUFFER_DATA;
    b[0].pvBuffer = c->in.data;
    b[0].cbBuffer = (unsigned long)c->in.len;
    for (i = 1; i < 4; i++) {
      b[i].BufferType = SECBUFFER_EMPTY;
      b[i].pvBuffer = NULL;
      b[i].cbBuffer = 0;
    }
    d.ulVersion = SECBUFFER_VERSION;
    d.cBuffers = 4;
    d.pBuffers = b;

    ss = DecryptMessage(&c->ctxt, &d, 0, NULL);

    if (ss == SEC_E_INCOMPLETE_MESSAGE) {
      c->last_err = __YO_TLS_E_WANT_READ;
      return -1;
    }
    if (ss == SEC_I_CONTEXT_EXPIRED) {
      // The peer sent close_notify: a clean end of session.
      c->peer_closed = 1;
      c->in.len = 0;
      c->last_err = __YO_TLS_E_ZERO_RETURN;
      return 0;
    }
    if (ss != SEC_E_OK && ss != SEC_I_RENEGOTIATE) {
      __yo_tls_set_err("DecryptMessage", ss);
      c->last_err = __YO_TLS_E_FATAL;
      return -1;
    }

    for (i = 0; i < 4; i++) {
      if (b[i].BufferType == SECBUFFER_DATA && b[i].cbBuffer > 0) {
        if (!__yo_tls_buf_append(&c->plain, b[i].pvBuffer, b[i].cbBuffer)) {
          __yo_tls_set_err_msg("out of memory buffering decrypted TLS data");
          c->last_err = __YO_TLS_E_FATAL;
          return -1;
        }
      }
    }
    for (i = 0; i < 4; i++) {
      if (b[i].BufferType == SECBUFFER_EXTRA && b[i].cbBuffer > 0) {
        extra_ptr = b[i].pvBuffer;
        extra_len = (size_t)b[i].cbBuffer;
      }
    }
    if (extra_ptr != NULL && extra_len > 0) {
      memmove(c->in.data, extra_ptr, extra_len);
      c->in.len = extra_len;
    } else {
      c->in.len = 0;
    }

    if (ss == SEC_I_RENEGOTIATE) {
      // Re-enter the handshake on the next turn of this loop, feeding it the
      // leftover bytes.
      c->done = 0;
      c->sizes_ok = 0;
    }
  }
}

int __yo_tls_write(void* ssl, const void* buf, int num) {
  __yo_tls_conn* c = (__yo_tls_conn*)ssl;
  const unsigned char* p;
  size_t remaining;
  if (c == NULL || buf == NULL || num <= 0) {
    __yo_tls_set_err_msg("invalid arguments to a TLS write");
    if (c != NULL) {
      c->last_err = __YO_TLS_E_FATAL;
    }
    return -1;
  }
  if (!c->done || !c->sizes_ok) {
    __yo_tls_set_err_msg("write before the TLS handshake completed");
    c->last_err = __YO_TLS_E_FATAL;
    return -1;
  }
  if (c->peer_closed) {
    __yo_tls_set_err_msg("write after the peer closed the TLS session");
    c->last_err = __YO_TLS_E_FATAL;
    return -1;
  }
  p = (const unsigned char*)buf;
  remaining = (size_t)num;
  while (remaining > 0) {
    SecBuffer b[4];
    SecBufferDesc d;
    SECURITY_STATUS ss;
    size_t chunk = remaining;
    size_t total;
    if (chunk > (size_t)c->sizes.cbMaximumMessage) {
      chunk = (size_t)c->sizes.cbMaximumMessage;
    }
    total = (size_t)c->sizes.cbHeader + chunk + (size_t)c->sizes.cbTrailer;
    if (!__yo_tls_buf_ensure(&c->scratch, total)) {
      __yo_tls_set_err_msg("out of memory staging a TLS record");
      c->last_err = __YO_TLS_E_FATAL;
      return -1;
    }
    memcpy(c->scratch.data + c->sizes.cbHeader, p, chunk);
    b[0].BufferType = SECBUFFER_STREAM_HEADER;
    b[0].pvBuffer = c->scratch.data;
    b[0].cbBuffer = c->sizes.cbHeader;
    b[1].BufferType = SECBUFFER_DATA;
    b[1].pvBuffer = c->scratch.data + c->sizes.cbHeader;
    b[1].cbBuffer = (unsigned long)chunk;
    b[2].BufferType = SECBUFFER_STREAM_TRAILER;
    b[2].pvBuffer = c->scratch.data + c->sizes.cbHeader + chunk;
    b[2].cbBuffer = c->sizes.cbTrailer;
    b[3].BufferType = SECBUFFER_EMPTY;
    b[3].pvBuffer = NULL;
    b[3].cbBuffer = 0;
    d.ulVersion = SECBUFFER_VERSION;
    d.cBuffers = 4;
    d.pBuffers = b;
    ss = EncryptMessage(&c->ctxt, 0, &d, 0);
    if (ss != SEC_E_OK) {
      __yo_tls_set_err("EncryptMessage", ss);
      c->last_err = __YO_TLS_E_FATAL;
      return -1;
    }
    // EncryptMessage may shrink the header/trailer it was given, so the
    // record is exactly the three buffers it reports back.
    if (!__yo_tls_buf_append(&c->out, b[0].pvBuffer, b[0].cbBuffer) ||
        !__yo_tls_buf_append(&c->out, b[1].pvBuffer, b[1].cbBuffer) ||
        !__yo_tls_buf_append(&c->out, b[2].pvBuffer, b[2].cbBuffer)) {
      __yo_tls_set_err_msg("out of memory buffering an encrypted TLS record");
      c->last_err = __YO_TLS_E_FATAL;
      return -1;
    }
    p += chunk;
    remaining -= chunk;
  }
  // All-or-nothing, matching SSL_write's default.
  return num;
}

int __yo_tls_shutdown(void* ssl) {
  __yo_tls_conn* c = (__yo_tls_conn*)ssl;
  DWORD token = SCHANNEL_SHUTDOWN;
  SecBuffer sb;
  SecBufferDesc sd;
  SecBuffer ob[2];
  SecBufferDesc od;
  DWORD out_flags = 0;
  TimeStamp expiry;
  SECURITY_STATUS ss;

  if (c == NULL || !c->ctxt_ok) {
    return 1;
  }
  sb.BufferType = SECBUFFER_TOKEN;
  sb.pvBuffer = &token;
  sb.cbBuffer = (unsigned long)sizeof(token);
  sd.ulVersion = SECBUFFER_VERSION;
  sd.cBuffers = 1;
  sd.pBuffers = &sb;
  ss = ApplyControlToken(&c->ctxt, &sd);
  if (ss != SEC_E_OK) {
    // Best effort, exactly like SSL_shutdown's: the socket close below is
    // what actually ends the conversation.
    __yo_tls_set_err("ApplyControlToken(SCHANNEL_SHUTDOWN)", ss);
    return 0;
  }
  ob[0].BufferType = SECBUFFER_TOKEN;
  ob[0].pvBuffer = NULL;
  ob[0].cbBuffer = 0;
  ob[1].BufferType = SECBUFFER_ALERT;
  ob[1].pvBuffer = NULL;
  ob[1].cbBuffer = 0;
  od.ulVersion = SECBUFFER_VERSION;
  od.cBuffers = 2;
  od.pBuffers = ob;
  ss = InitializeSecurityContextW(&c->cred->cred, &c->ctxt,
                                  (SEC_WCHAR*)c->host, __YO_TLS_ISC_FLAGS, 0, 0,
                                  NULL, 0, NULL, &od, &out_flags, &expiry);
  if (ob[0].pvBuffer != NULL && ob[0].cbBuffer > 0 &&
      (ss == SEC_E_OK || ss == SEC_I_CONTEXT_EXPIRED ||
       ss == SEC_I_CONTINUE_NEEDED)) {
    __yo_tls_buf_append(&c->out, ob[0].pvBuffer, ob[0].cbBuffer);
  }
  if (ob[0].pvBuffer != NULL) {
    FreeContextBuffer(ob[0].pvBuffer);
  }
  if (ob[1].pvBuffer != NULL) {
    FreeContextBuffer(ob[1].pvBuffer);
  }
  return 1;
}

void __yo_tls_free(void* ssl, void* ctx) {
  __yo_tls_conn* c = (__yo_tls_conn*)ssl;
  __yo_tls_cred* cr = (__yo_tls_cred*)ctx;
  if (c != NULL) {
    if (c->ctxt_ok) {
      DeleteSecurityContext(&c->ctxt);
    }
    __yo_tls_buf_free(&c->in);
    __yo_tls_buf_free(&c->out);
    __yo_tls_buf_free(&c->plain);
    __yo_tls_buf_free(&c->scratch);
    free(c->host);
    free(c);
  }
  if (cr != NULL) {
    FreeCredentialsHandle(&cr->cred);
    free(cr);
  }
}

void* __yo_tls_rbio(void* ssl) {
  __yo_tls_conn* c = (__yo_tls_conn*)ssl;
  return c != NULL ? (void*)&c->in : NULL;
}

void* __yo_tls_wbio(void* ssl) {
  __yo_tls_conn* c = (__yo_tls_conn*)ssl;
  return c != NULL ? (void*)&c->out : NULL;
}

size_t __yo_tls_bio_pending(void* bio) {
  __yo_tls_buf* b = (__yo_tls_buf*)bio;
  return b != NULL ? b->len : 0;
}

int __yo_tls_bio_read(void* bio, void* buf, int len) {
  __yo_tls_buf* b = (__yo_tls_buf*)bio;
  size_t n;
  if (b == NULL || buf == NULL || len <= 0) {
    return 0;
  }
  n = b->len < (size_t)len ? b->len : (size_t)len;
  if (n == 0) {
    return 0;
  }
  memcpy(buf, b->data, n);
  __yo_tls_buf_consume(b, n);
  return (int)n;
}

int __yo_tls_bio_write(void* bio, const void* buf, int len) {
  __yo_tls_buf* b = (__yo_tls_buf*)bio;
  if (b == NULL || buf == NULL || len <= 0) {
    return 0;
  }
  if (!__yo_tls_buf_append(b, buf, (size_t)len)) {
    __yo_tls_set_err_msg("out of memory buffering received TLS ciphertext");
    return -1;
  }
  return len;
}

void __yo_tls_err_string(char* buf, size_t len) {
  if (buf == NULL || len == 0) {
    return;
  }
  if (__yo_tls_errbuf[0] == 0) {
    snprintf(buf, len, "no error recorded by the Schannel backend");
    return;
  }
  snprintf(buf, len, "%s", __yo_tls_errbuf);
  // Consumed, like ERR_get_error().
  __yo_tls_errbuf[0] = 0;
}

int __yo_tls_available(void) { return 1; }
`
  );
  emitter.emit_string(`#elif !defined(__wasm__)\n`);
  emitter.emit_string(
    `#include <openssl/ssl.h>
#include <openssl/bio.h>
#include <openssl/err.h>
// Weak canary (the shipped macOS bundle weak-links OpenSSL — a hard
// LC_LOAD_DYLIB would keep the yo binary from even LAUNCHING on a
// Mac without brew openssl): a missing dylib leaves every OpenSSL
// symbol NULL, and __yo_tls_available() must report that honestly
// instead of a constant 1. The redeclaration only attaches the
// attribute; the type is the header's own.
extern SSL_CTX* SSL_CTX_new(const SSL_METHOD*) __attribute__((weak));

void* __yo_tls_ctx_new(void) {
  SSL_CTX* ctx = SSL_CTX_new(TLS_client_method());
  if (!ctx) return NULL;
  SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER, NULL);
  SSL_CTX_set_default_verify_paths(ctx);
  return ctx;
}
void* __yo_tls_ssl_new(void* ctx, const char* hostname) {
  SSL* ssl = SSL_new((SSL_CTX*)ctx);
  if (!ssl) return NULL;
  BIO* rbio = BIO_new(BIO_s_mem());
  BIO* wbio = BIO_new(BIO_s_mem());
  if (!rbio || !wbio) {
    if (rbio) BIO_free(rbio);
    if (wbio) BIO_free(wbio);
    SSL_free(ssl);
    return NULL;
  }
  SSL_set_bio(ssl, rbio, wbio);
  SSL_set_connect_state(ssl);
  SSL_set1_host(ssl, hostname);
  SSL_ctrl(ssl, SSL_CTRL_SET_TLSEXT_HOSTNAME, 0, (void*)hostname);
  return ssl;
}
int __yo_tls_handshake(void* ssl) { return SSL_do_handshake((SSL*)ssl); }
int __yo_tls_get_error(void* ssl, int ret) { return SSL_get_error((SSL*)ssl, ret); }
int __yo_tls_read(void* ssl, void* buf, int num) { return SSL_read((SSL*)ssl, buf, num); }
int __yo_tls_write(void* ssl, const void* buf, int num) { return SSL_write((SSL*)ssl, buf, num); }
int __yo_tls_shutdown(void* ssl) { return SSL_shutdown((SSL*)ssl); }
void __yo_tls_free(void* ssl, void* ctx) { SSL_free((SSL*)ssl); SSL_CTX_free((SSL_CTX*)ctx); }
void* __yo_tls_rbio(void* ssl) { return SSL_get_rbio((SSL*)ssl); }
void* __yo_tls_wbio(void* ssl) { return SSL_get_wbio((SSL*)ssl); }
size_t __yo_tls_bio_pending(void* bio) { return BIO_ctrl_pending((BIO*)bio); }
int __yo_tls_bio_read(void* bio, void* buf, int len) { return BIO_read((BIO*)bio, buf, len); }
int __yo_tls_bio_write(void* bio, const void* buf, int len) { return BIO_write((BIO*)bio, buf, len); }
void __yo_tls_err_string(char* buf, size_t len) {
  unsigned long code = ERR_get_error();
  if (code == 0) { snprintf(buf, len, "no error in the OpenSSL queue"); return; }
  ERR_error_string_n(code, buf, len);
}
int __yo_tls_available(void) { return &SSL_CTX_new != NULL; }
`
  );
  emitter.emit_string(`#else\n`);
  emitter.emit_string(
    `void* __yo_tls_ctx_new(void) { return NULL; }
void* __yo_tls_ssl_new(void* ctx, const char* hostname) { (void)ctx; (void)hostname; return NULL; }
int __yo_tls_handshake(void* ssl) { (void)ssl; return -1; }
int __yo_tls_get_error(void* ssl, int ret) { (void)ssl; return ret; }
int __yo_tls_read(void* ssl, void* buf, int num) { (void)ssl; (void)buf; (void)num; return -1; }
int __yo_tls_write(void* ssl, const void* buf, int num) { (void)ssl; (void)buf; (void)num; return -1; }
int __yo_tls_shutdown(void* ssl) { (void)ssl; return 0; }
void __yo_tls_free(void* ssl, void* ctx) { (void)ssl; (void)ctx; }
void* __yo_tls_rbio(void* ssl) { (void)ssl; return NULL; }
void* __yo_tls_wbio(void* ssl) { (void)ssl; return NULL; }
size_t __yo_tls_bio_pending(void* bio) { (void)bio; return 0; }
int __yo_tls_bio_read(void* bio, void* buf, int len) { (void)bio; (void)buf; (void)len; return 0; }
int __yo_tls_bio_write(void* bio, const void* buf, int len) { (void)bio; (void)buf; (void)len; return 0; }
void __yo_tls_err_string(char* buf, size_t len) { snprintf(buf, len, "TLS is not available in this build (no wasm TLS backend, D6)"); }
int __yo_tls_available(void) { return 0; }
`
  );
  emitter.emit_string(`#endif\n\n`);
});

export(
  generate_tls_runtime,
  generate_sys_runtime,
  generate_async_runtime_io_common
);
