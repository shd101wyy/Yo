    // macOS-specific FS event helpers
    if(is_macos, {
      emitter.emit_string_line(
        `
static void __yo_fs_event_free_entries(__yo_fs_event_entry_t* head) {
  while (head) {
    __yo_fs_event_entry_t* next = head->next;
    if (head->name) __yo_free(head->name);
    __yo_free(head);
    head = next;
  }
}

static __yo_fs_event_entry_t* __yo_fs_event_find_entry(__yo_fs_event_entry_t* head, const char* name) {
  while (head) {
    if (strcmp(head->name, name) == 0) {
      return head;
    }
    head = head->next;
  }
  return NULL;
}

static __yo_fs_event_entry_t* __yo_fs_event_snapshot_dir(const char* path, int* err_out) {
  *err_out = 0;
  DIR* dir = opendir(path);
  if (!dir) {
    *err_out = errno;
    return NULL;
  }

  __yo_fs_event_entry_t* head = NULL;
  struct dirent* ent = NULL;
  while ((ent = readdir(dir)) != NULL) {
    if ((strcmp(ent->d_name, ".") == 0) || (strcmp(ent->d_name, "..") == 0)) {
      continue;
    }

    size_t path_len = strlen(path);
    size_t name_len = strlen(ent->d_name);
    char* full_path = (char*)__yo_rc_alloc(path_len + 1 + name_len + 1);
    memcpy(full_path, path, path_len);
    full_path[path_len] = '/';
    memcpy(full_path + path_len + 1, ent->d_name, name_len + 1);

    struct stat st;
    if (stat(full_path, &st) == 0) {
      __yo_fs_event_entry_t* node = (__yo_fs_event_entry_t*)__yo_rc_alloc(sizeof(__yo_fs_event_entry_t));
      memset(node, 0, sizeof(__yo_fs_event_entry_t));
      node->name = (char*)__yo_rc_alloc(name_len + 1);
      memcpy(node->name, ent->d_name, name_len + 1);
      node->mtime_sec = (int64_t)st.st_mtimespec.tv_sec;
      node->mtime_nsec = (int64_t)st.st_mtimespec.tv_nsec;
      node->size = (int64_t)st.st_size;
      node->next = head;
      head = node;
    }

    __yo_free(full_path);
  }

  closedir(dir);
  return head;
}

// Directory watches: diff the entry snapshot and report EACH changed entry
// by name — created/removed → 1 (rename class), modified → 2 (change class)
// — through the callback, the way inotify and ReadDirectoryChangesW name
// their entries. Returns the number of callbacks made (0 when nothing
// changed); the directory itself vanishing is one nameless rename event.
// File watches: returns the event mask for the caller to report (no
// callback here).
static int __yo_fs_event_detect_snapshot_changes(__yo_fs_event_t* handle) {
  int __yo_event = 0;

  if (handle->is_dir) {
    int snap_err = 0;
    int emitted = 0;
    __yo_fs_event_entry_t* next_entries = __yo_fs_event_snapshot_dir(handle->path, &snap_err);
    if (snap_err != 0) {
      // The directory vanished. Report the deletion ONCE — keyed on
      // handle->exists like the file branch below — not on every tick the
      // opendir keeps failing, which turned a deleted watch into a rename
      // event every ~10 ms forever. Release the stale snapshot so a
      // recreated directory starts a clean diff (its entries report as
      // creations).
      if (snap_err == ENOENT) {
        if (handle->exists) {
          handle->exists = 0;
          __yo_fs_event_free_entries(handle->entries);
          handle->entries = NULL;
          if (handle->callback && handle->active) {
            handle->callback((uint8_t*)"", 1, handle->user_data);
            emitted++;
          }
        }
      }
      return emitted;
    }
    if (!handle->exists) {
      // The directory came back between ticks: report the recreation (the
      // rename class, like the file branch's reappear) and re-arm the
      // snapshot — the entries below diff against a clean slate, so a
      // recreated non-empty directory also reports its entries as created.
      handle->exists = 1;
      if (handle->callback && handle->active) {
        handle->callback((uint8_t*)"", 1, handle->user_data);
        emitted++;
      }
    }

    __yo_fs_event_entry_t* ne = next_entries;
    while (ne) {
      __yo_fs_event_entry_t* oe = __yo_fs_event_find_entry(handle->entries, ne->name);
      int ev = 0;
      if (!oe) {
        ev = 1;
      } else if ((oe->mtime_sec != ne->mtime_sec) ||
                 (oe->mtime_nsec != ne->mtime_nsec) ||
                 (oe->size != ne->size)) {
        ev = 2;
      }
      if (ev != 0 && handle->callback && handle->active) {
        handle->callback((uint8_t*)ne->name, ev, handle->user_data);
        emitted++;
      }
      ne = ne->next;
    }

    __yo_fs_event_entry_t* oe = handle->entries;
    while (oe) {
      if (!__yo_fs_event_find_entry(next_entries, oe->name)) {
        if (handle->callback && handle->active) {
          handle->callback((uint8_t*)oe->name, 1, handle->user_data);
          emitted++;
        }
      }
      oe = oe->next;
    }

    __yo_fs_event_free_entries(handle->entries);
    handle->entries = next_entries;
    return emitted;
  }

  struct stat st;
  if (stat(handle->path, &st) < 0) {
    if (errno == ENOENT && handle->exists) {
      handle->exists = 0;
      return 1;
    }
    return 0;
  }

  if (!handle->exists) {
    handle->exists = 1;
    handle->mtime_sec = (int64_t)st.st_mtimespec.tv_sec;
    handle->mtime_nsec = (int64_t)st.st_mtimespec.tv_nsec;
    handle->size = (int64_t)st.st_size;
    return 1;
  }

  if ((handle->mtime_sec != (int64_t)st.st_mtimespec.tv_sec) ||
      (handle->mtime_nsec != (int64_t)st.st_mtimespec.tv_nsec) ||
      (handle->size != (int64_t)st.st_size)) {
    handle->mtime_sec = (int64_t)st.st_mtimespec.tv_sec;
    handle->mtime_nsec = (int64_t)st.st_mtimespec.tv_nsec;
    handle->size = (int64_t)st.st_size;
    return 2;
  }

  return 0;
}

// A directory's vnode reports entries created, removed and renamed (NOTE_WRITE
// on the directory) but not a write INTO an existing entry, which only the
// snapshot diff sees. So a directory watch rescans on every vnode event and,
// between events, at most once per rescan interval: 50 ms, stretched to 20x
// the last scan's cost so that a huge directory costs at most ~5% of a core.
// A path that does not exist (a deleted file or directory being waited for) is
// looked for at the same interval. It used to rescan on EVERY loop pass — an
// opendir, a readdir and a stat per entry each time the loop turned — and
// every wait was capped at 100 ms to keep those passes coming.
#define __YO_FS_RESCAN_NS (50ull * 1000000ull)

static const unsigned int __yo_fs_vnode_fflags =
    NOTE_WRITE | NOTE_DELETE | NOTE_RENAME | NOTE_ATTRIB | NOTE_EXTEND;

// (Re)open the handle's descriptor on its path and add it to the watch set.
static int __yo_fs_event_arm(__yo_fs_event_t* handle) {
  handle->fd = open(handle->path, O_EVTONLY | O_CLOEXEC);
  if (handle->fd < 0) return -errno;
  int32_t rc = __yo_io_watch_vnode(handle->fd, __yo_fs_vnode_fflags);
  if (rc < 0) {
    close(handle->fd);
    handle->fd = -1;
    return rc;
  }
  return 0;
}

static void __yo_fs_event_schedule(__yo_fs_event_t* handle, uint64_t now, uint64_t cost) {
  if (handle->is_dir || handle->fd < 0) {
    uint64_t span = cost * 20;
    if (span < __YO_FS_RESCAN_NS) span = __YO_FS_RESCAN_NS;
    handle->next_scan_ns = now + span;
  } else {
    handle->next_scan_ns = UINT64_MAX;
  }
}

// Service one fs-event handle: the vnode flags the watch set reported (0 for
// a scheduled rescan) plus the snapshot diff. Directory: the diff reports each
// changed entry by name; the vnode's flags then only add a nameless event when
// the diff saw nothing (e.g. an attribute change on the directory itself).
// File: the diff returns the mask and the event is reported under the file's
// own name. Returns the number of callbacks made.
static int __yo_fs_event_service(__yo_fs_event_t* fse, uint32_t fflags) {
  int count = 0;
  int __yo_event = 0;
  int named = 0;
  uint64_t t0 = __yo_mono_ns();
  if (fse->is_dir) {
    named = __yo_fs_event_detect_snapshot_changes(fse);
    count += named;
  } else {
    __yo_event = __yo_fs_event_detect_snapshot_changes(fse);
  }
  if (fflags & (NOTE_DELETE | NOTE_RENAME)) {
    __yo_event |= 1;
  }
  if (fflags & (NOTE_WRITE | NOTE_ATTRIB | NOTE_EXTEND)) {
    __yo_event |= 2;
  }
  if (__yo_event != 0 && named == 0 && fse->callback && fse->active) {
    const char* own = "";
    if (!fse->is_dir && fse->path) {
      const char* slash = strrchr(fse->path, '/');
      own = slash ? slash + 1 : fse->path;
    }
    fse->callback((uint8_t*)own, __yo_event, fse->user_data);
    count++;
  }
  if (!fse->active) return count;  // the callback stopped the watch
  // The watched vnode was deleted or renamed away: its descriptor no longer
  // names the path. Watch whatever the path names now, or look for it at the
  // rescan interval until it comes back.
  if ((fflags & (NOTE_DELETE | NOTE_RENAME)) && fse->fd >= 0) {
    close(fse->fd);
    fse->fd = -1;
  }
  if (fse->fd < 0 && fse->exists) {
    (void)__yo_fs_event_arm(fse);
  }
  uint64_t now = __yo_mono_ns();
  __yo_fs_event_schedule(fse, now, now - t0);
  return count;
}
`
      );
    });
    // FS event init (macOS extra handle fields)
    macos_handle_init := cond(
      is_macos =>
        `  handle->path = NULL;
  handle->entries = NULL;
  handle->next_scan_ns = UINT64_MAX;`,
      true => String.from("")
    );
    emitter.emit_string_line(
      `
static void* __yo_fs_event_init(void) {
  __yo_fs_event_t* handle = (__yo_fs_event_t*)__yo_rc_alloc(sizeof(__yo_fs_event_t));
  memset(handle, 0, sizeof(__yo_fs_event_t));
  handle->fd = -1;
  handle->watch_fd = -1;
${macos_handle_init}
  return handle;
}`
    );
    // FS event start (platform-specific internals)
    if(is_linux, {
      emitter.emit_string_line(
        `
static int32_t __yo_fs_event_start(void* h, const char* path, uint32_t flags, void* callback, void* user_data) {
  __yo_fs_event_t* handle = (__yo_fs_event_t*)h;
  if (!handle || !path || !callback) return -EINVAL;

  handle->fd = inotify_init1(IN_NONBLOCK | IN_CLOEXEC);
  if (handle->fd < 0) return -errno;

  uint32_t mask = IN_MODIFY | IN_CREATE | IN_DELETE | IN_MOVED_FROM | IN_MOVED_TO | IN_ATTRIB;
  if (flags & 4) mask |= IN_ISDIR;
  handle->watch_fd = inotify_add_watch(handle->fd, path, mask);
  if (handle->watch_fd < 0) {
    int err = errno;
    close(handle->fd);
    handle->fd = -1;
    return -err;
  }

  handle->callback = (void (*)(uint8_t*, int32_t, uint8_t*))callback;
  handle->user_data = user_data;
  handle->active = 1;

  handle->next = __yo_active_fs_events;
  __yo_active_fs_events = handle;
  __yo_active_watch_count++;
  // Let the inotify fd end a blocked wait (the backend's watch set).
  (void)__yo_io_watch_set(handle->fd, EPOLLIN);
  return 0;
}
`
      );
    }, {
      if(is_macos, {
        emitter.emit_string_line(
          `
static int32_t __yo_fs_event_start(void* h, const char* path, uint32_t flags, void* callback, void* user_data) {
  __yo_fs_event_t* handle = (__yo_fs_event_t*)h;
  if (!handle || !path || !callback) return -EINVAL;

  handle->path = (char*)__yo_rc_alloc(strlen(path) + 1);
  strcpy(handle->path, path);

  struct stat path_st;
  if (stat(path, &path_st) < 0) {
    int err = errno;
    __yo_free(handle->path);
    handle->path = NULL;
    return -err;
  }
  handle->is_dir = S_ISDIR(path_st.st_mode) ? 1 : 0;
  handle->exists = 1;
  handle->mtime_sec = (int64_t)path_st.st_mtimespec.tv_sec;
  handle->mtime_nsec = (int64_t)path_st.st_mtimespec.tv_nsec;
  handle->size = (int64_t)path_st.st_size;

  if (handle->is_dir) {
    int snap_err = 0;
    handle->entries = __yo_fs_event_snapshot_dir(path, &snap_err);
    if (snap_err != 0) {
      __yo_free(handle->path);
      handle->path = NULL;
      return -snap_err;
    }
  }

  int32_t rc = __yo_fs_event_arm(handle);
  if (rc < 0) {
    if (handle->entries) {
      __yo_fs_event_free_entries(handle->entries);
      handle->entries = NULL;
    }
    __yo_free(handle->path);
    handle->path = NULL;
    return rc;
  }

  handle->callback = (void (*)(uint8_t*, int32_t, uint8_t*))callback;
  handle->user_data = user_data;
  handle->active = 1;
  handle->vnode_flags = 0;
  __yo_fs_event_schedule(handle, __yo_mono_ns(), 0);

  handle->next = __yo_active_fs_events;
  __yo_active_fs_events = handle;
  __yo_active_watch_count++;
  return 0;
}

`
        );
      }, {
        emitter.emit_string_line(
          `
static int32_t __yo_fs_event_start(void* h, const char* path, uint32_t flags, void* callback, void* user_data) {
  (void)h; (void)path; (void)flags; (void)callback; (void)user_data;
  return -ENOTSUP;
}
`
        );
