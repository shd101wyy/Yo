//! state_machine_naming — the `get_state_machine_field_name` helper, extracted to
//! a leaf module to break the `state_machine.yo` ↔ `state_code_gen.yo` import
//! cycle (both need it: state_machine.yo for the resume generator,
//! state_code_gen.yo for match-with-await destructuring). The loader
//! rejects the destructuring import cycle, so the shared helper lives here (same
//! structural necessity as `_fsm.yo` for the emitter mutual recursion).
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ HashSet } :: import("std/collections/hash_set");
{ CapturedVariable } :: import("../../evaluator/async/await_analysis_types.yo");
{ Variable, Environment, get_variables_from_env } :: import("../../env.yo");
{ sanitize_for_c_identifier } :: import("../utils/index.yo");
{ fnv1a64 } :: import("../../utils.yo");
{ scope_variables } :: import("../../expr_info.yo");
{ ExprId } :: import("../../expr.yo");
/// The C field
/// name for a LOCAL state-machine capture is derived from the variable's
/// NAME and declaration site, not its evaluator id (per
/// plans/reference/INCREMENTAL_COMPILATION_ZIG_LESSONS.md §5). The id comes from a
/// global allocation counter, so naming fields `var_<id>` renamed every SM
/// struct in the program whenever any binding was added anywhere; the name
/// only moves when THIS function's captured binding set moves. Keyed by the
/// id string (the join key the whole SM machinery already uses), filled by
/// `register_sm_captured_names` from the function-SM builder and from the
/// async-block struct emitter.
(g_sm_local_field_names : HashMap(String, String)) = HashMap(String, String).new();
/// Record the stable field name for a local capture (idempotent — a
/// re-registered SM re-derives the same name).
register_sm_local_field_name :: (fn(imm(variable_id) : String, imm(field) : String) -> unit)({
  _ := g_sm_local_field_names.insert(variable_id, field);
});
/// Assign every LOCAL capture its stable field name — `var_<name>_<hash of
/// the binding's declaration site>` — and record the assignments. The suffix
/// is the variable's OWN decl_site (`module:row:col` of its token), so the
/// name is a function of the binding alone: no dependence on registration
/// order or on the dedup context of whichever captured list is at hand (the
/// struct emitter's filtered list vs the full analysis list vs the combined
/// map all derive the SAME name for one variable). The `var_` prefix keeps
/// locals clear of the SM's fixed fields (`state`, `result`, ...) and the
/// `__capture.`/`await_future_<n>` spellings.
register_sm_captured_names :: (
  fn(imm(cvs) : ArrayList(CapturedVariable)) -> unit
)({
  (i : usize) = usize(0);
  while(i < cvs.len(), {
    match(
      cvs.get(i),
      .Some(v) => match(
        v.kind,
        .Local => if(v.base.decl_site.len() > usize(0), {
          field := sanitize_for_c_identifier(
            `var_${v.base.name}_${fnv1a64(v.base.decl_site.clone()).to_string()}`,
            false
          );
          register_sm_local_field_name(v.base.id.to_string(), field);
        }),
        .Outer => ()
      ),
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// The stable field name for a local capture, with the historical
/// `var_<id>` as the unregistered fallback (reached only for captures whose
/// list never passed through `register_sm_captured_names` — e.g. a decl_site
/// was empty).
sm_local_field_name :: (fn(imm(variable_id) : String) -> String)(
  match(
    g_sm_local_field_names.get(variable_id.clone()),
    .Some(stable) => stable,
    .None => {
      pre := String.from("var_");
      pre.push_string(variable_id);
      sanitize_for_c_identifier(pre, false)
    }
  )
);
/// The C field name for a state-machine local (consistent across struct
/// definition and use): an alias wins; otherwise the registered stable name
/// (Phase 2) with the historical `var_<id>` as the unregistered fallback. A
/// captured (`.Outer`) variable never comes here: it lives in the capture
/// struct, whose slot `sm_slot_of_variable` names.
get_state_machine_field_name :: (fn(imm(variable_id) : String, imm(aliases) : Option(HashMap(String, String))) -> String)({
  match(
    aliases,
    .Some(a) => match(a.get(variable_id.clone()), .Some(al) => return(al), .None => ()),
    .None => ()
  );
  sm_local_field_name(variable_id)
});
export(
  get_state_machine_field_name,
  sm_local_field_name,
  register_sm_local_field_name,
  register_sm_captured_names
);
/// The state-machine variable a local's reads and writes go through. A local
/// that shares an owner's RC value (`s := c`) is stored in its owner's slot
/// when the owner is a local of the same body; an owner from outside the body
/// (a capture) is not a slot, and the local then has storage of its own.
sm_storage_id :: (fn(imm(v) : Variable, imm(smv) : HashMap(String, CapturedVariable), imm(remap) : Option(HashMap(String, String))) -> String)({
  canon := (fn(imm(id) : String, imm(remap) : Option(HashMap(String, String))) -> String)(
    match(remap, .Some(rm) => match(rm.get(id.clone()), .Some(m) => m, .None => id), .None => id)
  );
  own := canon(v.id.to_string(), remap);
  match(
    v.is_owning_the_same_rc_value_as,
    .Some(ob) => {
      oid := canon(ob.*.id.to_string(), remap);
      match(
        smv.get(oid.clone()),
        .Some(ocv) => match(ocv.kind, .Local => oid, .Outer => own),
        .None => own
      )
    },
    .None => own
  )
});
/// The task slot (`sm->…`) of the binding `name` resolves to in `env`, or
/// `.None` when it is a C local. `smv` is the state machine's captured-variable
/// map, `remap` and `aliases` the context's id remapping and field aliases,
/// `capture_slot` the context's capture-struct field (`sm_capture_slot`).
/// A local sharing a captured local's RC value is stored in that owner's
/// slot (`sm_storage_id`).
sm_slot_of :: (
  fn(key : ExprId, imm(env) : Environment, imm(name) : String, imm(smv) : HashMap(String, CapturedVariable), imm(remap) : Option(HashMap(String, String)), imm(aliases) : Option(HashMap(String, String)), imm(capture_slot) : String) -> Option(String)
)({
  // Through node `key`'s recorded scope (scope-exit release,
  // plans/CODEGEN_MEMORY_REDUCTION.md §6.1).
  vs := scope_variables(key, env, name);
  match(vs.last(), .Some(v) => sm_slot_of_variable(v, smv, remap, aliases, capture_slot), .None => Option(String).None)
});
/// `sm_slot_of` for an already resolved binding. An outer (captured)
/// variable's storage is its capture-struct field,
/// `sm-><capture_slot>.<name>`, named by the variable's NAME and never the map
/// key (an outer capture is registered under its id and its label; see
/// `resolve_var_name_in_context`).
sm_slot_of_variable :: (
  fn(imm(v) : Variable, imm(smv) : HashMap(String, CapturedVariable), imm(remap) : Option(HashMap(String, String)), imm(aliases) : Option(HashMap(String, String)), imm(capture_slot) : String) -> Option(String)
)({
  id := sm_storage_id(v, smv, remap);
  cv := match(smv.get(id.clone()), .Some(c) => c, .None => return(Option(String).None));
  field := match(
    cv.kind,
    .Outer => `${capture_slot}.${sanitize_for_c_identifier(cv.base.name.clone(), false)}`,
    .Local => match(
      aliases,
      .Some(al) => match(al.get(id.clone()), .Some(af) => af, .None => sm_local_field_name(id.clone())),
      .None => sm_local_field_name(id.clone())
    )
  );
  Option(String).Some(`sm->${field}`)
});
/// The temps an `io.await` consumes: moved into the task's await slot, which
/// owns and releases them. Filled by `compute_cross_boundary_variables`; read
/// by the temp-to-slot store, which must not also put one in a local slot
/// (the abort dispose would then drop it a second time).
(g_await_consumed_temps : HashSet(String)) = HashSet(String).new();
note_await_consumed_temp :: (fn(imm(name) : String) -> unit)({
  g_await_consumed_temps.insert(name);
});
is_await_consumed_temp :: (fn(imm(name) : String) -> bool)(
  g_await_consumed_temps.contains(name)
);
/// The task-slot fields of NAMED locals, each with a move flag
/// (`uint8_t __yo_mv_<field>`) beside it in its state-machine struct. A move
/// out of such a slot sets the flag and leaves the value in place: the
/// language lets the moved-from name still read the value while its new owner
/// holds it (`current := manifest; … f(manifest)`), so zeroing the slot at the
/// move read NULL. The abort dispose empties a flagged slot before its drops,
/// and every store into the slot clears the flag
/// (issues/fixed/a-local-read-after-it-moves-inside-a-task-reads-an-emptied-slot.md).
/// Filled by the struct emitter, which runs before the resume function.
/// Field names carry the variable id, so a name identifies one struct's field.
(g_sm_move_flag_fields : HashSet(String)) = HashSet(String).new();
note_sm_move_flag_field :: (fn(imm(field) : String) -> unit)({
  g_sm_move_flag_fields.insert(field);
});
/// The move flag (`sm->__yo_mv_<field>`) of the slot `sm_code`
/// (`sm-><field>`), or `.None` when the slot has none.
sm_move_flag_of :: (fn(imm(sm_code) : String) -> Option(String))({
  if(!sm_code.starts_with("sm->"), {
    return(Option(String).None);
  });
  field := sm_code.substring(usize(4), sm_code.len());
  if(!g_sm_move_flag_fields.contains(field.clone()), {
    return(Option(String).None);
  });
  Option(String).Some(`sm->__yo_mv_${field}`)
});
/// The task slot (`sm->…`) a minted temp named `temp_var` was stored into,
/// found as `_store_temp_var_to_state_machine_if_needed` finds it: by id key,
/// then by the captured variable's name.
sm_temp_slot_of :: (fn(imm(temp_var) : String, imm(smv) : HashMap(String, CapturedVariable)) -> Option(String))({
  (found : Option(CapturedVariable)) = smv.get(temp_var.clone());
  if(found.is_none(), {
    vals := smv.values();
    (go : bool) = true;
    while(go, {
      match(
        vals.next(),
        .Some(cv) => if(cv.base.name == temp_var, {
          found = Option(CapturedVariable).Some(cv);
          go = false;
        }),
        .None => {
          go = false;
        }
      );
    });
  });
  match(
    found,
    .Some(cv) => match(cv.kind, .Local => Option(String).Some(`sm->${sm_local_field_name(cv.base.id.to_string())}`), .Outer => Option(String).None),
    .None => Option(String).None
  )
});
export(sm_storage_id, sm_slot_of, sm_slot_of_variable, sm_temp_slot_of, note_await_consumed_temp, is_await_consumed_temp, note_sm_move_flag_field, sm_move_flag_of);
