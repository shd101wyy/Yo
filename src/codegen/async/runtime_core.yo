//! runtime_core — core async scheduler C runtime. 1:1 port of
//! `src/codegen/async/runtime-core.ts`.
//!
//! Cooperative single-threaded per-thread event loop, continuation queue,
//! spawn/wait primitives, and concurrency helpers. Emits fixed C boilerplate
//! (with a few target-dependent branches) via the Emitter. `has_io` is always
//! true (all platforms have I/O; WASM uses a timer queue). Phase 5 #4.
open(import("std/string"));
{ Emitter } :: import("../../emitter.yo");
{ TargetInfo, is_target_macos, is_target_wasm, is_target_windows } :: import("../../target.yo");
generate_async_runtime_core :: (
  fn(emitter : Emitter, target_info : TargetInfo) -> unit
)({
  thread_local := cond(
    is_target_windows(target_info) => String.from("__declspec(thread)"),
    true => String.from("_Thread_local")
  );
  // --- header + continuation/queue typedefs (runtime-core.ts:22-54) ---
  emitter.emit_string_line(
    `
// ============================================================================
// Async/Await Runtime - Per-Thread Cooperative Scheduler
// ============================================================================
// Cooperative async runtime with per-thread event loops. Each OS thread has its
// own scheduler and I/O backend — no shared state. Non-atomic refcounting.

// Continuation - a suspended async task waiting to be resumed
typedef struct __yo_continuation_t {
  void (*resume_fn)(void* state_machine);
  void* state_machine;
  struct __yo_continuation_t* next;
} __yo_continuation_t;

// Per-thread async task queue
typedef struct {
  __yo_continuation_t* head;
  __yo_continuation_t* tail;
  size_t count;
} __yo_async_task_queue_t;

// Thread-local async runtime state`
  );
  // Thread-local queue + free-list (runtime-core.ts:56-64).
  cond(
    is_target_windows(target_info) => emitter.emit_string_line(
      `static __declspec(thread) __yo_async_task_queue_t __yo_thread_async_queue = {NULL, NULL, 0};
static __declspec(thread) __yo_continuation_t* __yo_cont_free_list = NULL;`
    ),
    true => emitter.emit_string_line(
      `static __thread __yo_async_task_queue_t __yo_thread_async_queue = {NULL, NULL, 0};
static __thread __yo_continuation_t* __yo_cont_free_list = NULL;`
    )
  );
  // Per-thread flags (runtime-core.ts:66-84). has_io is always true.
  emitter.emit_string_line(
    `
static ${thread_local} bool __yo_async_scheduler_initialized = false;
static ${thread_local} size_t __yo_active_watch_count = 0;

// I/O subsystem init flag + forward declarations (per-thread)
static ${thread_local} bool __yo_io_initialized = false;
static void __yo_io_init(void);
static void __yo_io_cleanup(void);
static bool __yo_has_pending_io(void);
static int __yo_io_poll(void);
static int __yo_io_wait(void);

// Initialize async scheduler (lightweight - just sets flag)
static void __yo_async_scheduler_init(void) {
  if (__yo_async_scheduler_initialized) {
    return;
  }
  __yo_async_scheduler_initialized = true;
  ASYNC_DEBUG("[ASYNC] Scheduler initialized\\n");
}

// Enqueue a continuation on the current thread's event loop (no refcount mgmt).
static void __yo_async_enqueue_continuation(void (*resume_fn)(void*), void* state_machine) {
  ASYNC_DEBUG("[ASYNC] Enqueueing continuation: resume_fn=%p, sm=%p\\n", (void*)resume_fn, state_machine);
  __yo_continuation_t* cont;
  if (__yo_cont_free_list) {
    cont = __yo_cont_free_list;
    __yo_cont_free_list = cont->next;
  } else {
    cont = (__yo_continuation_t*)__yo_malloc(sizeof(__yo_continuation_t));
  }
  cont->resume_fn = resume_fn;
  cont->state_machine = state_machine;
  cont->next = NULL;
  if (__yo_thread_async_queue.tail) {
    __yo_thread_async_queue.tail->next = cont;
    __yo_thread_async_queue.tail = cont;
  } else {
    __yo_thread_async_queue.head = cont;
    __yo_thread_async_queue.tail = cont;
  }
  __yo_thread_async_queue.count++;
  ASYNC_DEBUG("[ASYNC] Queue count: %zu\\n", __yo_thread_async_queue.count);
}

// Spawn an async task by enqueueing it (no refcount increment).
static void __yo_async_spawn_task(void (*resume_fn)(void*), void* state_machine) {
  ASYNC_DEBUG("[ASYNC] Spawning task: resume_fn=%p, sm=%p\\n", (void*)resume_fn, state_machine);
  __yo_async_enqueue_continuation(resume_fn, state_machine);
}

// How many task resume functions are on the C stack right now. Zero at the
// top level (async main's loop, a synchronous await in main or a test body,
// JoinHandle.await / the std/async combinators called from there). Non-zero
// means the event loop is being driven from INSIDE a task — see
// __yo_async_poll_step.
// Per THREAD: every worker thread (std/sync ThreadPool, Thread.spawn) runs its
// own event loop over its own thread-local queue, and a task resuming on one
// thread must not make a blocking await on another look nested (the first CI
// run of the guard aborted tests/thread_pool.test.yo exactly that way).
static __thread int __yo_async_task_depth = 0;

static int __yo_async_strict_cached = -1;
static int __yo_async_strict_nesting(void) {
  if (__yo_async_strict_cached < 0) {
    const char* v = getenv("YO_ASYNC_STRICT");
    __yo_async_strict_cached = (v && v[0] && v[0] != '0') ? 1 : 0;
  }
  return __yo_async_strict_cached;
}

// Process the tasks that are ready NOW (non-blocking). Bounded to the queue
// length at entry: a task that re-enqueues itself on every resume (a loop
// awaiting 'yield', a poll-until-finished race) would otherwise keep this
// drain busy forever and the I/O poll that follows in __yo_async_poll_step
// would never run — timers and sockets starve and the program spins
// (issues/fixed/async-yield-loop-starves-io-poll.md). Continuations queued
// during this step run in the next step, after one I/O poll.
// Returns the number of tasks resumed, so the caller knows whether anything a
// blocking waiter watches may have changed in this step.
static int __yo_async_run_ready_tasks(void) {
  int budget = (int)__yo_thread_async_queue.count;
  int ran = 0;
  while (__yo_thread_async_queue.head && budget > 0) {
    ran++;
    budget--;
    __yo_continuation_t* cont = __yo_thread_async_queue.head;
    __yo_thread_async_queue.head = cont->next;
    if (!__yo_thread_async_queue.head) {
      __yo_thread_async_queue.tail = NULL;
    }
    __yo_thread_async_queue.count--;
    { __yo_async_task_depth++; cont->resume_fn(cont->state_machine); __yo_async_task_depth--; }
    cont->next = __yo_cont_free_list;
    __yo_cont_free_list = cont;
  }
  return ran;
}

// One step of the event loop: drain task queue, then poll/wait for I/O.
static void __yo_async_poll_step(void) {
  // Re-entrancy guard (C37, issues/fixed/sync-await-in-plain-fn-nests-the-event-loop.md).
  // Every blocking wait — an io.await in a NON-io.async function,
  // JoinHandle.await, std/async's join_all/race/any/timeout — is a loop over
  // this function. Reached from inside a task it nests the event loop: every
  // task below on the C stack is frozen until the awaited I/O completes, and
  // when that I/O depends on one of them the program deadlocks silently (or a
  // frozen frame is resumed underneath itself). Fail here, deterministically,
  // at the first offending call instead.
  // Armed by YO_ASYNC_STRICT=1 (the test runner sets it for every test child,
  // so tests/ is enforced). Off by default for now: the compiler's own build
  // scheduler still drives spawned tasks that call plain awaiting helpers
  // (issues/retired/compiler-build-runner-nests-event-loop.md); those nestings cannot
  // deadlock (their I/O never depends on a sibling task) but the guard cannot
  // tell. Flip the default once that is refactored.
  if (__yo_async_task_depth > 0 && __yo_async_strict_nesting()) {
    fprintf(stderr,
      "panic: a blocking await ran inside an async task: an io.await in a "
      "non-io.async function, JoinHandle.await, or a std/async combinator "
      "(join_all/race/any/timeout) was called from a spawned or awaited task. "
      "That nests the event loop and can deadlock. Make the function an "
      "io.async future and await it; to race tasks from inside a task, poll "
      "is_finished() and await yield().\\n");
    fflush(stderr);
    abort();
  }
  int ran = __yo_async_run_ready_tasks();
  if (__yo_io_initialized) {
    __yo_io_poll();
    // Block for I/O only in a step where NOTHING ran. A resumed task may have
    // completed the very future the caller is waiting on (every blocking
    // waiter — a top-level io.await, JoinHandle.await, the std/async
    // combinators — re-checks its predicate between steps, not inside one);
    // blocking here anyway parks the thread on unrelated pending I/O, e.g. a
    // spawned server's accept that nobody will ever connect to. kqueue's
    // 100 ms wait timeout hid this on macOS; io_uring_wait_cqe waits forever
    // (issues/fixed/event-loop-blocks-after-completing-the-awaited-future.md).
    // Same rule as __yo_async_wait_all's !tasks_processed.
    if (ran == 0 && !__yo_thread_async_queue.head && __yo_has_pending_io()) {
      __yo_io_wait();
    }
  }
}

// Run event loop until a specific Future completes (for async main).
static void __yo_async_run_until_complete(void* future_ptr) {
  if (!__yo_async_scheduler_initialized) {
    __yo_async_scheduler_init();
  }
  __yo_io_init();
  ASYNC_DEBUG("[ASYNC] Starting event loop for future=%p\\n", future_ptr);
  typedef struct { int state; } generic_future_t;
  generic_future_t* future = (generic_future_t*)future_ptr;
  int __future_state = future->state;
  while (__future_state != -1 && __future_state != -2) {
    int tasks_run = 0;
    while (tasks_run < 100) {
      __yo_continuation_t* cont = __yo_thread_async_queue.head;
      if (!cont) break;
      __yo_thread_async_queue.head = cont->next;
      if (!__yo_thread_async_queue.head) {
        __yo_thread_async_queue.tail = NULL;
      }
      __yo_thread_async_queue.count--;
      { __yo_async_task_depth++; cont->resume_fn(cont->state_machine); __yo_async_task_depth--; }
      cont->next = __yo_cont_free_list;
      __yo_cont_free_list = cont;
      tasks_run++;
    }
    __yo_io_poll();
    // Re-read the state BEFORE blocking: the drain above may have completed
    // the main future while other I/O (a parked accept, a timer) stays
    // pending — waiting on it would keep the process alive after main
    // returned (the Linux-only "loop stays alive" hang; same rule as
    // __yo_async_poll_step).
    __future_state = future->state;
    if (__future_state == -1 || __future_state == -2) {
      break;
    }
    if (tasks_run == 0 && !__yo_thread_async_queue.head && __yo_has_pending_io()) {
      __yo_io_wait();
      __future_state = future->state;
      continue;
    }
    if (!__yo_thread_async_queue.head) {
      if (!__yo_has_pending_io()) {
        if (__future_state != -1 && __future_state != -2) {
          break;
        }
      }
    }
  }
  __yo_io_cleanup();
  while (__yo_cont_free_list) {
    __yo_continuation_t* node = __yo_cont_free_list;
    __yo_cont_free_list = node->next;
    __yo_free(node);
  }
  ASYNC_DEBUG("[ASYNC] Event loop finished, future state=%d\\n", future->state);
  if (future->state == -2) {
    fprintf(stderr, "panic: async main Future was aborted by an effect handler\\n");
    abort();
  }
}

// Wait for all async tasks to complete (drains the queue).
static void __yo_async_wait_all(void) {
  if (!__yo_async_scheduler_initialized) {
    return;
  }
  __yo_io_init();
  while (true) {
    bool tasks_processed = false;
    while (__yo_thread_async_queue.head) {
      __yo_continuation_t* cont = __yo_thread_async_queue.head;
      __yo_thread_async_queue.head = cont->next;
      if (!__yo_thread_async_queue.head) {
        __yo_thread_async_queue.tail = NULL;
      }
      __yo_thread_async_queue.count--;
      { __yo_async_task_depth++; cont->resume_fn(cont->state_machine); __yo_async_task_depth--; }
      __yo_free(cont);
      tasks_processed = true;
    }
    __yo_io_poll();
    if (!tasks_processed && !__yo_thread_async_queue.head && __yo_has_pending_io()) {
      __yo_io_wait();
      continue;
    }
    if (!__yo_thread_async_queue.head && !__yo_has_pending_io()) {
      break;
    }
  }
  while (__yo_cont_free_list) {
    __yo_continuation_t* node = __yo_cont_free_list;
    __yo_cont_free_list = node->next;
    __yo_free(node);
  }
}

// ============================================================================
// Concurrency Helper Functions (from std/concurrency.yo)
// ============================================================================
static size_t __yo_thread_get_hardware_threads(void) {`
  );
  // hardware-threads body (runtime-core.ts:316-332).
  cond(
    is_target_windows(target_info) => emitter.emit_string_line(
      `  SYSTEM_INFO sysinfo;
  GetSystemInfo(&sysinfo);
  return (size_t)sysinfo.dwNumberOfProcessors;`
    ),
    is_target_macos(target_info) => emitter.emit_string_line(
      `  int count;
  size_t size = sizeof(count);
  if (sysctlbyname("hw.ncpu", &count, &size, NULL, 0) == 0) {
    return (size_t)count;
  }
  return 1;`
    ),
    is_target_wasm(target_info) => emitter.emit_string_line(`  return 1;  // WASM is single-threaded`),
    true => emitter.emit_string_line(
      `  long count = sysconf(_SC_NPROCESSORS_ONLN);
  return count > 0 ? (size_t)count : 1;`
    )
  );
  emitter.emit_string_line(
    `}

static void __yo_thread_set_maximum_threads(size_t num) {
  ASYNC_DEBUG("[CONCURRENCY] set_maximum_threads(%zu) - no-op for async/await\\n", num);
  (void)num;
}

static size_t __yo_get_thread_id(void) {`
  );
  // thread-id body (runtime-core.ts:343-353).
  cond(
    is_target_windows(target_info) => emitter.emit_string_line(`  return (size_t)GetCurrentThreadId();`),
    is_target_macos(target_info) => emitter.emit_string_line(
      `  uint64_t tid;
  pthread_threadid_np(NULL, &tid);
  return (size_t)tid;`
    ),
    is_target_wasm(target_info) => emitter.emit_string_line(`  return 0;  // WASM is single-threaded`),
    true => emitter.emit_string_line(`  return (size_t)syscall(SYS_gettid);`)
  );
  emitter.emit_string_line(
    `}

static void __yo_thread_yield(void) {`
  );
  // yield body (runtime-core.ts:358-364).
  cond(
    is_target_windows(target_info) => emitter.emit_string_line(`  SwitchToThread();`),
    is_target_wasm(target_info) => emitter.emit_string_line(`  // No-op: WASM is single-threaded, cooperative scheduling only`),
    true => emitter.emit_string_line(`  sched_yield();`)
  );
  emitter.emit_string_line(
    `}

// Async yield - an immediately-ready Future for cooperative yielding
typedef struct __yo_yield_future_t {
  int state;
  void (*continuation_fn)(void*);
  void* continuation_sm;
} __yo_yield_future_t;

static __yo_yield_future_t __yo_async_yield(void) {
  __yo_yield_future_t future;
  future.state = -1;
  future.continuation_fn = NULL;
  future.continuation_sm = NULL;
  return future;
}

// JoinHandle introspection/cancellation — every spawned future starts with
// this common header (the same layout JoinHandle.await casts to).
typedef struct {
  __yo_ref_header_t header;
  int state;
} __yo_spawned_future_header_t;

// Non-blocking FutureState read: positive step indices read as Running (1),
// matching io.state's mapping (0 Pending, -1 Completed, -2 Aborted).
static int32_t __yo_join_handle_state_raw(void* fut) {
  int s = ((__yo_spawned_future_header_t*)fut)->state;
  return (s > 0) ? 1 : s;
}

// Cancel a spawned task: mark a non-terminal state machine Aborted. Its
// pending continuation (if any) fires into the resume function's aborted-entry
// guard, which releases the resume-path reference instead of resuming.
// Terminal tasks (Completed/Aborted) are left untouched.
static void __yo_join_handle_abort_raw(void* fut) {
  __yo_spawned_future_header_t* h = (__yo_spawned_future_header_t*)fut;
  if (h->state >= 0) {
    h->state = -2;
  }
}`
  );
});
export(generate_async_runtime_core);
