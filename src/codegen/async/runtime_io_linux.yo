//! runtime_io_linux — Linux platform sync helpers + io_uring async I/O runtime.
//! C bodies verbatim (extracted, pure C, no interpolations/backticks).
//! Wired in by the runtime.yo dispatcher.
import("std/string");
{ Emitter } :: import("../../emitter.yo");
/// Emit Linux platform-specific SYNC helpers.
generate_platform_sys_runtime_linux :: (fn(emitter : Emitter) -> unit)({
  emitter.emit_string_line(
    `
// ============================================================================
// Platform-specific sync helpers (Linux)
// ============================================================================

#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <sys/utsname.h>
#include <sys/mman.h>
#include <sys/file.h>
#include <sys/uio.h>
#include <time.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <netinet/tcp.h>
#include <arpa/inet.h>
#include <sys/un.h>

// ============================================================================
// Synchronous FD Operations (Linux) - no IoFuture overhead
// ============================================================================

static int32_t __yo_sync_pipe(int32_t* pipefd) {
  int result = pipe((int*)pipefd);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_dup(int32_t oldfd) {
  int result = dup(oldfd);
  return (result < 0) ? -errno : result;
}

static int32_t __yo_sync_dup2(int32_t oldfd, int32_t newfd) {
  int result = dup2(oldfd, newfd);
  return (result < 0) ? -errno : result;
}

static int64_t __yo_sync_lseek(int32_t fd, int64_t offset, int32_t whence) {
  off_t result = lseek(fd, (off_t)offset, whence);
  return (result < 0) ? (int64_t)(-errno) : (int64_t)result;
}

/* Positioned synchronous write — see the macOS emitter's comment. */
static int32_t __yo_sync_write(int32_t fd, const void* buf, uint32_t count, uint64_t offset) {
  ssize_t n = pwrite(fd, buf, (size_t)count, (off_t)offset);
  if (n < 0 && errno == ESPIPE) n = write(fd, buf, (size_t)count);
  return (n < 0) ? -errno : (int32_t)n;
}

static int32_t __yo_sync_fallocate(int32_t fd, int32_t mode, int64_t offset, int64_t length) {
  int result = fallocate(fd, mode, (off_t)offset, (off_t)length);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_fcntl_getfl(int32_t fd) {
  int result = fcntl(fd, F_GETFL);
  return (result < 0) ? -errno : result;
}

static int32_t __yo_sync_fcntl_setfl(int32_t fd, int32_t flags) {
  int result = fcntl(fd, F_SETFL, flags);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_fcntl_getfd(int32_t fd) {
  int result = fcntl(fd, F_GETFD);
  return (result < 0) ? -errno : result;
}

static int32_t __yo_sync_fcntl_setfd(int32_t fd, int32_t flags) {
  int result = fcntl(fd, F_SETFD, flags);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_flock(int32_t fd, int32_t operation) {
  int result = flock(fd, operation);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_readv(int32_t fd, void* iov, int32_t iovcnt) {
  ssize_t result = readv(fd, (const struct iovec*)iov, (int)iovcnt);
  return (result < 0) ? -errno : (int32_t)result;
}

static int32_t __yo_sync_writev(int32_t fd, void* iov, int32_t iovcnt) {
  ssize_t result = writev(fd, (const struct iovec*)iov, (int)iovcnt);
  return (result < 0) ? -errno : (int32_t)result;
}

static int32_t __yo_sync_preadv(int32_t fd, void* iov, int32_t iovcnt, int64_t offset) {
  struct iovec* vec = (struct iovec*)iov;
  ssize_t total = 0;
  off_t current = (off_t)offset;

  for (int32_t i = 0; i < iovcnt; i++) {
    if (vec[i].iov_len == 0) continue;
    ssize_t n = pread(fd, vec[i].iov_base, vec[i].iov_len, current);
    if (n < 0) {
      return (total > 0) ? (int32_t)total : -errno;
    }
    total += n;
    if ((size_t)n < vec[i].iov_len) {
      break;
    }
    current += (off_t)n;
  }

  return (int32_t)total;
}

static int32_t __yo_sync_pwritev(int32_t fd, void* iov, int32_t iovcnt, int64_t offset) {
  struct iovec* vec = (struct iovec*)iov;
  ssize_t total = 0;
  off_t current = (off_t)offset;

  for (int32_t i = 0; i < iovcnt; i++) {
    if (vec[i].iov_len == 0) continue;
    ssize_t n = pwrite(fd, vec[i].iov_base, vec[i].iov_len, current);
    if (n < 0) {
      return (total > 0) ? (int32_t)total : -errno;
    }
    total += n;
    if ((size_t)n < vec[i].iov_len) {
      break;
    }
    current += (off_t)n;
  }

  return (int32_t)total;
}

static size_t __yo_iovec_size(void) {
  return sizeof(struct iovec);
}

static void __yo_iovec_set(void* iov, size_t index, void* base, size_t len) {
  struct iovec* vec = (struct iovec*)iov;
  vec[index].iov_base = base;
  vec[index].iov_len = len;
}

static int32_t __yo_sync_fadvise(int32_t fd, int64_t offset, int64_t len, int32_t advice) {
  int result = posix_fadvise(fd, (off_t)offset, (off_t)len, advice);
  return (result == 0) ? 0 : -result;
}

static int32_t __yo_sync_madvise(uint8_t* addr, size_t length, int32_t advice) {
  int result = madvise((void*)addr, length, advice);
  return (result < 0) ? -errno : 0;
}

static uint8_t* __yo_sync_mmap(uint8_t* addr, size_t length, int32_t prot, int32_t flags, int32_t fd, int64_t offset) {
  void* result = mmap((void*)addr, length, prot, flags, fd, (off_t)offset);
  if (result == MAP_FAILED) {
    return (uint8_t*)(intptr_t)(-errno);
  }
  return (uint8_t*)result;
}

static bool __yo_sync_mmap_is_error(uint8_t* addr) {
  intptr_t value = (intptr_t)addr;
  return (value < 0) && (value >= -65535);
}

static int32_t __yo_sync_mmap_errno(uint8_t* addr) {
  intptr_t value = (intptr_t)addr;
  if ((value < 0) && (value >= -65535)) {
    return (int32_t)(-value);
  }
  return 0;
}

static int32_t __yo_sync_munmap(uint8_t* addr, size_t length) {
  int result = munmap((void*)addr, length);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_mprotect(uint8_t* addr, size_t length, int32_t prot) {
  int result = mprotect((void*)addr, length, prot);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_msync(uint8_t* addr, size_t length, int32_t flags) {
  int result = msync((void*)addr, length, flags);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_fchmod(int32_t fd, uint32_t mode) {
  int result = fchmod(fd, (mode_t)mode);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_fchmodat(int32_t dirfd, const char* path, uint32_t mode, int32_t flags) {
  int result = fchmodat(dirfd, path, (mode_t)mode, flags);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_fchown(int32_t fd, uint32_t uid, uint32_t gid) {
  int result = fchown(fd, (uid_t)uid, (gid_t)gid);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_fchownat(int32_t dirfd, const char* path, uint32_t uid, uint32_t gid, int32_t flags) {
  int result = fchownat(dirfd, path, (uid_t)uid, (gid_t)gid, flags);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_readlinkat(int32_t dirfd, const char* path, char* buf, size_t bufsize) {
  ssize_t result = readlinkat(dirfd, path, buf, bufsize);
  return (result < 0) ? -errno : (int32_t)result;
}

// Sync getsockname - get local socket address
static int32_t __yo_sync_getsockname(int32_t sockfd, void* addr, uint32_t* addrlen) {
  socklen_t len = (socklen_t)(*addrlen);
  int result = getsockname(sockfd, (struct sockaddr*)addr, &len);
  if (result < 0) {
    return -errno;
  }
  *addrlen = (uint32_t)len;
  return 0;
}

// Sync getpeername - get remote peer address
static int32_t __yo_sync_getpeername(int32_t sockfd, void* addr, uint32_t* addrlen) {
  socklen_t len = (socklen_t)(*addrlen);
  int result = getpeername(sockfd, (struct sockaddr*)addr, &len);
  if (result < 0) {
    return -errno;
  }
  *addrlen = (uint32_t)len;
  return 0;
}

// Sync setsockopt - set socket option value
static int32_t __yo_sync_setsockopt(int32_t sockfd, int32_t level, int32_t optname,
                                     const void* optval, uint32_t optlen) {
  int result = setsockopt(sockfd, level, optname, optval, (socklen_t)optlen);
  return (result < 0) ? -errno : 0;
}

// Sync getsockopt - get socket option value
static int32_t __yo_sync_getsockopt(int32_t sockfd, int32_t level, int32_t optname,
                                     void* optval, uint32_t* optlen) {
  socklen_t len = (socklen_t)(*optlen);
  int result = getsockopt(sockfd, level, optname, optval, &len);
  if (result < 0) {
    return -errno;
  }
  *optlen = (uint32_t)len;
  return 0;
}

// Sync socketpair - create a connected socket pair
static int32_t __yo_sync_socketpair(int32_t domain, int32_t sock_type, int32_t protocol, int32_t* sv) {
  int result = socketpair(domain, sock_type, protocol, (int*)sv);
  return (result < 0) ? -errno : 0;
}

// Sync clock_gettime - read current clock time
static int32_t __yo_sync_clock_gettime(int32_t clock_id, int64_t* sec, int64_t* nsec) {
  struct timespec ts;
  int result = clock_gettime((clockid_t)clock_id, &ts);
  if (result < 0) {
    return -errno;
  }
  *sec = (int64_t)ts.tv_sec;
  *nsec = (int64_t)ts.tv_nsec;
  return 0;
}

// Sync uname - system identification
static int32_t __yo_sync_uname(void* buf) {
  int result = uname((struct utsname*)buf);
  return (result < 0) ? -errno : 0;
}

// Sync gethostname - read host name
static int32_t __yo_sync_gethostname(char* name, size_t len) {
  int result = gethostname(name, len);
  if (result < 0) {
    return -errno;
  }
  if (len > 0) {
    name[len - 1] = '\\0';
  }
  return 0;
}

// Sync umask - set process file mode creation mask
static int32_t __yo_sync_umask(int32_t mask) {
  mode_t prev = umask((mode_t)mask);
  return (int32_t)prev;
}


// ============================================================================
// Socket Address Helpers (Cross-platform)
// ============================================================================

static size_t __yo_sockaddr_in_size(void) {
  return sizeof(struct sockaddr_in);
}

static size_t __yo_sockaddr_in6_size(void) {
  return sizeof(struct sockaddr_in6);
}

static size_t __yo_sockaddr_un_size(void) {
  return sizeof(struct sockaddr_un);
}

static size_t __yo_sockaddr_storage_size(void) {
  return sizeof(struct sockaddr_storage);
}

static void __yo_sockaddr_set_family(void* addr, uint16_t family) {
  ((struct sockaddr*)addr)->sa_family = family;
}

static uint16_t __yo_sockaddr_get_family(void* addr) {
  return ((struct sockaddr*)addr)->sa_family;
}

static void __yo_sockaddr_in_set_port(void* addr, uint16_t port) {
  ((struct sockaddr_in*)addr)->sin_port = htons(port);
}

static uint16_t __yo_sockaddr_in_get_port(void* addr) {
  return ntohs(((struct sockaddr_in*)addr)->sin_port);
}

static void __yo_sockaddr_in_set_addr(void* addr, uint32_t ip) {
  ((struct sockaddr_in*)addr)->sin_addr.s_addr = ip;
}

static uint32_t __yo_sockaddr_in_get_addr(void* addr) {
  return ((struct sockaddr_in*)addr)->sin_addr.s_addr;
}

static void __yo_sockaddr_in6_set_port(void* addr, uint16_t port) {
  ((struct sockaddr_in6*)addr)->sin6_port = htons(port);
}

static uint16_t __yo_sockaddr_in6_get_port(void* addr) {
  return ntohs(((struct sockaddr_in6*)addr)->sin6_port);
}

static void __yo_sockaddr_in6_set_addr(void* addr, const void* ip) {
  memcpy(&((struct sockaddr_in6*)addr)->sin6_addr, ip, 16);
}

static void __yo_sockaddr_in6_get_addr(void* addr, void* out) {
  memcpy(out, &((struct sockaddr_in6*)addr)->sin6_addr, 16);
}

static void __yo_sockaddr_un_set_path(void* addr, const char* path) {
  strncpy(((struct sockaddr_un*)addr)->sun_path, path, sizeof(((struct sockaddr_un*)addr)->sun_path) - 1);
  ((struct sockaddr_un*)addr)->sun_path[sizeof(((struct sockaddr_un*)addr)->sun_path) - 1] = '\\0';
}

static uint8_t* __yo_sockaddr_un_get_path(void* addr) {
  return (uint8_t*)(((struct sockaddr_un*)addr)->sun_path);
}

static int32_t __yo_inet_pton(int32_t af, const char* src, void* dst) {
  return inet_pton(af, src, dst);
}

static uint8_t* __yo_inet_ntop(int32_t af, const void* src, char* dst, uint32_t size) {
  return (uint8_t*)((char*)inet_ntop(af, src, dst, (socklen_t)size));
}

static uint16_t __yo_htons(uint16_t hostshort) {
  return htons(hostshort);
}

static uint16_t __yo_ntohs(uint16_t netshort) {
  return ntohs(netshort);
}

static uint32_t __yo_htonl(uint32_t hostlong) {
  return htonl(hostlong);
}

static uint32_t __yo_ntohl(uint32_t netlong) {
  return ntohl(netlong);
}

// Synchronous file operations (kept for compatibility)
static int32_t __yo_file_open(const char* path, int32_t flags, int32_t mode) {
  int fd = open(path, flags, mode);
  int result = fd >= 0 ? fd : -errno;
  ASYNC_DEBUG("[Io] open(%s, 0x%x, 0%o) = %d\\n", path, flags, mode, result);
  return result;
}

// Installed by the epoll fallback's init (NULL otherwise): purge parked
// async ops registered on a descriptor before it goes away, so parked
// waiters do not outlive their fd and a reused fd number cannot collide
// with a stale registration. The ring backend needs no hook: closing an fd
// with pending ring ops makes the kernel cancel them, each through its own
// CQE, which is what releases the ring's reference.
static void (*__yo_io_close_hook)(int32_t) = NULL;

static void __yo_file_close(int32_t fd) {
  ASYNC_DEBUG("[Io] close(%d)\\n", fd);
  if (__yo_io_close_hook) __yo_io_close_hook(fd);
  close(fd);
}

static int64_t __yo_file_size(int32_t fd) {
  struct stat st;
  if (fstat(fd, &st) < 0) {
    int result = -errno;
    ASYNC_DEBUG("[Io] fstat(%d) failed: %d\\n", fd, result);
    return result;
  }
  ASYNC_DEBUG("[Io] fstat(%d) = %lld bytes\\n", fd, (long long)st.st_size);
  return st.st_size;
}

// Fill a statx buffer from an OPEN DESCRIPTOR instead of a path — the fd form
// of __yo_async_statx_start, for a handle whose path is unknown or has since
// been renamed/unlinked. statx() with AT_EMPTY_PATH and an empty path IS
// fstat(2), and it fills the very struct statx the accessors below read.
// Returns 0 on success, -errno on failure.
static int32_t __yo_fstat(int32_t fd, void* statxbuf) {
  int result = statx(fd, "", AT_EMPTY_PATH, STATX_BASIC_STATS, (struct statx*)statxbuf);
  return (result < 0) ? -errno : 0;
}

// Get size of statx buffer (for allocation)
static size_t __yo_statx_buf_size(void) {
  return sizeof(struct statx);
}

// Extract fields from struct statx
static int64_t __yo_statx_size(void* statxbuf) {
  return (int64_t)((struct statx*)statxbuf)->stx_size;
}

static uint32_t __yo_statx_mode(void* statxbuf) {
  return (uint32_t)((struct statx*)statxbuf)->stx_mode;
}

static int64_t __yo_statx_mtime_sec(void* statxbuf) {
  return (int64_t)((struct statx*)statxbuf)->stx_mtime.tv_sec;
}

static uint32_t __yo_statx_mtime_nsec(void* statxbuf) {
  return (uint32_t)((struct statx*)statxbuf)->stx_mtime.tv_nsec;
}

static int64_t __yo_statx_atime_sec(void* statxbuf) {
  return (int64_t)((struct statx*)statxbuf)->stx_atime.tv_sec;
}

static uint32_t __yo_statx_atime_nsec(void* statxbuf) {
  return (uint32_t)((struct statx*)statxbuf)->stx_atime.tv_nsec;
}

static int64_t __yo_statx_ctime_sec(void* statxbuf) {
  return (int64_t)((struct statx*)statxbuf)->stx_ctime.tv_sec;
}

static uint32_t __yo_statx_ctime_nsec(void* statxbuf) {
  return (uint32_t)((struct statx*)statxbuf)->stx_ctime.tv_nsec;
}

static int64_t __yo_statx_btime_sec(void* statxbuf) {
  return (int64_t)((struct statx*)statxbuf)->stx_btime.tv_sec;
}

static uint32_t __yo_statx_btime_nsec(void* statxbuf) {
  return (uint32_t)((struct statx*)statxbuf)->stx_btime.tv_nsec;
}

static uint32_t __yo_statx_uid(void* statxbuf) {
  return (uint32_t)((struct statx*)statxbuf)->stx_uid;
}

static uint32_t __yo_statx_gid(void* statxbuf) {
  return (uint32_t)((struct statx*)statxbuf)->stx_gid;
}

static uint64_t __yo_statx_ino(void* statxbuf) {
  return (uint64_t)((struct statx*)statxbuf)->stx_ino;
}

static uint64_t __yo_statx_dev_major(void* statxbuf) {
  return (uint64_t)((struct statx*)statxbuf)->stx_dev_major;
}

static uint64_t __yo_statx_dev_minor(void* statxbuf) {
  return (uint64_t)((struct statx*)statxbuf)->stx_dev_minor;
}

static uint64_t __yo_statx_nlink(void* statxbuf) {
  return (uint64_t)((struct statx*)statxbuf)->stx_nlink;
}

static uint64_t __yo_statx_blksize(void* statxbuf) {
  return (uint64_t)((struct statx*)statxbuf)->stx_blksize;
}

static uint64_t __yo_statx_blocks(void* statxbuf) {
  return (uint64_t)((struct statx*)statxbuf)->stx_blocks;
}


`
  );
});
/// Emit the Linux io_uring-based async I/O runtime.
generate_async_runtime_io_linux :: (fn(emitter : Emitter) -> unit)({
  emitter.emit_string_line(
    `
// ============================================================================
// Async I/O Runtime (Linux - io_uring via the vendored ring layer)
// ============================================================================

#include <errno.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <netinet/tcp.h>
#include <arpa/inet.h>
#include <sys/un.h>

#include <sys/eventfd.h>
#include <sys/epoll.h>
#include <poll.h>
#include <fcntl.h>

// Deterministic performance budgets (plans/DROP_LIBURING.md Phase 6, G3):
// counts, not clocks — a shared CI runner can enforce these. Always on:
// a thread-local increment per kernel entry costs nothing next to the entry
// itself. kernel_enters counts every io_uring_enter and epoll_wait;
// zero_timeout_enters counts the non-blocking probes (enter(0, 0, GETEVENTS)
// and epoll_wait(0)) — the anti-spin signal: a loop that is merely WAITING
// must accrue neither.
static _Thread_local unsigned long __yo_stats_kernel_enters = 0;
static _Thread_local unsigned long __yo_stats_zero_timeout_enters = 0;
unsigned long __yo_io_stats_kernel_enters(void) {
  return __yo_stats_kernel_enters;
}
unsigned long __yo_io_stats_zero_timeout_enters(void) {
  return __yo_stats_zero_timeout_enters;
}
// ============================================================================
// Vendored io_uring ring layer (plans/DROP_LIBURING.md Phase 1)
// ============================================================================
// The kernel UAPI, frozen: the SQE (64 B) / CQE (16 B) layouts and the mmap
// offsets are stable since 5.1 and append-only since; new ops and flags are
// additive, and we define only the pieces this runtime submits. This layer
// replaces the liburing dependency (~10 linked symbols plus header inlines)
// with namespaced C11, so the emitted program links against libc only.
//
// The protocol is the classic single-issuer, single-threaded-per-ring one:
//   fill an SQE slot (plain stores — we own it until the tail publish),
//   publish the SQ tail with release, enter;
//   acquire the CQ tail, read CQEs up to it, publish the CQ head with
//   release. On x86-64 the atomics are free (compiler barriers); on aarch64
//   they are ldar/stlr.
//
// Field names deliberately mirror liburing's struct __yo_uring so the layer
// reads against its proven reference implementation.
#include <sys/mman.h>
#include <sys/syscall.h>
#include <errno.h>
#include <stdint.h>
#include <string.h>
#include <unistd.h>

// Syscall numbers are unified across architectures (io_uring postdates the
// asm-generic numbering merge); the fallbacks cover libc headers that lack
// them.
#ifndef __NR_io_uring_setup
#define __NR_io_uring_setup 425
#endif
#ifndef __NR_io_uring_enter
#define __NR_io_uring_enter 426
#endif

#define __YO_IORING_SETUP_COOP_TASKRUN   (1U << 8)
#define __YO_IORING_SETUP_SINGLE_ISSUER  (1U << 12)
#define __YO_IORING_SETUP_DEFER_TASKRUN  (1U << 13)
#define __YO_IORING_ENTER_GETEVENTS      (1U << 0)
#define __YO_IORING_FEAT_SINGLE_MMAP     (1U << 0)
#define __YO_IORING_FSYNC_DATASYNC       (1U << 0)
#define __YO_IORING_OFF_SQ_RING          0ULL
#define __YO_IORING_OFF_CQ_RING          0x8000000ULL
#define __YO_IORING_OFF_SQES             0x10000000ULL

// Opcodes this runtime submits (numbers are stable UAPI; checked against
// include/uapi/linux/io_uring.h):
#define __YO_IORING_OP_FSYNC         3
#define __YO_IORING_OP_POLL_ADD      6
#define __YO_IORING_OP_SENDMSG       9
#define __YO_IORING_OP_RECVMSG       10
#define __YO_IORING_OP_ACCEPT        13
#define __YO_IORING_OP_ASYNC_CANCEL  14
#define __YO_IORING_OP_CONNECT       16
#define __YO_IORING_OP_OPENAT        18
#define __YO_IORING_OP_CLOSE         19
#define __YO_IORING_OP_STATX         21
#define __YO_IORING_OP_READ          22
#define __YO_IORING_OP_WRITE         23
#define __YO_IORING_OP_SEND          26
#define __YO_IORING_OP_RECV          27
#define __YO_IORING_OP_RENAMEAT      35
#define __YO_IORING_OP_UNLINKAT      36
#define __YO_IORING_OP_MKDIRAT       37
#define __YO_IORING_OP_SYMLINKAT     38
#define __YO_IORING_OP_LINKAT        39
#define __YO_IORING_OP_FTRUNCATE     55

// UAPI layouts (include/uapi/linux/io_uring.h), flat-spelled: the two unions
// are written out as the fields this runtime uses, with explicit padding so
// the sizes are load-bearing (64-byte SQE, 16-byte CQE — static_asserts
// below). The 'off' slot is the UAPI {off, addr2} union (RENAMEAT/SYMLINKAT/
// STATX carry a second address there); 'rw_flags' is the flag-word union.
struct __yo_uring_sqe {
  uint8_t  opcode;
  uint8_t  flags;
  uint16_t ioprio;
  int32_t  fd;
  uint64_t off;
  uint64_t addr;
  uint32_t len;
  uint32_t rw_flags;
  uint64_t user_data;
  uint16_t buf_index;
  uint16_t personality;
  uint8_t  __pad[20];
};

struct __yo_uring_cqe {
  uint64_t user_data;
  int32_t  res;
  uint32_t flags;
};

struct __yo_uring_sqring_offsets {
  uint32_t head, tail, ring_mask, ring_entries, flags, dropped, array, resv1;
  uint64_t resv2;
};

struct __yo_uring_cqring_offsets {
  uint32_t head, tail, ring_mask, ring_entries, overflow, cqes, flags, resv1;
  uint64_t resv2;
};

struct __yo_uring_params {
  uint32_t sq_entries, cq_entries, flags, sq_thread_cpu, sq_thread_idle,
      features, wq_fd, resv[3];
  struct __yo_uring_sqring_offsets sq_off;
  struct __yo_uring_cqring_offsets cq_off;
};

struct __yo_uring {
  int ring_fd;
  struct {
    uint32_t* khead;
    uint32_t* ktail;
    uint32_t* ring_mask;
    uint32_t* ring_entries;
    uint32_t* flags;
    uint32_t* dropped;
    uint32_t* array;
    uint32_t sqe_head, sqe_tail;
    struct __yo_uring_sqe* sqes;
    void* ring_ptr;
    size_t ring_sz;
  } sq;
  struct {
    uint32_t* khead;
    uint32_t* ktail;
    uint32_t* ring_mask;
    uint32_t* ring_entries;
    uint32_t* overflow;
    struct __yo_uring_cqe* cqes;
    void* ring_ptr;
    size_t ring_sz;
  } cq;
};

_Static_assert(sizeof(struct __yo_uring_sqe) == 64, "__yo_uring_sqe layout");
_Static_assert(sizeof(struct __yo_uring_cqe) == 16, "__yo_uring_cqe layout");

static inline uint32_t __yo_uring_load_acquire(const uint32_t* p) {
  return __atomic_load_n(p, __ATOMIC_ACQUIRE);
}

static inline void __yo_uring_store_release(uint32_t* p, uint32_t v) {
  __atomic_store_n(p, v, __ATOMIC_RELEASE);
}

// Create a ring: setup syscall, then the three mmaps (SQ ring, CQ ring, SQE
// array). With __YO_IORING_FEAT_SINGLE_MMAP the kernel hands out one region for
// both rings and both mmaps must use the larger size — the same dance
// liburing does. Returns 0 or -errno.
static int __yo_uring_queue_init(struct __yo_uring* ring, uint32_t entries,
                                 struct __yo_uring_params* p) {
  memset(ring, 0, sizeof(*ring));
  int fd = (int)syscall(__NR_io_uring_setup, entries, p);
  if (fd < 0) return -errno;

  size_t sq_ring_sz =
      (size_t)p->sq_off.array + p->sq_entries * sizeof(uint32_t);
  size_t cq_ring_sz = (size_t)p->cq_off.cqes +
                      p->cq_entries * sizeof(struct __yo_uring_cqe);
  if (p->features & __YO_IORING_FEAT_SINGLE_MMAP) {
    if (cq_ring_sz > sq_ring_sz) sq_ring_sz = cq_ring_sz;
    cq_ring_sz = sq_ring_sz;
  }

  void* sq_ring = mmap(NULL, sq_ring_sz, PROT_READ | PROT_WRITE,
                       MAP_SHARED | MAP_POPULATE, fd, __YO_IORING_OFF_SQ_RING);
  if (sq_ring == MAP_FAILED) {
    int e = errno;
    close(fd);
    return -e;
  }
  void* cq_ring = mmap(NULL, cq_ring_sz, PROT_READ | PROT_WRITE,
                       MAP_SHARED | MAP_POPULATE, fd, __YO_IORING_OFF_CQ_RING);
  if (cq_ring == MAP_FAILED) {
    int e = errno;
    munmap(sq_ring, sq_ring_sz);
    close(fd);
    return -e;
  }
  size_t sqes_sz = (size_t)p->sq_entries * sizeof(struct __yo_uring_sqe);
  void* sqes = mmap(NULL, sqes_sz, PROT_READ | PROT_WRITE,
                    MAP_SHARED | MAP_POPULATE, fd, __YO_IORING_OFF_SQES);
  if (sqes == MAP_FAILED) {
    int e = errno;
    munmap(sq_ring, sq_ring_sz);
    munmap(cq_ring, cq_ring_sz);
    close(fd);
    return -e;
  }

  ring->ring_fd = fd;
  ring->sq.ring_ptr = sq_ring;
  ring->sq.ring_sz = sq_ring_sz;
  ring->sq.khead = (uint32_t*)((char*)sq_ring + p->sq_off.head);
  ring->sq.ktail = (uint32_t*)((char*)sq_ring + p->sq_off.tail);
  ring->sq.ring_mask = (uint32_t*)((char*)sq_ring + p->sq_off.ring_mask);
  ring->sq.ring_entries = (uint32_t*)((char*)sq_ring + p->sq_off.ring_entries);
  ring->sq.flags = (uint32_t*)((char*)sq_ring + p->sq_off.flags);
  ring->sq.dropped = (uint32_t*)((char*)sq_ring + p->sq_off.dropped);
  ring->sq.array = (uint32_t*)((char*)sq_ring + p->sq_off.array);
  ring->sq.sqes = (struct __yo_uring_sqe*)sqes;
  ring->cq.ring_ptr = cq_ring;
  ring->cq.ring_sz = cq_ring_sz;
  ring->cq.khead = (uint32_t*)((char*)cq_ring + p->cq_off.head);
  ring->cq.ktail = (uint32_t*)((char*)cq_ring + p->cq_off.tail);
  ring->cq.ring_mask = (uint32_t*)((char*)cq_ring + p->cq_off.ring_mask);
  ring->cq.ring_entries = (uint32_t*)((char*)cq_ring + p->cq_off.ring_entries);
  ring->cq.overflow = (uint32_t*)((char*)cq_ring + p->cq_off.overflow);
  ring->cq.cqes = (struct __yo_uring_cqe*)((char*)cq_ring + p->cq_off.cqes);
  return 0;
}

static void __yo_uring_queue_exit(struct __yo_uring* ring) {
  munmap(ring->sq.sqes,
         (size_t)(*ring->sq.ring_entries) * sizeof(struct __yo_uring_sqe));
  munmap(ring->sq.ring_ptr, ring->sq.ring_sz);
  munmap(ring->cq.ring_ptr, ring->cq.ring_sz);
  close(ring->ring_fd);
  memset(ring, 0, sizeof(*ring));
}

// Reserve the next SQE slot. NULL when the SQ is full (the caller decides how
// to fail). Slot publication to the kernel happens at submit time.
static struct __yo_uring_sqe* __yo_uring_get_sqe(struct __yo_uring* ring) {
  if (ring->sq.sqe_tail - __yo_uring_load_acquire(ring->sq.khead) >=
      *ring->sq.ring_entries) {
    return NULL;
  }
  return &ring->sq.sqes[ring->sq.sqe_tail++ & *ring->sq.ring_mask];
}

static int __yo_uring_enter(struct __yo_uring* ring, uint32_t to_submit,
                            uint32_t min_complete, uint32_t flags) {
  __yo_stats_kernel_enters++;
  if (min_complete == 0) __yo_stats_zero_timeout_enters++;
  return (int)syscall(__NR_io_uring_enter, ring->ring_fd, to_submit,
                      min_complete, flags, NULL, 0);
}

// Publish every reserved SQE (fill the SQ array, release the tail) and enter.
// Returns the number submitted or -errno; EINTR handling stays with the
// callers, as it is today.
static int __yo_uring_submit(struct __yo_uring* ring) {
  uint32_t mask = *ring->sq.ring_mask;
  uint32_t ktail = *ring->sq.ktail;
  uint32_t head = ktail;
  while (ring->sq.sqe_head != ring->sq.sqe_tail) {
    ring->sq.array[head & mask] = ring->sq.sqe_head & mask;
    ring->sq.sqe_head++;
    head++;
  }
  if (head != ktail) __yo_uring_store_release(ring->sq.ktail, head);
  uint32_t to_submit = head - *ring->sq.khead;
  if (to_submit == 0) return 0;
  return __yo_uring_enter(ring, to_submit, 0, 0);
}

// The loop's main batching win in one syscall: publish the SQEs and block for
// the first completion together.
static int __yo_uring_submit_and_wait(struct __yo_uring* ring,
                                      uint32_t wait_nr) {
  uint32_t mask = *ring->sq.ring_mask;
  uint32_t ktail = *ring->sq.ktail;
  uint32_t head = ktail;
  while (ring->sq.sqe_head != ring->sq.sqe_tail) {
    ring->sq.array[head & mask] = ring->sq.sqe_head & mask;
    ring->sq.sqe_head++;
    head++;
  }
  if (head != ktail) __yo_uring_store_release(ring->sq.ktail, head);
  uint32_t to_submit = head - *ring->sq.khead;
  return __yo_uring_enter(ring, to_submit, wait_nr,
                          __YO_IORING_ENTER_GETEVENTS);
}

// A non-blocking enter with GETEVENTS: under __YO_IORING_SETUP_DEFER_TASKRUN the
// kernel materialises completions only when this thread enters the ring, so a
// pure-userspace peek can miss finished work; this is the non-blocking enter
// that makes them visible (it consumes nothing).
static int __yo_uring_getevents(struct __yo_uring* ring) {
  return __yo_uring_enter(ring, 0, 0, __YO_IORING_ENTER_GETEVENTS);
}

// Returns 0 and sets *cqe_ptr, or -EAGAIN when the CQ ring is empty.
static int __yo_uring_peek_cqe(struct __yo_uring* ring,
                               struct __yo_uring_cqe** cqe_ptr) {
  uint32_t head = *ring->cq.khead;
  if (head != __yo_uring_load_acquire(ring->cq.ktail)) {
    *cqe_ptr = &ring->cq.cqes[head & *ring->cq.ring_mask];
    return 0;
  }
  return -EAGAIN;
}

static unsigned __yo_uring_peek_batch_cqe(struct __yo_uring* ring,
                                          struct __yo_uring_cqe** cqes,
                                          unsigned nr) {
  uint32_t head = *ring->cq.khead;
  uint32_t tail = __yo_uring_load_acquire(ring->cq.ktail);
  unsigned count = 0;
  while (head != tail && count < nr) {
    cqes[count++] = &ring->cq.cqes[head & *ring->cq.ring_mask];
    head++;
  }
  return count;
}

// Advance the CQ head; the kernel reuses the slot only after this release.
static void __yo_uring_cqe_seen(struct __yo_uring* ring,
                                struct __yo_uring_cqe* cqe) {
  if (cqe) {
    __yo_uring_store_release(ring->cq.khead, *ring->cq.khead + 1);
  }
}

static int __yo_uring_wait_cqe(struct __yo_uring* ring,
                               struct __yo_uring_cqe** cqe_ptr) {
  int ret = __yo_uring_peek_cqe(ring, cqe_ptr);
  if (ret == 0) return 0;
  ret = __yo_uring_enter(ring, 0, 1, __YO_IORING_ENTER_GETEVENTS);
  if (ret < 0) return ret;
  return __yo_uring_peek_cqe(ring, cqe_ptr);
}

static inline void __yo_uring_sqe_set_data(struct __yo_uring_sqe* sqe,
                                           void* data) {
  sqe->user_data = (uint64_t)(uintptr_t)data;
}

static inline void* __yo_uring_cqe_get_data(const struct __yo_uring_cqe* cqe) {
  return (void*)(uintptr_t)cqe->user_data;
}

// Prep helpers. Unlike liburing's (which initialise most-but-not-all fields
// into a possibly-recycled slot), every helper here initialises EVERY field
// via __yo_uring_prep_rw first — a stale-data hazard cannot exist. The
// argument shapes mirror liburing's so the call sites keep their review
// history; the field placements (which UAPI slot carries which argument) are
// liburing's, verified against the kernel's opcode handlers.
static inline void __yo_uring_prep_rw(uint8_t op, struct __yo_uring_sqe* sqe,
                                      int32_t fd, const void* addr,
                                      uint32_t len, uint64_t off) {
  sqe->opcode = op;
  sqe->flags = 0;
  sqe->ioprio = 0;
  sqe->fd = fd;
  sqe->off = off;
  sqe->addr = (uint64_t)(uintptr_t)addr;
  sqe->len = len;
  sqe->rw_flags = 0;
  sqe->user_data = 0;
  sqe->buf_index = 0;
  sqe->personality = 0;
  memset(sqe->__pad, 0, sizeof(sqe->__pad));
}

static inline void __yo_uring_prep_read(struct __yo_uring_sqe* sqe, int32_t fd,
                                        void* buf, uint32_t size,
                                        int64_t offset) {
  __yo_uring_prep_rw(__YO_IORING_OP_READ, sqe, fd, buf, size, (uint64_t)offset);
}

static inline void __yo_uring_prep_write(struct __yo_uring_sqe* sqe,
                                         int32_t fd, const void* buf,
                                         uint32_t size, int64_t offset) {
  __yo_uring_prep_rw(__YO_IORING_OP_WRITE, sqe, fd, buf, size,
                     (uint64_t)offset);
}

static inline void __yo_uring_prep_openat(struct __yo_uring_sqe* sqe,
                                          int32_t dirfd, const char* path,
                                          int32_t flags, uint32_t mode) {
  __yo_uring_prep_rw(__YO_IORING_OP_OPENAT, sqe, dirfd, path, mode, 0);
  sqe->rw_flags = (uint32_t)flags;
}

static inline void __yo_uring_prep_close(struct __yo_uring_sqe* sqe,
                                         int32_t fd) {
  __yo_uring_prep_rw(__YO_IORING_OP_CLOSE, sqe, fd, NULL, 0, 0);
}

static inline void __yo_uring_prep_statx(struct __yo_uring_sqe* sqe,
                                         int32_t dirfd, const char* path,
                                         int32_t flags, uint32_t mask,
                                         void* statxbuf) {
  __yo_uring_prep_rw(__YO_IORING_OP_STATX, sqe, dirfd, path, mask,
                     (uint64_t)(uintptr_t)statxbuf);
  sqe->rw_flags = (uint32_t)flags;
}

static inline void __yo_uring_prep_mkdirat(struct __yo_uring_sqe* sqe,
                                           int32_t dirfd, const char* path,
                                           uint32_t mode) {
  __yo_uring_prep_rw(__YO_IORING_OP_MKDIRAT, sqe, dirfd, path, mode, 0);
}

static inline void __yo_uring_prep_unlinkat(struct __yo_uring_sqe* sqe,
                                            int32_t dirfd, const char* path,
                                            int32_t flags) {
  // liburing's shape: len stays 0 and the flags travel in the rw_flags
  // union slot (unlink_flags). Encoding them in len made every
  // remove_dir (AT_REMOVEDIR) fail with EINVAL (see the Phase 1 branch).
  __yo_uring_prep_rw(__YO_IORING_OP_UNLINKAT, sqe, dirfd, path, 0, 0);
  sqe->rw_flags = (uint32_t)flags;
}

static inline void __yo_uring_prep_renameat(struct __yo_uring_sqe* sqe,
                                            int32_t olddirfd,
                                            const char* oldpath,
                                            int32_t newdirfd,
                                            const char* newpath,
                                            uint32_t flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_RENAMEAT, sqe, olddirfd, oldpath,
                     (uint32_t)newdirfd, (uint64_t)(uintptr_t)newpath);
  sqe->rw_flags = flags;
}

static inline void __yo_uring_prep_symlinkat(struct __yo_uring_sqe* sqe,
                                             const char* target,
                                             int32_t newdirfd,
                                             const char* linkpath) {
  __yo_uring_prep_rw(__YO_IORING_OP_SYMLINKAT, sqe, newdirfd, target, 0,
                     (uint64_t)(uintptr_t)linkpath);
}

static inline void __yo_uring_prep_linkat(struct __yo_uring_sqe* sqe,
                                          int32_t olddirfd, const char* oldpath,
                                          int32_t newdirfd, const char* newpath,
                                          int32_t flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_LINKAT, sqe, olddirfd, oldpath,
                     (uint32_t)newdirfd, (uint64_t)(uintptr_t)newpath);
  sqe->rw_flags = (uint32_t)flags;
}

static inline void __yo_uring_prep_fsync(struct __yo_uring_sqe* sqe, int32_t fd,
                                         uint32_t fsync_flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_FSYNC, sqe, fd, NULL, 0, 0);
  sqe->rw_flags = fsync_flags;
}

static inline void __yo_uring_prep_ftruncate(struct __yo_uring_sqe* sqe,
                                             int32_t fd, int64_t length) {
  __yo_uring_prep_rw(__YO_IORING_OP_FTRUNCATE, sqe, fd, NULL, 0,
                     (uint64_t)length);
}

static inline void __yo_uring_prep_accept(struct __yo_uring_sqe* sqe,
                                          int32_t fd, void* addr,
                                          void* addrlen, int32_t flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_ACCEPT, sqe, fd, addr,
                     (uint32_t)(uintptr_t)addrlen, 0);
  sqe->rw_flags = (uint32_t)flags;
}

static inline void __yo_uring_prep_connect(struct __yo_uring_sqe* sqe,
                                           int32_t fd, const void* addr,
                                           uint32_t addrlen) {
  __yo_uring_prep_rw(__YO_IORING_OP_CONNECT, sqe, fd, addr, 0,
                     (uint64_t)addrlen);
}

static inline void __yo_uring_prep_send(struct __yo_uring_sqe* sqe, int32_t fd,
                                        const void* buf, size_t len,
                                        int32_t flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_SEND, sqe, fd, buf, (uint32_t)len, 0);
  sqe->rw_flags = (uint32_t)flags;
}

static inline void __yo_uring_prep_recv(struct __yo_uring_sqe* sqe, int32_t fd,
                                        void* buf, size_t len, int32_t flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_RECV, sqe, fd, buf, (uint32_t)len, 0);
  sqe->rw_flags = (uint32_t)flags;
}

static inline void __yo_uring_prep_sendmsg(struct __yo_uring_sqe* sqe,
                                           int32_t fd, void* msg,
                                           uint32_t flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_SENDMSG, sqe, fd, msg, 1, 0);
  sqe->rw_flags = flags;
}

static inline void __yo_uring_prep_recvmsg(struct __yo_uring_sqe* sqe,
                                           int32_t fd, void* msg,
                                           uint32_t flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_RECVMSG, sqe, fd, msg, 1, 0);
  sqe->rw_flags = flags;
}

static inline void __yo_uring_prep_poll_add(struct __yo_uring_sqe* sqe,
                                            int32_t fd, uint32_t events) {
  __yo_uring_prep_rw(__YO_IORING_OP_POLL_ADD, sqe, fd, NULL, 0, 0);
  sqe->rw_flags = events;
}

static inline void __yo_uring_prep_cancel(struct __yo_uring_sqe* sqe,
                                          void* target_user_data,
                                          uint32_t flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_ASYNC_CANCEL, sqe, -1, target_user_data, 0,
                     0);
  sqe->rw_flags = flags;
}

static _Thread_local struct __yo_uring __yo_io_ring;

// ThreadSanitizer does not order a munmap against a later mmap that returns
// the same address, so ring mappings reused across threads look racy to it.
// When one thread's ring is torn down and a later thread's ring is mapped at
// the same address, TSan still holds the dead ring's accesses and reports the new
// ring's first SQE write as a race with the old one. The kernel orders the
// two: a munmap and a later mmap that returns the same address both take the
// process's mmap_lock. Model exactly that order on each region's address,
// released at teardown and acquired at setup; it adds an edge only when an
// address is really reused
// (issues/fixed/tsan-reports-a-race-between-two-threads-io-uring-rings.md).
#if defined(__has_feature)
#  if __has_feature(thread_sanitizer)
#    define __YO_TSAN 1
#  endif
#endif
#if !defined(__YO_TSAN) && defined(__SANITIZE_THREAD__)
#  define __YO_TSAN 1
#endif
#ifdef __YO_TSAN
void __tsan_acquire(void* addr);
void __tsan_release(void* addr);
static void __yo_tsan_ring_mapped(struct __yo_uring* ring) {
  __tsan_acquire(ring->sq.ring_ptr);
  __tsan_acquire(ring->cq.ring_ptr);
  __tsan_acquire(ring->sq.sqes);
}
static void __yo_tsan_ring_unmapping(struct __yo_uring* ring) {
  __tsan_release(ring->sq.ring_ptr);
  __tsan_release(ring->cq.ring_ptr);
  __tsan_release(ring->sq.sqes);
}
#else
static inline void __yo_tsan_ring_mapped(struct __yo_uring* ring) { (void)ring; }
static inline void __yo_tsan_ring_unmapping(struct __yo_uring* ring) { (void)ring; }
#endif
// __yo_io_initialized is defined in runtime-core
static _Thread_local size_t __yo_pending_io_count = 0;
// Cross-thread wakeup channel (plans/archive/WAKER_BASED_SCHEDULING.md step 5): an
// eventfd this loop keeps a POLL_ADD armed on, so a foreign thread can end an
// __yo_uring_wait_cqe that would otherwise block forever. Its SQE carries a
// SENTINEL user_data rather than a future, and takes no pending-I/O slot: it
// is not work the loop is waiting for, it is how the loop is reachable.
#define __YO_IO_NOTIFY_UD ((void*)(uintptr_t)1)
static _Thread_local int __yo_notify_efd = -1;
static inline void __yo_io_arm_notify(void);
// Ring size matches the fixed io_uring queue depth we initialize below.
#define __YO_IO_RING_ENTRIES 1024
// Number of SQEs queued in userspace but not yet submitted to the kernel.
// Deferred submission lets us batch many SQEs into a single syscall.
static _Thread_local unsigned __yo_sq_unsubmitted = 0;
static _Thread_local unsigned __yo_sq_deferred_head = 0;
static _Thread_local __yo_io_future_t* __yo_sq_deferred_futures[__YO_IO_RING_ENTRIES];

// I/O Future types - __yo_io_future_t is defined in types/generation.yo
// It has the same layout as async state machines (state, result, continuation_fn, continuation_sm)
// so the await codegen can access ->state and ->result uniformly.
// We store the future pointer directly in the SQE user data.

// Create the loop's wakeup channel (an eventfd) if it has none: a descriptor,
// no locked memory. It is published to foreign wakers under the loop's lock,
// the same lock a waker takes to queue its token and bump xwake_count, so a
// wake posted before this finds notify_ready == 0 but is visible to the
// loop's next check, and a wake posted after writes the eventfd.
static void __yo_io_notify_init(void) {
  if (__yo_notify_efd >= 0) return;
  __yo_notify_efd = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
  if (__yo_notify_efd >= 0) {
    __yo_loop_t* loop = __yo_loop_self();
    __yo_mutex_lock(&loop->lock);
    loop->notify_fd = __yo_notify_efd;
    loop->notify_ready = 1;
    __yo_mutex_unlock(&loop->lock);
  }
}

// Backend selection (plans/DROP_LIBURING.md 3.6), declared ahead of the
// init ladder that decides it and the machinery below that implements it.
#define __YO_BACKEND_NONE     0
#define __YO_BACKEND_URING    1
#define __YO_BACKEND_EPOLL    2
#define __YO_BACKEND_DEGRADED 3
static _Thread_local int __yo_backend = __YO_BACKEND_NONE;
// The errno that ended the ladder (DEGRADED only): every async op completes
// with -__yo_backend_errno, the shape the sleep stub always documented.
static _Thread_local int __yo_backend_errno = 0;

static _Thread_local int __yo_epoll_fd = -1;
static void __yo_epoll_drop_fd(int fd);
static bool __yo_epoll_cancel(__yo_io_future_t* future);
static void __yo_epoll_drive(int timeout_ms, int* count_out);
static void __yo_epoll_teardown(void);

// Create the thread's io_uring ring. Called by the first I/O submission
// (every __yo_async_*_start), never at loop start: see __yo_io_loop_start.
static void __yo_io_init(void) {
  if (__yo_io_initialized) return;

  // Backend selection happens once per thread, never re-decided: the ring
  // first, the epoll fallback when the ring cannot exist (ENOSYS under
  // seccomp — Docker's default profile blocks io_uring_setup; EPERM on
  // hardened kernels; ENOMEM under RLIMIT_MEMLOCK; pre-5.6 kernels), and
  // only if BOTH fail does the loop run DEGRADED — every async op then
  // completes with -__yo_backend_errno instead of the old exit(1)
  // (plans/DROP_LIBURING.md 3.6, issues/fixed/io-uring-init-failure-exits-the-process.md).
  // YO_IO_BACKEND=uring|epoll pins a backend for tests and benchmarks; a
  // pinned backend that fails is a loud error, never a silent ladder step.
  int forced = 0;  // 0 auto, 1 uring, 2 epoll
  {
    const char* env = getenv("YO_IO_BACKEND");
    if (env) {
      if (strcmp(env, "uring") == 0) forced = 1;
      else if (strcmp(env, "epoll") == 0) forced = 2;
    }
  }

  if (forced != 2) {
    // Try modern kernel flags for lower overhead (requires Linux 6.0+):
    //   __YO_IORING_SETUP_COOP_TASKRUN — avoids inter-processor interrupts on task wakeup
    //     since we know our thread will reap completions.
    //   __YO_IORING_SETUP_SINGLE_ISSUER — we only submit from the owner thread.
    //   __YO_IORING_SETUP_DEFER_TASKRUN — completions run only when we call wait_cqe,
    //     avoiding random overhead on timer interrupts.
    struct __yo_uring_params params;
    memset(&params, 0, sizeof(params));
    params.flags |= __YO_IORING_SETUP_SINGLE_ISSUER;
    params.flags |= __YO_IORING_SETUP_COOP_TASKRUN;
    params.flags |= __YO_IORING_SETUP_DEFER_TASKRUN;

    int ret = __yo_uring_queue_init(&__yo_io_ring, __YO_IO_RING_ENTRIES, &params);
    if (ret < 0) {
      // Retry without any flags for older kernels
      memset(&params, 0, sizeof(params));
      ret = __yo_uring_queue_init(&__yo_io_ring, __YO_IO_RING_ENTRIES, &params);
    }
    if (ret == 0) {
      __yo_backend = __YO_BACKEND_URING;
      __yo_tsan_ring_mapped(&__yo_io_ring);
      __yo_io_initialized = true;
      __yo_io_notify_init();
      if (__yo_notify_efd >= 0) {
        __yo_io_arm_notify();
      }
      ASYNC_DEBUG("[Io] io_uring initialized with %d entries (flags=0x%x)\\n", __YO_IO_RING_ENTRIES, params.flags);
      return;
    }
    if (forced == 1) {
      fprintf(stderr, "[Yo] YO_IO_BACKEND=uring but io_uring is unavailable: %s\\n", strerror(-ret));
      exit(1);
    }
    fprintf(stderr, "[Yo] io_uring unavailable (%s); async I/O running on the epoll fallback\\n", strerror(-ret));
  }

  __yo_epoll_fd = epoll_create1(EPOLL_CLOEXEC);
  if (__yo_epoll_fd >= 0) {
    __yo_backend = __YO_BACKEND_EPOLL;
    __yo_io_initialized = true;
    __yo_io_notify_init();
    // The SAME wake channel the ring arms with POLL_ADD, registered once —
    // level-triggered, so no re-arm: it reports whenever the eventfd holds a
    // token and stops once the wait loop drains it.
    if (__yo_notify_efd >= 0) {
      struct epoll_event ev;
      memset(&ev, 0, sizeof(ev));
      ev.events = EPOLLIN;
      ev.data.ptr = (void*)(intptr_t)-1;
      epoll_ctl(__yo_epoll_fd, EPOLL_CTL_ADD, __yo_notify_efd, &ev);
    }
    // Parked ops must not outlive their descriptor: route the always-emitted
    // sync close through this backend's fd purge. The ring needs no hook —
    // the kernel cancels its ops with their own CQEs when an fd closes.
    __yo_io_close_hook = __yo_epoll_drop_fd;
    ASYNC_DEBUG("[Io] epoll fallback initialized: ep=%d\\n", __yo_epoll_fd);
    return;
  }
  {
    int ep_err = errno;
    __yo_backend = __YO_BACKEND_DEGRADED;
    __yo_backend_errno = ep_err;
    __yo_io_initialized = true;
    __yo_io_notify_init();
    fprintf(stderr, "[Yo] async I/O unavailable: io_uring and epoll both failed (%s); async operations will complete with an error\\n", strerror(ep_err));
  }
}

// A loop creates its ring on its first I/O submission (every
// __yo_async_*_start calls __yo_io_init), not at loop start. A loop that only
// waits for wakes (a spawn_blocking await, a Park, a cross-thread waker) never
// needs one: __yo_io_wait blocks on the eventfd with poll(). The kernel charges
// a ring's memory to RLIMIT_MEMLOCK and returns it only when its deferred
// teardown runs, so a ring per short-lived thread ran the limit out within a
// hundred threads: io_uring_queue_init failed with ENOMEM
// (issues/fixed/every-thread-creates-an-io-uring-ring-and-thread-churn-runs-out-of-memory.md).
static void __yo_io_loop_start(void) {}

// Cleanup io_uring
static void __yo_io_cleanup(void) {
  if (!__yo_io_initialized && __yo_notify_efd < 0) return;
  // Clear the loop's wakeup channel under the loop's mutex BEFORE closing the
  // eventfd: a foreign __yo_io_notify loads notify_fd under the same mutex, so
  // the clear and any in-flight write are serialized. Without the lock a
  // foreign wake could load a valid fd, then pause while this thread closes
  // the descriptor and the kernel reuses its number for something else, then
  // write to the WRONG file.
  {
    __yo_loop_t* loop = __yo_loop_self();
    __yo_mutex_lock(&loop->lock);
    loop->notify_ready = 0;
    loop->notify_fd = -1;
    __yo_mutex_unlock(&loop->lock);
  }
  // If async main returns while some SQEs are still only queued in userspace,
  // cancel them here instead of silently dropping the event-loop ref we took in
  // __yo_io_ring_submit.
  while (__yo_sq_unsubmitted > 0) {
    __yo_io_future_t* future = __yo_sq_deferred_futures[__yo_sq_deferred_head];
    __yo_sq_deferred_head = (__yo_sq_deferred_head + 1) % __YO_IO_RING_ENTRIES;
    __yo_sq_unsubmitted--;
    if (!future) continue;  // a cancellation SQE: no future, no pending slot
    __yo_pending_io_count--;
    future->result = -ECANCELED;
    future->state = -1;
    __yo_decr_rc((void*)future);
  }
  // A loop that only ever waited for wakes has an eventfd and no ring.
  if (__yo_backend == __YO_BACKEND_URING) {
    __yo_tsan_ring_unmapping(&__yo_io_ring);
    __yo_uring_queue_exit(&__yo_io_ring);
  } else if (__yo_backend == __YO_BACKEND_EPOLL) {
    __yo_epoll_teardown();
  }
  if (__yo_notify_efd >= 0) {
    close(__yo_notify_efd);
    __yo_notify_efd = -1;
  }
  __yo_io_initialized = false;
  ASYNC_DEBUG("[Io] io_uring cleaned up\\n");
}

// Check if there are pending I/O operations
static inline bool __yo_has_pending_io(void) {
  return __yo_pending_io_count > 0 || __yo_active_watch_count > 0;
}

// Forward declaration for poll/fs_event tick (defined in runtime-io-common)
static int __yo_poll_and_fs_event_tick(void);

// Queue an SQE for later submission to io_uring (deferred submit).
// The actual __yo_uring_submit() syscall happens inside __yo_io_poll / __yo_io_wait,
// so many SQEs produced within one "drain tasks" pass batch into one syscall.
static inline void __yo_io_ring_submit(__yo_io_future_t* future) {
  future->header.ref_count++;    // io_uring holds a reference until CQE
  __yo_pending_io_count++;
  __yo_sq_deferred_futures[(__yo_sq_deferred_head + __yo_sq_unsubmitted) % __YO_IO_RING_ENTRIES] = future;
  __yo_sq_unsubmitted++;
}

// Ask the kernel to cancel the operation submitted with target as its user
// data. The cancellation SQE carries NULL user data (it is not an operation a
// task awaits) and does NOT take a pending-I/O slot: the operation it cancels
// still owns one, and still delivers its own CQE — with -ECANCELED — which is
// what releases the ring's reference. Returns false when no SQE is available,
// leaving the operation registered.
static inline bool __yo_io_ring_submit_cancel(__yo_io_future_t* target) {
  if (__yo_sq_unsubmitted >= __YO_IO_RING_ENTRIES) return false;
  struct __yo_uring_sqe* sqe = __yo_uring_get_sqe(&__yo_io_ring);
  if (!sqe) return false;
  __yo_uring_prep_cancel(sqe, (void*)target, 0);
  __yo_uring_sqe_set_data(sqe, NULL);
  __yo_sq_deferred_futures[(__yo_sq_deferred_head + __yo_sq_unsubmitted) % __YO_IO_RING_ENTRIES] = NULL;
  __yo_sq_unsubmitted++;
  return true;
}

// Re-arm the wakeup channel's POLL_ADD. One-shot per completion, so every
// drain of the eventfd arms the next one.
static inline void __yo_io_arm_notify(void) {
  if (__yo_notify_efd < 0) return;
  if (__yo_sq_unsubmitted >= __YO_IO_RING_ENTRIES) return;
  struct __yo_uring_sqe* sqe = __yo_uring_get_sqe(&__yo_io_ring);
  if (!sqe) return;
  __yo_uring_prep_poll_add(sqe, __yo_notify_efd, POLLIN);
  __yo_uring_sqe_set_data(sqe, __YO_IO_NOTIFY_UD);
  __yo_sq_deferred_futures[(__yo_sq_deferred_head + __yo_sq_unsubmitted) % __YO_IO_RING_ENTRIES] = NULL;
  __yo_sq_unsubmitted++;
}

// Nudge a loop out of __yo_uring_wait_cqe. Safe from any thread: an eventfd
// write is atomic, and the check and the write run under the loop's mutex so
// they cannot race __yo_io_cleanup's clear+close of the descriptor (see the
// comment there).
// Takes loop->lock, so NO CALLER MAY ALREADY HOLD IT — the mutex is not
// recursive. Every caller lives in runtime_core.yo (__yo_async_blocking_end and
// __yo_waker_post's two paths) and each is deliberately outside the lock;
// __yo_waker_post's notify sits immediately AFTER its unlock for exactly this
// reason. See the invariant note there before moving any of them.
static void __yo_io_notify(__yo_loop_t* loop) {
  if (!loop) {
    return;
  }
  __yo_mutex_lock(&loop->lock);
  if (!loop->notify_ready || loop->notify_fd < 0) {
    __yo_mutex_unlock(&loop->lock);
    return;
  }
  uint64_t one = 1;
  ssize_t w;
  do {
    w = write(loop->notify_fd, &one, sizeof(one));
  } while (w < 0 && errno == EINTR);
  __yo_mutex_unlock(&loop->lock);
  (void)w;
}

// Flush any queued SQEs to the kernel if non-empty. Returns the number
// submitted, or -errno.
// On failure (ret < 0), the SQEs remain in the SQ ring so __yo_sq_unsubmitted
// is left unchanged -- the next submit attempt (via poll/wait) will retry them.
static inline int __yo_io_flush_sq(void) {
  if (__yo_sq_unsubmitted == 0) return 0;
  int ret;
  do {
    ret = __yo_uring_submit(&__yo_io_ring);
  } while (ret == -EINTR);
  if (ret > 0) {
    if ((size_t)ret >= __yo_sq_unsubmitted) {
      __yo_sq_deferred_head = (__yo_sq_deferred_head + __yo_sq_unsubmitted) % __YO_IO_RING_ENTRIES;
      __yo_sq_unsubmitted = 0;
    } else {
      __yo_sq_deferred_head = (__yo_sq_deferred_head + (unsigned)ret) % __YO_IO_RING_ENTRIES;
      __yo_sq_unsubmitted -= (size_t)ret;
    }
  }
  return ret;
}


// Pending operation types (the readiness family; everything else completes
// synchronously in its op start).
typedef enum {
  __YO_EOP_READ,
  __YO_EOP_WRITE,
  __YO_EOP_ACCEPT,
  __YO_EOP_CONNECT,
  __YO_EOP_SEND,
  __YO_EOP_RECV,
  __YO_EOP_SENDTO,
  __YO_EOP_RECVFROM,
} __yo_epoll_op_type;

typedef struct __yo_epoll_pending_t {
  __yo_epoll_op_type op;
  __yo_io_future_t* future;
  union {
    struct { int fd; void* buf; uint32_t size; } read;
    struct { int fd; const void* buf; uint32_t size; } write;
    struct { int fd; void* addr; uint32_t* addrlen; } accept;
    struct { int fd; } connect;
    struct { int fd; const void* buf; size_t len; int flags; } send;
    struct { int fd; void* buf; size_t len; int flags; } recv;
    // The destination is EMBEDDED, not pointed at: the retry happens at
    // delivery time and the caller's address may be gone by then (the ring
    // path makes the same copy inside __yo_dgram_future_t).
    struct { int fd; const void* buf; size_t len; int flags; struct sockaddr_storage dest; uint32_t addrlen; } sendto;
    struct { int fd; void* buf; size_t len; int flags; void* addr; uint32_t* addrlen; } recvfrom;
  };
  struct __yo_epoll_pending_t* next_waiter;
} __yo_epoll_pending_t;

// Free list, same overlay trick as the macOS backend: the first word is the
// next pointer while parked on the list; every allocation site re-fills the
// op, the future, and the whole union arm it uses.
static _Thread_local __yo_epoll_pending_t* __yo_epoll_pending_free = NULL;

static __yo_epoll_pending_t* __yo_epoll_alloc_pending(void) {
  if (__yo_epoll_pending_free) {
    __yo_epoll_pending_t* p = __yo_epoll_pending_free;
    __yo_epoll_pending_free = *(__yo_epoll_pending_t**)p;
    return p;
  }
  return (__yo_epoll_pending_t*)__yo_rc_alloc(sizeof(__yo_epoll_pending_t));
}

static void __yo_epoll_free_pending(__yo_epoll_pending_t* p) {
  if (!p) return;
  *(__yo_epoll_pending_t**)p = __yo_epoll_pending_free;
  __yo_epoll_pending_free = p;
}

// One registration per (fd, direction); epoll_event.data carries this
// pointer. events is EPOLLIN or EPOLLOUT, always level-triggered.
typedef struct __yo_epoll_reg_t {
  int fd;
  uint32_t events;
  __yo_epoll_pending_t* waiters_head;
  __yo_epoll_pending_t* waiters_tail;
  struct __yo_epoll_reg_t* next;
} __yo_epoll_reg_t;

static _Thread_local __yo_epoll_reg_t* __yo_epoll_regs = NULL;
static _Thread_local __yo_epoll_reg_t* __yo_epoll_reg_free = NULL;

static __yo_epoll_reg_t* __yo_epoll_alloc_reg(void) {
  if (__yo_epoll_reg_free) {
    __yo_epoll_reg_t* r = __yo_epoll_reg_free;
    __yo_epoll_reg_free = r->next;
    return r;
  }
  return (__yo_epoll_reg_t*)__yo_rc_alloc(sizeof(__yo_epoll_reg_t));
}

static void __yo_epoll_free_reg(__yo_epoll_reg_t* r) {
  if (!r) return;
  r->next = __yo_epoll_reg_free;
  __yo_epoll_reg_free = r;
}

static void __yo_epoll_release_reg(__yo_epoll_reg_t* reg) {
  __yo_epoll_reg_t** pp = &__yo_epoll_regs;
  while (*pp && *pp != reg) pp = &(*pp)->next;
  if (*pp) *pp = reg->next;
  __yo_epoll_free_reg(reg);
}

// The timer futures currently armed. Registered with the node pointer as
// epoll data, but a cancel arrives holding only the future, so the list is
// how it finds its timerfd. Timers are low-volume; a list is honest about
// that. The future itself stays opaque here — the timer section in the
// common runtime owns its layout (timerfd, read buffer, dispose hook).
typedef struct __yo_epoll_timer_node_t {
  __yo_io_future_t* future;
  int timerfd;
  void* read_buf;
  struct __yo_epoll_timer_node_t* next;
} __yo_epoll_timer_node_t;
static _Thread_local __yo_epoll_timer_node_t* __yo_epoll_timers = NULL;

// Arm one registration with the kernel. A stale interest cannot exist: fds
// are disarmed the moment their waiter list drains and on close, so EEXIST
// is handled defensively with MOD, never silently ignored.
static int __yo_epoll_arm(__yo_epoll_reg_t* reg) {
  struct epoll_event ev;
  memset(&ev, 0, sizeof(ev));
  ev.events = reg->events;
  ev.data.ptr = reg;
  int rc = epoll_ctl(__yo_epoll_fd, EPOLL_CTL_ADD, reg->fd, &ev);
  if (rc < 0 && errno == EEXIST) {
    rc = epoll_ctl(__yo_epoll_fd, EPOLL_CTL_MOD, reg->fd, &ev);
  }
  return rc;
}

static void __yo_epoll_disarm(int fd) {
  struct epoll_event ev;
  memset(&ev, 0, sizeof(ev));
  epoll_ctl(__yo_epoll_fd, EPOLL_CTL_DEL, fd, &ev);
}

static void __yo_epoll_wake(__yo_io_future_t* future) {
  future->state = -1;
  void (*cont_fn)(void*) = future->continuation_fn;
  void* cont_sm = future->continuation_sm;
  if (cont_fn && cont_sm) {
    __yo_async_spawn_task(cont_fn, cont_sm);
  }
}

// Park one op on a (fd, events) registration, creating and arming the
// registration on first use. Returns the pending for the CALLER to fill (the
// union arm), or NULL when arming failed. Takes the reference the
// registration holds (the ring's __yo_io_ring_submit has the same contract)
// and the pending-I/O slot.
static __yo_epoll_pending_t* __yo_epoll_park(__yo_epoll_op_type op,
                                             __yo_io_future_t* future,
                                             uint32_t events, int fd) {
  __yo_epoll_reg_t* reg = __yo_epoll_regs;
  while (reg && !(reg->fd == fd && reg->events == events)) reg = reg->next;
  bool first = false;
  if (!reg) {
    reg = __yo_epoll_alloc_reg();
    if (!reg) return NULL;
    reg->fd = fd;
    reg->events = events;
    reg->waiters_head = NULL;
    reg->waiters_tail = NULL;
    reg->next = __yo_epoll_regs;
    __yo_epoll_regs = reg;
    first = true;
    if (__yo_epoll_arm(reg) < 0) {
      __yo_epoll_release_reg(reg);
      return NULL;
    }
  }
  __yo_epoll_pending_t* pending = __yo_epoll_alloc_pending();
  if (!pending) {
    if (first) {
      __yo_epoll_disarm(fd);
      __yo_epoll_release_reg(reg);
    }
    return NULL;
  }
  pending->op = op;
  pending->future = future;
  pending->next_waiter = NULL;
  if (reg->waiters_tail) {
    reg->waiters_tail->next_waiter = pending;
  } else {
    reg->waiters_head = pending;
  }
  reg->waiters_tail = pending;
  future->header.ref_count++;
  __yo_pending_io_count++;
  return pending;
}

// Complete a parked waiter: release the loop's pending-I/O slot, wake the
// continuation, drop the reference the registration held — the same
// sequence the ring's CQE path runs (count, wake, decr).
static void __yo_epoll_finish(__yo_epoll_pending_t* pending) {
  __yo_pending_io_count--;
  __yo_epoll_wake(pending->future);
  __yo_decr_rc((void*)pending->future);
  __yo_epoll_free_pending(pending);
}

// Service a delivered registration: walk waiters FIFO, retrying each op
// until one would block (a spurious wakeup, or an earlier waiter consuming
// the readiness). Level-triggered epoll keeps the registration reported
// while readiness persists, so a would-block waiter simply stays parked —
// no re-arm. When the list drains, disarm and release: a registration with
// no waiters must never stay armed.
static void __yo_epoll_process_reg(__yo_epoll_reg_t* reg) {
  while (reg->waiters_head) {
    __yo_epoll_pending_t* pending = reg->waiters_head;
    bool would_block = false;
    switch (pending->op) {
      case __YO_EOP_READ: {
        ssize_t r = read(pending->read.fd, pending->read.buf, pending->read.size);
        if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
          pending->future->result = (r < 0) ? -errno : (int32_t)r;
        } else {
          would_block = true;
        }
        break;
      }
      case __YO_EOP_WRITE: {
        ssize_t r = write(pending->write.fd, pending->write.buf, pending->write.size);
        if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
          pending->future->result = (r < 0) ? -errno : (int32_t)r;
        } else {
          would_block = true;
        }
        break;
      }
      case __YO_EOP_ACCEPT: {
        int r = accept(pending->accept.fd, (struct sockaddr*)pending->accept.addr,
                       (socklen_t*)pending->accept.addrlen);
        if (r >= 0) {
          // POSIX accept(2) does not give the accepted socket the listener's
          // O_NONBLOCK; every socket this runtime creates is nonblocking, so
          // keep the accepted fd the same (the ring CQE path does this too).
          int fl = fcntl(r, F_GETFL, 0);
          if (fl >= 0) fcntl(r, F_SETFL, fl | O_NONBLOCK);
          pending->future->result = r;
        } else if (errno == EAGAIN || errno == EWOULDBLOCK) {
          would_block = true;
        } else {
          pending->future->result = -errno;
        }
        break;
      }
      case __YO_EOP_CONNECT: {
        // Connect readiness is terminal: the SO_ERROR answer never
        // would-blocks, so every queued connect completes on this delivery.
        int so_error = 0;
        socklen_t len = sizeof(so_error);
        getsockopt(pending->connect.fd, SOL_SOCKET, SO_ERROR, &so_error, &len);
        pending->future->result = (so_error == 0) ? 0 : -so_error;
        break;
      }
      case __YO_EOP_SEND: {
        ssize_t r = send(pending->send.fd, pending->send.buf, pending->send.len,
                         pending->send.flags);
        if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
          pending->future->result = (r < 0) ? -errno : (int32_t)r;
        } else {
          would_block = true;
        }
        break;
      }
      case __YO_EOP_RECV: {
        ssize_t r = recv(pending->recv.fd, pending->recv.buf, pending->recv.len,
                         pending->recv.flags);
        if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
          pending->future->result = (r < 0) ? -errno : (int32_t)r;
        } else {
          would_block = true;
        }
        break;
      }
      case __YO_EOP_SENDTO: {
        ssize_t r = sendto(pending->sendto.fd, pending->sendto.buf, pending->sendto.len,
                           pending->sendto.flags,
                           (const struct sockaddr*)&pending->sendto.dest,
                           (socklen_t)pending->sendto.addrlen);
        if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
          pending->future->result = (r < 0) ? -errno : (int32_t)r;
        } else {
          would_block = true;
        }
        break;
      }
      case __YO_EOP_RECVFROM: {
        ssize_t r = recvfrom(pending->recvfrom.fd, pending->recvfrom.buf, pending->recvfrom.len,
                             pending->recvfrom.flags,
                             (struct sockaddr*)pending->recvfrom.addr,
                             (socklen_t*)pending->recvfrom.addrlen);
        if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
          pending->future->result = (r < 0) ? -errno : (int32_t)r;
        } else {
          would_block = true;
        }
        break;
      }
    }
    if (would_block) break;
    reg->waiters_head = pending->next_waiter;
    if (!reg->waiters_head) reg->waiters_tail = NULL;
    __yo_epoll_finish(pending);
  }
  if (!reg->waiters_head) {
    __yo_epoll_disarm(reg->fd);
    __yo_epoll_release_reg(reg);
  }
}

// The eventfd wake channel fired: drain it (level-triggered would keep
// reporting otherwise). The wake itself is picked up by
// __yo_async_drain_xwakes at the top of the next tick — identical contract
// to the ring backend's NOTIFY UD CQE.
static void __yo_epoll_process_notify(void) {
  uint64_t v;
  while (read(__yo_notify_efd, &v, sizeof(v)) == (ssize_t)sizeof(v)) {
  }
}

// A timerfd fired: perform the 8-byte read the ring backend submits as an
// IORING_OP_READ and complete the future with the same result shape (8 on
// success). The future's dispose hook (registered by the timer section in
// the common runtime) closes the timerfd and frees the buffer.
static void __yo_epoll_process_timer(__yo_epoll_timer_node_t* node) {
  __yo_epoll_disarm(node->timerfd);
  __yo_epoll_timer_node_t** pp = &__yo_epoll_timers;
  while (*pp && *pp != node) pp = &(*pp)->next;
  if (*pp) *pp = node->next;
  __yo_io_future_t* future = node->future;
  // Delivery destroys the only registration naming this timer: the future
  // is no longer cancellable.
  future->cancel_fn = NULL;
  ssize_t r = read(node->timerfd, node->read_buf, sizeof(uint64_t));
  future->result = (r < 0) ? -errno : (int32_t)r;
  __yo_pending_io_count--;
  __yo_epoll_wake(future);
  __yo_decr_rc((void*)future);
  __yo_free(node);
}

// Abort one parked op: search the registrations' waiter lists and the timer
// list for this future. The found waiter completes with -ECANCELED, exactly
// what a cancelled ring op's CQE reports.
static bool __yo_epoll_cancel(__yo_io_future_t* future) {
  __yo_epoll_reg_t* reg = __yo_epoll_regs;
  while (reg) {
    __yo_epoll_pending_t* p = reg->waiters_head;
    __yo_epoll_pending_t** prev = &reg->waiters_head;
    while (p) {
      if (p->future == future) {
        *prev = p->next_waiter;
        if (reg->waiters_tail == p) {
          if (!reg->waiters_head) {
            reg->waiters_tail = NULL;
          } else {
            __yo_epoll_pending_t* t = reg->waiters_head;
            while (t->next_waiter) t = t->next_waiter;
            reg->waiters_tail = t;
          }
        }
        future->result = -ECANCELED;
        __yo_epoll_finish(p);
        if (!reg->waiters_head) {
          __yo_epoll_disarm(reg->fd);
          __yo_epoll_release_reg(reg);
        }
        return true;
      }
      prev = &p->next_waiter;
      p = p->next_waiter;
    }
    reg = reg->next;
  }
  __yo_epoll_timer_node_t* tn = __yo_epoll_timers;
  while (tn) {
    if (tn->future == future) {
      __yo_epoll_disarm(tn->timerfd);
      __yo_epoll_timer_node_t** pp = &__yo_epoll_timers;
      while (*pp && *pp != tn) pp = &(*pp)->next;
      if (*pp) *pp = tn->next;
      future->cancel_fn = NULL;
      future->result = -ECANCELED;
      __yo_pending_io_count--;
      __yo_epoll_wake(future);
      __yo_decr_rc((void*)future);
      __yo_free(tn);
      return true;
    }
    tn = tn->next;
  }
  return false;
}

// An fd is about to be closed: fail its waiters with -EBADF and disarm. The
// kernel auto-drops the epoll interest when the last descriptor closes, but
// a parked waiter would then never be delivered. Also stops a reused fd
// number from colliding with a stale registration.
static void __yo_epoll_drop_fd(int fd) {
  __yo_epoll_reg_t** pp = &__yo_epoll_regs;
  while (*pp) {
    __yo_epoll_reg_t* reg = *pp;
    if (reg->fd == fd) {
      *pp = reg->next;
      __yo_epoll_pending_t* p = reg->waiters_head;
      while (p) {
        __yo_epoll_pending_t* next = p->next_waiter;
        p->future->result = -EBADF;
        __yo_epoll_finish(p);
        p = next;
      }
      __yo_epoll_disarm(fd);
      __yo_epoll_free_reg(reg);
      continue;  // read and write registrations can both be alive for one fd
    }
    pp = &reg->next;
  }
}

// --- Future helpers ---------------------------------------------------------

static __yo_io_future_t* __yo_epoll_new_future(void) {
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  return future;
}

// The DEGRADED rung and the sync-completion family share this: a future
// that is already done carrying result.
static __yo_io_future_t* __yo_epoll_done_future(int32_t result) {
  __yo_io_future_t* future = __yo_epoll_new_future();
  future->result = result;
  future->state = -1;
  return future;
}

// --- The loop drivers --------------------------------------------------------

// One epoll_wait pass plus dispatch. timeout_ms follows epoll_wait (0 =
// non-blocking, -1 = block). The wake channel is registered with the
// sentinel (void*)-1, which no heap object can be.
static void __yo_epoll_drive(int timeout_ms, int* count_out) {
  struct epoll_event events[64];
  int n;
  __yo_stats_kernel_enters++;
  if (timeout_ms == 0) __yo_stats_zero_timeout_enters++;
  do {
    n = epoll_wait(__yo_epoll_fd, events, 64, timeout_ms);
  } while (n < 0 && errno == EINTR);
  int count = 0;
  for (int i = 0; i < n; i++) {
    if (events[i].data.ptr == (void*)(intptr_t)-1) {
      __yo_epoll_process_notify();
      continue;
    }
    __yo_epoll_reg_t* reg = __yo_epoll_regs;
    __yo_epoll_reg_t* found_reg = NULL;
    __yo_epoll_timer_node_t* found_timer = NULL;
    while (reg && !found_reg) {
      if ((void*)reg == events[i].data.ptr) found_reg = reg;
      reg = reg->next;
    }
    if (!found_reg) {
      __yo_epoll_timer_node_t* tn = __yo_epoll_timers;
      while (tn) {
        if ((void*)tn == events[i].data.ptr) {
          found_timer = tn;
          break;
        }
        tn = tn->next;
      }
    }
    if (found_timer) {
      __yo_epoll_process_timer(found_timer);
      count++;
    } else if (found_reg) {
      __yo_epoll_process_reg(found_reg);
      count++;
    }
    // An unknown data.ptr cannot happen: every registration is disarmed
    // before it is released. If it ever did, ignoring the event is the safe
    // answer (the loop re-checks its own counters).
  }
  *count_out = count;
}

// --- Op twins ----------------------------------------------------------------
// Each mirrors its ring op start's signature and completion shape. Regular
// files and the ops epoll cannot express complete synchronously in the
// future — macOS's documented behavior (runtime_io_macos.yo), which is the
// platform floor this fallback deliberately matches.

static __yo_io_future_t* __yo_epoll_read_start(int32_t fd, void* buffer, uint32_t size, uint64_t offset) {
  struct stat st;
  bool is_regular = false;
  if (fstat(fd, &st) == 0) {
    is_regular = S_ISREG(st.st_mode) || S_ISBLK(st.st_mode);
  }
  if (is_regular) {
    ssize_t r = pread(fd, buffer, size, (off_t)offset);
    return __yo_epoll_done_future((r < 0) ? -errno : (int32_t)r);
  }
  ssize_t r = read(fd, buffer, size);
  if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
    return __yo_epoll_done_future((r < 0) ? -errno : (int32_t)r);
  }
  __yo_io_future_t* future = __yo_epoll_new_future();
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_READ, future, EPOLLIN, fd);
  if (!p) {
    future->result = -EAGAIN;
    future->state = -1;
    return future;
  }
  p->read.fd = fd;
  p->read.buf = buffer;
  p->read.size = size;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

static __yo_io_future_t* __yo_epoll_write_start(int32_t fd, const void* buffer, uint32_t size, uint64_t offset) {
  struct stat st;
  bool is_regular = false;
  if (fstat(fd, &st) == 0) {
    is_regular = S_ISREG(st.st_mode) || S_ISBLK(st.st_mode);
  }
  if (is_regular) {
    // For O_APPEND fds use write(), which respects the append flag.
    int fl = fcntl(fd, F_GETFL);
    ssize_t w;
    if (fl != -1 && (fl & O_APPEND)) {
      w = write(fd, buffer, size);
    } else {
      w = pwrite(fd, buffer, size, (off_t)offset);
    }
    return __yo_epoll_done_future((w < 0) ? -errno : (int32_t)w);
  }
  ssize_t r = write(fd, buffer, size);
  if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
    return __yo_epoll_done_future((r < 0) ? -errno : (int32_t)r);
  }
  __yo_io_future_t* future = __yo_epoll_new_future();
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_WRITE, future, EPOLLOUT, fd);
  if (!p) {
    future->result = -EAGAIN;
    future->state = -1;
    return future;
  }
  p->write.fd = fd;
  p->write.buf = buffer;
  p->write.size = size;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

static __yo_io_future_t* __yo_epoll_openat_start(int32_t dirfd, const char* path, int32_t flags, int32_t mode) {
  int r = openat(dirfd, path, flags, (mode_t)mode);
  return __yo_epoll_done_future((r < 0) ? -errno : r);
}

static __yo_io_future_t* __yo_epoll_close_start(int32_t fd) {
  __yo_epoll_drop_fd(fd);
  int r = close(fd);
  return __yo_epoll_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_epoll_statx_start(int32_t dirfd, const char* path, int32_t flags, uint32_t mask, void* statxbuf) {
  int r = statx(dirfd, path, flags, mask, (struct statx*)statxbuf);
  return __yo_epoll_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_epoll_mkdirat_start(int32_t dirfd, const char* path, int32_t mode) {
  int r = mkdirat(dirfd, path, (mode_t)mode);
  return __yo_epoll_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_epoll_unlinkat_start(int32_t dirfd, const char* path, int32_t flags) {
  int r = unlinkat(dirfd, path, flags);
  return __yo_epoll_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_epoll_renameat_start(int32_t olddirfd, const char* oldpath, int32_t newdirfd, const char* newpath) {
  int r = renameat(olddirfd, oldpath, newdirfd, newpath);
  return __yo_epoll_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_epoll_symlinkat_start(const char* target, int32_t newdirfd, const char* linkpath) {
  int r = symlinkat(target, newdirfd, linkpath);
  return __yo_epoll_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_epoll_linkat_start(int32_t olddirfd, const char* oldpath, int32_t newdirfd, const char* newpath, int32_t flags) {
  int r = linkat(olddirfd, oldpath, newdirfd, newpath, flags);
  return __yo_epoll_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_epoll_fsync_start(int32_t fd) {
  int r = fsync(fd);
  return __yo_epoll_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_epoll_fdatasync_start(int32_t fd) {
  int r = fdatasync(fd);
  return __yo_epoll_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_epoll_ftruncate_start(int32_t fd, int64_t length) {
  int r = ftruncate(fd, (off_t)length);
  return __yo_epoll_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_epoll_accept_start(int32_t sockfd, void* addr, uint32_t* addrlen) {
  int r = accept(sockfd, (struct sockaddr*)addr, (socklen_t*)addrlen);
  if (r >= 0) {
    int fl = fcntl(r, F_GETFL, 0);
    if (fl >= 0) fcntl(r, F_SETFL, fl | O_NONBLOCK);
    return __yo_epoll_done_future(r);
  }
  if (errno != EAGAIN && errno != EWOULDBLOCK) {
    return __yo_epoll_done_future(-errno);
  }
  __yo_io_future_t* future = __yo_epoll_new_future();
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_ACCEPT, future, EPOLLIN, sockfd);
  if (!p) {
    future->result = -EAGAIN;
    future->state = -1;
    return future;
  }
  p->accept.fd = sockfd;
  p->accept.addr = addr;
  p->accept.addrlen = addrlen;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

static __yo_io_future_t* __yo_epoll_connect_start(int32_t sockfd, const void* addr, uint32_t addrlen) {
  int r = connect(sockfd, (const struct sockaddr*)addr, (socklen_t)addrlen);
  if (r == 0) {
    return __yo_epoll_done_future(0);
  }
  if (errno != EINPROGRESS && errno != EAGAIN && errno != EWOULDBLOCK) {
    return __yo_epoll_done_future(-errno);
  }
  __yo_io_future_t* future = __yo_epoll_new_future();
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_CONNECT, future, EPOLLOUT, sockfd);
  if (!p) {
    future->result = -EAGAIN;
    future->state = -1;
    return future;
  }
  p->connect.fd = sockfd;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

static __yo_io_future_t* __yo_epoll_send_start(int32_t sockfd, const void* buf, size_t len, int32_t flags) {
  ssize_t r = send(sockfd, buf, len, flags);
  if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
    return __yo_epoll_done_future((r < 0) ? -errno : (int32_t)r);
  }
  __yo_io_future_t* future = __yo_epoll_new_future();
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_SEND, future, EPOLLOUT, sockfd);
  if (!p) {
    future->result = -EAGAIN;
    future->state = -1;
    return future;
  }
  p->send.fd = sockfd;
  p->send.buf = buf;
  p->send.len = len;
  p->send.flags = flags;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

static __yo_io_future_t* __yo_epoll_recv_start(int32_t sockfd, void* buf, size_t len, int32_t flags) {
  ssize_t r = recv(sockfd, buf, len, flags);
  if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
    return __yo_epoll_done_future((r < 0) ? -errno : (int32_t)r);
  }
  __yo_io_future_t* future = __yo_epoll_new_future();
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_RECV, future, EPOLLIN, sockfd);
  if (!p) {
    future->result = -EAGAIN;
    future->state = -1;
    return future;
  }
  p->recv.fd = sockfd;
  p->recv.buf = buf;
  p->recv.len = len;
  p->recv.flags = flags;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

// The datagram twins take over AFTER the shared inline fast path reports
// would-block — the same point the ring path arms SENDMSG/RECVMSG.
static __yo_io_future_t* __yo_epoll_sendto_park(int32_t sockfd, const void* buf, size_t len, int32_t flags,
                                                const void* dest_addr, uint32_t addrlen,
                                                __yo_io_future_t* future) {
  if (addrlen > sizeof(struct sockaddr_storage)) {
    future->result = -EINVAL;
    future->state = -1;
    return future;
  }
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_SENDTO, future, EPOLLOUT, sockfd);
  if (!p) {
    future->result = -EAGAIN;
    future->state = -1;
    return future;
  }
  p->sendto.fd = sockfd;
  p->sendto.buf = buf;
  p->sendto.len = len;
  p->sendto.flags = flags;
  memcpy(&p->sendto.dest, dest_addr, addrlen);
  p->sendto.addrlen = addrlen;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

static __yo_io_future_t* __yo_epoll_recvfrom_park(int32_t sockfd, void* buf, size_t len, int32_t flags,
                                                  void* src_addr, uint32_t* addrlen,
                                                  __yo_io_future_t* future) {
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_RECVFROM, future, EPOLLIN, sockfd);
  if (!p) {
    future->result = -EAGAIN;
    future->state = -1;
    return future;
  }
  p->recvfrom.fd = sockfd;
  p->recvfrom.buf = buf;
  p->recvfrom.len = len;
  p->recvfrom.flags = flags;
  p->recvfrom.addr = src_addr;
  p->recvfrom.addrlen = addrlen;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

// The timer arm, called by the common runtime's Linux sleep path after the
// timerfd is created and set. The node (not the future) is the epoll data:
// a cancel arrives holding only the future and finds the node through the
// timer list.
static void __yo_epoll_sleep_arm(__yo_io_future_t* future, int timerfd, void* read_buf) {
  __yo_epoll_timer_node_t* node = (__yo_epoll_timer_node_t*)__yo_rc_alloc(sizeof(__yo_epoll_timer_node_t));
  if (!node) {
    future->result = -ENOMEM;
    future->state = -1;
    return;
  }
  node->future = future;
  node->timerfd = timerfd;
  node->read_buf = read_buf;
  node->next = __yo_epoll_timers;
  __yo_epoll_timers = node;
  struct epoll_event ev;
  memset(&ev, 0, sizeof(ev));
  ev.events = EPOLLIN;
  ev.data.ptr = node;
  if (epoll_ctl(__yo_epoll_fd, EPOLL_CTL_ADD, timerfd, &ev) < 0) {
    __yo_epoll_timers = node->next;
    future->result = -errno;
    future->state = -1;
    __yo_free(node);
    return;
  }
  future->cancel_fn = __yo_epoll_cancel;
  future->header.ref_count++;
  __yo_pending_io_count++;
}

// Teardown for __yo_io_cleanup: fail everything still parked with
// -ECANCELED (a closed epoll fd would silently drop their interests), then
// release the epoll descriptor. The pending count is zeroed so a re-init
// does not inherit a permanently-pending number. The free lists stay: their
// nodes are rc-allocated and pooled like every other runtime node.
static void __yo_epoll_teardown(void) {
  __yo_epoll_reg_t* reg = __yo_epoll_regs;
  while (reg) {
    __yo_epoll_reg_t* rnext = reg->next;
    __yo_epoll_pending_t* pw = reg->waiters_head;
    while (pw) {
      __yo_epoll_pending_t* nx = pw->next_waiter;
      pw->future->result = -ECANCELED;
      pw->future->state = -1;
      __yo_pending_io_count--;
      __yo_decr_rc((void*)pw->future);
      __yo_epoll_free_pending(pw);
      pw = nx;
    }
    __yo_epoll_disarm(reg->fd);
    __yo_epoll_free_reg(reg);
    reg = rnext;
  }
  __yo_epoll_regs = NULL;
  __yo_epoll_timer_node_t* tn = __yo_epoll_timers;
  while (tn) {
    __yo_epoll_timer_node_t* tnext = tn->next;
    tn->future->cancel_fn = NULL;
    tn->future->result = -ECANCELED;
    tn->future->state = -1;
    __yo_pending_io_count--;
    __yo_decr_rc((void*)tn->future);
    __yo_free(tn);
    tn = tnext;
  }
  __yo_epoll_timers = NULL;
  __yo_pending_io_count = 0;
  close(__yo_epoll_fd);
  __yo_epoll_fd = -1;
}

// Extended future for the datagram ops (sendto/recvfrom). __YO_IORING_OP_SENDMSG/
// RECVMSG take a struct msghdr that must remain valid until the CQE is reaped
// (the kernel reads the iovec and the destination address lazily, and RECVMSG
// WRITES msg_name/msg_namelen at completion time), so the msghdr, the iovec
// and — for sendto — a copy of the destination address live in the same
// allocation as the future and are freed with it.
typedef struct {
  __yo_io_future_t base;
  struct msghdr msg;
  struct iovec iov;
  struct sockaddr_storage dest;  // sendto: the destination address copy
  uint32_t* addrlen_out;         // recvfrom: caller's in/out length, written at CQE
} __yo_dgram_future_t;

// Ring cancellation for a datagram future. Also serves as its TYPE TAG:
// __yo_io_process_cqe compares cancel_fn against this function to learn that
// the completion path may read the __yo_dgram_future_t extension — only
// futures allocated with that shape carry it.
static bool __yo_dgram_future_cancel(__yo_io_future_t* future) {
  return __yo_io_ring_submit_cancel(future);
}

// Ring cancellation for an accept future — same tag idea; process_cqe uses it
// to fix up the ACCEPTED socket's flags (see __yo_async_accept_start).
static bool __yo_accept_future_cancel(__yo_io_future_t* future) {
  return __yo_io_ring_submit_cancel(future);
}

// Process completions from CQ
// The future pointer is stored directly in the SQE user data
static void __yo_io_process_cqe(struct __yo_uring_cqe* cqe) {
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_uring_cqe_get_data(cqe);
  if ((void*)future == __YO_IO_NOTIFY_UD) {
    // The wakeup channel fired. It carries no operation — draining the
    // eventfd and re-arming is all there is to do; the foreign wake itself is
    // picked up by __yo_async_drain_xwakes at the top of the next tick.
    uint64_t v;
    while (__yo_notify_efd >= 0 && read(__yo_notify_efd, &v, sizeof(v)) == (ssize_t)sizeof(v)) {
    }
    __yo_uring_cqe_seen(&__yo_io_ring, cqe);
    __yo_io_arm_notify();
    return;
  }
  if (!future) {
    // Completion of a cancellation SQE (__yo_io_ring_submit_cancel): it owns
    // no future and no pending-I/O slot. The cancelled operation reports
    // separately, through its own CQE.
    __yo_uring_cqe_seen(&__yo_io_ring, cqe);
    return;
  }
  __yo_pending_io_count--;

  // Set the result
  future->result = cqe->res;
  
  ASYNC_DEBUG("[Io] Completed I/O: result=%d (pending=%zu)\\n",
              future->result, __yo_pending_io_count);
  
  // Mark as completed (state -1 = done)
  future->state = -1;

  // Post-completion op hooks, BEFORE the continuation runs so a resumed task
  // observes them. cancel_fn identity is each op's type tag (see the
  // __yo_dgram_future_cancel comment) — only futures allocated with the
  // matching shape reach their case, so the extension reads stay inside their
  // allocations.
  if (future->cancel_fn == __yo_dgram_future_cancel) {
    // RECVMSG wrote the sender's address into the caller's buffer and its
    // length into our msghdr; hand the length to the caller's in/out pointer,
    // which is what recvfrom(2) would have done synchronously.
    __yo_dgram_future_t* df = (__yo_dgram_future_t*)future;
    if (df->addrlen_out) {
      *df->addrlen_out = (uint32_t)df->msg.msg_namelen;
    }
  }
  if (future->cancel_fn == __yo_accept_future_cancel && future->result >= 0) {
    // POSIX accept(2) does not give the accepted socket the listener's
    // O_NONBLOCK (Linux ignores CLOEXEC/NONBLOCK inheritance for accept),
    // and every socket this runtime creates is nonblocking — keep the
    // accepted fd the same so the would-block fast paths below (and any
    // future one) can never block the loop thread.
    int fl = fcntl(future->result, F_GETFL, 0);
    if (fl >= 0) fcntl(future->result, F_SETFL, fl | O_NONBLOCK);
  }

  // Wake continuation if registered
  void (*cont_fn)(void*) = future->continuation_fn;
  void* cont_sm = future->continuation_sm;
  
  ASYNC_DEBUG("[Io] Continuation check: cont_fn=%p, cont_sm=%p\\n", (void*)cont_fn, cont_sm);
  
  if (cont_fn && cont_sm) {
    ASYNC_DEBUG("[Io] Spawning continuation for I/O completion\\n");
    __yo_async_spawn_task(cont_fn, cont_sm);
  }

  __yo_uring_cqe_seen(&__yo_io_ring, cqe);
  
  // Release the io_uring event loop reference.
  // This must be AFTER __yo_uring_cqe_seen and AFTER reading all future fields,
  // because decr_rc may free the future if user already dropped their ref.
  __yo_decr_rc((void*)future);
}

// Poll for I/O completions (non-blocking)
static int __yo_io_poll(void) {
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    int n;
    __yo_epoll_drive(0, &n);
    return n + __yo_poll_and_fs_event_tick();
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_poll_and_fs_event_tick();
  }
  // No ring yet: nothing was submitted, so nothing can complete.
  if (!__yo_io_initialized) {
    return __yo_poll_and_fs_event_tick();
  }
  // Flush any queued SQEs so their completions can be reaped.
  __yo_io_flush_sq();

  // The ring runs with __YO_IORING_SETUP_DEFER_TASKRUN (see __yo_io_init): the
  // kernel materialises completions only when this thread enters it with
  // __YO_IORING_ENTER_GETEVENTS. A pure-userspace peek therefore never sees a
  // timer or socket complete while some task is always ready and the loop
  // never reaches __yo_io_wait — a poll-until-finished race spun forever on
  // Linux while macOS (kqueue always syscalls) was fine
  // (issues/fixed/io-uring-defer-taskrun-poll-never-enters-kernel.md).
  // A zero-timeout wait is that non-blocking enter; it consumes nothing.
  {
    (void)__yo_uring_getevents(&__yo_io_ring);
  }

  struct __yo_uring_cqe* cqes[64];
  int count = 0;

  unsigned n;
  while ((n = __yo_uring_peek_batch_cqe(&__yo_io_ring, cqes, 64)) > 0) {
    for (unsigned i = 0; i < n; ++i) {
      __yo_io_process_cqe(cqes[i]);
      count++;
    }
    if (n < 64) break;
  }

  // Also tick poll/fs_event handles
  count += __yo_poll_and_fs_event_tick();

  if (count > 0) {
    ASYNC_DEBUG("[Io] Polled %d completions\\n", count);
  }
  return count;
}

// Wait for at least one I/O completion (blocking)
static int __yo_io_wait(void) {
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    if (__yo_pending_io_count == 0 && __yo_active_watch_count > 0) {
      struct timespec ts = {0, 10 * 1000 * 1000};
      nanosleep(&ts, NULL);
      return __yo_poll_and_fs_event_tick();
    }
    int n;
    __yo_epoll_drive(-1, &n);
    return n;
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    if (__yo_active_watch_count > 0) {
      struct timespec ts = {0, 10 * 1000 * 1000};
      nanosleep(&ts, NULL);
      return __yo_poll_and_fs_event_tick();
    }
    return 0;
  }
  // If only poll/fs_event watches are pending (no io_uring ops), use a short sleep
  if (__yo_pending_io_count == 0 && __yo_active_watch_count > 0) {
    struct timespec ts = {0, 10 * 1000 * 1000}; // 10ms
    nanosleep(&ts, NULL);
    return __yo_poll_and_fs_event_tick();
  }

  // No ring: nothing was submitted, so the only thing to wait for is a wake
  // (a foreign waker's post, or a blocking call ending). Block on the eventfd.
  // The first wait only creates it and returns, so the loop re-checks before
  // blocking (see __yo_io_notify_init). Without an eventfd there is no other
  // way to be woken: fall back to the ring, which waits on its own CQEs.
  if (!__yo_io_initialized) {
    if (__yo_notify_efd < 0) {
      __yo_io_notify_init();
      if (__yo_notify_efd < 0) {
        __yo_io_init();
      }
      return 0;
    }
    struct pollfd pfd;
    pfd.fd = __yo_notify_efd;
    pfd.events = POLLIN;
    pfd.revents = 0;
    int pr;
    do {
      pr = poll(&pfd, 1, -1);
    } while (pr < 0 && errno == EINTR);
    uint64_t v;
    while (read(__yo_notify_efd, &v, sizeof(v)) == (ssize_t)sizeof(v)) {
    }
    return 0;
  }

  // With no I/O outstanding but a blocking call running on another thread, the
  // wait below is a wait on the wakeup channel alone — which is what the loop
  // should be doing rather than spinning.
  struct __yo_uring_cqe* cqe;
  // Combined submit + wait in a single syscall -- this is the main batching win:
  // all deferred SQEs are submitted alongside the blocking wait for a CQE.
  int ret;
  if (__yo_sq_unsubmitted > 0) {
    do {
      ret = __yo_uring_submit_and_wait(&__yo_io_ring, 1);
    } while (ret == -EINTR);
    if (ret < 0) {
      // SQEs remain in the SQ ring; do not drop __yo_sq_unsubmitted so the
      // next poll/wait retries them.
      ASYNC_DEBUG("[Io] WARNING: __yo_uring_submit_and_wait failed: %d\\n", ret);
      return 0;
    }
    // ret >= 0: that many SQEs were submitted.
    if ((size_t)ret >= __yo_sq_unsubmitted) {
      __yo_sq_deferred_head = (__yo_sq_deferred_head + __yo_sq_unsubmitted) % __YO_IO_RING_ENTRIES;
      __yo_sq_unsubmitted = 0;
    } else {
      __yo_sq_deferred_head = (__yo_sq_deferred_head + (unsigned)ret) % __YO_IO_RING_ENTRIES;
      __yo_sq_unsubmitted -= (size_t)ret;
    }
    // After submit_and_wait, at least one CQE should be available; peek it.
    if (__yo_uring_peek_cqe(&__yo_io_ring, &cqe) != 0) {
      // Rare: spurious wake. Fall back to explicit wait.
      if (__yo_uring_wait_cqe(&__yo_io_ring, &cqe) < 0) return 0;
    }
  } else {
    ret = __yo_uring_wait_cqe(&__yo_io_ring, &cqe);
    if (ret < 0) {
      ASYNC_DEBUG("[Io] WARNING: __yo_uring_wait_cqe failed: %d\\n", ret);
      return 0;
    }
  }

  ASYNC_DEBUG("[Io] Waiting for I/O completion...\\n");
  __yo_io_process_cqe(cqe);
  return 1 + __yo_io_poll();  // Process any additional completions
}

// Create and start an async read operation
// Returns a __yo_io_future_t* that completes when the read finishes
static __yo_io_future_t* __yo_async_read_start(int32_t fd, void* buffer, uint32_t size, uint64_t offset) {
  // Ensure io_uring is initialized (lazy initialization for eager async execution)
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_epoll_read_start(fd, buffer, size, offset);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_epoll_done_future(-__yo_backend_errno);
  }
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));  // Zero-initialize all fields
  
  // Initialize ref counting
  future->header.ref_count = 1;
  
  // Initialize future state
  future->state = 0;  // 0 = pending
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  // Submit to io_uring
  struct __yo_uring_sqe* sqe = __yo_uring_get_sqe(&__yo_io_ring);
  if (!sqe) {
    // Queue full
    future->result = -EAGAIN;
    future->state = -1;  // Mark as completed
    ASYNC_DEBUG("[Io] WARNING: io_uring SQ full, returning EAGAIN\\n");
    return future;
  }
  
  __yo_uring_prep_read(sqe, fd, buffer, (unsigned)size, (int64_t)offset);
  __yo_uring_sqe_set_data(sqe, future);  // Store future pointer directly
  __yo_io_ring_submit(future);
  
  ASYNC_DEBUG("[Io] Started async read: fd=%d buffer=%p size=%u offset=%llu (pending=%zu)\\n",
              fd, buffer, size, (unsigned long long)offset, __yo_pending_io_count);
  
  return future;
}

// Create and start an async write operation
// Returns a __yo_io_future_t* that completes when the write finishes
static __yo_io_future_t* __yo_async_write_start(int32_t fd, const void* buffer, uint32_t size, uint64_t offset) {
  // Ensure io_uring is initialized (lazy initialization for eager async execution)
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_epoll_write_start(fd, buffer, size, offset);
  }
