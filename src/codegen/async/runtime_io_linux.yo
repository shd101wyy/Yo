//! runtime_io_linux — Linux platform sync helpers + io_uring async I/O runtime.
//! C bodies verbatim (extracted, pure C, no interpolations/backticks).
//! Wired in by the runtime.yo dispatcher.
import("std/string");
{ Emitter } :: import("../../emitter.yo");
/// Emit Linux platform-specific SYNC helpers.
generate_platform_sys_runtime_linux :: (fn(emitter : Emitter) -> unit)({
  emitter.emit_string_line(
    `
// ============================================================================
// Platform-specific sync helpers (Linux)
// ============================================================================

#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <sys/utsname.h>
#include <sys/mman.h>
#include <sys/file.h>
#include <sys/uio.h>
#include <time.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <netinet/tcp.h>
#include <arpa/inet.h>
#include <sys/un.h>

// ============================================================================
// Synchronous FD Operations (Linux) - no IoFuture overhead
// ============================================================================

// Installed by the backend's init (per thread — each loop thread picks its
// own backend): before a descriptor goes away, end the async operations
// still pending on it, so their waiters wake with -EBADF instead of
// outliving the fd, and a reused fd number cannot collide with a stale
// registration. epoll purges its parked waiters (__yo_epoll_drop_fd); the
// ring must CANCEL its requests (__yo_ring_drop_fd) — a ring request holds
// its own file reference, so closing the fd alone does not end it. Every
// runtime path that ends a descriptor calls it: __yo_file_close, the async
// close, and dup2 over an open fd.
static _Thread_local void (*__yo_io_close_hook)(int32_t) = NULL;

static int32_t __yo_sync_pipe(int32_t* pipefd) {
  int result = pipe((int*)pipefd);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_dup(int32_t oldfd) {
  int result = dup(oldfd);
  return (result < 0) ? -errno : result;
}

static int32_t __yo_sync_dup2(int32_t oldfd, int32_t newfd) {
  // dup2 silently CLOSES newfd when it is open: that is a close the async
  // backend must see like any other, or newfd's parked waiters are never
  // delivered and its registration outlives the file it named.
  if (oldfd != newfd && __yo_io_close_hook) __yo_io_close_hook(newfd);
  int result = dup2(oldfd, newfd);
  return (result < 0) ? -errno : result;
}

static int64_t __yo_sync_lseek(int32_t fd, int64_t offset, int32_t whence) {
  off_t result = lseek(fd, (off_t)offset, whence);
  return (result < 0) ? (int64_t)(-errno) : (int64_t)result;
}

/* Positioned synchronous write — see the macOS emitter's comment. */
static int32_t __yo_sync_write(int32_t fd, const void* buf, uint32_t count, uint64_t offset) {
  ssize_t n = pwrite(fd, buf, (size_t)count, (off_t)offset);
  if (n < 0 && errno == ESPIPE) n = write(fd, buf, (size_t)count);
  return (n < 0) ? -errno : (int32_t)n;
}

static int32_t __yo_sync_fallocate(int32_t fd, int32_t mode, int64_t offset, int64_t length) {
  int result = fallocate(fd, mode, (off_t)offset, (off_t)length);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_fcntl_getfl(int32_t fd) {
  int result = fcntl(fd, F_GETFL);
  return (result < 0) ? -errno : result;
}

static int32_t __yo_sync_fcntl_setfl(int32_t fd, int32_t flags) {
  int result = fcntl(fd, F_SETFL, flags);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_fcntl_getfd(int32_t fd) {
  int result = fcntl(fd, F_GETFD);
  return (result < 0) ? -errno : result;
}

static int32_t __yo_sync_fcntl_setfd(int32_t fd, int32_t flags) {
  int result = fcntl(fd, F_SETFD, flags);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_flock(int32_t fd, int32_t operation) {
  int result = flock(fd, operation);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_readv(int32_t fd, void* iov, int32_t iovcnt) {
  ssize_t result = readv(fd, (const struct iovec*)iov, (int)iovcnt);
  return (result < 0) ? -errno : (int32_t)result;
}

static int32_t __yo_sync_writev(int32_t fd, void* iov, int32_t iovcnt) {
  ssize_t result = writev(fd, (const struct iovec*)iov, (int)iovcnt);
  return (result < 0) ? -errno : (int32_t)result;
}

static int32_t __yo_sync_preadv(int32_t fd, void* iov, int32_t iovcnt, int64_t offset) {
  struct iovec* vec = (struct iovec*)iov;
  ssize_t total = 0;
  off_t current = (off_t)offset;

  for (int32_t i = 0; i < iovcnt; i++) {
    if (vec[i].iov_len == 0) continue;
    ssize_t n = pread(fd, vec[i].iov_base, vec[i].iov_len, current);
    if (n < 0) {
      return (total > 0) ? (int32_t)total : -errno;
    }
    total += n;
    if ((size_t)n < vec[i].iov_len) {
      break;
    }
    current += (off_t)n;
  }

  return (int32_t)total;
}

static int32_t __yo_sync_pwritev(int32_t fd, void* iov, int32_t iovcnt, int64_t offset) {
  struct iovec* vec = (struct iovec*)iov;
  ssize_t total = 0;
  off_t current = (off_t)offset;

  for (int32_t i = 0; i < iovcnt; i++) {
    if (vec[i].iov_len == 0) continue;
    ssize_t n = pwrite(fd, vec[i].iov_base, vec[i].iov_len, current);
    if (n < 0) {
      return (total > 0) ? (int32_t)total : -errno;
    }
    total += n;
    if ((size_t)n < vec[i].iov_len) {
      break;
    }
    current += (off_t)n;
  }

  return (int32_t)total;
}

static size_t __yo_iovec_size(void) {
  return sizeof(struct iovec);
}

static void __yo_iovec_set(void* iov, size_t index, void* base, size_t len) {
  struct iovec* vec = (struct iovec*)iov;
  vec[index].iov_base = base;
  vec[index].iov_len = len;
}

static int32_t __yo_sync_fadvise(int32_t fd, int64_t offset, int64_t len, int32_t advice) {
  int result = posix_fadvise(fd, (off_t)offset, (off_t)len, advice);
  return (result == 0) ? 0 : -result;
}

static int32_t __yo_sync_madvise(uint8_t* addr, size_t length, int32_t advice) {
  int result = madvise((void*)addr, length, advice);
  return (result < 0) ? -errno : 0;
}

static uint8_t* __yo_sync_mmap(uint8_t* addr, size_t length, int32_t prot, int32_t flags, int32_t fd, int64_t offset) {
  void* result = mmap((void*)addr, length, prot, flags, fd, (off_t)offset);
  if (result == MAP_FAILED) {
    return (uint8_t*)(intptr_t)(-errno);
  }
  return (uint8_t*)result;
}

static bool __yo_sync_mmap_is_error(uint8_t* addr) {
  intptr_t value = (intptr_t)addr;
  return (value < 0) && (value >= -65535);
}

static int32_t __yo_sync_mmap_errno(uint8_t* addr) {
  intptr_t value = (intptr_t)addr;
  if ((value < 0) && (value >= -65535)) {
    return (int32_t)(-value);
  }
  return 0;
}

static int32_t __yo_sync_munmap(uint8_t* addr, size_t length) {
  int result = munmap((void*)addr, length);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_mprotect(uint8_t* addr, size_t length, int32_t prot) {
  int result = mprotect((void*)addr, length, prot);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_msync(uint8_t* addr, size_t length, int32_t flags) {
  int result = msync((void*)addr, length, flags);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_fchmod(int32_t fd, uint32_t mode) {
  int result = fchmod(fd, (mode_t)mode);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_fchmodat(int32_t dirfd, const char* path, uint32_t mode, int32_t flags) {
  int result = fchmodat(dirfd, path, (mode_t)mode, flags);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_fchown(int32_t fd, uint32_t uid, uint32_t gid) {
  int result = fchown(fd, (uid_t)uid, (gid_t)gid);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_fchownat(int32_t dirfd, const char* path, uint32_t uid, uint32_t gid, int32_t flags) {
  int result = fchownat(dirfd, path, (uid_t)uid, (gid_t)gid, flags);
  return (result < 0) ? -errno : 0;
}

static int32_t __yo_sync_readlinkat(int32_t dirfd, const char* path, char* buf, size_t bufsize) {
  ssize_t result = readlinkat(dirfd, path, buf, bufsize);
  return (result < 0) ? -errno : (int32_t)result;
}

// Sync getsockname - get local socket address
static int32_t __yo_sync_getsockname(int32_t sockfd, void* addr, uint32_t* addrlen) {
  socklen_t len = (socklen_t)(*addrlen);
  int result = getsockname(sockfd, (struct sockaddr*)addr, &len);
  if (result < 0) {
    return -errno;
  }
  *addrlen = (uint32_t)len;
  return 0;
}

// Sync getpeername - get remote peer address
static int32_t __yo_sync_getpeername(int32_t sockfd, void* addr, uint32_t* addrlen) {
  socklen_t len = (socklen_t)(*addrlen);
  int result = getpeername(sockfd, (struct sockaddr*)addr, &len);
  if (result < 0) {
    return -errno;
  }
  *addrlen = (uint32_t)len;
  return 0;
}

// Sync setsockopt - set socket option value
static int32_t __yo_sync_setsockopt(int32_t sockfd, int32_t level, int32_t optname,
                                     const void* optval, uint32_t optlen) {
  int result = setsockopt(sockfd, level, optname, optval, (socklen_t)optlen);
  return (result < 0) ? -errno : 0;
}

// Sync getsockopt - get socket option value
static int32_t __yo_sync_getsockopt(int32_t sockfd, int32_t level, int32_t optname,
                                     void* optval, uint32_t* optlen) {
  socklen_t len = (socklen_t)(*optlen);
  int result = getsockopt(sockfd, level, optname, optval, &len);
  if (result < 0) {
    return -errno;
  }
  *optlen = (uint32_t)len;
  return 0;
}

// Sync socketpair - create a connected socket pair
static int32_t __yo_sync_socketpair(int32_t domain, int32_t sock_type, int32_t protocol, int32_t* sv) {
  int result = socketpair(domain, sock_type, protocol, (int*)sv);
  return (result < 0) ? -errno : 0;
}

// Sync clock_gettime - read current clock time
static int32_t __yo_sync_clock_gettime(int32_t clock_id, int64_t* sec, int64_t* nsec) {
  struct timespec ts;
  int result = clock_gettime((clockid_t)clock_id, &ts);
  if (result < 0) {
    return -errno;
  }
  *sec = (int64_t)ts.tv_sec;
  *nsec = (int64_t)ts.tv_nsec;
  return 0;
}

// Sync uname - system identification
static int32_t __yo_sync_uname(void* buf) {
  int result = uname((struct utsname*)buf);
  return (result < 0) ? -errno : 0;
}

// Sync gethostname - read host name
static int32_t __yo_sync_gethostname(char* name, size_t len) {
  int result = gethostname(name, len);
  if (result < 0) {
    return -errno;
  }
  if (len > 0) {
    name[len - 1] = '\\0';
  }
  return 0;
}

// Sync umask - set process file mode creation mask
static int32_t __yo_sync_umask(int32_t mask) {
  mode_t prev = umask((mode_t)mask);
  return (int32_t)prev;
}


// ============================================================================
// Socket Address Helpers (Cross-platform)
// ============================================================================

static size_t __yo_sockaddr_in_size(void) {
  return sizeof(struct sockaddr_in);
}

static size_t __yo_sockaddr_in6_size(void) {
  return sizeof(struct sockaddr_in6);
}

static size_t __yo_sockaddr_un_size(void) {
  return sizeof(struct sockaddr_un);
}

static size_t __yo_sockaddr_storage_size(void) {
  return sizeof(struct sockaddr_storage);
}

static void __yo_sockaddr_set_family(void* addr, uint16_t family) {
  ((struct sockaddr*)addr)->sa_family = family;
}

static uint16_t __yo_sockaddr_get_family(void* addr) {
  return ((struct sockaddr*)addr)->sa_family;
}

static void __yo_sockaddr_in_set_port(void* addr, uint16_t port) {
  ((struct sockaddr_in*)addr)->sin_port = htons(port);
}

static uint16_t __yo_sockaddr_in_get_port(void* addr) {
  return ntohs(((struct sockaddr_in*)addr)->sin_port);
}

static void __yo_sockaddr_in_set_addr(void* addr, uint32_t ip) {
  ((struct sockaddr_in*)addr)->sin_addr.s_addr = ip;
}

static uint32_t __yo_sockaddr_in_get_addr(void* addr) {
  return ((struct sockaddr_in*)addr)->sin_addr.s_addr;
}

static void __yo_sockaddr_in6_set_port(void* addr, uint16_t port) {
  ((struct sockaddr_in6*)addr)->sin6_port = htons(port);
}

static uint16_t __yo_sockaddr_in6_get_port(void* addr) {
  return ntohs(((struct sockaddr_in6*)addr)->sin6_port);
}

static void __yo_sockaddr_in6_set_addr(void* addr, const void* ip) {
  memcpy(&((struct sockaddr_in6*)addr)->sin6_addr, ip, 16);
}

static void __yo_sockaddr_in6_get_addr(void* addr, void* out) {
  memcpy(out, &((struct sockaddr_in6*)addr)->sin6_addr, 16);
}

static void __yo_sockaddr_un_set_path(void* addr, const char* path) {
  strncpy(((struct sockaddr_un*)addr)->sun_path, path, sizeof(((struct sockaddr_un*)addr)->sun_path) - 1);
  ((struct sockaddr_un*)addr)->sun_path[sizeof(((struct sockaddr_un*)addr)->sun_path) - 1] = '\\0';
}

static uint8_t* __yo_sockaddr_un_get_path(void* addr) {
  return (uint8_t*)(((struct sockaddr_un*)addr)->sun_path);
}

static int32_t __yo_inet_pton(int32_t af, const char* src, void* dst) {
  return inet_pton(af, src, dst);
}

static uint8_t* __yo_inet_ntop(int32_t af, const void* src, char* dst, uint32_t size) {
  return (uint8_t*)((char*)inet_ntop(af, src, dst, (socklen_t)size));
}

static uint16_t __yo_htons(uint16_t hostshort) {
  return htons(hostshort);
}

static uint16_t __yo_ntohs(uint16_t netshort) {
  return ntohs(netshort);
}

static uint32_t __yo_htonl(uint32_t hostlong) {
  return htonl(hostlong);
}

static uint32_t __yo_ntohl(uint32_t netlong) {
  return ntohl(netlong);
}

// Synchronous file operations (kept for compatibility)
static int32_t __yo_file_open(const char* path, int32_t flags, int32_t mode) {
  int fd = open(path, flags, mode);
  int result = fd >= 0 ? fd : -errno;
  ASYNC_DEBUG("[Io] open(%s, 0x%x, 0%o) = %d\\n", path, flags, mode, result);
  return result;
}

static void __yo_file_close(int32_t fd) {
  ASYNC_DEBUG("[Io] close(%d)\\n", fd);
  if (__yo_io_close_hook) __yo_io_close_hook(fd);
  close(fd);
}

static int64_t __yo_file_size(int32_t fd) {
  struct stat st;
  if (fstat(fd, &st) < 0) {
    int result = -errno;
    ASYNC_DEBUG("[Io] fstat(%d) failed: %d\\n", fd, result);
    return result;
  }
  ASYNC_DEBUG("[Io] fstat(%d) = %lld bytes\\n", fd, (long long)st.st_size);
  return st.st_size;
}

// Fill a statx buffer from an OPEN DESCRIPTOR instead of a path — the fd form
// of __yo_async_statx_start, for a handle whose path is unknown or has since
// been renamed/unlinked. statx() with AT_EMPTY_PATH and an empty path IS
// fstat(2), and it fills the very struct statx the accessors below read.
// Returns 0 on success, -errno on failure.
static int32_t __yo_fstat(int32_t fd, void* statxbuf) {
  int result = statx(fd, "", AT_EMPTY_PATH, STATX_BASIC_STATS, (struct statx*)statxbuf);
  return (result < 0) ? -errno : 0;
}

// Get size of statx buffer (for allocation)
static size_t __yo_statx_buf_size(void) {
  return sizeof(struct statx);
}

// Extract fields from struct statx
static int64_t __yo_statx_size(void* statxbuf) {
  return (int64_t)((struct statx*)statxbuf)->stx_size;
}

static uint32_t __yo_statx_mode(void* statxbuf) {
  return (uint32_t)((struct statx*)statxbuf)->stx_mode;
}

static int64_t __yo_statx_mtime_sec(void* statxbuf) {
  return (int64_t)((struct statx*)statxbuf)->stx_mtime.tv_sec;
}

static uint32_t __yo_statx_mtime_nsec(void* statxbuf) {
  return (uint32_t)((struct statx*)statxbuf)->stx_mtime.tv_nsec;
}

static int64_t __yo_statx_atime_sec(void* statxbuf) {
  return (int64_t)((struct statx*)statxbuf)->stx_atime.tv_sec;
}

static uint32_t __yo_statx_atime_nsec(void* statxbuf) {
  return (uint32_t)((struct statx*)statxbuf)->stx_atime.tv_nsec;
}

static int64_t __yo_statx_ctime_sec(void* statxbuf) {
  return (int64_t)((struct statx*)statxbuf)->stx_ctime.tv_sec;
}

static uint32_t __yo_statx_ctime_nsec(void* statxbuf) {
  return (uint32_t)((struct statx*)statxbuf)->stx_ctime.tv_nsec;
}

static int64_t __yo_statx_btime_sec(void* statxbuf) {
  return (int64_t)((struct statx*)statxbuf)->stx_btime.tv_sec;
}

static uint32_t __yo_statx_btime_nsec(void* statxbuf) {
  return (uint32_t)((struct statx*)statxbuf)->stx_btime.tv_nsec;
}

static uint32_t __yo_statx_uid(void* statxbuf) {
  return (uint32_t)((struct statx*)statxbuf)->stx_uid;
}

static uint32_t __yo_statx_gid(void* statxbuf) {
  return (uint32_t)((struct statx*)statxbuf)->stx_gid;
}

static uint64_t __yo_statx_ino(void* statxbuf) {
  return (uint64_t)((struct statx*)statxbuf)->stx_ino;
}

static uint64_t __yo_statx_dev_major(void* statxbuf) {
  return (uint64_t)((struct statx*)statxbuf)->stx_dev_major;
}

static uint64_t __yo_statx_dev_minor(void* statxbuf) {
  return (uint64_t)((struct statx*)statxbuf)->stx_dev_minor;
}

static uint64_t __yo_statx_nlink(void* statxbuf) {
  return (uint64_t)((struct statx*)statxbuf)->stx_nlink;
}

static uint64_t __yo_statx_blksize(void* statxbuf) {
  return (uint64_t)((struct statx*)statxbuf)->stx_blksize;
}

static uint64_t __yo_statx_blocks(void* statxbuf) {
  return (uint64_t)((struct statx*)statxbuf)->stx_blocks;
}


`
  );
});
/// Emit the Linux io_uring-based async I/O runtime.
generate_async_runtime_io_linux :: (fn(emitter : Emitter) -> unit)({
  emitter.emit_string_line(
    `
// ============================================================================
// Async I/O Runtime (Linux - io_uring via the vendored ring layer)
// ============================================================================

#include <errno.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <netinet/tcp.h>
#include <arpa/inet.h>
#include <sys/un.h>

#include <sys/eventfd.h>
#include <sys/epoll.h>
#include <poll.h>
#include <fcntl.h>

// Deterministic performance budgets (plans/reference/DROP_LIBURING.md Phase 6, G3):
// counts, not clocks — a shared CI runner can enforce these. Always on:
// a thread-local increment per kernel entry costs nothing next to the entry
// itself. kernel_enters counts every io_uring_enter and epoll_wait;
// zero_timeout_enters counts the non-blocking probes (enter(0, 0, GETEVENTS)
// and epoll_wait(0)) — the anti-spin signal: a loop that is merely WAITING
// must accrue neither.
static _Thread_local unsigned long __yo_stats_kernel_enters = 0;
static _Thread_local unsigned long __yo_stats_zero_timeout_enters = 0;
unsigned long __yo_io_stats_kernel_enters(void) {
  return __yo_stats_kernel_enters;
}
unsigned long __yo_io_stats_zero_timeout_enters(void) {
  return __yo_stats_zero_timeout_enters;
}
// io_syscalls counts every OTHER syscall the runtime issues on an operation's
// behalf — the epoll fallback's inline and retried read/write/send/recv/
// accept/connect/getsockopt/fstat/fcntl and its epoll_ctl calls, and the
// inline datagram attempts both backends make. kernel_enters alone made the
// fallback look free ("0 enters per op") while it was doing every syscall
// inline; a budget over the SUM compares the backends honestly.
static _Thread_local unsigned long __yo_stats_io_syscalls = 0;
unsigned long __yo_io_stats_io_syscalls(void) {
  return __yo_stats_io_syscalls;
}
#define __YO_SC(call) (__yo_stats_io_syscalls++, (call))
// Inline recv attempts that would have blocked (EAGAIN): the syscalls the
// recv-parks hint exists to save. A ping-pong should pay about none.
static _Thread_local unsigned long __yo_stats_recv_would_block = 0;
unsigned long __yo_io_stats_recv_would_block(void) {
  return __yo_stats_recv_would_block;
}
// Incremented by every kernel harvest: each epoll_wait (__yo_epoll_drive) and
// each io_uring_enter (__yo_uring_enter_arg). An operation delivered by the
// FIRST harvest after it was issued found its data already there when it was
// armed: its inline attempt would have succeeded, and that is what clears a
// descriptor's recv-parks hint (__YO_RING_FD_RECV_PARKS, the epoll slot's
// recv_parks). The old rule counted only the loop's BLOCKING waits. A
// ping-pong's loop never blocks (a task ran every step, so it polls), so
// every delivery landed "in the epoch it parked in" and cleared the hint:
// one doomed recv a hop on both backends, 79,998 recvfrom for 40,000
// receives under epoll
// (issues/fixed/linux-recv-parks-hint-is-cleared-on-every-ping-pong-hop.md).
static _Thread_local uint32_t __yo_io_harvest = 0;
// ============================================================================
// Vendored io_uring ring layer (plans/reference/DROP_LIBURING.md Phase 1)
// ============================================================================
// The kernel UAPI, frozen: the SQE (64 B) / CQE (16 B) layouts and the mmap
// offsets are stable since 5.1 and append-only since; new ops and flags are
// additive, and we define only the pieces this runtime submits. This layer
// replaces the liburing dependency (~10 linked symbols plus header inlines)
// with namespaced C11, so the emitted program links against libc only.
//
// The protocol is the classic single-issuer, single-threaded-per-ring one:
//   fill an SQE slot (plain stores — we own it until the tail publish),
//   publish the SQ tail with release, enter;
//   acquire the CQ tail, read CQEs up to it, publish the CQ head with
//   release. On x86-64 the atomics are free (compiler barriers); on aarch64
//   they are ldar/stlr.
//
// Field names deliberately mirror liburing's struct __yo_uring so the layer
// reads against its proven reference implementation.
#include <sys/mman.h>
#include <sys/syscall.h>
#include <errno.h>
#include <stdint.h>
#include <string.h>
#include <unistd.h>

// Syscall numbers are unified across architectures (io_uring postdates the
// asm-generic numbering merge); the fallbacks cover libc headers that lack
// them.
#ifndef __NR_io_uring_setup
#define __NR_io_uring_setup 425
#endif
#ifndef __NR_io_uring_enter
#define __NR_io_uring_enter 426
#endif
#ifndef __NR_io_uring_register
#define __NR_io_uring_register 427
#endif

#define __YO_IORING_SETUP_COOP_TASKRUN   (1U << 8)
#define __YO_IORING_SETUP_SINGLE_ISSUER  (1U << 12)
#define __YO_IORING_SETUP_DEFER_TASKRUN  (1U << 13)
#define __YO_IORING_ENTER_GETEVENTS      (1U << 0)
#define __YO_IORING_ENTER_EXT_ARG        (1U << 3)
#define __YO_IORING_FEAT_SINGLE_MMAP     (1U << 0)
#define __YO_IORING_FEAT_EXT_ARG         (1U << 8)
#define __YO_IORING_FSYNC_DATASYNC       (1U << 0)
#define __YO_IORING_OFF_SQ_RING          0ULL
#define __YO_IORING_OFF_CQ_RING          0x8000000ULL
#define __YO_IORING_OFF_SQES             0x10000000ULL

// Opcodes this runtime submits (numbers are stable UAPI; checked against
// include/uapi/linux/io_uring.h):
#define __YO_IORING_OP_FSYNC         3
#define __YO_IORING_OP_POLL_ADD      6
#define __YO_IORING_OP_TIMEOUT       11
#define __YO_IORING_OP_SENDMSG       9
#define __YO_IORING_OP_RECVMSG       10
#define __YO_IORING_OP_ACCEPT        13
#define __YO_IORING_OP_ASYNC_CANCEL  14
#define __YO_IORING_OP_CONNECT       16
#define __YO_IORING_OP_OPENAT        18
#define __YO_IORING_OP_CLOSE         19
#define __YO_IORING_OP_READ          22
#define __YO_IORING_OP_WRITE         23
#define __YO_IORING_OP_SEND          26
#define __YO_IORING_OP_RECV          27
#define __YO_IORING_OP_FTRUNCATE     55

// UAPI layouts (include/uapi/linux/io_uring.h), flat-spelled: the two unions
// are written out as the fields this runtime uses, with explicit padding so
// the sizes are load-bearing (64-byte SQE, 16-byte CQE — static_asserts
// below). The 'off' slot is the UAPI {off, addr2} union (ACCEPT carries its
// addrlen pointer there); 'rw_flags' is the flag-word union.
struct __yo_uring_sqe {
  uint8_t  opcode;
  uint8_t  flags;
  uint16_t ioprio;
  int32_t  fd;
  uint64_t off;
  uint64_t addr;
  uint32_t len;
  uint32_t rw_flags;
  uint64_t user_data;
  uint16_t buf_index;
  uint16_t personality;
  uint8_t  __pad[20];
};

struct __yo_uring_cqe {
  uint64_t user_data;
  int32_t  res;
  uint32_t flags;
};

struct __yo_uring_sqring_offsets {
  uint32_t head, tail, ring_mask, ring_entries, flags, dropped, array, resv1;
  uint64_t resv2;
};

struct __yo_uring_cqring_offsets {
  uint32_t head, tail, ring_mask, ring_entries, overflow, cqes, flags, resv1;
  uint64_t resv2;
};

struct __yo_uring_params {
  uint32_t sq_entries, cq_entries, flags, sq_thread_cpu, sq_thread_idle,
      features, wq_fd, resv[3];
  struct __yo_uring_sqring_offsets sq_off;
  struct __yo_uring_cqring_offsets cq_off;
};

struct __yo_uring {
  int ring_fd;
  struct {
    uint32_t* khead;
    uint32_t* ktail;
    uint32_t* ring_mask;
    uint32_t* ring_entries;
    uint32_t* flags;
    uint32_t* dropped;
    uint32_t* array;
    uint32_t sqe_head, sqe_tail;
    struct __yo_uring_sqe* sqes;
    void* ring_ptr;
    size_t ring_sz;
  } sq;
  struct {
    uint32_t* khead;
    uint32_t* ktail;
    uint32_t* ring_mask;
    uint32_t* ring_entries;
    uint32_t* overflow;
    struct __yo_uring_cqe* cqes;
    void* ring_ptr;
    size_t ring_sz;
  } cq;
};

// The kernel's 64-bit timespec, the layout
// IORING_OP_TIMEOUT and IORING_ENTER_EXT_ARG read on every ABI.
struct __yo_uring_timespec {
  int64_t tv_sec;
  long long tv_nsec;
};

_Static_assert(sizeof(struct __yo_uring_sqe) == 64, "__yo_uring_sqe layout");
_Static_assert(sizeof(struct __yo_uring_cqe) == 16, "__yo_uring_cqe layout");

static inline uint32_t __yo_uring_load_acquire(const uint32_t* p) {
  return __atomic_load_n(p, __ATOMIC_ACQUIRE);
}

static inline void __yo_uring_store_release(uint32_t* p, uint32_t v) {
  __atomic_store_n(p, v, __ATOMIC_RELEASE);
}

// Create a ring: setup syscall, then the three mmaps (SQ ring, CQ ring, SQE
// array). With __YO_IORING_FEAT_SINGLE_MMAP the kernel hands out one region for
// both rings and both mmaps must use the larger size — the same dance
// liburing does. Returns 0 or -errno.
static int __yo_uring_queue_init(struct __yo_uring* ring, uint32_t entries,
                                 struct __yo_uring_params* p) {
  memset(ring, 0, sizeof(*ring));
  int fd = (int)syscall(__NR_io_uring_setup, entries, p);
  if (fd < 0) return -errno;

  size_t sq_ring_sz =
      (size_t)p->sq_off.array + p->sq_entries * sizeof(uint32_t);
  size_t cq_ring_sz = (size_t)p->cq_off.cqes +
                      p->cq_entries * sizeof(struct __yo_uring_cqe);
  if (p->features & __YO_IORING_FEAT_SINGLE_MMAP) {
    if (cq_ring_sz > sq_ring_sz) sq_ring_sz = cq_ring_sz;
    cq_ring_sz = sq_ring_sz;
  }

  void* sq_ring = mmap(NULL, sq_ring_sz, PROT_READ | PROT_WRITE,
                       MAP_SHARED | MAP_POPULATE, fd, __YO_IORING_OFF_SQ_RING);
  if (sq_ring == MAP_FAILED) {
    int e = errno;
    close(fd);
    return -e;
  }
  void* cq_ring = mmap(NULL, cq_ring_sz, PROT_READ | PROT_WRITE,
                       MAP_SHARED | MAP_POPULATE, fd, __YO_IORING_OFF_CQ_RING);
  if (cq_ring == MAP_FAILED) {
    int e = errno;
    munmap(sq_ring, sq_ring_sz);
    close(fd);
    return -e;
  }
  size_t sqes_sz = (size_t)p->sq_entries * sizeof(struct __yo_uring_sqe);
  void* sqes = mmap(NULL, sqes_sz, PROT_READ | PROT_WRITE,
                    MAP_SHARED | MAP_POPULATE, fd, __YO_IORING_OFF_SQES);
  if (sqes == MAP_FAILED) {
    int e = errno;
    munmap(sq_ring, sq_ring_sz);
    munmap(cq_ring, cq_ring_sz);
    close(fd);
    return -e;
  }

  ring->ring_fd = fd;
  ring->sq.ring_ptr = sq_ring;
  ring->sq.ring_sz = sq_ring_sz;
  ring->sq.khead = (uint32_t*)((char*)sq_ring + p->sq_off.head);
  ring->sq.ktail = (uint32_t*)((char*)sq_ring + p->sq_off.tail);
  ring->sq.ring_mask = (uint32_t*)((char*)sq_ring + p->sq_off.ring_mask);
  ring->sq.ring_entries = (uint32_t*)((char*)sq_ring + p->sq_off.ring_entries);
  ring->sq.flags = (uint32_t*)((char*)sq_ring + p->sq_off.flags);
  ring->sq.dropped = (uint32_t*)((char*)sq_ring + p->sq_off.dropped);
  ring->sq.array = (uint32_t*)((char*)sq_ring + p->sq_off.array);
  ring->sq.sqes = (struct __yo_uring_sqe*)sqes;
  ring->cq.ring_ptr = cq_ring;
  ring->cq.ring_sz = cq_ring_sz;
  ring->cq.khead = (uint32_t*)((char*)cq_ring + p->cq_off.head);
  ring->cq.ktail = (uint32_t*)((char*)cq_ring + p->cq_off.tail);
  ring->cq.ring_mask = (uint32_t*)((char*)cq_ring + p->cq_off.ring_mask);
  ring->cq.ring_entries = (uint32_t*)((char*)cq_ring + p->cq_off.ring_entries);
  ring->cq.overflow = (uint32_t*)((char*)cq_ring + p->cq_off.overflow);
  ring->cq.cqes = (struct __yo_uring_cqe*)((char*)cq_ring + p->cq_off.cqes);
  return 0;
}

static void __yo_uring_queue_exit(struct __yo_uring* ring) {
  munmap(ring->sq.sqes,
         (size_t)(*ring->sq.ring_entries) * sizeof(struct __yo_uring_sqe));
  munmap(ring->sq.ring_ptr, ring->sq.ring_sz);
  munmap(ring->cq.ring_ptr, ring->cq.ring_sz);
  close(ring->ring_fd);
  memset(ring, 0, sizeof(*ring));
}

// Reserve the next SQE slot. NULL when the SQ is full (the caller decides how
// to fail). Slot publication to the kernel happens at submit time.
static struct __yo_uring_sqe* __yo_uring_get_sqe(struct __yo_uring* ring) {
  if (ring->sq.sqe_tail - __yo_uring_load_acquire(ring->sq.khead) >=
      *ring->sq.ring_entries) {
    return NULL;
  }
  return &ring->sq.sqes[ring->sq.sqe_tail++ & *ring->sq.ring_mask];
}

// Returns what the kernel returned, or -errno — liburing's convention, which
// every caller's ret < 0 / ret == -EINTR test is written against
// (syscall(2) itself returns -1 with errno set).
static int __yo_uring_enter_arg(struct __yo_uring* ring, uint32_t to_submit,
                                uint32_t min_complete, uint32_t flags,
                                const void* arg, size_t argsz) {
  __yo_stats_kernel_enters++;
  __yo_io_harvest++;
  // A probe is a GETEVENTS entry that may not block; a plain submit
  // (flags 0) is not one.
  if ((flags & __YO_IORING_ENTER_GETEVENTS) && min_complete == 0) {
    __yo_stats_zero_timeout_enters++;
  }
  long r = syscall(__NR_io_uring_enter, ring->ring_fd, to_submit,
                   min_complete, flags, arg, argsz);
  return (r < 0) ? -errno : (int)r;
}

static int __yo_uring_enter(struct __yo_uring* ring, uint32_t to_submit,
                            uint32_t min_complete, uint32_t flags) {
  return __yo_uring_enter_arg(ring, to_submit, min_complete, flags, NULL, 0);
}

// Publish every reserved SQE (fill the SQ array, release the tail) and enter.
// Returns the number submitted or -errno; EINTR handling stays with the
// callers, as it is today.
static int __yo_uring_submit(struct __yo_uring* ring) {
  uint32_t mask = *ring->sq.ring_mask;
  uint32_t ktail = *ring->sq.ktail;
  uint32_t head = ktail;
  while (ring->sq.sqe_head != ring->sq.sqe_tail) {
    ring->sq.array[head & mask] = ring->sq.sqe_head & mask;
    ring->sq.sqe_head++;
    head++;
  }
  if (head != ktail) __yo_uring_store_release(ring->sq.ktail, head);
  uint32_t to_submit = head - *ring->sq.khead;
  if (to_submit == 0) return 0;
  return __yo_uring_enter(ring, to_submit, 0, 0);
}

// The loop's main batching win in one syscall: publish the SQEs and wait for
// wait_nr completions together. wait_nr == 0 does not block: it is the poll's
// submit-and-reap, which also runs the deferred task work.
// The kernel's struct io_uring_getevents_arg (IORING_ENTER_EXT_ARG, 5.11).
struct __yo_uring_getevents_arg {
  uint64_t sigmask;
  uint32_t sigmask_sz;
  uint32_t pad;
  uint64_t ts;
};

// timeout_ns >= 0 bounds the wait (IORING_ENTER_EXT_ARG, kernel 5.11 — the
// caller checks the feature bit); -1 waits without a bound. A wait that
// times out returns -ETIME unless it also submitted SQEs, in which case it
// returns their count, like any other submitting enter.
static int __yo_uring_submit_and_wait_timeout(struct __yo_uring* ring,
                                              uint32_t wait_nr,
                                              int64_t timeout_ns) {
  uint32_t mask = *ring->sq.ring_mask;
  uint32_t ktail = *ring->sq.ktail;
  uint32_t head = ktail;
  while (ring->sq.sqe_head != ring->sq.sqe_tail) {
    ring->sq.array[head & mask] = ring->sq.sqe_head & mask;
    ring->sq.sqe_head++;
    head++;
  }
  if (head != ktail) __yo_uring_store_release(ring->sq.ktail, head);
  uint32_t to_submit = head - *ring->sq.khead;
  if (timeout_ns < 0) {
    return __yo_uring_enter(ring, to_submit, wait_nr, __YO_IORING_ENTER_GETEVENTS);
  }
  struct __yo_uring_timespec ts;
  ts.tv_sec = timeout_ns / 1000000000;
  ts.tv_nsec = timeout_ns % 1000000000;
  struct __yo_uring_getevents_arg arg;
  memset(&arg, 0, sizeof(arg));
  arg.ts = (uint64_t)(uintptr_t)&ts;
  return __yo_uring_enter_arg(ring, to_submit, wait_nr,
                              __YO_IORING_ENTER_GETEVENTS | __YO_IORING_ENTER_EXT_ARG,
                              &arg, sizeof(arg));
}

static int __yo_uring_submit_and_wait(struct __yo_uring* ring,
                                      uint32_t wait_nr) {
  return __yo_uring_submit_and_wait_timeout(ring, wait_nr, -1);
}

// A non-blocking enter with GETEVENTS: under __YO_IORING_SETUP_DEFER_TASKRUN the
// kernel materialises completions only when this thread enters the ring, so a
// pure-userspace peek can miss finished work; this is the non-blocking enter
// that makes them visible (it consumes nothing).
static int __yo_uring_getevents(struct __yo_uring* ring) {
  return __yo_uring_enter(ring, 0, 0, __YO_IORING_ENTER_GETEVENTS);
}

// Which opcodes this kernel implements (IORING_REGISTER_PROBE, kernel 5.6 —
// the ring's own floor). io_uring_setup succeeding says nothing about
// individual ops: ftruncate arrived in 6.9, and an unimplemented op
// completes with -EINVAL. Probed once per ring; an op the kernel lacks is
// completed synchronously instead, the same code the epoll fallback runs
// for it (issues/fixed/io-uring-kernel-floor-is-documented-as-5-6-but-dir-ops-need-5-15.md;
// the directory ops that record was about are now inline on every kernel —
// see __yo_async_statx_start).
#define __YO_IORING_REGISTER_PROBE 8
#define __YO_IO_URING_OP_SUPPORTED (1U << 0)
#define __YO_IORING_PROBE_OPS 64
struct __yo_uring_probe_op {
  uint8_t op;
  uint8_t resv;
  uint16_t flags;
  uint32_t resv2;
};
struct __yo_uring_probe {
  uint8_t last_op;
  uint8_t ops_len;
  uint16_t resv;
  uint32_t resv2[3];
  struct __yo_uring_probe_op ops[__YO_IORING_PROBE_OPS];
};
static _Thread_local bool __yo_uring_ops_probed = false;
static _Thread_local uint8_t __yo_uring_op_ok_table[__YO_IORING_PROBE_OPS];

static void __yo_uring_probe_ops(struct __yo_uring* ring) {
  struct __yo_uring_probe probe;
  memset(&probe, 0, sizeof(probe));
  long r = syscall(__NR_io_uring_register, ring->ring_fd, __YO_IORING_REGISTER_PROBE,
                   &probe, __YO_IORING_PROBE_OPS);
  __yo_stats_io_syscalls++;
  if (r < 0) {
    // No probe: assume every op the runtime uses exists, which is what the
    // runtime did before probing; an unimplemented one reports -EINVAL.
    __yo_uring_ops_probed = false;
    return;
  }
  for (int i = 0; i < __YO_IORING_PROBE_OPS; i++) {
    __yo_uring_op_ok_table[i] =
        (i <= probe.last_op && i < probe.ops_len &&
         (probe.ops[i].flags & __YO_IO_URING_OP_SUPPORTED)) ? 1 : 0;
  }
  __yo_uring_ops_probed = true;
}

static inline bool __yo_uring_op_ok(int op) {
  if (!__yo_uring_ops_probed) return true;
  return op >= 0 && op < __YO_IORING_PROBE_OPS && __yo_uring_op_ok_table[op];
}

static unsigned __yo_uring_peek_batch_cqe(struct __yo_uring* ring,
                                          struct __yo_uring_cqe** cqes,
                                          unsigned nr) {
  uint32_t head = *ring->cq.khead;
  uint32_t tail = __yo_uring_load_acquire(ring->cq.ktail);
  unsigned count = 0;
  while (head != tail && count < nr) {
    cqes[count++] = &ring->cq.cqes[head & *ring->cq.ring_mask];
    head++;
  }
  return count;
}

// Advance the CQ head; the kernel reuses the slot only after this release.
static void __yo_uring_cqe_seen(struct __yo_uring* ring,
                                struct __yo_uring_cqe* cqe) {
  if (cqe) {
    __yo_uring_store_release(ring->cq.khead, *ring->cq.khead + 1);
  }
}

static inline void __yo_uring_sqe_set_data(struct __yo_uring_sqe* sqe,
                                           void* data) {
  sqe->user_data = (uint64_t)(uintptr_t)data;
}

static inline void* __yo_uring_cqe_get_data(const struct __yo_uring_cqe* cqe) {
  return (void*)(uintptr_t)cqe->user_data;
}

// Prep helpers. Unlike liburing's (which initialise most-but-not-all fields
// into a possibly-recycled slot), every helper here initialises EVERY field
// via __yo_uring_prep_rw first — a stale-data hazard cannot exist. The
// argument shapes mirror liburing's so the call sites keep their review
// history; the field placements (which UAPI slot carries which argument) are
// liburing's, verified against the kernel's opcode handlers.

static inline void __yo_uring_prep_rw(uint8_t op, struct __yo_uring_sqe* sqe,
                                      int32_t fd, const void* addr,
                                      uint32_t len, uint64_t off) {
  sqe->opcode = op;
  sqe->flags = 0;
  sqe->ioprio = 0;
  sqe->fd = fd;
  sqe->off = off;
  sqe->addr = (uint64_t)(uintptr_t)addr;
  sqe->len = len;
  sqe->rw_flags = 0;
  sqe->user_data = 0;
  sqe->buf_index = 0;
  sqe->personality = 0;
  memset(sqe->__pad, 0, sizeof(sqe->__pad));
}

// A relative timeout (IORING_OP_TIMEOUT, kernel 5.4): count 0 makes it a
// pure timer that other completions never satisfy; it completes with -ETIME
// on expiry. The kernel copies *ts when the SQE is submitted, so ts must
// live until then. Only the pre-5.11 bounded wait uses it
// (__yo_ring_arm_wait_timeout); sleeps are the timer heap's.
static inline void __yo_uring_prep_timeout(struct __yo_uring_sqe* sqe,
                                           struct __yo_uring_timespec* ts) {
  __yo_uring_prep_rw(__YO_IORING_OP_TIMEOUT, sqe, -1, ts, 1, 0);
}

static inline void __yo_uring_prep_read(struct __yo_uring_sqe* sqe, int32_t fd,
                                        void* buf, uint32_t size,
                                        int64_t offset) {
  __yo_uring_prep_rw(__YO_IORING_OP_READ, sqe, fd, buf, size, (uint64_t)offset);
}

static inline void __yo_uring_prep_write(struct __yo_uring_sqe* sqe,
                                         int32_t fd, const void* buf,
                                         uint32_t size, int64_t offset) {
  __yo_uring_prep_rw(__YO_IORING_OP_WRITE, sqe, fd, buf, size,
                     (uint64_t)offset);
}

static inline void __yo_uring_prep_openat(struct __yo_uring_sqe* sqe,
                                          int32_t dirfd, const char* path,
                                          int32_t flags, uint32_t mode) {
  __yo_uring_prep_rw(__YO_IORING_OP_OPENAT, sqe, dirfd, path, mode, 0);
  sqe->rw_flags = (uint32_t)flags;
}

static inline void __yo_uring_prep_close(struct __yo_uring_sqe* sqe,
                                         int32_t fd) {
  __yo_uring_prep_rw(__YO_IORING_OP_CLOSE, sqe, fd, NULL, 0, 0);
}

static inline void __yo_uring_prep_fsync(struct __yo_uring_sqe* sqe, int32_t fd,
                                         uint32_t fsync_flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_FSYNC, sqe, fd, NULL, 0, 0);
  sqe->rw_flags = fsync_flags;
}

static inline void __yo_uring_prep_ftruncate(struct __yo_uring_sqe* sqe,
                                             int32_t fd, int64_t length) {
  __yo_uring_prep_rw(__YO_IORING_OP_FTRUNCATE, sqe, fd, NULL, 0,
                     (uint64_t)length);
}

static inline void __yo_uring_prep_accept(struct __yo_uring_sqe* sqe,
                                          int32_t fd, void* addr,
                                          void* addrlen, int32_t flags) {
  // liburing's shape (checked against liburing 2.12): len stays 0 and the
  // addrlen POINTER travels in the off slot (uring_ptr_to_u64). The kernel
  // rejects a nonzero len for ACCEPT with EINVAL — encoding the pointer
  // there made every listener accept fail AND strand the rest of the
  // submission batch (io_uring_enter stops at a failed prep without
  // IORING_SETUP_SUBMIT_ALL), which hung the connect behind it. The
  // flags=0/NULL-buffer harness case cannot see either encoding.
  __yo_uring_prep_rw(__YO_IORING_OP_ACCEPT, sqe, fd, addr, 0,
                     (uint64_t)(uintptr_t)addrlen);
  sqe->rw_flags = (uint32_t)flags;
}

static inline void __yo_uring_prep_connect(struct __yo_uring_sqe* sqe,
                                           int32_t fd, const void* addr,
                                           uint32_t addrlen) {
  __yo_uring_prep_rw(__YO_IORING_OP_CONNECT, sqe, fd, addr, 0,
                     (uint64_t)addrlen);
}

static inline void __yo_uring_prep_send(struct __yo_uring_sqe* sqe, int32_t fd,
                                        const void* buf, size_t len,
                                        int32_t flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_SEND, sqe, fd, buf, (uint32_t)len, 0);
  sqe->rw_flags = (uint32_t)flags;
}

static inline void __yo_uring_prep_recv(struct __yo_uring_sqe* sqe, int32_t fd,
                                        void* buf, size_t len, int32_t flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_RECV, sqe, fd, buf, (uint32_t)len, 0);
  sqe->rw_flags = (uint32_t)flags;
}

static inline void __yo_uring_prep_sendmsg(struct __yo_uring_sqe* sqe,
                                           int32_t fd, void* msg,
                                           uint32_t flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_SENDMSG, sqe, fd, msg, 1, 0);
  sqe->rw_flags = flags;
}

static inline void __yo_uring_prep_recvmsg(struct __yo_uring_sqe* sqe,
                                           int32_t fd, void* msg,
                                           uint32_t flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_RECVMSG, sqe, fd, msg, 1, 0);
  sqe->rw_flags = flags;
}

static inline void __yo_uring_prep_poll_add(struct __yo_uring_sqe* sqe,
                                            int32_t fd, uint32_t events) {
  __yo_uring_prep_rw(__YO_IORING_OP_POLL_ADD, sqe, fd, NULL, 0, 0);
  sqe->rw_flags = events;
}

static inline void __yo_uring_prep_cancel(struct __yo_uring_sqe* sqe,
                                          void* target_user_data,
                                          uint32_t flags) {
  __yo_uring_prep_rw(__YO_IORING_OP_ASYNC_CANCEL, sqe, -1, target_user_data, 0,
                     0);
  sqe->rw_flags = flags;
}

static _Thread_local struct __yo_uring __yo_io_ring;
// IORING_ENTER_EXT_ARG (5.11): the ring's wait can carry its own timeout.
// Without it a bounded wait arms an IORING_OP_TIMEOUT instead.
static _Thread_local bool __yo_uring_has_ext_arg = false;

// ThreadSanitizer does not order a munmap against a later mmap that returns
// the same address, so ring mappings reused across threads look racy to it.
// When one thread's ring is torn down and a later thread's ring is mapped at
// the same address, TSan still holds the dead ring's accesses and reports the new
// ring's first SQE write as a race with the old one. The kernel orders the
// two: a munmap and a later mmap that returns the same address both take the
// process's mmap_lock. Model exactly that order on each region's address,
// released at teardown and acquired at setup; it adds an edge only when an
// address is really reused
// (issues/fixed/tsan-reports-a-race-between-two-threads-io-uring-rings.md).
#if defined(__has_feature)
#  if __has_feature(thread_sanitizer)
#    define __YO_TSAN 1
#  endif
#endif
#if !defined(__YO_TSAN) && defined(__SANITIZE_THREAD__)
#  define __YO_TSAN 1
#endif
#ifdef __YO_TSAN
void __tsan_acquire(void* addr);
void __tsan_release(void* addr);
static void __yo_tsan_ring_mapped(struct __yo_uring* ring) {
  __tsan_acquire(ring->sq.ring_ptr);
  __tsan_acquire(ring->cq.ring_ptr);
  __tsan_acquire(ring->sq.sqes);
}
static void __yo_tsan_ring_unmapping(struct __yo_uring* ring) {
  __tsan_release(ring->sq.ring_ptr);
  __tsan_release(ring->cq.ring_ptr);
  __tsan_release(ring->sq.sqes);
}
#else
static inline void __yo_tsan_ring_mapped(struct __yo_uring* ring) { (void)ring; }
static inline void __yo_tsan_ring_unmapping(struct __yo_uring* ring) { (void)ring; }
#endif
// __yo_io_initialized is defined in runtime-core
static _Thread_local size_t __yo_pending_io_count = 0;
// Cross-thread wakeup channel (plans/archive/WAKER_BASED_SCHEDULING.md step 5): an
// eventfd this loop keeps a POLL_ADD armed on, so a foreign thread can end an
// blocking io_uring_enter that would otherwise wait forever. Its SQE carries a
// SENTINEL user_data rather than a future, and takes no pending-I/O slot: it
// is not work the loop is waiting for, it is how the loop is reachable.
#define __YO_IO_NOTIFY_UD ((void*)(uintptr_t)1)
static _Thread_local int __yo_notify_efd = -1;
static inline void __yo_io_arm_notify(void);
// Ring size matches the fixed io_uring queue depth we initialize below.
#define __YO_IO_RING_ENTRIES 1024
// Number of SQEs queued in userspace but not yet submitted to the kernel.
// Deferred submission lets us batch many SQEs into a single syscall.
static _Thread_local unsigned __yo_sq_unsubmitted = 0;
static _Thread_local unsigned __yo_sq_deferred_head = 0;
static _Thread_local __yo_io_future_t* __yo_sq_deferred_futures[__YO_IO_RING_ENTRIES];
static struct __yo_uring_sqe* __yo_io_get_sqe(void);
// The socket ops' inline attempt yields to a forming batch at this many
// queued SQEs (see __yo_async_send_start).
#define __YO_IO_INLINE_MAX_QUEUED 8u

// I/O Future types - __yo_io_future_t is defined in types/generation.yo
// It has the same layout as async state machines (state, result, continuation_fn, continuation_sm)
// so the await codegen can access ->state and ->result uniformly.
// We store the future pointer directly in the SQE user data.

// Create the loop's wakeup channel (an eventfd) if it has none: a descriptor,
// no locked memory. It is published to foreign wakers under the loop's lock,
// the same lock a waker takes to queue its token and bump xwake_count, so a
// wake posted before this finds notify_ready == 0 but is visible to the
// loop's next check, and a wake posted after writes the eventfd.
static void __yo_io_notify_init(void) {
  if (__yo_notify_efd >= 0) return;
  __yo_notify_efd = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
  if (__yo_notify_efd >= 0) {
    __yo_loop_t* loop = __yo_loop_self();
    __yo_mutex_lock(&loop->lock);
    loop->notify_fd = __yo_notify_efd;
    loop->notify_ready = 1;
    __yo_mutex_unlock(&loop->lock);
  }
}

// Backend selection (plans/reference/DROP_LIBURING.md 3.6), declared ahead of the
// init ladder that decides it and the machinery below that implements it.
#define __YO_BACKEND_NONE     0
#define __YO_BACKEND_URING    1
#define __YO_BACKEND_EPOLL    2
#define __YO_BACKEND_DEGRADED 3
static _Thread_local int __yo_backend = __YO_BACKEND_NONE;
// The errno that ended the ladder (DEGRADED only): every async op completes
// with -__yo_backend_errno, the shape the sleep stub always documented.
static _Thread_local int __yo_backend_errno = 0;

static _Thread_local int __yo_epoll_fd = -1;
static void __yo_epoll_drop_fd(int fd);
static void __yo_ring_drop_fd(int32_t fd);
static bool __yo_ring_untrack_fd(__yo_io_future_t* future, int32_t result);
static void __yo_timer_teardown(void);
static void __yo_ring_fd_teardown(void);
static void __yo_ring_fd_abort_parked(void);
static bool __yo_epoll_cancel(__yo_io_future_t* future);
static void __yo_epoll_drive(bool block, int* count_out);
static void __yo_epoll_teardown(void);

// The watch set: one epoll instance holding every descriptor a poll or
// fs-event handle watches (the common runtime's __yo_poll_t/__yo_fs_event_t,
// which are TICKED — polled by __yo_poll_and_fs_event_tick — not delivered).
// Its only job is to end a blocked wait when a watched fd becomes ready: the
// ring keeps a one-shot POLL_ADD armed on it (__YO_IO_WATCH_UD), the epoll
// backend holds it in its own set. Before it existed a blocked loop never
// looked at its watches: with any operation in flight the wait slept until
// THAT completed, so a watch event waited out an unrelated sleep or recv,
// and a loop with nothing but watches polled them every 10 ms
// (issues/fixed/poll-and-fs-event-watches-starve-while-the-loop-waits.md).
#define __YO_IO_WATCH_UD ((void*)(uintptr_t)2)

// The pre-5.11 bounded wait: one IORING_OP_TIMEOUT for the earliest timer
// deadline, reported under __YO_IO_TIMEOUT_UD (it is not an operation; its
// CQE only ends the wait). An armed one is reused while it is not later than
// the deadline the wait needs; an earlier timer arms another, and the stale
// one fires into an empty CQE later.
#define __YO_IO_TIMEOUT_UD ((void*)(uintptr_t)3)
static _Thread_local struct __yo_uring_timespec __yo_ring_wait_ts;
static _Thread_local uint64_t __yo_ring_wait_armed_ns = 0;
static _Thread_local int __yo_watch_epfd = -1;
static _Thread_local bool __yo_watch_ring_armed = false;
static _Thread_local bool __yo_watch_in_epoll = false;
// Defined by the common runtime's Linux section: true while a started poll
// handle watches a descriptor epoll refuses (a regular file, EPERM). poll(2)
// reports such a file ready at all times, so those handles keep the old 10 ms
// polling wait instead of a blocking one.
static bool __yo_watch_needs_polling(void);

// Create the thread's io_uring ring. Called by the first I/O submission
// (every __yo_async_*_start), never at loop start: see __yo_io_loop_start.
static void __yo_io_init(void) {
  if (__yo_io_initialized) return;
  // This thread now has backend state to release when it exits.
  __yo_async_arm_thread_exit();

  // Backend selection happens once per thread, never re-decided: the ring
  // first, the epoll fallback when the ring cannot exist (ENOSYS under
  // seccomp — Docker's default profile blocks io_uring_setup; EPERM on
  // hardened kernels; ENOMEM under RLIMIT_MEMLOCK; pre-5.6 kernels), and
  // only if BOTH fail does the loop run DEGRADED — every async op then
  // completes with -__yo_backend_errno instead of the old exit(1)
  // (plans/reference/DROP_LIBURING.md 3.6, issues/fixed/io-uring-init-failure-exits-the-process.md).
  // YO_IO_BACKEND=uring|epoll pins a backend for tests and benchmarks; a
  // pinned backend that fails is a loud error, never a silent ladder step.
  int forced = 0;  // 0 auto, 1 uring, 2 epoll
  {
    const char* env = getenv("YO_IO_BACKEND");
    if (env && env[0] != 0) {
      if (strcmp(env, "uring") == 0) forced = 1;
      else if (strcmp(env, "epoll") == 0) forced = 2;
      else if (strcmp(env, "auto") != 0) {
        // A typo must not silently mean auto: the whole point of pinning is
        // that a test or benchmark knows which path it measured.
        fprintf(stderr, "[Yo] YO_IO_BACKEND=%s is not one of auto, uring, epoll\\n", env);
        exit(1);
      }
    }
  }

  if (forced != 2) {
    // Try modern kernel flags for lower overhead (requires Linux 6.0+):
    //   __YO_IORING_SETUP_COOP_TASKRUN — avoids inter-processor interrupts on task wakeup
    //     since we know our thread will reap completions.
    //   __YO_IORING_SETUP_SINGLE_ISSUER — we only submit from the owner thread.
    //   __YO_IORING_SETUP_DEFER_TASKRUN — completions run only when we call wait_cqe,
    //     avoiding random overhead on timer interrupts.
    struct __yo_uring_params params;
    memset(&params, 0, sizeof(params));
    params.flags |= __YO_IORING_SETUP_SINGLE_ISSUER;
    params.flags |= __YO_IORING_SETUP_COOP_TASKRUN;
    params.flags |= __YO_IORING_SETUP_DEFER_TASKRUN;

    int ret = __yo_uring_queue_init(&__yo_io_ring, __YO_IO_RING_ENTRIES, &params);
    if (ret < 0) {
      // Retry without any flags for older kernels
      memset(&params, 0, sizeof(params));
      ret = __yo_uring_queue_init(&__yo_io_ring, __YO_IO_RING_ENTRIES, &params);
    }
    if (ret == 0) {
      __yo_backend = __YO_BACKEND_URING;
      __yo_tsan_ring_mapped(&__yo_io_ring);
      __yo_io_initialized = true;
      __yo_io_close_hook = __yo_ring_drop_fd;
      __yo_uring_probe_ops(&__yo_io_ring);
      __yo_uring_has_ext_arg = (params.features & __YO_IORING_FEAT_EXT_ARG) != 0;
      __yo_io_notify_init();
      if (__yo_notify_efd >= 0) {
        __yo_io_arm_notify();
      }
      ASYNC_DEBUG("[Io] io_uring initialized with %d entries (flags=0x%x)\\n", __YO_IO_RING_ENTRIES, params.flags);
      return;
    }
    if (forced == 1) {
      fprintf(stderr, "[Yo] YO_IO_BACKEND=uring but io_uring is unavailable: %s\\n", strerror(-ret));
      exit(1);
    }
    fprintf(stderr, "[Yo] io_uring unavailable (%s%s); async I/O running on the epoll fallback\\n", strerror(-ret),
            (ret == -ENOSYS) ? "; blocked by seccomp (e.g. Docker's default profile) or a pre-5.1 kernel" : "");
  }

  __yo_epoll_fd = epoll_create1(EPOLL_CLOEXEC);
  if (__yo_epoll_fd >= 0) {
    __yo_backend = __YO_BACKEND_EPOLL;
    __yo_io_initialized = true;
    __yo_io_notify_init();
    // The SAME wake channel the ring arms with POLL_ADD, registered once —
    // level-triggered, so no re-arm: it reports whenever the eventfd holds a
    // token and stops once the wait loop drains it.
    if (__yo_notify_efd >= 0) {
      struct epoll_event ev;
      memset(&ev, 0, sizeof(ev));
      ev.events = EPOLLIN;
      ev.data.fd = __yo_notify_efd;
      epoll_ctl(__yo_epoll_fd, EPOLL_CTL_ADD, __yo_notify_efd, &ev);
    }
    // Parked ops must not outlive their descriptor: route the always-emitted
    // sync close through this backend's fd purge (the ring's hook cancels its
    // requests instead — __yo_ring_drop_fd).
    __yo_io_close_hook = __yo_epoll_drop_fd;
    ASYNC_DEBUG("[Io] epoll fallback initialized: ep=%d\\n", __yo_epoll_fd);
    return;
  }
  {
    int ep_err = errno;
    __yo_backend = __YO_BACKEND_DEGRADED;
    __yo_backend_errno = ep_err;
    __yo_io_initialized = true;
    __yo_io_notify_init();
    fprintf(stderr, "[Yo] async I/O unavailable: io_uring and epoll both failed (%s); async operations will complete with an error\\n", strerror(ep_err));
  }
}

// A loop creates its ring on its first I/O submission (every
// __yo_async_*_start calls __yo_io_init), not at loop start. A loop that only
// waits for wakes (a spawn_blocking await, a Park, a cross-thread waker) never
// needs one: __yo_io_wait blocks on the eventfd with poll(). The kernel charges
// a ring's memory to RLIMIT_MEMLOCK and returns it only when its deferred
// teardown runs, so a ring per short-lived thread ran the limit out within a
// hundred threads: io_uring_queue_init failed with ENOMEM
// (issues/fixed/every-thread-creates-an-io-uring-ring-and-thread-churn-runs-out-of-memory.md).
static void __yo_io_loop_start(void) {}

// Cleanup io_uring
static void __yo_io_cleanup(void) {
  // The timer heap is userspace-only, so it exists whether or not the ring
  // ever did (a program that only sleeps never enters the kernel through it).
  // Idempotent: it empties the heap and frees the array.
  __yo_timer_teardown();
  if (!__yo_io_initialized && __yo_notify_efd < 0) return;
  // Clear the loop's wakeup channel under the loop's mutex BEFORE closing the
  // eventfd: a foreign __yo_io_notify loads notify_fd under the same mutex, so
  // the clear and any in-flight write are serialized. Without the lock a
  // foreign wake could load a valid fd, then pause while this thread closes
  // the descriptor and the kernel reuses its number for something else, then
  // write to the WRONG file.
  {
    __yo_loop_t* loop = __yo_loop_self();
    __yo_mutex_lock(&loop->lock);
    loop->notify_ready = 0;
    loop->notify_fd = -1;
    __yo_mutex_unlock(&loop->lock);
  }
  // The tasks still parked on the ring's in-flight fd-bound operations are
  // released first, through their ordinary abort path: the ring is about to
  // be destroyed, so their completions will never be delivered and each is a
  // task that can never resume. The abort's cancel hook queues a
  // cancellation SQE into the deferred array, so this runs BEFORE the drain
  // below, which consumes it.
  if (__yo_backend == __YO_BACKEND_URING) {
    __yo_ring_fd_abort_parked();
  }
  // The tasks still parked on the SQEs that are only queued in userspace are
  // released the same way (a snapshot again: the abort's cancel hook queues
  // cancellation SQEs behind these). Then, if async main returns while some
  // SQEs are still only queued in userspace, cancel them here instead of
  // silently dropping the event-loop ref we took in __yo_io_ring_submit.
  if (__yo_sq_unsubmitted > 0) {
    size_t abortable = 0;
    for (size_t i = 0; i < __yo_sq_unsubmitted; i++) {
      if (__yo_sq_deferred_futures[(__yo_sq_deferred_head + i) % __YO_IO_RING_ENTRIES]) {
        abortable++;
      }
    }
    if (abortable > 0) {
      __yo_io_future_t** snapshot = (__yo_io_future_t**)__yo_malloc(abortable * sizeof(__yo_io_future_t*));
      if (snapshot) {
        size_t n = 0;
        for (size_t i = 0; i < __yo_sq_unsubmitted; i++) {
          __yo_io_future_t* future = __yo_sq_deferred_futures[(__yo_sq_deferred_head + i) % __YO_IO_RING_ENTRIES];
          if (future) {
            snapshot[n++] = future;
          }
        }
        for (n = 0; n < abortable; n++) {
          __yo_io_teardown_abort_waiters(snapshot[n]);
        }
        __yo_free(snapshot);
      }
    }
  }
  while (__yo_sq_unsubmitted > 0) {
    __yo_io_future_t* future = __yo_sq_deferred_futures[__yo_sq_deferred_head];
    __yo_sq_deferred_head = (__yo_sq_deferred_head + 1) % __YO_IO_RING_ENTRIES;
    __yo_sq_unsubmitted--;
    if (!future) continue;  // a cancellation SQE: no future, no pending slot
    __yo_pending_io_count--;
    (void)__yo_ring_untrack_fd(future, -ECANCELED);
    future->result = -ECANCELED;
    { if (future->state != -2) future->state = -1; }
    __yo_decr_rc((void*)future);
  }
  __yo_timer_teardown();
  __yo_ring_wait_armed_ns = 0;
  // A loop that only ever waited for wakes has an eventfd and no ring.
  if (__yo_backend == __YO_BACKEND_URING) {
    __yo_tsan_ring_unmapping(&__yo_io_ring);
    __yo_uring_queue_exit(&__yo_io_ring);
    __yo_ring_fd_teardown();
  } else if (__yo_backend == __YO_BACKEND_EPOLL) {
    __yo_epoll_teardown();
  }
  __yo_io_close_hook = NULL;
  if (__yo_watch_epfd >= 0) {
    close(__yo_watch_epfd);
    __yo_watch_epfd = -1;
  }
  __yo_watch_ring_armed = false;
  __yo_watch_in_epoll = false;
  if (__yo_notify_efd >= 0) {
    close(__yo_notify_efd);
    __yo_notify_efd = -1;
  }
  __yo_io_initialized = false;
  ASYNC_DEBUG("[Io] io_uring cleaned up\\n");
}

// Check if there are pending I/O operations
static inline bool __yo_has_pending_io(void) {
  return __yo_pending_io_count > 0 || __yo_active_watch_count > 0;
}

// Forward declaration for poll/fs_event tick (defined in runtime-io-common)
static int __yo_poll_and_fs_event_tick(void);

// Queue an SQE for later submission to io_uring (deferred submit).
// The actual __yo_uring_submit() syscall happens inside __yo_io_poll / __yo_io_wait,
// so many SQEs produced within one "drain tasks" pass batch into one syscall.
static inline void __yo_io_ring_submit(__yo_io_future_t* future) {
  future->header.ref_count++;    // io_uring holds a reference until CQE
  __yo_pending_io_count++;
  __yo_sq_deferred_futures[(__yo_sq_deferred_head + __yo_sq_unsubmitted) % __YO_IO_RING_ENTRIES] = future;
  __yo_sq_unsubmitted++;
}

// Ask the kernel to cancel the operation submitted with target as its user
// data. The cancellation SQE carries NULL user data (it is not an operation a
// task awaits) and does NOT take a pending-I/O slot: the operation it cancels
// still owns one, and still delivers its own CQE — with -ECANCELED — which is
// what releases the ring's reference. Returns false when no SQE is available,
// leaving the operation registered.
static inline bool __yo_io_ring_submit_cancel(__yo_io_future_t* target) {
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) return false;
  __yo_uring_prep_cancel(sqe, (void*)target, 0);
  __yo_uring_sqe_set_data(sqe, NULL);
  __yo_sq_deferred_futures[(__yo_sq_deferred_head + __yo_sq_unsubmitted) % __YO_IO_RING_ENTRIES] = NULL;
  __yo_sq_unsubmitted++;
  return true;
}

// In-flight ring operations bound to a descriptor. A ring request holds its
// own reference to the file, so closing the descriptor does NOT end it: a
// parked recv on a closed socket would wait for data forever, and the task
// awaiting it with it. The kqueue and epoll backends fail such waiters with
// -EBADF when the fd closes (__yo_kq_drop_fd, __yo_epoll_drop_fd); the ring
// matches that contract by cancelling every tracked operation on the fd
// (IORING_OP_ASYNC_CANCEL by user data — kernel 5.5, under the ring's 5.6
// floor) and reporting the resulting -ECANCELED as -EBADF.
//
// Buckets are indexed by fd (descriptors are small dense integers — libuv's
// watcher array), each a doubly-linked list whose node the future points at
// through backend_link: track, untrack and the per-close walk are all
// proportional to the operations actually involved, never to the table.
//
// The bucket also answers "is an operation in flight on this fd in this
// direction?" (dir 0: read/recv/recvmsg/accept, 1: write/send/sendmsg/
// connect), which is what lets a socket op try its syscall inline without
// overtaking an earlier queued op on the same stream (__yo_ring_fd_busy), and
// the slot keeps a per-descriptor memo of what the kernel refused
// (__YO_RING_FD_*), cleared when the descriptor closes.
typedef struct __yo_ring_fd_node_t {
  __yo_io_future_t* future;
  struct __yo_ring_fd_node_t* prev;
  struct __yo_ring_fd_node_t* next;
  int fd;
  uint32_t harvest;  // __yo_io_harvest when it was issued
  uint8_t dir;
  bool closed;  // the fd closed under it: its -ECANCELED reports as -EBADF
} __yo_ring_fd_node_t;
// The kernel refused an inline RWF_NOWAIT write on this fd for a reason that
// is a property of the file (EOPNOTSUPP: the filesystem has no nowait
// buffered writes, ext4 and tmpfs on 6.6; ESPIPE: not seekable; EINVAL):
// later writes go straight to the ring instead of paying a doomed syscall.
#define __YO_RING_FD_NO_NOWAIT_WRITE 1u
// The last inline recv on this socket would have blocked: skip the next
// attempt and go straight to the ring. A socket a server waits on parks
// on every request, and without the hint each recv paid a doomed recv
// syscall before its SQE (the parked ping-pong's syscall count tripled).
// Cleared by a recv that completes without the loop waiting
// (__yo_ring_untrack_fd), and when the fd closes.
#define __YO_RING_FD_RECV_PARKS 2u
typedef struct {
  __yo_ring_fd_node_t* head;
  uint8_t flags;
} __yo_ring_fd_slot_t;
static _Thread_local __yo_ring_fd_slot_t* __yo_ring_fd_slots = NULL;
static _Thread_local size_t __yo_ring_fd_cap = 0;
static _Thread_local __yo_ring_fd_node_t* __yo_ring_fd_node_free = NULL;

static inline int __yo_io_flush_sq(void);

static __yo_ring_fd_slot_t* __yo_ring_fd_slot_grow(int fd) {
  if (fd < 0) return NULL;
  if ((size_t)fd >= __yo_ring_fd_cap) {
    size_t cap = __yo_ring_fd_cap ? __yo_ring_fd_cap : 64;
    while (cap <= (size_t)fd) cap *= 2;
    __yo_ring_fd_slot_t* slots = (__yo_ring_fd_slot_t*)__yo_realloc(
        __yo_ring_fd_slots, cap * sizeof(__yo_ring_fd_slot_t));
    if (!slots) return NULL;
    memset(slots + __yo_ring_fd_cap, 0,
           (cap - __yo_ring_fd_cap) * sizeof(__yo_ring_fd_slot_t));
    __yo_ring_fd_slots = slots;
    __yo_ring_fd_cap = cap;
  }
  return &__yo_ring_fd_slots[fd];
}

static inline uint8_t __yo_ring_fd_flags(int fd) {
  if (fd < 0 || (size_t)fd >= __yo_ring_fd_cap) return 0;
  return __yo_ring_fd_slots[fd].flags;
}

static void __yo_ring_fd_set_flag(int fd, uint8_t flag) {
  __yo_ring_fd_slot_t* slot = __yo_ring_fd_slot_grow(fd);
  if (slot) slot->flags |= flag;
}

// Is a live (not closed-under) operation of this direction tracked on fd?
// Buckets hold the handful of ops actually in flight, so the walk is short.
static bool __yo_ring_fd_busy(int fd, uint8_t dir) {
  if (fd < 0 || (size_t)fd >= __yo_ring_fd_cap) return false;
  for (__yo_ring_fd_node_t* node = __yo_ring_fd_slots[fd].head; node; node = node->next) {
    if (!node->closed && node->dir == dir) return true;
  }
  return false;
}

// Link future into fd's bucket. On allocation failure the op simply stays
// untracked: it still completes and releases as before; only close-time
// cancellation (and the busy answer) is lost for it.
static void __yo_ring_track_fd(__yo_io_future_t* future, int fd, uint8_t dir) {
  __yo_ring_fd_slot_t* slot = __yo_ring_fd_slot_grow(fd);
  if (!slot) return;
  __yo_ring_fd_node_t* node = __yo_ring_fd_node_free;
  if (node) {
    __yo_ring_fd_node_free = node->next;
  } else {
    node = (__yo_ring_fd_node_t*)__yo_malloc(sizeof(__yo_ring_fd_node_t));
    if (!node) return;
  }
  node->future = future;
  node->fd = fd;
  node->harvest = __yo_io_harvest;
  node->dir = dir;
  node->closed = false;
  node->prev = NULL;
  node->next = slot->head;
  if (node->next) node->next->prev = node;
  slot->head = node;
  future->backend_link = node;
}

// Unlink at completion. Returns whether the fd was closed under the
// operation. A recv delivered by the first harvest after it was issued found
// its data already there: the socket is answering inline again, so its
// recv-parks hint is dropped.
static bool __yo_ring_untrack_fd(__yo_io_future_t* future, int32_t result) {
  __yo_ring_fd_node_t* node = (__yo_ring_fd_node_t*)future->backend_link;
  if (!node) return false;
  future->backend_link = NULL;
  bool closed = node->closed;
  if (node->dir == 0 && result >= 0 && node->harvest + 1 == __yo_io_harvest && !closed) {
    __yo_ring_fd_slots[node->fd].flags &= (uint8_t)~__YO_RING_FD_RECV_PARKS;
  }
  if (node->prev) {
    node->prev->next = node->next;
  } else {
    __yo_ring_fd_slots[node->fd].head = node->next;
  }
  if (node->next) node->next->prev = node->prev;
  node->next = __yo_ring_fd_node_free;
  __yo_ring_fd_node_free = node;
  return closed;
}

// The fd is being closed: cancel every live tracked operation on it. A node
// already marked closed belongs to an earlier descriptor with the same
// number whose cancel is in flight.
static void __yo_ring_drop_fd(int32_t fd) {
  if (fd < 0 || (size_t)fd >= __yo_ring_fd_cap) return;
  // The number may next name a different file: forget what this one refused.
  __yo_ring_fd_slots[fd].flags = 0;
  for (__yo_ring_fd_node_t* node = __yo_ring_fd_slots[fd].head; node; node = node->next) {
    if (node->closed) continue;
    node->closed = true;
    // __yo_io_get_sqe already flushes a full SQ; a cancel that still cannot
    // be queued leaves the operation to finish on its own.
    (void)__yo_io_ring_submit_cancel(node->future);
  }
}

// Teardown pre-pass for __yo_io_cleanup (io_uring backend): release the tasks
// still parked on the ring's in-flight fd-bound operations, through their
// ordinary abort path (__yo_io_teardown_abort_waiters). The ring is about to
// be destroyed, so their completions will never be delivered and each is a
// task that can never resume; the abort's cancel hook queues a cancellation
// SQE into the deferred array, so __yo_io_cleanup calls this BEFORE its
// deferred drain, which consumes it. Walk a snapshot of the futures: the
// helper holds its own reference across each abort, and the snapshot keeps
// the walk independent of whatever bookkeeping an abort's cancel hook
// performs. The futures themselves keep the ring's reference — their CQEs
// die with the ring — so this releases the TASKS, not the operations.
static void __yo_ring_fd_abort_parked(void) {
  size_t abortable = 0;
  for (size_t i = 0; i < __yo_ring_fd_cap; i++) {
    for (__yo_ring_fd_node_t* node = __yo_ring_fd_slots[i].head; node; node = node->next) {
      abortable++;
    }
  }
  if (abortable == 0) return;
  __yo_io_future_t** snapshot = (__yo_io_future_t**)__yo_malloc(abortable * sizeof(__yo_io_future_t*));
  if (!snapshot) return;
  size_t n = 0;
  for (size_t i = 0; i < __yo_ring_fd_cap; i++) {
    for (__yo_ring_fd_node_t* node = __yo_ring_fd_slots[i].head; node; node = node->next) {
      snapshot[n++] = node->future;
    }
  }
  for (n = 0; n < abortable; n++) {
    __yo_io_teardown_abort_waiters(snapshot[n]);
  }
  __yo_free(snapshot);
}

// Teardown: the ring is gone, so no tracked operation can complete through
// it any more. Free the nodes and the table.
static void __yo_ring_fd_teardown(void) {
  for (size_t i = 0; i < __yo_ring_fd_cap; i++) {
    __yo_ring_fd_node_t* node = __yo_ring_fd_slots[i].head;
    while (node) {
      __yo_ring_fd_node_t* next = node->next;
      node->future->backend_link = NULL;
      __yo_free(node);
      node = next;
    }
  }
  __yo_free(__yo_ring_fd_slots);
  __yo_ring_fd_slots = NULL;
  __yo_ring_fd_cap = 0;
  while (__yo_ring_fd_node_free) {
    __yo_ring_fd_node_t* next = __yo_ring_fd_node_free->next;
    __yo_free(__yo_ring_fd_node_free);
    __yo_ring_fd_node_free = next;
  }
}

// Cancel hook for the fd-bound ring operations with no post-completion hook
// of their own (read, write, recv, send, connect, accept): the cancel is
// queued, the continuation is taken by __yo_async_io_cancel, and the op's own
// -ECANCELED CQE releases the ring's reference.
static bool __yo_ring_fd_future_cancel(__yo_io_future_t* future) {
  return __yo_io_ring_submit_cancel(future);
}

// Re-arm the wakeup channel's POLL_ADD. One-shot per completion, so every
// drain of the eventfd arms the next one.
static inline void __yo_io_arm_notify(void) {
  if (__yo_notify_efd < 0) return;
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) return;
  __yo_uring_prep_poll_add(sqe, __yo_notify_efd, POLLIN);
  __yo_uring_sqe_set_data(sqe, __YO_IO_NOTIFY_UD);
  __yo_sq_deferred_futures[(__yo_sq_deferred_head + __yo_sq_unsubmitted) % __YO_IO_RING_ENTRIES] = NULL;
  __yo_sq_unsubmitted++;
}

// Nudge a loop out of its blocking wait. Safe from any thread: an eventfd
// write is atomic, and the check and the write run under the loop's mutex so
// they cannot race __yo_io_cleanup's clear+close of the descriptor (see the
// comment there).
// Takes loop->lock, so NO CALLER MAY ALREADY HOLD IT — the mutex is not
// recursive. Every caller lives in runtime_core.yo (__yo_async_blocking_end and
// __yo_waker_post's two paths) and each is deliberately outside the lock;
// __yo_waker_post's notify sits immediately AFTER its unlock for exactly this
// reason. See the invariant note there before moving any of them.
static void __yo_io_notify(__yo_loop_t* loop) {
  if (!loop) {
    return;
  }
  __yo_mutex_lock(&loop->lock);
  if (!loop->notify_ready || loop->notify_fd < 0) {
    __yo_mutex_unlock(&loop->lock);
    return;
  }
  uint64_t one = 1;
  ssize_t w;
  do {
    w = write(loop->notify_fd, &one, sizeof(one));
  } while (w < 0 && errno == EINTR);
  __yo_mutex_unlock(&loop->lock);
  (void)w;
}

// Retire the deferred-SQE bookkeeping for an enter that submitted ret SQEs.
// On failure (ret < 0), the SQEs remain in the SQ ring so __yo_sq_unsubmitted
// is left unchanged -- the next submit attempt (via poll/wait) will retry them.
static inline void __yo_io_account_submitted(int ret) {
  if (ret <= 0) return;
  if ((size_t)ret >= __yo_sq_unsubmitted) {
    __yo_sq_deferred_head = (__yo_sq_deferred_head + __yo_sq_unsubmitted) % __YO_IO_RING_ENTRIES;
    __yo_sq_unsubmitted = 0;
  } else {
    __yo_sq_deferred_head = (__yo_sq_deferred_head + (unsigned)ret) % __YO_IO_RING_ENTRIES;
    __yo_sq_unsubmitted -= (size_t)ret;
  }
}

// Flush any queued SQEs to the kernel if non-empty. Returns the number
// submitted, or -errno.
static inline int __yo_io_flush_sq(void) {
  if (__yo_sq_unsubmitted == 0) return 0;
  int ret;
  do {
    ret = __yo_uring_submit(&__yo_io_ring);
  } while (ret == -EINTR);
  __yo_io_account_submitted(ret);
  return ret;
}

// Reserve an SQE for an operation. Submission is deferred to the loop's next
// poll/wait, so a tick that starts more operations than the ring has entries
// (a server spawning a task per connection, a join over 2,000 reads) fills
// the SQ with work the kernel has not taken yet. That is not an error: hand
// the queued SQEs to the kernel and take a slot they free. Only a kernel that
// refuses the submit leaves the SQ full; the caller then fails the operation
// with -EAGAIN. Before this, the 1,025th operation of a tick failed with a
// spurious -EAGAIN, and a full SQ silently skipped re-arming the wake
// channel, after which no cross-thread wake could end a blocked wait
// (issues/fixed/io-uring-full-submission-queue-fails-operations-with-eagain.md).
static struct __yo_uring_sqe* __yo_io_get_sqe(void) {
  struct __yo_uring_sqe* sqe = __yo_uring_get_sqe(&__yo_io_ring);
  if (sqe) return sqe;
  __yo_io_flush_sq();
  return __yo_uring_get_sqe(&__yo_io_ring);
}


// --- Timers ------------------------------------------------------------------
// A sleep is a node in a per-thread binary min-heap keyed by its
// CLOCK_MONOTONIC deadline, on BOTH backends; the loop's blocking wait is
// bounded by the earliest deadline, and every poll completes the due ones.
// Arming and cancelling cost no syscall (clock_gettime is a vDSO call).
//   - The ring used to submit one IORING_OP_TIMEOUT per sleep, and a cancel
//     (std/async's timeout aborts its deadline task whenever the guarded op
//     wins — i.e. almost always) was an ASYNC_CANCEL SQE plus two CQEs.
//   - The epoll fallback used a timerfd per sleep: create, settime,
//     EPOLL_CTL_ADD, the 8-byte read, EPOLL_CTL_DEL, close — six syscalls.
// A fired timer completes with 8, the result the timerfd read produced and
// the contract every platform keeps (std/sys/timer.yo).
// Mark a future done and queue whoever is suspended on it.
static void __yo_io_wake(__yo_io_future_t* future) {
  { if (future->state != -2) future->state = -1; }
  void (*cont_fn)(void*) = future->continuation_fn;
  void* cont_sm = future->continuation_sm;
  if (cont_fn && cont_sm) {
    __yo_async_spawn_task(cont_fn, cont_sm);
  }
}

typedef struct __yo_timer_t {
  uint64_t deadline_ns;
  uint64_t seq;  // FIFO among equal deadlines
  __yo_io_future_t* future;
  size_t index;
} __yo_timer_t;
static _Thread_local __yo_timer_t** __yo_timers = NULL;
static _Thread_local size_t __yo_timer_count = 0;
static _Thread_local size_t __yo_timer_cap = 0;
static _Thread_local uint64_t __yo_timer_seq = 0;

static uint64_t __yo_mono_ns(void) {
  struct timespec ts;
  clock_gettime(CLOCK_MONOTONIC, &ts);
  return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
}

static inline bool __yo_timer_less(__yo_timer_t* a, __yo_timer_t* b) {
  return a->deadline_ns < b->deadline_ns || (a->deadline_ns == b->deadline_ns && a->seq < b->seq);
}

static void __yo_timer_place(__yo_timer_t* t, size_t i) {
  __yo_timers[i] = t;
  t->index = i;
}

static void __yo_timer_sift_up(size_t i) {
  __yo_timer_t* t = __yo_timers[i];
  while (i > 0) {
    size_t parent = (i - 1) / 2;
    if (!__yo_timer_less(t, __yo_timers[parent])) break;
    __yo_timer_place(__yo_timers[parent], i);
    i = parent;
  }
  __yo_timer_place(t, i);
}

static void __yo_timer_sift_down(size_t i) {
  __yo_timer_t* t = __yo_timers[i];
  for (;;) {
    size_t child = 2 * i + 1;
    if (child >= __yo_timer_count) break;
    if (child + 1 < __yo_timer_count &&
        __yo_timer_less(__yo_timers[child + 1], __yo_timers[child])) {
      child++;
    }
    if (!__yo_timer_less(__yo_timers[child], t)) break;
    __yo_timer_place(__yo_timers[child], i);
    i = child;
  }
  __yo_timer_place(t, i);
}

// Remove any node: the last one takes its place and moves whichever way
// restores the heap.
static void __yo_timer_remove(__yo_timer_t* t) {
  size_t i = t->index;
  __yo_timer_count--;
  if (i == __yo_timer_count) return;
  __yo_timer_t* last = __yo_timers[__yo_timer_count];
  __yo_timer_place(last, i);
  if (i > 0 && __yo_timer_less(last, __yo_timers[(i - 1) / 2])) {
    __yo_timer_sift_up(i);
  } else {
    __yo_timer_sift_down(i);
  }
}

// Complete a timer the heap no longer holds: result, pending slot, wake, and
// the reference the heap held.
static void __yo_timer_finish(__yo_timer_t* t, int32_t result) {
  __yo_io_future_t* future = t->future;
  future->cancel_fn = NULL;
  future->backend_link = NULL;
  future->result = result;
  __yo_pending_io_count--;
  __yo_io_wake(future);
  __yo_decr_rc((void*)future);
  __yo_free(t);
}

static bool __yo_timer_cancel(__yo_io_future_t* future) {
  __yo_timer_t* t = (__yo_timer_t*)future->backend_link;
  if (!t) return false;
  __yo_timer_remove(t);
  __yo_timer_finish(t, -ECANCELED);
  return true;
}

// Called by the common runtime's Linux sleep path on either backend. A zero
// sleep is due at once and completes on the next loop turn, like the other
// runtimes'.
static void __yo_timer_arm(__yo_io_future_t* future, uint64_t milliseconds) {
  if (__yo_timer_count == __yo_timer_cap) {
    size_t cap = __yo_timer_cap ? __yo_timer_cap * 2 : 16;
    __yo_timer_t** heap = (__yo_timer_t**)__yo_realloc(
        __yo_timers, cap * sizeof(__yo_timer_t*));
    if (!heap) {
      future->result = -ENOMEM;
      { if (future->state != -2) future->state = -1; }
      return;
    }
    __yo_timers = heap;
    __yo_timer_cap = cap;
  }
  __yo_timer_t* t = (__yo_timer_t*)__yo_rc_alloc(sizeof(__yo_timer_t));
  uint64_t span = (milliseconds > (UINT64_MAX / 2000000ull)) ? (UINT64_MAX / 2) : milliseconds * 1000000ull;
  t->deadline_ns = __yo_mono_ns() + span;
  t->seq = __yo_timer_seq++;
  t->future = future;
  __yo_timers[__yo_timer_count] = t;
  __yo_timer_count++;
  __yo_timer_sift_up(__yo_timer_count - 1);
  future->cancel_fn = __yo_timer_cancel;
  future->backend_link = t;
  future->header.ref_count++;
  __yo_pending_io_count++;
}

// Teardown for __yo_io_cleanup (either backend): every armed timer ends
// -ECANCELED and the heap's reference is released. The task still parked on
// each timer is released first, through its ordinary abort path, while the
// future's cancel hook can still deregister the timer
// (__yo_io_teardown_abort_waiters); the abort cancels and REMOVES heap nodes,
// so the pass walks a snapshot of the futures (each still holds the heap's
// reference until its own abort, and the helper holds its own across it).
static void __yo_timer_teardown(void) {
  if (__yo_timer_count > 0) {
    __yo_io_future_t** snapshot = (__yo_io_future_t**)__yo_malloc(__yo_timer_count * sizeof(__yo_io_future_t*));
    if (snapshot) {
      for (size_t i = 0; i < __yo_timer_count; i++) {
        snapshot[i] = __yo_timers[i]->future;
      }
      for (size_t i = 0; i < __yo_timer_count; i++) {
        __yo_io_teardown_abort_waiters(snapshot[i]);
      }
      __yo_free(snapshot);
    }
  }
  for (size_t i = 0; i < __yo_timer_count; i++) {
    __yo_timer_t* t = __yo_timers[i];
    t->future->cancel_fn = NULL;
    t->future->backend_link = NULL;
    t->future->result = -ECANCELED;
    { if (t->future->state != -2) t->future->state = -1; }
    __yo_pending_io_count--;
    __yo_decr_rc((void*)t->future);
    __yo_free(t);
  }
  __yo_free(__yo_timers);
  __yo_timers = NULL;
  __yo_timer_count = 0;
  __yo_timer_cap = 0;
}

// Complete every timer whose deadline has passed, in deadline order.
static int __yo_timer_expire(void) {
  if (__yo_timer_count == 0) return 0;
  uint64_t now = __yo_mono_ns();
  int fired = 0;
  while (__yo_timer_count > 0 && __yo_timers[0]->deadline_ns <= now) {
    __yo_timer_t* t = __yo_timers[0];
    __yo_timer_remove(t);
    __yo_timer_finish(t, 8);
    fired++;
  }
  return fired;
}

// How long a blocking wait may sleep before the earliest timer is due: -1
// with no timer, 0 when one is already due.
static int64_t __yo_timer_wait_ns(void) {
  if (__yo_timer_count == 0) return -1;
  uint64_t now = __yo_mono_ns();
  uint64_t due = __yo_timers[0]->deadline_ns;
  return (due > now) ? (int64_t)(due - now) : 0;
}

// Is anything in flight IN THE KERNEL? Timers are counted in
// __yo_pending_io_count (they keep the loop alive) but live in userspace, so
// a poll whose only pending work is timers needs no syscall.
static inline bool __yo_io_kernel_work(void) {
  return __yo_pending_io_count > __yo_timer_count;
}

// Pending operation types (the readiness family; everything else completes
// synchronously in its op start).
typedef enum {
  __YO_EOP_READ,
  __YO_EOP_WRITE,
  __YO_EOP_ACCEPT,
  __YO_EOP_CONNECT,
  __YO_EOP_SEND,
  __YO_EOP_RECV,
  __YO_EOP_SENDTO,
  __YO_EOP_RECVFROM,
} __yo_epoll_op_type;

typedef struct __yo_epoll_pending_t {
  __yo_epoll_op_type op;
  __yo_io_future_t* future;
  union {
    struct { int fd; void* buf; uint32_t size; } read;
    struct { int fd; const void* buf; uint32_t size; } write;
    struct { int fd; void* addr; uint32_t* addrlen; } accept;
    struct { int fd; } connect;
    struct { int fd; const void* buf; size_t len; int flags; } send;
    struct { int fd; void* buf; size_t len; int flags; } recv;
    // The destination is EMBEDDED, not pointed at: the retry happens at
    // delivery time and the caller's address may be gone by then (the ring
    // path makes the same copy inside __yo_dgram_future_t).
    struct { int fd; const void* buf; size_t len; int flags; struct sockaddr_storage dest; uint32_t addrlen; } sendto;
    struct { int fd; void* buf; size_t len; int flags; void* addr; uint32_t* addrlen; } recvfrom;
  };
  struct __yo_epoll_pending_t* next_waiter;
  struct __yo_epoll_pending_t* prev_waiter;
  uint32_t harvest;  // __yo_io_harvest when it parked
  // The registration whose FIFO this waiter is on (unlink and cancel are
  // O(1): the future reaches its pending through backend_link).
  struct __yo_epoll_reg_t* reg;
} __yo_epoll_pending_t;

// Free list, same overlay trick as the macOS backend: the first word is the
// next pointer while parked on the list; every allocation site re-fills the
// op, the future, and the whole union arm it uses.
static _Thread_local __yo_epoll_pending_t* __yo_epoll_pending_free = NULL;

static __yo_epoll_pending_t* __yo_epoll_alloc_pending(void) {
  if (__yo_epoll_pending_free) {
    __yo_epoll_pending_t* p = __yo_epoll_pending_free;
    __yo_epoll_pending_free = *(__yo_epoll_pending_t**)p;
    return p;
  }
  return (__yo_epoll_pending_t*)__yo_rc_alloc(sizeof(__yo_epoll_pending_t));
}

static void __yo_epoll_free_pending(__yo_epoll_pending_t* p) {
  if (!p) return;
  *(__yo_epoll_pending_t**)p = __yo_epoll_pending_free;
  __yo_epoll_pending_free = p;
}

// A registration is one direction's FIFO of parked waiters on one fd
// (events is EPOLLIN or EPOLLOUT).
typedef struct __yo_epoll_reg_t {
  int fd;
  uint32_t events;
  __yo_epoll_pending_t* waiters_head;
  __yo_epoll_pending_t* waiters_tail;
  struct __yo_epoll_reg_t* next_free;
} __yo_epoll_reg_t;

// One slot per descriptor number (descriptors are small dense integers —
// libuv's watcher array). The kernel holds ONE interest per fd per epoll
// instance, so the slot is the unit the kernel sees
// (issues/fixed/epoll-fallback-hangs-when-one-fd-has-a-parked-reader-and-writer.md).
//
// The interest is EPOLLONESHOT and stays REGISTERED once added: an event
// disarms it, and the next park re-arms it with one EPOLL_CTL_MOD. The
// level-triggered design before this ADDed the interest when a direction's
// first waiter parked and DELeted it when the last one left — two epoll_ctl
// calls around every parked op, five syscalls in all (the failed attempt,
// ADD, the wait, the retry, DEL); now it is four, and a second waiter on an
// armed direction costs none. Nothing is ever armed without a waiter, so an
// idle registered socket cannot wake the loop.
//
// Why not a persistent edge-triggered interest (three syscalls)? It would
// have to be trusted without re-checking, and the table is per THREAD: a
// socket closed on another thread (a worker it was handed to) never reaches
// this thread's close hook, the kernel drops the interest with the file,
// and a reused number would park forever on a registration that no longer
// exists. The per-park MOD is that check — ENOENT means the registration is
// gone and it is ADDed again.
//
//   registered: the fd is in the epoll set (armed or disarmed)
//   armed:      the directions currently armed (0 after an event fired)
//
// epoll_event.data carries the fd itself, never a pointer: an event fetched
// in the same epoll_wait batch as an earlier event that emptied its slot
// finds nothing to do — no memory can go stale.
typedef struct {
  __yo_epoll_reg_t* dir[2];  // [0] EPOLLIN waiters, [1] EPOLLOUT waiters
  uint32_t armed;
  bool registered;
  // The last inline recv would have blocked: park the next one directly
  // (the arm reports data that is already there, so nothing is missed) and
  // save the doomed syscall. Cleared by a recv delivered by the first
  // harvest after it parked (__yo_io_harvest), and when the fd closes. The
  // ring's __YO_RING_FD_RECV_PARKS.
  bool recv_parks;
} __yo_epoll_slot_t;
static _Thread_local __yo_epoll_slot_t* __yo_epoll_slots = NULL;
static _Thread_local size_t __yo_epoll_slot_cap = 0;
static _Thread_local __yo_epoll_reg_t* __yo_epoll_reg_free = NULL;

static inline int __yo_epoll_dir(uint32_t events) {
  return (events & EPOLLOUT) ? 1 : 0;
}

static __yo_epoll_slot_t* __yo_epoll_slot(int fd) {
  if (fd < 0 || (size_t)fd >= __yo_epoll_slot_cap) return NULL;
  return &__yo_epoll_slots[fd];
}

static __yo_epoll_slot_t* __yo_epoll_slot_grow(int fd) {
  if (fd < 0) return NULL;
  if ((size_t)fd >= __yo_epoll_slot_cap) {
    size_t cap = __yo_epoll_slot_cap ? __yo_epoll_slot_cap : 64;
    while (cap <= (size_t)fd) cap *= 2;
    __yo_epoll_slot_t* slots = (__yo_epoll_slot_t*)__yo_realloc(
        __yo_epoll_slots, cap * sizeof(__yo_epoll_slot_t));
    if (!slots) return NULL;
    memset(slots + __yo_epoll_slot_cap, 0,
           (cap - __yo_epoll_slot_cap) * sizeof(__yo_epoll_slot_t));
    __yo_epoll_slots = slots;
    __yo_epoll_slot_cap = cap;
  }
  return &__yo_epoll_slots[fd];
}

// Does fd have a parked waiter in this direction? An inline attempt must
// then queue behind it instead of taking the bytes (or the buffer space) the
// earlier waiter is owed.
static bool __yo_epoll_dir_busy(int fd, int d) {
  __yo_epoll_slot_t* slot = __yo_epoll_slot(fd);
  return slot && slot->dir[d] != NULL;
}

static __yo_epoll_reg_t* __yo_epoll_alloc_reg(void) {
  if (__yo_epoll_reg_free) {
    __yo_epoll_reg_t* r = __yo_epoll_reg_free;
    __yo_epoll_reg_free = r->next_free;
    return r;
  }
  return (__yo_epoll_reg_t*)__yo_rc_alloc(sizeof(__yo_epoll_reg_t));
}

static void __yo_epoll_free_reg(__yo_epoll_reg_t* r) {
  if (!r) return;
  r->next_free = __yo_epoll_reg_free;
  __yo_epoll_reg_free = r;
}

// Arm the fd's one-shot interest for every direction that has waiters. MOD
// when the slot believes the fd is registered, ADD otherwise; ENOENT/EEXIST
// mean the belief was stale (the file was closed behind the runtime's back,
// or the interest survived a slot that forgot it) and switch to the other.
static int __yo_epoll_arm(int fd, __yo_epoll_slot_t* slot) {
  uint32_t mask = (slot->dir[0] ? EPOLLIN : 0u) | (slot->dir[1] ? EPOLLOUT : 0u);
  if (mask == 0 || mask == slot->armed) return 0;
  struct epoll_event ev;
  memset(&ev, 0, sizeof(ev));
  ev.events = mask | EPOLLONESHOT;
  ev.data.fd = fd;
  int rc;
  if (slot->registered) {
    rc = __YO_SC(epoll_ctl(__yo_epoll_fd, EPOLL_CTL_MOD, fd, &ev));
    if (rc < 0 && errno == ENOENT) rc = __YO_SC(epoll_ctl(__yo_epoll_fd, EPOLL_CTL_ADD, fd, &ev));
  } else {
    rc = __YO_SC(epoll_ctl(__yo_epoll_fd, EPOLL_CTL_ADD, fd, &ev));
    if (rc < 0 && errno == EEXIST) rc = __YO_SC(epoll_ctl(__yo_epoll_fd, EPOLL_CTL_MOD, fd, &ev));
  }
  if (rc == 0) {
    slot->registered = true;
    slot->armed = mask;
  }
  return rc;
}

// A registration whose FIFO drained leaves its slot. No epoll_ctl: an armed
// direction nobody waits on any more fires at most once, into an empty
// slot, and is not re-armed.
static void __yo_epoll_release_reg(__yo_epoll_reg_t* reg) {
  __yo_epoll_slot_t* slot = __yo_epoll_slot(reg->fd);
  int d = __yo_epoll_dir(reg->events);
  if (slot && slot->dir[d] == reg) slot->dir[d] = NULL;
  __yo_epoll_free_reg(reg);
}

// Park one op on the (fd, direction) registration, creating it and arming
// the fd's interest on first use. Returns the pending for the CALLER to fill
// (the union arm), or NULL when arming failed. Takes the reference the
// registration holds (the ring's __yo_io_ring_submit has the same contract)
// and the pending-I/O slot.
static __yo_epoll_pending_t* __yo_epoll_park(__yo_epoll_op_type op,
                                             __yo_io_future_t* future,
                                             uint32_t events, int fd) {
  __yo_epoll_slot_t* slot = __yo_epoll_slot_grow(fd);
  if (!slot) return NULL;
  int d = __yo_epoll_dir(events);
  __yo_epoll_reg_t* reg = slot->dir[d];
  bool first = false;
  if (!reg) {
    reg = __yo_epoll_alloc_reg();
    reg->fd = fd;
    reg->events = events;
    reg->waiters_head = NULL;
    reg->waiters_tail = NULL;
    slot->dir[d] = reg;
    first = true;
  }
  if (__yo_epoll_arm(fd, slot) < 0) {
    if (first) __yo_epoll_release_reg(reg);
    return NULL;
  }
  __yo_epoll_pending_t* pending = __yo_epoll_alloc_pending();
  if (!pending) {
    if (first) __yo_epoll_release_reg(reg);
    return NULL;
  }
  pending->op = op;
  pending->future = future;
  pending->harvest = __yo_io_harvest;
  pending->reg = reg;
  pending->next_waiter = NULL;
  pending->prev_waiter = reg->waiters_tail;
  if (reg->waiters_tail) {
    reg->waiters_tail->next_waiter = pending;
  } else {
    reg->waiters_head = pending;
  }
  reg->waiters_tail = pending;
  future->backend_link = pending;
  future->header.ref_count++;
  __yo_pending_io_count++;
  return pending;
}

// Take a waiter off its registration's FIFO.
static void __yo_epoll_unlink(__yo_epoll_pending_t* p) {
  __yo_epoll_reg_t* reg = p->reg;
  if (p->prev_waiter) {
    p->prev_waiter->next_waiter = p->next_waiter;
  } else {
    reg->waiters_head = p->next_waiter;
  }
  if (p->next_waiter) {
    p->next_waiter->prev_waiter = p->prev_waiter;
  } else {
    reg->waiters_tail = p->prev_waiter;
  }
  p->future->backend_link = NULL;
}

// Complete an unlinked waiter: release the loop's pending-I/O slot, wake the
// continuation, drop the reference the registration held — the same
// sequence the ring's CQE path runs (count, wake, decr).
static void __yo_epoll_finish(__yo_epoll_pending_t* pending) {
  __yo_pending_io_count--;
  __yo_io_wake(pending->future);
  __yo_decr_rc((void*)pending->future);
  __yo_epoll_free_pending(pending);
}

// Service a delivered registration: walk waiters FIFO, retrying each op
// until one would block (a spurious wakeup, or an earlier waiter consuming
// the readiness). A would-block waiter stays parked; the caller re-arms the
// fd for whatever is still waiting. When the FIFO drains, the registration
// is released.
static void __yo_epoll_process_reg(__yo_epoll_reg_t* reg) {
  while (reg->waiters_head) {
    __yo_epoll_pending_t* pending = reg->waiters_head;
    bool would_block = false;
    switch (pending->op) {
      case __YO_EOP_READ: {
        ssize_t r = __YO_SC(read(pending->read.fd, pending->read.buf, pending->read.size));
        if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
          pending->future->result = (r < 0) ? -errno : (int32_t)r;
        } else {
          would_block = true;
        }
        break;
      }
      case __YO_EOP_WRITE: {
        ssize_t r = __YO_SC(write(pending->write.fd, pending->write.buf, pending->write.size));
        if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
          pending->future->result = (r < 0) ? -errno : (int32_t)r;
        } else {
          would_block = true;
        }
        break;
      }
      case __YO_EOP_ACCEPT: {
        // accept4's SOCK_NONBLOCK: POSIX accept(2) does not give the accepted
        // socket the listener's O_NONBLOCK, and every socket this runtime
        // creates is nonblocking (the ring's IORING_OP_ACCEPT passes the same
        // flag).
        int r = __YO_SC(accept4(pending->accept.fd, (struct sockaddr*)pending->accept.addr,
                                (socklen_t*)pending->accept.addrlen, SOCK_NONBLOCK));
        if (r >= 0) {
          pending->future->result = r;
        } else if (errno == EAGAIN || errno == EWOULDBLOCK) {
          would_block = true;
        } else {
          pending->future->result = -errno;
        }
        break;
      }
      case __YO_EOP_CONNECT: {
        // Connect readiness is terminal: the SO_ERROR answer never
        // would-blocks, so every queued connect completes on this delivery.
        int so_error = 0;
        socklen_t len = sizeof(so_error);
        __YO_SC(getsockopt(pending->connect.fd, SOL_SOCKET, SO_ERROR, &so_error, &len));
        pending->future->result = (so_error == 0) ? 0 : -so_error;
        break;
      }
      case __YO_EOP_SEND: {
        ssize_t r = __YO_SC(send(pending->send.fd, pending->send.buf, pending->send.len,
                                 pending->send.flags | MSG_DONTWAIT));
        if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
          pending->future->result = (r < 0) ? -errno : (int32_t)r;
        } else {
          would_block = true;
        }
        break;
      }
      case __YO_EOP_RECV: {
        ssize_t r = __YO_SC(recv(pending->recv.fd, pending->recv.buf, pending->recv.len,
                                 pending->recv.flags | MSG_DONTWAIT));
        if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
          pending->future->result = (r < 0) ? -errno : (int32_t)r;
          if (r >= 0 && pending->harvest + 1 == __yo_io_harvest) {
            __yo_epoll_slot_t* rs = __yo_epoll_slot(pending->recv.fd);
            if (rs) rs->recv_parks = false;
          }
        } else {
          would_block = true;
        }
        break;
      }
      case __YO_EOP_SENDTO: {
        ssize_t r = __YO_SC(sendto(pending->sendto.fd, pending->sendto.buf, pending->sendto.len,
                                   pending->sendto.flags | MSG_DONTWAIT,
                                   (const struct sockaddr*)&pending->sendto.dest,
                                   (socklen_t)pending->sendto.addrlen));
        if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
          pending->future->result = (r < 0) ? -errno : (int32_t)r;
        } else {
          would_block = true;
        }
        break;
      }
      case __YO_EOP_RECVFROM: {
        ssize_t r = __YO_SC(recvfrom(pending->recvfrom.fd, pending->recvfrom.buf, pending->recvfrom.len,
                                     pending->recvfrom.flags | MSG_DONTWAIT,
                                     (struct sockaddr*)pending->recvfrom.addr,
                                     (socklen_t*)pending->recvfrom.addrlen));
        if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
          pending->future->result = (r < 0) ? -errno : (int32_t)r;
        } else {
          would_block = true;
        }
        break;
      }
    }
    if (would_block) break;
    __yo_epoll_unlink(pending);
    __yo_epoll_finish(pending);
  }
  if (!reg->waiters_head) __yo_epoll_release_reg(reg);
}

// The eventfd wake channel fired: drain it (level-triggered would keep
// reporting otherwise). The wake itself is picked up by
// __yo_async_drain_xwakes at the top of the next tick — identical contract
// to the ring backend's NOTIFY UD CQE.
static void __yo_epoll_process_notify(void) {
  uint64_t v;
  while (read(__yo_notify_efd, &v, sizeof(v)) == (ssize_t)sizeof(v)) {
  }
}

// Abort one parked op. The found waiter completes with -ECANCELED, exactly
// what a cancelled ring op's CQE reports.
static bool __yo_epoll_cancel(__yo_io_future_t* future) {
  __yo_epoll_pending_t* p = (__yo_epoll_pending_t*)future->backend_link;
  if (!p) return false;
  __yo_epoll_reg_t* reg = p->reg;
  __yo_epoll_unlink(p);
  future->result = -ECANCELED;
  __yo_epoll_finish(p);
  if (!reg->waiters_head) __yo_epoll_release_reg(reg);
  return true;
}

// An fd is about to be closed: fail its waiters with -EBADF and remove its
// interest. The kernel drops the interest itself only when the LAST
// descriptor for the file closes — a dup'd socket would keep it, parked
// waiters would never be delivered, and a reused fd number would inherit a
// stale registration.
static void __yo_epoll_drop_fd(int fd) {
  __yo_epoll_slot_t* slot = __yo_epoll_slot(fd);
  if (!slot) return;
  for (int d = 0; d < 2; d++) {
    __yo_epoll_reg_t* reg = slot->dir[d];
    if (!reg) continue;
    slot->dir[d] = NULL;
    __yo_epoll_pending_t* p = reg->waiters_head;
    while (p) {
      __yo_epoll_pending_t* next = p->next_waiter;
      p->future->backend_link = NULL;
      p->future->result = -EBADF;
      __yo_epoll_finish(p);
      p = next;
    }
    __yo_epoll_free_reg(reg);
  }
  if (slot->registered) {
    struct epoll_event ev;
    memset(&ev, 0, sizeof(ev));
    __YO_SC(epoll_ctl(__yo_epoll_fd, EPOLL_CTL_DEL, fd, &ev));
    slot->registered = false;
  }
  slot->armed = 0;
  slot->recv_parks = false;
}

// --- Future helpers ---------------------------------------------------------

static __yo_io_future_t* __yo_io_new_future(void) {
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  return future;
}

// The DEGRADED rung and the sync-completion family share this: a future
// that is already done carrying result.
static __yo_io_future_t* __yo_io_done_future(int32_t result) {
  __yo_io_future_t* future = __yo_io_new_future();
  future->result = result;
  { if (future->state != -2) future->state = -1; }
  return future;
}

// --- The loop drivers --------------------------------------------------------

// epoll_pwait2 (Linux 5.11) takes a timespec, so a 1 ms sleep waits ~1 ms
// instead of epoll_wait's whole-millisecond timeout rounded UP to 2. Tried
// once; a kernel (or a seccomp profile) without it reports ENOSYS/EPERM and
// the thread uses epoll_wait from then on.
#ifndef __NR_epoll_pwait2
#define __NR_epoll_pwait2 441
#endif
static _Thread_local bool __yo_epoll_no_pwait2 = false;

static int __yo_epoll_wait_ns(struct epoll_event* events, int max, int64_t timeout_ns) {
  if (timeout_ns > 0 && !__yo_epoll_no_pwait2) {
    struct timespec ts;
    ts.tv_sec = (time_t)(timeout_ns / 1000000000);
    ts.tv_nsec = (long)(timeout_ns % 1000000000);
    long n = syscall(__NR_epoll_pwait2, __yo_epoll_fd, events, max, &ts, NULL, 0);
    if (n >= 0 || (errno != ENOSYS && errno != EPERM)) return (int)n;
    __yo_epoll_no_pwait2 = true;
  }
  int ms;
  if (timeout_ns < 0) {
    ms = -1;
  } else {
    int64_t up = (timeout_ns + 999999) / 1000000;
    ms = (up > INT32_MAX) ? INT32_MAX : (int)up;
  }
  return epoll_wait(__yo_epoll_fd, events, max, ms);
}

// One epoll pass plus dispatch. block: wait until an event, a wake or the
// earliest timer deadline; otherwise poll without waiting. The wake channel
// and the watch set are recognised by their descriptors.
static void __yo_epoll_drive(bool block, int* count_out) {
  struct epoll_event events[64];
  int64_t timeout_ns = 0;
  if (block) {
    timeout_ns = -1;
    if (__yo_timer_count > 0) {
      uint64_t now = __yo_mono_ns();
      uint64_t due = __yo_timers[0]->deadline_ns;
      timeout_ns = (due > now) ? (int64_t)(due - now) : 0;
    }
  }
  int n;
  __yo_stats_kernel_enters++;
  __yo_io_harvest++;
  if (timeout_ns == 0) __yo_stats_zero_timeout_enters++;
  do {
    n = __yo_epoll_wait_ns(events, 64, timeout_ns);
  } while (n < 0 && errno == EINTR);
  int count = 0;
  for (int i = 0; i < n; i++) {
    int fd = events[i].data.fd;
    uint32_t rev = events[i].events;
    if (fd == __yo_notify_efd) {
      __yo_epoll_process_notify();
      continue;
    }
    if (fd == __yo_watch_epfd) {
      // A watched fd is ready: the tick that follows services the handles.
      count++;
      continue;
    }
    __yo_epoll_slot_t* slot = __yo_epoll_slot(fd);
    if (!slot) continue;
    // The one-shot interest fired and is disarmed now.
    slot->armed = 0;
    // Service every direction the event covers; ERR/HUP wake both — the
    // retried syscall reports the error. Wakes only queue tasks, so the
    // slot table cannot move under this loop (only a park grows it).
    bool err = (rev & (EPOLLERR | EPOLLHUP)) != 0;
    for (int d = 0; d < 2; d++) {
      __yo_epoll_reg_t* reg = slot->dir[d];
      if (reg && (err || (rev & reg->events))) {
        __yo_epoll_process_reg(reg);
        count++;
      }
    }
    // Whoever is still waiting (a would-block retry, the other direction)
    // needs the interest back.
    if (slot->dir[0] || slot->dir[1]) {
      if (__yo_epoll_arm(fd, slot) < 0) {
        // The fd cannot be armed any more (closed behind the runtime's
        // back): its waiters could never be delivered, so fail them now.
        __yo_epoll_drop_fd(fd);
      }
    }
  }
  count += __yo_timer_expire();
  *count_out = count;
}

// --- Op twins ----------------------------------------------------------------
// Each mirrors its ring op start's signature and completion shape. Regular
// files and the ops epoll cannot express complete synchronously in the
// future — macOS's documented behavior (runtime_io_macos.yo), which is the
// platform floor this fallback deliberately matches.

// Positioned first: pread answers a regular file (or block device) in one
// syscall, and anything that cannot seek says ESPIPE and takes the
// readiness path. This used to fstat every read to decide — two syscalls
// for a file read where one does.
static __yo_io_future_t* __yo_epoll_read_start(int32_t fd, void* buffer, uint32_t size, uint64_t offset) {
  if (!__yo_epoll_dir_busy(fd, 0)) {
    ssize_t r = __YO_SC(pread(fd, buffer, size, (off_t)offset));
    if (r >= 0 || errno != ESPIPE) {
      return __yo_io_done_future((r < 0) ? -errno : (int32_t)r);
    }
    r = __YO_SC(read(fd, buffer, size));
    if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
      return __yo_io_done_future((r < 0) ? -errno : (int32_t)r);
    }
  }
  __yo_io_future_t* future = __yo_io_new_future();
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_READ, future, EPOLLIN, fd);
  if (!p) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  p->read.fd = fd;
  p->read.buf = buffer;
  p->read.size = size;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

// pwrite on Linux appends on an O_APPEND descriptor whatever the offset (a
// documented deviation from POSIX, and exactly the ring's IORING_OP_WRITE
// behavior), so one positioned call covers plain and append files alike —
// the old fstat + F_GETFL + write/pwrite was three syscalls.
static __yo_io_future_t* __yo_epoll_write_start(int32_t fd, const void* buffer, uint32_t size, uint64_t offset) {
  if (!__yo_epoll_dir_busy(fd, 1)) {
    ssize_t w = __YO_SC(pwrite(fd, buffer, size, (off_t)offset));
    if (w >= 0 || errno != ESPIPE) {
      return __yo_io_done_future((w < 0) ? -errno : (int32_t)w);
    }
    w = __YO_SC(write(fd, buffer, size));
    if (w >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
      return __yo_io_done_future((w < 0) ? -errno : (int32_t)w);
    }
  }
  __yo_io_future_t* future = __yo_io_new_future();
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_WRITE, future, EPOLLOUT, fd);
  if (!p) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  p->write.fd = fd;
  p->write.buf = buffer;
  p->write.size = size;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

static __yo_io_future_t* __yo_inline_openat_start(int32_t dirfd, const char* path, int32_t flags, int32_t mode) {
  int r = openat(dirfd, path, flags, (mode_t)mode);
  return __yo_io_done_future((r < 0) ? -errno : r);
}

static __yo_io_future_t* __yo_epoll_close_start(int32_t fd) {
  __yo_epoll_drop_fd(fd);
  int r = close(fd);
  return __yo_io_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_inline_statx_start(int32_t dirfd, const char* path, int32_t flags, uint32_t mask, void* statxbuf) {
  int r = statx(dirfd, path, flags, mask, (struct statx*)statxbuf);
  return __yo_io_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_inline_mkdirat_start(int32_t dirfd, const char* path, int32_t mode) {
  int r = mkdirat(dirfd, path, (mode_t)mode);
  return __yo_io_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_inline_unlinkat_start(int32_t dirfd, const char* path, int32_t flags) {
  int r = unlinkat(dirfd, path, flags);
  return __yo_io_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_inline_renameat_start(int32_t olddirfd, const char* oldpath, int32_t newdirfd, const char* newpath) {
  int r = renameat(olddirfd, oldpath, newdirfd, newpath);
  return __yo_io_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_inline_symlinkat_start(const char* target, int32_t newdirfd, const char* linkpath) {
  int r = symlinkat(target, newdirfd, linkpath);
  return __yo_io_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_inline_linkat_start(int32_t olddirfd, const char* oldpath, int32_t newdirfd, const char* newpath, int32_t flags) {
  int r = linkat(olddirfd, oldpath, newdirfd, newpath, flags);
  return __yo_io_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_inline_fsync_start(int32_t fd) {
  int r = fsync(fd);
  return __yo_io_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_inline_fdatasync_start(int32_t fd) {
  int r = fdatasync(fd);
  return __yo_io_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_inline_ftruncate_start(int32_t fd, int64_t length) {
  int r = ftruncate(fd, (off_t)length);
  return __yo_io_done_future((r < 0) ? -errno : 0);
}

static __yo_io_future_t* __yo_epoll_accept_start(int32_t sockfd, void* addr, uint32_t* addrlen) {
  if (!__yo_epoll_dir_busy(sockfd, 0)) {
    int r = __YO_SC(accept4(sockfd, (struct sockaddr*)addr, (socklen_t*)addrlen, SOCK_NONBLOCK));
    if (r >= 0) {
      return __yo_io_done_future(r);
    }
    if (errno != EAGAIN && errno != EWOULDBLOCK) {
      return __yo_io_done_future(-errno);
    }
  }
  __yo_io_future_t* future = __yo_io_new_future();
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_ACCEPT, future, EPOLLIN, sockfd);
  if (!p) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  p->accept.fd = sockfd;
  p->accept.addr = addr;
  p->accept.addrlen = addrlen;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

static __yo_io_future_t* __yo_epoll_connect_start(int32_t sockfd, const void* addr, uint32_t addrlen) {
  int r = __YO_SC(connect(sockfd, (const struct sockaddr*)addr, (socklen_t)addrlen));
  if (r == 0) {
    return __yo_io_done_future(0);
  }
  // Only EINPROGRESS means "the handshake is under way; writability reports
  // its outcome". EAGAIN is AF_UNIX's full listen backlog: nothing is in
  // progress, and an unconnected unix socket polls writable at once, so
  // parking it would report SO_ERROR == 0 — success for a connection that
  // was never made. Readiness cannot express "the backlog has room"; the
  // honest answer for a nonblocking socket is the EAGAIN itself (libuv's
  // choice too). The ring backend instead retries the connect blocking on
  // io-wq, so there it succeeds late rather than failing fast.
  if (errno != EINPROGRESS) {
    return __yo_io_done_future(-errno);
  }
  __yo_io_future_t* future = __yo_io_new_future();
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_CONNECT, future, EPOLLOUT, sockfd);
  if (!p) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  p->connect.fd = sockfd;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

static __yo_io_future_t* __yo_epoll_send_start(int32_t sockfd, const void* buf, size_t len, int32_t flags) {
  if (!__yo_epoll_dir_busy(sockfd, 1)) {
    ssize_t r = __YO_SC(send(sockfd, buf, len, flags | MSG_DONTWAIT));
    if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
      return __yo_io_done_future((r < 0) ? -errno : (int32_t)r);
    }
  }
  __yo_io_future_t* future = __yo_io_new_future();
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_SEND, future, EPOLLOUT, sockfd);
  if (!p) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  p->send.fd = sockfd;
  p->send.buf = buf;
  p->send.len = len;
  p->send.flags = flags;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

static __yo_io_future_t* __yo_epoll_recv_start(int32_t sockfd, void* buf, size_t len, int32_t flags) {
  __yo_epoll_slot_t* hint = __yo_epoll_slot(sockfd);
  if (!__yo_epoll_dir_busy(sockfd, 0) && !(hint && hint->recv_parks)) {
    ssize_t r = __YO_SC(recv(sockfd, buf, len, flags | MSG_DONTWAIT));
    if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
      return __yo_io_done_future((r < 0) ? -errno : (int32_t)r);
    }
    __yo_stats_recv_would_block++;
    __yo_epoll_slot_t* slot = __yo_epoll_slot_grow(sockfd);
    if (slot) slot->recv_parks = true;
  }
  __yo_io_future_t* future = __yo_io_new_future();
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_RECV, future, EPOLLIN, sockfd);
  if (!p) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  p->recv.fd = sockfd;
  p->recv.buf = buf;
  p->recv.len = len;
  p->recv.flags = flags;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

// The datagram twins take over AFTER the shared inline fast path reports
// would-block (or declines to run behind a parked waiter) — the same point
// the ring path arms SENDMSG/RECVMSG.
static __yo_io_future_t* __yo_epoll_sendto_park(int32_t sockfd, const void* buf, size_t len, int32_t flags,
                                                const void* dest_addr, uint32_t addrlen,
                                                __yo_io_future_t* future) {
  if (addrlen > sizeof(struct sockaddr_storage)) {
    future->result = -EINVAL;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_SENDTO, future, EPOLLOUT, sockfd);
  if (!p) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  p->sendto.fd = sockfd;
  p->sendto.buf = buf;
  p->sendto.len = len;
  p->sendto.flags = flags;
  memcpy(&p->sendto.dest, dest_addr, addrlen);
  p->sendto.addrlen = addrlen;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

static __yo_io_future_t* __yo_epoll_recvfrom_park(int32_t sockfd, void* buf, size_t len, int32_t flags,
                                                  void* src_addr, uint32_t* addrlen,
                                                  __yo_io_future_t* future) {
  __yo_epoll_pending_t* p = __yo_epoll_park(__YO_EOP_RECVFROM, future, EPOLLIN, sockfd);
  if (!p) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  p->recvfrom.fd = sockfd;
  p->recvfrom.buf = buf;
  p->recvfrom.len = len;
  p->recvfrom.flags = flags;
  p->recvfrom.addr = src_addr;
  p->recvfrom.addrlen = addrlen;
  future->cancel_fn = __yo_epoll_cancel;
  return future;
}

// Teardown for __yo_io_cleanup: fail everything still parked with
// -ECANCELED (a closed epoll fd would silently drop their interests), then
// release the epoll descriptor (the timers are __yo_timer_teardown's). The
// pending count is zeroed so a re-init does not inherit a permanently-pending
// number. The free lists stay: their nodes are rc-allocated and pooled like
// every other runtime node. The task parked on each operation is released
// first, through its ordinary abort path, while the future's cancel hook can
// still deregister the operation (__yo_io_teardown_abort_waiters); the abort
// unlinks and frees pendings (and can release their registrations), so the
// pass walks a snapshot of the futures and the drain below re-reads every
// slot.
static void __yo_epoll_teardown(void) {
  {
    size_t abortable = 0;
    for (size_t fd = 0; fd < __yo_epoll_slot_cap; fd++) {
      __yo_epoll_slot_t* slot = &__yo_epoll_slots[fd];
      for (int d = 0; d < 2; d++) {
        __yo_epoll_reg_t* reg = slot->dir[d];
        if (!reg) continue;
        for (__yo_epoll_pending_t* pw = reg->waiters_head; pw; pw = pw->next_waiter) {
          abortable++;
        }
      }
    }
    if (abortable > 0) {
      __yo_io_future_t** snapshot = (__yo_io_future_t**)__yo_malloc(abortable * sizeof(__yo_io_future_t*));
      if (snapshot) {
        size_t n = 0;
        for (size_t fd = 0; fd < __yo_epoll_slot_cap; fd++) {
          __yo_epoll_slot_t* slot = &__yo_epoll_slots[fd];
          for (int d = 0; d < 2; d++) {
            __yo_epoll_reg_t* reg = slot->dir[d];
            if (!reg) continue;
            for (__yo_epoll_pending_t* pw = reg->waiters_head; pw; pw = pw->next_waiter) {
              snapshot[n++] = pw->future;
            }
          }
        }
        for (n = 0; n < abortable; n++) {
          __yo_io_teardown_abort_waiters(snapshot[n]);
        }
        __yo_free(snapshot);
      }
    }
  }
  for (size_t fd = 0; fd < __yo_epoll_slot_cap; fd++) {
    __yo_epoll_slot_t* slot = &__yo_epoll_slots[fd];
    for (int d = 0; d < 2; d++) {
      __yo_epoll_reg_t* reg = slot->dir[d];
      if (!reg) continue;
      __yo_epoll_pending_t* pw = reg->waiters_head;
      while (pw) {
        __yo_epoll_pending_t* nx = pw->next_waiter;
        pw->future->backend_link = NULL;
        pw->future->result = -ECANCELED;
        { if (pw->future->state != -2) pw->future->state = -1; }
        __yo_decr_rc((void*)pw->future);
        __yo_epoll_free_pending(pw);
        pw = nx;
      }
      __yo_epoll_free_reg(reg);
    }
  }
  __yo_free(__yo_epoll_slots);
  __yo_epoll_slots = NULL;
  __yo_epoll_slot_cap = 0;
  __yo_pending_io_count = 0;
  close(__yo_epoll_fd);
  __yo_epoll_fd = -1;
}

// Is an operation of this direction (0 in, 1 out) already queued or parked
// on fd, on whichever backend this thread runs? An inline attempt must then
// wait its turn: it would take the bytes, or the buffer space, that the
// earlier operation is owed.
static bool __yo_io_fd_busy(int fd, int dir) {
  if (__yo_backend == __YO_BACKEND_EPOLL) return __yo_epoll_dir_busy(fd, dir);
  if (__yo_backend == __YO_BACKEND_URING) return __yo_ring_fd_busy(fd, (uint8_t)dir);
  return false;
}

// Extended future for the datagram ops (sendto/recvfrom). __YO_IORING_OP_SENDMSG/
// RECVMSG take a struct msghdr that must remain valid until the CQE is reaped
// (the kernel reads the iovec and the destination address lazily, and RECVMSG
// WRITES msg_name/msg_namelen at completion time), so the msghdr, the iovec
// and — for sendto — a copy of the destination address live in the same
// allocation as the future and are freed with it.
typedef struct {
  __yo_io_future_t base;
  struct msghdr msg;
  struct iovec iov;
  struct sockaddr_storage dest;  // sendto: the destination address copy
  uint32_t* addrlen_out;         // recvfrom: caller's in/out length, written at CQE
} __yo_dgram_future_t;

// Ring cancellation for a datagram future. Also serves as its TYPE TAG:
// __yo_io_process_cqe compares cancel_fn against this function to learn that
// the completion path may read the __yo_dgram_future_t extension — only
// futures allocated with that shape carry it.
static bool __yo_dgram_future_cancel(__yo_io_future_t* future) {
  return __yo_io_ring_submit_cancel(future);
}


// Process completions from CQ
// The future pointer is stored directly in the SQE user data
static void __yo_io_process_cqe(struct __yo_uring_cqe* cqe) {
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_uring_cqe_get_data(cqe);
  if ((void*)future == __YO_IO_NOTIFY_UD) {
    // The wakeup channel fired. It carries no operation — draining the
    // eventfd and re-arming is all there is to do; the foreign wake itself is
    // picked up by __yo_async_drain_xwakes at the top of the next tick.
    uint64_t v;
    while (__yo_notify_efd >= 0 && read(__yo_notify_efd, &v, sizeof(v)) == (ssize_t)sizeof(v)) {
    }
    __yo_uring_cqe_seen(&__yo_io_ring, cqe);
    __yo_io_arm_notify();
    return;
  }
  if ((void*)future == __YO_IO_TIMEOUT_UD) {
    // The pre-5.11 bounded wait's timeout (-ETIME) or its cancellation: it
    // only ended a wait. The due timers complete in the reap after it.
    __yo_ring_wait_armed_ns = 0;
    __yo_uring_cqe_seen(&__yo_io_ring, cqe);
    return;
  }
  if ((void*)future == __YO_IO_WATCH_UD) {
    // A watched fd is ready. The wait returns and the poll that follows
    // ticks the handles; the next wait re-arms.
    __yo_watch_ring_armed = false;
    __yo_uring_cqe_seen(&__yo_io_ring, cqe);
    return;
  }
  if (!future) {
    // Completion of a cancellation SQE (__yo_io_ring_submit_cancel): it owns
    // no future and no pending-I/O slot. The cancelled operation reports
    // separately, through its own CQE.
    __yo_uring_cqe_seen(&__yo_io_ring, cqe);
    return;
  }
  __yo_pending_io_count--;

  // Set the result. An fd-bound op cancelled because its descriptor closed
  // (__yo_ring_drop_fd) reports -EBADF, the kqueue/epoll backends' answer.
  bool fd_closed = __yo_ring_untrack_fd(future, cqe->res);
  future->result = cqe->res;
  if (fd_closed && future->result == -ECANCELED) future->result = -EBADF;
  
  ASYNC_DEBUG("[Io] Completed I/O: result=%d (pending=%zu)\\n",
              future->result, __yo_pending_io_count);
  
  // Mark as completed (state -1 = done)
  { if (future->state != -2) future->state = -1; }

  // Post-completion op hooks, BEFORE the continuation runs so a resumed task
  // observes them. cancel_fn identity is each op's type tag (see the
  // __yo_dgram_future_cancel comment) — only futures allocated with the
  // matching shape reach their case, so the extension reads stay inside their
  // allocations.
  if (future->cancel_fn == __yo_dgram_future_cancel) {
    // RECVMSG wrote the sender's address into the caller's buffer and its
    // length into our msghdr; hand the length to the caller's in/out pointer,
    // which is what recvfrom(2) would have done synchronously.
    __yo_dgram_future_t* df = (__yo_dgram_future_t*)future;
    if (df->addrlen_out) {
      *df->addrlen_out = (uint32_t)df->msg.msg_namelen;
    }
  }

  // Wake continuation if registered
  void (*cont_fn)(void*) = future->continuation_fn;
  void* cont_sm = future->continuation_sm;
  
  ASYNC_DEBUG("[Io] Continuation check: cont_fn=%p, cont_sm=%p\\n", (void*)cont_fn, cont_sm);
  
  if (cont_fn && cont_sm) {
    ASYNC_DEBUG("[Io] Spawning continuation for I/O completion\\n");
    __yo_async_spawn_task(cont_fn, cont_sm);
  }

  __yo_uring_cqe_seen(&__yo_io_ring, cqe);
  
  // Release the io_uring event loop reference.
  // This must be AFTER __yo_uring_cqe_seen and AFTER reading all future fields,
  // because decr_rc may free the future if user already dropped their ref.
  __yo_decr_rc((void*)future);
}

// Add, change (events != 0) or remove (events == 0) fd in the watch set.
// Called by the common runtime when a poll/fs-event handle starts or stops;
// brings the backend up, since a watch can start before any I/O. Returns 0
// or -errno — -EPERM for a descriptor epoll cannot watch (a regular file).
static int32_t __yo_io_watch_set(int32_t fd, uint32_t events) {
  __yo_io_init();
  if (__yo_watch_epfd < 0) {
    if (events == 0) return 0;
    __yo_watch_epfd = epoll_create1(EPOLL_CLOEXEC);
    if (__yo_watch_epfd < 0) return -errno;
  }
  struct epoll_event ev;
  memset(&ev, 0, sizeof(ev));
  ev.events = events;
  ev.data.fd = fd;
  if (events == 0) {
    (void)epoll_ctl(__yo_watch_epfd, EPOLL_CTL_DEL, fd, &ev);
    return 0;
  }
  int rc = epoll_ctl(__yo_watch_epfd, EPOLL_CTL_MOD, fd, &ev);
  if (rc < 0 && errno == ENOENT) rc = epoll_ctl(__yo_watch_epfd, EPOLL_CTL_ADD, fd, &ev);
  return (rc < 0) ? -errno : 0;
}

// Before a blocking wait: let a ready watched fd end it. The ring arms one
// POLL_ADD on the watch set (one-shot; re-armed by the next wait after it
// fires), the epoll backend adds the set to its own, level-triggered, once.
static void __yo_io_arm_watches(void) {
  if (__yo_watch_epfd < 0) return;
  if (__yo_backend == __YO_BACKEND_URING) {
    if (__yo_watch_ring_armed) return;
    struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
    if (!sqe) return;
    __yo_uring_prep_poll_add(sqe, __yo_watch_epfd, POLLIN);
    __yo_uring_sqe_set_data(sqe, __YO_IO_WATCH_UD);
    __yo_sq_deferred_futures[(__yo_sq_deferred_head + __yo_sq_unsubmitted) % __YO_IO_RING_ENTRIES] = NULL;
    __yo_sq_unsubmitted++;
    __yo_watch_ring_armed = true;
  } else if (__yo_backend == __YO_BACKEND_EPOLL) {
    if (__yo_watch_in_epoll) return;
    struct epoll_event ev;
    memset(&ev, 0, sizeof(ev));
    ev.events = EPOLLIN;
    ev.data.fd = __yo_watch_epfd;
    if (__YO_SC(epoll_ctl(__yo_epoll_fd, EPOLL_CTL_ADD, __yo_watch_epfd, &ev)) == 0) {
      __yo_watch_in_epoll = true;
    }
  }
}


static void __yo_ring_arm_wait_timeout(int64_t timeout_ns) {
  uint64_t deadline = __yo_mono_ns() + (uint64_t)timeout_ns;
  if (__yo_ring_wait_armed_ns != 0 && __yo_ring_wait_armed_ns <= deadline) return;
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) return;
  __yo_ring_wait_ts.tv_sec = timeout_ns / 1000000000;
  __yo_ring_wait_ts.tv_nsec = timeout_ns % 1000000000;
  __yo_uring_prep_timeout(sqe, &__yo_ring_wait_ts);
  __yo_uring_sqe_set_data(sqe, __YO_IO_TIMEOUT_UD);
  __yo_sq_deferred_futures[(__yo_sq_deferred_head + __yo_sq_unsubmitted) % __YO_IO_RING_ENTRIES] = NULL;
  __yo_sq_unsubmitted++;
  __yo_ring_wait_armed_ns = deadline;
}

// Everything the loop learns without entering the kernel again: the CQEs
// already in the ring, the due timers, and the watch handles' tick.
static int __yo_ring_reap(void) {
  struct __yo_uring_cqe* cqes[64];
  int count = 0;
  unsigned n;
  while ((n = __yo_uring_peek_batch_cqe(&__yo_io_ring, cqes, 64)) > 0) {
    for (unsigned i = 0; i < n; ++i) {
      __yo_io_process_cqe(cqes[i]);
      count++;
    }
    if (n < 64) break;
  }
  count += __yo_timer_expire();
  count += __yo_poll_and_fs_event_tick();
  if (count > 0) {
    ASYNC_DEBUG("[Io] Polled %d completions\\n", count);
  }
  return count;
}

// Poll for I/O completions (non-blocking)
static int __yo_io_poll(void) {
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    // Only descriptors need epoll_wait; a poll whose pending work is all
    // timers (or nothing) costs no syscall.
    int n = 0;
    if (__yo_io_kernel_work()) {
      __yo_epoll_drive(false, &n);
    } else {
      n = __yo_timer_expire();
    }
    return n + __yo_poll_and_fs_event_tick();
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_poll_and_fs_event_tick();
  }
  // No ring yet: nothing was submitted, so nothing can complete.
  if (!__yo_io_initialized) {
    return __yo_poll_and_fs_event_tick();
  }
  // The ring runs with __YO_IORING_SETUP_DEFER_TASKRUN (see __yo_io_init): the
  // kernel materialises completions only when this thread enters it with
  // __YO_IORING_ENTER_GETEVENTS. A pure-userspace peek therefore never sees a
  // socket complete while some task is always ready and the loop never
  // reaches __yo_io_wait — a poll-until-finished race spun forever on Linux
  // while macOS (kqueue always syscalls) was fine
  // (issues/fixed/io-uring-defer-taskrun-poll-never-enters-kernel.md).
  // A zero-timeout GETEVENTS enter is that non-blocking entry; it consumes
  // nothing. Queued SQEs ride the SAME enter: submitting them first in a
  // separate enter cost every op that completes at issue two syscalls
  // (issues/fixed/io-uring-poll-submits-and-reaps-in-two-enters.md).
  //
  // With nothing queued and nothing in flight in the kernel there is nothing
  // to reap, so a loop that is only running tasks (a CPU-bound fan-out, a
  // yield loop, a set of sleeps) pays no syscall per tick. The wake channel's
  // POLL_ADD is deliberately not "in flight" here: a cross-thread wake is
  // seen through xwake_count, and its CQE is reaped by the next enter that
  // does happen.
  if (__yo_sq_unsubmitted > 0) {
    int ret;
    do {
      ret = __yo_uring_submit_and_wait(&__yo_io_ring, 0);
    } while (ret == -EINTR);
    __yo_io_account_submitted(ret);
  } else if (__yo_io_kernel_work()) {
    (void)__yo_uring_getevents(&__yo_io_ring);
  }
  return __yo_ring_reap();
}

// Wait for at least one I/O completion (blocking)
static int __yo_io_wait(void) {
  // Started watches: make a ready watched fd end the wait below (the watch
  // set). Where that cannot work — no backend to wait in, or a watched
  // descriptor epoll refuses — fall back to a 10 ms polling wait that still
  // reaps I/O and ticks the watches.
  if (__yo_active_watch_count > 0) {
    if (__yo_backend == __YO_BACKEND_DEGRADED || __yo_watch_needs_polling()) {
      struct timespec ts = {0, 10 * 1000 * 1000};
      nanosleep(&ts, NULL);
      return __yo_io_poll();
    }
    __yo_io_arm_watches();
  }
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    // The loop drivers skip their 0-timeout __yo_io_poll in an iteration
    // that blocks here, so the tick is this wait's job too (the ring's reap
    // does it); without it a ready watch ended the wait, was never ticked,
    // and ended the next wait at once, forever.
    int n;
    __yo_epoll_drive(true, &n);
    return n + __yo_poll_and_fs_event_tick();
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    // Every op here completed at start, so the loop only waits when a
    // blocking call is running on another thread: block on the wake channel
    // (the same eventfd wait as the no-ring branch below) instead of
    // returning at once and spinning the loop until it finishes. Without an
    // eventfd no wake can reach this thread, and the loop's own re-check is
    // the only way to observe the blocking call ending — back off 1 ms.
    if (__yo_notify_efd >= 0) {
      struct pollfd pfd;
      pfd.fd = __yo_notify_efd;
      pfd.events = POLLIN;
      pfd.revents = 0;
      int pr;
      do {
        pr = poll(&pfd, 1, -1);
      } while (pr < 0 && errno == EINTR);
      uint64_t v;
      while (read(__yo_notify_efd, &v, sizeof(v)) == (ssize_t)sizeof(v)) {
      }
    } else {
      struct timespec ts = {0, 1000 * 1000};
      nanosleep(&ts, NULL);
    }
    return 0;
  }
  // No ring: nothing was submitted, so the only thing to wait for is a wake
  // (a foreign waker's post, or a blocking call ending). Block on the eventfd.
  // The first wait only creates it and returns, so the loop re-checks before
  // blocking (see __yo_io_notify_init). Without an eventfd there is no other
  // way to be woken: fall back to the ring, which waits on its own CQEs.
  if (!__yo_io_initialized) {
    if (__yo_notify_efd < 0) {
      __yo_io_notify_init();
      if (__yo_notify_efd < 0) {
        __yo_io_init();
      }
      return 0;
    }
    struct pollfd pfd;
    pfd.fd = __yo_notify_efd;
    pfd.events = POLLIN;
    pfd.revents = 0;
    int pr;
    do {
      pr = poll(&pfd, 1, -1);
    } while (pr < 0 && errno == EINTR);
    uint64_t v;
    while (read(__yo_notify_efd, &v, sizeof(v)) == (ssize_t)sizeof(v)) {
    }
    return 0;
  }

  // The earliest timer bounds the wait; one already due means no wait.
  int64_t timeout_ns = __yo_timer_wait_ns();
  if (timeout_ns == 0) {
    return __yo_io_poll();
  }
  if (timeout_ns > 0 && !__yo_uring_has_ext_arg) {
    __yo_ring_arm_wait_timeout(timeout_ns);
    timeout_ns = -1;
  }
  // Submit + wait in a single syscall — the main batching win: every
  // deferred SQE rides the blocking wait. What it returns is reaped from the
  // ring directly: the enter already ran the deferred task work, so a second
  // (polling) enter to "look again" only cost a syscall per wakeup. With no
  // I/O outstanding but a blocking call running on another thread, this is a
  // wait on the wakeup channel alone, which is what the loop should do
  // rather than spin.
  int ret;
  do {
    ret = __yo_uring_submit_and_wait_timeout(&__yo_io_ring, 1, timeout_ns);
  } while (ret == -EINTR);
  if (ret > 0) {
    __yo_io_account_submitted(ret);
  } else if (ret < 0 && ret != -ETIME && ret != -EBUSY) {
    // SQEs remain in the SQ ring; __yo_sq_unsubmitted is untouched so the
    // next poll/wait retries them.
    ASYNC_DEBUG("[Io] WARNING: io_uring wait failed: %d\\n", ret);
  }
  return __yo_ring_reap();
}

// Create and start an async read operation
// Returns a __yo_io_future_t* that completes when the read finishes
static __yo_io_future_t* __yo_async_read_start(int32_t fd, void* buffer, uint32_t size, uint64_t offset) {
  // Ensure io_uring is initialized (lazy initialization for eager async execution)
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_epoll_read_start(fd, buffer, size, offset);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));  // Zero-initialize all fields
  
  // Initialize ref counting
  future->header.ref_count = 1;
  
  // Initialize future state
  future->state = 0;  // 0 = pending
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  // Submit to io_uring
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) {
    // Queue full
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }  // Mark as completed
    ASYNC_DEBUG("[Io] WARNING: io_uring SQ full, returning EAGAIN\\n");
    return future;
  }
  
  __yo_uring_prep_read(sqe, fd, buffer, (unsigned)size, (int64_t)offset);
  __yo_uring_sqe_set_data(sqe, future);  // Store future pointer directly
  future->cancel_fn = __yo_ring_fd_future_cancel;
  __yo_io_ring_submit(future);
  __yo_ring_track_fd(future, fd, 0);
  
  ASYNC_DEBUG("[Io] Started async read: fd=%d buffer=%p size=%u offset=%llu (pending=%zu)\\n",
              fd, buffer, size, (unsigned long long)offset, __yo_pending_io_count);
  
  return future;
}

// pwritev2(fd, {buf, size}, 1, offset, RWF_NOWAIT) through the raw syscall:
// the libc wrapper is newer than some of the libcs a program links (musl
// gained it late), and the syscall (Linux 4.6; RWF_NOWAIT 4.14) is what the
// kernel answers either way. A missing syscall reads as ENOSYS, a kernel
// without RWF_NOWAIT as EOPNOTSUPP — both memoized by the caller.
#ifndef RWF_NOWAIT
#define RWF_NOWAIT 0x00000008
#endif
static ssize_t __yo_pwrite_nowait(int32_t fd, const void* buf, uint32_t size, uint64_t offset) {
#ifdef SYS_pwritev2
  struct iovec iov;
  iov.iov_base = (void*)buf;
  iov.iov_len = size;
  __yo_stats_io_syscalls++;
  // pos_l/pos_h: the kernel rebuilds the offset as (h << 32 << 32) | l, which
  // is just l on a 64-bit ABI and the split on a 32-bit one.
  return (ssize_t)syscall(SYS_pwritev2, fd, &iov, 1, (long)offset, (long)(offset >> 32), RWF_NOWAIT);
#else
  (void)fd; (void)buf; (void)size; (void)offset;
  errno = ENOSYS;
  return -1;
#endif
}

// Create and start an async write operation
// Returns a __yo_io_future_t* that completes when the write finishes
static __yo_io_future_t* __yo_async_write_start(int32_t fd, const void* buffer, uint32_t size, uint64_t offset) {
  // Ensure io_uring is initialized (lazy initialization for eager async execution)
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_epoll_write_start(fd, buffer, size, offset);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  // A buffered write the kernel cannot do without blocking is punted to
  // io-wq (~57 us a hop on WSL2). Try it inline with RWF_NOWAIT first: the
  // kernel either completes it from the page cache now or says why not.
  // Not behind an earlier queued write on the same fd (it must not overtake
  // it), and not on an fd whose file already refused (the memo).
  if (!(__yo_ring_fd_flags(fd) & __YO_RING_FD_NO_NOWAIT_WRITE) && !__yo_ring_fd_busy(fd, 1)) {
    ssize_t w = __yo_pwrite_nowait(fd, buffer, size, offset);
    if (w >= 0) {
      return __yo_io_done_future((int32_t)w);
    }
    int e = errno;
    if (e == EOPNOTSUPP || e == ESPIPE || e == EINVAL || e == ENOSYS) {
      // A property of the file (or kernel), not of this write: remember it.
      // The ring gives the authoritative answer for this op.
      __yo_ring_fd_set_flag(fd, __YO_RING_FD_NO_NOWAIT_WRITE);
    } else if (e != EAGAIN) {
      // A real error (EBADF, ENOSPC, EPIPE, ...): the ring would report the
      // same, one hop later.
      return __yo_io_done_future(-e);
    }
  }
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));  // Zero-initialize all fields
  
  // Initialize ref counting
  future->header.ref_count = 1;
  
  // Initialize future state
  future->state = 0;  // 0 = pending
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  // Submit to io_uring
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) {
    // Queue full
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }  // Mark as completed
    ASYNC_DEBUG("[Io] WARNING: io_uring SQ full, returning EAGAIN\\n");
    return future;
  }
  
  __yo_uring_prep_write(sqe, fd, buffer, (unsigned)size, (int64_t)offset);
  __yo_uring_sqe_set_data(sqe, future);  // Store future pointer directly
  future->cancel_fn = __yo_ring_fd_future_cancel;
  __yo_io_ring_submit(future);
  __yo_ring_track_fd(future, fd, 1);
  
  ASYNC_DEBUG("[Io] Started async write: fd=%d buffer=%p size=%u offset=%llu (pending=%zu)\\n",
              fd, (void*)buffer, size, (unsigned long long)offset, __yo_pending_io_count);
  
  return future;
}

// Create and start an async openat operation
// Returns a __yo_io_future_t* that completes with the fd or error
static __yo_io_future_t* __yo_async_openat_start(int32_t dirfd, const char* path, int32_t flags, int32_t mode) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_inline_openat_start(dirfd, path, flags, mode);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  // A plain open is tried nonblocking inside the enter (LOOKUP_CACHED) and
  // stays on the ring. One that creates or truncates never is: io_openat
  // punts O_CREAT, O_TRUNC and O_TMPFILE to io-wq unconditionally, so those
  // run inline, like the metadata ops (see __yo_async_statx_start).
  int punted = O_CREAT | O_TRUNC;
#ifdef O_TMPFILE
  if ((flags & O_TMPFILE) == O_TMPFILE) punted = flags;
#endif
  if (flags & punted) {
    return __yo_inline_openat_start(dirfd, path, flags, mode);
  }
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  
  __yo_uring_prep_openat(sqe, dirfd, path, flags, (mode_t)mode);
  __yo_uring_sqe_set_data(sqe, future);
  __yo_io_ring_submit(future);
  
  ASYNC_DEBUG("[Io] Started async openat: dirfd=%d path=%s flags=0x%x mode=0%o (pending=%zu)\\n",
              dirfd, path, flags, mode, __yo_pending_io_count);
  
  return future;
}

// Create and start an async close operation
static __yo_io_future_t* __yo_async_close_start(int32_t fd) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_epoll_close_start(fd);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  // End the ring operations still pending on fd first (their cancels queue
  // ahead of the close): the close alone would not — see __yo_ring_drop_fd.
  __yo_ring_drop_fd(fd);
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  
  __yo_uring_prep_close(sqe, fd);
  __yo_uring_sqe_set_data(sqe, future);
  __yo_io_ring_submit(future);
  
  ASYNC_DEBUG("[Io] Started async close: fd=%d (pending=%zu)\\n", fd, __yo_pending_io_count);
  
  return future;
}

// The metadata ops — statx, mkdirat, unlinkat, renameat, symlinkat, linkat —
// run inline on the loop thread on every backend. io_uring cannot do any of
// them without blocking, so the kernel always punts them to an io-wq worker
// (their prep sets REQ_F_FORCE_ASYNC): a thread hand-off and a wake-back per
// op, measured at ~57 us on WSL2 6.6 against 0.3-0.6 us for the same
// syscall made here. The trade is deliberate: a path lookup on a cold or
// network filesystem now blocks the loop for its duration, which is the
// contract macOS and the epoll fallback already had
// (plans/reference/LINUX_ASYNC_IO_PERFORMANCE.md).
static __yo_io_future_t* __yo_async_statx_start(int32_t dirfd, const char* path, int32_t flags, uint32_t mask, void* statxbuf) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  return __yo_inline_statx_start(dirfd, path, flags, mask, statxbuf);
}

static __yo_io_future_t* __yo_async_mkdirat_start(int32_t dirfd, const char* path, int32_t mode) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  return __yo_inline_mkdirat_start(dirfd, path, mode);
}

static __yo_io_future_t* __yo_async_unlinkat_start(int32_t dirfd, const char* path, int32_t flags) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  return __yo_inline_unlinkat_start(dirfd, path, flags);
}

static __yo_io_future_t* __yo_async_renameat_start(int32_t olddirfd, const char* oldpath, int32_t newdirfd, const char* newpath) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  return __yo_inline_renameat_start(olddirfd, oldpath, newdirfd, newpath);
}

static __yo_io_future_t* __yo_async_symlinkat_start(const char* target, int32_t newdirfd, const char* linkpath) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  return __yo_inline_symlinkat_start(target, newdirfd, linkpath);
}

static __yo_io_future_t* __yo_async_linkat_start(int32_t olddirfd, const char* oldpath, int32_t newdirfd, const char* newpath, int32_t flags) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  return __yo_inline_linkat_start(olddirfd, oldpath, newdirfd, newpath, flags);
}

// Create and start an async fsync operation
static __yo_io_future_t* __yo_async_fsync_start(int32_t fd) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_inline_fsync_start(fd);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  
  __yo_uring_prep_fsync(sqe, fd, 0);
  __yo_uring_sqe_set_data(sqe, future);
  __yo_io_ring_submit(future);
  
  ASYNC_DEBUG("[Io] Started async fsync: fd=%d (pending=%zu)\\n", fd, __yo_pending_io_count);
  
  return future;
}

// Create and start an async fdatasync operation
static __yo_io_future_t* __yo_async_fdatasync_start(int32_t fd) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_inline_fdatasync_start(fd);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  
  __yo_uring_prep_fsync(sqe, fd, __YO_IORING_FSYNC_DATASYNC);
  __yo_uring_sqe_set_data(sqe, future);
  __yo_io_ring_submit(future);
  
  ASYNC_DEBUG("[Io] Started async fdatasync: fd=%d (pending=%zu)\\n", fd, __yo_pending_io_count);
  
  return future;
