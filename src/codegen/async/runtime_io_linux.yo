// Async accept - accept incoming connection (using io_uring)
static __yo_io_future_t* __yo_async_accept_start(int32_t sockfd, void* addr, uint32_t* addrlen) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_epoll_accept_start(sockfd, addr, addrlen);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_epoll_done_future(-__yo_backend_errno);
  }
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  struct __yo_uring_sqe* sqe = __yo_uring_get_sqe(&__yo_io_ring);
  if (!sqe) {
    future->result = -EAGAIN;
    future->state = -1;
    return future;
  }
  
  __yo_uring_prep_accept(sqe, sockfd, (struct sockaddr*)addr, (socklen_t*)addrlen, 0);
  __yo_uring_sqe_set_data(sqe, future);
  // The tag process_cqe reads to set O_NONBLOCK on the accepted fd; it also
  // gives an aborted accept a prompt cancel path instead of waiting out the
  // connection that may never arrive.
  future->cancel_fn = __yo_accept_future_cancel;
  __yo_io_ring_submit(future);
  
  ASYNC_DEBUG("[Io] Started async accept: sockfd=%d (pending=%zu)\\n", sockfd, __yo_pending_io_count);
  
  return future;
}

