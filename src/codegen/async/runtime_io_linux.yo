  ASYNC_DEBUG("[Io] Started async write: fd=%d buffer=%p size=%u offset=%llu (pending=%zu)\\n",
              fd, (void*)buffer, size, (unsigned long long)offset, __yo_pending_io_count);
  
  return future;
}

