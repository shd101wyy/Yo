}

// Async send - send data on socket (using io_uring)
// Stream write on a socket std/net owns (see the macOS runtime). Linux has no
// SO_NOSIGPIPE, so the SIGPIPE guard stays a per-call MSG_NOSIGNAL: this is
// send(MSG_NOSIGNAL) through the ordinary send path.
static __yo_io_future_t* __yo_async_send_start(int32_t sockfd, const void* buf, size_t len, int32_t flags);
static __yo_io_future_t* __yo_async_stream_write_start(int32_t sockfd, const void* buf, size_t len) {
  return __yo_async_send_start(sockfd, buf, len, MSG_NOSIGNAL);
}

static __yo_io_future_t* __yo_async_send_start(int32_t sockfd, const void* buf, size_t len, int32_t flags) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_epoll_send_start(sockfd, buf, len, flags);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  // Inline first: a send with room in the socket buffer completes in one
  // syscall and the task never suspends. A ring SEND that completes at issue
  // still costs the round trip through the loop — suspend, the next poll's
  // enter, the CQE, the resume — which is what made the ring lose the inline
  // ping-pong to epoll. Only a would-block send arms the ring op, and never
  // ahead of an earlier send still queued on the same socket.
  //
  // Not while a real batch is forming, either (__YO_IO_INLINE_MAX_QUEUED
  // SQEs already queued this tick): then the send rides the enter that
  // submits them, and the kernel makes the same nonblocking attempt at
  // submission — sixty-four connections sending in one tick cost one enter,
  // not sixty-four send calls. A queue of one or two (a parked ping-pong's
  // recv) does not count: batching behind it costs a second enter.
  if (__yo_sq_unsubmitted < __YO_IO_INLINE_MAX_QUEUED && !__yo_ring_fd_busy(sockfd, 1)) {
    ssize_t r = __YO_SC(send(sockfd, buf, len, flags | MSG_DONTWAIT));
    if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
      return __yo_io_done_future((r < 0) ? -errno : (int32_t)r);
    }
  }
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  
  __yo_uring_prep_send(sqe, sockfd, buf, len, flags);
  __yo_uring_sqe_set_data(sqe, future);
  future->cancel_fn = __yo_ring_fd_future_cancel;
  __yo_io_ring_submit(future);
  __yo_ring_track_fd(future, sockfd, 1);
  
  ASYNC_DEBUG("[Io] Started async send: sockfd=%d len=%zu (pending=%zu)\\n", sockfd, len, __yo_pending_io_count);
  
  return future;
}

// Async recv - receive data from socket (using io_uring)
static __yo_io_future_t* __yo_async_recv_start(int32_t sockfd, void* buf, size_t len, int32_t flags) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_epoll_recv_start(sockfd, buf, len, flags);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  // Inline first, for the reason __yo_async_send_start gives. Skipped behind
  // an earlier queued recv on the same socket (the inline one would take its
  // bytes), and for MSG_WAITALL, which MSG_DONTWAIT would cut short.
  // And skipped on a socket whose last inline recv would have blocked
  // (__YO_RING_FD_RECV_PARKS), or while a batch is forming (see there): the
  // ring's RECV makes the same nonblocking attempt inside the enter, so
  // nothing is lost by going straight there.
  if (__yo_sq_unsubmitted < __YO_IO_INLINE_MAX_QUEUED && !(flags & MSG_WAITALL)
      && !(__yo_ring_fd_flags(sockfd) & __YO_RING_FD_RECV_PARKS)
      && !__yo_ring_fd_busy(sockfd, 0)) {
    ssize_t r = __YO_SC(recv(sockfd, buf, len, flags | MSG_DONTWAIT));
    if (r >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
      return __yo_io_done_future((r < 0) ? -errno : (int32_t)r);
    }
    __yo_stats_recv_would_block++;
    __yo_ring_fd_set_flag(sockfd, __YO_RING_FD_RECV_PARKS);
  }
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  
  __yo_uring_prep_recv(sqe, sockfd, buf, len, flags);
  __yo_uring_sqe_set_data(sqe, future);
  future->cancel_fn = __yo_ring_fd_future_cancel;
  __yo_io_ring_submit(future);
  __yo_ring_track_fd(future, sockfd, 0);
  
  ASYNC_DEBUG("[Io] Started async recv: sockfd=%d len=%zu (pending=%zu)\\n", sockfd, len, __yo_pending_io_count);
  
  return future;
}

// Async sendto - send data to specific address (UDP)
//
// "io_uring doesn't have direct sendto" (the old comment here) has been wrong
// for years: __YO_IORING_OP_SENDMSG is the direct sendto and has been in the kernel
// since 5.3 — well under this runtime's existing floor (its openat/close ops
// need 5.6+). The datagram is attempted inline first — sockets are created
// nonblocking, so a full send buffer reports EAGAIN instead of parking the
// loop thread — and only a would-block result arms the ring op.
// issues/fixed/linux-udp-datagram-ops-are-synchronous-and-park-the-loop.md
static __yo_io_future_t* __yo_async_sendto_start(int32_t sockfd, const void* buf, size_t len, int32_t flags,
                                                const void* dest_addr, uint32_t addrlen) {
  __yo_io_init();

  __yo_dgram_future_t* df = (__yo_dgram_future_t*)__yo_rc_alloc(sizeof(__yo_dgram_future_t));
  memset(df, 0, sizeof(__yo_dgram_future_t));

  __yo_io_future_t* future = &df->base;
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  df->addrlen_out = NULL;

  // Not ahead of an earlier datagram still queued on this socket.
  if (!__yo_io_fd_busy(sockfd, 1)) {
    __yo_stats_io_syscalls++;
    ssize_t result = sendto(sockfd, buf, len, flags | MSG_DONTWAIT, (const struct sockaddr*)dest_addr, (socklen_t)addrlen);
    if (result >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
      future->result = (result < 0) ? -errno : (int32_t)result;
      { if (future->state != -2) future->state = -1; }
      ASYNC_DEBUG("[Io] sendto completed immediately: sockfd=%d len=%zu result=%d\\n", sockfd, len, future->result);
      return future;
    }
  }

  if (addrlen > sizeof(struct sockaddr_storage)) {
    future->result = -EINVAL;
    { if (future->state != -2) future->state = -1; }
    return future;
  }

  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_epoll_sendto_park(sockfd, buf, len, flags, dest_addr, addrlen, future);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    future->result = -__yo_backend_errno;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  // Send buffer full — complete through the ring. The kernel reads the msghdr
  // (and the destination address it points at) lazily, so the address is
  // COPIED into the future's own allocation; the msghdr and iovec live there
  // too, and the ring's reference keeps them alive until the CQE.
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }

  memcpy(&df->dest, dest_addr, addrlen);
  df->iov.iov_base = (void*)buf;
  df->iov.iov_len = len;
  df->msg.msg_iov = &df->iov;
  df->msg.msg_iovlen = 1;
  df->msg.msg_name = &df->dest;
  df->msg.msg_namelen = addrlen;
  __yo_uring_prep_sendmsg(sqe, sockfd, &df->msg, (unsigned)flags);
  __yo_uring_sqe_set_data(sqe, future);
  future->cancel_fn = __yo_dgram_future_cancel;
  __yo_io_ring_submit(future);
  __yo_ring_track_fd(future, sockfd, 1);

  ASYNC_DEBUG("[Io] sendto waiting via io_uring: sockfd=%d len=%zu\\n", sockfd, len);

  return future;
}

// Async recvfrom - receive data with source address (UDP)
//
// Same shape as sendto: inline attempt first (EAGAIN on a quiet socket, never
// a block), then __YO_IORING_OP_RECVMSG. The kernel writes the sender's address
// into the CALLER's src_addr buffer and the address LENGTH into our msghdr at
// completion time; __yo_io_process_cqe copies that length to the caller's
// in/out addrlen. src_addr therefore has the same lifetime contract as every
// other io_uring buffer: it must stay valid until the future completes.
static __yo_io_future_t* __yo_async_recvfrom_start(int32_t sockfd, void* buf, size_t len, int32_t flags,
                                                  void* src_addr, uint32_t* addrlen) {
  __yo_io_init();

  __yo_dgram_future_t* df = (__yo_dgram_future_t*)__yo_rc_alloc(sizeof(__yo_dgram_future_t));
  memset(df, 0, sizeof(__yo_dgram_future_t));

  __yo_io_future_t* future = &df->base;
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  df->addrlen_out = (src_addr && addrlen) ? addrlen : NULL;

  // The fast path completes with recvfrom(2) semantics: the sender's address
  // and its length land in the caller's buffers synchronously.
  // Not ahead of an earlier receiver still waiting on this socket: it is owed
  // the next datagram.
  if (!__yo_io_fd_busy(sockfd, 0)) {
    __yo_stats_io_syscalls++;
    ssize_t result = recvfrom(sockfd, buf, len, flags | MSG_DONTWAIT, (struct sockaddr*)src_addr, (socklen_t*)addrlen);
    if (result >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
      future->result = (result < 0) ? -errno : (int32_t)result;
      { if (future->state != -2) future->state = -1; }
      ASYNC_DEBUG("[Io] recvfrom completed immediately: sockfd=%d len=%zu result=%d\\n", sockfd, len, future->result);
      return future;
    }
  }

  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_epoll_recvfrom_park(sockfd, buf, len, flags, src_addr, addrlen, future);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    future->result = -__yo_backend_errno;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  // Quiet socket — arm RECVMSG and let the task park.
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }

  df->iov.iov_base = buf;
  df->iov.iov_len = len;
  df->msg.msg_iov = &df->iov;
  df->msg.msg_iovlen = 1;
  df->msg.msg_name = src_addr;
  df->msg.msg_namelen = (src_addr && addrlen) ? (socklen_t)*addrlen : 0;
  __yo_uring_prep_recvmsg(sqe, sockfd, &df->msg, (unsigned)flags);
  __yo_uring_sqe_set_data(sqe, future);
  future->cancel_fn = __yo_dgram_future_cancel;
  __yo_io_ring_submit(future);
  __yo_ring_track_fd(future, sockfd, 0);

  ASYNC_DEBUG("[Io] recvfrom waiting via io_uring: sockfd=%d len=%zu\\n", sockfd, len);

  return future;
}

// Async shutdown - shutdown socket
static __yo_io_future_t* __yo_async_shutdown_start(int32_t sockfd, int32_t how) {
