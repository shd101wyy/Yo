// Create and start an async ftruncate operation
static __yo_io_future_t* __yo_async_ftruncate_start(int32_t fd, int64_t length) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_inline_ftruncate_start(fd, length);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  // An op this kernel's ring lacks completes synchronously (the probe).
  if (!__yo_uring_op_ok(__YO_IORING_OP_FTRUNCATE)) {
    return __yo_inline_ftruncate_start(fd, length);
  }
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;

  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }

  __yo_uring_prep_ftruncate(sqe, fd, length);
  __yo_uring_sqe_set_data(sqe, future);
  __yo_io_ring_submit(future);

  ASYNC_DEBUG("[Io] Started async ftruncate: fd=%d length=%lld (pending=%zu)\\n",
              fd, (long long)length, __yo_pending_io_count);
  
  return future;
}

// ============================================================================
// Socket Operations (Linux io_uring)
// ============================================================================

// Async socket - create socket
static __yo_io_future_t* __yo_async_socket_start(int32_t domain, int32_t type, int32_t protocol) {
  __yo_io_init();
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  // Nonblocking, matching the macOS backend and every would-block fast path
  // below: a blocking socket would park the whole event loop inside a
  // synchronous retry (the socket ops try the syscall inline before arming
  // the ring). io_uring ops themselves are nonblocking either way.
  // SOCK_NONBLOCK sets it in the same syscall (it was socket + F_GETFL +
  // F_SETFL).
  int result = socket(domain, type | SOCK_NONBLOCK, protocol);
  future->result = (result < 0) ? -errno : result;
  { if (future->state != -2) future->state = -1; }

  ASYNC_DEBUG("[Io] socket completed: domain=%d type=%d protocol=%d result=%d\\n",
              domain, type, protocol, future->result);

  return future;
}

// Async bind - bind socket to address
static __yo_io_future_t* __yo_async_bind_start(int32_t sockfd, const void* addr, uint32_t addrlen) {
  __yo_io_init();
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  int result = bind(sockfd, (const struct sockaddr*)addr, (socklen_t)addrlen);
  future->result = (result < 0) ? -errno : 0;
  { if (future->state != -2) future->state = -1; }
  
  ASYNC_DEBUG("[Io] bind completed: sockfd=%d result=%d\\n", sockfd, future->result);
  
  return future;
}

// Async listen - mark socket as listening
static __yo_io_future_t* __yo_async_listen_start(int32_t sockfd, int32_t backlog) {
  __yo_io_init();
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  int result = listen(sockfd, backlog);
  future->result = (result < 0) ? -errno : 0;
  { if (future->state != -2) future->state = -1; }
  
  ASYNC_DEBUG("[Io] listen completed: sockfd=%d backlog=%d result=%d\\n", sockfd, backlog, future->result);
  
  return future;
}

// Async accept - accept incoming connection (using io_uring)
static __yo_io_future_t* __yo_async_accept_start(int32_t sockfd, void* addr, uint32_t* addrlen) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_epoll_accept_start(sockfd, addr, addrlen);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  
  // POSIX accept(2) does not give the accepted socket the listener's
  // O_NONBLOCK, and every socket this runtime creates is nonblocking so the
  // would-block fast paths can never block the loop thread. accept4's
  // SOCK_NONBLOCK does it in the op itself (IORING_OP_ACCEPT takes accept4
  // flags since 5.5) — it used to be an F_GETFL + F_SETFL pair per accepted
  // connection in the CQE path.
  __yo_uring_prep_accept(sqe, sockfd, (struct sockaddr*)addr, (socklen_t*)addrlen, SOCK_NONBLOCK);
  __yo_uring_sqe_set_data(sqe, future);
  // An aborted accept gets a prompt cancel instead of waiting out a
  // connection that may never arrive.
  future->cancel_fn = __yo_ring_fd_future_cancel;
  __yo_io_ring_submit(future);
  __yo_ring_track_fd(future, sockfd, 0);
  
  ASYNC_DEBUG("[Io] Started async accept: sockfd=%d (pending=%zu)\\n", sockfd, __yo_pending_io_count);
  
  return future;
}

// Async connect - connect to remote address (using io_uring)
static __yo_io_future_t* __yo_async_connect_start(int32_t sockfd, const void* addr, uint32_t addrlen) {
  __yo_io_init();
  if (__yo_backend == __YO_BACKEND_EPOLL) {
    return __yo_epoll_connect_start(sockfd, addr, addrlen);
  }
  if (__yo_backend == __YO_BACKEND_DEGRADED) {
    return __yo_io_done_future(-__yo_backend_errno);
  }
  
  __yo_io_future_t* future = (__yo_io_future_t*)__yo_rc_alloc(sizeof(__yo_io_future_t));
  memset(future, 0, sizeof(__yo_io_future_t));
  
  future->header.ref_count = 1;
  future->state = 0;
  future->result = 0;
  future->continuation_fn = NULL;
  future->continuation_sm = NULL;
  
  struct __yo_uring_sqe* sqe = __yo_io_get_sqe();
  if (!sqe) {
    future->result = -EAGAIN;
    { if (future->state != -2) future->state = -1; }
    return future;
  }
  
  __yo_uring_prep_connect(sqe, sockfd, (const struct sockaddr*)addr, (socklen_t)addrlen);
  __yo_uring_sqe_set_data(sqe, future);
  future->cancel_fn = __yo_ring_fd_future_cancel;
  __yo_io_ring_submit(future);
  __yo_ring_track_fd(future, sockfd, 1);
  
  ASYNC_DEBUG("[Io] Started async connect: sockfd=%d (pending=%zu)\\n", sockfd, __yo_pending_io_count);
  
