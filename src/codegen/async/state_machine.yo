//! state_machine — async/effect state-machine codegen.
//!
//! The StateMachineInfo model, the FSM transformation, and the resume/struct
//! emitters (they consume `state_code_gen.yo` + `async_completion.yo`
//! and the `g_some_resolved_concrete` side-table).
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ HashSet } :: import("std/collections/hash_set");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_some_type, is_struct_type, is_function_type, is_dyn_type, is_unit_type } :: import("../../types/guards.yo");
{ type_implements_future, extract_future_trait_from_type } :: import("../../evaluator/trait_checking.yo");
{ lookup_macro_expansion, expr_info_deferred_dup_expressions, some_resolution } :: import("../../expr_info.yo");
{ AwaitAnalysisResult, AwaitPoint, CapturedVariable, CapturedVariableKind } :: import("../../evaluator/async/await_analysis_types.yo");
{ SuspensionCapturedVariable } :: import("../../evaluator/shared/suspension_analysis_types.yo");
{ is_io_future_type, collect_branch_await_exprs, emit_future_store_into_slot } :: import("./state_code_gen.yo");
{ is_io_async_call, is_io_await_call } :: import("../../evaluator/async/await_analysis.yo");
{ AstExpr, ast_expr_id, ast_expr_is_atom, ast_expr_is_atom_of, ast_expr_is_fn_call, ast_expr_is_fn_call_of, ast_expr_token, BK_COND, BK_MATCH, BK_WHILE, BK_BEGIN, BK_INOUT } :: import("../../expr.yo");
{ _call_generate_expr } :: import("../exprs/_expr.yo");
{ generate_step_expression } :: import("../exprs/while_loop.yo");
{ _c_string_literal } :: import("../exprs/comptime_value.yo");
{ Token, TokenKind } :: import("../../token.yo");
{ EvalValue } :: import("../../value.yo");
{ Variable, Environment, get_variables_from_env, get_variables_from_env_by_filter } :: import("../../env.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{ FunctionGenerationContext, EvidenceParameter, InAsyncStateMachine, InlineSmLowering, InlineSuspension, InlineAwaitResultField } :: import("../functions/context.yo");
{ expr_contains_await, expr_contains_while_with_await } :: import("../../expr_traversal.yo");
{ is_temp_variable_name, is_any_temp_variable_name, debug_knob } :: import("../../utils.yo");
{ codegen_fatal, codegen_user_error } :: import("../constants.yo");
{ get_type_string, fresh_local_name, sanitize_for_c_identifier, get_variable_name_for_codegen } :: import("../utils/index.yo");
{ get_state_machine_field_name, sm_local_field_name, register_sm_captured_names, note_await_consumed_temp } :: import("./state_machine_naming.yo");
{ Emitter } :: import("../../emitter.yo");
{ awaited_future_c_type_override } :: import("../functions/declarations.yo");
{ emit_async_future_completion, emit_async_future_escape, emit_sm_unwind_catch } :: import("../exprs/async_completion.yo");
{ get_dup_function_for_type, generate_dup_code_for_value, generate_drop_code_for_value } :: import("../exprs/drop_dup.yo");
CLEANUP_SEGMENT :: usize.MAX;
CrossBoundaryResult :: ref(
  struct(
    /// Variable IDs that must be stored as struct fields (cross await boundaries).
    cross_boundary_ids : HashSet(String),
    /// Maps temp variable IDs to their `await_future_N` field name (dedup).
    await_future_temp_var_aliases : HashMap(String, String),
    /// Maps each captured variable id to the segment indices where it is referenced.
    variable_segments : HashMap(String, HashSet(usize)),
    /// The ids of match-arm pattern bindings. A binding's slot borrows its
    /// scrutinee's payload, so it never shares an owning slot.
    pattern_binding_ids : HashSet(String)
  )
);
/// A body local's live range for the single-pass lowering, in source-position
/// keys (`_lv_pos`): it holds a value from `def_end` (the end of its
/// initializer, or its pattern binding) to `last` (its last use, counted at
/// the end of the statement that uses it), extended to `scope_end` when it
/// must survive to a scope-end drop or has its address taken.
_LiveVar :: ref(struct(def_end : u64, last : u64, scope_end : u64, to_scope_end : bool));
/// Await sites (`module:row:col`) whose result needs no task field: no later
/// await in the same statement can suspend between the result's extraction
/// and its use, so it is a C local (phase 6). Filled by
/// `compute_cross_boundary_variables`, read by the struct emitter
/// (`inline_await_result_fields`) and `emit_inline_await`.
(g_local_await_results : HashSet(String)) = HashSet(String).new();
_site_of :: (fn(tok : Token) -> String)(`${tok.module_path}:${tok.row.to_string()}:${tok.column.to_string()}`);
/// State of the live-range walk over one `io.async` body.
_LiveWalk :: ref(
  struct(
    module_path : String,
    /// A node from another module was seen (a macro expansion): positions are
    /// not comparable, so every local is treated as live across the awaits.
    foreign : bool,
    vars : HashMap(String, _LiveVar),
    remap : HashMap(String, String),
    loop_starts : ArrayList(u64),
    loop_ends : ArrayList(u64),
    span_ends : HashMap(usize, u64),
    /// Every await the walk meets: its site, position, and the end of the
    /// statement it is in.
    await_sites : ArrayList(String),
    await_pos : ArrayList(u64),
    await_stmt_end : ArrayList(u64),
    /// The ids of the pattern bindings the walk declared.
    bindings : HashSet(String),
    /// The ids declared under each source name: a read the walk cannot
    /// resolve (its node carries no environment) counts as a use of each.
    names : HashMap(String, ArrayList(String))
  )
);
/// A token's source position as one ordered key (row major).
_lv_pos :: (fn(tok : Token, w : _LiveWalk) -> u64)({
  if(!(tok.module_path == w.module_path), {
    w.foreign = true;
  });
  (u64(tok.row) * u64(1048576)) + u64(tok.column)
});
/// The last source position inside `e` (memoized by node id).
_lv_span_end :: (fn(e : AstExpr, w : _LiveWalk) -> u64)({
  eid := ast_expr_id(e);
  match(w.span_ends.get(eid), .Some(v) => return(v), .None => ());
  (m : u64) = _lv_pos(ast_expr_token(e), w);
  match(
    e,
    .Atom(_, _) => (),
    .FnCall(_, func_box, args, _, _) => {
      fe := recur(func_box, w);
      if(fe > m, {
        m = fe;
      });
      (i : usize) = usize(0);
      while(i < args.len(), i = (i + usize(1)), {
        match(
          args.get(i),
          .Some(a) => {
            ae := recur(a, w);
            if(ae > m, {
              m = ae;
            });
          },
          .None => ()
        );
      });
    }
  );
  w.span_ends.insert(eid, m);
  m
});
/// The id (after SSA remapping) of the variable `name` resolves to in `e`'s
/// environment, and that variable's declaration position.
_lv_resolve :: (fn(e : AstExpr, name : String, w : _LiveWalk, context : FunctionGenerationContext) -> Option(Variable))(
  match(
    context.base.get_expr_info(e),
    .Some(info) => {
      vs := get_variables_from_env(info.env, name);
      cond(
        (vs.len() == usize(0)) => Option(Variable).None,
        true => vs.get(vs.len() - usize(1))
      )
    },
    .None => Option(Variable).None
  )
);
_lv_id :: (fn(v : Variable, w : _LiveWalk) -> String)({
  id := v.id.to_string();
  match(w.remap.get(id.clone()), .Some(orig) => orig, .None => id)
});
/// Declare the local `name` at `def_end` (its scope ends at `scope_end`).
_lv_declare :: (fn(id : String, name : String, def_end : u64, scope_end : u64, w : _LiveWalk) -> unit)({
  if(!w.vars.contains_key(id.clone()), {
    w.vars.insert(id.clone(), _LiveVar(def_end : def_end, last : def_end, scope_end : scope_end, to_scope_end : false));
    ids := match(w.names.get(name.clone()), .Some(l) => l, .None => ArrayList(String).new());
    ids.push(id);
    w.names.insert(name, ids);
  });
});
/// Record a use of `id` at `at`: a local defined before an enclosing loop is
/// live through the whole loop (the loop comes back to it).
_lv_use :: (fn(id : String, at : u64, w : _LiveWalk) -> unit)(
  match(
    w.vars.get(id),
    .Some(lv) => {
      if(at > lv.last, {
        lv.last = at;
      });
      (li : usize) = usize(0);
      while(li < w.loop_starts.len(), li = (li + usize(1)), {
        ls := match(w.loop_starts.get(li), .Some(x) => x, .None => u64(0));
        le := match(w.loop_ends.get(li), .Some(x) => x, .None => u64(0));
        if((lv.def_end < ls) && (le > lv.last), {
          lv.last = le;
        });
      });
    },
    .None => ()
  )
);
/// The variable a place expression is rooted at: `x` for `x`, `x.a.b` and
/// `x(i)`.
_lv_place_root :: (fn(e : AstExpr) -> AstExpr)(
  match(
    e.clone(),
    .Atom(_, _) => e,
    .FnCall(_, func_box, args, _, _) => cond(
      ast_expr_is_fn_call_of(e.clone(), ".", Option(usize).Some(usize(2))) => match(args.get(usize(0)), .Some(obj) => recur(obj), .None => e),
      true => recur(func_box)
    )
  )
);
_lv_mark_scope :: (fn(e : AstExpr, w : _LiveWalk, context : FunctionGenerationContext) -> unit)(
  match(
    e.clone(),
    .Atom(_, tok) => match(
      _lv_resolve(e, tok.value.clone(), w, context),
      .Some(v) => match(
        w.vars.get(_lv_id(v, w)),
        .Some(lv) => {
          lv.to_scope_end = true;
        },
        .None => ()
      ),
      .None => ()
    ),
    .FnCall(_, _, _, _, _) => ()
  )
);
/// Declare the names a match arm's pattern binds (identifier atoms whose
/// variable is declared at that very atom).
_lv_pattern_bindings :: (fn(pat : AstExpr, scope_end : u64, w : _LiveWalk, context : FunctionGenerationContext) -> unit)(
  match(
    pat.clone(),
    .Atom(_, tok) => if(tok.kind == TokenKind.Identifier, {
      match(
        _lv_resolve(pat, tok.value.clone(), w, context),
        .Some(v) => if((v.token.module_path == tok.module_path) && ((v.token.row == tok.row) && (v.token.column == tok.column)), {
          _lv_declare(_lv_id(v, w), tok.value.clone(), _lv_pos(tok, w), scope_end, w);
          w.bindings.insert(_lv_id(v, w));
        }),
        .None => ()
      );
    }),
    .FnCall(_, func_box, args, _, _) => {
      recur(func_box, scope_end, w, context);
      (i : usize) = usize(0);
      while(i < args.len(), i = (i + usize(1)), {
        match(args.get(i), .Some(a) => recur(a, scope_end, w, context), .None => ());
      });
    }
  )
);
/// Walk `e`: `stmt_end` is where the statement being walked ends (a read is
/// emitted no earlier than the awaits before it in the same statement), and
/// `block_end` where the innermost block ends (its locals' scope).
_lv_walk :: (fn(e : AstExpr, stmt_end : u64, block_end : u64, w : _LiveWalk, context : FunctionGenerationContext) -> unit)({
  match(
    lookup_macro_expansion(ast_expr_id(e)),
    .Some(expanded) => {
      recur(expanded, stmt_end, block_end, w, context);
      return(());
    },
    .None => ()
  );
  match(
    e.clone(),
    .Atom(_, tok) => if(tok.kind == TokenKind.Identifier, {
      _pos := _lv_pos(tok, w);
      match(
        _lv_resolve(e, tok.value.clone(), w, context),
        .Some(v) => {
          _lv_use(_lv_id(v, w), stmt_end, w);
          // A local sharing an owner's value is read through the owner's
          // slot (`sm_storage_id`), so the owner is live wherever it is.
          match(v.is_owning_the_same_rc_value_as, .Some(ob) => _lv_use(_lv_id(ob.*, w), stmt_end, w), .None => ());
        },
        // No environment to resolve it in: every local of this name is taken
        // as read here, which can only lengthen a range.
        .None => match(
          w.names.get(tok.value.clone()),
          .Some(ids) => {
            (ni : usize) = usize(0);
            while(ni < ids.len(), ni = (ni + usize(1)), {
              match(ids.get(ni), .Some(nid) => _lv_use(nid, stmt_end, w), .None => ());
            });
          },
          .None => ()
        )
      );
    }),
    .FnCall(_, func_box, args, _, _) => {
      if(is_io_await_call(e.clone()), {
        atok := ast_expr_token(e.clone());
        w.await_sites.push(_site_of(atok));
        w.await_pos.push(_lv_pos(atok, w));
        w.await_stmt_end.push(stmt_end);
      });
      cond(
        // `x := v` / `(x : T) = v`: the initializer first, then the binding.
        (ast_expr_is_fn_call_of(e.clone(), ":=", Option(usize).Some(usize(2))) || (ast_expr_is_fn_call_of(e.clone(), "=", Option(usize).Some(usize(2))) && match(args.get(usize(0)), .Some(l) => ast_expr_is_fn_call_of(l, ":", Option(usize).None), .None => false))) => {
          rhs := match(args.get(usize(1)), .Some(r) => r, .None => return(()));
          recur(rhs.clone(), stmt_end, block_end, w, context);
          lhs := match(args.get(usize(0)), .Some(l) => l, .None => return(()));
          name_atom := match(lhs.clone(), .FnCall(_, _, la, _, _) => match(la.get(usize(0)), .Some(n) => n, .None => lhs.clone()), .Atom(_, _) => lhs.clone());
          name := ast_expr_token(name_atom).value;
          match(
            _lv_resolve(e.clone(), name, w, context),
            .Some(v) => _lv_declare(_lv_id(v, w), name.clone(), _lv_span_end(rhs.clone(), w), block_end, w),
            .None => ()
          );
          // `inout(name) := place`: `name` points into the place's root, so the
          // root keeps its storage to the end of its scope, and so does the
          // hidden local that pins the place's object.
          if(ast_expr_is_fn_call_of(lhs.clone(), BK_INOUT, Option(usize).Some(usize(1))), {
            _lv_mark_scope(_lv_place_root(rhs.clone()), w, context);
            match(
              context.base.get_expr_info(lhs),
              .Some(linfo) => match(
                linfo.source_variable,
                .Some(pin) => {
                  pin_id := _lv_id(pin, w);
                  _lv_declare(pin_id.clone(), pin.name.clone(), _lv_span_end(rhs, w), block_end, w);
                  match(
                    w.vars.get(pin_id),
                    .Some(plv) => {
                      plv.to_scope_end = true;
                    },
                    .None => ()
                  );
                },
                .None => ()
              ),
              .None => ()
            );
          });
        },
        ast_expr_is_fn_call_of(e.clone(), BK_WHILE, Option(usize).None) => {
          w.loop_starts.push(_lv_pos(ast_expr_token(e.clone()), w));
          w.loop_ends.push(_lv_span_end(e.clone(), w));
          loop_end := _lv_span_end(e.clone(), w);
          recur(func_box, loop_end, block_end, w, context);
          (i : usize) = usize(0);
          while(i < args.len(), i = (i + usize(1)), {
            // The condition and the step run again every iteration.
            match(args.get(i), .Some(a) => recur(a, loop_end, block_end, w, context), .None => ());
          });
          _ls := w.loop_starts.pop();
          _le := w.loop_ends.pop();
        },
        ast_expr_is_fn_call_of(e.clone(), BK_BEGIN, Option(usize).None) => {
          blk_end := _lv_span_end(e.clone(), w);
          (i : usize) = usize(0);
          while(i < args.len(), i = (i + usize(1)), {
            match(args.get(i), .Some(a) => recur(a.clone(), _lv_span_end(a, w), blk_end, w, context), .None => ());
          });
        },
        ast_expr_is_fn_call_of(e.clone(), BK_MATCH, Option(usize).None) => {
          recur(func_box, stmt_end, block_end, w, context);
          (i : usize) = usize(0);
          while(i < args.len(), i = (i + usize(1)), {
            match(
              args.get(i),
              .Some(a) => if(ast_expr_is_fn_call_of(a.clone(), "=>", Option(usize).Some(usize(2))), {
                arm_end := _lv_span_end(a.clone(), w);
                match(
                  a.clone(),
                  .FnCall(_, _, arm_args, _, _) => {
                    match(arm_args.get(usize(0)), .Some(pat) => _lv_pattern_bindings(pat, arm_end, w, context), .None => ());
                    match(arm_args.get(usize(1)), .Some(body) => recur(body, stmt_end, arm_end, w, context), .None => ());
                  },
                  .Atom(_, _) => ()
                );
              }, {
                recur(a, stmt_end, block_end, w, context);
              }),
              .None => ()
            );
          });
        },
        // `&x` / `inout(y) := x`: a pointer to the local can outlive any use
        // of its name, so it lives to the end of its scope.
        ast_expr_is_fn_call_of(e.clone(), "&", Option(usize).Some(usize(1))) => {
          match(
            args.get(usize(0)),
            .Some(a) => {
              _lv_mark_scope(a.clone(), w, context);
              recur(a, stmt_end, block_end, w, context);
            },
            .None => ()
          );
        },
        true => {
          recur(func_box, stmt_end, block_end, w, context);
          (i : usize) = usize(0);
          while(i < args.len(), i = (i + usize(1)), {
            match(args.get(i), .Some(a) => recur(a, stmt_end, block_end, w, context), .None => ());
          });
        }
      );
    }
  );
});
/// The locals of an `io.async` body that need a state-machine field: those
/// live across some suspension. Anything else stays a C local — the resume
/// function jumps past its declaration, which C allows, and nothing reads it
/// after the jump (plans/ASYNC_STATE_MACHINE_GENERATION.md phase 6, layout
/// from liveness). A future temp consumed into the await slot never crosses
/// its own await. Unit locals have no storage at all.
///
/// The ranges are linear, in source order, which the single-pass lowering
/// emits in: sound because a read counts at the end of its statement (a later
/// await in the same statement is hoisted before it), a local used inside a
/// loop it was defined before is live through the loop, and a local that is
/// dropped at scope end, or whose address is taken, lives to the end of its
/// scope. A node from another module (a macro expansion) makes positions
/// incomparable, and then every local crosses, as before.
compute_cross_boundary_variables :: (
  fn(body_expr : AstExpr, analysis : AwaitAnalysisResult, context : FunctionGenerationContext) -> CrossBoundaryResult
)({
  captured_variables := analysis.captured_variables;
  body_tok := ast_expr_token(body_expr.clone());
  w := _LiveWalk(
    module_path : body_tok.module_path.clone(),
    foreign : false,
    vars : HashMap(String, _LiveVar).new(),
    remap : analysis.variable_id_remapping,
    loop_starts : ArrayList(u64).new(),
    loop_ends : ArrayList(u64).new(),
    span_ends : HashMap(usize, u64).new(),
    await_sites : ArrayList(String).new(),
    await_pos : ArrayList(u64).new(),
    await_stmt_end : ArrayList(u64).new(),
    bindings : HashSet(String).new(),
    names : HashMap(String, ArrayList(String)).new()
  );
  body_end := _lv_span_end(body_expr.clone(), w);
  _lv_walk(body_expr.clone(), body_end, body_end, w, context);
  // Suspension positions, and the future temps each await consumes.
  sus := ArrayList(u64).new();
  consumed_temps := HashSet(String).new();
  note_await := (fn(ae : AstExpr, sus : ArrayList(u64), consumed : HashSet(String), w : _LiveWalk, context : FunctionGenerationContext) -> unit)({
    sus.push(_lv_pos(ast_expr_token(ae.clone()), w));
    match(
      ae,
      .FnCall(_, _, aargs, _, _) => match(
        aargs.get(usize(0)),
        .Some(fut) => if(!ast_expr_is_atom(fut), {
          match(
            context.base.get_expr_info(fut),
            .Some(fi) => match(
              fi.variable_name,
              .Some(vn) => {
                note_await_consumed_temp(vn.clone());
                consumed.insert(vn);
              },
              .None => ()
            ),
            .None => ()
          );
        }),
        .None => ()
      ),
      .Atom(_, _) => ()
    );
  });
  (pi : usize) = usize(0);
  while(pi < analysis.await_points.len(), pi = (pi + usize(1)), {
    match(
      analysis.await_points.get(pi),
      .Some(ap) => match(
        ap.base.cond_branch_suspension_exprs,
        .Some(bes) => {
          (bj : usize) = usize(0);
          while(bj < bes.len(), bj = (bj + usize(1)), {
            match(bes.get(bj), .Some(be) => note_await(be, sus, consumed_temps, w, context), .None => ());
          });
          note_await(ap.base.expr, sus, consumed_temps, w, context);
        },
        .None => note_await(ap.base.expr, sus, consumed_temps, w, context)
      ),
      .None => ()
    );
  });
  // An await's result is a C local unless a later await in its statement can
  // suspend before the statement consumes it (`f(await a, await b)`).
  if(!w.foreign, {
    (wi : usize) = usize(0);
    while(wi < w.await_sites.len(), wi = (wi + usize(1)), {
      p := match(w.await_pos.get(wi), .Some(x) => x, .None => u64(0));
      se := match(w.await_stmt_end.get(wi), .Some(x) => x, .None => u64(0));
      (later : bool) = false;
      (qi : usize) = usize(0);
      while((qi < w.await_pos.len()) && !later, qi = (qi + usize(1)), {
        q := match(w.await_pos.get(qi), .Some(x) => x, .None => u64(0));
        if((q > p) && (q <= se), {
          later = true;
        });
      });
      if(!later, {
        match(
          w.await_sites.get(wi),
          .Some(site) => {
            g_local_await_results.insert(site);
          },
          .None => ()
        );
      });
    });
  });
  all_ids := HashSet(String).new();
  segments := HashMap(String, HashSet(usize)).new();
  (ai : usize) = usize(0);
  while(ai < captured_variables.len(), ai = (ai + usize(1)), {
    match(
      captured_variables.get(ai),
      .Some(cv) => match(
        cv.kind,
        .Local => if(!is_unit_type(cv.base.ty), {
          id := cv.base.id.to_string();
          crosses := cond(
            w.foreign => true,
            consumed_temps.contains(cv.base.name.clone()) => false,
            true => match(
              w.vars.get(id.clone()),
              // Not declared in this body as the walk sees it (a minted temp,
              // a binding it cannot place): keep its field.
              .None => true,
              .Some(lv) => {
                end := if((lv.to_scope_end || type_contains_rc_type(cv.base.ty)) && (lv.scope_end > lv.last), lv.scope_end, lv.last);
                (hit : bool) = false;
                (si : usize) = usize(0);
                while((si < sus.len()) && !hit, si = (si + usize(1)), {
                  sp := match(sus.get(si), .Some(x) => x, .None => u64(0));
                  if((sp > lv.def_end) && (sp <= end), {
                    hit = true;
                  });
                });
                hit
              }
            )
          );
          if(crosses, {
            // Its live range, for slot sharing (`compute_overlapping_slots`
            // reads the min and max of the set).
            match(
              w.vars.get(id.clone()),
              .Some(lv2) => if(!w.foreign, {
                end2 := if((lv2.to_scope_end || type_contains_rc_type(cv.base.ty)) && (lv2.scope_end > lv2.last), lv2.scope_end, lv2.last);
                seg := HashSet(usize).new();
                seg.insert(usize(lv2.def_end));
                seg.insert(usize(end2));
                segments.insert(id.clone(), seg);
              }),
              .None => ()
            );
            all_ids.insert(id);
          });
        }),
        .Outer => ()
      ),
      .None => ()
    );
  });
  CrossBoundaryResult(
    cross_boundary_ids : all_ids,
    await_future_temp_var_aliases : HashMap(String, String).new(),
    variable_segments : segments,
    pattern_binding_ids : w.bindings
  )
});
_SlotRange :: ref(struct(min : usize, max : usize));
/// An overlapping storage slot shared by ≥2 non-RC value vars with disjoint live
/// ranges.
OverlappingSlot :: ref(
  struct(
    /// The struct field name, e.g. `slot_0`.
    field_name : String,
    /// The C type string for this slot.
    c_type : String,
    /// The members' type (they share one C type): the dispose drops an RC
    /// slot once, through it.
    ty : TypeValue,
    /// Variable names sharing this slot (for comments).
    variable_names : ArrayList(String)
  )
);
/// Result of overlapping storage analysis.
OverlappingStorageResult :: ref(
  struct(
    /// Maps variable IDs to their aliased slot field name.
    slot_aliases : HashMap(String, String),
    /// Slot field definitions for the struct.
    slots : ArrayList(OverlappingSlot)
  )
);
/// Find the eligible captured variable with the given id. Helper for slot naming.
_find_captured_by_id :: (
  fn(eligible : ArrayList(CapturedVariable), id : String) -> Option(CapturedVariable)
)({
  (i : usize) = usize(0);
  (found : Option(CapturedVariable)) = Option(CapturedVariable).None;
  while((i < eligible.len()) && found.is_none(), {
    match(
      eligible.get(i),
      .Some(v) => if(v.base.id == id, {
        found = Option(CapturedVariable).Some(v);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// Compute overlapping storage slots for cross-boundary variables: same-C-type
/// non-RC value vars whose live ranges don't overlap can share one struct field
/// (greedy graph coloring per type group).
/// NOTE: HashMap is not insertion-ordered, so
/// type/var iteration is driven off the ordered `eligible`/`ordered_c_types`
/// lists to keep slot assignment deterministic (any valid coloring is correct —
/// disjoint live ranges never collide — so the exact slot_N numbering is free).
compute_overlapping_slots :: (
  fn(
    cross_boundary_ids : HashSet(String),
    variable_segments : HashMap(String, HashSet(usize)),
    captured_variables : ArrayList(CapturedVariable),
    await_future_temp_var_aliases : HashMap(String, String),
    pattern_binding_ids : HashSet(String),
    context : FunctionGenerationContext
  ) -> OverlappingStorageResult
)({
  empty_result := OverlappingStorageResult(
    slot_aliases : HashMap(String, String).new(),
    slots : ArrayList(OverlappingSlot).new()
  );
  // Eligible = cross-boundary locals, not future-aliased. An RC temporary
  // shares too: every drop and every move of a temp's slot zeroes it, so a
  // shared slot is non-zero exactly while it owns its current member's value,
  // and the dispose drops it once. Three kinds of RC local stay out: a pattern
  // binding (it borrows the scrutinee's payload), a local whose value another
  // local also owns (either side of `is_owning_the_same_rc_value_as`), and a
  // NAMED local, whose move keeps the value in its own slot under a move flag
  // (`sm_move_flag_of`), which a shared slot's next member would inherit.
  rc_owners := HashSet(String).new();
  (o0 : usize) = usize(0);
  while(o0 < captured_variables.len(), o0 = (o0 + usize(1)), {
    match(
      captured_variables.get(o0),
      .Some(ov) => match(
        ov.is_owning_the_same_rc_value_as,
        .Some(ob) => {
          rc_owners.insert(ob.*.base.id.to_string());
        },
        .None => ()
      ),
      .None => ()
    );
  });
  eligible := ArrayList(CapturedVariable).new();
  (e0 : usize) = usize(0);
  while(e0 < captured_variables.len(), {
    match(
      captured_variables.get(e0),
      .Some(v) => {
        is_local := match(v.kind, .Local => true, .Outer => false);
        vid0 := v.base.id.to_string();
        rc_shareable := (!pattern_binding_ids.contains(vid0.clone()) && is_any_temp_variable_name(v.base.name.clone()) && (v.is_owning_the_same_rc_value_as.is_none() && !rc_owners.contains(vid0.clone())));
        if(is_local && cross_boundary_ids.contains(vid0.clone()) && !await_future_temp_var_aliases.contains_key(vid0.clone()) && (!type_contains_rc_type(v.base.ty) || rc_shareable), {
          eligible.push(v);
        });
      },
      .None => ()
    );
    e0 = (e0 + usize(1));
  });
  if(eligible.len() < usize(2), {
    return(empty_result);
  });
  // Live range [min,max] over numbered segments (exclude CLEANUP_SEGMENT).
  ranges := HashMap(String, _SlotRange).new();
  (r0 : usize) = usize(0);
  while(r0 < eligible.len(), {
    match(
      eligible.get(r0),
      .Some(v) => match(
        variable_segments.get(v.base.id.to_string()),
        .Some(segs) => {
          (has_any : bool) = false;
          (mn : usize) = usize(0);
          (mx : usize) = usize(0);
          seg_it := segs.into_iter();
          (sgo : bool) = true;
          while(sgo, {
            match(
              seg_it.next(),
              .Some(s) => if(s != CLEANUP_SEGMENT, {
                if(!has_any, {
                  mn = s;
                  mx = s;
                  has_any = true;
                }, {
                  if(s < mn, {
                    mn = s;
                  });
                  if(s > mx, {
                    mx = s;
                  });
                });
              }),
              .None => {
                sgo = false;
              }
            );
          });
          if(has_any, {
            ranges.insert(v.base.id.to_string(), _SlotRange(min : mn, max : mx));
          });
        },
        .None => ()
      ),
      .None => ()
    );
    r0 = (r0 + usize(1));
  });
  if(ranges.len() < usize(2), {
    return(empty_result);
  });
  // Group eligible vars (that have a range) by C type — iterate `eligible` order
  // for determinism; `ordered_c_types` records first-appearance order.
  by_type := HashMap(String, ArrayList(String)).new();
  ordered_c_types := ArrayList(String).new();
  (g0 : usize) = usize(0);
  while(g0 < eligible.len(), {
    match(
      eligible.get(g0),
      .Some(v) => {
        vid := v.base.id.to_string();
        if(ranges.contains_key(vid.clone()), {
          ctype := get_type_string(v.base.ty, context.base);
          if(!by_type.contains_key(ctype.clone()), {
            ordered_c_types.push(ctype.clone());
          });
          group := match(by_type.get(ctype.clone()), .Some(grp) => grp, .None => ArrayList(String).new());
          group.push(vid.clone());
          by_type.insert(ctype.clone(), group);
        });
      },
      .None => ()
    );
    g0 = (g0 + usize(1));
  });
  slot_aliases := HashMap(String, String).new();
  slots := ArrayList(OverlappingSlot).new();
  (next_slot_index : usize) = usize(0);
  (ot : usize) = usize(0);
  while(ot < ordered_c_types.len(), {
    ctype := match(ordered_c_types.get(ot), .Some(c) => c, .None => String.new());
    var_ids := match(by_type.get(ctype.clone()), .Some(g) => g, .None => ArrayList(String).new());
    if(var_ids.len() >= usize(2), {
      // Interference graph: two vars conflict if their ranges overlap.
      conflicts := HashMap(String, HashSet(String)).new();
      (ii : usize) = usize(0);
      while(ii < var_ids.len(), {
        id_i := match(var_ids.get(ii), .Some(x) => x, .None => String.new());
        (jj : usize) = (ii + usize(1));
        while(jj < var_ids.len(), {
          id_j := match(var_ids.get(jj), .Some(x) => x, .None => String.new());
          ra := match(ranges.get(id_i.clone()), .Some(r) => r, .None => _SlotRange(min : usize(0), max : usize(0)));
          rb := match(ranges.get(id_j.clone()), .Some(r) => r, .None => _SlotRange(min : usize(0), max : usize(0)));
          if((ra.min <= rb.max) && (rb.min <= ra.max), {
            ci := match(conflicts.get(id_i.clone()), .Some(s) => s, .None => HashSet(String).new());
            ci.insert(id_j.clone());
            conflicts.insert(id_i.clone(), ci);
            cj := match(conflicts.get(id_j.clone()), .Some(s) => s, .None => HashSet(String).new());
            cj.insert(id_i.clone());
            conflicts.insert(id_j.clone(), cj);
          });
          jj = (jj + usize(1));
        });
        ii = (ii + usize(1));
      });
      // Greedy coloring.
      colors := HashMap(String, usize).new();
      (ki : usize) = usize(0);
      while(ki < var_ids.len(), {
        var_id := match(var_ids.get(ki), .Some(x) => x, .None => String.new());
        used_colors := HashSet(usize).new();
        cset := match(conflicts.get(var_id.clone()), .Some(s) => s, .None => HashSet(String).new());
        c_it := cset.into_iter();
        (cgo : bool) = true;
        while(cgo, {
          match(
            c_it.next(),
            .Some(conflict_id) => match(
              colors.get(conflict_id),
              .Some(col) => {
                used_colors.insert(col);
              },
              .None => ()
            ),
            .None => {
              cgo = false;
            }
          );
        });
        (color : usize) = usize(0);
        while(used_colors.contains(color), {
          color = (color + usize(1));
        });
        colors.insert(var_id.clone(), color);
        ki = (ki + usize(1));
      });
      // Group var_ids by color (iterate var_ids order; ordered_colors for output).
      color_to_vars := HashMap(usize, ArrayList(String)).new();
      ordered_colors := ArrayList(usize).new();
      (cti : usize) = usize(0);
      while(cti < var_ids.len(), {
        var_id := match(var_ids.get(cti), .Some(x) => x, .None => String.new());
        col := match(colors.get(var_id.clone()), .Some(c) => c, .None => usize(0));
        if(!color_to_vars.contains_key(col), {
          ordered_colors.push(col);
        });
        cgroup := match(color_to_vars.get(col), .Some(g) => g, .None => ArrayList(String).new());
        cgroup.push(var_id.clone());
        color_to_vars.insert(col, cgroup);
        cti = (cti + usize(1));
      });
      // Create a slot per color group with ≥2 members (actual sharing).
      (oci : usize) = usize(0);
      while(oci < ordered_colors.len(), {
        col := match(ordered_colors.get(oci), .Some(c) => c, .None => usize(0));
        group_var_ids := match(color_to_vars.get(col), .Some(g) => g, .None => ArrayList(String).new());
        if(group_var_ids.len() >= usize(2), {
          field_name := String.from("slot_");
          field_name.push_string(next_slot_index.to_string());
          var_names := ArrayList(String).new();
          (slot_ty : TypeValue) = TypeValue.Unit;
          (vni : usize) = usize(0);
          while(vni < group_var_ids.len(), {
            gid := match(group_var_ids.get(vni), .Some(x) => x, .None => String.new());
            nm := match(
              _find_captured_by_id(eligible, gid.clone()),
              .Some(fv) => {
                slot_ty = fv.base.ty;
                fv.base.name.clone()
              },
              .None => gid.clone()
            );
            var_names.push(nm);
            slot_aliases.insert(gid.clone(), field_name.clone());
            vni = (vni + usize(1));
          });
          slots.push(
            OverlappingSlot(field_name : field_name.clone(), c_type : ctype.clone(), ty : slot_ty, variable_names : var_names)
          );
          next_slot_index = (next_slot_index + usize(1));
        });
        oci = (oci + usize(1));
      });
    });
    ot = (ot + usize(1));
  });
  OverlappingStorageResult(slot_aliases : slot_aliases, slots : slots)
});
uses_generic_future_interface :: (fn(future_type : TypeValue, context : FunctionGenerationContext) -> bool)({
  if(!(is_some_type(future_type) && type_implements_future(future_type)), {
    return(false);
  });
  fid := match(future_type, .SomeT({ id }) => id, _ => String.from(""));
  if(context.base.types.contains_key(fid.clone()), {
    return(false);
  });
  match(
    some_resolution(future_type),
    .Some(rc) => {
      if(is_some_type(rc), {
        rcid := match(rc, .SomeT({ id }) => id, _ => String.from(""));
        if(context.base.types.contains_key(rcid), {
          return(false);
        });
      });
      if(is_struct_type(rc), {
        capture_id := match(rc, .Struct({ id }) => id, _ => String.from(""));
        it := context.base.types.into_iter();
        (go : bool) = true;
        while(go, {
          match(
            it.next(),
            .Some(bucket) => {
              ety := bucket.value.ty;
              if(is_some_type(ety) && type_implements_future(ety), {
                match(
                  some_resolution(ety),
                  .Some(erc) => if(is_struct_type(erc), {
                    ercid := match(erc, .Struct({ id }) => id, _ => String.from(""));
                    if(ercid == capture_id, {
                      return(false);
                    });
                  }),
                  .None => ()
                );
              });
            },
            .None => {
              go = false;
            }
          );
        });
      });
    },
    .None => ()
  );
  extract_future_trait_from_type(future_type).is_some()
});
/// Emit the effect-injection line for one captured effect member of a Future:
/// the generic `vt->set_effect` call for generic-interface Futures, or
/// a direct `__capture.<label>` store for concrete Futures.
emit_future_effect_injection_line :: (
  fn(
    future_type : TypeValue,
    future_access : String,
    field_label : String,
    member_code : String,
    indent : String,
    context : FunctionGenerationContext
  ) -> unit
)({
  em := context.base.emitter;
  if(uses_generic_future_interface(future_type, context), {
    lbl := _c_string_literal(field_label.clone());
    em.emit_string_line(`${indent}if (${future_access}->vt && ${future_access}->vt->set_effect) ${future_access}->vt->set_effect((void*)${future_access}, ${lbl}, (void*)${member_code});`);
    return();
  });
  em.emit_string_line(`${indent}${future_access}->__capture.${sanitize_for_c_identifier(field_label.clone(), false)} = (void*)${member_code};`);
});
/// Resolve the C code for an effect-handler field from the surrounding
/// state-machine scope: a caller evidence param (`current_evidence_params`) wins,
/// else an outer captured variable (`sm->__capture.<label>`), else `.None`.
resolve_effect_field_from_sm_scope :: (
  fn(field_label : String, context : FunctionGenerationContext, _expr : AstExpr) -> Option(String)
)({
  _expr;
  match(
    context.current_evidence_params,
    .Some(eps) => {
      it := eps.into_iter();
      (go : bool) = true;
      while(go, {
        match(
          it.next(),
          .Some(b) => if(b.value.field_label == field_label, {
            return(Option(String).Some(b.value.c_param_name));
          }),
          .None => {
            go = false;
          }
        );
      });
    },
    .None => ()
  );
  match(
    context.state_machine_variables,
    .Some(svm) => {
      it2 := svm.into_iter();
      (go2 : bool) = true;
      while(go2, {
        match(
          it2.next(),
          .Some(b) => {
            cv := b.value;
            is_outer := match(cv.kind, .Outer => true, .Local => false);
            if((cv.base.name == field_label) && is_outer, {
              s := String.from("sm->__capture.");
              s.push_string(sanitize_for_c_identifier(field_label.clone(), false));
              return(Option(String).Some(s));
            });
          },
          .None => {
            go2 = false;
          }
        );
      });
    },
    .None => ()
  );
  Option(String).None
});
/// Build the state-machine variable map (variable id → captured variable) the
/// resume generator binds while emitting resume-state code: the analysis's
/// captured variables (keyed by id) plus the closure's `__capture` struct fields
/// (as `outer` captures, keyed by label).
_build_combined_sm_variables :: (
  fn(analysis : AwaitAnalysisResult, capture_type : Option(TypeValue)) -> HashMap(String, CapturedVariable)
)({
  combined := HashMap(String, CapturedVariable).new();
  // Assign each LOCAL capture its stable C field name (name-derived,
  // deduped within this SM) — see state_machine_naming.yo.
  register_sm_captured_names(analysis.captured_variables);
  cvs := analysis.captured_variables;
  (i : usize) = usize(0);
  while(i < cvs.len(), {
    match(
      cvs.get(i),
      .Some(v) => {
        combined.insert(v.base.id.to_string(), v);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  match(
    capture_type,
    .Some(ct) => {
      flabels := match(ct, .Struct({ field_labels : fl }) => fl, _ => ArrayList(String).new());
      ftypes := match(ct, .Struct({ field_types : ft }) => ft, _ => ArrayList(TypeValue).new());
      (j : usize) = usize(0);
      while(j < flabels.len(), {
        lbl := match(flabels.get(j), .Some(l) => l, .None => String.from(""));
        ty := match(ftypes.get(j), .Some(t) => t, .None => TypeValue.Unit);
        cv := CapturedVariable(
          base : SuspensionCapturedVariable(
            id : lbl.clone(),
            name : lbl.clone(),
            ty : ty,
            is_owning_the_same_rc_value_as : Option(Box(SuspensionCapturedVariable)).None,
            decl_site : String.from("")
          ),
          kind : CapturedVariableKind.Outer,
          is_owning_the_same_rc_value_as : Option(Box(CapturedVariable)).None
        );
        combined.insert(lbl.clone(), cv);
        j = (j + usize(1));
      });
    },
    .None => ()
  );
  combined
});
/// The SM struct field holding the outer effect-bundle to forward into an inner
/// future via `__yo_future_set_bundle` — the captured local (`var_<id>`, or
/// its field alias) whose type matches the future's struct effect. Lives here
/// (not in exprs/async.yo) to break the
/// async.yo<->state_machine.yo cycle — it is a future-trait/SM-var helper.
find_bundle_field_name :: (
  fn(
    future_trait_type : TypeValue,
    state_machine_variables : Option(HashMap(String, CapturedVariable)),
    state_machine_field_aliases : Option(HashMap(String, String))
  ) -> Option(String)
)({
  eff_types := match(future_trait_type, .FutureTraitT({ effect_types : et }) => et, _ => ArrayList(TypeValue).new());
  (eff_id : Option(String)) = Option(String).None;
  (ei : usize) = usize(0);
  while((ei < eff_types.len()) && eff_id.is_none(), {
    match(
      eff_types.get(ei),
      .Some(et) => if(is_struct_type(et), {
        eff_id = Option(String).Some(match(et, .Struct({ id }) => id, _ => String.from("")));
      }),
      .None => ()
    );
    ei = (ei + usize(1));
  });
  match(
    eff_id,
    .None => Option(String).None,
    .Some(target_id) => match(
      state_machine_variables,
      .Some(svm) => {
        (fallback : Option(String)) = Option(String).None;
        it := svm.into_iter();
        (go : bool) = true;
        while(go, {
          match(
            it.next(),
            .Some(b) => {
              smvar := b.value;
              is_outer := match(smvar.kind, .Outer => true, .Local => false);
              if(!is_outer, {
                svid := match(smvar.base.ty, .Struct({ id }) => id, _ => String.from(""));
                if(svid == target_id, {
                  aliased := match(state_machine_field_aliases, .Some(al) => al.get(smvar.base.id.to_string()), .None => Option(String).None);
                  match(
                    aliased,
                    .Some(a) => return(Option(String).Some(a)),
                    .None => if(fallback.is_none(), {
                      fallback = Option(String).Some(sm_local_field_name(smvar.base.id.to_string()));
                    })
                  );
                });
              });
            },
            .None => {
              go = false;
            }
          );
        });
        fallback
      },
      .None => Option(String).None
    )
  )
});
/// Inject each function-typed member of a struct/source-namespace effect bundle
/// into the awaited future (resolving the member's C code from SM captures /
/// the using-arg value / evidence params / env given-bindings), via the generic
/// vtable or a direct capture store.
emit_effect_record_injection_for_sm :: (
  fn(
    source_namespace_type : TypeValue,
    future_type : TypeValue,
    future_access : String,
    indent : String,
    using_arg_value : Option(EvalValue),
    context : FunctionGenerationContext,
    expr : AstExpr
  ) -> unit
)({
  field_labels := match(source_namespace_type, .Struct({ field_labels : fl }) => fl, _ => ArrayList(String).new());
  field_types := match(source_namespace_type, .Struct({ field_types : ft }) => ft, _ => ArrayList(TypeValue).new());
  (fi : usize) = usize(0);
  while(fi < field_labels.len(), {
    flabel := match(field_labels.get(fi), .Some(l) => l, .None => String.from(""));
    ftype := match(field_types.get(fi), .Some(t) => t, .None => TypeValue.Unit);
    if(is_function_type(ftype), {
      (member_code : Option(String)) = Option(String).None;
      // 1. Captured outer SM variable matching the field label.
      match(
        context.state_machine_variables,
        .Some(svm) => {
          it := svm.into_iter();
          (go : bool) = true;
          while(go && member_code.is_none(), {
            match(
              it.next(),
              .Some(b) => {
                cv := b.value;
                is_outer := match(cv.kind, .Outer => true, .Local => false);
                if((cv.base.name == flabel) && is_outer, {
                  s := String.from("sm->__capture.");
                  s.push_string(sanitize_for_c_identifier(flabel.clone(), false));
                  member_code = Option(String).Some(s);
                });
              },
              .None => {
                go = false;
              }
            );
          });
        },
        .None => ()
      );
      // 2. Explicit using-arg effect record value.
      if(member_code.is_none(), {
        match(
          using_arg_value,
          .Some(uav) => match(
            uav,
            .StructVal(_, ulabels, uvals) => {
              (ui : usize) = usize(0);
              while((ui < ulabels.len()) && member_code.is_none(), {
                match(
                  ulabels.get(ui),
                  .Some(ul) => if(ul == flabel, {
                    match(
                      uvals.get(ui),
                      .Some(mv) => match(
                        mv,
                        .FuncVal(__fvd1, _) => match(
                          context.base.functions.get(__fvd1.*.func_id),
                          .Some(fe) => {
                            member_code = Option(String).Some(fe.c_name);
                          },
                          .None => ()
                        ),
                        _ => ()
                      ),
                      .None => ()
                    );
                  }),
                  .None => ()
                );
                ui = (ui + usize(1));
              });
            },
            _ => ()
          ),
          .None => ()
        );
      });
      // 3. Caller evidence params.
      if(member_code.is_none(), {
        match(
          context.current_evidence_params,
          .Some(eps) => {
            it := eps.into_iter();
            (go : bool) = true;
            while(go && member_code.is_none(), {
              match(
                it.next(),
                .Some(b) => if(b.value.field_label == flabel, {
                  member_code = Option(String).Some(b.value.c_param_name);
                }),
                .None => {
                  go = false;
                }
              );
            });
          },
          .None => ()
        );
      });
      // 4. Given bindings in the call environment (innermost-first).
      if(member_code.is_none(), {
        match(
          context.base.get_expr_info(expr),
          .Some(ei) => {
            implicit_vars := get_variables_from_env_by_filter(ei.env, (v : Variable) => true);
            (k : usize) = implicit_vars.len();
            while((k > usize(0)) && member_code.is_none(), {
              k = (k - usize(1));
              match(
                implicit_vars.get(k),
                .Some(v) => match(
                  v.value.get(usize(0)),
                  .Some(val) => match(
                    val,
                    .StructVal(_, vlabels, vvals) => {
                      (vi : usize) = usize(0);
                      while((vi < vlabels.len()) && member_code.is_none(), {
                        match(
                          vlabels.get(vi),
                          .Some(vl) => if(vl == flabel, {
                            match(
                              vvals.get(vi),
                              .Some(fv) => match(
                                fv,
                                .FuncVal(__fvd2, _) => match(
                                  context.base.functions.get(__fvd2.*.func_id),
                                  .Some(fe) => {
                                    member_code = Option(String).Some(fe.c_name);
                                  },
                                  .None => ()
                                ),
                                _ => ()
                              ),
                              .None => ()
                            );
                          }),
                          .None => ()
                        );
                        vi = (vi + usize(1));
                      });
                    },
                    _ => ()
                  ),
                  .None => ()
                ),
                .None => ()
              );
            });
          },
          .None => ()
        );
      });
      match(member_code, .Some(mc) => emit_future_effect_injection_line(future_type, future_access, flabel, mc, indent, context), .None => ());
    });
    fi = (fi + usize(1));
  });
});
/// Inject effect handlers into an awaited future inside a state machine: for each
/// effect on the future's trait, a function-type effect resolves its handler from
/// the SM scope; a struct/source-namespace effect forwards the outer bundle field
/// (or injects each member). Iterates the `FutureTraitT` effect arrays.
emit_effect_injection_for_sm :: (
  fn(await_expr : AstExpr, future_access : String, indent : String, context : FunctionGenerationContext) -> unit
)({
  em := context.base.emitter;
  args := match(await_expr, .FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
  match(
    args.get(usize(0)),
    .Some(fut_arg) => match(
      context.base.get_expr_info(fut_arg),
      .Some(fei) => {
        fut_ty := fei.ty;
        match(
          extract_future_trait_from_type(fut_ty),
          .Some(ftrait) => {
            eff_labels := match(ftrait, .FutureTraitT({ effect_labels : el }) => el, _ => ArrayList(String).new());
            eff_types := match(ftrait, .FutureTraitT({ effect_types : et }) => et, _ => ArrayList(TypeValue).new());
            (i : usize) = usize(0);
            while(i < eff_labels.len(), {
              elabel := match(eff_labels.get(i), .Some(l) => l, .None => String.from(""));
              etype := match(eff_types.get(i), .Some(t) => t, .None => TypeValue.Unit);
              if(is_function_type(etype), {
                has_forall := match(etype, .Func({ meta : __fm1 }) => (__fm1.*.forall_labels.len() > usize(0)), _ => false);
                if(!has_forall, {
                  match(
                    resolve_effect_field_from_sm_scope(elabel, context, await_expr),
                    .Some(handler) => emit_future_effect_injection_line(fut_ty, future_access, elabel, handler, indent, context),
                    .None => ()
                  );
                });
              }, {
                if(is_struct_type(etype), {
                  // The bundle named AT THE AWAIT wins: `e.io.await(fut, inner)`
                  // supplies `fut`'s handlers (docs/en-US/ALGEBRAIC_EFFECTS.md
                  // "Async + effects"; the top-level `io.await` path in
                  // exprs/await.yo does the same). Materialize it into a temp of
                  // the ARG's own recorded type — an anonymous record literal
                  // lowers to its own C struct, the future's declared effect is
                  // the named twin — and hand its address over; set_effect copies
                  // the value, so a resume-frame temp is safe. Only without an
                  // explicit bundle does the enclosing task's own bundle field
                  // (or a member-wise record injection) forward
                  // (issues/fixed/io-await-effect-bundle-ignored-inside-io-async.md).
                  match(
                    args.get(usize(1)),
                    .Some(bundle_arg) => {
                      bundle_code := _call_generate_expr(bundle_arg, indent.clone(), context);
                      bundle_cast_ty := match(
                        context.base.get_expr_info(bundle_arg),
                        .Some(bae) => if(is_struct_type(bae.ty), bae.ty, etype),
                        .None => etype
                      );
                      bundle_type := get_type_string(bundle_cast_ty, context.base);
                      tmp_name := fresh_local_name(String.from("__yo_eff_bundle_"), context.base.current_function_name);
                      em.emit_string_line(`${indent}${bundle_type} ${tmp_name.clone()} = ${bundle_code};`);
                      em.emit_string_line(`${indent}__yo_future_set_bundle((void*)${future_access}, (void*)&${tmp_name});`);
                    },
                    .None => match(
                      find_bundle_field_name(ftrait, context.state_machine_variables, context.state_machine_field_aliases),
                      .Some(obf) => {
                        em.emit_string_line(`${indent}__yo_future_set_bundle((void*)${future_access}, (void*)&sm->${obf});`);
                      },
                      .None => {
                        emit_effect_record_injection_for_sm(etype, fut_ty, future_access, indent, Option(EvalValue).None, context, await_expr);
                      }
                    )
                  );
                });
              });
              i = (i + usize(1));
            });
          },
          .None => ()
        );
      },
      .None => ()
    ),
    .None => ()
  );
});
_emit_await_suspension_core :: (
  fn(
    acc : String,
    is_io_future : bool,
    next_s : String,
    resume_function_name : String,
    effect_expr : AstExpr,
    ind : String,
    context : FunctionGenerationContext,
    /// Where the inline fast path continues: the next state's case label
    /// (`state_<next>`) in the segment lowering, the await's own resume label
    /// in the single-pass lowering.
    resume_label : String
  ) -> unit
)({
  em := context.base.emitter;
  em.emit_string_line(`${ind}// Transition to next state after await`);
  em.emit_string_line(`${ind}sm->state = ${next_s};`);
  em.emit_string_line(``);
  em.emit_string_line(`${ind}// Check if future is ready`);
  em.emit_string_line(`${ind}int future_state = ${acc}->state;`);
  em.emit_string_line(`${ind}if (future_state == -1 || future_state == -2) {  // -1 = completed, -2 = aborted`);
  em.emit_string_line(`${ind}  // Already complete — bounded inline fast-path to avoid scheduler round-trip`);
  em.emit_string_line(`${ind}  if (__yo_inline_budget > 0) {`);
  em.emit_string_line(`${ind}    __yo_inline_budget--;`);
  em.emit_string_line(`${ind}    goto ${resume_label};`);
  em.emit_string_line(`${ind}  }`);
  em.emit_string_line(`${ind}  // Budget exhausted — yield once for fairness (microtask yield)`);
  em.emit_string_line(`${ind}  __yo_async_spawn_task(${resume_function_name}, (void*)sm);`);
  em.emit_string_line(`${ind}  return;`);
  em.emit_string_line(`${ind}}`);
  em.emit_string_line(``);
  if(is_io_future, {
    em.emit_string_line(`${ind}// Io future: no extra ref needed (completion handler does not decr_rc)`);
  });
  if(!is_io_future, {
    // The running-task reference is taken by whoever STARTS the future: its
    // completion releases exactly one. A future that is already running
    // (spawned, or started by another awaiter) has one already, and taking a
    // second leaked the future and its result
    // (issues/fixed/awaiting-an-already-started-future-from-a-state-machine-leaks-it.md).
    em.emit_string_line(`${ind}if (future_state == 0) {  // 0 = cold (not started)`);
    em.emit_string_line(`${ind}  __yo_incr_rc((void*)${acc});  // running-task reference, released by its completion`);
    inner := ind.clone();
    inner.push_str("  ");
    emit_effect_injection_for_sm(effect_expr, acc.clone(), inner, context);
    em.emit_string_line(`${ind}  // Cold future — start it via stored resume function pointer`);
    em.emit_string_line(`${ind}  ${acc}->vt->resume((void*)${acc});`);
    em.emit_string_line(``);
    em.emit_string_line(`${ind}  // Re-check: may have completed synchronously`);
    em.emit_string_line(`${ind}  future_state = ${acc}->state;`);
    em.emit_string_line(`${ind}  if (future_state == -1 || future_state == -2) {`);
    // Continue inline, exactly as for a future that was already complete: the
    // child's running reference is already released, and a round trip through
    // the scheduler (a kernel entry once any I/O is pending) bought nothing
    // but fairness, which the budget still provides
    // (plans/ASYNC_STATE_MACHINE_GENERATION.md §3.4: 330 → 100 ns with I/O pending).
    em.emit_string_line(`${ind}    if (__yo_inline_budget > 0) {`);
    em.emit_string_line(`${ind}      __yo_inline_budget--;`);
    em.emit_string_line(`${ind}      goto ${resume_label};`);
    em.emit_string_line(`${ind}    }`);
    em.emit_string_line(`${ind}    __yo_async_spawn_task(${resume_function_name}, (void*)sm);`);
    em.emit_string_line(`${ind}    return;`);
    em.emit_string_line(`${ind}  }`);
    em.emit_string_line(`${ind}}`);
  });
  em.emit_string_line(``);
  // Joins the future's waiters rather than taking its single slot: a second
  // awaiter of one pending future used to evict the first
  // (issues/fixed/two-tasks-awaiting-one-pending-future-lose-the-first-waiter.md).
  em.emit_string_line(`${ind}// Still pending — register as a waiter and suspend`);
  em.emit_string_line(`${ind}__yo_future_add_waiter((void*)${acc}, ${resume_function_name}, (void*)sm);`);
  em.emit_string_line(`${ind}return;`);
});
_emit_await_result_store :: (
  fn(dest : String, src : String, rt : TypeValue, is_reassign : bool, ind : String, context : FunctionGenerationContext) -> unit
)({
  em := context.base.emitter;
  if(!type_contains_rc_type(rt), {
    em.emit_string_line(`${ind}${dest} = ${src};`);
    return();
  });
  dup_expr := match(
    get_dup_function_for_type(rt, context),
    .Some(dup) => `${dup}(${src})`,
    // No ___dup methods are synthesized, so this is the ordinary path: a
    // shallow copy would hand `dest` a BORROWED reference that the future's
    // dispose later frees (issues/fixed/self-built-compiler-uaf-in-report-and-build-paths.md).
    .None => generate_dup_code_for_value(src.clone(), rt, context)
  );
  if(!is_reassign, {
    em.emit_string_line(`${ind}${dest} = ${dup_expr};`);
    return();
  });
  tmp := fresh_local_name(String.from("__yo_await_new_"), context.base.current_function_name);
  em.emit_string_line(`${ind}{`);
  em.emit_string_line(`${ind}  ${get_type_string(rt, context.base)} ${tmp} = ${dup_expr};`);
  drop_code := generate_drop_code_for_value(dest.clone(), rt, context);
  if(drop_code.len() > usize(0), {
    em.emit_string_line(`${ind}  ${drop_code};`);
  });
  em.emit_string_line(`${ind}  ${dest} = ${tmp};`);
  em.emit_string_line(`${ind}}`);
});
_append_exprs :: (fn(dst : ArrayList(AstExpr), src : ArrayList(AstExpr)) -> unit)({
  (i : usize) = usize(0);
  while(i < src.len(), {
    match(
      src.get(i),
      .Some(e) => {
        dst.push(e);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
});
(g_inline_suspensions : HashMap(String, ArrayList(InlineSuspension))) = HashMap(String, ArrayList(InlineSuspension)).new();

/// The await's result type: the await point's (the analysis resolves it), else
/// the await expression's own recorded type.
_inline_await_result_type :: (fn(expr : AstExpr, analysis : Option(AwaitAnalysisResult), context : FunctionGenerationContext) -> TypeValue)({
  eid := ast_expr_id(expr);
  match(
    analysis,
    .Some(a) => {
      (i : usize) = usize(0);
      while(i < a.await_points.len(), i = (i + usize(1)), {
        match(
          a.await_points.get(i),
          .Some(ap) => if(ast_expr_id(ap.base.expr) == eid, {
            return(ap.result_type);
          }),
          .None => ()
        );
      });
    },
    .None => ()
  );
  match(context.base.get_expr_info(expr), .Some(ei) => ei.ty, .None => TypeValue.Unit)
});

/// Whether `t` is a unit result (or an unresolved Future SomeType): no field.
_inline_result_is_unit :: (fn(t : TypeValue) -> bool)(
  is_unit_type(t) || (
    is_some_type(t) && some_resolution(t).is_none()
  )
);
/// The single-pass lowering's result fields, one per non-unit await
/// EXPRESSION the analysis saw (`sm->__yo_await_result_<k>`). An await point
/// stands for one await, or, for a `cond`/`match` position, for every
/// branch's await (`cond_branch_suspension_exprs`), each with its own type.
/// The struct declares exactly these fields and the emitter stores into them,
/// so both walk this one list.
inline_await_result_fields :: (fn(analysis : AwaitAnalysisResult, context : FunctionGenerationContext) -> ArrayList(InlineAwaitResultField))({
  out := ArrayList(InlineAwaitResultField).new();
  seen := HashSet(usize).new();
  add := (fn(e : AstExpr, t : TypeValue, out : ArrayList(InlineAwaitResultField), seen : HashSet(usize)) -> unit)({
    if(!seen.contains(ast_expr_id(e)) && !_inline_result_is_unit(t) && !g_local_await_results.contains(_site_of(ast_expr_token(e.clone()))), {
      seen.insert(ast_expr_id(e));
      out.push(InlineAwaitResultField(name : `__yo_await_result_${out.len().to_string()}`, ty : t, expr : e));
    });
  });
  (i : usize) = usize(0);
  while(i < analysis.await_points.len(), i = (i + usize(1)), {
    match(
      analysis.await_points.get(i),
      .Some(ap) => match(
        ap.base.cond_branch_suspension_exprs,
        .Some(branch_exprs) => {
          (j : usize) = usize(0);
          while(j < branch_exprs.len(), j = (j + usize(1)), {
            match(branch_exprs.get(j), .Some(be) => add(be, _inline_await_result_type(be, Option(AwaitAnalysisResult).None, context), out, seen), .None => ());
          });
        },
        .None => add(ap.base.expr, ap.result_type, out, seen)
      ),
      .None => ()
    );
  });
  out
});
/// The result field of the await expression `expr`: by node id, else by
/// source position (an arm body can be generated from an evaluated copy whose
/// await node is not the one the analysis walked; its position is the same).
_inline_await_result_field_of :: (fn(expr : AstExpr, fields : ArrayList(InlineAwaitResultField)) -> Option(InlineAwaitResultField))({
  eid := ast_expr_id(expr);
  tok := ast_expr_token(expr);
  (by_pos : Option(InlineAwaitResultField)) = Option(InlineAwaitResultField).None;
  (i : usize) = usize(0);
  while(i < fields.len(), i = (i + usize(1)), {
    match(
      fields.get(i),
      .Some(f) => {
        if(ast_expr_id(f.expr) == eid, {
          return(Option(InlineAwaitResultField).Some(f));
        });
        ftok := ast_expr_token(f.expr);
        if(by_pos.is_none() && ((ftok.row == tok.row) && ((ftok.column == tok.column) && (ftok.module_path == tok.module_path))), {
          by_pos = Option(InlineAwaitResultField).Some(f);
        });
      },
      .None => ()
    );
  });
  by_pos
});
/// Emit one suspension point of the single-pass lowering, where the
/// expression generator reached `io.await(future, effects)`, and return the C
/// code of its result (empty for unit).
///
/// An anonymous future is stored in the task's one `__yo_await_slot` (a task
/// has at most one pending await), which owns it and is released once the
/// result is extracted; a named future (a variable or capture) is awaited in
/// place and stays with its owner. The suspension itself is the shared core,
/// continuing at this await's own resume label.
emit_inline_await :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)({
  em := context.base.emitter;
  low := match(
    context.sm_inline_lowering,
    .Some(l) => l,
    .None => {
      codegen_fatal(String.from("emit_inline_await outside the single-pass lowering"));
      return(String.from(""));
    }
  );
  eid := ast_expr_id(expr);
  if(low.emitted.contains(eid), {
    codegen_fatal(`the single-pass async lowering emitted await ${eid.to_string()} twice (an emitter generated its expression twice)`);
    return(String.from(""));
  });
  low.emitted.insert(eid);
  args := match(expr, .FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
  future_arg := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      codegen_fatal(String.from("await without a future argument"));
      return(String.from(""));
    }
  );
  future_ty := match(
    context.base.get_expr_info(future_arg),
    .Some(ei) => ei.ty,
    .None => {
      codegen_fatal(String.from("await argument without type information"));
      return(String.from(""));
    }
  );
  is_io := is_io_future_type(future_ty);
  k := low.next_state;
  low.next_state = (k + usize(1));
  ks := k.to_string();
  label := `__yo_resume_${ks}`;
  is_named := ast_expr_is_atom(future_arg);
  future_code := _call_generate_expr(future_arg, indent, context);
  (future_c_type : String) = get_type_string(future_ty, context.base);
  match(
    awaited_future_c_type_override(future_arg, context.base),
    .Some(o) => {
      future_c_type = o;
    },
    .None => ()
  );
  acc := if(is_named, future_code.clone(), `((${future_c_type})sm->__yo_await_slot)`);
  em.emit_string_line(`${indent}// await (resumes in state ${ks})`);
  if(!is_named, {
    emit_future_store_into_slot(future_arg, future_code, String.from("__yo_await_slot"), indent, context);
    // The slot owns the future now; the temp the evaluator minted for it
    // (its scope-end drop is scheduled) holds nothing of its own.
    match(
      context.base.get_expr_info(future_arg),
      .Some(fei) => match(
        fei.variable_name,
        .Some(fvn) => {
          low.moved_into_slot.insert(get_variable_name_for_codegen(fvn, Option(Environment).Some(fei.env)));
        },
        .None => ()
      ),
      .None => ()
    );
  });
  inner := indent.clone();
  inner.push_str("  ");
  em.emit_string_line(`${indent}{`);
  _emit_await_suspension_core(acc.clone(), is_io, ks.clone(), low.resume_function_name.clone(), expr, inner.clone(), context, label.clone());
  em.emit_string_line(`${indent}}`);
  em.emit_string_line(`${indent}${label}: ;`);
  low.suspensions.push(InlineSuspension(state : k, in_slot : !is_named, is_io : is_io));
  // The awaited future was aborted: this task takes over its unwind, and
  // catches it (its own handler) or escapes too.
  em.emit_string_line(`${indent}if (${acc}->state == -2) {`);
  em.emit_string_line(`${inner}__yo_task_abort_take_unwind((void*)${acc});`);
  if(!is_named, {
    em.emit_string_line(`${inner}__yo_decr_rc(sm->__yo_await_slot);`);
    em.emit_string_line(`${inner}sm->__yo_await_slot = NULL;`);
  });
  emit_sm_unwind_catch(em, inner.clone(), context.sm_unwind_catch);
  emit_async_future_escape(em, inner.clone(), Option(String).None, Option(String).Some(low.async_block_id.clone()));
  em.emit_string_line(`${indent}}`);
  // The result lives in the task, like every other value of the body: a
  // second await in the same expression suspends before this one's result is
  // read (`f(await a, await b)`), and a C local does not survive the jump.
  (out : String) = String.from("");
  match(
    _inline_await_result_field_of(expr, inline_await_result_fields(low.analysis, context)),
    .Some(rf) => {
      field := `sm->${rf.name}`;
      _emit_await_result_store(field.clone(), `${acc}->result`, rf.ty, false, indent.clone(), context);
      out = field;
    },
    .None => {
      rty := _inline_await_result_type(expr, Option(AwaitAnalysisResult).Some(low.analysis), context);
      if(!_inline_result_is_unit(rty), {
        if(g_local_await_results.contains(_site_of(ast_expr_token(expr.clone()))), {
          // No suspension between here and the statement's use of it.
          local := fresh_local_name(String.from("__yo_await_value"), context.base.current_function_name.clone());
          em.emit_string_line(`${indent}${get_type_string(rty, context.base)} ${local};`);
          context.base.declared_c_var_names.insert(local.clone());
          _emit_await_result_store(local.clone(), `${acc}->result`, rty, false, indent.clone(), context);
          out = local;
        }, {
          codegen_fatal(`the single-pass async lowering reached await ${eid.to_string()}, which the suspension analysis did not record`);
        });
      });
    }
  );
  if(!is_named, {
    em.emit_string_line(`${indent}__yo_decr_rc(sm->__yo_await_slot);`);
    em.emit_string_line(`${indent}sm->__yo_await_slot = NULL;`);
  });
  out
});

/// The resume function of the single-pass lowering: the aborted-entry guard,
/// then a jump to the dispatch table at the END (so the body can be emitted
/// straight into the real emitter and the table still lists exactly the
/// labels the body produced), the body once, its completion, and the table.
generate_async_block_resume_function_inline :: (
  fn(
    body_expr : AstExpr,
    async_block_id : String,
    struct_name : String,
    resume_function_name : String,
    analysis : AwaitAnalysisResult,
    future_type : TypeValue,
    capture_type : Option(TypeValue),
    context : FunctionGenerationContext
  ) -> ArrayList(String)
)({
  em := context.base.emitter;
  is_unit_result := match(
    extract_future_trait_from_type(future_type),
    .Some(ft) => match(ft, .FutureTraitT({ output : o }) => is_unit_type(o), _ => false),
    .None => false
  );
  em.emit_string_line(`// Resume function for async block ${async_block_id} (single-pass lowering)`);
  em.emit_string_line(`static void ${resume_function_name}__body(void* sm_ptr) {`);
  em.emit_string_line(`  ${struct_name}* sm = (${struct_name}*)sm_ptr;`);
  em.emit_string_line(`  ASYNC_DEBUG("${async_block_id}_resume: state=%d\\n", sm->state);`);
  // Externally aborted while suspended or queued: release the pending await's
  // future and the task's own reference; never resume.
  em.emit_string_line(`  if (sm->state == -2) {`);
  em.emit_string_line(`    if (sm->__yo_await_slot) { __yo_decr_rc(sm->__yo_await_slot); sm->__yo_await_slot = NULL; }`);
  em.emit_string_line(`    __yo_decr_rc((void*)sm);`);
  em.emit_string_line(`    return;`);
  em.emit_string_line(`  }`);
  em.emit_string_line(`  int __yo_inline_budget = 1024;  // bounded inline fast-path for sync-completed awaits`);
  em.emit_string_line(`  goto __yo_dispatch;`);
  em.emit_string_line(`__yo_state_0: ;`);
  low := InlineSmLowering(
    async_block_id : async_block_id.clone(),
    resume_function_name : resume_function_name.clone(),
    next_state : usize(1),
    analysis : analysis,
    suspensions : ArrayList(InlineSuspension).new(),
    emitted : HashSet(usize).new(),
    moved_into_slot : HashSet(String).new(),
    moved_reads : HashMap(usize, String).new(),
    binding_sources : HashMap(String, String).new(),
    rc_operand : false
  );
  p_low := context.sm_inline_lowering;
  p_in := context.in_async_state_machine;
  p_smv := context.state_machine_variables;
  p_vr := context.variable_id_remapping;
  p_pdd := context.pending_deferred_drops;
  context.sm_inline_lowering = Option(InlineSmLowering).Some(low);
  context.in_async_state_machine = Option(InAsyncStateMachine).Some(InAsyncStateMachine(future_type : future_type));
  context.variable_id_remapping = Option(HashMap(String, String)).Some(analysis.variable_id_remapping);
  context.state_machine_variables = Option(HashMap(String, CapturedVariable)).Some(_build_combined_sm_variables(analysis, capture_type));
  pdd := ArrayList(AstExpr).new();
  match(context.base.get_expr_info(body_expr), .Some(ei) => match(ei.deferred_drop_expressions, .Some(d) => _append_exprs(pdd, d), .None => ()), .None => ());
  context.pending_deferred_drops = Option(ArrayList(AstExpr)).Some(pdd);
  body_exprs := if(ast_expr_is_fn_call_of(body_expr, BK_BEGIN, Option(usize).None), match(body_expr, .FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new()), {
    single := ArrayList(AstExpr).new();
    single.push(body_expr);
    single
  });
  // The body, once: its statements, the final value into sm->result, the
  // body-level drops and the completion. Every await inside suspends where it
  // sits (emit_inline_await).
  n_body := body_exprs.len();
  (bi : usize) = usize(0);
  while(bi < n_body, bi = (bi + usize(1)), {
    match(
      body_exprs.get(bi),
      .Some(bexpr) => {
        bcode := _call_generate_expr(bexpr, `  `, context);
        if((bi == (n_body - usize(1))) && !is_unit_result, {
          if(bcode.len() > usize(0), {
            em.emit_string_line(`  sm->result = ${bcode};`);
          });
        }, {
          // A statement's value temp is already declared by its own emission.
          skip := ((bcode.len() == usize(0)) || match(context.base.get_expr_info(bexpr), .Some(bei) => is_temp_variable_name(bei.env.module_path, bcode.clone()), .None => true));
          if(!skip, {
            em.emit_string_line(`  ${bcode};`);
          });
        });
      },
      .None => ()
    );
  });
  local_var_drop_codes := ArrayList(String).new();
  // An unreachable tail (the last statement is itself a `return(...)`) has
  // completed already. Only the TAIL counts: a `return` nested in an arm
  // leaves the fall-through path to complete here
  // (issues/fixed/build-smoke-hangs-registry-perturbation.md).
  tail_returns := match(body_exprs.last(), .Some(le) => ast_expr_is_fn_call_of(le, "return", Option(usize).None), .None => false);
  if(!tail_returns, {
    match(
      match(context.base.get_expr_info(body_expr), .Some(bei) => bei.deferred_drop_expressions, .None => Option(ArrayList(AstExpr)).None),
      .Some(drops) => {
        (di : usize) = usize(0);
        while(di < drops.len(), di = (di + usize(1)), {
          match(
            drops.get(di),
            .Some(d) => {
              dc := _call_generate_expr(d, String.from("  "), context);
              if(dc.len() > usize(0), {
                em.emit_string_line(`  ${dc};`);
                local_var_drop_codes.push(dc);
              });
            },
            .None => ()
          );
        });
      },
      .None => ()
    );
    emit_async_future_completion(em, `  `, Option(String).None, Option(String).Some(String.from("Future %p completed")));
  });
  context.sm_inline_lowering = p_low;
  context.in_async_state_machine = p_in;
  context.state_machine_variables = p_smv;
  context.variable_id_remapping = p_vr;
  context.pending_deferred_drops = p_pdd;
  em.emit_string_line(`  return;`);
  em.emit_string_line(`__yo_dispatch:`);
  em.emit_string_line(`  switch (sm->state) {`);
  em.emit_string_line(`    case 0: goto __yo_state_0;`);
  (i : usize) = usize(0);
  while(i < low.suspensions.len(), i = (i + usize(1)), {
    match(
      low.suspensions.get(i),
      .Some(sp) => em.emit_string_line(`    case ${sp.state.to_string()}: goto __yo_resume_${sp.state.to_string()};`),
      .None => ()
    );
  });
  em.emit_string_line(`    default: return;`);
  em.emit_string_line(`  }`);
  em.emit_string_line(`}`);
  em.emit_string_line(resume_scope_wrapper(resume_function_name.clone()));
  em.emit_string_line(String.from(""));
  g_inline_suspensions.insert(async_block_id.clone(), low.suspensions);
  local_var_drop_codes
});

/// The resume entry point every queue and waiter calls: it runs the body in
/// the allocation scope the task was created in — the owner prefix of a
/// task an explicit allocator placed, the global allocator otherwise — so a
/// task keeps its scope across suspensions, wherever it is resumed from
/// (plans/archive/EXPLICIT_ALLOCATORS.md §3.5). The scope is read before the body
/// runs, because the body may release the task.
resume_scope_wrapper :: (fn(name : String) -> String)(
  `void ${name.clone()}(void* sm_ptr) {
  if (!atomic_load_explicit(&__yo_scopes_ever_entered, memory_order_relaxed)) {
    ${name.clone()}__body(sm_ptr);
    return;
  }
  __yo_alloc_scope_t __yo_prev_scope = __yo_current_allocator;
  __yo_current_allocator = __yo_scope_of_object(sm_ptr);
  ${name.clone()}__body(sm_ptr);
  __yo_current_allocator = __yo_prev_scope;
}`
);
/// The abort hook of a single-pass state machine: cancel what the task is
/// suspended on in `prev_state` (the one `__yo_await_slot`), then wake its
/// waiters — the phase-2 protocol of generate_async_block_cancel_pending_function,
/// with the per-state facts the lowering recorded as it emitted each await.
generate_async_block_cancel_pending_function_inline :: (
  fn(async_block_id : String, struct_name : String, context : FunctionGenerationContext) -> Option(String)
)({
  em := context.base.emitter;
  sps := match(g_inline_suspensions.get(async_block_id.clone()), .Some(l) => l, .None => ArrayList(InlineSuspension).new());
  fn_name := `${async_block_id.clone()}_cancel_pending`;
  em.emit_declaration_string_line(`void ${fn_name.clone()}(void* sm_ptr, int prev_state);  // Abort hook: cancel what the task is suspended on`);
  em.emit_declaration_line("");
  em.emit_string_line(`// Abort hook for async block ${async_block_id.clone()} (single-pass lowering)`);
  em.emit_string_line(`void ${fn_name.clone()}(void* sm_ptr, int prev_state) {`);
  em.emit_string_line(`  ${struct_name.clone()}* sm = (${struct_name.clone()}*)sm_ptr;`);
  em.emit_string_line(`  if (sm->__yo_await_slot != NULL) {`);
  em.emit_string_line(`    switch (prev_state) {`);
  (i : usize) = usize(0);
  while(i < sps.len(), i = (i + usize(1)), {
    match(
      sps.get(i),
      .Some(sp) => if(sp.in_slot, {
        em.emit_string_line(`      case ${sp.state.to_string()}:`);
        if(sp.is_io, {
          em.emit_string_line(`        if (__yo_async_io_cancel(sm->__yo_await_slot)) {`);
          em.emit_string_line(`          __yo_decr_rc(sm->__yo_await_slot);`);
          em.emit_string_line(`          sm->__yo_await_slot = NULL;`);
          em.emit_string_line(`          __yo_future_wake_waiters(sm_ptr);`);
          em.emit_string_line(`          __yo_decr_rc(sm_ptr);  // the suspended task's own reference`);
          em.emit_string_line(`          return;`);
          em.emit_string_line(`        }`);
        }, {
          em.emit_string_line(`        __yo_future_abort(sm->__yo_await_slot);  // structured cancellation`);
        });
        em.emit_string_line(`        break;`);
      }),
      .None => ()
    );
  });
  em.emit_string_line(`      default:`);
  em.emit_string_line(`        break;`);
  em.emit_string_line(`    }`);
  em.emit_string_line(`  }`);
  em.emit_string_line(`  __yo_future_wake_waiters(sm_ptr);`);
  em.emit_string_line(`}`);
  em.emit_string_line(String.from(""));
  Option(String).Some(fn_name)
});

export(
  resume_scope_wrapper,
  is_io_future_type,
  inline_await_result_fields,
  get_state_machine_field_name,
  CrossBoundaryResult,
  compute_cross_boundary_variables,
  OverlappingSlot,
  OverlappingStorageResult,
  compute_overlapping_slots,
  uses_generic_future_interface,
  emit_future_effect_injection_line,
  resolve_effect_field_from_sm_scope,
  find_bundle_field_name,
  emit_effect_record_injection_for_sm,
  emit_effect_injection_for_sm,
  _build_combined_sm_variables,
  _append_exprs,
  emit_inline_await,
  generate_async_block_resume_function_inline,
  generate_async_block_cancel_pending_function_inline
);
