//! FSM emitter dispatch indirection — supports the mutually-recursive
//! state-machine branch emitters in `state_code_gen.yo`.
//!
//! `generate_cond_with_await` / `generate_match_with_await` /
//! `generate_while_with_await` form a cycle with their branch
//! helpers (`generate_cond_branch_with_await` / `generate_while_body_with_await` /
//! `generate_primitive_match_with_await` call back into the three `*_with_await`
//! entries). Yo has no forward references, so — exactly as `_expr.yo` does
//! for the main dispatch — the three `*_with_await` entries are reached through
//! module-global function pointers: the branch helpers call `_call_*` from here
//! (no cycle), and `state_code_gen.yo` registers the real implementations via
//! `register_fsm_emitters` once they are defined.
{ String } :: import("std/string");
{ AstExpr } :: import("../../expr.yo");
{ AwaitPoint } :: import("../../evaluator/async/await_analysis_types.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ panic, assert } :: import("std/assert");
EmitInlineAwaitFn :: (fn(await_expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String);
(g_emit_inline_await : Option(EmitInlineAwaitFn)) = Option(EmitInlineAwaitFn).None;
register_inline_await_emitter :: (fn(f : EmitInlineAwaitFn) -> unit)({
  g_emit_inline_await = Option(EmitInlineAwaitFn).Some(f);
  ()
});
_call_emit_inline_await :: (fn(await_expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)(
  match(
    g_emit_inline_await,
    .Some(f) => f(await_expr, indent, context),
    .None => __yo_panic("emit_inline_await called before register_inline_await_emitter")
  )
);
/// Await-site fusion (plans/backlog/ASYNC_AWAIT_SITE_FUSION.md): the emitter
/// that lowers a fused await, `.None` for an ordinary one. It lives with the
/// async-block emitters (`exprs/async.yo`), which import this module.
EmitFusedAwaitFn :: (fn(await_expr : AstExpr, indent : String, context : FunctionGenerationContext) -> Option(String));
(g_emit_fused_await : Option(EmitFusedAwaitFn)) = Option(EmitFusedAwaitFn).None;
register_fused_await_emitter :: (fn(f : EmitFusedAwaitFn) -> unit)({
  g_emit_fused_await = Option(EmitFusedAwaitFn).Some(f);
  ()
});
_call_emit_fused_await :: (fn(await_expr : AstExpr, indent : String, context : FunctionGenerationContext) -> Option(String))(
  match(
    g_emit_fused_await,
    .Some(f) => f(await_expr, indent, context),
    .None => Option(String).None
  )
);
export(
  EmitInlineAwaitFn,
  register_inline_await_emitter,
  _call_emit_inline_await,
  EmitFusedAwaitFn,
  register_fused_await_emitter,
  _call_emit_fused_await
);
