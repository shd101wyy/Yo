//! FSM emitter dispatch indirection — supports the mutually-recursive
//! state-machine branch emitters in `state_code_gen.yo`.
//!
//! `generate_cond_with_await` / `generate_match_with_await` /
//! `generate_while_with_await` form a cycle with their branch
//! helpers (`generate_cond_branch_with_await` / `generate_while_body_with_await` /
//! `generate_primitive_match_with_await` call back into the three `*_with_await`
//! entries). Yo has no forward references, so — exactly as `_expr.yo` does
//! for the main dispatch — the three `*_with_await` entries are reached through
//! module-global function pointers: the branch helpers call `_call_*` from here
//! (no cycle), and `state_code_gen.yo` registers the real implementations via
//! `register_fsm_emitters` once they are defined.
{ String } :: import("std/string");
{ AstExpr } :: import("../../expr.yo");
{ AwaitPoint } :: import("../../evaluator/async/await_analysis_types.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ panic, assert } :: import("std/assert");
/// Signature of `generate_cond_with_await(cond_expr, await_point, indent,
/// context, target_variable_id?, target_assignment_code?)`.
GenerateCondWithAwaitFn :: (
  fn(
    cond_expr : AstExpr,
    await_point : AwaitPoint,
    indent : String,
    context : FunctionGenerationContext,
    target_variable_id : Option(String),
    target_assignment_code : Option(String)
  ) -> unit
);
/// Signature of `generate_match_with_await(match_expr, await_point, indent,
/// context, target_variable_id?, target_assignment_code?)`.
GenerateMatchWithAwaitFn :: (
  fn(
    match_expr : AstExpr,
    await_point : AwaitPoint,
    indent : String,
    context : FunctionGenerationContext,
    target_variable_id : Option(String),
    target_assignment_code : Option(String)
  ) -> unit
);
/// Signature of `generate_while_with_await(while_expr, await_point, indent, context)`.
GenerateWhileWithAwaitFn :: (
  fn(while_expr : AstExpr, await_point : AwaitPoint, indent : String, context : FunctionGenerationContext) -> unit
);
(g_generate_cond_with_await : Option(GenerateCondWithAwaitFn)) = Option(GenerateCondWithAwaitFn).None;
(g_generate_match_with_await : Option(GenerateMatchWithAwaitFn)) = Option(GenerateMatchWithAwaitFn).None;
(g_generate_while_with_await : Option(GenerateWhileWithAwaitFn)) = Option(GenerateWhileWithAwaitFn).None;
/// Register the three `*_with_await` emitter entries. Call once after they are
/// defined (from `state_code_gen.yo`).
register_fsm_emitters :: (
  fn(c : GenerateCondWithAwaitFn, m : GenerateMatchWithAwaitFn, w : GenerateWhileWithAwaitFn) -> unit
)({
  g_generate_cond_with_await = Option(GenerateCondWithAwaitFn).Some(c);
  g_generate_match_with_await = Option(GenerateMatchWithAwaitFn).Some(m);
  g_generate_while_with_await = Option(GenerateWhileWithAwaitFn).Some(w);
  ()
});
/// Dispatch `cond(...)`-with-await emission through the registered entry.
_call_generate_cond_with_await :: (
  fn(
    cond_expr : AstExpr,
    await_point : AwaitPoint,
    indent : String,
    context : FunctionGenerationContext,
    target_variable_id : Option(String),
    target_assignment_code : Option(String)
  ) -> unit
)(
  match(
    g_generate_cond_with_await,
    .Some(f) => f(cond_expr, await_point, indent, context, target_variable_id, target_assignment_code),
    .None => __yo_panic("generate_cond_with_await called before register_fsm_emitters")
  )
);
/// Dispatch `match(...)`-with-await emission through the registered entry.
_call_generate_match_with_await :: (
  fn(
    match_expr : AstExpr,
    await_point : AwaitPoint,
    indent : String,
    context : FunctionGenerationContext,
    target_variable_id : Option(String),
    target_assignment_code : Option(String)
  ) -> unit
)(
  match(
    g_generate_match_with_await,
    .Some(f) => f(match_expr, await_point, indent, context, target_variable_id, target_assignment_code),
    .None => __yo_panic("generate_match_with_await called before register_fsm_emitters")
  )
);
/// Dispatch `while(...)`-with-await emission through the registered entry.
_call_generate_while_with_await :: (
  fn(while_expr : AstExpr, await_point : AwaitPoint, indent : String, context : FunctionGenerationContext) -> unit
)(
  match(
    g_generate_while_with_await,
    .Some(f) => f(while_expr, await_point, indent, context),
    .None => __yo_panic("generate_while_with_await called before register_fsm_emitters")
  )
);
export(
  GenerateCondWithAwaitFn,
  GenerateMatchWithAwaitFn,
  GenerateWhileWithAwaitFn,
  register_fsm_emitters,
  _call_generate_cond_with_await,
  _call_generate_match_with_await,
  _call_generate_while_with_await
);
