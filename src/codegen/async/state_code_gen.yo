//! state_code_gen — async/effect state-segment codegen.
//!
//! The segment model + pure AST predicates, and the C-emitting transformation
//! (`generate_state_segment_code`, `generate_await_expression`,
//! `generate_cond/match/while_with_await`).
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ codegen_fatal, codegen_user_error } :: import("../constants.yo");
{ AstExpr, ast_expr_id, ast_expr_is_fn_call, ast_expr_is_fn_call_of, ast_expr_is_atom_of, ast_expr_is_atom, ast_expr_token, ast_expr_to_string, BF_DOT, BK_WHILE, BK_BEGIN, BK_COND, BK_MATCH, BK_TUPLE, BK_ASSIGN, BK_INIT_ASSIGN } :: import("../../expr.yo");
{ lookup_match_arms, Pattern, Arm } :: import("../../pattern.yo");
{ TokenKind } :: import("../../token.yo");
{ AwaitPoint, CapturedVariable } :: import("../../evaluator/async/await_analysis_types.yo");
{ SuspensionPoint } :: import("../../evaluator/shared/suspension_analysis_types.yo");
{ is_io_async_call, is_io_await_call, extract_future_trait_from_type, get_future_variable_id_ } :: import("../../evaluator/async/await_analysis.yo");
{ extract_target_variable_id } :: import("../../evaluator/shared/suspension_analysis.yo");
{ expr_contains_await, expr_contains_while_with_await } :: import("../../expr_traversal.yo");
{ expr_info_primitive_pattern_values, expr_info_is_primitive_match, lookup_macro_expansion, some_resolution } :: import("../../expr_info.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("../exprs/_expr.yo");
{ arm_value_with_dups } :: import("../exprs/drop_dup.yo");

{ get_variables_from_env } :: import("../../env.yo");
{ is_temp_variable_name } :: import("../../utils.yo");
{ emit_async_future_completion } :: import("../exprs/async_completion.yo");
{ is_unit_type, is_enum_type, is_some_type, is_concrete_trait_type, is_pointer_type } :: import("../../types/guards.yo");
{ resolve_enum_shell } :: import("../../types/creators.yo");
{ EvalValue, type_of_eval_value } :: import("../../value.yo");
{ get_type_string, sanitize_for_c_identifier, can_optimize_as_nullable_pointer, can_optimize_as_simple_enum, get_enum_variant_c_name, type_key, pattern_param_is_literal, pattern_literal_arm_guards, nullable_arm_selects_payload, nullable_arm_payload_binder, get_runtime_struct_fields, fresh_local_name } :: import("../utils/index.yo");
{ get_state_machine_field_name, sm_local_field_name } :: import("./state_machine_naming.yo");
{ generate_comptime_value } :: import("../exprs/comptime_value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
/// True when `ty` is an io.async/io.await Future SomeType (vs an extern
/// `__yo_io_future_t`).
///
/// TWO signals:
///   (1) the resolved concrete type is itself an EXTERN SomeType — an extern C
///       type like `__yo_io_future_t` (so NOT a state-machine Future).
///   (2) any required trait is a `Concrete(...)` trait.
is_io_future_type :: (fn(ty : TypeValue) -> bool)({
  if(!is_some_type(ty), {
    return(false);
  });
  // Branch (1): the resolved concrete is an extern opaque type
  // (`ExternOpaqueT`, `Impl(Concrete(__yo_io_future_t), ...)`). This branch is LOAD-BEARING since Impl's `Concrete(T)` support:
  // the marker moves into the SomeT's resolution rather
  // than sitting in required_trait_types, so branch (2) alone no longer fires
  // for `IoFuture` — and misclassifying an io future as a lazy sync future
  // emits a `->vt->resume` cold-start on `__yo_io_future_t`, whose `vt` is
  // NULL (the fs/gc batch C errors, when it had no such member).
  some_id := match(ty, .SomeT({ id }) => id, _ => String.from(""));
  rc_final := some_resolution(ty);
  match(
    rc_final,
    .Some(io_rcv) => match(
      io_rcv,
      .ExternOpaqueT(_, _) => {
        return(true);
      },
      _ => ()
    ),
    .None => ()
  );
  // Branch (2): any required trait is a `Concrete(...)` trait.
  rts := match(ty, .SomeT({ required_trait_types }) => required_trait_types, _ => ArrayList(TypeValue).new());
  (i : usize) = usize(0);
  while(i < rts.len(), {
    rt := match(rts.get(i), .Some(t) => t, .None => TypeValue.Unit);
    if(is_concrete_trait_type(rt), {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
/// Collect every `io.await` call expr inside a cond/match branch VALUE, in
/// source order. Does not descend into nested `io.async` bodies (their awaits
/// belong to that block's own state machine) or into a found await's own
/// arguments (nested awaits are rejected upstream). Companion walker to
/// `_find_branch_await_target_variable_id`.
collect_branch_await_exprs :: (
  fn(expr : AstExpr, out : ArrayList(AstExpr)) -> unit
)({
  if(!ast_expr_is_fn_call(expr), {
    return(());
  });
  if(is_io_async_call(expr.clone()), {
    return(());
  });
  if(is_io_await_call(expr.clone()), {
    out.push(expr);
    return(());
  });
  // A macro call (`if`, ...) keeps its macro head in the AST; the exprs the
  // evaluator ANNOTATED live in the expansion. Walking the raw args here
  // collects await exprs with no ExprInfo, which the access builder cannot
  // type. Every tree walk in this family follows the expansion.
  match(
    lookup_macro_expansion(ast_expr_id(expr)),
    .Some(me) => {
      recur(me, out);
      return(());
    },
    .None => ()
  );
  match(
    expr,
    .Atom(_, _) => (),
    .FnCall(_, f, args, _, _) => {
      recur(f, out);
      (i : usize) = usize(0);
      while(i < args.len(), {
        match(
          args.get(i),
          .Some(a) => recur(a, out),
          .None => ()
        );
        i = (i + usize(1));
      });
    }
  );
});
_await_future_expr_is_borrowed_place :: (fn(e : AstExpr) -> bool)({
  if(!ast_expr_is_fn_call_of(e, BF_DOT, Option(usize).Some(usize(2))), {
    return(false);
  });
  e_args := match(e, .FnCall(_, _, __afp_a, _, _) => __afp_a, .Atom(_, _) => ArrayList(AstExpr).new());
  field := match(e_args.get(usize(1)), .Some(x) => x, .None => return(false));
  if(!ast_expr_is_atom(field), {
    return(false);
  });
  (root : AstExpr) = match(e_args.get(usize(0)), .Some(x) => x, .None => return(false));
  while(ast_expr_is_fn_call_of(root, BF_DOT, Option(usize).Some(usize(2))), {
    r_args := match(root, .FnCall(_, _, __afp_ra, _, _) => __afp_ra, .Atom(_, _) => ArrayList(AstExpr).new());
    r_field := match(r_args.get(usize(1)), .Some(x) => x, .None => return(false));
    if(!ast_expr_is_atom(r_field), {
      return(false);
    });
    root = match(r_args.get(usize(0)), .Some(x) => x, .None => return(false));
  });
  ast_expr_is_atom(root)
});
emit_future_store_into_slot :: (
  fn(future_expr : AstExpr, future_code : String, slot : String, indent : String, context : FunctionGenerationContext) -> unit
)({
  em := context.base.emitter;
  em.emit_string_line(`${indent}sm->${slot} = (void*)(${future_code});`);
  if(_await_future_expr_is_borrowed_place(future_expr), {
    em.emit_string_line(`${indent}// Borrowed future (read out of a field): the slot releases what it`);
    em.emit_string_line(`${indent}// holds, so it needs a reference of its own — otherwise this await`);
    em.emit_string_line(`${indent}// frees the field's future out from under its owner.`);
    em.emit_string_line(`${indent}if (sm->${slot} != NULL) { __yo_incr_rc((void*)sm->${slot}); }`);
  });
});
export(
  emit_future_store_into_slot,
  is_io_future_type,
  collect_branch_await_exprs
);
