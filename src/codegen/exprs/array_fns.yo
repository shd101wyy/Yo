//! Anonymous-array + `__yo_array_fill` emitters.
//!
//! Per-element deferred-dup emission for moved RC elements (rc
//! layer 4 — without it every enclosing array literal aliased its element's
//! refcount and scope-end drops over-released). Temp names use `random_id`
//! (only uniqueness is needed).
{ String } :: import("std/string");
{ AstExpr } :: import("../../expr.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_array_type, is_unit_type } :: import("../../types/guards.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ get_type_string, get_variable_type_string, fresh_local_name } :: import("../utils/index.yo");
{ emit_deferred_dup_or_code } :: import("./drop_dup.yo");
{ sequence_operand } :: import("./other_fn_call.yo");
/// `array(1, 2, 3)` → `(<arrayType>){ .data = { 1, 2, 3 } }`, into a named temp
/// when the array has a result variable name. Returns `.None` when the node is
/// not a typed array call (fall-through).
generate_anonymous_array :: (fn(expr : &AstExpr, indent : &String, context : &FunctionGenerationContext) -> Option(String))({
  ei := match(context.base.get_expr_info(expr), .Some(e) => e, .None => return(Option(String).None));
  array_type := Rc.clone(ei.ty);
  match(
    &ei.runtime_arg_exprs_in_order,
    .Some(arg_exprs) => if(!is_array_type(&array_type), return(Option(String).None), {
      args_list := String.from("");
      n := arg_exprs.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          arg_exprs.get(i),
          .Some(arg) => {
            if(i > usize(0), {
              args_list.push_str(", ");
            });
            // The element's deferred `___dup` (an element store): the literal
            // owns its own +1 per RC element, through the store rule every
            // other store position uses (`emit_deferred_dup_or_code`, the
            // tuple literal's twin in tuple_fn.yo): a projection's temp is
            // declared before the dup names it, and an element-wise dup keeps
            // the source, which it retained in place.
            elem_code := emit_deferred_dup_or_code(&arg, _call_generate_expr(&arg, indent.clone(), context), indent.clone(), context);
            // Sequenced against the later elements (`sequence_operand`,
            // other_fn_call.yo): C leaves initializers unordered, and a later
            // element's statements run before this literal.
            args_list.push_string(sequence_operand(&arg, elem_code, &arg_exprs, i, false, indent, context));
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      array_type_name := get_type_string(&array_type, &context.base);
      array_value := String.from("(");
      array_value.push_string(&array_type_name);
      // `Array(unit, N)` has no `data` member (the element is zero-sized), so
      // the literal is the empty struct; the element expressions above still
      // ran for their side effects.
      if(match(&array_type, Rc(.Array({ element : ae })) => is_unit_type(&ae), _ => false), {
        array_value.push_str("){ }");
      }, {
        array_value.push_str("){ .data = { ");
        array_value.push_string(&args_list);
        array_value.push_str(" } }");
      });
      match(
        &ei.variable_name,
        .Some(temp_var) => {
          decl := indent.clone();
          decl.push_string(get_variable_type_string(&array_type, temp_var.clone(), &context.base));
          decl.push_str(" = ");
          decl.push_string(&array_value);
          decl.push_str(";");
          em := context.base.emitter;
          em.emit_string_line(&decl);
          Option(String).Some(temp_var.clone())
        },
        .None => Option(String).Some(array_value)
      )
    }),
    .None => Option(String).None
  )
});
/// `__yo_array_fill(ArrayType, value)` builtin — declares an array and fills it
/// with `value` via a C `for` loop.
generate_yo_array_fill :: (fn(expr : &AstExpr, indent : &String, context : &FunctionGenerationContext) -> String)({
  ei := match(context.base.get_expr_info(expr), .Some(e) => e, .None => return(String.from("/* ERROR: __yo_array_fill has no evaluation info */")));
  array_type_arg := match(expr, .FnCall(_, _, Rc(a), _, _) => match(a.get(usize(0)), .Some(x) => x, .None => return(String.from("/* ERROR: __yo_array_fill requires 2 arguments */"))), .Atom(_, _) => return(String.from("/* ERROR: __yo_array_fill requires 2 arguments */")));
  fill_value_arg := match(expr, .FnCall(_, _, Rc(a), _, _) => match(a.get(usize(1)), .Some(x) => x, .None => return(String.from("/* ERROR: __yo_array_fill requires 2 arguments */"))), .Atom(_, _) => return(String.from("/* ERROR: __yo_array_fill requires 2 arguments */")));
  // The ArrayType comes from the first argument's compile-time value.
  array_type := match(
    context.base.get_expr_info(&array_type_arg),
    .Some(aei) => match(aei.value, .Some(v) => match(v, .TypeVal(t) => Rc.clone(t), _ => return(String.from("/* ERROR: __yo_array_fill first argument must be an ArrayType */"))), .None => return(String.from("/* ERROR: __yo_array_fill first argument must be an ArrayType */"))),
    .None => return(String.from("/* ERROR: __yo_array_fill first argument must be an ArrayType */"))
  );
  if(!is_array_type(&array_type), {
    return(String.from("/* ERROR: __yo_array_fill first argument must be an ArrayType */"));
  });
  length := match(&array_type, Rc(.Array(_, len, len_var)) => if(len_var.len() > usize(0), return(String.from("/* ERROR: __yo_array_fill requires compile-time known array length */")), len), _ => return(String.from("/* ERROR: __yo_array_fill first argument must be an ArrayType */")));
  array_type_name := get_type_string(&array_type, &context.base);
  fill_value_code := _call_generate_expr(&fill_value_arg, indent.clone(), context);
  temp_var_name := match(
    &ei.variable_name,
    .Some(v) => v.clone(),
    .None => fresh_local_name(
      String.from("temp_array_"),
      &context.base.current_function_name
    )
  );
  index_var_name := fresh_local_name(String.from("i_"), &context.base.current_function_name);
  em := context.base.emitter;
  // Array declaration.
  decl := indent.clone();
  decl.push_string(&array_type_name);
  decl.push_str(" ");
  decl.push_string(temp_var_name.clone());
  decl.push_str(";");
  em.emit_string_line(&decl);
  // `Array(unit, N)`: no `data` member to fill (the element is zero-sized); the
  // declaration above is the whole value. `fill_value_code` was generated
  // above, so a side-effecting fill expression already ran.
  if(match(array_type, Rc(.Array(fe, _, _)) => is_unit_type(&fe), _ => false), {
    return(temp_var_name);
  });
  // Fill loop header.
  hdr := indent.clone();
  hdr.push_str("for (int ");
  hdr.push_string(index_var_name.clone());
  hdr.push_str(" = 0; ");
  hdr.push_string(index_var_name.clone());
  hdr.push_str(" < ");
  hdr.push_string(length.to_string());
  hdr.push_str("; ");
  hdr.push_string(index_var_name.clone());
  hdr.push_str("++) {");
  em.emit_string_line(&hdr);
  // Fill assignment.
  body := indent.clone();
  body.push_str("  ");
  body.push_string(temp_var_name.clone());
  body.push_str(".data[");
  body.push_string(index_var_name.clone());
  body.push_str("] = ");
  body.push_string(&fill_value_code);
  body.push_str(";");
  em.emit_string_line(&body);
  // Loop close.
  close := indent.clone();
  close.push_str("}");
  em.emit_string_line(&close);
  temp_var_name
});
export(generate_anonymous_array, generate_yo_array_fill);
