//! Drop code generation.
//!
//! `get_drop_function_for_type` resolves a type's `___drop` C function through
//! the type-trait-method REGISTRY (`evaluator/values/type-trait-methods.yo`).
//!
//! `generate_drop_code_for_value` recurses through arrays/tuples and emits RC
//! decr (or the type's drop fn) for object/dyn/struct/enum values.
//! `generate_deferred_drop_expressions` emits the evaluator-deferred drops
//! (closure-capture + short-circuit-handled skips).
//! `counted_handle_retain_code` is the one retain the compiler emits on its
//! own: a borrow pin's count on a counted handle (decision 25).
//!
//! KNOWN LIMITATION: `SomeType.resolvedConcreteType` (Gap 6) — SomeT carries no
//! resolved concrete type, so `concrete_type := value_type`.
//! For the monomorphized corpus the value type is already concrete, so this is
//! a no-op; unresolved-SomeT params (Phase-3 generics) need Gap-6 resolution.
{ String } :: import("std/string");
{ AstExpr, ast_expr_is_atom, ast_expr_is_fn_call_of, ast_expr_token, ast_expr_text, ast_expr_id, ast_expr_to_string, BF_DROP, BF_DOT } :: import("../../expr.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue, no_types, no_labels, slot_pointee_at } :: import("../../types/definitions.yo");
{ is_array_type, is_tuple_type, is_dyn_type, is_atomic_reference_struct_type, is_reference_struct_type, is_atomic_reference_enum_type, is_reference_enum_type, is_struct_type, is_enum_type, is_some_type, is_newtype_type, is_unique_box_type, is_dyn_cell_type, is_counted_handle_type, is_atomic_counted_handle_type } :: import("../../types/guards.yo");
{ type_contains_rc_cell_or_move_only, is_bound_closure_identity, resolve_cell_chain, is_closure_capture_struct, is_value_nominal_type, fn_abi_param_is_ptr } :: import("../../types/utils.yo");
{ type_implements_future } :: import("../../evaluator/trait-checking.yo");
{ debug_knob } :: import("../../utils.yo");
{ eprintln } :: import("std/fmt");
{ expr_info_early_return_only_deferred_drop_expressions, scope_variables, is_fnonce_capture_drop, is_fnonce_post_call_release } :: import("../../expr-info.yo");
{ is_temp_variable_name } :: import("../../utils.yo");
{ MethodEntry, get_type_trait_methods_by_name, type_id_or_empty } :: import("../../evaluator/values/type-trait-methods.yo");
{ take_short_circuit_handled, FunctionGenerationContext, sm_owns_fnonce_captures } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./dispatch.yo");
{ Emitter } :: import("../../emitter.yo");
{ get_type_string, get_variable_type_string, get_variable_name_for_codegen, get_deferred_drop_target_atom_name, get_deferred_drop_target_atom, is_deferred_drop_for_closure_capture, get_enum_variant_c_name, sanitize_for_c_identifier, c_variant_member_name, can_optimize_as_nullable_pointer, get_runtime_struct_fields, type_key, scope_stack_contains } :: import("../utils/index.yo");
{ resolve_enum_shell, resolve_struct_shell } :: import("../../types/creators.yo");
{ get_variables_from_env } :: import("../../env.yo");
{ sm_slot_of } :: import("../async/state-machine-naming.yo");
{ replace } :: import("std/mem");
{ codegen_fatal_expr } :: import("../constants.yo");
/// The registered C name of the first `method_name` entry for `type`, if it is
/// a function value registered in the codegen function table.
_method_c_name :: (fn(type : &TypeValue, method_name : str, context : &FunctionGenerationContext) -> Option(String))({
  if(!(is_struct_type(type) || is_enum_type(type) || is_dyn_type(type) || is_some_type(type)), {
    return(Option(String).None);
  });
  methods := get_type_trait_methods_by_name(type_id_or_empty(type), String.from(method_name));
  match(methods.get_cloned(usize(0)), .Some(entry) => match(entry.value.clone(), .Some(v) => match(v, Rc(.FuncVal(__fvd1, _)) => match(context.base.get_function_entry(&__fvd1.*.func_id), .Some(e) => Option(String).Some(e.c_name.clone()), .None => Option(String).None), _ => Option(String).None), .None => Option(String).None), .None => Option(String).None)
});
/// The C name of `type`'s `___drop` function, if any.
get_drop_function_for_type :: (fn(type : &TypeValue, context : &FunctionGenerationContext) -> Option(String))(
  _method_c_name(type, BF_DROP, context)
);
/// The C name of `type`'s `___dispose` function, if any. Used by the
/// object-constructor emitter to stamp the dispose function onto the RC header.
/// Keyed by `type_key(type)` (instantiation-precise), NOT the raw struct id: a
/// generic struct shares one eval struct id across instantiations, so a struct-id
/// lookup would return ONE ___dispose (built for whichever V was synthesized first)
/// for EVERY instantiation — e.g. HashMap(usize, bool) resolving the
/// HashMap(usize, EvalValue) dispose and dropping its `bool` slot as a reference-
/// counted value (`__yo_decr_rc(0x1)` crash). `_synthesize_and_register_dispose`
/// registers under type_key to match.
get_dispose_function_for_type :: (fn(type : &TypeValue, context : &FunctionGenerationContext) -> Option(String))({
  if(!(is_struct_type(type) || is_enum_type(type) || is_dyn_type(type) || is_some_type(type)), {
    return(Option(String).None);
  });
  methods := get_type_trait_methods_by_name(type_key(type), String.from("___dispose"));
  match(
    methods.get_cloned(usize(0)),
    .Some(entry) => match(
      entry.value.clone(),
      .Some(v) => match(
        v,
        Rc(.FuncVal(__dfvd3, _)) => match(
          context.base.get_function_entry(&__dfvd3.*.func_id),
          .Some(e) => Option(String).Some(e.c_name.clone()),
          .None => Option(String).None
        ),
        _ => Option(String).None
      ),
      .None => Option(String).None
    ),
    .None => Option(String).None
  )
});
/// Does `type`'s `___dispose` take its receiver through a pointer
/// (`self : &mut Self`, the C ABI `fn_abi_param_is_ptr` reports)? True for the
/// one synthesized over a `Drop` impl, whose `drop` takes `self : &mut Self`
/// (plans/VALUES_BY_DEFAULT.md decision 45); false for one with no user
/// destructor (`self : &Self`, by value in C). Every C-level caller passes the address of
/// the dropped value's storage when it is true, so what the destructor writes
/// (a field taken out, set to `.None`) is what the field drops then read.
dispose_function_takes_pointer :: (fn(type : &TypeValue) -> bool)(
  match(
    get_type_trait_methods_by_name(type_key(type), String.from("___dispose")).get_cloned(usize(0)),
    .Some(entry) => match(fn_abi_param_is_ptr(&entry.ty).get(usize(0)), .Some(b) => b, .None => false),
    .None => false
  )
);
/// The C statement that runs a value's `___dispose` (`dispose_c_name`) on the
/// value stored at `value_code`: the address of that storage for a pointer
/// receiver (`dispose_function_takes_pointer`), the value itself otherwise.
dispose_call_on_value :: (fn(dispose_c_name : &String, value_code : &String, type : &TypeValue) -> String)(
  cond(
    dispose_function_takes_pointer(type) => `${dispose_c_name}(&(${value_code}));`,
    true => `${dispose_c_name}(${value_code});`
  )
);
/// If `value_arg` is a generic-typed (SomeType) parameter atom, recover its
/// concrete parameter type from the enclosing function signature (the
/// SomeType.resolvedConcreteType branches are
/// Gap-6-deferred — no such field exists).
resolve_some_type_param_type :: (fn(value_arg : &AstExpr, value_type : &TypeValue, context : &FunctionGenerationContext) -> TypeValue)({
  if(!is_some_type(value_type), {
    return(Rc.clone(value_type));
  });
  if(!ast_expr_is_atom(value_arg), {
    return(Rc.clone(value_type));
  });
  ft := match(&context.current_function_type, .Some(t) => Rc.clone(t), .None => return(Rc.clone(value_type)));
  var_name := ast_expr_text(value_arg).*.clone();
  match(
    ft,
    Rc(.Func({ param_types : pts, meta : __fm1 })) => {
      pls := Rc.clone(__fm1.*.param_labels);
      n := pls.len();
      (mut(i) : usize) = usize(0);
      while(i < n, {
        match(
          pls.get_cloned(i),
          .Some(lbl) => if(lbl == var_name, {
            match(
              slot_pointee_at(&pts, i),
              .Some(pt) => if(!is_some_type(&pt), {
                return(pt);
              }),
              .None => ()
            );
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  );
  Rc.clone(value_type)
});
/// A closure value's static type is its `Impl(Fn(...))` SomeT, but the C value
/// IS the capture struct (`get_type_string` renders it, the call site casts
/// through it). Drop sees the struct, so a closure releases its captures
/// field by field like any value struct
/// (issues/fixed/a-closure-typed-slot-never-releases-its-captures.md).
///
/// A type variable bound to a closure (`generic(F : Type)` under
/// `where(F <: Fn(...))`) is the same value: its resolution chain ends at the
/// closure's capture struct, which is also what `get_type_string` renders. An
/// `io.async` body capturing such a parameter owns a +1 on each of its RC
/// captures, and its dispose drops the field through this walk, which saw an
/// unresolved SomeT and emitted nothing (Stream.for_each leaked the closure's
/// captured list).
_closure_value_type :: (fn(t : &TypeValue) -> TypeValue)({
  if(is_bound_closure_identity(t), return(resolve_cell_chain(t)));
  cvt_r := resolve_cell_chain(t);
  if(is_closure_capture_struct(&cvt_r), cvt_r, Rc.clone(t))
});
/// The C name of the per-type drop function of a TAGGED value enum,
/// generating it on first use.
///
/// The function switches on the discriminant and releases each
/// reference-counted field of the active variant — the walk every drop site
/// used to emit inline. A large enum (the compiler's
/// own `TypeValue` as a value enum: 40 variants, ~60 counted fields) made each
/// site ~120 lines across ~51 000 sites, 726 MB of C instead of 147 MB
/// (issues/fixed/value-enum-drops-are-emitted-inline-at-every-drop-site.md).
///
/// It takes the value BY ADDRESS through `void*`, so its prototype names no
/// type and can sit in the headers section, ahead of every caller — including
/// the async dispose and spawn-wrapper bodies written into the declarations
/// section mid-codegen. The definition needs the complete enum type, so it is
/// appended to the END of the declarations section (`compile_module`). Both go
/// to side buffers on the base context, never through `context.base.emitter`:
/// callers swap that emitter for a scratch one and splice its text into a
/// function body. The body is generated under a scratch emitter too, so the
/// nested field walks (array loops, tuple temps) land in the function.
_value_enum_rc_fn :: (fn(concrete_type : &TypeValue, context : &mut FunctionGenerationContext) -> String)({
  c_type := get_type_string(concrete_type, &mut context.base);
  mut(fn_name) := String.from("__yo_venum_drop_");
  fn_name.push_string(sanitize_for_c_identifier(&c_type, false));
  if(context.base.value_enum_rc_fns.contains(fn_name.clone()), {
    return(fn_name);
  });
  // Registered before the body is generated: a field walk that reaches this
  // type again only needs the name.
  context.base.value_enum_rc_fns.insert(fn_name.clone());
  saved := replace(&mut context.base.emitter, Emitter.new());
  value_code := String.from("(*__yo_v)");
  match(
    concrete_type,
    Rc(.EnumT({ variant_names, variant_fields, variant_field_labels })) => {
      context.base.emitter.emit_string_line(`switch (${value_code.clone()}.tag) {`);
      nv := variant_names.len();
      (mut(vi) : usize) = usize(0);
      while(vi < nv, {
        vname := match(variant_names.get_cloned(vi), .Some(v) => v, .None => String.from(""));
        fields := match(variant_fields.get(vi), .Some(f) => f, .None => no_types());
        labels := match(variant_field_labels.get(vi), .Some(l) => l, .None => no_labels());
        nf := fields.len();
        (mut(has_rc) : bool) = false;
        (mut(ci) : usize) = usize(0);
        while(ci < nf, {
          match(
            fields.get(ci),
            .Some(ft) => if(type_contains_rc_cell_or_move_only(&ft), {
              has_rc = true;
            }),
            .None => ()
          );
          ci = (ci + usize(1));
        });
        if(has_rc, {
          tag_c := get_enum_variant_c_name(concrete_type, vname.clone(), &context.base);
          context.base.emitter.emit_string_line(`  case ${tag_c}: {`);
          (mut(fi) : usize) = usize(0);
          while(fi < nf, {
            match(
              fields.get(fi),
              .Some(ft) => if(type_contains_rc_cell_or_move_only(&ft), {
                flabel := match(labels.get_cloned(fi), .Some(l) => l, .None => String.from(""));
                fname := sanitize_for_c_identifier(&flabel, false);
                access := `${value_code.clone()}.data.${c_variant_member_name(vname.clone())}.${fname}`;
                fd := generate_drop_code_for_value(&access, &ft, context);
                if(fd.len() > usize(0), {
                  context.base.emitter.emit_string_line(`    ${fd};`);
                });
              }),
              .None => ()
            );
            fi = (fi + usize(1));
          });
          context.base.emitter.emit_string_line(String.from("    break;"));
          context.base.emitter.emit_string_line(String.from("  }"));
        });
        vi = (vi + usize(1));
      });
      context.base.emitter.emit_string_line(String.from("  default: break;"));
      context.base.emitter.emit_string_line(String.from("}"));
    },
    _ => ()
  );
  scratch := replace(&mut context.base.emitter, saved);
  // Anything the walk declared or included goes where it went before the
  // walk was outlined: the emitter that was current.
  if(scratch.headers.len() > usize(0), {
    context.base.emitter.emit_header_string(&scratch.headers);
  });
  if(scratch.declarations.len() > usize(0), {
    context.base.emitter.emit_declaration_string(&scratch.declarations);
  });
  context.base.value_enum_rc_protos.push_string(`static inline void ${fn_name.clone()}(void* __yo_p);\n`);
  mut(def) := `static inline void ${fn_name.clone()}(void* __yo_p) {\n  ${c_type}* __yo_v = (${c_type}*)__yo_p;\n`;
  // Indent the body one level: emitted C closes a file-scope body with `}`
  // at column 0 and indents everything inside it (chunk assembly relies on it).
  body_lines := scratch.code.split("\n");
  (mut(bi) : usize) = usize(0);
  while(bi < body_lines.len(), {
    match(
      body_lines.get_cloned(bi),
      .Some(bl) => if(bl.len() > usize(0), {
        def.push_str("  ");
        def.push_string(&bl);
        def.push_str("\n");
      }),
      .None => ()
    );
    bi = (bi + usize(1));
  });
  def.push_str("}\n");
  context.base.value_enum_rc_defs.push_string(&def);
  fn_name
});
/// Generate drop code for a value of any type (recursive for arrays/tuples).
/// Note: emits at column 0 (no indent).
generate_drop_code_for_value :: (fn(value_code : &String, value_type : &TypeValue, context : &mut FunctionGenerationContext) -> String)({
  // Resolve recursive-type SHELLS to their registered finals first (same
  // convention as type_key / get_size_of_type): a shell enum has EMPTY
  // variant lists, so the per-variant RC walk below emits a switch with NO
  // arms — a silent no-op drop for any recursive enum value (the json
  // element-loss family).
  concrete_type := resolve_enum_shell(resolve_struct_shell(_closure_value_type(value_type)));
  if(!type_contains_rc_cell_or_move_only(&concrete_type), {
    return(String.from(""));
  });
  // A move-only value type with a user `Drop` (plans/VALUES_BY_DEFAULT.md
  // §3.4) runs it first, then its fields are dropped below. Its one owner
  // drops it once, so this is the only call. The `___dispose` is registered
  // by `collect_dispose_methods` (`_synthesize_and_register_value_dispose`).
  if(is_value_nominal_type(&concrete_type), {
    match(
      get_dispose_function_for_type(&concrete_type, context),
      .Some(vd_fn) => {
        context.base.emitter.emit_string_line(dispose_call_on_value(&vd_fn, value_code, &concrete_type));
      },
      .None => ()
    );
  });
  cond(
    // Impl(Future(…)) SomeT — a heap-backed, ref-counted state machine handle:
    // decrement its refcount (NULL-checked; the SM frees itself at 0).
    // evaluate_drop keeps the
    // generic `___drop(x)` (no synthesized SomeType methods), so the Future arm
    // must live here — without it a sync-await's future temp fell through to the
    // `true => ""` no-op and its deferred drop was silently skipped everywhere
    // (the 96-byte sync_fut_t leak per io.await outside a state machine).
    (is_some_type(&concrete_type) && type_implements_future(&concrete_type)) => {
      mut(out) := String.from("if (");
      out.push_string(value_code.clone());
      out.push_str(" != NULL) { __yo_decr_rc((void*)");
      out.push_string(value_code.clone());
      out.push_str("); }");
      out
    },
    is_array_type(&concrete_type) => match(
      concrete_type,
      Rc(.Array(element, length, length_var)) => {
        if(length_var.len() > usize(0), {
          return(String.from("/* Error: array has non-constant length */"));
        });
        mut(hdr) := String.from("for (size_t i = 0; i < ");
        hdr.push_string(length.to_string());
        hdr.push_str("; i++) {");
        context.base.emitter.emit_string_line(&hdr);
        mut(ec) := String.from("(");
        ec.push_string(value_code.clone());
        ec.push_str(").data[i]");
        elem_drop := recur(&ec, &element, context);
        if(elem_drop.len() > usize(0), {
          mut(line) := String.from("  ");
          line.push_string(&elem_drop);
          line.push_str(";");
          context.base.emitter.emit_string_line(&line);
        });
        context.base.emitter.emit_string_line(String.from("}"));
        String.from("")
      },
      _ => String.from("")
    ),
    is_tuple_type(&concrete_type) => match(
      concrete_type,
      Rc(.Tuple({ field_types : fts })) => {
        n := fts.len();
        (mut(i) : usize) = usize(0);
        while(i < n, {
          match(
            fts.get(i),
            .Some(ft) => if(type_contains_rc_cell_or_move_only(&ft), {
              mut(fc) := String.from("(");
              fc.push_string(value_code.clone());
              fc.push_str(")._");
              fc.push_string(i.to_string());
              fd := recur(&fc, &ft, context);
              if(fd.len() > usize(0), {
                mut(line) := fd;
                line.push_str(";");
                context.base.emitter.emit_string_line(&line);
              });
            }),
            .None => ()
          );
          i = (i + usize(1));
        });
        String.from("")
      },
      _ => String.from("")
    ),
    // Through the vtable: the payload's own RC functions
    // (`__yo_dyn_release`, functions/gc-runtime.yo). The cell of an
    // `Rc(Dyn(T))` is such a fat pointer (decision 49 S2).
    (is_dyn_type(&concrete_type) || is_dyn_cell_type(&concrete_type)) => {
      mut(out) := String.from("__yo_dyn_release((void*)(");
      out.push_string(value_code.clone());
      out.push_str(").data, (const void*)(");
      out.push_string(value_code.clone());
      out.push_str(").vtable)");
      out
    },
    is_atomic_reference_struct_type(&concrete_type) => {
      mut(out) := String.from("__yo_decr_rc_atomic((void*)(");
      out.push_string(value_code.clone());
      out.push_str("))");
      out
    },
    is_reference_struct_type(&concrete_type) => {
      mut(out) := String.from("__yo_decr_rc((void*)(");
      out.push_string(value_code.clone());
      out.push_str("))");
      out
    },
    // Reference-semantics enums (`ref(enum(…))`) are RC handles — decrement the
    // ref-count directly, exactly like reference-semantics structs above (trait
    // methods live in a side-registry, not on the type, so RC lowers the
    // same direct way it already does for ref-structs — identical effect.)
    is_atomic_reference_enum_type(&concrete_type) => {
      mut(out) := String.from("__yo_decr_rc_atomic((void*)(");
      out.push_string(value_code.clone());
      out.push_str("))");
      out
    },
    is_reference_enum_type(&concrete_type) => {
      mut(out) := String.from("__yo_decr_rc((void*)(");
      out.push_string(value_code.clone());
      out.push_str("))");
      out
    },
    // Value enum carrying RC fields: drop the active variant's RC fields. RC
    // operations lower directly rather than via a side-registry method (same
    // rationale as the reference-enum branch above; registering a ___drop method
    // instead makes
    // `(___drop)(x)` resolve via method dispatch, which mis-lowers). The tagged
    // representation's per-variant walk is a codegen-synthesized C function per
    // enum type (`_value_enum_rc_fn`), called at each site.
    is_enum_type(&concrete_type) => match(
      can_optimize_as_nullable_pointer(&concrete_type),
      // Nullable-pointer enum: the value IS the inner pointer (NULL = the empty variant).
      .Some(inner) => if(is_unique_box_type(&inner), {
        // `Option(Box(T))`: the box's drop is emitted as statements (its
        // dispose), so the NULL test brackets them.
        context.base.emitter.emit_string_line(`if ((${value_code.clone()}) != NULL) {`);
        box_drop := recur(value_code.clone(), &inner, context);
        if(box_drop.len() > usize(0), {
          context.base.emitter.emit_string_line(`${box_drop};`);
        });
        context.base.emitter.emit_string_line(String.from("}"));
        String.from("")
      }, {
        inner_drop := recur(value_code.clone(), &inner, context);
        if(inner_drop.len() > usize(0), {
          mut(line) := String.from("if ((");
          line.push_string(value_code.clone());
          line.push_str(") != NULL) { ");
          line.push_string(&inner_drop);
          line.push_str("; }");
          context.base.emitter.emit_string_line(&line);
        });
        String.from("")
      }),
      // Tagged representation: one per-type drop function switches on the
      // discriminant and drops each RC field of the active arm; every site
      // calls it (issues/fixed/value-enum-drops-are-emitted-inline-at-every-drop-site.md).
      .None => {
        vd_name := _value_enum_rc_fn(&concrete_type, context);
        `${vd_name}((void*)&(${value_code.clone()}))`
      }
    ),
    // Newtype (`newtype(_f : Inner)`): a TRANSPARENT typedef to `Inner` at
    // the C ABI (no struct wrapper, no `._f` member) — drop the inner value
    // by recursing on the inner field's type with the SAME value_code.
    is_newtype_type(&concrete_type) => {
      nt_rfs := get_runtime_struct_fields(&concrete_type);
      match(
        nt_rfs.get_cloned(usize(0)),
        .Some(nt_f) => cond(
          type_contains_rc_cell_or_move_only(&nt_f.ty) => recur(value_code.clone(), &nt_f.ty, context),
          true => String.from("")
        ),
        .None => String.from("")
      )
    },
    // Value struct carrying RC fields: drop via its registered ___drop method
    // when one exists (specialized generic impls), else drop each RC field
    // INLINE — the same rationale as the value-enum arm above (RC ops lower
    // directly; no per-type ___drop methods are synthesized).
    // Previously the missing-method
    // case silently emitted NOTHING, so value-struct locals (e.g. MapEntry(K, V)
    // in HashMap.set) never released their RC fields at scope end.
    is_struct_type(&concrete_type) => match(
      get_drop_function_for_type(&concrete_type, context),
      .Some(fn) => {
        mut(out) := fn;
        out.push_str("(");
        out.push_string(value_code.clone());
        out.push_str(")");
        out
      },
      .None => {
        vs_rfs := get_runtime_struct_fields(&concrete_type);
        (mut(vs_fi) : usize) = usize(0);
        while(vs_fi < vs_rfs.len(), {
          match(
            vs_rfs.get_cloned(vs_fi),
            .Some(vs_f) => if(type_contains_rc_cell_or_move_only(&vs_f.ty), {
              mut(fref) := String.from("(");
              fref.push_string(value_code.clone());
              fref.push_str(").");
              fref.push_string(sanitize_for_c_identifier(vs_f.label.clone(), false));
              fd := recur(&fref, &vs_f.ty, context);
              if(fd.len() > usize(0), {
                mut(line) := fd;
                line.push_str(";");
                context.base.emitter.emit_string_line(&line);
              });
            }),
            .None => ()
          );
          vs_fi = (vs_fi + usize(1));
        });
        String.from("")
      }
    ),
    true => String.from("")
  )
});
/// A new count on the counted handle `value_code` of type `handle_type` (a
/// `ref` object, an atomic object or a cell handle, `is_counted_handle_type`):
/// the handle itself, retained. A borrow pin (decision 25,
/// `_generate_inout_local_binding` and `generate_local_borrow_repoint`) holds
/// the cell a borrow reaches its place through, and the evaluator types a pin
/// only at a counted handle; any other type is a codegen fatal.
counted_handle_retain_code :: (fn(value_code : &String, handle_type : &TypeValue, context : &mut FunctionGenerationContext) -> String)({
  if(!is_counted_handle_type(handle_type), {
    return(codegen_fatal_expr(`a borrow pin holds a counted handle, not a ${get_type_string(handle_type, &mut context.base)}`));
  });
  incr := if(is_atomic_counted_handle_type(handle_type), "__yo_incr_rc_atomic", "__yo_incr_rc");
  `((${get_type_string(handle_type, &mut context.base)})${incr}((void*)(${value_code.*})))`
});
/// The `___drop(name)` / `(name.___drop)()` target ATOM node (mirror of
/// return.yo's private `_drop_target_atom`; duplicated to avoid a
/// drop_dup -> return import cycle).
_dd_drop_target_atom :: (fn(drop_expr : &AstExpr) -> Option(AstExpr))(
  match(
    drop_expr,
    Rc(.FnCall(_, func, Rc(args), _, _)) => if(
      args.len() == usize(0),
      match(
        func,
        Rc(.FnCall(_, _, Rc(fargs), _, _)) => if(ast_expr_is_fn_call_of(&func.*, BF_DOT, Option(usize).Some(usize(2))), {
          a1_is_drop := match(fargs.get_cloned(usize(1)), .Some(a1) => if(ast_expr_is_atom(&a1), ast_expr_token(&a1).*.value.* == BF_DROP, false), .None => false);
          if(a1_is_drop, match(fargs.get_cloned(usize(0)), .Some(a0) => if(ast_expr_is_atom(&a0), Option(AstExpr).Some(a0), Option(AstExpr).None), .None => Option(AstExpr).None), Option(AstExpr).None)
        }, Option(AstExpr).None),
        Rc(.Atom(_, _)) => Option(AstExpr).None
      ),
      if(ast_expr_is_fn_call_of(drop_expr, BF_DROP, Option(usize).None), match(args.get_cloned(usize(0)), .Some(a0) => if(ast_expr_is_atom(&a0), Option(AstExpr).Some(a0), Option(AstExpr).None), .None => Option(AstExpr).None), Option(AstExpr).None)
    ),
    Rc(.Atom(_, _)) => Option(AstExpr).None
  )
);
/// True when a deferred `___drop` targets a function PARAMETER (the target
/// atom's innermost env binding carries `is_parameter`). Param drops are
/// FUNCTION-scope drops (the own-param scope-end release the evaluator merges
/// onto the fn-body node, begin.yo's params-frame pass) — only function-level
/// emission points may emit them. Expression-level flushes (a call/match
/// statement's post-emit flush) pass `skip_param_drops = true`: on a
/// SINGLE-EXPRESSION body the fn-body node IS the tail expression node
/// (the id is shared; no begin wrapper is cloned), so an unfiltered
/// expression-level flush emitted the own-param drop a SECOND time next to the
/// function-level one — the use_and_sink double-free glibc caught in CI
/// (tcache "unaligned chunk", tests/ref-field-borrow.test.yo). An `FnOnce`
/// closure's capture drop (`is_fnonce_capture_drop`) is the same kind of
/// function-scope drop: the body owns the capture as it owns a `sink`
/// parameter, so it is emitted only at the function-level points too
/// (plans/VALUES_BY_DEFAULT.md decision 37).
_drop_target_is_parameter :: (fn(drop_expr : &AstExpr, context : &FunctionGenerationContext) -> bool)(
  !is_fnonce_post_call_release(ast_expr_id(drop_expr)) && (
    is_fnonce_capture_drop(ast_expr_id(drop_expr)) || match(
      _dd_drop_target_atom(drop_expr),
      .Some(atom) => match(
        context.base.get_expr_info(&atom),
        .Some(aei) => {
          vars := scope_variables(ast_expr_id(&atom), &aei.env(), ast_expr_token(&atom).*.value.*);
          if(vars.len() == usize(0), false, match(vars.last_cloned(), .Some(v) => v.*.is_parameter(), .None => false))
        },
        .None => false
      ),
      .None => false
    )
  )
);
/// Emit the evaluator-deferred drop expressions for `expr` (closure-capture and
/// short-circuit-handled drops are skipped).
/// `skip_param_drops` / `only_param_drops` split ownership of PARAM-targeted
/// drops between expression-level and function-level emission points — see
/// `_drop_target_is_parameter`.
/// True iff `cn` looks like an eval-minted temp C name: contains `_temp_`
/// followed by ONLY digits (at least one) to the end — e.g.
/// `_file____User_temp_188653`. Module-blind fallback for the undeclared-temp
/// drop gates: `is_temp_variable_name` recomputes the module prefix from the
/// DROP SITE's `ei.env.module_path`, which can differ in FORM from the temp's
/// minting module path (URL `file:///...` vs relative `./...`), so the scoped
/// check alone misses cross-form temps. The digits-only suffix keeps user
/// variables like `await_future_temp_var_aliases` out.
_looks_like_minted_temp :: (fn(cn : &String) -> bool)({
  marker := String.from("_temp_");
  idx_opt := cn.index_of(&marker);
  match(
    idx_opt,
    .None => false,
    .Some(idx) => {
      start := (idx + marker.len());
      n := cn.len();
      if(start >= n, {
        return(false);
      });
      (mut(i) : usize) = start;
      (mut(ok) : bool) = true;
      while(i < n, {
        b := cn.byte_at(i);
        if(!((b >= u8(48)) && (b <= u8(57))), {
          ok = false;
          i = n;
        }, {
          i = (i + usize(1));
        });
      });
      ok
    }
  )
});
/// Whether `expr` still carries a not-yet-emitted drop that the node flush
/// would EMIT now: a param-targeted one (the own-param scope-end release), or
/// one whose target is declared (a temp minted while rendering the tail, e.g.
/// the argument temp of a call inside a struct-literal field). Mirrors
/// `generate_deferred_drop_expressions`'s closure-capture and undeclared-temp
/// gates. The bare-expression tail return uses it to decide whether the tail
/// must be materialized before those drops run.
has_pending_emittable_drop :: (fn(expr : &AstExpr, context : &FunctionGenerationContext) -> bool)(
  match(
    context.base.get_expr_info(expr),
    .Some(ei) => match(
      &ei.deferred_drop_expressions(),
      .Some(drops) => {
        (found : bool) = false;
        (i : usize) = usize(0);
        while((i < drops.len()) && !found, {
          match(
            drops.get_cloned(i),
            .Some(d) => if(!context.emitted_deferred_drop_ids.contains(ast_expr_id(&d)) && !is_deferred_drop_for_closure_capture(&d, &context.current_closure_captures, sm_owns_fnonce_captures(context)), {
              emittable := if(
                _drop_target_is_parameter(&d, context),
                true,
                match(
                  get_deferred_drop_target_atom_name(&d),
                  .Some(nm) => {
                    cn := sanitize_for_c_identifier(&nm, false);
                    is_tmp := (is_temp_variable_name(&ei.env().module_path().*, cn.clone()) || _looks_like_minted_temp(cn.clone()));
                    declared := context.base.declared_c_var_names.*.with({ &cn }(dn_s) => dn_s.contains(&cn.*));
                    !is_tmp || declared
                  },
                  .None => true
                )
              );
              if(emittable, {
                found = true;
              });
            }),
            .None => ()
          );
          i = (i + usize(1));
        });
        found
      },
      .None => false
    ),
    .None => false
  )
);
(g_debug_scope_drops : bool) = debug_knob(`YO_DEBUG_SCOPE_DROPS`).is_some();

generate_deferred_drop_expressions :: (
  fn(
    expr : &AstExpr,
    indent : &String,
    context : &mut FunctionGenerationContext,
    (skip_param_drops : bool) ?= false,
    (only_param_drops : bool) ?= false,
    (split_fnonce_post_call : bool) ?= false
  ) -> unit
)(
  match(
    context.base.get_expr_info(expr),
    .Some(ei) => match(
      &ei.deferred_drop_expressions(),
      .Some(drops) => {
        n := drops.len();
        (i : usize) = usize(0);
        while(i < n, {
          match(
            drops.get_cloned(i),
            .Some(drop_expr) => {
              if(g_debug_scope_drops, {
                eprintln(`[sd-fl] carrier=${ast_expr_to_string(expr)} target=${match(get_deferred_drop_target_atom_name(&drop_expr), .Some(n) => n, .None => String.from("-"))}`);
              });
              // Emitted-once guard: a SHARED single-expression begin node
              // carries the begin's scope-end drops AND the tail call's
              // own drops, and is flushed from several points
              // (the call emitter's post-call flush, the enclosing arm/body
              // flush). This set — not list removal — is the idempotence
              // signal: membership in the node list is the pending path's
              // "the node's own flush handles it" contract
              // (generate_pending_deferred_drops's `already`), which
              // removal-on-emit would break. Checked BEFORE the gates below
              // so an already-emitted drop also leaves their state (the
              // short-circuit set) untouched.
              if(!context.emitted_deferred_drop_ids.contains(ast_expr_id(&drop_expr)), {
                param_target := if(skip_param_drops || only_param_drops, _drop_target_is_parameter(&drop_expr, context), false);
                // On the function-level passes of a single-expression body
                // (`split_fnonce_post_call`), an `FnOnce` callee's post-call
                // release splits like a parameter drop: the flush-first
                // (`skip_param_drops`) leaves it out, since on the shared-id
                // body node it would run before the call reads the captures,
                // and the pass after a unit tail (`only_param_drops`) emits it,
                // after the call. A call's own post-call flush also passes
                // `skip_param_drops` and must still emit it, so the split is
                // opt-in
                // (issues/fixed/2026-10-31-a-single-expression-body-releases-an-fnonce-parameters-captures-before-calling-it.md).
                post_call := (split_fnonce_post_call && is_fnonce_post_call_release(ast_expr_id(&drop_expr)));
                param_filtered := ((skip_param_drops && (param_target || post_call)) || (only_param_drops && !(param_target || post_call)));
                skip_capture := (param_filtered || is_deferred_drop_for_closure_capture(&drop_expr, &context.current_closure_captures, sm_owns_fnonce_captures(context)));
                // Skip a drop whose target TEMP was never emitted as a C declaration
                // (declaration elided while its deferred-drop survived) — emitting
                // `__yo_decr_rc(undeclared_temp)` is an undeclared-identifier error.
                // Gated to temp names (is_temp_variable_name) so function params /
                // user vars (declared in the C signature, not via get_variable_type_string)
                // are never skipped. Safe: a never-declared C variable cannot be
                // double-freed and holds no value to leak.
                undeclared_temp := match(
                  get_deferred_drop_target_atom_name(&drop_expr),
                  .Some(nm) => {
                    cn := sanitize_for_c_identifier(&nm, false);
                    (is_temp_variable_name(&ei.env().module_path().*, cn.clone()) || _looks_like_minted_temp(cn.clone())) && !context.base.declared_c_var_names.*.with({ &cn }(dn_s) => dn_s.contains(&cn.*))
                  },
                  .None => false
                );
                if(!skip_capture && !undeclared_temp, {
                  sc_skip := match(get_deferred_drop_target_atom_name(&drop_expr), .Some(t) => take_short_circuit_handled(context, &t), .None => false);
                  if(!sc_skip, {
                    code := _call_generate_expr(&drop_expr, indent.clone(), context);
                    // Record unconditionally, emit conditionally: an
                    // enum/Option-typed target lowers to a multi-line `switch`
                    // the drop generator writes to the emitter itself and
                    // hands back "" — the drop is on the page either way, and
                    // bookkeeping hung off `len() > 0` left exactly those
                    // drops unrecorded, so the early-exit path
                    // (return.yo's generate_pending_deferred_drops) released
                    // a bare arm's String temps a second time (the
                    // "unwind argument built by a may-unwind call" test).
                    // Same contract as and-or.yo's two emission points.
                    context.emitted_deferred_drop_ids.insert(ast_expr_id(&drop_expr));
                    if(code.len() > usize(0), {
                      line := indent.clone();
                      line.push_string(&code);
                      line.push_str(";");
                      context.base.emitter.emit_string_line(&line);
                    });
                  });
                });
              });
            },
            .None => ()
          );
          i = (i + usize(1));
        });
      },
      .None => ()
    ),
    .None => ()
  )
);
/// Emit the early-exit-only deferred drops attached to `expr` (a
/// `return`/`unwind` node, or a `break`/`continue` atom) — M3: the drops of
/// the consumed locals the exit leaves before their move. Closure-capture
/// drops are skipped, the rest emitted.
generate_early_return_only_deferred_drop_expressions :: (fn(expr : &AstExpr, indent : &String, context : &mut FunctionGenerationContext) -> unit)(
  match(
    context.base.get_expr_info(expr),
    .Some(ei) => match(
      expr_info_early_return_only_deferred_drop_expressions(&ei),
      .Some(early_drops) => {
        (i : usize) = usize(0);
        while(i < early_drops.len(), {
          match(
            early_drops.get_cloned(i),
            .Some(drop_expr) => if(!is_deferred_drop_for_closure_capture(&drop_expr, &context.current_closure_captures, sm_owns_fnonce_captures(context)), {
              // Gate: the drop target's C declaration must have been emitted AND
              // its enclosing C block must still be open at this exact point
              // (block-scope stack — same authoritative C-emission-order signal
              // as _keep_pending_drop; params are seeded at function entry).
              // Source-token gates at attach time cannot see C decl-emission
              // order: a `x := match(...)` binding emits its C declaration
              // AFTER the switch, so a `return` inside an arm precedes it in C
              // while FOLLOWING x's init token in source — for such a binding
              // consumed later, the M3-attached drop would reference an
              // undeclared identifier (stage-2 `result` /
              // `temp_var_name`). A target absent from the stack holds no C
              // value here, so skipping cannot double-free or leak. Subsumes
              // the former minted-TEMP declared_c_var_names check.
              // A local with a task slot is never declared as a C variable,
              // so the stack cannot vouch for it; the slot always exists and
              // is zero while it owns nothing
              // (issues/fixed/an-early-return-from-an-io-async-body-never-releases-a-slot-local-its-tail-moves.md).
              skip_undeclared := match(
                get_deferred_drop_target_atom_name(&drop_expr),
                .Some(vn) => {
                  cn := sanitize_for_c_identifier(vn.clone(), false);
                  in_slot := match(
                    &context.state_machine_variables,
                    .Some(smv) => (context.in_async_state_machine.is_some() && sm_slot_of(match(get_deferred_drop_target_atom(&drop_expr), .Some(ta) => ast_expr_id(&ta), .None => ast_expr_id(expr)), &ei.env(), &vn, &smv.*, &context.variable_id_remapping, &context.state_machine_field_aliases, &context.sm_capture_slot).is_some()),
                    .None => false
                  );
                  // Likewise an `FnOnce` closure's owned capture lives in the
                  // closure context, never a C local (decision 37).
                  !in_slot && !is_fnonce_capture_drop(ast_expr_id(&drop_expr)) && !context.base.declared_scopes.*.with({ &cn }(ds_s) => scope_stack_contains(ds_s, cn))
                },
                .None => false
              );
              if(!skip_undeclared, {
                code := _call_generate_expr(&drop_expr, indent.clone(), context);
                if(code.len() > usize(0), {
                  line := indent.clone();
                  line.push_string(&code);
                  line.push_str(";");
                  context.base.emitter.emit_string_line(&line);
                });
              });
            }),
            .None => ()
          );
          i = (i + usize(1));
        });
      },
      .None => ()
    ),
    .None => ()
  )
);
export(
  _looks_like_minted_temp,
  get_drop_function_for_type,
  counted_handle_retain_code,
  get_dispose_function_for_type,
  dispose_function_takes_pointer,
  dispose_call_on_value,
  resolve_some_type_param_type,
  generate_drop_code_for_value,
  generate_deferred_drop_expressions,
  has_pending_emittable_drop,
  generate_early_return_only_deferred_drop_expressions
);
