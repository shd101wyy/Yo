//! Anonymous-tuple constructor emitter.
//!
//! Emits `(<cName>){ ._0 = a, ._1 = b, ... }` for a `tuple(...)` call. If the
//! tuple has a result variable name, emits it into a named temp and returns
//! the temp; otherwise returns the C compound-literal inline. A zero-arg tuple
//! is the unit value — optimized away (returns ""). Per-field deferred-dup
//! emission for moved RC fields (rc layer 4 — without it the tuple
//! literal aliased its field's refcount and scope-end drops over-released),
//! through `emit_deferred_dup_or_code`.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr } :: import("../../expr.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ type_key, get_variable_type_string } :: import("../utils/index.yo");
{ is_unit_type } :: import("../../types/guards.yo");
{ TypeValue, no_types, t_slot_is_borrow } :: import("../../types/definitions.yo");
{ emit_deferred_dup_or_code } :: import("./drop_dup.yo");
{ _store_temp_var_to_state_machine_if_needed, sequence_operand, reference_operand_is_value } :: import("./other_fn_call.yo");
{ codegen_fatal_expr } :: import("../constants.yo");
/// Args of a FnCall (empty for an Atom).
_args :: (fn(e : &AstExpr) -> ArrayList(AstExpr))(
  match(e, .FnCall(_, _, Rc(a), _, _) => a.clone(), .Atom(_, _) => ArrayList(AstExpr).new())
);
/// Build `(<cName>){ ._0 = a, ... }`, emitting into a named temp when the
/// tuple has a result variable name. Shared by the main and fallback paths.
_build_tuple :: (fn(arg_exprs : &ArrayList(AstExpr), c_name : &String, expr : &AstExpr, indent : &String, context : &mut FunctionGenerationContext) -> String)({
  ei := match(context.base.get_expr_info(expr), .Some(e) => e, .None => return(String.from("")));
  elem_types := match(&ei.ty(), Rc(.Tuple({ field_types : fts })) => Rc.clone(fts), _ => no_types());
  mut(args_list) := String.from("");
  n := arg_exprs.len();
  (i : usize) = usize(0);
  (mut(any_elem) : bool) = false;
  while(i < n, {
    match(
      arg_exprs.get(i),
      // A `unit` element is zero-sized and has no `_N` member
      // (types/generation.yo), so it gets no initializer; its expression still
      // runs for its side effects.
      .Some(arg) => if(match(elem_types.get(i), .Some(et) => is_unit_type(&et), .None => false), {
        u_code := _call_generate_expr(&arg, indent.clone(), context);
        if(u_code.len() > usize(0), {
          mut(u_stmt) := indent.clone();
          u_stmt.push_string(&u_code);
          u_stmt.push_str(";");
          context.base.emitter.emit_string_line(&u_stmt);
        });
      }, {
        if(any_elem, {
          args_list.push_str(", ");
        });
        any_elem = true;
        args_list.push_str("._");
        args_list.push_string(i.to_string());
        args_list.push_str(" = ");
        // The element's deferred `___dup` (a field store): the literal owns
        // its own +1 per RC field. `emit_deferred_dup_or_code` is the store
        // rule every other store position uses: it declares a projection's
        // temp before the dup names it (an inlined `s.buf` has none, and the
        // undeclared-temp gate then dropped the dup: a double free,
        // issues/fixed/2026-10-25-a-tuple-literal-copying-a-field-out-of-a-value-skips-the-dup.md),
        // and keeps the source for an element-wise dup, whose temp is one
        // element of it.
        elem_code := emit_deferred_dup_or_code(&arg, _call_generate_expr(&arg, indent.clone(), context), indent.clone(), context);
        // A reference element (decision 43 step 3) holds a lend: the
        // argument is the place, the C member its address, taken before
        // sequencing (a hoisted temporary would be a copy of the place). A
        // reference VALUE (a by-value `&U` binding, a call's result: R3) is
        // the pointer itself.
        e_is_ref := (match(elem_types.get(i), .Some(et) => t_slot_is_borrow(&et), .None => false) && !reference_operand_is_value(&arg, context));
        // Sequenced against the later elements (`sequence_operand`,
        // other_fn_call.yo): C leaves initializers unordered, and a later
        // element's statements run before this literal.
        args_list.push_string(sequence_operand(&arg, if(e_is_ref, `(&(${elem_code}))`, elem_code), arg_exprs, i, e_is_ref, indent, context));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  tuple_value := String.from("(");
  tuple_value.push_string(c_name);
  tuple_value.push_str("){ ");
  tuple_value.push_string(&args_list);
  tuple_value.push_str(" }");
  match(
    &ei.variable_name(),
    .Some(temp_var) => {
      decl := indent.clone();
      decl.push_string(get_variable_type_string(&ei.ty(), temp_var.clone(), &mut context.base));
      decl.push_str(" = ");
      decl.push_string(&tuple_value);
      decl.push_str(";");
      context.base.emitter.emit_string_line(&decl);
      // A tuple result temp declared as a C local inside a state machine may
      // own an `sm->var_<id>` slot (its deferred drop reads the slot), so store
      // the value there too — the same rule as every other temp-declaring
      // site (other_fn_call.yo; the async-loop-body temp leak family).
      _store_temp_var_to_state_machine_if_needed(temp_var.clone(), indent.clone(), context);
      temp_var.clone()
    },
    .None => tuple_value
  )
});
/// Error comment when the tuple's C type was never registered.
_type_not_found :: (fn(ei_ty_key : &String) -> String)({
  out := String.from("/* Error: tuple type not found - typeId: ");
  out.push_string(ei_ty_key);
  out.push_str(" */");
  out
});
/// The `tuple(...)` function call, generating a tuple value.
generate_anonymous_tuple :: (fn(expr : &AstExpr, indent : &String, context : &mut FunctionGenerationContext) -> String)({
  ei := match(context.base.get_expr_info(expr), .Some(e) => e, .None => return(codegen_fatal_expr(String.from("tuple has no evaluation info"))));
  ty_key := type_key(&ei.ty());
  c_name_opt := context.base.get_type_c_name(ty_key.clone());
  match(
    &ei.runtime_arg_exprs_in_order(),
    .Some(arg_exprs) => match(
      c_name_opt,
      .Some(c_name) => _build_tuple(&arg_exprs, &c_name, expr, indent, context),
      .None => if(_args(expr).len() == usize(0), String.from(""), _type_not_found(&ty_key))
    ),
    .None => {
      args := _args(expr);
      if(
        args.len() == usize(0),
        String.from(""),
        match(
          c_name_opt,
          .Some(c_name) => _build_tuple(&args, &c_name, expr, indent, context),
          .None => _type_not_found(&ty_key)
        )
      )
    }
  )
});
export(generate_anonymous_tuple);
