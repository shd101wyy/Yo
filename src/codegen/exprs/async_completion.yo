//! async_completion — shared helper for emitting "complete the async Future"
//! boilerplate in C codegen.
//!
//! Used by (Phase 5):
//!   - generate_atom (return atom in a state machine)
//!   - generate_return (return with/without arg in a state machine)
//!   - async/state_machine (normal final-state completion)
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ Emitter } :: import("../../emitter.yo");
{ AstExpr, ast_expr_token, ast_expr_is_fn_call_of, is_function_boundary_arrow, BK_COND, BK_MATCH } :: import("../../expr.yo");
{ evaluated_body_contains_unwind } :: import("../../expr_traversal.yo");
{ fnv1a64, canonical_module_path } :: import("../../utils.yo");
/// Emits the C code to complete an async Future state machine:
///   1. Optionally store the result value
///   2. Set state to COMPLETED (-1) with release semantics
///   3. Schedule every waiter (`__yo_future_wake_waiters`)
///   4. Release the "running task" reference (decr rc)
///   5. Return from the resume function
///
/// `result_code` — if `.Some`, emit `sm->result = <result_code>;` before completing.
/// `debug_label` — optional label for ASYNC_DEBUG messages (e.g. function name).
emit_async_future_completion :: (
  fn(
    emitter : Emitter,
    indent : String,
    result_code : Option(String),
    debug_label : Option(String)
  ) -> unit
)({
  match(
    result_code,
    .Some(rc) => emitter.emit_string_line(`${indent}sm->result = ${rc};`),
    .None => ()
  );
  match(
    debug_label,
    .Some(dl) => emitter.emit_string_line(`${indent}ASYNC_DEBUG("${dl}: Setting state to COMPLETED\\n");`),
    .None => ()
  );
  emitter.emit_string_line(`${indent}sm->state = -1;  // -1 = completed`);
  // Every waiter (one inline, or the dispatcher's list) is scheduled.
  emitter.emit_string_line(`${indent}__yo_future_wake_waiters((void*)sm);`);
  emitter.emit_string_line(`${indent}__yo_decr_rc((void*)sm);`);
  emitter.emit_string_line(String.from(""));
  emitter.emit_string_line(`${indent}return;`);
});
/// Emits the C code to mark an async Future state machine as ABORTED (-2):
///   1. Optionally store the result value (for proper RC cleanup in dispose)
///   2. Set state to UNWOUND (-2) with release semantics
///   3. Schedule every waiter, so each awaiter can observe the escape
///   4. Release the "running task" reference (decr rc)
///   5. Return from the resume function
///
/// Called when `unwind` is used inside an async state machine's effect handler.
/// Any task that `io.await`s this Future will panic.
emit_async_future_escape :: (
  fn(
    emitter : Emitter,
    indent : String,
    result_code : Option(String),
    debug_label : Option(String)
  ) -> unit
)({
  match(
    result_code,
    .Some(rc) => emitter.emit_string_line(`${indent}sm->result = ${rc};`),
    .None => ()
  );
  match(
    debug_label,
    .Some(dl) => emitter.emit_string_line(`${indent}ASYNC_DEBUG("${dl}: Setting state to UNWOUND (effect handler escape)\\n");`),
    .None => ()
  );
  emitter.emit_string_line(`${indent}sm->state = -2;  // -2 = escaped`);
  // Loud when nobody observes it: this transition is the effect-unwind abort
  // of a whole task, so register it (gc_runtime.yo, emit_task_abort_registry).
  // An awaiter, `JoinHandle.await` (`.None`) or a state read observes it
  // silently; a task released or still alive at exit unobserved prints
  // "unhandled effect unwind aborted an async task that was never awaited".
  // Cancellation (`JoinHandle.abort()` from race/timeout) reaches -2 through
  // `__yo_task_abort` instead and is never registered.
  emitter.emit_string_line(`${indent}__yo_task_abort_register((void*)sm);`);
  // Wake every waiter so it can observe the escape.
  emitter.emit_string_line(`${indent}__yo_future_wake_waiters((void*)sm);`);
  emitter.emit_string_line(`${indent}__yo_decr_rc((void*)sm);`);
  emitter.emit_string_line(String.from(""));
  emitter.emit_string_line(`${indent}return;`);
});
/// The identity of an `unwind`'s handler: the C constant `__yo_unwind_target`
/// holds while that unwind is in flight. `body` is the handler literal's body,
/// and the id is its source position, so the literal found in its installer's
/// AST and the function generated from it agree however the two were reached.
unwind_origin_id :: (fn(body : AstExpr) -> String)({
  tok := ast_expr_token(body);
  h := fnv1a64(`${canonical_module_path(tok.module_path)}:${tok.row.to_string()}:${tok.column.to_string()}`);
  if(h == u64(0), {
    h = u64(1);
  });
  `${h.to_string()}ULL`
});
/// The body of a function-boundary node (`is_function_boundary_arrow`):
/// the last argument of `params -> body` / `=>`, the only one of
/// `(fn(...) -> T)(body)`.
_boundary_body :: (fn(e : AstExpr) -> Option(AstExpr))(
  match(
    e,
    .FnCall(_, func_box, args, _, _) => match(
      func_box,
      .Atom(_, _) => if(args.len() > usize(0), args.get(args.len() - usize(1)), Option(AstExpr).None),
      .FnCall(_, _, _, _, _) => args.get(usize(0))
    ),
    .Atom(_, _) => Option(AstExpr).None
  )
);
/// Visit the sub-expressions of `e` that belong to the same function: every
/// argument, and for `cond`/`match` both halves of each branch arrow (which is
/// not a function boundary).
_same_frame_children :: (fn(e : AstExpr) -> ArrayList(AstExpr))({
  out := ArrayList(AstExpr).new();
  match(
    e,
    .FnCall(_, func_box, args, _, _) => {
      out.push(func_box);
      is_branching := (ast_expr_is_fn_call_of(e, BK_COND, .None) || ast_expr_is_fn_call_of(e, BK_MATCH, .None));
      (i : usize) = usize(0);
      while(i < args.len(), {
        match(
          args.get(i),
          .Some(a) => if(is_branching && ast_expr_is_fn_call_of(a, "=>", .None), {
            match(
              a,
              .FnCall(_, _, parts, _, _) => {
                (j : usize) = usize(0);
                while(j < parts.len(), {
                  match(parts.get(j), .Some(pa) => out.push(pa), .None => ());
                  j = (j + usize(1));
                });
              },
              .Atom(_, _) => ()
            );
          }, out.push(a)),
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .Atom(_, _) => ()
  );
  out
});
_collect_unwind_catches :: (fn(e : AstExpr, out : ArrayList(String)) -> unit)({
  if(is_function_boundary_arrow(e) && !(ast_expr_is_fn_call_of(e, BK_COND, .None) || ast_expr_is_fn_call_of(e, BK_MATCH, .None)), {
    match(
      _boundary_body(e),
      .Some(body) => {
        if(evaluated_body_contains_unwind(body), {
          out.push(unwind_origin_id(body));
        });
      },
      .None => ()
    );
    return(());
  });
  kids := _same_frame_children(e);
  (i : usize) = usize(0);
  while(i < kids.len(), {
    match(kids.get(i), .Some(k) => _collect_unwind_catches(k, out), .None => ());
    i = (i + usize(1));
  });
});
/// The handler literals written directly in the function body `body` (not in
/// a nested closure) whose `unwind` exits that function. An unwind carries its
/// handler's id at run time; a frame catches exactly the unwinds whose id is
/// in its own list, so an unwind is caught by the frame that installed its
/// handler and typed by that frame, never by whichever frame happens to see
/// the abort first
/// (issues/fixed/unwind-from-a-handler-installed-inside-io-async-exits-main-with-rc-0.md).
unwind_catches_of_body :: (fn(body : AstExpr) -> ArrayList(String))({
  out := ArrayList(String).new();
  _collect_unwind_catches(body, out);
  out
});
/// `(__yo_unwind_target == id1 || ...)` for `catches`, or `.None` when empty.
unwind_catch_condition :: (fn(catches : ArrayList(String)) -> Option(String))({
  if(catches.len() == usize(0), {
    return(Option(String).None);
  });
  c := String.from("(");
  (i : usize) = usize(0);
  while(i < catches.len(), {
    match(
      catches.get(i),
      .Some(id) => {
        if(i > usize(0), {
          c.push_str(" || ");
        });
        c.push_string(`__yo_unwind_target == ${id}`);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  c.push_str(")");
  Option(String).Some(c)
});
/// How the state machine being generated catches an unwind of a handler
/// installed in its own body: resolve its future with the unwound value.
SmUnwindCatch :: struct(
  /// `unwind_catch_condition` of the block's handlers.
  condition : String,
  /// The block's `<id>_state_drop_locals`: its locals are released here, as
  /// the abort dispose would have released them.
  drop_locals_fn : String,
  result_is_unit : bool,
  label : String
);
/// At an abort point of a state machine (an awaited child aborted, or a call
/// escaped): if the in-flight unwind is one of this block's own handlers',
/// the block completes with the unwound value instead of aborting.
emit_sm_unwind_catch :: (fn(emitter : Emitter, indent : String, catch : Option(SmUnwindCatch)) -> unit)(
  match(
    catch,
    .Some(c) => {
      emitter.emit_string_line(`${indent}if ${c.condition} {`);
      emitter.emit_string_line(`${indent}  // One of this block's handlers unwound: the value resolves the future.`);
      emitter.emit_string_line(`${indent}  __yo_unwind_target = 0;`);
      emitter.emit_string_line(`${indent}  __yo_effect_escaped = 0;`);
      if(!c.result_is_unit, {
        emitter.emit_string_line(`${indent}  memcpy(&sm->result, __yo_unwind_value, sizeof(sm->result));`);
      });
      emitter.emit_string_line(`${indent}  ${c.drop_locals_fn}((void*)sm);`);
      emit_async_future_completion(emitter, `${indent}  `, Option(String).None, Option(String).Some(c.label.clone()));
      emitter.emit_string_line(`${indent}}`);
    },
    .None => ()
  )
);
export(emit_async_future_completion, emit_async_future_escape, unwind_origin_id, unwind_catches_of_body, unwind_catch_condition, SmUnwindCatch, emit_sm_unwind_catch);
