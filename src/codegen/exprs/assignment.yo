//! Assignment / initialization emitter.
//!
//! Handles `lhs = rhs` and `(lhs : T) = rhs` (initialization). Skips
//! compile-time-only assignments, module-level globals (declared in the main
//! wrapper), comptime variables, and field/index writes whose base is a
//! comptime variable. Saves the old value into a temp when the assignment has
//! a result variable name (so the old value can be dropped). Arrays use direct
//! struct assignment; other types emit `<type> lhs = rhs;` (init) or
//! `lhs = rhs;` (reassignment).
//!
//! DEFERRED (documented, not hit by the no-RC / no-async corpus): deferred-dup
//! rewrite of the RHS (Phase 4); Future/async-block struct-type inference and
//! state-machine `sm->var_N` save-old-value + sm-var declaration skipping
//! (Phase 5). The state-machine branches are gated on `in_async_state_machine`
//! being `.Some` — dead for the corpus.
{ String } :: import("std/string");
{ type_implements_future } :: import("../../evaluator/trait_checking.yo");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ExprId, ast_expr_id, ast_expr_is_atom, ast_expr_is_fn_call_of, ast_expr_token, ast_expr_to_string, BK_COLON, BK_COMPTIME, BF_DOT, BF_YO_ARRAY_INDEX } :: import("../../expr.yo");
{ Environment } :: import("../../env.yo");
{ EvalValue, is_func_val } :: import("../../value.yo");
{ is_array_type, is_unit_type } :: import("../../types/guards.yo");
{ type_contains_rc_cell_or_move_only } :: import("../../types/utils.yo");
{ FunctionGenerationContext, sm_owns_fnonce_captures } :: import("../functions/context.yo");
{ CapturedVariable } :: import("../../evaluator/async/await_analysis_types.yo");
{ _call_generate_expr } :: import("./_expr.yo");
// §C dup-on-store: a field/index/deref store of a borrowed RC value must dup it
// (the slot takes a new owned ref) so the value survives the source's scope-end
// drop. The eval marks the RHS via set_expr_as_needs_to_call_dup (assignment.yo
// eval :388); this emits it.
{ emit_deferred_dup_or_code } :: import("./drop_dup.yo");
{ sm_local_field_name, sm_move_flag_of } :: import("../async/state_machine_naming.yo");
{ declare_c_var_name, get_type_string, get_variable_type_string, sanitize_for_c_identifier, is_function_value_with_only_builtin_yo_inline_function_call } :: import("../utils/index.yo");
{ codegen_fatal_expr } :: import("../constants.yo");
{ expr_info_is_compile_time_only_assignment, expr_info_index_method_value, scope_variables, lookup_immediate_old_value_drop } :: import("../../expr_info.yo");
/// The last binding for `name` (in node `key`'s recorded scope `env`) is a
/// module-level global.
_last_is_module_level :: (fn(key : ExprId, env : &Environment, name : &String) -> bool)({
  vars := scope_variables(key, env, name);
  m := vars.len();
  if(m == usize(0), false, match(vars.get(m - usize(1)), .Some(v) => v.is_module_level, .None => false))
});
/// The last binding for `name` (in node `key`'s recorded scope `env`) is a
/// compile-time-only variable.
_last_is_compile_time_only :: (fn(key : ExprId, env : &Environment, name : &String) -> bool)({
  vars := scope_variables(key, env, name);
  m := vars.len();
  if(m == usize(0), false, match(vars.get(m - usize(1)), .Some(v) => v.is_compile_time_only, .None => false))
});
/// The node of a place expression (`a.b.c`, `a.*`, `a(i)`, `f().x`) that
/// binds `name`: the root atom when its token is `name`, or the node whose
/// recorded `variable_name` is `name` (a temp holding a call result), else
/// `lhs` itself. Its record resolves the place's base variable (scope-exit
/// release, plans/CODEGEN_MEMORY_REDUCTION.md §6).
_lhs_root_binder :: (fn(lhs : &AstExpr, name : &String, context : &FunctionGenerationContext) -> AstExpr)({
  (cur : AstExpr) = lhs;
  while(true, {
    binds := match(context.base.get_expr_info(&cur), .Some(ci) => match(ci.variable_name, .Some(vn) => (vn == name), .None => false), .None => false);
    if(binds, {
      return(cur);
    });
    match(
      cur,
      .Atom(_, _) => {
        return(if(ast_expr_token(&cur).value == name, cur, lhs));
      },
      .FnCall(_, callee, args, _, _) => if(ast_expr_is_fn_call_of(&cur, BF_DOT, Option(usize).None), {
        cur = match(args.get(usize(0)), .Some(a0) => a0, .None => callee);
      }, {
        cur = callee;
      })
    );
  });
  lhs
});
/// Does evaluating the place `e` run a call? True for a by-name Index
/// dispatch (every std collection's `index`/`index_mut`: the callee takes
/// its key by value and drops it) and for any other call form (a method
/// call, a direct projection call, an operator) in the place's base chain.
/// A place this answers true for must be evaluated exactly ONCE per
/// assignment: the old-value save and the store each splice its rendered C,
/// and a call spliced twice runs twice
/// (issues/fixed/2026-10-17-an-assignment-through-an-index-call-runs-the-call-twice.md).
_place_evaluation_runs_a_call :: (fn(e : &AstExpr, context : &FunctionGenerationContext) -> bool)({
  runs := match(
    e,
    .Atom(_, _) => false,
    .FnCall(_, callee, args, _, _) => {
      // A field or deref step (`x.f`, `x.*`) renders its base plus a C
      // projection: only the base can call.
      if(ast_expr_is_fn_call_of(e, BF_DOT, Option(usize).Some(usize(2))), {
        return(match(args.get(usize(0)), .Some(b) => _place_evaluation_runs_a_call(&b, context), .None => false));
      });
      // Anything else is a call. The one pure spelling is an Index dispatch
      // the codegen expands inline — `Array`'s
      // `(&((&recv)->data[idx]))`, `BF_YO_ARRAY_INDEX`, the only inline op
      // (`_generate_index_trait_call`): it calls nothing, so it is pure
      // exactly when its receiver and its index argument are. Every other
      // Index dispatch is a by-name call.
      ei := match(context.base.get_expr_info(e), .Some(i) => i, .None => return(true));
      mv := match(expr_info_index_method_value(&ei), .Some(v) => v, .None => return(true));
      if(!is_func_val(&mv), {
        // A broken dispatch renders an error comment, not a call.
        return(false);
      });
      match(
        is_function_value_with_only_builtin_yo_inline_function_call(&mv),
        .Some(op) => if(
          op == BF_YO_ARRAY_INDEX,
          _place_evaluation_runs_a_call(&callee, context) || match(args.get(usize(0)), .Some(ix) => _place_evaluation_runs_a_call(&ix, context), .None => false),
          true
        ),
        .None => true
      )
    }
  );
  runs
});
/// Generate an assignment / initialization.
generate_assignment :: (fn(expr : &AstExpr, indent : &String, context : &FunctionGenerationContext) -> String)({
  ei := match(context.base.get_expr_info(expr), .Some(e) => e, .None => return(String.from("")));
  // Compile-time-only assignment (e.g. `p.* = v` where `p` is comptime).
  if(match(expr_info_is_compile_time_only_assignment(&ei), .Some(b) => b, .None => false), {
    return(String.from(""));
  });
  args := match(expr, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  lhs0 := match(args.get(usize(0)), .Some(x) => x, .None => return(codegen_fatal_expr(String.from("assignment missing lhs"))));
  rhs := match(args.get(usize(1)), .Some(x) => x, .None => return(codegen_fatal_expr(String.from("assignment missing rhs"))));
  // `(lhs : T) = rhs` is an initialization; unwrap to the real lhs variable.
  is_init := ast_expr_is_fn_call_of(&lhs0, BK_COLON, Option(usize).Some(usize(2)));
  lhs := if(is_init, match(lhs0, .FnCall(_, _, la, _, _) => match(la.get(usize(0)), .Some(x) => x, .None => lhs0), .Atom(_, _) => lhs0), lhs0);
  lhs_ei := match(
    context.base.get_expr_info(&lhs),
    .Some(e) => e,
    // NOT fatal: the MISSING-ExprInfo class, which multi-pass emission
    // legitimately reaches (a comptime `while` unrolls its body once per
    // iteration and a discarded pass has no type info). Kept a comment,
    // not an error; the harmful case is the `__yo_user_main` gate in
    // codegen/functions/generation.yo.
    .None => return(`// Error: No type information for left-hand side ${ast_expr_to_string(&lhs)}`)
  );
  // Module-level globals are declared in the main wrapper — skip here.
  if(is_init && ast_expr_is_atom(&lhs), {
    if(_last_is_module_level(ast_expr_id(&lhs), &lhs_ei.env, ast_expr_token(&lhs).value), {
      return(String.from(""));
    });
  });
  // Compile-time variable.
  if(ast_expr_is_fn_call_of(&lhs, BK_COMPTIME, Option(usize).None), {
    return(String.from(""));
  });
  // LHS is a field/index write whose base variable is compile-time.
  pc := lhs_ei.path_collection.clone();
  if(pc.len() > usize(0), {
    match(
      pc.get(usize(0)),
      .Some(path) => if(path.len() >= usize(2), {
        match(
          path.get(usize(0)),
          .Some(base_var) => if(_last_is_compile_time_only(ast_expr_id(_lhs_root_binder(&lhs, base_var.clone(), context)), &lhs_ei.env, base_var.clone()), {
            return(String.from(""));
          }),
          .None => ()
        );
      }),
      .None => ()
    );
  });
  // LHS is a simple comptime variable name.
  if(ast_expr_is_atom(&lhs), {
    if(_last_is_compile_time_only(ast_expr_id(&lhs), &lhs_ei.env, ast_expr_token(&lhs).value), {
      return(String.from(""));
    });
  });
  lhs_type := lhs_ei.ty;
  lhs_code := _call_generate_expr(&lhs, indent.clone(), context);
  // A place whose evaluation runs a call (`m(k)` through a by-name Index
  // dispatch, or a method/projection call in its base chain) must be
  // evaluated ONCE: the old-value save and the store below each splice
  // `lhs_code`, and a call spliced twice runs twice. Each `index_mut` takes
  // its key by value and drops it, so `m(s) = v` dropped the key twice and
  // freed it under the store — a heap-use-after-free for any owning key
  // (issues/fixed/2026-10-17-an-assignment-through-an-index-call-runs-the-call-twice.md).
  // The place is materialized once into a pointer temp taken AFTER the right
  // side (a right side that grows the container would leave a pointer taken
  // before it dangling), and the save and the store both go through it.
  (place_ptr : Option(String)) = Option(String).None;
  if(_place_evaluation_runs_a_call(&lhs, context) && !is_unit_type(&lhs_type), {
    place_ptr = Option(String).Some(`__yo_place_ptr_${ast_expr_id(expr).to_string()}`);
  });
  place_read_code := match(place_ptr, .Some(p) => `(*${p})`, .None => lhs_code.clone());
  em := context.base.emitter;
  // In a state machine the save is written AFTER the RHS, right before the
  // store: the RHS may suspend, and an abort there disposes every non-null
  // slot — a save written first held the pointer the LHS still owns, and
  // both were released (the `fetch` UnsupportedScheme escape). A RHS that
  // moves the old value out zeroes its slot, so the late save reads NULL.
  (sm_save_line : Option(String)) = Option(String).None;
  // A side-effecting place's by-bytes save: deferred to the pointer temp's
  // emission point, after the RHS, together with `deferred_save_c_name` (its
  // temp's C name, for the block-scope stack push below).
  (deferred_save_line : Option(String)) = Option(String).None;
  (deferred_save_c_name : String) = String.from("");
  // Save the old value into the result temp (for a deferred drop of it).
  match(
    ei.variable_name,
    .Some(temp_var_name) => {
      // A place reached through a slot holding its pointer (`(*sm->var_y)`:
      // a local borrow, a `mut` match place) is a slot write too: a save
      // into a C local before an awaiting RHS is garbage at the drop, which
      // reads the temp's slot
      // (issues/fixed/a-mut-match-place-binding-cannot-live-across-an-await.md).
      in_sm := match(context.in_async_state_machine, .Some(_) => (lhs_code.starts_with("sm->") || lhs_code.starts_with("(*sm->")), .None => false);
      if(
        !in_sm,
        if(!is_unit_type(&lhs_type), {
          match(
            place_ptr,
            .Some(pp) => {
              // Side-effecting place: the save waits for the pointer temp
              // (the place's ONE evaluation, taken after the RHS) and copies
              // the old value through it — same by-bytes rationale as the
              // `.None` arm below.
              save := indent.clone();
              save.push_string(get_variable_type_string(&lhs_type, temp_var_name.clone(), &context.base));
              save.push_str("; memcpy(&");
              save.push_string(temp_var_name.clone());
              save.push_str(", ");
              save.push_string(&pp);
              save.push_str(", sizeof(");
              save.push_string(temp_var_name.clone());
              save.push_str(")); // Save old value by bytes through the place pointer");
              deferred_save_line = Option(String).Some(save);
              deferred_save_c_name = sanitize_for_c_identifier(&temp_var_name, false);
            },
            .None => {
              save := indent.clone();
              save.push_string(get_variable_type_string(&lhs_type, temp_var_name.clone(), &context.base));
              // Copy the bytes, never a typed load: the destination may be
              // uninitialized (a container's next slot, an `unsafe(p.* = v)` into
              // fresh memory), and a typed load of it is undefined behavior for a
              // `bool` or an enum. Copying indeterminate bytes is defined, and the
              // temp is read only by the drop of an RC-bearing old value or by a
              // consuming parent, both of which see an initialized slot. At -O1
              // and above the copy is the same load
              // (issues/fixed/consume-assignment-loads-the-uninitialized-old-value.md,
              // issues/fixed/an-assignments-old-value-save-reads-uninitialized-memory-for-pod-types.md).
              save.push_str("; memcpy(&");
              save.push_string(temp_var_name.clone());
              save.push_str(", &(");
              save.push_string(lhs_code.clone());
              save.push_str("), sizeof(");
              save.push_string(temp_var_name.clone());
              save.push_str(")); // Save old value by bytes");
              em.emit_string_line(&save);
              // Put the temp on the block-scope stack, as the typed `T temp = lhs;`
              // did through the emitter's line scan: that scan records only
              // `<type> <name> = …`, and the escape gate skips a pending drop whose
              // target is not in C scope, so every early-exit (`return`, `exn`
              // escape) release of an RC-bearing old value was silently dropped
              // (issues/fixed/2026-10-15-an-assignments-old-value-save-by-bytes-is-never-released.md).
              saved_c_name := sanitize_for_c_identifier(&temp_var_name, false);
              em.mark_declared_in_scope(&saved_c_name);
            }
          );
        }),
        // The LHS is an sm-> slot. When the old-value temp was itself lowered
        // into the
        // state struct, save the old value into ITS OWN sm field — the
        // deferred drop reads it there. When it was NOT (the drop is
        // same-state), a plain LOCAL temp is the correct home. This branch
        // previously emitted NOTHING, so the deferred drop either dropped
        // calloc zero (silent leak) or referenced an undeclared temp.
        if(!is_unit_type(&lhs_type), {
          (sm_field : Option(String)) = Option(String).None;
          match(
            context.state_machine_variables,
            .Some(smv) => {
              (found_cv : Option(CapturedVariable)) = smv.get(temp_var_name.clone());
              if(found_cv.is_none(), {
                // First-match-by-name reading ENTRY fields — never derive
                // emitted names from map keys (the PR #92 capture lesson).
                cvals := smv.values();
                (cv_go : bool) = true;
                while(cv_go, {
                  match(
                    cvals.next(),
                    .Some(cv) => if(cv.base.name == temp_var_name, {
                      found_cv = Option(CapturedVariable).Some(cv);
                      cv_go = false;
                    }),
                    .None => {
                      cv_go = false;
                    }
                  );
                });
              });
              match(
                found_cv,
                .Some(cv2) => match(
                  cv2.kind,
                  .Outer => (),
                  .Local => {
                    sm_field = Option(String).Some(sm_local_field_name(cv2.base.id.to_string()));
                  }
                ),
                .None => ()
              );
            },
            .None => ()
          );
          save_sm := indent.clone();
          match(
            sm_field,
            .Some(fld) => {
              save_sm.push_str("sm->");
              save_sm.push_string(&fld);
              save_sm.push_str(" = ");
              save_sm.push_string(place_read_code.clone());
              save_sm.push_str("; // Save old value for deferred drop");
              // The slot is this temp's storage, so it is declared: the
              // scope-end drop of an undeclared minted temp is skipped, which
              // leaked the old value of every such reassignment
              // (issues/fixed/reassigned-heap-local-in-an-arm-after-a-loop-await-leaks.md).
              declare_c_var_name(&context.base, temp_var_name.clone());
            },
            .None => {
              save_sm.push_string(get_variable_type_string(&lhs_type, temp_var_name.clone(), &context.base));
              save_sm.push_str(" = ");
              save_sm.push_string(place_read_code.clone());
              save_sm.push_str("; // Save old value for later use (not an sm-> slot)");
            }
          );
          sm_save_line = Option(String).Some(save_sm);
        })
      );
    },
    .None => ()
  );
  // While generating the RHS, mark the save-old-value temp so escape drops
  // inside the RHS skip it: ownership of the old value transfers to the temp
  // only when the assignment completes — on an escape the LOCAL still owns it
  // and its own scope drop covers it; dropping both double-freed the old value
  // (the round-4 `rhs = evaluate(rhs)` escape UAF; the escape list drops only
  // the local, never the not-yet-defined temp). Save/restore for nesting.
  prev_save_temp := context.current_assignment_save_temp;
  match(
    ei.variable_name,
    .Some(stn) => {
      context.current_assignment_save_temp = Option(String).Some(stn.clone());
    },
    .None => ()
  );
  // Array assignment uses direct struct copy; everything else is scalar.
  if(is_array_type(&lhs_type), {
    rhs_code := emit_deferred_dup_or_code(&rhs, _call_generate_expr(&rhs, indent.clone(), context), indent.clone(), context);
    // Same FTT degrade as the scalar arm below.
    if(rhs_code.starts_with("// Failed to transpile"), {
      ftl := indent.clone();
      ftl.push_string(&rhs_code);
      em.emit_string_line(&ftl);
      context.current_assignment_save_temp = prev_save_temp;
      return(match(ei.variable_name, .Some(v) => sanitize_for_c_identifier(&v, false), .None => String.from("")));
    });
    // A side-effecting place is materialized ONCE here, AFTER the RHS: the
    // pointer temp is the place's single evaluation, and the save and the
    // store below both read and write through it.
    match(
      place_ptr,
      .Some(pp) => em.emit_string_line(`${indent.clone()}${get_type_string(&lhs_type, &context.base)}* ${pp} = &(${lhs_code}); // Evaluate the place once`),
      .None => ()
    );
    match(sm_save_line, .Some(sl) => em.emit_string_line(&sl), .None => ());
    match(
      deferred_save_line,
      .Some(ds) => {
        em.emit_string_line(&ds);
        // The block-scope push of the `.None` arm above, at the deferred
        // emission point.
        em.mark_declared_in_scope(&deferred_save_c_name);
      },
      .None => ()
    );
    if(is_init, {
      vt := get_variable_type_string(&lhs_type, _call_generate_expr(&lhs, indent.clone(), context), &context.base);
      line := indent.clone();
      line.push_string(&vt);
      line.push_str(" = ");
      line.push_string(&rhs_code);
      line.push_str(";");
      em.emit_string_line(&line);
    }, {
      line := indent.clone();
      line.push_string(place_read_code.clone());
      line.push_str(" = ");
      line.push_string(&rhs_code);
      line.push_str(";");
      em.emit_string_line(&line);
    });
  }, {
    rhs_code := emit_deferred_dup_or_code(&rhs, _call_generate_expr(&rhs, indent.clone(), context), indent.clone(), context);
    // DEGRADED assignment when the RHS render failed to transpile: splicing
    // the comment into `<type> <name> = <comment>;` breaks the C
    // ("unexpected type name", the c03 dyn(rc(closure)) shape). Same
    // convention as the return/tail FTT degrades — emit the whole statement
    // as the comment.
    if(rhs_code.starts_with("// Failed to transpile"), {
      ftl := indent.clone();
      ftl.push_string(&rhs_code);
      em.emit_string_line(&ftl);
      context.current_assignment_save_temp = prev_save_temp;
      return(match(ei.variable_name, .Some(v) => sanitize_for_c_identifier(&v, false), .None => String.from("")));
    });
    // A side-effecting place is materialized ONCE here, AFTER the RHS: the
    // pointer temp is the place's single evaluation, and the save and the
    // store below both read and write through it.
    match(
      place_ptr,
      .Some(pp) => em.emit_string_line(`${indent.clone()}${get_type_string(&lhs_type, &context.base)}* ${pp} = &(${lhs_code}); // Evaluate the place once`),
      .None => ()
    );
    match(sm_save_line, .Some(sl) => em.emit_string_line(&sl), .None => ());
    match(
      deferred_save_line,
      .Some(ds) => {
        em.emit_string_line(&ds);
        // The block-scope push of the `.None` arm above, at the deferred
        // emission point.
        em.mark_declared_in_scope(&deferred_save_c_name);
      },
      .None => ()
    );
    if(!is_unit_type(&lhs_type), {
      c_type_string := get_type_string(&lhs_type, &context.base);
      is_sm_var := match(context.in_async_state_machine, .Some(_) => lhs_code.starts_with("sm->"), .None => false);
      line := indent.clone();
      if(is_init && !is_sm_var, {
        line.push_string(&c_type_string);
        line.push_str(" ");
      });
      line.push_string(place_read_code.clone());
      line.push_str(" = ");
      // An `Impl(Future(T, E))` place is the type-erased future interface:
      // a concrete future stored into it is upcast, as at a constructor
      // (`_future_field_upcast`, other_fn_call.yo).
      is_future_iface := (type_implements_future(&lhs_type) && c_type_string.ends_with("*"));
      line.push_string(if(is_future_iface, `((${c_type_string})(${rhs_code}))`, rhs_code));
      line.push_str(";");
      em.emit_string_line(&line);
      // The slot owns its new value: clear a move out of the old one.
      if(is_sm_var, match(sm_move_flag_of(lhs_code.clone(), sm_owns_fnonce_captures(context) && type_contains_rc_cell_or_move_only(&lhs_type)), .Some(flag) => em.emit_string_line(`${indent.clone()}${flag} = 0;`), .None => ()));
    });
  });
  context.current_assignment_save_temp = prev_save_temp;
  // A statement whose old value is unused and explicit-copy drops it right
  // after the store, as Rust does (`_drop_unused_old_value_now`,
  // evaluator/exprs/begin.yo). The result is then nothing: the old value is
  // gone.
  match(
    lookup_immediate_old_value_drop(ast_expr_id(expr)),
    .Some(drop_expr) => if(!context.emitted_deferred_drop_ids.contains(ast_expr_id(&drop_expr)), {
      context.emitted_deferred_drop_ids.insert(ast_expr_id(&drop_expr));
      drop_code := _call_generate_expr(&drop_expr, indent.clone(), context);
      if(drop_code.len() > usize(0), {
        em.emit_string_line(`${indent.clone()}${drop_code};`);
      });
      return(String.from(""));
    }),
    .None => ()
  );
  match(ei.variable_name, .Some(v) => sanitize_for_c_identifier(&v, false), .None => String.from(""))
});
export(generate_assignment);
