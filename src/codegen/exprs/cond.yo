//! Conditional (`cond`) expression emitter.
//!
//! Lowers a `cond(c1 => v1, c2 => v2, ...)` to a C if/else chain that assigns
//! the taken arm's value to the cond's result temp. Compile-time `false` arms
//! are dropped; a leading compile-time `true` arm collapses to direct value
//! generation (no branch). Arms that are `begin` blocks are inlined so the
//! block's final expression assigns to the cond temp. Control-flow arm values
//! (continue/break/goto/return) are emitted as statements instead of assigned.
//! For `-> &mut T` enclosing functions whose cond temp is a `T*`, non-pointer
//! arm values are address-of wrapped (`&(...)`) — sound because flowability
//! already verified the arm roots back to a ref-bound parameter.
//!
//! A begin arm's own deferred drops are emitted on arm fall-through
//! (_emit_begin_arm).
{ String } :: import("std/string");
import("std/fmt");
{ ArrayList } :: import("std/collections/array-list");
{ AstExpr, ast_expr_is_fn_call_of, ast_expr_token, BK_BEGIN, BK_RETURN } :: import("../../expr.yo");
{ has_any_control_flow, expr_info_consumed_variable_drop_expressions } :: import("../../expr-info.yo");
{ EvalValue } :: import("../../value.yo");
{ is_unit_type, is_pointer_type } :: import("../../types/guards.yo");
{ fn_result_is_ref } :: import("../../types/definitions.yo");
{ is_temp_variable_name } :: import("../../utils.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr, chain_leaf_pointer_code } :: import("./dispatch.yo");
{ generate_deferred_drop_expressions, has_pending_emittable_drop } :: import("./drop-dup.yo");
{ _flush_stmt_lent_temp_drops } :: import("./begin.yo");
{ declare_c_var_name, get_type_string, get_variable_name_for_codegen, fresh_local_name, note_line_position, push_declared_scope, scope_stack_contains } :: import("../utils/index.yo");
{ replace } :: import("std/mem");
/// True for an ASCII word byte ([A-Za-z0-9_]).
_is_word_byte :: (fn(b : u8) -> bool)(
  ((b >= u8(97)) && (b <= u8(122))) || ((b >= u8(65)) && (b <= u8(90))) || ((b >= u8(48)) && (b <= u8(57))) || (b == u8(95))
);
/// True when position `idx` lies INSIDE a double-quoted C string literal in
/// `s` (parity walk with `\\`-escape skipping): the word
/// `return` inside a GENERATED STRING LITERAL (e.g. a Yo source literal
/// "...before early return") is NOT a return statement — treating it as one
/// skipped the arm's result-temp assignment and left the temp uninitialized
/// (SIGBUS; issues/fixed/cond-arm-return-inside-string-literal.md).
_inside_c_string_literal :: (fn(s : &String, idx : usize) -> bool)({
  (mut(in_str) : bool) = false;
  (mut(i) : usize) = usize(0);
  while(i < idx, {
    b := s.byte_at(i);
    cond(
      (in_str && (b == u8(92))) => {
        i = (i + usize(2));
      },
      (b == u8(34)) => {
        in_str = !in_str;
        i = (i + usize(1));
      },
      true => {
        i = (i + usize(1));
      }
    );
  });
  in_str
});
/// Byte-based find of `word` in `s` starting at byte `from` — `index_of`
/// returns RUNE indices, which cannot feed the byte_at reads below when the
/// scanned C code contains multibyte string literals (see other-fn-call.yo's
/// splitter fix).
_byte_index_of :: (fn(s : &String, word : &String, from : usize) -> Option(usize))({
  sb := s.clone();
  wb := word.clone();
  n := sb.len();
  m := wb.len();
  if((m == usize(0)) || (n < m), {
    return(Option(usize).None);
  });
  (mut(i) : usize) = from;
  while((i + m) <= n, {
    (mut(j) : usize) = usize(0);
    (mut(hit) : bool) = true;
    while((j < m) && hit, {
      a := match(sb.get_byte(i + j), .Some(x) => x, .None => u8(0));
      b := match(wb.get_byte(j), .Some(x) => x, .None => u8(1));
      if(!(a == b), {
        hit = false;
      });
      j = (j + usize(1));
    });
    if(hit, {
      return(Option(usize).Some(i));
    });
    i = (i + usize(1));
  });
  Option(usize).None
});
/// Whether `s` contains "return" as a whole word (like a `\breturn\b`
/// regex — avoids matching identifiers like `return_flag`).
_contains_word_return :: (fn(s : &String) -> bool)({
  word := String.from("return");
  wlen := usize(6);
  // BYTE length + byte-based find — see _byte_index_of.
  slen := s.len();
  (mut(from) : usize) = usize(0);
  while(true, {
    match(
      _byte_index_of(s, word.clone(), from),
      .Some(idx) => {
        before_ok := if(idx == usize(0), true, !_is_word_byte(s.byte_at(idx - usize(1))));
        after_idx := (idx + wlen);
        after_ok := if(after_idx >= slen, true, !_is_word_byte(s.byte_at(after_idx)));
        if(before_ok && after_ok && !_inside_c_string_literal(s, idx), {
          return(true);
        }, {
          from = (idx + usize(1));
        });
      },
      .None => {
        return(false);
      }
    );
  });
  false
});
/// Args of a FnCall (empty for an Atom).
_arg_args :: (fn(e : &AstExpr) -> ArrayList(AstExpr))(
  match(e, Rc(.FnCall(_, _, Rc(a), _, _)) => a.clone(), Rc(.Atom(_, _)) => ArrayList(AstExpr).new())
);
/// The compile-time boolean value of `e`, if it has one.
_cond_bool :: (fn(e : &AstExpr, context : &FunctionGenerationContext) -> Option(bool))(
  match(
    context.base.get_expr_info(e),
    .Some(ei) => match(ei.value(), .Some(v) => match(v, Rc(.BoolVal(b)) => Option(bool).Some(b), _ => Option(bool).None), .None => Option(bool).None),
    .None => Option(bool).None
  )
);
/// Wrap `code` in `&(...)` when the enclosing function returns `-> &mut T` and
/// this arm value is not already a pointer.
_maybe_address_of :: (fn(value_expr : &AstExpr, code : String, cond_outer_is_ptr : bool, context : &FunctionGenerationContext) -> String)({
  // A projection-call leaf of a reference-typed chain (R-TAIL) yields the
  // call's own pointer.
  leaf_code := chain_leaf_pointer_code(value_expr, code.clone(), context);
  if(leaf_code != code, {
    return(leaf_code);
  });
  if(!cond_outer_is_ptr, {
    return(code);
  });
  arm_is_ptr := match(context.base.get_expr_info(value_expr), .Some(ei) => is_pointer_type(&ei.ty()), .None => true);
  if(arm_is_ptr, code, {
    mut(out) := String.from("&(");
    out.push_string(&code);
    out.push_str(")");
    out
  })
});
/// Whether the generated arm code is a control-flow statement (continue/break/
/// goto/return) and should be emitted directly rather than assigned.
_is_cf_code :: (fn(value_expr : &AstExpr, code : &String, context : &FunctionGenerationContext) -> bool)(
  (code.* == "continue") || (code.* == "break") || code.starts_with("goto") || ast_expr_is_fn_call_of(value_expr, BK_RETURN, Option(usize).None) || _contains_word_return(code)
);
/// Concatenate `current` then `prev` (both optional) into a fresh drop list.
_concat_drops :: (fn(current : &Option(ArrayList(AstExpr)), prev : &Option(ArrayList(AstExpr))) -> ArrayList(AstExpr))({
  mut(out) := ArrayList(AstExpr).new();
  match(
    current,
    .Some(cd) => {
      n := cd.len();
      (mut(i) : usize) = usize(0);
      while(i < n, {
        match(
          cd.get_cloned(i),
          .Some(e) => {
            out.push(e);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .None => ()
  );
  match(
    prev,
    .Some(pp) => {
      n := pp.len();
      (mut(i) : usize) = usize(0);
      while(i < n, {
        match(
          pp.get_cloned(i),
          .Some(e) => {
            out.push(e);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .None => ()
  );
  out
});
/// Emit the rendered code of a cond arm whose value is not assigned to a
/// result temp (a unit arm, or a cond without one) as a statement. Some
/// generators RETURN their statement instead of emitting it —
/// `c => ___drop(x)` renders `__yo_decr_rc(x)` — and discarding that text
/// lost HashMap._resize's old-slot releases, so every RC key/value leaked one
/// reference per rehash (issues/fixed/cond-unit-arm-statement-is-dropped.md).
/// match.yo's `_emit_case_body_no_break` already does this.
_emit_unassigned_arm_code :: (fn(value : &AstExpr, value_code : &String, indent : &String, context : &mut FunctionGenerationContext) -> unit)({
  // Only a UNIT value is a statement: a non-unit arm in unassigned position
  // renders a pure placeholder (a panicking arm's `(*((void*)NULL))` after
  // its `abort()`), and a bare temp name is a value the arm's own statements
  // already computed.
  is_stmt := match(
    context.base.get_expr_info(value),
    .Some(vei) => (is_unit_type(&vei.ty()) && !is_temp_variable_name(&vei.env().module_path().*, value_code.clone())),
    .None => false
  );
  if((value_code.len() > usize(0)) && is_stmt, {
    mut(line) := indent.clone();
    line.push_string(value_code);
    line.push_str(";");
    context.base.emitter.emit_string_line(&line);
  });
});
/// Emit a non-begin arm value: control-flow statements emit directly, a value
/// is assigned to the cond temp, and an unassigned (unit) arm's rendered
/// statement is emitted as a statement.
_emit_value_arm :: (fn(value : &AstExpr, value_indent : &String, temp_var_opt : &Option(String), is_unit : bool, cond_outer_is_ptr : bool, context : &mut FunctionGenerationContext) -> unit)({
  // The bare arm's scope-end drops ride the value node's list; feed them
  // into the pending path for the arm's generation, as `_emit_begin_arm`
  // does for a block arm, so a short-circuit operand inside the value
  // (`c => assert(c && (f() == "x"), …)`) drops its branch-scoped temps
  // IN the branch (`_emit_drops_for_conditional_branch` scans pending)
  // instead of after the C block closed
  // (issues/fixed/short-circuit-rhs-temp-in-bare-arm-body-drops-out-of-scope.md).
  vei_pending := context.base.get_expr_info(value);
  cur_drops := match(&vei_pending, .Some(vei) => vei.deferred_drop_expressions(), .None => Option(ArrayList(AstExpr)).None);
  cur_consumed := match(vei_pending, .Some(vei) => expr_info_consumed_variable_drop_expressions(&vei), .None => Option(ArrayList(AstExpr)).None);
  prev_pending := replace(&mut context.pending_deferred_drops, Option(ArrayList(AstExpr)).None);
  prev_consumed := replace(&mut context.consumed_var_pending_drops, Option(ArrayList(AstExpr)).None);
  context.pending_deferred_drops = Option(ArrayList(AstExpr)).Some(_concat_drops(&cur_drops, &prev_pending));
  context.consumed_var_pending_drops = Option(ArrayList(AstExpr)).Some(_concat_drops(&cur_consumed, &prev_consumed));
  note_line_position(&mut context.base.emitter, value);
  _emit_value_arm_body(value, value_indent.clone(), temp_var_opt, is_unit, cond_outer_is_ptr, context);
  // A call nested under an operator in the arm value (`c => (f(tmp) > 0)`)
  // records its argument temps' drops on the VALUE node, which no call's
  // post-call flush emits: flush them now that the value is in the cond temp
  // (or ran as a statement). Same class as the condition flush in
  // `_emit_cond_if_head` (issues/fixed/cond-condition-operand-call-temp-is-never-released.md).
  if(has_pending_emittable_drop(value, context), {
    generate_deferred_drop_expressions(value, value_indent, context);
  });
  context.pending_deferred_drops = prev_pending;
  context.consumed_var_pending_drops = prev_consumed;
});
/// Whether the cond's result temp is a C variable declared in a C block that
/// is still open (`scope_stack_contains`). The function-wide
/// `declared_c_var_names` set is monotonic: a fused await site of a wrapper
/// awaited twice re-emits the wrapper's body in a second block, where the
/// first block's declaration of the same name no longer counts
/// (issues/fixed/2026-10-22-a-dup-temp-in-a-wrapper-awaited-twice-is-undeclared-at-the-second-site.md).
_temp_is_declared :: (fn(temp_var_opt : &Option(String), context : &FunctionGenerationContext) -> bool)(
  match(temp_var_opt, .Some(tv) => context.base.declared_scopes.*.with({ tv : &tv.* }(ds_s) => scope_stack_contains(ds_s, tv)), .None => false)
);
_emit_value_arm_body :: (fn(value : &AstExpr, value_indent : &String, temp_var_opt : &Option(String), is_unit : bool, cond_outer_is_ptr : bool, context : &mut FunctionGenerationContext) -> unit)({
  value_code := _call_generate_expr(value, value_indent.clone(), context);
  if(_is_cf_code(value, value_code.clone(), context), {
    mut(line) := value_indent.clone();
    line.push_string(value_code.clone());
    line.push_str(";");
    context.base.emitter.emit_string_line(&line);
  }, if(value_code.len() == usize(0), (), {
    assigned := match(
      temp_var_opt,
      .Some(tv) => if(!is_unit, {
        mut(line) := value_indent.clone();
        line.push_string(tv.clone());
        line.push_str(" = ");
        line.push_string(_maybe_address_of(value, value_code.clone(), cond_outer_is_ptr, context));
        line.push_str(";");
        context.base.emitter.emit_string_line(&line);
        true
      }, false),
      .None => false
    );
    if(!assigned, _emit_unassigned_arm_code(value, value_code.clone(), value_indent.clone(), context));
  }));
});
/// Inline a `begin` block arm: emit each statement (stopping at control flow),
/// then assign the final expression to the cond temp (or emit it if it is a
/// control-flow statement). Concatenates the block's deferred drops onto the
/// pending set (for early-return handling) and restores on exit.
_emit_begin_arm :: (fn(value : &AstExpr, value_indent : &String, temp_var_opt : &Option(String), is_unit : bool, cond_outer_is_ptr : bool, context : &mut FunctionGenerationContext) -> unit)({
  begin_args := _arg_args(value);
  vei_opt := context.base.get_expr_info(value);
  cur_drops := match(&vei_opt, .Some(vei) => vei.deferred_drop_expressions(), .None => Option(ArrayList(AstExpr)).None);
  cur_consumed := match(vei_opt, .Some(vei) => expr_info_consumed_variable_drop_expressions(&vei), .None => Option(ArrayList(AstExpr)).None);
  prev_pending := replace(&mut context.pending_deferred_drops, Option(ArrayList(AstExpr)).None);
  prev_consumed := replace(&mut context.consumed_var_pending_drops, Option(ArrayList(AstExpr)).None);
  context.pending_deferred_drops = Option(ArrayList(AstExpr)).Some(_concat_drops(&cur_drops, &prev_pending));
  context.consumed_var_pending_drops = Option(ArrayList(AstExpr)).Some(_concat_drops(&cur_consumed, &prev_consumed));
  n := begin_args.len();
  if(n > usize(0), {
    // All statements except the last.
    (mut(j) : usize) = usize(0);
    (mut(stop) : bool) = false;
    while((j < (n - usize(1))) && !stop, {
      match(
        begin_args.get_cloned(j),
        .Some(barg) => match(
          context.base.get_expr_info(&barg),
          .Some(bei) => {
            note_line_position(&mut context.base.emitter, &barg);
            arg_code := _call_generate_expr(&barg, value_indent.clone(), context);
            if((arg_code.len() > usize(0)) && !is_temp_variable_name(&bei.env().module_path().*, arg_code.clone()), {
              mut(line) := value_indent.clone();
              line.push_string(&arg_code);
              line.push_str(";");
              context.base.emitter.emit_string_line(&line);
            });
            // A non-final statement's LENT temporaries drop here, at the
            // statement's end (the final expression's drop at the arm's end
            // IS its statement end).
            nxt := begin_args.get_cloned(j + usize(1));
            _flush_stmt_lent_temp_drops(&barg, &nxt, &cur_drops, &bei, &value_indent.*, context);
            if(has_any_control_flow(bei.control_flow()), {
              stop = true;
            });
          },
          .None => ()
        ),
        .None => ()
      );
      j = (j + usize(1));
    });
    // Final expression → cond temp (or emit directly if control flow).
    match(
      begin_args.get_cloned(n - usize(1)),
      .Some(final_expr) => match(
        context.base.get_expr_info(&final_expr),
        .Some(fei) => {
          note_line_position(&mut context.base.emitter, &final_expr);
          final_code := _call_generate_expr(&final_expr, value_indent.clone(), context);
          if(
            final_code.len() > usize(0),
            if(_is_cf_code(&final_expr, final_code.clone(), context), {
              mut(line) := value_indent.clone();
              line.push_string(final_code.clone());
              line.push_str(";");
              context.base.emitter.emit_string_line(&line);
            }, match(
              temp_var_opt,
              .Some(tv) => if(!is_unit, {
                mut(line) := value_indent.clone();
                line.push_string(tv.clone());
                line.push_str(" = ");
                line.push_string(_maybe_address_of(&final_expr, final_code.clone(), cond_outer_is_ptr, context));
                line.push_str(";");
                context.base.emitter.emit_string_line(&line);
              }),
              .None => ()
            ))
          );
        },
        .None => ()
      ),
      .None => ()
    );
  });
  // Emit the arm begin-block's own scope-end drops at its NORMAL completion
  // (fall-through; `generate_deferred_drop_expressions(value, ...)`). Without this, an owning
  // local declared inside a `cond`/`if` arm (e.g. `bucket := (data_ptr &+ i).*`
  // in HashMap._find_bucket) was pushed onto pending_deferred_drops (for nested
  // early returns) but NEVER dropped on the arm's fall-through path, leaking the
  // value-struct's RC field on every non-matching probe. (On an early-return
  // path the return emits it from pending; any emission here after a
  // control-flow tail is unreachable dead code.)
  generate_deferred_drop_expressions(value, value_indent.clone(), context);
  context.pending_deferred_drops = prev_pending;
  context.consumed_var_pending_drops = prev_consumed;
});
/// Emit `if (<condition>) {` for a cond arm. A call nested INSIDE the
/// condition (`!f(tmp)`, `f(tmp) == false`) records its argument temps' drops
/// on the CONDITION node rather than on its own call node, so the call's
/// post-call flush does not emit them, and nothing else did: the temp leaked
/// on every evaluation (`_mg_canon`'s `!p.starts_with(String.from("/"))`
/// leaked a String per call). When such a drop is still pending after the
/// condition renders, materialize the condition into a bool, flush the
/// condition's drops, then branch on the bool
/// (issues/fixed/cond-condition-operand-call-temp-is-never-released.md).
_emit_cond_if_head :: (fn(condition : &AstExpr, indent : &String, context : &mut FunctionGenerationContext) -> unit)({
  cnd_drops := match(context.base.get_expr_info(condition), .Some(cnd_ei) => cnd_ei.deferred_drop_expressions(), .None => Option(ArrayList(AstExpr)).None);
  cnd_prev := replace(&mut context.pending_deferred_drops, Option(ArrayList(AstExpr)).None);
  context.pending_deferred_drops = Option(ArrayList(AstExpr)).Some(_concat_drops(&cnd_drops, &cnd_prev));
  cc := _call_generate_expr(condition, indent.clone(), context);
  context.pending_deferred_drops = cnd_prev;
  if(has_pending_emittable_drop(condition, context), {
    cv := fresh_local_name(String.from("__yo_cond_"), &context.base.current_function_name);
    context.base.emitter.emit_string_line(`${indent.clone()}bool ${cv.clone()} = ${cc};`);
    generate_deferred_drop_expressions(condition, indent.clone(), context);
    context.base.emitter.emit_string_line(`${indent.clone()}if (${cv}) {`);
  }, {
    mut(h) := indent.clone();
    h.push_str("if (");
    h.push_string(&cc);
    h.push_str(") {");
    context.base.emitter.emit_string_line(&h);
  });
});
/// Generate a conditional (`cond`) expression.
generate_cond_expression :: (fn(expr : &AstExpr, indent : &String, context : &mut FunctionGenerationContext) -> String)({
  ei := match(context.base.get_expr_info(expr), .Some(e) => e, .None => return(String.from("/* \"cond\" expression is not evaluated */")));
  value_type := Rc.clone(ei.ty());
  is_unit := is_unit_type(&value_type);
  temp_var_opt := ei.variable_name();
  ret_is_ref := match(&context.current_function_type, .Some(t) => fn_result_is_ref(&t.*), .None => false);

  cond_outer_is_ptr := (ret_is_ref && is_pointer_type(&value_type));
  args := match(expr, Rc(.FnCall(_, _, Rc(a), _, _)) => a.clone(), Rc(.Atom(_, _)) => ArrayList(AstExpr).new());
  nargs := args.len();
  // First pass: index of the first non-(compile-time-false) arm.
  (mut(first_nf) : usize) = nargs;
  (mut(found_nf) : bool) = false;
  (mut(i) : usize) = usize(0);
  while((i < nargs) && !found_nf, {
    match(
      args.get_cloned(i),
      .Some(arg) => if(ast_expr_is_fn_call_of(&arg, "=>", Option(usize).Some(usize(2))), {
        cargs := _arg_args(&arg);
        match(
          cargs.get_cloned(usize(0)),
          .Some(condition) => {
            is_false := match(_cond_bool(&condition, context), .Some(b) => !b, .None => false);
            if(!is_false, {
              first_nf = i;
              found_nf = true;
            });
          },
          .None => ()
        );
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  // Can we collapse to direct value generation (first non-false arm is a
  // compile-time true)?
  (mut(can_opt) : bool) = false;
  if(found_nf, {
    match(
      args.get_cloned(first_nf),
      .Some(first_arg) => if(ast_expr_is_fn_call_of(&first_arg, "=>", Option(usize).Some(usize(2))), {
        fcargs := _arg_args(&first_arg);
        match(
          fcargs.get_cloned(usize(0)),
          .Some(fc) => match(
            _cond_bool(&fc, context),
            .Some(b) => if(b, {
              can_opt = true;
            }),
            .None => ()
          ),
          .None => ()
        );
      }),
      .None => ()
    );
  });
  // Declare the result temp (unless unit, or we are collapsing to direct).
  if(
    !is_unit && !can_opt,
    match(
      &temp_var_opt,
      .Some(tv) => {
        mut(d) := indent.clone();
        d.push_string(get_type_string(&value_type, &mut context.base));
        d.push_str(" ");
        d.push_string(tv.clone());
        d.push_str(";");
        context.base.emitter.emit_string_line(&d);
        // Register the declaration: the deferred-drop pass skips a temp it
        // never saw declared, and this raw declaration bypasses
        // get_variable_type_string's recording — so the evaluator's
        // scope-end `___drop` of the result was silently dropped and a
        // match/cond passed as a call argument leaked its value
        // (issues/fixed/match-or-cond-call-argument-result-is-never-released.md).
        declare_c_var_name(&context.base, tv.clone());
      },
      .None => ()
    )
  );
  // Direct value generation.
  if(can_opt && found_nf, {
    match(
      args.get_cloned(first_nf),
      .Some(arg) => if(ast_expr_is_fn_call_of(&arg, "=>", Option(usize).Some(usize(2))), {
        vargs := _arg_args(&arg);
        match(
          vargs.get_cloned(usize(1)),
          .Some(value) => {
            value_code := _call_generate_expr(&value, indent.clone(), context);
            // A control-flow arm value must be EMITTED even when the cond is
            // UNIT-typed (or has no result temp): generate_return has already
            // emitted the early-return DROP PREAMBLE as an emitter side
            // effect, so discarding the returned "return" string here leaves
            // drops-without-return — execution falls through and the scope-end
            // drops release the same RC locals AGAIN (double-decr → panic;
            // the tests/sync/atomic wasi trap: `if(arch == Arch.Wasm32,
            // return(()))` folds true only on wasm32, so the loss was
            // invisible on every native leg).
            // A non-control-flow unit arm whose generator returned its
            // statement text goes through the same helper as the chain path.
            cf_unit := (_is_cf_code(&value, value_code.clone(), context) && (value_code.len() > usize(0)));
            if(
              is_unit || temp_var_opt.is_none(),
              if(cf_unit, {
                mut(cf_line) := indent.clone();
                cf_line.push_string(value_code.clone());
                cf_line.push_str(";");
                context.base.emitter.emit_string_line(&cf_line);
              }, _emit_unassigned_arm_code(&value, value_code.clone(), indent.clone(), context))
            );
            match(
              &temp_var_opt,
              .Some(tv) => if(!is_unit, {
                is_cf := _is_cf_code(&value, value_code.clone(), context);
                if((value_code.len() > usize(0)) && !is_cf, {
                  mut(line) := indent.clone();
                  // The collapse-to-direct path skips this cond's own temp
                  // declaration because the evaluator ADOPTS the arm body's
                  // temp: normally
                  // `tv == value_code` and this line is a self-assign of a
                  // temp the body's own emitter declared (a bare
                  // self-assign). But the shared-id
                  // begin finale re-mints the wrapped node's temp AFTER the
                  // adoption (begin.yo:1323-1325 stamps a fresh out_info +
                  // attach on the SHARED node, not a separate begin
                  // wrapper), so `tv` can be a name NO emitter
                  // declares while the body's value sits in `value_code`.
                  // Recover locally: emit a typed declaration-assignment for
                  // that case only. (An eval-side variable_name carry was
                  // tried first and REVERTED — it perturbed var bookkeeping
                  // enough to break the stage2≡stage3 fixpoint. See
                  // issues/retired/yo-self-round7-tail.md, cache.test.yo.)
                  if(!(value_code == tv.*), {
                    line.push_string(get_type_string(&value_type, &mut context.base));
                    line.push_str(" ");
                    declare_c_var_name(&context.base, tv.clone());
                  });
                  line.push_string(tv.clone());
                  line.push_str(" = ");
                  line.push_string(value_code.clone());
                  line.push_str(";");
                  context.base.emitter.emit_string_line(&line);
                }, if((value_code.len() > usize(0)) && is_cf, {
                  mut(line) := indent.clone();
                  line.push_string(value_code.clone());
                  line.push_str(";");
                  context.base.emitter.emit_string_line(&line);
                  // The cond still names `tv` as its value, and a reader after
                  // the control flow (a function body's tail,
                  // `(fn(q : &R) -> R)(cond(true => return(q)))`) reads it in
                  // unreachable code: declare it, as the if/else chain does,
                  // or the C names an undeclared identifier.
                  tv_c_type := get_type_string(&value_type, &mut context.base);
                  if(!_temp_is_declared(&temp_var_opt, context) && !(tv_c_type == "void"), {
                    context.base.emitter.emit_string_line(`${indent.clone()}${tv_c_type} ${tv.clone()};`);
                    declare_c_var_name(&context.base, tv.clone());
                    // The emitter's scope tracker records only initialized
                    // declarations (`T x = ...;`).
                    push_declared_scope(&context.base, tv.clone());
                  });
                }));
              }),
              .None => ()
            );
          },
          .None => ()
        );
      }),
      .None => ()
    );
    // The collapsed arm's value node drops (see `_emit_value_arm`).
    match(
      args.get_cloned(first_nf),
      .Some(arg) => match(
        _arg_args(&arg).get_cloned(usize(1)),
        .Some(cv) => if(has_pending_emittable_drop(&cv, context), {
          generate_deferred_drop_expressions(&cv, indent.clone(), context);
        }),
        .None => ()
      ),
      .None => ()
    );
    return(if(is_unit, String.from(""), match(temp_var_opt, .Some(tv) => tv, .None => String.from(""))));
  });
  // Full if/else chain.
  (mut(current_indent) : String) = indent.clone();
  (mut(else_depth) : usize) = usize(0);
  (mut(has_emitted) : bool) = false;
  // A comptime-TRUE condition in a non-first arm is the chain's final `else`:
  // every arm after it is unreachable and must NOT be emitted — the arm is
  // written as a bare `else { … }` (no `if`), so a following arm's `else {`
  // would have no `if` to attach to ("expected expression" at the `else`).
  // Reached by `cond(<runtime> => a, sizeof(T) == usize(0) => b, true => c)`
  // specialized at a zero-sized T (std/collections/array-list.yo). The
  // first-arm case never gets here: `can_opt` collapses it to direct emission.
  (mut(ct_true_emitted) : bool) = false;
  (mut(i2) : usize) = usize(0);
  while((i2 < nargs) && !ct_true_emitted, {
    match(
      args.get_cloned(i2),
      .Some(arg) => if(ast_expr_is_fn_call_of(&arg, "=>", Option(usize).Some(usize(2))), {
        pargs := _arg_args(&arg);
        match(
          pargs.get_cloned(usize(0)),
          .Some(condition) => match(
            pargs.get_cloned(usize(1)),
            .Some(value) => {
              cbool := _cond_bool(&condition, context);
              is_false := match(cbool, .Some(b) => !b, .None => false);
              if(!is_false, {
                is_ct_true := match(cbool, .Some(b) => b, .None => false);
                if(!has_emitted, {
                  if(is_ct_true, {
                    mut(h) := current_indent.clone();
                    h.push_str("{");
                    context.base.emitter.emit_string_line(&h);
                  }, {
                    // The condition is a single-expr
                    // begin whose node the evaluator REUSES (it is not
                    // cloned into a separate begin node, so no begin
                    // codegen pushes its
                    // deferred drops into pending before the body
                    // generates). Push them here so a short-circuit branch
                    // inside the condition can flush a branch-scoped temp's
                    // drop IN-branch (emitDropsForConditionalBranch) instead
                    // of the call-site flush emitting it after the branch's
                    // C scope closed ("use of undeclared identifier").
                    _emit_cond_if_head(&condition, current_indent.clone(), context);
                  });
                  has_emitted = true;
                }, {
                  mut(eh) := current_indent.clone();
                  eh.push_str("else {");
                  context.base.emitter.emit_string_line(&eh);
                  else_depth = (else_depth + usize(1));
                  current_indent.push_str("  ");
                  if(!is_ct_true, {
                    // Same pending window and condition flush as the first-condition site.
                    _emit_cond_if_head(&condition, current_indent.clone(), context);
                  });
                });
                value_indent := if(has_emitted && is_ct_true, current_indent.clone(), {
                  mut(vi) := current_indent.clone();
                  vi.push_str("  ");
                  vi
                });
                if(ast_expr_is_fn_call_of(&value, BK_BEGIN, Option(usize).None), {
                  _emit_begin_arm(&value, value_indent.clone(), &temp_var_opt, is_unit, cond_outer_is_ptr, context);
                }, {
                  _emit_value_arm(&value, value_indent.clone(), &temp_var_opt, is_unit, cond_outer_is_ptr, context);
                });
                if(!(has_emitted && is_ct_true), {
                  mut(cl) := current_indent.clone();
                  cl.push_str("}");
                  context.base.emitter.emit_string_line(&cl);
                });
                if(is_ct_true, {
                  ct_true_emitted = true;
                });
              });
            },
            .None => ()
          ),
          .None => ()
        );
      }),
      .None => ()
    );
    i2 = (i2 + usize(1));
  });
  // Close the else blocks.
  (mut(c) : usize) = usize(0);
  while(c < else_depth, {
    current_indent = current_indent.substring(usize(0), current_indent.len() - usize(2));
    mut(cl) := current_indent.clone();
    cl.push_str("}");
    context.base.emitter.emit_string_line(&cl);
    c = (c + usize(1));
  });
  // The result temp was declared bare above and is assigned in the branches;
  // now that they are closed, register it in the block-scope stack so a later
  // explicit `return` / escape releases it (see generate_match_expression).
  if(
    !is_unit && !can_opt,
    match(
      &temp_var_opt,
      .Some(tv) => {
        context.base.emitter.mark_declared_in_scope(tv.clone());
      },
      .None => ()
    )
  );
  if(is_unit, String.from(""), match(temp_var_opt, .Some(tv) => tv, .None => String.from("")))
});
export(generate_cond_expression);
