//! `consume(...)` emitter.
{ String } :: import("std/string");
{ AstExpr, ast_expr_is_fn_call_of, BK_ASSIGN } :: import("../../expr.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ codegen_fatal_expr } :: import("../constants.yo");
/// `consume(x)` — emits the argument as-is. consume does NOT drop the old
/// value (that is the point: take the location without cleanup). A consumed
/// ASSIGNMENT saves its old value by bytes, because its destination is
/// usually uninitialized (`consume_assignment_saves_by_bytes`).
generate_consume :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)(
  match(
    expr,
    .FnCall(_, _, args, _, _) => match(
      args.get(usize(0)),
      .Some(arg) => {
        context.consume_assignment_saves_by_bytes = ast_expr_is_fn_call_of(arg, BK_ASSIGN, Option(usize).Some(usize(2)));
        out := _call_generate_expr(arg, indent, context);
        context.consume_assignment_saves_by_bytes = false;
        out
      },
      .None => codegen_fatal_expr(String.from("consume requires exactly 1 argument"))
    ),
    .Atom(_, _) => codegen_fatal_expr(String.from("consume requires a call expression"))
  )
);
export(generate_consume);
