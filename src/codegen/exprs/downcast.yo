//! `downcast(dyn_value, T)` emitter — mirrors `src/codegen/exprs/downcast.ts`.
//!
//! Safe downcast returning `Option(T)`. Dyn only wraps object types, so the
//! result is an owned RC reference (we dup, since the Dyn also holds one). The
//! is-check compares the Dyn's vtable type-id against a per-target static whose
//! address is the canonical type id. If `Option` is nullable-pointer-optimized,
//! emits `(check) ? cast : NULL`; otherwise the full tagged-union Some/None.
//!
//! Three target shapes, all live:
//!
//! - a REFERENCE-struct target IS the object pointer — cast + `__yo_incr_rc`;
//! - a VALUE/newtype target was auto-boxed at `dyn()` creation — read the value
//!   out of the Box found in `dyn_impls` (`wasBoxed`, downcast.ts:111-150; the
//!   old note calling this branch unreachable predates
//!   `issues/fixed/yo-self-downcast-value-type.md`);
//! - a VALUE target with NO `dyn_impls` entry for this (Dyn, target) pair — no
//!   vtable in the program carries its type id, so the is-check can never hold
//!   and the whole downcast is a constant `.None`
//!   (`issues/fixed/downcast-to-a-never-dyned-value-type-emits-invalid-c.md`).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr } :: import("../../expr.yo");
{ EvalValue } :: import("../../value.yo");
{ is_dyn_type, is_enum_type, is_reference_struct_type } :: import("../../types/guards.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ type_key, get_type_string, sanitize_for_c_identifier, get_enum_variant_c_name, can_optimize_as_nullable_pointer, get_runtime_struct_fields } :: import("../utils/index.yo");
{ get_dup_function_for_type, generate_dup_code_for_value } :: import("./drop_dup.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{ random_id } :: import("../../utils.yo");
{ resolve_some_type_to_concrete } :: import("./closures.yo");
{ TypeValue } :: import("../../types/definitions.yo");
/// Generate code for `downcast(dyn_value, T)`. Mirrors `generateDowncast`.
generate_downcast :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)({
  ei := match(context.base.get_expr_info(expr), .Some(e) => e, .None => return(String.from("/* ERROR: downcast not evaluated */")));
  args := match(expr, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  dyn_arg := match(args.get(usize(0)), .Some(x) => x, .None => return(String.from("/* ERROR: downcast requires 2 arguments */")));
  type_arg := match(args.get(usize(1)), .Some(x) => x, .None => return(String.from("/* ERROR: downcast requires 2 arguments */")));
  // First argument: the dyn value (runtime).
  dyn_ei := match(context.base.get_expr_info(dyn_arg), .Some(e) => e, .None => return(String.from("/* ERROR: downcast dyn arg not evaluated */")));
  if(!is_dyn_type(dyn_ei.ty), {
    return(String.from("/* ERROR: downcast expected Dyn type as first argument */"));
  });
  dyn_code := _call_generate_expr(dyn_arg, indent.clone(), context);
  // Second argument: the target type T (comptime).
  target_type := match(context.base.get_expr_info(type_arg), .Some(tei) => match(tei.value, .Some(v) => match(v, .TypeVal(t) => t, _ => return(String.from("/* ERROR: downcast expected TypeValue as second argument */"))), .None => return(String.from("/* ERROR: downcast expected TypeValue as second argument */"))), .None => return(String.from("/* ERROR: downcast type arg not evaluated */")));
  target_type_c_name := get_type_string(target_type, context.base);
  // Register the typeid static for the target type (address = canonical id).
  type_id := type_key(target_type);
  type_id_c_name := match(context.base.get_type_c_name(type_id.clone()), .Some(cn) => cn, .None => target_type_c_name.clone());
  static_var_name := String.from("__yo_typeid_");
  static_var_name.push_string(sanitize_for_c_identifier(type_id_c_name, false));
  if(!context.base.type_id_static_names.contains(static_var_name.clone()), {
    _n := context.base.type_id_static_names.insert(static_var_name.clone());
    _r := context.base.type_id_statics.insert(type_id.clone(), static_var_name.clone());
    context.base.emit_typeid_static(static_var_name.clone(), String.new());
  });
  context.base.add_c_include(String.from("<stdint.h>"));
  // is-check: the Dyn's vtable type-id equals this target's static address.
  is_check := dyn_code.clone();
  is_check.push_str(".vtable->__yo_type_id == (uintptr_t)&");
  is_check.push_string(static_var_name);
  em := context.base.emitter;
  // What the result ternary tests. Normally the inline is-check; the
  // structural-dup path below replaces it with a hoisted flag variable so the
  // dup can be emitted as STATEMENTS behind the same guard.
  (cond_expr : String) = is_check.clone();
  // Extraction. A REFERENCE-struct target is stored directly as the object
  // pointer — cast + incr_rc (the Dyn also holds a reference). A VALUE/newtype
  // target (e.g. `String`, a value enum) is BOXED at dyn creation:
  // `dyn.data` points to a Box struct `{ header; <value> }` (a ref struct), so
  // casting the pointer straight to the value STRUCT is invalid C
  // ("used type … where arithmetic or pointer type is required"). Extract the
  // boxed value via the Box's value field and dup it (the Box keeps its copy).
  // Mirrors TS's `wasBoxed` branch (downcast.ts:111-150); yo-self DOES box value
  // types into dyns (the dyn_impl records concrete=<value>, data=Box(<value>)),
  // so the branch the file header called "unreachable" is in fact the live path
  // for a value target. See issues/fixed/yo-self-downcast-value-type.md.
  // `dyn_impls` is the WHOLE-PROGRAM registry of `dyn()` creation sites, filled
  // by the collection pass (`collect_required_functions`) long before any body
  // is emitted. When it holds no entry for this (Dyn, target) pair, no vtable
  // carrying `&__yo_typeid_<target>` is ever built, so the is-check below can
  // never be true — the downcast is statically `.None`. Flagged here and
  // lowered as a constant `.None` (the object cast a value target would
  // otherwise get is not even valid C).
  (statically_impossible : bool) = false;
  cast_expr := if(is_reference_struct_type(target_type), {
    o := String.from("((");
    o.push_string(target_type_c_name.clone());
    o.push_str(")__yo_incr_rc((void*)");
    o.push_string(dyn_code.clone());
    o.push_str(".data))");
    o
  }, {
    // Value/newtype target: find the Box in the dyn_impls (same dyn, concrete ==
    // target), then extract `((Box*)data)->valueField`.
    tkey := type_key(target_type);
    dyn_tkey := type_key(dyn_ei.ty);
    (box_opt : Option(TypeValue)) = Option(TypeValue).None;
    it := context.base.dyn_impls.keys();
    (scan_done : bool) = false;
    while(!scan_done, {
      match(
        it.next(),
        .Some(dk) => match(
          context.base.dyn_impls.get(dk.clone()),
          // The entry's concrete is resolved through the SomeType cell before
          // keying — exactly like `generate_dyn_box_types` — so an entry whose
          // concrete IS this target but was recorded as an unresolved SomeT
          // still matches. Without that, the miss below would report "never
          // dyn'd" for a type that is.
          .Some(de) => if((type_key(de.dyn_type) == dyn_tkey) && (type_key(resolve_some_type_to_concrete(de.concrete_type)) == tkey), {
            box_opt = Option(TypeValue).Some(de.data_type);
            scan_done = true;
          }),
          .None => ()
        ),
        .None => {
          scan_done = true;
        }
      );
    });
    match(
      box_opt,
      .Some(box_ty) => {
        box_cname := get_type_string(box_ty, context.base);
        box_fields := get_runtime_struct_fields(box_ty);
        field_c := match(box_fields.get(usize(0)), .Some(f) => sanitize_for_c_identifier(f.label, false), .None => String.from("_u42_"));
        extract := String.from("((");
        extract.push_string(box_cname);
        extract.push_str(")");
        extract.push_string(dyn_code.clone());
        extract.push_str(".data)->");
        extract.push_string(field_c);
        // Dup the extracted value (the Box retains its copy).
        match(
          get_dup_function_for_type(target_type, context),
          .Some(dupfn) => {
            d := dupfn.clone();
            d.push_str("(");
            d.push_string(extract);
            d.push_str(")");
            d
          },
          // No USER `___dup` method — and most types have none: `String` (a
          // newtype over `Option(ArrayList(u8))`), a value enum with RC
          // payloads and a value struct with RC fields are all dup'd
          // STRUCTURALLY. The old `.None => extract` fallback handed out an
          // UN-dup'd copy of a value the Box still owns, so the caller's
          // scope-end drop and the Box's dispose released the same allocation
          // — a heap-use-after-free the moment the boxed value's refcount
          // became exact (it was masked while `box` leaked a reference; see
          // issues/fixed/dyn-box-dispose-is-emitted-with-an-empty-body.md).
          //
          // `generate_dup_code_for_value` emits its lines through the emitter
          // and a C ternary cannot hold statements, so hoist a guarded block.
          // The extraction MUST stay behind the type-id check: reading the
          // box's value field when the dyn holds a DIFFERENT type reads
          // foreign memory (a smaller box would be read past its end).
          .None => cond(
            !type_contains_rc_type(target_type) => extract,
            true => {
              uid := random_id(String.from(""));
              ok_var := `__yo_dc_ok_${uid}`;
              val_var := `__yo_dc_val_${uid}`;
              em.emit_string_line(`${indent.clone()}int ${ok_var} = (${is_check.clone()}) ? 1 : 0;`);
              em.emit_string_line(`${indent.clone()}${target_type_c_name.clone()} ${val_var} = (${target_type_c_name.clone()}){0};`);
              em.emit_string_line(`${indent.clone()}if (${ok_var}) {`);
              em.emit_string_line(`${indent.clone()}  ${val_var} = ${extract};`);
              dup_code := generate_dup_code_for_value(val_var.clone(), target_type, context);
              // The nullable-pointer and no-RC arms emit their own statement
              // (or nothing) and hand the value straight back; only a real
              // dup EXPRESSION needs assigning.
              if((dup_code.len() > usize(0)) && !(dup_code == val_var), {
                em.emit_string_line(`${indent.clone()}  ${val_var} = ${dup_code};`);
              });
              em.emit_string_line(`${indent.clone()}}`);
              cond_expr = ok_var.clone();
              val_var
            }
          )
        )
      },
      .None => {
        // No entry: nothing in this program boxes `target_type` into this Dyn.
        // The is-check can never hold, so there is no value to extract — the
        // whole downcast lowers to a constant `.None` below.
        statically_impossible = true;
        String.new()
      }
    )
  });
  // Result Option type.
  option_type := ei.ty;
  if(!is_enum_type(option_type), {
    return(String.from("/* ERROR: downcast expected Option enum as result type */"));
  });
  // Statically-`.None` lowering. The operand still has to be EVALUATED — it can
  // be an arbitrary expression whose side effects (and whose emitted temp) the
  // program depends on — so it is spliced as the discarded left operand of a
  // comma expression. `(void)` on a struct-typed operand is explicitly legal
  // (C11 6.5.4p2 exempts a void type name from the scalar-operand constraint).
  if(statically_impossible, {
    none_out := String.from("(/* never dyn'd: ");
    none_out.push_string(target_type_c_name.clone());
    none_out.push_str(" */ (void)(");
    none_out.push_string(dyn_code.clone());
    none_out.push_str("), ");
    none_out.push_string(
      match(
        can_optimize_as_nullable_pointer(option_type),
        .Some(_) => String.from("NULL"),
        .None => {
          o := String.from("(");
          o.push_string(get_type_string(option_type, context.base));
          o.push_str("){ .tag = ");
          o.push_string(get_enum_variant_c_name(option_type, String.from("None"), context.base));
          o.push_str(" }");
          o
        }
      )
    );
    none_out.push_str(")");
    return(none_out);
  });
  match(
    can_optimize_as_nullable_pointer(option_type),
    .Some(_) => {
      out := String.from("((");
      out.push_string(cond_expr.clone());
      out.push_str(") ? ");
      out.push_string(cast_expr);
      out.push_str(" : NULL)");
      out
    },
    .None => {
      option_c_name := get_type_string(option_type, context.base);
      some_tag := get_enum_variant_c_name(option_type, String.from("Some"), context.base);
      none_tag := get_enum_variant_c_name(option_type, String.from("None"), context.base);
      out := String.from("((");
      out.push_string(cond_expr.clone());
      out.push_str(") ? (");
      out.push_string(option_c_name.clone());
      out.push_str("){ .tag = ");
      out.push_string(some_tag);
      out.push_str(", .data = { .Some = { .value = ");
      out.push_string(cast_expr);
      out.push_str(" } } } : (");
      out.push_string(option_c_name);
      out.push_str("){ .tag = ");
      out.push_string(none_tag);
      out.push_str(" })");
      out
    }
  )
});
export(generate_downcast);
