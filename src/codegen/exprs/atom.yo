//! Atom expression emission (`generate_atom`).
//!
//! Handles control-flow keywords
//! (continue/break/return) with loop-body drop emission, unit, comptime-only
//! constant inlining, closure-captured access, and variable-name resolution.
//!
//! Gated branches (documented):
//!   * Async/effect state-machine variable resolution (the `sm->var_<id>` /
//!     `sm->__capture` block, and the async-completion `return`) — Phase 5;
//!     gated by `in_async_state_machine` (false for the corpus) and replaced
//!     with a phase-marker panic.
//!   * `inout(name) : T` params and `inout(name) := place` locals read as
//!     `(*name)` (`_var_read_code`, keyed on `Variable.is_ref`).
//!   * The `value.type.isClosure` fallback closure-detection (Gap 2: FuncVal
//!     carries no TypeValue) is omitted.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ExprId, ast_expr_token, ast_expr_id } :: import("../../expr.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ generate_comptime_value } :: import("./comptime_value.yo");
{ check_variable_is_closure_captured } :: import("./closures.yo");
{
  get_variable_name_for_codegen,
  get_variable_name_for_codegen_at,
  get_deferred_drop_target_atom_name,
  scope_stack_contains,
  get_type_string,
  sanitize_for_c_identifier,
  fresh_local_name
} :: import("../utils/index.yo");
{ deferred_drop_target_variable, _codegen_name_of_variables } :: import("../utils/index.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{ sm_local_field_name, sm_storage_id, sm_slot_of, sm_slot_of_variable, sm_move_flag_of } :: import("../async/state_machine_naming.yo");
{ Environment, get_variables_from_env, Variable } :: import("../../env.yo");
{ is_unit_type } :: import("../../types/guards.yo");
{ expr_info_converted_runtime_type, scope_variables, scope_release_mode, scope_release_note_mismatch } :: import("../../expr_info.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ extract_future_trait_from_type } :: import("../../evaluator/trait_checking.yo");
{ emit_async_future_completion } :: import("./async_completion.yo");
{ EvalValue, is_unknown_val } :: import("../../value.yo");
{ panic, assert } :: import("std/assert");
/// A shadowed name (a match-arm binding): its state-machine slot under the
/// single-pass async lowering (`shadow_slots`), else its C local.
_shadowed_name_code :: (fn(var_name : String, context : FunctionGenerationContext) -> String)({
  cname := sanitize_for_c_identifier(var_name, false);
  match(
    match(context.shadow_slots, .Some(m) => m.get(cname.clone()), .None => Option(String).None),
    .Some(field) => `sm->${field}`,
    .None => cname
  )
});
/// Async/effect state-machine variable resolution — the `sm->var_<id>` /
/// `sm->__capture.<name>` mapping. Returns `.None` when the atom is not an
/// SM-resolvable variable (the caller falls through to the regular path).
_generate_sm_atom :: (fn(expr : AstExpr, var_name : String, context : FunctionGenerationContext) -> Option(String))({
  // Locally-shadowed (match-arm destructure) → the local C variable.
  if(match(context.local_shadowed_variables, .Some(s) => s.contains(sanitize_for_c_identifier(var_name.clone(), false)), .None => false), {
    return(Option(String).Some(_shadowed_name_code(var_name.clone(), context)));
  });
  smv := match(context.state_machine_variables, .Some(m) => m, .None => return(Option(String).None));
  ei_opt := context.base.get_expr_info(expr);
  // 1) Env-ID lookup (handles shadowing: same name, different ids).
  match(
    ei_opt,
    .Some(ei) => {
      vars := scope_variables(ast_expr_id(expr), ei.env, var_name.clone());
      if(vars.len() > usize(0), {
        match(
          vars.last(),
          .Some(variable) => {
            // The owner's slot for a local sharing a body local's value, else
            // its own (SSA-renamed ids resolve to the canonical id).
            (var_id : String) = sm_storage_id(variable, smv, context.variable_id_remapping);
            match(
              smv.get(var_id.clone()),
              .Some(cv) => {
                // Phase 1b: aliased to an await_future_N field.
                match(
                  context.state_machine_field_aliases,
                  .Some(aliases) => match(
                    aliases.get(var_id.clone()),
                    .Some(aliased_field) => return(Option(String).Some(`sm->${aliased_field.clone()}`)),
                    .None => ()
                  ),
                  .None => ()
                );
                // Closure-param coordination: prefer a SAME-NAME entry that
                // HAS an alias (the synthetic slot set_effect writes into).
                // Restricted to SYNTHETIC entries (empty decl_site — the
                // closure-param slots this exists for): a same-name entry
                // from a DIFFERENT declaration site is another variable, and
                // redirecting to its alias cross-wired two branch-local `i`s
                // (the bufio slot-alias class).
                match(
                  context.state_machine_field_aliases,
                  .Some(aliases2) => {
                    it := smv.into_iter();
                    (go : bool) = true;
                    while(go, {
                      match(
                        it.next(),
                        .Some(e) => {
                          if(!(e.key == var_id), {
                            if((e.value.base.name == var_name) && (e.value.base.decl_site.len() == usize(0)), {
                              match(
                                aliases2.get(e.key.clone()),
                                .Some(other_alias) => return(Option(String).Some(`sm->${other_alias.clone()}`)),
                                .None => ()
                              );
                            });
                          });
                        },
                        .None => {
                          go = false;
                        }
                      );
                    });
                  },
                  .None => ()
                );
                // Plain SM field: outer → __capture.<name>; local → var_<id>.
                field_name := match(
                  cv.kind,
                  .Outer => `${context.sm_capture_slot}.${sanitize_for_c_identifier(var_name.clone(), false)}`,
                  _ => sm_local_field_name(cv.base.id.to_string())
                );
                return(Option(String).Some(`sm->${field_name.clone()}`));
              },
              .None => ()
            );
          },
          .None => ()
        );
      });
    },
    .None => ()
  );
  // 2) Name-based fallback (no env info / no id match): DECLARATION-SITE
  //    aware. When the env resolved a Variable (so its decl token is known),
  //    a same-name entry must ALSO match the site — same-named DISTINCT
  //    variables (two branch-local `i`s) otherwise cross-resolve: a
  //    re-stamped read of one picked the OTHER's entry, which was
  //    legitimately slot-packed with a live variable (the bufio
  //    "read partial then remaining" wrong-bytes bug). Site-matching pass
  //    first; the name-only pass runs ONLY when no site is known.
  {
    (read_site : Option(String)) = Option(String).None;
    match(
      ei_opt,
      .Some(ei_s) => {
        svars := scope_variables(ast_expr_id(expr), ei_s.env, var_name.clone());
        if(svars.len() > usize(0), {
          match(
            svars.last(),
            .Some(sv) => {
              read_site = Option(String).Some(`${sv.token.module_path}:${sv.token.row.to_string()}:${sv.token.column.to_string()}`);
            },
            .None => ()
          );
        });
      },
      .None => ()
    );
    (fallback_key : String) = String.from("");
    (fallback_found : bool) = false;
    it2 := smv.into_iter();
    (go2 : bool) = true;
    while(go2, {
      match(
        it2.next(),
        .Some(e) => {
          name_hit := (e.value.base.name == var_name);
          site_ok := match(
            read_site,
            .Some(rs) => ((e.value.base.decl_site == rs) || (e.value.base.decl_site.len() == usize(0))),
            .None => true
          );
          if(name_hit && site_ok, {
            match(
              context.state_machine_field_aliases,
              .Some(al) => match(
                al.get(e.key.clone()),
                .Some(af) => return(Option(String).Some(`sm->${af.clone()}`)),
                .None => ()
              ),
              .None => ()
            );
            if(!fallback_found, {
              fallback_key = e.key.clone();
              fallback_found = true;
            });
          });
        },
        .None => {
          go2 = false;
        }
      );
    });
    if(fallback_found, {
      match(
        smv.get(fallback_key.clone()),
        .Some(cv2) => {
          field_name2 := match(
            cv2.kind,
            .Outer => `${context.sm_capture_slot}.${sanitize_for_c_identifier(var_name.clone(), false)}`,
            _ => sm_local_field_name(fallback_key.clone())
          );
          return(Option(String).Some(`sm->${field_name2.clone()}`));
        },
        .None => ()
      );
    });
  };
  // 3) Borrowing variable: the OWNER may be captured instead.
  match(
    ei_opt,
    .Some(ei2) => {
      vars2 := scope_variables(ast_expr_id(expr), ei2.env, var_name.clone());
      if(vars2.len() > usize(0), {
        match(
          vars2.last(),
          .Some(variable2) => match(
            variable2.is_owning_the_same_rc_value_as,
            .Some(owner_box2) => {
              owner_name := owner_box2.*.name.clone();
              owner_id := owner_box2.*.id.to_string();
              it3 := smv.into_iter();
              (go3 : bool) = true;
              while(go3, {
                match(
                  it3.next(),
                  .Some(e3) => {
                    // An owner from outside the body is a capture, not this
                    // local's storage: the local has its own (step 1 or 5).
                    is_outer_owner := match(e3.value.kind, .Outer => true, .Local => false);
                    if(((e3.value.base.name == owner_name) || (e3.key == owner_id)) && !is_outer_owner, {
                      field_name3 := match(
                        e3.value.kind,
                        .Outer => `${context.sm_capture_slot}.${sanitize_for_c_identifier(owner_name.clone(), false)}`,
                        _ => sm_local_field_name(e3.key.clone())
                      );
                      return(Option(String).Some(`sm->${field_name3.clone()}`));
                    });
                  },
                  .None => {
                    go3 = false;
                  }
                );
              });
            },
            .None => ()
          ),
          .None => ()
        );
      });
    },
    .None => ()
  );
  // 4) Closure-captured (closure+effect SM): access through closure_context.
  if(match(context.current_closure_captures, .Some(caps) => caps.contains(var_name.clone()), .None => false)
  && context.current_closure_capture_frame_level.is_some(), {
    cn := get_variable_name_for_codegen_at(ast_expr_id(expr), var_name.clone(), match(ei_opt, .Some(e4) => Option(Environment).Some(e4.env), .None => Option(Environment).None));
    match(
      context.current_closure_capture_type_c_name,
      .Some(ct) => return(Option(String).Some(`((${ct.clone()}*)closure_context)->${cn.clone()}`)),
      .None => return(Option(String).Some(`closure_context->${cn.clone()}`))
    );
  });
  // 5) Local C variable in the resume function: comptime-only constants
  //    inline their value; otherwise the codegen name (an `is_ref` variable
  //    reads as `(*name)` — see `_var_read_code`). The name is the one
  //    `expr` itself binds, so this holds only when `expr` IS the atom: a
  //    capture read on behalf of an `io.async(...)` call would get the call's
  //    own temp.
  is_the_atom := match(expr, .Atom(_, atok) => (atok.value == var_name), _ => false);
  if(!is_the_atom, {
    return(Option(String).None);
  });
  match(
    ei_opt,
    .Some(ei5) => match(
      ei5.variable_name,
      .Some(vn) => {
        is_ct_const := match(
          ei5.value,
          .Some(v) => if(!is_unknown_val(v), {
            vars5 := scope_variables(ast_expr_id(expr), ei5.env, vn.clone());
            n5 := vars5.len();
            cond(
              (n5 == usize(0)) => false,
              true => match(vars5.get(n5 - usize(1)), .Some(lv) => lv.is_compile_time_only, .None => false)
            )
          }, false),
          .None => false
        );
        if(is_ct_const, {
          return(Option(String).Some(generate_comptime_value(match(ei5.value, .Some(v2) => v2, .None => EvalValue.UnitVal), match(expr_info_converted_runtime_type(ei5), .Some(crt) => crt, .None => ei5.ty), context.base)));
        });
        // By the SOURCE TOKEN, as the general path below reads a plain
        // identifier: a bare reference used as a cond/match arm value can
        // carry a spurious temp `variable_name`
        // (issues/fixed/captured-variable-as-a-cond-arm-value-emits-a-bare-identifier.md),
        // and since phase 6 such a local can be a C local of the resume
        // function rather than a field.
        return(Option(String).Some(_var_read_code(ast_expr_id(expr), var_name.clone(), Option(Environment).Some(ei5.env))));
      },
      .None => ()
    ),
    .None => ()
  );
  Option(String).None
});
/// Emit `___drop` lines for the loop-body locals declared since entering the
/// current loop body, before a break/continue exit, filtered by liveness at
/// the exit point.
/// What a break/continue exit's lookup of a pending loop-body drop's target
/// yields. Under the scope-exit release (plans/CODEGEN_MEMORY_REDUCTION.md §6)
/// the exit's recorded env is gone and the drop's own target (through its
/// atom's record) stands in, as at return points (`_cleanup_drop_variables`,
/// return.yo).
_exit_drop_variables :: (fn(exit_expr : AstExpr, env : Environment, var_name : String, drop_expr : AstExpr, context : FunctionGenerationContext) -> ArrayList(Variable))({
  mode := scope_release_mode();
  if(mode == usize(0), {
    return(scope_variables(ast_expr_id(exit_expr), env, var_name));
  });
  rec := ArrayList(Variable).new();
  match(deferred_drop_target_variable(drop_expr, context.base), .Some(tv) => rec.push(tv), .None => ());
  if(mode == usize(1), {
    truth := get_variables_from_env(env, var_name);
    same := match(truth.last(), .Some(x) => match(rec.last(), .Some(y) => (x.id == y.id), .None => false), .None => rec.is_empty());
    if(!same, {
      scope_release_note_mismatch(String.from("exit-drop"));
    });
    return(truth);
  });
  rec
});
_emit_loop_body_drops_before_exit :: (fn(context : FunctionGenerationContext, indent : String, exit_expr : AstExpr) -> unit)(
  match(
    context.pending_deferred_drops,
    .Some(drops) => match(
      context.loop_body_drops_baseline_count,
      .Some(baseline) => {
        total := drops.len();
        emit_count := if(total > baseline, total - baseline, usize(0));
        exit_env_opt := match(context.base.get_expr_info(exit_expr), .Some(ei) => Option(Environment).Some(ei.env), .None => Option(Environment).None);
        (i : usize) = usize(0);
        while(i < emit_count, {
          match(
            drops.get(i),
            .Some(drop_expr) => {
              // Skip a drop whose target C variable is not IN SCOPE at this
              // emission point. `x := match(...)`/`cond(...)` bindings emit
              // their C declaration AFTER the RHS switch, so a `continue`/`break`
              // inside the RHS precedes the declaration — the env-liveness check
              // below (source order) sees the binding as live, but the C var
              // doesn't exist yet → "use of undeclared identifier". Ground truth
              // is the emitter-maintained block-scope stack (declared_scopes):
              // the target's C declaration was emitted AND its enclosing C block
              // is still open. The flat declared_c_var_names set is NOT enough —
              // it is monotonic, so a same-named local declared in an earlier,
              // already-CLOSED sibling loop/arm keeps the name in the set and
              // the drop would reference an out-of-scope identifier (the stage-2
              // self-emit `fp`/`res`/`gt` clang-error class). Safe by
              // construction: a target absent from the stack holds no C value
              // here, so skipping the drop can't double-free or leak. Same
              // signal as `_keep_pending_drop` (return.yo).
              skip := match(
                get_deferred_drop_target_atom_name(drop_expr),
                .Some(var_name) => {
                  exit_vars := match(exit_env_opt, .Some(xe) => Option(ArrayList(Variable)).Some(_exit_drop_variables(exit_expr, xe, var_name.clone(), drop_expr, context)), .None => Option(ArrayList(Variable)).None);
                  c_name := match(exit_vars, .Some(xv) => _codegen_name_of_variables(var_name.clone(), xv), .None => get_variable_name_for_codegen_at(ast_expr_id(exit_expr), var_name.clone(), exit_env_opt));
                  // A local with a task slot is never declared as a C
                  // variable (its binding writes `sm->…`), so the scope stack
                  // cannot vouch for it. The slot always exists and is zero
                  // while it owns nothing, so only the liveness test applies
                  // (issues/fixed/a-break-or-continue-in-an-io-async-loop-never-releases-its-slot-locals.md).
                  in_slot := match(
                    exit_env_opt,
                    .Some(slot_env) => match(
                      context.state_machine_variables,
                      .Some(smv) => (context.in_async_state_machine.is_some() && match(match(exit_vars, .Some(xv) => xv.last(), .None => Option(Variable).None), .Some(slot_v) => sm_slot_of_variable(slot_v, smv, context.variable_id_remapping, context.state_machine_field_aliases).is_some(), .None => sm_slot_of(ast_expr_id(exit_expr), slot_env, var_name.clone(), smv, context.variable_id_remapping, context.state_machine_field_aliases).is_some())),
                      .None => false
                    ),
                    .None => false
                  );
                  (sk : bool) = false;
                  if(!in_slot && !scope_stack_contains(context.base.declared_scopes.*, c_name), {
                    sk = true;
                  }, {
                    // env-liveness: skip drops for variables not yet in
                    // scope/initialized at the exit point (exit env available).
                    sk = match(
                      exit_vars,
                      .Some(vars) => {
                        nv := vars.len();
                        cond(
                          (nv == usize(0)) => true,
                          // not in scope
                          true => match(vars.get(nv - usize(1)), .Some(lv) => lv.initialized_at_token.is_none(), .None => true)
                        )
                      },
                      .None => false
                    );
                  });
                  sk
                },
                .None => false
              );
              if(!skip, {
                drop_code := _call_generate_expr(drop_expr, indent.clone(), context);
                if(drop_code.len() > usize(0), {
                  line := indent.clone();
                  line.push_string(drop_code);
                  line.push_str(";");
                  em := context.base.emitter;
                  em.emit_string_line(line);
                });
              });
            },
            .None => ()
          );
          i = (i + usize(1));
        });
      },
      .None => ()
    ),
    .None => ()
  )
);
// Whether `name` is captured by the closure currently being generated, and so
// must be read through `closure_context` rather than as a plain identifier.
//
// ONE predicate, deliberately. It used to be written out twice — once as the
// guard that decides whether to take the plain-identifier early return, once
// where the `closure_context` access is actually emitted — and the two copies
// keyed on different names, so a variable could be "not captured" for the
// guard and "captured" for the emitter. The guard won, and the closure body
// referenced a variable that does not exist in it.
_is_captured_here :: (fn(key : ExprId, name : String, env_opt : Option(Environment), context : FunctionGenerationContext) -> bool)(
  match(
    context.current_closure_captures,
    .Some(caps) => match(
      context.current_closure_capture_frame_level,
      .Some(level) => (
        caps.contains(name.clone()) &&
          match(env_opt, .Some(e) => check_variable_is_closure_captured(key, name.clone(), e, level), .None => true)
      ),
      .None => false
    ),
    .None => false
  )
);
/// Resolve a plain identifier read to its C code: the variable's C name, wrapped
/// in `(*name)` when the binding is a by-`ref` borrow (`inout(name) : T` param — at
/// the C level `name` is `T*`, so a read dereferences). The deref here means a by-ref RECEIVER passed/used as a value
/// (e.g. `String.from(self)` in str.to_string) reads `(*self)`, not the raw pointer.
_var_read_code :: (fn(key : ExprId, tv : String, env_opt : Option(Environment)) -> String)({
  vn := get_variable_name_for_codegen_at(key, tv.clone(), env_opt);
  is_ref := match(
    env_opt,
    .Some(e) => {
      vs := scope_variables(key, e, tv.clone());
      cond(
        (vs.len() == usize(0)) => false,
        true => match(vs.last(), .Some(v) => v.is_ref, .None => false)
      )
    },
    .None => false
  );
  cond(
    is_ref => {
      o := String.from("(*");
      o.push_string(vn);
      o.push_str(")");
      o
    },
    true => vn
  )
});
/// Generate C for an atom expression (literal / identifier / control-flow
/// keyword).
generate_atom :: (fn(expr : AstExpr, context : FunctionGenerationContext, indent : String) -> String)({
  tok := ast_expr_token(expr);
  tv := tok.value;
  // --- control flow keywords ---
  if(tv == "continue", {
    match(
      context.base.current_continue_label,
      .Some(label) => {
        _emit_loop_body_drops_before_exit(context, indent.clone(), expr);
        out := String.from("goto ");
        out.push_string(label);
        return(out);
      },
      .None => ()
    );
    match(
      context.base.current_loop_label,
      .Some(_) => {
        _emit_loop_body_drops_before_exit(context, indent.clone(), expr);
        return(String.from("continue"));
      },
      .None => ()
    );
    return(String.from("continue"));
  });
  if(tv == "break", {
    match(
      context.base.current_loop_label,
      .Some(loop_label) => {
        _emit_loop_body_drops_before_exit(context, indent.clone(), expr);
        if(context.base.inside_match, {
          out := String.from("goto ");
          out.push_string(loop_label);
          return(out);
        });
        return(String.from("break"));
      },
      .None => ()
    );
    return(String.from("break"));
  });
  if(tv == "return", {
    // Async state machine: early `return` completes the result Future
    // (sm->state = -1 + continuation dispatch) instead of a C return.
    match(
      context.in_async_state_machine,
      .Some(iasm) => {
        em := context.base.emitter;
        child_type := match(
          extract_future_trait_from_type(iasm.future_type),
          .Some(ftt) => match(ftt, .FutureTraitT({ output : o }) => o, _ => t_unit()),
          .None => t_unit()
        );
        is_unit_result := is_unit_type(child_type);
        // Deferred drops on the return expr itself — only those resolving
        // to state-machine fields.
        match(
          context.base.get_expr_info(expr),
          .Some(rei) => match(
            rei.deferred_drop_expressions,
            .Some(dd) => {
              (rdi : usize) = usize(0);
              while(rdi < dd.len(), {
                match(
                  dd.get(rdi),
                  .Some(de) => {
                    dc := _call_generate_expr(de, indent.clone(), context);
                    if((dc.len() > usize(0)) && dc.contains("sm->"), {
                      em.emit_string_line(`${indent.clone()}${dc.clone()};`);
                    });
                  },
                  .None => ()
                );
                rdi = (rdi + usize(1));
              });
            },
            .None => ()
          ),
          .None => ()
        );
        // Pending deferred drops from enclosing scopes (SM fields only).
        match(
          context.pending_deferred_drops,
          .Some(pdd) => if(pdd.len() > usize(0), {
            em.emit_string_line(`${indent.clone()}// Drop local variables before early completion`);
            (pdi : usize) = usize(0);
            while(pdi < pdd.len(), {
              match(
                pdd.get(pdi),
                .Some(pe) => {
                  pc := _call_generate_expr(pe, indent.clone(), context);
                  if((pc.len() > usize(0)) && pc.contains("sm->"), {
                    em.emit_string_line(`${indent.clone()}${pc.clone()};`);
                  });
                },
                .None => ()
              );
              pdi = (pdi + usize(1));
            });
          }),
          .None => ()
        );
        em.emit_string_line(`${indent.clone()}// Early return - complete the result Future`);
        result_code := if(
          !is_unit_result,
          Option(String).Some(`(${get_type_string(child_type, context.base)}){0}`),
          Option(String).None
        );
        emit_async_future_completion(em, indent.clone(), result_code, Option(String).Some(context.base.current_function_name.clone()));
        return(String.from(""));
      },
      .None => ()
    );
    return(String.from("return"));
  });
  // --- boolean literals: emit the C literal, not a sanitized identifier ---
  // `true`/`false` are reserved C words (stdbool), so the general identifier
  // path's `sanitize_for_c_identifier` mangles them to the undeclared
  // `__yo_c_reserved_true`/`_false`. They are valid C bool literals, so emit
  // them verbatim. Surfaced self-compiling src/token.yo (`while(true, …)`).
  if((tv == "true") || (tv == "false"), {
    return(tv);
  });
  // --- unit-typed expression → empty ---
  ei_opt := context.base.get_expr_info(expr);
  match(
    ei_opt,
    .Some(ei) => if(is_unit_type(ei.ty), {
      return(String.from(""));
    }),
    .None => ()
  );
  // --- async/effect SM variable resolution. The
  // effects-state-machine flag is not modeled — async-only until then. ---
  if(context.in_async_state_machine.is_some() && context.state_machine_variables.is_some(), {
    match(
      _generate_sm_atom(expr, tv.clone(), context),
      .Some(sm_out) => {
        code := _sm_consuming_read(expr, tv.clone(), sm_out, context);
        // A by-ref binding (`inout(y) := x`) in a slot holds the pointer; a
        // read or a write through it dereferences it, as `_var_read_code`
        // does for a C local.
        return(if(code.starts_with("sm->") && _is_ref_binding(expr, tv.clone(), context), `(*${code})`, code));
      },
      .None => ()
    );
  });
  // --- variable / comptime-constant / closure-capture ---
  match(
    ei_opt,
    .Some(ei) => {
      env_opt := Option(Environment).Some(ei.env);
      // Locally-shadowed variable (a match-arm destructured field, declared in
      // the arm's C block under its SOURCE name): resolve to that source name,
      // not the evaluator's temp `variable_name` (the destructure bind declares `<T> v = ...`
      // and the body must reference `v`, not the temp). Keyed by the source
      // TOKEN; the matching declaration uses the same sanitized source name.
      if(match(context.local_shadowed_variables, .Some(s) => s.contains(sanitize_for_c_identifier(tv.clone(), false)), .None => false), {
        return(
          match(
            match(context.shadow_slots, .Some(m) => m.get(sanitize_for_c_identifier(tv.clone(), false)), .None => Option(String).None),
            .Some(field) => `sm->${field}`,
            .None => get_variable_name_for_codegen(tv.clone(), Option(Environment).None)
          )
        );
      });
      // variableName path: comptime-only constant inline, else the name.
      match(
        ei.variable_name,
        .Some(var_name) => {
          // Compile-time-only variable with a known value → inline the value.
          is_comptime_const := match(
            env_opt,
            .Some(e) => match(
              ei.value,
              .Some(v) => if(!is_unknown_val(v), {
                vars := scope_variables(ast_expr_id(expr), e, var_name.clone());
                nv := vars.len();
                cond(
                  (nv == usize(0)) => false,
                  true => match(vars.get(nv - usize(1)), .Some(lv) => lv.is_compile_time_only, .None => false)
                )
              }, false),
              .None => false
            ),
            .None => false
          );
          if(is_comptime_const, {
            return(match(ei.value, .Some(v) => generate_comptime_value(v, match(expr_info_converted_runtime_type(ei), .Some(crt) => crt, .None => ei.ty), context.base), .None => String.from("")));
          });
          // Closure-captured variable → access through closure_context.
          //
          // Keyed on the SOURCE TOKEN, through the same predicate the
          // emitting path below uses. This guard used to test
          // `variable_name`, and the two disagreed exactly where the comment
          // below says `variable_name` is untrustworthy: a bare reference used
          // as a cond/match arm value can carry a SPURIOUS temp
          // `variable_name`, which is not in the capture set, so this answered
          // "not captured", took the `_var_read_code` early return, and
          // emitted the BARE identifier inside a closure body — undeclared in
          // the generated C
          // (issues/fixed/captured-variable-as-a-cond-arm-value-emits-a-bare-identifier.md).
          if(!_is_captured_here(ast_expr_id(expr), tv.clone(), env_opt, context), {
            // Resolve a plain identifier by its SOURCE TOKEN, not the recorded
            // `variable_name`: attach_temp_variable_to_expr can
            // stamp a SPURIOUS temp `variable_name` onto a bare reference used as
            // a cond/match arm value (e.g. `(cap == 0) => min_cap`); emitting that
            // temp yields an undeclared identifier. The token resolves via env
            // lookup to the current binding's C name, so SSA/shadowing still work
            // (for a normal reference token == variable_name, so this is a no-op).
            // `_var_read_code` also derefs a by-ref (`inout(...)`) binding to `(*name)`.
            return(_var_read_code(ast_expr_id(expr), tv.clone(), env_opt));
          });
        },
        .None => ()
      );
      // Closure-captured access (the general path); otherwise a literal with a
      // comptime value is inlined, else the bare variable name.
      cap_name := tv.clone();
      is_captured := _is_captured_here(ast_expr_id(expr), cap_name.clone(), env_opt, context);
      cond(
        is_captured => match(
          context.current_closure_capture_type_c_name,
          .Some(cap_ty) => {
            out := String.from("((");
            out.push_string(cap_ty);
            out.push_str("*)closure_context)->");
            out.push_string(get_variable_name_for_codegen_at(ast_expr_id(expr), cap_name.clone(), env_opt));
            out
          },
          .None => {
            out := String.from("closure_context->");
            out.push_string(get_variable_name_for_codegen_at(ast_expr_id(expr), cap_name.clone(), env_opt));
            out
          }
        ),
        // Non-variable atom with a comptime value → inline it. Use the
        // coerced runtime type when present (e.g. a comptime_str arg coerced
        // to `*(char)` must emit a bare C string literal, not a `__yo_str`).
        match(ei.value, .Some(v) => !is_unknown_val(v), .None => false) => match(
          ei.value,
          .Some(v) => generate_comptime_value(v, match(expr_info_converted_runtime_type(ei), .Some(crt) => crt, .None => ei.ty), context.base),
          .None => _var_read_code(ast_expr_id(expr), tv.clone(), env_opt)
        ),
        true => _var_read_code(ast_expr_id(expr), tv.clone(), env_opt)
      )
    },
    .None => get_variable_name_for_codegen(tv.clone(), Option(Environment).None)
  )
});
/// Whether `name` read at `expr` is a by-ref binding (`inout(name) := x`,
/// or an `inout(name) : T` parameter): its C value is a pointer.
_is_ref_binding :: (fn(expr : AstExpr, name : String, context : FunctionGenerationContext) -> bool)(
  match(
    context.base.get_expr_info(expr),
    .Some(ei) => {
      vs := scope_variables(ast_expr_id(expr), ei.env, name);
      cond(
        (vs.len() == usize(0)) => false,
        true => match(vs.get(vs.len() - usize(1)), .Some(v) => v.is_ref, .None => false)
      )
    },
    .None => false
  )
);
/// A read of a state-machine field that MOVES its value out (the evaluator
/// records the move as the variable's `consumed_at_token`): take the value
/// into a C temp and zero the slot, so the abort dispose never releases a
/// value the slot no longer owns. Without it, a local moved into an `own`
/// parameter before an await was released again when the task was aborted —
/// a use-after-free once the new owner freed it. Any other read renders the
/// slot itself.
_sm_consuming_read :: (fn(expr : AstExpr, name : String, sm_code : String, context : FunctionGenerationContext) -> String)({
  low := match(context.sm_inline_lowering, .Some(l) => l, .None => return(sm_code));
  if(low.rc_operand || !sm_code.starts_with("sm->"), {
    return(sm_code);
  });
  eid := ast_expr_id(expr);
  match(low.moved_reads.get(eid), .Some(t) => return(t), .None => ());
  ei := match(context.base.get_expr_info(expr), .Some(e) => e, .None => return(sm_code));
  vs := scope_variables(eid, ei.env, name);
  v := match(vs.last(), .Some(x) => x, .None => return(sm_code));
  tok := ast_expr_token(expr);
  is_move := match(v.consumed_at_token, .Some(ct) => ((ct.*.module_path == tok.module_path) && (ct.*.row == tok.row) && (ct.*.column == tok.column)), .None => false);
  if(!is_move || !type_contains_rc_type(ei.ty), {
    return(sm_code);
  });
  // The value leaves the slot where the line holding this read runs (the
  // consuming call, binding or store), not here: a later argument of the same
  // call may still read the slot (`S(a : xs, n : xs.len())`), and an await in
  // a later argument suspends before that line runs, so until then the slot
  // still owns the value (an abort there releases it). The read renders the
  // slot and a unique marker; the emitter updates the slot right after the
  // line that carries the marker
  // (issues/fixed/a-move-out-of-a-task-slot-empties-it-before-the-consuming-call-runs.md).
  // A named local's slot keeps the value and sets its move flag: the name may
  // still read it while the new owner holds it (`current := manifest; …
  // f(manifest)`), and the abort dispose empties a flagged slot
  // (issues/fixed/a-local-read-after-it-moves-inside-a-task-reads-an-emptied-slot.md).
  // A temporary's slot, read once, is emptied.
  marker := `/*yo_mv:${fresh_local_name(String.from("m"), context.base.current_function_name.clone())}*/`;
  stmts := match(
    sm_move_flag_of(sm_code.clone()),
    .Some(flag) => `${flag} = 1;  // moved out: the slot's value is its new owner's`,
    .None => `memset(&(${sm_code}), 0, sizeof(${sm_code}));  // moved out: the slot no longer owns it`
  );
  // A pattern binding aliases its scrutinee's payload: the value leaves that
  // place too (issues/fixed/async-abort-dispose-double-drops-moved-enum-payload.md).
  match(
    low.binding_sources.get(sm_code.clone()),
    .Some(src) => {
      stmts.push_string(`\nmemset(&(${src}), 0, sizeof(${src}));  // moved out of the scrutinee it was bound from`);
    },
    .None => ()
  );
  em := context.base.emitter;
  em.defer_move_zero(marker.clone(), stmts);
  out := `${sm_code} ${marker}`;
  low.moved_reads.insert(eid, out.clone());
  out
});
export(generate_atom, _generate_sm_atom);
