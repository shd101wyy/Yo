//! `dyn(...)` constructor emitter.
//!
//! Builds the fat-pointer literal `(<DynT>){ .data = <value>, .vtable =
//! &__yo_vtable_<implKey> }` into the result temp, and registers the
//! (concrete, dyn) impl pair so its vtable is emitted later. The wrapped value
//! must be an object type (value types use `Rc.new()`); the inner value is dup'd
//! so both the Dyn wrapper's drop and the scope-exit drop can each decrement RC.
//!
//! Box-type unwrap is limited (is_boxed_type ≡ false — Box not modeled);
//! state-machine `sm->var_N` field routing is Phase 5, gated on
//! in_async_state_machine = .Some.
{ _store_temp_var_to_state_machine_if_needed } :: import("./other_fn_call.yo");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ AstExpr, ast_expr_id, ast_expr_to_string } :: import("../../expr.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue, t_refine_inner } :: import("../../types/definitions.yo");
{ is_dyn_type, is_boxed_type, is_counted_handle_type, cell_handle_view, unique_box_payload_type, is_unique_box_type } :: import("../../types/guards.yo");
{ extract_fn_trait_from_type } :: import("../../evaluator/trait_checking.yo");
{ type_id_or_empty } :: import("../../evaluator/values/type_trait_methods.yo");
{ Environment } :: import("../../env.yo");
{ record_declared_temp_var, FunctionGenerationContext } :: import("../functions/context.yo");
{ DynImplEntry } :: import("../utils/index.yo");
{ type_key, get_variable_type_string, get_variable_name_for_codegen, sanitize_for_c_identifier, get_variable_name_for_codegen_at, dyn_concrete_c_name, dyn_impl_key_suffix, element_wise_dup_target } :: import("../utils/index.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ generate_deferred_dup_expressions } :: import("./drop_dup.yo");
{ resolve_some_type_to_concrete } :: import("./closures.yo");
{ ExprInfo, expr_info_dyn_call_trait_values, expr_info_deferred_dup_expressions, unsize_reference_mode } :: import("../../expr_info.yo");
{ _pointer_arg_code } :: import("./sizeof.yo");
/// For a BOXED dyn payload (`Rc(Sq)`), the impl concrete type is the UNDERLYING
/// type (`Sq`, the box's single `*` field) while the runtime data type stays
/// `Rc(Sq)`. Keeps the dyn-box / vtable / impl_key keyed on the
/// concrete type consistently; a non-boxed value passes through unchanged.
_unwrap_box_concrete :: (fn(t : &TypeValue) -> TypeValue)({
  (mut(result) : TypeValue) = Rc.clone(t);
  if(is_boxed_type(t), {
    // A cell handle's payload is its cell's (`cell_handle_view`).
    match(cell_handle_view(t), .Some(v) => return(Rc.clone(v.payload)), .None => ());
    match(
      t,
      Rc(.Struct({ field_types : fts })) => match(
        fts.get(usize(0)),
        .Some(ut) => {
          result = ut;
        },
        .None => ()
      ),
      _ => ()
    );
  });
  result
});
/// The C name for `dyn_type` (registered, else `__yo_dyn_<id>`).
_dyn_c_name :: (fn(dyn_type : &TypeValue, context : &FunctionGenerationContext) -> String)(
  match(
    context.base.get_type_c_name(type_key(dyn_type)),
    .Some(cn) => cn,
    .None => {
      mut(out) := String.from("__yo_dyn_");
      out.push_string(type_id_or_empty(dyn_type));
      out
    }
  )
);
/// The C name for the concrete impl type (registered or a `fn(...)` payload's,
/// `dyn_concrete_c_name`; else the Fn-trait's C name, else `unknown_<id>`).
_concrete_c_name :: (fn(concrete_type : &TypeValue, context : &FunctionGenerationContext) -> String)(
  match(
    dyn_concrete_c_name(concrete_type, &context.base),
    .Some(cn) => cn,
    .None => match(
      extract_fn_trait_from_type(concrete_type),
      .Some(ft) => match(
        context.base.get_type_c_name(type_key(&ft)),
        .Some(fcn) => fcn,
        .None => {
          mut(out) := String.from("unknown_");
          out.push_string(type_id_or_empty(concrete_type));
          out
        }
      ),
      .None => {
        mut(out) := String.from("unknown_");
        out.push_string(type_id_or_empty(concrete_type));
        out
      }
    )
  )
);
/// `dyn(&v)` / `dyn(&mut v)`: the fat pointer `F = { .data
/// = &v, .vtable = &vtable }`. The instance is keyed `_P`: its data word is the
/// payload's own address, so its wrappers and slots read `*(V*)data` and its
/// retain and release count nothing (the Dyn borrows `v`).
_generate_dyn_over_lend :: (fn(expr : &AstExpr, dyn_type : &TypeValue, trait_values : &ArrayList(EvalValue), lend_expr : &AstExpr, indent : &String, context : &mut FunctionGenerationContext) -> String)({
  lend_ei := match(context.base.get_expr_info(lend_expr), .Some(e) => e, .None => return(String.from("/* Error: dyn(&v) lend has no type */")));
  pointee := match(t_refine_inner(&lend_ei.ty()), Rc(.Reference(rp, _, _)) => Rc.clone(rp), _ => return(String.from("/* Error: dyn(&v) argument is not a pointer */")));
  resolved := resolve_some_type_to_concrete(pointee.clone());
  dyn_type_c_name := _dyn_c_name(dyn_type, context);
  concrete_type_c_name := _concrete_c_name(&resolved, context);
  impl_key := concrete_type_c_name.clone();
  impl_key.push_str("_");
  impl_key.push_string(dyn_type_c_name.clone());
  impl_key.push_string(dyn_impl_key_suffix(true, &resolved));
  context.base.register_dyn_impl(impl_key.clone(), DynImplEntry(dyn_type : Rc.clone(dyn_type), concrete_type : pointee, data_type : Rc.clone(resolved), trait_values : trait_values.clone(), payload_convention : true));
  ptr_code := _pointer_arg_code(lend_expr, indent, context);
  `((${dyn_type_c_name}){ .data = (void*)(${ptr_code}), .vtable = &__yo_vtable_${impl_key} })`
});
/// Generate C code for a `dyn()` constructor call.
generate_dyn_call :: (fn(expr : &AstExpr, indent : &String, context : &mut FunctionGenerationContext) -> String)({
  ei := match(context.base.get_expr_info(expr), .Some(e) => e, .None => return(String.from("/* Error: dyn() not evaluated */")));
  trait_values := match(expr_info_dyn_call_trait_values(&ei), .Some(tv) => if(tv.len() == usize(0), return(String.from("/* Error: dyn() call missing trait values */")), tv), .None => return(String.from("/* Error: dyn() call missing trait values */")));
  args0 := match(expr, .FnCall(_, _, Rc(a), _, _) => a.get(usize(0)), .Atom(_, _) => Option(AstExpr).None);
  value_expr := match(&ei.runtime_arg_exprs_in_order(), .Some(rargs) => match(rargs.get(usize(0)), .Some(v) => v, .None => match(args0, .Some(a) => a, .None => return(String.from("/* Error: dyn() requires a value argument */")))), .None => match(args0, .Some(a) => a, .None => return(String.from("/* Error: dyn() requires a value argument */"))));
  // A `dyn(&v)` result may carry the reference it was read as (a `&Dyn`
  // declaration's converted type): the Dyn is its pointee.
  // An owning erasure is typed `Box(Dyn(...))` (decision 49 S2): the Dyn is
  // the box's payload.
  dyn_type := match(t_refine_inner(&ei.ty()), Rc(.Reference(rp, _, _)) => Rc.clone(rp), _ => match(unique_box_payload_type(&ei.ty()), .Some(bp) => bp, .None => match(cell_handle_view(&ei.ty()), .Some(hv) => Rc.clone(hv.payload), .None => Rc.clone(ei.ty()))));
  if(!is_dyn_type(&dyn_type), {
    return(String.from("/* Error: dyn() result type is not DynType */"));
  });
  // `dyn(&v)` / `dyn(&mut v)` (decision 49): the Dyn is the fat pointer over
  // the lent place. Its data word is the payload's address.
  if(unsize_reference_mode(ast_expr_id(expr)).is_some(), {
    return(_generate_dyn_over_lend(expr, &dyn_type, &trait_values, &value_expr, indent, context));
  });
  value_ei := match(context.base.get_expr_info(&value_expr), .Some(e) => e, .None => return(String.from("/* Error: dyn() value has no type */")));
  value_type := Rc.clone(value_ei.ty());
  // `dyn(Box.new(v))` (decision 49 S2): the box's own block becomes the
  // `Box(Dyn(...))`'s, so the fat pointer is `{ .data = <the box's cell
  // word>, .vtable }` over a payload-convention (`_P`) instance. The cell
  // word keeps the box's placed bit; every reader masks it.
  match(
    unique_box_payload_type(&value_type),
    .Some(bv) => if(is_unique_box_type(&ei.ty()), {
      resolved_bv := resolve_some_type_to_concrete(bv.clone());
      b_dyn_c := _dyn_c_name(&dyn_type, context);
      b_key := _concrete_c_name(&resolved_bv, context);
      b_key.push_str("_");
      b_key.push_string(b_dyn_c.clone());
      b_key.push_string(dyn_impl_key_suffix(true, &resolved_bv));
      context.base.register_dyn_impl(b_key.clone(), DynImplEntry(dyn_type : Rc.clone(dyn_type), concrete_type : bv, data_type : Rc.clone(resolved_bv), trait_values : trait_values.clone(), payload_convention : true));
      b_code := _call_generate_expr(&value_expr, indent.clone(), context);
      if(b_code.starts_with("// Failed to transpile"), {
        context.base.emitter.emit_string_line(&`${indent.clone()}${b_code}`);
        return(`// Failed to transpile ${ast_expr_to_string(expr)}`);
      });
      b_out := `((${b_dyn_c}){ .data = (void*)(${b_code}), .vtable = &__yo_vtable_${b_key} })`;
      return(
        match(
          &ei.variable_name(),
          .Some(b_tv) => {
            already_b := match(&context.declared_temp_vars, .Some(ds) => ds.contains(b_tv.clone()), .None => false);
            if(!already_b, record_declared_temp_var(context, b_tv.clone()));
            context.base.emitter.emit_string_line(&`${indent.clone()}${b_dyn_c} ${b_tv.clone()} = ${b_out};`);
            _store_temp_var_to_state_machine_if_needed(b_tv.clone(), indent.clone(), context);
            b_tv.clone()
          },
          .None => b_out
        )
      );
    }),
    .None => ()
  );
  // dyn() requires an object type (value types must use Rc.new()). Box is not
  // modeled (is_boxed_type ≡ false), so the Box branch is dead.
  if(!is_counted_handle_type(&value_type) && !is_boxed_type(&value_type), {
    return(String.from("/* Error: dyn() requires an object type (use Rc.new() for value types) */"));
  });
  // Unwrap a boxed payload: impl concrete type = underlying (`Sq`), runtime data
  // type = `Rc(Sq)`.
  concrete_type := _unwrap_box_concrete(&value_type);
  // Resolve a SomeType (`Impl(Fn(...))` for a boxed closure) to its concrete
  // type BEFORE deriving the impl KEY.
  // The key is the wrapper/vtable dedup unit: unresolved, every same-signature
  // closure keys on the SHARED Fn-shape (`unknown_<shape id>`), the last
  // register_dyn_impl wins, and every dyn box dispatches into the single
  // surviving closure's wrapper (suspension_analysis: the detect_all detector
  // silently ran the noop detector's body → 0 suspension points). The ENTRY
  // still stores the raw concrete_type — the
  // box-ctor/typedef passes do their own resolution (functions/dyn.yo:121,
  // types/generation.yo:1068).
  resolved_concrete_type := resolve_some_type_to_concrete(concrete_type.clone());
  dyn_type_c_name := _dyn_c_name(&dyn_type, context);
  concrete_type_c_name := _concrete_c_name(&resolved_concrete_type, context);
  impl_key := concrete_type_c_name.clone();
  impl_key.push_str("_");
  impl_key.push_string(dyn_type_c_name.clone());
  // An atomically boxed payload (`Arc(V)`) needs its own vtable: its
  // retain/release are the atomic RC functions, and its wrappers read the
  // `Arc(V)` box.
  impl_key.push_string(dyn_impl_key_suffix(false, &value_type));
  context.base.register_dyn_impl(impl_key.clone(), DynImplEntry(dyn_type : dyn_type, concrete_type : concrete_type, data_type : Rc.clone(value_type), trait_values : trait_values, payload_convention : false));
  (value_code : String) = _call_generate_expr(&value_expr, indent.clone(), context);
  // DEGRADED dyn when the INNER value failed to transpile (e.g. a
  // `rc(<closure>)` whose spec was dropped — the c03 cluster-B shape):
  // splicing the FTT comment into `<type> <tmp> = <comment>;` and then
  // building a fat pointer over the missing temp breaks the whole batch C.
  // Emit the comment and degrade the dyn expression itself to the same
  // FTT marker — same convention as the return/tail/assignment degrades.
  if(value_code.starts_with("// Failed to transpile"), {
    ftl := indent.clone();
    ftl.push_string(&value_code);
    context.base.emitter.emit_string_line(&ftl);
    return(`// Failed to transpile ${ast_expr_to_string(expr)}`);
  });
  // Declare the inner value's temp if the evaluator assigned one (deferred
  // drops may reference it).
  // The name is compared and used in its C spelling: an atom's
  // `variable_name` is the Yo name itself, whose rendering is already that
  // variable (issues/fixed/emitted-c-identifiers-collide-with-header-macros.md).
  match(
    &value_ei.variable_name(),
    .Some(vn) => {
      vn_c := sanitize_for_c_identifier(vn.clone(), false);
      if(!(value_code == vn_c), {
        var_type_and_name := get_variable_type_string(&value_type, vn.clone(), &mut context.base);
        line := indent.clone();
        line.push_string(&var_type_and_name);
        line.push_str(" = ");
        line.push_string(value_code.clone());
        line.push_str(";");
        context.base.emitter.emit_string_line(&line);
        value_code = vn_c;
      });
    },
    .None => ()
  );
  // Dup the inner value (Dyn wrapper holds a reference too). An element-wise
  // dup's temp is one element (`element_wise_dup_target`): the value,
  // retained in place, is boxed then.
  match(
    expr_info_deferred_dup_expressions(&value_ei),
    .Some(dups) => if(dups.len() > usize(0), {
      generate_deferred_dup_expressions(&value_expr, indent.clone(), context);
      match(
        dups.get(usize(0)),
        .Some(dup_expr) => match(
          if(element_wise_dup_target(&dup_expr).is_some(), Option(ExprInfo).None, context.base.get_expr_info(&dup_expr)),
          .Some(dei) => match(
            &dei.variable_name(),
            .Some(dvn) => {
              value_code = get_variable_name_for_codegen_at(ast_expr_id(&dup_expr), &dvn, Option(Environment).Some(dei.env()));
            },
            .None => ()
          ),
          .None => ()
        ),
        .None => ()
      );
    }),
    .None => ()
  );
  temp_var_name := match(&ei.variable_name(), .Some(tv) => tv.clone(), .None => return(String.from("/* Error: dyn() expression missing temp variable name */")));
  vtable_name := String.from("__yo_vtable_");
  vtable_name.push_string(&impl_key);
  // Track the temp var (SM-field routing is Phase 5, gated dead here).
  already := match(&context.declared_temp_vars, .Some(s) => s.contains(temp_var_name.clone()), .None => false);
  if(
    !already,
    record_declared_temp_var(context, temp_var_name.clone())
  );
  l1 := indent.clone();
  l1.push_string(&dyn_type_c_name);
  l1.push_str(" ");
  l1.push_string(temp_var_name.clone());
  l1.push_str(" = {");
  context.base.emitter.emit_string_line(&l1);
  l2 := indent.clone();
  l2.push_str("  .data = ");
  l2.push_string(&value_code);
  l2.push_str(",");
  context.base.emitter.emit_string_line(&l2);
  l3 := indent.clone();
  l3.push_str("  .vtable = &");
  l3.push_string(&vtable_name);
  context.base.emitter.emit_string_line(&l3);
  l4 := indent.clone();
  l4.push_str("};");
  context.base.emitter.emit_string_line(&l4);
  // Inside a state machine the temp's scope-end release reads its slot, and
  // so does the abort dispose when a call escapes: a `dyn(msg)` thrown from
  // an `io.async` body leaked its box
  // (issues/fixed/async-abort-dispose-double-drops-moved-enum-payload.md).
  _store_temp_var_to_state_machine_if_needed(temp_var_name.clone(), indent.clone(), context);
  temp_var_name
});
export(generate_dyn_call);
