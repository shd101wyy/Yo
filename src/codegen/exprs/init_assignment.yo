//! Initialization-assignment emitter — mirrors
//! `src/codegen/exprs/initialization-assignment.ts`.
//!
//! Handles `x := v` initializations: compile-time variables (skipped),
//! destructuring binds (`{x, y} := p` → one `T x = p.x;` per field, with
//! newtype/tuple/object member-access rules), array initialization (literal or
//! struct copy), and ordinary scalar initialization (declare + assign, spilling
//! an Rc/temp RHS into its temp variable first). Module-level globals and
//! compile-time variables are skipped (declared elsewhere / no runtime form).
//!
//! DEFERRED (documented, not hit by the no-RC/no-async corpus): RHS
//! deferred-dup rewrite + closure-capture access (Phase 4); state-machine
//! `sm->var_N` routing + async-block struct-type inference + `inout(name) :=`
//! `T*` storage shaping (Phase 5 / Variable has no is_ref). These branches are
//! gated dead (in_async_state_machine = .None for the corpus).
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_is_atom, ast_expr_is_atom_of, ast_expr_is_fn_call_of, ast_expr_token, BK_COMPTIME, BK_ARRAY_VAL, BK_INOUT, BF_DOT } :: import("../../expr.yo");
{ RuntimeDestructuring, expr_info_converted_runtime_type, expr_info_runtime_destructurings } :: import("../../expr_info.yo");
{ Environment, get_variables_from_env } :: import("../../env.yo");
{ is_array_type, is_unit_type, is_struct_type, is_reference_struct_type, is_tuple_type, is_newtype_type } :: import("../../types/guards.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_ptr } :: import("../../types/creators.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ resolve_some_type_to_concrete } :: import("./closures.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ emit_deferred_dup_or_code, generate_dup_code_for_value } :: import("./drop_dup.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{ get_type_string, get_variable_type_string, get_variable_name_for_codegen, sanitize_for_c_identifier } :: import("../utils/index.yo");
{ codegen_fatal_expr } :: import("../constants.yo");
{ static_dispatch_callee_return_type } :: import("../functions/declarations.yo");
/// True if `s` is all ASCII digits (non-empty).
_all_digits :: (fn(s : String) -> bool)({
  // BYTE count — the loop reads byte_at; String.len() counts RUNES
  // (multibyte content under-walks; see other_fn_call.yo's splitter fix).
  n := s.as_bytes().len();
  if(n == usize(0), false, {
    (i : usize) = usize(0);
    (ok : bool) = true;
    while(i < n, {
      b := s.byte_at(i);
      if(!((b >= u8(48)) && (b <= u8(57))), {
        ok = false;
      });
      i = (i + usize(1));
    });
    ok
  })
});
/// The last binding for `name` is a compile-time-only variable.
_last_is_compile_time_only :: (fn(env : Environment, name : String) -> bool)({
  vars := get_variables_from_env(env, name);
  m := vars.len();
  if(m == usize(0), false, match(vars.get(m - usize(1)), .Some(v) => v.is_compile_time_only, .None => false))
});
/// The last binding for `name` is a module-level global.
_last_is_module_level :: (fn(env : Environment, name : String) -> bool)({
  vars := get_variables_from_env(env, name);
  m := vars.len();
  if(m == usize(0), false, match(vars.get(m - usize(1)), .Some(v) => v.is_module_level, .None => false))
});
/// Tuple positional index for a label, or -1-sentinel (== len) if not found.
_tuple_index_of :: (fn(rhs_type : TypeValue, label : String) -> Option(usize))(
  match(
    rhs_type,
    .Tuple({ field_labels : fls }) => {
      n := fls.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          fls.get(i),
          .Some(lbl) => if(lbl == label, {
            return(Option(usize).Some(i));
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      Option(usize).None
    },
    _ => Option(usize).None
  )
);
/// Newtype single-field label, if `rhs_type` is a 1-field newtype.
_newtype_single_label :: (fn(rhs_type : TypeValue) -> Option(String))(
  if(is_newtype_type(rhs_type), match(rhs_type, .Struct({ field_labels : fls }) => if(fls.len() == usize(1), fls.get(usize(0)), Option(String).None), _ => Option(String).None), Option(String).None)
);
/// Emit destructuring binds for `{x, y} := rhs`. Mirrors the runtimeDestructurings branch.
_emit_destructurings :: (fn(destructurings : ArrayList(RuntimeDestructuring), rhs : AstExpr, rhs_type : TypeValue, indent : String, context : FunctionGenerationContext) -> unit)({
  em := context.base.emitter;
  rhs_code := _call_generate_expr(rhs, indent.clone(), context);
  member_op := if(is_reference_struct_type(rhs_type), String.from("->"), String.from("."));
  n := destructurings.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      destructurings.get(i),
      .Some(rd) => if(!(rd.variable_name == "_"), {
        sanitized := sanitize_for_c_identifier(rd.variable_name.clone(), false);
        var_type_and_name := get_variable_type_string(rd.ty, sanitized, context.base);
        // Newtype: destructuring the single field is just the value.
        handled_newtype := match(
          _newtype_single_label(rhs_type),
          .Some(nl) => if(nl == rd.label, {
            line := indent.clone();
            line.push_string(var_type_and_name.clone());
            line.push_str(" = ");
            line.push_string(rhs_code.clone());
            line.push_str("; // Destructuring ");
            line.push_string(rd.label.clone());
            line.push_str(" (newtype)");
            em.emit_string_line(line);
            true
          }, false),
          .None => false
        );
        if(!handled_newtype, {
          field_name := if(_all_digits(rd.label), {
            f := String.from("_");
            f.push_string(rd.label.clone());
            f
          }, sanitize_for_c_identifier(rd.label.clone(), false));
          // Tuple label → positional `_index`.
          field_name2 := if(
            is_tuple_type(rhs_type) && !_all_digits(rd.label),
            match(
              _tuple_index_of(rhs_type, rd.label.clone()),
              .Some(idx) => {
                f := String.from("_");
                f.push_string(idx.to_string());
                f
              },
              .None => field_name
            ),
            field_name
          );
          line := indent.clone();
          line.push_string(var_type_and_name);
          line.push_str(" = ");
          line.push_string(rhs_code.clone());
          line.push_string(member_op.clone());
          line.push_string(field_name2);
          line.push_str("; // Destructuring ");
          line.push_string(rd.label.clone());
          em.emit_string_line(line);
        });
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// Initialization assignment. Mirrors `generateInitializationAssignment`.
/// `inout(name) := place;` → `T* name = &(place);` (+ the owner pin).
/// Evaluator twin: `_evaluate_inout_local_binding`
/// (evaluator/exprs/initialization_assignment.yo) — it has already rejected
/// every shape this cannot lower (rvalues, index/deref places, async bodies,
/// module level, `::`), so the place code here is always a C lvalue chain.
///
/// - The place is generated as an rvalue expression and then ADDRESSED: a
///   `(*x)` (the place is itself an `inout`) folds to `x` — the pointer is
///   passed through, never re-taken; anything else becomes `(&(code))`.
///   A spill would be a COPY, so there is no spill fallback: an unexpected
///   shape is a codegen fatal, not a silent value binding.
/// - The declared C type is the pointer to the place's type
///   (`get_variable_type_string` over `t_ptr(T)`, so array/function
///   declarators are spelled by the same code that spells them everywhere).
/// - The PIN (plans/INOUT_LOCAL_BINDINGS_AUDIT.md §8 B4): when the evaluator
///   stamped the `inout(name)` node with `source_variable` (the hidden owning
///   local) and `macro_expansion` (the object expression), emit
///   `Obj* pin = <dup(obj)>;` BEFORE the binding. The pin is an ordinary
///   owning local of the frame, so the scope-end drop the evaluator already
///   scheduled for it releases the `+1` on every exit path.
_generate_inout_local_binding :: (fn(lhs : AstExpr, rhs : AstExpr, indent : String, context : FunctionGenerationContext) -> Option(String))({
  em := context.base.emitter;
  lhs_args := match(lhs, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  name_expr := match(lhs_args.get(usize(0)), .Some(x) => x, .None => return(Option(String).None));
  name_ei := match(
    context.base.get_expr_info(name_expr),
    .Some(e) => e,
    .None => return(Option(String).Some(`// Error: No type information for inout binding ${ast_expr_token(name_expr).value}`))
  );
  var_name := ast_expr_token(name_expr).value;
  place_type := resolve_some_type_to_concrete(name_ei.ty);
  // §9 H5: a state machine addresses a local both as `sm->var_x` and as a
  // per-state C copy, so a reference binding could read a stale copy after a
  // write through it. The evaluator cannot see the state machine (an
  // `io.async` closure body is evaluated as an ordinary closure; the machine
  // is a codegen decision, like the await-position rules in
  // async/state_code_gen.yo), so the rejection lives here.
  if(context.in_async_state_machine.is_some(), {
    return(
      Option(String).Some(
        codegen_fatal_expr(`'inout(${var_name}) := ...' is not supported inside an 'io.async' body yet. Read the value into a local, or call a function that takes 'inout(name) : T'.`)
      )
    );
  });
  // The pin, if any.
  match(
    context.base.get_expr_info(lhs),
    .Some(lhs_ei) => match(
      lhs_ei.source_variable,
      .Some(pin_var) => match(
        lhs_ei.macro_expansion,
        .Some(pin_expr) => {
          pin_code := _call_generate_expr(pin_expr, indent.clone(), context);
          pin_decl := indent.clone();
          pin_decl.push_string(get_variable_type_string(pin_var.ty, pin_var.name.clone(), context.base));
          pin_decl.push_str(" = ");
          pin_decl.push_string(generate_dup_code_for_value(pin_code, pin_var.ty, context));
          pin_decl.push_str(";");
          em.emit_string_line(pin_decl);
        },
        .None => ()
      ),
      .None => ()
    ),
    .None => ()
  );
  place_code := _call_generate_expr(rhs, indent.clone(), context);
  // Address the place: fold a `(*x)` pass-through, otherwise `(&(code))`.
  (addr : String) = String.new();
  if(place_code.starts_with("(*") && place_code.ends_with(")"), {
    addr = place_code.substring(usize(2), place_code.len() - usize(1));
  }, {
    if(!_is_c_lvalue_chain(place_code), {
      return(Option(String).Some(codegen_fatal_expr(`inout binding "${var_name}": place lowered to a non-lvalue C expression: ${place_code}`)));
    });
    addr = String.from("(&(");
    addr.push_string(place_code.clone());
    addr.push_str("))");
  });
  line := indent.clone();
  line.push_string(get_variable_type_string(t_ptr(place_type), var_name.clone(), context.base));
  line.push_str(" = ");
  line.push_string(addr);
  line.push_str(";");
  em.emit_string_line(line);
  Option(String).Some(String.from(""))
});
/// Is `code` plausibly a C lvalue chain — it starts with an identifier (after
/// any `(`/`*` prefix) and its brackets balance? The shapes the evaluator
/// admits as `inout` places (variables, field chains) lower to exactly these;
/// this is a last-line guard against a codegen path that spilled the place
/// into a temp or a compound literal, which would silently bind a COPY.
_is_c_lvalue_chain :: (fn(code : String) -> bool)({
  n := code.len();
  if(n == usize(0), return(false));
  (i : usize) = usize(0);
  while((i < n) && ((code.byte_at(i) == u8(40)) || (code.byte_at(i) == u8(42)) || (code.byte_at(i) == u8(32))), {
    i = (i + usize(1));
  });
  if(i >= n, return(false));
  c0 := code.byte_at(i);
  is_ident_start := (((c0 >= u8(97)) && (c0 <= u8(122))) || ((c0 >= u8(65)) && (c0 <= u8(90))) || (c0 == u8(95)));
  if(!is_ident_start, return(false));
  // Balance brackets over the WHOLE string (the leading `(`/`*` prefix that
  // the identifier scan skipped above counts too: `(*p).value` is a valid
  // lvalue chain whose first `(` closes after the identifier).
  (depth : i32) = i32(0);
  i = usize(0);
  while(i < n, {
    c := code.byte_at(i);
    cond(
      ((c == u8(91)) || (c == u8(40))) => {
        depth = (depth + i32(1));
      },
      ((c == u8(93)) || (c == u8(41))) => {
        depth = (depth - i32(1));
      },
      true => ()
    );
    i = (i + usize(1));
  });
  depth == i32(0)
});
generate_initialization_assignment :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> Option(String))({
  ei := match(context.base.get_expr_info(expr), .Some(e) => e, .None => return(Option(String).None));
  args := match(expr, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  lhs := match(args.get(usize(0)), .Some(x) => x, .None => return(Option(String).None));
  rhs := match(args.get(usize(1)), .Some(x) => x, .None => return(Option(String).None));
  // Compile-time variable → no runtime code.
  if(ast_expr_is_fn_call_of(lhs, BK_COMPTIME, Option(usize).Some(usize(1))), {
    return(Option(String).Some(String.from("")));
  });
  if(ast_expr_is_fn_call_of(lhs, BK_INOUT, Option(usize).Some(usize(1))), {
    return(_generate_inout_local_binding(lhs, rhs, indent.clone(), context));
  });
  // Destructuring binds.
  match(
    expr_info_runtime_destructurings(ei),
    .Some(destructurings) => {
      rhs_type := match(context.base.get_expr_info(rhs), .Some(rei) => rei.ty, .None => TypeValue.Unit);
      _emit_destructurings(destructurings, rhs, rhs_type, indent.clone(), context);
      return(Option(String).Some(String.from("")));
    },
    .None => ()
  );
  if(ast_expr_is_atom(lhs), {
    lhs_ei := match(
      context.base.get_expr_info(lhs),
      .Some(e) => e,
      .None => return(
        // NOT fatal: the MISSING-ExprInfo class, which multi-pass emission
        // legitimately reaches (a comptime `while` unrolls its body once per
        // iteration and a discarded pass has no type info). Kept a comment to
        // match TS; the harmful case is the `__yo_user_main` gate in
        // codegen/functions/generation.yo.
        Option(String).Some(`// Error: No type information for variable ${ast_expr_token(lhs).value}`)
      )
    );
    var_name := match(lhs_ei.variable_name, .Some(vn) => vn, .None => ast_expr_token(lhs).value);
    // Resolve a SomeT binding type through its concrete resolution BEFORE the
    // unit guards below — a binding typed as an unresolved SomeT that resolves
    // to unit rendered `void x = <rhs>;` (invalid C: the worker batch's
    // `void _temp = ;` class, issues/yo-self-async-emission-cluster.md item 4).
    // Same prototype-agreement rule as generate_function_body's result_is_unit.
    lhs_type := resolve_some_type_to_concrete(lhs_ei.ty);
    // Skip compile-time and module-level globals.
    if(_last_is_compile_time_only(lhs_ei.env, var_name.clone()), {
      return(Option(String).Some(String.from("")));
    });
    if(_last_is_module_level(lhs_ei.env, var_name.clone()), {
      return(Option(String).Some(String.from("")));
    });
    em := context.base.emitter;
    // State-machine variable binding: a local captured in the SM struct is
    // ASSIGNED to its `sm->` field, never declared locally (a local decl in
    // one state's C block is invisible to later states — the FSM `a := 20`
    // class). Mirrors initialization-assignment.ts:175-201 + the
    // isStateMachineVar assignment branch. The lookup goes through the `:=`
    // node's OWN recorded env (`ei.env`, stamped post-binding) — the LHS
    // atom's env predates the binding in yo-self and misses the variable.
    if(context.in_async_state_machine.is_some() && context.state_machine_variables.is_some(), {
      sm_bind_vars := get_variables_from_env(ei.env, var_name.clone());
      if(sm_bind_vars.len() > usize(0), {
        match(
          sm_bind_vars.get(sm_bind_vars.len() - usize(1)),
          .Some(sm_bind_var) => {
            (sm_bind_id : String) = match(
              sm_bind_var.is_owning_the_same_rc_value_as,
              .Some(ob) => ob.*.id.to_string(),
              .None => sm_bind_var.id.to_string()
            );
            match(
              context.variable_id_remapping,
              .Some(rm) => match(
                rm.get(sm_bind_id.clone()),
                .Some(mapped) => {
                  sm_bind_id = mapped;
                },
                .None => ()
              ),
              .None => ()
            );
            sm_has := match(
              context.state_machine_variables,
              .Some(smv) => smv.get(sm_bind_id.clone()).is_some(),
              .None => false
            );
            if(sm_has, {
              sm_field := match(
                context.state_machine_field_aliases,
                .Some(al) => match(
                  al.get(sm_bind_id.clone()),
                  .Some(af) => af,
                  .None => `var_${sm_bind_id.clone()}`
                ),
                .None => `var_${sm_bind_id.clone()}`
              );
              // The RHS must go through the deferred-dup chain before it lands
              // in the slot. TS has no early return here: it computes ONE
              // `rhsCode` through all four dup-emitting arms and only then
              // picks `sm->field` as the destination
              // (initialization-assignment.ts:487-494). Returning early with
              // the raw expression skipped the +1 while the slot's drop was
              // still emitted, so `element := list(i)` inside an async loop
              // freed the element out from under the live list.
              sm_rhs := emit_deferred_dup_or_code(rhs, _call_generate_expr(rhs, indent.clone(), context), indent.clone(), context);
              em.emit_string_line(`${indent.clone()}sm->${sm_field.clone()} = ${sm_rhs.clone()};`);
              return(Option(String).Some(String.from("")));
            });
          },
          .None => ()
        );
      });
    });
    if(is_array_type(lhs_type), {
      // Array initialization (literal or struct copy — copy spills an Rc/temp
      // RHS into its temp variable first).
      //
      // A COPY of an array whose element type carries RC must also emit the
      // RHS's deferred `___dup` (one `__yo_dup_array_element` per slot), the
      // way every other binding shape does through `emit_deferred_dup_or_code`.
      // This arm dropped them on the floor, so `out := self` inside
      // `Array(T, N).clone` aliased the source's element handles while each
      // `out(i) = …` still DROPPED the old one — the source array's strings
      // were freed under it ("malloc returned None" on the next allocation).
      rhs_code := if(
        ast_expr_is_fn_call_of(rhs, BK_ARRAY_VAL, Option(usize).None),
        emit_deferred_dup_or_code(rhs, _call_generate_expr(rhs, indent.clone(), context), indent.clone(), context),
        match(
          context.base.get_expr_info(rhs),
          .Some(rei) => match(
            rei.variable_name,
            .Some(tvn) => {
              temp_var_name := get_variable_name_for_codegen(tvn, Option(Environment).Some(rei.env));
              rhs_expr_code := _call_generate_expr(rhs, indent.clone(), context);
              // The spill below exists for an Rc/temp RHS that has to be
              // materialized before the array copy. A PLAIN read of an existing
              // variable needs none — and a by-`ref` binding (`inout(self) :
              // Self` on a value-typed receiver) reads as `(*self)` while its
              // recorded `variable_name` is the bare `self`, so the
              // spellings-differ test fired and declared a second local carrying
              // the C PARAMETER's own name: `Array_int32_t_3 self = (*self);`,
              // which clang rejects ("redefinition of 'self' with a different
              // type"). Before const-generic array lengths resolved, this was
              // invisible — the line rendered as the `// Unknown type:` comment
              // and the function silently returned an UNINITIALIZED array.
              // Treat a deref read of that same variable as already
              // materialized and copy straight from it.
              spilled := cond(
                (temp_var_name == rhs_expr_code) => temp_var_name,
                (rhs_expr_code == `(*${temp_var_name})`) => rhs_expr_code,
                true => {
                  tv := get_variable_type_string(rei.ty, temp_var_name.clone(), context.base);
                  line := indent.clone();
                  line.push_string(tv);
                  line.push_str(" = ");
                  line.push_string(rhs_expr_code);
                  line.push_str(";");
                  em.emit_string_line(line);
                  temp_var_name
                }
              );
              emit_deferred_dup_or_code(rhs, spilled, indent.clone(), context)
            },
            .None => emit_deferred_dup_or_code(rhs, _call_generate_expr(rhs, indent.clone(), context), indent.clone(), context)
          ),
          .None => _call_generate_expr(rhs, indent.clone(), context)
        )
      );
      if(!is_unit_type(lhs_type), {
        var_type_and_name := get_variable_type_string(lhs_type, var_name.clone(), context.base);
        line := indent.clone();
        line.push_string(var_type_and_name);
        line.push_str(" = ");
        line.push_string(rhs_code);
        line.push_str(";");
        em.emit_string_line(line);
      });
    }, {
      // Non-array scalar initialization.
      sanitized_var_name := get_variable_name_for_codegen(var_name.clone(), Option(Environment).Some(lhs_ei.env));
      // A STATIC-dispatch call whose callee's prototype returns `void` has no
      // value, whatever this binding's own types say. They can disagree: a
      // generic `Impl(Fn(...) -> T)` callee specialised at `T = unit` emits a
      // `void` prototype while both `rei.ty` and `lhs_type` still carry the
      // unresolved `T`, whose spelling is the erasure `void*` — so neither the
      // `rhs_is_unit` guard below nor the `!is_unit_type(lhs_type)` guard fires
      // and the C came out `void* t = <void call>; void* v = t;`. Ask the
      // callee.
      // See issues/fixed/closure-call-binds-a-void-result-to-a-void-pointer-temp.md.
      rhs_is_void_call := match(
        rhs,
        .FnCall(_, rhs_callee, _, _, _) => match(
          static_dispatch_callee_return_type(rhs_callee, context.base),
          .Some(sd_ret) => (sd_ret == `void`),
          .None => false
        ),
        .Atom(_, _) => false
      );
      rhs_code := match(
        context.base.get_expr_info(rhs),
        .Some(rei) => match(
          rei.variable_name,
          .Some(tvn) => {
            temp_var_name := get_variable_name_for_codegen(tvn, Option(Environment).Some(rei.env));
            // Same name as the binding, or a bare atom already named — no temp.
            rhs_is_same_atom := (ast_expr_is_atom(rhs) && (temp_var_name == get_variable_name_for_codegen(ast_expr_token(rhs).value, Option(Environment).Some(rei.env))));
            if((temp_var_name == sanitized_var_name) || rhs_is_same_atom, emit_deferred_dup_or_code(rhs, _call_generate_expr(rhs, indent.clone(), context), indent.clone(), context), {
              rhs_expr_code := _call_generate_expr(rhs, indent.clone(), context);
              effective_type := match(expr_info_converted_runtime_type(rei), .Some(crt) => crt, .None => rei.ty);
              // A UNIT-typed RHS has no value to hold. `_call_generate_expr`
              // has already emitted the call as a STATEMENT (so the side effect
              // is preserved) and returned "", so declaring a temp for it
              // emitted `void <temp> = ;` — an incomplete-type error plus an
              // empty initializer, for a program `yo check` accepts. The LHS
              // declaration below carries exactly this guard already; this was
              // the missing half. Resolve through SomeT first, so a type
              // parameter that resolves to unit takes the same path.
              // See issues/fixed/binding-a-unit-returning-call-emits-invalid-c.md.
              rhs_is_unit := (rhs_is_void_call || is_unit_type(resolve_some_type_to_concrete(effective_type)));
              if(rhs_is_unit, {
                // No value to hold, so no declaration — but the code must
                // still RUN. Most unit calls are already emitted as a
                // statement by `_call_generate_expr` and return "", which is
                // why the old declaration came out as `void <temp> = ;`. Do
                // NOT assume that: an expression form that returns non-empty
                // code (e.g. an indirect call that skips the statement path)
                // would be silently DISCARDED, turning a compile error into a
                // miscompile. Emit whatever came back as a statement instead.
                if(rhs_expr_code.len() > usize(0), {
                  ustmt := indent.clone();
                  ustmt.push_string(rhs_expr_code.clone());
                  ustmt.push_str(";");
                  em.emit_string_line(ustmt);
                });
              }, {
                if(!(rhs_expr_code == temp_var_name), {
                  tv := get_variable_type_string(effective_type, temp_var_name.clone(), context.base);
                  line := indent.clone();
                  line.push_string(tv);
                  line.push_str(" = ");
                  line.push_string(rhs_expr_code);
                  line.push_str(";");
                  em.emit_string_line(line);
                });
              });
              emit_deferred_dup_or_code(rhs, temp_var_name, indent.clone(), context)
            })
          },
          // No temp variable name on the RHS — TS's `else` arm
          // (initialization-assignment.ts:464-484) STILL emits the RHS's
          // deferred dups here ("Handle deferred dup expressions for RHS
          // without temp variable"), so the drop this binding will get has a
          // matching +1. This arm is unreachable for state-machine bindings
          // (those return early above); it is ported for parity with the three
          // sibling arms, which all already route through this helper.
          .None => emit_deferred_dup_or_code(rhs, _call_generate_expr(rhs, indent.clone(), context), indent.clone(), context)
        ),
        // No ExprInfo at all — no deferred dups can exist (TS guards on `rhs.$?`).
        .None => _call_generate_expr(rhs, indent.clone(), context)
      );
      // Raw-pointer-deref RHS (`(p &+ i).*` / `p.*`) of an RC-carrying type:
      // TS dups the copy AT THE DEREF SITE (stage1-ref.c: `temp2 =
      // Bucket___dup(temp);`) so the local's scope/early-return drops are
      // balanced. yo-self's eval dup mark for this shape is pass-fragile
      // (`.*` PA branches can re-set the table entry without re-marking), so
      // when NO deferred dup exists on the RHS, apply the struct dup to the
      // fresh copy after the declaration below (HashMap._find_bucket stole
      // the map's own key+value on every probe hit — the round-6
      // `s2 compile main.yo` UAF; see issues/fixed/yo-self-dyn-throw-double-drop.md).
      rhs_is_deref := (ast_expr_is_fn_call_of(rhs, BF_DOT, Option(usize).Some(usize(2))) && match(rhs, .FnCall(_, _, dargs, _, _) => match(dargs.get(usize(1)), .Some(pe) => ast_expr_is_atom_of(pe, "*"), .None => false), .Atom(_, _) => false));
      rhs_has_dup := match(context.base.get_expr_info(rhs), .Some(r2) => match(r2.deferred_dup_expressions, .Some(d2) => (d2.len() > usize(0)), .None => false), .None => false);
      if(!is_unit_type(lhs_type) && !rhs_is_void_call, {
        // get_variable_type_string (not get_type_string + manual name append)
        // so the scalar binding's C name is REGISTERED in declared_c_var_names
        // — _keep_pending_drop (return.yo) rejects a drop whose target was
        // never recorded, which leaked every scalar `:=` local on early-return
        // paths (the HashMap._find_bucket same-key-overwrite leak). The name is
        // already the codegen name (get_variable_name_for_codegen above);
        // sanitize_for_c_identifier is idempotent, so emission is unchanged.
        var_type_and_name := get_variable_type_string(lhs_type, sanitized_var_name.clone(), context.base);
        line := indent.clone();
        line.push_string(var_type_and_name);
        line.push_str(" = ");
        line.push_string(rhs_code);
        line.push_str(";");
        em.emit_string_line(line);
        if(rhs_is_deref && type_contains_rc_type(lhs_type) && !rhs_has_dup, {
          dup_line := indent.clone();
          dup_line.push_string(generate_dup_code_for_value(sanitized_var_name.clone(), lhs_type, context));
          dup_line.push_str(";");
          em.emit_string_line(dup_line);
        });
      });
    });
    return(Option(String).Some(String.from("")));
  });
  Option(String).None
});
export(generate_initialization_assignment);
