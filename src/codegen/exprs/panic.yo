//! `panic(...)` emitter — mirrors `src/codegen/exprs/panic.ts`.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token } :: import("../../expr.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ _c_string_literal } :: import("./comptime_value.yo");
{ get_type_string } :: import("../utils/index.yo");
{ is_str_type, is_u8_type } :: import("../../types/guards.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ panic, assert } :: import("std/assert");
{ codegen_fatal_expr } :: import("../constants.yo");
/// A comptime panic-message literal, with any surrounding double quotes
/// stripped — `.StrLit` values keep their quotes and they leaked into the
/// printed message (the `"\"ArrayList: index out of bounds\""` artifact,
/// P3.6 / D13).
_strip_panic_quotes :: (fn(raw : String) -> String)({
  if((raw.len() >= usize(2)) && (raw.byte_at(usize(0)) == u8(34)) && (raw.byte_at(raw.len() - usize(1)) == u8(34)), {
    return(raw.substring(usize(1), raw.len() - usize(1)));
  });
  raw
});
/// `panic(...)`: emit a stderr message (if any) + abort(), then return an
/// unreachable type-correct dummy value (`*(T*)NULL`) so the C compiles
/// (panic never returns). Mirrors `generatePanic`.
generate_panic :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)({
  ei_opt := context.base.get_expr_info(expr);
  return_type := match(ei_opt, .Some(ei) => ei.ty, .None => return(codegen_fatal_expr(String.from("panic() missing type information"))));
  args := match(expr, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  na := args.len();
  cond(
    (na == usize(0)) => {
      em := context.base.emitter;
      l := indent.clone();
      l.push_str("abort();");
      em.emit_string_line(l);
    },
    (na == usize(1)) => {
      msg_arg := match(args.get(usize(0)), .Some(a) => a, .None => return(codegen_fatal_expr(String.from("panic missing argument"))));
      msg_ei := context.base.get_expr_info(msg_arg);
      // Compile-time string message → fprintf the escaped literal.
      comptime_msg := match(msg_ei, .Some(mei) => match(mei.value, .Some(v) => match(v, .StrLit(raw) => Option(String).Some(raw), _ => Option(String).None), .None => .None), .None => .None);
      match(
        comptime_msg,
        .Some(raw) => {
          em := context.base.emitter;
          // P3.6 (D13): the panic message carries its Yo call site, and the
          // StrLit's literal quotes are stripped.
          ptok := ast_expr_token(expr);
          ploc := ` (at ${ptok.module_path}:${(ptok.row + usize(1))}:${(ptok.column + usize(1))})`;
          pmsg := `${_strip_panic_quotes(raw)}${ploc}`;
          l := indent.clone();
          l.push_str("fprintf(stderr, \"%s\\n\", ");
          l.push_string(_c_string_literal(pmsg));
          l.push_str(");");
          em.emit_string_line(l);
          em.emit_string_line({
            l2 := indent.clone();
            l2.push_str("abort();");
            l2
          });
        },
        .None => {
          // Runtime message — evaluate it; str uses the fat-pointer fields,
          // *(u8) is a C string pointer.
          msg_code := _call_generate_expr(msg_arg, indent.clone(), context);
          msg_ei_ty := match(msg_ei, .Some(mei) => Option(TypeValue).Some(mei.ty), .None => .None);
          msg_is_str := match(msg_ei, .Some(mei) => is_str_type(mei.ty), .None => false);
          msg_is_ptr_u8 := match(
            msg_ei_ty,
            .Some(t) => match(
              t,
              .Pointer(pointee) => is_u8_type(pointee),
              _ => false
            ),
            .None => false
          );
          em := context.base.emitter;
          rtok := ast_expr_token(expr);
          rloc := ` (at ${rtok.module_path}:${(rtok.row + usize(1))}:${(rtok.column + usize(1))})`;
          line := indent.clone();
          str_fmt := _c_string_literal(`%.*s${rloc}\n`);
          if(msg_is_str, {
            line.push_string(`fprintf(stderr, ${str_fmt}, (int)`);
            line.push_string(msg_code.clone());
            line.push_str(".len, (const char*)");
            line.push_string(msg_code.clone());
            line.push_str(".ptr);");
          }, {
            cond(
              msg_is_ptr_u8 => {
                ptr_fmt := _c_string_literal(`%s${rloc}\n`);
                line.push_string(`fprintf(stderr, ${ptr_fmt}, (const char*)`);
                line.push_string(msg_code.clone());
                line.push_str(");");
              },
              true => {
                gen_fmt := _c_string_literal(`%s${rloc}\n`);
                line.push_string(`fprintf(stderr, ${gen_fmt}, `);
                line.push_string(msg_code.clone());
                line.push_str(");");
              }
            );
          });
          em.emit_string_line(line);
          l2 := indent.clone();
          l2.push_str("abort();");
          em.emit_string_line(l2);
        }
      );
    },
    true => {
      return(codegen_fatal_expr(String.from("panic accepts 0 or 1 arguments")));
    }
  );
  // Unreachable, type-correct dummy value.
  out := String.from("(*((");
  out.push_string(get_type_string(return_type, context.base));
  out.push_str("*)NULL))");
  out
});
export(generate_panic);
