//! Match-expression emitter.
//!
//! generate_match_expression dispatches all enum paths after the header
//! (result-temp decl, subject materialization, isPrimitiveMatch delegation,
//! ptr/ref-semantics deref): primitive (int/bool → C switch), nullable-pointer
//! (if/else), simple-enum (tag switch), and tagged-union (tag switch with
//! `.data.<Variant>.<field>` destructuring — labeled + positional, via the EnumT
//! parallel arrays variant_names/variant_field_labels/variant_fields; EnumT has
//! no `.variants[].fields[]` objects). Per-arm bodies via
//! generate_case_body; comptime-eliminated arms (case_executed) are skipped.
//!
//! DEFERRED (documented, not hit by the no-RC/no-async corpus):
//! state-machine storage of destructured variables (Phase 5, gated on in_async).
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ AstExpr, ast_expr_id, ast_expr_is_atom, ast_expr_is_fn_call_of, ast_expr_token, make_err_expr, BK_BEGIN, BF_DOT } :: import("../../expr.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{
  has_any_control_flow,
  expr_info_case_executed,
  expr_info_is_primitive_match,
  expr_info_primitive_pattern_values,
  expr_info_consumed_variable_drop_expressions
} :: import("../../expr_info.yo");
{ is_unit_type, is_pointer_type, is_reference_struct_type, is_reference_enum_type, is_enum_type, is_float_type } :: import("../../types/guards.yo");
{ Environment, get_variables_from_env } :: import("../../env.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ TokenKind } :: import("../../token.yo");
{ generate_deferred_drop_expressions, generate_deferred_dup_expressions, generate_dup_code_for_value, arm_value_with_dups } :: import("./drop_dup.yo");
{ is_temp_variable_name } :: import("../../utils.yo");
{ _looks_like_minted_temp } :: import("./begin.yo");
{ sm_local_field_name } :: import("../async/state_machine_naming.yo");
{ get_type_string, get_variable_name_for_codegen, type_key, sanitize_for_c_identifier, can_optimize_as_nullable_pointer, can_optimize_as_simple_enum, get_enum_variant_c_name, get_deferred_dup_target_atom_name, pattern_param_is_literal, pattern_literal_param_code, pattern_literal_arm_guards } :: import("../utils/index.yo");
{ resolve_enum_shell } :: import("../../types/creators.yo");
{ codegen_fatal_expr } :: import("../constants.yo");
{ Pattern, Arm, lookup_match_arms, pattern_bindings } :: import("../../pattern.yo");
/// True for an ASCII word byte ([A-Za-z0-9_]).
_is_word_byte :: (fn(b : u8) -> bool)(
  ((b >= u8(97)) && (b <= u8(122))) || (((b >= u8(65)) && (b <= u8(90))) || (((b >= u8(48)) && (b <= u8(57))) || (b == u8(95))))
);
/// Emit `<T> bind = init;` — through a fresh temp when `bind`'s own name
/// appears in `init`. A C declaration's initializer is evaluated with the
/// NEW binding ALREADY in scope (C11 6.2.1p4: the declarator completes
/// before the initializer), so `T t = t->data.Node.t;` — what a Yo arm
/// `.Node(_, t) => ...` against scrutinee `t` used to emit — reads the
/// UNINITIALIZED new `t`, not the scrutinee: undefined behavior that
/// surfaced as nondeterministic garbage pointers, freed-tree walks and
/// rc=139 in the V3 verifier
/// (issues/fixed/match-binding-shadows-scrutinee-self-referential-initializer.md).
/// Hoisting the initializer into a fresh temp first makes the binding's
/// own initializer reference only that temp; the copy is then harmless.
/// The substring test is deliberately conservative: `init`'s only variable
/// references are the matched-value code and type tags, and a false
/// positive costs one extra temp that -O2 folds away. The temp name is
/// derived from the binding name — two same-named bindings can never share
/// a C scope (arms are separate case blocks; nesting goes deeper), and
/// `__yo_`-prefixed user identifiers are excluded by the same convention
/// every other minted name relies on.
_emit_pattern_binding_decl :: (
  fn(context : FunctionGenerationContext, indent : String, bind : String, ty : TypeValue, init_code : String) -> unit
)({
  em := context.base.emitter;
  tstr := get_type_string(ty, context.base);
  if(init_code.contains(bind.clone()), {
    tmp := String.from("__yo_pat_");
    tmp.push_string(bind.clone());
    l1 := indent.clone();
    l1.push_string(tstr.clone());
    l1.push_str(" ");
    l1.push_string(tmp.clone());
    l1.push_str(" = ");
    l1.push_string(init_code.clone());
    l1.push_str(";");
    em.emit_string_line(l1);
    l2 := indent.clone();
    l2.push_string(tstr);
    l2.push_str(" ");
    l2.push_string(bind.clone());
    l2.push_str(" = ");
    l2.push_string(tmp);
    l2.push_str(";");
    em.emit_string_line(l2);
  }, {
    l := indent.clone();
    l.push_string(tstr);
    l.push_str(" ");
    l.push_string(bind.clone());
    l.push_str(" = ");
    l.push_string(init_code.clone());
    l.push_str(";");
    em.emit_string_line(l);
  })
});
/// True when position `idx` lies INSIDE a double-quoted C string literal in
/// `s` (parity walk with `\\`-escape skipping): the word
/// `return` inside a GENERATED STRING LITERAL (e.g. a Yo source literal
/// "...before early return") is NOT a return statement — treating it as one
/// skipped the arm's result-temp assignment and left the temp uninitialized
/// (SIGBUS; issues/fixed/cond-arm-return-inside-string-literal.md).
_inside_c_string_literal :: (fn(s : String, idx : usize) -> bool)({
  (in_str : bool) = false;
  (i : usize) = usize(0);
  while(i < idx, {
    b := s.byte_at(i);
    cond(
      (in_str && (b == u8(92))) => {
        i = (i + usize(2));
      },
      (b == u8(34)) => {
        in_str = !in_str;
        i = (i + usize(1));
      },
      true => {
        i = (i + usize(1));
      }
    );
  });
  in_str
});
/// Byte-based find of `word` in `s` starting at byte `from` — `index_of`
/// returns RUNE indices, which cannot feed the byte_at reads below when the
/// scanned C code contains multibyte string literals (see other_fn_call.yo's
/// splitter fix).
_byte_index_of :: (fn(s : String, word : String, from : usize) -> Option(usize))({
  sb := s.as_bytes();
  wb := word.as_bytes();
  n := sb.len();
  m := wb.len();
  if((m == usize(0)) || (n < m), {
    return(Option(usize).None);
  });
  (i : usize) = from;
  while((i + m) <= n, {
    (j : usize) = usize(0);
    (hit : bool) = true;
    while((j < m) && hit, {
      a := match(sb.get(i + j), .Some(x) => x, .None => u8(0));
      b := match(wb.get(j), .Some(x) => x, .None => u8(1));
      if(!(a == b), {
        hit = false;
      });
      j = (j + usize(1));
    });
    if(hit, {
      return(Option(usize).Some(i));
    });
    i = (i + usize(1));
  });
  Option(usize).None
});
/// Whether `s` contains "return" as a whole word (a `\breturn\b`-style match).
_contains_word_return :: (fn(s : String) -> bool)({
  word := String.from("return");
  wlen := usize(6);
  // BYTE length + byte-based find — see _byte_index_of.
  slen := s.as_bytes().len();
  (from : usize) = usize(0);
  while(true, {
    match(
      _byte_index_of(s, word.clone(), from),
      .Some(idx) => {
        before_ok := if(idx == usize(0), true, !_is_word_byte(s.byte_at(idx - usize(1))));
        after_idx := (idx + wlen);
        after_ok := if(after_idx >= slen, true, !_is_word_byte(s.byte_at(after_idx)));
        if(before_ok && after_ok && !_inside_c_string_literal(s, idx), {
          return(true);
        }, {
          from = (idx + usize(1));
        });
      },
      .None => {
        return(false);
      }
    );
  });
  false
});
/// Whether generated code is control flow that must NOT be assigned to a temp.
_is_control_flow_code :: (fn(code : String) -> bool)(
  (code.len() == usize(0)) || ((code == "break") || ((code == "continue") || (code.starts_with("goto") || _contains_word_return(code))))
);
/// Args of a FnCall (empty for an Atom).
_args :: (fn(e : AstExpr) -> ArrayList(AstExpr))(
  match(e, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new())
);
/// True if `expr` is an or-pattern `a | b`.
_is_or_pattern :: (fn(expr : AstExpr) -> bool)(
  ast_expr_is_fn_call_of(expr, "|", Option(usize).Some(usize(2)))
);
/// Flatten an or-pattern into its individual patterns.
_flatten_or_pattern :: (fn(expr : AstExpr) -> ArrayList(AstExpr))(
  if(!_is_or_pattern(expr), {
    out := ArrayList(AstExpr).new();
    out.push(expr);
    out
  }, {
    args := _args(expr);
    out := ArrayList(AstExpr).new();
    match(
      args.get(usize(0)),
      .Some(left) => {
        l := recur(left);
        nl := l.len();
        (i : usize) = usize(0);
        while(i < nl, {
          match(
            l.get(i),
            .Some(e) => {
              out.push(e);
            },
            .None => ()
          );
          i = (i + usize(1));
        });
      },
      .None => ()
    );
    match(
      args.get(usize(1)),
      .Some(right) => {
        r := recur(right);
        nr := r.len();
        (j : usize) = usize(0);
        while(j < nr, {
          match(
            r.get(j),
            .Some(e) => {
              out.push(e);
            },
            .None => ()
          );
          j = (j + usize(1));
        });
      },
      .None => ()
    );
    out
  })
);
/// A C literal for a compile-time value (number / bool).
_c_literal_from_value :: (fn(value : EvalValue) -> Option(String))(
  match(value, .IntLit(r) => Option(String).Some(r), .FloatLit(r) => Option(String).Some(r), .BoolVal(b) => Option(String).Some(if(b, String.from("true"), String.from("false"))), _ => Option(String).None)
);
/// Concatenate `current` then `prev` (both optional) into a fresh drop list.
_concat_drops :: (fn(current : Option(ArrayList(AstExpr)), prev : Option(ArrayList(AstExpr))) -> ArrayList(AstExpr))({
  out := ArrayList(AstExpr).new();
  match(
    current,
    .Some(cd) => {
      n := cd.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          cd.get(i),
          .Some(e) => {
            out.push(e);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .None => ()
  );
  match(
    prev,
    .Some(pp) => {
      n := pp.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          pp.get(i),
          .Some(e) => {
            out.push(e);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .None => ()
  );
  out
});
/// Generate a match/cond case body (begin blocks inline their statements and
/// yield the final expression). (The begin-final
/// deferred-dup rewrite is Phase 4 — empty for the no-RC corpus.)
generate_case_body :: (fn(body_expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)(
  if(ast_expr_is_fn_call_of(body_expr, BK_BEGIN, Option(usize).None), {
    em := context.base.emitter;
    begin_args := _args(body_expr);
    vei_opt := context.base.get_expr_info(body_expr);
    cur_drops := match(vei_opt, .Some(vei) => vei.deferred_drop_expressions, .None => Option(ArrayList(AstExpr)).None);
    cur_consumed := match(vei_opt, .Some(vei) => expr_info_consumed_variable_drop_expressions(vei), .None => Option(ArrayList(AstExpr)).None);
    prev_pending := context.pending_deferred_drops;
    prev_consumed := context.consumed_var_pending_drops;
    context.pending_deferred_drops = Option(ArrayList(AstExpr)).Some(_concat_drops(cur_drops, prev_pending));
    context.consumed_var_pending_drops = Option(ArrayList(AstExpr)).Some(_concat_drops(cur_consumed, prev_consumed));
    n := begin_args.len();
    // All statements except the last.
    if(n > usize(0), {
      (j : usize) = usize(0);
      (stop : bool) = false;
      while((j < (n - usize(1))) && !stop, {
        match(
          begin_args.get(j),
          .Some(arg) => {
            arg_code := _call_generate_expr(arg, indent.clone(), context);
            // Bare-temp-name skip (same gate as generate_state_segment_code /
            // generate_loop_body): a statement that emitted its own C lines
            // returns just its eval temp name; when that temp was never
            // declared (unit/inline-emitted statement), `temp;` is an
            // undeclared-identifier C error (SM cond-branch arm class).
            arm_bare_temp := match(
              context.base.get_expr_info(arg),
              .Some(aei0) => is_temp_variable_name(aei0.env.module_path.clone(), arg_code.clone()),
              .None => false
            );
            if((arg_code.len() > usize(0)) && !arm_bare_temp, {
              line := indent.clone();
              line.push_string(arg_code);
              line.push_str(";");
              em.emit_string_line(line);
            });
            match(
              context.base.get_expr_info(arg),
              .Some(aei) => if(has_any_control_flow(aei.control_flow), {
                stop = true;
              }),
              .None => ()
            );
          },
          .None => ()
        );
        j = (j + usize(1));
      });
    });
    // Final expression — deferred-dup rewrite first (a borrowed value leaving
    // the arm needs its balancing +1; the bare emission was the round-5 UAF).
    final_code := if(n > usize(0), match(begin_args.get(n - usize(1)), .Some(final_expr) => match(arm_value_with_dups(final_expr, indent.clone(), context), .Some(fc) => fc, .None => _call_generate_expr(final_expr, indent.clone(), context)), .None => String.from("")), String.from(""));
    generate_deferred_drop_expressions(body_expr, indent.clone(), context);
    context.pending_deferred_drops = prev_pending;
    context.consumed_var_pending_drops = prev_consumed;
    final_code
  }, {
    // Non-begin. The arm's scope-end drops ride the body node's list (the
    // evaluator routes a bare arm through the begin scope, sharing the id).
    // Feed them into the pending path for the body's generation, exactly as
    // the begin path above does: a short-circuit operand INSIDE the body
    // (`.Ok(c) => assert(c && (f() == "x"), …)`) declares its temps inside
    // the `if (lhs) {` C block and can only drop them there —
    // `_emit_drops_for_conditional_branch` finds them through pending. Without
    // this, the temp's drop was left to the post-call flush AFTER the block
    // closed: an undeclared C identifier
    // (issues/fixed/short-circuit-rhs-temp-in-bare-arm-body-drops-out-of-scope.md).
    vei_opt := context.base.get_expr_info(body_expr);
    cur_drops := match(vei_opt, .Some(vei) => vei.deferred_drop_expressions, .None => Option(ArrayList(AstExpr)).None);
    cur_consumed := match(vei_opt, .Some(vei) => expr_info_consumed_variable_drop_expressions(vei), .None => Option(ArrayList(AstExpr)).None);
    prev_pending := context.pending_deferred_drops;
    prev_consumed := context.consumed_var_pending_drops;
    context.pending_deferred_drops = Option(ArrayList(AstExpr)).Some(_concat_drops(cur_drops, prev_pending));
    context.consumed_var_pending_drops = Option(ArrayList(AstExpr)).Some(_concat_drops(cur_consumed, prev_consumed));
    // When the arm value carries deferred `___dup`s (returning a borrowed
    // value out of the arm — e.g. `.Some(e) => e.ty`),
    // see arm_value_with_dups in drop_dup.yo.
    code := match(
      arm_value_with_dups(body_expr, indent.clone(), context),
      .Some(fc) => fc,
      .None => {
        generate_deferred_dup_expressions(body_expr, indent.clone(), context);
        _call_generate_expr(body_expr, indent.clone(), context)
      }
    );
    context.pending_deferred_drops = prev_pending;
    context.consumed_var_pending_drops = prev_consumed;
    code
  })
);
/// Emit one case body + temp assignment WITHOUT the trailing `break` — for
/// chain lowerings (the float primitive match) where `break` would escape an
/// enclosing loop instead of the arm.
_emit_case_body_no_break :: (fn(case_body : AstExpr, indent : String, body_indent : String, temp_var_opt : Option(String), is_unit : bool, context : FunctionGenerationContext) -> unit)({
  em := context.base.emitter;
  body_code := generate_case_body(case_body, body_indent.clone(), context);
  assigned := match(
    temp_var_opt,
    .Some(tv) => if(!is_unit && (body_code.len() > usize(0)) && !_is_control_flow_code(body_code), {
      line := body_indent.clone();
      line.push_string(tv.clone());
      line.push_str(" = ");
      line.push_string(body_code.clone());
      line.push_str(";");
      em.emit_string_line(line);
      true
    }, false),
    .None => false
  );
  if(!assigned && (body_code.len() > usize(0)), {
    fb_bare_temp := match(
      context.base.get_expr_info(case_body),
      .Some(cbei) => is_temp_variable_name(cbei.env.module_path.clone(), body_code.clone()),
      .None => false
    );
    if(!fb_bare_temp, {
      line := body_indent.clone();
      line.push_string(body_code);
      line.push_str(";");
      em.emit_string_line(line);
    });
  });
});
/// Emit one case body + temp assignment / break. Shared by the primitive
/// (default + value) arms.
_emit_case_body_and_break :: (fn(case_body : AstExpr, indent : String, body_indent : String, temp_var_opt : Option(String), is_unit : bool, context : FunctionGenerationContext) -> unit)({
  em := context.base.emitter;
  body_code := generate_case_body(case_body, body_indent.clone(), context);
  assigned := match(
    temp_var_opt,
    .Some(tv) => if(!is_unit && (body_code.len() > usize(0)) && !_is_control_flow_code(body_code), {
      line := body_indent.clone();
      line.push_string(tv.clone());
      line.push_str(" = ");
      line.push_string(body_code.clone());
      line.push_str(";");
      em.emit_string_line(line);
      true
    }, false),
    .None => false
  );
  if(!assigned && (body_code.len() > usize(0)), {
    // Same bare-temp-name skip as generate_case_body's statement loop: a
    // unit arm whose final statement emitted itself returns only its eval
    // temp name — emitting `temp;` here referenced an undeclared identifier
    // (the SM cond-branch `sm->var = ...; temp;` class, sys/bufio flag-on).
    fb_bare_temp := match(
      context.base.get_expr_info(case_body),
      .Some(cbei) => is_temp_variable_name(cbei.env.module_path.clone(), body_code.clone()),
      .None => false
    );
    if(!fb_bare_temp, {
      line := body_indent.clone();
      line.push_string(body_code);
      line.push_str(";");
      em.emit_string_line(line);
    });
  });
  brk := body_indent.clone();
  brk.push_str("break;");
  em.emit_string_line(brk);
});
/// Generate a FLOAT primitive match as an ordered `if (x == lit)` chain —
/// C forbids `switch` on a double, which is what the switch emitter below
/// used to emit for f32/f64 scrutinees (audit row B1: check green, C red).
/// `primitive_pattern_values` holds the compared literals; an or-pattern
/// arm contributes several conjuncts joined by `||`.
_generate_float_primitive_match :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext, matched_value_code : String, temp_var_opt : Option(String), is_unit : bool) -> String)({
  em := context.base.emitter;
  saved := context.base.inside_match;
  context.base.inside_match = true;
  body_indent := indent.clone();
  body_indent.push_str("  ");
  args := _args(expr);
  n := args.len();
  (i : usize) = usize(1);
  (emitted_any : bool) = false;
  while(i < n, {
    match(
      args.get(i),
      .Some(case_expr) => if(ast_expr_is_fn_call_of(case_expr, "=>", Option(usize).Some(usize(2))), {
        cargs := _args(case_expr);
        case_value := match(cargs.get(usize(0)), .Some(cv) => cv, .None => case_expr);
        case_body := match(cargs.get(usize(1)), .Some(cb) => cb, .None => case_expr);
        executed := match(
          context.base.get_expr_info(case_value),
          .Some(cei) => match(expr_info_case_executed(cei), .Some(b) => b, .None => false),
          .None => false
        );
        if(executed, {
          is_wildcard := (ast_expr_is_atom(case_value) && (ast_expr_token(case_value).value == "_"));
          if(is_wildcard, {
            // The catch-all: a plain else. Arms after it are unreachable —
            // the evaluator rejects them (A2) — so this is the chain's tail.
            els := indent.clone();
            els_else := cond(
              emitted_any => String.from("else "),
              true => String.new()
            );
            els.push_string(els_else);
            els.push_str("{");
            em.emit_string_line(els);
            _emit_case_body_no_break(case_body, indent.clone(), body_indent.clone(), temp_var_opt, is_unit, context);
            cl := indent.clone();
            cl.push_str("}");
            em.emit_string_line(cl);
            emitted_any = true;
          }, {
            // Literal arm: if (x == lit1 || x == lit2) { ... }
            match(
              context.base.get_expr_info(case_value),
              .Some(cei) => match(
                expr_info_primitive_pattern_values(cei),
                .Some(pvs) => if(pvs.len() > usize(0), {
                  cond_code := String.new();
                  (pi : usize) = usize(0);
                  while(pi < pvs.len(), {
                    match(
                      pvs.get(pi),
                      .Some(vopt) => match(
                        vopt,
                        .Some(v) => {
                          if(cond_code.len() > usize(0), {
                            cond_code.push_str(" || ");
                          });
                          cond_code.push_str("(");
                          cond_code.push_string(matched_value_code.clone());
                          cond_code.push_str(" == ");
                          lit_txt := match(
                            _c_literal_from_value(v),
                            .Some(t) => t,
                            .None => String.from("0")
                          );
                          cond_code.push_string(lit_txt);
                          cond_code.push_str(")");
                        },
                        .None => ()
                      ),
                      .None => ()
                    );
                    pi = (pi + usize(1));
                  });
                  if(cond_code.len() > usize(0), {
                    h := indent.clone();
                    h_cond := cond(
                      emitted_any => String.from("else if "),
                      true => String.from("if ")
                    );
                    h.push_string(h_cond);
                    h.push_str("(");
                    h.push_string(cond_code);
                    h.push_str(") {");
                    em.emit_string_line(h);
                    _emit_case_body_no_break(case_body, indent.clone(), body_indent.clone(), temp_var_opt, is_unit, context);
                    cl := indent.clone();
                    cl.push_str("}");
                    em.emit_string_line(cl);
                    emitted_any = true;
                  });
                }),
                .None => ()
              ),
              .None => ()
            );
          });
        });
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  context.base.inside_match = saved;
  if(is_unit, String.from(""), match(temp_var_opt, .Some(tv) => tv, .None => String.from("")))
});
/// Generate a primitive (int/bool) match as a C switch.
generate_primitive_match_expression :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext, matched_value_code : String, match_value_type : TypeValue, temp_var_opt : Option(String), is_unit : bool) -> String)({
  // A float scrutinee cannot lower to a switch (C forbids `switch` on
  // double) — take the ordered == chain (audit B1).
  if(is_float_type(match_value_type), {
    return(_generate_float_primitive_match(expr, indent.clone(), context, matched_value_code.clone(), temp_var_opt, is_unit));
  });
  saved_inside_match := context.base.inside_match;
  context.base.inside_match = true;
  em := context.base.emitter;
  body_indent := indent.clone();
  body_indent.push_str("  ");
  hdr := indent.clone();
  hdr.push_str("switch (");
  hdr.push_string(matched_value_code);
  hdr.push_str(") {");
  em.emit_string_line(hdr);
  args := _args(expr);
  n := args.len();
  (i : usize) = usize(1);
  while(i < n, {
    match(
      args.get(i),
      .Some(case_expr) => if(ast_expr_is_fn_call_of(case_expr, "=>", Option(usize).Some(usize(2))), {
        cargs := _args(case_expr);
        case_value := match(cargs.get(usize(0)), .Some(cv) => cv, .None => case_expr);
        case_body := match(cargs.get(usize(1)), .Some(cb) => cb, .None => case_expr);
        executed := match(context.base.get_expr_info(case_value), .Some(cei) => match(expr_info_case_executed(cei), .Some(b) => b, .None => false), .None => false);
        if(executed, {
          is_wildcard := (ast_expr_is_atom(case_value) && (ast_expr_token(case_value).value == "_"));
          if(is_wildcard, {
            d := indent.clone();
            d.push_str("default: {");
            em.emit_string_line(d);
            _emit_case_body_and_break(case_body, indent.clone(), body_indent.clone(), temp_var_opt, is_unit, context);
            cl := indent.clone();
            cl.push_str("}");
            em.emit_string_line(cl);
          }, {
            // Emit `case <literal>:` for each pattern value.
            emitted_any := match(
              context.base.get_expr_info(case_value),
              .Some(cei) => match(
                expr_info_primitive_pattern_values(cei),
                .Some(pvs) => if(pvs.len() > usize(0), {
                  np := pvs.len();
                  (pi : usize) = usize(0);
                  while(pi < np, {
                    match(
                      pvs.get(pi),
                      .Some(vopt) => match(
                        vopt,
                        .Some(v) => match(
                          _c_literal_from_value(v),
                          .Some(lit) => {
                            cl := indent.clone();
                            cl.push_str("case ");
                            cl.push_string(lit);
                            cl.push_str(":");
                            em.emit_string_line(cl);
                          },
                          .None => ()
                        ),
                        .None => ()
                      ),
                      .None => ()
                    );
                    pi = (pi + usize(1));
                  });
                  true
                }, false),
                .None => false
              ),
              .None => false
            );
            if(!emitted_any, {
              // Fallback: literals from the flattened pattern expressions.
              flat := _flatten_or_pattern(case_value);
              nf := flat.len();
              (fi : usize) = usize(0);
              while(fi < nf, {
                match(
                  flat.get(fi),
                  .Some(pe) => match(
                    context.base.get_expr_info(pe),
                    .Some(pei) => match(
                      pei.value,
                      .Some(v) => match(
                        _c_literal_from_value(v),
                        .Some(lit) => {
                          cl := indent.clone();
                          cl.push_str("case ");
                          cl.push_string(lit);
                          cl.push_str(":");
                          em.emit_string_line(cl);
                        },
                        .None => ()
                      ),
                      .None => ()
                    ),
                    .None => ()
                  ),
                  .None => ()
                );
                fi = (fi + usize(1));
              });
            });
            ob := indent.clone();
            ob.push_str("{");
            em.emit_string_line(ob);
            _emit_case_body_and_break(case_body, indent.clone(), body_indent.clone(), temp_var_opt, is_unit, context);
            cb := indent.clone();
            cb.push_str("}");
            em.emit_string_line(cb);
          });
        });
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  context.base.inside_match = saved_inside_match;
  close := indent.clone();
  close.push_str("}");
  em.emit_string_line(close);
  generate_deferred_drop_expressions(expr, indent.clone(), context, true);
  if(is_unit, String.from(""), match(temp_var_opt, .Some(tv) => tv, .None => String.from("")))
});
/// Whether a match arm's pattern was executed (comptime branch elimination).
_case_executed :: (fn(case_value : AstExpr, context : FunctionGenerationContext) -> bool)(
  match(context.base.get_expr_info(case_value), .Some(cei) => match(expr_info_case_executed(cei), .Some(b) => b, .None => false), .None => false)
);
/// The variant name of a `.Variant(...)` / `.Variant` pattern (its first arg's token).
_variant_name :: (fn(case_value : AstExpr) -> String)(
  match(case_value, .FnCall(_, _, a, _, _) => match(a.get(usize(0)), .Some(v) => ast_expr_token(v).value, .None => String.from("")), .Atom(_, _) => String.from(""))
);
/// Nullable-pointer-optimized enum match → if/else (null vs pointer case).
/// Add a name to the function's local-shadowed-variables set (creating it if
/// absent). A shadowed name resolves in `generate_atom` to its sanitized
/// SOURCE name (the arm-block C declaration), not the evaluator's temp.
_shadow_add :: (fn(context : FunctionGenerationContext, name : String) -> unit)({
  match(
    context.local_shadowed_variables,
    .Some(s) => {
      s.insert(name);
    },
    .None => {
      ns := HashSet(String).new();
      ns.insert(name);
      context.local_shadowed_variables = Option(HashSet(String)).Some(ns);
    }
  );
});
/// Remove a name from the local-shadowed-variables set (after an arm body, so
/// the shadow does not leak to sibling arms / outer scope).
_shadow_remove :: (fn(context : FunctionGenerationContext, name : String) -> unit)({
  match(
    context.local_shadowed_variables,
    .Some(s) => {
      _r := s.remove(name);
    },
    .None => ()
  );
});
_gen_nullable_ptr_match :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext, matched_value_code : String, nullable_inner : TypeValue, is_ptr : bool, temp_var_opt : Option(String), is_unit : bool) -> String)({
  em := context.base.emitter;
  body_indent := indent.clone();
  body_indent.push_str("  ");
  args := _args(expr);
  n := args.len();
  // Classify arms into null-case body and pointer-case (body + pattern).
  (null_body : Option(AstExpr)) = Option(AstExpr).None;
  (ptr_body : Option(AstExpr)) = Option(AstExpr).None;
  (ptr_pattern : Option(AstExpr)) = Option(AstExpr).None;
  (i : usize) = usize(1);
  while(i < n, {
    match(
      args.get(i),
      .Some(ce) => if(ast_expr_is_fn_call_of(ce, "=>", Option(usize).Some(usize(2))), {
        cargs := _args(ce);
        match(
          cargs.get(usize(0)),
          .Some(cv) => match(
            cargs.get(usize(1)),
            .Some(cb) => if(_case_executed(cv, context), {
              // `.None` (caseValue itself is a `.` call) → null case; `.Some(v)` → pointer case.
              if(ast_expr_is_fn_call_of(cv, BF_DOT, Option(usize).None), {
                null_body = Option(AstExpr).Some(cb);
              }, {
                ptr_body = Option(AstExpr).Some(cb);
                ptr_pattern = Option(AstExpr).Some(cv);
              });
            }),
            .None => ()
          ),
          .None => ()
        );
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  // if (<*?>matched != NULL) { <bind payload> <body> } else { <null body> }
  star := if(is_ptr, String.from("*"), String.from(""));
  hdr := indent.clone();
  hdr.push_str("if (");
  hdr.push_string(star);
  hdr.push_string(matched_value_code.clone());
  hdr.push_str(" != NULL) {");
  em.emit_string_line(hdr);
  match(
    ptr_pattern,
    .Some(pat) => {
      // Bind the destructured payload to the pointer value.
      match(
        pat,
        .FnCall(_, _, pargs, _, _) => match(
          pargs.get(usize(0)),
          .Some(dvar) => if(ast_expr_is_atom(dvar), {
            dvn := sanitize_for_c_identifier(ast_expr_token(dvar).value, false);
            _emit_pattern_binding_decl(context, body_indent.clone(), dvn.clone(), nullable_inner, matched_value_code.clone());
            // Shadow-register the binding like _emit_destructure_binds does
            // for tagged-union arms: the arm body must resolve `q` to THIS
            // local C declaration. Without it, a GENERIC-IMPL materialized
            // arm body — whose ExprInfo carries an evaluator-stamped temp
            // `variable_name` — rendered the read as a never-declared
            // `_<module>__priv_temp_N` (the generic-impl face of
            // issues/fixed/async-loop-awaiting-buffer-taking-method-state-machine-corruption.md).
            // Removed after the ptr-case body below.
            _shadow_add(context, dvn.clone());
            // STATE-MACHINE STORAGE PARITY: identifier READS of an
            // sm-hoisted variable emit `sm->var_N` (atom.yo consults
            // state_machine_variables), so when THIS pattern binding's
            // variable was hoisted, the local decl above leaves the slot
            // uninitialized and the arm's result reads garbage — the
            // facet-2 loop-await rc=139
            // (issues/fixed/async-loop-awaiting-buffer-taking-method-state-machine-corruption.md).
            // Resolve the binding's slot: env id (owning-alias + remapping,
            // init_assignment.yo:206's steps) first, then a NAME scan over
            // the hoister's map (_find_sm_var_id_by_name's recovery) —
            // pattern bindings are often absent from the recorded env
            // entirely, and env ids can be a different generation than the
            // map keys.
            if(context.in_async_state_machine.is_some() && context.state_machine_variables.is_some(), {
              (smb_id : String) = String.new();
              (smb_has : bool) = false;
              match(
                ptr_body,
                .Some(smb_pb) => match(
                  context.base.get_expr_info(smb_pb),
                  .Some(smb_bei) => {
                    smb_vars := get_variables_from_env(smb_bei.env, ast_expr_token(dvar).value.to_string());
                    if(smb_vars.len() > usize(0), {
                      match(
                        smb_vars.get(smb_vars.len() - usize(1)),
                        .Some(smb_var) => {
                          smb_id = match(
                            smb_var.is_owning_the_same_rc_value_as,
                            .Some(ob) => ob.*.id.to_string(),
                            .None => smb_var.id.to_string()
                          );
                          match(
                            context.variable_id_remapping,
                            .Some(rm) => match(
                              rm.get(smb_id.clone()),
                              .Some(mapped) => {
                                smb_id = mapped;
                              },
                              .None => ()
                            ),
                            .None => ()
                          );
                          smb_has = match(
                            context.state_machine_variables,
                            .Some(smv) => smv.get(smb_id.clone()).is_some(),
                            .None => false
                          );
                        },
                        .None => ()
                      );
                    });
                  },
                  .None => ()
                ),
                .None => ()
              );
              if(!smb_has, {
                match(
                  context.state_machine_variables,
                  .Some(smv2) => {
                    smb_it := smv2.keys();
                    (smb_more : bool) = true;
                    while(smb_more, {
                      match(
                        smb_it.next(),
                        .None => {
                          smb_more = false;
                        },
                        .Some(smb_k) => match(
                          smv2.get(smb_k.clone()),
                          .Some(smb_cv) => {
                            smb_is_local := match(smb_cv.kind, .Local => true, .Outer => false);
                            if(smb_is_local && (smb_cv.base.name == ast_expr_token(dvar).value.to_string()), {
                              smb_id = smb_k.clone();
                              smb_has = true;
                              smb_more = false;
                            });
                          },
                          .None => ()
                        )
                      );
                    });
                  },
                  .None => ()
                );
              });
              if(smb_has, {
                smb_field := match(
                  context.state_machine_field_aliases,
                  .Some(al) => match(
                    al.get(smb_id.clone()),
                    .Some(af) => af,
                    .None => sm_local_field_name(smb_id.clone())
                  ),
                  .None => sm_local_field_name(smb_id.clone())
                );
                smb_store := body_indent.clone();
                smb_store.push_str("sm->");
                smb_store.push_string(smb_field);
                smb_store.push_str(" = ");
                smb_store.push_string(dvn.clone());
                smb_store.push_str(";");
                em.emit_string_line(smb_store);
              });
            });
          }),
          .None => ()
        ),
        .Atom(_, _) => ()
      );
    },
    .None => ()
  );
  match(
    ptr_body,
    .Some(pb) => {
      body_code := generate_case_body(pb, body_indent.clone(), context);
      if(
        !is_unit && !_is_control_flow_code(body_code),
        match(
          temp_var_opt,
          .Some(tv) => {
            result := if(body_code.len() > usize(0), body_code.clone(), matched_value_code.clone());
            line := body_indent.clone();
            line.push_string(tv.clone());
            line.push_str(" = ");
            line.push_string(result);
            line.push_str(";");
            em.emit_string_line(line);
          },
          .None => if(body_code.len() > usize(0), {
            line := body_indent.clone();
            line.push_string(body_code.clone());
            line.push_str(";");
            em.emit_string_line(line);
          })
        ),
        if(body_code.len() > usize(0), {
          line := body_indent.clone();
          line.push_string(body_code);
          line.push_str(";");
          em.emit_string_line(line);
        })
      );
    },
    .None => ()
  );
  // Un-shadow the payload binding (added at its declaration above) so the
  // shadow does not leak into the null arm or the outer scope.
  match(
    ptr_pattern,
    .Some(pat2) => match(
      pat2,
      .FnCall(_, _, pargs2, _, _) => match(
        pargs2.get(usize(0)),
        .Some(dvar2) => if(ast_expr_is_atom(dvar2), {
          _shadow_remove(context, sanitize_for_c_identifier(ast_expr_token(dvar2).value, false));
        }),
        .None => ()
      ),
      .Atom(_, _) => ()
    ),
    .None => ()
  );
  mid := indent.clone();
  mid.push_str("} else {");
  em.emit_string_line(mid);
  match(
    null_body,
    .Some(nb) => {
      body_code := generate_case_body(nb, body_indent.clone(), context);
      if(
        !is_unit && !_is_control_flow_code(body_code),
        match(
          temp_var_opt,
          .Some(tv) => {
            line := body_indent.clone();
            line.push_string(tv.clone());
            line.push_str(" = ");
            line.push_string(body_code.clone());
            line.push_str(";");
            em.emit_string_line(line);
          },
          .None => if(body_code.len() > usize(0), {
            line := body_indent.clone();
            line.push_string(body_code.clone());
            line.push_str(";");
            em.emit_string_line(line);
          })
        ),
        if(body_code.len() > usize(0), {
          line := body_indent.clone();
          line.push_string(body_code);
          line.push_str(";");
          em.emit_string_line(line);
        })
      );
    },
    .None => ()
  );
  close := indent.clone();
  close.push_str("}");
  em.emit_string_line(close);
  if(is_unit, String.from(""), match(temp_var_opt, .Some(tv) => tv, .None => String.from("")))
});
/// Simple (fieldless) enum match → C switch on the tag.
_gen_simple_enum_match :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext, matched_value_code : String, enum_type : TypeValue, deref_star : String, temp_var_opt : Option(String), is_unit : bool) -> String)({
  em := context.base.emitter;
  saved := context.base.inside_match;
  context.base.inside_match = true;
  body_indent := indent.clone();
  body_indent.push_str("  ");
  hdr := indent.clone();
  hdr.push_str("switch (");
  hdr.push_string(deref_star);
  hdr.push_string(matched_value_code);
  hdr.push_str(") {");
  em.emit_string_line(hdr);
  args := _args(expr);
  n := args.len();
  (i : usize) = usize(1);
  while(i < n, {
    match(
      args.get(i),
      .Some(ce) => if(ast_expr_is_fn_call_of(ce, "=>", Option(usize).Some(usize(2))), {
        cargs := _args(ce);
        match(
          cargs.get(usize(0)),
          .Some(cv) => match(
            cargs.get(usize(1)),
            .Some(cb) => if(_case_executed(cv, context), {
              if(ast_expr_is_atom(cv) && (ast_expr_token(cv).value == "_"), {
                d := indent.clone();
                d.push_str("default: {");
                em.emit_string_line(d);
                _emit_case_body_and_break(cb, indent.clone(), body_indent.clone(), temp_var_opt, is_unit, context);
                cl := indent.clone();
                cl.push_str("}");
                em.emit_string_line(cl);
              }, if(ast_expr_is_fn_call_of(cv, BF_DOT, Option(usize).Some(usize(1))), {
                variant_tag := get_enum_variant_c_name(enum_type, _variant_name(cv), context.base);
                h := indent.clone();
                h.push_str("case ");
                h.push_string(variant_tag);
                h.push_str(": {");
                em.emit_string_line(h);
                _emit_case_body_and_break(cb, indent.clone(), body_indent.clone(), temp_var_opt, is_unit, context);
                cl := indent.clone();
                cl.push_str("}");
                em.emit_string_line(cl);
              }));
            }),
            .None => ()
          ),
          .None => ()
        );
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  context.base.inside_match = saved;
  close := indent.clone();
  close.push_str("}");
  em.emit_string_line(close);
  if(is_unit, String.from(""), match(temp_var_opt, .Some(tv) => tv, .None => String.from("")))
});
/// Remove the shadows a tagged-union arm's destructuring added, mirroring the
/// var extraction in `_emit_destructure_binds` (labeled `label : var` → var is
/// arg[1]; positional → the atom itself). Called after the arm body.
_remove_arm_shadows :: (fn(params : ArrayList(AstExpr), context : FunctionGenerationContext) -> unit)({
  // Mirror the curly unwrap in _emit_destructure_binds so curly-bound vars are
  // also un-shadowed.
  is_curly := ((params.len() == usize(1)) && match(params.get(usize(0)), .Some(p0) => ast_expr_is_fn_call_of(p0, "_", Option(usize).None), .None => false));
  dparams := if(is_curly, match(params.get(usize(0)), .Some(p0) => _args(p0), .None => params.clone()), params.clone());
  np := dparams.len();
  (pi : usize) = usize(0);
  while(pi < np, {
    match(
      dparams.get(pi),
      .Some(p) => {
        var_atom := if(ast_expr_is_fn_call_of(p, ":", Option(usize).Some(usize(2))), match(_args(p).get(usize(1)), .Some(v) => v, .None => p), p);
        if(ast_expr_is_atom(var_atom) && !(ast_expr_token(var_atom).value == "_"), {
          _shadow_remove(context, sanitize_for_c_identifier(ast_expr_token(var_atom).value, false));
        });
      },
      .None => ()
    );
    pi = (pi + usize(1));
  });
});
/// Emit the destructuring binds for a tagged-union arm: `<T> <v> =
/// <matched><access>data.<Variant>.<field>;` per bound field, via the EnumT
/// parallel arrays (variant_names / variant_field_labels / variant_fields).
/// Labeled (`.Circle(r : radius)`) and positional (`.Point(x, y)`) forms.
/// Each bound var's source name is added to local_shadowed_variables so the
/// arm body resolves it to the local C declaration (not the evaluator temp);
/// the caller removes them after the body. (SM storage is Phase 5 — gated.)
_emit_destructure_binds :: (fn(enum_type : TypeValue, variant_name : String, params : ArrayList(AstExpr), matched_value_code : String, access : str, body_indent : String, context : FunctionGenerationContext) -> unit)(
  match(
    enum_type,
    .EnumT({ variant_names : vns, variant_fields : vfs, variant_field_labels : vfls }) => {
      em := context.base.emitter;
      // A match-arm variant pattern carries the leading `.` of `.Variant`; the
      // EnumT's variant_names are clean. Strip it so the lookup matches (else no
      // bind is emitted and the body references an undeclared variable) and so
      // the `.data.<variant>` field name is valid.
      cvariant := if(variant_name.starts_with("."), variant_name.substring(usize(1), variant_name.len()), variant_name.clone());
      // Find the variant index.
      (vi : usize) = vns.len();
      nv := vns.len();
      (vk : usize) = usize(0);
      while(vk < nv, {
        match(
          vns.get(vk),
          .Some(vn) => if(vn == cvariant, {
            vi = vk;
          }),
          .None => ()
        );
        vk = (vk + usize(1));
      });
      if(vi < nv, {
        labels := match(vfls.get(vi), .Some(l) => l, .None => ArrayList(String).new());
        types := match(vfs.get(vi), .Some(t) => t, .None => ArrayList(TypeValue).new());
        // Curly destructuring `.Variant({a, b : alias})`: the single param is a
        // `_`(...) call (the evaluator's curly representation). Lift its inner
        // args so the labeled/positional logic below binds the fields. (`{a}`
        // atoms bind positionally to the field at that index — correct when the
        // curly fields are in declaration order; `{a : alias}` `:` pairs bind by
        // label.)
        is_curly := ((params.len() == usize(1)) && match(params.get(usize(0)), .Some(p0) => ast_expr_is_fn_call_of(p0, "_", Option(usize).None), .None => false));
        dparams := if(is_curly, match(params.get(usize(0)), .Some(p0) => _args(p0), .None => params.clone()), params.clone());
        // Labeled if any param is a `:`(2) pair.
        (has_labeled : bool) = false;
        np := dparams.len();
        (pk : usize) = usize(0);
        while(pk < np, {
          match(
            dparams.get(pk),
            .Some(p) => if(ast_expr_is_fn_call_of(p, ":", Option(usize).Some(usize(2))), {
              has_labeled = true;
            }),
            .None => ()
          );
          pk = (pk + usize(1));
        });
        if(has_labeled, {
          (pi : usize) = usize(0);
          while(pi < np, {
            match(
              dparams.get(pi),
              .Some(param) => if(ast_expr_is_fn_call_of(param, ":", Option(usize).Some(usize(2))), {
                pargs := _args(param);
                label := match(pargs.get(usize(0)), .Some(le) => if(ast_expr_is_atom(le), ast_expr_token(le).value, String.from("")), .None => String.from(""));
                match(
                  pargs.get(usize(1)),
                  .Some(var_expr) => if(ast_expr_is_atom(var_expr) && !(ast_expr_token(var_expr).value == "_") && (label.len() > usize(0)), {
                    // Find the field index for this label.
                    (fi : usize) = labels.len();
                    nl := labels.len();
                    (lk : usize) = usize(0);
                    while(lk < nl, {
                      match(
                        labels.get(lk),
                        .Some(fl) => if(fl == label, {
                          fi = lk;
                        }),
                        .None => ()
                      );
                      lk = (lk + usize(1));
                    });
                    if(fi < labels.len(), {
                      ftype := match(types.get(fi), .Some(t) => t, .None => TypeValue.Unit);
                      if(!is_unit_type(ftype), {
                        init := matched_value_code.clone();
                        init.push_str(access);
                        init.push_str("data.");
                        init.push_string(cvariant.clone());
                        init.push_str(".");
                        init.push_string(sanitize_for_c_identifier(label.clone(), false));
                        _emit_pattern_binding_decl(
                          context,
                          body_indent.clone(),
                          sanitize_for_c_identifier(ast_expr_token(var_expr).value, false),
                          ftype,
                          init
                        );
                        _shadow_add(context, sanitize_for_c_identifier(ast_expr_token(var_expr).value, false));
                      });
                    });
                  }),
                  .None => ()
                );
              }),
              .None => ()
            );
            pi = (pi + usize(1));
          });
        }, {
          // Positional.
          limit := if(np < labels.len(), np, labels.len());
          (fi : usize) = usize(0);
          while(fi < limit, {
            match(
              dparams.get(fi),
              .Some(var_expr) => if(ast_expr_is_atom(var_expr) && !(ast_expr_token(var_expr).value == "_") && !pattern_param_is_literal(var_expr), {
                field_label := match(labels.get(fi), .Some(fl) => fl, .None => String.from(""));
                ftype := match(types.get(fi), .Some(t) => t, .None => TypeValue.Unit);
                if(!is_unit_type(ftype), {
                  init := matched_value_code.clone();
                  init.push_str(access);
                  init.push_str("data.");
                  init.push_string(cvariant.clone());
                  init.push_str(".");
                  init.push_string(sanitize_for_c_identifier(field_label, false));
                  _emit_pattern_binding_decl(
                    context,
                    body_indent.clone(),
                    sanitize_for_c_identifier(ast_expr_token(var_expr).value, false),
                    ftype,
                    init
                  );
                  _shadow_add(context, sanitize_for_c_identifier(ast_expr_token(var_expr).value, false));
                });
              }),
              .None => ()
            );
            fi = (fi + usize(1));
          });
        });
      });
    },
    _ => ()
  )
);
/// The variant name + destructuring params of a tagged-union arm pattern,
/// handling both parse forms (`."(Variant, p...)` and `(.Variant)(p...)`).
/// Returns ("", empty) if the pattern is not a variant.
_arm_variant_and_params :: (fn(case_value : AstExpr) -> Option(String))(
  match(case_value, .FnCall(_, func, args, _, _) => match(func, .Atom(_, tok) => if((tok.value == BF_DOT) && (args.len() >= usize(1)), match(args.get(usize(0)), .Some(v) => Option(String).Some(ast_expr_token(v).value), .None => Option(String).None), Option(String).None), .FnCall(_, ffunc, fargs, _, _) => if(match(ffunc, .Atom(_, ft) => (ft.value == BF_DOT), .FnCall(_, _, _, _, _) => false) && (fargs.len() == usize(1)), match(fargs.get(usize(0)), .Some(v) => Option(String).Some(ast_expr_token(v).value), .None => Option(String).None), Option(String).None)), .Atom(_, _) => Option(String).None)
);
/// The destructuring params of a tagged-union arm: `args[1..]` for form 1
/// (func is the `.` atom) or all `args` for form 2 (func is `.Variant`).
_arm_params :: (fn(case_value : AstExpr) -> ArrayList(AstExpr))(
  match(
    case_value,
    .FnCall(_, func, args, _, _) => match(
      func,
      .Atom(_, _) => {
        out := ArrayList(AstExpr).new();
        n := args.len();
        (i : usize) = usize(1);
        while(i < n, {
          match(
            args.get(i),
            .Some(a) => {
              out.push(a);
            },
            .None => ()
          );
          i = (i + usize(1));
        });
        out
      },
      .FnCall(_, _, _, _, _) => args
    ),
    .Atom(_, _) => ArrayList(AstExpr).new()
  )
);
/// Emit ONE variant arm's contents (destructure binds, `=> rename` binding,
/// body, break) inside an already-open `case TAG: {` block, guarded by the
/// arm's literal-payload comparisons when it has any (an unguarded arm is
/// the variant's catch-all and takes everything left, in source order).
_emit_variant_arm_body :: (
  fn(
    cb0 : AstExpr,
    params : ArrayList(AstExpr),
    variant_name : String,
    guards : String,
    enum_type : TypeValue,
    matched_value_code : String,
    access : str,
    indent : String,
    body_indent : String,
    temp_var_opt : Option(String),
    is_unit : bool,
    context : FunctionGenerationContext
  ) -> unit
)({
  em := context.base.emitter;
  if(guards.len() > usize(0), {
    g := body_indent.clone();
    g.push_str("if (");
    g.push_string(guards);
    g.push_str(") {");
    em.emit_string_line(g);
  });
  arm_indent := if(guards.len() > usize(0), {
    gi := body_indent.clone();
    gi.push_str("  ");
    gi
  }, indent.clone());
  arm_body_indent := if(guards.len() > usize(0), {
    gi := body_indent.clone();
    gi.push_str("  ");
    gi.push_str("  ");
    gi
  }, body_indent.clone());
  if(params.len() > usize(0), {
    _emit_destructure_binds(enum_type, variant_name, params, matched_value_code.clone(), access, arm_body_indent.clone(), context);
  });
  _emit_case_body_and_break(cb0, arm_indent.clone(), arm_body_indent.clone(), temp_var_opt, is_unit, context);
  _remove_arm_shadows(params, context);
  if(guards.len() > usize(0), {
    gc := body_indent.clone();
    gc.push_str("}");
    em.emit_string_line(gc);
  });
});
/// Tagged-union enum match → C switch on the tag with per-arm destructuring.
_gen_tagged_union_match :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext, matched_value_code : String, match_value_type : TypeValue, enum_type : TypeValue, is_ref_or_ptr : bool, temp_var_opt : Option(String), is_unit : bool) -> String)({
  em := context.base.emitter;
  saved := context.base.inside_match;
  context.base.inside_match = true;
  body_indent := indent.clone();
  body_indent.push_str("  ");
  access := if(is_ref_or_ptr, "->", ".");
  tag_expr := if(is_ref_or_ptr, {
    t := matched_value_code.clone();
    t.push_str("->tag");
    t
  }, {
    t := String.from("(");
    t.push_string(matched_value_code.clone());
    t.push_str(").tag");
    t
  });
  hdr := indent.clone();
  hdr.push_str("switch (");
  hdr.push_string(tag_expr);
  hdr.push_str(") {");
  em.emit_string_line(hdr);
  args := _args(expr);
  n := args.len();
  // Same-variant arms share ONE case label: a variant whose payload is
  // discriminated by literals (`.Some(false)` vs `.Some(true)`) lowers to
  // the case with per-arm `if (<payload> == <literal>)` guards, in source
  // order — an unguarded arm of the same variant is its catch-all. Two
  // `case TAG:` blocks for one tag is a C error (duplicate case value), and
  // the evaluator's arm selection has compared literal payloads since
  // issues/fixed/enum-pattern-bool-payload-not-compared.md.
  group_variant_names := ArrayList(String).new();
  group_arm_indices := ArrayList(ArrayList(usize)).new();
  (gi : usize) = usize(1);
  while(gi < n, {
    match(
      args.get(gi),
      .Some(ce) => if(ast_expr_is_fn_call_of(ce, "=>", Option(usize).Some(usize(2))), {
        cv_g := match(_args(ce).get(usize(0)), .Some(x) => x, .None => make_err_expr());
        if(_case_executed(cv_g, context), {
          match(
            _arm_variant_and_params(cv_g),
            .Some(vname) => {
              (found_at : Option(usize)) = Option(usize).None;
              (si : usize) = usize(0);
              while((si < group_variant_names.len()) && found_at.is_none(), {
                match(
                  group_variant_names.get(si),
                  .Some(gv) => if(gv == vname, {
                    found_at = Option(usize).Some(si);
                  }),
                  .None => ()
                );
                si = (si + usize(1));
              });
              match(
                found_at,
                .Some(gi2) => {
                  match(
                    group_arm_indices.get(gi2),
                    .Some(list) => {
                      list.push(gi);
                    },
                    .None => ()
                  );
                },
                .None => {
                  group_variant_names.push(vname.clone());
                  fresh_list := ArrayList(usize).new();
                  fresh_list.push(gi);
                  group_arm_indices.push(fresh_list);
                }
              );
            },
            .None => ()
          );
        });
      }),
      .None => ()
    );
    gi = (gi + usize(1));
  });
  // Emit: the `_` default arm at its source position, and each variant
  // group at its FIRST arm's position.
  emitted_arm := ArrayList(bool).new();
  (zi : usize) = usize(0);
  while(zi < n, {
    emitted_arm.push(false);
    zi = (zi + usize(1));
  });
  (i : usize) = usize(1);
  while(i < n, {
    match(
      args.get(i),
      .Some(ce) => if(ast_expr_is_fn_call_of(ce, "=>", Option(usize).Some(usize(2))), {
        cargs := _args(ce);
        match(
          cargs.get(usize(0)),
          .Some(cv) => match(
            cargs.get(usize(1)),
            .Some(cb0) => if(_case_executed(cv, context), {
              if(ast_expr_is_atom(cv) && (ast_expr_token(cv).value == "_"), {
                d := indent.clone();
                d.push_str("default: {");
                em.emit_string_line(d);
                _emit_case_body_and_break(cb0, indent.clone(), body_indent.clone(), temp_var_opt, is_unit, context);
                cl := indent.clone();
                cl.push_str("}");
                em.emit_string_line(cl);
              }, match(
                _arm_variant_and_params(cv),
                .Some(variant_name) => {
                  // First arm of this variant's group? Find the group index.
                  (group_idx : Option(usize)) = Option(usize).None;
                  (si2 : usize) = usize(0);
                  while((si2 < group_variant_names.len()) && group_idx.is_none(), {
                    match(
                      group_variant_names.get(si2),
                      .Some(gv) => if(gv == variant_name, {
                        group_idx = Option(usize).Some(si2);
                      }),
                      .None => ()
                    );
                    si2 = (si2 + usize(1));
                  });
                  match(
                    group_idx,
                    .Some(g) => {
                      match(
                        group_arm_indices.get(g),
                        .Some(arm_list) => {
                          first_idx := match(arm_list.get(usize(0)), .Some(x) => x, .None => usize(0));
                          if(first_idx == i, {
                            // Open the case once; emit every arm of the group.
                            variant_tag := get_enum_variant_c_name(enum_type, variant_name.clone(), context.base);
                            h := indent.clone();
                            h.push_str("case ");
                            h.push_string(variant_tag);
                            h.push_str(": {");
                            em.emit_string_line(h);
                            (ai : usize) = usize(0);
                            while(ai < arm_list.len(), {
                              match(
                                arm_list.get(ai),
                                .Some(arm_i) => {
                                  match(
                                    args.get(arm_i),
                                    .Some(arm_ce) => if(ast_expr_is_fn_call_of(arm_ce, "=>", Option(usize).Some(usize(2))), {
                                      arm_cargs := _args(arm_ce);
                                      arm_cv := match(arm_cargs.get(usize(0)), .Some(x) => x, .None => make_err_expr());
                                      arm_cb := match(arm_cargs.get(usize(1)), .Some(x) => x, .None => make_err_expr());
                                      arm_params := _arm_params(arm_cv);
                                      guards := pattern_literal_arm_guards(enum_type, variant_name, arm_params, matched_value_code.clone(), access);
                                      _emit_variant_arm_body(arm_cb, arm_params, variant_name, guards, enum_type, matched_value_code.clone(), access, indent.clone(), body_indent.clone(), temp_var_opt, is_unit, context);
                                    }),
                                    .None => ()
                                  );
                                  ai = (ai + usize(1));
                                },
                                .None => ()
                              );
                            });
                            // No guarded arm matched: leave the case without
                            // running anything (same shape as a tag with no
                            // default today) — but never fall into the next
                            // case's block.
                            br := body_indent.clone();
                            br.push_str("break;");
                            em.emit_string_line(br);
                            cl := indent.clone();
                            cl.push_str("}");
                            em.emit_string_line(cl);
                          }, {
                            // Not the group's first arm: already emitted above.
                            ();
                          });
                        },
                        .None => ()
                      );
                    },
                    .None => ()
                  );
                },
                .None => ()
              ));
            }),
            .None => ()
          ),
          .None => ()
        );
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  context.base.inside_match = saved;
  close := indent.clone();
  close.push_str("}");
  em.emit_string_line(close);
  generate_deferred_drop_expressions(expr, indent.clone(), context, true);
  if(is_unit, String.from(""), match(temp_var_opt, .Some(tv) => tv, .None => String.from("")))
});
