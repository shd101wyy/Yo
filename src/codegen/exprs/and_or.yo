//! Short-circuit `&&` / `||` emitters — mirrors `src/codegen/exprs/and-or.ts`.
//!
//! When every argument is side-effect-free the operator lowers to C's native
//! `&&`/`||`. When an argument beyond the first may emit statements (temp
//! declarations, calls), an if-chain is emitted instead so evaluation order /
//! short-circuiting is preserved:
//!   bool __yo_sc = false;  Type t1 = a; if (t1) { Type t2 = b; __yo_sc = t2; }
//! Compile-time `true`/`false` operands are folded away (and short-circuit the
//! whole expression). DIVERGENCE (documented): TS seeds the result-var name
//! from a module-level counter; yo-self uses `random_id` (uniqueness only —
//! same choice as loop labels — so a module-level mutable global isn't needed,
//! which keeps the Phase-6 self-host fixpoint happy).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ AstExpr, ast_expr_is_fn_call_of, ast_expr_id, BK_OP_AND, BK_OP_OR } :: import("../../expr.yo");
{ EvalValue } :: import("../../value.yo");
{ random_id, is_temp_variable_name } :: import("../../utils.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ get_deferred_drop_target_atom_name, sanitize_for_c_identifier, scope_stack_contains, is_deferred_drop_for_closure_capture } :: import("../utils/index.yo");
{ _looks_like_minted_temp } :: import("./begin.yo");
/// Record that the short-circuit family has emitted a drop for `target` in this
/// function. MONOTONE: never removed. See
/// `FunctionGenerationContext.short_circuit_emitted_drop_targets`.
_mark_sc_target_emitted :: (fn(target : String, context : FunctionGenerationContext) -> unit)({
  match(
    context.short_circuit_emitted_drop_targets,
    .Some(_) => (),
    .None => {
      context.short_circuit_emitted_drop_targets = Option(HashSet(String)).Some(HashSet(String).new());
    }
  );
  match(
    context.short_circuit_emitted_drop_targets,
    .Some(em_set) => {
      _i := em_set.insert(target);
    },
    .None => ()
  );
});
/// `base` followed by `n` levels of two-space indent.
_indent_n :: (fn(base : String, n : usize) -> String)({
  out := base.clone();
  (i : usize) = usize(0);
  while(i < n, {
    out.push_str("  ");
    i = (i + usize(1));
  });
  out
});
/// The compile-time boolean value of `arg`, if it has one.
_comptime_bool :: (fn(arg : AstExpr, context : FunctionGenerationContext) -> Option(bool))(
  match(
    context.base.get_expr_info(arg),
    .Some(ei) => match(ei.value, .Some(v) => match(v, .BoolVal(b) => Option(bool).Some(b), _ => Option(bool).None), .None => Option(bool).None),
    .None => Option(bool).None
  )
);
/// Whether `generate_expr` for this node might emit side-effectful statements
/// (a temp declaration or call). Atoms / compile-time values are safe. Mirrors
/// `exprMayHaveSideEffects`.
_expr_may_have_side_effects :: (fn(expr : AstExpr, context : FunctionGenerationContext) -> bool)({
  ei_opt := context.base.get_expr_info(expr);
  has_var := match(ei_opt, .Some(ei) => match(ei.variable_name, .Some(_) => true, .None => false), .None => false);
  if(has_var, {
    return(true);
  });
  has_value := match(ei_opt, .Some(ei) => match(ei.value, .Some(_) => true, .None => false), .None => false);
  if(has_value, {
    return(false);
  });
  match(
    expr,
    .FnCall(_, func, args, _, _) => {
      n := args.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          args.get(i),
          .Some(arg) => if(recur(arg, context), {
            return(true);
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      recur(func, context)
    },
    .Atom(_, _) => false
  )
});
/// Collect the variable names newly CREATED by an expression tree (temps from
/// function-call results). For nested `&&`/`||`, only the first (unconditional)
/// arg is descended into. Mirrors `collectCreatedVarNamesFromExpr`.
_collect_created_var_names_from_expr :: (fn(expr : AstExpr, result : HashSet(String), context : FunctionGenerationContext) -> unit)(
  match(
    expr,
    .FnCall(_, func, args, _, _) => {
      match(
        context.base.get_expr_info(expr),
        .Some(ei) => {
          match(
            ei.variable_name,
            .Some(vn) => {
              _a := result.insert(vn.clone());
            },
            .None => ()
          );
          // Deferred `___dup` results are temps too — declared next to the
          // expression they balance (inside this conditional branch) but
          // living in the ExprInfo side-channel, not the syntactic tree.
          // Without this, an aliasing-Stage-0 borrow dup on a projection
          // argument inside a short-circuit RHS (`a && f(w.b)`) left its
          // scope-end drop at the outer block level — an undeclared C
          // identifier and an unconditional drop for a conditionally-run
          // dup. Mirrors TS and-or.ts collectCreatedVarNamesFromExpr.
          match(
            ei.deferred_dup_expressions,
            .Some(dups) => {
              nd := dups.len();
              (di : usize) = usize(0);
              while(di < nd, {
                match(
                  dups.get(di),
                  .Some(de) => match(
                    context.base.get_expr_info(de),
                    .Some(dei) => match(
                      dei.variable_name,
                      .Some(dvn) => {
                        _b := result.insert(dvn.clone());
                      },
                      .None => ()
                    ),
                    .None => ()
                  ),
                  .None => ()
                );
                di = (di + usize(1));
              });
            },
            .None => ()
          );
        },
        .None => ()
      );
      is_nested := (ast_expr_is_fn_call_of(expr, BK_OP_AND, Option(usize).None) || ast_expr_is_fn_call_of(expr, BK_OP_OR, Option(usize).None));
      if(is_nested, {
        if(args.len() > usize(0), {
          match(args.get(usize(0)), .Some(a0) => recur(a0, result, context), .None => ());
        });
      }, {
        n := args.len();
        (i : usize) = usize(0);
        while(i < n, {
          match(args.get(i), .Some(arg) => recur(arg, result, context), .None => ());
          i = (i + usize(1));
        });
        recur(func, result, context);
      });
    },
    .Atom(_, _) => ()
  )
);
/// Emit, from `list_owner`'s own deferred-drop list, the drops whose target is
/// in `var_names` — the source that closes the single-expression-fn-body hole
/// (no codegen begin opens there, so the pending channel is empty).
///
/// Five gates, each closing a documented failure class:
///
///   1. MONOTONE emitted-targets — the short-circuit family already dropped
///      this target in this function. A chain considers the same operand temp
///      at the inner node's fall-through AND the outer node's, both at
///      function scope and each through a DIFFERENT drop-expr identity, so
///      neither the id guard nor the consume-once handled set can see it.
///   2. the consume-once handled set — a begin-opened shape reaches the same
///      target through the pending source with a different identity. NOT
///      consumed here: the pending-side emission it records must still
///      suppress the begin-end flush.
///   3. the expr-id emitted-once guard (PR #403).
///   4. the closure-capture skip every guarded flush applies.
///   5. the block-scope stack — the target's C declaration must have been
///      EMITTED and still be IN SCOPE at this point. This is what keeps an
///      inner operand's temp from being dropped at an OUTER fall-through,
///      where its block has already closed.
///
/// A gate-skipped drop is left untouched for the node's other owners.
_emit_node_list_drops :: (
  fn(list_owner : AstExpr, var_names : HashSet(String), indent : String, context : FunctionGenerationContext) -> unit
)(
  match(
    context.base.get_expr_info(list_owner),
    .Some(nei) => match(
      nei.deferred_drop_expressions,
      .Some(node_drops) => {
        nd2 := node_drops.len();
        (j : usize) = usize(0);
        while(j < nd2, {
          match(
            node_drops.get(j),
            .Some(nd_drop) => match(
              get_deferred_drop_target_atom_name(nd_drop),
              .Some(ntarget) => if(var_names.contains(ntarget.clone()), {
                already_emitted := match(
                  context.short_circuit_emitted_drop_targets,
                  .Some(em_set) => em_set.contains(ntarget.clone()),
                  .None => false
                );
                n_handled := match(
                  context.short_circuit_handled_drop_var_names,
                  .Some(nh) => nh.contains(ntarget.clone()),
                  .None => false
                );
                if(!already_emitted && !n_handled && !context.emitted_deferred_drop_ids.contains(ast_expr_id(nd_drop)) && !is_deferred_drop_for_closure_capture(nd_drop, context.current_closure_captures), {
                  n_cn := sanitize_for_c_identifier(ntarget.clone(), false);
                  n_undeclared := ((is_temp_variable_name(String.from(""), n_cn.clone()) || _looks_like_minted_temp(n_cn.clone())) && !context.base.declared_c_var_names.contains(n_cn));
                  if(!n_undeclared && scope_stack_contains(context.base.declared_scopes, n_cn), {
                    // `_call_generate_expr` on a drop expr may EMIT and return "".
                    // An enum/Option-typed target lowers to a multi-line
                    // `switch` block that the drop generator writes to the
                    // emitter itself (drop_dup.yo), handing back an empty
                    // string. So the drop is already on the page here, and
                    // bookkeeping hung off `len() > 0` would never run for
                    // exactly those targets — leaving the drop emitted but
                    // UNRECORDED, so the next emission point considers it
                    // fresh and emits it a SECOND time. That is the
                    // double-drop that sank two earlier attempts at the chain
                    // fix; record unconditionally, emit conditionally.
                    nd_code := _call_generate_expr(nd_drop, indent.clone(), context);
                    _ng := context.emitted_deferred_drop_ids.insert(ast_expr_id(nd_drop));
                    _mark_sc_target_emitted(ntarget.clone(), context);
                    match(
                      context.short_circuit_handled_drop_var_names,
                      .Some(ns) => {
                        _ni := ns.insert(ntarget);
                      },
                      .None => ()
                    );
                    if(nd_code.len() > usize(0), {
                      nline := indent.clone();
                      nline.push_string(nd_code);
                      nline.push_str(";");
                      nem := context.base.emitter;
                      nem.emit_string_line(nline);
                    });
                  });
                });
              }, ()),
              .None => ()
            ),
            .None => ()
          );
          j = (j + usize(1));
        });
      },
      .None => ()
    ),
    .None => ()
  )
);
/// Emit drops for temps created inside a short-circuit conditional branch,
/// from TWO sources: the enclosing scope's pending deferred drops (removed
/// from the pending set so scope end does not drop them again), and — when
/// `node_expr` is given — the SHORT-CIRCUIT NODE'S OWN deferred-drop list,
/// filtered to the same var_names. The second source is what closes the
/// single-expression fn body hole: a `||`/`&&` that IS a whole body takes
/// the non-begin path, no codegen begin opens, `pending` is EMPTY, and the
/// operand temps' scope drops ride the shared body node's ExprInfo list
/// with no other emission point (the body-level flush-first gate-skips
/// them as not-yet-declared; the implicit-return tail flushes param drops
/// only). Emissions from either source insert into the emitted-once guard
/// and the short-circuit handled set, so begin-opened shapes (where the
/// same drops are reachable through BOTH sources) emit exactly once.
/// Mirrors `emitDropsForConditionalBranch` (the node source is Yo-only).
_emit_drops_for_conditional_branch :: (
  fn(
    var_names : HashSet(String),
    indent : String,
    context : FunctionGenerationContext,
    (node_expr : Option(AstExpr)) ?= Option(AstExpr).None
  ) -> unit
)(
  if(var_names.len() > usize(0), {
    match(
      context.short_circuit_handled_drop_var_names,
      .Some(_) => (),
      .None => {
        context.short_circuit_handled_drop_var_names = Option(HashSet(String)).Some(HashSet(String).new());
      }
    );
    match(
      context.pending_deferred_drops,
      .Some(pending_drops) => {
        new_pending := ArrayList(AstExpr).new();
        (removed : usize) = usize(0);
        n := pending_drops.len();
        (i : usize) = usize(0);
        while(i < n, {
          match(
            pending_drops.get(i),
            .Some(drop_expr) => match(
              get_deferred_drop_target_atom_name(drop_expr),
              .Some(target) => if(var_names.contains(target.clone()), {
                // Skip a drop whose target TEMP was never emitted as a C
                // declaration (e.g. an aliasing-Stage-0 dup RESULT temp whose
                // dup was itself gate-skipped) — same undeclared-temp gate as
                // generate_deferred_drop_expressions. A never-declared temp
                // holds no +1 to release; emitting the drop is an undeclared-
                // identifier C error (the rc1 stage-2 clang break).
                sc_target_cn := sanitize_for_c_identifier(target.clone(), false);
                sc_undeclared := ((is_temp_variable_name(String.from(""), sc_target_cn.clone()) || _looks_like_minted_temp(sc_target_cn.clone())) && !context.base.declared_c_var_names.contains(sc_target_cn));
                if(!sc_undeclared, {
                  drop_code := _call_generate_expr(drop_expr, indent.clone(), context);
                  // Same decoupling as the node source below: the generator
                  // may have emitted a multi-line drop already and returned "".
                  _g := context.emitted_deferred_drop_ids.insert(ast_expr_id(drop_expr));
                  _mark_sc_target_emitted(target.clone(), context);
                  if(drop_code.len() > usize(0), {
                    line := indent.clone();
                    line.push_string(drop_code);
                    line.push_str(";");
                    em := context.base.emitter;
                    em.emit_string_line(line);
                  });
                });
                match(
                  context.short_circuit_handled_drop_var_names,
                  .Some(s) => {
                    _a := s.insert(target);
                  },
                  .None => ()
                );
                removed = (removed + usize(1));
              }, {
                _p := new_pending.push(drop_expr);
              }),
              .None => {
                _p := new_pending.push(drop_expr);
              }
            ),
            .None => ()
          );
          i = (i + usize(1));
        });
        if(removed > usize(0), {
          context.pending_deferred_drops = Option(ArrayList(AstExpr)).Some(new_pending);
        });
      },
      .None => ()
    );
    // The node's OWN list, then — for a chain's inner node, whose own list is
    // empty because its operand temps' drops were scheduled onto the
    // outermost/body node — the ROOT's list.
    match(
      node_expr,
      .Some(ne) => {
        _emit_node_list_drops(ne, var_names, indent.clone(), context);
        match(
          context.short_circuit_root_node,
          .Some(root) => if(ast_expr_id(root) != ast_expr_id(ne), {
            _emit_node_list_drops(root, var_names, indent.clone(), context);
          }),
          .None => ()
        );
      },
      .None => ()
    );
  })
);
/// `&&` operator with short-circuit evaluation. Mirrors `generateOpAnd`.
generate_op_and :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)({
  args := match(expr, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  if(args.len() == usize(0), {
    return(String.from("true"));
  });
  if(args.len() == usize(1), {
    return(_call_generate_expr(match(args.get(usize(0)), .Some(a) => a, .None => expr), indent.clone(), context));
  });
  // Fold compile-time operands: a `false` short-circuits, a `true` is dropped.
  runtime_args := ArrayList(AstExpr).new();
  n := args.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      args.get(i),
      .Some(arg) => match(
        _comptime_bool(arg, context),
        .Some(b) => if(!b, {
          return(String.from("false"));
        }),
        .None => {
          _p := runtime_args.push(arg);
        }
      ),
      .None => ()
    );
    i = (i + usize(1));
  });
  if(runtime_args.len() == usize(0), {
    return(String.from("true"));
  });
  rn := runtime_args.len();
  if(rn == usize(1), {
    return(_call_generate_expr(match(runtime_args.get(usize(0)), .Some(a) => a, .None => expr), indent.clone(), context));
  });
  // Does any arg beyond the first need an if-chain?
  (needs : bool) = false;
  (k : usize) = usize(1);
  while(k < rn, {
    match(
      runtime_args.get(k),
      .Some(arg) => if(_expr_may_have_side_effects(arg, context), {
        needs = true;
      }),
      .None => ()
    );
    k = (k + usize(1));
  });
  if(!needs, {
    out := String.from("(");
    (m : usize) = usize(0);
    while(m < rn, {
      match(
        runtime_args.get(m),
        .Some(arg) => {
          if(m > usize(0), {
            out.push_str(" && ");
          });
          out.push_string(_call_generate_expr(arg, indent.clone(), context));
        },
        .None => ()
      );
      m = (m + usize(1));
    });
    out.push_str(")");
    return(out);
  });
  // This construct is the ROOT short circuit unless an enclosing one already
  // claimed it. A chain parses as NESTED binaries and only the outermost node
  // carries the operand temps' scope drops, so the inner nodes' emission
  // points read the root's list (`_emit_node_list_drops`). Restored on the way
  // out so sibling short circuits each get their own root.
  prev_sc_root := context.short_circuit_root_node;
  match(
    prev_sc_root,
    .Some(_) => (),
    .None => {
      context.short_circuit_root_node = Option(AstExpr).Some(expr);
    }
  );
  sc_var := String.from("__yo_sc_");
  sc_var.push_string(random_id(String.from("")));
  em := context.base.emitter;
  d := indent.clone();
  d.push_str("bool ");
  d.push_string(sc_var.clone());
  d.push_str(" = false;");
  em.emit_string_line(d);
  depth := (rn - usize(1));
  (level : usize) = usize(0);
  (i2 : usize) = usize(0);
  while(i2 < rn, {
    ci := _indent_n(indent.clone(), level);
    match(
      runtime_args.get(i2),
      .Some(arg) => {
        arg_code := _call_generate_expr(arg, ci.clone(), context);
        if(i2 < (rn - usize(1)), {
          line := ci.clone();
          line.push_str("if (");
          line.push_string(arg_code);
          line.push_str(") {");
          em.emit_string_line(line);
          level = (level + usize(1));
        }, {
          line := ci.clone();
          line.push_string(sc_var.clone());
          line.push_str(" = ");
          line.push_string(arg_code);
          line.push_str(";");
          em.emit_string_line(line);
        });
      },
      .None => ()
    );
    i2 = (i2 + usize(1));
  });
  (c : usize) = depth;
  while(c > usize(0), {
    conditional_arg := match(runtime_args.get(c), .Some(a) => a, .None => expr);
    var_names := HashSet(String).new();
    _collect_created_var_names_from_expr(conditional_arg, var_names, context);
    drops_indent := _indent_n(indent.clone(), level);
    _emit_drops_for_conditional_branch(var_names, drops_indent, context, Option(AstExpr).Some(expr));
    level = (level - usize(1));
    close_indent := _indent_n(indent.clone(), level);
    cl := close_indent.clone();
    cl.push_str("}");
    em.emit_string_line(cl);
    c = (c - usize(1));
  });
  // The FIRST operand is evaluated UNCONDITIONALLY, so its created temps
  // have no in-branch emission point (the closing loop above covers operands
  // 1..n inside their braces) — and without this, nothing else flushes them:
  // the body-level flush-first gate-skips them (their C declarations do not
  // exist yet), and the implicit-return tail flushes param-targeted drops
  // only. Both operand paths fall through to here, and the temps are dead
  // once the construct's value is decided — emit their drops AFTER all
  // braces via the same branch-drop helper (pending source + the || node's
  // own list filtered to this operand's temps; function scope, so the
  // block-scope gate holds). The leaks this closed: every
  // `(x == `lit`) || …` comparison's promoted-literal String temps — both
  // the begin-opened shapes (pending source,
  // issues/fixed/parser-multibyte-spec-tests-leak-under-linux-asan.md) and
  // the whole-fn-body shape (node source,
  // issues/short-circuit-bare-fn-body-operand-temps-leak.md).
  first_arg := match(runtime_args.get(usize(0)), .Some(a) => a, .None => expr);
  first_var_names := HashSet(String).new();
  _collect_created_var_names_from_expr(first_arg, first_var_names, context);
  _emit_drops_for_conditional_branch(first_var_names, indent.clone(), context, Option(AstExpr).Some(expr));
  context.short_circuit_root_node = prev_sc_root;
  sc_var
});
/// `||` operator with short-circuit evaluation. Mirrors `generateOpOr`.
generate_op_or :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)({
  args := match(expr, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  if(args.len() == usize(0), {
    return(String.from("false"));
  });
  if(args.len() == usize(1), {
    return(_call_generate_expr(match(args.get(usize(0)), .Some(a) => a, .None => expr), indent.clone(), context));
  });
  // Fold compile-time operands: a `true` short-circuits, a `false` is dropped.
  runtime_args := ArrayList(AstExpr).new();
  n := args.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      args.get(i),
      .Some(arg) => match(
        _comptime_bool(arg, context),
        .Some(b) => if(b, {
          return(String.from("true"));
        }),
        .None => {
          _p := runtime_args.push(arg);
        }
      ),
      .None => ()
    );
    i = (i + usize(1));
  });
  if(runtime_args.len() == usize(0), {
    return(String.from("false"));
  });
  rn := runtime_args.len();
  if(rn == usize(1), {
    return(_call_generate_expr(match(runtime_args.get(usize(0)), .Some(a) => a, .None => expr), indent.clone(), context));
  });
  (needs : bool) = false;
  (k : usize) = usize(1);
  while(k < rn, {
    match(
      runtime_args.get(k),
      .Some(arg) => if(_expr_may_have_side_effects(arg, context), {
        needs = true;
      }),
      .None => ()
    );
    k = (k + usize(1));
  });
  if(!needs, {
    out := String.from("(");
    (m : usize) = usize(0);
    while(m < rn, {
      match(
        runtime_args.get(m),
        .Some(arg) => {
          if(m > usize(0), {
            out.push_str(" || ");
          });
          out.push_string(_call_generate_expr(arg, indent.clone(), context));
        },
        .None => ()
      );
      m = (m + usize(1));
    });
    out.push_str(")");
    return(out);
  });
  // This construct is the ROOT short circuit unless an enclosing one already
  // claimed it. A chain parses as NESTED binaries and only the outermost node
  // carries the operand temps' scope drops, so the inner nodes' emission
  // points read the root's list (`_emit_node_list_drops`). Restored on the way
  // out so sibling short circuits each get their own root.
  prev_sc_root := context.short_circuit_root_node;
  match(
    prev_sc_root,
    .Some(_) => (),
    .None => {
      context.short_circuit_root_node = Option(AstExpr).Some(expr);
    }
  );
  sc_var := String.from("__yo_sc_");
  sc_var.push_string(random_id(String.from("")));
  em := context.base.emitter;
  d := indent.clone();
  d.push_str("bool ");
  d.push_string(sc_var.clone());
  d.push_str(" = true;");
  em.emit_string_line(d);
  depth := (rn - usize(1));
  (level : usize) = usize(0);
  (i2 : usize) = usize(0);
  while(i2 < rn, {
    ci := _indent_n(indent.clone(), level);
    match(
      runtime_args.get(i2),
      .Some(arg) => {
        arg_code := _call_generate_expr(arg, ci.clone(), context);
        if(i2 < (rn - usize(1)), {
          line := ci.clone();
          line.push_str("if (!(");
          line.push_string(arg_code);
          line.push_str(")) {");
          em.emit_string_line(line);
          level = (level + usize(1));
        }, {
          line := ci.clone();
          line.push_string(sc_var.clone());
          line.push_str(" = ");
          line.push_string(arg_code);
          line.push_str(";");
          em.emit_string_line(line);
        });
      },
      .None => ()
    );
    i2 = (i2 + usize(1));
  });
  (c : usize) = depth;
  while(c > usize(0), {
    conditional_arg := match(runtime_args.get(c), .Some(a) => a, .None => expr);
    var_names := HashSet(String).new();
    _collect_created_var_names_from_expr(conditional_arg, var_names, context);
    drops_indent := _indent_n(indent.clone(), level);
    _emit_drops_for_conditional_branch(var_names, drops_indent, context, Option(AstExpr).Some(expr));
    level = (level - usize(1));
    close_indent := _indent_n(indent.clone(), level);
    cl := close_indent.clone();
    cl.push_str("}");
    em.emit_string_line(cl);
    c = (c - usize(1));
  });
  // Same first-operand fall-through drop emission as generate_op_and — the
  // unconditional operand's temps have no in-branch point and no later flush.
  first_arg := match(runtime_args.get(usize(0)), .Some(a) => a, .None => expr);
  first_var_names := HashSet(String).new();
  _collect_created_var_names_from_expr(first_arg, first_var_names, context);
  _emit_drops_for_conditional_branch(first_var_names, indent.clone(), context, Option(AstExpr).Some(expr));
  context.short_circuit_root_node = prev_sc_root;
  sc_var
});
export(generate_op_and, generate_op_or);
