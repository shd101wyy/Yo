//! `recur(...)` self-call emitter.
//!
//! KNOWN LIMITATION (none reached by the no-RC/no-effect corpus):
//! evidence-parameter forwarding for `using()`/effects (Phase 3/5).
{ String } :: import("std/string");
{ HashSet } :: import("std/collections/hash_set");
{ AstExpr, ast_expr_id, ast_expr_is_fn_call } :: import("../../expr.yo");
{ record_declared_temp_var, FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ get_variable_name_for_codegen_at, get_type_string, get_variable_type_string, fresh_local_name } :: import("../utils/index.yo");
{ Environment } :: import("../../env.yo");
{ is_unit_type } :: import("../../types/guards.yo");
{ expr_info_converted_runtime_type, expr_info_deferred_dup_expressions, scope_variables } :: import("../../expr_info.yo");
{ generate_deferred_dup_expressions, generate_deferred_drop_expressions } :: import("./drop_dup.yo");
{ emit_effect_unwind_check } :: import("./return.yo");
{ codegen_fatal_expr } :: import("../constants.yo");
/// Emit a recursive self-call `<currentFunctionName>(<args>)`. If the recur
/// has a result variable name, emit it into a named temp first (so enclosing
/// scope drops don't run before the call).
///
/// The call is wrapped in the escape protocol every may-unwind direct call
/// gets (`__yo_effect_escaped = 0; call; if (escaped) { drops; return …; }`).
/// A recursive callee can throw as readily as any other call — it runs the
/// same body — but this emitter never had the wrap, so an escape raised
/// inside the callee was LOST here: the next call's pre-call reset cleared
/// the flag and the caller CONTINUED with the callee's `{0}` early-return
/// value as if it were a result. In `compile_pattern`'s `(name := p)` case
/// that meant a `Pattern.At` with a NULL sub and a SIGSEGV the moment
/// anything walked it
/// (issues/fixed/at-pattern-subpattern-error-crashes-check.md).
generate_recur :: (fn(imm(expr) : AstExpr, imm(indent) : String, imm(context) : FunctionGenerationContext) -> String)({
  ei := match(context.base.get_expr_info(expr), .Some(e) => e, .None => return(codegen_fatal_expr(String.from("No arguments for recur call"))));
  match(
    ei.runtime_arg_exprs_in_order,
    .Some(arg_exprs) => {
      args_list := String.from("");
      n := arg_exprs.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          arg_exprs.get(i),
          .Some(arg) => {
            if(i > usize(0), {
              args_list.push_str(", ");
            });
            arg_code := _call_generate_expr(&arg, indent.clone(), context);
            // Strip `(*name)` to `name` for ref (inout) params — both the
            // caller and callee expect a pointer, so the deref is wrong.
            match(
              context.base.get_expr_info(&arg),
              .Some(aei) => match(
                aei.variable_name,
                .Some(vn) => {
                  arg_vars := scope_variables(ast_expr_id(&arg), &aei.env, vn.clone());
                  if((arg_vars.len() > usize(0)) && arg_code.starts_with("(*") && arg_code.ends_with(")"), {
                    match(
                      arg_vars.last(),
                      .Some(v) => if(v.is_ref, {
                        arg_code = arg_code.substring(usize(2), arg_code.len() - usize(1));
                      }),
                      .None => ()
                    );
                  });
                },
                .None => ()
              ),
              .None => ()
            );
            // Deferred `___dup` on a recur argument (aliasing Stage 0
            // projection dups): materialize the argument into its eval temp
            // FIRST — the dup names that temp, and without the declaration
            // the emitted C references an undeclared identifier while the
            // raw projection read is lost (arg_code is replaced by the dup
            // result below). get_variable_type_string is the
            // declared_c_var_names choke-point, so the dup emitter's
            // undeclared-temp gate sees the declaration
            // (`recur(K, V, h._left, key)` in
            // std/imm/sorted_map.yo _node_contains surfaced this).
            match(
              context.base.get_expr_info(&arg),
              .Some(aei2) => match(
                expr_info_deferred_dup_expressions(&aei2),
                .Some(dups) => if(dups.len() > usize(0), {
                  match(
                    aei2.variable_name,
                    .Some(avn) => {
                      sanitized_arg_temp := get_variable_name_for_codegen_at(ast_expr_id(&arg), avn.clone(), Option(Environment).Some(aei2.env));
                      if(!(arg_code == sanitized_arg_temp), {
                        already_arg := match(context.declared_temp_vars, .Some(s) => s.contains(sanitized_arg_temp.clone()), .None => false);
                        if(!already_arg, {
                          record_declared_temp_var(context, sanitized_arg_temp.clone());
                          eff_ty := match(expr_info_converted_runtime_type(&aei2), .Some(ct) => ct, .None => aei2.ty);
                          dline := indent.clone();
                          dline.push_string(get_variable_type_string(&eff_ty, avn.clone(), &context.base));
                          dline.push_str(" = ");
                          dline.push_string(arg_code.clone());
                          dline.push_str(";");
                          dem := context.base.emitter;
                          dem.emit_string_line(&dline);
                        });
                      });
                    },
                    .None => ()
                  );
                  generate_deferred_dup_expressions(&arg, indent.clone(), context);
                  // Pass the dup RESULT temp instead of the original.
                  match(
                    dups.get(usize(0)),
                    .Some(de) => if(
                      ast_expr_is_fn_call(&de),
                      match(
                        context.base.get_expr_info(&de),
                        .Some(dei) => match(
                          dei.variable_name,
                          .Some(dvn) => {
                            arg_code = get_variable_name_for_codegen_at(ast_expr_id(&de), dvn.clone(), Option(Environment).Some(dei.env));
                          },
                          .None => ()
                        ),
                        .None => ()
                      ),
                      ()
                    ),
                    .None => ()
                  );
                }),
                .None => ()
              ),
              .None => ()
            );
            args_list.push_string(&arg_code);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      call_code := context.base.current_function_name.clone();
      call_code.push_str("(");
      call_code.push_string(&args_list);
      call_code.push_str(")");
      // Result-temp: emit `<cType> <temp> = <call>;` then return the temp.
      match(
        ei.variable_name,
        .Some(temp_var) => if(!is_unit_type(&ei.ty), {
          c_type := get_type_string(&ei.ty, &context.base);
          temp_var_name := get_variable_name_for_codegen_at(ast_expr_id(expr), temp_var.clone(), Option(Environment).Some(ei.env));
          already := match(context.declared_temp_vars, .Some(s) => s.contains(temp_var_name.clone()), .None => false);
          if(!already, {
            record_declared_temp_var(context, temp_var_name.clone());
            em := context.base.emitter;
            em.emit_string_line(`${indent.clone()}__yo_effect_escaped = 0;`);
            line := indent.clone();
            line.push_string(&c_type);
            line.push_str(" ");
            line.push_string(temp_var_name.clone());
            line.push_str(" = ");
            line.push_string(call_code.clone());
            line.push_str(";");
            em.emit_string_line(&line);
            // Deferred drops on the recur node — flushed AFTER the call is
            // emitted (aliasing Stage 0 attaches the balancing drop of a
            // projection-arg dup here; flushing BEFORE the call freed the
            // argument the recursion was about to consume — the stage-2
            // dup-for-value UAF, gmalloc-traced: clone at +5276, freed at
            // +5320, consumed at +5340). Expression-level flush: skip
            // param-targeted drops (drop_dup.yo _drop_target_is_parameter).
            generate_deferred_drop_expressions(expr, indent.clone(), context, true);
            // Escape propagation (see generate_recur's doc comment): drops
            // and a dummy return, so a throw inside the recursion cannot be
            // mistaken for a result.
            emit_effect_unwind_check(indent.clone(), context, false, expr);
          });
          return(temp_var_name);
        }),
        .None => ()
      );
      // A unit recur has no result temp, so the flush above never runs:
      // emit the call as a statement and flush after it, as the direct-call
      // unit exit does. Returning the bare call instead lost the balancing
      // drop of a by-value composite argument's dup — one leaked interior
      // reference per call (`recur(values(i), out)` in std/encoding/json.yo
      // `_stringify_into`; issues/fixed/unit-recur-never-flushes-its-argument-drops.md).
      if(is_unit_type(&ei.ty), {
        uem := context.base.emitter;
        uem.emit_string_line(`${indent.clone()}__yo_effect_escaped = 0;`);
        uline := indent.clone();
        uline.push_string(&call_code);
        uline.push_str(";");
        uem.emit_string_line(&uline);
        generate_deferred_drop_expressions(expr, indent.clone(), context, true);
        emit_effect_unwind_check(indent.clone(), context, false, expr);
        return(String.from(""));
      });
      // No result variable name: materialise the call into a fresh temp so
      // the escape wrap has a statement to guard (same shape as the
      // named-temp path above).
      fresh := fresh_local_name(String.from("__yo_recur"), context.base.current_function_name.clone());
      record_declared_temp_var(context, fresh.clone());
      fem := context.base.emitter;
      fem.emit_string_line(`${indent.clone()}__yo_effect_escaped = 0;`);
      fline := indent.clone();
      fline.push_string(get_type_string(&ei.ty, &context.base));
      fline.push_str(" ");
      fline.push_string(fresh.clone());
      fline.push_str(" = ");
      fline.push_string(call_code.clone());
      fline.push_str(";");
      fem.emit_string_line(&fline);
      generate_deferred_drop_expressions(expr, indent.clone(), context, true);
      emit_effect_unwind_check(indent.clone(), context, false, expr);
      fresh
    },
    .None => codegen_fatal_expr(String.from("No arguments for recur call"))
  )
});
export(generate_recur);
