//! Codegen for Thread/Worker spawn calls.
//!
//! `Thread(unit).spawn(cb)` / `std/thread`'s `spawn(pool, cb)` lower (via the `__yo_thread_spawn` /
//! `__yo_worker_spawn` extern "yo" symbols) to: heap-copy the closure's capture
//! struct (so the thread owns it after the spawner returns) and call the raw
//! spawn primitive with a generated WRAPPER that runs the closure, drops the
//! capture struct, and frees it. The spawn primitives take the closure OWN
//! (`own(cb)` on the externs), so the heap copy INHERITS the call-site struct's
//! references — the spawn is a move, and the wrapper is the single releaser:
//! one `__yo_decr_rc` per captured reference, plus the move-only content's
//! `___dispose` calls (`_emit_capture_dispose_lines`).
//!
//! The closure C function is resolved from the cb arg's `closure_function_value`
//! ExprInfo and the capture struct from `capture_type` (like `async.yo`).
//! The `own(self)`-consumed capture fields the wrapper would have to NULL
//! before dropping are NOT tracked, so the NULLing is omitted — correct for
//! closures that
//! do not consume a captured RC value via `own(self)` (a consuming spawn closure
//! would double-free; documented in
//! issues/fixed/yo-self-parallelism-emitter-gated-on-closure-codegen.md).
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_id } :: import("../../expr.yo");
{ Environment } :: import("../../env.yo");
{ EvalValue, is_func_val } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_unit_type, is_array_type, is_tuple_type, is_enum_type, is_newtype_type } :: import("../../types/guards.yo");
{ type_contains_rc_cell_or_move_only, type_is_move_only, is_value_nominal_type } :: import("../../types/utils.yo");
{ resolve_enum_shell, resolve_struct_shell } :: import("../../types/creators.yo");
{ get_func_type, is_fnonce_closure_fn } :: import("../../function_value.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ get_type_string, get_variable_name_for_codegen_at, type_key, fresh_local_name, get_runtime_struct_fields, sanitize_for_c_identifier, get_enum_variant_c_name, c_variant_member_name, can_optimize_as_nullable_pointer } :: import("../utils/index.yo");
{ resolve_some_type_to_concrete } :: import("./closures.yo");
{ expr_info_closure_function_value, expr_info_capture_type } :: import("../../expr_info.yo");
{
  get_drop_function_for_type,
  get_dispose_function_for_type,
  generate_drop_code_for_value
} :: import("./drop_dup.yo");
{ HashSet } :: import("std/collections/hash_set");
{ _call_generate_expr } :: import("./_expr.yo");
/// C name of the capture struct for `capture_type`: the registered type-entry
/// c_name if present, else `async_capture_<id>`. (Same lookup as async.yo's
/// `_find_capture_type_c_name`; duplicated to avoid importing the heavy async
/// module.)
_capture_type_c_name :: (fn(capture_type : &TypeValue, context : &FunctionGenerationContext) -> String)({
  target_key := type_key(capture_type);
  vals := context.base.types.values();
  (go : bool) = true;
  (found : Option(String)) = Option(String).None;
  while(go, {
    match(
      vals.next(),
      .Some(entry) => if(type_key(entry.ty) == target_key, {
        found = Option(String).Some(entry.c_name.clone());
        go = false;
      }),
      .None => {
        go = false;
      }
    );
  });
  match(
    found,
    .Some(name) => name,
    .None => {
      cap_id := match(capture_type, .Struct({ id : sid }) => sid, _ => String.from(""));
      o := String.from("async_capture_");
      o.push_string(cap_id);
      o
    }
  )
});
/// The cb closure's C function name (its FuncVal func_id → registered entry).
_closure_fn_c_name :: (fn(cb_ei_value : &Option(EvalValue), cb_closure_fn_val : &Option(EvalValue), context : &FunctionGenerationContext) -> Option(String))({
  fv_opt := match(
    cb_closure_fn_val,
    .Some(fv) => Option(EvalValue).Some(fv),
    .None => match(cb_ei_value, .Some(v) => if(is_func_val(v), Option(EvalValue).Some(v), Option(EvalValue).None), .None => Option(EvalValue).None)
  );
  match(
    fv_opt,
    .Some(fv) => match(fv, .FuncVal(__fvd1, _) => match(context.base.get_function_entry(__fvd1.*.func_id), .Some(e) => Option(String).Some(e.c_name), .None => Option(String).None), _ => Option(String).None),
    .None => Option(String).None
  )
});
/// The cb closure's func_id, for its runtime-param types.
_closure_fid :: (fn(cb_ei_value : &Option(EvalValue), cb_closure_fn_val : &Option(EvalValue)) -> String)({
  fv_opt := match(
    cb_closure_fn_val,
    .Some(fv) => Option(EvalValue).Some(fv),
    .None => match(cb_ei_value, .Some(v) => if(is_func_val(v), Option(EvalValue).Some(v), Option(EvalValue).None), .None => Option(EvalValue).None)
  );
  match(fv_opt, .Some(fv) => match(fv, .FuncVal(__fvd2, _) => __fvd2.*.func_id, _ => String.new()), .None => String.new())
});
/// `, (<cType>){0}, …` — zero-inits for the closure's runtime params (e.g. the
/// `io : Io` of a `Thread.spawn` callback), as the spawn wrapper builds them.
/// Func param_types already exclude comptime
/// params, so every entry is a runtime param.
_closure_runtime_arg_zeroinits :: (fn(closure_fid : &String, context : &FunctionGenerationContext) -> String)({
  out := String.from("");
  match(
    get_func_type(closure_fid),
    .Func({ param_types : pts }) => {
      n := pts.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          pts.get(i),
          .Some(pt) => {
            out.push_str(", (");
            out.push_string(get_type_string(pt, context.base));
            out.push_str("){0}");
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  );
  out
});
/// Emit the DISPOSE calls for the MOVE-ONLY content of a capture-struct
/// subtree the spawn wrapper owns, into the CODE buffer — the same channel
/// `generate_drop_code_for_value` writes its RC releases to, which
/// `_emit_capture_drop_lines` snapshots and moves into the wrapper's
/// declaration lines.
///
/// `generate_drop_code_for_value` cannot see this content: its early
/// `!type_contains_rc_cell_or_move_only` return makes every RC-less subtree a no-op for
/// it, and a move-only value holds no RC reference by definition. The two
/// walks therefore split the field by CONTENT — that one releases the RC
/// references, this one runs the disposes — and each returns at the other's
/// territory (`type_contains_rc_cell_or_move_only` here mirrors the early return there),
/// so a value that is both (a struct with a user `Dispose` AND an RC field)
/// is handled exactly once by each.
///
/// A closure-typed capture field lowers to its capture struct BY VALUE, so
/// the recursion reaches a captured closure's own move-only captures — the
/// user callback inside `Thread(T).spawn`'s relaying closure, whose disposal
/// previously never ran on the thread
/// (issues/fixed/a-move-only-value-cannot-be-moved-into-thread-spawn.md).
_emit_capture_dispose_lines :: (
  fn(ref_code : &String, ty : &TypeValue, context : &FunctionGenerationContext, depth : u32) -> unit
)({
  if(depth > u32(6), {
    return();
  });
  concrete := resolve_enum_shell(resolve_struct_shell(resolve_some_type_to_concrete(ty)));
  // The RC walk owns every subtree that contains an RC reference.
  if(type_contains_rc_cell_or_move_only(concrete), {
    return();
  });
  // Plain data only: no move-only value inside.
  if(!type_is_move_only(concrete), {
    return();
  });
  em := context.base.emitter;
  if(is_value_nominal_type(concrete), {
    match(
      get_dispose_function_for_type(concrete, context),
      .Some(df) => {
        line := df;
        line.push_str("(");
        line.push_string(ref_code.clone());
        line.push_str(");");
        em.emit_string_line(line);
        return();
      },
      .None => ()
    );
    // No synthesized `___dispose` (no user `Dispose` on this nominal): the
    // move-only values are its FIELDS — fall through to the aggregate walks.
  });
  match(
    concrete,
    // A newtype is a transparent typedef to its single field: recurse on the
    // inner type with the SAME ref (no `._f` member exists at the C ABI).
    .Struct({ id : _ }) => {
      if(is_newtype_type(concrete), {
        // A newtype is a transparent typedef to its single field: recurse on
        // the inner type with the SAME ref (no  member at the C ABI).
        nt_fields := get_runtime_struct_fields(concrete);
        match(
          nt_fields.get(usize(0)),
          .Some(nt_f) => _emit_capture_dispose_lines(ref_code.clone(), nt_f.ty, context, depth + u32(1)),
          .None => ()
        );
      }, {
        ds_fields := get_runtime_struct_fields(concrete);
        (ds_i : usize) = usize(0);
        while(ds_i < ds_fields.len(), {
          match(
            ds_fields.get(ds_i),
            .Some(ds_f) => {
              ds_ref := String.from("(");
              ds_ref.push_string(ref_code.clone());
              ds_ref.push_str(").");
              ds_ref.push_string(sanitize_for_c_identifier(ds_f.label.clone(), false));
              _emit_capture_dispose_lines(ds_ref, ds_f.ty, context, depth + u32(1));
            },
            .None => ()
          );
          ds_i = (ds_i + usize(1));
        });
      });
    },
    .Tuple(field_labels : _, field_types : ds_fts) => {
      (dt_i : usize) = usize(0);
      while(dt_i < ds_fts.len(), {
        match(
          ds_fts.get(dt_i),
          .Some(dt_ft) => {
            dt_ref := String.from("(");
            dt_ref.push_string(ref_code.clone());
            dt_ref.push_str(")._");
            dt_ref.push_string(dt_i.to_string());
            _emit_capture_dispose_lines(dt_ref, dt_ft, context, depth + u32(1));
          },
          .None => ()
        );
        dt_i = (dt_i + usize(1));
      });
    },
    .Array(element : ds_elem, length : ds_len, length_var : ds_lv) => {
      if((ds_lv.len() == usize(0)) && (ds_len > usize(0)), {
        ds_loop := fresh_local_name(String.from("i_"), context.base.current_function_name);
        ds_hdr := String.from("for (size_t ");
        ds_hdr.push_string(ds_loop.clone());
        ds_hdr.push_str(" = 0; ");
        ds_hdr.push_string(ds_loop.clone());
        ds_hdr.push_str(" < ");
        ds_hdr.push_string(ds_len.to_string());
        ds_hdr.push_str("; ");
        ds_hdr.push_string(ds_loop.clone());
        ds_hdr.push_str("++) {");
        em.emit_string_line(ds_hdr);
        ds_eref := String.from("(");
        ds_eref.push_string(ref_code.clone());
        ds_eref.push_str(").data[");
        ds_eref.push_string(ds_loop.clone());
        ds_eref.push_str("]");
        _emit_capture_dispose_lines(ds_eref, ds_elem, context, depth + u32(1));
        em.emit_string_line(String.from("}"));
      });
    },
    // A tagged value enum: dispose each move-only payload field of the arm
    // that is live, mirroring `generate_drop_code_for_value`'s value-enum
    // switch. A nullable-pointer-optimized enum guards the recursion with the
    // same non-NULL check its drop uses.
    .EnumT({ variant_names : ds_vns, variant_fields : ds_vfs, variant_field_labels : ds_vls }) => {
      match(
        can_optimize_as_nullable_pointer(concrete),
        .Some(nb_inner) => {
          em.emit_string_line(`if ((${ref_code.clone()}) != NULL) {`);
          _emit_capture_dispose_lines(ref_code.clone(), nb_inner, context, depth + u32(1));
          em.emit_string_line(String.from("}"));
        },
        .None => {
          em.emit_string_line(`switch ((${ref_code.clone()}).tag) {`);
          (dv_i : usize) = usize(0);
          while(dv_i < ds_vns.len(), {
            dv_name := match(ds_vns.get(dv_i), .Some(v) => v, .None => String.new());
            dv_fields := match(ds_vfs.get(dv_i), .Some(f) => f, .None => ArrayList(TypeValue).new());
            dv_labels := match(ds_vls.get(dv_i), .Some(l) => l, .None => ArrayList(String).new());
            (dv_has : bool) = false;
            (dv_j : usize) = usize(0);
            while(dv_j < dv_fields.len(), {
              match(
                dv_fields.get(dv_j),
                .Some(dv_ft) => if(type_is_move_only(dv_ft) && !type_contains_rc_cell_or_move_only(dv_ft), {
                  dv_has = true;
                }),
                .None => ()
              );
              dv_j = (dv_j + usize(1));
            });
            if(dv_has, {
              dv_tag := get_enum_variant_c_name(concrete, dv_name.clone(), context.base);
              em.emit_string_line(`  case ${dv_tag}: {`);
              (dv_k : usize) = usize(0);
              while(dv_k < dv_fields.len(), {
                match(
                  dv_fields.get(dv_k),
                  .Some(dv_ft) => if(type_is_move_only(dv_ft) && !type_contains_rc_cell_or_move_only(dv_ft), {
                    dv_label := match(dv_labels.get(dv_k), .Some(l) => l, .None => String.new());
                    dv_fname := sanitize_for_c_identifier(dv_label.clone(), false);
                    dv_access := String.from("(");
                    dv_access.push_string(ref_code.clone());
                    dv_access.push_str(").data.");
                    dv_access.push_string(c_variant_member_name(dv_name.clone()));
                    dv_access.push_str(".");
                    dv_access.push_string(dv_fname);
                    _emit_capture_dispose_lines(dv_access, dv_ft, context, depth + u32(1));
                  }),
                  .None => ()
                );
                dv_k = (dv_k + usize(1));
              });
              em.emit_string_line(String.from("    break;"));
              em.emit_string_line(String.from("  }"));
            });
            dv_i = (dv_i + usize(1));
          });
          em.emit_string_line(String.from("  default: break;"));
          em.emit_string_line(String.from("}"));
        }
      );
    },
    _ => ()
  );
});
/// Emit the per-field RC release for a capture struct that has NO synthesized
/// `___drop`, as DECLARATION lines inside the spawn wrapper.
///
/// This is the leak fix. The wrapper's drop was emitted only when
/// `get_drop_function_for_type` resolved a `___drop` C function, and the
/// self-hosted compiler synthesizes none for an ANONYMOUS closure-capture
/// struct — so both the call-site dup and the wrapper drop took their `.None`
/// arms and the wrapper degenerated to "call the closure, free the memory".
/// The `+1` taken when the capture struct is constructed at the call site then
/// had no matching decrement anywhere, and every spawned closure leaked one
/// reference per RC'd capture field: ~344 B per `spawn` with a captured
/// `Channel(bool)`, unbounded in a loop
/// (issues/fixed/spawn-closure-captures-never-dropped-leak.md).
///
/// It also made a whole class of std API silently inert across a spawn
/// boundary: a captured handle's `Dispose` never ran, so
/// "the last `Sender` to go closes the channel" did not happen for a `Sender`
/// moved into a `Thread.spawn` closure.
///
/// `generate_drop_code_for_value`'s plain-struct fallback already knows how to
/// walk a struct's runtime fields, including nested arrays, tuples and enums.
/// The only problem is WHERE it writes: it emits into the CODE buffer, while a
/// spawn wrapper is a file-scope `static` living in the DECLARATION buffer. So
/// the walk runs against the code buffer and the lines it produced are moved
/// across — the same snapshot-and-rewrite `codegen/functions/generation.yo`
/// uses for its FTT stub. The declared/scope trackers are unhooked for the
/// duration so the moved lines are not recorded as declarations of the
/// enclosing function.
///
/// NO dup is added at the call site to match. The heap copy is a shallow copy
/// of the call-site struct, so it INHERITS that struct's references — the
/// spawn is a move, and exactly one release is what balances it. (When a
/// `___dup`/`___drop` pair DOES resolve, the existing paths handle both sides
/// and this helper is not reached.)
_emit_capture_drop_lines :: (
  fn(target : &String, capture_type : &TypeValue, context : &FunctionGenerationContext) -> unit
)({
  em := context.base.emitter;
  before := em.code.len();
  prev_declared := em.declared_ref;
  prev_scope := em.scope_ref;
  em.declared_ref = Option(Rc(HashSet(String))).None;
  em.scope_ref = Option(Rc(ArrayList(String))).None;
  // Field by field over the heap copy of the capture struct: the spawn
  // wrapper owns that copy (the spawn is a MOVE — `_generate_spawn_call`'s
  // heap copy inherits the call-site struct's references) and is the only
  // thing that releases it. A captured CLOSURE field (the user's callback
  // inside `Thread(T).spawn`'s result-relaying wrapper) resolves to its own
  // capture struct, so what it captured is released too — its RC references
  // here, its move-only disposes through `_emit_capture_dispose_lines`.
  (tail : String) = String.new();
  cd_fields := get_runtime_struct_fields(capture_type);
  (cd_i : usize) = usize(0);
  while(cd_i < cd_fields.len(), {
    match(
      cd_fields.get(cd_i),
      .Some(cd_f) => {
        cd_ty := resolve_some_type_to_concrete(cd_f.ty);
        cd_ref := String.from("(");
        cd_ref.push_string(target.clone());
        cd_ref.push_str(").");
        cd_ref.push_string(sanitize_for_c_identifier(cd_f.label.clone(), false));
        if(type_contains_rc_cell_or_move_only(cd_ty), {
          cd_line := generate_drop_code_for_value(cd_ref.clone(), cd_ty, context);
          if(cd_line.len() > usize(0), {
            cd_line.push_str(";");
            em.emit_string_line(cd_line);
          });
        });
        // The move-only content of a field the RC walk cannot see (see
        // `_emit_capture_dispose_lines`): the heap copy OWNS it now.
        _emit_capture_dispose_lines(cd_ref, cd_f.ty, context, u32(0));
      },
      .None => ()
    );
    cd_i = (cd_i + usize(1));
  });
  em.declared_ref = prev_declared;
  em.scope_ref = prev_scope;
  produced := em.code.substring(before, em.code.len());
  // In place: a copy of the whole code buffer per spawn was a ~110 MB
  // transient late in the self-build's emit (plans/CODEGEN_MEMORY_REDUCTION.md §0.6).
  em.code.truncate(before);
  // Re-emit what the walk produced, one line at a time, into the declaration
  // buffer with the wrapper's indentation.
  (start : usize) = usize(0);
  pn := produced.len();
  (pi : usize) = usize(0);
  while(pi <= pn, {
    at_end := (pi == pn);
    is_nl := if(at_end, false, produced.byte_at(pi) == u8(10));
    if(at_end || is_nl, {
      if(pi > start, {
        line := String.from("  ");
        line.push_string(produced.substring(start, pi));
        em.emit_declaration_string_line(line);
      });
      start = (pi + usize(1));
    });
    pi = (pi + usize(1));
  });
  // A leaf type (an `Rc` field, a `dyn`, a Future handle) yields its release as
  // the RETURN value rather than an emitted line.
  if(tail.len() > usize(0), {
    line := String.from("  ");
    line.push_string(tail);
    line.push_str(";");
    em.emit_declaration_string_line(line);
  });
});
/// Emit a spawn-wrapper function (RC cleanup for the heap-copied capture struct)
/// to the declaration section and return its C name.
_generate_spawn_wrapper :: (fn(closure_fn_c_name : &String, capture_struct_c_name : &String, capture_type : &TypeValue, runtime_args : &String, closure_owns_captures : bool, context : &FunctionGenerationContext) -> String)({
  // Phase 2: the wrapper is a file-scope fn — its name embeds the CLOSURE's
  // C name (unique per closure) plus a per-closure occurrence digit, so the
  // same closure spawned twice still gets distinct wrappers without the
  // global counter.
  wrapper_name := fresh_local_name(
    `__yo_spawn_wrapper_${closure_fn_c_name}_`,
    String.new()
  );
  em := context.base.emitter;
  em.emit_declaration_string_line(String.from(""));
  em.emit_declaration_string_line(String.from("// Spawn wrapper: handles RC cleanup for thread-spawned closures"));
  open_line := String.from("static void ");
  open_line.push_string(wrapper_name.clone());
  open_line.push_str("(void* closure) {");
  em.emit_declaration_string_line(open_line);
  // Step 1: call the closure with the closure-context pointer + runtime-param
  // zero-inits.
  call_line := String.from("  ");
  call_line.push_string(closure_fn_c_name);
  call_line.push_str("(closure");
  call_line.push_string(runtime_args);
  call_line.push_str(");");
  em.emit_declaration_string_line(call_line);
  // Step 2-3: drop the capture struct (releases the thread's RC refs), free it.
  // (consumed-capture NULLing omitted — see module doc.) A closure typed
  // `FnOnce(...)` with a capture list owns its by-value captures
  // (plans/VALUES_BY_DEFAULT.md decision 37): its body moved some out and
  // dropped the rest, so the wrapper frees only the struct, as the
  // `Dyn(FnOnce)` call-once wrapper does (`functions/dyn.yo`).
  if(closure_owns_captures, {
    em.emit_declaration_string_line(String.from("  __yo_free(closure);"));
    em.emit_declaration_string_line(String.from("}"));
    return(wrapper_name);
  });
  match(
    get_drop_function_for_type(capture_type, context),
    .Some(drop_fn) => {
      drop_line := String.from("  ");
      drop_line.push_string(drop_fn);
      drop_line.push_str("(*(");
      drop_line.push_string(capture_struct_c_name.clone());
      drop_line.push_str("*)closure);");
      em.emit_declaration_string_line(drop_line);
    },
    // No synthesized `___drop` — walk the fields instead. Taking this arm as a
    // no-op is what leaked every spawned closure's captures.
    .None => {
      target := String.from("*(");
      target.push_string(capture_struct_c_name.clone());
      target.push_str("*)closure");
      _emit_capture_drop_lines(target, capture_type, context);
    }
  );
  em.emit_declaration_string_line(String.from("  __yo_free(closure);"));
  em.emit_declaration_string_line(String.from("}"));
  wrapper_name
});
/// Shared body of generate_thread_spawn_call / generate_worker_spawn_call. Emits
/// the heap-copy + wrapper, then the spawn primitive call. `is_worker`
/// selects the primitive + (unit) return convention.
_generate_spawn_call :: (fn(expr : &AstExpr, indent : &String, context : &FunctionGenerationContext, is_worker : bool) -> Option(String))({
  ei := match(context.base.get_expr_info(expr), .Some(e) => e, .None => return(Option(String).None));
  cb := match(
    ei.runtime_arg_exprs_in_order,
    .Some(ra) => if(ra.len() == usize(1), match(ra.get(usize(0)), .Some(c) => c, .None => return(Option(String).None)), return(Option(String).None)),
    .None => return(Option(String).None)
  );
  cei := match(context.base.get_expr_info(cb), .Some(e) => e, .None => return(Option(String).None));
  // `cb` is either a closure literal (cei.capture_type set) OR — inside a
  // SPECIALIZED Thread.spawn body — the lowered capture-struct PARAM (cei.ty IS
  // the capture struct, registered in impl_closure_call_map by the closure
  // construction at the call site). Resolve the capture struct + closure impl fn
  // from whichever is present.
  // For a closure-PARAM cb (specialized Thread.spawn body), cei.ty is the SomeT
  // the param was bound to (callable) — resolve it to the concrete capture struct
  // (via the value's own resolution) so the map key matches what the construction /
  // pre-pass registered (the capture-struct id, not the SomeT id).
  capture_type := resolve_some_type_to_concrete(match(expr_info_capture_type(cei), .Some(c) => c, .None => cei.ty));
  // The impl_closure_call_map is keyed by the BARE capture-struct id at every
  // set site (closures.yo — capture-struct sids are unique per closure), NOT
  // by type_key: type_key of a cfid-empty struct with field types is now
  // STRUCTURAL (sid + field keys), so keying the get by type_key missed.
  cb_map_key := match(
    capture_type,
    .Struct({ id : cb_sid }) => cb_sid,
    .SomeT({ id : cb_sid }) => cb_sid,
    _ => type_key(capture_type.clone())
  );
  mapped_opt := context.base.impl_closure_call_map.get(cb_map_key);
  capture_c_name := _capture_type_c_name(capture_type.clone(), context);
  closure_fn := match(
    _closure_fn_c_name(cei.value, expr_info_closure_function_value(cei), context),
    .Some(n) => n,
    .None => match(mapped_opt, .Some(m) => m.function_c_name, .None => return(Option(String).Some(String.from("/* Error: spawn cb has no closure function */"))))
  );
  closure_fid_direct := _closure_fid(cei.value, expr_info_closure_function_value(cei));
  closure_fid := if(
    closure_fid_direct.len() > usize(0),
    closure_fid_direct,
    match(mapped_opt, .Some(m) => m.closure_fid, .None => String.from(""))
  );
  runtime_args := _closure_runtime_arg_zeroinits(closure_fid, context);
  wrapper := _generate_spawn_wrapper(closure_fn, capture_c_name.clone(), capture_type, runtime_args, is_fnonce_closure_fn(closure_fid), context);
  // The capture-struct VALUE (the cb arg's variable, or its generated code).
  cb_code := _call_generate_expr(cb, indent.clone(), context);
  cb_var := match(cei.variable_name, .Some(vn) => get_variable_name_for_codegen_at(ast_expr_id(cb), vn, Option(Environment).Some(cei.env)), .None => cb_code);
  em := context.base.emitter;
  heap_var := fresh_local_name(
    String.from(if(is_worker, "_worker_closure_data_", "_thread_closure_data_")),
    context.base.current_function_name
  );
  // <capCName>* <heapVar> = (<capCName>*)__yo_malloc(sizeof(<capCName>));
  alloc_line := indent.clone();
  alloc_line.push_string(capture_c_name.clone());
  alloc_line.push_str("* ");
  alloc_line.push_string(heap_var.clone());
  alloc_line.push_str(" = (");
  alloc_line.push_string(capture_c_name.clone());
  alloc_line.push_str("*)__yo_rc_alloc(sizeof(");
  alloc_line.push_string(capture_c_name.clone());
  alloc_line.push_str("));");
  em.emit_string_line(alloc_line);
  // *<heapVar> = <cbVar>;
  copy_line := indent.clone();
  copy_line.push_str("*");
  copy_line.push_string(heap_var.clone());
  copy_line.push_str(" = ");
  copy_line.push_string(cb_var);
  copy_line.push_str(";");
  em.emit_string_line(copy_line);
  // NO dup of the heap copy: the spawn primitives take the closure OWN
  // (`own(cb)` on the `__yo_thread_spawn` / `__yo_worker_spawn` externs), so
  // the call-site capture struct's references TRANSFER to the heap copy —
  // the shallow copy above inherits them, its constructing temp is consumed
  // (no scope-end release of its own), and the spawn wrapper is the single
  // releaser when the thread ends (`_emit_capture_drop_lines`). A dup here
  // over-retained every RC'd capture by exactly one reference, and a
  // move-only capture (which has no dup at all) relied on the temp's now-
  // missing release to be disposed at all
  // (issues/fixed/a-move-only-value-cannot-be-moved-into-thread-spawn.md).
  if(is_worker, {
    // __yo_worker_spawn returns void (unit).
    ws := indent.clone();
    ws.push_str("__yo_worker_spawn(");
    ws.push_string(wrapper);
    ws.push_str(", ");
    ws.push_string(heap_var);
    ws.push_str(");");
    em.emit_string_line(ws);
    Option(String).Some(String.from(""))
  }, {
    // __yo_thread_t <tv> = __yo_thread_spawn(<wrapper>, <heapVar>);
    tv := match(
      ei.variable_name,
      .Some(v) => v,
      .None => fresh_local_name(String.from("_thr_"), context.base.current_function_name)
    );
    ts := indent.clone();
    ts.push_str("__yo_thread_t ");
    ts.push_string(tv.clone());
    ts.push_str(" = __yo_thread_spawn(");
    ts.push_string(wrapper);
    ts.push_str(", ");
    ts.push_string(heap_var);
    ts.push_str(");");
    em.emit_string_line(ts);
    Option(String).Some(tv)
  })
});
/// `__yo_thread_spawn(cb)` — spawn a dedicated OS thread.
generate_thread_spawn_call :: (fn(expr : &AstExpr, indent : &String, context : &FunctionGenerationContext) -> Option(String))(
  _generate_spawn_call(expr, indent, context, false)
);

/// `__yo_worker_spawn(cb)` — spawn a task on the worker pool.
generate_worker_spawn_call :: (fn(expr : &AstExpr, indent : &String, context : &FunctionGenerationContext) -> Option(String))(
  _generate_spawn_call(expr, indent, context, true)
);
export(generate_thread_spawn_call, generate_worker_spawn_call);
