//! C codegen constants.
//!
//! Two exported predicates drive emitter decisions:
//!   * `is_builtin_yo_inline_function` — membership in the flat list of
//!     builtin function names codegen emits INLINE (C operators, pointer ops,
//!     `str` ops, casts, intrinsics) rather than as ordinary C function calls.
//!   * `is_primitive_type_tag` — membership in the set of `TypeTag`s that
//!     lower to a primitive C scalar.
//!
//! `export(...)` requires compile-time values, so the runtime-built
//! collections cannot be exported directly. They live as module-level
//! globals (read-only after init) and are exposed through membership
//! predicates. Names are stored as `String` to match the AST token-value
//! type the callers compare against.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ Exception, AnyError } :: import("std/error");
{ TypeTag } :: import("../types/tags.yo");
{ Token } :: import("../token.yo");
{ format_error_message } :: import("../error.yo");
{
  BF_YO_OP_ADD,
  BF_YO_OP_SUB,
  BF_YO_OP_MUL,
  BF_YO_OP_DIV,
  BF_YO_OP_MOD,
  BF_YO_OP_NEG,
  BF_YO_OP_ADD_WRAP,
  BF_YO_OP_SUB_WRAP,
  BF_YO_OP_MUL_WRAP,
  BF_YO_OP_EQ,
  BF_YO_OP_NEQ,
  BF_YO_OP_LT,
  BF_YO_OP_LTE,
  BF_YO_OP_GT,
  BF_YO_OP_GTE,
  BF_YO_OP_NOT,
  BF_YO_OP_BIT_AND,
  BF_YO_OP_BIT_OR,
  BF_YO_OP_BIT_XOR,
  BF_YO_OP_BIT_COMPLEMENT,
  BF_YO_OP_BIT_LEFT_SHIFT,
  BF_YO_OP_BIT_RIGHT_SHIFT,
  BF_YO_PTR_ADD,
  BF_YO_PTR_SUB,
  BF_YO_PTR_DIFF,
  BF_YO_PTR_EQ,
  BF_YO_PTR_NEQ,
  BF_YO_PTR_LT,
  BF_YO_PTR_LTE,
  BF_YO_PTR_GT,
  BF_YO_PTR_GTE,
  BF_YO_STR_FROM_RAW_PARTS,
  BF_YO_STR_LEN,
  BF_YO_STR_PTR,
  BF_YO_STR_BYTE,
  BF_YO_AS,
  BF_YO_GETRANDOM,
  BF_YO_ERRNO,
  BF_YO_ARC4RANDOM_BUF,
  BF_YO_BCRYPT_GEN_RANDOM,
  BF_YO_GETENTROPY,
  BF_YO_MAYBE_UNINIT_NEW,
  BF_YO_MAYBE_UNINIT_AS_PTR,
  BF_YO_MAYBE_UNINIT_ASSUME_INIT,
  BF_YO_ARRAY_INDEX,
  BF_YO_NOOP,
  BF_YO_RETURN_SELF,
  BF_YO_BORROW_ASSERT_UNBORROWED,
  BF_YO_BORROW_ACQUIRE,
  BF_YO_BORROW_RELEASE,
  BF_YO_MS_SLEEP
} :: import("../expr.yo");
///
_build_builtin_yo_inline_functions :: (fn() -> ArrayList(String))({
  fns := ArrayList(String).new();
  // Arithemtic
  fns.push(String.from(BF_YO_OP_ADD)); // +
  fns.push(String.from(BF_YO_OP_SUB)); // -
  fns.push(String.from(BF_YO_OP_MUL)); // *
  fns.push(String.from(BF_YO_OP_DIV)); // /
  fns.push(String.from(BF_YO_OP_MOD)); // %
  fns.push(String.from(BF_YO_OP_NEG)); // -
  // Wrapping arithmetic (safe mode Phase 3a-i)
  fns.push(String.from(BF_YO_OP_ADD_WRAP)); // wrapping_add
  fns.push(String.from(BF_YO_OP_SUB_WRAP)); // wrapping_sub
  fns.push(String.from(BF_YO_OP_MUL_WRAP)); // wrapping_mul
  // Relational
  fns.push(String.from(BF_YO_OP_EQ)); // ==
  fns.push(String.from(BF_YO_OP_NEQ)); // !=
  fns.push(String.from(BF_YO_OP_LT)); // <
  fns.push(String.from(BF_YO_OP_LTE)); // <=
  fns.push(String.from(BF_YO_OP_GT)); // >
  fns.push(String.from(BF_YO_OP_GTE)); // >=
  // Logical
  fns.push(String.from(BF_YO_OP_NOT)); // !
  // Bitwise
  fns.push(String.from(BF_YO_OP_BIT_AND)); // &
  fns.push(String.from(BF_YO_OP_BIT_OR)); // |
  fns.push(String.from(BF_YO_OP_BIT_XOR)); // ^
  fns.push(String.from(BF_YO_OP_BIT_COMPLEMENT)); // ~
  fns.push(String.from(BF_YO_OP_BIT_LEFT_SHIFT)); // <<
  fns.push(String.from(BF_YO_OP_BIT_RIGHT_SHIFT)); // >>
  // Pointer operations
  fns.push(String.from(BF_YO_PTR_ADD)); // __yo_ptr_add
  fns.push(String.from(BF_YO_PTR_SUB)); // __yo_ptr_sub
  fns.push(String.from(BF_YO_PTR_DIFF)); // __yo_ptr_diff
  fns.push(String.from(BF_YO_PTR_EQ)); // __yo_ptr_eq
  fns.push(String.from(BF_YO_PTR_NEQ)); // __yo_ptr_neq
  fns.push(String.from(BF_YO_PTR_LT)); // __yo_ptr_lt
  fns.push(String.from(BF_YO_PTR_LTE)); // __yo_ptr_lte
  fns.push(String.from(BF_YO_PTR_GT)); // __yo_ptr_gt
  fns.push(String.from(BF_YO_PTR_GTE)); // __yo_ptr_gte
  // Slice operations
  fns.push(String.from(BF_YO_STR_FROM_RAW_PARTS)); // __yo_str_from_raw_parts
  fns.push(String.from(BF_YO_STR_LEN)); // __yo_str_len
  fns.push(String.from(BF_YO_STR_PTR)); // __yo_str_ptr
  fns.push(String.from(BF_YO_STR_BYTE)); // __yo_str_byte
  // Type casting
  fns.push(String.from(BF_YO_AS)); // __yo_as (generic primitive type cast)
  // Crypto random
  fns.push(String.from(BF_YO_GETRANDOM));
  fns.push(String.from(BF_YO_ERRNO));
  fns.push(String.from(BF_YO_ARC4RANDOM_BUF));
  fns.push(String.from(BF_YO_BCRYPT_GEN_RANDOM));
  fns.push(String.from(BF_YO_GETENTROPY));
  // MaybeUninit
  fns.push(String.from(BF_YO_MAYBE_UNINIT_NEW));
  fns.push(String.from(BF_YO_MAYBE_UNINIT_AS_PTR));
  fns.push(String.from(BF_YO_MAYBE_UNINIT_ASSUME_INIT));
  // Array indexing
  fns.push(String.from(BF_YO_ARRAY_INDEX));
  // Others
  fns.push(String.from(BF_YO_NOOP)); // __yo_noop
  fns.push(String.from(BF_YO_RETURN_SELF)); // __yo_return_self
  fns.push(String.from(BF_YO_BORROW_ASSERT_UNBORROWED)); // __yo_borrow_assert_unborrowed
  fns.push(String.from(BF_YO_BORROW_ACQUIRE)); // __yo_borrow_acquire
  fns.push(String.from(BF_YO_BORROW_RELEASE)); // __yo_borrow_release
  fns.push(String.from(BF_YO_MS_SLEEP)); // __yo_ms_sleep
  fns
});
BuiltinYoInlineFunctions := _build_builtin_yo_inline_functions();
///
_build_primitive_type_tags :: (fn() -> HashSet(TypeTag))({
  tags := HashSet(TypeTag).new();
  tags.insert(TypeTag.TBool);
  tags.insert(TypeTag.TUsize);
  tags.insert(TypeTag.TIsize);
  tags.insert(TypeTag.TU8);
  tags.insert(TypeTag.TI8);
  tags.insert(TypeTag.TU16);
  tags.insert(TypeTag.TI16);
  tags.insert(TypeTag.TU32);
  tags.insert(TypeTag.TI32);
  tags.insert(TypeTag.TU64);
  tags.insert(TypeTag.TI64);
  tags.insert(TypeTag.TF32);
  tags.insert(TypeTag.TF64);
  tags.insert(TypeTag.TCChar);
  tags.insert(TypeTag.TCShort);
  tags.insert(TypeTag.TCUShort);
  tags.insert(TypeTag.TCInt);
  tags.insert(TypeTag.TCUInt);
  tags.insert(TypeTag.TCLong);
  tags.insert(TypeTag.TCULong);
  tags.insert(TypeTag.TCLongLong);
  tags.insert(TypeTag.TCULongLong);
  tags.insert(TypeTag.TCLongDouble);
  tags
});
PrimitiveTypeTags := _build_primitive_type_tags();
/// True if `name` is a builtin function that codegen emits inline.
is_builtin_yo_inline_function :: (fn(name : String) -> bool)(
  BuiltinYoInlineFunctions.contains(name)
);
/// True if `t` lowers to a primitive C scalar.
is_primitive_type_tag :: (fn(t : TypeTag) -> bool)(
  PrimitiveTypeTags.contains(t)
);

// ---------------------------------------------------------------------------
// Fatal codegen errors
// ---------------------------------------------------------------------------
/// The first fatal or user error codegen raised in this compile. Emitters do
/// not thread `exn`, so they record the error here and return, and
/// `compile_module` throws it through its own `exn` after each emission
/// phase (`raise_codegen_error`), which exits the CLI with rc=1. This slot
/// used to hold the driver's `Exception` itself; a stored handler can
/// outlive the frame that installed it, so a module-level binding of one is
/// rejected (plans/TYPE_SYSTEM_SOUNDNESS.md Phase 5.5).
(g_codegen_error : Option(AnyError)) = Option(AnyError).None;
_record_codegen_error :: (fn(err : AnyError) -> unit)({
  if(g_codegen_error.is_none(), {
    g_codegen_error = Option(AnyError).Some(err);
  });
});
/// Forget an error a previous compile recorded but never raised (it threw
/// before its emission phase ended).
clear_codegen_error :: (fn() -> unit)({
  g_codegen_error = Option(AnyError).None;
});
/// Throw the recorded codegen error, if any, through `exn` (the caller's
/// handler, alive in the caller's frame).
raise_codegen_error :: (fn(exn : Exception) -> unit)(
  match(
    g_codegen_error,
    .Some(err) => {
      g_codegen_error = Option(AnyError).None;
      exn.throw(err);
      ()
    },
    .None => ()
  )
);
/// Report a fatal, unrecoverable codegen error. It is recorded
/// (`g_codegen_error`), the emitter returns, and `compile_module` throws the
/// first recorded error when its emission phase ends: the CLI exits with rc=1.
///
/// P3 ICE wrapper (plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md §7 P3, D11): every
/// codegen_fatal is an internal-compiler-error class — an emitter
/// precondition no accepted source can reach — so the message is prefixed
/// and a report prompt is appended, instead of a bare string that reads
/// like a user error.
codegen_fatal :: (fn(message : String) -> unit)({
  wrapped := `internal compiler error: ${message}\nThis is a bug in the Yo compiler, not in your program — please report it:\nhttps://github.com/shd101wyy/Yo/issues`;
  _record_codegen_error(dyn(wrapped));
});
/// `codegen_fatal` in EXPRESSION position — for the emitters, whose signatures
/// return the C text they built.
///
/// Every call site used to return an "Error" **C COMMENT** instead.
/// A comment in C statement position is skipped by the C compiler, so the
/// emitted program silently lost that statement: clang reported nothing, the
/// binary linked, and it ran with the failing expression simply absent — the
/// same silent-hollowing mechanism as the "Failed to transpile" marker
/// (issues/fixed/self-hosted-compile-swallows-undefined-call.md). A diagnostic the C
/// compiler can skip is not a diagnostic.
///
/// Every one of those sites is an internal emitter precondition — a builtin
/// reached codegen with the wrong arity, or an expression reached it with no
/// type information — so none is reachable from source the evaluator accepted.
/// Measured before making them fatal: emitting the WHOLE self-hosted compiler
/// (115 MB of C, the largest program available) produces ZERO of these markers.
///
/// The `String` return never happens; `codegen_fatal` unwinds first. It exists
/// so a site can keep its original shape (`.None => return(...)`).
codegen_fatal_expr :: (fn(message : String) -> String)({
  codegen_fatal(message);
  String.from("")
});
/// A USER error that only codegen can see: a language rule enforced where the
/// `io.async` state-machine splitter runs (an `io.await` in a position it
/// cannot split). Unlike `codegen_fatal` it is not an internal error: it
/// builds a `YoError` from the user's token, so the CLI renders it with its
/// code, the caret and the source line, honouring `--error-format`
/// (plans/TYPE_SYSTEM_SOUNDNESS.md Phase 4.1,
/// issues/fixed/user-facing-async-restrictions-reported-as-internal-compiler-error.md).
/// The rules that are decidable from the syntax are also enforced by the
/// evaluator (`validate_await_placement`, evaluator/async/await_placement.yo),
/// so `yo check` reports them; this is the backstop for the splitter's own
/// limits.
codegen_user_error :: (fn(tok : Token, message : String) -> unit)({
  _record_codegen_error(dyn(format_error_message(tok, message)));
});
/// `codegen_user_error` in EXPRESSION position.
codegen_user_error_expr :: (fn(tok : Token, message : String) -> String)({
  codegen_user_error(tok, message);
  String.from("")
});
export(is_builtin_yo_inline_function, is_primitive_type_tag, clear_codegen_error, raise_codegen_error, codegen_fatal, codegen_fatal_expr, codegen_user_error, codegen_user_error_expr);
