//! C include-header collection + emission — mirrors `src/codegen/c/collection.ts`.
//!
//! NOTE (issues/retired/codegen-port-type-model-gaps.md): TS reads `type.cInclude`
//! off each collected type. yo-self's TypeValue carries no general cInclude,
//! so the include is stored on the registry ENTRY (CodegenTypeEntry /
//! CodegenExternFnEntry, supplied at registration) and read from there here.
{ String } :: import("std/string");
{ CodeGenContext } :: import("../utils/index.yo");
{ is_target_windows, is_target_macos } :: import("../../target.yo");
{ emit_fixed_allocator_defines, emit_fixed_allocator_impl } :: import("./allocator_fixed.yo");
/// Collect C include headers from the collected types and extern functions.
/// Mirrors `collectCIncludes`.
collect_c_includes :: (fn(context : CodeGenContext) -> unit)({
  // Collect cIncludes from all collected types. (Loop via a flag, NOT
  // `return(())` — a bare return would exit the whole function and skip the
  // extern-function pass below.)
  type_vals := context.types.values();
  (go_types : bool) = true;
  while(go_types, {
    match(
      type_vals.next(),
      .Some(type_entry) => {
        match(
          type_entry.c_include.clone(),
          .Some(inc) => context.add_c_include(inc),
          .None => ()
        );
      },
      .None => {
        go_types = false;
      }
    );
  });
  // Collect cIncludes from all extern functions.
  fn_vals := context.extern_functions.values();
  (go_fns : bool) = true;
  while(go_fns, {
    match(
      fn_vals.next(),
      .Some(fn_entry) => {
        match(
          fn_entry.c_include.clone(),
          .Some(inc) => context.add_c_include(inc),
          .None => ()
        );
      },
      .None => {
        go_fns = false;
      }
    );
  });
});
/// Emit C include headers (platform feature macros, the collected includes
/// with platform-incompatible headers filtered out, platform-specific file-op
/// includes, and the allocator compatibility layer). Mirrors `emitCIncludes`.
emit_c_includes :: (fn(context : CodeGenContext) -> unit)({
  is_windows := is_target_windows(context.target_info);
  is_macos := is_target_macos(context.target_info);
  // Emit platform-specific feature macros.
  if(is_windows, {
    context.emitter.emit_header_line("#ifndef WIN32_LEAN_AND_MEAN");
    context.emitter.emit_header_line("#define WIN32_LEAN_AND_MEAN");
    context.emitter.emit_header_line("#endif");
    context.emitter.emit_header_line("#ifndef _WINSOCKAPI_");
    context.emitter.emit_header_line("#define _WINSOCKAPI_");
    context.emitter.emit_header_line("#endif");
    // `M_PI` and the rest of the `M_*` constants are a POSIX extension, NOT
    // C11: the MS CRT's <math.h> defines them only under this macro, so
    // without it every one of them is an undeclared identifier on Windows.
    // `std/libc/math.yo` exports all fourteen, so the compiler owes it to that
    // declaration to make them exist on every target. Must precede the
    // includes below, which is why it sits with the other feature macros.
    context.emitter.emit_header_line("#ifndef _USE_MATH_DEFINES");
    context.emitter.emit_header_line("#define _USE_MATH_DEFINES");
    context.emitter.emit_header_line("#endif");
  }, {
    context.emitter.emit_header_line("#define _DEFAULT_SOURCE");
    context.emitter.emit_header_line("#define _GNU_SOURCE  // Needed for sched_getcpu() on Linux");
  });
  context.emitter.emit_header_line("");
  // Headers that simply do not exist on the other platform. A registered
  // c_include can leak from a comptime-eliminated platform branch — emitting
  // it would be a fatal `file not found`. Code that genuinely uses these is
  // platform-guarded in std, and the guarded block below re-adds the right
  // ones for the actual target.
  include_iter := context.c_includes.into_iter();
  // Loop via a flag, NOT `return(())`: a bare return would exit the whole
  // function and skip the platform includes + allocator defines below.
  (go_inc : bool) = true;
  while(go_inc, {
    match(
      include_iter.next(),
      .Some(include) => {
        skip_posix := (is_windows && ((include == "<unistd.h>") || (include == "<dirent.h>")));
        skip_windows := (!is_windows && ((include == "<windows.h>") || (include == "<bcrypt.h>") || (include == "<io.h>")));
        skip_macos := (!is_macos && (include == "<mach-o/dyld.h>"));
        if(!(skip_posix || skip_windows || skip_macos), {
          line := String.from("#include ");
          line.push_string(include);
          context.emitter.emit_header_string_line(line);
        });
      },
      .None => {
        go_inc = false;
      }
    );
  });
  // Platform-specific includes for file operations.
  if(is_windows, {
    context.emitter.emit_header_line("#include <windows.h>");
    context.emitter.emit_header_line("#include <bcrypt.h>");
    context.emitter.emit_header_line("#include <io.h>");
    context.emitter.emit_header_line("#include <sys/stat.h>");
  }, {
    context.emitter.emit_header_line("#include <unistd.h>");
    context.emitter.emit_header_line("#include <sys/stat.h>");
    context.emitter.emit_header_line("#include <sys/random.h>");
  });
  // Add allocator compatibility layer based on the allocator option.
  context.emitter.emit_header_line("");
  cond(
    (context.allocator == "fixed") => {
      // The TLSF fixed-region arm: defines + external prototypes in the
      // header, the implementation defined once in the code section (see
      // allocator_fixed.yo for the chunked-emission reasoning).
      emit_fixed_allocator_defines(context.emitter);
      emit_fixed_allocator_impl(context);
    },
    (context.allocator == "mimalloc") => {
      context.emitter.emit_header_line("// Mimalloc compatibility layer - try mimalloc first, fallback to stdlib");
      context.emitter.emit_header_line("#ifdef __has_include");
      context.emitter.emit_header_line("  #if __has_include(<mimalloc.h>)");
      context.emitter.emit_header_line("    #include <mimalloc.h>");
      context.emitter.emit_header_line("    #define __yo_malloc mi_malloc");
      context.emitter.emit_header_line("    #define __yo_calloc mi_calloc");
      context.emitter.emit_header_line("    #define __yo_realloc mi_realloc");
      context.emitter.emit_header_line("    #define __yo_free mi_free");
      context.emitter.emit_header_line("    #define __yo_aligned_alloc mi_aligned_alloc");
      context.emitter.emit_header_line("    #define __yo_aligned_free mi_free");
      context.emitter.emit_header_line("  #else");
      context.emitter.emit_header_line("    #define __yo_malloc malloc");
      context.emitter.emit_header_line("    #define __yo_calloc calloc");
      context.emitter.emit_header_line("    #define __yo_realloc realloc");
      context.emitter.emit_header_line("    #define __yo_free free");
      if(is_windows, {
        context.emitter.emit_header_line("    static inline void* __yo_aligned_alloc(size_t alignment, size_t size) { return _aligned_malloc(size, alignment); }");
        context.emitter.emit_header_line("    #define __yo_aligned_free _aligned_free");
      }, {
        context.emitter.emit_header_line("    #define __yo_aligned_alloc aligned_alloc");
        context.emitter.emit_header_line("    #define __yo_aligned_free free");
      });
      context.emitter.emit_header_line("  #endif");
      context.emitter.emit_header_line("#else");
      context.emitter.emit_header_line("  // Fallback for older compilers without __has_include");
      context.emitter.emit_header_line("  #define __yo_malloc malloc");
      context.emitter.emit_header_line("  #define __yo_calloc calloc");
      context.emitter.emit_header_line("  #define __yo_realloc realloc");
      context.emitter.emit_header_line("  #define __yo_free free");
      if(is_windows, {
        context.emitter.emit_header_line("  static inline void* __yo_aligned_alloc(size_t alignment, size_t size) { return _aligned_malloc(size, alignment); }");
        context.emitter.emit_header_line("  #define __yo_aligned_free _aligned_free");
      }, {
        context.emitter.emit_header_line("  #define __yo_aligned_alloc aligned_alloc");
        context.emitter.emit_header_line("  #define __yo_aligned_free free");
      });
      context.emitter.emit_header_line("#endif");
    },
    true => {
      context.emitter.emit_header_line("// Using system allocator");
      context.emitter.emit_header_line("#define __yo_malloc malloc");
      context.emitter.emit_header_line("#define __yo_calloc calloc");
      context.emitter.emit_header_line("#define __yo_realloc realloc");
      context.emitter.emit_header_line("#define __yo_free free");
      if(is_windows, {
        context.emitter.emit_header_line("static inline void* __yo_aligned_alloc(size_t alignment, size_t size) { return _aligned_malloc(size, alignment); }");
        context.emitter.emit_header_line("#define __yo_aligned_free _aligned_free");
      }, {
        context.emitter.emit_header_line("#define __yo_aligned_alloc aligned_alloc");
        context.emitter.emit_header_line("#define __yo_aligned_free free");
      });
    }
  );
  // OOM hardening (plans/reference/FIXED_REGION_ALLOCATOR.md §2.5): allocation
  // failure is a PANIC with a diagnostic, never a NULL that reaches a
  // dereference. The RC constructors and runtime helpers allocate through
  // __yo_rc_alloc; programs that must survive OOM use the fallible surface
  // (GlobalAllocator.malloc and the try_* APIs). The fixed arm defines
  // __yo_alloc_fail itself (with heap stats) in the code section; the other
  // arms get the plain definition below.
  // In library mode the helper is `static`: a static library is linked into a
  // program that carries its own copy, and two external definitions would be
  // a duplicate-symbol link error (issues/fixed/static-library-exports-no-symbols.md).
  alloc_fail_linkage := if(context.is_library, "static ", "");
  if(context.allocator != "fixed", {
    context.emitter.emit_string_line(
      `
${alloc_fail_linkage}void __yo_alloc_fail(size_t size) {
  fprintf(stderr, "out of memory: requested %zu bytes\\n", size);
  abort();
}`
    );
  });
  context.emitter.emit_header_string_line(`${alloc_fail_linkage}void __yo_alloc_fail(size_t size);`);
  context.emitter.emit_header_string_line(
    `
static inline void* __yo_rc_alloc(size_t size) {
  void* p = __yo_malloc(size);
  if (p == NULL) __yo_alloc_fail(size);
  return p;
}`
  );
  context.emitter.emit_header_line("");
});
export(collect_c_includes, emit_c_includes);
