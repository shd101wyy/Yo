import "std/string" (String);

Raise :: (fn(msg : String) -> i32);

might_fail :: (fn(using(raise : Raise)) -> i32)(
  raise(`oops`)
);

run :: (fn(forall(T : Type, ...(E)),
    f : (fn(using(...(E))) -> T),
    using(...(E))) -> T)(f());

run_test :: (fn() -> i32)({
  (given(raise) : Raise) = ((msg) -> {
    println(msg);
    return i32(42);
  });

  result := run(might_fail);
  assert(result == i32(42), `effect polymorphism: should be 42`);
  return result;
});

main :: (fn() -> void)({
  result := run_test();
  println(str(result));
});
