find_first_greater_than_five :: (fn(max : i32) -> i32) {
  result := -(1);
  i := i32(0);
  while i < max, {
    i = (i + 1);
    cond(
      (i > 5) => {
        result = i;
        break;
      }, 
      true => () // continue loop
    );
  };
  return result;
};

x :: find_first_greater_than_five(20);
assert(find_first_greater_than_five(20) == 6);