open(import("std/fmt"));

Node :: ref(struct(value : i32, next : Option(Self)));

sum :: (fn(head : Node) -> i32)({
  (current_opt : Option(Node)) = head.next;
  (total : i32) = 0;
  while(runtime(true), {
    match(
      current_opt,
      .None => return(total),
      .Some(current) => {
        total = (total + current.value);
        current_opt = current.next;
      }
    );
  });
  total
});

main :: (fn() -> unit)({
  head := Node(
    value : 1,
    next : Option(Node).Some(
      Node(value : 2, next : Option(Node).Some(Node(value : 3, next : Option(Node).None)))
    )
  );
  println(`sum ${sum(head)}`);
});

export(main);
