open import "std/libc/stdio";
Worker :: import "std/worker";

main :: (fn() -> unit) {  
  printf("Starting worker test\n");
  
  Worker.set_num_threads(2);
  
  printf("About to spawn task\n");
  Worker.spawn(() => {
    printf("Task running on worker thread!\n");
  });
  
  printf("Task spawned, waiting...\n");
  
  // Loop a bit to let worker run
  i := 0;
  while runtime(true),
    cond(
      (i >= 10000000) => break,
      true => {
        i = (i + 1);
      }
    );
  
  printf("Done\n");
};

export main;
