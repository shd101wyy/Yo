open import "std/string";
open import "std/fmt";
open import "std/process";

main :: (fn() -> unit) {
  println(env.get(`PATH`).unwrap_or(`No PATH set`));
  println(env.get(`NON_EXISTENT_ENV_VAR`).unwrap_or(`Default Value`));
  env.set(`NON_EXISTENT_ENV_VAR`, `New Value`);
  println(env.get(`NON_EXISTENT_ENV_VAR`).unwrap_or(`Default Value`));
};

export main;
