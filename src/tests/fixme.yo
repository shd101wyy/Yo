open(import("std/string"));
open(import("std/fmt"));
{ yield } :: import("std/async");
{ ArrayList } :: import("std/collections/array_list");
drive :: (fn(rio : Io) -> Impl(Future(usize, Io)))(
  rio.async((aio : Io) => {
    (count : usize) = usize(0);
    seed := ArrayList(usize).new();
    seed.push(usize(1));
    match(
      seed.get(usize(0)),
      .None => (),
      .Some(d) => {
        aio.await(yield(aio), aio);
        inner := ArrayList(usize).new();
        inner.push(d);
        inner.push(d);
        i := usize(0);
        while(runtime(i < inner.len()), {
          match(
            inner.get(i),
            .None => (),
            .Some(f) => {
              aio.await(yield(aio), aio);
              count = (count + f);
            }
          );
          i = (i + usize(1));
        });
      }
    );
    count
  })
);
main :: (fn(io : Io) -> unit)({
  c := io.await(drive(io), io);
  println(`count=${c.to_string()} expected=2`);
});
export(main);
