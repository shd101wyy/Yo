open import "std/fmt";
open import "std/collections/array_list";

main :: (fn() -> unit)({
  // Test mutation through Index trait on ArrayList
  (list : ArrayList(i32)) = ArrayList(i32).new();
  list.push(i32(10));
  list.push(i32(20));
  list.push(i32(30));

  // Read through Index
  assert((list(usize(0)) == i32(10)), "list(0) should be 10");

  // Write through Index: &(list(idx)).* = val
  &(list(usize(1))).* = i32(999);
  assert((list(usize(1)) == i32(999)), "list(1) should be 999 after mutation");

  println(`mutation through Index works!`);
});
export main;
