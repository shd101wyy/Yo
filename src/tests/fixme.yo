open import "std/libc/stdio";
Async :: import "std/async";

main :: (fn() -> unit) {
  reached_end := Box(bool)(false);
  reached_middle := Box(bool)(false);

  task := async {
    reached_middle.* = true;
    return;
  };

  assert(reached_middle.* == true, "should have reached middle");
  assert(reached_end.* == false, "should NOT have reached end");
};
export main;