// Test 7: Test pointer to Array value
{
  arr :: [i32(0), i32(1), i32(2)];
  p :: &(arr(0));
  p.* = 16;
  
  p2 :: &(arr(1));
  p2.* = 18;

  compt_assert(arr(0) == i32(16));
  compt_assert(arr(1) == i32(18));
  compt_assert(arr(2) == i32(2));
};

