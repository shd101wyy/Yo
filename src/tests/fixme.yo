open import "std/libc/stdio";
{ malloc, free } :: import "std/libc/stdlib";
open import "std/string";
{ platform, Platform, env } :: import "std/process";
{
  O_RDONLY, O_WRONLY, O_CREAT, O_TRUNC, O_DIRECTORY,
  AT_FDCWD, AT_REMOVEDIR, DT_DIR, DT_REG
} :: import "std/io/constants";
{
  openat, close, read, write
} :: import "std/io/file";
dir :: import "std/io/dir";

temp_dir :: (fn() -> String)(
  cond(
    (platform == Platform.Win32) => {
      temp := env.get(`TEMP`);
      match(temp,
        .Some(v) => v,
        .None => {
          tmp := env.get(`TMP`);
          match(tmp,
            .Some(v2) => v2,
            .None => `C:\\Temp`
          )
        }
      )
    },
    true => {
      tmp := env.get(`TMPDIR`);
      match(tmp,
        .Some(v) => v,
        .None => {
          tmp2 := env.get(`TMP`);
          match(tmp2,
            .Some(v2) => v2,
            .None => `/tmp`
          )
        }
      )
    }
  )
);

path_join :: (fn(base: String, name: String) -> String)({
  sep := cond(
    (platform == Platform.Win32) => `\\`,
    true => `/`
  );
  cond(
    base.ends_with(sep) => `${base}${name}`,
    true => `${base}${sep}${name}`
  )
});

main :: (fn() -> unit) {
  async {
    tmp_dir := temp_dir();
    dir_path_str := path_join(tmp_dir, `yo_io_dir_test`);
    dir_path_c := dir_path_str.to_cstr();
    dir_path := dir_path_c.ptr().unwrap();
    unlink_result := await dir.unlink(AT_FDCWD, dir_path, AT_REMOVEDIR);
    printf("  cleanup = %d\n", unlink_result);
    mk_result := await dir.mkdir(AT_FDCWD, dir_path, i32(0o755));
    printf("  mkdir = %d\n", mk_result);
    assert(mk_result == i32(0));
    rm_result := await dir.unlink(AT_FDCWD, dir_path, AT_REMOVEDIR);
    printf("  rmdir = %d\n", rm_result);
    assert(rm_result == i32(0));

    // Keep C string buffer alive across awaits
    dir_path_c.len();
  };
};
export main;