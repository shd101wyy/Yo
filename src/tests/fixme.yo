open import "std/libc/stdio";

// === Phase 1: Direct trait type with associated types ===
// Define trait directly — no function wrapper
Iter :: trait(
  Item : Type,
  next :
    fn(self : *(Self)) -> Option(Self.Item)
);

// --- Test 1: Concrete impl ---
Counter :: struct(
  _current : i32,
  _max : i32
);

impl(Counter, Iter(
  Item : i32,
  next : (fn(self : *(Self)) -> Option(Self.Item))(cond(
    (self._current >= self._max) => .None,
    true => {
      val := self._current;
      self._current = (self._current + i32(1));
      .Some(val)
    }
  ))
));

// --- Test 2: Generic impl ---
MyIter :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _data  : *(T),
    _index : usize,
    _len   : usize
  )
);

impl(forall(T : Type), MyIter(T), Iter(
  Item : T,
  next : (fn(self : *(Self)) -> Option(Self.Item))(cond(
    (self._index >= self._len) => .None,
    true => {
      val := (self._data &+ self._index).*;
      self._index = (self._index + usize(1));
      .Some(val)
    }
  ))
));

// === Phase 2: IntoIter trait with where clause ===
IntoIter :: trait(
  Item : Type,
  IntoIterType : Type,
  into_iter :
    fn(self : Self) -> Self.IntoIterType,
  where(Self.IntoIterType <: Iter(Item := Self.Item))
);

// Concrete test: Counter implements IntoIter
impl(Counter, IntoIter(
  Item : i32,
  IntoIterType : Counter,
  into_iter : (fn(self : Self) -> Self.IntoIterType)(self)
));

// Negative test: BadIter implements Iter with Item : bool, but we try to pair it with IntoIter Item : i32
// This should fail because the where clause requires IntoIterType <: Iter(Item := Self.Item)
BadIter :: struct(_x : bool);
impl(BadIter, Iter(
  Item : bool,
  next : (fn(self : *(Self)) -> Option(Self.Item))(.None)
));
// BadStruct :: struct(_v : i32);
// // This should fail: IntoIter Item is i32, but BadIter's Iter Item is bool
// impl(BadStruct, IntoIter(
//   Item : i32,
//   IntoIterType : BadIter,
//   into_iter : (fn(self : Self) -> Self.IntoIterType)(BadIter(_x: true))
// ));

// Generic test: a Wrapper type that holds a MyIter
Wrapper :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    _data  : *(T),
    _len   : usize
  )
);

impl(forall(T : Type), Wrapper(T), IntoIter(
  Item : T,
  IntoIterType : MyIter(T),
  into_iter : (fn(self : Self) -> Self.IntoIterType)(
    MyIter(T)(_data: self._data, _index: usize(0), _len: self._len)
  )
));

main :: (fn() -> unit) {
  // Test 1: Concrete Counter iterator
  printf("=== Counter (concrete impl) ===\n");
  c := Counter(_current: i32(0), _max: i32(5));
  for c, (value) => {
    printf("counter: %d\n", value);
  };

  // Test 2: Generic iterator over array
  printf("=== MyIter (generic impl) ===\n");
  arr := Array(i32, usize(3))(i32(10), i32(20), i32(30));
  iter := MyIter(i32)(_data: &(arr(usize(0))), _index: usize(0), _len: usize(3));
  for iter, (value) => {
    printf("myiter: %d\n", value);
  };

  // Test 3: IntoIter with Counter (concrete)
  printf("=== IntoIter Counter ===\n");
  c2 := Counter(_current: i32(10), _max: i32(13));
  c2_iter := c2.into_iter();
  for c2_iter, (value) => {
    printf("into_iter counter: %d\n", value);
  };

  // Test 4: IntoIter with Wrapper (generic)
  printf("=== IntoIter Wrapper ===\n");
  arr2 := Array(i32, usize(4))(i32(100), i32(200), i32(300), i32(400));
  w := Wrapper(i32)(_data: &(arr2(usize(0))), _len: usize(4));
  w_iter := w.into_iter();
  for w_iter, (value) => {
    printf("into_iter wrapper: %d\n", value);
  };

  printf("done\n");
};

export main;
