open import "std/libc/stdio";
open import "std/string";
{ Path } :: import "std/path";
{ IOError } :: import "std/io/errors";
fs_file :: import "std/fs/file";
{ File, OpenMode, FilePermission } :: import "std/fs/file";
{ temp_dir, path_join } :: import "../../tests/helper";
fs_dir :: import "std/fs/dir";

main :: (fn(using(io : IO)) -> unit)({
  tmp := temp_dir();
  fpath_s := path_join(tmp, `yo_fs_file_str_test.txt`);
  fpath_cstr := fpath_s.to_cstr();
  fpath_c := fpath_cstr.ptr().unwrap();

  w := io.await(fs_file.write_file_cstr(fpath_c, "str path test", using(io)));
  match(w,
    .Ok(_) => { printf("  write ok\n"); },
    .Err(e) => { assert(false, "write_file_str failed"); }
  );

  r := io.await(fs_file.read_to_string_cstr(fpath_c, using(io)));
  match(r,
    .Ok(s) => {
      printf("  read: %s\n", s.to_cstr().ptr().unwrap());
      assert((s == `str path test`), "content mismatch");
    },
    .Err(e) => { assert(false, "read_to_string_str failed"); }
  );

  io.await(fs_dir.remove_file(Path.new(fpath_s), using(io)));
});
export main;
