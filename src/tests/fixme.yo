open import "std/string";
open import "std/fmt";

Raise :: (ctl(forall(T : Type), msg : String) -> T);
Log :: (ctl(msg : String) -> unit);

might_fail :: (fn(using(raise : Raise)) -> i32)(
  raise(`oops`)
);

might_log :: (fn(using(log : Log)) -> unit)(
  log(`logged something`)
);

run_both :: (fn(
    forall(T1 : Type, T2 : Type, ...(E1), ...(E2)),
    f1 : (fn(using(...(E1))) -> T1),
    f2 : (fn(using(...(E2))) -> T2),
    using(...(E1), ...(E2))
  ) -> T1)
{
  f2();
  f1()
};

main :: (fn() -> unit) {
  (given(raise) : Raise) = ((msg) -> {
    println(msg);
    abort ();
  });

  (given(log) : Log) = ((msg) -> {
    println(msg);
    return ();
  });

  run_both(might_fail, might_log);
  assert(false, "should not reach here");
};
export main;