open import "std/libc/stdio";

Speak :: trait(
  speak : (fn(self : Self) -> i32)
);

Run :: trait(
  run : (fn(self : Self) -> i32)
);

// Dog :: struct(); // This should give error working with `dyn`.
Dog :: object();

DogSpeak :: impl(Dog, Speak
  speak : ((self : Self) -> {
    printf("Woof!\n");
    return 1;
  })
);

DogRun :: impl(Dog, Run
  run : ((self : Self) -> {
    printf("The dog is running!\n");
    return 2;
  })
);

act :: (fn(s : Dyn(Speak, Run)) -> i32)
  s.speak() + s.run()
;