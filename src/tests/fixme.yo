open import "std/fmt";

generic_fn :: (fn(forall(T: Type), x: T, callback: (fn(v: T)-> T))-> T)
  callback(x)
;

main :: (fn() -> unit) {
  assert(generic_fn(2, (x) -> (x + 16)) == 18); // anonymous function
  assert(generic_fn(2, (fn(y : i32) -> i32)(y + 18)) == 20); // regular function
  println("Hello, world");
  x := ("hello");
  y := x.to_string();
  ();
};

export main;

// x := "hello".to_string();