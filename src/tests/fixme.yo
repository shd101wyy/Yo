open import "std/libc/stdio";
open import "std/string";
{ Url, UrlError } :: import "std/url/url";

main :: (fn() -> unit) {
  result := Url.parse("http://example.com");
  assert(result.is_ok(), "should parse successfully");
  url := result.unwrap();
  assert((url.scheme() == String.from("http")), "scheme should be http");
  printf("Done\n");
};

export main;
