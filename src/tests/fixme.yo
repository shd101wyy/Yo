open import "std/libc/stdio";
{ GlobalAllocator } :: import "std/allocator";
{ malloc, free } :: GlobalAllocator;
open import "std/string";
tcp :: import "std/io/tcp";
{
  AF_INET, SOCK_STREAM,
  SOL_SOCKET, SO_REUSEADDR, IPPROTO_TCP,
  SHUT_RDWR
} :: import "std/io/socket";

main :: (fn() -> unit) {
  async {
    printf("=== Test 1: Socket create and close ===\n");
    server_fd := await tcp.socket(AF_INET, SOCK_STREAM, i32(0));
    printf("  socket fd = %d\n", server_fd);
    assert(server_fd >= i32(0));
    close_result := await tcp.close(server_fd);
    printf("  close = %d\n", close_result);
    assert(close_result == i32(0));
    printf("  PASSED\n");

    printf("=== Test 2: Set SO_REUSEADDR ===\n");
    s2 := await tcp.socket(AF_INET, SOCK_STREAM, i32(0));
    assert(s2 >= i32(0));
    optval := *(u8)(malloc(usize(4)).unwrap());
    (optval &+ usize(0)).* = u8(1);
    (optval &+ usize(1)).* = u8(0);
    (optval &+ usize(2)).* = u8(0);
    (optval &+ usize(3)).* = u8(0);
    sso := await tcp.setsockopt(s2, SOL_SOCKET, SO_REUSEADDR, optval, u32(4));
    printf("  setsockopt = %d\n", sso);
    assert(sso == i32(0));
    free(.Some(*(void)(optval)));
    cr2 := await tcp.close(s2);
    assert(cr2 == i32(0));
    printf("  PASSED\n");

    printf("=== Test 3: Bind and listen ===\n");
    s3 := await tcp.socket(AF_INET, SOCK_STREAM, i32(0));
    assert(s3 >= i32(0));
    addr3 := tcp.make_sockaddr_in_loopback(u16(0));
    bind3 := await tcp.bind(s3, addr3.buf, addr3.len);
    printf("  bind = %d\n", bind3);
    assert(bind3 == i32(0));
    listen3 := await tcp.listen(s3, i32(128));
    printf("  listen = %d\n", listen3);
    assert(listen3 == i32(0));
    tcp.free_sockaddr(addr3);
    cr3 := await tcp.close(s3);
    assert(cr3 == i32(0));
    printf("  PASSED\n");

    printf("=== Test 4: Echo server-client ===\n");
    srv := await tcp.socket(AF_INET, SOCK_STREAM, i32(0));
    printf("  server fd = %d\n", srv);
    assert(srv >= i32(0));

    optval2 := *(u8)(malloc(usize(4)).unwrap());
    (optval2 &+ usize(0)).* = u8(1);
    (optval2 &+ usize(1)).* = u8(0);
    (optval2 &+ usize(2)).* = u8(0);
    (optval2 &+ usize(3)).* = u8(0);
    sso2 := await tcp.setsockopt(srv, SOL_SOCKET, SO_REUSEADDR, optval2, u32(4));
    assert(sso2 == i32(0));
    free(.Some(*(void)(optval2)));

    addr4 := tcp.make_sockaddr_in_loopback(u16(19877));
    bind4 := await tcp.bind(srv, addr4.buf, addr4.len);
    printf("  bind = %d\n", bind4);
    assert(bind4 == i32(0));
    listen4 := await tcp.listen(srv, i32(128));
    printf("  listen = %d\n", listen4);
    assert(listen4 == i32(0));

    cli := await tcp.socket(AF_INET, SOCK_STREAM, i32(0));
    printf("  client fd = %d\n", cli);
    assert(cli >= i32(0));

    conn_addr := tcp.make_sockaddr_in_loopback(u16(19877));
    conn4 := await tcp.connect(cli, conn_addr.buf, conn_addr.len);
    printf("  connect = %d\n", conn4);
    assert(conn4 == i32(0));
    tcp.free_sockaddr(conn_addr);

    peer_buf := *(u8)(malloc(usize(128)).unwrap());
    peer_len := *(u32)(malloc(usize(4)).unwrap());
    peer_len.* = u32(128);
    acc := await tcp.accept(srv, peer_buf, peer_len);
    printf("  accepted fd = %d\n", acc);
    assert(acc >= i32(0));
    free(.Some(*(void)(peer_buf)));
    free(.Some(*(void)(peer_len)));

    msg := *(u8)("Hello TCP!");
    sent := await tcp.send(cli, msg, usize(10), i32(0));
    printf("  sent = %d\n", sent);
    assert(sent == i32(10));

    recv_buf := *(u8)(malloc(usize(256)).unwrap());
    received := await tcp.recv(acc, recv_buf, usize(256), i32(0));
    printf("  received = %d\n", received);
    assert(received == i32(10));

    assert((recv_buf &+ usize(0)).* == u8(72));
    assert((recv_buf &+ usize(1)).* == u8(101));
    assert((recv_buf &+ usize(2)).* == u8(108));
    assert((recv_buf &+ usize(3)).* == u8(108));
    assert((recv_buf &+ usize(4)).* == u8(111));
    free(.Some(*(void)(recv_buf)));

    shut := await tcp.shutdown(cli, SHUT_RDWR);
    printf("  shutdown = %d\n", shut);

    c1 := await tcp.close(cli);
    printf("  close client = %d\n", c1);
    assert(c1 == i32(0));
    c2 := await tcp.close(acc);
    printf("  close accepted = %d\n", c2);
    assert(c2 == i32(0));
    c3 := await tcp.close(srv);
    printf("  close server = %d\n", c3);
    assert(c3 == i32(0));
    tcp.free_sockaddr(addr4);
    printf("  PASSED\n");

    printf("All TCP tests passed!\n");
  };
};
export main;