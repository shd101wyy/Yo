open(import("std/string"));
open(import("std/fmt"));

P :: ref(struct(x : i32, y : i32));
S :: atomic(ref(struct(v : i32)));

mutate :: (fn(inout(p) : P) -> unit)({
  p.x = i32(99);
});

main :: (fn() -> unit)({
  p := P(x : i32(1), y : i32(2));
  q := p; // reference semantics: q and p share the same handle
  q.x = i32(10);
  println(p.x.to_string()); // expect 10 (shared)
  mutate(p);
  println(p.x.to_string()); // expect 99 (inout mutates in place)
  s := S(v : i32(7));
  println(s.v.to_string()); // expect 7
  ();
});
export(main);
