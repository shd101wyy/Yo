open import "std/collections/array_list";

main :: (fn() -> unit) {
  list := ArrayList(i32).new();
  result := list.push(i32(42));
  assert(result.is_ok());
  assert(list.len() == usize(1));
  
  first := list.get(usize(0));
  assert(first.is_some());
  assert(first.unwrap() == i32(42));

  list.push(i32(10));  
  result2 := list.remove(usize(1), usize(1));
};
export main;