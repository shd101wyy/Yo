main :: (fn() -> unit) {
  // parameter that contains function type
  generic_fn :: (fn(
    forall(T : Type),
    x : T,
    callback : (fn(v : T)-> T)
  ) -> T)
    callback(x)
  ;

  a := generic_fn(1, (x)-> (x + 1));
  b := generic_fn(true, (x)-> !(x));

  assert(a == 2);
  assert(b == false);

  // Test that functions with compile-time parameters are rejected
  // This should be compile-time error:
  // test_compt_param :: (fn(
  //   callback : (fn(compt(x) : i32) -> i32)
  // ) -> unit)
  //   ()
  // ;
};

export main;