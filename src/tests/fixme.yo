open import "std/libc/stdio";
{ GlobalAllocator } :: import "std/allocator";
{ malloc, free } :: GlobalAllocator;
open import "std/string";
{ platform, Platform, env } :: import "std/process";
tcp :: import "std/io/tcp";
{
  AF_INET, SOCK_STREAM,
  SOL_SOCKET, SO_REUSEADDR, IPPROTO_TCP,
  SHUT_RDWR
} :: import "std/io/socket";

main :: (fn() -> unit) {
  async {
    // =============================================
    // Test 1: Create a TCP socket
    // =============================================
    printf("Test 1: Create TCP socket\n");
    server_fd := await tcp.socket(AF_INET, SOCK_STREAM, i32(0));
    printf("  socket fd = %d\n", server_fd);
    assert(server_fd >= i32(0));

    // =============================================
    // Test 2: Set SO_REUSEADDR
    // =============================================
    printf("Test 2: Set SO_REUSEADDR\n");
    optval := *(u8)(malloc(usize(4)).unwrap());
    (optval &+ usize(0)).* = u8(1);
    (optval &+ usize(1)).* = u8(0);
    (optval &+ usize(2)).* = u8(0);
    (optval &+ usize(3)).* = u8(0);
    sso := await tcp.setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, optval, u32(4));
    printf("  setsockopt = %d\n", sso);
    assert(sso == i32(0));
    free(.Some(*(void)(optval)));

    // =============================================
    // Test 3: Bind to loopback on port 0 (OS assigns)
    // =============================================
    printf("Test 3: Bind to loopback\n");
    addr := tcp.make_sockaddr_in_loopback(u16(19876));
    bind_result := await tcp.bind(server_fd, addr.buf, addr.len);
    printf("  bind = %d\n", bind_result);
    assert(bind_result == i32(0));

    // =============================================
    // Test 4: Listen
    // =============================================
    printf("Test 4: Listen\n");
    listen_result := await tcp.listen(server_fd, i32(128));
    printf("  listen = %d\n", listen_result);
    assert(listen_result == i32(0));

    // =============================================
    // Test 5: Create client and connect
    // =============================================
    printf("Test 5: Create client and connect\n");
    client_fd := await tcp.socket(AF_INET, SOCK_STREAM, i32(0));
    printf("  client fd = %d\n", client_fd);
    assert(client_fd >= i32(0));

    connect_addr := tcp.make_sockaddr_in_loopback(u16(19876));
    conn_result := await tcp.connect(client_fd, connect_addr.buf, connect_addr.len);
    printf("  connect = %d\n", conn_result);
    assert(conn_result == i32(0));
    tcp.free_sockaddr(connect_addr);

    // =============================================
    // Test 6: Accept the connection on server side
    // =============================================
    printf("Test 6: Accept connection\n");
    peer_addr_buf := *(u8)(malloc(usize(128)).unwrap());
    peer_addr_len := *(u32)(malloc(usize(4)).unwrap());
    peer_addr_len.* = u32(128);
    accepted_fd := await tcp.accept(server_fd, peer_addr_buf, peer_addr_len);
    printf("  accepted fd = %d\n", accepted_fd);
    assert(accepted_fd >= i32(0));
    free(.Some(*(void)(peer_addr_buf)));
    free(.Some(*(void)(peer_addr_len)));

    // =============================================
    // Test 7: Send data from client
    // =============================================
    printf("Test 7: Send data\n");
    msg := *(u8)("Hello TCP!");
    sent := await tcp.send(client_fd, msg, usize(10), i32(0));
    printf("  sent = %d\n", sent);
    assert(sent == i32(10));

    // =============================================
    // Test 8: Receive data on server side
    // =============================================
    printf("Test 8: Recv data\n");
    recv_buf := *(u8)(malloc(usize(256)).unwrap());
    received := await tcp.recv(accepted_fd, recv_buf, usize(256), i32(0));
    printf("  received = %d\n", received);
    assert(received == i32(10));

    // Verify: "Hello TCP!" = H(72) e(101) l(108) l(108) o(111)
    assert((recv_buf &+ usize(0)).* == u8(72));
    assert((recv_buf &+ usize(1)).* == u8(101));
    assert((recv_buf &+ usize(2)).* == u8(108));
    assert((recv_buf &+ usize(3)).* == u8(108));
    assert((recv_buf &+ usize(4)).* == u8(111));
    free(.Some(*(void)(recv_buf)));

    // =============================================
    // Test 9: Shutdown and close
    // =============================================
    printf("Test 9: Shutdown and close\n");
    shut := await tcp.shutdown(client_fd, SHUT_RDWR);
    printf("  shutdown = %d\n", shut);

    c1 := await tcp.close(client_fd);
    printf("  close client = %d\n", c1);
    assert(c1 == i32(0));

    c2 := await tcp.close(accepted_fd);
    printf("  close accepted = %d\n", c2);
    assert(c2 == i32(0));

    c3 := await tcp.close(server_fd);
    printf("  close server = %d\n", c3);
    assert(c3 == i32(0));

    tcp.free_sockaddr(addr);

    printf("All TCP tests passed!\n");
  };
};
export main;