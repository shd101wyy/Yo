open import "std/collections/hash_map.yo";

main :: (fn() -> unit) {
  // Test HashMap with boxed keys and values
  m := HashMap(Box(i32), Box(i32)).new();
  m.set(box(1), box(100));
  // m.set(box(2), box(200));
  
  assert(m.get(box(1)).unwrap().(*) == 100);
  // assert(m.get(box(2)).unwrap().(*) == 200);
  // assert(m.get(box(3)).is_none());
};

export main;
