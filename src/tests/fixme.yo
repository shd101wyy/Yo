open import "std/libc/stdio";
open import "std/string";
open import "std/fmt";
{ yield } :: import "std/async";

main :: (fn(using(io : IO)) -> unit) {
  // Simple async without extra effects
  {
    task := io.async((using(io : IO))=> {
      io.await(yield());
      i32(300)
    });
    result := io.await(task);
    assert(result == i32(300), "simple async should work");
  };

  // No matching given should error
  {
    apply :: (fn(
      x : i32,
      using(op : (fn(a : i32) -> bool))
    ) -> bool)(
      op(x)
    );
  };
};
export main;
