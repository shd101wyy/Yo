open import "std/string"; // Let's use `String` instead of `str`
open import "std/fmt";

Raise :: (ctl(forall(T : Type), msg : String, msg2 : String) -> T);

main :: (fn() -> unit) {
 (given(raise) : Raise) = ((msg, msg2) -> {// values/anonymous-function.ts
    println(msg);
    println(msg2);
    abort (); // abort unit value (), whose type matches the enclosing function `main` function return type
  });
  raise(`fixme`, `This is a fixme test`); // This should trigger the effect handler above, printing the messages and aborting the program
  println("This line should not be printed");
  assert(false, "This assertion should not be reached");
};
export main;