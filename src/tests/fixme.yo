main :: (fn(using(io : IO)) -> unit) {
  {
    task := io.async(() => {
      return 1;
    });
    result1 := io.await(task);
    result2 := io.await(task);
    assert(result1 == result2);
  };
  {
    task := io.async(() => {
      return Box(i32)(12);
    });
    result1 := io.await(task);
    result2 := io.await(task);
    assert(result1.* == result2.*);
  };
};
export main;