// Minimization attempt #2 for issues/ts-codegen-undeclared-temp-in-short-circuit-option-drop.md:
// the original context was a huge fn, the || chain inside a match arm of a
// cond, the Option payload a large RC enum. Reproduce that nesting.
{ assert } :: import("std/assert");
{ ArrayList } :: import("std/collections/array_list");
open(import("std/string"));

Big :: enum(
  A(xs : ArrayList(i32)),
  B(s : String),
  C(n : i32)
);

get_big :: (fn(n : i32) -> Option(Big))({
  out := Option(Big).None;
  cond(
    (n > i32(0)) => {
      xs := ArrayList(i32).new();
      xs.push(n);
      out = Option(Big).Some(Big.A(xs : xs));
    },
    true => ()
  );
  out
});

classify :: (fn(k : i32, a : bool, b : bool) -> i32)({
  (out : i32) = i32(0);
  cond(
    (k == i32(1)) => {
      out = match(
        k,
        _ => {
          flag := ((a || b) || get_big(k).is_some());
          cond(
            flag => i32(10),
            true => i32(20)
          )
        }
      );
    },
    (k == i32(2)) => {
      out = i32(2);
    },
    true => {
      out = i32(3);
    }
  );
  out
});

main :: (fn() -> unit)({
  r := classify(i32(1), false, false);
  assert(r == i32(10));
  r2 := classify(i32(2), true, true);
  assert(r2 == i32(2));
});
export(main);
