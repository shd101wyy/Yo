open import "std/string";
open import "std/fmt";
open import "std/process";

main :: (fn() -> unit) {
  print(`Command-line arguments:\n`);
  
  // Get parsed arguments as Strings
  parsed_args := args();
  
  // Print number of arguments
  print(`argc = `);
  println(argc());
  print(`\n`);
  
  // Print each argument
  i := usize(0);
  len := parsed_args.len();
  while i < len, {
    arg := parsed_args.get(i).unwrap();
    print("arg(");
    print(i);
    print(") = ");
    println(arg);
    println(`arg(${i}) = ${arg}`);
    i = (i + 1);
  };
  
  ();
};

export main;
