open import "std/string";
open import "std/fmt";

Raise :: (ctl(forall(T : Type), msg : String) -> T);

// Function that USES the effect (propagates via using parameter)
might_fail :: (fn(using(raise : Raise)) -> i32)(
  raise(`oops`)
);

// Effect-polymorphic function: runs f with whatever effects f needs
run :: (fn(forall(T : Type, ...(E)),
    f : (fn(using(...(E))) -> T),
    using(...(E))) -> T)(f());

main :: (fn() -> unit) {
  (given(raise) : Raise) = ((msg) -> {
    println(msg);
    return i32(42);
  });

  result := run(might_fail);
  assert(result == i32(42), "effect polymorphism: should be 42");
  println(`result: ${result}`);
};
export main;