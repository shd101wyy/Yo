{ println } :: import "std/fmt";

main :: (fn() -> unit) {
  escaped1 := `Price: \${100}`;
  assert(escaped1 == "Price: ${100}".to_string(), "escaped1 failed");
  println(escaped1);
  
  // Test escaped dollar with actual interpolation
  escaped2 := `\${notInterpolated} but ${123} is`;
  assert(escaped2 == "${notInterpolated} but 123 is".to_string(), "escaped2 failed");
  println(escaped2);

  // Test escaped backslash
  escaped3 := `Path: C:\\Users\\Name`;
  assert(escaped3 == "Path: C:\\Users\\Name".to_string(), "escaped3 failed");
  println(escaped3);
  
  // Test escaped newline
  escaped4 := `Line1\nLine2`;
  assert(escaped4 == "Line1\nLine2".to_string(), "escaped4 failed");
  println(escaped4);
  
  // Test escaped tab
  escaped5 := `Tab\there`;
  assert(escaped5 == "Tab\there".to_string(), "escaped5 failed");
  println(escaped5);
  
  // Test escaped quote
  escaped6 := `He said \"Hello\"`;
  assert(escaped6 == "He said \"Hello\"".to_string(), "escaped6 failed");
  println(escaped6);
  
  // Test multiple escape sequences
  escaped7 := `\${a} and \${b} with ${42}`;
  assert(escaped7 == "${a} and ${b} with 42".to_string(), "escaped7 failed");
  println(escaped7);
};

export main;
