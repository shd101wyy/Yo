open import "std/libc/stdio";
file :: import "std/io/file";
{ AT_FDCWD, O_RDONLY } :: import "std/io/constants";

main :: (fn(using(io : IO)) -> unit)({
  task := io.async((using(...(io : IO)))=> {
    result := io.await(file.openat(AT_FDCWD, *(u8)("tests/fixtures/test_file.txt"), O_RDONLY, i32(0)));
    printf("result = %d\n", result);
    assert(result >= i32(0), "openat should succeed");
    cr := io.await(file.close(result));
    assert(cr == i32(0), "close should succeed");
  });
  io.await(task);
});

export main;
