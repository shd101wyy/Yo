main :: (fn() -> unit) {
  // Mutual recursion
  compt(is_even) : (fn(n : i32) -> bool);
  compt(is_odd) : (fn(n : i32) -> bool);

  is_even = _
    cond
      (n == 0) => true,
      true     => is_odd(n - 1)
  ;

  is_odd  = _
    cond
      (n == 0) => false,
      true     => is_even(n - 1)
  ;

  assert(is_even(10) == true);
  assert(is_odd(10) == false);
  assert(is_even(11) == false);
  assert(is_odd(11) == true);
};

export main;