open import "std/fmt";

// Test that dereferencing a borrowed pointer and returning it
// correctly calls ___dup to avoid use-after-free
main :: (fn() -> unit) {
  msg := "Hello, 世界!";
  {
    println(msg); // no memory leak
  };
  {
    s := msg.to_string();
    println(s); // should no longer have memory leak
  };
};

export main;