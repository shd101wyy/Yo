open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
g_seen := ArrayList(ArrayList(i32)).new();
mk :: (fn() -> ArrayList(i32))({
  l := ArrayList(i32).new();
  g_seen.push(l);
  l
});
discard_stmt_body :: (fn() -> unit)(___ := mk());
main :: (fn() -> unit)({
  discard_stmt_body();
  survivor := match(g_seen.get(usize(0)),.Some(l) => l,.None => ArrayList(i32).new());
  println(`rc=${rc(survivor)}`);
});
export(main);
