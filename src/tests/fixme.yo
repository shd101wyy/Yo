open import "std/collections/array_list";
open import "std/libc/stdio";

MyBox :: object(
  value: i32
);
impl(MyBox,
  dispose : (fn(self: MyBox) -> unit)({
    printf("Disposing MyBox with value: %d\n", self.value);
  })
);

main :: (fn() -> unit) {
  MyBox(42);
  ArrayList(i32).with_capacity(usize(10));
};
export main;