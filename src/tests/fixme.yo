open import "std/string";
open import "std/fmt";
open import "std/error";

main :: (fn() -> unit) {
  (err : AnyError) = dyn(`default source`);

  match(err.source(),
    .Some(s) => assert(false, "Expected None source"),
    .None => assert(true)
  );

  // Test downcast
  match(downcast(err, String),
    .Some(s) => assert(s == `default source`, "Expected error message to match"),
    .None => assert(false, "Expected Some(String), got None")
  );
};
export main;