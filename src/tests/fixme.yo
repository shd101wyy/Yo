extern "Yo",
  some_cond : (fn() -> bool)
;

{
  // Test that panic works at compile-time for CTFE functions
  // Note: panic at compile-time only works for functions with compt return type
  // or for builtins like assert
  test_panic :: (fn(compt(x) : bool) -> compt(bool))(
    cond(
      x => panic("x must be non-negative"),
      true => x
    )
  );

  // This should work - x is positive
  result1 :: test_panic(false);
  assert(result1 == false);
  assert(result1 == false);

  test_some_cond :: (fn() -> unit) {
  cond(
    some_cond() => panic("GG"),
    true => ()
  );
  };
  test_some_cond();

  // assert(false, "Reached the end of fixme.yo tests");

