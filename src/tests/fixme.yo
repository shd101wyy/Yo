comptime_expect_error(
  Point3 :: struct(x : comptime_int, y : Box(i32)) // Error: incompatible field contexts
                                              // comptime_int can only be used in compile-time context,
                                              // Box `object` can only be used in run-time context.
                                              // There is no intersection between the two contexts.
);

SelfRecursive :: struct(
  v : i32,
  next: *(Self)
);
// i32 is both comptime and runtime
// *(Self) is both comptime and runtime
// therefore SelfRecursive should be both comptime and runtime
comptime_assert(Type.impls(SelfRecursive, Comptime));
comptime_assert(Type.impls(SelfRecursive, Runtime));


// next: *(Self) is both comptime and runtime
// therefore SelfRecursive2 should be both comptime and runtime
SelfRecursive2 :: struct(
  next: *(Self)
);
comptime_assert(Type.impls(SelfRecursive2, Comptime));
comptime_assert(Type.impls(SelfRecursive2, Runtime));

// v : int is only runtime
// therefore SelfRecursive3 should be only runtime
SelfRecursive3 :: struct(
  v : int,
  next: *(Self)
);
comptime_assert(Type.impls(SelfRecursive3, Comptime) == false);
comptime_assert(Type.impls(SelfRecursive3, Runtime));

// v : comptime_int is only comptime
// therefore SelfRecursive4 should be only comptime
SelfRecursive4 :: struct(
  v : comptime_int,
  next: *(Self)
);
comptime_assert(Type.impls(SelfRecursive4, Comptime));
comptime_assert(Type.impls(SelfRecursive4, Runtime) == false);
