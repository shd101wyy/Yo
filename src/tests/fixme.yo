open import "std/libc/stdio";
file :: import "std/io/file";
pipe_io :: import "std/io/pipe";

main :: (fn() -> unit) {
  async {
    pipefd_uninit := MaybeUninit(Array(i32, usize(2))).new();
    pipefd := *(i32)(pipefd_uninit.as_ptr());
    pr := await pipe_io.pipe(pipefd);
    printf("  pipe = %d\n", pr);
    assert(pr == i32(0));

    read_fd := (pipefd &+ usize(0)).*;
    write_fd := (pipefd &+ usize(1)).*;
    assert(read_fd >= i32(0));
    assert(write_fd >= i32(0));

    data := *(u8)("hello pipe");
    data_len := u32(10);
    wr := await file.write(write_fd, data, data_len, u64(0));
    printf("  write = %d\n", wr);
    assert(wr == i32(data_len));

    buf_uninit := MaybeUninit(Array(u8, usize(16))).new();
    buf := *(u8)(buf_uninit.as_ptr());
    rd := await file.read(read_fd, buf, u32(16), u64(0));
    printf("  read = %d\n", rd);
    assert(rd == i32(data_len));
    assert((buf &+ usize(0)).* == u8(104));
    assert((buf &+ usize(6)).* == u8(112));
    assert((buf &+ usize(9)).* == u8(101));

    c1 := await file.close(read_fd);
    c2 := await file.close(write_fd);
    assert(c1 == i32(0));
    assert(c2 == i32(0));

    pipefd2_uninit := MaybeUninit(Array(i32, usize(2))).new();
    pipefd2 := *(i32)(pipefd2_uninit.as_ptr());
    pr2 := await pipe_io.pipe(pipefd2);
    printf("  pipe2 = %d\n", pr2);
    assert(pr2 == i32(0));

    read_fd2 := (pipefd2 &+ usize(0)).*;
    write_fd2 := (pipefd2 &+ usize(1)).*;

    dup_fd := await pipe_io.dup(read_fd2);
    printf("  dup = %d\n", dup_fd);
    assert(dup_fd >= i32(0));

    close_read := await file.close(read_fd2);
    assert(close_read == i32(0));

    data2 := *(u8)("dup test");
    data2_len := u32(8);
    wr2 := await file.write(write_fd2, data2, data2_len, u64(0));
    assert(wr2 == i32(data2_len));

    buf2_uninit := MaybeUninit(Array(u8, usize(16))).new();
    buf2 := *(u8)(buf2_uninit.as_ptr());
    rd2 := await file.read(dup_fd, buf2, u32(16), u64(0));
    assert(rd2 == i32(data2_len));
    assert((buf2 &+ usize(0)).* == u8(100));
    assert((buf2 &+ usize(7)).* == u8(116));

    c3 := await file.close(dup_fd);
    c4 := await file.close(write_fd2);
    assert(c3 == i32(0));
    assert(c4 == i32(0));

    pipefd3_uninit := MaybeUninit(Array(i32, usize(2))).new();
    pipefd3 := *(i32)(pipefd3_uninit.as_ptr());
    pr3 := await pipe_io.pipe(pipefd3);
    assert(pr3 == i32(0));

    pipefd4_uninit := MaybeUninit(Array(i32, usize(2))).new();
    pipefd4 := *(i32)(pipefd4_uninit.as_ptr());
    pr4 := await pipe_io.pipe(pipefd4);
    assert(pr4 == i32(0));

    read_fd3 := (pipefd3 &+ usize(0)).*;
    write_fd3 := (pipefd3 &+ usize(1)).*;
    read_fd4 := (pipefd4 &+ usize(0)).*;
    write_fd4 := (pipefd4 &+ usize(1)).*;

    dup2_fd := await pipe_io.dup2(write_fd3, write_fd4);
    printf("  dup2 = %d\n", dup2_fd);
    assert(dup2_fd == write_fd4);

    c5 := await file.close(write_fd3);
    c6 := await file.close(read_fd4);
    assert(c5 == i32(0));
    assert(c6 == i32(0));

    data3 := *(u8)("dup2 ok");
    data3_len := u32(7);
    wr3 := await file.write(write_fd4, data3, data3_len, u64(0));
    assert(wr3 == i32(data3_len));

    buf3_uninit := MaybeUninit(Array(u8, usize(16))).new();
    buf3 := *(u8)(buf3_uninit.as_ptr());
    rd3 := await file.read(read_fd3, buf3, u32(16), u64(0));
    assert(rd3 == i32(data3_len));
    assert((buf3 &+ usize(0)).* == u8(100));
    assert((buf3 &+ usize(6)).* == u8(107));

    c7 := await file.close(read_fd3);
    c8 := await file.close(write_fd4);
    assert(c7 == i32(0));
    assert(c8 == i32(0));
  };
};
export main;
