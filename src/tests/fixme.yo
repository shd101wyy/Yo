// Minimal reproduction: method calling another method returning Self in cond branch

{ Writer, Alignment } :: import "std/fmt/writer";
{ rune } :: import "std/string/rune";

main :: (fn() -> unit) {
  w := Writer.new();
  w2 := w.write_padded("hi", usize(10), rune(u32(' ')), Alignment.Left);
  ()
};
export main;

