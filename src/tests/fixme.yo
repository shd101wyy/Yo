open import "std/libc/stdio";
{ yield } :: import "std/async";

main :: (fn(using(io : IO)) -> unit)({
  counter := Box(i32)(0);

  task1 := io.async((using(...(io : IO)))=> {
    assert((counter.* == i32(0)), "counter should be 0 at start of task1");
    counter.* = (counter.* + 1);
    io.await(yield());
    assert((counter.* == i32(11)), "counter should be 11 after yield in task1");
    counter.* = (counter.* + 1);
    return counter.*;
  });

  task2 := io.async((using(...(io : IO)))=> {
    assert((counter.* == i32(1)), "counter should be 1 at start of task2");
    counter.* = (counter.* + 10);
    io.await(yield());
    assert((counter.* == i32(12)), "counter should be 12 after yield in task2");
    counter.* = (counter.* + 10);
    return counter.*;
  });

  // Both tasks are cold (not started).
  // join starts both and waits for all to complete.
  io.join(task1, task2);

  // After join, both are complete — io.await just extracts results.
  result1 := io.await(task1);
  result2 := io.await(task2);

  // Both tasks incremented counter: +2 from task1, +20 from task2
  assert((counter.* == i32(22)), "counter should be 22 after join");
});

export main;
