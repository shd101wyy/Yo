open import "std/libc/stdio";
Async :: import "std/async";

main :: (fn() -> unit) {
  async {
    counter := Box(i32)(0);
    result := Box(i32)(0);

    task := async {
      while runtime(counter.* < i32(1)), {
        counter.* = (counter.* + 1);
        temp := Box(i32)(42);
        await Async.yield();
        result.* = temp.*;
      };
    };

    await task;
    assert(counter.* == i32(1), "loop runs exactly once");
    assert(result.* == i32(42), "result from single iteration");
  };
};
export main;