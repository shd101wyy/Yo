open import "std/fmt";

Node :: object(value: i32, next: Option(Self));

traverse :: (fn(head: Option(Node)) -> i32)({
  (count : i32) = i32(0);
  (current_opt : Option(Node)) = head;

  while runtime(true), {
    match(current_opt,
      .None => { return count; },
      .Some(current) => {
        count = (count + i32(1));
        current_opt = current.next;
      }
    );
  };
  count
});

main :: (fn() -> unit)({
  (n3 : Node) = Node(i32(3), .None);
  (n2 : Node) = Node(i32(2), .Some(n3));
  (n1 : Node) = Node(i32(1), .Some(n2));

  (result : i32) = traverse(.Some(n1));
  assert((result == i32(3)), "should count 3 nodes");
  println(`traverse count: ${result}`);
});

export main;
