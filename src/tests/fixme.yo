Foo :: newtype(n : i32);

Bar :: trait(m : (fn(self : Self, x : bool) -> i32));

impl(Foo, m : (fn(self : Self, x : i32) -> i32)(x));

impl(Foo, Bar(m : (fn(self : Self, x : bool) -> i32)(cond(x => i32(1), true => i32(0)))));

main :: (fn() -> unit)({
  f := Foo(n : i32(1));
  r := f.m(true);
  ()
});

export(main);
