open import "std/libc/stdio";
{ hex_decode } :: import "std/encoding/hex";
{ Error, AnyError, Exception } :: import "std/error";

main :: (fn() -> unit)({
  given(exn) := Exception(throw : ((err) -> {
    printf("error caught\n");
    escape ();
  }));
  r := hex_decode("ZZ");
  printf("shouldn't reach here\n");
});
export main;
