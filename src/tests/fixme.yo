main :: (fn() -> unit) {
  val :: i32(10);
  p :: &(val);
  p.* = i32(20);
  compt_assert(val == i32(20));

  s :: {x : 1, y : 2};
  s.x = 3;
  compt_assert(s.x == 3);
  
  Point :: struct(x : i32, y : i32);
  (compt(point) : Point) = Point(3, 4);
  point.x = 16;
  compt_assert(point.x == 16);
};

export main;