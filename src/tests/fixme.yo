main :: (fn() -> unit) {
  // FIXME:
  {
    compt_add :: (fn(x : i32, compt(y) : i32) -> i32)
      (x + y)
    ;
    x := compt_add(1, 1);
    y := compt_add(2, 1);
    z := compt_add(3, 2);
    
    assert(x == 2);
    assert(y == 3);
    assert(z == 5);
  };
};

export main;

