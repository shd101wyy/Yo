
{ printf } :: import "std/libc/stdio";

// Test 4: while loop with step and continue
sum_with_step :: (fn(max : i32) -> i32) {
  result := 0;
  i := i32(0);
  while i < max, i = (i + 1), {
    cond(
      ((i % 3) == 0) => continue,
      true => {
        result = (result + i);
      }
    );
  };
  return result;
};

main :: (fn() -> unit) {
  printf("Test 4 - Sum excluding multiples of 3 up to 10: %d\n", sum_with_step(10));
};

export main;