open(import("std/fmt"));
open(import("std/string"));

Wrap :: ref(struct(b : Box(i32)));

poke_loop :: (fn(w : Wrap, borrowed : Box(i32)) -> unit)({
  (i : i32) = i32(0);
  while(runtime(i < i32(2)), {
    w.b = box(i32(100) + i);
    i = (i + i32(1));
  });
  println(`borrowed: ${borrowed.*}`);
});

main :: (fn() -> unit)({
  w := Wrap(b : box(i32(42)));
  poke_loop(w, w.b);
});
export(main);
