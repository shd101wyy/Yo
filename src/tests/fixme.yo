open(import("std/fmt"));
open(import("std/string"));
Holder :: object(s : String, n : i32);
main :: (fn() -> unit)({
  use_and_sink :: (fn(ref(x) : String, own(victim) : Holder) -> usize)(
    x.len()
  );
  a := Holder(s : String.from("abcde"), n : i32(1));
  b := Holder(s : String.from("other"), n : i32(2));
  n := use_and_sink(a.s, b);
  assert(n == usize(5), "ok");
  println("done");
});
export(main);
