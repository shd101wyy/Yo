open import "std/libc/stdio";
open import "std/string";

main ::
  (fn() -> unit) {
  // Test 1: Bare fn-type effect with forall — resume
  Throw :: (fn(forall(T : Type), msg : str, resume_val : T) -> T);

  safe_divide :: (fn(x : i32, y : i32, using(throw : Throw)) -> i32)(
    cond(
      (y == 0) => throw("div by zero", i32(0)),
      true => (x / y)
    )
  );

  (given(throw) : Throw) = ((msg, resume_val) -> {
    return resume_val;
  });

  result := safe_divide(10, 0);
  printf("Result: %d\n", result);
  assert((result == i32(0)), "should resume with 0");

  result2 := safe_divide(10, 2);
  printf("Result2: %d\n", result2);
  assert((result2 == i32(5)), "should be 5");

  // Test 2: Bare fn-type effect with forall — escape
  Throw2 :: (fn(forall(T : Type), msg : str, resume_val : T) -> T);

  might_fail :: (fn(x : i32, using(throw2 : Throw2)) -> i32)(
    cond(
      (x < 0) => throw2("negative", i32(0)),
      true => (x * 2)
    )
  );

  run_escape_test :: (fn() -> i32) {
    (given(throw2) : Throw2) = ((msg, resume_val) -> {
      escape 99;
    });

    result3 := might_fail(i32(-1), using(throw2));
    return result3;
  };

  esc_result := run_escape_test();
  printf("Escape result: %d\n", esc_result);
  assert((esc_result == i32(99)), "should escape with 99");
  printf("Escape result: %d\n", esc_result);
  assert((esc_result == i32(99)), "should escape with 99");

  // Test 3: Effect polymorphism with using spread
  Raise :: (fn(msg : String) -> i32);

  might_fail2 :: (fn(using(raise : Raise)) -> i32)(
    raise(`oops`)
  );

  run :: (fn(forall(T : Type, ...(E)),
      f : (fn(using(...(E))) -> T),
      using(...(E))) -> T)(f());

  (given(raise) : Raise) = ((msg) -> {
    printf("Raised: ");
    return i32(42);
  });

  result4 := run(might_fail2);
  printf("Result4: %d\n", result4);
  assert((result4 == i32(42)), "effect polymorphism: should be 42");

  // Test 4: Non-effect using parameter (contextual parameter)
  add_numbers :: (fn(
    x : i32,
    y : i32,
    using(add_fn : (fn(a : i32, b : i32) -> i32))
  ) -> i32)(
    add_fn(x, y)
  );

  given(my_add) := (fn(a : i32, b : i32) -> i32)(a + b);

  result5 := add_numbers(3, 4);
  printf("Result5: %d\n", result5);
  assert((result5 == i32(7)), "implicit resolution failed");

  printf("All tests passed!\n");
};

export main;
