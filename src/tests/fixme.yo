// @skip_prelude
Comptime :: trait(
  id := "Comptime"
);
Runtime :: trait(
  id := "Runtime"
);

ComptimeAdd :: (fn(comptime(Rhs) : Type, comptime(Output) ?= Rhs, where(Rhs <: Comptime, Output <: Comptime))-> comptime(Trait))
  trait(
    where(Self <: Comptime),
    Output := Output,
    (+)    :  (fn(comptime(lhs): Self, comptime(rhs): Rhs)-> comptime(Output))
  )
;

Result :: (fn(comptime(OkType): Type, comptime(ErrorType): Type) -> comptime(Type))
  enum(
    Ok(value: OkType),
    Err(error: ErrorType)
  )
;

TryFrom :: (fn(comptime(From) : Type) -> comptime(Trait))(
  trait(
    Error : Type,
    try_from :
      (fn(value : From) -> Result(Self, Self.Error))
  )
);