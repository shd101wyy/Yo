main :: (fn() -> unit) {
  Shape :: enum(
    Circle(r: i32),
    Rectangle(w: i32, h: i32)
  );

  // Test labeled destructuring
  area_with_labels :: (fn(shape: Shape) -> i32)
    match(shape,
      .Circle(r : radius) =>
        (i32(3) * (radius * radius)),
      .Rectangle(h : height, w : width) =>
        (height * width)
    )
  ;
};

export main;