open import "std/libc/stdio";
Async :: import "std/async";

main :: (fn() -> unit) {
  async {
    result := Box(i32)(0);

    task := async {
      x := i32(2);
      result.* = match(x,
        1 => {
          await Async.yield();
          i32(10)
        },
        2 => {
          await Async.yield();
          i32(20)
        },
        _ => i32(30)
      );
    };

    await task;
    printf("result = %d\n", result.*);
    assert(result.* == i32(20), "match should take branch 2 and return 20");
  };
};
export main;