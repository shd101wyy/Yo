// yo-self inherent-first check: `f.m(true)` must resolve to the inherent m(i32)
// (shadowing Bar.m(bool)) and error, NOT silently dispatch to Bar.m. Compile with
// the new yo-self bin and confirm it does NOT emit a call to Bar's m(bool).
Foo :: newtype(n : i32);

Bar :: trait(m : (fn(self : Self, x : bool) -> i32));

impl(Foo, m : (fn(self : Self, x : i32) -> i32)(x));

impl(Foo, Bar(m : (fn(self : Self, x : bool) -> i32)(cond(x => i32(1), true => i32(0)))));

main :: (fn() -> unit)({
  f := Foo(n : i32(1));
  r := f.m(true);
  ()
});

export(main);
