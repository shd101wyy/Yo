// === Dyn is/downcast test ===
open import "std/libc/stdio";
open import "std/string";
open import "std/fmt";

Cat :: object(name : String);
impl(Cat, ToString(to_string : ((self) -> self.*.name)));

Dog :: object(name : String);
impl(Dog, ToString(to_string : ((self) -> self.*.name)));

Animal :: Dyn(ToString);

main :: (fn() -> unit) {
  (animal : Animal) = dyn(Cat(`whiskers`));

  // === is() builtin test ===
  printf("typeid(typeof(animal)): %d\n", typeid(typeof(animal)));
  printf("is(animal, Cat): %d\n", is(animal, Cat));
  printf("is(animal, Dog): %d\n", is(animal, Dog));

  // === downcast() builtin test ===
  maybe_cat := downcast(animal, Cat);
  match(maybe_cat,
    .Some(c) => {
      printf("downcast to Cat: %s\n", c.name.as_str());
    },
    .None => {
      printf("not a Cat\n");
    }
  );

  maybe_dog := downcast(animal, Dog);
  match(maybe_dog,
    .Some(d) => {
      printf("downcast to Dog: %s\n", d.name.as_str());
    },
    .None => {
      printf("not a Dog\n");
    }
  );

  printf("done\n");
};
export main;