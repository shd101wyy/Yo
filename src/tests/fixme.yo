open import "std/collections/array_list";
open import "std/string";

main :: (fn() -> unit) {
  bytes := ArrayList(u8).new();
  bytes.push(u8(72));
  bytes.push(u8(101));
  bytes.push(u8(108));
  bytes.push(u8(108));
  bytes.push(u8(111));
  
  s := String.from_bytes(bytes);
  assert(not(s.is_empty()));
  assert(s.len() == usize(5));
};

export main;