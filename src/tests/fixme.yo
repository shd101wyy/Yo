some_condition :: (fn() -> bool)(
  runtime(true)
);

test_while_with_mixed_2 :: (fn() -> i32) {
  while some_condition(), {
    a := cond(
      some_condition() => break,
      some_condition() => {
        return 0;
      },
      some_condition() => true,
      true => continue
    );
  };

  0
};

main :: (fn() -> unit) {
  assert(test_while_with_mixed_2() == 0);
};

export main;