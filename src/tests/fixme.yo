RetI32 :: trait(
  return_i32 : (fn(self : *(Self)) -> i32)
);

impl(Box(i32), RetI32(
  // Let's x2 here
  return_i32 : ((self) -> {
    return self.*.* + (self.*.*);
  })
));

ret_boxi32_i32 :: (fn() -> Impl(RetI32)) {
  return Box(i32)(456);
};

main :: (fn() -> unit) {
  r := ret_boxi32_i32();
  assert(&(r).return_i32() == i32(912), "Expected 912 from ret_boxi32_i32");
};
export main;
