main :: (fn() -> unit) {
  // Test primitive type matching (integers)
  classify_number :: (fn(n: i32) -> i32)
    match(n,
      0 => 0,
      _ => 999
    )
  ;

  {
    result :: classify_number(0);
    assert(result == 0);
  };

  {
    result :: classify_number(-(1));
    assert(result == 999);
  };
};

export main;
