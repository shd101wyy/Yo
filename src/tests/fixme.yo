// @skip_prelude
// Simplified test case for Option.is_some
MyOpt :: (fn(compt(T) : Type) -> compt(Type))
  enum(
    None,
    Some(value: T),

    is_some :: (fn(self : Self) -> bool)(
      match(self,
        .Some(_) => true,
        .None => false
      )
    )
  )
;

main :: (fn() -> unit) {
  opt := MyOpt(i32).Some(42);
  opt.is_some();
};
export main;

