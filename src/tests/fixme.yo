open import "std/libc/stdio";
Async :: import "std/async";

main :: (fn() -> unit) {
  async {
    counter := Box(i32)(0);

    task := async {
      while runtime(true), {
        temp := Box(i32)(counter.*);
        await Async.yield();
        counter.* = (temp.* + 1);
        cond(
          (counter.* >= i32(3)) => { break; },
          true => ()
        );
      };
    };

    await task;
    assert(counter.* == i32(3), "counter should be 3 after break");
  };
};
export main;