open(import("std/fmt"));
open(import("std/string"));

main :: (fn() -> unit)({
  x := String.from("hello world");

  // String-typed argument (inherent methods, unchanged)
  assert(x.contains(String.from("world")), "contains String");
  assert(x.starts_with(String.from("hello")), "starts_with String");

  // str-typed argument (StrPattern trait overloads)
  assert(x.contains("world"), "contains str");
  assert(not(x.contains("worlds")), "contains str negative");
  assert(x.contains("o w", usize(3)), "contains str with from_index");
  assert(x.starts_with("hello"), "starts_with str");
  assert(not(x.starts_with("world")), "starts_with str negative");
  assert(x.ends_with("world"), "ends_with str");
  assert(not(x.ends_with("hello")), "ends_with str negative");
  assert(match(x.index_of("lo"),.Some(i) => (i == usize(3)),.None => false), "index_of str");
  assert(match(x.index_of("zz"),.Some(_) => false,.None => true), "index_of str none");
  assert(match(x.last_index_of("o"),.Some(i) => (i == usize(7)),.None => false), "last_index_of str");
  parts := x.split(" ");
  assert((parts.len() == usize(2)), "split str count");
  assert(match(parts.get(usize(0)),.Some(p) => (p == "hello"),.None => false), "split str first");
  assert(match(parts.get(usize(1)),.Some(p) => (p == "world"),.None => false), "split str second");

  println("all StrPattern assertions passed");
});

export(main);
