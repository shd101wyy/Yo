open import "std/libc/stdio";
{ GlobalAllocator } :: import "std/allocator";
{ malloc, free } :: GlobalAllocator;
open import "std/string";
{ platform, Platform, env } :: import "std/process";
dns :: import "std/io/dns";
tcp :: import "std/io/tcp";
{
  AF_INET, AF_INET6,
  SOCK_STREAM, SOCK_DGRAM
} :: import "std/io/socket";

main :: (fn() -> unit) {
  async {
    // =============================================
    // Test 1: Resolve "localhost" with getaddrinfo
    // =============================================
    printf("Test 1: Resolve localhost\n");
    result_ptr := dns.alloc_result();
    ret := await dns.getaddrinfo(*(u8)("localhost"), .None, .None, result_ptr);
    printf("  getaddrinfo ret = %d\n", ret);
    assert(ret == i32(0));

    first_ai := dns.get_result(result_ptr);
    match(first_ai,
      .Some(_) => { printf("  got result\n"); },
      .None => { printf("  no result!\n"); assert(false); }
    );

    // Walk the linked list, count results
    count := i32(0);
    cur := dns.get_result(result_ptr);
    while runtime(true), {
      match(cur,
        .Some(ai) => {
          family := dns.addrinfo_family(ai);
          addrlen := dns.addrinfo_addrlen(ai);
          printf("  result %d: family=%d addrlen=%u\n", count, family, addrlen);
          assert(((family == AF_INET) || (family == AF_INET6)));
          assert(addrlen > u32(0));
          count = (count + i32(1));
          cur = dns.addrinfo_next(ai);
        },
        .None => { break; }
      );
    };
    printf("  total results = %d\n", count);
    assert(count >= i32(1));

    match(dns.get_result(result_ptr),
      .Some(ai) => dns.freeaddrinfo(ai),
      .None => ()
    );
    dns.free_result(result_ptr);

    // =============================================
    // Test 2: Resolve "127.0.0.1" (numeric IP)
    // =============================================
    printf("Test 2: Resolve numeric IP 127.0.0.1\n");
    result_ptr2 := dns.alloc_result();
    ret2 := await dns.getaddrinfo(*(u8)("127.0.0.1"), .None, .None, result_ptr2);
    printf("  getaddrinfo ret = %d\n", ret2);
    assert(ret2 == i32(0));

    match(dns.get_result(result_ptr2),
      .Some(ai2) => {
        // Should be AF_INET for 127.0.0.1
        family2 := dns.addrinfo_family(ai2);
        printf("  family = %d (expect %d)\n", family2, AF_INET);
        assert(family2 == AF_INET);

        // The addrlen should be sizeof(sockaddr_in) = 16
        addrlen2 := dns.addrinfo_addrlen(ai2);
        printf("  addrlen = %u\n", addrlen2);
        assert(addrlen2 == u32(16));

        // The address should point to a valid sockaddr_in
        addr_ptr := dns.addrinfo_addr(ai2);
        resolved_family := tcp.get_family(addr_ptr);
        printf("  resolved family = %u\n", resolved_family);
        assert(resolved_family == u16(AF_INET));

        dns.freeaddrinfo(ai2);
      },
      .None => { printf("  no result!\n"); assert(false); }
    );
    dns.free_result(result_ptr2);

    // =============================================
    // Test 3: Resolve with service (port)
    // =============================================
    printf("Test 3: Resolve with service port\n");
    result_ptr3 := dns.alloc_result();
    ret3 := await dns.getaddrinfo(*(u8)("127.0.0.1"), .Some(*(u8)("80")), .None, result_ptr3);
    printf("  getaddrinfo ret = %d\n", ret3);
    assert(ret3 == i32(0));

    match(dns.get_result(result_ptr3),
      .Some(ai3) => {
        // Check the resolved address has port 80
        addr_ptr3 := dns.addrinfo_addr(ai3);
        port3 := tcp.get_port_in(addr_ptr3);
        printf("  resolved port = %u\n", port3);
        assert(port3 == u16(80));

        dns.freeaddrinfo(ai3);
      },
      .None => { printf("  no result!\n"); assert(false); }
    );
    dns.free_result(result_ptr3);

    // =============================================
    // Test 4: getnameinfo reverse lookup
    // =============================================
    printf("Test 4: getnameinfo reverse lookup\n");
    // Create a sockaddr_in for 127.0.0.1:0
    sa := tcp.make_sockaddr_in_loopback(u16(0));

    host_buf := *(u8)(malloc(usize(256)).unwrap());
    serv_buf := *(u8)(malloc(usize(64)).unwrap());

    // NI_NUMERICHOST = 1 on Linux
    ret4 := await dns.getnameinfo(sa.buf, sa.len, host_buf, usize(256), serv_buf, usize(64), i32(1));
    printf("  getnameinfo ret = %d\n", ret4);
    assert(ret4 == i32(0));

    // host_buf should contain "127.0.0.1" with NI_NUMERICHOST
    printf("  host = %s\n", host_buf);
    // Verify first char is '1' (0x31) for "127.0.0.1"
    assert(host_buf.* == u8(49));

    free(.Some(*(void)(host_buf)));
    free(.Some(*(void)(serv_buf)));
    tcp.free_sockaddr(sa);

    // =============================================
    // Test 5: Failed resolution (nonexistent host)
    // =============================================
    printf("Test 5: Failed resolution\n");
    result_ptr5 := dns.alloc_result();
    ret5 := await dns.getaddrinfo(*(u8)("this.host.definitely.does.not.exist.invalid"), .None, .None, result_ptr5);
    printf("  getaddrinfo ret = %d (should be negative)\n", ret5);
    // Should fail with some EAI_* error (negative)
    assert(ret5 < i32(0));

    dns.free_result(result_ptr5);

    // =============================================
    // Test 6: alloc_hints and addrinfo_size
    // =============================================
    printf("Test 6: alloc_hints and addrinfo_size\n");
    size := dns.addrinfo_size();
    printf("  addrinfo_size = %lu\n", size);
    assert(size > usize(0));

    hints := dns.alloc_hints();
    dns.free_hints(hints);

    printf("All DNS tests passed!\n");
  };
};
export main;