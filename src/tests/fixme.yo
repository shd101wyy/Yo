open import "std/string";
open import "std/fmt";
{ yield } :: import "std/async";
{ printf } :: import "std/libc/stdio";

Raise :: (fn(forall(T : Type), msg : String) -> T);

test_abort :: (fn(task : Impl(Future(i32, IO, Raise)), using(io : IO)) -> unit) {
  (given(raise) : Raise) =
    (msg) -> {
      println(msg);
      abort ();
    };
  io.await(task, using(io, raise));
};

main :: (fn(using(io : IO)) -> unit) {
  // I expect 'task' to have type Impl(Future(i32, IO, Raise))
  task := io.async((using(io : IO, raise : Raise)) => {
    raise(`This task should be aborted, not awaited!`);
    return i32(12);
  });
  test_abort(task);
  st := io.state(task);
  printf("Future state after starting task: %d\n", st);
  assert(st == FutureState.Aborted);

  (given(raise) : Raise) =
    (msg) -> {
      println(msg);
      abort ();
    };

  result := io.await(task); // FIXME: Should cause runtime panic on aborted task, but currently does not
  printf("Result of awaiting aborted task: %d\n", result);
};
export main;
