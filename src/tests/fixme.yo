open import "std/string";
open import "std/fmt";

Yield :: (fn(v : i32) -> i32);

Log :: (fn(v : i32) -> unit);

traverse :: (fn(
  forall(S : usize, ...(E)), 
  arr : Array(i32, S),
  callback : (Impl(Fn(v : i32, using(...(E))) -> unit)),
  using(...(E))
  ) -> unit) {
    i := usize(0);
    while i < S, i = (i + 1), {
      callback(arr(i));
    };
  };

main :: (fn() -> unit) {
  (given(yield) : Yield) =
    (v) -> {
      return v;
    };

  (given(log) : Log) =
    (v) -> {
      println(v);
    };

  arr := Array(i32, 5)(0, 1, 2, 3, 4);
  traverse(arr, (v, using(_yield, _log)) => {
    _log(v);
    result := _yield(v);
    assert((result == v), "yield should return the value");
  }, using(yield, log));
};
export main;


