open import "std/fmt";

Point :: struct(
  x : i32,
  y : i32
);
impl(Point, ToString(
  to_string : (self -> {
    comma := ", ";
    return (self.x.to_string() 
    + comma.to_string()
    + self.y.to_string()
    );
  })
));

main :: (fn() -> unit) {
  msg := "Hello, world!";
  println(msg);

  point := Point(3, 4);
  println(point);
};

export main;