open import "std/string";
open import "std/fmt";

Raise :: module(
  raise : (ctl(forall(T : Type), msg : String) -> T)
);

safe_divide :: (fn(x : i32, y : i32, using(raise_mod : Raise)) -> i32)(
  cond(
    (y == 0) => raise_mod.raise(`div-by-zero`),
    true => (x / y)
  )
);

main :: (fn() -> unit) {
  (given(raise_mod) : Raise) = Raise(
    raise :
      (msg) -> {
        println(msg);
        return i32(0);
      }
  );

  result := safe_divide(10, 0);
  assert((result == 0), "should be 0");
  result2 := safe_divide(10, 2);
  assert((result2 == 5), "should be 5");
  println("all good");
};
export main;