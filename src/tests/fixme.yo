open import "std/libc/stdio";
open import "std/string";
open import "std/fmt";
{ yield } :: import "std/async";

main ::
  (using(io : IO)) -> {
    Log :: (fn(msg : String) -> unit);

    task := io.async((using(io : IO, log : Log))=> {
      log(`effect injected`);
    });

    (given(log1) : Log) =
      (msg) -> {
        printf("Log1: %s\n", msg);
      };
    io.await(task, using(io, log1));
    printf("effect injection via await OK\n");
  };
