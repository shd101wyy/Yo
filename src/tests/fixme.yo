open(import("std/fmt"));
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
helper :: (fn(is_completion : bool, indent : String, xs : Option(ArrayList(usize))) -> unit)(
  match(
    xs,
    .Some(pending) => if(pending.len() > usize(0), {
      msg := indent.clone();
      msg.push_str(if(is_completion, "AAA", "Drop local variables before early return"));
      println(msg);
    }),
    .None => ()
  )
);
main :: (fn() -> unit)({
  al := ArrayList(usize).new();
  al.push(usize(1));
  helper(false, String.from("  "), Option(ArrayList(usize)).Some(al));
});
export(main);
