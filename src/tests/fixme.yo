add :: (fn(x : i32, y : i32)-> i32) {
  return (x + y);
};
compt_add :: compt_fn(add); // Convert `add` to a comptime function.
                            // Panic if fails to convert.  

main :: (fn() -> unit) {  
  op := Option(i32).Some(12);

  match(op,
    .Some(_) => {
      assert(true);
    },
    .None => {
      x :: compt_add(3, 4);
      compt_assert(x == 7); 

      assert(false, "Expected Some, got None");
    }
  );
  
  return ();
};

export main;
