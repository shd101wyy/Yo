// === Dyn TypeId test ===
open import "std/libc/stdio";
open import "std/string";
open import "std/fmt";

TypeId :: trait(
  (type_id : (fn(self: *(Self)) -> usize)) ?= ((self) -> typeid(Self))
);

Cat :: object(name : String);
impl(Cat, ToString(to_string : ((self) -> self.*.name)));
impl(Cat, TypeId());

Dog :: object(name : String);
impl(Dog, ToString(to_string : ((self) -> self.*.name)));
impl(Dog, TypeId());

main :: (fn() -> unit) {
  printf("=== TypeId trait test ===\n");

  cat := Cat(`kitty`);
  dog := Dog(`buddy`);

  cat_id := cat.type_id();
  dog_id := dog.type_id();

  printf("cat typeid: %zu\n", cat_id);
  printf("dog typeid: %zu\n", dog_id);
  printf("cat == cat: %d\n", cat_id == typeid(Cat));
  printf("dog == dog: %d\n", dog_id == typeid(Dog));
  printf("cat == dog: %d\n", cat_id == dog_id);

  printf("done\n");
};
export main;