open(import("std/string"));
open(import("std/fmt"));
{ Exception } :: import("std/error");
{ Evaluator } :: import("../../yo-self/evaluator/index.yo");
{ parse } :: import("../../yo-self/parser.yo");

main :: (fn(io : Io, exn : Exception) -> unit)({
  exprs := parse(String.from("a := 1 + 2;"), String.from("probe.yo"), exn);
  println(`exprs: ${exprs.len()}`);
});
export(main);
