// Test Arc(Channel) + Worker
{ printf } :: import "std/libc/stdio";
{ Channel } :: import "std/sync/channel";
{ WaitGroup } :: import "std/sync/waitgroup";
Worker :: import "std/worker";

main :: (fn() -> unit) {
  ch := arc(Channel(i32).new(usize(10)));
  wg := arc(WaitGroup.new());
  Worker.set_num_threads(2);

  wg.(*).add(i32(1));
  Worker.spawn(() => {
    ch.(*).send(i32(42));
    wg.(*).done();
  });

  wg.(*).wait();
  val := ch.(*).recv();
  assert(val.is_some(), "should receive value from worker");
  assert((val.unwrap() == i32(42)), "value should be 42");
  printf("Done\n");
};

export main;
