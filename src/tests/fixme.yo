open import "std/collections/array_list";

Path :: object(
  _segments: ArrayList(Box(i32)),

  new :: (fn(path_str: Box(i32)) -> Self)({
    segments := ArrayList(Box(i32)).new();

    cond(
      (path_str.* == 1) => {
        return Self(_segments: segments);
      },
      true => ()
    );

    return Self(_segments: segments);
  })
);

main :: (fn() -> unit) {  
  Path.new(box(1));
  Path.new(box(2));
};

export main;
