Val :: ref(enum(UnitVal, IntVal(v : i32)));
mk :: (fn() -> Result(Option(Val), i32))(.Ok(Option(Val).Some(Val.IntVal(v : i32(7)))));
// BARE `___ := ...` as the WHOLE fn body — the trigger (mirrors
// yo-self/evaluator/types/field.yo register_struct_fields).
reg :: (fn() -> unit)(
  ___ := mk()
);
main :: (fn() -> unit)({
  reg();
});
export(main);
