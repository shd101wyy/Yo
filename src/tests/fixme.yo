open import "std/string";
open import "std/fmt";

Raise :: (ctl(forall(T : Type), msg : String) -> T);
Log :: (ctl(msg : String, counter : Box(i32)) -> unit);

main :: (fn() -> unit) {
  log_count := box(i32(0));

  (given(log) : Log) = ((msg, counter) -> {
    println(msg);
    counter.* = (counter.* + i32(1));
    return ();
  });

  (given(raise) : Raise) = ((msg) -> {
    println(msg);
    return i32(42);
  });

  log(`first log`, log_count);
  log(`second log`, log_count);
  result := raise(`error!`);

  assert((log_count.* == i32(2)), "log_count should be 2");
  assert((result == i32(42)), "result should be 42");
  println(`All nested effects tests passed!`);
};
export main;