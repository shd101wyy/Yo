// Minimal repro: == comparison in ref(self) method with while(runtime(true))

MyObj :: object(x : usize);
impl(MyObj,
  test_eq : (fn(ref(self : Self)) -> usize)({
    i := usize(0);
    while(runtime(true), {
      i = (i + usize(1));
      curr := i;
      if((curr == usize(3)), {
        return(usize(42));
      });
    });
    usize(0)
  }),
);

main :: (fn() -> unit)({
  o := MyObj(x : usize(0));
  r := o.test_eq();
  assert((r == usize(42)), "eq failed");
});
export(main);
