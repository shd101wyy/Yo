{ yield } :: import "std/async";

main :: (fn(using(io : IO)) -> unit)({
  task := io.async((using(io : IO)) => {
    a := i32(10);
    io.await(yield());
    b := (a + i32(5));
    io.await(yield());
    c := i32(20);
    io.await(yield());
    return (b + c);
  });
  r := io.await(task);
});
export main;
