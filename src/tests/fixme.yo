pragma(Pragma.AllowUnsafe);
open(import("std/libc/stdio.yo"));
Gc :: import("std/gc");
ENode :: ref(
  enum(
    ENil,
    ECons(value : i32, next : Self)
  )
);
form_cycle :: (fn() -> unit)({
  a := ENode.ECons(1, ENode.ENil);
  b := ENode.ECons(2, ENode.ENil);
  a.next = b; // overwrites a's ENil terminator
  b.next = a; // overwrites b's ENil terminator; a<->b cycle
});
main :: (fn() -> unit)({
  before := Gc.tracked_count();
  form_cycle();
  mid := Gc.tracked_count();
  Gc.collect();
  after := Gc.tracked_count();
  unsafe(printf("before=%llu mid=%llu after=%llu\n", before, mid, after));
});
export(main);
