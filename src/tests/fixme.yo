// @skip_prelude
assert :: (fn(flag : bool, (compt(msg) : compt_string) ?= "Assertion failed.") -> unit)
  cond(
    flag => (),
    true => panic(msg)
  )
;

main :: (fn() -> unit) {
  classify_sign :: (fn(n: bool) -> bool)
    match(n,
      true => true,
      _ => false
    )
  ;
