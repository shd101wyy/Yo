open import "std/libc/stdio";
{ GlobalAllocator } :: import "std/allocator";
{ malloc, free } :: GlobalAllocator;
open import "std/string";
{ platform, Platform, env } :: import "std/process";
perm :: import "std/io/perm";
file :: import "std/io/file";
dir :: import "std/io/dir";
{
  AT_FDCWD, O_WRONLY, O_CREAT, O_TRUNC, O_RDONLY,
  F_OK, R_OK, W_OK, X_OK,
  S_IRUSR, S_IWUSR, S_IXUSR, S_IRGRP, S_IROTH
} :: import "std/io/constants";

main :: (fn() -> unit) {
  async {
    // =============================================
    // Test 1: access F_OK on existing file
    // =============================================
    printf("Test 1: access F_OK on existing file\n");
    test_path := *(u8)("/tmp/yo_perm_test.txt");

    // Create a test file first
    write_flags := ((O_WRONLY | O_CREAT) | O_TRUNC);
    fd := await file.openat(AT_FDCWD, test_path, write_flags, i32(0o644));
    printf("  created file fd = %d\n", fd);
    assert(fd >= i32(0));
    data := *(u8)("perm test data");
    wr := await file.write(fd, data, u32(14), u64(0));
    assert(wr == i32(14));
    cr := await file.close(fd);
    assert(cr == i32(0));

    // Check file exists
    ret1 := await perm.access(AT_FDCWD, test_path, F_OK);
    printf("  access F_OK ret = %d\n", ret1);
    assert(ret1 == i32(0));

    // Check readable
    ret1r := await perm.access(AT_FDCWD, test_path, R_OK);
    printf("  access R_OK ret = %d\n", ret1r);
    assert(ret1r == i32(0));

    // Check writable
    ret1w := await perm.access(AT_FDCWD, test_path, W_OK);
    printf("  access W_OK ret = %d\n", ret1w);
    assert(ret1w == i32(0));

    printf("  PASSED\n");

    // =============================================
    // Test 2: access on nonexistent file
    // =============================================
    printf("Test 2: access on nonexistent file\n");
    ret2 := await perm.access(AT_FDCWD, *(u8)("/tmp/yo_perm_nonexistent_file_12345.txt"), F_OK);
    printf("  access F_OK ret = %d (expect -ENOENT)\n", ret2);
    // ENOENT = 2, so -ENOENT = -2
    assert(ret2 == i32(-2));
    printf("  PASSED\n");

    // =============================================
    // Test 3: chmodat changes permissions
    // =============================================
    printf("Test 3: chmodat changes permissions\n");

    // chmod to read-only (0o444)
    ret3 := await perm.chmodat(AT_FDCWD, test_path, u32(0o444), i32(0));
    printf("  chmodat to 0444 ret = %d\n", ret3);
    assert(ret3 == i32(0));

    // Check: should be readable but not writable
    ret3r := await perm.access(AT_FDCWD, test_path, R_OK);
    printf("  access R_OK after chmod 0444 = %d\n", ret3r);
    assert(ret3r == i32(0));

    // Note: root can still write to read-only files, so only check if not root
    // We'll restore permissions regardless
    ret3w := await perm.access(AT_FDCWD, test_path, W_OK);
    printf("  access W_OK after chmod 0444 = %d (non-root expects -EACCES)\n", ret3w);

    // Restore to 0644
    ret3b := await perm.chmodat(AT_FDCWD, test_path, u32(0o644), i32(0));
    printf("  chmodat restore to 0644 ret = %d\n", ret3b);
    assert(ret3b == i32(0));

    printf("  PASSED\n");

    // =============================================
    // Test 4: fchmod by fd
    // =============================================
    printf("Test 4: fchmod by fd\n");
    fd4 := await file.openat(AT_FDCWD, test_path, O_RDONLY, i32(0));
    printf("  open fd = %d\n", fd4);
    assert(fd4 >= i32(0));

    // chmod via fd to 0o755 (rwxr-xr-x)
    ret4 := await perm.fchmod(fd4, u32(0o755));
    printf("  fchmod to 0755 ret = %d\n", ret4);
    assert(ret4 == i32(0));

    // Verify executable bit set
    ret4x := await perm.access(AT_FDCWD, test_path, X_OK);
    printf("  access X_OK after fchmod 0755 = %d\n", ret4x);
    assert(ret4x == i32(0));

    // Restore to 0644
    ret4b := await perm.fchmod(fd4, u32(0o644));
    assert(ret4b == i32(0));

    cr4 := await file.close(fd4);
    assert(cr4 == i32(0));

    printf("  PASSED\n");

    // =============================================
    // Test 5: chmodat on nonexistent file
    // =============================================
    printf("Test 5: chmodat on nonexistent file\n");
    ret5 := await perm.chmodat(AT_FDCWD, *(u8)("/tmp/yo_perm_nonexistent_12345.txt"), u32(0o644), i32(0));
    printf("  chmodat ret = %d (expect -ENOENT)\n", ret5);
    assert(ret5 == i32(-2));
    printf("  PASSED\n");

    // =============================================
    // Test 6: fchown by fd (change to same user)
    // =============================================
    printf("Test 6: fchown by fd\n");
    fd6 := await file.openat(AT_FDCWD, test_path, O_RDONLY, i32(0));
    assert(fd6 >= i32(0));

    // chown to -1, -1 (no change) should succeed
    ret6 := await perm.fchown(fd6, u32(4294967295), u32(4294967295));
    printf("  fchown(-1, -1) ret = %d\n", ret6);
    assert(ret6 == i32(0));

    cr6 := await file.close(fd6);
    assert(cr6 == i32(0));
    printf("  PASSED\n");

    // =============================================
    // Cleanup
    // =============================================
    printf("Cleaning up test file\n");
    cleanup := await dir.unlink(AT_FDCWD, test_path, i32(0));
    printf("  unlink ret = %d\n", cleanup);

    printf("All permission tests passed!\n");
  };
};
export main;