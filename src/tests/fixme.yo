// @skip_prelude
Comptime :: trait(
  id := "Comptime"
);
Runtime :: trait(
  id := "Runtime"
);
impl(forall(T : Type), where(T <: Comptime), *(T), Comptime());
impl(forall(T : Type), where(T <: Runtime), *(T), Runtime());

Hash :: trait(
  /**
    * Compute the hash of a value
    * Returns a u64 hash value
    */
  (hash): (fn(self : *(Self)) -> u64)
);

Box :: (fn(comptime(V) : Type) -> comptime(Type))
  object(
    (v) : V
  )
;
impl(forall(T : Type),
       where(T <: Hash),
       Box(T),
       Hash(
         (hash) : ((self) -> (self.*).v.hash())
       )
);