pragma(Pragma.AllowUnsafe);
open(import("std/libc/stdio"));

AliasWrap :: ref(struct(b : Box(i32)));

alias_poke_loop :: (fn(w : AliasWrap, borrowed : Box(i32)) -> unit)({
  (i : i32) = i32(0);
  while(runtime(i < i32(2)), {
    w.b = box(i32(100) + i);
    i = (i + i32(1));
  });
  unsafe(printf("  in-callee borrowed=%d (want 42)\n", borrowed.*));
});

main :: (fn() -> unit)({
  w := AliasWrap(b : box(i32(42)));
  b0 := w.b;
  unsafe(printf("rc before call=%d (want 2)\n", i32(rc(b0))));
  alias_poke_loop(w, w.b);
  unsafe(printf("rc after call=%d\n", i32(rc(b0))));
  unsafe(printf("value after call=%d (want 42)\n", b0.*));
});

export(main);
