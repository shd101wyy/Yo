import "std/fmt/to_string";

add :: (fn(x : i32, y : i32) -> i32) {
  return x + y;
};

main :: (fn() -> unit) {
  // ((1).to_string() + (3 + 4).to_string()); // < Works
  // ((1 + 2).to_string() + (3).to_string()); // < Works
  ((1 + 2).to_string() + (3 + 4).to_string()); // Doesn't work
};

export(main);
