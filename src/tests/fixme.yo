arr :: [i32(0), i32(1), i32(2), i32(3), i32(4)];
s :: arr(1:4); // Slice of arr from index 1 to 3
s(0) = 10; // Modify first element of slice
s(2) = 30; // Modify last element of slice
compt_assert(arr(0) == i32(0));
compt_assert(arr(1) == i32(10));
compt_assert(arr(2) == i32(2));
compt_assert(arr(3) == i32(30));
compt_assert(arr(4) == i32(4));

s2 :: s(0:2); // Slice of slice s from index 0 to 1
s2(1) = 20; // Modify second element of slice s2
compt_assert(arr(1) == i32(10));
compt_assert(arr(2) == i32(20));
compt_assert(arr(3) == i32(30));