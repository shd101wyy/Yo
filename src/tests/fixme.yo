open import "std/fmt";
open import "std/collections/array_list";

test_return_in_match :: (fn() -> unit)({
  (list : ArrayList(u8)) = ArrayList(u8).new();
  list.push(u8(42));
  (ptr : *(u8)) = match(list._ptr,
    .Some(p) => p,
    .None => { return (); }
  );
  assert((ptr.* == u8(42)), "ptr value should be 42");
  println("test_return_in_match passed");
});

main :: (fn() -> unit)({
  test_return_in_match();
});

export main;
