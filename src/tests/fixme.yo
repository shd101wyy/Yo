// === Dyn TypeId test ===
open import "std/libc/stdio";
open import "std/string";
open import "std/fmt";

Speak :: trait(
  speak : (fn(self: *(Self)) -> String),
  where(Self <: ToString)
);

Cat :: object(name : String);
impl(Cat, ToString(to_string : ((self) -> self.*.name)));
impl(Cat, Speak(speak : ((self) -> `meow`)));

Dog :: object(name : String);
impl(Dog, ToString(to_string : ((self) -> self.*.name)));
impl(Dog, Speak(speak : ((self) -> `woof`)));

main :: (fn() -> unit) {
  printf("=== Dyn TypeId test ===\n");

  cat_id := typeid(Cat);
  dog_id := typeid(Dog);
  cat_id2 := typeid(Cat);

  printf("cat typeid: %zu\n", cat_id);
  printf("dog typeid: %zu\n", dog_id);
  printf("cat typeid again: %zu\n", cat_id2);
  printf("cat == cat: %d\n", cat_id == cat_id2);
  printf("cat == dog: %d\n", cat_id == dog_id);

  printf("done\n");
};
export main;