open import "std/string"; // Let's use `String` instead of `str`

Raise :: (ctl(forall(T : Type), msg : String) -> T);

// Use an effect in a function (effect becomes an implicit parameter)
safe_divide :: (fn(x : i32, y : i32, using(raise : Raise)) -> i32)(
  cond(
    (y == 0) => raise(`div-by-zero`),
    true => (x / y)
  )
);

// Handle the effect — without resume (discarding continuation)
raise_const :: (fn() -> i64) {
  (given(raise) : Raise) = ((msg) -> // values/anonymous-function.ts
    i64(42)
  );
  (i64(8) + i64(safe_divide(1, 0))) + i64(10)
};
// Returns 42 — continuation is discarded

// Handle the effect — with resume (invoking continuation)
raise_resume :: (fn() -> i64) {
  (given(raise) : Raise) = (ctl(forall(T : Type), msg : String) -> T)( // calls/function-type.ts
    resume(i32(42)) // `resume` is implicitly generated
                    // question: Should it have type Impl(Fn(result : i32) -> i64)
                    // where `i64` matches `raise_resume` return type.  
                    // where `result : i32` matches the return type of `ctl(msg : String) -> i32`
  );
  (i64(8) + i64(safe_divide(1, 0))) + i64(10)
};
// Returns 60 — resume(42) continues after the raise call site

main :: (fn() -> unit) {
  result1 := raise_const();
  result2 := raise_resume();

  assert(result1 == i64(42));
  assert(result2 == i64(60));
};
export main;