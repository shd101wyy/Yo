open import "std/string"; // Let's use `String` instead of `str`
open import "std/fmt";

Raise :: (ctl(forall(T : Type), msg : String, msg2 : String) -> T);

main :: (fn() -> unit) {
  (given(raise) : Raise) = ((msg, msg2) -> {
    println(msg);
    println(msg2);
    // Define raise2 inside raise's handler body
    (given(raise2) : Raise) = ((m1, m2) -> {
      println(m1);
      println(m2);
      return f32(3.14); 
    });
    raise2_result := raise2(`inner msg1`, `inner msg2`);
    assert(raise2_result == f32(3.14), "raise2 should return 3.14");
    return i32(16); // This return value will be the result of the outer raise call
  });
  result := raise(`outer msg1`, `outer msg2`);
  assert(result == 16, "This assertion should not be reached");
};
export main;