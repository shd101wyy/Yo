open import "std/fmt";
open import "std/string";
open import "std/collections/array_list";

// Test: begin block in cond where last expr is ptr deref of RC type
test_begin_block_ptr_deref :: (fn() -> unit)({
  (list : ArrayList(String)) = ArrayList(String).new();
  list.push(`hello`);
  list.push(`world`);
  (idx : i32) = i32(0);
  (result : String) = cond(
    (idx >= i32(0)) => {
      (sp : *(String)) = &(list(usize(idx)));
      sp.*
    },
    true => `fallback`
  );
  assert((result == `hello`), "should be hello");
  println("test_begin_block_ptr_deref passed");
});

main :: (fn() -> unit)({
  test_begin_block_ptr_deref();
});

export main;
