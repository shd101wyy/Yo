pragma(Pragma.AllowUnsafe);
open(import("std/libc/stdio"));

W :: ref(struct(b : Box(i32)));

p2_decr_field :: (fn(w : W, borrowed : Box(i32)) -> i32)({
  __yo_decr_rc(w.b);
  borrowed.*
});

main :: (fn() -> unit)({
  unsafe(printf("start\n"));
  w1 := W(b : box(i32(42)));
  unsafe(printf("rc before=%d\n", i32(rc(w1.b))));
  v := p2_decr_field(w1, w1.b);
  unsafe(printf("p2=%d (want 42)\n", v));
});

export(main);
