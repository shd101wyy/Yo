open import "std/string"; // Let's use `String` instead of `str`
open import "std/fmt";

Raise :: (ctl(forall(T : Type), msg : String, msg2 : String) -> T);

main :: (fn() -> unit) {
 (given(raise) : Raise) = ((msg, msg2) -> {// values/anonymous-function.ts
    println(msg);
    println(msg2);
    return i32(16);
  });
  result := raise(`fixme`, `This is a fixme test`); // This should trigger the effect handler above, printing the messages and aborting the program
  println("This line should be printed");
  assert(result == 16, "This assertion should be true");
};
export main;