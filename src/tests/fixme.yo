main :: (fn() -> unit) {
  add :: impl {
    add1 :: (fn(x : i32) -> i32) x;
    add2 :: (fn(x : i32, y : i32) -> i32) (x + y);
    add3 :: (fn(x : i32, y : i32, z : i32) -> i32) ((x + y) + z);
    add4 :: (fn(x : i32, y : i32, z : i32, w : i32) -> i32) (((x + y) + z) + w);
    
    Call :: (add1, add2, add3); // Allow calling the module like a function
    export Call;
  };
  
  assert(add(2, 3) == 5);
};
export main;