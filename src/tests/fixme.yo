open import "std/fmt";

// Test TypeInfo primitive
info1 :: Type.get_info(i32);
comptime_assert(info1.is_primitive(), "i32 should be primitive");
comptime_assert(info1.is_integer(), "i32 should be integer");

// Test TypeInfo struct
Point :: struct(x : i32, y : i32);
info2 :: Type.get_info(Point);
comptime_assert(info2.is_struct(), "Point should be struct");

main :: (fn() -> unit)({
  println(`TypeInfo tests done`);
});
export main;
