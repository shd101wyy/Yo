open import "std/libc/stdio";
unix :: import "std/io/unix";
dir :: import "std/io/dir";
{ AT_FDCWD } :: import "std/io/constants";

main :: (fn() -> unit) {
  async {
    sock_path := *(u8)("/tmp/yo_unix_bind_test");

    // Best-effort cleanup
    await dir.unlink(AT_FDCWD, sock_path, i32(0));

    server_fd := await unix.socket_stream();
    printf("server fd = %d\n", server_fd);
    assert((server_fd >= i32(0)), "socket_stream failed");

    addr := unix.make_sockaddr_un(sock_path);
    printf("addr.len = %u\n", addr.len);

    addr_buf := match(addr.buf,
      .Some(p) => p,
      .None => {
        printf("sockaddr_un not supported\n");
        await unix.close(server_fd);
        return;
      }
    );

    printf("addr_buf ptr = %p\n", addr_buf);

    bind_result := await unix.bind(server_fd, addr_buf, addr.len);
    printf("bind result = %d\n", bind_result);
    assert((bind_result == i32(0)), "bind failed");

    // cleanup
    c1 := await unix.close(server_fd);
    printf("close = %d\n", c1);

    await dir.unlink(AT_FDCWD, sock_path, i32(0));

    unix.free_addr(addr);
    printf("DONE\n");
  };
};

export main;