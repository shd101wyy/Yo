//! Repro: yo-self/tests/assignment.test.yo "evaluate_assignment: atom LHS"
//! SIGABRTs (pre-existing before v4.1; same signal at v4 phase 5).
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../../yo-self/token.yo");
{ AstExpr, ast_expr_id, BK_ASSIGN } :: import("../../yo-self/expr.yo");
{ new_expr_info, expr_info_table_set, expr_info_table_get } :: import("../../yo-self/expr_info.yo");
{ Environment, add_variable_to_env } :: import("../../yo-self/env.yo");
{ EvalContext, eval_context_new } :: import("../../yo-self/evaluator/context.yo");
{ EvalValue } :: import("../../yo-self/value.yo");
{ t_bool } :: import("../../yo-self/types/creators.yo");
{ set_evaluate_expression_fn } :: import("../../yo-self/evaluator/exprs/expr.yo");
{ evaluate_assignment } :: import("../../yo-self/evaluator/exprs/assignment.yo");
{ Exception } :: import("std/error");

mk_token :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);
mk_ident :: (fn(id : usize, name : str) -> AstExpr)(
  AstExpr.Atom(id, mk_token(TokenKind.Identifier, name))
);
mk_op_atom :: (fn(id : usize, op : str) -> AstExpr)(
  AstExpr.Atom(id, mk_token(TokenKind.Operator, op))
);
mk_op_call :: (fn(id : usize, op : str, args : ArrayList(AstExpr)) -> AstExpr)({
  callee := mk_op_atom(id + usize(10000), op);
  AstExpr.FnCall(id, box(callee), args, true, mk_token(TokenKind.Operator, op))
});
mk_assign :: (fn(id : usize, lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  mk_op_call(id, BK_ASSIGN, args)
});
stub_eval_bool :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext
  ) -> AstExpr
)({
  info := new_expr_info(env, t_bool());
  info.value =.Some(EvalValue.BoolVal(true));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
main :: (fn() -> unit)({
  set_evaluate_expression_fn(stub_eval_bool);
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  ctx := eval_context_new(String.from("/std"), String.from("test"));
  (env : Environment) = Environment.new(String.from("test"));
  env.push_frame(false);
  tok := mk_token(TokenKind.Identifier, "x");
  _v := add_variable_to_env(
    env,
    String.from("x"),
    t_bool(),
    Option(EvalValue).None,
    false,
    true,
    false,
    false,
    tok
  );
  lhs := mk_ident(usize(1), "x");
  rhs := mk_ident(usize(2), "true");
  expr := mk_assign(usize(10), lhs, rhs);
  result := evaluate_assignment(expr, env, ctx, exn);
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(result));
  assert(match(info_opt,.Some(_) => true,.None => false), "ExprInfo should be set on assignment expr");
  println("done");
});
export(main);
