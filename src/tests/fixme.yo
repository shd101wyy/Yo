main :: (fn() -> unit) {
  x := Box(i32)(99);
  isolated := ^(x);

  match(isolated,
    .Some(iso_val) => {
      opt := iso_val.extract();
      e := opt.unwrap();
      v := e.*;
      assert(v == 99, "Expected 99");
    },
    .None => {
      assert(false, "Expected Some, got None");
    }
  );
};

export main;