{ printf } :: import "std/libc/stdio";

Optimize :: enum(
  Debug,
  ReleaseSafe,
  ReleaseFast,
  ReleaseSmall
);

Config :: struct(
  name : comptime_string,
  (optimize : Optimize) ?= Optimize.Debug
);

register :: (fn(comptime(config) : Config) -> unit) {
  opt_str := match(config.optimize,
    .Debug => "debug",
    .ReleaseSafe => "release-safe",
    .ReleaseFast => "release-fast",
    .ReleaseSmall => "release-small"
  );
  printf("name=%s optimize=%s\n", config.name, opt_str);
};

register(Config(name: "test1"));
register(Config(name: "test2", optimize: Optimize.ReleaseFast));

main :: (fn() -> unit) {
  printf("main\n");
};
export main;
