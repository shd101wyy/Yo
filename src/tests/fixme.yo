main :: (fn(using(io : IO)) -> unit) {
  // Basic implicit parameter resolution
  {
    add_numbers :: (fn(
      x : i32,
      y : i32,
      using(add_fn : (fn(a : i32, b : i32) -> i32))
    ) -> i32)(
      add_fn(x, y)
    );

    given(my_add) := (fn(a : i32, b : i32) -> i32)(a + b);

    // Implicit resolution: finds my_add via given lookup
    result := add_numbers(3, 4);
    assert(result == 7, "implicit resolution failed");
  };

  // Explicit using(...) at call site
  {
    add_numbers :: (fn(
      x : i32,
      y : i32,
      using(add_fn : (fn(a : i32, b : i32) -> i32))
    ) -> i32)(
      add_fn(x, y)
    );

    my_adder :: (fn(a : i32, b : i32) -> i32)(a + b);

    // Explicit using: passes value directly
    result := add_numbers(5, 6, using(my_adder));
    assert(result == 11, "explicit using failed");
  };

  // using(undefined) skips explicit and falls back to given lookup
  {
    add_numbers :: (fn(
      x : i32,
      y : i32,
      using(add_fn : (fn(a : i32, b : i32) -> i32))
    ) -> i32)(
      add_fn(x, y)
    );

    given(my_add) := (fn(a : i32, b : i32) -> i32)(a + b);

    result := add_numbers(7, 8, using(undefined));
    assert(result == 15, "using(undefined) should fall back to given lookup");
  };

  // given with : binding
  {
    apply :: (fn(
      x : i32,
      using(transform : (fn(v : i32) -> i32))
    ) -> i32)(
      transform(x)
    );

    (given(my_transform) : (fn(v : i32) -> i32)) =
      (v) -> (v * 3)
    ;

    result := apply(10);
    assert(result == 30, "given with : binding failed");
  };

  // Multiple implicit parameters with distinct types
  {
    compute :: (fn(
      x : i32,
      using(add_fn : (fn(a : i32, b : i32) -> i32),
            to_bool : (fn(a : i32) -> bool))
    ) -> bool)(
      to_bool(add_fn(x, 1))
    );

    given(my_add) := (fn(a : i32, b : i32) -> i32)(a + b);
    given(my_is_positive) := (fn(a : i32) -> bool)(a > 0);

    result := compute(5);
    assert(result == true, "multiple implicit params failed");
  };

  // Explicit using with multiple implicit params
  {
    compute :: (fn(
      x : i32,
      using(add_fn : (fn(a : i32, b : i32) -> i32),
            negate : (fn(a : i32) -> i32))
    ) -> i32)(
      negate(add_fn(x, 10))
    );

    my_add :: (fn(a : i32, b : i32) -> i32)(a + b);
    my_neg :: (fn(a : i32) -> i32)(i32(0) - a);

    result := compute(5, using(my_add, my_neg));
    assert(result == (i32(0) - 15), "explicit using with multiple params failed");
  };

  // using(undefined) for partial skip with multiple implicit params
  {
    compute :: (fn(
      x : i32,
      using(add_fn : (fn(a : i32, b : i32) -> i32),
            scale : (fn(a : i32) -> i32))
    ) -> i32)(
      scale(add_fn(x, 1))
    );

    given(my_add) := (fn(a : i32, b : i32) -> i32)(a + b);
    my_double :: (fn(a : i32) -> i32)(a * 2);

    // First implicit param skipped (uses given lookup), second explicit
    result := compute(4, using(undefined, my_double));
    assert(result == 10, "partial using(undefined) failed");
  };

  // Ambiguous implicit should error
  {
    apply :: (fn(
      x : i32,
      using(op : (fn(a : i32) -> i32))
    ) -> i32)(
      op(x)
    );

    given(double_it) := (fn(a : i32) -> i32)(a * 2);
    given(triple_it) := (fn(a : i32) -> i32)(a * 3);

    comptime_expect_error(apply(5)); // Ambiguous: two given variables with same type
  };

  // No matching given should error
  {
    apply :: (fn(
      x : i32,
      using(op : (fn(a : i32) -> bool))
    ) -> bool)(
      op(x)
    );

    given(my_add) := (fn(a : i32, b : i32) -> i32)(a + b);

    comptime_expect_error(apply(5)); // No given with type (fn(i32) -> bool)
  };

  // Implicit with generic function (forall + using)
  {
    apply :: (fn(
      forall(T : Type),
      x : T,
      using(op : (fn(a : T) -> T))
    ) -> T)(
      op(x)
    );

    given(inc) := (fn(a : i32) -> i32)(a + 1);
    result := apply(41);
    assert(result == 42, "forall + using failed");
  };
};

export main;
