// Variadic extern arg-count probe (module level — errors not swallowed).
// Pre-fix: "Argument count mismatch: expected 2 arguments, got 4".
pragma(Pragma.AllowUnsafe);
extern(
  "C",
  zvar_probe : (fn(zfmt : *(char), zn : usize, ...) -> int)
);
zr := unsafe(zvar_probe(*(char)("x"), usize(0), u8(1), u8(2)));
main :: (fn() -> unit)(());
export(main);
