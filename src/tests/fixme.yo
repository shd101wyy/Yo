// @skip_prelude
MyOption :: (fn(compt(T) : Type) -> compt(Type))(
  enum(
    None,
    Some(value: T),

    unwrap :: impl {
      _unwrap :: (fn(self : Self) -> T)(
        match(self,
          .Some(value) => value,
          .None => panic("Called unwrap on a None value")
        )
      );
      _compt_unwrap :: (fn(compt(self) : Self) -> compt(T))(
        match(self,
          .Some(value) => value,
          .None => compt_assert(false, "Called unwrap on a None value at comptime")
        )
      );

      Call :: (_unwrap, _compt_unwrap);
      export Call;
    }
  )
);

op2 :: MyOption(bool).Some(true);
val2 :: op2.unwrap();
compt_print(val2);
compt_assert(val2, "val2 should be true");