open import "std/libc/stdio";
open import "std/string";
{ temp_dir, path_join } :: import "../../tests/io/helper";
file :: import "std/io/file";
dir :: import "std/io/dir";
{ AT_FDCWD } :: import "std/io/constants";
temp_io :: import "std/io/temp";
mmap_io :: import "std/io/mmap";

main :: (fn() -> unit) {
  async {
    tmp := temp_dir();
    template_str := path_join(tmp, `yo_io_mmap_XXXXXX`);
    template_c := template_str.to_cstr();
    template_path := template_c.ptr().unwrap();

    fd := temp_io.mkstemp(template_path);
    printf("fd = %d\n", fd);
    assert((fd >= i32(0)), "mkstemp should return a valid fd");

    trunc := await file.ftruncate(fd, i64(4096));
    printf("trunc = %d\n", trunc);
    assert((trunc == i32(0)), "ftruncate to 4096 should succeed");

    mapped := mmap_io.mmap(
      .None,
      usize(4096),
      (mmap_io.PROT_READ | mmap_io.PROT_WRITE),
      mmap_io.MAP_SHARED,
      fd,
      i64(0)
    );

    assert((!mmap_io.is_error(mapped)), "file-backed shared mmap should succeed");
    ptr := mapped.unwrap();
    printf("mapped ptr ok\n");

    (ptr &+ usize(0)).* = u8(90);
    (ptr &+ usize(1)).* = u8(89);
    printf("wrote bytes\n");

    sync_ret := mmap_io.msync(ptr, usize(4096), mmap_io.MS_SYNC);
    printf("msync = %d\n", sync_ret);
    assert((sync_ret == i32(0)), "msync(MS_SYNC) should succeed");

    unmap_ret := mmap_io.munmap(ptr, usize(4096));
    printf("munmap = %d\n", unmap_ret);
    assert((unmap_ret == i32(0)), "munmap for file-backed mapping should succeed");

    printf("about to read...\n");
    read_buf_uninit := MaybeUninit(Array(u8, usize(2))).new();
    read_buf := *(u8)(read_buf_uninit.as_ptr());
    rd := await file.read(fd, read_buf, u32(2), u64(0));
    printf("read = %d\n", rd);
    assert((rd == i32(2)), "reading first 2 bytes after msync should return 2");
    assert(((read_buf &+ usize(0)).* == u8(90)), "persisted byte 0 should be 90");
    assert(((read_buf &+ usize(1)).* == u8(89)), "persisted byte 1 should be 89");

    close_ret := await file.close(fd);
    printf("close = %d\n", close_ret);

    rm := await dir.unlink(AT_FDCWD, template_path, i32(0));
    printf("unlink = %d\n", rm);
    printf("done\n");
  };
};
export main;