open import "std/string";
open import "std/fmt";

Raise :: (fn(forall(T : Type), msg : String) -> T);

main :: (fn() -> unit) {
  safe_divide :: (fn(x : i32, y : i32, using(raise : Raise)) -> i32)(
    cond(
      (y == 0) => raise(`division by zero`),
      true => (x / y)
    )
  );

  compute :: (fn(a : i32, b : i32, using(raise : Raise)) -> i32)(
    (safe_divide(a, b) + i32(10))
  );

  (given(raise) : Raise) = ((msg) -> {
    println(msg);
    abort ();
  });
  b := Box(i32)(12);
  result := compute(50, 0);
  assert(false, "Expected to abort");
};
export main;