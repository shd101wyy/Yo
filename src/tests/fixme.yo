open(import("std/string"));
open(import("std/fmt"));
{ Exception, IoExn } :: import("std/error");
{ yield } :: import("std/async");

ready :: (fn(io : Io) -> Impl(Future(bool, Io)))(
  io.async((io : Io) => {
    io.await(yield(io), io);
    return(true);
  })
);
num :: (fn(io : Io) -> Impl(Future(i32, Io)))(
  io.async((io : Io) => {
    io.await(yield(io), io);
    return(i32(7));
  })
);

do_it :: (fn(io : Io, exn : Exception) -> Impl(Future(unit, IoExn)))(
  io.async((e) => {
    cond(e.io.await(ready(e.io), e.io) => { println(String.from("y")); }, true => ());
  })
);

main :: (fn(io : Io, exn : Exception) -> unit)({
  io.await(do_it(io, exn), IoExn(io : io, exn : exn));
  println(String.from("END"));
});

export(main);
