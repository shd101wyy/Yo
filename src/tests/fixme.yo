{ println } :: import("std/fmt");
{ Exception, AnyError } :: import("std/error");
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");

/// Returns an RC-typed value. The throwing arm's result is CONSUMED by the
/// return value, so its drop is deferred to `consumedVarPendingDrops` — and the
/// escape path used to drop that never-assigned temp.
get_list :: (fn(flag : bool, exn : Exception) -> ArrayList(i32))(
  cond(
    flag => {
      l := ArrayList(i32).new();
      l.push(7);
      l
    },
    true => exn.throw(dyn(String.from("boom")))
  )
);

main :: (fn() -> unit)({
  exn := Exception(
    throw : (
      (err) -> {
        unwind(());
      }
    )
  );
  ok := get_list(true, exn);
  println(`ok len = ${ok.len()}`);
  bad := get_list(false, exn);
  println(`unreachable: ${bad.len()}`);
});

export(main);
