// Minimal repro: self.method() generates (*self) for ref-counted object
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array_list");

Foo :: object(
  tokens : ArrayList(usize)
);

impl(
  Foo,
  new : (fn() -> Self)(Foo(tokens : ArrayList(usize).new())),
  helper : (fn(self : Self) -> unit)(()),
  call_helper : (fn(self : Self) -> unit)(self.helper()),
);

main :: (fn() -> unit)({
  f := Foo.new();
  f.call_helper();
});
export(main);
