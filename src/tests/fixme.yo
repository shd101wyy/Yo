// Minimal repro for issues/codegen-forall-resume-handler-stub.md:
// forall ctl-handler stub emits `__yo_effect_escaped = 1; return zero;`
// even when the source body is `return(resume_val)` (resume, not unwind).

MyException :: (fn(comptime(ErrorType) : Type) -> comptime(Type))(
  struct(
    throw : (ctl(forall(ResumeType : Type), error : ErrorType, resume_value : ResumeType) -> ResumeType)
  )
);

safe_op :: (fn(x : i32, exn : MyException(i32)) -> i32)(
  cond(
    (x < 0) => exn.throw(x, i32(0)),
    true => x
  )
);

find_first_positive :: (fn() -> i32)({
  counter := Box(i32)(0);
  exn := MyException(i32)(
    throw : (
      (val, resume_val) -> {
        return(resume_val);
      }
    )
  );
  while(runtime(counter.* < i32(10)), {
    result := safe_op(counter.* - i32(3), exn);
    counter.* = (counter.* + 1);
    cond(
      (result > i32(0)) => {
        return(result);
      },
      true => ()
    );
  });
  return(i32(-(1)));
});

main :: (fn() -> unit)({
  result := find_first_positive();
  // counter: 0→-3→0, 1→-2→0, 2→-1→0, 3→0, 4→1>0 → return 1
  assert(result == i32(1), "should find 1 after resume");
});
export(main);
