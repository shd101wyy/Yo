// Shared-eval hermeticity pin, file Z — mirror of a_hermetic.test.yo with
// the same method name but different behavior and its own private helper.
{ assert } :: import("std/assert");
{ z_bump } :: import("./z_helper.yo");
impl(
  i32,
  hermetic_probe : (fn(self : Self) -> i32)({
    return(self + i32(2));
  })
);
(g_counter_z : i32) = i32(20);
test("hermetic impl and module state (Z)", {
  assert(i32(40).hermetic_probe() == i32(42));
  assert(z_bump() == i32(101));
  g_counter_z = (g_counter_z + i32(1));
  assert(g_counter_z == i32(21));
});
