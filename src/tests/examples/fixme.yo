open import "std";
{ printf } :: import "std/libc/stdio";

sum :: ((max : i32) -> i32) {
  mut(result) := 0;
  mut(i) := 0.as(i32);
  while i < max, i = (i + 1), {
    result = (result + i);
  };

  return result;
};

main :: (() -> i32) {
  result := sum(10);
  printf("Sum of first 10 numbers is: %d\n", result);
  return 0;
};

export main;