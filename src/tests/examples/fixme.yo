Id :: module(
  where(Self <: Copy),
  id : (fn(x : Self) -> Self)
);

Data :: (fn(compt(T) : Type) -> compt(Type)) {
  return struct(value : T);
};
impl(i32, Copy());
impl(boolean, Copy());


impl(forall(T : Type), where(T <: Copy), Data(T), Copy());
compt_assert(__yo_type_impls(Data(i32), Copy));
compt_assert(__yo_type_impls(Data(boolean), Copy));

impl(forall(T : Type), where(T <: Copy), *(T), Copy());
compt_assert(__yo_type_impls(*(i32), Copy));
compt_assert(__yo_type_impls(*(boolean), Copy));

impl(forall(T : Type, Size : usize), where(T <: Copy), Array(T, Size), Copy());
compt_assert(__yo_type_impls(Array(i32, 1), Copy));
compt_assert(__yo_type_impls(Array(boolean, 2), Copy));
compt_assert(__yo_type_impls(Array(Data(i32), 5), Copy));
compt_assert(__yo_type_impls(Array(*(boolean), 10), Copy));

test :: (fn() -> unit) {
  return ();
};