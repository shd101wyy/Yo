open import "std";

KeyValuePair :: (fn(compt(K) : Type, compt(V) : Type) -> compt(Type))
  struct(
    key : K,
    value : V
  );

ArrayList :: (fn(compt(T): Type) -> compt(Type))
  object(
    ptr : ?*(T),

    _some_func :: ((fn(self : Self) -> boolean)
      T.contains_arc_type()
    ),

    push :: (fn(self: Self, value: T) -> Result(unit, unit))
      match(self.ptr,
        .Some(p) => .Ok(()),
        .None => .Error(())
      )
  );

main :: (fn() -> unit) {  
  X :: ArrayList(KeyValuePair(i32, i32));  
  return;
};

export main;
