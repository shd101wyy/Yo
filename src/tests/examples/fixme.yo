Id :: (fn(compt(Output) : Type)-> compt(Module))
  module
    This     :  Type,
    Output   := Output,
    (id)     :  (fn(self: Self.This)-> Self.Output)
;

Point :: struct(
  x : i32,
  y : i32,

  Id :: { 
    This :: Self, 
    Id(This)(
      This : This,
      id : ((self) -> self)
    )
  }
);