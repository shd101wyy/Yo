open import "std";
open import "../../../std/libc/stdio.yo";

Speak :: module(
  Self: Type,
  speak : (fn(self : Self) -> i32)
);

Run :: module(
  Self: Type,
  run : (fn(self : Self) -> i32)
);

// Dog :: struct(); // This should give error working with `dyn`.
Dog :: ref struct();

DogSpeak :: Speak
  Self : Dog,
  speak : ((self : Self) -> {
    printf("Woof!\n");
    return 1;
  })
;

DogRun :: Run
  Self : Dog,
  run : ((self : Self) -> {
    printf("The dog is running!\n");
    return 2;
  })
;

act :: (fn(s : Dyn(Speak, Run)) -> i32)
  s.speak() + s.run()
;


main :: ((fn() -> i32) {
  dog := Dog();
  result := act(dyn(dog, (DogSpeak, DogRun)));
  return result;
});

export main;
