some_condition :: (fn() -> bool) true;

main :: (fn() -> unit) {
  compt_expect_error({
    arr : Array(i32, _);
    cond(
      some_condition() => {
        arr = [1, 2, 3];
      },
      true => {
        arr = [2, 3, 4];
      }
    );
    arr(0) = 5;
  });

  arr := cond(
    some_condition() => [1, 2, 3],
    // true => {
    //   x := [1, 2, 3];
    //   x
    // },
    true => [1, 2, 3]
  );
};

export main;