open import "../../../std/libc/stdio.yo";

Speak :: module(
  Self: Type,
  speak : (fn(self : Self) -> i32)
);

// Dog :: struct(); // This should give error working with `dyn`.
Dog :: ref struct();

DogSpeak :: Speak
  Self : Dog,
  speak : ((self : Self) -> {
    printf("Woof!\n");
    return 1;
  })
;

speak :: (fn(s : Dyn(Speak)) -> i32)
  s.speak()
;


main :: ((fn() -> i32) {
  dog := Dog();
  result := speak(dyn(dog, DogSpeak));
  return result;
});

export main;
