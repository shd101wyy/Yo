main :: (fn() -> unit) {
  worker := Worker(i32, boolean).spawn_local((child) -> {
    printf("Spawned workder at %u\n", Thread.get_thread_id());
  });
  printf("Main thread id: %u\n", Thread.get_thread_id());
};

export main;