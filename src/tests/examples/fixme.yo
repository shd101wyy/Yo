  add :
    (x : i32, y : i32) -> i32,
  sub :
    (x : i32, y : i32) -> i32,
  mul :
    (x : i32, y : i32) -> i32,
  div :
    (x : i32, y : i32) -> i32,
  eq  :
    (x : i32, y : i32) -> boolean,
  gt  :
