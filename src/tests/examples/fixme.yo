open import "std";
open import "std/libc/stdio.yo";

main :: (fn() -> unit) {
  ch := chan(i32);
  
  async {
    // arr := Array(i32, 1024).fill(0);
    ch <- 666;
  }, { stack_size : (1024 * 64) }; // 64KB stack
  
  result := <-(ch);
  value := result.unwrap();
  printf("value=%d\n", value);
};

export main;
