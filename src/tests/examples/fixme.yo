*/

Functor :: (fn() -> compt(Module))
  module(
    map :
      fn(
        forall(A : Type),
        f : (fn(a : A) => A)
      ) -> A
   )
;

extern "Yo",
  __yo_eff_map :
    fn(
      forall(A1 : Type),
      f : (fn(a : A1) => A1)
    ) -> A1
;

SomeFunctor :: Functor()
  map :
    ((f) ->
      __yo_eff_map(f))
;