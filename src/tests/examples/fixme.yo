extern "C",
  add :
    (x : i32, y : i32) -> i32,
  sub :
    (x : i32, y : i32) -> i32,
  mul :
    (x : i32, y : i32) -> i32,
  div :
    (x : i32, y : i32) -> i32,
  eq  :
    (x : i32, y : i32) -> boolean,
  gt  :
    (x : i32, y : i32) -> boolean,
  ge  :
    (x : i32, y : i32) -> boolean
;

Shape :: enum
  Circle(radius : i32),
  Square(side : i32),
  Rectangle(width : i32, height : i32)
;

area :: ((shape : Shape) -> i32) {
  result :=
    match(shape,
      .Circle => mul(mul(3, shape.radius), shape.radius),
      .Square => mul(shape.side, shape.side),
      .Rectangle => mul(shape.width,shape.height)
    )
  ;
  
  add(result, 0) // do nothing here basically
};

main :: (() -> i32) {
  c := Shape.Circle(3);
  s := Shape.Square(side : 5);
  r1 := Shape.Rectangle(4, 6);
  r2 := Shape.Rectangle(height : 8, width: 10);
  area(r1)
};

// `export` here is required. Otherwise no functions will be compiled.
export
  main;
