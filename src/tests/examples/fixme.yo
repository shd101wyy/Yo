use_id :: ((  x : i32,
              id : 
                (x : i32) -> i32
            ) -> i32)
  id(x)
;

result := use_id(42, fn(x) -> x);

{
  // I also want to get this to work.
  // some_anonymous_fn should be lazy evaluated when used.
  some_anonymous_fn ::
    fn(x) -> x
  ;

  result := use_id(42, some_anonymous_fn);
};