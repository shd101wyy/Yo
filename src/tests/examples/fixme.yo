// with => to define a closure that captures the `move` from outer scope
open import "std";

(compt(LinearI32) : Linear) = i32;

// FnOnce, FnMut, Fn can only be used in a Closure context
// They cannot be used as standalone types
// This should be invalid - standalone FnOnce
compt_expect_error(
  invalid_fn_once :: (FnOnce(val: i32) -> i32)
);

// This should be invalid - standalone FnMut  
compt_expect_error(
  invalid_fn_mut :: (FnMut(val: i32) -> i32)
);

// This should be invalid - standalone Fn
compt_expect_error(
  invalid_fn :: (Fn(val: i32) -> i32)
);


plus_fn_once ::
  ((forall(compt(F) : Type),
    callback : Closure(F, FnOnce(elem : i32) -> i32)
  ) -> i32) {
  return callback(42); // callback can only be called once
};

plus_fn_mut ::
  ((forall(compt(F) : Type),
    mut(callback) : Closure(F, FnMut(elem : i32) -> i32)
  ) -> i32) {
  callback(42);
  return callback(42); // callback can be called multiple times, but must be mutable
};

plus_fn ::
  ((forall(compt(F) : Type),
    callback : Closure(F, Fn(elem : i32) -> i32)
  ) -> i32) {
  callback(42);
  return callback(42); // callback can be called multiple times, but cannot mutate captured variables
};

test1 :: (() -> unit) {
  mut(counter) := 0;
  (x : LinearI32) = 12;
  plus_fn_once(fn(elem)=> {
    y := x; // `x` should be consumed here
    counter = (counter + elem);
    return counter;
  });
  compt_expect_error(z := x, "x should be already consumed when defining the closure");
  return (); // Let's explicit return unit value () here
};

test2 :: (() -> unit) {
  mut(counter) := 0;
  plus_fn_mut(fn(elem)=>> {
    counter = (counter + elem);
    return counter;
  });
  return ();
};

test3 :: (() -> unit) {
  counter := 0;
  plus_fn(fn(elem)=>> {
    // Cannot mutate captured variables in Fn closure
    // So we just return the sum without modifying counter
    return counter + elem;
  });
  return ();
};

// Test that should fail: Fn closure trying to mutate captured variable
compt_expect_error(
  test_fn_mutation_error :: (() -> unit) {
    mut(counter) := 0;
    plus_fn(fn(elem)=>> {
      counter = (counter + elem); // This should fail - Fn cannot mutate
      return counter;
    });
    return ();
  }
);


test4 :: (() -> unit) {
  mut(counter) := 0;
  closure : (Closure(_, FnOnce(elem : i32) -> i32));
  closure = (fn(elem) => {
    counter = (counter + elem);
    return counter;
  });
};

test4_1 :: (() -> unit) {
  mut(counter) := 0;
  closure := the(
    Closure(_, FnOnce(elem : i32) -> i32),
    fn(elem) => {
      counter = (counter + elem);
      return counter;
    });
};


test5 :: (() -> unit) {
  mut(counter) := 0;
  mut(closure) : (Closure(_, FnOnce(elem : i32) -> i32));
  closure = (fn(elem) => {
    counter = (counter + elem);
    return counter;
  });
  
  // This should fail - trying to assign closure with different capture type
  compt_expect_error(
    {
      mut(different_var) := 42;
      closure = (fn(elem) => {
        different_var = (different_var + elem);
        return different_var;
      });
    }
  );
};


some_condition :: (() -> boolean) true;

test6 :: (() -> unit) {
  mut(counter1) := 0;
  mut(counter2) := 0;
  
  // This should fail because the two branches create closures with different capture types
  compt_expect_error(
    {
      mut(closure) : (Closure(_, FnOnce(elem : i32) -> i32));
      cond(
        some_condition() => {
          closure = (fn(elem) => {
            counter1 = (counter1 + elem);
            return counter1;
          });
        },
        true => {
          closure = (fn(elem) => {
            counter2 = (counter2 + elem);
            return counter2;
          });
        }
      );
    }
  );
};


test7 :: (() -> unit) {
  mut(counter) := 0;
  
  // This should fail because the two branches create closures with different nominal capture types
  // Even though both capture the same variable, each creates a new StructType with different identity
  compt_expect_error(
    {
      mut(closure) : (Closure(_, FnMut(elem : i32) -> i32));
      
      cond(
        some_condition() => {
          closure = (fn(elem) =>> {
            counter = (counter + elem);
            return counter;
          });
        },
        true => {
          closure = (fn(elem) =>> {
            counter = (counter * elem);
            return counter;
          });
        }
      );
    }
  );
};
