open import "std/libc/stdio.yo";

test1 :: (fn() -> unit) {
  x := 1;

  ClosureType :: Impl(Fn(y : i32) -> i32);
  T :: Type.to_string(ClosureType);
  closure := (ClosureType {
    x = (x + y);
    return x;
  });

  closure(1); // 2
  closure(1); // 3

  result := closure(2); // 5
  printf("Final result: %d\n", result);
};

test2 :: (fn() -> unit) {
  x := 1;

  (closure : Impl(Fn(y : i32) -> i32)) = ((y) => {
    x = (x + y);
    return x;
  });

  closure(1); // 2
  closure(1); // 3

  result := closure(2); // 5
  printf("Final result: %d\n", result);
};

test3 :: (fn() -> unit) {
  x := 1;

  (closure : Dyn(Fn(y : i32) -> i32)) = ((y) => {
    x = (x + y);
    return x;
  });

  closure(1); // 2
  closure(1); // 3

  result := closure(2); // 5
  printf("Final result: %d\n", result);
};


main :: (fn() -> unit) {
  test1();
  test2();
  test3();
};

export main;
