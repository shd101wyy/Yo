open import "std";
{ printf } :: import "std/libc/stdio";


K :: (fn(compt(Value) : Type) -> compt(Type)) {
  ClosureType ::
    fn(value : Value) => unit;
  return ClosureType;
};

// Algebraic effects
Yield ::
  fn( i : i32, resume : K(i32)) -> unit;

some_cond :: (fn() -> boolean) true;

(compt(given(yield)) : Yield) =
  (i, resume) ->
    cond
      (i < 0) => resume(0),
      true => resume(i)
;

main :: (fn( resume : K(i32)) -> unit) {
  result :=
    cond(
      some_cond() => do(yield(0)),
      (do(yield(-4)) < 0) => do(yield(-2)),
      true => do(yield(2))
    );
  printf("Result: %d\n", result);
  resume(result);
};

