Point :: ref struct
  x : i32,
  y : i32
;

// extern "yo",
//   use_point: (fn(p : Point) -> unit),
//   use_point_ref: (fn(p : &(Point)) -> unit)
// ;
// make_point :: (fn() -> Point) Point(1, 2);


// __dup function that:
// - ref struct/enum: increments ref count
// - type containing ref struct/enum: recursively dup all ref struct/enum fields
// - other types: no-op
// - __dup will be automatically trigger when variable is assigned to another variable or passed by value to function

// __drop function that:
// - ref struct/enum: decrements ref count, and if ref count reaches zero, call drop()
// - type containing ref struct/enum: recursively __drop all ref struct/enum fields, then call drop() if defined, other no-op
// - other types: call drop() if defined, otherwise no-op
// - __drop will automatically trigger when variable goes out of scope

// drop function: the real destructor function for the type
// - only available for reference-semantics types, like `ref struct/enum`
// .drop() cannot be called manually, only called by/inside __drop when ref count reaches zero

test1 :: (fn() -> i32) {
  p := Point(3, 4); // temp_var (Object A) created from Point(3, 4), p points to Object A
  // dup(temp_var)    (Object A)

  // drop(p);         (Object A)
  // drop(temp_var);   (Object A)

  // Object A: referenced by temp_var, p (2 references)
  return 0;

  // Scope end cleanup:
  // Object A: emit 1 dup, 2 drop, so 2 - 1 = 1 drop needed
  // Total: 1 drop operation needed
};

