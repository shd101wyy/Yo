// A type that does NOT implement Copy - should be allowed to implement Gc
NonCopyType :: object(value: i32); // does NOT derive Copy
compt_assert(Type.impls(NonCopyType, Copy) == false);
compt_assert(Type.impls(NonCopyType, Send) == true);
compt_assert(Type.impls(NonCopyType, Gc) == true);

// A type that DOES implement Copy - should NOT be allowed to implement Gc
CopyableType :: struct(value: i32); // auto-derive Copy
compt_assert(Type.impls(CopyableType, Copy) == true);
compt_assert(Type.impls(CopyableType, Send) == true); 
compt_assert(Type.impls(CopyableType, Gc) == false);

// This SHOULD fail because CopyableType implements Copy
compt_expect_error(
  impl(CopyableType, Gc())
);


Compound :: struct(value : NonCopyType);
compt_assert(Type.impls(Compound, Copy) == false);
compt_assert(Type.impls(Compound, Send) == true);
compt_assert(Type.impls(Compound, Gc) == true);
