open import "std";
open import "std/libc/stdio.yo";

extern "Yo",
  __yo_chan_send :
    fn(forall(T: Type), ch : Chan(T), value : T) -> unit,
  __yo_chan_recv :
    fn(forall(T: Type), ch : Chan(T)) -> Option(T),
  __yo_chan_close :
    fn(forall(T: Type), ch : Chan(T)) -> unit
;

main :: (fn() -> i32) {
  ch := chan(i32, 2); // buffered channel with capacity 2

  __yo_chan_send(ch, 1); // doesn't block
  __yo_chan_send(ch, 2); // doesn't block

  v1 := __yo_chan_recv(ch).unwrap(); // receives 1
  printf("%d\n", v1);
  printf("%d\n", __yo_chan_recv(ch).unwrap()); // receives 2

  return 0;
};

/*

main :: (fn() -> i32) {
  ch := chan(i32); // unbuffered channel
  spawn ((fn(ch : chan(i32))-> unit){
    __yo_chan_send(ch, 42); // blocks until the value is received
  })(ch);

  printf("%d\n", __yo_chan_recv(ch).unwrap()); // blocks until a value is sent
};
*/

export main;
