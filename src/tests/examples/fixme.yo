
open import "std/libc/stdio.yo";

main :: ((fn() -> unit) {
  x := Box(i32)(3);
  y := (x,);
  z := (y,);
  m := (z,);
  n := (m,);

  z.0 = (box(10),);

  assert(x.* == 3, "x.* == 3");
  assert(y.0.* == 3, "y.0.* == 3");
  assert(z.0.0.* == 10, "z.0.0.* == 10");
  assert(m.0.0.0.* == 3, "m.0.0.0.* == 3");
  assert(n.0.0.0.0.* == 3, "n.0.0.0.0.* == 3");
});

export main;
