open import "std/io/file";
open import "std/string";

main :: (fn() -> unit) {
  // Test async read of file bytes
  (path : *(u8)) = "tests/fixtures/test_file.txt";
  result := File.open(path, O_RDONLY);
  match(result,
    .Ok(file) => {
      async {
        read_result := await file.read_bytes_async();
        file.close();
        
        match(read_result,
          .Ok(bytes) => {
            // test_file.txt has "Hello from Yo async I/O!\nThis is a test file.\n"
            assert((bytes.len() > usize(0)), "Should read some bytes");
          },
          .Err(e) => {
            assert(false, "Should read successfully");
          }
        );
      };
    },
    .Err(e) => {
      assert(false, "File should open successfully");
    }
  );
};

