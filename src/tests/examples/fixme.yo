open import "std/libc/stdio";
{ gc_collect } :: import "std/gc";

MyBox :: object(
  (*) : i32,

  dispose :: ((fn(self : Self)-> unit) {
    printf("Disposing MyBox with value: %d\n", self.(*));
  })
);

main :: (fn() -> unit) {
  x := MyBox(42);
  printf("MyBox value: %d\n", x.(*));

  gc_collect();
};

export main;