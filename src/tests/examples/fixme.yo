test3 :: (fn() -> unit) {
  x := 1;

  (closure : Dyn(Fn(y : i32) -> i32)) = ((y) => {
    x = (x + y);
    return x;
  });

  closure(1); // 2
  closure(1); // 3

  result := closure(2); // 5
  printf("Final result: %d\n", result);
};


main :: (fn() -> unit) {
