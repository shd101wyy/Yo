open import "std";
{ printf } :: import "std/libc/stdio";

// Algebraic effects
Yield ::
  eff( i : i32 ) -> boolean;

traverse ::
  (fn(forall(compt(length): usize),
      arr : Array(i32, length),
      using(yield : Yield)
      ) -> unit) {
  mut(i) := 0.as(usize);
  while i < length,
    cond
      yield(arr(i)) => {
        i = (i + 1.as(usize));
      },
      true => ()
  ;
};

print_elems :: (fn() -> unit) {
  (given(yield) : Yield) =
    (i)-> {
      printf("yielded %d", i);
      resume(i <= 2);
    };
  traverse(List(1, 2, 3, 4), using(yield));
};