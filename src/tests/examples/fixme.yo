open import "std";
open import "std/libc/stdio.yo";

/*
say :: (fn(s : *(u8), val: i32, ch: Chan(i32)) -> i32) {
  printf("%s\n", s);
  ch.send(val);
  printf("thread %u sent %i\n", thread_id(), val);
  return val;
};
*/

test1 :: (fn()-> unit) {
  printf("begin test1\n");
  Concurrency.yield();
  printf("middle test1\n");
  Concurrency.yield();
  printf("end test1\n");
};

test2 :: (fn()-> unit) {
  printf("begin test2\n");
  Concurrency.yield();
  printf("middle test2\n");
  Concurrency.yield();
  printf("end test2\n");
};

// Pointer arithmetic example
main :: (fn() -> i32) {
  Concurrency.set_maximum_threads(1); // Set maximum 1 thread for "go" tasks

  printf("start main\n");
  test1();
  go test2();
  printf("end main\n");

  Concurrency.wait_all(); // is now called automatically on main exit!

  // Expected to print:
  // start main
  // begin test1
  // middle test1
  // end test1
  // end main
  // begin test2
  // middle test2
  // end test2



  /*
  ch := chan(i32); // unbuffered channel

  // say("world") and say("hello") should run on the same thread
  go say("world", 16, ch);
  go say("hello", 18, ch);

  t1_result := ch.recv().unwrap();
  printf("thread %u received %d\n", thread_id(), t1_result);
  // It should print
  // "thread ? sent 16"

  t2_result := ch.recv().unwrap();
  printf("thread %u received %d\n", thread_id(), t2_result);
  // It should print
  // "thread ? sent 18"

  result := (t1_result + t2_result);
  printf("result: %d\n", result);
  */

  /*
  ch := chan(i32, 2); // buffered channel with capacity 2

  printf("before send\n");
  ch.send(1); // doesn't block
  ch.send(2); // doesn't block

  printf("before recv\n");
  v1 := ch.recv().unwrap(); // receives 1
  printf("%d\n", v1);
  printf("%d\n", ch.recv().unwrap()); // receives 2
  */

  return 0;
};

export main;
