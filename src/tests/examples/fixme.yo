// Test: Work-stealing scheduler with various workload patterns

open import "std/libc/stdio.yo";
Gc :: import "std/gc";
{ ArrayList } :: import "std/collections/array_list.yo";

// Simple atomic counter using raw C atomic_int
AtomicCounter :: object(
  value: i32
);

extern "C",
  __atomic_fetch_add:
    (fn(ptr: *(i32), val: i32, memorder: i32) -> i32),
  __atomic_load_n:
    (fn(ptr: *(i32), memorder: i32) -> i32),
  __atomic_store_n:
    (fn(ptr: *(i32), val: i32, memorder: i32) -> unit);

// Memory order constants for atomic operations
ATOMIC_SEQ_CST :: 5;

atomic_counter_new :: (fn() -> AtomicCounter)
  AtomicCounter(value: 0)
;

atomic_counter_increment :: (fn(self: AtomicCounter) -> unit) {
  __atomic_fetch_add(&(self.value), 1, ATOMIC_SEQ_CST);
};

atomic_counter_get :: (fn(self: AtomicCounter) -> i32)
  __atomic_load_n(&(self.value), ATOMIC_SEQ_CST)
;

// Test 1: Many small tasks (stress test for work-stealing)
test_many_small_tasks :: (fn() -> Future(unit))
  async {
    printf("Test 1: Many small tasks\n");
    
    counter := atomic_counter_new();
    
    // Create 1000 tasks that each increment the counter
    tasks := ArrayList(Future(unit)).new();
    i := 0;
    while runtval(true),
      cond(
        ((i < 1000) => {
          future := async {
            atomic_counter_increment(counter);
          };
          tasks.push(future);
          i = (i + 1);
        }),
        true => break
      )
    ;
    
    // Wait for all tasks
    i = 0;
    while(runtval(true),
      cond(
        ((i < 1000) => {
          task_opt := tasks.get(i.as(usize));
          match(task_opt,
            .Some(task) => { await task; },
            .None => ()
          );
          i = (i + 1);
        }),
        true => break
      ));
    
    final_count := atomic_counter_get(counter);
    cond(
      (final_count == 1000) => {
        printf("  ✓ All 1000 tasks executed\n");
      },
      true => {
        printf("  ✗ Expected 1000, got %d\n", final_count);
      }
    );
  }
;

main :: (fn() -> unit) {
  async {
    printf("=== Work-Stealing Scheduler Tests ===\n");
    printf("\n");
    
    await test_many_small_tasks();

    printf("\n");
    printf("=== All tests complete ===\n");
  };
};

export main;
