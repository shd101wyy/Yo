// with => to define a closure that captures the `move` from outer scope
open import "std";

Callback ::
  FnOnce(elem: i32) -> i32
;

(compt(LinearI32) : Linear) = i32;

test1 :: (() -> unit) {
  mut(x) := 1;
  cb := Callback {
    return x + elem;
  };
  result := cb(42); // cb can only be called once.
  compt_expect_error(cb(42), "Closure can only be called once");
};

test2 :: (() -> unit) {
  (x : LinearI32) = 12;
  cb := Callback { // We moved the `x` into the closure
    y := x; // `x` should be consumed here
    return elem;
  };
  compt_expect_error(
    z := x,
    "x should be already consumed when defining cb"
  ); // should give error as `x` is already consumed when defining cb.
};

test3 :: (() -> unit) {
  mut(x) := 1;
  (cb : Callback) =
    fn(elem) => {
      return x + elem;
    }
  ;
  result := cb(42); // cb can only be called once.
  compt_expect_error(cb(42), "Closure can only be called once");
};

// FnMut closure examples - can be called multiple times and mutate captured variables
MutCallback ::
  FnMut(elem: i32) -> i32
;

test4 :: (() -> unit) {
  mut(counter) := 0;
  cb := MutCallback {
    counter = (counter + 1);
    return (counter + elem);
  };
  result1 := cb(10); // First call: counter becomes 1, returns 1 + 10 = 11
  result2 := cb(20); // Second call: counter becomes 2, returns 2 + 20 = 22
  result3 := cb(30); // Third call: counter becomes 3, returns 3 + 30 = 33
  // FnMut can be called multiple times unlike FnOnce
};

test5 :: (() -> unit) {
  mut(sum) := 0;
  (accumulator : MutCallback) =
    fn(elem) =>> {
      sum = (sum + elem);
      return sum;
    }
  ;
  result1 := accumulator(5);  // sum becomes 5, returns 5
  result2 := accumulator(10); // sum becomes 15, returns 15
  result3 := accumulator(3);  // sum becomes 18, returns 18
};

test6 :: (() -> unit) {
  mut(values) := [0, 0, 0]; // Array to store values
  mut(index) := 0.as(usize);
  
  (store_callback : MutCallback) =
    fn(elem) =>> {
      values(index) = elem;
      index = (index + 1.as(usize));
      return elem;
    }
  ;
  
  store_callback(42);
  store_callback(84);
  store_callback(126);
  // values should now be [42, 84, 126]
};

// Fn closure examples - can be called multiple times without mutating captured variables
ReadCallback ::
  Fn(elem: i32) -> i32
;

test7 :: (() -> unit) {
  base := 100;
  cb := ReadCallback {
    return base + elem; // Only reads from captured variables, no mutation
  };
  result1 := cb(1);  // Returns 101
  result2 := cb(5);  // Returns 105
  result3 := cb(10); // Returns 110
  // Fn can be called multiple times and doesn't mutate captured variables
};

test8 :: (() -> unit) {
  multiplier := 3;
  (calculator : ReadCallback) =
    fn(elem) =>> {
      return multiplier * elem; // Only reads multiplier, doesn't modify it
    }
  ;
  result1 := calculator(4);  // Returns 12
  result2 := calculator(7);  // Returns 21
  result3 := calculator(10); // Returns 30
};

test9 :: (() -> unit) {
  constant := 42;
  values := [1, 2, 3, 4, 5];
  
  (add_constant : ReadCallback) =
    fn(elem) =>> {
      return constant + elem; // Reads from both constant and elem
    }
  ;
  
  // Can call the Fn closure multiple times
  result1 := add_constant(values(0.as(usize))); // 42 + 1 = 43
  result2 := add_constant(values(1.as(usize))); // 42 + 2 = 44
  result3 := add_constant(values(2.as(usize))); // 42 + 3 = 45
};

// Test that FnMut cannot consume linear values from outer scope
test10 :: (() -> unit) {
  (x : LinearI32) = 12;
  cb := MutCallback { // FnMut should not be able to consume x
    compt_expect_error(y := x); // This should give an error - FnMut cannot consume linear values from outer scope
    return elem;
  };
  cb(42);
};

// Test that Fn cannot consume linear values from outer scope  
test11 :: (() -> unit) {
  (x : LinearI32) = 12;
  (cb : ReadCallback) =
    fn(elem) =>> { // Fn should not be able to consume x
      compt_expect_error(y := x); // This should give an error - Fn cannot consume linear values from outer scope
      return elem;
    }
  ;
  cb(42);
  cb(42);
};

// Test that Fn closures cannot modify outer scope variables
test_fn_cannot_modify :: (() -> unit) {
  mut(counter) := 0;
  (readonly_fn : ReadCallback) =
    fn(elem) =>> {
      compt_expect_error(
        counter = (counter + 1)
      ); // This should give an error for Fn closure
      return elem;
    };
};