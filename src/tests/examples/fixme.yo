open import "std/libc/stdio.yo";

/*
Box :: ref struct
  (*) : i32,
  
  dispose :: ((fn(self : Self)-> unit) {
    printf("Disposing Box with value %d\n", self.*);
  })
;

Option :: enum
  Some(value: Box),
  None
;
*/

Option :: (fn(compt(T) : Type) -> compt(Type))
  enum
    Some(value: T),
    None
;

List :: ref struct
  value : i32,
  next : Option(Self),
  
  dispose :: ((fn(self : Self)-> unit) {
    printf("Disposing List with value %d\n", self.value);
  })
;

main :: (fn() -> i32) {
  a := List(3, .None);
  b := List(5, .None);

  a.next = .Some(b);
  b.next = .Some(a); // Create a cycle

  return 0;
};

export main;