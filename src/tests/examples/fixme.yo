extern "C",
  add :
    (x : i32, y : i32) -> i32,
  gt  :
    (x : i32, y : i32) -> boolean
;

max :: ((x : i32, y : i32) -> i32) {
  result :=
    cond
      gt(x, y) => x,
      true     => y
  ;
  result // return result
};

main :: (() -> i32) {
  x := 15;
  y := 13;
  z := add(x, y);
  m := max(x, y);
  m
};

// `export` here is required. Otherwise no functions will be compiled.
export
  main;
