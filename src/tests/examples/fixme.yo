open import "std/libc/stdio";

MyBox :: object(
  (*) : i32,

  dispose :: ((fn(self : Self)-> unit) {
    printf("Disposing Boxed i32 with value: %d\n", self.*);
  })
);

main :: (fn() -> unit) {
  {
    x := MyBox(1);
    (closure : Dyn(Fn(y : i32) -> i32)) = dyn(box (y) => {
      x.* = (x.* + y);
      return x.*;
    });
  };
  /*
  // `dyn` without `box`
  {
    x := MyBox(1);
    (closure : Dyn(Fn(y : i32) -> i32)) = dyn((y) => {
      x.* = (x.* + y);
      return x.*;
    });
  };
  */
};

export main;