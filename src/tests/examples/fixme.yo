open import "std/libc/stdio";
Gc :: import "std/gc";

MyBox :: object(
  (*) : i32,

  dispose :: ((fn(self : Self)-> unit) {
    printf("Disposing MyBox with value: %d\n", self.(*));
  })
);

test_x :: (fn() -> unit) {
  x := MyBox(42);
  printf("x value: %d\n", x.(*));
};

test_y :: (fn() -> unit) {
  y := { box : MyBox(66) };

  Gc.collect(); // Expected `x` to be collected here.

  printf("y.box value: %d\n", y.box.(*));
};

main :: (fn() -> unit) {
  test_x();
  test_y();

  Gc.collect();
  Gc.print_stats();
};

export main;