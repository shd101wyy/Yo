Id :: module(
  id : (fn(self : Self) -> Self)
);

use_id :: (fn(
  value : Dyn(Id)
) -> unit) {
  value.id();
};

impl(Box(i32), Id(
  id : ((self) -> {
    printf("Boxed i32 value: %d\n", self.*);
    return self;
  })
));

main :: (fn() -> unit) {
  bi := Box(i32)(100);
  use_id(dyn(bi));
};

export main;