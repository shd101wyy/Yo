open import "std/io/file";
open import "std/string";

main :: (fn() -> unit) {
  // Test async write and read roundtrip
  (path : *(u8)) = "/tmp/yo_async_test.txt";
  async {
    // Write
    write_result := File.open(path, ((O_WRONLY | O_CREAT) | O_TRUNC));
    match(write_result,
      .Ok(file) => {
          test_data := String.from("Hello async write!");
          write_result := await file.write_string_async(test_data);
          file.close();
          
          match(write_result,
            .Ok(_) => assert(true),
            .Err(e) => assert(false, "Write should succeed")
          );
      },
      .Err(e) => {
        assert(false, "File should open for writing");
      }
    );
    
    // Read back
    read_result := File.open(path, O_RDONLY);
    match(read_result,
      .Ok(file) => {
          read_result := await file.read_string_async();
          file.close();
          
          match(read_result,
            .Ok(content) => {
              expected := String.from("Hello async write!");
              assert((content.len() == expected.len()), "Content length should match");
            },
            .Err(e) => {
              assert(false, "Read should succeed");
            }
          );
      },
      .Err(e) => {
        assert(false, "File should open for reading");
      }
    );
  };
};

export main;
