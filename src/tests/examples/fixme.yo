open import "std/libc/stdio";

Bucket :: (fn(compt(K): Type, compt(V): Type) -> compt(Type))
  struct(
    key : K,
    value : V
  )
;

HashMap :: (fn(
  compt(K): Type,
  compt(V): Type,
  using(KeyEqual) : (K <: Eq(K, K)),
  using(KeyHash) : (K <: Hash)
) -> compt(Type))
  object(
    ctrl : ?*(u8),
    data : ?*(Bucket(K, V)),
    capacity : usize,
    size : usize,
    
    new :: (fn() -> Self) {
      return Self(.None, .None, 0, 0);
    }
  )
;
test_basic_insert_and_get :: (fn() -> unit) {  
  map := HashMap(i32, i32, i32.Eq, i32.Hash).new();
};

main :: (fn() -> unit) {    
  test_basic_insert_and_get();
  return;
};

export main;
