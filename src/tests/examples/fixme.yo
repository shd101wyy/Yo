open import "std";


K :: (fn(compt(Value) : Type) -> compt(Type)) {
  ClosureType ::
    fn(value : Value) => unit;
  return ClosureType;
};

// Algebraic effects
Yield ::
  fn( i : i32, resume : K(i32)) -> unit;

main :: (fn( resume : K(i32)) -> unit) {
  (compt(given(yield)) : Yield) =
    (i, resume) ->
      cond
        (i < 0) => resume(0),
        true => resume(i)
  ;
  yielded := do yield(0);
  result :=
    1 + yielded;
  resume(result);
};


main2 :: (fn( resume : K(i32)) -> unit) {
  (compt(given(yield)) : Yield) =
    (i, resume) ->
      cond
        (i < 0) => resume(0),
        true => resume(i)
  ;
  yield(0, (yielded) => {
    result :=
      1 + yielded;
    resume(result);
  });
};
