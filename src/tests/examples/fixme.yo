GiveInt :: module(
  Self : Type,
  give_int :
    fn(self : *(Self)) -> int
);

given(BooleanGiveInt) :: GiveInt(
  Self : boolean,
  give_int :
    (self) -> 0
);

given(I32GiveInt) :: GiveInt(
  Self : i32,
  give_int :
    (self) -> 1
);

given(I32GiveAnotherInt) :: GiveInt(
  Self : i32,
  give_int :
    (self) -> 2
);

use_id :: 
  (fn(
    value : *(Dyn(GiveInt))
  ) -> unit) {
  x := value.give_int();
};

x := 12;
use_id(*(dyn(x, I32GiveInt)));
use_id(*(dyn(x, (I32GiveAnotherInt,))));
