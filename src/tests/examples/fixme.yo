extern
  malloc:
    () -> ^!(i32),
  free:
    (^!(i32)) -> ()
;

func1 :: (() -> ()) {
  x := malloc();
  p := *(x);

  y := *(p.*); // <- This is valid.
  // z := p.*; // This is not valid.

  free(x);
};

Data :: struct
  x : ^!(i32),
  y: i32
;

func :: ((data: Data)-> ()) {
  x := data.y;
  consume(data);
};
