open import "std/libc/stdio";
Async :: import "std/async";

// Expected to print:
//
// Task started
// Running main...
// Task completed
//
//
main :: (fn() -> unit) {
  b := Box(i32)(0);

  // Simple test without nested async blocks
  task := async {
    printf("Task started %d\n", b.*);
    assert(b.* == 0);

    b.* = (b.* + 1);
    await Async.yield();
    
    printf("Task completed %d\n", b.*);
    assert(b.* == 2);
  };
  
  printf("Running main... %d\n", b.*);
  assert(b.* == 1);
  b.* = (b.* + 1);
};

export main;