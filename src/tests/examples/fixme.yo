open import "std";
open import "std/libc/stdio";

Id :: module
  Self : Type,
  id : (fn(self : Self) -> Self)
;

MyBox :: object
  (*) : i32,

  dispose :: ((fn(self : Self) -> unit) {
    printf("Disposing MyBox with value: %d\n", self.(*));
  }),

  // Implement the Id module
  Id :: Id(
    Self : Self,
    id : ((self) -> {
      return self;
    })
  )
;

DEFAULT_SIZE :: 16.as(usize);

test :: (fn(v : usize) -> i32) {
  return v.as(i32); 
};

main :: (fn() -> unit) {
  test(DEFAULT_SIZE);
  box := MyBox(42);
  x := MyBox.Id.id(box);
  y := box.id(); // Expected this to work.
                 // Type methods have higher priority than type modules.  
                 // If type method is not found, we check the type modules, recursively (because a module might have modules in it).

  printf("Value from id: %d\n", x.(*));
};

export main;