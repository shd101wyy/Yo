main :: (()-> unit) {
  // Different types of data structures
  SomeStruct :: struct(x: i32, y: boolean);
  Complex :: Tuple(SomeStruct);

  (d : Tuple(a: i32, b: SomeStruct)) = (1, SomeStruct(2, false));

  // Support destructuring struct
  {
    (a, _(x, y)) := d;
  };
  /// or
  {
    (a, {x, y}) := d;
    /// or
    (another_a, {y: another_y, x: another_x}) := d;

  };
  /// or
  {
    // (a, Complex.0(x, y)) := d; // This is not supported
    (b: _(x, y), a: another_a) := d;
  };
}; 