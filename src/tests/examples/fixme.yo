open import "../../../std/libc/stdio.yo";

Speak :: module(
  Self: Type,
  speak : (fn(self : Self) -> i32)
);

// Dog :: struct(); // This should give error working with `dyn`.
Dog :: ref struct(
  dispose :: ((fn(self : Self) -> unit) {
    printf("Disposing Dog\n");
  }),

  ...(Speak
    Self : Self,
    speak : ((self : Self) -> {
      printf("Woof!\n");
      return 1;
    })
  )
);

main :: ((fn() -> i32) {
  dog := Dog();
  (dyn_dog : Dyn(Speak)) = dyn(dog);
  x := dyn_dog.___dup();
  // We insert ___dup: 
  //    dyn(___dup(dog), DogSpeak);

  result := dyn_dog.speak();

  // ___drop(dyn_dog);
  // ___drop(dog);
  return result;
});

export main;
