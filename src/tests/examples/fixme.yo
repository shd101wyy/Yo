open import "std";

// Value semantics
/// struct
{
  Point :: struct(
    x : i32,
    y : i32
  );

  mut(p1) :: Point(3, 4);
  mut(p2) :: p1;
  p1.x = 5;

  // compt_print("p1 ", p1);
  // compt_print("p2 ", p2);
  compt_assert(p1.x == 5);
  compt_assert(p2.x == 3);
};

/// array
{
  mut(arr1) :: [1, 2, 3];
  arr2 :: arr1;
  index :: 0;
  arr1(index) = 4;
  // compt_print("arr1 ", arr1);
  // compt_print("arr2 ", arr2);
  compt_assert(arr1(0) == 4);
  compt_assert(arr1(1) == 2);
  compt_assert(arr1(2) == 3);
  compt_assert(arr2(0) == 1);
};

/// tuple
{
  mut(t1) :: (1, 2.0);
  mut(t2) :: t1;
  t1.0 = 4;

  // compt_print("t1 ", t1);
  // compt_print("t2 ", t2);
  compt_assert(t1.0 == 4);
  compt_assert(t2.0 == 1);
}