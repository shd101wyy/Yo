Node :: (fn(compt(T): Type) -> compt(Type))
  object(
    value : T,
    next : Option(Self)
  )
;

LinkedList :: (fn(compt(T): Type) -> compt(Type))(
  object(
    head : Option(Node(T)),

    has :: (fn(
      self: Self, 
      value: T,
      where(T <: Eq(T))
    ) -> bool)({
      current_opt := self.head.unwrap();
      current_opt.value == value;
      false
    }),

    // FIXME: This function should throw error
    test_without_where :: (fn(self : Self, value : T) -> bool)({
      current_opt := self.head.unwrap();
      current_opt.value == value;
      false
    })
  )
);
