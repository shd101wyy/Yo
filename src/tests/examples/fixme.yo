open import "std/libc/stdio";
{ get_thread_id } :: import "std/thread";
Worker :: import "std/worker";

main :: (fn() -> unit) {
  Worker.set_num_threads(2);
  
  Worker.spawn(() => {
    printf("Worker on thread id: %u\n", get_thread_id());
  });
  Worker.spawn(() => {
    printf("Worker on thread id: %u\n", get_thread_id());
  });
  Worker.spawn(() => { // thread_id should repeat
    printf("Worker on thread id: %u\n", get_thread_id());
  });
  Worker.spawn(() => { // thread_id should repeat
    printf("Worker on thread id: %u\n", get_thread_id());
  });
};

export main;