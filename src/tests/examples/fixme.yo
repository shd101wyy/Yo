open import "std";

x1 :: (3 @+ 4);
x2 :: (3 @- 4);
x3 :: (3 @* 4);
x4 :: (3 @/ 4);
x5 :: (3 @% 4);
x6 :: 3.neg();
x7 :: (3 @== 4);
x8 :: (3 @!= 4);
x9 :: (3 @< 4);
x10 :: (3 @<= 4);
x11 :: (3 @> 4);
x12 :: (3 @>= 4);

compt_factorial :: ((@(x) : compt_int) -> @(compt_int))
  cond
    (x @== 0) => 1,
    true =>
      x @* recur(x @- 1)
;