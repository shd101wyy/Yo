main :: (fn() -> unit)({
  x := Data(99);
  isolated := ^(x);
  match(isolated,
    .Some(iso_val) => {
      e := iso_val.extract().unwrap();
      assert(e.* == 99);
    },
    .None => {
      assert(false, "Expected Some, got None");
    }
  );
});

export main;


