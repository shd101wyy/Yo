open import "std";
open import "../../../std/libc/stdio.yo";

Speak :: module(
  Self: Type,
  speak : (fn(self : Self) -> i32)
);

// Dog :: struct(); // This should give error working with `dyn`.
Dog :: ref struct(
  dispose :: (fn(mut(self) : Self) -> unit) {
    printf("Disposing Dog\n");
  }
);

DogSpeak :: Speak
  Self : Dog,
  speak : ((self : Self) -> {
    printf("Woof!\n");
    return 1;
  })
;


main :: ((fn() -> i32) {
  dog := Dog();
  (dyn_dog : Dyn(Speak)) = dyn(dog, DogSpeak); 
  // We insert ___dup: 
  //    dyn(___dup(dog), DogSpeak);

  result := dyn_dog.speak();

  // ___drop(temp_var); // FIXME: This logic is missing
  // ___drop(dog);
  return result;
});

export main;
