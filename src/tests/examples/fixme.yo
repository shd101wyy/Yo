Add :: (fn(compt(Rhs) : Type, compt(Output) ?= Rhs)-> compt(Module))
  module
    // Self   :  Type, // FIXME: Automatically insert "Self : Type" on very top if `Self` is not provided.
    Output := Output,
    (+)    :  (fn(lhs: Self, rhs: Rhs)-> Output)
;

Char :: impl {
  Self :: char;
  export Self;

  // === Arithmetic ===
  _Add :: Add(Self)
    Self : Self,
    (+): ((a, b) -> a)
  ;
}
