(-) :: impl {
  (neg) :: (fn(forall(_Self : Type),
            self : _Self,
            where(_Self <: Negate(_Self))
          ) -> _Self) {
    return self.neg();
  };

  (compt_neg) :: (fn(forall(_Self : Type), 
          compt(self) : _Self,
          where(_Self : ComptNegate(_Self))
        ) -> compt(_Self)) {
    return self.neg();
  };

  Call :: (neg, compt_neg);

  export
    Call,
    neg,
    compt_neg
  ;
};