Eq ::
  (fn(compt(Rhs) : Type) -> compt(Module))
  module
    (==) : (fn(lhs: Self, rhs: Rhs) -> boolean)
;


Ord :: (
  fn(
    compt(Rhs) : Type
  ) -> compt(Module))
  module
    using(Eq) : (Self <: Eq(Rhs)),

    (<) :
      fn(lhs: Self, rhs: Rhs) -> boolean
;

impl {
  Self :: i32; // Commenting this line will make it work.

  _Eq :: impl(i32, Eq(i32)
    (==) : ((a, b) -> true)
  );

  _Ord :: impl(i32, Ord(i32)
    (<) : ((a, b) -> true)
  );
};