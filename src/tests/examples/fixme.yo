
open import "std/libc/stdio.yo";

main :: (fn() -> unit) {
  // Create binding first, then assign value
  arr1 : Array(i32, 3);
  arr1 = [1, 2, 3];

  // Create binding and assign value in one line
  arr2 := [1, 2, 3];
  arr2(0) = 12;

  // Copy array
  arr3 := arr1;
  arr3(1) = 22; // This shouldn't affect arr1

  assert(arr1(0) == 1);
  assert(arr1(1) == 2);
  assert(arr2(0) == 12);
  assert(arr3(1) == 22);
};

export main;
