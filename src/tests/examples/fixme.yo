main :: (fn(color: Color, resume : K(i32)) -> unit) {
  printf("Before yieldColor\n");
  result := match((do yieldColor(color)),
    .Red => (do yield(12)),
    .Green => {
      result := (do yield(34));
      result + 1
    },
    .Blue => 0
  );
  printf("Result: %d\n", result);
  resume(result);
};

