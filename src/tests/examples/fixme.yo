open import "std/libc/stdio";

Data :: struct(
  (*) : i32,

  self :: ((fn(self : *(Self)) -> i32) {
    return self.*.*;
  })
);

main :: (fn() -> unit) {
  x := Data(16);
  
  y := &(x).self();
  printf("y = %d\n", y);
  
  z := x.self(); // TODO: Make this work as well.
                 // Let's automatically cast `x` as `&(x)` for function that takes first argument that is pointer type, while the receiver type is not pointer.
                 // Let's also not enable this for infix operator calls, like `a + b`. There is a `stringIsOperator` function you can use.  
  printf("z = %d\n", z);
};

export main;