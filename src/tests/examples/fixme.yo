extern "C",
  add :
    (x : i32, y : i32) -> i32,
  sub :
    (x : i32, y : i32) -> i32,
  mul :
    (x : i32, y : i32) -> i32,
  div :
    (x : i32, y : i32) -> i32,
  eq  :
    (x : i32, y : i32) -> boolean,
  gt  :
    (x : i32, y : i32) -> boolean,
  ge  :
    (x : i32, y : i32) -> boolean
;

main :: (() -> i32) {
  result := mul({
    x := 1;
    div(add(x, 2), 3)
  }, cond(true => {
    x := 2;
    sub(x, 3)
  }, true => 1));
  result
};

// `export` here is required. Otherwise no functions will be compiled.
export
  main;
