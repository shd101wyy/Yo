*/

generic_id :: ((@(T): Type, val: T) -> T) val;


main :: (() -> i32) {
  Point :: struct(x: i32, y: i32);

  x := generic_id(i32, 2);
  y := generic_id(f64, 3.4);
  p := generic_id(Point, Point(x: 1, y: 2));

  x
};

// `export` here is required. Otherwise no functions will be compiled.
export
  main;
