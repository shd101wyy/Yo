Color :: enum Red, Green, Blue;

color_to_i32 :: ((color: Color) -> i32) {
  match color,
    .Red => {
      return 0;
    },
    .Green => {
      return 1;
    },
    .Blue => {
      return 2;
    }
  ;
};

color_to_i32_2 :: ((color: Color) -> i32) {
  color := match color,
    .Red => 0,
    .Green => {
      return 1;
    },
    .Blue => {
      return 2;
    }
  ;
  return color;
};

main :: (() -> i32) {
  return 12;
};
