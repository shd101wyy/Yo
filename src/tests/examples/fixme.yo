Id :: module(
  where(Self <: Copy),
  id : (fn(x : Self) -> Self)
);

use_id :: (
  fn(
    compt(T) : Type, 
    x : T, 
    where(T <: Id)
  ) -> T) {
  y := x.id();
  z := (T <: Id).id(x);
  return z;
};

impl(i32, Copy());
impl(i32, Id(
  id : (self -> self)
));

main :: (fn() -> unit) {
  compt_expect_error((boolean <: Id).id(true));
  x := 12.id();
  y := (i32 <: Id).id(x);
};