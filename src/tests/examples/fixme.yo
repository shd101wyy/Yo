Id :: module(
  id : (fn(self : Self) -> Self)
);

use_id :: (fn(
  forall(T : Type),
  value : T,
  where(T <: Id)
) -> T) {
  // (T <: Id).id(value);
  return value.id();
};

impl(Box(i32), Id(
  id : ((self) -> {
    printf("Boxed i32 value: %d\n", self.*);
    return self;
    // TODO: self
  })
));

main :: (fn() -> unit) {
  bi := Box(i32)(100);
  assert(use_id(bi).* == bi.*, "use_id should return the same Boxed i32 value");
};

export main;