open import "std";
open import "std/libc/stdio.yo";
/*
MyBox :: object
  (*) : i32,

  dispose :: ((fn(self : Self) -> unit) {
    printf("Disposing MyBox with value: %d\n", self.(*));
  })
;
*/

main :: (fn() -> i32) {
  ch := chan(i32, 2);

  __yo_chan_send(ch, 1);
  __yo_chan_send(ch, 2);

  printf("%d\n", __yo_chan_recv(ch)); // 1
  printf("%d\n", __yo_chan_recv(ch)); // 2

  return 0;
};

export main;