Clone :: (fn(compt(Self): Type) -> compt(Module))
  module
    Self  := Self,
    clone :
      (fn( self: &(Self) ) -> Self)
;

Point :: struct
  x : i32,
  y : i32,

  // Implement the Clone module
  ...(
    Clone(Self)(
      clone :
        (self) ->
          Self(self.x, self.y)
    ))
;

p := Point(1, 2);
Point.clone(&(p));
