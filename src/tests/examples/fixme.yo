Eq ::
  (fn(compt(Rhs) : Type) -> compt(Module))
  module
    Self : Type,

    (==): (fn(lhs: Self, rhs: Rhs) -> boolean)
;

Ord :: (
  fn(
    compt(Rhs) : Type
  ) -> compt(Module))
  module
    Self : Type,
    using(EqSelf) : (Self <: Eq(Rhs)),

    (<) :
      fn(lhs: Self, rhs: Rhs) -> boolean
;

I32Eq :: Eq(i32)(
  Self : i32,

  (==) : ((lhs, rhs) -> true)
);

I32Ord :: Ord(i32)(
  Self : i32,

  // Commented out the line below should still work
  // because we can implicitly inject I32Eq for `using(EqSelf)`
  // 
  // EqSelf : I32Eq,

  (<) : ((lhs, rhs) -> true)
);