open import "std/libc/stdio";
Async :: import "std/async";

main :: (fn() -> Impl(Future(unit))) {
  // Simple test without nested async blocks
  task := async {
    printf("Task started\n");
    await Async.yield();
    printf("Task completed\n");
  };
  printf("Running main...\n");
  return task;
};

export main;
