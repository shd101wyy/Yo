open import "std";

// For loop
// which currently only works for Array
sum :: (() -> i32) {
  arr := [1, 2, 3];
  mut(i) := 0;
  for arr, mut(elem) => {
    i = (elem + i);
  };
  return i;
};

compt_sum :: (() -> compt(i32)) {
  arr :: [1, 2, 3];
  mut(i) :: 0;
  for arr, (elem, index) => {
    i = (elem + i);
  };
  return i;
};

result :: compt_sum();