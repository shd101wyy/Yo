open import "std/libc/stdio.yo";
{ GlobalAllocator } :: import "std/allocator";
open GlobalAllocator;

MyBox :: object(
  (x) : i32,
  dispose :: ((fn(self : Self) -> unit) {
    printf("Disposing MyBox with value: %d\n", self.x);
  })
);

TestDyn :: module(
  print : (fn(self : *(Self)) -> unit),
  return_i32 : (fn(self : *(Self)) -> i32)
);

use_test_dyn :: (fn(
  value : Dyn(TestDyn)
) -> i32) {
  value.print();
  return value.return_i32();
};

impl(MyBox, TestDyn(
  print : ((self) -> {
    printf("Boxed i32 value: %d\n", self.x);
  }),
  return_i32 : ((self) -> {
    return self.x;
  })
));

main :: (fn() -> unit) {
  // b := MyBox(42);
  // p := malloc(sizeof((MyBox)));
  // match(p,
  //   .None => {
  //     printf("Memory allocation failed\n");
  //   },
  //   .Some(ptr) => {
  //     casted_ptr := (*((MyBox)))(ptr);
  //     casted_ptr.* = b;
  //   }
  // );
  // free(p);

  bi := MyBox(100);
  use_test_dyn(dyn bi);
};

export main;