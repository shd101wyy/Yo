open import "std/string";

id :: (fn(forall(T : Type), v : T) -> T)(v);

main :: (fn() -> unit) {
  {
    x := Box(i32)(3);
    y := { x };
    z := { y };  
    y.x = Box(i32)(4);
  };

  {
    (cstr : *(u8)) = "Hello";
    result := String.from_cstr(cstr);
    match(id(result),
      .Ok(str) => {
        assert(str.len() == usize(5));
      },
      .Err(_) => assert(false, "Should successfully create string from C string")
    );
  };
};

export main;
