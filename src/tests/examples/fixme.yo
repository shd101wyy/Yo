extern "C",
  add :
    (x : i32, y : i32) -> i32,
  gt  :
    (x : i32, y : i32) -> boolean
;

max :: ((x : i32, y : i32) -> i32)
  cond
    gt(x, y) => x,
    true     => y
;

main :: (() -> i32) {
  x := 12;
  y := 13;
  z := add(x, y);
  m := max(x, y);
  m
};

// `export` here is required. Otherwise no functions will be compiled.
export
  main;
