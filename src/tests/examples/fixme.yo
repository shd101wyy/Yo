open import "std/libc/stdio.yo";

MyBox :: object(
  (*) : i32,

  dispose :: ((fn(self : Self)-> unit) {
    printf("Disposing Boxed i32 with value: %d\n", self.*);
  })
);

main :: (fn() -> unit) {
  x := MyBox(1);

  ClosureType :: Impl(Fn(y : i32) -> i32);
  /*
  // FIXME:
  (closure : ClosureType) = ((y) => {
    x.* = (x.* + y);
    return x.*;
  });
  */
  // FIXME:
  (closure : ClosureType) = (ClosureType {
    x.* = (x.* + y);
    return x.*;
  });

  // This works
  closure_working := (ClosureType {
    x.* = (x.* + y);
    return x.*;
  });


  closure(1); // 2
  closure(1); // 3
  result := closure(2); // 5

  printf("Final result: %d\n", result);
  assert(x.* == 5, "Captured boxed variable should be 5");
  assert(x.* == result, "Expected final result to be 5");
};

export main;