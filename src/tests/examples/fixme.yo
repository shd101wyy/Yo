(*) :: impl {
  (*) :: (fn(compt(T) : Type) -> compt(Type)) {
    return struct(
      ptr : __yo_Ptr(T)
    );
  };

  (ptr_deref) :: (fn(forall(T : Type), ptr : *(T)) -> T) {
    return __yo_ptr_deref(ptr.ptr);
  };

  Self :: (*, ptr_deref);
  export Self;
};

(&) :: (fn(quote(value) : Expr) -> unquote(Expr))
  quote (*)(typeof(unquote(value)))(__yo_address_of(unquote(value)))
;

main :: (fn() -> unit) {
  x := 12;
  y := &(x);
  z := *(y);
};