/*
 The `do` macro transform the code below:
  
  do {
    x := 1;
    with response <= fetch("https://api.example.com");
    std.println(response);
    with (json,) <<= response.json();
    std.println(json);
    with (x, y) <- json.parse();
    return x + y;
  }
 
  to:

  {
    x := 1;
    fetch("https://api.example.com", fn(response) => {
      std.println(response);
      response.json(fn(json) =>> {
        std.println(json);
        json.parse(fn(x, y) -> {
          return(x + y);
        })
      })
    })
  }
 */

// Create a begin expression with all arguments using unquote_splicing
create_begin_with_all_args :: ((compt(args) : ExprList) -> compt(Expr)) {
  return cond(
    (args.length() == 0) => quote(()),
    (args.length() == 1) => args.car(),
    true =>
      // Use unquote_splicing to expand all arguments into a single begin call
      // This creates: begin(arg1, arg2, arg3, ..., argN)
      quote(begin(unquote_splicing(args)))
  );
};

// Helper function to collect consecutive non-with statements into a single begin block
collect_non_with_statements :: ((compt(args) : ExprList) -> compt(Expr)) {
  return cond(
    (args.length() == 0) => quote(()),
    (args.length() == 1) => args.car(),
    true =>
      // Collect all statements and wrap them in a single begin
      // This will create: begin(stmt1, stmt2, stmt3, ...)
      create_begin_with_all_args(args)
  );
};

// Helper function to check if there are any with statements in the argument list
check_for_with_statements :: ((compt(args) : ExprList) -> compt(boolean)) {
  return cond(
    (args.length() == 0) => false,
    true => {
      first_arg :: args.car();
      rest_args :: args.cdr();
      cond(
        first_arg.is_fn_call() => {
          callee :: first_arg.get_callee();
          cond(
            (callee.is_atom() && (callee == quote(with))) => true,
            true => recur(rest_args)
          )
        },
        true => recur(rest_args)
      )
    }
  );
};

// Transform "with var <= expr" into a monadic bind pattern
// This should transform the entire do block into nested function calls
transform_do_block :: ((compt(args) : ExprList) -> compt(Expr))
  cond(
    (args.length() == 0) => quote(()),
    (args.length() == 1) => args.car(),
    true => {
      first_arg :: args.car();
      rest_args :: args.cdr();
      has_with_statement :: check_for_with_statements(rest_args);
      // compt_print("     - has_with_statement:");
      // compt_print(has_with_statement);
      cond(
        has_with_statement => {
          rest_transformed :: recur(rest_args);
          // compt_print("rest_transformed:");
          // compt_print(rest_transformed);
          // compt_print(quote(begin(unquote(first_arg), unquote(rest_transformed))));
          quote(begin(unquote(first_arg), unquote(rest_transformed)))
        },
        true => {
          all_remaining :: quote(unquote(first_arg)).cons(rest_args);
          create_begin_with_all_args(all_remaining)
        }
      )
    }
  )
;

// Helper function to check if there are any with statements in the argument list
do :: ((quote(begin_expr) : Expr) -> unquote(Expr)) {
  return cond(
    begin_expr.is_fn_call() => {
      callee :: begin_expr.get_callee();
      cond(
        // expect the callee to be the `begin` function
        (callee.is_atom() && (callee == quote(begin))) => {
          args :: begin_expr.get_args();
          // Transform the entire block
          transform_do_block(args)
        },
        // otherwise, return false for error
        true => {
          compt_assert(false, "Expected `do` block to start with `begin`");
          quote(false)
        }
      )
    },
    true => {
      compt_assert(false, "Expected `do` block to be a function call to `begin`");
      quote(false)
    }
  );
};

expanded :: macro_expand quote
  do {
    std.println("after fetch");
    std.println(response);
    with (json,) <<= response.json();
    std.println("after json")
  }
;

compt_print("\n*** calculate wtf");

wtf :: check_for_with_statements(
  expr_list(
    quote((std.println)(response)),
    quote(with((json,) <<= (response.json)())),
    quote((std.println)("after json"))
  )
);

compt_assert(wtf, true);

