open import "std";
open import "std/libc/stdio";

MyBox :: (fn(compt(X) : Type) -> compt(Type)) 
  object(
    ptr : *(X),

    get :: (fn(self : Self) -> Option(X)) {
      // return .Some(self.ptr.*); // This works
      return .Some((self.ptr + 0).*);
    }
  );

main :: (fn() -> unit) {
  x := 12;
  // y := (x + 3);
};