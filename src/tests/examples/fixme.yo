
open import "std/libc/stdio.yo";

main :: (fn() -> unit) {
  t := (1, 3.4, true);
  (t2 : Tuple(a: i32, b: f64, c: bool)) = t;

  {
    // by index
    assert(t.0 == 1);
    assert(t.1 == 3.4);
    assert(t.2 == true);
  };

  {
    // by index
    assert(t2.0 == 1);
    assert(t2.1 == 3.4);
    assert(t2.2 == true);

    // by label
    assert(t2.a == 1);
    assert(t2.b == 3.4);
    assert(t2.c == true);
  };
  
  {
    // by order
    (x, y, z) := t;
    assert(x == 1);
    assert(y == 3.4);
    assert(z == true);
  };
  {
    // by order
    (c, b, a) := t2;
    assert(c == 1);
    assert(b == 3.4);
    assert(a == true);
  };
  {
    // by label
    (c : c, b : b, a : a) := t2;
    assert(a == 1);
    assert(b == 3.4);
    assert(c == true);
  };

  {
    // by label with different names
    (c : c1, b : b1, a : a1) := t2;
    assert(a1 == 1);
    assert(b1 == 3.4);
    assert(c1 == true);
  };
};

export main;
