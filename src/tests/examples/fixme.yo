Node :: (fn(compt(T): Type) -> compt(Type))
  object(
    value : T,
    next : Option(Self),
    prev : Option(Self)
  )
;

LinkedList :: (fn(compt(T): Type) -> compt(Type))
  object(
    head : Option(Node(T)),

    /**
     * Check if the list contains a value
     * O(n) time complexity
     */
    contains :: ((fn(
      self : Self,
      val : T,
      using(ElementEqual) : (T <: Eq(T, T))
    ) -> boolean) {
      current_opt := self.head;

      while runtval(true), {
        match(current_opt,
          .None => {
            break;
          },
          .Some(current) => {
            current_opt = current.next;
            // dup(current.next);
            // drop(temp) // where temp holds the old value of current_opt
          }
        );
      };
      
      false
      
      // drop(current_opt)

    })
  );

export
  LinkedList
;
