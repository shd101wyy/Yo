open import "std";
open import "std/libc/stdio.yo";

main :: (async(fn() -> Future(unit))) {
  task1 := async {
    return 1;
  };
  task2 := async {
    return 2;
  };

  a := await(task1);

  result := (await(task1) + await(task2));
};

/*
main :: (async(fn() -> Future(unit))) {
  printf("Hello, async world!\n");
};
*/

export main;
