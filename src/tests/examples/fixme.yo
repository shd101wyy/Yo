open import "std/libc/stdio";
{ get_thread_id, get_cpu_id } :: import "std/thread";
Worker :: import "std/worker";

main :: (fn() -> unit) {
  Worker.set_num_threads(2);
  
  Worker.spawn(() => {
    printf("Worker 1: thread_id=%u, cpu_id=%d\n", get_thread_id(), get_cpu_id());
  });
  Worker.spawn(() => {
    printf("Worker 2: thread_id=%u, cpu_id=%d\n", get_thread_id(), get_cpu_id());
  });
  Worker.spawn(() => { // thread_id and cpu_id should repeat
    printf("Worker 3: thread_id=%u, cpu_id=%d\n", get_thread_id(), get_cpu_id());
  });
  Worker.spawn(() => { // thread_id and cpu_id should repeat
    printf("Worker 4: thread_id=%u, cpu_id=%d\n", get_thread_id(), get_cpu_id());
  });
};

export main;