open import "std";
open import "std/libc/stdio.yo";

MyBox :: object
  (*) : i32,

  dispose :: (fn(self : Self) -> unit) {
    printf("Disposing MyBox with value %d\n", self.(*));
  }
;

main :: (fn() -> unit) {
  box1 := MyBox(666);
  printf("Created MyBox with value %d\n", box1.(*));

  future1 := async {
    st := { box : box1 }; // Create an anonymous struct capturing `box1`;
    printf("In future1, box value is %d\n", st.box.(*));
  };
  printf("Created future1\n");

  // future1 is not awaited
  // it should be dropped at the end of this function
};

export main;
