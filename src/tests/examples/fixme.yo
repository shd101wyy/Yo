open import "std/libc/stdio.yo";
Thread :: import "std/thread";

Worker :: (fn(compt(SendType) : Type,
              compt(ReceiveType) : Type)
          -> compt(Type)) {
  return object(

    spawn :: ((fn(
      callback : 
        (fn(child : recur(ReceiveType, SendType))-> Impl(Future(unit)))
    ) -> Self) {
      return panic("Not implemented yet");
    }),

    send :: ((fn(self: Self, msg: SendType) -> Impl(Future(Result(unit, SendType)))) {
      return panic("Not implemented yet");
    }),

    recv :: ((fn(self: Self) -> Impl(Future(Result(ReceiveType, unit)))) {
      return panic("Not implemented yet");
    })
  );
};

main :: (fn() -> unit) {
  hardware_threads := Thread.get_hardware_threads();
  printf("Hardware threads available: %u\n", hardware_threads);

  thread_id := Thread.get_thread_id();
  printf("Current thread ID: %u\n", thread_id);
};

export main;