open import "std/libc/stdio";

main :: (fn() -> unit) {
  x := 12;
  p := &(x);
  
  q := (p &+ 2);  // Test &+
  assert(q &> p); // Test &>
  assert(p &< q); // Test &<
  assert(q &>= p); // Test &>=
  assert(p &<= q); // Test &<=
  assert((q &/ p) == 2); // Test &/

  z := (q &- 2);   // Test &-
  assert(z &== p); // Test &==
  assert(z &<= p); // Test &<=
  assert(p &>= z); // Test &>=
};

export main;