open import "std/libc/stdio.yo";
Async :: import "std/async";

main :: (fn() -> unit) {
  b := Box(i32)(0);

  // Simple test without nested async blocks
  task := async {
    printf("Task started %d\n", b.*);
    assert(b.* == 0);

    l := Box(i32)(0);

    b.* = (b.* + 1);
    await Async.yield();

    l.* = (l.* + b.*); // l.* should be 2 here
    printf("Inner value l: %d\n", l.*);
    assert(l.* == 2);

    printf("Task completed %d\n", b.*);
    assert(b.* == 2);
  };
  
  printf("Running main... %d\n", b.*);
  assert(b.* == 1);
  b.* = (b.* + 1);
};

export main;