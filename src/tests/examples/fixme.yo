open import "std/libc/stdio";

Data :: object(v : i32);
impl(Data, Isolation(
  can_isolate : ((self) -> (rc(self) == 1))
));

expanded :: macro_expand(quote(^(x)));

main :: (fn() -> unit)({
  x := Data(12);  
  isolated := ^(x);

  use_cb :: (fn(v : i32, cb : (Dyn(Fn(u : i32) -> i32))) -> i32) {
    return cb(v);
  };
  
  {
    a := 2;
    x := use_cb(10, dyn (u) => ((u + 1) + a)); // capture variable 'a'
    assert(x == 13);
  };

  {
    x := Box(i32)(99);
    assert((Box(i32) <: Isolation).can_isolate(x));
  };

  return ();
});

export main;


