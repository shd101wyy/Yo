open import "std/libc/stdio.yo";
{ GlobalAllocator } :: import "std/allocator.yo";

Id :: module(
  id : (fn(self : Self) -> Self)
);

use_id :: (fn(
  forall(T : Type),
  value : T,
  where(T <: Id)
) -> T) {
  // (T <: Id).id(value);
  return value.id();
};

impl(i32, Id(
  id : ((self) -> {
    printf("i32 value: %d\n", self);
    return self;
  })
));

impl(boolean, Id(
  id : ((self) -> {
    cond(
      self => printf("boolean value: true\n"),
      true => printf("boolean value: false\n")
    );
    return self;
  })
));

impl(Box(i32), Id(
  id : ((self) -> {
    printf("Boxed i32 value: %d\n", self.*);
    return self;
  })
));

ret_boolean :: (fn() -> Impl(Id)) {
  return true;
};

ret_i32 :: (fn() -> Impl(Id)) {
  return i32(123);
};


main :: (fn() -> unit) {
  b := ret_boolean();
  assert(b.id() == true, "Expected true from ret_boolean");

  i := ret_i32();
  assert(i.id() == i32(123), "Expected 123 from ret_i32");
};

export main;