open import "std/libc/stdio.yo";

RetI32 :: module(
  return_i32 : (fn(self : *(Self)) -> i32)
);


impl(i32, RetI32(
  return_i32 : ((self) -> {
    return self.*;
  })
));

impl(boolean, RetI32(
  return_i32 : ((self) ->
    cond(
      self.* => 1,
      true => return 0
    )
  )
));

test_fn :: (fn(flag : boolean) -> Impl(RetI32)) {
  cond(
    flag => {
      return i32(100);
    },
    true => {
      return true;
    }
  );
  return i32(5);
};