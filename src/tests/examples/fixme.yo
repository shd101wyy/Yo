extern "C",
  add :
    (x : i32, y : i32) -> i32,
  sub :
    (x : i32, y : i32) -> i32,
  mul :
    (x : i32, y : i32) -> i32,
  div :
    (x : i32, y : i32) -> i32,
  eq  :
    (x : i32, y : i32) -> boolean,
  gt  :
    (x : i32, y : i32) -> boolean,
  ge  :
    (x : i32, y : i32) -> boolean
;

factorial :: ((n : i32) -> i32) {
  result :=
    cond
      eq(n, 0) => 1,
      true     => mul(n, recur(sub(n, 1)))
  ;
  result // return result
};

main :: (() -> i32) {
  x := 4;
  factorial(x)
};

// `export` here is required. Otherwise no functions will be compiled.
export
  main;
