open import "std/libc/stdio";

Iterator :: (fn(compt(Item) : Type) -> compt(Module)) {
  return module(
    Item := Item,
    next :
      fn(self : *(Self)) -> Option(Self.Item)
  );
};

IntoIterator :: (fn(
  compt(Item) : Type,
  compt(IntoIter) : Type,
  using(IntoIterIter) : (IntoIter <: Iterator(Item))) -> compt(Module)) {
  return module(
    Item := Item,
    IntoIter := IntoIter,
    into_iter : 
      fn(self : Self) -> Self.IntoIter
  );
};

MyBox :: struct(
  x : i32,

  IntoIter :: struct(
    current : i32,

    Iterator :: impl(Self, Iterator(i32)(
      next : ((self) ->
        cond(
          (self.current == 0) => .None,
          true => {
            current := self.current;
            self.current = (self.current - 1);
            .Some(current)
          }
        ))
    ))
  ),

  IntoIterator :: impl(Self, IntoIterator(i32, Self.IntoIter, Self.IntoIter.Iterator)(
    into_iter : ((self) -> Self.IntoIter(self.x))
  ))
);

/**
 * `for` macro to run while loop over an iterator
 * eg:
 * 
 *   for box.into_iter(), (value) => {
 *     printf("value %d\n", value);
 *   };
 *
 * transforms to
 * 
 * iter := box.into_iter();
 * while true, {
 *   value := iter.next();
 *   match(value,
 *     .Some(value) => {
 *       printf("value %d\n", value);
 *     }),
 *     .None => { break; } 
 * }
 */
for :: (fn(
  quote(iter) : Expr,
  quote(handle) : Expr
  ) -> unquote(Expr)) {
  // Check if `handle` is a function call of `=>`
  return cond(
    (handle.is_fn_call()) => {
      callee :: handle.get_callee();
      cond(
        (callee.is_atom() && (callee == quote(=>))) => {
          args :: handle.get_args();
          compt_assert(args.length() == 2, "'for' macro requires 2 arguments in the function handle");
          variable :: args.car();
          body :: args.cdr().car();

          iter_var :: gensym("for_iter_var");
          temp_var :: gensym("for_temp_var");
          quote({
            unquote(iter_var) := unquote(iter);
            while runtval(true), {
              unquote(temp_var) := &(unquote(iter_var)).next();
              match(unquote(temp_var),
                .Some(unquote(variable)) => unquote(body),
                .None => { break; }
              )
            }
          })
        },
        true => {
          compt_assert(false, "for macro requires a function handle with `=>`");
          quote(false)
        }

      )
    },
    true => {
      compt_assert(false, "for macro requires a function handle with `=>`");
      quote(false)
    });
};

expanded :: macro_expand(
  quote(
    for box.into_iter(), (value) => {
      printf("value %d\n", value);
    }
  )
);
