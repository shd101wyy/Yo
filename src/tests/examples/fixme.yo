/**
 * Bucket - Internal structure to store key-value pairs
 */
Bucket :: (fn(compt(K): Type, compt(V): Type) -> compt(Type))
  struct(
    key : K,
    value : V
  )
;

HashMap :: (fn(
  compt(K): Type,
  compt(V): Type,
  where(K <: (Eq(K), Hash))
) -> compt(Type))
  object(
    data : Bucket(K, V),

    new :: (fn(k : K, v : V) -> Self)({
      return Self(Bucket(K, V)(k, v)); 
    })
  )
;

main :: (fn() -> unit) {
  HashMap(i32, i32).new(3, 4);
};

export main;
