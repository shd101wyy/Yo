open import "../../../std/libc/stdio.yo";

Box :: ref struct
  value : i32,

  dispose :: ((fn(mut(self) : Self) -> unit) {
    printf("Disposed Box(%d)\n", self.value);
  })
;

Point :: struct
  x : Box,
  y : Box
;

Container :: struct
  point : Point
;

main :: (fn() -> unit) {
  x := Box(1);
  y := Box(2);
  p := Point(x, y);
  c := Container(p); // FIXME: we should call ___dup on `p` here.

  // ___drop(c);
  // ___drop(p);
  // ___drop(y);
  // ___drop(x);
};

export main;