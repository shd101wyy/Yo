open import "std/libc/stdio";

main :: (fn() -> unit) {
  // Simple test without captured variables
  async {
    task1 := async {
      printf("Task 1\n");
      return 1;
    };
    
    x := await task1;
    printf("Result: %d\n", x);
  };

  return ();
};

export main;

