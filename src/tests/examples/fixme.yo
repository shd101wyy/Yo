open import "std";
open import "std/libc/stdio.yo";

extern "Yo",
  __yo_chan_send :
    fn(forall(T: Type), ch : Chan(T), value : T) -> unit,
  __yo_chan_recv :
    fn(forall(T: Type), ch : Chan(T)) -> Option(T),
  __yo_chan_close :
    fn(forall(T: Type), ch : Chan(T)) -> unit
;

main :: (fn() -> i32) {
  ch := chan(i32, 2);

  __yo_chan_send(ch, 1);
  __yo_chan_send(ch, 2);

  printf("%d\n", __yo_chan_recv(ch).unwrap()); // 1
  printf("%d\n", __yo_chan_recv(ch).unwrap()); // 2

  return 0;
};

export main;
