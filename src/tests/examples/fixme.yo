open import "std";

main :: (fn() -> i32) {
  x := 1;
  closure := ((fn(v : i32) => i32) {
    /// y := x;
    /// {
    ///   z := x;
    ///   x := 12;
    ///   p := x;
    /// };
    x = (x + v);
    return x;
  });

  closure(1);
  closure(1);

  result := closure(2);
  return result;

