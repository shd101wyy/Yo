open import "std";

RefFunc1 ::
  (x : &(i32)) -> unit;

RefFunc2 ::
  (x : &!(i32)) -> unit;

compt_assert(__yo_are_types_compatible(RefFunc1, RefFunc2) == false);
compt_assert(__yo_are_types_compatible(RefFunc2, RefFunc1) == true);

// Test pointer type compatibility
PtrFunc1 ::
  (x : *(i32)) -> unit;

PtrFunc2 ::
  (x : *!(i32)) -> unit;

compt_assert(__yo_are_types_compatible(PtrFunc1, PtrFunc2) == false);
compt_assert(__yo_are_types_compatible(PtrFunc2, PtrFunc1) == true);
