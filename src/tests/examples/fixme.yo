open import "std";
{ printf } :: import "std/libc/stdio";

sum :: (() -> i32) {
  arr := [1, 2, 3];
  mut(result) := 0;
  for arr, (mut(elem), index) => {
    printf("Element at index %d: %d\n", index, elem);
    result = (elem + result);
  };
  return result;
};

main :: (() -> i32) {
  result := sum();
  printf("Sum of array elements: %d\n", result);
  return 0;
};

export main;