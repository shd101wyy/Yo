extern "C",
  add :
    (x : i32, y : i32) -> i32,
  sub :
    (x : i32, y : i32) -> i32,
  mul :
    (x : i32, y : i32) -> i32,
  div :
    (x : i32, y : i32) -> i32,
  eq  :
    (x : i32, y : i32) -> boolean,
  gt  :
    (x : i32, y : i32) -> boolean,
  ge  :
    (x : i32, y : i32) -> boolean
;

add_compt_i32 :: ((x : i32, @(y): i32) -> i32) 
  add(x, y);

main :: (() -> i32) {
  x := 12;
  y := add_compt_i32(x, 34);
  add_compt_i32(y, 46)
};

// `export` here is required. Otherwise no functions will be compiled.
export
  main;
