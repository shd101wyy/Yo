extern
  implicit(add):
    (x: i32, y: i32)-> i32
;

def main:
  ()-> (), {
  // contextual parameters, aka implicit parameters
  def generic_add:
    ( // define type parameters
      forall(@(T): Type), 
      x: T, y: T,
      // defining contextual parameters 
      implicit(
        @(add):
          (T, T)-> T 
      )
    )-> T,
      add(x, y)
  ;
/*
  def implicit(add2):
    (x: i32, y: i32)-> i32,
    x `add` y;
*/

  x := generic_add(1, 2); // Implicitly uses the `add2` function
  x := generic_add(true, false); // This should give error.
  // generic_add(1, 2, implicit(add2)); // Explicitly uses the `add2` function
};