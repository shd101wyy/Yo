extern
  add: ((x: i32, y: i32)-> i32);

// Default parameters
// The default value for a parameter has to be compile-time known.
Add ::
  (( @(Lhs): Type, 
    (@(Rhs): Type) ?= Lhs, 
    @(Output) ?= Lhs
  )-> @(Type))
  struct
    Self :: Lhs,
    (+): ((lhs: Lhs, rhs: Rhs)-> Output)
;

IntAdd :: Add(i32);

// _ is used as the inferred, not the default value.
// Default value is only used when the parameter is not provided.
// IntAdd :: Add(i32);
// IntAdd :: Add(i32, undefined);
// IntAdd :: Add(i32, undefined, undefined);
// BoolAdd :: Add(boolean);
// BoolAdd :: Add(boolean, undefined);
// BoolAdd :: Add(boolean, undefined, undefined);