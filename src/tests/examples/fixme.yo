open import "std/libc/stdio";

MyBox :: object(
  (*) : i32,

  dispose :: ((fn(self : Self) -> unit) {
    printf("Disposing MyBox with value: %d\n", self.(*));
  })
);

use_mybox :: (fn(own(x) : MyBox) -> unit) {
  printf("Using MyBox with value: %d\n", x.(*));
};

main :: (fn() -> unit) {
  x := MyBox(42);
  use_mybox(x);
  printf("Called use_mybox\n");
  printf("End of main\n");
};

export main;