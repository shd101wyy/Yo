GiveInt :: module(
  Self : Type,
  give_int :
    fn(self : *(Self)) -> int
);

given(BooleanGiveInt) :: GiveInt(
  Self : boolean,
  give_int :
    (self) -> 0
);

given(I32GiveInt) :: GiveInt(
  Self : i32,
  give_int :
    (self) -> 1
);

use_id :: 
  (fn(
    value : *(dyn(GiveInt))
  ) -> unit) {
  x := value.give_int();
};

