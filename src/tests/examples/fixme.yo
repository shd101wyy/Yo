Applicative :: (fn(
  compt(Wrapper1) : (fn(compt(W1) : Type) -> compt(Type))
  ) -> compt(Module))
  module(
    pure :
      fn(
        forall(A1 : Type),
        a1 : A1
      ) -> Wrapper1(A1)
  )
;

pure :: (fn(
  forall(
    A2: Type,
    Wrapper2 : (fn(compt(W2) : Type) -> compt(Type))
  ),
  a2 : A2,
  using(ApplicativeInstance : Applicative(Wrapper2))
) -> Wrapper2(A2))
  ApplicativeInstance.pure(a2)
;

Data ::
  (fn(compt(W3) : Type) -> compt(Type))
  struct(value: W3)
;

given(DataApplicative) :: Applicative(Data)
  pure :
    ((forall(A1), x) ->
      Data(A1)(x)
    )
;

