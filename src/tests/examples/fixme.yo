some_cond :: (fn() -> bool) {
  return true;
};

main :: (fn() -> unit) {
  (closure : Impl(Fn(y : i32) -> i32)) =
    cond(
      some_cond() => {
        a := 1;
        ((y) => {
          return y + a;
        })
      },
      true => {
        a := 2;
        ((y) => {
          return y + a;
        })
      }
    );
};

export main;