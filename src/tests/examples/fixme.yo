{ printf } :: import "std/libc/stdio";
Drop :: ((compt(Self): Type) -> compt(Module))
  module
    Self := Self,
    drop :
      (self: Self) -> unit
;

(compt(LinearI32) : Linear) = struct(x : i32);

LinearI32Drop :: Drop(LinearI32)(
  drop : (fn(self)-> {
    printf("Dropping LinearI32\n");
    consume(self);
  })
);

main :: (() -> i32) {
  x := LinearI32(42);
  x.drop();
  return 0;
};

export main;
