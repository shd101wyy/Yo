open import "../../../std/modules/monad";

Eff :: 
  (fn(compt(W) : Type) -> compt(Type))
  Eff(W);

extern "Yo",
  __yo_eff_map : 
    fn(
      forall(A : Type, B : Type),
      eff : Eff(A),
      f : (fn(a : A) => B)
    ) -> Eff(B)
;

EffFunctor :: Functor(Eff)
  map : 
    ((eff, f) ->
      __yo_eff_map(eff, f))
;