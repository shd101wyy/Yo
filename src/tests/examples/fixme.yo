open import "std";
open import "std/libc/stdio";

MyBox :: ref struct
  (*) : i32,

  dispose :: (fn(self : Self) -> unit) {
    printf("Disposing MyBox with value: %d\n", self.*);
  }
;

some_condition :: (fn() -> boolean) {
  return false;
};

main :: (fn() -> i32) {
  closure : (fn(v : i32) => i32);

  closure = cond(
    some_condition() => {
      x := MyBox(1);
      ((v) => {
        x.* = (x.* + v);
        return x.*;
      })
    },
    true => {
      y := MyBox(2);
      ((v) => {
        y.* = (y.* * v);
        return y.*;
      })
    }
  );

  closure(2);
  closure(3);
  result := closure(4);
  return result;
};

export main;