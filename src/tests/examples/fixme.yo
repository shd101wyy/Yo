/*
extern "C",
  add :
    (x : i32, y : i32) -> i32,
  sub :
    (x : i32, y : i32) -> i32,
  mul :
    (x : i32, y : i32) -> i32,
  div :
    (x : i32, y : i32) -> i32,
  eq  :
    (x : i32, y : i32) -> boolean,
  gt  :
    (x : i32, y : i32) -> boolean,
  ge  :
    (x : i32, y : i32) -> boolean
;
*/

SomeValue :: union
  x : i32,
  y : f64,
  z : boolean
;

main :: (() -> i32) {
  v := SomeValue(y : 3.2);
  v.x
};

// `export` here is required. Otherwise no functions will be compiled.
export
  main;
