// 2nd-class reference

main :: (() -> ()) {
  I32Ref :: &(i32);
  I32MutRef :: &!(i32);

  swap :: ((p: &!(i32), q: &!(i32)) -> ()) {
    tmp := p.*;
    p.* = q.*;
    q.* = tmp;
  };

  // Assign value that contains reference to a variable is prohibited.
  !(x) := 12;
  !(y) := 13;
  // p := &(x); // This is not allowed.
  swap(&!(x), &!(y));
};