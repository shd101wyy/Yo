open import "std/libc/stdio.yo";

say :: (fn(s : *(u8)) -> i32) {
  printf("%s\n", s);
  return 16;
};

main :: (fn() -> i32) {
  t1 := spawn say("world"); // say("world") runs in parallel thread
  t2 := spawn say("hello");
  
  // result := __yo_thread_wait(t);
  // printf("result: %d\n", result);
  // return result;

  return 0;
};

export main;