Option :: (fn(compt(T): Type) -> compt(Type))
  enum(
    None,
    Some(value: T)
  )
;

Node :: (fn(compt(T): Type) -> compt(Type))
  object(
    value : T,
    next : Option(Self)
  )
;

LinkedList :: (fn(compt(X): Type) -> compt(Type))
  object(
    head : Option(Node(X)),
    length : usize
  )
;