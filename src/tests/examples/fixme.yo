main :: (fn() -> unit) {
  ch := chan(i32);
  
  async {
    x := 1;
    ch <- (x + 2);
  };
  
  result := <-(ch);
  // printf("tag=%d\n", result.tag);
  value := result.unwrap();
  printf("value=%d\n", value);
};

export main;
