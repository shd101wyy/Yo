open import "std/libc/stdio.yo";
{ GlobalAllocator } :: import "std/allocator";
open GlobalAllocator;

MyBox :: object(
  (*) : i32,
  dispose :: ((fn(self : Self) -> unit) {
    printf("Disposing MyBox with value: %d\n", self.*);
  })
);

main :: (fn() -> unit) {
  b := MyBox(42);
  p := malloc(sizeof(MyBox));
  match(p, 
    .None => {
      printf("Memory allocation failed\n");
    },
    .Some(ptr) => {
      casted_ptr := (*(MyBox))(ptr);
      casted_ptr.* = b;
    }
  );
};

export main;