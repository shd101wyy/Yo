Applicative :: (fn(
  compt(Wrapper1) : (fn(compt(W) : Type) -> compt(Type))
  ) -> compt(Module))
  module(
    pure :
      fn(
        forall(A : Type),
        a : A
      ) -> Wrapper1(A) // - Wrapper2(A) -> SomeType
                       // - Data(A)     -> StructType
                       // Needs to unify Wrapper2 and Data
  )
;

pure :: (fn(
  forall(
    A: Type,
    Wrapper2 : (fn(compt(W) : Type) -> compt(Type))
  ),
  a : A,
  using(ApplicativeInstance : Applicative(Wrapper2))
) -> Wrapper2(A))
  ApplicativeInstance.pure(a)
;

Data ::
  (fn(compt(W) : Type) -> compt(Type))
  struct(value: W)
;

given(DataApplicative) :: Applicative(Data)
  pure :
    ((a) -> {
      A :: typeof(a);
      Data(A)(a)
    })
;

/*
test1 :: (fn() -> Data(boolean)) {
  return pure(true, using(DataApplicative));
};

test2 :: (fn() -> Data(boolean)) {
  return DataApplicative.pure(true);
};

test3 :: (fn() -> Data(boolean)) {
  (x : Data(boolean)) = pure(true, using(DataApplicative));
  return x;
};
*/

test4 :: (fn() -> Data(boolean)) {
  x := pure(true, using(DataApplicative));
  return x;
};


