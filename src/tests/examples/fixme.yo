open import "std";
{ printf } :: import "std/libc/stdio";


K :: (fn(compt(Value) : Type) -> compt(Type)) {
  ClosureType ::
    fn(value : Value) => unit;
  return ClosureType;
};

// Algebraic effects
Yield ::
  fn( i : i32, resume : K(i32)) -> unit;

some_cond :: (fn() -> boolean) true;

(compt(given(yield)) : Yield) =
  (i, resume) ->
    cond
      (i < 0) => resume(0),
      true => resume(i)
;

Color :: enum Red, Green, Blue;

extern "Yo",
  yieldColor : (fn( color : Color, resume : K(Color)) -> unit)
;

