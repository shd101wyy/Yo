// Use (...) => ... 
// with => to define a closure that captures the `move` from outer scope
open import "std";

Callback ::
  (elem: i32) => i32
;
(compt(LinearI32) : Linear) = i32;

test1 :: (() -> unit) {
  mut(x) := 1;
  cb := Callback {
    return x + elem;
  };
  result := cb(42); // cb can only be called once.
  compt_expect_error(cb(42), "Closure can only be called once");
};

test2 :: (() -> unit) {
  (x : LinearI32) = 12;
  cb := Callback { // We moved the `x` into the closure
    y := x; // `x` should be consumed here
    return elem;
  };
  compt_expect_error(
    z := x,
    "x should be already consumed when defining cb"
  ); // should give error as `x` is already consumed when defining cb.
};

test3 :: (() -> unit) {
  mut(x) := 1;
  (cb : Callback) =
    fn(elem) => {
      return x + elem;
    }
  ;
  result := cb(42); // cb can only be called once.
  compt_expect_error(cb(42), "Closure can only be called once");
};

