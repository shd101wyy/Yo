Eq :: (fn(compt(Rhs) : Type) -> compt(Module))
  module()
;

Ord :: (
  fn(
    compt(Rhs) : Type
  ) -> compt(Module))
  module(
    using(Eq) : (Self <: Eq(Rhs))
  )
;

rune :: struct(
  c : u32,

  Eq :: impl(Self, Eq(Self)(
  )),

  Ord :: impl(Self, Ord(Self)(
    Eq  : Self.Eq // FIXME: This line should be working
                   // as we just defined the `Eq` implementation above.
  ))
);