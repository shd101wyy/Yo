Id :: (fn(compt(Output) : Type)-> compt(Module))
  module
    This     :  Type,
    Output   := Output,
    (id)     :  (fn(self: Self.This)-> Self.Output)
;

Point :: struct(
  x : i32,
  y : i32,

  Id :: {
    This_ :: Self;
    Id(This_)(
      This : This_,
      id : ((self) -> self)
    )
  }
);

main :: (fn() -> unit) {
  p := Point(3, 4);
  // q := p.id();
  q := Point.Id.id(p);
};

export main;