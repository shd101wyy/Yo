open import "std/libc/stdio";
{ get_thread_id, Thread } :: import "std/thread";

main :: (fn() -> unit) {
  printf("Main thread: %zu\n", get_thread_id());
  
  // Test 1: Thread with no captures
  thread1 := Thread.spawn(() => {
    printf("Thread 1: Hello from thread %zu (no captures)\n", get_thread_id());
  });
  
  // Test 2: Thread with i32 capture
  message := 42;
  thread2 := Thread.spawn(() => {
    printf("Thread 2: Hello from thread %zu with message %d\n", get_thread_id(), message);
  });
  
  // Test 3: Thread with multiple captures
  x := 100;
  y := 200;
  thread3 := Thread.spawn(() => {
    printf("Thread 3: Hello from thread %zu with x=%d, y=%d\n", get_thread_id(), x, y);
  });
  
  printf("Main: spawned 3 threads, waiting...\n");
  
  // Wait for all threads to complete
  thread1.join();
  thread2.join();
  thread3.join();
  
  printf("Main: all threads completed\n");
  printf("Main: done\n");
};

export main;
