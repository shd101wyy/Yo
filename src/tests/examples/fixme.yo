extern
  implicit(add):
    (x: i32, y: i32)-> i32
;

// contextual parameters, aka implicit parameters
def generic_add:
  ( // define type parameters
    forall(@(T): Type), 
    x: T, y: T,
    // defining contextual parameters 
    implicit(
      @(add):
        (T, T)-> T 
    )
  )-> T,
  add(x, y)
;


def implicit(add2):
  (x: i32, y: i32)-> i32,
  x `add` y
;

// generic_add(1, 2, implicit(add2)); // Explicitly uses the `add2` function
generic_add(forall(i32), 1, 2, implicit(add2));
// generic_add(1, 2); // Ambiguous implicit parameter.

