  // Object A: referenced by temp_var_1, p1 (2 references)
  // Scope end cleanup:
  // Object A: emit 2 dup, 2 drop, so 2 - 2 = 0 drop needed
  // Total: 0 drop operations needed
};

test4 :: (fn() -> i32) {
