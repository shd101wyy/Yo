open import "std";
open import "std/collections";
open import "std/libc/stdio";

test_basic_push_and_pop :: (fn() -> unit) {
  printf("\n[Test] Basic push and pop\n");
  
  list := LinkedList(i32).new();
  
  assert(list.is_empty(), "New list should be empty");
  printf("✓ New list is empty\n");
  
  list.push_back(1.as(i32));
  list.push_back(2.as(i32));
  list.push_back(3.as(i32));
  
  assert((list.len() == (3).as(usize)), "Length should be 3");
  printf("✓ Pushed 3 elements to back\n");
  
  value := list.pop_back();
  match(value,
    .Some(v) => {
      assert((v == 3.as(i32)), "Should pop 3");
      printf("✓ Popped 3 from back\n");
    },
    .None => panic("Expected Some value")
  );
  
  assert((list.len() == (2).as(usize)), "Length should be 2");
  printf("✓ Length is 2 after pop\n");
  
  printf("✓ Basic push and pop work\n");
};

test_push_front :: (fn() -> unit) {
  printf("\n[Test] Push front\n");
  
  list := LinkedList(i32).new();
  
  list.push_front(1.as(i32));
  list.push_front(2.as(i32));
  list.push_front(3.as(i32));
  
  assert((list.len() == (3).as(usize)), "Length should be 3");
  printf("✓ Pushed 3 elements to front\n");
  
  value := list.pop_front();
  match(value,
    .Some(v) => {
      assert((v == 3.as(i32)), "Should pop 3 (last pushed to front)");
      printf("✓ Popped 3 from front\n");
    },
    .None => panic("Expected Some value")
  );
  
  value2 := list.pop_front();
  match(value2,
    .Some(v) => {
      assert((v == 2.as(i32)), "Should pop 2");
      printf("✓ Popped 2 from front\n");
    },
    .None => panic("Expected Some value")
  );
  
  printf("✓ Push front works\n");
};

test_front_and_back :: (fn() -> unit) {
  printf("\n[Test] Front and back\n");
  
  list := LinkedList(i32).new();
  
  front_empty := list.front();
  match(front_empty,
    .None => {
      printf("✓ Front of empty list is None\n");
    },
    .Some(_) => panic("Front should be None for empty list")
  );
  
  list.push_back(10.as(i32));
  list.push_back(20.as(i32));
  list.push_back(30.as(i32));
  
  front_val := list.front();
  match(front_val,
    .Some(v) => {
      assert((v == 10.as(i32)), "Front should be 10");
      printf("✓ Front is 10\n");
    },
    .None => panic("Expected Some value")
  );
  
  back_val := list.back();
  match(back_val,
    .Some(v) => {
      assert((v == 30.as(i32)), "Back should be 30");
      printf("✓ Back is 30\n");
    },
    .None => panic("Expected Some value")
  );
  
  printf("✓ Front and back work\n");
};

test_get_by_index :: (fn() -> unit) {
  printf("\n[Test] Get by index\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(10.as(i32));
  list.push_back(20.as(i32));
  list.push_back(30.as(i32));
  list.push_back(40.as(i32));
  
  val0 := list.get((0).as(usize));
  match(val0,
    .Some(v) => {
      assert((v == 10.as(i32)), "Index 0 should be 10");
      printf("✓ Index 0 is 10\n");
    },
    .None => panic("Expected Some value")
  );
  
  val2 := list.get((2).as(usize));
  match(val2,
    .Some(v) => {
      assert((v == 30.as(i32)), "Index 2 should be 30");
      printf("✓ Index 2 is 30\n");
    },
    .None => panic("Expected Some value")
  );
  
  val_out := list.get((10).as(usize));
  match(val_out,
    .None => {
      printf("✓ Out of bounds index returns None\n");
    },
    .Some(_) => panic("Out of bounds should return None")
  );
  
  printf("✓ Get by index works\n");
};

test_insert :: (fn() -> unit) {
  printf("\n[Test] Insert at index\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(10.as(i32));
  list.push_back(30.as(i32));
  
  result := list.insert((1).as(usize), 20.as(i32));
  match(result,
    .Ok(_) => {
      printf("✓ Inserted 20 at index 1\n");
    },
    .Error(_) => panic("Insert failed")
  );
  
  assert((list.len() == (3).as(usize)), "Length should be 3");
  
  val0 := list.get((0).as(usize));
  val1 := list.get((1).as(usize));
  val2 := list.get((2).as(usize));
  
  match(val0,
    .Some(v) => assert((v == 10.as(i32)), "Index 0 should be 10"),
    .None => panic("Expected value")
  );
  
  match(val1,
    .Some(v) => {
      assert((v == 20.as(i32)), "Index 1 should be 20");
      printf("✓ Index 1 is now 20\n");
    },
    .None => panic("Expected value")
  );
  
  match(val2,
    .Some(v) => assert((v == 30.as(i32)), "Index 2 should be 30"),
    .None => panic("Expected value")
  );
  
  printf("✓ Insert works\n");
};

test_remove :: (fn() -> unit) {
  printf("\n[Test] Remove at index\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(10.as(i32));
  list.push_back(20.as(i32));
  list.push_back(30.as(i32));
  list.push_back(40.as(i32));
  
  result := list.remove((1).as(usize));
  match(result,
    .Ok(v) => {
      assert((v == 20.as(i32)), "Removed value should be 20");
      printf("✓ Removed 20 from index 1\n");
    },
    .Error(_) => panic("Remove failed")
  );
  
  assert((list.len() == (3).as(usize)), "Length should be 3");
  
  val0 := list.get((0).as(usize));
  val1 := list.get((1).as(usize));
  
  match(val0,
    .Some(v) => assert((v == 10.as(i32)), "Index 0 should be 10"),
    .None => panic("Expected value")
  );
  
  match(val1,
    .Some(v) => {
      assert((v == 30.as(i32)), "Index 1 should now be 30");
      printf("✓ Index 1 is now 30\n");
    },
    .None => panic("Expected value")
  );
  
  printf("✓ Remove works\n");
};

test_clear :: (fn() -> unit) {
  printf("\n[Test] Clear\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(1.as(i32));
  list.push_back(2.as(i32));
  list.push_back(3.as(i32));
  
  assert((list.len() == (3).as(usize)), "Length should be 3");
  printf("✓ List has 3 elements\n");
  
  list.clear();
  
  assert(list.is_empty(), "List should be empty after clear");
  assert((list.len() == (0).as(usize)), "Length should be 0");
  printf("✓ List is empty after clear\n");
  
  front := list.front();
  match(front,
    .None => {
      printf("✓ Front is None after clear\n");
    },
    .Some(_) => panic("Front should be None")
  );
  
  printf("✓ Clear works\n");
};

test_contains :: (fn() -> unit) {
  printf("\n[Test] Contains\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(10.as(i32));
  list.push_back(20.as(i32));
  list.push_back(30.as(i32));
  
  has_20 := list.contains(20.as(i32), i32.Eq);
  assert(has_20, "List should contain 20");
  printf("✓ List contains 20\n");
  
  has_99 := list.contains(99.as(i32), i32.Eq);
  assert((has_99 == false), "List should not contain 99");
  printf("✓ List does not contain 99\n");
  
  printf("✓ Contains works\n");
};

test_reverse :: (fn() -> unit) {
  printf("\n[Test] Reverse\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(1.as(i32));
  list.push_back(2.as(i32));
  list.push_back(3.as(i32));
  list.push_back(4.as(i32));
  
  list.reverse();
  
  val0 := list.get((0).as(usize));
  val1 := list.get((1).as(usize));
  val2 := list.get((2).as(usize));
  val3 := list.get((3).as(usize));
  
  match(val0,
    .Some(v) => {
      assert((v == 4.as(i32)), "Index 0 should be 4 after reverse");
      printf("✓ Index 0 is 4\n");
    },
    .None => panic("Expected value")
  );
  
  match(val1,
    .Some(v) => assert((v == 3.as(i32)), "Index 1 should be 3"),
    .None => panic("Expected value")
  );
  
  match(val2,
    .Some(v) => assert((v == 2.as(i32)), "Index 2 should be 2"),
    .None => panic("Expected value")
  );
  
  match(val3,
    .Some(v) => {
      assert((v == 1.as(i32)), "Index 3 should be 1 after reverse");
      printf("✓ Index 3 is 1\n");
    },
    .None => panic("Expected value")
  );
  
  printf("✓ Reverse works\n");
};

test_mixed_operations :: (fn() -> unit) {
  printf("\n[Test] Mixed operations\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(1.as(i32));
  list.push_front(2.as(i32));
  list.push_back(3.as(i32));
  list.push_front(4.as(i32));
  
  assert((list.len() == (4).as(usize)), "Length should be 4");
  printf("✓ Mixed push operations\n");
  
  front := list.front();
  back := list.back();
  
  match(front,
    .Some(v) => {
      assert((v == 4.as(i32)), "Front should be 4");
      printf("✓ Front is 4\n");
    },
    .None => panic("Expected value")
  );
  
  match(back,
    .Some(v) => {
      assert((v == 3.as(i32)), "Back should be 3");
      printf("✓ Back is 3\n");
    },
    .None => panic("Expected value")
  );
  
  _ := list.pop_front();
  _ := list.pop_back();
  
  assert((list.len() == (2).as(usize)), "Length should be 2 after pops");
  printf("✓ Mixed pop operations\n");
  
  printf("✓ Mixed operations work\n");
};

test_empty_operations :: (fn() -> unit) {
  printf("\n[Test] Empty operations\n");
  
  list := LinkedList(i32).new();
  
  pop_empty := list.pop_front();
  match(pop_empty,
    .None => {
      printf("✓ Pop from empty list returns None\n");
    },
    .Some(_) => panic("Pop from empty should return None")
  );
  
  pop_back_empty := list.pop_back();
  match(pop_back_empty,
    .None => {
      printf("✓ Pop back from empty list returns None\n");
    },
    .Some(_) => panic("Pop back from empty should return None")
  );
  
  remove_result := list.remove((0).as(usize));
  match(remove_result,
    .Error(.EmptyList) => {
      printf("✓ Remove from empty list returns EmptyList error\n");
    },
    .Ok(_) => panic("Remove from empty should fail"),
    .Error(_) => panic("Wrong error type")
  );
  
  printf("✓ Empty operations work\n");
};

main :: (fn() -> unit) {  
  printf("=== LinkedList Tests ===\n");
  
  test_basic_push_and_pop();
  test_push_front();
  test_front_and_back();
  test_get_by_index();
  test_insert();
  test_remove();
  test_clear();
  test_contains();
  test_reverse();
  test_mixed_operations();
  test_empty_operations();
  
  printf("\n=== All LinkedList tests passed! ===\n");
  return;
};

export main;