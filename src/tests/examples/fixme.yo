Id :: module(
  id : (fn(self : Self) -> Self)
);

ImplId :: Impl(Id);

// Test with custom label
ImplIdLabeled :: Impl(MyId : Id);

test :: (fn(x : ImplId) -> ImplId) {
  y := typeof(x).Id.id(x);
  return y.id();
};

test2 :: (fn(x : ImplIdLabeled) -> ImplIdLabeled) {
  y := typeof(x).MyId.id(x);
  return y.id();
};
