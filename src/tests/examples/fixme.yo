TypeMethods :: module {
  Self :: Type;

  is_free :: ((compt(self): Self) -> compt(boolean))
    __yo_type_is_free(self)
  ;

  export
    Self,
    is_free
  ;
};

// Test enum for match expressions
(compt(Shape): Linear) = enum(
  Circle,
  Square,
  drop :: (((self: Self) -> unit)
    match(self,
      .Circle => (),
      .Square => ()
    ))
);
