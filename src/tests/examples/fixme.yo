main :: (fn() -> unit) {
  SomeModule :: impl {
    id :: (fn(x: i32)-> i32) x;
    implicit_id :: (fn(x: i32)-> i32) x;
    x :: 1;
    y :: 2;
    export id, implicit_id, x, y;
  };

  {
    // Use ... to destructure all exports
    { ... } :: SomeModule;
    v := id(3);


    Point :: struct(a: i32, b: i32);
    p :: Point 3, 4;
    { ... } :: p;
    x2 := id(a);
  };

  {
    // Use ...(given) to destructure all implicits // NOTE: "given" is no longer supported
    open SomeModule;
    
    implicit_id(3);
    id(3);
  }
};

export main;