open import "std";
{ printf } :: import "std/libc/stdio";

main :: (fn() -> i32) {
  mut(x) := 1;
  closure := Closure(FnOnce(y : i32) -> i32, _) {
    x = (x + y);
    return x;
  };
  mut(result) := closure(2);
  result = closure(3);
  printf("Result: %d\n", result);
  return result;
};

export main;