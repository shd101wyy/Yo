extern "Yo",
  __yo_ptr_cast :
    fn(forall(Source: Type), source : *(Source), compt(Target) : Type) -> Target
;

KeyValuePair :: (fn(compt(K) : Type, compt(V) : Type) -> compt(Type))
  struct(
    key : K,
    value : V
  );

ArrayList :: (fn(compt(T): Type) -> compt(Type))
  object(
    ptr : *(T),

    /**
     * Add an element to the end of the ArrayList
     */
    push :: ((fn(self: Self, ptr: *(void)) -> unit) {
      __yo_ptr_cast(ptr, *(T));
    })
  );

Map :: (fn(compt(K): Type, compt(V): Type) -> compt(Type))
  object(
    entries : ArrayList(KeyValuePair(K, V))
  );

main :: (fn() -> unit) {  
  return;
};

export main;
