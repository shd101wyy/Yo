extern
  va_list : Free,
  va_start :
    (() -> va_list),
  va_end :
    ((va : va_list) -> unit),
  va_copy :
    ((src : va_list) -> va_list),
  va_arg :
    ((va : va_list, @(T) : Type) -> T)
;

return_in_while :: ((flag: boolean) -> i32) {
  while flag, {
    cond
      flag => {
        x := 1;
        return x;
      },
      true => {
        x := 2;
      };
    return 3;
  };
};

compt_return_in_while :: ((@(flag): boolean) -> @(i32)) {
  while flag, {
    cond
      flag => {
        x :: 1;
        return x;
      },
      true => {
        x :: 2;
      }
    ;

    return 4;
  };
};

x :: compt_return_in_while(true);
y :: compt_return_in_while(false);
z :: y;
