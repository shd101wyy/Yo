Id :: module(
  where(Self <: Copy),
  id : (fn(x : Self) -> Self)
);

use_id :: (
  fn(
    compt(T) : Type, 
    x : T, 
    where(T <: Id)
  ) -> T) {
  y := x.id();
  z := (T <: Id).id(x);
  return z;
};

// compt_expect_error(
//   impl(i32, Id(
//     id : (self -> self)
//   )),
//   "i32 hasn't implemented Copy, so it cannot implement Id which requires Copy"
// );
impl(i32, Copy());
impl(i32, Id(
  id : (self -> self)
));

main :: (fn() -> unit) {
  compt_expect_error((boolean <: Id).id(true));
  compt_expect_error(a := use_id(boolean, true));
  
  x := 12.id();
  y := (i32 <: Id).id(x);
  z := use_id(i32, y);
};