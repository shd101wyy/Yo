Shape :: enum
  Circle(radius : i32),
  Rectangle(width : i32, height : i32),
  Triangle(base : i32, height : i32)
;

return_shape :: (() -> Shape)
  Shape.Rectangle(width: 10, height: 20)
;

return_shape_2 :: (() -> Shape) {
  ();
  Shape.Rectangle(width: 10, height: 20)
};


export return_shape, return_shape_2;