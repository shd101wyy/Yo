/**
 * Node - Internal structure for linked list nodes
 * Uses Box for indirection to allow recursive type
 */
Node :: (fn(compt(T): Type) -> compt(Type))
  object(
    value : T,
    next : Option(Box(Self)),
    prev : Option(Box(Self))
  )
;

/**
 * LinkedList - Doubly-linked list with O(1) operations at both ends
 */

LinkedList :: (fn(compt(T): Type) -> compt(Type))
  object(
    head : Option(Box(Node(T))),

    /**
     * Check if the list contains a value
     * O(n) time complexity
     */
    contains :: ((fn(
      self: Self, 
      using(ElementEqual) : (T <: Eq(T, T))
    ) -> boolean)
      {
        current_opt := self.head;
        
        match(current_opt,
          .None => {
            return false;
          },
          .Some(current) => {
            // cond(
            //   (ElementEqual.(==)(current.*.value, value)) => {
            //     ();
            //   },
            //   true => {
            //     current_opt = current.next;
            //   }
            // );
            current_opt = current.*.next;
          }
        );
        
        false
      }
    )
  );

export
  LinkedList
;
