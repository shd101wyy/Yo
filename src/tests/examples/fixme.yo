extern "Yo",
  Data: Linear,
  malloc  :
    fn()-> Data,
 __yo_ptr_unchecked_deref :
    fn(forall(T: Type), v : *(T)) -> T
;

PtrMethods :: impl {
  // Unchecked dereference of a pointer
  unchecked_deref :: (fn(forall(T: Type), v: *(T)) -> T)
    __yo_ptr_unchecked_deref(v)
  ;

  export unchecked_deref;
};

main :: (fn() -> unit) {
  x := malloc();
  p := *(x);
  {
    // y := p.*; // This is not allowed as p.* is linear.
    (y : Data) = p.unchecked_deref();
  };
};