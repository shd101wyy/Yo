open import "std";

(add) :: ((
          quote(arg1): Expr,
          quote(arg2): Expr,
          ...(quote(arg3))
        ) -> unquote(Expr))
  cond
    (arg3.length() == 0) =>
      quote((unquote(arg1) + unquote(arg2))),
    true =>
      quote(add((unquote(arg1) + unquote(arg2)), unquote_splicing(arg3)))
;

x :: macro_expand(quote(add(3, 4, 5, 6)));
compt_print(x);