open import "std/libc/stdio.yo";
{ GlobalAllocator } :: import "std/allocator.yo";

Id :: module(
  id : (fn(self : Self) -> Self)
);

use_id :: (fn(
  forall(T : Type),
  value : T,
  where(T <: Id)
) -> T) {
  // (T <: Id).id(value);
  return value.id();
};

impl(i32, Id(
  id : ((self) -> {
    printf("i32 value: %d\n", self);
    return self;
  })
));

impl(boolean, Id(
  id : ((self) -> {
    cond(
      self => printf("boolean value: true\n"),
      true => printf("boolean value: false\n")
    );
    return self;
  })
));

impl(Box(i32), Id(
  id : ((self) -> {
    printf("Boxed i32 value: %d\n", self.*);
    return self;
  })
));

Color :: enum(
  Red,
  Green,
  Blue
);

compt_expect_error(
  test_fn :: (fn(some_cond : boolean) -> Impl(Id)) {
    cond(
      some_cond => {
        return 12;
      },
      true => {
        return false;
      }
    );
  }
);

compt_expect_error(
  test_fn2 :: (fn(color : Color) -> Impl(Id)) {
    match(color,
      .Red => {
        return 1;
      },
      .Green => {
        return true;
      },
      .Blue => {
        return Box(i32);
      }
    );
  }
);

compt_expect_error(
  test_fn3 :: (fn(some_cond : boolean) -> Impl(Id)) {
    cond(
      some_cond => {
        {
          {
            return 12;
          };
        };
      },
      true => {
        return false;
      }
    );
  }
);
