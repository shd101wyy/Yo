main :: (fn() -> unit) {
  x := Box(i32)(42);

  i1 := Iso(Box(i32))(x);
  i2 := i1;

  // f :: Type.impls(typeof(i1), Send);

  e1 := __yo_iso_extract(i2).unwrap();
  assert(e1.* == 42);

  e2 := Iso(Box(i32)).extract(i1);
  e3 := i1.extract();
  assert(e2.is_none());
  assert(e3.is_none());
};

export main;