extern
  gt : 
    ((x: i32, y: i32) -> boolean)
;

max :: ((x: i32, y: i32) -> i32) {
  x := cond
    (x `gt` y) => {
      return x;
    },
    true => {
      return y;
    };
};

max2 :: ((x: i32, y: i32) -> i32) {
  max := 
    cond
      (x `gt` y) => {
        return x;
      },
      true => y;
  return max;
};

main :: (() -> i32) {
  return 12;
};
