Id :: module
  Self : Type,

  id : (fn(self : Self) -> Self)
;

use_id :: (fn(forall(T : Type), val : T, using(ValId) : (T <: Id)) -> T) {
  return ValId.id(val);
};

I32Id :: Id(
  Self : i32,

  id : ((self) -> {
    return self;
  })
);

main :: (fn() -> unit) {
  x := 12;
  y := use_id(x);
};

export main;