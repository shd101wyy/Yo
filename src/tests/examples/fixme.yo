open import "std/libc/stdio";

MyBox :: object(
  (*) : i32,

  dispose :: (fn(self : Self) -> unit) {
    printf("Disposing MyBox with value: %d\n", self.(*));
  }
);

// QUESTION: Should we use "own", "owned", or "owning"?
use_my_box :: (fn(own(box) : MyBox) -> unit) {
  printf("Using MyBox with value: %d\n", box.(*));

  // Expected the `box` to be disposed here.
};

main :: (fn() -> i32) {  
  box := MyBox(42);
  use_my_box(box);

  printf("Back in main.\n");
  // Expected the `box` not to be disposed here.  

  return 0;
};

export main;
