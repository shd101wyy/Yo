PrintSelf :: module(
  print_self : (fn(self : Self) -> unit)
);

use_print_self :: (fn(
  forall(T : Type),
  value : T,
  where(T <: PrintSelf)
) -> unit) {
  (T <: PrintSelf).print_self(value);
  value.print_self();
};

impl(i32, PrintSelf(
  print_self : ((self) -> {
    printf("i32 value: %d\n", self);
  })
));

impl(boolean, PrintSelf(
  print_self : ((self) -> {
    cond(
      self => printf("boolean value: true\n"),
      true => printf("boolean value: false\n")
    );
  })
));

main :: (fn() -> unit) {
  i := 42;
  t := true;
  f := false;

  use_print_self(i);
  use_print_self(t);
  use_print_self(f);
};

export main;