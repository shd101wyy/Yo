Id :: (fn(compt(Output) : Type)-> compt(Module))
  module
    Output   := Output,
    (id)     :  (fn(self: Self) -> Self.Output)
;

Point :: struct(
  x : i32,
  y : i32,

  Id :: impl(Self, Id(Self)(
    id : ((self) -> self)
  ))
);

main :: (fn() -> unit) {
  p := Point(3, 4);
  q := Point.Id.id(p);
};

export main;
