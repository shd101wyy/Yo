Result :: (fn(compt(OkType): Type, compt(ErrorType): Type) -> compt(Type))
  enum
    Ok(value: OkType),
    Err(error: ErrorType)
;

Worker :: (fn(compt(A) : Type,
              compt(B) : Type)
          -> compt(Type)) {
  return struct(
    spawn : recur(B, A),
    send : Result(A, B)  // ,
    // recv : Result(B, unit)
  );
};
