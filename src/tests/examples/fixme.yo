{ not, BooleanLogicalNot } :: import "../../../std/modules/logic.yo";

Eq ::
  (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs) -> compt(Module))
  module
    (==): (fn(lhs: Lhs, rhs: Rhs) -> boolean),

    ((!=) : (fn(lhs: Lhs, rhs: Rhs) -> boolean)) ?= 
      ((lhs, rhs) ->
        not((==)(lhs, rhs), using(BooleanLogicalNot))
      )
;

export Eq;