open import "std";
open import "std/libc/stdio.yo";

MyBox :: object
  (*) : i32,

  dispose :: ((fn(self : Self) -> unit) {
    printf("Disposing MyBox with value: %d\n", self.*);
  })
;

test :: (fn() -> unit) {
  ch := chan(MyBox); // unbuffered channel
  spawn ((fn(ch : Chan(MyBox))-> unit){
    ch.send(MyBox(16)); // blocks until the value is received
  })(ch);

  printf("%d\n", ch.recv().unwrap().*); // blocks until a value is sent
};

main :: (fn() -> i32) {
  test();
  __yo_gc_collect(); // otherwise when main finishes, we won't collect the MyBox created in the thread.
  return 0;
};

export main;
