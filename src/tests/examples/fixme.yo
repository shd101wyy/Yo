main :: (fn() -> unit) {
  x := 1;

  ClosureType :: Impl(Fn(y : i32) -> i32);
  T :: Type.to_string(ClosureType);
  closure := (ClosureType {
    x = (x + y);
    return x;
  });

  closure(1); // 2
  closure(1); // 3

  result := closure(2); // 5
  printf("Final result: %d\n", result);
};

export main;