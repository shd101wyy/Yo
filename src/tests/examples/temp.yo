  printf("Using MyBox with value: %d\n", x.(*));
};

main :: (fn() -> unit) {
  x := MyBox(42);
  use_mybox(x);
  printf("Called use_mybox\n");
  printf("End of main\n");
};
*/

main :: (fn() -> unit) {
  x := MyBox(42); // This should insert dup(temp_var) where temp_var holds the result of MyBox(42)
  y := x;  // This should insert dup(x)
  
  // x = MyBox(100);  // Reassignment - should drop old x before assigning
  // printf("x = %d, y = %d\n", x.(*), y.(*));
  // At end of scope: drop(x), drop(y)
};

