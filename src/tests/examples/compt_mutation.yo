open import "std";

// Value semantics
/// struct
{
  Point :: struct(
    x : i32,
    y : i32
  );

  mut(p1) :: Point(3, 4);
  p2 :: p1;
  p1.x = 5;

  // compt_print("p1 ", p1);
  // compt_print("p2 ", p2);
  compt_assert(p1.x == 5);
  compt_assert(p2.x == 3);
};

/// array
{
  mut(arr1) :: [1, 2, 3];
  arr2 :: arr1;
  index :: 0;
  arr1(index) = 4;
  // compt_print("arr1 ", arr1);
  // compt_print("arr2 ", arr2);
  compt_assert(arr1(0) == 4);
  compt_assert(arr1(1) == 2);
  compt_assert(arr1(2) == 3);
  compt_assert(arr2(0) == 1);
};

/// tuple
{
  mut(t1) :: (1, 2.0);
  mut(t2) :: t1;
  t1.0 = 4;

  // compt_print("t1 ", t1);
  // compt_print("t2 ", t2);
  compt_assert(t1.0 == 4);
  compt_assert(t2.0 == 1);
};

/// enum
{
  Shape :: enum(
    Circle(radius : f32),
    Rectangle(width : f32, height : f32)
  );

  mut(c1) :: Shape.Circle(5.0);
  c2 :: c1;
  c1.radius = 10.0;

  compt_print("c1 ", c1);
  compt_print("c2 ", c2);

  compt_assert(c1.radius == 10.0);
  compt_assert(c2.radius == 5.0); // c2 should remain unchanged with value semantics
};

// Refernce semantics
/// struct
{
  Point :: ref struct( // Point now uses reference semantics
    x : i32,
    y : i32
  );

  mut(p1) :: Point(3, 4);
  p2 :: p1; // p1 and p2 point to the same object
  p1.x = 5;

  // compt_print("p1 ", p1);
  // compt_print("p2 ", p2);

  compt_assert(p1.x == 5);
  compt_assert(p2.x == 5); // Both should be 5 with reference semantics
};

{
  Shape :: ref enum(
    Circle(radius : f32),
    Rectangle(width : f32, height : f32)
  );

  mut(c1) :: Shape.Circle(5.0);
  c2 :: c1; // c1 and c2 point to the same object
  c1.radius = 10.0;

  // compt_print("c1 ", c1);
  // compt_print("c2 ", c2);

  compt_assert(c1.radius == 10.0);
  compt_assert(c2.radius == 10.0); // Both should be 10.0 with reference semantics
};
