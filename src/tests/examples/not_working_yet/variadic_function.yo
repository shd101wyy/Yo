open import "std";

// c11 style variadic function
add_va_c11 :: ((count : c_int, ...) -> c_int) {
  args := c_var_start(count); // args : c_va_list Free
  mut(result) := 0;
  mut(i) := 0;
  while i < count, i = (i + 1), {
    result = (result + c_var_arg(args, i32));
  };
  c_var_end(args);
  return result;
};

// c23 style variadic function
add_va_c23 :: ((...) -> c_int) {
  args := c_var_start(); // no need to pass count
  c_int count = c_var_arg(args, c_int);
  mut(result) := 0;
  mut(i) := 0;
  while i < count, i = (i + 1), {
    result = (result + c_var_arg(args, i32));
  };
  c_var_end(args);
  return result;
};

// C variadic function (safe) version
add_va_c :: ((...(args) : VarList) -> c_int) {
  // ...(arg_name) will automatically initialize "VarList" as "arg_name" for you
  // args has type "VarList" which is Linear
  c_int count = args.length(); // Get the count of variadic arguments
  mut(result) := 0;
  mut(i) := 0;
  while i < count, i = (i + 1), {
    result = (result + args.arg(i32)); // Pop the variadic argument and set it to i32
  };
  // RAII clean up the "args";
  return result;
};

// Yo variadic function
add_va_yo :: ((forall(@(count): usize), ...(args) : Array(c_int, count)) -> c_int) {
  mut(result) := 0;
  mut(i) := 0;
  while i < count, i = (i + 1), {
    result = (result + args(i));
  };
  // RAII clean up the "args";
  return result;
};


main :: (() -> unit) {
  x1 := add_va_c11(3, 1, 2, 3); // 6
  x2 := add_va_c23(3, 1, 2, 3); // 9
  x3 := add_va_c(1, 2, 3);      // 6
  x4 := add_va_yo(3, 1, 2, 3);  // 9
};