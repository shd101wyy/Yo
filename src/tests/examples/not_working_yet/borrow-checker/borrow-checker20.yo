extern "Yo",
  Data   : Linear,
  malloc :
    fn()-> Data
;



test :: (fn() -> unit) {
  name := malloc();
  arr := [name,]; // 'name' is consumed in the array 'arr'.
  
  compt_expect_error(
    borrow &(name), name_ref-> {
      ();
    },
    "error: 'name' is already consumed in the array 'arr'"
  );

  drop(arr);
};

test2 :: (fn() -> unit) {
  name := malloc();
  tup := (name,);

  compt_expect_error(
    borrow &(name), name_ref-> {
      ();
    },
    "error: 'name' is already consumed in the array 'arr'"
  );

  drop(tup);
};