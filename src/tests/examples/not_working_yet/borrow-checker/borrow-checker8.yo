extern "Yo",
  Data: Type,
  malloc  :
    fn()-> Data
;

test :: (fn() -> unit) {
  x := malloc();
  borrow &(x), x_ref => {
    // compt_expect_error(
    //   y := x_ref.*,
    //   "error: x_ref.* is linear, which cannot be consumed."
    // );
    compt_expect_error(
      consume(x),
      "error: x is borrowed."
    );
  };
  drop(x); // allowed
};