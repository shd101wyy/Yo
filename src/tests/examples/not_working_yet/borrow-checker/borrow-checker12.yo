extern "Yo",
  Data   : Linear,
  malloc :
    fn()-> Data
;

test :: (fn(flag: boolean)-> unit) {
  x := malloc();
  cond
    flag => drop(x),
    true => drop(x)
  ;
  compt_expect_error(
    drop(x), "error: 'x' is already consumed."
  );
};

compt_expect_error(
  test2 :: ((flag: boolean)-> unit) {
    x := malloc();
    cond
      flag => {
        drop(x);
        ()
      },
      true => ()
    ;
  },
  "error: 'x' is only consumed in the first branch, but not all branches."
);