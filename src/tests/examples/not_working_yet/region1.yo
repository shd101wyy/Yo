open import "std";

{
  r1 :: region();
  r2 :: region();
  compt_assert(__yo_region_eq(r1, r2)); // r1 and r2 are the same region

  {
    r3 :: region();
    compt_assert(__yo_region_lt(r3, r1)); // r1 lives longer than r3
    compt_assert(__yo_region_lte(r3, r1)); // r1 lives longer than r3
    compt_assert(__yo_region_gt(r1, r3)); // r1 lives longer than r3
    compt_assert(__yo_region_gte(r1, r3)); // r1 lives longer than r3
  };
};