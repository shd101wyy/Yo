// with => to define a closure that captures the `move` from outer scope
open import "std";

some_condition :: (fn() -> boolean) true;

(compt(LinearI32) : Linear) = i32;

// FnMove, FnMut, Fn can only be used in a Closure context
// They cannot be used as standalone types
// This should be invalid - standalone FnMove
compt_expect_error(
  invalid_fn_once :: (FnMove(val: i32) -> i32)
);

// This should be invalid - standalone FnMut  
compt_expect_error(
  invalid_fn_mut :: (FnMut(val: i32) -> i32)
);

// This should be invalid - standalone Fn
compt_expect_error(
  invalid_fn :: (Fn(val: i32) -> i32)
);


plus_fn_once ::
  (fn(forall(F : Type),
    callback : Closure(FnMove(elem : i32) -> i32, F)
  ) -> i32) {
  return callback(42); // callback can only be called once
};

plus_fn_mut ::
  (fn(forall(F : Type),
    mut(callback) : Closure(FnMut(elem : i32) -> i32, F)
  ) -> i32) {
  callback(42);
  return callback(42); // callback can be called multiple times, but must be mutable
};

plus_fn ::
  (fn(forall(F : Type),
    callback : Closure(Fn(elem : i32) -> i32, F)
  ) -> i32) {
  callback(42);
  return callback(42); // callback can be called multiple times, but cannot mutate captured variables
};

test1 :: (fn() -> unit) {
  mut(counter) := 0;
  (x : LinearI32) = 12;
  plus_fn_once((elem)=> {
    y := x; // `x` should be consumed here
    counter = (counter + elem);
    return counter;
  });
  compt_expect_error(z := x, "x should be already consumed when defining the closure");
  return (); // Let's explicit return unit value () here
};

test2 :: (fn() -> unit) {
  mut(counter) := 0;
  plus_fn_mut((elem)=>> {
    counter = (counter + elem);
    return counter;
  });
  return ();
};

test3 :: (fn() -> unit) {
  counter := 0;
  plus_fn((elem)=>> {
    // Cannot mutate captured variables in Fn closure
    // So we just return the sum without modifying counter
    return counter + elem;
  });
  return ();
};

// Test that should fail: Fn closure trying to mutate captured variable
compt_expect_error(
  test_fn_mutation_error :: (fn() -> unit) {
    mut(counter) := 0;
    plus_fn((elem)=>> {
      counter = (counter + elem); // This should fail - Fn cannot mutate
      return counter;
    });
    return ();
  }
);


test4 :: (fn() -> unit) {
  mut(counter) := 0;
  closure : (Closure(FnMove(elem : i32) -> i32, _));
  closure = ((elem) => {
    counter = (counter + elem);
    return counter;
  });
};

test4_1 :: (fn() -> unit) {
  mut(counter) := 0;
  closure := the(
    Closure(FnMove(elem : i32) -> i32, _),
    (elem) => {
      counter = (counter + elem);
      return counter;
    });
};

test5 :: (fn() -> unit) {
  mut(counter) := 0;
  mut(closure) : (Closure(FnMove(elem : i32) -> i32, _));
  closure = ((elem) => {
    counter = (counter + elem);
    return counter;
  });
  
  // This should fail - trying to assign closure with different capture type
  compt_expect_error(
    {
      mut(different_var) := 42;
      closure = ((elem) => {
        different_var = (different_var + elem);
        return different_var;
      });
    }
  );
};


test6 :: (fn() -> unit) {
  mut(counter1) := 0;
  mut(counter2) := 0;
  
  // This should fail because the two branches create closures with different capture types
  compt_expect_error(
    {
      mut(closure) : (Closure(FnMove(elem : i32) -> i32, _));
      cond(
        some_condition() => {
          closure = ((elem) => {
            counter1 = (counter1 + elem);
            return counter1;
          });
        },
        true => {
          closure = ((elem) => {
            counter2 = (counter2 + elem);
            return counter2;
          });
        }
      );
    }
  );
};


test7 :: (fn() -> unit) {
  mut(counter) := 0;
  
  // This should fail because the two branches create closures with different nominal capture types
  // Even though both capture the same variable, each creates a new StructType with different identity
  compt_expect_error(
    {
      mut(closure) : (Closure(FnMut(elem : i32) -> i32, _));
      
      cond(
        some_condition() => {
          closure = ((elem) =>> {
            counter = (counter + elem);
            return counter;
          });
        },
        true => {
          closure = ((elem) =>> {
            counter = (counter * elem);
            return counter;
          });
        }
      );
    }
  );
};

// Test explicit struct capture type should also fail for FnMut - contains references
compt_expect_error(
  test7_1 :: (fn() -> unit) {
    mut(counter) := 0;
    
    // This should fail - even with explicit struct, FnMut closures contain references
    Capture :: struct(counter : i32);
      
    mut(closure) : (Closure(FnMut(elem : i32) -> i32, Capture));
    
    cond(
      some_condition() => {
        closure = (fn(elem) =>> {
          counter = (counter + elem);
          return counter;
        });
      },
      true => {
        closure = (fn(elem) =>> {
          counter = (counter * elem);
          return counter;
        });
      }
    );
  }
);

// Additional tests using the new Closure syntax (migrated from closure2.yo)

// Test FnMut closure assignment should fail - contains references
compt_expect_error(
  test8 :: (fn() -> unit) {
    mut(counter) := 0;
    
    // This should fail - FnMut closures contain references and cannot be assigned to variables
    mut(accumulator) : (Closure(FnMut(elem : i32) -> i32, _));
    accumulator = (fn(elem) =>> {
      counter = (counter + elem);
      return counter;
    });
  }
);

// Test Fn closure assignment should fail - contains references  
compt_expect_error(
  test9 :: (fn() -> unit) {
    base := 100;
    
    // This should fail - Fn closures contain references and cannot be assigned to variables
    calculator : (Closure(Fn(elem : i32) -> i32, _));
    calculator = (fn(elem) =>> {
      return base + elem; // Only reads from captured variables, no mutation
    });
  }
);

// Test Fn closure with multiple captured variables should fail - contains references
compt_expect_error(
  test10 :: (fn() -> unit) {
    multiplier := 3;
    constant := 42;
    
    // This should fail - Fn closures contain references and cannot be assigned to variables
    complex_calc : (Closure(Fn(elem : i32) -> i32, _));
    complex_calc = (fn(elem) =>> {
      return (multiplier * elem) + constant; // Reads from both captured variables
    });
  }
);

// Test FnMut closure with multiple captured variables should fail - contains references
compt_expect_error(
  test11 :: (fn() -> unit) {
    mut(values) := [0, 0, 0];
    mut(index) := 0.as(usize);
    
    // This should fail - FnMut closures contain references and cannot be assigned to variables
    store_fn : (Closure(FnMut(elem : i32) -> i32, _));
    store_fn = (fn(elem) =>> {
      values(index) = elem;
      index = (index + 1.as(usize));
      return elem;
    });
  }
);

// Test that Fn closures cannot modify captured variables (should fail)
compt_expect_error(
  test_fn_cannot_modify :: (fn() -> unit) {
    mut(counter) := 0;
    readonly_fn : (Closure(Fn(elem : i32) -> i32, _));
    readonly_fn = (fn(elem) =>> {
      counter = (counter + 1); // This should fail - Fn cannot mutate
      return elem;
    });
  }
);


// Test mixed capture scenarios - should fail because FnMut contains references
compt_expect_error(
  test12 :: (fn() -> unit) {
    mut(mutable_var) := 10;
    immutable_var := 5;
    
    // This should fail - FnMut closures contain references and cannot be assigned to variables
    mixed_fn : (Closure(FnMut(elem : i32) -> i32, _));
    mixed_fn = (fn(elem) =>> {
      mutable_var = (mutable_var + immutable_var); // Read immutable, write mutable
      return mutable_var + elem;
    });
  }
);

// Test FnMove basic functionality
test13 :: (fn() -> unit) {
  mut(counter) := 0;
  (x : LinearI32) = 12;
  
  // FnMove can mutate captured variables
  once_fn : (Closure(FnMove(elem : i32) -> i32, _));
  once_fn = ((elem) => {
    counter = (counter + elem);
    y := x; // `x` should be consumed here
    return counter;
  });
  
  result := once_fn(42); // Can be called once
  compt_expect_error(z := x);
  // Note: In a full implementation, once_fn should not be callable again
};

// Additional comprehensive test cases for closure semantics

// Test FnMove with linear value consumption - should work
test14 :: (fn() -> unit) {
  mut(counter) := 0;
  (linear_val : LinearI32) = 100;
  
  plus_fn_once((elem) => {
    final_val := linear_val; // FnMove can consume linear values
    counter = (counter + (elem + final_val));
    return counter;
  });
  
  // linear_val should be consumed
  compt_expect_error(unused := linear_val);
};

// Test that FnMut/Fn cannot consume linear values from outer scope
compt_expect_error(
  test15_fnmut_linear :: (fn() -> unit) {
    (linear_val : LinearI32) = 100;
    
    plus_fn_mut(fn(elem) =>> {
      consumed := linear_val; // This should fail - FnMut cannot consume linear values
      return elem;
    });
  }
);

compt_expect_error(
  test15_fn_linear :: (fn() -> unit) {
    (linear_val : LinearI32) = 100;
    
    plus_fn(fn(elem) =>> {
      consumed := linear_val; // This should fail - Fn cannot consume linear values
      return elem;
    });
  }
);

// Test FnMove consuming multiple linear values
test16 :: (fn() -> unit) {
  (linear1 : LinearI32) = 50;
  (linear2 : LinearI32) = 75;
  
  plus_fn_once((elem) => {
    val1 := linear1; // Consume first linear value
    val2 := linear2; // Consume second linear value
    return (elem + val1) + val2;
  });
  
  // Both linear values should be consumed
  compt_expect_error(unused1 := linear1);
  compt_expect_error(unused2 := linear2);
};

// Test closure parameter passing - FnMove should work when used directly with existing functions
test17 :: (fn() -> unit) {
  mut(state) := 0;
  
  // Use the existing plus_fn_once function
  result := plus_fn_once((val) => {
    state = (state + val);
    return state;
  });
};

// Test that FnMut/Fn closures work when passed directly to functions (no assignment)
test18_fnmut_direct :: (fn() -> unit) {
  mut(state) := 0;
  
  // This should work - direct function call, no assignment
  result := plus_fn_mut((val) =>> {
    state = (state + val);
    return state;
  });
};

test18_fn_direct :: (fn() -> unit) {
  state := 100;
  
  // This should work - direct function call, no assignment
  result := plus_fn((val) =>> {
    return state + val;
  });
};

// Test nested closures - FnMove containing FnMove should work
test19 :: (fn() -> unit) {
  mut(outer_state) := 0;
  (linear_outer : LinearI32) = 30;
  
  outer_closure : (Closure(FnMove(x : i32) -> i32, _));
  outer_closure = ((x) => {
    mut(inner_state) := 10;
    (linear_inner : LinearI32) = linear_outer; // Consume outer linear value
    
    inner_closure : (Closure(FnMove(y : i32) -> i32, _));
    inner_closure = ((y) => {
      outer_state = (outer_state + x);
      inner_state = (inner_state + y);
      final_linear := linear_inner; // Consume inner linear value
      return (outer_state + inner_state) + final_linear;
    });
    
    return inner_closure(20);
  });
  
  result := outer_closure(5);
};

// Test closure kind inference with different capture patterns
test20 :: (fn() -> unit) {
  immutable_val := 100;
  mut(mutable_val) := 200;
  (linear_val : LinearI32) = 300;
  
  // FnMove: can read immutable, mutate mutable, and consume linear
  once_closure : (Closure(FnMove(x : i32) -> i32, _));
  once_closure = ((x) => {
    consumed := linear_val; // Consume linear
    mutable_val = (mutable_val + x); // Mutate mutable
    return (immutable_val + mutable_val) + consumed; // Read immutable
  });
  
  result := once_closure(50);
  compt_expect_error(unused := linear_val); // Should be consumed
};

// Test error cases for closure kind mismatches
compt_expect_error(
  test21_fn_write :: (fn() -> unit) {
    mut(state) := 0;
    
    plus_fn(fn(elem) =>> {
      state = (state + elem); // This should fail - Fn cannot write to captured variables
      return state;
    });
  }
);

compt_expect_error(
  test21_fnmut_consume :: (fn() -> unit) {
    (linear_val : LinearI32) = 100;
    
    plus_fn_mut(fn(elem) =>> {
      consumed := linear_val; // This should fail - FnMut cannot consume linear values
      return elem + consumed;
    });
  }
);

// Test that FnMove assignments work correctly (no references)
test22 :: (fn() -> unit) {
  mut(accumulator) := 0;
  
  // This should work - FnMove doesn't contain references
  once_fn : (Closure(FnMove(val : i32) -> i32, _));
  once_fn = ((val) => {
    accumulator = (accumulator + val);
    return accumulator;
  });
  
  result := once_fn(25);
};

// Test explicit struct capture with FnMove (should work)
test23 :: (fn() -> unit) {
  mut(counter) := 0;
  
  CounterCapture :: struct(counter : i32);
  
  // This should work - FnMove with explicit struct capture doesn't contain references
  counter_fn : (Closure(FnMove(val : i32) -> i32, CounterCapture));
  counter_fn = ((val) => {
    counter = (counter + val);
    return counter;
  });
  
  result := counter_fn(15);
};

// Test closure capture validation with explicit struct
compt_expect_error(
  test24_struct_mismatch :: (fn() -> unit) {
    mut(counter) := 0;
    mut(other_var) := 10;
    
    CounterCapture :: struct(counter : i32);
    
    // This should fail - closure captures variables that don't match the struct
    mismatched_fn : (Closure(FnMove(val : i32) -> i32, CounterCapture));
    mismatched_fn = (fn(val) => {
      other_var = (other_var + val); // Captures other_var, but struct only has counter
      return other_var;
    });
  }
);

// Test multiple variable capture with proper struct definition
test25 :: (fn() -> unit) {
  mut(counter) := 0;
  mut(multiplier) := 2;
  
  MultiCapture :: struct(counter : i32, multiplier : i32);
  
  // This should work - captures match the struct definition
  multi_fn : (Closure(FnMove(val : i32) -> i32, MultiCapture));
  multi_fn = ((val) => {
    counter = (counter + val);
    multiplier = (multiplier * 2);
    return counter * multiplier;
  });
  
  result := multi_fn(5);
};
