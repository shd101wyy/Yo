

foreach_fn_mut ::
  (fn(forall(
      F : Type, 
      size : usize
    ),
    arr : Array(i32, size),
    callback : Closure(FnMut(value: &(i32)) -> unit, F)
  ) -> unit) {
  i := usize(0);
  while (i < size), {
    callback(&(arr(i)));
    i = (i + usize(1));
  };
};

test1 :: (fn() -> unit) {
  arr := [1, 2, 3, 4, 5];
  sum := 0;

  // FnMut `sum`
  foreach_fn_mut(arr, (value) =>> {
    sum = (sum + value.*);
  });

  // Fn `sum`
  foreach_fn_mut(arr, (value) =>> {
    temp := sum;
    temp2 := value.*;
  });
};