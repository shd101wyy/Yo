/**
 *
 * All the compt functions in Yo language memorize their results.
 * To call a function without memorization, use the "no_memo" function.
 *
 */

Point :: ((@(T): Type)-> @(Type))
  struct(x: T, y: T)
;

PointI32 :: Point(i32);
PointI32_2 :: Point(i32);
// The PointI32 and PointI32_2 are the same, due to the memorization of the compt function call.

PointI32_3 :: no_memo(Point)(i32); // This will disable the memorization for this call.