open import "std";
{ printf } :: import "std/libc/stdio";

// Algebraic effects
Yield ::
  eff( i : i32 ) -> boolean;

example :: (fn(
  using(yield) : Yield
  ) -> unit) {
  produce := true;
  n := 0;
  while produce, {
    produce = yield(n);
    n = (n + 1);
  };
  printf("done\n");
};

main :: (fn() -> unit) {
  (compt(yield) : Yield) =
    (i, resume) -> {
      printf("yielded %d\n", i);
      resume(i <= 2);  // resume has type fn( boolean )=> unit
                       // `unit` comes from the return type of `main`.

      // The `resume` is one-shot delimited continuation.
      // So it can only be called once.
      compt_expect_error(resume(true));
    }
  ;
  flag := yield(0);

  test :: (fn() -> unit) {
    compt_expect_error(yield(3)); // Calling `yield` here should not be allowed.
  };

  example(yield);
};
