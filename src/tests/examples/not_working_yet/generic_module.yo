def Id:
  (compt(T): Type)-> compt(Type),
  module
    (Self: Type) == T,
    id:
      (x: Self)-> Self
;

I32Id2 :: Id(i32)
  id:
    fn(x) -> x;

def Point:
  (compt(T): Type)-> compt(Type),
  struct
    x: T,
    y: T
;

def IdPoint:
  (forall(compt(T): Type), using(compt(I): Id(T))) -> compt(Id(Point(T))),
  Id(Point(T))
    id:
      fn(p)->
        Point(T)(p.x, p.y)
;


