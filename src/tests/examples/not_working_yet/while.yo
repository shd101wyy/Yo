open import "std";

extern "Yo",
  (lt) :
    (x: i32, y: i32)-> boolean
;

factorial :: ((x : i32) -> i32) {
  mut(x) := x;
  mut(result) := 1;
  while x `lt` 0, x = (x - 1), {
    result = (result * x);
  };
  result
};

factorial2 :: ((x : i32) -> i32) {
  mut(x) := x;
  mut(result) := 1;
  while x `lt` 0, {
    result = (result * x);
    x = (x - 1);
  };
  result
};

factorial3 :: ((x : i32) -> i32) {
  mut(x) := x;
  mut(result) := 1;
  while true, {
    cond 
      (x == 0) => {
        break;
      },
      true => {
        result = (result * x);
        x = (x - 1);
      }
    ;
  };
  result
};