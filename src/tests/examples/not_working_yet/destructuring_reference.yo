Data :: struct(val : &(i32));

test1 :: (fn(d : Data) -> Data) {
   return d;
};

test2 :: (fn(d : Data) -> Data) {
  { val } := d;
  compt_expect_error(
    test1(d),
    "`d` cannot be used after destructuring, even though `d` is Free type."
  );
  return Data(val);
};


compt_expect_error(
  test3 :: (fn() -> Data) {
    x := 12;
    return Data(val : &(x));
  }
);

test4 :: (fn() -> unit) {
  x := 12;
  borrow Data(val : &(x)), d => {
    compt_expect_error(
      y := x,
      "cannot use `x` after it has been borrowed"
    );

    { val } := d;
    compt_expect_error(
      test1(d),
      "`d` cannot be used after destructuring, even though `d` is Free type."
    );
    val
  };
};
