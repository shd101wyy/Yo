// The Rc in Yo tries to use the Perceus garbage collection algorithm.  
// NOTE: It doesn't prevent the circular references, so you should be careful with it.
main :: (()-> unit) {
  // Use $ to create a special Rc type:
  SomeType :: $(String);
  // ^ It will convert any Linear type to a Free type.
  // The $ also implements the "copy" and "drop" methods for the type.
  // The "copy" method will increase the reference count.
  // The "drop" method will decrease the reference count.
  // They are automatically called when the value is copied or dropped.

  (x: SomeType) = $(String.from("Hello, world!"));
  y = x; // Increase the reference count.
  z = x; // Increase the reference count again.

  // The reference counter works automatically.
  // Yo also uses the compile-time reference counting to try to eliminate
  // unnecessary calculations on reference counter.  
  ()
};