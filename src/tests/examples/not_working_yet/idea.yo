{
  // import everything
  { ... } :: import "module";

  // import the rest
  { x : another_x, ... } :: import "module";

  // might not support.
  // import the rest as another name.
  { x : another_x, ... : another_module } :: import "module";

  // import everything, exclude
  { ...(exclude: (x, y)) } :: import "module"

  // import only the implicits
  { ...(given) } :: import "module";

  // import only the non-implicits
  { ...(not(given)) } :: import "module";
};

// with
{
  twice :: ((f: (() -> unit)) -> unit ) {
    f();
    f();
  };
  test_twice :: (() -> unit) {
    twice(() -> 
      twice(()-> {
        print("Hello, world!");
      })
    )
  };
  test_with1 :: (() -> unit) {
    with twice();
    with twice();
    println("hi")
  };

  // Translation
  // - with f(e1, ..., eN) <body>
  // =>
  // - f(e1, ..., eN, fn() -> <body>)
  //
  // Moreover
  // with x <- f(e1, ..., eN) <body>
  // =>
  // f(e1, ..., eN, fn(x) -> <body>)

  test_with2 :: (() -> unit) {
    with x <- list(1, 10).foreach();
    println(x);
  };
}

// Update a struct value
Person :: struct
  age : int,
  name: String
;
brian := Person(30, "Brian");
/// Clone a struct value by calling it.
jane := assoc(&(brian), age: 25);
/// is the same as
jane := Person(
  age: 25,
  name: &(brian.name).clone()
);

// $ will be used as immutable reference counting.
// Let's favor the persistent data structure.

// SICP
{
  { Atom, cons, car, cdr } :: import "sicp"; // import the Atom enum from "sicp" module
  x := $(cons($(Atom.I32(1)), $(Atom.I32(2)))); // x : $(Cons($(Atom)));
  car_x := car(x); // first_x : $(Atom.I32(1));
  cdr_x := cdr(x); // second_x : $(Atom.I32(2));
};

// Let's use Reference Counting + Cycle Detection by default.
{
  // struct type will automatically use reference counting.
  Person :: struct
    age : int,
    name: String

    // _rc : usize // implicitly added for reference counting
  ;

  x := Person(30, "Brian"); // x : Person
  
  y := x; // Moved x; x is consumed.
  z := y.dup(); // z : Person; y is still valid.
                // Now both x and y point to the same Person instance.

  // We still keep the reference as second class.
};