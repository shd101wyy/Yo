// Pre/Post conditions example
add :: (fn(compt(x) : i32, compt(y) : i32) -> 
  (compt(ret) : i32) `require` // pre-condition
  compt_assert(x > 0) `ensure` // post-condition
  compt_assert(ret < 100)
)
{
  return x + y;
};

// Remove Linear type and reference type
// Remove RAII
// Use RC by default? Use type system to help with the cycle detection.

// value/reference struct/enum/union.
Point :: struct(x : i32, y : i32); // value struct, which is a value type.
p := Point(3, 4); // p : Point
p2 := p; // copy p to p2 using value semantics.
p.x = 6;
// p == Point(6, 4);
// p2 == Point(3, 4); // p2 is a copy of p, not an alias.

Point :: struct(x : i32, y : i32); // reference struct, which is a reference type and will be GCed.
p := Point(3, 4); // p : Point;
p2 := p; // p2 is an alias of p. Reference counter incremented.
p3 := p.clone(); // p3 is a new value, but p and p3 are the same type.

p.x = 6;
// p == Point(6, 4);
// p2 == Point(6, 4); // p2 is an alias of p

// introduce the `dup` function, which only works on reference types.

// Let's keep pointer type, but remove reference type.
// Use &(x), &!(x) to create immutable and mutable pointers.

// With GC root.
// If the type might form cycle, then we add it to the GC root and reference counting it.
// If the type cannot form cycle, then we only reference counting it.
// The reference counter follows Perceus. < 0 means atomic, > 0 means non-atomic.

// So now we only have one type of closure.
(() => i32); // which accepts a GCed `struct`.

// so we keep the Linear type and 2nd class reference type.
// No we have a new concept: Unique
// gc value has the following automatically implemented methods:
// - dup() - duplicate the value, return a new value with the same content.
// - to_unique (or ^) - convert the value to an owned value, which requires to be the single owner.
// - try_unique - convert the value to an owned value, which requires to be the single owner, but returns an error if the value is not unique.

// unique value can be converted back to gc value
// - to_gc - convert the value to a gc value, which can be shared with other owners.

// Algebraic Effects
/// With `resume`.
Yield ::
  ctl( i : i32) -> boolean // pretty much a syntax sugar for fn(forall(compt(Abort): Type) i : i32, resume : (fn() => boolean)) -> Abort;
;
traverse :: (fn(xs : List(int), using(yield: Yield)) -> unit)
  match(xs,
    .Cond => {
      { x, xx } := xs;
      if yield(x), then: traverse(xx), else: ()
    },
    .Nil => ()
  )
;

print_elems :: (fn() -> unit) {
  (given(yield) : Yield) =
    ( i )-> {
      println("yielded" ++ i.show());
      resume(i <= 2);
    };
  traverse(List(1, 2, 3, 4), using(yield));
};

/// Abort
Raise ::
  ctl(forall(compt(T) : Type), msg : String) -> T
;

safe_divide :: (fn(x : i32, y : i32, using(raise: Raise)) -> i32)
  if y == 0,
    then: raise("Division by zero"),
    else: (x / y)
;

raise_const :: (fn() -> i32) {
  (given(raise) : Raise) =
    (msg)-> 42; // Abort with 42, which matches the return type of `raise_const`.
  8 + safe_divide(1, 0, using(raise))
};

/// Polymorphic effects
map : 
  fn(forall(compt(a) : Type, 
            ...(e)),
    xs : List(a),
    f : (fn(x : a, using(...(e))) -> b),
    using(...(e))
  ) -> List(b);

