// `is` function

flag := (x `is` .Some(value : i32));
flag := (x `is` .Some);

---

// New idea about Rc, Copy & Send.
forall(T := Impl(Copy, Send)) // T is Type that implements Copy and Send modules.

MyStruct :: struct(
  field1 : i32,
  field2 : boolean,

  Copy :: impl(Self, Copy()), // MyStruct is Copyable.
  Send :: impl(Self, Send())   // MyStruct is Sendable.
  // QUESTION: We should automatically derive the `Copy` and `Send` impls here?
);

// All the value types (i32, struct, etc) are Copy(able) by default.  
// All the Rc types (object, closure, dyn, future) are not Copy(able) by default, so they have move semantics.  

x := box(1); // x : Box(i32), Sendable, Move-only.
y := x;      // x is consumed, cannot be used anymore.
p := &(y);   // y is consumed, cannot be used anymore.
             // p : *(Box(i32)), Copyable, but not Sendable.
             // All pointer types are Copyable but not Sendable.
p2 := p;     // p is Copyed, can be used again.
q := ^(p);   // ^ operator takes a pointer value and returns an Option value.
             // p is consumed.
             // q : Option(Box(i32)). Sendable, Move-only.
             // because Box(i32) is Sendable and Move-only.
x2 := q.unwrap(); // x2 : Box(i32) if RC is 1, otherwise panic.

// Change to closure & dyn & future types
forall(T := Impl(Fn(i32) -> i32, Send)) // T is SomeType that implements Fn(i32) -> i32 and Send modules.
f1 : Impl(Fn(i32) -> i32, Send)       // Fn by default is Copyable and can be called multiple times.
f2 : Impl(FnOnce(i32) -> i32, Send)   // FnOnce is Move-only and can be called only once.
o : Dyn(Bark, Send)
async_fn : (fn() -> Impl(Future(i32)));
// So now Fn, FnOnce, Future are also Modules that can be used as bounds.  


// IDEA: Cyclic Rc types are not Sendable across threads.
