extern "Yo",
  LinearPtr : Linear,
  malloc :
    fn() -> LinearPtr,
  free :
    fn(ptr: LinearPtr) -> unit
;

func1 :: (fn() -> unit) {
  x := malloc();
  p := *(x);

  y := *(p.*); // <- This is valid.
  // z := p.*; // This is not valid.

  free(x);
};

Data :: struct
  x: LinearPtr,
  y: LinearPtr,
  z: i32
;

func :: (fn(data: Data)-> unit) {
  // destructuring Linear value requires 
  // all fields of Linear value to be destructured,
  // and it will consume the Linear value itself.    
  // { x } := data; // <- This is not valid.
  { ... } := data;
  drop(x);
  drop(y);
  
  // drop(data); // This will give error, as `data` is
                 // already consumed by destructuring.
};

func2 :: (fn(data: Data)-> unit) {
  // destructuring Linear value requires 
  // all fields of Linear value to be destructured,
  // and it will consume the Linear value itself.    
  // { x } := data; // <- This will give error, as `y` is not destructured.
  { x, y } := data;
  drop(x);
  drop(y);
  
  // drop(data); // This will give error, as `data` is
                    // already consumed by destructuring.
};
