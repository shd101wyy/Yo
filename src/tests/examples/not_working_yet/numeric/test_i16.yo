open import "std";

/**
 * Test i16 (signed 16-bit integer) operations
 * Range: -32768 to 32767
 */
main :: (()-> unit) {
  // Basic i16 values
  a :: 1000.as(i16);
  b :: 250.as(i16);
  c :: 1000.as(i16);
  zero :: 0.as(i16);
  neg_val :: -(500).as(i16);
  max_val :: 32767.as(i16);
  min_val :: -(32768).as(i16);
  
  // Arithmetic operations
  sum :: (a + b);        // 1250i16
  diff :: (a - b);       // 750i16
  prod :: (a * b);       // 250000i16 (may overflow)
  quot :: (a / b);       // 4i16 (integer division)
  remainder :: (a % b);  // 0i16 (1000 % 250 = 0)
  
  // Unary operations
  neg_a :: -(a);         // -1000i16
  neg_zero :: -(zero);   // 0i16
  
  // Comparison operations
  eq_test :: (a == c);   // true (1000i16 == 1000i16)
  eq_false :: (a == b);  // false (1000i16 == 250i16)
  neq_test :: (a != b);  // true (1000i16 != 250i16)
  neq_false :: (a != c); // false (1000i16 != 1000i16)
  lt_test :: (b < a);    // true (250i16 < 1000i16)
  lt_false :: (a < b);   // false (1000i16 < 250i16)
  lte_test :: (b <= a);  // true (250i16 <= 1000i16)
  lte_equal :: (a <= c); // true (1000i16 <= 1000i16)
  gt_test :: (a > b);    // true (1000i16 > 250i16)
  gt_false :: (b > a);   // false (250i16 > 1000i16)
  gte_test :: (a >= b);  // true (1000i16 >= 250i16)
  gte_equal :: (a >= c); // true (1000i16 >= 1000i16)
  
  // Type conversion operations
  i16_to_i32 :: a.as(i32);      // 1000i32
  i16_to_u32 :: a.as(u32);      // 1000u32
  i16_to_f32 :: a.as(f32);      // 1000.0f32
  i16_to_string :: a.to_string(); // "1000"
  
  // Test with compile-time assertions
  // Arithmetic
  compt_assert(sum == (1250.as(i16)));
  compt_assert(diff == (750.as(i16)));
  compt_assert(quot == (4.as(i16)));
  compt_assert(remainder == (0.as(i16)));
  
  // Unary operations
  compt_assert(neg_a == (-(1000).as(i16)));
  compt_assert(neg_zero == (0.as(i16)));
  
  // Comparisons
  compt_assert(eq_test == true);
  compt_assert(eq_false == false);
  compt_assert(neq_test == true);
  compt_assert(neq_false == false);
  compt_assert(lt_test == true);
  compt_assert(lt_false == false);
  compt_assert(lte_test == true);
  compt_assert(lte_equal == true);
  compt_assert(gt_test == true);
  compt_assert(gt_false == false);
  compt_assert(gte_test == true);
  compt_assert(gte_equal == true);
  
  // Type conversions
  compt_assert(i16_to_i32 == (1000.as(i32)));
  compt_assert(i16_to_u32 == (1000.as(u32)));
  compt_assert(i16_to_f32 == (1000.0.as(f32)));
  compt_assert(i16_to_string == "1000");
  
  // Test with negative numbers
  {
    neg_sum :: (neg_val + a);     // -500 + 1000 = 500i16
    neg_diff :: (neg_val - a);    // -500 - 1000 = -1500i16
    neg_prod :: (neg_val * 2.as(i16)); // -500 * 2 = -1000i16
    neg_quot :: (neg_val / 5.as(i16)); // -500 / 5 = -100i16
    
    // Comparisons with negatives
    neg_lt :: (neg_val < a);      // true (-500 < 1000)
    neg_gt :: (a > neg_val);      // true (1000 > -500)
    
    compt_assert(neg_sum == (500.as(i16)));
    compt_assert(neg_diff == (-(1500).as(i16)));
    compt_assert(neg_prod == (-(1000).as(i16)));
    compt_assert(neg_quot == (-(100).as(i16)));
    compt_assert(neg_lt == true);
    compt_assert(neg_gt == true);
  };
  
  // Test boundary values
  {
    // Operations with min value
    min_sum :: (min_val + 1.as(i16));     // -32767i16
    min_sub :: (min_val - 1.as(i16));     // overflow behavior
    min_neg :: -(min_val);               // overflow: -(-32768) should be handled
    
    // Operations with max value
    max_sum :: (max_val + 1.as(i16));     // overflow
    max_sub :: (max_val - 1.as(i16));     // 32766i16
    max_neg :: -(max_val);               // -32767i16
    
    compt_assert(min_sum == (-(32767).as(i16)));
    compt_assert(max_sub == (32766.as(i16)));
    compt_assert(max_neg == (-(32767).as(i16)));
    
    // Boundary comparisons
    compt_assert(min_val < max_val);
    compt_assert(max_val > min_val);
    compt_assert(min_val <= max_val);
    compt_assert(max_val >= min_val);
  };
  
  // Test zero operations
  {
    zero_sum :: (zero + a);      // 1000i16
    zero_diff1 :: (a - zero);    // 1000i16
    zero_diff2 :: (zero - a);    // -1000i16
    zero_prod :: (zero * a);     // 0i16
    
    compt_assert(zero_sum == (1000.as(i16)));
    compt_assert(zero_diff1 == (1000.as(i16)));
    compt_assert(zero_diff2 == (-(1000).as(i16)));
    compt_assert(zero_prod == (0.as(i16)));
    
    // Identity operations
    identity_sum :: (a + zero);  // 1000i16
    identity_prod :: (a * 1.as(i16));  // 1000i16
    
    compt_assert(identity_sum == (1000.as(i16)));
    compt_assert(identity_prod == (1000.as(i16)));
    
    // Self operations
    self_sub :: (a - a);         // 0i16
    self_div :: (a / a);         // 1i16
    self_mod :: (a % a);         // 0i16
    
    compt_assert(self_sub == (0.as(i16)));
    compt_assert(self_div == (1.as(i16)));
    compt_assert(self_mod == (0.as(i16)));
  };
  
  // Test large values
  {
    large1 :: 20000.as(i16);
    large2 :: 12000.as(i16);
    
    large_sum :: (large1 + large2);     // 32000i16
    large_diff :: (large1 - large2);    // 8000i16
    large_div :: (large1 / 10.as(i16)); // 2000i16
    large_mod :: (large1 % 7.as(i16));  // 6i16 (20000 % 7 = 6)
    
    compt_assert(large_sum == (32000.as(i16)));
    compt_assert(large_diff == (8000.as(i16)));
    compt_assert(large_div == (2000.as(i16)));
    compt_assert(large_mod == (6.as(i16)));
  };
  
  // Test various divisions
  {
    div1 :: (2000.as(i16) / 8.as(i16));       // 250i16
    div2 :: (2001.as(i16) / 8.as(i16));       // 250i16 (integer division)
    div3 :: (7.as(i16) / 100.as(i16));        // 0i16
    
    // Negative divisions
    div4 :: (-(2000).as(i16) / 8.as(i16));    // -250i16
    div5 :: (2000.as(i16) / -(8).as(i16));    // -250i16
    div6 :: (-(2000).as(i16) / -(8).as(i16)); // 250i16
    
    compt_assert(div1 == (250.as(i16)));
    compt_assert(div2 == (250.as(i16)));
    compt_assert(div3 == (0.as(i16)));
    compt_assert(div4 == (-(250).as(i16)));
    compt_assert(div5 == (-(250).as(i16)));
    compt_assert(div6 == (250.as(i16)));
  };
  
  // Test modulo operations
  {
    mod1 :: (17.as(i16) % 5.as(i16));        // 2i16
    mod2 :: (20.as(i16) % 4.as(i16));        // 0i16
    mod3 :: (7.as(i16) % 10.as(i16));        // 7i16
    
    // Negative modulo
    mod4 :: (-(17).as(i16) % 5.as(i16));     // behavior depends on implementation
    mod5 :: (17.as(i16) % -(5).as(i16));     // behavior depends on implementation
    
    compt_assert(mod1 == (2.as(i16)));
    compt_assert(mod2 == (0.as(i16)));
    compt_assert(mod3 == (7.as(i16)));
  };
  
  // Test chained operations
  {
    chain1 :: ((a + b) / 2.as(i16));   // (1000i16 + 250i16) / 2i16 = 625i16
    chain2 :: (a + (b * 2.as(i16)));   // 1000i16 + (250i16 * 2i16) = 1500i16
    chain3 :: ((a / b) + 1.as(i16));   // (1000i16 / 250i16) + 1i16 = 5i16
    
    compt_assert(chain1 == (625.as(i16)));
    compt_assert(chain2 == (1500.as(i16)));
    compt_assert(chain3 == (5.as(i16)));
  };
  
  // Test string conversions
  {
    zero_str :: zero.to_string();
    neg_str :: neg_val.to_string();
    max_str :: max_val.to_string();
    min_str :: min_val.to_string();
    
    compt_assert(zero_str == "0");
    compt_assert(neg_str == "-500");
    compt_assert(max_str == "32767");
    compt_assert(min_str == "-32768");
  };
  
  ()
};
