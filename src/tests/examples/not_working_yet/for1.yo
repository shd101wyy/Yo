open import "std";

// For loop
// which currently only works for Array
sum :: (fn() -> i32) {
  arr := [1, 2, 3];
  i := 0;
  for arr, elem => {
    i = (elem + i);
  };
  return i;
};

sum_slice :: (fn() -> i32) {
  arr := [1, 2, 3];
  i := 0;
  borrow &(arr(:)), slice => {
    for slice, elem => {
      i = (elem + i);
    };

    for slice, &(elem) => {
      i = (elem.* + i);
    };
  };
  return i;
};

compt_sum :: (fn() -> compt(i32)) {
  arr :: [1, 2, 3, 4, 5, 6];
  i :: 0;
  for arr, (elem, index) => {
    i = (elem + i);
  };
  return i;
};

result :: compt_sum();
