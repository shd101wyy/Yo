
{ printf } :: import "std/libc/stdio";

main :: (fn() -> i32) {
  x := 1;
  borrow (Closure(FnMut(y : i32) -> i32, _) {
    x = (x + y);
    return x;
  }), (closure)=> {    
    result := closure(2);
    result = closure(3);
    printf("Result: %d\n", result);
    return result;
  };
};

export main;