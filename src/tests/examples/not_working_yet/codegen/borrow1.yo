
{ printf } :: import "std/libc/stdio";

main :: (fn() -> i32) {
  x := 1;
  y := 2;

  result1 := 
  borrow (&(x)), (x_ref)=> {
    x_ref.* =
      (x_ref.*) + 1;
    x_ref.*
  };
  printf("result1: %d\n", result1);

  result2 := 
    borrow (&(x), &(y)), (x_ref, y_ref)=> {
      x_ref.* =
        (x_ref.*) + 1;
      y_ref.* = 
        (y_ref.*) + 1;
      x_ref.* + y_ref.*
    };
  printf("result2: %d\n", result2);
  return 0;
};

export main;