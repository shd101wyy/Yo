open import "std";
{ printf } :: import "std/libc/stdio";

main :: (fn() -> i32) {
  x := 1;
  borrow (Closure(Fn(y : i32) -> i32, _) {
    return x + y;
  }), (closure)=> {
    result := closure(2);
    result = closure(3);
    printf("Result: %d\n", result);
    return result;
  };
};

export main;