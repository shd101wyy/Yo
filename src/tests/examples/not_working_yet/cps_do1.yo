{ printf } :: import "std/libc/stdio";


K :: (fn(compt(Value) : Type) -> compt(Type)) {
  ClosureType ::
    fn(value : Value) => unit;
  return ClosureType;
};

// Algebraic effects
Yield ::
  fn( i : i32, resume : K(i32)) -> unit;

some_cond :: (fn() -> bool) true;

(compt(yield) : Yield) =
  (i, resume) ->
    cond
      (i < 0) => resume(0),
      true => resume(i)
;

Color :: enum Red, Green, Blue;

extern "Yo",
  yieldColor : (fn( color : Color, resume : K(Color)) -> unit)
;

test1 :: (fn( resume : K(i32)) -> unit) {
  result :=
    cond(
      some_cond() => do(yield(0)),
      (do(yield(-4)) < 0) => do(yield(-2)),
      true => do(yield(2))
    );
  printf("Result: %d\n", result);
  resume(result);
};

test2 :: (fn(resume: K(i32)) -> unit) {
  arr := [(do yield(1)), (do yield(2)), (do yield(3))];
  result := 0;
  i := usize(0);
  while (i < arr.length), {
    result = (result + arr(i));
    // result = (result + (do yield(i)));
  };
  result = (arr(0) + arr(1));
};

test3 :: (fn(color: Color, resume : K(i32)) -> unit) {
  printf("Before yieldColor\n");
  yielded_color := do yieldColor(color);
  result := match(yielded_color,
    .Red => (do yield(12)),
    .Green => {
      result := (do yield(34));
      result + 1
    },
    .Blue => 0
  );
  printf("Result: %d\n", result);
  resume(result);
};

test4 :: (fn( resume : K(i32)) -> unit) {
  (compt(yield) : Yield) =
    (i, resume) ->
      cond
        (i < 0) => resume(0),
        true => resume(i)
  ;
  yield(0, (yielded) => {
    result :=
      1 + yielded;
    resume(result);
  });
};

// Test nested do calls in arithmetic expressions
test5 :: (fn(resume : K(i32)) -> unit) {
  result := 
    ((do(yield(10))) + (do(yield(20)))) + (do(yield(30)));
  printf("Arithmetic result: %d\n", result);
  resume(result);
};

// Test do calls in function arguments
test6 :: (fn(resume : K(i32)) -> unit) {
  max :: (fn(a : i32, b : i32) -> i32) {
    return cond(
      (a > b) => a, 
      true => b
    );
  };
  
  result := max(do(yield(15)), do(yield(25)));
  printf("Max result: %d\n", result);
  resume(result);
};

// Simple cond with do calls only in bodies (no nested cond)
test_simple_cond :: (fn(resume : K(i32)) -> unit) {
  result := cond(
    some_cond() => do(yield(100)),
    true => do(yield(200))
  );
  printf("Simple cond result: %d\n", result);
  resume(result);
};

// Cond with do call in only one branch
test_partial_cond :: (fn(resume : K(i32)) -> unit) {
  result := cond(
    some_cond() => do(yield(100)),
    true => 200
  );
  printf("Partial cond result: %d\n", result);
  resume(result);
};

// Test nested cond expressions with do calls
test7 :: (fn(resume : K(i32)) -> unit) {
  outer_result := cond(
    ((do(yield(1))) > 0) => cond(
      ((do(yield(2))) > 1) => do(yield(100)),
      true => do(yield(200))
    ),
    true => do(yield(300))
  );
  printf("Nested cond result: %d\n", outer_result);
  resume(outer_result);
};


// Test do calls in variable assignments and subsequent use
test8 :: (fn(resume : K(i32)) -> unit) {
  first := do(yield(5));
  second := do(yield(first * 2));
  third := do(yield(second + first));
  result := 
    (first + second) + third;
  printf("Sequential assignments result: %d\n", result);
  resume(result);
};


