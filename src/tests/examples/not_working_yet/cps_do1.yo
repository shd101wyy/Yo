// Test error handling patterns with do calls
test11 :: (fn(resume : K(i32)) -> unit) {
  safe_divide :: (fn(a : i32, b : i32) -> i32)
    cond(
      (b == 0) => -(1),
      true => (a / b)
    );
  
  numerator := do(yield(100));
  denominator := do(yield(5));
  result := safe_divide(numerator, denominator);
  
  final_result := cond(
    (result == -(1)) => do(yield(0)),
    true => do(yield(result * 2))
  );
  
  printf("Safe divide result: %d\n", final_result);
  resume(final_result);
};

// Test do calls with bool operations
test12 :: (fn(resume : K(i32)) -> unit) {
  a := do(yield(10));
  b := do(yield(5));
  result := cond(
    ((a > b) && ((do(yield(a))) > (do(yield(15))))) => do(yield(1)),
    ((a < b) || ((do(yield(b))) < (do(yield(3))))) => do(yield(2)),
    true => do(yield(3))
  );
  printf("Bool operations result: %d\n", result);
  resume(result);
};
