// 2nd-class reference
Data :: struct(x: &(i32));

main :: (fn() -> unit) {
  // Create reference types
  I32Ref :: &(i32); // immutable reference
  I32MutRef :: &(i32); // mutable reference

  swap :: (fn(p: &(i32), q: &(i32)) -> unit) {
    tmp := p.*;
    p.* = q.*;
    q.* = tmp;
  };

  // Assign value that contains reference to a variable is prohibited.
  x := 12;
  y := 13;
  // p := &(x); // This is not allowed.
  swap(&(x), &(y));

  compt_expect_error(
    swap(&(x), &(x))
  );                  // This shouldn't be allowed.
                      // Because we cannot create multiple references
                      // to the same variable.
                      // Their paths overlap.

  compt_expect_error(
    return_ref :: (fn()-> &(i32)) {
      x := 1;
      &(x) // Return a reference to local variable is prohibited.
    }
  );

  return_ref_2 :: (fn(p: &(i32))-> &(i32)) {
    x := 1;
    p // Return the reference that is not created in the function body is allowed.
  };

  return_ref_3 :: (fn(p: &(i32))-> Data)
    Data(p) // Return the reference that is not created in the function body is allowed.
  ;
};