open import "std";

test1 :: (fn() -> unit) {
  mut(x) := 12;
  closure := ((fn(y : i32) => i32) {
    x = (x + y);
    x
  });
  /*
  // It's the same as 
  closure := Closure(FnMove(y : i32) -> i32, _) {
    x = (x + y);
    x
  };
  */
  closure(3);
  closure(4);
};

(compt(LinearStruct) : Linear) = struct(val : i32);
test2 :: (fn() -> unit) {
  mut(x) := LinearStruct(1);
  closure := ((fn(y : i32) => i32) {
    x.val = (x.val + y);
    x.val
  });
  /*
  // It's the same as 
  closure := Closure(FnMove(y : i32) -> i32, _) {
    x = (x + y);
    x
  };
  */
  closure(3);
  compt_expect_error(
    closure(4)
  );
};