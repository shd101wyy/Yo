open import "std/libc/stdio";

Id :: module
  id : (fn(self : Self) -> Self)
;

Point :: (fn(compt(X) : Type, compt(Y) : Type) -> compt(Type)) {
  return struct(
    x : X,
    y : Y,
    Id :: impl(Self, Id(
      id : ((self) -> Self(self.x, self.y))
    ))
  );
};

use_id :: (fn(forall(T : Type), obj : T, using(ObjId) : (T <: Id)) -> T) {
  return ObjId.id(obj);
};

main :: (fn() -> unit) {
  p1 := Point(i32, i32)(3, 4);
  // p2 := use_id(p1, Point(i32, i32).Id);
  p2 := use_id(p1);

  printf("p1 id: (%d, %d)\n", p1.x, p1.y);
  printf("p2 id: (%d, %d)\n", p2.x, p2.y);
};

export main;
