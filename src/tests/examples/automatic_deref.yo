// Automatic dereference for pointer/reference types
open import "std";

(compt(LinearI32) : Linear) = i32;

Point :: struct
  x: i32,
  y: i32,
  z: LinearI32
;

test_ptr :: (fn() -> unit) {
  point := Point(3, 4, 5);
  ptr := *(point); // Create pointer to `point`
  pptr := *(*(point)); // Create pointer to pointer to `point`
  
  // Accessing fields directly
  {
    x := point.x;
    y := point.y;
    // { x : x1, y : y1, z } := point; // <- Destructuring will consume `point`, so it cannot be used after this line.
  };

  // Accessing fields through pointer
  {
    x := ptr.x;
    y := ptr.y;

    // The same as above ^
    x1 := ptr.*.x;
    y1 := ptr.*.y;

    // The same as above ^
    x1_1 := pptr.*.*.x;
    y1_1 := pptr.*.*.y;

    compt_expect_error(
      { x : x2, y : y2, z } := ptr,
      "error: cannot destructure pointer/reference"
    );

    // {
    //   Taking out linear value from free value is not allowed:
    //   { x : x2, y : y2, z } := ptr; // <- Not allowed to move `z` out.
    //   { x : x2, y : y2, *(z) } := ptr; // allowed, z has type: *(LinearI32)
    // };
    // I feel the logic above is too complicated ^^^
    // We just disallow to destructure pointer/reference for now.
  };

  // Accesing fields through reference
  {
    borrow &(point), pt_ref => {
      x := pt_ref.x;
      y := pt_ref.y;

      // The same as above ^
      x1 := pt_ref.*.x;
      y1 := pt_ref.*.y;

      compt_expect_error(
        { x : x2, y : y2, z } := pt_ref,
        "error: cannot destructure pointer/reference"
      );

      // {
      //   Taking out linear value from free value is not allowed:
      //   { x : x2, y : y2, z } := pt_ref; // <- Not allowed to move `z` out.
      //   { x : x2, y : y2, &(z) } := pt_ref; // allowed, z has type: &(LinearI32)
      //                                       // It's like `pt_ref` is borrowed, so after destructuring, `pt_ref` cannot be used anymore.
      // };
      // ^ Too complicated
    };
  };
};
