open import "../../../std/data/primitive/expr.yo";
open import "../../../std/data/primitive/expr_list.yo";
open import "../../../std/data/primitive/usize.yo";
open import "../../../std/data/primitive/boolean.yo";

/*
 The `do` macro transform the code below:
  
  do {
    x := 1;
    with response <= fetch("https://api.example.com");
    std.println(response);
    with (json,) <<= response.json();
    std.println(json);
    with (x, y) <- json.parse();
    return x + y;
  }
 
  to:

  {
    x := 1;
    fetch("https://api.example.com", fn(response) => {
      std.println(response);
      response.json(fn(json) =>> {
        std.println(json);
        json.parse(fn(x, y) -> {
          return(x + y);
        })
      })
    })
  }
 */

// Create a begin expression with all arguments using unquote_splicing
create_begin_with_all_args :: ((compt(args) : ExprList) -> compt(Expr)) {
  return cond(
    (args.length() == 0) => quote(()),
    (args.length() == 1) => args.car(),
    true =>
      // Use unquote_splicing to expand all arguments into a single begin call
      // This creates: begin(arg1, arg2, arg3, ..., argN)
      quote(begin(unquote_splicing(args)))
  );
};

// Helper function to collect consecutive non-with statements into a single begin block
collect_non_with_statements :: ((compt(args) : ExprList) -> compt(Expr)) {
  return cond(
    (args.length() == 0) => quote(()),
    (args.length() == 1) => args.car(),
    true =>
      // Collect all statements and wrap them in a single begin
      // This will create: begin(stmt1, stmt2, stmt3, ...)
      create_begin_with_all_args(args)
  );
};

// Helper function to check if there are any with statements in the argument list
check_for_with_statements :: ((compt(args) : ExprList) -> compt(boolean)) {
  return cond(
    (args.length() == 0) => false,
    true => {
      first_arg :: args.car();
      rest_args :: args.cdr();
      cond(
        first_arg.is_fn_call() => {
          callee :: first_arg.get_callee();
          cond(
            (callee.is_atom() && (callee == quote(with))) => true,
            true => recur(rest_args)
          )
        },
        true => recur(rest_args)
      )
    }
  );
};

// Transform "with var <= expr" into a monadic bind pattern
// This should transform the entire do block into nested function calls
transform_do_block :: ((compt(args) : ExprList) -> compt(Expr)) {
  return cond(
    (args.length() == 0) => quote(()),
    (args.length() == 1) => args.car(),
    true => {
      first_arg :: args.car();
      rest_args :: args.cdr();
      cond(
        // Check if this is a with statement: with var <= expr
        first_arg.is_fn_call() => {
          callee :: first_arg.get_callee();
          cond(
            (callee.is_atom() && (callee == quote(with))) => {
              with_args :: first_arg.get_args();
              cond(
                (with_args.length() == 1) => {
                  assignment_expr :: with_args.car(); // This should be "var <= expr"
                  cond(
                    assignment_expr.is_fn_call() => {
                      assignment_callee :: assignment_expr.get_callee();
                      cond(
                        (assignment_callee.is_atom() && 
                         ((assignment_callee == quote(<-)) || 
                          (assignment_callee == quote(<=)) || 
                          (assignment_callee == quote(<<=)))) => {
                          assignment_args :: assignment_expr.get_args();
                          cond(
                            (assignment_args.length() == 2) => {
                              var_name :: assignment_args.car();
                              expr_value :: assignment_args.cdr().car();
                              
                              // Transform with statement by handling each case directly
                              cond(
                                // Handle the case where expr_value is a function call
                                expr_value.is_fn_call() => {
                                  fn_name :: expr_value.get_callee();
                                  fn_args :: expr_value.get_args();
                                  
                                  // Create the callback function based on var_name and assignment_callee
                                  callback_expr :: cond(
                                    // Check if var_name is _ (no parameters)
                                    (var_name.is_atom() && (var_name == quote(_))) => {
                                      rest_underscore_expr :: cond(
                                        (rest_args.length() == 0) => quote(()),
                                        (rest_args.length() == 1) => rest_args.car(),
                                        true => {
                                          has_with :: check_for_with_statements(rest_args);
                                          cond(
                                            has_with => recur(rest_args),
                                            true => create_begin_with_all_args(rest_args)
                                          )
                                        }
                                      );
                                      cond(
                                        (assignment_callee == quote(<-)) => quote(fn() -> unquote(rest_underscore_expr)),
                                        (assignment_callee == quote(<=)) => quote(fn() => unquote(rest_underscore_expr)),
                                        true => quote(fn() =>> unquote(rest_underscore_expr))
                                      )
                                    },
                                    // Check if var_name is a tuple pattern
                                    var_name.is_fn_call() => {
                                      var_callee :: var_name.get_callee();
                                      cond(
                                        (var_callee.is_atom() && (var_callee == quote(tuple))) => {
                                          tuple_args :: var_name.get_args();
                                          rest_tuple_expr :: cond(
                                            (rest_args.length() == 0) => quote(()),
                                            (rest_args.length() == 1) => rest_args.car(),
                                            true => {
                                              has_with :: check_for_with_statements(rest_args);
                                              cond(
                                                has_with => recur(rest_args),
                                                true => create_begin_with_all_args(rest_args)
                                              )
                                            }
                                          );
                                          cond(
                                            (assignment_callee == quote(<-)) => quote(fn(unquote_splicing(tuple_args)) -> unquote(rest_tuple_expr)),
                                            (assignment_callee == quote(<=)) => quote(fn(unquote_splicing(tuple_args)) => unquote(rest_tuple_expr)),
                                            true => quote(fn(unquote_splicing(tuple_args)) =>> unquote(rest_tuple_expr))
                                          )
                                        },
                                        true => {
                                          // Regular single parameter
                                          rest_param_expr :: cond(
                                            (rest_args.length() == 0) => quote(()),
                                            (rest_args.length() == 1) => rest_args.car(),
                                            true => {
                                              has_with :: check_for_with_statements(rest_args);
                                              cond(
                                                has_with => recur(rest_args),
                                                true => create_begin_with_all_args(rest_args)
                                              )
                                            }
                                          );
                                          cond(
                                            (assignment_callee == quote(<-)) => quote(fn(unquote(var_name)) -> unquote(rest_param_expr)),
                                            (assignment_callee == quote(<=)) => quote(fn(unquote(var_name)) => unquote(rest_param_expr)),
                                            true => quote(fn(unquote(var_name)) =>> unquote(rest_param_expr))
                                          )
                                        }
                                      )
                                    },
                                    true => {
                                      // Regular single parameter
                                      rest_main_expr :: cond(
                                        (rest_args.length() == 0) => quote(()),
                                        (rest_args.length() == 1) => rest_args.car(),
                                        true => {
                                          // For multiple args, first check if all remaining are non-with statements
                                          has_with :: check_for_with_statements(rest_args);
                                          cond(
                                            has_with => 
                                              // If there are with statements, we need to handle this recursively
                                              recur(rest_args),
                                            true => create_begin_with_all_args(rest_args)
                                          )
                                        }
                                      );
                                      cond(
                                        (assignment_callee == quote(<-)) => quote(fn(unquote(var_name)) -> unquote(rest_main_expr)),
                                        (assignment_callee == quote(<=)) => quote(fn(unquote(var_name)) => unquote(rest_main_expr)),
                                        true => quote(fn(unquote(var_name)) =>> unquote(rest_main_expr))
                                      )
                                    }
                                  );
                                  
                                  // Construct the function call with the callback
                                  cond(
                                    (fn_args.length() == 0) => quote(unquote(fn_name)(unquote(callback_expr))),
                                    (fn_args.length() == 1) => {
                                      arg1 :: fn_args.car();
                                      quote(unquote(fn_name)(unquote(arg1), unquote(callback_expr)))
                                    },
                                    (fn_args.length() == 2) => {
                                      arg1 :: fn_args.car();
                                      arg2 :: fn_args.cdr().car();
                                      quote(unquote(fn_name)(unquote(arg1), unquote(arg2), unquote(callback_expr)))
                                    },
                                    true => quote(unquote(expr_value)(unquote(callback_expr)))
                                  )
                                },
                                true => {
                                  // expr_value is not a function call, treat as simple call
                                  callback_expr :: cond(
                                    (var_name.is_atom() && (var_name == quote(_))) => {
                                      rest_callback_expr :: cond(
                                        (rest_args.length() == 0) => quote(()),
                                        (rest_args.length() == 1) => rest_args.car(),
                                        true => {
                                          has_with :: check_for_with_statements(rest_args);
                                          cond(
                                            has_with => recur(rest_args),
                                            true => create_begin_with_all_args(rest_args)
                                          )
                                        }
                                      );
                                      cond(
                                        (assignment_callee == quote(<-)) => quote(fn() -> unquote(rest_callback_expr)),
                                        (assignment_callee == quote(<=)) => quote(fn() => unquote(rest_callback_expr)),
                                        true => quote(fn() =>> unquote(rest_callback_expr))
                                      )
                                    },
                                    true => {
                                      rest_callback2_expr :: cond(
                                        (rest_args.length() == 0) => quote(()),
                                        (rest_args.length() == 1) => rest_args.car(),
                                        true => {
                                          has_with :: check_for_with_statements(rest_args);
                                          cond(
                                            has_with => recur(rest_args),
                                            true => create_begin_with_all_args(rest_args)
                                          )
                                        }
                                      );
                                      cond(
                                        (assignment_callee == quote(<-)) => quote(fn(unquote(var_name)) -> unquote(rest_callback2_expr)),
                                        (assignment_callee == quote(<=)) => quote(fn(unquote(var_name)) => unquote(rest_callback2_expr)),
                                        true => quote(fn(unquote(var_name)) =>> unquote(rest_callback2_expr))
                                      )
                                    }
                                  );
                                  quote(unquote(expr_value)(unquote(callback_expr)))
                                }
                              )
                            },
                            true => {
                              compt_assert(false, "Malformed <-, <=, or <<= statement, expected two arguments");
                              quote(false)
                            }
                          )
                        },
                        true => {
                          compt_assert(false, "Expected \"with\" statement to use <-, <= or <<=");
                          quote(false)
                        }
                      )
                    },
                    true => {
                      compt_assert(false, "Expected \"with\" statement to be a function call");
                      quote(false)
                    }
                  )
                },
                true => {
                  compt_assert(false, "Malformed \"with\" statement, expected one argument");
                  quote(false)
                }
              )
            },
            // Not a with statement
            true => {
              has_with_statement :: check_for_with_statements(rest_args);
              cond(
                has_with_statement => {
                  rest_transformed :: recur(rest_args);
                  quote(begin(unquote(first_arg), unquote(rest_transformed)))
                },
                true => {
                  all_remaining :: quote(unquote(first_arg)).cons(rest_args);
                  create_begin_with_all_args(all_remaining)
                }
              )
            }
          )
        },
        true => {
          all_remaining :: quote(unquote(first_arg)).cons(rest_args);
          create_begin_with_all_args(all_remaining)
        }
      )
    }
  );
};

// Helper function to check if there are any with statements in the argument list

do :: ((quote(begin_expr) : Expr) -> unquote(Expr)) {
  return cond(
    begin_expr.is_fn_call() => {
      callee :: begin_expr.get_callee();
      cond(
        // expect the callee to be the `begin` function
        (callee.is_atom() && (callee == quote(begin))) => {
          args :: begin_expr.get_args();
          // Transform the entire block
          transform_do_block(args)
        },
        // otherwise, return false for error
        true => {
          compt_assert(false, "Expected `do` block to start with `begin`");
          quote(false)
        }
      )
    },
    true => {
      compt_assert(false, "Expected `do` block to be a function call to `begin`");
      quote(false)
    }
  );
};

expanded :: macro_expand quote
  do {
    x := 1;
    with response <= fetch("https://api.example.com");
    std.println("after fetch");
    std.println(response);
    with (json,) <<= response.json();
    std.println("after json");
    std.println(json);
  }
;

// Debug: print the actual expanded result
compt_print("Actual expanded result:");
compt_print(expanded);

// Test simple quote/unquote
test_var :: quote(hello);
test_quote :: quote(unquote(test_var));
compt_print("Simple quote/unquote test:");
compt_print(test_quote);

expected :: quote(
  begin(
    x := 1,
    fetch("https://api.example.com", fn(response) => 
      begin(
        (std.println)("after fetch"),
        (std.println)(response),
        (response.json)(fn(json) =>> 
          begin(
            (std.println)("after json"),
            (std.println)(json),
            ()
          )
        )
      )
    )
  )
);

compt_print("Expected result:");
compt_print(expected);

compt_assert(expanded == expected);

