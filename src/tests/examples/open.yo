// Open a compt struct
open_struct :: (() -> i32) {
  anony :: { x : 12, y : 13 };
  open anony;
  x
};

// Open a runtime struct
open_struct_runtime :: (() -> i32) {
  anony := { x : 12, y : 13 };
  open anony;
  x
};

// Open a module
open_module :: (() -> i32) {
  my_module :: module {
    x :: 6;
    y :: 2;
    export x, y;
  };
  open my_module;
  x
};