compt_assert(Type.impls(i32, Copy));
compt_assert(Type.impls(i32, Send));

Point :: struct(x : i32, y : i32);
compt_assert(Type.impls(Point, Copy) == true);
compt_assert(Type.impls(Point, Send) == true);

MyBox :: object(v : i32);
compt_assert(Type.impls(MyBox, Copy) == false);
compt_assert(Type.impls(MyBox, Send) == true);

GenericPoint :: (fn(compt(T) : Type) -> compt(Type))
  struct(x : T, y : T)
;

compt_assert(Type.impls(GenericPoint(i32), Copy) == true);
compt_assert(Type.impls(GenericPoint(i32), Send) == true);

compt_assert(Type.impls(GenericPoint(MyBox), Copy) == false);
compt_assert(Type.impls(GenericPoint(MyBox), Send) == true);