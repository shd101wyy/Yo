main :: (fn() -> unit) {
  Point :: struct
    (x: i32) ?= 0,
    (y: i32) ?= 0
  ;

  p := Point(y: 1, x: 2);
  p2 := Point();
  p3 := Point(13);
  p4 := Point(x: 2);
  p5 := Point(y: 3);


  SomeTuple :: Tuple(x: i32, y: i32);
  (t: SomeTuple) = (1, 2);

  define_struct_with_default_field ::
    (fn(compt(T): Type, compt(value): T, runtime_value: T) -> unit) {
    Point :: struct
      (x: T) ?= value,
      (y: T) ?= value
    ;
    p := Point(x: value, y: value);
  };

  define_struct_with_default_field(i32, 0, 0);
};