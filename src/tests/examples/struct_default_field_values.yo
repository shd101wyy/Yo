main :: (()-> ()) {
  Point :: struct
    (x: i32) ?= 0,
    (y: i32) ?= 0
  ;

  p := Point(y: 1, x: 2);
  p := Point();
  p := Point(13);
  p := Point(x: 2);
  p := Point(y: 3);


  SomeTuple :: type (x: i32, y: i32);
  (t: SomeTuple) = (1, 2);

  define_struct_with_default_field ::
    ((compt(T): Type, compt(value): T, runtime_value: T) -> ()) {
    Point :: struct
      (x: T) ?= value,
      (y: T) ?= value
    ;
    p := Point(x: value, y: value);
  };

  define_struct_with_default_field(i32, 0, 0);
};