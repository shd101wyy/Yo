extern "Yo",
  __yo_ptr_cast :
    fn(forall(Source: Type), source : *(Source)) -> unit
//  fn(forall(Source2: Type), source : *(Source2)) -> unit
;

PtrMethods :: impl {
  // Cast pointer to another type
  cast :: (fn(forall(Source: Type), source: *(Source)) -> unit)
    __yo_ptr_cast(source)
  ;

  export cast;
};

test :: (fn(forall(T : Type), old_ptr : *!(T)) -> unit) {
  __yo_ptr_cast(old_ptr);
  PtrMethods.cast(old_ptr);
  old_ptr.cast();
};