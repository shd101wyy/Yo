open import "../../../../std/libc/stdio.yo";

Box :: object(
  (*) : i32,

  dispose :: (fn(self : Self) -> unit) {
    printf("Dropping Box with value %d\n", self.(*));
  }
);

BoxBox :: struct(
  (*) : Box
);

BoxBoxBox :: struct(
  (*) : BoxBox
);

// anonymous struct
main :: ((fn() -> unit) {
  x := Box(3);
  y := BoxBox(x);
  z := BoxBoxBox(y);
});

export main;