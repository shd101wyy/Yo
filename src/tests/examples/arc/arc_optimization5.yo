Box :: ref struct(
  (*) : i32
);

BoxBox :: struct(
  (*) : Box
);

test1 :: ((fn() -> Box) {
  x := Box(3); // _yo65d85c3c_temp_8
  // (_yo65d85c3c_temp_8.___drop)()
  return x; // (x.___dup)()

  // (_yo65d85c3c_temp_8.___drop)() and (x.___dup)() cancelled out
  // because _yo65d85c3c_temp_8 and x are the same reference.
  // So no runtime calls are generated.
});
// begin(x := Box(3), return(x), ())

