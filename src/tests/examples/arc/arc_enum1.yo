open import "../../../../std/libc/stdio.yo";

Point :: ref struct
  x : i32,
  y : i32,

  dispose :: ((fn(self : Self) -> unit) {
    printf("Disposed Point(%d, %d)\n", self.x, self.y);
  })
;
Shape :: ref enum
  Point(point : Point),
  Circle(radius : i32),
  Square(side : i32),
  Triangle(base : i32, height : i32),

  dispose :: ((fn(self : Self) -> unit) {
    printf("Disposed Shape\n");
  })
;

