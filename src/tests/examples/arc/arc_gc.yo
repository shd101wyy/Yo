open import "std/libc/stdio.yo";

Option :: (fn(compt(T) : Type) -> compt(Type))
  enum
    Some(value: T),
    None
;

List :: ref struct
  value : i32,
  next : Option(Self),
  
  dispose :: ((fn(self : Self)-> unit) {
    printf("Disposing List with value %d\n", self.value);
  })
;

form_cycle :: (fn() -> unit) {
  a := List(3, .None);
  b := List(5, .None);

  a.next = .Some(b);
  b.next = .Some(a); // Create a cycle
};

main :: (fn() -> i32) {
  form_cycle(); // create cycle
  c := List(7, .None);
  printf("Before GC\n");
  __yo_gc_collect(); // manually trigger the GC collection
  printf("After GC\n");
  return c.value;
};

export main;