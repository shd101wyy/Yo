open import "../../../../std/libc/stdio.yo";

Box :: object
  value : i32,

  dispose :: ((fn(self : Self) -> unit) {
    printf("Disposed Box(%d)\n", self.value);
  })
;

Point :: struct
  x : Box,
  y : Box
;

Container :: struct
  point : Point
;

main :: (fn() -> unit) {
  x := Box(1);
  y := Box(2);
  p := Point(x, y);  // ___dup(x), ___dup(y)
  c := Container(p); // ___dup(p)

  // ___drop(c);
  // ___drop(p);
  // ___drop(y);
  // ___drop(x);
};

export main;