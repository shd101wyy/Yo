open import "std/libc/stdio.yo";

Box :: object
  (*) : i32,

  dispose :: ((fn(self : Self) -> unit) {
    printf("Dropping Box with value: %d\n", self.(*));
  })
;

use_box :: (fn(b : Box) -> i32) {
  return 16;
};


main :: ((fn() -> i32) {
  result := use_box(Box(0));

  printf("In main, result is: %d\n", result);
  return result;
});

export main;
