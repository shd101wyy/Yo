open import "../../../../std/libc/stdio.yo";

Box :: ref struct
  (*) : i32,

  dispose :: ((fn(mut(self) : Self) -> unit) {
    printf("Disposing Box with value %d\n", self.(*));
  })
;

Point :: ref struct
  x : Box,
  y : Box,

  dispose :: ((fn(mut(self) : Self) -> unit) {
    printf("Disposing Point(%d, %d)\n", self.x.(*), self.y.(*));
  })
;

main :: ((fn() -> i32) {
  x := Box(1);
  y := Box(2);

  p1 := Point(x, y);
  p2 := Point(y, x);

  return 0;
});

export main;
