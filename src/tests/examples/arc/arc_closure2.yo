open import "std/libc/stdio";

MyBox :: object
  (*) : i32,

  dispose :: (fn(self : Self) -> unit) {
    printf("Disposing MyBox with value: %d\n", self.*);
  }
;

main :: (fn() -> unit) {
  x := MyBox(1);
  closure := ((fn(v : i32) => i32) {
    x.* = (x.* + v);
    return x.*;
  });

  closure(2);
  closure(3);

  result := closure(4);
  printf("Final result: %d, %d\n", result, x.*);
};

export main;