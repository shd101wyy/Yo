Point ::
  ((@(P): Type)-> @(Type))
  struct
    x: P,
    y: P
;

Id ::
  ((@(Self): Type)-> @(Type))
  module
    (Self: Type) = Self,
    id:
      (Self)-> Self
;

id ::
  ((forall(@(T): Type), x: T, implicit(@(I): Id(T)))-> T)
  I.id(x)
;

implicit(IdInt) ::
  Id(i32)
    id:
      fn(x) -> x
;

implicit(IdBoolean) ::
  Id(boolean)
    id:
      fn(x) -> x
;

implicit(IdPoint) ::
  (( forall(@(IP): Type), 
    implicit(@(I): Id(IP))
  )-> @(Id(Point(IP))))
  Id(Point(IP))
    id:
      fn(p) ->
        Point(IP)(I.id(p.x), I.id(p.y))
;

main :: (()-> ()) {
  x := id(13); // Implicit call
  x := id(13, implicit(IdInt)); // Explicit call

  x := id(false); // Implicit call
  x := id(true, implicit(IdBoolean)); // Explicit call

  // QUESTION: How to implement the following?
  x := id(Point(i32)(1, 2)); // Implicit call
  x := id(Point(i32)(1, 2), implicit(IdPoint())); // Implicit call 2
  x := id(Point(i32)(1, 2), implicit(IdPoint(implicit(IdInt)))); // Explicit call
}
