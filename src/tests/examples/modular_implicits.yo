Point ::
  ((compt(P): Type)-> compt(Type))
  struct
    x: P,
    y: P
;

Id ::
  ((compt(Self_): Type)-> compt(Module))
  module
    (Self: Type) = Self_,
    id:
      (self: Self)-> Self
;

id ::
  ((forall(compt(T): Type), x: T, implicit(compt(I): Id(T)))-> T)
  I.id(x)
;

implicit(IdInt) ::
  Id(i32)
    id:
      fn(x) -> x
;

implicit(IdBoolean) ::
  Id(boolean)
    id:
      fn(x) -> x
;

implicit(IdPoint) ::
  (( forall(compt(IP): Type), 
    implicit(compt(I): Id(IP))
  )-> compt(Id(Point(IP))))
  Id(Point(IP))
    id:
      fn(p) -> {
        { x, y } := p;
        Point(IP)(I.id(x), I.id(y))
      }
;

main :: (()-> unit) {
  x := id(13); // Implicit call
  x2 := id(13, implicit(IdInt)); // Explicit call

  x3 := id(false); // Implicit call
  x4 := id(true, implicit(IdBoolean)); // Explicit call

  // QUESTION: How to implement the following?
  x5 := id(Point(i32)(1, 2)); // Implicit call
  x6 := id(Point(i32)(1, 2), implicit(IdPoint())); // Implicit call 2
  x7 := id(Point(i32)(1, 2), implicit(IdPoint(implicit(IdInt)))); // Explicit call
}
