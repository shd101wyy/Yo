Point ::
  (fn(compt(P): Type)-> compt(Type))
  struct
    x: P,
    y: P
;

Id ::
  (fn(compt(Self_): Type)-> compt(Module))
  module
    (Self: Type) = Self_,
    id:
      fn(self : Self)-> Self
;

id ::
  (fn(forall(T: Type), x: T, using(I : Id(T)))-> T)
  I.id(x)
;

given(IdInt) ::
  Id(i32)
    id:
      (x) -> x
;

given(IdBoolean) ::
  Id(boolean)
    id:
      (x) -> x
;

given(IdPoint) ::
  (fn( forall(IP: Type), 
    using(I : Id(IP))
  )-> compt(Id(Point(IP))))
  Id(Point(IP))
    id:
      (p) -> {
        { x, y } := p;
        Point(IP)(I.id(x), I.id(y))
      }
;

main :: (fn() -> unit) {
  x := id(13); // Implicit call
  x2 := id(13, using(IdInt)); // Explicit call

  x3 := id(false); // Implicit call
  x4 := id(true, using(IdBoolean)); // Explicit call

  // QUESTION: How to implement the following?
  x5 := id(Point(i32)(1, 2)); // Implicit call
  x6 := id(Point(i32)(1, 2), using(IdPoint())); // Implicit call 2
  x7 := id(Point(i32)(1, 2), using(IdPoint(using(IdInt)))); // Explicit call
}
