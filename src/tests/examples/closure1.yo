open import "std";

foreach_fn_mut ::
  ((forall(
      compt(F): Type, 
      compt(size): usize
    ),
    arr : Array(i32, size),
    mut(callback) : Closure(FnMut(value: &(i32)) -> unit, F)
  ) -> unit) {
  mut(i) := 0.as(usize);
  while (i < size), {
    callback(&(arr(i)));
    i = (i + 1.as(usize));
  };
};

test1 :: (() -> unit) {
  arr := [1, 2, 3, 4, 5];
  mut(sum) := 0;

  // FnMut `sum`
  foreach_fn_mut(arr, fn(value) =>> {
    sum = (sum + value.*);
  });

  // Fn `sum`
  foreach_fn_mut(arr, fn(value) =>> {
    temp := sum;
    temp2 := value.*;
  });
};