// Just declare variables
extern
  add:
    (x: i32, y: i32)-> i32
;

// Define a module type
MyModule :: module
  Self :: i32,
  // or
  // (@(Self): Type) = i32,

  @(my_add):
    (x: i32, y: i32)-> i32,
  @(id):
    (x: Self)-> Self
;

// Define a module instance
(@(my_module) : MyModule) = MyModule
  my_add:
    fn(x, y)->
      add(x, y)
    ,
  id:
    fn(x) -> x
;

SomeModule :: module {
  export
    ...(my_module, exclude: (id,));
};
compt_expect_error(
  id :: SomeModule.id,
  "id is not exported from SomeModule"
);
my_add :: SomeModule.my_add;

some_func ::
  ((@(my_module): MyModule, x: i32)-> i32) {
  my_add2 :: my_module.my_add;
  my_add2(x, 1)
};

export
  MyModule,
  my_module,
  some_func,
  add
;