
// Test type compatibility across cond branches

extern
  add : (fn(x: i32, y: i32)-> i32),
  eq  : (fn(x: i32, y: i32)-> bool)
;

// Test: All branches return the same type
test_same_types :: (fn(x: i32)-> i32)
  cond
    (x `eq` 1) => 10,
    (x `eq` 2) => 20,
    (x `eq` 3) => 30,
    true => 40;

// Test: Type compatibility with compile-time branches
test_compile_time_types :: (fn()-> i32)
  cond
    false => 10,
    true => 20,
    false => 30;

// Test: Complex nested expressions with consistent types
test_complex_expressions :: (fn(x: i32, y: i32)-> i32)
  cond
    (x `eq` 0) => (y `add` 1),
    (x `eq` 1) => (y `add` 2),
    true => (y `add` 3);

// Execute tests
test_same_types(x: 2); // Should return 20
test_compile_time_types(); // Should return 20
test_complex_expressions(x: 0, y: 10); // Should return 11
test_complex_expressions(x: 1, y: 10); // Should return 12
test_complex_expressions(x: 5, y: 10); // Should return 13
