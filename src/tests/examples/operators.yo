open import "std";

extern
  add:
    (x: i32, y: i32)-> i32,
  sub:
    (x: i32, y: i32)-> i32
;

main :: (()-> unit) {
  Operators :: module {
    Self :: i32;

    ($+) :: ((x: i32, y: i32)-> i32)
      add(x, y)
    ;

    ($-) :: ((x: i32, y: i32)-> i32)
      sub(x, y)
    ;

    export
      Self, ($+), ($-)
    ;
  };

  Self :: Operators.Self;
  x := Operators.($+)(3, 4);
  x2 := 3.as(i32).($+)(4);
  x3 := (3.as(i32) $+ 4);

  x4 := Operators.($-)(3, 4);
  x5 := 3.as(i32).($-)(4);
  x6 := (3.as(i32) $- 4);
};
