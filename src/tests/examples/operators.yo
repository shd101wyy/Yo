

extern
  add:
    fn(x: i32, y: i32)-> i32,
  sub:
    fn(x: i32, y: i32)-> i32
;

main :: (fn() -> unit) {
  Operators :: impl {
    Self :: i32;

    ($+) :: (fn(x: i32, y: i32)-> i32)
      add(x, y)
    ;

    ($-) :: (fn(x: i32, y: i32)-> i32)
      sub(x, y)
    ;

    export
      Self, ($+), ($-)
    ;
  };

  Self :: Operators.Self;
  x := Operators.($+)(3, 4);
  x2 := i32(3).($+)(4);
  x3 := (i32(3) $+ 4);

  x4 := Operators.($-)(3, 4);
  x5 := i32(3).($-)(4);
  x6 := (i32(3) $- 4);
};
