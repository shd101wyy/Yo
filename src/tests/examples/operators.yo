extern
  add:
    (x: i32, y: i32)-> i32,
  sub:
    (x: i32, y: i32)-> i32
;

def main:
  ()-> (), {

  Operators :: module {
    This :: i32;

    def (+):
      (x: i32, y: i32)-> i32,
      add(x, y)
    ;

    def (-):
      (x: i32, y: i32)-> i32,
      sub(x, y)
    ;

    export { This, (+), (-) };
  };

  This :: Operators.This;
  x := Operators.(+)(3, 4);
  x := 3.(+)(4);
  x := (3 + 4);

  x := Operators.(-)(3, 4);
  x := 3.(-)(4);
  x := (3 - 4);
};