extern
  add:
    (x: i32, y: i32)-> i32,
  sub:
    (x: i32, y: i32)-> i32
;

main :: (()-> unit) {
  Operators :: module {
    Self :: i32;

    (+) :: ((x: i32, y: i32)-> i32)
      add(x, y)
    ;

    (-) :: ((x: i32, y: i32)-> i32)
      sub(x, y)
    ;

    export
      Self, (+), (-)
    ;
  };

  Self :: Operators.Self;
  x := Operators.(+)(3, 4);
  x := 3.(+)(4);
  x := (3 + 4);

  x := Operators.(-)(3, 4);
  x := 3.(-)(4);
  x := (3 - 4);
};