main :: (fn() -> unit) {
  Point1 :: struct(x: i32, y: i32);
  Point2 :: struct(x: i32, y: i32);

  x := Point1(3, 4);
  y := Point2(5, 6);
  compt_expect_error(
    (z: Point1) := (3, 4),
    "error: type Mismatch"
  );

  Point3 :: Point1;

  (z: Point2) = y;
  (z2: Point3) = x;


  Color :: enum Red, Green, Blue;
  (r: Color) = Color.Red;
  r2 := Color.Blue;

  Shape :: enum
    Circle(r: i32),
    Rectangle(w: i32, h: i32);
  (c: Shape) = Shape.Circle(5);
  c2 := Shape.Rectangle(h: 1, w: 2);

  anonymous := (struct(x: i32, y: i32))(3, 4);
  anonymous2 := (enum Red, Green, Blue).Red;
  anonymous3 := (enum Circle(r: i32), Rectangle(w: i32, h: i32)).Circle(5);

  // (x: Point1) := _(3, 4);
};