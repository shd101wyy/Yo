open import "std";

(add) :: (fn(
          quote(arg1): Expr,
          quote(arg2): Expr,
          ...(quote(arg3))
        ) -> unquote(Expr))
  cond
    (arg3.length() == 0) =>
      quote((unquote(arg1) + unquote(arg2))),
    true =>
      quote(add((unquote(arg1) + unquote(arg2)), unquote_splicing(arg3)))
;

// Test full expansion (no level limit)
x :: macro_expand(quote(add(3, 4, 5, 6)));
compt_print("Full expansion:");
compt_print(x);

// Test expansion with level 1 (should expand once)
y :: macro_expand(quote(add(3, 4, 5, 6)), 1);
compt_print("Level 1 expansion:");
compt_print(y);

// Test expansion with level 2 (should expand twice)
z :: macro_expand(quote(add(3, 4, 5, 6)), 2);
compt_print("Level 2 expansion:");
compt_print(z);