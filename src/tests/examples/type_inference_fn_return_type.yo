{
  extern "Yo",
    any :
      fn(forall(T : Type)) -> T
  ;

  test :: (fn() -> boolean)
    any()
  ;
};

{
  extern "Yo",
    Wrapper1 : (fn(compt(W1) : Type) -> compt(Type)),
    pure : 
      fn(
        forall(
          A1 : Type,
          Wrapper2 : (fn(compt(W2) : Type) -> compt(Type))
        ),
        value : A1
      ) -> Wrapper2(A1)
  ;

  Data ::
    (fn(compt(W3) : Type) -> compt(Type))
    struct(value: W3)
  ;

  test :: (fn() -> Data(boolean))
    pure(true)
  ;
};