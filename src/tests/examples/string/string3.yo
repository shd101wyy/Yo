open import "std";
open import "std/libc/stdio";
// open import "std/collections";

main :: (fn() -> unit) {
  // Test 1: Create String from a string literal (which becomes [u8]
  slice1 := "Hello, 世界!";
  str1 := String.from(slice1);
  printf("Test 1 - String from literal:\n");
  printf("  Length: %zu characters\n", str1.length());
  printf("  Bytes: %zu bytes\n", str1.as_bytes().length());
  printf("\n");
  
  // Test 2: Create String from explicit slice with Chinese text
  slice2 := "你好世界";
  str2 := String.from(slice2);
  printf("Test 2 - Chinese string:\n");
  printf("  Length: %zu characters (expected 4)\n", str2.length());
  printf("  Bytes: %zu bytes (expected 12)\n", str2.as_bytes().length());
  printf("\n");
  
  // Test 3: Create String from emoji slice
  slice3 := "😀🌍";
  str3 := String.from(slice3);
  printf("Test 3 - Emoji string:\n");
  printf("  Length: %zu characters (expected 2)\n", str3.length());
  printf("  Bytes: %zu bytes (expected 8)\n", str3.as_bytes().length());
  printf("\n");
  
  // Test 4: Access characters from created strings
  printf("Test 4 - Character access:\n");
  char0_opt := str2.at((0).as(usize));
  match(char0_opt,
    .Some(c) => printf("  str2[0] = U+%X\n", c.c),
    .None => printf("  str2[0] = None\n")
  );
  char1_opt := str2.at((1).as(usize));
  match(char1_opt,
    .Some(c) => printf("  str2[1] = U+%X\n", c.c),
    .None => printf("  str2[1] = None\n")
  );
  printf("\n");
  
  // Test 5: String concatenation
  str4 := str1.concat(str2);
  printf("Test 5 - Concatenation:\n");
  printf("  Combined length: %zu characters\n", str4.length());
  printf("  Combined bytes: %zu bytes\n", str4.as_bytes().length());
  printf("\n");
  
  // Test 6: Access and display emoji characters
  printf("Test 6 - Emoji characters:\n");
  emoji0_opt := str3.at((0).as(usize));
  match(emoji0_opt,
    .Some(c) => printf("  str3[0] = U+%X (😀)\n", c.c),
    .None => printf("  str3[0] = None\n")
  );
  emoji1_opt := str3.at((1).as(usize));
  match(emoji1_opt,
    .Some(c) => printf("  str3[1] = U+%X (🌍)\n", c.c),
    .None => printf("  str3[1] = None\n")
  );
  printf("\n");
};

export main;