
open import "std/libc/stdio";
open import "std/collections";

main :: (fn() -> unit) {
  // Test 1: Unicode rune creation
  printf("=== Test 1: Unicode Rune Creation ===\n");
  
  // Chinese characters
  shi_opt := rune.from_u32(u32(0x4E16)); // '世'
  match(shi_opt,
    .Some(shi) => {
      printf("Created rune '世' (Chinese)\n");
      printf("  Codepoint: U+%X (%u)\n", shi.to_u32(), shi.to_u32());
    },
    .None => {
      printf("Failed to create rune\n");
    }
  );

  jie_opt := rune.from_u32(u32(0x754C)); // '界'
  match(jie_opt,
    .Some(jie) => {
      printf("Created rune '界' (Chinese)\n");
      printf("  Codepoint: U+%X (%u)\n", jie.to_u32(), jie.to_u32());
    },
    .None => {
      printf("Failed to create rune\n");
    }
  );

  // Emoji
  emoji_opt := rune.from_u32(u32(0x1F600)); // 😀
  match(emoji_opt,
    .Some(emoji) => {
      printf("Created rune 😀 (emoji)\n");
      printf("  Codepoint: U+%X (%u)\n", emoji.to_u32(), emoji.to_u32());
    },
    .None => {
      printf("Failed to create rune\n");
    }
  );

  // Test 2: Chinese string "你好世界"
  printf("\n=== Test 2: Chinese String '你好世界' ===\n");
  
  chinese_bytes := ArrayList(u8).new();
  // '你' (U+4F60) = E4 BD A0 in UTF-8
  chinese_bytes.push(u8(0xE4));
  chinese_bytes.push(u8(0xBD));
  chinese_bytes.push(u8(0xA0));
  // '好' (U+597D) = E5 A5 BD in UTF-8
  chinese_bytes.push(u8(0xE5));
  chinese_bytes.push(u8(0xA5));
  chinese_bytes.push(u8(0xBD));
  // '世' (U+4E16) = E4 B8 96 in UTF-8
  chinese_bytes.push(u8(0xE4));
  chinese_bytes.push(u8(0xB8));
  chinese_bytes.push(u8(0x96));
  // '界' (U+754C) = E7 95 8C in UTF-8
  chinese_bytes.push(u8(0xE7));
  chinese_bytes.push(u8(0x95));
  chinese_bytes.push(u8(0x8C));

  chinese_result := String.from_utf8(chinese_bytes);
  match(chinese_result,
    .Ok(chinese_str) => {
      printf("Created string: '你好世界'\n");
      
      byte_len := chinese_str.as_bytes().len();
      char_len := chinese_str.len();
      printf("  Byte length: %zu\n", byte_len);
      printf("  Character length: %zu (expected: 4)\n", char_len);
      
      // Test character access by index
      printf("\n  Character access:\n");
      
      char0_opt := chinese_str.at(usize(0));
      match(char0_opt,
        .Some(char0) => printf("    [0] = '你' (U+%X)\n", char0.to_u32()),
        .None => printf("    [0] = Error\n")
      );
      
      char1_opt := chinese_str.at(usize(1));
      match(char1_opt,
        .Some(char1) => printf("    [1] = '好' (U+%X)\n", char1.to_u32()),
        .None => printf("    [1] = Error\n")
      );
      
      char2_opt := chinese_str.at(usize(2));
      match(char2_opt,
        .Some(char2) => printf("    [2] = '世' (U+%X)\n", char2.to_u32()),
        .None => printf("    [2] = Error\n")
      );
      
      char3_opt := chinese_str.at(usize(3));
      match(char3_opt,
        .Some(char3) => printf("    [3] = '界' (U+%X)\n", char3.to_u32()),
        .None => printf("    [3] = Error\n")
      );
      
      // Out of bounds
      char4_opt := chinese_str.at(usize(4));
      match(char4_opt,
        .Some(_) => printf("    [4] = Should be None!\n"),
        .None => printf("    [4] = None (out of bounds, correct)\n")
      );
    },
    .Error(_) => { printf("Failed to create Chinese string\n"); }
  );

  // Test 3: Mixed ASCII and Unicode
  printf("\n=== Test 3: Mixed ASCII and Unicode ===\n");
  
  mixed_bytes := ArrayList(u8).new();
  // "Hello世界"
  mixed_bytes.push(u8(0x48)); // 'H'
  mixed_bytes.push(u8(0x65)); // 'e'
  mixed_bytes.push(u8(0x6C)); // 'l'
  mixed_bytes.push(u8(0x6C)); // 'l'
  mixed_bytes.push(u8(0x6F)); // 'o'
  // '世' (U+4E16) = E4 B8 96
  mixed_bytes.push(u8(0xE4));
  mixed_bytes.push(u8(0xB8));
  mixed_bytes.push(u8(0x96));
  // '界' (U+754C) = E7 95 8C
  mixed_bytes.push(u8(0xE7));
  mixed_bytes.push(u8(0x95));
  mixed_bytes.push(u8(0x8C));

  mixed_result := String.from_utf8(mixed_bytes);
  match(mixed_result,
    .Ok(mixed_str) => {
      printf("Created string: 'Hello世界'\n");
      printf("  Byte length: %zu\n", mixed_str.as_bytes().len());
      printf("  Character length: %zu (expected: 7)\n", mixed_str.len());
      
      // Access ASCII character
      char0_opt := mixed_str.at(usize(0));
      match(char0_opt,
        .Some(char0) => printf("  [0] = 'H' (U+%X)\n", char0.to_u32()),
        .None => printf("  [0] = Error\n")
      );
      
      // Access Unicode character
      char5_opt := mixed_str.at(usize(5));
      match(char5_opt,
        .Some(char5) => printf("  [5] = '世' (U+%X)\n", char5.to_u32()),
        .None => printf("  [5] = Error\n")
      );
    },
    .Error(_) => { printf("Failed to create mixed string\n"); }
  );

  // Test 4: Emoji string
  printf("\n=== Test 4: Emoji String ===\n");
  
  emoji_bytes := ArrayList(u8).new();
  // 😀 (U+1F600) = F0 9F 98 80 in UTF-8
  emoji_bytes.push(u8(0xF0));
  emoji_bytes.push(u8(0x9F));
  emoji_bytes.push(u8(0x98));
  emoji_bytes.push(u8(0x80));
  // 🌍 (U+1F30D) = F0 9F 8C 8D in UTF-8
  emoji_bytes.push(u8(0xF0));
  emoji_bytes.push(u8(0x9F));
  emoji_bytes.push(u8(0x8C));
  emoji_bytes.push(u8(0x8D));

  emoji_str_result := String.from_utf8(emoji_bytes);
  match(emoji_str_result,
    .Ok(emoji_str) => {
      printf("Created emoji string: '😀🌍'\n");
      printf("  Byte length: %zu (expected: 8)\n", emoji_str.as_bytes().len());
      printf("  Character length: %zu (expected: 2)\n", emoji_str.len());
      
      char0_opt := emoji_str.at(usize(0));
      match(char0_opt,
        .Some(char0) => printf("  [0] = 😀 (U+%X)\n", char0.to_u32()),
        .None => printf("  [0] = Error\n")
      );
      
      char1_opt := emoji_str.at(usize(1));
      match(char1_opt,
        .Some(char1) => printf("  [1] = 🌍 (U+%X)\n", char1.to_u32()),
        .None => printf("  [1] = Error\n")
      );
    },
    .Error(_) => { printf("Failed to create emoji string\n"); }
  );

  printf("\n=== All tests completed! ===\n");
};

export main;