// Struct destructuring
main :: (fn() -> unit) {
  Named :: struct(x: i32, y: boolean);
  p := Named(1, false);

  // Destructuring by position
  _(m, n) := p;

  // Destructuring by label
  // Named(.x, .y) := p;

  // Renaming
  _(x: a, y: b) := p;
  i := a;

  // Inferred struct
  {
    _(x, y) := p;
  };
  {
    { x, y } := p;
  };
  {
    _(x: a, y: b) := p;
  };
};

Container :: struct
  x : &(i32),
  y : &!(i32)
;

test :: (fn(c : Container) -> unit) {
  compt_expect_error(
    { x, y } := c
  );
  ()
};