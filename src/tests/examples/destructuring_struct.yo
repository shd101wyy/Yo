// Struct destructuring
main :: (fn() -> unit) {
  Named :: struct(x: i32, y: boolean);
  {
  p := Named(1, false);

  // Destructuring by position
  _(m, n) := p;
  };

  // Destructuring by label
  // Named(.x, .y) := p;

  {
    p := Named(1, false);
    // Renaming
    _(x: a, y: b) := p;
    i := a;
  };

  // Inferred struct
  {
    p := Named(1, false);
    _(x, y) := p;
  };
  {
    p := Named(1, false);
    { x, y } := p;
  };
  {
    p := Named(1, false);
    _(x: a, y: b) := p;
  };
};

Container :: struct
  x : *(i32),
  y : *!(i32)
;

test :: (fn(c : Container) -> unit) {
  { x, y } := c; // allowed
  // using `c` is not allowed, since destructuring it consumes it
  compt_expect_error(test(c));
  ()
};