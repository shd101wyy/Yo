// Struct destructuring
main :: (()-> unit) {
  Named :: struct(x: i32, y: boolean);
  p := Named(1, false);

  // Destructuring by position
  _(m, n) := p;

  // Destructuring by label
  // Named(.x, .y) := p;

  // Renaming
  _(x: a, y: b) := p;
  i := a;

  // Inferred struct
  {
    _(x, y) := p;
  };
  {
    { x, y } := p;
  };
  {
    _(x: a, y: b) := p;
  };
};