compt_expect_error(
  List :: struct
    head : i32,
    tail : Self // Infinite recursion happens here
);

List :: struct
  head : i32,
  tail : *(Self)
;

List2 :: struct
  head : i32,
  tail : *(Self)
;

List3 :: object
  head : i32,
  tail : Self // This is allowed because List5 is a object
;

Worker :: (fn(compt(A) : Type, compt(B) : Type) -> compt(Type)) {
  // The child's view has flipped types
  Child :: recur(B, A);
  
  internal :: (fn(raw : *(void)) -> unit) {
    Child(raw);
  };
  
  return object(
    raw : *(void)
  );
};

Worker2 :: (fn(compt(A) : Type, compt(B) : Type) -> compt(Type)) {
  Child :: recur(B, A);

  object(
    ptr : *(void),
    _test :: (fn(v : *(void)) -> unit)({
      Self(v);
      Child(v);
    })
  )
};
