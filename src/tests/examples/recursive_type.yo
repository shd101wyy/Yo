compt_expect_error(
  List :: struct
    head : i32,
    tail : Self // Infinite recursion happens here
);

List :: struct
  head : i32,
  tail : &(Self)
;

List2 :: struct
  head : i32,
  tail : &(Self)
;

List3 :: struct
  head : i32,
  tail : *(Self)
;

List4 :: struct
  head : i32,
  tail : *(Self)
;

List5 :: ref struct
  head : i32,
  tail : Self // This is allowed because List5 is a ref struct
;
