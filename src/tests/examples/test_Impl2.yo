Id :: module(
  id : (fn(self : Self) -> Self)
);

test :: (fn(forall(T := Impl(Id)), x : T) -> T) {
  y := typeof(x).Id.id(x);
  return y.id();
};

test2 :: (fn(forall((T : Type) = Impl(SomeId : Id)), x : T) -> T) {
  y := typeof(x).SomeId.id(x);
  return y.id();
};

test3 :: (fn(compt(T) := Impl(Id), x : T) -> T) {
  y := typeof(x).Id.id(x);
  return y.id();
};

test4 :: (fn((compt(T) : Type) = Impl(SomeId : Id), x : T) -> T) {
  y := typeof(x).SomeId.id(x);
  return y.id();
};

