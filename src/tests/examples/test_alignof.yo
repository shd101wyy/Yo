open import "std";

// Test primitive types
compt_assert(alignof(u8) == usize(1));
compt_assert(alignof(u16) == usize(2));
compt_assert(alignof(u32) == usize(4));
compt_assert(alignof(u64) == usize(8));
compt_assert(alignof(i8) == usize(1));
compt_assert(alignof(i16) == usize(2));
compt_assert(alignof(i32) == usize(4));
compt_assert(alignof(i64) == usize(8));
compt_assert(alignof(f32) == usize(4));
compt_assert(alignof(f64) == usize(8));

// Test pointer types
compt_assert(alignof(*(u8)) == usize(8));
compt_assert(alignof(*(i32)) == usize(8));

// Test array types (should be same as element type)
compt_assert(alignof([u32; 10]) == usize(4));
compt_assert(alignof([u64; 5]) == usize(8));

// Test struct types
S :: struct(x: u64, y: u32);
compt_assert(alignof(S) == usize(8)); // Should be max alignment (u64 = 8)
