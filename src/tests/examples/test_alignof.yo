open import "std";

// Test primitive types
compt_assert(alignof(u8) == (1).as(usize));
compt_assert(alignof(u16) == (2).as(usize));
compt_assert(alignof(u32) == (4).as(usize));
compt_assert(alignof(u64) == (8).as(usize));
compt_assert(alignof(i8) == (1).as(usize));
compt_assert(alignof(i16) == (2).as(usize));
compt_assert(alignof(i32) == (4).as(usize));
compt_assert(alignof(i64) == (8).as(usize));
compt_assert(alignof(f32) == (4).as(usize));
compt_assert(alignof(f64) == (8).as(usize));

// Test pointer types
compt_assert(alignof(*(u8)) == (8).as(usize));
compt_assert(alignof(*(i32)) == (8).as(usize));

// Test array types (should be same as element type)
compt_assert(alignof([u32; 10]) == (4).as(usize));
compt_assert(alignof([u64; 5]) == (8).as(usize));

// Test struct types
S :: struct(x: u64, y: u32);
compt_assert(alignof(S) == (8).as(usize)); // Should be max alignment (u64 = 8)
