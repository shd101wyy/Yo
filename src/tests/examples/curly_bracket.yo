main :: (fn() -> unit) {
  Point :: struct(x: i32, y: bool);

  p := Point(3, true);
  (p2: Point) = _(3, true);
  (p3: Point) = {x: 3, y: true};
  (p4: Point) = {y: true, x: 3};

  x := 1;
  y := true;
  (p5: Point) = {x, y}; 
  (p6: Point) = {y, x};
  
  {
    { x, y: a } := p;
    a;
  };

  {
    { x: a, y: b } := p;
    a;
    b;
  };
};