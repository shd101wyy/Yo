// Test concurrent GC with background thread
// Allocates many objects while GC thread runs in background

open import "std/libc/stdio";

// Simple object to allocate
Data :: object(
  value: i32,
  flag: boolean
);

main :: (fn() -> unit) {
  printf("Testing concurrent GC with background thread...\n");
  
  // Create many objects to trigger GC
  // The GC thread should run in background while we allocate
  
  iteration := 0;
  while(iteration < 20, {
    // Allocate 1000 objects in each iteration
    i := 0;
    while(i < 1000, {
      obj := Data(value: i, flag: true);
      i = (i + 1);
    });
    
    printf("Iteration %d: allocated 1000 objects\n", iteration);
    
    iteration = (iteration + 1);
  });
  
  printf("All iterations complete! GC thread handled collections in background.\n");
  
  ()
};

export main;
