extern
  malloc:
    ()-> ^!(i32),
  free:
    (^!(i32))-> ()
;

func1 :: (() -> ()) {
  x := malloc();
  x.* = 13;
  free(x);
};

func2 :: (() -> ()) {
  x := malloc();
  y := x;
  // z := x; // Cannot use again.
  // free(x); // Cannot use again
  free(y);
};

func3 :: (() -> ()) {
  x := malloc();
  free(x);
  // y := x; // Cannot use again.
};