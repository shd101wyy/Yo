extern
  @(malloc):
    ()-> ^!(i32),
  @(free):
    (^!(i32))-> unit
;

func1 :: (() -> unit) {
  x := malloc();
  x.* = 13;
  free(x);
};

func2 :: (() -> unit) {
  x := malloc();
  y := x;
  // z := x; // Cannot use again.
  // free(x); // Cannot use again
  free(y);
};

func3 :: (() -> unit) {
  x := malloc();
  free(x);
  // y := x; // Cannot use again.
};