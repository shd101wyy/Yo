main :: (()-> unit) {
  (d: Tuple(a: i32, b: boolean, c: Tuple(x: i32, y: boolean))) = (1, true, (2, false));

  {
    // Destructuring by position
    (m, n, (x, y)) := d;
  };

  {
    // Destructuring by label
    (c: (y: y, x: x), a: m, b: b) := d;
  };

  {
    // Different types of data structures
    SomeStruct :: struct(
      x: i32,
      y: boolean 
    );
    (d: Tuple(a: i32, b: SomeStruct)) = (1, SomeStruct(2, false));
  
    // Support destructuring struct
    (a, _(x, y)) := d;
  };
};