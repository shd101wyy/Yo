extern
  add : (fn(x: i32, y: i32)-> i32),
  sub : (fn(x: i32, y: i32)-> i32),
  mul : (fn(x: i32, y: i32)-> i32),
  div : (fn(x: i32, y: i32)-> i32),
  eq  : (fn(x: i32, y: i32)-> boolean)
;

factoral :: (fn(x: i32)-> i32)
  cond
    (x `eq` 0) => 1,
    true       => (recur(x `sub` 1) `mul` x);

factoral(x: 12);