extern
  add : ((x: i32, y: i32)-> i32),
  sub : ((x: i32, y: i32)-> i32),
  mul : ((x: i32, y: i32)-> i32),
  div : ((x: i32, y: i32)-> i32),
  eq  : ((x: i32, y: i32)-> boolean)
;

factoral :: ((x: i32)-> i32)
  cond
    (x `eq` 0) => 1,
    true       => (recur(x `sub` 1) `mul` x);

factoral(x: 12);