// <: operator is used for subtyping

Id :: module(
  Self : Type,
  id :
    fn(self : Self) -> Self
);

BooleanId :: Id(
  Self : boolean,
  id :
    (self) -> self
);

I32Id :: Id(
  Self : i32,
  id :
    (self) -> self
);

use_id :: 
  (fn(
    forall(T : Type),
    value : T,
    using(IdInstance) : (T <: Id)
  ) -> T) {
  return IdInstance.id(value);
};

x := use_id(12, I32Id);
x2 := use_id(13);

y := use_id(true, BooleanId);
y2 := use_id(false);

compt_expect_error(
  z := use_id(3.4)
);