extern
  add:
    fn(x: i32, y: i32)-> i32
;

// outer scope implicit add
add1 :: (fn(x: i32, y: i32)-> i32)
  add(x, y)
;

main :: (fn() -> unit) {
  // inner scope implicit add
  add2 :: (fn(x: i32, y: i32)-> i32)
    add(x, y)
  ;


  use_add :: (
    fn( x: i32, y: i32, 
      using(some_add) : (fn(x: i32, y: i32)-> i32))-> i32)
    some_add(x, y)
  ;

  // If we define another implicit add at the same scope of `add2`
  // then calling use_add(3, 4) will have ambiguous implicit add args:
  /// 
  // add3 :: (fn(x: i32, y: i32)-> i32)
  //   add(x, y)
  // ;

  use_add(3, 4);
};
