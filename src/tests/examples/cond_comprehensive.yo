
// Test comprehensive cond behavior with compile-time and runtime conditions

extern
  add : ((x: i32, y: i32)-> i32),
  sub : ((x: i32, y: i32)-> i32),
  mul : ((x: i32, y: i32)-> i32),
  div : ((x: i32, y: i32)-> i32),
  eq  : ((x: i32, y: i32)-> boolean),
  lt  : ((x: i32, y: i32)-> i32),
  print_i32 : ((x: i32)-> unit)
;

// Test 1: Compile-time true condition (should only evaluate first body)
test1 :: (()-> i32)
  cond
    true => 42,
    false => (1 `div` 0); // This should never be evaluated due to compile-time true above

// Test 2: Compile-time false conditions followed by true
test2 :: (()-> i32)
  cond
    false => (1 `div` 0), // This should be skipped
    false => (1 `div` 0), // This should be skipped
    true => 100;

// Test 3: Mixed compile-time and runtime conditions
test3 :: ((x: i32)-> i32)
  cond
    false => 10,
    (x `eq` 5) => 20, // Runtime condition
    true => 30;

// Test 4: All runtime conditions
test4 :: ((x: i32, y: i32)-> i32)
  cond
    (x `eq` 0) => 1,
    (x `eq` 1) => 2,
    (y `eq` 2) => 3,
    true => 4;

// Test 5: Type compatibility across branches
test5 :: ((flag: i32)-> i32)
  cond
    (flag `eq` 1) => 100,
    (flag `eq` 2) => 200,
    true => 300;

// Execute tests
print_i32(test1());  // Should print 42
print_i32(test2());  // Should print 100
print_i32(test3(x: 5));  // Should print 20
print_i32(test3(x: 10)); // Should print 30
print_i32(test4(x: 0, y: 0)); // Should print 1
print_i32(test4(x: 1, y: 0)); // Should print 2
print_i32(test4(x: 2, y: 2)); // Should print 3
print_i32(test4(x: 3, y: 3)); // Should print 4
print_i32(test5(flag: 1)); // Should print 100
print_i32(test5(flag: 2)); // Should print 200
print_i32(test5(flag: 3)); // Should print 300
