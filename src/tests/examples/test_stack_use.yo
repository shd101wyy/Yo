open import "std";
open import "std/libc/stdio.yo";

main :: (fn() -> unit) {
  ch := chan(u8);
  
  go {
    arr := Array(u8, 1024 * 24).fill(0); // 24KB array
    // Actually use the array to prevent compiler optimizations
    v1 := arr(0);
    v2 := arr(100);
    v3 := arr(1000);
    sum := ((v1 + v2) + v3);
    ch <- sum;
  }, { stack_size : (1024 * 16) }; // 16KB stack
  
  value := <-(ch).unwrap();
  printf("value=%d\n", value);
};

export main;
