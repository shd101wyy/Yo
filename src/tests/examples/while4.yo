
{ printf } :: import "std/libc/stdio";

// Test 1: continue statement - skip even numbers
sum_odd :: (fn(max : i32) -> i32) {
  result := 0;
  i := i32(0);
  while i < max, {
    i = (i + 1);
    cond(
      ((i % 2) == 0) => continue, 
      true => {
        result = (result + i);
      }
    );
  };
  return result;
};

// Test 2: break statement - stop at first number > 5
find_first_greater_than_five :: (fn(max : i32) -> i32) {
  result := -(1);
  i := i32(0);
  while i < max, {
    i = (i + 1);
    cond(
      (i > 5) => {
        result = i;
        break;
      }, 
      true => () // continue loop
    );
  };
  return result;
};

// Test 3: return statement - early return when condition met
search_value :: (fn(target : i32, max : i32) -> i32) {
  i := i32(0);
  while i < max, {
    i = (i + 1);
    cond(
      (i == target) => { 
        return(i); 
      }, 
      true => () // continue loop
    );
  };
  return -(1); // not found
};

// Test 4: while loop with step and continue
sum_with_step :: (fn(max : i32) -> i32) {
  result := 0;
  i := i32(0);
  while i < max, i = (i + 1), {
    cond(
      ((i % 3) == 0) => continue,
      true => {
        result = (result + i);
      }
    );
  };
  return result;
};

main :: (fn() -> i32) {
  printf("Test 1 - Sum of odd numbers up to 10: %d\n", sum_odd(10));
  printf("Test 2 - First number > 5 up to 20: %d\n", find_first_greater_than_five(20));
  printf("Test 3 - Search for 7 up to 10: %d\n", search_value(7, 10));
  printf("Test 4 - Sum excluding multiples of 3 up to 10: %d\n", sum_with_step(10));
  return 0;
};

export main;