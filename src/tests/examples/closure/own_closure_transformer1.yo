type OwnClosureContext = {
  x: i32;
}

type OwnClosureArgs = {
  y: i32;
}

implements Closure<OwnClosureContext, OwnClosureArgs, ()> {
  apply: (context: OwnClosureContext, args: OwnClosureArgs)-> unit {
    context.x = context.x + args.y;
  }
}

let test = (fn: [=](y: i32)-> unit, y: i32)-> unit {
  fn(y);
}

let main = ()-> {
  var x = 1;
  var func = OwnClosureContext {
    x: x
  };
  test(func, 2);
}