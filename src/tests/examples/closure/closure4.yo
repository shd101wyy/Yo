type Data: Linear;
extern "C" {
  malloc: ()-> Data;
  consume: (x: Data)-> unit;
}

type Context<R:Region> = {
  xRef: &!<Data, R>,
  yRef: &!<i32, R>
}

extern "C" {
  consumeContext: <R:Region>(context: Context<R>)-> unit;
}


// Simulation of mutable closure
let test = ()-> {
  var x = malloc();
  var y = 12;
  {
    var context: Context = {
      xRef: &!x,
      yRef: &!y
    };
    {
      var contextRef = &!context;
      let {xRef, yRef} = &!contextRef;
    }
    consumeContext(context);
  }
  consume(x);
}