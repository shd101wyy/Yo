open import "std/collections";
open import "std/libc/stdio";

test_new_empty_list :: (fn() -> unit) {
  printf("\n[Test] New empty list\n");
  
  list := LinkedList(i32).new();
  
  assert(list.is_empty(), "New list should be empty");
  assert((list.len() == usize(0)), "New list length should be 0");
  
  match(list.front(),
    .None => { printf("✓ Empty list has no front\n"); },
    .Some(_) => panic("Empty list should have no front")
  );
  
  match(list.back(),
    .None => { printf("✓ Empty list has no back\n"); },
    .Some(_) => panic("Empty list should have no back")
  );
  
  printf("✓ New empty list works\n");
};

test_push_front :: (fn() -> unit) {
  printf("\n[Test] Push front\n");
  
  list := LinkedList(i32).new();
  
  list.push_front(i32(1));
  list.push_front(i32(2));
  list.push_front(i32(3));
  
  assert((list.len() == usize(3)), "Length should be 3");
  assert((list.is_empty() == false), "List should not be empty");
  
  match(list.front(),
    .Some(v) => assert((v == i32(3)), "Front should be 3"),
    .None => panic("Front should exist")
  );
  
  match(list.back(),
    .Some(v) => assert((v == i32(1)), "Back should be 1"),
    .None => panic("Back should exist")
  );
  
  printf("✓ Push front works\n");
};

test_push_back :: (fn() -> unit) {
  printf("\n[Test] Push back\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(i32(1));
  list.push_back(i32(2));
  list.push_back(i32(3));
  
  assert((list.len() == usize(3)), "Length should be 3");
  
  match(list.front(),
    .Some(v) => assert((v == i32(1)), "Front should be 1"),
    .None => panic("Front should exist")
  );
  
  match(list.back(),
    .Some(v) => assert((v == i32(3)), "Back should be 3"),
    .None => panic("Back should exist")
  );
  
  printf("✓ Push back works\n");
};

test_pop_front :: (fn() -> unit) {
  printf("\n[Test] Pop front\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(i32(1));
  list.push_back(i32(2));
  list.push_back(i32(3));
  
  match(list.pop_front(),
    .Some(v) => {
      assert((v == i32(1)), "Popped value should be 1");
      printf("✓ Popped front: 1\n");
    },
    .None => panic("Should pop a value")
  );
  
  assert((list.len() == usize(2)), "Length should be 2 after pop");
  
  match(list.front(),
    .Some(v) => assert((v == i32(2)), "New front should be 2"),
    .None => panic("Front should exist")
  );
  
  match(list.pop_front(),
    .Some(v) => assert((v == i32(2)), "Popped value should be 2"),
    .None => panic("Should pop a value")
  );
  
  match(list.pop_front(),
    .Some(v) => assert((v == i32(3)), "Popped value should be 3"),
    .None => panic("Should pop a value")
  );
  
  assert((list.len() == usize(0)), "List should be empty");
  assert(list.is_empty(), "List should be empty");
  
  match(list.pop_front(),
    .None => { printf("✓ Pop from empty list returns None\n"); },
    .Some(_) => panic("Pop from empty should return None")
  );
  
  printf("✓ Pop front works\n");
};

test_pop_back :: (fn() -> unit) {
  printf("\n[Test] Pop back\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(i32(1));
  list.push_back(i32(2));
  list.push_back(i32(3));
  
  match(list.pop_back(),
    .Some(v) => {
      assert((v == i32(3)), "Popped value should be 3");
      printf("✓ Popped back: 3\n");
    },
    .None => panic("Should pop a value")
  );
  
  assert((list.len() == usize(2)), "Length should be 2 after pop");
  
  match(list.back(),
    .Some(v) => assert((v == i32(2)), "New back should be 2"),
    .None => panic("Back should exist")
  );
  
  printf("✓ Pop back works\n");
};

test_get :: (fn() -> unit) {
  printf("\n[Test] Get by index\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(i32(10));
  list.push_back(i32(20));
  list.push_back(i32(30));
  list.push_back(i32(40));
  list.push_back(i32(50));
  
  match(list.get(usize(0)),
    .Some(v) => assert((v == i32(10)), "Index 0 should be 10"),
    .None => panic("Index 0 should exist")
  );
  
  match(list.get(usize(2)),
    .Some(v) => assert((v == i32(30)), "Index 2 should be 30"),
    .None => panic("Index 2 should exist")
  );
  
  match(list.get(usize(4)),
    .Some(v) => assert((v == i32(50)), "Index 4 should be 50"),
    .None => panic("Index 4 should exist")
  );
  
  match(list.get(usize(10)),
    .None => { printf("✓ Out of bounds index returns None\n"); },
    .Some(_) => panic("Out of bounds should return None")
  );
  
  printf("✓ Get works\n");
};

test_insert :: (fn() -> unit) {
  printf("\n[Test] Insert at index\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(i32(10));
  list.push_back(i32(30));
  
  match(list.insert(usize(1), i32(20)),
    .Ok(_) => { printf("✓ Inserted 20 at index 1\n"); },
    .Error(_) => panic("Insert should succeed")
  );
  
  assert((list.len() == usize(3)), "Length should be 3");
  
  match(list.get(usize(0)),
    .Some(v) => assert((v == i32(10)), "Index 0 should be 10"),
    .None => panic("Index 0 should exist")
  );
  
  match(list.get(usize(1)),
    .Some(v) => assert((v == i32(20)), "Index 1 should be 20"),
    .None => panic("Index 1 should exist")
  );
  
  match(list.get(usize(2)),
    .Some(v) => assert((v == i32(30)), "Index 2 should be 30"),
    .None => panic("Index 2 should exist")
  );
  
  match(list.insert(usize(0), i32(5)),
    .Ok(_) => { printf("✓ Inserted 5 at index 0\n"); },
    .Error(_) => panic("Insert at front should succeed")
  );
  
  match(list.front(),
    .Some(v) => assert((v == i32(5)), "Front should be 5"),
    .None => panic("Front should exist")
  );
  
  match(list.insert(usize(4), i32(40)),
    .Ok(_) => { printf("✓ Inserted 40 at end\n"); },
    .Error(_) => panic("Insert at end should succeed")
  );
  
  match(list.back(),
    .Some(v) => assert((v == i32(40)), "Back should be 40"),
    .None => panic("Back should exist")
  );
  
  match(list.insert(usize(100), i32(999)),
    .Error(err) => match(err,
      .IndexOutOfBounds(index, length) => {
        printf("✓ Insert out of bounds returns error\n");
      },
      .EmptyList => panic("Wrong error type")
    ),
    .Ok(_) => panic("Out of bounds insert should fail")
  );
  
  printf("✓ Insert works\n");
};

test_remove :: (fn() -> unit) {
  printf("\n[Test] Remove at index\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(i32(10));
  list.push_back(i32(20));
  list.push_back(i32(30));
  list.push_back(i32(40));
  list.push_back(i32(50));
  
  match(list.remove(usize(2)),
    .Ok(v) => {
      assert((v == i32(30)), "Removed value should be 30");
      printf("✓ Removed value at index 2: 30\n");
    },
    .Error(_) => panic("Remove should succeed")
  );
  
  assert((list.len() == usize(4)), "Length should be 4");
  
  match(list.get(usize(2)),
    .Some(v) => assert((v == i32(40)), "New value at index 2 should be 40"),
    .None => panic("Index 2 should exist")
  );
  
  match(list.remove(usize(0)),
    .Ok(v) => assert((v == i32(10)), "Removed front should be 10"),
    .Error(_) => panic("Remove front should succeed")
  );
  
  match(list.remove(usize(2)),
    .Ok(v) => assert((v == i32(50)), "Removed back should be 50"),
    .Error(_) => panic("Remove back should succeed")
  );
  
  match(list.remove(usize(10)),
    .Error(err) => match(err,
      .IndexOutOfBounds(index, length) => {
        printf("✓ Remove out of bounds returns error\n");
      },
      .EmptyList => panic("Wrong error type")
    ),
    .Ok(_) => panic("Out of bounds remove should fail")
  );
  
  printf("✓ Remove works\n");
};

test_clear :: (fn() -> unit) {
  printf("\n[Test] Clear\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(i32(1));
  list.push_back(i32(2));
  list.push_back(i32(3));
  list.push_back(i32(4));
  list.push_back(i32(5));
  
  assert((list.len() == usize(5)), "Length should be 5");
  
  list.clear();
  
  assert((list.len() == usize(0)), "Length should be 0 after clear");
  assert(list.is_empty(), "List should be empty after clear");
  
  match(list.front(),
    .None => { printf("✓ No front after clear\n"); },
    .Some(_) => panic("Should have no front after clear")
  );
  
  match(list.back(),
    .None => { printf("✓ No back after clear\n"); },
    .Some(_) => panic("Should have no back after clear")
  );
  
  printf("✓ Clear works\n");
};

test_contains :: (fn() -> unit) {
  printf("\n[Test] Contains\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(i32(10));
  list.push_back(i32(20));
  list.push_back(i32(30));
  
  assert(list.has(i32(20), i32.Eq), "List should contain 20");
  printf("✓ List contains 20\n");
  
  assert(list.has(i32(10), i32.Eq), "List should contain 10");
  printf("✓ List contains 10\n");
  
  assert(list.has(i32(30), i32.Eq), "List should contain 30");
  printf("✓ List contains 30\n");
  
  assert((list.has(i32(99), i32.Eq) == false), "List should not contain 99");
  printf("✓ List does not contain 99\n");
  
  printf("✓ Contains works\n");
};

test_reverse :: (fn() -> unit) {
  printf("\n[Test] Reverse\n");
  
  list := LinkedList(i32).new();
  
  list.push_back(i32(1));
  list.push_back(i32(2));
  list.push_back(i32(3));
  list.push_back(i32(4));
  list.push_back(i32(5));
  
  list.reverse();
  
  match(list.get(usize(0)),
    .Some(v) => assert((v == i32(5)), "Index 0 should be 5 after reverse"),
    .None => panic("Index 0 should exist")
  );
  
  match(list.get(usize(1)),
    .Some(v) => assert((v == i32(4)), "Index 1 should be 4 after reverse"),
    .None => panic("Index 1 should exist")
  );
  
  match(list.get(usize(2)),
    .Some(v) => assert((v == i32(3)), "Index 2 should be 3 after reverse"),
    .None => panic("Index 2 should exist")
  );
  
  match(list.get(usize(3)),
    .Some(v) => assert((v == i32(2)), "Index 3 should be 2 after reverse"),
    .None => panic("Index 3 should exist")
  );
  
  match(list.get(usize(4)),
    .Some(v) => assert((v == i32(1)), "Index 4 should be 1 after reverse"),
    .None => panic("Index 4 should exist")
  );
  
  match(list.front(),
    .Some(v) => assert((v == i32(5)), "Front should be 5 after reverse"),
    .None => panic("Front should exist")
  );
  
  match(list.back(),
    .Some(v) => assert((v == i32(1)), "Back should be 1 after reverse"),
    .None => panic("Back should exist")
  );
  
  printf("✓ Reverse works\n");
};

test_mixed_operations :: (fn() -> unit) {
  printf("\n[Test] Mixed operations\n");
  
  list := LinkedList(i32).new();
  
  list.push_front(i32(3));
  list.push_back(i32(4));
  list.push_front(i32(2));
  list.push_back(i32(5));
  list.push_front(i32(1));
  
  assert((list.len() == usize(5)), "Length should be 5");
  
  match(list.get(usize(0)),
    .Some(v) => assert((v == i32(1)), "Element 0 should be 1"),
    .None => panic("Index 0 should exist")
  );
  
  match(list.get(usize(4)),
    .Some(v) => assert((v == i32(5)), "Element 4 should be 5"),
    .None => panic("Index 4 should exist")
  );
  
  {
    _ := list.pop_front();
  };
  {
    _ := list.pop_back();
  };
  
  assert((list.len() == usize(3)), "Length should be 3");
  
  match(list.front(),
    .Some(v) => assert((v == i32(2)), "Front should be 2"),
    .None => panic("Front should exist")
  );
  
  match(list.back(),
    .Some(v) => assert((v == i32(4)), "Back should be 4"),
    .None => panic("Back should exist")
  );
  
  printf("✓ Mixed operations work\n");
};

test_single_element :: (fn() -> unit) {
  printf("\n[Test] Single element operations\n");
  
  list := LinkedList(i32).new();
  
  list.push_front(i32(42));
  
  assert((list.len() == usize(1)), "Length should be 1");
  
  match(list.front(),
    .Some(v) => assert((v == i32(42)), "Front should be 42"),
    .None => panic("Front should exist")
  );
  
  match(list.back(),
    .Some(v) => assert((v == i32(42)), "Back should be 42"),
    .None => panic("Back should exist")
  );
  
  match(list.pop_front(),
    .Some(v) => assert((v == i32(42)), "Popped value should be 42"),
    .None => panic("Should pop value")
  );
  
  assert(list.is_empty(), "List should be empty");
  
  printf("✓ Single element operations work\n");
};

main :: (fn() -> unit) {  
  printf("=== LinkedList Tests ===\n");
  
  test_new_empty_list();
  test_push_front();
  test_push_back();
  test_pop_front();
  test_pop_back();
  test_get();
  test_insert();
  test_remove();
  test_clear();
  test_contains();
  test_reverse();
  test_mixed_operations();
  test_single_element();
  
  printf("\n=== All LinkedList tests passed! ===\n");
  return;
};

export main;
