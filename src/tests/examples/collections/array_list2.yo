
{ printf } :: import "std/libc/stdio";
{ ArrayList } :: import "std/collections/array_list";

main :: (fn() -> unit) {
  printf("=== ArrayList remove() and slice() tests ===\n\n");
  
  // Test 1: Basic remove operation
  printf("Test 1: Basic remove operation\n");
  list1 := ArrayList(i32).new();
  list1.push(i32(10));
  list1.push(i32(20));
  list1.push(i32(30));
  list1.push(i32(40));
  list1.push(i32(50));
  
  printf("Initial list: [10, 20, 30, 40, 50], length: %zu\n", list1.len());
  
  // Remove 2 elements starting from index 1 (remove 20 and 30)
  remove_result1 := list1.remove(usize(1), usize(2));
  match(remove_result1,
    .Ok(removed) => printf("Removed %zu elements\n", removed),
    .Error(err) => printf("Error removing elements\n")
  );
  
  printf("After removing 2 elements from index 1: ");
  i := usize(0);
  while(i < list1.len(), i = (i + usize(1)), {
    elem := list1.get(i);
    match(elem,
      .Some(val) => { printf("%d ", val); },
      .None => ()
    );
  });
  printf("(length: %zu)\n\n", list1.len());
  
  // Test 2: Remove from beginning
  printf("Test 2: Remove from beginning\n");
  list2 := ArrayList(i32).new();
  list2.push(i32(100));
  list2.push(i32(200));
  list2.push(i32(300));
  list2.push(i32(400));
  
  printf("Initial list: [100, 200, 300, 400]\n");
  remove_result2 := list2.remove(usize(0), usize(2));
  match(remove_result2,
    .Ok(removed) => printf("Removed %zu elements from beginning\n", removed),
    .Error(err) => printf("Error\n")
  );
  
  printf("After removal: ");
  i2 := usize(0);
  while(i2 < list2.len(), i2 = (i2 + usize(1)), {
    elem := list2.get(i2);
    match(elem,
      .Some(val) => { printf("%d ", val); },
      .None => ()
    );
  });
  printf("\n\n");
  
  // Test 3: Remove from end
  printf("Test 3: Remove from end\n");
  list3 := ArrayList(i32).new();
  list3.push(i32(1));
  list3.push(i32(2));
  list3.push(i32(3));
  list3.push(i32(4));
  list3.push(i32(5));
  
  printf("Initial list: [1, 2, 3, 4, 5]\n");
  remove_result3 := list3.remove(usize(3), usize(5));
  match(remove_result3,
    .Ok(removed) => printf("Removed %zu elements from end (requested 5, only 2 available)\n", removed),
    .Error(err) => printf("Error\n")
  );
  
  printf("After removal: ");
  i3 := usize(0);
  while(i3 < list3.len(), i3 = (i3 + usize(1)), {
    elem := list3.get(i3);
    match(elem,
      .Some(val) => { printf("%d ", val); },
      .None => ()
    );
  });
  printf("\n\n");
  
  // Test 4: Remove with out of bounds index
  printf("Test 4: Remove with out of bounds index\n");
  list4 := ArrayList(i32).new();
  list4.push(i32(10));
  list4.push(i32(20));
  
  remove_result4 := list4.remove(usize(5), usize(1));
  match(remove_result4,
    .Ok(removed) => printf("Unexpectedly succeeded\n"),
    .Error(err) => printf("Correctly returned error for out of bounds index\n")
  );
  printf("\n");
  
  // Test 5: Basic slice operation
  printf("Test 5: Basic slice operation\n");
  list5 := ArrayList(i32).new();
  list5.push(i32(10));
  list5.push(i32(20));
  list5.push(i32(30));
  list5.push(i32(40));
  list5.push(i32(50));
  
  printf("Original list: [10, 20, 30, 40, 50]\n");
  
  slice_result := list5.slice(usize(1), usize(4));
  match(slice_result,
    .Ok(sliced) => {
      printf("Sliced [1:4]: ");
      i5 := usize(0);
      while(i5 < sliced.len(), i5 = (i5 + usize(1)), {
        elem := sliced.get(i5);
        match(elem,
          .Some(val) => { printf("%d ", val); },
          .None => ()
        );
      });
      printf("(length: %zu)\n", sliced.len());
    },
    .Error(err) => { printf("Error slicing\n"); }
  );
  
  printf("Original list unchanged: ");
  i5_check := usize(0);
  while(i5_check < list5.len(), i5_check = (i5_check + usize(1)), {
    elem := list5.get(i5_check);
    match(elem,
      .Some(val) => { printf("%d ", val); },
      .None => ()
    );
  });
  printf("\n\n");
  
  // Test 6: Slice from beginning
  printf("Test 6: Slice from beginning\n");
  slice_begin := list5.slice(usize(0), usize(3));
  match(slice_begin,
    .Ok(sliced) => {
      printf("Sliced [0:3]: ");
      i6 := usize(0);
      while(i6 < sliced.len(), i6 = (i6 + usize(1)), {
        elem := sliced.get(i6);
        match(elem,
          .Some(val) => { printf("%d ", val); },
          .None => ()
        );
      });
      printf("\n");
    },
    .Error(err) => { printf("Error\n"); }
  );
  printf("\n");
  
  // Test 7: Slice to end
  printf("Test 7: Slice to end\n");
  slice_end := list5.slice(usize(2), usize(5));
  match(slice_end,
    .Ok(sliced) => {
      printf("Sliced [2:5]: ");
      i7 := usize(0);
      while(i7 < sliced.len(), i7 = (i7 + usize(1)), {
        elem := sliced.get(i7);
        match(elem,
          .Some(val) => { printf("%d ", val); },
          .None => ()
        );
      });
      printf("\n");
    },
    .Error(err) => { printf("Error\n"); }
  );
  printf("\n");
  
  // Test 8: Empty slice
  printf("Test 8: Empty slice\n");
  empty_slice := list5.slice(usize(2), usize(2));
  match(empty_slice,
    .Ok(sliced) => printf("Empty slice [2:2] length: %zu\n", sliced.len()),
    .Error(err) => printf("Error\n")
  );
  printf("\n");
  
  // Test 9: Slice with invalid indices
  printf("Test 9: Slice with invalid indices\n");
  invalid_slice1 := list5.slice(usize(3), usize(2));
  match(invalid_slice1,
    .Ok(sliced) => printf("Unexpectedly succeeded\n"),
    .Error(err) => printf("Correctly returned error for start > end\n")
  );
  
  invalid_slice2 := list5.slice(usize(0), usize(10));
  match(invalid_slice2,
    .Ok(sliced) => printf("Unexpectedly succeeded\n"),
    .Error(err) => printf("Correctly returned error for end > length\n")
  );
  printf("\n");
  
  // Test 10: Combined operations
  printf("Test 10: Combined remove and slice operations\n");
  list10 := ArrayList(i32).new();
  list10.push(i32(5));
  list10.push(i32(10));
  list10.push(i32(15));
  list10.push(i32(20));
  list10.push(i32(25));
  list10.push(i32(30));
  
  printf("Initial: [5, 10, 15, 20, 25, 30]\n");
  
  // First, slice [1:5] to get [10, 15, 20, 25]
  combined_slice := list10.slice(usize(1), usize(5));
  match(combined_slice,
    .Ok(sliced) => {
      printf("After slice [1:5]: ");
      ic := usize(0);
      while(ic < sliced.len(), ic = (ic + usize(1)), {
        elem := sliced.get(ic);
        match(elem,
          .Some(val) => { printf("%d ", val); },
          .None => ()
        );
      });
      printf("\n");
      
      // Then remove 2 elements from index 1 to get [10, 25]
      sliced.remove(usize(1), usize(2));
      printf("After remove(1, 2): ");
      ic2 := usize(0);
      while(ic2 < sliced.len(), ic2 = (ic2 + usize(1)), {
        elem := sliced.get(ic2);
        match(elem,
          .Some(val) => { printf("%d ", val); },
          .None => ()
        );
      });
      printf("\n");
    },
    .Error(err) => { printf("Error\n"); }
  );
  
  printf("\n=== All tests completed ===\n");
  return;
};

export main;
