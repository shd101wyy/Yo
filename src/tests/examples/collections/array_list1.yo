
{ printf } :: import "std/libc/stdio";
{ ArrayList } :: import "std/collections/array_list";

main :: (fn() -> unit) {
  // Create a new ArrayList of i32
  list := ArrayList(i32).new();
  
  // Push some elements
  list.push(i32(42));
  list.push(i32(100));
  list.push(i32(200));
  
  printf("ArrayList length: %zu\n", list.length());
  printf("ArrayList capacity: %zu\n", list.capacity());
  
  // Get elements by index
  first := list.get(usize(0));
  match(first,
    .Some(value) => printf("First element: %d\n", value),
    .None => printf("No first element\n")
  );
  
  // Set an element
  list.set(usize(1), i32(150));
  
  second := list.get(usize(1));
  match(second,
    .Some(value) => printf("Second element after set: %d\n", value),
    .None => printf("No second element\n")
  );
  
  // Pop an element
  popped := list.pop();
  match(popped,
    .Some(value) => printf("Popped value: %d\n", value),
    .None => printf("List is empty\n")
  );
  
  printf("Length after pop: %zu\n", list.length());
  
  // Shrink to fit
  list.shrink_to_fit();
  printf("Capacity after shrink: %zu\n", list.capacity());
  
  // Create ArrayList with initial capacity
  list2 := ArrayList(i32).with_capacity(usize(10));
  printf("List2 initial capacity: %zu\n", list2.capacity());
  
  // Clear the list
  list.clear();
  printf("Length after clear: %zu\n", list.length());
  
  return;
};

export main;
