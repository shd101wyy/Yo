// _ can only be used to infer a type value.
main :: (()-> unit) {
  
  Point :: struct(i32, i32);
  {
    (p: Point) = Point(3, 4);
    (p2: Point) = _(3, 4); // _ should be inferred as Point
  };

  Color :: enum Red, Green, Blue;
  {
    (c: Color) = Color.Red;
    (c2: Color) = .Red;
  };

  {
    Shape :: enum
      Circle(r: i32),
      Rectangle(w: i32, h: i32);
    (c: Shape) = Shape.Circle(3);
    (c2: Shape) = .Rectangle(3, 4);
  };

  color_identity :: ((color: Color)-> Color)
    color
  ;
  {
    c := color_identity(Color.Red);
    c2 := color_identity(.Red);
  };

  NestedEnum :: enum
    Level1(
      x: enum Level2(i32)
    );
  {
    n := NestedEnum.Level1(.Level2(3));
    (n2 : NestedEnum) = .Level1(.Level2(3));
  };
};