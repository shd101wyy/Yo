open import "std";

// Create closure by calling ClosureType.

test1 :: (() -> unit) {
  mut(x) := 12;
  closure := Closure(_, FnOnce(val: i32) -> i32) {
    return x + val;
  };
  closure(3);
  compt_expect_error(
    closure(4),
    "closure is consumed in the previous call"
  );
};

test2 :: (() -> unit) {
  mut(x) := 12;
  closure := Closure(struct(x : i32), FnOnce(val: i32) -> i32) {
    return x + val;
  };
  closure(3);
  closure(4); // This is allowed, because struct(x : i32) is Free
};
