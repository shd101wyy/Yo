open import "std";

// Create closure by calling ClosureType.

test1 :: (fn() -> unit) {
  mut(x) := 12;
  closure := Closure(FnOnce(val: i32) -> i32, _) {
    return x + val;
  };
  closure(3);
  closure(4);
};

test2 :: (fn() -> unit) {
  mut(x) := 12;
  closure := Closure(FnOnce(val: i32) -> i32, struct(x : i32)) {
    return x + val;
  };
  closure(3);
  closure(4); // This is allowed, because struct(x : i32) is Free
};
