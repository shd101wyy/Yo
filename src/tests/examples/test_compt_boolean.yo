open import "std";

/**
 * Test compile-time boolean operations
 * This file tests the __yo_compt_boolean_* functions that operate
 * on compile-time known boolean values.
 */
main :: (()-> unit) {
  // Basic boolean literals
  true_val :: true;
  false_val :: false;
  
  // Test logical AND operations
  {
    // All combinations of AND
    and_tt :: (true_val && true_val);     // true
    and_tf :: (true_val && false_val);    // false
    and_ft :: (false_val && true_val);    // false
    and_ff :: (false_val && false_val);   // false
    
    // Verify results with assertions
    compt_assert(and_tt == true);
    compt_assert(and_tf == false);
    compt_assert(and_ft == false);
    compt_assert(and_ff == false);
  };
  
  // Test logical OR operations
  {
    // All combinations of OR
    or_tt :: (true_val || true_val);      // true
    or_tf :: (true_val || false_val);     // true
    or_ft :: (false_val || true_val);     // true
    or_ff :: (false_val || false_val);    // false
    
    // Verify results with assertions
    compt_assert(or_tt == true);
    compt_assert(or_tf == true);
    compt_assert(or_ft == true);
    compt_assert(or_ff == false);
  };
  
  // Test logical NOT operations
  {
    not_true :: not(true_val);          // false
    not_false :: not(false_val);        // true
    
    // Double negation
    not_not_true :: not(not(true_val)); // true
    not_not_false :: not(not(false_val)); // false
    
    // Verify results
    compt_assert(not_true == false);
    compt_assert(not_false == true);
    compt_assert(not_not_true == true);
    compt_assert(not_not_false == false);
  };
  
  // Test equality operations
  {
    eq_tt :: (true_val == true_val);      // true
    eq_tf :: (true_val == false_val);     // false
    eq_ft :: (false_val == true_val);     // false
    eq_ff :: (false_val == false_val);    // true
    
    // Verify results
    compt_assert(eq_tt == true);
    compt_assert(eq_tf == false);
    compt_assert(eq_ft == false);
    compt_assert(eq_ff == true);
  };
  
  // Test inequality operations
  {
    neq_tt :: (true_val != true_val);     // false
    neq_tf :: (true_val != false_val);    // true
    neq_ft :: (false_val != true_val);    // true
    neq_ff :: (false_val != false_val);   // false
    
    // Verify results
    compt_assert(neq_tt == false);
    compt_assert(neq_tf == true);
    compt_assert(neq_ft == true);
    compt_assert(neq_ff == false);
  };
  
  // Test string conversion
  {
    true_str :: true_val.to_string();   // "true"
    false_str :: false_val.to_string(); // "false"
    
    // Verify string conversions
    compt_assert(true_str == "true");
    compt_assert(false_str == "false");
  };
  
  // Test complex boolean expressions
  {
    // De Morgan's Laws
    // !(A && B) == (!A || !B)
    demorgan1_left :: not((true_val && false_val));
    demorgan1_right :: (not(true_val) || not(false_val));
    compt_assert(demorgan1_left == demorgan1_right);
    
    // !(A || B) == (!A && !B)
    demorgan2_left :: not((true_val || false_val));
    demorgan2_right :: (not(true_val) && not(false_val));
    compt_assert(demorgan2_left == demorgan2_right);
    
    // Distributive properties
    // A && (B || C) == (A && B) || (A && C)
    a :: true_val;
    b :: false_val;
    c :: true_val;
    
    distrib_left :: (a && (b || c));
    distrib_right :: ((a && b) || (a && c));
    compt_assert(distrib_left == distrib_right);
    
    // Identity laws
    // A && true == A
    identity_and :: (a && true);
    compt_assert(identity_and == a);
    
    // A || false == A
    identity_or :: (a || false);
    compt_assert(identity_or == a);
    
    // Annihilation laws
    // A && false == false
    annihil_and :: (a && false);
    compt_assert(annihil_and == false);
    
    // A || true == true
    annihil_or :: (a || true);
    compt_assert(annihil_or == true);
    
    // Idempotent laws
    // A && A == A
    idemp_and :: (a && a);
    compt_assert(idemp_and == a);
    
    // A || A == A
    idemp_or :: (a || a);
    compt_assert(idemp_or == a);
  };
  
  // Test nested expressions
  {
    // Complex nested boolean expression
    complex1 :: ((true_val && false_val) || (not(false_val) && true_val));
    compt_assert(complex1 == true);
    
    // Another complex expression
    complex2 :: not(((true_val || false_val) && not((true_val == false_val))));
    compt_assert(complex2 == false);
    
    // Triple nested expression
    complex3 :: (((true_val && not(false_val)) || false_val) == (true_val || (false_val && not(true_val))));
    compt_assert(complex3 == true);
  };
  
  // Test with computed boolean values
  {
    // Use results from other operations
    computed1 :: (true_val == true_val);  // true
    computed2 :: (false_val != true_val); // true
    
    and_computed :: (computed1 && computed2); // true && true = true
    or_computed :: (computed1 || computed2);  // true || true = true
    
    compt_assert(and_computed == true);
    compt_assert(or_computed == true);
    
    // Negation of computed values
    not_computed1 :: not(computed1); // not(true) = false
    not_computed2 :: not(computed2); // not(true) = false
    
    compt_assert(not_computed1 == false);
    compt_assert(not_computed2 == false);
  };
  
  // Exhaustive truth table tests
  {
    // AND truth table
    compt_assert((true && true) == true);
    compt_assert((true && false) == false);
    compt_assert((false && true) == false);
    compt_assert((false && false) == false);
    
    // OR truth table
    compt_assert((true || true) == true);
    compt_assert((true || false) == true);
    compt_assert((false || true) == true);
    compt_assert((false || false) == false);
    
    // NOT truth table
    compt_assert(not(true) == false);
    compt_assert(not(false) == true);
    
    // EQ truth table
    compt_assert((true == true) == true);
    compt_assert((true == false) == false);
    compt_assert((false == true) == false);
    compt_assert((false == false) == true);
    
    // NEQ truth table
    compt_assert((true != true) == false);
    compt_assert((true != false) == true);
    compt_assert((false != true) == true);
    compt_assert((false != false) == false);
  };
  
  ()
};