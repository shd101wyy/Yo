extern
  (eq): (fn(x: i32, y: i32) -> boolean),
  (gt): (fn(x: i32, y: i32)-> boolean),
  (mul): (fn(x: i32, y: i32) -> i32),
  (add): (fn(x: i32, y: i32) -> i32),
  (sub): (fn(x: i32, y: i32) -> i32)
;

factorial_fn :: (fn(x: i32) -> i32);


// Without given type
/*
// NOTE: We don't allow to specify the signature of the function anymore.
factorial := ((fn(x: i32): i32)-> {
  cond
    (x `eq` 0) -> 1,
    (x `gt` 0) -> (x `mul` recur(x `sub` 1))  
});
n := factorial(10);
*/


// With given type
(compt(factorial2) : factorial_fn) = 
  (a)->
    cond
      (a `eq` 0) => 1,
      true => (a `mul` recur(a `sub` 1))  
;



// With given type and fn implementaion has no type
(compt(factorial3): factorial_fn) = 
  (a)->
    cond
      (a `eq` 0) => 1,
      true => (a `mul` recur(a `sub` 1))  
;


call_fn :: (fn(cb: (fn(x: i32) -> i32), a: i32)-> i32)
  cb(a)
;
call_fn(factorial2, 10);
call_fn(factorial3, 11);
call_fn((x -> x), 12);
