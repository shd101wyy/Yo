main :: (fn() -> unit) {
  SomeModule :: module {
    id :: (fn(x: i32)-> i32) x;
    given(implicit_id) :: (fn(x: i32)-> i32) x;
    x :: 1;
    y :: 2;
    export id, implicit_id, x, y;
  };

  {
    // Use ... to destructure all exports
    { ... } :: SomeModule;
    v := id(3);


    Point :: struct(a: i32, b: i32);
    p :: Point 3, 4;
    { ... } :: p;
    x2 := id(a);
  };

  {
    // Use ...(given) to destructure all implicits
    { ...(given) } :: SomeModule;
    
    implicit_id(3);
    
    compt_expect_error(
      id(3) // "id" is not imported here, so it should not be accessible
    );
  }
};