extern
  add:
    fn(x: i32, y: i32)-> i32
;

// Normal function
add_1 :: (fn(x: i32, y: i32)-> i32)
  add(x, y)
;
add_1(3, 4);
add_1(x: 3, y: 4);
add_1(x: 4, 3);

compt_expect_error(
  add_1(y: 4, x: 3)
  "Named arguments must be in the same order as the function definition"
);

// Generic function
id :: (fn(compt(T): Type, x: T)-> T)
  x;
id(i32, 12);
id(T: i32, x: 12);
