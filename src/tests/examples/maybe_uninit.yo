

extern "C",
  time_t : Type,
  time : 
    fn(timer: ?*(time_t)) -> time_t
;

func2 :: (fn() -> unit) {
  uninitialized_timer := MaybeUninit(time_t).new();  // uninitialized_timer is a Uninit(time_t) type
  ptr := (&(uninitialized_timer)).as_mut_ptr();
  time(.Some(ptr));     // initialize the timer
  timer := uninitialized_timer.assume_init();    // assume_init() converts Uninit to a regular type
};