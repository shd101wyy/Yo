flag1 :: are_types_compatible(i32, i32); // true
flag2 :: are_types_compatible(i32, i64); // false
flag3 :: are_types_compatible(i64, i32); // false

// Functions
flag4 :: are_types_compatible( // true
  (x: i32, y: i32)-> i32,
  (a: i32, y: i32)-> i32
);
flag5 :: are_types_compatible( // true
  (forall(@(T): Type), x: T, y: T)-> T,
  (forall(@(Z): Type), a: Z, b: Z)-> Z
);
flag6 :: are_types_compatible( // false
  (forall(@(T): Type), x: T, y: T)-> T,
  (a: i32, b: i32)-> i32
);
flag7 :: are_types_compatible( // false
  (a: i32, b: i32)-> i32,
  (forall(@(T): Type), x: T, y: T)-> T
);

Box :: ((@(T): Type)-> @(Type))
  struct(T) // Below is false because T here doesn't have a label
            // So it's using a generated label. Box(T) and Box(Z) generated different labels.  
            // QUESTION: Should we always require label for struct fields?
;
flag8 :: are_types_compatible( // false
  (forall(@(T): Type), x: T)-> Box(T),
  (forall(@(Z): Type), a: Z)-> Box(Z)
);

Box2 :: ((@(T): Type)-> @(Type))
  struct(x: T)
;
flag8_1 :: are_types_compatible( // true
  (forall(@(T): Type), x: T)-> Box2(T),
  (forall(@(Z): Type), a: Z)-> Box2(Z)
);

Point :: ((@(T): Type)-> @(Type))
  struct(x: T, y: T)
;
flag9 :: are_types_compatible( // true
  (forall(@(T): Type), x: T, y: T)-> Point(T),
  (forall(@(Z): Type), a: Z, b: Z)-> Point(Z)
);
