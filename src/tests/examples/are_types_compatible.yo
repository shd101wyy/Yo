open import "std";

compt_assert(__yo_are_types_compatible(i32, i32) == true); // true
compt_assert(__yo_are_types_compatible(i32, i64) == false); // false
compt_assert(__yo_are_types_compatible(i64, i32) == false); // false

// Functions
compt_assert(__yo_are_types_compatible( // true
  (x: i32, y: i32)-> i32,
  (a: i32, y: i32)-> i32
) == true);
compt_assert(__yo_are_types_compatible( // true
  (forall(compt(T): Type), x: T, y: T)-> T,
  (forall(compt(Z): Type), a: Z, b: Z)-> Z
) == true);
compt_assert(__yo_are_types_compatible( // false
  (forall(compt(T): Type), x: T, y: T)-> T,
  (a: i32, b: i32)-> i32
) == false);
compt_assert(__yo_are_types_compatible( // false
  (a: i32, b: i32)-> i32,
  (forall(compt(T): Type), x: T, y: T)-> T
) == false);

Box :: ((compt(T): Type)-> compt(Type))
  struct(value: T)
;

compt_assert(__yo_are_types_compatible( // true
  (forall(compt(T): Type), x: T)-> Box(T),
  (forall(compt(Z): Type), a: Z)-> Box(Z)
) == true);

Point :: ((compt(T): Type)-> compt(Type))
  struct(x: T, y: T)
;
compt_assert(__yo_are_types_compatible( // true
  (forall(compt(T): Type), x: T, y: T)-> Point(T),
  (forall(compt(Z): Type), a: Z, b: Z)-> Point(Z)
) == true);


RefFunc1 ::
  (x : &(i32)) -> unit;

RefFunc2 ::
  (x : &!(i32)) -> unit;

compt_assert(__yo_are_types_compatible(RefFunc1, RefFunc2) == false);
compt_assert(__yo_are_types_compatible(RefFunc2, RefFunc1) == true);

// Test pointer type compatibility
PtrFunc1 ::
  (x : *(i32)) -> unit;

PtrFunc2 ::
  (x : *!(i32)) -> unit;

compt_assert(__yo_are_types_compatible(PtrFunc1, PtrFunc2) == false);
compt_assert(__yo_are_types_compatible(PtrFunc2, PtrFunc1) == true);
