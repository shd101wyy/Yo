

compt_assert(__yo_are_types_compatible(i32, i32) == true); // true
compt_assert(__yo_are_types_compatible(i32, i64) == false); // false
compt_assert(__yo_are_types_compatible(i64, i32) == false); // false

// Functions
compt_assert(__yo_are_types_compatible( // true
  fn(x: i32, y: i32)-> i32,
  fn(a: i32, y: i32)-> i32
) == true);
compt_assert(__yo_are_types_compatible( // true
  fn(forall(T: Type), x: T, y: T)-> T,
  fn(forall(Z: Type), a: Z, b: Z)-> Z
) == true);
compt_assert(__yo_are_types_compatible( // false
  fn(forall(T: Type), x: T, y: T)-> T,
  fn(a: i32, b: i32)-> i32
) == false);
compt_assert(__yo_are_types_compatible( // false
  fn(a: i32, b: i32)-> i32,
  fn(forall(T: Type), x: T, y: T)-> T
) == false);

MyBox :: (fn(compt(T): Type)-> compt(Type))
  struct(value: T)
;

compt_assert(__yo_are_types_compatible( // true
  fn(forall(T: Type), x: T)-> MyBox(T),
  fn(forall(Z: Type), a: Z)-> MyBox(Z)
) == true);

Point :: (fn(compt(T): Type)-> compt(Type))
  struct(x: T, y: T)
;
compt_assert(__yo_are_types_compatible( // true
  fn(forall(T: Type), x: T, y: T)-> Point(T),
  fn(forall(Z: Type), a: Z, b: Z)-> Point(Z)
) == true);

// Test pointer type compatibility
PtrFunc1 ::
  fn(x : *(i32)) -> unit;

PtrFunc2 ::
  fn(x : *(i32)) -> unit;

compt_assert(__yo_are_types_compatible(PtrFunc1, PtrFunc2) == true);
compt_assert(__yo_are_types_compatible(PtrFunc2, PtrFunc1) == true);
