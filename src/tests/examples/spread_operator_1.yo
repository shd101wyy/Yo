// Spread operator in structs
_2DPoint :: struct(
  x : i32,
  y : i32
);

_3DPoint :: struct(
  ...(_2DPoint),
  z : i32
);

p :: _3DPoint(3, 4, 5);

anonymous_struct := { x: 1, y: 2 };
// another_anonymous_struct := { ...(anonymous_struct), z: 3 };

ModuleA :: impl {
  a :: 1;
  export a;
};

ModuleB :: impl {
  b :: 2;
  export b;
};

ModuleC :: impl {
  export
    ...(ModuleA),
    ...(ModuleB)
  ;
};

/*
Combined :: {
  ...(ModuleA),
  ...(ModuleB)
};
*/
// Syntax above is not supported, because it's for struct.
Combined :: impl {
  export ...(ModuleA),
         ...(ModuleB);
};
