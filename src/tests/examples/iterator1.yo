/*
Iterator :: (fn(compt(Item) : Type) -> compt(Module)) {
  return module(
    Item := Item,
    next :
      fn(self : *(Self)) -> Option(Self.Item)
  );
};

IntoIterator :: (fn(
  compt(Item) : Type,
  compt(IntoIter) : Type,
  using(IntoIterIter) : (IntoIter <: Iterator(Item))) -> compt(Module)) {
  return module(
    Item := Item,
    IntoIter := IntoIter,
    into_iter : 
      fn(self : Self) -> Self.IntoIter
  );
};
*/

MyBox :: struct(
  x : i32,

  IntoIter :: struct(
    current : i32,

    Iterator :: impl(Self, Iterator(i32)(
      next : ((self) ->
        cond(
          (self.current == 0) => .None,
          true => {
            current := self.current;
            self.current = (self.current - 1);
            .Some(current)
          }
        ))
    ))
  ),

  IntoIterator :: impl(Self, IntoIterator(i32, Self.IntoIter)(
    into_iter : ((self) -> Self.IntoIter(self.x))
  ))
);

