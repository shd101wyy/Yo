// Arity
// Function overloading
// We allow functions to be overloaded based on the number of runtime arguments (without default value) they take.

open import "std";

AddModule :: module(
  add1 :
    ((x : i32) -> i32),
  add2 :
    ((x : i32, y : i32) -> i32),
  add3 :
    ((x : i32, y : i32, z : i32) -> i32),
  add4 :
    ((x : i32, y : i32, z : i32, w : i32) -> i32), // This function is not used in the example.
  // Self := add1,
  Self := (add1, add2, add3) // This allows the module to be called like normal function.
);

add :: AddModule(
  add1 :
    fn(x) -> x,
  add2 :
    fn(x, y) -> (x + y),
  add3 :
    fn(x, y, z) -> ((x + y) + z),
  add4 :
    fn(x, y, z, w) -> (((x + y) + z) + w)
);

// Calling a module will try to call all of its functions with the given arguments.
// Nice idea!
add(1);
add(2, 3);
add(3, 4, 5);
compt_expect_error(
add(4, 5, 6, 7) // This will not work because add4 is not used in "Self".
);