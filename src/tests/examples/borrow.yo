// Borrow
extern
  gt:
    (x: i32, y: i32)-> boolean
;

main :: (()-> ()) {
  mut(x) := 12;

  expect_compile_error(
    // "Cannot borrow `x` as mutable and immutable at the same time.",
    borrow (&(x), &!(x)), (x_ref, x_mut_ref)-> {
      // ^ Error. Cannot borrow `x` as mutable and immutable at the same time.
      y := x_ref.*;
      y := x_mut_ref.*;
    }
  );

  borrow (&(x)), (x_ref)-> {
    y := x_ref.*;
    expect_compile_error(
      z := x // error, because `x` is borrowed.
    );
    expect_compile_error(
      x = 13 // error, because `x` is borrowed.
          // assignment here is like using the mutable reference of `x`
    );
  };

  Point :: struct(
    x: i32,
    y: i32
  );
  mut(p) := Point(1, 2);

  borrow (&(p.x)), (p_x_ref) -> {
    x := p_x_ref.*;
    
    expect_compile_error(
      p.x = 13 // Not allowed. Because `p.x` is borrowed.
    );

    p.y = 3; // Allowed, because only `p.x` is borrowed.
             // There is no path overlap with `p.y`.

    expect_compile_error(
      p = Point(4, 5) // Error, because `p.x` is borrowed.
                     // Path `p.x` contains the path `p`.
                     // So path `p.x` conflicts with the path`p`.
    );
  };

  swap :: 
    ((x: &!(i32), y: &!(i32)) -> ()) {
      temp := x.*;
      x.* = y.*;
      y.* = temp;
  };
  
  expect_compile_error(
    swap(&!(x), &!(x)) // error, because `x` is borrowed multiple times.
  );
  
  swap(&!(p.x), &!(p.y)); // Allowed, because `p.x` and `p.y` are different paths.
  
  expect_compile_error(
    swap(&!(p.x), &!(p.x)) // Error, because `p.x` is borrowed multiple times.
  );
  
  swap(&!(p.x), &!(x)); // Allowed, because `p.x` and `x` are different paths.


  // fn returns local reference
  expect_compile_error(
    return_local_ref :: (()-> &(i32)) {
      x := 12;
      &(x)
    }
  );

  expect_compile_error(
    return_local_ref :: ((x: i32)-> &(i32)) {
      a := 12;
      &(x) // Error: Cannot return a reference to a parameter.
    }
  );

  // fn return parameter that is reference is allowed
  return_param :: ((x: &(i32)) -> &(i32)) {
    a := 12;
    x
  };

  borrow return_param(&(x)), (x_ref)-> {
    a := x_ref.*;
    expect_compile_error(
      x = 12 // Not allowed, because `x` is borrowed.
    );
  };

  borrow return_param(&(p.x)), (p_x_ref)-> {
    a := p_x_ref.*;
    p.y = 12; // Allowed.

    expect_compile_error(
      p.x = 13 // Not allowed. Because `p.x` is borrowed.
    );
    expect_compile_error(
      p = Point(4, 5) // Not allowed, because p.x is borrowed.
    );
  };

  // struct containing reference
  RefStruct :: struct(
    ref: &(i32)
  );

  // fn returns struct containing reference
  expect_compile_error(
    return_ref_struct_1 :: ((x: &(i32))-> RefStruct) {
      a := x.*;
      RefStruct(&(a)) // Error: Cannot return a struct containing reference to a local variable.
    }
  );
  expect_compile_error(
    return_ref_struct_2 :: ((x: i32)-> RefStruct) {
      a := 12;
      RefStruct(&(x)) // Allowed, because `x` is a parameter and not a local variable.
    }
  );
  return_ref_struct :: ((x: &(i32))-> RefStruct) {
    a := x.*;
    RefStruct(x) // Allowed, because `x` is a parameter and not a local variable.
  };

  // Largest reference
  mut(x) := 12;
  mut(y) := 13;
  largest :: ((x: &(i32), y: &(i32))-> &(i32))
    cond
      (x.* `gt` y.*) -> x,
      true -> y
  ;
  borrow largest(&(x), &(y)), largest -> {
    a := 12;
    expect_compile_error(x = 13);
    expect_compile_error(y = 13);
  };
};