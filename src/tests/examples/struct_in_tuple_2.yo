// Complicated case
// struct type inside tuple
main :: (()-> unit) {
  SomeStruct :: struct(x: i32, y: boolean);
  Complex0 :: type (SomeStruct,);
  Complex :: type (Complex0,);

  (c: SomeStruct) = _(3, false);
  (c: Complex0) = (_(3, true),);
  (c: Complex) = ((_(3, true),),);
  (c: Complex) = ((_(y: true, x: 1),),);
};