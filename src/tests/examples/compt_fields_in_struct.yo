// Struct can store comptime fields,
// but they must have an assigned value.
// This could be useful for determing some features for the Type.
// For example, for $ Rc type, we want its value
// to drop immediately when it is not used anymore,
// and also check the possibility of the reuse.  

SomeType :: struct(
  drop_immediately :: true
);

drop_immediately :: SomeType.drop_immediately;