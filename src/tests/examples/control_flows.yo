open import "std";

(@(LinearI32) : Linear) = i32;

some_condition :: (() -> boolean) 
  true
;

test_while_drop_with_break :: (() -> i32) {
  (x : LinearI32) = 42;

  while some_condition(), {
    drop(x);
    break;
  };

  return 0;
};

test_while_drop_with_return :: (() -> i32) {
  (x : LinearI32) = 42;

  while some_condition(), {
    drop(x);
    return 12;
  };

  return 0;
};

test_while_drop_with_continue :: (() -> i32) {
  (x : LinearI32) = 42;

  while some_condition(), {
    compt_expect_error(drop(x), "Shouldn't allow to drop x multiple times");
    continue;
  };

  return 0;
};


// Test 1: Break in while loop
test_while_with_break :: ((flag: boolean) -> i32) {
  (x : LinearI32) = 42;
  while flag, 
    cond
      some_condition() => {
        drop(x);
        break;
      },
      true => ()
  ;
  return 12;
};

// Test 2: Continue in while loop  
test_while_with_continue :: ((flag: boolean) -> i32) {
  while flag, 
    cond
      some_condition() => {
        continue;
      },
      true => {
        break;
      }
  ;
  return 15;
};

// Test 3: Return in while loop
test_while_with_return :: ((flag: boolean) -> i32) {
  (x : LinearI32) = 42;
  while flag,
    cond
      some_condition() => {
        drop(x);
        return 16;
      },
      true => ()
  ;
  return 12;
};

// Test 4: All cases break
test_cond_all_break :: ((flag: boolean) -> i32) {
  while flag,
    cond
      false => { break; },
      true => { break; }
  ;
  return 20;
};

// Test 5: All cases continue
test_cond_all_continue :: ((flag: boolean) -> i32) {
  while flag,
    cond
      false => { continue; },
      true => { continue; }
  ;
  return 25;
};

// Test 6: Mixed cases with one normal return
test_cond_mixed :: ((flag: boolean) -> i32)
  cond
    some_condition() => { return 30; },
    true => 35
;

// Test enum for match expressions
(@(Shape): Type) = enum(Circle, Square);

// Test 7: Match with all break cases
test_match_all_break :: ((shape: Shape) -> i32) {
  while some_condition(),
    match shape,
      .Circle => { break; },
      .Square => { break; }
  ;
  return 40;
};

// Test 8: Match with all continue cases  
test_match_all_continue :: ((shape: Shape) -> i32) {
  while some_condition(),
    match shape,
      .Circle => { continue; },
      .Square => { continue; }
  ;
  return 45;
};

// Test 9: Match with all return cases
test_match_all_return :: ((shape: Shape) -> i32)
  match shape,
    .Circle => { return 50; },
    .Square => { return 55; }
;

// ===========================================
// NESTED CONTROL STRUCTURES TESTS
// ===========================================

// Test 10: Nested cond inside while
test_nested_cond_in_while :: ((flag: boolean) -> i32) {
  (x : LinearI32) = 42;
  while flag,
    cond
      some_condition() => {
        cond
          some_condition() => {
            drop(x);
            break;
          },
          true => continue
        ;
      },
      true => break
  ;
  return 60;
};

// Test 11: Nested while inside cond - fixed version
test_nested_while_in_cond :: ((flag: boolean) -> i32) {
  (result: i32) = cond
    some_condition() => {
      while some_condition(), {
        break;
      };
      10  // This ensures the branch returns i32
    },
    true => 20
  ;
  return result;
};

// Test 12: Nested match inside while
test_nested_match_in_while :: ((flag: boolean, shape: Shape) -> i32) {
  while flag,
    match shape,
      .Circle => {
        cond
          some_condition() => break,
          true => continue
        ;
      },
      .Square => break
  ;
  return 70;
};

// ===========================================
// VALUE-RETURNING CONTROL STRUCTURES TESTS
// ===========================================

// Test 13: Cond returning values assigned to variable
test_cond_value_assignment :: ((flag: boolean) -> i32) {
  (result: i32) = cond
    some_condition() => 100,
    true => 200
  ;
  return result;
};

// Test 14: Match returning values assigned to variable
test_match_value_assignment :: ((shape: Shape) -> i32) {
  (result: i32) = match shape,
    .Circle => 300,
    .Square => 400
  ;
  return result;
};

// Test 15: Nested cond with values only (no early returns)
test_nested_cond_mixed :: ((flag: boolean) -> i32) {
  (result: i32) = cond(
    some_condition() => cond(
      some_condition() => 500,
      true => 600
    ),
    true => 700
  );
  return result;
};

// Test 16: Complex nested structure with linear values
test_complex_nested :: ((flag: boolean, shape: Shape) -> i32) {
  (x : LinearI32) = 42;
  (y : LinearI32) = 24;
  
  while flag, {
    (choice: i32) = cond(
      some_condition() => 1,
      true => 2
    );
    
    cond(
      (choice == 1) => {
        match(shape,
          .Circle => {
            drop(x);
            break;
          },
          .Square => {
            compt_expect_error(drop(y), "Shouldn't allow to drop y multiple times");
            continue;
          }
        );
      },
      true => {
        break;
      }
    );
  };
  
  return 800;
};

// Test 17: Multiple assignment with control flow
test_multiple_assignment :: ((flag: boolean) -> i32) {
  (a: i32) = cond
    some_condition() => 10,
    true => 20
  ;
  
  (b: i32) = cond
    flag => {
      return a + 100;  // Early return
    },
    true => 30
  ;
  
  return a + b;
};

// === ERROR TEST CASES ===

// Test: Break outside of loop should fail
test_break_outside_loop :: (() -> unit) 
  compt_expect_error({
    break;
  })
;

// Test: Continue outside of loop should fail  
test_continue_outside_loop :: (() -> unit)
  compt_expect_error({
    continue;
  })
;

// NOTE: Mixed control flows are now allowed in cond/match expressions
// Test: Mixed control flows in cond should work
test_mixed_control_flows :: ((flag: boolean) -> i32) {
  while flag,
    cond(
      some_condition() => {
        break;
      },
      some_condition() => {
        continue;  // Mixed break and continue is allowed
      },
      true => ()
    )
  ;
  return 1;
};

// Test: Break in function (not in loop) should fail
test_break_in_function :: (() -> unit)
  compt_expect_error({
    cond(
      some_condition() => {
        break;  // Break outside loop context should fail
      },
      true => ()
    );
  })
;

// Test: Continue in function (not in loop) should fail
test_continue_in_function :: (() -> unit)
  compt_expect_error({
    cond(
      some_condition() => {
        continue;  // Continue outside loop context should fail
      },
      true => ()
    );
  })
;