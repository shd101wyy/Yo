let { Id, id } = @import("./id.yo");

export type Coord = {
  x: i32;
  y: i32;
}

implements Id<Coord> {
  id: (x: Coord)-> Coord {
    x
  }
}

let test = ()-> {
  let coord: Coord = Coord { x: 1, y: 2 };
  
  let call1 = id(coord);
  let call2 = Id<Coord>.id(coord); // Explicit type argument
  let call3 = Id.id(coord); // By type inference
}