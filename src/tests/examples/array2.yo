// We can use `_` to indicate that the length of the array will be inferred

test1 :: (fn() -> unit) {
  arr1 := [1, 2, 3];
  (arr2 : Array(i32, 3)) = [1, 2, 3];

  // I want to support Array(i32, _);
  (arr3 : Array(i32, _)) = [1, 2, 3];
};


test2 :: (fn() -> unit) {
  arr : Array(i32, _);
  arr = [1, 2, 3];
  compt_expect_error(arr = [1, 2, 3, 4], "Incompatible types [i32; 3] vs [i32; 4]");
};


some_condition :: (fn() -> boolean) true;
test3 :: (fn() -> unit) {
  arr : Array(i32, _);
  compt_expect_error(
    cond(
      some_condition() => {arr = [1, 2, 3]; },
      true => { arr = [1, 2, 3, 4]; }
    )
  );
  // This should give error because `arr` cannot have differnet lengths

  cond(
    some_condition() => {arr = [1, 2, 3]; },
    true => { arr = [2, 3, 4]; }
  )
};
