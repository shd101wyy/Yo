extern
  add:
    (x: i32, y: i32)-> i32,
  compt_add:
    (compt(x): i32, compt(y): i32)-> compt(i32)
;

// Runtime only function
runt_id :: ((n: i32)-> i32)
  n
;

// Compile-time only function
compt_id :: ((compt(n): i32)-> compt(i32))
  n
;


main :: (()-> unit) {
  {
    n := 5; // runtime
    compt_expect_error(
      result1 :: compt_id(n) // compt, not allowed
    );
    compt_expect_error(
      result2 :: runt_id(n) // cannot assign runtime to comptime
    );
    compt_expect_error(
      result3 := compt_id(n) // cannot assign runtime `n` to compt parameter
    );
    result4 := runt_id(n); // runtime, allowed
  };

  {
    n :: 5; // comptime
    result1 :: compt_id(n); // allowed
    compt_expect_error(
      result2 :: runt_id(n)  // cannot assign runtime to comptime
    );
    result3 := compt_id(n);  // allowed
    result4 := runt_id(n);   // allowed
  };


  Point :: struct
    x: i32,
    y: i32
  ;

  p1 :: Point(3, 4);
  p2 :: Point(5, 6);

  p1_x :: p1.x;

  runt_add_points :: ((p1: Point, p2: Point)-> Point)
    Point(p1.x `add` p2.x, p1.y `add` p2.y)
  ;
  compt_add_points :: ((compt(p1): Point, compt(p2): Point)-> compt(Point))
    Point(p1.x `compt_add` p2.x, p1.y `compt_add` p2.y)
  ;

  // p3 :: runt_add_points(p1, p2);
  p4 :: compt_add_points(p1, p2); // allowed, comptime
};