// Merge struct and module?
{
  // Basic struct
  Point :: struct(
    x : i32,

    // field with default value
    (y : i32) ?= 12 
  );

  p :: Point(2, 3);
  x := p.x; // Error, because "p.x" is a runtime field.
};

{
  // Basic struct with type method
  Point :: struct(
    x : i32,
    y : i32,

    // Type method
    new :: ((()-> Self)
      Self(0, 0) // `Self` here means `Point`
    )
  );
};

{
  // Basic module
  Id :: ((@(T): Type)-> @(Module))
    module(
      // Self :: T, // Override `Self` to be `T`.
      // After the override, it's no longer avaible to define the type method.
      //  Or:
      (Self : Type) = T,

      id : ((self: Self)-> Self) // Expect `id` to be implemented.
    )
  ;
  

  // Implement the `Id`
  I32Id :: Id(i32)
    // `Self` cannot be overridden here, it is already set to `T = i32`
    id : (fn(x) -> x)
  ;
  ()
};

{
  // Module value can only be assigned to a comptime variable.
  Config :: module(
    version : usize, // comptime field
    enabled : boolean    // runtime field
  );

  {
    compt_expect_error(
      runtime_config := Config(1, true),
      "Error, because Config has a comptime field, it cannot be assigned to a runtime variable."
    );
  };
  
  config :: Config(version: 1, enabled: true); // Allowed.

  compt_expect_error(
    runt_config := Config(1, true)
  );
};