open import "std";
open import "std/libc/stdio.yo";

// Extern C declarations for async I/O
extern "C",
  pipe : (fn(pipefd : *(i32)) -> i32),
  close : (fn(fd : i32) -> i32),
  yo_async_read : (fn(fd : i32, buf : *(u8), count : usize) -> isize),
  yo_async_write : (fn(fd : i32, buf : *(u8), count : usize) -> isize)
;

main :: (fn() -> unit) {
  printf("Testing async I/O\n");
  
  // Create a pipe
  pipefd := [0, 0];
  ret := pipe(&(pipefd(0.as(usize))));
  
  cond 
    (ret == -1) => {
      printf("Failed to create pipe\n");
      return ();
    },
    true => ()
  ;
  
  read_fd := pipefd(0);
  write_fd := pipefd(1);
  
  printf("Created pipe: read_fd=%d, write_fd=%d\n", read_fd, write_fd);
  
  // Spawn writer coroutines
  i := 0;
  while i < 10, i = (i + 1), {
    value := i;
    async {
      // Write value as a 4-byte integer
      bytes_written := yo_async_write(write_fd, &(value).cast(*(u8)), 4);
      printf("Writer: wrote value %d (%ld bytes)\n", value, bytes_written);
    };
  };
  
  // Read values
  i = 0;
  while i < 10, i = (i + 1), {
    value := 0;
    bytes_read := yo_async_read(read_fd, &(value).cast(*(u8)), 4);
    
    cond(
      (bytes_read == 4) => {
        printf("Reader: read value %d\n", value);
      },
      true => {
        printf("Reader: failed to read, got %ld bytes\n", bytes_read);
      }
    );
  };
  
  // Close pipe
  close(read_fd);
  close(write_fd);
  
  printf("Async I/O test completed\n");
};

export main;
