// Test that RAII drop functions are auto-generated for Linear enums

(compt(LinearEnum) : Linear) = enum(
  Circle(radius: i32),
  Square(side: i32),
  Rectangle(width: i32, height: i32)
);

(compt(FreeEnum) : Free) = enum(
  Circle(radius: i32),
  Square(side: i32),
  Rectangle(width: i32, height: i32)
);

main :: (fn() -> i32) {
  // This should work - LinearEnum gets auto-generated drop
  linear_enum := LinearEnum.Circle(5);
  linear_enum.drop(); // Expect the `drop` for linear enums to be auto-generated
  
  // This should NOT have a drop method since it's Free
  free_enum := FreeEnum.Rectangle(3, 4);
  compt_expect_error(free_enum.drop()); // This would fail
  

  return 0;
};

export main;
