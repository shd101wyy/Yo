open import "std";

// Like scala, we don't support "break" or "continue" in while loop.
sum :: ((max : i32) -> i32) {
  mut(result) := 0;
  mut(i) := 0.as(i32);
  while i < max, {
    result = (result + i);
    i = (i + 1);
  };

  return result;
};

// compile-time evaluation of sum
sum_compt :: ((@(max) : i32) -> @(i32)) {
  mut(result) :: 0.as(i32);
  mut(i) :: 0.as(i32);
  while i <= max, {
    result = (result + i);
    i = (i + 1);
  };
  return result;
};

x :: sum_compt(10);
compt_assert(x == 55);