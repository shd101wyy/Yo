return_array :: ((compt(n) : usize) -> [i32; n]) {
  return Array(i32, n).fill(0);
};

return_array_2 :: ((compt(n) : usize) -> [i32; n])
  Array(i32, n).fill(0)
;

compt_return_array :: ((compt(n) : usize) -> compt([i32; n])) {
  return Array(i32, n).fill(6);
};

compt_return_array_2 :: ((compt(n) : usize) -> compt([i32; n]))
  Array(i32, n).fill(6)
;

test_array_fill :: (() -> unit) {
  arr :: Array(i32, 6).fill(8);
  arr2 := return_array(5);
  arr2_2 := return_array_2(7);
  arr3 :: compt_return_array(10);
  arr3_2 :: compt_return_array_2(12);
};