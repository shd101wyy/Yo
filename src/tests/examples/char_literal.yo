open import "std";

// Test char literal functionality
test_simple_char :: (() -> unit) {
  // Test simple ASCII characters
  char_a :: 'a';
  compt_assert((char_a == 97), "char 'a' should be 97");
  
  char_z :: 'z';
  compt_assert((char_z == 122), "char 'z' should be 122");
  
  char_0 :: '0';
  compt_assert((char_0 == 48), "char '0' should be 48");
  
  char_9 :: '9';
  compt_assert((char_9 == 57), "char '9' should be 57");
  
  char_space :: ' ';
  compt_assert((char_space == 32), "char ' ' should be 32");
};

// Test escape sequences
test_escape_sequences :: (() -> unit) {
  // Test newline
  char_newline :: '\n';
  compt_assert((char_newline == 10), "char '\\n' should be 10");
  
  // Test tab
  char_tab :: '\t';
  compt_assert((char_tab == 9), "char '\\t' should be 9");
  
  // Test carriage return
  char_cr :: '\r';
  compt_assert((char_cr == 13), "char '\\r' should be 13");
  
  // Test backslash
  char_backslash :: '\\';
  compt_assert((char_backslash == 92), "char '\\\\' should be 92");
  
  // Test single quote
  char_quote :: '\'';
  compt_assert((char_quote == 39), "char '\\'' should be 39");
  
  // Test null character
  char_null :: '\0';
  compt_assert((char_null == 0), "char '\\0' should be 0");
  
  // Test bell
  char_bell :: '\a';
  compt_assert((char_bell == 7), "char '\\a' should be 7");
  
  // Test backspace
  char_backspace :: '\b';
  compt_assert((char_backspace == 8), "char '\\b' should be 8");
  
  // Test form feed
  char_form_feed :: '\f';
  compt_assert((char_form_feed == 12), "char '\\f' should be 12");
  
  // Test vertical tab
  char_vtab :: '\v';
  compt_assert((char_vtab == 11), "char '\\v' should be 11");
};

main :: (() -> unit) {
  test_simple_char();
  test_escape_sequences();
};