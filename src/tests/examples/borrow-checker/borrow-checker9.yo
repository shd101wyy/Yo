extern "Yo",
  Data: Linear,
  malloc  :
    ()-> Data
;

test :: (()-> unit) {
  mut(x) := malloc();
  borrow &(x), x_ref => {
    compt_expect_error(
      y := x_ref.*,
      "error: x_ref.* is linear, which cannot be consumed."
    );
    compt_expect_error(
      drop(x),
      "error: x is borrowed"
    );
  };
  drop(x); // Allowed
}