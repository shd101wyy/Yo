extern "Yo",
  Data   : Type,
  malloc :
    fn()-> Data
;

Color :: enum
  Red,
  Green,
  Blue
;


test :: (fn(color: Color)-> unit) {
  x := malloc();
  match (color),
    .Red => {
      drop(x);
    },
    .Green => {
      drop(x);
    },
    .Blue => {
      drop(x);
    }
  ;
};

compt_expect_error(
  test2 :: (fn(color: Color)-> unit) {
    x := malloc();
    match (color),
      .Red => {
        drop(x);
      },
      .Green => {
        a := 12;
      },
      .Blue => {
        drop(x);
      }
    ;
  },
  "error: 'x' is only consumed in some branches, but not all branches."
);