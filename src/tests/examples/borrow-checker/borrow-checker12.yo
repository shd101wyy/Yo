extern "C",
  malloc  :
    ()-> ^(i32)
;
test :: ((flag: boolean)-> unit) {
  x := malloc();
  cond
    flag -> consume(x),
    true -> consume(x)
  ;
  compt_expect_error(
    consume(x), "error: 'x' is already consumed."
  );
};

compt_expect_error(
  test2 :: ((flag: boolean)-> unit) {
    x := malloc();
    cond
      flag -> {
        consume(x);
        ()
      },
      true -> ()
    ;
  },
  "error: 'x' is only consumed in the first branch, but not all branches."
);