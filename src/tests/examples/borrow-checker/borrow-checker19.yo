extern "Yo",
  Data   : Linear,
  malloc :
    fn()-> Data
;


Person :: struct
  age: i32,
  name: Data
;

test :: (fn() -> unit) {
  name := malloc();
  p := Person(age: 12, name: name);

  compt_expect_error(
    borrow &(name), name_ref -> {
      ();
    },
    "error: 'name' is already consumed in the struct 'p'"
  );

  drop(p);
};