extern "Yo",
  Data   : Type,
  malloc :
    fn()-> Data
;


Person :: struct
  age: i32,
  name: Data,
  job: Data
;

test0 :: (fn(p: Person)-> Person)
  p
;

test :: (fn(p: Person)-> Person) {
  p := p;

  age := p.age;

  {
    borrow &(p.name), name_ref => {
      old_name := (name_ref.* = malloc());
      drop(old_name);
    };
  };

  {
    oldName := (p.name = malloc());
    drop(oldName);
  };

  p
};