extern "Yo",
  Data   : Linear,
  malloc :
    ()-> Data
;


Person :: struct
  age: i32,
  name: Data,
  job: Data
;

test0 :: ((p: Person)-> Person)
  p
;

test :: ((p: Person)-> Person) {
  mut(p) := p;

  age := p.age;

  {
    borrow &!(p.name), name_ref => {
      old_name := (name_ref.* = malloc());
      consume(old_name);
    };
  };

  {
    oldName := (p.name = malloc());
    consume(oldName);
  };

  p
};