extern "C",
  @(malloc) :
    ()-> ^(i32)
;

return_ref :: ((ref: &(^(i32))) -> &(^(i32)))
  ref
;

test :: (()-> unit) {
  x := malloc();
  {
    borrow return_ref(&(x)), x_ref-> {

      // x is borrowed here, so we cannot use it.
      compt_expect_error(
        x_2 := x
      );

      ();
    };
  };
  consume(x);
};