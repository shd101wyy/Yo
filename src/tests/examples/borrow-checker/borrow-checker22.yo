extern "Yo",
  Data   : Type,
  malloc :
    fn()-> Data
;

return_ref :: (fn(ref: &(Data)) -> &(Data))
  ref
;

test :: (fn() -> unit) {
  x := malloc();
  {
    borrow return_ref(&(x)), x_ref => {

      // x is borrowed here, so we cannot use it.
      compt_expect_error(
        x_2 := x
      );

      ();
    };
  };
  drop(x);
};