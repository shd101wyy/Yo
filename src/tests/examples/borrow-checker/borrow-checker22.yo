extern "C",
  Data   : Linear,
  malloc :
    ()-> Data
;

return_ref :: ((ref: &(Data)) -> &(Data))
  ref
;

test :: (()-> unit) {
  x := malloc();
  {
    borrow return_ref(&(x)), x_ref-> {

      // x is borrowed here, so we cannot use it.
      compt_expect_error(
        x_2 := x
      );

      ();
    };
  };
  consume(x);
};