(compt(LinearI32) : Linear) = i32;

Shape :: enum
  Circle(radius: i32),
  LinearShape(width: LinearI32, height: LinearI32)
;

use_mut_ref_shape :: ((ref: &!(Shape)) -> unit) {
  ();
};

test :: (() -> unit) {
  mut(shape) := Shape.LinearShape(3, 4);

  borrow &(shape.width), (width_ref)=> {
    height := *(shape.height);
    // ^ This is allowed, because we only borrowed `shape.width`, not `shape`.
    // so we can use `shape.height` without problem.

    compt_expect_error(
      use_mut_ref_shape(&!(shape)),
      "error: cannot use 'shape' because it's already borrowed."
    );
  };

  borrow &(shape), (ref)=> {
    compt_expect_error(
      width := *(shape.width),
      "error: cannot use 'shape' because it's already borrowed."
    );

    borrow &(ref.width), (width_ref)=> {
      height := *(ref.height);
      // ^ This is allowed, because we only borrowed `ref.width`, not `ref`.
    
      compt_expect_error(
        height := *(shape.height),
        "error: cannot use 'shape' because it's already borrowed."
      );
    };

    borrow &(ref), (ref_ref)=> {
      compt_expect_error(
        height := *(ref.height),
        "error: cannot use 'ref' because it's already borrowed."
      );

      height := *(ref_ref.height); // allowed
    };
  };
};

test_ref :: ((ref: &(Shape)) -> unit) {
  match ref,
    .Circle => {
        radius := ref.radius;
        ();
    },
    .LinearShape => {
        width := *(ref.width);
        height := *(ref.height);
    }
  ;
};