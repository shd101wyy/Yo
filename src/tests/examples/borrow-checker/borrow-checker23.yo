extern "C",
  add :
    fn(x: i32, y: i32)-> i32
;


increase :: (fn(x : &!(i32))-> unit) {
  x.* = (x.* `add` 1);
};

// https://stackoverflow.com/questions/75809087/in-rust-what-the-mechanism-of-transferring-a-mutable-reference-into-a-function
main :: (fn() -> unit) {
  mut(x) := 0;
  borrow &!(x), x_ref => {
    increase(x_ref);
    increase(x_ref);
  };
};
