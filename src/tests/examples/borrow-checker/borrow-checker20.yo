extern "C",
  @(malloc) :
    ()-> ^(i32)
;


test :: (()-> unit) {
  name := malloc();
  arr := [name]; // 'name' is consumed in the array 'arr'.
  
  compt_expect_error(
    borrow &(name), name_ref-> {
      ();
    },
    "error: 'name' is already consumed in the array 'arr'"
  );

  consume(arr);
};

test2 :: (()-> unit) {
  name := malloc();
  tup := (name,);

  compt_expect_error(
    borrow &(name), name_ref-> {
      ();
    },
    "error: 'name' is already consumed in the array 'arr'"
  );

  consume(tup);
};