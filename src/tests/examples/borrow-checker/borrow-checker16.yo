main :: (()-> unit) {
  mut(xs) := [1, 2, 3];
  borrow &!(xs), xs_ref -> {
    compt_expect_error(
      first_element := xs(0)
      "cannot use `xs` after it has been borrowed mutably"
    );
    {
      first_element := (xs_ref.*)(0);
    };
    // TODO: Support automatic dereferencing of borrowed references
    // first_element := xs_ref(0);
    ();
  };

  borrow &!(xs(0)), first_element_ref -> {
    first_element_ref.* = 12;

    compt_expect_error(
      borrow &(xs), another_ref-> {
        ();
      },
      "cannot borrow `xs` because it is already borrowed mutably in &!(xs(0))"
    );

    compt_expect_error(
      borrow &!(xs(1)), another_ref -> {
        ();
      },
      "cannot borrow `xs(1)` because it is already borrowed mutably in &!(xs(0))"
    );
  };
};

