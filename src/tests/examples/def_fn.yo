extern
  add : (fn(x: i32, y: i32)-> i32),
  sub : (fn(x: i32, y: i32)-> i32),
  div : (fn(x: i32, y: i32)-> i32),
  mul : (fn(x: i32, y: i32)-> i32),
  eq  : (fn(x: i32, y: i32)-> bool),
  gt  : (fn(x: i32, y: i32)-> bool)
;

// define a normal function.
some_add :: (fn(x: i32, y: i32)-> i32)
  add(x, y)
;

// use the `recur` keyword to call the function itself.
use_recur :: (fn(x: i32, y: i32)-> i32)
  recur(x, y)
;

// factorial
factorial :: (fn(n: i32)-> i32)
  cond
    (n `eq` 0) => 1,
    true =>
      n `mul` recur(n `sub` 1)
  // n `mul` factorial(n `sub` 1) // This is wrong. 
  // As we haven't defined `factorial` yet, it will cause an error.
;

// define type first
// and implement function with `_`
(compt(type_first): (fn(x: i32, y: i32)-> i32))
  = _ add(x, y)
;

// define type first
// and implement function with `fn`
(compt(type_first_fn): (fn(x: i32, y: i32)-> i32))
  =
    (a, b)-> add(a, b);

(compt(another_factorial) : (fn(n: i32)-> i32))
  = _ cond
    (n `eq` 0) => 1,
    true =>
      n `mul` recur(n `sub` 1)
;

x := type_first(3, 4);
x2 := type_first_fn(3, 4);

Point :: struct(x: i32, y: i32);
p := Point(3, 4);

Point2 :: (fn(compt(T): Type)-> compt(Type))
  struct(x: T, y: T)
;
p2 := Point2(i32)(3, 4);
