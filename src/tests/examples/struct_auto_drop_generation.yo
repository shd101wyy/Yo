// Test that RAII drop functions are auto-generated for Linear structs

(compt(LinearStruct) : Linear) = struct(
  x : i32,
  y : i32
  
  /*
  // Automatically generate drop like:
  drop :: ((self: Self)-> unit) {
    {x, y} := self;
  }
  */
);

(compt(FreeStruct) : Free) = struct(
  x : i32,
  y : i32
);

main :: (() -> i32) {
  // This should work - LinearStruct gets auto-generated drop
  linear_struct := LinearStruct(1, 2);
  linear_struct.drop(); // Expect the `drop` for linear structs to be auto-generated
 
  // This should NOT have a drop method since it's Free
  free_struct := FreeStruct(3, 4);
  compt_expect_error(free_struct.drop()); // This would fail
  
  return 0;
};

export main;
