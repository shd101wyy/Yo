

extern
  add: 
    fn(x: i32, y: i32)-> i32
;

Point :: struct(value: i32);

MY_ADD :: module
  (Self: Type) = i32,
  my_add: (fn(x: Self, y: Self)-> Self),
  new_self: (fn()-> Self),
  new_self2: (fn(flag: bool)-> Self);
;

MyAdd :: MY_ADD(
  my_add:
    (a, b)-> add(a, b),
  new_self:
    ()-> 0,
  new_self2:
    (flag)-> 0
);

receiver :: MyAdd.Self; // i32

main :: (fn() -> unit) {
  // Call function from module:
  x := MyAdd.my_add(1, 2);
  x2 := MyAdd.new_self();
  x3 := MyAdd.new_self2(true);
  
  // Or use the method call
  x4 := (i32(1)).my_add(2);
  
  // Explict call
  x5 := (i32(1)).(MyAdd.my_add)(2);

  // This is prohibited because `bool` is not the receiver type of MyAdd interface
  // (true).new_self2(); // not ok
  MyAdd.new_self2(true); // ok
  MyAdd.new_self2(false); // ok
  
  // Function returning an module
  Id :: (fn(compt(Self_): Type) -> compt(Module))
    module
      (Self: Type) = Self_,
      id: (fn(x: Self)-> Self)
  ;

  IdI32 :: Id(i32)
    id:
      (x)-> x;
  receiver :: IdI32.Self; // i32
  x6 := IdI32.id(1);
  x7 := (i32(13)).id();
  x8 := (i32(13)).(IdI32.id)();
};
