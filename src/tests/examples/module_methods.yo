extern
  add: 
    (x: i32, y: i32)-> i32
;

Point :: struct(value: i32);

MY_ADD :: module
  (Self: Type) = i32,
  my_add: ((x: Self, y: Self)-> Self),
  new_self: (()-> Self),
  new_self2: ((flag: boolean)-> Self);
;

MyAdd :: MY_ADD(
  my_add:
    fn(a, b)-> add(a, b),
  new_self:
    fn()-> 0,
  new_self2:
    fn(flag)-> 0
);

receiver :: MyAdd.Self; // i32

main :: (()-> unit) {
  // Call function from module:
  x := MyAdd.my_add(1, 2);
  x2 := MyAdd.new_self();
  x3 := MyAdd.new_self2(true);
  
  // Or use the method call
  x4 := (1).my_add(2);
  
  // Explict call
  x5 := (1).(MyAdd.my_add)(2);

  // This is prohibited because `boolean` is not the receiver type of MyAdd interface
  // (true).new_self2(); // not ok
  MyAdd.new_self2(true); // ok
  MyAdd.new_self2(false); // ok
  
  // Function returning an module
  Id :: ((@(Self_): Type) -> @(Module))
    module
      (Self: Type) = Self_,
      id: ((x: Self)-> Self)
  ;

  IdI32 :: Id(i32)
    id:
      fn(x)-> x;
  receiver :: IdI32.Self; // i32
  x6 := IdI32.id(1);
  x7 := (13).id();
  x8 := (13).(IdI32.id)();
};
