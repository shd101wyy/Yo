

sum :: (fn(max : i32) -> i32) {
  result := 0;
  i := 0.as(i32);
  while i < max, i = (i + 1), {
    result = (result + i);
    continue;
  };

  return result;
};

// compile-time evaluation of sum
sum_compt :: (fn(compt(max) : i32) -> compt(i32)) {
  result :: 0.as(i32);
  i :: 0.as(i32);
  while i <= max, i = (i + 1), {
    result = (result + i);
    continue;
  };
  return result;
};

x :: sum_compt(10);
compt_assert(x == 55);