open import "std/libc/stdio";
{ mutex_t, Mutex, cond_t, Cond } :: import "std/sync";

main :: (fn() -> unit) {
  // Test creating mutex and condition variable
  mu := mutex_t.new();
  
  // Test both syntaxes
  mutex_t.lock(&(mu));
  printf("Mutex locked with mutex_t.lock!\n");
  mutex_t.unlock(&(mu));
  printf("Mutex unlocked with mutex_t.unlock!\n");
  
  mu.lock();
  printf("Mutex locked with mu.lock!\n");
  mu.unlock();
  printf("Mutex unlocked with mu.unlock!\n");
  
  mutex_t.destroy(&(mu));
  printf("Sync primitives test complete!\n");
};

export main;