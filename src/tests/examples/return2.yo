open import "std";

compt_return_in_while :: ((compt(flag): boolean) -> compt(i32)) {
  while flag, {
    cond
      flag => {
        x :: 1;
        return x;
      },
      true => {
        x :: 2;
      }
    ;

    return 4;
  };
  
  16
};

x :: compt_return_in_while(true);
y :: compt_return_in_while(false);
compt_assert(x == 1);
compt_assert(y == 16);