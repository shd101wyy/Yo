main :: (fn() -> unit) {
  // Runtime immutable variable
  {
    x : i32;
    x = 12;
  };
  {
    (x : boolean) = true;
  };

  // Runtime mutable variable
  {
    x : i32;
    x = 12;
  };
  {
    (x : boolean) = true;
    x = false;
  };

  // Compile-time immutable variable
  {
    compt(x) : i32;
    x = 12;
  };
  {
    (compt(x) : boolean) = true;
    // x = false;
  };

  // Compile-time mutable variable
  {
    compt(x) : i32;
    x = 12;
  };
  {
    (compt(x) : boolean) = true;
    x = false;
  };

  // Runtime immutable variable
  {
    (x : i32) = 12;
    // x = 13; // error
  };

  // Runtime mutable variable
  {
    (x : i32) = 12;
    x = 13;
  };

  // Compile-time immutable variable
  {
    x :: 12;
    // x = 13; // error
  };

  {
    // Compile-time mutable variable
    x :: 12;
    x = 13;
  };

  {
    compt(x) : Type;
    x = struct(x: i32, y: i32);
  };
};