extern
  @(add):
    (x: i32, y: i32)-> i32
;

Point :: struct
  x : i32,
  y : i32,

  // Let's only support to define type methods using :: for now
  Self.new = ((() -> Self)
    Self(0, 0)
  ),
  
  Self.create = (((x: i32, y: i32) -> Self)
    Self(x, y)
  ),

  Self.(+) = (((a: Self, b: Self)-> Self)
    Self((a.x `add` b.x), (a.y `add` b.y))
  ),

  Self.add = (((a: Self, b: Self)-> Self)
    Self((a.x `add` b.x), (a.y `add` b.y))
  )
;

main :: (()-> unit) {
  a := Point.new();
  b := Point.create(3, 4);

  {
    x := (a.x `add` b.x);
    y := (a.y `add` b.y);
    c := Point (a.x `add` b.x), b.y;
  };

  {
    c := Point.add(a, b);
    d := a.add(b);
    e := (a + b);
    f := a.(Point.add)(b);
  };

  ()
}