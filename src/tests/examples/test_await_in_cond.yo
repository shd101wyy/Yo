// Test: await inside cond expression

open import "std/libc/stdio.yo";

simple_async_task :: (fn(value: i32) -> Future(i32))
  async {
    printf("Task executed with value: %d\n", value);
    value
  }
;

test_await_in_cond_1 :: (fn() -> Future(unit))
  async {
    printf("Test 1: await in cond\n");
    
    use_branch_a: boolean;
    use_branch_a = true;
    
    cond(
      use_branch_a => {
        value := await simple_async_task(42);
        printf("Got result: %d\n", value);
        assert(value == 42, "Expected value to be 42");
      },
      true => {
        value := await simple_async_task(99);
        printf("Got result: %d\n", value);
        assert(value == 42, "Expected value to be 42");
      }
    );
    
    printf("Test 1 completed\n");
  }
;

test_await_in_cond_2 :: (fn() -> Future(unit))
  async {
    printf("Test 2: await in cond\n");
    
    use_branch_a: boolean;
    use_branch_a = true;
    
    result := cond(
      use_branch_a =>
        await(simple_async_task(66)),
      true =>
        await(simple_async_task(66))
    );
    
    printf("Got result: %d\n", result);
    assert(result == 66, "Expected value to be 66");
    printf("Test 2 completed\n");
  }
;

test_await_in_cond_3 :: (fn() -> Future(unit))
  async {
    printf("Test 3: await in cond\n");
    
    use_branch_a: boolean;
    use_branch_a = true;
    
    result := cond(
      use_branch_a => {
        printf("Taking branch A\n");
        await(simple_async_task(88))
      },
      true => {
        printf("Taking branch B\n");
        await(simple_async_task(88))
      }
    );
    
    printf("Got result: %d\n", result);
    assert(result == 88, "Expected value to be 88");
    printf("Test 3 completed\n");
  }
;


main :: (fn() -> unit) {
  async {
    await test_await_in_cond_1();
    await test_await_in_cond_2();
    await test_await_in_cond_3();
  };
};

export main;
