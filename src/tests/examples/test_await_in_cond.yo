    result := cond(
      use_branch_a => {
        await simple_async_task(42);
      },
      true => {
        await simple_async_task(99);
      }
    );
    
    printf("Got result: %d\n", result);
    printf("Test completed\n");
  }
;
*/

main :: (fn() -> unit) {
  async {
    await test_await_in_cond();
  };
};

export main;
