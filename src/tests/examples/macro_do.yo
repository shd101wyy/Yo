open import "std";

expanded :: macro_expand quote
  do {
    x := 1;
    with response <= fetch("https://api.example.com");
    std.println(response);
    with (json,) <<= response.json();
    std.println(json);
    with (x, y) <- json.parse();
    return x + y;
  }
;

compt_assert(expanded == quote(
  {
    x := 1;
    fetch("https://api.example.com", fn(response) => {
      std.println(response);
      response.json(fn(json) =>> {
        std.println(json);
        json.parse(fn(x, y) -> {
          return(x + y);
        })
      })
    })
  })
);

expanded2 :: macro_expand quote
  do {
    println("top");
    with _ <= finally(fn()=> {
      println("end");
    });
    println("start");
    println("mid 1");
    println("mid 2");
  }
;

compt_assert(expanded2 == quote {
  println("top");
  finally(fn() => {
    println("end");
  }, fn()=> {
    println("start");
    println("mid 1");
    println("mid 2");
  })
});
