open import "std";

expanded0 :: macro_expand quote
  do {
    x := 1;
    with response <= fetch("https://api.example.com");
    println("after fetch");
    println(response);
    with (json,) <<= response.json();
    println("after json");
    println(json);
  }
;
expected0 :: quote(
{
  x := 1;
  fetch("https://api.example.com", fn(response) => {
    println("after fetch");
    println(response);
    response.json(fn(json) =>> {
      println("after json");
      println(json);
    })
  })
});


compt_assert(expanded0 == expected0);

expanded1 :: macro_expand quote
  do {
    x := 1;
    with response <= fetch("https://api.example.com");
    println("after fetch");
    println(response);
    with (json,) <<= response.json();
    println("after json");
    println(json);
    with (x, y) <- json.parse();
    println("after parse");
    return x + y;
  }
;

compt_assert(expanded1 == quote(
  {
    x := 1;
    fetch("https://api.example.com", fn(response) => {
      println("after fetch");
      println(response);
      response.json(fn(json) =>> {
        println("after json");
        println(json);
        json.parse(fn(x, y) -> {
          println("after parse");
          return(x + y);
        })
      })
    })
  })
);

expanded2 :: macro_expand quote
  do {
    println("top");
    with _ <= finally(fn()=> {
      println("end");
    });
    println("start");
    println("mid 1");
    println("mid 2");
  }
;

compt_assert(expanded2 == quote(
  {
    println("top");
    finally(
      fn() => {
        println("end");
      },
      fn() => {
        println("start");
        println("mid 1");
        println("mid 2");
      }
    )
  }
));


expanded3 :: macro_expand quote
  do {
    println("start");

    println("single");
    with m_ref <~ &!(m);
    m_ref.* = (m_ref.* + 1);

    println("single tuple");
    with (n_ref,) <~ &!(n);
    n_ref.* = (n_ref.* + 1); 

    println("multiple");
    with (x_ref, y_ref) <~ (&!(x), &!(y));
    x_ref.* = (x_ref.* + 1);
    y_ref.* = (y_ref.* + 2);

    println("end");
  }
;

compt_assert(expanded3 == quote {
  println("start");

  println("single");
  &!(m) ~> ((m_ref) => {
    m_ref.* = (m_ref.* + 1);

    println("single tuple");
    &!(n) ~> ((n_ref,) => {
      n_ref.* = (n_ref.* + 1);
      
      println("multiple");
      (&!(x), &!(y)) ~> ((x_ref, y_ref) => {
        x_ref.* = (x_ref.* + 1);
        y_ref.* = (y_ref.* + 2);

        println("end");
      })
    })
  })
});