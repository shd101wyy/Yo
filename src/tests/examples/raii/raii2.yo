extern "Yo",
  Data: Linear,
  malloc  :
    ()-> Data
;

some_condition :: (()-> boolean)
  true
;

test :: (()-> unit) {
  x := malloc();
  cond
    some_condition() ->
      y := x,
    true -> {
      ();
    }
  ;

  // x is already consumed
  compt_expect_error(
    z := x,
    "Variable 'x' is already consumed, cannot be used again."
  );
};