extern "Yo",
  Data: Linear,
  malloc  :
    fn() -> Data
;

some_condition :: (fn() -> boolean)
  true
;

test :: (fn() -> unit) {
  x := malloc();
  cond
    some_condition() =>
      y := x,
    true => {
      ();
    }
  ;

  // x is already consumed
  compt_expect_error(
    z := x,
    "Variable 'x' is already consumed, cannot be used again."
  );
};