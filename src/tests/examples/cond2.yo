extern
  gt : 
    ((x : i32, y : i32) -> boolean)
;

main :: (() -> unit) {
  compt_expect_error(
    x := cond(
      (3 `gt` 4) => 5,
      (5 `gt` 6) => 6
    ),
    "Expect the last condition to be compile-time known \"true\"."
  );

  x := cond(
    (3 `gt` 4) => 5,
    (5 `gt` 6) => 6,
    true => 7 // the last case expects to be always compile-time known "true"
  );
};