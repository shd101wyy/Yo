extern
  add:
    (x: i32, y: i32)-> i32
;

// Explicitly define Type as function parameter. 
id_fun ::
  ((compt(T): Type, x: T)-> T)
  x;
x := id_fun(i32, 12);
x2 := id_fun(boolean, true);

id_func :: 
  ((forall(compt(T): Free),
    x : T)-> T) {
  (xx : T) = x; // Use `T` inside the function body
  xxx := x;

  (mut(xxxx) : typeof(x)) = xxx;
  xxxx = xx;
  xxx
};

x3 := id_func(12);
x4 := id_func(true);
x5 := id_func(forall(i32), 12);
x6 := id_func(forall(T: i32), 12);
x7 := id_func(forall(_), 12);
// x := id_func(forall(undefined), 12); // <= This is supposed to give error

// Anonymous function
anonymous_func :
  (forall(compt(T): Type),
    x: T)-> T;
anonymous_func =
  fn(a)-> a;
x8 := anonymous_func(12);
x9 := anonymous_func(true);


// tuple
tuple_func ::
  ((forall(compt(T): Type, compt(Y): Type),
    x: Tuple(T, Y), a: T, b: Y)-> Tuple(T, Y)) {
  drop(x);
  (a, b)
};
x10 := tuple_func((12, true), 1, false);


// struct
Container ::
  ((compt(T): Type)-> compt(Type))
  struct(value: T)
;

use_container ::
  ((forall(compt(X): Type), 
    c: Container(X), x: X)-> X) {
  drop(c);
  x
};

i32_container_value := Container(i32)(12);
x11 := use_container(i32_container_value, 13);
x12 := use_container(Container(i32)(13), 12);
x13 := use_container(Container(boolean)(true), false);

// Parameter contains function type
generic_fn ::
  ((forall(compt(T): Type), x: T, callback: ((v: T)-> T))-> T)
  callback(x)
;

generic_fn(1, fn(x)-> add(x, 1));
generic_fn(true, fn(x)-> x);