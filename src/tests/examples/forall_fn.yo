extern
  add:
    (x: i32, y: i32)-> i32
;

// Explicitly define Type as function parameter. 
id_fun ::
  ((@(T): Type, x: T)-> T)
  x;
x := id_fun(i32, 12);
x2 := id_fun(boolean, true);

id_func :: 
  ((forall(@(T): Type),
    x : T)-> T) {
  (xx : T) = x; // Use `T` inside the function body
  xxx := x;

  (mut(xxxx) : typeof(x)) = xxx;
  xxxx = xx;
  xxx
};

x := id_func(12);
x := id_func(true);
x := id_func(forall(i32), 12);
x := id_func(forall(T: i32), 12);
x := id_func(forall(_), 12);
// x := id_func(forall(undefined), 12); // <= This is supposed to give error

// Anonymous function
anonymous_func :
  (forall(compt(T): Type),
    x: T)-> T;
anonymous_func =
  fn(a)-> a;
x := anonymous_func(12);
x := anonymous_func(true);


// tuple
tuple_func ::
  ((forall(compt(T): Type, compt(Y): Type), 
    x: (T, Y), a: T, b: Y)-> (T, Y))
  (a, b)
;
x := tuple_func((12, true), 1, false);


// struct
Container ::
  ((compt(T): Type)-> compt(Type))
  struct(value: T)
;

use_container ::
  ((forall(compt(X): Type), 
    c: Container(X), x: X)-> X)
  x
;

i32_container_value := Container(i32)(12);
x := use_container(i32_container_value, 13);
x := use_container(Container(i32)(13), 12);
x := use_container(Container(boolean)(true), false);

// Parameter contains function type
generic_fn ::
  ((forall(@(T): Type), x: T, callback: ((v: T)-> T))-> T)
  callback(x)
;

generic_fn(1, fn(x)-> add(x, 1));
generic_fn(true, fn(x)-> x);