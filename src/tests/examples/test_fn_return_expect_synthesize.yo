Applicative :: (fn(
  compt(Wrapper) : (fn(compt(W) : Type) -> compt(Type))
  ) -> compt(Module))
  module(
    pure :
      fn(
        forall(A : Type),
        a : A
      ) -> Wrapper(A)
  )
;

Data :: 
  (fn(compt(W) : Type) -> compt(Type))
  struct(value: W)
;

given(DataApplicative) :: Applicative(Data)
  pure : 
    ((a) -> {
      A :: typeof(a);
      Data(A)(a)
    })
;

main :: (fn() -> unit) {
  a := Data(i32)(42);
  (b : Data(unit)) = DataApplicative.pure(());
  return ();
};