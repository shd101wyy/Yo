// Compt value can be assigned to runtime variable,
// but not the other way around.

main :: (fn() -> unit) {
  compt_return :: (fn(compt(T): Type, compt(value): T)-> compt(T))
    value
  ;

  runtime_return :: (fn(compt(T): Type, value: T)-> T)
    value
  ;

  {
    xx :: compt_return(i32, 12);
    xxx := compt_return(i32, 12);
    compt_expect_error(
      xx :: runtime_return(i32, 12),
      "Cannot assign runtime value to a compt variable"
    );
    xxxx := runtime_return(i32, 12);

    test :: (fn(compt(x): i32, y: i32)-> unit) {
      // Assign compt value to another compt is allowed
      xxx :: x;
      xx :: compt_return(i32, x);

      // Assign compt value to another runtime is allowed
      yy := x;

      // Assign runtime value to another compt is not allowed
      // xx :: y; // expected-error {{cannot assign runtime value to a compt variable}}

      // Assign runtime value to another runtime is allowed
      yyy := y;

      ()
    };
  };

  // Below should give error as `value` is supposed to be compt
  // some_func :: (fn(compt(T): Type, value: T) -> compt(T)) value;

  // compt value can be assigned to runtime parameter,
  // but not the other way around.
  {
    accept_compt :: (fn(compt(x): i32)-> unit) {
      xx :: x;
      xxx := x;
    };
    (x: i32) = 13; // runtime
    xx :: 14; // compt

    compt_expect_error(
      accept_compt(x), "Cannot pass runtime value to a compt parameter"
    );
    compt_expect_error(
      accept_compt(runtime_return(i32, 12)), "Cannot pass runtime value to a compt parameter"
    );// error    
    
    accept_compt(xx);
    accept_compt(compt_return(i32, 12));
  }
}