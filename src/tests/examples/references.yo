// 2nd-class reference
main :: (() -> ()) {
  I32Ref :: &(i32);
  I32MutRef :: &!(i32);

  swap :: ((p: &!(i32), q: &!(i32)) -> ()) {
    tmp := p.*;
    p.* = q.*;
    q.* = tmp;
  };

  // Assign value that contains reference to a variable is prohibited.
  !(x) := 12;
  !(y) := 13;
  // p := &(x); // This is not allowed.
  swap(&!(x), &!(y));

  swap(&!(x), &!(x)); // FIXME: This shouldn't be allowed.
                      // Because we cannot create multiple references
                      // to the same variable.
                      // Their paths overlap.
};