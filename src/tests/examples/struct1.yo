open import "std";

Withdraw :: struct(
  balance: i32,

  withdraw :: ((mut(self): Self, amount: i32) -> i32) {
    if self.balance >= amount, {
      self.balance = (self.balance - amount);
      return self.balance;
    }, else: {
      return 0; // insufficient balance
    };
  }
);

make_widthdraw_balance_100 :: (() -> Withdraw) {
  (balance : i32) = 100;
  return { balance };
};

new_widthdraw := make_widthdraw_balance_100();
left := new_widthdraw.withdraw(50);
left2 := new_widthdraw.withdraw(30);