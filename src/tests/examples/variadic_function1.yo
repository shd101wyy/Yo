open import "std";

extern "Yo",
  va_list : Free,
  va_arg : 
    (args : va_list, compt(T): Type) -> T,
  va_end :
    (args : va_list) -> unit
;

// Variadic function
AddFunc :: ((count : i32, ...) -> i32);

add :: AddFunc {
  args : va_list;
  va_start(args, count); // Initialize the va_list with the count of arguments
  mut(result) := 0;
  mut(i) := 0;
  while i < count, {
    result = (result + va_arg(args, i32)); // Get the next argument as i32
    i = (i + 1);
  };
  va_end(args); // Clean up the va_list
  return result; // Return the sum of the arguments
};

main :: (() -> unit) {
   x := add(3, 1, 2, 3); // Call the variadic function with 3 arguments
   y := add(5, 1, 2, 3, 4, 5); // Call the variadic function with 5 arguments
   z := add(8); // Call the variadic function with no arguments
};