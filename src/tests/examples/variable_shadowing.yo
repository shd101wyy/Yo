main :: (fn() -> unit) {
  (x : i32) = 12;
  compt_expect_error(
    x := 13 // Not allowed, because `x` already exists at the current frame.
  );

  {
    (x : i32) = 14; // Allowed, because we now are in a new frame.
    compt_expect_error(
      x := 15 // Not allowed, because `x` already exists at the current frame.
    );
  };
  
  {
    // FIXME:
    // x := x; // Allowed, because we are in a new frame.
  };
};