open import "std";
open import "std/libc/stdio.yo";

say :: (fn(s : *(u8), val: i32, ch: Chan(i32)) -> i32) {
  printf("%s\n", s);
  ch.send(val);
  printf("thread %zu sent %i\n", Concurrency.get_thread_id(), val);
  return val;
};

// Pointer arithmetic example
main :: (fn() -> i32) {
  Concurrency.set_maximum_threads(2); // Set maximum 2 thread for "go" tasks

  ch := chan(i32); // unbuffered channel

  // say("world") and say("hello") should run on the same thread
  go say("world", 16, ch);
  go say("hello", 18, ch);

  t1_result := ch.recv().unwrap();
  printf("thread %zu received %d\n", Concurrency.get_thread_id(), t1_result);
  // It should print
  // "thread ? sent 16"

  t2_result := ch.recv().unwrap();
  printf("thread %zu received %d\n", Concurrency.get_thread_id(), t2_result);
  // It should print
  // "thread ? sent 18"

  result := (t1_result + t2_result);
  printf("result: %d\n", result);

  return 0;
};

export main;
