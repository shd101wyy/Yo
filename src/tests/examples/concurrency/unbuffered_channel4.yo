
open import "std/libc/stdio.yo";

main :: (fn() -> unit) {
  // ch := chan(i32, 10);
  ch := chan(i32);

  i := 0;
  while i < 10, i = (i + 1), {
    j := i;  // Capture by value
    go {
      ch <- j;
      printf("Sent %d\n", j);
    };

    // val := <-(ch).unwrap();
    // printf("Received %d\n", val);
  };

  i = 0;
  while i < 10, i = (i + 1), {
    val := <-(ch).unwrap();
    printf("Received %d\n", val);
  };

  printf("Done\n");
};

export main;
