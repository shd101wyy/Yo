open import "std";
open import "std/libc/stdio.yo";

return_i32_1 :: (fn(s : *(u8), val: i32) -> i32) {
  printf("%s\n", s);
  return val;
};

return_i32_2 :: (fn(s : *(u8), val: i32) -> i32) {
  printf("%s\n", s);
  return val;
};

main :: (fn() -> i32) {
  t1 := spawn return_i32_1("world", 16); // both return_i32_1 and return_i32_2 should generate the same C thread constructor because their function signatures are identical
  t2 := spawn return_i32_2("hello", 18);
  
  t1_result := t1.wait();
  t2_result := t2.wait();
  result := (t1_result + t2_result);

  printf("result: %d\n", result);
  return result;
};

export main;