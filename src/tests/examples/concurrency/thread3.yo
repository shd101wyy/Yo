open import "std";
open import "std/libc/stdio.yo";

MyBox :: object
  (*) : i32,

  dispose :: ((fn(self : Self) -> unit) {
    printf("Disposing MyBox with value: %d\n", self.(*));
  })
;

say :: (fn(s : *(u8), val: MyBox) -> i32) {
  printf("%s\n", s);
  return val.*;
};

main :: (fn() -> i32) {
  t1 := spawn say("world", MyBox(16));
  t2 := spawn say("hello", MyBox(18));
  
  t1_result := t1.wait();
  t2_result := t2.wait();
  result := (t1_result + t2_result);

  printf("result: %d\n", result);
  return result;
};

export main;