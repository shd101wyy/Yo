open import "std";
open import "std/libc/stdio.yo";

// Test configurable stack sizes with segregated free lists
// This test verifies:
// 1. Default 16KB stack size works
// 2. Custom stack sizes (64KB, 128KB) work
// 3. Segregated free lists work for common sizes
// 4. Custom pool works for non-standard sizes

main :: (fn() -> unit) {
  Concurrency.set_maximum_threads(4);
  
  ch := chan(i32);
  
  // Test 1: Default 16KB stack (segregated pool)
  async {
    printf("[Task 1] Using default 16KB stack\n");
    ch <- 1;
  };
  
  // Test 2: 64KB stack (segregated pool)
  async {
    printf("[Task 2] Using 64KB stack\n");
    ch <- 2;
  }, { stack_size: (1024 * 64) };
  
  // Test 3: 128KB stack (segregated pool)
  async {
    printf("[Task 3] Using 128KB stack\n");
    ch <- 3;
  }, { stack_size: (1024 * 128) };
  
  // Test 4: Custom size (48KB - custom pool)
  async {
    printf("[Task 4] Using custom 48KB stack\n");
    ch <- 4;
  }, { stack_size: (1024 * 48) };
  
  // Test 5: Multiple tasks with same size (pool reuse)
  async {
    printf("[Task 5] Using 64KB stack (pool reuse)\n");
    ch <- 5;
  }, { stack_size: (1024 * 64) };
  
  async {
    printf("[Task 6] Using 64KB stack (pool reuse)\n");
    ch <- 6;
  }, { stack_size: (1024 * 64) };
  
  // Collect results
  r1 := <-(ch); v1 := r1.unwrap();
  r2 := <-(ch); v2 := r2.unwrap();
  r3 := <-(ch); v3 := r3.unwrap();
  r4 := <-(ch); v4 := r4.unwrap();
  r5 := <-(ch); v5 := r5.unwrap();
  r6 := <-(ch); v6 := r6.unwrap();
  
  sum := (((((v1 + v2) + v3) + v4) + v5) + v6);
  printf("All tasks completed. Sum = %d (expected 21)\n", sum);
  
  cond(
    (sum == 21) => {
      printf("✓ Configurable stack sizes work correctly!\n");
    },
    true => {
      printf("✗ Test failed: sum=%d (expected 21)\n", sum);
    });
};

export main;
