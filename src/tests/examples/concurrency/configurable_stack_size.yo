
open import "std/libc/stdio.yo";

// Test configurable stack sizes with segregated free lists
// This test verifies:
// 1. Default 16KB stack size works
// 2. Custom stack sizes (64KB, 128KB) work
// 3. Segregated free lists work for common sizes
// 4. Custom pool works for non-standard sizes

main :: (fn() -> unit) {
  Concurrency.set_maximum_threads(4);
  
  // Use buffered channel
  ch := chan(i32, 10);
  
  // Use unbuffered channel
  // ch := chan(i32);

  // Test 1: Default 16KB stack (segregated pool)
  go {
    ch <- 1;
    printf("[Task 1] Sent 1 (default 16KB stack)\n");
  };
  
  // Test 2: 64KB stack (segregated pool)
  go {
    ch <- 2;
    printf("[Task 2] Sent 2 (64KB stack)\n");
  }, { stack_size: (1024 * 64) };
  
  // Test 3: 128KB stack (segregated pool)
  go {
    ch <- 3;
    printf("[Task 3] Sent 3 (128KB stack)\n");
  }, { stack_size: (1024 * 128) };
  
  // Test 4: Custom size (48KB - custom pool)
  go {
    ch <- 4;
    printf("[Task 4] Sent 4 (custom 48KB stack)\n");
  }, { stack_size: (1024 * 48) };
  
  // Test 5: Multiple tasks with same size (pool reuse)
  go {
    ch <- 5;
    printf("[Task 5] Sent 5 (64KB stack - pool reuse)\n");
  }, { stack_size: (1024 * 64) };
  
  go {
    ch <- 6;
    printf("[Task 6] Sent 6 (64KB stack - pool reuse)\n");
  }, { stack_size: (1024 * 64) };
  
  // Collect results (order doesn't matter with buffered channel)
  r1 := <-(ch); v1 := r1.unwrap(); printf("Received value: %d\n", v1);
  r2 := <-(ch); v2 := r2.unwrap(); printf("Received value: %d\n", v2);
  r3 := <-(ch); v3 := r3.unwrap(); printf("Received value: %d\n", v3);
  r4 := <-(ch); v4 := r4.unwrap(); printf("Received value: %d\n", v4);
  r5 := <-(ch); v5 := r5.unwrap(); printf("Received value: %d\n", v5);
  r6 := <-(ch); v6 := r6.unwrap(); printf("Received value: %d\n", v6);
  
  sum := (((((v1 + v2) + v3) + v4) + v5) + v6);
  printf("All tasks completed. Sum = %d (expected 21)\n", sum);
  
  cond(
    (sum == 21) => {
      printf("✓ Configurable stack sizes work correctly!\n");
    },
    true => {
      printf("✗ Test failed: sum=%d (expected 21)\n", sum);
    });
};

export main;
