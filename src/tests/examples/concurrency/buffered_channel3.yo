
open import "std/libc/stdio.yo";

extern "Yo",
  __yo_chan_send :
    fn(forall(T: Type), ch : Chan(T), value : T) -> unit,
  __yo_chan_recv :
    fn(forall(T: Type), ch : Chan(T)) -> Option(T),
  __yo_chan_close :
    fn(forall(T: Type), ch : Chan(T)) -> unit
;

MyBox :: object
  (*) : i32,

  dispose :: ((fn(self : Self) -> unit) {
    printf("Disposing MyBox with value: %d\n", self.*);
  })
;

main :: (fn() -> i32) {
  ch := chan(MyBox, 2); // buffered channel with capacity 2

  __yo_chan_send(ch, MyBox(1)); // doesn't block
  __yo_chan_send(ch, MyBox(2)); // doesn't block

  v1 := __yo_chan_recv(ch).unwrap(); // receives 1
  printf("%d\n", v1.*);
  printf("%d\n", __yo_chan_recv(ch).unwrap().*); // receives 2

  return 0;
};

export main;
