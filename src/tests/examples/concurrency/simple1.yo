open import "std";
open import "std/libc/stdio.yo";

// Test simple async without channels (should work with stackless)
main :: (fn() -> unit) {
  async {
    printf("Hello from async 1\n");
  };
  
  async {
    printf("Hello from async 2\n");
  };
  
  async {
    printf("Hello from async 3\n");
  };
};

export main;
