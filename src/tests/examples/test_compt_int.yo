open import "std";

/**
 * Test compile-time integer operations
 * This file tests the __yo_compt_int_* functions that operate
 * on compile-time known integer values.
 */
main :: (()-> unit) {
  // Basic integer operations
  a :: 10;
  b :: 3;
  c :: 10;
  zero :: 0;
  
  // Arithmetic operations
  sum :: (a + b);        // 13
  diff :: (a - b);       // 7
  prod :: (a * b);       // 30
  quot :: (a / b);       // 3 (integer division)
  remainder :: (a % b);  // 1
  
  // Unary operations
  neg_a :: -(a);       // -10
  neg_zero :: zero.neg(); // 0
  
  // Comparison operations
  eq_test :: (a == c);   // true (10 == 10)
  eq_false :: (a == b);  // false (10 == 3)
  neq_test :: (a != b);  // true (10 != 3)
  neq_false :: (a != c); // false (10 != 10)
  lt_test :: (b < a);    // true (3 < 10)
  lt_false :: (a < b);   // false (10 < 3)
  lte_test :: (b <= a);  // true (3 <= 10)
  lte_equal :: (a <= c); // true (10 <= 10)
  gt_test :: (a > b);    // true (10 > 3)
  gt_false :: (b > a);   // false (3 > 10)
  gte_test :: (a >= b);  // true (10 >= 3)
  gte_equal :: (a >= c); // true (10 >= 10)
  
  // Type conversion operations
  int_to_float :: a.as(f64);   // 10.0
  int_to_string :: a.to_string(); // "10"
  
  // Test with compile-time assertions
  // Arithmetic
  compt_assert(sum == 13);
  compt_assert(diff == 7);
  compt_assert(prod == 30);
  compt_assert(quot == 3);
  compt_assert(remainder == 1);
  
  // Unary operations
  compt_assert(neg_a == (10).neg());
  compt_assert(neg_zero == 0);
  
  // Comparisons
  compt_assert(eq_test == true);
  compt_assert(eq_false == false);
  compt_assert(neq_test == true);
  compt_assert(neq_false == false);
  compt_assert(lt_test == true);
  compt_assert(lt_false == false);
  compt_assert(lte_test == true);
  compt_assert(lte_equal == true);
  compt_assert(gt_test == true);
  compt_assert(gt_false == false);
  compt_assert(gte_test == true);
  compt_assert(gte_equal == true);
  
  // Type conversions
  compt_assert(int_to_float == 10.0);
  compt_assert(int_to_string == "10");
  
  // Test with negative numbers
  {
    neg_num :: 5.neg();
    pos_num :: 7;
    
    // Arithmetic with negatives
    neg_sum :: (neg_num + pos_num);     // 2
    neg_diff :: (neg_num - pos_num);    // -12
    neg_prod :: (neg_num * pos_num);    // -35
    neg_quot :: (neg_num / pos_num);    // 0 (integer division: -5/7 = 0)
    
    // Comparisons with negatives
    neg_lt :: (neg_num < pos_num);      // true (-5 < 7)
    neg_gt :: (pos_num > neg_num);      // true (7 > -5)
    
    compt_assert(neg_sum == 2);
    compt_assert(neg_diff == 12.neg());
    compt_assert(neg_prod == 35.neg());
    compt_assert(neg_quot == 0);
    compt_assert(neg_lt == true);
    compt_assert(neg_gt == true);
  };
  
  // Test edge cases
  {
    // Zero operations
    zero_sum :: (zero + a);      // 10
    zero_diff1 :: (a - zero);    // 10
    zero_diff2 :: (zero - a);    // -10
    zero_prod :: (zero * a);     // 0
    
    compt_assert(zero_sum == 10);
    compt_assert(zero_diff1 == 10);
    compt_assert(zero_diff2 == 10.neg());
    compt_assert(zero_prod == 0);
    
    // Identity operations
    identity_sum :: (a + zero);  // 10
    identity_prod :: (a * 1);    // 10
    
    compt_assert(identity_sum == 10);
    compt_assert(identity_prod == 10);
    
    // Self operations
    self_sub :: (a - a);         // 0
    self_div :: (a / a);         // 1
    self_mod :: (a % a);         // 0
    
    compt_assert(self_sub == 0);
    compt_assert(self_div == 1);
    compt_assert(self_mod == 0);
  };
  
  // Test larger numbers
  {
    large1 :: 1000;
    large2 :: 999;
    
    large_sum :: (large1 + large2);     // 1999
    large_diff :: (large1 - large2);    // 1
    large_prod :: (large1 * 2);         // 2000
    large_div :: (large1 / 10);         // 100
    large_mod :: (large1 % 7);          // 6 (1000 % 7 = 6)
    
    compt_assert(large_sum == 1999);
    compt_assert(large_diff == 1);
    compt_assert(large_prod == 2000);
    compt_assert(large_div == 100);
    compt_assert(large_mod == 6);
    
    // String conversion of large numbers
    large_str :: large1.to_string();
    compt_assert(large_str == "1000");
  };
  
  // Test modulo with different numbers
  {
    mod_tests1 :: (17 % 5);    // 2
    mod_tests2 :: (20 % 4);    // 0
    mod_tests3 :: (7 % 10);    // 7
    
    compt_assert(mod_tests1 == 2);
    compt_assert(mod_tests2 == 0);
    compt_assert(mod_tests3 == 7);
  };
  
  // Test chained operations (order of operations)
  {
    // Note: In Yo, there's no operator precedence, so we need explicit parentheses
    chain1 :: ((a + b) * 2);        // (10 + 3) * 2 = 26
    chain2 :: (a + (b * 2));        // 10 + (3 * 2) = 16
    chain3 :: ((a / b) + 1);        // (10 / 3) + 1 = 3 + 1 = 4
    
    compt_assert(chain1 == 26);
    compt_assert(chain2 == 16);
    compt_assert(chain3 == 4);
  };
  
  // Test conversion consistency
  {
    num :: 42;
    float_conv :: num.as(f64);
    string_conv :: num.to_string();
    
    // Convert back through different paths
    compt_assert(float_conv == 42.0);
    compt_assert(string_conv == "42");
    
    // Test negative conversion
    neg_num :: 42.neg();
    neg_float :: neg_num.as(f64);
    neg_string :: neg_num.to_string();
    
    compt_assert(neg_float == 42.0.neg());
    compt_assert(neg_string == "-42");
  };
  
  // Test division edge cases
  {
    // Positive division
    div1 :: (15 / 3);    // 5
    div2 :: (16 / 3);    // 5 (integer division)
    div3 :: (2 / 5);     // 0
    
    compt_assert(div1 == 5);
    compt_assert(div2 == 5);
    compt_assert(div3 == 0);
    
    // Test that division by zero would cause compile-time error
    // This should be commented out as it would cause compilation to fail:
    // div_by_zero :: (a / zero);  // Should cause compile-time error
  };
  
  ()
};
