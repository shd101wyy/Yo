open import "std";

/**
 * Test usize (platform-dependent unsigned integer) operations
 * Range: 0 to platform-dependent maximum (typically 2^32-1 or 2^64-1)
 */
main :: (()-> unit) {
  // Basic usize values
  a :: 100000.as(usize);
  b :: 25000.as(usize);
  c :: 100000.as(usize);
  zero :: 0.as(usize);
  
  // Arithmetic operations
  sum :: (a + b);        // 125000usize
  diff :: (a - b);       // 75000usize
  prod :: (a * b);       // 2500000000usize
  quot :: (a / b);       // 4usize (integer division)
  remainder :: (a % b);  // 0usize (100000 % 25000 = 0)
  
  // Comparison operations
  eq_test :: (a == c);   // true (100000usize == 100000usize)
  eq_false :: (a == b);  // false (100000usize == 25000usize)
  neq_test :: (a != b);  // true (100000usize != 25000usize)
  neq_false :: (a != c); // false (100000usize != 100000usize)
  lt_test :: (b < a);    // true (25000usize < 100000usize)
  lt_false :: (a < b);   // false (100000usize < 25000usize)
  lte_test :: (b <= a);  // true (25000usize <= 100000usize)
  lte_equal :: (a <= c); // true (100000usize <= 100000usize)
  gt_test :: (a > b);    // true (100000usize > 25000usize)
  gt_false :: (b > a);   // false (25000usize > 100000usize)
  gte_test :: (a >= b);  // true (100000usize >= 25000usize)
  gte_equal :: (a >= c); // true (100000usize >= 100000usize)
  
  // Type conversion operations
  usize_to_u64 :: a.as(u64);      // 100000u64
  usize_to_i64 :: a.as(i64);      // 100000i64
  usize_to_f32 :: a.as(f32);      // 100000.0f32
  usize_to_f64 :: a.as(f64);      // 100000.0f64
  usize_to_string :: a.to_string(); // "100000"
  
  // Test with compile-time assertions
  // Arithmetic
  compt_assert(sum == (125000.as(usize)));
  compt_assert(diff == (75000.as(usize)));
  compt_assert(prod == (2500000000.as(usize)));
  compt_assert(quot == (4.as(usize)));
  compt_assert(remainder == (0.as(usize)));
  
  // Comparisons
  compt_assert(eq_test == true);
  compt_assert(eq_false == false);
  compt_assert(neq_test == true);
  compt_assert(neq_false == false);
  compt_assert(lt_test == true);
  compt_assert(lt_false == false);
  compt_assert(lte_test == true);
  compt_assert(lte_equal == true);
  compt_assert(gt_test == true);
  compt_assert(gt_false == false);
  compt_assert(gte_test == true);
  compt_assert(gte_equal == true);
  
  // Type conversions
  compt_assert(usize_to_u64 == (100000.as(u64)));
  compt_assert(usize_to_i64 == (100000.as(i64)));
  compt_assert(usize_to_f32 == (100000.0.as(f32)));
  compt_assert(usize_to_f64 == (100000.0.as(f64)));
  compt_assert(usize_to_string == "100000");
  
  // Test zero operations
  {
    zero_sum :: (zero + a);      // 100000usize
    zero_diff1 :: (a - zero);    // 100000usize
    zero_diff2 :: (zero - a);    // underflow behavior (wraps around)
    zero_prod :: (zero * a);     // 0usize
    
    compt_assert(zero_sum == (100000.as(usize)));
    compt_assert(zero_diff1 == (100000.as(usize)));
    compt_assert(zero_prod == (0.as(usize)));
    
    // Identity operations
    identity_sum :: (a + zero);  // 100000usize
    identity_prod :: (a * 1.as(usize));  // 100000usize
    
    compt_assert(identity_sum == (100000.as(usize)));
    compt_assert(identity_prod == (100000.as(usize)));
    
    // Self operations
    self_sub :: (a - a);         // 0usize
    self_div :: (a / a);         // 1usize
    self_mod :: (a % a);         // 0usize
    
    compt_assert(self_sub == (0.as(usize)));
    compt_assert(self_div == (1.as(usize)));
    compt_assert(self_mod == (0.as(usize)));
  };
  
  // Test larger values (safe on all platforms)
  {
    large1 :: 1000000.as(usize);
    large2 :: 500000.as(usize);
    
    large_sum :: (large1 + large2);     // 1500000usize
    large_diff :: (large1 - large2);    // 500000usize
    large_div :: (large1 / 1000.as(usize)); // 1000usize
    large_mod :: (large1 % 7.as(usize));  // 6usize (1000000 % 7 = 1)
    
    compt_assert(large_sum == (1500000.as(usize)));
    compt_assert(large_diff == (500000.as(usize)));
    compt_assert(large_div == (1000.as(usize)));
    compt_assert(large_mod == (1.as(usize)));
  };
  
  // Test various divisions
  {
    div1 :: (200000.as(usize) / 8.as(usize));       // 25000usize
    div2 :: (200001.as(usize) / 8.as(usize));       // 25000usize (integer division)
    div3 :: (7.as(usize) / 1000.as(usize));         // 0usize
    
    compt_assert(div1 == (25000.as(usize)));
    compt_assert(div2 == (25000.as(usize)));
    compt_assert(div3 == (0.as(usize)));
  };
  
  // Test modulo operations
  {
    mod1 :: (17.as(usize) % 5.as(usize));        // 2usize
    mod2 :: (20.as(usize) % 4.as(usize));        // 0usize
    mod3 :: (7.as(usize) % 10.as(usize));        // 7usize
    mod4 :: (1000000.as(usize) % 997.as(usize)); // 9usize (1000000 % 997 = 9)
    
    compt_assert(mod1 == (2.as(usize)));
    compt_assert(mod2 == (0.as(usize)));
    compt_assert(mod3 == (7.as(usize)));
    compt_assert(mod4 == (9.as(usize)));
  };
  
  // Test chained operations
  {
    chain1 :: ((a + b) / 5.as(usize));    // (100000usize + 25000usize) / 5usize = 25000usize
    chain2 :: (a + (b * 2.as(usize)));    // 100000usize + (25000usize * 2usize) = 150000usize
    chain3 :: ((a / b) + 1.as(usize));    // (100000usize / 25000usize) + 1usize = 5usize
    
    compt_assert(chain1 == (25000.as(usize)));
    compt_assert(chain2 == (150000.as(usize)));
    compt_assert(chain3 == (5.as(usize)));
  };
  
  // Test powers of 2 (common for array indexing)
  {
    pow2_10 :: 1024.as(usize);           // 2^10
    pow2_16 :: 65536.as(usize);          // 2^16
    
    div_pow2 :: (pow2_16 / pow2_10);     // 64usize (2^6)
    mod_pow2 :: (1025.as(usize) % pow2_10); // 1usize
    
    compt_assert(div_pow2 == (64.as(usize)));
    compt_assert(mod_pow2 == (1.as(usize)));
  };
  
  // Test memory-related sizes (typical use case for usize)
  {
    byte_size :: 1.as(usize);
    kb_size :: 1024.as(usize);
    mb_size :: 1048576.as(usize);   // 1024 * 1024
    
    kb_in_bytes :: (kb_size / byte_size);    // 1024usize
    mb_in_kb :: (mb_size / kb_size);         // 1024usize
    partial_mb :: (1500000.as(usize) / mb_size); // 1usize (integer division)
    
    compt_assert(kb_in_bytes == (1024.as(usize)));
    compt_assert(mb_in_kb == (1024.as(usize)));
    compt_assert(partial_mb == (1.as(usize)));
  };
  
  // Test string conversions
  {
    zero_str :: zero.to_string();
    large_str :: (123456.as(usize)).to_string();
    
    compt_assert(zero_str == "0");
    compt_assert(large_str == "123456");
  };
  
  // Test array indexing scenarios (common usize usage)
  {
    // Simulate array bounds calculations
    array_len :: 100.as(usize);
    index1 :: 50.as(usize);
    index2 :: 99.as(usize);
    
    within_bounds1 :: (index1 < array_len);  // true
    within_bounds2 :: (index2 < array_len);  // true
    out_of_bounds :: (array_len < array_len); // false
    
    last_index :: (array_len - 1.as(usize)); // 99usize
    mid_index :: (array_len / 2.as(usize));  // 50usize
    
    compt_assert(within_bounds1 == true);
    compt_assert(within_bounds2 == true);
    compt_assert(out_of_bounds == false);
    compt_assert(last_index == (99.as(usize)));
    compt_assert(mid_index == (50.as(usize)));
  };
  
  ()
};
