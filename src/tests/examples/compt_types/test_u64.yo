open import "std";

/**
 * Test u64 (unsigned 64-bit integer) operations
 * Range: 0 to 18446744073709551615
 */
main :: (fn() -> unit) {
  // Basic u64 values
  a :: u64(1000000000000);
  b :: u64(250000000000);
  c :: u64(1000000000000);
  zero :: u64(0);
  max_val :: u64(18446744073709551615);
  
  // Arithmetic operations
  sum :: (a + b);        // 1250000000000u64
  diff :: (a - b);       // 750000000000u64
  prod :: (a * b);       // 250000000000000000000000u64 (may overflow)
  quot :: (a / b);       // 4u64 (integer division)
  remainder :: (a % b);  // 0u64
  
  // Comparison operations
  eq_test :: (a == c);   // true
  eq_false :: (a == b);  // false
  neq_test :: (a != b);  // true
  neq_false :: (a != c); // false
  lt_test :: (b < a);    // true
  lt_false :: (a < b);   // false
  lte_test :: (b <= a);  // true
  lte_equal :: (a <= c); // true
  gt_test :: (a > b);    // true
  gt_false :: (b > a);   // false
  gte_test :: (a >= b);  // true
  gte_equal :: (a >= c); // true
  
  // Type conversion operations
  u64_to_f32 :: f32(a);      // 1000000000000.0f32 (may lose precision)
  u64_to_f64 :: f64(a);      // 1000000000000.0f64
  u64_to_string :: a.to_string(); // "1000000000000"
  
  // Test with compile-time assertions
  // Arithmetic
  compt_assert(sum == u64(1250000000000));
  compt_assert(diff == u64(750000000000));
  compt_assert(quot == u64(4));
  compt_assert(remainder == u64(0));
  
  // Comparisons
  compt_assert(eq_test == true);
  compt_assert(eq_false == false);
  compt_assert(neq_test == true);
  compt_assert(neq_false == false);
  compt_assert(lt_test == true);
  compt_assert(lt_false == false);
  compt_assert(lte_test == true);
  compt_assert(lte_equal == true);
  compt_assert(gt_test == true);
  compt_assert(gt_false == false);
  compt_assert(gte_test == true);
  compt_assert(gte_equal == true);
  
  // Type conversions
  compt_assert(u64_to_f64 == f64(1000000000000.0));
  compt_assert(u64_to_string == "1000000000000");
  
  // Test boundary values
  {
    min_val :: u64(0);
    
    // Operations with min value
    min_sum :: (min_val + u64(1));     // 1u64
    min_sub :: (min_val - u64(1));     // underflow wraps to max
    min_mult :: (min_val * u64(5000000));  // 0u64
    
    // Operations with large values near max
    large_val :: u64(9223372036854775807); // Close to max
    large_sum :: (large_val + u64(1000));  // Still within range
    large_mult :: (large_val / u64(1000)); // 9223372036854775u64
    
    compt_assert(min_sum == u64(1));
    compt_assert(min_mult == u64(0));
    compt_assert(large_sum == u64(9223372036854776807));
    compt_assert(large_mult == u64(9223372036854775));
    
    // Boundary comparisons
    compt_assert(min_val < large_val);
    compt_assert(large_val > min_val);
    compt_assert(min_val <= large_val);
    compt_assert(large_val >= min_val);
  };
  
  // Test zero operations
  {
    zero_sum :: (zero + a);      // 1000000000000u64
    zero_diff1 :: (a - zero);    // 1000000000000u64
    zero_diff2 :: (zero - a);    // underflow behavior
    zero_prod :: (zero * a);     // 0u64
    
    compt_assert(zero_sum == u64(1000000000000));
    compt_assert(zero_diff1 == u64(1000000000000));
    compt_assert(zero_prod == u64(0));
    
    // Identity operations
    identity_sum :: (a + zero);  // 1000000000000u64
    identity_prod :: (a * u64(1));  // 1000000000000u64
    
    compt_assert(identity_sum == u64(1000000000000));
    compt_assert(identity_prod == u64(1000000000000));
    
    // Self operations
    self_sub :: (a - a);         // 0u64
    self_div :: (a / a);         // 1u64
    self_mod :: (a % a);         // 0u64
    
    compt_assert(self_sub == u64(0));
    compt_assert(self_div == u64(1));
    compt_assert(self_mod == u64(0));
  };
  
  // Test very large values
  {
    huge1 :: u64(1000000000000000000);  // 10^18
    huge2 :: u64(500000000000000000);   // 5 * 10^17
    
    huge_sum :: (huge1 + huge2);     // 1.5 * 10^18
    huge_diff :: (huge1 - huge2);    // 5 * 10^17
    huge_div :: (huge1 / u64(1000000)); // 10^12
    huge_mod :: (huge1 % u64(7)); // 1u64 (10^18 % 7 = 1)
    
    compt_assert(huge_sum == u64(1500000000000000000));
    compt_assert(huge_diff == u64(500000000000000000));
    compt_assert(huge_div == u64(1000000000000));
    compt_assert(huge_mod == u64(1));
  };
  
  // Test various divisions
  {
    div1 :: (u64(2000000000000) / u64(8));       // 250000000000u64
    div2 :: (u64(2000000000001) / u64(8));       // 250000000000u64 (integer division)
    div3 :: (u64(7) / u64(1000000000000));       // 0u64
    
    compt_assert(div1 == u64(250000000000));
    compt_assert(div2 == u64(250000000000));
    compt_assert(div3 == u64(0));
  };
  
  // Test modulo operations
  {
    mod1 :: (u64(17) % u64(5));        // 2u64
    mod2 :: (u64(20) % u64(4));        // 0u64
    mod3 :: (u64(7) % u64(10));        // 7u64
    mod4 :: (u64(1000000000000000000) % u64(997)); // Large modulo
    
    compt_assert(mod1 == u64(2));
    compt_assert(mod2 == u64(0));
    compt_assert(mod3 == u64(7));
    // mod4 result depends on calculation
  };
  
  // Test chained operations
  {
    chain1 :: ((a + b) / u64(5));    // (10^12 + 2.5*10^11) / 5 = 2.5*10^11
    chain2 :: (a + (b * u64(2)));    // 10^12 + (2.5*10^11 * 2) = 1.5*10^12
    chain3 :: ((a / b) + u64(1));    // (10^12 / 2.5*10^11) + 1 = 5u64
    
    compt_assert(chain1 == u64(250000000000));
    compt_assert(chain2 == u64(1500000000000));
    compt_assert(chain3 == u64(5));
  };
  
  // Test powers of 2 (important for u64)
  {
    pow2_32 :: u64(4294967296);        // 2^32
    pow2_40 :: u64(1099511627776);     // 2^40
    
    div_pow2 :: (pow2_40 / pow2_32);      // 256u64 (2^8)
    mod_pow2 :: (u64(4294967297) % pow2_32); // 1u64
    
    compt_assert(div_pow2 == u64(256));
    compt_assert(mod_pow2 == u64(1));
  };
  
  // Test string conversions
  {
    zero_str :: zero.to_string();
    large_str :: u64(123456789012345).to_string();
    
    compt_assert(zero_str == "0");
    compt_assert(large_str == "123456789012345");
  };
  
  ()
};
