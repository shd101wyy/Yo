open import "std";

/**
 * Test i32 (signed 32-bit integer) operations
 * Range: -2147483648 to 2147483647
 */
main :: (fn() -> unit) {
  // Basic i32 values
  a :: i32(100000);
  b :: i32(25000);
  c :: i32(100000);
  zero :: i32(0);
  neg_val :: i32(-50000);
  max_val :: i32(2147483647);
  min_val :: i32(-2147483648);
  
  // Arithmetic operations
  sum :: (a + b);        // 125000i32
  diff :: (a - b);       // 75000i32
  prod :: (a * b);       // 2500000000i32
  quot :: (a / b);       // 4i32 (integer division)
  remainder :: (a % b);  // 0i32 (100000 % 25000 = 0)
  
  // Unary operations
  neg_a :: -(a);         // -100000i32
  neg_zero :: -(zero);   // 0i32
  
  // Comparison operations
  eq_test :: (a == c);   // true (100000i32 == 100000i32)
  eq_false :: (a == b);  // false (100000i32 == 25000i32)
  neq_test :: (a != b);  // true (100000i32 != 25000i32)
  neq_false :: (a != c); // false (100000i32 != 100000i32)
  lt_test :: (b < a);    // true (25000i32 < 100000i32)
  lt_false :: (a < b);   // false (100000i32 < 25000i32)
  lte_test :: (b <= a);  // true (25000i32 <= 100000i32)
  lte_equal :: (a <= c); // true (100000i32 <= 100000i32)
  gt_test :: (a > b);    // true (100000i32 > 25000i32)
  gt_false :: (b > a);   // false (25000i32 > 100000i32)
  gte_test :: (a >= b);  // true (100000i32 >= 25000i32)
  gte_equal :: (a >= c); // true (100000i32 >= 100000i32)
  
  // Type conversion operations
  i32_to_i64 :: i64(a);      // 100000i64
  i32_to_u64 :: u64(a);      // 100000u64
  i32_to_f32 :: f32(a);      // 100000.0f32
  i32_to_f64 :: f64(a);      // 100000.0f64
  i32_to_string :: a.to_string(); // "100000"
  
  // Test with compile-time assertions
  // Arithmetic
  compt_assert(sum == i32(125000));
  compt_assert(diff == i32(75000));
  compt_assert(prod == i32(2500000000));
  compt_assert(quot == i32(4));
  compt_assert(remainder == i32(0));
  
  // Unary operations
  compt_assert(neg_a == i32(-100000));
  compt_assert(neg_zero == i32(0));
  
  // Comparisons
  compt_assert(eq_test == true);
  compt_assert(eq_false == false);
  compt_assert(neq_test == true);
  compt_assert(neq_false == false);
  compt_assert(lt_test == true);
  compt_assert(lt_false == false);
  compt_assert(lte_test == true);
  compt_assert(lte_equal == true);
  compt_assert(gt_test == true);
  compt_assert(gt_false == false);
  compt_assert(gte_test == true);
  compt_assert(gte_equal == true);
  
  // Type conversions
  compt_assert(i32_to_i64 == i64(100000));
  compt_assert(i32_to_u64 == u64(100000));
  compt_assert(i32_to_f32 == f32(100000.0));
  compt_assert(i32_to_f64 == f64(100000.0));
  compt_assert(i32_to_string == "100000");
  
  // Test with negative numbers
  {
    neg_sum :: (neg_val + a);     // -50000 + 100000 = 50000i32
    neg_diff :: (neg_val - a);    // -50000 - 100000 = -150000i32
    neg_prod :: (neg_val * i32(2)); // -50000 * 2 = -100000i32
    neg_quot :: (neg_val / i32(10)); // -50000 / 10 = -5000i32
    
    // Comparisons with negatives
    neg_lt :: (neg_val < a);      // true (-50000 < 100000)
    neg_gt :: (a > neg_val);      // true (100000 > -50000)
    
    compt_assert(neg_sum == i32(50000));
    compt_assert(neg_diff == i32(-150000));
    compt_assert(neg_prod == i32(-100000));
    compt_assert(neg_quot == i32(-5000));
    compt_assert(neg_lt == true);
    compt_assert(neg_gt == true);
  };
  
  // Test boundary values
  {
    // Operations with min value
    min_sum :: (min_val + i32(1));     // -2147483647i32
    min_sub :: (min_val - i32(1));     // overflow behavior
    min_neg :: -(min_val);               // overflow: -(-2147483648) should be handled
    
    // Operations with max value
    max_sum :: (max_val + i32(1));     // overflow
    max_sub :: (max_val - i32(1));     // 2147483646i32
    max_neg :: -(max_val);               // -2147483647i32
    
    compt_assert(min_sum == i32(-2147483647));
    compt_assert(max_sub == i32(2147483646));
    compt_assert(max_neg == i32(-2147483647));
    
    // Boundary comparisons
    compt_assert(min_val < max_val);
    compt_assert(max_val > min_val);
    compt_assert(min_val <= max_val);
    compt_assert(max_val >= min_val);
  };
  
  // Test zero operations
  {
    zero_sum :: (zero + a);      // 100000i32
    zero_diff1 :: (a - zero);    // 100000i32
    zero_diff2 :: (zero - a);    // -100000i32
    zero_prod :: (zero * a);     // 0i32
    
    compt_assert(zero_sum == i32(100000));
    compt_assert(zero_diff1 == i32(100000));
    compt_assert(zero_diff2 == i32(-100000));
    compt_assert(zero_prod == i32(0));
    
    // Identity operations
    identity_sum :: (a + zero);  // 100000i32
    identity_prod :: (a * i32(1));  // 100000i32
    
    compt_assert(identity_sum == i32(100000));
    compt_assert(identity_prod == i32(100000));
    
    // Self operations
    self_sub :: (a - a);         // 0i32
    self_div :: (a / a);         // 1i32
    self_mod :: (a % a);         // 0i32
    
    compt_assert(self_sub == i32(0));
    compt_assert(self_div == i32(1));
    compt_assert(self_mod == i32(0));
  };
  
  // Test large values
  {
    large1 :: i32(1000000000);
    large2 :: i32(500000000);
    
    large_sum :: (large1 + large2);     // 1500000000i32
    large_diff :: (large1 - large2);    // 500000000i32
    large_div :: (large1 / i32(1000)); // 1000000i32
    large_mod :: (large1 % i32(7));  // 6i32 (1000000000 % 7 = 6)
    
    compt_assert(large_sum == i32(1500000000));
    compt_assert(large_diff == i32(500000000));
    compt_assert(large_div == i32(1000000));
    compt_assert(large_mod == i32(6));
  };
  
  // Test various divisions
  {
    div1 :: (i32(200000) / i32(8));       // 25000i32
    div2 :: (i32(200001) / i32(8));       // 25000i32 (integer division)
    div3 :: (i32(7) / i32(1000));         // 0i32
    
    // Negative divisions
    div4 :: (i32(-200000) / i32(8));    // -25000i32
    div5 :: (i32(200000) / -i32(8));    // -25000i32
    div6 :: (i32(-200000) / -i32(8)); // 25000i32
    
    compt_assert(div1 == i32(25000));
    compt_assert(div2 == i32(25000));
    compt_assert(div3 == i32(0));
    compt_assert(div4 == i32(-25000));
    compt_assert(div5 == i32(-25000));
    compt_assert(div6 == i32(25000));
  };
  
  // Test modulo operations
  {
    mod1 :: (i32(17) % i32(5));        // 2i32
    mod2 :: (i32(20) % i32(4));        // 0i32
    mod3 :: (i32(7) % i32(10));        // 7i32
    
    // Negative modulo
    mod4 :: (i32(-17) % i32(5));     // behavior depends on implementation
    mod5 :: (i32(17) % -i32(5));     // behavior depends on implementation
    
    compt_assert(mod1 == i32(2));
    compt_assert(mod2 == i32(0));
    compt_assert(mod3 == i32(7));
  };
  
  // Test chained operations
  {
    chain1 :: ((a + b) / i32(5));    // (100000i32 + 25000i32) / 5i32 = 25000i32
    chain2 :: (a + (b * i32(2)));    // 100000i32 + (25000i32 * 2i32) = 150000i32
    chain3 :: ((a / b) + i32(1));    // (100000i32 / 25000i32) + 1i32 = 5i32
    
    compt_assert(chain1 == i32(25000));
    compt_assert(chain2 == i32(150000));
    compt_assert(chain3 == i32(5));
  };
  
  // Test powers of 2 (common in systems programming)
  {
    pow2_10 :: i32(1024);           // 2^10
    pow2_20 :: i32(1048576);        // 2^20
    
    div_pow2 :: (pow2_20 / pow2_10);   // 1024i32
    mod_pow2 :: (i32(1025) % pow2_10); // 1i32
    
    compt_assert(div_pow2 == i32(1024));
    compt_assert(mod_pow2 == i32(1));
  };
  
  // Test string conversions
  {
    zero_str :: zero.to_string();
    neg_str :: neg_val.to_string();
    max_str :: max_val.to_string();
    min_str :: min_val.to_string();
    
    compt_assert(zero_str == "0");
    compt_assert(neg_str == "-50000");
    compt_assert(max_str == "2147483647");
    compt_assert(min_str == "-2147483648");
  };
  
  ()
};
