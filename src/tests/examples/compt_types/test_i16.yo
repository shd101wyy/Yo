open import "std";

/**
 * Test i16 (signed 16-bit integer) operations
 * Range: -32768 to 32767
 */
main :: (fn() -> unit) {
  // Basic i16 values
  a :: i16(1000);
  b :: i16(250);
  c :: i16(1000);
  zero :: i16(0);
  neg_val :: i16(-500);
  max_val :: i16(32767);
  min_val :: i16(-32768);
  
  // Arithmetic operations
  sum :: (a + b);        // 1250i16
  diff :: (a - b);       // 750i16
  prod :: (a * b);       // 250000i16 (may overflow)
  quot :: (a / b);       // 4i16 (integer division)
  remainder :: (a % b);  // 0i16 (1000 % 250 = 0)
  
  // Unary operations
  neg_a :: -(a);         // -1000i16
  neg_zero :: -(zero);   // 0i16
  
  // Comparison operations
  eq_test :: (a == c);   // true (1000i16 == 1000i16)
  eq_false :: (a == b);  // false (1000i16 == 250i16)
  neq_test :: (a != b);  // true (1000i16 != 250i16)
  neq_false :: (a != c); // false (1000i16 != 1000i16)
  lt_test :: (b < a);    // true (250i16 < 1000i16)
  lt_false :: (a < b);   // false (1000i16 < 250i16)
  lte_test :: (b <= a);  // true (250i16 <= 1000i16)
  lte_equal :: (a <= c); // true (1000i16 <= 1000i16)
  gt_test :: (a > b);    // true (1000i16 > 250i16)
  gt_false :: (b > a);   // false (250i16 > 1000i16)
  gte_test :: (a >= b);  // true (1000i16 >= 250i16)
  gte_equal :: (a >= c); // true (1000i16 >= 1000i16)
  
  // Type conversion operations
  i16_to_i32 :: i32(a);      // 1000i32
  i16_to_u32 :: u32(a);      // 1000u32
  i16_to_f32 :: f32(a);      // 1000.0f32
  i16_to_string :: a.to_string(); // "1000"
  
  // Test with compile-time assertions
  // Arithmetic
  compt_assert(sum == i16(1250));
  compt_assert(diff == i16(750));
  compt_assert(quot == i16(4));
  compt_assert(remainder == i16(0));
  
  // Unary operations
  n :: (-1000);
  x :: i16(n);
  compt_assert(neg_a == i16(-1000));
  compt_assert(neg_zero == i16(0));
  
  // Comparisons
  compt_assert(eq_test == true);
  compt_assert(eq_false == false);
  compt_assert(neq_test == true);
  compt_assert(neq_false == false);
  compt_assert(lt_test == true);
  compt_assert(lt_false == false);
  compt_assert(lte_test == true);
  compt_assert(lte_equal == true);
  compt_assert(gt_test == true);
  compt_assert(gt_false == false);
  compt_assert(gte_test == true);
  compt_assert(gte_equal == true);
  
  // Type conversions
  compt_assert(i16_to_i32 == i32(1000));
  compt_assert(i16_to_u32 == u32(1000));
  compt_assert(i16_to_f32 == (f32(1000.0)));
  compt_assert(i16_to_string == "1000");
  
  // Test with negative numbers
  {
    neg_sum :: (neg_val + a);     // -500 + 1000 = 500i16
    neg_diff :: (neg_val - a);    // -500 - 1000 = -1500i16
    neg_prod :: (neg_val * i16(2)); // -500 * 2 = -1000i16
    neg_quot :: (neg_val / i16(5)); // -500 / 5 = -100i16
    
    // Comparisons with negatives
    neg_lt :: (neg_val < a);      // true (-500 < 1000)
    neg_gt :: (a > neg_val);      // true (1000 > -500)
    
    compt_assert(neg_sum == i16(500));
    compt_assert(neg_diff == i16(-1500));
    compt_assert(neg_prod == i16(-1000));
    compt_assert(neg_quot == i16(-100));
    compt_assert(neg_lt == true);
    compt_assert(neg_gt == true);
  };
  
  // Test boundary values
  {
    // Operations with min value
    min_sum :: (min_val + i16(1));     // -32767i16
    min_sub :: (min_val - i16(1));     // overflow behavior
    min_neg :: -(min_val);               // overflow: -(-32768) should be handled
    
    // Operations with max value
    max_sum :: (max_val + i16(1));     // overflow
    max_sub :: (max_val - i16(1));     // 32766i16
    max_neg :: -(max_val);               // -32767i16
    
    compt_assert(min_sum == i16(-32767));
    compt_assert(max_sub == i16(32766));
    compt_assert(max_neg == i16(-32767));
    
    // Boundary comparisons
    compt_assert(min_val < max_val);
    compt_assert(max_val > min_val);
    compt_assert(min_val <= max_val);
    compt_assert(max_val >= min_val);
  };
  
  // Test zero operations
  {
    zero_sum :: (zero + a);      // 1000i16
    zero_diff1 :: (a - zero);    // 1000i16
    zero_diff2 :: (zero - a);    // -1000i16
    zero_prod :: (zero * a);     // 0i16
    
    compt_assert(zero_sum == i16(1000));
    compt_assert(zero_diff1 == i16(1000));
    compt_assert(zero_diff2 == i16(-1000));
    compt_assert(zero_prod == i16(0));
    
    // Identity operations
    identity_sum :: (a + zero);  // 1000i16
    identity_prod :: (a * i16(1));  // 1000i16
    
    compt_assert(identity_sum == i16(1000));
    compt_assert(identity_prod == i16(1000));
    
    // Self operations
    self_sub :: (a - a);         // 0i16
    self_div :: (a / a);         // 1i16
    self_mod :: (a % a);         // 0i16
    
    compt_assert(self_sub == i16(0));
    compt_assert(self_div == i16(1));
    compt_assert(self_mod == i16(0));
  };
  
  // Test large values
  {
    large1 :: i16(20000);
    large2 :: i16(12000);
    
    large_sum :: (large1 + large2);     // 32000i16
    large_diff :: (large1 - large2);    // 8000i16
    large_div :: (large1 / i16(10)); // 2000i16
    large_mod :: (large1 % i16(7));  // 6i16 (20000 % 7 = 1)
    
    compt_assert(large_sum == i16(32000));
    compt_assert(large_diff == i16(8000));
    compt_assert(large_div == i16(2000));
    compt_assert(large_mod == i16(1));
  };
  
  // Test various divisions
  {
    div1 :: (i16(2000) / i16(8));       // 250i16
    div2 :: (i16(2001) / i16(8));       // 250i16 (integer division)
    div3 :: (i16(7) / i16(100));        // 0i16
    
    // Negative divisions
    div4 :: (i16(-2000) / i16(8));    // -250i16
    div5 :: (i16(2000) / i16(-8));    // -250i16
    div6 :: (i16(-2000) / i16(-8)); // 250i16
    
    compt_assert(div1 == i16(250));
    compt_assert(div2 == i16(250));
    compt_assert(div3 == i16(0));
    compt_assert(div4 == i16(-250));
    compt_assert(div5 == i16(-250));
    compt_assert(div6 == i16(250));
  };
  
  // Test modulo operations
  {
    mod1 :: (i16(17) % i16(5));        // 2i16
    mod2 :: (i16(20) % i16(4));        // 0i16
    mod3 :: (i16(7) % i16(10));        // 7i16
    
    // Negative modulo
    mod4 :: (i16(-17) % i16(5));     // behavior depends on implementation
    mod5 :: (i16(17) % i16(-5));     // behavior depends on implementation
    
    compt_assert(mod1 == i16(2));
    compt_assert(mod2 == i16(0));
    compt_assert(mod3 == i16(7));
  };
  
  // Test chained operations
  {
    chain1 :: ((a + b) / i16(2));   // (1000i16 + 250i16) / 2i16 = 625i16
    chain2 :: (a + (b * i16(2)));   // 1000i16 + (250i16 * 2i16) = 1500i16
    chain3 :: ((a / b) + i16(1));   // (1000i16 / 250i16) + 1i16 = 5i16
    
    compt_assert(chain1 == i16(625));
    compt_assert(chain2 == i16(1500));
    compt_assert(chain3 == i16(5));
  };
  
  // Test string conversions
  {
    zero_str :: zero.to_string();
    neg_str :: neg_val.to_string();
    max_str :: max_val.to_string();
    min_str :: min_val.to_string();
    
    compt_assert(zero_str == "0");
    compt_assert(neg_str == "-500");
    compt_assert(max_str == "32767");
    compt_assert(min_str == "-32768");
  };
  
  ()
};
