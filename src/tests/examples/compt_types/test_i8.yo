open import "std";

/**
 * Test i8 (signed 8-bit integer) operations
 * Range: -128 to 127
 */
main :: (fn() -> unit) {
  // Basic i8 values
  a :: i8(50);
  b :: i8(25);
  c :: i8(50);
  zero :: i8(0);
  neg_val :: i8((30).neg());
  max_val :: i8(127);
  min_val :: i8((128).neg());
  
  // Arithmetic operations
  sum :: (a + b);        // 75i8
  diff :: (a - b);       // 25i8
  prod :: (a * b);       // 1250i8 (may overflow)
  quot :: (a / b);       // 2i8 (integer division)
  remainder :: (a % b);  // 0i8 (50 % 25 = 0)
  
  // Unary operations
  neg_a :: -(a);         // -50i8
  neg_zero :: -(zero);   // 0i8
  
  // Comparison operations
  eq_test :: (a == c);   // true (50i8 == 50i8)
  eq_false :: (a == b);  // false (50i8 == 25i8)
  neq_test :: (a != b);  // true (50i8 != 25i8)
  neq_false :: (a != c); // false (50i8 != 50i8)
  lt_test :: (b < a);    // true (25i8 < 50i8)
  lt_false :: (a < b);   // false (50i8 < 25i8)
  lte_test :: (b <= a);  // true (25i8 <= 50i8)
  lte_equal :: (a <= c); // true (50i8 <= 50i8)
  gt_test :: (a > b);    // true (50i8 > 25i8)
  gt_false :: (b > a);   // false (25i8 > 50i8)
  gte_test :: (a >= b);  // true (50i8 >= 25i8)
  gte_equal :: (a >= c); // true (50i8 >= 50i8)
  
  // Type conversion operations
  i8_to_i16 :: i16(a);      // 50i16
  i8_to_u16 :: u16(a);      // 50u16
  i8_to_f32 :: f32(a);      // 50.0f32
  i8_to_string :: a.to_string(); // "50"
  
  // Test with compile-time assertions
  // Arithmetic
  compt_assert(sum == i8(75));
  compt_assert(diff == i8(25));
  compt_assert(quot == i8(2));
  compt_assert(remainder == i8(0));
  
  // Unary operations
  compt_assert(neg_a == i8((50).neg()));
  compt_assert(neg_zero == i8(0));
  
  // Comparisons
  compt_assert(eq_test == true);
  compt_assert(eq_false == false);
  compt_assert(neq_test == true);
  compt_assert(neq_false == false);
  compt_assert(lt_test == true);
  compt_assert(lt_false == false);
  compt_assert(lte_test == true);
  compt_assert(lte_equal == true);
  compt_assert(gt_test == true);
  compt_assert(gt_false == false);
  compt_assert(gte_test == true);
  compt_assert(gte_equal == true);
  
  // Type conversions
  compt_assert(i8_to_i16 == i16(50));
  compt_assert(i8_to_u16 == u16(50));
  compt_assert(i8_to_f32 == f32(50.0));
  compt_assert(i8_to_string == "50");
  
  // Test with negative numbers
  {
    neg_sum :: (neg_val + a);     // -30 + 50 = 20i8
    neg_diff :: (neg_val - a);    // -30 - 50 = -80i8
    neg_prod :: (neg_val * i8(2)); // -30 * 2 = -60i8
    neg_quot :: (neg_val / i8(5)); // -30 / 5 = -6i8
    
    // Comparisons with negatives
    neg_lt :: (neg_val < a);      // true (-30 < 50)
    neg_gt :: (a > neg_val);      // true (50 > -30)
    
    compt_assert(neg_sum == i8(20));
    compt_assert(neg_diff == i8((80).neg()));
    compt_assert(neg_prod == i8((60).neg()));
    compt_assert(neg_quot == i8((6).neg()));
    compt_assert(neg_lt == true);
    compt_assert(neg_gt == true);
  };
  
  // Test boundary values
  {
    // Operations with min value
    min_sum :: (min_val + i8(1));     // -127i8
    min_sub :: (min_val - i8(1));     // overflow behavior
    min_neg :: -(min_val);               // overflow: -(-128) should be handled
    
    // Operations with max value
    max_sum :: (max_val + i8(1));     // overflow
    max_sub :: (max_val - i8(1));     // 126i8
    max_neg :: -(max_val);               // -127i8
    
    compt_assert(min_sum == i8((127).neg()));
    compt_assert(max_sub == i8(126));
    compt_assert(max_neg == i8((127).neg()));
    
    // Boundary comparisons
    compt_assert(min_val < max_val);
    compt_assert(max_val > min_val);
    compt_assert(min_val <= max_val);
    compt_assert(max_val >= min_val);
  };
  
  // Test zero operations
  {
    zero_sum :: (zero + a);      // 50i8
    zero_diff1 :: (a - zero);    // 50i8
    zero_diff2 :: (zero - a);    // -50i8
    zero_prod :: (zero * a);     // 0i8
    
    compt_assert(zero_sum == i8(50));
    compt_assert(zero_diff1 == i8(50));
    compt_assert(zero_diff2 == i8((50).neg()));
    compt_assert(zero_prod == i8(0));
    
    // Identity operations
    identity_sum :: (a + zero);  // 50i8
    identity_prod :: (a * i8(1));  // 50i8
    
    compt_assert(identity_sum == i8(50));
    compt_assert(identity_prod == i8(50));
    
    // Self operations
    self_sub :: (a - a);         // 0i8
    self_div :: (a / a);         // 1i8
    self_mod :: (a % a);         // 0i8
    
    compt_assert(self_sub == i8(0));
    compt_assert(self_div == i8(1));
    compt_assert(self_mod == i8(0));
  };
  
  // Test various divisions
  {
    div1 :: (i8(60) / i8(5));       // 12i8
    div2 :: (i8(61) / i8(5));       // 12i8 (integer division)
    div3 :: (i8(3) / i8(10));       // 0i8
    
    // Negative divisions
    div4 :: (i8((60).neg()) / i8(5));    // -12i8
    div5 :: (i8(60) / i8((5).neg()));    // -12i8
    div6 :: (i8((60).neg()) / i8((5).neg())); // 12i8
    
    compt_assert(div1 == i8(12));
    compt_assert(div2 == i8(12));
    compt_assert(div3 == i8(0));
    compt_assert(div4 == i8((12).neg()));
    compt_assert(div5 == i8((12).neg()));
    compt_assert(div6 == i8(12));
  };
  
  // Test modulo operations
  {
    mod1 :: (i8(17) % i8(5));        // 2i8
    mod2 :: (i8(20) % i8(4));        // 0i8
    mod3 :: (i8(7) % i8(10));        // 7i8
    
    // Negative modulo
    mod4 :: (i8((17).neg()) % i8(5));     // behavior depends on implementation
    mod5 :: (i8(17) % i8((5).neg()));     // behavior depends on implementation
    
    compt_assert(mod1 == i8(2));
    compt_assert(mod2 == i8(0));
    compt_assert(mod3 == i8(7));
  };
  
  // Test chained operations
  {
    chain1 :: ((a + b) * i8(2));   // (50i8 + 25i8) * 2i8 = 150i8 (may overflow)
    chain2 :: (a + (b * i8(2)));   // 50i8 + (25i8 * 2i8) = 100i8
    chain3 :: ((a / b) + i8(1));   // (50i8 / 25i8) + 1i8 = 3i8
    
    compt_assert(chain2 == i8(100));
    compt_assert(chain3 == i8(3));
  };
  
  // Test string conversions
  {
    zero_str :: zero.to_string();
    neg_str :: neg_val.to_string();
    max_str :: max_val.to_string();
    min_str :: min_val.to_string();
    
    compt_assert(zero_str == "0");
    compt_assert(neg_str == "-30");
    compt_assert(max_str == "127");
    compt_assert(min_str == "-128");
  };
  
  ()
};
