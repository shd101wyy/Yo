open import "std";

/**
 * Test i64 (signed 64-bit integer) operations
 * Range: -9223372036854775808 to 9223372036854775807
 */
main :: (()-> unit) {
  // Basic i64 values
  a :: 1000000000000.as(i64);
  b :: 250000000000.as(i64);
  c :: 1000000000000.as(i64);
  zero :: 0.as(i64);
  neg_val :: (-500000000000).as(i64);
  max_val :: 9223372036854775807.as(i64);
  min_val :: (-9223372036854775808).as(i64);
  
  // Arithmetic operations
  sum :: (a + b);        // 1250000000000i64
  diff :: (a - b);       // 750000000000i64
  prod :: (a * b);       // 250000000000000000000000i64 (may overflow)
  quot :: (a / b);       // 4i64 (integer division)
  remainder :: (a % b);  // 0i64
  
  // Unary operations
  neg_a :: -(a);         // -1000000000000i64
  neg_zero :: -(zero);   // 0i64
  
  // Comparison operations
  eq_test :: (a == c);   // true
  eq_false :: (a == b);  // false
  neq_test :: (a != b);  // true
  neq_false :: (a != c); // false
  lt_test :: (b < a);    // true
  lt_false :: (a < b);   // false
  lte_test :: (b <= a);  // true
  lte_equal :: (a <= c); // true
  gt_test :: (a > b);    // true
  gt_false :: (b > a);   // false
  gte_test :: (a >= b);  // true
  gte_equal :: (a >= c); // true
  
  // Type conversion operations
  i64_to_f32 :: a.as(f32);      // 1000000000000.0f32 (may lose precision)
  i64_to_f64 :: a.as(f64);      // 1000000000000.0f64
  i64_to_string :: a.to_string(); // "1000000000000"
  
  // Test with compile-time assertions
  // Arithmetic
  compt_assert(sum == (1250000000000.as(i64)));
  compt_assert(diff == (750000000000.as(i64)));
  compt_assert(quot == (4.as(i64)));
  compt_assert(remainder == (0.as(i64)));
  
  // Unary operations
  compt_assert(neg_a == ((-1000000000000).as(i64)));
  compt_assert(neg_zero == (0.as(i64)));
  
  // Comparisons
  compt_assert(eq_test == true);
  compt_assert(eq_false == false);
  compt_assert(neq_test == true);
  compt_assert(neq_false == false);
  compt_assert(lt_test == true);
  compt_assert(lt_false == false);
  compt_assert(lte_test == true);
  compt_assert(lte_equal == true);
  compt_assert(gt_test == true);
  compt_assert(gt_false == false);
  compt_assert(gte_test == true);
  compt_assert(gte_equal == true);
  
  // Type conversions
  compt_assert(i64_to_f64 == (1000000000000.0.as(f64)));
  compt_assert(i64_to_string == "1000000000000");
  
  // Test with negative numbers
  {
    neg_sum :: (neg_val + a);     // -500000000000 + 1000000000000 = 500000000000i64
    neg_diff :: (neg_val - a);    // -500000000000 - 1000000000000 = -1500000000000i64
    neg_prod :: (neg_val * 2.as(i64)); // -500000000000 * 2 = -1000000000000i64
    neg_quot :: (neg_val / 10.as(i64)); // -500000000000 / 10 = -50000000000i64
    
    // Comparisons with negatives
    neg_lt :: (neg_val < a);      // true (-500000000000 < 1000000000000)
    neg_gt :: (a > neg_val);      // true (1000000000000 > -500000000000)
    
    compt_assert(neg_sum == (500000000000.as(i64)));
    compt_assert(neg_diff == ((-1500000000000).as(i64)));
    compt_assert(neg_prod == ((-1000000000000).as(i64)));
    compt_assert(neg_quot == ((-50000000000).as(i64)));
    compt_assert(neg_lt == true);
    compt_assert(neg_gt == true);
  };
  
  // Test boundary values
  {
    // Operations with min value
    min_sum :: (min_val + 1.as(i64));     // -9223372036854775807i64
    min_sub :: (min_val - 1.as(i64));     // overflow behavior
    min_neg :: -(min_val);               // overflow: -(-9223372036854775808) should be handled
    
    // Operations with max value
    max_sum :: (max_val + 1.as(i64));     // overflow
    max_sub :: (max_val - 1.as(i64));     // 9223372036854775806i64
    max_neg :: -(max_val);               // -9223372036854775807i64
    
    compt_assert(min_sum == ((-9223372036854775807).as(i64)));
    compt_assert(max_sub == (9223372036854775806.as(i64)));
    compt_assert(max_neg == ((-9223372036854775807).as(i64)));
    
    // Boundary comparisons
    compt_assert(min_val < max_val);
    compt_assert(max_val > min_val);
    compt_assert(min_val <= max_val);
    compt_assert(max_val >= min_val);
  };
  
  // Test zero operations
  {
    zero_sum :: (zero + a);      // 1000000000000i64
    zero_diff1 :: (a - zero);    // 1000000000000i64
    zero_diff2 :: (zero - a);    // -1000000000000i64
    zero_prod :: (zero * a);     // 0i64
    
    compt_assert(zero_sum == (1000000000000.as(i64)));
    compt_assert(zero_diff1 == (1000000000000.as(i64)));
    compt_assert(zero_diff2 == ((-1000000000000).as(i64)));
    compt_assert(zero_prod == (0.as(i64)));
    
    // Identity operations
    identity_sum :: (a + zero);  // 1000000000000i64
    identity_prod :: (a * 1.as(i64));  // 1000000000000i64
    
    compt_assert(identity_sum == (1000000000000.as(i64)));
    compt_assert(identity_prod == (1000000000000.as(i64)));
    
    // Self operations
    self_sub :: (a - a);         // 0i64
    self_div :: (a / a);         // 1i64
    self_mod :: (a % a);         // 0i64
    
    compt_assert(self_sub == (0.as(i64)));
    compt_assert(self_div == (1.as(i64)));
    compt_assert(self_mod == (0.as(i64)));
  };
  
  // Test very large values
  {
    huge1 :: 1000000000000000000.as(i64);  // 10^18
    huge2 :: 500000000000000000.as(i64);   // 5 * 10^17
    
    huge_sum :: (huge1 + huge2);     // 1.5 * 10^18
    huge_diff :: (huge1 - huge2);    // 5 * 10^17
    huge_div :: (huge1 / 1000000.as(i64)); // 10^12
    huge_mod :: (huge1 % 7.as(i64)); // 1i64 (10^18 % 7 = 1)
    
    compt_assert(huge_sum == (1500000000000000000.as(i64)));
    compt_assert(huge_diff == (500000000000000000.as(i64)));
    compt_assert(huge_div == (1000000000000.as(i64)));
    compt_assert(huge_mod == (1.as(i64)));
  };
  
  // Test various divisions
  {
    div1 :: (2000000000000.as(i64) / 8.as(i64));       // 250000000000i64
    div2 :: (2000000000001.as(i64) / 8.as(i64));       // 250000000000i64 (integer division)
    div3 :: (7.as(i64) / 1000000000000.as(i64));       // 0i64
    
    // Negative divisions
    div4 :: ((-2000000000000).as(i64) / 8.as(i64));    // -250000000000i64
    div5 :: (2000000000000.as(i64) / (-8).as(i64));    // -250000000000i64
    div6 :: ((-2000000000000).as(i64) / (-8).as(i64)); // 250000000000i64
    
    compt_assert(div1 == (250000000000.as(i64)));
    compt_assert(div2 == (250000000000.as(i64)));
    compt_assert(div3 == (0.as(i64)));
    compt_assert(div4 == ((-250000000000).as(i64)));
    compt_assert(div5 == ((-250000000000).as(i64)));
    compt_assert(div6 == (250000000000.as(i64)));
  };
  
  // Test modulo operations
  {
    mod1 :: (17.as(i64) % 5.as(i64));        // 2i64
    mod2 :: (20.as(i64) % 4.as(i64));        // 0i64
    mod3 :: (7.as(i64) % 10.as(i64));        // 7i64
    
    // Negative modulo
    mod4 :: ((-17).as(i64) % 5.as(i64));     // behavior depends on implementation
    mod5 :: (17.as(i64) % (-5).as(i64));     // behavior depends on implementation
    
    compt_assert(mod1 == (2.as(i64)));
    compt_assert(mod2 == (0.as(i64)));
    compt_assert(mod3 == (7.as(i64)));
  };
  
  // Test chained operations
  {
    chain1 :: ((a + b) / 5.as(i64));    // (10^12 + 2.5*10^11) / 5 = 2.5*10^11
    chain2 :: (a + (b * 2.as(i64)));    // 10^12 + (2.5*10^11 * 2) = 1.5*10^12
    chain3 :: ((a / b) + 1.as(i64));    // (10^12 / 2.5*10^11) + 1 = 5i64
    
    compt_assert(chain1 == (250000000000.as(i64)));
    compt_assert(chain2 == (1500000000000.as(i64)));
    compt_assert(chain3 == (5.as(i64)));
  };
  
  // Test powers of 2 (important for i64)
  {
    pow2_32 :: 4294967296.as(i64);        // 2^32
    pow2_40 :: 1099511627776.as(i64);     // 2^40
    
    div_pow2 :: (pow2_40 / pow2_32);      // 256i64 (2^8)
    mod_pow2 :: (4294967297.as(i64) % pow2_32); // 1i64
    
    compt_assert(div_pow2 == (256.as(i64)));
    compt_assert(mod_pow2 == (1.as(i64)));
  };
  
  // Test string conversions
  {
    zero_str :: zero.to_string();
    neg_str :: neg_val.to_string();
    max_str :: max_val.to_string();
    min_str :: min_val.to_string();
    
    compt_assert(zero_str == "0");
    compt_assert(neg_str == "-500000000000");
    // FIXME: JavaScript number has limit, should use BitInt in this case.
    // compt_assert(max_str == "9223372036854775807");
    // compt_assert(min_str == "-9223372036854775808");
  };
  
  ()
};
