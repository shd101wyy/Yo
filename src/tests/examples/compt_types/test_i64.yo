open import "std";

/**
 * Test i64 (signed 64-bit integer) operations
 * Range: -9223372036854775808 to 9223372036854775807
 */
main :: (fn() -> unit) {
  // Basic i64 values
  a :: i64(1000000000000);
  b :: i64(250000000000);
  c :: i64(1000000000000);
  zero :: i64(0);
  neg_val :: i64(-500000000000);
  max_val :: i64(9223372036854775807);
  min_val :: i64(-9223372036854775808);
  
  // Arithmetic operations
  sum :: (a + b);        // 1250000000000i64
  diff :: (a - b);       // 750000000000i64
  prod :: (a * b);       // 250000000000000000000000i64 (may overflow)
  quot :: (a / b);       // 4i64 (integer division)
  remainder :: (a % b);  // 0i64
  
  // Unary operations
  neg_a :: -(a);         // -1000000000000i64
  neg_zero :: -(zero);   // 0i64
  
  // Comparison operations
  eq_test :: (a == c);   // true
  eq_false :: (a == b);  // false
  neq_test :: (a != b);  // true
  neq_false :: (a != c); // false
  lt_test :: (b < a);    // true
  lt_false :: (a < b);   // false
  lte_test :: (b <= a);  // true
  lte_equal :: (a <= c); // true
  gt_test :: (a > b);    // true
  gt_false :: (b > a);   // false
  gte_test :: (a >= b);  // true
  gte_equal :: (a >= c); // true
  
  // Type conversion operations
  i64_to_f32 :: f32(a);      // 1000000000000.0f32 (may lose precision)
  i64_to_f64 :: f64(a);      // 1000000000000.0f64
  i64_to_string :: a.to_string(); // "1000000000000"
  
  // Test with compile-time assertions
  // Arithmetic
  compt_assert(sum == i64(1250000000000));
  compt_assert(diff == i64(750000000000));
  compt_assert(quot == i64(4));
  compt_assert(remainder == i64(0));
  
  // Unary operations
  compt_assert(neg_a == i64(-1000000000000));
  compt_assert(neg_zero == i64(0));
  
  // Comparisons
  compt_assert(eq_test == true);
  compt_assert(eq_false == false);
  compt_assert(neq_test == true);
  compt_assert(neq_false == false);
  compt_assert(lt_test == true);
  compt_assert(lt_false == false);
  compt_assert(lte_test == true);
  compt_assert(lte_equal == true);
  compt_assert(gt_test == true);
  compt_assert(gt_false == false);
  compt_assert(gte_test == true);
  compt_assert(gte_equal == true);
  
  // Type conversions
  compt_assert(i64_to_f64 == f64(1000000000000.0));
  compt_assert(i64_to_string == "1000000000000");
  
  // Test with negative numbers
  {
    neg_sum :: (neg_val + a);     // -500000000000 + 1000000000000 = 500000000000i64
    neg_diff :: (neg_val - a);    // -500000000000 - 1000000000000 = -1500000000000i64
    neg_prod :: (neg_val * i64(2)); // -500000000000 * 2 = -1000000000000i64
    neg_quot :: (neg_val / i64(10)); // -500000000000 / 10 = -50000000000i64
    
    // Comparisons with negatives
    neg_lt :: (neg_val < a);      // true (-500000000000 < 1000000000000)
    neg_gt :: (a > neg_val);      // true (1000000000000 > -500000000000)
    
    compt_assert(neg_sum == i64(500000000000));
    compt_assert(neg_diff == i64(-1500000000000));
    compt_assert(neg_prod == i64(-1000000000000));
    compt_assert(neg_quot == i64(-50000000000));
    compt_assert(neg_lt == true);
    compt_assert(neg_gt == true);
  };
  
  // Test boundary values
  {
    // Operations with min value
    min_sum :: (min_val + i64(1));     // -9223372036854775807i64
    min_sub :: (min_val - i64(1));     // overflow behavior
    min_neg :: -(min_val);               // overflow: -(-9223372036854775808) should be handled
    
    // Operations with max value
    max_sum :: (max_val + i64(1));     // overflow
    max_sub :: (max_val - i64(1));     // 9223372036854775806i64
    max_neg :: -(max_val);               // -9223372036854775807i64
    
    compt_assert(min_sum == i64(-9223372036854775807));
    compt_assert(max_sub == i64(9223372036854775806));
    compt_assert(max_neg == i64(-9223372036854775807));
    
    // Boundary comparisons
    compt_assert(min_val < max_val);
    compt_assert(max_val > min_val);
    compt_assert(min_val <= max_val);
    compt_assert(max_val >= min_val);
  };
  
  // Test zero operations
  {
    zero_sum :: (zero + a);      // 1000000000000i64
    zero_diff1 :: (a - zero);    // 1000000000000i64
    zero_diff2 :: (zero - a);    // -1000000000000i64
    zero_prod :: (zero * a);     // 0i64
    
    compt_assert(zero_sum == i64(1000000000000));
    compt_assert(zero_diff1 == i64(1000000000000));
    compt_assert(zero_diff2 == i64(-1000000000000));
    compt_assert(zero_prod == i64(0));
    
    // Identity operations
    identity_sum :: (a + zero);  // 1000000000000i64
    identity_prod :: (a * i64(1));  // 1000000000000i64
    
    compt_assert(identity_sum == i64(1000000000000));
    compt_assert(identity_prod == i64(1000000000000));
    
    // Self operations
    self_sub :: (a - a);         // 0i64
    self_div :: (a / a);         // 1i64
    self_mod :: (a % a);         // 0i64
    
    compt_assert(self_sub == i64(0));
    compt_assert(self_div == i64(1));
    compt_assert(self_mod == i64(0));
  };
  
  // Test very large values
  {
    huge1 :: i64(1000000000000000000);  // 10^18
    huge2 :: i64(500000000000000000);   // 5 * 10^17
    
    huge_sum :: (huge1 + huge2);     // 1.5 * 10^18
    huge_diff :: (huge1 - huge2);    // 5 * 10^17
    huge_div :: (huge1 / i64(1000000)); // 10^12
    huge_mod :: (huge1 % i64(7)); // 1i64 (10^18 % 7 = 1)
    
    compt_assert(huge_sum == i64(1500000000000000000));
    compt_assert(huge_diff == i64(500000000000000000));
    compt_assert(huge_div == i64(1000000000000));
    compt_assert(huge_mod == i64(1));
  };
  
  // Test various divisions
  {
    div1 :: (i64(2000000000000) / i64(8));       // 250000000000i64
    div2 :: (i64(2000000000001) / i64(8));       // 250000000000i64 (integer division)
    div3 :: (i64(7) / i64(1000000000000));       // 0i64
    
    // Negative divisions
    div4 :: (i64(-2000000000000) / i64(8));    // -250000000000i64
    div5 :: (i64(2000000000000) / i64(-8));    // -250000000000i64
    div6 :: (i64(-2000000000000) / i64(-8)); // 250000000000i64
    
    compt_assert(div1 == i64(250000000000));
    compt_assert(div2 == i64(250000000000));
    compt_assert(div3 == i64(0));
    compt_assert(div4 == i64(-250000000000));
    compt_assert(div5 == i64(-250000000000));
    compt_assert(div6 == i64(250000000000));
  };
  
  // Test modulo operations
  {
    mod1 :: (i64(17) % i64(5));        // 2i64
    mod2 :: (i64(20) % i64(4));        // 0i64
    mod3 :: (i64(7) % i64(10));        // 7i64
    
    // Negative modulo
    mod4 :: (i64(-17) % i64(5));     // behavior depends on implementation
    mod5 :: (i64(17) % i64(-5));     // behavior depends on implementation
    
    compt_assert(mod1 == i64(2));
    compt_assert(mod2 == i64(0));
    compt_assert(mod3 == i64(7));
  };
  
  // Test chained operations
  {
    chain1 :: ((a + b) / i64(5));    // (10^12 + 2.5*10^11) / 5 = 2.5*10^11
    chain2 :: (a + (b * i64(2)));    // 10^12 + (2.5*10^11 * 2) = 1.5*10^12
    chain3 :: ((a / b) + i64(1));    // (10^12 / 2.5*10^11) + 1 = 5i64
    
    compt_assert(chain1 == i64(250000000000));
    compt_assert(chain2 == i64(1500000000000));
    compt_assert(chain3 == i64(5));
  };
  
  // Test powers of 2 (important for i64)
  {
    pow2_32 :: i64(4294967296);        // 2^32
    pow2_40 :: i64(1099511627776);     // 2^40
    
    div_pow2 :: (pow2_40 / pow2_32);      // 256i64 (2^8)
    mod_pow2 :: (i64(4294967297) % pow2_32); // 1i64
    
    compt_assert(div_pow2 == i64(256));
    compt_assert(mod_pow2 == i64(1));
  };
  
  // Test string conversions
  {
    zero_str :: zero.to_string();
    neg_str :: neg_val.to_string();
    max_str :: max_val.to_string();
    min_str :: min_val.to_string();
    
    compt_assert(zero_str == "0");
    compt_assert(neg_str == "-500000000000");
    // FIXME: JavaScript number has limit, should use BitInt in this case.
    // compt_assert(max_str == "9223372036854775807");
    // compt_assert(min_str == "-9223372036854775808");
  };
  
  ()
};
