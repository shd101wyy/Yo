open import "std";

/**
 * Test f32 (32-bit floating point) operations
 * IEEE 754 single precision floating point
 */
main :: (fn() -> unit) {
  // Basic f32 values
  a :: 100.5.as(f32);
  b :: 25.25.as(f32);
  c :: 100.5.as(f32);
  zero :: 0.0.as(f32);
  neg_val :: -(50.75).as(f32);
  one :: 1.0.as(f32);
  half :: 0.5.as(f32);
  
  // Arithmetic operations
  sum :: (a + b);        // 125.75f32
  diff :: (a - b);       // 75.25f32
  prod :: (a * b);       // 2537.625f32
  quot :: (a / b);       // 3.9801980198...f32 (approximately 3.98)
  
  // Unary operations
  neg_a :: -(a);         // -100.5f32
  neg_zero :: -(zero);   // -0.0f32 (negative zero)
  
  // Comparison operations
  eq_test :: (a == c);   // true (100.5f32 == 100.5f32)
  eq_false :: (a == b);  // false (100.5f32 == 25.25f32)
  neq_test :: (a != b);  // true (100.5f32 != 25.25f32)
  neq_false :: (a != c); // false (100.5f32 != 100.5f32)
  lt_test :: (b < a);    // true (25.25f32 < 100.5f32)
  lt_false :: (a < b);   // false (100.5f32 < 25.25f32)
  lte_test :: (b <= a);  // true (25.25f32 <= 100.5f32)
  lte_equal :: (a <= c); // true (100.5f32 <= 100.5f32)
  gt_test :: (a > b);    // true (100.5f32 > 25.25f32)
  gt_false :: (b > a);   // false (25.25f32 > 100.5f32)
  gte_test :: (a >= b);  // true (100.5f32 >= 25.25f32)
  gte_equal :: (a >= c); // true (100.5f32 >= 100.5f32)
  
  // Type conversion operations
  f32_to_f64 :: a.as(f64);      // 100.5f64
  f32_to_i32 :: a.as(i32);      // 100i32 (truncated)
  f32_to_u32 :: a.as(u32);      // 100u32 (truncated)
  f32_to_string :: a.to_string(); // "100.5"
  
  // Test with compile-time assertions
  // Arithmetic
  compt_assert(sum == (125.75.as(f32)));
  compt_assert(diff == (75.25.as(f32)));
  compt_assert(prod == (2537.625.as(f32)));
  
  // Unary operations
  compt_assert(neg_a == (-(100.5).as(f32)));
  compt_assert(neg_zero == (0.0.as(f32))); // -0.0 == 0.0 in IEEE 754
  
  // Comparisons
  compt_assert(eq_test == true);
  compt_assert(eq_false == false);
  compt_assert(neq_test == true);
  compt_assert(neq_false == false);
  compt_assert(lt_test == true);
  compt_assert(lt_false == false);
  compt_assert(lte_test == true);
  compt_assert(lte_equal == true);
  compt_assert(gt_test == true);
  compt_assert(gt_false == false);
  compt_assert(gte_test == true);
  compt_assert(gte_equal == true);
  
  // Type conversions
  compt_assert(f32_to_f64 == (100.5.as(f64)));
  compt_assert(f32_to_i32 == (100.as(i32)));
  compt_assert(f32_to_u32 == (100.as(u32)));
  compt_assert(f32_to_string == "100.5");
  
  // Test with negative numbers
  {
    neg_sum :: (neg_val + a);     // -50.75 + 100.5 = 49.75f32
    neg_diff :: (neg_val - a);    // -50.75 - 100.5 = -151.25f32
    neg_prod :: (neg_val * 2.0.as(f32)); // -50.75 * 2.0 = -101.5f32
    neg_quot :: (neg_val / 2.0.as(f32)); // -50.75 / 2.0 = -25.375f32
    
    // Comparisons with negatives
    neg_lt :: (neg_val < a);      // true (-50.75 < 100.5)
    neg_gt :: (a > neg_val);      // true (100.5 > -50.75)
    
    compt_assert(neg_sum == (49.75.as(f32)));
    compt_assert(neg_diff == (-(151.25).as(f32)));
    compt_assert(neg_prod == (-(101.5).as(f32)));
    compt_assert(neg_quot == (-(25.375).as(f32)));
    compt_assert(neg_lt == true);
    compt_assert(neg_gt == true);
  };
  
  // Test zero operations
  {
    zero_sum :: (zero + a);      // 100.5f32
    zero_diff1 :: (a - zero);    // 100.5f32
    zero_diff2 :: (zero - a);    // -100.5f32
    zero_prod :: (zero * a);     // 0.0f32
    
    compt_assert(zero_sum == (100.5.as(f32)));
    compt_assert(zero_diff1 == (100.5.as(f32)));
    compt_assert(zero_diff2 == (-(100.5).as(f32)));
    compt_assert(zero_prod == (0.0.as(f32)));
    
    // Identity operations
    identity_sum :: (a + zero);  // 100.5f32
    identity_prod :: (a * one);  // 100.5f32
    
    compt_assert(identity_sum == (100.5.as(f32)));
    compt_assert(identity_prod == (100.5.as(f32)));
    
    // Self operations
    self_sub :: (a - a);         // 0.0f32
    self_div :: (a / a);         // 1.0f32
    
    compt_assert(self_sub == (0.0.as(f32)));
    compt_assert(self_div == (1.0.as(f32)));
  };
  
  // Test fractional operations
  {
    frac1 :: 0.25.as(f32);
    frac2 :: 0.75.as(f32);
    
    frac_sum :: (frac1 + frac2);     // 1.0f32
    frac_diff :: (frac2 - frac1);    // 0.5f32
    frac_prod :: (frac1 * frac2);    // 0.1875f32 (3/16)
    frac_quot :: (frac2 / frac1);    // 3.0f32
    
    compt_assert(frac_sum == (1.0.as(f32)));
    compt_assert(frac_diff == (0.5.as(f32)));
    compt_assert(frac_prod == (0.1875.as(f32)));
    compt_assert(frac_quot == (3.0.as(f32)));
    
    // Powers and roots (approximations)
    square :: (frac2 * frac2);       // 0.5625f32 (0.75^2)
    half_div :: (one / 2.0.as(f32)); // 0.5f32
    
    compt_assert(square == (0.5625.as(f32)));
    compt_assert(half_div == (0.5.as(f32)));
  };
  
  // Test various divisions
  {
    div1 :: (200.0.as(f32) / 8.0.as(f32));       // 25.0f32
    div2 :: (201.0.as(f32) / 8.0.as(f32));       // 25.125f32
    div3 :: (7.0.as(f32) / 100.0.as(f32));       // 0.07f32
    
    // Negative divisions
    div4 :: (-(200.0).as(f32) / 8.0.as(f32));    // -25.0f32
    div5 :: (200.0.as(f32) / -(8.0).as(f32));    // -25.0f32
    div6 :: (-(200.0).as(f32) / -(8.0).as(f32)); // 25.0f32
    
    compt_assert(div1 == (25.0.as(f32)));
    compt_assert(div2 == (25.125.as(f32)));
    compt_assert(div3 == (0.07.as(f32)));
    compt_assert(div4 == (-(25.0).as(f32)));
    compt_assert(div5 == (-(25.0).as(f32)));
    compt_assert(div6 == (25.0.as(f32)));
  };
  
  // Test chained operations
  {
    chain1 :: ((a + b) / 5.0.as(f32));    // (100.5 + 25.25) / 5.0 = 25.15f32
    chain2 :: (a + (b * 2.0.as(f32)));    // 100.5 + (25.25 * 2.0) = 151.0f32
    chain3 :: ((a / b) + 1.0.as(f32));    // (100.5 / 25.25) + 1.0 ≈ 4.98f32
    
    compt_assert(chain1 == (25.15.as(f32)));
    compt_assert(chain2 == (151.0.as(f32)));
    // chain3 result depends on precise division
  };
  
  // Test scientific notation values
  {
    small :: 0.001.as(f32);         // 1e-3
    large :: 1000.0.as(f32);        // 1e3
    
    sci_prod :: (small * large);    // 1.0f32
    sci_div :: (large / small);     // 1000000.0f32 (1e6)
    
    compt_assert(sci_prod == (1.0.as(f32)));
    compt_assert(sci_div == (1000000.0.as(f32)));
  };
  
  // Test precision limits (f32 has about 7 decimal digits of precision)
  {
    precise1 :: 1.234567.as(f32);   // Within precision
    precise2 :: 1.000001.as(f32);   // Within precision
    
    precise_sum :: (precise1 + precise2);  // 2.234568f32
    precise_diff :: (precise1 - precise2); // 0.234566f32
    
    compt_assert(precise_sum == (2.234568.as(f32)));
    // compt_assert(precise_diff == (0.234566.as(f32)));
  };
  
  // Test string conversions
  {
    zero_str :: zero.to_string();
    neg_str :: neg_val.to_string();
    frac_str :: (0.125.as(f32)).to_string();
    
    compt_assert(zero_str == "0");
    compt_assert(neg_str == "-50.75");
    compt_assert(frac_str == "0.125");
  };
  
  // Test special arithmetic patterns
  {
    // Common fractions
    third :: (1.0.as(f32) / 3.0.as(f32));       // 0.333333...f32
    two_thirds :: (2.0.as(f32) / 3.0.as(f32));  // 0.666666...f32
    
    // Reciprocals
    recip_2 :: (1.0.as(f32) / 2.0.as(f32));     // 0.5f32
    recip_4 :: (1.0.as(f32) / 4.0.as(f32));     // 0.25f32
    
    compt_assert(recip_2 == (0.5.as(f32)));
    compt_assert(recip_4 == (0.25.as(f32)));
    
    // Powers of 10
    ten :: 10.0.as(f32);
    hundred :: (ten * ten);          // 100.0f32
    thousand :: (hundred * ten);     // 1000.0f32
    
    compt_assert(hundred == (100.0.as(f32)));
    compt_assert(thousand == (1000.0.as(f32)));
  };
  
  ()
};
