open import "std";

/**
 * Test u16 (unsigned 16-bit integer) operations
 * Range: 0 to 65535
 */
main :: (fn() -> unit) {
  // Basic u16 values
  a :: u16(1000);
  b :: u16(250);
  c :: u16(1000);
  zero :: u16(0);
  max_val :: u16(65535);
  
  // Arithmetic operations
  sum :: (a + b);        // 1250u16
  diff :: (a - b);       // 750u16
  prod :: (a * b);       // 250000u16 (may overflow and wrap)
  quot :: (a / b);       // 4u16 (integer division)
  remainder :: (a % b);  // 0u16 (1000 % 250 = 0)
  
  // Comparison operations
  eq_test :: (a == c);   // true (1000u16 == 1000u16)
  eq_false :: (a == b);  // false (1000u16 == 250u16)
  neq_test :: (a != b);  // true (1000u16 != 250u16)
  neq_false :: (a != c); // false (1000u16 != 1000u16)
  lt_test :: (b < a);    // true (250u16 < 1000u16)
  lt_false :: (a < b);   // false (1000u16 < 250u16)
  lte_test :: (b <= a);  // true (250u16 <= 1000u16)
  lte_equal :: (a <= c); // true (1000u16 <= 1000u16)
  gt_test :: (a > b);    // true (1000u16 > 250u16)
  gt_false :: (b > a);   // false (250u16 > 1000u16)
  gte_test :: (a >= b);  // true (1000u16 >= 250u16)
  gte_equal :: (a >= c); // true (1000u16 >= 1000u16)
  
  // Type conversion operations
  u16_to_u32 :: u32(a);      // 1000u32
  u16_to_i32 :: i32(a);      // 1000i32
  u16_to_f32 :: f32(a);      // 1000.0f32
  u16_to_string :: a.to_string(); // "1000"
  
  // Test with compile-time assertions
  // Arithmetic
  compt_assert(sum == u16(1250));
  compt_assert(diff == u16(750));
  compt_assert(quot == u16(4));
  compt_assert(remainder == u16(0));
  
  // Comparisons
  compt_assert(eq_test == true);
  compt_assert(eq_false == false);
  compt_assert(neq_test == true);
  compt_assert(neq_false == false);
  compt_assert(lt_test == true);
  compt_assert(lt_false == false);
  compt_assert(lte_test == true);
  compt_assert(lte_equal == true);
  compt_assert(gt_test == true);
  compt_assert(gt_false == false);
  compt_assert(gte_test == true);
  compt_assert(gte_equal == true);
  
  // Type conversions
  compt_assert(u16_to_u32 == u32(1000));
  compt_assert(u16_to_i32 == i32(1000));
  compt_assert(u16_to_f32 == (f32(1000.0)));
  compt_assert(u16_to_string == "1000");
  
  // Test boundary values
  {
    min_val :: u16(0);
    
    // Operations with min value
    min_sum :: (min_val + u16(1));     // 1u16
    min_sub :: (min_val - u16(1));     // 65535u16 (underflow wraps)
    min_mult :: (min_val * u16(500));  // 0u16
    
    // Operations with max value
    max_sum :: (max_val + u16(1));     // 0u16 (overflow wraps)
    max_sub :: (max_val - u16(1));     // 65534u16
    max_div :: (max_val / u16(13));    // 5041u16
    max_mod :: (max_val % u16(100));   // 35u16 (65535 % 100 = 35)
    
    compt_assert(min_sum == u16(1));
    compt_assert(min_mult == u16(0));
    compt_assert(max_sub == u16(65534));
    compt_assert(max_div == u16(5041));
    compt_assert(max_mod == u16(35));
    
    // Boundary comparisons
    compt_assert(min_val < max_val);
    compt_assert(max_val > min_val);
    compt_assert(min_val <= max_val);
    compt_assert(max_val >= min_val);
  };
  
  // Test zero operations
  {
    zero_sum :: (zero + a);      // 1000u16
    zero_diff1 :: (a - zero);    // 1000u16
    zero_diff2 :: (zero - a);    // underflow behavior
    zero_prod :: (zero * a);     // 0u16
    
    compt_assert(zero_sum == u16(1000));
    compt_assert(zero_diff1 == u16(1000));
    compt_assert(zero_prod == u16(0));
    
    // Identity operations
    identity_sum :: (a + zero);  // 1000u16
    identity_prod :: (a * u16(1));  // 1000u16
    
    compt_assert(identity_sum == u16(1000));
    compt_assert(identity_prod == u16(1000));
    
    // Self operations
    self_sub :: (a - a);         // 0u16
    self_div :: (a / a);         // 1u16
    self_mod :: (a % a);         // 0u16
    
    compt_assert(self_sub == u16(0));
    compt_assert(self_div == u16(1));
    compt_assert(self_mod == u16(0));
  };
  
  // Test large values
  {
    large1 :: u16(50000);
    large2 :: u16(15000);
    
    large_sum :: (large1 + large2);     // 65000u16
    large_diff :: (large1 - large2);    // 35000u16
    large_div :: (large1 / u16(10)); // 5000u16
    large_mod :: (large1 % u16(7));  // 1u16 (50000 % 7 = 6)
    
    compt_assert(large_sum == u16(65000));
    compt_assert(large_diff == u16(35000));
    compt_assert(large_div == u16(5000));
    compt_assert(large_mod == u16(6));
  };
  
  // Test various divisions
  {
    div1 :: (u16(2000) / u16(8));       // 250u16
    div2 :: (u16(2001) / u16(8));       // 250u16 (integer division)
    div3 :: (u16(7) / u16(100));        // 0u16
    
    compt_assert(div1 == u16(250));
    compt_assert(div2 == u16(250));
    compt_assert(div3 == u16(0));
  };
  
  // Test modulo operations
  {
    mod1 :: (u16(17) % u16(5));        // 2u16
    mod2 :: (u16(20) % u16(4));        // 0u16
    mod3 :: (u16(7) % u16(10));        // 7u16
    mod4 :: (u16(65535) % u16(256));   // 255u16
    
    compt_assert(mod1 == u16(2));
    compt_assert(mod2 == u16(0));
    compt_assert(mod3 == u16(7));
    compt_assert(mod4 == u16(255));
  };
  
  // Test chained operations
  {
    chain1 :: ((a + b) * u16(2));   // (1000u16 + 250u16) * 2u16 = 2500u16
    chain2 :: (a + (b * u16(2)));   // 1000u16 + (250u16 * 2u16) = 1500u16
    chain3 :: ((a / b) + u16(1));   // (1000u16 / 250u16) + 1u16 = 5u16
    
    compt_assert(chain1 == u16(2500));
    compt_assert(chain2 == u16(1500));
    compt_assert(chain3 == u16(5));
  };
  
  // Test string conversions
  {
    zero_str :: zero.to_string();
    max_str :: max_val.to_string();
    large_str :: u16(12345).to_string();
    
    compt_assert(zero_str == "0");
    compt_assert(max_str == "65535");
    compt_assert(large_str == "12345");
  };
  
  ()
};
