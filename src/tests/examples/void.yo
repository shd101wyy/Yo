open import "std";

compt_expect_error(
  Void :: void // Cannot use DST directly
);

compt_expect_error(
  FuncType :: 
    () -> void // Cannot use DST directly
);

use_void_ptr :: ((ptr : *(void)) -> unit) {
  compt_expect_error(
    x := ptr.*,
    "Cannot use DST directly"
  );

  // Dereference a void pointer is prohibited.
  // We need to cast it to a specific type first.
  i32_ptr := ptr.cast(*(i32));
};

mutate_void_ptr :: ((ptr : *!(void)) -> unit) {
  compt_expect_error(
    x := ptr.*,
    "Cannot use DST directly"
  );
  
  i32_ptr := ptr.cast(*!(i32));
  i32_ptr.* = 16;
};


main :: (() -> unit) {
  mut(x) := 12;

  use_void_ptr(*(x));
  mutate_void_ptr(*!(x));
};