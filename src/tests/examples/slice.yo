/**
 *
 * Slice type
 *
 * - .length to get the length of an array or slice
 * - (start:end) to create a slice
 *
 */
open import "std";

main :: (fn() -> unit) {
  arr := [1, 2, 3, 4];
  arr_length :: arr.length;
  slice := &(arr(1:3));
  slice_mut := &(arr(1:3));
  full_slice := &(arr(:));

  { 
    slice := &(arr(1:3));
    {
      slice_length := slice.length;
      x := slice(0);

      slice_of_slice := &(slice(0:2));
    };
  };
  {
    slice := &(arr(1:3));
    {
      slice_length := slice.length;

      x := slice(0);
      slice(0) = 13;

      slice_of_slice := &(slice(0:2));
    }
  }
};