open import "std";

(compt(LinearI32) : Type) = i32;

Shape :: enum
  Circle(radius: i32),
  Rectangle(width: i32, height: i32),
  Triangle(base: i32, height: i32),
  LinearShape(width: LinearI32, height: LinearI32)
;


test_ptr :: (fn(ptr: *(Shape)) -> unit) {
  match ptr,
    .Circle(radius) => {
        ();
      },
    .Rectangle(width, height) => {
        width := &(width);
        height := &(height);
    },
    .Triangle(base, height) => {
        ();
      },
    .LinearShape(width, height) => {
        width := &(width);
        height := &(height);
      }
  ;
};

test_ref :: (fn(ptr: *(Shape)) -> unit) {
  match ptr,
    .Circle(radius) => {
        ();
      },
    .Rectangle(width, height) => {
        width := &(width);
        height := &(height);
    },
    .Triangle(base, height) => {
        ();
      },
    .LinearShape(width, height) => {
        width := &(width);
        height := &(height);
      }
  ;
};