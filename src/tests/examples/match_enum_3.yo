(@(LinearI32) : Linear) = i32;

Shape :: enum
  Circle(radius: i32),
  Rectangle(width: i32, height: i32),
  Triangle(base: i32, height: i32),
  LinearShape(width: LinearI32, height: LinearI32)
;


test_ptr :: ((ptr: *(Shape)) -> unit) {
  match ptr,
    .Circle => {
        radius := ptr.radius;
        ();
      },
    .Rectangle => {
        width := *(ptr.width);
        height := *(ptr.height);
    },
    .Triangle => {
        ();
      },
    .LinearShape => {
        width := *(ptr.width);
        height := *(ptr.height);
      }
  ;
};

test_ref :: ((ref: &(Shape)) -> unit) {
  match ref,
    .Circle => {
        radius := ref.radius;
        ();
      },
    .Rectangle => {
        width := *(ref.width);
        height := *(ref.height);

        // FIXME: Handle borrow checker
    },
    .Triangle => {
        ();
      },
    .LinearShape => {
        width := *(ref.width);
        height := *(ref.height);
      }
  ;
};