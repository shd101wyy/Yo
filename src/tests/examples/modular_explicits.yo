Box :: ((@(B): Type)-> @(Type))
  struct(value: B)
;

Point :: ((@(P): Type)-> @(Type))
  struct
    x: P,
    y: P
;

Id ::
  ((@(Self): Type)-> @(Type))
  module
    (@(Self): Type) = Self,
    id:
      (Self)-> Self
;

id ::
  ((forall(@(T): Type), @(I): Id(T), x: T)-> T)
  I.id(x)
;

IdInt ::
  Id(i32)
    id:
      fn(x)-> x
;

IdBoolean ::
  Id(boolean)
    id:
      fn(x)-> x
;

IdBox ::
  (( forall(@(X): Type),
      @(I): Id(X)
      )-> @(Id(Box(X)))) {
  flag :: are_types_compatible(Box(X), Box(X));
  Id(Box(X))
    id:
      fn(p) -> {
        { value } := p;
        Box(X)(value)
        // Box(X)(I.id(value))
      }
  }
  ;

IdPoint ::
  (( forall(@(X): Type),
    @(I): Id(X)
  )-> @(Id(Point(X))))
  Id(Point(X))
    id:
      fn(p) -> {
        { x, y } := p;
        Point(X)(I.id(x), I.id(y))
      }
  ;

id(IdInt, 13);
id(IdBoolean, true);

box :: Box(i32)(1);
idBox :: IdBox(IdInt);
id(idBox, box);
id(IdBox(IdInt), box);


point :: Point(i32)(1, 2);
idPoint :: IdPoint(IdInt);
id(idPoint, point);
id(IdPoint(IdInt), point);
