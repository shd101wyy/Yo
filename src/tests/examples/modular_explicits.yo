def Point:
  (@(T): Type)-> @(Type),
  struct
    x: T,
    y: T
;

def Id:
  (@(This): Type)-> @(Type),
  module
    (This: Type) == This,
    id:
      (This)-> This
;

def id:
  (forall(@(T): Type), x: T, @(I): Id(T))-> T,
  I.id(x)
;

IdInt ::
  Id(i32)
    id:
      fn(x)-> x
;

IdBoolean ::
  Id(boolean)
    id:
      fn(x)-> x
;

def IdPoint :
  ( forall(@(X): Type),
    @(I): Id(X)
  )-> @(Id(Point(X))),
  Id(Point(X))
    id:
      fn(p) ->
        Point(X)(I.id(p.x), I.id(p.y))
  ;

id(13, IdInt);
id(true, IdBoolean);
point :: Point(i32)(1, 2);
idPoint :: IdPoint(IdInt);
id(point, idPoint);
id(point, IdPoint(IdInt));
