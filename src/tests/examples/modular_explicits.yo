Box :: ((@(B): Type)-> @(Type))
  struct(value: B)
;

Point :: ((@(T): Type)-> @(Type))
  struct
    x: T,
    y: T
;

Id ::
  ((@(Self_): Type)-> @(Type))
  struct
    (@(Self): Type) = Self_,
    id:
      (Self)-> Self
;

id ::
  ((forall(@(T): Type), @(I): Id(T), x: T)-> T)
  I.id(x)
;

IdInt ::
  Id(i32)
    id:
      fn(x)-> x
;

IdBoolean ::
  Id(boolean)
    id:
      fn(x)-> x
;

IdBox ::
  (( forall(@(X): Type),
      @(I): Id(X)
      )-> @(Id(Box(X)))) {
  flag :: are_types_compatible(Box(X), Box(X));
  Id(Box(X))
    id:
      fn(p) ->
        Box(X)(I.id(p.value))
  }
  ;

IdPoint ::
  (( forall(@(X): Type),
    @(I): Id(X)
  )-> @(Id(Point(X))))
  Id(Point(X))
    id:
      fn(p) ->
        Point(X)(I.id(p.x), I.id(p.y))
  ;

id(IdInt, 13);
id(IdBoolean, true);

box :: Box(i32)(1);
idBox :: IdBox(IdInt);
id(idBox, box);
id(IdBox(IdInt), box);


point :: Point(i32)(1, 2);
idPoint :: IdPoint(IdInt);
id(idPoint, point);
id(IdPoint(IdInt), point);
