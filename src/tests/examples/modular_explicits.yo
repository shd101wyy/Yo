Box :: ((compt(B): Type)-> compt(Type))
  struct(value: B)
;

Point :: ((compt(P): Type)-> compt(Type))
  struct
    x: P,
    y: P
;

Id ::
  ((compt(Self): Type)-> compt(Module))
  module
    (Self: Type) = Self,
    id:
      (self: Self)-> Self
;

id ::
  ((forall(compt(T): Type), compt(I): Id(T), x: T)-> T)
  I.id(x)
;

IdInt ::
  Id(i32)
    id:
      fn(x)-> x
;

IdBoolean ::
  Id(boolean)
    id:
      fn(x)-> x
;

IdBox ::
  (( forall(compt(X): Type),
      compt(I): Id(X)
      )-> compt(Id(Box(X)))) {
  flag :: __yo_are_types_compatible(Box(X), Box(X));
  Id(Box(X))
    id:
      fn(p) -> {
        { value } := p;
        Box(X)(value)
        // Box(X)(I.id(value))
      }
  }
  ;

IdPoint ::
  (( forall(compt(X): Type),
    compt(I): Id(X)
  )-> compt(Id(Point(X))))
  Id(Point(X))
    id:
      fn(p) -> {
        { x, y } := p;
        Point(X)(I.id(x), I.id(y))
      }
  ;

id(IdInt, 13);
id(IdBoolean, true);

box :: Box(i32)(1);
idBox :: IdBox(IdInt);
id(idBox, box);
id(IdBox(IdInt), box);


point :: Point(i32)(1, 2);
idPoint :: IdPoint(IdInt);
id(idPoint, point);
id(IdPoint(IdInt), point);
