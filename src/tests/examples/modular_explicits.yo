def Box:
  (@(B): Type)-> @(Type),
  struct(value: B)
;

def Point:
  (@(T): Type)-> @(Type),
  struct
    x: T,
    y: T
;

def Id:
  (@(This): Type)-> @(Type),
  module
    (This: Type) == This,
    id:
      (This)-> This
;

def id:
  (forall(@(T): Type), x: T, @(I): Id(T))-> T,
  I.id(x)
;

IdInt ::
  Id(i32)
    id:
      fn(x)-> x
;

IdBoolean ::
  Id(boolean)
    id:
      fn(x)-> x
;

def IdBox :
  ( forall(@(X): Type),
    @(I): Id(X)
  )-> @(Id(Box(X))), {
  flag :: are_types_compatible(Box(X), Box(X));
  Id(Box(X))
    id:
      fn(p) ->
        Box(X)(I.id(p.value))
  }
  ;

def IdPoint :
  ( forall(@(X): Type),
    @(I): Id(X)
  )-> @(Id(Point(X))),
  Id(Point(X))
    id:
      fn(p) ->
        Point(X)(I.id(p.x), I.id(p.y))
  ;

id(13, IdInt);
id(true, IdBoolean);

box :: Box(i32)(1);
idBox :: IdBox(IdInt);
id(box, idBox);
id(box, IdBox(IdInt));


point :: Point(i32)(1, 2);
idPoint :: IdPoint(IdInt);
id(point, idPoint);
id(point, IdPoint(IdInt));
