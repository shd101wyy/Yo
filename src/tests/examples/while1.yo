

(compt(LinearI32) : Type) = i32; 

(linear_i32_1 : LinearI32) = 12;

// while loop
// Like scala, we don't support "break" or "continue" in while loop.
sum :: (fn(max : i32) -> i32) {
  result := 0;
  i := 0;

  // compt_expect_error(
  //   drop(linear_i32_1),
  //   "Cannot drop a linear value defined outside the function body"
  // );

  (linear_i32_2 : LinearI32) = 12;

  compt_expect_error(
  while i `lt` max, {
    result = (result `add` i);
    i = (i `add` 1);
    drop(linear_i32_2);
  }, "Should allow to drop linear_i32_2 only once"
  );

  return result;
};

// consume(linear_i32_1);
