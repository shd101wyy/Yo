// open import "std";
extern
  lt : 
    (x : i32, y : i32) -> boolean,
  add :
    (x : i32, y : i32) -> i32
;

(compt(LinearI32) : Linear) = i32; 

(linear_i32_1 : LinearI32) = 12;

// while loop
// Like scala, we don't support "break" or "continue" in while loop.
sum :: ((max : i32) -> i32) {
  mut(result) := 0;
  mut(i) := 0;

  compt_expect_error(
    drop(linear_i32_1),
    "Cannot drop a linear value defined outside the function body"
  );

  (linear_i32_2 : LinearI32) = 12;

  compt_expect_error(
  while i `lt` max, {
    result = (result `add` i);
    i = (i `add` 1);
    drop(linear_i32_2);
  }, "Should allow to drop linear_i32_2 only once"
  );

  return result;
};
