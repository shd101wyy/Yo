// Test struct/array combinations
ArrayContainer :: struct
  values : [i32; 3],
  ptr_values : *!([i32; 3])
;

test_struct_array_combinations :: (fn() -> unit) {
  mut(arr) := [1, 2, 3];
  mut(container) := ArrayContainer([10, 20, 30], &!(arr));
  
  // Direct array field access
  container.values(0) = 99; // Should work - mutable binding
  
  // Indirect array access through pointer
  container.ptr_values.*(1) = 88; // Should work - mutable pointer
  
  // Test with immutable binding
  immut_container := container;
  tmp1 := immut_container.values(0); // Can read
  compt_expect_error(
    immut_container.values(0) = 77 // Cannot write - immutable binding
  );
  
  tmp2 := immut_container.ptr_values.*(1); // Can read
  immut_container.ptr_values.*(1) = 66; // Should work - dereferencing mutable pointer
};

// Test function pointer mutability (if supported)
FunctionContainer :: struct
  callback : (fn() -> unit)
;

test_function_pointers :: (fn() -> unit) {
  do_nothing :: (fn() -> unit) ();
  
  mut(func_container) := FunctionContainer(do_nothing);
  
  // Function field reassignment
  func_container.callback = do_nothing; // Should work - mutable binding
  
  immut_func_container := func_container;
  compt_expect_error(
    immut_func_container.callback = do_nothing // Should fail - immutable binding
  );
};

// Test borrowing through multiple indirections
MultiIndirect :: struct
  ptr_to_ptr : *!(*!(i32))
;

test_multiple_indirections :: (fn() -> unit) {
  mut(x) := 42;
  mut(ptr) := &!(x);
  
  mut(multi) := MultiIndirect(&!(ptr));
  
  // Triple indirection: multi.ptr_to_ptr -> ptr -> x
  tmp := multi.ptr_to_ptr.*.*;
  multi.ptr_to_ptr.*.* = 100; // Should work - all mutable
  
  // Test with immutable binding
  immut_multi := multi;
  tmp2 := immut_multi.ptr_to_ptr.*.*; // Can read
  immut_multi.ptr_to_ptr.*.* = 200; // Should work - dereferencing mutable pointers
  
  compt_expect_error(
    immut_multi.ptr_to_ptr = *!(ptr) // Should fail - field reassignment with immutable binding
  );
};

// Test const/literal values and their mutability
test_literal_mutability :: (fn() -> unit) {
  // Pointer to literal - should be immutable by nature
  lit_ptr := &(42); // Pointer to literal value
  tmp := lit_ptr.*; // Can read
  compt_expect_error(
    lit_ptr.* = 50 // Should fail - cannot modify literal
  );
};

// Test temporary value mutability
TempContainer :: struct
  val : i32
;

create_temp :: (fn() -> TempContainer)
  TempContainer(42)
;

test_temporary_values :: (fn() -> unit) {
  // Access field of temporary value
  tmp1 := create_temp().val; // Should work - reading from temporary
  
  // modify temporary
  create_temp().val = 100; // ~~Should fail - cannot modify temporary~~
};

main_extended :: (fn() -> unit) {
  // Run original tests - these work correctly
  mut(x) := 1;
  mut(y) := 2;

  swap1(&!(x), &!(y));
  swap2(Container(&!(x), 42), &!(y));
  swap3(&!(Container(&!(x), 42)), &!(y));
  swap4(&(Container(&!(x), 42)), &!(y));
  
  // Run basic working tests
  test_field_reassignment_vs_deref_basic();
  
  // Run all tests now that originType is fixed
  test_function_returns();
  test_chained_access();
  test_array_access();
  test_ptr_vs_ref();
  test_parameter_binding_distinction();
  test_complex_nested_mutability();
  
  // Run additional edge case tests
  // test_recursive_structures();
  test_struct_array_combinations();
  test_function_pointers();
  test_multiple_indirections();
  test_literal_mutability();
  test_temporary_values();
};