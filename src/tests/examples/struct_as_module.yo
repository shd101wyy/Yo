Clone :: (fn(compt(Self): Type) -> compt(Module))
  module
    Self := Self,
    clone :
      fn(self: *(Self)) -> Self
;

Point :: struct
  x : i32,
  y : i32,

  // Type method to implement Clone
  clone :: (fn(self: *(Self)) -> Self)
    Self(x: self.x, y: self.y)
;
SelfType :: Point.Self;

CloneI32 :: Clone(i32);
(compt(I32Clone) : Clone(i32)) = impl {
  Self :: i32;

  clone :: (fn(self: *(Self)) -> Self)
    self.*
  ;

  copy :: (fn(self: *(Self)) -> Self)
    self.*
  ;

  export Self, clone;
};

ClonePoint :: Clone(Point);
(compt(PointClone) : Clone(Point)) = Point; // This should work, Point implements Clone(Point) because it has a clone method, and its "Self" type also matches.
PointClone.clone(&(Point(x: 1, 2))); // This should work, we can clone a Point using the module method.
Point.clone(&(Point(1, 2))); // This should also work, we can clone a Point using the type method.


some_func :: (fn( forall(_Self : Type ), 
                self : *(_Self),
                using(CloneMethod) : Clone(_Self)
              ) -> unit)
  CloneMethod.clone(self)
;

point := Point(3, 4);
some_func(&(point), Point); // This should work. We can say Point also implements Clone(Point) because it has a clone method.
// some_func(&(point), _);
// some_func(&(point));