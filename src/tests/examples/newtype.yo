open import "std/libc/stdio.yo";

MyBox :: object
  (*) : u32,

  dispose :: (fn(self : Self) -> unit) {
    printf("Disposing MyBox with value: %u\n", self.*);
  }
;

add :: (fn(x : u32, y : u32) -> u32) {
  return x + y;
};

rune :: newtype(
  c : MyBox,

  print_self :: (fn(self : Self) -> unit) {
    printf("rune: %u\n", self.c.(*));
  }
);

main :: (fn() -> unit) {
  x := rune(MyBox(add(40, 2)));
  x.print_self();
};

export main;