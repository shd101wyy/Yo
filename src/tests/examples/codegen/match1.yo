extern
  add :
    fn(x : i32, y : i32) -> i32,
  mul :
    fn(x : i32, y : i32) -> i32,
  div :
    fn(x : i32, y : i32) -> i32
;

Shape :: enum
  Circle(radius : i32),
  Rectangle(width : i32, height : i32),
  Triangle(base : i32, height : i32)
;

area :: (fn(shape: Shape) -> i32)
  match shape,
    .Circle(radius) => mul(3, mul(radius, radius)),
    .Rectangle(width, height) => mul(width, height),
    .Triangle(base, height) => div(mul(base, height), 2)
;

main :: (fn() -> i32) {
  area1 := area(Shape.Circle(radius: 5));
  area2 := area(Shape.Rectangle(width: 10, height: 20));
  area3 := area(Shape.Triangle(base: 10, height: 5));
  totalArea := add(add(area1, area2), area3);
  totalArea
};

export
  main
;