extern
  add :
    fn(x : i32, y : i32) -> i32
;

main :: (fn() -> i32) {
  // Create binding first, then assign value
  arr1 : Array(i32, 3);
  arr1 = [1, 2, 3];

  // Create binding and assign value in one line
  mut(arr2) := [1, 2, 3];
  arr2(0) = 12;

  // Copy array
  arr3 := arr1;

  add(arr1(0), add(arr2(0), arr3(0)))
};

export
  main
;