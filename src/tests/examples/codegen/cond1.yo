extern
  add :
    (x : i32, y : i32) -> i32,
  gt  :
    (x : i32, y : i32) -> boolean
;

max :: ((x : i32, y : i32) -> i32)
  cond
    gt(x, y) => {
      a := 12;
      x
    },
    true => {
      b := 13;
      y
    }
;

main :: (() -> i32) {
  x := 5;
  y := 10;
  z := max(x, y);
  z
};

export main;
