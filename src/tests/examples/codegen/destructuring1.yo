
destructure_tuple :: (fn() -> unit) {
  t := (1, 3.4, true);
  (t2 : Tuple(a: i32, b: f64, c: boolean)) = t;  
  
  {
    (x, y, z) := t;
  };
  {
    (c, b, a) := t2;
  };
  {
    (c : c, b : b, a : a) := t2;
  };
};

destructure_struct :: (fn() -> unit) {
  Point :: struct(x : i32, y : f64);
  point := Point(3, 4.0);
  {
    { x, y } := point;
  };
  {
    { y, x } := point;
  };
  {
    { x : another_x , ... } := point;
    a := another_x;
    b := y;
  };
  {
    _( x : a, y : b) := point;
    w := a;
    v := b;
  };
};


export
  destructure_tuple,
  destructure_struct
;