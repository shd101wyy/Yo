extern "Yo",  
  __yo_op_add : 
    fn(forall(T: Free), x : T, y : T) -> T
;

Add :: (fn(compt(Lhs): Type, compt(Rhs) ?= Lhs, compt(Output) ?= Lhs)-> compt(Module))
  module
    Self   := Lhs,
    (+)    : (fn(lhs: Lhs, rhs: Rhs)-> Output)
;

given(I32Add) :: Add(i32, i32)
  (+): ((a, b) -> __yo_op_add(a, b))
;


main :: (fn() -> i32) {
  x := 1;
  y := 2;
  z := (x + y);
  z
};

export main;