extern
  add :
    fn(x : i32, y : i32) -> i32
;

Color :: enum
  Red,
  Green,
  Blue,
  Mix(red : i32, green : i32, blue : i32)
;

judge :: (fn(color : Color) -> i32)
  match color,
    .Red => 1,
    .Green => 2,
    .Blue => 3,
    .Mix(r, g, b) => add(r, add(g, b))
;

main :: (fn() -> i32) {
  red := Color.Red;
  green := Color.Green;
  blue := Color.Blue;
  mix := Color.Mix(red: 100, green: 150, blue: 200);
  judge(mix)
};

export
  main
;