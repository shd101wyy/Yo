open import "std";
{ printf } :: import "std/libc/stdio";


sum :: ((slice : *([i32])) -> i32) {
  mut(result) := 0;
  for slice, (mut(elem), index) => {
    printf("Element at index %d: %d\n", index, elem);
    result = (elem + result);
  };
  return result;
};


main :: (() -> i32) {
  arr := [1, 2, 3, 4, 5];

  slice := *(arr(:));  
  {
    result := sum(slice);
    printf("Sum of slice elements: %d\n", result);
  };

  slice2 := *(slice(1:3));
  {
    result := sum(slice2);
    printf("Sum of slice2 elements: %d\n", result);
  };

  return 0;
};

export main;