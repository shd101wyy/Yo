extern "Yo",
  compt_codegen_inline: ((@(C): compt_string)-> @(unit)),
  compt_noop: (()-> @(unit))
;

use_builtin_function :: (() -> unit) {
  compt_codegen_inline("// Used the builtin!");

  // Code below will not be generated
  x := 1;
  y := 2;
};

main :: (() -> unit) {
  use_builtin_function();
};

export main;