
{ printf } :: import "std/libc/stdio";

sum_array :: (fn(forall(size: usize), arr : [i32; size]) -> i32) {
  result := 0;
  for arr, (elem, index) => {
    printf("Element at index %ld: %d\n", index, elem);
    result = (elem + result);
  };
  return result;
};

sum_slice :: (fn(slice : *([i32])) -> i32) {
  result := 0;
  for slice, (elem, index) => {
    printf("Element at index %ld: %d\n", index, elem);
    result = (elem + result);
  };
  return result;
};


main :: (fn() -> i32) {
  arr := [1, 2, 3, 4, 5];
  {
    result := sum_array(arr);
    printf("Sum of array elements: %d\n\n", result);
  };

  slice := &(arr(:));  
  {
    result := sum_slice(slice);
    printf("Sum of slice elements: %d\n\n", result);
  };

  slice2 := &(slice(1:3));
  {
    result := sum_slice(slice2);
    printf("Sum of slice2 elements: %d\n\n", result);
  };

  return 0;
};

export main;