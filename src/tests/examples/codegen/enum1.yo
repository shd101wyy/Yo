extern
  add :
    fn(x : i32, y : i32) -> i32
;

Shape :: enum
  Circle(radius : i32),
  Rectangle(width : i32, height : i32),
  Triangle(base : i32, height : i32)
;
main :: (fn() -> i32) {
  shape := Shape.Circle(radius: 5);
  shape = Shape.Rectangle(width: 10, height: 20);
  shape.width
};

export
  main
;