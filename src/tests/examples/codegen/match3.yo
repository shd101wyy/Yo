extern
  add :
    fn(x : i32, y : i32) -> i32,
  mul :
    fn(x : i32, y : i32) -> i32,
  div :
    fn(x : i32, y : i32) -> i32
;

Shape :: enum
  Circle(radius : i32),
  Rectangle(width : i32, height : i32),
  Triangle(base : i32, height : i32)
;

return_shape :: (fn() -> Shape)
  Shape.Rectangle(width: 10, height: 20)
;

area :: (fn() -> i32) {
  shape := return_shape();
  match shape,
    .Circle =>
      mul(3, mul(shape.radius, shape.radius)),
    .Rectangle => 
      mul(shape.width, shape.height),
    .Triangle => 
      div(mul(shape.base, shape.height), 2)
};


main :: (fn() -> i32) {
  totalArea := area();
  totalArea
};

export
  main
;