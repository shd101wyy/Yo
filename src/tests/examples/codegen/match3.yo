extern
  add :
    fn(x : i32, y : i32) -> i32,
  mul :
    fn(x : i32, y : i32) -> i32,
  div :
    fn(x : i32, y : i32) -> i32
;

Shape :: enum
  Circle(radius : i32),
  Rectangle(width : i32, height : i32),
  Triangle(base : i32, height : i32)
;

return_shape :: (fn() -> Shape)
  Shape.Rectangle(width: 10, height: 20)
;

area :: (fn() -> i32) {
  shape := return_shape();
  match shape,
    .Circle(radius) =>
      mul(3, mul(radius, radius)),
    .Rectangle(width, height) => 
      mul(width, height),
    .Triangle(base, height) => 
      div(mul(base, height), 2)
};


main :: (fn() -> i32) {
  totalArea := area();
  totalArea
};

export
  main
;