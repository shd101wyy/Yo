open import "std";
open import "std/libc/stdio.yo";

main :: (fn() -> unit) {
  printf("Before sleep (0ms)\n");
  Time.sleep(0);
  printf("After 0ms sleep\n");
  
  printf("Before sleep (100ms)\n");
  Time.sleep(100);
  printf("After 100ms sleep\n");
  
  printf("Before sleep (500ms)\n");
  Time.sleep(500);
  printf("After 500ms sleep\n");
  
    
  printf("Before sleep (2000ms)\n");
  s := 2.as(usize);
  Time.sleep(s * 1000);
  printf("After 2000ms sleep\n");

  printf("Done!\n");
};

export main;
