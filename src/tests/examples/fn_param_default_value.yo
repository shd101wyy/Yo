extern
  add: ((x: i32, y: i32)-> i32);

// Default parameters
// The default value for a parameter has to be compile-time known.
Add ::
  (( @(Lhs): Type, 
    (@(Rhs): Type) ?= Lhs, 
    @(Output) ?= Lhs
  )-> @(Type))
  module
    (@(Self): Type) = Lhs,
    (+): ((lhs: Lhs, rhs: Rhs)-> Output)
;

// _ is used as the inferred, not the default value.
// Default value is only used when the parameter is not provided.
IntAdd :: Add(i32);
IntAdd2 :: Add(i32, undefined);
IntAdd3 :: Add(i32, undefined, undefined);
BoolAdd :: Add(boolean);
BoolAdd2 :: Add(boolean, undefined);
BoolAdd3 :: Add(boolean, undefined, undefined);