extern
  add: ((x: i32, y: i32)-> i32);

// Default parameters
// The default value for a parameter has to be compile-time known.
def Add:
  ( @(Lhs): Type, 
    (@(Rhs): Type) = Lhs, 
    @(Output) = Lhs
  )-> @(Type), 
  module
    (Self: Type) == Lhs,
    (+): ((lhs: Lhs, rhs: Rhs)-> Output)
;

IntAdd :: Add(i32, _, _);
BoolAdd :: Add(boolean, _, _);

/*
// QUESTION: Should we allow the named arguments?
// Named arguments are only allowed for 
// non-compile-time known parameters,
// so the order of the arguments can be changed.
// To enable the named arguments, we need to force having the
// compile-time known parameters to be the first ones ahead the non-compile-time known parameters.
def some_add:
  (x : i32, y : i32)-> i32,
  add(x, y);
some_add(y: 3, x: 2);
*/