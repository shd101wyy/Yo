// Tuple desturcturing
main :: (()-> ()) {
  (x: (a: i32, b: boolean)) = (1, true);

  // Destructuring by position
  (m, n) := x;

  // Destructuring by label
  (a: a, b: b) := x; // a == 1, b == true

  // Renaming
  (a: u, b: v) := x; // u == 1, v == true

  // i := a;
  i := u;
  j := v;
  z := x.a;
};