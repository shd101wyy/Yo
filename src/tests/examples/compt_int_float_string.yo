/**
 * compt_int, compt_float, and compt_string
 * can only be assigned to compt variables.  
 * They are like `Type`.  
 */
extern
  add_int:
    (compt(a): compt_int, compt(b): compt_int) -> compt(compt_int),
  add_float:
    (compt(a): compt_float, compt(b): compt_float) -> compt(compt_float)
;

main :: (()-> unit) {
  // compt_int;
  i :: 12;
  /// converting compt_int to integer types are allowed
  (compt(x_compt_int) : compt_int) = i;
  x_compt_int_2 :: i;
  
  /// Create runtime int
  (x_u8: u8) = i;
  (x_i8: i8) = i;
  (x_u16: u16) = i;
  (x_i16: i16) = i;
  (x_u32: u32) = i;
  (x_i32: i32) = i;
  (x_u64: u64) = i;
  (x_i64: i64) = i;

  /// Cannot assign runtime int to compt_int
  compt_expect_error(
    (compt(x_compt_int_3) : compt_int) = x_u8
    // Error: cannot assign runtime value to compt_int
  ); 

  // compt_float;
  f :: 12.3;
  /// converting compt_float to float types are allowed
  (compt(x_compt_float) : compt_float) = f;
  x_compt_float_2 :: f;

  /// Create runtime float
  (x_f32: f32) = f;
  (x_f64: f64) = f;

  /// Cannot assign runtime float to compt_float
  compt_expect_error(
    (compt(x_compt_float_3) : compt_float) = x_f32
    // Error: cannot assign runtime value to compt_float
  );

  // compt_string;
  s :: "Hello, World!";
};