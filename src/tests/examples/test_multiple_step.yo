open import "std";
{ printf } :: import "std/libc/stdio";

test :: (fn(max : i32) -> i32) {
  result := 0;
  i := 0.as(i32);
  j := 0.as(i32);
  
  while i < max, begin(i = (i + 1), j = (j + 2)), {
    result = ((result + i) + j);
  };

  return result;
};

main :: (fn() -> i32) {
  result := test(5);
  printf("Result with multiple step expressions: %d\n", result);
  return 0;
};

export main;
