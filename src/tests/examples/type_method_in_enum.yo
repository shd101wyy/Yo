Shape :: enum
  Circle(radius: i32),
  Rectangle(width: i32, height: i32),
  Triangle(base: i32, height: i32),

  Self.new_circle = (
    ((radius: i32) -> Self)
      .Circle(radius)
  ),
  Self.id = (((self: Self)-> Self)
    self
  )
;
main :: (()-> unit) {
  c := Shape.new_circle(5);
  d := c.id();
};