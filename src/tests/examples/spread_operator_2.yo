Clone :: ((compt(Self): Type) -> compt(Module))
  module
    Self  := Self,
    clone :
      (( self: &(Self) ) -> Self)
;

Point :: struct
  x : i32,
  y : i32,

  // Implement the Clone module
  ...(
    Clone(Self)(
      clone : 
        fn(self) ->
          Self(self.x, self.y)
    ))
;

Point.clone(&(Point(1, 2)));