extern "Yo",
  Data: Linear,
  malloc  :
    ()-> Data
;

some_condition :: (()-> boolean)
  true
;

compt_expect_error(
  test :: (()-> unit) {
    x : i32;

    cond
      some_condition() => {
        x = 1;
      },
      true => {
        ();
      }
    ;

    // it should give error as
    // `x` is possibily undefined.
  }
);

test2 :: (()-> unit) {
  x : i32;
  cond
    some_condition() => {
      x = 1;
    },
    true => {
      x = 2;
    }
  ;
};

test3 :: (()-> unit) {
  x : i32;
  cond
    some_condition() => {
      x = 1;
    },
    true => {
      x = 2;
    }
  ;
  compt_expect_error(
    x = 3
  );
};