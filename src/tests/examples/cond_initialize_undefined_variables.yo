extern "Yo",
  Data: Type,
  malloc  :
    fn()-> Data
;

some_condition :: (fn()-> bool)
  true
;

compt_expect_error(
  test :: (fn() -> unit) {
    x : i32;

    cond
      some_condition() => {
        x = 1;
      },
      true => {
        ();
      }
    ;

    // it should give error as
    // `x` is possibily undefined.
  }
);

test2 :: (fn() -> unit) {
  x : i32;
  cond
    some_condition() => {
      x = 1;
    },
    true => {
      x = 2;
    }
  ;
};

test3 :: (fn() -> unit) {
  x : i32;
  cond
    some_condition() => {
      x = 1;
    },
    true => {
      x = 2;
    }
  ;
};