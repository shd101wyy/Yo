open import "std";
open import "std/libc/stdio";

Point :: struct(
  x : i32,
  y : i32,

  Add :: Add(Self)(
    Self : Self,
    (+) : ((self, rhs) -> {
      printf("Called + from Point.Add.(+)");
      Self(self.x + rhs.x, self.y + rhs.y)
    })
  )
);

Another :: impl {
  Self :: Point;
  _Add :: Add(Self)(
    Self : Self,
    (+) : ((self, rhs) ->{
      printf("Called + from Another._Add.(+)");
      Self(self.x - rhs.x, self.y - rhs.y)
    })
  );
  export Self, Add: _Add;
};

main :: (fn() -> unit) {
  a := Point(3, 4);
  b := Point(1, 2);
  c := (a + b); // Should call Point.Add.(+)
                // Because type methods have higher priority than other module methods.
};

export main;