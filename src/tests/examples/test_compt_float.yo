open import "std";

/**
 * Test compile-time float operations
 */
main :: (fn() -> unit) {
  // Basic float operations
  a :: 3.5;
  b :: 2.5;
  
  // Arithmetic operations
  sum :: (a + b);        // 6.0
  diff :: (a - b);       // 1.0
  prod :: (a * b);       // 8.75
  quot :: (a / b);       // 1.4
  
  // Unary operations
  neg_a :: a.neg();         // -3.5
  
  // Comparison operations
  eq_test :: (a == b);   // false
  neq_test :: (a != b);  // true
  lt_test :: (a < b);    // false
  lte_test :: (a <= b);  // false
  gt_test :: (a > b);    // true
  gte_test :: (a >= b);  // true
  
  // Type conversion operations
  float_to_int :: a.as(i32);     // 3
  float_to_string :: a.to_string(); // "3.5"
  
  // Test with compile-time assertions
  compt_assert(sum == 6.0);
  compt_assert(diff == 1.0);
  compt_assert(prod == 8.75);
  compt_assert(quot == 1.4);
  compt_assert(neg_a == 3.5.neg());
  
  
  compt_assert(eq_test == false);
  compt_assert(neq_test == true);
  compt_assert(lt_test == false);
  compt_assert(lte_test == false);
  compt_assert(gt_test == true);
  compt_assert(gte_test == true);
  
  compt_assert(float_to_int == 3);
  compt_assert(float_to_string == "3.5");
  
  // Test zero division error handling
  // This should cause a compile-time error
  // zero :: 0.0;
  // division_by_zero :: a / zero;
  
  ()
};
