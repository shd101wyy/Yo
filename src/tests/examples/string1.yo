// string
extern "c",
  printf : 
    fn(format: *(char), ...) -> int
;

main :: (fn() -> int) {
  // compt_string
  s1 :: "Yo lang!";
  
  // &([u8])
  s2 := s1;
  (s3 : (*([u8]))) = s1; // QUESTION: Should we allow to assign to local variable?

  // *(u8) or *(char)
  (s4 : *(u8)) = s1;
  (s5 : *(char)) = s1;

  printf("Hello, world!\n");
  printf("Hello, %s", s5);
  0
};