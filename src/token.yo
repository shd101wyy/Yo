//! Token types for the Yo lexer.
{ rune, String } :: import("std/string");
{ ToString } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
TokenKind :: enum(
  Operator,
  Dot,
  LParen,
  RParen,
  LBracket,
  RBracket,
  LCurlyBracket,
  RCurlyBracket,
  CharLit,
  StringLit,
  TemplateString,
  Identifier,
  Integer,
  Float,
  Bool,
  Semicolon,
  Comma,
  SingleLineComment,
  MultiLineComment,
  DocLineComment,
  InnerDocLineComment,
  DocBlockComment,
  InnerDocBlockComment,
  Whitespace
);
derive(TokenKind, Eq(TokenKind), Hash, Clone, ToString);
Token :: ref(
  struct(
    kind : TokenKind,
    value : String,
    /// The four positions are `u32` (a source file is far below 4 GiB): with
    /// the 4-byte `kind` a `Token` is 64 B instead of 80, 16 B off each of
    /// the ~1.9 M tokens a `check src/main.yo` keeps
    /// (plans/EVALUATOR_MEMORY_REDUCTION.md §3.4). Widen with `usize(...)`
    /// at the read.
    row : u32,
    column : u32,
    /// RUNE offset of this token's first character within `input` — the
    /// lexer's `input.chars()` loop counter. Used as an expression identity
    /// key (`await_analysis`, `effect_analysis`) and served straight to the
    /// LSP as a `character` position. **Never index `input` with it** — see
    /// `byte_offset`.
    character : u32,
    /// BYTE offset of this token's first character within `input`.
    ///
    /// `character` is a rune offset, so slicing `input` (which is byte-indexed
    /// since `plans/archive/STD_API_AUDIT_D4_PLAN.md` D4) with it corrupts any source
    /// containing a multibyte character — that is exactly what
    /// `issues/fixed/yo-self-formatter-corrupts-files-with-non-ascii.md` was,
    /// and that issue's "Fix direction" named this field as the follow-up.
    /// Every consumer that INDEXES `input` reads this one.
    ///
    /// Defaults to 0 for the synthetic tokens the parser and evaluator mint:
    /// they have no source text to index, and their `character` is 0 or copied
    /// (in which case `byte_offset` is copied alongside it).
    (byte_offset : u32) ?= u32(0),
    module_path : String,
    input : String
  )
);
derive(Token, Eq(Token));
// `Token` is an `object` (Rc), not a value `struct` (P2 memory). Every `AstExpr`
// embeds a `Token` and `Variable` embeds two, and AST/variable clones are
// pervasive during the self-compile. As a value struct, each holder inlined the
// ~104-byte Token, and each clone copied it — once ~1.6 GB of peak when
// `derive(Clone)` also deep-copied the ~100–200 KB `input` source string. As an
// Rc object every holder stores an 8-byte pointer to ONE shared token, and
// `.clone()` is a refcount bump (the body returns `self`) that shares the whole
// token — positions, lexeme, and the immutable `input`/`module_path` source
// strings. Sound because tokens are immutable after lexing (no field is ever
// reassigned).
impl(
  Token,
  Clone(
    clone : (fn(inout(self) : Self) -> Self)(self)
  )
);
is_operator_char :: (fn(c : rune) -> bool)(
  cond(
    (c.char == u32(61)) => true,
    (c.char == u32(43)) => true,
    (c.char == u32(45)) => true,
    (c.char == u32(42)) => true,
    (c.char == u32(47)) => true,
    (c.char == u32(60)) => true,
    (c.char == u32(62)) => true,
    (c.char == u32(64)) => true,
    (c.char == u32(36)) => true,
    (c.char == u32(126)) => true,
    (c.char == u32(38)) => true,
    (c.char == u32(37)) => true,
    (c.char == u32(124)) => true,
    (c.char == u32(33)) => true,
    (c.char == u32(63)) => true,
    (c.char == u32(94)) => true,
    (c.char == u32(46)) => true,
    (c.char == u32(58)) => true,
    (c.char == u32(92)) => true,
    (c.char == u32(35)) => true,
    true => false
  )
);
/// Operators that can NEVER be bound or overloaded
/// (plans/reference/OPERATOR_SET_AND_PRECEDENCE.md): `&&`/`||` must stay lazy
/// builtins (an overload would silently lose short-circuiting), and the
/// rest are structural grammar — binding forms, arms, labels, type syntax,
/// and the quote-layer splice markers. (Trait declarations are not gated:
/// operator dispatch resolves these as builtins before any trait lookup,
/// so a trait field named e.g. `(&&)` is unreachable, not unsound.)
is_reserved_operator_name :: (fn(name : String) -> bool)(
  (name == "=") || ((name == ":=") || ((name == "::") || ((name == ":") || ((name == "=>") || ((name == "->") || ((name == "<:") || ((name == "?=") || ((name == "&&") || ((name == "||") || ((name == "#") || ((name == "...#") || ((name == "..") || ((name == "..=") || ((name == "...") || (name == "==>")))))))))))))))
);
/// Plain-named BUILTIN dispatch names. Any call spelled with one of these
/// names routes to the builtin in the evaluator AND codegen, so a user
/// binding of the same name is silently hijacked — the definition can never
/// run: `consume(x)` marked x consumed and leaked its reference, and probes
/// of the rest mis-evaluated (typeof/asm/pragma/the/quote rejected with the
/// builtin's own type errors; comptime_print/requires/&c. folded to unit;
/// only `as` and `clone` happened to defer). Per the 2026-09-27 decision the
/// WHOLE surface is reserved for bindings, like the reserved operators —
/// every BF_/BK_ builtin spelled as a plain identifier, plus the unspellable
/// `___drop`/`___dup` (underscores are identifier characters, so they are
/// typeable). Structural keywords (begin/cond/match/while/if/return/…)
/// never lex as identifiers and need no entry. `std/prelude.yo` is exempt at
/// the gate sites (its `unsafe :: impl(…)` namespace module predates the
/// rule). The `__yo` runtime prefix is NOT reserved yet: src/ binds 133
/// `__yo_*` names for the runtime's own C symbols, and the evaluator mints
/// `__yo_self`/`__yo_pat_s`/`__yo_contract_result` into user modules.
is_reserved_builtin_binding_name :: (fn(name : String) -> bool)(
  (name == "typeof") || ((name == "sizeof") || ((name == "alignof") || (name == "typeid"))) ||
    ((name == "runtime") || ((name == "unwind") || ((name == "recur") || (name == "consume"))))
    || (
      (name == "unsafe") || ((name == "pragma") || ((name == "asm") || (name == "global_asm"))) ||
        ((name == "macro_expand") || (name == "va_start"))
    ) || (
      (name == "comptime_assert") || ((name == "comptime_fn") || ((name == "comptime_print") || (name == "comptime_eval"))) ||
        ((name == "comptime_read_file") || ((name == "comptime_json_parse") || (name == "comptime_toml_parse")))
    ) || (
      (name == "requires") || ((name == "ensures") || ((name == "invariant") || (name == "decreases"))) ||
        ((name == "assumed") || (name == "___drop") || ((name == "___dup") || (name == "dyn")))
    ) || ((name == "the") || ((name == "as") || ((name == "clone") || (name == "quote")))) ||
      ((name == "downcast") || (name == "upcast") || (name == "ref_count")) ||
        // The identifier-spelled call-HEADS the evaluator dispatches on
        // (begin/tuple/array sit in the special-head list of
        // src/evaluator/effects/mutation_summary.yo beside the reserved
        // clone/consume/the/as/dyn above): a user binding of the name never
        // runs — `begin`/`tuple` calls evaluate to unit, `array()` parses as
        // the array-literal builtin (issues/begin-tuple-array-bindings-are-silently-hijacked.md).
        // `thread_local` is special only in the
        // `(thread_local(name) : T) = init;` LHS position, so it stays bindable.
        ((name == "begin") || (name == "tuple") || (name == "array"))
);
is_identifier_start :: (fn(c : rune) -> bool)(
  (c.char == u32(95)) || c.is_alphabetic() || (c.char >= u32(0xA0))
);
is_identifier_continue :: (fn(c : rune) -> bool)(
  is_identifier_start(c) || c.is_digit()
);
/// True iff every char of `s` is an operator char.
string_is_operator :: (fn(s : String) -> bool)({
  n := s.len();
  cond(
    // Vacuously true for the empty string.
    (n == usize(0)) => true,
    true => {
      (i : usize) = usize(0);
      (ok : bool) = true;
      while((i < n) && ok, {
        b := s.byte_at(i);
        // Operator chars: same set as is_operator_char, but on bytes
        is_op := cond(
          (b == u8(61)) => true,
          // =
          (b == u8(43)) => true,
          // +
          (b == u8(45)) => true,
          // -
          (b == u8(42)) => true,
          // *
          (b == u8(47)) => true,
          // /
          (b == u8(60)) => true,
          // <
          (b == u8(62)) => true,
          // >
          (b == u8(64)) => true,
          // @
          (b == u8(36)) => true,
          // $
          (b == u8(126)) => true,
          // ~
          (b == u8(38)) => true,
          // &
          (b == u8(37)) => true,
          // %
          (b == u8(124)) => true,
          // |
          (b == u8(33)) => true,
          // !
          (b == u8(63)) => true,
          // ?
          (b == u8(94)) => true,
          // ^
          (b == u8(46)) => true,
          // .
          (b == u8(58)) => true,
          //
          (b == u8(92)) => true,
          // \
          (b == u8(35)) => true,
          // #
          true => false
        );
        if(!is_op, {
          ok = false;
        });
        i = (i + usize(1));
      });
      ok
    }
  )
});
/// True iff `s` is a valid identifier under the regex
/// `^[_a-zA-Z\xA0-￿][_a-zA-Z0-9\xA0-￿]*$`.
is_valid_identifier :: (fn(s : String) -> bool)({
  chars := ArrayList(rune).new();
  {
    c_iter := s.chars();
    while(true, {
      match(
        c_iter.next(),
        .None => {
          break;
        },
        .Some(r) => {
          chars.push(r);
        }
      );
    });
  };
  n := chars.len();
  cond(
    (n == usize(0)) => false,
    true => {
      first := match(chars.get(usize(0)), .Some(c) => c, .None => rune(u32(0)));
      cond(
        !is_identifier_start(first) => false,
        true => {
          (i : usize) = usize(1);
          (ok : bool) = true;
          while((i < n) && ok, {
            ch := match(chars.get(i), .Some(c) => c, .None => rune(u32(0)));
            if(!is_identifier_continue(ch), {
              ok = false;
            });
            i = (i + usize(1));
          });
          ok
        }
      )
    }
  )
});
// Token-text INTERN table: one canonical String instance per
// distinct token text, so every same-named token shares one buffer and
// downstream `String ==` hits the interned ptr+len fast path
// (std/string/string.yo). Identifier-name compares (env frame scans,
// dispatch conds) are ~38% of a stage2 emit purely from call volume
// (issues/yo-self-compile-performance-rc-string-eq.md). Safe to share:
// token value Strings are never mutated in place (audited 2026-07-27);
// clones fall back to memcmp. The hash+lookup is paid once per TOKEN,
// the savings on every later compare.
g_token_intern := HashMap(String, String).new();
intern_token_str :: (fn(s : String) -> String)(
  match(
    g_token_intern.get(s),
    .Some(canonical) => canonical,
    .None => {
      g_token_intern.insert(s, s);
      s
    }
  )
);
/// Synthetic placeholder token used as a sentinel position when constructing
/// AST nodes that have no real source location.
placeholder_token :: (fn() -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from("_"),
    row : u32(0),
    column : u32(0),
    character : u32(0),
    module_path : String.from("_"),
    input : String.from("_")
  )
);
/// Synthetic token used for `drop` (RAII) markers attached to compiler-generated
/// drop expressions.
raii_token :: (fn() -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from("drop"),
    row : u32(0),
    column : u32(0),
    character : u32(0),
    module_path : String.from("drop"),
    input : String.from("drop")
  )
);
find_matching_bracket :: (fn(tokens : ArrayList(Token), start : usize) -> Option(usize))({
  n := tokens.len();
  if(start >= n, {
    return(.None);
  });
  start_tok := match(
    tokens.get(start),
    .Some(t) => t,
    .None => {
      return(.None);
    }
  );
  start_kind := start_tok.kind;
  is_open_bracket := ((start_kind == TokenKind.LCurlyBracket) || (start_kind == TokenKind.LParen) || (start_kind == TokenKind.LBracket));
  if(!is_open_bracket, {
    return(.None);
  });
  (end_kind : TokenKind) = cond(
    (start_kind == TokenKind.LCurlyBracket) => TokenKind.RCurlyBracket,
    (start_kind == TokenKind.LParen) => TokenKind.RParen,
    true => TokenKind.RBracket
  );
  i := (start + usize(1));
  depth := usize(1);
  while(i < n, {
    tk_opt := tokens.get(i);
    match(
      tk_opt,
      .None => {
        break;
      },
      .Some(tok) => {
        tk := tok.kind;
        cond(
          (tk == end_kind) => {
            depth = (depth - usize(1));
            if(depth == usize(0), {
              return(.Some(i));
            });
          },
          (tk == start_kind) => {
            depth = (depth + usize(1));
          },
          true => ()
        );
      }
    );
    i = (i + usize(1));
  });
  .None
});
export(
  TokenKind,
  Token,
  is_operator_char,
  is_reserved_operator_name,
  is_reserved_builtin_binding_name,
  is_identifier_start,
  is_identifier_continue,
  string_is_operator,
  is_valid_identifier,
  placeholder_token,
  raii_token,
  find_matching_bracket,
  intern_token_str
);
