//! `yo init` — project scaffolding.
//!
//! Creates a new Yo project with:
//!   build.yo, deps.yo, src/main.yo, src/lib.yo,
//!   tests/main.test.yo, .gitignore, README.md
//!
//! This mirrors `src/init.ts`.
open(import("std/string"));
open(import("std/fmt"));
{ env } :: import("std/env");
{ Path } :: import("std/path");
{ AnyError, Exception, IoExn } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ cwd } :: import("std/env");
{ exists, write_string } :: import("std/fs/file");
{ create_dir_all } :: import("std/fs/dir");
// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------
/// Options for `init_project`.
InitOptions :: ref(
  struct(
    /// Directory to initialize (may be relative).
    dir : String,
    /// Project name override. If `.None`, derived from the directory basename.
    name : Option(String)
  )
);
// ---------------------------------------------------------------------------
// Name sanitization
// ---------------------------------------------------------------------------
/// Return true if the ASCII byte `b` is valid in a project name
/// (alphanumeric, underscore, or hyphen).
_is_valid_name_byte :: (fn(b : u8) -> bool)(
  ((b >= u8(97)) && (b <= u8(122))) // a-z
  || ((b >= u8(65)) && (b <= u8(90))) // A-Z
  || ((b >= u8(48)) && (b <= u8(57))) // 0-9
  || (b == u8(95)) // _
  || (b == u8(45)) // -
);
/// Replace characters that are not `[a-zA-Z0-9_-]` with `-`.
sanitize_project_name :: (fn(raw : String) -> String)({
  result := String.new();
  bytes := raw.as_bytes();
  i := usize(0);
  while(i < bytes.len(), {
    b_opt := bytes.get(i);
    match(
      b_opt,
      .None => (),
      .Some(b) => cond(
        (_is_valid_name_byte(b)) => {
          result.push_byte(b);
        },
        true => {
          result.push_str("-");
        }
      )
    );
    i = (i + usize(1));
  });
  result
});
// ---------------------------------------------------------------------------
// Template generators (pure functions)
// ---------------------------------------------------------------------------
/// Generate the content of `build.yo`.
generate_build_yo :: (fn(name : String) -> String)(
  `build :: import("std/build");
{ imports } :: import("./deps.yo");
{ assert, panic } :: import("std/assert");

mod :: build.module({ name: "${name}", root: "./src/lib.yo" });

exe :: build.executable({ name: "${name}", root: "./src/main.yo" });
exe.add_import_list(imports);

lib :: build.static_library({ name: "${name}-lib", root: "./src/lib.yo" });

tests :: build.test({ name: "tests", root: "./tests/" });

run_exe :: build.run(exe);

docs :: build.doc({ name: "docs", root: "./src" });

install :: build.step("install", "Build all artifacts");
install.depend_on(exe);
install.depend_on(lib);

run_step :: build.step("run", "Run the application");
run_step.depend_on(run_exe);

test_step :: build.step("test", "Run unit tests");
test_step.depend_on(tests);

doc_step :: build.step("doc", "Generate documentation");
doc_step.depend_on(docs);
`
);
/// Generate the content of `src/main.yo`.
generate_main_source :: (fn() -> str)(
  "{ println } :: import(\"std/fmt\");\n\nmain :: (fn() -> unit)({\n  println(\"Hello, world!\");\n});\n\nexport(main);\n"
);
/// Generate the content of `src/lib.yo`.
generate_lib_source :: (fn() -> str)(
  "// Library root module\n\nadd :: (fn(a: i32, b: i32) -> i32)(\n  (a + b)\n);\nexport(add);\n"
);
/// Generate the content of `tests/main.test.yo`.
generate_test_file :: (fn() -> str)(
  "{ assert } :: import(\"std/assert\");\n\ntest(\"it works\", {\n  assert(((1 + 1) == 2), \"math is broken\");\n});\n"
);
/// Generate the content of `deps.yo`.
generate_deps_yo :: (fn() -> str)(
  "// Dependencies for this project.\n// Managed by `yo install`. Manual edits are preserved.\n//\n// Usage in build.yo:\n//   { imports } :: import(\"./deps.yo\");\n//   exe.add_import_list(imports);\n//\n// Add a dependency:\n//   yo install user/repo\n//   yo install user/repo@v1.0.0\n//   yo install ./local-path\n//\n// Note: The section between \"--- Import list ---\" and \"export(imports);\"\n// is auto-regenerated by `yo install`. All other content is preserved.\n\nbuild :: import(\"std/build\");\n\n// --- Dependencies ---\n\n// --- Import list ---\nimports :: ComptimeList(build.ImportEntry)();\nexport(imports);\n"
);
/// Generate the content of `.gitignore`.
generate_gitignore :: (fn() -> str)(
  "# Build output\nyo-out/\n\n# Generated files\n*.o\na.out\na.out.c\n\n# OS files\n.DS_Store\nThumbs.db\n"
);
/// Generate the content of `README.md`.
generate_readme :: (fn(name : String) -> String)(
  `# ${name}

A project written in Yo programming language.

## Build

` + String.from("```bash\nyo build\n```\n\n## Run\n\n```bash\nyo build run\n```\n\n## Test\n\n```bash\nyo build test\n```\n\n## Documentation\n\n```bash\nyo build doc\n```\n")
);
// ---------------------------------------------------------------------------
// Main init function
// ---------------------------------------------------------------------------
/// Initialise a new Yo project in `options.dir`.
///
/// Skips files that already exist.  Aborts (throws) if `build.yo` already
/// exists to avoid silently overwriting a project.
init_project :: (
  fn(
    options : InitOptions,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e) => {
    // Resolve user CWD (yo-cli overrides this env var when it changes directory)
    user_cwd_str := match(
      env.get(String.from("YO_ORIGINAL_CWD")),
      .Some(d) => d,
      .None => match(
        cwd(),
        .Ok(p) => p.to_string(),
        .Err(_) => String.from(".")
      )
    );
    // Build the absolute project directory path
    project_dir := cond(
      (options.dir.starts_with(String.from("/"))) => Path.new(options.dir),
      true => Path.new(user_cwd_str).join(Path.new(options.dir))
    );
    // Derive project name
    raw_name := match(
      options.name,
      .Some(n) => n,
      .None => match(
        project_dir.file_name(),
        .Some(s) => s,
        .None => String.from("my-project")
      )
    );
    project_name := sanitize_project_name(raw_name);
    // Create directory structure
    e.io.await(create_dir_all(project_dir, e.io), e);
    e.io.await(create_dir_all(project_dir.join(Path.new(String.from("src"))), e.io), e);
    e.io.await(create_dir_all(project_dir.join(Path.new(String.from("tests"))), e.io), e);
    // build.yo — abort if already exists
    build_yo_path := project_dir.join(Path.new(String.from("build.yo")));
    build_yo_exists := e.io.await(exists(build_yo_path, e.io), e.io);
    cond(
      build_yo_exists => {
        e.exn.throw(dyn(`Error: ${build_yo_path.to_string()} already exists. Aborting.`));
      },
      true => ()
    );
    e.io.await(write_string(build_yo_path, generate_build_yo(project_name), e.io), e);
    // deps.yo
    deps_yo_path := project_dir.join(Path.new(String.from("deps.yo")));
    deps_yo_exists := e.io.await(exists(deps_yo_path, e.io), e.io);
    cond(
      !(deps_yo_exists) => {
        e.io.await(write_string(deps_yo_path, String.from(generate_deps_yo()), e.io), e);
      },
      true => ()
    );
    // src/main.yo
    main_path := project_dir.join(Path.new(String.from("src/main.yo")));
    main_exists := e.io.await(exists(main_path, e.io), e.io);
    cond(
      !(main_exists) => {
        e.io.await(write_string(main_path, String.from(generate_main_source()), e.io), e);
      },
      true => ()
    );
    // src/lib.yo
    lib_path := project_dir.join(Path.new(String.from("src/lib.yo")));
    lib_exists := e.io.await(exists(lib_path, e.io), e.io);
    cond(
      !(lib_exists) => {
        e.io.await(write_string(lib_path, String.from(generate_lib_source()), e.io), e);
      },
      true => ()
    );
    // tests/main.test.yo
    test_path := project_dir.join(Path.new(String.from("tests/main.test.yo")));
    test_exists := e.io.await(exists(test_path, e.io), e.io);
    cond(
      !(test_exists) => {
        e.io.await(write_string(test_path, String.from(generate_test_file()), e.io), e);
      },
      true => ()
    );
    // .gitignore
    gitignore_path := project_dir.join(Path.new(String.from(".gitignore")));
    gitignore_exists := e.io.await(exists(gitignore_path, e.io), e.io);
    cond(
      !(gitignore_exists) => {
        e.io.await(write_string(gitignore_path, String.from(generate_gitignore()), e.io), e);
      },
      true => ()
    );
    // README.md
    readme_path := project_dir.join(Path.new(String.from("README.md")));
    readme_exists := e.io.await(exists(readme_path, e.io), e.io);
    cond(
      !(readme_exists) => {
        e.io.await(write_string(readme_path, generate_readme(project_name), e.io), e);
      },
      true => ()
    );
    // Success message
    println(`\nInitialized Yo project "${project_name}" in ${project_dir.to_string()}`);
    println(String.from(""));
    println(String.from("  Created:"));
    println(String.from("    build.yo"));
    println(String.from("    deps.yo"));
    println(String.from("    src/main.yo"));
    println(String.from("    src/lib.yo"));
    println(String.from("    tests/main.test.yo"));
    println(String.from("    .gitignore"));
    println(String.from("    README.md"));
    println(String.from(""));
    println(String.from("  Get started:"));
    // Echo the directory as the user typed it, but only when it is not already
    // the cwd (`yo init .`). Mirrors `src/init.ts`.
    cond(
      (project_dir.to_string() != Path.new(user_cwd_str.clone()).to_string()) => {
        println(`    cd ${options.dir}`);
      },
      true => ()
    );
    println(String.from("    yo build run"));
    println(String.from(""));
  })
);
export(
  InitOptions,
  sanitize_project_name,
  generate_build_yo,
  generate_main_source,
  generate_lib_source,
  generate_test_file,
  generate_deps_yo,
  generate_gitignore,
  generate_readme,
  init_project
);
