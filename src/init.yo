//! `yo init` — project scaffolding.
//!
//! Creates a new Yo project with:
//!   yo.toml, build.yo, src/main.yo, src/lib.yo,
//!   tests/main.test.yo, tests/lib.test.yo, spec/README.md, spec/example.yo,
//!   .gitignore, README.md
//!
//! It then writes `AGENTS.md` (the agent-facing entry point, whose command
//! block opens with `yo context`) and a one-line `CLAUDE.md` holding
//! `@AGENTS.md` — see `install_agent_files`. No skill tree is copied: the
//! version-matched language knowledge is `yo context`, served by the
//! installed toolchain.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ env } :: import("std/env");
{ Path } :: import("std/path");
{ AnyError, Exception, IoExn } :: import("std/error");
{ cwd } :: import("std/env");
{ exists, write_string } :: import("std/fs/file");
{ create_dir_all } :: import("std/fs/dir");
// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------
/// Options for `init_project`.
InitOptions :: struct(
  /// Directory to initialize (may be relative).
  dir : String,
  /// Project name override. If `.None`, derived from the directory basename.
  name : Option(String)
);
// ---------------------------------------------------------------------------
// Name sanitization
// ---------------------------------------------------------------------------
/// The kebab-case package name `yo init` writes for `raw` (a directory
/// basename or `--name`): ASCII letters are lowercased, every byte outside
/// `[a-z0-9]` (`_`, `.`, spaces, …) becomes `-`, runs of `-` collapse to one
/// and leading/trailing `-` are trimmed — `My_Project 2` is `my-project-2`.
/// Kebab-case is Yo's package-name convention; the tool is inventing the name
/// of a brand-new project, so it emits the canonical form, and a user who
/// wants another edits yo.toml (the manifest accepts `[A-Za-z0-9_-]+`).
sanitize_project_name :: (fn(raw : &String) -> String)({
  result := String.new();
  (pending_hyphen : bool) = false;
  i := usize(0);
  while(i < raw.len(), {
    match(
      raw.get_byte(i),
      .None => (),
      .Some(b) => {
        lower := cond(
          ((b >= u8(65)) && (b <= u8(90))) => (b + u8(32)), // A-Z → a-z
          true => b
        );
        cond(
          (((lower >= u8(97)) && (lower <= u8(122))) || ((lower >= u8(48)) && (lower <= u8(57)))) => {
            // A separator seen since the last kept byte becomes one `-`,
            // and only between two kept bytes (never leading or trailing).
            if(pending_hyphen && (result.len() > usize(0)), {
              result.push_str("-");
            });
            pending_hyphen = false;
            result.push_byte(lower);
          },
          true => {
            pending_hyphen = true;
          }
        );
      }
    );
    i = (i + usize(1));
  });
  result
});
// ---------------------------------------------------------------------------
// Template generators (pure functions)
// ---------------------------------------------------------------------------
/// Generate the content of `build.yo`.
generate_build_yo :: (fn(name : &String) -> String)(
  `build :: import("std/build");
{ assert, panic } :: import("std/assert");

exe :: build.executable(.{ name : "${name}", root : "./src/main.yo" });

lib :: build.static_library(.{ name : "${name}-lib", root : "./src/lib.yo" });

tests :: build.test(.{ name : "tests", root : "./tests/" });

run_exe :: build.run(exe);

docs :: build.doc(.{ name : "docs", root : "./src" });

install :: build.step("install", "Build all artifacts");
install.depend_on(exe);
install.depend_on(lib);

run_step :: build.step("run", "Run the application");
run_step.depend_on(run_exe);

test_step :: build.step("test", "Run unit tests");
test_step.depend_on(tests);

doc_step :: build.step("doc", "Generate documentation");
doc_step.depend_on(docs);
`
);
/// Generate the content of `yo.toml` — the package manifest
/// (plans/archive/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.1). `[modules] default`
/// is what `import("<name>")` resolves to, in this project and in every
/// project that depends on it; `yo add` writes `[dependencies]`.
generate_yo_toml :: (fn(name : &String) -> String)(
  `[package]
name = "${name}"
version = "0.1.0"

[modules]
default = "src/lib.yo"

[dependencies]
# Add one with \`yo add user/repo\`, \`yo add user/repo@^1.2\` or \`yo add ./path\`.
`
);
/// Generate the content of `src/main.yo`.
generate_main_source :: (fn() -> str)(
  "{ println } :: import(\"std/fmt\");\n\nmain :: (fn() -> unit)({\n  println(\"Hello, world!\");\n});\n\nexport(main);\n"
);
/// Generate the content of `src/lib.yo`.
generate_lib_source :: (fn() -> str)(
  "// Library root module\nadd :: (fn(a : i32, b : i32) -> i32)(\n  a + b\n);\nexport(add);\n"
);
/// Generate the content of `tests/main.test.yo`.
generate_test_file :: (fn() -> str)(
  "{ assert } :: import(\"std/assert\");\n\ntest(\"it works\", {\n  assert((1 + 1) == 2, \"math is broken\");\n});\n"
);
/// Generate the content of `tests/lib.test.yo` — a REAL test of `src/lib.yo`,
/// as opposed to `main.test.yo`, which only demonstrates the `test(...)` form.
/// It imports the library the way a consumer does: by PACKAGE NAME, resolved
/// through the `[modules] default` entry in `yo.toml`, so the scaffold
/// exercises the manifest rather than reaching across the tree with a relative
/// path.
generate_lib_test_file :: (fn(name : &String) -> String)(
  `{ add } :: import("${name}");
`
  + String.from("{ assert } :: import(\"std/assert\");\n\ntest(\"add sums two integers\", {\n  assert(add(2, 3) == 5, \"add(2, 3) should be 5\");\n});\n")
);
/// Generate the content of `.gitignore`.
generate_gitignore :: (fn() -> str)(
  "# Build output\nyo-out/\n\n# Generated files\n*.o\na.out\na.out.c\n\n# OS files\n.DS_Store\nThumbs.db\n"
);
/// Generate the content of `README.md`. Everything below the title is a
/// plain `str` rather than a template literal: the body is full of markdown
/// code fences and inline code, and a backtick would close the template.
generate_readme :: (fn(name : &String) -> String)(
  `# ${name}

A project written in Yo programming language.

`
  + String.from("## Project layout\n\n| Path | What it is |\n| ---- | ---------- |\n| `yo.toml` | The package manifest — name, version, `[modules]` (what importers get) and `[dependencies]`. |\n| `yo.lock` | Written by `yo install`. Commit it. |\n| `build.yo` | The build definition: artifacts and steps, written in Yo. |\n| `src/main.yo` | The executable's entry point. |\n| `src/lib.yo` | The library root. Importers get it under the package name, through the `[modules] default` entry — which is how `tests/lib.test.yo` imports it. |\n| `tests/*.test.yo` | Tests. `yo build test` runs every file in `tests/`. |\n\n## Build\n\n```bash\nyo build\n```\n\n## Run\n\n```bash\nyo build run\n```\n\n## Test\n\n```bash\nyo build test\n```\n\n## Documentation\n\n```bash\nyo build doc\n```\n\n## Dependencies\n\nDependencies are declared in `yo.toml` and resolved by Yo's own package manager:\n\n```bash\nyo add user/repo       # latest release tag, recorded as a semver range\nyo add user/repo@^1.2  # an explicit range\nyo add ./path          # a local path dependency\nyo remove name\nyo install             # fetch what yo.toml declares, write yo.lock\n```\n\n`yo build` fetches for you. The other commands — `yo check`, `yo test`,\n`yo compile`, `yo doc` — resolve imports but never fetch, so run `yo install`\nonce after cloning.\n")
);
/// Generate the content of `spec/README.md` — the claims/proofs wall
/// (BEND D3, plans/backlog/BEND_LAWS_AND_AGENT_LOOP_LESSONS.md): claims
/// live in `spec/` and are written by the human; proofs are the contracts
/// and invariants in the code. A plain `str`, like `generate_readme`'s
/// body: the markdown carries inline code, and a backtick would close a
/// template literal.
generate_spec_readme :: (fn() -> String)(
  String.from(
    "# spec/ — the claims wall\n\nThis directory holds the project's LAWS: claims about what the code must\ndo, stated outside the code they describe. Claims are written by humans —\na law is a promise, not a test — and each one is proved from the\ncontracts (`requires`/`ensures`) and invariants the code carries, never\nfrom its implementation bodies. `yo verify ./spec --strict` is the gate:\nit proves every law here and counts `assumed()`, `outside-subset` and\n`unproven` as failures, so a green run means every claim is discharged.\n\nKeep the wall in place: edit the claims here, and put the proofs — the\ncontracts, invariants and lemmas — next to the code they constrain.\n`example.yo` is a seed law that already proves green; replace it with laws\nabout your own code. To keep every claim change under human review, add a\n`/spec/ @<maintainer>` line to your CODEOWNERS file.\n"
  )
);
/// Generate the content of `spec/example.yo` — a seed LAW over a
/// contracted callee, so `yo verify ./spec --strict` is green on a fresh
/// project (an empty `spec/` makes the gate error with "no .yo files
/// found"). A template literal: the law source carries no backtick and no
/// `${`.
generate_spec_example_law :: (fn() -> String)(
  `// A seed LAW: a claim stated OUTSIDE the code it is about, proved from
// the callee's CONTRACT (requires/ensures) alone — never from its body.
// It keeps yo verify ./spec --strict green on a fresh project; replace it
// with laws about your own code. The bounds are not decoration: a law
// sees only what the callee's ensures states, so an unbounded
// non-negative cannot be doubled without overflow.
pragma(Pragma.Verify);

absolute :: (
  fn(
    x : i32,
    requires((x > i32(-1000)) && (x < i32(1000))),
    ensures((r >= i32(0)) && (r < i32(1000)))
  ) -> (r : i32)
)(cond((x >= i32(0)) => x, true => -x));

// LAW: doubling an absolute value over the contracted domain stays
// non-negative. The law's own requires discharges absolute's at the call
// site.
doubled_nonneg :: law(
  fn(
    x : i32,
    requires((x > i32(-1000)) && (x < i32(1000))),
    ensures((absolute(x) + absolute(x)) >= i32(0))
  ) -> unit
);
`
);
/// Generate the content of `AGENTS.md` — the agent-facing entry point. Its
/// command block opens with `yo context`, the version-matched language pack,
/// which is what an agent reads before writing Yo.
generate_agents_md :: (fn() -> String)({
  header :=
    `# AGENTS.md

Guidance for AI coding agents working in this project.

This project is written in [Yo](https://github.com/shd101wyy/Yo) — a
programming language that compiles to readable C11. Build, test, and format
it with the yo toolchain:

`;
  fence := String.from("```bash\nyo context       # the language pack + API index — read this first\nyo build run     # build and run the app\nyo build test    # run the test suite\nyo check ./src   # type-check after every edit\nyo verify ./spec --strict   # prove the laws in spec/ (fails on assumed)\nyo fmt           # format the source\n```\n");
  header + fence
});
/// The content of `CLAUDE.md`: Claude Code reads `CLAUDE.md`, not
/// `AGENTS.md`, so the file is one import line that points it at `AGENTS.md`.
generate_claude_md :: (fn() -> String)(String.from("@AGENTS.md\n"));
/// Write `name` into `project_dir` with `content` unless it already exists
/// (an existing file is the user's and is left alone), printing
/// `  create     <name>` when it writes.
_create_agent_file :: (
  fn(
    project_dir : &Path,
    name : String,
    content : String,
    io : Io,
    exn : Exception
  ) -> unit
)({
  file_path := project_dir.join(Path.new(name.clone()));
  file_exists := io.await(exists(file_path.clone(), io), io);
  if(!file_exists, {
    io.await(write_string(&file_path, content, io), IoExn(io : io, exn : exn));
    println(`  create     ${name}`);
  });
});
/// Post-scaffold agent setup, run by `yo init`: write `AGENTS.md` and a
/// one-line `CLAUDE.md` into `project_dir`, each only when it does not
/// already exist. Sync (blocking awaits): called from `run_init` after
/// init_project's future has resolved.
install_agent_files :: (
  fn(
    project_dir : &Path,
    io : Io,
    exn : Exception
  ) -> unit
)({
  _create_agent_file(project_dir, String.from("AGENTS.md"), generate_agents_md(), io, exn);
  _create_agent_file(project_dir, String.from("CLAUDE.md"), generate_claude_md(), io, exn);
});
// ---------------------------------------------------------------------------
// Main init function
// ---------------------------------------------------------------------------
/// Initialise a new Yo project in `options.dir`.
///
/// Skips files that already exist.  Aborts (throws) if `build.yo` already
/// exists to avoid silently overwriting a project.  Resolves to the
/// absolute project directory so `run_init` can run the follow-up agent
/// scaffolding against it.
init_project :: (
  fn(
    sink(options) : InitOptions,
    io : Io,
    exn : Exception
  ) -> Impl(Future(Path, IoExn))
)(
  io.async({ options }(e : IoExn) => {
    // Resolve user CWD (yo-cli overrides this env var when it changes directory)
    user_cwd_str := match(
      env.get(String.from("YO_ORIGINAL_CWD")),
      .Some(d) => d,
      .None => match(
        cwd(),
        .Ok(p) => p.to_string(),
        .Err(_) => String.from(".")
      )
    );
    // Build the absolute project directory path
    project_dir := cond(
      options.dir.starts_with(String.from("/")) => Path.new(&options.dir),
      true => Path.new(&user_cwd_str).join(Path.new(&options.dir))
    );
    // Derive project name
    raw_name := match(
      &options.name,
      .Some(n) => n.clone(),
      .None => match(
        project_dir.file_name(),
        .Some(s) => s,
        .None => String.from("my-project")
      )
    );
    // A name with no letter or digit at all sanitizes to "" — fall back to
    // the same default a root directory gets.
    sanitized := sanitize_project_name(&raw_name);
    project_name := cond(
      (sanitized.len() == usize(0)) => String.from("my-project"),
      true => sanitized
    );
    // Create directory structure
    e.io.await(create_dir_all(&project_dir, e.io), e);
    e.io.await(create_dir_all(project_dir.join(Path.new(String.from("src"))), e.io), e);
    e.io.await(create_dir_all(project_dir.join(Path.new(String.from("tests"))), e.io), e);
    e.io.await(create_dir_all(project_dir.join(Path.new(String.from("spec"))), e.io), e);
    // build.yo — abort if already exists
    build_yo_path := project_dir.join(Path.new(String.from("build.yo")));
    build_yo_exists := e.io.await(exists(&build_yo_path, e.io), e.io);
    cond(
      build_yo_exists => {
        e.exn.throw(dyn(Box.new(`Error: ${build_yo_path.to_string()} already exists. Aborting.`)));
      },
      true => ()
    );
    e.io.await(write_string(&build_yo_path, generate_build_yo(&project_name), e.io), e);
    // yo.toml
    yo_toml_path := project_dir.join(Path.new(String.from("yo.toml")));
    yo_toml_exists := e.io.await(exists(&yo_toml_path, e.io), e.io);
    cond(
      !yo_toml_exists => {
        e.io.await(write_string(&yo_toml_path, generate_yo_toml(&project_name), e.io), e);
      },
      true => ()
    );
    // src/main.yo
    main_path := project_dir.join(Path.new(String.from("src/main.yo")));
    main_exists := e.io.await(exists(&main_path, e.io), e.io);
    cond(
      !main_exists => {
        e.io.await(write_string(&main_path, String.from(generate_main_source()), e.io), e);
      },
      true => ()
    );
    // src/lib.yo
    lib_path := project_dir.join(Path.new(String.from("src/lib.yo")));
    lib_exists := e.io.await(exists(&lib_path, e.io), e.io);
    cond(
      !lib_exists => {
        e.io.await(write_string(&lib_path, String.from(generate_lib_source()), e.io), e);
      },
      true => ()
    );
    // tests/main.test.yo
    test_path := project_dir.join(Path.new(String.from("tests/main.test.yo")));
    test_exists := e.io.await(exists(&test_path, e.io), e.io);
    cond(
      !test_exists => {
        e.io.await(write_string(&test_path, String.from(generate_test_file()), e.io), e);
      },
      true => ()
    );
    // tests/lib.test.yo
    lib_test_path := project_dir.join(Path.new(String.from("tests/lib.test.yo")));
    lib_test_exists := e.io.await(exists(&lib_test_path, e.io), e.io);
    cond(
      !lib_test_exists => {
        e.io.await(write_string(&lib_test_path, generate_lib_test_file(project_name.clone()), e.io), e);
      },
      true => ()
    );
    // spec/README.md + spec/example.yo — the claims wall and a seed law, so
    // the `yo verify ./spec --strict` line AGENTS.md teaches is green (not
    // a "no .yo files found" error) on a fresh project.
    spec_readme_path := project_dir.join(Path.new(String.from("spec/README.md")));
    spec_readme_exists := e.io.await(exists(&spec_readme_path, e.io), e.io);
    cond(
      !spec_readme_exists => {
        e.io.await(write_string(&spec_readme_path, generate_spec_readme(), e.io), e);
      },
      true => ()
    );
    spec_example_path := project_dir.join(Path.new(String.from("spec/example.yo")));
    spec_example_exists := e.io.await(exists(&spec_example_path, e.io), e.io);
    cond(
      !spec_example_exists => {
        e.io.await(write_string(&spec_example_path, generate_spec_example_law(), e.io), e);
      },
      true => ()
    );
    // .gitignore
    gitignore_path := project_dir.join(Path.new(String.from(".gitignore")));
    gitignore_exists := e.io.await(exists(&gitignore_path, e.io), e.io);
    cond(
      !gitignore_exists => {
        e.io.await(write_string(&gitignore_path, String.from(generate_gitignore()), e.io), e);
      },
      true => ()
    );
    // README.md
    readme_path := project_dir.join(Path.new(String.from("README.md")));
    readme_exists := e.io.await(exists(&readme_path, e.io), e.io);
    cond(
      !readme_exists => {
        e.io.await(write_string(&readme_path, generate_readme(&project_name), e.io), e);
      },
      true => ()
    );
    // Success message
    println(`\nInitialized Yo project "${project_name}" in ${project_dir.to_string()}`);
    println(String.from(""));
    println(String.from("  Created:"));
    println(String.from("    yo.toml"));
    println(String.from("    build.yo"));
    println(String.from("    src/main.yo"));
    println(String.from("    src/lib.yo"));
    println(String.from("    tests/main.test.yo"));
    println(String.from("    tests/lib.test.yo"));
    println(String.from("    spec/README.md"));
    println(String.from("    spec/example.yo"));
    println(String.from("    .gitignore"));
    println(String.from("    README.md"));
    println(String.from(""));
    println(String.from("  Get started:"));
    // Echo the directory as the user typed it, but only when it is not already
    // the cwd (`yo init .`).
    cond(
      (project_dir.to_string() != Path.new(user_cwd_str.clone()).to_string()) => {
        println(`    cd ${options.dir}`);
      },
      true => ()
    );
    println(String.from("    yo build run"));
    println(String.from(""));
    project_dir
  })
);
export(
  InitOptions,
  sanitize_project_name,
  generate_build_yo,
  generate_main_source,
  generate_lib_source,
  generate_test_file,
  generate_yo_toml,
  generate_lib_test_file,
  generate_gitignore,
  generate_readme,
  generate_spec_readme,
  generate_spec_example_law,
  generate_agents_md,
  install_agent_files,
  init_project
);
