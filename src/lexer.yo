//! Yo lexer — tokenizes Yo source code into tokens.
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TokenKind, Token, is_operator_char, is_identifier_start, is_identifier_continue } :: import("./token.yo");
{ format_lexer_error } :: import("./error.yo");
// Identifier/operator INTERN table: one canonical String instance per
// distinct token text, so every same-named token shares one buffer and
// downstream `String ==` hits the interned ptr+len fast path
// (std/string/string.yo). Identifier-name compares (env frame scans,
// dispatch conds) are ~38% of a stage2 emit purely from call volume
// (issues/yo-self-compile-performance-rc-string-eq.md). Safe to share:
// token value Strings are never mutated in place (audited 2026-07-27);
// clones fall back to memcmp. The hash+lookup is paid once per TOKEN,
// the savings on every later compare. yo-self-specific divergence: TS
// gets this for free from JS engine string interning.
g_token_intern := HashMap(String, String).new();
intern_token_str :: (fn(s : String) -> String)(
  match(
    g_token_intern.get(s),
    .Some(canonical) => canonical,
    .None => {
      g_token_intern.insert(s, s);
      s
    }
  )
);
/// The CLOSED operator token set (plans/reference/OPERATOR_SET_AND_PRECEDENCE.md).
/// A run of operator characters is split greedily against these two tables
/// (longest match first) instead of becoming one arbitrary token — so
/// `**i32` lexes as `*`,`*`,`i32` (there is no `**` token), and an unknown
/// run is a LEX error instead of a phantom user-operator. The dot family
/// (`.` `..` `..=` `...` `...#`) has its own branch in `tokenize` and never
/// reaches this split. New operators are added HERE, deliberately, like
/// keywords. The retired pointer-arithmetic family (`&+`/`&-`/`&/`,
/// plans/archive/POINTER_OPERATORS_TO_TRAITS_AND_METHODS.md) is NOT in the
/// table — the last writers were migrated to `.add`/`.sub` 2026-08-21, so
/// `p &+ n` now lexes as `p`,`&`,`+`,`n` and fails loudly at parse
/// (mixed adjacent operators need parens).
_is_two_char_operator :: (fn(s : String) -> bool)(
  (s == "!=") || ((s == "&&") || ((s == "->") || ((s == "::") || ((s == ":=") || ((s == "<:") || ((s == "<<") || ((s == "<=") || ((s == "==") || ((s == "=>") || ((s == ">=") || ((s == ">>") || ((s == "?=") || (s == "||")))))))))))))
);
_is_one_char_operator :: (fn(s : String) -> bool)(
  (s == "!") || ((s == "#") || ((s == "%") || ((s == "&") || ((s == "*") || ((s == "+") || ((s == "-") || ((s == "/") || ((s == ":") || ((s == "<") || ((s == "=") || ((s == ">") || ((s == "?") || ((s == "^") || ((s == "|") || (s == "~")))))))))))))))
);
/// An error produced by the lexer during tokenization. Deleted in P1 of
/// plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md: the lexer now throws the same
/// structured `YoError` diagnostic as every other stage (`format_lexer_error`
/// in src/error.yo), so its errors carry the module path, the source line
/// and a 1-based anchor like the parser's and evaluator's do.
/// Tokenizes `input` into a list of `Token`s.
///
/// `module_path` is the source file path included in each token for error reporting.
/// A leading UTF-8 BOM (U+FEFF) is skipped: rows, columns and `character` are as
/// if the file had none (`byte_offset` still counts the 3 BOM bytes in `input`).
/// Throws a structured `YoError` diagnostic (`format_lexer_error`) via `exn`
/// on invalid input.
tokenize :: (
  fn(
    input : String,
    module_path : String,
    exn : Exception
  ) -> ArrayList(Token)
)({
  tokens := ArrayList(Token).new();
  chars := ArrayList(rune).new();
  // `char_byte_offsets(k)` is the BYTE offset in `input` at which `chars(k)`
  // starts. `Token.character` is the rune index `k`, which is NOT a valid
  // index into `input` now that `String` is byte-indexed — every consumer
  // that slices `input` reads `Token.byte_offset` instead
  // (issues/fixed/yo-self-formatter-corrupts-files-with-non-ascii.md).
  // One `char_indices()` pass fills both lists; `chars()` and `char_indices()`
  // stop at the same byte on malformed input, so they stay in lockstep.
  char_byte_offsets := ArrayList(usize).new();
  {
    c_iter := input.char_indices();
    while(true, {
      match(
        c_iter.next(),
        .None => {
          break;
        },
        .Some(pair) => {
          // A leading UTF-8 BOM (EF BB BF) decodes to U+FEFF and would be
          // absorbed into the first identifier/keyword ("Variable
          // '<BOM>open' not found"), so skip it — byte 0 only; elsewhere
          // U+FEFF is an ordinary identifier rune. Windows PowerShell 5.1
          // (`Set-Content -Encoding UTF8`) and several Windows editors emit
          // BOM'd UTF-8 (issues/fixed/lexer-rejects-leading-utf8-bom.md).
          is_leading_bom := ((pair._0 == usize(0)) && (pair._1.char == u32(0xFEFF)));
          if(!is_leading_bom, {
            char_byte_offsets.push(pair._0);
            chars.push(pair._1);
          });
        }
      );
    });
  };
  // One-past-the-end byte offset, so a token that starts at EOF still gets a
  // usable (empty-slice) offset rather than 0.
  input_byte_len := input.len();
  null_rune := rune(u32(0));
  n := chars.len();
  i := usize(0);
  line := usize(0);
  line_start := usize(0);
  while(i < n, {
    c := chars.get(i).unwrap_or(null_rune);
    col := (i - line_start);
    char_idx := i;
    byte_idx := char_byte_offsets.get(i).unwrap_or(input_byte_len);
    next_c := chars.get(i + usize(1)).unwrap_or(null_rune);
    is_fwd_slash := (c.char == u32(0x2F));
    next_is_slash := (next_c.char == u32(0x2F));
    next_is_star := (next_c.char == u32(0x2A));
    is_comment_start := (is_fwd_slash && (next_is_slash || next_is_star));
    cond(
      // Dot: . .. ..=
      (c.char == u32(0x2E)) => {
        j := i;
        dot_sb := StringBuilder.new();
        while(j < n, {
          cj := chars.get(j).unwrap_or(null_rune);
          if(cj.char != u32(0x2E), {
            break;
          });
          dot_sb.write_rune(cj);
          j = (j + usize(1));
        });
        // Check for trailing '=' to form '..=' (inclusive range)
        next_after_dots := chars.get(j).unwrap_or(null_rune);
        if(((j - i) == usize(2)) && (next_after_dots.char == u32(0x3D)), {
          dot_sb.write_rune(next_after_dots);
          j = (j + usize(1));
        });
        // Check for trailing '#' to form '...#' (unquote_splicing).
        // Only the 3-dot form gets the `#` suffix; `..#` is two tokens.
        if(((j - i) == usize(3)) && (next_after_dots.char == u32(0x23)), {
          dot_sb.write_rune(next_after_dots);
          j = (j + usize(1));
        });
        dot_str := dot_sb.to_string();
        kind := cond(((j - i) == usize(1)) => TokenKind.Dot, true => TokenKind.Operator);
        tokens.push(Token(kind : kind, value : dot_str, row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = j;
      },
      // Non-comment operator characters
      (is_operator_char(c) && !is_comment_start) => {
        j := i;
        op_sb := StringBuilder.new();
        while(j < n, {
          cj := chars.get(j).unwrap_or(null_rune);
          is_op_cont := (is_operator_char(cj) && (cj.char != u32(0x2E)));
          if(!is_op_cont, {
            break;
          });
          op_sb.write_rune(cj);
          j = (j + usize(1));
        });
        op_str := op_sb.to_string();
        // Closed-set split (see _is_two_char_operator above): greedy
        // longest-match over the run. Every operator char is ASCII, so one
        // operator char is one byte AND one rune: the same `k` advances
        // `column`, `character` and `byte_offset` alike, and `op_str`'s
        // byte-indexed `slice_copy` cuts exactly `k` chars in.
        (k : usize) = usize(0);
        run_len := op_str.len();
        while(k < run_len, {
          (tok_len : usize) = usize(0);
          if((k + usize(2)) <= run_len, {
            if(_is_two_char_operator(op_str.slice_copy(k .. (k + usize(2)))), {
              tok_len = usize(2);
            });
          });
          if(tok_len == usize(0), {
            if(_is_one_char_operator(op_str.slice_copy(k .. (k + usize(1)))), {
              tok_len = usize(1);
            });
          });
          if(tok_len == usize(0), {
            exn.throw(
              dyn(
                format_lexer_error(
                  module_path,
                  input,
                  line,
                  col + k,
                  `unknown operator in '${op_str}': Yo has a closed operator set (plans/reference/OPERATOR_SET_AND_PRECEDENCE.md); separate the operators with spaces or parentheses`
                )
              )
            );
            break;
          });
          tokens.push(Token(kind : TokenKind.Operator, value : intern_token_str(op_str.slice_copy(k .. (k + tok_len))), row : line, column : (col + k), character : (char_idx + k), byte_offset : (byte_idx + k), module_path : module_path, input : input));
          k = (k + tok_len);
        });
        i = j;
      },
      // Whitespace
      c.is_whitespace() => {
        k := i;
        ws_sb := StringBuilder.new();
        ws_start_ln := line;
        while(k < n, {
          ck := chars.get(k).unwrap_or(null_rune);
          if(!ck.is_whitespace(), {
            break;
          });
          ws_sb.write_rune(ck);
          if(ck.char == u32(0x0A), {
            line = (line + usize(1));
            line_start = (k + usize(1));
          });
          k = (k + usize(1));
        });
        ws_str := ws_sb.to_string();
        tokens.push(Token(kind : TokenKind.Whitespace, value : ws_str, row : ws_start_ln, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = k;
      },
      // Line comment: //, ///, //!
      (is_fwd_slash && next_is_slash) => {
        third_c := chars.get(i + usize(2)).unwrap_or(null_rune);
        fourth_c := chars.get(i + usize(3)).unwrap_or(null_rune);
        (comment_kind : TokenKind) = cond(
          ((third_c.char == u32(0x2F)) && (fourth_c.char != u32(0x2F))) => TokenKind.DocLineComment,
          (third_c.char == u32(0x21)) => TokenKind.InnerDocLineComment,
          true => TokenKind.SingleLineComment
        );
        k := i;
        cm_sb := StringBuilder.new();
        while(k < n, {
          ck := chars.get(k).unwrap_or(null_rune);
          if(ck.char == u32(0x0A), {
            break;
          });
          cm_sb.write_rune(ck);
          k = (k + usize(1));
        });
        cm_str := cm_sb.to_string();
        tokens.push(Token(kind : comment_kind, value : cm_str, row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = k;
      },
      // Block comment: /*, /**, /*!
      (is_fwd_slash && next_is_star) => {
        third_bc := chars.get(i + usize(2)).unwrap_or(null_rune);
        fourth_bc := chars.get(i + usize(3)).unwrap_or(null_rune);
        (block_kind : TokenKind) = cond(
          ((third_bc.char == u32(0x2A)) && (fourth_bc.char != u32(0x2F))) => TokenKind.DocBlockComment,
          (third_bc.char == u32(0x21)) => TokenKind.InnerDocBlockComment,
          true => TokenKind.MultiLineComment
        );
        bc_start_ln := line;
        cm_sb := StringBuilder.new();
        k := i;
        // write opening /*
        cm_sb.write_rune(chars.get(k).unwrap_or(null_rune));
        k = (k + usize(1));
        cm_sb.write_rune(chars.get(k).unwrap_or(null_rune));
        k = (k + usize(1));
        nesting := usize(1);
        while((nesting > usize(0)) && (k < n), {
          ck := chars.get(k).unwrap_or(null_rune);
          next_k := chars.get(k + usize(1)).unwrap_or(null_rune);
          if(ck.char == u32(0x0A), {
            line = (line + usize(1));
            line_start = (k + usize(1));
          });
          is_open := ((ck.char == u32(0x2F)) && (next_k.char == u32(0x2A)));
          is_close := ((ck.char == u32(0x2A)) && (next_k.char == u32(0x2F)));
          cond(
            is_open => {
              nesting = (nesting + usize(1));
              cm_sb.write_str("/*");
              k = (k + usize(2));
            },
            is_close => {
              nesting = (nesting - usize(1));
              cm_sb.write_str("*/");
              k = (k + usize(2));
            },
            true => {
              cm_sb.write_rune(ck);
              k = (k + usize(1));
            }
          );
        });
        if(nesting > usize(0), {
          exn.throw(dyn(format_lexer_error(module_path, input, bc_start_ln, col, `unterminated block comment`)));
        });
        cm_str := cm_sb.to_string();
        tokens.push(Token(kind : block_kind, value : cm_str, row : bc_start_ln, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = k;
      },
      // ( ) [ ] { }
      (c.char == u32(0x28)) => {
        tokens.push(Token(kind : TokenKind.LParen, value : `(`, row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = (i + usize(1));
      },
      (c.char == u32(0x29)) => {
        tokens.push(Token(kind : TokenKind.RParen, value : `)`, row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = (i + usize(1));
      },
      (c.char == u32(0x5B)) => {
        tokens.push(Token(kind : TokenKind.LBracket, value : `[`, row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = (i + usize(1));
      },
      (c.char == u32(0x5D)) => {
        tokens.push(Token(kind : TokenKind.RBracket, value : `]`, row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = (i + usize(1));
      },
      (c.char == u32(0x7B)) => {
        tokens.push(Token(kind : TokenKind.LCurlyBracket, value : `{`, row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = (i + usize(1));
      },
      (c.char == u32(0x7D)) => {
        tokens.push(Token(kind : TokenKind.RCurlyBracket, value : `}`, row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = (i + usize(1));
      },
      // Char literal: '...'
      (c.char == u32(0x27)) => {
        k := (i + usize(1));
        val_sb := StringBuilder.new();
        // TS validity (lexer.ts:324) is UTF-16 CODE-UNIT length:
        // `value.length === 1 || (value.length === 2 && value[0] === "\\")`.
        // Track the UTF-16 length (a rune > U+FFFF counts 2) and whether the
        // first collected char is a backslash. TS has NO separate
        // "unterminated" throw — at EOF the collected value reaches the same
        // validity check (so `'a` at EOF is a VALID char token in both).
        (utf16_len : usize) = usize(0);
        (first_is_backslash : bool) = false;
        val_sb.write_byte(u8(0x27));
        while(k < n, {
          ck := chars.get(k).unwrap_or(null_rune);
          cond(
            (ck.char == u32(0x5C)) => {
              if(utf16_len == usize(0), {
                first_is_backslash = true;
              });
              val_sb.write_rune(ck);
              utf16_len = (utf16_len + usize(1));
              k = (k + usize(1));
              if(k < n, {
                esc := chars.get(k).unwrap_or(null_rune);
                val_sb.write_rune(esc);
                utf16_len = (utf16_len + usize(1));
                if(esc.char > u32(0xFFFF), {
                  utf16_len = (utf16_len + usize(1));
                });
              });
              k = (k + usize(1));
            },
            (ck.char == u32(0x27)) => {
              i = k;
              k = n;
            },
            true => {
              val_sb.write_rune(ck);
              utf16_len = (utf16_len + usize(1));
              if(ck.char > u32(0xFFFF), {
                utf16_len = (utf16_len + usize(1));
              });
              k = (k + usize(1));
            }
          );
        });
        char_is_valid := ((utf16_len == usize(1)) || ((utf16_len == usize(2)) && first_is_backslash));
        if(!char_is_valid, {
          exn.throw(dyn(format_lexer_error(module_path, input, line, col, `invalid char literal: expected char to have length 1`)));
        });
        val_sb.write_byte(u8(0x27));
        tok_val := val_sb.to_string();
        tokens.push(Token(kind : TokenKind.CharLit, value : tok_val, row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = (i + usize(1));
      },
      // String literal: "..."
      (c.char == u32(0x22)) => {
        k := (i + usize(1));
        val_sb := StringBuilder.new();
        val_sb.write_byte(u8(0x22));
        str_closed := false;
        while(k < n, {
          ck := chars.get(k).unwrap_or(null_rune);
          cond(
            (ck.char == u32(0x5C)) => {
              val_sb.write_rune(ck);
              k = (k + usize(1));
              if(k < n, {
                val_sb.write_rune(chars.get(k).unwrap_or(null_rune));
              });
              k = (k + usize(1));
            },
            (ck.char == u32(0x22)) => {
              i = k;
              str_closed = true;
              k = n;
            },
            // A raw line break terminates the scan WITHOUT closing the
            // literal — "" strings cannot span lines. Ending the scan here
            // (instead of swallowing text until some stray quote on a LATER
            // line happens to close it) is what keeps the unterminated
            // error below anchored at the offending line.
            ((ck.char == u32(0x0A)) || (ck.char == u32(0x0D))) => {
              k = n;
            },
            true => {
              val_sb.write_rune(ck);
              k = (k + usize(1));
            }
          );
        });
        // TS has no unterminated-string check — the scan just runs to EOF and
        // the token is pushed with the closing quote appended (lexer.ts:347-
        // 378), and the first confusing token pair then surfaces as a
        // misdirected "Adjacent different operators" / "unexpected token"
        // arbitrarily far from the cause
        // (issues/fixed/multiline-double-quoted-string-parse-error-misleading.md).
        // Yo errors in the lexer, at the literal's opening quote; the message
        // starts with "unterminated " so the P2 classifier stamps
        // E_UNTERMINATED (E0004) and `yo explain` carries the fix guidance.
        if(!str_closed, {
          exn.throw(
            dyn(
              format_lexer_error(
                module_path,
                input,
                line,
                col,
                `unterminated string literal — the line or file ended before the closing quote; use a backtick template for multiline text`
              )
            )
          );
        });
        val_sb.write_byte(u8(0x22));
        tok_val := val_sb.to_string();
        tokens.push(Token(kind : TokenKind.StringLit, value : tok_val, row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = (i + usize(1));
      },
      // Template string: `...`
      (c.char == u32(0x60)) => {
        k := (i + usize(1));
        ts_sb := StringBuilder.new();
        brace_depth := usize(0);
        template_closed := false;
        while(k < n, {
          ck := chars.get(k).unwrap_or(null_rune);
          nck := chars.get(k + usize(1)).unwrap_or(null_rune);
          cond(
            // Unwind sequence
            (ck.char == u32(0x5C)) => {
              cond(
                (nck.char == u32(0x60)) => {
                  ts_sb.write_rune(rune(u32(0x60)));
                  k = (k + usize(2));
                },
                (nck.char == u32(0x24)) => {
                  ts_sb.write_str("\\$");
                  k = (k + usize(2));
                },
                (nck.char == u32(0x6E)) => {
                  ts_sb.write_rune(rune(u32(0x0A)));
                  k = (k + usize(2));
                },
                (nck.char == u32(0x74)) => {
                  ts_sb.write_rune(rune(u32(0x09)));
                  k = (k + usize(2));
                },
                (nck.char == u32(0x72)) => {
                  ts_sb.write_rune(rune(u32(0x0D)));
                  k = (k + usize(2));
                },
                (nck.char == u32(0x5C)) => {
                  ts_sb.write_rune(rune(u32(0x5C)));
                  k = (k + usize(2));
                },
                (nck.char == u32(0x22)) => {
                  ts_sb.write_rune(rune(u32(0x22)));
                  k = (k + usize(2));
                },
                (nck.char == u32(0x27)) => {
                  ts_sb.write_rune(rune(u32(0x27)));
                  k = (k + usize(2));
                },
                (nck.char == u32(0x30)) => {
                  ts_sb.write_rune(rune(u32(0x00)));
                  k = (k + usize(2));
                },
                // \b → backspace (0x08)
                (nck.char == u32(0x62)) => {
                  ts_sb.write_rune(rune(u32(0x08)));
                  k = (k + usize(2));
                },
                // \f → form feed (0x0C)
                (nck.char == u32(0x66)) => {
                  ts_sb.write_rune(rune(u32(0x0C)));
                  k = (k + usize(2));
                },
                // \v → vertical tab (0x0B)
                (nck.char == u32(0x76)) => {
                  ts_sb.write_rune(rune(u32(0x0B)));
                  k = (k + usize(2));
                },
                true => {
                  ts_sb.write_rune(ck);
                  ts_sb.write_rune(nck);
                  k = (k + usize(2));
                }
              );
            },
            // Start of interpolation ${
            ((brace_depth == usize(0)) && (ck.char == u32(0x24)) && (nck.char == u32(0x7B))) => {
              ts_sb.write_str("${");
              brace_depth = usize(1);
              k = (k + usize(2));
            },
            // Inside interpolation: track nested braces
            (brace_depth > usize(0)) => {
              cond(
                (ck.char == u32(0x7B)) => {
                  brace_depth = (brace_depth + usize(1));
                },
                (ck.char == u32(0x7D)) => {
                  brace_depth = (brace_depth - usize(1));
                },
                true => ()
              );
              ts_sb.write_rune(ck);
              k = (k + usize(1));
            },
            // Closing backtick (only outside interpolation)
            (ck.char == u32(0x60)) => {
              i = k;
              template_closed = true;
              k = n;
            },
            // Newline: track line number
            (ck.char == u32(0x0A)) => {
              line = (line + usize(1));
              line_start = (k + usize(1));
              ts_sb.write_rune(ck);
              k = (k + usize(1));
            },
            true => {
              ts_sb.write_rune(ck);
              k = (k + usize(1));
            }
          );
        });
        if(!template_closed, {
          exn.throw(dyn(format_lexer_error(module_path, input, line, col, `unterminated template string`)));
        });
        ts_val := ts_sb.to_string();
        tokens.push(Token(kind : TokenKind.TemplateString, value : ts_val, row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = (i + usize(1));
      },
      // Comma and semicolon
      (c.char == u32(0x2C)) => {
        tokens.push(Token(kind : TokenKind.Comma, value : `,`, row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = (i + usize(1));
      },
      (c.char == u32(0x3B)) => {
        tokens.push(Token(kind : TokenKind.Semicolon, value : `;`, row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = (i + usize(1));
      },
      // Number literals (integer and float)
      c.is_digit() => {
        j := i;
        num_sb := StringBuilder.new();
        num_sb.write_rune(c);
        j = (j + usize(1));
        nd := chars.get(j).unwrap_or(null_rune);
        is_hex := false;
        is_bin := false;
        is_oct := false;
        // Detect base prefix
        if(c.char == u32(0x30), {
          cond(
            ((nd.char == u32(0x78)) || (nd.char == u32(0x58))) => {
              num_sb.write_rune(nd);
              j = (j + usize(1));
              is_hex = true;
            },
            ((nd.char == u32(0x62)) || (nd.char == u32(0x42))) => {
              num_sb.write_rune(nd);
              j = (j + usize(1));
              is_bin = true;
            },
            ((nd.char == u32(0x6F)) || (nd.char == u32(0x4F))) => {
              num_sb.write_rune(nd);
              j = (j + usize(1));
              is_oct = true;
            },
            true => ()
          );
        });
        // Accumulate digits according to base
        cond(
          is_hex => {
            while(j < n, {
              dj := chars.get(j).unwrap_or(null_rune);
              is_hex_d := (dj.is_digit() || ((dj.char >= u32(0x41)) && (dj.char <= u32(0x46))) || ((dj.char >= u32(0x61)) && (dj.char <= u32(0x66))));
              if(!is_hex_d, {
                break;
              });
              num_sb.write_rune(dj);
              j = (j + usize(1));
            });
          },
          is_bin => {
            while(j < n, {
              dj := chars.get(j).unwrap_or(null_rune);
              is_bin_d := ((dj.char == u32(0x30)) || (dj.char == u32(0x31)));
              if(!is_bin_d, {
                break;
              });
              num_sb.write_rune(dj);
              j = (j + usize(1));
            });
          },
          is_oct => {
            while(j < n, {
              dj := chars.get(j).unwrap_or(null_rune);
              is_oct_d := ((dj.char >= u32(0x30)) && (dj.char <= u32(0x37)));
              if(!is_oct_d, {
                break;
              });
              num_sb.write_rune(dj);
              j = (j + usize(1));
            });
          },
          true => {
            while(j < n, {
              dj := chars.get(j).unwrap_or(null_rune);
              is_dec_d := (dj.is_digit() || (dj.char == u32(0x5F)));
              if(!is_dec_d, {
                break;
              });
              num_sb.write_rune(dj);
              j = (j + usize(1));
            });
          }
        );
        is_float := false;
        is_decimal := (!is_hex && (!is_bin && !is_oct));
        // Float: decimal point followed by a digit
        if(is_decimal, {
          dot_check := chars.get(j).unwrap_or(null_rune);
          // NOTE: For parsing case like x.0.0 — the char BEFORE the number
          // start must not be '.' (TS lexer.ts:567 `input[startIndex - 1] !==
          // "."`), so the middle 0 of `x.0.0` stays an Integer and the second
          // dot remains a field access instead of merging into `0.0`.
          prev_is_dot := cond(
            (i == usize(0)) => false,
            true => (chars.get(i - usize(1)).unwrap_or(null_rune).char == u32(0x2E))
          );
          if((dot_check.char == u32(0x2E)) && (prev_is_dot == false), {
            next_j := (j + usize(1));
            next_j_rune := chars.get(next_j).unwrap_or(null_rune);
            if(next_j_rune.is_digit(), {
              is_float = true;
              num_sb.write_rune(dot_check);
              j = next_j;
              while(j < n, {
                dj := chars.get(j).unwrap_or(null_rune);
                is_dec_d := (dj.is_digit() || (dj.char == u32(0x5F)));
                if(!is_dec_d, {
                  break;
                });
                num_sb.write_rune(dj);
                j = (j + usize(1));
              });
            });
          });
        });
        // Exponent: e/E followed by optional +/- and digits
        if(is_decimal, {
          exp_check := chars.get(j).unwrap_or(null_rune);
          if((exp_check.char == u32(0x65)) || (exp_check.char == u32(0x45)), {
            next_j := (j + usize(1));
            next_j_rune := chars.get(next_j).unwrap_or(null_rune);
            has_exp_digits := cond(
              (next_j >= n) => false,
              ((next_j_rune.char == u32(0x2B)) || (next_j_rune.char == u32(0x2D))) => true,
              true => next_j_rune.is_digit()
            );
            // A bare exponent (`1e10`) does NOT make the token a Float: TS
            // consumes the e-notation in the INTEGER branch and still pushes
            // TokenType.Integer (lexer.ts:614-647). Only a decimal point sets
            // is_float.
            if(has_exp_digits, {
              num_sb.write_rune(exp_check);
              j = next_j;
              sign_rune := chars.get(j).unwrap_or(null_rune);
              if((sign_rune.char == u32(0x2B)) || (sign_rune.char == u32(0x2D)), {
                num_sb.write_rune(sign_rune);
                j = (j + usize(1));
              });
              while(j < n, {
                dj := chars.get(j).unwrap_or(null_rune);
                is_dec_d := (dj.is_digit() || (dj.char == u32(0x5F)));
                if(!is_dec_d, {
                  break;
                });
                num_sb.write_rune(dj);
                j = (j + usize(1));
              });
            });
          });
        });
        num_str := num_sb.to_string();
        kind := cond(is_float => TokenKind.Float, true => TokenKind.Integer);
        tokens.push(Token(kind : kind, value : num_str, row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = j;
      },
      // Identifier or Bool keyword
      is_identifier_start(c) => {
        j := i;
        id_sb := StringBuilder.new();
        id_sb.write_rune(c);
        j = (j + usize(1));
        while(j < n, {
          cj := chars.get(j).unwrap_or(null_rune);
          if(!is_identifier_continue(cj), {
            break;
          });
          id_sb.write_rune(cj);
          j = (j + usize(1));
        });
        id_str := id_sb.to_string();
        // RESERVED for Dafny-style verification quantifiers
        // (plans/archive/FORALL_TO_GENERIC.md). The type-parameter binder was renamed
        // `forall` -> `generic`; the word is held back so `requires` /
        // `ensures` can bind VALUES with a predicate later. Rejected at lex
        // time — mirrors src/lexer.ts, and parser parity across the two
        // frontends is a STRICT_FIXPOINT prerequisite.
        //
        // `exists` / `∃` are deliberately NOT reserved — `exists` is a live
        // public API (`std/fs/file.yo:324`, used in 72 files).
        if((id_str == `forall`) || (id_str == `∀`), {
          exn.throw(
            dyn(
              format_lexer_error(
                module_path,
                input,
                line,
                col,
                `\`${id_str}\` is reserved for verification quantifiers. Use \`generic(T : Type)\` to declare type parameters.`
              )
            )
          );
        });
        kind := cond(
          (id_str == `true`) => TokenKind.Bool,
          (id_str == `false`) => TokenKind.Bool,
          true => TokenKind.Identifier
        );
        tokens.push(Token(kind : kind, value : intern_token_str(id_str), row : line, column : col, character : char_idx, byte_offset : byte_idx, module_path : module_path, input : input));
        i = j;
      },
      // Unknown character: error
      true => {
        exn.throw(dyn(format_lexer_error(module_path, input, line, col, `unexpected character`)));
        i = (i + usize(1));
      }
    );
  });
  tokens
});
// _is_two_char_operator is exported for the formatter: with the closed
// operator set, two adjacent operator tokens re-lex differently ONLY when
// their concatenation is in this table, so the formatter's prefix-chain
// tightening (`?*i32`, `**i32`) consults it instead of assuming every
// operator pair would merge (the retired maximal-munch behavior).
export(tokenize, _is_two_char_operator);
