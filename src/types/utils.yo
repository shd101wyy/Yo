export(type_contains_some_type_deep);
export(type_mentions_impl_fn_or_future, is_future_value_type);
export(fn_type_unrepresentable_impl, fn_type_unrepresentable_impl_message, fn_type_unrepresentable_impl_help);
export(get_size_of_type, get_alignment_of_type);
export(type_representation_contains_raw_ptr, parameter_type_contains_raw_ptr, type_may_provide_slice_source);
/// Does `ty` mention a trait's `Self` (a SomeT named `Self`)?
_mentions_trait_self :: (fn(ty : &TypeValue) -> bool)({
  somes := get_all_some_types(ty);
  (i : usize) = usize(0);
  while(i < somes.len(), {
    if(match(somes.get_cloned(i), .Some(s) => match(s, Rc(.SomeT({ name : n })) => (n == "Self"), _ => false), .None => false), {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
/// Is the trait member `member_ty` a METHOD: a function whose first parameter
/// is `self`? Only methods are reached through a `Dyn` receiver.
dyn_member_is_method :: (fn(member_ty : &TypeValue) -> bool)(
  match(
    member_ty,
    Rc(.Func({ meta : m })) => match(m.param_labels.get(usize(0)), .Some(l) => (l == "self"), .None => false),
    _ => false
  )
);
/// Why the trait method `member_ty` cannot be called through a `Dyn` receiver,
/// or `.None` when it can. A `Dyn` erases the concrete type, so `Self` may
/// appear only as the receiver: a `Self` parameter or result has no single C
/// type at the call. A method with `generic(...)` binders has no single function
/// to put in the vtable. Codegen gives a vtable slot exactly to the methods
/// this accepts, and the evaluator rejects a call to any other with E0614
/// (plans/backlog/TYPE_SYSTEM_SOUNDNESS.md Phase 2.7, docs/en-US/DYN_DESIGN.md).
dyn_member_unsafe_reason :: (fn(member_ty : &TypeValue) -> Option(String))(
  match(
    member_ty,
    Rc(.Func({ forall_types : fts, param_types : pts, result : res, meta : m })) => {
      if(fts.len() > usize(0), {
        return(Option(String).Some(String.from("it takes generic(...) parameters, so there is no single function to put in the vtable")));
      });
      labels := Rc.clone(m.param_labels);
      (i : usize) = usize(1);
      while(i < pts.len(), {
        pt := match(pts.get(i), .Some(t) => t_slot_pointee(&t), .None => Rc.new(TypeValueNode.Unit));
        if(_mentions_trait_self(&pt), {
          label := match(labels.get_cloned(i), .Some(l) => l, .None => String.from("?"));
          return(Option(String).Some(`its parameter "${label}" has type ${type_to_string(&pt)}, which the Dyn erases`));
        });
        i = (i + usize(1));
      });
      if(_mentions_trait_self(&t_slot_pointee(&res)), {
        return(Option(String).Some(`it returns ${type_to_string(&t_slot_pointee(&res))}, which the Dyn erases`));
      });
      Option(String).None
    },
    _ => Option(String).None
  )
);
/// Does `dyn_ty` have a vtable slot named `name`: a method of one of its traits
/// that `dyn_member_unsafe_reason` accepts, or `call` for an `Fn` trait? A
/// method call on a `Dyn` receiver that names no slot is an ordinary call to a
/// method the evaluator resolved elsewhere (a blanket inherent method), not a
/// vtable dispatch.
dyn_type_has_vtable_slot :: (fn(dyn_ty : &TypeValue, name : &String) -> bool)(
  match(
    dyn_ty,
    Rc(.DynT({ required_trait_types : rtt })) => {
      (i : usize) = usize(0);
      while(i < rtt.len(), {
        tt := match(rtt.get(i), .Some(t) => t, .None => Rc.new(TypeValueNode.Unit));
        i = (i + usize(1));
        hit := match(
          tt,
          Rc(.FnTraitT(_, _, _, _, _, _)) => (name == "call"),
          Rc(.TraitT({ body : fls_body })) => {
            fls := fls_body.field_labels();
            fts := fls_body.field_types();
            (found : bool) = false;
            (j : usize) = usize(0);
            while((j < fls.len()) && !found, {
              if(match(fls.get_cloned(j), .Some(l) => (l == name), .None => false), {
                ft := match(fts.get_cloned(j), .Some(t) => t, .None => Rc.new(TypeValueNode.Unit));
                found = (dyn_member_is_method(&ft) && dyn_member_unsafe_reason(&ft).is_none());
              });
              j = (j + usize(1));
            });
            found
          },
          _ => false
        );
        if(hit, {
          return(true);
        });
      });
      false
    },
    _ => false
  )
);
/// The Dyn a method DISPATCH runs over, when `t` is a dispatchable receiver
/// shape: the Dyn place itself, or one `Reference` level over it (decision 49:
/// a named `(d : &Dyn(T)) = dyn(&c)` local records its type as the reference,
/// while a `&Dyn` parameter records the pointee — both dispatch through the
/// same vtable). Deliberately does NOT unwrap a `Box(Dyn)`/counted cell: a box
/// receiver's own methods (`clone`) are the box's, not the payload's — the
/// registration-shaped wide unwrap lives in the codegen collector.
dyn_dispatch_receiver_type :: (fn(t : &TypeValue) -> Option(TypeValue))({
  if(is_dyn_type(t), {
    return(Option(TypeValue).Some(Rc.clone(t)));
  });
  match(
    t_refine_inner(t),
    Rc(.Reference(pointee, _, _)) => if(is_dyn_type(&pointee), Option(TypeValue).Some(Rc.clone(pointee)), Option(TypeValue).None),
    _ => Option(TypeValue).None
  )
});
/// True when the vtable slot `name` of `dyn_ty` is a projection method
/// (`-> &T`, decision 24): the slot returns its place's address.
dyn_vtable_slot_result_is_ref :: (fn(dyn_ty : &TypeValue, name : &String) -> bool)(
  match(
    dyn_ty,
    Rc(.DynT({ required_trait_types : rtt })) => {
      (i : usize) = usize(0);
      while(i < rtt.len(), {
        match(
          rtt.get(i),
          .Some(Rc(.TraitT({ body : fls_body }))) => {
            fls := fls_body.field_labels();
            fts := fls_body.field_types();
            (j : usize) = usize(0);
            while(j < fls.len(), {
              if(match(fls.get_cloned(j), .Some(l) => (l == name), .None => false), {
                ft := match(fts.get_cloned(j), .Some(t) => t, .None => Rc.new(TypeValueNode.Unit));
                return(dyn_member_is_method(&ft) && dyn_member_unsafe_reason(&ft).is_none() && fn_result_is_ref(&ft));
              });
              j = (j + usize(1));
            });
          },
          _ => ()
        );
        i = (i + usize(1));
      });
      false
    },
    _ => false
  )
);
/// The per-parameter pointer flags of the vtable slot `name` of `dyn_ty`
/// (a `&mut T` parameter, and a projection's `&T` one),
/// indexed like a method call's runtime arguments: `[receiver, explicit...]`
/// (an Fn `call` slot has no receiver parameter, so its flag 0 is `false`).
/// Empty when `dyn_ty` has no such slot.
dyn_vtable_slot_param_is_ref :: (fn(dyn_ty : &TypeValue, name : &String) -> ArrayList(bool))({
  out := ArrayList(bool).new();
  match(
    dyn_ty,
    Rc(.DynT({ required_trait_types : rtt })) => {
      (i : usize) = usize(0);
      while((i < rtt.len()) && out.is_empty(), {
        tt := match(rtt.get(i), .Some(t) => t, .None => Rc.new(TypeValueNode.Unit));
        i = (i + usize(1));
        match(
          tt,
          Rc(.FnTraitT({ call_param_labels : cpl, call_param_types : cpts })) => if(name == "call", {
            out.push(false);
            (k : usize) = usize(0);
            while(k < cpl.len(), {
              out.push(match(cpts.get(k), .Some(cs) => t_slot_is_mut_ref(&cs), .None => false));
              k = (k + usize(1));
            });
          }),
          Rc(.TraitT({ body : fls_body })) => {
            fls := fls_body.field_labels();
            fts := fls_body.field_types();
            (j : usize) = usize(0);
            while((j < fls.len()) && out.is_empty(), {
              if(match(fls.get_cloned(j), .Some(l) => (l == name), .None => false), {
                ft := match(fts.get_cloned(j), .Some(t) => t, .None => Rc.new(TypeValueNode.Unit));
                if(dyn_member_is_method(&ft) && dyn_member_unsafe_reason(&ft).is_none(), {
                  match(
                    &ft,
                    Rc(.Func({ param_types : fpts })) => {
                      (k : usize) = usize(0);
                      while(k < fpts.len(), {
                        // A projection's `&T` parameter is a pointer too
                        // (decision 34, `fn_param_is_ptr_borrow`).
                        out.push(match(fpts.get(k), .Some(fs) => t_slot_is_mut_ref(&fs), .None => false) || fn_param_is_ptr_borrow(&ft, k));
                        k = (k + usize(1));
                      });
                    },
                    _ => ()
                  );
                });
              });
              j = (j + usize(1));
            });
          },
          _ => ()
        );
      });
    },
    _ => ()
  );
  out
});
/// The note a type mismatch appends when a `Dyn` with more traits is given
/// where one with a subset is expected (`Dyn(Sp, Ot)` for `Dyn(Sp)`): flow
/// never converts a `Dyn`, and the explicit conversion is `upcast`
/// (plans/backlog/TYPE_SYSTEM_SOUNDNESS.md Phases 2.7 and 2.8,
/// docs/en-US/DYN_DESIGN.md). Empty for every other pair.
dyn_upcast_note :: (fn(expected : &TypeValue, given : &TypeValue) -> String)(
  match(
    expected,
    Rc(.DynT({ required_trait_types : ert })) => match(
      given,
      Rc(.DynT({ required_trait_types : grt })) => {
        (all_in : bool) = (ert.len() < grt.len());
        (i : usize) = usize(0);
        while((i < ert.len()) && all_in, {
          es := type_to_string(match(ert.get(i), .Some(t) => t, .None => Rc.new(TypeValueNode.Unit)));
          (hit : bool) = false;
          (j : usize) = usize(0);
          while((j < grt.len()) && !hit, {
            hit = (type_to_string(match(grt.get(j), .Some(t) => t, .None => Rc.new(TypeValueNode.Unit))) == es);
            j = (j + usize(1));
          });
          all_in = hit;
          i = (i + usize(1));
        });
        if(all_in, String.from("\nA Dyn value is not converted to a Dyn with fewer traits implicitly: write upcast(value, Dyn(...)) to drop the extra traits."), String.new())
      },
      _ => String.new()
    ),
    _ => String.new()
  )
);
/// A `Dyn` whose trait set carries a closure trait (`Dyn(Fn(...))`,
/// `Dyn(FnOnce(...), Send)`).
_dyn_carries_fn_trait :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.DynT({ required_trait_types : dct_rtt })) => {
      (i : usize) = usize(0);
      while(i < dct_rtt.len(), i = (i + usize(1)), {
        if(match(dct_rtt.get(i), .Some(dct_t) => match(dct_t, Rc(.FnTraitT(base_name : _)) => true, _ => false), .None => false), {
          return(true);
        });
      });
      false
    },
    _ => false
  )
);
/// A callable that is not a `Dyn`: a named `fn` (a `Func`), a closure's
/// capture struct, or an `Impl(Fn(...))` / `where(F <: Fn(...))` type, whose
/// own trait list or resolution chain reaches one of those.
_is_unerased_callable :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.Func({ result : _ })) => true,
    Rc(.SomeT({ bounds : uc_rtt_bnd })) => {
      uc_rtt := uc_rtt_bnd.required();
      (i : usize) = usize(0);
      while(i < uc_rtt.len(), i = (i + usize(1)), {
        if(match(uc_rtt.get_cloned(i), .Some(uc_t) => match(uc_t, Rc(.FnTraitT(base_name : _)) => true, _ => false), .None => false), {
          return(true);
        });
      });
      uc_term := resolve_cell_chain(t);
      match(&uc_term, Rc(.Func({ result : _ })) => true, _ => is_closure_capture_struct(&uc_term))
    },
    _ => is_closure_capture_struct(t)
  )
);
/// Decision 44 (plans/VALUES_BY_DEFAULT.md): every erasure into a `Dyn` is
/// spelled. A callable that is not already a `Dyn` (a named closure, a named
/// `fn`, an `Impl(Fn(...))` parameter) flowing into a `Dyn(Fn(...))` slot is
/// written `dyn(f)`; a bare `f` there is E0618. `Impl(Fn(...))` slots are
/// not erasures and are untouched.
is_bare_callable_into_dyn_fn :: (fn(expected : &TypeValue, given : &TypeValue) -> bool)(
  _dyn_carries_fn_trait(expected) && !is_dyn_type(given) && _is_unerased_callable(given)
);
/// The declaration id of a struct / enum / union, for the note below.
_decl_id_of :: (fn(t : &TypeValue) -> String)(
  match(
    t,
    Rc(.Struct({ id : sid })) => sid.clone(),
    Rc(.EnumT(eid, _, _, _, _, _, _, _, _, _)) => eid.clone(),
    Rc(.Union(uname, _, _)) => uname.clone(),
    _ => String.new()
  )
);
/// The note a type mismatch appends when the two types PRINT the same but are
/// different declarations — two modules' `P`, say: `Expected: "P"`, `Given:
/// "P"` alone reads as a compiler bug (plans/reference/TYPE_IDENTITY.md).
/// Names each side's declaring module; empty when the spellings differ.
same_name_note :: (fn(expected : &TypeValue, given : &TypeValue) -> String)({
  if(type_to_string(expected) != type_to_string(given), {
    return(String.new());
  });
  e_mod := match(type_decl_module(_decl_id_of(expected)), .Some(m) => m, .None => String.new());
  g_mod := match(type_decl_module(_decl_id_of(given)), .Some(m) => m, .None => String.new());
  cond(
    ((e_mod.len() > usize(0)) && (g_mod.len() > usize(0)) && (e_mod != g_mod)) =>
      `\nThese are two different types with the same name: the expected one is declared in ${e_mod}, the given one in ${g_mod}.`,
    true => String.from("\nThese are two different declarations with the same name.")
  )
});
/// `No field "xx" on P. Its fields: x, y.` with a did-you-mean: the E0406
/// message for a field read, a destructuring label and a pattern label.
unknown_field_message :: (fn(label : &String, base_ty : &TypeValue, fields : &ArrayList(String)) -> String)({
  list := String.new();
  (fi : usize) = usize(0);
  while(fi < fields.len(), {
    if(fi > usize(0), {
      list.push_str(", ");
    });
    list.push_string(match(fields.get_cloned(fi), .Some(f) => f, .None => String.new()));
    fi = (fi + usize(1));
  });
  // A module is a source-namespace struct: name what it exports, not its
  // whole struct type.
  is_module := is_module_type(base_ty);
  fields_note := cond(
    ((fields.len() == usize(0)) && is_module) => String.from(" It exports nothing."),
    (fields.len() == usize(0)) => String.from(" It has no fields."),
    is_module => ` Its members: ${list}.`,
    true => ` Its fields: ${list}.`
  );
  hint := match(suggest_name(label.clone(), fields), .Some(near) => `\nDid you mean "${near}"?`, .None => String.new());
  cond(
    is_module => `No member "${label}" in the module.${fields_note}${hint}`,
    true => `No field "${label}" on ${type_to_string(base_ty)}.${fields_note}${hint}`
  )
});
/// The code of `unknown_field_message`'s error: E0403 when the base is a
/// module (it does not export the name), E0406 otherwise.
unknown_field_code :: (fn(base_ty : &TypeValue) -> str)(
  cond(is_module_type(base_ty) => E_MODULE_FIELD_NOT_FOUND, true => E_FIELD_NOT_FOUND)
);
/// The sentence E0406/E0610 add when auto-dereference also misses
/// (plans/VALUES_BY_DEFAULT.md §3.3): `` `b` is an Rc(P); its payload P has
/// no field "x" either.`` — `payload_ty` is the innermost payload the
/// auto-dereference reached, `what` is `field` or `field or method`.
deref_miss_note :: (fn(wrapper_text : &String, wrapper_ty : &TypeValue, payload_ty : &TypeValue, what : str, label : &String) -> String)(
  `\`${wrapper_text}\` is a ${type_to_string(wrapper_ty)}; its payload ${type_to_string(payload_ty)} has no ${what} "${label}" either.`
);
/// E0406 for a field read that auto-dereference also misses: the wrapper has
/// no field `label`, and neither has its payload (`payload_fields`).
unknown_field_through_deref_message :: (
  fn(label : &String, wrapper_text : &String, wrapper_ty : &TypeValue, payload_ty : &TypeValue, payload_fields : &ArrayList(String)) -> String
)({
  list := String.new();
  (fi : usize) = usize(0);
  while(fi < payload_fields.len(), {
    if(fi > usize(0), {
      list.push_str(", ");
    });
    list.push_string(match(payload_fields.get_cloned(fi), .Some(f) => f, .None => String.new()));
    fi = (fi + usize(1));
  });
  fields_note := cond(
    (payload_fields.len() == usize(0)) => ` ${type_to_string(payload_ty)} has no fields.`,
    true => ` ${type_to_string(payload_ty)}'s fields: ${list}.`
  );
  hint := match(suggest_name(label.clone(), payload_fields), .Some(near) => `\nDid you mean "${near}"?`, .None => String.new());
  `No field "${label}" on ${type_to_string(wrapper_ty)}. ${deref_miss_note(wrapper_text, wrapper_ty, payload_ty, "field", label)}${fields_note}${hint}`
});
/// `Enum variant "Purple" not found in enum Color. Its variants: Red, Green.`
/// — the E0402 message names the enum and what it has.
unknown_variant_message :: (fn(variant : &String, enum_ty : &TypeValue, variants : &ArrayList(String)) -> String)({
  list := String.new();
  (vi : usize) = usize(0);
  while(vi < variants.len(), {
    if(vi > usize(0), {
      list.push_str(", ");
    });
    list.push_string(match(variants.get_cloned(vi), .Some(v) => v, .None => String.new()));
    vi = (vi + usize(1));
  });
  `Enum variant "${variant}" not found in enum ${type_to_string(enum_ty)}. Its variants: ${list}.`
});
export(dyn_member_is_method, dyn_member_unsafe_reason, dyn_type_has_vtable_slot, dyn_dispatch_receiver_type, dyn_vtable_slot_param_is_ref, dyn_vtable_slot_result_is_ref, dyn_upcast_note, is_bare_callable_into_dyn_fn, same_name_note, unknown_field_message, unknown_field_code, unknown_variant_message, control_bound_field_message);
export(deref_miss_note, unknown_field_through_deref_message);
/// `err` with its primary diagnostic marked `generic_independent` when
/// neither `a` nor `b` contains a type variable: a mismatch between two such
/// types holds under every instantiation of an enclosing generic, so a
/// definition-time trial re-raises it instead of swallowing it
/// (plans/backlog/TYPE_SYSTEM_SOUNDNESS.md Phase 6 step 2). `err` unchanged otherwise.
/// Does `ty` depend on a generic through a VALUE rather than a type
/// variable — an array whose length is an unresolved expression
/// (`Array(u8, T.BYTES)` keeps `T.BYTES` in `length_var`)? `get_all_some_types`
/// does not see those. Depth-limited like the other structural walkers here.
_type_mentions_generic_length :: (fn(ty : &TypeValue, depth : u32) -> bool)(
  cond(
    (depth > u32(16)) => false,
    true => match(
      ty,
      Rc(.SliceT(el)) => _type_mentions_generic_length(&el, depth + u32(1)),
      Rc(.Array(element : el, length : _, length_var : lv)) => ((lv.len() > usize(0)) || _type_mentions_generic_length(&el, depth + u32(1))),
      Rc(.Pointer(pointee : p)) => _type_mentions_generic_length(&p, depth + u32(1)),
      Rc(.Reference(pointee : rp)) => _type_mentions_generic_length(&rp, depth + u32(1)),
      Rc(.ValueSlot(vs_inner)) => _type_mentions_generic_length(&vs_inner, depth + u32(1)),
      Rc(.Tuple(_, fts)) => _any_mentions_generic_length(&fts.items, depth),
      Rc(.Struct({ field_types : sfts })) => _any_mentions_generic_length(&sfts.items, depth),
      Rc(.TypeAppT(_, args)) => _any_mentions_generic_length(&args.items, depth),
      Rc(.Func({ param_types : pts, result : r })) => (_any_mentions_generic_length(&pts.items, depth) || _type_mentions_generic_length(&r, depth + u32(1))),
      _ => false
    )
  )
);
_any_mentions_generic_length :: (fn(tys : &ArrayList(TypeValue), depth : u32) -> bool)({
  (i : usize) = usize(0);
  while(i < tys.len(), {
    if(match(tys.get_cloned(i), .Some(t) => _type_mentions_generic_length(&t, depth + u32(1)), .None => false), {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
mark_generic_independent :: (fn(err : &YoError, a : &TypeValue, b : &TypeValue) -> YoError)({
  if((get_all_some_types(a).len() > usize(0)) || (get_all_some_types(b).len() > usize(0)), {
    return(err);
  });
  if(_type_mentions_generic_length(a, u32(0)) || _type_mentions_generic_length(b, u32(0)), {
    return(err);
  });
  // `unit` on either side is not evidence: it is the evaluator's stand-in
  // for a sub-evaluation that degraded (a failed lookup's `t_unit()`
  // fallback) inside a generic body, and the trial cannot tell it from a
  // real `()` (issues/generic-trial-degrades-a-failed-evaluation-to-unit.md).
  if(match(a, Rc(.Unit) => true, _ => false) || match(b, Rc(.Unit) => true, _ => false), {
    return(err);
  });
  entries := ArrayList(Diagnostic).new();
  (i : usize) = usize(0);
  while(i < err.diagnostics.len(), {
    match(
      err.diagnostics.get_cloned(i),
      .Some(d) => entries.push(
        cond(
          (i == usize(0)) => Diagnostic(
            code : d.code.clone(),
            severity : d.severity,
            message : d.message.clone(),
            span : d.span.clone(),
            source_line : d.source_line.clone(),
            help : d.help.clone(),
            repair : d.repair.clone(),
            generic_independent : true
          ),
          true => d
        )
      ),
      .None => ()
    );
    i = (i + usize(1));
  });
  YoError(diagnostics : entries)
});
export(mark_generic_independent);
/// The result slot `r` may point into a `&T` parameter: a borrow, or a
/// type that carries an origin (`fn_param_is_ptr_borrow`). A borrowing
/// future is not one: its origin names the caller's places, which the state
/// machine holds through the lent arguments' own pointers
/// (`_lent_param_capture_fields`), so its function's `&T` parameters keep the
/// by-value ABI (decision 43 step 4, VERDICTS-18 §B: codegen unchanged).
_result_may_point_into_params :: (fn(r : &TypeValue) -> bool)(t_slot_is_borrow(r) || (type_carries_origin(r) && !is_future_value_type(r)));
/// A parameter of the slots `pts` may store a `&T` argument past the call:
/// its value type (a reference slot's pointee) carries an origin — a `&mut
/// ArrayList(&U)`, a by-value `Box(&mut ArrayList(&U))`, a
/// `&RefCell(ArrayList(&U))` — which are the stores O3-3 admits
/// (VERDICTS-23 R2). `fn_param_is_ptr_borrow`.
_params_may_store_a_reference :: (fn(pts : &SharedList(TypeValue)) -> bool)({
  (i : usize) = usize(0);
  while(i < pts.len(), {
    if(match(pts.get(i), .Some(s) => type_carries_origin(&t_slot_pointee(&s)), .None => false), {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
/// Decision 34's ABI choice, taken for decision 24's projections: a `&T`
/// parameter that may outlive the call is passed as a pointer; every other
/// `&T` parameter is passed by value, since a copy of the argument dies
/// with the call. It may outlive the call when the result may point into it
/// — a borrow (`-> &T` / `-> &mut T`) or a type that carries an origin
/// (`-> Option(&T)`, a holder: decision 43 step 3) — or when a parameter
/// may store it: a parameter's value type carries an origin, the slot's
/// own included (VERDICTS-23 R2). Parameter `i` of `fn_ty` is such a
/// pointer-passed shared borrow (`&mut T` parameters are pointers anyway,
/// and a by-value parameter is never one).
///
/// A `&T` of an UNSIZED `T` (decision 49) is always pointer-passed: there
/// is no value of `T` to copy, so the argument is the fat pointer itself.
/// A pointer to `t` is fat (decision 49): `t` is unsized and concrete. A
/// `&Dyn` slot stays by value (the Dyn's fat struct is already what the
/// callee reads; VERDICTS-40 amendment 5 lowers a pointer to a `Dyn` as that
/// struct, `pointer_c_type_string`). A
/// `?Sized` variable is decided per specialization, where it is bound; the
/// generic definition's slot keeps the thin ABI its sized instances use.
_pointee_is_fat :: (fn(t : &TypeValue) -> bool)(!type_is_sized(t) && !type_contains_some_type(t));
fn_param_is_ptr_borrow :: (fn(fn_ty : &TypeValue, i : usize) -> bool)(
  match(
    fn_ty,
    Rc(.Func({ param_types : pb_pts, result : pb_r })) => match(
      pb_pts.get(i),
      .Some(pb_s) => (
        t_slot_is_borrow(&pb_s) && !t_slot_is_mut_ref(&pb_s) && (_pointee_is_fat(&t_slot_pointee(&pb_s)) || _result_may_point_into_params(&pb_r) || _params_may_store_a_reference(&pb_pts))
      ),
      .None => false
    ),
    // A closure trait returning a reference (`Fn(s : &T) -> &U`, decision
    // 43 step 2, N1c) has the projection's ABI too.
    Rc(.FnTraitT({ call_param_types : pb_cpts, call_result : pb_cr })) => match(
      pb_cpts.get(i),
      .Some(pb_cs) => (
        t_slot_is_borrow(&pb_cs) && !t_slot_is_mut_ref(&pb_cs) && (_pointee_is_fat(&t_slot_pointee(&pb_cs)) || _result_may_point_into_params(&pb_cr) || _params_may_store_a_reference(&pb_cpts))
      ),
      .None => false
    ),
    _ => false
  )
);
/// The per-parameter C-ABI pointer flags of `fn_ty`: a `&mut T` slot or
/// `fn_param_is_ptr_borrow`. Only the lowering reads it (the prototype, the
/// argument `&`, the casts); every rule about writes and exclusivity reads
/// the `&mut T` slot alone.
fn_abi_param_is_ptr :: (fn(fn_ty : &TypeValue) -> ArrayList(bool))({
  out := ArrayList(bool).new();
  match(
    fn_ty,
    Rc(.Func({ param_types : ap_pts })) => {
      (i : usize) = usize(0);
      while(i < ap_pts.len(), {
        out.push(match(ap_pts.get(i), .Some(ap_s) => t_slot_is_mut_ref(&ap_s), .None => false) || fn_param_is_ptr_borrow(fn_ty, i));
        i = (i + usize(1));
      });
    },
    Rc(.FnTraitT({ call_param_types : ap_cpts })) => {
      (j : usize) = usize(0);
      while(j < ap_cpts.len(), {
        out.push(match(ap_cpts.get(j), .Some(ap_cs) => t_slot_is_mut_ref(&ap_cs), .None => false) || fn_param_is_ptr_borrow(fn_ty, j));
        j = (j + usize(1));
      });
    },
    _ => ()
  );
  out
});
export(fn_param_is_ptr_borrow, fn_abi_param_is_ptr);
/// The `Fn(...)` trait a closure-typed value carries: the trait itself, the
/// `Fn` a `Dyn` lists, or a type variable's `Fn` bound, through its
/// resolution chain (cycles stop the walk).
closure_fn_trait_of :: (fn(ty : &TypeValue) -> Option(TypeValue))({
  (cur : TypeValue) = ty.clone();
  seen := ArrayList(String).new();
  while(true, {
    match(
      Rc.clone(cur),
      Rc(.FnTraitT(base_name : _)) => return(Option(TypeValue).Some(Rc.clone(cur))),
      Rc(.DynT({ required_trait_types : cft_drtt })) => return(_first_fn_trait(&cft_drtt.items)),
      Rc(.SomeT({ id : cft_id, bounds : cft_rtt_bnd, resolution : cft_res })) => {
        cft_rtt := cft_rtt_bnd.required();
        match(_first_fn_trait(&cft_rtt), .Some(t) => return(Option(TypeValue).Some(t)), .None => ());
        (cft_i : usize) = usize(0);
        while(cft_i < seen.len(), {
          if(match(seen.get_cloned(cft_i), .Some(s) => (s == cft_id), .None => false), {
            return(Option(TypeValue).None);
          });
          cft_i = (cft_i + usize(1));
        });
        seen.push(cft_id.clone());
        match(
          cft_res,
          .Some(n) => {
            cur = Rc.clone(n);
          },
          .None => return(Option(TypeValue).None)
        );
      },
      _ => return(Option(TypeValue).None)
    );
  });
  Option(TypeValue).None
});
_first_fn_trait :: (fn(ts : &ArrayList(TypeValue)) -> Option(TypeValue))({
  (i : usize) = usize(0);
  while(i < ts.len(), {
    match(ts.get_cloned(i), .Some(t) => if(is_fn_trait_type(&t), return(Option(TypeValue).Some(t))), .None => ());
    i = (i + usize(1));
  });
  Option(TypeValue).None
});
/// The call type of a value typed by a closure trait (`Impl(Fn(...))`,
/// `Dyn(Fn(...))`, a type variable bounded by `Fn`): a `Func` with the
/// trait's parameter and result slots, so a `Fn(...) -> &T` value is called
/// as a projection is (decision 43 step 2, N1c). `.None` for anything else.
fn_trait_call_func_type :: (fn(ty : &TypeValue) -> Option(TypeValue))(
  match(
    closure_fn_trait_of(ty),
    .Some(Rc(.FnTraitT({ call_param_labels : fcf_l, call_param_types : fcf_p, call_result : fcf_r }))) => Option(TypeValue).Some(
      Rc.new(
        TypeValueNode.Func(
          no_types(),
          Rc.clone(fcf_p),
          no_types(),
          no_types(),
          Rc.clone(fcf_r),
          Rc.new(
            FuncMeta(
              forall_labels : no_labels(),
              param_labels : Rc.clone(fcf_l),
              implicit_labels : no_labels(),
              result_is_comptime_only : false,
              has_variadic : false,
              is_extern : Option(String).None,
              extern_name : Option(String).None,
              is_control : false,
              variadic_label : Option(String).None,
              variadic_comptime : false
            )
          ),
          no_types()
        )
      )
    ),
    _ => Option(TypeValue).None
  )
);
/// `ty` is a closure TYPED `FnMut(...)` (decision 37, N1f): its trait says
/// so (an `Impl(FnMut(...))` value, a `Dyn(FnMut(...))`, a type variable
/// bounded by `FnMut`), or its capture record is a typed `FnMut` closure's.
/// Its call is a `&mut self` receiver call. A closure that is `FnMut` only by
/// its `&mut` captures (`capture_struct_is_fnmut`) never reaches an `Fn(...)`
/// slot: that is E0913 (`judge_capture_fnmut_at_fn_slot`, decision 43 N3).
///
/// The trait a slot gives the value decides first: an `FnMut` closure moved
/// into an `Impl(FnOnce(...))` parameter is called there as an `FnOnce`,
/// consuming it. Only a value with no closure trait of its own (a bare capture
/// record) is judged by how its literal was typed.
type_is_typed_fnmut_closure :: (fn(ty : &TypeValue) -> bool)(
  match(
    closure_fn_trait_of(ty),
    .Some(Rc(.FnTraitT(base_name : tb))) => (tb == "FnMut"),
    _ => capture_struct_typed_fnmut(ty)
  )
);
export(closure_fn_trait_of, fn_trait_call_func_type, type_is_typed_fnmut_closure);
