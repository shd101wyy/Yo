//! Type utilities.
//!
//! A few helpers live elsewhere or stay deferred:
//!
//!   * `is_comptime_only_type` / `is_runtime_only_type` (env-aware
//!     versions): live in `evaluator/trait_checking.yo` as
//!     `type_is_comptime_only_full` / `type_is_runtime_only` because
//!     they depend on the env-aware `type_implements_comptime`. The
//!     tag-only fast path is still here as `type_is_comptime_only`.
//!   * `type_contains_self_type_for_dynamic_dispatch_check` — needs
//!     a `resolved_concrete_type` slot on `SomeT`, which it does not
//!     yet carry.
//!   * `function_parameter_to_string` / `tuple_field_to_string` —
//!     not implemented: function parameters and tuple fields are
//!     modeled via parallel `ArrayList` fields rather than
//!     per-field objects.
//!
//! Provides: set_target_pointer_size,
//! get_target_pointer_size_{bits,bytes}, get_integer_type_bits,
//! get_integer_type_range, can_comptime_{int,float}_cast_to,
//! create_str_type, convert_comptime_type_to_runtime_type (+
//! `_with_expected` overload), prohibit_void_type, type_is_comptime_only,
//! type_requires_comptime_modifier, type_prohibits_comptime_modifier,
//! type_implements_runtime_builtin, type_implements_runtime,
//! type_contains_rc_type (recursive, with depth-limit cycle guard),
//! can_type_form_rc_cycle (full structural DFS with an id-keyed visited set;
//! omits only the env-gated `Acyclic` short-circuit — codegen call sites
//! carry no env — which is conservative, not a stub),
//! type_requires_inference (`false` — Array length is always
//! concretely known), type_contains_some_type (top-level only;
//! recursive descent in `_collect_some_types_into`), get_all_some_types,
//! get_size_of_type / get_alignment_of_type (full: primitive/pointer/array
//! plus Struct/Tuple/Union/EnumT C-layout aggregate sizing — recursion broken
//! via the `g_size_of_type_fn` / `g_alignment_of_type_fn` slots).
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ RefCell } :: import("std/sync/refcell");
{ eprintln } :: import("std/fmt");
{ debug_knob } :: import("../utils.yo");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ HashSet } :: import("std/collections/hash_set");
/// Capture-list borrow entries by capture-struct id (`register_capture_borrows`).
(g_capture_borrows : RefCell(HashMap(String, ArrayList(CaptureBorrow)))) = RefCell(HashMap(String, ArrayList(CaptureBorrow))).new(HashMap(String, ArrayList(CaptureBorrow)).new());
{ TypeValue, TypeValueNode, t_refine_inner, no_types, SharedList } :: import("./definitions.yo");
{ type_intern_key } :: import("./intern.yo");
{ type_to_string } :: import("./string.yo");
{ type_value_tag, resolve_enum_shell, resolve_struct_shell, enum_phantom_positions } :: import("./creators.yo");
{ TypeTag } :: import("./tags.yo");
{
  is_integer_type,
  is_float_type,
  is_comptime_int_type,
  is_comptime_float_type,
  is_some_type,
  is_rc_type,
  is_reference_struct_type,
  is_reference_enum_type,
  is_dyn_type,
  is_unit_type,
  type_decl_module,
  is_module_type,
  is_future_trait_type,
  can_optimize_as_nullable_pointer,
  unique_box_payload_type
}
:: import("./guards.yo");
{ Token } :: import("../token.yo");
{ format_error_message, YoError } :: import("../error.yo");
{ suggest_name, E_FIELD_NOT_FOUND, E_MODULE_FIELD_NOT_FOUND, Diagnostic } :: import("../diagnostics.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// Target pointer size
// ---------------------------------------------------------------------------
(mut(g_target_pointer_size_bits) : u32) = u32(64);
/// Set the target pointer size in bits. Must be positive and divisible by 8.
///
set_target_pointer_size :: (fn(bits : u32) -> unit)(
  if((bits == u32(0)) || !((bits % u32(8)) == u32(0)), (), // invalid pointer size: silently ignore
  {
    g_target_pointer_size_bits = bits;
  })
);
/// Return the configured target pointer size in bits (default: 64).
///
get_target_pointer_size_bits :: (fn() -> u32)(
  g_target_pointer_size_bits
);
/// Return the configured target pointer size in bytes (default: 8).
///
get_target_pointer_size_bytes :: (fn() -> u32)(
  g_target_pointer_size_bits / u32(8)
);
// ---------------------------------------------------------------------------
// Integer range result type
// ---------------------------------------------------------------------------
/// Integer value range: `min` (signed) and `max` (unsigned).
IntRange :: ref(struct(min : i64, max : u64));
// ---------------------------------------------------------------------------
// Integer utilities
// ---------------------------------------------------------------------------
/// Return the bit-width of an integer type.
/// Returns `.None` for non-integer types.
///
get_integer_type_bits :: (fn(ty : &TypeValue) -> Option(u32))(
  match(
    ty,
    Rc(.Int(bits : b, _)) => .Some(u32(b)),
    Rc(.Usize) => .Some(g_target_pointer_size_bits),
    Rc(.Isize) => .Some(g_target_pointer_size_bits),
    _ => .None
  )
);
/// Return the value range of an integer type as an `IntRange`.
/// Returns `.None` for non-integer types.
/// Uses a precomputed table to avoid overflow from runtime bit-shifts.
///
get_integer_type_range :: (fn(ty : &TypeValue) -> Option(IntRange))(
  match(
    ty,
    Rc(.Int(bits : b, signed : s)) => cond(
      // signed variants
      (s && (b == u8(8))) => .Some({ min : i64(-128), max : u64(127) }),
      (s && (b == u8(16))) => .Some({ min : i64(-32768), max : u64(32767) }),
      (s && (b == u8(32))) => .Some({ min : i64(-2147483648), max : u64(2147483647) }),
      (s && (b == u8(64))) => .Some({ min : i64(-9223372036854775808), max : u64(9223372036854775807) }),
      // unsigned variants
      (!s && (b == u8(8))) => .Some({ min : i64(0), max : u64(255) }),
      (!s && (b == u8(16))) => .Some({ min : i64(0), max : u64(65535) }),
      (!s && (b == u8(32))) => .Some({ min : i64(0), max : u64(4294967295) }),
      (!s && (b == u8(64))) => .Some({ min : i64(0), max : u64(18446744073709551615) }),
      true => .None
    ),
    Rc(.Usize) => .Some({ min : i64(0), max : u64(18446744073709551615) }),
    Rc(.Isize) => .Some({ min : i64(-9223372036854775808), max : u64(9223372036854775807) }),
    _ => .None
  )
);
/// The range of a fixed-width integer type AT THE COMPILATION TARGET:
/// `get_integer_type_range` with `usize`/`isize` narrowed to the target's
/// pointer width (32-bit on wasm32), so a comptime integer checked against it
/// is checked against the type the emitted C actually has.
target_integer_type_range :: (fn(ty : &TypeValue) -> Option(IntRange))(
  match(
    ty,
    Rc(.Usize) => if(g_target_pointer_size_bits == u32(32), Option(IntRange).Some({ min : i64(0), max : u64(4294967295) }), get_integer_type_range(ty)),
    Rc(.Isize) => if(g_target_pointer_size_bits == u32(32), Option(IntRange).Some({ min : i64(-2147483648), max : u64(2147483647) }), get_integer_type_range(ty)),
    _ => get_integer_type_range(ty)
  )
);
/// Does the integer `-magnitude` (when `negative`) or `magnitude` fit the
/// fixed-width integer type `ty`? `.None` when `ty` has no fixed range
/// (`comptime_int`, floats, non-integers). The value is taken as sign +
/// magnitude rather than an `i64` because a comptime integer above
/// `i64::MAX` is carried as its `i64` bit pattern (src/utils.yo
/// `parse_raw_int`), which would read as negative.
integer_value_fits_type :: (fn(negative : bool, magnitude : u64, ty : &TypeValue) -> Option(bool))(
  match(
    target_integer_type_range(ty),
    .Some(r) => Option(bool).Some(
      cond(
        !negative => (magnitude <= r.max),
        (magnitude == u64(0)) => true,
        (r.min == i64(0)) => false,
        // |min| = -(min + 1) + 1, computed without negating i64::MIN.
        true => (magnitude <= (u64(-(r.min + i64(1))) + u64(1)))
      )
    ),
    .None => Option(bool).None
  )
);
/// `min..=max` of a fixed-width integer type at the target, for diagnostics
/// (empty for a type without a fixed range).
integer_type_range_string :: (fn(ty : &TypeValue) -> String)(
  match(
    target_integer_type_range(ty),
    .Some(r) => `${r.min.to_string()}..=${r.max.to_string()}`,
    .None => String.new()
  )
);
// ---------------------------------------------------------------------------
// Comptime cast checks
// ---------------------------------------------------------------------------
/// Check whether a `comptime_int` value can be cast to `target_type`.
///
can_comptime_int_cast_to :: (fn(target_type : &TypeValue) -> bool)(
  is_integer_type(target_type) || is_comptime_int_type(target_type)
);
/// Check whether a `comptime_float` value can be cast to `target_type`.
///
can_comptime_float_cast_to :: (fn(target_type : &TypeValue) -> bool)(
  is_float_type(target_type) || is_comptime_float_type(target_type)
);
// NOTE: `create_str_type`, `pointer_target_is_byte_`,
// `convert_comptime_type_to_runtime_type`, and
// `convert_comptime_type_to_runtime_type_with_expected` have been
// moved to `types/env_lookup.yo` so that this file no longer imports
// from `env.yo`. The move breaks the env.yo ↔ types/utils.yo import
// cycle and lets `env.yo` import `type_contains_rc_type` from here
// for `get_variables_needing_drop`.
// ---------------------------------------------------------------------------
// Availability checks
// ---------------------------------------------------------------------------
/// Throw if `ty` is the `Void` type.
///
prohibit_void_type :: (fn(ty : &TypeValue, token : &Token, exn : Exception) -> unit)(
  match(
    ty,
    Rc(.Void) => {
      exn.throw(
        dyn(
          format_error_message(
            token,
            `Void type is not allowed here. Void is only usable as a function return type.`
          )
        )
      );
    },
    _ => ()
  )
);
/// Tag-only fast path. Unlike the env-aware full walk (which recurses
/// into compound types), this never recurses. Returns true only when
/// we *know* the type is comptime-only.
///
/// No `env` parameter: Runtime-trait lookups in compound types would
/// need one, and it is dropped to keep `types/utils.yo` free of any
/// dependency on `env.yo` (see top of file for the cycle context).
type_is_comptime_only :: (fn(ty : &TypeValue) -> bool)(
  match(
    type_value_tag(ty),
    .TComptimeInt => true,
    .TComptimeFloat => true,
    .TComptimeString => true,
    .TType => true,
    .TModule => true,
    .TTrait => true,
    .TExpr => true,
    .TComptimeList => true,
    _ => false
  )
);
/// Return `true` if the type requires a `comptime` modifier.
/// A type requires comptime when it is comptime-only (never runtime).
///
///
/// `env` param dropped (was unused on the tag-only path).
type_requires_comptime_modifier :: (fn(ty : &TypeValue) -> bool)(
  // Compound arms: a tuple/array containing a comptime-only member can
  // never be a runtime value, so binding it without `comptime` must be
  // rejected. Availability is decided by structural recursion, not by
  // a registered per-object trait (the nominal-id trait registry
  // cannot key tuple/array availability) — basic arm 24: `Pair :: Tuple(x :
  // comptime_int, …)` and `[comptime_int ; 2]` runtime bindings were
  // ACCEPTED.
  match(
    ty,
    Rc(.Tuple(_, rcm_fts)) => {
      (rcm_any : bool) = false;
      (rcm_i : usize) = usize(0);
      while(rcm_i < rcm_fts.len(), {
        match(
          rcm_fts.get(rcm_i),
          .Some(rcm_ft) => if(recur(&rcm_ft), {
            rcm_any = true;
          }),
          .None => ()
        );
        rcm_i = (rcm_i + usize(1));
      });
      rcm_any
    },
    Rc(.Array(rcm_el, _, _)) => recur(&rcm_el),
    _ => type_is_comptime_only(ty)
  )
);
/// Return `true` if the type prohibits a `comptime` modifier.
/// A type prohibits comptime when it is runtime-only (never comptime).
///
///
/// `env` param dropped (was unused on the tag-only path).
type_prohibits_comptime_modifier :: (fn(ty : &TypeValue) -> bool)(
  // A type is runtime-only when it implements Runtime but NOT Comptime.
  // Use the tag fast path: these types are definitively runtime-only.
  match(
    type_value_tag(ty),
    .TDyn => true,
    .TVoid => true,
    .TUnion => true,
    .TCChar => true,
    .TCShort => true,
    .TCUShort => true,
    .TCInt => true,
    .TCUInt => true,
    .TCLong => true,
    .TCULong => true,
    .TCLongLong => true,
    .TCULongLong => true,
    .TCLongDouble => true,
    _ => false
  )
);
/// Tag-only fast path. Returns:
///   * `Some(true)`  — type definitely implements Runtime
///   * `Some(false)` — type definitely does NOT implement Runtime
///   * `.None`       — undecided at the tag level (caller must check the
///                     `Runtime` trait in the env, which is Phase 3 work)
///
type_implements_runtime_builtin :: (fn(ty : &TypeValue) -> Option(bool))({
  // Object types (reference semantics) are always runtime types. Module
  // structs (source namespaces) are comptime-only; the TModule tag arm
  // below already covers them.
  match(
    ty,
    Rc(.Struct({ is_reference_semantics : rb_ref, is_source_namespace : rb_ns })) => if(rb_ref && !rb_ns, {
      return(Option(bool).Some(true));
    }),
    _ => ()
  );
  // A pointer's availability follows its POINTEE
  // (`*(comptime_int)` is comptime-only, `*(Rc(i32))` is runtime-only,
  // `*(i32)` is both — tests/basic arms 10/11). The nominal-id trait
  // registry cannot key pointers (type_id_or_empty has no Pointer case),
  // so a registry-only lookup would return false and
  // `validate_type_availability` would false-fire on every pointer-fielded
  // struct (GcTracer :: newtype(_callback : *(u8))). Unwrap pointer chains
  // and decide from the base type's tag.
  (rb_base : TypeValue) = ty;
  (rb_hops : usize) = usize(0);
  while(match(rb_base, Rc(.Pointer(_)) => (rb_hops < usize(8)), _ => false), {
    rb_base = match(rb_base, Rc(.Pointer(p)) => p, _ => rb_base);
    rb_hops = (rb_hops + usize(1));
  });
  if(rb_hops > usize(0), {
    return(
      match(
        rb_base,
        Rc(.Struct({ is_reference_semantics : rb2_ref, is_source_namespace : rb2_ns })) => cond(
          (rb2_ref && !rb2_ns) => Option(bool).Some(true),
          true => Option(bool).None
        ),
        _ => match(
          type_value_tag(&rb_base),
          .TComptimeInt => Option(bool).Some(false),
          .TComptimeFloat => Option(bool).Some(false),
          .TComptimeString => Option(bool).Some(false),
          .TType => Option(bool).Some(false),
          .TModule => Option(bool).Some(false),
          .TTrait => Option(bool).Some(false),
          .TExpr => Option(bool).Some(false),
          .TComptimeList => Option(bool).Some(false),
          _ => Option(bool).None
        )
      )
    );
  });
  match(
    type_value_tag(ty),
    // Comptime-only — never Runtime
    .TComptimeInt => .Some(false),
    .TComptimeFloat => .Some(false),
    .TComptimeString => .Some(false),
    .TType => .Some(false),
    .TModule => .Some(false),
    .TTrait => .Some(false),
    .TExpr => .Some(false),
    .TComptimeList => .Some(false),
    // Runtime-only
    .TDyn => .Some(true),
    .TVoid => .Some(true),
    .TCChar => .Some(true),
    .TCShort => .Some(true),
    .TCUShort => .Some(true),
    .TCInt => .Some(true),
    .TCUInt => .Some(true),
    .TCLong => .Some(true),
    .TCULong => .Some(true),
    .TCLongLong => .Some(true),
    .TCULongLong => .Some(true),
    .TCLongDouble => .Some(true),
    // Available in both
    .TUnit => .Some(true),
    .TBool => .Some(true),
    .TUsize => .Some(true),
    .TIsize => .Some(true),
    .TU8 => .Some(true),
    .TI8 => .Some(true),
    .TU16 => .Some(true),
    .TI16 => .Some(true),
    .TU32 => .Some(true),
    .TI32 => .Some(true),
    .TU64 => .Some(true),
    .TI64 => .Some(true),
    .TF32 => .Some(true),
    .TF64 => .Some(true),
    .TStr => .Some(true),
    .TFunction => .Some(true),
    .TUnion => .Some(true),
    // Undecided — would need the env / Runtime trait to settle.
    _ => .None
  )
});
/// Conservative `type_implements_runtime`. Uses the tag fast path; for
/// undecided cases it conservatively returns `false` (Phase 3 will
/// consult the `Runtime` trait in `env`).
///
/// `env` param dropped (was unused on the tag-only path).
type_implements_runtime :: (fn(ty : &TypeValue) -> bool)(
  match(
    type_implements_runtime_builtin(ty),
    .Some(b) => b,
    .None => false
  )
);
// ---------------------------------------------------------------------------
// Move-only values (plans/VALUES_BY_DEFAULT.md §3.4, V3)
// ---------------------------------------------------------------------------
/// Answers whether a value nominal type (a `struct`, `enum` or `newtype` that
/// is not a reference type) itself declares move-only, and through which
/// trait: `"Drop"` (`is_drop_trait_name`), concretely or through a generic impl
/// whose receiver pattern matches it; `""` when it does not. Installed at
/// init (the impl registries live above this module) and consulted only once
/// `note_move_only_possible` has run, so a program with no such impl pays one
/// flag test per nominal type visited.
MoveOnlyNominalFn :: (fn(ty : &TypeValue) -> String);
(mut(g_move_only_nominal_fn) : Option(MoveOnlyNominalFn)) = Option(MoveOnlyNominalFn).None;
/// Install the nominal move-only answer (`evaluator/trait_checking.yo` does at
/// init).
set_move_only_nominal_fn :: (fn(f : Option(MoveOnlyNominalFn)) -> unit)({
  g_move_only_nominal_fn = f;
});
/// Answers whether a recorded generic `Drop` impl covers a value nominal
/// instantiated at unresolved type parameters (`Buf(T)` in a generic
/// signature), which `MoveOnlyNominalFn` cannot match. Consulted only by
/// `value_type_owns_buffer_outright` (the raw-view gate's owner exemption),
/// never by the move-only checks. Installed at init with
/// `MoveOnlyNominalFn`.
GenericOwnerDropFn :: (fn(ty : &TypeValue) -> bool);
(mut(g_generic_owner_drop_fn) : Option(GenericOwnerDropFn)) = Option(GenericOwnerDropFn).None;
/// Install the generic owner `Drop` answer (`evaluator/trait_checking.yo`
/// does at init).
set_generic_owner_drop_fn :: (fn(f : Option(GenericOwnerDropFn)) -> unit)({
  g_generic_owner_drop_fn = f;
});
/// Set once some `impl` that declares `Drop` has been seen
/// (registered, or recorded pending by the lazy module walk): until then no
/// type is move-only, and the move-only checks skip their work. Never
/// cleared: it only gates a fast path.
(mut(g_move_only_possible) : bool) = false;
note_move_only_possible :: (fn() -> unit)({
  g_move_only_possible = true;
});
/// A borrow entry of a closure's capture list, `imm(y) : &p` or
/// `mut(z) : &mut p` (plans/VALUES_BY_DEFAULT.md decision 35), recorded per
/// capture-struct id by `register_capture_borrows`. Borrows stay modes, never
/// types (decision 38 A): the capture struct's field is a pointer, and this
/// table is what makes the struct second-class and, for a `mut` entry,
/// move-only.
CaptureBorrow :: struct(
  /// The capture's name inside the body (`y`, or the renamed `name`).
  label : String,
  is_mut : bool,
  /// The borrowed place: its root binding (`Variable.id`), the root's name
  /// and the field hops from the root outward (`s.items` is `["items"]`).
  root_id : usize,
  root_name : String,
  path : ArrayList(String),
  /// The root is a `&T` parameter, which C receives by value: a future
  /// that borrows it keeps its own copy (§3.13 A2, `_lent_param_capture_fields`).
  root_is_value_param : bool,
  /// The borrow reaches the future through a captured value (a borrowing
  /// closure the `io.async` body captures), not through the body's own
  /// capture-list entry. A future copies a `&T` parameter it borrows
  /// (`_lent_param_capture_fields`), but only through its own entry, so such a
  /// borrow of a `&T` parameter keeps the future from being returned (§3.13 A2).
  through_value : bool,
  /// Not a capture-list entry: the borrow a call through a function value is
  /// assumed to make of a place it lends (the callee's body is not visible, so
  /// the future it returns may keep the place, §3.13 A2).
  assumed : bool,
  /// `module:row:col` of the entry, for diagnostics.
  site : String
);
/// Record the borrow entries of the capture struct `struct_id`. A `mut` entry
/// makes the struct move-only, so the move-only fast path is armed.
register_capture_borrows :: (fn(struct_id : &String, borrows : &ArrayList(CaptureBorrow)) -> unit)({
  if(borrows.len() == usize(0), {
    return(());
  });
  (i : usize) = usize(0);
  while(i < borrows.len(), {
    if(match(borrows.get(i), .Some(b) => b.is_mut, .None => false), {
      g_move_only_possible = true;
    });
    i = (i + usize(1));
  });
  g_capture_borrows.with_mut(m => m.insert(struct_id, borrows));
});
/// The borrow entries recorded for the capture struct `struct_id`.
capture_struct_borrows :: (fn(struct_id : &String) -> Option(ArrayList(CaptureBorrow)))(
  cond(
    (g_capture_borrows.with(m => m.len()) == usize(0)) => Option(ArrayList(CaptureBorrow)).None,
    true => g_capture_borrows.with(m => m.get(struct_id))
  )
);
/// Some capture list has recorded a borrow: the fast path of every check that
/// looks for one.
capture_borrows_exist :: (fn() -> bool)(g_capture_borrows.with(m => m.len()) > usize(0));
/// The place a borrow entry names, as written: `s.items`.
capture_borrow_place_string :: (fn(b : &CaptureBorrow) -> String)({
  out := b.root_name.clone();
  (i : usize) = usize(0);
  while(i < b.path.len(), {
    out.push_str(".");
    out.push_string(match(b.path.get(i), .Some(f) => f, .None => String.new()));
    i = (i + usize(1));
  });
  out
});
/// Append every capture-list borrow `ty` carries, transitively: through
/// struct and record fields, tuple and array elements, enum payloads, the
/// captures of a closure that captures a borrowing closure, and a resolved
/// type variable (decision 38 A: second-class is structural). A reference
/// type stops the walk: a cell's payload cannot hold a borrow, because a
/// second-class type may not be a generic argument of a type constructor.
collect_type_borrows :: (fn(ty : &TypeValue, out : &mut ArrayList(CaptureBorrow)) -> unit)(
  cond(
    (g_capture_borrows.with(m => m.len()) == usize(0)) => (),
    true => _collect_type_borrows_inner(ty, out, u32(0))
  )
);
_collect_type_borrows_inner :: (fn(ty_in : &TypeValue, out : &mut ArrayList(CaptureBorrow), depth : u32) -> unit)({
  ty := resolve_enum_shell(resolve_struct_shell(ty_in));
  // A borrowing future (§3.13 A2): `io.async` registers its body's
  // capture-list borrows under the future's per-call wrapper id, and a
  // function returning it carries that future as its result's resolution. A
  // future is a counted state machine, so this precedes the reference-type
  // stop below.
  match(
    ty,
    Rc(.SomeT({ id : st_id, resolution : f_res })) => if(is_future_value_type(&ty) && (depth <= u32(12)), {
      match(
        g_capture_borrows.with(m => m.get(&st_id)),
        .Some(bs) => {
          (bi : usize) = usize(0);
          while(bi < bs.len(), {
            match(bs.get(bi), .Some(b) => out.push(b), .None => ());
            bi = (bi + usize(1));
          });
        },
        .None => ()
      );
      match(f_res, .Some(concrete) => recur(&concrete, out, depth + u32(1)), .None => ());
      return(());
    }),
    _ => ()
  );
  if((depth > u32(12)) || is_rc_type(&ty), {
    return(());
  });
  match(
    ty,
    Rc(.Array(element : elem, length : _)) => recur(&elem, out, depth + u32(1)),
    Rc(.Tuple({ field_types : fields })) => {
      (i : usize) = usize(0);
      while(i < fields.len(), {
        recur(match(fields.get(i), .Some(f) => f, .None => rc(TypeValueNode.Unit)), out, depth + u32(1));
        i = (i + usize(1));
      });
    },
    Rc(.Struct({ id : sid, field_types : fields })) => {
      match(
        g_capture_borrows.with(m => m.get(&sid)),
        .Some(bs) => {
          (bi : usize) = usize(0);
          while(bi < bs.len(), {
            match(bs.get(bi), .Some(b) => out.push(b), .None => ());
            bi = (bi + usize(1));
          });
        },
        .None => ()
      );
      (i : usize) = usize(0);
      while(i < fields.len(), {
        recur(match(fields.get(i), .Some(f) => f, .None => rc(TypeValueNode.Unit)), out, depth + u32(1));
        i = (i + usize(1));
      });
    },
    Rc(.EnumT({ variant_fields : all_fields })) => {
      (vi : usize) = usize(0);
      while(vi < all_fields.len(), {
        vf := match(all_fields.get(vi), .Some(f) => f, .None => no_types());
        (fi : usize) = usize(0);
        while(fi < vf.len(), {
          recur(match(vf.get(fi), .Some(f) => f, .None => rc(TypeValueNode.Unit)), out, depth + u32(1));
          fi = (fi + usize(1));
        });
        vi = (vi + usize(1));
      });
    },
    Rc(.SomeT({ resolution : rc })) => match(rc, .Some(concrete) => recur(&concrete, out, depth + u32(1)), .None => ()),
    _ => ()
  );
});
/// The second-class type a value of `ty` would hold behind a pointer, if any:
/// a `*(T)` (directly, or inside an `Option`/enum payload, a tuple, an array
/// or a value struct field) whose `T` is second-class. A pointer's target
/// outlives any one borrow (a collection's buffer is `?(*(T))`), so decision
/// 38 A's type-position rule rejects it.
type_pointee_second_class :: (fn(ty : &TypeValue) -> Option(TypeValue))(
  cond(
    (g_capture_borrows.with(m => m.len()) == usize(0)) => Option(TypeValue).None,
    true => _pointee_second_class_inner(ty, u32(0))
  )
);
_pointee_second_class_inner :: (fn(ty_in : &TypeValue, depth : u32) -> Option(TypeValue))({
  ty := resolve_enum_shell(resolve_struct_shell(ty_in));
  if((depth > u32(8)) || is_rc_type(&ty), {
    return(Option(TypeValue).None);
  });
  comps := ArrayList(TypeValue).new();
  match(
    ty,
    Rc(.Pointer(inner)) => {
      return(if(type_is_second_class(&inner), Option(TypeValue).Some(inner), Option(TypeValue).None));
    },
    Rc(.Array(element : elem, length : _)) => comps.push(elem),
    Rc(.Tuple({ field_types : fields })) => {
      (i : usize) = usize(0);
      while(i < fields.len(), {
        comps.push(match(fields.get(i), .Some(f) => f, .None => rc(TypeValueNode.Unit)));
        i = (i + usize(1));
      });
    },
    Rc(.Struct({ field_types : fields })) => {
      (i : usize) = usize(0);
      while(i < fields.len(), {
        comps.push(match(fields.get(i), .Some(f) => f, .None => rc(TypeValueNode.Unit)));
        i = (i + usize(1));
      });
    },
    Rc(.EnumT({ variant_fields : all_fields })) => {
      (vi : usize) = usize(0);
      while(vi < all_fields.len(), {
        vf := match(all_fields.get(vi), .Some(f) => f, .None => no_types());
        (fi : usize) = usize(0);
        while(fi < vf.len(), {
          comps.push(match(vf.get(fi), .Some(f) => f, .None => rc(TypeValueNode.Unit)));
          fi = (fi + usize(1));
        });
        vi = (vi + usize(1));
      });
    },
    Rc(.SomeT({ resolution : rc })) => match(rc, .Some(concrete) => comps.push(concrete), .None => ()),
    _ => ()
  );
  (ci : usize) = usize(0);
  while(ci < comps.len(), {
    match(
      recur(match(comps.get(ci), .Some(c) => c, .None => rc(TypeValueNode.Unit)), depth + u32(1)),
      .Some(found) => {
        return(Option(TypeValue).Some(found));
      },
      .None => ()
    );
    ci = (ci + usize(1));
  });
  Option(TypeValue).None
});
/// True if a value of `ty` is second-class (decision 38 A): it holds a
/// capture-list borrow, directly or through any component. Such a value may
/// be bound to a local, lent and called, but never returned, stored, made a
/// `Dyn`, captured by an escaping closure, spawned or moved into a by-value
/// (`sink`) parameter, and its type may not be a field type or a type
/// constructor's argument.
type_is_second_class :: (fn(ty : &TypeValue) -> bool)(
  cond(
    (g_capture_borrows.with(m => m.len()) == usize(0)) => false,
    true => {
      bs := ArrayList(CaptureBorrow).new();
      _collect_type_borrows_inner(ty, &mut bs, u32(0));
      bs.len() > usize(0)
    }
  )
);
/// The first `mut` capture-list borrow `ty` carries (decision 38 B: such a
/// value is lent exclusively, and it is move-only), if any.
type_first_mut_borrow :: (fn(ty : &TypeValue) -> Option(CaptureBorrow))({
  if(g_capture_borrows.with(m => m.len()) == usize(0), {
    return(Option(CaptureBorrow).None);
  });
  bs := ArrayList(CaptureBorrow).new();
  _collect_type_borrows_inner(ty, &mut bs, u32(0));
  (i : usize) = usize(0);
  while(i < bs.len(), {
    match(
      bs.get(i),
      .Some(b) => if(b.is_mut, {
        return(Option(CaptureBorrow).Some(b));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  Option(CaptureBorrow).None
});
/// The capture struct `ty` (resolved through type variables) declares a
/// `mut` capture itself.
_capture_struct_declares_mut :: (fn(ty : &TypeValue) -> bool)(
  cond(
    (g_capture_borrows.with(m => m.len()) == usize(0)) => false,
    true => match(
      ty,
      Rc(.Struct({ id : sid })) => match(
        g_capture_borrows.with(m => m.get(&sid)),
        .Some(bs) => {
          (found : bool) = false;
          (i : usize) = usize(0);
          while(i < bs.len(), {
            if(match(bs.get(i), .Some(b) => b.is_mut, .None => false), {
              found = true;
            });
            i = (i + usize(1));
          });
          found
        },
        .None => false
      ),
      _ => false
    )
  )
);
/// True once a value type may be move-only (`note_move_only_possible`).
move_only_declarations_exist :: (fn() -> bool)(g_move_only_possible);
/// A value nominal type: a `struct`/`enum`/`newtype` without reference
/// semantics. Only these can declare move-only; a reference type is a shared
/// cell, so its copies alias and it is never move-only (§3.4: `Rc(T)` and
/// `Arc(T)` never are).
is_value_nominal_type :: (fn(ty_in : &TypeValue) -> bool)({
  ty := resolve_enum_shell(resolve_struct_shell(ty_in));
  match(
    ty,
    Rc(.Struct({ is_reference_semantics : is_ref })) => !is_ref,
    Rc(.EnumT({ is_reference_semantics : is_ref })) => !is_ref,
    _ => false
  )
});
/// The trait through which `ty` (already shell-resolved), a value nominal
/// type, declares move-only itself, or `""` (see `MoveOnlyNominalFn`).
_nominal_move_only_trait :: (fn(ty : &TypeValue) -> String)(
  cond(
    !g_move_only_possible => String.new(),
    true => match(
      g_move_only_nominal_fn,
      .None => String.new(),
      .Some(f) => if(is_value_nominal_type(ty), f(ty), String.new())
    )
  )
);
_nominal_declares_move_only :: (fn(ty : &TypeValue) -> bool)(!_nominal_move_only_trait(ty).is_empty());
/// The destructor trait's name, `Drop` (plans/VALUES_BY_DEFAULT.md decision
/// 45). Its old spelling, `Dispose`, is gone since Generation B; only
/// `yo fix --migrate drop-trait` still reads it (`calls/function.yo`).
is_drop_trait_name :: (fn(name : &String) -> bool)(name == "Drop");
/// The destructor method's name, `drop`, paired with `is_drop_trait_name`.
is_drop_method_name :: (fn(name : &String) -> bool)(name == "drop");
/// Is `label` the destructor method of `trait_ty`: `drop` of the prelude
/// `Drop` trait? Only that member is left out of a Dyn vtable (the
/// synthesized `___dispose` runs it); a method of another trait that happens
/// to be named `drop` is an ordinary slot
/// (issues/fixed/a-trait-method-named-drop-is-left-out-of-every-dyn-vtable.md).
/// Codegen has no environment, so the trait is recognized by the name its
/// prelude binding gave it.
is_destructor_trait_member :: (fn(trait_ty : &TypeValue, label : &String) -> bool)(
  is_drop_method_name(label) && match(trait_ty, Rc(.TraitT({ name })) => is_drop_trait_name(&name), _ => false)
);
/// Is `trait_ty` the prelude `Clone` trait? Recognized by the name its prelude
/// binding gave it, as `is_destructor_trait_member` recognizes `Drop`: codegen
/// has no environment.
is_clone_trait_type :: (fn(trait_ty : &TypeValue) -> bool)(
  match(trait_ty, Rc(.TraitT({ name })) => (name == "Clone"), _ => false)
);
/// Does the `Dyn` type `ty` list `Clone` among its traits? Such a `Dyn` is
/// explicit-copy (plans/VALUES_BY_DEFAULT.md decision 7): `d.clone()` copies
/// its payload through the vtable's `__yo_clone` slot, which `Clone`
/// contributes instead of a method slot (`clone` returns `Self`, which the
/// `Dyn` erases, so it has no slot of its own).
dyn_type_lists_clone :: (fn(ty : &TypeValue) -> bool)(
  match(
    ty,
    Rc(.DynT({ required_trait_types : rtt })) => {
      (i : usize) = usize(0);
      while(i < rtt.len(), {
        if(match(rtt.get(i), .Some(t) => is_clone_trait_type(&t), .None => false), {
          return(true);
        });
        i = (i + usize(1));
      });
      false
    },
    _ => false
  )
);
/// Does a value of `ty` own a `Dyn` by value: a `Dyn`, or a value aggregate
/// (struct, enum, tuple, array, closure capture record) holding one? A
/// reference type, an `Rc`/`Arc` handle and a pointer stop the walk: copying
/// one shares the `Dyn` instead of copying it. Such a value copies only
/// explicitly once `Dyn` is uniquely owned (plans/VALUES_BY_DEFAULT.md
/// decision 7), which Generation A enforces outside std and src
/// (`check_dyn_copy`, evaluator/utils.yo).
type_holds_dyn_by_value :: (fn(ty : &TypeValue) -> bool)(_holds_dyn_by_value_inner(ty, u32(0)));
_any_holds_dyn_by_value :: (fn(fields : &ArrayList(TypeValue), depth : u32) -> bool)({
  (i : usize) = usize(0);
  while(i < fields.len(), {
    if(match(fields.get(i), .Some(ft) => _holds_dyn_by_value_inner(&ft, depth), .None => false), {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
_holds_dyn_by_value_inner :: (fn(ty_in : &TypeValue, depth : u32) -> bool)({
  if(depth > u32(8), {
    return(false);
  });
  ty := resolve_enum_shell(resolve_struct_shell(ty_in));
  match(
    ty,
    Rc(.DynT(required_trait_types : _)) => true,
    Rc(.Struct({ field_types : fields, is_reference_semantics : is_ref })) => (!is_ref && _any_holds_dyn_by_value(&fields.items, depth + u32(1))),
    Rc(.EnumT({ variant_fields : all_fields, is_reference_semantics : e_is_ref })) => {
      if(e_is_ref, {
        return(false);
      });
      (vi : usize) = usize(0);
      while(vi < all_fields.len(), {
        if(match(all_fields.get(vi), .Some(vf) => _any_holds_dyn_by_value(&vf.items, depth + u32(1)), .None => false), {
          return(true);
        });
        vi = (vi + usize(1));
      });
      false
    },
    Rc(.Tuple(field_labels : _, field_types : fields)) => _any_holds_dyn_by_value(&fields.items, depth + u32(1)),
    Rc(.Array(element : elem, length : _)) => _holds_dyn_by_value_inner(&elem, depth + u32(1)),
    Rc(.SomeT({ resolution : resolved })) => match(resolved, .Some(concrete) => _holds_dyn_by_value_inner(&concrete, depth + u32(1)), .None => false),
    _ => false
  )
});
/// A `Dyn(FnOnce(...))` (plans/VALUES_BY_DEFAULT.md decision 37): its call
/// consumes it, so it is move-only although a `Dyn` is reference counted —
/// two handles to one payload would run a call-once body twice.
_is_dyn_fnonce :: (fn(ty : &TypeValue) -> bool)(
  match(
    ty,
    Rc(.DynT(required_trait_types : rtt)) => {
      (i : usize) = usize(0);
      while(i < rtt.len(), {
        if(match(rtt.get(i), .Some(t) => match(t, Rc(.FnTraitT(base_name : b)) => (b == "FnOnce"), _ => false), .None => false), {
          return(true);
        });
        i = (i + usize(1));
      });
      false
    },
    _ => false
  )
);
/// A future: an `Impl(Future(T, E))` (an `io.async` result, an async
/// function's result, `IoFuture`). It is a reference-counted state machine,
/// yet move-only (plans/VALUES_BY_DEFAULT.md decision 13, §3.13 A1): `io.await`
/// and `io.spawn` consume it, so one future is awaited or spawned once.
is_future_value_type :: (fn(ty : &TypeValue) -> bool)(
  match(
    ty,
    Rc(.SomeT({ required_trait_types : rtt })) => {
      (i : usize) = usize(0);
      while(i < rtt.len(), {
        if(match(rtt.get(i), .Some(t) => is_future_trait_type(&t), .None => false), {
          return(true);
        });
        i = (i + usize(1));
      });
      false
    },
    _ => false
  )
);
/// The walk state of one top-level type predicate (`type_contains_rc_type`
/// and its pre-flip sibling, `type_is_move_only`,
/// `type_reaches_non_atomic_cell`, `type_is_control_bound`). There is no
/// depth cap on an answer: a `false` past some depth would say "nothing to
/// drop" of an ordinary value nested that deep, and its teardown would never
/// be emitted (issues/fixed/yo-self-rc-depth-cap-skips-deep-teardown.md).
/// Instead, from `_TYPE_WALK_TRACK_DEPTH` on, every aggregate walked is
/// tracked by object identity, as `_type_repr_contains_raw_ptr` does:
///
/// - `path`: the aggregates on the current path. The same object reached
///   again is a cycle (a type reached through itself), answered `false`
///   there, which is what a cycle contributes to an "any component" walk.
/// - `memo`: the answers of the aggregates walked so far, so a sub-graph
///   reached through several fields is walked once, not once per path.
/// - `cut`: set when the current sub-walk met a cycle or the stack backstop.
///   A `false` computed under a cut depends on the path, so it is not
///   memoized; a `true` is exact either way.
///
/// By identity, not by id: substituted generic instantiations share ids
/// (`types/intern.yo`), so an id-keyed set would cut `Option(Option(T))`.
/// Below `_TYPE_WALK_TRACK_DEPTH` nothing is tracked and nothing allocated:
/// the common shallow walk costs what it did, and a cycle is still caught
/// one turn after the walk crosses that depth.
_TypeWalk :: struct(path : ArrayList(_TypeWalkFrame), memo : ArrayList(_ReprMemoEntry), cut : bool);
/// One aggregate on a `_TypeWalk` path, with the walk's `cut` flag from
/// before it was entered (restored, or-ed with its own, when it is left).
_TypeWalkFrame :: struct(ty : TypeValue, outer_cut : bool);
_TYPE_WALK_TRACK_DEPTH :: u32(8);
/// A stack backstop, not an answer cap: no well-formed type nests this deep
/// without a cycle, which `_TypeWalk.path` catches first.
_TYPE_WALK_MAX_DEPTH :: u32(1024);
_type_walk_new :: (fn() -> _TypeWalk)(
  _TypeWalk(path : ArrayList(_TypeWalkFrame).new(), memo : ArrayList(_ReprMemoEntry).new(), cut : false)
);
/// Enter the aggregate `ty` reached at `depth`. `.Some(answer)` when the walk
/// does not descend: `ty` was answered already, or it is on the path (a
/// cycle: `false`, and the walk is cut). `.None` when the caller walks `ty`'s
/// components and hands their answer to `_type_walk_leave`.
_type_walk_enter :: (fn(w : &mut _TypeWalk, ty : &TypeValue, depth : u32) -> Option(bool))({
  if(depth < _TYPE_WALK_TRACK_DEPTH, {
    return(Option(bool).None);
  });
  (i : usize) = usize(0);
  while(i < w.memo.len(), {
    match(
      w.memo.get(i),
      .Some(e) => if(__yo_ptr_eq(&e.ty, ty), {
        return(Option(bool).Some(e.answer));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  (pi : usize) = usize(0);
  while(pi < w.path.len(), {
    match(
      w.path.get(pi),
      .Some(f) => if(__yo_ptr_eq(&f.ty, ty), {
        w.cut = true;
        return(Option(bool).Some(false));
      }),
      .None => ()
    );
    pi = (pi + usize(1));
  });
  w.path.push(_TypeWalkFrame(ty : ty, outer_cut : w.cut));
  w.cut = false;
  Option(bool).None
});
/// Leave the aggregate `ty` entered at `depth`, whose components answered
/// `answer`: memoize it unless it is a `false` computed under a cut.
_type_walk_leave :: (fn(w : &mut _TypeWalk, ty : &TypeValue, depth : u32, answer : bool) -> bool)({
  if(depth < _TYPE_WALK_TRACK_DEPTH, {
    return(answer);
  });
  outer_cut := match(w.path.pop(), .Some(f) => f.outer_cut, .None => false);
  if(answer || !w.cut, {
    w.memo.push(_ReprMemoEntry(ty : ty, answer : answer));
  });
  w.cut = (w.cut || outer_cut);
  answer
});
/// The walk behind `type_is_move_only`, the shape of
/// `_type_contains_rc_inner` (`_TypeWalk` included). A reference type (and
/// `Dyn`, which is a cell too) stops the walk: it shares its payload, so it
/// is copyable whatever it holds.
_type_is_move_only_inner :: (fn(ty_in : &TypeValue, w : &mut _TypeWalk, depth : u32) -> bool)({
  ty := resolve_enum_shell(resolve_struct_shell(ty_in));
  cond(
    (depth > _TYPE_WALK_MAX_DEPTH) => {
      w.cut = true;
      false
    },
    _is_dyn_fnonce(&ty) => true,
    is_future_value_type(&ty) => true,
    is_rc_type(&ty) => false,
    _nominal_declares_move_only(&ty) => true,
    // A closure with a `mut` capture (decision 35): two copies of one
    // exclusive borrow would alias.
    _capture_struct_declares_mut(&ty) => true,
    true => match(
      ty,
      Rc(.Array(element : elem, length : _)) => recur(&elem, w, depth + u32(1)),
      Rc(.Tuple(field_labels : _, field_types : fields)) => match(
        _type_walk_enter(w, &ty, depth),
        .Some(seen) => seen,
        .None => {
          (found : bool) = false;
          (i : usize) = usize(0);
          while((i < fields.len()) && !found, {
            match(
              fields.get(i),
              .Some(ft) => {
                found = recur(&ft, w, depth + u32(1));
              },
              .None => ()
            );
            i = (i + usize(1));
          });
          _type_walk_leave(w, &ty, depth, found)
        }
      ),
      Rc(.Struct({ field_types : fields })) => match(
        _type_walk_enter(w, &ty, depth),
        .Some(seen) => seen,
        .None => {
          (found : bool) = false;
          (i : usize) = usize(0);
          while((i < fields.len()) && !found, {
            match(
              fields.get(i),
              .Some(ft) => {
                found = recur(&ft, w, depth + u32(1));
              },
              .None => ()
            );
            i = (i + usize(1));
          });
          _type_walk_leave(w, &ty, depth, found)
        }
      ),
      Rc(.EnumT({ variant_fields : all_fields })) => match(
        _type_walk_enter(w, &ty, depth),
        .Some(seen) => seen,
        .None => {
          (found : bool) = false;
          (vi : usize) = usize(0);
          while((vi < all_fields.len()) && !found, {
            vf := match(all_fields.get(vi), .Some(f) => f, .None => no_types());
            (fi : usize) = usize(0);
            while((fi < vf.len()) && !found, {
              match(
                vf.get(fi),
                .Some(ft) => {
                  found = recur(&ft, w, depth + u32(1));
                },
                .None => ()
              );
              fi = (fi + usize(1));
            });
            vi = (vi + usize(1));
          });
          _type_walk_leave(w, &ty, depth, found)
        }
      ),
      // A generic parameter is judged where it is bound: a generic body is
      // re-evaluated per instantiation (§3.4 "checked per instantiation").
      Rc(.SomeT({ resolution : rc })) => match(rc, .Some(concrete) => recur(&concrete, w, depth + u32(1)), .None => false),
      _ => false
    )
  )
});
/// True if a value of `ty` cannot be copied, only moved (§3.4): a value
/// nominal type implementing `Drop`, or a value aggregate
/// (struct, enum, tuple, array, closure capture struct) with a move-only
/// component. A reference type never is. `type_contains_rc_type` is true
/// for every move-only type, so the ownership machinery (temps, drops,
/// moves, joins) tracks these values like RC values; this predicate is what
/// turns their copies into moves or errors.
type_is_move_only :: (fn(ty : &TypeValue) -> bool)({
  if(!g_move_only_possible, {
    return(false);
  });
  w := _type_walk_new();
  _type_is_move_only_inner(ty, &mut w, u32(0))
});
/// True if a value of `ty` is not implicitly copyable: an implicit copy of it
/// is a compile error and every copy point MOVES it (plans/VALUES_BY_DEFAULT.md
/// §3.4 and the three kinds of type: implicitly copyable, explicit-copy,
/// move-only). The move points, use-after-move (E0901), flow joins, the
/// no-partial-moves rule and closure-capture moves all key on this predicate;
/// only "may it be copied with `.clone()`" and the `Drop` rule key on
/// `type_is_move_only`, its strict sub-case. It holds for move-only types and,
/// since decision 36's flip, for a plain-data type that is not `Copy`. A
/// value owning a buffer (`String`, the collections, `Dyn`) joins in V2b's
/// own, separately measured migration.
/// Decision 36's flip (plans/VALUES_BY_DEFAULT.md, Generation B): a
/// plain-data type (no owned buffer, no counted cell) that is not `Copy` is
/// explicit-copy too. The `Copy` question needs the trait registry and an
/// environment, which this module cannot reach, so `trait_checking.yo`
/// installs it (`type_lacks_copy_for_flip`, memoized there). Compile-time-only,
/// control-bound and C-opaque types answer false: their copies stay implicit.
(mut(g_type_lacks_copy_fn) : Option(fn(ty : &TypeValue) -> bool)) = Option(fn(ty : &TypeValue) -> bool).None;
/// Bumped on every trait-impl registration (`register_type_trait_value`,
/// `register_generic_impl`). A "not `Copy`" answer is only as good as the
/// impls registered when it was given (an impl placed later in a module
/// registers after a copy was first judged), so the flip's memo
/// (`type_lacks_copy_for_flip`) is dropped whenever this moves.
(mut(g_trait_impl_epoch) : u64) = u64(0);
bump_trait_impl_epoch :: (fn() -> unit)({
  g_trait_impl_epoch = (g_trait_impl_epoch + u64(1));
});
trait_impl_epoch :: (fn() -> u64)(g_trait_impl_epoch);
set_type_lacks_copy_fn :: (fn(f : (fn(ty : &TypeValue) -> bool)) -> unit)({
  g_type_lacks_copy_fn = Option(fn(ty : &TypeValue) -> bool).Some(f);
});
/// Whether a type lacks `Clone` (installed by `evaluator/trait_checking.yo`):
/// a plain-data type with neither `Copy` nor `Clone` is move-only, which is
/// how a diagnostic names it (decision 36: move-only is "neither").
(mut(g_type_lacks_clone_fn) : Option(fn(ty : &TypeValue) -> bool)) = Option(fn(ty : &TypeValue) -> bool).None;
set_type_lacks_clone_fn :: (fn(f : (fn(ty : &TypeValue) -> bool)) -> unit)({
  g_type_lacks_clone_fn = Option(fn(ty : &TypeValue) -> bool).Some(f);
});
type_lacks_clone :: (fn(ty : &TypeValue) -> bool)(match(g_type_lacks_clone_fn, .Some(f) => f(ty), .None => false));
/// `YO_FLIP_REPORT=1`: the flip is off, and each plain-data type it would
/// make explicit-copy is printed once (`[flip] <type>`) where a copy of it is
/// decided, so one pass over a tree names every type its sweep still needs.
(g_flip_report : bool) = debug_knob(`YO_FLIP_REPORT`).is_some();
(g_flip_reported : RefCell(HashMap(String, bool))) = RefCell(HashMap(String, bool)).new(HashMap(String, bool).new());
_plain_data_lacks_copy :: (fn(ty_in : &TypeValue) -> bool)({
  // A closure is judged by its capture record, as in Rust: `Copy` exactly
  // when every by-value capture is (decision 36), whatever it owns. The
  // owned-buffer and counted-cell carve-out below is V2b's and V2c's
  // migration of `String`, the collections and `Rc` themselves, not of the
  // closures that capture them: a closure owning a `String` is explicit-copy
  // now (issues/fixed/2026-10-14-a-closure-owning-a-string-copies-implicitly.md).
  if(is_bound_closure_identity(ty_in) || is_closure_capture_struct(ty_in), {
    return(match(g_type_lacks_copy_fn, .Some(f) => f(resolve_cell_chain(ty_in)), .None => false));
  });
  ty := match(
    ty_in,
    Rc(.SomeT({ resolution : sr })) => match(
      sr,
      .Some(c) => c,
      .None => {
        // A generic parameter is judged where it is bound (a generic body is
        // re-evaluated per instantiation), as `type_is_move_only` does.
        return(false);
      }
    ),
    _ => ty_in
  );
  if(type_contains_rc_cell_or_move_only(&ty), {
    return(false);
  });
  lacks := match(g_type_lacks_copy_fn, .Some(f) => f(&ty), .None => false);
  if(lacks && g_flip_report, {
    shown := type_to_string(&ty);
    if(g_flip_reported.with(m => m.get(shown.clone())).is_none(), {
      eprintln(`[flip] ${shown}`);
      _ := g_flip_reported.with_mut(m => m.insert(shown.clone(), true));
    });
    return(false);
  });
  lacks
});
/// A nominal value struct or enum that is not `Copy` under the flip
/// (`g_type_lacks_copy_fn`). Tuples, arrays and records are walked by
/// `_type_contains_rc_inner` through their parts.
_nominal_lacks_copy :: (fn(ty : &TypeValue) -> bool)(
  !g_flip_report && match(
    ty,
    Rc(.Struct({ id : _ })) => match(g_type_lacks_copy_fn, .Some(f) => f(ty), .None => false),
    Rc(.EnumT(_, _, _, _, _, _, _, _, _, _)) => match(g_type_lacks_copy_fn, .Some(f) => f(ty), .None => false),
    _ => false
  )
);
type_requires_explicit_copy :: (fn(ty : &TypeValue) -> bool)(type_is_move_only(ty) || _plain_data_lacks_copy(ty));
/// Why `ty` is move-only, for the E0901 note: the declaring type and trait,
/// reached through the component path ("`Holder` holds a move-only value in
/// its field `fd` (`Fd`): `Fd` implements Drop"). `.None` when it is not
/// move-only.
move_only_reason :: (fn(ty : &TypeValue) -> Option(String))(
  cond(g_move_only_possible => _move_only_reason_inner(ty, u32(0)), true => Option(String).None)
);
_move_only_reason_inner :: (fn(ty_in : &TypeValue, depth : u32) -> Option(String))({
  ty := resolve_enum_shell(resolve_struct_shell(ty_in));
  if(_is_dyn_fnonce(&ty), {
    return(Option(String).Some(`\`${type_to_string(&ty)}\` is a call-once closure: its call consumes it, so a copy could call it twice`));
  });
  if((depth > _TYPE_WALK_MAX_DEPTH) || is_rc_type(&ty), {
    return(Option(String).None);
  });
  tn := _nominal_move_only_trait(&ty);
  if(is_drop_trait_name(&tn), {
    return(Option(String).Some(`\`${type_to_string(&ty)}\` implements ${tn}`));
  });
  if(_capture_struct_declares_mut(&ty), {
    return(Option(String).Some(String.from("the closure has a `&mut` capture, and two copies of one exclusive borrow would alias")));
  });
  // The first move-only component, as `<label> : <type>` and its own reason.
  // Only a component `type_is_move_only` accepts is descended into, so the
  // walk follows one path to the declaring type at any depth instead of
  // searching every component (a shared sub-graph would make that
  // exponential once no depth cap bounds it).
  labels := ArrayList(String).new();
  comps := ArrayList(TypeValue).new();
  match(
    ty,
    Rc(.Array(element : elem, length : _)) => {
      labels.push(String.from("elements"));
      comps.push(elem);
    },
    Rc(.Tuple({ field_types : fields })) => {
      (i : usize) = usize(0);
      while(i < fields.len(), {
        labels.push(`element ${i.to_string()}`);
        comps.push(match(fields.get(i), .Some(f) => f, .None => rc(TypeValueNode.Unit)));
        i = (i + usize(1));
      });
    },
    Rc(.Struct({ field_labels : fls, field_types : fields })) => {
      (i : usize) = usize(0);
      while(i < fields.len(), {
        fl := match(fls.get(i), .Some(l) => l, .None => String.new());
        labels.push(`field \`${fl}\``);
        comps.push(match(fields.get(i), .Some(f) => f, .None => rc(TypeValueNode.Unit)));
        i = (i + usize(1));
      });
    },
    Rc(.EnumT({ variant_names : vns, variant_fields : all_fields })) => {
      (vi : usize) = usize(0);
      while(vi < all_fields.len(), {
        vf := match(all_fields.get(vi), .Some(f) => f, .None => no_types());
        vn := match(vns.get(vi), .Some(n) => n, .None => String.new());
        (fi : usize) = usize(0);
        while(fi < vf.len(), {
          labels.push(`variant \`${vn}\``);
          comps.push(match(vf.get(fi), .Some(f) => f, .None => rc(TypeValueNode.Unit)));
          fi = (fi + usize(1));
        });
        vi = (vi + usize(1));
      });
    },
    Rc(.SomeT({ resolution : rc })) => match(
      rc,
      .Some(concrete) => {
        return(recur(&concrete, depth + u32(1)));
      },
      .None => ()
    ),
    _ => ()
  );
  (ci : usize) = usize(0);
  while(ci < comps.len(), {
    c := match(comps.get(ci), .Some(t) => t, .None => rc(TypeValueNode.Unit));
    match(
      cond(type_is_move_only(&c) => recur(&c, depth + u32(1)), true => Option(String).None),
      .Some(inner) => {
        lbl := match(labels.get(ci), .Some(l) => l, .None => String.new());
        return(Option(String).Some(`\`${type_to_string(&ty)}\` holds a move-only value in its ${lbl} (\`${type_to_string(&c)}\`): ${inner}`));
      },
      .None => ()
    );
    ci = (ci + usize(1));
  });
  Option(String).None
});
/// The walk behind `type_contains_rc_type` (`flip`) and
/// `type_contains_rc_cell_or_move_only`. `_TypeWalk` ends it on a cycle (a
/// recursive type reached through itself) and walks a shared sub-graph once;
/// no nesting depth answers for it.
_type_contains_rc_inner :: (fn(ty_in : &TypeValue, w : &mut _TypeWalk, depth : u32, flip : bool) -> bool)({
  // Resolve recursive-type SHELLS to their registered finals first — same
  // reasoning as get_size_of_type (fifth shell-consumption site). An empty
  // shell walks to `false`, and a specialization whose T binding is the
  // recursive-Self shell (e.g. ArrayList(JsonValue).push's `value` param)
  // then SKIPS set_expr_as_needs_to_call_dup's element retain — the pushed
  // element's payload is freed when the caller's Result temp drops (the
  // json `["abc"]` / `{"k": "v"}` value-loss). `_TypeWalk`'s path guards the
  // recursive descent the resolution re-opens.
  ty := resolve_enum_shell(resolve_struct_shell(ty_in));
  cond(
    (depth > _TYPE_WALK_MAX_DEPTH) => {
      w.cut = true;
      false
    },
    // Direct RC type
    is_rc_type(&ty) => true,
    // A move-only value (§3.4) has a drop to run (its `drop`) and an
    // owner to track, exactly like an RC value; its fields are walked below.
    _nominal_declares_move_only(&ty) => true,
    // A closure with a `mut` capture is move-only too (decision 35).
    _capture_struct_declares_mut(&ty) => true,
    // Decision 36's flip: a plain-data value type that is not `Copy` is
    // copied only explicitly, so, like a move-only value, its owner is
    // tracked (a call or constructor result transfers, a named local is
    // consumed by a move). The value types reaching here are the nominal
    // structs and enums (a `ref` one is `is_rc_type` above).
    (flip && _nominal_lacks_copy(&ty)) => true,
    true => match(
      ty,
      // Array — recurse on element type
      Rc(.Array(element : elem, length : _)) =>
        recur(&elem, w, depth + u32(1), flip),
      // Tuple — check all field types
      Rc(.Tuple(field_labels : _, field_types : fields)) => match(
        _type_walk_enter(w, &ty, depth),
        .Some(seen) => seen,
        .None => {
          (found : bool) = false;
          (i : usize) = usize(0);
          while((i < fields.len()) && !found, {
            match(
              fields.get(i),
              .Some(ft) => {
                found = recur(&ft, w, depth + u32(1), flip);
              },
              .None => ()
            );
            i = (i + usize(1));
          });
          _type_walk_leave(w, &ty, depth, found)
        }
      ),
      // Union — check all field types
      Rc(.Union(name : _, field_labels : _, field_types : fields)) => match(
        _type_walk_enter(w, &ty, depth),
        .Some(seen) => seen,
        .None => {
          (found : bool) = false;
          (i : usize) = usize(0);
          while((i < fields.len()) && !found, {
            match(
              fields.get(i),
              .Some(ft) => {
                found = recur(&ft, w, depth + u32(1), flip);
              },
              .None => ()
            );
            i = (i + usize(1));
          });
          _type_walk_leave(w, &ty, depth, found)
        }
      ),
      // Struct — check all field types
      Rc(.Struct({ field_types : fields })) => match(
        _type_walk_enter(w, &ty, depth),
        .Some(seen) => seen,
        .None => {
          (found : bool) = false;
          (i : usize) = usize(0);
          while((i < fields.len()) && !found, {
            match(
              fields.get(i),
              .Some(ft) => {
                found = recur(&ft, w, depth + u32(1), flip);
              },
              .None => ()
            );
            i = (i + usize(1));
          });
          _type_walk_leave(w, &ty, depth, found)
        }
      ),
      // EnumT — check all variant fields
      Rc(.EnumT({ variant_fields : all_fields })) => match(
        _type_walk_enter(w, &ty, depth),
        .Some(seen) => seen,
        .None => {
          (found : bool) = false;
          (vi : usize) = usize(0);
          while((vi < all_fields.len()) && !found, {
            match(
              all_fields.get(vi),
              .Some(v_fields) => {
                (fi : usize) = usize(0);
                while((fi < v_fields.len()) && !found, {
                  match(
                    v_fields.get(fi),
                    .Some(ft) => {
                      found = recur(&ft, w, depth + u32(1), flip);
                    },
                    .None => ()
                  );
                  fi = (fi + usize(1));
                });
              },
              .None => ()
            );
            vi = (vi + usize(1));
          });
          _type_walk_leave(w, &ty, depth, found)
        }
      ),
      // SomeT — follow the resolved concrete type if present; an unresolved
      // SomeType is treated as RC. The Future carve-out is already handled
      // by `is_rc_type(ty)` above (line ~307). Without this follow-through a
      // SomeType resolved to a NON-RC concrete (e.g. a plain struct returned by
      // a comptime call) was reported RC → its result temp was marked owning →
      // the return-tail dup was skipped → stage-2 comptime_list evaluated_arg
      // over-release (issues/retired/yo-self-stage2-unwind-check-coverage.md).
      Rc(.SomeT({ required_trait_types : _, resolution : resolved })) => match(
        resolved,
        .Some(concrete) => recur(&concrete, w, depth + u32(1), flip),
        .None => true
      ),
      // Function — false (functions are not reference types)
      Rc(.Func({ result : _ })) => false,
      // Everything else — false
      _ => false
    )
  )
});
/// True when no SomeT inside `t` is an open type variable: each is an extern
/// opaque type (a concrete C type wearing a SomeT, such as `AtomicI32`'s
/// `atomic_int`) or resolves, through its resolution chain, to a non-SomeT type. A
/// rule that applies only to a concrete type must still apply to such a `t`
/// (issues/fixed/an-atomic-field-exempts-an-iso-graph-from-rule-d9.md).
type_has_no_open_some :: (fn(t : &TypeValue) -> bool)({
  hno_somes := get_all_some_types(t);
  (hno_i : usize) = usize(0);
  while(hno_i < hno_somes.len(), {
    match(
      hno_somes.get(hno_i),
      .Some(hno_s) => {
        if(is_some_type(resolve_cell_chain(&hno_s)), {
          return(false);
        });
      },
      .None => ()
    );
    hno_i = (hno_i + usize(1));
  });
  true
});
/// Return `true` if the type contains an RC-managed type (object/Dyn) or
/// a move-only value (`type_is_move_only`): a value whose copies and drops the
/// ownership machinery must track. `Type.contains_rc_type(T)` reads this too,
/// which is what makes a container drop (and so dispose) its move-only
/// elements.
///
/// Recursively checks compound types (Array, Tuple, Union, Struct, Enum)
/// at any depth; `_TypeWalk` ends the walk on a self-referential type.
type_contains_rc_type :: (fn(ty : &TypeValue) -> bool)({
  w := _type_walk_new();
  _type_contains_rc_inner(ty, &mut w, u32(0), true)
});
/// `type_contains_rc_type` before decision 36's flip: an RC cell, `Dyn` or
/// a move-only value, but not a plain-data value merely lacking
/// `Copy`. What the flip's own predicate and the compile-time value of a temp
/// are decided on.
type_contains_rc_cell_or_move_only :: (fn(ty : &TypeValue) -> bool)({
  w := _type_walk_new();
  _type_contains_rc_inner(ty, &mut w, u32(0), false)
});
/// Does a value of `ty` reach a NON-ATOMIC cell — a `ref(struct)`/`ref(enum)`
/// that is not atomic (`Rc`, today's `Box`, `ArrayList`'s buffer cell, a user
/// `ref(struct)`), or a `Dyn`'s shared box? The walk goes through value
/// aggregates inline and stops at atomic cells, which are shared safely
/// already. Unlike `type_contains_rc_type` it ignores move-only values that
/// hold no cell.
///
/// It is what `Send` refuses: a value is `Send` only if it reaches none
/// (plans/VALUES_BY_DEFAULT.md §3.8), which the marker derivation states field
/// by field. Box tracing and the `Acyclic` derivation read it too.
type_reaches_non_atomic_cell :: (fn(ty : &TypeValue) -> bool)({
  w := _type_walk_new();
  _reaches_non_atomic_cell_inner(ty, &mut w, u32(0))
});
_any_reaches_non_atomic_cell :: (fn(fields : &ArrayList(TypeValue), w : &mut _TypeWalk, depth : u32) -> bool)({
  (i : usize) = usize(0);
  while(i < fields.len(), {
    match(
      fields.get(i),
      .Some(ft) => if(_reaches_non_atomic_cell_inner(&ft, w, depth), {
        return(true);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  false
});
_reaches_non_atomic_cell_inner :: (fn(ty_in : &TypeValue, w : &mut _TypeWalk, depth : u32) -> bool)({
  ty := resolve_enum_shell(resolve_struct_shell(ty_in));
  if(depth > _TYPE_WALK_MAX_DEPTH, {
    w.cut = true;
    return(false);
  });
  // The unique `Box` owns its payload inline (V1 step 2): it reaches what
  // its payload reaches.
  match(
    unique_box_payload_type(&ty),
    .Some(payload) => {
      return(recur(&payload, w, depth + u32(1)));
    },
    .None => ()
  );
  match(
    ty,
    Rc(.Struct({ field_types : fields, is_reference_semantics : is_ref, is_atomic_rc : is_atomic })) => cond(
      (is_ref && !is_atomic) => true,
      is_ref => false,
      // A value reaches what its `?(*(E))` buffer's elements reach (V2b's
      // unique buffers: the elements are part of the value).
      true => match(
        _type_walk_enter(w, &ty, depth),
        .Some(seen) => seen,
        .None => {
          found := (_any_reaches_non_atomic_cell(&fields.items, w, depth + u32(1)) || _any_reaches_non_atomic_cell(&buffer_element_types(&fields.items), w, depth + u32(1)));
          _type_walk_leave(w, &ty, depth, found)
        }
      )
    ),
    Rc(.EnumT({ variant_fields : all_fields, is_reference_semantics : e_is_ref, is_atomic_rc : e_is_atomic })) => cond(
      (e_is_ref && !e_is_atomic) => true,
      e_is_ref => false,
      true => match(
        _type_walk_enter(w, &ty, depth),
        .Some(seen) => seen,
        .None => {
          (found : bool) = false;
          (vi : usize) = usize(0);
          while((vi < all_fields.len()) && !found, {
            match(
              all_fields.get(vi),
              .Some(v_fields) => {
                found = _any_reaches_non_atomic_cell(&v_fields.items, w, depth + u32(1));
              },
              .None => ()
            );
            vi = (vi + usize(1));
          });
          _type_walk_leave(w, &ty, depth, found)
        }
      )
    ),
    Rc(.Tuple(field_labels : _, field_types : fields)) => match(
      _type_walk_enter(w, &ty, depth),
      .Some(seen) => seen,
      .None => {
        found := _any_reaches_non_atomic_cell(&fields.items, w, depth + u32(1));
        _type_walk_leave(w, &ty, depth, found)
      }
    ),
    Rc(.Union(name : _, field_labels : _, field_types : fields)) => match(
      _type_walk_enter(w, &ty, depth),
      .Some(seen) => seen,
      .None => {
        found := _any_reaches_non_atomic_cell(&fields.items, w, depth + u32(1));
        _type_walk_leave(w, &ty, depth, found)
      }
    ),
    Rc(.Array(element : elem, length : _)) => recur(&elem, w, depth + u32(1)),
    Rc(.DynT(required_trait_types : _)) => true,
    Rc(.SomeT({ resolution : resolved })) => match(
      resolved,
      .Some(concrete) => recur(&concrete, w, depth + u32(1)),
      .None => false
    ),
    _ => false
  )
});
/// The walk behind `type_is_control_bound`. It goes through pointers and
/// reference objects too (a `*(Node)` field of `Node`), so self-reference is
/// common here: `_TypeWalk`'s path ends each cycle where it closes, and its
/// memo walks a shared sub-graph once.
_type_is_control_bound_inner :: (fn(ty : &TypeValue, w : &mut _TypeWalk, depth : u32) -> bool)(
  cond(
    (depth > _TYPE_WALK_MAX_DEPTH) => {
      w.cut = true;
      false
    },
    true => match(
      ty,
      // Only a `ctl(...) -> ret` function value is itself control-bound. A
      // regular `fn(...)` is a plain fn pointer — even if its params/return
      // reference `ctl`, the value does not carry a CF (it merely calls one
      // the caller provides).
      Rc(.Func({ meta : __fm1 })) => __fm1.*.is_control,
      // Aggregates — control-bound iff any field is.
      Rc(.Struct({ field_types : fields })) => match(
        _type_walk_enter(w, ty, depth),
        .Some(seen) => seen,
        .None => {
          (found : bool) = false;
          (i : usize) = usize(0);
          while((i < fields.len()) && !found, {
            match(
              fields.get(i),
              .Some(ft) => {
                found = recur(&ft, w, depth + u32(1));
              },
              .None => ()
            );
            i = (i + usize(1));
          });
          _type_walk_leave(w, ty, depth, found)
        }
      ),
      Rc(.Tuple(field_labels : _, field_types : fields)) => match(
        _type_walk_enter(w, ty, depth),
        .Some(seen) => seen,
        .None => {
          (found : bool) = false;
          (i : usize) = usize(0);
          while((i < fields.len()) && !found, {
            match(
              fields.get(i),
              .Some(ft) => {
                found = recur(&ft, w, depth + u32(1));
              },
              .None => ()
            );
            i = (i + usize(1));
          });
          _type_walk_leave(w, ty, depth, found)
        }
      ),
      Rc(.Union(name : _, field_labels : _, field_types : fields)) => match(
        _type_walk_enter(w, ty, depth),
        .Some(seen) => seen,
        .None => {
          (found : bool) = false;
          (i : usize) = usize(0);
          while((i < fields.len()) && !found, {
            match(
              fields.get(i),
              .Some(ft) => {
                found = recur(&ft, w, depth + u32(1));
              },
              .None => ()
            );
            i = (i + usize(1));
          });
          _type_walk_leave(w, ty, depth, found)
        }
      ),
      Rc(.EnumT({ variant_fields : all_fields })) => match(
        _type_walk_enter(w, ty, depth),
        .Some(seen) => seen,
        .None => {
          (found : bool) = false;
          (vi : usize) = usize(0);
          while((vi < all_fields.len()) && !found, {
            match(
              all_fields.get(vi),
              .Some(v_fields) => {
                (fi : usize) = usize(0);
                while((fi < v_fields.len()) && !found, {
                  match(
                    v_fields.get(fi),
                    .Some(ft) => {
                      found = recur(&ft, w, depth + u32(1));
                    },
                    .None => ()
                  );
                  fi = (fi + usize(1));
                });
              },
              .None => ()
            );
            vi = (vi + usize(1));
          });
          _type_walk_leave(w, ty, depth, found)
        }
      ),
      // Element/pointee recursion (rule 11: a pointer to a ctl type is itself
      // control-bound — `*(Raise)` must be rejected).
      Rc(.Array(element : elem, length : _, length_var : _)) => recur(&elem, w, depth + u32(1)),
      Rc(.Pointer(pointee : p)) => recur(&p, w, depth + u32(1)),
      // SomeT — conservatively false (no resolved concrete type to follow
      // on this path).
      _ => false
    )
  )
);
/// Return `true` if `ty` is control-bound — i.e. it IS, or transitively
/// contains, a `ctl(...) -> ret` control-function type. Such a value is
/// frame-bound (its body may `unwind` out of the install frame), so it must
/// not escape: be bound at module level, captured by a closure, or have a
/// pointer formed to it (the §4 escape-boundary / ctl rules in the algebraic
/// effects analysis).
type_is_control_bound :: (fn(ty : &TypeValue) -> bool)({
  w := _type_walk_new();
  _type_is_control_bound_inner(ty, &mut w, u32(0))
});
/// The error for a control-bound field of a reference or atomic type.
control_bound_field_message :: (fn(label : &String, ty : &TypeValue) -> String)(
  `Field "${label}" of a reference type cannot hold ${type_to_string(ty)}: it is (or contains) a \`ctl\` handler, which unwinds into the frame that installed it. A reference object outlives that frame, so a later call through the object would unwind into a frame that no longer exists. Pass the handler as an argument instead, or keep it in a value struct.`
);
/// True iff `id` is already in `visited` (linear scan; visited lists are tiny).
_id_already_visited :: (fn(visited : &ArrayList(String), id : &String) -> bool)({
  (i : usize) = usize(0);
  n := visited.len();
  (found : bool) = false;
  while((i < n) && !found, {
    match(
      visited.get(i),
      .Some(v) => if(v == id, {
        found = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// Walker for `can_type_form_rc_cycle`: does `ty` (a field type reached from the
/// root ref-struct `original_id`) reference back to a cyclic RC object?
/// `visited` holds the
/// ids of the RC structs / enums already on the current path (id-keyed cycle
/// guard — sound now that ref types carry stable ids). A different RC struct
/// re-roots the search inline (recur with its id as the new `original_id` and
/// itself pushed onto `visited`), so no separate mutually-recursive entry is
/// needed. The enum branch carries the same visited guard the struct path has
/// (a recursive `ref(enum(… Self …))` would otherwise loop forever).
/// Extract the element type a container holds behind its `?(*(E))` heap buffer field
/// — the pointee `E` of the Option-wrapped pointer. Used to see through a
/// container to its elements both for cycle detection and for the Acyclic
/// auto-derive. A bare `*(E)` is intentionally
/// NOT matched (non-owning raw pointer; doesn't participate in ARC cycles).
buffer_element_type :: (fn(ty : &TypeValue) -> Option(TypeValue))(
  match(
    ty,
    Rc(.EnumT({ variant_fields })) => {
      (result : Option(TypeValue)) = Option(TypeValue).None;
      (vi : usize) = usize(0);
      while((vi < variant_fields.len()) && result.is_none(), {
        match(
          variant_fields.get(vi),
          .Some(vf) => {
            (fi : usize) = usize(0);
            while((fi < vf.len()) && result.is_none(), {
              match(
                vf.get(fi),
                .Some(Rc(.Pointer(pointee))) => {
                  result = Option(TypeValue).Some(pointee);
                },
                .Some(_) => (),
                .None => ()
              );
              fi = (fi + usize(1));
            });
          },
          .None => ()
        );
        vi = (vi + usize(1));
      });
      result
    },
    _ => Option(TypeValue).None
  )
);
/// The `buffer_element_type` of every field that has one.
buffer_element_types :: (fn(fields : &ArrayList(TypeValue)) -> ArrayList(TypeValue))({
  out := ArrayList(TypeValue).new();
  (i : usize) = usize(0);
  while(i < fields.len(), i = (i + usize(1)), {
    match(
      fields.get(i),
      .Some(f) => match(buffer_element_type(&f), .Some(e) => out.push(e), .None => ()),
      .None => ()
    );
  });
  out
});
/// What a VALUE struct's `Acyclic` requires (V2b's unique buffers): every
/// field, plus each element of a buffer the value owns that reaches a
/// non-atomic cell. The elements are part of the value, but the `?(*(E))`
/// field reads as Acyclic whatever `E` is (`*(T)` is unconditionally
/// Acyclic), so the definition-time derive and the trait checker's on-demand
/// re-derivation both check this list instead of the fields alone. An element
/// that reaches no cell (`?*void`, plain data) is no cycle risk.
value_acyclic_obligations :: (fn(fields : &ArrayList(TypeValue)) -> ArrayList(TypeValue))({
  out := fields.clone();
  elems := buffer_element_types(fields);
  (i : usize) = usize(0);
  while(i < elems.len(), i = (i + usize(1)), {
    match(
      elems.get(i),
      .Some(e) => if(type_reaches_non_atomic_cell(&e), {
        out.push(e);
      }),
      .None => ()
    );
  });
  out
});
/// Does a value type own a heap buffer the field walk cannot see: a struct
/// (or newtype) that is not a reference type, with a `?(*(E))` field? Such a
/// value may implement `Trace` (V2b's unique buffers), and the cycle and
/// reach walks see through the field to its elements.
value_type_owns_buffer :: (fn(ty : &TypeValue) -> bool)(
  match(
    ty,
    Rc(.Struct({ field_types : fields, is_reference_semantics : is_ref })) => (!is_ref && (buffer_element_types(&fields.items).len() > usize(0))),
    _ => false
  )
);
/// A buffer-owning value (`value_type_owns_buffer`) that also declares a
/// destructor (`Drop`) of its own, so it frees the buffer: an
/// owner, as opposed to a view such as an iterator holding a `?*E` into
/// someone else's buffer. At unresolved type parameters (`Buf(T)` in a
/// generic signature) the declaration's generic `Drop` impl decides
/// (`GenericOwnerDropFn`).
value_type_owns_buffer_outright :: (fn(ty : &TypeValue) -> bool)(
  value_type_owns_buffer(ty) && {
    shell := resolve_enum_shell(resolve_struct_shell(ty));
    _nominal_declares_move_only(&shell) || (g_move_only_possible && match(g_generic_owner_drop_fn, .Some(f) => f(&shell), .None => false))
  }
);
/// Type ids an explicit `impl(T, Acyclic())` declares (recorded by
/// `values/impl.yo` when the impl is checked). A declared `Acyclic` exempts
/// the type from cycle collection (plans/VALUES_BY_DEFAULT.md §3.12): the
/// compiler's `Rc`-child trees (decision 21) have no back edges, and
/// `can_type_form_rc_cycle`'s codegen callers have no Environment to ask the
/// trait registry, so the declaration is kept here.
(g_declared_acyclic_ids : RefCell(HashSet(String))) = RefCell(HashSet(String)).new(HashSet(String).new());
declare_acyclic_type_id :: (fn(id : &String) -> unit)({
  _ := g_declared_acyclic_ids.with_mut(s => s.insert(id.clone()));
});
/// Is `ty` a struct or enum whose `Acyclic` impl is declared?
_declared_acyclic :: (fn(ty : &TypeValue) -> bool)(
  match(
    ty,
    Rc(.Struct({ id : sid })) => ((sid.len() > usize(0)) && g_declared_acyclic_ids.with(s => s.contains(&sid))),
    Rc(.EnumT({ id : eid })) => ((eid.len() > usize(0)) && g_declared_acyclic_ids.with(s => s.contains(&eid))),
    _ => false
  )
);
/// The cycle walk's cut key for one buffer-owning instantiation: its
/// structural key, since every instantiation of a generic struct shares the
/// struct id.
_buffer_cut_key :: (fn(ty : &TypeValue) -> String)({
  seen := HashSet(String).new();
  `buffer:${type_intern_key(ty, usize(0), &mut seen)}`
});
_type_refs_back_to_cyclic :: (
  fn(ty_in : &TypeValue, original_id : &String, visited : &ArrayList(String)) -> bool
)({
  // A self-referential declaration's shell can survive inside a nested
  // instantiation — a list of ref cells over `Self` reaches `Self` only
  // through the cell's `?*Self` element buffer, behind the shell patch walk's
  // shared-node guard — and a shell is an empty placeholder struct, so the
  // walk read the path back to a re-rooted cycle as a dead end. Resolve it
  // through the finals registries first, as this file's other structural
  // walks do
  // (issues/fixed/2026-10-18-a-linkedlist-of-managed-elements-forms-uncollected-cycles.md).
  ty := resolve_enum_shell(resolve_struct_shell(ty_in));
  // A declared-`Acyclic` type reaches no cycle, whatever its fields hold.
  !_declared_acyclic(&ty) && match(
    ty,
    Rc(.Struct({ id : sid, field_types : sfields, is_reference_semantics : sref })) => cond(
      // Direct self-reference back to the current root.
      (sid == original_id) => true,
      // A different RC object — re-root the search at it, with a fresh
      // visited set seeded from the current path.
      sref => cond(
        _id_already_visited(visited, &sid) => true,
        true => {
          v2 := visited.clone();
          v2.push(sid);
          (found : bool) = false;
          (i : usize) = usize(0);
          while((i < sfields.len()) && !found, {
            match(
              sfields.get(i),
              .Some(ft) => if(recur(&ft, &sid, &v2), {
                found = true;
              }),
              .None => ()
            );
            i = (i + usize(1));
          });
          // Container buffer-walk: a `?(*(E))` field holds elements the field walk
          // above cannot see (raw pointer); trace the element type so element cycles
          // (`ArrayList(Self)` etc.) are detected.
          if(!found, {
            (bi : usize) = usize(0);
            while((bi < sfields.len()) && !found, {
              match(
                sfields.get(bi),
                .Some(ft) => match(
                  buffer_element_type(&ft),
                  .Some(elem) => if(recur(&elem, &sid, &v2), {
                    found = true;
                  }),
                  .None => ()
                ),
                .None => ()
              );
              bi = (bi + usize(1));
            });
          });
          found
        }
      ),
      // The unique `Box` (V1 step 2): its payload is part of its owner's
      // value, so a cycle closes through it like through an inline field.
      // A recursive payload (`Option(Box(Self))`) is cut by the Box's id.
      unique_box_payload_type(&ty).is_some() => cond(
        _id_already_visited(visited, &sid) => false,
        true => {
          v2 := visited.clone();
          v2.push(sid.clone());
          match(unique_box_payload_type(&ty), .Some(payload) => recur(&payload, original_id, &v2), .None => false)
        }
      ),
      // Value-type struct (struct / newtype): stored inline but may hold RC
      // references that close a cycle. Keep the same root.
      true => {
        (found : bool) = false;
        (i : usize) = usize(0);
        while((i < sfields.len()) && !found, {
          match(
            sfields.get(i),
            .Some(ft) => if(recur(&ft, original_id, visited), {
              found = true;
            }),
            .None => ()
          );
          i = (i + usize(1));
        });
        // A value that owns a `?(*(E))` buffer (V2b's unique buffers): its
        // elements are part of the value, so a cycle closes through them as
        // through an inline field. The instantiation's key cuts a value
        // whose elements hold it again (`struct(kids : List(Self))`); the
        // struct id would not do, because every instantiation of a generic
        // struct shares it.
        has_buffer := (!found && (buffer_element_types(&sfields.items).len() > usize(0)));
        buf_key := if(has_buffer, _buffer_cut_key(&ty), String.new());
        if(has_buffer && !_id_already_visited(visited, &buf_key), {
          v2 := visited.clone();
          v2.push(buf_key);
          (bi : usize) = usize(0);
          while((bi < sfields.len()) && !found, {
            match(
              sfields.get(bi),
              .Some(ft) => match(
                buffer_element_type(&ft),
                .Some(elem) => if(recur(&elem, original_id, &v2), {
                  found = true;
                }),
                .None => ()
              ),
              .None => ()
            );
            bi = (bi + usize(1));
          });
        });
        found
      }
    ),
    // Enum variants — guard with `visited` (by enum id) so a recursive ref-enum
    // does not loop forever.
    Rc(.EnumT({ id : eid, variant_fields : vfs })) => cond(
      // Direct self-reference back to a ref-enum root (must precede the visited
      // guard, which would otherwise hide the root's own id).
      (eid == original_id) => true,
      _id_already_visited(visited, &eid) => false,
      true => {
        v2 := visited.clone();
        v2.push(eid);
        (found : bool) = false;
        (vi : usize) = usize(0);
        while((vi < vfs.len()) && !found, {
          match(
            vfs.get(vi),
            .Some(vf) => {
              (fi : usize) = usize(0);
              while((fi < vf.len()) && !found, {
                match(
                  vf.get(fi),
                  .Some(ft) => if(recur(&ft, original_id, &v2), {
                    found = true;
                  }),
                  .None => ()
                );
                fi = (fi + usize(1));
              });
            },
            .None => ()
          );
          vi = (vi + usize(1));
        });
        found
      }
    ),
    // A SomeType could resolve to anything — be conservative (its
    // resolution, if any, is not followed here). An extern/`c_include`
    // opaque type (`atomic_int : Type`, the `ExternOpaqueT` arm below) is a
    // C value that holds no Yo reference at all: answering "cyclic" for it made
    // every `AtomicI32` — and so every struct holding a shared atomic counter
    // — look cycle-capable, which `^` refuses and the collector tracks.
    // And a closure identity (`is_bound_closure_identity`) IS its
    // resolution, the capture struct, so the struct is what is judged
    // (issues/fixed/a-container-of-a-closure-type-does-not-compile.md).
    Rc(.SomeT(name : _)) => cond(
      is_bound_closure_identity(&ty) => recur(resolve_cell_chain(&ty), original_id, visited),
      true => true
    ),
    Rc(.ExternOpaqueT(_, _)) => false,
    Rc(.Array({ element : el })) => recur(&el, original_id, visited),
    Rc(.Tuple({ field_types : tf })) => {
      (found : bool) = false;
      (i : usize) = usize(0);
      while((i < tf.len()) && !found, {
        match(
          tf.get(i),
          .Some(ft) => if(recur(&ft, original_id, visited), {
            found = true;
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    Rc(.Union({ field_types : uf })) => {
      (found : bool) = false;
      (i : usize) = usize(0);
      while((i < uf.len()) && !found, {
        match(
          uf.get(i),
          .Some(ft) => if(recur(&ft, original_id, visited), {
            found = true;
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    // Dynamic-dispatch types can hold object types — conservative.
    Rc(.DynT(required_trait_types : _)) => true,
    // Raw pointers/references and primitives do not participate in ARC.
    _ => false
  )
});
/// Return `true` if `ty` can form an RC reference cycle — used to decide which
/// reference-semantics types need cycle-collecting GC. Structural DFS with an
/// id-keyed visited set. A type with a DECLARED `impl(T, Acyclic())` is not a
/// cycle root and stops the walk (`g_declared_acyclic_ids`, recorded when the
/// impl is checked, since the codegen call sites carry no `Environment`); a
/// derived `Acyclic` changes nothing here, because it is derived from this
/// very walk.
can_type_form_rc_cycle :: (fn(ty : &TypeValue) -> bool)(
  cond(
    // A declared `Acyclic` (§3.12) is not a cycle root.
    _declared_acyclic(ty) => false,
    is_reference_struct_type(ty) => match(
      ty,
      Rc(.Struct({ id : sid, field_types : fields })) => {
        visited := ArrayList(String).new();
        visited.push(sid.clone());
        (found : bool) = false;
        (i : usize) = usize(0);
        while((i < fields.len()) && !found, {
          match(
            fields.get(i),
            .Some(ft) => if(_type_refs_back_to_cyclic(&ft, &sid, &visited), {
              found = true;
            }),
            .None => ()
          );
          i = (i + usize(1));
        });
        // Container buffer-walk: a `?(*(E))` field holds elements the field walk
        // above cannot see (raw pointer); trace the element type so element cycles
        // (`ArrayList(Self)` etc.) are detected.
        if(!found, {
          (bi : usize) = usize(0);
          while((bi < fields.len()) && !found, {
            match(
              fields.get(bi),
              .Some(ft) => match(
                buffer_element_type(&ft),
                .Some(elem) => if(_type_refs_back_to_cyclic(&elem, &sid, &visited), {
                  found = true;
                }),
                .None => ()
              ),
              .None => ()
            );
            bi = (bi + usize(1));
          });
        });
        found
      },
      _ => false
    ),
    // A reference-semantics enum can also form an RC cycle (e.g. a recursive
    // `Self`-valued variant field), so it is a cycle root too. Walk every
    // variant's fields, keyed on the enum's own id. The root's id is NOT
    // seeded into `visited`, as in the per-variant registration gate
    // (codegen/functions/constructors.yo): the walk re-roots at a reference
    // struct, and an enum met again after that re-root (`Kids(k :
    // ArrayList(Self))`: enum -> list -> enum) must be walked, not answered
    // `false` by the visited guard. A direct `Self` edge is still found by
    // the `eid == original_id` check, which precedes that guard
    // (issues/fixed/2026-10-20-a-ref-enum-cycle-through-a-ref-struct-is-never-collected.md).
    is_reference_enum_type(ty) => match(
      ty,
      Rc(.EnumT({ id : eid, variant_fields : vfs })) => {
        visited := ArrayList(String).new();
        (found : bool) = false;
        (vi : usize) = usize(0);
        while((vi < vfs.len()) && !found, {
          match(
            vfs.get(vi),
            .Some(vf) => {
              (fi : usize) = usize(0);
              while((fi < vf.len()) && !found, {
                match(
                  vf.get(fi),
                  .Some(ft) => if(_type_refs_back_to_cyclic(&ft, &eid, &visited), {
                    found = true;
                  }),
                  .None => ()
                );
                fi = (fi + usize(1));
              });
            },
            .None => ()
          );
          vi = (vi + usize(1));
        });
        found
      },
      _ => false
    ),
    true => false
  )
);
/// Whether a reference-semantics type uses the SMALL RC header
/// (`__yo_ref_header_small_t`, 16 B) instead of the full 56 B one:
/// cycle-INCAPABLE, non-atomic
/// types in a cycle-GC program — exactly the ones whose constructors never
/// `__yo_gc_register`. Call sites are already inside reference-semantics
/// branches and pass their own atomicity, so this reduces to the predicate
/// core. See plans/backlog/RC_HEADER_SPLIT.md.
type_uses_small_rc_header :: (
  fn(ty : &TypeValue, needs_cycle_gc : bool, is_atomic : bool) -> bool
)(
  cond(
    !needs_cycle_gc => false,
    is_atomic => false,
    true => !can_type_form_rc_cycle(ty)
  )
);
/// Return `true` if the type needs type-inference to resolve fully
/// — specifically when an `Array(T, length)` carries an unknown
/// `length` that the evaluator must compute.
///
/// **Stub returning `false`** — `Array(element, length)`
/// stores `length` as a plain `usize`, which is always concretely
/// known: unknown array lengths are rejected at parse time. Should a
/// deferred-length mechanism ever be added, this stub should walk
/// `Array.length` and recurse on `Array.element` /
/// tuple/struct/enum field types.
type_requires_inference :: (fn(_ty : &TypeValue) -> bool)(false);
/// Return `true` if `ty` contains any unresolved generic type variable
/// (`SomeT` / `TypeAppT`).
///
/// Checks the top-level variant only; the full recursive traversal lives
/// in `_collect_some_types_into`.
///
type_contains_some_type :: (fn(ty : &TypeValue) -> bool)(
  match(
    ty,
    // A SomeType that
    // implements Fn or Future — or carries a per-object resolved concrete —
    // is CONCRETE at codegen time (closures lower to their capture struct /
    // FnTraitT; futures to state-machine structs). Without this carve-out the
    // contains-SomeT gates skip emitting Rc(Impl(Fn)) constructors and drop
    // Impl(Fn)-typed capture fields (the get_info cluster).
    Rc(.SomeT({ required_trait_types : cst_rtt, resolution : cst_rc })) => cond(
      cst_rc.is_some() => false,
      true => {
        (cst_has_fn_or_fut : bool) = false;
        (cst_i : usize) = usize(0);
        while(cst_i < cst_rtt.len(), {
          match(
            cst_rtt.get(cst_i),
            .Some(Rc(.FnTraitT(_, _, _, _, _, _, _, _))) => {
              cst_has_fn_or_fut = true;
            },
            .Some(Rc(.FutureTraitT(_, _, _, _))) => {
              cst_has_fn_or_fut = true;
            },
            .Some(_) => (),
            .None => ()
          );
          cst_i = (cst_i + usize(1));
        });
        !cst_has_fn_or_fut
      }
    ),
    Rc(.TypeAppT(constructor : _)) => true,
    _ => false
  )
);
/// Internal helper: recursively collect all SomeT instances from `ty` into `acc`.
/// Phase 3: no cycle detection (safe for acyclic TypeValue trees).
/// (`_id_already_visited` is defined earlier, before `_type_refs_back_to_cyclic`.)
_collect_some_types_into :: (
  fn(
    ty_in : &TypeValue,
    acc : &mut ArrayList(TypeValue),
    visited_ids : &mut ArrayList(String)
  ) -> unit
)({
  // Resolve struct/enum SHELLS before walking — the SAME convention
  // `type_key` (types/type_key.yo:86) and `stable_type_identity`
  // (types/type_key.yo:505) already follow, and creators.yo:559-568 mandates
  // for every FIELD-READING site (`_type_contains_rc_inner` below calls
  // itself the fifth shell-consumption site; this is the sixth). A recursive
  // generic (`ListNode(T)`) leaks a 0-FIELD struct shell into its enclosing
  // type, so an unresolved walk sees no fields and reports "no SomeTs" for a
  // type whose rendered key still carries raw SomeT ids — codegen then never
  // collects the concrete instance and `get_enum_variant_c_name` aborts
  // (tests: scratchpad/t2/v1_empty.yo, an empty `std/imm/map` suffices).
  ty := resolve_enum_shell(resolve_struct_shell(ty_in));
  // V6 task 3: a refinement is erased for layout — sizeof(refine(T, p))
  // == sizeof(T) (the zero-runtime-cost rule).
  ty = t_refine_inner(&ty);
  match(
    ty,
    Rc(.SomeT(_, _, _, _, _, _, _, _, _, _)) => {
      acc.push(ty);
    },
    Rc(.TypeAppT(constructor : con, args : args_list)) => {
      recur(&con, acc, visited_ids);
      (i : usize) = usize(0);
      n := args_list.len();
      while(i < n, {
        match(args_list.get(i), .Some(a) => recur(&a, acc, visited_ids), .None => ());
        i = (i + usize(1));
      });
    },
    Rc(.Array(element : el, _, _)) => {
      recur(&el, acc, visited_ids);
    },
    Rc(.Pointer(pointee : pt)) => {
      recur(&pt, acc, visited_ids);
    },
    Rc(.Func({ forall_types : ftys, param_types : ptys, result : res })) => {
      (i : usize) = usize(0);
      while(i < ftys.len(), {
        match(ftys.get(i), .Some(ft) => recur(&ft, acc, visited_ids), .None => ());
        i = (i + usize(1));
      });
      (j : usize) = usize(0);
      while(j < ptys.len(), {
        match(ptys.get(j), .Some(pt) => recur(&pt, acc, visited_ids), .None => ());
        j = (j + usize(1));
      });
      recur(&res, acc, visited_ids);
    },
    Rc(.Tuple(_, field_types : ftys)) => {
      (i : usize) = usize(0);
      while(i < ftys.len(), {
        match(ftys.get(i), .Some(ft) => recur(&ft, acc, visited_ids), .None => ());
        i = (i + usize(1));
      });
    },
    Rc(.Struct({ id : st_id, field_types : ftys })) => {
      // Cycle guard — recursive struct types (e.g. a branch node whose
      // children point back at the same struct) form a CYCLIC TypeValue
      // graph; an unguarded field walk recurses forever (pure-SIGSEGV,
      // no message). Same class of bug as `substitute()`'s
      // `visited_trait_ids` guard.
      if(_id_already_visited(visited_ids, &st_id), {
        return(());
      });
      if(st_id.len() > usize(0), {
        visited_ids.push(st_id);
      });
      (i : usize) = usize(0);
      while(i < ftys.len(), {
        match(ftys.get(i), .Some(ft) => recur(&ft, acc, visited_ids), .None => ());
        i = (i + usize(1));
      });
    },
    Rc(.EnumT(en_id, _, _, vfs, _, _, _, _, _, _)) => {
      // Cycle guard — see the Struct arm above.
      if(_id_already_visited(visited_ids, &en_id), {
        return(());
      });
      if(en_id.len() > usize(0), {
        visited_ids.push(en_id);
      });
      (vi : usize) = usize(0);
      while(vi < vfs.len(), {
        match(
          vfs.get(vi),
          .Some(field_list) => {
            (fi : usize) = usize(0);
            while(fi < field_list.len(), {
              match(field_list.get(fi), .Some(ft) => recur(&ft, acc, visited_ids), .None => ());
              fi = (fi + usize(1));
            });
          },
          .None => ()
        );
        vi = (vi + usize(1));
      });
    },
    _ => ()
  );
});
/// Collect all SomeT (generic type variable) instances found anywhere in `ty`.
/// Returns an ArrayList containing each SomeT found (in pre-order traversal).
/// Phase 3: does not track visited types (safe for acyclic TypeValue trees).
///
get_all_some_types :: (fn(ty : &TypeValue) -> ArrayList(TypeValue))({
  acc := ArrayList(TypeValue).new();
  visited_ids := ArrayList(String).new();
  _collect_some_types_into(ty, &mut acc, &mut visited_ids);
  acc
});
/// A value with nothing to transfer: no counted payload, implicitly
/// copyable, and a type of its own (a value typed by a type variable or an
/// opaque `Impl(...)` has no type to judge, so it keeps its move: an
/// `Impl(FnOnce(...))` call still consumes it). The test is the TOP-LEVEL
/// type only: a struct of generic fn pointers (the prelude's `Io`) is a
/// concrete `Copy` type. Such a value is COPIED into a by-value parameter and
/// is never consumed (V3b's flip, plans/VALUES_BY_DEFAULT.md decision 30).
type_is_bitwise_copy :: (fn(ty : TypeValue) -> bool)(
  !is_some_type(&ty) && !type_contains_rc_type(&ty) && !type_requires_explicit_copy(&ty)
);
/// Does `ty` mention a `SomeT` anywhere — through fields, elements, pointees
/// AND a generic instantiation's TYPE ARGUMENTS? `get_all_some_types` walks
/// fields and elements but not `type_arguments`, so it answers `[]` for a
/// pattern whose parameter no field mentions (`Tag(T)` = `struct(id : i32)`,
/// `T` carried only by the instantiation). Decision 36's open-pattern
/// coverage query (`generic_pattern_implements_trait`,
/// src/evaluator/values/impl.yo) gates on this wider question.
type_mentions_some_type :: (fn(ty : &TypeValue) -> bool)({
  visited_ids := ArrayList(String).new();
  _mentions_some_type_into(ty, &mut visited_ids)
});
_mentions_some_type_into :: (fn(ty_in : &TypeValue, visited_ids : &mut ArrayList(String)) -> bool)({
  // Same shell/refine conventions and cycle guards as
  // `_collect_some_types_into` above (its sixth-shell comment).
  ty := resolve_enum_shell(resolve_struct_shell(ty_in));
  ty = t_refine_inner(&ty);
  match(
    ty,
    Rc(.SomeT(_, _, _, _, _, _, _, _, _, _)) => true,
    Rc(.Struct({ id : st_id, field_types : st_fts, type_arguments : st_tas })) => {
      if(_id_already_visited(visited_ids, &st_id), {
        return(false);
      });
      if(st_id.len() > usize(0), {
        visited_ids.push(st_id.clone());
      });
      (tai : usize) = usize(0);
      while(tai < st_tas.len(), {
        if(recur(match(st_tas.get(tai), .Some(a) => a, .None => rc(TypeValueNode.Unit)), visited_ids), {
          return(true);
        });
        tai = (tai + usize(1));
      });
      (tfi : usize) = usize(0);
      while(tfi < st_fts.len(), {
        if(recur(match(st_fts.get(tfi), .Some(f) => f, .None => rc(TypeValueNode.Unit)), visited_ids), {
          return(true);
        });
        tfi = (tfi + usize(1));
      });
      false
    },
    Rc(.EnumT(en_id, _, _, en_vfs, _, _, _, _, _, en_tas)) => {
      if(_id_already_visited(visited_ids, &en_id), {
        return(false);
      });
      if(en_id.len() > usize(0), {
        visited_ids.push(en_id.clone());
      });
      (eai : usize) = usize(0);
      while(eai < en_tas.len(), {
        if(recur(match(en_tas.get(eai), .Some(a) => a, .None => rc(TypeValueNode.Unit)), visited_ids), {
          return(true);
        });
        eai = (eai + usize(1));
      });
      (evi : usize) = usize(0);
      while(evi < en_vfs.len(), {
        vf := match(en_vfs.get(evi), .Some(fl) => fl, .None => no_types());
        (efi : usize) = usize(0);
        while(efi < vf.len(), {
          if(recur(match(vf.get(efi), .Some(f) => f, .None => rc(TypeValueNode.Unit)), visited_ids), {
            return(true);
          });
          efi = (efi + usize(1));
        });
        evi = (evi + usize(1));
      });
      false
    },
    Rc(.Pointer(pt)) => recur(&pt, visited_ids),
    Rc(.Array(element : el, _, _)) => recur(&el, visited_ids),
    Rc(.TypeAppT(constructor : con, args : cargs)) => {
      if(recur(&con, visited_ids), {
        return(true);
      });
      (cai : usize) = usize(0);
      while(cai < cargs.len(), {
        if(recur(match(cargs.get(cai), .Some(a) => a, .None => rc(TypeValueNode.Unit)), visited_ids), {
          return(true);
        });
        cai = (cai + usize(1));
      });
      false
    },
    Rc(.Func({ forall_types : ftys, param_types : ptys, result : res })) => {
      (fi2 : usize) = usize(0);
      while(fi2 < ftys.len(), {
        if(recur(match(ftys.get(fi2), .Some(f) => f, .None => rc(TypeValueNode.Unit)), visited_ids), {
          return(true);
        });
        fi2 = (fi2 + usize(1));
      });
      (pi2 : usize) = usize(0);
      while(pi2 < ptys.len(), {
        if(recur(match(ptys.get(pi2), .Some(p) => p, .None => rc(TypeValueNode.Unit)), visited_ids), {
          return(true);
        });
        pi2 = (pi2 + usize(1));
      });
      recur(&res, visited_ids)
    },
    Rc(.Tuple(_, field_types : tt_fts)) => {
      (ti : usize) = usize(0);
      while(ti < tt_fts.len(), {
        if(recur(match(tt_fts.get(ti), .Some(f) => f, .None => rc(TypeValueNode.Unit)), visited_ids), {
          return(true);
        });
        ti = (ti + usize(1));
      });
      false
    },
    _ => false
  )
});
/// The PHANTOM type arguments of an enum instantiation: every argument at a
/// position no payload depends on (`enum_phantom_positions`, compound
/// or not: `Option(K)` of `Tag(Option(K))`), and each type-variable argument
/// that occurs in no variant payload (`K` of `Tag(K)` = `enum(A, B(n : u8))`).
/// Such an argument is recorded only in `type_arguments`, so a walk over the
/// payloads misses it. Empty for anything else. The payload walk runs only
/// when some argument is a SomeT, which keeps this cheap on concrete
/// instantiations.
enum_phantom_type_arg_somes :: (fn(ty : &TypeValue) -> ArrayList(TypeValue))(
  match(
    ty,
    Rc(.EnumT({ id : eid, type_arguments : ta })) => if(ta.len() == usize(0), ArrayList(TypeValue).new(), enum_phantom_type_args_masked(ty, enum_phantom_positions(&eid))),
    _ => ArrayList(TypeValue).new()
  )
);
/// `enum_phantom_type_arg_somes` with the instantiation's phantom-position
/// flags already looked up (`type_key` reads them itself).
enum_phantom_type_args_masked :: (fn(ty : &TypeValue, mask : &ArrayList(bool)) -> ArrayList(TypeValue))({
  out := ArrayList(TypeValue).new();
  targs := match(ty, Rc(.EnumT({ type_arguments : ta })) => ta, _ => no_types());
  (field_somes : Option(ArrayList(TypeValue))) = Option(ArrayList(TypeValue)).None;
  (i : usize) = usize(0);
  while(i < targs.len(), {
    match(
      targs.get(i),
      .Some(ta) => cond(
        match(mask.get(i), .Some(b) => b, .None => false) => out.push(ta),
        is_some_type(&ta) => {
          if(field_somes.is_none(), {
            field_somes = Option(ArrayList(TypeValue)).Some(get_all_some_types(ty));
          });
          ta_id := match(ta, Rc(.SomeT({ id : x })) => x, _ => String.from(""));
          fs := field_somes.unwrap();
          (in_field : bool) = false;
          (j : usize) = usize(0);
          while((j < fs.len()) && !in_field, {
            match(
              fs.get(j),
              .Some(Rc(.SomeT({ id : fid }))) => if(fid == ta_id, {
                in_field = true;
              }),
              _ => ()
            );
            j = (j + usize(1));
          });
          if(!in_field, {
            out.push(ta);
          });
        },
        true => ()
      ),
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});
/// True when a field-type list mixes a COMPTIME-ONLY member with a
/// RUNTIME-ONLY member — the availability intersection is then empty and the
/// containing struct/enum can exist in NO evaluation context. Structural,
/// tag-level scan: the nominal-id trait registry cannot key per-object
/// availability for pointers (it false-fired on every pointer-fielded
/// prelude newtype when tried), so the direct field scan decides exactly the
/// definitive cases and stays silent on anything undecided (generic fields,
/// plain value structs).
fields_have_incompatible_contexts :: (fn(fts : &ArrayList(TypeValue)) -> bool)({
  (has_ct_only : bool) = false;
  (has_rt_only : bool) = false;
  (fi : usize) = usize(0);
  while(fi < fts.len(), {
    (ft : TypeValue) = match(fts.get(fi), .Some(t) => t, .None => rc(TypeValueNode.Unit));
    fi = (fi + usize(1));
    // A pointer field classifies by its POINTEE (`*(Self)` / `*(i32)` are
    // both-context; `*(Rc(i32))` is runtime-only — tests/basic arm 10's
    // SelfRecursive structs). Unwrap before classifying.
    (fo_hops : usize) = usize(0);
    while(match(ft, Rc(.Pointer(_)) => (fo_hops < usize(8)), _ => false), {
      ft = match(ft, Rc(.Pointer(p)) => p, _ => ft);
      fo_hops = (fo_hops + usize(1));
    });
    // A reference-semantics struct (object type) is runtime-only REGARDLESS
    // of its type parameters (`Rc(i32)` instances still carry internal
    // SomeTs from the generic decl, so this must run BEFORE the generic
    // skip below).
    (rt_only : bool) = match(
      ft,
      Rc(.Struct({ is_reference_semantics : fo_ref, is_source_namespace : fo_ns })) => (fo_ref && !fo_ns),
      _ => false
    );
    if(rt_only, {
      has_rt_only = true;
      continue;
    });
    if(is_some_type(&ft) || (get_all_some_types(&ft).len() > usize(0)), {
      continue;
    });
    if(type_is_comptime_only(&ft), {
      has_ct_only = true;
    });
    if(type_prohibits_comptime_modifier(&ft), {
      has_rt_only = true;
    });
  });
  has_ct_only && has_rt_only
});
/// True iff `ty` contains at least one SomeT and EVERY contained SomeT
/// resolves — through its resolution chain, cycle-guarded — to a
/// non-SomeT terminal that itself contains no SomeTs. Used by the call
/// return-type acceptance rules: a result like `IterFilter(CountIter, F)`
/// where `F → __impl_fn → <capture struct>` is codegen-concrete (type_key
/// hops the same chain) even though `get_all_some_types` is non-empty.
/// Conservative on any unresolved or cyclic chain (returns false).
type_somes_all_resolve_concrete :: (fn(ty : &TypeValue) -> bool)({
  somes := get_all_some_types(ty);
  // ALSO walk a struct instantiation's `type_arguments`: get_all_some_types
  // deliberately skips them, but a nominal record's identity (type_key) is
  // keyed by them — a raw forall hiding ONLY there (map's `B` in
  // `IterMap(I, B, F)`) makes the record codegen-ambiguous even when every
  // field type resolves.
  match(
    ty,
    Rc(.Struct({ type_arguments : sarc_tas })) => {
      (sarc_ti : usize) = usize(0);
      while(sarc_ti < sarc_tas.len(), {
        match(
          sarc_tas.get(sarc_ti),
          .Some(sarc_ta) => {
            if(is_some_type(&sarc_ta), {
              somes.push(sarc_ta);
            }, {
              sarc_inner := get_all_some_types(&sarc_ta);
              (sarc_ii : usize) = usize(0);
              while(sarc_ii < sarc_inner.len(), {
                match(
                  sarc_inner.get(sarc_ii),
                  .Some(sarc_is) => {
                    somes.push(sarc_is);
                    ()
                  },
                  .None => ()
                );
                sarc_ii = (sarc_ii + usize(1));
              });
            });
          },
          .None => ()
        );
        sarc_ti = (sarc_ti + usize(1));
      });
    },
    _ => ()
  );
  if(somes.len() == usize(0), {
    return(false);
  });
  (ok : bool) = true;
  (i : usize) = usize(0);
  while((i < somes.len()) && ok, {
    st := match(somes.get(i), .Some(t) => t, .None => rc(TypeValueNode.Unit));
    (cur : TypeValue) = st;
    (seen : ArrayList(String)) = ArrayList(String).new();
    (walk : bool) = true;
    (terminal_concrete : bool) = false;
    while(walk, {
      match(
        cur,
        Rc(.SomeT(sarc_id, _, _, _, _, _, _, _, _, sarc_rc)) => {
          (revisit : bool) = false;
          (si : usize) = usize(0);
          while(si < seen.len(), {
            match(
              seen.get(si),
              .Some(sid) => if(sid == sarc_id, {
                revisit = true;
              }),
              .None => ()
            );
            si = (si + usize(1));
          });
          if(revisit, {
            walk = false;
          }, {
            seen.push(sarc_id.clone());
            match(
              sarc_rc,
              .Some(nx) => {
                cur = nx;
              },
              .None => {
                walk = false;
              }
            );
          });
        },
        _ => {
          terminal_concrete = (get_all_some_types(&cur).len() == usize(0));
          walk = false;
        }
      );
    });
    ok = (ok && terminal_concrete);
    i = (i + usize(1));
  });
  ok
});
/// Follow a SomeT's `resolution` chain (resolution → resolution,
/// cycle-guarded) to its terminal.
/// Returns the input unchanged when the chain doesn't terminate concrete.
/// Used by the Future-effect comparison + the wrapper-carrier concreteness
/// gate: io.async's returned `Impl(Future(i32, E))` carries the effect slot
/// as the `E` SomeT whose RESOLUTION is the concrete bundle — comparing
/// or gating on the raw SomeT rejected `Impl(Future(i32, Ctx))` annotations
/// (the async_await arm-65 family).
resolve_cell_chain :: (fn(t_in : &TypeValue) -> TypeValue)({
  cur := resolution_chain_end(t_in);
  if(is_some_type(&cur), t_in, cur)
});
/// The LAST link of a SomeT's `resolution` chain (cycle-guarded): the
/// terminal concrete type, or the last SomeT when the chain ends unresolved
/// (`resolve_cell_chain` returns its input then). A non-SomeT is its own end.
///
/// The end is the chain's C identity: an unresolved SomeT lowers through the
/// type registry under its own id, so two chains that end in different SomeTs
/// lower to different C types even where every link before prints alike. The
/// futures of one generic producer at two `T`s are such a pair: both are the
/// producer's ONE declared `Impl(Future(...))` wrapper, resolved per producer
/// specialization to that specialization's own `io.async` future
/// (issues/fixed/2026-10-16-a-generic-io-async-body-shares-one-capture-struct-across-futures-of-one-generic-producer.md).
resolution_chain_end :: (fn(t_in : &TypeValue) -> TypeValue)({
  (cur : TypeValue) = t_in;
  (seen : ArrayList(String)) = ArrayList(String).new();
  (walk : bool) = true;
  while(walk, {
    match(
      cur,
      Rc(.SomeT(id : rcc_id, resolution : rcc_rc)) => {
        (revisit : bool) = false;
        (ri : usize) = usize(0);
        while(ri < seen.len(), {
          match(
            seen.get(ri),
            .Some(rs) => if(rs == rcc_id, {
              revisit = true;
            }),
            .None => ()
          );
          ri = (ri + usize(1));
        });
        if(revisit, {
          walk = false;
        }, {
          seen.push(rcc_id.clone());
          match(
            rcc_rc,
            .Some(nx) => {
              cur = nx;
            },
            .None => {
              walk = false;
            }
          );
        });
      },
      _ => {
        walk = false;
      }
    );
  });
  cur
});
/// A closure's capture struct (`capture_<hash>`, evaluator/utils/closure.yo):
/// the layout of one closure literal's captured state, and, through closure
/// identity, that closure's type.
is_closure_capture_struct :: (fn(t : &TypeValue) -> bool)(
  match(t, Rc(.Struct({ id : ccs_id })) => ccs_id.starts_with("capture_"), _ => false)
);
/// A closure's own type used as a type: an annotation wrapper (the reserved
/// name "Impl", builtins/impl_constraint.yo) whose resolution chain reaches a
/// concrete type, e.g. `(k : Impl(Fn() -> unit))` resolved to k's capture
/// struct. It is a type in its own right, not a type variable: codegen lowers
/// it to its resolution, so it is keyed (`type_key`), compared (identity and
/// flow) and bound as that resolution — every copy of one closure's wrapper is
/// one type, two closures are two
/// (issues/fixed/a-container-of-a-closure-type-does-not-compile.md).
///
/// Not a dyn-coercion wrapper (NAMELESS, values/dyn.yo): the dyn/box pipeline
/// lowers that to its own fat call/data struct. Not a `Future` wrapper: an
/// extern future lowers to a pointer, so its C type is not its resolution's.
is_bound_closure_identity :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.SomeT({ name : bci_nm, required_trait_types : bci_rtt })) => (
      (bci_nm == "Impl") && !_any_future_trait(&bci_rtt) && _resolves_to_concrete_type(t)
    ),
    _ => false
  )
);
/// The chain ends at a non-SomeT type with no open type variable inside
/// (`type_has_no_open_some`): a captured `AtomicI32`'s extern `atomic_int`
/// needs no resolution.
_resolves_to_concrete_type :: (fn(t : &TypeValue) -> bool)({
  rtc_term := resolve_cell_chain(t);
  !is_some_type(&rtc_term) && type_has_no_open_some(&rtc_term)
});
_any_future_trait :: (fn(tys : &ArrayList(TypeValue)) -> bool)({
  (aft_i : usize) = usize(0);
  while(aft_i < tys.len(), {
    if(match(tys.get(aft_i), .Some(aft_t) => is_future_trait_type(&aft_t), .None => false), {
      return(true);
    });
    aft_i = (aft_i + usize(1));
  });
  false
});
/// STRUCTURALLY RECURSIVE "contains a codegen SomeType" test.
///
/// `type_contains_some_type` above is TOP-LEVEL ONLY (see this module's header):
/// it inspects `ty` itself and returns `false` for every composite. This
/// variant instead walks the whole type
/// structure, so a SomeT nested under `Option`/`Ptr`/a field is detected.
///
/// That difference is not cosmetic: an `ArrayList(E)` left generic has field
/// `?(*(E))`, which the top-level test calls concrete. `compute_needs_cycle_gc`
/// then accepts the generic ArrayList as a CYCLE ROOT and switches the whole
/// program to the heavy Bacon-Rajan runtime instead of the lightweight
/// RC path — which in turn stamps `dispose_fn` with a bare generic id that is
/// never emitted ("use of undeclared identifier"). Repro:
/// `issues/repros/toplevel-some-type-check-forces-cycle-gc.yo`.
///
/// Implemented by reusing the PROVEN pieces rather than adding a second walker:
/// `get_all_some_types` supplies the structural recursion (with its own visited
/// set) and `type_contains_some_type` supplies the carve-outs (extern,
/// resolved-concrete, Impl(Fn)/Impl(Future)) at each collected SomeT.
///
/// Deliberately NOT swapped in for `type_contains_some_type` everywhere: that
/// predicate gates constructor emission and specialization decisions, and
/// making it strictly more conservative would REMOVE constructors that are
/// currently emitted. Used only where the recursive semantics are required.
type_contains_some_type_deep :: (fn(ty : &TypeValue) -> bool)({
  if(type_contains_some_type(ty), {
    return(true);
  });
  sts := get_all_some_types(ty);
  n := sts.len();
  (i : usize) = usize(0);
  (found : bool) = false;
  while((i < n) && !found, {
    match(
      sts.get(i),
      .Some(st) => if(type_contains_some_type(&st), {
        found = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// Does `ty` mention an `Impl(Fn(...))` / `Impl(Future(...))` existential?
/// `type_contains_some_type` counts such a SomeT as CONCRETE (it lowers to the
/// value's capture struct / state machine), which is right for the codegen
/// gates and wrong for a branch JOIN: a `cond`/`match` that adopted it as its
/// result type in place of the arms' concrete closure type lost both the C
/// type (the result temp became `void*`) and the closure's capture borrows
/// (so a borrowing closure escaped decision 38 A's E0909).
/// issues/fixed/cond-match-tail-adopts-the-abstract-impl-result-type.md
type_mentions_impl_fn_or_future :: (fn(ty : &TypeValue) -> bool)({
  sts := get_all_some_types(ty);
  (i : usize) = usize(0);
  while(i < sts.len(), {
    match(
      sts.get(i),
      .Some(Rc(.SomeT({ required_trait_types : rtt }))) => {
        (j : usize) = usize(0);
        while(j < rtt.len(), {
          match(
            rtt.get(j),
            .Some(Rc(.FnTraitT(_, _, _, _, _, _, _, _))) => {
              return(true);
            },
            .Some(Rc(.FutureTraitT(_, _, _, _))) => {
              return(true);
            },
            _ => ()
          );
          j = (j + usize(1));
        });
      },
      _ => ()
    );
    i = (i + usize(1));
  });
  false
});
/// The opaque `Impl(...)` a bare function TYPE `ty` mentions in its parameter
/// or result types and cannot represent, or `.None`.
///
/// A `fn(...) -> R` type is ONE C function-pointer type, but every function
/// returning `Impl(Fn() -> i32)` returns its OWN concrete type (its closure's
/// capture struct, by value), so `fn(x : i32) -> Impl(Fn() -> i32)` has no
/// single representation: a slot of that type lowered to `void* (*)(int32_t)`
/// accepted such a function and the call crashed (SIGBUS)
/// (issues/fixed/a-function-returning-impl-passed-to-a-function-typed-parameter-is-called-through-void-pointer.md).
/// An `Impl(Fn(...))` PARAMETER has no single representation either (a
/// function taking one is specialized per closure). Rust rejects
/// `fn(i32) -> impl Fn() -> i32` and `fn(impl Fn())` for the same reason.
/// Only a function TYPE naming a slot that many functions can fill is judged
/// (a runtime parameter, a struct/enum/tuple/union field, a function result);
/// a definition's own `fn(...) -> Impl(...)` signature and a trait method's
/// are what `Impl` is for, and a local annotation
/// (`(h : (fn(x : i32) -> Impl(Fn() -> i32))) = mk`) takes its initializer's
/// concrete function type, as an `Impl(Fn(...))` annotation takes its
/// closure's.
///
/// `Impl(Future(...))` is exempt: every future lowers to one pointer to a
/// state machine, so a function type returning one HAS a single
/// representation (two different async functions through one
/// `fn(...) -> Impl(Future(i32, Io))` parameter run correctly). A RESOLVED
/// `Impl` (a definition's own type, carrying its hidden concrete type) names
/// one type and is exempt too.
fn_type_unrepresentable_impl :: (fn(ty : &TypeValue) -> Option(TypeValue))(
  // Only a MONOMORPHIC function type is one function pointer: a generic one
  // (`fn(generic(T, E), action : Impl(Fn(e : E) -> T)) -> ...`, the builtin
  // `Io` slots) is compile-time only, and a runtime parameter of one is
  // already rejected (`evaluate_function_parameter`).
  match(
    ty,
    Rc(.Func({ forall_types : fu_ft, param_types : fu_pt, result : fu_res, meta : fu_meta })) => {
      if((fu_ft.len() > usize(0)) || (fu_meta.*.forall_labels.len() > usize(0)), {
        return(Option(TypeValue).None);
      });
      // The signature's OWN parameter and result types, and those of a
      // function type nested there (`fn() -> (fn() -> Impl(...))`). Not the
      // fields of a struct named there: `Io`'s generic method slots mention
      // `Impl(Fn(...))` and are no part of this function's representation.
      (i : usize) = usize(0);
      while(i <= fu_pt.len(), {
        fu_t := cond((i < fu_pt.len()) => match(fu_pt.get(i), .Some(t) => t, .None => rc(TypeValueNode.Unit)), true => fu_res);
        match(
          fu_t,
          Rc(.SomeT({ name : nm, required_trait_types : rtt, resolution : res })) => if((nm == "Impl") && res.is_none() && !_any_future_trait(&rtt), {
            return(Option(TypeValue).Some(fu_t));
          }),
          Rc(.Func(_, _, _, _, _, _, _)) => match(
            recur(&fu_t),
            .Some(fu_inner) => {
              return(Option(TypeValue).Some(fu_inner));
            },
            .None => ()
          ),
          _ => ()
        );
        i = (i + usize(1));
      });
      Option(TypeValue).None
    },
    _ => Option(TypeValue).None
  )
);
/// The diagnostic for `fn_type_unrepresentable_impl`; `what` names the slot
/// (`parameter "mk"`, `field "mk"`, ...).
fn_type_unrepresentable_impl_message :: (fn(what : &String, fn_ty : &TypeValue, impl_ty : &TypeValue) -> String)(
  `The function type ${type_to_string(fn_ty)} cannot be the type of ${what}: a function type is one function pointer, but ${type_to_string(impl_ty)} is a different concrete type in each function of that signature (each closure is its own struct, passed by value), so no single function pointer can call them all`
);
fn_type_unrepresentable_impl_help :: (fn() -> String)(
  String.from(
    "take the function as a generic `Impl(Fn(...) -> ...)` parameter, which is specialized for each argument (`mk : &Impl(Fn(x : i32) -> Impl(Fn() -> i32))`), or make the result `Dyn(Fn(...))`, which is one boxed representation"
  )
);
// ---------------------------------------------------------------------------
// Size and alignment utilities
// ---------------------------------------------------------------------------
//
// Return values:
//   get_size_of_type      → size in **bits** (`.None` = unknown)
//   get_alignment_of_type → alignment in **bytes** (`.None` = unknown)
// Function-pointer slots breaking the mutual recursion between
// `get_size_of_type`/`get_alignment_of_type` and the `_aggregate_size`/
// `_max_field_alignment` helpers (which must be defined BEFORE the public
// functions that call them, yet need to recurse back into them). Same pattern
// as `hierarchy.yo`'s `g_type_of_type_visited_fn`. Assigned at module top level
// after both functions are defined.
SizeFn :: (fn(ty : &TypeValue) -> Option(usize));
(mut(g_size_of_type_fn) : Option(SizeFn)) = Option(SizeFn).None;
(mut(g_alignment_of_type_fn) : Option(SizeFn)) = Option(SizeFn).None;
_size_via_slot :: (fn(ty : &TypeValue) -> Option(usize))(
  match(g_size_of_type_fn, .Some(f) => f(ty), .None => Option(usize).None)
);
_align_via_slot :: (fn(ty : &TypeValue) -> Option(usize))(
  match(g_alignment_of_type_fn, .Some(f) => f(ty), .None => Option(usize).None)
);
/// Larger of two `usize`.
_max_usize :: (fn(a : usize, b : usize) -> usize)(cond((a >= b) => a, true => b));
/// `ceil(offset / align) * align` for `align >= 1` (round `offset` up to a
/// multiple of `align`). Integer-only.
_round_up :: (fn(offset : usize, align : usize) -> usize)(
  cond(
    (align == usize(0)) => offset,
    true => ((((offset + align) - usize(1)) / align) * align)
  )
);
/// `ceil(log2(n))` — smallest `b` with `2^b >= n`. `n <= 1 → 0`.
_ceil_log2 :: (fn(n : usize) -> usize)({
  (b : usize) = usize(0);
  (pow : usize) = usize(1);
  while(pow < n, {
    pow = (pow * usize(2));
    b = (b + usize(1));
  });
  b
});
/// Max alignment (bytes) across a field-type list; `.None` if any is unknown.
/// Recurses into `get_alignment_of_type` via the `g_alignment_of_type_fn` slot
/// (set at module top level) to break the mutual forward reference.
_max_field_alignment :: (fn(fts : &ArrayList(TypeValue)) -> Option(usize))({
  (acc : usize) = usize(1);
  (unknown : bool) = false;
  (i : usize) = usize(0);
  n := fts.len();
  while((i < n) && !unknown, {
    ft := match(fts.get(i), .Some(t) => t, .None => rc(TypeValueNode.Unit));
    match(
      _align_via_slot(&ft),
      .Some(a) => {
        acc = _max_usize(acc, a);
      },
      .None => {
        unknown = true;
      }
    );
    i = (i + usize(1));
  });
  cond(unknown => Option(usize).None, true => Option(usize).Some(acc))
});
/// Aggregate size (in BITS) of a sequence of fields laid out with C-style
/// alignment padding, then padded to the aggregate's own alignment. `.None` if
/// any field size/alignment is unknown. Recurses via the size/alignment slots.
_aggregate_size :: (fn(fts : &ArrayList(TypeValue)) -> Option(usize))({
  (offset_bytes : usize) = usize(0);
  (max_align : usize) = usize(1);
  (unknown : bool) = false;
  (i : usize) = usize(0);
  n := fts.len();
  while((i < n) && !unknown, {
    ft := match(fts.get(i), .Some(t) => t, .None => rc(TypeValueNode.Unit));
    match(
      _size_via_slot(&ft),
      .Some(fbits) => match(
        _align_via_slot(&ft),
        .Some(fa) => {
          fbytes := ((fbits + usize(7)) / usize(8));
          offset_bytes = _round_up(offset_bytes, fa);
          offset_bytes = (offset_bytes + fbytes);
          max_align = _max_usize(max_align, fa);
        },
        .None => {
          unknown = true;
        }
      ),
      .None => {
        unknown = true;
      }
    );
    i = (i + usize(1));
  });
  cond(
    unknown => Option(usize).None,
    true => Option(usize).Some(usize(_round_up(offset_bytes, max_align) * usize(8)))
  )
});
/// Size of a struct or tuple as the emitter DECLARES it. A `unit` field emits
/// no member, so an aggregate whose every field is `unit` (or that has no
/// fields) would be an EMPTY C struct — and an empty struct is not a portable
/// zero-sized type: clang lays it out as 0 bytes on GNU targets but **4 bytes**
/// on the MSVC ABI (`x86_64-pc-windows-msvc`, `aarch64-pc-windows-msvc`), so a
/// model saying 0 under-allocates every container of such an aggregate on
/// Windows (measured with `-fdump-record-layouts`, 2026-09-06). The emitter
/// therefore gives a member-less aggregate a one-byte `_zst_dummy`
/// (`generate_struct_declaration` / `generate_tuple_declaration`,
/// src/codegen/types/generation.yo), which is 1 byte, alignment 1, on every
/// target — and this is the size that lands. `unit` itself stays 0.
_c_aggregate_size :: (fn(fts : &ArrayList(TypeValue)) -> Option(usize))({
  (members : usize) = usize(0);
  (i : usize) = usize(0);
  n := fts.len();
  while(i < n, {
    match(
      fts.get(i),
      .Some(ft) => if(!is_unit_type(&ft), {
        members = (members + usize(1));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  cond(
    (members == usize(0)) => Option(usize).Some(usize(8)),
    true => _aggregate_size(fts)
  )
});
/// The subset of one enum variant's field types that the tagged-union emitter
/// actually lays out. `generate_enum_declaration`
/// (src/codegen/types/generation.yo) ERASES `unit` variant fields from the data
/// union — and emits no member at all for a variant whose fields are all
/// `unit` — so a variant payload is sized over the non-unit fields only.
/// Since `unit` became a true zero-sized type this filter changes no size (a
/// unit field measures 0 either way); it is kept because it is exactly the
/// predicate the emitter filters on, so the two stay visibly in step.
_variant_storage_field_types :: (fn(fts : &SharedList(TypeValue)) -> ArrayList(TypeValue))({
  kept := ArrayList(TypeValue).new();
  (i : usize) = usize(0);
  n := fts.len();
  while(i < n, {
    match(
      fts.get(i),
      .Some(ft) => if(!is_unit_type(&ft), {
        kept.push(ft);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  kept
});
/// Return the alignment of `ty` in bytes, or `.None` if not statically known.
/// Recurses into itself
/// via `recur` and into the field helpers defined just above.
get_alignment_of_type :: (fn(ty_in : &TypeValue) -> Option(usize))({
  // Resolve recursive-type SHELLS to their registered finals first — same
  // reasoning as get_size_of_type below (an empty shell walks to alignment 1,
  // mis-laying out any aggregate that embeds the recursive type).
  ty := resolve_enum_shell(resolve_struct_shell(ty_in));
  // V6 task 3: a refinement is erased for layout — sizeof(refine(T, p))
  // == sizeof(T) (the zero-runtime-cost rule).
  ty = t_refine_inner(&ty);
  match(
    ty,
    // comptime-only types have minimal alignment
    Rc(.Unit) => .Some(usize(1)),
    Rc(.ComptimeInt) => .Some(usize(1)),
    Rc(.ComptimeFloat) => .Some(usize(1)),
    Rc(.ComptimeString) => .Some(usize(1)),
    Rc(.Void) => .Some(usize(1)),
    Rc(.TypeUni(_)) => .Some(usize(1)),
    // Bool: 1 byte aligned
    Rc(.BoolT) => .Some(usize(1)),
    // Platform-sized integers: pointer-aligned
    Rc(.Usize) => .Some(usize(get_target_pointer_size_bytes())),
    Rc(.Isize) => .Some(usize(get_target_pointer_size_bytes())),
    // Fixed-width integers: bits/8 bytes
    Rc(.Int({ bits : b })) => .Some(usize(u32(b) / u32(8))),
    // Floating-point: bits/8 bytes
    Rc(.Float({ bits : b })) => .Some(usize(u32(b) / u32(8))),
    // C platform-dependent integers — return `.None`
    Rc(.CChar) => .None,
    Rc(.CShort) => .None,
    Rc(.CUShort) => .None,
    Rc(.CInt) => .None,
    Rc(.CUInt) => .None,
    Rc(.CLong) => .None,
    Rc(.CULong) => .None,
    Rc(.CLongLong) => .None,
    Rc(.CULongLong) => .None,
    Rc(.CLongDouble) => .None,
    // Pointer and function types: pointer-aligned
    Rc(.Pointer(_)) => .Some(usize(get_target_pointer_size_bytes())),
    Rc(.Func({ result : _ })) => .Some(usize(get_target_pointer_size_bytes())),
    // Array: element alignment
    Rc(.Array({ element : el })) => recur(&el),
    // str: pointer-aligned (fat pointer {ptr,len})
    Rc(.Str) => .Some(usize(get_target_pointer_size_bytes())),
    // Dyn: pointer-aligned (fat pointer {data, vtable}; see get_size_of_type).
    Rc(.DynT({})) => .Some(usize(get_target_pointer_size_bytes())),
    // Struct: reference-semantics (object) → pointer-aligned; newtype →
    // inner field's alignment; otherwise the max field alignment.
    Rc(.Struct({ field_types : sfts, is_reference_semantics : s_ref, is_newtype : s_nt })) =>
      cond(
        s_ref => Option(usize).Some(usize(get_target_pointer_size_bytes())),
        (s_nt && (sfts.len() > usize(0))) => match(sfts.get(usize(0)), .Some(f0) => recur(&f0), .None => Option(usize).None),
        true => _max_field_alignment(&sfts.items)
      ),
    // Tuple: max field alignment.
    Rc(.Tuple({ field_types : tfts })) => _max_field_alignment(&tfts.items),
    // Union: max field alignment.
    Rc(.Union({ field_types : ufts })) => _max_field_alignment(&ufts.items),
    // Enum: reference-semantics (`ref(enum(…))`) → pointer-aligned (it is a heap
    // handle); otherwise the max alignment across all variants' fields. The
    // `e_ref` short-circuit matches the struct branch and prevents an infinite
    // walk of a recursive ref-enum whose variant field is typed `Self`.
    Rc(.EnumT({ variant_fields : evf, is_reference_semantics : e_ref })) => cond(
      e_ref => Option(usize).Some(usize(get_target_pointer_size_bytes())),
      // Lowered to the bare pointer (NULL = the empty variant), as codegen emits it.
      can_optimize_as_nullable_pointer(&ty).is_some() => Option(usize).Some(usize(get_target_pointer_size_bytes())),
      true => {
        (acc : usize) = usize(1);
        (unknown : bool) = false;
        (vi : usize) = usize(0);
        n_v := evf.len();
        while((vi < n_v) && !unknown, {
          vf := match(evf.get(vi), .Some(f) => f, .None => no_types());
          match(
            _max_field_alignment(&vf.items),
            .Some(a) => {
              acc = _max_usize(acc, a);
            },
            .None => {
              unknown = true;
            }
          );
          vi = (vi + usize(1));
        });
        cond(
          unknown => Option(usize).None,
          // The C representation carries an int-typed tag (`__yo_tN_tag tag;`
          // — a C enum, 4 bytes / 4-aligned on every supported target), so a
          // value-semantics enum is at least 4-aligned REGARDLESS of its
          // payload alignments. The size arm below already assumes this
          // (`struct_align_bits = max(32, …)`). DELIBERATE tag inclusion:
          // an alignment walk that omits the tag makes an enum whose
          // payloads align below 4 (e.g. Array(u16, 8) → 2)
          // report alignment 2, a struct embedding it then skips C's tail
          // padding (evaluator 22 B vs C 24 B), and every sizeof-based buffer
          // walk over such structs corrupts the heap —
          // issues/fixed/enum-alignment-ignores-tag-heap-corruption.md.
          true => Option(usize).Some(_max_usize(acc, usize(4)))
        )
      }
    ),
    _ => .None
  )
});
/// Return the size of `ty` in bits, or `.None` if not statically known.
///
// The cycle backstop's walk stack: named types currently being sized. A
// re-entry means an infinite-size VALUE cycle — the definition-time check in
// evaluator/types/enum.yo rejects those, so seeing one here means that check
// was bypassed (yield unknown, never overflow the stack).
// issues/fixed/plain-recursive-enum-segfaults-the-evaluator.md.
(g_size_walk_stack : RefCell(ArrayList(String))) = RefCell(ArrayList(String)).new(ArrayList(String).new());
_size_walk_stack_has :: (fn(id : &String) -> bool)({
  (found : bool) = false;
  (i : usize) = usize(0);
  while((i < g_size_walk_stack.with(xs => xs.len())) && !found, {
    match(
      g_size_walk_stack.with(xs => xs.get(i)),
      .Some(x) => if(x == id, {
        found = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// The value-enum size computation (tag + largest variant payload), factored
/// out of `get_size_of_type`'s `.EnumT` arm so the arm can bracket it with the
/// cycle stack push/pop.
_enum_value_size :: (fn(evf : &SharedList(SharedList(TypeValue))) -> Option(usize))({
  (max_data : usize) = usize(0);
  (max_align_bits : usize) = usize(0);
  (unknown : bool) = false;
  (vi : usize) = usize(0);
  n_v := evf.len();
  while((vi < n_v) && !unknown, {
    // Only the fields the data-union emitter keeps — see
    // `_variant_storage_field_types`.
    vf := _variant_storage_field_types(&match(evf.get(vi), .Some(f) => f, .None => no_types()));
    match(
      _aggregate_size(&vf),
      .Some(vbits) => match(
        _max_field_alignment(&vf),
        .Some(va_bytes) => {
          max_data = _max_usize(max_data, vbits);
          max_align_bits = _max_usize(max_align_bits, va_bytes * usize(8));
        },
        .None => {
          unknown = true;
        }
      ),
      .None => {
        unknown = true;
      }
    );
    vi = (vi + usize(1));
  });
  cond(
    unknown => Option(usize).None,
    true => {
      tag_bits := _round_up(_ceil_log2(n_v), usize(8));
      data_align_bits := _max_usize(max_align_bits, usize(8));
      struct_align_bits := _max_usize(usize(32), data_align_bits);
      // Pad tag end up to data alignment, add data, then pad total to
      // struct alignment (all in bits; alignments are byte multiples ×8).
      after_tag := _round_up(tag_bits, data_align_bits);
      total_before := (after_tag + max_data);
      Option(usize).Some(usize(_round_up(total_before, struct_align_bits)))
    }
  )
});
get_size_of_type :: (fn(ty_in : &TypeValue) -> Option(usize))({
  // A recursive struct/enum reference inside a type graph is a value-copied
  // SHELL (empty fields/variant names) — TypeValue is value-semantic, so a
  // reference site does not carry the full definition. An
  // empty shell walks to size 0, so `sizeof(T)` on a recursive enum folded to
  // 0 and ArrayList.push allocated `0 * new_capacity` bytes → heap
  // corruption (the recursive_enum / encoding/json crashes). Resolve to the
  // registered final first — same convention as type_key.yo.
  ty := resolve_enum_shell(resolve_struct_shell(ty_in));
  // V6 task 3: a refinement is erased for layout — sizeof(refine(T, p))
  // == sizeof(T) (the zero-runtime-cost rule).
  ty = t_refine_inner(&ty);
  match(
    ty,
    // `unit` is a TRUE zero-sized type, as in Rust (`size_of::<()>() == 0`):
    // the emitter lays out NOTHING for it. A `unit` struct/tuple field emits no
    // C member (`_emit_runtime_fields` / `generate_tuple_declaration`,
    // src/codegen/types/generation.yo), an enum variant field is erased from the
    // data union, and an `Array(unit, N)` wrapper has no `data` member. An
    // aggregate whose EVERY field is `unit` is NOT an empty C struct — that is
    // 0 bytes on GNU targets but 4 on the MSVC ABI — it carries a one-byte
    // `_zst_dummy` and measures 1 (`_c_aggregate_size` below). So 0 here IS
    // the object the emitter lays out for `unit` itself.
    //
    // This arm flipped 0 → 1 → 0: it was 0 while the emitter spelled a one-byte
    // `uint8_t` placeholder for every storage position, which under-allocated
    // `malloc(n * sizeof(S))` for every aggregate with a `unit` field (an
    // out-of-bounds heap write from safe Yo —
    // issues/fixed/sizeof-of-aggregate-with-unit-field-disagrees-with-emitted-c-struct.md);
    // the interim fix raised it to 1 to match; erasing the storage made 0 right
    // (issues/fixed/unit-should-be-a-true-zero-sized-type-like-rust.md).
    //
    // The ONE place a `unit` still occupies a byte is a BY-VALUE PARAMETER
    // (`get_storage_type_string`): C cannot declare a `void` parameter, and the
    // calling convention is not layout — `sizeof` never observes it.
    Rc(.Unit) => .Some(usize(0)),
    Rc(.ComptimeInt) => .Some(usize(0)),
    Rc(.ComptimeFloat) => .Some(usize(0)),
    Rc(.ComptimeString) => .Some(usize(0)),
    // `void` gets the same `void` C spelling as `unit`, but — unlike `unit` —
    // it can never REACH a storage position: `prohibit_void_type` (above)
    // rejects it as a struct field, a tuple element, a parameter, a binding
    // type and an assignment RHS, leaving a function return type as its only
    // legal home, where C `void` is correct and no object is laid out. So the
    // one-byte placeholder rule cannot apply to it and 0 stands.
    Rc(.Void) => .Some(usize(0)),
    Rc(.TypeUni(_)) => .Some(usize(0)),
    // Bool: 1 byte = 8 bits
    Rc(.BoolT) => .Some(usize(8)),
    // Platform-sized integers
    Rc(.Usize) => .Some(usize(get_target_pointer_size_bits())),
    Rc(.Isize) => .Some(usize(get_target_pointer_size_bits())),
    // Fixed-width integers
    Rc(.Int({ bits : b })) => .Some(usize(b)),
    // Floating-point
    Rc(.Float({ bits : b })) => .Some(usize(b)),
    // C platform-dependent integers — return `.None` (platform-specific)
    Rc(.CChar) => .None,
    Rc(.CShort) => .None,
    Rc(.CUShort) => .None,
    Rc(.CInt) => .None,
    Rc(.CUInt) => .None,
    Rc(.CLong) => .None,
    Rc(.CULong) => .None,
    Rc(.CLongLong) => .None,
    Rc(.CULongLong) => .None,
    Rc(.CLongDouble) => .None,
    // Pointer and function types are pointer-sized
    Rc(.Pointer(_)) => .Some(usize(get_target_pointer_size_bits())),
    Rc(.Func({ result : _ })) => .Some(usize(get_target_pointer_size_bits())),
    // Array: element size × length
    // `Array(unit, N)`: the wrapper has no `data` member, only the one-byte
    // `_zst_dummy` (`_emit_array_wrapper`) — see `_c_aggregate_size` for why an
    // empty struct is not usable.
    Rc(.Array({ element : el, length : n })) => cond(
      is_unit_type(&el) => Option(usize).Some(usize(8)),
      true => match(
        recur(&el),
        .Some(elem_bits) => .Some(elem_bits * n),
        .None => .None
      )
    ),
    // str: fat pointer (pointer + length) = 2 × pointer size
    Rc(.Str) => .Some(usize(u32(2) * get_target_pointer_size_bits())),
    // Dyn(Trait...): a fat pointer `{ void* data; const vtable* vtable; }`
    // whatever the traits (codegen/types/generation.yo emits exactly that
    // struct) = 2 × pointer size. Unknown here, `x :: sizeof(Dyn(Error))` and
    // `size_would_overflow(Dyn(Error), n)` emitted a reference to an
    // undeclared `x` / `type_size`
    // (issues/fixed/sizeof-of-a-dyn-type-is-not-a-compile-time-constant.md).
    Rc(.DynT({})) => .Some(usize(u32(2) * get_target_pointer_size_bits())),
    // Struct: reference-semantics (object) → pointer-sized; newtype → inner
    // field's size; otherwise the C-laid-out aggregate size. Value structs get
    // the same cycle backstop as value enums (see `g_size_walk_stack`).
    Rc(.Struct({ id : s_sz_id, field_types : sfts, is_reference_semantics : s_ref, is_newtype : s_nt })) =>
      cond(
        s_ref => Option(usize).Some(usize(get_target_pointer_size_bits())),
        _size_walk_stack_has(s_sz_id.clone()) => Option(usize).None,
        true => {
          g_size_walk_stack.with_mut(xs => xs.push(s_sz_id.clone()));
          out := cond(
            (s_nt && (sfts.len() > usize(0))) => match(sfts.get(usize(0)), .Some(f0) => recur(&f0), .None => Option(usize).None),
            true => _c_aggregate_size(&sfts.items)
          );
          g_size_walk_stack.with_mut(xs => xs.pop());
          out
        }
      ),
    // Tuple: C-laid-out aggregate size (a member-less tuple carries the dummy
    // byte, see `_c_aggregate_size`).
    Rc(.Tuple({ field_types : tfts })) => _c_aggregate_size(&tfts.items),
    // Union: max field size (overlapping storage).
    Rc(.Union({ field_types : ufts })) => {
      (acc : usize) = usize(0);
      (unknown : bool) = false;
      (i : usize) = usize(0);
      n := ufts.len();
      while((i < n) && !unknown, {
        ft := match(ufts.get(i), .Some(t) => t, .None => rc(TypeValueNode.Unit));
        match(
          recur(&ft),
          .Some(s) => {
            acc = _max_usize(acc, s);
          },
          .None => {
            unknown = true;
          }
        );
        i = (i + usize(1));
      });
      cond(unknown => Option(usize).None, true => Option(usize).Some(acc))
    },
    // Enum: reference-semantics (`ref(enum(…))`) → pointer-sized (it is a heap
    // RC handle); otherwise tag (sized by variant count) + the largest variant
    // payload, with alignment. The `e_ref` short-circuit matches the struct
    // branch — without it the variant-field walk
    // recurses forever on a recursive ref-enum (variant field typed `Self`).
    Rc(.EnumT({ id : e_sz_id, variant_fields : evf, is_reference_semantics : e_ref })) => cond(
      e_ref => Option(usize).Some(usize(get_target_pointer_size_bits())),
      // Lowered to the bare pointer (NULL = the empty variant), as codegen emits
      // it: `sizeof(Option(*(i32)))` is a pointer, not a tag plus a pointer.
      can_optimize_as_nullable_pointer(&ty).is_some() => Option(usize).Some(usize(get_target_pointer_size_bits())),
      // Cycle backstop (issues/fixed/plain-recursive-enum-segfaults-the-evaluator.md):
      // a VALUE enum re-entered on the walk stack is an infinite-size type the
      // definition-time check should have rejected — yield unknown rather than
      // overflow the stack.
      _size_walk_stack_has(e_sz_id.clone()) => Option(usize).None,
      true => {
        g_size_walk_stack.with_mut(xs => xs.push(e_sz_id.clone()));
        out := _enum_value_size(&evf);
        g_size_walk_stack.with_mut(xs => xs.pop());
        out
      }
    ),
    _ => .None
  )
});
// Wire the function-pointer slots now that both functions are defined. Assigned
// at module top level (not inside a closure) per the captured-global rule.
g_size_of_type_fn = Option(SizeFn).Some(get_size_of_type);
g_alignment_of_type_fn = Option(SizeFn).Some(get_alignment_of_type);
// ---------------------------------------------------------------------------
// Raw-pointer / slice-source representation predicates (for flow analysis)
// ---------------------------------------------------------------------------
/// One memoized named aggregate of a representation predicate walk: the type
/// object walked and the predicate's answer for it.
_ReprMemoEntry :: struct(ty : TypeValue, answer : bool);
/// The memo of the current top-level predicate call, bucketed by
/// `<predicate>:struct:<id>` / `<predicate>:enum:<id>`. A hit requires the SAME
/// type object (a same-id copy rebuilt by substitution can differ). Without
/// it a struct DAG (`S(i) :: struct(a : S(i-1), b : S(i-1))`) is walked once
/// per path through its 2^depth leaf tree
/// (issues/fixed/defining-a-deep-struct-dag-is-exponential.md).
(g_repr_memo : RefCell(HashMap(String, ArrayList(_ReprMemoEntry)))) = RefCell(HashMap(String, ArrayList(_ReprMemoEntry))).new(HashMap(String, ArrayList(_ReprMemoEntry)).new());
/// The aggregate type objects on the current path: the same object reached
/// again is a cycle, answered `false` there. By identity, not by id: two
/// different types can share an id (an empty id, or a substituted copy).
(g_repr_path : RefCell(ArrayList(TypeValue))) = RefCell(ArrayList(TypeValue)).new(ArrayList(TypeValue).new());
/// Set when the walk was cut, by a cycle or by the depth backstop: a `false`
/// computed under a cut depends on the path, so it is not memoized. A `true`
/// is exact either way.
(mut(g_repr_cut) : bool) = false;
_repr_path_contains :: (fn(ty : &TypeValue) -> bool)({
  (i : usize) = usize(0);
  while(i < g_repr_path.with(xs => xs.len()), {
    if(match(g_repr_path.with(xs => xs.get(i)), .Some(p) => __yo_ptr_eq(&p, ty), .None => false), {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
_repr_memo_lookup :: (fn(key : &String, ty : &TypeValue) -> Option(bool))({
  bucket := match(g_repr_memo.with(m => m.get(key)), .Some(b) => b, .None => return(Option(bool).None));
  (i : usize) = usize(0);
  while(i < bucket.len(), {
    match(
      bucket.get(i),
      .Some(e) => if(__yo_ptr_eq(&e.ty, ty), {
        return(Option(bool).Some(e.answer));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  Option(bool).None
});
_repr_memo_store :: (fn(key : &String, ty : &TypeValue, answer : bool) -> unit)({
  bucket := match(g_repr_memo.with(m => m.get(key.clone())), .Some(b) => b, .None => ArrayList(_ReprMemoEntry).new());
  bucket.push(_ReprMemoEntry(ty : ty, answer : answer));
  _ := g_repr_memo.with_mut(m => m.insert(key, bucket));
});
/// Start a top-level predicate call: an empty memo, no cut.
_repr_memo_reset :: (fn() -> unit)({
  g_repr_memo.with_mut(m => m.clear());
  g_repr_path.with_mut(xs => xs.clear());
  g_repr_cut = false;
});
/// Internal: does `ty`'s representation transitively contain a raw pointer
/// (`Ptr`)? `object`/`Dyn` short-circuit to `false` (Rc keeps their
/// buffer alive across a value return). An aggregate type object already on
/// the current path is a cycle and answers `false`; `depth` is only a stack
/// backstop.
/// Field loops are inlined (via `recur`) to avoid a mutual forward reference.
///
_type_repr_contains_raw_ptr :: (fn(ty : &TypeValue, depth : usize) -> bool)(
  cond(
    (depth == usize(0)) => {
      g_repr_cut = true;
      false
    },
    is_reference_struct_type(ty) => false,
    is_dyn_type(ty) => false,
    // The unique `Box`'s cell pointer is an owned cell, not a raw view: it
    // carries what its payload carries.
    unique_box_payload_type(ty).is_some() => match(unique_box_payload_type(ty), .Some(payload) => recur(&payload, depth - usize(1)), .None => false),
    // A value that owns its heap buffer (V2b's unique buffers: a `?*E`
    // field, and a destructor that frees it) is not a raw view either: its
    // buffer carries what its elements carry.
    value_type_owns_buffer_outright(ty) => match(
      ty,
      Rc(.Struct({ field_types : ofts })) => {
        (oi : usize) = usize(0);
        (ofound : bool) = false;
        while((oi < ofts.len()) && !ofound, oi = (oi + usize(1)), {
          oft := match(ofts.get(oi), .Some(t) => t, .None => rc(TypeValueNode.Unit));
          if(match(buffer_element_type(&oft), .Some(elem) => recur(&elem, depth - usize(1)), .None => recur(&oft, depth - usize(1))), {
            ofound = true;
          });
        });
        ofound
      },
      _ => false
    ),
    true => match(
      ty,
      Rc(.Pointer(_)) => true,
      // str is the builtin view of STATIC string bytes (immortal backing) —
      // it carries a pointer, but never a dangling one.
      Rc(.Str) => false,
      Rc(.Struct({ id : sid, field_types : fts })) => {
        key := `raw:struct:${sid}`;
        match(
          _repr_memo_lookup(key.clone(), ty),
          .Some(memo) => memo,
          .None => {
            if(_repr_path_contains(ty), {
              g_repr_cut = true;
              return(false);
            });
            outer_cut := g_repr_cut;
            g_repr_cut = false;
            g_repr_path.with_mut(xs => xs.push(ty));
            (i : usize) = usize(0);
            (found : bool) = false;
            while((i < fts.len()) && !found, {
              ft := match(fts.get(i), .Some(t) => t, .None => rc(TypeValueNode.Unit));
              if(recur(&ft, depth - usize(1)), {
                found = true;
              });
              i = (i + usize(1));
            });
            _ := g_repr_path.with_mut(xs => xs.pop());
            if(found || !g_repr_cut, {
              _repr_memo_store(&key, ty, found);
            });
            g_repr_cut = (g_repr_cut || outer_cut);
            found
          }
        )
      },
      Rc(.Tuple({ field_types : fts })) => {
        (i : usize) = usize(0);
        (found : bool) = false;
        while((i < fts.len()) && !found, {
          ft := match(fts.get(i), .Some(t) => t, .None => rc(TypeValueNode.Unit));
          if(recur(&ft, depth - usize(1)), {
            found = true;
          });
          i = (i + usize(1));
        });
        found
      },
      Rc(.Union({ field_types : fts })) => {
        (i : usize) = usize(0);
        (found : bool) = false;
        while((i < fts.len()) && !found, {
          ft := match(fts.get(i), .Some(t) => t, .None => rc(TypeValueNode.Unit));
          if(recur(&ft, depth - usize(1)), {
            found = true;
          });
          i = (i + usize(1));
        });
        found
      },
      Rc(.EnumT({ id : eid, variant_fields : vfs })) => {
        key := `raw:enum:${eid}`;
        match(
          _repr_memo_lookup(key.clone(), ty),
          .Some(memo) => memo,
          .None => {
            if(_repr_path_contains(ty), {
              g_repr_cut = true;
              return(false);
            });
            outer_cut := g_repr_cut;
            g_repr_cut = false;
            g_repr_path.with_mut(xs => xs.push(ty));
            (vi : usize) = usize(0);
            (found : bool) = false;
            while((vi < vfs.len()) && !found, {
              vf := match(vfs.get(vi), .Some(f) => f, .None => no_types());
              (fi : usize) = usize(0);
              while((fi < vf.len()) && !found, {
                ft := match(vf.get(fi), .Some(t) => t, .None => rc(TypeValueNode.Unit));
                if(recur(&ft, depth - usize(1)), {
                  found = true;
                });
                fi = (fi + usize(1));
              });
              vi = (vi + usize(1));
            });
            _ := g_repr_path.with_mut(xs => xs.pop());
            if(found || !g_repr_cut, {
              _repr_memo_store(&key, ty, found);
            });
            g_repr_cut = (g_repr_cut || outer_cut);
            found
          }
        )
      },
      Rc(.Array({ element : el })) => recur(&el, depth - usize(1)),
      _ => false
    )
  )
);
/// Does `ty`'s representation transitively contain a raw pointer? `object`/`Dyn`
/// are safe leaves (Rc-managed). Public entry.
type_representation_contains_raw_ptr :: (fn(ty : &TypeValue) -> bool)({
  _repr_memo_reset();
  _type_repr_contains_raw_ptr(ty, usize(1024))
});
/// Internal: sibling of `_type_repr_contains_raw_ptr` that ALSO treats
/// `object`/`Dyn` as a "yes" leaf — used by the slice-flowability arg-source
/// check.
_type_provides_slice_source :: (fn(ty : &TypeValue, depth : usize) -> bool)(
  cond(
    (depth == usize(0)) => {
      g_repr_cut = true;
      false
    },
    is_reference_struct_type(ty) => true,
    is_dyn_type(ty) => true,
    true => match(
      ty,
      Rc(.Pointer(_)) => true,
      Rc(.Struct({ id : sid, field_types : fts })) => {
        key := `slice:struct:${sid}`;
        match(
          _repr_memo_lookup(key.clone(), ty),
          .Some(memo) => memo,
          .None => {
            if(_repr_path_contains(ty), {
              g_repr_cut = true;
              return(false);
            });
            outer_cut := g_repr_cut;
            g_repr_cut = false;
            g_repr_path.with_mut(xs => xs.push(ty));
            (i : usize) = usize(0);
            (found : bool) = false;
            while((i < fts.len()) && !found, {
              ft := match(fts.get(i), .Some(t) => t, .None => rc(TypeValueNode.Unit));
              if(recur(&ft, depth - usize(1)), {
                found = true;
              });
              i = (i + usize(1));
            });
            _ := g_repr_path.with_mut(xs => xs.pop());
            if(found || !g_repr_cut, {
              _repr_memo_store(&key, ty, found);
            });
            g_repr_cut = (g_repr_cut || outer_cut);
            found
          }
        )
      },
      Rc(.Tuple({ field_types : fts })) => {
        (i : usize) = usize(0);
        (found : bool) = false;
        while((i < fts.len()) && !found, {
          ft := match(fts.get(i), .Some(t) => t, .None => rc(TypeValueNode.Unit));
          if(recur(&ft, depth - usize(1)), {
            found = true;
          });
          i = (i + usize(1));
        });
        found
      },
      Rc(.Union({ field_types : fts })) => {
        (i : usize) = usize(0);
        (found : bool) = false;
        while((i < fts.len()) && !found, {
          ft := match(fts.get(i), .Some(t) => t, .None => rc(TypeValueNode.Unit));
          if(recur(&ft, depth - usize(1)), {
            found = true;
          });
          i = (i + usize(1));
        });
        found
      },
      Rc(.EnumT({ id : eid, variant_fields : vfs })) => {
        key := `slice:enum:${eid}`;
        match(
          _repr_memo_lookup(key.clone(), ty),
          .Some(memo) => memo,
          .None => {
            if(_repr_path_contains(ty), {
              g_repr_cut = true;
              return(false);
            });
            outer_cut := g_repr_cut;
            g_repr_cut = false;
            g_repr_path.with_mut(xs => xs.push(ty));
            (vi : usize) = usize(0);
            (found : bool) = false;
            while((vi < vfs.len()) && !found, {
              vf := match(vfs.get(vi), .Some(f) => f, .None => no_types());
              (fi : usize) = usize(0);
              while((fi < vf.len()) && !found, {
                ft := match(vf.get(fi), .Some(t) => t, .None => rc(TypeValueNode.Unit));
                if(recur(&ft, depth - usize(1)), {
                  found = true;
                });
                fi = (fi + usize(1));
              });
              vi = (vi + usize(1));
            });
            _ := g_repr_path.with_mut(xs => xs.pop());
            if(found || !g_repr_cut, {
              _repr_memo_store(&key, ty, found);
            });
            g_repr_cut = (g_repr_cut || outer_cut);
            found
          }
        )
      },
      Rc(.Array({ element : el })) => recur(&el, depth - usize(1)),
      _ => false
    )
  )
);
/// May `ty` provide the source storage for a returned slice's pointer? Like
/// `type_representation_contains_raw_ptr`, but `object`/`Dyn` ALSO count.
/// Public entry.
type_may_provide_slice_source :: (fn(ty : &TypeValue) -> bool)({
  _repr_memo_reset();
  _type_provides_slice_source(ty, usize(1024))
});
