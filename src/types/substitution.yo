//! Substitution engine for the type system.
//!
//! A `Substitution` maps `SomeT` type-variables (identified by name +
//! frame-level) to concrete `TypeValue`s.  `substitute` recursively walks a
//! `TypeValue` tree and replaces matching `SomeT` nodes; `substitute_all`
//! applies the same substitution to every element of an `ArrayList(TypeValue)`.
pragma(Pragma.AllowUnsafe);
{ ArrayList } :: import("std/collections/array_list");
{ String } :: import("std/string");
{ TypeValue } :: import("./definitions.yo");
// P2 hash-consing: RE-WIRED (2026-07-02) — the runaway explosion this was
// unwired for during the bisect turned out to be _patch_self_shell's missing
// cycle guard (now fixed + guarded, issues/fixed/patch-self-shell-exponential-walk.md);
// interning was exonerated. Measured win: −1.45 M TypeValues / −0.28 GB.
{ intern_type } :: import("./intern.yo");
{ t_dyn, enum_phantom_positions } :: import("./creators.yo");
{ resolve_cell_chain } :: import("./utils.yo");
{ are_types_compatible_exact } :: import("./compatibility.yo");
// ---------------------------------------------------------------------------
// Substitution map — parallel arrays for (name, level) → TypeValue.
// ---------------------------------------------------------------------------
Substitution :: ref(
  struct(
    names : ArrayList(String),
    levels : ArrayList(usize),
    types : ArrayList(TypeValue),
    // Trait `id`s currently being recursed into by `substitute`. Guards against
    // infinite recursion on self-referential trait types — e.g. `Error`, whose
    // `source` method returns `Option(Dyn(SelfTrait))`, forms a cyclic
    // `DynT → TraitT → … → DynT` TypeValue graph. The set is fresh per
    // top-level `substitute` (created by `subst_new`); once a trait id is
    // recorded, `substitute` returns that TraitT unchanged rather than
    // re-descending into its (already-bound) method types.
    visited_trait_ids : ArrayList(String),
    /// A `Self → concreteType` binding applied by
    /// this same walk. 0 or 1 element each; empty = no Self binding.
    self_from : ArrayList(TypeValue),
    self_to : ArrayList(TypeValue),
    /// VALUE-level bindings for const-generic array lengths — the `N` of
    /// `impl(generic(T : Type, N : usize), Array(T, N), ...)`. A length var is
    /// NOT a `SomeT`: `TypeValue.Array` stores it as the plain string
    /// `length_var` (types/definitions.yo:155), so the name/level map above can
    /// never reach it and `Array(T, N)` survived substitution as
    /// `Array(u16, length = 0, length_var = "N")` — a type with no valid C
    /// rendering, which codegen spells as the comment `// Unknown type: ...`.
    /// Parallel arrays, name → concrete length.
    len_var_names : ArrayList(String),
    len_var_values : ArrayList(usize),
    /// SomeT ids whose OWN resolution (`SomeT.resolution`) this walk
    /// adopts: each occurrence that carries a resolution is replaced by it,
    /// and an occurrence without one is left to the (name, level) entries.
    /// Never a (name, level) entry of its own: two SomeTs often share one —
    /// `map`'s and `filter`'s `F`, or two calls of `map` in one chain, whose
    /// copies even share an id — and a name-keyed entry for one rewrote the
    /// others (`ch.map(f).filter(g)` built `StreamFilter(_, <f's capture>)`).
    own_resolution_ids : ArrayList(String),
    /// Struct and enum nodes this walk already substituted, sorted by
    /// address (`node_memo_from`, searched with `__yo_ptr_lt`), and their
    /// results (`node_memo_to`). A TypeValue is a shared DAG and the walk was
    /// a tree walk: two calls in one `check src/main.yo` re-substituted a
    /// 36 KB-key type through 4.46 M nodes each (interning every one), ~16 s
    /// (issues/fixed/substitute-walks-a-shared-type-as-a-tree.md). Per
    /// object: a masked or length-stripped copy starts its own.
    node_memo_from : ArrayList(TypeValue),
    node_memo_to : ArrayList(TypeValue)
  )
);
/// Create an empty substitution.
subst_new :: (fn() -> Substitution)(
  Substitution(
    names : ArrayList(String).new(),
    levels : ArrayList(usize).new(),
    types : ArrayList(TypeValue).new(),
    visited_trait_ids : ArrayList(String).new(),
    self_from : ArrayList(TypeValue).new(),
    self_to : ArrayList(TypeValue).new(),
    len_var_names : ArrayList(String).new(),
    len_var_values : ArrayList(usize).new(),
    own_resolution_ids : ArrayList(String).new(),
    node_memo_from : ArrayList(TypeValue).new(),
    node_memo_to : ArrayList(TypeValue).new()
  )
);
/// Bind a const-generic array LENGTH variable (`N` in `Array(T, N)`) to its
/// concrete value. Applied by the `.Array` arm of `substitute`. Overwrites an
/// existing binding of the same name.
subst_add_len_var :: (fn(imm(s) : Substitution, imm(name) : String, value : usize) -> unit)({
  if(name.len() == usize(0), {
    return(());
  });
  i := usize(0);
  n := s.len_var_names.len();
  while(i < n, {
    ni := match(s.len_var_names.get(i), .Some(v) => v, .None => ``);
    if(ni == name, {
      s.len_var_values(i) = value;
      return(());
    });
    i = (i + usize(1));
  });
  s.len_var_names.push(name);
  s.len_var_values.push(value);
});
/// The same substitution with the const-generic LENGTH bindings dropped.
///
/// A NOMINAL type (Struct / EnumT / TraitT) owns its own field types: they were
/// produced by the type constructor's own evaluation and their spelling is part
/// of the type's identity — `type_key` hashes them, and the ctfe instantiation
/// memo canonicalizes a def-era instance to its concrete twin by that key.
/// Rewriting `Array(T, N)` inside a struct field therefore mints a key no memo
/// entry matches: MEASURED, resolving `_ArrayIter(T, N)._arr` split one Yo
/// struct id into two C typedefs and `into_iter` returned the wrong one
/// ("returning '__yo_t18' from a function with incompatible result type
/// '__yo_t38'" on tests/array.test.yo). Length resolution therefore applies to
/// the SPINE — parameters, results, locals, pointers, tuples — and stops at a
/// nominal boundary. Shares the other arrays; no copy when there is nothing to
/// drop.
_without_len_vars :: (fn(imm(s) : Substitution) -> Substitution)(
  cond(
    (s.len_var_names.len() == usize(0)) => s,
    true => Substitution(
      names : s.names,
      levels : s.levels,
      types : s.types,
      visited_trait_ids : s.visited_trait_ids,
      self_from : s.self_from,
      self_to : s.self_to,
      len_var_names : ArrayList(String).new(),
      len_var_values : ArrayList(usize).new(),
      own_resolution_ids : s.own_resolution_ids,
      node_memo_from : ArrayList(TypeValue).new(),
      node_memo_to : ArrayList(TypeValue).new()
    )
  )
);
/// Look up a const-generic array length binding by name.
/// Resolve an ASSOCIATED CONSTANT in a type position (`Array(u8, T.BYTES)`).
///
/// `types/` is low-level and cannot import the evaluator's impl registry, so
/// the lookup is injected at evaluator init — the same indirection pattern as
/// `set_compat_type_implements_trait_fn` (types/compatibility.yo). Unset (e.g. during
/// early bootstrap) means "cannot resolve", which leaves the length variable
/// in place exactly as before.
AssocConstLookupFn :: (fn(imm(recv) : TypeValue, imm(label) : String) -> Option(usize));
(g_lookup_assoc_const : Option(AssocConstLookupFn)) = Option(AssocConstLookupFn).None;
set_lookup_assoc_const :: (fn(f : AssocConstLookupFn) -> unit)({
  g_lookup_assoc_const = Option(AssocConstLookupFn).Some(f);
  ()
});
/// Look a type parameter up by NAME alone, ignoring frame level.
///
/// `subst_lookup` keys on (name, level) because a SomeT carries its level, but
/// a length projection is recorded as the bare text `T.BYTES` and has no level
/// to offer. First match wins, which matches how the projection was written:
/// the `T` in `Array(u8, T.BYTES)` is the `T` of the enclosing impl.
_subst_lookup_by_name :: (fn(imm(s) : Substitution, imm(name) : String) -> Option(TypeValue))({
  i := usize(0);
  n := s.names.len();
  while(i < n, {
    ni := match(s.names.get(i), .Some(v) => v, .None => ``);
    if(ni == name, {
      return(
        match(s.types.get(i), .Some(t) => Option(TypeValue).Some(t), .None => Option(TypeValue).None)
      );
    });
    i = (i + usize(1));
  });
  Option(TypeValue).None
});
/// Resolve a dotted length variable (`T.BYTES`) against this substitution:
/// bind the receiver through the type map, then read the associated constant
/// off the bound concrete type. `.None` for a non-dotted name, an unbound
/// receiver, an unset hook, or a type that does not carry the constant — every
/// one of which leaves the caller's length untouched.
_subst_resolve_len_projection :: (fn(imm(s) : Substitution, imm(lvar) : String) -> Option(usize))({
  dot := lvar.index_of(String.from("."));
  if(dot.is_none(), {
    return(Option(usize).None);
  });
  cut := match(dot, .Some(k) => k, .None => usize(0));
  recv_name := lvar.substring(usize(0), cut);
  label := lvar.substring(cut + usize(1), lvar.len());
  if((recv_name.len() == usize(0)) || (label.len() == usize(0)), {
    return(Option(usize).None);
  });
  match(
    _subst_lookup_by_name(s, recv_name),
    .Some(bound) => match(
      g_lookup_assoc_const,
      .Some(f) => f(bound, label),
      .None => Option(usize).None
    ),
    .None => Option(usize).None
  )
});
subst_lookup_len_var :: (fn(imm(s) : Substitution, imm(name) : String) -> Option(usize))({
  i := usize(0);
  n := s.len_var_names.len();
  while(i < n, {
    ni := match(s.len_var_names.get(i), .Some(v) => v, .None => ``);
    if(ni == name, {
      return(
        match(
          s.len_var_values.get(i),
          .Some(v) => Option(usize).Some(v),
          .None => Option(usize).None
        )
      );
    });
    i = (i + usize(1));
  });
  Option(usize).None
});
/// Bind `Self`, consumed by
/// the same walk. `TypeValue.Func` stores no type
/// EXPRESSIONS (types/definitions.yo), so the binding is applied as a type-level
/// replacement keyed on EXACT identity with the impl's own receiver pattern —
/// i.e. literally `Self`. Without it `substitute` maps only the generic params
/// and a `fn(self : Self) -> T` keeps the PATTERN's nominal id with a concrete
/// payload — and types are nominal, so they cannot just be substituted
/// structurally.
subst_set_self :: (fn(imm(s) : Substitution, imm(from) : TypeValue, imm(to) : TypeValue) -> unit)({
  s.self_from.push(from);
  s.self_to.push(to);
  ()
});
/// True if `id` is already recorded in the substitution's visited-trait set.
_subst_trait_visited :: (fn(imm(s) : Substitution, imm(id) : String) -> bool)({
  i := usize(0);
  n := s.visited_trait_ids.len();
  while(i < n, {
    vi := match(s.visited_trait_ids.get(i), .Some(v) => v, .None => ``);
    if(vi == id, {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
/// Add a (name, frame_level) → type binding.  Overwrites if already present.
subst_add :: (fn(imm(s) : Substitution, imm(name) : String, level : usize, imm(ty) : TypeValue) -> unit)({
  i := usize(0);
  n := s.names.len();
  while(i < n, {
    ni := match(s.names.get(i), .Some(v) => v, .None => ``);
    li := match(s.levels.get(i), .Some(v) => v, .None => usize(0));
    if((ni == name) && (li == level), {
      s.types(i) = ty;
      return(());
    });
    i = (i + usize(1));
  });
  s.names.push(name);
  s.levels.push(level);
  s.types.push(ty);
});
_is_some_t :: (fn(imm(t) : TypeValue) -> bool)(match(t, .SomeT({ id : _ }) => true, _ => false));
/// Adopt the own resolution of every occurrence of the SomeT `id` that
/// carries one (see `own_resolution_ids`).
subst_adopt_own_resolution :: (fn(imm(s) : Substitution, imm(id) : String) -> unit)({
  if(!_subst_adopts_own(s, id), {
    s.own_resolution_ids.push(id);
  });
});
_subst_adopts_own :: (fn(imm(s) : Substitution, imm(id) : String) -> bool)({
  (i : usize) = usize(0);
  while(i < s.own_resolution_ids.len(), {
    if(match(s.own_resolution_ids.get(i), .Some(v) => (v == id), .None => false), {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
/// Look up a (name, frame_level) → Option(TypeValue).
subst_lookup :: (fn(imm(s) : Substitution, imm(name) : String, level : usize) -> Option(TypeValue))({
  i := usize(0);
  n := s.names.len();
  while(i < n, {
    ni := match(s.names.get(i), .Some(v) => v, .None => ``);
    li := match(s.levels.get(i), .Some(v) => v, .None => usize(0));
    if((ni == name) && (li == level), {
      return(
        match(
          s.types.get(i),
          .Some(t) => Option(TypeValue).Some(t),
          .None => Option(TypeValue).None
        )
      );
    });
    i = (i + usize(1));
  });
  Option(TypeValue).None
});
// ---------------------------------------------------------------------------
// substitute — recursive tree walk
// ---------------------------------------------------------------------------
/// Apply substitution `s` to `ty`, returning a new `TypeValue`.
/// SomeT nodes that match a binding are replaced; everything else is
/// structurally reconstructed (copies untouched leaves, recurses into
/// compound nodes).
/// True when `ty` IS the impl's specialized receiver pattern bound by
/// `subst_set_self`. Struct/EnumT only: a blanket impl's bare-SomeT pattern is
/// already handled by the generic bindings and replacing there would clobber
/// them. Exact structural equality keeps this a port, not a shape guess.
_is_self_pattern :: (fn(imm(s) : Substitution, imm(ty) : TypeValue) -> bool)({
  if(s.self_from.len() == usize(0), {
    return(false);
  });
  from := match(s.self_from.get(usize(0)), .Some(f) => f, .None => TypeValue.Unit);
  ty_id := match(ty, .Struct({ id : sid }) => sid, .EnumT(eid, _, _, _, _, _, _, _, _, _) => eid, _ => String.new());
  if(ty_id.is_empty(), {
    return(false);
  });
  from_id := match(from, .Struct({ id : fid }) => fid, .EnumT(fe, _, _, _, _, _, _, _, _, _) => fe, _ => String.new());
  if(from_id.is_empty() || !(ty_id == from_id), {
    return(false);
  });
  are_types_compatible_exact(ty, from)
});
/// Capture-avoiding mask for a nested `Func`'s OWN forall binders: a
/// substitution entry whose NAME is one of the Func's own `forall_labels`
/// must not apply inside that Func — occurrences of that name there are
/// BOUND by the Func, not free. A nested `fn(generic(T,
/// E), …)` re-binds its own `T`/`E` fresh, shadowing any outer
/// binding of the same name (name-keyed lookup — hence a NAME mask, not
/// a (name, level) one; `Func.forall_types` stores declared KINDS, and the
/// bound occurrences' recorded levels vary per instantiation era). A plain
/// value-space walk has no shadowing, so a generic impl's `T := usize`
/// (find_methods_from_generic_impls substitutes every same-NAME occurrence
/// at its own recorded level) rewrote the UNRELATED `T` binder inside a
/// param struct's field — `Io.async : fn(generic(T, E), …)` became
/// `… -> usize` — and the corrupted Io keyed a SECOND C type for one nominal
/// struct (C23's last clang error,
/// issues/fixed/generic-implementor-async-method-awaiting-self-emits-uncompilable-c.md).
/// Returns `s` unchanged (no copy) when no entry collides with a binder.
_mfb_is_binder :: (fn(imm(labels) : ArrayList(String), imm(nm) : String) -> bool)({
  (bi : usize) = usize(0);
  (hit : bool) = false;
  while((bi < labels.len()) && !hit, {
    match(
      labels.get(bi),
      .Some(b_nm) => if(b_nm == nm, {
        hit = true;
      }),
      .None => ()
    );
    bi = (bi + usize(1));
  });
  hit
});
_mask_func_own_binders :: (fn(imm(s) : Substitution, imm(forall_labels) : ArrayList(String)) -> Substitution)({
  if((forall_labels.len() == usize(0)) || ((s.names.len() == usize(0)) && (s.len_var_names.len() == usize(0))), {
    return(s);
  });
  (any_masked : bool) = false;
  {
    (si : usize) = usize(0);
    while((si < s.names.len()) && !any_masked, {
      nm := match(s.names.get(si), .Some(v) => v, .None => ``);
      if(_mfb_is_binder(forall_labels, nm), {
        any_masked = true;
      });
      si = (si + usize(1));
    });
  };
  // A const-generic LENGTH binder shadows the same way a type binder does:
  // a nested `fn(generic(N : usize), ...)` binds its own `N`, so an outer
  // `N := 4` must not rewrite `Array(T, N)` inside it.
  {
    (li : usize) = usize(0);
    while((li < s.len_var_names.len()) && !any_masked, {
      lnm := match(s.len_var_names.get(li), .Some(v) => v, .None => ``);
      if(_mfb_is_binder(forall_labels, lnm), {
        any_masked = true;
      });
      li = (li + usize(1));
    });
  };
  if(!any_masked, {
    return(s);
  });
  masked := Substitution(
    names : ArrayList(String).new(),
    levels : ArrayList(usize).new(),
    types : ArrayList(TypeValue).new(),
    // Shared handles: the trait-recursion guard and the Self binding apply
    // unchanged under the mask.
    visited_trait_ids : s.visited_trait_ids,
    self_from : s.self_from,
    self_to : s.self_to,
    len_var_names : ArrayList(String).new(),
    len_var_values : ArrayList(usize).new(),
    // An adopted own resolution belongs to its SomeT, never to a nested
    // fn's binder (a distinct SomeT), so the mask never applies to it.
    own_resolution_ids : s.own_resolution_ids,
    node_memo_from : ArrayList(TypeValue).new(),
    node_memo_to : ArrayList(TypeValue).new()
  );
  (ci : usize) = usize(0);
  while(ci < s.names.len(), {
    nm := match(s.names.get(ci), .Some(v) => v, .None => ``);
    if(!_mfb_is_binder(forall_labels, nm), {
      masked.names.push(nm);
      masked.levels.push(match(s.levels.get(ci), .Some(v) => v, .None => usize(0)));
      masked.types.push(match(s.types.get(ci), .Some(t) => t, .None => TypeValue.Unit));
    });
    ci = (ci + usize(1));
  });
  (mli : usize) = usize(0);
  while(mli < s.len_var_names.len(), {
    lnm := match(s.len_var_names.get(mli), .Some(v) => v, .None => ``);
    if(!_mfb_is_binder(forall_labels, lnm), {
      masked.len_var_names.push(lnm);
      masked.len_var_values.push(match(s.len_var_values.get(mli), .Some(v) => v, .None => usize(0)));
    });
    mli = (mli + usize(1));
  });
  masked
});
/// `_substitute_node` through the walk's struct/enum memo (see
/// `node_memo_from`): a shared node is substituted once per walk.
_substitute_at :: (fn(imm(s) : Substitution, imm(ty) : TypeValue, is_root : bool) -> TypeValue)({
  (memoized : bool) = match(ty, .Struct({ id : _ }) => true, .EnumT({ id : _ }) => true, _ => false);
  if(!memoized, {
    return(_substitute_node(s, ty, is_root));
  });
  (at : usize) = _node_memo_lower_bound(s, ty);
  if(match(s.node_memo_from.get(at), .Some(f) => __yo_ptr_eq(f, ty), .None => false), {
    return(match(s.node_memo_to.get(at), .Some(t) => t, .None => ty));
  });
  out := _substitute_node(s, ty, is_root);
  // The recursion inserted entries of its own, so the slot moved.
  (slot : usize) = _node_memo_lower_bound(s, ty);
  s.node_memo_from.insert(slot, ty);
  s.node_memo_to.insert(slot, out);
  out
});
/// The first `node_memo_from` slot whose address is not below `ty`'s.
_node_memo_lower_bound :: (fn(imm(s) : Substitution, imm(ty) : TypeValue) -> usize)({
  (lo : usize) = usize(0);
  (hi : usize) = s.node_memo_from.len();
  while(lo < hi, {
    mid := (lo + ((hi - lo) / usize(2)));
    if(match(s.node_memo_from.get(mid), .Some(f) => __yo_ptr_lt(f, ty), .None => false), {
      lo = (mid + usize(1));
    }, {
      hi = mid;
    });
  });
  lo
});
_substitute_node :: (fn(imm(s) : Substitution, imm(ty) : TypeValue, is_root : bool) -> TypeValue)(
  // P2 hash-consing: intern each substitution result. `substitute` recurses via
  // `_substitute_at`, so wrapping the body interns EVERY level bottom-up → shared subtrees
  // (and transient duplicates) canonicalize to one instance. Key validated to match
  // codegen identity (plans/backlog/TYPEVALUE_HASH_CONSING.md). Gate: corpus 96/96.
  if(
    (s.self_from.len() > usize(0)) && _is_self_pattern(s, ty),
    // This node IS `Self` — hand back the concrete receiver.
    // Interned like
    // every other arm; the hash-consing invariant is load-bearing for codegen
    // identity.
    intern_type(match(s.self_to.get(usize(0)), .Some(st) => st, .None => ty)),
    intern_type(
      match(
        ty,
        // Recurse into pointer / slice / array.
        .Pointer(inner) => .Pointer(_substitute_at(s, inner, false)),
        // The element type substitutes like any other child; the LENGTH is a
        // value binder, resolved from the const-generic side map when the
        // impl's `generic(N : usize)` was bound at match time. Unbound (or
        // already concrete) lengths are carried through unchanged.
        .Array(inner, len, lvar) => {
          new_inner := _substitute_at(s, inner, false);
          cond(
            (lvar.len() == usize(0)) => .Array(new_inner, len, lvar),
            true => match(
              subst_lookup_len_var(s, lvar.clone()),
              .Some(bound_len) => .Array(new_inner, bound_len, String.from("")),
              // Not a plain length variable — it may be an associated-constant
              // projection (`T.BYTES`) recorded by evaluator/types/array.yo.
              // Resolving it here is the whole point of the value half: the
              // receiver is bound in THIS substitution, so the constant is
              // knowable exactly when the impl specializes.
              .None => match(
                _subst_resolve_len_projection(s, lvar.clone()),
                .Some(proj_len) => .Array(new_inner, proj_len, String.from("")),
                .None => .Array(new_inner, len, lvar)
              )
            )
          )
        },
        // Recurse into tuple.
        .Tuple(labels, types) => {
          new_types := ArrayList(TypeValue).new();
          i := usize(0);
          while(i < types.len(), {
            elem := match(types.get(i), .Some(t) => t, .None => TypeValue.Unit);
            new_types.push(_substitute_at(s, elem, false));
            i = (i + usize(1));
          });
          .Tuple(labels, new_types)
        },
        // Recurse into Func (all type-bearing fields). A NESTED Func's OWN
        // forall binders shadow same-named substitution entries — see
        // _mask_func_own_binders (capture avoidance); the root node is exempt
        // (see the `substitute` wrapper).
        .Func({ forall_types : fts, param_types : pts, implicit_types : its, where_types : wts, result : ret, meta : __fm1, variadic_types : vts }) => {
          s_in := if(is_root, s, _mask_func_own_binders(s, __fm1.*.forall_labels));
          new_fts := ArrayList(TypeValue).new();
          i := usize(0);
          while(i < fts.len(), {
            elem := match(fts.get(i), .Some(t) => t, .None => TypeValue.Unit);
            new_fts.push(_substitute_at(s_in, elem, false));
            i = (i + usize(1));
          });
          new_pts := ArrayList(TypeValue).new();
          i = usize(0);
          while(i < pts.len(), {
            elem := match(pts.get(i), .Some(t) => t, .None => TypeValue.Unit);
            new_pts.push(_substitute_at(s_in, elem, false));
            i = (i + usize(1));
          });
          new_its := ArrayList(TypeValue).new();
          i = usize(0);
          while(i < its.len(), {
            elem := match(its.get(i), .Some(t) => t, .None => TypeValue.Unit);
            new_its.push(_substitute_at(s_in, elem, false));
            i = (i + usize(1));
          });
          new_wts := ArrayList(TypeValue).new();
          i = usize(0);
          while(i < wts.len(), {
            elem := match(wts.get(i), .Some(t) => t, .None => TypeValue.Unit);
            new_wts.push(_substitute_at(s_in, elem, false));
            i = (i + usize(1));
          });
          new_vts := ArrayList(TypeValue).new();
          i = usize(0);
          while(i < vts.len(), {
            elem := match(vts.get(i), .Some(t) => t, .None => TypeValue.Unit);
            new_vts.push(_substitute_at(s_in, elem, false));
            i = (i + usize(1));
          });
          // Preserve result_is_comptime_only + ref-tracking + variadic flag +
          // FFI metadata across substitution.
          .Func(new_fts, new_pts, new_its, new_wts, _substitute_at(s_in, ret, false), __fm1, new_vts)
        },
        // TraitT — recurse into field types. (Source-namespace structs go
        // through the Struct arm above.)
        .TraitT(
          name : n,
          assoc_type_names : atns,
          field_labels : fls,
          field_types : fts,
          id : tid,
          is_concrete : ic,
          self_constraints : scons,
          neg_self_constraints : ncons,
          assoc_constraint_labels : atcl,
          assoc_constraint_types : atct
        ) =>
          // Cycle guard: self-referential traits (e.g. a method returning
          // `Dyn(SelfTrait)`) form a cyclic TypeValue graph. If we are already
          // recursing into this trait id, return it unchanged to break the cycle.
          cond(
            ((tid.len() > usize(0)) && _subst_trait_visited(s, tid)) => ty,
            true => {
              if(tid.len() > usize(0), {
                s.visited_trait_ids.push(tid);
              });
              // Nominal boundary — see _without_len_vars.
              s_nom_t := _without_len_vars(s);
              new_fts := ArrayList(TypeValue).new();
              i := usize(0);
              while(i < fts.len(), {
                elem := match(fts.get(i), .Some(t) => t, .None => TypeValue.Unit);
                new_fts.push(_substitute_at(s_nom_t, elem, false));
                i = (i + usize(1));
              });
              .TraitT(n, atns, fls, new_fts, tid, ic, scons, ncons, atcl, atct)
            }
          ),
        // SomeT — check substitution first; if not found, recurse into constraints.
        .SomeT(
          id : orig_id,
          name : n,
          frame_level : lvl,
          parent_type : pt,
          required_trait_types : rts,
          required_trait_levels : rlvls,
          negative_trait_types : nts,
          negative_trait_levels : nlvls,
          resolution : rcp
        ) => {
          // A SomeT that carries its own resolution is already bound: a
          // (name, level) entry names ANOTHER binder that shares its spelling
          // (`filter`'s `F` vs the `map` `F` nested in its `Self`), so only
          // an identity-keyed entry may replace it.
          found := match(
            rcp,
            // Adopted only when the chain ends in a concrete type, so the
            // recursion always leaves the SomeT arm.
            .Some(_) => {
              own_end := resolve_cell_chain(ty);
              cond(
                (_subst_adopts_own(s, orig_id) && !_is_some_t(own_end)) => Option(TypeValue).Some(_substitute_at(s, own_end, false)),
                true => Option(TypeValue).None
              )
            },
            .None => subst_lookup(s, n, lvl)
          );
          match(
            found,
            .Some(replacement) => replacement,
            .None => {
              new_rts := ArrayList(TypeValue).new();
              i := usize(0);
              while(i < rts.len(), {
                elem := match(rts.get(i), .Some(t) => t, .None => TypeValue.Unit);
                new_rts.push(_substitute_at(s, elem, false));
                i = (i + usize(1));
              });
              new_nts := ArrayList(TypeValue).new();
              i = usize(0);
              while(i < nts.len(), {
                elem := match(nts.get(i), .Some(t) => t, .None => TypeValue.Unit);
                new_nts.push(_substitute_at(s, elem, false));
                i = (i + usize(1));
              });
              .SomeT(orig_id, n, lvl, pt, new_rts, rlvls, new_nts, nlvls, Option(TypeValue).None, rcp)
            }
          )
        },
        // Struct / Enum / Union — recurse into field types.
        .Struct({ id, name, field_labels : labels, field_types : types, is_reference_semantics : is_ref, is_atomic_rc : is_atomic, is_newtype : is_nt, constructor_func_id : cfid, type_arguments : tyargs, is_source_namespace : is_sns }) => {
          // Nominal boundary — see _without_len_vars.
          s_nom := _without_len_vars(s);
          new_types := ArrayList(TypeValue).new();
          i := usize(0);
          while(i < types.len(), {
            elem := match(types.get(i), .Some(t) => t, .None => TypeValue.Unit);
            new_types.push(_substitute_at(s_nom, elem, false));
            i = (i + usize(1));
          });
          // Substitute the stored type arguments too, so a generic pattern's
          // `type_arguments` (e.g. `[K, V]`) becomes the concrete `[String, V]`
          // after substitution — keeping them aligned with the substituted fields.
          new_tyargs := ArrayList(TypeValue).new();
          ti := usize(0);
          while(ti < tyargs.len(), {
            targ := match(tyargs.get(ti), .Some(t) => t, .None => TypeValue.Unit);
            new_tyargs.push(_substitute_at(s_nom, targ, false));
            ti = (ti + usize(1));
          });
          // Preserve constructor_func_id across substitution so the
          // type-constructor identity travels with specialized instantiations.
          .Struct(id, name, labels, new_types, is_ref, is_atomic, is_nt, cfid, new_tyargs, is_sns)
        },
        // EnumT has variant_fields : ArrayList(ArrayList(TypeValue)) — nested.
        .EnumT(id, name, variant_names, variant_fields, svn, vfl, discs, eirs, eiar, etas) => {
          // Nominal boundary — see _without_len_vars.
          s_nom_e := _without_len_vars(s);
          new_variant_fields := ArrayList(ArrayList(TypeValue)).new();
          i := usize(0);
          while(i < variant_fields.len(), {
            vf := match(
              variant_fields.get(i),
              .Some(vf_inner) => vf_inner,
              .None => ArrayList(TypeValue).new()
            );
            new_vf := ArrayList(TypeValue).new();
            j := usize(0);
            while(j < vf.len(), {
              elem := match(vf.get(j), .Some(t) => t, .None => TypeValue.Unit);
              new_vf.push(_substitute_at(s_nom_e, elem, false));
              j = (j + usize(1));
            });
            new_variant_fields.push(new_vf);
            i = (i + usize(1));
          });
          // A type argument that IS a type variable is substituted, so a
          // phantom `Tag(K)` at `K := i32` reports `[i32]`, and so is every
          // argument at a PHANTOM position of the constructor
          // (`enum_phantom_positions`), so `Tag(*(K))` reports `[*(i32)]` —
          // `type_key` keys those positions, and a definition-era `*(K)` would
          // key the substituted instance apart from a direct `Tag(*(i32))`.
          // Any other compound argument keeps its definition-era spelling: it
          // also occurs in a payload, which the walk above already rewrote,
          // and walking it a second time doubles the work at every nested
          // instantiation — measured as a stage-2 emit of `src/main.yo` that
          // did not finish in 25 minutes (develop: 9 min 19 s). A phantom
          // position occurs in no payload, so walking it is not a second walk.
          new_etas := ArrayList(TypeValue).new();
          e_mask := if(etas.len() > usize(0), enum_phantom_positions(id), ArrayList(bool).new());
          ti := usize(0);
          while(ti < etas.len(), {
            etarg := match(etas.get(ti), .Some(t) => t, .None => TypeValue.Unit);
            et_phantom := match(e_mask.get(ti), .Some(b) => b, .None => false);
            new_etas.push(if(_is_some_t(etarg) || et_phantom, _substitute_at(s_nom_e, etarg, false), etarg));
            ti = (ti + usize(1));
          });
          .EnumT(id, name, variant_names, new_variant_fields, svn, vfl, discs, eirs, eiar, new_etas)
        },
        .Union(name, labels, types) => {
          new_types := ArrayList(TypeValue).new();
          i := usize(0);
          while(i < types.len(), {
            elem := match(types.get(i), .Some(t) => t, .None => TypeValue.Unit);
            new_types.push(_substitute_at(s, elem, false));
            i = (i + usize(1));
          });
          .Union(name, labels, new_types)
        },
        // Phase 2f variants — recurse into child types
        .ComptimeListT(child) => .ComptimeListT(_substitute_at(s, child, false)),
        .TypeAppT(constructor, args) => {
          new_args := ArrayList(TypeValue).new();
          i := usize(0);
          while(i < args.len(), {
            elem := match(args.get(i), .Some(t) => t, .None => TypeValue.Unit);
            new_args.push(_substitute_at(s, elem, false));
            i = (i + usize(1));
          });
          .TypeAppT(_substitute_at(s, constructor, false), new_args)
        },
        .IsoT(child) => .IsoT(_substitute_at(s, child, false)),
        .DynT(
          required_trait_types : rtt,
          required_trait_levels : rtl,
          negative_trait_types : ntt,
          negative_trait_levels : ntl
        ) => {
          new_rtt := ArrayList(TypeValue).new();
          i := usize(0);
          while(i < rtt.len(), {
            elem := match(rtt.get(i), .Some(t) => t, .None => TypeValue.Unit);
            new_rtt.push(_substitute_at(s, elem, false));
            i = (i + usize(1));
          });
          new_ntt := ArrayList(TypeValue).new();
          i = usize(0);
          while(i < ntt.len(), {
            elem := match(ntt.get(i), .Some(t) => t, .None => TypeValue.Unit);
            new_ntt.push(_substitute_at(s, elem, false));
            i = (i + usize(1));
          });
          // Re-sorted: substituting a trait argument can change its key.
          t_dyn(new_rtt, rtl, new_ntt, ntl)
        },
        .FnTraitT(base_name : bn, call_param_labels : cpls, call_param_types : cpts, call_result : cr, implicit_labels : ils, implicit_types : its, call_param_is_ref : cprf) => {
          new_cpts := ArrayList(TypeValue).new();
          i := usize(0);
          while(i < cpts.len(), {
            elem := match(cpts.get(i), .Some(t) => t, .None => TypeValue.Unit);
            new_cpts.push(_substitute_at(s, elem, false));
            i = (i + usize(1));
          });
          new_its := ArrayList(TypeValue).new();
          (iti : usize) = usize(0);
          while(iti < its.len(), {
            elem := match(its.get(iti), .Some(t) => t, .None => TypeValue.Unit);
            new_its.push(_substitute_at(s, elem, false));
            iti = (iti + usize(1));
          });
          .FnTraitT(base_name : bn, call_param_labels : cpls, call_param_types : new_cpts, call_result : _substitute_at(s, cr, false), implicit_labels : ils, implicit_types : new_its, call_param_is_ref : cprf)
        },
        .FutureTraitT(base_name : bn, output : out, effect_labels : els, effect_types : ets) => {
          new_ets := ArrayList(TypeValue).new();
          i := usize(0);
          while(i < ets.len(), {
            elem := match(ets.get(i), .Some(t) => t, .None => TypeValue.Unit);
            new_ets.push(_substitute_at(s, elem, false));
            i = (i + usize(1));
          });
          .FutureTraitT(base_name : bn, output : _substitute_at(s, out, false), effect_labels : els, effect_types : new_ets)
        },
        // Primitives and leaves — return unchanged.
        _ => ty
      )
    )
  )
);
/// Apply substitution `s` to `ty`. The ROOT node is exempt from the
/// capture-avoiding binder mask: callers that substitute a Func type's OWN
/// forall binders on purpose (`_freshen_io_builtin_callee`'s per-call T/E
/// re-mint) target the root directly, while binders of Funcs encountered
/// DEEPER in the walk always shadow (see _mask_func_own_binders).
substitute :: (fn(imm(s) : Substitution, imm(ty) : TypeValue) -> TypeValue)(_substitute_at(s, ty, true));
/// Apply substitution to every element of a list, returning a new list.
substitute_all :: (fn(imm(s) : Substitution, imm(types) : ArrayList(TypeValue)) -> ArrayList(TypeValue))({
  result := ArrayList(TypeValue).new();
  i := usize(0);
  while(i < types.len(), {
    elem := match(types.get(i), .Some(t) => t, .None => TypeValue.Unit);
    result.push(substitute(s, elem));
    i = (i + usize(1));
  });
  result
});
export(
  Substitution,
  subst_new,
  subst_set_self,
  subst_add,
  subst_adopt_own_resolution,
  subst_lookup,
  subst_add_len_var,
  subst_lookup_len_var,
  substitute,
  substitute_all,
  set_lookup_assoc_const
);
