//! TypeValue — the central representation of types in the Yo type system.
//!
//! A Yo `enum` with per-variant data. See `plans/archive/BOOTSTRAPPING.md`
//! § "Architecture Decisions / 2. Type representation".
//!
//! Notes:
//!   * Fixed-width integers are encoded as `Int(bits, signed)`. Pointer-sized
//!     integers (`usize`/`isize`) and C-compatible types (whose width is
//!     platform-dependent) get their own variants.
//!   * Compound variants store children via `Self` to allow recursion.
//!   * Tuple/Struct field types are stored as parallel `SharedList`s so we
//!     don't need a separate mutually-recursive struct (which would require
//!     a forward-reference dance during evaluation). The `SomeT` bound lists
//!     and a `TraitT`'s five body lists live in one shared mutable cell each
//!     (`SomeTBounds`, `TraitTBody`): the evaluator writes them after the node
//!     is built, and every holder must see the write.
//!   * Generic / unresolved type information (`SomeType`, `TypeApplication`,
//!     traits with associated types, …) is intentionally kept
//!     minimal in this iteration — Phase 2b will fill in the details.
//!
//! Phase A.3.3: this file holds the TypeValue enum only. Type constructors
//! (`t_unit`, `t_some_t`, …) and `type_value_tag` live in `creators.yo`.
//! Variant-shape predicates (`is_int_type`, …) live in `guards.yo`.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList, ArrayListIter } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ RefCell } :: import("std/sync/refcell");
/// The payload of a `SharedList`: one list, never written after it is built.
/// It implements no `Clone` of its own, so the only copy of a `SharedList` is
/// the handle's.
SharedListCell :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(items : ArrayList(T))
);
/// An immutable list shared between every `TypeValue` that holds it: a
/// type's label and type lists (`Struct.field_labels`, `Func.param_types`,
/// `FuncMeta.param_labels`, ...). A copy is one count bump, as for
/// `TypeValue` itself, so reading a list out of a node, or rebuilding a node
/// that keeps one, never copies the list (plans/VALUES_BY_DEFAULT.md V2b's
/// B1 prerequisites: under unique buffers a copy of a plain `ArrayList`
/// field read through the node's `Rc` is a deep copy). Build one with
/// `shared_list(xs)`; read it with `len`/`get`/`is_empty`, `xs(i)` and `for(xs, ...)`,
/// or lend the list itself as `&xs.items`.
/// Its `Clone` is the prelude's `Rc(T)` one, a second handle
/// (plans/VALUES_BY_DEFAULT.md decision 17): `Rc.clone(xs)`.
/// Not every list is shared: a `SomeT`'s four bound lists and a `TraitT`'s
/// `assoc_type_names`, `field_labels`, `field_types`, `self_constraints` and
/// `neg_self_constraints` are written after the node is built, and every
/// holder of the node sees the write, so they live in a mutable cell
/// (`SomeTBounds`, `TraitTBody`;
/// issues/fixed/2026-10-20-typevalue-constraint-lists-are-stamped-in-place.md).
/// Never hand a `SharedList`'s buffer to one of those lists, or to any list
/// that is pushed onto: copy it (`xs.items.clone()`). An empty `SharedList`
/// is the element type's one global empty list (`no_types()`, ...), so a
/// write through an alias would reach every empty list of the compiler.
SharedList :: (fn(comptime(T) : Type) -> comptime(Type))(Rc(SharedListCell(T)));
/// A SomeT's trait bounds: the required and negative trait constraints,
/// each with the env frame level it was added at.
SomeTBoundsCell :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    required : ArrayList(T),
    required_levels : ArrayList(usize),
    negative : ArrayList(T),
    negative_levels : ArrayList(usize)
  )
);
/// The ONE mutable cell inside a `TypeValue` (consultation #13 §10). A
/// SomeT's bounds are shared by every holder of that SomeT, because a where
/// clause stamps a bound after the SomeT is already held by a parameter type,
/// a list element type or an impl head. Exactly two writers call `with_mut`
/// (`_add_where_clause_constraint`, `src/evaluator/types/function.yo`, and the
/// impl where-clause stamp in `src/evaluator/values/impl.yo`). Every NEW SomeT
/// (substitution, instantiation, a resolution copy) builds a fresh cell with
/// `some_t_bounds`, never a copy of another SomeT's `Rc`. Readers snapshot
/// a list or read inside one `with`.
SomeTBounds :: (fn(comptime(T) : Type) -> comptime(Type))(Rc(RefCell(SomeTBoundsCell(T))));
/// A trait's members and Self constraints: associated type names, member
/// labels and types, and the positive and negative `where(Self <: X)`
/// constraints.
TraitTBodyCell :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(
    assoc_type_names : ArrayList(String),
    field_labels : ArrayList(String),
    field_types : ArrayList(T),
    self_constraints : ArrayList(T),
    neg_self_constraints : ArrayList(T)
  )
);
/// A trait's body: the second mutable cell inside a `TypeValue`
/// (consultation #13 §13, beside `SomeTBounds`). A trait's node is minted
/// before its body is evaluated, because the body names the trait itself
/// (`SelfTrait`, `Self.X` through `ctx.self_trait_type`, a member type over
/// `Dyn(SelfTrait)`); its members and `where(Self <: X)` constraints arrive
/// afterwards and must reach every holder, since traits have no id-to-value
/// resolution: a `Dyn` vtable, an impl check and a default-method lookup
/// all read the embedded node's lists. The writers are `evaluate_trait_type`'s
/// member pushes and the two `where(Self <: X)` parsers
/// (`src/evaluator/types/trait.yo`), each through `with_mut`. Every NEW
/// trait identity (a parameterized trait's instantiation) builds a fresh
/// cell with `trait_t_body`, never a copy of another trait's `Rc`. Readers
/// snapshot a list or read inside one `with`.
TraitTBody :: (fn(comptime(T) : Type) -> comptime(Type))(Rc(RefCell(TraitTBodyCell(T))));
/// The element types a `SharedList` holds, each naming its one shared empty
/// list (`no_types()`, `no_labels()`, ...).
SharedListElem :: trait(
  /// The shared empty list of this element type.
  no_list : (fn() -> SharedList(Self))
);
/// Share `items` as a `SharedList`. An empty `items` yields the element
/// type's shared empty list: most nodes carry several empty lists
/// (`Func.where_types`, `Struct.type_arguments`, ...), and a cell per empty
/// list would be an allocation per list.
shared_list :: (fn(generic(T : Type), sink(items) : ArrayList(T), where(T <: SharedListElem)) -> SharedList(T))(
  cond(
    items.is_empty() => T.no_list(),
    true => Rc.new(SharedListCell(T)(items : items))
  )
);
// The reads, declared per element type rather than once for every `T`:
// these are called wherever a type's lists are read, and the concrete impls
// are measurably cheaper to check than one generic impl's methods on the
// `Rc` (`check src/main.yo`: 2,003M allocation calls with one generic impl,
// 1,952M with these).
impl(
  SharedList(TypeValue),
  /// Number of elements.
  len : (fn(self : &Self) -> usize)(self.*.items.len()),
  /// True when the list holds no elements.
  is_empty : (fn(self : &Self) -> bool)(self.*.items.is_empty()),
  /// The element at `i`, or `.None` past the end.
  get : (fn(self : &Self, i : usize) -> Option(TypeValue))(self.*.items.get_cloned(i)),
  /// `xs(i)` reads the element at `i` (a read projection); panics past the end.
  Index(usize)(
    Output : TypeValue,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)(&self.*.items(idx))
  ),
  /// `for(xs, x => ...)` walks the list's elements.
  IntoIterator(
    Item : TypeValue,
    IntoIter : ArrayListIter(TypeValue),
    into_iter : (fn(self : Self) -> ArrayListIter(TypeValue))(self.*.items.clone().into_iter())
  )
);
impl(
  SharedList(String),
  /// Number of elements.
  len : (fn(self : &Self) -> usize)(self.*.items.len()),
  /// True when the list holds no elements.
  is_empty : (fn(self : &Self) -> bool)(self.*.items.is_empty()),
  /// The element at `i`, or `.None` past the end.
  get : (fn(self : &Self, i : usize) -> Option(String))(self.*.items.get_cloned(i)),
  /// A clone of the element at `i`, or `.None` past the end (`ArrayList`'s
  /// spelling, so a list read out of a `StructVal`/`TraitVal` reads the same).
  get_cloned : (fn(self : &Self, i : usize) -> Option(String))(self.*.items.get_cloned(i)),
  /// `xs(i)` reads the element at `i` (a read projection); panics past the end.
  Index(usize)(
    Output : String,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)(&self.*.items(idx))
  ),
  /// `for(xs, x => ...)` walks the list's elements.
  IntoIterator(
    Item : String,
    IntoIter : ArrayListIter(String),
    into_iter : (fn(self : Self) -> ArrayListIter(String))(self.*.items.clone().into_iter())
  )
);
impl(
  SharedList(bool),
  /// Number of elements.
  len : (fn(self : &Self) -> usize)(self.*.items.len()),
  /// True when the list holds no elements.
  is_empty : (fn(self : &Self) -> bool)(self.*.items.is_empty()),
  /// The element at `i`, or `.None` past the end.
  get : (fn(self : &Self, i : usize) -> Option(bool))(self.*.items.get(i)),
  /// `xs(i)` reads the element at `i` (a read projection); panics past the end.
  Index(usize)(
    Output : bool,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)(&self.*.items(idx))
  ),
  /// `for(xs, x => ...)` walks the list's elements.
  IntoIterator(
    Item : bool,
    IntoIter : ArrayListIter(bool),
    into_iter : (fn(self : Self) -> ArrayListIter(bool))(self.*.items.clone().into_iter())
  )
);
impl(
  SharedList(usize),
  /// Number of elements.
  len : (fn(self : &Self) -> usize)(self.*.items.len()),
  /// True when the list holds no elements.
  is_empty : (fn(self : &Self) -> bool)(self.*.items.is_empty()),
  /// The element at `i`, or `.None` past the end.
  get : (fn(self : &Self, i : usize) -> Option(usize))(self.*.items.get(i)),
  /// `xs(i)` reads the element at `i` (a read projection); panics past the end.
  Index(usize)(
    Output : usize,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)(&self.*.items(idx))
  ),
  /// `for(xs, x => ...)` walks the list's elements.
  IntoIterator(
    Item : usize,
    IntoIter : ArrayListIter(usize),
    into_iter : (fn(self : Self) -> ArrayListIter(usize))(self.*.items.clone().into_iter())
  )
);
impl(
  SharedList(i64),
  /// Number of elements.
  len : (fn(self : &Self) -> usize)(self.*.items.len()),
  /// True when the list holds no elements.
  is_empty : (fn(self : &Self) -> bool)(self.*.items.is_empty()),
  /// The element at `i`, or `.None` past the end.
  get : (fn(self : &Self, i : usize) -> Option(i64))(self.*.items.get(i)),
  /// `xs(i)` reads the element at `i` (a read projection); panics past the end.
  Index(usize)(
    Output : i64,
    index : (fn(self : &Self, idx : usize) -> &Self.Output)(&self.*.items(idx))
  ),
  /// `for(xs, x => ...)` walks the list's elements.
  IntoIterator(
    Item : i64,
    IntoIter : ArrayListIter(i64),
    into_iter : (fn(self : Self) -> ArrayListIter(i64))(self.*.items.clone().into_iter())
  )
);
impl(
  SharedList(SharedList(TypeValue)),
  /// Number of elements.
  len : (fn(self : &Self) -> usize)(self.*.items.len()),
  /// True when the list holds no elements.
  is_empty : (fn(self : &Self) -> bool)(self.*.items.is_empty()),
  /// The element at `i`, or `.None` past the end.
  get : (fn(self : &Self, i : usize) -> Option(SharedList(TypeValue)))(self.*.items.get_cloned(i)),
  /// `xs(i)` reads the element at `i` (a read projection); panics past the end.
  Index(usize)(
    Output : SharedList(TypeValue),
    index : (fn(self : &Self, idx : usize) -> &Self.Output)(&self.*.items(idx))
  ),
  /// `for(xs, x => ...)` walks the list's elements.
  IntoIterator(
    Item : SharedList(TypeValue),
    IntoIter : ArrayListIter(SharedList(TypeValue)),
    into_iter : (fn(self : Self) -> ArrayListIter(SharedList(TypeValue)))(self.*.items.clone().into_iter())
  )
);
impl(
  SharedList(SharedList(String)),
  /// Number of elements.
  len : (fn(self : &Self) -> usize)(self.*.items.len()),
  /// True when the list holds no elements.
  is_empty : (fn(self : &Self) -> bool)(self.*.items.is_empty()),
  /// The element at `i`, or `.None` past the end.
  get : (fn(self : &Self, i : usize) -> Option(SharedList(String)))(self.*.items.get_cloned(i)),
  /// `xs(i)` reads the element at `i` (a read projection); panics past the end.
  Index(usize)(
    Output : SharedList(String),
    index : (fn(self : &Self, idx : usize) -> &Self.Output)(&self.*.items(idx))
  ),
  /// `for(xs, x => ...)` walks the list's elements.
  IntoIterator(
    Item : SharedList(String),
    IntoIter : ArrayListIter(SharedList(String)),
    into_iter : (fn(self : Self) -> ArrayListIter(SharedList(String)))(self.*.items.clone().into_iter())
  )
);
// A `SharedList` copy is one count bump, `Rc.clone(xs)` (see `SharedList`;
// the prelude's `Rc(T)` clone, plans/VALUES_BY_DEFAULT.md decision 17). Each
// list is built once and never written (no mutator reaches `items` through the
// read-only `Rc`, decision 46), so a cell points only at older values and
// none reaches itself.
/// Non-recursive ("meta") fields of a function type, factored out of the
/// `TypeValue.Func` variant and stored behind an `Rc` (P2 memory: the inline
/// Func variant set `sizeof(TypeValue)` to ~150 B — wasted in every small-type
/// inline copy across millions of `Variable.ty` / `ExprInfo` fields). These
/// fields reference only `String`/`bool`/`Option(String)` — NOT `Self` — so the
/// struct can be defined BEFORE `TypeValue` without the forward-reference dance
/// (see the parallel-array note above). The Self-typed Func fields
/// (`*_types`/`result`) stay inline on the variant.
FuncMeta :: struct(
  forall_labels : SharedList(String),
  // generic type-var names (parallel to Func.forall_types)
  param_labels : SharedList(String),
  // normal parameter labels (parallel to Func.param_types)
  implicit_labels : SharedList(String),
  // implicit (`using`) parameter labels (parallel to Func.implicit_types)
  /// True when the declared return is `comptime(...)`. Gates
  /// CTFE; the FuncVal-call delegation + `evaluate_comptime_fn_call`'s
  /// `should_cache` use it to route type-constructor calls through memoization.
  result_is_comptime_only : bool,
  /// True when the param list ends with a `...` variadic marker (C-style
  /// variadic externs). The
  /// call-site arg-count check is skipped when set.
  has_variadic : bool,
  /// FFI language tag (`extern "c"`/`"yo"` / `c_include`). `Some("c")` etc. for
  /// FFI symbols, `None` for ordinary Yo functions. Read by the extern-call
  /// `unsafe(...)` gate in
  /// `calls/function.yo` (a call to an `is_extern == Some("c")` function outside
  /// `unsafe(...)`/an auto-generated expansion is rejected).
  is_extern : Option(String),
  /// The FFI symbol name to bind, when known.
  /// Used only for the gate's diagnostic message.
  extern_name : Option(String),
  /// True for a `ctl(...) -> ret` control-function type.
  /// A `ctl` value is FRAME-BOUND (its body may
  /// `unwind` out of the enclosing install frame) so it must not escape. Read
  /// by `type_is_control_bound` + the §4 escape-boundary checks.
  is_control : bool,
  /// The variadic parameter's BINDING NAME (`...(xs : T)` → "xs"), when the
  /// fn type has one. The
  /// variadic TYPE cannot live here (FuncMeta is declared before TypeValue —
  /// no forward references) — it rides in `Func.variadic_types` (0-or-1);
  /// readers append the variadic param to the param list from both.
  variadic_label : Option(String),
  /// True when the variadic parameter is comptime (`...(xs : ComptimeList)`).
  variadic_comptime : bool,
  /// AST id of the `fn(...)` TYPE EXPRESSION this function type was evaluated
  /// from, when there is one. `is_compile_time_only`, the
  /// per-parameter type exprs and the return-type expr live in func-id-keyed SIDE
  /// TABLES registered under that expression's id
  /// (evaluator/types/function.yo). The `::` path re-keys them onto the FuncVal
  /// id (evaluator/calls/function_type.yo); an ANONYMOUS function checked
  /// against an expected function type mints its own id and had no way to reach
  /// them, so a `comptime(T) : Type` parameter/return was lost. This
  /// field fixes that: it travels with the type through the same
  /// `meta.clone()` an expected-type spread performs. Defaulted so the 20+
  /// existing construction sites are unaffected.
  (origin_id : Option(String)) ?= Option(String).None,
  /// Per-parameter `sink(x)` flags (see `FuncParam.is_sink`): the caller
  /// moves the argument instead of sharing a still implicitly copyable kind.
  /// Caller-side only, so not part of the function type's identity; `.None`
  /// means none is `sink`.
  (param_is_sink : Option(SharedList(bool))) ?= Option(SharedList(bool)).None,
  /// The `generic(p : Origin)` binders (decision 43 step 2, N1a): the
  /// origin parameters a slot's `OriginSet` may name. They are not
  /// `forall_labels` — a function abstract only over origins is not generic
  /// (origins are erased from every identity but the borrow checker's, so
  /// nothing specializes on them). Not in `type_to_string`, `type_key` or the
  /// intern key: the slots that name them already differ. `.None` = none.
  (origin_labels : Option(SharedList(String))) ?= Option(SharedList(String)).None
);
derive(FuncMeta, Clone);
/// One node of the Yo type universe: the payload behind a `TypeValue` handle.
///
/// `TypeValue` is `Rc(TypeValueNode)` (plans/VALUES_BY_DEFAULT.md decision
/// 21, as built 2026-10-13): every child is an `Rc(Self)` handle, so a node
/// is never copied and a clone is one count bump. Build a type with
/// `Rc.new(TypeValueNode.X(...))`; a `match` on a `TypeValue` looks through the
/// handle, so arms name the variants directly.
TypeValueNode :: enum(
  // Primitive value types ---------------------------------------------------
  Unit,
  BoolT,
  Void,
  /// `never` — the bottom type: the type of an expression that does not
  /// complete (`__yo_panic`, a call to a `-> never` function such as
  /// `std/assert`'s `panic` or `std/process`'s `exit`). It flows into every
  /// type and is the identity of a `cond`/`match` arm join, so a diverging
  /// arm does not constrain the result (plans/TYPE_SYSTEM_SOUNDNESS.md
  /// Phase 3.6). No value of it exists; C lowers it to `void`.
  Never,
  /// `str` — builtin immutable fat-pointer view of STATIC string bytes.
  /// C lowering:
  /// `typedef struct { const uint8_t* ptr; size_t len; } __yo_str;`
  Str,
  /// Fixed-width integer. `bits` ∈ {8, 16, 32, 64}; `signed` distinguishes
  /// `iN` vs `uN`.
  Int(bits : u8, signed : bool),
  /// Floating-point. `bits` ∈ {32, 64}.
  Float(bits : u8),
  /// Pointer-sized unsigned integer.
  Usize,
  /// Pointer-sized signed integer.
  Isize,
  // Compile-time numeric / string types -------------------------------------
  ComptimeInt,
  ComptimeFloat,
  ComptimeString,
  // C-compatible types (platform-dependent width) ---------------------------
  CChar,
  CShort,
  CUShort,
  CInt,
  CUInt,
  CLong,
  CULong,
  CLongLong,
  CULongLong,
  CLongDouble,
  // Type universes ---------------------------------------------------------
  /// `Type`, `Type(1)`, `Type(2)`, …  `level` ∈ {0,1,2,…}.
  TypeUni(level : usize),
  // Compound types ---------------------------------------------------------
  Pointer(pointee : Rc(Self)),
  /// `length_var` carries the VALUE-ness of the declared length:
  /// "" = `length` is the concrete element count; non-empty = the length is
  /// an unresolved generic VARIABLE of that name (e.g. the `U` in
  /// `impl(generic(T : Type, U : usize), Array(T, U), ...)`) and `length`
  /// is a meaningless placeholder; the variable is bound during synthesis.
  Array(element : Rc(Self), length : usize, length_var : String),
  /// Anonymous tuple. `field_labels(i)` is the optional label for the i-th
  /// field (empty `String` means positional). `field_types(i)` is the type.
  Tuple(field_labels : SharedList(String), field_types : SharedList(Rc(Self))),
  /// Function type. Phase 2b: generic type-vars, implicit (using) params,
  /// and where-clause constraint types. `param_types` holds parameter SLOTS:
  /// a parameter's mode is its slot type (`T` by value, `Reference(T, ...)`
  /// for `&T` / `&mut T`; see `t_slot`), so read a parameter's value type
  /// through `t_slot_pointee`.
  /// Self-typed (recursive) fields stay inline; the non-recursive metadata
  /// (labels, result/variadic/extern/control flags) lives in `meta`
  /// (`Rc(FuncMeta)`) so this variant no longer sets `sizeof(TypeValue)` to
  /// ~150 B. `forall_types`/`param_types`/`implicit_types`/`where_types` are
  /// parallel to the label arrays in `meta`; `result` is the return type.
  Func(
    forall_types : SharedList(Rc(Self)),
    param_types : SharedList(Rc(Self)),
    implicit_types : SharedList(Rc(Self)),
    where_types : SharedList(Rc(Self)),
    result : Rc(Self),
    meta : Rc(FuncMeta),
    /// The variadic parameter's TYPE (0 or 1 elements — the list is a
    /// poor man's Option(Self) since Self-typed Options are unavailable in
    /// a variant position).
    /// the label/comptime flags live in `FuncMeta.variadic_label` /
    /// `variadic_comptime` (FuncMeta cannot reference TypeValue).
    variadic_types : SharedList(Rc(Self))
  ),
  // Named user-defined types ------------------------------------------------
  /// `id` uniquely identifies this struct definition.
  /// Set to `""` for types reconstructed
  /// from runtime values via `type_of_eval_value`.
  /// `is_reference_semantics` = true for `object(...)`, false for `struct(...)`.
  /// `is_atomic_rc` = true for `atomic object(...)`.
  /// `is_newtype` = true for `newtype(...)`.
  /// `constructor_func_id` is the func id of the comptime
  /// type-constructor that produced this type (set at the comptime-fn call
  /// site, `evaluator/calls/comptime_fn.yo`). The synthesizer uses
  /// it to unify two instantiations of the SAME generic constructor
  /// (`evaluator/types/synthesizer.yo` compares constructor ids).
  /// `""` = unknown origin.
  /// Only the id is stored, not the whole function value, because
  /// `TypeValue` (this module) cannot import `EvalValue` (`value.yo`) without
  /// a cycle — and the id is the only part the synthesizer reads.
  Struct(
    id : String,
    name : String,
    field_labels : SharedList(String),
    field_types : SharedList(Rc(Self)),
    is_reference_semantics : bool,
    is_atomic_rc : bool,
    is_newtype : bool,
    constructor_func_id : String,
    /// Concrete type arguments of a generic instantiation, in constructor-
    /// parameter order (`HashMap(String, String)` → `[String, String]`). Empty
    /// for non-generic or not-yet-instantiated structs. Stands in for a
    /// carried instantiation env: a method dispatched
    /// on this struct binds its `generic` params positionally from here. See
    /// plans/archive/STRUCT_TYPE_ARGUMENTS.md.
    type_arguments : SharedList(Rc(Self)),
    /// True for source-namespace structs — anonymous modules (`impl({...})`,
    /// extern blocks) and imported modules. There is NO separate module type;
    /// modules ARE structs with this marker. See
    /// plans/archive/MODULE_AS_STRUCT_ALIGNMENT.md.
    is_source_namespace : bool
  ),
  /// `EnumT` rather than `Enum` to avoid clashing with the keyword.
  /// Each variant has a name and a `SharedList` of field types (possibly empty).
  /// `selected_variant_name` is set when the type has been narrowed to a specific
  /// variant (e.g. after pattern matching or destructuring).
  ///
  /// `variant_field_labels` holds the per-variant label names in declaration
  /// order — used by labeled destructuring and match (Phase 2ae+).
  /// `id` uniquely identifies this enum definition.
  /// `variant_discriminants` holds one discriminant value per variant (in order).
  ///
  /// `is_reference_semantics` = true for `ref(enum(...))`, false for `enum(...)`.
  /// `is_atomic_rc` = true for `atomic(ref(enum(...)))`.
  /// plans/reference/REF_REFERENCE_SEMANTICS.md Phase 3.
  EnumT(
    id : String,
    name : String,
    variant_names : SharedList(String),
    variant_fields : SharedList(SharedList(Rc(Self))),
    selected_variant_name : Option(String),
    variant_field_labels : SharedList(SharedList(String)),
    variant_discriminants : SharedList(i64),
    is_reference_semantics : bool,
    is_atomic_rc : bool,
    /// Type arguments of the generic constructor call that minted this
    /// instantiation, in constructor-parameter order (`P(i32)` -> `[i32]`;
    /// a non-type argument records `Unit`). The enum twin of
    /// `Struct.type_arguments`, stamped at the comptime-fn call site
    /// (`evaluator/calls/comptime_fn.yo`). `substitute` rewrites an argument
    /// that is a type variable, so a phantom `Tag(K)` at `K := i32` reports
    /// `[i32]`; a compound argument (`*(T)`) keeps its definition-era
    /// spelling, and the payloads are what say `*(u8)`. Empty for a
    /// non-generic enum or a copy that predates the stamp. Without it, two
    /// instantiations whose payloads do not mention a parameter (a phantom
    /// index, a GADT index only `-> recur(...)` names) are structurally
    /// identical
    /// (issues/fixed/enum-type-constructor-arguments-are-ignored-by-type-compatibility.md).
    type_arguments : SharedList(Rc(Self))
  ),
  Union(
    name : String,
    field_labels : SharedList(String),
    field_types : SharedList(Rc(Self))
  ),
  // Traits / modules --------------------------------------------------------
  /// Named trait type. Phase 2b: associated type names and method/field list.
  /// Phase 2aq: `id` for unique identity, `is_concrete` for `Concrete(T)` marker.
  /// Phase 2az: `self_constraints` and `neg_self_constraints` for
  /// where-clause / negative where-clause constraints on Self.
  TraitT(
    name : String,
    // associated type names, member labels and types, and the Self
    // constraints: ONE shared mutable cell (`TraitTBody`)
    body : TraitTBody(Rc(Self)),
    id : String,
    // unique identity string
    is_concrete : Option(Rc(Self)),
    // Some(T) when this is `Concrete(T)`
    assoc_constraint_labels : SharedList(String),
    // labels of `Item := X` associated-type constraints
    assoc_constraint_types : SharedList(Rc(Self)) // constraint types
  ),
  // Generic / unresolved ----------------------------------------------------
  /// A `SomeType` introduced by `generic` or by a yet-to-be-resolved generic
  /// parameter. `frame_level` is the env frame at which it was introduced.
  /// Phase 2b: required and negative trait constraint lists.
  /// Phase 2d: `id` for unique identity.
  /// Phase 2e: `parent_type` — the meta-type of this type variable (usually TypeUni(0)).
  SomeT(
    id : String,
    // unique identity string
    name : String,
    frame_level : usize,
    parent_type : Rc(Self),
    // meta-type (TypeUni(0) by default)
    // The trait bounds: ONE shared mutable cell (`SomeTBounds`). A where
    // clause stamps a bound onto an existing SomeT after `x : T`,
    // `ArrayList(T)` or an `Arc(T)` impl head already hold it, and every
    // holder of this identity must see it.
    bounds : SomeTBounds(Rc(Self)),
    // When present, this SomeT represents a higher-kinded type variable
    // (e.g. `F : (fn(T : Type) -> Type)`). The boxed `Func` TypeValue
    // captures the kind so `F(A)` can be evaluated as a TypeApplication.
    kind_function_type : Option(Rc(Self)),
    // The concrete type this SomeType stands for, when it is known where the
    // SomeT is built: an opaque `Impl(...)` return's hidden type, a closure
    // wrapper's capture struct, a call's per-call resolution
    // (`_with_resolved_concrete`). An immutable VALUE: a copy carries it,
    // and nothing writes it after construction, so two SomeTs never share a
    // resolution they could change under each other (plans/
    // TYPE_SYSTEM_SOUNDNESS.md Phase 3.7; until then this was a one-element
    // ArrayList used as a shared mutable cell). A resolution learned later
    // builds a new SomeT carrying it. EXCLUDED from type_key and
    // compatibility identity except where they hop to it explicitly; the
    // intern key renders it, so two SomeTs that differ only here stay two
    // instances.
    resolution : Option(Rc(Self))
  ),
  // Phase 2f: advanced type variants ----------------------------------------
  /// The Yo `Expr` type (a quoted expression node).
  ExprT,
  /// A compile-time homogeneous list. `child` is the element type.
  ComptimeListT(child : Rc(Self)),
  /// Application of a generic type constructor to arguments.
  /// `constructor` is always a `SomeT` (the type-constructor variable).
  TypeAppT(
    constructor : Rc(Self),
    args : SharedList(Rc(Self))
  ),
  /// Dynamic-dispatch type with trait bounds.
  DynT(
    required_trait_types : SharedList(Rc(Self)),
    required_trait_levels : SharedList(usize),
    negative_trait_types : SharedList(Rc(Self)),
    negative_trait_levels : SharedList(usize)
  ),
  /// Fn-trait type (Fn / FnMut / FnOnce). The call signature is flattened
  /// into the variant; `call_param_types` holds parameter SLOTS, as
  /// `Func.param_types` does, so `Fn(v : &mut T) -> R` binds `v` through a
  /// pointer (the sync/mutex `with_lock` write-through failure was a mode
  /// dropped on this path).
  FnTraitT(
    base_name : String,
    call_param_labels : SharedList(String),
    call_param_types : SharedList(Rc(Self)),
    call_result : Rc(Self),
    implicit_labels : SharedList(String),
    implicit_types : SharedList(Rc(Self))
  ),
  /// Future-trait type with associated output and effects.
  FutureTraitT(
    base_name : String,
    output : Rc(Self),
    effect_labels : SharedList(String),
    effect_types : SharedList(Rc(Self)),
    /// The places the future borrows (decision 43 step 4, N3-1:
    /// `Future(T, p)`), an `OriginSet`; elided (O2) when spelled
    /// `Future(T, E)`.
    origin : Rc(Self)
  ),
  /// V6 task 3 (FORMAL_VERIFICATION.md §7): `refine(T, p)` — "a `T` that
  /// satisfies `p`". Distinct at the type level (two predicates over the
  /// same `T` are different types), ERASED to `T` at every runtime
  /// surface: the guard predicates and `type_value_tag` unwrap to
  /// `inner`, variable bindings store `inner` (env.yo), and codegen
  /// therefore emits `T`'s representation unchanged (zero runtime cost —
  /// the plan's erasure rule). The predicate is a ghost_fn VALUE carried
  /// by its `func_id` (TypeValue cannot import EvalValue — the
  /// `Struct.constructor_func_id` precedent); the verifier resolves the
  /// body through the ghost-fn def registry (contracts.yo) and discharges
  /// it: ASSUMED for a refined parameter at the callee entry, PROVED
  /// (`refine#N`) for an argument at a call site. `""` = no predicate
  /// (a pure alias — no obligation).
  RefineT(
    inner : Rc(Self),
    predicate_func_id : String
  ),
  /// An opaque C type declared by `extern("Yo", X : Type)` or a `c_include`
  /// `X : Type`: a concrete type whose layout only the C compiler knows. It
  /// is NOMINAL: two are the same type exactly when they lower to the same
  /// C spelling (`c_name`, e.g. `struct stat` for `stat_buf :
  /// c_type("struct stat")`); it is never a type variable and satisfies no
  /// bound it was not given (plans/reference/TYPE_IDENTITY.md). `name` is
  /// the Yo label, for diagnostics. It used to be a SomeT recorded in a
  /// name registry, which made it unify with every `Dyn` and made any SomeT
  /// that happened to share its name extern
  /// (issues/fixed/an-extern-opaque-type-unifies-with-every-dyn.md).
  ExternOpaqueT(
    name : String,
    c_name : String
  ),
  // References and origins (plans/VALUES_BY_DEFAULT.md decision 43 step 1;
  // plans/backlog/REFERENCES_AND_ORIGINS.md O1) ------------------------------
  /// The `Origin` kind: the type of an origin value, as `TypeUni` is the
  /// type of a type. Nothing produces it yet; step 2's `generic(p : Origin)`
  /// gives it a spelling.
  OriginKind,
  /// A value of the `Origin` kind: a set of places. `places` names them (a
  /// reference parameter's own place is spelled by the parameter's name);
  /// `is_elided` = written without an origin, which step 2's elision defaults
  /// resolve. Step 1 builds only the one shared elided origin
  /// (`t_origin_elided`).
  OriginSet(
    places : SharedList(String),
    is_elided : bool
  ),
  /// `&T` (`mutable = false`) or `&mut T` (`mutable = true`) with its origin,
  /// a value of the `Origin` kind. Only a SLOT holds one: a parameter slot
  /// (`Func.param_types`, `FnTraitT.call_param_types`, step 1) or a `Func`'s
  /// result slot (a projection, step 2 N1b): the slot's mode IS its type, and
  /// a by-value parameter's slot or an ordinary result is the bare `T`. A reader
  /// that wants the parameter's value type takes `t_slot_pointee`. The
  /// origin is erased from every identity but the borrow checker's
  /// (`type_key`, the memos, specialization keys and C type identity never
  /// read it), and codegen lowers the slot to `T*` / `T` exactly as the
  /// mode flags this replaced did.
  Reference(
    pointee : Rc(Self),
    mutable : bool,
    origin : Rc(Self)
  )
);
/// The Yo type universe: a shared, immutable handle to a `TypeValueNode`.
TypeValue :: Rc(TypeValueNode);
/// V6 task 3: unwrap ONE refinement wrapper — `refine(T, p)` reads as `T`
/// for every runtime surface (the erasure rule). Lives HERE (not in
/// guards.yo) because guards.yo imports creators.yo, whose
/// `type_value_tag` needs the unwrap — the import direction forbids the
/// reverse. Not recursive by itself; a guard on a nested
/// `refine(refine(i32, p), q)` unwraps one level per match, which is
/// enough for every integer/bool surface.
t_refine_inner :: (fn(t : &TypeValue) -> TypeValue)(
  match(
    t,
    Rc(.RefineT(inner, _)) => Rc.clone(inner),
    _ => Rc.clone(t)
  )
);

// A `TypeValue` copy is one count bump, the prelude's `Rc(T)` clone
// (`Rc.clone(t)`, plans/VALUES_BY_DEFAULT.md decision 17), sharing the whole
// node. A `TypeValue` is rebuilt, never mutated (`substitute` and every other
// consumer construct FRESH nodes; a codebase-wide audit found no in-place
// write to a node's fields; the `ArrayList` lists named under `SharedList`
// are pushed to in place, and that write is meant to reach every holder), so
// sharing is sound (plans/backlog/TYPEVALUE_HASH_CONSING.md §5).
// A TypeValue is rebuilt, never mutated (the audit above): its
// children are filled when it is built and never written afterwards, so a
// node only points at nodes older than itself and none reaches itself;
// recursive types recur through ids and the self shell, not through pointers
// (plans/VALUES_BY_DEFAULT.md decision 21). The type lists inside a node
// are acyclic for the same reason (see `SharedList`).
// The empty lists, one shared cell each (`shared_list` of an empty list
// returns these through `SharedListElem`).
(g_no_types : SharedList(TypeValue)) = Rc.new(SharedListCell(TypeValue)(items : ArrayList(TypeValue).new()));
(g_no_labels : SharedList(String)) = Rc.new(SharedListCell(String)(items : ArrayList(String).new()));
(g_no_flags : SharedList(bool)) = Rc.new(SharedListCell(bool)(items : ArrayList(bool).new()));
(g_no_levels : SharedList(usize)) = Rc.new(SharedListCell(usize)(items : ArrayList(usize).new()));
(g_no_discriminants : SharedList(i64)) = Rc.new(SharedListCell(i64)(items : ArrayList(i64).new()));
(g_no_type_lists : SharedList(SharedList(TypeValue))) = Rc.new(
  SharedListCell(SharedList(TypeValue))(items : ArrayList(SharedList(TypeValue)).new())
);
(g_no_label_lists : SharedList(SharedList(String))) = Rc.new(
  SharedListCell(SharedList(String))(items : ArrayList(SharedList(String)).new())
);
/// The shared empty type list.
no_types :: (fn() -> SharedList(TypeValue))(Rc.clone(g_no_types));
/// The shared empty label list.
no_labels :: (fn() -> SharedList(String))(Rc.clone(g_no_labels));
/// The shared empty flag list.
no_flags :: (fn() -> SharedList(bool))(Rc.clone(g_no_flags));
/// The shared empty level list.
no_levels :: (fn() -> SharedList(usize))(Rc.clone(g_no_levels));
/// The shared empty discriminant list.
no_discriminants :: (fn() -> SharedList(i64))(Rc.clone(g_no_discriminants));
/// The shared empty list of type lists (an enum's `variant_fields`).
no_type_lists :: (fn() -> SharedList(SharedList(TypeValue)))(Rc.clone(g_no_type_lists));
/// The shared empty list of label lists (an enum's `variant_field_labels`).
no_label_lists :: (fn() -> SharedList(SharedList(String)))(Rc.clone(g_no_label_lists));
impl(TypeValue, SharedListElem(no_list : no_types));
impl(String, SharedListElem(no_list : no_labels));
impl(bool, SharedListElem(no_list : no_flags));
impl(usize, SharedListElem(no_list : no_levels));
impl(i64, SharedListElem(no_list : no_discriminants));
impl(SharedList(TypeValue), SharedListElem(no_list : no_type_lists));
impl(SharedList(String), SharedListElem(no_list : no_label_lists));
/// A fresh bounds cell holding these lists (a NEW SomeT identity).
some_t_bounds :: (
  fn(sink(required) : ArrayList(TypeValue), sink(required_levels) : ArrayList(usize), sink(negative) : ArrayList(TypeValue), sink(negative_levels) : ArrayList(usize)) -> SomeTBounds(TypeValue)
)(
  Rc.new(
    RefCell(SomeTBoundsCell(TypeValue)).new(
      SomeTBoundsCell(TypeValue)(required : required, required_levels : required_levels, negative : negative, negative_levels : negative_levels)
    )
  )
);
/// A fresh, empty bounds cell (a freshly minted generic).
some_t_bounds_empty :: (fn() -> SomeTBounds(TypeValue))(
  some_t_bounds(ArrayList(TypeValue).new(), ArrayList(usize).new(), ArrayList(TypeValue).new(), ArrayList(usize).new())
);
impl(
  SomeTBounds(TypeValue),
  /// A snapshot of the required trait constraints.
  required : (fn(self : &Self) -> ArrayList(TypeValue))(self.*.with({ &self }(b) => b.required.clone())),
  /// A snapshot of the required constraints' frame levels.
  required_levels : (fn(self : &Self) -> ArrayList(usize))(self.*.with({ &self }(b) => b.required_levels.clone())),
  /// A snapshot of the negative trait constraints.
  negative : (fn(self : &Self) -> ArrayList(TypeValue))(self.*.with({ &self }(b) => b.negative.clone())),
  /// A snapshot of the negative constraints' frame levels.
  negative_levels : (fn(self : &Self) -> ArrayList(usize))(self.*.with({ &self }(b) => b.negative_levels.clone())),
  /// Number of required constraints, read in place.
  required_len : (fn(self : &Self) -> usize)(self.*.with({ &self }(b) => b.required.len())),
  /// Number of negative constraints, read in place.
  negative_len : (fn(self : &Self) -> usize)(self.*.with({ &self }(b) => b.negative.len()))
);
/// A fresh trait body cell holding these lists (a NEW trait identity).
trait_t_body :: (
  fn(sink(assoc_type_names) : ArrayList(String), sink(field_labels) : ArrayList(String), sink(field_types) : ArrayList(TypeValue), sink(self_constraints) : ArrayList(TypeValue), sink(neg_self_constraints) : ArrayList(TypeValue)) -> TraitTBody(TypeValue)
)(
  Rc.new(
    RefCell(TraitTBodyCell(TypeValue)).new(
      TraitTBodyCell(TypeValue)(
        assoc_type_names : assoc_type_names,
        field_labels : field_labels,
        field_types : field_types,
        self_constraints : self_constraints,
        neg_self_constraints : neg_self_constraints
      )
    )
  )
);
impl(
  TraitTBody(TypeValue),
  /// A snapshot of the associated type names.
  assoc_type_names : (fn(self : &Self) -> ArrayList(String))(self.*.with({ &self }(b) => b.assoc_type_names.clone())),
  /// A snapshot of the member labels.
  field_labels : (fn(self : &Self) -> ArrayList(String))(self.*.with({ &self }(b) => b.field_labels.clone())),
  /// A snapshot of the member types.
  field_types : (fn(self : &Self) -> ArrayList(TypeValue))(self.*.with({ &self }(b) => b.field_types.clone())),
  /// A snapshot of the `where(Self <: X)` constraints.
  self_constraints : (fn(self : &Self) -> ArrayList(TypeValue))(self.*.with({ &self }(b) => b.self_constraints.clone())),
  /// A snapshot of the negative `where(Self <: X)` constraints.
  neg_self_constraints : (fn(self : &Self) -> ArrayList(TypeValue))(self.*.with({ &self }(b) => b.neg_self_constraints.clone())),
  /// A fresh cell holding copies of these lists (a NEW trait identity).
  fresh_copy : (fn(self : &Self) -> Self)(
    self.*.with({ &self }(b) => trait_t_body(b.assoc_type_names.clone(), b.field_labels.clone(), b.field_types.clone(), b.self_constraints.clone(), b.neg_self_constraints.clone()))
  )
);
// ---------------------------------------------------------------------------
// Parameter slots (plans/VALUES_BY_DEFAULT.md decision 43 step 1).
// ---------------------------------------------------------------------------
// A parameter's mode is its slot type: a by-value parameter's slot (`x : T`,
// `sink(x) : T`) is `T`, a `x : &T` slot is `Reference(T, false, o)`, a
// `x : &mut T` slot `Reference(T, true, o)`. A parameter with no mode to
// speak of (a `Type`-valued, `quote` or `generic`/`using` one) borrows, as it
// always has: it is a `&T` slot. Only `Func.param_types` and
// `FnTraitT.call_param_types` hold slots; `forall_types`, `implicit_types`
// and `variadic_types` hold plain types.
(g_origin_elided : TypeValue) = Rc.new(TypeValueNode.OriginSet(places : Rc.clone(g_no_labels), is_elided : true));
/// The origin of a reference written without one. Every origin step 1 builds
/// is this one shared value.
t_origin_elided :: (fn() -> TypeValue)(Rc.clone(g_origin_elided));
/// The `Origin` kind (decision 43 step 2, N1a): what `generic(p : Origin)`
/// annotates, as `TypeUni(0)` is the kind of a type.
(g_origin_kind : TypeValue) = Rc.new(TypeValueNode.OriginKind);
t_origin_kind :: (fn() -> TypeValue)(Rc.clone(g_origin_kind));
/// A spelled origin: the set of `names`, each an origin parameter of the
/// enclosing signature or a reference parameter's place (resolved against
/// that signature by the checker).
t_origin_named :: (fn(names : &SharedList(String)) -> TypeValue)(Rc.new(TypeValueNode.OriginSet(places : names.clone(), is_elided : false)));
/// `&T` (`mutable = false`) or `&mut T`, with the elided origin.
t_reference :: (fn(pointee : &TypeValue, mutable : bool) -> TypeValue)(
  Rc.new(TypeValueNode.Reference(pointee : pointee.clone(), mutable : mutable, origin : Rc.clone(g_origin_elided)))
);
/// `&(T, origin)` / `&mut(T, origin)`: a reference with a spelled origin.
t_reference_with_origin :: (fn(pointee : &TypeValue, mutable : bool, origin : &TypeValue) -> TypeValue)(
  Rc.new(TypeValueNode.Reference(pointee : pointee.clone(), mutable : mutable, origin : origin.clone()))
);
/// The value is the `Origin` kind.
is_origin_kind :: (fn(t : &TypeValue) -> bool)(match(t, Rc(.OriginKind) => true, _ => false));
/// The slot of a parameter with the given mode: `&mut T` when `is_mut_ref`,
/// else `T` when `is_by_value`, else `&T`.
t_slot :: (fn(pointee : &TypeValue, is_mut_ref : bool, is_by_value : bool) -> TypeValue)(
  cond(
    is_mut_ref => t_reference(pointee, true),
    is_by_value => pointee.clone(),
    true => t_reference(pointee, false)
  )
);
/// The value type a slot holds or lends: `T` for `T`, `&T` and `&mut T`.
t_slot_pointee :: (fn(t : &TypeValue) -> TypeValue)(
  match(
    t,
    Rc(.Reference(pointee, _, _)) => Rc.clone(pointee),
    _ => Rc.clone(t)
  )
);
/// The slot is `&mut T`.
t_slot_is_mut_ref :: (fn(t : &TypeValue) -> bool)(match(t, Rc(.Reference(_, mutable, _)) => mutable, _ => false));
/// The slot borrows (`&T` or `&mut T`).
t_slot_is_borrow :: (fn(t : &TypeValue) -> bool)(match(t, Rc(.Reference(_, _, _)) => true, _ => false));
/// The slot takes its argument by value.
t_slot_is_by_value :: (fn(t : &TypeValue) -> bool)(!t_slot_is_borrow(t));
/// `slot` with its pointee replaced by `pointee`: the mode and the origin
/// are kept.
t_slot_with_pointee :: (fn(slot : &TypeValue, pointee : &TypeValue) -> TypeValue)(
  match(
    slot,
    Rc(.Reference(_, mutable, origin)) => Rc.new(TypeValueNode.Reference(pointee : pointee.clone(), mutable : mutable, origin : Rc.clone(origin))),
    _ => pointee.clone()
  )
);
/// The pointee of slot `i` of a parameter-slot list (`.None` past its end):
/// a slot list's `get(i)` for a reader that wants the parameter's value type.
slot_pointee_at :: (fn(slots : &SharedList(TypeValue), i : usize) -> Option(TypeValue))(
  match(slots.get(i), .Some(s) => Option(TypeValue).Some(t_slot_pointee(&s)), .None => Option(TypeValue).None)
);
/// `pointee` in the mode of slot `i` of `slots`: a rebuilt signature that
/// keeps another signature's parameter modes. Past the end of `slots`, the
/// `&T` slot (a parameter with no recorded mode has always borrowed).
t_slot_like :: (fn(slots : &SharedList(TypeValue), i : usize, pointee : &TypeValue) -> TypeValue)(
  match(slots.get(i), .Some(s) => t_slot_with_pointee(&s, pointee), .None => t_reference(pointee, false))
);
/// The pointees of a parameter-slot list: the parameters' value types.
slot_pointees :: (fn(slots : &SharedList(TypeValue)) -> ArrayList(TypeValue))({
  out := ArrayList(TypeValue).new();
  (i : usize) = usize(0);
  while(i < slots.len(), {
    match(slots.get(i), .Some(s) => out.push(t_slot_pointee(&s)), .None => ());
    i = (i + usize(1));
  });
  out
});
/// The parameter slots of a `Func` or `FnTraitT` (empty for anything else).
fn_param_slots :: (fn(ft : &TypeValue) -> SharedList(TypeValue))(
  match(
    ft,
    Rc(.Func({ param_types : fps_pts })) => Rc.clone(fps_pts),
    Rc(.FnTraitT({ call_param_types : fps_cpts })) => Rc.clone(fps_cpts),
    _ => Rc.clone(g_no_types)
  )
);
/// The result slot of a `Func` (decision 43 step 2, N1b): a projection's
/// result (`-> &T` / `-> &mut T`, decision 24) is `Reference(T, mutable,
/// origin)`, every other result the bare `T` — the encoding parameter slots
/// have had since step 1. Unit for a non-`Func`.
fn_result_slot :: (fn(ft : &TypeValue) -> TypeValue)(match(ft, Rc(.Func({ result : frs_r })) => Rc.clone(frs_r), _ => Rc.new(TypeValueNode.Unit)));
/// The value type a `Func` returns or projects: `T` for `-> T`, `-> &T` and
/// `-> &mut T`. Unit for a non-`Func`.
fn_result_pointee :: (fn(ft : &TypeValue) -> TypeValue)(t_slot_pointee(&fn_result_slot(ft)));
/// The rank of a closure trait's base name in decision 37's order: `Fn` (0)
/// implies `FnMut` (1), which implies `FnOnce` (2). A closure whose trait
/// ranks at most the slot's serves it: a borrowing call also serves an
/// exclusive one, and either serves one consuming call. `.None` for a name
/// that is none of the three.
fn_trait_rank :: (fn(base_name : &String) -> Option(u8))(
  cond(
    (base_name == "Fn") => Option(u8).Some(u8(0)),
    (base_name == "FnMut") => Option(u8).Some(u8(1)),
    (base_name == "FnOnce") => Option(u8).Some(u8(2)),
    true => Option(u8).None
  )
);
/// A closure typed `actual` may stand where `expected` is required
/// (decision 37's order, `fn_trait_rank`): the same trait, or a stronger one
/// (`Fn` where `FnMut` or `FnOnce` is required, `FnMut` where `FnOnce` is).
fn_trait_base_serves :: (fn(actual : &String, expected : &String) -> bool)(
  match(
    fn_trait_rank(actual),
    .Some(ar) => match(fn_trait_rank(expected), .Some(er) => (ar <= er), .None => false),
    .None => (actual == expected)
  )
);
/// What a call of a closure typed `base_name` does to it, for E0913's text.
fn_trait_call_contract :: (fn(base_name : &String) -> String)(
  cond(
    (base_name == "FnOnce") => String.from("which is called at most once (its call consumes it)"),
    (base_name == "FnMut") => String.from("whose call borrows it exclusively (its body writes its state or a `&mut` capture)"),
    true => String.from("whose call borrows it")
  )
);
/// What a slot typed `base_name` may do with a closure it receives, for
/// E0913's text.
fn_trait_slot_contract :: (fn(base_name : &String) -> String)(
  cond(
    (base_name == "Fn") => String.from("the closure may be called again, through a shared borrow"),
    true => String.from("the closure may be called again")
  )
);
/// The `Func` (or closure trait, `Fn(...) -> &T`, N1c) `ft` is a
/// projection (`-> &T` or `-> &mut T`).
fn_result_is_ref :: (fn(ft : &TypeValue) -> bool)(match(ft, Rc(.Func({ result : fri_r })) => t_slot_is_borrow(&fri_r), Rc(.FnTraitT({ call_result : fri_cr })) => t_slot_is_borrow(&fri_cr), _ => false));
/// The `Func` (or closure trait) `ft` is a mutable projection (`-> &mut T`).
fn_result_is_mut_ref :: (fn(ft : &TypeValue) -> bool)(match(ft, Rc(.Func({ result : frm_r })) => t_slot_is_mut_ref(&frm_r), Rc(.FnTraitT({ call_result : frm_cr })) => t_slot_is_mut_ref(&frm_cr), _ => false));
/// The names a SPELLED origin lists (`&(T, (p, xs))` → `p`, `xs`); `.None`
/// for an elided origin or a non-origin (decision 43 step 2, N1c).
t_origin_spelled_names :: (fn(o : &TypeValue) -> Option(SharedList(String)))(
  match(o, Rc(.OriginSet(osn_places, osn_elided)) => if(osn_elided, Option(SharedList(String)).None, Option(SharedList(String)).Some(Rc.clone(osn_places))), _ => Option(SharedList(String)).None)
);
/// The names a reference slot's spelled origin lists; `.None` for a
/// by-value slot or an elided origin.
t_slot_origin_names :: (fn(slot : &TypeValue) -> Option(SharedList(String)))(
  match(slot, Rc(.Reference(_, _, tso_origin)) => t_origin_spelled_names(&tso_origin), _ => Option(SharedList(String)).None)
);
/// The names a projection's spelled result origin lists (`-> &(T, xs)`);
/// `.None` for an elided one (O2: the union of the reference parameters) or
/// a non-projection.
fn_result_origin_names :: (fn(ft : &TypeValue) -> Option(SharedList(String)))(t_slot_origin_names(&fn_result_slot(ft)));
/// Collect the origin names spelled inside `t` (an origin argument of a
/// struct or enum instance, a reference's origin, through tuples and nested
/// type arguments) into `out`. False when one of them is elided: an elided
/// origin is the union of the reference parameters (O2), which lists no names.
_spelled_origins_into :: (fn(t : &TypeValue, out : &mut ArrayList(String), depth : usize) -> bool)({
  if(depth > usize(16), {
    return(true);
  });
  match(
    t,
    Rc(.OriginSet(so_places, so_elided)) => {
      if(so_elided, {
        return(false);
      });
      (si : usize) = usize(0);
      while(si < so_places.len(), {
        match(so_places.get(si), .Some(n) => out.push(n), .None => ());
        si = (si + usize(1));
      });
      true
    },
    Rc(.Reference(so_pointee, _, so_origin)) => (_spelled_origins_into(&so_origin, out, depth + usize(1)) && _spelled_origins_into(&so_pointee, out, depth + usize(1))),
    Rc(.Struct({ type_arguments : so_tas })) => _spelled_origins_in_list(&so_tas, out, depth),
    Rc(.EnumT({ type_arguments : so_etas })) => _spelled_origins_in_list(&so_etas, out, depth),
    Rc(.Tuple({ field_types : so_fts })) => _spelled_origins_in_list(&so_fts, out, depth),
    // `Impl(Future(T, E, p))` (decision 43 step 4): the future's origin.
    Rc(.FutureTraitT(origin : so_fo)) => _spelled_origins_into(&so_fo, out, depth + usize(1)),
    Rc(.SomeT({ bounds : so_bnd })) => _spelled_origins_in_list(&shared_list(so_bnd.required()), out, depth),
    _ => true
  )
});
_spelled_origins_in_list :: (fn(ts : &SharedList(TypeValue), out : &mut ArrayList(String), depth : usize) -> bool)({
  (li : usize) = usize(0);
  while(li < ts.len(), {
    if(!match(ts.get(li), .Some(lt) => _spelled_origins_into(&lt, out, depth + usize(1)), .None => true), {
      return(false);
    });
    li = (li + usize(1));
  });
  true
});
/// The origin names a BY-VALUE result spells in its type (decision 43 step
/// 3, N2b's composite results; O3's return rule): `-> V(a)` lists `a`,
/// `-> Option(&(T, p))` lists `p`. `.None` when the result spells no origin
/// or elides one (O2: then it may name every reference parameter).
fn_result_composite_origin_names :: (fn(ft : &TypeValue) -> Option(SharedList(String)))({
  slot := fn_result_slot(ft);
  if(t_slot_is_borrow(&slot), {
    return(Option(SharedList(String)).None);
  });
  names := ArrayList(String).new();
  if(!_spelled_origins_into(&slot, &mut names, usize(0)) || (names.len() == usize(0)), {
    return(Option(SharedList(String)).None);
  });
  Option(SharedList(String)).Some(shared_list(names))
});
/// Whether `names` holds `name`.
origin_names_contain :: (fn(names : &SharedList(String), name : &String) -> bool)({
  (oi : usize) = usize(0);
  while(oi < names.len(), {
    if(match(names.get_cloned(oi), .Some(n) => (n == name), .None => false), {
      return(true);
    });
    oi = (oi + usize(1));
  });
  false
});
/// Parameter `i` of a function whose result origin spells `names` is one the
/// result borrows: its own place is named (`-> &(T, xs)`), or its slot's
/// spelled origin names one of the origin parameters the result lists
/// (`xs : &(T, p)` under `-> &(U, p)`). Decision 43 step 2 (N1c), O3's
/// substitution at a call.
fn_param_in_result_origin :: (fn(ft : &TypeValue, i : usize, names : &SharedList(String)) -> bool)({
  label := match(ft, Rc(.Func({ meta : pro_m })) => match(pro_m.*.param_labels.get_cloned(i), .Some(l) => l, .None => String.new()), _ => String.new());
  if((label.len() > usize(0)) && origin_names_contain(names, &label), {
    return(true);
  });
  match(
    fn_param_slots(ft).get(i),
    .Some(pro_s) => match(
      t_slot_origin_names(&pro_s),
      .Some(pro_on) => {
        (pj : usize) = usize(0);
        while(pj < pro_on.len(), {
          if(match(pro_on.get(pj), .Some(n) => origin_names_contain(names, &n), .None => false), {
            return(true);
          });
          pj = (pj + usize(1));
        });
        false
      },
      // A by-value parameter whose type spells origins (`v : _View(p)`, an
      // N2b holder) points into those places: it is in the result's origin
      // when it names one the result lists (N1e-2, a reference read out of
      // a holder parameter).
      .None => if(t_slot_is_by_value(&pro_s), {
        held := ArrayList(String).new();
        _spelled_origins_into(&pro_s, &mut held, usize(0));
        (hj : usize) = usize(0);
        while(hj < held.len(), {
          if(origin_names_contain(names, &held(hj)), {
            return(true);
          });
          hj = (hj + usize(1));
        });
        false
      }, false)
    ),
    .None => false
  )
});
/// Parameter `i` of `ft` is a reference whose pointee spells an origin the
/// result lists (`self : &mut Cursor(p)` with `-> Option(&mut(T, p))`, O3
/// step 2, N1e-2): the result points where the pointee's references point,
/// not into the parameter's own place.
fn_param_pointee_in_result_origin :: (fn(ft : &TypeValue, i : usize, names : &SharedList(String)) -> bool)({
  pp := match(fn_param_slots(ft).get(i), .Some(Rc(.Reference(pi_pointee, _, _))) => Rc.clone(pi_pointee), _ => return(false));
  held := ArrayList(String).new();
  _spelled_origins_into(&pp, &mut held, usize(0));
  (hj : usize) = usize(0);
  while(hj < held.len(), {
    if(origin_names_contain(names, &held(hj)), {
      return(true);
    });
    hj = (hj + usize(1));
  });
  false
});
/// Parameter `i` of the `Func` / `FnTraitT` `ft` is `&mut T` (false past the
/// last parameter).

fn_param_is_mut_ref :: (fn(ft : &TypeValue, i : usize) -> bool)(
  match(fn_param_slots(ft).get(i), .Some(s) => t_slot_is_mut_ref(&s), .None => false)
);
/// Parameter `i` of the `Func` / `FnTraitT` `ft` is by value (false past the
/// last parameter).
fn_param_is_by_value :: (fn(ft : &TypeValue, i : usize) -> bool)(
  match(fn_param_slots(ft).get(i), .Some(s) => t_slot_is_by_value(&s), .None => false)
);
/// Is parameter `i` of `ft` `&mut T`; `.None` past the last parameter (a mode
/// list's `get(i)`, for readers that keep their own default).
fn_param_mut_ref_at :: (fn(ft : &TypeValue, i : usize) -> Option(bool))(
  match(fn_param_slots(ft).get(i), .Some(s) => Option(bool).Some(t_slot_is_mut_ref(&s)), .None => Option(bool).None)
);
/// Is parameter `i` of `ft` by value; `.None` past the last parameter.
fn_param_by_value_at :: (fn(ft : &TypeValue, i : usize) -> Option(bool))(
  match(fn_param_slots(ft).get(i), .Some(s) => Option(bool).Some(t_slot_is_by_value(&s)), .None => Option(bool).None)
);
/// Per parameter of `ft`: is it `&mut T`. For a reader that threads the
/// modes through helpers as a list (one entry per slot).
fn_param_mut_ref_flags :: (fn(ft : &TypeValue) -> SharedList(bool))({
  out := ArrayList(bool).new();
  slots := fn_param_slots(ft);
  (i : usize) = usize(0);
  while(i < slots.len(), {
    out.push(match(slots.get(i), .Some(s) => t_slot_is_mut_ref(&s), .None => false));
    i = (i + usize(1));
  });
  shared_list(out)
});
/// Per parameter of `ft`: is it by value (one entry per slot).
fn_param_by_value_flags :: (fn(ft : &TypeValue) -> SharedList(bool))({
  out := ArrayList(bool).new();
  slots := fn_param_slots(ft);
  (i : usize) = usize(0);
  while(i < slots.len(), {
    out.push(match(slots.get(i), .Some(s) => t_slot_is_by_value(&s), .None => false));
    i = (i + usize(1));
  });
  shared_list(out)
});
// ---------------------------------------------------------------------------
// Struct per-field compile-time-only flags — side-table (Gap 1).
// ---------------------------------------------------------------------------
/// Side-table: struct id → per-field "is compile-time only" flags, parallel
/// to the `Struct` variant's `field_types`. The `Struct` variant has no
/// per-field flag, so codegen's `get_runtime_struct_fields` reads it from here.
/// Populated at struct construction (`evaluator/types/struct.yo`). Structs
/// with no entry (e.g. reconstructed from runtime values, id == "") are
/// treated as all-runtime by the consumer. See
/// issues/retired/codegen-port-type-model-gaps.md Gap 1.
(g_struct_field_comptime_flags : RefCell(HashMap(String, ArrayList(bool)))) = RefCell(HashMap(String, ArrayList(bool))).new(HashMap(String, ArrayList(bool)).new());
/// Register the per-field compile-time-only flags for a struct id.
register_struct_field_comptime_flags :: (
  fn(struct_id : &String, flags : &ArrayList(bool)) -> unit
)({
  g_struct_field_comptime_flags.with_mut({ &struct_id, &flags }(m) => m.insert(struct_id.clone(), flags.clone()));
  ()
});
/// Get the per-field compile-time-only flags for a struct id (`.None` if the
/// struct was not registered — treat as all-runtime).
get_struct_field_comptime_flags :: (
  fn(struct_id : &String) -> Option(ArrayList(bool))
)(
  g_struct_field_comptime_flags.with({ &struct_id }(m) => m.get_cloned(struct_id.clone()))
);
export(TypeValue, TypeValueNode, FuncMeta, SomeTBounds, SomeTBoundsCell, some_t_bounds, some_t_bounds_empty, TraitTBody, TraitTBodyCell, trait_t_body, SharedList, SharedListCell, SharedListElem, shared_list, no_types, no_labels, no_flags, no_levels, no_discriminants, no_type_lists, no_label_lists, t_refine_inner, register_struct_field_comptime_flags, get_struct_field_comptime_flags);
export(fn_trait_rank, fn_trait_base_serves, fn_trait_call_contract, fn_trait_slot_contract);
export(fn_result_slot, fn_result_pointee, fn_result_is_ref, fn_result_is_mut_ref, t_origin_spelled_names, t_slot_origin_names, fn_result_origin_names, fn_result_composite_origin_names, origin_names_contain, fn_param_in_result_origin, fn_param_pointee_in_result_origin);
export(t_origin_elided, t_origin_kind, t_origin_named, t_reference_with_origin, is_origin_kind, t_reference, t_slot, t_slot_pointee, slot_pointee_at, slot_pointees, t_slot_is_mut_ref, t_slot_is_borrow, t_slot_is_by_value, t_slot_with_pointee, t_slot_like, fn_param_slots, fn_param_is_mut_ref, fn_param_is_by_value, fn_param_mut_ref_at, fn_param_by_value_at, fn_param_mut_ref_flags, fn_param_by_value_flags);
