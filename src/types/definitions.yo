//! TypeValue — the central representation of types in the Yo type system.
//!
//! A Yo `enum` with per-variant data. See `plans/archive/BOOTSTRAPPING.md`
//! § "Architecture Decisions / 2. Type representation".
//!
//! Notes:
//!   * Fixed-width integers are encoded as `Int(bits, signed)`. Pointer-sized
//!     integers (`usize`/`isize`) and C-compatible types (whose width is
//!     platform-dependent) get their own variants.
//!   * Compound variants store children via `Self` to allow recursion.
//!   * Tuple/Struct field types are stored as parallel `ArrayList`s so we
//!     don't need a separate mutually-recursive struct (which would require
//!     a forward-reference dance during evaluation).
//!   * Generic / unresolved type information (`SomeType`, `TypeApplication`,
//!     traits with associated types, …) is intentionally kept
//!     minimal in this iteration — Phase 2b will fill in the details.
//!
//! Phase A.3.3: this file holds the TypeValue enum only. Type constructors
//! (`t_unit`, `t_some_t`, …) and `type_value_tag` live in `creators.yo`.
//! Variant-shape predicates (`is_int_type`, …) live in `guards.yo`.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
/// The payload of a `SharedList`: one list, never written after it is built.
/// It implements no `Clone` of its own, so the only copy of a `SharedList` is
/// the handle's.
SharedListCell :: (fn(comptime(T) : Type) -> comptime(Type))(
  struct(items : ArrayList(T))
);
/// An immutable list shared between every `TypeValue` that holds it: a
/// type's label and type lists (`Struct.field_labels`, `Func.param_types`,
/// `FuncMeta.param_labels`, ...). A copy is one count bump, as for
/// `TypeValue` itself, so reading a list out of a node, or rebuilding a node
/// that keeps one, never copies the list (plans/VALUES_BY_DEFAULT.md V2b's
/// B1 prerequisites: under unique buffers a copy of a plain `ArrayList`
/// field read through the node's `Rc` is a deep copy). Build one with
/// `shared_list(xs)`; read it with `len`/`get`/`is_empty`, or through
/// `xs.items` (`&xs.items` lends the list, `xs.items(i)` indexes it).
/// `Clone` is declared per element type below and in `TypeValue`'s block:
/// the prelude's generic `Rc(T)` clone would copy the payload.
SharedList :: (fn(comptime(T) : Type) -> comptime(Type))(Rc(SharedListCell(T)));
/// Share `items` as a `SharedList`.
shared_list :: (fn(generic(T : Type), sink(items) : ArrayList(T)) -> SharedList(T))(
  rc(SharedListCell(T)(items : items))
);
impl(
  generic(T : Type),
  SharedList(T),
  /// Number of elements.
  len : (fn(self : &Self) -> usize)(self.*.items.len()),
  /// True when the list holds no elements.
  is_empty : (fn(self : &Self) -> bool)(self.*.items.is_empty()),
  /// The element at `i`, or `.None` past the end.
  get : (fn(self : &Self, i : usize) -> Option(T))(self.*.items.get(i))
);
// A `SharedList` copy is one count bump (see `SharedList`). Each list is
// built once and never written (no mutator reaches `items` through the
// read-only `Rc`, decision 46), so a cell points only at older values and
// none reaches itself: `Acyclic` keeps the cells out of the cycle collector.
impl(SharedList(String), Clone(clone : (fn(self : &Self) -> Self)(self)));
impl(SharedList(String), Acyclic());
impl(SharedList(bool), Clone(clone : (fn(self : &Self) -> Self)(self)));
impl(SharedList(bool), Acyclic());
impl(SharedList(usize), Clone(clone : (fn(self : &Self) -> Self)(self)));
impl(SharedList(usize), Acyclic());
impl(SharedList(i64), Clone(clone : (fn(self : &Self) -> Self)(self)));
impl(SharedList(i64), Acyclic());
impl(SharedList(SharedList(String)), Clone(clone : (fn(self : &Self) -> Self)(self)));
impl(SharedList(SharedList(String)), Acyclic());
/// Non-recursive ("meta") fields of a function type, factored out of the
/// `TypeValue.Func` variant and stored behind an `Rc` (P2 memory: the inline
/// Func variant set `sizeof(TypeValue)` to ~150 B — wasted in every small-type
/// inline copy across millions of `Variable.ty` / `ExprInfo` fields). These
/// fields reference only `String`/`bool`/`Option(String)` — NOT `Self` — so the
/// struct can be defined BEFORE `TypeValue` without the forward-reference dance
/// (see the parallel-array note above). The Self-typed Func fields
/// (`*_types`/`result`) stay inline on the variant.
FuncMeta :: struct(
  forall_labels : SharedList(String),
  // generic type-var names (parallel to Func.forall_types)
  param_labels : SharedList(String),
  // normal parameter labels (parallel to Func.param_types)
  implicit_labels : SharedList(String),
  // implicit (`using`) parameter labels (parallel to Func.implicit_types)
  /// True when the declared return is `comptime(...)`. Gates
  /// CTFE; the FuncVal-call delegation + `evaluate_comptime_fn_call`'s
  /// `should_cache` use it to route type-constructor calls through memoization.
  result_is_comptime_only : bool,
  /// Per-parameter `ref` flags (parallel to param labels/types). `name : &mut T`
  /// = by-reference borrow. Used by
  /// `is_flowable_expr` (the `inout(T)`-flow soundness check).
  param_is_ref : SharedList(bool),
  /// Per-parameter `own` flags. `own(name):T` = callee takes ownership of the
  /// Rc value. Used by
  /// `require_ref_own_argument_exclusivity`.
  param_is_owning : SharedList(bool),
  /// True when the return is a borrow, `-> &T` or `-> &mut T`: a projection
  /// (decision 24). It returns `T*` at the C ABI; `result_is_mut_ref` tells
  /// the two modes apart. `is_flowable_expr` requires a flowable return.
  result_is_ref : bool,
  /// True when the param list ends with a `...` variadic marker (C-style
  /// variadic externs). The
  /// call-site arg-count check is skipped when set.
  has_variadic : bool,
  /// FFI language tag (`extern "c"`/`"yo"` / `c_include`). `Some("c")` etc. for
  /// FFI symbols, `None` for ordinary Yo functions. Read by the extern-call
  /// `unsafe(...)` gate in
  /// `calls/function.yo` (a call to an `is_extern == Some("c")` function outside
  /// `unsafe(...)`/an auto-generated expansion is rejected).
  is_extern : Option(String),
  /// The FFI symbol name to bind, when known.
  /// Used only for the gate's diagnostic message.
  extern_name : Option(String),
  /// True for a `ctl(...) -> ret` control-function type.
  /// A `ctl` value is FRAME-BOUND (its body may
  /// `unwind` out of the enclosing install frame) so it must not escape. Read
  /// by `type_is_control_bound` + the §4 escape-boundary checks.
  is_control : bool,
  /// The variadic parameter's BINDING NAME (`...(xs : T)` → "xs"), when the
  /// fn type has one. The
  /// variadic TYPE cannot live here (FuncMeta is declared before TypeValue —
  /// no forward references) — it rides in `Func.variadic_types` (0-or-1);
  /// readers append the variadic param to the param list from both.
  variadic_label : Option(String),
  /// True when the variadic parameter is comptime (`...(xs : ComptimeList)`).
  variadic_comptime : bool,
  /// AST id of the `fn(...)` TYPE EXPRESSION this function type was evaluated
  /// from, when there is one. `is_compile_time_only`, the
  /// per-parameter type exprs and the return-type expr live in func-id-keyed SIDE
  /// TABLES registered under that expression's id
  /// (evaluator/types/function.yo). The `::` path re-keys them onto the FuncVal
  /// id (evaluator/calls/function_type.yo); an ANONYMOUS function checked
  /// against an expected function type mints its own id and had no way to reach
  /// them, so a `comptime(T) : Type` parameter/return was lost. This
  /// field fixes that: it travels with the type through the same
  /// `meta.clone()` an expected-type spread performs. Defaulted so the 20+
  /// existing construction sites are unaffected.
  (origin_id : Option(String)) ?= Option(String).None,
  /// Per-parameter `sink(x)` flags (see `FuncParam.is_sink`): the caller
  /// moves the argument instead of sharing a still implicitly copyable kind.
  /// Caller-side only, so not part of the function type's identity; `.None`
  /// means none is `sink`.
  (param_is_sink : Option(SharedList(bool))) ?= Option(SharedList(bool)).None,
  /// With `result_is_ref`: the result is `-> &mut T` (a mutable projection,
  /// decision 24) rather than `-> &T` (a read projection). Defaulted so a
  /// construction site that drops it degrades to the read projection, which
  /// rejects writes instead of admitting them.
  (result_is_mut_ref : bool) ?= false
);
derive(FuncMeta, Clone);
/// One node of the Yo type universe: the payload behind a `TypeValue` handle.
///
/// `TypeValue` is `Rc(TypeValueNode)` (plans/VALUES_BY_DEFAULT.md decision
/// 21, as built 2026-10-13): every child is an `Rc(Self)` handle, so a node
/// is never copied and a clone is one count bump. Build a type with
/// `rc(TypeValueNode.X(...))`; a `match` on a `TypeValue` looks through the
/// handle, so arms name the variants directly.
TypeValueNode :: enum(
  // Primitive value types ---------------------------------------------------
  Unit,
  BoolT,
  Void,
  /// `never` — the bottom type: the type of an expression that does not
  /// complete (`__yo_panic`, a call to a `-> never` function such as
  /// `std/assert`'s `panic` or `std/process`'s `exit`). It flows into every
  /// type and is the identity of a `cond`/`match` arm join, so a diverging
  /// arm does not constrain the result (plans/TYPE_SYSTEM_SOUNDNESS.md
  /// Phase 3.6). No value of it exists; C lowers it to `void`.
  Never,
  /// `str` — builtin immutable fat-pointer view of STATIC string bytes.
  /// C lowering:
  /// `typedef struct { const uint8_t* ptr; size_t len; } __yo_str;`
  Str,
  /// Fixed-width integer. `bits` ∈ {8, 16, 32, 64}; `signed` distinguishes
  /// `iN` vs `uN`.
  Int(bits : u8, signed : bool),
  /// Floating-point. `bits` ∈ {32, 64}.
  Float(bits : u8),
  /// Pointer-sized unsigned integer.
  Usize,
  /// Pointer-sized signed integer.
  Isize,
  // Compile-time numeric / string types -------------------------------------
  ComptimeInt,
  ComptimeFloat,
  ComptimeString,
  // C-compatible types (platform-dependent width) ---------------------------
  CChar,
  CShort,
  CUShort,
  CInt,
  CUInt,
  CLong,
  CULong,
  CLongLong,
  CULongLong,
  CLongDouble,
  // Type universes ---------------------------------------------------------
  /// `Type`, `Type(1)`, `Type(2)`, …  `level` ∈ {0,1,2,…}.
  TypeUni(level : usize),
  // Compound types ---------------------------------------------------------
  Pointer(pointee : Rc(Self)),
  /// `length_var` carries the VALUE-ness of the declared length:
  /// "" = `length` is the concrete element count; non-empty = the length is
  /// an unresolved generic VARIABLE of that name (e.g. the `U` in
  /// `impl(generic(T : Type, U : usize), Array(T, U), ...)`) and `length`
  /// is a meaningless placeholder; the variable is bound during synthesis.
  Array(element : Rc(Self), length : usize, length_var : String),
  /// Anonymous tuple. `field_labels(i)` is the optional label for the i-th
  /// field (empty `String` means positional). `field_types(i)` is the type.
  Tuple(field_labels : SharedList(String), field_types : SharedList(Rc(Self))),
  /// Function type. Phase 2b: generic type-vars, implicit (using) params,
  /// and where-clause constraint types.
  /// Self-typed (recursive) fields stay inline; the non-recursive metadata
  /// (labels, ref/own/variadic/extern/control flags) lives in `meta`
  /// (`Rc(FuncMeta)`) so this variant no longer sets `sizeof(TypeValue)` to
  /// ~150 B. `forall_types`/`param_types`/`implicit_types`/`where_types` are
  /// parallel to the label arrays in `meta`; `result` is the return type.
  Func(
    forall_types : SharedList(Rc(Self)),
    param_types : SharedList(Rc(Self)),
    implicit_types : SharedList(Rc(Self)),
    where_types : SharedList(Rc(Self)),
    result : Rc(Self),
    meta : Rc(FuncMeta),
    /// The variadic parameter's TYPE (0 or 1 elements — the ArrayList is a
    /// poor man's Option(Self) since Self-typed Options are unavailable in
    /// a variant position).
    /// the label/comptime flags live in `FuncMeta.variadic_label` /
    /// `variadic_comptime` (FuncMeta cannot reference TypeValue).
    variadic_types : SharedList(Rc(Self))
  ),
  // Named user-defined types ------------------------------------------------
  /// `id` uniquely identifies this struct definition.
  /// Set to `""` for types reconstructed
  /// from runtime values via `type_of_eval_value`.
  /// `is_reference_semantics` = true for `object(...)`, false for `struct(...)`.
  /// `is_atomic_rc` = true for `atomic object(...)`.
  /// `is_newtype` = true for `newtype(...)`.
  /// `constructor_func_id` is the func id of the comptime
  /// type-constructor that produced this type (set at the comptime-fn call
  /// site, `evaluator/calls/comptime_fn.yo`). The synthesizer uses
  /// it to unify two instantiations of the SAME generic constructor
  /// (`evaluator/types/synthesizer.yo` compares constructor ids).
  /// `""` = unknown origin.
  /// Only the id is stored, not the whole function value, because
  /// `TypeValue` (this module) cannot import `EvalValue` (`value.yo`) without
  /// a cycle — and the id is the only part the synthesizer reads.
  Struct(
    id : String,
    name : String,
    field_labels : SharedList(String),
    field_types : SharedList(Rc(Self)),
    is_reference_semantics : bool,
    is_atomic_rc : bool,
    is_newtype : bool,
    constructor_func_id : String,
    /// Concrete type arguments of a generic instantiation, in constructor-
    /// parameter order (`HashMap(String, String)` → `[String, String]`). Empty
    /// for non-generic or not-yet-instantiated structs. Stands in for a
    /// carried instantiation env: a method dispatched
    /// on this struct binds its `generic` params positionally from here. See
    /// plans/archive/STRUCT_TYPE_ARGUMENTS.md.
    type_arguments : SharedList(Rc(Self)),
    /// True for source-namespace structs — anonymous modules (`impl({...})`,
    /// extern blocks) and imported modules. There is NO separate module type;
    /// modules ARE structs with this marker. See
    /// plans/archive/MODULE_AS_STRUCT_ALIGNMENT.md.
    is_source_namespace : bool
  ),
  /// `EnumT` rather than `Enum` to avoid clashing with the keyword.
  /// Each variant has a name and an `ArrayList` of field types (possibly empty).
  /// `selected_variant_name` is set when the type has been narrowed to a specific
  /// variant (e.g. after pattern matching or destructuring).
  ///
  /// `variant_field_labels` holds the per-variant label names in declaration
  /// order — used by labeled destructuring and match (Phase 2ae+).
  /// `id` uniquely identifies this enum definition.
  /// `variant_discriminants` holds one discriminant value per variant (in order).
  ///
  /// `is_reference_semantics` = true for `ref(enum(...))`, false for `enum(...)`.
  /// `is_atomic_rc` = true for `atomic(ref(enum(...)))`.
  /// plans/reference/REF_REFERENCE_SEMANTICS.md Phase 3.
  EnumT(
    id : String,
    name : String,
    variant_names : SharedList(String),
    variant_fields : SharedList(SharedList(Rc(Self))),
    selected_variant_name : Option(String),
    variant_field_labels : SharedList(SharedList(String)),
    variant_discriminants : SharedList(i64),
    is_reference_semantics : bool,
    is_atomic_rc : bool,
    /// Type arguments of the generic constructor call that minted this
    /// instantiation, in constructor-parameter order (`P(i32)` -> `[i32]`;
    /// a non-type argument records `Unit`). The enum twin of
    /// `Struct.type_arguments`, stamped at the comptime-fn call site
    /// (`evaluator/calls/comptime_fn.yo`). `substitute` rewrites an argument
    /// that is a type variable, so a phantom `Tag(K)` at `K := i32` reports
    /// `[i32]`; a compound argument (`*(T)`) keeps its definition-era
    /// spelling, and the payloads are what say `*(u8)`. Empty for a
    /// non-generic enum or a copy that predates the stamp. Without it, two
    /// instantiations whose payloads do not mention a parameter (a phantom
    /// index, a GADT index only `-> recur(...)` names) are structurally
    /// identical
    /// (issues/fixed/enum-type-constructor-arguments-are-ignored-by-type-compatibility.md).
    type_arguments : SharedList(Rc(Self))
  ),
  Union(
    name : String,
    field_labels : SharedList(String),
    field_types : SharedList(Rc(Self))
  ),
  // Traits / modules --------------------------------------------------------
  /// Named trait type. Phase 2b: associated type names and method/field list.
  /// Phase 2aq: `id` for unique identity, `is_concrete` for `Concrete(T)` marker.
  /// Phase 2az: `self_constraints` and `neg_self_constraints` for
  /// where-clause / negative where-clause constraints on Self.
  TraitT(
    name : String,
    assoc_type_names : SharedList(String),
    // names of associated type members
    field_labels : SharedList(String),
    // method / field names
    field_types : SharedList(Rc(Self)),
    // method / field types
    id : String,
    // unique identity string
    is_concrete : Option(Rc(Self)),
    // Some(T) when this is `Concrete(T)`
    self_constraints : SharedList(Rc(Self)),
    // where-clause constraints on Self
    neg_self_constraints : SharedList(Rc(Self)),
    // negative where-clause constraints on Self
    assoc_constraint_labels : SharedList(String),
    // labels of `Item := X` associated-type constraints
    assoc_constraint_types : SharedList(Rc(Self)) // constraint types
  ),
  // Generic / unresolved ----------------------------------------------------
  /// A `SomeType` introduced by `generic` or by a yet-to-be-resolved generic
  /// parameter. `frame_level` is the env frame at which it was introduced.
  /// Phase 2b: required and negative trait constraint lists.
  /// Phase 2d: `id` for unique identity.
  /// Phase 2e: `parent_type` — the meta-type of this type variable (usually TypeUni(0)).
  SomeT(
    id : String,
    // unique identity string
    name : String,
    frame_level : usize,
    parent_type : Rc(Self),
    // meta-type (TypeUni(0) by default)
    required_trait_types : SharedList(Rc(Self)),
    // required trait constraints
    required_trait_levels : SharedList(usize),
    // frame-level of each constraint
    negative_trait_types : SharedList(Rc(Self)),
    // negative trait constraints
    negative_trait_levels : SharedList(usize),
    // frame-level of each negative constraint
    // When present, this SomeT represents a higher-kinded type variable
    // (e.g. `F : (fn(T : Type) -> Type)`). The boxed `Func` TypeValue
    // captures the kind so `F(A)` can be evaluated as a TypeApplication.
    kind_function_type : Option(Rc(Self)),
    // The concrete type this SomeType stands for, when it is known where the
    // SomeT is built: an opaque `Impl(...)` return's hidden type, a closure
    // wrapper's capture struct, a call's per-call resolution
    // (`_with_resolved_concrete`). An immutable VALUE: a copy carries it,
    // and nothing writes it after construction, so two SomeTs never share a
    // resolution they could change under each other (plans/
    // TYPE_SYSTEM_SOUNDNESS.md Phase 3.7; until then this was a one-element
    // ArrayList used as a shared mutable cell). A resolution learned later
    // builds a new SomeT carrying it. EXCLUDED from type_key and
    // compatibility identity except where they hop to it explicitly; the
    // intern key renders it, so two SomeTs that differ only here stay two
    // instances.
    resolution : Option(Rc(Self))
  ),
  // Phase 2f: advanced type variants ----------------------------------------
  /// The Yo `Expr` type (a quoted expression node).
  ExprT,
  /// A compile-time homogeneous list. `child` is the element type.
  ComptimeListT(child : Rc(Self)),
  /// Application of a generic type constructor to arguments.
  /// `constructor` is always a `SomeT` (the type-constructor variable).
  TypeAppT(
    constructor : Rc(Self),
    args : SharedList(Rc(Self))
  ),
  /// Iso-wrapped type (linear / unique reference).
  IsoT(child : Rc(Self)),
  /// Dynamic-dispatch type with trait bounds.
  DynT(
    required_trait_types : SharedList(Rc(Self)),
    required_trait_levels : SharedList(usize),
    negative_trait_types : SharedList(Rc(Self)),
    negative_trait_levels : SharedList(usize)
  ),
  /// Fn-trait type (Fn / FnMut / FnOnce).
  FnTraitT(
    base_name : String,
    call_param_labels : SharedList(String),
    call_param_types : SharedList(Rc(Self)),
    call_result : Rc(Self),
    implicit_labels : SharedList(String),
    implicit_types : SharedList(Rc(Self)),
    /// Per-call-param `inout` flags, parallel to `call_param_labels`. The
    /// call signature is FLATTENED into the variant, and dropping this
    /// flag made a closure typed against
    /// `Impl(Fn(v : &mut T) -> R)` bind `v` BY VALUE (the sync/mutex
    /// `with_lock` write-through failure). Empty = all by-value.
    call_param_is_ref : SharedList(bool),
    /// Per-call-param BY-VALUE flags (V3b's flip, decision 30): a plain
    /// `Fn(x : T)` parameter is by value, `Fn(x : &T)` borrows, like a
    /// `fn` type's `param_is_owning`. Empty = none by value (a closure type
    /// synthesized without a written `Fn(...)`).
    call_param_is_owning : SharedList(bool)
  ),
  /// Future-trait type with associated output and effects.
  FutureTraitT(
    base_name : String,
    output : Rc(Self),
    effect_labels : SharedList(String),
    effect_types : SharedList(Rc(Self))
  ),
  /// V6 task 3 (FORMAL_VERIFICATION.md §7): `refine(T, p)` — "a `T` that
  /// satisfies `p`". Distinct at the type level (two predicates over the
  /// same `T` are different types), ERASED to `T` at every runtime
  /// surface: the guard predicates and `type_value_tag` unwrap to
  /// `inner`, variable bindings store `inner` (env.yo), and codegen
  /// therefore emits `T`'s representation unchanged (zero runtime cost —
  /// the plan's erasure rule). The predicate is a ghost_fn VALUE carried
  /// by its `func_id` (TypeValue cannot import EvalValue — the
  /// `Struct.constructor_func_id` precedent); the verifier resolves the
  /// body through the ghost-fn def registry (contracts.yo) and discharges
  /// it: ASSUMED for a refined parameter at the callee entry, PROVED
  /// (`refine#N`) for an argument at a call site. `""` = no predicate
  /// (a pure alias — no obligation).
  RefineT(
    inner : Rc(Self),
    predicate_func_id : String
  ),
  /// An opaque C type declared by `extern("Yo", X : Type)` or a `c_include`
  /// `X : Type`: a concrete type whose layout only the C compiler knows. It
  /// is NOMINAL: two are the same type exactly when they lower to the same
  /// C spelling (`c_name`, e.g. `struct stat` for `stat_buf :
  /// c_type("struct stat")`); it is never a type variable and satisfies no
  /// bound it was not given (plans/reference/TYPE_IDENTITY.md). `name` is
  /// the Yo label, for diagnostics. It used to be a SomeT recorded in a
  /// name registry, which made it unify with every `Dyn` and made any SomeT
  /// that happened to share its name extern
  /// (issues/fixed/an-extern-opaque-type-unifies-with-every-dyn.md).
  ExternOpaqueT(
    name : String,
    c_name : String
  )
);
/// The Yo type universe: a shared, immutable handle to a `TypeValueNode`.
TypeValue :: Rc(TypeValueNode);
/// V6 task 3: unwrap ONE refinement wrapper — `refine(T, p)` reads as `T`
/// for every runtime surface (the erasure rule). Lives HERE (not in
/// guards.yo) because guards.yo imports creators.yo, whose
/// `type_value_tag` needs the unwrap — the import direction forbids the
/// reverse. Not recursive by itself; a guard on a nested
/// `refine(refine(i32, p), q)` unwraps one level per match, which is
/// enough for every integer/bool surface.
t_refine_inner :: (fn(t : &TypeValue) -> TypeValue)(
  match(
    t,
    Rc(.RefineT(inner, _)) => inner,
    _ => t
  )
);

// `TypeValue.clone()` is one count bump: it returns the handle, sharing the
// whole node. A `TypeValue` is rebuilt, never mutated (`substitute` and every
// other consumer construct FRESH nodes; a codebase-wide audit found no
// in-place write to a node's fields), so sharing is sound, and the
// self-compile calls this millions of times (ExprInfo / `Variable.ty`).
// The prelude's `Rc(T)` clone (for a `T <: Clone`) would copy the payload
// into a new cell; `TypeValueNode` does not implement `Clone`, so this impl
// is the only one (plans/backlog/TYPEVALUE_HASH_CONSING.md §5).
impl(
  TypeValue,
  Clone(
    clone : (fn(self : &Self) -> Self)(self)
  )
);
// SAFETY: a TypeValue is rebuilt, never mutated (the audit above): its
// children are filled when it is built and never written afterwards, so a
// node only points at nodes older than itself and none reaches itself;
// recursive types recur through ids and the self shell, not through pointers
// (plans/VALUES_BY_DEFAULT.md decision 21). Declaring `Acyclic` keeps every
// TypeValue node, and every `ArrayList(TypeValue)`, out of the cycle
// collector (§3.12, V4).
impl(TypeValue, Acyclic());
// The type lists inside a node: a copy is one count bump, and they are
// acyclic for the reason `TypeValue` is (see `SharedList`).
impl(SharedList(TypeValue), Clone(clone : (fn(self : &Self) -> Self)(self)));
impl(SharedList(TypeValue), Acyclic());
impl(SharedList(SharedList(TypeValue)), Clone(clone : (fn(self : &Self) -> Self)(self)));
impl(SharedList(SharedList(TypeValue)), Acyclic());
// ---------------------------------------------------------------------------
// Struct per-field compile-time-only flags — side-table (Gap 1).
// ---------------------------------------------------------------------------
/// Side-table: struct id → per-field "is compile-time only" flags, parallel
/// to the `Struct` variant's `field_types`. The `Struct` variant has no
/// per-field flag, so codegen's `get_runtime_struct_fields` reads it from here.
/// Populated at struct construction (`evaluator/types/struct.yo`). Structs
/// with no entry (e.g. reconstructed from runtime values, id == "") are
/// treated as all-runtime by the consumer. See
/// issues/retired/codegen-port-type-model-gaps.md Gap 1.
(g_struct_field_comptime_flags : HashMap(String, ArrayList(bool))) =
  HashMap(String, ArrayList(bool)).new();
/// Register the per-field compile-time-only flags for a struct id.
register_struct_field_comptime_flags :: (
  fn(struct_id : &String, flags : &ArrayList(bool)) -> unit
)({
  g_struct_field_comptime_flags.insert(struct_id.clone(), flags);
  ()
});
/// Get the per-field compile-time-only flags for a struct id (`.None` if the
/// struct was not registered — treat as all-runtime).
get_struct_field_comptime_flags :: (
  fn(struct_id : &String) -> Option(ArrayList(bool))
)(
  g_struct_field_comptime_flags.get(struct_id.clone())
);
export(TypeValue, TypeValueNode, FuncMeta, SharedList, SharedListCell, shared_list, t_refine_inner, register_struct_field_comptime_flags, get_struct_field_comptime_flags);
