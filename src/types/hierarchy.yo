//! Type-universe (meta-type) helpers.
//!
//! Provides:
//!   - `type_of_type(ty)` — get the meta-type (type universe) of a type value.
//!
//! Design notes:
//!   * `_determine_type_universe` and `_universe_of` are mutually
//!     recursive. To avoid a forward-reference in Yo, we use the same function-
//!     pointer pattern as `eval.yo` (g_type_of_type_visited_fn).
//!   * Cycle detection uses a `visited_names` list (struct/enum/union names on
//!     the current recursion stack), keyed by name identity instead of
//!     reference identity.
//!   * Variants without a dedicated arm (Dyn, Expr, Iso, EffectsRow,
//!     ComptimeList, ...) fall through to the wildcard arm and return
//!     `TypeUni(0)` as a safe fallback.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TypeValue } :: import("./definitions.yo");
// ---------------------------------------------------------------------------
// Forward reference slot for _universe_of
// (needed by _determine_type_universe which is defined before the function)
// ---------------------------------------------------------------------------
(g_type_of_type_visited_fn : Option((fn(ty : TypeValue, visited : ArrayList(String)) -> TypeValue))) = .None;
// ---------------------------------------------------------------------------
// Internal helpers
// ---------------------------------------------------------------------------
/// Return true if `name` already appears in `visited`.
_name_in_visited :: (fn(visited : ArrayList(String), name : String) -> bool)({
  result := false;
  i := usize(0);
  while(i < visited.len(), {
    elem := match(visited.get(i), .Some(s) => s, .None => String.from(""));
    cond(
      (elem == name) => {
        result = true;
      },
      true => ()
    );
    i = (i + usize(1));
  });
  result
});
/// Return the larger of two `usize` values.
_max_usize :: (fn(a : usize, b : usize) -> usize)(
  cond(
    (a >= b) => a,
    true => b
  )
);
// ---------------------------------------------------------------------------
// _determine_type_universe
//   Iterates `field_types`, recursively calling `_universe_of`
//   via the function pointer, and returns the maximum TypeUni level found.
// ---------------------------------------------------------------------------
_determine_type_universe :: (
  fn(
    field_types : ArrayList(TypeValue),
    visited_names : ArrayList(String)
  ) -> TypeValue
)({
  max_level := usize(0);
  i := usize(0);
  while(i < field_types.len(), {
    field := match(field_types.get(i), .Some(t) => t, .None => TypeValue.Unit);
    subtype := match(
      g_type_of_type_visited_fn,
      .Some(f) => f(field, visited_names),
      .None => TypeValue.TypeUni(usize(0))
    );
    sub_level := match(
      subtype,
      .TypeUni(lvl) => lvl,
      _ => usize(0)
    );
    max_level = _max_usize(max_level, sub_level);
    i = (i + usize(1));
  });
  TypeValue.TypeUni(max_level)
});
// ---------------------------------------------------------------------------
// _universe_of — the recursive core
// ---------------------------------------------------------------------------
/// One memoized named aggregate: the type object walked and its universe.
_UniverseMemoEntry :: struct(ty : TypeValue, universe : TypeValue);
/// The memo of the current top-level walk, bucketed by `struct:<id>` /
/// `enum:<id>`. A hit requires the SAME type object, not just the same id:
/// substitution and SomeT resolution rebuild a struct under its id with
/// different field types (`src/types/substitution.yo`,
/// `evaluator/calls/helper.yo`), and those copies can have different
/// universes. Nothing mutates a type object during one walk, so an identity
/// hit is exact.
(g_universe_memo : HashMap(String, ArrayList(_UniverseMemoEntry))) = HashMap(String, ArrayList(_UniverseMemoEntry)).new();
/// Set when the name-cycle guard answered for a type on the current path:
/// a result computed under it depends on that path, so it is not memoized.
(g_universe_guard_fired : bool) = false;
_universe_memo_lookup :: (fn(key : String, ty : TypeValue) -> Option(TypeValue))({
  bucket := match(g_universe_memo.get(key), .Some(b) => b, .None => return(Option(TypeValue).None));
  (i : usize) = usize(0);
  while(i < bucket.len(), {
    match(
      bucket.get(i),
      .Some(e) => if(__yo_ptr_eq(e.ty, ty), {
        return(Option(TypeValue).Some(e.universe));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  Option(TypeValue).None
});
/// Walk a named aggregate's fields with `name` pushed on the path, and
/// memoize the result unless the cycle guard fired inside this walk. The
/// guard flag is tracked per entry (saved, cleared, OR-ed back), so a cycle
/// elsewhere in the walk does not stop unrelated entries from being memoized.
_universe_memo_compute :: (
  fn(key : String, ty : TypeValue, name : String, fields : ArrayList(TypeValue), visited : ArrayList(String)) -> TypeValue
)({
  outer_fired := g_universe_guard_fired;
  g_universe_guard_fired = false;
  new_visited := visited.clone();
  new_visited.push(name);
  r := _determine_type_universe(fields, new_visited);
  if(!g_universe_guard_fired, {
    bucket := match(g_universe_memo.get(key.clone()), .Some(b) => b, .None => ArrayList(_UniverseMemoEntry).new());
    bucket.push(_UniverseMemoEntry(ty : ty, universe : r));
    _ := g_universe_memo.insert(key, bucket);
  });
  g_universe_guard_fired = (g_universe_guard_fired || outer_fired);
  r
});
/// The recursive universe walk. Within one top-level `type_of_type` call,
/// every struct and enum is memoized (see `g_universe_memo`), so a struct
/// DAG (`S(i) :: struct(a : S(i-1), b : S(i-1))`) is walked once per
/// distinct type instead of once per path through its 2^depth leaf tree
/// (issues/fixed/defining-a-deep-struct-dag-is-exponential.md). Unions carry
/// no id and are walked per path.
_universe_of :: (fn(ty : TypeValue, visited : ArrayList(String)) -> TypeValue)(
  match(
    ty,
    // Primitives -------------------------------------------------------------
    .Unit => TypeValue.TypeUni(usize(0)),
    .BoolT => TypeValue.TypeUni(usize(0)),
    .Void => TypeValue.TypeUni(usize(0)),
    .Int(_, _) => TypeValue.TypeUni(usize(0)),
    .Float(_) => TypeValue.TypeUni(usize(0)),
    .Usize => TypeValue.TypeUni(usize(0)),
    .Isize => TypeValue.TypeUni(usize(0)),
    .Str => TypeValue.TypeUni(usize(0)),
    .ComptimeInt => TypeValue.TypeUni(usize(0)),
    .ComptimeFloat => TypeValue.TypeUni(usize(0)),
    .ComptimeString => TypeValue.TypeUni(usize(0)),
    .CChar => TypeValue.TypeUni(usize(0)),
    .CShort => TypeValue.TypeUni(usize(0)),
    .CUShort => TypeValue.TypeUni(usize(0)),
    .CInt => TypeValue.TypeUni(usize(0)),
    .CUInt => TypeValue.TypeUni(usize(0)),
    .CLong => TypeValue.TypeUni(usize(0)),
    .CULong => TypeValue.TypeUni(usize(0)),
    .CLongLong => TypeValue.TypeUni(usize(0)),
    .CULongLong => TypeValue.TypeUni(usize(0)),
    .CLongDouble => TypeValue.TypeUni(usize(0)),
    // Type universes: TypeUni(n) → TypeUni(n+1) -----------------------------
    .TypeUni(lvl) => TypeValue.TypeUni(lvl + usize(1)),
    // Pointer: raw pointers are level-0 types --------------------------------
    .Pointer(_) => TypeValue.TypeUni(usize(0)),
    // Array: recurse into element type --------------------------------------
    .Array(elem_box, _, _) => match(
      g_type_of_type_visited_fn,
      .Some(f) => f(elem_box, visited),
      .None => TypeValue.TypeUni(usize(0))
    ),
    // Tuple: check all field types ------------------------------------------
    .Tuple(_, ftypes) => _determine_type_universe(ftypes, visited),
    // Function types: all functions are level-0 types -----------------------
    .Func({ result : _ }) => TypeValue.TypeUni(usize(0)),
    // Struct: recurse into fields, guard against cycles by name.
    // Source-namespace structs (anonymous modules / imports) are
    // type-level-1, like traits (modules ARE structs; the namespace
    // itself is a comptime entity).
    .Struct({ id : sid, name : sname, field_types : ftypes, is_source_namespace : s_sns }) =>
      cond(
        s_sns => TypeValue.TypeUni(usize(1)),
        _name_in_visited(visited, sname) => {
          g_universe_guard_fired = true;
          TypeValue.TypeUni(usize(0))
        },
        true => {
          mk := `struct:${sid}`;
          match(
            _universe_memo_lookup(mk.clone(), ty),
            .Some(hit) => hit,
            .None => _universe_memo_compute(mk, ty, sname.clone(), ftypes, visited)
          )
        }
      ),
    // EnumT: flatten all variant field types, then check the universe ------
    .EnumT(eid, ename, _, variant_fields, _, _, _, _, _) =>
      cond(
        _name_in_visited(visited, ename) => {
          g_universe_guard_fired = true;
          TypeValue.TypeUni(usize(0))
        },
        true => {
          mk2 := `enum:${eid}`;
          match(
            _universe_memo_lookup(mk2.clone(), ty),
            .Some(hit2) => hit2,
            .None => {
              all_fields := ArrayList(TypeValue).new();
              vi := usize(0);
              while(vi < variant_fields.len(), {
                vfields := match(variant_fields.get(vi), .Some(vf) => vf, .None => ArrayList(TypeValue).new());
                fi := usize(0);
                while(fi < vfields.len(), {
                  ft := match(vfields.get(fi), .Some(t) => t, .None => TypeValue.Unit);
                  all_fields.push(ft);
                  fi = (fi + usize(1));
                });
                vi = (vi + usize(1));
              });
              _universe_memo_compute(mk2, ty, ename.clone(), all_fields, visited)
            }
          )
        }
      ),
    // Union: same as Struct -------------------------------------------------
    // A union carries no id (name, labels, fields), and two modules may
    // define same-named unions, so unions are not memoized.
    .Union(uname, _, ftypes) =>
      cond(
        _name_in_visited(visited, uname) => {
          g_universe_guard_fired = true;
          TypeValue.TypeUni(usize(0))
        },
        true => {
          new_visited := visited.clone();
          new_visited.push(uname.clone());
          _determine_type_universe(ftypes, new_visited)
        }
      ),
    // Traits and modules are type-level-1 types ----------------------------
    .TraitT(_, _, _, _, _, _, _, _, _, _) => TypeValue.TypeUni(usize(1)),
    .FnTraitT(base_name : _) => TypeValue.TypeUni(usize(1)),
    .FutureTraitT(base_name : _) => TypeValue.TypeUni(usize(1)),
    // SomeT: return its parent_type (meta-type) ----------------------------
    .SomeT(parent_type : pt) => pt,
    // Remaining Phase 2f variants that live at type level 0 ---------------
    _ => TypeValue.TypeUni(usize(0))
  )
);
// Set the function pointer after _universe_of is defined.
// Assigned at module top level (not inside an IIFE): a module-level global
// is reassignable, but a closure-CAPTURED copy of it is not, so reassigning
// from inside an `(fn() -> ...)({ ... })()` wrapper is rejected. The direct
// top-level assignment reassigns the real global.
g_type_of_type_visited_fn =
  Option((fn(ty : TypeValue, visited : ArrayList(String)) -> TypeValue)).Some(
    _universe_of
  );
// ---------------------------------------------------------------------------
// Public entry point
// ---------------------------------------------------------------------------
/// Get the meta-type (type universe) of any `TypeValue`.
///
type_of_type :: (fn(ty : TypeValue) -> TypeValue)({
  g_universe_memo.clear();
  g_universe_guard_fired = false;
  _universe_of(ty, ArrayList(String).new())
});
export(type_of_type);
