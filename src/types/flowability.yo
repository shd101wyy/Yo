//! Flowability check for `inout(T)`-yielding expressions.
//!
//! Implements the structural soundness
//! rule from `plans/archive/ITERATOR_REDESIGN.md`: an expression is "flowable" iff it
//! roots back to a `ref`-bound parameter (or another `ref`-bound local with a
//! flowable initializer) along a projection-respecting chain.
//!
//! Rules (numbered to match the plan):
//!   R1.  A name reference is flowable iff its binding `is_ref`.
//!   R2.  `expr.field` is flowable iff `expr` is flowable.
//!   R3.  `expr(args)` is flowable iff the callee's return slot is `inout(T)`
//!        AND every `ref`-typed argument it receives is itself flowable.
//!   R4.  `cond` / `match` arms each return-flow independently.
//!
//! Representation notes:
//!   * The evaluated `ExprInfo` is looked up in
//!     `ctx.expr_info_table` by expr id, so this takes an `EvalContext`.
//!   * The callee `FuncVal` carries no type; the callee expr's `ExprInfo.ty`
//!     holds the `Func` type in both the direct-call and method-call cases,
//!     so we read that.
//!   * Options are passed as a `FlowOptions` object.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_text,
  ast_expr_id,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  BK_BEGIN,
  BK_TUPLE,
  BF_DOT,
  BF_PANIC,
  BF_UNSAFE,
  make_err_expr,
  ast_expr_to_string
} :: import("../expr.yo");
{ ExprInfo, expr_info_table_get, has_any_control_flow, lookup_method_callee_type, expr_info_closure_function_value }
:: import("../expr_info.yo");
{ Variable, Environment, get_variables_from_env, snapshot_env } :: import("../env.yo");
{ format_error_message, error_message_text, YoError } :: import("../error.yo");
{ Exception, AnyError } :: import("std/error");
{ is_type_val } :: import("../value.yo");
{ EvalContext } :: import("../evaluator/context.yo");
{ TypeValue, TypeValueNode, no_types, no_flags, t_refine_inner, slot_pointee_at, fn_param_mut_ref_flags } :: import("./definitions.yo");
{ is_function_type, is_pointer_type, is_counted_handle_type, unique_box_payload_type } :: import("./guards.yo");
{ resolve_enum_shell, resolve_struct_shell } :: import("./creators.yo");
{ type_key } :: import("./type_key.yo");
{ HashSet } :: import("std/collections/hash_set");
{ type_to_string } :: import("./string.yo");
{ eprintln } :: import("std/fmt");
{ expr_info_adopt_env, expr_info_capture_type, expr_info_index_trait_ptr_type, expr_info_is_anonymous_function_definition } :: import("../expr_info.yo");
{ RefCell } :: import("std/sync/refcell");
{ type_may_provide_slice_source, type_representation_contains_raw_ptr, type_contains_rc_type, type_requires_explicit_copy, type_is_bitwise_copy, collect_type_borrows, CaptureBorrow, is_future_value_type }
:: import("./utils.yo");
/// A 1-element mutable box holding the error thrown during a swallowed
/// def-time body eval when it is a deliberate REJECTION (a flow-soundness
/// `name := &mut …` non-flowable RHS, an argument that does not fit its
/// parameter, …), not an unported-feature eval error.
/// `_trial_eval_fn_body`'s handler cannot capture the real outer `exn` (effect
/// handlers are capture-free `->` functions), so instead: the raise site flags
/// the error before throwing it; the throw is swallowed as usual; then the
/// def-time CALLER re-raises the SAME error via the real `exn` after the trial
/// eval returns. The box holds the whole `YoError`, so the re-raise keeps the
/// raise site's span, code and notes (it used to hold only the message, and
/// the re-raise anchored every such error on the enclosing function's body).
/// An `ArrayList` mutated only inside the top-level `flag_/clear_` fns is used
/// rather than a reassignable global, because this very source forbids
/// reassigning a module-level global from inside a closure.
(g_flow_violation_box : RefCell(ArrayList(YoError))) = RefCell(ArrayList(YoError)).new(ArrayList(YoError).new());
/// Record `err` as a rejection for the def-time re-raise (unguarded: the
/// caller decides; `raise_flow_violation` is the guarded flag-and-throw).
flag_flow_violation :: (fn(err : &YoError) -> unit)({
  g_flow_violation_box.with_mut(xs => xs.clear());
  g_flow_violation_box.with_mut(xs => xs.push(err));
  ()
});
/// Reset the flag (called before each def-time body eval and after each catch).
clear_flow_violation :: (fn() -> unit)({
  g_flow_violation_box.with_mut(xs => xs.clear());
  ()
});
/// True iff a rejection was flagged since the last reset.
flow_violation_pending :: (fn() -> bool)(g_flow_violation_box.with(xs => xs.len()) > usize(0));
/// The flagged rejection, for the def-time caller to re-raise.
flow_violation_error :: (fn() -> Option(YoError))(g_flow_violation_box.with(xs => xs.get(usize(0))));
/// "Propagate all def-time body-eval errors" mode. Normally `_trial_eval_fn_body`
/// SWALLOWS any error thrown while evaluating a function body at definition time
/// (the def-eval wall: it masks def-time body-eval errors so
/// `check` stays green). But `comptime_expect_error(expr)` must OBSERVE such an
/// error.
/// While this flag is set (only around a `comptime_expect_error` argument eval),
/// the def-time caller re-raises a swallowed body error via the real `exn` so it
/// reaches the `comptime_expect_error` catch. The flag is a global box (not a
/// ctx field) for the same reason as `g_flow_violation_box`: it must survive the
/// child-context construction at each call frame, and the language forbids
/// reassigning a module-level global from inside a closure. comptime_expect_error sets it
/// false again deterministically (the eval's local-unwinding exn returns control
/// to the caller, which clears it), so no non-expect-error path is affected.
(g_propagate_def_time_errors_box : RefCell(ArrayList(bool))) = RefCell(ArrayList(bool)).new(ArrayList(bool).new());
/// Enter/leave "propagate all def-time body-eval errors" mode.
set_propagate_def_time_errors :: (fn(on : bool) -> unit)({
  g_propagate_def_time_errors_box.with_mut(xs => xs.clear());
  g_propagate_def_time_errors_box.with_mut(xs => xs.push(on));
  ()
});
/// True iff def-time body-eval errors should propagate (set during a
/// `comptime_expect_error` argument eval).
/// comptime_expect_error OBSERVATION channel: the non-raw eval wrapper
/// (_evaluate_expression_wrapper) has NO outer exn and SWALLOWS throws; a
/// validation raised beneath it during a cee's propagate-mode clone eval
/// (e.g. the regular-fn-no-outer-capture check) therefore never reached the
/// cee's local exn — cee then wrongly threw "Expected compile error..."
/// through the OUTER exn, abandoning the enclosing begin. The wrapper sets
/// this flag instead (only in propagate mode); the cee helper counts a set
/// flag as an observed throw.
(g_cee_observed_error_box : RefCell(ArrayList(bool))) = RefCell(ArrayList(bool)).new(ArrayList(bool).new());
/// The TEXT of each error observed while a `comptime_expect_error` argument is
/// evaluated, so its expected-text argument can be checked against what was
/// actually raised (a case must not go green on an unrelated error).
(g_cee_observed_messages : RefCell(ArrayList(String))) = RefCell(ArrayList(String)).new(ArrayList(String).new());
set_cee_observed_error :: (fn() -> unit)({
  g_cee_observed_error_box.with_mut(xs => xs.clear());
  g_cee_observed_error_box.with_mut(xs => xs.push(true));
});
clear_cee_observed_error :: (fn() -> unit)({
  g_cee_observed_error_box.with_mut(xs => xs.clear());
  g_cee_observed_messages.with_mut(xs => xs.clear());
});
record_cee_error_message :: (fn(msg : &String) -> unit)({
  g_cee_observed_messages.with_mut(xs => xs.push(msg.clone()));
});
cee_observed_messages :: (fn() -> ArrayList(String))(g_cee_observed_messages.with(xs => xs.clone()));
cee_observed_error :: (fn() -> bool)(
  match(g_cee_observed_error_box.with(xs => xs.get(usize(0))), .Some(b) => b, .None => false)
);
propagate_def_time_errors :: (fn() -> bool)(
  match(g_propagate_def_time_errors_box.with(xs => xs.get(usize(0))), .Some(v) => v, .None => false)
);
/// Throw `err`, a deliberate user-facing rejection, flagging it first so a
/// definition-time swallow re-raises it at `check` time. Not flagged during
/// an overload trial (`is_in_function_call_checking_phase`: rejection is HOW
/// candidates are filtered), in `comptime_expect_error` propagate mode (the
/// throw itself reaches that catch), or when an earlier rejection is pending
/// (the first one is the one to report).
raise_flow_violation :: (fn(err : &YoError, ctx : &EvalContext, exn : Exception) -> unit)({
  if(!ctx.is_in_function_call_checking_phase && !propagate_def_time_errors() && !flow_violation_pending(), {
    flag_flow_violation(err);
  });
  exn.throw(dyn(err));
});
/// Re-raise `err`, the rejection a definition-time trial swallowed, from that
/// trial's caller: clear the flag the trial left, then raise it again through
/// `raise_flow_violation`, which flags it anew.
///
/// Re-flagging is what carries the error through an ENCLOSING trial. A
/// definition can sit inside another definition's trial (an exception handler
/// inside an `io.async` closure body): the re-raise then lands in that outer
/// trial's swallow, and only the flag reaches the outer caller's own re-raise.
/// Clearing without re-flagging lost it there, so an `unwind` type mismatch in
/// a handler inside an `io.async` body passed `yo check`
/// (issues/fixed/unwind-type-mismatch-in-an-io-async-body-handler-is-swallowed.md).
reraise_flow_violation :: (fn(err : &YoError, ctx : &EvalContext, exn : Exception) -> unit)({
  clear_flow_violation();
  raise_flow_violation(err, ctx, exn);
});
/// Options refining the base R1–R4 rule.
FlowOptions :: ref(
  struct(
    /// Accept a same-frame (non-module) local (the assignment-target checks).
    /// Bounded by `max_local_frame_level` when that is `.Some`. (`inout(name)
    /// = …` bindings do not use this rule: their place shape is validated in
    /// `_evaluate_inout_local_binding`, evaluator/exprs/initialization_assignment.yo.)
    allow_same_frame_local : bool,
    /// Accept a parameter of the enclosing function (slice-flowability).
    allow_parameter_source : bool,
    /// Accept a `comptime`-bound name / string-ish literal (slice-flowability).
    allow_comptime_source : bool,
    /// Scope bound for `allow_same_frame_local` (the assignment target's frame
    /// level); a same-frame local is accepted only if its level is no deeper.
    max_local_frame_level : Option(usize)
  )
);
/// Default options (strict R1–R4, the function-return enforcement form).
flow_options_default :: (fn() -> FlowOptions)(
  FlowOptions(
    allow_same_frame_local : false,
    allow_parameter_source : false,
    allow_comptime_source : false,
    max_local_frame_level : Option(usize).None
  )
);
/// Strip outer `begin(...)` wrapper(s) — single-expression bodies after
/// evaluation often appear as `begin((expr))`.
_unwrap_begin_blocks :: (fn(expr : &AstExpr) -> AstExpr)({
  (current : AstExpr) = expr;
  (go : bool) = true;
  while(go, {
    if(ast_expr_is_fn_call(&current) && ast_expr_is_fn_call_of(&current, BK_BEGIN, Option(usize).None), {
      args := match(current, .FnCall(_, _, a, _, _) => a.clone(), _ => ArrayList(AstExpr).new());
      if(args.len() == usize(0), {
        go = false;
      }, {
        current = match(args.last(), .Some(a) => a, .None => current);
      });
    }, {
      go = false;
    });
  });
  current
});
/// Look up the evaluated `ExprInfo` for `expr`.
_info :: (fn(ctx : &EvalContext, expr : &AstExpr) -> Option(ExprInfo))(
  expr_info_table_get(&ctx.expr_info_table, ast_expr_id(expr))
);
/// Walk `expr` and return `true` iff it satisfies R1–R4. `expr` must already be
/// evaluated (so its `ExprInfo` and bindings are available).
is_flowable_expr :: (fn(expr_in : &AstExpr, ctx : &EvalContext, opts : &FlowOptions) -> bool)({
  expr := _unwrap_begin_blocks(expr_in);
  // Strip a `label : value` wrapper — labeled arguments (constructor fields
  // `Identifier(name : "x")`, named call args) are transparent for flow
  // purposes; the VALUE side is what flows.
  if(ast_expr_is_fn_call(&expr) && ast_expr_is_fn_call_of(&expr, ":", .Some(usize(2))), {
    labeled_args := match(expr, .FnCall(_, _, la, _, _) => la.clone(), _ => ArrayList(AstExpr).new());
    match(
      labeled_args.get(usize(1)),
      .Some(lv) => {
        return(recur(&lv, ctx, opts));
      },
      .None => ()
    );
  });
  // Divergent expressions never yield a value here — accept vacuously.
  info_opt := _info(ctx, &expr);
  has_cf := match(info_opt, .Some(i) => has_any_control_flow(i.control_flow), .None => false);
  if(has_cf, {
    return(true);
  });
  if(ast_expr_is_fn_call(&expr) && ast_expr_is_fn_call_of(&expr, BF_PANIC, Option(usize).None), {
    return(true);
  });
  // Trusted escape hatch: `unsafe(expr)` in privileged code is flowable.
  if(ast_expr_is_fn_call(&expr) && ast_expr_is_fn_call_of(&expr, BF_UNSAFE, Option(usize).None), {
    return(true);
  });
  // R1: bare name → check binding flags.
  if(ast_expr_is_atom(&expr), {
    tok := ast_expr_token(&expr);
    // Literal atoms (string/char/template-string) live in static storage.
    if(opts.allow_comptime_source, {
      is_lit := match(
        tok.kind,
        .StringLit => true,
        .CharLit => true,
        .TemplateString => true,
        _ => false
      );
      if(is_lit, {
        return(true);
      });
    });
    info := match(
      info_opt,
      .Some(i) => i,
      .None => {
        return(false);
      }
    );
    var_name := match(
      info.variable_name,
      .Some(n) => n,
      .None => {
        return(false);
      }
    );
    vars := get_variables_from_env(&info.env, &var_name);
    if(vars.len() == usize(0), {
      return(false);
    });
    v := match(
      vars.last(),
      .Some(x) => x,
      .None => {
        return(false);
      }
    );
    if(v.is_ref, {
      return(true);
    });
    // R1' (binding-site only): a same-frame non-module local, bounded by
    // `max_local_frame_level` when set.
    if(opts.allow_same_frame_local && !v.is_module_level, {
      ok := match(
        opts.max_local_frame_level,
        .None => true,
        .Some(maxl) => (v.frame_level <= maxl)
      );
      if(ok, {
        return(true);
      });
    });
    // R1'' (slice-flowability): a parameter of the enclosing function.
    if(opts.allow_parameter_source && v.is_parameter, {
      return(true);
    });
    // R1''' (slice-flowability): a comptime-bound name (static storage).
    if(opts.allow_comptime_source && v.is_compile_time_only, {
      return(true);
    });
    return(false);
  });
  if(!ast_expr_is_fn_call(&expr), {
    return(false);
  });
  call_func := match(expr, .FnCall(_, f, _, _, _) => f, _ => expr);
  call_args := match(expr, .FnCall(_, _, a, _, _) => a.clone(), _ => ArrayList(AstExpr).new());
  // R2: `expr.field` — a 2-arg `.` call. Flowable iff the base is flowable.
  if(ast_expr_is_fn_call_of(&expr, BF_DOT, Option(usize).Some(usize(2))), {
    base := match(
      call_args.get(usize(0)),
      .Some(a) => a,
      .None => {
        return(false);
      }
    );
    // A `.`/2 whose receiver evaluates to a TYPE is a no-argument qualified
    // variant constructor (`Option(str).None`), NOT a field projection — it
    // carries no smuggled pointer, so it is flowable.
    base_is_type := match(
      _info(ctx, &base),
      .Some(bi) => match(bi.value, .Some(bv) => is_type_val(&bv), .None => false),
      .None => false
    );
    if(base_is_type, {
      return(true);
    });
    return(recur(&base, ctx, opts));
  });
  // R4: `cond(arm1, arm2, …)` — every `=>` arm body must be flowable.
  if(ast_expr_is_fn_call_of(&expr, "cond", Option(usize).None), {
    (i : usize) = usize(0);
    while(i < call_args.len(), {
      arm := match(call_args.get(i), .Some(a) => a, .None => make_err_expr());
      if(ast_expr_is_fn_call(&arm) && ast_expr_is_fn_call_of(&arm, "=>", Option(usize).Some(usize(2))), {
        arm_args := match(arm, .FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
        arm_body := match(arm_args.get(usize(1)), .Some(a) => a, .None => make_err_expr());
        if(!recur(&arm_body, ctx, opts), {
          return(false);
        });
      }, {
        return(false);
      });
      i = (i + usize(1));
    });
    return(true);
  });
  // R4 (match form): `match(scrutinee, .Variant => arm, …)` — arms are args 1+.
  if(ast_expr_is_fn_call_of(&expr, "match", Option(usize).None), {
    (i : usize) = usize(1);
    while(i < call_args.len(), {
      arm := match(call_args.get(i), .Some(a) => a, .None => make_err_expr());
      if(ast_expr_is_fn_call(&arm) && ast_expr_is_fn_call_of(&arm, "=>", Option(usize).Some(usize(2))), {
        arm_args := match(arm, .FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
        arm_body := match(arm_args.get(usize(1)), .Some(a) => a, .None => make_err_expr());
        if(!recur(&arm_body, ctx, opts), {
          return(false);
        });
      }, {
        return(false);
      });
      i = (i + usize(1));
    });
    return(true);
  });
  // Pointer arithmetic: `base.add(off)` / `base.sub(off)` (formerly the
  // `&+`/`&-` operators — plans/archive/POINTER_OPERATORS_TO_TRAITS_AND_METHODS.md)
  // yields a pointer into the SAME storage as `base`. Flowable iff `base`
  // is flowable. GATED on the receiver's evaluated type being a raw
  // pointer — `add`/`sub` are ordinary method names on other types. The
  // direct builtin forms keep the positional-arg rule.
  if(ast_expr_is_fn_call_of(&expr, "__yo_ptr_add", Option(usize).None) ||
    ast_expr_is_fn_call_of(&expr, "__yo_ptr_sub", Option(usize).None), {
    base := match(
      call_args.get(usize(0)),
      .Some(a) => a,
      .None => {
        return(false);
      }
    );
    return(recur(&base, ctx, opts));
  });
  {
    fa_callee := match(expr, .FnCall(_, fa_f, _, _, _) => Option(AstExpr).Some(fa_f), _ => Option(AstExpr).None);
    match(
      fa_callee,
      .Some(fa_fn) => if(ast_expr_is_fn_call_of(&fa_fn, ".", Option(usize).Some(usize(2))) && (call_args.len() == usize(1)), {
        fa_recv := match(fa_fn, .FnCall(_, _, fa_fargs, _, _) => fa_fargs.get(usize(0)), _ => Option(AstExpr).None);
        fa_member := match(fa_fn, .FnCall(_, _, fa_fargs2, _, _) => fa_fargs2.get(usize(1)), _ => Option(AstExpr).None);
        fa_name := match(
          fa_member,
          .Some(fa_m) => if(ast_expr_is_atom(&fa_m), ast_expr_text(&fa_m), String.new()),
          .None => String.new()
        );
        if((fa_name == "add") || (fa_name == "sub"), {
          match(
            fa_recv,
            .Some(fa_r) => match(
              expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&fa_r)),
              .Some(fa_ri) => if(is_pointer_type(&fa_ri.ty), {
                return(recur(&fa_r, ctx, opts));
              }),
              .None => ()
            ),
            .None => ()
          );
        });
      }),
      .None => ()
    );
  };
  // Enum/variant construction: `.Variant(args…)` — `call.func` is a `.`/1 call
  // or a `.`-typed atom. Flowable iff every arg whose representation carries a
  // raw pointer is flowable. ALSO the QUALIFIED applied form `Enum.Variant(args)`
  // (`Option(str).Some("a")`): `call.func` is a `.`/2 selector whose receiver
  // evaluates to a TYPE. Its selector node carries no resolved constructor Func
  // type, so the R3 path below can't resolve it; detect it here and check args.
  is_qualified_variant_ctor := cond(
    (ast_expr_is_fn_call(&call_func) && ast_expr_is_fn_call_of(&call_func, BF_DOT, Option(usize).Some(usize(2)))) => {
      qrecv := match(
        call_func,
        .FnCall(_, _, cf_args, _, _) => match(cf_args.get(usize(0)), .Some(r) => r, .None => make_err_expr()),
        _ => make_err_expr()
      );
      match(
        _info(ctx, &qrecv),
        .Some(qi) => match(qi.value, .Some(qv) => is_type_val(&qv), .None => false),
        .None => false
      )
    },
    true => false
  );
  // Plain struct/type constructor: the CALLEE itself evaluates to a TYPE
  // value (`Identifier(name : "x")` where `Identifier :: struct(name : str)`).
  // Same reasoning as the variant-ctor forms: a freshly constructed value can
  // only carry a raw pointer through its arguments.
  is_type_ctor_call := match(
    _info(ctx, &call_func),
    .Some(cfi) => match(cfi.value, .Some(cfv) => is_type_val(&cfv), .None => false),
    .None => false
  );
  is_variant_ctor := (
    (ast_expr_is_fn_call(&call_func) && ast_expr_is_fn_call_of(&call_func, BF_DOT, Option(usize).Some(usize(1)))) ||
      (ast_expr_is_atom(&call_func) && match(ast_expr_token(&call_func).kind, .Dot => true, _ => false))
      || is_qualified_variant_ctor || is_type_ctor_call
  );
  if(is_variant_ctor, {
    (i : usize) = usize(0);
    while(i < call_args.len(), {
      (a : AstExpr) = match(call_args.get(i), .Some(x) => x, .None => make_err_expr());
      // Look THROUGH a `label : value` wrapper: the labeled pair node may
      // carry no ExprInfo type of its own, which would silently SKIP the
      // check and accept a constructor smuggling a local-backed slice
      // (`SliceWrapper(s : local_slice)`). The VALUE side is what flows.
      if(ast_expr_is_fn_call(&a) && ast_expr_is_fn_call_of(&a, ":", .Some(usize(2))), {
        a = match(
          a,
          .FnCall(_, _, la2, _, _) => match(la2.get(usize(1)), .Some(v) => v, .None => a),
          _ => a
        );
      });
      a_ty_opt := match(_info(ctx, &a), .Some(inf) => Option(TypeValue).Some(Rc.clone(inf.ty)), .None => Option(TypeValue).None);
      needs := match(a_ty_opt, .Some(t) => type_representation_contains_raw_ptr(&t), .None => false);
      if(needs && !recur(&a, ctx, opts), {
        return(false);
      });
      i = (i + usize(1));
    });
    return(true);
  });
  // Tuple construction `(e0, e1, …)` (a `tuple(...)` call): flowable iff every
  // element whose representation carries a raw pointer is flowable. Needed for
  // destructuring-assignment RHS `(a, b) = (seed, 1)`.
  if(ast_expr_is_fn_call(&expr) && ast_expr_is_fn_call_of(&expr, BK_TUPLE, Option(usize).None), {
    (ti : usize) = usize(0);
    while(ti < call_args.len(), {
      (te : AstExpr) = match(call_args.get(ti), .Some(x) => x, .None => make_err_expr());
      if(ast_expr_is_fn_call(&te) && ast_expr_is_fn_call_of(&te, ":", .Some(usize(2))), {
        te = match(
          te,
          .FnCall(_, _, tla, _, _) => match(tla.get(usize(1)), .Some(v) => v, .None => te),
          _ => te
        );
      });
      te_ty_opt := match(_info(ctx, &te), .Some(inf) => Option(TypeValue).Some(Rc.clone(inf.ty)), .None => Option(TypeValue).None);
      te_needs := match(te_ty_opt, .Some(t) => type_representation_contains_raw_ptr(&t), .None => false);
      if(te_needs && !recur(&te, ctx, opts), {
        return(false);
      });
      ti = (ti + usize(1));
    });
    return(true);
  });
  // R3: regular function call. Resolve the callee `Func` type from the callee
  // expr's ExprInfo.ty (holds the Func type for both direct + method calls).
  // The receiver of a method call (`call_func` args[0]) is the
  // implicit first argument.
  is_method_call := ast_expr_is_fn_call_of(&call_func, BF_DOT, Option(usize).Some(usize(2)));
  // The callee's Func type comes from its ExprInfo (set for direct calls). For
  // a METHOD call the `.`/2 callee sub-expr has no Func-typed ExprInfo, so fall
  // back to the method-callee side-table (keyed by this CALL's expr id,
  // populated during method dispatch).
  callee_ty_opt := match(
    _info(ctx, &call_func),
    .Some(inf) => Option(TypeValue).Some(Rc.clone(inf.ty)),
    .None => lookup_method_callee_type(ast_expr_id(&expr))
  );
  callee_ty := match(
    callee_ty_opt,
    .Some(t) => Rc.clone(t),
    .None => {
      return(false);
    }
  );
  if(!is_function_type(&callee_ty), {
    return(false);
  });
  // Extract the Func's return/ref/param info.
  is_ref_return := match(&callee_ty, Rc(.Func({ meta : __fm1 })) => __fm1.*.result_is_ref, _ => false);
  ret_ty := match(&callee_ty, Rc(.Func({ result : rb })) => Rc.clone(rb), _ => Rc.new(TypeValueNode.Unit));
  _slice_pre := (opts.allow_parameter_source && !is_ref_return);
  is_slice_return := (_slice_pre && type_representation_contains_raw_ptr(&ret_ty));
  if(!is_ref_return && !is_slice_return, {
    return(false);
  });
  param_types := match(&callee_ty, Rc(.Func({ param_types : pts })) => Rc.clone(pts), _ => no_types());
  param_is_ref := match(&callee_ty, Rc(.Func({ result : _ })) => fn_param_mut_ref_flags(&callee_ty), _ => no_flags());
  // Build the effective argument list (receiver as implicit arg 0 for methods).
  eff_args := ArrayList(AstExpr).new();
  if(is_method_call, {
    cf_args := match(call_func, .FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
    match(
      cf_args.get(usize(0)),
      .Some(recv) => {
        eff_args.push(recv);
      },
      .None => ()
    );
  });
  (ai : usize) = usize(0);
  while(ai < call_args.len(), {
    match(
      call_args.get(ai),
      .Some(a) => {
        eff_args.push(a);
      },
      .None => ()
    );
    ai = (ai + usize(1));
  });
  // For every ref-typed param (or, in slice mode, a slice-source-capable param),
  // the corresponding argument must be flowable.
  (pi : usize) = usize(0);
  (all_ok : bool) = true;
  while((pi < param_types.len()) && all_ok, {
    p_is_ref := match(param_is_ref.get(pi), .Some(b) => b, .None => false);
    p_ty := match(slot_pointee_at(&param_types, pi), .Some(t) => t, .None => Rc.new(TypeValueNode.Unit));
    _slice_src := (is_slice_return && type_may_provide_slice_source(&p_ty));
    needs_check := (p_is_ref || _slice_src);
    if(needs_check, {
      match(
        eff_args.get(pi),
        .Some(a) => {
          if(!recur(&a, ctx, opts), {
            all_ok = false;
          });
        },
        .None => {
          all_ok = false;
        }
      );
    });
    pi = (pi + usize(1));
  });
  all_ok
});
/// Follow
/// `is_owning_the_same_rc_value_as` links to the primary owner's id
/// (step-capped instead of an identity-set cycle guard).
alias_group_root :: (fn(variable : &Variable) -> String)({
  (cur : Variable) = variable;
  (root_id : String) = variable.id.to_string();
  (steps : usize) = usize(0);
  (done : bool) = false;
  while(!done && (steps < usize(64)), {
    match(
      cur.is_owning_the_same_rc_value_as,
      .Some(next_box) => {
        cur = next_box;
        root_id = cur.id.to_string();
      },
      .None => {
        done = true;
      }
    );
    steps = (steps + usize(1));
  });
  root_id
});

/// v4.1 (plans/archive/BORROW_EXCLUSIVITY.md): validate the PLACE passed to each
/// `ref` parameter. With local ref bindings removed, every borrow is an
/// argument lvalue evaluated at the call boundary; it is safe iff the
/// borrowed storage cannot be freed during the call. Whole variables are
/// stable slots; field chains may not hop through an intermediate OBJECT
/// (its handle lives in a replaceable slot) and may not root at a
/// module-level variable (a callee could reassign the global).
/// Call AFTER argument evaluation (the chain types must be resolved).
/// Walk a field chain (`h.s`, `a.b.c`) to its base atom; deref hops are
/// part of the chain. Returns None when the chain roots in a non-atom.
_place_root_atom :: (fn(expr_in : &AstExpr) -> Option(AstExpr))({
  (cur : AstExpr) = expr_in;
  (walking : bool) = true;
  while(walking, {
    if(ast_expr_is_fn_call(&cur) && ast_expr_is_fn_call_of(&cur, BF_DOT, .Some(usize(2))), {
      cur = match(
        cur,
        .FnCall(_, _, pr_args, _, _) => match(pr_args.get(usize(0)), .Some(b) => b, .None => make_err_expr()),
        .Atom(_, _) => make_err_expr()
      );
    }, {
      walking = false;
    });
  });
  cond(
    ast_expr_is_atom(&cur) => Option(AstExpr).Some(cur),
    true => Option(AstExpr).None
  )
});
/// Call-site ref/own exclusivity (v4, plans/archive/BORROW_EXCLUSIVITY.md):
/// within ONE call, an argument bound to an `own(...)` parameter must
/// not be (or alias) the root of another argument bound to a `inout(...)`
/// parameter. `f(h.s, h)` with `f :: fn(x : &mut String, own(victim) :
/// Holder)` moves the caller's count into the callee, which can release
/// it while `x` still points into the object — a use-after-free no
/// same-scope gate can see. A by-value argument overlapping an `inout` one is
/// not rejected: it is kept alive with a caller-owned +1 for the call
/// (`argument_is_aliased_by_inout`, calls/helper.yo), since the callee can
/// replace the `inout` variable's value.
require_ref_own_argument_exclusivity :: (
  fn(
    param_labels : &ArrayList(String),
    param_is_ref : &ArrayList(bool),
    param_is_owning : &ArrayList(bool),
    args : &ArrayList(AstExpr),
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> unit
)({
  ref_root_vars := ArrayList(Variable).new();
  ref_root_idxs := ArrayList(usize).new();
  ref_root_lbls := ArrayList(String).new();
  own_root_vars := ArrayList(Variable).new();
  own_root_idxs := ArrayList(usize).new();
  own_root_lbls := ArrayList(String).new();
  (limit : usize) = args.len();
  (pi : usize) = usize(0);
  while(pi < limit, {
    is_ref := cond((pi < param_is_ref.len()) => match(param_is_ref.get(pi), .Some(r) => r, .None => false), true => false);
    // A by-value argument with nothing to transfer (a `Copy` value: no
    // counted payload, implicitly copyable) is copied, so the callee owns
    // nothing a borrow in the same call could see dropped. Since the flip
    // (decision 30) every plain parameter is by value.
    is_owning := (
      cond((pi < param_is_owning.len()) => match(param_is_owning.get(pi), .Some(o) => o, .None => false), true => false) && !match(
        args.get(pi),
        .Some(oa) => match(_info(ctx, &oa), .Some(oi) => type_is_bitwise_copy(Rc.clone(oi.ty)), .None => false),
        .None => false
      )
    );
    if(!is_ref && !is_owning, {
      pi = (pi + usize(1));
    }, {
      lbl := cond((pi < param_labels.len()) => match(param_labels.get(pi), .Some(l) => l, .None => String.from("")), true => String.from(""));
      match(
        args.get(pi),
        .Some(arg) => {
          root_atom_opt := match(
            _info(ctx, &arg),
            .Some(inf) => {
              is_idx := match(expr_info_index_trait_ptr_type(&inf), .Some(_) => true, .None => false);
              cond(
                (is_idx && ast_expr_is_fn_call(&arg)) => match(
                  arg,
                  .FnCall(_, fc, _, _, _) => _place_root_atom(&fc),
                  _ => Option(AstExpr).None
                ),
                true => _place_root_atom(&arg)
              )
            },
            .None => Option(AstExpr).None
          );
          match(
            root_atom_opt,
            .Some(root_atom) => {
              root_env := match(_info(ctx, &root_atom), .Some(ri) => expr_info_adopt_env(&ri), .None => env);
              vars := get_variables_from_env(&root_env, ast_expr_text(&root_atom));
              if(vars.len() > usize(0), {
                match(
                  vars.last(),
                  .Some(vv) => {
                    if(is_ref, {
                      ref_root_vars.push(vv);
                      ref_root_idxs.push(pi);
                      ref_root_lbls.push(lbl);
                    }, {
                      own_root_vars.push(vv);
                      own_root_idxs.push(pi);
                      own_root_lbls.push(lbl);
                    });
                  },
                  .None => ()
                );
              });
            },
            .None => ()
          );
        },
        .None => ()
      );
      pi = (pi + usize(1));
    });
  });
  (oi : usize) = usize(0);
  while(oi < own_root_vars.len(), {
    (ri : usize) = usize(0);
    while(ri < ref_root_vars.len(), {
      // Check ref and own indices differ, then check aliasing.
      // Use nested if/match to stay in unit-return position.
      match(
        own_root_idxs.get(oi),
        .Some(own_idx) =>
          match(
            ref_root_idxs.get(ri),
            .Some(ref_idx) =>
              if(!(ref_idx == own_idx), {
                match(
                  own_root_vars.get(oi),
                  .Some(own_var) =>
                    match(
                      ref_root_vars.get(ri),
                      .Some(ref_var) =>
                        if(alias_group_root(&ref_var) == alias_group_root(&own_var), {
                          own_lbl := match(own_root_lbls.get(oi), .Some(l) => l, .None => String.from(""));
                          ref_lbl := match(ref_root_lbls.get(ri), .Some(l) => l, .None => String.from(""));
                          match(
                            args.get(own_idx),
                            .Some(own_arg) =>
                              exn.throw(
                                dyn(
                                  format_error_message(
                                    ast_expr_token(&own_arg),
                                    `Cannot pass "${own_var.name}" to the sink parameter "${own_lbl}" in the same call where argument ${ref_idx + usize(1)} borrows from it (bound to the ref parameter "${ref_lbl}") — the callee takes ownership and may drop the object while the borrow is still in use. Copy the value out instead, or split the calls.`
                                  )
                                )
                              ),
                            .None => ()
                          );
                        }),
                      .None => ()
                    ),
                  .None => ()
                );
              }),
            .None => ()
          ),
        .None => ()
      );
      ri = (ri + usize(1));
    });
    oi = (oi + usize(1));
  });
});
/// Can a value of `ty` hold, or reach through its fields, a cell, a pointer
/// or a box, a value of one of the types `targets` names (`type_key`)? A
/// `Dyn`, an open type variable and a `void` pointer can hold anything; a
/// function value — inside an aggregate, an `Impl(Future)` frame, or the
/// argument itself — may be a closure that captured one, so those answer yes
/// too. A FUNCTION-TYPED argument never reaches this walk: rule (b) of
/// `_reject_if_container_reachable` judges it by the representation
/// formulas instead (the pre-B6-a rule's pair), which accept a bare `fn`
/// and reject a type carrying a capture struct. A plain DFS over the type
/// graph: `seen` holds every type already walked, which adds nothing the
/// first visit did not.
_type_may_reach_any_of :: (
  fn(
    ty_in : &TypeValue,
    targets : &HashSet(String),
    seen : &mut HashSet(String)
  ) -> bool
)({
  ty := resolve_enum_shell(resolve_struct_shell(&t_refine_inner(ty_in)));
  key := type_key(&ty);
  if(targets.contains(&key), {
    return(true);
  });
  if(seen.contains(&key), {
    return(false);
  });
  seen.insert(key);
  match(
    unique_box_payload_type(&ty),
    .Some(payload) => {
      return(recur(&payload, targets, seen));
    },
    .None => ()
  );
  match(
    ty,
    Rc(.Struct({ field_types : fields })) => _any_may_reach_any_of(&fields.items, targets, seen),
    Rc(.EnumT({ variant_fields : all_fields })) => {
      (vi : usize) = usize(0);
      while(vi < all_fields.len(), vi = (vi + usize(1)), {
        match(
          all_fields.get(vi),
          .Some(v_fields) => if(_any_may_reach_any_of(&v_fields.items, targets, seen), {
            return(true);
          }),
          .None => ()
        );
      });
      false
    },
    Rc(.Tuple(field_labels : _, field_types : fields)) => _any_may_reach_any_of(&fields.items, targets, seen),
    Rc(.Union(name : _, field_labels : _, field_types : fields)) => _any_may_reach_any_of(&fields.items, targets, seen),
    Rc(.Array(element : elem, length : _)) => recur(&elem, targets, seen),
    Rc(.Pointer(pointee : p)) => match(
      t_refine_inner(&p),
      Rc(.Void) => true,
      _ => recur(&p, targets, seen)
    ),
    Rc(.Func({ result : _ })) => true,
    Rc(.FnTraitT(base_name : _)) => true,
    Rc(.FutureTraitT(base_name : _)) => true,
    Rc(.DynT(required_trait_types : _)) => true,
    Rc(.SomeT({ resolution : resolved })) => match(
      resolved,
      .Some(concrete) => recur(&concrete, targets, seen),
      .None => true
    ),
    _ => false
  )
});
/// `_type_may_reach_any_of` over each of `fields`.
_any_may_reach_any_of :: (
  fn(
    fields : &ArrayList(TypeValue),
    targets : &HashSet(String),
    seen : &mut HashSet(String)
  ) -> bool
)({
  (i : usize) = usize(0);
  while(i < fields.len(), i = (i + usize(1)), {
    match(
      fields.get(i),
      .Some(ft) => if(_type_may_reach_any_of(&ft, targets, seen), {
        return(true);
      }),
      .None => ()
    );
  });
  false
});
/// Is `ty` itself a function type — a `Func`, an `Fn`/`FnMut`/`FnOnce`
/// trait type, or an `Impl(...)` WRAPPER of one (through refinement and
/// shells)? An `Impl(...)` wrapper is recognized by the reserved SomeT NAME,
/// not by diving into its resolution: the resolution is not the wrapper — a
/// closure's wrapper resolves to its capture struct, which is not a function
/// type, and the wrapper must still be judged as a function value (F1: a
/// closure held in a variable beside an element borrow). An unresolved type
/// variable may stand for a closure, so it answers yes too.
_is_fn_typed :: (fn(ty_in : &TypeValue) -> bool)({
  ty := resolve_enum_shell(resolve_struct_shell(&t_refine_inner(ty_in)));
  match(
    ty,
    Rc(.Func({ result : _ })) => true,
    Rc(.FnTraitT(base_name : _)) => true,
    Rc(.SomeT({ name : sn, resolution : resolved })) => cond(
      (sn == `Impl`) => true,
      true => match(
        resolved,
        .Some(concrete) => _is_fn_typed(&concrete),
        .None => true
      )
    ),
    _ => false
  )
});
/// The types a ref argument's storage hangs from: the container holding the
/// element (`index`) or the object the field lives in (`object-hop`), and
/// every value on the field path down to it from the root variable, keyed by
/// `type_key`. A callee that reaches a value of any of them can grow, clear
/// or reassign it and free the storage under the reference. `.None` when a
/// type on the path is unknown.
_ref_place_holder_types :: (fn(ref_arg : &AstExpr, kind : str, root : &Variable, ctx : &EvalContext) -> Option(HashSet(String)))({
  keys := HashSet(String).new();
  keys.insert(type_key(&root.ty));
  (cur : AstExpr) = match(
    ref_arg,
    .FnCall(_, callee, dargs, _, _) => cond(
      (kind == "index") => callee,
      true => match(dargs.get(usize(0)), .Some(b) => b, .None => return(.None))
    ),
    .Atom(_, _) => return(.None)
  );
  while(!ast_expr_is_atom(&cur), {
    match(
      expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&cur)),
      .Some(ci) => {
        keys.insert(type_key(&ci.ty));
      },
      .None => return(.None)
    );
    if(!(ast_expr_is_fn_call(&cur) && ast_expr_is_fn_call_of(&cur, BF_DOT, .Some(usize(2)))), {
      return(.None);
    });
    cur = match(
      cur,
      .FnCall(_, _, pargs, _, _) => match(pargs.get(usize(0)), .Some(b) => b, .None => return(.None)),
      .Atom(_, _) => return(.None)
    );
  });
  .Some(keys)
});
/// One §3.13 A2 deferral: a sibling-rule (b) rejection that stands down for
/// an argument lent to a parameter of a future-PRODUCING callee, recorded
/// here until `_note_future_producing_call` knows the future's real capture
/// list. The callee's DECLARED result cannot answer that at argument-check
/// time: the registered captures live under the `io.async` value's per-call
/// wrapper id (`_register_borrowing_future`), a different SomeT from the
/// signature's annotation, so only the evaluated call result carries them.
/// A2 owns the place when a capture names the parameter (`root_name`): it
/// either rejects with the async-specific cell diagnostic or deliberately
/// accepts (a shared borrow through a read-only handle), and the recorded
/// complaint is dropped. A parameter no capture names was never A2's, and
/// the complaint is re-raised.
_DeferredSiblingRule :: struct(call_id : usize, label : String, err : YoError);
(g_deferred_sibling_rules : RefCell(ArrayList(_DeferredSiblingRule))) = RefCell(ArrayList(_DeferredSiblingRule)).new(ArrayList(_DeferredSiblingRule).new());
/// Record a deferred rule-(b) rejection (see `_DeferredSiblingRule`).
flag_deferred_sibling_rule :: (fn(call_id : usize, label : &String, err : &YoError) -> unit)({
  g_deferred_sibling_rules.with_mut(xs => xs.push(_DeferredSiblingRule(call_id : call_id, label : label.clone(), err : err)));
  ()
});
/// Settle the deferred rule-(b) rejections of call `call_id` now that A2 has
/// spoken (`borrowed` = the future's capture borrows, already collected by
/// the caller): drop those a capture names — A2 judged that parameter's
/// place, both directions — and re-raise the first one no capture names.
take_deferred_sibling_rules :: (fn(call_id : usize, borrowed : &ArrayList(CaptureBorrow), exn : Exception) -> unit)({
  remaining := ArrayList(_DeferredSiblingRule).new();
  (first_unowned : Option(YoError)) = Option(YoError).None;
  g_deferred_sibling_rules.with_mut(xs => {
    (xi : usize) = usize(0);
    while(xi < xs.len(), {
      match(
        xs.get(xi),
        .Some(e) => {
          if(e.call_id == call_id, {
            (owned : bool) = false;
            (bi : usize) = usize(0);
            while(bi < borrowed.len(), {
              match(
                borrowed.get(bi),
                .Some(b) => {
                  if(b.root_name == e.label, {
                    owned = true;
                  });
                },
                .None => ()
              );
              bi = (bi + usize(1));
            });
            if(!owned && first_unowned.is_none(), {
              first_unowned = Option(YoError).Some(e.err);
            });
          }, {
            remaining.push(e);
          });
        },
        .None => ()
      );
      xi = (xi + usize(1));
    });
    xs.clear();
    (ri : usize) = usize(0);
    while(ri < remaining.len(), {
      match(
        remaining.get(ri),
        .Some(e) => xs.push(e),
        .None => ()
      );
      ri = (ri + usize(1));
    });
  });
  match(
    first_unowned,
    .Some(m) => exn.throw(dyn(m)),
    .None => ()
  );
});

/// Reject a ref argument whose place lives inside `container_atom`'s heap
/// allocation when the callee can REACH that container and free/realloc it
/// during the call: (a) the container is module-level or aliases a
/// module-level variable; (b) any OTHER argument could hold a handle to it
/// — a closure (may have captured it: a literal, or a value held in a
/// variable, which the representation formulas catch because a closure's
/// recorded type carries its capture struct while a plain `fn`'s does not),
/// or a value whose type can hold one of the types the place hangs from
/// (`_ref_place_holder_types`, `_type_may_reach_any_of`). A value that
/// cannot hold one cannot reach it: `replace(&mut xs(i), v)` with
/// `xs : ArrayList(String)` and `v : String` is fine, since no `String`
/// holds an `ArrayList(String)`
/// (issues/fixed/2026-10-24-an-element-borrow-rejects-a-sibling-argument-that-cannot-reach-the-container.md).
/// Rule (b) does not THROW for an argument of a future-PRODUCING callee
/// when `defer_call_id` is `.Some`: the complaint is recorded
/// (`flag_deferred_sibling_rule`) and `_note_future_producing_call` settles
/// it against the future's real capture list — §3.13 A2 owns the place when
/// a capture names the parameter, in both directions (its cell diagnostic
/// names the async hazard; a shared borrow through a read-only handle is
/// deliberately accepted), and the recorded complaint is re-raised for a
/// parameter no capture names. `Io` is why the deferral exists at all: it is
/// a struct of four plain `fn` fields — harmless by representation, but the
/// walk conservatively answers yes for a function value — and it sits beside
/// the borrow in every async call.
/// `kind` is "index" or "object-hop".
_reject_if_container_reachable :: (
  fn(
    container_atom : &AstExpr,
    ref_arg : &AstExpr,
    ref_arg_index : usize,
    kind : str,
    args : &ArrayList(AstExpr),
    n : usize,
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception,
    defer_call_id : &Option(usize),
    defer_label : &String
  ) -> unit
)({
  // The synthetic call an index-method specialization trial replays (args =
  // [receiver, index]) is not a user call: its RECEIVER is an index place
  // borrowing into the base container while the key arg sits beside it —
  // exactly this rule's shape — but the desugared index access
  // `mm(i)(k) = v` is the sanctioned spelling of that write, and the REAL
  // (non-trial) index path never runs this check (the single-level
  // `mm(k) = v` receiver is a bare atom, not an index-place FnCall, so the
  // rule cannot fire there). Rejecting only in the trial falls back to the
  // unspecialized generic method, a C function codegen never declares.
  // Skip the rule for THAT receiver only; other calls the trial
  // re-evaluates (the receiver's own nested evaluation, the specialized
  // body's internal calls) keep it.
  match(
    ctx.index_specialization_trial_recv_id,
    .Some(trial_rid) => {
      if(ast_expr_id(ref_arg) == trial_rid, {
        return(());
      });
    },
    .None => ()
  );
  if(!ast_expr_is_atom(container_atom), {
    return(());
  });
  cvars := get_variables_from_env(env, ast_expr_text(container_atom));
  if(cvars.len() == usize(0), {
    return(());
  });
  cvar := match(cvars.last(), .Some(v) => v, .None => return(()));
  cname := ast_expr_text(container_atom);
  fix := cond(
    (kind == "index") => String.from("Read the element into a local first (\"xs.get(i)\" copies it, std/mem's \"take(&mut xs(i))\" moves it out), or split the calls."),
    true => String.from("Bind the intermediate object to a local first (\"b := ...;\") and pass a field of \"b\" instead, or split the calls.")
  );
  // (a) globally reachable: module-level itself, or aliases a module-level var.
  c_root_id := alias_group_root(&cvar);
  (root_module : bool) = cvar.is_module_level;
  if(!root_module, {
    // Walk env for a variable whose id == c_root_id and is module-level.
    (fi : usize) = usize(0);
    while(fi < env.frames.len(), {
      match(
        env.frames.get(fi),
        .Some(frame) => {
          (vi : usize) = usize(0);
          while(vi < frame.variables.len(), {
            match(
              frame.variables.get(vi),
              .Some(fv) => {
                if((fv.id.to_string() == c_root_id) && fv.is_module_level, {
                  root_module = true;
                });
              },
              .None => ()
            );
            vi = (vi + usize(1));
          });
        },
        .None => ()
      );
      fi = (fi + usize(1));
    });
  });
  if(root_module, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(ref_arg),
          `A 'ref' argument ("${ast_expr_to_string(ref_arg)}") borrows into the module-level container "${cname}" — any callee could reach it and free/reallocate the storage the reference points into. ${fix}`
        )
      )
    );
  });
  // A fixed-size `Array(N, T)` element lives INLINE in its owner's storage:
  // the buffer cannot be reallocated, and no other value can hold a handle
  // to it (a capture copies the owner by value), so a sibling argument
  // cannot invalidate the reference by growing anything. Only rule (a)
  // above still applies (a callee could reassign a module-level owner).
  // (issues/fixed/2026-10-26-the-async-await-a2-batch-is-poisoned-three-ways-on-develop.md part 2)
  if(kind == "index", {
    match(
      ref_arg,
      .FnCall(_, idx_callee, _, _, _) => {
        match(
          expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&idx_callee)),
          .Some(idx_info) => {
            ity := resolve_enum_shell(resolve_struct_shell(&t_refine_inner(&idx_info.ty)));
            match(
              ity,
              Rc(.Array(element : _, length : _)) => return(()),
              _ => ()
            );
          },
          .None => ()
        );
      },
      .Atom(_, _) => ()
    );
  });
  // (b) element-only: any OTHER argument that could hold a handle to the
  // container — a closure, or a value whose type can hold one of the types
  // the place hangs from — could grow/free it. Without the path's types, any
  // non-`Copy` value or pointer-carrier counts. For a future-PRODUCING
  // callee the rejection is DEFERRED (`defer_call_id`), not thrown: §3.13
  // A2 settles it — every async call carries the `io` sibling beside the
  // borrow, and `Io` is a struct of four plain `fn` fields, harmless by
  // representation but a maybe-closure to the walk, so throwing here would
  // reject even the shared-through-`Rc` lend A2 accepts and would displace
  // A2's cell diagnostic with the grow/realloc one everywhere else.
  holder_types := _ref_place_holder_types(ref_arg, kind, &cvar, ctx);
  (j : usize) = usize(0);
  while(j < n, {
    if(!(j == ref_arg_index), {
      other := match(args.get(j), .Some(a) => a, .None => make_err_expr());
      could_reach := match(
        expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&other)),
        .Some(oi) => {
          // The anonymous-fn eval does NOT set closure_function_value (documented
          // convention in anonymous_function.yo — downstream must fall
          // back); capture_type and closure_function_value are stamped
          // under the SAME closure-creation gate, so on an anon-fn ExprInfo
          // capture_type-is-set is the equivalent signal.
          is_closure := match(
            expr_info_closure_function_value(&oi),
            .Some(_) => true,
            .None => (
              match(expr_info_is_anonymous_function_definition(&oi), .Some(b) => b, .None => false) &&
                expr_info_capture_type(&oi).is_some()
            )
          );
          is_closure || match(
            holder_types,
            .Some(targets) => {
              // F1: a function-typed sibling is NOT given to the walk — the
              // walk answers yes for every `Func`/`Fn` trait type, which
              // would reject a plain `fn` reference too. Its TYPE alone
              // still cannot tell a closure from a plain `fn` by shape, but
              // the two representation formulas CAN: a bare `Func` holds no
              // counted handle and no raw pointer, while a closure's
              // recorded type carries its capture struct (anonymous_function
              // stamps an `Impl(Fn(...))` wrapper with the capture struct as
              // its resolved concrete), so an `Rc`-holding capture — the
              // container among them — shows up in the representation. That
              // is exactly the pre-B6-a rule's pair, so every function-typed
              // sibling keeps the verdict the old rule gave it; only the
              // non-function siblings gain the target-precise walk above.
              (is_fn : bool) = _is_fn_typed(&oi.ty);
              if(is_fn, {
                fn_may_reach := (type_contains_rc_type(&oi.ty) || type_representation_contains_raw_ptr(&oi.ty));
                fn_may_reach
              }, {
                seen := HashSet(String).new();
                _type_may_reach_any_of(&oi.ty, &targets, &mut seen)
              })
            },
            .None => (type_contains_rc_type(&oi.ty) || type_representation_contains_raw_ptr(&oi.ty))
          )
        },
        .None => false
      );
      if(could_reach, {
        message := format_error_message(
          ast_expr_token(ref_arg),
          `A 'ref' argument ("${ast_expr_to_string(ref_arg)}") borrows into the container "${cname}", but argument ${(j + usize(1)).to_string()} of the same call could hold a handle to "${cname}" and grow it, reallocating the buffer the reference points into. ${fix}`
        );
        match(
          defer_call_id,
          .Some(did) => flag_deferred_sibling_rule(did, defer_label, &message),
          .None => exn.throw(dyn(message))
        );
      });
    });
    j = (j + usize(1));
  });
});
require_valid_ref_argument_places :: (
  fn(
    param_is_ref : &ArrayList(bool),
    future_callee : bool,
    call_id : usize,
    param_labels : &ArrayList(String),
    args : &ArrayList(AstExpr),
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> unit
)({
  (n : usize) = param_is_ref.len();
  if(args.len() < n, {
    n = args.len();
  });
  (i : usize) = usize(0);
  while(i < n, {
    p_ref := match(param_is_ref.get(i), .Some(b) => b, .None => false);
    if(p_ref, {
      // §3.13 A2 deferral: for a future-PRODUCING callee the sibling rule
      // below does not throw for this argument but records its complaint
      // (`flag_deferred_sibling_rule`); `_note_future_producing_call`
      // settles it against the future's real capture list.
      defer_id := if(
        future_callee && param_labels.get(i).is_some(),
        Option(usize).Some(call_id),
        Option(usize).None
      );
      defer_label := match(param_labels.get(i), .Some(l) => l, .None => String.new());
      arg := match(args.get(i), .Some(a) => a, .None => make_err_expr());
      arg_tok := ast_expr_token(&arg);
      if(!arg_tok.module_path.*.starts_with(String.from("auto-generated://")), {
        // `xs(i)` (Index trait) yields a raw `*(T)` into the container's
        // heap buffer; reject when the container is reachable.
        arg_is_index_place := match(
          expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&arg)),
          .Some(ai_info) => match(expr_info_index_trait_ptr_type(&ai_info), .Some(_) => true, .None => false),
          .None => false
        );
        if(arg_is_index_place && ast_expr_is_fn_call(&arg), {
          container_atom := match(
            arg,
            .FnCall(_, icallee, _, _, _) => _place_root_atom(&icallee),
            .Atom(_, _) => Option(AstExpr).None
          );
          match(
            container_atom,
            .Some(catom) => _reject_if_container_reachable(&catom, &arg, i, "index", args, n, env, ctx, exn, &defer_id, &defer_label),
            .None => ()
          );
        }, {
          if(ast_expr_is_fn_call(&arg) && ast_expr_is_fn_call_of(&arg, BF_DOT, .Some(usize(2))), {
            // Walk the field chain; collect hops; find the root atom.
            hops := ArrayList(AstExpr).new();
            (cur : AstExpr) = arg;
            (walking : bool) = true;
            while(walking, {
              if(ast_expr_is_fn_call(&cur) && ast_expr_is_fn_call_of(&cur, BF_DOT, .Some(usize(2))), {
                hops.push(cur);
                cur = match(
                  cur,
                  .FnCall(_, _, dargs, _, _) => match(dargs.get(usize(0)), .Some(b) => b, .None => make_err_expr()),
                  .Atom(_, _) => make_err_expr()
                );
              }, {
                walking = false;
              });
            });
            // Namespace-style access (Type.member) is not a borrow.
            root_is_type := match(
              expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&cur)),
              .Some(ri) => match(ri.value, .Some(v) => is_type_val(&v), .None => false),
              .None => false
            );
            if(!root_is_type, {
              // An INTERMEDIATE object-field hop (`a.objField.x`, and
              // equally `box.*.x` — `*` is just a field) borrows into a heap
              // object whose handle lives in a slot; a callee can free it by
              // reassigning the slot, but only if it can REACH the root. Same
              // reachability question as the index case. (No `*` special-case.)
              (has_object_hop : bool) = false;
              (h : usize) = usize(1);
              while(h < hops.len(), {
                hop := match(hops.get(h), .Some(x) => x, .None => make_err_expr());
                match(
                  expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&hop)),
                  .Some(hri) => {
                    if(is_counted_handle_type(&hri.ty), {
                      has_object_hop = true;
                    });
                  },
                  .None => ()
                );
                h = (h + usize(1));
              });
              if(has_object_hop && ast_expr_is_atom(&cur), {
                _reject_if_container_reachable(&cur, &arg, i, "object-hop", args, n, env, ctx, exn, &defer_id, &defer_label);
              });
              // A field of a MODULE-LEVEL root is unsafe when overwriting
              // it through the ref could free heap storage: OBJECT roots
              // (the callee can reassign the global), and non-object roots
              // whose ref'd element type contains Rc (e.g. a tuple field
              // holding an ArrayList — overwriting the handle frees it).
              if(!has_object_hop && ast_expr_is_atom(&cur), {
                root_vars := get_variables_from_env(env, ast_expr_text(&cur));
                if(root_vars.len() > usize(0), {
                  match(
                    root_vars.last(),
                    .Some(rv) => {
                      root_is_object := is_counted_handle_type(&rv.ty);
                      ref_type_contains_rc := match(
                        _info(ctx, &arg),
                        .Some(inf) => type_contains_rc_type(&inf.ty),
                        .None => false
                      );
                      if(rv.is_module_level && (root_is_object || ref_type_contains_rc), {
                        exn.throw(
                          dyn(
                            format_error_message(
                              &arg_tok,
                              `A 'ref' argument cannot borrow a field of the module-level object "${ast_expr_text(&cur)}" — a callee could reassign it and free the borrowed storage. Bind it to a local first:\n  h := ${ast_expr_text(&cur)};\nand pass the field of "h" instead.`
                            )
                          )
                        );
                      });
                    },
                    .None => ()
                  );
                });
              });
            });
          });
        });
      });
    });
    i = (i + usize(1));
  });
});

/// Record a def-time swallowed throw for the cee observation channel.
/// Lives HERE (a plain module fn) rather than inline in the wrapper's `->` handler.
///
/// CORRECTED 2026-08-12: the old note here claimed a BRANCH inside a capture-free
/// handler miscompiles. That premise is stale and was actively misleading — it
/// talks a reader out of designs that are in fact fine.
/// `issues/fixed/yo-ts-codegen-branch-in-effect-handler-corruption.md` ("Root
/// cause: FOUND + FIXED", 2026-08-07, shipped in `4c10894cb`) found the real
/// defect: the unwind emitter raised `__yo_effect_escaped = 1` BEFORE evaluating
/// the unwind ARGUMENT, so a may-unwind call inside that argument emitted the
/// caller-side pre-clear and cancelled the in-progress unwind. Both compilers now
/// evaluate the argument first, and every published seed (0.2.0+) carries the fix.
///
/// The nuance worth keeping: the branch WAS the trigger — it changed which calls
/// the argument path makes, and the bisect table in that doc shows the same
/// `unwind(make_err_expr())` shape green 6/6 before it and red after. So "branches
/// are irrelevant" would also be wrong; it simply is not a codegen soundness limit.
///
/// The REAL constraints on these handlers are: they cannot capture outer runtime
/// variables (a hard evaluator error — see
/// issues/fixed/throw-handler-lambda-scope-restriction.md), which is why such a
/// handler can never reach the enclosing `exn`; and `unwind(v)` memcpys into a
/// fixed 64-byte `__yo_unwind_value` buffer, so `v` must stay small. Calling a
/// module fn from the handler — what this function exists for — is fine.
/// Keeping the body straight-line is now style, and it costs nothing.
note_def_time_swallow :: (fn(err : &AnyError) -> unit)({
  if(propagate_def_time_errors(), {
    set_cee_observed_error();
    // Stringified only here: outside propagate mode a swallow costs nothing.
    record_cee_error_message(error_message_text(err));
  });
});
export(
  FlowOptions,
  flow_options_default,
  is_flowable_expr,
  flag_flow_violation,
  clear_flow_violation,
  flow_violation_pending,
  flow_violation_error,
  raise_flow_violation,
  reraise_flow_violation,
  alias_group_root,
  require_ref_own_argument_exclusivity,
  require_valid_ref_argument_places,
  take_deferred_sibling_rules,
  set_propagate_def_time_errors,
  propagate_def_time_errors,
  set_cee_observed_error,
  clear_cee_observed_error,
  cee_observed_error,
  record_cee_error_message,
  cee_observed_messages
);

export(note_def_time_swallow);
