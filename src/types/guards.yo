//! Type guard predicates.
//!
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ HashMap } :: import("std/collections/hash_map");
{ TypeValue, no_types } :: import("./definitions.yo");
{ type_value_tag, resolve_enum_shell, resolve_struct_shell } :: import("./creators.yo");
{ t_refine_inner } :: import("./definitions.yo");
{ BK_YO_CELL, BK_YO_ATOMIC_CELL } :: import("../expr.yo");
{ RefCell } :: import("std/sync/refcell");
// ---------------------------------------------------------------------------
// Type-declaration MODULE registry — which module declared a struct / enum /
// union, keyed by the type id its declaration minted. `TypeValue` carries no
// module, and the id only HASHES the module path into its stable key, so the
// path has to be recorded at the declaration site. Consumer: the member
// visibility check (`_`-prefixed fields are private to the declaring module
// and its same-directory siblings — plans/reference/MEMBER_VISIBILITY.md,
// decided 2026-09-16). A type with no entry (source-namespace module structs,
// builtins) has no private members.
// ---------------------------------------------------------------------------
(g_type_decl_modules : RefCell(HashMap(String, String))) = RefCell(HashMap(String, String)).new(HashMap(String, String).new());
register_type_decl_module :: (fn(type_id : &String, module_path : &String) -> unit)({
  if((type_id.len() > usize(0)) && (module_path.len() > usize(0)), {
    g_type_decl_modules.with_mut(m => m.insert(type_id, module_path));
  });
  ()
});
/// The module that declared the type with id `type_id`, if recorded (a clone —
/// never the registry's own String).
type_decl_module :: (fn(type_id : &String) -> Option(String))(
  match(g_type_decl_modules.with(m => m.get(type_id)), .Some(m) => Option(String).Some(m.clone()), .None => Option(String).None)
);
// ---------------------------------------------------------------------------
// enum id → DECLARATION identity (`stable_decl_key` of the `enum(...)` node),
// recorded where `evaluate_enum_type` mints the id, for the final AND its
// self-shell. Both id families — the module-level `enum_decl_…` and the
// eval-fresh CTFE `enum_…_n<k>` of a generic constructor's instantiation —
// map to the one declaration they were minted from, which no string
// derivation from the ids can recover (each spells the anchor differently).
// Consumers: type_key's structural enum dedup and the enum arm of type
// compatibility — renditions of one declaration may merge, two declarations
// never (issues/fixed/2026-10-17-two-recursive-enums-of-one-shape-share-their-arraylist-self-instantiation.md).
// An id with no entry (`create_option_type`'s synthesized `Option`, id "")
// keeps the shape-only rules, against std/prelude.yo's declarations only in
// type_key (`register_prelude_enum_decl`).
// ---------------------------------------------------------------------------
(g_enum_decl_identities : RefCell(HashMap(String, String))) = RefCell(HashMap(String, String)).new(HashMap(String, String).new());
register_enum_decl_identity :: (fn(enum_id : &String, decl : &String) -> unit)({
  if((enum_id.len() > usize(0)) && (decl.len() > usize(0)), {
    g_enum_decl_identities.with_mut(m => m.insert(enum_id, decl));
  });
  ()
});
/// Declaration identities of enums declared in std/prelude.yo itself
/// (recorded by `evaluate_enum_type`). type_key lets only these stand for an
/// undeclared synthetic rendition of the same shape: `create_option_type`'s
/// `Option` is the prelude's `Option(T)`, never a user enum spelled
/// `enum(None, Some(value : T))` that happens to be keyed first.
(g_prelude_enum_decls : RefCell(HashMap(String, bool))) = RefCell(HashMap(String, bool)).new(HashMap(String, bool).new());
register_prelude_enum_decl :: (fn(decl : &String) -> unit)({
  if(decl.len() > usize(0), {
    g_prelude_enum_decls.with_mut(m => m.insert(decl, true));
  });
  ()
});
/// Whether declaration identity `decl` names an enum declared in std/prelude.yo.
is_prelude_enum_decl :: (fn(decl : &String) -> bool)(
  match(g_prelude_enum_decls.with(m => m.get(decl)), .Some(_) => true, .None => false)
);
/// The declaration identity recorded for enum id `enum_id` (a clone).
enum_decl_identity :: (fn(enum_id : &String) -> Option(String))(
  match(g_enum_decl_identities.with(m => m.get(enum_id)), .Some(d) => Option(String).Some(d.clone()), .None => Option(String).None)
);
/// Whether two enum ids are renditions of two DIFFERENT recorded declarations.
/// An id without a recorded declaration answers `false` (no evidence).
enum_decls_differ :: (fn(a_id : &String, e_id : &String) -> bool)(
  cond(
    (a_id == e_id) => false,
    true => match(
      g_enum_decl_identities.with(m => m.get(a_id)),
      .Some(ad) => match(g_enum_decl_identities.with(m => m.get(e_id)), .Some(ed) => (ad != ed), .None => false),
      .None => false
    )
  )
);
/// Whether `t` is the prelude's `Io` struct: the effect bundle whose fields are
/// the compiler's async builtins, never called through at run time. A future
/// whose bundle is `Io` behaves the same whether or not the bundle was
/// injected, which is what lets it be viewed as a bundle-less `Future(T)`.
is_prelude_io_struct :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.Struct({ id : sid, name : sname })) => (
      (sname == "Io")
      && match(type_decl_module(sid.clone()), .Some(m) => m.ends_with("prelude.yo"), .None => false)
    ),
    _ => false
  )
);
// ---------------------------------------------------------------------------
// c_include TYPE ADOPTION — "this Yo type IS the C type `Name` in <header>".
//
// `c_include("<raylib.h>", Color : Type, …)` where `Color` ALREADY names a
// module type does not declare a new opaque type: it says the Yo struct just
// declared IS that header's C struct. The C compiler therefore already has a
// definition and a name for it, so codegen must lower the type to that plain
// name (`Color`, not `__yo_t7`) and must NOT emit a competing definition — the
// only way a C struct can cross the ABI BY VALUE.
//
// `TypeValue` has no extern-name field on a struct or enum, so this registry
// stands in, and the "Gap 3: extern-C names not modelled generally" note in
// `codegen/types/collection.yo` is what it closes.
//
// Keyed by the type's DECLARATION id (`Struct.id` / `EnumT.id`), which the
// evaluator and codegen can both read straight off the `TypeValue` without
// having to agree on a structural key (codegen's `type_key` is not reachable
// from the evaluator).
// ---------------------------------------------------------------------------
/// The C name a Yo type was adopted under, and the header that defines it.
AdoptedExternCType :: ref(struct(c_name : String, c_header : String));
(g_adopted_extern_c_types : RefCell(HashMap(String, AdoptedExternCType))) = RefCell(HashMap(String, AdoptedExternCType)).new(HashMap(String, AdoptedExternCType).new());
register_adopted_extern_c_type :: (
  fn(decl_id : &String, c_name : &String, header : &String) -> unit
)({
  if((decl_id.len() > usize(0)) && (c_name.len() > usize(0)), {
    g_adopted_extern_c_types.with_mut(m => m.insert(decl_id, AdoptedExternCType(c_name : c_name, c_header : header)));
  });
  ()
});
/// The declaration id a `c_include` adoption is keyed by, for the type kinds
/// that HAVE one. A `union(...)` carries no id and cannot be adopted.
type_decl_id :: (fn(t : &TypeValue) -> Option(String))(
  match(
    t,
    Rc(.Struct({ id : sid })) => if(sid.len() > usize(0), Option(String).Some(sid.clone()), Option(String).None),
    Rc(.EnumT({ id : eid })) => if(eid.len() > usize(0), Option(String).Some(eid.clone()), Option(String).None),
    _ => Option(String).None
  )
);
/// The C name + header this type was adopted under by a `c_include`, if any.
get_adopted_extern_c_type :: (fn(t : &TypeValue) -> Option(AdoptedExternCType))(
  match(
    type_decl_id(t),
    .Some(did) => g_adopted_extern_c_types.with(m => m.get(&did)),
    .None => Option(AdoptedExternCType).None
  )
);
// ---------------------------------------------------------------------------
// Variant-shape predicates — were in `type.yo` before Phase A.3.2; relocated
// here. These are one-line wrappers around a
// `match` on the TypeValue variant, used pervasively by callers that want a
// boolean test rather than a tag enum comparison.
// ---------------------------------------------------------------------------
is_int_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Int(_, _)) => true, _ => false)
);
is_float_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Float(_)) => true, _ => false)
);
is_signed_int_type :: (fn(t : &TypeValue) -> bool)(
  match(
    t_refine_inner(t),
    Rc(.Int(_, signed)) => signed,
    Rc(.Isize) => true,
    _ => false
  )
);
is_numeric_type :: (fn(t : &TypeValue) -> bool)(
  cond(
    is_int_type(t) => true,
    is_float_type(t) => true,
    true => match(
      t_refine_inner(t),
      Rc(.Usize) => true,
      Rc(.Isize) => true,
      Rc(.ComptimeInt) => true,
      Rc(.ComptimeFloat) => true,
      _ => false
    )
  )
);
is_pointer_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Pointer(_)) => true, _ => false)
);
is_array_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Array(_, _, _)) => true, _ => false)
);
is_function_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Func({ result : _ })) => true, _ => false)
);
is_some_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.SomeT(name : _)) => true, _ => false)
);
is_trait_type :: (fn(t : &TypeValue) -> bool)(
  match(
    t_refine_inner(t),
    Rc(.TraitT(name : _)) => true,
    Rc(.FnTraitT(base_name : _)) => true,
    Rc(.FutureTraitT(base_name : _)) => true,
    _ => false
  )
);
/// True for source-namespace structs (anonymous modules / imports).
/// There is no separate module type; the legacy name is kept for the
/// existing call sites.
is_module_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Struct({ is_source_namespace : sns })) => sns, _ => false)
);
/// True for structs EXCLUDING source-namespace
/// structs.
is_struct_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Struct({ is_source_namespace : sns })) => !sns, _ => false)
);
is_enum_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.EnumT(_, _, _, _, _, _, _, _, _, _)) => true, _ => false)
);
is_unit_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Unit) => true, _ => false)
);
is_bool_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.BoolT) => true, _ => false)
);
// ---------------------------------------------------------------------------
// Basic primitive guards
// ---------------------------------------------------------------------------
is_primitive_type :: (fn(t : &TypeValue) -> bool)(
  match(
    t_refine_inner(t),
    Rc(.Unit) => true,
    Rc(.BoolT) => true,
    Rc(.Usize) => true,
    Rc(.Isize) => true,
    Rc(.Int(_, _)) => true,
    Rc(.Float(_)) => true,
    Rc(.CChar) => true,
    Rc(.CShort) => true,
    Rc(.CUShort) => true,
    Rc(.CInt) => true,
    Rc(.CUInt) => true,
    Rc(.CLong) => true,
    Rc(.CULong) => true,
    Rc(.CLongLong) => true,
    Rc(.CULongLong) => true,
    Rc(.CLongDouble) => true,
    _ => false
  )
);
is_comptime_int_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.ComptimeInt) => true, _ => false)
);
is_comptime_float_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.ComptimeFloat) => true, _ => false)
);
is_comptime_string_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.ComptimeString) => true, _ => false)
);
is_comptime_list_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.ComptimeListT(_)) => true, _ => false)
);
is_expr_list_type :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.ComptimeListT(child)) => match(child, Rc(.ExprT) => true, _ => false),
    _ => false
  )
);
is_usize_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Usize) => true, _ => false)
);
is_isize_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Isize) => true, _ => false)
);
is_u8_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Int(bits, signed)) => ((bits == u8(8)) && !signed), _ => false)
);
is_i8_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Int(bits, signed)) => ((bits == u8(8)) && signed), _ => false)
);
is_u16_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Int(bits, signed)) => ((bits == u8(16)) && !signed), _ => false)
);
is_i16_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Int(bits, signed)) => ((bits == u8(16)) && signed), _ => false)
);
is_u32_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Int(bits, signed)) => ((bits == u8(32)) && !signed), _ => false)
);
is_i32_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Int(bits, signed)) => ((bits == u8(32)) && signed), _ => false)
);
is_u64_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Int(bits, signed)) => ((bits == u8(64)) && !signed), _ => false)
);
is_i64_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Int(bits, signed)) => ((bits == u8(64)) && signed), _ => false)
);
is_f32_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Float(bits)) => (bits == u8(32)), _ => false)
);
is_f64_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Float(bits)) => (bits == u8(64)), _ => false)
);
is_expr_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.ExprT) => true, _ => false)
);
// ---------------------------------------------------------------------------
// Compound type guards
// ---------------------------------------------------------------------------
is_tuple_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Tuple(_, _)) => true, _ => false)
);
is_union_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Union(_, _, _)) => true, _ => false)
);
/// Reference-semantics struct: `ref(struct(...))`.
is_reference_struct_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Struct({ is_reference_semantics : is_ref })) => is_ref, _ => false)
);
// Atomic reference-semantics struct: `atomic(ref(struct(...)))`, which
// requires BOTH `is_reference_semantics` AND `is_atomic_rc`. A
// value-semantics struct with `is_atomic_rc = true` is malformed but should
// not pass.
is_atomic_reference_struct_type :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.Struct({ is_reference_semantics : is_ref, is_atomic_rc : is_atomic })) =>
      (is_ref && is_atomic),
    _ => false
  )
);
/// Reference-semantics enum: `ref(enum(...))`.
is_reference_enum_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.EnumT({ is_reference_semantics : is_ref })) => is_ref, _ => false)
);
/// Atomic reference-semantics enum: `atomic(ref(enum(...)))`.
is_atomic_reference_enum_type :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.EnumT({ is_reference_semantics : is_ref, is_atomic_rc : is_atomic })) =>
      (is_ref && is_atomic),
    _ => false
  )
);
// Phase 2b : Type.Struct needs `isNewtype` flag.
is_newtype_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Struct({ is_newtype : is_nt })) => is_nt, _ => false)
);
/// True if `t` is the builtin `str` static string view (TypeValue.Str).
/// Used by `panic` / `fprintf` codegen to choose between `%s` and `%.*s`
/// format specifiers.
is_str_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Str) => true, _ => false)
);
// ---------------------------------------------------------------------------
// The prelude's shared, counted cell, by name
// ---------------------------------------------------------------------------
/// One spelling of the prelude's shared, counted cell: its type constructor
/// (`Rc`) and its value constructor (`rc`).
SharedCellNames :: struct(type_name : str, constructor : str);
derive(SharedCellNames, Copy, Clone);
/// The shared cell's CANONICAL spelling: the one the compiler synthesizes
/// itself — the cell `dyn(...)` wraps around a payload that is not an object
/// (`dyn(i32(1))` builds `rc(i32(1))`, `values/dyn.yo`). It was `Box`/`box`
/// until V1 step 1's Generation B made it `Rc`/`rc`.
shared_cell_canonical_names :: (fn() -> SharedCellNames)(
  SharedCellNames(type_name : "Rc", constructor : "rc")
);
/// The ONE list of the shared cell's spellings, canonical first; `.None` past
/// the end. Every name check on the cell reads it: the instance-name stamp
/// (`comptime_fn.yo`), `is_box_type` / `is_boxed_type` below, and the
/// `dyn(<ctor>(<closure>))` recognition (`values/dyn.yo`).
///
/// plans/VALUES_BY_DEFAULT.md §6 V1 step 1 renames `Box` to `Rc`. It is
/// seed-gated: the seed compiles `src/` against the tree's `std/`, so the
/// compiler must know both names before std or src may spell `Rc`.
/// Generation A accepted both. Generation B part 1 renamed every site and
/// made `Rc` canonical; part 2 deleted the `Box` row and the prelude
/// `Box`/`box`, so the list holds `Rc` alone. V1 step 2 reintroduces `Box` as
/// the unique, uncounted cell, a separate type with no entry here.
shared_cell_names_at :: (fn(i : usize) -> Option(SharedCellNames))(
  cond(
    (i == usize(0)) => .Some(shared_cell_canonical_names()),
    true => .None
  )
);
/// True if `name` is a type constructor name of the shared cell (`Rc`).
is_shared_cell_type_name :: (fn(name : &String) -> bool)({
  (i : usize) = usize(0);
  (found : bool) = false;
  while(!found, {
    match(
      shared_cell_names_at(i),
      .Some(n) => {
        found = (name == n.type_name);
      },
      .None => {
        break;
      }
    );
    i = (i + usize(1));
  });
  found
});
/// The type constructor name a shared-cell VALUE constructor builds (`rc` →
/// `Rc`); `.None` for any other name.
shared_cell_type_name_of_constructor :: (fn(fn_name : &String) -> Option(String))({
  (i : usize) = usize(0);
  (out : Option(String)) = .None;
  while(out.is_none(), {
    match(
      shared_cell_names_at(i),
      .Some(n) => {
        if(fn_name == n.constructor, {
          out = .Some(String.from(n.type_name));
        });
      },
      .None => {
        break;
      }
    );
    i = (i + usize(1));
  });
  out
});
/// True if `name` is a STAMPED shared-cell instance name: a type constructor
/// name from the list followed by `(` (`Rc(i32)`, `Rc(Self)`).
_is_shared_cell_instance_name :: (fn(name : &String) -> bool)({
  (i : usize) = usize(0);
  (found : bool) = false;
  while(!found, {
    match(
      shared_cell_names_at(i),
      .Some(n) => {
        head := String.from(n.type_name);
        head.push_str("(");
        found = name.starts_with(&head);
      },
      .None => {
        break;
      }
    );
    i = (i + usize(1));
  });
  found
});
/// True if `t` is the prelude's shared cell (`Rc(T)` — see
/// `shared_cell_names_at`): a single-field reference-semantics Struct whose
/// stamped name is a shared-cell instance name and whose only field is
/// labeled `*`. Used by RC and downcast codegen, and by the pattern compiler,
/// to look through the cell.
///
/// A non-atomic cell handle (`cell_handle_view`, V5's `Rc`) is one too.
is_box_type :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.Struct({ name, field_labels, is_reference_semantics : is_ref })) => cond(
      !is_ref => match(cell_handle_view(t), .Some(v) => !v.is_atomic, .None => false),
      (field_labels.len() != usize(1)) => false,
      !_is_shared_cell_instance_name(&name) => false,
      true => match(
        field_labels.get(usize(0)),
        .Some(label) => (label == "*"),
        .None => false
      )
    ),
    _ => false
  )
);
/// The payload type of the prelude's unique cell (`Box(V)`,
/// plans/VALUES_BY_DEFAULT.md §3.2, V1 step 2), or `.None` for any other
/// type. A `Box` is a newtype over a raw pointer to its payload (its one field,
/// `_cell`), so its C value IS that pointer; the comptime-fn call stamps its
/// name `Box(V)` (`evaluator/calls/comptime_fn.yo`), and a prelude name cannot
/// be shadowed, so the stamped name plus the shape identifies it. It is not a
/// shared cell: `is_box_type`/`is_boxed_type` stay `Rc`-only.
unique_box_payload_type :: (fn(t : &TypeValue) -> Option(TypeValue))(
  match(
    t_refine_inner(t),
    Rc(.Struct({ name, field_labels, field_types, is_reference_semantics : is_ref, is_newtype : is_nt })) => cond(
      (is_ref || !is_nt) => .None,
      (field_labels.len() != usize(1)) => .None,
      !name.starts_with("Box(") => .None,
      !match(field_labels.get(usize(0)), .Some(l) => (l == "_cell"), .None => false) => .None,
      true => match(field_types.get(usize(0)), .Some(Rc(.Pointer(p))) => .Some(p), _ => .None)
    ),
    _ => .None
  )
);
/// True if `t` is the prelude's unique cell `Box(V)` (`unique_box_payload_type`).
is_unique_box_type :: (fn(t : &TypeValue) -> bool)(unique_box_payload_type(t).is_some());
/// True if `t` is a cell primitive, `__yo_cell(V)` or `__yo_atomic_cell(V)`
/// (plans/VALUES_BY_DEFAULT.md §3.5). The builtin stamps its own name as the
/// type's `constructor_func_id` (`evaluate_cell_type`,
/// evaluator/types/struct.yo); no function id has that spelling, so the stamp
/// identifies the primitive. Its layout and counting are those of
/// `ref(struct((*) : V))` / `atomic(ref(struct((*) : V)))`; only its
/// constructor differs, taking the allocator.
is_cell_primitive_type :: (fn(t : &TypeValue) -> bool)(
  match(
    t_refine_inner(t),
    Rc(.Struct({ constructor_func_id : cfid, is_reference_semantics : is_ref })) => (is_ref && ((cfid == BK_YO_CELL) || (cfid == BK_YO_ATOMIC_CELL))),
    _ => false
  )
);
/// A cell handle: what V5 makes `Rc` and `Arc` (plans/VALUES_BY_DEFAULT.md
/// §3.5), a newtype whose one field `_cell` is a cell primitive
/// (`newtype(_cell : __yo_cell(V))`, `newtype(_cell : __yo_atomic_cell(V))`).
/// `cell` is the field's type, `payload` the cell's `V` (a self-shell is the
/// caller's to resolve), `is_atomic` whether the cell is the atomic one.
CellHandleView :: struct(cell : TypeValue, payload : TypeValue, is_atomic : bool);
/// The cell-handle view of `t` (`CellHandleView`), `.None` for any other
/// type. The recognition is by shape, not by name (V5 decision D1): only a
/// `pragma(Pragma.AllowUnsafe)` file can spell a cell primitive, so any
/// newtype over one is a shared, counted handle, and treating it as `Rc`
/// (`Arc` for the atomic cell) is sound. Its C value is the cell pointer: a
/// newtype lowers to its field.
cell_handle_view :: (fn(t : &TypeValue) -> Option(CellHandleView))(
  match(
    t_refine_inner(t),
    Rc(.Struct({ field_labels, field_types, is_reference_semantics : is_ref, is_newtype : is_nt })) => cond(
      (is_ref || !is_nt) => .None,
      (field_labels.len() != usize(1)) => .None,
      !match(field_labels.get(usize(0)), .Some(l) => (l == "_cell"), .None => false) => .None,
      true => match(
        field_types.get(usize(0)),
        .Some(cell) => cond(
          !is_cell_primitive_type(&cell) => .None,
          true => match(
            t_refine_inner(&cell),
            Rc(.Struct({ field_types : cell_fts, is_atomic_rc : cell_atomic })) => match(
              cell_fts.get(usize(0)),
              .Some(p) => .Some(CellHandleView(cell : cell, payload : p, is_atomic : cell_atomic)),
              .None => .None
            ),
            _ => .None
          )
        ),
        .None => .None
      )
    ),
    _ => .None
  )
);
/// A handle a place reaches its storage through: a `ref` object, an atomic
/// object or a cell handle (`cell_handle_view`). The question the borrow
/// pins, the future-lend and global-lend checks and the borrow asserts ask.
is_counted_handle_type :: (fn(t : &TypeValue) -> bool)(
  is_reference_struct_type(t) || is_atomic_reference_struct_type(t) || cell_handle_view(t).is_some()
);
/// A handle whose count other threads update: an atomic object, or a cell
/// handle over the atomic cell (V5's `Arc`). D3 names such a handle, and its
/// borrow counter is read atomically.
is_atomic_counted_handle_type :: (fn(t : &TypeValue) -> bool)(
  is_atomic_reference_struct_type(t) || match(cell_handle_view(t), .Some(v) => v.is_atomic, .None => false)
);
is_fn_trait_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.FnTraitT(base_name : _)) => true, _ => false)
);
is_function_type_and_is_type_function :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.Func({ result : r })) => match(r, Rc(.TypeUni(_)) => true, _ => false),
    _ => false
  )
);
// Phase 2b: Func return type needs `isUnquote` flag.
is_function_type_and_is_macro_function :: (fn(t : &TypeValue) -> bool)(false);
/// Check if a TypeValue is comptime-only (never a runtime type).
///
/// The tag-level subset that returns definitively
/// `true` for comptime-only types. Primitives like `i32`, `bool`, and `unit` are
/// NOT comptime-only because they also implement runtime.
is_comptime_only_type_simple :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.ComptimeInt) => true,
    Rc(.ComptimeFloat) => true,
    Rc(.ComptimeString) => true,
    Rc(.TypeUni(_)) => true,
    // Source-namespace structs (anonymous modules / imports) are
    // comptime-only; ordinary structs are not.
    Rc(.Struct({ is_source_namespace : sns2 })) => sns2,
    Rc(.TraitT(name : _)) => true,
    Rc(.FnTraitT(base_name : _)) => true,
    Rc(.FutureTraitT(base_name : _)) => true,
    Rc(.ExprT) => true,
    Rc(.ComptimeListT(_)) => true,
    _ => false
  )
);
/// True if `t` is a function type whose return type is comptime-only.
///
///
is_function_type_and_returns_comptime_value :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    // Reads the RETURN SPEC FLAG (`FuncMeta.result_is_comptime_only`),
    // not a property of the result type: `-> comptime(unit)` has a plain unit
    // result type with the comptime-ness carried in the meta flag. The
    // type-based test alone made every "runtime binding in a comptime-only
    // fn body" gate silently never fire (tests/fn.test.yo).
    Rc(.Func({ result : r, meta : __gm })) => (__gm.*.result_is_comptime_only || is_comptime_only_type_simple(&r)),
    _ => false
  )
);
// ---------------------------------------------------------------------------
// Type universe guards
// ---------------------------------------------------------------------------
/// The `Type`, `Type(1)`, … universe.
is_type_hierarchy_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.TypeUni(_)) => true, _ => false)
);
is_type_0 :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.TypeUni(level)) => (level == usize(0)), _ => false)
);
// ---------------------------------------------------------------------------
// Pointer / reference / dyn guards
// ---------------------------------------------------------------------------
/// True for an RC handle whose reference count other threads update
/// atomically: an atomic reference struct or an atomic reference enum — the
/// cases `drop_dup.yo` lowers to
/// `__yo_incr_rc_atomic` / `__yo_decr_rc_atomic`. Every READ of that count
/// (`ref_count(x)`) must be an atomic load too, or it races the atomic RC ops
/// (issues/fixed/rc-of-an-iso-or-atomic-enum-handle-is-a-plain-load.md).
is_atomically_counted_rc_type :: (fn(t : &TypeValue) -> bool)(
  is_atomic_reference_struct_type(t) || is_atomic_reference_enum_type(t)
);
is_dyn_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.DynT(required_trait_types : _)) => true, _ => false)
);
is_type_application_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.TypeAppT(constructor : _)) => true, _ => false)
);
// ---------------------------------------------------------------------------
// Numeric type guards (extended versions)
// ---------------------------------------------------------------------------
/// True for all integer types, including pointer-sized integers.
///
/// This is intentionally broader than `is_int_type` in type.yo, which only
/// checks the fixed-width `Int(bits, signed)` variant.
is_integer_type :: (fn(t : &TypeValue) -> bool)(
  cond(
    is_int_type(t) => true,
    true => match(
      t_refine_inner(t),
      Rc(.Usize) => true,
      Rc(.Isize) => true,
      _ => false
    )
  )
);
is_unsigned_integer_type :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.Int(_, signed)) => !signed,
    Rc(.Usize) => true,
    _ => false
  )
);
// ---------------------------------------------------------------------------
// C-compatible type guards
// ---------------------------------------------------------------------------
is_char_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.CChar) => true, _ => false)
);
is_short_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.CShort) => true, _ => false)
);
is_u_short_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.CUShort) => true, _ => false)
);
is_c_int_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.CInt) => true, _ => false)
);
is_c_uint_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.CUInt) => true, _ => false)
);
is_long_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.CLong) => true, _ => false)
);
is_u_long_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.CULong) => true, _ => false)
);
is_long_long_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.CLongLong) => true, _ => false)
);
is_u_long_long_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.CULongLong) => true, _ => false)
);
is_long_double_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.CLongDouble) => true, _ => false)
);
is_void_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Void) => true, _ => false)
);
/// The bottom type `never` (plans/TYPE_SYSTEM_SOUNDNESS.md Phase 3.6).
is_never_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.Never) => true, _ => false)
);
is_future_trait_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.FutureTraitT(base_name : _)) => true, _ => false)
);
/// `true` when `t` is a `Concrete(T)` trait type (its `is_concrete` marker is
/// `.Some`). The `TraitT` variant carries `is_concrete :
/// Option(Rc(Self))`; this was a `=> false` stub until the async-Future type
/// plumbing (Phase 5) needed it (`is_io_future_type`).
is_concrete_trait_type :: (fn(t : &TypeValue) -> bool)(
  match(t_refine_inner(t), Rc(.TraitT({ is_concrete })) => is_concrete.is_some(), _ => false)
);
/// Return `true` if `t` itself is an RC-managed type (not recursively).
///
/// An RC type is:
///   - A `ref(struct(...))` struct (`is_reference_semantics = true`)
///   - A `ref(enum(...))` enum (`is_reference_semantics = true`)
///   - A `DynT` trait-object (always heap-allocated)
///   - A `SomeT` that has a Future trait constraint (Futures are always RC)
///
///
is_rc_type :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    // Resolve a leaked recursive SELF-SHELL before reading the flag: shells
    // lose `is_reference_semantics`, so a shell of a ref(enum)/ref(struct)
    // (e.g. EvalValue during its own definition) read as NON-RC here — the
    // dup-on-store predicate then skipped the element retain when
    // specializing ArrayList(EvalValue).push, producing a push that stores
    // WITHOUT +1 (the stage-2 t1.yo rc=138 UAF: impl method registry read a
    // method value freed by the pusher's scope-end drop). Same shell-resolve
    // pattern as type_key / eval-match
    // (issues/fixed/yo-self-codegen-recursive-enum-self-shell.md).
    Rc(.Struct({ is_reference_semantics : is_ref })) => match(
      resolve_struct_shell(t),
      Rc(.Struct({ is_reference_semantics : r_res })) => r_res,
      _ => is_ref
    ),
    // Reference-semantics enums (`ref(enum(…))`) are RC-managed like objects.
    Rc(.EnumT({ is_reference_semantics : is_ref })) => match(
      resolve_enum_shell(t),
      Rc(.EnumT({ is_reference_semantics : r_res })) => r_res,
      _ => is_ref
    ),
    Rc(.DynT(required_trait_types : _)) => true,
    Rc(.SomeT(required_trait_types : req_traits)) => {
      // Check if any required trait is a Future trait
      (found : bool) = false;
      (i : usize) = usize(0);
      while((i < req_traits.len()) && !found, {
        match(
          req_traits.get(i),
          .Some(tr) => {
            if(is_future_trait_type(&tr), {
              found = true;
            });
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    _ => false
  )
);
is_c_compatible_type :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.CChar) => true,
    Rc(.CShort) => true,
    Rc(.CUShort) => true,
    Rc(.CInt) => true,
    Rc(.CUInt) => true,
    Rc(.CLong) => true,
    Rc(.CULong) => true,
    Rc(.CLongLong) => true,
    Rc(.CULongLong) => true,
    Rc(.CLongDouble) => true,
    _ => false
  )
);
// ---------------------------------------------------------------------------
// Function genericity guards
// ---------------------------------------------------------------------------
/// Check if a function type has generic parameters requiring specialization:
/// detects generic parameters and implicit (using/effect) parameters from the
/// TypeValue.Func variant fields.
///
/// Helper for the SomeType-parameter
/// exemption in BOTH generic guards: true iff the
/// SomeT's required traits contain a `FutureTraitT`. A future-typed parameter
/// (`task : Impl(Future(T, E))`) is NOT generic for codegen — it lowers to the
/// generic future-trait struct pointer, and the call site casts the concrete
/// state-machine future to it. Kept local so this foundational module does not
/// import the evaluator's trait_checking.
_some_type_implements_future :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.SomeT({ required_trait_types : sf_rtts })) => {
      (sf_found : bool) = false;
      (sf_i : usize) = usize(0);
      while((sf_i < sf_rtts.len()) && !sf_found, {
        match(
          sf_rtts.get(sf_i),
          .Some(sf_rt) => if(is_future_trait_type(&sf_rt), {
            sf_found = true;
          }),
          .None => ()
        );
        sf_i = (sf_i + usize(1));
      });
      sf_found
    },
    _ => false
  )
);
is_function_type_generic :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.Func({ param_types : pts, meta : __fm1 })) =>
      cond(
        (__fm1.*.forall_labels.len() > usize(0)) => true,
        (__fm1.*.implicit_labels.len() > usize(0)) => true,
        // Check if any param is SomeT; Future-implementing SomeTs are exempt.
        true => {
          found := false;
          i := usize(0);
          n := pts.len();
          while(i < n, {
            match(
              pts.get(i),
              .Some(pt) => match(
                pt,
                // Future-implementing SomeT params are exempt.
                Rc(.SomeT(name : _)) => if(!_some_type_implements_future(&pt), {
                  found = true;
                }),
                _ => ()
              ),
              .None => ()
            );
            if(found, {
              break;
            });
            i = (i + usize(1));
          });
          found
        }
      ),
    _ => false
  )
);
/// Check if a function type has "hard" generic parameters that make the
/// unspecialized form invalid for C codegen: generic parameters and SomeType
/// parameters without a resolved concrete type.
is_function_type_hard_generic :: (fn(t : &TypeValue) -> bool)(
  match(
    t,
    Rc(.Func({ param_types : pts, meta : __fm2 })) =>
      cond(
        (__fm2.*.forall_labels.len() > usize(0)) => true,
        // A SomeType param makes the unspecialized form hard-generic — UNLESS it
        // has a resolved concrete type, in which case codegen can lower it via the
        // concrete (e.g. a closure-typed param `cb : Impl(Fn(...))` resolved to its
        // capture struct).
        true => {
          found := false;
          i := usize(0);
          n := pts.len();
          while(i < n, {
            match(
              pts.get(i),
              .Some(pt) => match(
                pt,
                Rc(.SomeT({ resolution : hg_res })) => {
                  // Future-implementing SomeT params are exempt:
                  // they
                  // lower to the future-trait struct pointer, so the
                  // unspecialized form IS valid C. A resolution travels on
                  // the value (`SomeT.resolution`, Phase 3 step 7 part 2) —
                  // the id-keyed registry this once consulted is retired.
                  if(!_some_type_implements_future(&pt) && hg_res.is_none(), {
                    found = true;
                  });
                },
                // A `comptime(K) : Type` param (the type UNIVERSE) can never
                // be a runtime C parameter — the prototype renders
                // `// Unknown type: Type K` ("invalid storage class
                // specifier", the imm_map/imm_set family).
                Rc(.TypeUni(_)) => {
                  found = true;
                },
                // An Array with an UNRESOLVED length variable
                // (`Array(i32, n)` — value-generic length) has no valid C
                // rendering either: the prototype printed
                // `// Unknown type: Array(i32, n)` and ate the line
                // (array.test batch clang errors). Same hard-generic
                // classification as the comptime `Type` param above.
                Rc(.Array(_, _, hg_lvar)) => if(hg_lvar.len() > usize(0), {
                  found = true;
                }),
                _ => ()
              ),
              .None => ()
            );
            if(found, {
              break;
            });
            i = (i + usize(1));
          });
          found
        }
      ),
    _ => false
  )
);
// Phase 2b: requires FunctionValue with `specializedFunctionCaches` field.
is_function_specializable :: (fn(t : &TypeValue) -> bool)(false);
// ---------------------------------------------------------------------------
// Rc / effects-row guards
// ---------------------------------------------------------------------------
//: a reference-semantics
// struct with exactly one field labeled `*` whose typeName is a shared-cell
// instance name (`Rc(T)`: `shared_cell_names_at`), or an `Arc` of a
// non-object.
///
/// A cell handle (`cell_handle_view`) is a box by the same rule: a
/// non-atomic one always, an atomic one unless its payload is an object (a
/// `ref` struct, or another cell handle). An atomic `ref` enum is no object
/// here, as for `Arc`: `dyn(arc(e))` into a `Send` `Dyn` boxes it.
is_boxed_type :: (fn(t : &TypeValue) -> bool)(
  match(
    cell_handle_view(t),
    .Some(v) => (!v.is_atomic || !(is_reference_struct_type(&v.payload) || cell_handle_view(&v.payload).is_some())),
    .None => _is_boxed_cell_object_type(t)
  )
);
_is_boxed_cell_object_type :: (fn(t : &TypeValue) -> bool)(
  if(
    !is_reference_struct_type(t),
    false,
    match(
      t,
      Rc(.Struct({ name, field_labels, field_types })) =>
        (
          (field_labels.len() == usize(1)) && match(field_labels.get(usize(0)), .Some(l) => (l == "*"), .None => false) && (
            _is_shared_cell_instance_name(&name)
            // A value boxed ATOMICALLY for a `Dyn(..., Send)` (`dyn(...)` boxes
            // with `arc` there; issues/fixed/a-send-dyn-shares-a-non-atomic-box-across-threads.md).
            // An Arc of an OBJECT is an object in its own right, not a box.
            || (name.starts_with("Arc(") && !match(field_types.get(usize(0)), .Some(ft) => is_reference_struct_type(&ft), .None => false))
          )
        ),
      _ => false
    )
  )
);
// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------
/// A field type whose C value is a pointer that is never NULL: a raw pointer
/// or a non-atomic reference handle. Atomic handles (`atomic(ref(...))`) keep
/// the tagged layout.
_is_nullable_payload_type :: (fn(t : &TypeValue) -> bool)(
  cond(
    is_pointer_type(t) => true,
    // A `Box` is a C-transparent newtype over its never-NULL cell pointer
    // (§3.2: `Option(Box(T))` keeps the one-pointer niche).
    is_unique_box_type(t) => true,
    // So is a cell handle (`cell_handle_view`) over its cell: the non-atomic
    // one folds as a `ref` object does, the atomic one stays tagged as an
    // atomic object does. Only cell handles: another newtype over a pointer
    // keeps its tagged layout.
    cell_handle_view(t).is_some() => !is_atomic_counted_handle_type(t),
    is_atomic_reference_struct_type(t) => false,
    is_atomic_reference_enum_type(t) => false,
    is_reference_struct_type(t) => true,
    is_reference_enum_type(t) => true,
    true => false
  )
);
/// The payload of an enum with the nullable-pointer SHAPE, `.None` for any
/// other enum. The shape is exactly two variants: one fieldless and one
/// carrying a single field that is a raw pointer or a (non-atomic)
/// reference-semantics handle: `ref(struct)` /
/// `ref(enum)` objects are heap pointers that are never NULL, so `Option(T)`
/// of one (`String` is `Option(ArrayList(u8))`) is the bare handle with NULL
/// as `.None` — 8 B instead of a 16 B tagged payload
/// (plans/EVALUATOR_MEMORY_REDUCTION.md Phase 3).
/// Codegen lowers such an enum to the bare pointer (NULL = the empty variant),
/// and the size/alignment model (`types/utils.yo`) must agree, so the rule
/// lives here, where both can reach it.
/// Only a VALUE enum folds. A `ref(enum)` is itself a heap object behind a
/// handle; folding it into its payload's pointer made a `Self` payload
/// (`ref(enum(Leaf, Node(elem : Self)))`) emit `typedef T* T` — an unknown C
/// type (issues/fixed/derived-eq-ref-enum-self-payload-hollow-at-runtime.md).
/// `can_optimize_as_nullable_pointer` adds the self-shell resolution and the
/// self-reference refusal on top.
_nullable_shape_payload :: (fn(t : &TypeValue) -> Option(TypeValue))(
  match(
    t,
    Rc(.EnumT({ variant_fields, is_reference_semantics })) => {
      if(is_reference_semantics || (variant_fields.len() != usize(2)), {
        return(.None);
      });
      (empty_found : bool) = false;
      (pointer_type : Option(TypeValue)) = .None;
      (valid : bool) = true;
      (vi : usize) = usize(0);
      while(valid && (vi < usize(2)), {
        fields := match(variant_fields.get(vi), .Some(f) => f, .None => no_types());
        fc := fields.len();
        cond(
          (fc == usize(0)) => {
            if(empty_found, {
              valid = false;
            }, {
              empty_found = true;
            });
          },
          (fc == usize(1)) => {
            child := match(fields.get(usize(0)), .Some(c) => c, .None => return(.None));
            cond(
              _is_nullable_payload_type(&child) => {
                match(
                  pointer_type,
                  .Some(_) => {
                    valid = false;
                  },
                  .None => {
                    pointer_type = .Some(child);
                  }
                );
              },
              true => {
                valid = false;
              }
            );
          },
          true => {
            valid = false;
          }
        );
        vi = (vi + usize(1));
      });
      cond(
        (valid && empty_found) => pointer_type,
        true => Option(TypeValue).None
      )
    },
    _ => Option(TypeValue).None
  )
);
/// The id an enum's finalized form and its `__self_shell` share.
_enum_identity :: (fn(id : &String) -> String)(id.replace(String.from("__self_shell"), String.from("")));
/// True when the C pointer `payload` lowers to leads back to the enum
/// `enum_id` through pointers, `Box`es and other nullable-shaped enums alone,
/// so folding the enum into that pointer would make its C type its own
/// pointee: `enum(Leaf, Node(b : Box(Self)))` emitted `typedef B* B` for the
/// `Box(Self)` typedef. A struct or a tagged enum on the way breaks the chain:
/// it has a forward declaration the pointer can name.
///
/// `hops` bounds the walk. A chain that enters a cycle of OTHER enums never
/// reaches `enum_id`, so stopping there with `false` is the exact answer; a
/// chain that does reach it does so within one lap. 32 nested pointer hops is
/// far past any real type, and the bound keeps this allocation-free (it runs
/// on every nullable-shape query codegen makes).
_nullable_payload_reaches_enum :: (fn(payload : &TypeValue, enum_id : &String, hops : usize) -> bool)({
  if(hops == usize(0), {
    return(false);
  });
  pointee := match(
    unique_box_payload_type(payload),
    .Some(v) => Option(TypeValue).Some(v),
    .None => match(t_refine_inner(payload), Rc(.Pointer(p)) => Option(TypeValue).Some(p), _ => Option(TypeValue).None)
  );
  match(
    pointee,
    .None => false,
    .Some(pe) => {
      target := resolve_enum_shell(&pe);
      cond(
        (is_pointer_type(&target) || is_unique_box_type(&target)) => recur(&target, enum_id, hops - usize(1)),
        true => match(
          target,
          Rc(.EnumT({ id })) => cond(
            (_enum_identity(&id) == enum_id) => true,
            true => match(_nullable_shape_payload(&target), .Some(inner) => recur(&inner, enum_id, hops - usize(1)), .None => false)
          ),
          _ => false
        )
      )
    }
  )
});
/// Check if an enum can be optimized as a nullable pointer: the pointer
/// variant's field type if so, `.None` otherwise (the shape is
/// `_nullable_shape_payload`).
///
/// A recursive enum's `Self` inside its own payload is a fieldless SELF-SHELL
/// (`resolve_enum_shell`), and every type built from it (`ArrayList(Self)`'s
/// `_ptr`, the `Option(T)` its `get` returns) carries that shell. The shell
/// is judged by its finalized form: judged by its own empty variant list it
/// kept the tagged layout, so `get_type_string` named the final's
/// nullable-pointer typedef, which is emitted after every struct and union
/// (`unknown type name`,
/// issues/fixed/derive-clone-on-a-recursive-enum-over-an-arraylist-of-self-emits-invalid-c.md).
///
/// An enum whose payload pointer leads back to the enum itself keeps the
/// tagged layout (`_nullable_payload_reaches_enum`).
can_optimize_as_nullable_pointer :: (fn(t_in : &TypeValue) -> Option(TypeValue))({
  t := resolve_enum_shell(t_in);
  match(
    _nullable_shape_payload(&t),
    .Some(payload) => {
      self_id := match(t, Rc(.EnumT({ id })) => _enum_identity(&id), _ => String.from(""));
      cond(
        ((self_id.len() > usize(0)) && _nullable_payload_reaches_enum(&payload, &self_id, usize(32))) => Option(TypeValue).None,
        true => Option(TypeValue).Some(payload)
      )
    },
    .None => Option(TypeValue).None
  )
});

export(
  can_optimize_as_nullable_pointer,
  // Variant-shape predicates (relocated from type.yo in Phase A.3.2)
  is_int_type,
  is_float_type,
  is_signed_int_type,
  is_numeric_type,
  is_pointer_type,
  is_array_type,
  is_function_type,
  is_trait_type,
  is_module_type,
  is_some_type,
  is_struct_type,
  is_enum_type,
  is_unit_type,
  is_bool_type,
  // Primitive guards
  is_primitive_type,
  is_comptime_int_type,
  is_comptime_float_type,
  is_comptime_string_type,
  is_comptime_list_type,
  is_expr_list_type,
  is_usize_type,
  is_isize_type,
  is_u8_type,
  is_i8_type,
  is_u16_type,
  is_i16_type,
  is_u32_type,
  is_i32_type,
  is_u64_type,
  is_i64_type,
  is_f32_type,
  is_f64_type,
  is_expr_type,
  // Compound type guards
  is_tuple_type,
  is_union_type,
  is_reference_struct_type,
  is_atomic_reference_struct_type,
  is_reference_enum_type,
  is_atomic_reference_enum_type,
  is_atomically_counted_rc_type,
  is_newtype_type,
  is_str_type,
  is_box_type,
  is_cell_primitive_type,
  CellHandleView,
  cell_handle_view,
  is_counted_handle_type,
  is_atomic_counted_handle_type,
  unique_box_payload_type,
  is_unique_box_type,
  SharedCellNames,
  shared_cell_names_at,
  is_shared_cell_type_name,
  shared_cell_type_name_of_constructor,
  shared_cell_canonical_names,
  is_fn_trait_type,
  is_function_type_and_is_type_function,
  is_function_type_and_is_macro_function,
  is_comptime_only_type_simple,
  is_function_type_and_returns_comptime_value,
  // Type universe guards
  is_type_hierarchy_type,
  is_type_0,
  // Pointer / reference guards
  is_dyn_type,
  is_type_application_type,
  is_rc_type,
  // Numeric extended guards
  is_integer_type,
  is_unsigned_integer_type,
  // C-compatible guards
  is_char_type,
  is_short_type,
  is_u_short_type,
  is_c_int_type,
  is_c_uint_type,
  is_long_type,
  is_u_long_type,
  is_long_long_type,
  is_u_long_long_type,
  is_long_double_type,
  is_void_type,
  is_never_type,
  is_future_trait_type,
  is_concrete_trait_type,
  is_c_compatible_type,
  // Function genericity guards
  is_function_type_generic,
  is_function_type_hard_generic,
  register_type_decl_module,
  register_enum_decl_identity,
  register_prelude_enum_decl,
  is_prelude_enum_decl,
  enum_decl_identity,
  enum_decls_differ,
  type_decl_module,
  is_prelude_io_struct,
  AdoptedExternCType,
  register_adopted_extern_c_type,
