//! The dependency CLI over `yo.toml`
//! (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.11):
//!
//!   yo add <spec> [--dev] [--path <subdir>] [--name <n>] [--branch <b>] [--rev <sha>]
//!   yo remove <name>
//!   yo install
//!   yo update [name…]
//!
//! `add` edits the manifest in place through `toml_edit.yo` (comments kept),
//! then resolves and fetches like `install`. `install` and `update` run the
//! resolver (`src/resolver.yo`): every git package's ref is decided against
//! EVERY requirement on it across the dependency graph, the trees are
//! fetched into the global cache, and `yo.lock` v2 is written. `--locked`
//! fails instead of changing the lock; `--offline` fails instead of touching
//! the network; `yo update --latest` also bumps each `version` range in
//! `yo.toml` to the newest release.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ env } :: import("std/env");
{ cwd } :: import("std/env");
{ Path } :: import("std/path");
{ Exception, IoExn } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ exists, read_to_string, write_string } :: import("std/fs/file");
{ LockFile } :: import("./lock_file.yo");
{
  Manifest,
  DependencySource,
  GitRequirement,
  MANIFEST_FILENAME,
  find_manifest,
  load_manifest
} :: import("./manifest.yo");
{
  parse_semver,
  parse_version_req,
  version_req_matches,
  latest_release,
  semver_tags_from_ls_remote,
  ls_remote_tags,
  resolve_default_branch,
  resolve_latest_tag,
  ResolveMode,
  ResolveOptions,
  resolve_and_fetch
} :: import("./resolver.yo");
{ set_entry, remove_entry, toml_string } :: import("./toml_edit.yo");
// ---------------------------------------------------------------------------
// Package specifiers (`yo add <spec>`)
// ---------------------------------------------------------------------------
/// What `yo add` was given. `Git.requirement` is `.None` when the spec had no
/// `@…` — the latest release tag is looked up.
ParsedPackage :: enum(
  Git(name : String, url : String, requirement : Option(GitRequirement)),
  Path(name : String, rel_path : String)
);
/// Return `true` if `spec` looks like a local file-system path.
is_local_path :: (fn(spec : String) -> bool)(
  (spec == ".") || ((spec == "..") || (spec.starts_with(String.from("./")) || (spec.starts_with(String.from("../")) || spec.starts_with(String.from("/")))))
);
/// The last path component of a URL or path, stripped of `.git` and of a
/// trailing `/`.
_url_to_dep_name :: (fn(url : String) -> String)({
  s := url.clone();
  if(s.ends_with("/"), {
    s = s.substring(usize(0), s.len() - usize(1));
  });
  s2 := if(s.ends_with(String.from(".git")), s.substring(usize(0), s.len() - usize(4)), s);
  after_slash := match(
    s2.last_index_of(String.from("/")),
    .None => s2,
    .Some(idx) => s2.substring(idx + usize(1), s2.len())
  );
  // `git@host:user/repo` — the name is after the last `/`, or after `:`.
  match(
    after_slash.last_index_of(String.from(":")),
    .None => after_slash,
    .Some(idx) => after_slash.substring(idx + usize(1), after_slash.len())
  )
});
/// `@…` suffix → requirement. A `v`-prefixed full version is an exact tag;
/// anything else must parse as a range (`^1.2`, `~1`, `1.2.3`, `>=1, <2`,
/// `*`). Branches and commits are flags (`--branch`, `--rev`), not `@`.
_requirement_from_suffix :: (fn(suffix : String) -> Result(GitRequirement, String))({
  if((suffix.starts_with("v") || suffix.starts_with("V")) && parse_semver(suffix.clone()).is_some(), {
    return(Result(GitRequirement, String).Ok(GitRequirement.Tag(suffix)));
  });
  match(
    parse_version_req(suffix.clone()),
    .Ok(_) => Result(GitRequirement, String).Ok(GitRequirement.Version(suffix)),
    .Err(msg) => Result(GitRequirement, String).Err(`"${suffix}" is neither a tag (v1.2.3) nor a version requirement (^1.2, ~1, >=1, <2, *): ${msg}. Use --branch or --rev for other refs.`)
  )
});
/// Parse a package specifier.
///
/// Accepted forms:
/// - `./path` / `../path` / `/abs/path`   → `ParsedPackage.Path`
/// - `user/repo`                          → GitHub shorthand
/// - `github.com/user/repo`               → GitHub with explicit host
/// - `https://host/path[.git]`            → any https/http remote
/// - `git@host:path[.git]`, `ssh://…`     → ssh remotes, as written
/// each optionally followed by `@<tag or range>`.
parse_package_specifier :: (fn(spec : String) -> Result(ParsedPackage, String))({
  spec_str := spec.clone();
  if(is_local_path(spec_str), {
    name := _url_to_dep_name(spec_str);
    return(Result(ParsedPackage, String).Ok(ParsedPackage.Path(name, spec)));
  });
  // The requirement is after the LAST `@` — but only when what follows it
  // is not part of the remote (`git@github.com:user/repo` has no suffix).
  (url_part : String) = spec.clone();
  (suffix : Option(String)) = Option(String).None;
  match(
    spec.last_index_of(String.from("@")),
    .None => (),
    .Some(idx) => {
      after := spec.substring(idx + usize(1), spec.len());
      if((idx > usize(0)) && !(after.contains("/") || (after.contains(":") || (after.len() == usize(0)))), {
        url_part = spec.substring(usize(0), idx);
        suffix = Option(String).Some(after);
      });
    }
  );
  url := cond(
    (url_part.starts_with(String.from("https://")) || (url_part.starts_with(String.from("http://")) || (url_part.starts_with(String.from("ssh://")) || (url_part.starts_with(String.from("git@")) || url_part.starts_with(String.from("file://")))))) => url_part.clone(),
    url_part.starts_with(String.from("github.com/")) => String.from("https://").concat(url_part.clone()),
    true => {
      // Exactly two parts ("user/repo") → GitHub shorthand
      slash_parts := url_part.split(String.from("/"));
      if((slash_parts.len() == usize(2)) && ((slash_parts(usize(0)).len() > usize(0)) && (slash_parts(usize(1)).len() > usize(0))), String.from("https://github.com/").concat(url_part.clone()), {
        return(
          Result(ParsedPackage, String).Err(
            `Invalid package specifier: "${spec}". Use 'user/repo', 'github.com/user/repo', a full URL, or a local path.`
          )
        );
      })
    }
  );
  requirement := match(
    suffix,
    .None => Option(GitRequirement).None,
    .Some(s) => match(
      _requirement_from_suffix(s),
      .Ok(r) => Option(GitRequirement).Some(r),
      .Err(msg) => {
        return(Result(ParsedPackage, String).Err(msg));
      }
    )
  );
  name := _url_to_dep_name(url.clone());
  Result(ParsedPackage, String).Ok(ParsedPackage.Git(name, url, requirement))
});
// ---------------------------------------------------------------------------
// The project
// ---------------------------------------------------------------------------
/// The user's working directory. `yo-cli` records it in `YO_ORIGINAL_CWD`
/// before it changes directory, so that is the authority when present.
_user_cwd :: (fn() -> String)(
  match(
    env.get(String.from("YO_ORIGINAL_CWD")),
    .Some(d) => d,
    .None => match(cwd(), .Ok(p) => p.to_string(), .Err(_) => String.from("."))
  )
);
/// The manifest governing the user's cwd (the nearest `yo.toml` at or above
/// it), loaded. An error when there is none or it does not parse.
load_project_manifest :: (fn(exn : Exception) -> Manifest)({
  start := _user_cwd();
  path := match(
    find_manifest(start.clone()),
    .Some(p) => p,
    .None => {
      exn.throw(dyn(`Error: no ${MANIFEST_FILENAME} found in ${start} or any directory above it. Run 'yo init' to create a project.`));
      String.new()
    }
  );
  match(
    load_manifest(path, exn),
    .Ok(m) => m,
    .Err(msg) => {
      exn.throw(dyn(`Error: ${msg}`));
      // unreachable — the throw unwinds
      load_manifest(String.new(), exn).unwrap()
    }
  )
});
/// The `{ git = …, version = … }` / `{ path = … }` text `yo add` writes.
dependency_value_text :: (fn(source : DependencySource) -> String)(
  match(
    source,
    .Path(p) => `{ path = ${toml_string(p)} }`,
    .Git(url, req, subdir) => {
      pin := match(
        req,
        .DefaultBranch => String.new(),
        .Version(v) => `, version = ${toml_string(v)}`,
        .Tag(t) => `, tag = ${toml_string(t)}`,
        .Branch(b) => `, branch = ${toml_string(b)}`,
        .Rev(r) => `, rev = ${toml_string(r)}`
      );
      sub := if(subdir.len() > usize(0), `, path = ${toml_string(subdir)}`, String.new());
      `{ git = ${toml_string(url)}${pin}${sub} }`
    }
  )
);
// ---------------------------------------------------------------------------
// Resolution + fetch
// ---------------------------------------------------------------------------
/// Resolve the manifest's dependency graph and fetch it (the resolver's
/// `resolve_and_fetch`), then print where each package lives. `mode` is what
/// `yo update` asked for (`Install` keeps every satisfying lock entry).
install_dependencies :: (
  fn(
    manifest : Manifest,
    mode : ResolveMode,
    locked : bool,
    offline : bool,
    verbose : bool,
    io : Io,
    exn : Exception
  ) -> Impl(Future(LockFile, IoExn))
)(
  io.async((e : IoExn) => {
    options := ResolveOptions(mode : mode, locked : locked, offline : offline, verbose : verbose);
    lock := e.io.await(resolve_and_fetch(manifest, options, e.io, e.exn), e);
    (i : usize) = usize(0);
    while(i < lock.packages.len(), {
      p := lock.packages(i);
      where_ := cond(
        p.is_git() => `${p.ref()} (${p.commit.substring(usize(0), usize(12))})`,
        true => p.path()
      );
      println(`  ${p.name} → ${where_}`);
      i = (i + usize(1));
    });
    lock
  })
);
// ---------------------------------------------------------------------------
// yo add
// ---------------------------------------------------------------------------
/// Options for `run_add`.
AddOptions :: ref(
  struct(
    package_spec : String,
    /// Write to `[dev-dependencies]`.
    dev : bool,
    /// The package's directory inside the repository (`{ path = … }` on a git
    /// dependency).
    subdir : Option(String),
    /// Import name override (default: the repository / directory name).
    name : Option(String),
    branch : Option(String),
    rev : Option(String),
    verbose : bool
  )
);
/// `yo add <spec>`: add one dependency to `yo.toml` (in place), then resolve
/// and fetch every git dependency and write `yo.lock`.
run_add :: (
  fn(
    options : AddOptions,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    manifest := load_project_manifest(e.exn);
    parsed := match(
      parse_package_specifier(options.package_spec.clone()),
      .Err(msg) => {
        e.exn.throw(dyn(`Error: ${msg}`));
        ParsedPackage.Path(String.new(), String.new())
      },
      .Ok(p) => p
    );
    if(options.branch.is_some() && options.rev.is_some(), {
      e.exn.throw(dyn(String.from("Error: --branch and --rev cannot be combined")));
    });
    // Plain locals for the async body's awaits (each await is a top-level
    // statement below).
    (dep_name : String) = String.new();
    (source : Option(DependencySource)) = Option(DependencySource).None;
    (needs_latest : bool) = false;
    (is_path : bool) = false;
    (git_url : String) = String.new();
    (git_subdir : String) = String.new();
    // One match on `parsed` (see install_dependencies).
    match(
      parsed,
      .Path(p_name, p_rel_path) => {
        is_path = true;
        if(options.branch.is_some() || (options.rev.is_some() || options.subdir.is_some()), {
          e.exn.throw(dyn(String.from("Error: --branch, --rev and --path apply to git dependencies only")));
        });
        dep_name = match(options.name, .Some(n) => n, .None => p_name);
        // Stored relative to the manifest's directory, however it was typed.
        abs := if(
          Path.new(p_rel_path.clone()).is_absolute(),
          Path.new(p_rel_path.clone()).normalize(),
          Path.new(_user_cwd()).join(Path.new(p_rel_path.clone())).normalize()
        );
        rel := abs.relative_to(Path.new(manifest.dir.clone())).to_string();
        stored := if(rel.len() == usize(0), String.from("."), rel);
        source = Option(DependencySource).Some(DependencySource.Path(stored));
        git_url = abs.to_string();
      },
      .Git(g_name, g_url, g_requirement) => {
        dep_name = match(options.name, .Some(n) => n, .None => g_name);
        git_url = g_url.clone();
        git_subdir = match(options.subdir, .Some(s) => s, .None => String.new());
        requirement := match(
          options.rev,
          .Some(r) => {
            if(g_requirement.is_some(), {
              e.exn.throw(dyn(String.from("Error: --rev cannot be combined with an @version")));
            });
            Option(GitRequirement).Some(GitRequirement.Rev(r))
          },
          .None => match(
            options.branch,
            .Some(b) => {
              if(g_requirement.is_some(), {
                e.exn.throw(dyn(String.from("Error: --branch cannot be combined with an @version")));
              });
              Option(GitRequirement).Some(GitRequirement.Branch(b))
            },
            .None => g_requirement
          )
        );
        match(
          requirement,
          .Some(r) => {
            source = Option(DependencySource).Some(DependencySource.Git(g_url, r, git_subdir.clone()));
          },
          .None => {
            needs_latest = true;
          }
        );
      }
    );
    if(dep_name.len() == usize(0), {
      e.exn.throw(dyn(String.from("Error: cannot derive a dependency name from the specifier; pass --name <name>")));
    });
    if(dep_name.contains("/"), {
      e.exn.throw(dyn(`Error: dependency name "${dep_name}" may not contain "/"`));
    });
    if(is_path, {
      present := e.io.await(exists(Path.new(git_url.clone()), e.io), e.io);
      if(!present, {
        e.exn.throw(dyn(`Error: Path does not exist: ${git_url}`));
      });
    });
    if(needs_latest, {
      println(`Resolving latest version for ${dep_name}...`);
      latest := e.io.await(resolve_latest_tag(git_url.clone(), options.verbose, e.io, e.exn), e);
      source = match(
        latest,
        .Err(msg) => {
          e.exn.throw(dyn(`Error: ${msg}\nEnsure the repository exists and is accessible: ${git_url}`));
          Option(DependencySource).None
        },
        .Ok(tag_opt) => match(
          tag_opt,
          .Some(tag) => {
            // `v1.2.3` → `^1.2.3`: the range that follows compatible releases.
            sv := parse_semver(tag.clone()).unwrap();
            range := `^${sv.major.to_string()}.${sv.minor.to_string()}.${sv.patch.to_string()}`;
            Option(DependencySource).Some(DependencySource.Git(git_url.clone(), GitRequirement.Version(range), git_subdir.clone()))
          },
          .None => Option(DependencySource).None
        )
      );
    });
    if(needs_latest && source.is_none(), {
      // No release tags: pin the default branch by name; the lock pins the
      // commit.
      branch := e.io.await(resolve_default_branch(git_url.clone(), e.io, e.exn), e);
      source = Option(DependencySource).Some(DependencySource.Git(git_url.clone(), GitRequirement.Branch(branch), git_subdir.clone()));
    });
    value := dependency_value_text(source.unwrap());
    table := if(options.dev, String.from("dev-dependencies"), String.from("dependencies"));
    other_table := if(options.dev, String.from("dependencies"), String.from("dev-dependencies"));
    match(
      manifest.find_dependency(dep_name.clone()),
      .Some(existing) => if(existing.dev != options.dev, {
        e.exn.throw(dyn(`Error: "${dep_name}" is already declared in [${other_table}]; run 'yo remove ${dep_name}' first`));
      }),
      .None => ()
    );
    text := e.io.await(read_to_string(Path.new(manifest.path.clone()), e.io), e);
    edited := match(
      set_entry(text, table.clone(), dep_name.clone(), value.clone()),
      .Ok(t) => t,
      .Err(msg) => {
        e.exn.throw(dyn(`Error: ${manifest.path}: ${msg}`));
        String.new()
      }
    );
    e.io.await(write_string(Path.new(manifest.path.clone()), edited, e.io), e);
    println(`Added ${dep_name} = ${value} to [${table}] in ${MANIFEST_FILENAME}`);
    // Re-read: the edit is the source of truth for what gets fetched.
    updated := match(
      load_manifest(manifest.path.clone(), e.exn),
      .Ok(m) => m,
      .Err(msg) => {
        e.exn.throw(dyn(`Error: ${msg}`));
        manifest
      }
    );
    _ := e.io.await(install_dependencies(updated, ResolveMode.Install, false, false, options.verbose, e.io, e.exn), e);
    println(`Done. Import it with import("${dep_name}").`);
    ()
  })
);
// ---------------------------------------------------------------------------
// yo remove
// ---------------------------------------------------------------------------
/// `yo remove <name>`: delete the dependency from `yo.toml` and prune it from
/// `yo.lock`.
run_remove :: (
  fn(
    name : String,
    verbose : bool,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    manifest := load_project_manifest(e.exn);
    if(manifest.find_dependency(name.clone()).is_none(), {
      e.exn.throw(dyn(`Error: ${manifest.path} declares no dependency "${name}"`));
    });
    text := e.io.await(read_to_string(Path.new(manifest.path.clone()), e.io), e);
    (edited : String) = text.clone();
    (removed_from : String) = String.new();
    match(
      remove_entry(text.clone(), String.from("dependencies"), name.clone()),
      .Ok(r) => match(
        r,
        .Some(t) => {
          edited = t;
          removed_from = String.from("dependencies");
        },
        .None => ()
      ),
      .Err(msg) => {
        e.exn.throw(dyn(`Error: ${manifest.path}: ${msg}`));
      }
    );
    if(removed_from.len() == usize(0), {
      match(
        remove_entry(text.clone(), String.from("dev-dependencies"), name.clone()),
        .Ok(r) => match(
          r,
          .Some(t) => {
            edited = t;
            removed_from = String.from("dev-dependencies");
          },
          .None => ()
        ),
        .Err(msg) => {
          e.exn.throw(dyn(`Error: ${manifest.path}: ${msg}`));
        }
      );
    });
    if(removed_from.len() == usize(0), {
      e.exn.throw(dyn(`Error: ${manifest.path}: could not locate the entry for "${name}"`));
    });
    e.io.await(write_string(Path.new(manifest.path.clone()), edited, e.io), e);
    println(`Removed ${name} from [${removed_from}] in ${MANIFEST_FILENAME}`);
    updated := match(
      load_manifest(manifest.path.clone(), e.exn),
      .Ok(m) => m,
      .Err(msg) => {
        e.exn.throw(dyn(`Error: ${msg}`));
        manifest
      }
    );
    // Prunes the lock entry; nothing is fetched that is already cached.
    _ := e.io.await(install_dependencies(updated, ResolveMode.Install, false, false, verbose, e.io, e.exn), e);
    println("Done.");
    ()
  })
);
// ---------------------------------------------------------------------------
// yo install / yo update
// ---------------------------------------------------------------------------
/// What `yo install` / `yo update` were asked to do.
InstallOptions :: ref(
  struct(
    /// `yo update`: re-resolve (the named packages, or all).
    update : bool,
    names : ArrayList(String),
    /// `yo update --latest`: also raise each named `version` range in
    /// `yo.toml` to the newest release (`^X.Y.Z`).
    latest : bool,
    /// Fail if `yo.lock` would change.
    locked : bool,
    /// Fail if the network would be needed.
    offline : bool,
    verbose : bool
  )
);
/// `yo update --latest`: for each git dependency with a `version`
/// requirement (the named ones, or all), look up the newest release tag and,
/// when it is outside the current range, rewrite the range to `^X.Y.Z` in
/// place. Returns the manifest re-read after the edits. One loop with awaits,
/// every await a top-level statement.
_bump_ranges_to_latest :: (
  fn(
    manifest : Manifest,
    names : ArrayList(String),
    verbose : bool,
    io : Io,
    exn : Exception
  ) -> Impl(Future(Manifest, IoExn))
)(
  io.async((e : IoExn) => {
    text := e.io.await(read_to_string(Path.new(manifest.path.clone()), e.io), e);
    (edited : String) = text;
    (changed : bool) = false;
    deps := manifest.git_dependencies();
    (i : usize) = usize(0);
    while(i < deps.len(), {
      dep := deps(i);
      i = (i + usize(1));
      // Decide everything about this dependency in ONE match on its source
      // (seed: two matches on one async local redeclare its C copy).
      (url : String) = String.new();
      (range_text : String) = String.new();
      (subdir : String) = String.new();
      match(
        dep.source,
        .Git(u, r, sd) => {
          url = u;
          subdir = sd;
          range_text = match(r, .Version(v) => v, _ => String.new());
        },
        .Path(_) => ()
      );
      (named : bool) = (names.len() == usize(0));
      (ni : usize) = usize(0);
      while(ni < names.len(), {
        if(names(ni) == dep.name, {
          named = true;
        });
        ni = (ni + usize(1));
      });
      wanted := (named && (range_text.len() > usize(0)));
      if(wanted, {
        listed := e.io.await(ls_remote_tags(url.clone(), e.io, e.exn), e);
        tags_text := match(
          listed,
          .Ok(t) => t,
          .Err(msg) => {
            e.exn.throw(dyn(`Error: ${msg}`));
            String.new()
          }
        );
        newest := latest_release(semver_tags_from_ls_remote(tags_text));
        req := match(
          parse_version_req(range_text.clone()),
          .Ok(r) => r,
          .Err(msg) => {
            e.exn.throw(dyn(`Error: ${manifest.path}: dependency "${dep.name}": version requirement "${range_text}": ${msg}`));
            parse_version_req(String.from("*")).unwrap()
          }
        );
        match(
          newest,
          .None => println(`  ${dep.name}: ${url} has no release tags; "${range_text}" kept`),
          .Some(sv) => if(version_req_matches(req, sv), {
            if(verbose, {
              println(`  ${dep.name}: the newest release ${sv.tag} is within "${range_text}"`);
            });
          }, {
            new_range := `^${sv.version_text()}`;
            value := dependency_value_text(DependencySource.Git(url.clone(), GitRequirement.Version(new_range.clone()), subdir.clone()));
            table := if(dep.dev, String.from("dev-dependencies"), String.from("dependencies"));
            edited = match(
              set_entry(edited.clone(), table, dep.name.clone(), value),
              .Ok(t) => t,
              .Err(msg) => {
                e.exn.throw(dyn(`Error: ${manifest.path}: ${msg}`));
                String.new()
              }
            );
            changed = true;
            println(`  ${dep.name}: "${range_text}" → "${new_range}" (${sv.tag})`);
          })
        );
      });
    });
    if(!changed, {
      return(manifest);
    });
    e.io.await(write_string(Path.new(manifest.path.clone()), edited, e.io), e);
    match(
      load_manifest(manifest.path.clone(), e.exn),
      .Ok(m) => m,
      .Err(msg) => {
        e.exn.throw(dyn(`Error: ${msg}`));
        manifest
      }
    )
  })
);
/// `yo install`: resolve and fetch the dependency graph and write `yo.lock`
/// (a lock entry that still satisfies every requirement on it is kept).
/// `yo update [name…]`: re-resolve the named dependencies (all when `names`
/// is empty); `--latest` first raises their ranges to the newest release.
run_install :: (
  fn(
    options : InstallOptions,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    manifest := load_project_manifest(e.exn);
    (ni : usize) = usize(0);
    while(ni < options.names.len(), {
      if(manifest.find_dependency(options.names(ni)).is_none(), {
        e.exn.throw(dyn(`Error: ${manifest.path} declares no dependency "${options.names(ni)}"`));
      });
      ni = (ni + usize(1));
    });
    if(options.latest && !options.update, {
      e.exn.throw(dyn(String.from("Error: --latest belongs to `yo update`")));
    });
    if(options.latest && options.locked, {
      e.exn.throw(dyn(String.from("Error: --latest edits yo.toml and yo.lock; it cannot be combined with --locked")));
    });
    if(options.latest && options.offline, {
      e.exn.throw(dyn(String.from("Error: --latest needs the network; it cannot be combined with --offline")));
    });
    if(manifest.dependencies.len() == usize(0), {
      println(`No dependencies declared in ${manifest.path}.`);
    }, {
      println(`Found ${manifest.dependencies.len().to_string()} dependency(ies) in ${manifest.path}:`);
    });
    (i : usize) = usize(0);
    while(i < manifest.dependencies.len(), {
      d := manifest.dependencies(i);
      match(
        d.source,
        .Git(url, req, _) => {
          pin := match(
            req,
            .DefaultBranch => String.from("default branch"),
            .Version(v) => `version ${v}`,
            .Tag(t) => `tag ${t}`,
            .Branch(b) => `branch ${b}`,
            .Rev(r) => `rev ${r}`
          );
          println(`  - ${d.name} (${url} @ ${pin})`);
        },
        .Path(p) => println(`  - ${d.name} (path ${p})`)
      );
      i = (i + usize(1));
    });
    (current : Manifest) = manifest;
    if(options.latest, {
      println("Checking for newer releases...");
      bumped := e.io.await(_bump_ranges_to_latest(manifest, options.names, options.verbose, e.io, e.exn), e);
      current = bumped;
    });
    mode := cond(
      !options.update => ResolveMode.Install,
      (options.names.len() == usize(0)) => ResolveMode.UpdateAll,
      true => ResolveMode.Update(options.names)
    );
    if(options.update, {
      println("Updating: re-resolving refs to the latest satisfying commits...");
    });
    println("Resolving dependencies...");
    _ := e.io.await(install_dependencies(current, mode, options.locked, options.offline, options.verbose, e.io, e.exn), e);
    println("Done.");
    ()
  })
);
// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------
export(
  is_local_path,
  _url_to_dep_name,
  parse_package_specifier,
  dependency_value_text,
  load_project_manifest,
  install_dependencies,
  AddOptions,
  run_add,
  run_remove,
  InstallOptions,
  run_install,
  ParsedPackage
);
