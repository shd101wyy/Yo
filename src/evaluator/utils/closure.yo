//! evaluator/utils/closure — closure capture helpers.
//!
//! Phase 3 simplifications:
//!   - `consume_captured_variables`             → no-op (explicit-copy captures are
//!     consumed in `generate_captured_variable_dup_expressions`)
//!   - `build_path_collection_from_captured_variables` → empty list
//!   - `validate_capture_trait_requirements`    → no-op
//!   - `generate_captured_variable_dup_expressions` → no ARC (returns None)
//!   - `create_capture_type_and_value`          → simplified inference only;
//!     explicit capture struct type deferred to Phase 4.
//!   - `autoDeriveTraitsAndAddRcFunctions…`     → calls auto_derive_traits_for_struct_type
{ String } :: import("std/string");
{ function_reaches_non_send_global, d1_reach_memo, d1_note_thread_reach } :: import("../effects/mutation_summary.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ eprintln } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{
  AstExpr,
  ast_expr_id,
  ast_expr_token,
  ast_expr_to_string,
  ast_expr_is_atom_of,
  ast_expr_is_fn_call_of,
  clone_expr_fresh_ids,
  make_err_expr,
  BF_DOT,
  BF_YO_CAPTURE_FIELD
} :: import("../../expr.yo");
{ Token } :: import("../../token.yo");
{
  Variable,
  Environment,
  get_variables_from_env
} :: import("../../env.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ get_trait_type_from_env } :: import("../../types/env_lookup.yo");
{ type_to_string } :: import("../../types/string.yo");
{ is_fn_trait_type, is_some_type, is_function_type } :: import("../../types/guards.yo");
{ format_error_message } :: import("../../error.yo");
{ type_implements_trait_bool, extract_fn_trait_from_type } :: import("../trait_checking.yo");
{ raise_flow_violation } :: import("../../types/flowability.yo");
{
  some_resolution,
  CaptureFieldInit,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set,
  expr_info_set_capture_type,
  expr_info_set_capture_field_inits,
  expr_info_set_macro_expansion,
  record_macro_expansion
} :: import("../../expr_info.yo");
{ get_closure_capture_info, get_func_type } :: import("../../function_value.yo");
// Deterministic capture-struct ids: keyed by the closure's source position +
// capture field signature, so the SAME closure (re-evaluated across the eval and
// codegen passes) gets the SAME capture-struct id. A fresh `random_id` per call
// produced DIFFERENT ids for one closure (e.g. construction `..._5638` vs a
// specialized callee's eval-time param `..._5654`), breaking the
// impl_closure_call_map lookup that links a capture struct to its closure impl fn
// (Thread.spawn). The key is unique per closure source AND per capture-type
// instantiation, so distinct closures never collide.
(g_capture_struct_ids : HashMap(String, String)) = HashMap(String, String).new();
/// Reverse map (id → cap_key) for the hash-collision backstop below — a
/// silent 64-bit collision would merge two capture structs in the emitted C.
(g_capture_struct_ids_r : HashMap(String, String)) = HashMap(String, String).new();
{
  EvalValue
} :: import("../../value.yo");
{
  CapturedVarInfo,
  CaptureUsage,
  EvalContext,
  ExpectedTypeCtx,
  set_function_value_marker_fn,
  track_variable_usage_resolved
} :: import("../context.yo");
{
  TypeField
} :: import("../types/field.yo");
{
  register_struct_fields,
  register_capture_field_decl_site
} :: import("../types/field.yo");
{ fnv1a64, debug_knob } :: import("../../utils.yo");
{ type_contains_rc_type, type_requires_explicit_copy, is_closure_capture_struct, is_bound_closure_identity, resolve_cell_chain, type_first_mut_borrow } :: import("../../types/utils.yo");
{ move_captured_explicit_copy_variable, set_expr_as_needs_to_call_dup, attach_temp_variable_to_expr } :: import("../utils.yo");
{ generate_expr_from_code } :: import("../../parser.yo");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ audit_implicit_copy_enabled, audit_record_implicit_copy, audit_copy_trait_enabled, audit_record_copy_trait } :: import("../utils.yo");
{ Exception } :: import("std/error");
{ auto_derive_traits_for_struct_type } :: import("../types/utils.yo");
// ---------------------------------------------------------------------------
// FuncCapturedVarInfo
// ---------------------------------------------------------------------------
/// `CapturedVarInfo` enriched with the actual type and optional value of the
/// captured variable.  Produced by `enrich_captured_variables`.
FuncCapturedVarInfo :: struct(
  frame_level : usize,
  usage : CaptureUsage,
  token : Token,
  ty : TypeValue,
  value : Option(EvalValue),
  is_effect_param : bool,
  /// The captured binding's declaration site (`module:row:col` of its
  /// Variable's token, the format of `SuspensionCapturedVariable.decl_site`):
  /// its identity, recorded per capture-struct field by
  /// `create_capture_type_and_value` (`register_capture_field_decl_site`).
  decl_site : String
);
// ---------------------------------------------------------------------------
// CaptureTypeAndValueResult
// ---------------------------------------------------------------------------
/// Result type for `create_capture_type_and_value`.
CaptureTypeAndValueResult :: struct(
  capture_type : Option(TypeValue),
  capture_value : Option(EvalValue),
  env : Environment
);
// ---------------------------------------------------------------------------
// consume_captured_variables
// ---------------------------------------------------------------------------
/// Mark closure-captured variables as consumed (move semantics).
///
/// Not called: a capture copies (a dup per captured RC variable), and the one
/// capture that moves, that of a value which is not implicitly copyable
/// (`type_requires_explicit_copy`), is consumed where the capture is
/// built (`generate_captured_variable_dup_expressions`). Returns env unchanged.
consume_captured_variables :: (
  fn(
    _captured_variables : &HashMap(String, CapturedVarInfo),
    env : &Environment,
    _closure_token : &Token
  ) -> Environment
)(env);
// ---------------------------------------------------------------------------
// build_path_collection_from_captured_variables
// ---------------------------------------------------------------------------
/// Build a path collection (list of variable-name paths) from captured
/// variables.  Used for borrow tracking in C codegen.
///
/// Phase 3 simplification: returns an empty list.
build_path_collection_from_captured_variables :: (
  fn(
    _captured_variables : &HashMap(String, CapturedVarInfo)
  ) -> ArrayList(ArrayList(String))
)(
  ArrayList(ArrayList(String)).new()
);
// ---------------------------------------------------------------------------
// validate_capture_trait_requirements
// ---------------------------------------------------------------------------
/// Raise a capture-trait violation so it SURVIVES the def-time trial wall. A
/// closure body is usually created inside a def-time TRIAL evaluation, which
/// swallows thrown errors (anonymous_function.yo's def-eval wall); a `Send`
/// violation is a deliberate rejection, so it takes the wall's re-raise
/// channel — flag a flow violation first, then throw — the same shape as the
/// callable-argument and C19 checks in calls/helper.yo.
_raise_capture_trait_violation :: (
  fn(ctx : &EvalContext, exn : Exception, tok : &Token, msg : &String) -> unit
)(raise_flow_violation(format_error_message(tok, msg), ctx, exn));
/// The type a captured variable is JUDGED by for a marker trait such as
/// `Send`. A captured CLOSURE arrives as its `Impl(Fn(...))` wrapper SomeT,
/// which carries no `Send` in its required traits — yet a closure is `Send`
/// iff its captures are (Rust's auto trait), and its captures live in its
/// capture struct, which auto-derives `Send` when every field is
/// (`auto_derive_traits_for_struct_type` above). Resolve the wrapper: the
/// SomeT's own resolution, then the global registry, then the VALUE's
/// registered capture struct. `.None` means "nothing to judge": a closure
/// with no capture struct captures nothing and is trivially `Send`.
/// (tests/sync/once.test.yo's `racer` — a closure over atomics, spawned
/// four times — was the one false rejection in the whole suite.)
_capture_judgement_type :: (fn(ty : &TypeValue, value : &Option(EvalValue)) -> Option(TypeValue))(
  match(
    ty,
    .SomeT({ id : _ }) => match(
      some_resolution(ty),
      .Some(c) => Option(TypeValue).Some(c),
      .None => match(
        value,
        .Some(v) => match(
          v,
          .FuncVal(fvd, _) => match(
            get_closure_capture_info(fvd.*.func_id.clone()),
            .Some(cci) => Option(TypeValue).Some(cci.capture_type),
            .None => Option(TypeValue).None
          ),
          _ => Option(TypeValue).Some(ty)
        ),
        .None => Option(TypeValue).Some(ty)
      )
    ),
    _ => Option(TypeValue).Some(ty)
  )
);
/// True when a captured variable's OWN declared type already REQUIRES this
/// trait — an `Impl(Fn(...), Send)` parameter, say.
///
/// Such a capture is satisfied by its DECLARATION and must not be judged by
/// its resolution. The bound is a proof obligation the CALLER discharged when
/// it supplied the value — this same machinery rejects a non-`Send` closure at
/// that site — exactly as Rust's `F : Send` makes a captured `F` `Send`
/// without re-deriving anything.
///
/// Judging the RESOLVED capture struct instead asks the wrong question: the
/// struct is the argument closure's storage and carries no `Send` impl of its
/// own, so a correctly-bounded `cb` forwarded into a spawn closure was
/// rejected with "Captured variable 'cb' (type Impl : (Fn(Io) -> unit + Send))
/// does not implement Send" — an error whose own text contains the proof it
/// is wrong. That is D18b's third wall
/// (`plans/archive/STD_API_STABILIZATION.md` §2 D18).
///
/// Deliberately narrow: only a trait the declared wrapper itself lists. A
/// capture whose declared type carries NO such bound is judged exactly as
/// before, which is what keeps `tests/thread_safety.test.yo`'s
/// `_spawn_with_closure_over_ref` negative firing — `worker` there is declared
/// `Impl(Fn() -> unit)`, with no `Send`, so nothing here applies to it.
_declared_bound_requires :: (fn(ty : &TypeValue, trait_type : &TypeValue) -> bool)(
  match(
    ty,
    .SomeT({ required_trait_types : dbr_rtts }) => {
      want := type_to_string(trait_type);
      (dbr_i : usize) = usize(0);
      (dbr_found : bool) = false;
      while((dbr_i < dbr_rtts.len()) && !dbr_found, {
        match(
          dbr_rtts.get(dbr_i),
          .Some(dbr_t) => if(type_to_string(&dbr_t) == want, {
            dbr_found = true;
          }),
          .None => ()
        );
        dbr_i = (dbr_i + usize(1));
      });
      dbr_found
    },
    _ => false
  )
);
// Rule D1 (plans/reference/PARALLELISM_RULES.md): a closure bound to a `Send`
// wrapper runs on another thread, so it may not reach a non-Send module-level
// global, directly or through the functions it calls
// (`function_reaches_non_send_global`). Separate from the capture check
// because a closure with NO captures has no capture struct and still reaches
// globals. A pragma'd file (std's relay closures included) is the audited
// ===========================================================================
// Rules D1 + D4 for function VALUES (plans/reference/PARALLELISM_RULES.md)
// ===========================================================================
// A function-like type — a bare `fn(...)`, a closure's `Impl(Fn...)` — holds
// `Send` only through its VALUES: a function value is `Send` iff its captured
// state is (D4) and its code reaches no thread-affine module global (D1).
// The type alone cannot say: two functions of one signature share the type,
// and a closure that captures nothing still runs code
// (issues/fixed/function-values-bypass-the-d1-reach-walk.md).
/// The closures created against each closure-typed SomeT, by the SomeT's id —
/// the only handle a type-level judgement (`Channel(typeof(k))`, a generic
/// binder bound to `k`'s type) has on the closure behind the type.
(g_closure_fids_by_some : HashMap(String, ArrayList(String))) = HashMap(String, ArrayList(String)).new();
/// The closures behind each capture struct, by the struct's id. Identity
/// treats a closure identity as its capture struct
/// (plans/reference/TYPE_IDENTITY.md), so a type argument can hold the bare
/// struct (`ArrayList(T)` with `T` bound through the wrapper's resolution),
/// and a capture-free closure's struct has no fields at all: judged as a
/// struct, it would be `Send` whatever its code reaches.
(g_closure_fids_by_capture : HashMap(String, ArrayList(String))) = HashMap(String, ArrayList(String)).new();
_some_id_of :: (fn(ty : &TypeValue) -> String)(
  match(ty, .SomeT(sid, _, _, _, _, _, _, _, _, _) => sid, _ => String.new())
);
_capture_id_of :: (fn(ty : &TypeValue) -> String)(
  if(is_closure_capture_struct(ty), match(ty, .Struct({ id : cid }) => cid, _ => String.new()), String.new())
);
_note_fid_for_some_id :: (fn(sid : &String, fid : &String) -> unit)(_note_fid_in(&mut g_closure_fids_by_some, sid, fid));
_note_fid_in :: (fn(registry : &mut HashMap(String, ArrayList(String)), sid : &String, fid : &String) -> unit)({
  if(sid.is_empty(), {
    return(());
  });
  match(
    registry.get(sid.clone()),
    .Some(fids) => {
      (seen : bool) = false;
      (fi : usize) = usize(0);
      while((fi < fids.len()) && !seen, {
        if(match(fids.get(fi), .Some(x) => (x == fid), .None => false), {
          seen = true;
        });
        fi = (fi + usize(1));
      });
      if(!seen, {
        // Stored back: a `get` copy is not the stored list once collections
        // are values (plans/VALUES_BY_DEFAULT.md §6 V2a).
        grown := fids;
        grown.push(fid);
        registry.insert(sid, grown);
      });
    },
    .None => {
      fids := ArrayList(String).new();
      fids.push(fid);
      registry.insert(sid, fids);
    }
  );
});
/// Record that the SomeT with id `sid` names closure `fid`.
note_closure_for_some_id :: (fn(sid : &String, fid : &String) -> unit)(_note_fid_for_some_id(sid, fid));
/// A SomeT minted as a copy of closure SomeT `of_id` (a specialization's
/// fresh binder for a closure argument) names the same closures.
alias_closure_some_id :: (fn(new_id : &String, of_id : &String) -> unit)({
  match(
    g_closure_fids_by_some.get(of_id),
    .Some(fids) => {
      (ai : usize) = usize(0);
      while(ai < fids.len(), {
        match(fids.get(ai), .Some(f) => _note_fid_for_some_id(new_id.clone(), &f), .None => ());
        ai = (ai + usize(1));
      });
    },
    .None => ()
  );
});
_is_function_like :: (fn(ty : &TypeValue) -> bool)(
  (is_some_type(ty) && extract_fn_trait_from_type(ty).is_some()) || is_function_type(ty) || is_closure_capture_struct(ty)
);
/// Each closure's captured state judged per marker, taken where the closure is
/// created — per captured VARIABLE, with the captured values as witnesses, so
/// a captured function or closure is judged by its value and not by the field
/// type of the capture struct (a `fn` field is not `Send` as a type).
/// Keyed `fid|marker`; `.Some(reason)` names the first offending capture.
(g_closure_capture_offense : HashMap(String, Option(String))) = HashMap(String, Option(String)).new();
_captures_offense :: (
  fn(cvwv : &HashMap(String, FuncCapturedVarInfo), marker : &TypeValue, env : &Environment, ctx : &EvalContext) -> Option(String)
)({
  mname := type_to_string(marker);
  key_iter := cvwv.keys();
  (more : bool) = true;
  while(more, {
    match(
      key_iter.next(),
      .None => {
        more = false;
      },
      .Some(var_name) => match(
        cvwv.get(var_name.clone()),
        .None => (),
        .Some(info) => if(!_declared_bound_requires(&info.ty, marker), {
          match(
            function_value_marker(&info.ty, &info.value, marker, env, ctx),
            .Some(.Some(o)) => {
              return(Option(String).Some(`its captured variable '${var_name}' does not implement ${mname}: ${o}`));
            },
            .Some(.None) => (),
            .None => match(
              _capture_judgement_type(&info.ty, &info.value),
              .Some(judged) => if(!type_implements_trait_bool(&judged, marker, env), {
                return(Option(String).Some(`its captured variable '${var_name}' (type ${type_to_string(&info.ty)}) does not implement ${mname}`));
              }),
              .None => ()
            )
          );
        })
      )
    );
  });
  Option(String).None
});
/// Why a closure that BORROWS its captures is not `Send`
/// (plans/VALUES_BY_DEFAULT.md decision 38 E: a borrow capture is never
/// `Send`). Such a closure is the literal argument of a borrowing parameter,
/// so its captures stay in the caller's frame.
_borrowed_captures_offense :: "it borrows its captures (it is the literal argument of a borrowing parameter and captures a value that is not implicitly copyable, so that value stays in the caller's frame), and a borrow capture is never Send";
/// Record closure `fid`'s capture verdicts (`Send`, `Sync`, `Acyclic`) at its
/// creation. `borrows_captures`: the closure borrows its captures instead of
/// owning them (`closure_literal_is_borrowed`), so it is never `Send`; it is
/// `Sync` iff every captured value is, as for an `imm` capture.
record_closure_capture_verdicts :: (
  fn(
    fid : &String,
    cvwv : &Option(HashMap(String, FuncCapturedVarInfo)),
    capture_ty : &Option(TypeValue),
    env : &Environment,
    ctx : &EvalContext,
    (borrows_captures : bool) ?= false
  ) -> unit
)({
  // The capture struct names this closure too (`g_closure_fids_by_capture`).
  match(
    capture_ty,
    .Some(rcv_ct) => _note_fid_in(&mut g_closure_fids_by_capture, _capture_id_of(&rcv_ct), fid.clone()),
    .None => ()
  );
  match(
    cvwv,
    .Some(cv) => {
      markers := ArrayList(String).new();
      markers.push(String.from("Send"));
      markers.push(String.from("Sync"));
      markers.push(String.from("Acyclic"));
      (mi : usize) = usize(0);
      while(mi < markers.len(), {
        mn := match(markers.get(mi), .Some(m) => m, .None => String.new());
        match(
          get_trait_type_from_env(env, mn.clone()),
          .Some(mt) => {
            verdict := if(borrows_captures && (mn == "Send"), Option(String).Some(String.from(_borrowed_captures_offense)), _captures_offense(&cv, &mt, env, ctx));
            g_closure_capture_offense.insert(`${fid}|${mn}`, verdict);
          },
          .None => ()
        );
        mi = (mi + usize(1));
      });
    },
    .None => ()
  );
});
/// A closure-typed SomeT that DECLARES `marker` (`Impl(Fn(...), Send)`): the
/// obligation was discharged where a value was converted into it (a literal
/// at its creation, an argument at the call, a result at the return).
_declares_marker :: (fn(ty : &TypeValue, marker : &TypeValue) -> bool)(
  match(
    ty,
    .SomeT({ required_trait_types : rtts }) => {
      want := type_to_string(marker);
      (found : bool) = false;
      (i : usize) = usize(0);
      while((i < rtts.len()) && !found, {
        match(
          rtts.get(i),
          .Some(t) => if(type_to_string(&t) == want, {
            found = true;
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    _ => false
  )
);
/// Why the function value `fid` does not hold `marker`, or `.None`. The
/// captured state first (D4), then — for `Send` — what its code reaches (D1).
/// `body` is walked only when no verdict was memoized: a closure's own is
/// taken where it is created, with its defining env.
_function_value_offense :: (
  fn(fid : &String, body : &Option(AstExpr), marker : &TypeValue, env : &Environment, ctx : &EvalContext) -> Option(String)
)({
  mname := type_to_string(marker);
  // The captures: the verdict taken at the closure's creation, per captured
  // variable; without one, the capture struct as a type.
  cap_hint := "a closure has a marker trait only when every value it captures does; capture an atomic object (Arc(T), Mutex(T), Atomic*) instead";
  match(
    g_closure_capture_offense.get(`${fid}|${mname}`),
    .Some(.Some(co)) => {
      return(Option(String).Some(`${co} — ${cap_hint}`));
    },
    .Some(.None) => (),
    .None => match(
      get_closure_capture_info(fid.clone()),
      .Some(cci) => if(!type_implements_trait_bool(&cci.capture_type, marker, env), {
        return(Option(String).Some(`its captured state (${type_to_string(&cci.capture_type)}) does not implement ${mname} — ${cap_hint}`));
      }),
      .None => ()
    )
  );
  // D1 covers every thread slot, `Sync` as well as `Send`
  // (plans/VALUES_BY_DEFAULT.md decision 38 E): a `Sync` function value may be
  // called from several threads, so what its code reaches is shared too.
  if(!((mname == "Send") || (mname == "Sync")), {
    return(Option(String).None);
  });
  // An extern runs no Yo code.
  (is_extern : bool) = match(get_func_type(fid.clone()), .Func({ meta : fm }) => fm.*.extern_name.is_some(), _ => false);
  if(is_extern, {
    return(Option(String).None);
  });
  reach := match(
    d1_reach_memo(fid.clone()),
    .Some(r) => r,
    .None => match(
      body,
      .Some(b) => function_reaches_non_send_global(fid.clone(), &b, &ctx.expr_info_table, env),
      .None => Option(String).None
    )
  );
  // Judged Send: this code may run on another thread, so what it reads is
  // thread-reached from here on (rule D1's read-then-write order) — and a
  // global it reads that is already written is a violation now (the
  // write-then-read order, which a memoized verdict cannot see).
  written := d1_note_thread_reach(fid.clone());
  match(
    reach,
    .Some(r) => Option(String).Some(`its code ${r}`),
    .None => match(written, .Some(w) => Option(String).Some(`its code ${w}`), .None => Option(String).None)
  )
});
/// Why the closure type `ty` is not `trait_name` (`Copy` or `Clone`): its
/// `&mut` capture, or the first by-value capture whose type is not.
_closure_copy_offense :: (fn(ty : &TypeValue, trait_name : &String, env : &Environment) -> String)({
  if(type_first_mut_borrow(ty).is_some(), {
    return(String.from("the closure has a `&mut` capture, and two copies of one exclusive borrow would alias (plans/VALUES_BY_DEFAULT.md decision 38 A)"));
  });
  trait_tt := get_trait_type_from_env(env, trait_name.clone());
  match(
    resolve_cell_chain(ty),
    .Struct({ field_labels : co_labels, field_types : co_fields }) => {
      (i : usize) = usize(0);
      while(i < co_fields.len(), {
        ft := match(co_fields.get(i), .Some(f) => f, .None => t_unit());
        (part_ok : bool) = match(trait_tt, .Some(tt) => type_implements_trait_bool(&ft, &tt, env), .None => true);
        if(!part_ok, {
          label := match(co_labels.get(i), .Some(l) => l, .None => String.new());
          return(`its capture \`${label}\` has type \`${type_to_string(&ft)}\`, which is not ${trait_name}; a closure is ${trait_name} exactly when every by-value capture is (plans/VALUES_BY_DEFAULT.md decision 36)`);
        });
        i = (i + usize(1));
      });
    },
    _ => ()
  );
  `its captured state is not ${trait_name}`
});
/// The marker judgement of a function-like type from its VALUES
/// (`call_function_value_marker`, `context.yo`, documents the contract):
/// `witness` when the caller has the value; otherwise the values of `ty` in
/// scope — `env`'s function-local bindings of that type (a SomeT matched by
/// id, a bare `fn` by its rendering) — and the closures created against a
/// closure SomeT. `.None` when no value was found.
function_value_marker :: (
  fn(ty : &TypeValue, witness : &Option(EvalValue), marker : &TypeValue, env : &Environment, ctx : &EvalContext) -> Option(Option(String))
)({
  mname := type_to_string(marker);
  // `Copy` and `Clone` of a closure are its capture record's
  // (plans/VALUES_BY_DEFAULT.md decision 36): a type question, judged here
  // because a closure type is an `Impl(Fn(...))` SomeT, which the
  // where-clause gates otherwise only collect the bound on
  // (issues/fixed/2026-10-14-a-where-copy-bound-accepts-a-closure-that-owns-a-string.md).
  if((mname == "Copy") || (mname == "Clone"), {
    return(
      cond(
        !is_bound_closure_identity(ty) => Option(Option(String)).None,
        type_implements_trait_bool(ty, marker, env) => Option(Option(String)).Some(Option(String).None),
        true => Option(Option(String)).Some(Option(String).Some(_closure_copy_offense(ty, &mname, env)))
      )
    );
  });
  if(!((mname == "Send") || (mname == "Sync") || (mname == "Acyclic")), {
    return(Option(Option(String)).None);
  });
  if(_declares_marker(ty, marker), {
    return(Option(Option(String)).Some(Option(String).None));
  });
  match(
    witness,
    .Some(.FuncVal(wfvd, _)) => {
      return(Option(Option(String)).Some(_function_value_offense(wfvd.*.func_id.clone(), Option(AstExpr).Some(wfvd.*.body), marker, env, ctx)));
    },
    .Some(_) => (),
    .None => ()
  );
  if(!_is_function_like(ty), {
    return(Option(Option(String)).None);
  });
  want_id := _some_id_of(ty);
  want_str := if(want_id.is_empty(), type_to_string(ty), String.new());
  (found : bool) = false;
  start := match(env.function_declaration_frame_level, .Some(l) => l, .None => usize(0));
  (fi : usize) = start;
  while(fi < env.frames.len(), {
    match(
      env.frames.get(fi),
      .Some(fr) => {
        (vi : usize) = usize(0);
        while(vi < fr.variables.len(), {
          match(
            fr.variables.get(vi),
            .Some(v) => {
              // A `::` function definition (module-level or local) is not a
              // value OF this type: it only shares the signature. Judging
              // every definition of the signature convicted `f := count`
              // for what an unrelated `fill` touches.
              if(!(v.is_module_level || v.is_compile_time_only), {
                matches := if(
                  want_id.is_empty(),
                  is_function_type(&v.ty) && (type_to_string(&v.ty) == want_str),
                  _some_id_of(&v.ty) == want_id
                );
                if(matches, {
                  match(
                    v.value.get(usize(0)),
                    .Some(vv) => match(
                      vv,
                      .FuncVal(fvd, _) => {
                        found = true;
                        match(
                          _function_value_offense(fvd.*.func_id.clone(), Option(AstExpr).Some(fvd.*.body), marker, env, ctx),
                          .Some(o) => {
                            return(Option(Option(String)).Some(Option(String).Some(o)));
                          },
                          .None => ()
                        );
                      },
                      _ => ()
                    ),
                    .None => ()
                  );
                });
              });
            },
            .None => ()
          );
          vi = (vi + usize(1));
        });
      },
      .None => ()
    );
    fi = (fi + usize(1));
  });
  // A closure identity's capture struct names its closure whichever copy of
  // the wrapper `ty` is: a copy minted under a fresh SomeT id is in neither
  // the frames scan nor `g_closure_fids_by_some`.
  want_cap := _capture_id_of(if(is_bound_closure_identity(ty), resolve_cell_chain(ty), ty));
  if(!want_cap.is_empty(), {
    match(
      g_closure_fids_by_capture.get(&want_cap),
      .Some(cfids) => {
        (cci : usize) = usize(0);
        while(cci < cfids.len(), {
          match(
            cfids.get(cci),
            .Some(ccfid) => {
              found = true;
              match(
                _function_value_offense(&ccfid, Option(AstExpr).None, marker, env, ctx),
                .Some(co) => {
                  return(Option(Option(String)).Some(Option(String).Some(co)));
                },
                .None => ()
              );
            },
            .None => ()
          );
          cci = (cci + usize(1));
        });
      },
      .None => ()
    );
  });
  if(!want_id.is_empty(), {
    match(
      g_closure_fids_by_some.get(&want_id),
      .Some(fids) => {
        (ci : usize) = usize(0);
        while(ci < fids.len(), {
          match(
            fids.get(ci),
            .Some(cfid) => {
              found = true;
              match(
                _function_value_offense(&cfid, Option(AstExpr).None, marker, env, ctx),
                .Some(o) => {
                  return(Option(Option(String)).Some(Option(String).Some(o)));
                },
                .None => ()
              );
            },
            .None => ()
          );
          ci = (ci + usize(1));
        });
      },
      .None => ()
    );
  });
  if(found, Option(Option(String)).Some(Option(String).None), Option(Option(String)).None)
});
/// Install `function_value_marker` in `context.yo`'s slot (called once from
/// `register_evaluate_expression`).
register_function_value_marker :: (fn() -> unit)({
  set_function_value_marker_fn(function_value_marker);
});
// base and is skipped.
validate_send_closure_global_reach :: (
  fn(
    wrapper_type : &TypeValue,
    closure_fid : &String,
    closure_body : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    error_token : &Token,
    exn : Exception
  ) -> unit
)({
  // The thread marker the slot requires (`Send` first), or "": D1 covers a
  // `Sync` closure slot as well as a `Send` one (decision 38 E).
  thread_marker := match(
    wrapper_type,
    .SomeT({ required_trait_types : rtts }) => {
      (found : String) = String.new();
      (ti : usize) = usize(0);
      while(ti < rtts.len(), ti = (ti + usize(1)), {
        trait_type := rtts(ti);
        if(!is_fn_trait_type(&trait_type), {
          tts := type_to_string(&trait_type);
          if((tts == "Send") || ((tts == "Sync") && found.is_empty()), {
            found = tts;
          });
        });
      });
      found
    },
    _ => String.new()
  );
  wants_send := !thread_marker.is_empty();
  // The closure is walked HERE, with its defining env, whether or not this
  // slot is `Send`: the verdict is memoized by fid, and a later judgement of
  // the closure's type (`arc(k)`, `where(T <: Send)`, an `Impl(Fn, Send)`
  // parameter) reads it through `g_closure_fids_by_some`. Walking it there,
  // with no defining env, would not resolve the local closures it calls.
  _note_fid_for_some_id(_some_id_of(wrapper_type), closure_fid.clone());
  if(!is_implicitly_unsafe_capable_file(Option(String).Some(error_token.module_path.clone())), {
    reach := function_reaches_non_send_global(closure_fid.clone(), closure_body, &ctx.expr_info_table, env);
    // Only a closure that really runs on another thread publishes its reads
    // (issues/fixed/a-non-send-closure-reading-a-global-marks-it-thread-reached.md).
    // A global it reads that is already written is a violation now: the
    // walk's verdict may be a memo taken before the write.
    if(wants_send, {
      match(
        d1_note_thread_reach(closure_fid.clone()),
        .Some(w) => if(reach.is_none(), {
          reach = Option(String).Some(w);
        }),
        .None => ()
      );
    });
    match(
      reach,
      .Some(reason) => if(wants_send, {
        _raise_capture_trait_violation(ctx, exn, error_token, `This closure runs on another thread (it is bound to a ${thread_marker} closure type) but ${reason}.`);
      }),
      .None => ()
    );
  });
});
/// Validate that a closure created for an `Impl(Fn(...), Send, …)` wrapper
/// satisfies every NON-Fn trait the wrapper requires — the check that makes
/// the `Send` on `Thread.spawn` / `spawn(pool, …)` mean something. Each
/// captured variable is checked first, so the error lands on the capture
/// site; then the capture struct as a whole. A no-op stub until 2026-09-06
/// (issues/fixed/send-was-not-enforced-at-spawn-boundaries.md).
validate_capture_trait_requirements :: (
  fn(
    wrapper_type : &TypeValue,
    capture_type : &TypeValue,
    captured_variables_with_values : &Option(HashMap(String, FuncCapturedVarInfo)),
    env : &Environment,
    ctx : &EvalContext,
    error_token : &Token,
    exn : Exception,
    // The closure borrows its captures (`record_closure_capture_verdicts`).
    (borrows_captures : bool) ?= false
  ) -> unit
)({
  match(
    wrapper_type,
    .SomeT({ required_trait_types : rtts }) => {
      (ti : usize) = usize(0);
      while(ti < rtts.len(), ti = (ti + usize(1)), {
        trait_type := rtts(ti);
        if(!is_fn_trait_type(&trait_type), {
          trait_name := type_to_string(&trait_type);
          // A borrow capture is never `Send` (decision 38 E).
          if(borrows_captures && (trait_name == "Send"), {
            _raise_capture_trait_violation(
              ctx,
              exn,
              error_token,
              `This closure does not implement Send: ${_borrowed_captures_offense}. A closure that crosses threads must own its captures: pass it to an owning (sink) parameter, which moves them in (issues/fixed/a-move-only-value-cannot-be-moved-into-thread-spawn.md).`
            );
          });
          // Per-variable first: each offending capture gets its own error at
          // the capture site, not the closure site.
          match(
            captured_variables_with_values,
            .Some(cvwv) => {
              key_iter := cvwv.keys();
              (more : bool) = true;
              while(more, {
                match(
                  key_iter.next(),
                  .None => {
                    more = false;
                  },
                  .Some(var_name) => match(
                    cvwv.get(var_name.clone()),
                    .None => (),
                    .Some(info) => if(!_declared_bound_requires(&info.ty, &trait_type), {
                      // A captured FUNCTION value holds a marker by its value
                      // — what it captures, what its code reaches (rules D4 +
                      // D1) — not by its type (`function_value_marker`).
                      match(
                        function_value_marker(&info.ty, &info.value, &trait_type, env, ctx),
                        .Some(.Some(fvm_o)) => {
                          _raise_capture_trait_violation(
                            ctx,
                            exn,
                            &info.token,
                            `Captured variable '${var_name}' (type ${type_to_string(&info.ty)}) does not implement ${trait_name}: ${fvm_o}.`
                          );
                        },
                        .Some(.None) => (),
                        .None => match(
                          _capture_judgement_type(&info.ty, &info.value),
                          .None => (),
                          .Some(judged) => if(!type_implements_trait_bool(&judged, &trait_type, env), {
                            var_msg := `Captured variable '${var_name}' (type ${type_to_string(&info.ty)}) does not implement ${trait_name}. To move it across threads, wrap it in Arc/Iso, or capture a ${trait_name} projection of it instead.`;
                            _raise_capture_trait_violation(ctx, exn, &info.token, &var_msg);
                          })
                        )
                      );
                    })
                  )
                );
              });
            },
            .None => ()
          );
          // Then the capture struct as a whole — only when no per-variable
          // information exists: the struct's fields ARE the captured
          // variables, and re-judging a captured closure's wrapper SomeT
          // field without its value would undo the resolution above.
          if(captured_variables_with_values.is_none() && !type_implements_trait_bool(capture_type, &trait_type, env), {
            details := String.new();
            match(
              capture_type,
              .Struct({ field_labels : fls, field_types : fts }) => {
                (fi : usize) = usize(0);
                while(fi < fls.len(), fi = (fi + usize(1)), {
                  match(
                    fts.get(fi),
                    .Some(fty) => if(!type_implements_trait_bool(&fty, &trait_type, env), {
                      if(details.len() > usize(0), {
                        details.push_str("\n  ");
                      });
                      fl := match(fls.get(fi), .Some(l) => l, .None => String.from(""));
                      details.push_string(`'${fl}' has type ${type_to_string(&fty)} which does not implement ${trait_name}`);
                    }),
                    .None => ()
                  );
                });
              },
              _ => ()
            );
            agg_msg := `Closure does not implement ${trait_name} because captured variable ${details}`;
            _raise_capture_trait_violation(ctx, exn, error_token, &agg_msg);
          });
        });
      });
    },
    _ => ()
  );
});
// ---------------------------------------------------------------------------
// enrich_captured_variables
// ---------------------------------------------------------------------------
/// Look up each captured variable in `env` (at its `frame_level`) to
/// discover its concrete type and runtime value.  Compile-time-only
/// variables are excluded from captures (they are always inlined).
///
/// Returns a map of name → `FuncCapturedVarInfo`.
enrich_captured_variables :: (
  fn(
    captured_variables : &HashMap(String, CapturedVarInfo),
    env : &Environment
  ) -> HashMap(String, FuncCapturedVarInfo)
)({
  result := HashMap(String, FuncCapturedVarInfo).new();
  key_iter := captured_variables.keys();
  (more : bool) = true;
  while(more, {
    match(
      key_iter.next(),
      .None => {
        more = false;
      },
      .Some(var_name) => {
        vn_copy := var_name.clone();
        cap_info_opt := captured_variables.get(var_name.clone());
        match(
          cap_info_opt,
          .None => (),
          .Some(cap_info) => {
            fl := cap_info.frame_level;
            n_frames := env.frames.len();
            if(debug_knob(`YO_DEBUG_CAPTURE`).is_some(), {
              enr_found := get_variables_from_env(env, var_name.clone());
              (enr_cto : usize) = usize(0);
              (enr_k : usize) = usize(0);
              while(enr_k < enr_found.len(), enr_k = (enr_k + usize(1)), {
                match(
                  enr_found.get(enr_k),
                  .Some(ev) => if(ev.is_compile_time_only, {
                    enr_cto = (enr_cto + usize(1));
                  }),
                  .None => ()
                );
              });
              eprintln(`[cap-enr] name=${var_name} fl=${fl.to_string()} n_frames=${n_frames.to_string()} found=${enr_found.len().to_string()} cto=${enr_cto.to_string()}`);
            });
            if(fl < n_frames, {
              vars := get_variables_from_env(env, var_name.clone());
              m := vars.len();
              (j : usize) = usize(0);
              while(j < m, {
                match(
                  vars.get(j),
                  .None => (),
                  .Some(v) => {
                    if(!v.is_compile_time_only, {
                      enriched := FuncCapturedVarInfo(
                        frame_level : fl,
                        usage : cap_info.usage,
                        token : cap_info.token,
                        ty : v.ty,
                        value : v.value.get(usize(0)),
                        is_effect_param : v.is_effect_param,
                        decl_site : `${v.token.module_path}:${v.token.row.to_string()}:${v.token.column.to_string()}`
                      );
                      result.insert(vn_copy.clone(), enriched);
                      ()
                    });
                  }
                );
                j = (j + usize(1));
              });
            });
          }
        );
      }
    );
  });
  result
});
/// Record a nested closure's captures on the ENCLOSING closure or async body
/// being evaluated in `ctx`: a variable the inner closure captures from
/// outside the enclosing one must be in the enclosing capture struct too,
/// since the inner capture struct is built from it there.
/// `track_variable_usage_resolved` keeps only names from outside the
/// enclosing body (and drops its own parameters), exactly as for an
/// identifier read. This used to happen only as a side effect of evaluating
/// the RC capture's `___dup(name)` in the enclosing context, so a non-RC
/// capture (a closure-typed `Impl(Fn)` parameter bound to a zero-size capture
/// struct) was missing from the enclosing capture struct
/// (issues/fixed/a-closure-capture-reaches-its-enclosing-closure-only-when-it-is-rc.md).
propagate_captures_to_enclosing :: (fn(caps : &HashMap(String, CapturedVarInfo), ctx : &EvalContext) -> unit)({
  key_iter := caps.keys();
  (more : bool) = true;
  while(more, {
    match(
      key_iter.next(),
      .None => {
        more = false;
      },
      .Some(name) => match(
        caps.get(name.clone()),
        .Some(info) => track_variable_usage_resolved(&name, info.frame_level, info.usage, &info.token, ctx, Option(bool).None),
        .None => ()
      )
    );
  });
});
// ---------------------------------------------------------------------------
// create_capture_type_and_value
// ---------------------------------------------------------------------------
/// Create the capture struct type (and optional value) for a closure from
/// its captured variables.
///
/// Phase 3 simplified inference path:
///   - If `expected_capture_type` is None (the common case), create an
///     anonymous struct from the captured variables' names and types.
///   - If there are no captured variables, create an empty struct.
///   - Explicit capture struct types (expected_capture_type = Some(T)) are
///     deferred to Phase 4.
create_capture_type_and_value :: (
  fn(
    expected_capture_type : &Option(TypeValue),
    captured_vars_with_values : &Option(HashMap(String, FuncCapturedVarInfo)),
    env : &Environment,
    closure_tok : &Token
  ) -> CaptureTypeAndValueResult
)(
  // Phase 4: explicit capture struct type check.
  match(
    expected_capture_type,
    .Some(_) =>
      // Explicit capture type — deferred to Phase 4.
      // For now return None capture (will be refined).
      CaptureTypeAndValueResult(
        capture_type : Option(TypeValue).None,
        capture_value : Option(EvalValue).None,
        env : env
      ),
    .None => {
      // Inference case: build struct from captured variables.
      field_labels := ArrayList(String).new();
      field_types := ArrayList(TypeValue).new();
      type_fields := ArrayList(TypeField).new();
      cap_values := ArrayList(Option(EvalValue)).new();
      has_any_caps := match(
        captured_vars_with_values,
        .None => false,
        .Some(cvwv) => (cvwv.len() > usize(0))
      );
      if(has_any_caps, {
        cvwv := match(captured_vars_with_values, .Some(m) => m, .None => HashMap(String, FuncCapturedVarInfo).new());
        key_iter := cvwv.keys();
        (more_keys : bool) = true;
        while(more_keys, {
          match(
            key_iter.next(),
            .None => {
              more_keys = false;
            },
            .Some(cap_name) => {
              match(
                cvwv.get(cap_name.clone()),
                .None => (),
                .Some(fci) => {
                  field_labels.push(cap_name.clone());
                  field_types.push(fci.ty);
                  cap_values.push(fci.value);
                  type_fields.push(
                    TypeField(
                      label : cap_name.clone(),
                      ty : fci.ty,
                      is_comptime : false,
                      default_value : Option(EvalValue).None,
                      assigned_value : Option(EvalValue).None,
                      doc_comment : Option(String).None,
                      is_effect_param : fci.is_effect_param
                    )
                  );
                }
              );
            }
          );
        });
      });
      // Stable capture-struct id (see g_capture_struct_ids note): keyed by the
      // closure's source position + capture field signature, reused across evals.
      cap_key := String.from("cap@");
      cap_key.push_string(closure_tok.module_path.clone());
      cap_key.push_str(":");
      cap_key.push_string(usize(closure_tok.row).to_string());
      cap_key.push_str(":");
      cap_key.push_string(usize(closure_tok.column).to_string());
      cap_key.push_str(":");
      cap_key.push_string(usize(closure_tok.character).to_string());
      cap_key.push_str("|");
      (csi : usize) = usize(0);
      while(csi < field_labels.len(), {
        cap_key.push_string(match(field_labels.get(csi), .Some(l) => l, .None => String.from("")));
        cap_key.push_str(":");
        cap_key.push_string(match(field_types.get(csi), .Some(t) => type_to_string(&t), .None => String.from("")));
        // RESOLUTION-aware key suffix: a SomeT field type renders the SAME
        // `type_to_string` whether abstract (def-era eval — the captured
        // closure param is unbound, field lowers to void*) or resolved
        // (spec-era eval — the capbind SomeT's resolution is the concrete
        // capture struct). One shared struct froze the FIRST era's field
        // types, so the resolved-era spec initialized a void* field with a
        // concrete struct value (clang error; the forwarded-closure family,
        // tests/closure_param_forwarding.test.yo arm 2). Append the resolved
        // identity so the two eras mint DISTINCT capture structs.
        match(
          field_types.get(csi),
          .Some(ck_t) => match(
            ck_t,
            .SomeT({ id : ck_sid, resolution : ck_rc }) => {
              cap_key.push_str("@res:");
              match(
                ck_rc,
                .Some(ck_r) => cap_key.push_string(type_to_string(&ck_r)),
                .None => cap_key.push_string(ck_sid.clone())
              );
            },
            _ => ()
          ),
          .None => ()
        );
        cap_key.push_str(",");
        csi = (csi + usize(1));
      });
      struct_id := match(
        g_capture_struct_ids.get(cap_key.clone()),
        .Some(existing) => existing,
        .None => {
          // Phase 2: content-addressed (hash of the cap_key, which is itself
          // position/type-stable) instead of the global counter, with the
          // same `_x<k>` collision fallback the type-name interner uses.
          base := `capture_${fnv1a64(cap_key.clone()).to_string()}`;
          fresh := base.clone();
          (ord : usize) = usize(1);
          loop_ok := runtime(true);
          while(loop_ok, {
            match(
              g_capture_struct_ids_r.get(fresh.clone()),
              .Some(owner) => {
                if(owner == cap_key, {
                  loop_ok = false;
                }, {
                  fresh = `${base}_x${ord.to_string()}`;
                  ord = (ord + usize(1));
                });
              },
              .None => {
                loop_ok = false;
              }
            );
          });
          g_capture_struct_ids.insert(cap_key.clone(), fresh.clone());
          g_capture_struct_ids_r.insert(fresh.clone(), cap_key.clone());
          fresh
        }
      );
      // Register field metadata, and each field's binding by declaration site:
      // the io.async re-kind pass tells a capture from a body binding of the
      // same name by it (src/codegen/exprs/async.yo).
      register_struct_fields(struct_id.clone(), &type_fields);
      match(
        captured_vars_with_values,
        .Some(sites_cvwv) => {
          (dsi : usize) = usize(0);
          while(dsi < field_labels.len(), dsi = (dsi + usize(1)), {
            match(
              field_labels.get(dsi),
              .Some(dl) => match(sites_cvwv.get(dl.clone()), .Some(dfci) => register_capture_field_decl_site(struct_id.clone(), &dl, &dfci.decl_site), .None => ()),
              .None => ()
            );
          });
        },
        .None => ()
      );
      // Build the capture struct TypeValue.
      capture_ty := TypeValue.Struct(
        struct_id.clone(),
        String.from(""),
        field_labels,
        field_types,
        false,
        false,
        false,
        String.from(""),
        ArrayList(TypeValue).new(),
        false
      );
      // Auto-derive trait markers for the capture struct.
      auto_derive_traits_for_struct_type(
        struct_id.clone(),
        &field_types,
        false,
        false,
        env,
        &capture_ty
      );
      // Build the capture struct EvalValue if all values are known.
      n_caps := cap_values.len();
      (all_known : bool) = true;
      (cv_i : usize) = usize(0);
      while(cv_i < n_caps, {
        match(
          cap_values.get(cv_i),
          .None => (),
          .Some(v_opt) => {
            match(
              v_opt,
              .None => {
                all_known = false;
              },
              .Some(_) => ()
            );
          }
        );
        cv_i = (cv_i + usize(1));
      });
      // Collect concrete values for StructVal if all are known.
      cap_struct_val := if(all_known, {
        concrete_vals := ArrayList(EvalValue).new();
        (ci : usize) = usize(0);
        while(ci < n_caps, {
          match(
            cap_values.get(ci),
            .None => (),
            .Some(v_opt) => {
              match(
                v_opt,
                .None => (),
                .Some(v) => {
                  concrete_vals.push(v);
                }
              );
            }
          );
          ci = (ci + usize(1));
        });
        // Use struct_id as the type name for the StructVal.
        Option(EvalValue).Some(
          EvalValue.StructVal(
            struct_id.clone(),
            field_labels,
            concrete_vals
          )
        )
      }, Option(EvalValue).None);
      CaptureTypeAndValueResult(
        capture_type : Option(TypeValue).Some(capture_ty),
        capture_value : cap_struct_val,
        env : env
      )
    }
  )
);
// ---------------------------------------------------------------------------
// generate_captured_variable_dup_expressions
// ---------------------------------------------------------------------------
/// Some captured variable's type is not implicitly copyable.
_captures_require_explicit_copy :: (fn(cvwv_opt : &Option(HashMap(String, FuncCapturedVarInfo))) -> bool)(
  match(
    cvwv_opt,
    .Some(cvwv) => {
      it := cvwv.values();
      (more : bool) = true;
      (found : bool) = false;
      while(more && !found, {
        match(
          it.next(),
          .Some(ci) => if(type_requires_explicit_copy(&ci.ty), {
            found = true;
          }),
          .None => {
            more = false;
          }
        );
      });
      found
    },
    .None => false
  )
);
/// Result type for `generate_captured_variable_dup_expressions`.
CapturedVarDupResult :: struct(
  dup_exprs : Option(ArrayList(AstExpr)),
  env : Environment,
  /// The closure borrows its captures (see `borrow_captures` below): it owns
  /// nothing, so its value gets no owning temp and no drop.
  borrowed : bool
);
/// Generate `___dup()` expressions for captured ARC variables — one evaluated
/// `___dup(name)` per captured variable whose type contains an RC-managed
/// type. Codegen (generate_closure_construction) emits these as the capture
/// struct's field initializers, so the capture holds its OWN reference; the
/// constructing scope's local can then be dropped without freeing the value
/// under the closure (the Command.status spawn-storage UAF).
///
/// The env is mutated in place, so the updated env needs no threading
/// through the evaluated exprs — same as the `___drop` builder in
/// exprs/begin.yo.
generate_captured_variable_dup_expressions :: (
  fn(
    captured_vars_with_values : &Option(HashMap(String, FuncCapturedVarInfo)),
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception,
    /// The closure's token: where a capture that is not implicitly copyable
    /// is moved, and the copy site YO_AUDIT_IMPLICIT_COPY reports for each
    /// dupped capture.
    closure_tok : &Token,
    /// The closure literal is the direct argument of a borrowing parameter,
    /// so it cannot outlive the call (plans/VALUES_BY_DEFAULT.md decision 22).
    /// When it captures a value that is not implicitly copyable, it borrows
    /// ALL its captures: no dup, no move, and every captured variable stays
    /// usable after the call. (A non-escaping closure capturing only
    /// copyable values keeps today's dupped captures; decision 22's general
    /// form is its own measured change.)
    (borrow_captures : bool) ?= false
  ) -> CapturedVarDupResult
)({
  dup_exprs := ArrayList(AstExpr).new();
  if(borrow_captures && _captures_require_explicit_copy(captured_vars_with_values), {
    return(CapturedVarDupResult(dup_exprs : Option(ArrayList(AstExpr)).None, env : env, borrowed : true));
  });
  match(
    captured_vars_with_values,
    .Some(cvwv) => if(cvwv.len() > usize(0), {
      key_iter := cvwv.keys();
      (done : bool) = false;
      while(!done, {
        match(
          key_iter.next(),
          .Some(var_name) => match(
            cvwv.get(var_name.clone()),
            .Some(ci) => cond(
              // A capture that is not implicitly copyable (a move-only one)
              // is MOVED into the capture struct
              // (plans/VALUES_BY_DEFAULT.md §3.4, §3.7): no dup, the field
              // is initialized from the variable itself, and the variable is
              // consumed, so its scope-end drop is skipped and the closure's
              // drop disposes it. The capture struct is move-only too, by
              // containment.
              type_requires_explicit_copy(&ci.ty) => {
                cap_vars := get_variables_from_env(env, var_name.clone());
                match(
                  cap_vars.last(),
                  .Some(cap_v) => if(!cap_v.is_compile_time_only, {
                    move_captured_explicit_copy_variable(&cap_v, closure_tok, env, ctx, exn);
                  }),
                  .None => ()
                );
              },
              type_contains_rc_type(&ci.ty) => {
                if(audit_implicit_copy_enabled(), {
                  audit_record_implicit_copy(closure_tok, &ci.ty, "capture", env, var_name.clone(), var_name.clone(), ctx, false);
                });
                dup_code := `___dup(${var_name})`;
                dup_expr := generate_expr_from_code(&dup_code, exn);
                evaluated := evaluate_expression_raw(&dup_expr, env, ctx, exn);
                dup_exprs.push(evaluated);
              },
              // YO_AUDIT_COPY_TRAIT: a plain-data capture is a copy too.
              audit_copy_trait_enabled() => audit_record_copy_trait(closure_tok, &ci.ty, "capture", env, generate_expr_from_code(var_name.clone(), exn), ctx, false),
              true => ()
            ),
            .None => ()
          ),
          .None => {
            done = true;
          }
        );
      });
    }),
    .None => ()
  );
  CapturedVarDupResult(
    dup_exprs : if(dup_exprs.len() > usize(0), Option(ArrayList(AstExpr)).Some(dup_exprs), Option(ArrayList(AstExpr)).None),
    env : env,
    borrowed : false
  )
});
// ---------------------------------------------------------------------------
// Structural clone (plans/VALUES_BY_DEFAULT.md decision 36)
// ---------------------------------------------------------------------------
/// The hole a clone template's receiver goes into (`_clone_subst_receiver`).
_CLONE_RECV_HOLE :: "__yo_clone_recv";
/// The closure identity `ty` reaches: `ty` itself, or a type variable whose
/// resolution chain reaches one (a generic `T` instantiated with a closure's
/// type).
closure_identity_of :: (fn(ty : &TypeValue) -> Option(TypeValue))({
  (cur : TypeValue) = ty;
  (depth : usize) = usize(0);
  while(depth < usize(16), {
    if(is_bound_closure_identity(&cur), {
      return(Option(TypeValue).Some(cur));
    });
    match(
      cur,
      .SomeT({ resolution : ci_res }) => match(
        ci_res,
        .Some(next) => {
          cur = next;
        },
        .None => {
          return(Option(TypeValue).None);
        }
      ),
      _ => {
        return(Option(TypeValue).None);
      }
    );
    depth = (depth + usize(1));
  });
  Option(TypeValue).None
});
/// A receiver a clone template may name more than once: a binding, or a
/// field or dereference step of one. Reading it again has no effect.
_clone_receiver_is_place :: (fn(e : &AstExpr) -> bool)(
  match(
    e,
    .Atom(_, _) => true,
    .FnCall(_, _, pl_args, _, _) => (
      ast_expr_is_fn_call_of(e, BF_DOT, Option(usize).Some(usize(2))) && match(pl_args.get(usize(1)), .Some(.Atom(_, _)) => true, _ => false) && match(pl_args.get(usize(0)), .Some(pl_base) => recur(&pl_base), .None => false)
    )
  )
);
/// `e` with every `_CLONE_RECV_HOLE` atom replaced by a fresh-id copy of
/// `recv`.
_clone_subst_receiver :: (fn(e : &AstExpr, recv : &AstExpr) -> AstExpr)(
  match(
    e,
    .Atom(_, _) => if(ast_expr_is_atom_of(e, _CLONE_RECV_HOLE), clone_expr_fresh_ids(recv), e.clone()),
    .FnCall(cs_id, cs_func, cs_args, cs_infix, cs_tok) => {
      new_args := ArrayList(AstExpr).new();
      (i : usize) = usize(0);
      while(i < cs_args.len(), {
        new_args.push(recur(match(cs_args.get(i), .Some(a) => a, .None => make_err_expr()), recv));
        i = (i + usize(1));
      });
      AstExpr.FnCall(cs_id, recur(&cs_func, recv), new_args, cs_infix, cs_tok.clone())
    }
  )
);
/// Parse `code` (which names the receiver as `_CLONE_RECV_HOLE`), put `recv`
/// in the hole and evaluate it.
_eval_clone_template :: (fn(code : &String, recv : &AstExpr, env : &Environment, ctx : &EvalContext, exn : Exception) -> AstExpr)({
  parsed := generate_expr_from_code(code, exn);
  // The template is its own value: the type the enclosing expression expects
  // (a generic `T`, the closure's) is not a field's, nor a record literal's.
  saved_expected := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  out := evaluate_expression_raw(&_clone_subst_receiver(&parsed, recv), env, ctx, exn);
  ctx.expected_type = saved_expected;
  out
});
/// `expr` (`recv.clone()`) expands to the evaluated `generated` node, with
/// that node's type and value, recorded durably as the numeric conversions'
/// are. The info is a fresh one: `generated`'s own shares its `rare` record,
/// so setting the expansion there made `generated` expand to itself (a walk
/// following `macro_expansion` never returned).
_expand_clone_to :: (fn(expr : &AstExpr, generated : &AstExpr, ctx : &EvalContext) -> AstExpr)({
  match(
    expr_info_table_get(&ctx.expr_info_table, ast_expr_id(generated)),
    .Some(gen_info) => {
      out := new_expr_info(&gen_info.env, &gen_info.ty);
      out.value = gen_info.value;
      out.control_flow = gen_info.control_flow;
      out.variable_name = gen_info.variable_name;
      record_macro_expansion(ast_expr_id(expr), generated.clone());
      expr_info_set_macro_expansion(&out, Option(AstExpr).Some(generated));
      expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out);
    },
    .None => ()
  );
  expr
});
/// `recv.clone()` on a closure or an anonymous record that is `Clone` but not
/// `Copy` (decision 36): the field-wise clone no impl can name. A part that is
/// `Copy` (a scalar, a `&` capture's pointer) is copied, every other part is
/// cloned, and the result has the receiver's own type:
///
/// - an anonymous record expands to the record literal
///   `_(a : recv.a.clone(), b : recv.b)`;
/// - a closure becomes a construction of its capture record whose fields are
///   initialized from the receiver's (`__yo_capture_field(recv, i)`), lowered
///   by the closure-construction emitter (`generate_closure_construction`).
///
/// A receiver that is not a place is bound first, so it is evaluated once:
/// `{ __yo_clone_src := recv; __yo_clone_src.clone() }`. `.None` when `target`
/// (the receiver's type, resolved) is neither, or is not `Clone`.
structural_clone_expansion :: (
  fn(expr : &AstExpr, recv : &AstExpr, recv_ty : &TypeValue, target : &TypeValue, env : &Environment, ctx : &EvalContext, exn : Exception) -> Option(AstExpr)
)({
  clone_tt := match(
    get_trait_type_from_env(env, String.from("Clone")),
    .Some(t) => t,
    .None => {
      return(Option(AstExpr).None);
    }
  );
  copy_tt := match(
    get_trait_type_from_env(env, String.from("Copy")),
    .Some(t) => t,
    .None => {
      return(Option(AstExpr).None);
    }
  );
  closure_ty := closure_identity_of(recv_ty);
  (fields_labels, fields_types) := match(
    target,
    .Struct({ field_labels : sc_labels, field_types : sc_types }) => (sc_labels, sc_types),
    _ => {
      return(Option(AstExpr).None);
    }
  );
  if(!type_implements_trait_bool(target, &clone_tt, env), {
    return(Option(AstExpr).None);
  });
  if(!_clone_receiver_is_place(recv), {
    bind_code := `{ __yo_clone_src := ${_CLONE_RECV_HOLE}; __yo_clone_src.clone() }`;
    bound := _eval_clone_template(&bind_code, recv, env, ctx, exn);
    return(Option(AstExpr).Some(_expand_clone_to(expr, &bound, ctx)));
  });
  if(closure_ty.is_none() && !is_closure_capture_struct(target), {
    // An anonymous record: its literal, field by field.
    code := String.from("_(");
    (ri : usize) = usize(0);
    while(ri < fields_labels.len(), {
      label := match(fields_labels.get(ri), .Some(l) => l, .None => String.new());
      ft := match(fields_types.get(ri), .Some(t) => t, .None => t_unit());
      if(ri > usize(0), {
        code.push_str(", ");
      });
      entry := `${label} : ${_CLONE_RECV_HOLE}.${label}`;
      code.push_string(&entry);
      if(!type_implements_trait_bool(&ft, &copy_tt, env), {
        code.push_str(".clone()");
      });
      ri = (ri + usize(1));
    });
    code.push_str(")");
    record := _eval_clone_template(&code, recv, env, ctx, exn);
    // The literal builds the receiver's record type, not a new anonymous
    // record type of its own (whose C struct is a different one): a
    // `where(T <: Clone)` body returns it as `T`. Its `_` callee names the
    // type the constructor builds.
    match(
      expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&record)),
      .Some(rec_info) => {
        rec_info.ty = target.clone();
        expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&record), &rec_info);
      },
      .None => ()
    );
    rec_callee := match(record, .FnCall(_, rc_f, _, _, _) => rc_f, .Atom(_, _) => record.clone());
    match(
      expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&rec_callee)),
      .Some(rc_info) => match(
        rc_info.value,
        .Some(.TypeVal(_)) => {
          rc_info.value = Option(EvalValue).Some(EvalValue.TypeVal(target.clone()));
          expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&rec_callee), &rc_info);
        },
        _ => ()
      ),
      .None => ()
    );
    return(Option(AstExpr).Some(_expand_clone_to(expr, &record, ctx)));
  });
  // A closure: a new capture record with the same code.
  inits := ArrayList(CaptureFieldInit).new();
  (ci : usize) = usize(0);
  while(ci < fields_labels.len(), {
    label := match(fields_labels.get(ci), .Some(l) => l, .None => String.new());
    ft := match(fields_types.get(ci), .Some(t) => t, .None => t_unit());
    read := `${BF_YO_CAPTURE_FIELD}(${_CLONE_RECV_HOLE}, ${ci.to_string()})`;
    init_code := if(type_implements_trait_bool(&ft, &copy_tt, env), read, `${read}.clone()`);
    init := _eval_clone_template(&init_code, recv, env, ctx, exn);
    // The clone is stored into the new record's field: the store moves it,
    // as a capture list's by-value entry is moved.
    set_expr_as_needs_to_call_dup(&init, ctx, exn, "field-store");
    inits.push(CaptureFieldInit(label : label, init : init, is_borrow : false));
    ci = (ci + usize(1));
  });
  out := new_expr_info(env, recv_ty);
  expr_info_set_capture_type(&out, &Option(TypeValue).Some(target.clone()));
  expr_info_set_capture_field_inits(&out, &Option(ArrayList(CaptureFieldInit)).Some(inits));
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out);
  // A fresh value that owns its captures, like a closure literal's
  // (`evaluate_anonymous_function_implementation`): an owning temp.
  if(type_contains_rc_type(target), {
    attach_temp_variable_to_expr(expr, true, ctx);
  });
  Option(AstExpr).Some(expr)
});
/// `__yo_capture_field(c, i)`: the type of field `i` of closure `c`'s capture
/// record. The read is in place: a clone template passes it to the field
/// type's `clone`, or copies a `Copy` field.
evaluate_yo_capture_field :: (fn(expr : &AstExpr, env : &Environment, ctx : &EvalContext, exn : Exception) -> AstExpr)({
  cf_args := match(expr, .FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
  recv := match(cf_args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
  idx_e := match(cf_args.get(usize(1)), .Some(a) => a, .None => make_err_expr());
  ev_recv := evaluate_expression_raw(&recv, env, ctx, exn);
  _ := evaluate_expression_raw(&idx_e, env, ctx, exn);
  recv_ty := match(expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&ev_recv)), .Some(ri) => ri.ty, .None => t_unit());
  cap := resolve_cell_chain(match(closure_identity_of(&recv_ty), .Some(cl) => cl, .None => recv_ty));
  idx := match(ast_expr_token(&idx_e).value.parse_i64(), .Some(n) => usize(n), .None => usize(0));
  field_ty := match(
    cap,
    .Struct({ field_types : cf_types }) => match(cf_types.get(idx), .Some(t) => t, .None => t_unit()),
    _ => {
      exn.throw(dyn(format_error_message(ast_expr_token(expr), `__yo_capture_field: ${type_to_string(&recv_ty)} is not a closure`)));
      t_unit()
    }
  );
  out := new_expr_info(env, &field_ty);
  out.value = Option(EvalValue).None;
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out);
  expr
});
