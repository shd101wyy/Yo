//! evaluator/utils/closure — closure capture helpers.
//!
//! Phase 3 simplifications:
//!   - `consume_captured_variables`             → no-op (no move semantics)
//!   - `build_path_collection_from_captured_variables` → empty list
//!   - `validate_capture_trait_requirements`    → no-op
//!   - `generate_captured_variable_dup_expressions` → no ARC (returns None)
//!   - `create_capture_type_and_value`          → simplified inference only;
//!     explicit capture struct type deferred to Phase 4.
//!   - `autoDeriveTraitsAndAddRcFunctions…`     → calls auto_derive_traits_for_struct_type
{ String } :: import("std/string");
{ function_reaches_non_send_global, d1_reach_memo } :: import("../effects/mutation_summary.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ eprintln } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{
  AstExpr
} :: import("../../expr.yo");
{ Token } :: import("../../token.yo");
{
  Variable,
  Environment,
  get_variables_from_env
} :: import("../../env.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ get_trait_type_from_env } :: import("../../types/env_lookup.yo");
{ type_to_string } :: import("../../types/string.yo");
{ is_fn_trait_type, is_some_type, is_function_type } :: import("../../types/guards.yo");
{ format_error_message } :: import("../../error.yo");
{ type_implements_trait_bool, extract_fn_trait_from_type } :: import("../trait_checking.yo");
{ raise_flow_violation } :: import("../../types/flowability.yo");
{ lookup_some_resolved_concrete } :: import("../../expr_info.yo");
{ get_closure_capture_info, get_func_type } :: import("../../function_value.yo");
// Deterministic capture-struct ids: keyed by the closure's source position +
// capture field signature, so the SAME closure (re-evaluated across the eval and
// codegen passes) gets the SAME capture-struct id. A fresh `random_id` per call
// produced DIFFERENT ids for one closure (e.g. construction `..._5638` vs a
// specialized callee's eval-time param `..._5654`), breaking the
// impl_closure_call_map lookup that links a capture struct to its closure impl fn
// (Thread.spawn). The key is unique per closure source AND per capture-type
// instantiation, so distinct closures never collide.
(g_capture_struct_ids : HashMap(String, String)) = HashMap(String, String).new();
/// Reverse map (id → cap_key) for the hash-collision backstop below — a
/// silent 64-bit collision would merge two capture structs in the emitted C.
(g_capture_struct_ids_r : HashMap(String, String)) = HashMap(String, String).new();
{
  EvalValue
} :: import("../../value.yo");
{
  CapturedVarInfo,
  CaptureUsage,
  EvalContext,
  set_function_value_marker_fn
} :: import("../context.yo");
{
  TypeField
} :: import("../types/field.yo");
{
  register_struct_fields
} :: import("../types/field.yo");
{ fnv1a64, debug_knob } :: import("../../utils.yo");
{ type_contains_rc_type, is_closure_capture_struct, is_bound_closure_identity, resolve_cell_chain } :: import("../../types/utils.yo");
{ generate_expr_from_code } :: import("../../parser.yo");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
{ auto_derive_traits_for_struct_type } :: import("../types/utils.yo");
// ---------------------------------------------------------------------------
// FuncCapturedVarInfo
// ---------------------------------------------------------------------------
/// `CapturedVarInfo` enriched with the actual type and optional value of the
/// captured variable.  Produced by `enrich_captured_variables`.
FuncCapturedVarInfo :: struct(
  frame_level : usize,
  usage : CaptureUsage,
  token : Token,
  ty : TypeValue,
  value : Option(EvalValue),
  is_effect_param : bool
);
// ---------------------------------------------------------------------------
// CaptureTypeAndValueResult
// ---------------------------------------------------------------------------
/// Result type for `create_capture_type_and_value`.
CaptureTypeAndValueResult :: struct(
  capture_type : Option(TypeValue),
  capture_value : Option(EvalValue),
  env : Environment
);
// ---------------------------------------------------------------------------
// consume_captured_variables
// ---------------------------------------------------------------------------
/// Mark closure-captured variables as consumed (move semantics).
///
/// Phase 3 stub: no move semantics yet — returns env unchanged.
consume_captured_variables :: (
  fn(
    _captured_variables : HashMap(String, CapturedVarInfo),
    env : Environment,
    _closure_token : Token
  ) -> Environment
)(env);
// ---------------------------------------------------------------------------
// build_path_collection_from_captured_variables
// ---------------------------------------------------------------------------
/// Build a path collection (list of variable-name paths) from captured
/// variables.  Used for borrow tracking in C codegen.
///
/// Phase 3 simplification: returns an empty list.
build_path_collection_from_captured_variables :: (
  fn(
    _captured_variables : HashMap(String, CapturedVarInfo)
  ) -> ArrayList(ArrayList(String))
)(
  ArrayList(ArrayList(String)).new()
);
// ---------------------------------------------------------------------------
// validate_capture_trait_requirements
// ---------------------------------------------------------------------------
/// Raise a capture-trait violation so it SURVIVES the def-time trial wall. A
/// closure body is usually created inside a def-time TRIAL evaluation, which
/// swallows thrown errors (anonymous_function.yo's def-eval wall); a `Send`
/// violation is a deliberate rejection, so it takes the wall's re-raise
/// channel — flag a flow violation first, then throw — the same shape as the
/// callable-argument and C19 checks in calls/helper.yo.
_raise_capture_trait_violation :: (
  fn(ctx : EvalContext, exn : Exception, tok : Token, msg : String) -> unit
)(raise_flow_violation(format_error_message(tok, msg), ctx, exn));
/// The type a captured variable is JUDGED by for a marker trait such as
/// `Send`. A captured CLOSURE arrives as its `Impl(Fn(...))` wrapper SomeT,
/// which carries no `Send` in its required traits — yet a closure is `Send`
/// iff its captures are (Rust's auto trait), and its captures live in its
/// capture struct, which auto-derives `Send` when every field is
/// (`auto_derive_traits_for_struct_type` above). Resolve the wrapper: the
/// SomeT's own resolved cell, then the global registry, then the VALUE's
/// registered capture struct. `.None` means "nothing to judge": a closure
/// with no capture struct captures nothing and is trivially `Send`.
/// (tests/sync/once.test.yo's `racer` — a closure over atomics, spawned
/// four times — was the one false rejection in the whole suite.)
_capture_judgement_type :: (fn(ty : TypeValue, value : Option(EvalValue)) -> Option(TypeValue))(
  match(
    ty,
    .SomeT({ id : sid, resolved_concrete : rc }) => match(
      rc.get(usize(0)),
      .Some(c) => Option(TypeValue).Some(c),
      .None => match(
        lookup_some_resolved_concrete(sid),
        .Some(c2) => Option(TypeValue).Some(c2),
        .None => match(
          value,
          .Some(v) => match(
            v,
            .FuncVal(fvd, _) => match(
              get_closure_capture_info(fvd.*.func_id.clone()),
              .Some(cci) => Option(TypeValue).Some(cci.capture_type),
              .None => Option(TypeValue).None
            ),
            _ => Option(TypeValue).Some(ty)
          ),
          .None => Option(TypeValue).Some(ty)
        )
      )
    ),
    _ => Option(TypeValue).Some(ty)
  )
);
/// True when a captured variable's OWN declared type already REQUIRES this
/// trait — an `Impl(Fn(...), Send)` parameter, say.
///
/// Such a capture is satisfied by its DECLARATION and must not be judged by
/// its resolution. The bound is a proof obligation the CALLER discharged when
/// it supplied the value — this same machinery rejects a non-`Send` closure at
/// that site — exactly as Rust's `F : Send` makes a captured `F` `Send`
/// without re-deriving anything.
///
/// Judging the RESOLVED capture struct instead asks the wrong question: the
/// struct is the argument closure's storage and carries no `Send` impl of its
/// own, so a correctly-bounded `cb` forwarded into a spawn closure was
/// rejected with "Captured variable 'cb' (type Impl : (Fn(Io) -> unit + Send))
/// does not implement Send" — an error whose own text contains the proof it
/// is wrong. That is D18b's third wall
/// (`plans/archive/STD_API_STABILIZATION.md` §2 D18).
///
/// Deliberately narrow: only a trait the declared wrapper itself lists. A
/// capture whose declared type carries NO such bound is judged exactly as
/// before, which is what keeps `tests/thread_safety.test.yo`'s
/// `_spawn_with_closure_over_ref` negative firing — `worker` there is declared
/// `Impl(Fn() -> unit)`, with no `Send`, so nothing here applies to it.
_declared_bound_requires :: (fn(ty : TypeValue, trait_type : TypeValue) -> bool)(
  match(
    ty,
    .SomeT({ required_trait_types : dbr_rtts }) => {
      want := type_to_string(trait_type);
      (dbr_i : usize) = usize(0);
      (dbr_found : bool) = false;
      while((dbr_i < dbr_rtts.len()) && !dbr_found, {
        match(
          dbr_rtts.get(dbr_i),
          .Some(dbr_t) => if(type_to_string(dbr_t) == want, {
            dbr_found = true;
          }),
          .None => ()
        );
        dbr_i = (dbr_i + usize(1));
      });
      dbr_found
    },
    _ => false
  )
);
// Rule D1 (plans/reference/PARALLELISM_RULES.md): a closure bound to a `Send`
// wrapper runs on another thread, so it may not reach a non-Send module-level
// global, directly or through the functions it calls
// (`function_reaches_non_send_global`). Separate from the capture check
// because a closure with NO captures has no capture struct and still reaches
// globals. A pragma'd file (std's relay closures included) is the audited
// ===========================================================================
// Rules D1 + D4 for function VALUES (plans/reference/PARALLELISM_RULES.md)
// ===========================================================================
// A function-like type — a bare `fn(...)`, a closure's `Impl(Fn...)` — holds
// `Send` only through its VALUES: a function value is `Send` iff its captured
// state is (D4) and its code reaches no thread-affine module global (D1).
// The type alone cannot say: two functions of one signature share the type,
// and a closure that captures nothing still runs code
// (issues/fixed/function-values-bypass-the-d1-reach-walk.md).
/// The closures created against each closure-typed SomeT, by the SomeT's id —
/// the only handle a type-level judgement (`Channel(typeof(k))`, a generic
/// binder bound to `k`'s type) has on the closure behind the type.
(g_closure_fids_by_some : HashMap(String, ArrayList(String))) = HashMap(String, ArrayList(String)).new();
/// The closures behind each capture struct, by the struct's id. Identity
/// treats a closure identity as its capture struct
/// (plans/reference/TYPE_IDENTITY.md), so a type argument can hold the bare
/// struct (`ArrayList(T)` with `T` bound through the wrapper's resolution),
/// and a capture-free closure's struct has no fields at all: judged as a
/// struct, it would be `Send` whatever its code reaches.
(g_closure_fids_by_capture : HashMap(String, ArrayList(String))) = HashMap(String, ArrayList(String)).new();
_some_id_of :: (fn(ty : TypeValue) -> String)(
  match(ty, .SomeT(sid, _, _, _, _, _, _, _, _, _, _) => sid, _ => String.new())
);
_capture_id_of :: (fn(ty : TypeValue) -> String)(
  if(is_closure_capture_struct(ty), match(ty, .Struct({ id : cid }) => cid, _ => String.new()), String.new())
);
_note_fid_for_some_id :: (fn(sid : String, fid : String) -> unit)(_note_fid_in(g_closure_fids_by_some, sid, fid));
_note_fid_in :: (fn(registry : HashMap(String, ArrayList(String)), sid : String, fid : String) -> unit)({
  if(sid.is_empty(), {
    return(());
  });
  match(
    registry.get(sid.clone()),
    .Some(fids) => {
      (seen : bool) = false;
      (fi : usize) = usize(0);
      while((fi < fids.len()) && !seen, {
        if(match(fids.get(fi), .Some(x) => (x == fid), .None => false), {
          seen = true;
        });
        fi = (fi + usize(1));
      });
      if(!seen, {
        fids.push(fid);
      });
    },
    .None => {
      fids := ArrayList(String).new();
      fids.push(fid);
      registry.insert(sid, fids);
    }
  );
});
/// Record that the SomeT with id `sid` names closure `fid`.
note_closure_for_some_id :: (fn(sid : String, fid : String) -> unit)(_note_fid_for_some_id(sid, fid));
/// A SomeT minted as a copy of closure SomeT `of_id` (a specialization's
/// fresh binder for a closure argument) names the same closures.
alias_closure_some_id :: (fn(new_id : String, of_id : String) -> unit)({
  match(
    g_closure_fids_by_some.get(of_id),
    .Some(fids) => {
      (ai : usize) = usize(0);
      while(ai < fids.len(), {
        match(fids.get(ai), .Some(f) => _note_fid_for_some_id(new_id.clone(), f), .None => ());
        ai = (ai + usize(1));
      });
    },
    .None => ()
  );
});
_is_function_like :: (fn(ty : TypeValue) -> bool)(
  (is_some_type(ty) && extract_fn_trait_from_type(ty).is_some()) || is_function_type(ty) || is_closure_capture_struct(ty)
);
/// Each closure's captured state judged per marker, taken where the closure is
/// created — per captured VARIABLE, with the captured values as witnesses, so
/// a captured function or closure is judged by its value and not by the field
/// type of the capture struct (a `fn` field is not `Send` as a type).
/// Keyed `fid|marker`; `.Some(reason)` names the first offending capture.
(g_closure_capture_offense : HashMap(String, Option(String))) = HashMap(String, Option(String)).new();
_captures_offense :: (
  fn(cvwv : HashMap(String, FuncCapturedVarInfo), marker : TypeValue, env : Environment, ctx : EvalContext) -> Option(String)
)({
  mname := type_to_string(marker);
  key_iter := cvwv.keys();
  (more : bool) = true;
  while(more, {
    match(
      key_iter.next(),
      .None => {
        more = false;
      },
      .Some(var_name) => match(
        cvwv.get(var_name.clone()),
        .None => (),
        .Some(info) => if(!_declared_bound_requires(info.ty, marker), {
          match(
            function_value_marker(info.ty, info.value, marker, env, ctx),
            .Some(fvm) => match(
              fvm,
              .Some(o) => {
                return(Option(String).Some(`its captured variable '${var_name}' does not implement ${mname}: ${o}`));
              },
              .None => ()
            ),
            .None => match(
              _capture_judgement_type(info.ty, info.value),
              .Some(judged) => if(!type_implements_trait_bool(judged, marker, env), {
                return(Option(String).Some(`its captured variable '${var_name}' (type ${type_to_string(info.ty)}) does not implement ${mname}`));
              }),
              .None => ()
            )
          );
        })
      )
    );
  });
  Option(String).None
});
/// Record closure `fid`'s capture verdicts (`Send`, `Acyclic`) at its creation.
record_closure_capture_verdicts :: (
  fn(fid : String, cvwv : Option(HashMap(String, FuncCapturedVarInfo)), capture_ty : Option(TypeValue), env : Environment, ctx : EvalContext) -> unit
)({
  // The capture struct names this closure too (`g_closure_fids_by_capture`).
  match(
    capture_ty,
    .Some(rcv_ct) => _note_fid_in(g_closure_fids_by_capture, _capture_id_of(rcv_ct), fid.clone()),
    .None => ()
  );
  match(
    cvwv,
    .Some(cv) => {
      markers := ArrayList(String).new();
      markers.push(String.from("Send"));
      markers.push(String.from("Acyclic"));
      (mi : usize) = usize(0);
      while(mi < markers.len(), {
        mn := match(markers.get(mi), .Some(m) => m, .None => String.new());
        match(
          get_trait_type_from_env(env, mn.clone()),
          .Some(mt) => {
            g_closure_capture_offense.insert(`${fid}|${mn}`, _captures_offense(cv, mt, env, ctx));
          },
          .None => ()
        );
        mi = (mi + usize(1));
      });
    },
    .None => ()
  );
});
/// A closure-typed SomeT that DECLARES `marker` (`Impl(Fn(...), Send)`): the
/// obligation was discharged where a value was converted into it (a literal
/// at its creation, an argument at the call, a result at the return).
_declares_marker :: (fn(ty : TypeValue, marker : TypeValue) -> bool)(
  match(
    ty,
    .SomeT({ required_trait_types : rtts }) => {
      want := type_to_string(marker);
      (found : bool) = false;
      (i : usize) = usize(0);
      while((i < rtts.len()) && !found, {
        match(
          rtts.get(i),
          .Some(t) => if(type_to_string(t) == want, {
            found = true;
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    _ => false
  )
);
/// Why the function value `fid` does not hold `marker`, or `.None`. The
/// captured state first (D4), then — for `Send` — what its code reaches (D1).
/// `body` is walked only when no verdict was memoized: a closure's own is
/// taken where it is created, with its defining env.
_function_value_offense :: (
  fn(fid : String, body : Option(AstExpr), marker : TypeValue, env : Environment, ctx : EvalContext) -> Option(String)
)({
  mname := type_to_string(marker);
  // The captures: the verdict taken at the closure's creation, per captured
  // variable; without one, the capture struct as a type.
  cap_hint := "a closure has a marker trait only when every value it captures does; capture an atomic object (Arc(T), Mutex(T), Atomic*) instead";
  match(
    g_closure_capture_offense.get(`${fid}|${mname}`),
    .Some(cv) => match(
      cv,
      .Some(co) => {
        return(Option(String).Some(`${co} — ${cap_hint}`));
      },
      .None => ()
    ),
    .None => match(
      get_closure_capture_info(fid.clone()),
      .Some(cci) => if(!type_implements_trait_bool(cci.capture_type, marker, env), {
        return(Option(String).Some(`its captured state (${type_to_string(cci.capture_type)}) does not implement ${mname} — ${cap_hint}`));
      }),
      .None => ()
    )
  );
  if(mname != "Send", {
    return(Option(String).None);
  });
  // An extern runs no Yo code.
  (is_extern : bool) = match(get_func_type(fid.clone()), .Func({ meta : fm }) => fm.*.extern_name.is_some(), _ => false);
  if(is_extern, {
    return(Option(String).None);
  });
  reach := match(
    d1_reach_memo(fid.clone()),
    .Some(r) => r,
    .None => match(
      body,
      .Some(b) => function_reaches_non_send_global(fid.clone(), b, ctx.expr_info_table, env),
      .None => Option(String).None
    )
  );
  match(
    reach,
    .Some(r) => Option(String).Some(`its code ${r}`),
    .None => Option(String).None
  )
});
/// The marker judgement of a function-like type from its VALUES
/// (`call_function_value_marker`, `context.yo`, documents the contract):
/// `witness` when the caller has the value; otherwise the values of `ty` in
/// scope — `env`'s function-local bindings of that type (a SomeT matched by
/// id, a bare `fn` by its rendering) — and the closures created against a
/// closure SomeT. `.None` when no value was found.
function_value_marker :: (
  fn(ty : TypeValue, witness : Option(EvalValue), marker : TypeValue, env : Environment, ctx : EvalContext) -> Option(Option(String))
)({
  mname := type_to_string(marker);
  if(!((mname == "Send") || (mname == "Acyclic")), {
    return(Option(Option(String)).None);
  });
  if(_declares_marker(ty, marker), {
    return(Option(Option(String)).Some(Option(String).None));
  });
  match(
    witness,
    .Some(wv) => match(
      wv,
      .FuncVal(wfvd, _) => {
        return(Option(Option(String)).Some(_function_value_offense(wfvd.*.func_id.clone(), Option(AstExpr).Some(wfvd.*.body), marker, env, ctx)));
      },
      _ => ()
    ),
    .None => ()
  );
  if(!_is_function_like(ty), {
    return(Option(Option(String)).None);
  });
  want_id := _some_id_of(ty);
  want_str := if(want_id.is_empty(), type_to_string(ty), String.new());
  (found : bool) = false;
  start := match(env.function_declaration_frame_level, .Some(l) => l, .None => usize(0));
  (fi : usize) = start;
  while(fi < env.frames.len(), {
    match(
      env.frames.get(fi),
      .Some(fr) => {
        (vi : usize) = usize(0);
        while(vi < fr.variables.len(), {
          match(
            fr.variables.get(vi),
            .Some(v) => {
              // A `::` function definition (module-level or local) is not a
              // value OF this type: it only shares the signature. Judging
              // every definition of the signature convicted `f := count`
              // for what an unrelated `fill` touches.
              if(!(v.is_module_level || v.is_compile_time_only), {
                matches := if(
                  want_id.is_empty(),
                  is_function_type(v.ty) && (type_to_string(v.ty) == want_str),
                  _some_id_of(v.ty) == want_id
                );
                if(matches, {
                  match(
                    v.value.get(usize(0)),
                    .Some(vv) => match(
                      vv,
                      .FuncVal(fvd, _) => {
                        found = true;
                        match(
                          _function_value_offense(fvd.*.func_id.clone(), Option(AstExpr).Some(fvd.*.body), marker, env, ctx),
                          .Some(o) => {
                            return(Option(Option(String)).Some(Option(String).Some(o)));
                          },
                          .None => ()
                        );
                      },
                      _ => ()
                    ),
                    .None => ()
                  );
                });
              });
            },
            .None => ()
          );
          vi = (vi + usize(1));
        });
      },
      .None => ()
    );
    fi = (fi + usize(1));
  });
  // A closure identity's capture struct names its closure whichever copy of
  // the wrapper `ty` is: a copy minted under a fresh SomeT id is in neither
  // the frames scan nor `g_closure_fids_by_some`.
  want_cap := _capture_id_of(if(is_bound_closure_identity(ty), resolve_cell_chain(ty), ty));
  if(!want_cap.is_empty(), {
    match(
      g_closure_fids_by_capture.get(want_cap),
      .Some(cfids) => {
        (cci : usize) = usize(0);
        while(cci < cfids.len(), {
          match(
            cfids.get(cci),
            .Some(ccfid) => {
              found = true;
              match(
                _function_value_offense(ccfid, Option(AstExpr).None, marker, env, ctx),
                .Some(co) => {
                  return(Option(Option(String)).Some(Option(String).Some(co)));
                },
                .None => ()
              );
            },
            .None => ()
          );
          cci = (cci + usize(1));
        });
      },
      .None => ()
    );
  });
  if(!want_id.is_empty(), {
    match(
      g_closure_fids_by_some.get(want_id),
      .Some(fids) => {
        (ci : usize) = usize(0);
        while(ci < fids.len(), {
          match(
            fids.get(ci),
            .Some(cfid) => {
              found = true;
              match(
                _function_value_offense(cfid, Option(AstExpr).None, marker, env, ctx),
                .Some(o) => {
                  return(Option(Option(String)).Some(Option(String).Some(o)));
                },
                .None => ()
              );
            },
            .None => ()
          );
          ci = (ci + usize(1));
        });
      },
      .None => ()
    );
  });
  if(found, Option(Option(String)).Some(Option(String).None), Option(Option(String)).None)
});
/// Install `function_value_marker` in `context.yo`'s slot (called once from
/// `register_evaluate_expression`).
register_function_value_marker :: (fn() -> unit)({
  set_function_value_marker_fn(function_value_marker);
});
// base and is skipped.
validate_send_closure_global_reach :: (
  fn(
    wrapper_type : TypeValue,
    closure_fid : String,
    closure_body : AstExpr,
    env : Environment,
    ctx : EvalContext,
    error_token : Token,
    exn : Exception
  ) -> unit
)({
  wants_send := match(
    wrapper_type,
    .SomeT({ required_trait_types : rtts }) => {
      (found : bool) = false;
      (ti : usize) = usize(0);
      while(ti < rtts.len(), ti = (ti + usize(1)), {
        trait_type := rtts(ti);
        if(!is_fn_trait_type(trait_type) && (type_to_string(trait_type) == "Send"), {
          found = true;
        });
      });
      found
    },
    _ => false
  );
  // The closure is walked HERE, with its defining env, whether or not this
  // slot is `Send`: the verdict is memoized by fid, and a later judgement of
  // the closure's type (`arc(k)`, `where(T <: Send)`, an `Impl(Fn, Send)`
  // parameter) reads it through `g_closure_fids_by_some`. Walking it there,
  // with no defining env, would not resolve the local closures it calls.
  _note_fid_for_some_id(_some_id_of(wrapper_type), closure_fid.clone());
  if(!is_implicitly_unsafe_capable_file(Option(String).Some(error_token.module_path.clone())), {
    match(
      function_reaches_non_send_global(closure_fid, closure_body, ctx.expr_info_table, env),
      .Some(reason) => if(wants_send, {
        _raise_capture_trait_violation(ctx, exn, error_token, `This closure runs on another thread (it is bound to a Send closure type) but ${reason}.`);
      }),
      .None => ()
    );
  });
});
/// Validate that a closure created for an `Impl(Fn(...), Send, …)` wrapper
/// satisfies every NON-Fn trait the wrapper requires — the check that makes
/// the `Send` on `Thread.spawn` / `spawn(pool, …)` mean something. Each
/// captured variable is checked first, so the error lands on the capture
/// site; then the capture struct as a whole. A no-op stub until 2026-09-06
/// (issues/fixed/send-was-not-enforced-at-spawn-boundaries.md).
validate_capture_trait_requirements :: (
  fn(
    wrapper_type : TypeValue,
    capture_type : TypeValue,
    captured_variables_with_values : Option(HashMap(String, FuncCapturedVarInfo)),
    env : Environment,
    ctx : EvalContext,
    error_token : Token,
    exn : Exception
  ) -> unit
)({
  match(
    wrapper_type,
    .SomeT({ required_trait_types : rtts }) => {
      (ti : usize) = usize(0);
      while(ti < rtts.len(), ti = (ti + usize(1)), {
        trait_type := rtts(ti);
        if(!is_fn_trait_type(trait_type), {
          trait_name := type_to_string(trait_type);
          // Per-variable first: each offending capture gets its own error at
          // the capture site, not the closure site.
          match(
            captured_variables_with_values,
            .Some(cvwv) => {
              key_iter := cvwv.keys();
              (more : bool) = true;
              while(more, {
                match(
                  key_iter.next(),
                  .None => {
                    more = false;
                  },
                  .Some(var_name) => match(
                    cvwv.get(var_name.clone()),
                    .None => (),
                    .Some(info) => if(!_declared_bound_requires(info.ty, trait_type), {
                      // A captured FUNCTION value holds a marker by its value
                      // — what it captures, what its code reaches (rules D4 +
                      // D1) — not by its type (`function_value_marker`).
                      match(
                        function_value_marker(info.ty, info.value, trait_type, env, ctx),
                        .Some(fvm) => match(
                          fvm,
                          .Some(fvm_o) => {
                            _raise_capture_trait_violation(
                              ctx,
                              exn,
                              info.token,
                              `Captured variable '${var_name}' (type ${type_to_string(info.ty)}) does not implement ${trait_name}: ${fvm_o}.`
                            );
                          },
                          .None => ()
                        ),
                        .None => match(
                          _capture_judgement_type(info.ty, info.value),
                          .None => (),
                          .Some(judged) => if(!type_implements_trait_bool(judged, trait_type, env), {
                            var_msg := `Captured variable '${var_name}' (type ${type_to_string(info.ty)}) does not implement ${trait_name}. To move it across threads, wrap it in Arc/Iso, or capture a ${trait_name} projection of it instead.`;
                            _raise_capture_trait_violation(ctx, exn, info.token, var_msg);
                          })
                        )
                      );
                    })
                  )
                );
              });
            },
            .None => ()
          );
          // Then the capture struct as a whole — only when no per-variable
          // information exists: the struct's fields ARE the captured
          // variables, and re-judging a captured closure's wrapper SomeT
          // field without its value would undo the resolution above.
          if(captured_variables_with_values.is_none() && !type_implements_trait_bool(capture_type, trait_type, env), {
            details := String.new();
            match(
              capture_type,
              .Struct({ field_labels : fls, field_types : fts }) => {
                (fi : usize) = usize(0);
                while(fi < fls.len(), fi = (fi + usize(1)), {
                  match(
                    fts.get(fi),
                    .Some(fty) => if(!type_implements_trait_bool(fty, trait_type, env), {
                      if(details.len() > usize(0), {
                        details.push_str("\n  ");
                      });
                      fl := match(fls.get(fi), .Some(l) => l, .None => String.from(""));
                      details.push_string(`'${fl}' has type ${type_to_string(fty)} which does not implement ${trait_name}`);
                    }),
                    .None => ()
                  );
                });
              },
              _ => ()
            );
            agg_msg := `Closure does not implement ${trait_name} because captured variable ${details}`;
            _raise_capture_trait_violation(ctx, exn, error_token, agg_msg);
          });
        });
      });
    },
    _ => ()
  );
});
// ---------------------------------------------------------------------------
// enrich_captured_variables
// ---------------------------------------------------------------------------
/// Look up each captured variable in `env` (at its `frame_level`) to
/// discover its concrete type and runtime value.  Compile-time-only
/// variables are excluded from captures (they are always inlined).
///
/// Returns a map of name → `FuncCapturedVarInfo`.
enrich_captured_variables :: (
  fn(
    captured_variables : HashMap(String, CapturedVarInfo),
    env : Environment
  ) -> HashMap(String, FuncCapturedVarInfo)
)({
  result := HashMap(String, FuncCapturedVarInfo).new();
  key_iter := captured_variables.keys();
  (more : bool) = true;
  while(more, {
    match(
      key_iter.next(),
      .None => {
        more = false;
      },
      .Some(var_name) => {
        vn_copy := var_name.clone();
        cap_info_opt := captured_variables.get(var_name.clone());
        match(
          cap_info_opt,
          .None => (),
          .Some(cap_info) => {
            fl := cap_info.frame_level;
            n_frames := env.frames.len();
            if(debug_knob(`YO_DEBUG_CAPTURE`).is_some(), {
              enr_found := get_variables_from_env(env, var_name.clone());
              (enr_cto : usize) = usize(0);
              (enr_k : usize) = usize(0);
              while(enr_k < enr_found.len(), enr_k = (enr_k + usize(1)), {
                match(
                  enr_found.get(enr_k),
                  .Some(ev) => if(ev.is_compile_time_only, {
                    enr_cto = (enr_cto + usize(1));
                  }),
                  .None => ()
                );
              });
              eprintln(`[cap-enr] name=${var_name} fl=${fl.to_string()} n_frames=${n_frames.to_string()} found=${enr_found.len().to_string()} cto=${enr_cto.to_string()}`);
            });
            if(fl < n_frames, {
              vars := get_variables_from_env(env, var_name.clone());
              m := vars.len();
              (j : usize) = usize(0);
              while(j < m, {
                match(
                  vars.get(j),
                  .None => (),
                  .Some(v) => {
                    if(!v.is_compile_time_only, {
                      enriched := FuncCapturedVarInfo(
                        frame_level : fl,
                        usage : cap_info.usage,
                        token : cap_info.token,
                        ty : v.ty,
                        value : v.value.get(usize(0)),
                        is_effect_param : v.is_effect_param
                      );
                      result.insert(vn_copy.clone(), enriched);
                      ()
                    });
                  }
                );
                j = (j + usize(1));
              });
            });
          }
        );
      }
    );
  });
  result
});
// ---------------------------------------------------------------------------
// create_capture_type_and_value
// ---------------------------------------------------------------------------
/// Create the capture struct type (and optional value) for a closure from
/// its captured variables.
///
/// Phase 3 simplified inference path:
///   - If `expected_capture_type` is None (the common case), create an
///     anonymous struct from the captured variables' names and types.
///   - If there are no captured variables, create an empty struct.
///   - Explicit capture struct types (expected_capture_type = Some(T)) are
///     deferred to Phase 4.
create_capture_type_and_value :: (
  fn(
    expected_capture_type : Option(TypeValue),
    captured_vars_with_values : Option(HashMap(String, FuncCapturedVarInfo)),
    env : Environment,
    closure_tok : Token
  ) -> CaptureTypeAndValueResult
)(
  // Phase 4: explicit capture struct type check.
  match(
    expected_capture_type,
    .Some(_) =>
      // Explicit capture type — deferred to Phase 4.
      // For now return None capture (will be refined).
      CaptureTypeAndValueResult(
        capture_type : Option(TypeValue).None,
        capture_value : Option(EvalValue).None,
        env : env
      ),
    .None => {
      // Inference case: build struct from captured variables.
      field_labels := ArrayList(String).new();
      field_types := ArrayList(TypeValue).new();
      type_fields := ArrayList(TypeField).new();
      cap_values := ArrayList(Option(EvalValue)).new();
      has_any_caps := match(
        captured_vars_with_values,
        .None => false,
        .Some(cvwv) => (cvwv.len() > usize(0))
      );
      if(has_any_caps, {
        cvwv := match(captured_vars_with_values, .Some(m) => m, .None => HashMap(String, FuncCapturedVarInfo).new());
        key_iter := cvwv.keys();
        (more_keys : bool) = true;
        while(more_keys, {
          match(
            key_iter.next(),
            .None => {
              more_keys = false;
            },
            .Some(cap_name) => {
              match(
                cvwv.get(cap_name.clone()),
                .None => (),
                .Some(fci) => {
                  field_labels.push(cap_name.clone());
                  field_types.push(fci.ty);
                  cap_values.push(fci.value);
                  type_fields.push(
                    TypeField(
                      label : cap_name.clone(),
                      ty : fci.ty,
                      is_comptime : false,
                      default_value : Option(EvalValue).None,
                      assigned_value : Option(EvalValue).None,
                      doc_comment : Option(String).None,
                      is_effect_param : fci.is_effect_param
                    )
                  );
                }
              );
            }
          );
        });
      });
      // Stable capture-struct id (see g_capture_struct_ids note): keyed by the
      // closure's source position + capture field signature, reused across evals.
      cap_key := String.from("cap@");
      cap_key.push_string(closure_tok.module_path.clone());
      cap_key.push_str(":");
      cap_key.push_string(closure_tok.row.to_string());
      cap_key.push_str(":");
      cap_key.push_string(closure_tok.column.to_string());
      cap_key.push_str(":");
      cap_key.push_string(closure_tok.character.to_string());
      cap_key.push_str("|");
      (csi : usize) = usize(0);
      while(csi < field_labels.len(), {
        cap_key.push_string(match(field_labels.get(csi), .Some(l) => l, .None => String.from("")));
        cap_key.push_str(":");
        cap_key.push_string(match(field_types.get(csi), .Some(t) => type_to_string(t), .None => String.from("")));
        // RESOLUTION-aware key suffix: a SomeT field type renders the SAME
        // `type_to_string` whether abstract (def-era eval — the captured
        // closure param is unbound, field lowers to void*) or resolved
        // (spec-era eval — the capbind SomeT's cell holds the concrete
        // capture struct). One shared struct froze the FIRST era's field
        // types, so the resolved-era spec initialized a void* field with a
        // concrete struct value (clang error; the forwarded-closure family,
        // tests/closure_param_forwarding.test.yo arm 2). Append the resolved
        // identity so the two eras mint DISTINCT capture structs.
        match(
          field_types.get(csi),
          .Some(ck_t) => match(
            ck_t,
            .SomeT({ id : ck_sid, resolved_concrete : ck_rc }) => {
              cap_key.push_str("@res:");
              match(
                ck_rc.get(usize(0)),
                .Some(ck_r) => cap_key.push_string(type_to_string(ck_r)),
                .None => cap_key.push_string(ck_sid.clone())
              );
            },
            _ => ()
          ),
          .None => ()
        );
        cap_key.push_str(",");
        csi = (csi + usize(1));
      });
      struct_id := match(
        g_capture_struct_ids.get(cap_key.clone()),
        .Some(existing) => existing,
        .None => {
          // Phase 2: content-addressed (hash of the cap_key, which is itself
          // position/type-stable) instead of the global counter, with the
          // same `_x<k>` collision fallback the type-name interner uses.
          base := `capture_${fnv1a64(cap_key.clone()).to_string()}`;
          fresh := base.clone();
          (ord : usize) = usize(1);
          loop_ok := runtime(true);
          while(loop_ok, {
            match(
              g_capture_struct_ids_r.get(fresh.clone()),
              .Some(owner) => {
                if(owner == cap_key, {
                  loop_ok = false;
                }, {
                  fresh = `${base}_x${ord.to_string()}`;
                  ord = (ord + usize(1));
                });
              },
              .None => {
                loop_ok = false;
              }
            );
          });
          g_capture_struct_ids.insert(cap_key.clone(), fresh.clone());
          g_capture_struct_ids_r.insert(fresh.clone(), cap_key.clone());
          fresh
        }
      );
      // Register field metadata.
      register_struct_fields(struct_id.clone(), type_fields);
      // Build the capture struct TypeValue.
      capture_ty := TypeValue.Struct(
        struct_id.clone(),
        String.from(""),
        field_labels,
        field_types,
        false,
        false,
        false,
        String.from(""),
        ArrayList(TypeValue).new(),
        false
      );
      // Auto-derive trait markers for the capture struct.
      auto_derive_traits_for_struct_type(
        struct_id.clone(),
        field_types,
        false,
        false,
        env,
        capture_ty
      );
      // Build the capture struct EvalValue if all values are known.
      n_caps := cap_values.len();
      (all_known : bool) = true;
      (cv_i : usize) = usize(0);
      while(cv_i < n_caps, {
        match(
          cap_values.get(cv_i),
          .None => (),
          .Some(v_opt) => {
            match(
              v_opt,
              .None => {
                all_known = false;
              },
              .Some(_) => ()
            );
          }
        );
        cv_i = (cv_i + usize(1));
      });
      // Collect concrete values for StructVal if all are known.
      cap_struct_val := if(all_known, {
        concrete_vals := ArrayList(EvalValue).new();
        (ci : usize) = usize(0);
        while(ci < n_caps, {
          match(
            cap_values.get(ci),
            .None => (),
            .Some(v_opt) => {
              match(
                v_opt,
                .None => (),
                .Some(v) => {
                  concrete_vals.push(v);
                }
              );
            }
          );
          ci = (ci + usize(1));
        });
        // Use struct_id as the type name for the StructVal.
        Option(EvalValue).Some(
          EvalValue.StructVal(
            struct_id.clone(),
            field_labels,
            concrete_vals
          )
        )
      }, Option(EvalValue).None);
      CaptureTypeAndValueResult(
        capture_type : Option(TypeValue).Some(capture_ty),
        capture_value : cap_struct_val,
        env : env
      )
    }
  )
);
// ---------------------------------------------------------------------------
// generate_captured_variable_dup_expressions
// ---------------------------------------------------------------------------
/// Result type for `generate_captured_variable_dup_expressions`.
CapturedVarDupResult :: struct(
  dup_exprs : Option(ArrayList(AstExpr)),
  env : Environment
);
/// Generate `___dup()` expressions for captured ARC variables — one evaluated
/// `___dup(name)` per captured variable whose type contains an RC-managed
/// type. Codegen (generate_closure_construction) emits these as the capture
/// struct's field initializers, so the capture holds its OWN reference; the
/// constructing scope's local can then be dropped without freeing the value
/// under the closure (the Command.status spawn-storage UAF —
/// issues/yo-self-async-capture-missing-dup.md).
///
/// The env is mutated in place, so the updated env needs no threading
/// through the evaluated exprs — same as the `___drop` builder in
/// exprs/begin.yo.
generate_captured_variable_dup_expressions :: (
  fn(
    captured_vars_with_values : Option(HashMap(String, FuncCapturedVarInfo)),
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> CapturedVarDupResult
)({
  dup_exprs := ArrayList(AstExpr).new();
  match(
    captured_vars_with_values,
    .Some(cvwv) => if(cvwv.len() > usize(0), {
      key_iter := cvwv.keys();
      (done : bool) = false;
      while(!done, {
        match(
          key_iter.next(),
          .Some(var_name) => match(
            cvwv.get(var_name.clone()),
            .Some(ci) => if(type_contains_rc_type(ci.ty), {
              dup_code := `___dup(${var_name})`;
              dup_expr := generate_expr_from_code(dup_code, exn);
              evaluated := evaluate_expression_raw(dup_expr, env, ctx, exn);
              dup_exprs.push(evaluated);
            }),
            .None => ()
          ),
          .None => {
            done = true;
          }
        );
      });
    }),
    .None => ()
  );
  CapturedVarDupResult(
    dup_exprs : if(dup_exprs.len() > usize(0), Option(ArrayList(AstExpr)).Some(dup_exprs), Option(ArrayList(AstExpr)).None),
    env : env
  )
});
export(FuncCapturedVarInfo);
export(CaptureTypeAndValueResult);
export(CapturedVarDupResult);
export(consume_captured_variables);
export(build_path_collection_from_captured_variables);
export(validate_capture_trait_requirements);
export(validate_send_closure_global_reach);
export(function_value_marker, register_function_value_marker, alias_closure_some_id, note_closure_for_some_id, record_closure_capture_verdicts);
export(enrich_captured_variables);
export(create_capture_type_and_value);
export(generate_captured_variable_dup_expressions);
