//! evaluator/calls/comptime_fn — evaluate_comptime_fn_call.
//!
//! Phase 3a — full implementation.
//! 1:1 port of `src/evaluator/calls/comptime-fn.ts`.
//!
//! `evaluate_comptime_fn_call` executes a compile-time function (CTFE),
//! caches the result (keyed by func_id + arg values), and handles recursive
//! CTFE by inserting a temporary `UnknownVal` placeholder to break cycles.
//!
//! Key differences from the TypeScript version:
//!   - The per-function cache lives in `g_comptime_fn_caches` (not on
//!     `FuncVal.calledComptimeFunctionCaches`) to avoid circular imports.
//!   - No `cloneExpr` needed (Yo uses ExprInfoTable — AST re-evaluation is safe).
//!   - No `funcName` / `typeName` back-patching (TypeValue is pure enum in Yo).
//!   - No `functionValue` field back-patching (not in Yo TypeValue).
//!   - SomeType id comparison uses `SomeT.id` for exact identity.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
_(env : ctfe_dbg_env) :: import("std/env");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token, ast_expr_id, ast_expr_to_string, make_err_expr, clone_expr_fresh_ids } :: import("../../expr.yo");
{ ExprInfo, new_expr_info, expr_info_table_get, register_struct_ctor_fid, lookup_struct_ctor_fid, register_trait_ctor_fid, ComptimeRef } :: import("../../expr_info.yo");
{ Variable, Environment, snapshot_env } :: import("../../env.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, t_some_t } :: import("../../types/creators.yo");
{ are_types_compatible, are_types_compatible_exact } :: import("../../types/compatibility.yo");
{ is_some_type, is_type_hierarchy_type, is_type_0, is_struct_type } :: import("../../types/guards.yo");
{ macro_return_is_unquote } :: import("../types/function.yo");
{ type_contains_some_type } :: import("../../types/utils.yo");
{
  EvalValue,
  eval_value_eq,
  is_type_val,
  is_unknown_val,
  create_unknown_val,
  create_unknown_val_with_name,
  register_enum_cfid,
  lookup_enum_cfid,
  value_to_string
} :: import("../../value.yo");
{ random_id } :: import("../../utils.yo");
{
  EvalContext,
  ArgValues,
  CalledComptimeFnCache,
  ComptimeFnCacheEntry,
  ComptimeFnCallResult,
  FuncOrAsyncBlockCtx,
  FuncOrAsyncBlockKind,
  ImplConcreteTypeInfo,
  in_def_time_trial
} :: import("../context.yo");
{ evaluate_begin_expression } :: import("../exprs/begin.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Global CTFE cache.
//
// TS stores per-function CTFE caches ON the FunctionValue
// (`calledComptimeFunctionCaches`) — one GLOBAL cache per function
// identity, shared by every module. yo-self previously kept them on the
// EvalContext, but the demand loader creates a FRESH context per imported
// module, so each module minted its OWN `ArrayList(u8)` instantiation
// (different struct ids) and cross-module unification failed
// ("Cannot unify <struct:A> and <struct:B>" for the same written type —
// the std/glob `as_bytes()` vs local `ArrayList(u8)` param family).
// A module-level global keyed by func_id is the faithful equivalent.
// ---------------------------------------------------------------------------
(g_comptime_fn_caches : ArrayList(ComptimeFnCacheEntry)) = ArrayList(ComptimeFnCacheEntry).new();
// Internal helper: compare two EvalValues for CTFE cache lookup.
//
// For TypeVal arguments:
//   - Both SomeT: compare by SomeT.id (exact identity).
//   - One SomeT, other not: false.
//   - Either contains SomeT: use exact structural comparison.
//   - Otherwise: use standard type compatibility.
// For non-TypeVal arguments: use eval_value_eq.
// ---------------------------------------------------------------------------
/// ERA-equivalence for CTFE cache identity (depth-bounded): two type values
/// are the SAME instantiation when their ids match — or when they are ERA
/// INSTANCES of one instantiation: same constructor fid AND (for structs)
/// pairwise era-equal type_arguments. This is the CREATION-side
/// canonicalization (the gap-6 attempt-#8 lesson): without it,
/// `Option(Node-era-A)` and `Option(Node-era-B)` landed in SEPARATE memo
/// entries whenever Node itself had split eras, so callers and callees kept
/// diverging one level up (the imm_sorted_map/imm_threading caller-arg
/// struct-to-struct casts). Enums carry no type_arguments; their cfid match
/// falls back to pairwise era-equal variant FIELD lists. Concrete same-shape
/// but different-ctor types still take the EXACT fallback (the MapEntry/ME
/// cache-collision hazard).
_ctfe_types_era_equal :: (fn(aty : TypeValue, bty : TypeValue, d : usize) -> bool)({
  if(d > usize(6), {
    return(are_types_compatible_exact(aty, bty));
  });
  a_sid := match(aty, .Struct({ id : x }) => x, _ => String.from(""));
  b_sid := match(bty, .Struct({ id : x }) => x, _ => String.from(""));
  if((a_sid.len() > usize(0)) && (a_sid == b_sid), {
    return(true);
  });
  a_eid := match(aty, .EnumT(x, _, _, _, _, _, _, _, _) => x.replace(String.from("__self_shell"), String.from("")), _ => String.from(""));
  b_eid := match(bty, .EnumT(x, _, _, _, _, _, _, _, _) => x.replace(String.from("__self_shell"), String.from("")), _ => String.from(""));
  if((a_eid.len() > usize(0)) && (a_eid == b_eid), {
    return(true);
  });
  // Struct era instances: same ctor fid + era-equal type arguments.
  if((a_sid.len() > usize(0)) && (b_sid.len() > usize(0)), {
    a_cf := match(lookup_struct_ctor_fid(a_sid), .Some(f) => f, .None => String.from(""));
    b_cf := match(lookup_struct_ctor_fid(b_sid), .Some(f) => f, .None => String.from(""));
    if((a_cf.len() > usize(0)) && (a_cf == b_cf), {
      a_ta := match(aty, .Struct({ type_arguments : t }) => t, _ => ArrayList(TypeValue).new());
      b_ta := match(bty, .Struct({ type_arguments : t }) => t, _ => ArrayList(TypeValue).new());
      if((a_ta.len() == b_ta.len()) && (a_ta.len() > usize(0)), {
        (tai : usize) = usize(0);
        (ta_ok : bool) = true;
        while((tai < a_ta.len()) && ta_ok, {
          at2 := match(a_ta.get(tai), .Some(t) => t, .None => t_unit());
          bt2 := match(b_ta.get(tai), .Some(t) => t, .None => t_unit());
          if(!(recur(at2, bt2, d + usize(1))), {
            ta_ok = false;
          });
          tai = (tai + usize(1));
        });
        if(ta_ok, {
          return(true);
        });
      });
    });
    return(are_types_compatible_exact(aty, bty));
  });
  // Enum era instances: same cfid + era-equal variant field lists.
  if((a_eid.len() > usize(0)) && (b_eid.len() > usize(0)), {
    a_ecf := lookup_enum_cfid(a_eid);
    b_ecf := lookup_enum_cfid(b_eid);
    if((a_ecf.len() > usize(0)) && (a_ecf == b_ecf), {
      a_vf := match(aty, .EnumT(_, _, _, vf, _, _, _, _, _) => vf, _ => ArrayList(ArrayList(TypeValue)).new());
      b_vf := match(bty, .EnumT(_, _, _, vf, _, _, _, _, _) => vf, _ => ArrayList(ArrayList(TypeValue)).new());
      if(a_vf.len() == b_vf.len(), {
        (vfi : usize) = usize(0);
        (vf_ok : bool) = true;
        while((vfi < a_vf.len()) && vf_ok, {
          a_fl := match(a_vf.get(vfi), .Some(f) => f, .None => ArrayList(TypeValue).new());
          b_fl := match(b_vf.get(vfi), .Some(f) => f, .None => ArrayList(TypeValue).new());
          if(a_fl.len() != b_fl.len(), {
            vf_ok = false;
          }, {
            (ffi : usize) = usize(0);
            while((ffi < a_fl.len()) && vf_ok, {
              af2 := match(a_fl.get(ffi), .Some(t) => t, .None => t_unit());
              bf2 := match(b_fl.get(ffi), .Some(t) => t, .None => t_unit());
              if(!(recur(af2, bf2, d + usize(1))), {
                vf_ok = false;
              });
              ffi = (ffi + usize(1));
            });
          });
          vfi = (vfi + usize(1));
        });
        if(vf_ok, {
          return(true);
        });
      });
    });
    return(are_types_compatible_exact(aty, bty));
  });
  are_types_compatible_exact(aty, bty)
});
_ctfe_args_equal :: (
  fn(
    cached_av : EvalValue,
    given_av : EvalValue
  ) -> bool
)(
  match(
    cached_av,
    .TypeVal(aty_b) => match(
      given_av,
      .TypeVal(bty_b) => {
        aty := aty_b;
        bty := bty_b;
        a_is_some := is_some_type(aty);
        b_is_some := is_some_type(bty);
        // TS compares cached type args with the SAME type OBJECT memo-hitting
        // trivially (object identity). yo-self type values are copies, but a
        // struct/enum ID is unique per definition and SHARED between a
        // mid-definition self-shell and its final (struct.yo mints one id for
        // both) — so same-id means same type object. Without this, a
        // self-recursive constructor's `Option(Self)` (arg = fieldless shell)
        // and the post-definition `Option(RBNode(K, V))` (arg = stamped final)
        // land in SEPARATE memo entries, splitting one TS type object into two
        // enum instances.
        a_struct_id := match(aty, .Struct({ id : as_id }) => as_id, _ => String.from(""));
        b_struct_id := match(bty, .Struct({ id : bs_id }) => bs_id, _ => String.from(""));
        // ENUM self-shells carry a `__self_shell` id SUFFIX (unlike struct
        // shells, which share the final's id exactly — see the comment
        // above). Strip it so `ArrayList(Self)` inside a recursive enum's
        // OWN declaration (arg = the suffixed shell) memo-hits the
        // post-definition `ArrayList(MyExpr)` (arg = the final): without
        // this the two calls landed in SEPARATE memo entries, minting TWO
        // ArrayList(MyExpr) instantiations -> two C types whose
        // traverse/drop machinery cross-corrupted the heap (the
        // recursive-enum Box(Self)+ArrayList(Self) OOM/segv,
        // issues/repros/recursive-enum-box-plus-arraylist-self.yo).
        a_enum_id := match(aty, .EnumT(ae_id, _, _, _, _, _, _, _, _) => ae_id.replace(String.from("__self_shell"), String.from("")), _ => String.from(""));
        b_enum_id := match(bty, .EnumT(be_id, _, _, _, _, _, _, _, _) => be_id.replace(String.from("__self_shell"), String.from("")), _ => String.from(""));
        cond(
          ((a_struct_id.len() > usize(0)) && (a_struct_id == b_struct_id)) => true,
          ((a_enum_id.len() > usize(0)) && (a_enum_id == b_enum_id)) => true,
          // Both bare SomeT: must be the exact same id
          (a_is_some && b_is_some) => (
            match(aty, .SomeT(id : aid) => aid, _ => String.from("")) ==
              match(bty, .SomeT(id : bid) => bid, _ => String.from(""))
          ),
          // One bare SomeT, other not: different types
          (a_is_some || b_is_some) => false,
          // Either side contains a SomeT inside: require exact structural match
          (type_contains_some_type(aty) || type_contains_some_type(bty)) =>
            are_types_compatible_exact(aty, bty),
          // ERA INSTANCES of one instantiation (same ctor fid + era-equal
          // args/fields) memo-hit — see _ctfe_types_era_equal. This is what
          // keeps Option(Node-era-A) and Option(Node-era-B) in ONE memo
          // entry so eras converge instead of propagating upward.
          _ctfe_types_era_equal(aty, bty, usize(0)) => true,
          // Concrete types: require EXACT match for cache identity, NOT lenient
          // compatibility. Mirrors TS comptime-fn.ts:159-164 (`requireExactMatch
          // =true`). Lenient `are_types_compatible` treats two distinct
          // same-shaped structs as equal (e.g. a user `object(name, kind)` vs
          // `MapEntry(key, value)`), causing a CACHE COLLISION: a later
          // `(?*)(MapEntry(String, ArrayList(ME)))` wrongly hit a cached
          // `(?*)(ME)` entry and returned `Option(*(ME))` — making
          // `HashMap(.., ArrayList(<RC>)).new()`'s data field `?(*(ME))` and
          // failing method resolution. See
          // issues/fixed/phase3-nested-generic-method-resolution-unit.md.
          true => are_types_compatible_exact(aty, bty)
        )
      },
      _ => false
    ),
    _ => eval_value_eq(cached_av, given_av)
  )
);
// ---------------------------------------------------------------------------
// Recursive-type-reference side-table (port of TS `SomeType.recursiveTypeRef`).
//
// When a type constructor recursively references itself during CTFE, the
// recursive call hits the in-progress temp cache and must return a placeholder
// that is a LEAF in the type graph (so the resulting TypeValue is a finite DAG
// and `type_to_string`/`synthesize`/`substitute` terminate). TS returns a
// `SomeType` tagged with `recursiveTypeRef: {functionValue, argValues}` and
// resolves it lazily when the type is used as a constructor.
//
// yo-self's `SomeT` (in `definitions.yo`) cannot carry `EvalValue` arg-values
// (circular import), so we keep the placeholder a bare `SomeT` and record the
// resolution info in this module-level side-table, keyed by the placeholder
// SomeT's unique id. `resolve_recursive_type_ref` (in `function.yo`) reads it.
// Mutated via `push` (never reassigned), mirroring `impl.yo`'s registry.
// ---------------------------------------------------------------------------
RecursiveTypeRef :: ref(
  struct(
    /// The placeholder `SomeT`'s `id` — the lookup key.
    some_id : String,
    /// The type-constructor function's `func_id` (→ `g_comptime_fn_caches`).
    func_id : String,
    /// The argument values of the in-progress instantiation (for exact match).
    arg_values : ArrayList(EvalValue)
  )
);
(g_recursive_type_refs : ArrayList(RecursiveTypeRef)) = ArrayList(RecursiveTypeRef).new();
/// Look up the recursive-type-ref for a placeholder SomeT id, if any.
lookup_recursive_type_ref :: (fn(some_id : String) -> Option(RecursiveTypeRef))({
  (i : usize) = usize(0);
  n := g_recursive_type_refs.len();
  (found : Option(RecursiveTypeRef)) = Option(RecursiveTypeRef).None;
  while((i < n) && match(found, .None => true, .Some(_) => false), {
    match(
      g_recursive_type_refs.get(i),
      .Some(r) => if(r.some_id == some_id, {
        found = Option(RecursiveTypeRef).Some(r);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// Is `v` a TypeVal carrying a RESOLVED type (not a recursion placeholder)?
/// A placeholder is a `SomeT` whose id is registered in the side-table; any
/// other TypeVal is resolved. Returns the inner type when resolved.
_resolved_type_of :: (fn(v : EvalValue) -> Option(TypeValue))(
  match(
    v,
    .TypeVal(tb) => {
      t := tb;
      is_placeholder := match(
        t,
        .SomeT(id : sid2) => match(lookup_recursive_type_ref(sid2), .Some(_) => true, .None => false),
        _ => false
      );
      cond(
        is_placeholder => Option(TypeValue).None,
        true => Option(TypeValue).Some(t)
      )
    },
    _ => Option(TypeValue).None
  )
);
/// Pairwise-equal two CTFE arg-value lists (same length + `_ctfe_args_equal`).
_arg_vals_equal :: (fn(a : ArrayList(EvalValue), b : ArrayList(EvalValue)) -> bool)({
  if(a.len() != b.len(), {
    return(false);
  });
  (i : usize) = usize(0);
  (ok : bool) = true;
  n := a.len();
  while((i < n) && ok, {
    match(
      a.get(i),
      .Some(av) => match(
        b.get(i),
        .Some(bv) => {
          ok = _ctfe_args_equal(av, bv);
        },
        .None => {
          ok = false;
        }
      ),
      .None => {
        ok = false;
      }
    );
    i = (i + usize(1));
  });
  ok
});
/// Canonicalize a SUBSTITUTION-ERA nominal instantiation through the CTFE
/// ctor memo. `substitute()` rewrites a struct instance's type_arguments IN
/// PLACE while KEEPING the def-era `id`/`constructor_func_id`
/// (types/substitution.yo, Struct arm) — so a trait method declared as
/// `-> Range(Self)` registers, for every concrete impl, a return instance
/// whose id is the TRAIT-DEFINITION era's, distinct from the instance the
/// ctor memo hands every ordinary `Range(usize)` call. A call site stamped
/// with that era instance can never dispatch impls registered on the memo
/// instance (the range-op era split,
/// issues/fixed/range-op-result-era-split-blocks-iteration.md). Given such a type,
/// return the memo's canonical instance for the SAME (ctor, concrete args)
/// instantiation when one exists; otherwise return the input unchanged.
/// Struct-only and top-level-only — the demonstrated class is a nominal
/// struct return. Type arguments carrying SomeTs are excluded (per-call
/// closure families keep their capture identity), and the abstract memo
/// entry (SomeT args) can never match a concrete key, so only a genuine
/// concrete instantiation of the same constructor is ever adopted.
canonicalize_instantiation_via_ctfe_memo :: (fn(ty : TypeValue) -> TypeValue)({
  sid := match(ty, .Struct({ id : x }) => x, _ => String.from(""));
  if(sid.len() == usize(0), {
    return(ty);
  });
  tyargs := match(ty, .Struct({ type_arguments : t }) => t, _ => ArrayList(TypeValue).new());
  if(tyargs.len() == usize(0), {
    return(ty);
  });
  // The memo lookup key: each concrete type argument as a TypeVal argument.
  want_args := ArrayList(EvalValue).new();
  {
    (cvi : usize) = usize(0);
    n_ta := tyargs.len();
    while(cvi < n_ta, {
      match(
        tyargs.get(cvi),
        .Some(t2) => {
          if(type_contains_some_type(t2), {
            return(ty);
          });
          want_args.push(EvalValue.TypeVal(t2));
        },
        .None => {
          return(ty);
        }
      );
      cvi = (cvi + usize(1));
    });
  };
  cfid := match(
    lookup_struct_ctor_fid(sid),
    .Some(f) => f,
    .None => match(ty, .Struct({ constructor_func_id : c }) => c, _ => String.from(""))
  );
  if(cfid.len() == usize(0), {
    return(ty);
  });
  // Find the ctor's bucket, then an era-equal-arg entry with a resolved value.
  (canon_bucket : Option(ComptimeFnCacheEntry)) = Option(ComptimeFnCacheEntry).None;
  {
    (bi : usize) = usize(0);
    n_b := g_comptime_fn_caches.len();
    while((bi < n_b) && canon_bucket.is_none(), {
      match(
        g_comptime_fn_caches.get(bi),
        .Some(e) => if(e.func_id == cfid, {
          canon_bucket = Option(ComptimeFnCacheEntry).Some(e);
        }),
        .None => ()
      );
      bi = (bi + usize(1));
    });
  };
  match(
    canon_bucket,
    .Some(bucket) => {
      (ci : usize) = usize(0);
      n := bucket.caches.len();
      while(ci < n, {
        match(
          bucket.caches.get(ci),
          .Some(cache) => if(_arg_vals_equal(cache.arg_values, want_args), {
            match(
              _resolved_type_of(cache.value),
              .Some(rt) => if(is_struct_type(rt), {
                return(rt);
              }),
              .None => ()
            );
          }),
          .None => ()
        );
        ci = (ci + usize(1));
      });
    },
    .None => ()
  );
  ty
});
/// Resolve a recursion-placeholder `SomeT` to its actual type. Mirrors TS
/// `resolveRecursiveTypeRef` (`function.ts:133`): (1) the cache entry of the
/// same func with exactly-matching args whose value is resolved; (2)
/// `ctx.self_type` when it is a struct/object; (3) ANY resolved cache entry of
/// the same func (all instantiations share the same structure). Returns `.None`
/// when `some_ty` is not a registered placeholder or nothing has resolved yet.
resolve_recursive_type_ref :: (fn(some_ty : TypeValue, ctx : EvalContext) -> Option(TypeValue))({
  sid := match(some_ty, .SomeT(id : x) => x, _ => String.from(""));
  if(sid.len() == usize(0), {
    return(Option(TypeValue).None);
  });
  rref := match(
    lookup_recursive_type_ref(sid),
    .Some(r) => r,
    .None => {
      return(Option(TypeValue).None);
    }
  );
  // Locate the cache bucket for the recursive function.
  (bucket_opt : Option(ComptimeFnCacheEntry)) = Option(ComptimeFnCacheEntry).None;
  {
    (ci : usize) = usize(0);
    n_c := g_comptime_fn_caches.len();
    while((ci < n_c) && match(bucket_opt, .None => true, .Some(_) => false), {
      match(
        g_comptime_fn_caches.get(ci),
        .Some(e) => if(e.func_id == rref.func_id, {
          bucket_opt = Option(ComptimeFnCacheEntry).Some(e);
        }),
        .None => ()
      );
      ci = (ci + usize(1));
    });
  };
  bucket := match(
    bucket_opt,
    .Some(b) => b,
    .None => {
      return(Option(TypeValue).None);
    }
  );
  // Strategy 1: exact-arg-match cache entry with a resolved value.
  {
    (i : usize) = usize(0);
    n := bucket.caches.len();
    while(i < n, {
      match(
        bucket.caches.get(i),
        .Some(cache) => if(_arg_vals_equal(cache.arg_values, rref.arg_values), {
          match(
            _resolved_type_of(cache.value),
            .Some(rt) => return(Option(TypeValue).Some(rt)),
            .None => ()
          );
        }),
        .None => ()
      );
      i = (i + usize(1));
    });
  };
  // Strategy 2: ctx.self_type when it is a struct/object.
  match(
    ctx.self_type,
    .Some(st) => if(is_struct_type(st), {
      return(Option(TypeValue).Some(st));
    }),
    .None => ()
  );
  // Strategy 3: any resolved cache entry of the same function.
  {
    (i : usize) = usize(0);
    n := bucket.caches.len();
    while(i < n, {
      match(
        bucket.caches.get(i),
        .Some(cache) => match(
          _resolved_type_of(cache.value),
          .Some(rt) => return(Option(TypeValue).Some(rt)),
          .None => ()
        ),
        .None => ()
      );
      i = (i + usize(1));
    });
  };
  Option(TypeValue).None
});
/// Named CTFE unknown: a CTFE short-circuit (analysis pass, unknown args,
/// gate skips) that returns an unknown RESULT must promote Type-universe
/// returns to `TypeVal(SomeT)` — TS passes a variableName at every such
/// site ("ctfe_analysis_result_..." comptime-fn.ts:63, return.label
/// comptime-fn.ts:191) and `createUnknownValue` THROWS on a nameless
/// Type-typed slot, so a bare UnknownVal of type Type cannot exist in TS.
/// Without this, `types.first()` on an unknown variadic ComptimeList(Type)
/// produced a bare unknown that `__yo_are_types_compatible` rejects
/// (tests/variadic_comptime.test.yo). Name built without a template
/// string (hot path — template-string Rc corruption family).
_ctfe_unknown :: (fn(return_type : TypeValue, env : Environment) -> EvalValue)({
  nm := String.from("ctfe_result_");
  nm.push_string(random_id(env.module_path));
  create_unknown_val_with_name(return_type, nm)
});
/// Build the in-progress recursion placeholder for a type-constructor call.
/// When the return is the `Type` universe (level 0) — i.e. a type constructor —
/// the placeholder is a fresh `SomeT` LEAF (mirroring TS `createUnknownValue`
/// promoting to a `SomeType` when `variableName` is given and the type is
/// `Type` level 0), and we record `(some_id → func_id, arg_values)` so it can
/// be resolved later. Otherwise it stays a bare `UnknownVal` (TS's non-type
/// branch). `arg_vals` is the flattened argument-value list of this call.
_recursive_placeholder :: (
  fn(return_type : TypeValue, func_id : String, arg_vals : ArrayList(EvalValue)) -> EvalValue
)(
  cond(
    is_type_0(return_type) => {
      placeholder := t_some_t(`recur_${func_id}`, usize(0));
      sid := match(placeholder, .SomeT(id : x) => x, _ => String.from(""));
      g_recursive_type_refs.push(
        RecursiveTypeRef(some_id : sid, func_id : func_id, arg_values : arg_vals)
      );
      EvalValue.TypeVal(placeholder)
    },
    true => create_unknown_val(return_type)
  )
);
// ---------------------------------------------------------------------------
// evaluate_comptime_fn_call
// ---------------------------------------------------------------------------
/// Execute a compile-time function call (CTFE), returning the evaluated value
/// together with updated caller/callee environments.
///
/// Mirrors `evaluateComptimeFunctionCall` in `src/evaluator/calls/comptime-fn.ts`.
evaluate_comptime_fn_call :: (
  fn(
    function_callee_expr : Option(AstExpr),
    function_type : TypeValue,
    function_value : EvalValue,
    arg_values : ArgValues,
    caller_env : Environment,
    callee_env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> ComptimeFnCallResult
)({
  // Extract the return type from the function type.
  return_type := match(
    function_type,
    .Func({ result : result_b }) => result_b,
    _ => t_unit()
  );
  // Extract func_id and body from the FuncVal.
  func_id_str := match(
    function_value,
    .FuncVal(__fvd1, _) => __fvd1.*.func_id,
    _ => String.from("")
  );
  body_box := match(
    function_value,
    .FuncVal(__fvd2, _) => __fvd2.*.body,
    _ => {
      // Inside a DEFINITION-time body trial, a non-FuncVal callee is a
      // dispatch product with no impl value yet (a where-constraint trait
      // method on an abstract receiver — prelude's `~`/`-` comptime
      // variants, roots #14/#15 of
      // issues/fixed/def-eval-swallow-remaining-roots.md). TS never reaches its
      // CTFE with a non-FunctionValue (typing) — such calls degrade to an
      // unknown of the return type earlier. Mirror that here, scoped to
      // the trial; everywhere else the throw stays (a genuine
      // calling-a-non-function error must not be silently absorbed).
      if(in_def_time_trial(), {
        if(ctfe_dbg_env.get(`YO_DEBUG_CTFE`).is_some(), {
          eprintln(`[ctfe-nonfv] fid=${func_id_str}`);
        });
        return(
          ComptimeFnCallResult(
            value : _ctfe_unknown(return_type, caller_env),
            caller_env : caller_env,
            callee_env : callee_env,
            comptime_ref : Option(ComptimeRef).None
          )
        );
      });
      exn.throw(
        dyn(
          format_error_message(
            match(
              function_callee_expr,
              .Some(e) => ast_expr_token(e),
              .None => ast_expr_token(make_err_expr())
            ),
            String.from("evaluate_comptime_fn_call: function_value is not a FuncVal"),
            false,
            .None
          )
        )
      );
      make_err_expr()
    }
  );
  // During CTFE capability analysis, return an UnknownVal immediately without
  // executing the body. This prevents infinite recursion in the analysis pass.
  if(ctx.is_analyzing_ctfe_capability, {
    if(in_def_time_trial() && ctfe_dbg_env.get(`YO_DEBUG_CTFE`).is_some(), {
      eprintln(`[ctfe-ana-gate] fid=${func_id_str}`);
    });
    return(
      ComptimeFnCallResult(
        value : _ctfe_unknown(return_type, caller_env),
        caller_env : caller_env,
        callee_env : callee_env,
        comptime_ref : Option(ComptimeRef).None
      )
    );
  });
  // During the function-call CHECKING phase (overload trial dry-runs),
  // never execute CTFE — return an UnknownVal of the declared return type.
  // Mirrors TS `skipCtfeExecution` + `isInFunctionCallCheckingPhase`
  // (function.ts:822-831 sets both on every dry-run; helper.ts:1735 then
  // skips execution): trials are TYPE checks only. Without this, each
  // overload dry-run re-evaluated its cloned arg exprs INCLUDING macro
  // expansion + CTFE, going exponential in nested operator-call chains
  // (std/glob.yo never finished a single check).
  // During the function-call CHECKING phase (overload trial dry-runs),
  // skip execution ONLY for non-type CTFE functions — mirrors TS
  // function.ts:1843 `isInFunctionCallCheckingPhase && isNonTypeCtfeFunction`
  // where isNonTypeCtfeFunction = comptime-only return AND NOT an unquote
  // macro AND NOT a type-returning constructor AND no generic params
  // (function.ts:782-789, "prevents exponential blowup when checking
  // recursive CTFE functions"; type constructors MUST still execute so the
  // trial can resolve argument types). Without any gate, each overload
  // dry-run re-evaluated cloned arg exprs including nested CTFE —
  // exponential in nested operator chains (std/glob.yo never finished).
  ctfe_gate_result_is_comptime := match(
    function_type,
    .Func({ meta : __fm1 }) => __fm1.*.result_is_comptime_only,
    _ => false
  );
  ctfe_gate_forall_n := match(
    function_type,
    .Func({ meta : __fm2 }) => __fm2.*.forall_labels.len(),
    _ => usize(0)
  );
  if((
    (
      (ctx.is_in_function_call_checking_phase && ctfe_gate_result_is_comptime) &&
        (!(is_type_hierarchy_type(return_type)))
    ) &&
      (!(macro_return_is_unquote(func_id_str.clone())))
  ) &&
    (ctfe_gate_forall_n == usize(0)), {
    if(in_def_time_trial() && ctfe_dbg_env.get(`YO_DEBUG_CTFE`).is_some(), {
      eprintln(`[ctfe-check-gate] fid=${func_id_str}`);
    });
    return(
      ComptimeFnCallResult(
        value : _ctfe_unknown(return_type, caller_env),
        caller_env : caller_env,
        callee_env : callee_env,
        comptime_ref : Option(ComptimeRef).None
      )
    );
  });
  // Collect all argument values from forall_args, args, and variadic_args.
  // All must be compile-time-known (Some); otherwise it's an error.
  all_arg_vals := ArrayList(EvalValue).new();
  (collect_ok : bool) = true;
  n_fa := arg_values.forall_args.len();
  (fai : usize) = usize(0);
  while((fai < n_fa) && collect_ok, {
    match(
      arg_values.forall_args.get(fai),
      .Some(e) => match(
        e.value,
        .Some(v) => {
          all_arg_vals.push(v);
        },
        .None => {
          collect_ok = false;
        }
      ),
      .None => {
        collect_ok = false;
      }
    );
    fai = (fai + usize(1));
  });
  n_a := arg_values.args.len();
  (ai : usize) = usize(0);
  while((ai < n_a) && collect_ok, {
    match(
      arg_values.args.get(ai),
      .Some(e) => match(
        e.value,
        .Some(v) => {
          all_arg_vals.push(v);
        },
        .None => {
          collect_ok = false;
        }
      ),
      .None => {
        collect_ok = false;
      }
    );
    ai = (ai + usize(1));
  });
  n_va := arg_values.variadic_args.len();
  (vai : usize) = usize(0);
  while((vai < n_va) && collect_ok, {
    match(
      arg_values.variadic_args.get(vai),
      .Some(e) => match(
        e.value,
        .Some(v) => {
          all_arg_vals.push(v);
        },
        .None => {
          collect_ok = false;
        }
      ),
      .None => {
        collect_ok = false;
      }
    );
    vai = (vai + usize(1));
  });
  if(!(collect_ok), {
    exn.throw(
      dyn(
        format_error_message(
          match(
            function_callee_expr,
            .Some(e) => ast_expr_token(e),
            .None => ast_expr_token(make_err_expr())
          ),
          String.from("Failed to call the function for compile-time. Some arguments are not compile-time evaluated correctly."),
          false,
          .None
        )
      )
    );
  });
  if(in_def_time_trial() && ctfe_dbg_env.get(`YO_DEBUG_CTFE`).is_some(), {
    (dbge_args : String) = String.from("");
    (dbge_i : usize) = usize(0);
    while(dbge_i < all_arg_vals.len(), {
      match(
        all_arg_vals.get(dbge_i),
        .Some(dv) => {
          dbge_args.push_string(value_to_string(dv));
          dbge_args.push_string(String.from(" | "));
        },
        .None => ()
      );
      dbge_i = (dbge_i + usize(1));
    });
    dbge_callee := match(
      function_callee_expr,
      .Some(fce) => ast_expr_to_string(fce),
      .None => String.from("<none>")
    );
    eprintln(`[ctfe-in] fid=${func_id_str} callee=${dbge_callee} args=${dbge_args}`);
  });
  // Execution gate for unknown arguments. TS never executes a comptime body
  // when an argument is a runtime unknown: its runtime-unknowns are
  // `undefined` and throw at the collect step above (comptime-fn.ts:78).
  // yo-self represents runtime-unknowns as `UnknownVal` (value.yo), which
  // passes that check — so an unknown-arg CTFE body would execute, and a
  // RECURSIVE comptime fn (e.g. `__yo_comptime_fold_range`, `__sN`) recurses
  // forever: the unknown termination cond evaluates both branches, and the
  // growing accumulator argument never matches the in-progress cache entry.
  // Return `UnknownVal(return_type)` without executing — the same result
  // TS's checking phase produces (`skipCtfeExecution`, helper.ts:1735);
  // yo-self's `UnknownVal` also covers TS's type-known `UnknownValue` case,
  // for which an unknown result of the declared return type is the correct
  // non-executing outcome.
  (any_arg_unknown : bool) = false;
  {
    (uai : usize) = usize(0);
    while((uai < all_arg_vals.len()) && !(any_arg_unknown), {
      match(
        all_arg_vals.get(uai),
        .Some(v) => if(is_unknown_val(v), {
          any_arg_unknown = true;
        }),
        .None => ()
      );
      uai = (uai + usize(1));
    });
  };
  // TRIAL carve-out from the gate below: TS executes a TYPE-returning
  // constructor's body even with UnknownValue args (comptime-fn.ts has no
  // unknown-arg execution gate at all), so a def-time trial calling
  // `_ArrayIter(T, N)` with the impl's value binder `N : usize` bound to an
  // unknown must RUN the body — the degraded `_ctfe_unknown(Type)` is a
  // fresh bare SomeT, which the callee-dispatch then cannot call ("TypeVal
  // SomeT callee without FnTrait", root 7623 of
  // issues/fixed/def-eval-swallow-remaining-roots.md). Scope: def-time trials
  // AND type-hierarchy returns only. The gate's recursion concern
  // (fold_range) is about VALUE-returning recursive fns — type ctors at
  // trial time already execute today with SomeT type args (roots 7942/7973
  // measured executing) under the same no-durable-cache regime.
  trial_type_ctor_unknown_ok := (in_def_time_trial() && is_type_hierarchy_type(return_type));
  if(any_arg_unknown && !(trial_type_ctor_unknown_ok), {
    if(in_def_time_trial() && ctfe_dbg_env.get(`YO_DEBUG_CTFE`).is_some(), {
      (dbg_args : String) = String.from("");
      (dbg_i : usize) = usize(0);
      while(dbg_i < all_arg_vals.len(), {
        match(
          all_arg_vals.get(dbg_i),
          .Some(dv) => {
            dbg_args.push_string(value_to_string(dv));
            dbg_args.push_string(String.from(" | "));
          },
          .None => ()
        );
        dbg_i = (dbg_i + usize(1));
      });
      eprintln(`[ctfe-unk-arg] fid=${func_id_str} args=${dbg_args}`);
    });
    return(
      ComptimeFnCallResult(
        value : _ctfe_unknown(return_type, caller_env),
        caller_env : caller_env,
        callee_env : callee_env,
        comptime_ref : Option(ComptimeRef).None
      )
    );
  });
  // A trial-time unknown-arg type-ctor execution must NEVER cache (the
  // unknown arg would collide distinct instantiations in the memo); the
  // SomeT carve-outs below already disable caching for the common case,
  // but unknown VALUE args (IntLit-typed binders) are invisible to them.
  (trial_unknown_nocache : bool) = (any_arg_unknown && trial_type_ctor_unknown_ok);
  // Only cache CTFE calls that return a Type (TypeHierarchyType / TypeUni).
  // Pure type-constructor functions like Box(T), Vec(T) etc. are safe to cache.
  // Functions returning runtime values may have side effects and must not be cached.
  // Cache type-returning calls. `is_type_hierarchy_type` catches bare-`Type`
  // returns — and ONLY that, mirroring TS (comptime-fn.ts:91 caches solely on
  // `isTypeHierarchyType(returnType)`). Do NOT widen to
  // `result_is_comptime_only`: a comptime-VALUE-returning fn (e.g. a
  // `Type.map_variants` mapper `-> comptime(Expr)`) is not identified by its
  // non-type args here — all N per-variant calls collided on one memo entry
  // and every variant received the FIRST variant's Expr
  // (issues/yo-self-derive-mapvariants-mapper-ctfe.md).
  // A call whose arguments are ALL compile-time type VALUES is a
  // type-constructor instantiation; cache it (keyed by func_id + type args) so
  // every instantiation is one stable-id TypeValue (terminates the
  // synthesizer's id-keyed cycle guard) and is stamped. Mirrors the routing
  // widening in `function.yo`'s gate.
  all_args_are_types := cond(
    (all_arg_vals.len() == usize(0)) => false,
    true => {
      (ok2 : bool) = true;
      (cti : usize) = usize(0);
      while((cti < all_arg_vals.len()) && ok2, {
        match(
          all_arg_vals.get(cti),
          .Some(v) => if(!(is_type_val(v)), {
            ok2 = false;
          }),
          .None => {
            ok2 = false;
          }
        );
        cti = (cti + usize(1));
      });
      ok2
    }
  );
  (should_cache : bool) = ((is_type_hierarchy_type(return_type) || all_args_are_types) && !(trial_unknown_nocache));
  // TS checking-phase parity (SomeT surgery slice 2b): a ctfe call whose TYPE
  // args still CONTAIN unresolved SomeTs (analysis/validation generations
  // evaluating a declaration with `Self` bound to a fresh SomeT — the
  // `Box(V)` placeholder instantiations) must NOT create durable memo
  // entries: the placeholder result (payload = unresolved SomeT -> void*)
  // otherwise gets served to later real calls and its instantiation struct
  // reaches codegen as a SECOND C type for the logical Box(T) — the
  // recursive-enum construct+drop heap corruption
  // (issues/repros/recursive-enum-box-plus-arraylist-self.yo: emitted C
  // carried `Box(V)` + `Box(shell)` and NO `Box(final)`).
  // type_contains_some_type carves out resolved/Fn/Future SomeTs, so
  // concrete-at-codegen args keep caching exactly as before.
  if(should_cache, {
    (sc_i : usize) = usize(0);
    while((sc_i < all_arg_vals.len()) && should_cache, {
      match(
        all_arg_vals.get(sc_i),
        .Some(sc_v) => match(
          sc_v,
          .TypeVal(sc_t) => {
            if(type_contains_some_type(sc_t), {
              should_cache = false;
            });
            // DEEP check one level: a struct ARG whose type_arguments carry
            // SomeTs is a DEF-ERA instance (itself a nocache mint) —
            // `type_contains_some_type` is SHALLOW and walks right past
            // type_arguments, so `Option(RBNode(K, V))` at DEF time (arg =
            // the K/V-SomeT-argumented Node instance) got CACHED, and every
            // later CONCRETE `Option(RBNode(i32, i32))` lookup missed
            // against it (era mismatch) while OTHER def-time evaluations
            // HIT it — splitting one logical Option instantiation into two
            // C enums (`__yo_t42`/`__yo_t43`, the imm_threading
            // struct-to-struct casts). Never cache on def-era args.
            if(should_cache, {
              match(
                sc_t,
                .Struct({ type_arguments : sc_ta }) => {
                  (sc_tai : usize) = usize(0);
                  while((sc_tai < sc_ta.len()) && should_cache, {
                    match(
                      sc_ta.get(sc_tai),
                      .Some(sc_tat) => if(is_some_type(sc_tat) || type_contains_some_type(sc_tat), {
                        should_cache = false;
                      }),
                      .None => ()
                    );
                    sc_tai = (sc_tai + usize(1));
                  });
                },
                _ => ()
              );
            });
          },
          _ => ()
        ),
        .None => ()
      );
      sc_i = (sc_i + usize(1));
    });
  });
  // Find or create the cache bucket for this func_id in g_comptime_fn_caches.
  (entry_idx_opt : Option(usize)) = Option(usize).None;
  {
    (ci : usize) = usize(0);
    n_c := g_comptime_fn_caches.len();
    while((ci < n_c) && match(entry_idx_opt, .None => true, .Some(_) => false), {
      match(
        g_comptime_fn_caches.get(ci),
        .Some(e) => if(e.func_id == func_id_str, {
          entry_idx_opt = Option(usize).Some(ci);
        }),
        .None => ()
      );
      ci = (ci + usize(1));
    });
  };
  match(
    entry_idx_opt,
    .None => {
      new_entry := ComptimeFnCacheEntry(
        func_id : func_id_str,
        caches : ArrayList(CalledComptimeFnCache).new()
      );
      g_comptime_fn_caches.push(new_entry);
      entry_idx_opt = Option(usize).Some(g_comptime_fn_caches.len() - usize(1));
    },
    .Some(_) => ()
  );
  the_entry_idx := match(entry_idx_opt, .Some(i) => i, .None => usize(0));
  // Look up an existing cache entry if caching is enabled.
  cached_result := Option(EvalValue).None;
  if(should_cache, {
    match(
      g_comptime_fn_caches.get(the_entry_idx),
      .Some(entry) => {
        (cfi : usize) = usize(0);
        n_cc := entry.caches.len();
        while((cfi < n_cc) && match(cached_result, .None => true, .Some(_) => false), {
          match(
            entry.caches.get(cfi),
            .Some(cache) => {
              if(cache.arg_values.len() == all_arg_vals.len(), {
                (args_match : bool) = true;
                (ami : usize) = usize(0);
                n_av := all_arg_vals.len();
                while((ami < n_av) && args_match, {
                  match(
                    cache.arg_values.get(ami),
                    .Some(cached_av) => match(
                      all_arg_vals.get(ami),
                      .Some(given_av) => {
                        args_match = _ctfe_args_equal(cached_av, given_av);
                      },
                      .None => {
                        args_match = false;
                      }
                    ),
                    .None => {
                      args_match = false;
                    }
                  );
                  ami = (ami + usize(1));
                });
                if(args_match, {
                  cached_result = Option(EvalValue).Some(cache.value);
                });
              });
            },
            .None => ()
          );
          cfi = (cfi + usize(1));
        });
      },
      .None => ()
    );
  });
  // If a cache hit was found, return it immediately.
  match(
    cached_result,
    .Some(cached_val) => {
      if(in_def_time_trial() && ctfe_dbg_env.get(`YO_DEBUG_CTFE`).is_some(), {
        eprintln(`[ctfe-hit] fid=${func_id_str} result=${value_to_string(cached_val)}`);
      });
      return(
        ComptimeFnCallResult(
          value : cached_val,
          caller_env : caller_env,
          callee_env : callee_env,
          comptime_ref : Option(ComptimeRef).None
        )
      );
    },
    .None => ()
  );
  // No cache hit.  Push a temporary "in-progress" cache entry to detect
  // recursive calls (they will hit this entry and return the UnknownVal).
  temp_cache := CalledComptimeFnCache(
    func_id : func_id_str,
    arg_values : all_arg_vals,
    value : _recursive_placeholder(return_type, func_id_str, all_arg_vals)
  );
  match(
    g_comptime_fn_caches.get(the_entry_idx),
    .Some(entry) => {
      entry.caches.push(temp_cache);
    },
    .None => ()
  );
  temp_cache_index := match(
    g_comptime_fn_caches.get(the_entry_idx),
    .Some(entry) => (entry.caches.len() - usize(1)),
    .None => usize(0)
  );
  // Set up the context modifications for function body evaluation.
  // Save old values so we can restore after the call.
  old_fn_ctx := ctx.is_evaluating_function_body_or_async_block;
  old_loop_ctx := ctx.is_evaluating_loop_body;
  old_cap_vars := ctx.captured_variables;
  old_executing := ctx.is_executing;
  old_ret_impl := ctx.function_return_impl_concrete_type;
  old_force_ct := ctx.force_compile_time_bindings;
  ctx.is_evaluating_function_body_or_async_block = Option(FuncOrAsyncBlockCtx).Some(
    FuncOrAsyncBlockCtx(
      kind : FuncOrAsyncBlockKind.FunctionBody,
      func_type : Option(TypeValue).Some(function_type),
      func_value : Option(EvalValue).Some(function_value),
      eval_env : snapshot_env(callee_env)
    )
  );
  ctx.is_evaluating_loop_body = .None;
  ctx.captured_variables = .None;
  ctx.is_executing = (!(ctx.is_validating_function_definition));
  ctx.function_return_impl_concrete_type = Option(ArrayList(ImplConcreteTypeInfo)).Some(
    ArrayList(ImplConcreteTypeInfo).new()
  );
  ctx.force_compile_time_bindings = true;
  // Evaluate a FRESH-ID CLONE of the function body — TS evaluates
  // `cloneExpr(functionBodyExpr)` per call (comptime-fn.ts:199), and its
  // per-NODE `expr.$` info makes each execution's annotations private.
  // yo-self's ExprInfo table is keyed by expr id, so executing the ORIGINAL
  // tree makes every call overwrite the same ids: `SortedSet(i32)`'s body
  // then read the T-era `SortedMap(T, bool)` instances annotated by the
  // impl-registration call — splitting one TS type identity into two chains.
  body_expr := clone_expr_fresh_ids(body_box);
  // Track CTFE depth around the body eval: struct/enum declaration eval mints
  // DECLARATION-STABLE ids only at depth 0 (module level) — inside a comptime
  // constructor call (generic INSTANTIATION), ids stay eval-fresh so
  // Option(i32)/Option(String) never share identity (SomeT surgery slice 2;
  // see context.yo ctfe_depth).
  ctx.ctfe_depth = (ctx.ctfe_depth + usize(1));
  evaled_body := evaluate_begin_expression(
    body_expr,
    callee_env,
    ctx,
    ArrayList(Variable).new(),
    true,
    exn
  );
  ctx.ctfe_depth = (ctx.ctfe_depth - usize(1));
  // Restore context.
  ctx.is_evaluating_function_body_or_async_block = old_fn_ctx;
  ctx.is_evaluating_loop_body = old_loop_ctx;
  ctx.captured_variables = old_cap_vars;
  ctx.is_executing = old_executing;
  ctx.function_return_impl_concrete_type = old_ret_impl;
  ctx.force_compile_time_bindings = old_force_ct;
  // Extract the return value from the ExprInfoTable.
  body_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_body));
  body_info := match(
    body_info_opt,
    .Some(i) => i,
    .None => {
      // Remove the temp cache entry to avoid leaving a stale placeholder.
      match(
        g_comptime_fn_caches.get(the_entry_idx),
        .Some(entry) => {
          entry.caches.remove(temp_cache_index, usize(1));
        },
        .None => ()
      );
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(body_expr),
            String.from("Function body is not evaluated correctly"),
            false,
            .None
          )
        )
      );
      new_expr_info(callee_env, t_unit())
    }
  );
  return_value := match(
    body_info.value,
    .Some(v) => v,
    .None => {
      // Remove the temp cache entry.
      match(
        g_comptime_fn_caches.get(the_entry_idx),
        .Some(entry) => {
          entry.caches.remove(temp_cache_index, usize(1));
        },
        .None => ()
      );
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(body_expr),
            String.from("Function body is not evaluated correctly. Expected to return(a compile-time known value.)"),
            false,
            .None
          )
        )
      );
      create_unknown_val(return_type)
    }
  );
  // Stamp the returned type with this constructor's func_id, mirroring
  // `src/evaluator/calls/comptime-fn.ts:274` (`returnedType.functionValue =
  // functionValue`). Only set when currently empty (TS: `if
  // (!returnedType.functionValue)`). TypeValue is immutable, so rebuild the
  // Struct with the field populated. The synthesizer then unifies two
  // instantiations of the same generic constructor by this id.
  // Record enum constructor identity (EnumT has no cfid field to stamp).
  match(
    return_value,
    .TypeVal(rv_eb) => match(
      rv_eb,
      .EnumT(eid, _, _, _, _, _, _, _, _) => register_enum_cfid(eid, func_id_str),
      _ => ()
    ),
    _ => ()
  );
  // Collect this instantiation's type-valued arguments, in parameter order, to
  // record on the returned Struct (faithful stand-in for `StructType.env`): a
  // method later dispatched on the instantiation binds its `generic` params
  // positionally from these. Non-type args become `Unit` placeholders so the
  // positions still line up with the constructor's parameters.
  inst_type_args := ArrayList(TypeValue).new();
  (tai : usize) = usize(0);
  while(tai < all_arg_vals.len(), {
    match(
      all_arg_vals.get(tai),
      .Some(av) => {
        match(
          av,
          .TypeVal(tb) => {
            _p := inst_type_args.push(tb);
          },
          _ => {
            _p := inst_type_args.push(TypeValue.Unit);
          }
        );
      },
      .None => ()
    );
    tai = (tai + usize(1));
  });
  // Stamp the returned type's display name `Box(arg)` for the prelude `Box`
  // constructor only, mirroring `comptime-fn.ts:261-265` (which names ALL
  // comptime-fn type results). yo-self CANNOT name every instantiation: its
  // compatibility layer treats the struct NAME as nominal identity
  // (compatibility.yo:430), so broadly naming generic instantiations breaks
  // type unification (HashMap/ArrayList/nested generics — corpus 90→55). But
  // `is_boxed_type` (types/guards.yo) keys off a `Box(`-prefixed name, and the
  // boxed-dyn vtable path (`dyn(box(Sq))`) needs it to recognise the box and
  // resolve trait methods on the UNDERLYING type. Box instantiations are
  // structurally unambiguous (single `*` field) and never unify with user
  // types, so naming ONLY them is safe. yo-self FuncVal carries no funcName, so
  // read it from the callee expr (the `Box` atom).
  ctfe_fn_name := match(function_callee_expr, .Some(ce) => ast_expr_token(ce).value, .None => String.from(""));
  ctfe_box_name := if(!(ctfe_fn_name == "Box"), String.from(""), {
    nm := String.from("Box(");
    (cni : usize) = usize(0);
    while(cni < all_arg_vals.len(), {
      if(cni > usize(0), {
        nm.push_str(", ");
      });
      match(all_arg_vals.get(cni), .Some(cav) => nm.push_string(value_to_string(cav)), .None => ());
      cni = (cni + usize(1));
    });
    nm.push_str(")");
    nm
  });
  final_return_value := match(
    return_value,
    .TypeVal(rv_tb) => match(
      rv_tb,
      .Struct({ id : sid, name : sname, field_labels : slabels, field_types : stypes, is_reference_semantics : sref, is_atomic_rc : satomic, is_newtype : snt, constructor_func_id : scfid }) => if(scfid.len() == usize(0), {
        // Mirror TS's shared-object stamp for copies that predate this one
        // (self-recursive shells, memoized embedders) — see expr_info.yo.
        register_struct_ctor_fid(sid.clone(), func_id_str.clone());
        stamped_name := if((sname.len() == usize(0)) && (ctfe_box_name.len() > usize(0)), ctfe_box_name.clone(), sname.clone());
        EvalValue.TypeVal(
          TypeValue.Struct(sid, stamped_name, slabels, stypes, sref, satomic, snt, func_id_str, inst_type_args, false)
        )
      }, return_value),
      // Trait returns: record the constructor funcId so the generic-impl
      // registry can key `Eq(Box(i32))` and `Eq(Box(T))` into ONE bucket
      // (TS comptime-fn.ts:266-276 stamping `returnedType.functionValue`,
      // consumed by getBaseTraitKey). Side-table only — TraitT carries no
      // fid field; first stamp wins inside the register fn.
      .TraitT(_, _, _, _, ct_trait_id, _, _, _, _, _) => {
        register_trait_ctor_fid(ct_trait_id.clone(), func_id_str.clone());
        return_value
      },
      _ => return_value
    ),
    _ => return_value
  );
  // Local copy — `callee_env` is an immutable parameter; thread the updated
  // env through `out_callee_env` and return it.
  (out_callee_env : Environment) = body_info.env;
  // Update or remove the temp cache entry based on whether caching is enabled.
  if(should_cache, {
    updated_cache := CalledComptimeFnCache(
      func_id : func_id_str,
      arg_values : all_arg_vals,
      value : final_return_value
    );
    match(
      g_comptime_fn_caches.get(the_entry_idx),
      .Some(entry) => {
        // ArrayList has no in-place element assignment; replace the temp
        // placeholder by removing it and pushing the finalized entry.
        // (Recursive sub-calls only append AFTER temp_cache_index, so it is
        // still the correct slot to drop; lookups match by content, not index.)
        entry.caches.remove(temp_cache_index, usize(1));
        entry.caches.push(updated_cache);
      },
      .None => ()
    );
  }, {
    match(
      g_comptime_fn_caches.get(the_entry_idx),
      .Some(entry) => {
        entry.caches.remove(temp_cache_index, usize(1));
      },
      .None => ()
    );
  });
  if(in_def_time_trial() && ctfe_dbg_env.get(`YO_DEBUG_CTFE`).is_some(), {
    eprintln(`[ctfe-out] fid=${func_id_str} result=${value_to_string(final_return_value)}`);
  });
  ComptimeFnCallResult(
    value : final_return_value,
    caller_env : caller_env,
    callee_env : out_callee_env,
    // TS comptime-fn.ts:297 — comptimeRef: evaluatedFunctionBody.$.comptimeRef.
    comptime_ref : body_info.comptime_ref
  )
});
export(evaluate_comptime_fn_call);
export(ComptimeFnCallResult);
export(RecursiveTypeRef, lookup_recursive_type_ref, resolve_recursive_type_ref);
export(canonicalize_instantiation_via_ctfe_memo);
