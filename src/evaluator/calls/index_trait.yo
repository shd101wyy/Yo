//! evaluator/calls/index_trait — Index-trait call handling.
//!
//! Phase 3u — full implementation.
//!
//! Handles `value(arg)` calls dispatched via the Index trait.
//! For comptime arrays/strings: performs compile-time element indexing
//! (range slicing falls through to the runtime slice_copy rewrite).
//! For runtime values: looks up the index method and returns UnknownVal.
//!
//! Phase 3u simplifications:
//!   - Custom type ComptimeIndex: dispatched via _try_comptime_custom_type_index
//!   - has_index_impl: Array fast path + trait-field/registry method lookup
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ str_lit_unquote_bytes } :: import("../../utils.yo");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token, ast_expr_id, make_err_expr, ast_expr_is_fn_call_of, ast_expr_is_atom_of, ast_expr_to_string, BF_DOT } :: import("../../expr.yo");
{ Environment, Variable, get_receiver_methods_by_name_from_env, get_variables_from_env, add_variable_to_env, synthetic_token, snapshot_env, FvCaptureSource, fv_capture_source, fv_source_name, fv_source_ty, fv_capture_vals } :: import("../../env.yo");
{ TypeValue, TypeValueNode } :: import("../../types/definitions.yo");
{ t_unit, t_ptr, t_usize, t_type } :: import("../../types/creators.yo");
{ is_array_type, is_pointer_type, is_trait_type, is_struct_type, is_function_type, is_reference_struct_type } :: import("../../types/guards.yo");
{
  EvalValue,
  is_array_val,
  is_str_lit,
  is_struct_val,
  is_int_lit,
  is_func_val,
  is_unknown_val,
  create_unknown_val,
  create_runtime_unknown_val
} :: import("../../value.yo");
{
  EvalContext,
  IndexCallResult,
  ExpectedTypeCtx,
  ArgEntry,
  ArgValues,
  VarArgEntry,
  set_promote_index_places_fn
} :: import("../context.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set,
  ComptimeRef,
  expr_info_adopt_env,
  expr_info_comptime_ref,
  expr_info_index_trait_ptr_type,
  expr_info_index_method_type,
  expr_info_set_index_method_type,
  expr_info_set_index_method_value
} :: import("../../expr_info.yo");
{ format_error_message, format_eval_failure, with_code } :: import("../../error.yo");
{ E_WRITE_THROUGH_BORROW } :: import("../../diagnostics.yo");
{ type_to_string } :: import("../../types/string.yo");
{ variable_is_imm_borrow } :: import("../utils.yo");
{ are_types_compatible } :: import("../../types/compatibility.yo");
{ convert_comptime_type_to_runtime_type, get_trait_type_from_env } :: import("../../types/env_lookup.yo");
{ _is_verify_target, resolve_verify_mode, record_index_unchecked_twin, forget_index_unchecked_twin } :: import("../builtins/contracts.yo");
{ evaluate_expression, evaluate_expression_guarded } :: import("../exprs/expr.yo");
{ try_to_call_function_with_arguments, consume_argument_for_parameter } :: import("./helper.yo");
{ get_func_param_comptime } :: import("../types/function.yo");
{ evaluate_comptime_fn_call } :: import("./comptime_fn.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// Private types
// ---------------------------------------------------------------------------
/// One candidate `index` method found on a type.
_IndexMethodEntry :: struct(
  method_type : TypeValue,
  method_value : Option(EvalValue)
);
/// Result of `_check_range_type`.
_RangeCheck :: struct(is_range : bool, is_inclusive : bool);
derive(_RangeCheck, Copy, Clone);
/// A resolved range pair (start inclusive, end exclusive).
_IdxRange :: struct(start_idx : usize, end_idx : usize);
derive(_IdxRange, Copy, Clone);
// ---------------------------------------------------------------------------
// _str_unquote / _str_quote
// ---------------------------------------------------------------------------
/// Strip surrounding `"..."` from a raw StrLit value.
_str_unquote :: (fn(raw : &String) -> String)({
  rn := raw.len();
  if(
    rn >= usize(2),
    str_lit_unquote_bytes(raw),
    String.new()
  )
});
/// Add surrounding `"..."` around a string value.
_str_quote :: (fn(s : &String) -> String)(
  String.from("\"") + s + String.from("\"")
);
// ---------------------------------------------------------------------------
// _check_range_type
// ---------------------------------------------------------------------------
/// CTFE-call one candidate constructor with `usize`; a resolved struct type
/// rides out via `out`. The swallowing handler is a capture-free `->` that
/// unwinds UNIT — never the resolved type: `unwind(v)` memcpys `v` into the
/// fixed 64-byte `__yo_unwind_value` buffer, and a `TypeValue` does not fit
/// (same constraint as `_trial_eval_fn_body`, function_type.yo:239).
_try_ctfe_range_ctor :: (
  fn(
    fn_ty : &TypeValue,
    fn_val : &EvalValue,
    env : &Environment,
    ctx : &EvalContext,
    out : &mut ArrayList(TypeValue)
  ) -> unit
)({
  local_exn := Exception(
    throw : (
      _e -> unwind(())
    )
  );
  ct_args := ArrayList(ArgEntry).new();
  ct_args.push(
    ArgEntry(
      value : Option(EvalValue).Some(EvalValue.TypeVal(t_usize())),
      parameter_type : t_type(),
      arg_type : t_type()
    )
  );
  res := evaluate_comptime_fn_call(
    Option(AstExpr).None,
    fn_ty,
    fn_val,
    ArgValues(
      forall_args : ArrayList(ArgEntry).new(),
      args : ct_args,
      implicit_args : Option(ArrayList(ArgEntry)).None,
      variadic_args : ArrayList(VarArgEntry).new()
    ),
    env,
    env,
    ctx,
    local_exn
  );
  match(
    res.value,
    .TypeVal(rt) => if(is_struct_type(rt.clone()), {
      out.push(rt);
    }),
    _ => ()
  );
});
/// Resolve a prelude type constructor (`Range` / `RangeInclusive`) applied to
/// `usize`, by looking the constructor up in `env` and CTFE-calling it.
/// The constructor call is run under a swallowing local exn — a resolve
/// failure yields `.None`.
_resolve_prelude_range_type :: (
  fn(name : &String, env : &Environment, ctx : &EvalContext) -> Option(TypeValue)
)({
  vars := get_variables_from_env(env, name.clone());
  out := ArrayList(TypeValue).new();
  (vi : usize) = usize(0);
  while((vi < vars.len()) && (out.len() == usize(0)), {
    match(
      vars.get(vi),
      .Some(v) => match(
        v.value.get(usize(0)),
        .Some(fv) => if(is_func_val(&fv) && is_function_type(&v.ty), {
          _try_ctfe_range_ctor(&v.ty, &fv, env, ctx, &mut out);
        }),
        .None => ()
      ),
      .None => ()
    );
    vi = (vi + usize(1));
  });
  out.get(usize(0))
});
/// The type constructor a struct type came from (`""` when it was not built
/// by one). See `_check_range_type`.
_struct_ctor_fid :: (fn(t : &TypeValue) -> String)(
  match(
    t,
    .Struct({ constructor_func_id : cfid }) => cfid,
    _ => String.from("")
  )
);
/// False when `a` and `b` are structs built by DIFFERENT type constructors —
/// a nominal distinction `are_types_compatible` cannot make for two anonymous
/// structs of the same shape. `""` on either side means "unknown", which
/// defers to the structural check.
_ctor_ids_agree :: (fn(a : &TypeValue, b : &TypeValue) -> bool)({
  a_fid := _struct_ctor_fid(a);
  b_fid := _struct_ctor_fid(b);
  if((a_fid.len() > usize(0)) && (b_fid.len() > usize(0)), {
    return(a_fid == b_fid);
  });
  true
});
/// Process-lifetime cache for `Range(usize)` / `RangeInclusive(usize)`.
/// Both come from the prelude, which is shared by
/// every module in a compilation, so a plain global is the same thing here.
/// Only SUCCESSFUL resolutions are cached, so an early call against an env
/// that cannot see the prelude does not poison later ones.
(g_range_ty_cache : ArrayList(TypeValue)) = ArrayList(TypeValue).new();
(g_range_incl_ty_cache : ArrayList(TypeValue)) = ArrayList(TypeValue).new();
_cached_range_type :: (
  fn(inclusive : bool, env : &Environment, ctx : &EvalContext) -> Option(TypeValue)
)({
  cache := if(inclusive, g_range_incl_ty_cache, g_range_ty_cache);
  match(
    cache.get(usize(0)),
    .Some(hit) => Option(TypeValue).Some(hit),
    .None => {
      name := if(inclusive, String.from("RangeInclusive"), String.from("Range"));
      resolved := _resolve_prelude_range_type(&name, env, ctx);
      match(
        resolved,
        .Some(rt) => {
          cache.push(rt.clone());
          Option(TypeValue).Some(rt)
        },
        .None => Option(TypeValue).None
      )
    }
  )
});
/// Is `arg_type` a `Range(...)` / `RangeInclusive(...)`?
///
/// Resolve the prelude
/// constructors applied to `usize` and ask `are_types_compatible`. The
/// previous implementation matched on the struct's NAME (`starts_with("Range")`),
/// a Phase-3u shortcut that never fired — `Range :: (fn(comptime(T) : Type) ->
/// comptime(Type))(struct(start : T, end : T))` yields an ANONYMOUS struct, so
/// the name is empty and every range was reported as a non-range. Comptime
/// STRING slicing is the one caller that needs a `true` here (the array caller
/// only uses it to fall through to the runtime path, which is also what a
/// wrong `false` did), so `x(0 .. 5)` on a `comptime_str` took the
/// single-character branch — one swallowed error that hollowed all 49 tests
/// in tests/index.test.yo.
_check_range_type :: (
  fn(arg_type : &TypeValue, env : &Environment, ctx : &EvalContext) -> _RangeCheck
)({
  if(!is_struct_type(arg_type.clone()), {
    return(_RangeCheck(is_range : false, is_inclusive : false));
  });
  // The TYPE CONSTRUCTOR's id is the discriminator, not the shape.
  // `Range` and `RangeInclusive` are BOTH `struct(start : T, end : T)` and
  // both anonymous, so `are_types_compatible` says yes to either — with
  // the inclusive test first, every exclusive `a .. b` was
  // read as INCLUSIVE and `"Hello World"(0 .. 5)` sliced one byte too far.
  // The nominal distinction is
  // `Struct.constructor_func_id`, stamped by `evaluate_comptime_fn_call`
  // on every comptime type-constructor result — and shared by all of one
  // constructor's instantiations, so the `Range(comptime_int)` argument
  // matches the `Range(usize)` probe. `are_types_compatible` stays as the
  // fallback for a struct that carries no constructor id.
  arg_fid := _struct_ctor_fid(arg_type.clone());
  ri_opt := _cached_range_type(true, env, ctx);
  r_opt := _cached_range_type(false, env, ctx);
  if(arg_fid.len() > usize(0), {
    match(
      ri_opt,
      .Some(ri_ty) => if(_struct_ctor_fid(&ri_ty) == arg_fid, {
        return(_RangeCheck(is_range : true, is_inclusive : true));
      }),
      .None => ()
    );
    match(
      r_opt,
      .Some(r_ty) => if(_struct_ctor_fid(&r_ty) == arg_fid, {
        return(_RangeCheck(is_range : true, is_inclusive : false));
      }),
      .None => ()
    );
  });
  match(
    ri_opt,
    .Some(ri_ty2) => if(are_types_compatible(arg_type.clone(), &ri_ty2), {
      return(_RangeCheck(is_range : true, is_inclusive : true));
    }),
    .None => ()
  );
  match(
    r_opt,
    .Some(r_ty2) => if(are_types_compatible(arg_type.clone(), &r_ty2), {
      return(_RangeCheck(is_range : true, is_inclusive : false));
    }),
    .None => ()
  );
  _RangeCheck(is_range : false, is_inclusive : false)
});
// ---------------------------------------------------------------------------
// _extract_range_indices
// ---------------------------------------------------------------------------
/// Extract start/end indices from a Range StructVal.
/// Returns None if the value is not a StructVal with numeric start/end.
_extract_range_indices :: (
  fn(
    range_ev : &EvalValue,
    is_inclusive : bool
  ) -> Option(_IdxRange)
)(
  match(
    range_ev,
    .StructVal(_, _, field_values) => {
      start_field := match(
        field_values.get(usize(0)),
        .Some(v) => v,
        .None => {
          return(Option(_IdxRange).None);
        }
      );
      end_field := match(
        field_values.get(usize(1)),
        .Some(v) => v,
        .None => {
          return(Option(_IdxRange).None);
        }
      );
      if(!is_int_lit(&start_field) || !is_int_lit(&end_field), {
        return(Option(_IdxRange).None);
      });
      start_raw := match(
        start_field,
        .IntLit(r) => r,
        _ => {
          return(Option(_IdxRange).None);
        }
      );
      end_raw := match(
        end_field,
        .IntLit(r) => r,
        _ => {
          return(Option(_IdxRange).None);
        }
      );
      start_i64 := match(
        start_raw.parse_i64(),
        .Some(n) => n,
        .None => {
          return(Option(_IdxRange).None);
        }
      );
      end_raw_i64 := match(
        end_raw.parse_i64(),
        .Some(n) => n,
        .None => {
          return(Option(_IdxRange).None);
        }
      );
      end_i64 := if(is_inclusive, end_raw_i64 + i64(1), end_raw_i64);
      if(start_i64 < i64(0), {
        return(Option(_IdxRange).None);
      });
      if(end_i64 < i64(0), {
        return(Option(_IdxRange).None);
      });
      Option(_IdxRange).Some(
        _IdxRange(
          start_idx : usize(start_i64),
          end_idx : usize(end_i64)
        )
      )
    },
    _ => Option(_IdxRange).None
  )
);
// ---------------------------------------------------------------------------
// _find_all_index_methods
// ---------------------------------------------------------------------------
/// Find all `index` methods on a concrete type: TraitT receivers expose them
/// as direct trait fields; struct/object receivers resolve through the
/// trait-methods registry + generic-impl fallback.
_find_all_index_methods :: (
  fn(
    concrete_type : &TypeValue,
    env : &Environment,
    (method_name : str) ?= "index"
  ) -> ArrayList(_IndexMethodEntry)
)({
  result := ArrayList(_IndexMethodEntry).new();
  match(
    concrete_type,
    .TraitT(_, _, field_labels, field_types, _, _, _, _, _, _) => {
      n := field_labels.len();
      (i : usize) = usize(0);
      while(i < n, {
        lbl_opt := field_labels.get(i);
        ty_opt := field_types.get(i);
        match(
          lbl_opt,
          .Some(lbl) => {
            if(lbl == method_name, {
              match(
                ty_opt,
                .Some(fty) => {
                  if(match(fty, .Func({ result : _ }) => true, _ => false), {
                    result.push(
                      _IndexMethodEntry(
                        method_type : fty,
                        method_value : Option(EvalValue).None
                      )
                    );
                  });
                },
                .None => ()
              );
            });
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  );
  // Registry lookup for non-trait receivers (structs/objects like
  // `ArrayList(u8)`): resolved through the trait-methods registry +
  // generic-impl fallback. Post method-type specialization,
  // generic-impl candidates arrive concrete (e.g.
  // `index : fn(self : *(ArrayList(u8)), idx : usize) -> *(u8)`). Without
  // this, `x(i)` on a struct receiver with an unknown value soft-fell to
  // `unit` under def-eval, poisoning every comparison built on it.
  if(result.len() == usize(0), {
    reg_methods := get_receiver_methods_by_name_from_env(env, String.from(method_name), concrete_type, false);
    (ri : usize) = usize(0);
    while(ri < reg_methods.len(), {
      match(
        reg_methods.get(ri),
        .Some(m) => {
          if(match(m.ty, .Func({ result : _ }) => true, _ => false), {
            result.push(
              _IndexMethodEntry(
                method_type : m.ty,
                method_value : m.value
              )
            );
          });
        },
        .None => ()
      );
      ri = (ri + usize(1));
    });
  });
  result
});
// ---------------------------------------------------------------------------
// _find_index_method
// ---------------------------------------------------------------------------
/// The two shapes an `Index` method takes (decision 34, confirmed
/// 2026-10-11; `plans/reference/INDEX_TRAIT.md`):
///   - the projection `index : fn(self : &Self, idx : Idx) -> &Self.Output`
///     and its write twin `index_mut : fn(self : &mut Self, idx : Idx) ->
///     &mut Self.Output` (decision 24, V2b);
///   - the single pre-V2b method `index : fn(self : &mut Self, idx : Idx) ->
///     *Self.Output`, which serves reads and writes alike. It stays accepted
///     until the bundled std switches (Generation B: a seed must lower
///     `-> &T` first).
/// `is_projection` tells them apart; `output` is the element type either way.
_IndexShape :: struct(is_projection : bool, is_mut : bool, output : TypeValue);
/// The shape of `method_type` as an index method for an argument of
/// `arg_type`, or `.None` when it is not one.
_index_shape_of :: (fn(method_type : &TypeValue, arg_type : &TypeValue) -> Option(_IndexShape))(
  match(
    method_type,
    .Func({ param_types, result : result_box, meta : __fm1 }) => cond(
      (param_types.len() != usize(2)) => Option(_IndexShape).None,
      true => {
        p0_is_ref := match(__fm1.*.param_is_ref.get(usize(0)), .Some(b) => b, .None => false);
        p0_is_ptr := is_pointer_type(&param_types(usize(0)));
        // `are_types_compatible(actual, expected)` — the ARGUMENT's type is the
        // actual, the parameter's declared type is the expected. Passing
        // them the other way round made the parameter type the "actual",
        // so the comptime widening arms (types/compatibility.yo:124-146 for
        // ComptimeInt, :171-190 for ComptimeString) — which all key off
        // `actual` — never fired: `l(0)` on a `ComptimeIndex(usize)` impl was
        // rejected with "Type does not implement Index for the given argument
        // type" while `l(usize(0))` worked.
        p1_compatible := are_types_compatible(arg_type, &param_types(usize(1)));
        cond(
          !p1_compatible => Option(_IndexShape).None,
          // A projection: `&Self` for `index`, `&mut Self` for `index_mut`.
          __fm1.*.result_is_ref => Option(_IndexShape).Some(_IndexShape(is_projection : true, is_mut : __fm1.*.result_is_mut_ref, output : result_box)),
          // The pre-V2b shape: self must be a pointer type OR a `&mut`
          // parameter, and the result a raw pointer to the element.
          ((p0_is_ptr || p0_is_ref) && is_pointer_type(&result_box)) => Option(_IndexShape).Some(
            _IndexShape(
              is_projection : false,
              is_mut : true,
              output : match(result_box, .Pointer(et) => et, _ => result_box)
            )
          ),
          true => Option(_IndexShape).None
        )
      }
    ),
    _ => Option(_IndexShape).None
  )
);
/// Find the method that reads `concrete_type(arg)`: an `index` of either
/// shape whose index parameter accepts `arg_type`. A projection `index` must
/// be the read one (`-> &Self.Output`).
_find_index_method :: (
  fn(
    concrete_type : &TypeValue,
    arg_type : &TypeValue,
    env : &Environment
  ) -> Option(_IndexMethodEntry)
)({
  methods := _find_all_index_methods(concrete_type, env, "index");
  (i : usize) = usize(0);
  while(i < methods.len(), {
    m := methods(i);
    match(
      _index_shape_of(&m.method_type, arg_type),
      .Some(sh) => if(!sh.is_projection || !sh.is_mut, {
        return(Option(_IndexMethodEntry).Some(m));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  Option(_IndexMethodEntry).None
});
/// Find the method that writes `concrete_type(arg)`: an `index_mut`
/// projection (`self : &mut Self -> &mut Self.Output`) whose index parameter
/// accepts `arg_type`.
_find_index_mut_method :: (
  fn(
    concrete_type : &TypeValue,
    arg_type : &TypeValue,
    env : &Environment
  ) -> Option(_IndexMethodEntry)
)({
  methods := _find_all_index_methods(concrete_type, env, "index_mut");
  (i : usize) = usize(0);
  while(i < methods.len(), {
    m := methods(i);
    match(
      _index_shape_of(&m.method_type, arg_type),
      .Some(sh) => if(sh.is_projection && sh.is_mut && match(m.method_type, .Func({ meta : imm_fm }) => match(imm_fm.*.param_is_ref.get(usize(0)), .Some(b) => b, .None => false), _ => false), {
        return(Option(_IndexMethodEntry).Some(m));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  Option(_IndexMethodEntry).None
});
// ---------------------------------------------------------------------------
// _try_comptime_element_access
// ---------------------------------------------------------------------------
/// Try comptime single element access for arrays and slices.
/// Returns Some(IndexCallResult) or None to fall through.
_try_comptime_element_access :: (
  fn(
    arg_expr : &AstExpr,
    arg_val : &Option(EvalValue),
    array_val : &Option(EvalValue),
    value_type : &TypeValue,
    caller_env : &Environment,
    exn : Exception
  ) -> Option(IndexCallResult)
)({
  elem_ty := match(
    value_type,
    .Array(et, _, _) => et,
    _ => t_unit()
  );
  match(
    arg_val,
    .Some(v) => if(is_int_lit(&v), {
      // Comptime integer index — direct element access
      idx_raw := match(v, .IntLit(r) => r, _ => String.from("0"));
      idx_i64 := match(
        idx_raw.parse_i64(),
        .Some(n) => n,
        .None => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(arg_expr),
                String.from("Invalid integer literal for array/slice index")
              )
            )
          );
          i64(0)
        }
      );
      if(idx_i64 < i64(0), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg_expr),
              `Array/slice index out of bounds: ${idx_raw}`
            )
          )
        );
      });
      idx_usize := usize(idx_i64);
      // Array branch
      match(
        array_val,
        .Some(av) => {
          match(
            av,
            .ArrayVal(elements) => {
              arr_len := elements.len();
              if(idx_usize >= arr_len, {
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(arg_expr),
                      `Array index out of bounds: ${idx_raw}. Expected index in range [0, ${(arr_len - usize(1))}].`
                    )
                  )
                );
              });
              elem_val := match(
                elements.get(idx_usize),
                .Some(ev) => ev,
                .None => {
                  exn.throw(
                    dyn(
                      format_error_message(
                        ast_expr_token(arg_expr),
                        String.from("Array index out of bounds")
                      )
                    )
                  );
                  EvalValue.UnitVal
                }
              );
              return(
                Option(IndexCallResult).Some(
                  IndexCallResult(
                    value : Option(EvalValue).Some(elem_val),
                    ty : elem_ty,
                    ptr_type : t_ptr(&elem_ty),
                    index_method_type : Option(TypeValue).None,
                    index_method_value : Option(EvalValue).None,
                    caller_env : caller_env,
                    index : Option(usize).Some(idx_usize),
                    // comptimeRef: { kind: "array",
                    // arrayValue, index } makes `arr(i) = v` a comptime place.
                    // `elements` is the SHARED handle destructured from the
                    // ArrayVal, so mutation through the ref lands in the
                    // binding (same as builtins/comptime_index_fns.yo:643).
                    comptime_ref : Option(ComptimeRef).Some(ComptimeRef.ArrayRef(elements, idx_usize))
                  )
                )
              );
            },
            _ => ()
          );
        },
        .None => ()
      );
      // Int lit but no array branch matched — return None
      Option(IndexCallResult).None
    }, {
      // Non-integer comptime value (e.g. UnknownVal) — return unknown element
      unk_val := create_unknown_val(&elem_ty);
      Option(IndexCallResult).Some(
        IndexCallResult(
          value : Option(EvalValue).Some(unk_val),
          ty : elem_ty,
          ptr_type : t_ptr(&elem_ty),
          index_method_type : Option(TypeValue).None,
          index_method_value : Option(EvalValue).None,
          caller_env : caller_env,
          index : Option(usize).None,
          comptime_ref : Option(ComptimeRef).None
        )
      )
    }),
    .None => {
      // Runtime index (no comptime value) — convert element type to runtime
      rt_elem_ty := convert_comptime_type_to_runtime_type(&elem_ty, caller_env);
      Option(IndexCallResult).Some(
        IndexCallResult(
          value : Option(EvalValue).None,
          ty : rt_elem_ty,
          ptr_type : t_ptr(&elem_ty),
          index_method_type : Option(TypeValue).None,
          index_method_value : Option(EvalValue).None,
          caller_env : caller_env,
          index : Option(usize).None,
          comptime_ref : Option(ComptimeRef).None
        )
      )
    }
  )
});
// ---------------------------------------------------------------------------
// _try_comptime_array_index
// ---------------------------------------------------------------------------
/// Main comptime dispatch for array and slice indexing.
/// Evaluates the arg, checks for range vs. element access, delegates.
_try_comptime_array_index :: (
  fn(
    arg_expr : &AstExpr,
    array_val : &Option(EvalValue),
    value_type : &TypeValue,
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> Option(IndexCallResult)
)({
  // Evaluate the arg with `expected_type` CLEARED — the ambient expected type
  // at an index site is the ELEMENT type, which must not leak into the index
  // ARGUMENT's evaluation. `evaluate_expression` is the no-exn
  // wrapper, so no throw can skip the restore.
  cai_saved_expected := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  evaluated_gout := ArrayList(AstExpr).new();
  evaluated_gerr := evaluate_expression_guarded(arg_expr, env, ctx, &mut evaluated_gout);
  ctx.expected_type = cai_saved_expected;
  match(evaluated_gerr, .Some(evaluated_ge) => exn.throw(&evaluated_ge), .None => ());
  evaluated := match(evaluated_gout.get(usize(0)), .Some(evaluated_g) => evaluated_g, .None => make_err_expr());
  info_opt := expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&evaluated));
  info := match(
    info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_eval_failure(
            ast_expr_token(arg_expr),
            String.from("Failed to evaluate index argument")
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  caller_env := expr_info_adopt_env(&info);
  arg_type := info.ty;
  arg_val := info.value;
  range_check := _check_range_type(&arg_type, env, ctx);
  if(range_check.is_range, {
    // Range slicing is no longer a comptime operation — fall through to the
    // runtime path (slice_copy rewriting happens before Index dispatch;
    // plans/archive/SLICE_REWORK.md Part C).
    return(Option(IndexCallResult).None);
  });
  _try_comptime_element_access(
    arg_expr,
    &arg_val,
    array_val,
    value_type,
    &caller_env,
    exn
  )
});
// ---------------------------------------------------------------------------
// _compute_comptime_string_index
// ---------------------------------------------------------------------------
/// Compute the result of indexing a comptime string value.
_compute_comptime_string_index :: (
  fn(
    str_value : &String,
    arg_value : &EvalValue,
    arg_expr : &AstExpr,
    is_range : bool,
    is_inclusive : bool,
    exn : Exception
  ) -> EvalValue
)({
  // During type-checking with UnknownVal, return a placeholder
  if(is_unknown_val(arg_value), {
    return(EvalValue.StrLit(_str_quote(String.from(""))));
  });
  if(!is_range, {
    // Single character access
    if(!is_int_lit(arg_value), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            String.from("Expected comptime_int index for comptime string index")
          )
        )
      );
    });
    idx_raw := match(arg_value, .IntLit(r) => r, _ => String.from("0"));
    idx_i64 := match(
      idx_raw.parse_i64(),
      .Some(n) => n,
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg_expr),
              String.from("Invalid integer literal for string index")
            )
          )
        );
        i64(0)
      }
    );
    if(idx_i64 < i64(0), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            `String index out of bounds: ${idx_raw}`
          )
        )
      );
    });
    idx_usize := usize(idx_i64);
    str_len := str_value.len();
    if(idx_usize >= str_len, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            `String index out of bounds: ${idx_raw}. Expected index in range [0, ${(str_len - usize(1))}].`
          )
        )
      );
    });
    // COMPTIME BYTE BASIS (STD_API_AUDIT_D4_PLAN §4 PR 7, O1c): the index is
    // a BYTE offset and must sit on a rune boundary (a mid-rune offset is a
    // compile error, where the runtime `substring` panics). The result stays
    // a 1-rune StrLit — the rune STARTING at that byte, mirroring the runtime
    // `at(i)` — because a comptime_str is text, not a byte buffer. Runtime
    // `s(i)` yields the u8 instead; that result-TYPE split predates D4 and is
    // deliberate (docs/en-US/STRINGS.md).
    if(!str_value.is_char_boundary(idx_usize), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            `String index ${idx_raw} is not on a UTF-8 character boundary`
          )
        )
      );
    });
    char_str := str_value.substring(
      idx_usize,
      str_value.ceil_char_boundary(idx_usize + usize(1))
    );
    return(EvalValue.StrLit(_str_quote(&char_str)));
  });
  // Range access
  if(!is_struct_val(arg_value), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          String.from("Expected comptime Range value for comptime string range index")
        )
      )
    );
  });
  indices_opt := _extract_range_indices(arg_value, is_inclusive);
  range_data := match(
    indices_opt,
    .Some(r) => r,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            String.from("Expected numeric start/end in Range for comptime string range index")
          )
        )
      );
      _IdxRange(start_idx : usize(0), end_idx : usize(0))
    }
  );
  start_idx := range_data.start_idx;
  end_idx := range_data.end_idx;
  str_len := str_value.len();
  if(start_idx > str_len, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          `String slice start index out of bounds: ${start_idx}. Expected index in range [0, ${str_len}].`
        )
      )
    );
  });
  if((end_idx < start_idx) || (end_idx > str_len), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          `String slice end index out of bounds: ${end_idx}. Expected index in range [${start_idx}, ${str_len}].`
        )
      )
    );
  });
  // COMPTIME BYTE BASIS (STD_API_AUDIT_D4_PLAN §4 PR 7, O1c): comptime
  // `s(a..b)` slices BYTES, matching the runtime `substring`. Out-of-range is
  // already a compile error above; a mid-rune endpoint is one too, where the
  // runtime `substring` panics.
  if(!str_value.is_char_boundary(start_idx), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          `String slice start index ${start_idx} is not on a UTF-8 character boundary`
        )
      )
    );
  });
  if(!str_value.is_char_boundary(end_idx), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          `String slice end index ${end_idx} is not on a UTF-8 character boundary`
        )
      )
    );
  });
  sliced := str_value.substring(start_idx, end_idx);
  EvalValue.StrLit(_str_quote(&sliced))
});
// ---------------------------------------------------------------------------
// _try_comptime_string_index
// ---------------------------------------------------------------------------
/// Implement comptime_str indexing.
_try_comptime_string_index :: (
  fn(
    arg_expr : &AstExpr,
    str_value : &String,
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> IndexCallResult
)({
  // expected_type cleared around the arg eval — see _try_comptime_array_index.
  csi_saved_expected := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  evaluated_gout := ArrayList(AstExpr).new();
  evaluated_gerr := evaluate_expression_guarded(arg_expr, env, ctx, &mut evaluated_gout);
  ctx.expected_type = csi_saved_expected;
  match(evaluated_gerr, .Some(evaluated_ge) => exn.throw(&evaluated_ge), .None => ());
  evaluated := match(evaluated_gout.get(usize(0)), .Some(evaluated_g) => evaluated_g, .None => make_err_expr());
  info_opt := expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&evaluated));
  info := match(
    info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_eval_failure(
            ast_expr_token(arg_expr),
            String.from("Failed to evaluate index argument for comptime string indexing")
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  arg_val := match(
    info.value,
    .Some(v) => v,
    .None => {
      exn.throw(
        dyn(
          format_eval_failure(
            ast_expr_token(arg_expr),
            String.from("Failed to evaluate index argument for comptime string indexing")
          )
        )
      );
      EvalValue.UnitVal
    }
  );
  caller_env := expr_info_adopt_env(&info);
  arg_type := info.ty;
  range_check := _check_range_type(&arg_type, env, ctx);
  result_val := _compute_comptime_string_index(
    str_value,
    &arg_val,
    arg_expr,
    range_check.is_range,
    range_check.is_inclusive,
    exn
  );
  result_ty := rc(TypeValueNode.ComptimeString);
  ptr_result_ty := t_ptr(&result_ty);
  IndexCallResult(
    value : Option(EvalValue).Some(result_val),
    ty : result_ty,
    ptr_type : ptr_result_ty,
    index_method_type : Option(TypeValue).None,
    index_method_value : Option(EvalValue).None,
    caller_env : caller_env,
    index : Option(usize).None,
    comptime_ref : Option(ComptimeRef).None
  )
});
// ---------------------------------------------------------------------------
// _specialize_index_method
// ---------------------------------------------------------------------------
/// Specialize the (generic-impl) index method for codegen and ride the
/// concrete FuncVal out via `out`. The compiler specializes impl methods LAZILY at
/// the call site: `find_methods_from_generic_impls` returns the UNSPECIALIZED
/// generic method (generic T, generic func_id whose registered type is
/// hard-generic), which `should_skip_function_codegen` then drops — so the index
/// call would reference an unemitted C function. A normal call `recv.m(i)` routes
/// through `try_to_call_function_with_arguments` → `create_specialized_function_inline`,
/// producing a concrete func_id with a registered concrete type that IS emitted.
/// Route the index method through that same path (args = [receiver, idx]) so its
/// specialized FuncVal reaches codegen.
///
/// `expected_type` is CLEARED around the call: the ambient expected type at the
/// index site is the auto-DEREFERENCED element type (e.g. `u8` for `(b : u8) =
/// al(i)`), but the index method itself returns `*(Output)` (`*(u8)`) — the deref
/// happens at the index-call layer, not inside the method. Leaving it set throws
/// "Cannot unify *(u8) and u8". The swallowing handler + `out`-param fallback
/// (the `_trial_eval_fn_body` idiom) keeps a throw for any other receiver type
/// from unwinding the caller's def-time body eval.
/// NOTE: a throw here unwinds straight to the CALLER of this fn (the swallow
/// handler's `unwind(())` exits `_specialize_index_method`), so `ctx.expected_type`
/// is saved/cleared/restored at the CALL SITE, not here — a restore line after
/// the call below would be skipped on the throw path and leak `None`.
_specialize_index_method :: (
  fn(mv : &Option(EvalValue), mty : &TypeValue, expr : &AstExpr, caller_env : &Environment, ctx : &EvalContext, idx_expr : &AstExpr, out : &mut ArrayList(EvalValue)) -> unit
)({
  // The swallowed throw unwinds out of the trial below, past the restores
  // of the function-body context the specialization installed, and a later
  // `return(...)` in the CALLER's body was then checked against the index
  // method's result type (issues/fixed/a-swallowed-index-specialization-leaks-its-function-context.md).
  saved_fb := ctx.is_evaluating_function_body_or_async_block;
  saved_caps := ctx.captured_variables;
  saved_loop := ctx.is_evaluating_loop_body;
  saved_fri := ctx.function_return_impl_concrete_type;
  saved_self := ctx.self_type;
  saved_enclosing := ctx.enclosing_function_return_type;
  saved_spec := ctx.currently_specializing_function;
  saved_spec_len := match(ctx.currently_specializing_function_stack, .Some(st) => st.len(), .None => usize(0));
  _specialize_index_method_trial(mv, mty, expr, caller_env, ctx, idx_expr, out);
  ctx.is_evaluating_function_body_or_async_block = saved_fb;
  ctx.captured_variables = saved_caps;
  ctx.is_evaluating_loop_body = saved_loop;
  ctx.function_return_impl_concrete_type = saved_fri;
  ctx.self_type = saved_self;
  ctx.enclosing_function_return_type = saved_enclosing;
  ctx.currently_specializing_function = saved_spec;
  match(
    ctx.currently_specializing_function_stack,
    .Some(st) => {
      while(st.len() > saved_spec_len, {
        st.pop();
      });
    },
    .None => ()
  );
});
_specialize_index_method_trial :: (
  fn(mv : &Option(EvalValue), mty : &TypeValue, expr : &AstExpr, caller_env : &Environment, ctx : &EvalContext, idx_expr : &AstExpr, out : &mut ArrayList(EvalValue)) -> unit
)({
  recv := match(expr, .FnCall(_, func, _, _, _) => func, .Atom(_, _) => expr);
  margs := ArrayList(AstExpr).new();
  margs.push(recv);
  margs.push(idx_expr);
  inner_exn := Exception(throw : (_err -> unwind(())));
  r := try_to_call_function_with_arguments(mv, mty, expr, &recv, &margs, caller_env, ctx, true, false, false, inner_exn);
  match(
    r.specialized_function_value,
    .Some(sv) => {
      out.push(sv);
    },
    .None => ()
  );
});
// ---------------------------------------------------------------------------
// _find_comptime_index_method
// ---------------------------------------------------------------------------
/// Find a ComptimeIndex `index` method for a type. Same signature shape as
/// `_find_index_method` — `(self : *(Self) | self : &mut Self, idx : ArgType)
/// -> *(Output)` — but BOTH parameters must carry the `comptime(...)` modifier.
///
/// `TypeValue.Func` / `FuncMeta` carry NO per-parameter comptime bit (only
/// `param_is_ref` /
/// `param_is_owning`) — the `comptime(name) : T` parameter modifier rides the
/// func-id-keyed side table `g_func_param_comptime`
/// (evaluator/types/function.yo:269-336): registered under the `fn(...)`
/// type-expression id by `evaluate_function_type`
/// (types/function.yo:3757) and re-keyed under the FuncVal id by
/// `try_to_implement_function_by_function_type`
/// (calls/function_type.yo:655). So the flags are read through the
/// candidate's METHOD VALUE (its FuncVal `func_id`). A candidate
/// with no FuncVal value has no registered flags and can never match; the
/// table is SPARSE (only registered when some parameter is comptime), so a
/// plain runtime `Index` impl reads back an empty list and is skipped.
_find_comptime_index_method :: (
  fn(
    concrete_type : &TypeValue,
    arg_type : &TypeValue,
    env : &Environment
  ) -> Option(_IndexMethodEntry)
)({
  methods := _find_all_index_methods(concrete_type, env);
  n := methods.len();
  (i : usize) = usize(0);
  (found : Option(_IndexMethodEntry)) = Option(_IndexMethodEntry).None;
  while((i < n) && found.is_none(), {
    match(
      methods.get(i),
      .Some(m) => {
        match(
          m.method_type,
          .Func({ param_types, result : ci_result, meta : __cifm1 }) => {
            ci_param_is_ref := __cifm1.*.param_is_ref;
            if(param_types.len() == usize(2), {
              match(
                param_types.get(usize(0)),
                .Some(p0) => {
                  match(
                    param_types.get(usize(1)),
                    .Some(p1) => {
                      p0_is_ptr := is_pointer_type(&p0);
                      p0_is_ref := match(
                        ci_param_is_ref.get(usize(0)),
                        .Some(b) => b,
                        .None => false
                      );
                      // `are_types_compatible(actual, expected)` — the ARGUMENT's type is the
                      // actual, the parameter's declared type is the expected. Passing
                      // them the other way round made the parameter type the "actual",
                      // so the comptime widening arms (types/compatibility.yo:124-146 for
                      // ComptimeInt, :171-190 for ComptimeString) — which all key off
                      // `actual` — never fired: `l(0)` on a `ComptimeIndex(usize)` impl was
                      // rejected with "Type does not implement Index for the given argument
                      // type" while `l(usize(0))` worked.
                      // Range vs RangeInclusive are BOTH `struct(start : T, end : T)` and
                      // both anonymous, so `are_types_compatible` accepts either for either
                      // and the FIRST registered impl won: `l(usize(1) ..= usize(3))` on a
                      // ComptimeList picked prelude's `ComptimeIndex(Range(usize))` (declared
                      // first) and sliced EXCLUSIVELY — 2 elements where 3 were asserted.
                      // Discriminate by the type CONSTRUCTOR (see `_check_range_type`):
                      // two structs built by DIFFERENT constructors are different types,
                      // while `Range(comptime_int)` and `Range(usize)` share one and stay
                      // compatible. Only fires when both sides carry a constructor id.
                      p1_compatible := (_ctor_ids_agree(arg_type, &p1) && are_types_compatible(arg_type, &p1));
                      ret_is_ptr := is_pointer_type(&ci_result);
                      if((p0_is_ptr || p0_is_ref) && p1_compatible && ret_is_ptr, {
                        // Comptime-parameter gate.
                        ci_flags := match(
                          m.method_value,
                          .Some(.FuncVal(__cifvd1, _)) => get_func_param_comptime(__cifvd1.*.func_id.clone()),
                          .Some(_) => ArrayList(bool).new(),
                          .None => ArrayList(bool).new()
                        );
                        self_is_ct := match(ci_flags.get(usize(0)), .Some(b) => b, .None => false);
                        idx_is_ct := match(ci_flags.get(usize(1)), .Some(b) => b, .None => false);
                        if(self_is_ct && idx_is_ct, {
                          found = Option(_IndexMethodEntry).Some(m);
                        });
                      });
                    },
                    .None => ()
                  );
                },
                .None => ()
              );
            });
          },
          _ => ()
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
// ---------------------------------------------------------------------------
// _try_comptime_custom_type_index
// ---------------------------------------------------------------------------
/// Try to dispatch `value(arg)` through ComptimeIndex for a CUSTOM type
/// (struct / enum / tuple / ComptimeList — anything that is neither a comptime
/// array nor a comptime string). When a comptime value like `p :: Point(3, 4)`
/// is indexed with `p(0)`, the ComptimeIndex `index` method is EXECUTED at
/// compile time. Returns `.None` to fall through to runtime dispatch.
///
/// Representation notes:
///   * `TypeValue.Func` carries no env, so the definition-time scope is
///     rebuilt from the FuncVal's flat capture snapshot
///     (`cap_names`/`cap_tys`/`cap_vals`) exactly as the ordinary FuncVal call
///     path does (calls/function.yo:3913-3933).
///   * `is_validating_function_definition` is cleared via
///     save / set-false / restore on the shared mutable `ctx` (the
///     idiom `evaluate_comptime_fn_call` itself uses for its own context
///     overrides, calls/comptime_fn.yo:762-816). It is LOAD-BEARING: without
///     it `evaluate_comptime_fn_call` computes `ctx.is_executing =
///     !is_validating_function_definition` = false and
///     `evaluate_comptime_assert` takes its non-executing branch
///     (builtins/comptime_assert.yo:59), so an out-of-bounds ComptimeIndex arm
///     never throws and `comptime_expect_error(p(usize(2)))` reports
///     "Expected compile error, but the expression was evaluated successfully".
///     A throw skips the restore, but every enclosing swallow already restores
///     it (`evaluate_comptime_expect_error` snapshots it explicitly,
///     builtins/comptime_expect_error.yo:107/135, and the def-time trial eval
///     runs on a COPIED EvalContext, calls/function_type.yo:724).
///   * A runtime argument is represented as `Some(UnknownVal(...))`, so the
///     unknown case is rejected explicitly — otherwise CTFE's own unknown-arg
///     gate (comptime_fn.yo:572-583) would hand back an `UnknownVal` and this
///     function would swallow the runtime dispatch path.
_try_comptime_custom_type_index :: (
  fn(
    expr : &AstExpr,
    arg_expr : &AstExpr,
    self_value : &EvalValue,
    value_type : &TypeValue,
    caller_env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> Option(IndexCallResult)
)({
  // Evaluate the argument; expected_type cleared
  // around the arg eval — see _try_comptime_array_index.
  cci_saved_expected := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  evaluated_arg := evaluate_expression(arg_expr, caller_env, ctx);
  ctx.expected_type = cci_saved_expected;
  arg_info := match(
    expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&evaluated_arg)),
    .Some(i) => i,
    .None => {
      return(Option(IndexCallResult).None);
    }
  );
  arg_value := match(
    arg_info.value,
    .Some(v) => v,
    .None => {
      return(Option(IndexCallResult).None);
    }
  );
  // Runtime argument — fall through (see the header note on UnknownVal).
  if(is_unknown_val(&arg_value), {
    return(Option(IndexCallResult).None);
  });
  ct_caller_env := expr_info_adopt_env(&arg_info);
  arg_type := arg_info.ty;
  // Find a ComptimeIndex method.
  ct_method := match(
    _find_comptime_index_method(value_type, &arg_type, &ct_caller_env),
    .Some(m) => m,
    .None => {
      return(Option(IndexCallResult).None);
    }
  );
  ct_fn_type := ct_method.method_type;
  // A non-FuncVal method value -> fall through.
  if(ct_method.method_value.is_none(), {
    return(Option(IndexCallResult).None);
  });
  ct_fn_value := match(ct_method.method_value, .Some(mv) => mv, .None => EvalValue.UnitVal);
  if(!is_func_val(&ct_fn_value), {
    return(Option(IndexCallResult).None);
  });
  // The return type must be `*(Output)`.
  ct_ret_type := match(ct_fn_type, .Func({ result : ct_r }) => ct_r, _ => t_unit());
  if(!is_pointer_type(&ct_ret_type), {
    return(Option(IndexCallResult).None);
  });
  output_ty := match(ct_ret_type, .Pointer(ct_pt) => ct_pt, _ => ct_ret_type);
  // Comptime pointer to self for the first argument.
  self_ptr_type := t_ptr(value_type);
  // Fresh 1-elem cell around self.
  self_ptr_cell := ArrayList(EvalValue).new();
  self_ptr_cell.push(self_value);
  self_ptr_value := EvalValue.PtrVal(self_ptr_cell, usize(0), .None);
  ct_p0_ty := match(
    ct_fn_type,
    .Func({ param_types : ct_pts0 }) => match(ct_pts0.get(usize(0)), .Some(t) => t, .None => t_unit()),
    _ => t_unit()
  );
  ct_p1_ty := match(
    ct_fn_type,
    .Func({ param_types : ct_pts1 }) => match(ct_pts1.get(usize(1)), .Some(t) => t, .None => t_unit()),
    _ => t_unit()
  );
  ct_p0_label := match(
    ct_fn_type,
    .Func({ meta : __cifm2 }) => match(__cifm2.*.param_labels.get(usize(0)), .Some(l) => l, .None => String.from("self")),
    _ => String.from("self")
  );
  ct_p1_label := match(
    ct_fn_type,
    .Func({ meta : __cifm3 }) => match(__cifm3.*.param_labels.get(usize(1)), .Some(l) => l, .None => String.from("idx")),
    _ => String.from("idx")
  );
  // Rebuild the method's definition-time scope from its capture snapshot, then
  // push a frame with `self` / `idx` bound.
  ct_cap_src := match(ct_fn_value, .FuncVal(__cifvd2, _) => fv_capture_source(&__cifvd2.*), _ => FvCaptureSource.Flat(ArrayList(String).new(), ArrayList(TypeValue).new()));
  ct_cap_vals := match(ct_fn_value, .FuncVal(__cifvd3, __cicv) => fv_capture_vals(&__cifvd3.*, &__cicv), _ => ArrayList(EvalValue).new());
  ct_module_path := ct_caller_env.module_path;
  ct_callee_env := Environment.new(&ct_module_path);
  (ct_ci : usize) = usize(0);
  while(ct_ci < ct_cap_vals.len(), {
    ct_cn := fv_source_name(&ct_cap_src, ct_ci);
    ct_cty := fv_source_ty(&ct_cap_src, ct_ci);
    ct_cv := match(ct_cap_vals.get(ct_ci), .Some(v) => Option(EvalValue).Some(v), .None => Option(EvalValue).None);
    ct_cv_is_ct := match(ct_cv, .Some(_) => true, .None => false);
    _ct_add_cap := add_variable_to_env(
      &ct_callee_env,
      ct_cn.clone(),
      &ct_cty,
      &ct_cv,
      ct_cv_is_ct,
      false,
      false,
      false,
      synthetic_token(&ct_cn, &ct_module_path)
    );
    ct_ci = (ct_ci + usize(1));
  });
  _ct_frame := ct_callee_env.push_frame(false);
  ct_param_token := ast_expr_token(
    match(expr, .FnCall(_, ct_func_slot, _, _, _) => ct_func_slot, .Atom(_, _) => expr)
  );
  _ct_add_self := add_variable_to_env(
    &ct_callee_env,
    ct_p0_label.clone(),
    &ct_p0_ty,
    Option(EvalValue).Some(self_ptr_value),
    true,
    false,
    false,
    false,
    &ct_param_token
  );
  _ct_add_idx := add_variable_to_env(
    &ct_callee_env,
    ct_p1_label.clone(),
    &ct_p1_ty,
    Option(EvalValue).Some(arg_value),
    true,
    false,
    false,
    false,
    &ct_param_token
  );
  ct_args := ArrayList(ArgEntry).new();
  ct_args.push(
    ArgEntry(
      value : Option(EvalValue).Some(self_ptr_value),
      parameter_type : ct_p0_ty,
      arg_type : self_ptr_type
    )
  );
  ct_args.push(
    ArgEntry(
      value : Option(EvalValue).Some(arg_value),
      parameter_type : ct_p1_ty,
      arg_type : arg_type
    )
  );
  ct_arg_values := ArgValues(
    forall_args : ArrayList(ArgEntry).new(),
    args : ct_args,
    implicit_args : Option(ArrayList(ArgEntry)).None,
    variadic_args : ArrayList(VarArgEntry).new()
  );
  // Execute the ComptimeIndex method. The
  // validation override is what makes the body actually run — see the header.
  ct_saved_validating := ctx.is_validating_function_definition;
  ctx.is_validating_function_definition = false;
  ct_result := evaluate_comptime_fn_call(
    Option(AstExpr).Some(match(expr, .FnCall(_, ct_func_slot2, _, _, _) => ct_func_slot2, .Atom(_, _) => expr)),
    &ct_fn_type,
    &ct_fn_value,
    &ct_arg_values,
    &ct_caller_env,
    &ct_callee_env,
    ctx,
    exn
  );
  ctx.is_validating_function_definition = ct_saved_validating;
  ct_return_value := ct_result.value;
  // Also record the RUNTIME index method for codegen.
  ct_rt_method := _find_index_method(value_type, &arg_type, &ct_caller_env);
  ct_rt_method_type := match(ct_rt_method, .Some(rm) => Option(TypeValue).Some(rm.method_type), .None => Option(TypeValue).None);
  ct_rt_method_value := match(ct_rt_method, .Some(rm) => rm.method_value, .None => Option(EvalValue).None);
  // A PtrVal return derefs to the pointed-at element/field and yields the
  // ComptimeRef that makes `p(0) = v` and `&(p(0))` comptime places.
  //
  // NOTE: `&(self.x)` builds `PtrVal(ArrayVal(field_values), i)` —
  // it wraps the struct's field list in an `ArrayVal` "to enable indexed
  // access" (builtins/ptr_fns.yo:151) — so the ArrayVal arm below is the one
  // that fires for a struct receiver, and `ComptimeRef.ArrayRef` over the
  // SHARED `field_values` handle mutates the struct in place exactly as
  // `StructRef` would (exprs/assignment.yo:672-678). The StructVal / TupleVal
  // arms cover the paths that hand back an unwrapped target.
  match(
    ct_return_value,
    .PtrVal(ct_target_cell, ct_index, _) => {
      ct_target := match(ct_target_cell.get(usize(0)), .Some(t0) => t0, .None => EvalValue.UnitVal);
      (ct_deref : EvalValue) = ct_target;
      (ct_cref : Option(ComptimeRef)) = Option(ComptimeRef).None;
      match(
        ct_target,
        .ArrayVal(ct_elements) => {
          ct_deref = match(ct_elements.get(ct_index), .Some(e) => e, .None => ct_target);
          ct_cref = Option(ComptimeRef).Some(ComptimeRef.ArrayRef(ct_elements, ct_index));
        },
        .StructVal(_, _, ct_fields_s) => {
          ct_deref = match(ct_fields_s.get(ct_index), .Some(e) => e, .None => ct_target);
          ct_cref = Option(ComptimeRef).Some(ComptimeRef.StructRef(ct_fields_s, ct_index));
        },
        .TupleVal(ct_fields_t) => {
          ct_deref = match(ct_fields_t.get(ct_index), .Some(e) => e, .None => ct_target);
          ct_cref = Option(ComptimeRef).Some(ComptimeRef.TupleRef(ct_fields_t, ct_index));
        },
        _ => ()
      );
      return(
        Option(IndexCallResult).Some(
          IndexCallResult(
            value : Option(EvalValue).Some(ct_deref),
            ty : output_ty,
            ptr_type : ct_ret_type,
            index_method_type : ct_rt_method_type,
            index_method_value : ct_rt_method_value,
            caller_env : ct_caller_env,
            index : Option(usize).None,
            comptime_ref : ct_cref
          )
        )
      );
    },
    _ => ()
  );
  // Not a PtrVal (e.g. an UnknownVal from a skipped CTFE, or a builtin like
  // `__yo_comptime_list_index` that returns the element directly)
  // — propagate `result.comptime_ref` from the
  // comptime function call so `l(0) = v` treats the result as a comptime place.
  Option(IndexCallResult).Some(
    IndexCallResult(
      value : Option(EvalValue).Some(ct_return_value),
      ty : output_ty,
      ptr_type : ct_ret_type,
      index_method_type : ct_rt_method_type,
      index_method_value : ct_rt_method_value,
      caller_env : ct_caller_env,
      index : Option(usize).None,
      comptime_ref : ct_result.comptime_ref
    )
  )
});
// ---------------------------------------------------------------------------
// try_to_call_with_index_trait
// ---------------------------------------------------------------------------
/// Dispatch `value(arg)` via the Index trait.
///
/// Desugars: `value(arg)` → `Index(typeof(arg)).index(&(value), arg).*`
///
///
try_to_call_with_index_trait :: (
  fn(
    expr : &AstExpr,
    value_type : &TypeValue,
    self_value : &Option(EvalValue),
    arg_exprs : &ArrayList(AstExpr),
    caller_env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> IndexCallResult
)({
  // 1. Exactly 1 argument required
  if(arg_exprs.len() != usize(1), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Index trait expects exactly 1 argument, got ${arg_exprs.len()}.`
        )
      )
    );
  });
  arg_expr := match(
    arg_exprs.get(usize(0)),
    .Some(e) => e,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("Index trait: missing argument")
          )
        )
      );
      make_err_expr()
    }
  );
  // 2. Extract comptime values from self
  array_val := match(
    self_value,
    .Some(v) => if(
      is_array_val(&v),
      Option(EvalValue).Some(v),
      Option(EvalValue).None
    ),
    .None => Option(EvalValue).None
  );
  string_raw_opt := match(
    self_value,
    .Some(.StrLit(r)) => Option(String).Some(r),
    .Some(_) => Option(String).None,
    .None => Option(String).None
  );
  has_array_or_slice := array_val.is_some();
  is_arr_or_slice_ty := is_array_type(value_type);
  // 3. Comptime array/slice path
  if(has_array_or_slice && is_arr_or_slice_ty, {
    ct_result := _try_comptime_array_index(
      &arg_expr,
      &array_val,
      value_type,
      caller_env,
      ctx,
      exn
    );
    match(
      ct_result,
      .Some(r) => {
        return(r);
      },
      .None => ()
    );
  });
  // 4. Comptime string path
  match(
    string_raw_opt,
    .Some(raw) => {
      rn := raw.len();
      str_unquoted := if(
        rn >= usize(2),
        str_lit_unquote_bytes(&raw),
        String.new()
      );
      result := _try_comptime_string_index(&arg_expr, &str_unquoted, caller_env, ctx, exn);
      return(result);
    },
    .None => ()
  );
  // 5. Comptime values of CUSTOM types (structs, enums, tuples, ComptimeList):
  //    try ComptimeIndex dispatch. Handles types like `Point` that implement
  //    `ComptimeIndex(usize)`.
  match(
    self_value,
    .Some(sv_ct) => if(!is_unknown_val(&sv_ct) && array_val.is_none() && string_raw_opt.is_none(), {
      match(
        _try_comptime_custom_type_index(
          expr,
          &arg_expr,
          &sv_ct,
          value_type,
          caller_env,
          ctx,
          exn
        ),
        .Some(ct_r) => {
          return(ct_r);
        },
        .None => ()
      );
    }),
    .None => ()
  );
  // 6. Runtime path: evaluate arg to get its type. `expected_type` is CLEARED
  // around the arg eval — the ambient expected type at the index site is the
  // ELEMENT type (e.g. `u8` for `(b : u8) = al(i - usize(1))`), and leaking it
  // into the ARGUMENT's operator call made the `-` overload synthesis throw
  // "Cannot unify incompatible types: usize and u8" (swallowed by the no-exn
  // wrapper — the std/string/string.yo `trim` noise-baseline line).
  rt_arg_saved_expected := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  evaluated_arg_gout := ArrayList(AstExpr).new();
  evaluated_arg_gerr := evaluate_expression_guarded(&arg_expr, caller_env, ctx, &mut evaluated_arg_gout);
  ctx.expected_type = rt_arg_saved_expected;
  match(evaluated_arg_gerr, .Some(evaluated_arg_ge) => exn.throw(&evaluated_arg_ge), .None => ());
  evaluated_arg := match(evaluated_arg_gout.get(usize(0)), .Some(evaluated_arg_g) => evaluated_arg_g, .None => make_err_expr());
  arg_info_opt := expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&evaluated_arg));
  arg_info := match(
    arg_info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_eval_failure(
            ast_expr_token(&arg_expr),
            String.from("Failed to evaluate index argument")
          )
        )
      );
      new_expr_info(caller_env, t_unit())
    }
  );
  updated_env := expr_info_adopt_env(&arg_info);
  // For array/slice: derive element type directly from TypeValue (no method lookup needed)
  if(is_arr_or_slice_ty, {
    elem_ty := match(
      value_type,
      .Array(et, _, _) => et,
      _ => t_unit()
    );
    result_val := create_unknown_val(&elem_ty);
    return(
      IndexCallResult(
        value : Option(EvalValue).Some(result_val),
        ty : elem_ty,
        ptr_type : t_ptr(&elem_ty),
        index_method_type : Option(TypeValue).None,
        index_method_value : Option(EvalValue).None,
        caller_env : updated_env,
        index : Option(usize).None,
        comptime_ref : Option(ComptimeRef).None
      )
    );
  });
  // For custom types: find the index method via trait lookup
  arg_type := arg_info.ty;
  method_opt := _find_index_method(value_type, &arg_type, caller_env);
  method := match(
    method_opt,
    .Some(m) => m,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("Type does not implement Index for the given argument type.")
          )
        )
      );
      _IndexMethodEntry(
        method_type : t_unit(),
        method_value : Option(EvalValue).None
      )
    }
  );
  // The element type: a projection's result, or the pointee of the pre-V2b
  // `*(Output)` (`_index_shape_of`).
  output_ty := match(_index_shape_of(&method.method_type, &arg_type), .Some(sh) => sh.output, .None => t_unit());
  // The `idx` argument follows the same ownership rule as a normal call's
  // argument (`consume_argument_for_parameter`). The Index trait takes its
  // index BY VALUE (decision 34 as amended 2026-10-11), and the specialized
  // method's C drops a by-value parameter on every exit path — without the
  // caller-side share the dispatch call site emitted by
  // `_generate_index_trait_call` (which passes the argument's plain rvalue,
  // with no normal-call arg marshaling) under-counts an RC-typed index by one
  // and frees it while the caller still reads it. `Copy` index types no-op
  // inside the rule (`arg_is_bitwise_copy`), and a still-borrowed impl
  // (`idx : &K`, a generic impl the conformance check cannot reach) reads its
  // mode flags here and is skipped, exactly as a normal call would.
  match(
    method.method_type,
    .Func({ meta : __ibv_fm }) => {
      __ibv_ref := match(__ibv_fm.*.param_is_ref.get(usize(1)), .Some(b) => b, .None => false);
      __ibv_own := match(__ibv_fm.*.param_is_owning.get(usize(1)), .Some(b) => b, .None => false);
      if(!__ibv_ref, {
        _ibv_drop := consume_argument_for_parameter(
          &evaluated_arg,
          &arg_expr,
          &arg_info,
          __ibv_own,
          false,
          false,
          false,
          &updated_env,
          ctx,
          exn
        );
      });
    },
    _ => ()
  );
  // Runtime dispatch through a trait method — the result is runtime-only,
  // so overload resolution doesn't prefer comptime functions.
  result_val := create_runtime_unknown_val(&output_ty);
  // Specialize the index method so codegen has an emittable concrete FuncVal (see
  // _specialize_index_method). On any failure, fall back to the generic value
  // (no worse than before — the codegen branch then references an unemitted fn).
  // expected_type is cleared around the call (the method returns *(Output), the
  // ambient expected type is the dereferenced Output) and restored here so a
  // swallowed throw inside the helper cannot leak `None` into later evaluation.
  spec_out := ArrayList(EvalValue).new();
  saved_idx_exp := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  match(
    method.method_value,
    .Some(_) => _specialize_index_method(&method.method_value, &method.method_type, expr, caller_env, ctx, &arg_expr, &mut spec_out),
    .None => ()
  );
  _record_index_unchecked_twin(value_type, &arg_type, &output_ty, expr, caller_env, ctx, &arg_expr);
  ctx.expected_type = saved_idx_exp;
  spec_method_value := match(spec_out.get(usize(0)), .Some(sv) => Option(EvalValue).Some(sv), .None => method.method_value);
  IndexCallResult(
    value : Option(EvalValue).Some(result_val),
    ty : output_ty,
    ptr_type : t_ptr(&output_ty),
    index_method_type : Option(TypeValue).Some(method.method_type),
    index_method_value : spec_method_value,
    caller_env : updated_env,
    index : Option(usize).None,
    comptime_ref : Option(ComptimeRef).None
  )
});
// ---------------------------------------------------------------------------
// _record_index_unchecked_twin
// ---------------------------------------------------------------------------
/// 5b container bounds elision
/// (plans/backlog/SAFE_MODE_5B_CONTAINER_BOUNDS_ELISION.md). In a verify-mode
/// target file, specialize the receiver's `IndexUnchecked` `index_unchecked`
/// for this subscript and record it, so codegen can call it in place of
/// `index` once the verifier proves the site in bounds. Only the method that
/// the `IndexUnchecked` trait itself supplies qualifies, matched by trait id
/// and never by method name alone: an unrelated `index_unchecked` would turn
/// a proof into undefined behavior. Its result must point at the same
/// `Output` as `index`'s. Runtime-mode files record nothing, so their C is
/// unchanged.
_record_index_unchecked_twin :: (
  fn(
    value_type : &TypeValue,
    arg_type : &TypeValue,
    output_ty : &TypeValue,
    expr : &AstExpr,
    caller_env : &Environment,
    ctx : &EvalContext,
    idx_expr : &AstExpr,
    /// The twin's trait and method: `IndexUnchecked.index_unchecked` for a
    /// read, `IndexUncheckedMut.index_unchecked_mut` for a write through
    /// `IndexMut` (the V2b split).
    (trait_name : str) ?= "IndexUnchecked",
    (method_name : str) ?= "index_unchecked"
  ) -> unit
)({
  tok := ast_expr_token(expr);
  if(!_is_verify_target(tok.module_path.clone()), {
    return(());
  });
  vmode := resolve_verify_mode(tok.module_path.clone());
  if(!((vmode == "verify") || (vmode == "verify+")), {
    return(());
  });
  if(!are_types_compatible(arg_type, t_usize()), {
    return(());
  });
  trait_id := match(
    get_trait_type_from_env(caller_env, String.from(trait_name)),
    .Some(.TraitT(id : tid)) => tid,
    _ => String.new()
  );
  if(trait_id == "", {
    return(());
  });
  cands := get_receiver_methods_by_name_from_env(caller_env, String.from(method_name), value_type, false);
  (picked : Option(_IndexMethodEntry)) = Option(_IndexMethodEntry).None;
  (ci : usize) = usize(0);
  while((ci < cands.len()) && picked.is_none(), {
    c := cands(ci);
    if((c.source_trait_id == trait_id) && c.value.is_some(), {
      // Its element is the subscript's: the pointee of a pre-V2b
      // `*(Output)`, or a projection's result.
      same_output := match(
        c.ty,
        .Func({ result : twin_ret, meta : twin_m }) => {
          twin_out := if(twin_m.*.result_is_ref, twin_ret, match(twin_ret, .Pointer(tp) => tp, _ => t_unit()));
          (twin_m.*.result_is_ref || is_pointer_type(&twin_ret)) && are_types_compatible(&twin_out, output_ty) && are_types_compatible(output_ty, &twin_out)
        },
        _ => false
      );
      if(same_output, {
        picked = Option(_IndexMethodEntry).Some(_IndexMethodEntry(method_type : c.ty, method_value : c.value));
      });
    });
    ci = (ci + usize(1));
  });
  match(
    picked,
    .Some(tw) => {
      twin_out := ArrayList(EvalValue).new();
      _specialize_index_method(&tw.method_value, &tw.method_type, expr, caller_env, ctx, idx_expr, &mut twin_out);
      match(
        twin_out.get(usize(0)),
        .Some(sv) => record_index_unchecked_twin(ast_expr_id(expr), &sv),
        .None => ()
      );
    },
    .None => ()
  );
});
// ---------------------------------------------------------------------------
// promote_index_places_for_write
// ---------------------------------------------------------------------------
/// The binding whose storage the receiver place `recv` names: field steps and
/// element accesses down to a variable. `.None` when a step leaves the
/// receiver's own storage (a raw-pointer deref, a reference-typed base, a
/// call result): then the root's mode says nothing about the receiver.
_index_receiver_root :: (fn(recv : &AstExpr, env : &Environment, ctx : &EvalContext) -> Option(Variable))({
  (cur : AstExpr) = recv;
  while(true, {
    match(
      cur,
      .Atom(_, rr_tok) => {
        return(get_variables_from_env(env, rr_tok.value.clone()).last());
      },
      .FnCall(_, rr_callee, rr_args, rr_infix, _) => {
        cur = cond(
          ast_expr_is_fn_call_of(&cur, BF_DOT, Option(usize).Some(usize(2))) => {
            base := match(rr_args.get(usize(0)), .Some(b) => b, .None => make_err_expr());
            field_is_deref := match(rr_args.get(usize(1)), .Some(f) => ast_expr_is_atom_of(&f, "*"), .None => false);
            base_is_ref := match(expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&base)), .Some(bi) => (is_pointer_type(&bi.ty) || is_reference_struct_type(&bi.ty)), .None => true);
            if(field_is_deref || base_is_ref, {
              return(Option(Variable).None);
            });
            base
          },
          (!rr_infix && _is_index_call(&cur, ctx)) => rr_callee,
          true => {
            return(Option(Variable).None);
          }
        );
      }
    );
  });
  Option(Variable).None
});
/// `e` is an element access dispatched through an `Index` method.
_is_index_call :: (fn(e : &AstExpr, ctx : &EvalContext) -> bool)(
  match(
    expr_info_table_get(&ctx.expr_info_table, ast_expr_id(e)),
    .Some(ei) => (expr_info_index_trait_ptr_type(&ei).is_some() && expr_info_index_method_type(&ei).is_some()),
    .None => false
  )
);
/// Re-dispatch one element access `call` (already dispatched as a read) to
/// its receiver's `index_mut`, when the read went through a projection
/// `index`. See `promote_index_places_for_write`.
_promote_index_call :: (fn(call : &AstExpr, env : &Environment, ctx : &EvalContext, exn : Exception) -> unit)({
  info := match(expr_info_table_get(&ctx.expr_info_table, ast_expr_id(call)), .Some(i) => i, .None => return(()));
  read_ty := match(expr_info_index_method_type(&info), .Some(t) => t, .None => return(()));
  (recv : AstExpr) = match(call, .FnCall(_, pc_callee, _, _, _) => pc_callee, .Atom(_, _) => return(()));
  (idx : AstExpr) = match(call, .FnCall(_, _, pc_args, _, _) => match(pc_args.get(usize(0)), .Some(a) => a, .None => return(())), .Atom(_, _) => return(()));
  recv_ty := match(expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&recv)), .Some(ri) => ri.ty, .None => return(()));
  arg_ty := match(expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&idx)), .Some(ai) => ai.ty, .None => return(()));
  read_shape := match(_index_shape_of(&read_ty, &arg_ty), .Some(sh) => sh, .None => return(()));
  // The pre-V2b method serves writes itself; an `index_mut` is already one.
  if(!read_shape.is_projection || read_shape.is_mut, {
    return(());
  });
  place_text := ast_expr_to_string(call);
  tok := ast_expr_token(call);
  mut_m := match(
    _find_index_mut_method(&recv_ty, &arg_ty, env),
    .Some(m) => m,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            &tok,
            `Cannot write \`${place_text}\`: \`${type_to_string(&recv_ty)}\` implements \`Index\`, whose \`index\` is a read projection (\`-> &Self.Output\`), but not \`IndexMut\`, whose \`index_mut\` (\`self : &mut Self -> &mut Self.Output\`) every write through \`x(i)\` dispatches (decision 34). Implement \`IndexMut(${type_to_string(&arg_ty)})\` to make the element writable.`
          )
        )
      );
      return(());
    }
  );
  mut_shape := match(_index_shape_of(&mut_m.method_type, &arg_ty), .Some(sh) => sh, .None => return(()));
  if(!(are_types_compatible(&mut_shape.output, &read_shape.output) && are_types_compatible(&read_shape.output, &mut_shape.output)), {
    exn.throw(
      dyn(
        format_error_message(
          &tok,
          `Cannot write \`${place_text}\`: \`index_mut\` yields \`${type_to_string(&mut_shape.output)}\` and \`index\` yields \`${type_to_string(&read_shape.output)}\`; \`IndexMut\` and \`Index\` share one \`Output\`.`
        )
      )
    );
  });
  // `index_mut` takes `self : &mut Self`: the receiver must be a place the
  // caller may write, never a read-only borrow.
  match(
    _index_receiver_root(&recv, env, ctx),
    .Some(rv) => if(variable_is_imm_borrow(&rv), {
      exn.throw(
        dyn(
          with_code(
            format_error_message(
              &tok,
              `Cannot write \`${place_text}\`: \`IndexMut.index_mut\` takes \`self : &mut Self\`, and \`${rv.name}\` is a read-only borrow. Declare it \`${rv.name} : &mut T\` (or borrow it with \`&mut\`) to write its elements.`
            ),
            E_WRITE_THROUGH_BORROW
          )
        )
      );
    }),
    .None => ()
  );
  spec_out := ArrayList(EvalValue).new();
  saved_exp := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  match(
    mut_m.method_value,
    .Some(_) => _specialize_index_method(&mut_m.method_value, &mut_m.method_type, call, env, ctx, &idx, &mut spec_out),
    .None => ()
  );
  // The write's bounds-check-free twin is `IndexUncheckedMut`'s; the read
  // twin recorded at dispatch must not serve the write.
  forget_index_unchecked_twin(ast_expr_id(call));
  _record_index_unchecked_twin(&recv_ty, &arg_ty, &read_shape.output, call, env, ctx, &idx, "IndexUncheckedMut", "index_unchecked_mut");
  ctx.expected_type = saved_exp;
  new_value := match(spec_out.get(usize(0)), .Some(sv) => Option(EvalValue).Some(sv), .None => mut_m.method_value);
  expr_info_set_index_method_type(&info, Option(TypeValue).Some(mut_m.method_type));
  expr_info_set_index_method_value(&info, &new_value);
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(call), &info);
});
/// Decision 34's split at a write (V2b): every element access along the
/// place `place` is written through — the target of `xs(i) = v`, of
/// `xs(i).f = v`, of `grid(i)(j) = v`, a `&mut` argument or receiver
/// (`xs(i).push(v)`), `addr_of(xs(i))`, a `&mut` projection's result. An
/// access dispatched to a read projection (`index`, `self : &Self ->
/// &Self.Output`) is re-dispatched to its receiver's `index_mut` (`self :
/// &mut Self -> &mut Self.Output`), whose receiver must then be writable;
/// a type with no `index_mut` has read-only elements. The pre-V2b method
/// (`self : &mut Self -> *Self.Output`) serves reads and writes alike and
/// stays as dispatched.
promote_index_places_for_write :: (fn(place : &AstExpr, env : &Environment, ctx : &EvalContext, exn : Exception) -> unit)({
  (cur : AstExpr) = place;
  (walking : bool) = true;
  while(walking, {
    (next : Option(AstExpr)) = match(
      cur,
      .FnCall(_, pw_callee, pw_args, pw_infix, _) => cond(
        ast_expr_is_fn_call_of(&cur, BF_DOT, Option(usize).Some(usize(2))) => match(
          pw_args.get(usize(1)),
          .Some(f) => if(ast_expr_is_atom_of(&f, "*"), Option(AstExpr).None, pw_args.get(usize(0))),
          .None => Option(AstExpr).None
        ),
        (!pw_infix && _is_index_call(&cur, ctx)) => {
          _promote_index_call(&cur, env, ctx, exn);
          Option(AstExpr).Some(pw_callee)
        },
        true => Option(AstExpr).None
      ),
      .Atom(_, _) => Option(AstExpr).None
    );
    match(
      next,
      .Some(n) => {
        cur = n;
      },
      .None => {
        walking = false;
      }
    );
  });
});
// ---------------------------------------------------------------------------
// has_index_impl
// ---------------------------------------------------------------------------
/// Check if a type has any matching Index impl for a given set of argument expressions.
///
/// Array/Slice fast path; custom types resolve `index` methods through the
/// trait-field scan + trait-methods registry (generic-impl fallback included).
///
///
has_index_impl :: (
  fn(
    concrete_type : &TypeValue,
    arg_exprs : &ArrayList(AstExpr),
    caller_env : &Environment,
    ctx : &EvalContext
  ) -> bool
)({
  ctx;
  if(arg_exprs.len() != usize(1), {
    return(false);
  });
  // Fast path: Array always has an Index impl
  if(is_array_type(concrete_type), {
    return(true);
  });
  // Trait-field + registry/generic-impl method lookup.
  methods := _find_all_index_methods(concrete_type, caller_env);
  methods.len() > usize(0)
});
/// Install `promote_index_places_for_write` behind context.yo's hook.
register_promote_index_places :: (fn() -> unit)({
  set_promote_index_places_fn(promote_index_places_for_write);
  ()
});
export(try_to_call_with_index_trait, promote_index_places_for_write, register_promote_index_places);
export(has_index_impl);
