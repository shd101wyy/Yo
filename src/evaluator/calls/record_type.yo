//! evaluator/calls/record_type — try_to_implement_module_with_arguments_by_module_type.
//!
//! TS counterpart: `src/evaluator/calls/record-type.ts`.
//!
//! Naming note: TS renamed `module-type.ts` → `record-type.ts` in the
//! "Unify module and struct" PR (ca129d0e, 2026-05-08), which also replaced
//! the exported `tryToImplementModuleWithArgumentsByModuleType` with
//! `tryToImplementRecordWithArgumentsByRecordType` and merged `ModuleType`
//! into `StructType` (the post-refactor `SourceNamespaceType` is a
//! `StructType` with `isSourceNamespace = true`).
//!
//! This file keeps the pre-refactor symbol names (`ModuleT`, `module_type`,
//! `try_to_implement_module_with_arguments_by_module_type`) — the
//! symbol-level rename and the type-system unification are tracked as a
//! follow-up content port. Structural file/directory layout matches the
//! current TS tree.
//!
//! Original behavior:
//! - Binds argument values to the fields of a ModuleType, producing a module value.
//! - `ModuleT.field_types` are already evaluated; no `exprs.typeExpr` re-evaluation needed.
//! - `ModuleT` has no `assignedValue`/`defaultValue` per field → error if field missing.
//! - `isFunctionValue` / `specializedType` / `ioBuiltin` propagation omitted (codegen deferred).
//! - Return type is `ModuleTypeCallResult` (not `Option(AstExpr)` as in stub).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_atom,
  ast_expr_is_fn_call_of
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ type_to_string } :: import("../../types/string.yo");
{ are_types_compatible } :: import("../../types/compatibility.yo");
{
  EvalContext,
  ModuleTypeCallResult,
  ExpectedTypeCtx
} :: import("../context.yo");
{ EvalValue, value_to_string } :: import("../../value.yo");
{ set_expr_as_needs_to_call_dup } :: import("../utils.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
/// Bind `arg_exprs` to the fields of `module_type`, returning a ModuleTypeCallResult.
///
/// 1:1 port of `tryToImplementModuleWithArgumentsByModuleType` from
/// `src/evaluator/calls/module-type.ts`.
///
/// Requires every module field to be provided (no default/assigned value support yet).
try_to_implement_module_with_arguments_by_module_type :: (
  fn(
    module_expr : AstExpr,
    module_type : TypeValue,
    arg_exprs : ArrayList(AstExpr),
    caller_env_in : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> ModuleTypeCallResult
)({
  // Extract field labels and types from the source-namespace Struct
  // (TS: SourceNamespaceType, record-type.ts:37).
  field_labels := match(
    module_type,
    .Struct({ field_labels : labels }) => labels,
    _ => ArrayList(String).new()
  );
  field_types := match(
    module_type,
    .Struct({ field_types : types }) => types,
    _ => ArrayList(TypeValue).new()
  );
  sns_ty_id := match(
    module_type,
    .Struct({ id : sid }) => sid,
    _ => String.from("")
  );
  n_fields := field_labels.len();
  n_args := arg_exprs.len();
  if(n_args > n_fields, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(module_expr),
          String.from("Failed to implement the module. Too many fields provided."),
          false,
          .None
        )
      )
    );
  });
  // Pre-allocate values and result name/value lists.
  (values : ArrayList(Option(EvalValue))) = ArrayList(Option(EvalValue)).new();
  (i_init : usize) = usize(0);
  while(i_init < n_fields, {
    values.push(Option(EvalValue).None);
    i_init = (i_init + usize(1));
  });
  (caller_env : Environment) = caller_env_in;
  // For each module field, find the matching arg by label.
  (i : usize) = usize(0);
  while(i < n_fields, {
    field_label_opt := field_labels.get(i);
    field_type_opt := field_types.get(i);
    field_label := match(field_label_opt, .Some(s) => s, .None => String.from(""));
    field_type := match(field_type_opt, .Some(t) => t, .None => TypeValue.Unit);
    (found_arg : bool) = false;
    (j : usize) = usize(0);
    while(j < n_args, {
      arg_expr_opt := arg_exprs.get(j);
      arg_expr := match(arg_expr_opt, .Some(a) => a, .None => module_expr);
      // Each arg must be a `label: value` colon call.
      if(!(ast_expr_is_fn_call_of(arg_expr, ":", .Some(usize(2)))), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg_expr),
              `Expected member label, but got:\n${ast_expr_to_string(arg_expr)}`,
              false,
              .None
            )
          )
        );
      });
      // Extract label_sub and value_sub from the `:` call.
      label_sub_opt := match(arg_expr, .FnCall(_, _, args, _, _) => args.get(usize(0)), _ => Option(AstExpr).None);
      value_sub_opt := match(arg_expr, .FnCall(_, _, args, _, _) => args.get(usize(1)), _ => Option(AstExpr).None);
      label_sub := match(
        label_sub_opt,
        .Some(s) => s,
        .None => {
          exn.throw(dyn(format_error_message(ast_expr_token(arg_expr), String.from("Label arg missing label sub-expr."), false, .None)));
          arg_expr
        }
      );
      value_sub := match(
        value_sub_opt,
        .Some(s) => s,
        .None => {
          exn.throw(dyn(format_error_message(ast_expr_token(arg_expr), String.from("Label arg missing value sub-expr."), false, .None)));
          arg_expr
        }
      );
      if(!(ast_expr_is_atom(label_sub)), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(label_sub),
              `Expected identifier for label, got:\n${ast_expr_to_string(label_sub)}`,
              false,
              .None
            )
          )
        );
      });
      // Parse the label token value.
      label_tok := match(label_sub, .Atom(_, tok) => tok.value.clone(), _ => String.from(""));
      // Validate the label exists in the module type.
      (label_exists_in_type : bool) = false;
      (li : usize) = usize(0);
      while(li < n_fields, {
        match(
          field_labels.get(li),
          .Some(fl) => {
            if(fl == label_tok, {
              label_exists_in_type = true;
            });
          },
          .None => ()
        );
        li = (li + usize(1));
      });
      if(!(label_exists_in_type), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(label_sub),
              `Module member with label "${label_tok}" does not exist in the module type.`,
              false,
              .None
            )
          )
        );
      });
      // Check if this arg matches the current field.
      if(field_label == label_tok, {
        found_arg = true;
        // Evaluate the value sub-expression with expected type = field_type.
        saved_expected := ctx.expected_type;
        ctx.expected_type = .Some(ExpectedTypeCtx(ty : field_type, env : caller_env));
        evaluated_arg := evaluate_expression(value_sub, caller_env, ctx);
        ctx.expected_type = saved_expected;
        arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_arg));
        if(arg_info_opt.is_none(), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(value_sub),
                `Failed to evaluate module member "${field_label}".`,
                false,
                .None
              )
            )
          );
        });
        arg_info := match(arg_info_opt, .Some(it) => it, .None => new_expr_info(caller_env, field_type));
        set_expr_as_needs_to_call_dup(evaluated_arg, ctx, exn);
        caller_env = arg_info.env;
        arg_type := arg_info.ty;
        if(!(are_types_compatible(arg_type, field_type)), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(value_sub),
                `Type mismatch for the module member "${field_label}":\nExpected: ${type_to_string(field_type)}\nGot:   ${type_to_string(arg_type)}`,
                false,
                .None
              )
            )
          );
        });
        // Store the evaluated value at position i.
        values(i) = arg_info.value;
        // Annotate the label sub-expr with the same ExprInfo as the value.
        label_info := new_expr_info(caller_env, arg_type);
        label_info.value = arg_info.value;
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(label_sub), label_info);
      });
      j = (j + usize(1));
    }); // end inner loop over argExprs
    if(!(found_arg), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(module_expr),
            `Module member "${field_label}" is not provided and has no required/default value.`,
            false,
            .None
          )
        )
      );
    });
    i = (i + usize(1));
  }); // end outer loop over fields
  // Build ModuleVal from field labels and values.
  (result_names : ArrayList(String)) = ArrayList(String).new();
  (result_values : ArrayList(EvalValue)) = ArrayList(EvalValue).new();
  (k : usize) = usize(0);
  while(k < n_fields, {
    match(
      field_labels.get(k),
      .Some(lbl) => {
        result_names.push(lbl.clone());
      },
      .None => ()
    );
    val_opt := match(values.get(k), .Some(v) => v, .None => Option(EvalValue).None);
    match(
      val_opt,
      .Some(v) => {
        result_values.push(v);
      },
      .None => {
        result_values.push(EvalValue.UnitVal);
      }
    );
    k = (k + usize(1));
  });
  module_val := EvalValue.StructVal(sns_ty_id.clone(), result_names, result_values);
  ModuleTypeCallResult(module_value : module_val, caller_env : caller_env)
});
export(try_to_implement_module_with_arguments_by_module_type);
