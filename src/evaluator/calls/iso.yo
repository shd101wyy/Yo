//! evaluator/calls/iso — evaluate_iso_type_call and evaluate_iso_value_call.
//!
//! `evaluate_iso_type_call`  — evaluates `Iso(Box(T))` to produce the Iso type value.
//! `evaluate_iso_value_call` — evaluates `Iso(Box(T))(x)` to wrap a value in an Iso.
//!
//! Note: `addRcFunctionsToIsoType` is not yet implemented (same status as
//! `addRcFunctionsToDynType` in dyn.yo — deferred, returns env unchanged).
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token, ast_expr_id } :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set
} :: import("../../expr_info.yo");
{ Variable, Environment, get_variables_from_env, copy_frames } :: import("../../env.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_iso, t_type } :: import("../../types/creators.yo");
{ is_iso_type, is_atomic_reference_struct_type, is_atomic_reference_enum_type, is_reference_struct_type, is_reference_enum_type, is_function_type, is_some_type } :: import("../../types/guards.yo");
{ resolve_struct_shell, resolve_enum_shell } :: import("../../types/creators.yo");
{ get_trait_type_from_env } :: import("../../types/env_lookup.yo");
{ type_implements_trait_bool, extract_fn_trait_from_type } :: import("../trait_checking.yo");
{ type_to_string } :: import("../../types/string.yo");
{ can_type_form_rc_cycle, get_all_some_types } :: import("../../types/utils.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ EvalContext, ExpectedTypeCtx, call_function_value_marker } :: import("../context.yo");
{ EvalValue, create_type_value, is_type_value } :: import("../../value.yo");
{ set_variable_as_consumed } :: import("../builtins/consume.yo");
{ attach_temp_variable_to_expr } :: import("../utils.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ format_error_message, format_eval_failure, with_code } :: import("../../error.yo");
{ E_VARIABLE_NOT_FOUND } :: import("../../diagnostics.yo");
{ Exception } :: import("std/error");
/// True if struct type `t` has a dereference field labeled `*` (the
/// pointed-to-value field of a Box/Arc wrapper).
_struct_has_deref_field :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .Struct({ field_labels : fls }) => {
      (found : bool) = false;
      (i : usize) = usize(0);
      while((i < fls.len()) && !found, {
        match(
          fls.get(i),
          .Some(l) => if(l == "*", {
            found = true;
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    _ => false
  )
);
/// Evaluate an Iso type-constructor call, e.g. `Iso(Box(i32))`.
///
///
///
/// Note: RC function injection (`addRcFunctionsToIsoType`) is deferred —
/// returns env unchanged, same as dyn.yo's `addRcFunctionsToDynType`.
/// Rule D9 inside an `Iso`: the uniqueness walk proves no other thread holds
/// a reference into the graph, and says nothing about what a FUNCTION stored
/// in it does when the receiving thread calls it. A struct holding a function
/// that pushes to a non-Send global, isolated and extracted on another
/// thread, raced on the global
/// (issues/fixed/iso-of-a-graph-holding-a-function-value-bypasses-d9.md). Every
/// function value the graph can hold must be Send by D9; a bare `fn` field or
/// a `Dyn` without `Send` (code unknown here) is not. `.Some(reason)` names the
/// first offending component.
_iso_function_offense :: (
  fn(ty : TypeValue, send : TypeValue, seen : ArrayList(String), env : Environment, ctx : EvalContext) -> Option(String)
)({
  // Cycle guard on nominal identity (ArrayList(T) reaches T through its buffer).
  nid := match(ty, .Struct({ id : sid }) => sid, .EnumT(eid, _, _, _, _, _, _, _, _) => eid, _ => String.new());
  if(!nid.is_empty(), {
    (si : usize) = usize(0);
    while(si < seen.len(), {
      if(match(seen.get(si), .Some(x) => (x == nid), .None => false), {
        return(Option(String).None);
      });
      si = (si + usize(1));
    });
    seen.push(nid);
  });
  if(is_function_type(ty) || (is_some_type(ty) && extract_fn_trait_from_type(ty).is_some()), {
    return(
      match(
        call_function_value_marker(ty, Option(EvalValue).None, send, env, ctx),
        .Some(fvm) => match(fvm, .Some(o) => Option(String).Some(`it holds a ${type_to_string(ty)} whose value ${o}`), .None => Option(String).None),
        .None => if(type_implements_trait_bool(ty, send, env), Option(String).None, Option(String).Some(`it holds a ${type_to_string(ty)}, a function type whose value is unknown here, and a function is Send only by what its code reaches (rule D9) — declare it \`Impl(Fn(...), Send)\``))
      )
    );
  });
  match(
    ty,
    .DynT(_, _, _, _) => if(!type_implements_trait_bool(ty, send, env), {
      return(Option(String).Some(`it holds a ${type_to_string(ty)}, whose methods may run code that reaches a non-Send global — use Dyn(Trait, Send)`));
    }),
    _ => ()
  );
  children := ArrayList(TypeValue).new();
  match(
    ty,
    .Struct({ id : _ }) => match(
      resolve_struct_shell(ty),
      .Struct({ field_types : fts }) => {
        (fi : usize) = usize(0);
        while(fi < fts.len(), {
          match(fts.get(fi), .Some(ft) => children.push(ft), .None => ());
          fi = (fi + usize(1));
        });
      },
      _ => ()
    ),
    .EnumT(_, _, _, _, _, _, _, _, _) => match(
      resolve_enum_shell(ty),
      .EnumT(_, _, _, vfs, _, _, _, _, _) => {
        (vi : usize) = usize(0);
        while(vi < vfs.len(), {
          match(
            vfs.get(vi),
            .Some(vf) => {
              (vj : usize) = usize(0);
              while(vj < vf.len(), {
                match(vf.get(vj), .Some(vt) => children.push(vt), .None => ());
                vj = (vj + usize(1));
              });
            },
            .None => ()
          );
          vi = (vi + usize(1));
        });
      },
      _ => ()
    ),
    .Tuple({ field_types : tfts }) => {
      (ti : usize) = usize(0);
      while(ti < tfts.len(), {
        match(tfts.get(ti), .Some(tt) => children.push(tt), .None => ());
        ti = (ti + usize(1));
      });
    },
    .Pointer(pointee) => children.push(pointee),
    _ => ()
  );
  (ci : usize) = usize(0);
  while(ci < children.len(), {
    match(
      children.get(ci),
      .Some(ct) => match(
        _iso_function_offense(ct, send, seen, env, ctx),
        .Some(o) => {
          return(Option(String).Some(o));
        },
        .None => ()
      ),
      .None => ()
    );
    ci = (ci + usize(1));
  });
  Option(String).None
});
evaluate_iso_type_call :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  (env : Environment) = env_in;
  // Extract the single arg.
  arg_exprs := match(
    expr,
    .FnCall(_, _, args, _, _) => args,
    _ => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `evaluate_iso_type_call: expected FnCall expr`
          )
        )
      );
      ArrayList(AstExpr).new()
    }
  );
  arg_expr := match(
    arg_exprs.get(usize(0)),
    .Some(a) => a,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `Iso requires exactly one argument`
          )
        )
      );
      return(expr);
    }
  );
  evaluated_arg := evaluate_expression(arg_expr, env, ctx);
  arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_arg));
  if(arg_info_opt.is_none(), {
    exn.throw(
      dyn(
        format_eval_failure(
          ast_expr_token(arg_expr),
          `Failed to evaluate the argument expression for Iso`
        )
      )
    );
  });
  arg_info := match(arg_info_opt, .Some(it) => it, .None => new_expr_info(env, TypeValue.Unit));
  env.frames = copy_frames(arg_info.env.frames);
  env.module_path = arg_info.env.module_path;
  env.function_declaration_frame_level = arg_info.env.function_declaration_frame_level;
  env.input_string = arg_info.env.input_string;
  // Check that the argument is a type value.
  if(!is_type_value(arg_info.value), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          `Iso expects a type as argument`
        )
      )
    );
  });
  // EvalValue.TypeVal has a TypeValue — extract the child type.
  eval_val_opt := arg_info.value;
  child_type := match(
    eval_val_opt,
    .Some(ev) => match(
      ev,
      .TypeVal(ty_box) => ty_box,
      _ => TypeValue.Unit
    ),
    .None => TypeValue.Unit
  );
  // Phase H: Ban Iso(Arc(T)) — Iso's uniqueness is about the Iso wrapper's
  // rc, not the inner Arc cell. After extract() you get the Arc back; Iso adds
  // nothing over naked Arc + move-on-spawn.
  if(is_atomic_reference_struct_type(child_type) && _struct_has_deref_field(child_type), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Iso(Arc(T)) is not allowed.\n  - To send an Arc handle across a thread, send the Arc directly — the spawn closure already consumes it. Iso adds nothing.\n  - If you want unique-owned heap data, use Iso(Box(T)) or Iso(...your struct...).`
        )
      )
    );
  });
  // Rule D2 (plans/reference/PARALLELISM_RULES.md): `Iso(T)` hands a UNIQUE
  // reference graph to another thread, so `T` must be a non-atomic
  // reference-counted OBJECT — the Iso holds its handle and releases it with
  // `__yo_decr_rc` (a scalar there dereferenced the integer and a value struct
  // is not a handle at all:
  // issues/fixed/iso-constructor-is-unchecked-and-extract-verifies-no-uniqueness.md).
  // An atomic object (Iso(Arc) is rejected above) and another Iso are already
  // sendable as they are. Only a
  // concrete `T`: the prelude's own `impl(generic(T), Iso(T), ...)` builds
  // `Iso(T)` over a type variable.
  if(get_all_some_types(child_type).len() == usize(0), {
    if(is_iso_type(child_type), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `Iso(Iso(T)) is not allowed: an Iso is already a unique, sendable handle — send it directly.`
          )
        )
      );
    });
    // Rule D9: every function value the isolated graph can hold is Send.
    match(
      get_trait_type_from_env(env, String.from("Send")),
      .Some(iso_send) => match(
        _iso_function_offense(child_type, iso_send, ArrayList(String).new(), env, ctx),
        .Some(iso_fo) => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr),
                `Iso(${type_to_string(child_type)}) is not allowed: ${iso_fo}. Isolation proves the graph is uniquely owned; it does not make the code a function in it runs safe on another thread.`
              )
            )
          );
        },
        .None => ()
      ),
      .None => ()
    );
    child_is_object := (is_reference_struct_type(child_type) || is_reference_enum_type(child_type));
    if(!child_is_object || (is_atomic_reference_struct_type(child_type) || is_atomic_reference_enum_type(child_type)), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            cond(
              !child_is_object => `Iso(${type_to_string(child_type)}) is not allowed: Iso isolates a reference-counted OBJECT (a ref struct or ref enum — ArrayList, HashMap, Box, a user ref(struct)) so it can move to one other thread, and ${type_to_string(child_type)} is not one. A value type is copied on send — pass it directly, or put it in a Box.`,
              true => `Iso(${type_to_string(child_type)}) is not allowed: an atomic object is already shared safely across threads (it is Send) — send it directly.`
            )
          )
        )
      );
    });
  });
  // Create the Iso type.
  iso_type := t_iso(child_type);
  // Phase 2bd deferred: addRcFunctionsToIsoType — generates atomic dispose/drop/dup
  // for the Iso type. Not yet implemented (same status as addRcFunctionsToDynType).
  // Store result.
  type_val := create_type_value(iso_type);
  out_info := new_expr_info(env, t_type());
  out_info.value = .Some(type_val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
/// Join an ArrayList(String) with a separator into a single String.
_join_strings :: (fn(items : ArrayList(String), sep : String) -> String)({
  result := String.from("");
  n := items.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      items.get(i),
      .Some(s) => {
        if(i > usize(0), {
          result = (result + sep);
        });
        result = (result + s);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  result
});
/// Collect the names of all variables in `env` whose `is_owning_the_same_rc_value_as`
/// points to the variable with `owner_id`.
_find_rc_aliases :: (fn(env : Environment, owner_id : String) -> ArrayList(String))({
  result := ArrayList(String).new();
  n_frames := env.frames.len();
  (fi : usize) = usize(0);
  while(fi < n_frames, {
    match(
      env.frames.get(fi),
      .Some(frame) => {
        n_vars := frame.variables.len();
        (vi : usize) = usize(0);
        while(vi < n_vars, {
          match(
            frame.variables.get(vi),
            .Some(v) => {
              same_owner_id := match(
                v.is_owning_the_same_rc_value_as,
                .Some(ref_box) => ref_box.*.id.to_string(),
                .None => String.from("")
              );
              if((same_owner_id == owner_id) && !(v.id.to_string() == owner_id), {
                result.push(v.name);
              });
            },
            .None => ()
          );
          vi = (vi + usize(1));
        });
      },
      .None => ()
    );
    fi = (fi + usize(1));
  });
  result
});
/// Evaluate an Iso value-constructor call, e.g. `Iso(Box(i32))(x)`.
///
///
///
/// Checks:
/// 1. The arg has no RC cycle risk
/// 2. The arg variable owns its RC value
/// 3. No other variable aliases the same RC value
/// Then marks the arg as consumed and wraps in iso_type.
evaluate_iso_value_call :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    iso_type : TypeValue,
    exn : Exception
  ) -> AstExpr
)({
  (env : Environment) = env_in;
  // Rule D2: the raw constructor checks aliasing only for a named variable and
  // nothing inside the value, so safe code constructs an Iso with `^v`, whose
  // runtime walk proves the whole graph unique
  // (issues/fixed/iso-constructor-is-unchecked-and-extract-verifies-no-uniqueness.md).
  // The `^` expansion itself calls this constructor from the prelude.
  if(!is_implicitly_unsafe_capable_file(Option(String).Some(ast_expr_token(expr).module_path.clone())), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `\`Iso(T)(value)\` is not available in safe code: it cannot see whether anything else still references the value's interior. Construct an Iso with \`^value\` instead — it returns .None unless the whole reference graph is uniquely owned.`
        )
      )
    );
  });
  iso_child_type := match(
    iso_type,
    .IsoT(child_box) => child_box,
    _ => TypeValue.Unit
  );
  arg_exprs := match(
    expr,
    .FnCall(_, _, args, _, _) => args,
    _ => ArrayList(AstExpr).new()
  );
  arg_expr := match(
    arg_exprs.get(usize(0)),
    .Some(a) => a,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `Iso value constructor requires exactly one argument`
          )
        )
      );
      return(expr);
    }
  );
  // Evaluate with expected type = iso_child_type.
  saved_expected := ctx.expected_type;
  ctx.expected_type = .Some(ExpectedTypeCtx(ty : iso_child_type, env : env));
  evaluated_arg := evaluate_expression(arg_expr, env, ctx);
  ctx.expected_type = saved_expected;
  arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_arg));
  if(arg_info_opt.is_none(), {
    exn.throw(
      dyn(
        format_eval_failure(
          ast_expr_token(arg_expr),
          `Failed to evaluate argument for Iso value constructor`
        )
      )
    );
  });
  arg_info := match(arg_info_opt, .Some(it) => it, .None => new_expr_info(env, TypeValue.Unit));
  env.frames = copy_frames(arg_info.env.frames);
  env.module_path = arg_info.env.module_path;
  env.function_declaration_frame_level = arg_info.env.function_declaration_frame_level;
  env.input_string = arg_info.env.input_string;
  // Check ownership / alias constraints using the variable name from ExprInfo.
  match(
    arg_info.variable_name,
    .Some(var_name) => {
      variables := get_variables_from_env(env, var_name);
      n_vars := variables.len();
      if(n_vars > usize(0), {
        variable := match(
          variables.get(n_vars - usize(1)),
          .Some(v) => v,
          .None => {
            exn.throw(
              dyn(
                with_code(
                  format_error_message(
                    ast_expr_token(arg_expr),
                    `Variable "${var_name}" not found.`
                  ),
                  E_VARIABLE_NOT_FOUND
                )
              )
            );
            return(expr);
          }
        );
        // Check if the type may form RC cycles.
        if(can_type_form_rc_cycle(variable.ty), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(arg_expr),
                `Cannot isolate variable ${var_name} because its type may form RC cycles.`
              )
            )
          );
        });
        // Check that the variable owns its RC value.
        if(!variable.is_owning_the_rc_value, {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(arg_expr),
                `Cannot isolate variable ${var_name} because it does not own its RC value.`
              )
            )
          );
        });
        // Check for aliases: look for variables whose is_owning_the_same_rc_value_as
        // points to this variable's id.
        var_id := variable.id.to_string();
        alias_names := _find_rc_aliases(env, var_id);
        if(alias_names.len() > usize(0), {
          // Build comma-separated list.
          alias_list := _join_strings(alias_names, String.from(", "));
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(arg_expr),
                `Cannot isolate ${var_name}, also owned by: ${alias_list}\nIso requires unique ownership (no aliases). Drop other aliases first.`
              )
            )
          );
        });
      }, {
        exn.throw(
          dyn(
            with_code(
              format_error_message(
                ast_expr_token(arg_expr),
                `Variable "${var_name}" not found.`
              ),
              E_VARIABLE_NOT_FOUND
            )
          )
        );
      });
    },
    .None => ()
  );
  // Consume the variable (mark it as moved).
  match(
    arg_info.variable_name,
    .Some(var_name) => {
      is_type_val := is_type_value(arg_info.value);
      set_variable_as_consumed(var_name, ast_expr_token(arg_expr), env, false, is_type_val, exn);
    },
    .None => ()
  );
  // Wrap result in iso_type — value is runtime only (no comptime value).
  out_info := new_expr_info(env, iso_type);
  out_info.value = .None;
  out_info.path_collection = arg_info.path_collection;
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  attach_temp_variable_to_expr(expr, true, ctx);
  expr
});
export(evaluate_iso_type_call);
export(evaluate_iso_value_call);
