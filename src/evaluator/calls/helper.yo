            func_id
          );
          // Register recursive self-reference in context so recursive calls
          // inside the body can find the specialized func_id.
          // Bind the inferred generic values (arg_values.forall_args, in
          // forall_names order) into the mint env before the return
          // re-evaluation. TS's calleeEnv already carries these bindings; on
          // the yo-self FuncVal-arm route the env passed here does NOT —
          // measured on the closure-arg repro: forall_args=[i32] at mint
          // entry while the re-eval still saw `U` unbound, so spec_ret_ty
          // stayed `List(U)`, emission's has_generic_return gate silently
          // dropped the spec, and the call site referenced an undefined
          // yo_id_... (the cluster-7 shape). Concrete values only.
          {
            (zb_i : usize) = usize(0);
            n_zb := forall_names.len();
            zb_ft := match(func_type, .Func({ forall_types : zft }) => zft, _ => ArrayList(TypeValue).new());
            while((zb_i < n_zb) && (zb_i < arg_values.forall_args.len()), {
              zb_name := match(forall_names.get(zb_i), .Some(n) => n, .None => String.from(""));
              // VALUE-generic binders (`generic(N : usize)` — declared kind is
              // NOT `Type`) must never be rebound to a TypeVal: on the
              // method-dispatch route (function.yo spec_forall_args) the
              // forall_args carry the IMPL-level bindings (T := i32) while
              // forall_names are the FN-level binders, so a positional bind
              // would stamp `N := i32` (ty Type) and the body's
              // `with_capacity(N)` throws unify(usize, Type) on the
              // unswallowed spec path (the imm_list/imm_vec hollow batch
              // main). TS never rebinds here at all — its calleeEnv already
              // carries the (kind-correct) bindings.
              zb_kind := match(zb_ft.get(zb_i), .Some(t) => t, .None => t_unit());
              match(
                arg_values.forall_args.get(zb_i),
                .Some(zb_ae) => match(
                  zb_ae.value,
                  .Some(zb_v) => match(
                    zb_v,
                    .TypeVal(zb_tb) => if((!(is_some_type(zb_tb))) && is_type_0(zb_kind), {
                      _zb := add_variable_to_env(
                        callee_env,
                        zb_name,
                        TypeValue.TypeUni(usize(0)),
                        Option(EvalValue).Some(EvalValue.TypeVal(zb_tb.clone())),
                        true,
                        false,
                        false,
                        false,
                        synthetic_token(zb_name, callee_env.module_path)
                      );
                    }, {
                      // Declared-param bridge, mint-env half (the
                      // value-semantics equivalent of TS's shared
                      // resolvedConcreteType identity): the forall bound to
                      // an UNRESOLVED wrapper SomeT (box's `V` := the
                      // Impl-Fn wrapper from the expected-type arm) leaves
                      // the spec BODY eval typing `Box(V)(value)` with the
                      // pattern-era instantiation — a DIFFERENT C struct
                      // identity than the registered concrete return (the
                      // cluster-B `__yo_new___yo_t3` undeclared-ctor shape).
                      // A declared param that IS that bare SomeT pairs
                      // positionally with the call's concrete argument type
                      // (a closure arg resolves to its capture struct); bind
                      // THAT so the body eval sees the same concrete `V` the
                      // registered spec type carries. In TS the wrapper's
                      // resolvedConcreteType is set once and seen everywhere,
                      // body eval included.
                      if(is_some_type(zb_tb) && is_type_0(zb_kind), {
                        zb_pt := match(func_type, .Func({ param_types : zpt }) => zpt, _ => ArrayList(TypeValue).new());
                        (zbp : usize) = usize(0);
                        (zb_done : bool) = false;
                        while((zbp < zb_pt.len()) && !(zb_done), {
                          zb_decl_nm := match(
                            zb_pt.get(zbp),
                            .Some(zb_dt) => match(
                              zb_dt,
                              .SomeT(_, zdn, _, _, _, _, _, _, _, _, _) => zdn,
                              _ => String.from("")
                            ),
                            .None => String.from("")
                          );
                          if((zb_decl_nm.len() > usize(0)) && (zb_decl_nm == zb_name), {
                            (zb_conc : Option(TypeValue)) = Option(TypeValue).None;
                            match(
                              arg_values.args.get(zbp),
                              .Some(zb_ae2) => {
                                match(
                                  zb_ae2.value,
                                  .Some(zb_v2) => match(
                                    zb_v2,
                                    .FuncVal(zb_fvd, _) => {
                                      match(
                                        get_closure_capture_info(zb_fvd.*.func_id.clone()),
                                        .Some(zb_ci) => {
                                          zb_conc = Option(TypeValue).Some(zb_ci.capture_type);
                                        },
                                        .None => ()
                                      );
                                    },
                                    _ => ()
                                  ),
                                  .None => ()
                                );
                                match(
                                  zb_conc,
                                  .Some(_) => (),
                                  .None => if((get_all_some_types(zb_ae2.arg_type).len() == usize(0)) && !(is_unit_type(zb_ae2.arg_type)), {
                                    zb_conc = Option(TypeValue).Some(zb_ae2.arg_type);
                                  })
                                );
                              },
                              .None => ()
                            );
                            match(
                              zb_conc,
                              .Some(zb_ct) => {
                                _zb2 := add_variable_to_env(
                                  callee_env,
                                  zb_name,
                                  TypeValue.TypeUni(usize(0)),
                                  Option(EvalValue).Some(EvalValue.TypeVal(zb_ct.clone())),
                                  true,
                                  false,
                                  false,
                                  false,
                                  synthetic_token(zb_name, callee_env.module_path)
                                );
                                zb_done = true;
                              },
                              .None => ()
                            );
                          });
                          zbp = (zbp + usize(1));
                        });
                      });
                    }),
                    _ => ()
                  ),
                  .None => ()
                ),
                .None => ()
              );
              zb_i = (zb_i + usize(1));
            });
          };
          (spec_ret_ty : TypeValue) = evaluate_function_return_type_again(
            match(func_type, .Func({ result : r }) => r, _ => t_unit()),
            callee_env,
            ctx
          );
          // If the re-evaluation left SomeTs (an env NAME binding cannot
          // resolve the DIFFERENT SomeT copy inside a generic instantiation
          // like `List(U)` — the Gap-6 lineage split), substitute by SomeT
          // OCCURRENCE, the proven FuncVal-arm template
          // (function.yo:1348-1370): match each SomeT in the declared return
          // to a forall name and substitute the inferred forall_args value at
          // the occurrence's own recorded level.
          if((get_all_some_types(spec_ret_ty).len() > usize(0)) || _type_has_array_len_var(spec_ret_ty), {
            zdecl_ret := match(func_type, .Func({ result : zr }) => zr, _ => t_unit());
            zret_somes := get_all_some_types(zdecl_ret);
            if(zret_somes.len() > usize(0), {
              zs_ret := subst_new();
              (zs_any : bool) = false;
              (zrsi : usize) = usize(0);
              while(zrsi < zret_somes.len(), {
                zrst := match(zret_somes.get(zrsi), .Some(t) => t, .None => t_unit());
                match(
                  zrst,
                  .SomeT(_, zrst_name, zrst_lvl, _, _, _, _, _, _, _, _) => {
                    (zbni : usize) = usize(0);
                    while(zbni < forall_names.len(), {
                      zbn := match(forall_names.get(zbni), .Some(n) => n, .None => String.from(""));
                      if((zbn == zrst_name) && (zbni < arg_values.forall_args.len()), {
                        match(
                          arg_values.forall_args.get(zbni),
                          .Some(zae) => match(
                            zae.value,
                            .Some(zv) => match(
                              zv,
                              .TypeVal(ztb) => if(!(is_some_type(ztb)), {
                                subst_add(zs_ret, zrst_name.clone(), zrst_lvl, ztb.clone());
                                zs_any = true;
                              }),
                              _ => ()
                            ),
                            .None => ()
                          ),
                          .None => ()
                        );
                      });
                      zbni = (zbni + usize(1));
                    });
                  },
                  _ => ()
                );
                zrsi = (zrsi + usize(1));
              });
              if(zs_any, {
                spec_ret_ty = substitute(zs_ret, zdecl_ret);
              });
            });
          });
          // TS-faithful return resolution (see _trial_eval_ret_type_expr): with
          // the mint env fully bound (foralls + comptime params), RE-EVALUATE
          // the declared return-type EXPR so instantiations route through the
          // memoized type constructor — same lineage as the body's calls.
          // Adopt CONSERVATIVELY: only a concrete (SomeT-free, non-unit)
          // result overrides the substitution-based resolution above — and
          // ONLY as a FALLBACK when that resolution still carries SomeTs
          // (the comptime-param family: substitution kept the def-era
          // instance). When substitution already produced a concrete return
          // (the forall/method route, e.g. HashMap's `-> Option(V)`), keep
          // it: replacing it re-registered a DIFFERENT instantiation era
          // than the dot-route call-site stamp and clang rejected the
          // temp initializer (the hashmap_overwrite_no_leak SELF-FAIL).
          (rte_adopted : bool) = false;
          // Explicit-comptime-Type-param functions (`fn(comptime(K) : Type,
          // ...)`) ALWAYS take the re-eval: their def-era signature
          // instantiations are NOCACHE mints (the ctor arg contained the
          // SomeT K), so a fully-substituted "concrete" return is
          // guaranteed NON-canonical — a different instantiation era than
          // the body's ctor calls (Map(i32) as struct 4785 vs 4806; the
          // imm_sorted_map family, issues/retired/yo-self-69-red-list-map.md ROOT
          // CAUSE 2026-07-30). The hazard case that motivated the
          // conservative gate (hashmap_overwrite_no_leak) is the
          // FORALL/method route — no explicit comptime Type params — and
          // keeps the old gate.
          (rte_has_ct_param : bool) = false;
          {
            (rhc_i : usize) = usize(0);
            while((rhc_i < spec_param_ct_flags.len()) && !(rte_has_ct_param), {
              match(
                spec_param_ct_flags.get(rhc_i),
                .Some(f) => if(f, {
                  rte_has_ct_param = true;
                }),
                .None => ()
              );
              rhc_i = (rhc_i + usize(1));
            });
          };
          // Slice 2 (the PARAM side of the era fix, RETRY with the recorded
          // refinement): with the mint env fully bound, RE-EVALUATE each
          // runtime param's declared TYPE EXPR (g_func_param_type_exprs; TS
          // parameter.exprs.typeExpr via evaluateFunctionParameterTypeAgain)
          // and OVERWRITE runtime_param_tys with a concrete result — so the
          // placeholder rebind loop, the body eval and the registered
          // spec_param_types all share the CACHE era instead of the
          // per-call-site ARG era. Without it, two params declared with the
          // SAME type expression (`left, right : Option(RBNode(K, V))`) took
          // DIFFERENT eras from their args and the C signature split
          // (imm_threading/imm_sorted_map). REFINEMENT vs the reverted first
          // attempt: params whose DECLARED type carries an Fn-trait wrapper
          // are EXCLUDED — re-evaluating those perturbed the closure-capture
          // era the closure-param rebind relies on (the
          // closure_where_clause_param corpus DIFF that reverted slice 2).
          if(rte_has_ct_param, {
            pte_exprs := get_func_param_type_exprs(func_id.clone());
            if(pte_exprs.len() > usize(0), {
              pte_prev_fnty := ctx.is_evaluating_function_type;
              ctx.is_evaluating_function_type = true;
              pte_prev_self := ctx.self_type;
              {
                pte_p0_is_self := match(params.get(usize(0)), .Some(l) => (l == "self"), .None => false);
                if(pte_p0_is_self, {
                  match(
                    arg_values.args.get(usize(0)),
                    .Some(pte_rcv) => {
                      ctx.self_type = Option(TypeValue).Some(pte_rcv.arg_type);
                    },
                    .None => ()
                  );
                });
              };
              pte_decl_pts := match(func_type, .Func({ param_types : pdp }) => pdp, _ => ArrayList(TypeValue).new());
              (pte_i : usize) = usize(0);
              while(pte_i < runtime_param_tys.len(), {
                pte_ct := match(spec_param_ct_flags.get(pte_i), .Some(f) => f, .None => false);
                pte_is_fn_carrier := match(
                  pte_decl_pts.get(pte_i),
                  .Some(pte_dpt) => extract_fn_trait_from_type(pte_dpt).is_some(),
                  .None => false
                );
                if(!(pte_ct) && !(pte_is_fn_carrier), {
                  match(
                    pte_exprs.get(pte_i),
                    .Some(pte_e_opt) => match(
                      pte_e_opt,
                      .Some(pte_e) => {
                        pte_out := ArrayList(TypeValue).new();
                        _trial_eval_ret_type_expr(clone_expr_fresh_ids(pte_e), callee_env, ctx, pte_out);
                        match(
                          pte_out.get(usize(0)),
                          .Some(pte_t) => if(((get_all_some_types(pte_t).len() == usize(0)) && !(is_unit_type(pte_t))) && !(_type_has_array_len_var(pte_t)), {
                            runtime_param_tys(pte_i) = pte_t;
                          }),
                          .None => ()
                        );
                      },
                      .None => ()
                    ),
                    .None => ()
                  );
                });
                pte_i = (pte_i + usize(1));
              });
              ctx.self_type = pte_prev_self;
              ctx.is_evaluating_function_type = pte_prev_fnty;
            });
          });
          // Recursive-instantiation era repair, mint half (see the rre_era_suspect
          // comment in calls/function.yo — same class, same exclusions): a declared
          // return whose NOMINAL type_arguments carry SomeTs (`-> Box(V)`) that the
          // occurrence-substitution above rewrote to a SomeT-free result is a
          // def-era COPY whose type_key diverges from the ctor memo's canonical
          // instance for recursive payloads. Route it through the return-EXPR
          // re-eval below so the registered spec return carries the canonical
          // identity; adoption stays concrete-only.
          rte_decl_tyarg_somes := ArrayList(TypeValue).new();
          _collect_type_arg_somes(
            match(func_type, .Func({ result : zr0 }) => zr0, _ => t_unit()),
            rte_decl_tyarg_somes,
            ArrayList(String).new()
          );
          rte_era_suspect := ((rte_decl_tyarg_somes.len() > usize(0)) && (get_all_some_types(spec_ret_ty).len() == usize(0)));
          if((((get_all_some_types(spec_ret_ty).len() > usize(0)) || _type_has_array_len_var(spec_ret_ty)) || rte_has_ct_param) || rte_era_suspect, {
            match(
              get_func_return_type_expr(func_id.clone()),
              .Some(rte_expr) => {
                rte_prev_fnty := ctx.is_evaluating_function_type;
                ctx.is_evaluating_function_type = true;
                // `Self` in the return expr must resolve to THIS method's
                // receiver, not the CALLER's stale ctx.self_type (TS passes
                // functionType.SelfType into evaluateFunctionReturnTypeAgain).
                // Mirror the mint's instance-method self reconstruction here:
                // params[0] == "self" → the receiver ARG's type IS Self.
                // Static dot-calls already had ctx.self_type set by the
                // dispatcher. Without this, ptr `add -> Self` minted inside
                // `insert`'s spec adopted Map(i32,i32) (caller-era Self) as
                // its return and the spec body failed to unify against
                // *(Pair(i32,i32)).
                rte_prev_self := ctx.self_type;
                {
                  rte_p0_is_self := match(params.get(usize(0)), .Some(l) => (l == "self"), .None => false);
                  if(rte_p0_is_self, {
                    match(
                      arg_values.args.get(usize(0)),
                      .Some(rte_rcv) => {
                        ctx.self_type = Option(TypeValue).Some(rte_rcv.arg_type);
                      },
                      .None => ()
                    );
                  });
                };
                rte_out := ArrayList(TypeValue).new();
                _trial_eval_ret_type_expr(clone_expr_fresh_ids(rte_expr), callee_env, ctx, rte_out);
                ctx.self_type = rte_prev_self;
                ctx.is_evaluating_function_type = rte_prev_fnty;
                match(
                  rte_out.get(usize(0)),
                  .Some(rte_ty) => {
                    if(((get_all_some_types(rte_ty).len() == usize(0)) && !(_type_has_array_len_var(rte_ty))) && !(is_unit_type(rte_ty)), {
                      spec_ret_ty = rte_ty;
                      rte_adopted = true;
                    });
                  },
                  .None => ()
                );
              },
              .None => ()
            );
          });
          prev_spec := ctx.currently_specializing_function;
          // Push onto the FULL specializing stack BEFORE moving the originals into
          // the single slot. The stack catches MUTUAL recursion (f→g→f) that the
          // single slot — overwritten by the inner sibling g — cannot; without it the
          // unified stage-2 self-compile re-specializes the compiler's own mutually
          // recursive call graph forever and overflows the stack (Phase 6). Stack
          // entries need only the id/return-type fields (EvalValue has no clone, and
          // `original_func_value` is never read off the stack). Mirrors TS
          // currentlySpecializingFunctionStack (helper.ts:2419-2429); popped below.
          spec_stack := match(
            ctx.currently_specializing_function_stack,
            .Some(s) => s,
            .None => ArrayList(SpecializingFunctionInfo).new()
          );
          // The impl-binding signature travels on BOTH the stack entry and the
          // top slot so the recursion guards can tell "same trait method, same
          // instantiation" (true recursion) from "same trait method, DIFFERENT
          // instantiation" (a nested call that must mint its own spec) — see
          // _impl_type_captures_sig.
          push_bindings_sig := _impl_type_captures_sig(original_func_val);
          spec_stack.push(
            SpecializingFunctionInfo(
              original_func_id : func_id.clone(),
              specialized_func_id : specialized_func_id.clone(),
              specialized_return_type : spec_ret_ty.clone(),
              original_func_value : EvalValue.UnitVal,
              impl_bindings_sig : push_bindings_sig.clone()
            )
          );
          ctx.currently_specializing_function_stack = Option(ArrayList(SpecializingFunctionInfo)).Some(spec_stack);
          ctx.currently_specializing_function = Option(SpecializingFunctionInfo).Some(
            SpecializingFunctionInfo(
              original_func_id : func_id,
              specialized_func_id : specialized_func_id,
              specialized_return_type : spec_ret_ty.clone(),
              original_func_value : original_func_val,
              impl_bindings_sig : push_bindings_sig
            )
          );
          // Build a function-body evaluation context so explicit `return(...)`
          // statements inside the specialized body are legal — begin.yo gates
          // `return` on `is_evaluating_function_body_or_async_block` and throws
          // "return can only be used inside a function body" otherwise (which
          // would propagate out and leave the call site without ExprInfo). The
          // func_type carries the SPECIALIZED return type so a generic `-> T` /
          // `-> Self` return argument is checked against the concrete type, not
          // the original SomeType-bearing one. Mirrors TS helper.ts:2434-2454.
          fb_func_type := match(
            func_type,
            .Func({
              forall_types : ft_ft,
              param_types : ft_pt,
              implicit_types : ft_it,
              where_types : ft_wt,
              meta : ft_meta
            }) => TypeValue.Func(
              ft_ft,
              ft_pt,
              ft_it,
              ft_wt,
              spec_ret_ty.clone(),
              ft_meta,
              ArrayList(TypeValue).new()
            ),
            _ => func_type
          );
          // Override the evaluation context for the body exactly as TS does
          // (`{ ...context, <overrides> }` in helper.ts:2437-2462). The
          // specialized body is a FRESH function scope, so we must:
          //   * mark it a function body (legalizes explicit `return(...)`),
          //   * CLEAR captured_variables (TS `capturedVariables: undefined`) —
          //     otherwise a nested regular `->` function in the body inherits
          //     the caller's capture map and wrongly reports "a regular
          //     function cannot capture outer runtime variables" (e.g. std/path),
          //   * CLEAR is_evaluating_loop_body,
          //   * set expected_type to the specialized return type,
          //   * give it a fresh function_return_impl_concrete_type array.
          // All saved and restored around the body eval.
          prev_fb := ctx.is_evaluating_function_body_or_async_block;
          prev_caps := ctx.captured_variables;
          prev_loop := ctx.is_evaluating_loop_body;
          prev_expected := ctx.expected_type;
          prev_fri := ctx.function_return_impl_concrete_type;
          ctx.is_evaluating_function_body_or_async_block = Option(FuncOrAsyncBlockCtx).Some(
            FuncOrAsyncBlockCtx(
              kind : FuncOrAsyncBlockKind.FunctionBody,
              func_type : Option(TypeValue).Some(fb_func_type),
              func_value : Option(EvalValue).Some(original_func_val),
              // SNAPSHOT the entry env (frames-list copy, shared Frame refs):
              // TS's evaluationEnv is a persistent env whose frames.length is
              // frozen at body entry, so trackVariableUsage's outer-scope gate
              // (frameLevel >= evaluationEnv.frames.length) never counts the
              // body's OWN begin frame. yo-self's live env grows when
              // evaluate_begin pushes that frame, so body locals (frame_level
              // == entry count) looked "outer" and polluted captured_variables
              // (killing the dup/drop pair optimizer's captured gate — the
              // cycle_collector mid-scope collect failure).
              eval_env : snapshot_env(callee_env)
            )
          );
          // For a CLOSURE being specialized, record captures with a FRESH map
          // instead of clearing: a DEFERRED-generic closure (an Impl(Fn)
          // capture flips it onto this path) skipped its definition-time
          // capture collection entirely, so THIS body eval is the only
          // chance to learn what it closes over — clearing left the emitted
          // body with bare undeclared identifiers
          // (issues/repros/dyn-closure-implfn-capture-loss.yo). Regular fns
          // keep the clearing (nested `->` fns must not inherit the caller's
          // map — the std/path regression its comment documents).
          spec_is_closure := is_closure_fn(func_id.clone());
          if(spec_is_closure, {
            ctx.captured_variables = Option(HashMap(String, CapturedVarInfo)).Some(HashMap(String, CapturedVarInfo).new());
          }, {
            ctx.captured_variables = Option(HashMap(String, CapturedVarInfo)).None;
          });
          ctx.is_evaluating_loop_body = Option(LoopBodyCtx).None;
          ctx.expected_type = Option(ExpectedTypeCtx).Some(
            ExpectedTypeCtx(ty : spec_ret_ty.clone(), env : callee_env)
          );
          ctx.function_return_impl_concrete_type = Option(ArrayList(ImplConcreteTypeInfo)).Some(
            ArrayList(ImplConcreteTypeInfo).new()
          );
          // Re-bind a regular parameter to a RUNTIME placeholder (`UnknownVal`
          // of its specialized type) ONLY when try_to_call left it bound to a
          // FOLDED COMPTIME CONSTANT (e.g. `println(i32(7))` binds `v` to the
          // IntLit `7`). A specialized function is reused across every call of
          // the same type signature, so a baked-in constant is wrong: the body
          // emitted `to_string(&(int32_t){7})`, and `println(i32(9))` reused it
          // and printed `7`. GUARD: only rebind params whose current value is a
          // KNOWN constant — params already bound to an `UnknownVal` (the normal
          // runtime case, e.g. a `comptime_str` arg coerced to runtime `str`) are
          // LEFT UNTOUCHED, since blindly re-binding them perturbs the
          // specialization identity (a str `println` regressed to an undeclared
          // specialized callee). Mirrors TS specializeFunction using runtime
          // placeholders for value params.
          // Declared param types (the SomeT `Impl(Fn(...))` for a closure param),
          // used below to keep a closure param CALLABLE during body eval.
          decl_param_types := match(func_type, .Func({ param_types : dpt }) => dpt, _ => ArrayList(TypeValue).new());
          (rbp_i : usize) = usize(0);
          n_rbp := params.len();
          while(rbp_i < n_rbp, {
            p_label := match(params.get(rbp_i), .Some(l) => l, .None => String.from(""));
            // Explicit `comptime(K) : Type` param: already bound COMPILE-TIME
            // to the arg's value by the early-binding loop above (before the
            // return-type re-eval) — skip the runtime-placeholder machinery.
            sp_rbp_ct := match(spec_param_ct_flags.get(rbp_i), .Some(f) => f, .None => false);
            if(sp_rbp_ct, {
              rbp_i = (rbp_i + usize(1));
              continue;
            });
            cur_is_folded_const := {
              pvars := get_variables_from_env(callee_env, p_label);
              npv := pvars.len();
              cond(
                (npv == usize(0)) => false,
                true => match(
                  pvars.get(npv - usize(1)),
                  .Some(pv) => match(pv.value.get(usize(0)), .Some(vv) => !(is_unknown_val(vv)), .None => false),
                  .None => false
                )
              )
            };
            // For a CLOSURE param (declared `Impl(Fn(...))`, a SomeT), the runtime
            // placeholder MUST be bound to that SomeT — NOT to runtime_param_tys[i]
            // (the concrete capture struct) — so the body's `cb(x)` stays a
            // CALLABLE closure call (a bare capture-struct value is not callable,
            // so `cb(x)` would fail to evaluate and codegen would see no ExprInfo).
            // This rebind is UNCONDITIONAL for closure params (try_to_call already
            // binds them to UnknownVal(captureStruct), so the folded-const gate
            // below would otherwise skip them). Register the capture struct as the
            // SomeT's resolved concrete so get_type_string(SomeT) lowers to it
            // (utils/index.yo:760).
            decl_pt := match(decl_param_types.get(rbp_i), .Some(t) => t, .None => TypeValue.Unit);
            // Prefer the CALL's resolved parameter type over the pristine
            // declared one. TS's parameter object is mutated in place by the
            // closure's return rewrite (anonymous-function.ts:1010-1012), so by
            // the time it specializes, the declared type ALREADY reads
            // `Impl(Fn(a : i32) -> Option(i32))`. yo-self's declared type stays
            // def-era, and rebuilding the closure param from it re-installed
            // `-> Option(B)`: the spec body then typed `f(value)` with the
            // def-era instance and codegen had no C type for it (the
            // Option/Result-combinator family's last layer). Only taken when the
            // resolved type still carries an Fn-trait carrier, so the
            // capture-struct rebuild below is unaffected.
            match(
              arg_values.args.get(rbp_i),
              .Some(rp_ae) => if(match(rp_ae.parameter_type, .SomeT({ id : _ }) => extract_fn_trait_from_type(rp_ae.parameter_type).is_some(), _ => false), {
                decl_pt = rp_ae.parameter_type;
              }),
              .None => ()
            );
            closure_some_id := match(
              decl_pt,
              .SomeT({ id : sid }) => match(extract_fn_trait_from_type(decl_pt), .Some(_) => sid, .None => String.from("")),
              _ => String.from("")
            );
            is_closure_param := (closure_some_id.len() > usize(0));
            // FUTURE-wrapper param (`task : Impl(Future(T, E))`): register
            // the DECLARED wrapper's id → the ARG's wrapper type, so
            // get_type_string on the spec's param chains through the arg
            // wrapper's async-block registration to the concrete sm struct
            // (the closure capbind's analog for futures). Without this the
            // spec's param stays an unresolvable SomeT, the emission gate
            // skips the fn, and every call site degrades to the statement
            // FTT (async_await arm 72: `test_unwind(task, io)`).
            if(!(is_closure_param), {
              match(
                decl_pt,
                .SomeT({ id : fw_id }) => if(extract_future_trait_from_type(decl_pt).is_some(), {
                  match(
                    runtime_param_tys.get(rbp_i),
                    .Some(fw_arg) => if(is_some_type(fw_arg) && (
                      match(fw_arg, .SomeT({ id : fw_aid }) => (fw_aid != fw_id), _ => false)
                    ), {
                      register_some_resolved_concrete(fw_id.clone(), fw_arg);
                    }),
                    .None => ()
                  );
                }),
                _ => ()
              );
            });
            if(is_closure_param, {
              // Bind the param to a PER-SPEC REBUILD of the declared SomeT
              // (fresh id + own resolved cell seeded with THIS spec's capture
              // struct) — never the shared declared SomeT. The declared SomeT
              // is ONE lineage across every specialization of this function
              // (the HAZARD note on SomeT.resolved_concrete): registering the
              // capture on the SHARED id let the LAST specialization win
              // globally, so an EARLIER spec's emitted body resolved `cb` to
              // the wrong capture — spec-1 of Thread.spawn malloc'd closure-2's
              // capture struct and its spawn wrapper called closure-2 (the
              // arc/prelude capture-split repro,
              // issues/repros/arc-spawn-capture-split.yo). The rebuild keeps
              // the fn-trait constraints so the body's `cb(x)` stays CALLABLE.
              // The shared-id registration is kept too (last-write, as before)
              // for consumers that resolve the DECLARED param type rather than
              // the bound variable's.
              (bind_pt_cl : TypeValue) = decl_pt.clone();
              // cap_ty must be the CAPTURE STRUCT. On the try_to_call path the
              // arg_type already IS it (the closure eval recorded capture_type
              // on the arg's ExprInfo); on the FuncVal-arm path the arg_type is
              // the plain `fn(...) -> U` Func — fall back to the closure's
              // registered capture info (keyed by the arg FuncVal's fid), else
              // the body's `cb(x)` resolves to a Func and the closure-call map
              // misses (the fn-pointer-cast fallback, red cluster 3).
              (cap_ty_fixed : Option(TypeValue)) = runtime_param_tys.get(rbp_i);
              match(
                cap_ty_fixed,
                .Some(ct_probe) => if(!(
                  match(ct_probe, .Struct({ id : _ }) => true, _ => false)
                ), {
                  match(
                    arg_values.args.get(rbp_i),
                    .Some(cb_ae2) => match(
                      cb_ae2.value,
                      .Some(cb_v2) => match(
                        cb_v2,
                        .FuncVal(cb_fvd2, _) => match(
                          get_closure_capture_info(cb_fvd2.*.func_id.clone()),
                          .Some(cb_ci2) => {
                            cap_ty_fixed = Option(TypeValue).Some(cb_ci2.capture_type);
                          },
                          .None => ()
                        ),
                        _ => ()
                      ),
                      .None => ()
                    ),
                    .None => ()
                  );
                }),
                .None => ()
              );
              match(
                cap_ty_fixed,
                // A still-ABSTRACT cap_ty (a SomeT — the forwarded-param
                // mint where no concrete capture is determinable) must NOT
                // rebuild or register: `register_some_resolved_concrete(id,
                // SomeT(id))` created a SELF-LOOP entry, and SomeT→SomeT
                // chains poisoned every later render of the shared declared
                // id (the def-era spec's param flipping void*→concrete
                // depending on registration order — the stage-2 dyn-capture
                // cluster). Bind the declared type instead; the resolved-era
                // mints (arg resolves to the concrete capture via
                // _spec_resolve_arg_ty) rebuild as before.
                .Some(cap_ty) => if(!(is_some_type(cap_ty)), {
                  fresh_some_id := `${closure_some_id}_capbind_${type_key(cap_ty)}`;
                  match(
                    decl_pt,
                    .SomeT(
                      _,
                      sp_nm_c,
                      sp_fl_c,
                      sp_pt_c,
                      sp_rtt_c,
                      sp_rtl_c,
                      sp_ntt_c,
                      sp_ntl_c,
                      sp_ier_c,
                      sp_kft_c,
                      _
                    ) => {
                      bind_pt_cl = TypeValue.SomeT(
                        fresh_some_id.clone(),
                        sp_nm_c,
                        sp_fl_c,
                        sp_pt_c,
                        sp_rtt_c,
                        sp_rtl_c,
                        sp_ntt_c,
                        sp_ntl_c,
                        sp_ier_c,
                        sp_kft_c,
                        t_resolved_cell(cap_ty)
                      );
                    },
                    _ => ()
                  );
                  register_some_resolved_concrete(fresh_some_id.clone(), cap_ty);
                  register_some_resolved_concrete(closure_some_id.clone(), cap_ty);
                }),
                .None => ()
              );
              _rbc := add_variable_to_env(
                callee_env,
                p_label,
                bind_pt_cl.clone(),
                Option(EvalValue).Some(create_unknown_val(bind_pt_cl)),
                false,
                false,
                false,
                false,
                synthetic_token(p_label, callee_env.module_path)
              );
              // Parameter re-bind — flag it (see above).
              match(
                _rbc,
                .Some(rbc_var) => {
                  rbc_var.is_parameter = true;
                },
                .None => ()
              );
            }, if(cur_is_folded_const, {
              match(
                runtime_param_tys.get(rbp_i),
                .Some(p_ty) => {
                  _rb := add_variable_to_env(
                    callee_env,
                    p_label,
                    p_ty,
                    Option(EvalValue).Some(create_unknown_val(p_ty)),
                    false,
                    // is_compile_time_only — runtime parameter
                    false,
                    false,
                    false,
                    synthetic_token(p_label, callee_env.module_path)
                  );
                  // Parameter re-bind — flag it (see above).
                  match(
                    _rb,
                    .Some(rb_var) => {
                      rb_var.is_parameter = true;
                    },
                    .None => ()
                  );
                },
                .None => ()
              );
            }));
            rbp_i = (rbp_i + usize(1));
          });
          // CLONE the body with FRESH ids for this specialization. Each
          // specialization of a generic function must own its body AST: codegen
          // walks the body per-node and reads per-node ExprInfo / side-tables
          // (e.g. `g_method_callee_values` for a `v.to_string()` method
          // dispatch). If every specialization shared the ORIGINAL body nodes,
          // the LAST specialization's body eval would overwrite each node's
          // entry — so `println<str>` and `println<i32>`, sharing one body, both
          // emitted a call to the i32 `to_string` (the str call printed garbage).
          // A fresh-id clone gives each specialization independent nodes. Mirrors
          // TS specializeFunction (`cloneExpr` of the body). The specialized
          // FuncVal below carries this clone so codegen walks the right nodes.
          cloned_body := clone_expr_fresh_ids(body);
          // Set `ctx.self_type` to the concrete receiver so `Self` — and
          // especially `Self.static_method` like HashMap's
          // `Self._find_bucket(self, ...)` — resolves inside the specialized
          // method body. TS evaluates the specialized body with `{ ...context }`
          // (helper.ts:2434), and the method-dispatch caller has already set
          // `context.SelfType` (carried from the method's `functionType.SelfType`).
          // yo-self's dispatch doesn't thread self_type to this point and `Func`
          // carries no SelfType field, so reconstruct it from the bound `self`
          // parameter — its type IS the concrete receiver. Scoped: saved here and
          // restored in the context-restore block below (handles nested
          // specializations, where each method's body must see its own receiver).
          prev_self_type_spec := ctx.self_type;
          (spec_self_set : bool) = false;
          // Prefer the actual RECEIVER ARGUMENT's type over the `self` param's
          // DECLARED type. During def-time signature eval the declared `Self` can
          // be a freshly-MINTED shell instance of the generic (e.g. a SECOND
          // `ArrayList(String)` struct id distinct from the call-site's), whose
          // nested specializations (`Self.with_capacity` → `(*(T))(_ptr)`) fail —
          // see issues/yo-self-p1-transpile-tail.md. The call argument carries the
          // real, complete receiver struct, so resolve `Self` to it.
          if(params.len() > usize(0), {
            is_self_first := match(params.get(usize(0)), .Some(l) => (l == "self"), .None => false);
            if(is_self_first, {
              match(
                arg_values.args.get(usize(0)),
                .Some(rcv_ae) => {
                  ctx.self_type = Option(TypeValue).Some(rcv_ae.arg_type);
                  spec_self_set = true;
                },
                .None => ()
              );
            });
          });
          if(!(spec_self_set), {
            spec_self_vars := get_variables_from_env(callee_env, String.from("self"));
            if(spec_self_vars.len() > usize(0), {
              match(
                spec_self_vars.get(spec_self_vars.len() - usize(1)),
                .Some(spec_self_v) => {
                  ctx.self_type = Option(TypeValue).Some(spec_self_v.ty);
                },
                .None => ()
              );
            });
          });
          // Evaluate the function body in the specialized environment.
          // Uses the already-built callee_env (which has all type params and
          // regular params bound from try_to_call_function_with_arguments steps 4–11).
          // Thread the fn's where-constraint trait ids to the overload
          // selector for the duration of the spec body eval (see
          // expr_info.yo g_active_where_trait_ids — the use_trait_b
          // disambiguation).
          spec_where_ids := ArrayList(String).new();
          {
            spec_wes := get_func_where_constraints(func_id.clone());
            (swi : usize) = usize(0);
            while(swi < spec_wes.len(), {
              match(
                spec_wes.get(swi),
                .Some(swe) => {
                  swe_id := match(swe.trait_ty, .TraitT(_, _, _, _, swe_tid, _, _, _, _, _) => swe_tid, _ => String.from(""));
                  if(swe_id != "", {
                    spec_where_ids.push(swe_id);
                  });
                },
                .None => ()
              );
              swi = (swi + usize(1));
            });
            // `where(T <: Trait)` constraints usually live on the forall
            // SomeT's required_trait_types (not the side table) — collect
            // those too, from the fn type's forall + param SomeTs.
            spec_all_sts := get_all_some_types(func_type);
            (sws_i : usize) = usize(0);
            while(sws_i < spec_all_sts.len(), {
              match(
                spec_all_sts.get(sws_i),
                .Some(sws_t) => match(
                  sws_t,
                  .SomeT({ required_trait_types : sws_rtt }) => {
                    (sws_ri : usize) = usize(0);
                    while(sws_ri < sws_rtt.len(), {
                      match(
                        sws_rtt.get(sws_ri),
                        .Some(sws_tr) => {
                          sws_tid := match(sws_tr, .TraitT(_, _, _, _, sws_tid0, _, _, _, _, _) => sws_tid0, _ => String.from(""));
                          if(sws_tid != "", {
                            spec_where_ids.push(sws_tid);
                          });
                        },
                        .None => ()
                      );
                      sws_ri = (sws_ri + usize(1));
                    });
                  },
                  _ => ()
                ),
                .None => ()
              );
              sws_i = (sws_i + usize(1));
            });
          };
          push_active_where_trait_ids(spec_where_ids);
          specialized_body := evaluate_begin_expression(
            cloned_body,
            callee_env,
            ctx,
            ArrayList(Variable).new(),
            true,
            exn
          );
          pop_active_where_trait_ids();
          // Snapshot the closure-spec capture recording BEFORE restoring.
          spec_recorded_caps := if(spec_is_closure, ctx.captured_variables, Option(HashMap(String, CapturedVarInfo)).None);
          // Restore context
          ctx.self_type = prev_self_type_spec;
          ctx.function_return_impl_concrete_type = prev_fri;
          ctx.expected_type = prev_expected;
          ctx.is_evaluating_loop_body = prev_loop;
          ctx.captured_variables = prev_caps;
          ctx.is_evaluating_function_body_or_async_block = prev_fb;
          ctx.currently_specializing_function = prev_spec;
          // Pop this specialization off the full stack (pushed at the set site above).
          spec_stack_r := match(
            ctx.currently_specializing_function_stack,
            .Some(s) => s,
            .None => ArrayList(SpecializingFunctionInfo).new()
          );
          spec_stack_r.pop();
          ctx.currently_specializing_function_stack = Option(ArrayList(SpecializingFunctionInfo)).Some(spec_stack_r);
          // CLOSURE spec: build + register the capture struct from what THIS
          // body eval recorded — the deferred-generic closure skipped its
          // definition-time collection, so this is its only capture source
          // (mirrors anonymous_function.yo:1140-1162's post-eval sequence).
          match(
            spec_recorded_caps,
            .Some(rec_caps) => if(spec_is_closure && (rec_caps.len() > usize(0)), {
              enr_caps := enrich_captured_variables(rec_caps, callee_env);
              if(enr_caps.len() > usize(0), {
                spec_cap_res := create_capture_type_and_value(
                  Option(TypeValue).None,
                  Option(HashMap(String, FuncCapturedVarInfo)).Some(enr_caps),
                  callee_env,
                  synthetic_token(specialized_func_id.clone(), callee_env.module_path)
                );
                match(
                  spec_cap_res.capture_type,
                  .Some(spec_ct) => register_closure_capture_info(
                    specialized_func_id.clone(),
                    ClosureCaptureInfo(capture_type : spec_ct, frame_level : callee_env.frames.len())
                  ),
                  .None => ()
                );
              });
            }),
            .None => ()
          );
          // Build updated captures from the specialized callee_env.
          // This ensures the specialized function "closes over" the bound
          // compile-time values (generic type params, given handlers, etc.)
          // so codegen can inline them without extra lookups.
          new_cap_names := ArrayList(String).new();
          new_cap_tys := ArrayList(TypeValue).new();
          new_cap_vals := ArrayList(EvalValue).new();
          // Re-use existing captures from original function
          (oci : usize) = usize(0);
          n_oc := cap_names.len();
          while(oci < n_oc, {
            cn := match(cap_names.get(oci), .Some(s) => s, .None => String.new());
            ct := match(cap_tys.get(oci), .Some(t) => t, .None => t_unit());
            cv := match(cap_vals.get(oci), .Some(v) => v, .None => EvalValue.UnitVal);
            new_cap_names.push(cn);
            new_cap_tys.push(ct);
            new_cap_vals.push(cv);
            oci = (oci + usize(1));
          });
          // Add compile-time args as additional captures (generic type bindings)
          (fai2 : usize) = usize(0);
          n_fl := match(func_type, .Func({ meta : __fm3 }) => __fm3.*.forall_labels.len(), _ => usize(0));
          while(fai2 < n_fl, {
            label := match(
              func_type,
              .Func({ meta : __fm4 }) => {
                fl := __fm4.*.forall_labels;
                r := match(fl.get(fai2), .Some(s) => s, .None => String.new());
                r
              },
              _ => String.new()
            );
            env_vars := get_variables_from_env(callee_env, label);
            n_ev := env_vars.len();
            if(n_ev > usize(0), {
              match(
                env_vars.get(n_ev - usize(1)),
                .Some(ev) => {
                  match(
                    ev.value.get(usize(0)),
                    .Some(v) => {
                      new_cap_names.push(label);
                      new_cap_tys.push(ev.ty);
                      new_cap_vals.push(v);
                    },
                    .None => ()
                  );
                },
                .None => ()
              );
            });
            fai2 = (fai2 + usize(1));
          });
          // Evaluate the specialized body to get its return type
          specialized_body;
          // Create the specialized function value — carries the fresh-id CLONE
          // (not the shared original body) so codegen walks this specialization's
          // own nodes and reads its own per-node ExprInfo / method-callee entries.
          specialized_func_val := EvalValue.FuncVal(
            box(
              FuncValData(
                forall_names : forall_names,
                params : params,
                param_type_names : param_type_names,
                evidence_params : evidence_params,
                body : cloned_body,
                cap_names : new_cap_names,
                cap_tys : new_cap_tys,
                func_id : specialized_func_id
              )
            ),
            new_cap_vals
          );
          // Register the SPECIALIZED Func TYPE under the specialized func_id so
          // codegen's get_func_type(specialized_func_id) returns concrete
          // param/return types (generic dropped) instead of the generic
          // `generic(T) …` whose SomeT crashes get_type_string (Gap 6). Mirrors
          // TS `specializedType`.
          match(
            func_type,
            .Func({
              param_types : sp_pt,
              implicit_types : sp_it,
              where_types : sp_wt,
              result : sp_res_b,
              meta : __fm5
            }) => {
              (sp_pl : ArrayList(String)) = __fm5.*.param_labels;
              // The spec's C params must be named after the FuncVal's OWN
              // (source) labels — the body references those. `func_type` here
              // can be the DECLARED variable's type whose labels differ:
              // `comptime(id) : (fn(comptime(T) : Type, x : T) -> T)` assigned
              // `id = ((T, a) -> a)` emitted `bool ...(bool x) { return a; }`
              // (clang: undeclared identifier). TS keeps the anon fn's
              // original names on FunctionValue.type
              // (function-type.ts:388-391 "the function body uses the
              // original parameter names").
              if(params.len() == sp_pl.len(), {
                sp_pl = params.clone();
              });
              sp_il := __fm5.*.implicit_labels;
              sp_isp := __fm5.*.implicit_spreads;
              sp_rico := __fm5.*.result_is_comptime_only;
              sp_pir := __fm5.*.param_is_ref;
              sp_pio := __fm5.*.param_is_owning;
              sp_rir := __fm5.*.result_is_ref;
              sp_hv := __fm5.*.has_variadic;
              sp_ie := __fm5.*.is_extern;
              sp_en := __fm5.*.extern_name;
              sp_ic := __fm5.*.is_control;
              (spec_param_types : ArrayList(TypeValue)) = ArrayList(TypeValue).new();
              (spi : usize) = usize(0);
              while(spi < runtime_param_tys.len(), {
                // Explicit `comptime(K) : Type` params are NOT C parameters:
                // TS's specializedType keeps only runtimeParameters
                // (helper.ts:2218-2255). Skip them here — and filter the
                // per-param meta arrays identically below — so the registered
                // spec type's C signature carries runtime params only. The
                // call site drops the matching args (function.yo's
                // runtime_arg_exprs gate), keeping arity in agreement.
                sp_spi_ct := match(spec_param_ct_flags.get(spi), .Some(f) => f, .None => false);
                if(sp_spi_ct, {
                  spi = (spi + usize(1));
                  continue;
                });
                rpt := match(runtime_param_tys.get(spi), .Some(t) => t, .None => t_unit());
                // Prefer the RESOLVED DECLARED param type when it is concrete
                // and the ARG type degenerated to unit: TS's specializedType
                // params come from the declared parameters (+ substitutions),
                // never from arg types, so a degenerate analysis-pass arg
                // (open-module member soft-fail → UnknownVal → unit) cannot
                // poison the registered spec type. yo-self keeps the arg type
                // as the general source (Phase 3 design: it carries the
                // call-site concretization for generic params) and falls back
                // to the declared type ONLY for the poisoned shape — a
                // unit-typed arg against a concrete non-unit declared param
                // (`assert(flag : bool, ...)` emitted `void flag`;
                // issues/repros/void-param-assert-open-env.yo).
                declared_pt := match(sp_pt.get(spi), .Some(t) => t, .None => t_unit());
                // CLOSURE param: type the spec's param as the closure's
                // CAPTURE STRUCT (the TS convention — the wrapper SomeType's
                // resolvedConcreteType is the capture struct; yo-self's
                // registry equivalent is get_closure_capture_info). A plain
                // Func type here emits an `int32_t (*)(int32_t)` C param that
                // the call site's capture-struct argument cannot satisfy
                // (red cluster 3 / the closure-forall emission residual).
                (closure_cap_ty : Option(TypeValue)) = Option(TypeValue).None;
                match(
                  arg_values.args.get(spi),
                  .Some(cc_ae) => match(
                    cc_ae.value,
                    .Some(cc_v) => match(
                      cc_v,
                      .FuncVal(cc_fvd, cc_capvals) => {
                        match(
                          get_closure_capture_info(cc_fvd.*.func_id.clone()),
                          .Some(cc_info) => {
                            closure_cap_ty = Option(TypeValue).Some(cc_info.capture_type);
                          },
                          .None => ()
                        );
                        // MINT-SIDE closure-type re-registration (the eval-order
                        // wall workaround; issues/yo-self-closure-void-param-
                        // where-clause.md): a closure passed to a where-clause-
                        // constrained `f : F` param is CREATED before the
                        // foralls bind (yo-self evaluates all args first), so
                        // its registered type keeps the no-expected placeholder
                        // params (`fn(x : x) -> _ret`) and the C signature
                        // emits `void*`. TS types it contextually at check time
                        // with `A := i32` already bound. HERE the mint env has
                        // the bindings: when the current registration still
                        // carries SomeT params, pull the declared param F's Fn
                        // trait (its own required traits, then the callee-env
                        // where-clause), resolve each trait param/result
                        // through callee_env, and re-register the closure's
                        // type with the concrete signature — REBUILDING from
                        // the existing registration's meta (t_func_simple
                        // would drop the flags).
                        cw_fid := cc_fvd.*.func_id.clone();
                        cw_cur := get_func_type(cw_fid.clone());
                        (cw_cur_generic : bool) = false;
                        match(
                          cw_cur,
                          .Func({ param_types : cw_cur_pt, result : cw_cur_ret }) => {
                            if(get_all_some_types(cw_cur_ret).len() > usize(0), {
                              cw_cur_generic = true;
                            });
                            (cw_gi : usize) = usize(0);
                            while(cw_gi < cw_cur_pt.len(), {
                              match(
                                cw_cur_pt.get(cw_gi),
                                .Some(cw_gt) => if(get_all_some_types(cw_gt).len() > usize(0), {
                                  cw_cur_generic = true;
                                }),
                                .None => ()
                              );
                              cw_gi = (cw_gi + usize(1));
                            });
                          },
                          _ => ()
                        );
                        if(cw_cur_generic && is_some_type(declared_pt), {
                          match(
                            extract_fn_trait_from_type(declared_pt),
                            .Some(cw_ftt) => match(
                              cw_ftt,
                              .FnTraitT(_, _, cw_cpt, cw_cres, _, _, _, _) => {
                                // Resolve the trait's generic occurrences by
                                // NAME + OCCURRENCE-LEVEL from the inferred
                                // forall_args (the ys_ret-bridge pattern):
                                // env NAME resolution cannot see the trait's
                                // own `A` copy (Gap-6 lineage split — measured
                                // `A := i32` present in forall_args while
                                // evaluate_..._again left `A` unresolved).
                                cw_s := subst_new();
                                (cw_oi : usize) = usize(0);
                                while(cw_oi < cw_cpt.len(), {
                                  cw_ot := match(cw_cpt.get(cw_oi), .Some(x) => x, .None => t_unit());
                                  cw_occ := get_all_some_types(cw_ot);
                                  (cw_oj : usize) = usize(0);
                                  while(cw_oj < cw_occ.len(), {
                                    match(
                                      cw_occ.get(cw_oj),
                                      .Some(cw_st) => match(
                                        cw_st,
                                        .SomeT(_, cw_st_nm, cw_st_lvl, _, _, _, _, _, _, _, _) => {
                                          (cw_bi : usize) = usize(0);
                                          while(cw_bi < forall_names.len(), {
                                            cw_bn := match(forall_names.get(cw_bi), .Some(n) => n, .None => String.new());
                                            if((cw_bn == cw_st_nm) && (cw_bi < arg_values.forall_args.len()), {
                                              match(
                                                arg_values.forall_args.get(cw_bi),
                                                .Some(cw_fae) => match(
                                                  cw_fae.value,
                                                  .Some(cw_fav) => match(
                                                    cw_fav,
                                                    .TypeVal(cw_fat) => if((!(is_some_type(cw_fat))) && (get_all_some_types(cw_fat).len() == usize(0)), {
                                                      subst_add(cw_s, cw_st_nm.clone(), cw_st_lvl, cw_fat.clone());
                                                    }),
                                                    _ => ()
                                                  ),
                                                  .None => ()
                                                ),
                                                .None => ()
                                              );
                                            });
                                            cw_bi = (cw_bi + usize(1));
                                          });
                                        },
                                        _ => ()
                                      ),
                                      .None => ()
                                    );
                                    cw_oj = (cw_oj + usize(1));
                                  });
                                  cw_oi = (cw_oi + usize(1));
                                });
                                cw_new_pts := ArrayList(TypeValue).new();
                                (cw_all_conc : bool) = true;
                                (cw_pi : usize) = usize(0);
                                while(cw_pi < cw_cpt.len(), {
                                  cw_pt0 := match(cw_cpt.get(cw_pi), .Some(x) => x, .None => t_unit());
                                  cw_pt_res := substitute(cw_s, cw_pt0);
                                  if(get_all_some_types(cw_pt_res).len() > usize(0), {
                                    cw_all_conc = false;
                                  });
                                  cw_new_pts.push(cw_pt_res);
                                  cw_pi = (cw_pi + usize(1));
                                });
                                cw_ret_res := substitute(cw_s, cw_cres);
                                if(get_all_some_types(cw_ret_res).len() > usize(0), {
                                  cw_all_conc = false;
                                });
                                if(cw_all_conc, {
                                  match(
                                    cw_cur,
                                    .Func({
                                      forall_types : cw_fts,
                                      implicit_types : cw_its,
                                      where_types : cw_wts,
                                      meta : cw_fm
                                    }) => {
                                      register_func_type(
                                        cw_fid.clone(),
                                        TypeValue.Func(cw_fts, cw_new_pts, cw_its, cw_wts, cw_ret_res, cw_fm, ArrayList(TypeValue).new())
                                      );
                                    },
                                    _ => ()
                                  );
                                  // RE-EVALUATE the closure body under the now-
                                  // concrete parameter types: the creation-time
                                  // eval ran with the placeholder params (the
                                  // mark_closure_for_codegen carve-out forces
                                  // body eval even for SomeT params), so the
                                  // body's ExprInfos reference placeholder-era
                                  // specs (`out.push(x)` keyed on the
                                  // unresolved copy — the undeclared-function
                                  // residual). Same trial-eval swallow shape as
                                  // _trial_eval_fn_body; the body nodes are the
                                  // ORIGINAL ones codegen walks, so the fresh
                                  // infos overwrite the stale ones in place.
                                  cw_benv := Environment.new(callee_env.module_path);
                                  (cw_cvi : usize) = usize(0);
                                  while(cw_cvi < cc_fvd.*.cap_names.len(), {
                                    cw_cn := match(cc_fvd.*.cap_names.get(cw_cvi), .Some(x) => x, .None => String.new());
                                    cw_ct := match(cc_fvd.*.cap_tys.get(cw_cvi), .Some(x) => x, .None => t_unit());
                                    // TYPE captures (generic bindings) stay
                                    // comptime; VALUE captures bind as RUNTIME
                                    // UnknownVals — binding their comptime
                                    // values made the re-evaluated body's
                                    // reads comptime and codegen emitted
                                    // `/* skip generating value */` for the
                                    // receiver argument.
                                    (cw_cv : Option(EvalValue)) = Option(EvalValue).Some(EvalValue.UnknownVal(cw_ct.clone(), true));
                                    (cw_has_cv : bool) = false;
                                    match(
                                      cc_capvals.get(cw_cvi),
                                      .Some(x) => match(
                                        x,
                                        .TypeVal(_) => {
                                          cw_cv = Option(EvalValue).Some(x);
                                          cw_has_cv = true;
                                        },
                                        _ => ()
                                      ),
                                      .None => ()
                                    );
                                    _cwa := add_variable_to_env(
                                      cw_benv,
                                      cw_cn,
                                      cw_ct,
                                      cw_cv,
                                      cw_has_cv,
                                      false,
                                      false,
                                      false,
                                      synthetic_token(cw_cn, callee_env.module_path)
                                    );
                                    cw_cvi = (cw_cvi + usize(1));
                                  });
                                  _cwf := cw_benv.push_frame(false);
                                  (cw_pvi : usize) = usize(0);
                                  while(cw_pvi < cc_fvd.*.params.len(), {
                                    cw_pn := match(cc_fvd.*.params.get(cw_pvi), .Some(x) => x, .None => String.new());
                                    cw_pt2 := match(cw_new_pts.get(cw_pvi), .Some(x) => x, .None => t_unit());
                                    _cwp := add_variable_to_env(
                                      cw_benv,
                                      cw_pn,
                                      cw_pt2,
                                      Option(EvalValue).Some(EvalValue.UnknownVal(cw_pt2.clone(), true)),
                                      false,
                                      false,
                                      false,
                                      false,
                                      synthetic_token(cw_pn, callee_env.module_path)
                                    );
                                    // Parameter bind — flag it (see the
                                    // check_if_function_parameter_matches_argument bind).
                                    match(
                                      _cwp,
                                      .Some(cwp_var) => {
                                        cwp_var.is_parameter = true;
                                      },
                                      .None => ()
                                    );
                                    cw_pvi = (cw_pvi + usize(1));
                                  });
                                  _reeval_closure_body_swallow(cc_fvd.*.body, cw_benv, ctx);
                                });
                              },
                              _ => ()
                            ),
                            .None => ()
                          );
                        });
                      },
                      _ => ()
                    ),
                    .None => ()
                  ),
                  .None => ()
                );
                use_ty := match(
                  closure_cap_ty,
                  .Some(cc_t) => cc_t,
                  .None => if(is_unit_type(rpt) && !(is_unit_type(declared_pt)), {
                    resolved_decl := evaluate_function_parameter_type_again(declared_pt, callee_env, ctx);
                    if(type_contains_some_type(resolved_decl) || is_unit_type(resolved_decl), rpt, resolved_decl)
                  }, rpt)
                );
                spec_param_types.push(
                  convert_comptime_type_to_runtime_type_with_expected(_bake_record_slots(use_ty), Option(TypeValue).None, callee_env)
                );
                spi = (spi + usize(1));
              });
              (spec_result : TypeValue) = evaluate_function_return_type_again(sp_res_b, callee_env, ctx);
              // Keep the REGISTERED return in the same lineage as the
              // pre-body-eval adoption above — the expected type the body was
              // checked against and the registered C return type must agree.
              if(rte_adopted, {
                spec_result = spec_ret_ty.clone();
              });
              // Same subst-by-occurrence as spec_ret_ty above: the env NAME
              // binding cannot resolve the SomeT copy inside `List(U)`.
              // Collect occurrences from the RETURN and every PARAM type —
              // the closure param's `fn(a : i32) -> U` carries its own `U`
              // copy at its own level, and an unsubstituted param trips
              // emission's _func_has_generic_params gate just like the
              // return trips has_generic_return.
              if((get_all_some_types(spec_result).len() > usize(0)) || {
                (yp_probe : bool) = false;
                (ypi0 : usize) = usize(0);
                while((ypi0 < spec_param_types.len()) && !(yp_probe), {
                  match(
                    spec_param_types.get(ypi0),
                    .Some(ypt0) => if(get_all_some_types(ypt0).len() > usize(0), {
                      yp_probe = true;
                    }),
                    .None => ()
                  );
                  ypi0 = (ypi0 + usize(1));
                });
                yp_probe
              }, {
                y_somes := get_all_some_types(sp_res_b);
                {
                  (ypc : usize) = usize(0);
                  while(ypc < spec_param_types.len(), {
                    match(
                      spec_param_types.get(ypc),
                      .Some(ypt) => {
                        yp_found := get_all_some_types(ypt);
                        (ypf : usize) = usize(0);
                        while(ypf < yp_found.len(), {
                          match(
                            yp_found.get(ypf),
                            .Some(yps) => {
                              y_somes.push(yps);
                            },
                            .None => ()
                          );
                          ypf = (ypf + usize(1));
                        });
                      },
                      .None => ()
                    );
                    ypc = (ypc + usize(1));
                  });
                };
                ys_ret := subst_new();
                (ys_any : bool) = false;
                ys_added_names := ArrayList(String).new();
                (yrsi : usize) = usize(0);
                while(yrsi < y_somes.len(), {
                  yrst := match(y_somes.get(yrsi), .Some(t) => t, .None => t_unit());
                  match(
                    yrst,
                    .SomeT(_, yrst_name, yrst_lvl, _, _, _, _, _, _, _, _) => {
                      (ybni : usize) = usize(0);
                      while(ybni < forall_names.len(), {
                        ybn := match(forall_names.get(ybni), .Some(n) => n, .None => String.from(""));
                        if((ybn == yrst_name) && (ybni < arg_values.forall_args.len()), {
                          match(
                            arg_values.forall_args.get(ybni),
                            .Some(yae) => match(
                              yae.value,
                              .Some(yv) => match(
                                yv,
                                .TypeVal(ytb) => if(!(is_some_type(ytb)), {
                                  subst_add(ys_ret, yrst_name.clone(), yrst_lvl, ytb.clone());
                                  ys_added_names.push(yrst_name.clone());
                                  ys_any = true;
                                }),
                                _ => ()
                              ),
                              .None => ()
                            ),
                            .None => ()
                          );
                        });
                        ybni = (ybni + usize(1));
                      });
                    },
                    _ => ()
                  );
                  yrsi = (yrsi + usize(1));
                });
                // Declared-param bridge — the value-semantics equivalent of
                // TS's shared resolvedConcreteType identity. When the forall
                // binding itself is an unresolved SomeT (e.g. box's V bound
                // to the Impl-Fn wrapper), the loop above harvests nothing,
                // but a declared param that IS that bare SomeT (`own(value)
                // : V`) pairs positionally with the spec's CONCRETE param
                // type (the closure capture struct resolved above). In TS
                // the same information flows through object identity: the
                // wrapper SomeType's resolvedConcreteType is set once and
                // seen everywhere, including inside the specialized return.
                (ydb : usize) = usize(0);
                while(ydb < sp_pt.len(), {
                  match(
                    sp_pt.get(ydb),
                    .Some(ydb_dt) => match(
                      ydb_dt,
                      .SomeT(_, ydb_nm, ydb_lvl, _, _, _, _, _, _, _, _) => {
                        // ONLY true forall binders: the declared SomeT's name
                        // must be one of this function's generic names. A
                        // WRAPPER param like io.async's `action : Impl(Fn(e :
                        // E) -> T)` is a SomeT NAMED "" — pairing it would
                        // substitute the equally-""-named `Impl(Future(T,E))`
                        // RETURN wrapper with the capture struct, corrupting
                        // the async spec type (walker async-emitter SIGSEGV,
                        // pointer = ASCII "esac    ").
                        (ydb_is_forall : bool) = false;
                        if(ydb_nm.len() > usize(0), {
                          (ydb_f : usize) = usize(0);
                          while((ydb_f < forall_names.len()) && !(ydb_is_forall), {
                            match(
                              forall_names.get(ydb_f),
                              .Some(fnm) => if(fnm == ydb_nm, {
                                ydb_is_forall = true;
                              }),
                              .None => ()
                            );
                            ydb_f = (ydb_f + usize(1));
                          });
                        });
                        (ydb_seen : bool) = !(ydb_is_forall);
                        (ydb_k : usize) = usize(0);
                        while(ydb_k < ys_added_names.len(), {
                          match(
                            ys_added_names.get(ydb_k),
                            .Some(an) => if(an == ydb_nm, {
                              ydb_seen = true;
                            }),
                            .None => ()
                          );
                          ydb_k = (ydb_k + usize(1));
                        });
                        if((!(ydb_seen)) && (ydb < spec_param_types.len()), {
                          match(
                            spec_param_types.get(ydb),
                            .Some(ydb_ct) => {
                              if((get_all_some_types(ydb_ct).len() == usize(0)) && !(is_unit_type(ydb_ct)), {
                                subst_add(ys_ret, ydb_nm.clone(), ydb_lvl, ydb_ct.clone());
                                ys_added_names.push(ydb_nm.clone());
                                ys_any = true;
                              });
                            },
                            .None => ()
                          );
                        });
                      },
                      _ => ()
                    ),
                    .None => ()
                  );
                  ydb = (ydb + usize(1));
                });
                if(ys_any, {
                  spec_result = substitute(ys_ret, sp_res_b);
                  // Rebuild the param list through the same substitution
                  // (ArrayList has no indexed set).
                  y_new_params := ArrayList(TypeValue).new();
                  (ypr : usize) = usize(0);
                  while(ypr < spec_param_types.len(), {
                    match(
                      spec_param_types.get(ypr),
                      .Some(ypt2) => if(get_all_some_types(ypt2).len() > usize(0), {
                        y_new_params.push(substitute(ys_ret, ypt2));
                      }, {
                        y_new_params.push(ypt2);
                      }),
                      .None => ()
                    );
                    ypr = (ypr + usize(1));
                  });
                  spec_param_types = y_new_params;
                });
              });
              // Gap-6 attempt #8(a): a declared-`Self` return resolves through
              // callee_env to the impl's PATTERN-ERA instance (unresolved T#N
              // only in type_arguments — no resolution path concretizes it,
              // issues/retired/yo-self-gap6-ctor-memo-reconciliation-attempt7.md).
              // The RECEIVER ARGUMENT of an instance method carries the
              // call's real concrete instance — adopt it when the ctor
              // matches (TS: SelfType = dereferencedReceiverType makes the
              // signature receiver-canonical natively).
              (sr_recv_ty : Option(TypeValue)) = Option(TypeValue).None;
              sr_is_self_first := match(params.get(usize(0)), .Some(l) => (l == "self"), .None => false);
              if(sr_is_self_first, {
                match(
                  arg_values.args.get(usize(0)),
                  .Some(sr_rcv) => {
                    sr_recv_ty = Option(TypeValue).Some(sr_rcv.arg_type);
                  },
                  .None => ()
                );
              }, {
                // Static method (no `self` param): the dispatcher set
                // ctx.self_type to the concrete static-dot receiver before
                // this specialization (function.yo) — that IS the receiver
                // instance (restored above, so read it directly).
                match(
                  ctx.self_type,
                  .Some(sr_ctx_st) => {
                    sr_recv_ty = Option(TypeValue).Some(sr_ctx_st);
                  },
                  .None => ()
                );
              });
              match(
                sr_recv_ty,
                .Some(sr_rty) => match(
                  adopt_receiver_struct_instance(spec_result, sr_rty),
                  .Some(sr_adopted) => {
                    if(helper_dbg_env.get(`YO_DEBUG_RRE`).is_some(), {
                      eprintln(`[sr-adopt] spec_result=${type_to_string(spec_result)} recv=${type_to_string(sr_rty)} adopted=${type_to_string(sr_adopted)}`);
                    });
                    spec_result = sr_adopted;
                  },
                  .None => ()
                ),
                .None => ()
              );
              // Filter the per-param meta arrays by the same comptime flags as
              // the spec_param_types loop above — labels/is_ref/is_owning must
              // stay index-aligned with the (comptime-filtered) param types.
              (sp_pl_f : ArrayList(String)) = ArrayList(String).new();
              (sp_pir_f : ArrayList(bool)) = ArrayList(bool).new();
              (sp_pio_f : ArrayList(bool)) = ArrayList(bool).new();
              {
                (sp_mi : usize) = usize(0);
                while(sp_mi < sp_pl.len(), {
                  sp_mi_ct := match(spec_param_ct_flags.get(sp_mi), .Some(f) => f, .None => false);
                  if(!(sp_mi_ct), {
                    sp_pl_f.push(match(sp_pl.get(sp_mi), .Some(l) => l, .None => String.new()));
                    sp_pir_f.push(match(sp_pir.get(sp_mi), .Some(b) => b, .None => false));
                    sp_pio_f.push(match(sp_pio.get(sp_mi), .Some(b) => b, .None => false));
                  });
                  sp_mi = (sp_mi + usize(1));
                });
              };
              spec_type := TypeValue.Func(
                ArrayList(TypeValue).new(),
                spec_param_types,
                sp_it,
                sp_wt,
                spec_result,
                box(
                  FuncMeta(
                    forall_labels : ArrayList(String).new(),
                    param_labels : sp_pl_f,
                    implicit_labels : sp_il,
                    implicit_spreads : sp_isp,
                    result_is_comptime_only : sp_rico,
                    param_is_ref : sp_pir_f,
                    param_is_owning : sp_pio_f,
                    result_is_ref : sp_rir,
                    has_variadic : sp_hv,
                    is_extern : sp_ie,
                    extern_name : sp_en,
                    is_control : sp_ic,
                    variadic_label : Option(String).None,
                    variadic_comptime : false
                  )
                ),
                ArrayList(TypeValue).new()
              );
              register_func_type(specialized_func_id.clone(), spec_type);
            },
            _ => ()
          );
          // Detect isControlFunction: set if the original was already a control
          // function OR if the specialized body contains unwind.
          // Mirrors the `isControlFunction: originalFunction.isControlFunction ||
          //   evaluatedBodyContainsEscape(specializedBody)` logic in TypeScript.
          parent_is_ctl := is_control_fn(func_id.clone());
          body_has_unwind := evaluated_body_contains_unwind(specialized_body);
          if(parent_is_ctl || body_has_unwind, {
            mark_as_control_fn(specialized_func_id.clone());
          });
          // Store in cache
          _store_specialization_cache(
            ctx,
            func_id,
            compile_time_args,
            runtime_param_tys,
            specialized_func_val,
            callee_env
          );
          specialized_func_val
        }
      )
    },
    _ => original_func_val
  );
  result
});
// ---------------------------------------------------------------------------
// evaluate_ctl_function_body_inline
// ---------------------------------------------------------------------------
/// Inline-evaluate a control function body to produce a specialized version
/// with the generic type parameter bound to the concrete call-site type.
///
/// Called for `isControlFunction` functions (effect handlers that use `unwind`)
/// when they have generic parameters. This is separate from normal specialization
/// because the concrete type comes from the CALL SITE's enclosing function return
/// type (not from the arguments).
///
/// Mirrors `evaluateCtlFunctionBodyInline` in `src/evaluator/calls/helper.ts`
/// (lines 3616–3790).
evaluate_ctl_function_body_inline :: (
  fn(
    original_func_val : EvalValue,
    func_type : TypeValue,
    callee_env : Environment,
    caller_env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> EvalValue
)({
  // Extract FuncVal fields individually to avoid tuple destructuring.
  orig_forall_labels := match(original_func_val, .FuncVal(__fvd3, _) => __fvd3.*.forall_names, _ => ArrayList(String).new());
  orig_params := match(original_func_val, .FuncVal(__fvd4, _) => __fvd4.*.params, _ => ArrayList(String).new());
  orig_param_type_names := match(original_func_val, .FuncVal(__fvd5, _) => __fvd5.*.param_type_names, _ => ArrayList(String).new());
  orig_evidence_params := match(original_func_val, .FuncVal(__fvd6, _) => __fvd6.*.evidence_params, _ => ArrayList(String).new());
  orig_body := match(original_func_val, .FuncVal(__fvd7, _) => __fvd7.*.body, _ => make_err_expr());
  orig_cap_names := match(original_func_val, .FuncVal(__fvd8, _) => __fvd8.*.cap_names, _ => ArrayList(String).new());
  orig_cap_tys := match(original_func_val, .FuncVal(__fvd9, _) => __fvd9.*.cap_tys, _ => ArrayList(TypeValue).new());
  orig_cap_vals := match(original_func_val, .FuncVal(_, cv) => cv, _ => ArrayList(EvalValue).new());
  orig_func_id := match(original_func_val, .FuncVal(__fvd10, _) => __fvd10.*.func_id, _ => String.from("__err_ctl"));
  // -------------------------------------------------------------------------
  // Determine concreteTypeForForall from context.
  // For function-body contexts, it's the enclosing function's return type.
  // Mirrors:
  //   context.isEvaluatingFunctionBodyOrAsyncBlock?.kind === "function-body"
  //     ? context.isEvaluatingFunctionBodyOrAsyncBlock.type.return.type
  //     : functionType.return.type
  // -------------------------------------------------------------------------
  (concrete_type_for_forall : TypeValue) = match(
    ctx.is_evaluating_function_body_or_async_block,
    .Some(fb_ctx) => match(
      fb_ctx.kind,
      .FunctionBody => match(
        fb_ctx.func_type,
        .Some(enclosing_ty) => match(
          enclosing_ty,
          .Func({ result : rb }) => rb,
          _ => match(func_type, .Func({ result : rb }) => rb, _ => TypeValue.Unit)
        ),
        .None => match(func_type, .Func({ result : rb }) => rb, _ => TypeValue.Unit)
      ),
      _ => match(func_type, .Func({ result : rb }) => rb, _ => TypeValue.Unit)
    ),
    .None => match(func_type, .Func({ result : rb }) => rb, _ => TypeValue.Unit)
  );
  // -------------------------------------------------------------------------
  // Determine enclosing return type from definition-site registry.
  // Mirrors:
  //   originalFunction.definitionSiteEnclosingFunctionType?.return.type ?? createUnitType()
  // -------------------------------------------------------------------------
  enclosing_return_ty := get_definition_site_return(orig_func_id.clone());
  // -------------------------------------------------------------------------
  // Build cache key: <original_func_id>_ctl_<sanitized_type_string>.
  // Mirrors:
  //   const ctlSignature = sanitizeForCIdentifier(typeToString(concreteTypeForForall));
  //   funcId: `${originalFunction.funcId}_ctl_${ctlSignature}`
  // -------------------------------------------------------------------------
  ctl_sig_raw := type_to_string(concrete_type_for_forall);
  ctl_sig_san := sanitize_for_sig(ctl_sig_raw);
  ctl_func_id := `${orig_func_id}_ctl_${ctl_sig_san}`;
  // -------------------------------------------------------------------------
  // Check cache: if we already have a specialization with this _ctl_ func_id,
  // return it immediately.
  // -------------------------------------------------------------------------
  // Build a compile-time arg list containing the concrete type as the sole entry.
  ctl_ct_args := ArrayList(EvalValue).new();
  ctl_ct_args.push(create_type_value(concrete_type_for_forall));
  cached_result := _find_specialization_cache(
    ctx,
    ctl_func_id.clone(),
    ctl_ct_args,
    ArrayList(TypeValue).new(),
    caller_env
  );
  (found_cached : bool) = false;
  (cached_val : EvalValue) = EvalValue.UnitVal;
  match(
    cached_result,
    .Some(cv2) => {
      found_cached = true;
      cached_val = cv2;
    },
    .None => ()
  );
  if(found_cached, {
    return(cached_val);
  });
  // -------------------------------------------------------------------------
  // Build specialized env: snapshot callee_env (SHARE the frames — TS
  // `pushEnvFrame` copies only the frame-pointer array) and push a new frame.
  // All writes below go to the freshly pushed frame, so sharing the parent
  // frames is exactly TS's aliasing. The old `clone_env` deep-copied every
  // frame's variable list per specialization — the top allocation-churn site
  // of a self-emit (see the handoff doc's memory section).
  // Mirrors: let specializedEnv = pushEnvFrame(calleeEnv);
  // -------------------------------------------------------------------------
  specialized_env := snapshot_env(callee_env);
  _push_frame_res := specialized_env.push_frame(false);
  // -------------------------------------------------------------------------
  // Add compile-time bindings from caller's scope that are missing from
  // specializedEnv (types, modules, traits — not plain function values).
  // Mirrors the callerEnv injection loop in evaluateCtlFunctionBodyInline.
  // -------------------------------------------------------------------------
  n_caller_frames := caller_env.frames.len();
  (cfi : usize) = usize(0);
  while(cfi < n_caller_frames, {
    match(
      caller_env.frames.get(cfi),
      .Some(caller_frame) => {
        n_vars := caller_frame.variables.len();
        (vi : usize) = usize(0);
        while(vi < n_vars, {
          match(
            caller_frame.variables.get(vi),
            .Some(caller_var) => {
              if(caller_var.is_compile_time_only, {
                // Skip plain function values (only types, modules, traits need to cross).
                is_fn_val := match(
                  caller_var.value.get(usize(0)),
                  .Some(cv3) => match(cv3, .FuncVal(_, _) => true, _ => false),
                  .None => false
                );
                if(!(is_fn_val), {
                  existing := get_variables_from_env(specialized_env, caller_var.name);
                  if(existing.len() == usize(0), {
                    _add_caller_var_res := add_variable_to_env(
                      specialized_env,
                      caller_var.name.clone(),
                      caller_var.ty,
                      caller_var.value.get(usize(0)),
                      true,
                      false,
                      false,
                      caller_var.is_implicit,
                      caller_var.token
                    );
                  });
                });
              });
            },
            .None => ()
          );
          vi = (vi + usize(1));
        });
      },
      .None => ()
    );
    cfi = (cfi + usize(1));
  });
  // -------------------------------------------------------------------------
  // Bind each generic parameter to concreteTypeForForall.
  // Mirrors the forallParam loop in evaluateCtlFunctionBodyInline.
  // -------------------------------------------------------------------------
  forall_labels := match(
    func_type,
    .Func({ meta : __fm6 }) => __fm6.*.forall_labels,
    _ => ArrayList(String).new()
  );
  forall_types_list := match(
    func_type,
    .Func({ forall_types : ft }) => ft,
    _ => ArrayList(TypeValue).new()
  );
  n_forall := forall_labels.len();
  (fi2 : usize) = usize(0);
  while(fi2 < n_forall, {
    fl_label := match(forall_labels.get(fi2), .Some(s) => s, .None => String.from(""));
    fl_ty := match(forall_types_list.get(fi2), .Some(t) => t, .None => TypeValue.Unit);
    ctl_tok := synthetic_token(fl_label.clone(), specialized_env.module_path);
    _add_forall_var_res := add_variable_to_env(
      specialized_env,
      fl_label.clone(),
      fl_ty,
      Option(EvalValue).Some(create_type_value(concrete_type_for_forall)),
      true,
      false,
      false,
      false,
      ctl_tok
    );
    fi2 = (fi2 + usize(1));
  });
  // -------------------------------------------------------------------------
  // Build a handler context with modified enclosingFunctionReturnType.
  // Mirrors:
  //   const handlerContext: EvaluatorContext = {
  //     ...context,
  //     expectedType: undefined,
  //     enclosingFunctionReturnType: enclosingReturnType,
  //     isEvaluatingFunctionBodyOrAsyncBlock: { kind: "function-body", type: functionType, value: originalFunction, evaluationEnv: specializedEnv },
  //     functionReturnImplConcreteType: [],
  //   };
  // -------------------------------------------------------------------------
  handler_fb_ctx := FuncOrAsyncBlockCtx(
    kind : FuncOrAsyncBlockKind.FunctionBody,
    func_type : Option(TypeValue).Some(func_type),
    func_value : Option(EvalValue).Some(original_func_val),
    // Snapshot: freeze the entry frame count (see the spec-path ctx above).
    eval_env : snapshot_env(specialized_env)
  );
  prev_expected_type := ctx.expected_type;
  prev_is_eval_fb := ctx.is_evaluating_function_body_or_async_block;
  prev_enclosing_ret := ctx.enclosing_function_return_type;
  prev_impl_concrete := ctx.function_return_impl_concrete_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  ctx.is_evaluating_function_body_or_async_block = Option(FuncOrAsyncBlockCtx).Some(handler_fb_ctx);
  ctx.enclosing_function_return_type = Option(TypeValue).Some(enclosing_return_ty);
  ctx.function_return_impl_concrete_type = Option(ArrayList(ImplConcreteTypeInfo)).Some(ArrayList(ImplConcreteTypeInfo).new());
  // -------------------------------------------------------------------------
  // Evaluate the body.
  // -------------------------------------------------------------------------
  ctl_body := evaluate_begin_expression(
    orig_body,
    specialized_env,
    ctx,
    ArrayList(Variable).new(),
    true,
    exn
  );
  // Restore context fields.
  ctx.expected_type = prev_expected_type;
  ctx.is_evaluating_function_body_or_async_block = prev_is_eval_fb;
  ctx.enclosing_function_return_type = prev_enclosing_ret;
  ctx.function_return_impl_concrete_type = prev_impl_concrete;
  // -------------------------------------------------------------------------
  // Build the specialized FuncVal.
  // Mirrors: funcId: `${originalFunction.funcId}_ctl_${ctlSignature}`
  // -------------------------------------------------------------------------
  ctl_parent_is_ctl := is_control_fn(orig_func_id.clone());
  ctl_body_has_unwind := evaluated_body_contains_unwind(ctl_body);
  if(ctl_parent_is_ctl || ctl_body_has_unwind, {
    mark_as_control_fn(ctl_func_id.clone());
  });
  // Rebuild captures (same as original + generic type bindings).
  ctl_cap_names := ArrayList(String).new();
  ctl_cap_tys := ArrayList(TypeValue).new();
  ctl_cap_vals := ArrayList(EvalValue).new();
  (oci : usize) = usize(0);
  n_oc := orig_cap_names.len();
  while(oci < n_oc, {
    ctl_cap_names.push(match(orig_cap_names.get(oci), .Some(s) => s, .None => String.new()));
    ctl_cap_tys.push(match(orig_cap_tys.get(oci), .Some(t) => t, .None => TypeValue.Unit));
    ctl_cap_vals.push(match(orig_cap_vals.get(oci), .Some(v) => v, .None => EvalValue.UnitVal));
    oci = (oci + usize(1));
  });
  // Add generic type bindings as extra captures.
  (fi3 : usize) = usize(0);
  while(fi3 < n_forall, {
    fl3 := match(forall_labels.get(fi3), .Some(s) => s, .None => String.new());
    ft3 := match(forall_types_list.get(fi3), .Some(t) => t, .None => TypeValue.Unit);
    ctl_cap_names.push(fl3.clone());
    ctl_cap_tys.push(ft3);
    ctl_cap_vals.push(create_type_value(concrete_type_for_forall));
    fi3 = (fi3 + usize(1));
  });
  ctl_func_val := EvalValue.FuncVal(
    box(
      FuncValData(
        forall_names : orig_forall_labels,
        params : orig_params,
        param_type_names : orig_param_type_names,
        evidence_params : orig_evidence_params,
        body : orig_body,
        cap_names : ctl_cap_names,
        cap_tys : ctl_cap_tys,
        func_id : ctl_func_id.clone()
      )
    ),
    ctl_cap_vals
  );
  // -------------------------------------------------------------------------
  // Cache the result.
  // -------------------------------------------------------------------------
  // Use ctl_func_id as the cache key with the concrete type as the sole arg.
  ctl_cache_args := ArrayList(EvalValue).new();
  ctl_cache_args.push(create_type_value(concrete_type_for_forall));
  _store_specialization_cache(
    ctx,
    ctl_func_id.clone(),
    ctl_cache_args,
    ArrayList(TypeValue).new(),
    ctl_func_val,
    specialized_env
  );
  ctl_func_val
});
// ---------------------------------------------------------------------------
// try_to_call_function_with_arguments
// ---------------------------------------------------------------------------
/// Type-check the arguments of a function call against `func_type` and
/// (optionally) execute CTFE. Returns a `FuncCallResult` with the resolved
/// return type, runtime arg expressions, updated caller env, and deferred
/// drop expressions.
///
/// Phase 3 port of `tryToCallFunctionWithArguments` in
/// `src/evaluator/calls/helper.ts`.
///
/// Phase 3 simplifications (relative to the full TypeScript implementation):
///   * CTFE is not executed — return_value is always None.
///   * Generic specialization is implemented (create_specialized_function_inline)
///     but without effects analysis (isControlFunction, effectCtlParams).
///   * RC ownership / deferred drop expressions are skipped.
///   * Quote parameters are not supported (throw on encounter).
///   * Where-clause constraints are skipped (TypeValue has no AstExpr forms).
/// Validate the registered where-clause constraints of `func_id` against the
/// parameter bindings now present in `callee_env`. Mirrors TS re-applying
/// `FunctionType.whereClauseExprs` at every call site once parameters are
/// bound (helper.ts:1493-1506 → applyWhereClauseConstraints →
/// validateSingleTraitOnConcreteType, types/function.ts:974): a constraint
/// whose LHS param resolved to a CONCRETE type must hold — this is what
/// rejects `Mutex(NonSendObj)` against `where(T <: Send)`. Called from BOTH
/// call paths: Step 8b of `try_to_call_function_with_arguments` below AND the
/// inline FuncVal arm in `calls/function.yo` (the same two-path obligation as
/// the default-args side table).
///
/// DOCUMENTED DIVERGENCE (narrower than TS): only MARKER-trait constraints
/// (traits without methods — Send/Acyclic/user markers) are enforced, and only
/// against FULLY CONCRETE bound types (no SomeT anywhere in the type). TS
/// validates every constraint because its `typeImplementsTrait` is complete;
/// yo-self's still has gaps for (a) method-trait satisfaction on concrete
/// types (e.g. `K <: (Eq, Hash)` for `String`) and (b) marker derivation
/// through generic-instantiation fields that still carry constraint-bearing
/// SomeTs — enforcing those today rejects valid std code (imm/map, hashmap).
/// Widen as the trait checker closes those gaps.
validate_where_constraints_for_call :: (
  fn(
    func_id : String,
    callee_env : Environment,
    tok : Token,
    exn : Exception
  ) -> unit
)({
  where_constraint_list := get_func_where_constraints(func_id);
  (wcl_i : usize) = usize(0);
  while(wcl_i < where_constraint_list.len(), {
    wce := match(
      where_constraint_list.get(wcl_i),
      .Some(e) => e,
      .None => {
        wcl_i = (wcl_i + usize(1));
        continue;
      }
    );
    // Marker traits only: a TraitT none of whose fields is function-typed.
    trait_is_marker := match(
      wce.trait_ty,
      .TraitT(_, _, _, tr_ftys, _, _, _, _, _, _) => {
        (tm_i : usize) = usize(0);
        (tm_has_method : bool) = false;
        while((tm_i < tr_ftys.len()) && !(tm_has_method), {
          match(
            tr_ftys.get(tm_i),
            .Some(tf) => if(is_function_type(tf), {
              tm_has_method = true;
            }),
            .None => ()
          );
          tm_i = (tm_i + usize(1));
        });
        !(tm_has_method)
      },
      _ => false
    );
    if(!(trait_is_marker), {
      wcl_i = (wcl_i + usize(1));
      continue;
    });
    lhs_vars := get_variables_from_env(callee_env, wce.lhs_label);
    if(lhs_vars.len() > usize(0), {
      match(
        lhs_vars.get(lhs_vars.len() - usize(1)),
        .Some(lhs_var) => match(
          lhs_var.value.get(usize(0)),
          .Some(lv) => match(
            lv,
            .TypeVal(bound_tb) => {
              bound_ty := bound_tb;
              // Fully concrete only: a bound type still carrying SomeTs (a
              // generic instantiation inside an impl body) defers to TS-style
              // constraint propagation, which yo-self's marker derivation
              // can't see through yet.
              if((!(is_some_type(bound_ty))) && (get_all_some_types(bound_ty).len() == usize(0)), {
                wc_implemented := type_implements_trait_bool(bound_ty, wce.trait_ty, callee_env);
                if(wce.is_negated, {
                  if(wc_implemented, {
                    exn.throw(
                      dyn(
                        format_error_message(
                          tok,
                          `Type ${type_to_string(bound_ty)} must NOT implement ${type_to_string(wce.trait_ty)}, but it does.`,
                          false,
                          .None
                        )
                      )
                    );
                  });
                }, {
                  if(!(wc_implemented), {
                    exn.throw(
                      dyn(
                        format_error_message(
                          tok,
                          `Type ${type_to_string(bound_ty)} does not implement required trait ${type_to_string(wce.trait_ty)}.`,
                          false,
                          .None
                        )
                      )
                    );
                  });
                });
              });
            },
            _ => ()
          ),
          .None => ()
        ),
        .None => ()
      );
    });
    wcl_i = (wcl_i + usize(1));
  });
});
/// Re-apply the function's where-clause constraint EXPRESSIONS in the bound
/// callee env — the faithful port of TS re-applying
/// `functionType.whereClauseExprs` at every call site (helper.ts:1515-1530 →
/// applyWhereClauseConstraints). Re-evaluating the expr is what the evaluated
/// `WhereConstraintEntry` table above cannot do: a PARAMETERIZED trait
/// constraint (`K <: Eq(K)`, `P <: Pattern`) resolves against the call's
/// concrete binding (`Eq(String)`), and a concrete-bound LHS then takes
/// `validate_concrete_type_constraints`'s hard error ("Type i32 does not
/// implement required trait Pattern"). Exprs are cloned with fresh ids (TS
/// cloneExpr clears `$`; yo-self's ExprInfo side table is keyed by id).
/// Called from BOTH call paths, like `validate_where_constraints_for_call`.
reapply_where_clause_exprs_for_call :: (
  fn(
    func_id : String,
    callee_env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> unit
)({
  wce_exprs := get_func_where_clause_exprs(func_id);
  if(wce_exprs.len() > usize(0), {
    // Guard (mirrors TS's own early-apply guard, helper.ts:1375-1393, adapted
    // for yo-self's extra inline-FuncVal call path which TS does not have):
    // only re-apply when every atom LHS that IS bound in callee_env is bound
    // to a TYPE value. On a spec-cache-hit reuse the forall params (`U`, `V`)
    // are not re-bound as TypeVals, and running the parse there throws a
    // spurious 'Expected type for left-hand side of where clause constraint,
    // got variable "U"' (second `zip_with` call in tests/imm_vec). An UNBOUND
    // LHS is fine — the parse creates a fresh SomeT for it, as TS does.
    (wce_state_ok : bool) = true;
    (wcg_i : usize) = usize(0);
    while((wcg_i < wce_exprs.len()) && wce_state_ok, {
      match(
        wce_exprs.get(wcg_i),
        .Some(wge) => {
          if(ast_expr_is_fn_call_of(wge, "<:", .Some(usize(2))), {
            wge_args := _h_get_fn_call_args(wge);
            match(
              wge_args.get(usize(0)),
              .Some(wge_lhs) => {
                if(ast_expr_is_atom(wge_lhs), {
                  wge_vars := get_variables_from_env(callee_env, ast_expr_token(wge_lhs).value);
                  if(wge_vars.len() > usize(0), {
                    match(
                      wge_vars.get(wge_vars.len() - usize(1)),
                      .Some(wge_var) => match(
                        wge_var.value.get(usize(0)),
                        .Some(wge_val) => {
                          if(!(is_type_val(wge_val)), {
                            wce_state_ok = false;
                          });
                        },
                        .None => {
                          wce_state_ok = false;
                        }
                      ),
                      .None => ()
                    );
                  });
                });
              },
              .None => ()
            );
          });
        },
        .None => ()
      );
      wcg_i = (wcg_i + usize(1));
    });
    if(wce_state_ok, {
      cloned_wces := ArrayList(AstExpr).new();
      (wce_i : usize) = usize(0);
      while(wce_i < wce_exprs.len(), {
        match(
          wce_exprs.get(wce_i),
          .Some(we) => {
            cloned_wces.push(clone_expr_fresh_ids(we));
          },
          .None => ()
        );
        wce_i = (wce_i + usize(1));
      });
      wce_prev := ctx.is_evaluating_function_type;
      ctx.is_evaluating_function_type = true;
      apply_where_clause_constraints(cloned_wces, callee_env, ctx, exn);
      ctx.is_evaluating_function_type = wce_prev;
    });
  });
});
/// Resolve a function's parameter types by synthesizing its `generic` parameters
/// from the expected return type. For the FuncVal-arm call path (`function.yo`),
/// which sets each argument's expected type from the DECLARED parameter type —
/// an unresolved `generic` (e.g. `value : V` in `box`) is skipped there, so a
/// `.Variant`-shorthand argument cannot resolve its enum type. Mirrors TS
/// `helper.ts:1283-1310`: synthesize the foralls from the expected type, then
/// re-evaluate the parameter types so they become concrete (`V → Tree` for
/// `(.Atom(...))` with expected `Box(Tree)`).
///
/// The resolved types are pushed to `out` (which the caller pre-creates empty);
/// on synthesis failure `out` stays empty and the caller keeps the declared
/// types. The synthesis runs under a capture-free swallow `Exception` (a `->`
/// effect handler cannot close over outer variables, so it just unwinds `()` —
/// the results ride out via `out`, exactly like `_trial_eval_fn_body`).
resolve_param_types_from_expected :: (
  fn(
    func_type : TypeValue,
    expected_ty : TypeValue,
    expected_env : Environment,
    caller_env : Environment,
    ctx : EvalContext,
    out : ArrayList(TypeValue)
  ) -> unit
)({
  default_pts := match(func_type, .Func({ param_types : pt }) => pt, _ => ArrayList(TypeValue).new());
  forall_lbls := match(func_type, .Func({ meta : __fm7 }) => __fm7.*.forall_labels, _ => ArrayList(String).new());
  ret_b := match(func_type, .Func({ result : rb }) => rb, _ => t_unit());
  if(forall_lbls.len() == usize(0), {
    return(());
  });
  // Capture-free swallow: on any synthesis error, unwind `()` (the loop that
  // fills `out` runs only after a successful synth, so `out` stays empty).
  rps_exn := Exception(throw : ((_e) -> unwind(())));
  // Seed every signature SomeT as a self-binding placeholder so
  // `synthesize_types` has a slot to rebind (mirrors the generic-placeholder
  // setup in `try_to_call_function_with_arguments`).
  synth_env := Environment.new(caller_env.module_path);
  synth_env.push_frame(false);
  sig_somes := get_all_some_types(func_type);
  (si : usize) = usize(0);
  while(si < sig_somes.len(), {
    sst := match(sig_somes.get(si), .Some(t) => t, .None => t_unit());
    snm := match(sst, .SomeT(_, n, _, _, _, _, _, _, _, _, _) => n, _ => String.from(""));
    if(snm.len() > usize(0), {
      add_variable_to_env(
        synth_env,
        snm,
        t_type(),
        Option(EvalValue).Some(create_type_value(sst)),
        true,
        false,
        false,
        false,
        synthetic_token(snm, synth_env.module_path)
      );
    });
    si = (si + usize(1));
  });
  temp_ret := evaluate_function_return_type_again(ret_b, synth_env, ctx);
  rps_checked := ArrayList(TypePair).new();
  (rps_opts : Option(SynthesizeOptions)) = Option(SynthesizeOptions).None;
  rps_synth := synthesize_types(temp_ret, synth_env, expected_ty, expected_env, rps_checked, rps_opts, rps_exn);
  resolved_env := rps_synth.expected_env;
  (pj : usize) = usize(0);
  while(pj < default_pts.len(), {
    p_orig := match(default_pts.get(pj), .Some(t) => t, .None => t_unit());
    out.push(evaluate_function_return_type_again(p_orig, resolved_env, ctx));
    pj = (pj + usize(1));
  });
});
_func_type_has_runtime_some_param :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .Func({ param_types : pts }) => {
      (found : bool) = false;
      (i : usize) = usize(0);
      n := pts.len();
      while((i < n) && !(found), {
        match(
          pts.get(i),
          .Some(pt) => if(is_some_type(pt) && !(type_implements_future(pt)), {
            found = true;
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    _ => false
  )
);
/// Apply early where-clause constraint exprs under a capture-free SWALLOW
/// `Exception` (the `_trial_eval_ret_type_expr` idiom). The Step-6c early
/// application is strictly ADDITIVE — it exists to bind constraint-derived
/// generics (`Iterator(Item := A)` → `A`) before the argument loop; when a
/// constraint's embedded generics are still UnknownVal placeholders the
/// trait-application eval throws ("Expected type for associated type
/// constraint"), and that throw must not fail the CALL (measured: the batch
/// `__yo_user_main` validation pass has no retry, so an escaping throw
/// hollows the whole file; a plain `main` recovers on the later
/// specialization pass). Validation still happens at Step 8b.
/// Collect every Atom token value in `e` into `out` (pre-order). Used by the
/// Step-6c prebind to find which forall labels a constraint expr references.
_collect_atom_names_into :: (fn(e : AstExpr, out : ArrayList(String)) -> unit)(
  match(
    e,
    .Atom(_, a_tok) => {
      out.push(a_tok.value.clone());
    },
    .FnCall(_, a_fn, a_args, _, _) => {
      recur(a_fn, out);
      (a_i : usize) = usize(0);
      while(a_i < a_args.len(), {
        match(
          a_args.get(a_i),
          .Some(a_sub) => recur(a_sub, out),
          .None => ()
        );
        a_i = (a_i + usize(1));
      });
    }
  )
);
_try_apply_early_where_clauses :: (
  fn(constraint_exprs : ArrayList(AstExpr), callee_env : Environment, ctx : EvalContext) -> unit
)({
  eaw_exn := Exception(throw : ((_eaw_e) -> unwind(())));
  apply_where_clause_constraints(constraint_exprs, callee_env, ctx, eaw_exn);
});
try_to_call_function_with_arguments :: (
  fn(
    func_val : Option(EvalValue),
    func_type : TypeValue,
    expr : AstExpr,
    callee_expr : AstExpr,
    arg_exprs : ArrayList(AstExpr),
    caller_env : Environment,
    ctx : EvalContext,
    is_method_call : bool,
    skip_specialization : bool,
    skip_ctfe_execution : bool,
    exn : Exception
  ) -> FuncCallResult
)({
  callee_expr;
  skip_ctfe_execution;
  tok := ast_expr_token(expr);
  // Normalize a closure-trait callee type (`Impl(Fn(...))` SomeT or a bare
  // FnTraitT) to its Func signature so the `.Func` arm below types the call.
  // A specialized closure param `cb` is bound to its declared SomeT(Impl(Fn))
  // (callable + codegen-resolvable via g_some_resolved_concrete); calling it
  // (`cb(x)`) lands here with that SomeT — without this it would miss the
  // `.Func` arm and the call would not be typed (no ExprInfo → codegen
  // "Failed to transpile"). Real Func callees pass through unchanged.
  norm_func_type := match(
    func_type,
    .Func({ result : _ }) => func_type,
    _ => match(
      extract_fn_trait_from_type(func_type),
      .Some(ftt) => match(
        ftt,
        .FnTraitT(_, cpl, cpt, cr_box, _, _, _, cprf) => TypeValue.Func(
          ArrayList(TypeValue).new(),
          cpt,
          ArrayList(TypeValue).new(),
          ArrayList(TypeValue).new(),
          cr_box,
          box(
            FuncMeta(
              forall_labels : ArrayList(String).new(),
              param_labels : cpl,
              implicit_labels : ArrayList(String).new(),
              implicit_spreads : ArrayList(bool).new(),
              result_is_comptime_only : false,
              param_is_ref : cprf,
              param_is_owning : ArrayList(bool).new(),
              result_is_ref : false,
              has_variadic : false,
              is_extern : Option(String).None,
              extern_name : Option(String).None,
              is_control : false,
              variadic_label : Option(String).None,
              variadic_comptime : false
            )
          ),
          ArrayList(TypeValue).new()
        ),
        _ => func_type
      ),
      .None => func_type
    )
  );
  // Second normalization chance: a closure-typed FIELD call can arrive with
  // the callee typed as the BARE capture struct, or as a SomeT whose
  // resolution chain terminates in it (the where-clause `F` family — TS keeps
  // the Impl(Fn) wrapper on field types, helper.ts:2242-2252, so its call
  // route always extracts the Fn; yo-self field stamps can lose it). Recover
  // the Func signature via the capture-struct → closure-fid reverse lookup.
  // Without this the call falls into the non-Func soft fallback below, which
  // records EMPTY runtime args → codegen emits the closure call with no
  // arguments.
  (norm_func_type2 : TypeValue) = norm_func_type;
  if(!(is_function_type(norm_func_type2)), {
    (nf2_cur : TypeValue) = func_type;
    (nf2_hops : usize) = usize(0);
    (nf2_walk : bool) = true;
    while(nf2_walk && (nf2_hops < usize(32)), {
      match(
        nf2_cur,
        .SomeT(_, _, _, _, _, _, _, _, _, _, nf2_rc) => match(
          nf2_rc.get(usize(0)),
          .Some(nf2_next) => {
            nf2_cur = nf2_next;
            nf2_hops = (nf2_hops + usize(1));
          },
          .None => {
            nf2_walk = false;
          }
        ),
        _ => {
          nf2_walk = false;
        }
      );
    });
    match(
      nf2_cur,
      .Struct({ id : nf2_sid }) => if(nf2_sid.len() > usize(0), {
        match(
          find_closure_fid_by_capture_struct_id(nf2_sid),
          .Some(nf2_fid) => {
            nf2_ft := get_func_type(nf2_fid);
            if(is_function_type(nf2_ft), {
              norm_func_type2 = nf2_ft;
            });
          },
          .None => ()
        );
      }),
      _ => ()
    );
  });
  match(
    norm_func_type2,
    .Func({ forall_types : ft, param_types : pt, implicit_types : it, where_types : wt, result : ret_b, meta : __fm8 }) => {
      fl := __fm8.*.forall_labels;
      pl := __fm8.*.param_labels;
      pio := __fm8.*.param_is_owning;
      pref := __fm8.*.param_is_ref;
      il := __fm8.*.implicit_labels;
      ispr := __fm8.*.implicit_spreads;
      fn_has_variadic := __fm8.*.has_variadic;
      // Aliasing Stage 0: extern/builtin callees run no Yo code, so their
      // borrows cannot dangle — Step 4c skips the projection dup for them
      // (mirrors TS helper.ts `!functionType.externName`).
      callee_is_extern := __fm8.*.extern_name.is_some();
      ispr;
      wt;
      // ----------------------------------------------------------------
      // Step 1: Detect explicit generic(…) argument.
      // ----------------------------------------------------------------
      (forall_args_opt : Option(ArrayList(AstExpr))) = Option(ArrayList(AstExpr)).None;
      (regular_start : usize) = usize(0);
      has_f0 := match(
        arg_exprs.get(usize(0)),
        .Some(a) => ast_expr_is_fn_call_of(a, "generic", Option(usize).None),
        .None => false
      );
      if(has_f0, {
        fa0 := match(arg_exprs.get(usize(0)), .Some(a) => a, .None => make_err_expr());
        forall_args_opt = .Some(_h_get_fn_call_args(fa0));
        regular_start = usize(1);
      });
      // For method calls, generic may appear at index 1 (self is at 0).
      (skip_arg_idx : Option(usize)) = Option(usize).None;
      if((!(has_f0)) && (is_method_call && (arg_exprs.len() > usize(1))), {
        has_f1 := match(
          arg_exprs.get(usize(1)),
          .Some(a) => ast_expr_is_fn_call_of(a, "generic", Option(usize).None),
          .None => false
        );
        if(has_f1, {
          fa1 := match(arg_exprs.get(usize(1)), .Some(a) => a, .None => make_err_expr());
          forall_args_opt = .Some(_h_get_fn_call_args(fa1));
          // The `generic(...)` node must be REMOVED from the middle of the
          // regular-arg list, keeping the receiver at index 0 — TS does
          // `argExprs = [argExprs[0]!, ...argExprs.slice(2)]`
          // (src/evaluator/calls/helper.ts:956). Leaving it in shifted every
          // parameter association by one (and pushed the type argument into
          // the emitted C call), so `container.map(generic(B), f)` never
          // type-checked (tests/higher_kinded_types.test.yo:91).
          skip_arg_idx = Option(usize).Some(usize(1));
        });
      });
      // ----------------------------------------------------------------
      // Step 2: Split … arg out; collect regular args.
      // ----------------------------------------------------------------
      (using_args_opt : Option(ArrayList(AstExpr))) = Option(ArrayList(AstExpr)).None;
      adjusted_args := ArrayList(AstExpr).new();
      n_total := arg_exprs.len();
      (ai : usize) = regular_start;
      while(ai < n_total, {
        a := match(arg_exprs.get(ai), .Some(x) => x, .None => make_err_expr());
        is_skipped_forall := match(skip_arg_idx, .Some(si) => (si == ai), .None => false);
        if(!(is_skipped_forall), {
          if(ast_expr_is_fn_call_of(a, "using", Option(usize).None), {
            using_args_opt = .Some(_h_get_fn_call_args(a));
          }, {
            adjusted_args.push(a);
          });
        });
        ai = (ai + usize(1));
      });
      // ----------------------------------------------------------------
      // Step 3: Argument count check.
      //
      // Parameters with a `?= default` are optional and may be omitted at
      // the call site. The optional flags are looked up (by FuncVal id)
      // from the side-table populated at definition time. A call is valid
      // when it supplies at least the required-parameter count and no more
      // than the total. Omitted trailing optionals are bound to their
      // declared type below (Step 7).
      // ----------------------------------------------------------------
      n_params := pl.len();
      n_args := adjusted_args.len();
      call_param_defaults := match(
        func_val,
        .Some(fvv) => match(
          fvv,
          .FuncVal(__fvd11, _) => get_func_param_defaults(__fvd11.*.func_id.clone()),
          _ => ArrayList(Option(EvalValue)).new()
        ),
        .None => ArrayList(Option(EvalValue)).new()
      );
      // Parallel to call_param_defaults: the omitted-parameter default-value
      // EXPRESSIONS, so the omitted branch (Step 7) can emit the default as a
      // C argument (codegen renders `runtime_arg_exprs_in_order`).
      call_param_default_exprs := match(
        func_val,
        .Some(fvv2) => match(
          fvv2,
          .FuncVal(__fvd12, _) => get_func_param_default_exprs(__fvd12.*.func_id.clone()),
          _ => ArrayList(Option(AstExpr)).new()
        ),
        .None => ArrayList(Option(AstExpr)).new()
      );
      // Parallel to call_param_defaults: per-param `is_compile_time_only` flags,
      // so the comptime→runtime argument-type conversion (Step 4) can gate on
      // the parameter's comptime modifier exactly as TS does (helper.ts:508).
      call_param_comptime := match(
        func_val,
        .Some(fvv3) => match(
          fvv3,
          .FuncVal(__fvd13, _) => get_func_param_comptime(__fvd13.*.func_id.clone()),
          _ => ArrayList(bool).new()
        ),
        .None => ArrayList(bool).new()
      );
      // Parallel to call_param_comptime: the per-param `= <value>` ASSIGNED
      // values, so Step 5b can reject a mismatching argument (helper.ts:481).
      call_param_assigned := match(
        func_val,
        .Some(fvv4) => match(
          fvv4,
          .FuncVal(__fvd14, _) => get_func_param_assigned_values(__fvd14.*.func_id.clone()),
          _ => ArrayList(Option(EvalValue)).new()
        ),
        .None => ArrayList(Option(EvalValue)).new()
      );
      (n_required : usize) = n_params;
      if(call_param_defaults.len() == n_params, {
        (nr : usize) = usize(0);
        (ofi : usize) = usize(0);
        while(ofi < n_params, {
          match(
            call_param_defaults.get(ofi),
            .Some(d) => if(d.is_none(), {
              nr = (nr + usize(1));
            }),
            .None => ()
          );
          ofi = (ofi + usize(1));
        });
        n_required = nr;
      });
      // Variadic functions (C-style `...` externs like `snprintf`) accept any
      // number of extra arguments — TS skips the count check entirely for
      // them (`if (!functionType.variadicParameter)`, helper.ts:965).
      if((!(fn_has_variadic)) && ((n_args < n_required) || (n_args > n_params)), {
        (count_msg : String) = `Argument count mismatch: expected ${n_params.to_string()} arguments, got ${n_args.to_string()}`;
        if(n_required != n_params, {
          count_msg = `Argument count mismatch: expected ${n_required.to_string()}..${n_params.to_string()} arguments, got ${n_args.to_string()}`;
        });
        exn.throw(
          dyn(
            format_error_message(
              tok,
              count_msg,
              false,
              .None
            )
          )
        );
      });
      // ----------------------------------------------------------------
      // Step 4: Build callee_env from FuncVal captures (or empty).
      // ----------------------------------------------------------------
      (callee_env : Environment) = match(
        func_val,
        .Some(fv) => match(
          fv,
          // `capture_env_for` memoises the rebuilt capture env per closure
          // instance — this used to re-bind every captured name on EVERY call
          // (~660 `add_variable_to_env` calls per call in a self-compile, the
          // top allocation site of the bootstrap). See env.yo.
          .FuncVal(__fvm3, cv) => capture_env_for(
            __fvm3.*.func_id,
            __fvm3.*.cap_names,
            __fvm3.*.cap_tys,
            cv,
            caller_env.module_path
          ),
          _ => Environment.new(caller_env.module_path)
        ),
        .None => Environment.new(caller_env.module_path)
      );
      // Step 5: Push a new frame on callee_env for parameter bindings.
      callee_env.push_frame(false);
      // Step 5b: Bind `Self` for METHOD calls — port of TS helper.ts:1015-1035
      // (`if (functionType.SelfType) addVariableToEnv("Self", ...)`). TS
      // stamps `SelfType` on the method's FunctionType when the impl match
      // resolves it (impl.ts:1497 `substitutions.get("Self")` = the concrete
      // receiver); yo-self's flattened Func type carries no such field, so
      // the method-call site threads the receiver type through the
      // ONE-SHOT `ctx.pending_method_self_type` (consumed above — cleared
      // before anything else runs, so only this binding sees it). Binding it
      // here lets the Step-6c early where-clause application below see
      // `Self` bound — `where(Self <: Iterator(Item := A))` then resolves
      // `A` from the concrete receiver before the closure argument is typed
      // (tests/closure_capture_rc_leak).
      sb_pending := ctx.pending_method_self_type;
      ctx.pending_method_self_type = Option(TypeValue).None;
      if(is_method_call, {
        match(
          sb_pending,
          .Some(sb_st) => {
            _sb := add_variable_to_env(
              callee_env,
              String.from("Self"),
              t_type(),
              Option(EvalValue).Some(create_type_value(sb_st)),
              true,
              false,
              false,
              false,
              synthetic_token(String.from("Self"), callee_env.module_path)
            );
          },
          .None => ()
        );
      });
      // ----------------------------------------------------------------
      // Step 6: Add generic params as UnknownVal placeholders (or resolve
      //         them from an explicit generic(…) argument).
      // ----------------------------------------------------------------
      n_forall := fl.len();
      // Self-bound markers (TS structural mirror): TS's callee env EXTENDS
      // the function type's definition env (`pushEnvFrame(functionType.env)`,
      // helper.ts:1009), whose frames still hold the self-binding
      // `T := SomeT(T)` for EVERY type variable the signature introduced —
      // explicit `generic` labels AND implicit ones (`Impl(...)` sugar). That
      // intact marker is what lets `getValueOfSomeTypeFromEnv` accept the
      // concrete rebinding `synthesizeTypes` later writes over the LAST
      // binding (env-lookup.ts:141-167, `thisSomeTypeWasBound`). yo-self's
      // callee_env is built FRESH (the flattened `Func` TypeValue carries no
      // definition env), so the markers must be recreated here, for every
      // distinct SomeT in the signature:
      //   - generic labels: marker only — the `UnknownVal` call binding added
      //     by the loop below stays LAST (it is what `_bind_some_type`
      //     updates), with the marker intact beneath it.
      //   - non-generic SomeTs (`Impl(...)`): marker + a SECOND self-binding.
      //     `_bind_some_type` updates the second; the first survives as the
      //     ownership marker. Skipped when the name is already bound in
      //     callee_env (e.g. an enclosing impl's type param arriving through
      //     the FuncVal captures — self-binding would shadow the real value).
      sig_some_types := get_all_some_types(func_type);
      // `get_all_some_types` stops at a SomeT boundary (faithful mirror of TS's
      // `getAllSomeTypes`), so type variables NESTED inside a wrapper's Fn-trait
      // carrier — `E`/`T` inside `Impl(Fn(e : E) -> T)` — are not returned. TS
      // never needs them here because its callee env extends the signature's
      // definition env, which already holds their self-markers; yo-self builds
      // callee_env fresh, so those inner markers must be recreated too. Collect
      // and append them before the marker loop so a later concrete rebinding of
      // an inner var (e.g. io.async binding `E = IoExn`) can be resolved
      // (`get_value_of_some_type_from_env`'s ownership check needs the marker).
      {
        (wrap_extra : ArrayList(TypeValue)) = ArrayList(TypeValue).new();
        (we_i : usize) = usize(0);
        while(we_i < sig_some_types.len(), {
          match(
            sig_some_types.get(we_i),
            .Some(wsst) => {
              wnested := collect_wrapper_trait_somes(wsst);
              (wn_i : usize) = usize(0);
              while(wn_i < wnested.len(), {
                match(
                  wnested.get(wn_i),
                  .Some(wn) => {
                    wrap_extra.push(wn);
                  },
                  .None => ()
                );
                wn_i = (wn_i + usize(1));
              });
            },
            .None => ()
          );
          we_i = (we_i + usize(1));
        });
        (wx_i : usize) = usize(0);
        while(wx_i < wrap_extra.len(), {
          match(
            wrap_extra.get(wx_i),
            .Some(wx) => {
              sig_some_types.push(wx);
            },
            .None => ()
          );
          wx_i = (wx_i + usize(1));
        });
      };
      // Self-slot marker exclusion (TS fidelity): TS recreates NO markers —
      // its callee env EXTENDS the method's definition env (helper.ts:1013),
      // which holds self-markers ONLY for type variables the signature
      // itself declared. A SomeT arriving exclusively through the
      // SUBSTITUTED self param (the receiver record embeds the PREVIOUS
      // combinator call's foralls, e.g. `IterFilter(_, F-filter)` in
      // `.filter(p).fold(init, f)`) must NOT be marker-bound under its bare
      // name here: that marker becomes the LAST same-named binding in the
      // callee frame and buries the callee's own forall (name-keyed
      // last-binding-wins), routing fold's `F` to filter's predicate.
      (self_only_ids : ArrayList(String)) = ArrayList(String).new();
      if(is_method_call && (pt.len() > usize(0)), {
        _sx_push_ids :: (fn(ty : TypeValue, out_ids : ArrayList(String)) -> unit)({
          sx_all := get_all_some_types(ty);
          (sx_i : usize) = usize(0);
          while(sx_i < sx_all.len(), {
            sx_st := match(sx_all.get(sx_i), .Some(t) => t, .None => t_unit());
            sx_id := match(sx_st, .SomeT(id, _, _, _, _, _, _, _, _, _, _) => id, _ => String.from(""));
            if(sx_id.len() > usize(0), {
              out_ids.push(sx_id);
            });
            sx_nested := collect_wrapper_trait_somes(sx_st);
            (sx_j : usize) = usize(0);
            while(sx_j < sx_nested.len(), {
              sxn_id := match(
                sx_nested.get(sx_j),
                .Some(t) => match(t, .SomeT(id2, _, _, _, _, _, _, _, _, _, _) => id2, _ => String.from("")),
                .None => String.from("")
              );
              if(sxn_id.len() > usize(0), {
                out_ids.push(sxn_id);
              });
              sx_j = (sx_j + usize(1));
            });
            sx_i = (sx_i + usize(1));
          });
        });
        (sx_rest_ids : ArrayList(String)) = ArrayList(String).new();
        (sx_pi : usize) = usize(1);
        while(sx_pi < pt.len(), {
          _sx_push_ids(match(pt.get(sx_pi), .Some(t) => t, .None => t_unit()), sx_rest_ids);
          sx_pi = (sx_pi + usize(1));
        });
        (sx_fi : usize) = usize(0);
        while(sx_fi < ft.len(), {
          _sx_push_ids(match(ft.get(sx_fi), .Some(t) => t, .None => t_unit()), sx_rest_ids);
          sx_fi = (sx_fi + usize(1));
        });
        (sx_self_ids : ArrayList(String)) = ArrayList(String).new();
        _sx_push_ids(match(pt.get(usize(0)), .Some(t) => t, .None => t_unit()), sx_self_ids);
        (sx_si : usize) = usize(0);
        while(sx_si < sx_self_ids.len(), {
          sx_sid := match(sx_self_ids.get(sx_si), .Some(s) => s, .None => String.from(""));
          (sx_in_rest : bool) = false;
          (sx_ri : usize) = usize(0);
          while((sx_ri < sx_rest_ids.len()) && !(sx_in_rest), {
            if(match(sx_rest_ids.get(sx_ri), .Some(r) => (r == sx_sid), .None => false), {
              sx_in_rest = true;
            });
            sx_ri = (sx_ri + usize(1));
          });
          if((sx_sid.len() > usize(0)) && !(sx_in_rest), {
            self_only_ids.push(sx_sid);
          });
          sx_si = (sx_si + usize(1));
        });
      });
      {
        (seen_st_ids : ArrayList(String)) = ArrayList(String).new();
        (sg_i : usize) = usize(0);
        while(sg_i < sig_some_types.len(), {
          sg_st := match(sig_some_types.get(sg_i), .Some(t) => t, .None => t_unit());
          sg_id := match(sg_st, .SomeT(id, _, _, _, _, _, _, _, _, _, _) => id, _ => String.from(""));
          sg_nm := match(sg_st, .SomeT(_, n, _, _, _, _, _, _, _, _, _) => n, _ => String.from(""));
          (sg_dup : bool) = false;
          (sd_i : usize) = usize(0);
          while((sd_i < seen_st_ids.len()) && !(sg_dup), {
            if(match(seen_st_ids.get(sd_i), .Some(s) => (s == sg_id), .None => false), {
              sg_dup = true;
            });
            sd_i = (sd_i + usize(1));
          });
          (sg_self_only : bool) = false;
          if(sg_nm != "Self", {
            (so_i : usize) = usize(0);
            while((so_i < self_only_ids.len()) && !(sg_self_only), {
              if(match(self_only_ids.get(so_i), .Some(s) => (s == sg_id), .None => false), {
                sg_self_only = true;
              });
              so_i = (so_i + usize(1));
            });
          });
          if(((!(sg_dup)) && (sg_nm.len() > usize(0))) && !(sg_self_only), {
            seen_st_ids.push(sg_id);
            (sg_is_forall : bool) = false;
            (sf_i : usize) = usize(0);
            while((sf_i < n_forall) && !(sg_is_forall), {
              if(match(fl.get(sf_i), .Some(l) => (l == sg_nm), .None => false), {
                sg_is_forall = true;
              });
              sf_i = (sf_i + usize(1));
            });
            sg_already_bound := (get_variables_from_env(callee_env, sg_nm).len() > usize(0));
            if(sg_is_forall || !(sg_already_bound), {
              add_variable_to_env(
                callee_env,
                sg_nm,
                t_type(),
                Option(EvalValue).Some(create_type_value(sg_st)),
                true,
                false,
                false,
                false,
                synthetic_token(sg_nm, callee_env.module_path)
              );
            });
            if((!(sg_is_forall)) && !(sg_already_bound), {
              // The updatable second binding for non-generic SomeTs.
              add_variable_to_env(
                callee_env,
                sg_nm,
                t_type(),
                Option(EvalValue).Some(create_type_value(sg_st)),
                true,
                false,
                false,
                false,
                synthetic_token(sg_nm, callee_env.module_path)
              );
            });
          });
          sg_i = (sg_i + usize(1));
        });
      };
      (fpi : usize) = usize(0);
      while(fpi < n_forall, {
        flabel := match(fl.get(fpi), .Some(l) => l, .None => String.from(""));
        ftype := match(ft.get(fpi), .Some(t) => t, .None => t_unit());
        ftype_inner := match(ft.get(fpi), .Some(t) => t, .None => t_unit());
        (forall_val : EvalValue) = EvalValue.UnknownVal(ftype_inner, false);
        // A Type-kinded forall whose SomeT occurs in the SIGNATURE binds as
        // `TypeVal(that SomeT)` — the state TS's calleeEnv is ALWAYS in
        // (`createUnknownValue` promotes a Type-level-0 slot to
        // `TypeVal(SomeType)`, value.ts:547-560; yo-self's UnknownVal
        // placeholder was the port divergence). This is what lets a
        // generic-args type-constructor CALL inside a single-pass body
        // validation EXECUTE (mint the generic-era struct) instead of
        // short-circuiting to a `ctfe_result_*` SomeT that then throws as a
        // callee ("TypeVal SomeT callee without FnTrait" — the
        // tests/iter_filter_closure batch hollow: prelude `filter`'s
        // `IterFilter(Self, F)(...)` with `F` an UnknownVal). Uses the SIG
        // MARKER instance so synthesis keeps one SomeT identity; labels
        // with no signature occurrence keep the UnknownVal placeholder
        // (conservative — their machinery predates this).
        if(match(ftype_inner, .TypeUni(fv_lv) => (fv_lv == usize(0)), _ => false), {
          (fv_marker : Option(TypeValue)) = Option(TypeValue).None;
          (fv_mi : usize) = usize(0);
          while((fv_mi < sig_some_types.len()) && fv_marker.is_none(), {
            match(
              sig_some_types.get(fv_mi),
              .Some(fv_mst) => {
                fv_mn := match(fv_mst, .SomeT(_, n, _, _, _, _, _, _, _, _, _) => n, _ => String.from(""));
                // A receiver-embedded SomeT (self-slot-only) merely SHARES the
                // forall's name — e.g. `.filter(p).fold(init, f)`: fold's
                // sig_some_types lists filter's F (inside the substituted
                // `self : IterFilter(_, F-filter)`) BEFORE fold's own F.
                // Binding the forall to it routes fold's `f` to filter's
                // predicate. TS binds `forallParameter.type` directly — the
                // name search is yo-self's reconstruction, so it must skip
                // foreign ids.
                fv_mid := match(fv_mst, .SomeT(id, _, _, _, _, _, _, _, _, _, _) => id, _ => String.from(""));
                (fv_foreign : bool) = false;
                (fv_si : usize) = usize(0);
                while((fv_si < self_only_ids.len()) && !(fv_foreign), {
                  if(match(self_only_ids.get(fv_si), .Some(s) => (s == fv_mid), .None => false), {
                    fv_foreign = true;
                  });
                  fv_si = (fv_si + usize(1));
                });
                if((fv_mn == flabel) && !(fv_foreign), {
                  fv_marker = Option(TypeValue).Some(fv_mst);
                });
              },
              .None => ()
            );
            fv_mi = (fv_mi + usize(1));
          });
          match(
            fv_marker,
            .Some(fv_found) => {
              forall_val = create_type_value(fv_found);
            },
            .None => {
              // No SIGNATURE occurrence — the label appears only in the
              // where clause (`take : fn(generic(A), self : Self, n : usize,
              // where(Self <: Iterator(Item := A))) -> IterTake(Self)`;
              // `get_all_some_types(func_type)` returns NOTHING for it). TS
              // still binds a TypeVal: `createUnknownValue` PROMOTES every
              // Type-level-0 slot to a fresh SomeType (value.ts:547-560), so
              // its trait-application eval accepts `Iterator(Item := A)` and
              // the constraint synthesis then binds A from the receiver's
              // impl. yo-self's UnknownVal placeholder made that eval throw
              // 'Expected type for associated type constraint "Item"',
              // hollowing every take/skip/enumerate/zip combinator call
              // (v4_take repro; tests/iterator_combinators). Mint the fresh
              // per-call SomeT here — id keyed by the call expr so two calls
              // never share a lineage.
              forall_val = create_type_value(
                TypeValue.SomeT(
                  `${flabel}_wcforall_${ast_expr_id(expr).to_string()}`,
                  flabel.clone(),
                  usize(0),
                  t_type(),
                  ArrayList(TypeValue).new(),
                  ArrayList(usize).new(),
                  ArrayList(TypeValue).new(),
                  ArrayList(usize).new(),
                  false,
                  Option(TypeValue).None,
                  ArrayList(TypeValue).new()
                )
              );
            }
          );
        });
        // If caller supplied explicit generic(…) args, try to resolve.
        match(
          forall_args_opt,
          .Some(fas) => {
            match(
              fas.get(fpi),
              .Some(fa) => {
                if(!(ast_expr_is_atom_of(fa, "_")), {
                  evaled_fa := evaluate_expression_raw(fa, caller_env, ctx, exn);
                  fa_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_fa));
                  match(
                    fa_info_opt,
                    .Some(fa_info) => {
                      match(
                        fa_info.value,
                        .Some(v) => {
                          forall_val = v;
                        },
                        .None => ()
                      );
                    },
                    .None => ()
                  );
                });
              },
              .None => ()
            );
          },
          .None => ()
        );
        add_variable_to_env(
          callee_env,
          flabel,
          ftype,
          Option(EvalValue).Some(forall_val),
          true,
          // is_compile_time_only
          false,
          false,
          false,
          synthetic_token(flabel, callee_env.module_path)
        );
        // This call now OWNS `flabel`: drop any resolution a PREVIOUS call left
        // for the same signature SomeT in the durable id registry. TS mints a
        // fresh SomeType per call for every forall binder (helper.ts:1047-1053),
        // so a stale `B := i32` simply cannot exist there; yo-self reuses the one
        // signature instance, and `_resolve_some_types_deep`'s registry fallback
        // then silently pre-resolved the NEXT call's `Impl(Fn() -> B)` parameter
        // to `Impl(Fn() -> i32)`. That flipped the closure onto the take-on path,
        // which skips the Step-5.5 body-type substitution that binds `B` — so the
        // second `map_or_else` in a batch main returned `unit`
        // (tests/option_result_combinators arms 17+18; either arm alone was fine).
        {
          (fv_clear_i : usize) = usize(0);
          while(fv_clear_i < sig_some_types.len(), {
            match(
              sig_some_types.get(fv_clear_i),
              .Some(fv_cst) => match(
                fv_cst,
                .SomeT({ id : fv_cid, name : fv_cnm }) => if(fv_cnm == flabel, {
                  unregister_some_resolved_concrete(fv_cid.clone());
                }),
                _ => ()
              ),
              .None => ()
            );
            fv_clear_i = (fv_clear_i + usize(1));
          });
        };
        fpi = (fpi + usize(1));
      });
      // ----------------------------------------------------------------
      // Step 6b: io.async — pre-bind the effect-bundle generic `E` from the
      // expected return type. Mirrors TS `helper.ts:1312-1366` (which binds both
      // `T` and `E`). `io.async`'s signature is
      //   fn(generic(T, E), action : Impl(Fn(e : E) -> T)) -> Impl(Future(T, E))
      // and the closure argument's parameter type references `E`. When the call
      // has an expected type `Impl(Future(T, E_concrete))`, bind `E` to that
      // concrete effect bundle in `callee_env` NOW — before the argument loop —
      // so Step 7's `evaluate_function_parameter_type_again` resolves the closure
      // param `Impl(Fn(e : E) -> T)` to `Impl(Fn(e : E_concrete) -> T)` and the
      // closure body binds `e` with the concrete bundle. Without this, `e : SomeT
      // E` reaches codegen as `void*` and `e.io`/`e.exn` emit `member reference
      // base type 'void *'` (the stage-2 bundle-field-as-arg cluster).
      //
      // DELIBERATELY binds ONLY `E`, not `T` (the future OUTPUT), unlike TS: the
      // yo-self async pipeline keeps the future output as an UNRESOLVED SomeType
      // through eval (the sync-future struct + io.await refinement are registered
      // against that SomeType id; resolving `T` here breaks that registration and
      // regresses all async — see issues/fixed/yo-self-async-await-struct-result-eval.md
      // and the [[yo-self-stage2-family-breakdown]] async-codegen note). `E` (the
      // effect bundle) is NOT part of that pipeline, so binding it is safe.
      // yo-self has no `ioBuiltin` type marker (await_analysis.yo) — detect the
      // call structurally. Guard: only bind a label not already concrete.
      if(is_io_async_call(expr), {
        match(
          ctx.expected_type,
          .Some(io_exp) => match(
            extract_future_trait_from_type(io_exp.ty),
            .Some(io_ftt) => match(
              io_ftt,
              .FutureTraitT({ output : io_t_out, effect_types : io_ets }) => {
                // Bind the future OUTPUT generic `T` when the expected output is
                // concrete (TS binds T unconditionally at helper.ts:1334-1362;
                // yo-self guards on concreteness because the async pipeline's
                // sync-future/io.await refinements are keyed on the UNRESOLVED
                // SomeT id — a SomeT-to-SomeT bind would break them for the
                // no-expected case, which must keep working as before). With
                // `T := unit` bound, the io.async closure argument's Fn type
                // resolves to `Fn(e : E_conc) -> unit`, the closure BODY is
                // evaluated with expected `unit`, and a ctl `exn.throw(...)`
                // arm inside types as `unit` (the Step-10 adopt) — so the
                // def-time body eval survives and the closure gets ExprInfo +
                // FSM treatment (the self-capture io.async FTT family).
                if(!(is_some_type(io_t_out)), {
                  (tb_i : usize) = usize(0);
                  while(tb_i < n_forall, {
                    tb_label := match(fl.get(tb_i), .Some(l) => l, .None => String.from(""));
                    if(tb_label == "T", {
                      tb_existing := get_variables_from_env(callee_env, tb_label.clone());
                      (tb_already : bool) = false;
                      if(tb_existing.len() > usize(0), {
                        match(
                          tb_existing.get(tb_existing.len() - usize(1)),
                          .Some(tb_var) => match(
                            tb_var.value.get(usize(0)),
                            .Some(tb_val) => if(is_type_val(tb_val), {
                              match(
                                tb_val,
                                .TypeVal(tb_tv) => if(!(is_some_type(tb_tv)), {
                                  tb_already = true;
                                }),
                                _ => ()
                              );
                            }),
                            .None => ()
                          ),
                          .None => ()
                        );
                      });
                      if(!(tb_already), {
                        add_variable_to_env(
                          callee_env,
                          tb_label.clone(),
                          t_type(),
                          Option(EvalValue).Some(create_type_value(io_t_out.clone())),
                          true,
                          false,
                          false,
                          false,
                          synthetic_token(tb_label.clone(), callee_env.module_path)
                        );
                      });
                    });
                    tb_i = (tb_i + usize(1));
                  });
                });
                match(
                  io_ets.get(usize(0)),
                  .Some(io_e_conc) => if(!(is_some_type(io_e_conc)), {
                    (eb_i : usize) = usize(0);
                    while(eb_i < n_forall, {
                      eb_label := match(fl.get(eb_i), .Some(l) => l, .None => String.from(""));
                      if(eb_label == "E", {
                        // Skip when already bound to a concrete (non-SomeType) value.
                        eb_existing := get_variables_from_env(callee_env, eb_label.clone());
                        (eb_already : bool) = false;
                        if(eb_existing.len() > usize(0), {
                          match(
                            eb_existing.get(eb_existing.len() - usize(1)),
                            .Some(eb_var) => match(
                              eb_var.value.get(usize(0)),
                              .Some(eb_val) => if(is_type_val(eb_val), {
                                match(
                                  eb_val,
                                  .TypeVal(eb_tv) => if(!(is_some_type(eb_tv)), {
                                    eb_already = true;
                                  }),
                                  _ => ()
                                );
                              }),
                              .None => ()
                            ),
                            .None => ()
                          );
                        });
                        if(!(eb_already), {
                          add_variable_to_env(
                            callee_env,
                            eb_label.clone(),
                            t_type(),
                            Option(EvalValue).Some(create_type_value(io_e_conc.clone())),
                            true,
                            false,
                            false,
                            false,
                            synthetic_token(eb_label.clone(), callee_env.module_path)
                          );
                        });
                      });
                      eb_i = (eb_i + usize(1));
                    });
                  }),
                  .None => ()
                );
              },
              _ => ()
            ),
            .None => ()
          ),
          .None => ()
        );
      });
      // ----------------------------------------------------------------
      // Step 6c: EARLY where-clause application — port of TS helper.ts:1368-
      // 1408. TS applies ALL the where-clause constraint exprs before the
      // argument loop when every `lhs <: rhs` LHS atom is a variable in
      // calleeEnv, which binds method-level generics that are only derivable
      // from a constraint — `where(Self <: Iterator(Item := A))` on the
      // blanket Iterator combinators binds `A` from the CONCRETE receiver's
      // impl — so a closure argument checked against `F : (Fn(item : A) ->
      // bool)` types its params concretely instead of leaving SomeTs (the
      // `void*` closure param; tests/closure_capture_rc_leak,
      // issues/repros/iterator-any-closure-void-param.yo).
      //
      // ADAPTATION (not in TS): apply PER-EXPR, and only when the LHS's
      // CURRENT binding is a TYPE value. TS's calleeEnv binds forall params
      // as SomeType TYPE values, so its all-or-nothing "LHS exists" guard is
      // safe; yo-self's Step 6 binds them as UnknownVal placeholders, and
      // `apply_where_clause_constraints` on that state throws 'Expected type
      // for left-hand side...' — measured hollowing EVERY `!`/`not` call
      // body (`where(_Self <: LogicalNot)`; enum_ne_dispatch FTT, iso/rc
      // rc=139, sys/bufio + imm_list/imm_string hollow). The same
      // TypeVal-state condition already guards the Step-8b reapply. The
      // Step-8b re-application after the argument loop still applies the
      // full set once the foralls are concretely bound.
      match(
        func_val,
        .Some(ew_fv) => match(
          ew_fv,
          .FuncVal(ew_fvd, _) => {
            ew_exprs := get_func_where_clause_exprs(ew_fvd.*.func_id.clone());
            if(ew_exprs.len() > usize(0), {
              ew_apply := ArrayList(AstExpr).new();
              (ew_i : usize) = usize(0);
              while(ew_i < ew_exprs.len(), {
                match(
                  ew_exprs.get(ew_i),
                  .Some(ew_e) => {
                    if(ast_expr_is_fn_call_of(ew_e, "<:", .Some(usize(2))), {
                      ew_args := _h_get_fn_call_args(ew_e);
                      match(
                        ew_args.get(usize(0)),
                        .Some(ew_lhs) => {
                          if(ast_expr_is_atom(ew_lhs), {
                            ew_vars := get_variables_from_env(callee_env, ast_expr_token(ew_lhs).value);
                            if(ew_vars.len() > usize(0), {
                              match(
                                ew_vars.get(ew_vars.len() - usize(1)),
                                .Some(ew_var) => match(
                                  ew_var.value.get(usize(0)),
                                  .Some(ew_val) => {
                                    if(is_type_val(ew_val), {
                                      ew_apply.push(clone_expr_fresh_ids(ew_e));
                                    });
                                  },
                                  .None => ()
                                ),
                                .None => ()
                              );
                            });
                          });
                        },
                        .None => ()
                      );
                    });
                  },
                  .None => ()
                );
                ew_i = (ew_i + usize(1));
              });
              if(ew_apply.len() > usize(0), {
                // PREBIND: any forall label the applied constraints reference
                // that is still bound to the Step-6 UnknownVal placeholder is
                // rebound (a NEW last binding) to a TypeVal of its signature
                // SomeT — the state TS's calleeEnv is ALWAYS in: TS
                // `createUnknownValue` returns `TypeVal(SomeType)` for a
                // Type-typed forall (value.ts:547-560), which is why TS's
                // trait-application eval accepts `Iterator(Item := A)` with
                // `A` unresolved (it stores the SomeT and the constraint
                // synthesis then binds it). Without this, the eval throws
                // 'Expected type for associated type constraint "Item", got:
                // A' and the arm hollows. Scoped to the labels the applied
                // exprs actually name so every other call keeps the
                // UnknownVal-last invariant untouched.
                ew_names := ArrayList(String).new();
                (ew_ni : usize) = usize(0);
                while(ew_ni < ew_apply.len(), {
                  match(
                    ew_apply.get(ew_ni),
                    .Some(ew_ae) => _collect_atom_names_into(ew_ae, ew_names),
                    .None => ()
                  );
                  ew_ni = (ew_ni + usize(1));
                });
                (ew_fi : usize) = usize(0);
                while(ew_fi < fl.len(), {
                  ew_fl := match(fl.get(ew_fi), .Some(l) => l, .None => String.from(""));
                  (ew_named : bool) = false;
                  (ew_nj : usize) = usize(0);
                  while((ew_nj < ew_names.len()) && !(ew_named), {
                    match(
                      ew_names.get(ew_nj),
                      .Some(nn) => if(nn == ew_fl, {
                        ew_named = true;
                      }),
                      .None => ()
                    );
                    ew_nj = (ew_nj + usize(1));
                  });
                  if(ew_named, {
                    ew_fvars := get_variables_from_env(callee_env, ew_fl);
                    (ew_is_unknown : bool) = false;
                    match(
                      ew_fvars.get(ew_fvars.len() - usize(1)),
                      .Some(ew_fvar) => match(
                        ew_fvar.value.get(usize(0)),
                        .Some(ew_fval) => match(
                          ew_fval,
                          .UnknownVal(_, _) => {
                            ew_is_unknown = true;
                          },
                          _ => ()
                        ),
                        .None => ()
                      ),
                      .None => ()
                    );
                    if(ew_is_unknown, {
                      (ew_mi : usize) = usize(0);
                      (ew_done : bool) = false;
                      while((ew_mi < sig_some_types.len()) && !(ew_done), {
                        match(
                          sig_some_types.get(ew_mi),
                          .Some(ew_mst) => {
                            ew_mn := match(ew_mst, .SomeT(_, n, _, _, _, _, _, _, _, _, _) => n, _ => String.from(""));
                            if(ew_mn == ew_fl, {
                              add_variable_to_env(
                                callee_env,
                                ew_fl.clone(),
                                t_type(),
                                Option(EvalValue).Some(create_type_value(ew_mst)),
                                true,
                                false,
                                false,
                                false,
                                synthetic_token(ew_fl.clone(), callee_env.module_path)
                              );
                              ew_done = true;
                            });
                          },
                          .None => ()
                        );
                        ew_mi = (ew_mi + usize(1));
                      });
                    });
                  });
                  ew_fi = (ew_fi + usize(1));
                });
                ew_prev := ctx.is_evaluating_function_type;
                ctx.is_evaluating_function_type = true;
                _try_apply_early_where_clauses(ew_apply, callee_env, ctx);
                ctx.is_evaluating_function_type = ew_prev;
                // Post-application durable assoc binding: the check's own
                // `A := i32` synthesis can land in a scratch frame that pops
                // before the argument loop (yo-self's mutable push/pop envs;
                // TS keeps the binding via the returned env chain,
                // helper.ts:1397-1405). For every applied `lhs <: Trait(assoc
                // := X)` whose X forall is STILL not concretely bound, resolve
                // the assoc from the lhs's concrete target through the same
                // registry channels the check used, and bind X here in the
                // callee env's own frame (`.filter(p).fold(init, f)`: fold's
                // closure needs `A := i32` before its `f` argument types —
                // else the closure's `item` param registers as the raw SomeT
                // and emits `void*`; iterator_combinators arm 18).
                (ewa_i : usize) = usize(0);
                while(ewa_i < ew_apply.len(), {
                  ewa_e := match(ew_apply.get(ewa_i), .Some(e) => e, .None => make_err_expr());
                  if(ast_expr_is_fn_call_of(ewa_e, "<:", .Some(usize(2))), {
                    ewa_args := _h_get_fn_call_args(ewa_e);
                    ewa_lhs := match(ewa_args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
                    ewa_rhs := match(ewa_args.get(usize(1)), .Some(a) => a, .None => make_err_expr());
                    if(ast_expr_is_atom(ewa_lhs) && ast_expr_is_fn_call(ewa_rhs), {
                      // Resolve the LHS variable to a concrete TypeVal target.
                      (ewa_target : Option(TypeValue)) = Option(TypeValue).None;
                      {
                        ewa_lvars := get_variables_from_env(callee_env, ast_expr_token(ewa_lhs).value);
                        if(ewa_lvars.len() > usize(0), {
                          match(
                            ewa_lvars.get(ewa_lvars.len() - usize(1)),
                            .Some(lv) => match(
                              lv.value.get(usize(0)),
                              .Some(lvv) => match(
                                lvv,
                                .TypeVal(lvt) => if(!(is_some_type(lvt)), {
                                  ewa_target = Option(TypeValue).Some(lvt);
                                }),
                                _ => ()
                              ),
                              .None => ()
                            ),
                            .None => ()
                          );
                        });
                      };
                      match(
                        ewa_target,
                        .Some(ewa_tt) => {
                          ewa_rargs := _h_get_fn_call_args(ewa_rhs);
                          (ewa_ri : usize) = usize(0);
                          while(ewa_ri < ewa_rargs.len(), {
                            ewa_ra := match(ewa_rargs.get(ewa_ri), .Some(a) => a, .None => make_err_expr());
                            if(ast_expr_is_fn_call_of(ewa_ra, ":=", .Some(usize(2))), {
                              ewa_pair := _h_get_fn_call_args(ewa_ra);
                              ewa_al := match(ewa_pair.get(usize(0)), .Some(a) => a, .None => make_err_expr());
                              ewa_av := match(ewa_pair.get(usize(1)), .Some(a) => a, .None => make_err_expr());
                              if(ast_expr_is_atom(ewa_al) && ast_expr_is_atom(ewa_av), {
                                ewa_xn := ast_expr_token(ewa_av).value;
                                // Only forall labels of THIS call, still unbound.
                                (ewa_is_fl : bool) = false;
                                (ewa_fi : usize) = usize(0);
                                while((ewa_fi < fl.len()) && !(ewa_is_fl), {
                                  if(match(fl.get(ewa_fi), .Some(l) => (l == ewa_xn), .None => false), {
                                    ewa_is_fl = true;
                                  });
                                  ewa_fi = (ewa_fi + usize(1));
                                });
                                (ewa_unbound : bool) = true;
                                {
                                  ewa_xvars := get_variables_from_env(callee_env, ewa_xn);
                                  if(ewa_xvars.len() > usize(0), {
                                    match(
                                      ewa_xvars.get(ewa_xvars.len() - usize(1)),
                                      .Some(xv) => match(
                                        xv.value.get(usize(0)),
                                        .Some(xvv) => match(
                                          xvv,
                                          .TypeVal(xvt) => if(!(is_some_type(xvt)), {
                                            ewa_unbound = false;
                                          }),
                                          _ => ()
                                        ),
                                        .None => ()
                                      ),
                                      .None => ()
                                    );
                                  });
                                };
                                if(ewa_is_fl && ewa_unbound, {
                                  match(
                                    resolve_assoc_type_for_target(ewa_tt, ast_expr_token(ewa_al).value, callee_env),
                                    .Some(ewa_res) => if(!(is_some_type(ewa_res)), {
                                      add_variable_to_env(
                                        callee_env,
                                        ewa_xn.clone(),
                                        t_type(),
                                        Option(EvalValue).Some(create_type_value(ewa_res)),
                                        true,
                                        false,
                                        false,
                                        false,
                                        synthetic_token(ewa_xn.clone(), callee_env.module_path)
                                      );
                                    }),
                                    .None => ()
                                  );
                                });
                              });
                            });
                            ewa_ri = (ewa_ri + usize(1));
                          });
                        },
                        .None => ()
                      );
                    });
                  });
                  ewa_i = (ewa_i + usize(1));
                });
              });
            });
          },
          _ => ()
        ),
        .None => ()
      );
      // ----------------------------------------------------------------
      // Step 7: Process regular parameters.
      // ----------------------------------------------------------------
      forall_arg_vals := ArrayList(ArgEntry).new();
      arg_vals := ArrayList(ArgEntry).new();
      rt_args := ArrayList(AstExpr).new();
      (callee_env_m : Environment) = callee_env;
      // Def-time-trial isolation: a nested method call's `callee_env` is the
      // FuncVal's captured DEFINITION env — a SHARED, durable frame stack.
      // Step-6 generic synthesis and Step-9 param binds below write into its
      // TOP frame; during a trial those writes are junk the moment the trial
      // ends, but the shared frame keeps them (the [bind-T] K := unit write
      // into hash_map's def frame that later specialized `_find_bucket` with
      // `key : unit` — hash_map:714 of the corpus family). TS's persistent
      // chains scope these automatically (updates fork the chain); the
      // yo-self equivalent is a scratch frame on a LOCAL copy — the body
      // eval threads callee_env_m and sees every binding, the shared def
      // env object never does. Trials only: the concrete path's frame
      // arithmetic (function_declaration_frame_level readers) keeps its
      // long-standing layout.
      if(in_def_time_trial(), {
        callee_env_m = snapshot_env(callee_env);
        callee_env_m.push_frame(false);
      });
      (caller_env_m : Environment) = caller_env;
      // io.async: evaluate the closure ARGUMENT under async-block context
      // (mirrors TS helper.ts:1314-1315 setting isInsideIoAsyncCall in
      // tryToCall — the OTHER route, function.yo:3369, already sets it; this
      // route previously did not, which is why the flag measured FALSE at
      // closure eval and could not gate the closure take-on-expected-type
      // port). Restored after the arg loop.
      h_prev_io_async_ctx := ctx.is_inside_io_async_call;
      if(is_io_async_call(expr), {
        ctx.is_inside_io_async_call = true;
      });
      // io-builtin args (io.await/io.state/io.spawn/JoinHandle.await) must be
      // evaluated WITHOUT an expected type so the future arg keeps its natural
      // type (TS helper.ts:378-384 `functionType.ioBuiltin` skip). yo-self has no
      // `ioBuiltin` marker, so detect the call structurally here (once).
      io_builtin_skip_expected := (((is_io_await_call(expr) || is_io_state_call(expr)) || is_io_spawn_call(expr)) || is_join_handle_await_call(expr));
      // io.async params use the (per-call freshened) declared type DIRECTLY —
      // but ONLY when the call has NO Future-carrying expected type. WITH a
      // return constraint, Step-6b above pre-bound `E` (and a concrete `T`)
      // into THIS call's placeholder frame, and Step-2's re-evaluation is the
      // delivery mechanism for those call-local bindings (the un-annotated
      // `(e) => e.io…` bundle actions depend on it —
      // tests/codegen-bootstrap/io_async_bundle_field.yo documents the flow).
      // WITHOUT a constraint, the re-evaluation can only read AMBIENT
      // same-named bindings — a sibling call's leaked resolution (the
      // [DRIVER]-probe-confirmed `Fn(e : Io) -> unit` poison, 126x per
      // async_await batch). See the Step-2 note in
      // check_if_function_parameter_matches_argument.
      io_async_has_ret_constraint := (
        is_io_async_call(expr) && match(
          ctx.expected_type,
          .Some(io_exp0) => extract_future_trait_from_type(io_exp0.ty).is_some(),
          .None => false
        )
      );
      io_async_param_direct := (is_io_async_call(expr) && !(io_async_has_ret_constraint));
      (pi : usize) = usize(0);
      // Aliasing Stage 0: per-call `___drop(<dup temp>)`s from the params
      // (CheckParamResult.s0_drop) — attached to the call node via
      // FuncCallResult.deferred_drop_expressions (post-call flush).
      s0_call_drops := ArrayList(AstExpr).new();
      // Aliasing Stage 1: the marked argument exprs (parallel channel) —
      // unmarked below when the callee specialization proves read-only.
      s0_marked_args := ArrayList(AstExpr).new();
      (s1_elided : bool) = false;
      while(pi < n_params, {
        plabel := match(pl.get(pi), .Some(l) => l, .None => String.from(""));
        ptype := match(pt.get(pi), .Some(t) => t, .None => t_unit());
        p_owning := match(pio.get(pi), .Some(o) => o, .None => false);
        // Omitted optional parameter (no corresponding argument): clone the
        // recorded default VALUE EXPRESSION and route it through the SAME
        // matching flow as an explicit argument. In TS the omitted branch
        // (helper.ts:323-344) merges into the shared post-processing after
        // evaluating the default — comptime→runtime conversion, generic
        // synthesis into callee_env, compatibility check, and the param
        // binding all run for defaults too. Skipping them left the generic
        // type param UNBOUND for calls relying on the default (e.g. bare
        // `assert(x)`: `panic(msg)` then specialized at an unresolved SomeT
        // → unemitted C fn → clang undeclared-function). Differences from an
        // explicit arg, mirroring TS: the default is evaluated in the CALLEE
        // env (helper.ts:330-336), the caller env is NOT updated from the
        // match result, and the move-ownership step never runs (TS runs it
        // only in the explicit-arg branch) — pass param_is_owning=false.
        if(pi >= n_args, {
          (default_expr : Option(AstExpr)) = Option(AstExpr).None;
          match(
            call_param_default_exprs.get(pi),
            .Some(de_opt) => {
              default_expr = de_opt;
            },
            .None => ()
          );
          match(
            default_expr,
            .Some(de) => {
              cloned_de := clone_expr_fresh_ids(de);
              dpr := check_if_function_parameter_matches_argument(
                plabel,
                ptype,
                // is_ct_only: honour the param's comptime modifier here too, so
                // a comptime param's default keeps its raw comptime type.
                match(call_param_comptime.get(pi), .Some(f) => f, .None => false),
                // param_is_owning: TS never runs move-ownership for defaults
                false,
                match(pref.get(pi), .Some(b) => b, .None => false),
                false,
                io_async_param_direct,
                cloned_de,
                callee_env_m,
                callee_env_m,
                ctx,
                rt_args,
                exn
              );
              callee_env_m = dpr.callee_env;
              arg_vals.push(
                ArgEntry(
                  value : dpr.arg_value,
                  parameter_type : dpr.resolved_param_type,
                  arg_type : dpr.arg_type
                )
              );
            },
            .None => {
              // Defensive fallback when no default expr is recorded: bind the
              // recorded default VALUE (or an `UnknownVal` of the declared
              // type) so the callee body still sees the parameter.
              (omitted_val : EvalValue) = create_unknown_val(ptype);
              match(
                call_param_defaults.get(pi),
                .Some(d) => match(
                  d,
                  .Some(dv) => {
                    omitted_val = dv;
                  },
                  .None => ()
                ),
                .None => ()
              );
              add_variable_to_env(
                callee_env_m,
                plabel,
                ptype,
                Option(EvalValue).Some(omitted_val),
                false,
                false,
                false,
                false,
                synthetic_token(plabel, callee_env_m.module_path)
              );
              arg_vals.push(
                ArgEntry(
                  value : Option(EvalValue).Some(omitted_val),
                  parameter_type : ptype,
                  arg_type : ptype
                )
              );
            }
          );
          pi = (pi + usize(1));
          continue;
        });
        parg := match(adjusted_args.get(pi), .Some(a) => a, .None => make_err_expr());
        pr := check_if_function_parameter_matches_argument(
          plabel,
          ptype,
          // is_ct_only: the parameter's `comptime(...)` modifier (from the
          // per-param comptime side-table). A comptime param keeps its raw
          // comptime arg type; a runtime param lowers a comptime-only arg to
          // its runtime type (mirrors TS `!parameter.isCompileTimeOnly`).
          match(call_param_comptime.get(pi), .Some(f) => f, .None => false),
          p_owning,
          match(pref.get(pi), .Some(b) => b, .None => false),
          io_builtin_skip_expected,
          io_async_param_direct,
          parg,
          callee_env_m,
          caller_env_m,
          ctx,
          rt_args,
          exn,
          match(call_param_assigned.get(pi), .Some(a) => a, .None => Option(EvalValue).None),
          callee_is_extern
        );
        match(
          pr.s0_drop,
          .Some(s0d) => {
            s0_call_drops.push(s0d);
          },
          .None => ()
        );
        match(
          pr.s0_marked_arg,
          .Some(s0ma) => {
            s0_marked_args.push(s0ma);
          },
          .None => ()
        );
        callee_env_m = pr.callee_env;
        caller_env_m = pr.caller_env;
        arg_vals.push(
          ArgEntry(
            value : pr.arg_value,
            parameter_type : pr.resolved_param_type,
            arg_type : pr.arg_type
