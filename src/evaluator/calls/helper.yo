// ---------------------------------------------------------------------------
// extract_function_value
// ---------------------------------------------------------------------------
/// Extract a FuncVal from an optional EvalValue.
/// Closures are runtime-only and have no FuncVal at compile time.
///
/// Mirrors `extractFunctionValue` in `src/evaluator/calls/helper.ts`.
extract_function_value :: (fn(value : Option(EvalValue)) -> Option(EvalValue))(
  match(
    value,
    .None => Option(EvalValue).None,
    .Some(v) => match(
      v,
      .FuncVal(_, _) => Option(EvalValue).Some(v),
      _ => Option(EvalValue).None
    )
  )
);
// ---------------------------------------------------------------------------
// _module_type_contains_ctl_field
// ---------------------------------------------------------------------------
/// Return true if any field of `module_type` is a "control function"
/// (one that uses `unwind` to control the continuation).
///
/// Mirrors `moduleTypeContainsCtlField` in `src/evaluator/calls/helper.ts`.
/// Uses the global control-function registry since FuncVal has no isControlFunction flag.
_module_type_contains_ctl_field :: (
  fn(
    module_type : TypeValue,
    module_val : Option(EvalValue)
  ) -> bool
)(
  match(
    module_type,
    .Struct({ field_labels : field_labels, field_types : field_types, is_source_namespace : m_sns }) => cond(
      !(m_sns) => false,
      true => {
        n := field_types.len();
        (fi : usize) = usize(0);
        (found : bool) = false;
        while((fi < n) && (!(found)), {
          field_ty := match(field_types.get(fi), .Some(t) => t, .None => TypeValue.Unit);
          (field_val_opt : Option(EvalValue)) = match(
            module_val,
            .None => Option(EvalValue).None,
            .Some(mv) => match(
              mv,
              .StructVal(_, _, vals) => match(
                vals.get(fi),
                .Some(v) => Option(EvalValue).Some(v),
                .None => Option(EvalValue).None
              ),
              _ => Option(EvalValue).None
            )
          );
          // Check if field is a Func type and value is a control function
          is_func_field := match(field_ty, .Func({ result : _ }) => true, _ => false);
          if(is_func_field, {
            match(
              field_val_opt,
              .Some(fv) => match(
                fv,
                .FuncVal(__fvd1, _) => {
                  if(is_control_fn(__fvd1.*.func_id.clone()), {
                    found = true;
                  });
                },
                _ => ()
              ),
              .None => ()
            );
          });
          // Recurse into nested module fields
          is_module_field := match(field_ty, .Struct({ is_source_namespace : f_sns }) => f_sns, _ => false);
          if(is_module_field && (!(found)), {
            (inner_module_val_opt : Option(EvalValue)) = match(
              field_val_opt,
              .None => Option(EvalValue).None,
              .Some(fv) => match(
                fv,
                .StructVal(_, _, _) => Option(EvalValue).Some(fv),
                _ => Option(EvalValue).None
              )
            );
            if(recur(field_ty, inner_module_val_opt), {
              found = true;
            });
          });
          fi = (fi + usize(1));
        });
        found
      }
    ),
    _ => false
  )
);
// `_get_variables_needing_drop` stub retired — the full
// `getVariablesNeedingDrop` port lives at
// `src/env.yo:get_variables_needing_drop` after the
// env.yo ↔ types/utils.yo import cycle was broken.
// ---------------------------------------------------------------------------
// generate_deferred_drop_expressions
// ---------------------------------------------------------------------------
/// Generate `___drop(varName)` expressions for variables that need RC cleanup.
///
/// Phase 3: returns `None` (no variables qualify with the current stub for
/// `type_contains_rc_type`).
///
/// Mirrors `generateDeferredDropExpressions` in `src/evaluator/calls/helper.ts`.
generate_deferred_drop_expressions :: (
  fn(
    variables_to_drop : ArrayList(Variable),
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> Option(ArrayList(AstExpr))
)({
  n := variables_to_drop.len();
  if(n == usize(0), {
    return(Option(ArrayList(AstExpr)).None);
  });
  deferred := ArrayList(AstExpr).new();
  (cur_env : Environment) = env;
  (i : usize) = usize(0);
  while(i < n, {
    match(
      variables_to_drop.get(i),
      .Some(variable) => {
        // Build the drop expression: ___drop(varName)
        drop_code := `___drop(${variable.name})`;
        drop_expr := generate_expr_from_code(drop_code.clone(), exn);
        evaluated := evaluate_expression_raw(drop_expr, cur_env, ctx, exn);
        // Phase 3: env update from ExprInfo is skipped; cur_env stays unchanged.
        evaluated;
        deferred.push(evaluated);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  if(
    deferred.len() == usize(0),
    Option(ArrayList(AstExpr)).None,
    Option(ArrayList(AstExpr)).Some(deferred)
  )
});
// ---------------------------------------------------------------------------
// validate_function_return_type
// ---------------------------------------------------------------------------
/// Validate that the return type does not contain unresolved SomeType variables
/// that cannot be inferred from the caller's environment.
///
/// Throws an Exception if a SomeType is found in the return type that has no
/// corresponding variable in the env AND is not a Future/Fn impl type.
///
/// Mirrors `validateFunctionReturnType` in `src/evaluator/calls/helper.ts`.
validate_function_return_type :: (
  fn(
    return_type : TypeValue,
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> unit
)({
  // Skip validation if inside function-type evaluation or when expected type is set.
  if(ctx.is_evaluating_function_type, {
    return(());
  });
  if(ctx.expected_type.is_some(), {
    return(());
  });
  some_types := get_all_some_types(return_type);
  n := some_types.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      some_types.get(i),
      .None => (),
      .Some(st) =>
        match(
          st,
          .SomeT(_, name, _, _, required_trait_types, _, _, _, _, _, _) => {
            // Determine whether this SomeT should be skipped.
            should_skip := (
              type_implements_future(st) ||
                type_implements_fn(st) ||
                  (required_trait_types.len() > usize(0))
            );
            if(!(should_skip), {
              // Check if name is directly in the env.
              vars := get_variables_from_env(env, name);
              if(vars.len() == usize(0), {
                // Check transitively via all variables' TypeVal values.
                all_vars := get_all_variables_from_env(env);
                (found_transitively : bool) = false;
                (j : usize) = usize(0);
                nv := all_vars.len();
                while((j < nv) && !(found_transitively), {
                  match(
                    all_vars.get(j),
                    .Some(var) => {
                      match(
                        var.value.get(usize(0)),
                        .Some(ev) => {
                          match(
                            ev,
                            .TypeVal(ty_box) => {
                              transitive := get_all_some_types(ty_box);
                              (k : usize) = usize(0);
                              while((k < transitive.len()) && !(found_transitively), {
                                match(
                                  transitive.get(k),
                                  .Some(tst) => {
                                    match(
                                      tst,
                                      .SomeT(_, tname, _, _, _, _, _, _, _, _, _) => {
                                        if(tname == name, {
                                          found_transitively = true;
                                        });
                                      },
                                      _ => ()
                                    );
                                  },
                                  .None => ()
                                );
                                k = (k + usize(1));
                              });
                            },
                            _ => ()
                          );
                        },
                        .None => ()
                      );
                    },
                    .None => ()
                  );
                  j = (j + usize(1));
                });
                // Not found even transitively — throw error.
                if(!(found_transitively), {
                  exn.throw(
                    dyn(
                      format_error_message(
                        ast_expr_token(expr),
                        String.from("Failed to infer the function call return type.\nPlease consider providing the expected type."),
                        false,
                        .None
                      )
                    )
                  );
                });
              });
            });
          },
          _ => ()
        )
    );
    i = (i + usize(1));
  });
});
// ---------------------------------------------------------------------------
// Local helper: extract the args ArrayList from a FnCall AstExpr.
// ---------------------------------------------------------------------------
_h_get_fn_call_args :: (fn(e : AstExpr) -> ArrayList(AstExpr))(
  match(
    e,
    .FnCall(_, _, args, _, _) => args,
    .Atom(_, _) => ArrayList(AstExpr).new()
  )
);
// ---------------------------------------------------------------------------
// CheckParamResult — result of check_if_function_parameter_matches_argument
// ---------------------------------------------------------------------------
CheckParamResult :: ref(
  struct(
    callee_env : Environment,
    caller_env : Environment,
    arg_value : Option(EvalValue),
    arg_type : TypeValue,
    resolved_param_type : TypeValue,
    /// Aliasing Stage 0: the synthesized `___drop(<dup temp>)` balancing this
    /// argument's projection dup — the CALLER attaches it to the call node's
    /// deferred drops (single post-call emission; scope-end machinery emits
    /// on non-exclusive exits, see the marker's note in utils.yo).
    s0_drop : Option(AstExpr),
    /// Aliasing Stage 1: the evaluated argument expr that received the
    /// Stage-0 dup — the caller UNMARKS it (removes the deferred dup and
    /// discards `s0_drop`) when the callee specialization proves read-only
    /// (evaluator/effects/mutation_summary.yo).
    s0_marked_arg : Option(AstExpr)
  )
);
// ---------------------------------------------------------------------------
// check_if_function_parameter_matches_argument
// Phase 3 port of checkIfFunctionParameterMatchesArgument (helper.ts).
// ---------------------------------------------------------------------------
/// TRUE when the type (shallowly recursively) contains an Array with an
/// UNRESOLVED length variable (`Array(i32, n)` — a value-generic length).
/// Such a type is generic for codegen even though it carries NO SomeT, so
/// the return-type re-evaluation fallback must fire for it too (the
/// comptime-value-param family: `fn(comptime(n) : usize) -> Array(i32, n)`
/// specs otherwise kept the unresolved return and emitted
/// `// Unknown type:` into the C prototype).
/// Depth-bounded core of `_type_has_array_len_var`: struct/enum stamps can
/// wrap the len-var-bearing Array field (`_ArrayIter(T, N)._arr : Array(T,
/// N)`), and struct graphs can be recursive — bound the descent instead of
/// tracking visited ids.
_type_has_array_len_var_d :: (fn(t : TypeValue, d : usize) -> bool)(
  cond(
    (d > usize(6)) => false,
    true => match(
      t,
      .Array(alv_elem, _, alv_var) => cond(
        (alv_var.len() > usize(0)) => true,
        true => recur(alv_elem, d + usize(1))
      ),
      .Pointer(alv_p) => recur(alv_p, d + usize(1)),
      .IsoT(alv_i) => recur(alv_i, d + usize(1)),
      .Struct({ field_types : alv_fts }) => {
        (alv_found : bool) = false;
        (alv_i2 : usize) = usize(0);
        while((alv_i2 < alv_fts.len()) && !(alv_found), {
          match(
            alv_fts.get(alv_i2),
            .Some(alv_ft) => if(recur(alv_ft, d + usize(1)), {
              alv_found = true;
            }),
            .None => ()
          );
          alv_i2 = (alv_i2 + usize(1));
        });
        alv_found
      },
      .EnumT({ variant_fields : alv_vfs }) => {
        (alv_found2 : bool) = false;
        (alv_vi : usize) = usize(0);
        while((alv_vi < alv_vfs.len()) && !(alv_found2), {
          alv_vf := match(alv_vfs.get(alv_vi), .Some(f) => f, .None => ArrayList(TypeValue).new());
          (alv_vj : usize) = usize(0);
          while((alv_vj < alv_vf.len()) && !(alv_found2), {
            match(
              alv_vf.get(alv_vj),
              .Some(alv_vt) => if(recur(alv_vt, d + usize(1)), {
                alv_found2 = true;
              }),
              .None => ()
            );
            alv_vj = (alv_vj + usize(1));
          });
          alv_vi = (alv_vi + usize(1));
        });
        alv_found2
      },
      _ => false
    )
  )
);
_type_has_array_len_var :: (fn(t : TypeValue) -> bool)(_type_has_array_len_var_d(t, usize(0)));
/// Trial-evaluate a declared return-type EXPR in the mint env (SWALLOWING —
/// the local `->` exn cannot capture, so a failing eval just leaves `out`
/// empty). On success pushes the evaluated TypeValue. Port shape of TS
/// `evaluateFunctionReturnTypeAgain` (function.ts:2822): re-EVALUATING the
/// expr (vs substituting the def-era TypeValue) routes generic instantiations
/// in the return (`*(Pair(K, V))`) through the SAME memoized type-constructor
/// as the body's own calls — one instantiation lineage (the imm_map
/// `_alloc_pairs` expected/actual struct-id split).
_trial_eval_ret_type_expr :: (
  fn(ret_texpr : AstExpr, env : Environment, ctx : EvalContext, out : ArrayList(TypeValue)) -> unit
)({
  inner_exn := Exception(throw : ((_err) -> unwind(())));
  evaluated := evaluate_expression_raw(ret_texpr, env, ctx, inner_exn);
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated)),
    .Some(rte_ei) => match(
      rte_ei.value,
      .Some(rte_v) => match(
        rte_v,
        .TypeVal(rte_t) => {
          out.push(rte_t);
        },
        _ => ()
      ),
      .None => ()
    ),
    .None => ()
  );
});
/// Replace the `call_result` of an `Impl(Fn(...) -> R)` carrier (or a bare
/// `FnTraitT`) with `new_result`, but only where the current result is not
/// itself a type variable and DOES contain one — i.e. exactly the
/// `-> Option(B)` shape.
///
/// This is the value-semantics stand-in for TS anonymous-function.ts:1010-1012.
/// There, `functionType` IS the parameter type's `isFn.callType` object, so
/// `functionType.return.type = evaluatedBodyReturnType` rewrites the PARAMETER
/// TYPE in place: after the argument is evaluated, TS's parameter type reads
/// `Impl(Fn(a : i32) -> Option(i32))`, and the specialized body therefore types
/// `f(value)` with the CANONICAL `Option(i32)`. yo-self types are values, so
/// the caller re-applies the refinement explicitly. Without it the specialized
/// body types `f(value)` as the def-era `Option(B)` and yo-self's codegen
/// aborts with "no C type name found for <enum:…>" — substitution keeps the
/// def-era enum id, so only the closure's own (canonical) body type will do.
_refine_one_fn_trait_result :: (fn(ftt : TypeValue, new_result : TypeValue) -> TypeValue)(
  match(
    ftt,
    .FnTraitT(rw_bn, rw_cpl, rw_cpt, rw_cr, rw_il, rw_it, rw_is, rw_cpr) => cond(
      ((!(is_some_type(rw_cr))) && (get_all_some_types(rw_cr).len() > usize(0))) => TypeValue.FnTraitT(
        rw_bn,
        rw_cpl,
        rw_cpt,
        new_result,
        rw_il,
        rw_it,
        rw_is,
        rw_cpr
      ),
      true => ftt
    ),
    _ => ftt
  )
);
/// True iff `ty` carries an Fn-trait whose result is the refinable
/// `-> Option(B)` shape (not itself a type variable, but containing one).
_wrapper_fn_result_needs_refine :: (fn(ty : TypeValue) -> bool)(
  match(
    extract_fn_trait_from_type(ty),
    .Some(nr_ftt) => match(
      nr_ftt,
      .FnTraitT({ call_result : nr_cr }) => ((!(is_some_type(nr_cr))) && (get_all_some_types(nr_cr).len() > usize(0))),
      _ => false
    ),
    .None => false
  )
);
_refine_wrapper_fn_result :: (fn(ty : TypeValue, new_result : TypeValue) -> TypeValue)(
  match(
    ty,
    .SomeT(rf_id, rf_nm, rf_fl, rf_pt, rf_rtt, rf_rtl, rf_ntt, rf_ntl, rf_ier, rf_kft, rf_rc) => {
      new_rtt := ArrayList(TypeValue).new();
      (rf_i : usize) = usize(0);
      while(rf_i < rf_rtt.len(), {
        match(
          rf_rtt.get(rf_i),
          .Some(rf_t) => {
            new_rtt.push(_refine_one_fn_trait_result(rf_t, new_result));
          },
          .None => ()
        );
        rf_i = (rf_i + usize(1));
      });
      TypeValue.SomeT(rf_id, rf_nm, rf_fl, rf_pt, new_rtt, rf_rtl, rf_ntt, rf_ntl, rf_ier, rf_kft, rf_rc)
    },
    .FnTraitT(_, _, _, _, _, _, _, _) => _refine_one_fn_trait_result(ty, new_result),
    _ => ty
  )
);
/// Check that one function parameter matches its argument expression.
/// Evaluates the arg, synthesizes type bindings into callee_env, and adds
/// the parameter variable to callee_env.
check_if_function_parameter_matches_argument :: (
  fn(
    param_label : String,
    param_type : TypeValue,
    is_ct_only : bool,
    param_is_owning : bool,
    param_is_ref : bool,
    skip_expected_type : bool,
    use_param_type_directly : bool,
    arg_expr_raw : AstExpr,
    callee_env : Environment,
    caller_env : Environment,
    ctx : EvalContext,
    runtime_arg_exprs_in_order : ArrayList(AstExpr),
    exn : Exception,
    /// The parameter's `= <value>` ASSIGNED value, or `.None`. Appended last
    /// with a default so existing call sites need no change. See the Step-5b
    /// guard below (TS helper.ts:481-497).
    (param_assigned_value : Option(EvalValue)) ?= Option(EvalValue).None,
    /// Aliasing Stage 0: true when the CALLEE is extern/builtin (no Yo code
    /// runs inside — its borrows cannot dangle), so Step 4c skips the
    /// projection dup. Mirrors TS helper.ts `!functionType.externName`.
    (callee_is_extern : bool) ?= false
  ) -> CheckParamResult
)({
  // Step 1: Strip "label: value" colon-label wrapper from arg if present,
  // VALIDATING the label (port of TS helper.ts:271-302 — labels are
  // readability-only and must match the declared parameter label; a bare
  // strip silently accepted wrong/reordered labels TS rejects).
  (actual_arg : AstExpr) = arg_expr_raw;
  if(ast_expr_is_fn_call_of(arg_expr_raw, ":", .Some(usize(2))), {
    colon_args := _h_get_fn_call_args(arg_expr_raw);
    cl_label_expr := match(colon_args.get(usize(0)), .Some(a) => a, .None => arg_expr_raw);
    if(!(ast_expr_is_atom(cl_label_expr)), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(cl_label_expr),
            `Expected identifier for label, got:\n${ast_expr_to_string(cl_label_expr)}`,
            false,
            .None
          )
        )
      );
    });
    cl_label := ast_expr_token(cl_label_expr).value;
    if(param_label.len() == usize(0), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(cl_label_expr),
            String.from("Named argument call is not allowed for this parameter (it has no label)."),
            false,
            .None
          )
        )
      );
    });
    if(param_label != cl_label, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(cl_label_expr),
            `Named argument is not supported. Label is only used for readibility.\n    Expected label "${param_label}" at the argument position, but got "${cl_label}".`,
            false,
            .None
          )
        )
      );
    });
    actual_arg = match(
      colon_args.get(usize(1)),
      .Some(a) => a,
      .None => arg_expr_raw
    );
  });
  // Step 2: Evaluate param type in callee_env.
  //
  // io.async's params SKIP this name-based re-evaluation
  // (`use_param_type_directly`): they are already per-call instantiated by
  // _freshen_io_builtin_callee, and the re-evaluation reads `T`/`E` BY NAME
  // from the shared mutable env chain, concretizing the action closure's
  // expected with a SIBLING call's resolution (the [DRIVER]-probe-confirmed
  // poison path: 126x `Fn(e : Io) -> unit` expecteds under the batch main's
  // body eval — full chain in issues/yo-self-async-emission-cluster.md).
  // The two bundle-shape corpus files this skip regressed pre-v13 were
  // victims of the SAME stale-binding persistence, since fixed by the
  // call-scoped rebinds (67acb7390) + lineage-identity gate (92b27f68b).
  (callee_env_r : Environment) = callee_env;
  resolved_pt := if(
    use_param_type_directly,
    param_type.clone(),
    evaluate_function_parameter_type_again(param_type, callee_env_r, ctx)
  );
  // Step 3: Evaluate arg with param type as expected-type hint.
  //
  // For io.await/io.state/io.spawn/JoinHandle.await args (`skip_expected_type`),
  // evaluate WITHOUT an expected type so the future arg keeps its NATURAL type
  // (e.g. `IoFuture`) rather than being coerced to the `Impl(Future(T,E))`
  // SomeType parameter — coercion can make synthesis unable to resolve the generic
  // `T` from `Future(T)`. Mirrors TS helper.ts:378-384 (the
  // `functionType.ioBuiltin === "io_await"` skip); yo-self has no `ioBuiltin`
  // marker, so the caller detects the io-builtin structurally.
  saved_exp := ctx.expected_type;
  if(skip_expected_type, {
    ctx.expected_type = Option(ExpectedTypeCtx).None;
  }, {
    ctx.expected_type = .Some(ExpectedTypeCtx(ty : resolved_pt, env : callee_env_r));
  });
  evaled_arg := evaluate_expression_raw(actual_arg, caller_env, ctx, exn);
  ctx.expected_type = saved_exp;
  // Extract ExprInfo for the evaluated arg.
  arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_arg));
  arg_info := match(
    arg_info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(actual_arg),
            String.from("check_if_function_parameter_matches_argument: arg has no ExprInfo"),
            false,
            .None
          )
        )
      );
      new_expr_info(caller_env, t_unit())
    }
  );
  (caller_env_r : Environment) = arg_info.env;
  // Coerce a comptime arg type (comptime_int/float/string) to the
  // parameter's concrete runtime type before synthesis/compatibility,
  // mirroring the default-value-site coercion (types/env_lookup.yo). Only
  // when the parameter type is CONCRETE (not a `SomeT` type variable) —
  // generic params must bind the raw comptime type via synthesis. Without
  // this, e.g. `comptime_str.to_string()` (the desugaring of a backtick
  // template) matched the self arg `comptime_str` against `Self = str`
  // and `synthesize_types` rejected the `str` vs `comptime_str` tag
  // mismatch before any coercion could run. `convert_…` returns the type
  // unchanged for non-comptime inputs, so this is a no-op for normal args.
  // GUARD: coerce when the PARAMETER is a runtime param (not comptime-only) and
  // the parameter TYPE is not itself a comptime type. Mirrors TS
  // `!parameter.isCompileTimeOnly && isComptimeOnlyType(argType)`
  // (helper.ts:508). `is_ct_only` (the `comptime(...)` param modifier, from the
  // per-param comptime side-table) REPLACES the earlier `!is_some_type`
  // PROXY, which wrongly skipped a runtime param typed as a SomeT — e.g. the
  // operator `neg`'s `self : _Self`, leaving a `comptime_float` arg unlowered
  // so the specialized body dispatched to the COMPTIME `__yo_comptime_float_neg`
  // (undeclared) instead of the runtime `Negate` impl (comptime.test.yo).
  // `convert_…` lowers comptime_int→i32 / comptime_float→f64 UNCONDITIONALLY
  // (comptime_string honours the expected type), so the `!pt_is_comptime` half
  // still protects the (correct) comptime-to-comptime match for a comptime
  // parameter type (e.g. the `fn(comptime_int,comptime_int)->bool` overload).
  (arg_type : TypeValue) = arg_info.ty;
  pt_is_comptime := (
    (is_comptime_int_type(resolved_pt) || is_comptime_float_type(resolved_pt))
    || is_comptime_string_type(resolved_pt)
  );
  if((!(is_ct_only)) && (!(pt_is_comptime)), {
    arg_was_comptime := (
      (is_comptime_int_type(arg_info.ty) || is_comptime_float_type(arg_info.ty))
      || is_comptime_string_type(arg_info.ty)
    );
    arg_type = convert_comptime_type_to_runtime_type_with_expected(
      arg_type,
      Option(TypeValue).Some(resolved_pt),
      caller_env_r
    );
    // Record the runtime type the comptime arg coerced to, so codegen renders
    // the right C form (e.g. comptime_str → `*(char)` emits a bare string
    // literal, not a `__yo_str` struct). Mirrors TS convertComptimeTypeToRuntime
    // Type writing `expr.$.convertedRuntimeType`. ExprInfo is an object (ref),
    // and for a literal arg `evaled_arg` IS the original node codegen reads.
    // Only the codegen reads this field — no evaluator logic branches on it.
    if(arg_was_comptime, {
      expr_info_set_converted_runtime_type(arg_info, Option(TypeValue).Some(arg_type.clone()));
    });
  });
  arg_value := arg_info.value;
  // Step 4: Append to runtime arg list if not comptime-only.
  if(!(is_ct_only), {
    runtime_arg_exprs_in_order.push(evaled_arg);
  });
  // Step 4a: the argument variable must not already be CONSUMED (moved) —
  // TS helper.ts:400-401 `requireExprNotConsumed(evaluatedArgExpr,
  // callerEnv)`, UNCONDITIONAL (not gated on ownership). yo-self had the
  // 1:1 checker (utils.yo require_expr_not_consumed) but never called it
  // from the call path — only from assignments — so calling
  // `uninit.assume_init()` twice (own(self), consumed on the first call)
  // passed `check`, `comptime_expect_error` saw no error, and prelude
  // arm 3 hollowed its whole batch (handoff §3.1-§7).
  require_expr_not_consumed(evaled_arg, caller_env_r, ctx, exn);
  // Step 4b: Move-ownership for an OWNED parameter (mirrors src/evaluator/calls/
  // helper.ts:411-451). If the arg already owns the RC value → MOVE it (consume,
  // no dup). If borrowed/non-owning → materialize an owned copy via `___dup` and
  // consume the original so it can't be used after the call. Gated on the
  // PARAMETER taking ownership — borrow/`inout` params never consume/dup their arg.
  // NOTE: the own(self)-captured-variable tracking (`ctx.own_consumed_captures`,
  // TS helper.ts:419-428) is deferred until a thread-spawn capture test needs it.
  // NOT during the CHECKING PHASE: a trial call (overload selection /
  // _trial_call_overload_candidate) runs this helper against the REAL caller
  // env; TS's `callerEnv = setExprAsConsumed(...)` threads an IMMUTABLE env
  // copy, so a trial's consumption dies with the trial — yo-self's
  // set_expr_as_consumed mutates the shared Variable in place, so a trial
  // consumption LEAKED into the real pass and Step 4a then rejected the same
  // statement that had "moved" the value ('use of moved value: `v1_copy` /
  // value moved here' both pointing at the SAME line — tests/imm_vec arms
  // 14/17, surfaced by the Step-4a port).
  if((param_is_owning && (!(is_ct_only))) && !(ctx.is_in_function_call_checking_phase), {
    match(
      arg_info.variable_name,
      .None => (),
      .Some(arg_var_name) => {
        arg_vars := get_variables_from_env(caller_env_r, arg_var_name);
        if(arg_vars.len() > usize(0), {
          arg_var := match(arg_vars.get(arg_vars.len() - usize(1)), .Some(v) => v, .None => make_err_variable(caller_env_r));
          if(arg_var.is_owning_the_rc_value, {
            set_expr_as_consumed(evaled_arg, caller_env_r, true, ctx, exn);
          }, {
            set_expr_as_needs_to_call_dup(evaled_arg, ctx, exn);
            set_expr_as_consumed(evaled_arg, caller_env_r, true, ctx, exn);
          });
        });
      }
    );
  });
  // Step 4c: Aliasing Stage 0 (mirrors TS helper.ts's borrow-projection
  // branch; issues/borrowed-arg-invalidated-by-aliased-container-mutation.md).
  // An RC-typed field PROJECTION passed to a BORROWING parameter hands the
  // callee a view into storage it may reassign through an aliased handle
  // (`f(w, w.b)` reassigning `w.b` in a loop frees the old value mid-call —
  // the borrowed parameter dangles). Materialize a caller-owned +1 for the
  // call; the caller's scope-end drop releases it. Plain locals and owned
  // temps stay +0 (the marker no-ops on owning temps), `inout` (ref) params
  // are place writes, and — like Step 4b — trial calls in the CHECKING PHASE
  // must not mutate the real caller env.
  (s0_drop_captured : Option(AstExpr)) = Option(AstExpr).None;
  (s0_marked_arg_captured : Option(AstExpr)) = Option(AstExpr).None;
  if(((((!(param_is_owning)) && !(is_ct_only)) && ((!(param_is_ref)) && !(ctx.is_in_function_call_checking_phase))) && !(callee_is_extern)) && arg_is_rc_projection_place(actual_arg, caller_env_r), {
    s0_drop_captured = set_expr_as_needs_to_call_dup_for_borrowed_projection(evaled_arg, ctx, exn);
    if(s0_drop_captured.is_some(), {
      s0_marked_arg_captured = Option(AstExpr).Some(evaled_arg);
    });
  });
  // Step 5: Comptime check — runtime arg cannot fill a comptime parameter.
  //
  // 1:1 with TS helper.ts:465-478: the argument counts as runtime when it has
  // NO value, or when it is an UnknownValue that is `isRuntimeOnly`. An
  // ORDINARY `UnknownVal` is a compile-time placeholder (CTFE analysis) and TS
  // accepts it. yo-self used to reject every `UnknownVal`, which made a
  // comptime-only `self` parameter unfillable; the throw was then eaten by
  // `_evaluate_expression_wrapper` (_expr.yo:1017) and the enclosing statement
  // emitted as `// Failed to transpile` — measured on tests/imm_vec, where the
  // dropped statement was the whole test body (a hollow rc=0 "47 passed").
  // `VarRef` keeps its own arm: it names a runtime variable binding, which is
  // never a compile-time value in yo-self (TS has no VarRef).
  if(is_ct_only, {
    is_rt := match(
      arg_value,
      .None => true,
      .Some(v) => match(
        v,
        .UnknownVal(_, ro) => ro,
        .VarRef(_) => true,
        _ => false
      )
    );
    if(is_rt, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(actual_arg),
            `Cannot assign runtime argument to compile-time parameter "${param_label}"`,
            false,
            .None
          )
        )
      );
    });
  });
  // Step 5b: assigned-value check — 1:1 with TS helper.ts:481-497.
  //
  //   // If the parameter has an assignedValue, check that the argument value
  //   // matches it. This is used for overload resolution based on value
  //   // matching (e.g., TryInto(i32) vs TryInto(i64)).
  //   if (parameter.assignedValue && evaluatedArgExpr.$?.value) { ... }
  //
  // Two impls of the same parameterized trait give the receiver TWO methods
  // with IDENTICAL parameter types — `try_into(self : Self, comptime(_To) :
  // Type)` for both `TryInto(i32)` and `TryInto(i64)` (std/prelude.yo:7639-
  // 7647). Nothing else can tell them apart, so without this throw the
  // checking phase keeps both candidates and the FIRST-declared impl wins:
  // `x.try_into(i64)` returned `Result(i32, str)` and the following
  // `assert(b == i64(10))` then found no `i32 == i64` and was dropped as
  // `// Failed to transpile` (tests/prelude.test.yo arm 1, hollow batch).
  // `are_values_equal` is the port of TS `areValuesEqual`, whose Type/Type
  // branch compares with `areTypesCompatible(..., requireExactMatch = true)`
  // (value.ts:699-705) — `are_types_compatible_exact` here.
  match(
    param_assigned_value,
    .Some(pav) => match(
      arg_value,
      .Some(agv) => {
        (pav_matches : bool) = are_values_equal(pav, callee_env_r, agv, caller_env_r);
        if(!(pav_matches), {
          // Outside a dry-run this rejection is a REAL user error: every
          // overload candidate was already trial-rejected, the fallback
          // committed to this one, and its assigned value still mismatches
          // (`n.try_into(u8)` with only i32/i64 impls). TS's error
          // propagates because its def-time body eval has no catch; here
          // the def-time wall would swallow the throw and the statement
          // would silently hollow (rc=0 + "// Failed to transpile") —
          // issues/fixed/yo-self-no-matching-overload-silent-drop.md. Flag it on
          // the flow-violation channel so the def-time caller re-raises it
          // via the real exn (function_type.yo's flow_violation_pending
          // re-raise). Skipped during trials (checking phase — rejection
          // is HOW candidates are filtered), in cee propagate mode (the
          // throw itself reaches the comptime_expect_error catch), and
          // when an earlier flag is pending.
          if(!(ctx.is_in_function_call_checking_phase) && !(propagate_def_time_errors()) && !(flow_violation_pending()), {
            flag_flow_violation(
              `No matching call found: every overload candidate was rejected, and the closest one failed with:
Value mismatch for parameter "${param_label}"
${ast_expr_to_string(actual_arg)}`
            );
          });
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(actual_arg),
                `Value mismatch for parameter "${param_label}"`,
                false,
                .None
              )
            )
          );
        });
      },
      .None => ()
    ),
    .None => ()
  );
  // Closure-argument return refinement for Step-6 synthesis: a closure whose
  // OWN declared return never resolved (still `-> U`, a SomeT) contributes
  // nothing to the callee's generic binding — synthesize binds the callee's
  // `U` to itself, and the callee's SPECIALIZATION body eval (which installs
  // no swallow) then throws on e.g. `List(U)` and unwinds the CALLER's whole
  // statement chain — the hollow-test-batch blast radius
  // (issues/retired/yo-self-hollow-test-batch-main.md, fourth round). Substitute the
  // closure's def-time-evaluated CONCRETE body type (side table registered by
  // values/anonymous_function.yo) as the GIVEN return, so the generic binds
  // through the same env channel the spec body eval reads. TS needs no side
  // table — its synthesize sees the concrete return through object identity
  // (anonymous-function.ts:963-988 mutates the closure's type in place). No
  // effect unless the arg value is a FuncVal whose given fn-type return is a
  // SomeT and a concrete body type was registered.
  // The PARAMETER-side twin of the same TS mutation (anonymous-function.ts:
  // 1010-1012, which writes through to the parameter type's Fn-trait callType —
  // see _refine_wrapper_fn_result): a closure argument whose def-evaluated body
  // type is concrete pins the Fn-trait carrier's `-> Option(B)` to that
  // CANONICAL instance, on BOTH sides (TS's two sides are one shared object, so
  // they can never disagree). `resolved_pt` is what Step 7 re-evaluates and
  // Step 9 binds `f` with, so this is what makes the specialized body — and the
  // C it emits — use `Option(i32)`.
  match(
    arg_value,
    .Some(av_pr) => match(
      av_pr,
      .FuncVal(pr_fvd, _) => match(
        get_closure_body_type(pr_fvd.*.func_id.clone()),
        .Some(pr_body_ty) => if((!(is_some_type(pr_body_ty))) && (get_all_some_types(pr_body_ty).len() == usize(0)), {
          resolved_pt = _refine_wrapper_fn_result(resolved_pt, pr_body_ty.clone());
          if(_wrapper_fn_result_needs_refine(arg_type), {
            arg_type = _refine_wrapper_fn_result(arg_type, pr_body_ty);
            // …and through the arg's RECORDED type, which is what codegen reads:
            // TS's rewrite lands on the shared Fn-trait object, so the closure
            // expression's own `expr.$.type` reports the concrete result too.
            arg_info.ty = arg_type;
          });
        }),
        .None => ()
      ),
      _ => ()
    ),
    .None => ()
  );
  (arg_type_for_synth : TypeValue) = arg_type;
  match(
    arg_value,
    .Some(av_cb) => match(
      av_cb,
      .FuncVal(cb_fvd, _) => match(
        arg_type,
        .Func({
          forall_types : cb_ft,
          param_types : cb_pt,
          implicit_types : cb_it,
          where_types : cb_wt,
          result : cb_res,
          meta : cb_meta
        }) => if(is_some_type(cb_res), {
          match(
            get_closure_body_type(cb_fvd.*.func_id.clone()),
            .Some(cb_body_ty) => {
              arg_type_for_synth = TypeValue.Func(cb_ft, cb_pt, cb_it, cb_wt, cb_body_ty, cb_meta, ArrayList(TypeValue).new());
            },
            .None => ()
          );
        }),
        _ => ()
      ),
      _ => ()
    ),
    .None => ()
  );
  // Step 6: Synthesize generic bindings from arg type into callee_env.
  checked := ArrayList(TypePair).new();
  // Note: opts is a local variable (not comptime .None) to ensure the
  // un-specialized synthesize_types wrapper is generated in C codegen.
  // See issues/synthesizer-unspecialized-wrapper.md
  (synth_opts : Option(SynthesizeOptions)) = Option(SynthesizeOptions).None;
  synth := synthesize_types(
    resolved_pt,
    callee_env_r,
    arg_type_for_synth,
    caller_env_r,
    checked,
    synth_opts,
    exn
  );
  callee_env_r = synth.expected_env;
  // Step 7: Re-evaluate param type with the updated callee_env.
  final_pt := evaluate_function_parameter_type_again(resolved_pt, callee_env_r, ctx);
  // Step 8: Type-compatibility check.
  if(!(are_types_compatible(final_pt, arg_type)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(actual_arg),
          `Type mismatch for parameter "${param_label}":\n- Expected: ${type_to_string(final_pt)}\n- Got     : ${type_to_string(arg_type)}`,
          false,
          .None
        )
      )
    );
  });
  // Step 9: Bind param variable in callee_env.
  // Gap-6 attempt #8(a), the body-side half: when the DECLARED param type
  // re-evaluates to a PATTERN-ERA instance of the arg's constructor (a
  // `self : Self` on an impl method — its unresolved T#N lives only in
  // type_arguments), bind the param with the ARG's concrete instance
  // instead. TS binds params so signature- and body-side converge on the
  // same type object; without this every `self.field` in a specialized
  // body types (and emits C) in the pattern lineage while the call site
  // and ctor memo use the concrete one (the imm_*/collections t1-vs-t7).
  (bind_pt : TypeValue) = final_pt;
  match(
    adopt_receiver_struct_instance(final_pt, arg_type),
    .Some(bind_adopted) => {
      bind_pt = bind_adopted;
    },
    .None => ()
  );
  param_tok := synthetic_token(param_label, callee_env_r.module_path);
  bound_param_opt := add_variable_to_env(
    callee_env_r,
    param_label,
    bind_pt,
    arg_value,
    is_ct_only,
    false,
    // is_reassignable
    false,
    // is_owning_the_rc_value
    false,
    // is_implicit
    param_tok
  );
  // inout(name) : T parameters — propagate the flag onto the binding this
  // call created so the callee body's codegen dereferences reads (`(*name)`)
  // and reassignment is accepted. Mirrors TS helper.ts:584
  // (`isRef: parameter.isRef, isReassignable: parameter.isRef`). Marking the
  // exact created Variable (not an env-wide name search) keeps enclosing
  // same-named bindings (e.g. an outer method's by-value `self`) untouched.
  // Every binding OF A PARAMETER must carry is_parameter — resolution
  // inside the callee body must be able to tell a parameter from a
  // same-named caller-module global, and this bind (plus the spec-time
  // re-binds below) previously left the flag false, so codegen's
  // module-global qualifier saw a "global" as the innermost match
  // (issues/fixed/yo-self-specialized-body-env-param-resolution-order.md).
  match(
    bound_param_opt,
    .Some(bp_flag) => {
      bp_flag.is_parameter = true;
    },
    .None => ()
  );
  if(param_is_ref, {
    match(
      bound_param_opt,
      .Some(bound_param) => {
        bound_param.is_ref = true;
        bound_param.is_reassignable = true;
      },
      .None => ()
    );
  });
  CheckParamResult(
    callee_env : callee_env_r,
    caller_env : caller_env_r,
    arg_value : arg_value,
    arg_type : arg_type,
    resolved_param_type : final_pt,
    s0_drop : s0_drop_captured,
    s0_marked_arg : s0_marked_arg_captured
  )
});
// ---------------------------------------------------------------------------
// sanitize_for_sig
// ---------------------------------------------------------------------------
/// Replace all non-alphanumeric bytes in `s` with underscores.
///
/// Used to make compile-time signature strings safe as C identifier suffixes.
/// Mirrors `sanitizeForCIdentifier` in `src/codegen/utils/index.ts` but only
/// handles the character-replacement aspect (no C keyword avoidance needed
/// here since the signature is a suffix appended to a valid func_id).
sanitize_for_sig :: (fn(s : String) -> String)({
  bytes := s.as_bytes();
  n := bytes.len();
  result := String.new();
  (i : usize) = usize(0);
  while(i < n, {
    b := match(bytes.get(i), .Some(x) => x, .None => u8(0));
    is_alnum := (
      ((b >= u8(97)) && (b <= u8(122))) || // a-z
      ((b >= u8(65)) && (b <= u8(90))) || // A-Z
      ((b >= u8(48)) && (b <= u8(57))) // 0-9
    );
    if(is_alnum, {
      result.push_byte(b);
    }, {
      result.push_str("_");
    });
    i = (i + usize(1));
  });
  result
});
// ---------------------------------------------------------------------------
// (The runtime-param specialization signature now uses codegen's actual
// `type_key` directly — see compute_compile_time_signature below. The former
// `_param_type_sig` hand-mirror was removed because a partial mirror drifts
// from type_key's C-type merging: it either collapses generic instantiations
// onto one func_id (incompatible-type) or over-distinguishes types codegen
// merges (extra mismatching func_ids). type_key was extracted into the shared
// types/type_key.yo so both codegen and the evaluator import the SAME function.)
// ---------------------------------------------------------------------------
// value_to_signature_string
// ---------------------------------------------------------------------------
/// Convert a value to a deterministic string for use in specialization cache keys.
///
/// For type values, returns the type string.
/// For function values, returns `fn_<func_id>`.
/// For other values, falls back to value_to_string.
///
/// Mirrors `valueToSignatureString` in `src/evaluator/calls/helper.ts`.
value_to_signature_string :: (fn(value : EvalValue) -> String)(
  match(
    value,
    // Mirror TS `${valueToString(value)}_id${type.id}` (helper.ts:2103): the
    // human-readable type string ALONE is not instantiation-precise — an
    // anonymous generic instantiation renders `<struct:yo_id_N>` where N is
    // the shared DECLARATION id, so every same-named local struct / generic
    // instantiation produced the SAME specialization signature and collapsed
    // onto one specialized function (param typed from one instantiation,
    // return from another — arc.test.yo's per-test `Counter :: struct(...)`;
    // previously also the shared-GcTracer-visit Bucket class). yo-self has no
    // numeric `type.id`; `type_key` is its instantiation-precise identity.
    // (Re-applied 2026-07-17: the 2026-07-15 revert's crash verdicts came
    // from an invalidated bisect — the startup corruption was the since-fixed
    // RC/GC-teardown bugs. See
    // issues/fixed/yo-self-specialization-signature-type-identity.md.)
    .TypeVal(t) => `${type_to_string(t)}_id_${type_key(t)}`,
    .FuncVal(__fvd2, _) => `fn_${__fvd2.*.func_id}`,
    _ => value_to_string(value)
  )
);
// ---------------------------------------------------------------------------
// compute_compile_time_signature
// ---------------------------------------------------------------------------
/// Build a deterministic signature string for a generic function specialization.
///
/// The signature encodes:
///   - generic type arguments
///   - compile-time implicit arguments (given/using handlers)
///   - runtime parameter types that contain SomeType (to differentiate
///     specializations with different concrete closure capture types)
///
/// Used as the suffix for `specializedFuncId = funcId + "_" + signature`.
///
/// Mirrors `computeCompileTimeSignature` in `src/evaluator/calls/helper.ts`.
compute_compile_time_signature :: (
  fn(
    func_type : TypeValue,
    arg_values : ArgValues,
    callee_env : Environment,
    runtime_param_tys : ArrayList(TypeValue),
    param_comptime : ArrayList(bool),
    exn : Exception
  ) -> String
)({
  parts := ArrayList(String).new();
  // Forall type arguments — extract from forall_labels vs arg_values.forall_args
  match(
    func_type,
    .Func({ meta : __fm1 }) => {
      fl := __fm1.*.forall_labels;
      n_fl := fl.len();
      n_fa := arg_values.forall_args.len();
      (fpi : usize) = usize(0);
      while(fpi < n_fl, {
        val_opt := if(
          fpi < n_fa,
          match(
            arg_values.forall_args.get(fpi),
            .Some(ae) => ae.value,
            .None => Option(EvalValue).None
          ),
          Option(EvalValue).None
        );
        sig_str := match(
          val_opt,
          .Some(v) => sanitize_for_sig(value_to_signature_string(v)),
          .None => {
            // Look up the generic label in callee_env
            label := match(fl.get(fpi), .Some(s) => s, .None => String.new());
            vars := get_variables_from_env(callee_env, label);
            n_v := vars.len();
            cond(
              (n_v > usize(0)) => {
                env_val := match(
                  vars.get(n_v - usize(1)),
                  .Some(vr) => vr.value.get(usize(0)),
                  .None => Option(EvalValue).None
                );
                match(
                  env_val,
                  .Some(ev) => sanitize_for_sig(value_to_signature_string(ev)),
                  .None => String.from("unknown")
                )
              },
              true => String.from("unknown")
            )
          }
        );
        parts.push(sig_str);
        fpi = (fpi + usize(1));
      });
    },
    _ => ()
  );
  // Implicit argument values (given/using handlers — always compile-time)
  match(
    arg_values.implicit_args,
    .Some(impl_args) => {
      n_ia := impl_args.len();
      (iai : usize) = usize(0);
      while(iai < n_ia, {
        sig_str := match(
          impl_args.get(iai),
          .Some(ae) => match(
            ae.value,
            .Some(v) => sanitize_for_sig(value_to_signature_string(v)),
            .None => String.from("unknown")
          ),
          .None => String.from("unknown")
        );
        parts.push(sig_str);
        iai = (iai + usize(1));
      });
    },
    .None => ()
  );
  // Compile-time REGULAR parameters — a `comptime(y) : i32` value parameter.
  // Faithful port of TS's third block (helper.ts:2154-2163):
  //
  //   functionType.parameters.forEach((param, index) => {
  //     if (param.isCompileTimeOnly && index < argValues.args.length) { … }
  //   });
  //
  // yo-self had no counterpart, so the signature carried only TYPES and two
  // calls that differ solely in a comptime VALUE collapsed onto ONE
  // specialization — a SILENT WRONG ANSWER, not a compile error:
  // `comptime_add :: (fn(x : i32, comptime(y) : i32) -> i32)(x + y)` emitted a
  // single `yo_id_…(int32_t x) { return x + 1; }`, so `comptime_add(3, 2)`
  // returned 4. yo-self keeps the per-parameter comptime flags in a func-id
  // side table rather than on the parameter, so they are threaded in from the
  // caller, which already reads them.
  n_pc := param_comptime.len();
  n_ar := arg_values.args.len();
  (pci : usize) = usize(0);
  while(pci < n_pc, {
    is_ct := match(param_comptime.get(pci), .Some(b) => b, .None => false);
    if(is_ct && (pci < n_ar), {
      ct_sig := match(
        arg_values.args.get(pci),
        .Some(ae) => match(
          ae.value,
          .Some(v) => sanitize_for_sig(value_to_signature_string(v)),
          .None => String.from("unknown")
        ),
        .None => String.from("unknown")
      );
      parts.push(ct_sig);
    });
    pci = (pci + usize(1));
  });
  // Runtime parameter types — disambiguates specializations with the same
  // compile-time args but different concrete runtime param types (e.g.
  // `println(generic(T), v : T)` over `str` vs `i32`: the generic T part may
  // resolve to "unknown" for an INFERRED type param, so without the concrete
  // param type here `println<str>` and `println<i32>` would get the SAME
  // signature and collide on one specialized func id). Mirrors TS
  // computeCompileTimeSignature, which includes a runtime param type when
  // `paramType.id || typeContainsSomeType(paramType)` — concrete types carry a
  // unique `.id` there, so they ARE included. yo-self's TypeValue has no numeric
  // `.id`, so include every non-unit runtime param type by its (stable) type
  // string; SomeType-containing types are a subset and still included.
  n_rt := runtime_param_tys.len();
  (rti : usize) = usize(0);
  while(rti < n_rt, {
    ptype := match(runtime_param_tys.get(rti), .Some(t) => t, .None => t_unit());
    if(!(is_unit_type(ptype)), {
      seg := `rtparam${rti.to_string()}_${sanitize_for_sig(type_key(ptype))}`;
      parts.push(seg);
    });
    rti = (rti + usize(1));
  });
  // Join parts into a single string
  result := String.new();
  n_parts := parts.len();
  (pi : usize) = usize(0);
  while(pi < n_parts, {
    if(pi > usize(0), {
      result.push_str("_");
    });
    match(
      parts.get(pi),
      .Some(p) => result.push_string(p),
      .None => ()
    );
    pi = (pi + usize(1));
  });
  result
});
// ---------------------------------------------------------------------------
// Specialization cache helpers
// ---------------------------------------------------------------------------
/// Global specialization-cache store, keyed by `func_id`. TS keeps each
/// function's `specializedFunctionCaches` ON the FunctionValue OBJECT
/// (helper.ts:2264/2885), so it is shared by every caller across the whole
/// process via the module cache. yo-self's value semantics cannot hang it on
/// `FuncVal`; a per-EvalContext list (the old home) is NOT equivalent — in
/// `check`/`test` mode every file gets a fresh ctx, so a prelude comptime fn
/// like `Eq(String)` RE-specialized per file, minting a fresh trait id that no
/// longer matched the id its concrete impls registered under ("Type String
/// does not implement required trait Eq(String)"). Module-global storage keyed
/// by the stable func_id is the same-lifetime equivalent of TS's model.
(g_specialized_fn_caches : ArrayList(SpecializedFunctionCacheEntry)) = ArrayList(SpecializedFunctionCacheEntry).new();
/// Look up a cached specialization by `func_id` and compile-time args.
///
/// Returns `Some(specialized_func_val)` if a matching cache entry is found,
/// or `None` if no entry exists.
_find_specialization_cache :: (
  fn(
    ctx : EvalContext,
    func_id : String,
    compile_time_arg_values : ArrayList(EvalValue),
    runtime_parameter_types : ArrayList(TypeValue),
    caller_env : Environment
  ) -> Option(EvalValue)
)({
  n_entries := g_specialized_fn_caches.len();
  (ei : usize) = usize(0);
  (result : Option(EvalValue)) = Option(EvalValue).None;
  while((ei < n_entries) && result.is_none(), {
    entry_opt := g_specialized_fn_caches.get(ei);
    match(
      entry_opt,
      .Some(entry) => {
        if(entry.func_id == func_id, {
          n_caches := entry.caches.len();
          (ci : usize) = usize(0);
          while((ci < n_caches) && result.is_none(), {
            cache_opt := entry.caches.get(ci);
            match(
              cache_opt,
              .Some(cache) => {
                // Check compile-time arg values match
                n_ct := cache.compile_time_arg_values.len();
                n_cur_ct := compile_time_arg_values.len();
                ct_match := (n_ct == n_cur_ct);
                if(ct_match, {
                  (cti : usize) = usize(0);
                  while((cti < n_ct) && ct_match, {
                    cached_v := match(cache.compile_time_arg_values.get(cti), .Some(v) => v, .None => EvalValue.UnitVal);
                    current_v := match(compile_time_arg_values.get(cti), .Some(v) => v, .None => EvalValue.UnitVal);
                    if(!(eval_value_eq(cached_v, current_v)), {
                      ct_match = false;
                    });
                    cti = (cti + usize(1));
                  });
                });
                if(ct_match, {
                  // Check runtime parameter types match (exact match)
                  n_rt := cache.runtime_parameter_types.len();
                  n_cur_rt := runtime_parameter_types.len();
                  rt_match := (n_rt == n_cur_rt);
                  if(rt_match, {
                    caller_env;
                    (rti : usize) = usize(0);
                    while((rti < n_rt) && rt_match, {
                      cached_ty := match(cache.runtime_parameter_types.get(rti), .Some(t) => t, .None => t_unit());
                      current_ty := match(runtime_parameter_types.get(rti), .Some(t) => t, .None => t_unit());
                      // ABSTRACT-vs-CONCRETE never matches: the compat check
                      // accepts an existential SomeT against a concrete type
                      // (trait subsumption), which returned the def-era
                      // TYPE-ERASED spec (param minted from the bare declared
                      // SomeT → void*) to a caller whose arg RESOLVES to the
                      // concrete capture struct — `(void*)(<struct value>)`,
                      // the stage-2 dyn-capture cluster. Runtime param types
                      // here are post-_spec_resolve_arg_ty, so requiring the
                      // same SomeT-ness keeps def-era reuse (bare↔bare) and
                      // concrete reuse (struct↔struct) intact.
                      cached_is_some := is_some_type(cached_ty);
                      current_is_some := is_some_type(current_ty);
                      if((cached_is_some && !(current_is_some)) || (!(cached_is_some) && current_is_some), {
                        rt_match = false;
                      }, {
                        if(!(are_types_compatible_exact(cached_ty, current_ty)), {
                          rt_match = false;
                        }, {
                          // A nominal instantiation whose type_arguments carry a
                          // SomeT (`IterFilter(CountIter, F)` — the per-call
                          // closure-`F` family) compares compat-EQUAL across
                          // calls: the shared def-era `F` matches by id while the
                          // per-call resolution lives in its cell chain. codegen's
                          // type_key resolves that chain (`_tk_resolve_arg_slot`),
                          // so two receivers with different capture structs get
                          // DIFFERENT C types — sharing one spec across them
                          // passes `__yo_t14*` to a `__yo_t2*` param (2 clang
                          // diagnostics on native, hard errors on emcc 6: the
                          // iter_filter_closure wasm-leg break; only the blanket
                          // `next` collapsed — `filter` itself is protected by
                          // the clfid cache-key extras, which cover closure
                          // ARGUMENTS but not closures buried in a receiver's
                          // type arguments). TS cannot collide here: each
                          // instantiation is a distinct object with a unique
                          // type id under requireExactMatch (helper.ts:2290).
                          // Require type_key equality — the exact identity the
                          // emitted C is keyed by — before reusing the spec.
                          ck_tyargs := ArrayList(TypeValue).new();
                          _collect_type_arg_somes(cached_ty, ck_tyargs, ArrayList(String).new());
                          if(ck_tyargs.len() > usize(0), {
                            if(!(type_key(cached_ty) == type_key(current_ty)), {
                              rt_match = false;
                            });
                          });
                        });
                      });
                      rti = (rti + usize(1));
                    });
                  });
                  if(rt_match, {
                    result = Option(EvalValue).Some(cache.specialized_func_value);
                  });
                });
              },
              .None => ()
            );
            ci = (ci + usize(1));
          });
        });
      },
      .None => ()
    );
    ei = (ei + usize(1));
  });
  result
});
/// Store a specialization in the cache.
_store_specialization_cache :: (
  fn(
    ctx : EvalContext,
    func_id : String,
    compile_time_arg_values : ArrayList(EvalValue),
    runtime_parameter_types : ArrayList(TypeValue),
    specialized_func_val : EvalValue,
    env : Environment
  ) -> unit
)({
  new_cache := SpecializedFunctionCache(
    compile_time_arg_values : compile_time_arg_values,
    runtime_parameter_types : runtime_parameter_types,
    specialized_func_value : specialized_func_val,
    env : env
  );
  // Find existing entry for this func_id
  n_entries := g_specialized_fn_caches.len();
  (ei : usize) = usize(0);
  (found : bool) = false;
  while((ei < n_entries) && !(found), {
    entry_opt := g_specialized_fn_caches.get(ei);
    match(
      entry_opt,
      .Some(entry) => {
        if(entry.func_id == func_id, {
          found = true;
          // Push into existing entry's caches
          entry.caches.push(new_cache);
        });
      },
      .None => ()
    );
    ei = (ei + usize(1));
  });
  if(!(found), {
    // Create new entry
    new_caches := ArrayList(SpecializedFunctionCache).new();
    new_caches.push(new_cache);
    g_specialized_fn_caches.push(
      SpecializedFunctionCacheEntry(
        func_id : func_id,
        caches : new_caches
      )
    );
  });
});
/// Render the impl-generic bindings a generic-impl method carries as `TypeVal`
/// captures (`_inject_forall_captures`, evaluator/values/impl.yo) into a
/// deterministic signature string. TS never needs this: each generic-impl
/// method INSTANTIATION gets a unique funcId embedding its substitutions
/// (impl.ts:1551), so identity comparisons distinguish `Eq(ArrayList(i32)).==`
/// from `Eq(ArrayList(ArrayList(i32))).==` for free. yo-self keeps the shared
/// original func_id and injects the bindings as captures — so recursion
/// guards must compare THIS alongside the func_id, or a nested call to the
/// same trait method at a SMALLER instantiation (ArrayList(ArrayList(i32))'s
/// `==` comparing elements via ArrayList(i32)'s `==`) is misread as direct
/// self-recursion, skips specialization, and the call site emits the BARE
/// generic fid ("call to undeclared function 'yo_id_NNNN'" — the collections
/// batch residual). Empty for plain generic functions and non-FuncVals.
_impl_type_captures_sig :: (fn(fv : EvalValue) -> String)({
  out := String.new();
  match(
    fv,
    .FuncVal(__fvs1, cvs) => {
      cns := __fvs1.*.cap_names;
      n := cvs.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          cvs.get(i),
          .Some(cv) => match(
            cv,
            .TypeVal(tv) => {
              out.push_string(match(cns.get(i), .Some(nm) => nm, .None => String.from("_")));
              out.push_str("=");
              out.push_string(sanitize_for_sig(value_to_signature_string(EvalValue.TypeVal(tv))));
              out.push_str(";");
            },
            _ => ()
          ),
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  );
  out
});
/// Find the in-progress specialization for `fid` on the FULL specializing stack,
/// used for the MUTUAL-recursion forward-reference. Returns None when `fid` is the
/// innermost (top-slot) specialization — that DIRECT case is handled by yo-self's
/// `recur` machinery, so it must NOT be forward-ref'd (only mutual recursion, where
/// the single slot has been overwritten by an inner sibling, needs it). Mirrors the
/// stack `.find` in TS helper.ts:1993. The returned info carries only the id/type
/// fields (EvalValue has no clone; `original_func_value` is unused here).
/// `bindings_sig` (see `_impl_type_captures_sig`) must ALSO match: a stack hit
/// for the same func_id at a DIFFERENT impl instantiation is not recursion.
_find_mutual_specializing_info :: (
  fn(ctx : EvalContext, fid : String, bindings_sig : String) -> Option(SpecializingFunctionInfo)
)({
  top_is_fid := match(
    ctx.currently_specializing_function,
    .Some(si) => ((si.original_func_id == fid) && (si.impl_bindings_sig == bindings_sig)),
    .None => false
  );
  if(
    top_is_fid,
    Option(SpecializingFunctionInfo).None,
    match(
      ctx.currently_specializing_function_stack,
      .Some(stk) => {
        (i : usize) = usize(0);
        (found : Option(SpecializingFunctionInfo)) = Option(SpecializingFunctionInfo).None;
        while(i < stk.len(), {
          match(
            stk.get(i),
            .Some(si) => if(((si.original_func_id == fid) && (si.impl_bindings_sig == bindings_sig)) && found.is_none(), {
              found = Option(SpecializingFunctionInfo).Some(
                SpecializingFunctionInfo(
                  original_func_id : si.original_func_id.clone(),
                  specialized_func_id : si.specialized_func_id.clone(),
                  specialized_return_type : si.specialized_return_type.clone(),
                  original_func_value : EvalValue.UnitVal,
                  impl_bindings_sig : si.impl_bindings_sig.clone()
                )
              );
            }),
            .None => ()
          );
          i = (i + usize(1));
        });
        found
      },
      .None => Option(SpecializingFunctionInfo).None
    )
  )
});
/// Build a forward-reference `FuncVal` for a recursive call encountered mid-
/// specialization: a copy of the callee's arity (generic/param/evidence labels) with
/// the body + captures stripped and `func_id` rewritten to the in-progress
/// `specialized_func_id`, so codegen emits a call to the specialized function rather
/// than re-specializing the generic original. Mirrors TS helper.ts:1998-2010
/// (`{...functionValue, funcId: specInfo.specializedFuncId}`); yo-self strips the
/// body/caps because the value is a reference (never re-evaluated) and `EvalValue`
/// is not clonable.
_build_forward_ref_funcval :: (
  fn(func_val : Option(EvalValue), specialized_func_id : String) -> EvalValue
)(
  match(
    func_val,
    .Some(fv) => match(
      fv,
      .FuncVal(__fvm1, _) => EvalValue.FuncVal(
        box(
          FuncValData(
            forall_names : __fvm1.*.forall_names.clone(),
            params : __fvm1.*.params.clone(),
            param_type_names : __fvm1.*.param_type_names.clone(),
            evidence_params : __fvm1.*.evidence_params.clone(),
            body : make_err_expr(),
            cap_names : ArrayList(String).new(),
            cap_tys : ArrayList(TypeValue).new(),
            func_id : specialized_func_id
          )
        ),
        ArrayList(EvalValue).new()
      ),
      _ => EvalValue.UnitVal
    ),
    .None => EvalValue.UnitVal
  )
);
// ---------------------------------------------------------------------------
// create_specialized_function_inline
/// Resolve a SomeT through its resolved-concrete cell chain (the same walk as
/// type_key's `_tk_resolve_arg_slot`, incl. the "Impl"/nameless exclusions).
/// Returns the input unchanged when the chain ends unresolved.
_spec_resolve_slot_cell :: (fn(t_in : TypeValue) -> TypeValue)({
  (cur : TypeValue) = t_in;
  (seen : ArrayList(String)) = ArrayList(String).new();
  (walk : bool) = true;
  while(walk, {
    match(
      cur,
      .SomeT({ id : brs_id, name : brs_nm, resolved_concrete : brs_rc }) => {
        if((brs_nm == "Impl") || (brs_nm.len() == usize(0)), {
          return(t_in);
        });
        (revisit : bool) = false;
        (bri : usize) = usize(0);
        while(bri < seen.len(), {
          if(match(seen.get(bri), .Some(s) => (s == brs_id), .None => false), {
            revisit = true;
          });
          bri = (bri + usize(1));
        });
        if(revisit, {
          walk = false;
        }, {
          seen.push(brs_id.clone());
          match(
            brs_rc.get(usize(0)),
            .Some(nx) => {
              cur = nx;
            },
            .None => {
              walk = false;
            }
          );
        });
      },
      _ => {
        walk = false;
      }
    );
  });
  cond(is_some_type(cur) => t_in, true => cur)
});
/// SNAPSHOT a ctor-stamped record's generic slots at SPECIALIZATION time:
/// resolve each `type_arguments`/`field_types` SomeT through its cell chain
/// NOW, so the registered spec signature reads the CALL era instead of
/// whatever the shared def-era cell holds when the C emitter finally walks it.
/// The def-era slot SomeT (e.g. prelude filter's `F`) is ONE lineage across
/// every call site — a later `.filter(q)` call overwrites the cell, so an
/// emission-time read resolves a DIFFERENT era than the call the spec was
/// minted for (`IterFilter(_, capture-A)` at the call site vs
/// `IterFilter(_, capture-B)` in the spec signature — the arm-18 clang
/// mismatch). TS is immune: each call freshens its forall objects and the
/// record references THAT call's SomeType, whose resolvedConcreteType is set
/// once and never rebound.
_bake_record_slots :: (fn(ty : TypeValue) -> TypeValue)(
  match(
    ty,
    .Struct({
      id : bk_id,
      name : bk_nm,
      field_labels : bk_fl,
      field_types : bk_ft,
      is_reference_semantics : bk_ref,
      is_atomic_rc : bk_arc,
      is_newtype : bk_nt,
      constructor_func_id : bk_cfid,
      type_arguments : bk_tas,
      is_source_namespace : bk_ns
    }) => {
      if((bk_cfid.len() == usize(0)) || (bk_tas.len() == usize(0)), {
        return(ty);
      });
      (bk_changed : bool) = false;
      bk_new_tas := ArrayList(TypeValue).new();
      (bk_i : usize) = usize(0);
      while(bk_i < bk_tas.len(), {
        bk_t := match(bk_tas.get(bk_i), .Some(t) => t, .None => TypeValue.Unit);
        (bk_r : TypeValue) = bk_t;
        if(is_some_type(bk_t), {
          bk_r = _spec_resolve_slot_cell(bk_t);
          if(!(is_some_type(bk_r)), {
            bk_changed = true;
          }, {
            bk_r = bk_t;
          });
        });
        bk_new_tas.push(bk_r);
        bk_i = (bk_i + usize(1));
      });
      if(!(bk_changed), {
        return(ty);
      });
      bk_new_ft := ArrayList(TypeValue).new();
      (bk_j : usize) = usize(0);
      while(bk_j < bk_ft.len(), {
        bk_f := match(bk_ft.get(bk_j), .Some(t) => t, .None => TypeValue.Unit);
        (bk_fr : TypeValue) = bk_f;
        if(is_some_type(bk_f), {
          bk_fr = _spec_resolve_slot_cell(bk_f);
          if(is_some_type(bk_fr), {
            bk_fr = bk_f;
          });
        });
        bk_new_ft.push(bk_fr);
        bk_j = (bk_j + usize(1));
      });
      TypeValue.Struct(
        id : bk_id,
        name : bk_nm,
        field_labels : bk_fl,
        field_types : bk_new_ft,
        is_reference_semantics : bk_ref,
        is_atomic_rc : bk_arc,
        is_newtype : bk_nt,
        constructor_func_id : bk_cfid,
        type_arguments : bk_new_tas,
        is_source_namespace : bk_ns
      )
    },
    _ => ty
  )
);
/// Containment shell for the mint-side closure-body RE-EVALUATION (see the
/// call site in create_specialized_function_inline): the swallow handler is a
/// capture-free `->` unwind, which exits THIS fn only — same pattern as
/// function_type.yo's `_trial_eval_fn_body`.
_reeval_closure_body_swallow :: (
  fn(body : AstExpr, benv : Environment, ctx : EvalContext) -> unit
)({
  rcb_exn := Exception(throw : ((_rcb_e) -> unwind(())));
  rcb_out := evaluate_expression_raw(wrap_body_in_begin(body), benv, ctx, rcb_exn);
  rcb_out;
});
// ---------------------------------------------------------------------------
/// Create (or retrieve from cache) a specialized version of a generic function
/// with compile-time arguments bound.
///
/// This is the core of generic function monomorphization. It:
///   1. Computes a deterministic compile-time signature from arg values.
///   2. Checks the global specialization cache for a matching entry.
///   3. On cache miss: evaluates the function body in the specialized callee_env,
///      creates a new FuncVal with the specialized func_id + updated captures,
///      stores in cache.
///   4. Returns the specialized FuncVal.
///
/// NOTE: Effects analysis (isControlFunction detection, effectCtlParams, etc.)
/// is not yet implemented here — it is the TS function's largest section
/// (~600 lines) and requires more infrastructure. That is deferred to Phase 4k.
///
/// Mirrors the core (pre-effects) of `createSpecializedFunctionInline` in
/// `src/evaluator/calls/helper.ts`.
/// Resolve a specialization ARG type through the SomeT resolution chain (own
/// cell first, then the global registry), bounded by a visited set. Adopt ONLY
/// a CONCRETE (non-SomeT) result. TS's computeCompileTimeSignature and the
/// specialized param types read the SomeType's `resolvedConcreteType`
/// (helper.ts:2245-2252), so a FORWARDED closure param specializes on the
/// CAPTURE STRUCT, not on the caller's abstract SomeT id. Without this, every
/// forwarding hop keyed the spec on the bare declared SomeT id: the def-era
/// TYPE-ERASED spec (param rendered void*) and the resolved-era call collided
/// in the spec cache (`are_types_compatible_exact` matches SomeT-vs-SomeT by
/// shape), so a caller holding a concrete capture struct called the void*
/// spec — `(void*)(<struct value>)`, the stage-2 dyn-capture clang cluster
/// (issues/yo-self-stage2-get-type-string-cycle.md).
_spec_resolve_arg_ty :: (fn(t_in : TypeValue) -> TypeValue)({
  (cur : TypeValue) = t_in;
  (seen : ArrayList(String)) = ArrayList(String).new();
  (walk : bool) = true;
  while(walk, {
    match(
      cur,
      .SomeT({ id : sr_id, resolved_concrete : sr_rc }) => {
        (revisit : bool) = false;
        (ri : usize) = usize(0);
        while(ri < seen.len(), {
          match(
            seen.get(ri),
            .Some(rs) => if(rs == sr_id, {
              revisit = true;
            }),
            .None => ()
          );
          ri = (ri + usize(1));
        });
        if(revisit, {
          walk = false;
        }, {
          seen.push(sr_id.clone());
          match(
            sr_rc.get(usize(0)),
            .Some(nx) => {
              cur = nx;
            },
            .None => match(
              lookup_some_resolved_concrete(sr_id),
              .Some(gx) => {
                cur = gx;
              },
              .None => {
                walk = false;
              }
            )
          );
        });
      },
      _ => {
        walk = false;
      }
    );
  });
  if(is_some_type(cur), t_in, cur)
});
create_specialized_function_inline :: (
  fn(
    original_func_val : EvalValue,
    func_type : TypeValue,
    arg_values : ArgValues,
    callee_env : Environment,
    caller_env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> EvalValue
)({
  result := match(
    original_func_val,
    .FuncVal(__fvm2, cap_vals) => {
      forall_names := __fvm2.*.forall_names;
      params := __fvm2.*.params;
      param_type_names := __fvm2.*.param_type_names;
      evidence_params := __fvm2.*.evidence_params;
      body := __fvm2.*.body;
      cap_names := __fvm2.*.cap_names;
      cap_tys := __fvm2.*.cap_tys;
      func_id := __fvm2.*.func_id;
      // ------------------------------------------------------------------
      // Collect compile-time arg values and runtime parameter types
      // ------------------------------------------------------------------
      compile_time_args := ArrayList(EvalValue).new();
      runtime_param_tys := ArrayList(TypeValue).new();
      // Add generic type arguments (always compile-time)
      (fai : usize) = usize(0);
      n_fa := arg_values.forall_args.len();
      while(fai < n_fa, {
        match(
          arg_values.forall_args.get(fai),
          .Some(ae) => match(
            ae.value,
            .Some(v) => {
              compile_time_args.push(v);
            },
            .None => ()
          ),
          .None => ()
        );
        fai = (fai + usize(1));
      });
      // Add implicit arguments (always compile-time)
      match(
        arg_values.implicit_args,
        .Some(impl_args) => {
          (iai : usize) = usize(0);
          n_ia := impl_args.len();
          while(iai < n_ia, {
            match(
              impl_args.get(iai),
              .Some(ae) => match(
                ae.value,
                .Some(v) => {
                  compile_time_args.push(v);
                },
                .None => ()
              ),
              .None => ()
            );
            iai = (iai + usize(1));
          });
        },
        .None => ()
      );
      // Build runtime parameter types from regular args
      // Phase 3 simplification: all regular params are treated as runtime.
      // This means we track all regular arg types for cache differentiation.
      // EXCEPTION (TS helper.ts:2233-2237): an explicit `comptime(K) : Type`
      // param's arg is a COMPILE-TIME value — its VALUE joins the cache key
      // (else `_node_insert(i32, ...)` and `_node_insert(String, ...)` collide
      // on identical TypeUni arg types and share one spec). The arg TYPE still
      // goes into runtime_param_tys to preserve the index alignment every
      // later per-param loop in this fn relies on; the REGISTERED spec type
      // filters these indices out (see the spec_param_types loop below).
      spec_param_ct_flags := get_func_param_comptime(func_id.clone());
      (ai : usize) = usize(0);
      n_a := arg_values.args.len();
      while(ai < n_a, {
        match(
          arg_values.args.get(ai),
          .Some(ae) => {
            sp_ai_ct := match(spec_param_ct_flags.get(ai), .Some(f) => f, .None => false);
            if(sp_ai_ct, {
              match(
                ae.value,
                .Some(ct_v) => {
                  compile_time_args.push(ct_v);
                },
                .None => ()
              );
            });
            // Resolve through the SomeT chain so the cache lookup, the sig,
            // and the spec's registered param types all see the CONCRETE
            // identity (see _spec_resolve_arg_ty).
            runtime_param_tys.push(_spec_resolve_arg_ty(ae.arg_type));
          },
          .None => ()
        );
        ai = (ai + usize(1));
      });
      // Refuse to mint a specialization from a DEGENERATE analysis pass: a
      // runtime arg whose type collapsed to UNIT against a concrete non-unit
      // DECLARED param only arises when an upstream resolution soft-failed
      // (e.g. an `open`-module member read under analysis → UnknownVal →
      // unit-typed chain). The minted spec carries unit params/locals and an
      // empty condition render (`void flag`, `if ()` — the assert spec from
      // issues/repros/void-param-assert-open-env.yo), nothing ever calls it,
      // and its mere emission breaks the whole batch C. TS's checking-phase
      // gates never register such a spec. Return the ORIGINAL value
      // unspecialized — the later non-degenerate pass mints the good spec and
      // re-stamps the call site.
      {
        (degenerate_unit_arg : bool) = false;
        match(
          func_type,
          .Func({ param_types : dg_pt }) => {
            (dgi : usize) = usize(0);
            while((dgi < runtime_param_tys.len()) && !(degenerate_unit_arg), {
              rpt_d := match(runtime_param_tys.get(dgi), .Some(t) => t, .None => t_unit());
              decl_d := match(dg_pt.get(dgi), .Some(t) => t, .None => t_unit());
              if((is_unit_type(rpt_d) && !(is_unit_type(decl_d))) && !(type_contains_some_type(decl_d)), {
                degenerate_unit_arg = true;
              });
              dgi = (dgi + usize(1));
            });
          },
          _ => ()
        );
        if(degenerate_unit_arg, {
          return(original_func_val);
        });
      };
      // Bind explicit `comptime(K) : Type` params into the mint env EARLY —
      // BEFORE the return-type re-evaluation below (TS binds
      // compileTimeArgValues into specializedEnv before
      // evaluateFunctionReturnTypeAgain, helper.ts:2330-2378). Binding them
      // only in the param-binding loop (which runs AFTER spec_ret_ty) left
      // `Pair(K, V)` in the declared return unresolvable at re-eval time, so
      // the mint fell back to the def-era SomeT instance and split the
      // instantiation lineage.
      {
        (ectp_i : usize) = usize(0);
        while(ectp_i < params.len(), {
          ectp_ct := match(spec_param_ct_flags.get(ectp_i), .Some(f) => f, .None => false);
          if(ectp_ct, {
            ectp_label := match(params.get(ectp_i), .Some(l) => l, .None => String.from(""));
            match(
              arg_values.args.get(ectp_i),
              .Some(ectp_ae) => match(
                ectp_ae.value,
                .Some(ectp_v) => {
                  ectp_ty := match(ectp_v, .TypeVal(_) => TypeValue.TypeUni(usize(0)), _ => ectp_ae.arg_type);
                  _ectp := add_variable_to_env(
                    callee_env,
                    ectp_label,
                    ectp_ty,
                    Option(EvalValue).Some(ectp_v),
                    true,
                    false,
                    false,
                    false,
                    synthetic_token(ectp_label, callee_env.module_path)
                  );
                  // This binds a PARAMETER label — flag it (see the
                  // check_if_function_parameter_matches_argument bind).
                  match(
                    _ectp,
                    .Some(ectp_var) => {
                      ectp_var.is_parameter = true;
                    },
                    .None => ()
                  );
                },
                .None => ()
              ),
              .None => ()
            );
          });
          ectp_i = (ectp_i + usize(1));
        });
      };
      // Distinguish specializations by the RESOLVED RETURN TYPE when the
      // declared result mentions a SomeT. A generic type-constructor's
      // struct-internal static method (HashMap(K,V).with_capacity /
      // ._alloc_with_capacity / .new — hash_map.yo) is ONE shared FuncVal
      // across instantiations: no forall_labels carry K/V and the runtime
      // params don't mention them, so compile-time args + runtime param types
      // are IDENTICAL for HashMap(usize,String) and HashMap(usize,i32) — the
      // cache returned the FIRST instantiation's specialization (its concrete
      // return type baked in) for every later receiver → stage-2
      // "initializing __yo_tA with __yo_tB" mismatches on Result(HashMap(...)).
      // TS cannot collide here: its per-instantiation FunctionValue OBJECTS
      // each carry their own specializedFunctionCaches. The call site DOES
      // resolve the return per receiver (the caller-side C locals are typed
      // correctly) — so key the specialization on that resolved return: an
      // EXTRA COMPILE-TIME cache-key value (+ a sig segment below), NOT a
      // runtime param (a prior attempt appending self_type to
      // runtime_param_tys changed C call arity and regressed massively).
      // GATED on the DECLARED result containing a SomeT, so fns with concrete
      // declared returns are untouched; for a still-unresolved generic return
      // the probe stays the same SomeT for every caller (no split).
      (ret_sig_ty : Option(TypeValue)) = Option(TypeValue).None;
      {
        declared_ret := match(func_type, .Func({ result : dr }) => dr, _ => t_unit());
        ret_probe := cond(
          (get_all_some_types(declared_ret).len() > usize(0)) =>
            evaluate_function_return_type_again(declared_ret, callee_env, ctx),
          true => declared_ret
        );
        ret_sig_ty = Option(TypeValue).Some(ret_probe);
        compile_time_args.push(EvalValue.TypeVal(ret_probe));
      };
      // Closure-identity cache keys. TS folds `_id${paramType.id}` into the
      // signature and compares cached runtime types with STRICT type-ID
      // matching (helper.ts:2176, 2290): every closure LITERAL's FunctionType
      // is a fresh object with a unique id, so two same-signature closures
      // never share a specialization there. yo-self's FnTraitT compares
      // structurally, so `Thread.spawn(c1)` / `Thread.spawn(c2)` collided on
      // ONE cached spec — the second call site passed its own capture struct
      // to a body compiled for the first's ("passing '__yo_t15' to parameter
      // of incompatible type '__yo_t14'"; arc/prelude, repro
      // issues/repros/arc-spawn-capture-split.yo). A closure's func_id is the
      // yo-self equivalent of TS's type identity: fold it into the
      // compile-time cache key (+ the sig segment below, same gate as
      // ret_sig_ty) — NOT into runtime_param_tys (appending there changed C
      // call arity and regressed massively; see the warning above).
      (closure_fid_sig : String) = String.new();
      {
        (cfi : usize) = usize(0);
        n_cfa := arg_values.args.len();
        while(cfi < n_cfa, {
          match(
            arg_values.args.get(cfi),
            .Some(cf_ae) => match(
              cf_ae.value,
              .Some(cf_v) => match(
                cf_v,
                .FuncVal(cf_fvd, _) => {
                  cf_fid := cf_fvd.*.func_id;
                  compile_time_args.push(EvalValue.StrLit(`clfid${cfi.to_string()}_${cf_fid}`));
                  closure_fid_sig.push_str("_cl");
                  closure_fid_sig.push_string(cfi.to_string());
                  closure_fid_sig.push_str("_");
                  closure_fid_sig.push_string(sanitize_for_sig(cf_fid.clone()));
                },
                _ => ()
              ),
              .None => ()
            ),
            .None => ()
          );
          cfi = (cfi + usize(1));
        });
      };
      // ------------------------------------------------------------------
      // Cache lookup
      // ------------------------------------------------------------------
      cached := _find_specialization_cache(
        ctx,
        func_id.clone(),
        compile_time_args,
        runtime_param_tys,
        caller_env
      );
      match(
        cached,
        .Some(spec_val) => spec_val,
        .None => {
          // ------------------------------------------------------------------
          // Cache miss: create the specialization
          // ------------------------------------------------------------------
          // Compute specialized func_id
          sig := compute_compile_time_signature(func_type, arg_values, callee_env, runtime_param_tys, spec_param_ct_flags, exn);
          // Resolved-return segment — must vary exactly when the cache-key
          // extra value above varies, so distinct receivers get distinct
          // emitted func_ids (same gate).
