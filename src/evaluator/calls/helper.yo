          });
          if(!(found_given), {
            exn.throw(
              dyn(
                format_error_message(
                  tok,
                  `No "given" variable found for implicit parameter "${impl_label}"`,
                  false,
                  .None
                )
              )
            );
          });
          match(
            given_val,
            .Some(gv_val) => {
              impl_tok2 := synthetic_token(impl_label, callee_env_m.module_path);
              add_variable_to_env(
                callee_env_m,
                impl_label,
                resolved_impl_type,
                .Some(gv_val),
                true,
                // is_compile_time_only
                false,
                false,
                true,
                // is_implicit
                impl_tok2
              );
              implicit_arg_vals.push(
                ArgEntry(
                  value : .Some(gv_val),
                  parameter_type : resolved_impl_type,
                  arg_type : given_ty
                )
              );
            },
            .None => {
              exn.throw(
                dyn(
                  format_error_message(
                    tok,
                    `The "given" variable "${given_name}" has no compile-time value`,
                    false,
                    .None
                  )
                )
              );
            }
          );
        });
        impl_i = (impl_i + usize(1));
      });
      // ----------------------------------------------------------------
      // Step 12: Validate return type and build FuncCallResult.
      // ----------------------------------------------------------------
      validate_function_return_type(return_type, expr, callee_env_m, ctx, exn);
      implicit_args_result := if(
        implicit_arg_vals.len() > usize(0),
        Option(ArrayList(ArgEntry)).Some(implicit_arg_vals),
        Option(ArrayList(ArgEntry)).None
      );
      // ----------------------------------------------------------------
      // Step 12b: Create specialized function value if needed.
      // Simplified port of the specialization guard in helper.ts.
      // ----------------------------------------------------------------
      // A generic-impl method resolved for a concrete receiver arrives with its
      // Func TYPE already concretized (generic stripped, `fl=0`), but its FuncVAL
      // carries the impl's generic (stamped at impl-eval by
      // `_stamp_impl_forall_on_method`). That surviving `forall_names` is the
      // signal that the method needs specialization — without it the method is
      // never specialized and codegen only has the abstract body (skipped). Mirror
      // TS, which recognizes generic-impl methods via `forallParameters` on the
      // function value's type.
      fv_has_forall := match(
        func_val,
        .Some(fvp) => match(fvp, .FuncVal(__fvd13, _) => (__fvd13.*.forall_names.len() > usize(0)), _ => false),
        .None => false
      );
      callee_own_type := match(
        func_val,
        .Some(fvg) => match(fvg, .FuncVal(__fvg, _) => get_func_type(__fvg.*.func_id), _ => func_type),
        .None => func_type
      );
      callee_own_generic := _func_type_has_runtime_some_param(callee_own_type);
      // TS `isFunctionTypeGeneric` (guards.ts:457) ALSO counts COMPTIME
      // PARAMS (`parameters.some(p => p.isCompileTimeOnly)`), excluding only
      // comptime-RETURNING functions (those are CTFE'd, guards.ts:462-464).
      // A trait-impl method like `try_into : (fn(self : Self,
      // (comptime(_To) : Type) = To) -> Result(To, Self.Error))` has fl=0
      // (its generics are trait-level), no impl foralls, and no runtime SomeT
      // param — but its comptime param makes each call site a distinct
      // instantiation. Without this the call skipped specialization and
      // emitted a DIRECT call to the abstract fid, which codegen never emits
      // ('call to undeclared function fn_yo_id_…' — prelude arm 1's
      // trait-impl-closure emission gap;
      // tests/codegen-bootstrap/assigned_param_overload_select.yo).
      fv_result_ct := match(func_type, .Func({ meta : __fm12 }) => __fm12.*.result_is_comptime_only, _ => false);
      (fv_has_ct_param : bool) = false;
      if(!(fv_result_ct), {
        match(
          func_val,
          .Some(fvcp) => match(
            fvcp,
            .FuncVal(__fvd16, _) => {
              cfp_flags := get_func_param_comptime(__fvd16.*.func_id.clone());
              (cfp_i : usize) = usize(0);
              while((cfp_i < cfp_flags.len()) && !(fv_has_ct_param), {
                match(
                  cfp_flags.get(cfp_i),
                  .Some(cfp_f) => if(cfp_f, {
                    fv_has_ct_param = true;
                  }),
                  .None => ()
                );
                cfp_i = (cfp_i + usize(1));
              });
            },
            _ => ()
          ),
          .None => ()
        );
      });
      is_func_generic := (((((fl.len() > usize(0)) || (il.len() > usize(0))) || fv_has_forall) || callee_own_generic) || fv_has_ct_param);
      spec_template_type := if(
        callee_own_generic && !(_func_type_has_runtime_some_param(func_type)),
        callee_own_type,
        func_type
      );
      (spec_func_val : Option(EvalValue)) = Option(EvalValue).None;
      if(!(skip_specialization) && is_func_generic, {
        callee_fid_g := match(
          func_val,
          .Some(fv) => match(fv, .FuncVal(__fvd14, _) => __fvd14.*.func_id, _ => String.from("")),
          .None => String.from("")
        );
        // The callee's impl-instantiation identity: TS distinguishes generic-impl
        // method instantiations by funcId (impl.ts:1551 embeds the substitutions);
        // yo-self shares one func_id and injects the bindings as TypeVal captures,
        // so both recursion guards below compare this signature TOO. Without it,
        // `Eq(ArrayList(ArrayList(i32))).==` specializing and calling
        // `Eq(ArrayList(i32)).==` on its elements was misread as self-recursion:
        // the inner call skipped specialization and emitted the BARE generic fid
        // ("call to undeclared function" — the collections batch residual).
        callee_bindings_sig := match(
          func_val,
          .Some(fv_bs) => _impl_type_captures_sig(fv_bs),
          .None => String.new()
        );
        // Direct self-recursion (callee is the innermost specialization, SAME
        // instantiation): left to the existing skip + `recur` machinery
        // (unchanged behavior).
        is_recursive_spec := match(
          ctx.currently_specializing_function,
          .Some(spec_info) => ((spec_info.original_func_id == callee_fid_g) && (spec_info.impl_bindings_sig == callee_bindings_sig)),
          .None => false
        );
        // MUTUAL recursion (callee is being specialized higher up, not innermost):
        // forward-reference the in-progress specialization instead of re-specializing
        // it (which never terminates and overflows the stack in the unified stage-2
        // self-compile — Phase 6). Mirrors TS helper.ts:1985-2010.
        mutual_info := _find_mutual_specializing_info(ctx, callee_fid_g, callee_bindings_sig.clone());
        mutual_is_some := mutual_info.is_some();
        is_concrete_fv := match(
          func_val,
          .Some(fv) => match(fv, .FuncVal(_, _) => true, _ => false),
          .None => false
        );
        match(
          mutual_info,
          .Some(minfo) => if(is_concrete_fv, {
            spec_func_val = Option(EvalValue).Some(
              _build_forward_ref_funcval(func_val, minfo.specialized_func_id.clone())
            );
          }),
          .None => ()
        );
        if((!(is_recursive_spec) && !(mutual_is_some)) && is_concrete_fv, {
          fv2 := match(func_val, .Some(v) => v, .None => EvalValue.UnitVal);
          // ----------------------------------------------------------------
          // Ctl function path: isControlFunction + has generic params.
          // Must come before regular specialization to override it.
          // Mirrors the `isControlFunction` branch in helper.ts step 12b.
          // ----------------------------------------------------------------
          fv2_func_id := match(
            fv2,
            .FuncVal(__fvd15, _) => __fvd15.*.func_id,
            _ => String.from("")
          );
          is_ctl := is_control_fn(fv2_func_id.clone());
          has_forall := (fl.len() > usize(0));
          if(is_ctl && has_forall, {
            spec_func_val = Option(EvalValue).Some(
              evaluate_ctl_function_body_inline(
                fv2,
                func_type,
                callee_env_m,
                caller_env_m,
                ctx,
                exn
              )
            );
            // The ctl call's RESULT is the generic ResumeType, concrete per
            // CALL SITE (the enclosing function's return type — the same
            // derivation evaluate_ctl_function_body_inline uses). Carry it on
            // the result SomeT's resolved_concrete so codegen types the
            // fn-ptr cast/temp concretely: `exn.throw(...)` merge-assigned to
            // an i32 local emitted a `void*` temp ("incompatible pointer to
            // integer conversion", the IoError.check stage-2 family). The
            // prelude ResumeType SomeT is SHARED — a global registration
            // would collide across calls with different resume types; the
            // per-object field is per-call-safe.
            if(is_some_type(return_type), {
              (ctl_res_conc : TypeValue) = match(
                ctx.is_evaluating_function_body_or_async_block,
                .Some(fb_ctx2) => match(
                  fb_ctx2.kind,
                  .FunctionBody => match(
                    fb_ctx2.func_type,
                    .Some(enclosing_ty2) => match(
                      enclosing_ty2,
                      .Func({ result : rb2 }) => rb2,
                      _ => match(func_type, .Func({ result : rb2b }) => rb2b, _ => TypeValue.Unit)
                    ),
                    .None => match(func_type, .Func({ result : rb2c }) => rb2c, _ => TypeValue.Unit)
                  ),
                  _ => match(func_type, .Func({ result : rb2d }) => rb2d, _ => TypeValue.Unit)
                ),
                .None => match(func_type, .Func({ result : rb2e }) => rb2e, _ => TypeValue.Unit)
              );
              if(!(is_some_type(ctl_res_conc)) && !(is_unit_type(ctl_res_conc)), {
                match(
                  return_type,
                  .SomeT(cr_id, cr_nm, cr_fl, cr_pt, cr_rtt, cr_rtl, cr_ntt, cr_ntl, cr_ier, cr_kft, _) => {
                    return_type = TypeValue.SomeT(
                      cr_id,
                      cr_nm,
                      cr_fl,
                      cr_pt,
                      cr_rtt,
                      cr_rtl,
                      cr_ntt,
                      cr_ntl,
                      cr_ier,
                      cr_kft,
                      t_resolved_cell(ctl_res_conc)
                    );
                  },
                  _ => ()
                );
              });
            });
          });
          // Regular specialization if ctl path did not produce a result.
          if(spec_func_val.is_none(), {
            spec_av := ArgValues(
              forall_args : forall_arg_vals,
              args : arg_vals,
              implicit_args : implicit_args_result,
              variadic_args : ArrayList(VarArgEntry).new()
            );
            spec_func_val = Option(EvalValue).Some(
              create_specialized_function_inline(
                fv2,
                spec_template_type,
                spec_av,
                callee_env_m,
                caller_env_m,
                ctx,
                exn
              )
            );
          });
        });
      });
      // Aliasing Stage 1 (mutation summaries, evaluator/effects/
      // mutation_summary.yo): a READ-ONLY callee cannot reassign the
      // aliased storage mid-call, so this call's Stage-0 dups are pure
      // overhead — remove each marked argument's deferred dup and discard
      // the balancing drops. The summary target is the specialization when
      // one exists (its evaluated body is final); recursion forward-refs
      // carry an unevaluated body and conservatively answer "may mutate".
      // The consumed dup temps stay in their frames — inert (consumed, no
      // scope-end drop; the dup that assigned them is gone).
      if(s0_call_drops.len() > usize(0), {
        (s1_target : Option(EvalValue)) = spec_func_val;
        if(s1_target.is_none(), {
          s1_target = func_val;
        });
        match(
          s1_target,
          .Some(s1_tv) => match(
            s1_tv,
            .FuncVal(s1_fvd, _) => {
              s1_fid := s1_fvd.*.func_id.clone();
              if(!(is_control_fn(s1_fid.clone())), {
                if(!(function_may_mutate_rc_storage(s1_fid, s1_fvd.*.body, ctx)), {
                  s1_elided = true;
                });
              });
            },
            _ => ()
          ),
          .None => ()
        );
        if(s1_elided, {
          (s1i : usize) = usize(0);
          while(s1i < s0_marked_args.len(), {
            match(
              s0_marked_args.get(s1i),
              .Some(s1_ma) => match(
                expr_info_table_get(ctx.expr_info_table, ast_expr_id(s1_ma)),
                .Some(s1_mai) => {
                  s1_mai.deferred_dup_expressions = Option(ArrayList(AstExpr)).None;
                },
                .None => {
                }
              ),
              .None => ()
            );
            s1i = (s1i + usize(1));
          });
        });
      });
      if(s9_dbg, {
        eprintln(`[s-final] ret=${type_to_string(return_type)}`);
      });
      FuncCallResult(
        callee_env : callee_env_m,
        caller_env : caller_env_m,
        path_collection : path_collection_new(),
        return_type : return_type,
        return_value : Option(EvalValue).None,
        arg_values : ArgValues(
          forall_args : forall_arg_vals,
          args : arg_vals,
          implicit_args : implicit_args_result,
          variadic_args : ArrayList(VarArgEntry).new()
        ),
        runtime_arg_exprs_in_order : rt_args,
        specialized_function_value : spec_func_val,
        deferred_drop_expressions : if((s0_call_drops.len() > usize(0)) && !(s1_elided), Option(ArrayList(AstExpr)).Some(s0_call_drops), Option(ArrayList(AstExpr)).None)
      )
    },
    _ => {
      // Soft fallback: when the callee's type isn't `.Func(...)` (e.g.
      // it's a source-namespace struct from an `impl({...})` operator binding like
      // `(-) :: impl({ Call :: (neg, comptime_neg); })`, or a `SomeT`
      // that hasn't been resolved to a Func yet), return a placeholder
      // `FuncCallResult` with `t_unit()` return instead of aborting
      // the surrounding eval. This lets the bootstrap make progress
      // through prelude impls that exercise operator-trait dispatch
      // patterns the bootstrap doesn't yet model. Tracked as an
      // evaluator coverage gap in `issues/yo-self-evaluator-gaps.md`.
      tok;
      FuncCallResult(
        callee_env : caller_env,
        caller_env : caller_env,
        path_collection : path_collection_new(),
        return_type : t_unit(),
        return_value : Option(EvalValue).None,
        arg_values : ArgValues(
          forall_args : ArrayList(ArgEntry).new(),
          args : ArrayList(ArgEntry).new(),
          implicit_args : Option(ArrayList(ArgEntry)).None,
          variadic_args : ArrayList(VarArgEntry).new()
        ),
        runtime_arg_exprs_in_order : ArrayList(AstExpr).new(),
        specialized_function_value : Option(EvalValue).None,
        deferred_drop_expressions : Option(ArrayList(AstExpr)).None
      )
    }
  )
});
export(try_to_call_function_with_arguments);
export(resolve_param_types_from_expected);
export(check_if_function_parameter_matches_argument);
export(validate_where_constraints_for_call);
export(reapply_where_clause_exprs_for_call);
export(extract_function_value);
export(validate_function_return_type);
export(generate_deferred_drop_expressions);
export(value_to_signature_string);
export(compute_compile_time_signature);
export(create_specialized_function_inline);
export(_type_has_array_len_var);
export(_trial_eval_ret_type_expr);
export(evaluate_ctl_function_body_inline);
