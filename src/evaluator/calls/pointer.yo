//! evaluator/calls/pointer — evaluate_raw_pointer_call.
//!
//! 1:1 port of `src/evaluator/calls/pointer.ts`.
//!
//! `*(T)` creates a pointer type `Pointer(T)`.
//! `*(val)` where val is not a type → error (use `&` to take the address of a value).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  make_err_expr
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext, in_def_time_trial } :: import("../context.yo");
_(env : ptr_dbg_env) :: import("std/env");
{ EvalValue, create_type_value, is_type_value } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_ptr, t_i32 } :: import("../../types/creators.yo");
{ type_of_type } :: import("../../types/hierarchy.yo");
{ type_to_string } :: import("../../types/string.yo");
{ type_is_control_bound } :: import("../../types/utils.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ evaluate_expression } :: import("../exprs/expr.yo");
/// Evaluate a raw pointer call `*(T)` (pointer type) or `*(val)` (error).
///
/// 1:1 port of `evaluateRawPointerCall` in `src/evaluator/calls/pointer.ts`.
evaluate_raw_pointer_call :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  // Get the single argument
  arg_expr := match(
    expr,
    .FnCall(_, _, args, _, _) => match(
      args.get(usize(0)),
      .Some(a) => a,
      .None => make_err_expr()
    ),
    .Atom(_, _) => make_err_expr()
  );
  // TypeScript: if expectedType is a pointer type, pass the inner type as expected.
  // Phase 2am: expectedType modification skipped — simplified port.
  // Evaluate the argument
  evaluated := evaluate_expression(arg_expr, env, ctx);
  // Read the expr info for the evaluated argument
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
  match(
    info_opt,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            `Failed to evaluate the argument expression for pointer:\n${ast_expr_to_string(arg_expr)}`,
            false,
            .None
          )
        )
      );
    },
    .Some(_) => ()
  );
  arg_info := match(
    info_opt,
    .Some(i) => i,
    .None => new_expr_info(env, t_i32()) // unreachable: guarded by throw above
  );
  // If the argument is a type value, create a pointer type; otherwise error.
  cond(
    is_type_value(arg_info.value) => {
      inner_ty := match(
        arg_info.value,
        .Some(v) => match(v, .TypeVal(inner) => inner, _ => t_i32()),
        .None => t_i32() // unreachable
      );
      // Phase C structural gate (plans/MEMORY_SAFETY.md): `*(T)` produces a raw
      // pointer type. In safe code (a file without `pragma(Pragma.AllowUnsafe);`
      // and not in an `unsafe(...)` context), raw pointer types are not part of
      // the user vocabulary — naming `*(T)` in a parameter / field / return slot
      // is rejected. 1:1 with `src/evaluator/calls/pointer.ts:75-86`.
      ptok := ast_expr_token(expr);
      if(!ctx.unsafe_context && !is_implicitly_unsafe_capable_file(Option(String).Some(ptok.module_path.clone())), {
        exn.throw(
          dyn(
            format_error_message(
              ptok,
              `Raw pointer types ('*(${type_to_string(inner_ty)})') are not available in safe code.\n\nUse 'ArrayList(T)' (or 'Array(T, N)') for bounded byte/element storage, 'inout(name) : T' parameters for in-place mutation, or wrap the underlying pointer in an 'object' type. If this file genuinely needs raw pointers, add 'pragma(Pragma.AllowUnsafe);' at the top — but consider whether the unsafe surface really belongs in this module.`,
              false,
              .None
            )
          )
        );
      });
      // §4 escape boundary (rule 11): a pointer type cannot have a
      // control-bound pointee. A `ctl(...)` value's lifetime is bound to its
      // install frame; a pointer would let writes-through-indirection escape
      // that frame. Banning the TYPE prevents the construction. Mirrors
      // `src/evaluator/calls/pointer.ts:87-101`.
      if(type_is_control_bound(inner_ty), {
        exn.throw(
          dyn(
            format_error_message(
              ptok,
              `Cannot form a pointer to a control-bound type. The pointee transitively contains a \`ctl(...) -> ret\` function value, whose lifetime is bound to its install frame. A pointer would allow writes-through-indirection that escape that frame.

Pointee type: ${type_to_string(inner_ty)}

If you need to thread a handler through code, pass it by value (handlers are fn-pointer-sized; copying is free).`,
              false,
              .None
            )
          )
        );
      });
      ptr_ty := t_ptr(inner_ty);
      ptr_val := create_type_value(ptr_ty);
      if(in_def_time_trial() && ptr_dbg_env.get(`YO_DEBUG_CTFE`).is_some(), {
        eprintln(`[ptr-call] inner=${type_to_string(inner_ty)} out=${type_to_string(ptr_ty)}`);
      });
      meta_ty := type_of_type(ptr_ty);
      next_env := arg_info.env;
      out_info := new_expr_info(next_env, meta_ty);
      out_info.value = .Some(ptr_val);
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
      expr
    },
    true => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            `Cannot create a pointer to a value. Use "&" to create a pointer to a value:\n${ast_expr_to_string(arg_expr)}`,
            false,
            .None
          )
        )
      );
      make_err_expr()
    }
  )
});
export(evaluate_raw_pointer_call);
