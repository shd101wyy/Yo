//! evaluator/calls/type — try_to_call_type_with_arguments.
//!
//! 1:1 port of `src/evaluator/calls/type.ts`.
//!
//! `try_to_call_type_with_arguments` handles struct/enum/union type constructor
//! calls, binding positional or labelled argument expressions to the type's fields
//! and returning the annotated call expression.
//!
//! Adaptation notes:
//! - TypeField is from `evaluator/types/field.yo` (not from the types layer).
//! - `TypeField.exprs.defaultValueExpr` doesn't exist in yo-self; when a field
//!   uses its default/assigned value, `runtimeArgExprsInOrder[i]` is set to the
//!   function callee expr as a placeholder (acceptable since codegen is not yet done).
//! - `isComptimeOnlyType` is approximated via `_is_comptime_only_type_approx`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
_(env : tycall_dbg_env) :: import("std/env");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set,
  path_collection_new,
  register_some_resolved_concrete
} :: import("../../expr_info.yo");
{ is_fn_trait_type, is_some_type } :: import("../../types/guards.yo");
{ Environment } :: import("../../env.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ type_to_string } :: import("../../types/string.yo");
{ are_types_compatible } :: import("../../types/compatibility.yo");
{ convert_comptime_type_to_runtime_type } :: import("../../types/env_lookup.yo");
{ EvalContext, ExpectedTypeCtx, TypeCallResult, in_def_time_trial } :: import("../context.yo");
{ EvalValue, value_to_string } :: import("../../value.yo");
{ TypeField } :: import("../types/field.yo");
{ set_expr_as_needs_to_call_dup } :: import("../utils.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
/// Approximation for `isComptimeOnlyType` (Phase 2 — full version deferred).
/// Returns true for types whose values only exist at compile time:
/// TypeUni (the `Type` kind), ComptimeInt, ComptimeFloat, ComptimeString.
_is_comptime_only_type_approx :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .TypeUni(_) => true,
    .ComptimeInt => true,
    .ComptimeFloat => true,
    .ComptimeString => true,
    _ => false
  )
);
/// Call a struct/enum/union type constructor with `arg_exprs`, binding fields.
///
/// `type_fields`  — the TypeField descriptors for the target type (from field registry).
/// `is_union_type` — when `true`, exactly one argument is expected.
///
/// Mirrors `tryToCallTypeWithArguments` in `src/evaluator/calls/type.ts`.
try_to_call_type_with_arguments :: (
  fn(
    type_fields : ArrayList(TypeField),
    function_callee_expr : AstExpr,
    arg_exprs : ArrayList(AstExpr),
    caller_env : Environment,
    ctx : EvalContext,
    is_union_type : bool,
    exn : Exception
  ) -> TypeCallResult
)({
  n_fields := type_fields.len();
  n_args := arg_exprs.len();
  // Validate argument count.
  if(n_args > n_fields, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(function_callee_expr),
          `Failed to call the type. Too many members provided. Expected ${n_fields.to_string()} arguments, got ${n_args.to_string()}.`,
          false,
          .None
        )
      )
    );
  });
  if(is_union_type && !(n_args == usize(1)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(function_callee_expr),
          `Failed to call the union type. Expected exactly one argument, got ${n_args.to_string()}.`,
          false,
          .None
        )
      )
    );
  });
  // Track which fields have been explicitly provided.
  // `checked_indices` maps field index → true.
  checked_indices := HashMap(usize, bool).new();
  // Per-field results.
  values := ArrayList(Option(EvalValue)).new();
  runtime_arg_exprs_in_order := ArrayList(AstExpr).new();
  // Pre-fill with None / placeholder.
  (pre_i : usize) = usize(0);
  while(pre_i < n_fields, {
    values.push(Option(EvalValue).None);
    runtime_arg_exprs_in_order.push(function_callee_expr);
    pre_i = (pre_i + usize(1));
  });
  (env : Environment) = caller_env;
  // Process each provided argument.
  (i : usize) = usize(0);
  while(i < n_args, {
    arg_expr_opt := arg_exprs.get(i);
    if(arg_expr_opt.is_none(), {
      i = (i + usize(1));
    });
    arg_expr := match(arg_expr_opt, .Some(a) => a, .None => function_callee_expr);
    field_opt := type_fields.get(i);
    member_element := match(
      field_opt,
      .Some(f) => f,
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg_expr),
              `No field at index ${i.to_string()} in type.`,
              false,
              .None
            )
          )
        );
        return(TypeCallResult(values : ArrayList(Option(EvalValue)).new(), path_collection : path_collection_new(), runtime_arg_exprs_in_order : ArrayList(AstExpr).new(), caller_env : env));
      }
    );
    (member_element_position_index : usize) = i;
    // Check if the arg uses a label `field: value`.
    (actual_arg_expr : AstExpr) = arg_expr;
    label_match := ast_expr_is_fn_call_of(arg_expr, ":", .Some(usize(2)));
    if(label_match, {
      // Extract the label and value sub-exprs.
      label_sub_opt := match(arg_expr, .FnCall(_, _, args, _, _) => args.get(usize(0)), _ => Option(AstExpr).None);
      value_sub_opt := match(arg_expr, .FnCall(_, _, args, _, _) => args.get(usize(1)), _ => Option(AstExpr).None);
      label_sub := match(
        label_sub_opt,
        .Some(s) => s,
        .None => {
          exn.throw(dyn(format_error_message(ast_expr_token(arg_expr), `Label arg missing label sub-expr.`, false, .None)));
          arg_expr
        }
      );
      value_sub := match(
        value_sub_opt,
        .Some(s) => s,
        .None => {
          exn.throw(dyn(format_error_message(ast_expr_token(arg_expr), `Label arg missing value sub-expr.`, false, .None)));
          arg_expr
        }
      );
      if(!(ast_expr_is_atom(label_sub)), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(label_sub),
              `Expected identifier for label, got:\n${ast_expr_to_string(label_sub)}`,
              false,
              .None
            )
          )
        );
      });
      // Look up the label in type_fields.
      label_tok := match(label_sub, .Atom(_, tok) => tok.value, _ => String.from(""));
      (found_idx : Option(usize)) = Option(usize).None;
      (search_i : usize) = usize(0);
      while(search_i < n_fields, {
        match(
          type_fields.get(search_i),
          .Some(f) => {
            if(f.label == label_tok, {
              found_idx = .Some(search_i);
            });
          },
          .None => ()
        );
        search_i = (search_i + usize(1));
      });
      match(
        found_idx,
        .Some(idx) => {
          found_field := match(type_fields.get(idx), .Some(f) => f, .None => member_element);
          // Cannot label an already-assigned field.
          if(found_field.assigned_value.is_some(), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(value_sub),
                  `Cannot use label "${found_field.label}" for already assigned value:\n${found_field.label}: ${type_to_string(found_field.ty)}`,
                  false,
                  .None
                )
              )
            );
          });
          member_element_position_index = idx;
          member_element = found_field;
          actual_arg_expr = value_sub;
        },
        .None => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(value_sub),
                `Failed to find "${label_tok}" in the type.`,
                false,
                .None
              )
            )
          );
        }
      );
    });
    // Check for duplicate labels.
    if(match(checked_indices.get(member_element_position_index), .Some(_) => true, .None => false), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(actual_arg_expr),
            `Type member "${member_element.label}" is already implemented.`,
            false,
            .None
          )
        )
      );
    });
    // Evaluate the argument expression.
    saved_expected := ctx.expected_type;
    ctx.expected_type = .Some(ExpectedTypeCtx(ty : member_element.ty, env : env));
    evaluated_arg := evaluate_expression(actual_arg_expr, env, ctx);
    ctx.expected_type = saved_expected;
    arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_arg));
    if(arg_info_opt.is_none(), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(actual_arg_expr),
            `Failed to evaluate argument expression:\n${ast_expr_to_string(actual_arg_expr)}`,
            false,
            .None
          )
        )
      );
    });
    arg_info := match(arg_info_opt, .Some(it) => it, .None => new_expr_info(env, member_element.ty));
    // Closure arg into an `Impl(Fn(...))`-SomeT FIELD: register the capture
    // struct as the FIELD SomeT id's resolved concrete. TS needs no code here
    // — the arg's expected type IS the field type object, so the lambda's
    // `resolvedConcreteType` stamp (anonymous-function.ts:1183-1252) mutates
    // the one shared object read by both the struct typedef and the member
    // call. yo-self's lambda take-on stamps only the VALUE COPY's resolved
    // cell (anonymous_function.yo — the global stamp there regressed
    // fs/file+fs/temp via io.async's unresolved-`T` closures); the struct
    // type's own field SomeT instance has no cell, so the field emitted
    // `void*` while the initializer emitted the capture struct
    // ("initializing 'void *' with __yo_tN" — tests/impl_fn_field_rejection
    // workaround B; issues/retired/yo-self-69-red-list-map.md 2026-07-30 scoping).
    // Gate: field SomeT wraps a CONCRETE-result Fn trait (the same gate as
    // the lambda take-on) AND the arg carries a capture type.
    match(
      member_element.ty,
      .SomeT({ id : fld_sid, required_trait_types : fld_rtt }) => {
        (fld_has_concrete_fn : bool) = false;
        (fri : usize) = usize(0);
        while(fri < fld_rtt.len(), {
          match(
            fld_rtt.get(fri),
            .Some(f_rt) => if(is_fn_trait_type(f_rt), {
              match(
                f_rt,
                .FnTraitT({ call_result : fcr }) => if(!(is_some_type(fcr)), {
                  fld_has_concrete_fn = true;
                }),
                _ => ()
              );
            }),
            .None => ()
          );
          fri = (fri + usize(1));
        });
        if(fld_has_concrete_fn, {
          match(
            arg_info.capture_type,
            .Some(fld_cap_t) => register_some_resolved_concrete(fld_sid.clone(), fld_cap_t),
            .None => ()
          );
        });
      },
      _ => ()
    );
    set_expr_as_needs_to_call_dup(evaluated_arg, ctx, exn);
    env.frames = arg_info.env.frames;
    env.module_path = arg_info.env.module_path;
    env.function_declaration_frame_level = arg_info.env.function_declaration_frame_level;
    env.input_string = arg_info.env.input_string;
    // Convert comptime type → runtime type unless the field type is comptime-only.
    arg_type := if(
      _is_comptime_only_type_approx(member_element.ty),
      arg_info.ty,
      convert_comptime_type_to_runtime_type(arg_info.ty, env)
    );
    // Type compatibility check.
    if(!(are_types_compatible(arg_type, member_element.ty)), {
      if(in_def_time_trial() && tycall_dbg_env.get(`YO_DEBUG_CTFE`).is_some(), {
        eprintln(
          `[tycall-mismatch] label=${member_element.label} expected=${type_to_string(member_element.ty)} got=${type_to_string(arg_type)} argval=${match(arg_info.value, .Some(av) => value_to_string(av), .None => String.from("<none>"))}`
        );
      });
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(actual_arg_expr),
            `Type mismatch for type member "${member_element.label}":\nExpected: ${type_to_string(member_element.ty)}\nGot:   ${type_to_string(arg_type)}`,
            false,
            .None
          )
        )
      );
    });
    // Store the result.
    values(member_element_position_index) = arg_info.value;
    runtime_arg_exprs_in_order(member_element_position_index) = evaluated_arg;
    checked_indices.insert(member_element_position_index, true);
    i = (i + usize(1));
  });
  // Check that all unchecked fields have defaults.
  if(!(is_union_type), {
    (ci : usize) = usize(0);
    while(ci < n_fields, {
      already_checked := match(checked_indices.get(ci), .Some(_) => true, .None => false);
      if(!(already_checked), {
        field_opt2 := type_fields.get(ci);
        match(
          field_opt2,
          .Some(field) => {
            has_default := field.default_value.is_some();
            has_assigned := field.assigned_value.is_some();
            if(!(has_default || has_assigned), {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(function_callee_expr),
                    `Type member "${field.label}" is not provided and has no default value or assigned value.`,
                    false,
                    .None
                  )
                )
              );
            }, {
              // Use default or assigned value.
              default_val := cond(
                has_default => field.default_value,
                has_assigned => field.assigned_value,
                true => Option(EvalValue).None
              );
              values(ci) = default_val;
              // Put the field's OWN default/assigned EXPRESSION in the runtime
              // slot, exactly as TS does
              // (`runtimeArgExprsInOrder[i] = memberElement.exprs.defaultValueExpr
              // ?? memberElement.exprs.assignedValueExpr`, calls/type.ts:206).
              // The slot used to keep the callee expr as a placeholder, which
              // codegen then emitted as the struct's own C TYPE NAME —
              // `Point()` became `(Point){ .x = __yo_t0, .y = __yo_t0 }` and
              // `Point(13)` became `{ .x = 13, .y = __yo_t0 }`.
              match(
                field.default_value_expr,
                .Some(dve) => {
                  runtime_arg_exprs_in_order(ci) = dve;
                },
                .None => match(
                  field.assigned_value_expr,
                  .Some(ave) => {
                    runtime_arg_exprs_in_order(ci) = ave;
                  },
                  .None => ()
                )
              );
            });
          },
          .None => ()
        );
      });
      ci = (ci + usize(1));
    });
  });
  TypeCallResult(
    values : values,
    path_collection : path_collection_new(),
    runtime_arg_exprs_in_order : runtime_arg_exprs_in_order,
    caller_env : env
  )
});
export(try_to_call_type_with_arguments);
