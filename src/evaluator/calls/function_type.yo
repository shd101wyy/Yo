//! evaluator/calls/function_type — function-type call handlers.
//!
//! Phase 2bm — partial implementation.
//! 1:1 port of `src/evaluator/calls/function-type.ts`.
//!
//! Exports:
//!   `check_deferred_generic_return_type`      — trial-evaluates a generic function body
//!                                               to catch return-type mismatches at definition time.
//!   `try_to_implement_function_by_function_type` — registers a function body against a function type,
//!                                               creating a `FuncVal`.
//!
//! Phase 2bm / Phase 3c status:
//!   - `try_to_implement_function_by_function_type`: IMPLEMENTED (simplified).
//!     Creates a `FuncVal` from the function type + body. Body evaluation at
//!     definition time is deferred (only done at call time). This means early
//!     return-type mismatches are not caught at definition time.
//!   - `check_deferred_generic_return_type`: no-op stub (deferred to Phase 3).
//!
//! `create_function_body_evaluation_context` used to live here; it moved to
//! `evaluator/context.yo` (where `EvalContext` and `FuncOrAsyncBlockCtx` are
//! defined) so `values/impl.yo` can build a function-body context for a trait
//! `?=` default without the import cycle
//! impl.yo → function_type.yo → trait_checking.yo → impl.yo.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
_(env : fnty_env) :: import("std/env");
{ ArrayList } :: import("std/collections/array_list");
_(env : cap_dbg_env_fnty_flow) :: import("std/env");
_(env : cap_dbg_env_fnty_rp) :: import("std/env");
{ HashMap } :: import("std/collections/hash_map");
{ HashSet } :: import("std/collections/hash_set");
{ AstExpr, ast_expr_token, ast_expr_id, make_err_expr } :: import("../../expr.yo");
{ copy_func_param_defaults, copy_func_param_default_exprs, copy_func_param_type_exprs, copy_func_param_comptime, copy_func_param_assigned_values, get_func_param_comptime, copy_func_return_type_expr, copy_macro_registration, get_func_variadic_param, copy_func_variadic_param, copy_func_where_constraints, get_func_where_constraints, WhereConstraintEntry, get_func_requires_exprs, get_func_ensures_exprs, copy_func_contract_exprs } :: import("../types/function.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  register_some_resolved_concrete,
  lookup_some_resolved_concrete,
  has_control_flow,
  push_active_where_trait_ids,
  pop_active_where_trait_ids
} :: import("../../expr_info.yo");
{
  Environment,
  Variable,
  Frame,
  add_variable_to_env,
  add_parameter_to_env,
  synthetic_token,
  generate_variable_id,
  mint_funcval_env_key,
  register_funcval_cap_vars
} :: import("../../env.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, t_some_t, t_ptr, resolve_some_binder_kind } :: import("../../types/creators.yo");
{ is_type_0, is_some_type, is_unit_type, is_function_type } :: import("../../types/guards.yo");
{ wrap_function_body_with_contracts } :: import("../builtins/contracts.yo");
{ EvalValue, FuncValData, create_unknown_val, create_type_value, is_unknown_val } :: import("../../value.yo");
{ type_contains_some_type_for_codegen_param } :: import("../trait_checking.yo");
{
  is_flowable_expr,
  flow_options_default,
  FlowOptions,
  clear_flow_violation,
  flow_violation_pending,
  flow_violation_message,
  flag_flow_violation,
  propagate_def_time_errors
} :: import("../../types/flowability.yo");
{ type_to_string } :: import("../../types/string.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ evaluate_begin_expression } :: import("../exprs/begin.yo");
{ ast_expr_to_string } :: import("../../expr.yo");
{
  EvalContext,
  set_rerun_pending_def_evals_fn,
  set_in_def_time_trial,
  create_function_body_evaluation_context
} :: import("../context.yo");
{ random_id } :: import("../../utils.yo");
{ register_func_type } :: import("../../function_value.yo");
{ get_all_some_types, type_representation_contains_raw_ptr } :: import("../../types/utils.yo");
{ are_types_compatible_exact } :: import("../../types/compatibility.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ analyze_ctfe_capability } :: import("../ctfe/ctfe_analysis.yo");
{ panic, assert } :: import("std/assert");
/// Check if a generic function body returns a type incompatible with the
/// declared generic return type.
///
/// Phase 2bm: no-op stub. Full trial-evaluation deferred to Phase 3.
///
/// Mirrors `checkDeferredGenericReturnType` in `src/evaluator/calls/function-type.ts`.
check_deferred_generic_return_type :: (
  fn(
    function_body_expr : AstExpr,
    function_type : TypeValue,
    function_value : EvalValue,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> unit
)({
  function_body_expr;
  function_type;
  function_value;
  env;
  ctx;
  ()
});
/// Trial-evaluate a function body at definition time, swallowing any eval
// --- deferred def-eval re-run (fn arm 14: mutual comptime recursion) -------
/// One fn whose def-time body eval ran while a forward-declared comptime fn
/// variable was still valueless. `body` is an id-preserving clone of the
/// FuncVal body, so a re-run refreshes the ORIGINAL nodes' ExprInfos (the
/// ones codegen reads). Bounded by `attempts`.
PendingDefEval :: ref(
  struct(
    body : AstExpr,
    param_labels : ArrayList(String),
    param_types : ArrayList(TypeValue),
    param_is_ref : ArrayList(bool),
    param_is_owning : ArrayList(bool),
    param_is_comptime : ArrayList(bool),
    result_ty : TypeValue,
    where_entries : ArrayList(WhereConstraintEntry),
    function_type : TypeValue,
    strip_outer : bool,
    attempts : usize
  )
);
(g_pending_def_evals : ArrayList(PendingDefEval)) = ArrayList(PendingDefEval).new();
(g_rerunning_def_evals : bool) = false;
/// error (mirrors the def-time `evaluateBeginExpression` in
/// `function-type.ts:499`, made non-fatal). On success the evaluated body is
/// pushed to `out`; on error the swallowing `Exception` unwinds THIS helper
/// (returning unit, `out` stays empty). IMPORTANT: the swallow handler unwinds
/// `()` (unit) — NOT a large value — because `unwind(v)` memcpys `v` into the
/// fixed 64-byte `__yo_unwind_value` buffer (codegen), so unwinding a large
/// enum like `Option(AstExpr)` would overflow it. The evaluated body therefore
/// rides out via the `out` param, not the unwind value.
// ---------------------------------------------------------------------------
// Trial-swallow cell — the FATAL-endgame channel (TS parity).
//
// TS's definition-time body evaluation has TWO dispositions
// (src/evaluator/calls/function-type.ts):
//   - the DEFERRED-GENERIC trial (checkDeferredGenericReturnType) wraps its
//     evaluateBeginExpression in `catch { return; }` (ts:112) — errors are
//     DISCARDED. yo-self's dg site mirrors that: swallowing there is faithful.
//   - the CONCRETE path (ts:499) has NO catch — a body-eval error is FATAL.
//
// `_trial_eval_fn_body`'s handler is a capture-free `->` (it cannot close over
// the propagating `exn`), so the CONCRETE call site re-raises through this
// cell instead: the handler flags the formatted message, the flow site checks
// it after the trial returns (same pattern as flowability.yo's
// flag_flow_violation). The dg and pending-re-run sites clear it and move on.
(g_trial_swallow_msg : ArrayList(String)) = ArrayList(String).new();
_flag_trial_swallow :: (fn(msg : String) -> unit)({
  g_trial_swallow_msg.clear();
  g_trial_swallow_msg.push(msg);
});
_clear_trial_swallow :: (fn() -> unit)({
  g_trial_swallow_msg.clear();
});
_trial_swallow_pending :: (fn() -> bool)(g_trial_swallow_msg.len() > usize(0));
_trial_swallow_message :: (fn() -> String)(
  match(g_trial_swallow_msg.get(usize(0)), .Some(m) => m.clone(), .None => String.from(""))
);
_trial_eval_fn_body :: (
  fn(body : AstExpr, env : Environment, ctx : EvalContext, out : ArrayList(AstExpr)) -> unit
)({
  // Reset the flow-violation flag so a stale flag from an earlier (propagated,
  // non-def-time) throw can't be mistaken for a violation in THIS body.
  clear_flow_violation();
  _clear_trial_swallow();
  // The swallow handler is a capture-free `->` effect handler (it cannot close
  // over a propagating `exn`), so it always swallows. A deliberate
  // flow-soundness rejection sets `flow_violation_pending()` BEFORE throwing;
  // the def-time caller re-raises it via the real `exn` after this returns.
  // YO_DEBUG_SWALLOW=1 prints every def-time-trial swallowed error to stderr
  // — the fastest way to see WHY a test arm hollows (measure-rule 4's
  // module-level extraction without the extraction). The handler is a
  // capture-free `->`, so the gate reads the process env directly.
  // Under YO_DEBUG_SWALLOW, announce WHOSE body is about to be trialled before
  // running it. The handler below is a capture-free `->` and therefore cannot
  // capture `body`, so the owner cannot be printed from inside it — and many
  // swallowed errors carry a token pointing at line 1, which makes the
  // `[swallow]` line alone unattributable. Any `[swallow]` in the log belongs to
  // the most recent `[trial]` above it.
  if(fnty_env.get(`YO_DEBUG_SWALLOW`).is_some(), {
    dbg_tok := ast_expr_token(body);
    eprintln(`[trial] ${dbg_tok.module_path}:${dbg_tok.row.to_string()}:${dbg_tok.column.to_string()}`);
  });
  inner_exn := Exception(
    throw : (
      (_err) -> {
        if(fnty_env.get(`YO_DEBUG_SWALLOW`).is_some(), {
          eprintln(`[swallow] ${_err.to_string()}`);
        });
        _flag_trial_swallow(_err.to_string());
        unwind(());
      }
    )
  );
  // Route the body through evaluate_begin_expression DIRECTLY — the faithful
  // port of function-type.ts:499, which calls `evaluateBeginExpression({expr:
  // effectiveBodyExpr, ..., isEvaluatingFunctionBodyBeginBlock: true})` for
  // EVERY body shape (begin.ts:1122-1151 then wraps a non-begin body into
  // `begin(expr)` in place, so the begin machinery — begin frame, arg-temp
  // registration, scope-end drop scheduling — always runs). yo-self's
  // shared-id equivalent writes the begin out_info (deferred_drop_expressions
  // included) to the SAME node id (begin.yo's single-expression carry-across),
  // which codegen's post-call drop flush then emits. The previous
  // `evaluate_expression_raw(wrap_body_in_begin(body))` only begin-wrapped
  // bare-ATOM/field-access bodies, so a bare tail-expression CALL body never
  // ran the begin scope-end pass — every owned RC argument temp it
  // materialised leaked (rc == 2 instead of 1) and the effect-escape path had
  // no drops at all. Matches the closure path (closure_type.yo:255), which
  // already calls evaluate_begin_expression directly. See
  // issues/fixed/yo-self-tail-expression-arg-temp-drop-missing.md.
  evaluated := evaluate_begin_expression(body, env, ctx, ArrayList(Variable).new(), true, inner_exn);
  out.push(evaluated);
});
/// The env value for a TYPE-kinded binder — a `comptime(T) : Type` parameter or
/// a `generic(T : Type)` forall: `TypeVal(SomeT(name))`, preferring the SomeT the
/// SIGNATURE already mentions for that name (so body and signature share ONE
/// identity — minting a fresh one gave `ZPair(K, V)` a different CTFE cache key
/// than the signature's `*(ZPair(K, V))`), and stamping the fn's where-clause
/// constraints onto a freshly minted one.
///
/// Deliberately NOT `create_unknown_val(Type)`: an unknown VALUE of type `Type`
/// is not usable AS a type, so a type-constructor body (`struct(_0 : A, _1 : B)`)
/// throws "expected type for element, got A" (field.yo:293). TS can use
/// `createUnknownValue(declaredType)` (helper.ts:1038-1067) because its type
/// objects are mutable and resolve in place; yo-self's TypeValues are value-typed
/// snapshots, so the placeholder itself has to BE a type.
///
/// Shared by the parameter loop and the forall loop in
/// `_build_def_time_body_env` — they must agree, or a `generic(T)` binder and a
/// `comptime(T)` param of the same name would bind different identities.
_type_binder_env_value :: (
  fn(
    name : String,
    sig_some_ts : ArrayList(TypeValue),
    where_entries : ArrayList(WhereConstraintEntry),
    level : usize
  ) -> Option(EvalValue)
)({
  // Prefer the signature's own SomeT for this name; mint only when the
  // signature never mentions it.
  (sig_match : Option(TypeValue)) = Option(TypeValue).None;
  (smi : usize) = usize(0);
  while((smi < sig_some_ts.len()) && sig_match.is_none(), {
    match(
      sig_some_ts.get(smi),
      .Some(st) => match(
        st,
        .SomeT(_, st_name, _, _, _, _, _, _, _, _, _) => if(st_name == name, {
          sig_match = Option(TypeValue).Some(st);
        }),
        _ => ()
      ),
      .None => ()
    );
    smi = (smi + usize(1));
  });
  match(
    sig_match,
    .Some(st) => Option(EvalValue).Some(create_type_value(st)),
    .None => {
      fresh_some := t_some_t(name.clone(), level);
      // Stamp the fn's where-clause constraints for this label onto the fresh
      // SomeT (see the where_entries doc comment on _build_def_time_body_env).
      (we_i : usize) = usize(0);
      while(we_i < where_entries.len(), {
        we := match(
          where_entries.get(we_i),
          .Some(e) => e,
          .None => {
            we_i = (we_i + usize(1));
            continue;
          }
        );
        if(we.lhs_label == name, {
          match(
            fresh_some,
            .SomeT(_, _, _, _, fs_req, fs_req_lv, fs_neg, fs_neg_lv, _, _, _) => {
              if(we.is_negated, {
                fs_neg.push(we.trait_ty);
                fs_neg_lv.push(usize(0));
              }, {
                fs_req.push(we.trait_ty);
                fs_req_lv.push(usize(0));
              });
            },
            _ => ()
          );
        });
        we_i = (we_i + usize(1));
      });
      Option(EvalValue).Some(create_type_value(fresh_some))
    }
  )
});
/// Build a fresh definition-time evaluation env for a function body: captures
/// (re-derived from `caller_env` so other top-level names resolve) + a frame
/// with the parameters bound (with `is_ref`/`is_parameter` set so the
/// flow-soundness check recognises them). Mirrors how TS `evaluateFunctionType`
/// binds params into the env threaded to the body eval (function.ts:711-713).
/// Build a def-time body env SHARING the caller's `Variable` handles but NOT
/// its mutable `Frame` objects (plans/backlog/YO_SELF_ENV_SHARING.md §3 +
/// issues/env-sharing-live-frame-membership-leak.md). Every frame — frame 0
/// included — is rebuilt as a new `Frame` whose `variables` list holds the
/// SAME `Variable` handles; with `strip` set, frames 1..n keep only
/// `is_compile_time_only || is_module_level` bindings (the module-level keep
/// is a yo-self divergence carried over from the retired flattening copy:
/// unlike TS, module runtime globals can live outside frame 0 here).
/// `is_implicit` bindings are NOT dropped — the flattening copy never dropped
/// them either, and changing that here would be a second behavior change
/// hiding inside a memory fix.
///
/// WHY membership must be frozen per-frame instead of pushing the live Frame
/// handles (`snapshot_env`): TS's `addVariableToEnv` (env.ts:660-688) is
/// PERSISTENT — it builds a new frame + new frames list, so an env captured
/// at definition time keeps point-in-time frame membership forever, which is
/// what lets TS hand the caller env to a def-time body eval by reference
/// (function-type.ts:296-304). yo-self frames append IN PLACE, so pushing the
/// live handles lets bindings added AFTER the definition leak into the def
/// env and every `ExprInfo.env` recorded from the body eval. Measured cost of
/// the leak: std/fs/file.yo binds a METHOD named `fd` (line ~218) after the
/// sibling methods whose bodies bind a local `fd :=` (read/open_with); at
/// codegen time `generate_initialization_assignment`'s
/// `_last_is_compile_time_only(lhs_ei.env, "fd")` found the late-bound
/// comptime method binding (the LHS atom's recorded env predates the local's
/// own binding, so the method was the ONLY match) and silently skipped the
/// statement — emitted C referenced an undeclared `fd`.
_share_def_time_frames :: (fn(env : Environment, strip : bool) -> Environment)({
  new_frames := ArrayList(Frame).new();
  n := env.frames.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      env.frames.get(i),
      .Some(frame) => {
        new_vars := ArrayList(Variable).new();
        m := frame.variables.len();
        (j : usize) = usize(0);
        while(j < m, {
          match(
            frame.variables.get(j),
            .Some(v) => {
              keep := cond(
                !(strip) => true,
                (i == usize(0)) => true,
                v.is_compile_time_only => true,
                v.is_module_level => true,
                true => false
              );
              if(keep, {
                new_vars.push(v);
              });
            },
            .None => ()
          );
          j = (j + usize(1));
        });
        new_frames.push(
          Frame(
            id : frame.id,
            variables : new_vars,
            is_begin_block : frame.is_begin_block,
            where_clause_constraints : frame.where_clause_constraints,
            // Fresh key: this rebuilt frame gets its OWN lazy index
            // entry (see Frame.index_key doc in env.yo).
            index_key : generate_variable_id(String.from(""), String.from("fidx"))
          )
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  Environment(
    frames : new_frames,
    module_path : env.module_path,
    function_declaration_frame_level : env.function_declaration_frame_level,
    input_string : env.input_string
  )
});
_build_def_time_body_env :: (
  fn(
    caller_env : Environment,
    param_labels : ArrayList(String),
    param_types : ArrayList(TypeValue),
    param_is_ref : ArrayList(bool),
    /// Per-parameter `own(...)` flags (FuncMeta.param_is_owning) — an own
    /// param's def-time binding must be created OWNING so the function-body
    /// begin block's parameters-frame drop pass releases it at scope end.
    param_is_owning : ArrayList(bool),
    /// Per-parameter `comptime(...)` flags (the fn-type side table). TS binds
    /// `value: isCompileTimeOnly ? [createUnknownValue(...)] : undefined`
    /// (function-type.ts:346) — a comptime VALUE param must carry an
    /// UnknownVal or every builtin the body hands it to throws its
    /// "expects a compile-time known value" error at definition time and
    /// the trial swallows the body (prelude's `Array.fill` /
    /// `ComptimeList.car`, family C of
    /// issues/fixed/def-eval-swallow-remaining-roots.md). RUNTIME params keep NO
    /// value — binding them UnknownVal breaks the dup accounting (see the
    /// pv comment below).
    param_is_comptime : ArrayList(bool),
    // The signature's evaluated result type — scanned (with param_types)
    // for the SIGNATURE's own SomeT objects so comptime type params bind
    // the SAME SomeT identity the signature mentions. Minting fresh
    // SomeTs here gave the body's `ZPair(K, V)` a different CTFE cache
    // key than the signature's `*(ZPair(K, V))` → two struct
    // instantiations → match-arm unification failure (std/imm/map.yo
    // `_alloc_pairs`). TS has no such split: the def-time body eval
    // reuses the fn-type evaluation env, so the body sees the same
    // SomeType objects (function-type.ts:499).
    result_type : TypeValue,
    // The fn's registered where-clause constraints (side table keyed by the
    // fn-type expr id — same key as the defaults). A comptime TYPE param
    // (`comptime(V) : Type, where(V <: (Send, Acyclic))`) has its SomeT only
    // in the fn-type eval env's VALUE binding — not in param_types/result —
    // so the sig_some_ts scan misses it and a fresh unconstrained SomeT is
    // minted. TS reuses the fn-type parametersFrame (function-type.ts:380)
    // whose variables hold the SAME (where-stamped) SomeType objects, so its
    // body sees the constraints; stamp the fresh mint here to match.
    // Measured on std/prelude `Arc`: without this, the body's
    // `atomic(ref(struct((*) : V)))` saw V with ZERO required traits and the
    // atomic-Send enforcement wrongly threw — and the swallowed def-time
    // throw abandoned the whole prelude begin loop ("Variable Option/Dispose
    // not found" cascade).
    where_entries : ArrayList(WhereConstraintEntry),
    /// The fn's own type — read ONLY for its generic binders
    /// (`Func.forall_types` paired with `FuncMeta.forall_labels`). A
    /// `generic(B : Type)` binder is NOT in `param_labels`, so the
    /// comptime-type-param binding in the parameter loop below never covered it
    /// and every body mention of `B` threw `Variable "B" not found` at
    /// definition time — 15 of the 33 distinct def-time swallow roots measured
    /// on a hello-world (all of prelude's Functor/Monad surface:
    /// `Result.map`/`map_err`/`and_then`, `Option.map`, ...).
    fn_type_for_foralls : TypeValue,
    // True when this fn is being DEFINED inside another function body. TS
    // then evaluates the body against
    // keepTopLevelFrameAndComptimeVariablesFromEnv(callerEnv)
    // (function-type.ts:297-304, anonymous-function.ts:637): outer RUNTIME
    // locals are invisible to a regular (non-closure) fn — `x + a` with a
    // runtime outer `a` must fail "Variable a not found", and `x = 12` on an
    // outer-declared `x` likewise. Module-level runtime globals (frame 0 /
    // is_module_level) stay visible, matching TS's keep-frame-0 rule.
    strip_outer_runtime : bool
  ) -> Environment
)({
  module_path := caller_env.module_path;
  // ENV SHARING (plans/backlog/YO_SELF_ENV_SHARING.md §3) — the body env
  // shares the caller env's VARIABLE handles, exactly as TS does
  // (function-type.ts:297-304: keepTopLevelFrameAndComptimeVariablesFromEnv
  // when nested, else the caller env itself; TS then evaluates the body
  // against those same Variable objects, function-type.ts:499). The
  // per-definition flattening COPY this replaces minted 2,760,212 Variables
  // per self-compile — 37% of the 7.43 M live-Variable census (measured
  // 2026-08-17; YO_GC_FULL_PCT=130 confirmed none of it is collectible
  // garbage). Sharing also makes the copy's three flag-carry patches
  // (is_reassignable, is_module_level, and the forced is_compile_time_only)
  // structural: the body sees each Variable's true flags. Frame MEMBERSHIP
  // is still frozen per-frame (see _share_def_time_frames' doc): pushing the
  // live mutable Frame handles let later-bound siblings leak into this def's
  // recorded envs and silently drop statements at codegen.
  fresh_env := _share_def_time_frames(caller_env, strip_outer_runtime);
  // Family B re-kind, sharing edition: an impl-level VALUE binder
  // (`impl(generic(T : Type, N : usize), ...)`) is bound `TypeVal(SomeT)` in
  // the impl's forall env — load-bearing there for receiver-pattern
  // evaluation — but a def-time BODY env must see an unknown VALUE of the
  // declared type (TS createUnknownValue(declaredType)), or `r.end > N`
  // fails "Cannot unify usize and Type". The kind comes from the NAME-only
  // side table registered at the impl binder site and resolved PURELY
  // (builtin scalars, no env) — every env-involved resolution measurably
  // broke the circular-import order (see resolve_some_binder_kind). The
  // retired copy loop re-kinded its copies in place; shared Variables must
  // not be mutated, so the re-kinds become SHADOW bindings in the parameter
  // frame instead (added after push_frame below; the later forall/parameter
  // bindings of the same name still win — same frame, last-added wins). The
  // scan walks frames outer→inner recording the LAST binding per name, so a
  // name whose innermost visible binding is not a re-kindable SomeT is never
  // shadowed — the same winner the flattened env's lookup produced.
  rk_names := ArrayList(String).new();
  rk_tys := ArrayList(Option(TypeValue)).new();
  rk_reassign := ArrayList(bool).new();
  rk_module_level := ArrayList(bool).new();
  (rk_fi : usize) = usize(0);
  while(rk_fi < fresh_env.frames.len(), {
    match(
      fresh_env.frames.get(rk_fi),
      .Some(rk_frame) => {
        (rk_vi : usize) = usize(0);
        while(rk_vi < rk_frame.variables.len(), {
          match(
            rk_frame.variables.get(rk_vi),
            .Some(rv) => {
              rv_bty := match(
                rv.value.get(usize(0)),
                .Some(rv_ev) => match(
                  rv_ev,
                  .TypeVal(rv_tv) => match(
                    rv_tv,
                    .SomeT(_, rv_sname, rv_slvl, _, _, _, _, _, _, _, _) =>
                      resolve_some_binder_kind(rv_sname, rv_slvl),
                    _ => Option(TypeValue).None
                  ),
                  _ => Option(TypeValue).None
                ),
                .None => Option(TypeValue).None
              );
              (rk_at : Option(usize)) = Option(usize).None;
              (rk_si : usize) = usize(0);
              while(rk_si < rk_names.len(), {
                if(match(rk_names.get(rk_si), .Some(n) => (n == rv.name), .None => false), {
                  rk_at = Option(usize).Some(rk_si);
                });
                rk_si = (rk_si + usize(1));
              });
              match(
                rk_at,
                // An inner (or later same-frame) binding overrides the
                // recorded one — as a fresh re-kind hit or a cancellation.
                .Some(at) => {
                  rk_tys(at) = rv_bty;
                  rk_reassign(at) = rv.is_reassignable;
                  rk_module_level(at) = rv.is_module_level;
                },
                .None => match(
                  rv_bty,
                  .Some(_) => {
                    rk_names.push(rv.name);
                    rk_tys.push(rv_bty);
                    rk_reassign.push(rv.is_reassignable);
                    rk_module_level.push(rv.is_module_level);
                  },
                  // A non-hit with no recorded entry needs no cancellation.
                  .None => ()
                )
              );
            },
            .None => ()
          );
          rk_vi = (rk_vi + usize(1));
        });
      },
      .None => ()
    );
    rk_fi = (rk_fi + usize(1));
  });
  ___fr := fresh_env.push_frame(false);
  // Insert the Family B shadows collected above. `is_reassignable` and
  // `is_module_level` are carried from the shadowed binding (std/log.yo's
  // `_global_level = level` and the flowability gate's module-root check —
  // see the retired copy loop's history in git).
  (rk_bi : usize) = usize(0);
  while(rk_bi < rk_names.len(), {
    match(
      rk_tys.get(rk_bi),
      .Some(rk_o) => match(
        rk_o,
        .Some(rk_bty) => {
          rk_n := match(rk_names.get(rk_bi), .Some(n) => n, .None => String.from(""));
          rk_r := match(rk_reassign.get(rk_bi), .Some(b) => b, .None => false);
          rk_ml := match(rk_module_level.get(rk_bi), .Some(b) => b, .None => false);
          rk_var_opt := add_variable_to_env(
            fresh_env,
            rk_n.clone(),
            rk_bty.clone(),
            Option(EvalValue).Some(create_unknown_val(rk_bty)),
            true,
            rk_r,
            false,
            false,
            synthetic_token(rk_n, module_path)
          );
          match(
            rk_var_opt,
            .Some(rk_var) => {
              rk_var.is_module_level = rk_ml;
            },
            .None => ()
          );
        },
        .None => ()
      ),
      .None => ()
    );
    rk_bi = (rk_bi + usize(1));
  });
  // Frame level of the just-pushed parameter frame (for SomeT binding below).
  pf_level := (fresh_env.frames.len() - usize(1));
  // Collect the signature's SomeTs (from param types + result type) so a
  // comptime type param can be bound to the SAME SomeT object the other
  // signature types reference (see doc comment on result_type above).
  sig_some_ts := ArrayList(TypeValue).new();
  {
    (sci : usize) = usize(0);
    while(sci < param_types.len(), {
      spt := match(param_types.get(sci), .Some(t) => t, .None => t_unit());
      found := get_all_some_types(spt);
      (sfi : usize) = usize(0);
      while(sfi < found.len(), {
        match(
          found.get(sfi),
          .Some(st) => {
            sig_some_ts.push(st);
          },
          .None => ()
        );
        sfi = (sfi + usize(1));
      });
      sci = (sci + usize(1));
    });
    found_r := get_all_some_types(result_type);
    (sri : usize) = usize(0);
    while(sri < found_r.len(), {
      match(
        found_r.get(sri),
        .Some(st) => {
          sig_some_ts.push(st);
        },
        .None => ()
      );
      sri = (sri + usize(1));
    });
  };
  // Bind the fn's GENERIC BINDERS before the parameters. `generic(B : Type)`
  // lives in `forall_labels`, a list PARALLEL to but separate from
  // `param_labels`, so the type-kinded binding in the parameter loop below never
  // reached it: at definition time the body's `Result(B, ErrorType)` threw
  // `Variable "B" not found`, the def-time trial swallowed it, and the statement
  // lost its ExprInfo — which is how a body silently became a
  // `// Failed to transpile` comment.
  //
  // Bound through the SAME `_type_binder_env_value` the parameter loop uses, so
  // a `generic(T)` binder and a `comptime(T) : Type` param of one name cannot
  // bind two different SomeT identities. Only TYPE-kinded binders are bound —
  // a VALUE binder (`generic(N : usize)`) must stay unbound so the value-generic
  // machinery still infers it from the call (binding it to a TypeVal is exactly
  // the `usize`-vs-`Type` misbind recorded in the collections residuals).
  //
  // Skipped when a parameter of the same name exists: the parameter loop is
  // authoritative for it (and runs after, so it would overwrite anyway).
  {
    fa_labels := match(fn_type_for_foralls, .Func({ meta : __fa_m }) => __fa_m.*.forall_labels, _ => ArrayList(String).new());
    fa_types := match(fn_type_for_foralls, .Func({ forall_types : __fa_t }) => __fa_t, _ => ArrayList(TypeValue).new());
    (fa_i : usize) = usize(0);
    while(fa_i < fa_labels.len(), {
      fa_name := match(fa_labels.get(fa_i), .Some(n) => n, .None => String.from(""));
      fa_ty := match(fa_types.get(fa_i), .Some(t) => t, .None => t_unit());
      is_param_too := {
        (fp_i : usize) = usize(0);
        (fp_hit : bool) = false;
        while((fp_i < param_labels.len()) && !(fp_hit), {
          if(match(param_labels.get(fp_i), .Some(l) => (l == fa_name), .None => false), {
            fp_hit = true;
          });
          fp_i = (fp_i + usize(1));
        });
        fp_hit
      };
      if((fa_name.len() > usize(0)) && !(is_param_too), {
        fa_val := if(
          is_type_0(fa_ty.clone()),
          _type_binder_env_value(fa_name.clone(), sig_some_ts, where_entries, pf_level),
          // A VALUE binder (`generic(N : usize)` on `from_array`, whose body does
          // `Self.with_capacity(N)` and `while(i < N, ...)`): bind an unknown
          // VALUE of the DECLARED type — TS's
          // `createUnknownValue(declaredType)` (helper.ts:1038-1067). Kind
          // matters: a TypeVal here is exactly the `usize`-vs-`Type` misbind
          // recorded in issues/yo-self-collections-batch-residuals.md, whereas
          // leaving it unbound throws `Variable "N" not found`.
          //
          // Safe for the dup accounting that forbids UnknownVal on RUNTIME
          // params (see the `pv` comment below): a forall binder is
          // compile-time by construction, never a runtime parameter, so no body
          // read of it can reach set_expr_as_needs_to_call_dup's value branch.
          Option(EvalValue).Some(create_unknown_val(fa_ty.clone()))
        );
        add_variable_to_env(
          fresh_env,
          fa_name.clone(),
          fa_ty,
          fa_val,
          true,
          false,
          false,
          false,
          synthetic_token(fa_name, module_path)
        );
      });
      fa_i = (fa_i + usize(1));
    });
  };
  (pi : usize) = usize(0);
  while(pi < param_labels.len(), {
    pn := match(param_labels.get(pi), .Some(n) => n, .None => String.from(""));
    pt := match(param_types.get(pi), .Some(t) => t, .None => t_unit());
    p_ref := match(param_is_ref.get(pi), .Some(b) => b, .None => false);
    p_own := match(param_is_owning.get(pi), .Some(b) => b, .None => false);
    // A comptime TYPE parameter (`comptime(T) : Type`) must be bound as a
    // `TypeVal(SomeT(name))` type value — NOT `create_unknown_val(Type)` (an
    // unknown VALUE) — so the body can use it as a type (e.g. a type-constructor
    // body `struct(_0 : A, _1 : B)`). Otherwise `A` is a non-type value and
    // field/element-type eval throws "expected type for element, got A"
    // (field.yo:293) — the dominant def-time-eval swallow category. Mirrors the
    // SomeT binding in evaluate_function_parameters (function.yo:1169).
    // Runtime params bind with NO value (TS function-type.ts:346:
    // `value: isCompileTimeOnly ? [createUnknownValue(...)] : undefined`).
    // Binding them to `Some(UnknownVal)` made every body read of a param
    // look like a comptime value, so set_expr_as_needs_to_call_dup's
    // value-branch early-returned and a borrowed-param tail (`to_string :
    // (...)(self)`) lost its balancing ___dup — println(s) then freed the
    // caller's String buffer (net −1 per call).
    p_ct := match(param_is_comptime.get(pi), .Some(b) => b, .None => false);
    pv := if(
      is_type_0(pt),
      _type_binder_env_value(pn.clone(), sig_some_ts, where_entries, pf_level),
      if(
        p_ct,
        Option(EvalValue).Some(create_unknown_val(pt)),
        Option(EvalValue).None
      )
    );
    add_parameter_to_env(
      fresh_env,
      pn,
      pt,
      pv,
      false,
      p_ref,
      p_own,
      false,
      p_ref,
      true,
      synthetic_token(pn, module_path)
    );
    pi = (pi + usize(1));
  });
  fresh_env
});

/// Re-run every pending def-time body eval (bounded by per-entry attempts).
/// Called through context.yo's hook by assignment.yo after a forward-declared
/// comptime fn variable is FILLED — the re-run rebuilds the body env from the
/// CURRENT caller env (fills visible) and refreshes the original body nodes'
/// ExprInfos via the id-preserving clone.
_rerun_pending_def_evals :: (fn(caller_env : Environment, ctx : EvalContext) -> unit)({
  if(g_rerunning_def_evals || (g_pending_def_evals.len() == usize(0)), {
    return(());
  });
  g_rerunning_def_evals = true;
  kept := ArrayList(PendingDefEval).new();
  (rp_i : usize) = usize(0);
  while(rp_i < g_pending_def_evals.len(), {
    match(
      g_pending_def_evals.get(rp_i),
      .Some(pd) => {
        rp_env := _build_def_time_body_env(
          caller_env,
          pd.param_labels,
          pd.param_types,
          pd.param_is_ref,
          pd.param_is_owning,
          pd.param_is_comptime,
          pd.result_ty,
          pd.where_entries,
          pd.function_type,
          pd.strip_outer
        );
        rp_fv := EvalValue.FuncVal(
          box(
            FuncValData(
              forall_names : ArrayList(String).new(),
              params : ArrayList(String).new(),
              param_type_names : ArrayList(String).new(),
              evidence_params : ArrayList(String).new(),
              body : make_err_expr(),
              cap_names : ArrayList(String).new(),
              cap_tys : ArrayList(TypeValue).new(),
              func_id : random_id(caller_env.module_path)
            )
          ),
          ArrayList(EvalValue).new()
        );
        if(cap_dbg_env_fnty_rp.get(`YO_DEBUG_CAPTURE`).is_some(), {
          eprintln(`[fbctx-fnty-rp]`);
        });
        rp_ctx := create_function_body_evaluation_context(pd.function_type, rp_fv, rp_env, ctx);
        rp_out := ArrayList(AstExpr).new();
        rp_prev_trial := set_in_def_time_trial(true);
        _trial_eval_fn_body(pd.body.clone(), rp_env, rp_ctx, rp_out);
        ___rp_tr := set_in_def_time_trial(rp_prev_trial);
        if(pd.attempts > usize(1), {
          pd.attempts = (pd.attempts - usize(1));
          kept.push(pd);
        });
      },
      .None => ()
    );
    rp_i = (rp_i + usize(1));
  });
  g_pending_def_evals = kept;
  g_rerunning_def_evals = false;
});
/// Install the deferred-def-eval hook (called from register_evaluate_expression
/// — module-level call statements do not execute at import).
register_rerun_pending_def_evals :: (fn() -> unit)({
  set_rerun_pending_def_evals_fn(_rerun_pending_def_evals);
});
/// Register a function body expression against a function type, producing a
/// typed `FuncVal`.
///
/// Phase 2bm: simplified implementation.
///
/// - Extracts `forall_labels`, `param_labels`, `implicit_labels`, `result` from
///   `TypeValue.Func`.
/// - Derives `param_type_names` from each param's type: if the type is `SomeT`,
///   uses its `name` (for generic binding at call time); otherwise uses `""`.
/// - Creates `EvalValue.FuncVal` with empty captures (regular functions do not
///   capture outer runtime variables in the 1:1 port).
/// - Body evaluation at definition time is skipped (deferred to call time).
///   This means early return-type mismatches are not caught.
/// - Stores `ExprInfo` in the table and returns the annotated expression.
///
/// Mirrors `tryToImplementFunctionByFunctionType` in `src/evaluator/calls/function-type.ts`.
try_to_implement_function_by_function_type :: (
  fn(
    expr : AstExpr,
    function_type : TypeValue,
    caller_env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)(
  match(
    function_type,
    .Func({ param_types, result : result_box, meta : __fm2 }) => {
      forall_labels := __fm2.*.forall_labels;
      param_labels := __fm2.*.param_labels;
      implicit_labels := __fm2.*.implicit_labels;
      param_is_ref := __fm2.*.param_is_ref;
      param_is_owning := __fm2.*.param_is_owning;
      result_is_ref := __fm2.*.result_is_ref;
      result_is_comptime_only := __fm2.*.result_is_comptime_only;
      tok := ast_expr_token(expr);
      // Extract the function body from args[0] of the outer call expression.
      args := match(
        expr,
        .FnCall(_, _, a, _, _) => a,
        .Atom(_, _) => ArrayList(AstExpr).new()
      );
      if(args.len() != usize(1), {
        exn.throw(
          dyn(
            format_error_message(
              tok,
              `Expected 1 argument for function body, got ${args.len()}`,
              false,
              .None
            )
          )
        );
      });
      body_expr_raw := match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
      // Phase 0 task #6 of plans/FORMAL_VERIFICATION.md: splice
      // `assert(P, msg)` / `comptime_assert(P, msg)` calls into the body for
      // each `requires(...)` / `ensures(...)` predicate declared in the
      // signature. Must happen BEFORE the body is moved into the FuncVal (and
      // before the def-time-eval clone below) so every downstream consumer —
      // def-time eval, specialization, codegen — sees the wrapped body.
      // The predicates ride the fn-type-expr-id side-table registered by
      // `evaluate_function_type`; the callee slot of `(fn(...))(body)` IS that
      // expr, the same key the `copy_*` re-keying below uses.
      // Mirrors the wrap call at src/evaluator/calls/function-type.ts:402.
      contract_key := match(
        expr,
        .FnCall(_, ck_ft_box, _, _, _) => ast_expr_id(ck_ft_box).to_string(),
        .Atom(_, _) => String.from("")
      );
      body_expr := wrap_function_body_with_contracts(
        body_expr_raw,
        get_func_requires_exprs(contract_key.clone()),
        get_func_ensures_exprs(contract_key.clone()),
        result_is_comptime_only,
        is_unit_type(result_box)
      );
      // Build param_type_names: for each param type, use the SomeT name (for generic
      // binding at call time) if the param type is a generic type variable, else "".
      param_type_names := ArrayList(String).new();
      (pti : usize) = usize(0);
      n_pt := param_types.len();
      while(pti < n_pt, {
        pt_name := match(
          param_types.get(pti),
          .Some(pt) => match(
            pt,
            .SomeT(_, name, _, _, _, _, _, _, _, _, _) => name,
            _ => String.from("")
          ),
          .None => String.from("")
        );
        param_type_names.push(pt_name);
        pti = (pti + usize(1));
      });
      // Build cap_names/cap_tys/cap_vals from `caller_env` so the FuncVal's body
      // can resolve other top-level identifiers (other functions, types,
      // constants) at call time. The body is evaluated in a `fresh_env`
      // that only contains captures + params; without these, references
      // like `inner` inside `outer :: (fn(…))(inner(T))` fall through to
      // the "Variable not found" soft fallback and the call result becomes
      // `UnknownVal`. Mirrors the capture loop in
      // `evaluator/values/anonymous_function.yo`.
      cap_names := ArrayList(String).new();
      cap_tys := ArrayList(TypeValue).new();
      cap_vals := ArrayList(EvalValue).new();
      // Campaign 2: parallel snapshot of the ORIGINAL Variable handles (see
      // the twin comment in evaluator/values/anonymous_function.yo).
      cap_vars := ArrayList(Variable).new();
      (has_fwd_comptime_fn_cap : bool) = false;
      n_cap_fr := caller_env.frames.len();
      (cap_fi : usize) = usize(0);
      while(cap_fi < n_cap_fr, {
        match(
          caller_env.frames.get(cap_fi),
          .Some(cap_frame) => {
            n_cap_v := cap_frame.variables.len();
            (cap_vi : usize) = usize(0);
            while(cap_vi < n_cap_v, {
              match(
                cap_frame.variables.get(cap_vi),
                .Some(cv) => {
                  if(!(cv.name == "__recur_fn"), {
                    cap_names.push(cv.name);
                    cap_tys.push(cv.ty);
                    cap_val := match(
                      cv.value.get(usize(0)),
                      .Some(actual) => actual,
                      .None => EvalValue.VarRef(cv.name)
                    );
                    // A VALUELESS comptime fn-typed capture is a FORWARD
                    // DECLARATION (`comptime(is_odd) : (fn ...)` before its
                    // fill) — this fn's def-time body eval will record its
                    // call sites without a FuncVal. Flag it so the def-eval
                    // below registers a pending RE-RUN (executed by
                    // assignment.yo once the declaration is filled).
                    cv_unfilled := match(
                      cv.value.get(usize(0)),
                      .Some(cv_v) => is_unknown_val(cv_v),
                      .None => true
                    );
                    // Compiler-internal synthetic binders (`__yo_return_self`
                    // et al.) are PERMANENTLY valueless fn-typed comptime
                    // vars — they are not user forward declarations, and
                    // counting them made this flag TRUE for every fn in
                    // scope (which both registered a useless bounded re-run
                    // for every definition and suppressed the fatal
                    // re-raise below unconditionally).
                    // `c_include`d extern fns (`exit`, `memcpy`, …) are the
                    // same shape — permanently valueless fn-typed comptime
                    // vars, identifiable by the FFI marker on their Func
                    // meta. Counting them made ONE `{ exit } ::
                    // import("std/libc/stdlib")` suppress the fatal re-raise
                    // for EVERY definition in the importing module: `check`
                    // then returned 0 on bodies with undefined variables —
                    // the GATE-4 hole
                    // (issues/fixed/yo-self-check-misses-undefined-variable.md).
                    cv_is_extern_fn := match(
                      cv.ty,
                      .Func({ meta : __fcxm }) => __fcxm.*.is_extern.is_some(),
                      _ => false
                    );
                    if((((cv.is_compile_time_only && cv_unfilled) && is_function_type(cv.ty)) && !(cv.name.starts_with("__yo_"))) && !(cv_is_extern_fn), {
                      if((!(has_fwd_comptime_fn_cap)) && fnty_env.get(`YO_DEBUG_SWALLOW`).is_some(), {
                        eprintln(`[fwd-cap] name=${cv.name} frame=${cap_fi.to_string()}`);
                      });
                      has_fwd_comptime_fn_cap = true;
                    });
                    cap_vals.push(cap_val);
                    cap_vars.push(cv);
                  });
                },
                .None => ()
              );
              cap_vi = (cap_vi + usize(1));
            });
          },
          .None => ()
        );
        cap_fi = (cap_fi + usize(1));
      });
      ft_env_key := mint_funcval_env_key();
      register_funcval_cap_vars(ft_env_key, cap_vars);
      fn_val_id := random_id(caller_env.module_path);
      // Faithful port of `shouldDeferBodyEvaluation` (function-type.ts:445-451):
      // defer body evaluation ONLY for functions that depend on generic type
      // variables — `generic` parameters, any parameter whose type contains a
      // some-type in codegen-relevant position, or a generic `Self`. Every other
      // (concrete) function has its body evaluated UNCONDITIONALLY at definition
      // time, exactly as TS does at function-type.ts:499. This is the def-time
      // body eval; the flowability *check* (is_flowable_expr) below applies to
      // returns whose representation carries a raw pointer.
      //
      // We still need a copy of the body for the trial eval because the evaluator
      // consumes its `expr` argument and the original `body_expr` must be moved
      // into the FuncVal. The original is boxed into the FuncVal (retained once);
      // the clone is transient (consumed by the eval, freed at scope end) — so
      // peak retention is 1x, matching TS's shared-reference model.
      (any_some_param_ft : bool) = false;
      (spi : usize) = usize(0);
      while((spi < param_types.len()) && (!(any_some_param_ft)), {
        match(
          param_types.get(spi),
          .Some(pt) => if(type_contains_some_type_for_codegen_param(pt, ArrayList(String).new()), {
            any_some_param_ft = true;
          }),
          .None => ()
        );
        spi = (spi + usize(1));
      });
      // DEEP some-type check on Self (mirrors TS `typeContainsSomeType`, which
      // recurses into struct/enum/tuple/ptr/slice args). yo-self's plain
      // `type_contains_some_type` is SHALLOW (top-level SomeT/TypeAppT only), so
      // a generic-impl method's `Self = ArrayList(T)` (a Struct CONTAINING a
      // SomeT) was NOT detected → the method was wrongly NOT deferred → its body
      // was def-time-evaluated with `T` unbound → "expected type for element,
      // got T" (field.yo:293). Use the deep predicate so such methods defer.
      self_has_some_ft := match(ctx.self_type, .Some(st) => type_contains_some_type_for_codegen_param(st, ArrayList(String).new()), .None => false);
      // COMPTIME VALUE-position params (`fn(comptime(n) : usize) -> Array(i32, n)`)
      // make the fn GENERIC (TS isFunctionTypeGeneric counts
      // p.isCompileTimeOnly, guards.ts:466) — its body must DEFER like a
      // forall/SomeT one: def-time eval with `n` unresolved threw "Return
      // type mismatch. Expected Array(i32, n), got unit" and emptied the
      // array batch main (the single-batch shape).
      //
      // TYPE-position comptime params (`comptime(Idx) : Type`, a TypeUni) do
      // NOT defer: TS's shouldDeferBodyEvaluation (function-type.ts:445-451)
      // has NO comptime-param clause at all — it trial-evaluates such bodies
      // at definition, which is what lets `comptime_expect_error` observe a
      // deliberate rejection inside them (the arm-26 batch residue:
      // `MyBad :: (fn(comptime(Idx) : Type, ...) -> comptime(Trait))(trait(...))`
      // under a runtime cond arm never evaluated its trait body, the cee saw
      // no error, threw its own, and the swallow FTT'd the whole dispatch —
      // issues/repros/cee-in-runtime-cond-arm.yo). The value-position defer is
      // kept as a recorded DEVIATION from TS (the unresolved-`n` return
      // mismatch throws in yo-self where TS tolerates it).
      (ft_has_ct_param : bool) = false;
      match(
        expr,
        .FnCall(_, ct_ft_box, _, _, _) => {
          ct_flags_ft := get_func_param_comptime(ast_expr_id(ct_ft_box).to_string());
          (ct_fi : usize) = usize(0);
          while((ct_fi < ct_flags_ft.len()) && !(ft_has_ct_param), {
            ct_is_typeuni := match(
              param_types.get(ct_fi),
              .Some(ct_pt) => match(ct_pt, .TypeUni(_) => true, _ => false),
              .None => false
            );
            match(
              ct_flags_ft.get(ct_fi),
              .Some(cf) => if(cf && !(ct_is_typeuni), {
                ft_has_ct_param = true;
              }),
              .None => ()
            );
            ct_fi = (ct_fi + usize(1));
          });
        },
        .Atom(_, _) => ()
      );
      should_defer_ft := ((((forall_labels.len() > usize(0)) || any_some_param_ft) || self_has_some_ft) || ft_has_ct_param);
      (flow_body : Option(AstExpr)) = if(
        !(should_defer_ft),
        Option(AstExpr).Some(body_expr.clone()),
        Option(AstExpr).None
      );
      func_val := EvalValue.FuncVal(
        box(
          FuncValData(
            forall_names : forall_labels.clone(),
            params : param_labels.clone(),
            param_type_names : param_type_names,
            evidence_params : implicit_labels,
            body : body_expr,
            cap_names : cap_names,
            cap_tys : cap_tys,
            func_id : fn_val_id.clone(),
            env_key : ft_env_key
          )
        ),
        cap_vals
      );
      // Record this function's own resolved Func type by its FuncVal id so
      // codegen can emit its C prototype (Gap 10). This path (a `fn(...)` type
      // applied to a body, e.g. `f :: (fn(x:i32)->i32)(x+x)`) uses a bare
      // random_id func_id and previously skipped registration — leaving
      // get_func_type → t_unit → a wrong `void f(void)` prototype.
      register_func_type(fn_val_id.clone(), function_type.clone());
      // Re-key the per-parameter optional-flags side-table (registered by
      // `evaluate_function_type` under the `fn(...)` type-expression id)
      // under this FuncVal's id, which is what the call site sees. The
      // callee here is `expr`'s func slot — the same `fn(...)` expr that
      // was evaluated to produce `function_type`, so their ids match.
      match(
        expr,
        .FnCall(_, fn_type_box, _, _, _) => {
          copy_func_param_defaults(ast_expr_id(fn_type_box).to_string(), fn_val_id.clone());
          copy_func_param_default_exprs(ast_expr_id(fn_type_box).to_string(), fn_val_id.clone());
          copy_func_param_type_exprs(ast_expr_id(fn_type_box).to_string(), fn_val_id.clone());
          copy_func_param_comptime(ast_expr_id(fn_type_box).to_string(), fn_val_id.clone());
          copy_func_param_assigned_values(ast_expr_id(fn_type_box).to_string(), fn_val_id.clone());
          copy_func_return_type_expr(ast_expr_id(fn_type_box).to_string(), fn_val_id.clone());
          copy_func_variadic_param(ast_expr_id(fn_type_box).to_string(), fn_val_id.clone());
          copy_macro_registration(ast_expr_id(fn_type_box).to_string(), fn_val_id.clone());
          copy_func_where_constraints(ast_expr_id(fn_type_box).to_string(), fn_val_id.clone());
          copy_func_contract_exprs(ast_expr_id(fn_type_box).to_string(), fn_val_id.clone());
        },
        .Atom(_, _) => ()
      );
      result_box;
      // If we are in CTFE analysis mode OR actually EXECUTING a CTFE function
      // (`force_compile_time_bindings`), analyse this NESTED function for CTFE
      // capability too, and prefer the comptime version — TS
      // function-type.ts:665-679, "This allows nested functions to be called at
      // compile-time."
      //
      // Without it a nested helper stays runtime-only, so the `helper(x)` call in
      // the enclosing comptime body cannot fold, the enclosing CTFE result is not
      // a compile-time value, and the `::` binding it feeds ends up with none —
      // which codegen emits as a BARE UNDECLARED C IDENTIFIER. See
      // `issues/yo-self-ctfe-nested-fn-analysis-gap.md`.
      //
      // `analyze_ctfe_capability` swallows its own failures (TS's try/catch), which
      // is essential here: an ordinary runtime helper defined inside a
      // comptime-executing body is EXPECTED to fail this analysis and must be left
      // exactly as it is.
      (final_func_val : EvalValue) = func_val;
      (final_func_ty : TypeValue) = function_type;
      if(ctx.is_analyzing_ctfe_capability || ctx.force_compile_time_bindings, {
        match(
          analyze_ctfe_capability(func_val, function_type, caller_env, ctx),
          .Some(ctfe_ok) => {
            final_func_val = ctfe_ok.value;
            final_func_ty = ctfe_ok.ty;
          },
          .None => ()
        );
      });
      // Build and store ExprInfo for the function definition expression.
      // The type of a function definition is the function type itself.
      info := new_expr_info(caller_env, final_func_ty);
      info.value = Option(EvalValue).Some(final_func_val);
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
      // Def-time body evaluation (function-type.ts:499) for every non-deferred
      // (concrete) function. The flowability *check* on the evaluated final
      // expression runs only for returns whose representation carries a raw
      // pointer — ordinary functions are merely evaluated, not rejected.
      match(
        flow_body,
        .Some(fb) => {
          def_where_entries := match(
            expr,
            .FnCall(_, dwe_ft_box, _, _, _) =>
              get_func_where_constraints(ast_expr_id(dwe_ft_box).to_string()),
            .Atom(_, _) => ArrayList(WhereConstraintEntry).new()
          );
          def_ct_flags := match(
            expr,
            .FnCall(_, ctf_ft_box, _, _, _) =>
              get_func_param_comptime(ast_expr_id(ctf_ft_box).to_string()),
            .Atom(_, _) => ArrayList(bool).new()
          );
          flow_env := _build_def_time_body_env(
            caller_env,
            param_labels,
            param_types,
            param_is_ref,
            param_is_owning,
            def_ct_flags,
            result_box,
            def_where_entries,
            function_type,
            ctx.is_evaluating_function_body_or_async_block.is_some()
          );
          // Bind the variadic parameter (`...(quote(elems))` → `elems` as
          // an unknown ComptimeList) into the body env — its name/type
          // are not on TypeValue.Func, so they ride the side table (see
          // types/function.yo). TS body eval reuses the fn-type eval env
          // where the variadic param is already bound.
          match(
            expr,
            .FnCall(_, vp_ft_box, _, _, _) => match(
              get_func_variadic_param(ast_expr_id(vp_ft_box).to_string()),
              .Some(vp_entry) => {
                ___vp := add_variable_to_env(
                  flow_env,
                  vp_entry.label.clone(),
                  vp_entry.ty,
                  Option(EvalValue).Some(create_unknown_val(vp_entry.ty)),
                  true,
                  false,
                  false,
                  false,
                  synthetic_token(vp_entry.label, caller_env.module_path)
                );
              },
              .None => ()
            ),
            .Atom(_, _) => ()
          );
          flow_fv := EvalValue.FuncVal(
            box(
              FuncValData(
                forall_names : ArrayList(String).new(),
                params : ArrayList(String).new(),
                param_type_names : ArrayList(String).new(),
                evidence_params : ArrayList(String).new(),
                body : make_err_expr(),
                cap_names : ArrayList(String).new(),
                cap_tys : ArrayList(TypeValue).new(),
                func_id : random_id(caller_env.module_path)
              )
            ),
            ArrayList(EvalValue).new()
          );
          if(cap_dbg_env_fnty_flow.get(`YO_DEBUG_CAPTURE`).is_some(), {
            eprintln(`[fbctx-fnty-flow]`);
          });
          flow_ctx := create_function_body_evaluation_context(function_type, flow_fv, flow_env, ctx);
          flow_out := ArrayList(AstExpr).new();
          // Thread the fn's where-constraint trait ids to the overload
          // selector during the DEF-time body eval (same channel as the
          // spec-time push in helper.yo — the def-time stamps are what
          // codegen reuses, so the where filter must apply HERE too;
          // impl.test.yo use_trait_a/use_trait_b).
          flow_where_ids := ArrayList(String).new();
          {
            (fwi : usize) = usize(0);
            while(fwi < def_where_entries.len(), {
              match(
                def_where_entries.get(fwi),
                .Some(fwe) => {
                  fwe_id := match(fwe.trait_ty, .TraitT(_, _, _, _, fwe_tid, _, _, _, _, _) => fwe_tid, _ => String.from(""));
                  if(fwe_id != "", {
                    flow_where_ids.push(fwe_id);
                  });
                },
                .None => ()
              );
              fwi = (fwi + usize(1));
            });
          };
          push_active_where_trait_ids(flow_where_ids);
          // NOT flagged as a def-time trial: this is the CONCRETE-fn path
          // (flow_body is Some only when should_defer_ft is false), and for
          // a concrete fn this evaluation's stamps ARE what codegen emits —
          // main's body included — with no specialization re-eval ever
          // superseding them. The in_def_time_trial loosenings are only
          // safe where stamps are discardable: the DEFERRED-generic trial
          // (dg below) and the pending re-run. Flagging this site made the
          // batch main's own trial resolve abstractly
          // (tests/collections/btree_map.test.yo lost `for(m.iter())`'s
          // closure-arg ExprInfo under the wip synthesis loosenings).
          _trial_eval_fn_body(fb, flow_env, flow_ctx, flow_out);
          pop_active_where_trait_ids();
          if(fnty_env.get(`YO_DEBUG_SWALLOW`).is_some(), {
            eprintln(`[flow-post] out=${flow_out.len().to_string()} pending=${_trial_swallow_pending().to_string()} fwd=${has_fwd_comptime_fn_cap.to_string()}`);
          });
          // This body captured a VALUELESS forward-declared comptime fn
          // variable — its call-site infos are incomplete until that
          // declaration fills. Register a bounded re-run (assignment.yo
          // triggers it through context.yo's hook once a comptime fn var is
          // assigned). The stored body is an id-preserving clone, so the
          // re-run refreshes the ORIGINAL nodes codegen reads (fn arm 14's
          // mutual recursion).
          if(has_fwd_comptime_fn_cap, {
            g_pending_def_evals.push(
              PendingDefEval(
                body : body_expr.clone(),
                param_labels : param_labels,
                param_types : param_types,
                param_is_ref : param_is_ref,
                param_is_owning : param_is_owning,
                param_is_comptime : def_ct_flags,
                result_ty : result_box,
                where_entries : def_where_entries,
                function_type : function_type,
                strip_outer : ctx.is_evaluating_function_body_or_async_block.is_some(),
                attempts : usize(3)
              )
            );
          });
          // Re-raise a flow-soundness rejection that the trial-eval swallowed
          // (a `inout(name) := <non-flowable>` binding anywhere in the body). The
          // handler is capture-free so it could not propagate it directly; the
          // binding-site flagged it instead, and we re-throw it here via the
          // real `exn`. Unconditional (NOT under `result_is_ref`) because the
          // enclosing function may return any type — e.g. `fn() -> unit`.
          if(flow_violation_pending(), {
            viol_msg := flow_violation_message();
            clear_flow_violation();
            exn.throw(dyn(format_error_message(ast_expr_token(fb), viol_msg, false, .None)));
          });
          // FATAL (TS parity, function-type.ts:499): this is the CONCRETE-fn
          // path — TS's evaluateBeginExpression here has NO catch, so a
          // definition-time body-eval error is a compile error, not a silent
          // "Failed to transpile" hollow. Re-raise the swallowed error via the
          // real exn (the trial handler is capture-free and flagged it into
          // the cell instead). EXCEPTION: a body that captured a VALUELESS
          // forward-declared comptime fn (has_fwd_comptime_fn_cap) is an
          // EXPECTED intermediate failure — the bounded re-run above fills it
          // once the declaration is assigned (fn arm 14's mutual recursion;
          // TS never faces this, its module-level bindings hoist).
          // Gated on an EMPTY flow_out: `_trial_eval_fn_body` pushes only on
          // success, so a non-empty out means THIS body succeeded and any
          // pending flag is a NESTED trial's leftover (a dg trial inside this
          // body eval — its handler flags after the nested entry-clear; TS
          // discards those, ts:112). When the outer body itself threw, its
          // own handler flagged LAST, so the message is the outer error.
          if((_trial_swallow_pending() && (flow_out.len() == usize(0))) && !(has_fwd_comptime_fn_cap), {
            ts_fatal_msg := _trial_swallow_message();
            _clear_trial_swallow();
            exn.throw(dyn(ts_fatal_msg));
          });
          _clear_trial_swallow();
          // comptime_expect_error propagation: when "propagate all def-time
          // body-eval errors" mode is active (set only around a
          // `comptime_expect_error` argument eval), a body whose trial-eval THREW
          // — detected by an empty `flow_out`, since `_trial_eval_fn_body` pushes
          // the evaluated body only on success — must NOT be silently swallowed.
          // Re-raise via the real `exn` so the error reaches the
          // `comptime_expect_error` catch (mirrors TS, whose def-time body eval
          // propagates). The message is generic: `comptime_expect_error` discards
          // it (TS catches `error` without inspecting it, comptime-expect-error.ts:33).
          if(propagate_def_time_errors() && (flow_out.len() == usize(0)), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(fb),
                  String.from("Function body raised a compile-time error during definition-time evaluation."),
                  false,
                  .None
                )
              )
            );
          });
          // (Ref-returning functions are banned at signature evaluation —
          // see types/function.yo — so only the raw-pointer-representation
          // rooting check remains. Mirrors function-type.ts.)
          if((type_representation_contains_raw_ptr(result_box) && !(result_is_comptime_only))
          && !(is_implicitly_unsafe_capable_file(Option(String).Some(ast_expr_token(fb).module_path.clone()))), {
            seb := match(
              flow_out.get(usize(0)),
              .Some(e) => e,
              .None => fb
            );
            slice_flow_opts := FlowOptions(
              allow_same_frame_local : false,
              allow_parameter_source : true,
              allow_comptime_source : true,
              max_local_frame_level : Option(usize).None
            );
            if(!(is_flowable_expr(seb, flow_ctx, slice_flow_opts)), {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(seb),
                    `Function returning '${type_to_string(result_box)}' carries a raw pointer in its representation; the returned value must be rooted in caller-owned storage. The body's final expression is not flowable:\n  ${ast_expr_to_string(seb)}`,
                    false,
                    .None
                  )
                )
              );
            });
          });
          // Port of function-type.ts:613-631: when the declared return type
          // is a SomeType (Impl(...)) without a resolved concrete type and
          // the def-time-evaluated body has a concrete type, stamp the
          // return SomeT's resolution — the lineage cell (TS mutates the
          // declaration's type object here; the cell is that object's
          // value-semantics surrogate) plus the id-keyed eval→codegen
          // bridge. For a body that is itself a resolved SomeT (delegation
          // wrappers, e.g. write_string_cstr → write_string, both returning
          // Impl(Future(...))), propagate its resolution instead.
          match(
            result_box,
            .SomeT({ id : dts_rid, resolved_concrete : dts_rcell }) => if(
              (dts_rcell.len() == usize(0)) && lookup_some_resolved_concrete(dts_rid).is_none(),
              match(
                flow_out.get(usize(0)),
                .Some(dts_body) => match(
                  expr_info_table_get(ctx.expr_info_table, ast_expr_id(dts_body)),
                  .Some(dts_binfo) => {
                    dts_bty := dts_binfo.ty;
                    if(!(is_some_type(dts_bty)), {
                      dts_rcell.push(dts_bty.clone());
                      register_some_resolved_concrete(dts_rid.clone(), dts_bty);
                    }, {
                      match(
                        dts_bty,
                        .SomeT({ id : dts_bid, resolved_concrete : dts_bcell }) => {
                          dts_prop := match(
                            dts_bcell.get(usize(0)),
                            .Some(x) => Option(TypeValue).Some(x),
                            .None => lookup_some_resolved_concrete(dts_bid)
                          );
                          match(
                            dts_prop,
                            .Some(dts_p) => {
                              dts_rcell.push(dts_p.clone());
                              register_some_resolved_concrete(dts_rid.clone(), dts_p);
                            },
                            .None => ()
                          );
                        },
                        _ => ()
                      );
                    });
                  },
                  .None => ()
                ),
                .None => ()
              ),
              ()
            ),
            _ => ()
          );
        },
        .None => {
          // Deferred (generic) definition — port of
          // checkDeferredGenericReturnType (function-type.ts:50-169):
          // trial-evaluate a CLONE of the body to catch
          // `fn(generic(T), value : T) -> T` returning a concrete type.
          // A trial that itself throws is silently skipped (the body is
          // validated at specialization time), so the swallow is correct
          // here; only the final compare throws. Uses the DEEP some-type
          // scan — `-> Tuple(T)` must qualify, not just a bare `T`.
          if(type_contains_some_type_for_codegen_param(result_box, ArrayList(String).new()), {
            dg_where := match(
              expr,
              .FnCall(_, dg_ft_box, _, _, _) => get_func_where_constraints(ast_expr_id(dg_ft_box).to_string()),
              .Atom(_, _) => ArrayList(WhereConstraintEntry).new()
            );
            dg_ct_flags := match(
              expr,
              .FnCall(_, dgc_ft_box, _, _, _) => get_func_param_comptime(ast_expr_id(dgc_ft_box).to_string()),
              .Atom(_, _) => ArrayList(bool).new()
            );
            dg_env := _build_def_time_body_env(
              caller_env,
              param_labels,
              param_types,
              param_is_ref,
              param_is_owning,
              dg_ct_flags,
              result_box,
              dg_where,
              function_type,
              ctx.is_evaluating_function_body_or_async_block.is_some()
            );
            // A THROWAWAY FuncVal with a fresh id (same pattern as flow_fv
            // above): reusing the real one lets trial registrations shadow
            // the real definition's and codegen emits the trial body clone.
            dg_fv := EvalValue.FuncVal(
              box(
                FuncValData(
                  forall_names : ArrayList(String).new(),
                  params : ArrayList(String).new(),
                  param_type_names : ArrayList(String).new(),
                  evidence_params : ArrayList(String).new(),
                  body : make_err_expr(),
                  cap_names : ArrayList(String).new(),
                  cap_tys : ArrayList(TypeValue).new(),
                  func_id : random_id(caller_env.module_path)
                )
              ),
              ArrayList(EvalValue).new()
            );
            dg_ctx := create_function_body_evaluation_context(function_type, dg_fv, dg_env, ctx);
            dg_out := ArrayList(AstExpr).new();
            dg_fv_was := flow_violation_pending();
            // Same where-trait channel as the flow path: the DEFERRED trial
            // is where a generic fn's body resolution stamps happen, and a
            // where(T <: Trait) constraint is the only discriminator for
            // same-signature methods from different traits
            // (use_trait_a/use_trait_b).
            dg_where_ids := ArrayList(String).new();
            {
              (dgw_i : usize) = usize(0);
              while(dgw_i < dg_where.len(), {
                match(
                  dg_where.get(dgw_i),
                  .Some(dgw_e) => {
                    dgw_id := match(dgw_e.trait_ty, .TraitT(_, _, _, _, dgw_tid, _, _, _, _, _) => dgw_tid, _ => String.from(""));
                    if(dgw_id != "", {
                      dg_where_ids.push(dgw_id);
                    });
                  },
                  .None => ()
                );
                dgw_i = (dgw_i + usize(1));
              });
            };
            push_active_where_trait_ids(dg_where_ids);
            dg_prev_trial := set_in_def_time_trial(true);
            _trial_eval_fn_body(body_expr.clone(), dg_env, dg_ctx, dg_out);
            ___dg_tr := set_in_def_time_trial(dg_prev_trial);
            pop_active_where_trait_ids();
            // A violation flagged by THIS trial must not leak into a later
            // definition's re-raise (TS's catch{} discards everything).
            if(!(dg_fv_was) && flow_violation_pending(), {
              clear_flow_violation();
            });
            match(
              dg_out.get(usize(0)),
              .Some(dg_body) => match(
                expr_info_table_get(ctx.expr_info_table, ast_expr_id(dg_body)),
                .Some(dg_info) => {
                  // Pure-unwind bodies are control functions discarding the
                  // continuation — no return type to check.
                  dg_skip_cf := (has_control_flow(dg_info.control_flow, .Unwind) && !(has_control_flow(dg_info.control_flow, .Return)));
                  dg_expected := cond(
                    result_is_ref => t_ptr(result_box),
                    true => result_box
                  );
                  // Expected bare SomeT that is NOT this fn's own forall: the
                  // generic var is bound by the CALL SITE (e.g. effect-handler
                  // `-> T`), so a concrete body is the correct shape.
                  dg_own_forall_skip := match(
                    dg_expected,
                    .SomeT({ name : dg_sname }) => {
                      (dg_found : bool) = false;
                      (dg_fi : usize) = usize(0);
                      while(dg_fi < forall_labels.len(), {
                        if(match(forall_labels.get(dg_fi), .Some(l) => (l == dg_sname), .None => false), {
                          dg_found = true;
                        });
                        dg_fi = (dg_fi + usize(1));
                      });
                      !(dg_found)
                    },
                    _ => false
                  );
                  dg_trial_ty := dg_info.ty;
                  // Only a FULLY CONCRETE trial result can convict — a trial
                  // type still carrying SomeTs unifies at specialization time
                  // (the prelude Box-Clone impl false-fired on an
                  // abstract-vs-abstract exact compare and abandoned the whole
                  // module load). A `unit` trial type is likewise no
                  // conviction: yo-self's per-node swallows can degrade a
                  // failing generic-body eval into a unit-typed "success"
                  // (TS's try/catch skips those trials outright — measured
                  // false-fires: std ordered_map.get / imm set.to_list /
                  // imm vec Index, corpus deque_self_cycle).
                  dg_trial_abstract := type_contains_some_type_for_codegen_param(dg_trial_ty, ArrayList(String).new());
                  dg_trial_degenerate := (is_unit_type(dg_trial_ty) && !(is_unit_type(dg_expected)));
                  // Parametricity twin of the anon-path fix (see
                  // values/anonymous_function.yo): an own-forall SomeT return
                  // can never be satisfied by a CONCRETE trial type; the exact
                  // check alone cannot convict (unresolved SomeT unifies with
                  // anything).
                  dg_expected_is_some := is_some_type(dg_expected);
                  if((((!(dg_skip_cf) && !(dg_own_forall_skip)) && !(dg_trial_abstract)) && !(dg_trial_degenerate)) && (dg_expected_is_some || !(are_types_compatible_exact(dg_trial_ty, dg_expected))), {
                    dg_exp_str := type_to_string(dg_expected);
                    dg_got_str := type_to_string(dg_trial_ty);
                    // Deliberate user-facing rejection — flag for the def-time re-raise
                    // (see the anon twin in values/anonymous_function.yo).
                    if(!(ctx.is_in_function_call_checking_phase) && (!(propagate_def_time_errors()) && !(flow_violation_pending())), {
                      flag_flow_violation(
                        `Incompatible function return type for:
- Expected: ${dg_exp_str}
- Given  : ${dg_got_str}`
                      );
                    });
                    exn.throw(
                      dyn(
                        format_error_message(
                          tok,
                          `Incompatible function return type for:\n- Expected: ${dg_exp_str}\n- Given  : ${dg_got_str}`,
                          false,
                          .None
                        )
                      )
                    );
                  });
                },
                .None => ()
              ),
              .None => ()
            );
          });
        }
      );
      expr
    },
    _ => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("try_to_implement_function_by_function_type: expected Func type"),
            false,
            .None
          )
        )
      );
      make_err_expr()
    }
  )
);
export(check_deferred_generic_return_type);
export(try_to_implement_function_by_function_type, register_rerun_pending_def_evals);
