:: import("../types/synthesizer.yo");
{ Exception } :: import("std/error");
/// Stamp a generic impl's `generic(T)` names onto a method's FuncVal so the call
/// site recognizes the method as generic and SPECIALIZES it. A method defined in
/// `impl(generic(T), C(T), m : (fn(self : Self) -> T))` is evaluated to a FuncVal
/// with `forall_names = []` — the impl generic lives only on the impl entry, never
/// on the method value. TS keeps `forallParameters = [T]` on each impl method's
/// functionType; without it `is_function_type_generic`/the spec guard never fires
/// and codegen only ever has the abstract method (skipped → undeclared). We stamp
/// the names onto the FuncVal (the VALUE, which survives method resolution's
/// type-concretization — the resolved Func TYPE has its generic stripped, so the
/// value's `forall_names` is the surviving signal the spec guard consults). Only
/// stamps a FuncVal whose own generic is empty, and only when `names` is non-empty.
///
/// Stamps every generic-impl method (instance AND static). Instance methods bind
/// their type params from the concrete `self` ARGUMENT; static methods (no
/// `self`, e.g. `ArrayList(u8).new : (fn() -> Self)`) bind `T` from the impl
/// generic binding that `_inject_forall_captures` puts in the method's captures
/// (the FuncVal-call arm reads it back via its generic-binding capture fallback),
/// and bind `Self` from the static dot-receiver set into `ctx.self_type` around
/// the specialization. Only stamps a FuncVal whose own generic is empty, and only
/// when `names` is non-empty.
/// True if a generic-impl method must NOT be generic-stamped — i.e. it is a
/// MACRO / quoted-expr / comptime method, not a runtime monomorphizable function.
/// Stamping such a method makes it specialization-eligible, and specializing it
/// re-evaluates a body that quotes (`__yo_expr_to_string`) with a no-value Expr
/// arg and throws (observed specializing the `!`/Not operator's comptime variant
/// during a sibling method's resolution). These are caught by EITHER an
/// `Expr`-typed parameter (a quote-taking macro) OR a comptime-only result (an
/// operator's `comptime_*` variant) — neither is monomorphized for codegen.
_method_ty_skip_stamp :: (fn(ty : TypeValue) -> bool)(
  match(
    ty,
    .Func({ param_types : pts, meta : __fm1 }) => if(__fm1.*.result_is_comptime_only, true, {
      (found : bool) = false;
      (i : usize) = usize(0);
      while((i < pts.len()) && !found, {
        match(
          pts.get(i),
          .Some(pt) => if(is_expr_type(pt), {
            found = true;
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    }),
    _ => false
  )
);
_stamp_impl_forall_on_method :: (fn(v : EvalValue, names : ArrayList(String)) -> EvalValue)(
  if(
    names.len() == usize(0),
    v,
    match(
      v,
      .FuncVal(__fvm8, cv) => if(
        __fvm8.*.forall_names.len() > usize(0),
        v,
        EvalValue.FuncVal(box(FuncValData(forall_names : names.clone(), params : __fvm8.*.params, param_type_names : __fvm8.*.param_type_names, evidence_params : __fvm8.*.evidence_params, body : __fvm8.*.body, cap_names : __fvm8.*.cap_names, cap_tys : __fvm8.*.cap_tys, func_id : __fvm8.*.func_id, env_key : __fvm8.*.env_key)), cv)
      ),
      _ => v
    )
  )
);
// ---------------------------------------------------------------------------
// Generic-impl registry (folded from former
// `evaluator/values/generic_impl_registry.yo`).
//
// 1:1 with the generic-impl parts of `src/evaluator/values/impl.ts`.
// The registry stores `impl(generic(T), ReceiverType, ...)` entries; matches
// them against (concrete_type, trait_type) lookups; and resolves methods on
// matched impls. Implemented as two parallel ArrayLists keyed by the trait's
// nominal id, since HashMap(String, ...) would itself depend on generic-impl
// resolution.
//
// A function-pointer slot (`g_type_implements_trait_full_fn`) is provided as
// an indirection back to `trait_checking.yo:type_implements_trait` to
// break the natural circular dependency — trait_checking.yo imports the
// registry to check matches, but the registry needs the trait checker to
// validate where-clause constraints (and to BIND where-clause-only generic
// params). trait_checking.yo installs the pointer in its init block via
// `set_type_implements_trait_full_fn`.
// ---------------------------------------------------------------------------
/// One registered generic impl.
/// Mirrors `GenericImpl` in `src/evaluator/values/impl.ts`.
GenericImplEntry :: struct(
  /// Registry key — same as the trait type's `id` field (from `_trait_type_id`).
  trait_key : String,
  /// Names of generic type parameters, e.g. ["T", "U"].
  forall_names : ArrayList(String),
  /// Corresponding SomeT TypeValues, one per generic name.
  /// Used by `try_match_generic_impl` to populate the unification env.
  forall_some_types : ArrayList(TypeValue),
  /// Receiver type pattern, e.g. `Option(SomeT(T))`.
  /// Contains SomeT references that get bound during unification.
  receiver_type_pattern : TypeValue,
  /// The trait type (may be Unit for anonymous inherent impls).
  trait_type : TypeValue,
  /// Impl field names (method names and associated type labels).
  field_names : ArrayList(String),
  /// Impl field types.
  field_types : ArrayList(TypeValue),
  /// Impl field values (FuncVal, etc.).
  field_values : ArrayList(EvalValue),
  /// Environment captured at definition time.
  definition_env : Environment,
  /// Where-clause constraints (parallel arrays). A concrete type bound to
  /// `where_constraint_some_types[i]` during `try_match_generic_impl` must
  /// implement `where_constraint_traits[i]`, else the impl does NOT match.
  /// Mirrors TS `GenericImpl.whereConstraints` (impl.ts:3011). Without this a
  /// blanket `impl(generic(I), where(I <: Iterator), I, into_iter -> Self)`
  /// leaks onto non-Iterator types (e.g. ArrayList), shadowing the type's own
  /// method. See issues/yo-self-p1-transpile-tail.md.
  where_constraint_some_types : ArrayList(TypeValue),
  where_constraint_traits : ArrayList(TypeValue)
);
// Registry storage (two parallel ArrayLists — avoids HashMap dependency).
(g_impl_registry_keys : ArrayList(String)) = ArrayList(String).new();
(g_impl_registry_entry_lists : ArrayList(ArrayList(GenericImplEntry))) =
  ArrayList(ArrayList(GenericImplEntry)).new();
// Owner tags, bucket-parallel to `g_impl_registry_entry_lists` (same outer
// AND inner index): the `file://` module path whose evaluation registered
// each entry, from `registration_owner()` (type_trait_methods.yo). `""` =
// registered outside any module load, never purged. Enables
// `purge_generic_impls_owned_by` — LSP re-analysis must not leak a registry
// generation per edit (plans/reference/INCREMENTAL_COMPILATION.md Phase B2), and
// stale entries here are a PER-KEYSTROKE cost: every candidate scan in
// `find_methods_from_generic_impls` walks them.
(g_impl_registry_entry_owners : ArrayList(ArrayList(String))) =
  ArrayList(ArrayList(String)).new();
/// ENV-THREADING variant of the hook — the port of TS's full
/// `typeImplementsTrait` (`{ implemented, env }`). `TraitCheckResult` lives in
/// trait_checking.yo (importing it here would be circular), so the adapter
/// writes the post-constraint bindings into the caller's env IN PLACE and
/// returns the implemented flag. `try_match_generic_impl`'s where-constraint pass needs
/// the env: trait satisfaction is what BINDS a generic param that appears
/// only in a where clause (impl.ts:2425-2432 and its comment — "necessary for
/// generic params that are only constrained through where-clauses").
TypeImplementsTraitFullFn :: (
  fn(
    t : TypeValue,
    trait_type : TypeValue,
    env : Environment
  ) -> bool
);
(g_type_implements_trait_full_fn : Option(TypeImplementsTraitFullFn)) =
  Option(TypeImplementsTraitFullFn).None;
set_type_implements_trait_full_fn :: (fn(f : TypeImplementsTraitFullFn) -> unit)({
  g_type_implements_trait_full_fn = Option(TypeImplementsTraitFullFn).Some(f);
});
/// Type of `register_type_trait_value` from trait_checking.yo. Records that a
/// type implements a trait VALUE (by its base id) so `Type.impls(T, Trait)`
/// resolves at trait-checking step 4. Routed via a function pointer to break the
/// impl.yo ↔ trait_checking.yo import cycle (same pattern as above).
RegisterTraitValueFn :: (fn(type_id : String, trait_ty : TypeValue) -> unit);
(g_register_trait_value_fn : Option(RegisterTraitValueFn)) =
  Option(RegisterTraitValueFn).None;
/// Install the function pointer (called from trait_checking.yo init block).
set_register_trait_value_fn :: (fn(f : RegisterTraitValueFn) -> unit)({
  g_register_trait_value_fn = Option(RegisterTraitValueFn).Some(f);
});
/// Type of `check_self_constraints_violation_msg` from trait_checking.yo:
/// `.Some(error message)` when `target_type` violates a positive or negative
/// selfConstraint on `trait_ty` (e.g. `Dispose`'s `where(Self <: Rc)` against
/// a value struct), `.None` when satisfied. Routed via a function pointer to
/// break the impl.yo ↔ trait_checking.yo import cycle (same pattern as above);
/// the caller throws with its own token/exn. Mirrors TS calling
/// `checkTypeImplementsSelfConstraints` per trait entry (impl.ts:3269).
CheckSelfConstraintsFn :: (fn(target_type : TypeValue, trait_ty : TypeValue, env : Environment) -> Option(String));
(g_check_self_constraints_fn : Option(CheckSelfConstraintsFn)) =
  Option(CheckSelfConstraintsFn).None;
/// Install the function pointer (called from trait_checking.yo init block).
set_check_self_constraints_fn :: (fn(f : CheckSelfConstraintsFn) -> unit)({
  g_check_self_constraints_fn = Option(CheckSelfConstraintsFn).Some(f);
});
// ---------------------------------------------------------------------------
// `currentlyRegisteringConcreteImpls` registry
// ---------------------------------------------------------------------------
/// Set of `${typeId}:${traitId}` keys currently being registered.
/// Mirrors `currentlyRegisteringConcreteImpls` in
/// `src/evaluator/values/impl.ts:819`. Lives in impl.yo (not
/// trait_checking.yo) so the impl evaluator can mark/unmark without
/// a circular import; trait_checking.yo re-exports thin wrappers.
///
/// Used to handle recursive types — e.g. `derive(TreeNode, Clone)`
/// where `Box(TreeNode)` Clone-impl validation needs to see
/// `TreeNode <: Clone` even though the impl hasn't been formally
/// registered yet.
(_currently_registering_concrete_impls : HashMap(String, bool)) =
  HashMap(String, bool).new();
_concrete_impl_key :: (fn(type_id : String, trait_id : String) -> String)(
  type_id.clone() + String.from(":") + trait_id
);
/// Returns true if (type_id, trait_id) is currently being registered.
/// Mirrors `isConcreteImplBeingRegistered` in `impl.ts:825-832`.
is_concrete_impl_being_registered :: (fn(type_id : String, trait_id : String) -> bool)({
  k := _concrete_impl_key(type_id, trait_id);
  match(
    _currently_registering_concrete_impls.get(k),
    .Some(_) => true,
    .None => false
  )
});
/// Mark a type+trait pair as currently being registered.
mark_concrete_impl_being_registered :: (fn(type_id : String, trait_id : String) -> unit)({
  k := _concrete_impl_key(type_id, trait_id);
  _currently_registering_concrete_impls.insert(k, true);
});
/// Unmark a type+trait pair after registration completes.
unmark_concrete_impl_being_registered :: (fn(type_id : String, trait_id : String) -> unit)({
  k := _concrete_impl_key(type_id, trait_id);
  _currently_registering_concrete_impls.remove(k);
});
/// Extract the registry key from a trait TypeValue.
/// Uses the `id` field of TraitT (the stable nominal ID).
/// Mirrors `getBaseTraitKey` which prefers `traitType.functionValue.funcId`.
get_trait_key :: (fn(trait_ty : TypeValue) -> String)(
  match(
    trait_ty,
    .TraitT(_, _, _, _, id, _, _, _, _, _) => id,
    .FnTraitT(base_name, _, _, _, _, _, _, _) => base_name,
    .FutureTraitT(base_name, _, _, _, _) => base_name,
    _ => String.from("")
  )
);
/// Base-trait key for the GENERIC-impl registry: the trait constructor's
/// funcId when the trait came from a comptime fn (`Eq(K)` → Eq's fid), else
/// the trait's own key. Mirrors TS `getBaseTraitKey` (impl.ts:1042-1050) —
/// per-instantiation trait ids (`Eq(Box(T))` vs `Eq(Box(i32))`) must land in
/// ONE registry bucket, keyed by the constructor. Everything id-keyed
/// (negative impls, concrete registrations) keeps `get_trait_key`, as TS
/// keeps `traitType.id` there.
get_base_trait_key :: (fn(trait_ty : TypeValue) -> String)(
  match(
    trait_ty,
    .TraitT(_, _, _, _, gb_id, _, _, _, _, _) => match(
      lookup_trait_ctor_fid(gb_id),
      .Some(gb_fid) => gb_fid,
      .None => gb_id
    ),
    _ => get_trait_key(trait_ty)
  )
);
/// Register a new generic impl entry.
/// Mirrors `registerGenericImpl` in impl.ts.
register_generic_impl :: (fn(entry : GenericImplEntry) -> unit)({
  key := entry.trait_key.clone();
  // Find existing bucket for this key, or create a new one.
  (key_idx : Option(usize)) = Option(usize).None;
  (ki : usize) = usize(0);
  (n_keys : usize) = g_impl_registry_keys.len();
  while(ki < n_keys, {
    existing_key := match(g_impl_registry_keys.get(ki), .Some(k) => k, .None => String.from(""));
    if(existing_key == key, {
      key_idx = Option(usize).Some(ki);
      ki = n_keys; // break
    });
    ki = (ki + usize(1));
  });
  owner := registration_owner();
  match(
    key_idx,
    .Some(idx) => {
      // Append to existing list (owner list stays index-parallel).
      match(
        g_impl_registry_entry_lists.get(idx),
        .Some(list) => {
          list.push(entry);
        },
        .None => ()
      );
      match(
        g_impl_registry_entry_owners.get(idx),
        .Some(olist) => {
          olist.push(owner);
        },
        .None => ()
      );
    },
    .None => {
      // New key — add parallel entries.
      new_list := ArrayList(GenericImplEntry).new();
      new_list.push(entry);
      new_owners := ArrayList(String).new();
      new_owners.push(owner);
      g_impl_registry_keys.push(key);
      g_impl_registry_entry_lists.push(new_list);
      g_impl_registry_entry_owners.push(new_owners);
    }
  );
});
/// Drop every generic-impl entry registered by `owner` (a `file://` abs
/// module path). Phase B2 — called for each module the LSP invalidates.
purge_generic_impls_owned_by :: (fn(owner : String) -> unit)({
  if(owner.len() == usize(0), {
    return(());
  });
  (ki : usize) = usize(0);
  while(ki < g_impl_registry_entry_lists.len(), {
    match(
      g_impl_registry_entry_lists.get(ki),
      .Some(list) => match(
        g_impl_registry_entry_owners.get(ki),
        .Some(olist) => {
          (i : usize) = olist.len();
          while(i > usize(0), {
            i = (i - usize(1));
            hit := match(olist.get(i), .Some(o) => (o == owner), .None => false);
            if(hit && (i < list.len()), {
              list.drain(i .. (i + usize(1)));
              olist.drain(i .. (i + usize(1)));
            });
          });
        },
        .None => ()
      ),
      .None => ()
    );
    ki = (ki + usize(1));
  });
});
/// Total generic-impl entries across all buckets (LSP leak gate).
generic_impl_entry_count :: (fn() -> usize)({
  (total : usize) = usize(0);
  (ki : usize) = usize(0);
  while(ki < g_impl_registry_entry_lists.len(), {
    match(
      g_impl_registry_entry_lists.get(ki),
      .Some(list) => {
        total = (total + list.len());
      },
      .None => ()
    );
    ki = (ki + usize(1));
  });
  total
});
// ---------------------------------------------------------------------------
// Negative-impl registry (Phase N THREAD_SAFETY). A negative impl
// `impl(T, !(Trait))` declares that T does NOT implement Trait, overriding
// auto-derive. Keyed by "typeId:traitId". 1-to-1 with impl.ts:269-293
// (`negativeImplRegistry`). Generic negative impls (generic) are out of scope
// here — they only feed vacuous `comptime_assert`s in the tests.
// ---------------------------------------------------------------------------
(g_negative_impl_registry : ArrayList(String)) = ArrayList(String).new();
has_negative_impl :: (fn(type_id : String, trait_id : String) -> bool)({
  key := `${type_id}:${trait_id}`;
  (i : usize) = usize(0);
  (found : bool) = false;
  while((i < g_negative_impl_registry.len()) && !found, {
    match(
      g_negative_impl_registry.get(i),
      .Some(k) => if(k == key, {
        found = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
register_negative_impl :: (fn(type_id : String, trait_id : String) -> unit)({
  if(!has_negative_impl(type_id, trait_id), {
    g_negative_impl_registry.push(`${type_id}:${trait_id}`);
  });
});
// Mirrors `tryMatchGenericImpl` in impl.ts — uses `synthesize_types` to
// unify the receiver type pattern against the concrete type.
//
// Phase 3.5 simplifications vs TypeScript:
// - No `valueSubstitutions` (only type params supported).
// - No struct env fallback for erasure (simpler struct lookup).
// - No `valueSubstitutions` beyond the IntLit side-channel.
/// Resolve the concrete type bound to one `generic` param after a successful
/// `synthesize_types`. Returns `.None` if the param stayed abstract (`SomeT`).
/// Used by `try_match_generic_impl` to surface the unification result so the
/// dispatcher can bind the impl's type params in the method body.
// Side-channel for VALUE-level generic bindings (`generic(U : usize)` array
// lengths): `try_match_generic_impl`'s bindings list is TYPE-only (an
// ArrayList(TypeValue) cannot carry the IntLit 5), so the match loop ALSO
// records each binder's VALUE here (UnitVal for type binders, the IntLit for
// value binders, index-aligned with the returned bindings).
// `find_methods_from_generic_impls` snapshots it right after a successful
// match and `_inject_forall_captures` injects the IntLit as the capture value
// — previously it injected TypeVal(usize) (the binder's DECLARED type), so
// `Array(T, U).len`'s body `return(U)` returned a TYPE ("Return type
// mismatch. Expected usize, but got Type" — the array-family hollow).
// Single-threaded evaluator; cleared at each try_match entry.
(g_last_match_binding_vals : ArrayList(EvalValue)) = ArrayList(EvalValue).new();
_resolve_one_forall_binding :: (
  fn(expected_env : Environment, fa_some : TypeValue, fa_name : String) -> Option(TypeValue)
)({
  // TS parity (impl.ts tryMatchGenericImpl, substitutions extraction): a
  // binding unified to a DIFFERENT SomeType is a binding — "include the
  // substitution if resolved to a concrete type, OR unified to a different
  // SomeType; only skip when it is still its own original SomeType". A
  // cross-impl method call at DEFINITION time is exactly this case: the
  // Clone impl's `self.len()` matches the inherent `ArrayList(T)` impl
  // against `ArrayList(T')`, binding T := T' (abstract). Rejecting every
  // SomeT here made the call degrade to unit and the def-time trial
  // swallow the whole body (root #3 of
  // issues/fixed/def-eval-swallow-remaining-roots.md).
  fa_some_id := match(fa_some, .SomeT({ id : __fsi }) => __fsi, _ => String.from(""));
  bound_type := get_value_of_some_type_from_env(expected_env, fa_some);
  if(!is_some_type(bound_type), {
    if(impl_dbg_env.get(`YO_DEBUG_DISPATCH`).is_some(), {
      eprintln(`[rfb-bound] name=${fa_name} via=id-concrete ty=${type_to_string(bound_type)} trial=${in_def_time_trial().to_string()}`);
    });
    return(Option(TypeValue).Some(bound_type));
  });
  // Accept a DIFFERENT-id SomeT binding ONLY inside a definition-time body
  // trial (both channels): a trial's stamps are discardable/superseded, so
  // abstract resolutions are safe there and are what resolve cross-impl
  // dispatch (array_list's Clone -> len, root #3). OUTSIDE trials the old
  // concrete-only rule stays — derive validation and specialization body
  // evals produce stamps codegen consumes directly, and an abstract match
  // there minted an abstract-keyed spec the emitter skips while the call
  // site still emits it (tests/derive_clone_complex.test.yo 'call to
  // undeclared function', measured; std/string module eval broke under the
  // unscoped name channel too).
  bt_id := match(bound_type, .SomeT({ id : __bti }) => __bti, _ => String.from(""));
  if(in_def_time_trial() && (bt_id.len() > usize(0)) && (bt_id != fa_some_id), {
    return(Option(TypeValue).Some(bound_type));
  });
  if(impl_dbg_env.get(`YO_DEBUG_DISPATCH`).is_some(), {
    eprintln(`[rfb-id-miss] name=${fa_name} own_id=${fa_some_id} bound_id=${bt_id} trial=${in_def_time_trial().to_string()}`);
  });
  // Name-based fallback: look up `fa_name` directly in `expected_env`.
  name_vars := get_variables_from_env(expected_env, fa_name);
  n_nvars := name_vars.len();
  if(n_nvars == usize(0), {
    return(Option(TypeValue).None);
  });
  last_nvar := match(name_vars.get(n_nvars - usize(1)), .Some(v) => v, .None => return(Option(TypeValue).None));
  match(
    last_nvar.value.get(usize(0)),
    .Some(ev) => match(
      ev,
      .TypeVal(b) => cond(
        !is_some_type(b) => {
          if(impl_dbg_env.get(`YO_DEBUG_DISPATCH`).is_some(), {
            eprintln(`[rfb-bound] name=${fa_name} via=name-concrete ty=${type_to_string(b)} trial=${in_def_time_trial().to_string()}`);
          });
          Option(TypeValue).Some(b)
        },
        // Abstract (different-id SomeT) name-channel binding: accepted ONLY
        // inside a definition-time body trial. There it is what resolves a
        // sibling impl's method dispatch (array_list's Clone impl calling
        // the inherent impl's `len` on ArrayList(T') — matching binds
        // T := T'); everywhere else name lookup can hit an unrelated
        // same-name SomeT from an outer scope, and unscoped acceptance
        // broke std module evaluation ("Incompatible function return
        // type" — measured 2026-08-13).
        true => {
          nb_id := match(b, .SomeT({ id : __nbi }) => __nbi, _ => String.from(""));
          cond(
            (in_def_time_trial() && (nb_id.len() > usize(0)) && (nb_id != fa_some_id)) => Option(TypeValue).Some(b),
            true => Option(TypeValue).None
          )
        }
      ),
      // VALUE-level generic (`generic(U : usize)` array lengths): the
      // synthesizer binds the variable to an IntLit. Represent the
      // binding by the variable's declared type (usize) — KNOWN GAP:
      // method types that mention `U` in a LENGTH position would need a
      // value substitution, which `substitute()` cannot express; current
      // std impls (e.g. Array fill) don't, they only use `T`/`Self`.
      .IntLit(_) => Option(TypeValue).Some(last_nvar.ty),
      _ => Option(TypeValue).None
    ),
    .None => Option(TypeValue).None
  )
});
/// Match `entry` against `concrete_type` in `env`. Returns `.Some(bindings)`
/// where `bindings[i]` is the concrete type bound to `entry.forall_names[i]`
/// (in declaration order) when the impl matches and every generic param
/// resolved to a concrete type; `.None` when there is no match.
/// Conservative root-shape compatibility for the generic-impl prefilter:
/// returns false ONLY when BOTH roots are concrete shapes that can never
/// unify (different variant tags, different int width/signedness,
/// different non-empty struct/enum base names). Whenever EITHER side is
/// flexible (SomeT, TypeAppT, Func, TraitT, comptime types, ...) it
/// returns true and lets full synthesis decide. Purely an optimization —
/// never changes match outcomes, only skips guaranteed-failure
/// candidates before the unification env build + synthesis.
_root_shape_class :: (fn(t : TypeValue) -> i32)(
  match(
    t,
    .Struct({ name }) => cond(
      (name.len() == usize(0)) => i32(0),
      true => i32(1)
    ),
    .EnumT(_, en_name, _, _, _, _, _, _, _) => cond(
      (en_name.len() == usize(0)) => i32(0),
      true => i32(2)
    ),
    .Array(_, _, _) => i32(3),
    .Str => i32(4),
    .Pointer(_) => i32(5),
    .Tuple(_, _) => i32(6),
    .Int(_, _) => i32(7),
    .Usize => i32(8),
    .Isize => i32(9),
    .Float(_) => i32(10),
    .BoolT => i32(11),
    _ => i32(0)
  )
);
_root_shape_name :: (fn(t : TypeValue) -> String)(
  match(
    t,
    .Struct({ name }) => name,
    .EnumT(_, en_name, _, _, _, _, _, _, _) => en_name,
    _ => String.from("")
  )
);
/// The base identifier of a (possibly generic-suffixed) type name:
/// `Box(i32)` → `Box`, `HashMap(K, V)` → `HashMap`, `Foo` → `Foo`.
_root_shape_base_name :: (fn(name : String) -> String)(
  match(
    name.index_of(`(`),
    .Some(pidx) => name.substring(usize(0), pidx),
    .None => name
  )
);
_root_shapes_could_match :: (fn(pattern : TypeValue, concrete : TypeValue) -> bool)({
  pc := _root_shape_class(pattern);
  cc := _root_shape_class(concrete);
  // Either side flexible -> let synthesis decide.
  if((pc == i32(0)) || (cc == i32(0)), {
    return(true);
  });
  if(pc != cc, {
    return(false);
  });
  // Same concrete class — extra exactness for the cheap cases. Compare BASE
  // names only (the segment before a type-argument suffix): a generic
  // pattern's struct is named after its instantiation site — `Box(T)` — while
  // a concrete receiver is `Box(i32)`; exact equality would reject every
  // specific-generic-pattern impl before synthesis ever ran (TS has no
  // prefilter — synthesis is the real match — so base-name comparison keeps
  // this a pure PRE-filter).
  if((pc == i32(1)) || (pc == i32(2)), {
    pn := _root_shape_base_name(_root_shape_name(pattern));
    cn := _root_shape_base_name(_root_shape_name(concrete));
    return(pn == cn);
  });
  if(pc == i32(7), {
    return(
      match(
        pattern,
        .Int(p_bits, p_signed) => match(
          concrete,
          .Int(c_bits, c_signed) => ((p_bits == c_bits) && (p_signed == c_signed)),
          _ => false
        ),
        _ => false
      )
    );
  });
  if(pc == i32(10), {
    return(
      match(
        pattern,
        .Float(p_fbits) => match(
          concrete,
          .Float(c_fbits) => (p_fbits == c_fbits),
          _ => false
        ),
        _ => false
      )
    );
  });
  true
});
/// Fallback binding for a generic-impl `generic` param that structural field
/// synthesis could not resolve. When the receiver pattern erases the param
/// from its fields (e.g. `Buf(T)` evaluates to `object(_n : usize)` — `T`
/// never appears structurally, so synthesizing `Buf(T)` against `Buf(u8)`
/// binds nothing), recover the binding from the concrete instantiation's
/// `type_arguments` — yo-self's faithful stand-in for TS `StructType.env`.
/// Mirrors the env fallback in `impl.ts:2290-2331`, which reads
/// `concreteType.env`. Locate the param's `SomeT` inside the PATTERN's
/// `type_arguments` (by name + frame level) and read the same position from
/// the CONCRETE's `type_arguments`.
_bind_forall_from_type_args :: (
  fn(pattern : TypeValue, concrete : TypeValue, fa_some : TypeValue) -> Option(TypeValue)
)({
  fa_name := match(fa_some, .SomeT({ name }) => name, _ => return(Option(TypeValue).None));
  fa_lvl := match(fa_some, .SomeT({ frame_level }) => frame_level, _ => return(Option(TypeValue).None));
  pat_ta := match(pattern, .Struct({ type_arguments : ta }) => ta, _ => ArrayList(TypeValue).new());
  con_ta := match(concrete, .Struct({ type_arguments : ta }) => ta, _ => ArrayList(TypeValue).new());
  if(impl_dbg_env.get(`YO_DEBUG_DISPATCH`).is_some(), {
    (bfta_s : String) = String.from("");
    (bfta_i : usize) = usize(0);
    while(bfta_i < con_ta.len(), {
      bfta_s = `${bfta_s}[${match(con_ta.get(bfta_i), .Some(t) => type_to_string(t), .None => String.from("-"))}]`;
      bfta_i = (bfta_i + usize(1));
    });
    (bfta_p : String) = String.from("");
    (bfta_j : usize) = usize(0);
    while(bfta_j < pat_ta.len(), {
      bfta_p = `${bfta_p}[${match(pat_ta.get(bfta_j), .Some(t) => type_to_string(t), .None => String.from("-"))}]`;
      bfta_j = (bfta_j + usize(1));
    });
    eprintln(`[bfta] fa=${fa_name} fa_lvl=${fa_lvl.to_string()} pat_ta=${bfta_p} con_ta=${bfta_s}`);
  });
  (j : usize) = usize(0);
  (n : usize) = pat_ta.len();
  while(j < n, {
    pj := match(pat_ta.get(j), .Some(t) => t, .None => t_unit());
    is_match := match(
      pj,
      .SomeT({ name : pn, frame_level : pl }) => ((pn == fa_name) && (pl == fa_lvl)),
      _ => false
    );
    if(is_match, {
      match(
        con_ta.get(j),
        // `Unit` in a type_arguments slot is the NON-TYPE-ARG placeholder
        // (comptime_fn.yo inst_type_args pads value args with Unit so
        // positions line up) — never a real binding. Binding a forall to it
        // specialized `_find_bucket` with `key : unit` under the HashMap
        // Clone-impl trial and the sibling `set` re-eval swallowed
        // ("Cannot unify u64 and unit", hash_map:714 of the corpus family).
        .Some(ct) => if(!is_some_type(ct) && !match(ct, .Unit => true, _ => false), {
          return(Option(TypeValue).Some(ct));
        }, {
          // Trial-scoped abstract acceptance — same contract as
          // _resolve_one_forall_binding: inside a definition-time body
          // trial a DIFFERENT-id SomeT type argument IS the binding
          // (ArrayList(T_pattern) matched against the Clone impl's
          // ArrayList(T'), root #3 — field synthesis leaves T unbound
          // because ?(*(T)) unification binds neither side, and this
          // type-args recovery was the only channel left).
          {
            ct_abs_id := match(ct, .SomeT({ id : __cai }) => __cai, _ => String.from(""));
            fa_abs_id := match(fa_some, .SomeT({ id : __fai }) => __fai, _ => String.from(""));
            if(in_def_time_trial() && (ct_abs_id.len() > usize(0)) && (ct_abs_id != fa_abs_id), {
              return(Option(TypeValue).Some(ct));
            });
          };
          // `ct` is still a SomeType. Resolution channel 1 — the SomeT's own
          // resolution-chain CELL: a per-call closure-F combinator return
          // (`IterMap(Self, B, F)`) deliberately keeps `F` as a SomeT in the
          // stamped type (adopting the name-resolved value clobbered the
          // per-call `F → <capture>` identity — see calls/function.yo's rre
          // adoption notes) and records the concrete capture in the CELL.
          // A CHAINED receiver re-specializes on demand and presents a
          // resolved instance, but a VARIABLE-BOUND receiver keeps this
          // stamp — without the cell walk the impl match left `F` unbound
          // and `m := xs.map(f); m.for_each(g)` failed "does not implement
          // required trait Iterator"
          // (issues/varbound-combinator-receiver-impl-match.md).
          {
            (cell_cur : TypeValue) = ct;
            (cell_seen : ArrayList(String)) = ArrayList(String).new();
            (cell_walk : bool) = true;
            while(cell_walk, {
              match(
                cell_cur,
                .SomeT(id : cell_id, resolved_concrete : cell_rc) => {
                  (cell_revisit : bool) = false;
                  (cell_i : usize) = usize(0);
                  while(cell_i < cell_seen.len(), {
                    match(
                      cell_seen.get(cell_i),
                      .Some(cs) => if(cs == cell_id, {
                        cell_revisit = true;
                      }),
                      .None => ()
                    );
                    cell_i = (cell_i + usize(1));
                  });
                  if(cell_revisit, {
                    cell_walk = false;
                  }, {
                    cell_seen.push(cell_id.clone());
                    match(
                      cell_rc.get(usize(0)),
                      .Some(cell_nx) => {
                        cell_cur = cell_nx;
                      },
                      .None => {
                        cell_walk = false;
                      }
                    );
                  });
                },
                _ => {
                  cell_walk = false;
                }
              );
            });
            if(!is_some_type(cell_cur) && !match(cell_cur, .Unit => true, _ => false), {
              return(Option(TypeValue).Some(cell_cur));
            });
          };
          // Channel 2 — the codegen registry. For an async future's output
          // type, yo-self KEEPS the output unresolved through eval (the
          // FSM/future machinery keys on that SomeType identity), and the
          // concrete type lands in the `g_some_resolved_concrete` registry
          // (set at the io.async call site). Resolve via that registry — the
          // same resolvedConcreteType bridge the io.await refinement uses —
          // so e.g. `JoinHandle(T)`'s generic-impl `await` match binds `T`
          // to the concrete spawned output instead of skipping the SomeType
          // arg. See issues/fixed/yo-self-async-await-struct-result-eval.md.
          match(
            ct,
            .SomeT({ id : ctid }) => match(
              lookup_some_resolved_concrete(ctid),
              .Some(c) => return(Option(TypeValue).Some(c)),
              .None => ()
            ),
            _ => ()
          );
        }),
        .None => ()
      );
    });
    j = (j + usize(1));
  });
  Option(TypeValue).None
});
/// In-module forward hook to `find_associated_type_from_generic_impls`
/// (defined BELOW; it mutually recurses with try_match_generic_impl via the
/// method finder, and Yo has no forward references). Installed by the
/// module-level statement right after the finder's definition.
FindAssocFromImplsFn :: (fn(t : TypeValue, label : String, env : Environment) -> Option(TypeValue));
(g_find_assoc_from_impls_fn : Option(FindAssocFromImplsFn)) = Option(FindAssocFromImplsFn).None;
/// True when any member of `tys` is, or structurally contains, a SomeT.
_any_type_has_some_type :: (fn(tys : ArrayList(TypeValue)) -> bool)({
  (ati : usize) = usize(0);
  while(ati < tys.len(), {
    at_ty := match(tys.get(ati), .Some(t) => t, .None => t_unit());
    if(is_some_type(at_ty) || (get_all_some_types(at_ty).len() > usize(0)), {
      return(true);
    });
    ati = (ati + usize(1));
  });
  false
});
/// A MARKER trait — its member and associated-type-constraint types mention no
/// type variable at all, so the stored TypeValue is INSTANTIATION-INDEPENDENT:
/// it means the same thing wherever it is asked. `Send`, `Comptime`, `Runtime`
/// and `Acyclic` qualify (their only member is the `id := "..."` tag, a
/// `comptime_str`); anything with a METHOD does not, because a method signature
/// mentions `Self` — and a PARAMETRIC trait's arguments (`Eq(T)`'s `rhs : T`)
/// are baked in at evaluation time as well.
///
/// `try_match_generic_impl`'s where-constraint pass enforces a constructed
/// receiver pattern's clause only for these; see the long comment there for
/// why a non-marker bound cannot be decided from the stored TypeValue.
_is_marker_trait :: (fn(ty : TypeValue) -> bool)(
  match(
    ty,
    .TraitT({ field_types : mt_fts, assoc_constraint_types : mt_acts }) => (
      !_any_type_has_some_type(mt_fts) && !_any_type_has_some_type(mt_acts)
    ),
    _ => false
  )
);
/// `enforce_all_where` — see the where-constraint pass below. `false` (the
/// METHOD-DISPATCH callers) enforces a failed where-clause only for BLANKET
/// impls; `true` (the TRAIT-PREDICATE caller, `find_matching_generic_impl`)
/// enforces a MARKER constraint on a constructed receiver pattern too, so
/// `impl(generic(T), where(T <: Send), *(T), Send())` cannot answer
/// "`*(NonSend)` is Send".
try_match_generic_impl :: (
  fn(
    concrete_type : TypeValue,
    entry : GenericImplEntry,
    env : Environment,
    enforce_all_where : bool
  ) -> Option(ArrayList(TypeValue))
)({
  // 1. Resolve SomeT — if still unresolved, cannot match.
  (resolved_concrete : TypeValue) = concrete_type;
  if(is_some_type(concrete_type), {
    resolved := get_value_of_some_type_from_env(env, concrete_type);
    if(is_some_type(resolved), {
      return(Option(ArrayList(TypeValue)).None); // Unresolved type param — cannot match.
    });
    resolved_concrete = resolved;
  });
  // 1b. Cheap root-shape prefilter: when the pattern's ROOT is a concrete
  // shape (Struct/EnumT/Array/Str/Pointer/Tuple/primitive) and the
  // receiver's root TAG differs, synthesis can never succeed — skip
  // WITHOUT the unification env build below (formerly a deep clone_env,
  // and the env grows with each loaded module, so a directory-wide
  // `check` paid a growing clone per candidate per lookup). SomeT /
  // TypeAppT pattern roots always proceed (they can bind anything).
  if(!_root_shapes_could_match(entry.receiver_type_pattern, resolved_concrete), {
    if(impl_dbg_env.get(`YO_DEBUG_DISPATCH`).is_some(), {
      eprintln(`[tm-none] reason=prefilter recv=${type_id_or_empty(resolved_concrete)} pat=${type_id_or_empty(entry.receiver_type_pattern)}`);
    });
    return(Option(ArrayList(TypeValue)).None);
  });
  if(impl_dbg_env.get(`YO_DEBUG_DISPATCH`).is_some(), {
    eprintln(`[tm-try] recv=${type_id_or_empty(resolved_concrete)} pat=${type_id_or_empty(entry.receiver_type_pattern)} trial=${in_def_time_trial().to_string()}`);
  });
  // 2. Build unify_env: snapshot the env (share frames — TS `pushEnvFrame`
  //    at impl.ts:2243 copies only the frame-pointer array) and push a fresh
  //    frame; all SomeT binds below go to that fresh frame. The old
  //    `clone_env` deep-copied every frame's variable list PER CANDIDATE PER
  //    LOOKUP — a top allocation-churn site of a self-emit.
  (unify_env : Environment) = snapshot_env(env);
  unify_env.push_frame(false);
  (ui : usize) = usize(0);
  (n_forall : usize) = entry.forall_names.len();
  while(ui < n_forall, {
    fa_name := match(
      entry.forall_names.get(ui),
      .Some(n) => n,
      .None => {
        ui = (ui + usize(1));
        continue;
      }
    );
    fa_some := match(
      entry.forall_some_types.get(ui),
      .Some(s) => s,
      .None => {
        ui = (ui + usize(1));
        continue;
      }
    );
    add_variable_to_env(
      unify_env,
      fa_name,
      t_type(),
      Option(EvalValue).Some(create_type_value(fa_some)),
      true,
      // is_compile_time_only
      false,
      false,
      false,
      synthetic_token(fa_name, env.module_path)
    );
    ui = (ui + usize(1));
  });
  // 3. Try synthesize_types(receiver_pattern, unify_env, concrete_type, env).
  //    If it throws, there is no match.
  exn_match := Exception(
    throw : (
      err -> {
        // Synthesis failed → no match. YO_DEBUG_DISPATCH prints the
        // swallowed error (capture-free handler, same pattern as the
        // [swallow] hook) — pairs with the [tm-try] line above it.
        if(impl_dbg_env.get(`YO_DEBUG_DISPATCH`).is_some(), {
          eprintln(`[tm-synth-swallow] ${err.to_string()}`);
        });
        unwind(Option(ArrayList(TypeValue)).None);
      }
    )
  );
  if(impl_dbg_env.get(`YO_DEBUG_BIND`).is_some(), {
    (tmf_ids : String) = String.from("");
    (tmf_i : usize) = usize(0);
    while(tmf_i < unify_env.frames.len(), {
      match(
        unify_env.frames.get(tmf_i),
        .Some(tmf_f) => {
          tmf_ids.push_string(tmf_f.id.to_string());
          tmf_ids.push_string(String.from(","));
        },
        .None => ()
      );
      tmf_i = (tmf_i + usize(1));
    });
    tmf_lvl := match(
      entry.forall_some_types.get(usize(0)),
      .Some(tmf_st) => match(tmf_st, .SomeT({ frame_level : tmf_l }) => tmf_l, _ => usize(9999)),
      .None => usize(9999)
    );
    eprintln(`[tm-frames] pat=${type_to_string(entry.receiver_type_pattern)} fa0_lvl=${tmf_lvl.to_string()} frames=${tmf_ids}`);
  });
  checked := ArrayList(TypePair).new();
  opts := Option(SynthesizeOptions).None;
  // Isolate the GIVEN side exactly like the expected side above: TS's
  // tryMatchGenericImpl runs synthesis in scratch chains it DISCARDS
  // (impl.ts:2243 pushEnvFrame — persistent chains make every update
  // invisible to the caller). yo-self passed the caller `env` RAW, so the
  // synthesizer's given-side shadow-binds landed in the caller env's TOP
  // frame — during a def-time trial that frame is DURABLE and SHARED, and
  // one candidate's junk binding (`T := <hash_map struct>` written while
  // probing a hash_map-family entry against a HashSet receiver) then
  // poisoned every LATER match's (frame-level, name) resolution: the
  // blanket pointer impl's `T` resolved to the junk struct, `*(u8)` failed
  // to unify against it, `.add` dispatch found nothing, and the trial
  // swallowed ("Failed to evaluate, got ((ctrl_ptr.add)(i).(*))" — the
  // hash_set corpus family, issues/fixed/def-eval-swallow-remaining-roots.md).
  (given_scratch : Environment) = snapshot_env(env);
  given_scratch.push_frame(false);
  synth_result := synthesize_types(
    entry.receiver_type_pattern,
    unify_env,
    resolved_concrete,
    given_scratch,
    checked,
    opts,
    exn_match
  );
  // Where-constraint pass — port of impl.ts:2337-2432, which runs BEFORE the
  // substitution extraction. Checking a constraint with the FULL env-returning
  // type_implements_trait is what BINDS a generic param that appears ONLY in
  // the where clause, not in the receiver pattern's fields: for
  // `impl(generic(I, A), where(I <: Iterator(Item := A)), MyWrap(I), ...)`,
  // field synthesis binds I := CountIter but `A` is bound by satisfying
  // `CountIter <: Iterator(Item := A)` (synthesizes A := i32 into the env).
  // Without this the bindings loop below saw `A` abstract, set
  // all_bound = false, and the impl silently never matched — `w.next()` had
  // no ExprInfo and codegen dropped the statement (issues/repros/v5_direct.yo,
  // the tests/iter_filter_closure + iterator_combinators family).
  //
  // ENFORCEMENT is scoped by `enforce_all_where`:
  //
  //   false (METHOD DISPATCH — find_methods_from_generic_impls and friends):
  //     only BLANKET impls (bare-SomeT receiver pattern) are rejected on a
  //     failed clause. A blanket matches every type, so its where-clause is
  //     the only thing keeping it off non-satisfying types; specific-pattern
  //     impls already constrain via their pattern, and enforcing their
  //     clauses HERE would drop a method wherever the trait-implements
  //     predicate has a load-order false negative (e.g. `String <: Hash`
  //     breaking `HashMap(String, _).new()`).
  //
  //   true (TRAIT PREDICATE — find_matching_generic_impl, the sole feeder of
  //     `type_implements_trait` step 8): a constructed pattern is enforced
  //     too, but ONLY for a MARKER constraint (`_is_marker_trait`).
  //     `impl(generic(T : Type), where(T <: Send), *(T), Send())` says `*(T)`
  //     is Send *iff* `T` is; ignoring the clause made
  //     `Type.impls(*(NonSend), Send)` — and `Array(NonSend, 4)`, `?*NonSend`
  //     — answer `true`, letting non-Send data cross a thread boundary. See
  //     `issues/fixed/type-impls-reports-true-for-a-blanket-impl-whose-where-clause-fails.md`.
  //     A load-order false negative here costs a `false` from a PREDICATE,
  //     which the auto-derive / registry / builtin steps ahead of step 8
  //     already answer for the common types; it cannot silently delete a
  //     method the way the dispatch path can.
  //
  //     The marker restriction is NOT conservatism for its own sake — a
  //     NON-marker constraint cannot be answered from what is stored here.
  //     The trait was evaluated at IMPL-REGISTRATION time, so `where(T <:
  //     Eq(T))` is stored as `Eq(SomeT(T))` — a trait built for the impl's
  //     own type PARAMETER, with a `Rhs`-specialized id (`Eq` is a comptime
  //     fn returning a fresh `Trait` per `Rhs`). MEASURED: asked as-is even
  //     `i32 <: Eq(SomeT(T))` is false, so enforcing it would delete the
  //     whole `Option(T)`/`Eq` and `Option(T)`/`Ord` family from the
  //     predicate (the over-rejection canary in tests/basic.test.yo caught
  //     exactly that). `substitute()` cannot repair it either — its TraitT
  //     arm rewrites field types but KEEPS the trait id, which is what the
  //     registry is keyed on. A MARKER (`Send`, `Comptime`, `Runtime`,
  //     `Acyclic`) mentions no type variable anywhere in its members, so the
  //     stored value IS the trait to ask about and the answer is exact.
  //     Non-marker bounds therefore stay on the old ignore-the-clause
  //     behaviour; closing that half needs the constraint's source EXPR
  //     re-evaluated against the bindings, not a stored TypeValue.
  //
  // TS enforces all — its predicate is complete; this split is the safe
  // yo-self adaptation. The BINDINGS, however, are taken for every impl.
  //
  // In every mode an UNBOUND where-param (`_resolve_one_forall_binding` →
  // `.None`, i.e. the clause could not be discharged because the param never
  // got a concrete binding — a def-time trial over an unresolved SomeT, say)
  // is NOT a rejection: only a param that IS bound and demonstrably fails
  // its trait removes the impl.
  (match_env : Environment) = synth_result.expected_env;
  (wc_ok : bool) = true;
  {
    (wcj : usize) = usize(0);
    n_wcj := entry.where_constraint_some_types.len();
    while((wcj < n_wcj) && wc_ok, {
      wcj_some := match(entry.where_constraint_some_types.get(wcj), .Some(sm) => sm, .None => t_unit());
      wcj_trait := match(entry.where_constraint_traits.get(wcj), .Some(tr) => tr, .None => t_unit());
      wcj_name := match(wcj_some, .SomeT(_, nm, _, _, _, _, _, _, _, _, _) => nm, _ => ``);
      match(
        _resolve_one_forall_binding(match_env, wcj_some, wcj_name),
        .Some(wcj_bound) => match(
          g_type_implements_trait_full_fn,
          .Some(wcj_f) => {
            // The adapter writes the post-constraint bindings into match_env
            // IN PLACE (env.frames swap) — see the hook's doc above.
            wcj_impl := wcj_f(wcj_bound, wcj_trait, match_env);
            if(!wcj_impl && (
              (enforce_all_where && _is_marker_trait(wcj_trait))
              || is_some_type(entry.receiver_type_pattern)
            ), {
              wc_ok = false;
            });
          },
          .None => ()
        ),
        .None => ()
      );
      wcj = (wcj + usize(1));
    });
  };
  if(!wc_ok, {
    return(Option(ArrayList(TypeValue)).None);
  });
  // Synthesis succeeded — collect the concrete binding for each generic param
  // (in declaration order). If any param stayed abstract, there is no match.
  bindings := ArrayList(TypeValue).new();
  g_last_match_binding_vals.clear();
  (all_bound : bool) = true;
  (vi : usize) = usize(0);
  while((vi < n_forall) && all_bound, {
    fa_name2 := match(entry.forall_names.get(vi), .Some(n) => n, .None => String.from(""));
    fa_some2 := match(entry.forall_some_types.get(vi), .Some(s) => s, .None => t_unit());
    // VALUE side-channel (see g_last_match_binding_vals): a value binder's
    // IntLit lives on the env var the synthesizer bound; record it
    // index-aligned with `bindings`.
    (fa_val2 : EvalValue) = EvalValue.UnitVal;
    {
      fv_vars := get_variables_from_env(match_env, fa_name2);
      if(fv_vars.len() > usize(0), {
        match(
          fv_vars.get(fv_vars.len() - usize(1)),
          .Some(fv_var) => match(
            fv_var.value.get(usize(0)),
            .Some(fv_v) => match(
              fv_v,
              .IntLit(fv_raw) => {
                fa_val2 = EvalValue.IntLit(fv_raw.clone());
              },
              _ => ()
            ),
            .None => ()
          ),
          .None => ()
        );
      });
    };
    match(
      _resolve_one_forall_binding(match_env, fa_some2, fa_name2),
      .Some(t) => {
        _b := bindings.push(t);
        g_last_match_binding_vals.push(fa_val2);
      },
      .None => {
        // Structural field synthesis left this param abstract: the receiver
        // pattern erases it from its fields (e.g. `Buf(T)` = `object(_n :
        // usize)` — T never appears structurally). Recover the binding from
        // the concrete instantiation's `type_arguments` (yo-self's faithful
        // stand-in for TS `StructType.env`; mirrors the env fallback in
        // impl.ts:2290-2331, which reads `concreteType.env`).
        match(
          _bind_forall_from_type_args(entry.receiver_type_pattern, resolved_concrete, fa_some2),
          .Some(t2) => {
            _b2 := bindings.push(t2);
            g_last_match_binding_vals.push(EvalValue.UnitVal);
          },
          .None => {
            // THIRD recovery — through a where-constraint's ASSOCIATED-TYPE
            // binding: a forall that appears ONLY as `Trait(Item := A)` in
            // the entry's where clause (the bare-`I` blanket's `A`) is
            // normally bound by the where-pass's FULL trait check, but a
            // REPEAT check of the same (subject, trait) pair can satisfy the
            // enforcement through registered/marker short-circuits that do
            // not re-synthesize `A` (3-deep chained combinators:
            // `IterTake(IterSkip(MyRange))`, iterator_combinators arms
            // 16-18). Recover it directly: find the assoc label tied to this
            // forall, resolve the bound where-SUBJECT's assoc type from the
            // generic-impl registry, and bind that.
            (wcr_bound : Option(TypeValue)) = Option(TypeValue).None;
            {
              (wcr_j : usize) = usize(0);
              n_wcr := entry.where_constraint_traits.len();
              while((wcr_j < n_wcr) && wcr_bound.is_none(), {
                wcr_trait := match(entry.where_constraint_traits.get(wcr_j), .Some(t) => t, .None => t_unit());
                wcr_subj := match(entry.where_constraint_some_types.get(wcr_j), .Some(t) => t, .None => t_unit());
                match(
                  wcr_trait,
                  .TraitT(_, _, _, _, _, _, _, _, wcr_alabels, wcr_atypes) => {
                    (wcr_k : usize) = usize(0);
                    while((wcr_k < wcr_alabels.len()) && wcr_bound.is_none(), {
                      wcr_cty := match(wcr_atypes.get(wcr_k), .Some(t) => t, .None => t_unit());
                      wcr_is_this_forall := match(
                        wcr_cty,
                        .SomeT(name : wcr_cnm) => (wcr_cnm == fa_name2),
                        _ => false
                      );
                      if(wcr_is_this_forall, {
                        wcr_lbl := match(wcr_alabels.get(wcr_k), .Some(l) => l, .None => String.new());
                        wcr_subj_nm := match(wcr_subj, .SomeT(name : wsn) => wsn, _ => String.new());
                        match(
                          _resolve_one_forall_binding(match_env, wcr_subj, wcr_subj_nm),
                          .Some(wcr_subj_bound) => {
                            // Registry first: the durable assoc registration
                            // (tmgi success tail above) stores the subject's
                            // resolved assoc types; the generic-impl finder
                            // below re-runs tmgi and fails on exactly the
                            // repeat paths this recovery exists for.
                            {
                              wcr_tid := type_id_or_empty(wcr_subj_bound);
                              if(wcr_tid.len() > usize(0), {
                                wcr_regs := get_type_trait_methods_by_name(wcr_tid, wcr_lbl.clone());
                                (wcr_ri : usize) = usize(0);
                                while((wcr_ri < wcr_regs.len()) && wcr_bound.is_none(), {
                                  match(
                                    wcr_regs.get(wcr_ri),
                                    .Some(wcr_re) => match(
                                      wcr_re.value,
                                      .Some(wcr_rev) => match(
                                        wcr_rev,
                                        .TypeVal(wcr_ret) => if(!is_some_type(wcr_ret), {
                                          wcr_bound = Option(TypeValue).Some(wcr_ret);
                                        }),
                                        _ => ()
                                      ),
                                      .None => ()
                                    ),
                                    .None => ()
                                  );
                                  wcr_ri = (wcr_ri + usize(1));
                                });
                              });
                            };
                            match(
                              g_find_assoc_from_impls_fn,
                              .Some(wcr_f) => if(wcr_bound.is_none(), {
                                match(
                                  wcr_f(wcr_subj_bound, wcr_lbl, match_env),
                                  .Some(wcr_res) => if(!is_some_type(wcr_res), {
                                    wcr_bound = Option(TypeValue).Some(wcr_res);
                                  }),
                                  .None => ()
                                );
                              }),
                              .None => ()
                            );
                          },
                          .None => ()
                        );
                      });
                      wcr_k = (wcr_k + usize(1));
                    });
                  },
                  _ => ()
                );
                wcr_j = (wcr_j + usize(1));
              });
            };
            match(
              wcr_bound,
              .Some(wcr_t) => {
                _b3 := bindings.push(wcr_t);
                g_last_match_binding_vals.push(EvalValue.UnitVal);
              },
              .None => {
                all_bound = false;
              }
            );
          }
        );
      }
    );
    vi = (vi + usize(1));
  });
  // DURABLE assoc-type registration at first success (TS model: impl fields
  // live ON the type). A repeat full trait check of the same (record, trait)
  // pair can satisfy enforcement through registered/marker short-circuits
  // that never re-run the where-pass binding synthesis, so the impl's
  // where-only foralls (`A` in `Iterator(Item := A)`) stay unbound on
  // repeat paths (iterator_combinators arms 16-18, the 3-deep chains).
  // Registering the SUBSTITUTED, fully-concrete associated types under the
  // record's type id lets every later resolution channel (step-4 assoc
  // check, find_associated_type_from_generic_impls step 1, my wcr recovery)
  // read them from the registry directly. Concrete-only + deduped.
  // DEF-time trials must not make DURABLE registrations: a trial-time
  // abstract match (the trial-scoped acceptance above) registering assoc
  // types under the trial receiver's id redirected BATCH-time resolution —
  // tests/collections/btree_map.test.yo's main lost the `for(m.iter())`
  // closure arg's ExprInfo (repair 1 of
  // issues/fixed/def-eval-swallow-remaining-roots.md).
  if(all_bound && !in_def_time_trial(), {
    dar_tid := type_id_or_empty(resolved_concrete);
    if(dar_tid.len() > usize(0), {
      dar_s := subst_new();
      (dar_i : usize) = usize(0);
      while(dar_i < entry.forall_names.len(), {
        dar_name := match(entry.forall_names.get(dar_i), .Some(n) => n, .None => String.new());
        dar_some := match(entry.forall_some_types.get(dar_i), .Some(s2) => s2, .None => t_unit());
        dar_ty := match(bindings.get(dar_i), .Some(t) => t, .None => t_unit());
        match(
          dar_some,
          .SomeT(_, _, dar_lvl, _, _, _, _, _, _, _, _) => subst_add(dar_s, dar_name, dar_lvl, dar_ty),
          _ => ()
        );
        dar_i = (dar_i + usize(1));
      });
      subst_set_self(dar_s, entry.receiver_type_pattern, resolved_concrete);
      (dar_fi : usize) = usize(0);
      while(dar_fi < entry.field_names.len(), {
        dar_lbl := match(entry.field_names.get(dar_fi), .Some(l) => l, .None => String.new());
        dar_fty := match(entry.field_types.get(dar_fi), .Some(t) => t, .None => t_unit());
        if((dar_lbl.len() > usize(0)) && !is_function_type(dar_fty), {
          match(
            entry.field_values.get(dar_fi),
            .Some(dar_fv) => match(
              dar_fv,
              .TypeVal(dar_tvb) => {
                dar_res := substitute(dar_s, dar_tvb);
                if((get_all_some_types(dar_res).len() == usize(0)) && !is_some_type(dar_res), {
                  if(get_type_trait_methods_by_name(dar_tid.clone(), dar_lbl.clone()).len() == usize(0), {
                    register_type_trait_method(
                      dar_tid.clone(),
                      MethodEntry(
                        label : dar_lbl.clone(),
                        ty : t_type(),
                        value : Option(EvalValue).Some(create_type_value(dar_res)),
                        source_trait_id : get_base_trait_key(entry.trait_type),
                        needs_pointer_conversion : false,
                        self_type : Option(TypeValue).None
                      )
                    );
                  });
                });
              },
              _ => ()
            ),
            .None => ()
          );
        });
        dar_fi = (dar_fi + usize(1));
      });
    });
  });
  if(impl_dbg_env.get(`YO_DEBUG_DISPATCH`).is_some(), {
    eprintln(`[tm-end] recv=${type_id_or_empty(resolved_concrete)} pat=${type_id_or_empty(entry.receiver_type_pattern)} all_bound=${all_bound.to_string()}`);
  });
  cond(
    all_bound => Option(ArrayList(TypeValue)).Some(bindings),
    true => Option(ArrayList(TypeValue)).None
  )
});
/// Check if any registered generic impl matches (concrete_type, trait_type, env).
/// Returns true if a match is found.
///
/// Mirrors `findMatchingGenericImpl` in impl.ts (boolean result only).
find_matching_generic_impl :: (
  fn(
    concrete_type : TypeValue,
    trait_type : TypeValue,
    env : Environment
  ) -> bool
)({
  key := get_base_trait_key(trait_type);
  if(key.is_empty(), {
    return(false);
  });
  // Find the entry list for this key.
  (entry_list_opt : Option(ArrayList(GenericImplEntry))) =
    Option(ArrayList(GenericImplEntry)).None;
  (ki : usize) = usize(0);
  (n_keys : usize) = g_impl_registry_keys.len();
  while(ki < n_keys, {
    k := match(g_impl_registry_keys.get(ki), .Some(k) => k, .None => String.from(""));
    if(k == key, {
      entry_list_opt = g_impl_registry_entry_lists.get(ki);
      ki = n_keys; // break
    });
    ki = (ki + usize(1));
  });
  (entries : ArrayList(GenericImplEntry)) = match(
    entry_list_opt,
    .Some(l) => l,
    .None => {
      return(false);
    }
  );
  (n_entries : usize) = entries.len();
  (ei : usize) = usize(0);
  while(ei < n_entries, {
    entry := match(
      entries.get(ei),
      .Some(e) => e,
      .None => {
        ei = (ei + usize(1));
        continue;
      }
    );
    // `true`: this is the TRAIT PREDICATE (`type_implements_trait` step 8), so
    // a constructed pattern's MARKER where-clause is enforced — see the pass
    // in `try_match_generic_impl`.
    if(try_match_generic_impl(concrete_type, entry, env, true).is_some(), {
      return(true);
    });
    ei = (ei + usize(1));
  });
  false
});
/// Negative generic impl registry. Mirrors TS `negativeGenericImplRegistry`
/// (impl.ts:286): holds `impl(generic(...), Pattern, !(Trait))` entries (reusing
/// `GenericImplEntry`, with empty field_* lists — negative impls carry no
/// methods). Checked as step 0 of `type_implements_trait` so a matching negative
/// generic impl overrides auto-derive (e.g. `impl(generic(T), Container(T),
/// !(Send))` makes `Container(i32)` NOT `Send`).
(g_negative_generic_impl_entries : ArrayList(GenericImplEntry)) =
  ArrayList(GenericImplEntry).new();
register_negative_generic_impl :: (fn(entry : GenericImplEntry) -> unit)({
  g_negative_generic_impl_entries.push(entry);
});
/// Returns true if some registered negative generic impl for `trait_type`
/// matches `concrete_type`. Mirrors TS `findMatchingNegativeGenericImpl`
/// (impl.ts:296): filter by trait key, then `try_match_generic_impl`.
find_matching_negative_generic_impl :: (
  fn(concrete_type : TypeValue, trait_type : TypeValue, env : Environment) -> bool
)({
  key := get_trait_key(trait_type);
  if(key.is_empty(), {
    return(false);
  });
  (n : usize) = g_negative_generic_impl_entries.len();
  (i : usize) = usize(0);
  (found : bool) = false;
  while((i < n) && !found, {
    entry := match(
      g_negative_generic_impl_entries.get(i),
      .Some(e) => e,
      .None => {
        i = (i + usize(1));
        continue;
      }
    );
    if(entry.trait_key == key, {
      // `false`: a negative impl REMOVES a trait, so tightening its match
      // would loosen the predicate — the opposite direction. Unchanged.
      if(try_match_generic_impl(concrete_type, entry, env, false).is_some(), {
        found = true;
      });
    });
    i = (i + usize(1));
  });
  found
});
/// A method (field) from a matched generic impl.
///
/// `source_trait_id` carries the trait id whose generic-impl
/// entry produced this candidate — same value as the registry
/// key (`GenericImplEntry.trait_key`). The adapter that converts
/// `MethodCandidate -> MethodEntry`
/// (`_find_methods_from_generic_impls_as_method_entries`) threads
/// this through so call-site code can disambiguate which trait
/// contributed a method.
MethodCandidate :: struct(
  method_type : TypeValue,
  method_value : Option(EvalValue),
  source_trait_id : String
);
// Memo for `_inject_forall_captures`: injections are ~99% duplicates (a
// 150k-call probe saw 1,259 distinct (func_id, bindings) keys), and each
// miss copies the method's full capture arrays (avg ~600 entries). Keying
// on func_id + binding type_keys + value-binder raws collapses ~167k
// RETAINED copies (3.87 GB live in a self-emit) to the distinct set.
// Sharing the injected FuncVal is also the TS-faithful shape: TS restores
// the impl's env object (`func.$.env`) at dispatch and copies nothing.
(g_ifc_memo : HashMap(String, EvalValue)) = HashMap(String, EvalValue).new();
/// Inject the impl's `generic` type-param bindings into a matched method's
/// closure captures, so the method body resolves `K`, `V`, … to the
/// receiver's concrete type arguments. Mirrors TS restoring the impl's
/// instantiation env (`func.$.env`) at dispatch: impl methods carry no
/// `generic` of their own (the `generic(K, V)` lives on the impl block), so the
/// regular call path — which only binds a method's *own* generic params — would
/// otherwise leave `K`/`V` abstract and break e.g. `sizeof(MapEntry(K, V))`.
///
/// Only `FuncVal` methods are affected; associated-type and other field shapes
/// pass through unchanged. The existing capture arrays are COPIED (never
/// mutated) so the registry entry stays reusable across instantiations.
_inject_forall_captures :: (
  fn(
    method_val : Option(EvalValue),
    forall_names : ArrayList(String),
    bindings : ArrayList(TypeValue),
    binding_vals : ArrayList(EvalValue)
  ) -> Option(EvalValue)
)(
  match(
    method_val,
    .None => method_val,
    .Some(mv) => match(
      mv,
      .FuncVal(__fvm9, cvs) => {
        fns := __fvm9.*.forall_names;
        ps := __fvm9.*.params;
        ptns := __fvm9.*.param_type_names;
        evs := __fvm9.*.evidence_params;
        body := __fvm9.*.body;
        cns := __fvm9.*.cap_names;
        cts := __fvm9.*.cap_tys;
        fid := __fvm9.*.func_id;
        ifc_orig_env_key := __fvm9.*.env_key;
        memo_key := fid.clone();
        {
          (mk_i : usize) = usize(0);
          while(mk_i < bindings.len(), {
            memo_key.push_str("|");
            memo_key.push_string(type_key(match(bindings.get(mk_i), .Some(t) => t, .None => t_unit())));
            mk_i = (mk_i + usize(1));
          });
          (mk_v : usize) = usize(0);
          while(mk_v < binding_vals.len(), {
            match(
              binding_vals.get(mk_v),
              .Some(bv) => match(
                bv,
                .IntLit(bv_r) => {
                  memo_key.push_str("#");
                  memo_key.push_string(bv_r.clone());
                },
                _ => ()
              ),
              .None => ()
            );
            mk_v = (mk_v + usize(1));
          });
        };
        match(
          g_ifc_memo.get(memo_key.clone()),
          .Some(cached) => Option(EvalValue).Some(cached),
          .None => {
            new_cns := ArrayList(String).new();
            new_cts := ArrayList(TypeValue).new();
            new_cvs := ArrayList(EvalValue).new();
            // Campaign 2 step 3: inherit the shared handle list; the
            // per-generic bindings appended below get minted capture
            // Variables (plans/FUNCVAL_ENV_SHARING.md).
            new_cvars := ArrayList(Variable).new();
            (ifc_env_key : usize) = usize(0);
            (ifc_have_vars : bool) = false;
            match(
              get_funcval_cap_vars(ifc_orig_env_key),
              .Some(pv) => {
                ifc_have_vars = true;
                (pvj : usize) = usize(0);
                while(pvj < pv.len(), {
                  match(
                    pv.get(pvj),
                    .Some(ph) => {
                      new_cvars.push(ph);
                    },
                    .None => ()
                  );
                  pvj = (pvj + usize(1));
                });
              },
              .None => ()
            );
            // Copy existing captures (do not mutate the registry's arrays).
            (ci : usize) = usize(0);
            while(ci < cns.len(), {
              _a := new_cns.push(match(cns.get(ci), .Some(x) => x, .None => String.from("")));
              _b := new_cts.push(match(cts.get(ci), .Some(x) => x, .None => t_unit()));
              _c := new_cvs.push(match(cvs.get(ci), .Some(x) => x, .None => EvalValue.UnitVal));
              ci = (ci + usize(1));
            });
            // Append one capture per impl generic param (bound to its concrete type).
            n_fa := forall_names.len();
            (fi2 : usize) = usize(0);
            while(fi2 < n_fa, {
              fa_n := match(forall_names.get(fi2), .Some(n) => n, .None => String.from(""));
              fa_t := match(bindings.get(fi2), .Some(t) => t, .None => t_unit());
              _a2 := new_cns.push(fa_n);
              // VALUE binder (`generic(U : usize)`): inject the VALUE (IntLit)
              // at its declared type — injecting TypeVal(usize) made the body's
              // `U` a TYPE (the array-family "expected usize, got Type").
              (fa_is_val : bool) = false;
              match(
                binding_vals.get(fi2),
                .Some(bv) => match(
                  bv,
                  .IntLit(bv_raw) => {
                    fa_is_val = true;
                    _b2v := new_cts.push(t_usize());
                    _c2v := new_cvs.push(EvalValue.IntLit(bv_raw.clone()));
                    if(ifc_have_vars, {
                      new_cvars.push(make_capture_variable(fa_n.clone(), t_usize(), Option(EvalValue).Some(EvalValue.IntLit(bv_raw.clone())), String.from("")));
                    });
                  },
                  _ => ()
                ),
                .None => ()
              );
              if(!fa_is_val, {
                _b2 := new_cts.push(t_type());
                _c2 := new_cvs.push(EvalValue.TypeVal(fa_t));
                if(ifc_have_vars, {
                  new_cvars.push(make_capture_variable(fa_n.clone(), t_type(), Option(EvalValue).Some(EvalValue.TypeVal(fa_t)), String.from("")));
                });
              });
              fi2 = (fi2 + usize(1));
            });
            if(ifc_have_vars, {
              ifc_env_key = mint_funcval_env_key();
              register_funcval_cap_vars(ifc_env_key, new_cvars);
            });
            injected := EvalValue.FuncVal(box(FuncValData(forall_names : fns, params : ps, param_type_names : ptns, evidence_params : evs, body : body, cap_names : new_cns, cap_tys : new_cts, func_id : fid, env_key : ifc_env_key)), new_cvs);
            _memo := g_ifc_memo.insert(memo_key, injected);
            Option(EvalValue).Some(injected)
          }
        )
      },
      _ => method_val
    )
  )
);
/// Search ALL registered generic impls for matching entries that have a field
/// with `method_name`. Returns candidates, with the impl's `generic` bindings
/// injected into each `FuncVal` method's captures (see `_inject_forall_captures`).
find_methods_from_generic_impls :: (
  fn(
    concrete_type : TypeValue,
    method_name : String,
    env : Environment
  ) -> ArrayList(MethodCandidate)
)({
  results := ArrayList(MethodCandidate).new();
  // Resolve SomeT.
  (resolved : TypeValue) = concrete_type;
  if(is_some_type(concrete_type), {
    r := get_value_of_some_type_from_env(env, concrete_type);
    if(!is_some_type(r), {
      resolved = r;
    });
  });
  // Iterate all key buckets.
  n_keys := g_impl_registry_keys.len();
  if(method_name == "index", {
  });
  (ki : usize) = usize(0);
  while(ki < n_keys, {
    // No `continue` in these registry loops — see
    // issues/codegen-continue-in-while-heap-corruption.md.
    entry_list := match(
      g_impl_registry_entry_lists.get(ki),
      .Some(l) => l,
      .None => ArrayList(GenericImplEntry).new()
    );
    n_entries := entry_list.len();
    (ei : usize) = usize(0);
    while(ei < n_entries, {
      entry := match(
        entry_list.get(ei),
        .Some(e) => e,
        .None => {
          ei = (ei + usize(1));
          continue;
        }
      );
      // Cheap pre-filter: skip entries that don't even carry a field with
      // this name BEFORE attempting the receiver match — semantics are
      // identical (a non-name-matching entry contributes no candidates),
      // but `try_match_generic_impl` is expensive (env build + a fresh
      // frame + full type synthesis per entry), and the registry grows
      // with every loaded module, so a directory-wide `check` paid that
      // cost for every miss × every entry.
      (has_field_with_name : bool) = false;
      {
        n_pf := entry.field_names.len();
        (pfi : usize) = usize(0);
        while((pfi < n_pf) && !has_field_with_name, {
          match(
            entry.field_names.get(pfi),
            .Some(pfn) => if(pfn == method_name, {
              has_field_with_name = true;
            }),
            .None => ()
          );
          pfi = (pfi + usize(1));
        });
      };
      // if/else rather than an early `continue` — see
      // issues/codegen-continue-in-while-heap-corruption.md (`continue`
      // after an Rc-bound local in a while body miscompiles; this is the
      // hottest loop in the evaluator).
      if(!has_field_with_name, {
        ei = (ei + usize(1));
      }, {
        mb_opt := try_match_generic_impl(resolved, entry, env, false);
        if(in_def_time_trial() && impl_dbg_env.get(`YO_DEBUG_DISPATCH`).is_some() && (method_name == "add"), {
          eprintln(`[fmg-try] name=${method_name} recv=${type_to_string(resolved)} pat=${type_to_string(entry.receiver_type_pattern)} matched=${mb_opt.is_some().to_string()}`);
        });
        if(mb_opt.is_none(), {
          ei = (ei + usize(1));
        }, {
          match_bindings := match(mb_opt, .Some(b) => b, .None => ArrayList(TypeValue).new());
          // Snapshot the value side-channel before anything can clobber it.
          match_binding_vals := ArrayList(EvalValue).new();
          {
            (mbv_i : usize) = usize(0);
            while(mbv_i < g_last_match_binding_vals.len(), {
              match(
                g_last_match_binding_vals.get(mbv_i),
                .Some(mbv) => match(
                  mbv,
                  .IntLit(mbv_raw) => {
                    match_binding_vals.push(EvalValue.IntLit(mbv_raw.clone()));
                  },
                  _ => {
                    match_binding_vals.push(EvalValue.UnitVal);
                  }
                ),
                .None => {
                  match_binding_vals.push(EvalValue.UnitVal);
                }
              );
              mbv_i = (mbv_i + usize(1));
            });
          };
          // Found a matching impl — search for the method field.
          n_fields := entry.field_names.len();
          (fi : usize) = usize(0);
          while(fi < n_fields, {
            fname := match(
              entry.field_names.get(fi),
              .Some(n) => n,
              .None => String.from("")
            );
            if(fname == method_name, {
              ftype := match(
                entry.field_types.get(fi),
                .Some(t) => t,
                .None => TypeValue.Unit
              );
              fvalue := entry.field_values.get(fi);
              // Specialize the method TYPE with the impl's generic bindings —
              // mirrors TS `reEvaluateFunctionType` in `findMethodsFromGenericImpls`
              // (impl.ts:1484): the returned candidate's param/return types must
              // be concrete (e.g. `self : ComptimeList(comptime_str)`, not
              // `ComptimeList(T)`) so the call-site parameter check compares
              // concrete types directly instead of relying on call-time SomeT
              // synthesis, whose frame levels are stale at the call site — the
              // same reason `_substitute_self_in_method_ty` exists.
              spec_s := subst_new();
              // Collect the method type's OWN SomeT instances once: a forall
              // name can appear at DIFFERENT frame levels inside one method
              // type (the pointer-arithmetic impl's `add` carries `*(T)`
              // params at the impl forall's level but a return `*(T)` minted
              // at another — `[fmg-cand]` showed the param substituted and
              // the return left RAW, whose stale-level `T` then resolved
              // against the receiver at the call site: `*(*(T))`, root 537
              // of issues/fixed/def-eval-swallow-remaining-roots.md). Substitute
              // every same-NAME occurrence at its own level — the forall
              // twin of _substitute_self_in_method_ty's "EVERY Self at its
              // OWN frame level" rule above.
              ft_all_somes := get_all_some_types(ftype);
              (sb_i : usize) = usize(0);
              while(sb_i < entry.forall_names.len(), {
                sb_name := match(entry.forall_names.get(sb_i), .Some(n) => n, .None => String.from(""));
                sb_some := match(entry.forall_some_types.get(sb_i), .Some(s2) => s2, .None => t_unit());
                sb_ty := match(match_bindings.get(sb_i), .Some(t) => t, .None => t_unit());
                match(
                  sb_some,
                  .SomeT(_, _, lvl, _, _, _, _, _, _, _, _) => {
                    subst_add(spec_s, sb_name, lvl, sb_ty);
                    (fts_i : usize) = usize(0);
                    while(fts_i < ft_all_somes.len(), {
                      match(
                        ft_all_somes.get(fts_i),
                        .Some(fts_t) => match(
                          fts_t,
                          .SomeT(_, fts_n, fts_lvl, _, _, _, _, _, _, _, _) => if((fts_n == sb_name) && (fts_lvl != lvl), {
                            subst_add(spec_s, sb_name, fts_lvl, sb_ty);
                          }),
                          _ => ()
                        ),
                        .None => ()
                      );
                      fts_i = (fts_i + usize(1));
                    });
                  },
                  _ => ()
                );
                sb_i = (sb_i + usize(1));
              });
              // Bind `Self` to the CONCRETE RECEIVER — port of TS
              // `substitutions.insert("Self", concreteType)` (impl.ts:2474),
              // consumed by `reEvaluateFunctionType(..., SelfType)`
              // (impl.ts:1494-1498). Pass the pattern UN-SUBSTITUTED: `Self`
              // was baked into `ftype` as the receiver pattern verbatim
              // (impl.yo:1643) and the walk tests each node BEFORE
              // substituting it, so substituting the key first makes the
              // exact-equality test compare EnumT(id, Some(T)) against
              // EnumT(id, Some(Node)) and silently never fire.
              subst_set_self(spec_s, entry.receiver_type_pattern, resolved);
              fmg_spec_ty := substitute(spec_s, ftype);
              if(impl_dbg_env.get(`YO_DEBUG_DISPATCH`).is_some(), {
                eprintln(`[fmg-cand] method=${method_name} recv=${type_to_string(resolved)} raw=${type_to_string(ftype)} spec=${type_to_string(fmg_spec_ty)} trial=${in_def_time_trial().to_string()}`);
              });
              results.push(
                MethodCandidate(
                  method_type : fmg_spec_ty,
                  method_value : _inject_forall_captures(fvalue, entry.forall_names, match_bindings, match_binding_vals),
                  source_trait_id : entry.trait_key.clone()
                )
              );
            });
            fi = (fi + usize(1));
          });
          ei = (ei + usize(1));
        });
      });
    });
    ki = (ki + usize(1));
  });
  results
});
/// Find an associated type from generic impls for a concrete type — e.g.
/// resolve `Item` for a type whose `Iterator` comes from
/// `impl(generic(T, N), _ArrayIter(T, N), Iterator(Item : T, ...))`.
///
/// Mirrors `findAssociatedTypeFromGenericImpls` in
/// `src/evaluator/values/impl.ts:1911`.
///
/// Adaptation: TS re-evaluates the impl's trait-type ARG EXPRESSION
/// (`impl.traitTypeArgExprs[i]`) in an env carrying the matched substitutions.
/// yo-self stores impl fields already EVALUATED (`entry.field_values`), so the
/// equivalent is `substitute()` of the matched bindings into the stored
/// `TypeVal` — the same mechanism `find_methods_from_generic_impls` uses to
/// specialize method types lazily.
find_associated_type_from_generic_impls :: (
  fn(
    concrete_type : TypeValue,
    property_name : String,
    env : Environment
  ) -> Option(TypeValue)
)({
  // Resolve SomeT.
  (resolved : TypeValue) = concrete_type;
  if(is_some_type(concrete_type), {
    r := get_value_of_some_type_from_env(env, concrete_type);
    if(!is_some_type(r), {
      resolved = r;
    });
  });
  (found : Option(TypeValue)) = Option(TypeValue).None;
  // Iterate all key buckets (TS: `genericImplRegistry.entries()`).
  n_keys := g_impl_registry_keys.len();
  (ki : usize) = usize(0);
  while((ki < n_keys) && found.is_none(), {
    // No `continue` in these registry loops — see
    // issues/codegen-continue-in-while-heap-corruption.md.
    entry_list := match(
      g_impl_registry_entry_lists.get(ki),
      .Some(l) => l,
      .None => ArrayList(GenericImplEntry).new()
    );
    n_entries := entry_list.len();
    (ei : usize) = usize(0);
    while((ei < n_entries) && found.is_none(), {
      (entry_opt : Option(GenericImplEntry)) = entry_list.get(ei);
      match(
        entry_opt,
        .Some(entry) => {
          // Pre-filter: a NON-FUNCTION field with this name must exist
          // (TS: `fields.findIndex(f => f.label === propertyName &&
          // !isFunctionType(f.type))`). Cheap check before the expensive
          // `try_match_generic_impl`.
          (field_idx : usize) = usize(0);
          (has_field : bool) = false;
          n_pf := entry.field_names.len();
          (pfi : usize) = usize(0);
          while((pfi < n_pf) && !has_field, {
            name_matches := match(
              entry.field_names.get(pfi),
              .Some(pfn) => (pfn == property_name),
              .None => false
            );
            if(name_matches, {
              ty_is_fn := match(
                entry.field_types.get(pfi),
                .Some(ft) => is_function_type(ft),
                .None => true
              );
              if(!ty_is_fn, {
                has_field = true;
                field_idx = pfi;
              });
            });
            pfi = (pfi + usize(1));
          });
          if(has_field, {
            mb_opt := try_match_generic_impl(resolved, entry, env, false);
            match(
              mb_opt,
              .Some(match_bindings) => {
                // Substitute the impl's generic bindings into the stored
                // associated-type value.
                fvalue_opt := entry.field_values.get(field_idx);
                match(
                  fvalue_opt,
                  .Some(fvalue) => match(
                    fvalue,
                    .TypeVal(tvb) => {
                      spec_s := subst_new();
                      (sb_i : usize) = usize(0);
                      while(sb_i < entry.forall_names.len(), {
                        sb_name := match(entry.forall_names.get(sb_i), .Some(n) => n, .None => String.from(""));
                        sb_some := match(entry.forall_some_types.get(sb_i), .Some(s2) => s2, .None => t_unit());
                        sb_ty := match(match_bindings.get(sb_i), .Some(t) => t, .None => t_unit());
                        match(
                          sb_some,
                          .SomeT(_, _, lvl, _, _, _, _, _, _, _, _) => subst_add(spec_s, sb_name, lvl, sb_ty),
                          _ => ()
                        );
                        sb_i = (sb_i + usize(1));
                      });
                      subst_set_self(spec_s, entry.receiver_type_pattern, resolved);
                      found = Option(TypeValue).Some(substitute(spec_s, tvb));
                    },
                    _ => ()
                  ),
                  .None => ()
                );
              },
              .None => ()
            );
          });
        },
        .None => ()
      );
      ei = (ei + usize(1));
    });
    ki = (ki + usize(1));
  });
  found
});
// Install the in-module forward hook (see g_find_assoc_from_impls_fn above
// try_match_generic_impl).
g_find_assoc_from_impls_fn = Option(FindAssocFromImplsFn).Some(find_associated_type_from_generic_impls);
// ---------------------------------------------------------------------------
// Generic-impl DOC entries — the `yo doc` builder's view of the registry.
// Mirrors `GenericImplDocEntry` / `formatGenericImplSignature` /
// `getGenericImplDocEntries` (src/evaluator/values/impl.ts:1788-1903).
// ---------------------------------------------------------------------------
/// One matched generic impl, formatted for documentation. TS carries
/// `methods: {name, type}[]`; yo-self splits it into the parallel
/// `method_names` / `method_types` arrays.
GenericImplDocEntry :: struct(
  signature : String,
  trait_name : Option(String),
  method_names : ArrayList(String),
  method_types : ArrayList(TypeValue)
);
/// Mirrors `getReceiverBaseTypeId` (impl.ts:1057): the constructor function id
/// when the type carries one (TS `functionValue.funcId`), else the type's own
/// `id`; "" when it has neither.
_receiver_base_type_id_for_doc :: (fn(t : TypeValue) -> String)(
  match(
    t,
    .Struct({ id, constructor_func_id }) => if(
      constructor_func_id.len() > usize(0),
      constructor_func_id.clone(),
      id.clone()
    ),
    .EnumT({ id }) => id.clone(),
    .TraitT({ id }) => id.clone(),
    .SomeT({ id }) => id.clone(),
    _ => String.from("")
  )
);
/// The nominal name of a named type, "" otherwise. Mirrors TS's
/// `"typeName" in type ? type.typeName : undefined` reads in the doc-entry walk.
_type_name_for_doc :: (fn(t : TypeValue) -> String)(
  match(
    t,
    .Struct({ name }) => name.clone(),
    .EnumT({ name }) => name.clone(),
    .Union({ name }) => name.clone(),
    .TraitT({ name }) => name.clone(),
    _ => String.from("")
  )
);
/// Mirrors `formatGenericImplSignature` (impl.ts:1795). TS distinguishes
/// type-kind forall params (`typeToString(param.someType.parentType)`) from
/// value-kind ones (`typeToString(param.type)`); yo-self keeps both as SomeT
/// whose `parent_type` IS that meta-type, so one arm covers both kinds.
_format_generic_impl_signature :: (fn(entry : GenericImplEntry) -> String)({
  parts := ArrayList(String).new();
  if(entry.forall_names.len() > usize(0), {
    fa_parts := ArrayList(String).new();
    (fi : usize) = usize(0);
    while(fi < entry.forall_names.len(), {
      fa_name := match(entry.forall_names.get(fi), .Some(n) => n, .None => String.from(""));
      fa_ty := match(
        entry.forall_some_types.get(fi),
        .Some(s) => match(
          s,
          .SomeT({ parent_type }) => type_to_string(parent_type),
          _ => type_to_string(s)
        ),
        .None => String.from("")
      );
      fa_parts.push(`${fa_name} : ${fa_ty}`);
      fi = (fi + usize(1));
    });
    parts.push(`generic(${String.from(", ").join(fa_parts)})`);
  });
  if(entry.where_constraint_some_types.len() > usize(0), {
    w_parts := ArrayList(String).new();
    (wi : usize) = usize(0);
    while(wi < entry.where_constraint_some_types.len(), {
      w_name := match(
        entry.where_constraint_some_types.get(wi),
        .Some(ws) => match(ws, .SomeT({ name }) => name.clone(), _ => type_to_string(ws)),
        .None => String.from("")
      );
      w_trait := match(
        entry.where_constraint_traits.get(wi),
        .Some(wt) => type_to_string(wt),
        .None => String.from("")
      );
      w_parts.push(`${w_name} <: ${w_trait}`);
      wi = (wi + usize(1));
    });
    parts.push(`where(${String.from(", ").join(w_parts)})`);
  });
  parts.push(type_to_string(entry.receiver_type_pattern));
  if(_type_name_for_doc(entry.trait_type).len() > usize(0), {
    parts.push(type_to_string(entry.trait_type));
  });
  `impl(${String.from(", ").join(parts)})`
});
/// Mirrors `getGenericImplDocEntries` (impl.ts:1830). `receiver_type_name` is
/// "" for TS's absent optional. Method lists come from the TRAIT type's fields
/// (TS reads `impl.traitType.fields`); yo-self stores an anonymous impl's
/// trait_type as Unit with the fields on the entry itself, so the non-TraitT
/// arm reads `entry.field_names` / `field_types` — the same members TS finds
/// on its synthesized anonymous TraitType.
get_generic_impl_doc_entries :: (
  fn(
    concrete_type : TypeValue,
    env : Environment,
    receiver_type_name : String
  ) -> ArrayList(GenericImplDocEntry)
)({
  (resolved : TypeValue) = concrete_type;
  if(is_some_type(concrete_type), {
    r := get_value_of_some_type_from_env(env, concrete_type);
    if(!is_some_type(r), {
      resolved = r;
    });
  });
  results := ArrayList(GenericImplDocEntry).new();
  seen := ArrayList(String).new();
  concrete_base_id := _receiver_base_type_id_for_doc(resolved);
  concrete_name := _type_name_for_doc(resolved);
  wanted_name := if(receiver_type_name.len() > usize(0), receiver_type_name.clone(), concrete_name.clone());
  n_keys := g_impl_registry_keys.len();
  (ki : usize) = usize(0);
  while(ki < n_keys, {
    // No `continue` in these registry loops — see
    // issues/codegen-continue-in-while-heap-corruption.md.
    entry_list := match(
      g_impl_registry_entry_lists.get(ki),
      .Some(l) => l,
      .None => ArrayList(GenericImplEntry).new()
    );
    n_entries := entry_list.len();
    (ei : usize) = usize(0);
    while(ei < n_entries, {
      match(
        entry_list.get(ei),
        .Some(entry) => {
          (matched : bool) = try_match_generic_impl(resolved, entry, env, false).is_some();
          if(!matched && (concrete_base_id.len() > usize(0)), {
            if(_receiver_base_type_id_for_doc(entry.receiver_type_pattern) == concrete_base_id, {
              matched = true;
            });
          });
          if(!matched && (wanted_name.len() > usize(0)), {
            if(_type_name_for_doc(entry.receiver_type_pattern) == wanted_name, {
              matched = true;
            });
          });
          if(matched, {
            method_names := ArrayList(String).new();
            method_types := ArrayList(TypeValue).new();
            match(
              entry.trait_type,
              .TraitT({ field_labels, field_types }) => {
                (mi : usize) = usize(0);
                while(mi < field_labels.len(), {
                  m_label := match(field_labels.get(mi), .Some(l) => l, .None => String.from(""));
                  m_type := match(field_types.get(mi), .Some(t) => Option(TypeValue).Some(t), .None => Option(TypeValue).None);
                  match(
                    m_type,
                    .Some(mt) => if((m_label.len() > usize(0)) && is_function_type(mt), {
                      method_names.push(m_label.clone());
                      method_types.push(mt);
                    }),
                    .None => ()
                  );
                  mi = (mi + usize(1));
                });
              },
              _ => {
                (mi : usize) = usize(0);
                while(mi < entry.field_names.len(), {
                  m_label := match(entry.field_names.get(mi), .Some(l) => l, .None => String.from(""));
                  m_type := match(entry.field_types.get(mi), .Some(t) => Option(TypeValue).Some(t), .None => Option(TypeValue).None);
                  match(
                    m_type,
                    .Some(mt) => if((m_label.len() > usize(0)) && is_function_type(mt), {
                      method_names.push(m_label.clone());
                      method_types.push(mt);
                    }),
                    .None => ()
                  );
                  mi = (mi + usize(1));
                });
              }
            );
            signature := _format_generic_impl_signature(entry);
            // TS dedup key: `${signature}\0${methodNames.join("\0")}`.
            nul_sep := `\0`;
            key := `${signature}\0${nul_sep.join(method_names)}`;
            (already : bool) = false;
            (si : usize) = usize(0);
            while((si < seen.len()) && !already, {
              if(match(seen.get(si), .Some(s) => (s == key), .None => false), {
                already = true;
              });
              si = (si + usize(1));
            });
            if(!already, {
              seen.push(key.clone());
              trait_nm := _type_name_for_doc(entry.trait_type);
              (trait_name_opt : Option(String)) = Option(String).None;
              if(trait_nm.len() > usize(0), {
                trait_name_opt = Option(String).Some(trait_nm.clone());
              });
              results.push(
                GenericImplDocEntry(
                  signature : signature,
                  trait_name : trait_name_opt,
                  method_names : method_names,
                  method_types : method_types
                )
              );
            });
          });
        },
        .None => ()
      );
      ei = (ei + usize(1));
    });
    ki = (ki + usize(1));
  });
  results
});
/// Resolve a trait-name expression to its base `TraitT` TypeValue
/// by env lookup. Handles both atom names (e.g. `LogicalNot`) and
/// parametric trait shapes (`ComptimeAdd(comptime_int)` →
/// `ComptimeAdd`) by walking left through FnCall heads. Returns
/// `.None` when the resulting head isn't bound to a TraitT — that
/// case falls back to legacy "no expected_type" behavior.
_try_lookup_trait_type :: (
  fn(
    trait_expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> Option(TypeValue)
)({
  // Fast path: walk through `Trait(...)` / `Trait(A)(B)` etc. to reach
  // the leftmost atom and look it up directly. This succeeds for
  // non-parametric traits bound directly as a `TraitT` in the env.
  (head_expr : AstExpr) = trait_expr;
  (steps : usize) = usize(0);
  while(!ast_expr_is_atom(head_expr) && (steps < usize(32)), {
    head_expr = match(
      head_expr,
      .FnCall(_, fb, _, _, _) => fb,
      .Atom(_, _) => head_expr
    );
    steps = (steps + usize(1));
  });
  (atom_result : Option(TypeValue)) = Option(TypeValue).None;
  if(ast_expr_is_atom(head_expr), {
    name := ast_expr_token(head_expr).value;
    vars := get_variables_from_env(env, name);
    if(vars.len() > usize(0), {
      match(
        vars.get(vars.len() - usize(1)),
        .Some(last_v) => match(
          last_v.value.get(usize(0)),
          .Some(ev) => match(
            ev,
            .TypeVal(tb) => match(
              tb,
              .TraitT(_, _, _, _, _, _, _, _, _, _) => {
                atom_result = Option(TypeValue).Some(tb);
              },
              _ => ()
            ),
            _ => ()
          ),
          .None => ()
        ),
        .None => ()
      );
    });
  });
  // Honor the fast path ONLY when the constraint is a BARE atom
  // (`I <: Iterator`). For a CALL (`Iterator(Item := A)`), the leftmost-atom
  // walk found the base TraitT and silently DROPPED the application's
  // type/assoc-type arguments — the where-pass then checked `CountIter <:
  // Iterator` (vacuously true) instead of `CountIter <: Iterator(Item := A)`,
  // so the where-clause-only param `A` was never synthesized and the impl
  // never matched (issues/repros/v5_direct.yo). TS keeps the full constraint
  // trait AND its expr (impl.ts stores whereConstraints with traitExpr).
  if(atom_result.is_some() && ast_expr_is_atom(trait_expr), {
    return(atom_result);
  });
  // Parametric traits (e.g. `ComptimeEq(comptime_int)`) are produced by
  // CALLING a trait-constructor function — `ComptimeEq :: (fn(...) ->
  // comptime(Trait))(trait(...))` — so the leftmost atom resolves to the
  // constructor FuncVal, not a TraitT, and the fast path above yields
  // None. Evaluate the full trait expression to obtain the specialized
  // TraitT so impl method bodies (anonymous lambdas) get the correct
  // expected function type per field label. Without this, the lambda
  // falls back to `_synthesize_default_func_type`, which mints a fresh
  // SomeT named after each parameter label (e.g. `lhs`) — breaking the
  // later parameter type-compatibility check at the call site.
  evaluated := evaluate_expression_raw(trait_expr, env, ctx, exn);
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated)),
    .Some(info) => match(
      info.value,
      .Some(ev) => match(
        ev,
        .TypeVal(tb) => match(
          tb,
          .TraitT(_, _, _, _, _, _, _, _, _, _) => Option(TypeValue).Some(tb),
          _ => Option(TypeValue).None
        ),
        _ => Option(TypeValue).None
      ),
      .None => Option(TypeValue).None
    ),
    .None => Option(TypeValue).None
  )
});
/// Look up the type of a trait field by its label. Returns `.None` if
/// the trait value is `.None`, the type isn't a `TraitT`, or no field
/// matches the label. Used by `evaluate_module_value` to set
/// `ctx.expected_type` when evaluating method bodies in
/// `impl(T, Trait(name : value))`.
_trait_field_type_by_label :: (
  fn(trait_opt : Option(TypeValue), label : String) -> Option(TypeValue)
)(
  match(
    trait_opt,
    .None => Option(TypeValue).None,
    .Some(t) => match(
      t,
      .TraitT(_, _, labels, types, _, _, _, _, _, _) => {
        (i : usize) = usize(0);
        (found : Option(TypeValue)) = Option(TypeValue).None;
        n := labels.len();
        while((i < n) && found.is_none(), {
          match(
            labels.get(i),
            .Some(l) => {
              if(l == label, {
                found = types.get(i);
              });
            },
            .None => ()
          );
          i = (i + usize(1));
        });
        found
      },
      _ => Option(TypeValue).None
    )
  )
);
/// Substitute a trait entry's already-evaluated ASSOCIATED TYPES (e.g.
/// `Output : i32`) into a method's function type, alongside the `Self`
/// substitution below. TS evaluates `Self.Output` at impl registration
/// with the entry's bindings in scope, so its stored method type carries
/// the CONCRETE type; yo-self's trait-definition eval leaves an `Output`
/// SomeT in the stored type, which (a) keeps every call-site return
/// resolution symbolic (`ret_b=Output`, 539× in an 8-line io.async
/// program), and (b) lets Step-10 expected-synthesis POLLUTE the callee
/// env: the unresolved `Output` unifies with the caller's ambient expected
/// SomeT and the return re-eval launders the caller's `_ret` into the call
/// result (issues/yo-self-io-async-return-binop-void.md).
_substitute_assoc_in_method_ty :: (
  fn(
    method_ty : TypeValue,
    labels : ArrayList(String),
    types : ArrayList(TypeValue)
  ) -> TypeValue
)({
  if(labels.len() == usize(0), {
    return(method_ty);
  });
  somes := get_all_some_types(method_ty);
  s := subst_new();
  (n_added : usize) = usize(0);
  (i : usize) = usize(0);
  while(i < somes.len(), {
    match(
      somes.get(i),
      .Some(st) => match(
        st,
        .SomeT(_, snm, slvl, _, _, _, _, _, _, _, _) => {
          (j : usize) = usize(0);
          while(j < labels.len(), {
            lbl := match(labels.get(j), .Some(l) => l, .None => String.from(""));
            if(lbl == snm, {
              subst_add(s, snm.clone(), slvl, match(types.get(j), .Some(t) => t, .None => t_unit()));
              n_added = (n_added + usize(1));
            });
            j = (j + usize(1));
          });
        },
        _ => ()
      ),
      .None => ()
    );
    i = (i + usize(1));
  });
  if(n_added == usize(0), {
    return(method_ty);
  });
  substitute(s, method_ty)
});
/// Re-keying helper: `fi.ty` carries the TRAIT-DECLARED param labels
/// (`lhs`/`rhs` for an Eq method), but the impl's closure BODY was written
/// against the FuncVal's OWN param names (`self`/`other`). The C emitter
/// derives the signature's parameter names from get_func_type's
/// param_labels, so re-keying the raw fi.ty emitted `fn(lhs, rhs)` around a
/// body referencing self/other ('use of undeclared identifier' —
/// tests/env.test.yo PathBuf Eq, tests/string/rune.test.yo). Rebuild the
/// meta with the VALUE's param names (arity permitting) before registering.
_retype_with_value_param_labels :: (fn(ty : TypeValue, fv : EvalValue) -> TypeValue)({
  fv_params := match(fv, .FuncVal(__rvd, _) => __rvd.*.params, _ => return(ty));
  match(
    ty,
    .Func({ forall_types : rw_fts, param_types : rw_pts, implicit_types : rw_its, where_types : rw_wts, result : rw_res, meta : rw_m, variadic_types : rw_vts }) => {
      if(rw_m.*.param_labels.len() != fv_params.len(), {
        return(ty);
      });
      TypeValue.Func(
        rw_fts,
        rw_pts,
        rw_its,
        rw_wts,
        rw_res,
        box(
          FuncMeta(
            forall_labels : rw_m.*.forall_labels,
            param_labels : fv_params,
            implicit_labels : rw_m.*.implicit_labels,
            implicit_spreads : rw_m.*.implicit_spreads,
            result_is_comptime_only : rw_m.*.result_is_comptime_only,
            param_is_ref : rw_m.*.param_is_ref,
            param_is_owning : rw_m.*.param_is_owning,
            result_is_ref : rw_m.*.result_is_ref,
            has_variadic : rw_m.*.has_variadic,
            is_extern : rw_m.*.is_extern,
            extern_name : rw_m.*.extern_name,
            is_control : rw_m.*.is_control,
            variadic_label : rw_m.*.variadic_label,
            variadic_comptime : rw_m.*.variadic_comptime
          )
        ),
        rw_vts
      )
    },
    _ => ty
  )
});
/// Rebuild a method type so its RETURN-position SomeTs get FRESH ids (and
/// therefore fresh resolution cells). `substitute` shares unchanged
/// subtrees, so every per-impl materialization of a trait `?=` default whose
/// return contains no `Self` — e.g. `-> Impl(Future(ArrayList(u8), IoExn))`
/// — otherwise carries the SAME return SomeT as the trait declaration and as
/// every OTHER implementor: one global resolution cell, last writer wins.
/// That is C21 (issues/fixed/async-trait-default-shares-one-impl-future-concrete-type.md):
/// implementor A's call site declared implementor B's state-machine type,
/// and on the generic BufReader(R) it escalated to a never-emitted ABSTRACT
/// state struct (a hard C error). SomeTs that also occur in the params /
/// foralls / where / implicit positions are left alone — freshening only the
/// return half of a linked pair would split an identity the signature relies
/// on.
_freshen_return_only_somes :: (fn(method_ty : TypeValue) -> TypeValue)(
  match(
    method_ty,
    .Func({ forall_types : fr_fts, param_types : fr_pts, implicit_types : fr_its, where_types : fr_wts, result : fr_res, meta : fr_m, variadic_types : fr_vts }) => {
      res_somes := get_all_some_types(fr_res);
      if(res_somes.len() == usize(0), {
        return(method_ty);
      });
      // (name, level) pairs used OUTSIDE the return — do not freshen those.
      keep := ArrayList(String).new();
      outside := ArrayList(ArrayList(TypeValue)).new();
      outside.push(fr_pts);
      outside.push(fr_fts);
      outside.push(fr_wts);
      outside.push(fr_its);
      (oi : usize) = usize(0);
      while(oi < outside.len(), {
        tys := match(outside.get(oi), .Some(t) => t, .None => ArrayList(TypeValue).new());
        (ci : usize) = usize(0);
        while(ci < tys.len(), {
          match(
            tys.get(ci),
            .Some(ct) => {
              c_somes := get_all_some_types(ct);
              (cj : usize) = usize(0);
              while(cj < c_somes.len(), {
                match(
                  c_somes.get(cj),
                  .Some(cst) => match(
                    cst,
                    .SomeT(_, c_nm, c_lvl, _, _, _, _, _, _, _, _) => {
                      keep.push(`${c_nm}@${c_lvl.to_string()}`);
                    },
                    _ => ()
                  ),
                  .None => ()
                );
                cj = (cj + usize(1));
              });
            },
            .None => ()
          );
          ci = (ci + usize(1));
        });
        oi = (oi + usize(1));
      });
      fs := subst_new();
      (added : usize) = usize(0);
      (ri : usize) = usize(0);
      while(ri < res_somes.len(), {
        match(
          res_somes.get(ri),
          .Some(rst) => match(
            rst,
            .SomeT({ name : r_nm, frame_level : r_lvl, parent_type : r_pt, required_trait_types : r_rtt, required_trait_levels : r_rtl, negative_trait_types : r_ntt, negative_trait_levels : r_ntl, is_effects_row : r_ier, kind_function_type : r_kft }) => {
              r_key := `${r_nm}@${r_lvl.to_string()}`;
              (r_kept : bool) = false;
              (ki : usize) = usize(0);
              while(ki < keep.len(), {
                if(match(keep.get(ki), .Some(k) => (k == r_key), .None => false), {
                  r_kept = true;
                });
                ki = (ki + usize(1));
              });
              if(!r_kept, {
                subst_add(
                  fs,
                  r_nm.clone(),
                  r_lvl,
                  TypeValue.SomeT(
                    generate_some_type_id(),
                    r_nm.clone(),
                    r_lvl,
                    r_pt.clone(),
                    r_rtt.clone(),
                    r_rtl.clone(),
                    r_ntt.clone(),
                    r_ntl.clone(),
                    r_ier,
                    r_kft.clone(),
                    ArrayList(TypeValue).new()
                  )
                );
                added = (added + usize(1));
              });
            },
            _ => ()
          ),
          .None => ()
        );
        ri = (ri + usize(1));
      });
      if(added == usize(0), {
        return(method_ty);
      });
      TypeValue.Func(
        fr_fts,
        fr_pts,
        fr_its,
        fr_wts,
        substitute(fs, fr_res),
        fr_m,
        fr_vts
      )
    },
    _ => method_ty
  )
);
_substitute_self_in_method_ty :: (
  fn(method_ty : TypeValue, self_concrete : TypeValue) -> TypeValue
)({
  // Substitute EVERY `Self` occurrence at its OWN frame level.
  // `_find_self_level_in_method_ty` looked only at TOP-LEVEL param slots
  // (bare `Self` / `*(Self)`), so a method with no Self PARAM —
  // `try_from : (fn(value : _Self) -> Result(Self, Self.Error))` — was never
  // substituted at all: it registered with the raw trait-declared return,
  // codegen's should_skip_function_codegen treated the fully concrete impl
  // method as hard-generic (its return still contained the `Self` SomeT),
  // and the direct call site referenced a never-emitted fid ('call to
  // undeclared function fn_yo_id_…' — prelude arm 1's TryFrom calls;
  // scratchpad/mine/p8gate/r6tf.yo). `get_all_some_types` walks params,
  // return, foralls, and (shell-resolved) nested instances, so a Self
  // buried inside a composite return is found too — TS never needs this
  // because trait registration mutates the SHARED Self object in place.
  self_somes := get_all_some_types(method_ty);
  s := subst_new();
  (any_self : bool) = false;
  (ssi : usize) = usize(0);
  while(ssi < self_somes.len(), {
    match(
      self_somes.get(ssi),
      .Some(sst) => match(
        sst,
        .SomeT(_, ss_n, ss_lvl, _, _, _, _, _, _, _, _) => if(ss_n == "Self", {
          subst_add(s, String.from("Self"), ss_lvl, self_concrete.clone());
          any_self = true;
        }),
        _ => ()
      ),
      .None => ()
    );
    ssi = (ssi + usize(1));
  });
  cond(
    any_self => substitute(s, method_ty),
    true => method_ty
  )
});
/// Evaluate a per-impl MATERIALIZED trait-default body in a contained
/// swallow (the def-eval-wall pattern): a failing body must not abort the
/// enclosing impl evaluation — the shared default stays as fallback and the
/// call site surfaces any genuine error. The eval stamps the CLONE's
/// ExprInfos (Self is bound by the caller via ctx.self_type), which is what
/// codegen needs to emit the per-impl default directly (impl.test.yo
/// heterogeneous `!=` — see issues/retired/yo-self-hollow-root-cause-map.md layer 8).
///
/// The body is a FUNCTION BODY and must be evaluated as one: `fn_ty` (the
/// Self-substituted method type) and `fn_id` build the same
/// `create_function_body_evaluation_context` every other def-time body eval
/// uses (`_trial_eval_fn_body`, closure_type.yo, anonymous_function.yo).
/// Evaluating it under the IMPL's ambient context instead — which is what this
/// helper did before — left two things unset, and both were silently swallowed
/// here:
///   * `ctx.expected_type` (the declared return type). `io.async`'s Step 6b
///     (calls/helper.yo) pre-binds the effect-bundle generic `E` FROM the
///     expected `Impl(Future(T, E))`; with no expected type `E` stays a SomeT,
///     so `e.io.await(...)` in the default's async closure fails to resolve
///     ("No matching call found"), the closure body gets no ExprInfos, and
///     codegen emits an all-`// Failed to transpile` body (rewritten to
///     `abort()` since PR #275).
///     See issues/fixed/trait-default-awaiting-self-async-method-emits-hollow-fn.md.
///   * `ctx.is_evaluating_function_body_or_async_block`, without which a
///     `return(...)` anywhere in a default body evaluates as an ordinary
///     identifier and throws `Variable "return" not found`.
_materialize_default_body :: (
  fn(
    body : AstExpr,
    fn_ty : TypeValue,
    fn_id : String,
    env : Environment,
    ctx : EvalContext,
    out : ArrayList(AstExpr)
  ) -> unit
)({
  inner_exn := Exception(
    throw : (
      _err -> {
        if(impl_dbg_env.get(`YO_DEBUG_SWALLOW`).is_some(), {
          eprintln(`[mat-default-swallow] ${_err.to_string()}`);
        });
        unwind(())
      }
    )
  );
  // A separate preliminary FuncVal for the body-eval context (EvalValue is not
  // Clone and the caller still needs the registered one). Same pattern as
  // anonymous_function.yo's `body_ctx_func_val`.
  body_ctx_fv := EvalValue.FuncVal(
    box(
      FuncValData(
        forall_names : ArrayList(String).new(),
        params : ArrayList(String).new(),
        param_type_names : ArrayList(String).new(),
        evidence_params : ArrayList(String).new(),
        body : body.clone(),
        cap_names : ArrayList(String).new(),
        cap_tys : ArrayList(TypeValue).new(),
        func_id : fn_id.clone()
      )
    ),
    ArrayList(EvalValue).new()
  );
  body_ctx := create_function_body_evaluation_context(fn_ty, body_ctx_fv, env, ctx);
  // A DEF-time contained-swallow evaluation like _trial_eval_fn_body — the
  // in_def_time_trial flag is set/restored AT THE CALL SITES (a swallowed
  // error unwinds out of this helper, skipping any in-fn restore).
  evaluated := evaluate_expression_raw(body, env, body_ctx, inner_exn);
  out.push(evaluated);
});
/// Evaluate ONE colon-pair member of a concrete (Case 3) impl — the body the
/// field loop ran inline before P3 (plans/LAZY_TOPLEVEL_BINDINGS.md), pulled out
/// so `force_in_flight_field` can run it OUT OF ORDER when a sibling references
/// the member before its position. `field_opt` is the member's pending entry
/// (direct fields only; trait-constructor members always evaluate in place).
/// Reads and advances the impl env through `st.env`.
_c3_eval_colon_pair :: (
  fn(
    meth_expr : AstExpr,
    current_trait_ty : Option(TypeValue),
    st : ImplInFlight,
    field_opt : Option(ImplPendingField),
    ctx : EvalContext,
    exn : Exception
  ) -> unit
)({
  colon_args := match(
    meth_expr,
    .FnCall(_, _, ca, _, _) => ca,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  name_expr := match(colon_args.get(usize(0)), .Some(e) => e, .None => make_err_expr());
  val_expr := match(colon_args.get(usize(1)), .Some(e) => e, .None => make_err_expr());
  name_tok := ast_expr_token(name_expr);
  method_name := name_tok.value.clone();
  qualified := `${st.receiver_name}.${method_name}`;
  // Duplicate-INHERENT-method rejection
  // (plans/reference/FUNCTION_OVERLOADING_POLICY.md,
  // issues/fixed/duplicate-inherent-method-impls-not-rejected.md):
  // a second `impl(T, m : ...)` for the same (type, name) from a
  // DIFFERENT source site is a genuine second definition — before
  // this gate the first silently won (same signature) or both
  // dispatched by arity. Keyed on the defining token's site so
  // the loader's idempotent re-evaluation and a generic impl's
  // per-instantiation re-registration (both replay the SAME
  // site) stay legal. Trait-provided methods (current_trait_ty
  // Some) may share names BY DESIGN and are not gated. Placed
  // HERE — before the method body is even evaluated — because
  // registration itself forks (a phase-A entry registered by a
  // sibling's early reference is UPDATED in place; only members
  // nobody referenced early take the fresh-registration branch),
  // so a registration-side gate misses the forced ones.
  if(current_trait_ty.is_none() && (st.recv_id != ""), {
    __dup_site := note_inherent_method_site(
      st.recv_id.clone(),
      method_name.clone(),
      `${name_tok.module_path}:${name_tok.row}:${name_tok.column}`
    );
    match(
      __dup_site,
      .Some(__prev_site) => {
        exn.throw(
          dyn(
            format_error_message(
              name_tok,
              `Method "${method_name}" is already defined for this type (first definition: ${__prev_site}). Duplicate inherent method impls are not allowed — use a distinct name (e.g. a comptime_ prefix), or provide the second signature via a trait (plans/reference/FUNCTION_OVERLOADING_POLICY.md).`
            )
          )
        );
      },
      .None => ()
    );
  });
  // Compute the expected type for this method from the trait's
  // field-by-label. This lets anonymous lambdas (e.g. the body
  // of an impl method) see the function type the trait expects.
  expected_method_ty := _trait_field_type_by_label(current_trait_ty, method_name);
  // Substitute the trait's abstract `Self` with the concrete
  // receiver type so the impl method's anonymous lambda binds
  // its parameters at concrete types (e.g. `comptime_int`)
  // rather than the trait's `Self` SomeT — which the call-site
  // parameter check cannot resolve (its frame level is the
  // stale trait-definition frame). Mirrors TS's `SelfType`
  // substitution at impl registration.
  expected_method_ty_resolved := match(
    expected_method_ty,
    // Also substitute the entry's already-evaluated associated
    // types (Output : i32 etc., accumulated in field order in
    // ctx.current_impl_trait_field_labels/types) so the lambda's
    // registered type carries the CONCRETE return, mirroring TS
    // registration — see _substitute_assoc_in_method_ty.
    .Some(t) => Option(TypeValue).Some(
      _substitute_assoc_in_method_ty(
        _substitute_self_in_method_ty(t, st.receiver_ty),
        ctx.current_impl_trait_field_labels,
        ctx.current_impl_trait_field_types
      )
    ),
    .None => Option(TypeValue).None
  );
  saved2 := ctx.expected_type;
  ctx.expected_type = match(
    expected_method_ty_resolved,
    .Some(t) => Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : t, env : st.env)),
    .None => Option(ExpectedTypeCtx).None
  );
  eval_val := evaluate_expression_raw(val_expr, st.env, ctx, exn);
  ctx.expected_type = saved2;
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_val)),
    .None => (),
    .Some(fi) => {
      st.env = fi.env;
      method_val := match(fi.value, .Some(v) => v, .None => EvalValue.UnitVal);
      // Make this field visible to later fields' `Self.X`
      // within the SAME trait entry. Only TYPE-valued fields
      // (associated types like `Output : u8`) — `Self.X` never
      // resolves to a method value, and copying FuncVals into
      // the context list proved fragile.
      match(
        method_val,
        .TypeVal(c3_wt_tvb) => {
          ctx.current_impl_trait_field_labels.push(method_name.clone());
          ctx.current_impl_trait_field_types.push(c3_wt_tvb);
        },
        _ => ()
      );
      _dv := add_variable_to_env(
        st.env,
        qualified,
        fi.ty,
        .Some(method_val),
        true,
        false,
        false,
        false,
        name_tok
      );
      // Also bind the BARE label so later sibling fields in the
      // SAME impl can forward-call it (`new()` inside
      // `String.split`). Mirrors TS impl.ts:773 binding each
      // field under `label` in the impl's env frame; the frame
      // pushed before the field loop scopes it to this impl.
      _dv_bare := add_variable_to_env(
        st.env,
        method_name.clone(),
        fi.ty,
        .Some(method_val),
        true,
        false,
        false,
        false,
        name_tok
      );
      // Mirror the env-level binding into the
      // trait-method registry, keyed by the receiver
      // type's id. Receivers like primitive types
      // produce an empty id — skip those (mirrors TS
      // `getTypeTraitMethodsByNameFromEnv` early
      // returning [] when the type has no trait slot).
      if(st.recv_id != "", {
        // A phase-A entry for this field is already in the registry (a
        // sibling referenced this method while it was being evaluated —
        // plans/LAZY_TOPLEVEL_BINDINGS.md P3): it carries the SAME func_id as
        // the finished FuncVal, so update it in place with the final type
        // and value instead of registering a second entry.
        (updated_phase_a : bool) = false;
        match(
          field_opt,
          .Some(pa_pf) => if(pa_pf.phase_a_registered, {
            pa_real_fid := match(method_val, .FuncVal(__pa_fvd, _) => __pa_fvd.*.func_id.clone(), _ => String.new());
            pa_existing := get_type_trait_methods_by_name(st.recv_id, method_name);
            (pa_i : usize) = usize(0);
            while((pa_i < pa_existing.len()) && !updated_phase_a, {
              match(
                pa_existing.get(pa_i),
                .Some(pa_e) => {
                  pa_e_fid := match(pa_e.value, .Some(pa_v) => match(pa_v, .FuncVal(__pa_e_fvd, _) => __pa_e_fvd.*.func_id.clone(), _ => String.new()), .None => String.new());
                  if((pa_e_fid.len() > usize(0)) && (pa_e_fid == pa_real_fid), {
                    pa_e.ty = fi.ty;
                    pa_e.value = Option(EvalValue).Some(method_val);
                    register_func_type(pa_real_fid.clone(), _retype_with_value_param_labels(fi.ty, method_val));
                    updated_phase_a = true;
                  });
                },
                .None => ()
              );
              pa_i = (pa_i + usize(1));
            });
          }),
          .None => ()
        );
        if(!updated_phase_a, {
          // Re-register the method FuncVal's func TYPE as the
          // Self-SUBSTITUTED signature (`fi.ty`) — the type the
          // registry entry carries. The fid's table entry was
          // stamped at closure-mint time with the raw trait-
          // declared type (`fn(value : _Self) -> Result(Self,
          // Self.Error)`), whose SomeTs made codegen's
          // should_skip_function_codegen treat a fully CONCRETE
          // impl method as hard-generic and skip its emission —
          // while the call site still emitted the direct
          // `fn_<fid>` call ('call to undeclared function',
          // prelude arm 1 / assigned_param_overload_select.yo).
          // The default-method path already does this
          // (register_func_type at the d_fresh mint above); this
          // is the colon-pair-method twin. TS needs no re-key:
          // its FunctionValue.type IS the shared substituted
          // object.
          match(
            method_val,
            .FuncVal(__reg_fvd, _) => {
              register_func_type(__reg_fvd.*.func_id.clone(), _retype_with_value_param_labels(fi.ty, method_val));
            },
            _ => ()
          );
          register_type_trait_method(
            st.recv_id,
            MethodEntry(
              label : method_name.clone(),
              ty : fi.ty,
              value : Option(EvalValue).Some(method_val),
              // INHERENT-FIRST: tag trait-impl methods (current_trait_ty
              // is Some — `impl(T, Trait(...))`) with their trait id, so
              // resolution can SHADOW them behind a same-name direct/
              // inherent method (`impl(T, m : ...)`, current_trait_ty None
              // -> ""). Mirrors TS's direct-field vs label-"" TraitValue
              // distinction. See plans/backlog/OVERLOADING_REDESIGN.md §6 +
              // issues/fixed/yo-inherent-first-resolution.md.
              source_trait_id : match(
                current_trait_ty,
                .Some(__ct) => type_id_or_empty(__ct),
                .None => String.from("")
              ),
              needs_pointer_conversion : false,
              // Direct-on-type methods don't carry a
              // SelfType either (TS doesn't set it on
              // direct-method results; only the
              // SomeT / Dyn / TypeApp paths do, via
              // env.yo:get_receiver_methods_by_name_from_env).
              self_type : Option(TypeValue).None
            )
          );
        });
      });
    }
  );
});

/// Register a Case-2 member into the provisional registry — or, when a sibling's
/// early reference already registered this member's phase-A entry (same
/// func_id), update that entry in place (plans/LAZY_TOPLEVEL_BINDINGS.md P3).
_c2_register_member :: (
  fn(st : ImplInFlight, pf : ImplPendingField, label : String, ty : TypeValue, value : EvalValue, src_tid : String) -> unit
)({
  (updated : bool) = false;
  if(pf.phase_a_registered, {
    real_fid := match(value, .FuncVal(__c2r_fvd, _) => __c2r_fvd.*.func_id.clone(), _ => String.new());
    prior := get_provisional_trait_methods_by_name(st.recv_id, label.clone());
    (pi : usize) = usize(0);
    while((pi < prior.len()) && !updated, {
      match(
        prior.get(pi),
        .Some(pe) => {
          pe_fid := match(pe.value, .Some(pv) => match(pv, .FuncVal(__c2p_fvd, _) => __c2p_fvd.*.func_id.clone(), _ => String.new()), .None => String.new());
          if((pe_fid.len() > usize(0)) && (pe_fid == real_fid), {
            pe.ty = ty;
            pe.value = Option(EvalValue).Some(value);
            pe.source_trait_id = src_tid.clone();
            updated = true;
          });
        },
        .None => ()
      );
      pi = (pi + usize(1));
    });
  });
  if(!updated, {
    // Registered PROVISIONALLY: Case 2 has no per-field permanent
    // registration (methods accumulate into the GenericImplEntry, registered
    // after the loop), so a LATER sibling's definition-time body trial could
    // not otherwise resolve `Self.method()` mid-loop (array_list slice_copy,
    // roots #1-#3 in issues/fixed/def-eval-swallow-remaining-roots.md).
    // Entries carry the REAL evaluated value and are cleared at loop end.
    register_provisional_trait_method(
      st.recv_id.clone(),
      MethodEntry(
        label : label,
        ty : ty,
        value : Option(EvalValue).Some(value),
        source_trait_id : src_tid,
        needs_pointer_conversion : false,
        self_type : Option(TypeValue).None
      )
    );
  });
});
/// Evaluate ONE direct colon-pair member of a generic (Case 2) impl. Stores the
/// (type, value) the field loop pushes into the GenericImplEntry arrays in
/// source order, binds the bare label in the impl env, registers the member
/// provisionally.
_c2_eval_direct_field :: (
  fn(pf : ImplPendingField, st : ImplInFlight, ctx : EvalContext, exn : Exception) -> unit
)({
  mf_colon_args := match(
    pf.colon_expr,
    .FnCall(_, _, mca, _, _) => mca,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  mname_expr := match(mf_colon_args.get(usize(0)), .Some(e) => e, .None => make_err_expr());
  mval_expr := match(mf_colon_args.get(usize(1)), .Some(e) => e, .None => make_err_expr());
  mname_tok := ast_expr_token(mname_expr);
  mname := mname_tok.value.clone();
  saved3 := ctx.expected_type;
  ctx.expected_type = .None;
  eval_mval := evaluate_expression_raw(mval_expr, st.env, ctx, exn);
  ctx.expected_type = saved3;
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_mval)),
    .None => (),
    .Some(mfi) => {
      st.env = mfi.env;
      mval := match(mfi.value, .Some(v) => v, .None => EvalValue.UnitVal);
      m_is_macro := _method_ty_skip_stamp(mfi.ty);
      (m_to_push : EvalValue) = EvalValue.UnitVal;
      if(m_is_macro, {
        m_to_push = mval;
      }, {
        m_to_push = _stamp_impl_forall_on_method(mval, st.forall_names);
      });
      pf.result_ty = Option(TypeValue).Some(mfi.ty);
      pf.result_value = Option(EvalValue).Some(m_to_push);
      // Bind the bare label so later sibling fields can reference it by
      // name — alias fields like ComptimeList's `first : car`
      // (std/prelude.yo) evaluated `car` as an unbound atom and registered
      // `first` with type unit, making `types.first()` dispatch produce
      // unit. Mirrors the per-type main pass (and TS impl.ts:773) binding
      // each field into the impl env as it goes.
      _gb := add_variable_to_env(
        st.env,
        mname.clone(),
        mfi.ty,
        Option(EvalValue).Some(mval),
        true,
        false,
        false,
        false,
        mname_tok
      );
      if(st.recv_id != "", {
        _c2_register_member(st, pf, mname, mfi.ty, m_to_push, String.from(""));
      });
    }
  );
});
/// Evaluate ONE member inside a generic impl's trait constructor
/// (`Trait(name : fn_def, ...)`), with the trait's expected field type (Self
/// substituted to the receiver pattern) and the entry's working bindings.
_c2_eval_inner_field :: (
  fn(pf : ImplPendingField, st : ImplInFlight, ctx : EvalContext, exn : Exception) -> unit
)({
  g_colon_args := match(
    pf.colon_expr,
    .FnCall(_, _, gca, _, _) => gca,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  g_name_expr := match(g_colon_args.get(usize(0)), .Some(e) => e, .None => make_err_expr());
  g_val_expr := match(g_colon_args.get(usize(1)), .Some(e) => e, .None => make_err_expr());
  g_mname := ast_expr_token(g_name_expr).value.clone();
  // Expected field type from the trait's field-by-label, with `Self`
  // substituted to the receiver PATTERN (mirrors Case 3's
  // `_substitute_self_in_method_ty` at registration).
  g_expected := match(
    _trait_field_type_by_label(st.current_trait_ty, g_mname),
    .Some(t) => Option(TypeValue).Some(_substitute_self_in_method_ty(t, st.receiver_ty)),
    .None => Option(TypeValue).None
  );
  saved4 := ctx.expected_type;
  ctx.expected_type = match(
    g_expected,
    .Some(t) => Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : t, env : st.env)),
    .None => Option(ExpectedTypeCtx).None
  );
  eval_gval := evaluate_expression_raw(g_val_expr, st.env, ctx, exn);
  ctx.expected_type = saved4;
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_gval)),
    .None => (),
    .Some(gfi) => {
      st.env = gfi.env;
      g_mval := match(gfi.value, .Some(v) => v, .None => EvalValue.UnitVal);
      // Make this field visible to later fields' `Self.X`. TYPE-valued
      // fields only — see the Case 3 counterpart.
      match(
        g_mval,
        .TypeVal(g_wt_tvb) => {
          ctx.current_impl_trait_field_labels.push(g_mname.clone());
          ctx.current_impl_trait_field_types.push(g_wt_tvb);
        },
        _ => ()
      );
      g_is_macro := _method_ty_skip_stamp(gfi.ty);
      (g_to_push : EvalValue) = EvalValue.UnitVal;
      if(g_is_macro, {
        g_to_push = g_mval;
      }, {
        g_to_push = _stamp_impl_forall_on_method(g_mval, st.forall_names);
      });
      pf.result_ty = Option(TypeValue).Some(gfi.ty);
      pf.result_value = Option(EvalValue).Some(g_to_push);
      // Tagged with the trait's id (Case 3's fresh-registration semantics:
      // inherent-first resolution reads source_trait_id).
      if(st.recv_id != "", {
        c2g_src_tid := match(
          st.current_trait_ty,
          .Some(c2g_tt) => type_id_or_empty(c2g_tt),
          .None => String.from("")
        );
        _c2_register_member(st, pf, g_mname, gfi.ty, g_to_push, c2g_src_tid);
      });
    }
  );
});
/// Evaluate one pending member (in place from the field loop, or out of order
/// from `force_in_flight_field`), with its forcing-stack entry pushed so
/// `try_to_implement_function_by_function_type` publishes the phase-A FuncVal
/// a re-entrant sibling reference binds.
_run_impl_field :: (
  fn(pf : ImplPendingField, st : ImplInFlight, ctx : EvalContext, exn : Exception) -> unit
)({
  push_forcing_def(pf.def);
  pf.state = ImplFieldState.Forcing;
  cond(
    st.is_generic => cond(
      pf.is_inner => _c2_eval_inner_field(pf, st, ctx, exn),
      true => _c2_eval_direct_field(pf, st, ctx, exn)
    ),
    true => _c3_eval_colon_pair(
      pf.colon_expr,
      cond(pf.is_inner => st.current_trait_ty, true => Option(TypeValue).None),
      st,
      Option(ImplPendingField).Some(pf),
      ctx,
      exn
    )
  );
  pf.state = ImplFieldState.Done;
  pop_forcing_def();
});
/// A forced member's failure, parked by the capture-free handler below.
(g_field_force_failure : Option(String)) = Option(String).None;
_flag_field_force_failure :: (fn(msg : String) -> unit)({
  g_field_force_failure = Option(String).Some(msg);
  ()
});
_take_field_force_failure :: (fn() -> Option(String))({
  r := g_field_force_failure;
  g_field_force_failure = Option(String).None;
  r
});
_force_field_eval :: (fn(pf : ImplPendingField, st : ImplInFlight) -> unit)({
  inner_exn := Exception(
    throw : (
      _err -> {
        _flag_field_force_failure(render_any_error(_err));
        unwind(());
      }
    )
  );
  _run_impl_field(pf, st, st.ctx, inner_exn);
  ()
});
/// env.yo's lookup-miss hook (plans/LAZY_TOPLEVEL_BINDINGS.md P3): a method
/// miss on a receiver whose impl block is in flight forces the sibling member
/// of that name — its REAL evaluation, with its real func_id, registered where
/// the block registers members (permanently for a concrete impl,
/// provisionally for a generic one). A member that is itself mid-evaluation
/// (mutual recursion, or a method calling itself) is answered from the
/// phase-A FuncVal its evaluation published. Returns true when something new
/// was registered, so the caller re-queries. Replaces the shell pre-pass
/// (`_try_create_forward_shell`) and the lazy shell materializer — shells had
/// their own func_ids and needed codegen thunks (`register_shell_redirect`).
force_in_flight_field :: (
  fn(type_id : String, method_name : String) -> bool
)({
  rec := match(
    newest_impl_in_flight_for(type_id),
    .Some(r) => r,
    .None => {
      return(false);
    }
  );
  pf := match(
    impl_forcible_field(rec, method_name),
    .Some(f) => f,
    .None => {
      return(false);
    }
  );
  match(
    pf.state,
    .Done => false,
    .Failed => false,
    .Forcing => cond(
      (!pf.phase_a_registered && pf.def.phase_a_value.is_some()) => {
        pa_v := match(pf.def.phase_a_value, .Some(v) => v, .None => EvalValue.UnitVal);
        pa_t := match(pf.def.phase_a_type, .Some(t) => t, .None => t_unit());
        pa_src := cond(
          pf.is_inner => match(rec.current_trait_ty, .Some(tt) => type_id_or_empty(tt), .None => String.from("")),
          true => String.from("")
        );
        pa_entry := MethodEntry(
          label : pf.label.clone(),
          ty : pa_t,
          value : Option(EvalValue).Some(pa_v),
          source_trait_id : pa_src,
          needs_pointer_conversion : false,
          self_type : Option(TypeValue).None
        );
        if(rec.is_generic, {
          register_provisional_trait_method(rec.recv_id.clone(), pa_entry);
        }, {
          register_type_trait_method(rec.recv_id.clone(), pa_entry);
        });
        pf.phase_a_registered = true;
        if(impl_dbg_env.get(`YO_DEBUG_LAZY`).is_some(), {
          eprintln(`[force-field] phase-A ${type_id}.${method_name}`);
        });
        true
      },
      true => false
    ),
    .Unforced => {
      if(impl_dbg_env.get(`YO_DEBUG_LAZY`).is_some(), {
        eprintln(`[force-field] ${type_id}.${method_name} (impl arg ${pf.top_index.to_string()}, inner=${pf.is_inner.to_string()})`);
      });
      // Process-wide "where am I" state the surrounding trial owns — reset
      // to what an in-place evaluation of this member would see.
      prev_trial := set_in_def_time_trial(false);
      saved_where := take_active_where_trait_ids();
      saved_exp := rec.ctx.expected_type;
      saved_wt_labels := rec.ctx.current_impl_trait_field_labels;
      saved_wt_types := rec.ctx.current_impl_trait_field_types;
      if(!pf.is_inner, {
        rec.ctx.current_impl_trait_field_labels = ArrayList(String).new();
        rec.ctx.current_impl_trait_field_types = ArrayList(TypeValue).new();
      });
      depths := forcing_depths();
      ___cf := _take_field_force_failure();
      _force_field_eval(pf, rec);
      failure := _take_field_force_failure();
      rec.ctx.current_impl_trait_field_labels = saved_wt_labels;
      rec.ctx.current_impl_trait_field_types = saved_wt_types;
      rec.ctx.expected_type = saved_exp;
      restore_active_where_trait_ids(saved_where);
      ___rt := set_in_def_time_trial(prev_trial);
      match(
        failure,
        .Some(msg) => {
          truncate_forcing_depths(depths);
          pf.state = ImplFieldState.Failed;
          full := `${msg}\n  note: \`${pf.label}\` was evaluated here because a sibling method of this impl references it before its definition`;
          pf.failure = Option(String).Some(full.clone());
          flag_pending_impl_force_error(full);
          false
        },
        .None => true
      )
    }
  )
});
/// Parse an impl's `where(...)` clause into parallel constraint arrays for
/// `GenericImplEntry`. For each `X <: Trait` constraint whose LHS `X` is a
/// generic type param, append (the generic SomeT for `X`, the evaluated `Trait`)
/// to `out_some_types` / `out_traits`. Single-trait constraints only — a
/// `(Trait1, Trait2)` RHS or an unknown trait is skipped (conservative: no
/// constraint captured ⇒ no exclusion, same as before). Mirrors the
/// `whereConstraints` capture in TS impl.ts.
_collect_impl_where_constraints :: (
  fn(
    where_expr : AstExpr,
    forall_names : ArrayList(String),
    forall_some_types : ArrayList(TypeValue),
    forall_env : Environment,
    ctx : EvalContext,
    exn : Exception,
    out_some_types : ArrayList(TypeValue),
    out_traits : ArrayList(TypeValue)
  ) -> unit
)({
  where_args := match(
    where_expr,
    .FnCall(_, _, wa, _, _) => wa,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  (wi : usize) = usize(0);
  while(wi < where_args.len(), {
    c := match(where_args.get(wi), .Some(x) => x, .None => make_err_expr());
    wi = (wi + usize(1));
    if(ast_expr_is_fn_call_of(c, "<:", Option(usize).Some(usize(2))), {
      c_args := match(
        c,
        .FnCall(_, _, ca, _, _) => ca,
        .Atom(_, _) => ArrayList(AstExpr).new()
      );
      lhs := match(c_args.get(usize(0)), .Some(x) => x, .None => make_err_expr());
      rhs := match(c_args.get(usize(1)), .Some(x) => x, .None => make_err_expr());
      lhs_name := ast_expr_token(lhs).value.clone();
      (fa_idx : Option(usize)) = Option(usize).None;
      (fni : usize) = usize(0);
      while((fni < forall_names.len()) && fa_idx.is_none(), {
        match(
          forall_names.get(fni),
          .Some(fn0) => if(fn0 == lhs_name, {
            fa_idx = Option(usize).Some(fni);
          }),
          .None => ()
        );
        fni = (fni + usize(1));
      });
      match(
        fa_idx,
        .Some(idx) => {
          st := match(forall_some_types.get(idx), .Some(s) => s, .None => t_unit());
          // RHS is either a single trait `Iterator` or a tuple of traits
          // `(Send, Acyclic)`. Evaluating a tuple expr as a type throws ("Cannot
          // store a type value in tuple"), so split it and look up each element
          // as its own constraint (T <: A, T <: B). Mirrors the BK_TUPLE split
          // in the function where-clause handler (types/function.yo:1968).
          if(ast_expr_is_fn_call_of(rhs, BK_TUPLE, Option(usize).None), {
            rhs_args := match(
              rhs,
              .FnCall(_, _, ra, _, _) => ra,
              .Atom(_, _) => ArrayList(AstExpr).new()
            );
            (rti : usize) = usize(0);
            while(rti < rhs_args.len(), {
              re := match(rhs_args.get(rti), .Some(x) => x, .None => make_err_expr());
              match(
                _try_lookup_trait_type(re, forall_env, ctx, exn),
                .Some(tr) => {
                  _s := out_some_types.push(st.clone());
                  _t := out_traits.push(tr);
                  // ALSO stamp the constraint on the generic SomeT itself —
                  // yo-self's established equivalent of TS recording
                  // frame-scoped where evidence (subtype-of.ts:159-174 →
                  // addWhereClauseConstraintToEnv): constraints live on
                  // SomeT.required_trait_types (the fn-type path's
                  // _add_where_clause_constraint divergence). Without this,
                  // CTFE-evaluating the impl HEAD (`Arc(T)` in
                  // `impl(generic(T), where(T <: (Send, Acyclic)), Arc(T), Send())`)
                  // sees T with ZERO constraints and the atomic-Send
                  // enforcement wrongly rejects the prelude.
                  match(
                    st,
                    .SomeT(_, _, _, _, cw_req, cw_req_lv, _, _, _, _, _) => {
                      cw_req.push(tr);
                      cw_req_lv.push(usize(0));
                    },
                    _ => ()
                  );
                },
                .None => ()
              );
              rti = (rti + usize(1));
            });
          }, {
            match(
              _try_lookup_trait_type(rhs, forall_env, ctx, exn),
              .Some(tr) => {
                _s := out_some_types.push(st.clone());
                _t := out_traits.push(tr);
                // Stamp on the SomeT too — see the tuple arm above.
                match(
                  st,
                  .SomeT(_, _, _, _, cw1_req, cw1_req_lv, _, _, _, _, _) => {
                    cw1_req.push(tr);
                    cw1_req_lv.push(usize(0));
                  },
                  _ => ()
                );
              },
              .None => ()
            );
          });
        },
        .None => ()
      );
    });
  });
});
evaluate_module_value :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  (local_env : Environment) = env;
  // Verify it's an `impl(...)` call.
  if(!ast_expr_is_fn_call_of(expr, BK_IMPL_LOWER, .None), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected "impl", got: ${ast_expr_token(expr).value}`
        )
      )
    );
  });
  // Extract args from the FnCall.
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  n_args := args.len();
  // ---------------------------------------------------------------------------
  // Case 1: Anonymous impl — impl({ begin_block })
  // ---------------------------------------------------------------------------
  a0_is_begin_block := match(
    args.get(usize(0)),
    .Some(a0) => (ast_expr_is_fn_call(a0) && ast_expr_is_fn_call_of(a0, BK_BEGIN, .None)),
    .None => false
  );
  if((n_args == usize(1)) && a0_is_begin_block, {
    a0 := match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
    begin_exprs := match(
      a0,
      .FnCall(_, _, be, _, _) => be,
      .Atom(_, _) => ArrayList(AstExpr).new()
    );
    saved_expected := ctx.expected_type;
    ctx.expected_type = .None;
    result := evaluate_anonymous_module_begin_exprs(
      begin_exprs,
      local_env,
      ctx,
      false,
      false,
      // Block-scoped bindings stay ordered (plans/LAZY_TOPLEVEL_BINDINGS.md
      // §4.1 — deferral is a module-FILE mechanism).
      false,
      exn
    );
    ctx.expected_type = saved_expected;
    local_env = result.env;
    out_info := new_expr_info(local_env, result.module_type);
    out_info.value = .Some(result.module_value);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    return(expr);
  });
  // ---------------------------------------------------------------------------
  // Case 2: Generic impl — impl(generic(...), ReceiverType, …)
  // ---------------------------------------------------------------------------
  has_forall := match(
    args.get(usize(0)),
    .Some(a0) => (ast_expr_is_fn_call(a0) && ast_expr_is_fn_call_of(a0, BK_GENERIC, .None)),
    .None => false
  );
  if(has_forall, {
    forall_expr := match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
    forall_args := match(
      forall_expr,
      .FnCall(_, _, fa, _, _) => fa,
      .Atom(_, _) => ArrayList(AstExpr).new()
    );
    // Snapshot env (share frames, TS-`pushEnvFrame` aliasing) and push a
    // fresh frame to hold the generic SomeTs — writes only touch that frame,
    // so the outer scope stays isolated exactly as in TS.
    (forall_env : Environment) = snapshot_env(local_env);
    forall_env.push_frame(false);
    frame_lvl := (forall_env.frames.len() - usize(1));
    // Forall param names and SomeT TypeValues (parallel arrays).
    (forall_names : ArrayList(String)) = ArrayList(String).new();
    (forall_some_types : ArrayList(TypeValue)) = ArrayList(TypeValue).new();
    (fi2 : usize) = usize(0);
    while(fi2 < forall_args.len(), {
      fp_expr := match(forall_args.get(fi2), .Some(e) => e, .None => make_err_expr());
      fi2 = (fi2 + usize(1));
      // Extract name: `T : Type` colon pair or plain atom `T`.
      (param_name_opt : Option(String)) = if(ast_expr_is_fn_call(fp_expr) && ast_expr_is_fn_call_of(fp_expr, BK_COLON, .Some(usize(2))), {
        colon_args2 := match(
          fp_expr,
          .FnCall(_, _, ca2, _, _) => ca2,
          .Atom(_, _) => ArrayList(AstExpr).new()
        );
        lhs2 := match(colon_args2.get(usize(0)), .Some(e) => e, .None => make_err_expr());
        // Register the binder's declared KIND, name-only (no evaluation —
        // resolution happens purely in _build_def_time_body_env; see
        // resolve_some_binder_kind in types/creators.yo). Only value-binder
        // kinds matter, so `: Type` is skipped.
        rhs2 := match(colon_args2.get(usize(1)), .Some(e) => e, .None => make_err_expr());
        if(ast_expr_is_atom(rhs2), {
          rhs2_name := ast_expr_token(rhs2).value.clone();
          if(rhs2_name != "Type", {
            register_some_binder_kind(ast_expr_token(lhs2).value.clone(), frame_lvl, rhs2_name);
          });
        });
        Option(String).Some(ast_expr_token(lhs2).value.clone())
      }, if(
        ast_expr_is_atom(fp_expr),
        Option(String).Some(ast_expr_token(fp_expr).value.clone()),
        Option(String).None
      ));
      (param_name_str : String) = match(param_name_opt, .Some(n) => n, .None => String.from("_"));
      // Create a SomeT for this parameter.
      some_ty := t_some_t(param_name_str.clone(), frame_lvl);
      tv := create_type_value(some_ty);
      // Add TypeVal(SomeT) to forall_env so receiver type evaluation sees it.
      add_variable_to_env(
        forall_env,
        param_name_str.clone(),
        t_type(),
        // TypeUni(0) — type-of-a-type
        .Some(tv),
        true,
        // is_compile_time_only
        false,
        // is_reassignable
        false,
        // is_owning_the_rc_value
        false,
        // is_implicit
        ast_expr_token(fp_expr)
      );
      forall_names.push(param_name_str.clone());
      forall_some_types.push(some_ty);
    });
    // Where-clause constraints captured for the GenericImplEntry, so
    // `try_match_generic_impl` can reject this impl for a concrete type that
    // fails them (e.g. the blanket `where(I <: Iterator)` must NOT match a
    // non-Iterator collection). Populated at BOTH where positions: before the
    // receiver (`generic(I), where(...), I, ...`) here, and after the receiver
    // (`generic(T), Channel(T), where(...), ...`) in the field loop below.
    (impl_where_some_types : ArrayList(TypeValue)) = ArrayList(TypeValue).new();
    (impl_where_traits : ArrayList(TypeValue)) = ArrayList(TypeValue).new();
    // Determine where `receiver_type_expr` starts: skip optional where(...) arg.
    (receiver_arg_idx : usize) = usize(1);
    match(
      args.get(usize(1)),
      .None => (),
      .Some(a1) => {
        if(ast_expr_is_fn_call(a1) && ast_expr_is_fn_call_of(a1, "where", .None), {
          receiver_arg_idx = usize(2);
          _collect_impl_where_constraints(a1, forall_names, forall_some_types, forall_env, ctx, exn, impl_where_some_types, impl_where_traits);
        });
      }
    );
    receiver_type_expr2 := match(args.get(receiver_arg_idx), .Some(a) => a, .None => make_err_expr());
    // Evaluate receiver type with SomeTs in scope.
    saved_expected2 := ctx.expected_type;
    ctx.expected_type = .None;
    eval_rcv2 := evaluate_expression_raw(receiver_type_expr2, forall_env, ctx, exn);
    ctx.expected_type = saved_expected2;
    (receiver_type_pattern : TypeValue) = t_unit();
    match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_rcv2)),
      .None => (),
      .Some(ri2) => {
        forall_env = ri2.env;
        match(
          ri2.value,
          .None => (),
          .Some(rv) => match(
            rv,
            .TypeVal(tv2) => {
              receiver_type_pattern = tv2;
            },
            _ => ()
          )
        );
      }
    );
    // Collect method fields: name : fn_def pairs.
    (method_names : ArrayList(String)) = ArrayList(String).new();
    (method_types : ArrayList(TypeValue)) = ArrayList(TypeValue).new();
    (method_values : ArrayList(EvalValue)) = ArrayList(EvalValue).new();
    // Mirror TS `context: { ...context, SelfType: receiverType }` so
    // `Self` resolves to the receiver type pattern inside method
    // bodies.
    old_self_type_g := ctx.self_type;
    ctx.self_type = .Some(receiver_type_pattern);
    // Receiver id for the per-field PROVISIONAL registration below.
    // Empty for receivers without an id — skip, mirroring Case 3's guard.
    c2_recv_id := type_id_or_empty(receiver_type_pattern);
    // Pending members (plans/LAZY_TOPLEVEL_BINDINGS.md P3): every direct
    // colon-pair member and every member inside a trait constructor is a
    // definition scoped to this block. A sibling's definition-time body trial
    // that references one before its position forces its evaluation through
    // `force_in_flight_field` (env.yo's provisional-lookup miss hook); the
    // loops below skip members already forced and push their results in
    // source order. Forcing is on demand only — eagerly evaluating every
    // member's signature head before the loop measurably diverged
    // tests/imm_map.test.yo (experiment B, 2026-08-13): map.yo's early
    // `Map(K, U)` instantiations poison a CTFE/instantiation order the batch
    // main later depends on.
    c2_fields := ArrayList(ImplPendingField).new();
    (c2_pp : usize) = (receiver_arg_idx + usize(1));
    while(c2_pp < n_args, {
      c2_pp_expr := match(args.get(c2_pp), .None => make_err_expr(), .Some(e) => e);
      if(ast_expr_is_fn_call(c2_pp_expr) && ast_expr_is_fn_call_of(c2_pp_expr, BK_COLON, .Some(usize(2))), {
        c2_lbl := match(
          c2_pp_expr,
          .FnCall(_, _, c2_ca, _, _) => match(c2_ca.get(usize(0)), .Some(l) => ast_expr_token(l).value.clone(), .None => String.new()),
          .Atom(_, _) => String.new()
        );
        c2_fields.push(make_impl_pending_field(c2_lbl, c2_pp_expr, c2_pp, false));
      });
      if(ast_expr_is_fn_call(c2_pp_expr) && !ast_expr_is_fn_call_of(c2_pp_expr, BK_COLON, .Some(usize(2))) && (!ast_expr_is_fn_call_of(c2_pp_expr, BK_WHERE, .None) && !ast_expr_is_fn_call_of(c2_pp_expr, "!", .Some(usize(1)))), {
        c2_ta := match(
          c2_pp_expr,
          .FnCall(_, _, ta, _, _) => ta,
          .Atom(_, _) => ArrayList(AstExpr).new()
        );
        (c2_ti : usize) = usize(0);
        while(c2_ti < c2_ta.len(), {
          c2_te := match(c2_ta.get(c2_ti), .Some(e) => e, .None => make_err_expr());
          c2_ti = (c2_ti + usize(1));
          if(ast_expr_is_fn_call(c2_te) && ast_expr_is_fn_call_of(c2_te, BK_COLON, .Some(usize(2))), {
            c2_ilbl := match(
              c2_te,
              .FnCall(_, _, c2_ica, _, _) => match(c2_ica.get(usize(0)), .Some(l) => ast_expr_token(l).value.clone(), .None => String.new()),
              .Atom(_, _) => String.new()
            );
            c2_fields.push(make_impl_pending_field(c2_ilbl, c2_te, c2_pp, true));
          });
        });
      });
      c2_pp = (c2_pp + usize(1));
    });
    c2_rec := ImplInFlight(
      recv_id : c2_recv_id.clone(),
      is_generic : true,
      receiver_ty : receiver_type_pattern,
      receiver_name : String.new(),
      env : forall_env,
      ctx : ctx,
      fields : c2_fields,
      current_top_index : usize(0),
      current_trait_ty : Option(TypeValue).None,
      forall_names : forall_names
    );
    push_impl_in_flight(c2_rec);
    (fj : usize) = (receiver_arg_idx + usize(1));
    while(fj < n_args, {
      mf_expr := match(args.get(fj), .None => make_err_expr(), .Some(e) => e);
      fj = (fj + usize(1));
      c2_rec.current_top_index = (fj - usize(1));
      // Negative GENERIC impl: `impl(generic(...), Pattern, !(Trait))`. Register
      // the negated trait into the negative-generic registry (reusing this
      // impl's generic params + receiver pattern) so `Type.impls(Concrete, Trait)`
      // returns false at trait-checking step 0. Mirrors TS impl.ts:3017-3024
      // (`isGeneric` branch of negative-trait registration). The `!(...)` field
      // then falls through the trait-constructor handling below as a no-op (its
      // head `!` is not a trait), like the concrete negative path.
      if(ast_expr_is_fn_call_of(mf_expr, "!", .Some(usize(1))), {
        neg_inner := match(
          mf_expr,
          .FnCall(_, _, na, _, _) => match(na.get(usize(0)), .Some(x) => x, .None => make_err_expr()),
          .Atom(_, _) => make_err_expr()
        );
        neg_head := match(neg_inner, .FnCall(_, fbn, _, _, _) => fbn, .Atom(_, _) => neg_inner);
        match(
          _try_lookup_trait_type(neg_head, forall_env, ctx, exn),
          .Some(neg_trait_ty) => {
            neg_entry := GenericImplEntry(
              get_trait_key(neg_trait_ty),
              forall_names,
              forall_some_types,
              receiver_type_pattern,
              neg_trait_ty,
              ArrayList(String).new(),
              ArrayList(TypeValue).new(),
              ArrayList(EvalValue).new(),
              forall_env,
              impl_where_some_types,
              impl_where_traits
            );
            register_negative_generic_impl(neg_entry);
          },
          .None => ()
        );
      });
      if(ast_expr_is_fn_call(mf_expr) && ast_expr_is_fn_call_of(mf_expr, BK_COLON, .Some(usize(2))), {
        // Direct member — through its pending entry (a sibling may already
        // have forced it); its results are pushed HERE, in source order.
        c2_rec.env = forall_env;
        match(
          impl_direct_field_at(c2_rec, fj - usize(1)),
          .Some(c2_pf) => {
            match(
              c2_pf.state,
              .Done => (),
              .Failed => {
                exn.throw(dyn(match(c2_pf.failure, .Some(m) => m.clone(), .None => String.from("impl member failed"))));
              },
              .Forcing => {
                exn.throw(dyn(format_error_message(ast_expr_token(mf_expr), `internal error: impl member "${c2_pf.label}" reached by the field loop while it is being forced`)));
              },
              .Unforced => {
                _run_impl_field(c2_pf, c2_rec, ctx, exn);
              }
            );
            match(
              c2_pf.result_ty,
              .Some(c2_rt) => {
                method_names.push(c2_pf.label.clone());
                method_types.push(c2_rt);
                method_values.push(match(c2_pf.result_value, .Some(v) => v, .None => EvalValue.UnitVal));
              },
              .None => ()
            );
          },
          .None => ()
        );
        forall_env = c2_rec.env;
      });
      // Trait-constructor entry: `Trait(name : fn_def, ...)` or
      // `Trait(args)(name : fn_def, ...)` — e.g. ArrayList's
      // `Index(usize)(Output : T, index : (fn ...)(...))`. Mirrors the TS
      // generic-impl path (impl.ts:3629-3677: one registered GenericImpl
      // per trait entry, keyed by the trait, carrying the trait's fields).
      // Each colon-pair field inside the trait constructor is evaluated
      // with the trait's expected field type (Self substituted to the
      // receiver pattern, same as Case 3) and the per-trait entry is
      // registered immediately. Previously these fields were silently
      // skipped, so generic TRAIT impls registered no methods at all and
      // `x(i)` Index dispatch on `ArrayList(u8)` found nothing.
      // `where(...)` clauses may also appear AFTER the receiver
      // (`impl(generic(T), Channel(T), where(T <: Send), ...)`); they are
      // not fields — capture their constraints (for try_match_generic_impl),
      // then skip them like the pre-receiver capture above.
      if(ast_expr_is_fn_call_of(mf_expr, BK_WHERE, .None), {
        _collect_impl_where_constraints(mf_expr, forall_names, forall_some_types, forall_env, ctx, exn, impl_where_some_types, impl_where_traits);
      });
      if(ast_expr_is_fn_call(mf_expr) && !ast_expr_is_fn_call_of(mf_expr, BK_COLON, .Some(usize(2))) && !ast_expr_is_fn_call_of(mf_expr, BK_WHERE, .None), {
        trait_fn_expr2 := match(
          mf_expr,
          .FnCall(_, tfb, _, _, _) => tfb,
          .Atom(_, _) => make_err_expr()
        );
        g_trait_ty_opt := _try_lookup_trait_type(trait_fn_expr2, forall_env, ctx, exn);
        g_trait_ty := match(g_trait_ty_opt, .Some(t) => t, .None => t_unit());
        g_method_names := ArrayList(String).new();
        g_method_types := ArrayList(TypeValue).new();
        g_method_values := ArrayList(EvalValue).new();
        // Working-trait bindings: fields already evaluated for THIS trait
        // entry, visible to later fields' `Self.X` references (e.g.
        // `Output : T` before `index : fn(...) -> *(Self.Output)`).
        // Mirrors TS's progressive `receiverType.trait` attach.
        old_wt_labels := ctx.current_impl_trait_field_labels;
        old_wt_values := ctx.current_impl_trait_field_types;
        ctx.current_impl_trait_field_labels = ArrayList(String).new();
        ctx.current_impl_trait_field_types = ArrayList(TypeValue).new();
        trait_inner_args2 := match(
          mf_expr,
          .FnCall(_, _, tia2, _, _) => tia2,
          .Atom(_, _) => ArrayList(AstExpr).new()
        );
        c2_rec.current_trait_ty = g_trait_ty_opt;
        (gti : usize) = usize(0);
        while(gti < trait_inner_args2.len(), {
          inner_e2 := match(trait_inner_args2.get(gti), .Some(x) => x, .None => make_err_expr());
          gti = (gti + usize(1));
          if(ast_expr_is_fn_call(inner_e2) && ast_expr_is_fn_call_of(inner_e2, BK_COLON, .Some(usize(2))), {
            g_mname := match(
              inner_e2,
              .FnCall(_, _, gca, _, _) => match(gca.get(usize(0)), .Some(e) => ast_expr_token(e).value.clone(), .None => String.new()),
              .Atom(_, _) => String.new()
            );
            // Through the member's pending entry (a sibling of THIS trait
            // entry may already have forced it); results pushed in order.
            c2_rec.env = forall_env;
            match(
              impl_inner_field_at(c2_rec, fj - usize(1), g_mname.clone()),
              .Some(c2_ipf) => {
                match(
                  c2_ipf.state,
                  .Done => (),
                  .Failed => {
                    exn.throw(dyn(match(c2_ipf.failure, .Some(m) => m.clone(), .None => String.from("impl member failed"))));
                  },
                  .Forcing => {
                    exn.throw(dyn(format_error_message(ast_expr_token(inner_e2), `internal error: impl member "${c2_ipf.label}" reached by the field loop while it is being forced`)));
                  },
                  .Unforced => {
                    _run_impl_field(c2_ipf, c2_rec, ctx, exn);
                  }
                );
                match(
                  c2_ipf.result_ty,
                  .Some(g_rt) => {
                    g_method_names.push(c2_ipf.label.clone());
                    g_method_types.push(g_rt);
                    g_method_values.push(match(c2_ipf.result_value, .Some(v) => v, .None => EvalValue.UnitVal));
                  },
                  .None => ()
                );
              },
              .None => ()
            );
            forall_env = c2_rec.env;
          });
        });
        c2_rec.current_trait_ty = Option(TypeValue).None;
        ctx.current_impl_trait_field_labels = old_wt_labels;
        ctx.current_impl_trait_field_types = old_wt_values;
        // Fill trait `?=` DEFAULT methods the impl did not override — the
        // GENERIC-impl counterpart of the concrete-impl fill below (and of TS
        // trait-type.ts:418-489). Without it, `a != b` on a generic-impl Eq
        // receiver (ArrayList(i32)) resolves the TRAIT's raw default FuncVal,
        // which carries no impl foralls — the runtime-call for-codegen
        // specialization trigger then never fires, the abstract default body
        // (`not(Self.(==)(lhs, rhs))`) cannot transpile, and its inner `not`
        // call specializes against the CONSTRAINT trait (the C
        // `void self` param that failed the collections batches). Stamping
        // the impl foralls onto the default (same as provided methods, line
        // above) restores the nf>0 trigger and per-receiver specialization.
        match(
          g_trait_ty,
          .TraitT({ field_labels : gd_labels, field_types : gd_types, id : gd_trait_id }) => {
            (gdi : usize) = usize(0);
            while(gdi < gd_labels.len(), {
              gd_label := match(gd_labels.get(gdi), .Some(l) => l, .None => String.from(""));
              gd_ty := match(gd_types.get(gdi), .Some(t) => t, .None => TypeValue.Unit);
              (gd_provided : bool) = false;
              (gpi : usize) = usize(0);
              while((gpi < g_method_names.len()) && !gd_provided, {
                if(match(g_method_names.get(gpi), .Some(n) => (n == gd_label), .None => false), {
                  gd_provided = true;
                });
                gpi = (gpi + usize(1));
              });
              if(!gd_provided && is_function_type(gd_ty), {
                match(
                  get_trait_default(gd_trait_id.clone(), gd_label.clone()),
                  .Some(gd_val) => {
                    g_method_names.push(gd_label.clone());
                    g_method_types.push(_freshen_return_only_somes(_substitute_self_in_method_ty(gd_ty, receiver_type_pattern)));
                    g_method_values.push(_stamp_impl_forall_on_method(gd_val, forall_names));
                  },
                  .None => ()
                );
              });
              gdi = (gdi + usize(1));
            });
          },
          _ => ()
        );
        g_entry := GenericImplEntry(
          get_base_trait_key(g_trait_ty),
          // 1. trait_key — the trait's own key, NOT the inherent "" key
          forall_names,
          // 2. forall_names
          forall_some_types,
          // 3. forall_some_types
          receiver_type_pattern,
          // 4. receiver_type_pattern
          g_trait_ty,
          // 5. trait_type
          g_method_names,
          // 6. field_names
          g_method_types,
          // 7. field_types
          g_method_values,
          // 8. field_values
          forall_env,
          // 9. definition_env
          impl_where_some_types,
          // 10. where_constraint_some_types
          impl_where_traits // 11. where_constraint_traits
        );
        register_generic_impl(g_entry);
      });
    });
    // Restore self_type so the impl's parent scope sees its prior value.
    ctx.self_type = old_self_type_g;
    // Field loop done — drop the in-flight provisional entries (the real
    // methods live in the GenericImplEntry registered below). Mirrors the
    // Case 3 clear and TS restoring receiverType.trait (trait-type.ts:512).
    if(c2_recv_id != "", {
      clear_provisional_trait_methods(c2_recv_id);
    });
    pop_impl_in_flight();
    // Drop the binder-kind registrations (same lifetime as the impl:
    // clearing an unregistered name is a no-op, so type binders are fine).
    {
      (sbk_i : usize) = usize(0);
      while(sbk_i < forall_names.len(), {
        match(
          forall_names.get(sbk_i),
          .Some(sbk_n) => clear_some_binder_kind(sbk_n, frame_lvl),
          .None => ()
        );
        sbk_i = (sbk_i + usize(1));
      });
    };
    // For inherent impls, trait_type = Unit (empty key — correct for registry).
    (trait_ty : TypeValue) = t_unit();
    trait_key_str := get_trait_key(trait_ty);
    entry := GenericImplEntry(
      trait_key_str,
      // 1. trait_key
      forall_names,
      // 2. forall_names
      forall_some_types,
      // 3. forall_some_types
      receiver_type_pattern,
      // 4. receiver_type_pattern
      trait_ty,
      // 5. trait_type
      method_names,
      // 6. field_names
      method_types,
      // 7. field_types
      method_values,
      // 8. field_values
      forall_env,
      // 9. definition_env
      impl_where_some_types,
      // 10. where_constraint_some_types
      impl_where_traits // 11. where_constraint_traits
    );
    register_generic_impl(entry);
    // Return the original local_env (without the generic frame leaked into scope).
    out_info := new_expr_info(local_env, t_unit());
    out_info.value = .Some(EvalValue.UnitVal);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    return(expr);
  });
  // ---------------------------------------------------------------------------
  // Case 3: Non-generic impl — impl(ReceiverType, method1: fn_def, …)
  // ---------------------------------------------------------------------------
  if(n_args < usize(2), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("impl requires a receiver type and at least one field.")
        )
      )
    );
  });
  // Evaluate the receiver type expression to update env.
  receiver_type_expr := match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
  saved_expected := ctx.expected_type;
  ctx.expected_type = .None;
  eval_receiver := evaluate_expression_raw(receiver_type_expr, local_env, ctx, exn);
  ctx.expected_type = saved_expected;
  // Get receiver type name for qualifying method names.
  rcv_tok := ast_expr_token(receiver_type_expr);
  receiver_name := rcv_tok.value.clone();
  // Advance local_env from receiver evaluation and capture the
  // receiver TypeValue itself so we can register methods against
  // its id in the trait-method registry below.
  (receiver_ty : TypeValue) = t_unit();
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_receiver)),
    .Some(ri) => {
      local_env = ri.env;
      match(
        ri.value,
        .None => (),
        .Some(rv) => match(
          rv,
          .TypeVal(tv) => {
            receiver_ty = tv;
          },
          _ => ()
        )
      );
    },
    .None => ()
  );
  receiver_type_id := type_id_or_empty(receiver_ty);
  // Pre-register each trait name in this impl so that recursive types
  // (e.g. `TreeNode :: enum(Branch(left : Box(Self)))` with
  // `derive(TreeNode, Clone)`) can find their own Clone impl while
  // the function body is being validated. Mirrors TS impl.ts:2911-2946:
  // collect each trait name, mark it, run field eval, unmark on the
  // way out.
  (pre_registered_trait_ids : ArrayList(String)) = ArrayList(String).new();
  if(receiver_type_id != "", {
    (preri : usize) = usize(1);
    while(preri < n_args, {
      match(
        args.get(preri),
        .None => (),
        .Some(pre_field_expr) => {
          // Skip name:value pairs — only trait constructors (or bare
          // trait names) qualify for pre-registration.
          is_colon_pair := (
            ast_expr_is_fn_call(pre_field_expr) &&
              ast_expr_is_fn_call_of(pre_field_expr, BK_COLON, .Some(usize(2)))
          );
          if(!is_colon_pair, {
            tname := ast_expr_token(pre_field_expr).value;
            if(tname.len() > usize(0), {
              first_byte := tname.as_bytes().get(usize(0));
              // Trait names start with an uppercase ASCII letter (mirrors
              // TS regex /^[A-Z]/).
              is_upper := match(
                first_byte,
                .Some(b) => ((b >= u8(65)) && (b <= u8(90))),
                .None => false
              );
              if(is_upper, {
                mark_concrete_impl_being_registered(receiver_type_id, tname);
                pre_registered_trait_ids.push(tname.clone());
              });
            });
          });
        }
      );
      preri = (preri + usize(1));
    });
  });
  // Mirror TS `context: { ...context, SelfType: receiverType }` so
  // that `Self` references inside method signatures (e.g.
  // `fn(self : Self) -> i32`) resolve to the receiver type during
  // field-body evaluation. Save and restore around the loop so we
  // don't leak the binding to the caller.
  old_self_type := ctx.self_type;
  ctx.self_type = .Some(receiver_ty);
  // Push a frame for the impl's field bindings (popped after the loop) —
  // mirrors TS impl.ts:623 `env = pushEnvFrame(env)` so the per-field
  // BARE-label bindings below don't leak into the module scope.
  local_env.push_frame(false);
  // Pending members (plans/LAZY_TOPLEVEL_BINDINGS.md P3): each DIRECT
  // colon-pair member is a definition scoped to this block. A sibling body
  // that references it before its position (`caller` calling `self.callee()`
  // defined below; mutual recursion) forces its evaluation through
  // `force_in_flight_field` (env.yo's lookup-miss hook); the loop below skips
  // members already forced. This replaces the pre-P3 shell pre-pass, whose
  // shells carried their own func_ids and needed codegen thunks. Like TS, no
  // member is bound as a local variable ahead of its position (it would
  // shadow names inside sibling bodies); forward refs go through `self.X` /
  // `Self.X`. Trait-constructor members keep the provisional signature splice
  // below and evaluate in place.
  c3_fields := ArrayList(ImplPendingField).new();
  (c3_pi : usize) = usize(1);
  while(c3_pi < n_args, {
    match(
      args.get(c3_pi),
      .Some(c3_fe) => if(ast_expr_is_fn_call(c3_fe) && ast_expr_is_fn_call_of(c3_fe, BK_COLON, .Some(usize(2))), {
        c3_lbl := match(
          c3_fe,
          .FnCall(_, _, c3_ca, _, _) => match(c3_ca.get(usize(0)), .Some(l) => ast_expr_token(l).value.clone(), .None => String.new()),
          .Atom(_, _) => String.new()
        );
        c3_fields.push(make_impl_pending_field(c3_lbl, c3_fe, c3_pi, false));
      }),
      .None => ()
    );
    c3_pi = (c3_pi + usize(1));
  });
  c3_rec := ImplInFlight(
    recv_id : receiver_type_id.clone(),
    is_generic : false,
    receiver_ty : receiver_ty,
    receiver_name : receiver_name.clone(),
    env : local_env,
    ctx : ctx,
    fields : c3_fields,
    current_top_index : usize(0),
    current_trait_ty : Option(TypeValue).None,
    forall_names : ArrayList(String).new()
  );
  push_impl_in_flight(c3_rec);
  // Process each field expression: `name : fn_def` or a trait constructor
  // like `Trait(name: fn_def, ...)` whose inner args are colon pairs.
  (field_idx : usize) = usize(1);
  while(field_idx < n_args, {
    match(
      args.get(field_idx),
      .None => (),
      .Some(field_expr) => {
        c3_rec.current_top_index = field_idx;
        // Collect method colon-pair expressions from either the direct form
        // `name : fn_def` or from inside a trait constructor `Trait(name: fn_def, ...)`.
        // Also try to capture the trait TypeValue (when present) so each
        // method body can be evaluated with the correct `expected_type` —
        // anonymous lambdas like `(self) -> __yo_op_not(self)` in
        // `impl(bool, LogicalNot((!) : ((self) -> ...)))` need the trait's
        // field-type-by-label to typecheck.
        (method_exprs : ArrayList(AstExpr)) = ArrayList(AstExpr).new();
        (current_trait_ty : Option(TypeValue)) = Option(TypeValue).None;
        // Phase N (THREAD_SAFETY): negative trait impl `impl(T, !(Trait))`.
        // Marker-only (the trait must have no methods) + register, so positive
        // impls / `Type.impls` see the override. Mirrors impl.ts:827-866 (detect)
        // + 3000-3026 (marker-check + register). The existing trait-constructor
        // handling below is a no-op for `!(...)` (its head `!` is not a trait and
        // its arg isn't a colon-pair), so no skip is needed.
        is_negative_field := ast_expr_is_fn_call_of(field_expr, "!", .Some(usize(1)));
        if(is_negative_field, {
          neg_inner := match(
            field_expr,
            .FnCall(_, _, na, _, _) => match(na.get(usize(0)), .Some(x) => x, .None => make_err_expr()),
            .Atom(_, _) => make_err_expr()
          );
          neg_head := match(neg_inner, .FnCall(_, fbn, _, _, _) => fbn, .Atom(_, _) => neg_inner);
          match(
            _try_lookup_trait_type(neg_head, local_env, ctx, exn),
            .Some(neg_trait_ty) => {
              has_method := match(
                neg_trait_ty,
                .TraitT(_, _, _, ftys, _, _, _, _, _, _) => {
                  (mi : usize) = usize(0);
                  (hm : bool) = false;
                  while((mi < ftys.len()) && !hm, {
                    match(
                      ftys.get(mi),
                      .Some(ft) => if(is_function_type(ft), {
                        hm = true;
                      }),
                      .None => ()
                    );
                    mi = (mi + usize(1));
                  });
                  hm
                },
                _ => false
              );
              if(has_method, {
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(field_expr),
                      `Cannot use '!(...)' — negative impls are only allowed for marker traits (traits without methods).`
                    )
                  )
                );
              });
              if(receiver_type_id != "", {
                register_negative_impl(receiver_type_id.clone(), get_trait_key(neg_trait_ty));
              });
            },
            .None => ()
          );
        });
        // Phase A (THREAD_SAFETY): a manual `impl(T, Send())` / `impl(T, Acyclic())`
        // requires `pragma(Pragma.AllowUnsafe)`. Mirrors impl.ts:2907-2928.
        if(!is_negative_field && (ast_expr_is_fn_call(field_expr) && !ast_expr_is_fn_call_of(field_expr, BK_COLON, .Some(usize(2)))), {
          pos_trait_name := match(
            field_expr,
            .FnCall(_, pfb, _, _, _) => ast_expr_token(pfb).value,
            .Atom(_, _) => String.new()
          );
          if((pos_trait_name == "Send") || (pos_trait_name == "Acyclic"), {
            if(!is_implicitly_unsafe_capable_file(Option(String).Some(ast_expr_token(field_expr).module_path.clone())), {
              suffix := if(pos_trait_name == "Send", String.from("send across threads"), String.from("declare Acyclic"));
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(field_expr),
                    `Manual 'impl(..., ${pos_trait_name}())' requires pragma(Pragma.AllowUnsafe). Add a '// SAFETY:' comment explaining why the type is safe to ${suffix}.`
                  )
                )
              );
            });
          });
        });
        if(ast_expr_is_fn_call(field_expr) && ast_expr_is_fn_call_of(field_expr, BK_COLON, .Some(usize(2))), {
          // Direct colon pair: add it directly.
          method_exprs.push(field_expr);
        });
        if(ast_expr_is_fn_call(field_expr) && !ast_expr_is_fn_call_of(field_expr, BK_COLON, .Some(usize(2))) && !ast_expr_is_fn_call_of(field_expr, BK_WHERE, .None), {
          // Non-colon FnCall: treat as trait constructor, extract its colon-pair args.
          // (`where(...)` args are skipped — see the generic loop above.)
          trait_inner_args := match(
            field_expr,
            .FnCall(_, _, tia, _, _) => tia,
            .Atom(_, _) => ArrayList(AstExpr).new()
          );
          // Look up the trait type by atom name in the env so we can
          // resolve each field's type by label below. Worst case (the
          // trait expr isn't a simple atom, or the var binding isn't
          // a TraitT): `_try_lookup_trait_type` returns `.None`, which
          // downstream treats identically to legacy "no expected_type"
          // behavior.
          trait_fn_expr := match(
            field_expr,
            .FnCall(_, fb, _, _, _) => fb,
            .Atom(_, _) => make_err_expr()
          );
          current_trait_ty = _try_lookup_trait_type(trait_fn_expr, local_env, ctx, exn);
          // Record that this type implements the trait (by its base id) in the
          // type's trait list, so `Type.impls(T, Trait)` resolves by identity at
          // trait-checking step 4 — mirroring TS pushing the impl'd trait onto
          // `receiverType.trait.fields`. Without this, concrete method-trait
          // satisfaction has no id-based path (it only ever worked via the
          // now-removed nameless-trait name collision).
          match(
            current_trait_ty,
            .Some(ctt) => if(receiver_type_id != "", {
              // Self-constraint gate (impl.ts:3269, checkTypeImplementsSelfConstraints):
              // a trait with a `where(Self <: X)` clause can only be implemented
              // on a receiver satisfying X — e.g. `impl(ValueStruct, Dispose(...))`
              // must be rejected because `Dispose` requires `Self <: Rc`.
              match(
                g_check_self_constraints_fn,
                .Some(cf) => match(
                  cf(receiver_ty, ctt, local_env),
                  .Some(sc_msg) => {
                    exn.throw(
                      dyn(format_error_message(ast_expr_token(expr), sc_msg))
                    );
                  },
                  .None => ()
                ),
                .None => ()
              );
              match(
                g_register_trait_value_fn,
                .Some(rf) => rf(receiver_type_id.clone(), ctt),
                .None => ()
              );
            }),
            .None => ()
          );
          (ti2 : usize) = usize(0);
          while(ti2 < trait_inner_args.len(), {
            match(
              trait_inner_args.get(ti2),
              .None => (),
              .Some(inner_e) => {
                if(ast_expr_is_fn_call(inner_e) && ast_expr_is_fn_call_of(inner_e, BK_COLON, .Some(usize(2))), {
                  method_exprs.push(inner_e);
                });
              }
            );
            ti2 = (ti2 + usize(1));
          });
        });
        // In-flight method signatures BEFORE evaluating the member bodies —
        // the impl-path port of TS's receiver-trait splice (trait-type.ts:
        // 176-203 via evaluateImplFieldList; restored at trait-type.ts:512).
        // A member body that calls back into this trait's own methods on the
        // receiver (recursive types: `TreeNode :: enum(..., Branch(left :
        // Box(Self), ...))` + `derive(TreeNode, Clone)` — validating the
        // derived clone specializes `Box(TreeNode).clone`, whose body calls
        // `TreeNode.clone`) must resolve the method TYPE from the trait
        // signature while the real FuncVal is still being evaluated. Without
        // it the lookup misses, the call degrades to the non-Func unit
        // fallback, and codegen emits an argument-less void call
        // (tests/derive_clone_complex.test.yo). Entries carry `value : None`
        // (TS: assignedValue undefined during the window) and are cleared
        // right after the member loop.
        match(
          current_trait_ty,
          .Some(pv_ctt) => match(
            pv_ctt,
            .TraitT({ field_labels : pv_labels, field_types : pv_types, id : pv_trait_id }) => if(receiver_type_id != "", {
              (pvfi : usize) = usize(0);
              while(pvfi < pv_labels.len(), {
                pv_lbl := match(pv_labels.get(pvfi), .Some(l) => l, .None => String.from(""));
                pv_fty := match(pv_types.get(pvfi), .Some(t) => t, .None => TypeValue.Unit);
                if((pv_lbl != "") && is_function_type(pv_fty), {
                  register_provisional_trait_method(
                    receiver_type_id.clone(),
                    MethodEntry(
                      label : pv_lbl.clone(),
                      ty : _substitute_self_in_method_ty(pv_fty, receiver_ty),
                      value : Option(EvalValue).None,
                      source_trait_id : pv_trait_id.clone(),
                      needs_pointer_conversion : false,
                      self_type : Option(TypeValue).Some(receiver_ty)
                    )
                  );
                });
                pvfi = (pvfi + usize(1));
              });
            }),
            _ => ()
          ),
          .None => ()
        );
        // Register each collected colon-pair method expression.
        // Working-trait bindings: fields already evaluated for THIS trait
        // entry, visible to later fields' `Self.X` references — and scoped
        // PER trait entry, so `Self.Output` inside the Index impl sees
        // Index's `Output : u8`, not the `Output : Self` an earlier Add
        // impl registered under the same receiver id in the global
        // registry. Mirrors TS's progressive `receiverType.trait` attach.
        c3_rec.current_trait_ty = current_trait_ty;
        old_wt_labels_c3 := ctx.current_impl_trait_field_labels;
        old_wt_values_c3 := ctx.current_impl_trait_field_types;
        ctx.current_impl_trait_field_labels = ArrayList(String).new();
        ctx.current_impl_trait_field_types = ArrayList(TypeValue).new();
        (mj : usize) = usize(0);
        while(mj < method_exprs.len(), {
          match(
            method_exprs.get(mj),
            .None => (),
            .Some(meth_expr) => {
              // A DIRECT member routes through its pending entry (a sibling
              // may already have forced it — plans/LAZY_TOPLEVEL_BINDINGS.md
              // P3); trait-constructor members evaluate in place.
              c3_pf_opt := cond(
                current_trait_ty.is_none() => impl_direct_field_at(c3_rec, field_idx),
                true => Option(ImplPendingField).None
              );
              c3_rec.env = local_env;
              match(
                c3_pf_opt,
                .Some(c3_pf) => match(
                  c3_pf.state,
                  .Done => (),
                  .Failed => {
                    exn.throw(dyn(match(c3_pf.failure, .Some(m) => m.clone(), .None => String.from("impl member failed"))));
                  },
                  .Forcing => {
                    exn.throw(dyn(format_error_message(ast_expr_token(meth_expr), `internal error: impl member "${c3_pf.label}" reached by the field loop while it is being forced`)));
                  },
                  .Unforced => {
                    _run_impl_field(c3_pf, c3_rec, ctx, exn);
                  }
                ),
                .None => {
                  _c3_eval_colon_pair(meth_expr, current_trait_ty, c3_rec, Option(ImplPendingField).None, ctx, exn);
                }
              );
              local_env = c3_rec.env;
            }
          );
          mj = (mj + usize(1));
        });
        // Member evaluation done — drop the in-flight signatures (the real
        // entries were registered by the loop above / the defaults fill
        // below). Mirrors TS restoring receiverType.trait (trait-type.ts:512).
        if(receiver_type_id != "", {
          clear_provisional_trait_methods(receiver_type_id);
        });
        // Fill trait `?=` DEFAULT methods the impl did not override. The trait
        // definition registered each default FuncVal in the trait-defaults
        // side-table (trait.yo `register_trait_default`, keyed by trait id +
        // label; TraitT stores no per-field defaults). Without this fill,
        // `impl(String, Eq(str)((==) : ...))` registers NO `(!=)` for the
        // str-rhs overload — `optimize != ""` then resolves to the ONLY `(!=)`
        // in the registry, `Eq(String).(!=)` (other : String), and def-time
        // body eval throws `Cannot unify "String" and "str"`, halting the
        // enclosing fn's ExprInfo population (→ stage-2 "Failed to transpile"
        // cascades). Mirrors TS trait-type.ts:418-489, which fills missing
        // fields from `defaultValueExpr`/`defaultValue` when the trait value is
        // built. Function-typed fields only; `Self` in the field type is
        // substituted to the concrete receiver like the provided-method path.
        match(
          current_trait_ty,
          .Some(ctt2) => match(
            ctt2,
            .TraitT({ field_labels : dtf_labels, field_types : dtf_types, id : dtf_trait_id }) => {
              (dfi : usize) = usize(0);
              while(dfi < dtf_labels.len(), {
                d_label := match(dtf_labels.get(dfi), .Some(l) => l, .None => String.from(""));
                d_ty := match(dtf_types.get(dfi), .Some(t) => t, .None => TypeValue.Unit);
                // Did the impl provide this field?
                (d_provided : bool) = false;
                (dmi : usize) = usize(0);
                while((dmi < method_exprs.len()) && !d_provided, {
                  match(
                    method_exprs.get(dmi),
                    .Some(dme) => {
                      dme_name := match(
                        dme,
                        .FnCall(_, _, dca, _, _) => match(dca.get(usize(0)), .Some(dn) => ast_expr_token(dn).value, .None => String.from("")),
                        .Atom(_, _) => String.from("")
                      );
                      if(dme_name == d_label, {
                        d_provided = true;
                      });
                    },
                    .None => ()
                  );
                  dmi = (dmi + usize(1));
                });
                if(!d_provided && is_function_type(d_ty) && (receiver_type_id != ""), {
                  match(
                    get_trait_default(dtf_trait_id.clone(), d_label.clone()),
                    .Some(d_val) => {
                      d_sub_ty := _freshen_return_only_somes(_substitute_self_in_method_ty(d_ty, receiver_ty));
                      // PER-IMPL MATERIALIZATION (TS trait-type.ts:418-489
                      // materializes defaults in the impl's env where Self is
                      // concrete): the shared default FuncVal's body was
                      // evaluated at TRAIT-VALUE creation with Self UNBOUND —
                      // its `Self.(==)` never resolved when the receiver had
                      // multiple `==` overloads (the multi-overload defer needs
                      // a bound receiver), and with a non-generic registered
                      // type no call-time spec ever re-evaluates the body, so
                      // codegen FTT'd (impl.test.yo heterogeneous `!=`,
                      // root-cause map layer 8). Mint a fresh-id body clone and
                      // evaluate it HERE with Self = the impl receiver and the
                      // params bound at the Self-substituted types; a failing
                      // materialization falls back to the shared default.
                      d_reg_val := match(
                        d_val,
                        .FuncVal(d_fvd, d_cvs) => {
                          d_fresh_id := (String.from("fn_") + random_id(env.module_path));
                          d_body_clone := clone_expr_fresh_ids(d_fvd.*.body);
                          d_fresh := EvalValue.FuncVal(
                            box(
                              FuncValData(
                                forall_names : d_fvd.*.forall_names,
                                params : d_fvd.*.params,
                                param_type_names : d_fvd.*.param_type_names,
                                evidence_params : d_fvd.*.evidence_params,
                                body : d_body_clone.clone(),
                                cap_names : d_fvd.*.cap_names,
                                cap_tys : d_fvd.*.cap_tys,
                                func_id : d_fresh_id.clone(),
                                env_key : d_fvd.*.env_key
                              )
                            ),
                            d_cvs
                          );
                          register_func_type(d_fresh_id.clone(), d_sub_ty.clone());
                          d_saved_self := ctx.self_type;
                          ctx.self_type = Option(TypeValue).Some(receiver_ty.clone());
                          ___df := env.push_frame(false);
                          d_pts := match(d_sub_ty, .Func({ param_types : d_ppts }) => d_ppts, _ => ArrayList(TypeValue).new());
                          // The declared `inout` flags, read off the same
                          // Self-substituted type the signature is emitted
                          // from. Pointer-ness travels through TWO channels
                          // (issues/fixed/specialized-inout-param-loses-ref-with-comptime-arg.md):
                          // the C signature from `FuncMeta.param_is_ref`, the
                          // body's `p` vs `(*p)` from `Variable.is_ref` on the
                          // binding the body's atoms record. Binding the
                          // params here with `is_ref` unset made every
                          // `inout(self)` default body read `self.field` on a
                          // pointer and pass `&(self)` — a `T**` — to sibling
                          // methods (issues/fixed/trait-default-inout-self-bound-by-value.md).
                          d_p_is_ref := match(
                            d_sub_ty,
                            .Func({ meta : d_fm }) => d_fm.*.param_is_ref,
                            _ => ArrayList(bool).new()
                          );
                          (d_pi : usize) = usize(0);
                          while(d_pi < d_fvd.*.params.len(), {
                            d_pn := match(d_fvd.*.params.get(d_pi), .Some(n) => n, .None => String.from(""));
                            d_pt := match(d_pts.get(d_pi), .Some(t) => t, .None => t_unit());
                            ___dpv := add_variable_to_env(
                              env,
                              d_pn,
                              d_pt,
                              Option(EvalValue).Some(create_unknown_val(d_pt)),
                              false,
                              false,
                              false,
                              false,
                              synthetic_token(d_pn, env.module_path)
                            );
                            match(
                              ___dpv,
                              .Some(d_pvar) => {
                                d_pvar.is_parameter = true;
                                if(match(d_p_is_ref.get(d_pi), .Some(b) => b, .None => false), {
                                  d_pvar.is_ref = true;
                                  d_pvar.is_reassignable = true;
                                });
                              },
                              .None => ()
                            );
                            d_pi = (d_pi + usize(1));
                          });
                          d_out := ArrayList(AstExpr).new();
                          d_depths := forcing_depths();
                          _materialize_default_body(d_body_clone, d_sub_ty.clone(), d_fresh_id.clone(), env, ctx, d_out);
                          truncate_forcing_depths(d_depths);
                          env.pop_frame();
                          ctx.self_type = d_saved_self;
                          // Only adopt the clone when its body eval SUCCEEDED
                          // (out non-empty); otherwise rebuild the shared
                          // default from its own fields (EvalValue is not
                          // Clone) so prior behavior is kept.
                          cond(
                            (d_out.len() > usize(0)) => d_fresh,
                            true => EvalValue.FuncVal(
                              box(
                                FuncValData(
                                  forall_names : d_fvd.*.forall_names,
                                  params : d_fvd.*.params,
                                  param_type_names : d_fvd.*.param_type_names,
                                  evidence_params : d_fvd.*.evidence_params,
                                  body : d_fvd.*.body,
                                  cap_names : d_fvd.*.cap_names,
                                  cap_tys : d_fvd.*.cap_tys,
                                  func_id : d_fvd.*.func_id,
                                  env_key : d_fvd.*.env_key
                                )
                              ),
                              d_cvs
                            )
                          )
                        },
                        _ => d_val
                      );
                      register_type_trait_method(
                        receiver_type_id,
                        MethodEntry(
                          label : d_label.clone(),
                          ty : d_sub_ty,
                          value : Option(EvalValue).Some(d_reg_val),
                          source_trait_id : type_id_or_empty(ctt2),
                          needs_pointer_conversion : false,
                          self_type : Option(TypeValue).None
                        )
                      );
                    },
                    .None => ()
                  );
                });
                dfi = (dfi + usize(1));
              });
            },
            _ => ()
          ),
          .None => ()
        );
        ctx.current_impl_trait_field_labels = old_wt_labels_c3;
        ctx.current_impl_trait_field_types = old_wt_values_c3;
      }
    );
    field_idx = (field_idx + usize(1));
  });
  // Pop the impl's field-binding frame (mirrors TS impl.ts popping the
  // frame pushed at 623). The bare/qualified label bindings above are
  // scoped to this impl; dispatch goes through the trait-method registry.
  local_env.pop_frame();
  // Unmark each trait pre-registered above. Mirrors TS impl.ts:2942-2946
  // `finally { for (const key of preRegisteredKeys) ... }`.
  (postri : usize) = usize(0);
  pre_n := pre_registered_trait_ids.len();
  while(postri < pre_n, {
    match(
      pre_registered_trait_ids.get(postri),
      .None => (),
      .Some(tname) => unmark_concrete_impl_being_registered(receiver_type_id, tname)
    );
    postri = (postri + usize(1));
  });
  pop_impl_in_flight();
  // Sweep any provisional in-flight trait-method entries for this receiver.
  // Normally try_to_implement_trait_with_arguments_by_trait_type clears its
  // own entries after its member loop; this catches a member-eval throw that
  // was swallowed upstream (def-time trial walls) and skipped that clear —
  // a stale valueless entry here would shadow the REAL registration in every
  // later lookup (provisional entries are consulted first).
  clear_provisional_trait_methods(receiver_type_id);
  // Restore self_type so the impl's parent scope sees its prior value.
  ctx.self_type = old_self_type;
  // Set ExprInfo on the impl expression and return.
  out_info := new_expr_info(local_env, t_unit());
  out_info.value = .Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
/// Adapter — `find_methods_from_generic_impls` returns
/// `ArrayList(MethodCandidate)`, but `env.yo`'s callback slot
/// expects `ArrayList(MethodEntry)` (a richer record carrying the
/// method name + the source trait id). Project each candidate up
/// into the registry shape so call sites see one uniform type.
///
/// `source_trait_id` is now threaded through from the candidate —
/// `find_methods_from_generic_impls` populates it from each
/// matching `GenericImplEntry.trait_key`, so the adapter passes
/// the value forward unchanged.
_find_methods_from_generic_impls_as_method_entries :: (
  fn(env : Environment, method_name : String, ty : TypeValue) -> ArrayList(MethodEntry)
)({
  candidates := find_methods_from_generic_impls(ty, method_name, env);
  out := ArrayList(MethodEntry).new();
  n := candidates.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      candidates.get(i),
      .Some(c) => {
        out.push(
          MethodEntry(
            label : method_name.clone(),
            ty : c.method_type,
            value : c.method_value,
            source_trait_id : c.source_trait_id,
            needs_pointer_conversion : false,
            // Generic-impl candidates come from
            // `find_methods_from_generic_impls` which already
            // resolved any `Self`-shaped fields against the
            // concrete receiver during unification — no
            // additional SelfType stamp is needed here.
            self_type : Option(TypeValue).None
          )
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});
// Install the adapter as env.yo's generic-impl-fallback callback.
// Runs once at module-init time (same pattern as
// `_trait_checking_init` in `evaluator/trait_checking.yo:1079`).
_impl_generic_impl_fallback_init := (fn() -> bool)({
  set_find_methods_from_generic_impls_fn(
    _find_methods_from_generic_impls_as_method_entries
  );
  set_force_in_flight_field_fn(force_in_flight_field);
  true
})();
