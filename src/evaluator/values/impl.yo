//! evaluate_module_value — evaluates `impl` module/struct value expressions.
//!
//! 1:1 port of the non-generic path + simplified generic-impl path of
//! `evaluateModuleValue` from `src/evaluator/values/impl.ts`.
//!
//! Phase 3.5 changes (generic impl support):
//!   - Generic impl (generic): now registers in the global generic impl registry.
//!   - Forall params extracted manually as SomeT TypeValues and added to env.
//!   - Receiver type is evaluated with SomeTs in scope.
//!   - Methods are evaluated and stored in GenericImplEntry.
//!   - tryCreateForwardShell: SUPERSEDED — sibling forward references are
//!     served by forcing the referenced member (plans/LAZY_TOPLEVEL_BINDINGS.md
//!     P3, `force_in_flight_field`); reEvaluateFunctionType: still deferred.
//!   - checkOrphanRule / checkDuplicateImpl: still skipped.
//!
//! Phase 3 behavior (non-generic) — unchanged:
//!   - Methods are added to env with qualified names (ReceiverType.method_name).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
_(env : impl_dbg_env) :: import("std/env");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom,
  make_err_expr,
  clone_expr_fresh_ids,
  BK_BEGIN,
  BK_GENERIC,
  BK_COLON,
  BK_IMPL_LOWER,
  BK_WHERE,
  BK_TUPLE
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set,
  lookup_some_resolved_concrete,
  lookup_trait_ctor_fid,
  take_active_where_trait_ids,
  restore_active_where_trait_ids
} :: import("../../expr_info.yo");
{
  Environment,
  Variable,
  add_variable_to_env,
  get_variables_from_env,
  snapshot_env,
  synthetic_token,
  get_funcval_cap_vars,
  make_capture_variable,
  mint_funcval_env_key,
  register_funcval_cap_vars,
  set_find_methods_from_generic_impls_fn,
  set_force_in_flight_field_fn
} :: import("../../env.yo");
{
  MethodEntry,
  register_type_trait_method,
  note_inherent_method_site,
  get_type_trait_methods_by_name,
  get_trait_default,
  register_provisional_trait_method,
  get_provisional_trait_methods_by_name,
  clear_provisional_trait_methods,
  type_id_or_empty,
  registration_owner
} :: import("./type_trait_methods.yo");
{ FuncMeta, TypeValue } :: import("../../types/definitions.yo");
{ type_to_string } :: import("../../types/string.yo");
{ t_unit, t_type, t_some_t, t_usize, register_some_binder_kind, clear_some_binder_kind, generate_some_type_id } :: import("../../types/creators.yo");
{ is_some_type, is_function_type, is_expr_type } :: import("../../types/guards.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ subst_new, subst_add, subst_set_self, substitute } :: import("../../types/substitution.yo");
{ get_all_some_types } :: import("../../types/utils.yo");
