//! evaluate_tuple_value — evaluates tuple value literal expressions.
//!
//! Evaluates `tuple(e0, e1, …)` runtime literals:
//!   * `tuple()` (zero args) yields the unit value `()` of type `()`.
//!   * Disallows labelled fields (`x: e`) — only allowed in tuple types.
//!   * Threads the expected tuple type into per-element evaluation when present.
//!   * Disallows `type` values stored as tuple elements.
//!   * Converts each element's type to its runtime form (unless the expected
//!     element type is comptime-only).
//!   * Records `runtime_arg_exprs_in_order` and the resulting tuple type/value
//!     onto the call expression's ExprInfo.
//!
//! `set_expr_as_needs_to_call_dup` for field values IS wired (rc layer 4), and
//! a RUNTIME tuple literal gets an owning result temp via
//! `attach_temp_variable_to_expr` — the temp's scope-end drop is what releases
//! the tuple's own +1 per RC-typed field when the literal is passed straight
//! to a call (see the end of `evaluate_tuple_value`).
{ String } :: import("std/string");
import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  make_err_expr,
  ast_expr_is_atom,
  ast_expr_strip_borrow_marker,
  ast_place_text,
  BF_ADDRESS_OF,
  BK_BORROW_MUT,
  BK_TUPLE
} :: import("../../expr.yo");
{
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ Environment, Variable, env_adopt } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx } :: import("../context.yo");
{ EvalValue, is_type_value, is_unknown_val, value_cell_new } :: import("../../value.yo");
{ TypeValue, TypeValueNode, shared_list } :: import("../../types/definitions.yo");
{
  is_tuple_type,
  is_comptime_int_type,
  is_comptime_float_type,
  is_comptime_string_type,
  is_comptime_list_type
} :: import("../../types/guards.yo");
{ convert_comptime_type_to_runtime_type } :: import("../../types/env_lookup.yo");
{
  set_expr_as_needs_to_call_dup,
  attach_temp_variable_to_expr,
  lend_place_reference_type,
  variable_is_reference_binding,
  deref_rule_applies,
  is_reference_deref_site,
  reject_reference_without_deref
} :: import("../utils.yo");
{ type_to_string } :: import("../../types/string.yo");
{ format_error_message, format_eval_failure } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ evaluate_expression_guarded } :: import("../exprs/expr.yo");
// Local comptime-only check covering the primitive cases the evaluator
// actually hits for tuple element types today.
is_comptime_only_type_local :: (fn(t : &TypeValue) -> bool)(
  cond(
    is_comptime_int_type(t) => true,
    is_comptime_float_type(t) => true,
    is_comptime_string_type(t) => true,
    is_comptime_list_type(t) => true,
    true => false
  )
);
// Result struct returned by `evaluate_tuple_elements_value`.
EvalTupleElementsValueResult :: struct(
  field_labels : ArrayList(String),
  field_types : ArrayList(TypeValue),
  values : ArrayList(Option(EvalValue)),
  env : Environment,
  runtime_arg_exprs_in_order : ArrayList(AstExpr)
);
// Evaluate a single tuple element expression and append its evaluated form
// onto `runtime_arg_exprs_in_order`.
EvalTupleElementResult :: struct(
  ty : TypeValue,
  value : Option(EvalValue),
  env : Environment
);
evaluate_tuple_element_value :: (
  fn(
    expr : &AstExpr,
    tuple_field_index : usize,
    env_in : &Environment,
    ctx : &EvalContext,
    runtime_arg_exprs_in_order : &mut ArrayList(AstExpr),
    exn : Exception
  ) -> EvalTupleElementResult
)({
  (env : Environment) = env_in;
  // Reject labelled fields: `x: rhs`.
  if(ast_expr_is_fn_call_of(expr, ":", Option(usize).Some(usize(2))), {
    args := match(expr, .FnCall(_, _, Rc(a), _, _) => a.clone(), .Atom(_, _) => ArrayList(AstExpr).new());
    lhs_expr := match(args.get(usize(0)), .Some(a) => a, .None => expr);
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(&lhs_expr),
          String.from("Labelled field is not allowed in tuple value.")
        )
      )
    );
  });
  // Compute the expected element type from the tuple-shaped expected_type, if any.
  (expected_field_type_opt : Option(TypeValue)) = Option(TypeValue).None;
  match(
    ctx.expected_type,
    .Some(et) => cond(
      is_tuple_type(&et.ty) => {
        match(
          &et.ty,
          Rc(.Tuple(_, types)) => {
            match(
              types.get(tuple_field_index),
              .Some(t) => {
                expected_field_type_opt = Option(TypeValue).Some(t);
                ();
              },
              .None => {
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(expr),
                      `Incompatible types: the tuple has more fields than the expected ${type_to_string(&et.ty)}.`
                    )
                  )
                );
              }
            );
            ();
          },
          _ => ()
        );
        ();
      },
      true => {
        ty_str := type_to_string(&et.ty);
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(expr),
              `Incompatible types:\n- Expected: ${ty_str}\n- Given   : a tuple literal`
            )
          )
        );
      }
    ),
    .None => ()
  );
  // A LEND element, `&place` / `&mut place` (decision 43 step 3, T9): the
  // tuple holds a reference to the place, as a struct constructor's
  // reference field does. The marker is peeled, the place evaluated against
  // the expected reference's pointee, and the element typed as the lend.
  lend_is_mut := ast_expr_is_fn_call_of(expr, BK_BORROW_MUT, Option(usize).Some(usize(1)));
  is_lend := (lend_is_mut || ast_expr_is_fn_call_of(expr, BF_ADDRESS_OF, Option(usize).Some(usize(1))));
  elem_expr := if(is_lend, ast_expr_strip_borrow_marker(expr), expr.clone());
  elem_expected := match(
    &expected_field_type_opt,
    .Some(Rc(.Reference(et_pointee, _, _))) => if(is_lend, Option(TypeValue).Some(Rc.clone(et_pointee)), expected_field_type_opt.clone()),
    _ => expected_field_type_opt.clone()
  );
  // Evaluate the rhs expression with `expected_type` updated for this field.
  saved_expected := ctx.expected_type;
  ctx.expected_type = match(
    &elem_expected,
    .Some(t) => Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : Rc.clone(t), env : env)),
    .None => Option(ExpectedTypeCtx).None
  );
  evaluated_rhs_gout := ArrayList(AstExpr).new();
  evaluated_rhs_gerr := evaluate_expression_guarded(&elem_expr, &env, ctx, &mut evaluated_rhs_gout);
  ctx.expected_type = saved_expected;
  match(evaluated_rhs_gerr, .Some(evaluated_rhs_ge) => exn.throw(evaluated_rhs_ge), .None => ());
  evaluated_rhs := match(evaluated_rhs_gout.get(usize(0)), .Some(evaluated_rhs_g) => evaluated_rhs_g, .None => make_err_expr());
  // `&r` of a reference binding names the referent, spelled `&r.*` (E0926,
  // decision 43 step 2 N1e-1), as at a constructor's reference field.
  if(is_lend && ast_expr_is_atom(&evaluated_rhs), {
    match(
      match(expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&evaluated_rhs)), .Some(lr_info) => lr_info.source_variable, .None => Option(Variable).None),
      .Some(lr_var) => if(variable_is_reference_binding(&lr_var) && deref_rule_applies(ast_expr_token(&evaluated_rhs), ctx) && !is_reference_deref_site(ast_expr_token(&evaluated_rhs)), {
        reject_reference_without_deref(&lr_var, ast_expr_token(&evaluated_rhs), u8(2), ctx, exn);
      }),
      .None => ()
    );
  });
  // Mark the field value copy-semantics: a named RC value moved into the
  // tuple literal gets a deferred `___dup` (without it the literal aliased
  // the element's refcount and scope-end drops over-released, rc layer 4).
  // A lend stores the place's address and copies no ownership: a dup paired
  // with the place's own scope-end drop would be cancelled as a move, and
  // the place would leak.
  if(!is_lend, {
    set_expr_as_needs_to_call_dup(&evaluated_rhs, ctx, exn, "field-store");
  });
  // Look up the resulting ExprInfo for the rhs.
  rhs_info_opt := expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&evaluated_rhs));
  rhs_info := match(
    rhs_info_opt,
    .Some(info) => info,
    .None => {
      exn.throw(
        dyn(
          format_eval_failure(
            ast_expr_token(expr),
            `Failed to evaluate the tuple field: ${ast_expr_to_string(expr)}`
          )
        )
      );
      new_expr_info(&env, Rc.new(TypeValueNode.Unit)) // unreachable
    }
  );
  env_adopt(&env, &rhs_info.env);
  // Reject `type` values stored as tuple elements.
  if(is_type_value(&rhs_info.value), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Cannot store a type value in tuple, please use module instead:\n  ${ast_expr_to_string(expr)}`
        )
      )
    );
  });
  // Convert to runtime type unless the expected field type is comptime-only.
  // A lend's type is its reference over the place.
  (lend_ty : Option(TypeValue)) = if(is_lend, lend_place_reference_type(&evaluated_rhs, &rhs_info, lend_is_mut, ctx), Option(TypeValue).None);
  if(is_lend && lend_ty.is_none(), {
    l_place := ast_place_text(&elem_expr);
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `\`${if(lend_is_mut, "&mut ", "&")}${l_place}\` cannot be lent into a tuple: a tuple's reference element lends a binding's place (\`&x\`, \`&x.f\`) or a raw pointer's referent (\`&p.*\`). Bind the place to a local first.`
        )
      )
    );
  });
  child_type := match(
    lend_ty,
    .Some(lt) => lt,
    .None => match(
      expected_field_type_opt,
      .Some(et) => cond(
        is_comptime_only_type_local(&et) => Rc.clone(rhs_info.ty),
        true => convert_comptime_type_to_runtime_type(&rhs_info.ty, &env)
      ),
      .None => convert_comptime_type_to_runtime_type(&rhs_info.ty, &env)
    )
  );
  runtime_arg_exprs_in_order.push(evaluated_rhs);
  EvalTupleElementResult(
    ty : child_type,
    // A lend is the place's runtime address, never a known value.
    value : if(is_lend, Option(EvalValue).None, rhs_info.value),
    env : env
  )
});
// Evaluate every element of a tuple value, returning parallel
// labels/types/values plus the threaded environment.
evaluate_tuple_elements_value :: (
  fn(
    args : &ArrayList(AstExpr),
    env_in : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> EvalTupleElementsValueResult
)({
  (env : Environment) = env_in;
  field_labels := ArrayList(String).new();
  field_types := ArrayList(TypeValue).new();
  values := ArrayList(Option(EvalValue)).new();
  runtime_arg_exprs_in_order := ArrayList(AstExpr).new();
  (i : usize) = usize(0);
  while(i < args.len(), {
    arg := match(args.get(i), .Some(a) => a, .None => make_err_expr());
    result := evaluate_tuple_element_value(
      &arg,
      i,
      &env,
      ctx,
      &mut runtime_arg_exprs_in_order,
      exn
    );
    field_labels.push(i.to_string());
    field_types.push(Rc.clone(result.ty));
    values.push(result.value);
    env_adopt(&env, &result.env);
    i = (i + usize(1));
  });
  EvalTupleElementsValueResult(
    field_labels : field_labels,
    field_types : field_types,
    values : values,
    env : env,
    runtime_arg_exprs_in_order : runtime_arg_exprs_in_order
  )
});
// Evaluate a `tuple(...)` call expression.
evaluate_tuple_value :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  if(!ast_expr_is_fn_call_of(expr, BK_TUPLE, Option(usize).None), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Expected tuple, got non-tuple expression")
        )
      )
    );
  });
  args := match(expr, .FnCall(_, _, Rc(a), _, _) => a.clone(), .Atom(_, _) => ArrayList(AstExpr).new());
  // Empty tuple → unit value.
  if(args.len() == usize(0), {
    info := new_expr_info(env, Rc.new(TypeValueNode.Unit));
    info.value = Option(EvalValue).Some(EvalValue.UnitVal);
    expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &info);
    return(expr);
  });
  result := evaluate_tuple_elements_value(&args, env, ctx, exn);
  // Build the resulting tuple type and (if all elements known) tuple value.
  tuple_ty := Rc.new(TypeValueNode.Tuple(shared_list(result.field_labels.clone()), shared_list(result.field_types.clone())));
  (all_known : bool) = true;
  (k : usize) = usize(0);
  while((k < result.values.len()) && all_known, {
    match(
      result.values.get(k),
      .Some(opt) => match(
        opt,
        // A runtime element is `Some(UnknownVal)` and must count as NOT
        // known. Without this, a tuple with a runtime element (e.g.
        // `(ArrayList(i32).new(), i32(42))` at module level) carries a
        // TupleVal with an UnknownVal hole, and codegen's comptime short-cut
        // emits `._0 = /* skip generating value */` — invalid C.
        .Some(kv) => if(is_unknown_val(&kv), {
          all_known = false;
        }),
        .None => {
          all_known = false;
        }
      ),
      .None => {
        all_known = false;
      }
    );
    k = (k + usize(1));
  });
  (tuple_value_opt : Option(EvalValue)) = Option(EvalValue).None;
  if(all_known, {
    val_list := ArrayList(EvalValue).new();
    (m : usize) = usize(0);
    while(m < result.values.len(), {
      match(
        result.values.get(m),
        .Some(.Some(v)) => {
          val_list.push(v);
          ();
        },
        .Some(.None) => (),
        .None => ()
      );
      m = (m + usize(1));
    });
    tuple_value_opt = Option(EvalValue).Some(EvalValue.TupleVal(value_cell_new(val_list)));
  });
  info := new_expr_info(&result.env, &tuple_ty);
  info.value = tuple_value_opt;
  info.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(result.runtime_arg_exprs_in_order.clone());
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &info);
  // A RUNTIME tuple literal needs a temp to materialize into, exactly as the
  // array-literal path does (values/array.yo) — the former no-op stub here is
  // why a tuple passed straight to a call leaked one reference per RC-typed
  // element: the callee stores its OWN dup of each element (std assignment
  // semantics), so the balancing release is the caller's drop of the tuple
  // value, which only a named binding or a call-result temp ever got. The
  // owning temp gives the anonymous literal that scope-end drop; every
  // transfer position (binding, begin tail, `own` argument) consumes the temp,
  // so the value still moves rather than being dropped under its new owner.
  // A fully comptime-known tuple is skipped, matching the array-ctor path
  // (calls/array_type.yo): it emits as a constant, and a scope-end drop over
  // static storage would over-release it.
  if(!all_known, {
    attach_temp_variable_to_expr(expr, true, ctx);
  });
  expr
});
export(
  evaluate_tuple_value,
  evaluate_tuple_elements_value,
  evaluate_tuple_element_value,
  EvalTupleElementsValueResult,
  EvalTupleElementResult
);
