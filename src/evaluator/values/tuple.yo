//! evaluate_tuple_value — evaluates tuple value literal expressions.
//!
//! 1:1 port of `src/evaluator/values/tuple.ts`.
//!
//! Evaluates `tuple(e0, e1, …)` runtime literals:
//!   * `tuple()` (zero args) yields the unit value `()` of type `()`.
//!   * Disallows labelled fields (`x: e`) — only allowed in tuple types.
//!   * Threads the expected tuple type into per-element evaluation when present.
//!   * Disallows `type` values stored as tuple elements.
//!   * Converts each element's type to its runtime form (unless the expected
//!     element type is comptime-only).
//!   * Records `runtime_arg_exprs_in_order` and the resulting tuple type/value
//!     onto the call expression's ExprInfo.
//!
//! Phase 3 stubs preserved as no-ops:
//!   (set_expr_as_needs_to_call_dup for field values IS wired — rc layer 4.)
//!   * `attach_temp_variable_to_expr` — temp-variable assignment is not yet ported.
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  make_err_expr,
  BK_TUPLE
} :: import("../../expr.yo");
{
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx } :: import("../context.yo");
{ EvalValue, is_type_value, is_unknown_val } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{
  is_tuple_type,
  is_comptime_int_type,
  is_comptime_float_type,
  is_comptime_string_type,
  is_comptime_list_type
} :: import("../../types/guards.yo");
{ convert_comptime_type_to_runtime_type } :: import("../../types/env_lookup.yo");
{ set_expr_as_needs_to_call_dup } :: import("../utils.yo");
{ type_to_string } :: import("../../types/string.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ evaluate_expression } :: import("../exprs/expr.yo");
// Pragmatic stand-in for the TS `isComptimeOnlyType` while the full
// `typeImplementsComptime` / `typeImplementsRuntime` infrastructure is
// not yet ported.  Covers the same primitive cases the evaluator actually
// hits for tuple element types today.
is_comptime_only_type_local :: (fn(t : TypeValue) -> bool)(
  cond(
    is_comptime_int_type(t) => true,
    is_comptime_float_type(t) => true,
    is_comptime_string_type(t) => true,
    is_comptime_list_type(t) => true,
    true => false
  )
);
// Result struct returned by `evaluate_tuple_elements_value`.
EvalTupleElementsValueResult :: struct(
  field_labels : ArrayList(String),
  field_types : ArrayList(TypeValue),
  values : ArrayList(Option(EvalValue)),
  env : Environment,
  runtime_arg_exprs_in_order : ArrayList(AstExpr)
);
// Evaluate a single tuple element expression and append its evaluated form
// onto `runtime_arg_exprs_in_order`.
//
// Mirrors `evaluateTupleElementValue` in the TS source.
EvalTupleElementResult :: struct(
  ty : TypeValue,
  value : Option(EvalValue),
  env : Environment
);
evaluate_tuple_element_value :: (
  fn(
    expr : AstExpr,
    tuple_field_index : usize,
    env_in : Environment,
    ctx : EvalContext,
    runtime_arg_exprs_in_order : ArrayList(AstExpr),
    exn : Exception
  ) -> EvalTupleElementResult
)({
  (env : Environment) = env_in;
  // Reject labelled fields: `x: rhs`.
  if(ast_expr_is_fn_call_of(expr, ":", Option(usize).Some(usize(2))), {
    args := match(expr, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
    lhs_expr := match(args.get(usize(0)), .Some(a) => a, .None => expr);
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(lhs_expr),
          String.from("Labelled field is not allowed in tuple value."),
          false,
          .None
        )
      )
    );
  });
  // Compute the expected element type from the tuple-shaped expected_type, if any.
  (expected_field_type_opt : Option(TypeValue)) = Option(TypeValue).None;
  match(
    ctx.expected_type,
    .Some(et) => cond(
      is_tuple_type(et.ty) => {
        match(
          et.ty,
          .Tuple(_, types) => {
            match(
              types.get(tuple_field_index),
              .Some(t) => {
                expected_field_type_opt = Option(TypeValue).Some(t);
                ();
              },
              .None => {
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(expr),
                      `Failed to get the tuple field at index ${tuple_field_index}`,
                      false,
                      .None
                    )
                  )
                );
              }
            );
            ();
          },
          _ => ()
        );
        ();
      },
      true => {
        ty_str := type_to_string(et.ty);
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(expr),
              `(2) Failed to evaluate the tuple fields. Expected type to be:\n${ty_str}`,
              false,
              .None
            )
          )
        );
      }
    ),
    .None => ()
  );
  // Evaluate the rhs expression with `expected_type` updated for this field.
  saved_expected := ctx.expected_type;
  ctx.expected_type = match(
    expected_field_type_opt,
    .Some(t) => Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : t, env : env)),
    .None => Option(ExpectedTypeCtx).None
  );
  evaluated_rhs := evaluate_expression(expr, env, ctx);
  ctx.expected_type = saved_expected;
  // Mark the field value copy-semantics: a named RC value moved into the
  // tuple literal gets a deferred `___dup` (mirrors tuple.ts:107 — was a
  // Phase-3 stub; without it the literal aliased the element's refcount and
  // scope-end drops over-released, rc layer 4).
  set_expr_as_needs_to_call_dup(evaluated_rhs, ctx, exn);
  // Look up the resulting ExprInfo for the rhs.
  rhs_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_rhs));
  rhs_info := match(
    rhs_info_opt,
    .Some(info) => info,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `Failed to evaluate the tuple field: ${ast_expr_to_string(expr)}`,
            false,
            .None
          )
        )
      );
      new_expr_info(env, TypeValue.Unit) // unreachable
    }
  );
  env.frames = rhs_info.env.frames;
  env.module_path = rhs_info.env.module_path;
  env.function_declaration_frame_level = rhs_info.env.function_declaration_frame_level;
  env.input_string = rhs_info.env.input_string;
  // Reject `type` values stored as tuple elements.
  if(is_type_value(rhs_info.value), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Cannot store a type value in tuple, please use module instead:\n  ${ast_expr_to_string(expr)}`,
          false,
          .None
        )
      )
    );
  });
  // Convert to runtime type unless the expected field type is comptime-only.
  child_type := match(
    expected_field_type_opt,
    .Some(et) => cond(
      is_comptime_only_type_local(et) => rhs_info.ty,
      true => convert_comptime_type_to_runtime_type(rhs_info.ty, env)
    ),
    .None => convert_comptime_type_to_runtime_type(rhs_info.ty, env)
  );
  runtime_arg_exprs_in_order.push(evaluated_rhs);
  EvalTupleElementResult(
    ty : child_type,
    value : rhs_info.value,
    env : env
  )
});
// Evaluate every element of a tuple value, returning parallel
// labels/types/values plus the threaded environment.
//
// Mirrors `evaluateTupleElementsValue` in the TS source.
evaluate_tuple_elements_value :: (
  fn(
    args : ArrayList(AstExpr),
    env_in : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> EvalTupleElementsValueResult
)({
  (env : Environment) = env_in;
  field_labels := ArrayList(String).new();
  field_types := ArrayList(TypeValue).new();
  values := ArrayList(Option(EvalValue)).new();
  runtime_arg_exprs_in_order := ArrayList(AstExpr).new();
  (i : usize) = usize(0);
  while(i < args.len(), {
    arg := match(args.get(i), .Some(a) => a, .None => make_err_expr());
    result := evaluate_tuple_element_value(
      arg,
      i,
      env,
      ctx,
      runtime_arg_exprs_in_order,
      exn
    );
    field_labels.push(i.to_string());
    field_types.push(result.ty);
    values.push(result.value);
    env.frames = result.env.frames;
    env.module_path = result.env.module_path;
    env.function_declaration_frame_level = result.env.function_declaration_frame_level;
    env.input_string = result.env.input_string;
    i = (i + usize(1));
  });
  EvalTupleElementsValueResult(
    field_labels : field_labels,
    field_types : field_types,
    values : values,
    env : env,
    runtime_arg_exprs_in_order : runtime_arg_exprs_in_order
  )
});
// Evaluate a `tuple(...)` call expression.
//
// Mirrors `evaluateTupleValue` in the TS source.
evaluate_tuple_value :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  if(!(ast_expr_is_fn_call_of(expr, BK_TUPLE, Option(usize).None)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Expected tuple, got non-tuple expression"),
          false,
          .None
        )
      )
    );
  });
  args := match(expr, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  // Empty tuple → unit value.
  if(args.len() == usize(0), {
    info := new_expr_info(env, TypeValue.Unit);
    info.value = Option(EvalValue).Some(EvalValue.UnitVal);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
    return(expr);
  });
  result := evaluate_tuple_elements_value(args, env, ctx, exn);
  // Build the resulting tuple type and (if all elements known) tuple value.
  tuple_ty := TypeValue.Tuple(result.field_labels, result.field_types);
  (all_known : bool) = true;
  (k : usize) = usize(0);
  while((k < result.values.len()) && all_known, {
    match(
      result.values.get(k),
      .Some(opt) => match(
        opt,
        // yo-self runtime results are `Some(UnknownVal)` where TS uses
        // `undefined` — TS's `tupleValues.some((v) => !v)` therefore reads a
        // runtime element as NOT known. Without this, a tuple with a runtime
        // element (e.g. `(ArrayList(i32).new(), i32(42))` at module level)
        // carries a TupleVal with an UnknownVal hole, and codegen's comptime
        // short-cut emits `._0 = /* skip generating value */` — invalid C.
        .Some(kv) => if(is_unknown_val(kv), {
          all_known = false;
        }),
        .None => {
          all_known = false;
        }
      ),
      .None => {
        all_known = false;
      }
    );
    k = (k + usize(1));
  });
  (tuple_value_opt : Option(EvalValue)) = Option(EvalValue).None;
  if(all_known, {
    val_list := ArrayList(EvalValue).new();
    (m : usize) = usize(0);
    while(m < result.values.len(), {
      match(
        result.values.get(m),
        .Some(opt) => match(
          opt,
          .Some(v) => {
            val_list.push(v);
            ();
          },
          .None => ()
        ),
        .None => ()
      );
      m = (m + usize(1));
    });
    tuple_value_opt = Option(EvalValue).Some(EvalValue.TupleVal(val_list));
  });
  info := new_expr_info(result.env, tuple_ty);
  info.value = tuple_value_opt;
  info.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(result.runtime_arg_exprs_in_order);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  // attachTempVariableToExpr — Phase 3 stub (no-op).
  expr
});
export(
  evaluate_tuple_value,
  evaluate_tuple_elements_value,
  evaluate_tuple_element_value,
  EvalTupleElementsValueResult,
  EvalTupleElementResult
);
