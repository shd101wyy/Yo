//! clone_value — deep-clone a compile-time `EvalValue`.
//!
//! `preserve_pointer_refs = true` (the common case): `PtrVal`
//! is returned unchanged to preserve reference semantics.
//! `preserve_pointer_refs = false` (CTFE checking): all compound types
//! including pointers are recursively cloned so that mutations to the clone
//! do not affect the original environment.
//!
//! Cloned pointers do not maintain aliasing between themselves inside the
//! same environment — each Box gets an independent clone, which suffices for
//! CTFE-check isolation.
//!
pragma(Pragma.AllowUnsafe);
import("std/string");
{ ArrayList } :: import("std/collections/array-list");
{ EvalValue, EvalValueNode, value_cell_new, shared_values, shared_opt_values } :: import("../../value.yo");
/// Deep-clone `v`.
///
/// When `preserve_pointer_refs` is `true` (default usage), `PtrVal`
/// is returned unchanged to preserve reference semantics.
/// When `false`, every node is recursively cloned (used in CTFE checking).
///
///
clone_value :: (fn(v : &EvalValue, preserve_pointer_refs : bool) -> EvalValue)(
  match(
    v,
    // Primitive / immutable — return as-is
    Rc(.UnitVal) => Rc.new(EvalValueNode.UnitVal),
    Rc(.BoolVal(_)) => Rc.clone(v.*),
    Rc(.IntLit(_)) => Rc.clone(v.*),
    Rc(.FloatLit(_)) => Rc.clone(v.*),
    Rc(.StrLit(_)) => Rc.clone(v.*),
    Rc(.VarRef(_)) => Rc.clone(v.*),
    Rc(.BreakVal) => Rc.clone(v.*),
    Rc(.ContinueVal) => Rc.clone(v.*),
    Rc(.FuncVal(_, _)) => Rc.clone(v.*),
    Rc(.TypeVal(_)) => Rc.clone(v.*),
    Rc(.ExprVal(_)) => Rc.clone(v.*),
    Rc(.UnknownVal(_, _)) => Rc.clone(v.*),
    // ReturnVal — recursively clone the wrapped value
    Rc(.ReturnVal(val : val_box, ty : ty)) =>
      Rc.new(EvalValueNode.ReturnVal(val : recur(&val_box.*, preserve_pointer_refs), ty : ty.clone())),
    // PtrVal — preserve or deep-clone depending on flag. Preserving keeps
    // the SAME cell (reference semantics); cloning mints a FRESH 1-elem cell
    // around the cloned pointee (no aliasing dedup between cloned cells —
    // there is no identity-keyed map for `ValueCell`s, and CTFE-check
    // isolation only needs the copy).
    Rc(.PtrVal(target_value : tgt_cell, target_index : idx, aggregate_ty : agg)) =>
      cond(
        preserve_pointer_refs => Rc.clone(v.*),
        true => {
          cv_new_cell := ArrayList(EvalValue).new();
          match(
            tgt_cell.get(usize(0)),
            .Some(cv_p0) => {
              cv_new_cell.push(recur(&cv_p0, preserve_pointer_refs));
            },
            .None => ()
          );
          Rc.new(EvalValueNode.PtrVal(target_value : value_cell_new(cv_new_cell), target_index : idx.*, aggregate_ty : agg.clone()))
        }
      ),
    // EnumVal — recursively clone each field
    Rc(.EnumVal(variant : vname, fields : flds)) => {
      new_fields := ArrayList(EvalValue).new();
      i := usize(0);
      while(i < flds.len(), {
        elem := match(flds.get(i), .Some(e) => e, .None => Rc.new(EvalValueNode.UnitVal));
        new_fields.push(recur(&elem, preserve_pointer_refs));
        i = (i + usize(1));
      });
      Rc.new(EvalValueNode.EnumVal(variant : vname.clone(), fields : shared_values(new_fields)))
    },
    // StructVal — recursively clone field_values
    Rc(.StructVal(ty_name : tname, field_names : fnames, field_values : fvals)) => {
      new_fvals := ArrayList(EvalValue).new();
      i := usize(0);
      while(i < fvals.len(), {
        elem := match(fvals.get(i), .Some(e) => e, .None => Rc.new(EvalValueNode.UnitVal));
        new_fvals.push(recur(&elem, preserve_pointer_refs));
        i = (i + usize(1));
      });
      Rc.new(EvalValueNode.StructVal(ty_name : tname.clone(), field_names : Rc.clone(fnames), field_values : value_cell_new(new_fvals)))
    },
    // TupleVal — recursively clone fields
    Rc(.TupleVal(fields : flds)) => {
      new_fields := ArrayList(EvalValue).new();
      i := usize(0);
      while(i < flds.len(), {
        elem := match(flds.get(i), .Some(e) => e, .None => Rc.new(EvalValueNode.UnitVal));
        new_fields.push(recur(&elem, preserve_pointer_refs));
        i = (i + usize(1));
      });
      Rc.new(EvalValueNode.TupleVal(fields : value_cell_new(new_fields)))
    },
    // ArrayVal — recursively clone elements
    Rc(.ArrayVal(elements : elems)) => {
      new_elems := ArrayList(EvalValue).new();
      i := usize(0);
      while(i < elems.len(), {
        elem := match(elems.get(i), .Some(e) => e, .None => Rc.new(EvalValueNode.UnitVal));
        new_elems.push(recur(&elem, preserve_pointer_refs));
        i = (i + usize(1));
      });
      Rc.new(EvalValueNode.ArrayVal(elements : value_cell_new(new_elems)))
    },
    // TraitVal — recursively clone field_values (each is Option(EvalValue))
    Rc(.TraitVal(ty_name : tname, field_names : fnames, field_values : fvals)) => {
      new_fvals := ArrayList(Option(EvalValue)).new();
      i := usize(0);
      while(i < fvals.len(), {
        opt_f := match(fvals.get(i), .Some(o) => o, .None => Option(EvalValue).None);
        cloned_opt := match(
          opt_f,
          .None => Option(EvalValue).None,
          .Some(f) => Option(EvalValue).Some(recur(&f, preserve_pointer_refs))
        );
        new_fvals.push(cloned_opt);
        i = (i + usize(1));
      });
      Rc.new(EvalValueNode.TraitVal(ty_name : tname.clone(), field_names : Rc.clone(fnames), field_values : shared_opt_values(new_fvals)))
    },
    // ComptimeListVal — recursively clone elements
    Rc(.ComptimeListVal(elements : elems)) => {
      new_elems := ArrayList(EvalValue).new();
      i := usize(0);
      while(i < elems.len(), {
        elem := match(elems.get(i), .Some(e) => e, .None => Rc.new(EvalValueNode.UnitVal));
        new_elems.push(recur(&elem, preserve_pointer_refs));
        i = (i + usize(1));
      });
      Rc.new(EvalValueNode.ComptimeListVal(elements : value_cell_new(new_elems)))
    }
  )
);
export(clone_value);
