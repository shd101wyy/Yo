//! type_trait_methods.yo — per-type trait-method registry.
//!
//! In TS, every concrete type carries a `trait?: TraitType` field
//! (see `src/types/definitions.ts:70`). When you write
//! `impl(Foo, SomeTrait(...))`, the evaluator merges the new
//! methods into `Foo.trait.fields` so later `getTypeTraitMethodsByName`
//! calls can find them without a separate lookup table.
//!
//! yo-self's `TypeValue` is a flat sum type with no per-variant
//! mutable `trait` slot. Following the same pattern as
//! `evaluator/values/generic_impl_registry.yo`, we keep the
//! per-type trait fields in a module-level registry keyed by the
//! type's id string.
//!
//! ## What's stored
//!
//! `MethodEntry` mirrors a TS `TraitField`:
//!
//!   - `label` — method or property name (`""` for inline-imported
//!     trait values, matching TS's `field.label === ""` impl-trait
//!     marker — see `src/env.ts:1112-1138`).
//!   - `ty` — the field's `TypeValue` (typically a `Func(...)`).
//!   - `value` — the assigned `EvalValue` (the concrete
//!     `FuncVal`/`TraitVal` produced by the `impl(...)` block).
//!   - `source_trait_id` — the id of the trait this entry was
//!     contributed by (for diagnostics + cross-trait disambiguation).
//!
//! ## What's exposed
//!
//!   - `register_type_trait_method(type_id, entry)` — append one
//!     entry. The same `type_id` can hold many entries (one per
//!     impl'd trait method); duplicates by `(label, source_trait_id)`
//!     are not deduplicated by the registry — callers responsible
//!     for coherence.
//!   - `get_type_trait_methods_for_type(type_id)` — all entries.
//!   - `get_type_trait_methods_by_name(type_id, method_name)` —
//!     entries whose `label` matches.
//!   - `clear_type_trait_methods()` — global wipe, used by test
//!     harnesses to reset between runs.
//!
//! This registry is read by
//! `env.yo:get_type_trait_methods_by_name_from_env` and by the
//! receiver-method-lookup path that's still in flight
//! (`getReceiverMethodsByNameFromEnv`).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TypeValue } :: import("../../types/definitions.yo");
{ EvalValue } :: import("../../value.yo");
/// Extract the unique `id` string from a `TypeValue` variant that
/// carries one (Struct / EnumT / TraitT / SomeT). Returns
/// the empty string for variants that don't — method lookup is
/// meaningless for them, mirroring TS's early-return-`[]` path when
/// the type has no `.trait`. Lives here (rather than on env.yo or
/// types/utils.yo) so it's reachable from `impl.yo` registration
/// callers and from `env.yo` lookup callers without re-creating
/// the env ↔ impl cycle.
type_id_or_empty :: (fn(t : TypeValue) -> String)(
  match(
    t,
    .Struct({ id }) => id,
    .EnumT(id, _, _, _, _, _, _, _, _) => id,
    .TraitT(_, _, _, _, id, _, _, _, _, _) => id,
    .SomeT(id, _, _, _, _, _, _, _, _, _, _) => id,
    // A union's `name` IS its unique id: evaluate_union_type mints
    // `union_<random_id>` and passes it as the name (evaluator/types/union.yo),
    // and the binding rename replaces it with the declared name consistently on
    // both the registration and the lookup side. Without this arm the id was
    // empty, so `impl(<union>, …)` registered NOTHING and every union method —
    // static or instance — was unresolvable (tests/basic.test.yo arm 14), while
    // the identical struct form worked. TS has no such gap: `UnionType extends
    // Type` so it carries an `id` like every other type
    // (src/types/definitions.ts:11-20).
    .Union({ name : un_id }) => un_id,
    // Primitive types get stable synthetic ids so `impl(usize, ...)`,
    // `impl(i32, ...)`, etc. can register `MAX`/`MIN`/operator methods
    // in the trait-methods registry — without an id the registration
    // is silently skipped and property access (`usize.MAX`) fails.
    .Unit => String.from("__yo_t_unit"),
    // str keeps the id "str" — impl(str, ...) methods were historically
    // registered under the singleton struct id "str" (TS: StrType.id =
    // TypeTag.Str = "str").
    .Str => String.from("str"),
    .BoolT => String.from("__yo_t_bool"),
    .Void => String.from("__yo_t_void"),
    .Int(bits, signed) => cond(
      signed => (String.from("__yo_t_i") + bits.to_string()),
      true => (String.from("__yo_t_u") + bits.to_string())
    ),
    .Float(bits) => (String.from("__yo_t_f") + bits.to_string()),
    .Usize => String.from("__yo_t_usize"),
    .Isize => String.from("__yo_t_isize"),
    .ComptimeInt => String.from("__yo_t_comptime_int"),
    .ComptimeFloat => String.from("__yo_t_comptime_float"),
    .ComptimeString => String.from("__yo_t_comptime_string"),
    .CChar => String.from("__yo_t_c_char"),
    .CShort => String.from("__yo_t_c_short"),
    .CUShort => String.from("__yo_t_c_ushort"),
    .CInt => String.from("__yo_t_c_int"),
    .CUInt => String.from("__yo_t_c_uint"),
    .CLong => String.from("__yo_t_c_long"),
    .CULong => String.from("__yo_t_c_ulong"),
    .CLongLong => String.from("__yo_t_c_longlong"),
    .CULongLong => String.from("__yo_t_c_ulonglong"),
    .CLongDouble => String.from("__yo_t_c_longdouble"),
    /// The Expr reflection type. Mirrors the TS ExprType singleton carrying
    /// a trait slot — `impl(Expr, is_atom : ...)` must register and
    /// `expr.is_atom()` dispatch must resolve (same class of gap as the
    /// TypeUni id below; without it every Expr method soft-fell to unit).
    .ExprT => String.from("__yo_t_expr"),
    // The type universe (`Type`). Mirrors TS `createTypeHierarchy`, which
    // gives the cached singleton `id: "Type(${level})"` (creators.ts:1030)
    // and a trait slot — so `impl(Type, get_info : ...)` registers and
    // `Type.get_info(...)` dispatch resolves. Without this id the prelude's
    // `impl(Type, ...)` registration was silently skipped and every
    // `Type.*` reflection method soft-fell to `unit` under check.
    .TypeUni(level) => ((String.from("Type(") + level.to_string()) + String.from(")")),
    _ => String.from("")
  )
);
/// A single trait method or property attached to a concrete type.
/// Mirrors TS `TraitField` (an extension of `TypeField`).
///
/// Stored as an `object` so the registry can hand back the same
/// shared reference to multiple call sites without paying for
/// repeated cloning, matching the way TS's `field` records
/// transitively share through `type.trait.fields`.
///
/// `needs_pointer_conversion` mirrors TS's
/// `needsPointerConversion?: boolean` flag on
/// `getReceiverMethodsByNameFromEnv`'s return record. It's set
/// by `_filter_receiver_methods` (in env.yo) when the method's
/// first parameter is `*(T)` and the receiver is `T` — codegen
/// uses the flag to insert an address-of so the caller can pass
/// `&receiver` automatically. Defaults to `false` at every
/// registration site.
///
/// `self_type` mirrors TS's
/// `specializedMethodType.SelfType = dereferencedReceiverType`
/// (env.ts:1958-1961). Set on the SomeT / Dyn / TypeApplication
/// trait-walk paths to the dereferenced receiver so that
/// codegen can resolve `Self` references inside the method's
/// signature to the concrete receiver type. Direct-on-type
/// registry hits leave it `.None` (TS doesn't need it there —
/// the method's `Self` is already the concrete type).
MethodEntry :: ref(
  struct(
    label : String,
    ty : TypeValue,
    value : Option(EvalValue),
    source_trait_id : String,
    needs_pointer_conversion : bool,
    self_type : Option(TypeValue)
  )
);
/// Module-level storage: `type id` → list of method entries.
(_type_trait_methods : HashMap(String, ArrayList(MethodEntry))) =
  HashMap(String, ArrayList(MethodEntry)).new();
/// Owner tags, parallel to `_type_trait_methods` (same key, same index):
/// the `file://` abs path of the module whose evaluation registered the
/// entry (`""` outside any module load — never purged). Enables
/// `purge_type_trait_methods_owned_by` so LSP re-analysis stops leaking a
/// registry generation per edit (plans/INCREMENTAL_COMPILATION.md Phase B2).
(_type_trait_method_owners : HashMap(String, ArrayList(String))) =
  HashMap(String, ArrayList(String)).new();
/// The module currently being evaluated, as far as registration ownership
/// is concerned. MAINTAINED BY module_loader's register_loading /
/// unregister_loading (the loading-stack top) — the state lives HERE, and
/// the loader pushes into it, because importing module_loader from this
/// module would close the module_loader → env → type_trait_methods cycle.
(_registration_owner : String) = String.new();
set_registration_owner :: (fn(owner : String) -> unit)({
  _registration_owner = owner;
});
/// The current owner tag ("" outside any module evaluation). Read by this
/// module's own registration and by impl.yo's generic-impl registry.
registration_owner :: (fn() -> String)(_registration_owner.clone());
/// Append `entry` to the method list for `type_id`. The list is
/// created on demand. The owner tag is read from the module-loader's
/// loading stack HERE so registration call sites stay unchanged.
register_type_trait_method :: (
  fn(type_id : String, entry : MethodEntry) -> unit
)({
  owner := _registration_owner.clone();
  match(
    _type_trait_methods.get(type_id.clone()),
    .Some(list) => {
      list.push(entry);
    },
    .None => {
      fresh := ArrayList(MethodEntry).new();
      fresh.push(entry);
      ___set := _type_trait_methods.set(type_id.clone(), fresh);
    }
  );
  match(
    _type_trait_method_owners.get(type_id.clone()),
    .Some(olist) => {
      olist.push(owner);
    },
    .None => {
      ofresh := ArrayList(String).new();
      ofresh.push(owner);
      ___oset := _type_trait_method_owners.set(type_id, ofresh);
    }
  );
});
/// Drop every method entry registered by `owner` (a `file://` abs module
/// path). Called with each module the LSP invalidates, right before its
/// re-evaluation re-registers the surviving impls under fresh type ids.
purge_type_trait_methods_owned_by :: (fn(owner : String) -> unit)({
  if(owner.len() == usize(0), {
    return(());
  });
  it := _type_trait_methods.keys();
  (go : bool) = true;
  while(go, {
    match(
      it.next(),
      .Some(key) => match(
        _type_trait_methods.get(key.clone()),
        .Some(list) => match(
          _type_trait_method_owners.get(key.clone()),
          .Some(olist) => {
            (i : usize) = olist.len();
            while(i > usize(0), {
              i = (i - usize(1));
              hit := match(olist.get(i), .Some(o) => (o == owner), .None => false);
              if(hit && (i < list.len()), {
                list.remove(i, usize(1));
                olist.remove(i, usize(1));
              });
            });
          },
          .None => ()
        ),
        .None => ()
      ),
      .None => {
        go = false;
      }
    );
  });
});
/// Total registered method entries across all type ids (LSP leak gate).
type_trait_methods_entry_count :: (fn() -> usize)({
  (total : usize) = usize(0);
  it := _type_trait_methods.keys();
  (go : bool) = true;
  while(go, {
    match(
      it.next(),
      .Some(key) => match(
        _type_trait_methods.get(key),
        .Some(list) => {
          total = (total + list.len());
        },
        .None => ()
      ),
      .None => {
        go = false;
      }
    );
  });
  total
});
/// Return all method entries registered for `type_id`, or an empty
/// list when nothing has been registered.
get_type_trait_methods_for_type :: (
  fn(type_id : String) -> ArrayList(MethodEntry)
)(
  match(
    _type_trait_methods.get(type_id),
    .Some(list) => list,
    .None => ArrayList(MethodEntry).new()
  )
);
/// PROVISIONAL (in-flight) trait-method entries: the yo-self port of TS's
/// receiver-trait splice in `tryToImplementTraitWithArgumentsByTraitType`
/// (trait-type.ts:176-203). TS mutates `receiverType.trait.fields` BEFORE
/// evaluating the impl's member expressions, so a member body that calls back
/// into the impl's own methods (recursive types — `TreeNode` with
/// `Box(Self)` fields under `derive(TreeNode, Clone)`: the derived clone
/// validates `Box(TreeNode).clone`, whose body calls `TreeNode.clone`) finds
/// the method TYPE from the trait signature while the real `FuncVal` is still
/// being built. yo-self's value-semantics TypeValue can't be mutated in
/// place, so the in-flight signatures live here, keyed by receiver type id,
/// and are consulted FIRST by `get_receiver_methods_by_name_from_env`
/// (mirroring TS splicing them AHEAD of existing fields). Entries carry
/// `value : None` (TS: `assignedValue` still undefined during the window) and
/// `self_type : Some(receiver)` (TS: `SelfType: receiverType` substitution).
/// They are cleared when the member-evaluation loop finishes — the real
/// registration (`register_type_trait_method`, with the concrete `FuncVal`)
/// happens after `try_to_implement_trait_with_arguments_by_trait_type`
/// returns, so provisional and final entries never coexist.
(_provisional_trait_methods : HashMap(String, ArrayList(MethodEntry))) =
  HashMap(String, ArrayList(MethodEntry)).new();
register_provisional_trait_method :: (
  fn(type_id : String, entry : MethodEntry) -> unit
)({
  match(
    _provisional_trait_methods.get(type_id),
    .Some(list) => {
      list.push(entry);
    },
    .None => {
      fresh := ArrayList(MethodEntry).new();
      fresh.push(entry);
      ___set := _provisional_trait_methods.set(type_id, fresh);
    }
  );
});
get_provisional_trait_methods_by_name :: (
  fn(type_id : String, method_name : String) -> ArrayList(MethodEntry)
)({
  result := ArrayList(MethodEntry).new();
  match(
    _provisional_trait_methods.get(type_id),
    .Some(all) => {
      n := all.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          all.get(i),
          .Some(entry) => {
            if(entry.label == method_name, {
              result.push(entry);
            });
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .None => ()
  );
  result
});
clear_provisional_trait_methods :: (fn(type_id : String) -> unit)({
  _provisional_trait_methods.remove(type_id);
});
/// Return only the method entries whose `label` matches
/// `method_name`. Mirrors the inner `.find` / `.filter` calls inside
/// TS `getTypeTraitMethodsByNameFromEnv`.
get_type_trait_methods_by_name :: (
  fn(type_id : String, method_name : String) -> ArrayList(MethodEntry)
)({
  result := ArrayList(MethodEntry).new();
  all := get_type_trait_methods_for_type(type_id);
  n := all.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      all.get(i),
      .Some(entry) => {
        if(entry.label == method_name, {
          result.push(entry);
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  result
});
/// INHERENT-method definition sites, keyed by `type_id` + NUL-free
/// separator + `label`, valued by the defining token's
/// `module_path:row:column`. This is how the duplicate-inherent-method
/// rejection (plans/FUNCTION_OVERLOADING_POLICY.md,
/// issues/fixed/duplicate-inherent-method-impls-not-rejected.md) tells a GENUINE
/// second definition (different source site) from the loader's idempotent
/// re-evaluation and from a generic impl re-registering per instantiation
/// (both replay the SAME site). Keyed separately from `_type_trait_methods`
/// so codegen-time synthetic registrations (codegen/functions/collection.yo)
/// never participate.
(_inherent_method_sites : HashMap(String, String)) = HashMap(String, String).new();
/// Drop all registered methods. Used by test harnesses to reset
/// global state between runs. Mirrors the cleanup helpers in
/// `evaluator/values/impl.yo` for the generic-impl registry.
clear_type_trait_methods :: (fn() -> unit)({
  fresh := HashMap(String, ArrayList(MethodEntry)).new();
  _type_trait_methods = fresh;
  fresh_sites := HashMap(String, String).new();
  _inherent_method_sites = fresh_sites;
});
/// Record `site` as the defining site of inherent method `label` on
/// `type_id`. Returns `.Some(previous_site)` when the pair was already
/// defined at a DIFFERENT site — a genuine duplicate the caller must
/// reject — and `.None` for a fresh definition or a same-site replay.
note_inherent_method_site :: (
  fn(type_id : String, label : String, site : String) -> Option(String)
)({
  key := `${type_id}\n${label}`;
  match(
    _inherent_method_sites.get(key.clone()),
    .Some(prev) => cond(
      (prev == site) => Option(String).None,
      true => Option(String).Some(prev)
    ),
    .None => {
      ___ins := _inherent_method_sites.set(key, site);
      Option(String).None
    }
  )
});
/// Trait-method DEFAULT values (`?=` defaults). yo-self's `TraitT` does not store
/// per-field default values (divergence — trait_type.yo:6-8), so the trait
/// evaluator records each defaulted method's FuncVal here, keyed by
/// `${trait_id}::${label}`. Consumers (`_resolve_dyn_trait_values`, method
/// dispatch) fall back to this when a concrete type implements the trait WITHOUT
/// overriding a defaulted method (e.g. `Error.source ?= (self) -> .None`).
(_trait_method_defaults : HashMap(String, EvalValue)) = HashMap(String, EvalValue).new();
register_trait_default :: (fn(trait_id : String, label : String, value : EvalValue) -> unit)({
  _trait_method_defaults.set((trait_id + String.from("::")) + label, value);
});
get_trait_default :: (fn(trait_id : String, label : String) -> Option(EvalValue))(
  _trait_method_defaults.get((trait_id + String.from("::")) + label)
);
/// Forward-shell → real-method func_id REDIRECT (`shell_func_id` → `real_func_id`,
/// both Strings — NOT FuncVals, since EvalValue has no `.clone()` and `clone_value`
/// consumes its arg, so the real FuncVal can't live in both the registry entry and
/// here). A forward-referenced/recursive impl method has TWO func_ids: forward-ref
/// /self-recursive call sites captured the SHELL id; non-forward sites use the REAL
/// id. The impl evaluator records shell→real on the shell entry-update; codegen's
/// `generate_function` emits the shell-id function as a THUNK forwarding to the
/// real method's C name — so both ids resolve to the real evaluated body. Fixes
/// parser.yo's recursive `get_program` emitting a shell's unevaluated body.
(_shell_redirect : HashMap(String, String)) = HashMap(String, String).new();
register_shell_redirect :: (fn(shell_func_id : String, real_func_id : String) -> unit)({
  _shell_redirect.set(shell_func_id, real_func_id);
});
get_shell_redirect :: (fn(shell_func_id : String) -> Option(String))(
  _shell_redirect.get(shell_func_id)
);
export(
  MethodEntry,
  register_trait_default,
  get_trait_default,
  register_shell_redirect,
  get_shell_redirect,
  register_type_trait_method,
  note_inherent_method_site,
  get_type_trait_methods_for_type,
  get_type_trait_methods_by_name,
  clear_type_trait_methods,
  register_provisional_trait_method,
  get_provisional_trait_methods_by_name,
  clear_provisional_trait_methods,
  type_id_or_empty,
  set_registration_owner,
  registration_owner,
  purge_type_trait_methods_owned_by,
  type_trait_methods_entry_count
);
