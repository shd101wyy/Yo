//! evaluate_dyn_value — evaluates `dyn` coercion expressions.
//!
//!   - Handles `SomeT` (Impl) and `DynT` value types.
//!   - Infers the DynType from the evaluated value type or from context.
//!   - Auto-boxes non-object values by synthesising a `inner` call.
//!   - Concrete `.trait` field access is NOT available; only SomeT, DynT,
//!     and expected-DynType-from-context are supported.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token, ast_expr_id, alloc_global_expr_id, ast_expr_is_fn_call_of } :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  expr_info_set_dyn_call_trait_values,
  expr_info_adopt_env,
  mark_node_preevaluated,
  unmark_node_preevaluated
} :: import("../../expr_info.yo");
{ Environment, synthetic_token, get_variables_from_env, add_variable_to_env, snapshot_env } :: import("../../env.yo");
{ Token } :: import("../../token.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ function_reaches_non_send_global, d1_note_thread_reach } :: import("../effects/mutation_summary.yo");
{ EvalContext, ExpectedTypeCtx, ArgEntry, ArgValues, VarArgEntry, call_function_value_marker } :: import("../context.yo");
{ EvalValue, is_func_val, create_type_value, create_unknown_val } :: import("../../value.yo");
{ get_func_type, get_closure_capture_info } :: import("../../function_value.yo");
{ create_specialized_function_inline, try_to_call_function_with_arguments } :: import("../calls/helper.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, t_type, generate_some_type_id, t_dyn } :: import("../../types/creators.yo");
{ is_dyn_type, is_some_type, is_function_type, is_reference_struct_type, is_boxed_type, is_atomic_reference_struct_type, shared_cell_type_name_of_constructor, shared_cell_canonical_names } :: import("../../types/guards.yo");
{ type_contains_some_type_deep } :: import("../../types/utils.yo");
{ get_value_of_some_type_from_env, get_trait_type_from_env } :: import("../../types/env_lookup.yo");
{ type_to_string } :: import("../../types/string.yo");
{ type_implements_trait_bool, extract_fn_trait_from_type, function_value_slot_mismatch } :: import("../trait_checking.yo");
{ raise_flow_violation } :: import("../../types/flowability.yo");
{ format_error_message, with_code } :: import("../../error.yo");
{ E_TYPE_MISMATCH, E_CLOSURE_MOVES_CAPTURE } :: import("../../diagnostics.yo");
{ evaluate_comptime_fn_call } :: import("../calls/comptime_fn.yo");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ attach_temp_variable_to_expr, set_expr_as_needs_to_call_dup, reject_second_class_escape } :: import("../utils.yo");
{ get_type_trait_methods_for_type, type_id_or_empty, get_trait_default } :: import("./type_trait_methods.yo");
{ find_methods_from_generic_impls, MethodCandidate } :: import("./impl.yo");
{ Exception } :: import("std/error");
/// Build the ordered TraitVal evidence for a DynType over a concrete value
/// type, resolving each trait method to the concrete type's registered impl
/// FuncVal (via the type_trait_methods registry). C codegen's vtable
/// wrappers read these FuncVals to dispatch; a field with no registered method
/// falls back to None. Shared by both the executing and non-executing paths so
/// codegen has the evidence regardless of the mode the body was evaluated in.
/// For a BOXED dyn payload (`Rc(Sq)`), return the box's underlying value type
/// (`Sq`, its single `*` field) so trait methods resolve on the concrete type the
/// impl is registered against; non-boxed passes through. The codegen wrapper's
/// is_boxed branch then unboxes `Rc* -> &rc->*` at the call. Requires the box's
/// `Rc(...)` name (stamped in comptime_fn.yo) so is_boxed_type recognises it.
/// `<ctor>(inner_type)` for a prelude cell type constructor `ctor` — the
/// shared cell (`Box`/`Rc`), or the atomic box `Arc(inner_type)` a
/// `Dyn(..., Send)` payload takes — evaluated like the constructor call it
/// stands for: the prelude comptime type-constructor is called with `V`
/// pre-bound to inner_type in the callee env (evaluate_comptime_fn_call evals
/// the body in the passed callee_env and does NOT bind params).
_create_box_type_via :: (fn(ctor : &String, inner_type : &TypeValue, env : &Environment, ctx : &EvalContext, exn : &Exception) -> Option(TypeValue))({
  vars := get_variables_from_env(env, ctor.clone());
  (box_fv : Option(EvalValue)) = Option(EvalValue).None;
  (box_ft : TypeValue) = t_unit();
  nv := vars.len();
  (vi : usize) = usize(0);
  while((vi < nv) && box_fv.is_none(), {
    match(
      vars.get(vi),
      .Some(v) => match(
        v.value.get(usize(0)),
        .Some(val) => if(is_func_val(val), {
          box_fv = Option(EvalValue).Some(val);
          box_ft = v.ty;
        }),
        .None => ()
      ),
      .None => ()
    );
    vi = (vi + usize(1));
  });
  match(
    box_fv,
    .None => Option(TypeValue).None,
    .Some(bfv) => {
      param0_ty := match(box_ft, .Func({ param_types : pts }) => match(pts.get(usize(0)), .Some(p) => p, .None => t_type()), _ => t_type());
      param0_label := match(box_ft, .Func({ meta : bm }) => match(bm.*.param_labels.get(usize(0)), .Some(l) => l, .None => String.from("V")), _ => String.from("V"));
      (cenv : Environment) = env;
      _cfr := cenv.push_frame(false);
      vtok := synthetic_token(param0_label.clone(), cenv.module_path);
      add_variable_to_env(cenv, param0_label.clone(), t_type(), Option(EvalValue).Some(create_type_value(inner_type)), true, false, false, false, vtok);
      bargs := ArrayList(ArgEntry).new();
      bargs.push(ArgEntry(value : Option(EvalValue).Some(create_type_value(inner_type)), parameter_type : param0_ty, arg_type : t_type()));
      bav := ArgValues(
        forall_args : ArrayList(ArgEntry).new(),
        args : bargs,
        implicit_args : Option(ArrayList(ArgEntry)).None,
        variadic_args : ArrayList(VarArgEntry).new()
      );
      // The callee expr must be a synthetic `Rc` atom, not `.None`: the
      // `Rc(arg)` display-name stamp in comptime_fn.yo reads the constructor
      // NAME off the callee expr token (FuncVals carry no funcName),
      // and `is_boxed_type` keys off that `Rc(`-prefixed name. With `.None`
      // this site minted the MEMOIZED canonical `Rc(T)` instance UNSTAMPED,
      // so any consumer handed the canonical (the era-repair return re-eval)
      // failed is_boxed_type and the boxed-dyn path registered the impl
      // against the Box pointer itself (dyn_dispatch_autobox_value printed
      // a blank instead of 'Q').
      b_callee_tok := synthetic_token(ctor.clone(), cenv.module_path);
      b_callee := AstExpr.Atom(alloc_global_expr_id(), b_callee_tok);
      bres := evaluate_comptime_fn_call(Option(AstExpr).Some(b_callee), box_ft, bfv, bav, env, cenv, ctx, exn);
      cenv.pop_frame();
      match(bres.value, .TypeVal(bt) => if(is_reference_struct_type(bt), Option(TypeValue).Some(bt), Option(TypeValue).None), _ => Option(TypeValue).None)
    }
  )
});
/// Does a `dyn(...)` build a `Dyn(..., Send)` or a `Dyn(..., Sync)`? From the
/// expected Dyn type, or from the value's own `Impl(..., Send)` wrapper when
/// nothing is expected. Either one crosses threads, so its payload is boxed
/// atomically.
_dyn_target_requires_send :: (fn(expected : &Option(ExpectedTypeCtx), value_type : &TypeValue) -> bool)({
  from_expected := match(
    expected,
    .Some(et) => match(et.ty, .DynT(required_trait_types : ert) => Option(bool).Some(_traits_name_send(ert)), _ => Option(bool).None),
    .None => Option(bool).None
  );
  match(
    from_expected,
    .Some(b) => b,
    .None => match(value_type, .SomeT({ required_trait_types : vrt }) => _traits_name_send(vrt), _ => false)
  )
});
_traits_name_send :: (fn(tys : &ArrayList(TypeValue)) -> bool)(!_thread_marker_named_in(tys).is_empty());
/// The thread marker a trait list names: "Send" when it lists `Send`, else
/// "Sync" when it lists `Sync`, else "". A `Dyn(Trait)` is `Send`/`Sync`
/// only through such an explicit bound (plans/VALUES_BY_DEFAULT.md decision
/// 38 E).
_thread_marker_named_in :: (fn(tys : &ArrayList(TypeValue)) -> String)({
  (found : String) = String.new();
  (tsi : usize) = usize(0);
  while(tsi < tys.len(), {
    match(
      tys.get(tsi),
      .Some(t) => match(
        t,
        .TraitT(name : tn) => if((tn == "Send") || ((tn == "Sync") && found.is_empty()), {
          found = tn.clone();
        }),
        _ => ()
      ),
      .None => ()
    );
    tsi = (tsi + usize(1));
  });
  found
});
_unwrap_box_for_method_lookup :: (fn(t : &TypeValue) -> TypeValue)({
  (result : TypeValue) = t;
  if(is_boxed_type(t), {
    match(
      t,
      .Struct({ field_types : fts }) => match(
        fts.get(usize(0)),
        .Some(ut) => {
          result = ut;
        },
        .None => ()
      ),
      _ => ()
    );
  });
  result
});
/// The type a `dyn()`'s trait bound is decided against, or `.None` when it
/// cannot be decided at this point.
///
/// A payload that IS — or merely CONTAINS — an unbound type variable is
/// "unknown", not "no": `type_implements_trait` answers `false` for want of a
/// concrete, and a generic body is evaluated once at DEFINITION time with its
/// `SomeT`s still free. Rejecting there would break every `dyn(v)` written
/// inside a `where(T <: Trait)`-constrained fn. Such a site is re-evaluated
/// with the binding in place at specialization, which is where the bound is
/// enforced instead. Same conservative scoping as
/// `validate_where_constraints_for_call`'s no-SomeT guard
/// (issues/fixed/yo-self-where-clause-full-enforcement.md).
_dyn_bound_check_type :: (fn(t : &TypeValue, env : &Environment) -> Option(TypeValue))({
  if(type_contains_some_type_deep(t), {
    return(Option(TypeValue).None);
  });
  if(!is_some_type(t), {
    return(Option(TypeValue).Some(t));
  });
  // `type_contains_some_type` waves through a `SomeT` that already carries its
  // concrete as its own `resolution` (closures/futures).
  // Follow that resolution, then the env binding chain; if neither lands on a
  // concrete the bound is still undecidable here.
  own_rc := match(t, .SomeT({ resolution : carried }) => carried, _ => Option(TypeValue).None);
  resolved := match(own_rc, .Some(o) => o, .None => get_value_of_some_type_from_env(env, t));
  cond(
    is_some_type(resolved) => Option(TypeValue).None,
    true => Option(TypeValue).Some(resolved)
  )
});
/// Reject a `dyn(x)` whose payload type does not implement every required trait
/// of the `Dyn` it is being coerced into.
///
/// The coercion path previously had NO trait-satisfaction check: a required
/// member the concrete type does not implement (and that has no trait `?=`
/// default) resolved to a `.None` field value, which
/// `_resolve_dyn_trait_values` pushed without complaint. Codegen then diverged
/// on that `.None` — the wrapper emitter SKIPS the method with a comment
/// (`codegen/functions/dyn.yo`, "Module field ... is not a function value")
/// while the vtable emitter names the wrapper unconditionally — so a plain type
/// error surfaced as `use of undeclared identifier '__yo_wrap_..._to_string'`
/// from the C compiler, naming a symbol the user never wrote. And with a member
/// that DOES have a default (`Error.source`), nothing looked wrong at all: a
/// type the compiler itself reports as not implementing `Error` was stored in
/// an `AnyError` and dispatched through it, making `impl(_, Error())`
/// decorative (issues/fixed/dyn-does-not-check-that-the-value-implements-the-traits.md).
///
/// The check itself is `type_implements_trait`, which asks the type-id-keyed
/// registry (`register_type_trait_value`, written by every concrete
/// `impl(T, Trait(...))`) and additionally answers through generic impls
/// and the builtin markers — i.e. it is deliberately permissive, which is
/// the safe direction for a rejection.
///
/// Only nominal `TraitT` requirements are checked. A `FnTraitT` requirement is
/// a dyn'd CLOSURE, which IS its own implementation — there is no registry impl
/// to find (the same arm `_resolve_dyn_trait_values` special-cases below), and
/// every other required-type shape is not a nominal trait at all.
_name_in :: (fn(names : &ArrayList(String), n : &String) -> bool)({
  (i : usize) = usize(0);
  while(i < names.len(), {
    if(match(names.get(i), .Some(x) => (x == n), .None => false), {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
_require_dyn_traits_implemented :: (
  fn(
    dyn_type : &TypeValue,
    value_type : &TypeValue,
    token : &Token,
    ctx : &EvalContext,
    env : &Environment,
    exn : &Exception
  ) -> unit
)({
  // Decide the bound on the UNDERLYING type when the payload is an Rc: both
  // `dyn(rc(i32(42)))` and the auto-box path arrive here as `Rc(i32)`, while
  // the impl is registered against `i32` (the same unwrap the trait-value
  // resolution does before its registry lookups).
  // Rules D4 + D9: a FUNCTION payload (`dyn(k)` into `Dyn(Fn() -> R, Send)`)
  // holds a marker by its value — what it captures, what its code reaches —
  // not by its type (`call_function_value_marker`). Judged BEFORE the bound
  // type is resolved: a closure's SomeT has no concrete type to resolve to,
  // and the early return below skipped every check for it
  // (issues/fixed/iso-of-a-graph-holding-a-function-value-bypasses-d9.md).
  // A `Dyn(..., Send)` shares its data object across threads, so the object
  // must be atomically counted: a `rc(...)` payload is not
  // (issues/fixed/a-send-dyn-shares-a-non-atomic-box-across-threads.md).
  if(match(dyn_type, .DynT(required_trait_types : sd_rtt) => _traits_name_send(sd_rtt), _ => false) && is_boxed_type(value_type) && !is_atomic_reference_struct_type(value_type), {
    sd_msg := `A ${type_to_string(dyn_type.clone())} is shared between threads, so its payload must be atomically reference counted, and ${type_to_string(value_type.clone())} is not: pass the value itself (\`dyn(...)\` boxes it with \`arc\`) or \`arc(v)\`.`;
    raise_flow_violation(format_error_message(token, sd_msg), ctx, exn);
  });
  fv_payload := _unwrap_box_for_method_lookup(value_type);
  fv_judged_names := ArrayList(String).new();
  match(
    dyn_type,
    .DynT(required_trait_types : fv_rtt) => {
      (fvi : usize) = usize(0);
      while(fvi < fv_rtt.len(), {
        match(
          fv_rtt.get(fvi),
          .Some(fv_req) => match(
            fv_req,
            .TraitT(name : fv_rn) => match(
              call_function_value_marker(fv_payload, Option(EvalValue).None, fv_req.clone(), env, ctx),
              .Some(fvm) => {
                fv_judged_names.push(fv_rn.clone());
                match(
                  fvm,
                  .Some(fvm_o) => {
                    fv_msg := `A ${type_to_string(dyn_type.clone())} cannot hold this ${type_to_string(fv_payload.clone())}: ${fvm_o}.`;
                    raise_flow_violation(format_error_message(token, fv_msg), ctx, exn);
                  },
                  .None => ()
                );
              },
              .None => ()
            ),
            _ => ()
          ),
          .None => ()
        );
        fvi = (fvi + usize(1));
      });
    },
    _ => ()
  );
  // A FUNCTION payload is called through the `Dyn(Fn(...))`'s call
  // signature, so its own must be that one, modes included: a by-value
  // `fn(s : String)` behind a `Dyn(Fn(s : &String) -> usize)` would drop
  // what every caller only lends. A `fn(...)` value is judged on its whole
  // signature (the `Fn`-trait satisfaction rule); a closure, whose literal
  // adopts the Dyn's signature, on its modes
  // (issues/fixed/a-function-argument-is-not-checked-against-a-function-typed-parameter.md).
  match(
    extract_fn_trait_from_type(dyn_type),
    .Some(dfn_req) => {
      dfn_is_fn := is_function_type(fv_payload);
      dfn_note := cond(
        (dfn_is_fn && type_implements_trait_bool(fv_payload.clone(), dfn_req, env)) => Option(String).None,
        dfn_is_fn => match(function_value_slot_mismatch(dyn_type, fv_payload), .Some(dfn_m) => Option(String).Some(dfn_m), .None => Option(String).Some(String.from(""))),
        true => function_value_slot_mismatch(dyn_type, fv_payload)
      );
      match(
        dfn_note,
        .Some(dfn_n) => raise_flow_violation(
          format_error_message(token, `Incompatible types:\n- Expected: ${type_to_string(dyn_type.clone())}\n- Given   : ${type_to_string(fv_payload.clone())}${dfn_n}`),
          ctx,
          exn
        ),
        .None => ()
      );
    },
    .None => ()
  );
  check_ty := match(
    _dyn_bound_check_type(_unwrap_box_for_method_lookup(value_type), env),
    .Some(c) => c,
    .None => {
      return(());
    }
  );
  match(
    dyn_type,
    .DynT(required_trait_types : rtt) => {
      n := rtt.len();
      (i : usize) = usize(0);
      while(i < n, {
        req := match(
          rtt.get(i),
          .Some(t) => t,
          .None => {
            i = (i + usize(1));
            continue;
          }
        );
        req_is_nominal := match(req, .TraitT(_, _, _, _, _, _, _, _, _, _) => true, _ => false);
        req_judged := match(req, .TraitT(name : rjn) => _name_in(fv_judged_names, rjn), _ => false);
        if(req_is_nominal && !req_judged && !type_implements_trait_bool(check_ty.clone(), req.clone(), env), {
          // Prefer the trait's declared NAME; an anonymous trait has none, and
          // `type_to_string` renders its field dump instead.
          req_name := match(req, .TraitT(name : rn) => rn.clone(), _ => String.new());
          req_str := cond(
            req_name.is_empty() => type_to_string(req.clone()),
            true => req_name
          );
          msg := `Type ${type_to_string(check_ty.clone())} does not implement the trait ${req_str} required by ${type_to_string(dyn_type.clone())}.`;
          // A deliberate user-facing rejection: outside a dry run, flag it on
          // the flow-violation channel so the def-time caller re-raises it via
          // the real exn — the def-eval wall otherwise SWALLOWS the throw and
          // the enclosing body silently hollows (same pattern as
          // anonymous_function.yo's return-type rejection).
          raise_flow_violation(format_error_message(token, msg), ctx, exn);
        });
        i = (i + usize(1));
      });
      // Until V2b makes a `Dyn` uniquely owned (decision 7), every copy of a
      // `Dyn(..., Send)` shares its one payload, so a copy kept on the sending
      // thread reads it concurrently with the receiver: the payload must be
      // `Sync` as well (plans/VALUES_BY_DEFAULT.md §3.8).
      match(
        get_trait_type_from_env(env, String.from("Sync")),
        .Some(sync_tt) => if((_thread_marker_named_in(rtt) == "Send") && !_traits_name(rtt, "Sync") && !_name_in(fv_judged_names, String.from("Send")) && !type_implements_trait_bool(check_ty.clone(), sync_tt, env), {
          sync_msg := `Type ${type_to_string(check_ty.clone())} does not implement Sync, which ${type_to_string(dyn_type.clone())} requires of its payload: every copy of a Dyn shares that payload until Dyn becomes uniquely owned (plans/VALUES_BY_DEFAULT.md decision 7).`;
          raise_flow_violation(format_error_message(token, sync_msg), ctx, exn);
        }),
        .None => ()
      );
    },
    _ => ()
  );
});
/// True when the trait list names the trait `name`.
_traits_name :: (fn(tys : &ArrayList(TypeValue), name : str) -> bool)({
  (ti : usize) = usize(0);
  while(ti < tys.len(), {
    if(match(tys.get(ti), .Some(t) => match(t, .TraitT(name : tn) => (tn == name), _ => false), .None => false), {
      return(true);
    });
    ti = (ti + usize(1));
  });
  false
});
/// Rule D1 (plans/reference/PARALLELISM_RULES.md) for trait objects: a
/// `Dyn(..., Send)` value may be called from another thread, but a call
/// through it is invisible to the spawn-boundary reach walk (the impl is not
/// known there). So the walk runs HERE, where the concrete impl is: every
/// method in the vtable must not reach a non-Send module-level global
/// (issues/fixed/d1-reach-walk-does-not-follow-closure-values-or-dyn-calls.md).
_require_send_dyn_methods_reach_no_global :: (
  fn(
    dyn_type : &TypeValue,
    trait_vals : &ArrayList(EvalValue),
    token : &Token,
    ctx : &EvalContext,
    env : &Environment,
    exn : &Exception
  ) -> unit
)({
  if(is_implicitly_unsafe_capable_file(Option(String).Some(token.module_path.clone())), {
    return(());
  });
  // D1 covers a `Sync` trait object as well as a `Send` one (decision 38 E).
  thread_marker := match(dyn_type, .DynT(required_trait_types : rtt) => _thread_marker_named_in(rtt), _ => String.new());
  if(thread_marker.is_empty(), {
    return(());
  });
  (ti : usize) = usize(0);
  while(ti < trait_vals.len(), {
    match(
      trait_vals.get(ti),
      .Some(tv) => match(
        tv,
        .TraitVal(_, fnames, fvals) => {
          (fi : usize) = usize(0);
          while(fi < fvals.len(), {
            match(
              fvals.get(fi),
              .Some(fv_opt) => match(
                fv_opt,
                .Some(fv) => match(
                  fv,
                  .FuncVal(fvd, _) => match({
                    reach := function_reaches_non_send_global(fvd.*.func_id.clone(), fvd.*.body, ctx.expr_info_table, env);
                    // A Send dyn's methods may run on another thread: what
                    // they read is thread-reached, and already-written is a
                    // violation now (the verdict may be a memo from before
                    // the write).
                    written := d1_note_thread_reach(fvd.*.func_id.clone());
                    if(reach.is_some(), reach, written)
                  }, .Some(reason) => {
                    mname := match(fnames.get(fi), .Some(n) => n, .None => String.new());
                    msg := `A ${type_to_string(dyn_type.clone())} value may be used on another thread (it is ${thread_marker}), but its method '${mname}' ${reason}.`;
                    raise_flow_violation(format_error_message(token, msg), ctx, exn);
                  }, .None => ()),
                  _ => ()
                ),
                .None => ()
              ),
              .None => ()
            );
            fi = (fi + usize(1));
          });
        },
        _ => ()
      ),
      .None => ()
    );
    ti = (ti + usize(1));
  });
});
/// Monomorphize a trait `?=`-default method FuncVal to a concrete receiver.
/// The registered default is GENERIC over `Self` (e.g. `Error.source ?= (self)
/// -> .None`, typed `fn(self : &mut Self) -> Option(Dyn(SelfTrait))`); codegen
/// skips its generic body (→ undeclared dyn wrapper `fn_..._source`, the stage-2
/// Error.source cluster). Route it through `create_specialized_function_inline`
/// with `ctx.self_type = value_type` so `Self` in the body/return resolves to the
/// receiver, producing a concrete, collectable FuncVal with a per-type func_id.
/// Applied whenever the resolved field value IS the trait default (matched by
/// func_id) — the impl.yo default-fill registers the RAW generic default in the
/// type-trait-method registry, so it is found via exact/by_label here, not only
/// via the get_trait_default fall-through. Returns `fv` unchanged when it is not
/// a FuncVal or not the default.
_monomorphize_default_fv :: (
  fn(fv : &EvalValue, default_fid : &String, value_type : &TypeValue, caller_env : &Environment, ctx : &EvalContext, exn : &Exception) -> EvalValue
)(
  cond(
    !is_func_val(fv) => fv,
    (default_fid == String.new()) => fv,
    match(fv, .FuncVal(__mfv, _) => (__mfv.*.func_id == default_fid), _ => false) => {
      default_ft := get_func_type(default_fid.clone());
      self_args := ArrayList(ArgEntry).new();
      self_args.push(ArgEntry(value : Option(EvalValue).None, parameter_type : value_type.clone(), arg_type : value_type.clone()));
      spec_argvals := ArgValues(
        forall_args : ArrayList(ArgEntry).new(),
        args : self_args,
        implicit_args : Option(ArrayList(ArgEntry)).None,
        variadic_args : ArrayList(VarArgEntry).new()
      );
      saved_self_ty := ctx.self_type;
      ctx.self_type = Option(TypeValue).Some(value_type.clone());
      spec_fv := create_specialized_function_inline(fv, default_ft, spec_argvals, caller_env, caller_env, ctx, exn);
      ctx.self_type = saved_self_ty;
      spec_fv
    },
    true => fv
  )
);
/// The trait method `fname` the receiver gets from a GENERIC impl
/// (`impl(generic(T), where(T <: ToString), ArrayList(T), ToString(...))`),
/// specialized for the receiver. The type-trait registry is keyed by the
/// concrete nominal id and a blanket impl registers against its pattern, so the
/// lookup above misses while `type_implements_trait` (which consults the
/// generic registry) says the impl exists; the vtable then named a wrapper that
/// was never emitted
/// (issues/fixed/dyn-cannot-resolve-a-trait-method-that-comes-from-a-generic-impl.md).
/// A candidate from the Dyn's own trait is preferred.
_generic_impl_method_for_dyn :: (
  fn(receiver_type : &TypeValue, fname : &String, trait_id : &String, caller_env : &Environment, ctx : &EvalContext, exn : &Exception) -> Option(EvalValue)
)({
  cands := find_methods_from_generic_impls(receiver_type, fname, caller_env);
  (picked : Option(MethodCandidate)) = Option(MethodCandidate).None;
  (ci : usize) = usize(0);
  while(ci < cands.len(), {
    match(
      cands.get(ci),
      .Some(c) => if(c.method_value.is_some() && (picked.is_none() || (c.source_trait_id == trait_id)), {
        picked = Option(MethodCandidate).Some(c);
      }),
      .None => ()
    );
    ci = (ci + usize(1));
  });
  // Specialize it exactly as a call would: the full call path binds `self`,
  // infers the impl's binders from the receiver and records the specialization
  // for codegen. The receiver is a synthetic runtime variable of the concrete
  // type in a scratch frame. (`create_specialized_function_inline` alone
  // evaluates the body without `self` bound.)
  match(
    picked,
    .Some(pc) => match(
      pc.method_value,
      .Some(fv) => if(is_func_val(fv), {
        recv_name := `__yo_dyn_receiver_${fname}`;
        caller_env.push_frame(false);
        recv_tok := synthetic_token(recv_name.clone(), caller_env.module_path);
        _recv_var := add_variable_to_env(caller_env, recv_name.clone(), receiver_type.clone(), Option(EvalValue).Some(create_unknown_val(receiver_type.clone())), false, true, false, false, recv_tok.clone());
        recv_atom := AstExpr.Atom(alloc_global_expr_id(), recv_tok.clone());
        callee_atom := AstExpr.Atom(alloc_global_expr_id(), synthetic_token(fname.clone(), caller_env.module_path));
        call_args := ArrayList(AstExpr).new();
        call_args.push(recv_atom);
        call_expr := AstExpr.FnCall(alloc_global_expr_id(), callee_atom, call_args.clone(), false, recv_tok);
        ctx.pending_method_self_type = Option(TypeValue).Some(receiver_type.clone());
        // The synthetic call has no expected result: the surrounding
        // context's (the `Dyn` a `dyn(...)` argument is checked against)
        // must not reach it.
        saved_expected := ctx.expected_type;
        ctx.expected_type = Option(ExpectedTypeCtx).None;
        res := try_to_call_function_with_arguments(Option(EvalValue).Some(fv), pc.method_type, call_expr, callee_atom, call_args, caller_env, ctx, true, false, true, exn);
        ctx.expected_type = saved_expected;
        caller_env.pop_frame();
        res.specialized_function_value
      }, Option(EvalValue).None),
      .None => Option(EvalValue).None
    ),
    .None => Option(EvalValue).None
  )
});
/// `dyn(d)` of a value that is already a `Dyn` is an error: the payload
/// behind `d` is erased, so there is no concrete type to build a vtable from.
/// Converting to a `Dyn` with fewer traits is `upcast(d, Dyn(...))`
/// (plans/TYPE_SYSTEM_SOUNDNESS.md Phase 2.8); before this the evaluator
/// accepted it and codegen wrote its refusal into the C as a comment
/// (issues/fixed/dyn-of-an-existing-dyn-value-emits-an-error-comment-into-the-c.md).
_reject_dyn_of_dyn :: (fn(ty : &TypeValue, tok : &Token, exn : &Exception) -> unit)({
  if(is_dyn_type(ty), {
    exn.throw(
      dyn(
        with_code(
          format_error_message(
            tok,
            `dyn(...) of a value that is already a Dyn (${type_to_string(ty)}): its concrete type is erased, so there is nothing to build a new vtable from.\nUse the value as it is, or upcast(value, Dyn(...)) to keep fewer of its traits.`
          ),
          E_TYPE_MISMATCH
        )
      )
    );
  });
});
_resolve_dyn_trait_values :: (fn(dyn_type : &TypeValue, value_type : &TypeValue, ctx : &EvalContext, caller_env : &Environment, exn : &Exception) -> ArrayList(EvalValue))({
  trait_vals := ArrayList(EvalValue).new();
  // Resolve trait methods on the UNDERLYING type when the payload is an Rc.
  method_lookup_type := _unwrap_box_for_method_lookup(value_type);
  match(
    dyn_type,
    .DynT(required_trait_types : rtt) => {
      n := rtt.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          rtt.get(i),
          .Some(tt) => match(
            tt,
            .TraitT(name : tname, field_labels : fl, id : trait_id) => {
              entries := get_type_trait_methods_for_type(type_id_or_empty(method_lookup_type));
              n_fields := fl.len();
              field_names := ArrayList(String).new();
              field_vals := ArrayList(Option(EvalValue)).new();
              (j : usize) = usize(0);
              while(j < n_fields, {
                fname := match(fl.get(j), .Some(s) => s, .None => String.from(""));
                field_names.push(fname.clone());
                // Prefer an entry matching BOTH label and trait id; fall back to
                // a label-only match (the Dyn(Trait) annotation's trait id can
                // differ from the impl's source_trait_id across trait-type
                // instantiations). Read entry.value at most ONCE per entry —
                // Option(EvalValue) reads MOVE (EvalValue holds reference-
                // semantics members), so a double read is use-after-move (SIGBUS).
                (exact : Option(EvalValue)) = Option(EvalValue).None;
                (by_label : Option(EvalValue)) = Option(EvalValue).None;
                (have_exact : bool) = false;
                ne := entries.len();
                (k : usize) = usize(0);
                while((k < ne) && !have_exact, {
                  match(
                    entries.get(k),
                    .Some(entry) => if(entry.label == fname, {
                      is_exact := (entry.source_trait_id == trait_id);
                      ev := entry.value;
                      if(is_exact, {
                        exact = ev;
                        have_exact = true;
                      }, {
                        by_label = ev;
                      });
                    }),
                    .None => ()
                  );
                  k = (k + usize(1));
                });
                // Fall back to the trait's `?=` DEFAULT method when the concrete
                // type implements the trait WITHOUT overriding this method (e.g.
                // `Error.source ?= (self) -> .None` for a LexerError that omits
                // `source`). The registered default is GENERIC over `Self`, so it
                // must be MONOMORPHIZED to the concrete receiver: codegen would
                // otherwise skip its generic body (undeclared wrapper) and the
                // `Self`-bearing return type would mismatch the vtable slot. Route
                // it through create_specialized_function_inline with `self :
                // value_type` (ctx.self_type set so `Self` in the body/return
                // resolves to the receiver), producing a concrete, collectable
                // FuncVal. Falls back to the raw default if specialization is not
                // possible.
                // The trait's `?=` default func_id — used to detect (and
                // monomorphize) a generic default whether it was found via the
                // registry (exact/by_label, because impl.yo fills the raw default
                // there) or via the get_trait_default fall-through.
                default_fid_for_field := match(
                  get_trait_default(trait_id.clone(), fname.clone()),
                  .Some(dfv) => if(is_func_val(dfv), match(dfv, .FuncVal(__dfvd, _) => __dfvd.*.func_id.clone(), _ => String.new()), String.new()),
                  .None => String.new()
                );
                resolved_field := match(
                  exact,
                  .Some(v) => Option(EvalValue).Some(_monomorphize_default_fv(v, default_fid_for_field.clone(), value_type.clone(), caller_env, ctx, exn)),
                  .None => match(
                    by_label,
                    .Some(bv) => Option(EvalValue).Some(_monomorphize_default_fv(bv, default_fid_for_field.clone(), value_type.clone(), caller_env, ctx, exn)),
                    .None => match(
                      _generic_impl_method_for_dyn(method_lookup_type.clone(), fname.clone(), trait_id.clone(), caller_env, ctx, exn),
                      .Some(gv) => Option(EvalValue).Some(gv),
                      .None => match(
                        get_trait_default(trait_id.clone(), fname.clone()),
                        .Some(default_fv) => Option(EvalValue).Some(_monomorphize_default_fv(default_fv, default_fid_for_field.clone(), value_type.clone(), caller_env, ctx, exn)),
                        .None => Option(EvalValue).None
                      )
                    )
                  )
                );
                field_vals.push(resolved_field);
                j = (j + usize(1));
              });
              trait_vals.push(EvalValue.TraitVal(tname, field_names, field_vals));
              ()
            },
            // Fn trait (Dyn(Fn(...)) — e.g. a dyn'd CLOSURE stored in a struct
            // field): the closure ITSELF is the implementation; there is no
            // registry impl to resolve. Push a marker TraitVal so
            // `generate_dyn_call` proceeds (it bails on an EMPTY list) — the
            // C wrapper for the synthetic `call` slot resolves the closure fn
            // via the impl_closure_call_map (capture-struct id → closure C
            // name).
            .FnTraitT(fn_base, _, _, _, _, _, _, _) => {
              trait_vals.push(
                EvalValue.TraitVal(
                  fn_base.clone(),
                  ArrayList(String).new(),
                  ArrayList(Option(EvalValue)).new()
                )
              );
              ()
            },
            _ => ()
          ),
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  );
  trait_vals
});
/// The non-executing path's Dyn fallback when the position's expected type is
/// not a Dyn: the payload's own bounds. An `Impl(...)` (SomeT) payload names
/// its traits, so `dyn(v)` builds the Dyn from them — the same derivation the
/// executing path applies through its `dyn_type` match below. A payload with
/// no bounds of its own (a concrete type) has nothing to say WHICH Dyn to
/// build, so the dyn is rejected AT ITS OWN TOKEN instead of silently
/// becoming an empty DynT that passes `yo check` and dies in the C compiler
/// (issues/fixed/dyn-as-a-direct-downcast-argument-reports-got-option.md).
/// When the inner produced no ExprInfo (`have_payload_ty` false) its own
/// failure has already been reported — the empty stand-in keeps this from
/// piling a second, misleading error on top of it.
_dyn_type_from_payload_or_throw :: (
  fn(
    payload_type : &TypeValue,
    expr_tok : &Token,
    expected_ty : &Option(TypeValue),
    have_payload_ty : bool,
    exn : &Exception
  ) -> TypeValue
)(
  match(
    payload_type,
    .SomeT(
      required_trait_types : rtt,
      required_trait_levels : rtl,
      negative_trait_types : ntt,
      negative_trait_levels : ntl
    ) => t_dyn(rtt, rtl, ntt, ntl),
    _ => {
      if(have_payload_ty, {
        exn.throw(
          dyn(
            with_code(
              format_error_message(
                expr_tok,
                match(
                  expected_ty,
                  .Some(et) => `cannot infer the Dyn type of dyn(...) here: the expected type ${type_to_string(et)} is not a Dyn(...).\nAnnotate the value or bind it first — e.g. (x : Dyn(Trait)) = dyn(value) — or pass dyn(value) where a Dyn(...) is expected.`,
                  .None => `cannot infer the Dyn type of dyn(...) here: this position supplies no expected type.\nAnnotate the value or bind it first — e.g. (x : Dyn(Trait)) = dyn(value) — or pass dyn(value) where a Dyn(...) is expected.`
                )
              ),
              E_TYPE_MISMATCH
            )
          )
        );
      });
      TypeValue.DynT(
        required_trait_types : ArrayList(TypeValue).new(),
        required_trait_levels : ArrayList(usize).new(),
        negative_trait_types : ArrayList(TypeValue).new(),
        negative_trait_levels : ArrayList(usize).new()
      )
    }
  )
);
/// Decision 37: `Fn` implies `FnOnce`, never the reverse. A closure typed
/// `FnOnce(...)` boxed as a `Dyn(Fn(...))` could be called again through the
/// `Fn` slot, re-running a body that already gave its captures away (E0913).
_reject_fnonce_into_dyn_fn :: (fn(target : &Option(ExpectedTypeCtx), value_ty : &TypeValue, tok : &Token, ctx : &EvalContext, exn : &Exception) -> unit)({
  target_base := match(
    target,
    .Some(t) => match(
      t.ty,
      .DynT(_, _, _, _) => match(extract_fn_trait_from_type(t.ty), .Some(tf) => match(tf, .FnTraitT(base_name : tb) => tb.clone(), _ => String.from("")), .None => String.from("")),
      _ => String.from("")
    ),
    .None => String.from("")
  );
  value_base := match(extract_fn_trait_from_type(value_ty), .Some(vf) => match(vf, .FnTraitT(base_name : vb) => vb.clone(), _ => String.from("")), .None => String.from(""));
  if((target_base == "Fn") && (value_base == "FnOnce"), {
    raise_flow_violation(
      with_code(
        format_error_message(tok, String.from("Cannot box an `FnOnce(...)` closure as a `Dyn(Fn(...))`: an `FnOnce` closure is called at most once (its call consumes it), and a `Dyn(Fn(...))` may be called again. Box it as `Dyn(FnOnce(...))`.")),
        E_CLOSURE_MOVES_CAPTURE
      ),
      ctx,
      exn
    );
  });
});
evaluate_dyn_value :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    exn : &Exception
  ) -> AstExpr
)({
  expr_tok := ast_expr_token(expr);
  // Extract the args ArrayList and the single value argument.
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      exn.throw(
        dyn(
          format_error_message(
            expr_tok,
            String.from("evaluate_dyn_value: expected a FnCall expression")
          )
        )
      );
      return(expr);
    }
  );
  value_arg := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            expr_tok,
            String.from("'dyn' requires exactly one argument")
          )
        )
      );
      return(expr);
    }
  );
  // Expected-type for the INNER value expression. The dyn target itself
  // must NOT flow down as the inner's expected type: the inner is a
  // concrete value being coerced into the dyn, so matching its type
  // against the dyn (e.g. `"x".to_string()`'s `String` return vs
  // `dyn(Error)`) wrongly reaches `synthesize_types` and tag-mismatches.
  // When the outer expected type is a Dyn, evaluate the inner with a fresh
  // `SomeT` carrying the Dyn's required / negative traits (a type variable,
  // which `synthesize` binds to the concrete value and checks the trait
  // constraints against); otherwise clear the expected type entirely.
  (inner_expected : Option(ExpectedTypeCtx)) = Option(ExpectedTypeCtx).None;
  match(
    ctx.expected_type,
    .Some(et) => match(
      et.ty,
      .DynT(
        required_trait_types : rtt,
        required_trait_levels : rtl,
        negative_trait_types : ntt,
        negative_trait_levels : ntl
      ) => {
        w_ty := TypeValue.SomeT(
          generate_some_type_id(),
          String.from(""),
          env.frames.len(),
          TypeValue.TypeUni(usize(0)),
          rtt,
          rtl,
          ntt,
          ntl,
          Option(TypeValue).None,
          Option(TypeValue).None
        );
        (exp_ty : TypeValue) = w_ty;
        // dyn(rc(<closure>)) special case — `box` or any other shared-cell
        // constructor (`rc`, types/guards.yo `shared_cell_names_at`): pass
        // `Rc(Impl-SomeT)` (`Rc(...)` for `rc`) as the cell call's expected
        // type so its early return-type synthesis binds `V := <the
        // Fn-carrying wrapper>` and the closure argument is contextually
        // typed from the wrapper's Fn trait (concrete param types). Without
        // it the closure is created through the no-expected placeholder
        // fallback (`fn(y : y) -> _ret`) and its C signature emits `void*`
        // params (the cluster-B family). (`Rc(T)(...)` ctor calls are not
        // recognized; the bare constructor head covers the dyn-closure
        // pattern.)
        dyn_cell_closure_type := match(
          value_arg,
          .FnCall(_, dbc_fn, dbc_args, _, _) => cond(
            (
              (dbc_args.len() == usize(1)) && match(
                dbc_args.get(usize(0)),
                .Some(dbc_a0) => ast_expr_is_fn_call_of(dbc_a0, "=>", Option(usize).None),
                .None => false
              )
            ) => match(dbc_fn, .Atom(_, dbc_tok) => shared_cell_type_name_of_constructor(dbc_tok.value), _ => Option(String).None),
            true => Option(String).None
          ),
          _ => Option(String).None
        );
        match(
          dyn_cell_closure_type,
          .Some(dbc_cell) => match(
            _create_box_type_via(dbc_cell, w_ty, env, ctx, exn),
            .Some(dbc_bt) => {
              exp_ty = dbc_bt;
            },
            .None => ()
          ),
          .None => ()
        );
        inner_expected = Option(ExpectedTypeCtx).Some(
          ExpectedTypeCtx(
            ty : exp_ty,
            env : et.env
          )
        );
      },
      _ => ()
    ),
    .None => ()
  );
  // Non-executing path: still type-check the inner expression, then return early.
  // The inner evaluates through the RAW evaluator so its errors reach this
  // caller's `exn`: the exception-free `evaluate_expression` SWALLOWS a throw
  // (`_evaluate_expression_wrapper`), and a swallowed E0401 inside
  // `dyn(unknown_fn())` left the dyn — and the enclosing fn body — evaluating
  // "cleanly" with no ExprInfo for the payload: `yo check` passed a hollow body,
  // or the trait check below ran against a stand-in type and reported an
  // unrelated "does not implement Error"
  // (issues/fixed/extern-declarations-are-not-forward-referenceable.md, face 2).
  if(ctx.is_validating_function_definition || !ctx.is_executing, {
    saved_et_ne := ctx.expected_type;
    ctx.expected_type = inner_expected;
    inner_ne := evaluate_expression_raw(value_arg, env, ctx, exn);
    ctx.expected_type = saved_et_ne;
    // Even in validating mode, resolve the trait evidence from the registry so
    // C codegen (which reads body ExprInfo produced in THIS mode — fn bodies
    // are evaluated in validating mode) has the vtable FuncVals. The
    // resolution is structural (registry lookup), not execution-dependent.
    ne_value_type := match(expr_info_table_get(ctx.expr_info_table, ast_expr_id(inner_ne)), .Some(ii) => ii.ty, .None => t_unit());
    _reject_fnonce_into_dyn_fn(ctx.expected_type, ne_value_type, expr_tok, ctx, exn);
    // Whether the inner expression actually produced an ExprInfo. With none, the
    // `t_unit()` fallback above is a STAND-IN, not the payload's type — checking
    // the trait bound against it would report "unit does not implement …" on top
    // of whatever really failed inside the inner.
    ne_have_inner_ty := match(expr_info_table_get(ctx.expr_info_table, ast_expr_id(inner_ne)), .Some(_) => true, .None => false);
    _reject_dyn_of_dyn(ne_value_type.clone(), expr_tok, exn);
    // The Dyn to build must be NAMED by something. The expected type supplies
    // it when it is a Dyn; otherwise the payload's own trait bounds do (an
    // `Impl(...)` value carries them — the same fallback the executing path
    // below applies through its `dyn_type` derivation). With neither — a bare
    // `dyn(x)` argument of `downcast(...)`, of a plain call, a method receiver
    // — the fallback used to be an EMPTY DynT (zero traits): `is_dyn_type`
    // still matched it, so `yo check` passed and the build then died inside
    // the C compiler on `/* Error: dyn() call missing trait values */`
    // (issues/fixed/dyn-as-a-direct-downcast-argument-reports-got-option.md).
    (ret_type : TypeValue) = match(
      ctx.expected_type,
      .Some(et) => match(
        et.ty,
        .DynT(
          required_trait_types : rtt,
          required_trait_levels : rtl,
          negative_trait_types : ntt,
          negative_trait_levels : ntl
        ) =>
          TypeValue.DynT(
            required_trait_types : rtt,
            required_trait_levels : rtl,
            negative_trait_types : ntt,
            negative_trait_levels : ntl
          ),
        _ => _dyn_type_from_payload_or_throw(ne_value_type.clone(), expr_tok, Option(TypeValue).Some(et.ty), ne_have_inner_ty, exn)
      ),
      .None => _dyn_type_from_payload_or_throw(ne_value_type.clone(), expr_tok, Option(TypeValue).None, ne_have_inner_ty, exn)
    );
    out_info := new_expr_info(env, ret_type.clone());
    // Auto-box a non-object, non-dyn payload (always boxed), evaluating the
    // synthetic `rc(value)` with the EXPECTED
    // `Rc(value_type)` so the box's `generic(V)` binds. The synthetic atom/call
    // get REAL ids (alloc_global_expr_id) — id=0 breaks the call's ExprInfo/generic
    // setup. The boxed expr is surfaced via runtime_arg_exprs_in_order (the field
    // generate_dyn_call reads). Trait evidence stays on the PRE-box concrete type.
    //
    // Dyn'd CLOSURE payload (Dyn(Fn(...)) struct fields): `Rc(<fn type>)` is
    // not constructible (fn-typed struct fields are rejected — the
    // SuspensionPointDetector design note), and the closure's runtime value IS
    // its capture struct — box THAT instead (the box rtparam is the capture
    // struct, e.g. `box_Impl(Fn...)(struct(base : i32))`); the capture
    // struct is also the key the C wrapper resolves through
    // impl_closure_call_map.
    (ne_box_inner_ty : TypeValue) = ne_value_type;
    match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(inner_ne)),
      .Some(iiv) => match(
        iiv.value,
        .Some(ival) => match(
          ival,
          .FuncVal(__nfvd, _) => match(
            get_closure_capture_info(__nfvd.*.func_id.clone()),
            .Some(cci) => match(
              inner_expected,
              // An Rc with V = the Impl(Fn) SOMET whose
              // resolved_concrete = the closure's CAPTURE STRUCT
              // (resolvedConcreteType carries the layout). The PER-OBJECT
              // field survives the Rc
              // CTFE's clone/substitute/intern, so codegen's get_type_string
              // lays the box payload out as the capture struct — the id-keyed
              // global misses there (round-5 finding).
              .Some(iec) => match(
                iec.ty,
                .SomeT(bx_id, bx_nm, bx_fl, bx_pt, bx_rtt, bx_rtl, bx_ntt, bx_ntl, bx_kft, _) => {
                  ne_box_inner_ty = TypeValue.SomeT(
                    bx_id,
                    bx_nm,
                    bx_fl,
                    bx_pt,
                    bx_rtt,
                    bx_rtl,
                    bx_ntt,
                    bx_ntl,
                    bx_kft,
                    Option(TypeValue).Some(cci.capture_type)
                  );
                },
                _ => ()
              ),
              .None => ()
            ),
            .None => ()
          ),
          _ => ()
        ),
        .None => ()
      ),
      .None => ()
    );
    (ne_final_expr : AstExpr) = inner_ne;
    if(!is_reference_struct_type(ne_value_type) && !is_dyn_type(ne_value_type), {
      // The same box the executing path below picks: `arc` for a Send Dyn.
      ne_send := _dyn_target_requires_send(ctx.expected_type, ne_value_type);
      ne_cell := shared_cell_canonical_names();
      match(
        _create_box_type_via(if(ne_send, String.from("Arc"), String.from(ne_cell.type_name)), ne_box_inner_ty, env, ctx, exn),
        .Some(box_ty) => {
          ne_box_tok := synthetic_token(if(ne_send, String.from("arc"), String.from(ne_cell.constructor)), env.module_path);
          ne_box_atom := AstExpr.Atom(alloc_global_expr_id(), ne_box_tok);
          ne_box_args := ArrayList(AstExpr).new();
          ne_box_args.push(inner_ne);
          ne_box_call := AstExpr.FnCall(alloc_global_expr_id(), ne_box_atom, ne_box_args, false, expr_tok);
          saved_bet := ctx.expected_type;
          ctx.expected_type = Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : box_ty, env : env));
          // The inner value is evaluated once: as the box call's argument it
          // is pre-evaluated, so a closure's capture moves do not run again
          // (issues/fixed/dyn-of-a-closure-capturing-a-move-only-value-is-a-bogus-e0901.md).
          mark_node_preevaluated(ast_expr_id(inner_ne));
          ne_boxed := evaluate_expression_raw(ne_box_call, env, ctx, exn);
          unmark_node_preevaluated(ast_expr_id(inner_ne));
          ctx.expected_type = saved_bet;
          match(
            expr_info_table_get(ctx.expr_info_table, ast_expr_id(ne_boxed)),
            .Some(_) => {
              ne_final_expr = ne_boxed;
            },
            .None => ()
          );
        },
        .None => ()
      );
    });
    // The dyn takes OWNERSHIP of its payload: mark the inner value's owning
    // temp CONSUMED (or schedule a deferred dup for a borrowed source).
    // Without this the payload temp keeps its scope-end/escape drop AND the
    // dyn's own `.data` drop also fires — a double-drop of the same object on
    // every `exn.throw(dyn(format_error_message(...)))` (the startup heap
    // corruption; see
    // issues/fixed/yo-self-dyn-throw-double-drop.md; repro /tmp/dd.yo).
    match(expr_info_table_get(ctx.expr_info_table, ast_expr_id(ne_final_expr)), .Some(sc_ne) => reject_second_class_escape(sc_ne.ty, String.from("made a `Dyn`"), ast_expr_token(ne_final_expr), ctx, exn), .None => ());
    set_expr_as_needs_to_call_dup(ne_final_expr, ctx, exn, "dyn");
    rt_args_ne := ArrayList(AstExpr).new();
    rt_args_ne.push(ne_final_expr);
    out_info.runtime_arg_exprs_in_order = .Some(rt_args_ne);
    if(is_dyn_type(ret_type.clone()), {
      if(ne_have_inner_ty, {
        _require_dyn_traits_implemented(ret_type.clone(), ne_value_type.clone(), expr_tok, ctx, env, exn);
      });
      ne_trait_vals := _resolve_dyn_trait_values(ret_type.clone(), ne_value_type, ctx, env, exn);
      _require_send_dyn_methods_reach_no_global(ret_type, ne_trait_vals, expr_tok, ctx, env, exn);
      expr_info_set_dyn_call_trait_values(out_info, Option(ArrayList(EvalValue)).Some(ne_trait_vals));
    });
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    // Attach the temp variable C codegen reads for the fat-pointer struct.
    attach_temp_variable_to_expr(expr, true, ctx);
    return(expr);
  });
  // --- Executing path ---
  // Evaluate the inner expression (with the inner-expected computed above).
  saved_et_ex := ctx.expected_type;
  ctx.expected_type = inner_expected;
  eval_inner := evaluate_expression_raw(value_arg, env, ctx, exn);
  ctx.expected_type = saved_et_ex;
  inner_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_inner));
  inner_info := match(
    inner_info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            expr_tok,
            String.from("evaluate_dyn_value: failed to evaluate inner expression")
          )
        )
      );
      return(expr);
    }
  );
  (value_type : TypeValue) = inner_info.ty;
  _reject_dyn_of_dyn(value_type.clone(), expr_tok, exn);
  _reject_fnonce_into_dyn_fn(ctx.expected_type, value_type, expr_tok, ctx, exn);
  (cur_env : Environment) = expr_info_adopt_env(inner_info);
  (final_value_type : TypeValue) = value_type;
  // Auto-box non-object, non-dyn values. No Future-implementing SomeType
  // special case exists — all non-object, non-dyn values are wrapped in rc().
  // A `Dyn(..., Send)` boxes with `arc` instead: the Dyn's data object is
  // SHARED — every copy of the Dyn, and the box's own handle, hold it — and a
  // Send value is shared across threads, so its reference count must be
  // atomic. A plain `box` put a non-atomic count on two threads
  // (issues/fixed/a-send-dyn-shares-a-non-atomic-box-across-threads.md).
  (final_value_expr_ex : AstExpr) = eval_inner;
  if(!is_reference_struct_type(value_type) && !is_dyn_type(value_type), {
    box_fn_name := if(_dyn_target_requires_send(ctx.expected_type, value_type), String.from("arc"), String.from(shared_cell_canonical_names().constructor));
    box_tok := synthetic_token(box_fn_name, cur_env.module_path);
    // Fresh node ids, as the non-executing path above mints them: the
    // ExprInfo side table is keyed by id, and id 0 is shared by every other
    // node built with it, so the callee atom could read another node's entry
    // — a test-body trial reported "box is not callable: it has type unit"
    // (issues/fixed/an-auto-boxed-dyn-value-builds-its-box-call-with-node-id-zero.md).
    box_atom := AstExpr.Atom(alloc_global_expr_id(), box_tok);
    box_args := ArrayList(AstExpr).new();
    box_args.push(eval_inner);
    box_call := AstExpr.FnCall(alloc_global_expr_id(), box_atom, box_args, false, expr_tok);
    mark_node_preevaluated(ast_expr_id(eval_inner));
    boxed_expr := evaluate_expression_raw(box_call, cur_env, ctx, exn);
    unmark_node_preevaluated(ast_expr_id(eval_inner));
    boxed_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(boxed_expr));
    match(
      boxed_info_opt,
      .Some(bi) => {
        // Update the dyn(...) call's first arg to point at the boxed expression,
        // so that C codegen sees inner rather than the bare inner expression.
        args(usize(0)) = boxed_expr;
        final_value_type = bi.ty;
        cur_env = expr_info_adopt_env(bi);
        final_value_expr_ex = boxed_expr;
      },
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              expr_tok,
              String.from("evaluate_dyn_value: failed to auto-box value for 'dyn'")
            )
          )
        );
      }
    );
  });
  // Same ownership-transfer consumption as the non-executing path above.
  match(expr_info_table_get(ctx.expr_info_table, ast_expr_id(final_value_expr_ex)), .Some(sc_fv) => reject_second_class_escape(sc_fv.ty, String.from("made a `Dyn`"), ast_expr_token(final_value_expr_ex), ctx, exn), .None => ());
  set_expr_as_needs_to_call_dup(final_value_expr_ex, ctx, exn, "dyn");
  // Determine the expected DynType:
  //   1. From context.expected_type when it is already a DynT.
  //   2. From final_value_type when it is a DynT.
  //   3. From final_value_type when it is a SomeT — build DynT from its traits.
  //   4. Otherwise: unsupported (concrete `.trait` field access is not available).
  expected_dyn_from_ctx := match(
    ctx.expected_type,
    .Some(et) => match(
      et.ty,
      .DynT(
        required_trait_types : rtt,
        required_trait_levels : rtl,
        negative_trait_types : ntt,
        negative_trait_levels : ntl
      ) =>
        Option(TypeValue).Some(
          TypeValue.DynT(
            required_trait_types : rtt,
            required_trait_levels : rtl,
            negative_trait_types : ntt,
            negative_trait_levels : ntl
          )
        ),
      _ => Option(TypeValue).None
    ),
    .None => Option(TypeValue).None
  );
  dyn_type := match(
    expected_dyn_from_ctx,
    .Some(dt) => dt,
    .None => match(
      final_value_type,
      .DynT(
        required_trait_types : rtt,
        required_trait_levels : rtl,
        negative_trait_types : ntt,
        negative_trait_levels : ntl
      ) =>
        TypeValue.DynT(
          required_trait_types : rtt,
          required_trait_levels : rtl,
          negative_trait_types : ntt,
          negative_trait_levels : ntl
        ),
      .SomeT(
        required_trait_types : rtt,
        required_trait_levels : rtl,
        negative_trait_types : ntt,
        negative_trait_levels : ntl
      ) =>
        t_dyn(rtt, rtl, ntt, ntl),
      _ => {
        exn.throw(
          dyn(
            format_error_message(
              expr_tok,
              String.from("'dyn' requires a SomeType (Impl), DynType, or an expected Dyn type context. Concrete types without trait fields are not supported in Phase 3.")
            )
          )
        );
        TypeValue.DynT(
          required_trait_types : ArrayList(TypeValue).new(),
          required_trait_levels : ArrayList(usize).new(),
          negative_trait_types : ArrayList(TypeValue).new(),
          negative_trait_levels : ArrayList(usize).new()
        )
      }
    )
  );
  // The payload must actually implement what the Dyn requires. Checked on
  // the pre-box concrete type, like the trait values below.
  _require_dyn_traits_implemented(dyn_type.clone(), value_type.clone(), expr_tok, ctx, cur_env, exn);
  // Collect a TraitVal for each required trait, resolving the concrete type's
  // registered impl methods through the registry. Resolved on the pre-box
  // concrete type.
  trait_vals := _resolve_dyn_trait_values(dyn_type.clone(), value_type, ctx, cur_env, exn);
  _require_send_dyn_methods_reach_no_global(dyn_type.clone(), trait_vals, expr_tok, ctx, cur_env, exn);
  // Annotate the outer dyn(...) expression with the resolved DynType and
  // the ordered trait values for C codegen vtable emission.
  out_info := new_expr_info(cur_env, dyn_type);
  expr_info_set_dyn_call_trait_values(out_info, Option(ArrayList(EvalValue)).Some(trait_vals));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  // Attach the temp variable C codegen reads for the fat-pointer struct.
  attach_temp_variable_to_expr(expr, true, ctx);
  expr
});
export(evaluate_dyn_value);
