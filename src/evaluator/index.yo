//! Self-hosted Evaluator entry point.
//!
//! Mirrors `src/evaluator/index.ts` — the `Evaluator` class handles:
//!   - Parsing the input source
//!   - Pre-scanning the program for `pragma(Pragma.SkipPrelude);`
//!   - Injecting prelude exports into a dedicated env frame
//!   - Evaluating the module body via `evaluate_anonymous_module_begin_exprs`
//!
//! (Until 2026-08-05 this also wrapped the legacy `eval.yo` proto-evaluator and
//! wired it via `set_module_loader`. That file was retired — it was a
//! bootstrap-only divergence with no `src/` counterpart, superseded by
//! `evaluator/exprs/*.yo`, and outside `main.yo`'s import closure. Its
//! `g_module_loader` was read nowhere but inside itself, so the wiring call was
//! inert: the real loader is installed by `load_module_fn(prelude_path)` below
//! and by `g_evaluator_load_fn`. Dropping the setter also matches
//! `src/evaluator/index.ts`, which has no such global and calls `loadModule`
//! directly.)
//!
//! Phase G (plans/MEMORY_SAFETY.md): `SkipPrelude` detection runs as
//! an AST-level pre-scan of `pragma(Pragma.SkipPrelude);` calls via
//! `pre_scan_for_skip_prelude` in `./builtins/pragma.yo`. The legacy
//! `has_comment_attribute` helper below is kept exported for any
//! external caller that hasn't yet migrated, but the constructor no
//! longer consults it.
//!
//! Stubs remain for: impl registry cleanup, doc-comment extraction.
//! `allowPartialModule` / `registerPartialModule` are not yet supported and are
//! omitted.
//!
//! Phase 3y: `register_evaluate_expression()` is called during initialization
//! to wire the modular dispatcher into `g_evaluate_expression`. This allows
//! modular evaluator components to call `evaluate_expression` without needing
//! to manually install the dispatcher in every test/call site.
//!
//! Translation decisions vs `src/evaluator/index.ts`:
//!   - TypeScript class → Yo `object` + `impl` block.
//!   - `loadModule: LoadModuleFn` → `(fn(path : String) -> Option(EvalValue))`.
//!   - Prelude load failure sets `module_error`; does not throw.
//!   - `getModuleValue()` returns `Option(EvalValue)` independent of error state.
//!   - `program.clone()` is used so the stored `program` field remains valid
//!     after module-body evaluation consumes its copy.
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ Parser } :: import("../parser.yo");
{ AstExpr, desugar_program_if_calls } :: import("../expr.yo");
{ Environment, build_prelude_var_cache } :: import("../env.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ EvalValue } :: import("../value.yo");
{ register_evaluate_expression } :: import("./exprs/_expr.yo");
{ pre_scan_for_skip_prelude } :: import("./builtins/pragma.yo");
{ eval_context_new, LoadModuleResult } :: import("./context.yo");
{ evaluate_anonymous_module_begin_exprs } :: import("./values/anonymous_module.yo");
// ---------------------------------------------------------------------------
// Context module loader bridge
// ---------------------------------------------------------------------------
// `EvalContext.load_module` has a fixed `(path) -> LoadModuleResult`
// signature, so the user-supplied `(path) -> Option(EvalValue)` loader is
// stashed here and adapted by `_evaluator_ctx_load_module` (same pattern as
// main.yo's `g_demand_loader`).
(g_evaluator_load_fn : Option((fn(path : String) -> Option(EvalValue)))) = .None;
_evaluator_ctx_load_module :: (fn(path : String) -> LoadModuleResult)(
  match(
    g_evaluator_load_fn,
    .Some(f) =>
      match(
        f(path.clone()),
        .Some(v) => LoadModuleResult(
          module_value : v,
          module_type : TypeValue.Unit,
          module_error : Option(String).None
        ),
        .None => LoadModuleResult(
          module_value : EvalValue.UnitVal,
          module_type : TypeValue.Unit,
          module_error : Option(String).Some(`Module not found: ${path}`)
        )
      ),
    .None => LoadModuleResult(
      module_value : EvalValue.UnitVal,
      module_type : TypeValue.Unit,
      module_error : Option(String).Some(String.from("No module loader registered"))
    )
  )
);
(g_evaluator_ctx_loader : Option((fn(path : String) -> LoadModuleResult))) = .None;
// Wire the slot (mirrors main.yo's `_demand_loader_init`).
_evaluator_loader_init := (fn() -> bool)({
  g_evaluator_ctx_loader = Option((fn(path : String) -> LoadModuleResult)).Some(
    _evaluator_ctx_load_module
  );
  true
})();
// ---------------------------------------------------------------------------
// Comment-attribute check
// ---------------------------------------------------------------------------
/// Returns `true` if any comment token in `tokens` contains `attribute`.
/// Mirrors `hasCommentAttribute` in `src/evaluator/index.ts`.
is_comment_token_kind :: (fn(k : TokenKind) -> bool)(
  cond(
    (k == TokenKind.SingleLineComment) => true,
    (k == TokenKind.MultiLineComment) => true,
    (k == TokenKind.DocLineComment) => true,
    (k == TokenKind.InnerDocLineComment) => true,
    (k == TokenKind.DocBlockComment) => true,
    (k == TokenKind.InnerDocBlockComment) => true,
    true => false
  )
);
/// Returns `true` if any plain comment (`//` or `/* */`) in `tokens` contains
/// `attribute`. Doc comment tokens (`///`, `//!`, `/** */`, `/*! */`) are
/// deliberately excluded so that documentation that merely mentions an
/// attribute does not trigger it.
/// Mirrors `hasCommentAttribute` in `src/evaluator/index.ts`.
has_comment_attribute :: (fn(tokens : ArrayList(Token), attribute : String) -> bool)({
  (found : bool) = false;
  (i : usize) = usize(0);
  n := tokens.len();
  while((i < n) && !found, {
    match(
      tokens.get(i),
      .Some(tok) => {
        is_plain_comment := cond(
          (tok.kind == TokenKind.SingleLineComment) => true,
          (tok.kind == TokenKind.MultiLineComment) => true,
          true => false
        );
        if(is_plain_comment && tok.value.contains(attribute), {
          found = true;
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
// ---------------------------------------------------------------------------
// Evaluator object
// ---------------------------------------------------------------------------
/// Wraps parse + evaluate into a single reusable handle.
///
/// Mirrors the `Evaluator` class in `src/evaluator/index.ts`.
Evaluator :: ref(
  struct(
    input_string : String,
    module_path : String,
    program : ArrayList(AstExpr),
    tokens : ArrayList(Token),
    module_value : Option(EvalValue),
    module_error : Option(String),
    env : Option(Environment)
  )
);
impl(
  Evaluator,
  /// Create an `Evaluator` from pre-loaded source text.
  ///
  /// Phase 2i: file reading is the caller's responsibility.
  /// A `new_from_file` helper with `io : Io` will be added later.
  ///
  /// `load_module_fn` is called for every `import("...")` encountered during
  /// evaluation, AND for loading the prelude (unless the `@skip_prelude` directive
  /// is present in the source).  Return `None` from the callback to signal
  /// that a module could not be found.
  new : (
    fn(
      module_path : String,
      std_path : String,
      load_module_fn : (fn(path : String) -> Option(EvalValue)),
      input_string : String,
      exn : Exception
    ) -> Self
  )({
    // --- Parse ---
    parser := Parser.new(input_string, module_path, exn);
    toks := parser.get_tokens();
    // Desugar `if(...)` → `cond(...)` on the fresh parse, mirroring
    // parser.yo `parse` (this constructor drives Parser directly).
    program := desugar_program_if_calls(parser.get_program(exn));
    // --- Create base environment ---
    (env : Environment) = Environment.new(module_path);
    // NOTE: no module-loader wiring call here. `import("...")` resolves through
    // `load_module_fn` directly (used for the prelude just below) and through
    // `g_evaluator_load_fn`. The retired `eval.yo` proto-evaluator had its own
    // `g_module_loader` global, read nowhere else, so the old
    // `set_module_loader(load_module_fn)` call was inert. `src/evaluator/index.ts`
    // has no such setter either.
    // --- Prelude injection ---
    // Phase G: scan top-level `pragma(Pragma.SkipPrelude);` calls
    // before the prelude loads. This replaces the legacy
    // `// @skip_prelude` comment scan; the AST-level pre-scan stays
    // in sync with the TS evaluator (`preScanForSkipPrelude` in
    // src/evaluator/builtins/pragma.ts) and validates the pragma
    // argument shape semantically rather than as text.
    skip_prelude := pre_scan_for_skip_prelude(program.clone());
    (module_error : Option(String)) = .None;
    if(!skip_prelude, {
      prelude_path := `file://${std_path}/prelude.yo`;
      match(
        load_module_fn(prelude_path),
        .Some(pval) =>
          match(
            pval,
            .StructVal(_, pnames, pvalues) => {
              // Push a dedicated prelude frame so user code can shadow prelude names.
              env.push_frame(true);
              (pi : usize) = usize(0);
              pn := pnames.len();
              while(pi < pn, {
                match(
                  pnames.get(pi),
                  .Some(pname) => {
                    match(
                      pvalues.get(pi),
                      .Some(pval_item) => {
                        env.define_val(pname, TypeValue.Unit, true, .Some(pval_item));
                        ()
                      },
                      .None => ()
                    );
                  },
                  .None => ()
                );
                pi = (pi + usize(1));
              });
            },
            _ => {
              module_error = .Some(String.from("Prelude is not a module value"));
            }
          ),
        .None => {
          module_error = .Some(String.from("Failed to load prelude"));
        }
      );
    });
    // --- Evaluate ---
    // Phase 3y: register the modular dispatcher so `evaluate_expression`
    // dispatches through the correct function slot even without a test stub.
    register_evaluate_expression();
    // Clone program so the stored `program` field remains valid after
    // evaluation consumes its copy.
    program_for_eval := program.clone();
    // Mirror TS `Evaluator.evaluateProgram`: drive the REAL module evaluator
    // (`evaluateAnonymousModuleBeginExprs`) with an EXECUTING context — not
    // the legacy `evaluate_module_body` flat walker, whose non-executing walk
    // diverges from TS (e.g. macro bodies evaluated without `is_executing`
    // lose comptime values; issues/yo-self-expr-eq-macro-body-false.md).
    (module_value : Option(EvalValue)) = .None;
    (final_env : Option(Environment)) = .Some(env);
    if(module_error.is_none(), {
      g_evaluator_load_fn = .Some(load_module_fn);
      ctx := eval_context_new(std_path.clone(), module_path.clone());
      ctx.is_executing = true;
      ctx.load_module = g_evaluator_ctx_loader;
      result := evaluate_anonymous_module_begin_exprs(
        program_for_eval,
        env,
        ctx,
        false,
        true,
        exn
      );
      module_value = Option(EvalValue).Some(result.module_value);
      module_error = result.partial_module_error;
      final_env = Option(Environment).Some(result.env);
      // Mirror TS: build the O(1) prelude variable cache after evaluating
      // the prelude itself.
      if(module_path.ends_with(String.from("prelude.yo")), {
        build_prelude_var_cache(result.env);
      });
    });
    Evaluator(
      input_string : input_string,
      module_path : module_path,
      program : program,
      tokens : toks,
      module_value : module_value,
      module_error : module_error,
      env : final_env
    )
  }),
  get_program : (fn(self : Self) -> ArrayList(AstExpr))(self.program),
  get_tokens : (fn(self : Self) -> ArrayList(Token))(self.tokens),
  get_module_value : (fn(self : Self) -> Option(EvalValue))(self.module_value),
  get_module_error : (fn(self : Self) -> Option(String))(self.module_error),
  get_env : (fn(self : Self) -> Option(Environment))(self.env)
);
// ---------------------------------------------------------------------------
// Impl-registry stub re-exports
// ---------------------------------------------------------------------------
// These will clear global impl state when `src/evaluator/values/impl.ts` is
// ported.  Until then they are no-ops that callers (e.g. module-manager) can
// safely call.
/// No-op stub. Mirrors `clearImplsFromModule` in `src/evaluator/values/impl.ts`.
clear_impls_from_module :: (fn(_module_path : String) -> unit)(());
/// No-op stub. Mirrors `clearGenericImplsFromModule` in `src/evaluator/values/impl.ts`.
clear_generic_impls_from_module :: (fn(_module_path : String) -> unit)(());
/// No-op stub. Mirrors `clearAllGlobalImplState` in `src/evaluator/values/impl.ts`.
clear_all_global_impl_state :: (fn() -> unit)(());
export(has_comment_attribute, Evaluator);
export(clear_impls_from_module, clear_generic_impls_from_module, clear_all_global_impl_state);
