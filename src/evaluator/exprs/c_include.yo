//! evaluate_c_include — handles `c_include("<stdio.h>", ...)` declarations.
//!
//! A `c_include(...)` call evaluates to a MODULE VALUE — the same
//! source-namespace struct an `import(...)` yields — so its names enter scope
//! only through a binding: `c :: c_include(...)` (qualified `c.printf`),
//! `{ printf, stdout : out } :: c_include(...)` (selective, renamed), or the
//! glob `{ ... } :: c_include(...)`, which is what a bare statement-position
//! `c_include(...)` desugars to at parse time (`_wrap_glob_destructure`,
//! src/expr.yo). plans/C_INCLUDE_EXTERN_MODULE_VALUE.md.
//!
//! 1:1 port of `src/evaluator/exprs/c-include.ts` (189 lines).
//!
//! Phase 2av: fully ported — calls `evaluate_module_field` and adds fields to
//! the environment.  The `is_extern`/`externName` markers ARE ported (onto the
//! `Func` variant): the extern-call `unsafe(...)` gate in `calls/function.yo`
//! reads them to require `c_include`d FFI call sites be wrapped in `unsafe(...)`
//! (plans/archive/EXTERN_UNSAFE_WRAP.md). `cInclude` is ported as the
//! side-table below (2026-08-10 — its absence made every self-emitted binary
//! rely on the hardcoded platform includes; `<mach-o/dyld.h>` was the first
//! header not covered, see
//! issues/fixed/yo-self-extern-c-include-never-registered.md).
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  BK_C_INCLUDE
} :: import("../../expr.yo");
{ new_expr_info, expr_info_table_set, expr_info_table_get, register_extern_c_global, register_extern_c_module_id } :: import("../../expr_info.yo");
{ stable_module_id, fnv1a64 } :: import("../../utils.yo");
{ Environment, Frame, new_frame, add_variable_to_env, get_variables_from_env, invalidate_frame_index } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, create_unknown_val_with_name, create_runtime_unknown_val_with_name } :: import("../../value.yo");
{ is_function_type } :: import("../../types/guards.yo");
{ TypeValue, FuncMeta } :: import("../../types/definitions.yo");
{ t_unit, t_some_t, t_type } :: import("../../types/creators.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{ register_extern_type_name, register_extern_type_c_name, register_adopted_extern_c_type, type_decl_id } :: import("../../types/guards.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ evaluate_expression } :: import("./expr.yo");
{ EvalModuleFieldResult, evaluate_module_field } :: import("../types/record.yo");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
// ---------------------------------------------------------------------------
// The `cInclude` side-table — the port of `FunctionType.cInclude`
// (c-include.ts:141). yo-self's `FuncMeta` carries no `c_include` field
// (adding one would touch all 13 FuncMeta constructors and risk the
// type-intern merge dropping it), so the header is recorded here, keyed by
// the extern symbol name, when the FFI marker is stamped — and read back by
// the codegen extern-fn registration (`codegen/functions/collection.yo`).
// Process-lifetime, like the default-args and macro-expansion side-tables:
// re-evaluation re-records the same mapping, and a stale entry can at worst
// re-emit a header the target already knows.
// ---------------------------------------------------------------------------
(g_extern_c_includes : HashMap(String, ArrayList(String))) = HashMap(String, ArrayList(String)).new();
/// Record `header` for `name`. A name may be declared under several headers
/// (two `c_include` modules binding the same symbol); every one is kept, in
/// first-seen order, so codegen can `#include` them all instead of whichever
/// module happened to be evaluated last.
record_c_include_for_extern :: (fn(name : String, header : String) -> unit)({
  match(
    g_extern_c_includes.get(name.clone()),
    .Some(list) => {
      (i : usize) = usize(0);
      (seen : bool) = false;
      while(i < list.len(), {
        match(list.get(i), .Some(h) => if(h == header, {
          seen = true;
        }), .None => ());
        i = (i + usize(1));
      });
      if(!seen, {
        list.push(header);
      });
    },
    .None => {
      list := ArrayList(String).new();
      list.push(header);
      g_extern_c_includes.insert(name, list);
    }
  );
});
/// The FIRST C header a `c_include`d extern symbol was declared under, if any
/// (the registration slot of `register_extern_function` holds one header).
get_c_include_for_extern :: (fn(name : String) -> Option(String))(
  match(g_extern_c_includes.get(name), .Some(l) => l.get(usize(0)), .None => Option(String).None)
);
/// Every C header a `c_include`d extern symbol was declared under.
get_c_includes_for_extern :: (fn(name : String) -> ArrayList(String))(
  match(g_extern_c_includes.get(name), .Some(l) => l, .None => ArrayList(String).new())
);
/// The already-bound type a `c_include` `Name : Type` field should ADOPT, or
/// `.None` when the name is free (the ordinary opaque-handle case).
///
/// Adoptable means: the name resolves in this module's environment to a real
/// type value that carries a declaration id — a `struct(...)` or `enum(...)`
/// written in Yo. A `union(...)` has no id to key the registry by and is not
/// adopted; neither is a SomeT (an opaque handle from an earlier `c_include`
/// or `extern`), which would be adopting a placeholder as itself.
_adoptable_type_binding :: (fn(env : Environment, name : String) -> Option(TypeValue))({
  vars := get_variables_from_env(env, name);
  n := vars.len();
  if(n == usize(0), {
    return(Option(TypeValue).None);
  });
  v := match(vars.get(n - usize(1)), .Some(x) => x, .None => return(Option(TypeValue).None));
  val := match(v.value.get(usize(0)), .Some(x) => x, .None => return(Option(TypeValue).None));
  ty := match(val, .TypeVal(t) => t, _ => return(Option(TypeValue).None));
  match(type_decl_id(ty), .Some(_) => Option(TypeValue).Some(ty), .None => Option(TypeValue).None)
});
/// A `label : c_type("<C spelling>")` field — an opaque C type whose C name
/// is not a Yo identifier (`struct stat`, `struct timespec`). `.Some(spelling)`
/// when `arg` has that shape (a malformed `c_type(...)` is an error), `.None`
/// for every other field.
_c_type_field_spelling :: (fn(arg : AstExpr, exn : Exception) -> Option(String))({
  if(!ast_expr_is_fn_call_of(arg, ":", .Some(usize(2))), {
    return(Option(String).None);
  });
  pair := match(arg, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  rhs := match(pair.get(usize(1)), .Some(r) => r, .None => arg);
  if(!ast_expr_is_fn_call_of(rhs, "c_type", .None), {
    return(Option(String).None);
  });
  cargs := match(rhs, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  spelling_atom := match(cargs.get(usize(0)), .Some(a) => a, .None => rhs);
  raw := ast_expr_token(spelling_atom).value.clone();
  rn := raw.len();
  (spelling : String) = if(
    (cargs.len() == usize(1)) && ast_expr_is_atom(spelling_atom) && (rn >= usize(2)) && raw.starts_with(String.from("\"")),
    raw.substring(usize(1), rn - usize(1)),
    String.new()
  );
  if(spelling.len() == usize(0), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(rhs),
          String.from("Expected `c_type(\"<C spelling>\")` with one string argument, such as:\n\n  stat_buf : c_type(\"struct stat\")")
        )
      )
    );
  });
  Option(String).Some(spelling)
});
evaluate_c_include :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  if(!ast_expr_is_fn_call_of(expr, BK_C_INCLUDE, .None), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected c_include, got ${ast_expr_token(expr).value}`
        )
      )
    );
  });
  // Privilege gate (mirrors evaluate_extern). `c_include(...)` brings C
  // header symbols into scope as `extern "c"` declarations; safe code
  // (no `pragma(Pragma.AllowUnsafe);`) must not be able to do this. The
  // call-site gate in `function.yo` catches actual calls, but type-level
  // uses (an imported extern Type in a field/trait bound) would slip
  // through. Mirrors `c-include.ts:46-66`.
  if(!is_implicitly_unsafe_capable_file(Option(String).Some(ast_expr_token(expr).module_path.clone())), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `'c_include(...)' is not available in safe code.

C header imports declare 'extern "c"' symbols, which are outside Yo's
type-checking reach. To use them, declare at the top of this file:

    pragma(Pragma.AllowUnsafe);

User code should normally call stdlib wrappers (e.g. functions in
'std/sys', 'std/fs') instead of pulling in C headers directly.`
        )
      )
    );
  });
  (env : Environment) = env_in;
  all_args := match(expr, .FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
  // First arg must be an atom (the C header file string literal, e.g. "<stdio.h>").
  first_arg_opt := all_args.get(usize(0));
  if(!match(first_arg_opt, .Some(a) => ast_expr_is_atom(a), .None => false), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Expected C header file as first argument to c_include, such as:\n\nc_include \"<stdio.h>\" ...;")
        )
      )
    );
  });
  c_header_file_arg := match(first_arg_opt, .Some(a) => a, .None => expr);
  evaluated_hdr := evaluate_expression(c_header_file_arg, env, ctx);
  hdr_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_hdr));
  hdr_info := match(hdr_info_opt, .Some(i) => i, .None => new_expr_info(env, t_unit()));
  env.frames = hdr_info.env.frames;
  env.module_path = hdr_info.env.module_path;
  env.function_declaration_frame_level = hdr_info.env.function_declaration_frame_level;
  env.input_string = hdr_info.env.input_string;
  raw_hdr := match(
    hdr_info.value,
    .Some(v) => match(
      v,
      .StrLit(s) => s,
      _ => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(c_header_file_arg),
              `Expected string for C header file argument`
            )
          )
        );
        String.new()
      }
    ),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(c_header_file_arg),
            `Failed to evaluate C header file argument`
          )
        )
      );
      String.new()
    }
  );
  // Strip surrounding quotes from the raw string literal.
  rn := raw_hdr.len();
  (c_header_file : String) = if(
    rn >= usize(2),
    raw_hdr.substring(usize(1), rn - usize(1)),
    raw_hdr.clone()
  );
  if(c_header_file.len() == usize(0), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Expected C header file as first argument to c_include, such as:\n\nc_include \"<stdio.h>\" ...;")
        )
      )
    );
  });
  // Iterate over the field declarations (args[1..]). Each field is bound in
  // the CURRENT frame while the list is walked, so a later field can name an
  // earlier one (`FILE : Type, stdin : *FILE`); those bindings are removed
  // again afterwards and the collected labels / types / values become the
  // module value. Nothing stays in the caller's scope. The current frame, not
  // a pushed scratch frame: a generic parameter's SomeT is keyed on its frame
  // LEVEL, so a field type evaluated one frame deeper stopped unifying with
  // the identical type written at module level (`Io.async : (fn(generic(T, E),
  // …))` against `extern("Yo", __yo_io_async : (fn(generic(T, E), …)))`).
  field_labels := ArrayList(String).new();
  field_types := ArrayList(TypeValue).new();
  field_vals := ArrayList(EvalValue).new();
  (scratch_frame : Frame) = match(env.frames.get(env.frames.len() - usize(1)), .Some(f) => f, .None => new_frame(false));
  scratch_base := scratch_frame.variables.len();
  (args_idx : usize) = usize(1);
  (field_idx : usize) = usize(0);
  while(args_idx < all_args.len(), {
    arg := match(all_args.get(args_idx), .Some(a) => a, .None => expr);
    // `label : c_type("struct stat")` is a `Type` field with an explicit C
    // spelling; it is not a type EXPRESSION, so it never reaches
    // evaluate_module_field.
    c_type_spelling := _c_type_field_spelling(arg, exn);
    result := match(
      c_type_spelling,
      .Some(_) => EvalModuleFieldResult(
        label : match(
          match(arg, .FnCall(_, _, pa, _, _) => pa.get(usize(0)), .Atom(_, _) => Option(AstExpr).None),
          .Some(l) => ast_expr_token(l).value.clone(),
          .None => String.new()
        ),
        field_type : t_type(),
        env : env
      ),
      .None => evaluate_module_field(arg, field_idx, env, ctx, false, exn)
    );
    // Check for duplicate labels.
    (dup_idx : usize) = usize(0);
    (has_dup : bool) = false;
    while((dup_idx < field_labels.len()) && !has_dup, {
      existing := match(field_labels.get(dup_idx), .Some(l) => l, .None => String.from(""));
      if(existing == result.label, {
        has_dup = true;
      });
      dup_idx = (dup_idx + usize(1));
    });
    if(has_dup, {
      err_tok := if(
        ast_expr_is_fn_call(arg),
        match(
          match(arg, .FnCall(_, _, a2, _, _) => a2, _ => ArrayList(AstExpr).new()).get(usize(0)),
          .Some(fe) => ast_expr_token(fe),
          .None => ast_expr_token(arg)
        ),
        ast_expr_token(arg)
      );
      exn.throw(
        dyn(
          format_error_message(
            err_tok,
            `Duplicate label "${result.label}" in module`
          )
        )
      );
    });
    // Stamp the FFI marker (`is_extern = "c"`, `extern_name = label`) onto
    // function field types so the extern-call `unsafe(...)` gate
    // (calls/function.yo) can identify calls to this `c_include`d symbol.
    // Mirrors `c-include.ts:138-145` (the `isFunctionType` branch). Non-`Func`
    // field types (type declarations like `time_t : Type`) carry no
    // `is_extern` slot and are never called. `cInclude` goes to the
    // side-table above (TS stores it on the type).
    // Record the header for EVERY field, not only the `.Func` ones. A c_include
    // GLOBAL (`HUGE_VAL`, `M_PI`, `stdout`) emits its real C name at the use
    // site, which only exists if the header is `#include`d — and codegen has no
    // other way to learn which header that is
    // (issues/fixed/c-include-global-does-not-emit-its-header.md). Harmless for the
    // `Type` fields (`time_t : Type`), which are never emitted as a value.
    record_c_include_for_extern(result.label.clone(), c_header_file.clone());
    field_ty_with_extern := match(
      result.field_type,
      .Func({
        forall_types : fts,
        param_types : pts,
        implicit_types : its,
        where_types : wts,
        result : ret,
        meta : m
      }) => TypeValue.Func(
        fts,
        pts,
        its,
        wts,
        ret,
        box(
          FuncMeta(
            forall_labels : m.*.forall_labels.clone(),
            param_labels : m.*.param_labels.clone(),
            implicit_labels : m.*.implicit_labels.clone(),
            implicit_spreads : m.*.implicit_spreads.clone(),
            result_is_comptime_only : m.*.result_is_comptime_only,
            param_is_ref : m.*.param_is_ref.clone(),
            param_is_owning : m.*.param_is_owning.clone(),
            result_is_ref : m.*.result_is_ref,
            has_variadic : m.*.has_variadic,
            is_extern : Option(String).Some(String.from("c")),
            extern_name : Option(String).Some(result.label.clone()),
            is_control : m.*.is_control,
            variadic_label : Option(String).None,
            variadic_comptime : false
          )
        ),
        ArrayList(TypeValue).new()
      ),
      _ => result.field_type
    );
    field_labels.push(result.label.clone());
    field_types.push(field_ty_with_extern);
    env.frames = result.env.frames;
    env.module_path = result.env.module_path;
    env.function_declaration_frame_level = result.env.function_declaration_frame_level;
    env.input_string = result.env.input_string;
    // If the field type is Type (TypeUni(0)), this is a type declaration (e.g. time_t : Type).
    // Create a SomeType placeholder so the identifier can be used in type expressions.
    (field_val : EvalValue) = match(
      result.field_type,
      .TypeUni(level) => cond(
        (level == usize(0)) => {
          // A `c_include` type declaration (`pid_t : Type`) is an extern-C
          // OPAQUE type exactly like `extern("Yo", X : Type)` — record the
          // name so extern-aware checks see it (TS marks the SomeType with
          // `isExtern = "c"`; yo-self's SomeT has no field, the guards.yo
          // name registry stands in — same as extern.yo:269). Without this,
          // `i32(unsafe(getpid()))` failed is_convertible_numeric_type's
          // extern clause and FTT'd (the sys/signal red).
          register_extern_type_name(result.label.clone());
          // ADOPT, don't shadow. When the label ALREADY names a module type,
          // `Name : Type` is not declaring a new opaque handle — it is saying
          // "the Yo type `Name` IS the C type `Name` in this header". Replacing
          // it with an opaque placeholder is what made every C struct
          // UNCONSTRUCTIBLE (`Vector2(x : …)` → "TypeVal SomeT callee without
          // FnTrait"), so a by-value C ABI could not be expressed at all.
          //
          // Adoption keeps the real, constructible type and records the C name
          // + header for codegen, which then lowers the type to `Vector2`
          // instead of `__yo_t7` and emits NO definition of its own (the header
          // has one). See issues/fixed/c-include-cannot-express-a-by-value-c-struct.md.
          // With `c_type("...")` the C spelling is explicit: an adopted Yo
          // struct lowers to that spelling (`struct point`), an opaque handle
          // is registered under it so `*label` becomes `struct stat*`.
          c_spelling := match(c_type_spelling, .Some(s) => s, .None => result.label.clone());
          match(
            _adoptable_type_binding(env, result.label.clone()),
            .Some(existing_ty) => {
              register_adopted_extern_c_type(
                match(type_decl_id(existing_ty), .Some(d) => d, .None => String.from("")),
                c_spelling,
                c_header_file.clone()
              );
              EvalValue.TypeVal(existing_ty)
            },
            .None => {
              match(
                c_type_spelling,
                .Some(s) => register_extern_type_c_name(result.label.clone(), s),
                .None => ()
              );
              EvalValue.TypeVal(t_some_t(result.label.clone(), usize(0)))
            }
          )
        },
        true => create_unknown_val_with_name(result.field_type, result.label.clone())
      ),
      _ => cond(
        // An extern FUNCTION keeps the plain unknown: codegen identifies a
        // c_include callee by exactly that value shape
        // (`_register_extern_fn_callee`'s "callee value present but not a
        // function value" arm).
        is_function_type(field_ty_with_extern) => create_unknown_val_with_name(field_ty_with_extern, result.label.clone()),
        // An extern-C GLOBAL (`HUGE_VAL`, `M_PI`, `stdout`) is a C object the
        // compiler cannot read — it exists only at RUN time. Saying so is what
        // makes `X :: HUGE_VAL` hit the existing "Got runtime value. Please
        // consider using \":=\" instead of \"::\"" diagnostic; a plain unknown
        // reads as a comptime value there, so the binding was accepted and
        // codegen then emitted a C name that was never declared.
        // See issues/c-include-global-accepted-by-comptime-binding.md.
        true => create_runtime_unknown_val_with_name(field_ty_with_extern, result.label.clone())
      )
    );
    field_vals.push(field_val);
    // Bind the field so the remaining field declarations can refer to it
    // (compile-time only, unknown value placeholder); removed below.
    _var_opt := add_variable_to_env(
      env,
      result.label.clone(),
      field_ty_with_extern,
      Option(EvalValue).Some(field_val),
      true,
      // is_compile_time_only
      false,
      // is_reassignable
      type_contains_rc_type(field_ty_with_extern),
      // is_owning_the_rc_value
      false,
      // is_implicit
      ast_expr_token(arg)
    );
    // Mark this c_include symbol as an extern-C global so codegen keeps its REAL
    // C name (e.g. `stdout`) instead of the `__yo_c_reserved_` prefix. yo-self
    // models is_extern only on the Func TypeValue, so non-Func globals
    // (`stdout : *(FILE)`) can't carry the marker on their type — this registry
    // covers them (see expr_info.yo). Harmless for Func/Type fields.
    register_extern_c_global(result.label.clone(), field_ty_with_extern.clone());
    args_idx = (args_idx + usize(1));
    field_idx = (field_idx + usize(1));
  });
  // Remove the field bindings again. A shrunk frame violates the name
  // index's append-only contract, so drop the index (the same idiom as
  // comptime_expect_error's frame restore and the pending-def reset).
  if(scratch_frame.variables.len() > scratch_base, {
    scratch_frame.variables.truncate(scratch_base);
    invalidate_frame_index(scratch_frame);
  });
  // The module value: a source-namespace struct, exactly the shape an
  // `import(...)` produces (anonymous_module.yo), so destructuring, property
  // access and the glob all work unchanged. The id is `source_namespace_`-
  // prefixed (that prefix is how a StructVal is recognised as a module) under
  // a distinct `extern_` marker so it never collides with the enclosing
  // module's own id, and it is deliberately NOT registered in `g_sns_module`:
  // there is no module on disk to attribute member reads to. It IS recorded
  // as a c_include module so the destructurer can alias a renamed global to
  // its C symbol (expr_info.yo, plans/C_INCLUDE_EXTERN_MODULE_VALUE.md §3.4).
  sns_id := stable_module_id(`source_namespace_extern_${fnv1a64(env.module_path.clone()).to_string()}_`, env.module_path.clone());
  register_extern_c_module_id(sns_id.clone());
  module_type := TypeValue.Struct(
    sns_id.clone(),
    String.from(""),
    field_labels.clone(),
    field_types,
    false,
    // is_reference_semantics
    false,
    // is_atomic_rc
    false,
    // is_newtype
    String.from(""),
    // constructor_func_id
    ArrayList(TypeValue).new(),
    // type_arguments
    true // is_source_namespace
  );
  mod_info := new_expr_info(env, module_type);
  mod_info.value = .Some(EvalValue.StructVal(sns_id, field_labels, field_vals));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), mod_info);
  // Annotate callee (the "c_include" func node) with same info.
  callee_expr := match(expr, .FnCall(_, fb, _, _, _) => fb, .Atom(_, _) => expr);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(callee_expr), mod_info);
  expr
});
export(evaluate_c_include);
export(get_c_include_for_extern, get_c_includes_for_extern);
