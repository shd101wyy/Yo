// Local helpers
// ---------------------------------------------------------------------------
/// The value wall at a fieldless variant of an enum whose type holds a
/// reference (decision 43 step 3): an INLINE composite (O4 row 2) is N2b's
/// and builds; a container or a cell stays named-only
/// (`origin_beyond_n2b_message`).
_reject_origin_carrying_unit_variant :: (fn(en_ty : &TypeValue, at : &AstExpr, ctx : &EvalContext, exn : Exception) -> unit)(
  // In a std body (specialized for a type holding a reference) the user's
  // call that reached it is walled instead, naming the user's type.
  if(origin_beyond_n2b(en_ty) && !is_std_module_path(&ast_expr_token(at).module_path.*, ctx.std_path.clone()), {
    exn.throw(dyn(format_error_message(ast_expr_token(at), origin_beyond_n2b_message(en_ty))));
  })
);
/// A read of a reference FIELD (decision 43 step 2, N1e-2): `v.at` with
/// `at : &(T, p)` reads as the place it refers to, of type `T`, as a
/// reference binding does (VERDICTS-13 §11's check layer): `v.at.*` is that
/// place, `v.at.f`/`v.at.m()`/`f(v.at)` read through or lend it, and a bare
/// `v.at` in a by-value position is E0926. The returned type is the field's
/// as it is read: the pointee for a reference field. A `v.at.*` evaluated
/// before reads with its label at the `*` (`is_reference_deref_site`) and is
/// a plain read.
_reference_field_read_type :: (fn(ft : &TypeValue, expr : &AstExpr, property_expr : &AstExpr, exempt : bool, ctx : &EvalContext, exn : Exception) -> TypeValue)(
  match(
    ft,
    Rc(.Reference(rf_pointee, _, _)) => {
      rf_tok := ast_expr_token(property_expr);
      if(!is_reference_deref_site(&rf_tok), {
        note_reference_field_read(ast_expr_id(expr), ft);
        // Where the position expects a reference, the read is the reference
        // (the read rule, decision 43 step 2 N1e-2b): no whole-value read.
        if(!exempt && deref_rule_applies(&rf_tok, ctx) && !reference_read_wanted(&rf_tok, false, ctx), {
          reject_reference_field_without_deref(&local_borrow_place_text(expr), &rf_tok.value.*, ft, &rf_tok, ctx, exn);
        });
      });
      Rc.clone(rf_pointee)
    },
    _ => Rc.clone(ft)
  )
);
/// A payload-free variant of a reference-semantics enum (`ref(enum(UnitVal, …))`)
/// still heap-allocates: `generate_comptime_value` emits
/// `__yo_new_<Enum>_<Variant>()`, which mallocs with `ref_count = 1`. The
/// expression therefore OWNS an RC value, exactly like the payload-carrying
/// form `E.IntVal(v : …)` — that form is a function call and gets its owning
/// temp from the call path.
///
/// Without a temp variable the allocation is never registered at the enclosing
/// begin-block frame, so the scope-end drop pass never sees it, no `___drop` is
/// emitted, and an inline `f(E.UnitVal)` leaks the object (the callee treats the
/// parameter as borrowed and dups whatever it retains).
///
/// Deliberately NOT `type_contains_rc_type(ty)`: that is also true of a VALUE
/// enum whose *other* variants carry RC payloads (`Option(String)`,
/// `Result(…)`), whose payload-free variant materializes as a `{ .tag = … }`
/// compound literal and allocates nothing. An owning temp there is pure
/// overhead on the most common expression shape in std — and it makes
/// `(x : Option(String)) ?= Option(String).None` fail the not-consumed gate.
///
/// The "some variant has fields" conjunct matches `can_optimize_as_simple_enum`
/// (`src/codegen/utils/index.yo`): an all-payload-free enum collapses to a
/// plain C enum constant and also allocates nothing.
_attach_owned_temp_for_rc_unit_variant :: (
  fn(
    expr : &AstExpr,
    ty : &TypeValue,
    ctx : &EvalContext
  ) -> unit
)({
  if(!is_reference_enum_type(ty), return(()));
  has_payload_variant := match(
    ty,
    Rc(.EnumT({ variant_fields })) => {
      (found : bool) = false;
      n := variant_fields.len();
      (vi : usize) = usize(0);
      while(vi < n, {
        match(
          variant_fields.get(vi),
          .Some(fields) => {
            if(fields.len() > usize(0), {
              found = true;
            });
          },
          .None => ()
        );
        vi = (vi + usize(1));
      });
      found
    },
    _ => false
  );
  if(!has_payload_variant, return(()));
  attach_temp_variable_to_expr(expr, true, ctx);
});
/// Return the last index in `labels` where `labels[i] == name`, or `.None`.
/// A GADT variant constructs only the instantiation its `-> recur(...)` index
/// names: `BoolVal(b : bool) -> recur(bool)` builds a `Value(bool)`, so
/// `Value(i32).BoolVal(true)` (or `.BoolVal(true)` where a `Value(i32)` is
/// expected) is a type error — the constructed value would claim an index the
/// variant cannot have, and a match that omits the GADT-unreachable arm
/// would then fall off (issues/fixed/enum-type-constructor-arguments-are-ignored-by-type-compatibility.md).
/// An instantiation whose index is still a SomeT (a generic body) is not
/// judged here: `gadt_branch_reachable` treats unresolved positions as a match.
_reject_gadt_unreachable_variant :: (
  fn(enum_ty : &TypeValue, enum_id : &String, variant_idx : usize, variant_name : &String, at : &AstExpr, exn : Exception) -> unit
)({
  if(!gadt_branch_reachable(enum_id.clone(), variant_idx), {
    idx := match(
      get_gadt_variant_args(enum_id),
      .Some(all) => match(all.get_cloned(variant_idx), .Some(g) => g, .None => ArrayList(TypeValue).new()),
      .None => ArrayList(TypeValue).new()
    );
    idx_s := String.from("");
    (ii : usize) = usize(0);
    while(ii < idx.len(), {
      if(ii > usize(0), {
        idx_s.push_str(", ");
      });
      idx_s.push_string(type_to_string(match(idx.get_cloned(ii), .Some(t) => t, .None => t_unit())));
      ii = (ii + usize(1));
    });
    exn.throw(
      dyn(
        format_error_message_with_help(
          ast_expr_token(at),
          `Incompatible types: GADT variant "${variant_name}" is declared \`-> recur(${idx_s})\`, so it cannot construct a ${type_to_string(enum_ty)}`,
          Option(String).Some(String.from("construct the variant through the instantiation its index names, or pick a variant whose `-> recur(...)` index matches"))
        )
      )
    );
  });
});
find_last_field_index :: (fn(labels : &ArrayList(String), name : &String) -> Option(usize))({
  n := labels.len();
  (result : Option(usize)) = Option(usize).None;
  (i : usize) = usize(0);
  while(i < n, {
    match(
      labels.get_cloned(i),
      .Some(lbl) => {
        if(lbl == name.*, {
          result = Option(usize).Some(i);
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  result
});
/// Return the first index in `labels` where `labels[i] == name`, or `.None`.
find_first_field_index :: (fn(labels : &ArrayList(String), name : &String) -> Option(usize))({
  n := labels.len();
  (result : Option(usize)) = Option(usize).None;
  (i : usize) = usize(0);
  while((i < n) && result.is_none(), {
    match(
      labels.get_cloned(i),
      .Some(lbl) => {
        if(lbl == name.*, {
          result = Option(usize).Some(i);
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  result
});
// ---------------------------------------------------------------------------
// Auto-dereference (plans/VALUES_BY_DEFAULT.md §3.3)
// ---------------------------------------------------------------------------
/// `.(obj, *)` — the explicit payload place of a `Deref` wrapper, built by
/// the field and method auto-dereference hooks. Fresh ids; the tokens copy
/// `at`'s position and module path, so a diagnostic on the synthesized node
/// still points at the user's access.
make_deref_expr :: (fn(obj : &AstExpr, dot_tok : &Token, at : &Token) -> AstExpr)({
  star_tok := Token(
    kind : TokenKind.Operator,
    value : intern_token_str(String.from("*")),
    row : at.row,
    column : at.column,
    character : at.character,
    byte_offset : at.byte_offset,
    module_path : Rc.clone(at.module_path),
    input : Rc.clone(at.input)
  );
  star_id := alloc_global_expr_id();
  note_synthesized_deref_star(star_id);
  args := ArrayList(AstExpr).new();
  args.push(obj.*);
  args.push(AstExpr.Atom(star_id, star_tok));
  AstExpr.FnCall(alloc_global_expr_id(), AstExpr.Atom(alloc_global_expr_id(), dot_tok.*), Rc.new(args), true, dot_tok.*)
});
/// Whether the `*` atom `star` of a `.*` is written (in the source, or in a
/// batch the test runner printed from it as `.(*)`): the auto-deref hooks
/// synthesize `w.*` (`make_deref_expr`), which keeps the payload's reading.
_is_written_star :: (fn(star : &AstExpr) -> bool)(
  !is_synthesized_deref_star(ast_expr_id(star))
);
/// The labels a field read can name on `t`: a struct's, tuple's or union's.
_field_labels_of :: (fn(t : &TypeValue) -> SharedList(String))(
  match(
    t,
    Rc(.Tuple(labels, _)) => Rc.clone(labels),
    Rc(.Struct({ field_labels : labels })) => Rc.clone(labels),
    Rc(.Union(_, labels, _)) => Rc.clone(labels),
    _ => no_labels()
  )
);
/// Whether `.*` can read through a value of type `ty`: a reference, a raw
/// pointer, a handle `.*` reads through (`Box`, `Rc`, `Arc`: `Deref`, or a
/// cell handle), or a type declaring a field named `*` (std's atomics).
_type_is_dereferenceable :: (fn(ty : &TypeValue, env : &Environment) -> bool)(
  t_slot_is_borrow(ty) || deref_reads_through_pointee(ty) || deref_target_type(ty, env).is_some()
);
/// Where auto-dereference of `w.label` lands, for a `w` of `Deref` type `t`
/// whose own fields lack `label`: `.Ok(())` when some payload in the chain
/// (`t`'s `Target`, its `Target`, …) has a field `label`, else `.Err` with
/// the innermost payload type reached (for the E0406 message).
_deref_chain_has_field :: (fn(t : &TypeValue, label : &String, env : &Environment) -> Result(unit, TypeValue))({
  (cur : TypeValue) = Rc.clone(t);
  while(true, {
    match(
      deref_target_type(&cur, env),
      .None => {
        return(.Err(cur));
      },
      .Some(payload) => {
        cur = resolve_struct_shell(&payload);
        if(find_first_field_index(&_field_labels_of(&cur).items, label.clone()).is_some(), {
          return(.Ok(()));
        });
      }
    );
  });
  .Err(cur)
});
/// Build the path_collection for a field-access node.
///
/// If the object already has a non-empty path_collection, each path is
/// extended with `prop_name`.  Otherwise a fresh `[[var_name, prop_name]]`
/// singleton is created.
build_field_path_collection :: (
  fn(
    obj_pc : &ArrayList(ArrayList(String)),
    obj_vname : &Option(String),
    prop_name : &String
  ) -> ArrayList(ArrayList(String))
)({
  result := ArrayList(ArrayList(String)).new();
  if(obj_pc.len() > usize(0), {
    (bpc_i : usize) = usize(0);
    while(bpc_i < obj_pc.len(), {
      match(
        obj_pc.get_cloned(bpc_i),
        .Some(old_path) => {
          new_path := ArrayList(String).new();
          (bpc_j : usize) = usize(0);
          while(bpc_j < old_path.len(), {
            match(
              old_path.get_cloned(bpc_j),
              .Some(seg) => {
                new_path.push(seg);
              },
              .None => ()
            );
            bpc_j = (bpc_j + usize(1));
          });
          new_path.push(prop_name.clone());
          result.push(new_path);
        },
        .None => ()
      );
      bpc_i = (bpc_i + usize(1));
    });
  }, {
    base_path := ArrayList(String).new();
    base_name := match(obj_vname, .Some(n) => n.clone(), .None => String.from("?"));
    base_path.push(base_name);
    base_path.push(prop_name.clone());
    result.push(base_path);
  });
  result
});
/// Try to resolve `<TypeVal>.<prop_name>` as an ASSOCIATED TYPE.
///
/// Associated types (e.g. `Self.Output` from `impl(JsonValue,
/// Index(String)(Output : JsonValue, …))`) are registered in the
/// type-trait-methods registry keyed by the receiver type's id, with a
/// `TypeVal` value. During generic-impl specialization they may also be
/// bound directly in the env. Same assoc-type fallbacks as
/// the struct/union branch (generic-impl specialization first, registry
/// second).
///
/// On success, sets ExprInfo on both `expr` and `property_expr` and
/// returns `true`; otherwise returns `false` (caller proceeds to its
/// not-found handling). Used by the EnumT branch — without it,
/// `Self.Output` on an enum receiver wrongly errors as a missing enum
/// variant before any associated-type lookup runs.
/// MEMBER VISIBILITY for the STATIC spelling `Type._m` (resolved here from
/// the registry, so it never reaches function.yo's receiver-method check):
/// the member's declaring module is its registry entry's registration owner
/// when recorded, else the type's own declaring module. Throws when the
/// access token's module may not see a private member.
_reject_private_static_member :: (
  fn(type_id : &String, prop_name : &String, type_val_inner : &TypeValue, property_expr : &AstExpr, exn : Exception) -> unit
)({
  if(!is_private_member_name(prop_name.clone()), {
    return(());
  });
  entries := get_type_trait_methods_by_name(type_id.clone(), prop_name.clone());
  entry_owner := match(entries.get(usize(0)), .Some(e) => e.owner.clone(), .None => String.new());
  decl := cond(
    (entry_owner.len() > usize(0)) => Option(String).Some(entry_owner),
    true => type_decl_module(type_id)
  );
  if(private_member_blocked(prop_name.clone(), &decl, &ast_expr_token(property_expr).module_path.*), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(property_expr),
          `Method "${prop_name}" of ${type_to_string(type_val_inner)} is private to its declaring module`
        )
      )
    );
  });
});
_try_resolve_associated_type :: (
  fn(
    type_val_inner : &TypeValue,
    prop_name : &String,
    expr : &AstExpr,
    property_expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext
  ) -> bool
)({
  // (a) During generic-impl specialization the assoc type may be bound
  //     directly in the env.
  if(ctx.is_evaluating_generic_impl_specialization, {
    spec_vars := get_variables_from_env(env, prop_name);
    n_spec := spec_vars.len();
    if(n_spec > usize(0), {
      match(
        spec_vars.get_cloned(n_spec - usize(1)),
        .Some(last_spec) => {
          if(is_type_value(last_spec.value().get(usize(0))), {
            match(
              last_spec.value().get(usize(0)),
              .Some(spec_tv) => {
                out_spec := new_expr_info(env, type_of_eval_value(&spec_tv));
                out_spec.set_value(Option(EvalValue).Some(spec_tv));
                out_spec.set_is_accessing_property(Option(bool).Some(true));
                expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_spec);
                expr_info_table_set(&ctx.expr_info_table, ast_expr_id(property_expr), &out_spec);
                return(true);
              },
              .None => ()
            );
          });
        },
        .None => ()
      );
    });
  });
  // (b) Look up in the type-trait-methods registry — covers impl-provided
  //     associated types (the `Output : JsonValue` field is registered
  //     under JsonValue's type id before the `index` method is evaluated).
  tid := type_id_or_empty(type_val_inner);
  if(tid != "", {
    // Exact-instantiation durable assoc entries first (they are not under
    // the bare id two instantiations can share; `get_assoc_type_entries`).
    registry_methods := get_assoc_type_entries(type_val_inner, prop_name.clone());
    // OVERLOAD DEFER: when a type carries MULTIPLE overloads of this method
    // (e.g. `String` implements both `Eq(String).==` (other:String) and
    // `Eq(str).==` (other:str)), do NOT commit to the first one here — resolving
    // `Type.method` to a single FuncVal makes the call site take the
    // `functionToCall.$.value` branch and skip argument-based overload
    // selection, so `Self.(==)(lhs, str_rhs)` (the `Eq` `!=` default's internal
    // call) picks `Eq(String).==` and then throws `Cannot unify "String" and
    // "str"` unifying the `str` arg against the `String` param. Leaving it
    // unresolved (return false) routes the call through `_try_find_receiver_
    // method` + `_select_matching_overload` (function.yo), which handles the
    // static-receiver case and picks the overload whose params match the args —
    // exactly what the infix-operator path already does. Single-overload
    // methods (the common case) are unaffected.
    if(registry_methods.len() > usize(1), {
      return(false);
    });
    (rm_idx : usize) = usize(0);
    while(rm_idx < registry_methods.len(), {
      match(
        registry_methods.get(rm_idx),
        .Some(rm) => match(
          rm.value,
          .Some(rmv) => {
            out_rm := new_expr_info(env, &rm.ty);
            out_rm.set_value(Option(EvalValue).Some(rmv));
            out_rm.set_is_accessing_property(Option(bool).Some(true));
            expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_rm);
            expr_info_table_set(&ctx.expr_info_table, ast_expr_id(property_expr), &out_rm);
            return(true);
          },
          .None => ()
        ),
        .None => ()
      );
      rm_idx = (rm_idx + usize(1));
    });
  });
  false
});
// ---------------------------------------------------------------------------
// evaluate_property_access
// ---------------------------------------------------------------------------
/// The object `r.*` of a written `r.*.*` that `--migrate deref` is
/// evaluating (N1e-1): its own `.*` arm decides whether the inner `.*` is an
/// old payload read or the reference's deref an earlier run wrote.
(mut(g_deref_chain_object_id) : usize) = usize(0);
evaluate_property_access :: (
  fn(
    expr : &AstExpr,
    env_in : &Environment,
    ctx : &mut EvalContext,
    exn : Exception
  ) -> AstExpr
)(
  // A field read the auto-dereference below rewrote reads as rewritten
  // (`ast_rewritten_node`), so a re-evaluation does not rewrite it again.
  match(
    ast_rewritten_node(expr),
    // `r.*` on a reference binding (N1e-1) was rewritten to the name `r`
    // itself: a re-evaluation reads the name.
    .Atom(rw_id, rw_tok) => evaluate_expression_raw(&AstExpr.Atom(rw_id, rw_tok), env_in, ctx, exn),
    // `f(x).*` on a projection call was rewritten to the call: a
    // re-evaluation evaluates the call and keeps the `.*` node, a value.
    rw_node => if(ast_expr_is_fn_call_of(&rw_node, BF_DOT, Option(usize).None), _evaluate_property_access_node(&rw_node, env_in, ctx, exn), {
      rw_call := evaluate_expression_raw(&rw_node, env_in, ctx, exn);
      _note_projection_call_deref(expr, &rw_call, env_in, ctx);
      expr.clone()
    })
  )
);
/// `deref` (`f(x).*`) reads the place the evaluated projection call `call`
/// names: it is recorded rewritten to the call and carries the call's info.
_note_projection_call_deref :: (fn(deref : &AstExpr, call : &AstExpr, env : &Environment, ctx : &mut EvalContext) -> unit)({
  note_rewritten_node_as(ast_expr_id(deref), call);
  match(
    expr_info_table_get(&ctx.expr_info_table, ast_expr_id(call)),
    .Some(pc_oi) => {
      pc_out := new_expr_info(env, &pc_oi.ty());
      pc_out.set_value(pc_oi.value());
      expr_info_set_origin_type(&pc_out, expr_info_origin_type(&pc_oi));
      pc_out.set_is_accessing_property(pc_oi.is_accessing_property());
      pc_out.set_path_collection(pc_oi.path_collection());
      pc_out.set_variable_name(pc_oi.variable_name());
      pc_out.set_source_variable(pc_oi.source_variable());
      expr_info_table_set(&ctx.expr_info_table, ast_expr_id(deref), &pc_out);
    },
    .None => ()
  );
});
_evaluate_property_access_node :: (
  fn(
    expr : &AstExpr,
    env_in : &Environment,
    ctx : &mut EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  (env : Environment) = Rc.clone(env_in);
  // The receiver of an enclosing `.` place chain reports no access of its
  // own (local borrows, plans/VALUES_BY_DEFAULT.md decision 18).
  lb_is_receiver := local_borrow_take_receiver(expr);
  // A reference-field read in a receiver or reference-slot position is not a
  // whole-value read (N1e-2): taken here, before the object's own mark
  // replaces it.
  pa_deref_exempt := deref_exempt_take(expr);
  // Guard: must be a "." function call.
  if(!ast_expr_is_fn_call_of(expr, BF_DOT, .None), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected "." for property access, got:\n${ast_expr_to_string(expr)}`
        )
      )
    );
    return(expr.*);
  });
  // -------------------------------------------------------------------------
  // Short-circuit: Type.<KindName> — kind-constraint syntactic sugar.
  // -------------------------------------------------------------------------
  dot_args := match(expr, .FnCall(_, _, Rc(a), _, _) => a.clone(), .Atom(_, _) => ArrayList(AstExpr).new());
  if(dot_args.len() == usize(2), {
    obj_expr := match(dot_args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
    prop_expr := match(dot_args.get(usize(1)), .Some(a) => a, .None => make_err_expr());
    if(ast_expr_is_atom(&obj_expr) && (ast_expr_token(&obj_expr).value.* == "Type") && ast_expr_is_atom(&prop_expr), {
      kind_name := ast_expr_token(&prop_expr).value.*.clone();
      (is_kind : bool) = cond(
        (kind_name == "Struct") => true,
        (kind_name == "Enum") => true,
        (kind_name == "Union") => true,
        (kind_name == "Trait") => true,
        (kind_name == "Function") => true,
        true => false
      );
      if(is_kind, {
        // RAW so an inner error PROPAGATES — the non-raw wrapper
        // catches + prints + CONTINUES with a missing ExprInfo, and the
        // caller then proceeds on corrupted state (the SIGTRAP-in-malloc
        // crash class).
        evaluated := evaluate_expression_raw(&obj_expr, &env, ctx, exn);
        return(evaluated);
      });
    });
  });
  // -------------------------------------------------------------------------
  // 1-arg shorthand: `.Red` — infer enum type from context.
  // -------------------------------------------------------------------------
  if(ast_expr_is_fn_call_of(expr, BF_DOT, .Some(usize(1))), {
    all_args_1 := match(
      expr,
      .FnCall(_, _, Rc(args), _, _) => args.clone(),
      .Atom(_, _) => ArrayList(AstExpr).new()
    );
    prop_expr_1 := match(
      all_args_1.get(usize(0)),
      .Some(a) => a,
      .None => {
        return(expr.*);
      }
    );
    // Property must be an identifier atom.
    if(!ast_expr_is_atom(&prop_expr_1) || !is_valid_variable_name(&prop_expr_1), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(&prop_expr_1),
            `Expected identifier for enum variant access, got:\n${ast_expr_to_string(&prop_expr_1)}`
          )
        )
      );
      return(expr.*);
    });
    // Need an expected enum type from context.
    match(
      &ctx.expected_type,
      .None => {
        exn.throw(
          dyn(
            format_error_message_with_help(
              ast_expr_token(expr),
              String.from("Failed to infer enum variant type."),
              Option(String).Some(String.from("name the enum: `MyEnum.Variant(...)`, annotate the binding: `(x : MyEnum) = .Variant(...)`, or return the value directly"))
            )
          )
        );
        return(expr.*);
      },
      .Some(exp_ctx_1) => {
        if(!is_enum_type(&exp_ctx_1.ty), {
          exn.throw(
            dyn(
              format_error_message_with_help(
                ast_expr_token(expr),
                String.from("Failed to infer enum variant type."),
                Option(String).Some(String.from("name the enum: `MyEnum.Variant(...)`, annotate the binding: `(x : MyEnum) = .Variant(...)`, or return the value directly"))
              )
            )
          );
          return(expr.*);
        });
        variant_name_1 := ast_expr_text(&prop_expr_1).*.clone();
        match(
          // Resolve an in-definition Self shell (enum.yo) so the variant
          // lookup sees the finalized enum (`.Table(...)` shorthand where
          // the expected `T` came from an `ArrayList(Self)` instantiation,
          // std/encoding/toml.yo).
          resolve_enum_shell(&exp_ctx_1.ty),
          Rc(.EnumT(en_id_1, en_name_1, en_vnames_1, en_vfields_1, _, en_vflabels_1, en_discs_1, en_irs_1, en_iar_1, en_tas_1)) => {
            // Find the variant.
            fidx_1 := find_first_field_index(&en_vnames_1.items, variant_name_1.clone());
            match(
              fidx_1,
              .None => {
                exn.throw(
                  dyn(
                    format_error_message_with_help(
                      ast_expr_token(&prop_expr_1),
                      unknown_variant_message(variant_name_1.clone(), resolve_enum_shell(&exp_ctx_1.ty), &en_vnames_1.items),
                      match(
                        suggest_name(&variant_name_1, &en_vnames_1.items),
                        .Some(h) => Option(String).Some(`did you mean ".${h}"?`),
                        .None => Option(String).None
                      )
                    )
                  )
                );
                return(expr.*);
              },
              .Some(vi_1) => {
                _reject_gadt_unreachable_variant(&exp_ctx_1.ty, en_id_1.clone(), vi_1, variant_name_1.clone(), &prop_expr_1, exn);
                new_en_ty_1 := Rc.new(
                  TypeValueNode.EnumT(
                    en_id_1.clone(),
                    en_name_1.clone(),
                    Rc.clone(en_vnames_1),
                    Rc.clone(en_vfields_1),
                    Option(String).Some(variant_name_1.clone()),
                    Rc.clone(en_vflabels_1),
                    Rc.clone(en_discs_1),
                    en_irs_1,
                    en_iar_1,
                    Rc.clone(en_tas_1)
                  )
                );
                has_fields_1 := match(
                  en_vfields_1.get(vi_1),
                  .Some(vf) => (vf.len() > usize(0)),
                  .None => false
                );
                if(!has_fields_1, {
                  // Fieldless variant: Color.Red
                  _reject_origin_carrying_unit_variant(&new_en_ty_1, expr, ctx, exn);
                  dot_vname_1 := `.${ variant_name_1 }`;
                  ev_1 := EvalValue.EnumVal(dot_vname_1, no_values());
                  out_1 := new_expr_info(&env, &new_en_ty_1);
                  out_1.set_value(Option(EvalValue).Some(ev_1));
                  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_1);
                  _attach_owned_temp_for_rc_unit_variant(expr, &new_en_ty_1, ctx);
                  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&prop_expr_1), &out_1);
                }, {
                  // Variant with fields: Shape.Circle(3)
                  ev_tv_1 := create_type_value(&new_en_ty_1);
                  out_tv_1 := new_expr_info(&env, t_type());
                  out_tv_1.set_value(Option(EvalValue).Some(ev_tv_1));
                  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_tv_1);
                  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&prop_expr_1), &out_tv_1);
                });
                return(expr.*);
              }
            );
          },
          _ => {
            exn.throw(
              dyn(
                format_error_message_with_help(
                  ast_expr_token(expr),
                  String.from("Failed to infer enum variant type."),
                  Option(String).Some(String.from("name the enum: `MyEnum.Variant(...)`, annotate the binding: `(x : MyEnum) = .Variant(...)`, or return the value directly"))
                )
              )
            );
            return(expr.*);
          }
        );
      }
    );
    return(expr);
  });
  // -------------------------------------------------------------------------
  // 2-arg form: `.(object, property)`
  // -------------------------------------------------------------------------
  if(!ast_expr_is_fn_call_of(expr, BF_DOT, .Some(usize(2))), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected "." with 2 arguments, got:\n${ast_expr_to_string(expr)}`
        )
      )
    );
    return(expr.*);
  });
  all_args := match(
    expr,
    .FnCall(_, _, Rc(args), _, _) => args.clone(),
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  (object_expr : AstExpr) = match(
    all_args.get(usize(0)),
    .Some(a) => a,
    .None => make_err_expr()
  );
  property_expr := match(
    all_args.get(usize(1)),
    .Some(a) => a,
    .None => make_err_expr()
  );
  if(ast_expr_is_atom(&property_expr), {
    scope_release_note_query(ast_expr_id(&property_expr), ast_expr_token(&property_expr).value.*);
  });
  // Evaluate the object without passing the expected type (it applies to the
  // property result, not the object itself).
  old_expected_type := replace(&mut ctx.expected_type, Option(ExpectedTypeCtx).None);
  // RAW — see the comment at the `is_kind` early-return above.
  local_borrow_mark_receiver(&object_expr);
  deref_exempt_mark(&object_expr);
  // `--migrate deref` over `r.*.*`: the object `r.*` is told apart from an
  // old payload read below (`g_deref_chain_object_id`).
  if(deref_rule_recording() && ast_expr_is_atom_of(&property_expr, "*") && ast_expr_is_fn_call_of(&object_expr, BF_DOT, Option(usize).Some(usize(2))), {
    g_deref_chain_object_id = ast_expr_id(&object_expr);
  });
  object_expr = evaluate_expression_raw(&object_expr, &env, ctx, exn);
  deref_exempt_clear();
  local_borrow_clear_receiver();
  ctx.expected_type = old_expected_type;
  // The outermost node of a place chain reads the whole place: E0911 while a
  // `mut` borrow of an overlapping place is live (decision 18; siblings stay
  // free).
  if(!lb_is_receiver && local_borrows_active(), {
    local_borrow_access_expr(expr, LocalBorrowAccess.Read, ast_expr_token(&property_expr), &env, ctx, exn);
  });
  // Update env from the evaluated object's ExprInfo.
  obj_info_opt := expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&object_expr));
  match(
    &obj_info_opt,
    .Some(oi) => {
      env_adopt(&env, &oi.env());
    },
    .None => ()
  );
  // ── Safe mode (D7): the class-1 panic vocabulary ─────────────────────---
  // `o.unwrap` / `o.expect` / `o.unwrap_err` / `o.expect_err` on an Option/Result receiver in
  // a safe file is a compile error (plans/backlog/SAFE_MODE.md §3 0c).
  // Metadata-driven: the receiver's ExprInfo names the type, so nothing is
  // evaluated twice. Receivers with no info yet (fresh call results) fall
  // through to the dispatch-time gate in calls/function.yo; type-value
  // receivers (`Option(i32).unwrap`) are gated in the TypeVal arm below.
  if(ast_expr_is_atom(&property_expr) && is_class1_panic_method_name(ast_expr_token(&property_expr).value.*), {
    pa_c1_banned := match(&obj_info_opt, .Some(oi_c1) => is_class1_panic_receiver_type(&oi_c1.ty()), .None => false);
    if(pa_c1_banned && !is_class1_panic_exempt_file(Option(String).Some(ast_expr_token(&property_expr).module_path.*.clone())), {
      raise_flow_violation(
        format_error_message_with_help(
          ast_expr_token(&property_expr),
          `\`${ast_expr_token(&property_expr).value.*}\` on an Option/Result discards the failure case, and calling it would abort the program.`,
          Option(String).Some(String.from("handle the failure: match on .Some/.None (or .Ok/.Err), unwrap_or(...) a default, unwrap_or_else(...) compute one, or propagate the Option/Result. tests/*.test.yo and pragma(Pragma.AllowUnsafe) files are exempt (safe-mode rule D7)."))
        ),
        ctx,
        exn
      );
    });
  });
  if(ast_expr_is_atom(&property_expr) && ast_expr_is_atom_of(&property_expr, "*") && debug_knob(`YO_DEBUG_CTFE`).is_some(), {
    pa_deref_obj_ty := match(
      &obj_info_opt,
      .Some(pd_oi) => type_to_string(&pd_oi.ty()),
      .None => String.from("<no-info>")
    );
    eprintln(`[pa-deref-in] obj=${ast_expr_to_string(&object_expr)} obj_ty=${pa_deref_obj_ty}`);
  });
  // -------------------------------------------------------------------------
  // `.*` dereference
  // -------------------------------------------------------------------------
  if(ast_expr_is_atom(&property_expr) && ast_expr_is_atom_of(&property_expr, "*"), {
    obj_ty_deref := match(&obj_info_opt, .Some(oi) => Option(TypeValue).Some(Rc.clone(oi.ty())), .None => Option(TypeValue).None);
    // `b.*` on an owned Dyn local (decision 49, VERDICTS-40: `Box(Dyn(T))`
    // aliases the legacy Dyn while `unsized_legacy_spellings` holds): the
    // Dyn's payload place is the Dyn itself, an unsized place that is only
    // ever lent (`&b.*`, `&mut b.*`) or called through.
    match(
      &obj_info_opt,
      .Some(dd_oi) => match(
        dd_oi.source_variable(),
        .Some(dd_v) => if(ast_expr_is_atom(&object_expr) && is_dyn_type(&dd_oi.ty()) && !variable_is_reference_binding(&dd_v) && _is_written_star(&property_expr), {
          out_dd := new_expr_info(&env, &dd_oi.ty());
          out_dd.set_value(dd_oi.value());
          expr_info_set_origin_type(&out_dd, expr_info_origin_type(&dd_oi.*));
          out_dd.set_variable_name(dd_oi.variable_name());
          out_dd.set_source_variable(dd_oi.source_variable());
          out_dd.set_path_collection(dd_oi.path_collection());
          dd_atom := AstExpr.Atom(ast_expr_id(expr), ast_expr_token(&object_expr));
          note_rewritten_node(&dd_atom);
          note_dyn_place(ast_expr_id(expr));
          expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_dd);
          return(dd_atom);
        }),
        .None => ()
      ),
      .None => ()
    );
    // `r.*` on a reference binding `r` (decision 43 step 2 N1e-1,
    // VERDICTS-13 §11): in every spelled file it is the reference's deref
    // (std and the compiler tree too since N3 deref Generation A', which
    // keep the old reading only for a BARE `r`), the value a bare `r` read
    // before, lowered to the same C (the node is recorded rewritten to the
    // name, below). A `Box`/`Rc`/pointer/field-`*` deref through the
    // reference is `r.*.*`. `yo fix --migrate deref`, which reads old
    // source, records such a `.*` as `r.*.*` and evaluates it the old way.
    // CTFE binds a reference parameter as its pointee's compile-time value
    // (`is_ctfe_reference_param`): its `r.*` reads that value the same way.
    match(
      &obj_info_opt,
      .Some(rd_oi) => match(
        rd_oi.source_variable(),
        .Some(rd_v) => if(ast_expr_is_atom(&object_expr) && (variable_is_reference_binding(&rd_v) || is_ctfe_reference_param(&rd_v)) && deref_spelling_applies(ast_expr_token(&object_expr), ctx) && !is_reference_deref_site(ast_expr_token(&object_expr)) && _is_written_star(&property_expr), {
          // The recorder reads a `.*` through a `Box`, a handle or a pointer
          // the old way (the payload, recorded as `r.*.*`); any other `.*`
          // on a reference is already the new spelling (a file `--migrate
          // deref` ran on before), and reads as below.
          // In `r.*.*` (`expr` is the object of a written `.*`), the old
          // reading would read a payload's payload; when the payload is not
          // itself read through by `.*`, that is no old source, and the inner
          // `.*` is the reference's deref an earlier run wrote.
          rd_chain_new := (deref_rule_recording() && (ast_expr_id(expr) == g_deref_chain_object_id) && match(deref_payload_type(&rd_oi.ty()), .Some(rd_pt) => !deref_reads_through_pointee(&rd_pt), .None => false));
          if(ast_expr_id(expr) == g_deref_chain_object_id, {
            g_deref_chain_object_id = usize(0);
          });
          if(deref_rule_recording() && !rd_chain_new && deref_reads_through_pointee(&rd_oi.ty()), {
            record_deref_edit_site(ast_expr_token(&object_expr), &rd_v.name, u8(3));
          }, {
            // A `.*` no old source could write: the file is migrated already.
            if(deref_rule_recording(), {
              note_deref_migrated_file(ast_expr_token(&object_expr));
            });
            // The node reads as the name itself from here on: it is
            // recorded rewritten to the atom `r` under its own id
            // (`note_rewritten_node`), so codegen, the place walks and a
            // re-evaluation see exactly the bare read `r` was, with this
            // id's info an atom read's. The name keeps its exemption
            // (`note_reference_deref_site`).
            // The name keeps `r`'s spelling at the `*`'s position: a deref
            // site no source name occupies, so a later `.*` on it (`r.*.*`,
            // also in a clone of this body) is the payload's deref, not a
            // second reference deref.
            rd_name_tok := ast_expr_token(&object_expr);
            rd_star_tok := ast_expr_token(&property_expr);
            rd_tok := Token(
              kind : rd_name_tok.kind,
              value : Rc.clone(rd_name_tok.value),
              row : rd_star_tok.row,
              column : rd_star_tok.column,
              character : rd_star_tok.character,
              byte_offset : rd_star_tok.byte_offset,
              module_path : Rc.clone(rd_name_tok.module_path),
              input : Rc.clone(rd_name_tok.input)
            );
            note_reference_deref_site(&rd_tok);
            out_rd := new_expr_info(&env, &rd_oi.ty());
            out_rd.set_value(rd_oi.value());
            expr_info_set_origin_type(&out_rd, expr_info_origin_type(&rd_oi.*));
            out_rd.set_variable_name(rd_oi.variable_name());
            out_rd.set_source_variable(rd_oi.source_variable());
            out_rd.set_path_collection(rd_oi.path_collection());
            rd_atom := AstExpr.Atom(ast_expr_id(expr), rd_tok);
            note_rewritten_node(&rd_atom);
            expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_rd);
            // The caller keeps the node it is handed (an argument list, a
            // stored result): hand it the name.
            return(rd_atom);
          });
        }),
        .None => ()
      ),
      .None => ()
    );
    // `v.at.*` on a reference FIELD read (N1e-2): the place the field refers
    // to, which the bare read already names (`_reference_field_read_type`).
    // The node is recorded rewritten to that read under its own id, with the
    // label at the `*`'s position (a deref site), so it re-evaluates as a
    // plain read and `v.at.*.*` is the referent's own deref.
    // A read the rewrite already produced (its label sits at a `*`) is the
    // referent itself, and its `.*` is the referent's own.
    rf_mode := match(
      &object_expr,
      .FnCall(_, _, Rc(rfm_args), _, _) => match(rfm_args.get(usize(1)), .Some(rfm_l) => if(is_reference_deref_site(&ast_expr_token(&rfm_l)), Option(TypeValue).None, reference_field_read_type(ast_expr_id(&object_expr))), .None => Option(TypeValue).None),
      .Atom(_, _) => Option(TypeValue).None
    );
    rf_spelled := match(
      &rf_mode,
      .Some(Rc(.Reference(_, _, _))) => deref_spelling_applies(ast_expr_token(&property_expr), ctx),
      .Some(_) => deref_rule_applies(ast_expr_token(&property_expr), ctx),
      .None => false
    );
    if(rf_spelled && _is_written_star(&property_expr), {
      match(
        &object_expr,
        .FnCall(_, rf_f, Rc(rf_args), rf_infix, rf_tok) => {
          rf_obj := match(rf_args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
          rf_label := match(rf_args.get(usize(1)), .Some(a) => a, .None => make_err_expr());
          rf_label_tok := ast_expr_token(&rf_label);
          rf_star_tok := ast_expr_token(&property_expr);
          rf_new_tok := Token(
            kind : rf_label_tok.kind,
            value : Rc.clone(rf_label_tok.value),
            row : rf_star_tok.row,
            column : rf_star_tok.column,
            character : rf_star_tok.character,
            byte_offset : rf_star_tok.byte_offset,
            module_path : Rc.clone(rf_label_tok.module_path),
            input : Rc.clone(rf_label_tok.input)
          );
          note_reference_deref_site(&rf_new_tok);
          rf_new_args := ArrayList(AstExpr).new();
          rf_new_args.push(rf_obj);
          rf_new_args.push(AstExpr.Atom(ast_expr_id(&rf_label), rf_new_tok));
          rf_node := AstExpr.FnCall(ast_expr_id(expr), rf_f.clone(), Rc.new(rf_new_args), rf_infix.*, rf_tok.clone());
          note_rewritten_node(&rf_node);
          match(&rf_mode, .Some(rf_rt) => note_reference_field_read(ast_expr_id(expr), &rf_rt.*), .None => ());
          match(
            obj_info_opt,
            .Some(rf_oi) => {
              rf_out := new_expr_info(&env, &rf_oi.ty());
              rf_out.set_value(rf_oi.value());
              expr_info_set_origin_type(&rf_out, expr_info_origin_type(&rf_oi));
              rf_out.set_is_accessing_property(rf_oi.is_accessing_property());
              rf_out.set_path_collection(rf_oi.path_collection());
              rf_out.set_variable_name(rf_oi.variable_name());
              rf_out.set_source_variable(rf_oi.source_variable());
              expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &rf_out);
            },
            .None => ()
          );
          return(rf_node);
        },
        .Atom(_, _) => ()
      );
    });
    // `f(x).*` on a projection CALL (decision 24: the call's result is a
    // place of type `T`, which the bare call already names) is the
    // reference's deref: the place the call names. The `.*` node keeps the
    // referent's type and is recorded rewritten to the evaluated call
    // (`note_rewritten_node_as`), which keeps its own id and so every record
    // keyed by it (its dispatch, its specialization), so codegen and the
    // place walks read the bare call. In
    // `f(x).*.*` the outer `.*` is not a second deref of the call: it is the
    // referent's own, judged below.
    // Only where both readings agree, in every tree: a referent `.*` reads
    // through (a `Box`/`Rc`/`Arc` handle, a pointer, a field `*`) keeps the
    // old reading of `f(x).*`, its payload, which programs already rely on
    // and `yo fix --migrate deref` does not rewrite
    // (issues/fixed/2026-11-05-dereferencing-a-projection-call-result-is-an-internal-error.md).
    pc_object_written := match(all_args.get(usize(0)), .Some(pc_ow) => pc_ow, .None => make_err_expr());
    pc_object_is_deref := match(&pc_object_written, .FnCall(_, _, Rc(pc_ow_args), _, _) => (ast_expr_is_fn_call_of(&pc_object_written, BF_DOT, Option(usize).Some(usize(2))) && match(pc_ow_args.get(usize(1)), .Some(pc_ow_p) => ast_expr_is_atom_of(&pc_ow_p, "*"), .None => false)), .Atom(_, _) => false);
    if(!pc_object_is_deref && _is_written_star(&property_expr) && projection_call_mode_of(&object_expr, ctx).is_some() && match(&obj_ty_deref, .Some(pc_referent) => (deref_spelling_applies(ast_expr_token(&property_expr), ctx) && !deref_reads_through_pointee(&pc_referent.*)), .None => false), {
      _note_projection_call_deref(expr, &object_expr, &env, ctx);
      // The caller keeps the `.*` node: a read of the referent, a value, so
      // `n := f(x).*` binds a copy where `n := f(x)` binds the reference.
      return(expr.clone());
    });
    // `.*` on a place whose type IS a reference (plans/backlog/BORROW_CHECKER_COMPLETENESS.md
    // §7 P3): the referent of a `&&T`'s referent (`rr.*.*`, `v.*.*` on a
    // `&&T` closure parameter), of a `&mut &T`'s (`a.*.*`), of a reference
    // read out of a reference field. The object names the reference's own
    // storage (a binding's read, the reference deref the rewrite above
    // produced, a field read), so the place is its pointee, reached through
    // the pointer in C (`(*p)`). A call's result is excluded: its C is the
    // place it yields already.
    // R-PROBE's deref step on a reference-valued receiver synthesizes the
    // outer star of `r.*.*` (`_find_receiver_method_of`): a deref of a deref.
    rr_deref_of_deref := (ast_expr_is_fn_call_of(&object_expr, BF_DOT, Option(usize).Some(usize(2))) && match(&object_expr, .FnCall(_, _, Rc(dd_args), _, _) => match(dd_args.get(usize(1)), .Some(dd_p) => ast_expr_is_atom_of(&dd_p, "*"), .None => false), .Atom(_, _) => false));
    if((_is_written_star(&property_expr) || rr_deref_of_deref) && (ast_expr_is_atom(&object_expr) || ast_expr_is_fn_call_of(&object_expr, BF_DOT, Option(usize).Some(usize(2)))), {
      match(
        &obj_ty_deref,
        .Some(Rc(.Reference(rr_pointee, _, _))) => {
          rr_pt := Rc.clone(rr_pointee);
          rr_out := new_expr_info(&env, &rr_pt);
          expr_info_set_origin_type(&rr_out, obj_ty_deref.clone());
          rr_out.set_is_accessing_property(Option(bool).Some(true));
          match(
            &obj_info_opt,
            .Some(rr_oi) => {
              rr_out.set_source_variable(rr_oi.source_variable());
              rr_out.set_path_collection(rr_oi.path_collection());
            },
            .None => ()
          );
          expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &rr_out);
          expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &rr_out);
          return(expr.*);
        },
        _ => ()
      );
    });
    match(
      &obj_ty_deref,
      .Some(ot) => {
        // `h.*` on a cell handle (`cell_handle_view`, V5's `Rc`/`Arc`) names
        // its payload: the handle is a newtype over its cell, so this is the
        // cell's `*` field, read through the handle's C value, the cell
        // pointer. It is safe, and a run-time place as the old `Rc`'s `*`
        // field is (a write there is E0919, `reject_write_through_rc`).
        match(
          cell_handle_view(&ot.*),
          .Some(hv) => {
            (hv_payload : TypeValue) = cond(
              is_some_type(&hv.payload) => get_value_of_some_type_from_env(&env, &hv.payload),
              true => Rc.clone(hv.payload)
            );
            hv_origin := match(
              match(&obj_info_opt, .Some(oi) => expr_info_origin_type(&oi.*), .None => Option(TypeValue).None),
              .Some(o) => o,
              .None => Rc.clone(ot)
            );
            hv_pc := match(
              &obj_info_opt,
              .Some(oi) => build_field_path_collection(&oi.path_collection(), &oi.variable_name(), &String.from("*")),
              .None => build_field_path_collection(&ArrayList(ArrayList(String)).new(), &Option(String).None, &String.from("*"))
            );
            out_hv := new_expr_info(&env, &hv_payload);
            expr_info_set_origin_type(&out_hv, Option(TypeValue).Some(hv_origin));
            out_hv.set_is_accessing_property(Option(bool).Some(true));
            out_hv.set_path_collection(hv_pc);
            // A compile-time handle is the handle's struct value over the
            // cell's: the payload is the cell's field.
            out_hv.set_value(
              match(
                match(obj_info_opt, .Some(oi) => oi.value(), .None => Option(EvalValue).None),
                .Some(.UnknownVal(_, hv_ro)) => Option(EvalValue).Some(if(hv_ro, create_runtime_unknown_val(&hv_payload), create_unknown_val(&hv_payload))),
                .Some(.StructVal(_, _, hv_wf)) => match(
                  hv_wf.get(usize(0)),
                  .Some(.StructVal(_, _, hv_cf)) => match(hv_cf.get(usize(0)), .Some(hv_v) => Option(EvalValue).Some(hv_v), .None => Option(EvalValue).Some(create_unknown_val(&hv_payload))),
                  _ => Option(EvalValue).Some(create_unknown_val(&hv_payload))
                ),
                .Some(_) => Option(EvalValue).Some(create_unknown_val(&hv_payload)),
                .None => Option(EvalValue).None
              )
            );
            expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_hv);
            expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_hv);
            attach_temp_variable_to_expr(expr, false, ctx);
            return(expr.*);
          },
          .None => ()
        );
        // `b.*` on the unique `Box` (V1 step 2) names its payload place: the
        // box is a newtype over its cell pointer, so this is that pointer's
        // dereference. It is safe: the box owns a live cell.
        deref_box_payload := unique_box_payload_type(&ot.*);
        if(is_pointer_type(&ot.*) || deref_box_payload.is_some(), {
          // Memory-safety gate: pointer dereference requires `unsafe(...)`.
          // Files under std/ and src/ are implicitly unsafe-capable.
          if(deref_box_payload.is_none() && !ctx.unsafe_context && !is_implicitly_unsafe_capable_file(Option(String).Some(ast_expr_token(&property_expr).module_path.*.clone())), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(&property_expr),
                  `Pointer dereference requires 'unsafe(...)'.

Wrap as: unsafe(${ast_expr_to_string(&object_expr)}.*)

Raw pointer operations may dereference invalid memory.`
                )
              )
            );
          });
          base_ty_deref := match(deref_box_payload, .Some(bp) => Rc.clone(bp), .None => match(ot, Rc(.Pointer(pt)) => Rc.clone(pt), _ => t_unit()));
          // Resolve SomeType from env if needed.
          (resolved_base : TypeValue) = cond(
            is_some_type(&base_ty_deref) => get_value_of_some_type_from_env(&env, &base_ty_deref),
            true => base_ty_deref
          );
          obj_val_deref := match(&obj_info_opt, .Some(oi) => oi.value(), .None => Option(EvalValue).None);
          match(
            obj_val_deref,
            .Some(ov_deref) => {
              match(
                ov_deref,
                .PtrVal(target_cell, ptr_tgt_idx, _) => {
                  // Compile-time pointer: dereference to the pointed-to value.
                  // Index the target when it is an aggregate —
                  // `dereferencedValue = target.elements[objectValue.targetIndex]`
                  // — and record
                  // the target/index so a later `p.* = v` has a
                  // place to write (consumed by assignment.yo's Step 6
                  // comptimeRef block).
                  // `ComptimeRef.ArrayRef(list, index)` IS that pair
                  // (assignment.yo's Step 6 writes `list(index) = rhs`), so:
                  //   * aggregate pointee — place = (elements, index);
                  //   * SCALAR pointee (arm 22) — place = (the CELL itself,
                  //     target_index): writing `p.* = v` stores into the same
                  //     single-element list the source variable reads.
                  target0 := match(
                    target_cell.get(usize(0)),
                    .Some(t0) => t0,
                    .None => EvalValue.UnitVal
                  );
                  (deref_val : EvalValue) = target0;
                  (deref_place : Option(ComptimeRef)) = Option(ComptimeRef).None;
                  match(
                    target0,
                    .ArrayVal(deref_elems) => {
                      deref_val = match(deref_elems.get(ptr_tgt_idx), .Some(de) => de, .None => target0);
                      deref_place = Option(ComptimeRef).Some(ComptimeRef.ArrayRef(Rc.clone(deref_elems), ptr_tgt_idx));
                    },
                    _ => {
                      deref_val = match(target_cell.get(ptr_tgt_idx), .Some(dt) => dt, .None => target0);
                      deref_place = Option(ComptimeRef).Some(ComptimeRef.ArrayRef(Rc.clone(target_cell), ptr_tgt_idx));
                    }
                  );
                  out_ptr := new_expr_info(&env, &resolved_base);
                  out_ptr.set_value(Option(EvalValue).Some(deref_val));
                  expr_info_set_comptime_ref(&out_ptr, &deref_place);
                  expr_info_set_origin_type(&out_ptr, Option(TypeValue).Some(Rc.clone(ot)));
                  out_ptr.set_is_accessing_property(Option(bool).Some(true));
                  out_ptr.set_source_variable(
                    match(
                      obj_info_opt,
                      .Some(oi) => oi.source_variable(),
                      .None => Option(Variable).None
                    )
                  );
                  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_ptr);
                  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_ptr);
                  return(expr.*);
                },
                .UnknownVal(_, ptr_ro) => {
                  // CHECKING PHASE ONLY: keep the comptime Unknown placeholder.
                  // In execution mode a call-chain result carries `UnknownVal`
                  // (the runtime-result convention) and takes the RUNTIME deref
                  // branch below, which attaches a borrowed
                  // temp so `.Some((_ptr &+ index).*)`-style uses get a ___dup
                  // (missing dup freed every ArrayList(ref-struct) element on
                  // get(); see issues/fixed/yo-self-stage2-parser-divergence.md).
                  if(ctx.is_in_function_call_checking_phase, {
                    // A RUNTIME-ONLY pointer (a call's result bound to a
                    // parameter) points at runtime memory, so its pointee is
                    // runtime-only too; an unmarked placeholder let `!` pick
                    // `comptime_not` and reject the operand with a false E1101
                    // (issues/fixed/2026-10-16-not-on-a-runtime-bool-in-a-comptime-type-parameterized-fn-is-e1101.md).
                    deref_unk := if(ptr_ro, create_runtime_unknown_val(&resolved_base), create_unknown_val(&resolved_base));
                    out_unk := new_expr_info(&env, &resolved_base);
                    out_unk.set_value(Option(EvalValue).Some(deref_unk));
                    expr_info_set_origin_type(&out_unk, Option(TypeValue).Some(Rc.clone(ot)));
                    out_unk.set_is_accessing_property(Option(bool).Some(true));
                    expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_unk);
                    expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_unk);
                    return(expr.*);
                  });
                },
                _ => ()
              );
            },
            .None => ()
          );
          // No compile-time pointer value — runtime dereference.
          out_rt := new_expr_info(&env, &resolved_base);
          expr_info_set_origin_type(&out_rt, Option(TypeValue).Some(Rc.clone(ot)));
          out_rt.set_is_accessing_property(Option(bool).Some(true));
          expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_rt);
          expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_rt);
          attach_temp_variable_to_expr(expr, false, ctx);
          return(expr.*);
        });
      },
      .None => ()
    );
    // `v.*` where `v` is a BORROW (a `&T`/`&mut T` parameter or a local
    // borrow `y := &x`): a borrow is a mode on the binding, not a type, and
    // it reads as its value — `.*` on a borrow arrives with decision 43.
    // Without this check the expression fell through to the property lookup,
    // which left it with no ExprInfo (a scalar pointee), so the failure
    // surfaced as the evaluator internal
    // "check_if_function_parameter_matches_argument: arg has no ExprInfo" far
    // from the `.*`, or as E0406 "No field `*` on S" for a struct pointee
    // (issues/fixed/2026-10-17-a-dereference-of-a-borrow-parameter-in-a-closure-reports-an-internal-error.md).
    // A type that DECLARES a field named `*` keeps the field read: that is
    // the atomic idiom (`AtomicBool :: atomic(ref(struct((*) : atomic_bool)))`
    // read as `self.*` on `self : &Self` in std/sync/atomic.yo).
    if(ast_expr_is_atom(&object_expr), {
      match(
        get_variables_from_env(&env, ast_expr_token(&object_expr).value.*.clone()).last_cloned(),
        .Some(deref_b_v) => if((deref_b_v.is_ref() || deref_b_v.is_imm_borrow()) &&
          !match(
            obj_ty_deref,
            .Some(deref_b_ot) => find_first_field_index(&_field_labels_of(&deref_b_ot).items, String.from("*")).is_some(),
            .None => false
          ), {
          deref_b_name := ast_expr_token(&object_expr).value.*.clone();
          deref_b_mode := cond(deref_b_v.is_ref() => "&mut", true => "&");
          exn.throw(
            dyn(
              with_code(
                format_error_message_with_help(
                  ast_expr_token(expr),
                  `\`${deref_b_name}\` is a \`${deref_b_mode}\` borrow: a borrow reads as its value, and \`.*\` does not apply to a borrow until decision 43 (references become types).`,
                  Option(String).Some(`read the value directly — \`${deref_b_name}\` already is the value (\`${deref_b_name}.field\` for a field, \`${deref_b_name}(i)\` for an element); \`.*\` is for raw pointers (\`unsafe(p.*)\`), \`Deref\` wrappers (\`b.*\`) and a type's own \`*\` field (std's atomics)`)
                ),
                E_DEREF_OF_BORROW
              )
            )
          );
        }),
        .None => ()
      );
    });
    // `x.*` on a plain value (decision 43; VERDICTS-41 Q1): every legal `.*`
    // has returned or thrown above (a reference binding, a CTFE reference
    // parameter, a projection call, a reference-typed place, the E0920 branch),
    // so an operand whose type is no reference, raw pointer, `Deref` handle or
    // type with a field `*` has nothing to read through. Before this arm it
    // fell through to the field lookup and left no ExprInfo (an internal
    // "arg has no ExprInfo", or "Failed to evaluate, got (x.(*))").
    match(
      &obj_info_opt,
      .Some(dv_oi) => if(_is_written_star(&property_expr) && !is_type_value(&dv_oi.value()) && !is_module_type(&dv_oi.ty()) && (get_all_some_types(&dv_oi.ty()).len() == usize(0)) && !_type_is_dereferenceable(&dv_oi.ty(), &env), {
        dv_ty_text := type_to_string(&dv_oi.ty());
        dv_subject := cond(
          ast_expr_is_atom(&object_expr) => `\`${ast_expr_to_string(&object_expr)}\` has type \`${dv_ty_text}\``,
          true => `this expression has type \`${dv_ty_text}\``
        );
        dv_help := cond(
          ast_expr_is_atom(&object_expr) => `read \`${ast_expr_to_string(&object_expr)}\` itself; to bind a reference to it write \`r := &${ast_expr_to_string(&object_expr)}\` and read \`r.*\``,
          true => String.from("read the value itself; to bind a reference to a place write `r := &place` and read `r.*`")
        );
        exn.throw(
          dyn(
            with_code(
              format_error_message_with_help(
                ast_expr_token(expr),
                `${dv_subject}, a value: \`.*\` reads through a reference (\`&T\`, \`&mut T\`), a raw pointer (\`*T\`) or a \`Deref\` type (\`Box\`, \`Rc\`, \`Arc\`), and \`${dv_ty_text}\` is none of them.`,
                Option(String).Some(dv_help)
              ),
              E_DEREF_OF_VALUE
            )
          )
        );
      }),
      .None => ()
    );
    // Not a pointer — fall through to normal property lookup below.
  });
  // -------------------------------------------------------------------------
  // TypeVal cases: `EnumType.Variant`, `StructType.field`, etc.
  // -------------------------------------------------------------------------
  obj_val_opt := match(&obj_info_opt, .Some(oi) => oi.value(), .None => Option(EvalValue).None);
  if(is_type_value(&obj_val_opt), {
    type_val_inner := match(
      obj_val_opt,
      .Some(.TypeVal(ty_box)) => Rc.clone(ty_box),
      .Some(_) => t_unit(),
      .None => t_unit()
    );
    // --- TypeVal + primitive (Int/Float/Usize/Isize/Bool/C-types) --------
    // `impl(usize, MAX : ...)`, `impl(i32, MIN : ...)`, etc. register
    // their fields in the trait-method registry keyed by the synthetic
    // primitive ids (see `type_id_or_empty`). Look them up here so
    // expressions like `usize.MAX` resolve to the registered value.
    // None of the specific `is_*_type` branches below match primitives,
    // so without this path the lookup falls through to the runtime
    // method-dispatch slow path and the comptime value is lost.
    if(ast_expr_is_atom(&property_expr) &&
      !is_enum_type(&type_val_inner) &&
        !is_struct_type(&type_val_inner) &&
          !is_union_type(&type_val_inner) &&
            !is_module_type(&type_val_inner) &&
              !is_some_type(&type_val_inner), {
      prim_type_id := type_id_or_empty(&type_val_inner);
      if(prim_type_id != "", {
        prim_prop_name := ast_expr_text(&property_expr).*.clone();
        _reject_private_static_member(prim_type_id.clone(), prim_prop_name.clone(), &type_val_inner, &property_expr, exn);
        prim_methods := get_type_trait_methods_by_name(&prim_type_id, &prim_prop_name);
        if(prim_methods.len() > usize(0), {
          (pm_idx : usize) = usize(0);
          (pm_done : bool) = false;
          while((pm_idx < prim_methods.len()) && !pm_done, {
            match(
              prim_methods.get(pm_idx),
              .Some(pm) => match(
                pm.value,
                .Some(pmv) => {
                  out_prim := new_expr_info(&env, &pm.ty);
                  out_prim.set_value(Option(EvalValue).Some(pmv));
                  out_prim.set_is_accessing_property(Option(bool).Some(true));
                  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_prim);
                  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_prim);
                  pm_done = true;
                },
                .None => ()
              ),
              .None => ()
            );
            pm_idx = (pm_idx + usize(1));
          });
          if(pm_done, {
            return(expr.*);
          });
        });
      });
      // Generic-impl fallback for non-struct TYPE receivers (Array/Slice/
      // primitives whose impls are generic) — `Array(u8, 2).fill` resolves
      // through the inherent generic impl `impl(generic(T, U), Array(T, U),
      // fill : ...)`, which lives in the generic-impl registry, not the
      // id-keyed trait-methods registry (Array types have no id). Same
      // `findMethodsFromGenericImpls` lookup as the struct branch
      //; single candidate only — multiple
      // candidates defer to function.yo's arg-type disambiguation.
      pr_prop_name := ast_expr_text(&property_expr).*.clone();
      // Safe mode (D7): the generic-impl fallback below RESOLVES and RETURNS
      // for `Option(i32).unwrap`-shaped extractions (Option/Result methods
      // live in the generic-impl registry), never reaching the EnumT arm's
      // gate — so the extraction ban is checked here as well.
      if(ast_expr_is_atom(&property_expr) &&
        is_class1_panic_method_name(pr_prop_name.clone()) &&
          is_class1_panic_receiver_type(&type_val_inner) &&
            !is_class1_panic_exempt_file(Option(String).Some(ast_expr_token(&property_expr).module_path.*.clone())), {
        raise_flow_violation(
          format_error_message_with_help(
            ast_expr_token(&property_expr),
            `\`${pr_prop_name}\` on an Option/Result discards the failure case, and calling it would abort the program.`,
            Option(String).Some(String.from("handle the failure: match on .Some/.None (or .Ok/.Err), unwrap_or(...) a default, unwrap_or_else(...) compute one, or propagate the Option/Result. tests/*.test.yo and pragma(Pragma.AllowUnsafe) files are exempt (safe-mode rule D7)."))
          ),
          ctx,
          exn
        );
      });
      generic_methods_pr := find_methods_from_generic_impls(&type_val_inner, &pr_prop_name, &env);
      if(generic_methods_pr.len() == usize(1), {
        method_pr := match(
          generic_methods_pr.get_cloned(usize(0)),
          .Some(m) => m,
          .None => {
            return(expr.*);
          }
        );
        out_gm_pr := new_expr_info(&env, &method_pr.method_type);
        out_gm_pr.set_value(method_pr.method_value);
        out_gm_pr.set_is_accessing_property(Option(bool).Some(true));
        expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_gm_pr);
        expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_gm_pr);
        return(expr.*);
      });
    });
    // --- TypeVal + working-trait associated-type fallback ------------------
    // While an `impl(...)` trait constructor's fields are being evaluated,
    // `Self.X` must resolve to fields already bound in the SAME trait entry
    // (e.g. `Output : T` before `index : fn(...) -> *(Self.Output)`).
    // TypeValues have
    // value semantics (no trait slot to attach a progressively-updated
    // working trait to), so the in-flight bindings live on
    // the context (`current_impl_trait_field_*`). Scoped to literal `Self`
    // receivers — the only spelling these in-impl references use — so
    // unrelated TypeVal property accesses are untouched.
    if(ast_expr_is_atom(&property_expr) && ast_expr_is_atom(&object_expr) &&
      (ast_expr_token(&object_expr).value.* == "Self"), {
      wt_prop := ast_expr_text(&property_expr).*.clone();
      n_wt := ctx.current_impl_trait_field_labels.len();
      (wt_i : usize) = usize(0);
      while(wt_i < n_wt, {
        wt_lbl := match(ctx.current_impl_trait_field_labels.get_cloned(wt_i), .Some(l) => l, .None => String.from(""));
        if(wt_lbl == wt_prop, {
          match(
            ctx.current_impl_trait_field_types.get_cloned(wt_i),
            .Some(wt_ty) => {
              // Entries are associated TYPES (`Output : u8`); the info's
              // own type is the plain meta type — walking the type graph
              // (type_of_eval_value) crashes on CYCLIC recursive types
              // like JsonValue.
              out_wt := new_expr_info(&env, t_type());
              out_wt.set_value(Option(EvalValue).Some(create_type_value(&wt_ty)));
              out_wt.set_is_accessing_property(Option(bool).Some(true));
              expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_wt);
              expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_wt);
              return(expr.*);
            },
            .None => ()
          );
        });
        wt_i = (wt_i + usize(1));
      });
    });
    // --- TypeVal + EnumT --------------------------------------------------
    if(is_enum_type(&type_val_inner), {
      // Safe mode (D7): `Option(i32).unwrap` as an EXTRACTION — the same ban
      // as the value-receiver gate near the top of this function, with the
      // receiver type taken from the TypeVal itself.
      if(ast_expr_is_atom(&property_expr) &&
        is_class1_panic_method_name(ast_expr_token(&property_expr).value.*) &&
          is_class1_panic_receiver_type(&type_val_inner) &&
            !is_class1_panic_exempt_file(Option(String).Some(ast_expr_token(&property_expr).module_path.*.clone())), {
        raise_flow_violation(
          format_error_message_with_help(
            ast_expr_token(&property_expr),
            `\`${ast_expr_token(&property_expr).value.*}\` on an Option/Result discards the failure case, and calling it would abort the program.`,
            Option(String).Some(String.from("handle the failure: match on .Some/.None (or .Ok/.Err), unwrap_or(...) a default, unwrap_or_else(...) compute one, or propagate the Option/Result. tests/*.test.yo and pragma(Pragma.AllowUnsafe) files are exempt (safe-mode rule D7)."))
          ),
          ctx,
          exn
        );
      });
      if(!ast_expr_is_atom(&property_expr), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(&property_expr),
              `Expected identifier for enum variant, got:\n${ast_expr_to_string(&property_expr)}`
            )
          )
        );
        return(expr.*);
      });
      variant_name_tv := ast_expr_text(&property_expr).*.clone();
      match(
        // Same Self-shell resolution as the shorthand path above.
        resolve_enum_shell(&type_val_inner),
        Rc(.EnumT(tv_en_id, tv_en_name, tv_en_vnames, tv_en_vfields, _, tv_en_vflabels, tv_en_discs, tv_en_irs, tv_en_iar, tv_en_tas)) => {
          fidx_tv_en := find_first_field_index(&tv_en_vnames.items, variant_name_tv.clone());
          match(
            fidx_tv_en,
            .None => {
              // Not an enum variant — try resolving as an associated type
              // (e.g. `Self.Output` from `impl(JsonValue, Index(String)(
              // Output : JsonValue, …))`). Only throw if that also fails.
              if(_try_resolve_associated_type(&type_val_inner, &variant_name_tv, expr, &property_expr, &env, ctx), {
                return(expr.*);
              });
              // Still unresolved — consult the GENERIC-impl registry before
              // erroring. `Option(i32).unwrap` comes from
              // `impl(generic(T : Type), Option(T), unwrap : …)`, which lives in
              // the generic-impl registry, NOT the id-keyed trait-methods
              // registry that `_try_resolve_associated_type` consults — so a
              // METHOD call on a comptime Option/Result fell through to
              // enum-VARIANT resolution and threw `Enum variant "unwrap" not
              // found in enum`. Same `findMethodsFromGenericImpls` guard the
              // struct/union
              // branch already has below. Resolve only a SINGLE candidate —
              // multiple are left unresolved so function.yo can disambiguate by
              // argument types.
              generic_methods_en := find_methods_from_generic_impls(&type_val_inner, variant_name_tv.clone(), &env);
              if(generic_methods_en.len() == usize(1), {
                method_en := match(
                  generic_methods_en.get_cloned(usize(0)),
                  .Some(m) => m,
                  .None => {
                    return(expr.*);
                  }
                );
                out_gm_en := new_expr_info(&env, &method_en.method_type);
                out_gm_en.set_value(method_en.method_value);
                out_gm_en.set_is_accessing_property(Option(bool).Some(true));
                expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_gm_en);
                expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_gm_en);
                return(expr.*);
              });
              if(generic_methods_en.len() > usize(1), {
                return(expr.*);
              });
              exn.throw(
                dyn(
                  format_error_message_with_help(
                    ast_expr_token(&property_expr),
                    unknown_variant_message(variant_name_tv.clone(), &type_val_inner, &tv_en_vnames.items),
                    match(
                      suggest_name(&variant_name_tv, &tv_en_vnames.items),
                      .Some(h) => Option(String).Some(`did you mean ".${h}"?`),
                      .None => Option(String).None
                    )
                  )
                )
              );
              return(expr.*);
            },
            .Some(tv_vi) => {
              _reject_gadt_unreachable_variant(&type_val_inner, tv_en_id.clone(), tv_vi, variant_name_tv.clone(), &property_expr, exn);
              new_en_tv := Rc.new(
                TypeValueNode.EnumT(
                  tv_en_id.clone(),
                  tv_en_name.clone(),
                  Rc.clone(tv_en_vnames),
                  Rc.clone(tv_en_vfields),
                  Option(String).Some(variant_name_tv.clone()),
                  Rc.clone(tv_en_vflabels),
                  Rc.clone(tv_en_discs),
                  tv_en_irs,
                  tv_en_iar,
                  Rc.clone(tv_en_tas)
                )
              );
              has_fields_tv := match(
                tv_en_vfields.get(tv_vi),
                .Some(vf) => (vf.len() > usize(0)),
                .None => false
              );
              if(!has_fields_tv, {
                _reject_origin_carrying_unit_variant(&new_en_tv, expr, ctx, exn);
                dot_tv_vname := `.${ variant_name_tv }`;
                ev_tv_en := EvalValue.EnumVal(dot_tv_vname, no_values());
                out_tv_en := new_expr_info(&env, &new_en_tv);
                out_tv_en.set_value(Option(EvalValue).Some(ev_tv_en));
                out_tv_en.set_is_accessing_property(Option(bool).Some(true));
                expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_tv_en);
                _attach_owned_temp_for_rc_unit_variant(expr, &new_en_tv, ctx);
                expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_tv_en);
              }, {
                tv_en_type_val := create_type_value(&new_en_tv);
                out_tv_en2 := new_expr_info(&env, t_type());
                out_tv_en2.set_value(Option(EvalValue).Some(tv_en_type_val));
                out_tv_en2.set_is_accessing_property(Option(bool).Some(true));
                expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_tv_en2);
                expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_tv_en2);
              });
              return(expr.*);
            }
          );
        },
        _ => {
          return(expr.*);
        }
      );
    });
    // --- TypeVal + Struct or Union ---
    if(is_struct_type(&type_val_inner) || is_union_type(&type_val_inner), {
      if(!is_valid_variable_name(&property_expr), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(&property_expr),
              `Expected identifier for type method, got:\n${ast_expr_to_string(&property_expr)}`
            )
          )
        );
        return(expr.*);
      });
      prop_name_su := ast_expr_text(&property_expr).*.clone();
      // A member of a type holding a reference beyond N2b (a container or a
      // cell: `RefCell(&i32).new`, `ArrayList(&i32).new` — decision 43 step
      // 3) would run or build a value of it; stop at the user's member
      // access, before a std body specialized for it. A member of an INLINE
      // composite is N2b's and passes (a variant constructor, a user
      // static).
      if(origin_beyond_n2b(&type_val_inner) && !is_std_module_path(&ast_expr_token(expr).module_path.*, ctx.std_path.clone()), {
        exn.throw(dyn(format_error_message(ast_expr_token(&property_expr), origin_beyond_n2b_message(&type_val_inner))));
      });
      su_labels := match(
        &type_val_inner,
        Rc(.Struct({ field_labels : labels })) => Rc.clone(labels),
        Rc(.Union(_, labels, _)) => Rc.clone(labels),
        _ => no_labels()
      );
      su_types := match(
        &type_val_inner,
        Rc(.Struct({ field_types : types })) => Rc.clone(types),
        Rc(.Union(_, _, types)) => Rc.clone(types),
        _ => no_types()
      );
      // Search field_labels.
      fidx_su := find_last_field_index(&su_labels.items, prop_name_su.clone());
      match(
        fidx_su,
        .Some(fi_su) => {
          ft_su := match(su_types.get(fi_su), .Some(t) => t, .None => t_unit());
          out_su := new_expr_info(&env, &ft_su);
          out_su.set_value(Option(EvalValue).Some(create_unknown_val(&ft_su)));
          out_su.set_is_accessing_property(Option(bool).Some(true));
          expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_su);
          expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_su);
          return(expr.*);
        },
        .None => ()
      );
      // Check generic impl registry for methods on generic receiver types
      // (`findMethodsFromGenericImpls`).
      // Only resolve when exactly 1 candidate — multiple candidates are deferred to
      // function.yo which can disambiguate by argument types.
      generic_methods_su := find_methods_from_generic_impls(&type_val_inner, &prop_name_su, &env);
      if(generic_methods_su.len() == usize(1), {
        method_su := match(
          generic_methods_su.get_cloned(usize(0)),
          .Some(m) => m,
          .None => {
            return(expr.*);
          }
        );
        out_gm_su := new_expr_info(&env, &method_su.method_type);
        out_gm_su.set_value(method_su.method_value);
        out_gm_su.set_is_accessing_property(Option(bool).Some(true));
        expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_gm_su);
        expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_gm_su);
        return(expr.*);
      });
      // During generic impl specialization, the associated type may be in env.
      if(ctx.is_evaluating_generic_impl_specialization, {
        spec_vars := get_variables_from_env(&env, &prop_name_su);
        n_spec := spec_vars.len();
        if(n_spec > usize(0), {
          match(
            spec_vars.get_cloned(n_spec - usize(1)),
            .Some(last_spec) => {
              if(is_type_value(last_spec.value().get(usize(0))), {
                match(
                  last_spec.value().get(usize(0)),
                  .Some(spec_tv) => {
                    spec_tv_ty := type_of_eval_value(&spec_tv);
                    out_spec_su := new_expr_info(&env, &spec_tv_ty);
                    out_spec_su.set_value(Option(EvalValue).Some(spec_tv));
                    out_spec_su.set_is_accessing_property(Option(bool).Some(true));
                    expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_spec_su);
                    expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_spec_su);
                    return(expr.*);
                  },
                  .None => ()
                );
              });
            },
            .None => ()
          );
        });
      });
      // Look up in the type-trait-methods registry — covers
      // impl-provided associated types (e.g. `Counter.Item` where an
      // earlier `impl(Counter, Iter(Item : i32, ...))` registered
      // "Item" with value `TypeVal(i32)`). Only entries with
      // assigned values are eligible — the
      // function dispatch path handles method overload resolution.
      su_type_id := type_id_or_empty(&type_val_inner);
      if(su_type_id != "", {
        _reject_private_static_member(su_type_id.clone(), prop_name_su.clone(), &type_val_inner, &property_expr, exn);
        registry_methods := get_assoc_type_entries(&type_val_inner, prop_name_su.clone());
        // OVERLOAD DEFER — the struct-arm twin of
        // _try_resolve_associated_type's rule (:216-231): when the type
        // carries MULTIPLE fn-typed overloads of this member (HeteroEqW's
        // `==` from Eq(HeteroEqW) AND Eq(str)), committing to the first
        // valued entry stamps the WRONG overload; the enclosing call then
        // takes the FuncVal path, unifies `str` against the Self-overload's
        // param, throws, and the whole spec body FTTs (impl.test.yo
        // heterogeneous `!=`, root-cause map layer 8). Leave the member
        // UNRESOLVED so function.yo's dispatch runs
        // _try_find_receiver_method + _select_matching_overload.
        (su_fn_overloads : usize) = usize(0);
        {
          (su_oi : usize) = usize(0);
          while(su_oi < registry_methods.len(), {
            match(
              registry_methods.get(su_oi),
              .Some(su_om) => if(is_function_type(&su_om.ty), {
                su_fn_overloads = (su_fn_overloads + usize(1));
              }),
              .None => ()
            );
            su_oi = (su_oi + usize(1));
          });
        };
        if(su_fn_overloads > usize(1), {
          return(expr.*);
        });
        if(registry_methods.len() > usize(0), {
          (rm_idx : usize) = usize(0);
          (rm_done : bool) = false;
          while((rm_idx < registry_methods.len()) && !rm_done, {
            match(
              registry_methods.get(rm_idx),
              .Some(rm) => {
                match(
                  rm.value,
                  .Some(rmv) => {
                    rm_v_ty := type_of_eval_value(&rmv);
                    out_rm := new_expr_info(&env, &rm.ty);
                    out_rm.set_value(Option(EvalValue).Some(rmv));
                    out_rm.set_is_accessing_property(Option(bool).Some(true));
                    expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_rm);
                    expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_rm);
                    rm_done = true;
                    // rm_v_ty is computed but not used; the field's
                    // declared ty (rm.ty) is what we report so
                    // downstream type-equality checks match the
                    // trait's field-type slot.
                    _unused := rm_v_ty;
                  },
                  .None => ()
                );
              },
              .None => ()
            );
            rm_idx = (rm_idx + usize(1));
          });
          if(rm_done, {
            return(expr.*);
          });
        });
      });
      // Not found — let function.yo handle it as a method call.
      return(expr.*);
    });
    // --- TypeVal + ModuleT ------------------------------------------------
    if(is_module_type(&type_val_inner), {
      if(!is_valid_variable_name(&property_expr), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(&property_expr),
              `Expected identifier for type method, got:\n${ast_expr_to_string(&property_expr)}`
            )
          )
        );
        return(expr.*);
      });
      prop_name_mt := ast_expr_text(&property_expr).*.clone();
      mt_labels := match(
        &type_val_inner,
        Rc(.Struct({ field_labels : labels })) => Rc.clone(labels),
        _ => no_labels()
      );
      mt_types := match(
        type_val_inner,
        Rc(.Struct({ field_types : types })) => Rc.clone(types),
        _ => no_types()
      );
      fidx_mt := find_first_field_index(&mt_labels.items, prop_name_mt.clone());
      match(
        fidx_mt,
        .Some(fi_mt) => {
          ft_mt := match(mt_types.get(fi_mt), .Some(t) => t, .None => t_unit());
          out_mt := new_expr_info(&env, &ft_mt);
          out_mt.set_value(Option(EvalValue).Some(create_unknown_val(&ft_mt)));
          out_mt.set_is_accessing_property(Option(bool).Some(true));
          expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_mt);
          expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_mt);
          return(expr.*);
        },
        .None => {
          // Not found — let function.yo handle it.
          return(expr.*);
        }
      );
    });
    // --- TypeVal + TraitT -------------------------------------------------
    is_plain_trait_type := match(&type_val_inner, Rc(.TraitT(_, _, _, _, _, _)) => true, _ => false);
    if(is_plain_trait_type, {
      if(!is_valid_variable_name(&property_expr), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(&property_expr),
              `Expected identifier for type method, got:\n${ast_expr_to_string(&property_expr)}`
            )
          )
        );
        return(expr.*);
      });
      prop_name_tt := ast_expr_text(&property_expr).*.clone();
      // `<:` WITNESS member access:
      // a TraitT whose `is_concrete` carries the receiver type — e.g.
      // `(Rc(i32) <: SomeTrait).method` — resolves the method against
      // the generic impl registry (trait-filtered) and stamps the RESOLVED
      // method type + VALUE. Without this the arm below returned the trait
      // FIELD's declared type with no value, so codegen fell back to a
      // record-member call through the witness's TYPE C name (`(bool(*)(
      // void*))__yo_tN.method)(x)` — undeclared identifier; rc layer 3,
      // repro issues/repros/iso-witness-member-call.yo, whose prelude trait
      // was deleted on 2026-10-21).
      tt_recv_opt := match(
        &type_val_inner,
        Rc(.TraitT(_, _, _, ic, _, _)) => ic.clone(),
        _ => Option(TypeValue).None
      );
      match(
        tt_recv_opt,
        .Some(tt_recv_ty) => {
          // Base key: entry.trait_key is now the constructor funcId for
          // parameterized traits (get_base_trait_key), so the witness filter
          // must query with the same base trait key.
          tt_trait_key := get_base_trait_key(&type_val_inner);
          // CONCRETE impls first: a witness
          // on a type with a direct `impl(R, Trait(...))` must resolve THAT
          // impl's method — `(T <: TraitDisambigB).get_number(self)` at spec
          // time (T bound to DisambigPoint) previously fell through the
          // generic-impl-only scan below and stamped no VALUE, so codegen
          // emitted the fallback `__yo_tN.get_number` type-name call
          // (impl.test.yo DisambigPoint RED).
          tt_trait_id := match(
            &type_val_inner,
            Rc(.TraitT(_, _, tt_own_id, _, _, _)) => tt_own_id.clone(),
            _ => String.from("")
          );
          tt_recv_id := type_id_or_empty(&tt_recv_ty);
          if(tt_recv_id != "", {
            tt_conc := get_assoc_type_entries(&tt_recv_ty, prop_name_tt.clone());
            (tt_ki : usize) = usize(0);
            while(tt_ki < tt_conc.len(), {
              match(
                tt_conc.get(tt_ki),
                .Some(tt_km) => if((tt_km.source_trait_id == tt_trait_id) || (tt_km.source_trait_id == tt_trait_key), {
                  out_wc := new_expr_info(&env, &tt_km.ty);
                  out_wc.set_value(tt_km.value);
                  out_wc.set_is_accessing_property(Option(bool).Some(true));
                  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_wc);
                  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_wc);
                  return(expr.*);
                }),
                .None => ()
              );
              tt_ki = (tt_ki + usize(1));
            });
          });
          tt_cands := find_methods_from_generic_impls(&tt_recv_ty, prop_name_tt.clone(), &env);
          (tt_ci : usize) = usize(0);
          while(tt_ci < tt_cands.len(), {
            tt_cand := match(
              tt_cands.get_cloned(tt_ci),
              .Some(c) => c,
              .None => {
                tt_ci = (tt_ci + usize(1));
                continue;
              }
            );
            // Trait-filtered (look up
            // ONLY the trait's registry bucket): a same-named method on an
            // unrelated trait must not match this witness.
            if(tt_cand.source_trait_id == tt_trait_key, {
              out_w := new_expr_info(&env, &tt_cand.method_type);
              out_w.set_value(tt_cand.method_value);
              out_w.set_is_accessing_property(Option(bool).Some(true));
              expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_w);
              expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_w);
              return(expr.*);
            });
            tt_ci = (tt_ci + usize(1));
          });
        },
        .None => ()
      );
      tt_labels := match(
        &type_val_inner,
        Rc(.TraitT(_, labels_body, _, _, _, _)) => labels_body.field_labels(),
        _ => ArrayList(String).new()
      );
      tt_types := match(
        type_val_inner,
        Rc(.TraitT(_, types_body, _, _, _, _)) => types_body.field_types(),
        _ => ArrayList(TypeValue).new()
      );
      fidx_tt := find_first_field_index(&tt_labels, prop_name_tt.clone());
      match(
        fidx_tt,
        .Some(fi_tt) => {
          ft_tt := match(tt_types.get_cloned(fi_tt), .Some(t) => t, .None => t_unit());
          out_tt := new_expr_info(&env, &ft_tt);
          out_tt.set_value(Option(EvalValue).Some(create_unknown_val(&ft_tt)));
          out_tt.set_is_accessing_property(Option(bool).Some(true));
          expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_tt);
          expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_tt);
          return(expr.*);
        },
        .None => {
          // Not found — let the function-call path handle it.
          return(expr.*);
        }
      );
    });
    // --- TypeVal + SomeT --------------------------------------------------
    // Resolve `Self.Item` (or `T.Item`) where the SomeT has a trait
    // constraint that declares `Item` as an associated type.
    //
    // SomeT doesn't
    // carry an inline `.trait` slot — the constraint trait lives in
    // either `required_trait_types` (for where-clause bounds) or in
    // `ctx.self_trait_type` (when the SomeT IS the trait's own Self).
    // We walk both and return on first match. The associated type's
    // value is not a per-field placeholder;
    // here we return an `UnknownVal` of the field's declared type
    // (typically `Type` for assoc-type fields), which is enough for
    // the function-type evaluator to accept `Self.Output` as a type
    // slot.
    if(is_some_type(&type_val_inner), {
      if(is_valid_variable_name(&property_expr), {
        st_prop_name := ast_expr_text(&property_expr).*.clone();
        st_rtt := match(
          type_val_inner,
          Rc(.SomeT(_, _, _, _, rtt_bnd, _, _)) => {
            rtt := rtt_bnd.required();
            rtt
          },
          _ => ArrayList(TypeValue).new()
        );
        // Build the list of candidate traits: explicit
        // required_trait_types first, then ctx.self_trait_type as
        // a fallback (covers `Self.X` during trait declaration).
        candidate_traits := ArrayList(TypeValue).new();
        (st_idx0 : usize) = usize(0);
        while(st_idx0 < st_rtt.len(), {
          match(
            st_rtt.get_cloned(st_idx0),
            .Some(t) => {
              candidate_traits.push(t);
            },
            .None => ()
          );
          st_idx0 = (st_idx0 + usize(1));
        });
        match(
          &ctx.self_trait_type,
          .Some(stt) => {
            candidate_traits.push(Rc.clone(stt));
          },
          .None => ()
        );
        (st_found : bool) = false;
        (st_idx : usize) = usize(0);
        st_n := candidate_traits.len();
        while((st_idx < st_n) && !st_found, {
          st_trait := match(candidate_traits.get_cloned(st_idx), .Some(t) => t, .None => t_unit());
          if(is_trait_type(&st_trait), {
            st_labels := match(
              &st_trait,
              Rc(.TraitT(_, labels_body3, _, _, _, _)) => labels_body3.field_labels(),
              _ => ArrayList(String).new()
            );
            st_types := match(
              st_trait,
              Rc(.TraitT(_, types_body3, _, _, _, _)) => types_body3.field_types(),
              _ => ArrayList(TypeValue).new()
            );
            st_fidx := find_first_field_index(&st_labels, st_prop_name.clone());
            match(
              st_fidx,
              .Some(st_fi) => {
                st_ft := match(st_types.get_cloned(st_fi), .Some(t) => t, .None => t_unit());
                // For assoc-type fields (declared `Item : Type` etc.), every
                // `Self.Output` must name
                // ONE SomeType object. The stand-in for that per-field
                // storage is the trait-definition scoped frame, where the
                // field loop binds the assoc label to its SomeT — resolve
                // THROUGH the env binding before minting, or each access
                // creates a fresh identity and a where-clause
                // `Self.Output <: Comptime` lands on a SomeT the trait's
                // field types never carry (the arm-26 split: env `Output#84`
                // carried the constraint, field types carried `Output#85`
                // with an empty required list).
                (placeholder_ty : TypeValue) = Rc.clone(st_ft);
                if(is_type_0(&st_ft), {
                  (st_env_bound : Option(TypeValue)) = Option(TypeValue).None;
                  st_env_vars := get_variables_from_env(&env, &st_prop_name);
                  if(st_env_vars.len() > usize(0), {
                    match(
                      st_env_vars.last_cloned(),
                      .Some(st_ev) => match(
                        st_ev.value().get(usize(0)),
                        .Some(.TypeVal(st_evt)) => {
                          if(is_some_type(&st_evt), {
                            st_env_bound = Option(TypeValue).Some(Rc.clone(st_evt));
                          });
                        },
                        .Some(_) => (),
                        .None => ()
                      ),
                      .None => ()
                    );
                  });
                  placeholder_ty = match(
                    st_env_bound,
                    .Some(st_bt) => Rc.clone(st_bt),
                    .None => t_some_t(st_prop_name.clone(), env.frames_len())
                  );
                });
                ev_st := if(
                  is_type_0(&st_ft),
                  create_type_value(&placeholder_ty),
                  create_unknown_val(&st_ft)
                );
                out_st := new_expr_info(&env, &st_ft);
                out_st.set_value(Option(EvalValue).Some(ev_st));
                out_st.set_is_accessing_property(Option(bool).Some(true));
                expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_st);
                expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_st);
                st_found = true;
              },
              .None => ()
            );
          });
          st_idx = (st_idx + usize(1));
        });
        if(st_found, {
          return(expr.*);
        });
        // Property not found in any constraint trait — fall through.
      });
    });
    // Unhandled TypeVal variant — fall through to runtime field access.
  });
  // -------------------------------------------------------------------------
  // Runtime field access: dereference any pointer chain, then access field.
  // -------------------------------------------------------------------------
  obj_ty_main := match(&obj_info_opt, .Some(oi) => Rc.clone(oi.ty()), .None => t_unit());
  original_obj_ty := Rc.clone(obj_ty_main);
  (base_ty : TypeValue) = obj_ty_main;
  // Dereference pointer chain.
  while(is_pointer_type(&base_ty), {
    match(
      Rc.clone(base_ty),
      Rc(.Pointer(pt)) => {
        base_ty = Rc.clone(pt);
      },
      _ => ()
    );
  });
  // A recursive struct's `Self` field (e.g. `Variable.is_owning_..._as :
  // Option(Variable)`) captured the empty-field self-shell during the
  // struct's own definition; `box.*.field` then derefs to that 0-field shell
  // and the field lookup degenerates to unit. Resolve the shell to its final
  // populated form so `fields_labels`/`fields_types` come from the real struct
  // (no-op for non-structs and populated structs — see resolve_struct_shell).
  base_ty = resolve_struct_shell(&base_ty);
  // Resolve a SomeType value-receiver (e.g. the io.async closure's `io : E`
  // bundle param) to its concrete type from env before field access — E is
  // bound into the closure's body_eval_env by evaluate_anonymous_function.
  if(is_some_type(&base_ty), {
    resolved_recv := get_value_of_some_type_from_env(&env, &base_ty);
    if(!is_some_type(&resolved_recv), {
      base_ty = resolve_struct_shell(&resolved_recv);
    });
  });
  obj_val_main := match(&obj_info_opt, .Some(oi) => oi.value(), .None => Option(EvalValue).None);
  // -------------------------------------------------------------------------
  // `.io` on the bare `Io` effect struct is the IDENTITY projection.
  // The bundle-style body form (`e.io.await(f, e.io)`) is written against an
  // effect BUNDLE ({io, exn}), but when an io.async closure's effect binds
  // `E` to the bare `Io` (Step 6b-nested derives it from the receiver), `e`
  // IS the Io and the projection must total — identity — or the body fails
  // its def-time trial ("No matching call found" on `(e.io).await`), was
  // historically swallowed into a runs-nothing future, and is now rejected
  // by the async poison gate
  // (issues/fixed/io-async-bare-e-closure-body-never-evaluates.md). Only `io` is
  // total: `.exn` on a bare Io stays a field-miss (there is no exception
  // capability to project). Identity is keyed on the io-builtin side table,
  // so a user struct that merely has an `io` field is untouched.
  if(is_struct_type(&base_ty) && ast_expr_is_atom(&property_expr) && (ast_expr_token(&property_expr).value.* == "io"), {
    io_proj_sid := match(&base_ty, Rc(.Struct({ id : ips })) => ips.clone(), _ => String.from(""));
    if((io_proj_sid.len() > usize(0)) && lookup_io_builtin_struct_field(io_proj_sid.clone(), String.from("await")).is_some(), {
      out_io := new_expr_info(&env, &base_ty);
      out_io.set_value(obj_val_main.clone());
      out_io.set_variable_name(match(&obj_info_opt, .Some(oi_io) => oi_io.variable_name(), .None => Option(String).None));
      out_io.set_path_collection(
        match(
          obj_info_opt,
          .Some(oi_pc) => oi_pc.path_collection(),
          .None => ArrayList(ArrayList(String)).new()
        )
      );
      out_io.set_is_accessing_property(Option(bool).Some(true));
      expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_io);
      expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_io);
      return(expr.*);
    });
  });
  // -------------------------------------------------------------------------
  // Struct / Tuple / Union field access
  // -------------------------------------------------------------------------
  if(is_tuple_type(&base_ty) || is_struct_type(&base_ty) || is_union_type(&base_ty), {
    fields_labels := match(
      &base_ty,
      Rc(.Tuple(labels, _)) => Rc.clone(labels),
      Rc(.Struct({ field_labels : labels })) => Rc.clone(labels),
      Rc(.Union(_, labels, _)) => Rc.clone(labels),
      _ => no_labels()
    );
    fields_types := match(
      &base_ty,
      Rc(.Tuple(_, types)) => Rc.clone(types),
      Rc(.Struct({ field_types : types })) => Rc.clone(types),
      Rc(.Union(_, _, types)) => Rc.clone(types),
      _ => no_types()
    );
    // MEMBER VISIBILITY: the declared type behind this access, for the
    // `_`-prefixed field check below. Tuples and source-namespace module
    // structs have no declaring type and are never blocked.
    pa_vis_type_id := match(
      &base_ty,
      Rc(.Struct({ id : pa_sid, is_source_namespace : pa_sns })) => cond(pa_sns.* => String.new(), true => pa_sid.clone()),
      Rc(.Union(pa_uid, _, _)) => pa_uid.clone(),
      _ => String.new()
    );
    // `YO_AUDIT_VARIABLE_TY=1` (decision 43 step 2 N1e-2b, VERDICTS-23 §4):
    // every read or write of the compiler's `Variable` binding-type field in
    // the source being checked, by site. The field is read only through
    // `variable_value_type` / `variable_slot_type` (src/env.yo), so a site
    // outside those accessors is a reader the representation flip would
    // miss.
    if(ast_expr_is_atom(&property_expr) && debug_knob(`YO_AUDIT_VARIABLE_TY`).is_some(), {
      vt_field := ast_expr_text(&property_expr).*.clone();
      if(((vt_field == "ty") || (vt_field == "bound_ty")) && (type_to_string(&base_ty) == "Variable"), {
        vt_tok := ast_expr_token(&property_expr);
        eprintln(`[variable-ty] ${vt_tok.module_path.*}:${(vt_tok.row + u32(1)).to_string()}:${(vt_tok.column + u32(1)).to_string()} ${vt_field}`);
      });
    });
    if(ast_expr_is_atom(&property_expr), {
      // --- Union member READ gate (safe mode) ------------------------------
      // A write (`u.x = v`, evaluated with is_lhs_of_assignment) stays legal.
      pa_union_member := ast_expr_text(&property_expr).*.clone();
      if(is_union_type(&base_ty) && !ctx.is_lhs_of_assignment && (fields_labels.items.contains(pa_union_member.clone()) && !is_union_member_read_capable(Option(String).Some(ast_expr_token(&property_expr).module_path.*.clone()), ctx.unsafe_context)), {
        exn.throw(dyn(format_error_message(ast_expr_token(&property_expr), union_member_read_error_message(pa_union_member.clone(), type_to_string(&base_ty)))));
        return(expr.*);
      });
      // --- Integer index access (tuple fields only) -----------------------
      if(ast_expr_token(&property_expr).kind == TokenKind.Integer, {
        if(!is_tuple_type(match(&obj_info_opt, .Some(oi) => Rc.clone(oi.ty()), .None => t_unit())), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(&property_expr),
                String.from("Accessing tuple field by index is only allowed for tuples.")
              )
            )
          );
          return(expr.*);
        });
        idx_str := ast_expr_text(&property_expr).*.clone();
        match(
          idx_str.parse_i64(),
          .None => {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(&property_expr),
                  `Expected integer for tuple index, got:\n${ast_expr_to_string(&property_expr)}`
                )
              )
            );
            return(expr.*);
          },
          .Some(idx_val) => {
            idx := usize(idx_val);
            field_count := fields_labels.len();
            if(idx >= field_count, {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(&property_expr),
                    `Index out of bounds: ${idx_str} for accessing field in:\n${type_to_string(&base_ty)}`
                  )
                )
              );
              return(expr.*);
            });
            ft_idx := _reference_field_read_type(&match(fields_types.get(idx), .Some(t) => t, .None => t_unit()), expr, &property_expr, pa_deref_exempt, ctx, exn);
            field_origin_idx := match(
              match(&obj_info_opt, .Some(oi) => expr_info_origin_type(&oi.*), .None => Option(TypeValue).None),
              .Some(ot) => ot,
              .None => original_obj_ty
            );
            idx_pc := match(
              obj_info_opt,
              .Some(oi) => build_field_path_collection(&oi.path_collection(), &oi.variable_name(), &idx_str),
              .None => build_field_path_collection(&ArrayList(ArrayList(String)).new(), &Option(String).None, &idx_str)
            );
            out_idx := new_expr_info(&env, &ft_idx);
            expr_info_set_origin_type(&out_idx, Option(TypeValue).Some(field_origin_idx));
            out_idx.set_is_accessing_property(Option(bool).Some(true));
            out_idx.set_path_collection(idx_pc);
            expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_idx);
            expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_idx);
            // Propagate compile-time value if available.
            match(
              obj_val_main,
              .Some(ov_idx) => {
                match(
                  ov_idx,
                  .TupleVal(flds_t) => {
                    match(
                      flds_t.get(idx),
                      .Some(fv) => {
                        out_idx.set_value(Option(EvalValue).Some(fv));
                      },
                      .None => ()
                    );
                  },
                  .StructVal(_, _, sflds_t) => {
                    match(
                      sflds_t.get(idx),
                      .Some(fv) => {
                        out_idx.set_value(Option(EvalValue).Some(fv));
                      },
                      .None => ()
                    );
                  },
                  _ => ()
                );
              },
              .None => ()
            );
            attach_temp_variable_to_expr(expr, false, ctx);
            return(expr.*);
          }
        );
      });
      // --- Label name access ----------------------------------------------
      if(is_valid_variable_name(&property_expr), {
        label_str := ast_expr_text(&property_expr).*.clone();
        field_idx_lbl := find_first_field_index(&fields_labels.items, label_str.clone());
        match(
          field_idx_lbl,
          .None => {
            if(is_module_type(match(obj_info_opt, .Some(oi) => Rc.clone(oi.ty()), .None => t_unit())), {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(&property_expr),
                    `Module field "${label_str}" not found in module type`
                  )
                )
              );
              return(expr.*);
            });
            // Auto-dereference (plans/VALUES_BY_DEFAULT.md §3.3): on a
            // `Deref` wrapper (`Box`, `Rc`, `Arc`) whose own fields lack the label,
            // `w.field` means `w.*.field`. The access is rebuilt with the
            // object `w.*` (same id), recorded as the node's rewrite
            // (`note_rewritten_node`) and re-evaluated, so every later
            // reader — codegen, the root-of-place walks (D3, E0908, inout),
            // the dup/drop passes — reads the ordinary explicit chain through
            // `ast_rewritten_node`; nested
            // wrappers recurse through the same arm. `w` itself was already
            // evaluated: it is marked so the re-evaluation reuses its
            // ExprInfo. A pointer object is left alone (`p.*` there is the
            // raw-pointer dereference).
            // In callee position (`w.items(i)`, `w.f(x)`) the wrapper's own
            // METHODS come first: the rewrite happens only when the wrapper
            // has no method of that name; a payload METHOD is reached by the
            // receiver retry in `_try_find_receiver_method`. So the order is
            // wrapper field, wrapper method, payload field, payload method.
            pa_is_callee := is_dot_callee(ast_expr_id(expr));
            if(!is_pointer_type(&original_obj_ty) && deref_target_type(&base_ty, &env).is_some(), {
              match(
                _deref_chain_has_field(&base_ty, label_str.clone(), &env),
                .Ok(_) => if(!pa_is_callee || (get_receiver_methods_by_name_from_env(&env, label_str.clone(), &base_ty, false).len() == usize(0)), {
                  // The tree's own object node, unless its evaluation
                  // returned a different node that carries the ExprInfo.
                  orig_obj := match(
                    all_args.get(usize(0)),
                    .Some(a) => cond(expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&a)).is_some() => a, true => object_expr),
                    .None => object_expr
                  );
                  pa_deref_args := ArrayList(AstExpr).new();
                  pa_deref_args.push(make_deref_expr(&orig_obj, ast_expr_token(expr), ast_expr_token(&property_expr)));
                  pa_deref_args.push(property_expr.clone());
                  pa_rewritten := match(expr, .FnCall(pa_id, pa_f, _, pa_infix, pa_tok) => AstExpr.FnCall(pa_id.*, pa_f.*, Rc.new(pa_deref_args), pa_infix.*, pa_tok.*), .Atom(_, _) => expr.clone());
                  note_rewritten_node(&pa_rewritten);
                  obj_id := ast_expr_id(&orig_obj);
                  mark_node_preevaluated(obj_id);
                  rewritten := recur(&pa_rewritten, env_in, ctx, exn);
                  unmark_node_preevaluated(obj_id);
                  return(rewritten);
                }, if(!(ctx.currently_specializing_function.is_some() || ctx.is_evaluating_generic_impl_specialization), {
                  // Decision 32: a callee `w.m` where the wrapper has a
                  // METHOD `m` and its payload a FIELD `m` (a function-typed
                  // field is callable) has two readings. The wrapper's
                  // method used to win silently. Off inside a specialized
                  // generic body, as `calls/function.yo`'s
                  // `_reject_wrapper_payload_clash` is.
                  obj_shown := ast_expr_to_string(&object_expr);
                  wrapper_s := type_to_string(&base_ty);
                  ctor := match(
                    wrapper_s.index_of(`(`),
                    .Some(pidx) => wrapper_s.substring(usize(0), pidx),
                    .None => wrapper_s.clone()
                  );
                  exn.throw(
                    dyn(
                      with_code(
                        format_error_message(
                          ast_expr_token(&property_expr),
                          `"${label_str}" is a method of ${wrapper_s} and a field of its payload, so ${obj_shown}.${label_str}(...) could mean either (plans/VALUES_BY_DEFAULT.md decision 32).\nWrite ${ctor}.${label_str}(${obj_shown}, ...) for the ${ctor}'s own ${label_str}, or ${obj_shown}.*.${label_str}(...) to call the payload's field.`
                        ),
                        E_AMBIGUOUS_METHOD
                      )
                    )
                  );
                  return(expr.*);
                })),
                .Err(innermost) => if(!pa_is_callee, {
                  exn.throw(
                    dyn(
                      with_code(
                        format_error_message(
                          ast_expr_token(&property_expr),
                          unknown_field_through_deref_message(label_str.clone(), ast_expr_to_string(&object_expr), &base_ty, &innermost, &_field_labels_of(&innermost).items)
                        ),
                        unknown_field_code(&base_ty)
                      )
                    )
                  );
                  return(expr.*);
                })
              );
            });
            // Outside callee position a missing field is a user error:
            // nothing else can make `p.xx` mean something, because a method
            // is reached only through a call (`p.xx(...)`, whose callee this
            // access then is — `mark_dot_callee`). It used to return
            // silently, so `z := p.z` read "Failed to evaluate", an argument
            // read "arg not evaluated", and `(p.xx + i32(1))` passed `check`
            // (issues/fixed/unknown-struct-field-has-no-diagnostic.md).
            if(!pa_is_callee, {
              exn.throw(dyn(with_code(format_error_message(ast_expr_token(&property_expr), unknown_field_message(&label_str, &base_ty, &fields_labels.items)), unknown_field_code(&base_ty))));
              return(expr.*);
            });
            // A method call — return without setting ExprInfo.
            return(expr.*);
          },
          .Some(fi_lbl) => {
            // The access site is the label TOKEN's module (lexical) — never
            // `env.module_path`, which inside a generic impl body evaluated at
            // call time is the CALLER's module.
            if(private_member_blocked(label_str.clone(), type_decl_module(pa_vis_type_id.clone()), &ast_expr_token(&property_expr).module_path.*), {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(&property_expr),
                    `Field "${label_str}" of ${type_to_string(&base_ty)} is private to its declaring module`
                  )
                )
              );
            });
            // A pointer clash (decision 32's rule covers raw pointers,
            // amended by #1248 under plans/VALUES_BY_DEFAULT.md decision 36):
            // `p.m(...)` through a raw pointer, where the pointee has a FIELD
            // `m` (field reads and calls of function-typed fields
            // auto-dereference) and the pointer has a METHOD `m` (today its
            // `clone` from the `Clone` impl `Copy` requires, or `add`/`sub`/
            // `offset_from`). Both readings are valid programs with one
            // spelling, so the call is an error naming the pointee-side
            // spelling `p.*.m(...)` and the pointer-side one. The field used
            // to win silently. In practice the only shared names are
            // `Clone`/`Copy` members against a function-typed pointee field:
            // method calls through a pointer do not reach the pointee's own
            // methods (E0610), so a pointee METHOD named like a pointer
            // method has no second reading to clash with.
            if(is_dot_callee(ast_expr_id(expr)) && is_pointer_type(&original_obj_ty), {
              if(get_pointer_own_methods_by_name_from_env(&env, label_str.clone(), &original_obj_ty).len() > usize(0), {
                obj_shown := ast_expr_to_string(&object_expr);
                exn.throw(
                  dyn(
                    format_error_message(
                      ast_expr_token(&property_expr),
                      `"${label_str}" is both a field of ${type_to_string(&base_ty)} and a method of the raw pointer ${type_to_string(&original_obj_ty)}, so ${obj_shown}.${label_str}(...) could mean either (plans/VALUES_BY_DEFAULT.md decision 32, covering raw pointers per decision 36). Write ${obj_shown}.*.${label_str}(...) to call the pointee's field. For the pointer's own ${label_str} there is no second spelling: a raw pointer is Copy, so for its clone the copy itself, q := ${obj_shown}, is the spelling.`
                    )
                  )
                );
                return(expr.*);
              });
            });
            ft_lbl := _reference_field_read_type(&match(fields_types.get(fi_lbl), .Some(t) => t, .None => t_unit()), expr, &property_expr, pa_deref_exempt, ctx, exn);
            field_origin_lbl := match(
              match(&obj_info_opt, .Some(oi) => expr_info_origin_type(&oi.*), .None => Option(TypeValue).None),
              .Some(ot) => ot,
              .None => original_obj_ty
            );
            lbl_pc := match(
              obj_info_opt,
              .Some(oi) => build_field_path_collection(&oi.path_collection(), &oi.variable_name(), &label_str),
              .None => build_field_path_collection(&ArrayList(ArrayList(String)).new(), &Option(String).None, &label_str)
            );
            out_lbl := new_expr_info(&env, &ft_lbl);
            expr_info_set_origin_type(&out_lbl, Option(TypeValue).Some(field_origin_lbl));
            out_lbl.set_is_accessing_property(Option(bool).Some(true));
            out_lbl.set_path_collection(lbl_pc);
            expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_lbl);
            expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_lbl);
            // Propagate compile-time value if available.
            match(
              obj_val_main,
              .Some(ov_lbl) => {
                match(
                  ov_lbl,
                  // Propagate `is_runtime_only` onto the field's unknown.
                  .UnknownVal(_, ov_lbl_ro) => {
                    out_lbl.set_value(
                      Option(EvalValue).Some(
                        if(
                          ov_lbl_ro,
                          create_runtime_unknown_val(&ft_lbl),
                          create_unknown_val(&ft_lbl)
                        )
                      )
                    );
                  },
                  _ => {
                    // Dereference through PtrVal before field selection.
                    (resolved_lbl : EvalValue) = ov_lbl;
                    (lbl_via_ptr : bool) = false;
                    match(
                      ov_lbl,
                      // The pointee lives at target_value(target_index) — the
                      // "optional faithfulness completion" noted in
                      // issues/fixed/yo-self-comptime-pointer-place.md — index
                      // first.
                      .PtrVal(tgt_cell_l, tgt_idx_l, _) => {
                        resolved_lbl = match(
                          tgt_cell_l.get(usize(0)),
                          .Some(t0l) => match(
                            t0l,
                            .ArrayVal(t0l_elems) => match(t0l_elems.get(tgt_idx_l), .Some(t0e) => t0e, .None => t0l),
                            _ => t0l
                          ),
                          .None => ov_lbl
                        );
                        lbl_via_ptr = true;
                      },
                      _ => ()
                    );
                    match(
                      resolved_lbl,
                      .TupleVal(flds_l) => {
                        match(
                          flds_l.get(fi_lbl),
                          .Some(fv) => {
                            out_lbl.set_value(Option(EvalValue).Some(fv));
                          },
                          .None => {
                            out_lbl.set_value(Option(EvalValue).Some(create_unknown_val(&ft_lbl)));
                          }
                        );
                        // Field access THROUGH A COMPTIME POINTER is a mutable
                        // compile-time PLACE: record it so `&(self.x)` can build a
                        // comptime PtrVal and `p(0) = v` can write in place
                        // (`if (isPtrValue(objectExprValue))` -> comptimeRef
                        // {kind:"struct"|"tuple"}). Without it the ComptimeIndex
                        // `index` body's `&(self.x)` evaluates to NO value and CTFE
                        // throws "Function body is not evaluated correctly.
                        // Expected to return a compile-time known value."
                        if(lbl_via_ptr, {
                          expr_info_set_comptime_ref(
                            &out_lbl,
                            Option(ComptimeRef).Some(
                              ComptimeRef.TupleRef(Rc.clone(flds_l), fi_lbl)
                            )
                          );
                        });
                      },
                      .StructVal(_, _, sflds_l) => {
                        match(
                          sflds_l.get(fi_lbl),
                          .Some(fv) => {
                            out_lbl.set_value(Option(EvalValue).Some(fv));
                          },
                          .None => {
                            out_lbl.set_value(Option(EvalValue).Some(create_unknown_val(&ft_lbl)));
                          }
                        );
                        // See the TupleVal arm above.
                        if(lbl_via_ptr, {
                          expr_info_set_comptime_ref(
                            &out_lbl,
                            Option(ComptimeRef).Some(
                              ComptimeRef.StructRef(Rc.clone(sflds_l), fi_lbl)
                            )
                          );
                        });
                      },
                      _ => {
                        out_lbl.set_value(Option(EvalValue).Some(create_unknown_val(&ft_lbl)));
                      }
                    );
                  }
                );
              },
              .None => ()
            );
            attach_temp_variable_to_expr(expr, false, ctx);
            return(expr.*);
          }
        );
      });
    });
    // } else if (isModuleType(objectType)) {
  });
  // -------------------------------------------------------------------------
  // Module field access
  // -------------------------------------------------------------------------
  if(is_module_type(&base_ty), {
    if(ast_expr_is_atom(&property_expr), {
      if(ast_expr_token(&property_expr).kind == TokenKind.Integer, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(&property_expr),
              `Accessing module field by index is not allowed, got:\n${ast_expr_to_string(&property_expr)}`
            )
          )
        );
        return(expr.*);
      });
      if(is_valid_variable_name(&property_expr), {
        mod_label := ast_expr_text(&property_expr).*.clone();
        // Phase 3 (plans/reference/INCREMENTAL_COMPILATION_ZIG_LESSONS.md §6):
        // attribute this module-member read — the enclosing def (forcing
        // top) gains a def-level edge; an ordered statement (empty stack)
        // degrades to the importer's ordered-read table.
        match(
          &base_ty,
          Rc(.Struct({ id : pa3_sns, is_source_namespace : pa3_is_sns })) => if(pa3_is_sns.*, {
            match(
              sns_module_of(pa3_sns.clone()),
              .Some(pa3_target) => record_module_member_read(&env.module_path().*, &pa3_target, mod_label.clone()),
              .None => ()
            );
          }),
          _ => ()
        );
        mod_labels_rt := match(
          &base_ty,
          Rc(.Struct({ field_labels : labels })) => Rc.clone(labels),
          _ => no_labels()
        );
        mod_types_rt := match(
          &base_ty,
          Rc(.Struct({ field_types : types })) => Rc.clone(types),
          _ => no_types()
        );
        mod_fidx := find_first_field_index(&mod_labels_rt.items, mod_label.clone());
        match(
          mod_fidx,
          .None => {
            if(is_module_type(match(obj_info_opt, .Some(oi) => Rc.clone(oi.ty()), .None => t_unit())), {
              // (No ModuleVal.isLoading check — there is no such field.)
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(&property_expr),
                    `Module field "${mod_label}" not found in module type`
                  )
                )
              );
              return(expr.*);
            });
            // Could be a method call.
            return(expr.*);
          },
          .Some(fi_mod) => {
            ft_mod := match(mod_types_rt.get(fi_mod), .Some(t) => t, .None => t_unit());
            mod_pc := match(
              obj_info_opt,
              .Some(oi) => build_field_path_collection(&oi.path_collection(), &oi.variable_name(), &mod_label),
              .None => build_field_path_collection(&ArrayList(ArrayList(String)).new(), &Option(String).None, &mod_label)
            );
            out_mod := new_expr_info(&env, &ft_mod);
            out_mod.set_is_accessing_property(Option(bool).Some(true));
            out_mod.set_path_collection(mod_pc);
            expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_mod);
            expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_mod);
            // Propagate compile-time value.
            match(
              obj_val_main,
              .Some(ov_mod) => {
                match(
                  ov_mod,
                  // Propagate `is_runtime_only`.
                  .UnknownVal(_, ov_mod_ro) => {
                    out_mod.set_value(
                      Option(EvalValue).Some(
                        if(
                          ov_mod_ro,
                          create_runtime_unknown_val(&ft_mod),
                          create_unknown_val(&ft_mod)
                        )
                      )
                    );
                  },
                  .StructVal(_, _, mvals) => {
                    match(
                      mvals.get(fi_mod),
                      .Some(mfv) => {
                        out_mod.set_value(Option(EvalValue).Some(mfv));
                      },
                      .None => {
                        out_mod.set_value(Option(EvalValue).Some(create_unknown_val(&ft_mod)));
                      }
                    );
                  },
                  _ => {
                    out_mod.set_value(Option(EvalValue).Some(create_unknown_val(&ft_mod)));
                  }
                );
              },
              .None => {
                // Object has no compile-time value (e.g. a def-time runtime
                // param bound valueless): resolve
                // the member value from the module type's REGISTERED fields.
                // The registered value stands in as
                // `field.assignedValue ?? createUnknownValue(field.type)` off
                // the TYPE, independent of the receiver's value — this is how
                // `io.async(...)` resolves inside a def-time function body.
                mod_sid := match(base_ty, Rc(.Struct({ id : msid })) => msid.clone(), _ => String.from(""));
                (mod_reg_val : Option(EvalValue)) = Option(EvalValue).None;
                match(
                  get_struct_fields(&mod_sid),
                  .Some(mod_tfs) => match(
                    mod_tfs.get_cloned(fi_mod),
                    .Some(mod_tf) => {
                      mod_reg_val = mod_tf.assigned_value;
                    },
                    .None => ()
                  ),
                  .None => ()
                );
                out_mod.set_value(
                  match(
                    mod_reg_val,
                    .Some(av) => Option(EvalValue).Some(av),
                    .None => Option(EvalValue).Some(create_unknown_val(&ft_mod))
                  )
                );
              }
            );
            return(expr.*);
          }
        );
      });
    });
  });
  // -------------------------------------------------------------------------
  // Enum selected-variant field access
  // -------------------------------------------------------------------------
  if(is_enum_type(&base_ty), {
    if(ast_expr_is_atom(&property_expr), {
      if(!is_valid_variable_name(&property_expr), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(&property_expr),
              `Expected identifier for enum variant property, got:\n${ast_expr_to_string(&property_expr)}`
            )
          )
        );
        return(expr.*);
      });
      prop_name_ev := ast_expr_text(&property_expr).*.clone();
      match(
        base_ty,
        Rc(.EnumT(_, _, ev_vnames, ev_vfields, ev_sel, ev_vflabels, _, _, _, _)) => {
          match(
            ev_sel,
            .Some(sel_vname) => {
              sel_vi_opt := find_first_field_index(&ev_vnames.items, sel_vname.clone());
              match(
                sel_vi_opt,
                .Some(sel_vi) => {
                  vfl := match(
                    ev_vflabels.get(sel_vi),
                    .Some(fl) => fl,
                    .None => no_labels()
                  );
                  vft := match(
                    ev_vfields.get(sel_vi),
                    .Some(ft) => ft,
                    .None => no_types()
                  );
                  prop_fidx_ev := find_first_field_index(&vfl.items, prop_name_ev.clone());
                  match(
                    prop_fidx_ev,
                    // Could be an enum method call.
                    .None => (),
                    .Some(pfi) => {
                      ft_ev := match(vft.get(pfi), .Some(t) => t, .None => t_unit());
                      enum_pc := ArrayList(ArrayList(String)).new();
                      ep_path := ArrayList(String).new();
                      ep_obj_vname := match(
                        obj_info_opt,
                        .Some(oi) => match(&oi.variable_name(), .Some(n) => n.clone(), .None => String.from("?")),
                        .None => String.from("?")
                      );
                      ep_path.push(ep_obj_vname);
                      ep_path.push(prop_name_ev);
                      enum_pc.push(ep_path);
                      out_ev := new_expr_info(&env, &ft_ev);
                      out_ev.set_path_collection(enum_pc);
                      out_ev.set_is_accessing_property(Option(bool).Some(true));
                      expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_ev);
                      expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &out_ev);
                      // Propagate compile-time enum value.
                      match(
                        obj_val_main,
                        .Some(eov) => {
                          match(
                            eov,
                            .EnumVal(ev_vn, ev_flds) => {
                              dot_sel := `.${ sel_vname }`;
                              if(ev_vn == dot_sel, {
                                match(
                                  ev_flds.get(pfi),
                                  .Some(efv) => {
                                    out_ev.set_value(Option(EvalValue).Some(efv));
                                  },
                                  .None => ()
                                );
                              });
                            },
                            _ => ()
                          );
                        },
                        .None => ()
                      );
                      return(expr.*);
                    }
                  );
                },
                .None => ()
              );
            },
            .None => {
              // No selected variant — the enum isn't narrowed to a variant
              // (e.g. a bare `fn(e : E)` parameter, whose runtime variant is
              // not statically known). Resolve the property against the variant
              // that declares it, when exactly one does, so `e.field` /
              // `e.field = x` works like struct-field access — a `ref(struct)`
              // parameter already supports in-place field mutation; a
              // `ref(enum)` parameter must too (reference semantics). The
              // programmer asserts the active variant; codegen emits the
              // unchecked field access (resolve against the declaring
              // variants).
              (n_dv : usize) = usize(0);
              (dv_idx : usize) = usize(0);
              (dv_i : usize) = usize(0);
              while(dv_i < ev_vflabels.len(), {
                dv_fl := match(ev_vflabels.get(dv_i), .Some(fl) => fl, .None => no_labels());
                match(
                  find_first_field_index(&dv_fl.items, prop_name_ev.clone()),
                  .Some(_) => {
                    n_dv = (n_dv + usize(1));
                    dv_idx = dv_i;
                  },
                  .None => ()
                );
                dv_i = (dv_i + usize(1));
              });
              if(n_dv == usize(1), {
                dv_vfl := match(ev_vflabels.get(dv_idx), .Some(fl) => fl, .None => no_labels());
                dv_vft := match(ev_vfields.get(dv_idx), .Some(ft) => ft, .None => no_types());
                dv_pfi := match(find_first_field_index(&dv_vfl.items, prop_name_ev.clone()), .Some(i) => i, .None => usize(0));
                dv_ft := match(dv_vft.get(dv_pfi), .Some(t) => t, .None => t_unit());
                dv_pc := ArrayList(ArrayList(String)).new();
                dv_path := ArrayList(String).new();
                dv_obj_vname := match(
                  obj_info_opt,
                  .Some(oi) => match(&oi.variable_name(), .Some(n) => n.clone(), .None => String.from("?")),
                  .None => String.from("?")
                );
                dv_path.push(dv_obj_vname);
                dv_path.push(prop_name_ev);
                dv_pc.push(dv_path);
                dv_out := new_expr_info(&env, &dv_ft);
                dv_out.set_path_collection(dv_pc);
                dv_out.set_is_accessing_property(Option(bool).Some(true));
                expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &dv_out);
                expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&property_expr), &dv_out);
                match(
                  obj_val_main,
                  .Some(eov) => match(
                    eov,
                    .EnumVal(ev_vn, ev_flds) => {
                      dv_name := match(ev_vnames.get_cloned(dv_idx), .Some(nm) => nm, .None => String.from(""));
                      dv_dot_sel := `.${ dv_name }`;
                      if(ev_vn == dv_dot_sel, {
                        match(
                          ev_flds.get(dv_pfi),
                          .Some(efv) => {
                            dv_out.set_value(Option(EvalValue).Some(efv));
                          },
                          .None => ()
                        );
                      });
                    },
                    _ => ()
                  ),
                  .None => ()
                );
                return(expr.*);
              });
            }
          );
        },
        _ => ()
      );
    });
  });
  // -------------------------------------------------------------------------
  // Fallback: property access could not be resolved at compile time.
  // Return expr without setting ExprInfo — codegen / function.yo will handle.
  // -------------------------------------------------------------------------
  if(debug_knob(`YO_DEBUG_CTFE`).is_some(), {
    pa_obj_ty := match(
      expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&object_expr)),
      .Some(pa_oi) => type_to_string(&pa_oi.ty()),
      .None => String.from("<no-info>")
    );
    eprintln(`[pa-fallthrough] prop=${ast_expr_token(&property_expr).value.*} obj_ty=${pa_obj_ty}`);
  });
  expr.*
});
export(evaluate_property_access, make_deref_expr);
