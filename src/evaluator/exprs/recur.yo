//! evaluate_recur — handles the `recur(...)` tail-recursive self-call builtin.
//!
//! 1:1 port of `src/evaluator/exprs/recur.ts`.
//!
//! `recur(...)` invokes the current function recursively.  It is only valid
//! inside a function body (`FuncOrAsyncBlockKind.FunctionBody`).
//!
//! Two execution paths:
//!   1. **Short-circuit** (CTFE analysis / function-definition validation):
//!      type-checks arguments without executing, returns an `UnknownVal` of the
//!      return type, and attaches a temp variable for RC drop tracking.
//!   2. **Normal**: delegates to `evaluate_function_call` with the current
//!      function type/value as `given_func`.
//!
//! Known semantic gaps vs. TypeScript (to be filled in Phase 3):
//!   - `UnknownVal` does not yet carry `variable_name` or `is_runtime_only`.
//!     The `is_runtime_only` flag prevents comptime overload selection on
//!     `recur(...)` results (see issues/recur-runtime-result-not-marked-runtime-only.md).
//!   - `try_to_call_function_with_arguments` is a throwing stub (Phase 3).
//!   - `attach_temp_variable_to_expr` is a no-op stub (Phase 3).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_fn_call_of,
  BF_RECUR,
  make_err_expr
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set
} :: import("../../expr_info.yo");
{ Environment, snapshot_env } :: import("../../env.yo");
{
  EvalContext,
  FuncOrAsyncBlockKind,
  FuncOrAsyncBlockCtx
} :: import("../context.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{
  EvalValue,
  create_unknown_val,
  create_runtime_unknown_val,
  is_func_val,
  is_unknown_val
} :: import("../../value.yo");
{ attach_temp_variable_to_expr } :: import("../utils.yo");
{ random_id } :: import("../../utils.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ evaluate_function_call } :: import("../calls/function.yo");
{ try_to_call_function_with_arguments } :: import("../calls/helper.yo");
{ ArrayList } :: import("std/collections/array_list");
/// Evaluate a `recur(...)` tail-recursive self-call expression.
///
/// Mirrors `evaluateRecur` in `src/evaluator/exprs/recur.ts`.
evaluate_recur :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  // ------------------------------------------------------------------
  // Guard 1: must be inside a function body.
  // ------------------------------------------------------------------
  block_ctx_opt := ctx.is_evaluating_function_body_or_async_block;
  is_function_body := match(
    block_ctx_opt,
    .None => false,
    .Some(bc) => match(bc.kind, .FunctionBody => true, _ => false)
  );
  if(!is_function_body, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected a function type for recur, got:\n${ast_expr_to_string(expr)}`,
          false,
          .None
        )
      )
    );
  });
  func_body_ctx := match(
    block_ctx_opt,
    .Some(bc) => bc,
    .None => FuncOrAsyncBlockCtx(
      kind : FuncOrAsyncBlockKind.FunctionBody,
      func_type : Option(TypeValue).None,
      func_value : Option(EvalValue).None,
      eval_env : snapshot_env(env)
    )
  );
  // ------------------------------------------------------------------
  // Guard 2: must be a recur(...) call.
  // ------------------------------------------------------------------
  if(!ast_expr_is_fn_call_of(expr, BF_RECUR, Option(usize).None), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected recur, got:\n${ast_expr_to_string(expr)}`,
          false,
          .None
        )
      )
    );
  });
  // ------------------------------------------------------------------
  // Guard 3: func_type must be present.
  // ------------------------------------------------------------------
  match(
    func_body_ctx.func_type,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("recur: missing function type in context"),
            false,
            .None
          )
        )
      );
    },
    .Some(_) => ()
  );
  is_evaluating_function_body_of_type := match(
    func_body_ctx.func_type,
    .Some(ft) => ft,
    .None => t_unit()
  );
  // ------------------------------------------------------------------
  // Short-circuit path: CTFE capability analysis or function-definition
  // validation.  Avoids infinite recursion by skipping actual execution.
  // ------------------------------------------------------------------
  if(ctx.is_analyzing_ctfe_capability || ctx.is_validating_function_definition, {
    // Type-check arguments without executing.
    //
    // Phase 2x stub: `try_to_call_function_with_arguments` is not yet
    // implemented and will throw. This short-circuit path becomes fully
    // functional in Phase 3.
    //
    // When `functionValue` is a function value, pass it; otherwise pass None.
    function_val_opt := match(
      func_body_ctx.func_value,
      .Some(fv) => if(is_func_val(fv), Option(EvalValue).Some(fv), Option(EvalValue).None),
      .None => Option(EvalValue).None
    );
    // Extract callee and args from the recur(...) FnCall node.
    callee_expr := match(
      expr,
      .FnCall(_, func_box, _, _, _) => func_box,
      _ => make_err_expr()
    );
    arg_exprs := match(
      expr,
      .FnCall(_, _, args, _, _) => args,
      _ => ArrayList(AstExpr).new()
    );
    call_result := try_to_call_function_with_arguments(
      function_val_opt,
      is_evaluating_function_body_of_type,
      expr,
      callee_expr,
      arg_exprs,
      env,
      ctx,
      false,
      // isMethodCall
      true,
      // skipSpecialization
      true,
      // skipCtfeExecution
      exn
    );
    // NOTE: TS's call site does `env = popEnvFrame(callerEnv)` because TS's
    // tryToCallFunctionWithArguments pushes a frame on the CALLER env;
    // yo-self's port pushes frames only on the callee/specialized envs, so
    // popping here removed the INNERMOST CALLER FRAME — a 3-arg while's
    // loop frame lost its variables and the step expression failed
    // "Variable i not found" (std/regex/compiler.yo's Sequence walk).
    caller_env := call_result.caller_env;
    // Build an UnknownVal for the return type.
    //
    // When the function being recurred RETURNS AT RUNTIME (its return is not
    // `comptime(...)`), the result is marked `is_runtime_only` — 1:1 with TS
    // recur.ts:97-108, whose comment explains why: otherwise "overload
    // resolution at the call site of `recur(...)` may incorrectly prefer a
    // comptime overload (e.g. `comptime_not` over runtime `not` for
    // `!recur(...)`), producing malformed C with a 0-arg comptime function
    // call". See issues/recur-runtime-result-not-marked-runtime-only.md.
    // (`variable_name` is still not carried — see the stub inventory.)
    return_type := call_result.return_type;
    recur_ret_is_comptime := match(
      func_body_ctx.func_type,
      .Some(ft) => match(ft, .Func({ meta : __rc_fm }) => __rc_fm.*.result_is_comptime_only, _ => false),
      .None => false
    );
    recur_unknown := if(
      recur_ret_is_comptime,
      create_unknown_val(return_type),
      create_runtime_unknown_val(return_type)
    );
    random_id(caller_env.module_path); // mirrors: randomId(env.modulePath)
    // Write ExprInfo for this recur expression.
    out_info := new_expr_info(caller_env, return_type);
    out_info.value = Option(EvalValue).Some(recur_unknown);
    out_info.runtime_arg_exprs_in_order =
      Option(ArrayList(AstExpr)).Some(call_result.runtime_arg_exprs_in_order);
    out_info.deferred_drop_expressions = call_result.deferred_drop_expressions;
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    // Attach a temp variable for RC drop tracking.
    // Phase 2x stub: no-op; full implementation in Phase 3.
    attach_temp_variable_to_expr(expr, true, ctx);
    return(expr);
  });
  // ------------------------------------------------------------------
  // Normal path: delegate to evaluate_function_call.
  // ------------------------------------------------------------------
  evaluate_function_call(
    expr,
    env,
    is_evaluating_function_body_of_type,
    func_body_ctx.func_value,
    ctx,
    exn
  )
});
export(evaluate_recur);
