//! evaluate_unwind — handles the `unwind(value)` builtin.
//!
//! `unwind(value)` (or bare `unwind()`) returns from the **enclosing**
//! function with `value` (or `unit`), discarding the current continuation.
//!
//! NOTE: this evaluator does NOT itself check that we are in a `given`
//! handler — that constraint is enforced at the FunctionValue-creation sites
//! (the §4 rule-1 post-eval gate keyed on `is_control`, in
//! values/anonymous_function.yo and calls/function_type.yo). It must not
//! gate on `ctx.is_inside_given_handler` either: a former compensating
//! control there wrongly threw during definition-time body eval of
//! plain-`:=` handlers.
{ String } :: import("std/string");
import("std/fmt");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_fn_call_of,
  BF_UNWIND,
  make_err_expr
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set,
  ControlFlowKind,
  control_flow_of
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx } :: import("../context.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_i32, t_unit } :: import("../../types/creators.yo");
{ is_some_type } :: import("../../types/guards.yo");
{ are_types_compatible } :: import("../../types/compatibility.yo");
{ type_to_string } :: import("../../types/string.yo");
{ format_error_message, YoError, format_eval_failure } :: import("../../error.yo");
{ Token } :: import("../../token.yo");
{ type_contains_some_type_deep } :: import("../../types/utils.yo");
{ raise_flow_violation } :: import("../../types/flowability.yo");
{ Exception } :: import("std/error");
{ evaluate_expression } :: import("./expr.yo");
/// Throw the `unwind`-value / enclosing-return-type mismatch — one message
/// for every `unwind` site (the standalone form here and the statement form
/// in `begin.yo`).
///
/// When BOTH types are concrete the error cannot hinge on a closure
/// parameter's still-unknown type, so it also goes on the flow-violation
/// channel. The exception handler `(e) -> { unwind(v) }` is a closure, its
/// body is trial-evaluated at definition time, and that trial SWALLOWS what
/// the body throws: without the flag, `unwind(())` in a fn returning `i32`
/// passed `yo check`, compiled rc=0, and the handler became an abort() stub
/// (issues/fixed/unwind-type-mismatch-in-a-handler-is-swallowed.md).
throw_unwind_type_mismatch :: (
  fn(token : Token, expected : TypeValue, got : TypeValue, ctx : EvalContext, exn : Exception) -> unit
)({
  msg := `Incompatible type for \`unwind\` argument:\n- Expected (enclosing function return type): ${type_to_string(expected)}\n- Got: ${type_to_string(got)}`;
  concrete := (!type_contains_some_type_deep(expected) && !type_contains_some_type_deep(got));
  err := format_error_message(token, msg);
  if(concrete, {
    raise_flow_violation(err, ctx, exn);
  });
  exn.throw(dyn(err));
});
/// `unwind` outside a closure or function literal nested in a function
/// (also raised by `begin.yo` for a block-level `unwind`).
UNWIND_WITHOUT_ENCLOSING_FN :: "`unwind` exits the function that encloses the current closure (`=>`) or function literal (`->`), such as an effect handler, so it only works inside one nested in a function. This code has no such enclosing function: use `return(...)` to leave it.";
evaluate_unwind :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  // Validate shape: an `unwind` call (0 or 1 argument).
  if(!ast_expr_is_fn_call_of(expr, BF_UNWIND, .None), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Expected `unwind`.")
        )
      )
    );
  });
  // Must be inside a function with an enclosing function.
  match(
    ctx.enclosing_function_return_type,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from(UNWIND_WITHOUT_ENCLOSING_FN)
          )
        )
      );
    },
    .Some(_) => ()
  );
  enclosing_ret := match(
    ctx.enclosing_function_return_type,
    .Some(t) => t,
    .None => t_i32()
  );
  // `unwind` accepts at most one argument.
  n_args := match(expr, .FnCall(_, _, args, _, _) => args.len(), .Atom(_, _) => usize(0));
  if(n_args > usize(1), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("`unwind` accepts at most one argument.")
        )
      )
    );
  });
  // (No `is_inside_given_handler` gate: only the enclosing-function check
  // happens here. "unwind is valid only in a `ctl(...)` body" is enforced at
  // the FunctionValue CREATION site — the §4 rule-1 post-eval gate keyed on
  // `is_control` (values/anonymous_function.yo / calls/function_type.yo). A
  // former compensating gate here threw during DEFINITION-TIME body eval of a
  // plain `exn := Exception(throw : (err) -> unwind(...))` handler — where
  // `is_inside_given_handler` is false (only set for `given(exn) :=`) — aborting before the
  // `unwind` expr's ExprInfo was stamped, so codegen emitted "// Failed to transpile
  // unwind(...)".)
  // No-argument form `unwind()` — type unit.
  if(n_args == usize(0), {
    if(!is_some_type(enclosing_ret) && !are_types_compatible(t_unit(), enclosing_ret), {
      throw_unwind_type_mismatch(ast_expr_token(expr), enclosing_ret, t_unit(), ctx, exn);
    });
    unit_info := new_expr_info(env, t_unit());
    unit_info.control_flow = .Some(control_flow_of(.Unwind));
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), unit_info);
    return(expr);
  });
  // Pull arg out of the FnCall.
  arg_expr := match(
    expr,
    .FnCall(_, _, args, _, _) => match(
      args.get(usize(0)),
      .Some(a) => a,
      .None => make_err_expr()
    ),
    .Atom(_, _) => make_err_expr()
  );
  // Recursively evaluate the argument with the enclosing return type as the
  // expected type.
  saved_expected := ctx.expected_type;
  ctx.expected_type = .Some(ExpectedTypeCtx(ty : enclosing_ret, env : env));
  evaluated := evaluate_expression(arg_expr, env, ctx);
  ctx.expected_type = saved_expected;
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
  match(
    info_opt,
    .None => {
      exn.throw(
        dyn(
          format_eval_failure(
            ast_expr_token(arg_expr),
            String.from("Failed to evaluate the argument of `unwind`.")
          )
        )
      );
    },
    .Some(_) => ()
  );
  arg_info := match(
    info_opt,
    .Some(i) => i,
    .None => new_expr_info(env, t_i32())
  );
  // Type-check (skip when enclosing_ret is a SomeType).
  if(!is_some_type(enclosing_ret) && !are_types_compatible(arg_info.ty, enclosing_ret), {
    throw_unwind_type_mismatch(ast_expr_token(arg_expr), enclosing_ret, arg_info.ty, ctx, exn);
  });
  // Emit ExprInfo: type = arg type, value = .None, control_flow = unwind.
  out_info := new_expr_info(env, arg_info.ty);
  out_info.control_flow = .Some(control_flow_of(.Unwind));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
export(evaluate_unwind, throw_unwind_type_mismatch, UNWIND_WITHOUT_ENCLOSING_FN);
