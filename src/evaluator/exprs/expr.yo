//! evaluate_expression function pointer mechanism.
//!
//! The function pointer avoids forward references between the dispatcher
//! (_expr.yo) and individual handlers that call back into it.
import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ Exception, AnyError } :: import("std/error");
{ AstExpr, ExprId } :: import("../../expr.yo");
{ ExprInfoTable } :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ panic, assert } :: import("std/assert");
/// Function type for the main expression evaluator.
EvaluateExprFn :: (
  fn(
    imm(expr) : AstExpr,
    imm(env) : Environment,
    imm(ctx) : EvalContext
  ) -> AstExpr
);
/// Function type for the raw expression evaluator (with custom exception handler).
/// Used by builtins like `comptime_expect_error` that need to catch evaluation errors.
EvaluateExprRawFn :: (
  fn(
    imm(expr) : AstExpr,
    imm(env) : Environment,
    imm(ctx) : EvalContext,
    imm(exn) : Exception
  ) -> AstExpr
);
/// Module-level function pointer — set once during evaluator initialization.
(g_evaluate_expression : Option(EvaluateExprFn)) = Option(EvaluateExprFn).None;
/// Module-level raw function pointer — stores `_evaluate_expression` directly.
/// Unlike `g_evaluate_expression`, this bypasses the panic wrapper so callers
/// can supply their own exception handler via `exn : Exception`.
(g_evaluate_expression_raw : Option(EvaluateExprRawFn)) = Option(EvaluateExprRawFn).None;
/// Set the global evaluate_expression function pointer.
/// Called once during evaluator initialization before any evaluation begins.
set_evaluate_expression_fn :: (fn(f : EvaluateExprFn) -> unit)({
  g_evaluate_expression = Option(EvaluateExprFn).Some(f);
  ()
});
/// Set the global raw evaluate_expression function pointer.
/// Called once during evaluator initialization (alongside `set_evaluate_expression_fn`).
set_evaluate_expression_raw_fn :: (fn(f : EvaluateExprRawFn) -> unit)({
  g_evaluate_expression_raw = Option(EvaluateExprRawFn).Some(f);
  ()
});
/// Dispatch an expression through the registered evaluator.
/// Panics if the evaluator has not been initialized.
evaluate_expression :: (
  fn(
    imm(expr) : AstExpr,
    imm(env) : Environment,
    imm(ctx) : EvalContext
  ) -> AstExpr
)(
  match(
    g_evaluate_expression,
    .None => __yo_panic("evaluate_expression called before set_evaluate_expression_fn"),
    .Some(f) => f(expr, env, ctx)
  )
);
/// The error the most recent `evaluate_expression_guarded` caught (its
/// handler is capture-free, so a module-level channel).
(g_guarded_eval_err : ArrayList(AnyError)) = ArrayList(AnyError).new();
/// Evaluate `expr` so that its error reaches the caller instead of being
/// swallowed (unlike the 3-argument `evaluate_expression`), but RETURNED
/// rather than thrown: a caller that set ctx state for the evaluation
/// (`expected_type`, `self_type`, …) restores it first and then re-raises
/// with its own `exn`. On success the result is pushed to `out` and `.None`
/// is returned (plans/TYPE_SYSTEM_SOUNDNESS.md Phase 6, census site #16).
evaluate_expression_guarded :: (
  fn(
    imm(expr) : AstExpr,
    imm(env) : Environment,
    imm(ctx) : EvalContext,
    mut(out) : ArrayList(AstExpr)
  ) -> Option(AnyError)
)({
  g_guarded_eval_err.clear();
  _evaluate_expression_guarded_inner(expr, env, ctx, out);
  if(out.len() > usize(0), {
    return(Option(AnyError).None);
  });
  cond(
    (g_guarded_eval_err.len() == usize(0)) => Option(AnyError).None,
    true => g_guarded_eval_err.last()
  )
});
_evaluate_expression_guarded_inner :: (
  fn(
    imm(expr) : AstExpr,
    imm(env) : Environment,
    imm(ctx) : EvalContext,
    mut(out) : ArrayList(AstExpr)
  ) -> unit
)({
  guard_exn := Exception(
    throw : (
      _g_err -> {
        g_guarded_eval_err.push(_g_err);
        unwind(())
      }
    )
  );
  out.push(evaluate_expression_raw(expr, env, ctx, &guard_exn));
});
/// Dispatch an expression through the raw evaluator with a custom exception handler.
/// Use this when you need to catch compilation errors from evaluation (e.g., `comptime_expect_error`).
/// Panics if the evaluator has not been initialized.
evaluate_expression_raw :: (
  fn(
    imm(expr) : AstExpr,
    imm(env) : Environment,
    imm(ctx) : EvalContext,
    imm(exn) : Exception
  ) -> AstExpr
)(
  match(
    g_evaluate_expression_raw,
    .None => __yo_panic("evaluate_expression_raw called before set_evaluate_expression_raw_fn"),
    .Some(f) => f(expr, env, ctx, exn)
  )
);
export(EvaluateExprFn, EvaluateExprRawFn);
export(set_evaluate_expression_fn, evaluate_expression);
export(set_evaluate_expression_raw_fn, evaluate_expression_raw, evaluate_expression_guarded);
