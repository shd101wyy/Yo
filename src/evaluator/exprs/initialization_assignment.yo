{ is_io_async_call } :: import("../async/await_analysis.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// evaluate_initialization_assignment
// ---------------------------------------------------------------------------
/// Evaluate a `::` or `:=` initialization expression.
/// One hop of an `inout` place chain `root.f1.f2…fn`: the `.`/2 node and the
/// field atom it selects.
_InoutPlaceHop :: struct(node : AstExpr, field : AstExpr);
/// Walk a place expression to its root atom, collecting the `.`/2 hops from
/// the OUTERMOST (the full place) to the INNERMOST (the hop on the root).
/// `.None` when the chain does not root at an atom (a call, an index, a
/// literal, a nested rvalue).
_inout_place_chain :: (fn(place : &AstExpr, hops : &mut ArrayList(_InoutPlaceHop)) -> Option(AstExpr))({
  (cur : AstExpr) = place;
  (walking : bool) = true;
  while(walking, {
    if(ast_expr_is_fn_call(cur) && ast_expr_is_fn_call_of(cur, BF_DOT, Option(usize).Some(usize(2))), {
      match(
        cur,
        .FnCall(_, _, dargs, _, _) => {
          recv := match(dargs.get(usize(0)), .Some(b) => b, .None => make_err_expr());
          fld := match(dargs.get(usize(1)), .Some(b) => b, .None => make_err_expr());
          hops.push(_InoutPlaceHop(node : cur, field : fld));
          cur = recv;
        },
        .Atom(_, _) => {
          walking = false;
        }
      );
    }, {
      walking = false;
    });
  });
  cond(
    ast_expr_is_atom(cur) => Option(AstExpr).Some(cur),
    true => Option(AstExpr).None
  )
});
/// `name := &mut place;` — bind `name` as a second-class reference to the
/// storage `place` names (plans/archive/INOUT_LOCAL_BINDINGS_AUDIT.md §7, decision 1;
/// §8 Phase B).
///
/// Accepted places (the parameter place rule, minus the cross-argument
/// clause that has no meaning here): a whole variable of any scope; a field
/// chain rooted at a value-struct variable; a field chain that hops through
/// an RC object — the INNERMOST object on the chain is then PINNED: a hidden
/// owning local holds a `+1` on it for the binding's scope, so reassigning
/// or dropping the visible handle cannot free the storage `name` points into
/// (§2 P4). Rejected: index/deref places (`xs(i)`, `p.*` — element borrows
/// are the `for` macro's job), rvalues, `Type.member`, compile-time roots,
/// the `::` form, and module-level declarations. An `io.async` body is
/// accepted: its state machine keeps each local in one task slot.
///
/// The bound variable is `is_ref` (reads emit `(*name)`, writes write
/// through), `is_reassignable`, NOT owning (no scope-end drop of the
/// pointee), and records its root's id (`inout_borrow_root_id`) for the
/// consume gate; the root is marked `is_inout_borrow_root` so the last-use
/// optimizers never turn its dup into a move (§9 H6). For a whole-variable
/// place the binding SHARES the root's `Variable.value` cell, so compile-time
/// reads through the alias observe the root (H27); field places are
/// runtime-only.
///
/// Codegen channel (init_assignment.yo `_generate_inout_local_binding`): the
/// `:=` node's ExprInfo has unit type; the `inout(name)` LHS node's ExprInfo
/// carries the PIN when one exists — `source_variable` = the hidden owning
/// local, `macro_expansion` = the object expression it holds. The LHS node
/// is never dispatched through `generate_expression`, so neither field is
/// read by anything else.
_evaluate_inout_local_binding :: (
  fn(
    expr : &AstExpr,
    lhs : &AstExpr,
    rhs : &AstExpr,
    is_compile_time_only : bool,
    env : &Environment,
    ctx : &EvalContext,
    exn : &Exception
  ) -> AstExpr
)({
  lhs_tok := ast_expr_token(lhs);
  // `y := &place` binds a read-only borrow; `y := &mut place` an exclusive one
  // (plans/VALUES_BY_DEFAULT.md decision 18).
  is_mut := ast_expr_is_inout_mode_call(lhs, .None);
  // The borrow's sigil as decision 42 spells it (`y := &place`,
  // `y := &mut place`), for the diagnostics.
  sig := if(is_mut, String.from("&mut "), String.from("&"));
  if(is_compile_time_only, {
    exn.throw(
      dyn(
        format_error_message(
          lhs_tok,
          `A local borrow (\`y := ${sig}place\`) aliases runtime storage, so it cannot be a compile-time binding: declare it with \`:=\`, or bind a compile-time value with \`::\`.`
        )
      )
    );
  });
  // Where the binding is declared: in a body. An `io.async` body is one; its
  // state machine keeps the reference, its pin and the place's root in task
  // slots (codegen/exprs/init_assignment.yo `_generate_inout_local_binding`).
  match(
    ctx.is_evaluating_function_body_or_async_block,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            lhs_tok,
            `A local borrow (\`y := ${sig}place\`) is local: declare it inside a function body.`
          )
        )
      );
    },
    .Some(_) => ()
  );
  // The LHS: `mut(name)`, one identifier, and the annotation `T` of
  // `(name : &T) = &place`, which the parse-time rewrite (decision 42) passes
  // as a second argument.
  lhs_args := match(lhs, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  if((lhs_args.len() != usize(1)) && (lhs_args.len() != usize(2)), {
    exn.throw(
      dyn(
        format_error_message(
          lhs_tok,
          `A local borrow binds one name (\`y := ${sig}place\`), got ${lhs_args.len().to_string()} arguments.`
        )
      )
    );
  });
  annotation_e := lhs_args.get(usize(1));
  name_expr := match(lhs_args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
  if(!ast_expr_is_atom(name_expr) || !is_valid_variable_name(name_expr), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(name_expr),
          `A local borrow binds a name (\`y := ${sig}place\`), got ${ast_expr_to_string(name_expr)}.`
        )
      )
    );
  });
  name_tok := ast_expr_token(name_expr);
  var_name := name_tok.value.clone();
  shadow_existing := get_variables_from_env(env, var_name.clone());
  if(shadow_existing.len() > usize(0), {
    match(
      shadow_existing.last(),
      .Some(shadow_var) => {
        sh_entries := ArrayList(TokenAndError).new();
        sh_entries.push(
          TokenAndError(
            token : name_tok,
            error_message : `Failed to define variable "${var_name}":`
          )
        );
        sh_entries.push(
          TokenAndError(
            token : shadow_var.token,
            error_message : `Variable "${var_name}" is already defined here (variable shadowing is not allowed):`
          )
        );
        exn.throw(dyn(format_error_messages(sh_entries)));
      },
      .None => ()
    );
  });
  // The RHS must be a PLACE: an atom, or a `.` chain rooted at one. Checked
  // on the AST before evaluation so the message names the shape, not a type.
  place_recipe := `A local borrow (\`y := ${sig}place\`) needs a place: a variable, or a field path rooted at one (\`x\`, \`h.n\`, \`a.b.c\`). To borrow an ELEMENT of a collection, iterate it with \`for(&mut coll, x => ...)\`; to hold a computed value, bind it with \`:=\` and no sigil.`;
  hops := ArrayList(_InoutPlaceHop).new();
  root_atom := match(
    _inout_place_chain(rhs, hops),
    .Some(r) => r,
    .None => {
      exn.throw(dyn(format_error_message(ast_expr_token(rhs), place_recipe.clone())));
      make_err_expr()
    }
  );
  // A `*` hop is a pointer dereference — an interior place with no owner the
  // binding could pin (§2 P5). Element borrows are the `for` macro's job.
  // …except in privileged code (`pragma(Pragma.AllowUnsafe)` files and
  // compiler-synthesized expansions): the prelude's borrowed `for` binds the
  // element as `x := &mut ptr.*` while the collection is pinned by a hidden
  // local and guarded by the runtime borrow flag (§8 C2/C3). No pin is taken
  // for a deref place — the pointer has no owner the binding could hold.
  rhs_is_privileged := is_implicitly_unsafe_capable_file(Option(String).Some(ast_expr_token(rhs).module_path.clone()));
  // A place through a pointer dereference (the borrowed `for`'s element) is
  // not tracked for exclusivity: its root is the pointer, which the runtime
  // borrow flag on the collection guards.
  (place_has_deref : bool) = false;
  (hi : usize) = usize(0);
  while(hi < hops.len(), {
    match(
      hops.get(hi),
      .Some(hop) => if(ast_expr_is_atom_of(hop.field, "*") && rhs_is_privileged, {
        place_has_deref = true;
      }, if(ast_expr_is_atom_of(hop.field, "*") && !rhs_is_privileged, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(hop.field),
              `A local borrow cannot reach through a pointer dereference (\`p.*\`): the storage has no owner the borrow could keep alive. Iterate the collection with \`for(&mut coll, x => ...)\` to borrow an element, or copy the value out.`
            )
          )
        );
      })),
      .None => ()
    );
    hi = (hi + usize(1));
  });
  root_tok := ast_expr_token(root_atom);
  root_vars := get_variables_from_env(env, root_tok.value.clone());
  if(root_vars.len() == usize(0), {
    exn.throw(dyn(format_error_message(root_tok, `Variable "${root_tok.value}" is not defined.`)));
  });
  root_var := match(root_vars.last(), .Some(v) => v, .None => make_err_variable(env));
  if(root_var.is_compile_time_only, {
    exn.throw(
      dyn(
        format_error_message(
          root_tok,
          `Cannot borrow "${root_tok.value}" (\`${sig}${root_tok.value}\`): it is a compile-time value with no runtime storage to alias.`
        )
      )
    );
  });
  // Evaluate the place as an expression (types for every hop), WITHOUT the
  // dup-on-store a value binding performs — nothing is copied.
  old_expected_type := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  evaluated_rhs := evaluate_expression_raw(rhs, env, ctx, exn);
  ctx.expected_type = old_expected_type;
  rhs_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_rhs)),
    .Some(ri) => ri,
    .None => {
      exn.throw(dyn(format_error_message(ast_expr_token(rhs), `Failed to evaluate, got ${ast_expr_to_string(rhs)}`)));
      new_expr_info(env, t_unit())
    }
  );
  env.frames = rhs_info.env.frames;
  env.module_path = rhs_info.env.module_path;
  env.function_declaration_frame_level = rhs_info.env.function_declaration_frame_level;
  env.input_string = rhs_info.env.input_string;
  prohibit_void_type(rhs_info.ty, ast_expr_token(rhs), exn);
  require_expr_not_consumed(evaluated_rhs, env, ctx, exn);
  // `Type.member` is a namespace access, not storage.
  root_is_type := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(root_atom)),
    .Some(ri) => is_type_value(ri.value),
    .None => false
  );
  if(root_is_type, {
    exn.throw(dyn(format_error_message(root_tok, place_recipe.clone())));
  });
  place_type := rhs_info.ty;
  // A `unit` local has no C storage (its declaration emits nothing), so there
  // is no address to alias; reject instead of lowering `&()`.
  if(is_unit_type(place_type), {
    exn.throw(dyn(format_error_message(ast_expr_token(rhs), `Cannot borrow a unit-typed place (\`${sig}...\`): it has no runtime storage to alias.`)));
  });
  // `(y : &T) = &place`: the annotation names the place's type exactly (a
  // borrow converts nothing).
  match(
    annotation_e,
    .Some(ann) => {
      saved_ann_exp := ctx.expected_type;
      ctx.expected_type = Option(ExpectedTypeCtx).None;
      ev_ann := evaluate_expression_raw(ann, env, ctx, exn);
      ctx.expected_type = saved_ann_exp;
      ann_val := match(expr_info_table_get(ctx.expr_info_table, ast_expr_id(ev_ann)), .Some(ai) => ai.value, .None => Option(EvalValue).None);
      ann_ty := match(
        ann_val,
        .Some(.TypeVal(at)) => at,
        _ => {
          exn.throw(dyn(format_error_message(ast_expr_token(ann), `A local borrow's annotation is a type (\`(y : ${sig}T) = ${sig}place\`), got ${ast_expr_to_string(ann)}.`)));
          t_unit()
        }
      );
      if(!are_types_compatible_exact(place_type, ann_ty), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(rhs),
              `Incompatible types:\n- Expected: ${type_to_string(ann_ty)}\n- Given   : ${type_to_string(place_type)}\nA local borrow \`(y : ${sig}T) = ${sig}place\` lends the place itself, so its type is the annotation's exactly.`
            )
          )
        );
      });
    },
    .None => ()
  );
  if(type_requires_comptime_modifier(place_type), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(rhs),
          `Cannot borrow a value of compile-time-only type "${type_to_string(place_type)}" (\`${sig}...\`): it has no runtime storage to alias.`
        )
      )
    );
  });
  // The PIN (§2 P4): the innermost RC object on the chain — the root itself,
  // or an intermediate hop — owns the storage the binding points into. Hops
  // are collected outermost-first, so hops[len-1] selects a field of the
  // root, hops[len-2] a field of that, …; the receiver of hops[k] is the node
  // of hops[k+1] (or the root atom for the last one). Walk from the field
  // being borrowed toward the root and take the first object receiver.
  (pin_expr : Option(AstExpr)) = Option(AstExpr).None;
  (pin_type : TypeValue) = t_unit();
  (pk : usize) = usize(0);
  while((pk < hops.len()) && pin_expr.is_none(), {
    recv_expr := if(
      (pk + usize(1)) < hops.len(),
      match(hops.get(pk + usize(1)), .Some(h2) => h2.node, .None => make_err_expr()),
      root_atom
    );
    recv_type := if(
      (pk + usize(1)) < hops.len(),
      match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(recv_expr)),
        .Some(ri) => ri.ty,
        .None => t_unit()
      ),
      root_var.ty
    );
    if(is_reference_struct_type(recv_type) || is_atomic_reference_struct_type(recv_type), {
      pin_expr = Option(AstExpr).Some(recv_expr);
      pin_type = recv_type;
    });
    pk = (pk + usize(1));
  });
  // Exclusivity (decision 18): the place, as the local-borrow model sees it.
  // A `mut` binding is an exclusive access of it (E0911 against a live
  // borrow of an overlapping place), and may not go through an `imm` borrow
  // (E0908); an `imm` binding is a read, which evaluating the place above
  // already checked.
  (lb_place : Option(LocalBorrowPlace)) = cond(
    place_has_deref => Option(LocalBorrowPlace).None,
    true => local_borrow_place_of(evaluated_rhs, env, ctx)
  );
  if(is_mut, {
    match(
      lb_place,
      .Some(lp) => {
        local_borrow_require_writable(lp, `borrow \`${local_borrow_place_text(rhs)}\` with \`&mut\``, ast_expr_token(rhs), ctx, exn);
        local_borrow_access(lp, LocalBorrowAccess.Exclusive, ast_expr_token(rhs), ctx, exn);
      },
      .None => ()
    );
  });
  // Register the pin as a hidden OWNING local: the existing named-local
  // machinery dups it at the binding (codegen) and drops it at scope end —
  // on `break`, `return` and effect `unwind` alike (§8 B4).
  (pin_var : Option(Variable)) = Option(Variable).None;
  match(
    pin_expr,
    .Some(pp) => {
      pp_tok := ast_expr_token(pp);
      pin_name := generate_new_temp_variable_name(env.module_path, usize(pp_tok.row), usize(pp_tok.column), .None, .Some(pp_tok.module_path));
      pin_var = add_variable_to_env(env, pin_name, pin_type, Option(EvalValue).None, false, false, true, false, name_tok);
    },
    .None => ()
  );
  // The binding itself.
  bound_opt := add_variable_to_env(env, var_name.clone(), place_type, Option(EvalValue).None, false, true, false, false, name_tok);
  match(
    bound_opt,
    .Some(bound) => {
      bound.is_ref = true;
      variable_set_inout_borrow_root_id(bound, root_var.id);
      if(hops.len() == usize(0), {
        // Whole-variable place: alias the root's value cell so compile-time
        // reads through the binding observe the root (§9 H27).
        bound.value = root_var.value;
      });
    },
    .None => ()
  );
  variable_mark_inout_borrow_root(root_var);
  // The live range (decision 18: it ends at the last use, Hylo's rule) and,
  // when a later statement re-points the borrow, the hidden owning local
  // that holds the cell a re-point steps into (decision 25). Its type is the
  // cell's, set by the first re-point that enters one; until then it is
  // `unit`, which nothing declares or drops.
  match(
    lb_place,
    .Some(lp) => {
      range := local_borrow_range_of(expr, var_name.clone(), name_tok);
      (step_pin : Option(Variable)) = Option(Variable).None;
      if(range.has_repoint, {
        sp_name := generate_new_temp_variable_name(env.module_path, usize(name_tok.row), usize(name_tok.column), .None, .Some(name_tok.module_path));
        step_pin = add_variable_to_env(env, sp_name, t_unit(), Option(EvalValue).None, false, true, true, false, name_tok);
        match(step_pin, .Some(spv) => record_local_borrow_step_pin(ast_expr_id(lhs), spv), .None => ());
      });
      _info := local_borrow_register(var_name.clone(), name_tok, is_mut, lp, range, step_pin);
    },
    .None => ()
  );
  // ExprInfos: the name atom (typed as the place), the `inout(name)` node
  // (the pin channel), and the `:=` node (unit).
  name_info := new_expr_info(env, place_type);
  name_info.path_collection = path_collection_new();
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(name_expr), name_info);
  scope_release_note_binding(ast_expr_id(name_expr), env, var_name.clone());
  lhs_info := new_expr_info(env, t_unit());
  lhs_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
  match(
    pin_var,
    .Some(pv) => {
      lhs_info.source_variable = Option(Variable).Some(pv);
      expr_info_set_macro_expansion(lhs_info, pin_expr);
    },
    .None => ()
  );
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(lhs), lhs_info);
  expr_info := new_expr_info(env, t_unit());
  expr_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
  expr_info_set_is_compile_time_only_assignment(expr_info, Option(bool).Some(false));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), expr_info);
  expr
});
/// `cur = &place` / `cur = &mut place`: re-point the local borrow `cur`
/// to `place` (plans/VALUES_BY_DEFAULT.md decision 25, the cursor walk).
///
/// `place` must be reached from `cur`: a field chain rooted at `cur` itself,
/// or one rooted at a `match` binding over `cur` that enters a reference
/// cell (a `match` binding is a copy of the matched value until decision 26's
/// place bindings, so only a cell it points to is shared with `cur`'s
/// target). Anything else is rejected: a sibling root, a module-level place,
/// a call or index (a projection could yield any place the callee reaches).
/// The step through a cell pins it in the binding's step pin, releasing the
/// cell the previous step pinned (decision 25, "Through an `Rc`"). The
/// declared place stays frozen for `cur`'s whole live range, and a `match`
/// binding the re-point went through is frozen while `cur` is live. A
/// re-point is E0911 while a borrow derived from `cur`'s current target is
/// live (decision 38 A).
///
/// Codegen channel (init_assignment.yo `generate_local_borrow_repoint`): the
/// `mut(cur)` node's ExprInfo carries the step: `source_variable` = the step
/// pin, `macro_expansion` = the cell expression it takes.
evaluate_local_borrow_repoint :: (fn(expr : &AstExpr, env_in : &Environment, ctx : &EvalContext, exn : &Exception) -> AstExpr)({
  (env : Environment) = env_in;
  args := match(expr, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  lhs := match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
  rhs := match(args.get(usize(1)), .Some(a) => a, .None => make_err_expr());
  lhs_tok := ast_expr_token(lhs);
  is_mut := ast_expr_is_inout_mode_call(lhs, .None);
  sig := if(is_mut, String.from("&mut "), String.from("&"));
  lhs_args := match(lhs, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  name_expr := match(lhs_args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
  if((lhs_args.len() != usize(1)) || !ast_expr_is_atom(name_expr), {
    exn.throw(dyn(format_error_message(lhs_tok, `A re-point names the local borrow it moves (\`cur = ${sig}place\`).`)));
  });
  name_tok := ast_expr_token(name_expr);
  name := name_tok.value.clone();
  cur_var := match(
    get_variables_from_env(env, name.clone()).last(),
    .Some(v) => v,
    .None => {
      exn.throw(dyn(format_error_message(name_tok, `Variable "${name}" is not defined.`)));
      make_err_variable(env)
    }
  );
  info := match(
    local_borrow_info_of_variable(cur_var),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message_with_help(
            name_tok,
            `\`${name} = ${sig}place\` re-points a local borrow, and \`${name}\` is not one.`,
            Option(String).Some(`declare it with \`${name} := ${sig}place\` first; to write the value \`${name}\` holds, write \`${name} = value\` without the sigil`)
          )
        )
      );
      local_borrow_info_placeholder(name.clone(), name_tok)
    }
  );
  if(info.is_mut != is_mut, {
    decl_mode := cond(info.is_mut => "&mut", true => "&");
    decl_sig := cond(info.is_mut => "&mut ", true => "&");
    exn.throw(
      dyn(
        format_error_message_with_help(
          lhs_tok,
          `\`${name}\` is a \`${decl_mode}\` borrow, so a re-point keeps that mode.`,
          Option(String).Some(`write \`${name} = ${decl_sig}place\``)
        )
      )
    );
  });
  // The re-point uses the borrow: evaluate its name (codegen reads the
  // pointer from it).
  _evaluated_name := evaluate_expression_raw(name_expr, env, ctx, exn);
  // The new target: a field chain rooted at a variable.
  not_reached := `A re-point must name a place reached from \`${name}\`: a field of \`${name}\`'s target (\`${name} = ${sig}${name}.next\`), or a field of a \`match\` binding over \`${name}\` that enters a reference cell (\`match(${name}, .Some(n) => { ${name} = ${sig}n.next; }, .None => ())\`).`;
  hops := ArrayList(_InoutPlaceHop).new();
  root_atom := match(
    _inout_place_chain(rhs, hops),
    .Some(r) => r,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(rhs),
            `Cannot re-point \`${name}\` to \`${local_borrow_place_text(rhs)}\`: it is not a field path. A call or an index yields whatever place its callee reaches, so it is not known to be reached from \`${name}\`. ${not_reached}`
          )
        )
      );
      make_err_expr()
    }
  );
  (hi : usize) = usize(0);
  while(hi < hops.len(), {
    match(
      hops.get(hi),
      .Some(hop) => if(ast_expr_is_atom_of(hop.field, "*"), {
        exn.throw(dyn(format_error_message(ast_expr_token(hop.field), `Cannot re-point \`${name}\` through a pointer dereference ('p.*'). ${not_reached}`)));
      }),
      .None => ()
    );
    hi = (hi + usize(1));
  });
  old_expected_type := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  evaluated_rhs := evaluate_expression_raw(rhs, env, ctx, exn);
  ctx.expected_type = old_expected_type;
  rhs_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_rhs)),
    .Some(ri) => ri,
    .None => {
      exn.throw(dyn(format_error_message(ast_expr_token(rhs), `Failed to evaluate, got ${ast_expr_to_string(rhs)}`)));
      new_expr_info(env, t_unit())
    }
  );
  env.frames = rhs_info.env.frames;
  env.module_path = rhs_info.env.module_path;
  env.function_declaration_frame_level = rhs_info.env.function_declaration_frame_level;
  env.input_string = rhs_info.env.input_string;
  if(!are_types_compatible(rhs_info.ty, cur_var.ty), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(rhs),
          `Cannot re-point \`${name}\` to \`${local_borrow_place_text(rhs)}\`: \`${name}\` borrows a place of type ${type_to_string(cur_var.ty)}, and this place has type ${type_to_string(rhs_info.ty)}.`
        )
      )
    );
  });
  root_tok := ast_expr_token(root_atom);
  root_var := match(
    get_variables_from_env(env, root_tok.value.clone()).last(),
    .Some(v) => v,
    .None => {
      exn.throw(dyn(format_error_message(root_tok, `Variable "${root_tok.value}" is not defined.`)));
      make_err_variable(env)
    }
  );
  place := match(
    local_borrow_place_of(evaluated_rhs, env, ctx),
    .Some(p) => p,
    .None => {
      exn.throw(dyn(format_error_message(ast_expr_token(rhs), `Cannot re-point \`${name}\` to \`${local_borrow_place_text(rhs)}\`. ${not_reached}`)));
      local_borrow_place_of_variable(root_var)
    }
  );
  is_self := ((root_var.name == info.name) && ((root_var.token.character == info.decl.character) && (root_var.token.module_path == info.decl.module_path)));
  via_pattern := (
    !is_self && match(
      local_borrow_pattern_source(root_var.name.clone(), root_var.token),
      .Some(src) => ((src.name == info.name) && ((src.decl.character == info.decl.character) && (src.decl.module_path == info.decl.module_path))),
      .None => false
    )
  );
  if(!is_self && !via_pattern, {
    what := cond(
      root_var.is_module_level => `\`${root_var.name}\` is a module-level binding`,
      true => `\`${root_var.name}\` is a different variable, not a place reached from \`${name}\``
    );
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(rhs),
          `Cannot re-point \`${name}\` to \`${local_borrow_place_text(rhs)}\`: ${what}. ${not_reached}`
        )
      )
    );
  });
  if(via_pattern && !place.through_cell, {
    exn.throw(
      dyn(
        format_error_message_with_help(
          ast_expr_token(rhs),
          `Cannot re-point \`${name}\` to \`${local_borrow_place_text(rhs)}\`: \`${root_var.name}\` is a \`match\` binding over \`${name}\`, and a \`match\` binding holds a copy of the matched value, so this place would die with the arm. Only a reference cell the binding points to is shared with \`${name}\`'s target.`,
          Option(String).Some(`re-point through a cell (\`${root_var.name}.next\` where \`${root_var.name}\` is an \`Rc\` or \`ref\` object), or through \`${name}\` itself (\`${name} = ${sig}${name}.next\`). Binding the matched place itself comes with \`&mut\` scrutinees (decision 26).`)
        )
      )
    );
  });
  // Decision 38 A: no borrow derived from the current target may be live.
  local_borrow_require_no_live_derived(info, lhs_tok, ctx, exn);
  // The step's cell: the innermost reference cell on the chain.
  (pin_expr : Option(AstExpr)) = Option(AstExpr).None;
  (pin_type : TypeValue) = t_unit();
  (pk : usize) = usize(0);
  while((pk < hops.len()) && pin_expr.is_none(), {
    recv_expr := if(
      (pk + usize(1)) < hops.len(),
      match(hops.get(pk + usize(1)), .Some(h2) => h2.node, .None => make_err_expr()),
      root_atom
    );
    recv_type := match(expr_info_table_get(ctx.expr_info_table, ast_expr_id(recv_expr)), .Some(ri) => ri.ty, .None => root_var.ty);
    if(is_reference_struct_type(recv_type) || is_atomic_reference_struct_type(recv_type), {
      pin_expr = Option(AstExpr).Some(recv_expr);
      pin_type = recv_type;
    });
    pk = (pk + usize(1));
  });
  (step_pin : Option(Variable)) = Option(Variable).None;
  match(
    pin_expr,
    .Some(_) => {
      sp := match(
        info.step_pin,
        .Some(p) => p,
        .None => {
          exn.throw(dyn(format_error_message(lhs_tok, `Cannot re-point \`${name}\` here: a re-point must be in the block that declares \`${name}\`, or a block nested in it.`)));
          make_err_variable(env)
        }
      );
      if(is_unit_type(sp.ty), {
        sp.ty = pin_type;
      }, {
        if(!are_types_compatible(pin_type, sp.ty), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(rhs),
                `Cannot re-point \`${name}\` into a ${type_to_string(pin_type)} cell: an earlier re-point of \`${name}\` steps into ${type_to_string(sp.ty)} cells, and the one cell a step holds has one type.`
              )
            )
          );
        });
      });
      step_pin = Option(Variable).Some(sp);
    },
    .None => ()
  );
  // A `match` binding the re-point went through stays frozen while `cur` is
  // live; a step through a cell is what rule 4 keys on.
  if(via_pattern, {
    info.places.push(place);
  });
  if(place.through_cell, {
    info.crosses_cell = true;
  });
  variable_mark_inout_borrow_root(root_var);
  lhs_info := new_expr_info(env, t_unit());
  lhs_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
  match(
    step_pin,
    .Some(spv) => {
      lhs_info.source_variable = Option(Variable).Some(spv);
      expr_info_set_macro_expansion(lhs_info, pin_expr);
    },
    .None => ()
  );
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(lhs), lhs_info);
  expr_info := new_expr_info(env, t_unit());
  expr_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
  expr_info_set_is_compile_time_only_assignment(expr_info, Option(bool).Some(false));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), expr_info);
  expr
});
/// `.V` or `.V(…)` on the right of `:=` — see `local_variant_hint`.
_rhs_is_bare_variant_literal :: (fn(e : &AstExpr) -> bool)({
  head_ok := (fn(h : &AstExpr) -> bool)(
    ast_expr_is_fn_call_of(h, BF_DOT, Option(usize).Some(usize(1))) && match(
      h,
      .FnCall(_, _, hargs, _, _) => match(hargs.get(usize(0)), .Some(a) => ast_expr_is_atom(a), .None => false),
      .Atom(_, _) => false
    )
  );
  cond(
    head_ok(e) => true,
    true => match(
      e,
      .FnCall(_, func, _, _, _) => head_ok(func),
      .Atom(_, _) => false
    )
  )
});
evaluate_initialization_assignment :: (
  fn(
    expr : &AstExpr,
    env_in : &Environment,
    ctx : &EvalContext,
    exn : &Exception
  ) -> AstExpr
)({
  (env : Environment) = env_in;
  // Validate shape.
  is_const := ast_expr_is_fn_call_of(expr, BK_CONST, .Some(usize(2)));
  is_init_assign := ast_expr_is_fn_call_of(expr, BK_INIT_ASSIGN, .Some(usize(2)));
  if(!(is_const || is_init_assign), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Expected \":=\" or \"::\" for initialization assignment.")
        )
      )
    );
  });
  // Extract lhs and rhs from args.
  (lhs : AstExpr) = match(
    expr,
    .FnCall(_, _, args, _, _) => match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr()),
    .Atom(_, _) => make_err_expr()
  );
  (rhs : AstExpr) = match(
    expr,
    .FnCall(_, _, args, _, _) => match(args.get(usize(1)), .Some(a) => a, .None => make_err_expr()),
    .Atom(_, _) => make_err_expr()
  );
  // `name := rhs` and `name := &mut place` declare RUNTIME storage, so
  // neither can appear in a compile-time context: the body of a function
  // declared to return a compile-time value (E1104,
  // issues/fixed/colon-equals-is-accepted-in-a-compile-time-context.md).
  // `comptime(name) := rhs` and `given(name) := rhs` are compile-time forms
  // and stay legal. Checked before `force_compile_time_bindings` is consulted:
  // that flag is set for every compile-time body evaluation and used to turn
  // the `:=` into a `::` silently.
  // `imm(name) := place` / `mut(name) := place` / `inout(name) := place`
  // (and the `::` forms): the deleted spellings of `name := &place` /
  // `name := &mut place` (decision 42 Generation B), E0009.
  reject_old_mode_spelling(lhs, exn);
  is_comptime_wrapped := ast_expr_is_fn_call_of(lhs, BK_COMPTIME, .Some(usize(1)));
  if(is_init_assign && !(is_comptime_wrapped || ast_expr_is_fn_call_of(lhs, BK_GIVEN, .None)) && in_compile_time_fn_body(ctx), {
    if(ast_expr_is_local_borrow_mode_call(lhs, .None), {
      exn.throw(
        dyn(
          with_code(
            format_error_message(
              ast_expr_token(expr),
              String.from("A local borrow (`y := &place`, `y := &mut place`) binds a reference to runtime storage, but this is the body of a function that returns a compile-time value, which has none; read and assign the compile-time variable directly.")
            ),
            E_COMPTIME_RUNTIME_BINDING
          )
        )
      );
    });
    exn.throw(
      dyn(
        with_code(
          format_error_message_with_repair(
            ast_expr_token(expr),
            String.from("`:=` declares a runtime variable, but this is the body of a function that returns a compile-time value; declare the local with `::` (it is still mutable)."),
            Option(String).Some(String.from("replace `:=` with `::`")),
            String.from("::"),
            String.from("declare the local with `::`")
          ),
          E_COMPTIME_RUNTIME_BINDING
        )
      )
    );
  });
  // A RUNTIME function evaluated at compile time (a `comptime_fn` clone, CTFE
  // capability analysis) runs under `force_compile_time_bindings`; its `:=`
  // locals are stored as compile-time values there.
  is_compile_time_only := (is_const || ctx.force_compile_time_bindings);
  // For type conversion purposes, only `::` suppresses comptime→runtime
  // conversion; `:=` with forceCompileTimeBindings still converts.
  should_convert_to_runtime_type := !is_const;
  // Detect given(name) wrapper on LHS for implicit parameter declaration.
  (is_implicit : bool) = false;
  (actual_lhs : AstExpr) = lhs;
  // `comptime(name) := rhs` is the compile-time spelling of `:=` (DESIGN.md
  // "Variables"): it binds `name` exactly like `name :: rhs`. It used to fall
  // through to the destructuring branch and fail with "Destructuring
  // assignment not supported for the right-hand type"
  // (issues/fixed/comptime-name-colon-equals-is-parsed-as-destructuring.md).
  if(is_comptime_wrapped, {
    is_compile_time_only = true;
    should_convert_to_runtime_type = false;
    actual_lhs = match(
      lhs,
      .FnCall(_, _, cargs, _, _) => match(cargs.get(usize(0)), .Some(a) => a, .None => make_err_expr()),
      .Atom(_, _) => make_err_expr()
    );
  });
  // `name := &mut place` — a LOCAL second-class reference binding
  // (plans/archive/INOUT_LOCAL_BINDINGS_AUDIT.md §7–§8, Phase B). Variables and
  // field places only; element borrows go through the `for` macro.
  // `name := &place` is the read-only local borrow (decision 18).
  if(ast_expr_is_fn_call(lhs) && ast_expr_is_local_borrow_mode_call(lhs, .None), {
    return(_evaluate_inout_local_binding(expr, lhs, rhs, is_compile_time_only, env, ctx, exn));
  });
  if(ast_expr_is_fn_call(lhs) && ast_expr_is_fn_call_of(lhs, BK_GIVEN, .None), {
    n_given_args := match(
      lhs,
      .FnCall(_, _, gargs, _, _) => gargs.len(),
      .Atom(_, _) => usize(0)
    );
    if(n_given_args != usize(1), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(lhs),
            `Expected exactly one argument for "given", got ${n_given_args.to_string()}`
          )
        )
      );
    });
    is_implicit = true;
    actual_lhs = match(
      lhs,
      .FnCall(_, _, gargs, _, _) => match(gargs.get(usize(0)), .Some(a) => a, .None => make_err_expr()),
      .Atom(_, _) => make_err_expr()
    );
  });
  // `thread_local(name) := init;` — the inferred form of a module-level
  // thread-local. The modifier wraps the NAME, like `given(name)` directly
  // above and like `comptime(v)` on a parameter; the typed form
  // `(thread_local(name) : T) = init` is stripped in
  // evaluator/exprs/assignment.yo.
  //
  // The AST is rewritten, not just `actual_lhs`: `anonymous_module.yo` records
  // a module-level init expr only when the `:=` LHS is an ATOM, and
  // `_module_init_var_atom` (codegen) resolves the declared atom the same way,
  // so leaving the modifier in the tree emits reads through an accessor that
  // nothing declares.
  (is_thread_local_decl : bool) = false;
  if(ast_expr_is_fn_call(lhs) && ast_expr_is_fn_call_of(lhs, BK_THREAD_LOCAL, .None), {
    n_tl_args := match(lhs, .FnCall(_, _, targs, _, _) => targs.len(), .Atom(_, _) => usize(0));
    if(n_tl_args != usize(1), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(lhs),
            `Expected exactly one argument for "thread_local", got ${n_tl_args.to_string()}`
          )
        )
      );
    });
    tl_atom := match(
      lhs,
      .FnCall(_, _, targs, _, _) => match(targs.get(usize(0)), .Some(a) => a, .None => make_err_expr()),
      .Atom(_, _) => make_err_expr()
    );
    if(!ast_expr_is_atom(tl_atom), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(lhs),
            `"thread_local" takes the variable NAME: write "thread_local(name) := init;" or "(thread_local(name) : T) = init;".`
          )
        )
      );
    });
    is_thread_local_decl = true;
    actual_lhs = tl_atom;
    match(
      expr,
      .FnCall(_, _, ia_args, _, _) => {
        ia_args(usize(0)) = tl_atom;
      },
      .Atom(_, _) => ()
    );
  });
  // Prevent declaring variable type using :: or :=.
  if(ast_expr_is_fn_call(actual_lhs) && ast_expr_is_fn_call_of(actual_lhs, BK_COLON, .None), {
    op_str := ast_expr_token(expr).value.clone();
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(actual_lhs),
          `Unexpected use of ":" in type declaration with "${op_str}". Please consider using "=":
(${ast_expr_to_string(actual_lhs)}) = ${ast_expr_to_string(rhs)}`
        )
      )
    );
  });
  // Evaluate the rhs expression.
  // Save/restore context fields that are locally overridden.
  old_expected_type := ctx.expected_type;
  old_is_inside_given_handler := ctx.is_inside_given_handler;
  // A bare `.Variant(…)` right-hand side — or an `io.async(…)` call whose
  // future the local returns (the call-side machinery unwraps the function's
  // `Impl(Future(T, E))` result and pre-binds `T`, giving the closure's
  // `.Variant` tail its expected enum) — takes the block's look-ahead hint
  // (the enclosing function's result type, when a later statement returns
  // this local) as its expected type; every other RHS is evaluated without
  // one, as before. The hint is one-shot.
  variant_hint := ctx.local_variant_hint;
  ctx.local_variant_hint = Option(ExpectedTypeCtx).None;
  ctx.expected_type = cond(
    (variant_hint.is_some() && (_rhs_is_bare_variant_literal(rhs) || is_io_async_call(rhs))) => variant_hint,
    true => Option(ExpectedTypeCtx).None
  );
  if(is_implicit, {
    ctx.is_inside_given_handler = true;
  });
  // Use the exn-threading (raw) evaluator so a compile error in the rhs
  // propagates to the caller's handler instead of being caught, printed,
  // and swallowed by the non-raw `_evaluate_expression_wrapper` (which then
  // continues with a placeholder expr). In particular this lets a test
  // body's trial-evaluation swallow (see `evaluate_test`) actually catch
  // errors raised while evaluating a `:=` rhs.
  rhs = evaluate_expression_raw(rhs, env, ctx, exn);
  ctx.expected_type = old_expected_type;
  ctx.is_inside_given_handler = old_is_inside_given_handler;
  // Update env from the evaluated rhs.
  rhs_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs));
  match(
    rhs_info_opt,
    .Some(rhs_info) => {
      env.frames = rhs_info.env.frames;
      env.module_path = rhs_info.env.module_path;
      env.function_declaration_frame_level = rhs_info.env.function_declaration_frame_level;
      env.input_string = rhs_info.env.input_string;
    },
    .None => ()
  );
  // Prohibit void rhs type.
  match(
    rhs_info_opt,
    .Some(rhs_info) => {
      prohibit_void_type(rhs_info.ty, ast_expr_token(rhs), exn);
    },
    .None => ()
  );
  // §4 escape boundary 2 (algebraic-effect ctl rules): a module-level binding
  // type cannot be control-bound. Module-level bindings outlive every call
  // frame, so a stored `ctl(...)` handler (or an aggregate / pointer containing
  // one) would be invokable long after its install frame has returned, where it
  // would `unwind` to a dead frame.
  match(
    rhs_info_opt,
    .Some(rhs_info) => {
      is_at_module_level := match(
        ctx.is_evaluating_function_body_or_async_block,
        .Some(_) => false,
        .None => true
      );
      if(is_at_module_level && type_is_control_bound(rhs_info.ty), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(rhs),
              `Cannot bind a value whose type is control-bound (transitively contains a \`ctl(...) -> ret\` function type) at module level. Module-level bindings outlive every call frame; invoking the contained control-function later would unwind to a dead frame.

Bound type: ${type_to_string(rhs_info.ty)}`
            )
          )
        );
      });
    },
    .None => ()
  );
  // Reject rhs that unconditionally transfers control flow.
  match(
    rhs_info_opt,
    .Some(rhs_info) => {
      if(has_any_control_flow(rhs_info.control_flow), {
        match(
          rhs_info.control_flow,
          .Some(cf) => throw_rhs_contains_control_flow_expression_error(rhs, cf, exn),
          .None => ()
        );
      });
    },
    .None => ()
  );
  // Disallow implicit variables as the RHS of non-given assignment.
  throw_expr_is_implicit_variable_error(rhs, env, ctx, exn);
  // --------------------------------------------------------------------------
  // Branch: atom LHS vs destructuring LHS
  // --------------------------------------------------------------------------
  if(ast_expr_is_atom(actual_lhs), {
    // -------------------------------------------------------------------
    // Atom LHS: `name := rhs`
    // -------------------------------------------------------------------
    // Check if the RHS variable has been consumed (moved).
    require_expr_not_consumed(rhs, env, ctx, exn);
    // Insert dup-on-store (transfers/shares RC ownership of the RHS). A
    // binding a macro introduced (`for`'s gensym'd collection pin) carries
    // the macro's module in its name token, not the user's.
    set_expr_as_needs_to_call_dup(rhs, ctx, exn, cond((!audit_pending_copies_enabled() || (ast_expr_token(actual_lhs).module_path == ast_expr_token(rhs).module_path)) => "binding", true => "binding(macro)"));
    // Re-read env in case set_expr_as_needs_to_call_dup updated it.
    match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs)),
      .Some(ri) => {
        env.frames = ri.env.frames;
        env.module_path = ri.env.module_path;
        env.function_declaration_frame_level = ri.env.function_declaration_frame_level;
        env.input_string = ri.env.input_string;
      },
      .None => ()
    );
    // Validate LHS name.
    if(!is_valid_variable_name(actual_lhs), {
      lhs_tok_val := ast_expr_token(actual_lhs).value.clone();
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(actual_lhs),
            `Invalid assignment to ${lhs_tok_val}, expected identifier or operator`
          )
        )
      );
    });
    // Reserved operators cannot be bound or overloaded
    // (plans/reference/OPERATOR_SET_AND_PRECEDENCE.md Part 1). Twin gate:
    // `name : Type` bindings are checked in binding.yo.
    res_tok := ast_expr_token(actual_lhs);
    if((res_tok.kind == TokenKind.Operator) && is_reserved_operator_name(res_tok.value.clone()), {
      exn.throw(
        dyn(
          format_error_message(
            res_tok,
            `Operator "${res_tok.value}" is reserved and cannot be bound or overloaded (plans/reference/OPERATOR_SET_AND_PRECEDENCE.md).`
          )
        )
      );
    });
    // Twin of the operator rule for plain-named BUILTINS (see binding.yo's
    // gate): `consume`/`runtime`/`recur`/`dyn` are call-dispatch names — a
    // user binding is silently hijacked and can never run. This covers `::`
    // definitions (including bare functions), typed `(x : T) =` and `:=`.
    if(is_reserved_builtin_binding_name(res_tok.value.clone()) && !res_tok.module_path.ends_with(String.from("std/prelude.yo")), {
      raise_flow_violation(
        format_error_message(
          res_tok,
          reserved_builtin_binding_message(res_tok.value.clone())
        ),
        ctx,
        exn
      );
    });
    effective_is_compile_time_only := (is_implicit || is_compile_time_only);
    effective_should_convert_to_runtime := (!is_implicit && should_convert_to_runtime_type);
    // Determine the LHS type.
    rhs_type_opt := match(
      rhs_info_opt,
      .Some(ri) => Option(TypeValue).Some(ri.ty),
      .None => Option(TypeValue).None
    );
    actual_lhs_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(actual_lhs));
    // Check if the user pre-annotated the LHS with a type (via `(x : T) := rhs`).
    has_predefined_type := match(
      actual_lhs_info_opt,
      .Some(ali) => (match(ali.value, .Some(_) => true, .None => false) || (type_value_tag(ali.ty) != TypeTag.TUnit)),
      .None => false
    );
    // More precise: check whether ExprInfo was created with a type annotation —
    // if ExprInfo for actual_lhs has a non-unit type we treat it as pre-annotated.
    (lhs_type : TypeValue) = match(
      rhs_type_opt,
      .Some(rt) => rt,
      .None => t_unit()
    );
    if(!has_predefined_type, {
      // User did not annotate a type — infer from RHS.
      match(
        rhs_type_opt,
        .None => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(rhs),
                `Failed to evaluate, got ${ast_expr_to_string(rhs)}`
              )
            )
          );
        },
        .Some(rt) => {
          lhs_type = rt;
          if(effective_should_convert_to_runtime, {
            lhs_type = convert_comptime_type_to_runtime_type(rt, env);
          });
          // Set ExprInfo for actual_lhs.
          new_ali := new_expr_info(env, lhs_type);
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(actual_lhs), new_ali);
        }
      );
    }, {
      // User annotated a type — synthesize and check compatibility.
      pre_type := match(
        actual_lhs_info_opt,
        .Some(ali) => ali.ty,
        .None => t_unit()
      );
      synth := synthesize_expr_and_type(rhs, pre_type, env, ctx);
      rhs = synth.expr;
      rhs_type_opt = Option(TypeValue).Some(synth.ty);
      env.frames = synth.env.frames;
      env.module_path = synth.env.module_path;
      env.function_declaration_frame_level = synth.env.function_declaration_frame_level;
      env.input_string = synth.env.input_string;
      // Re-read rhs_info for the updated rhs.
      rhs_info_opt = expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs));
      // Check type compatibility.
      if(!are_types_compatible(synth.ty, pre_type), {
        pre_ty_str := type_to_string(pre_type);
        rhs_ty_str := type_to_string(synth.ty);
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(actual_lhs),
              `Incompatible types:
- Defined: ${pre_ty_str}
- Given  : ${rhs_ty_str}${dyn_upcast_note(pre_type, synth.ty)}`
            )
          )
        );
      });
      // A `comptime_int` VALUE (a folded `(200 + 100)`, a `::` constant)
      // bound to a fixed-width integer must fit it; the widening above is
      // value-blind, and the C constant truncated silently
      // (issues/fixed/context-typed-integer-literal-is-not-range-checked.md).
      match(
        rhs_info_opt,
        .Some(ri_ct) => if(is_comptime_int_type(ri_ct.ty), {
          match(
            ri_ct.value,
            .Some(ri_ctv) => match(ri_ctv, .IntLit(ri_raw) => check_comptime_int_value_fits(ri_raw, pre_type, ast_expr_token(rhs), exn), _ => ()),
            .None => ()
          );
        }),
        .None => ()
      );
      lhs_type = pre_type;
    });
    // Check comptime modifier requirements. The tag-only helper misses
    // COMPOUND comptime-only types (a struct whose fields are all
    // comptime_int, e.g. basic.test.yo's Point2); use the env-aware
    // derivation (implements comptime && !implements runtime, with the
    // auto-derive recursion) as the fallback after the cheap tag path.
    lhs_requires_ct := (type_requires_comptime_modifier(lhs_type) || (type_implements_comptime(lhs_type, env) && !type_implements_runtime_full(lhs_type, env)));
    // In a DEFINITION-time body trial a type still carrying unresolved
    // SomeTs cannot be judged comptime-only (the trait check is
    // optimistic on SomeTypes, so
    // `Option(T')` from an abstract cross-impl dispatch wrongly demanded
    // `::` — the ::-vs-:= layer of roots 797/616/7905,
    // issues/fixed/def-eval-swallow-remaining-roots.md). Skip; the
    // specialization-time re-eval re-checks with concrete types.
    lhs_ct_check := cond(
      (in_def_time_trial() && lhs_requires_ct && (get_all_some_types(lhs_type).len() > usize(0))) => false,
      true => lhs_requires_ct
    );
    if(!effective_is_compile_time_only && lhs_ct_check, {
      lhs_type_str := type_to_string(lhs_type);
      expr_str := ast_expr_to_string(expr);
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `Expected "::" instead of ":=" for compile-time known value assignment:
${expr_str}

Type:
${lhs_type_str}`
          )
        )
      );
    });
    if(effective_is_compile_time_only && type_prohibits_comptime_modifier(lhs_type), {
      lhs_type_str := type_to_string(lhs_type);
      expr_str := ast_expr_to_string(expr);
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `Expected ":=" instead of "::" for value type "${lhs_type_str}" which can only be used at the runtime:
${expr_str}`
          )
        )
      );
    });
    // Get RHS compile-time value.
    rhs_value_opt := match(
      rhs_info_opt,
      .Some(ri) => ri.value,
      .None => Option(EvalValue).None
    );
    // Reject runtime value for a compile-time-only declaration.
    // A runtime CALL result is stored as a RUNTIME-ONLY UnknownVal placeholder
    // (`_call_result_unknown`, calls/function.yo) — "no value here" in
    // value.yo's terms — so the gate
    // rejects BOTH no-value and runtime-only-unknown. Without this,
    // `r :: runt_id(n)` was silently accepted (tests/fn.test.yo arm 12's
    // comptime_expect_error never saw an error and hollowed the batch).
    rhs_has_no_ct_value := match(
      rhs_value_opt,
      .Some(_rv) => is_runtime_only_unknown_val(_rv),
      .None => true
    );
    if(rhs_has_no_ct_value && effective_is_compile_time_only, {
      lhs_tok_val := ast_expr_token(actual_lhs).value.clone();
      rhs_str := ast_expr_to_string(rhs);
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(actual_lhs),
            `Expected compile-time value for "${lhs_tok_val}".
Got runtime value. Please consider using ":=" instead of "::":
${rhs_str}`
          )
        )
      );
    });
    // typeName stamping at `::` binding: `str :: newtype(...)` names the
    // struct "str", `Color :: enum(...)` names the enum, etc. TypeValues
    // are value-typed, so rebuild the TypeVal with the binding name filled
    // (only when the current name is empty) before storing. Without this, name-keyed
    // checks — e.g. panic's `typeName === "str"` — can never
    // match; under propagated def-eval the prelude's `assert` failed on it
    // and cascaded across 96 std files.
    stamped_rhs_value_opt := match(
      rhs_value_opt,
      .Some(rv) => match(
        rv,
        .TypeVal(tv_box) => {
          binding_name := ast_expr_token(actual_lhs).value.clone();
          stamped_ty := match(
            tv_box,
            // The binding name is also the id's display name, so a copy that
            // still has no name — a recursive type's self-shell, which an
            // enum marks with a `__self_shell` id suffix — prints as the
            // type, not as its internal id.
            .Struct({ id : st_id, name : st_name, field_labels : st_fls, field_types : st_fts, is_reference_semantics : st_ref, is_atomic_rc : st_at, is_newtype : st_nt, constructor_func_id : st_cfid, type_arguments : st_ta, is_source_namespace : st_sns }) => cond(
              (st_name.len() == usize(0)) => {
                register_type_display_name(st_id.clone(), binding_name.clone());
                register_type_binding_name(st_id.clone(), binding_name.clone());
                Option(TypeValue).Some(
                  TypeValue.Struct(st_id, binding_name, st_fls, st_fts, st_ref, st_at, st_nt, st_cfid, st_ta, st_sns)
                )
              },
              true => Option(TypeValue).None
            ),
            .EnumT(en_id, en_name, en_vns, en_vfs, en_sel, en_vfl, en_vd, en_irs, en_iar, en_tas) => cond(
              (en_name.len() == usize(0)) => {
                register_type_display_name(en_id.clone(), binding_name.clone());
                register_type_display_name(`${en_id}__self_shell`, binding_name.clone());
                register_type_binding_name(en_id.clone(), binding_name.clone());
                register_type_binding_name(`${en_id}__self_shell`, binding_name.clone());
                Option(TypeValue).Some(
                  TypeValue.EnumT(en_id, binding_name, en_vns, en_vfs, en_sel, en_vfl, en_vd, en_irs, en_iar, en_tas)
                )
              },
              true => Option(TypeValue).None
            ),
            .Union(un_name, un_fls, un_fts) => cond(
              (un_name.len() == usize(0)) => Option(TypeValue).Some(
                TypeValue.Union(binding_name, un_fls, un_fts)
              ),
              // A union's `name` is its identity (`union_<module>_<binding>_r…`),
              // so it is never renamed. The FIRST binding becomes its display
              // name instead (an alias `V :: U` keeps `U`), and diagnostics
              // print `U`.
              true => {
                if(type_display_name(un_name.clone()).is_none(), {
                  register_type_display_name(un_name.clone(), binding_name.clone());
                });
                Option(TypeValue).None
              }
            ),
            // Traits too: `Send :: trait(id := "Send")` names the trait
            // "Send". Identity is
            // unaffected — trait matching keys on the `id` field, which is
            // preserved. Without this, diagnostics render the trait as its
            // field dump (`(id : comptime_str)` instead of `Send`), e.g.
            // the where-clause "does not implement required trait" error.
            .TraitT(tr_name, tr_atns, tr_fls, tr_fts, tr_id, tr_conc, tr_sc, tr_nsc, tr_atcl, tr_atct) => cond(
              (tr_name.len() == usize(0)) => Option(TypeValue).Some(
                TypeValue.TraitT(binding_name, tr_atns, tr_fls, tr_fts, tr_id, tr_conc, tr_sc, tr_nsc, tr_atcl, tr_atct)
              ),
              true => Option(TypeValue).None
            ),
            _ => Option(TypeValue).None
          );
          match(
            stamped_ty,
            .Some(new_ty) => Option(EvalValue).Some(EvalValue.TypeVal(new_ty)),
            .None => rhs_value_opt
          )
        },
        _ => rhs_value_opt
      ),
      .None => rhs_value_opt
    );
    // Determine the value to store. A MODULE value is stored by handle, not
    // deep-cloned: importers must share the cached module's `field_values`
    // array so a per-definition revalidation's in-place slot patch
    // (`update_module_cache_slot`) reaches every live `lib :: import(...)`
    // binding — the deep clone gave each importer a private copy whose
    // callee slots went stale after an edit
    // (issues/fixed/per-def-dependent-trial-resolves-stale-callee.md). A
    // module value is immutable after its walk, so sharing is safe.
    lhs_value_opt := cond(
      effective_is_compile_time_only => match(
        stamped_rhs_value_opt,
        .Some(rv) => Option(EvalValue).Some(cond(is_module_val(rv) => rv, true => clone_value(rv, true))),
        .None => Option(EvalValue).Some(create_unknown_val(lhs_type))
      ),
      true => Option(EvalValue).None
    );
    // Update ExprInfo for actual_lhs with final value and env.
    // (Re-read in case synthesize_expr_and_type updated it.)
    actual_lhs_info_final_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(actual_lhs));
    (actual_lhs_info : ExprInfo) = match(
      actual_lhs_info_final_opt,
      .Some(ali) => ali,
      .None => new_expr_info(env, lhs_type)
    );
    actual_lhs_info.ty = lhs_type;
    actual_lhs_info.env = env;
    actual_lhs_info.value = lhs_value_opt;
    actual_lhs_info.path_collection = path_collection_new();
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(actual_lhs), actual_lhs_info);
    // NOTE: no resolvedConcreteType copy here — TypeValue.SomeT does not
    // carry one.
    final_lhs_type := lhs_type;
    // Find RC owner relationship for shared-ownership tracking.
    rhs_owning_variable := find_rc_value_owner_relationship(rhs, env, ctx);
    is_owning_same_rc_value_as := match(
      rhs_owning_variable,
      .Some(rov) => match(
        rov.consumed_at_token,
        // If the RHS was moved, LHS becomes the new primary owner (no chain).
        .Some(_) => Option(Variable).None,
        .None => Option(Variable).Some(rov)
      ),
      .None => Option(Variable).None
    );
    // Rename `_` to a unique temp name so it is tracked in the frame for drop/RC cleanup.
    actual_lhs_tok := ast_expr_token(actual_lhs);
    (var_name : String) = cond(
      (actual_lhs_tok.value == "_") =>
        generate_new_temp_variable_name(env.module_path, usize(actual_lhs_tok.row), usize(actual_lhs_tok.column), .None, .Some(actual_lhs_tok.module_path)),
      true =>
        actual_lhs_tok.value.clone()
    );
    // Reject mutable runtime variable inside an impl block.
    is_runtime_not_in_fn := (!effective_is_compile_time_only && !ctx.is_evaluating_function_body_or_async_block.is_some());
    if(is_runtime_not_in_fn && ctx.is_inside_impl_block, {
      exn.throw(
        dyn(
          format_error_message(
            actual_lhs_tok,
            `Mutable runtime variable "${var_name}" is not allowed inside an impl block.
Use \`::\` for compile-time definitions inside impl.`
          )
        )
      );
    });
    // Mark as module-level for C file-scope statics.
    is_module_level := (
      !effective_is_compile_time_only &&
        !ctx.is_evaluating_function_body_or_async_block.is_some()
    );
    // Look up doc comment from pre-computed position-keyed lookup.
    doc_comment_opt := match(
      ctx.doc_comment_lookup,
      .None => Option(String).None,
      .Some(lookup) => {
        key := doc_comment_lookup_key_from_token(actual_lhs_tok);
        match(lookup.get(key), .Some(v) => Option(String).Some(v), .None => Option(String).None)
      }
    );
    // No-shadowing rule: a `:=`/`::` binding may not reuse a name visible in
    // ANY frame. The check lives at the user binding-introduction sites
    // instead of inside add_variable_to_env — that helper's 100+ internal
    // callers bind params, type params and implicit params, all of which may
    // legitimately shadow. Temp names (`_` rename) are machine-unique, and
    // `__yo_self` is an explicit exemption.
    // Lazy top-level bindings (plans/reference/LAZY_TOPLEVEL_BINDINGS.md §4.3): when
    // THIS definition's phase-A FuncVal was already bound into the module
    // frame by a re-entrant reference (self- or mutual recursion), that
    // Variable is filled in place below instead of being added a second
    // time — and it is not a shadowing conflict.
    prebound_opt := pending_prebound_variable(var_name.clone(), actual_lhs_tok);
    if(var_name != String.from("__yo_self"), {
      shadow_existing := get_variables_from_env(env, var_name);
      if(shadow_existing.len() > usize(0), {
        match(
          shadow_existing.last(),
          .Some(shadow_var) => if(match(prebound_opt, .Some(pb) => (pb.id == shadow_var.id), .None => false), (), {
            sh_entries := ArrayList(TokenAndError).new();
            sh_entries.push(
              TokenAndError(
                token : actual_lhs_tok,
                error_message : `Failed to define variable "${var_name}":`
              )
            );
            sh_entries.push(
              TokenAndError(
                token : shadow_var.token,
                error_message : `Variable "${var_name}" is already defined here (variable shadowing is not allowed):`
              )
            );
            exn.throw(dyn(format_error_messages(sh_entries)));
          }),
          .None => ()
        );
      });
    });
    // Add variable to environment (or fill the phase-A pre-bound one).
    new_var_opt := match(
      prebound_opt,
      .Some(pb) => {
        pb.ty = final_lhs_type;
        match(
          lhs_value_opt,
          .Some(pb_v) => if(pb.value.len() > usize(0), {
            pb.value(usize(0)) = pb_v;
          }, {
            // An EMPTY cell is the shared `g_empty_value_cell` (env.yo):
            // never push into it — mint the variable its own cell.
            pb.value = value_cell_of(Option(EvalValue).Some(pb_v));
          }),
          .None => ()
        );
        pb.is_compile_time_only = effective_is_compile_time_only;
        pb.is_reassignable = !is_implicit;
        pb.is_owning_the_rc_value = type_contains_rc_type(final_lhs_type);
        pb.is_implicit = is_implicit;
        pb.token = actual_lhs_tok;
        pb.initialized_at_token = Option(Token).Some(actual_lhs_tok);
        Option(Variable).Some(pb)
      },
      .None => add_variable_to_env(
        env,
        var_name,
        final_lhs_type,
        lhs_value_opt,
        effective_is_compile_time_only,
        !is_implicit,
        // is_reassignable
        type_contains_rc_type(final_lhs_type),
        // is_owning_the_rc_value (stub: always false)
        is_implicit,
        actual_lhs_tok
      )
    );
    // Tell the pending-definition table which Variable this statement bound
    // (no-op unless this IS the statement currently being forced).
    match(
      new_var_opt,
      .Some(bound_var) => record_pending_def_variable(var_name.clone(), actual_lhs_tok, bound_var),
      .None => ()
    );
    // Patch mutable fields not supported by add_variable_to_env.
    match(
      new_var_opt,
      .Some(new_var) => {
        new_var.is_module_level = is_module_level;
        // Also record it in the data-keyed registry — env copies can lose
        // the flag on some resolution paths (see expr_info.yo
        // g_module_level_globals).
        if(is_module_level, {
          register_module_level_global(actual_lhs_tok.module_path.clone(), var_name.clone());
        });
        // A thread-local is a module-level global PLUS the registry entry that
        // tells codegen to route its reads through the lazy accessor. Option 1
        // of plans/reference/THREAD_LOCAL_STORAGE.md: refuse an RC type rather
        // than leak one instance per thread, since C11 thread-local storage has
        // no destructor hook. Refuse a non-module-level declaration too — a
        // per-thread instance of a function local has no meaning.
        if(is_thread_local_decl, {
          if(!is_module_level, {
            exn.throw(
              dyn(
                format_error_message(
                  actual_lhs_tok,
                  `A thread-local must be declared at module level. "${var_name}" is declared inside a function body, where a per-thread instance has no meaning — use an ordinary local.`
                )
              )
            );
          });
          if(type_contains_rc_type(final_lhs_type), {
            exn.throw(
              dyn(
                format_error_message(
                  actual_lhs_tok,
                  `A thread-local cannot hold a reference-counted type, and "${var_name}" has type ${type_to_string(final_lhs_type)}. A thread's instance is released when the thread exits, and the C11 thread-local storage a thread-local lowers to has no hook to run that release — so the value would leak once per thread. Use a reference-counted value owned by the caller and passed in, or a plain (non-RC) type here.`
                )
              )
            );
          });
          register_thread_local(actual_lhs_tok.module_path.clone(), var_name.clone());
        });
        variable_set_doc_comment(new_var, doc_comment_opt);
        // A second-class value (it holds a capture-list borrow) may be bound
        // to a local that does not outlive what it borrows, and freezes those
        // places while the local lives (decision 38 A).
        if(!is_module_level && !effective_is_compile_time_only, {
          note_second_class_binding(new_var, final_lhs_type, actual_lhs_tok, env, ctx, exn);
        });
        // Set is_owning_the_same_rc_value_as when applicable.
        match(
          is_owning_same_rc_value_as,
          .Some(rov) => {
            new_var.is_owning_the_same_rc_value_as = Option(Rc(Variable)).Some(Rc(Variable)(rov));
          },
          .None => ()
        );
      },
      .None => ()
    );
    // Store the renamed variable name in ExprInfo so codegen uses it instead of "_".
    if(actual_lhs_tok.value == "_", {
      ali_after := match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(actual_lhs)),
        .Some(a) => a,
        .None => new_expr_info(env, final_lhs_type)
      );
      ali_after.variable_name = Option(String).Some(var_name);
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(actual_lhs), ali_after);
    });
    // Update env in ExprInfo for actual_lhs.
    ali_final := match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(actual_lhs)),
      .Some(a) => a,
      .None => new_expr_info(env, final_lhs_type)
    );
    ali_final.env = env;
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(actual_lhs), ali_final);
    scope_release_note_binding(ast_expr_id(actual_lhs), env, var_name.clone());
    // Set ExprInfo on the outer given(...) / comptime(...) wrapper.
    if(is_implicit || is_comptime_wrapped, {
      lhs_info := new_expr_info(env, t_unit());
      lhs_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(lhs), lhs_info);
    });
    // Set ExprInfo on the whole :: / := expression.
    expr_info := new_expr_info(env, t_unit());
    expr_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
    expr_info_set_is_compile_time_only_assignment(expr_info, Option(bool).Some(effective_is_compile_time_only));
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), expr_info);
    expr
  }, {
    // -------------------------------------------------------------------
    // Destructuring LHS: `{x, y} := rhs`
    // -------------------------------------------------------------------
    effective_is_compile_time_only := (is_implicit || is_compile_time_only);
    destr_result := evaluate_destructuring_assignment(
      actual_lhs,
      rhs,
      env,
      effective_is_compile_time_only,
      ctx,
      exn
    );
    env.frames = destr_result.env.frames;
    env.module_path = destr_result.env.module_path;
    env.function_declaration_frame_level = destr_result.env.function_declaration_frame_level;
    env.input_string = destr_result.env.input_string;
    expr_info := new_expr_info(env, t_unit());
    expr_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
    expr_info_set_runtime_destructurings(expr_info, destr_result.runtime_destructurings);
    expr_info_set_is_compile_time_only_assignment(expr_info, Option(bool).Some(effective_is_compile_time_only));
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), expr_info);
    expr
  })
});
export(evaluate_initialization_assignment, evaluate_local_borrow_repoint);
