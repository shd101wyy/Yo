//! initialization_assignment — evaluate `::` and `:=` initialization assignments.
//!
//! Handles:
//!   - `name := rhs`              — runtime variable declaration
//!   - `name :: rhs`              — compile-time constant declaration
//!   - `name := handler`   — implicit parameter declaration
//!   - `_ := rhs`                 — discard (renamed to a temp var)
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  ast_expr_to_string,
  make_err_expr,
  BK_COLON,
  BK_CONST,
  BK_INIT_ASSIGN,
  BK_GIVEN,
  BK_COMPTIME,
  reject_old_mode_spelling,
  ast_expr_is_inout_mode_call,
  ast_expr_is_local_borrow_mode_call,
  BK_THREAD_LOCAL,
  BF_DOT,
  ast_expr_is_atom_of
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  scope_release_note_binding,
  expr_info_table_get,
  has_any_control_flow,
  path_collection_new,
  expr_info_set_runtime_destructurings,
  register_module_level_global,
  register_thread_local,
  expr_info_set_is_compile_time_only_assignment,
  expr_info_set_macro_expansion,
  record_local_borrow_step_pin
} :: import("../../expr_info.yo");
{
  Environment,
  Variable,
  value_cell_of,
  add_variable_to_env,
  get_variables_from_env,
  variable_set_doc_comment,
  variable_set_inout_borrow_root_id,
  variable_mark_inout_borrow_root,
  make_err_variable
} :: import("../../env.yo");
{
  EvalContext,
  ExpectedTypeCtx,
  in_def_time_trial,
  pending_prebound_variable,
  record_pending_def_variable
} :: import("../context.yo");
{ EvalValue, create_unknown_val, is_runtime_only_unknown_val, is_type_value, is_module_val } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, type_value_tag, register_type_binding_name } :: import("../../types/creators.yo");
{ TypeTag } :: import("../../types/tags.yo");
{ are_types_compatible, are_types_compatible_exact } :: import("../../types/compatibility.yo");
{
  prohibit_void_type,
  type_requires_comptime_modifier,
  type_prohibits_comptime_modifier,
  type_contains_rc_type,
  type_is_control_bound,
  get_all_some_types,
  dyn_upcast_note
} :: import("../../types/utils.yo");
{ convert_comptime_type_to_runtime_type } :: import("../../types/env_lookup.yo");
{ type_to_string, register_type_display_name, type_display_name } :: import("../../types/string.yo");
{ is_reference_struct_type, is_atomic_reference_struct_type, is_unit_type, is_comptime_int_type } :: import("../../types/guards.yo");
{ check_comptime_int_value_fits } :: import("../values/integer.yo");
{ format_error_message, format_error_message_with_help, format_error_message_with_repair, format_error_messages, TokenAndError, with_code } :: import("../../error.yo");
{ E_COMPTIME_RUNTIME_BINDING } :: import("../../diagnostics.yo");
{ Token, TokenKind, is_reserved_operator_name, is_reserved_builtin_binding_name, reserved_builtin_binding_message } :: import("../../token.yo");
{ raise_flow_violation } :: import("../../types/flowability.yo");
{ type_implements_comptime, type_implements_runtime_full } :: import("../trait_checking.yo");
{ evaluate_expression_raw } :: import("./expr.yo");
{ is_valid_variable_name, in_compile_time_fn_body, note_second_class_binding } :: import("../utils.yo");
{ throw_rhs_contains_control_flow_expression_error } :: import("./assignment.yo");
{
  evaluate_destructuring_assignment,
  DestructuringResult
} :: import("./destructuring_assignment.yo");
{ synthesize_expr_and_type } :: import("../types/expr_synthesizer.yo");
{ clone_value } :: import("../values/clone_value.yo");
{ find_rc_value_owner_relationship, throw_expr_is_implicit_variable_error, require_expr_not_consumed, set_expr_as_needs_to_call_dup, doc_comment_lookup_key_from_token, audit_pending_copies_enabled } :: import("../utils.yo");
{
  LocalBorrowPlace,
  LocalBorrowAccess,
  local_borrow_place_of,
  local_borrow_access,
  local_borrow_require_writable,
  local_borrow_range_of,
  local_borrow_register,
  local_borrow_place_text,
  local_borrow_info_of_variable,
  local_borrow_pattern_source,
  local_borrow_require_no_live_derived,
  local_borrow_place_of_variable,
  local_borrow_info_placeholder
} :: import("../utils.yo");
{ generate_new_temp_variable_name } :: import("../../utils.yo");
