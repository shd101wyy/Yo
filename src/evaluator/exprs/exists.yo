//! evaluate_exists — stub for the `exists(T)` builtin.
//!
//! NOTE: the `exists` feature is not yet implemented; this file is a stub
//! and full implementation is deferred until the feature is enabled.
//!
//! When implemented, `exists(T)` checks whether a variable of type T (or
//! labelled variable `label : T`) exists as a compile-time-only variable in
//! the current environment. It returns a `comptime(bool)` value.
{ String } :: import("std/string");
{ AstExpr, ast_expr_token, make_err_expr } :: import("../../expr.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
/// Evaluate the `exists(type_or_label_type, ...)` builtin.
///
/// Stub: this function currently throws "not yet implemented" and will be
/// completed when the feature is enabled.
evaluate_exists :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  exn.throw(
    dyn(
      format_error_message(
        ast_expr_token(expr),
        String.from("evaluate_exists: not yet implemented (Phase 2 stub)")
      )
    )
  );
  make_err_expr()
});
export(evaluate_exists);
