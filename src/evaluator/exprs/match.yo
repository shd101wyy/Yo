// ---------------------------------------------------------------------------
// Local helpers
// ---------------------------------------------------------------------------
/// True for a *place* expression: a plain variable (Atom) or a bare
/// field-access chain rooted at one (`self._bytes`, `a.b.c`).
///
/// A place is already owned by the enclosing scope for the whole duration of
/// the match, so — exactly like the Atom case — it must NOT be wrapped in an
/// implicit begin() scope: that materializes an owning temp copy (a `___dup`
/// before the switch and a `___drop` after it) on every single match. Matching
/// on a field is the hottest shape in a self-compile (`String ==` alone was
/// 33% of all decr_rc traffic) and the pair is pure overhead there — the arms
/// only borrow the payload.
///
/// A method call (`x.f()`) is NOT a 2-arg dot call (its func IS the dot), so
/// it still takes the begin() path and keeps its owning temp.
is_place_expression :: (fn(imm(e) : AstExpr, imm(env) : Environment) -> bool)({
  if(ast_expr_is_atom(e), {
    return(true);
  });
  outer_field_is_atom := match(
    e,
    .FnCall(_, _, eargs, _, _) =>
      match(eargs.get(usize(1)), .Some(a1) => ast_expr_is_atom(a1), .None => false),
    .Atom(_, _) => false
  );
  if(!(ast_expr_is_fn_call_of(e, ".", .Some(usize(2))) && outer_field_is_atom), {
    return(false);
  });
  // Walk to the root of the `a.b.c` chain.
  (root : AstExpr) = match(
    e,
    .FnCall(_, _, eargs0, _, _) => match(eargs0.get(usize(0)), .Some(a0) => a0, .None => e),
    .Atom(_, _) => e
  );
  walking := true;
  while(walking, {
    nxt := match(
      root,
      .FnCall(_, _, rargs, _, _) =>
        if(
          ast_expr_is_fn_call_of(root, ".", .Some(usize(2)))
          && match(rargs.get(usize(1)), .Some(a1) => ast_expr_is_atom(a1), .None => false),
          rargs.get(usize(0)),
          Option(AstExpr).None
        ),
      .Atom(_, _) => Option(AstExpr).None
    );
    match(
      nxt,
      .Some(n) => {
        root = n;
      },
      .None => {
        walking = false;
      }
    );
  });
  if(!(ast_expr_is_atom(root)), {
    return(false);
  });
  // The chain must bottom out in a RUNTIME variable. A compile-time dot such
  // as `Kind.Func` (an enum variant) or a module member is not a place:
  // evaluating it directly yields no variable_name for the match to bind, and
  // it carries no RC traffic to save in the first place.
  root_vars := get_variables_from_env(env, ast_expr_token(root).value);
  if(root_vars.len() == usize(0), {
    return(false);
  });
  return(
    match(
      root_vars.last(),
      .Some(rv) => !(rv.is_compile_time_only),
      .None => false
    )
  );
});
/// True when `ty` is a primitive type the pre-IR `switch` emitter handles
/// (int, float, bool, comptime_*). A match whose scrutinee is one of these and
/// whose arms are all literal/constant/or-of-literal is stamped
/// `is_primitive_match` so codegen keeps emitting the `switch`.
is_matchable_primitive_type :: (fn(imm(ty) : TypeValue) -> bool)(
  is_integer_type(ty) || is_float_type(ty) || is_c_compatible_type(ty) ||
    is_bool_type(ty) || is_comptime_int_type(ty)
    ||
      is_comptime_float_type(ty) || is_comptime_string_type(ty)
);
/// True for a value that is a concrete compile-time literal (the scrutinee
/// kinds the arm selection can decide on). A tuple/struct of literals is one
/// (an opaque payload — an `Rc` — makes the whole value undecidable).
_is_literal_val :: (fn(imm(v) : EvalValue) -> bool)(
  match(
    v,
    .IntLit(_) => true,
    .FloatLit(_) => true,
    .BoolVal(_) => true,
    .StrLit(_) => true,
    .TupleVal(fields) => _all_literal_vals(fields),
    .StructVal(_, _, field_values) => _all_literal_vals(field_values),
    _ => false
  )
);
_all_literal_vals :: (fn(imm(vals) : ArrayList(EvalValue)) -> bool)({
  (ok : bool) = true;
  (i : usize) = usize(0);
  while((i < vals.len()) && ok, {
    match(
      vals.get(i),
      .Some(v) => {
        ok = _is_literal_val(v);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  ok
});
/// True when `p` is a variant pattern with at least one literal (`Const`)
/// payload sub-pattern — the arm shape the classic `case TAG:` emitter guards
/// with an `if` inside the case block. Such a group of arms is only soundly
/// switch-lowered when it jointly covers its variant (see the coverage pass
/// before `register_match_arms` and `variant_group_covers` in pattern.yo).
_variant_pattern_has_literal_sub :: (fn(imm(p) : Pattern) -> bool)(
  match(
    p,
    .Variant(_, _, _, subs, _, _, _) => {
      (hit : bool) = false;
      (i : usize) = usize(0);
      while((i < subs.len()) && !(hit), {
        match(
          subs.get(i),
          .Some(s) => {
            hit = match(s, .Const(_, _, _, _, _) => true, _ => false);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      hit
    },
    _ => false
  )
);
/// Compute the GADT-refined expected type for a match branch. If the expected type is the
/// SAME SomeT as one of the enum's type-constructor args, the branch
/// refines it to the variant's `-> recur(...)` arg at that position
/// (e.g. expected `T`, tca `[T]`, variant args `[i32]` → `i32`).
_gadt_refined_expected :: (
  fn(imm(expected) : TypeValue, imm(tca) : ArrayList(TypeValue), imm(gra) : ArrayList(TypeValue)) -> TypeValue
)({
  exp_id := match(expected, .SomeT({ id : sid }) => sid, _ => String.new());
  if(exp_id.len() == usize(0), {
    return(expected);
  });
  (refined : Option(TypeValue)) = Option(TypeValue).None;
  (k : usize) = usize(0);
  while((k < tca.len()) && refined.is_none(), {
    tk := match(tca.get(k), .Some(t) => t, .None => TypeValue.Unit);
    tk_id := match(tk, .SomeT({ id : tid }) => tid, _ => String.new());
    if((tk_id.len() > usize(0)) && (tk_id == exp_id), {
      match(
        gra.get(k),
        .Some(g) => {
          refined = Option(TypeValue).Some(g);
        },
        .None => ()
      );
    });
    k = (k + usize(1));
  });
  match(refined, .Some(r) => r, .None => expected)
});
/// The result type of a body given the running expected type (the arm's
/// type unless a concrete expected type is in force).
_arm_result_type :: (fn(imm(ctx) : EvalContext, imm(body_ty) : TypeValue) -> TypeValue)(
  cond(
    match(ctx.expected_type, .Some(et) => (!type_contains_some_type(et.ty) && !type_mentions_impl_fn_or_future(et.ty)), .None => false) =>
      match(ctx.expected_type, .Some(et) => et.ty, .None => body_ty),
    true => body_ty
  )
);
/// `env` takes over the frames of `src` (the body-env handover the arm loop
/// and the post-loop use).
_adopt_env :: (fn(imm(env) : Environment, imm(src) : Environment) -> unit)({
  env.frames = src.frames;
  env.module_path = src.module_path;
  env.function_declaration_frame_level = src.function_declaration_frame_level;
  env.input_string = src.input_string;
});
// ---------------------------------------------------------------------------
// evaluate_match
// ---------------------------------------------------------------------------
/// The help line of a non-exhaustive `match` whose missing value a guarded
/// arm would match.
_GUARD_HELP :: "an arm with a guard (`p && (guard)`) does not count toward exhaustiveness, because the guard can fail; add an arm without a guard for these values";
// ---------------------------------------------------------------------------
// How a `match` takes its scrutinee (plans/VALUES_BY_DEFAULT.md decision 26)
// ---------------------------------------------------------------------------
/// The variable a scrutinee place is rooted at: `x`, `x.f.g`, `x.a(i)` → `x`
/// (the innermost binding of the name). `.None` for a temporary.
_scrutinee_root_variable :: (fn(imm(scr) : AstExpr, imm(env) : Environment) -> Option(Variable))({
  (cur : AstExpr) = scr;
  (walking : bool) = true;
  while(walking, {
    cond(
      ast_expr_is_fn_call_of(cur, BF_DOT, Option(usize).Some(usize(2))) => {
        cur = match(cur, .FnCall(_, _, dargs, _, _) => match(dargs.get(usize(0)), .Some(b) => b, .None => make_err_expr()), .Atom(_, _) => cur);
      },
      true => {
        walking = false;
      }
    );
  });
  cond(
    (ast_expr_is_atom(cur) && (ast_expr_token(cur).kind == TokenKind.Identifier)) => get_variables_from_env(env, ast_expr_token(cur).value.clone()).last(),
    true => Option(Variable).None
  )
});
/// The scrutinee is a projection of a variable: a field chain (`x.f`), a
/// dereference (`p.*`) or an index (`xs(i)`) rooted at one. A call on a
/// value (`make()`, `x.get()`) is a temporary.
_scrutinee_is_projection :: (fn(imm(scr) : AstExpr, imm(env) : Environment) -> bool)(
  cond(
    // A `.` access rooted at a runtime variable (`Type.Variant` is a value).
    ast_expr_is_fn_call_of(scr, BF_DOT, Option(usize).Some(usize(2))) => match(_scrutinee_root_variable(scr, env), .Some(rv) => !rv.is_compile_time_only, .None => false),
    true => match(
      scr,
      // `xs(i)`: a call whose callee is a runtime variable, not a function.
      .FnCall(_, callee, _, _, _) => (
        ast_expr_is_atom(callee) && match(
          get_variables_from_env(env, ast_expr_token(callee).value.clone()).last(),
          .Some(cv) => !cv.is_compile_time_only,
          .None => false
        )
      ),
      .Atom(_, _) => false
    )
  )
);
/// A binding that holds a `mut` place: a `mut` parameter, a `mut(y) :=`
/// local borrow, or a binding of a `mut` match.
_variable_is_mut_borrow :: (fn(imm(v) : Variable) -> bool)(
  v.is_ref && match(local_borrow_info_of_variable(v), .Some(info) => info.is_mut, .None => true)
);
/// A binding that holds an `imm` borrow: an `imm` parameter, an `imm(y) :=`
/// local borrow, or a binding of a borrowing match or a `for` loop.
_variable_is_imm_borrow :: (fn(imm(v) : Variable) -> bool)(
  cond(
    v.is_ref => !_variable_is_mut_borrow(v),
    v.is_module_level => false,
    v.is_parameter => !v.is_owning_the_rc_value,
    // A pattern binding of a borrowing match, a `for` element: not
    // reassignable and owning nothing (a plain local is reassignable).
    true => (!v.is_owning_the_rc_value && !v.is_reassignable && !v.is_compile_time_only)
  )
);
/// E0901 for a scrutinee a `match` would have to move but cannot: `why`
/// says what owns it, and the help names the borrow that matches it in place.
_throw_unmovable_scrutinee :: (fn(imm(scr) : AstExpr, imm(ty) : TypeValue, imm(why) : String, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  // `yo fix --migrate match-scrutinee` writes the borrow instead.
  if(migrate_match_scrutinee_on(), {
    lt := _leftmost_token(scr);
    record_migrate_edit(lt, lt.value.len(), `&${lt.value}`, lt.value.clone());
    return(());
  });
  text := ast_expr_to_string(scr);
  if(text.starts_with("(") && text.ends_with(")"), {
    text = text.substring(usize(1), text.len() - usize(1));
  });
  raise_flow_violation(
    with_code(
      format_error_message_with_help(
        _leftmost_token(scr),
        `Cannot match \`${text}\` by value: its type \`${type_to_string(ty)}\` is not implicitly copyable, so a \`match\` takes it by value and moves it (plans/VALUES_BY_DEFAULT.md decision 26), but ${why}`,
        Option(String).Some(`match through a borrow: \`match(&${text}, …)\`, or \`match(&mut ${text}, …)\` to write through the bindings`)
      ),
      E_USE_OF_MOVED_VALUE
    ),
    ctx,
    exn
  );
});
/// The first token of `e` as written: the receiver of a `.` access, the
/// callee of a call.
_leftmost_token :: (fn(imm(e) : AstExpr) -> Token)(
  match(
    e,
    .Atom(_, t) => t,
    .FnCall(_, callee, args, is_infix, tok) => cond(
      is_infix => match(args.get(usize(0)), .Some(a0) => recur(a0), .None => tok),
      true => recur(callee)
    )
  )
);
/// Decide how the `match` takes its scrutinee (decision 26's table), and for
/// a consuming match move the scrutinee now: the arms' bindings own its parts
/// from the arm's selection on, so no arm may read the scrutinee itself.
///
/// - `match(&mut x, …)` → `mut` places (a temporary has no place; an `imm`
///   borrow cannot be written through);
/// - `match(&x, …)` → borrows, `x` stays usable (a temporary is borrowed
///   for the match);
/// - a bare `mut` binding → `mut` places; a bare `imm` binding → borrows;
/// - a value that is `Copy` or still implicitly copyable → copies or shares
///   (today's borrowing lowering, observably the same);
/// - otherwise the scrutinee is moved: an owned local or by-value parameter
///   is consumed (a later use is E0901 naming `match(&x, …)`), an owned
///   temporary is consumed, and a module-level binding, a closure capture or
///   a projection (no partial moves) is E0901.
_decide_match_mode :: (
  fn(
    imm(scr_raw) : AstExpr,
    imm(evaluated) : AstExpr,
    imm(info) : ExprInfo,
    marker : u8,
    imm(env) : Environment,
    imm(ctx) : EvalContext,
    imm(exn) : Exception
  ) -> u8
)({
  scr := ast_expr_strip_borrow_marker(scr_raw);
  ty := info.ty;
  root := _scrutinee_root_variable(scr, env);
  is_atom := ast_expr_is_atom(scr);
  if(marker == u8(2), {
    match(
      root,
      .None => {
        text := ast_expr_to_string(scr);
        exn.throw(
          dyn(
            format_error_message_with_help(
              ast_expr_token(scr),
              `Cannot match \`&mut ${text}\`: \`&mut\` lends a place, and \`${text}\` is a temporary.`,
              Option(String).Some(`bind it to a local first (\`t := ${text}; match(&mut t, …)\`), or match it by value`)
            )
          )
        );
      },
      .Some(rv) => if(_variable_is_imm_borrow(rv), {
        exn.throw(
          dyn(
            with_code(
              format_error_message_with_help(
                ast_expr_token(scr),
                `Cannot match \`&mut ${ast_expr_to_string(scr)}\`: \`${rv.name}\` is an \`imm\` borrow, which is read-only.`,
                Option(String).Some(`match it with \`&${ast_expr_to_string(scr)}\`, or take \`${rv.name}\` as \`mut(${rv.name})\``)
              ),
              E_WRITE_THROUGH_BORROW
            )
          )
        );
      })
    );
    return(MATCH_MODE_MUT);
  });
  if(marker == u8(1), {
    return(MATCH_MODE_BORROW);
  });
  if(is_atom, {
    match(
      root,
      .Some(rv) => {
        if(_variable_is_mut_borrow(rv), {
          return(MATCH_MODE_MUT);
        });
        if(_variable_is_imm_borrow(rv), {
          return(MATCH_MODE_BORROW);
        });
      },
      .None => ()
    );
  });
  if(!type_requires_explicit_copy(ty), {
    return(MATCH_MODE_BORROW);
  });
  stok := ast_expr_token(scr);
  if(is_atom, {
    match(
      root,
      .Some(rv) => cond(
        rv.is_module_level => {
          _throw_unmovable_scrutinee(scr, ty, String.from("it is a module-level binding, which lives for the whole program and is never moved."), ctx, exn);
          return(MATCH_MODE_BORROW);
        },
        match_scrutinee_is_capture(rv, env, ctx) => {
          _throw_unmovable_scrutinee(scr, ty, String.from("it is a closure's capture, which the closure keeps for its next call."), ctx, exn);
          return(MATCH_MODE_BORROW);
        },
        rv.is_compile_time_only => (),
        true => {
          set_expr_as_consumed(evaluated, env, false, ctx, exn);
          note_consuming_match_scrutinee(stok);
        }
      ),
      .None => ()
    );
    return(MATCH_MODE_CONSUME);
  });
  if(_scrutinee_is_projection(scr, env), {
    why := cond(
      ast_expr_is_fn_call_of(scr, BF_DOT, Option(usize).Some(usize(2))) => String.from("it is a part of another value (a field or a dereference), and moving it out would leave that value partly moved (Yo has no partial moves)."),
      true => String.from("it is an element of a collection, which still owns it.")
    );
    _throw_unmovable_scrutinee(scr, ty, why, ctx, exn);
    return(MATCH_MODE_BORROW);
  });
  // A temporary: an owned one transfers to the arms.
  match(
    info.variable_name,
    .Some(tname) => match(
      find_variable_in_env(info.env, tname.clone()),
      .Some(tv) => if(is_temp_variable_name(env.module_path, tname), {
        if(tv.is_owning_the_rc_value, {
          if(tv.consumed_at_token.is_none(), {
            tv.consumed_at_token = Option(Rc(Token)).Some(rc(stok));
          });
        }, {
          _throw_unmovable_scrutinee(scr, ty, String.from("it is borrowed from the value that holds it (an element, or a binding into another value)."), ctx, exn);
          return(MATCH_MODE_BORROW);
        });
      }),
      .None => ()
    ),
    .None => ()
  );
  MATCH_MODE_CONSUME
});
/// The hidden bindings a consuming arm adds to its pattern
/// (`_augment_consuming_pattern`), and the user's bindings below a cell.
_ArmOwnership :: ref(
  struct(
    /// Each part the pattern does not bind: a hidden binding dropped when
    /// the arm is entered.
    unbound : ArrayList(BindInfo),
    /// Each reference-cell handle the pattern looks through: a hidden
    /// binding that keeps it to the arm's end (its parts are borrowed).
    keeps : ArrayList(BindInfo),
    /// The user's bindings below a cell: borrows, never owners or places.
    borrowed : ArrayList(String),
    /// Add hidden bindings (a consuming match whose type has drops); false
    /// for a `mut` match, which only classifies.
    add_hidden : bool,
    /// The user bindings' types (a `(name := p)` sub-binding must be `Copy`).
    bind_tys : ArrayList(BindInfo),
    tok : Token,
    counter : usize,
    is_mut : bool
  )
);
_ownership_hidden_bind :: (fn(imm(own) : _ArmOwnership, imm(ty) : TypeValue, imm(env) : Environment) -> BindInfo)({
  tok := own.tok;
  name := generate_new_temp_variable_name(env.module_path, usize(tok.row), usize(tok.column), Option(String).Some(`mv${own.counter.to_string()}`), Option(String).Some(tok.module_path));
  own.counter = (own.counter + usize(1));
  atok := Token(kind : TokenKind.Identifier, value : name.clone(), row : tok.row, column : tok.column, character : tok.character, byte_offset : tok.byte_offset, module_path : tok.module_path, input : tok.input);
  BindInfo(name : name, ty : ty, value : Option(EvalValue).None, atom : AstExpr.Atom(alloc_global_expr_id(), atok))
});
_ownership_unbound :: (fn(imm(own) : _ArmOwnership, imm(ty) : TypeValue, imm(env) : Environment) -> Pattern)({
  b := _ownership_hidden_bind(own, ty, env);
  own.unbound.push(b);
  Pattern.Bind(name : b.name.clone(), token : ast_expr_token(b.atom), atom : b.atom)
});
_ownership_keep :: (fn(imm(own) : _ArmOwnership, imm(ty) : TypeValue, imm(p) : Pattern, imm(env) : Environment) -> Pattern)({
  b := _ownership_hidden_bind(own, ty, env);
  own.keeps.push(b);
  Pattern.At(name : b.name.clone(), token : ast_expr_token(b.atom), atom : b.atom, sub : p)
});
/// A part with a drop of its own (a counted cell or a move-only value).
_part_has_drop :: (fn(imm(ty) : TypeValue) -> bool)(type_contains_rc_cell_or_move_only(ty));
_bind_ty_of :: (fn(imm(own) : _ArmOwnership, imm(name) : String) -> Option(TypeValue))({
  (i : usize) = usize(0);
  while(i < own.bind_tys.len(), {
    match(
      own.bind_tys.get(i),
      .Some(b) => if(b.name == name, {
        return(Option(TypeValue).Some(b.ty));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  Option(TypeValue).None
});
/// Walk a consuming (or `mut`) arm's compiled pattern `p` at a position of
/// type `ty`. For a consuming match whose type has drops, every part the
/// pattern leaves unbound gets a hidden binding (dropped when the arm is
/// entered), and every reference-cell handle the pattern looks through gets
/// one that keeps it to the arm's end; the user's bindings below a cell are
/// recorded as borrows. Coverage is unchanged: a hidden binding sits where a
/// `_` or an unlisted field was.
_augment_arm_pattern :: (fn(imm(p) : Pattern, imm(ty) : TypeValue, in_cell : bool, imm(own) : _ArmOwnership, imm(env) : Environment, imm(exn) : Exception) -> Pattern)(
  match(
    p,
    .Wildcard => cond(
      (own.add_hidden && !in_cell && _part_has_drop(ty)) => _ownership_unbound(own, ty, env),
      true => p
    ),
    .Bind(name, _, _) => {
      if(in_cell, {
        own.borrowed.push(name.clone());
      });
      p
    },
    .Const(_, _, _, _, _) => cond(
      (own.add_hidden && !in_cell && _part_has_drop(ty)) => {
        b := _ownership_hidden_bind(own, ty, env);
        own.unbound.push(b);
        Pattern.At(name : b.name.clone(), token : ast_expr_token(b.atom), atom : b.atom, sub : p)
      },
      true => p
    ),
    .Range(_, _, _, _, _, _, _) => p,
    .Variant(vname, vidx, field_idx, subs, enum_ty, through_ptr, arity) => {
      cell := (in_cell || through_ptr || pattern_position_is_cell(ty));
      ftys := variant_field_types(resolve_enum_shell(enum_ty), vidx);
      new_idx := ArrayList(usize).new();
      new_subs := ArrayList(Pattern).new();
      (i : usize) = usize(0);
      while(i < subs.len(), {
        fi := match(field_idx.get(i), .Some(k) => k, .None => usize(0));
        fty := match(ftys.get(fi), .Some(t) => t, .None => TypeValue.Unit);
        match(
          subs.get(i),
          .Some(sub) => {
            new_idx.push(fi);
            new_subs.push(recur(sub, fty, cell, own, env, exn));
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      if(own.add_hidden && !cell, {
        (f : usize) = usize(0);
        while(f < arity, {
          (listed : bool) = false;
          (j : usize) = usize(0);
          while(j < field_idx.len(), {
            if(match(field_idx.get(j), .Some(k) => (k == f), .None => false), {
              listed = true;
            });
            j = (j + usize(1));
          });
          fty := match(ftys.get(f), .Some(t) => t, .None => TypeValue.Unit);
          if(!listed && _part_has_drop(fty), {
            new_idx.push(f);
            new_subs.push(_ownership_unbound(own, fty, env));
          });
          f = (f + usize(1));
        });
      });
      v := Pattern.Variant(name : vname, idx : vidx, field_idx : new_idx, subs : new_subs, enum_ty : enum_ty, through_ptr : through_ptr, arity : arity);
      cond(
        (own.add_hidden && !in_cell && pattern_position_is_cell(ty) && _part_has_drop(ty)) => _ownership_keep(own, ty, v, env),
        true => v
      )
    },
    .Or(alts) => {
      new_alts := ArrayList(Pattern).new();
      (ai : usize) = usize(0);
      while(ai < alts.len(), {
        match(
          alts.get(ai),
          .Some(alt) => {
            before_u := own.unbound.len();
            before_k := own.keeps.len();
            na := recur(alt, ty, in_cell, own, env, exn);
            if((own.unbound.len() > before_u) || (own.keeps.len() > before_k), {
              exn.throw(
                dyn(
                  format_error_message_with_help(
                    own.tok,
                    `An or-pattern alternative of a consuming \`match\` leaves a part with a drop unbound (\`${pattern_to_string(alt)}\`): the alternatives would leave different parts to drop when the arm is entered (plans/VALUES_BY_DEFAULT.md decision 26).`,
                    Option(String).Some(`split the alternatives into arms of their own, bind the part, or match through a borrow (\`match(&x, …)\`)`)
                  )
                )
              );
            });
            new_alts.push(na);
          },
          .None => ()
        );
        ai = (ai + usize(1));
      });
      Pattern.Or(alts : new_alts)
    },
    .At(name, atok, aatom, sub) => {
      if(in_cell, {
        own.borrowed.push(name.clone());
      });
      // The whole value is the binding's, so nothing inside it is hidden;
      // the walk only finds the sub-bindings below a cell (borrows).
      saved_hidden := own.add_hidden;
      own.add_hidden = false;
      new_sub := recur(sub, ty, in_cell, own, env, exn);
      own.add_hidden = saved_hidden;
      // A binding inside it is a copy, so it must be `Copy` (Rust's bindings
      // after `@` in a by-move pattern); in a `mut` match two places would
      // alias.
      sub_names := pattern_bindings(sub);
      (si : usize) = usize(0);
      while(si < sub_names.len(), {
        sn := match(sub_names.get(si), .Some(n) => n, .None => String.new());
        sty := _bind_ty_of(own, sn.clone());
        bad := cond(
          (in_cell || _names_contain(own.borrowed, sn.clone())) => false,
          own.is_mut => true,
          true => match(sty, .Some(t) => !type_is_bitwise_copy(t), .None => false)
        );
        if(bad, {
          exn.throw(
            dyn(
              with_code(
                format_error_message_with_help(
                  atok,
                  cond(
                    own.is_mut => `\`(${name} := …)\` binds \`${sn}\` inside it, and in a \`mut\` match both would be \`mut\` places over the same storage.`,
                    true => `\`(${name} := …)\` takes the whole value, so \`${sn}\` inside it would be a copy, and its type \`${match(sty, .Some(t) => type_to_string(t), .None => String.from("?"))}\` is not \`Copy\` (plans/VALUES_BY_DEFAULT.md decision 26).`
                  ),
                  Option(String).Some(`bind only \`${name}\` and match it again, or match through a borrow (\`match(&x, …)\`)`)
                ),
                E_USE_OF_MOVED_VALUE
              )
            )
          );
        });
        si = (si + usize(1));
      });
      Pattern.At(name : name, token : atok, atom : aatom, sub : new_sub)
    },
    .ThroughBox(box_ty, inner_ty, sub) => {
      tb := Pattern.ThroughBox(box_ty : box_ty, inner_ty : inner_ty, sub : recur(sub, inner_ty, true, own, env, exn));
      cond(
        (own.add_hidden && !in_cell && _part_has_drop(ty)) => _ownership_keep(own, ty, tb, env),
        true => tb
      )
    },
    .Tuple(subs, elem_tys) => {
      cell := (in_cell || is_pointer_type(ty));
      new_subs := ArrayList(Pattern).new();
      (i : usize) = usize(0);
      while(i < subs.len(), {
        ety := match(elem_tys.get(i), .Some(t) => t, .None => TypeValue.Unit);
        match(subs.get(i), .Some(sub) => new_subs.push(recur(sub, ety, cell, own, env, exn)), .None => ());
        i = (i + usize(1));
      });
      Pattern.Tuple(subs : new_subs, elem_tys : elem_tys)
    },
    .Struct(struct_ty, field_idx, subs, arity) => {
      cell := (in_cell || pattern_position_is_cell(ty));
      ftys := match(struct_ty, .Struct({ field_types : fts }) => fts, _ => ArrayList(TypeValue).new());
      new_idx := ArrayList(usize).new();
      new_subs := ArrayList(Pattern).new();
      (i : usize) = usize(0);
      while(i < subs.len(), {
        fi := match(field_idx.get(i), .Some(k) => k, .None => usize(0));
        fty := match(ftys.get(fi), .Some(t) => t, .None => TypeValue.Unit);
        match(
          subs.get(i),
          .Some(sub) => {
            new_idx.push(fi);
            new_subs.push(recur(sub, fty, cell, own, env, exn));
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      if(own.add_hidden && !cell, {
        (f : usize) = usize(0);
        while(f < arity, {
          (listed : bool) = false;
          (j : usize) = usize(0);
          while(j < field_idx.len(), {
            if(match(field_idx.get(j), .Some(k) => (k == f), .None => false), {
              listed = true;
            });
            j = (j + usize(1));
          });
          fty := match(ftys.get(f), .Some(t) => t, .None => TypeValue.Unit);
          if(!listed && _part_has_drop(fty), {
            new_idx.push(f);
            new_subs.push(_ownership_unbound(own, fty, env));
          });
          f = (f + usize(1));
        });
      });
      s := Pattern.Struct(struct_ty : struct_ty, field_idx : new_idx, subs : new_subs, arity : arity);
      cond(
        (own.add_hidden && !in_cell && pattern_position_is_cell(ty) && _part_has_drop(ty)) => _ownership_keep(own, ty, s, env),
        true => s
      )
    }
  )
);
_names_contain :: (fn(imm(xs) : ArrayList(String), imm(x) : String) -> bool)({
  (i : usize) = usize(0);
  while(i < xs.len(), {
    if(match(xs.get(i), .Some(y) => (y == x), .None => false), {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
/// Add a consuming arm's hidden bindings to its frame, borrowing until the
/// arm is selected.
_add_hidden_bindings :: (fn(imm(binds) : ArrayList(BindInfo), imm(env) : Environment, imm(ctx) : EvalContext) -> ArrayList(Variable))({
  out := ArrayList(Variable).new();
  (i : usize) = usize(0);
  while(i < binds.len(), {
    match(
      binds.get(i),
      .Some(b) => {
        match(
          add_variable_to_env(env, b.name.clone(), b.ty, Option(EvalValue).None, false, false, false, false, ast_expr_token(b.atom)),
          .Some(v) => out.push(v),
          .None => ()
        );
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(b.atom), new_expr_info(env, b.ty));
        scope_release_note_binding(ast_expr_id(b.atom), env, b.name.clone());
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});
_own_all :: (fn(imm(vs) : ArrayList(Variable)) -> unit)({
  (i : usize) = usize(0);
  while(i < vs.len(), {
    match(
      vs.get(i),
      .Some(v) => {
        v.is_owning_the_rc_value = true;
      },
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// After a consuming arm's body: a binding it still owns is dropped at the
/// arm's end (and at each exit inside it); one it moved is dropped at the
/// exits before the move.
_drop_owned_at_arm_end :: (fn(imm(vs) : ArrayList(Variable), imm(body) : AstExpr, imm(env) : Environment, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  (i : usize) = usize(0);
  while(i < vs.len(), {
    match(
      vs.get(i),
      .Some(v) => cond(
        v.consumed_at_token.is_some() => attach_consumed_binding_exit_drops(body, v, env, ctx, exn),
        true => drop_owned_match_binding_at_arm_end(v, body, env, ctx, exn)
      ),
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// Evaluate a `match(...)` expression.
evaluate_match :: (
  fn(
    imm(expr) : AstExpr,
    imm(env_in) : Environment,
    imm(ctx) : EvalContext,
    imm(exn) : Exception
  ) -> AstExpr
)({
  (env : Environment) = env_in;
  if(!(ast_expr_is_fn_call_of(expr, BK_MATCH, .None)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected "match"`
        )
      )
    );
    return(expr);
  });
  all_args := match(
    expr,
    .FnCall(_, _, args, _, _) => args,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  if(all_args.len() < usize(2), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected at least 2 arguments for "match", got ${all_args.len()}`
        )
      )
    );
    return(expr);
  });
  scrutinee_expr := match(all_args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
  // Evaluate scrutinee with cleared expectedType
  old_expected_scr := ctx.expected_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  evaluated_scrutinee := cond(
    is_place_expression(scrutinee_expr, env) =>
      evaluate_expression(scrutinee_expr, env, ctx),
    true =>
      evaluate_begin_expression(scrutinee_expr, env, ctx, ArrayList(Variable).new(), false, exn)
  );
  ctx.expected_type = old_expected_scr;
  // Check scrutinee ExprInfo has variable_name
  scr_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_scrutinee));
  (scr_has_var_name : bool) = match(
    scr_info_opt,
    .Some(si) => si.variable_name.is_some(),
    .None => false
  );
  if(!(scr_has_var_name), {
    // RETRY FOR THE REAL DIAGNOSTIC. A place-expression scrutinee is
    // evaluated above through the exn-LESS `evaluate_expression`, so a
    // failure inside it leaves no ExprInfo and its own diagnostic never
    // reaches this frame — the user then gets this generic message instead of
    // the actual error. Measured 2026-09-16: `match(undefined_thing, …)`
    // reported "Failed to evaluate the match scrutinee expression:
    // undefined_thing" instead of `Variable "undefined_thing" not found.`,
    // while a non-place scrutinee (a call, evaluated through
    // `evaluate_begin_expression` WITH `exn`) reported its real type error.
    //
    // Re-evaluate through the exn-carrying entry point so that error throws.
    // This runs ONLY on a path that is about to fail anyway, so a successful
    // compile is unaffected; if the retry somehow succeeds, the generic
    // message below still fires exactly as before.
    // plans/archive/LLM_FRIENDLY_TOOLCHAIN_AND_SYNTAX.md §3.
    _retry_scr := evaluate_expression_raw(scrutinee_expr, env, ctx, exn);
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(scrutinee_expr),
          `Failed to evaluate the match scrutinee expression: ${ast_expr_to_string(scrutinee_expr)}`
        )
      )
    );
    return(expr);
  });
  scr_info := match(
    scr_info_opt,
    .Some(si) => si,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(scrutinee_expr),
            `Internal error: no ExprInfo for scrutinee`
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  _adopt_env(env, scr_info.env);
  // A scrutinee reached from a local borrow: its arms' bindings are places a
  // re-point of that borrow may go through (plans/VALUES_BY_DEFAULT.md
  // decision 25).
  (lb_scr_source : Option(LocalBorrowInfo)) = cond(
    local_borrows_active() => local_borrow_scrutinee_source(scrutinee_expr, env, ctx),
    true => Option(LocalBorrowInfo).None
  );
  scrutinee_type := scr_info.ty;
  scrutinee_val_opt := scr_info.value;
  // Check pointer type — dereference one level
  (matched_type : TypeValue) = scrutinee_type;
  (is_ptr_match : bool) = false;
  if(is_pointer_type(scrutinee_type), {
    matched_type = match(scrutinee_type, .Pointer(inner) => inner, _ => scrutinee_type);
    is_ptr_match = true;
  });
  // Resolve a leaked recursive-enum SELF-SHELL (an empty-variant EnumT whose id
  // is registered in the enum-final registry) to its finalized form before
  // reading variants. The shell-patch in evaluate_enum_type replaces only ONE
  // level of self-nesting, so a deeper deref — e.g. matching `inner_func_box`
  // where `func : Rc(Self)` is two levels into AstExpr — surfaces the raw shell
  // here. Without this, the variant lookup throws "variant not found in
  // <enum:..._self_shell>" (the def-time body-eval of `is_function_boundary_arrow`
  // swallowed exactly that). Mirrors the resolve_enum_shell use sites in
  // synthesizer.yo / property_access.yo.
  matched_type = resolve_enum_shell(matched_type);
  scrutinee_is_enum := is_enum_type(matched_type);
  scrutinee_is_primitive := is_matchable_primitive_type(matched_type);
  // The type patterns are compiled against: the scrutinee's own type (the
  // compiler looks through one pointer level itself) with the shell resolved.
  position_type := cond(
    is_ptr_match => t_ptr(matched_type),
    true => matched_type
  );
  en_id := match(matched_type, .EnumT(eid, _, _, _, _, _, _, _, _, _) => eid, _ => String.new());
  // GADT match detection: the enum is a GADT, an expected
  // type exists to refine against, and this instantiation recorded its
  // type-constructor args. The entry expected type is CAPTURED here — the arm
  // loop overwrites ctx.expected_type with the running result type, so the
  // refinement (and the final stamp) must read the original.
  gadt_va_em := cond(scrutinee_is_enum => get_gadt_variant_args(en_id), true => Option(ArrayList(ArrayList(TypeValue))).None);
  gadt_tca_em := {
    tca_resolved_em := ArrayList(TypeValue).new();
    if(scrutinee_is_enum, {
      match(
        get_gadt_type_constructor_args(en_id),
        .Some(tca_raw_em) => {
          (tca_i_em : usize) = usize(0);
          while(tca_i_em < tca_raw_em.len(), {
            match(
              tca_raw_em.get(tca_i_em),
              .Some(tca_e_em) => {
                tca_resolved_em.push(gadt_resolve_tca_entry(tca_e_em));
              },
              .None => ()
            );
            tca_i_em = (tca_i_em + usize(1));
          });
        },
        .None => ()
      );
    });
    tca_resolved_em
  };
  gadt_exp_em := ctx.expected_type;
  is_gadt_match_em := (gadt_va_em.is_some() && gadt_exp_em.is_some() && (gadt_tca_em.len() > usize(0)));
  // Is the scrutinee's value known at compile time? (An enum must be a
  // concrete EnumVal, a primitive a concrete literal.)
  ct_known := match(
    scrutinee_val_opt,
    .Some(sv) => cond(
      is_unknown_val(sv) => false,
      scrutinee_is_enum => is_enum_val(sv),
      true => _is_literal_val(sv)
    ),
    .None => false
  );
  // How the match takes its scrutinee (plans/VALUES_BY_DEFAULT.md decision
  // 26): a consuming match moves it here, before any arm reads it.
  match_mode := _decide_match_mode(scrutinee_expr, evaluated_scrutinee, scr_info, borrowed_match_scrutinee_kind(ast_expr_token(expr)), env, ctx, exn);
  consuming := (match_mode == MATCH_MODE_CONSUME);
  mut_places := (match_mode == MATCH_MODE_MUT);
  // A consuming match over a type with drops: its arms own and drop parts,
  // which only the general lowering's per-arm bindings can express.
  consume_drops := (consuming && type_contains_rc_cell_or_move_only(scrutinee_type));
  (any_place_binder : bool) = false;
  // The arms codegen lowers when the match needs the general lowering: the
  // patterns with their hidden bindings (the checks below read the user's).
  cg_arms := ArrayList(Arm).new();
  // A `mut` match: its arms' bindings are exclusive borrows of the
  // scrutinee's place, which must be writable.
  (mut_place : Option(LocalBorrowPlace)) = Option(LocalBorrowPlace).None;
  (mut_root : Option(Variable)) = Option(Variable).None;
  if(mut_places, {
    mut_root = _scrutinee_root_variable(scrutinee_expr, env);
    mut_place = local_borrow_place_of(scrutinee_expr, env, ctx);
    match(
      mut_place,
      .Some(lp) => {
        local_borrow_require_writable(lp, `match \`${ast_expr_to_string(scrutinee_expr)}\` with \`&mut\``, ast_expr_token(scrutinee_expr), ctx, exn);
        local_borrow_access(lp, LocalBorrowAccess.Exclusive, ast_expr_token(scrutinee_expr), ctx, exn);
      },
      .None => ()
    );
  });
  // Arm loop state
  arms := ArrayList(Arm).new();
  bodies := ArrayList(AstExpr).new();
  (result_type_em : Option(TypeValue)) = Option(TypeValue).None;
  // Arms of type `never`: no part in the join, they adopt its type after it
  // (Phase 3.6; the cond twin is in exprs/cond.yo).
  never_bodies_em := ArrayList(AstExpr).new();
  (has_case_without_cf_em : bool) = false;
  control_flows_em := ArrayList(ControlFlowFlags).new();
  return_bodies_em := ArrayList(AstExpr).new();
  (matched_body_idx : Option(usize)) = Option(usize).None;
  // A compile-time-selectable match becomes undecidable when an arm that
  // would be selected carries a guard whose value is unknown.
  (ct_undecidable : bool) = false;
  (all_classic : bool) = true;
  // Sibling arms' initializations are invisible to each other (the
  // Impl(...) reassignment rule and the definite-initialization merge read
  // the arms' branch-init windows).
  // A nested construct whose evaluation threw inside a swallowing trial
  // leaves its group on the stack: arms and the exit truncate back to this
  // group so they never read a stranded one.
  bg_depth := branch_group_stack_len();
  group_log_start := branch_init_log_len();
  push_branch_group();
  // Each arm's window into the branch-init log, for merge_and_check_envs.
  arm_ranges := ArrayList(usize).new();
  // The arm evaluated last (see `reset_sibling_flow_state`).
  (prev_arm_body : Option(AstExpr)) = Option(AstExpr).None;
  (arm_i : usize) = usize(1);
  while(arm_i < all_args.len(), {
    arm_expr := match(
      all_args.get(arm_i),
      .Some(p) => p,
      .None => {
        arm_i = all_args.len();
        return(expr);
      }
    );
    arm_i = (arm_i + usize(1));
    if(!(ast_expr_is_fn_call_of(arm_expr, "=>", .Some(usize(2)))), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arm_expr),
            `Expected "=>" for match arm, got ${ast_expr_to_string(arm_expr)}`
          )
        )
      );
      return(expr);
    });
    (pattern_ast : AstExpr) = match(
      arm_expr,
      .FnCall(_, _, pargs, _, _) => match(pargs.get(usize(0)), .Some(a) => a, .None => make_err_expr()),
      .Atom(_, _) => make_err_expr()
    );
    body_ast := match(
      arm_expr,
      .FnCall(_, _, pargs, _, _) => match(pargs.get(usize(1)), .Some(a) => a, .None => make_err_expr()),
      .Atom(_, _) => make_err_expr()
    );
    // `{ x, y } => …` is a record pattern; `{ … }(params) => …` is a closure
    // with a capture list, which only a closure position accepts (decision
    // 35's parsing rule).
    if(ast_expr_is_capture_list_params(pattern_ast), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(pattern_ast),
            `A match arm's pattern cannot be \`${ast_expr_to_string(pattern_ast)}\`: \`{ … }(params) => body\` is a closure with a capture list, accepted only where a closure is expected. A record pattern is \`{ x, y } => body\`; to match on a closure's result, call it in the scrutinee.`
          )
        )
      );
    });
    // `(p && (g)) => body`: a guard.
    (guard_ast : Option(AstExpr)) = Option(AstExpr).None;
    if(ast_expr_is_fn_call_of(pattern_ast, "&&", .Some(usize(2))), {
      gargs := match(pattern_ast, .FnCall(_, _, ga, _, _) => ga, .Atom(_, _) => ArrayList(AstExpr).new());
      guard_ast = gargs.get(usize(1));
      pattern_ast = match(gargs.get(usize(0)), .Some(a) => a, .None => pattern_ast);
    });
    // Pre-arm frame count: the shared `env` must be restored to EXACTLY this
    // depth after evaluating the arm body, so each arm (and the post-loop
    // env merge) sees the same clean base. A single `pop_frame()` is NOT
    // enough: when the arm body is a begin-block whose tail `return`s,
    // evaluate_begin_expression leaves `env` one frame deep, so a lone pop
    // removes the begin frame and LEAKS this arm's pattern binding — a later
    // sibling arm then sees it at the same frame level and the env merge
    // throws "different variable names for different cases". Truncating to
    // `base_frame_count` removes both the stray begin frame and the arm frame
    // regardless. Use pop_frame_nonmutating so recorded body-env snapshots
    // (which may alias env.frames) are not corrupted.
    base_frame_count := env.frames.len();
    env.push_frame(false);
    // Compile the pattern (its constant tests evaluate in this frame), then
    // bind the names it introduces.
    pc := new_pattern_ctx(ast_expr_id(arm_expr), ct_known);
    pat := compile_pattern(
      pattern_ast,
      position_type,
      cond(ct_known => scrutinee_val_opt, true => Option(EvalValue).None),
      pc,
      env,
      ctx,
      exn
    );
    // A consuming or `mut` arm: which bindings own or are places, and (a
    // consuming match over a type with drops) the hidden bindings of the
    // parts the pattern leaves unbound and of the cells it looks through.
    own := _ArmOwnership(
      unbound : ArrayList(BindInfo).new(),
      keeps : ArrayList(BindInfo).new(),
      borrowed : ArrayList(String).new(),
      add_hidden : consume_drops,
      bind_tys : pc.binds,
      tok : ast_expr_token(arm_expr),
      counter : usize(0),
      is_mut : mut_places
    );
    (arm_pat : Pattern) = pat;
    if(consuming || mut_places, {
      arm_pat = _augment_arm_pattern(pat, position_type, false, own, env, exn);
    });
    owned_vars := ArrayList(Variable).new();
    place_vars := ArrayList(Variable).new();
    (bi : usize) = usize(0);
    while(bi < pc.binds.len(), {
      match(
        pc.binds.get(bi),
        .Some(b) => {
          _added := add_variable_to_env(
            env,
            b.name.clone(),
            b.ty,
            cond(ct_known => b.value, true => Option(EvalValue).None),
            ct_known,
            false,
            false,
            false,
            ast_expr_token(b.atom)
          );
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(b.atom), new_expr_info(env, b.ty));
          scope_release_note_binding(ast_expr_id(b.atom), env, b.name.clone());
          match(lb_scr_source, .Some(lbs) => local_borrow_note_pattern_binding(b.name.clone(), ast_expr_token(b.atom), lbs), .None => ());
          if(audit_pending_copies_enabled(), {
            match(_added, .Some(added_var) => audit_note_match_binding(added_var, scr_info), .None => ());
          });
          // Below a cell a binding borrows whatever the mode (decision 26).
          if((consuming || mut_places) && !_names_contain(own.borrowed, b.name.clone()), {
            match(
              _added,
              .Some(av) => {
                if(consuming, {
                  owned_vars.push(av);
                });
                if(mut_places, {
                  // A `mut` place: the binding aliases the part, so reads and
                  // writes go through it (the guard reads it; it becomes
                  // writable for the body).
                  av.is_ref = true;
                  place_vars.push(av);
                  any_place_binder = true;
                });
              },
              .None => ()
            );
          });
        },
        .None => ()
      );
      bi = (bi + usize(1));
    });
    unbound_vars := _add_hidden_bindings(own.unbound, env, ctx);
    keep_vars := _add_hidden_bindings(own.keeps, env, ctx);
    classic := arm_is_classic(pattern_ast, pat, guard_ast.is_some(), scrutinee_is_primitive);
    if(!(classic), {
      all_classic = false;
    });
    arm := Arm(pattern : pat, guard : guard_ast, body : body_ast, arm_expr : arm_expr, pattern_expr : pattern_ast, classic : classic);
    arms.push(arm);
    cg_arms.push(Arm(pattern : arm_pat, guard : guard_ast, body : body_ast, arm_expr : arm_expr, pattern_expr : pattern_ast, classic : false));
    // The top-level variant this arm names, when it names one (GADT
    // reachability and refinement key off it).
    top_variant_idx := match(pat, .Variant(_, vidx, _, _, _, _, _) => Option(usize).Some(vidx), _ => Option(usize).None);
    gadt_reachable := match(
      top_variant_idx,
      .Some(vidx) => gadt_branch_reachable(en_id.clone(), vidx),
      .None => true
    );
    // Compile-time arm selection.
    mv := cond(ct_known => match_value(pat, scrutinee_val_opt, ctx), true => Option(bool).None);
    // The guard, with the pattern's bindings in scope.
    (guard_val : Option(bool)) = Option(bool).None;
    match(
      guard_ast,
      .Some(g) => {
        // Evaluated WITHOUT an expected type: a non-bool guard must reach the
        // type check below with its own type, not fail inside the operator
        // dispatch against an expected `bool`.
        old_expected_g := ctx.expected_type;
        ctx.expected_type = Option(ExpectedTypeCtx).None;
        evaluated_g_gout := ArrayList(AstExpr).new();
        evaluated_g_gerr := evaluate_expression_guarded(g, env, ctx, evaluated_g_gout);
        ctx.expected_type = old_expected_g;
        match(evaluated_g_gerr, .Some(evaluated_g_ge) => exn.throw(evaluated_g_ge), .None => ());
        evaluated_g := match(evaluated_g_gout.get(usize(0)), .Some(evaluated_g_g) => evaluated_g_g, .None => make_err_expr());
        match(
          expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_g)),
          .Some(gi) => {
            if(!(are_types_compatible(gi.ty, t_bool())), {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(g),
                    `Match guard must be bool, got ${type_to_string(gi.ty)}`
                  )
                )
              );
              return(expr);
            });
            match(
              gi.value,
              .Some(.BoolVal(b)) => {
                guard_val = Option(bool).Some(b);
              },
              .Some(_) => (),
              .None => ()
            );
          },
          .None => {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(g),
                  `Failed to evaluate the match guard: ${ast_expr_to_string(g)}`
                )
              )
            );
            return(expr);
          }
        );
      },
      .None => ()
    );
    // An arm that can never run is not evaluated: a GADT-unreachable variant,
    // a variant arm a KNOWN enum scrutinee does not carry (the pre-IR
    // evaluator skipped exactly these — platform-specific bodies rely on it),
    // or a guard that folded to false. Its pattern node keeps no
    // `case_executed`, so codegen skips it too; it still takes part in the
    // exhaustiveness and unreachability checks below.
    ct_variant_miss := (scrutinee_is_enum && ct_known && match(mv, .Some(b) => !(b), .None => false));
    guard_false := match(guard_val, .Some(b) => !(b), .None => false);
    should_process := ((gadt_reachable && !(ct_variant_miss)) && !(guard_false));
    if(!(should_process), {
      while(env.frames.len() > base_frame_count, {
        env.pop_frame_nonmutating();
      });
    }, {
      // Stamp the pattern node for codegen: executed, typed as the selected
      // variant (or the scrutinee type), and — for a primitive-shaped arm —
      // its compared values for the `switch` emitter.
      variable_type := match(
        pat,
        .Variant(vname, _, _, _, venum, _, _) => {
          sel := match(
            venum,
            .EnumT(id, n, vn, vf, _, vfl, discs, eirs, eiar, etas) => TypeValue.EnumT(id, n, vn, vf, Option(String).Some(vname.clone()), vfl, discs, eirs, eiar, etas),
            _ => venum
          );
          cond(is_ptr_match => t_ptr(sel), true => sel)
        },
        _ => scrutinee_type
      );
      // Reuse the pattern node's ExprInfo when the compiler already stamped
      // one: for a top-level constant arm the pattern node IS the literal
      // inside its synthesized `==` test, and replacing its (value-carrying)
      // info made codegen render `"a"` as an identifier.
      mae_info := match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(pattern_ast)),
        .Some(existing) => existing,
        .None => new_expr_info(env, variable_type)
      );
      expr_info_set_case_executed(mae_info, Option(bool).Some(true));
      // The constant/range tests are synthesized nodes outside the source
      // AST. Codegen's collectors (functions, types) follow a node's
      // `macro_expansion`, so an arm the general lowering will emit hangs its
      // tests off the ARM's `=>` node as a `begin(...)` of them. NOT off the
      // pattern node: for a top-level constant arm (`"a" => …`) the pattern
      // node IS the literal inside its own test, and codegen's
      // generate-the-expansion rule then recursed forever (SIGBUS, measured).
      // The `=>` node is never generated as an expression, only walked.
      // A classic ENUM arm with a literal payload sub-pattern ALSO needs the
      // expansion: the coverage pass below may flip its group onto the
      // general lowering (the `case TAG:` block cannot fall through to the
      // later arms on a literal miss), and the expansion must already hang
      // off the `=>` node here, with the arm's own frame env in the info.
      if((!(classic)) || (scrutinee_is_enum && _variant_pattern_has_literal_sub(pat)) || consume_drops || mut_places, {
        tests := ArrayList(AstExpr).new();
        pattern_test_exprs(pat, tests);
        if(tests.len() > usize(0), {
          ptok := ast_expr_token(arm_expr);
          begin_atom := AstExpr.Atom(alloc_global_expr_id(), Token(kind : TokenKind.Identifier, value : intern_token_str(String.from(BK_BEGIN)), row : ptok.row, column : ptok.column, character : ptok.character, byte_offset : ptok.byte_offset, module_path : ptok.module_path, input : ptok.input));
          arm_info := new_expr_info(env, t_unit());
          expr_info_set_macro_expansion(arm_info, Option(AstExpr).Some(AstExpr.FnCall(alloc_global_expr_id(), begin_atom, tests, false, ptok)));
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(arm_expr), arm_info);
        });
      });
      if(scrutinee_is_primitive && classic, {
        pvals := pattern_const_values(pat);
        if(pvals.len() > usize(0), {
          expr_info_set_primitive_pattern_values(mae_info, Option(ArrayList(Option(EvalValue))).Some(pvals));
        });
      });
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(pattern_ast), mae_info);
      // Evaluate arm body
      is_arm_executing := (
        ct_known && match(mv, .Some(b) => b, .None => false) && match(
          guard_ast,
          .Some(_) => match(guard_val, .Some(b) => b, .None => false),
          .None => true
        )
      );
      old_executing := ctx.is_executing;
      ctx.is_executing = is_arm_executing;
      // An arm the comptime execution does not take (see
      // `FuncOrAsyncBlockCtx.ctfe_live`).
      arm_untaken_ct := (!(is_arm_executing) && fn_ctx_returns_comptime(ctx));
      if(arm_untaken_ct, {
        ctx.ctfe_untaken_arm_depth = (ctx.ctfe_untaken_arm_depth + usize(1));
      });
      // Running-result-type as expected type (bare `.None`/`.Variant` inference);
      // (`expectedType: resultType ?? context.expectedType`).
      old_expected := ctx.expected_type;
      match(
        result_type_em,
        .Some(rt) => {
          ctx.expected_type = Option(ExpectedTypeCtx).Some(ExpectedTypeCtx(ty : rt, env : env));
        },
        .None => ()
      );
      truncate_branch_group_stack((bg_depth + usize(1)));
      begin_branch_group_arm();
      reset_sibling_flow_state(env, prev_arm_body);
      bir_start_m := branch_init_log_len();
      // The arm is selected: a consuming arm's bindings take ownership of
      // their parts (the guard saw them as borrows), the parts it leaves
      // unbound are dropped now, and a `mut` arm's places become writable
      // exclusive borrows of the scrutinee (decision 26).
      if(consuming, {
        _own_all(owned_vars);
        _own_all(keep_vars);
        entry_drops := ArrayList(AstExpr).new();
        (ui0 : usize) = usize(0);
        while(ui0 < unbound_vars.len(), {
          match(
            unbound_vars.get(ui0),
            .Some(uv) => {
              uv.is_owning_the_rc_value = true;
              entry_drops.push(evaluate_expression_raw(generate_expr_from_code(`___drop(${uv.name})`, exn), env, ctx, exn));
              uv.consumed_at_token = Option(Rc(Token)).Some(rc(ast_expr_token(arm_expr)));
            },
            .None => ()
          );
          ui0 = (ui0 + usize(1));
        });
        if(entry_drops.len() > usize(0), {
          register_arm_entry_drops(ast_expr_id(arm_expr), entry_drops);
        });
      });
      if(mut_places, {
        (pi0 : usize) = usize(0);
        while(pi0 < place_vars.len(), {
          match(
            place_vars.get(pi0),
            .Some(pv) => {
              pv.is_reassignable = true;
              match(
                mut_root,
                .Some(rv) => {
                  variable_set_inout_borrow_root_id(pv, rv.id);
                  variable_mark_inout_borrow_root(rv);
                },
                .None => ()
              );
              match(mut_place, .Some(lp) => local_borrow_register_match_place(pv.name.clone(), pv.token, lp, body_ast), .None => ());
            },
            .None => ()
          );
          pi0 = (pi0 + usize(1));
        });
      });
      evaluated_body := evaluate_begin_expression(body_ast, env, ctx, ArrayList(Variable).new(), false, exn);
      // A binding the arm still owns after its body is dropped at the arm's
      // end (and at each `return` inside it).
      if(consuming, {
        _drop_owned_at_arm_end(owned_vars, evaluated_body, env, ctx, exn);
        _drop_owned_at_arm_end(keep_vars, evaluated_body, env, ctx, exn);
      });
      push_arm_init_range(arm_ranges, ast_expr_id(evaluated_body), bir_start_m, branch_init_log_len());
      prev_arm_body = Option(AstExpr).Some(body_ast);
      if(arm_untaken_ct, {
        ctx.ctfe_untaken_arm_depth = (ctx.ctfe_untaken_arm_depth - usize(1));
      });
      ctx.expected_type = old_expected;
      ctx.is_executing = old_executing;
      while(env.frames.len() > base_frame_count, {
        env.pop_frame_nonmutating();
      });
      body_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_body));
      if(body_info_opt.is_none(), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(body_ast),
              `Expected type for match result expression, got ${ast_expr_to_string(body_ast)}`
            )
          )
        );
        return(expr);
      });
      body_info := match(body_info_opt, .Some(bi2) => bi2, .None => new_expr_info(env, t_unit()));
      // Trim the arm body's recorded env to the outer depth on a PRIVATE copy:
      // the recorded snapshot is shared between ExprInfos (`expr_info_env_snapshot`),
      // so popping it in place would rewrite every sharer's recorded scope.
      if(body_info.env.frames.len() > base_frame_count, {
        trimmed_env := expr_info_adopt_env(body_info);
        while(trimmed_env.frames.len() > base_frame_count, {
          pop_env_frame(trimmed_env);
        });
        body_info.env = trimmed_env;
      });
      consume_case_body_temp_var(evaluated_body, body_info.env, ctx);
      // NOTE: do NOT null body_info.value here for a runtime/unknown
      // scrutinee. `body_info` IS the shared ExprInfo object stored in the
      // table for this arm-body node (ExprInfo is an object → reference);
      // nulling it corrupts the arm body's own stored value, so codegen reads
      // value=None and emits "Failed to transpile" for a foldable arm body
      // like `i32(0)` (whose value DID fold to 0). The match RESULT value is
      // already set to None for an unknown scrutinee by the post-loop, so the
      // per-arm nulling was redundant as well as harmful.
      if(has_any_control_flow(body_info.control_flow), {
        cf := match(
          body_info.control_flow,
          .Some(f) => f,
          .None => ControlFlowFlags(return_flag : false, unwind_flag : false, break_flag : false, continue_flag : false)
        );
        control_flows_em.push(cf);
        if(has_control_flow(body_info.control_flow, .Return), {
          return_bodies_em.push(evaluated_body);
        });
        // Concrete CT match with CF → set info early
        if(ct_known, {
          out_cf := new_expr_info(body_info.env, _arm_result_type(ctx, body_info.ty));
          out_cf.value = body_info.value;
          out_cf.control_flow = body_info.control_flow;
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_cf);
        }, {
          if(scrutinee_val_opt.is_none(), {
            out_cf2 := new_expr_info(body_info.env, _arm_result_type(ctx, body_info.ty));
            out_cf2.value = Option(EvalValue).None;
            out_cf2.control_flow = body_info.control_flow;
            expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_cf2);
          });
        });
      }, {
        has_case_without_cf_em = true;
        match(
          ctx.expected_type,
          .None => (),
          .Some(et) => {
            if(!(are_types_compatible(body_info.ty, et.ty)), {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(evaluated_body),
                    `Incompatible type with expected type:\n- Expected: ${type_to_string(et.ty)}\n- Actual  : ${type_to_string(body_info.ty)}`
                  )
                )
              );
              return(expr);
            });
          }
        );
      });
      bodies.push(evaluated_body);
      // Track the compile-time selected arm: the first arm whose pattern
      // matches the known value and whose guard does not fail.
      if(matched_body_idx.is_none() && !(ct_undecidable), {
        if(ct_known && match(mv, .Some(b) => b, .None => false), {
          match(
            guard_ast,
            .None => {
              matched_body_idx = Option(usize).Some(bodies.len() - usize(1));
            },
            .Some(_) => match(
              guard_val,
              .Some(gb) => {
                if(gb, {
                  matched_body_idx = Option(usize).Some(bodies.len() - usize(1));
                });
              },
              .None => {
                ct_undecidable = true;
              }
            )
          );
        });
      });
      // Result type consistency. A `never` arm is the join's identity.
      if(is_never_type(body_info.ty) && !(has_any_control_flow(body_info.control_flow)), {
        never_bodies_em.push(evaluated_body);
      });
      if(!(has_any_control_flow(body_info.control_flow)) && !(is_never_type(body_info.ty)), {
        if(is_gadt_match_em, {
          // GADT match: verify each branch body against
          // its GADT-REFINED expected type instead of cross-branch
          // consistency, and pin the result to the unrefined expected type.
          gadt_gra := match(
            gadt_va_em,
            .Some(av) => match(
              top_variant_idx,
              .Some(vidx2) => match(av.get(vidx2), .Some(g) => g, .None => ArrayList(TypeValue).new()),
              .None => ArrayList(TypeValue).new()
            ),
            .None => ArrayList(TypeValue).new()
          );
          match(
            gadt_exp_em,
            .Some(ge) => {
              if(gadt_gra.len() > usize(0), {
                refined := _gadt_refined_expected(ge.ty, gadt_tca_em, gadt_gra);
                if(!(are_types_compatible(body_info.ty, refined)), {
                  exn.throw(
                    dyn(
                      mark_generic_independent(
                        format_error_message(
                          ast_expr_token(evaluated_body),
                          `GADT type mismatch in branch "${pattern_to_string(pat)}":\n- Expected: ${type_to_string(refined)}\n- Actual  : ${type_to_string(body_info.ty)}`
                        ),
                        refined,
                        body_info.ty
                      )
                    )
                  );
                  return(expr);
                });
              });
              if(result_type_em.is_none(), {
                result_type_em = Option(TypeValue).Some(ge.ty);
              });
            },
            .None => ()
          );
        }, {
          match(
            result_type_em,
            .None => {
              result_type_em = Option(TypeValue).Some(body_info.ty);
            },
            .Some(rt) => {
              if(!(are_types_compatible(body_info.ty, rt)), {
                rt_rt := convert_comptime_type_to_runtime_type(rt, env);
                // Symmetric comptime-numeric join, as in exprs/cond.yo: a
                // previous comptime arm joins at this arm's concrete type
                // (issues/fixed/cond-arm-type-unification-depends-on-arm-order.md).
                if((((is_comptime_int_type(rt) || is_comptime_float_type(rt)) && are_types_compatible(rt, body_info.ty))) || are_types_compatible(body_info.ty, rt_rt), {
                  result_type_em = Option(TypeValue).Some(body_info.ty);
                }, {
                  exn.throw(
                    dyn(
                      format_error_message(
                        ast_expr_token(evaluated_body),
                        `Incompatible types in match branches:\n- Previous: ${type_to_string(rt)}\n- Current : ${type_to_string(body_info.ty)}`
                      )
                    )
                  );
                  return(expr);
                });
              });
            }
          );
        });
      });
    });
  });
  match(prev_arm_body, .Some(lab) => keep_last_arm_moves(env, lab, group_log_start), .None => ());
  truncate_branch_group_stack(bg_depth);
  // A consuming match over a type with drops, or a `mut` match that binds a
  // place, takes the general lowering (per-arm bindings, entry drops, C
  // pointers); a `mut` match that binds nothing is lowered as a borrow.
  force_general := (consume_drops || (mut_places && any_place_binder));
  if(force_general, {
    all_classic = false;
  });
  register_match_mode(ast_expr_id(expr), cond((mut_places && !(any_place_binder)) => MATCH_MODE_BORROW, true => match_mode));
  // ---------------------------------------------------------------------------
  // Variant-tag group coverage (soundness of the classic `case TAG:` shape)
  //
  // The tagged-union emitter lowers every arm of one variant to a single
  // `case TAG:` block, guarding each literal-payload arm with an `if` and
  // ending the block in a bare `break`. A value of the variant that NO arm
  // of the group matches must then run a LATER arm — a trailing `_`, which
  // the switch holds in `default:`, unreachable from inside the case — so
  // the guard miss skips every remaining arm and the result temp stays
  // uninitialized (issues/fixed/a-literal-sub-pattern-in-a-variant-arm-skips-
  // the-wildcard-arm.md). A group is sound only when its arms jointly match
  // every value of the variant; a group that does not (and has no unguarded
  // arm of its own variant, which would be its catch-all) forces the whole
  // match onto the general test-chain lowering, where a miss continues with
  // the next arm. Groups whose arms jointly cover (`.Some(true)` +
  // `.Some(false)`) keep today's switch shape byte-identically.
  // ---------------------------------------------------------------------------
  if(all_classic && scrutinee_is_enum, {
    g_idxs := ArrayList(usize).new();
    (gci : usize) = usize(0);
    while(gci < arms.len(), {
      match(
        arms.get(gci),
        .Some(ga) => match(
          ga.pattern,
          .Variant(_, gvidx, _, _, _, _, _) => {
            (known : bool) = false;
            (si : usize) = usize(0);
            while((si < g_idxs.len()) && !(known), {
              match(
                g_idxs.get(si),
                .Some(k) => {
                  known = (k == gvidx);
                },
                .None => ()
              );
              si = (si + usize(1));
            });
            if(!(known), {
              g_idxs.push(gvidx);
            });
          },
          _ => ()
        ),
        .None => ()
      );
      gci = (gci + usize(1));
    });
    (gi3 : usize) = usize(0);
    while(gi3 < g_idxs.len(), {
      target_idx := match(g_idxs.get(gi3), .Some(k) => k, .None => usize(0));
      (vname : String) = String.new();
      (varity : usize) = usize(0);
      (vptr : bool) = false;
      (vety : TypeValue) = TypeValue.Unit;
      grows := ArrayList(Pattern).new();
      (has_unguarded_group_arm : bool) = false;
      (ai3 : usize) = usize(0);
      while(ai3 < arms.len(), {
        match(
          arms.get(ai3),
          .Some(aa) => match(
            aa.pattern,
            .Variant(an, aidx, _, _, aety, aptr, aar) => if(aidx == target_idx, {
              vname = an;
              varity = aar;
              vptr = aptr;
              vety = aety;
              grows.push(aa.pattern);
              if(!(_variant_pattern_has_literal_sub(aa.pattern)), {
                has_unguarded_group_arm = true;
              });
            }),
            _ => ()
          ),
          .None => ()
        );
        ai3 = (ai3 + usize(1));
      });
      if((grows.len() > usize(0)) && !(has_unguarded_group_arm), {
        if(!(variant_group_covers(grows, vname, target_idx, varity, vptr, vety, position_type)), {
          // Uncovered: the switch shape would drop the miss. Flip the
          // group's arms onto the general lowering (their `=>` nodes
          // already carry the test expansions recorded in the arm loop).
          (fi3 : usize) = usize(0);
          while(fi3 < arms.len(), {
            match(
              arms.get(fi3),
              .Some(fa) => match(
                fa.pattern,
                .Variant(_, fidx, _, _, _, _, _) => if(fidx == target_idx, {
                  fa.classic = false;
                }),
                _ => ()
              ),
              .None => ()
            );
            fi3 = (fi3 + usize(1));
          });
          all_classic = false;
        });
      });
      gi3 = (gi3 + usize(1));
    });
  });
  register_match_arms(ast_expr_id(expr), cond(force_general => cg_arms, true => arms));
  // ---------------------------------------------------------------------------
  // Exhaustiveness and unreachability (usefulness over the compiled arms)
  // ---------------------------------------------------------------------------
  match(
    match_missing_witness(arms, position_type, false),
    .Some(witness) => {
      msg := cond(
        (witness == "_") =>
          `Match expression on ${type_to_string(matched_type)} requires a wildcard "_" or a binding arm for exhaustiveness.`,
        true => `Match expression is not exhaustive. Missing case: ${witness}`
      );
      // Say so when a guard is what leaves the value unmatched: counted as if
      // every guard held, the arms match it.
      guard_help := match(
        match_missing_witness(arms, position_type, true),
        .Some(w_all) => cond(
          (w_all == witness) => Option(String).None,
          true => Option(String).Some(String.from(_GUARD_HELP))
        ),
        .None => Option(String).Some(String.from(_GUARD_HELP))
      );
      exn.throw(dyn(format_error_message_with_help(ast_expr_token(expr), msg, guard_help)));
      return(expr);
    },
    .None => ()
  );
  // An arm for a variant the GADT index excludes is dead in the source only
  // when the index is the source's, not a generic specialization's.
  gadt_exact := (ctx.currently_specializing_function.is_none() && !(ctx.is_evaluating_generic_impl_specialization));
  (ui : usize) = usize(0);
  while(ui < arms.len(), {
    ua := match(
      arms.get(ui),
      .Some(a) => a,
      .None => {
        return(expr);
      }
    );
    ua_tok := ast_expr_token(ua.pattern_expr);
    match(
      arm_reachability(arms, ui, position_type, gadt_exact),
      .MatchesNothing(part, _) => {
        exn.throw(
          dyn(
            format_error_message(
              ua_tok,
              `Unreachable match arm: ${pattern_to_string(part)} — no value of type ${type_to_string(matched_type)} matches it`
            )
          )
        );
        return(expr);
      },
      .Subsumed(part, whole) => {
        by := cond(whole => "an earlier arm", true => "an earlier arm or an earlier alternative of its or-pattern");
        exn.throw(
          dyn(
            format_error_message(
              ua_tok,
              `Unreachable match arm: ${pattern_to_string(part)} — every value it matches is already matched by ${by}`
            )
          )
        );
        return(expr);
      },
      .Covered(part, whole) => {
        what := cond(whole => "match arm", true => "or-pattern alternative");
        emit_warning(
          warning_diagnostic_of_token(
            ua_tok,
            `unreachable ${what}: ${pattern_to_string(part)} — the patterns before it together match every value it matches`,
            Option(String).Some(`delete it, or move it above the patterns that cover it`)
          )
        );
      },
      .Reachable => ()
    );
    ui = (ui + usize(1));
  });
  // ---------------------------------------------------------------------------
  // Post-loop: final result
  // ---------------------------------------------------------------------------
  is_primitive_switch := (scrutinee_is_primitive && all_classic);
  final_cf_em := cond(
    (control_flows_em.len() > usize(0)) => Option(ControlFlowFlags).Some(merge_control_flows(control_flows_em)),
    true => Option(ControlFlowFlags).None
  );
  if(has_case_without_cf_em || !(has_any_control_flow(final_cf_em)), {
    // Every value arm diverges: the match itself is `never`.
    if(result_type_em.is_none() && (never_bodies_em.len() > usize(0)), {
      result_type_em = Option(TypeValue).Some(t_never());
    });
    if(has_case_without_cf_em && result_type_em.is_none(), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `Failed to determine the type of value from the match.`
          )
        )
      );
      return(expr);
    }, {
      if(result_type_em.is_none(), {
        result_type_em = Option(TypeValue).Some(t_unit());
      });
    });
    rt_em := match(result_type_em, .Some(t) => t, .None => t_unit());
    // A `comptime_int` arm joined at a fixed-width integer type must fit it
    // (the cond twin in exprs/cond.yo).
    (ci_mi : usize) = usize(0);
    while(ci_mi < bodies.len(), {
      ci_mb := match(bodies.get(ci_mi), .Some(b2) => b2, .None => make_err_expr());
      match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(ci_mb)),
        .Some(ci_mbi) => if(is_comptime_int_type(ci_mbi.ty) && !(has_any_control_flow(ci_mbi.control_flow)), {
          match(
            ci_mbi.value,
            .Some(ci_mv) => match(ci_mv, .IntLit(ci_mraw) => check_comptime_int_value_fits(ci_mraw, rt_em, ast_expr_token(ci_mb), exn), _ => ()),
            .None => ()
          );
        }),
        .None => ()
      );
      ci_mi = (ci_mi + usize(1));
    });
    // Select environment: concrete CT scrutinee → use matched body's env
    non_return_em := ArrayList(AstExpr).new();
    (nrem_i : usize) = usize(0);
    while(nrem_i < bodies.len(), {
      b_em := match(bodies.get(nrem_i), .Some(b2) => b2, .None => make_err_expr());
      match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(b_em)),
        .None => (),
        .Some(bi) => {
          // Only the arms that reach the join: a `break`/`continue` arm leaves
          // for the loop (its move state is snapshotted there, `break`/`continue`
          // in begin.yo), like a `return`/`unwind` arm leaves the function.
          if(!(has_any_control_flow(bi.control_flow)), {
            non_return_em.push(b_em);
          });
        }
      );
      nrem_i = (nrem_i + usize(1));
    });
    (matched_body_val : Option(EvalValue)) = Option(EvalValue).None;
    // Case 1: concrete scrutinee with matched_body_idx set
    (did_use_matched_body : bool) = false;
    if(matched_body_idx.is_some() && ct_known, {
      idx_em := match(matched_body_idx, .Some(i) => i, .None => usize(0));
      if(idx_em < bodies.len(), {
        mb := match(bodies.get(idx_em), .Some(b) => b, .None => make_err_expr());
        match(
          expr_info_table_get(ctx.expr_info_table, ast_expr_id(mb)),
          .None => (),
          .Some(mbi) => {
            _adopt_env(env, mbi.env);
            matched_body_val = mbi.value;
            did_use_matched_body = true;
          }
        );
      });
    });
    if(!(did_use_matched_body), {
      // Case 2: concrete scrutinee + single non-return body
      (did_use_single : bool) = false;
      match(
        scrutinee_val_opt,
        .None => (),
        .Some(sv) => {
          if(ct_known && (non_return_em.len() == usize(1)), {
            first_nrem := match(non_return_em.get(usize(0)), .Some(b) => b, .None => make_err_expr());
            match(
              expr_info_table_get(ctx.expr_info_table, ast_expr_id(first_nrem)),
              .None => (),
              .Some(bi) => {
                _adopt_env(env, bi.env);
                matched_body_val = bi.value;
                did_use_single = true;
              }
            );
          });
          // Case 3: unknown enum + single non-return body → use env only (no value)
          if((!(did_use_single) && is_unknown_val(sv)) && (non_return_em.len() == usize(1)), {
            first_nrem2 := match(non_return_em.get(usize(0)), .Some(b) => b, .None => make_err_expr());
            match(
              expr_info_table_get(ctx.expr_info_table, ast_expr_id(first_nrem2)),
              .None => (),
              .Some(bi) => {
                _adopt_env(env, bi.env);
                did_use_single = true;
              }
            );
          });
        }
      );
      // Case 4: runtime or multiple bodies → merge
      if(!(did_use_single), {
        reject_mixed_closure_arms(non_return_em, ctx, exn);
        env = merge_and_check_envs(env, non_return_em, group_log_start, arm_ranges, ctx, exn, Option(AstExpr).Some(expr));
      });
    });
    // Determine output value
    out_val_em := cond(
      scrutinee_val_opt.is_none() => Option(EvalValue).None,
      (matched_body_val.is_some() && !(ct_undecidable)) => matched_body_val,
      // A match over a RUNTIME-ONLY scrutinee is a runtime result — mark it
      // runtime-only so a comptime-only parameter cannot be filled with it
      // (TS: a runtime match has NO `$.value` at all; a plain UnknownVal is
      // the CTFE-analysis placeholder and would slip past helper.yo's
      // Step-5 check).
      match(scrutinee_val_opt, .Some(sv_ro2) => is_runtime_only_unknown_val(sv_ro2), .None => false) =>
        Option(EvalValue).Some(EvalValue.UnknownVal(rt_em.clone(), true)),
      true => Option(EvalValue).Some(create_unknown_val(rt_em))
    );
    result_ty_final_em := cond(
      // GADT match: the result IS the (unrefined) expected type even though
      // it contains SomeT.
      is_gadt_match_em => match(gadt_exp_em, .Some(ge_fin) => ge_fin.ty, .None => rt_em),
      true => _arm_result_type(ctx, rt_em)
    );
    (nb_mi : usize) = usize(0);
    while(nb_mi < never_bodies_em.len(), {
      match(never_bodies_em.get(nb_mi), .Some(nb) => adopt_never_type(nb, result_ty_final_em, ctx), .None => ());
      nb_mi = (nb_mi + usize(1));
    });
    out_em := new_expr_info(env, result_ty_final_em);
    out_em.value = out_val_em;
    if(is_primitive_switch, {
      expr_info_set_is_primitive_match(out_em, Option(bool).Some(true));
    });
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_em);
    attach_temp_variable_to_expr(expr, true, ctx);
  }, {
    // All arms have control flow
    if(control_flows_em.len() == usize(0), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `No control flows found but expected some.`
          )
        )
      );
      return(expr);
    });
    cond(
      has_control_flow(final_cf_em, .Return) => {
        if(ctx.is_evaluating_function_body_or_async_block.is_none(), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr),
                `All cases in match are returning from function, but not evaluating in function body.`
              )
            )
          );
          return(expr);
        });
        (ret_type_em : Option(TypeValue)) = Option(TypeValue).None;
        if(return_bodies_em.len() > usize(0), {
          first_rb_em := match(return_bodies_em.get(usize(0)), .Some(b) => b, .None => make_err_expr());
          match(
            expr_info_table_get(ctx.expr_info_table, ast_expr_id(first_rb_em)),
            .Some(bi) => {
              ret_type_em = Option(TypeValue).Some(bi.ty);
            },
            .None => ()
          );
        });
        if(ret_type_em.is_none(), {
          match(
            ctx.is_evaluating_function_body_or_async_block,
            .None => (),
            .Some(fctx) => {
              match(
                fctx.kind,
                .FunctionBody => {
                  match(
                    fctx.func_type,
                    .None => (),
                    .Some(ft) => {
                      match(
                        ft,
                        .Func({ result : result_box }) => {
                          ret_type_em = Option(TypeValue).Some(result_box);
                        },
                        _ => ()
                      );
                    }
                  );
                },
                _ => ()
              );
            }
          );
        });
        if(ret_type_em.is_none(), {
          match(
            ctx.expected_type,
            .None => (),
            .Some(et) => {
              ret_type_em = Option(TypeValue).Some(et.ty);
            }
          );
        });
        match(
          ret_type_em,
          .None => {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(expr),
                  `Failed to determine the return type for match statement.`
                )
              )
            );
            return(expr);
          },
          .Some(rt) => {
            is_fn_body_em := match(
              ctx.is_evaluating_function_body_or_async_block,
              .None => false,
              .Some(fctx) => match(fctx.kind, .FunctionBody => true, _ => false)
            );
            is_comptime_ret_em := cond(
              is_fn_body_em => match(
                ctx.is_evaluating_function_body_or_async_block,
                .None => false,
                .Some(fctx) => match(
                  fctx.func_type,
                  .None => false,
                  .Some(ft) => is_function_type_and_returns_comptime_value(ft)
                )
              ),
              true => false
            );
            ret_val_em := cond(
              is_comptime_ret_em => Option(EvalValue).Some(create_unknown_val(rt)),
              true => Option(EvalValue).None
            );
            out_ret_em := new_expr_info(env, rt);
            out_ret_em.value = ret_val_em;
            out_ret_em.control_flow = final_cf_em;
            if(is_primitive_switch, {
              expr_info_set_is_primitive_match(out_ret_em, Option(bool).Some(true));
            });
            expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_ret_em);
          }
        );
      },
      has_control_flow(final_cf_em, .Unwind) => {
        if(ctx.enclosing_function_return_type.is_none(), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr),
                `All cases in match use "unwind", but not inside a function with an enclosing function.`
              )
            )
          );
          return(expr);
        });
        esc_ty_em := match(ctx.enclosing_function_return_type, .Some(t) => t, .None => t_unit());
        out_esc_em := new_expr_info(env, esc_ty_em);
        out_esc_em.control_flow = final_cf_em;
        if(is_primitive_switch, {
          expr_info_set_is_primitive_match(out_esc_em, Option(bool).Some(true));
        });
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_esc_em);
      },
      has_control_flow(final_cf_em, .Break) => {
        if(ctx.is_evaluating_loop_body.is_none(), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr),
                `All cases in match are breaking from loop, but not inside a loop.`
              )
            )
          );
          return(expr);
        });
        out_brk_em := new_expr_info(env, t_unit());
        out_brk_em.value = Option(EvalValue).Some(EvalValue.UnitVal);
        out_brk_em.control_flow = final_cf_em;
        if(is_primitive_switch, {
          expr_info_set_is_primitive_match(out_brk_em, Option(bool).Some(true));
        });
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_brk_em);
      },
      has_control_flow(final_cf_em, .Continue) => {
        if(ctx.is_evaluating_loop_body.is_none(), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr),
                `All cases in match are continuing loop, but not inside a loop.`
              )
            )
          );
          return(expr);
        });
        out_cnt_em := new_expr_info(env, t_unit());
        out_cnt_em.value = Option(EvalValue).Some(EvalValue.UnitVal);
        out_cnt_em.control_flow = final_cf_em;
        if(is_primitive_switch, {
          expr_info_set_is_primitive_match(out_cnt_em, Option(bool).Some(true));
        });
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_cnt_em);
      },
      true => ()
    );
    return(expr);
  });
  expr
});
export(evaluate_match);
