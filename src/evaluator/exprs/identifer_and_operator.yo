//! Identifier and operator expression evaluator.
//!
//! Handles the resolution of identifier expressions:
//!   - Built-in type keywords (i32, bool, Type, Module, etc.)
//!   - Self, SelfTrait, SelfModule context references
//!   - Variable lookup with closure-capture tracking
{ String } :: import("std/string");
{ eprintln } :: import("std/fmt");
{ env : ident_dbg_env } :: import("std/env");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token, ast_expr_id } :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_paths_for_write,
  expr_info_set_origin_type
} :: import("../../expr_info.yo");
{ Token, string_is_operator } :: import("../../token.yo");
{ Environment, Variable, get_variables_from_env, env_candidate_names, find_variable_in_env, find_variable_in_env_at } :: import("../../env.yo");
{ EvalContext, FuncOrAsyncBlockKind, CaptureUsage, track_variable_usage, track_variable_usage_resolved, resolve_pending_definition, adopt_resolved_definition, is_unlabeled_ensures_atom }
:: import("../context.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_str, t_unit, t_bool, t_void, t_i8, t_i16, t_i32, t_i64, t_u8, t_u16, t_u32, t_u64, t_f32, t_f64, t_usize, t_isize, t_comptime_int, t_comptime_float, t_comptime_string, t_type, t_type_1, t_expr_t, t_c_char, t_c_short, t_c_ushort, t_c_int, t_c_uint, t_c_long, t_c_ulong, t_c_longlong, t_c_ulonglong, t_c_longdouble } :: import("../../types/creators.yo");
{ is_some_type, is_function_type } :: import("../../types/guards.yo");
{ type_key } :: import("../../types/type_key.yo");
{ is_type_hierarchy_type } :: import("../../types/guards.yo");
{ EvalValue, create_type_value, create_unknown_val, is_type_value, is_unknown_val }
:: import("../../value.yo");
{ get_value_of_some_type_from_env } :: import("../../types/env_lookup.yo");
{ format_error_message, format_error_message_with_help, format_error_message_with_repair, format_error_message_with_repair_at } :: import("../../error.yo");
{ suggest_name, lookup_std_exporters, Span } :: import("../../diagnostics.yo");
{ is_ghost_binding_name } :: import("../builtins/contracts.yo");
{ Exception } :: import("std/error");
/// Evaluate an identifier or operator expression.
///
/// Returns the (possibly annotated) expression after filling in its
/// `ExprInfo` entry in `ctx.expr_info_table`.
evaluate_identifier_and_operator :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    throw_error_on_undefined : bool,
    exn : Exception
  ) -> AstExpr
)({
  token := ast_expr_token(expr);
  // `str` view used for all literal comparisons; token.value (String) used for APIs.
  identifier := token.value.clone();
  // ------------------------------------------------------------------
  // Built-in type keywords
  // Match identifier to a TypeValue. If matched, build the ExprInfo
  // (value = TypeVal(ty), meta-type = Type(0)) and return immediately.
  // PERF: grouped by LENGTH — the former flat 33-arm chain issued up to
  // 33 `String == str` CALLS on EVERY identifier eval (nearly always
  // all-miss; a top self-time entry of the stage2-emit `sample`). One
  // numeric len() gate first, then at most 9 compares in the worst
  // bucket. (A hashed map was tried and MEASURED 26% SLOWER end-to-end:
  // hashing every identifier costs more than length-first rejections —
  // see the handoff perf section.)
  // ------------------------------------------------------------------
  id_len := identifier.len();
  type_kw_opt := cond(
    (id_len == usize(3)) => cond(
      (identifier == "str") => Option(TypeValue).Some(t_str()),
      (identifier == "i32") => Option(TypeValue).Some(t_i32()),
      (identifier == "u32") => Option(TypeValue).Some(t_u32()),
      (identifier == "u64") => Option(TypeValue).Some(t_u64()),
      (identifier == "i64") => Option(TypeValue).Some(t_i64()),
      (identifier == "u16") => Option(TypeValue).Some(t_u16()),
      (identifier == "i16") => Option(TypeValue).Some(t_i16()),
      (identifier == "f32") => Option(TypeValue).Some(t_f32()),
      (identifier == "f64") => Option(TypeValue).Some(t_f64()),
      (identifier == "int") => Option(TypeValue).Some(t_c_int()),
      true => Option(TypeValue).None
    ),
    (id_len == usize(4)) => cond(
      (identifier == "Type") => Option(TypeValue).Some(t_type()),
      (identifier == "unit") => Option(TypeValue).Some(t_unit()),
      (identifier == "bool") => Option(TypeValue).Some(t_bool()),
      (identifier == "char") => Option(TypeValue).Some(t_c_char()),
      (identifier == "uint") => Option(TypeValue).Some(t_c_uint()),
      (identifier == "long") => Option(TypeValue).Some(t_c_long()),
      (identifier == "void") => Option(TypeValue).Some(t_void()),
      (identifier == "Expr") => Option(TypeValue).Some(t_expr_t()),
      true => Option(TypeValue).None
    ),
    (id_len == usize(5)) => cond(
      (identifier == "usize") => Option(TypeValue).Some(t_usize()),
      (identifier == "isize") => Option(TypeValue).Some(t_isize()),
      (identifier == "Trait") => Option(TypeValue).Some(t_type_1()),
      (identifier == "short") => Option(TypeValue).Some(t_c_short()),
      (identifier == "ulong") => Option(TypeValue).Some(t_c_ulong()),
      true => Option(TypeValue).None
    ),
    (id_len == usize(2)) => cond(
      (identifier == "u8") => Option(TypeValue).Some(t_u8()),
      (identifier == "i8") => Option(TypeValue).Some(t_i8()),
      true => Option(TypeValue).None
    ),
    (id_len == usize(6)) => cond(
      (identifier == "ushort") => Option(TypeValue).Some(t_c_ushort()),
      true => Option(TypeValue).None
    ),
    (id_len == usize(8)) => cond(
      (identifier == "longlong") => Option(TypeValue).Some(t_c_longlong()),
      true => Option(TypeValue).None
    ),
    (id_len == usize(9)) => cond(
      (identifier == "ulonglong") => Option(TypeValue).Some(t_c_ulonglong()),
      true => Option(TypeValue).None
    ),
    (id_len == usize(10)) => cond(
      (identifier == "longdouble") => Option(TypeValue).Some(t_c_longdouble()),
      true => Option(TypeValue).None
    ),
    (id_len == usize(12)) => cond(
      (identifier == "comptime_int") => Option(TypeValue).Some(t_comptime_int()),
      (identifier == "comptime_str") => Option(TypeValue).Some(t_comptime_string()),
      true => Option(TypeValue).None
    ),
    (id_len == usize(14)) => cond(
      (identifier == "comptime_float") => Option(TypeValue).Some(t_comptime_float()),
      true => Option(TypeValue).None
    ),
    true => Option(TypeValue).None
  );
  // A LOCAL MAY SHADOW A C-INTEROP TYPE NAME.
  //
  // The table above resolves builtin type names before any env lookup, so a
  // binding called `long`, `int`, `char`, `short`, `uint` or `void` used to be
  // unreachable: every use resolved to the TYPE, and the diagnostic pointed at
  // the method ("No matching call found ... (long.push)") rather than at the
  // shadowing, so it read as "ArrayList has no push"
  // (issues/fixed/local-named-after-a-prelude-c-type-is-not-shadowed.md).
  //
  // Only the C interop vocabulary is exempted — those are ordinary English
  // words that people do name variables. Yo's own spellings (`i32`, `str`,
  // `bool`, `usize`, `Type`, …) keep resolving as types unconditionally: nobody
  // names a local `i32`, and `bool` in particular is also re-exported by the
  // prelude as a NAME (`export(bool : _boolean)`), so consulting the env for it
  // would change what an existing binding resolves to.
  c_type_shadowable := cond(
    (id_len == usize(3)) => (identifier == "int"),
    (id_len == usize(4)) => ((identifier == "char") || (identifier == "uint") || (identifier == "long") || (identifier == "void")),
    (id_len == usize(5)) => ((identifier == "short") || (identifier == "ulong")),
    (id_len == usize(6)) => (identifier == "ushort"),
    (id_len == usize(8)) => (identifier == "longlong"),
    (id_len == usize(9)) => (identifier == "ulonglong"),
    (id_len == usize(10)) => (identifier == "longdouble"),
    true => false
  );
  shadowed_by_binding := cond(
    c_type_shadowable => (get_variables_from_env(env, identifier.clone()).len() > usize(0)),
    true => false
  );
  match(
    type_kw_opt,
    .Some(ty) => {
      if(!shadowed_by_binding, {
        ev := create_type_value(ty);
        info := new_expr_info(env, t_type());
        info.value = Option(EvalValue).Some(ev);
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
        return(expr);
      });
    },
    .None => ()
  );
  // ------------------------------------------------------------------
  // Self — check context.self_type BEFORE looking up variables.
  // If Self is a SomeType that is bound in the env, resolve the concrete type.
  // ------------------------------------------------------------------
  self_type_opt := ctx.self_type;
  if((identifier == "Self") && self_type_opt.is_some(), {
    self_tv := match(self_type_opt, .Some(tv) => tv, .None => t_unit());
    resolved := if(is_some_type(self_tv), {
      bound := get_value_of_some_type_from_env(env, self_tv);
      if(ident_dbg_env.get(`YO_DEBUG_WARM`).is_some(), {
        st_r := if(is_some_type(bound), String.from("<unresolved-some>"), type_key(bound));
        eprintln(`[selfatom] path=ctx-some bound=${st_r} loc=${token.module_path}:${token.row.to_string()}:${token.column.to_string()}`);
      });
      if(is_some_type(bound), self_tv, bound)
    }, self_tv);
    if(ident_dbg_env.get(`YO_DEBUG_WARM`).is_some(), {
      eprintln(`[selfatom] resolved=${type_key(resolved)} mod=${env.module_path} loc=${token.module_path}:${token.row.to_string()}:${token.column.to_string()}`);
    });
    ev := create_type_value(resolved);
    info := new_expr_info(env, t_type());
    info.value = Option(EvalValue).Some(ev);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
    return(expr);
  });
  // ------------------------------------------------------------------
  // SelfTrait — refers to the trait type currently being defined
  // ------------------------------------------------------------------
  self_trait_opt := ctx.self_trait_type;
  if((identifier == "SelfTrait") && self_trait_opt.is_some(), {
    trait_tv := match(self_trait_opt, .Some(tv) => tv, .None => t_unit());
    ev := create_type_value(trait_tv);
    info := new_expr_info(env, t_type());
    info.value = Option(EvalValue).Some(ev);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
    return(expr);
  });
  // ------------------------------------------------------------------
  // SelfModule — refers to the module type currently being defined
  // ------------------------------------------------------------------
  self_module_opt := ctx.self_module_type;
  if((identifier == "SelfModule") && self_module_opt.is_some(), {
    module_tv := match(self_module_opt, .Some(tv) => tv, .None => t_unit());
    ev := create_type_value(module_tv);
    info := new_expr_info(env, t_type());
    info.value = Option(EvalValue).Some(ev);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
    return(expr);
  });
  // ------------------------------------------------------------------
  // Variable lookup
  // ------------------------------------------------------------------
  identifier_string := token.value;
  if((identifier == "Self") && ident_dbg_env.get(`YO_DEBUG_WARM`).is_some(), {
    env_self_cnt := get_variables_from_env(env, String.from("Self")).len();
    eprintln(`[selfatom] path=env-lookup self_vars=${env_self_cnt.to_string()} mod=${env.module_path} loc=${token.module_path}:${token.row.to_string()}:${token.column.to_string()}`);
  });
  found_frame_idx_out := ArrayList(usize).new();
  variable := match(
    find_variable_in_env_at(env, identifier_string, found_frame_idx_out),
    .Some(v) => {
      // V5 task 3: a `ghost(name := e)` binding is spec-only. Reading it
      // from ordinary code is the "ghost value escapes specification
      // context" error; contract predicates, ghost bindings and ghost_fn
      // bodies (all under is_ghost_context) read it freely.
      if(is_ghost_binding_name(identifier_string.clone()) && !ctx.is_ghost_context, {
        exn.throw(
          dyn(
            format_error_message(
              token,
              `ghost value escapes specification context: '${identifier_string}' is a ghost binding, readable only from contract clauses, ghost(...) code and ghost_fn bodies`
            )
          )
        );
        return(expr);
      });
      v
    },
    // Lazy top-level bindings (plans/reference/LAZY_TOPLEVEL_BINDINGS.md §4.2): a miss
    // on a name that is a deferred `::` definition of this identifier's own
    // module forces that definition now and binds it here. Def-time body
    // envs have FROZEN frame membership (private frame copies), so the bound
    // Variable is ADOPTED into this env's copy of the module frame — the
    // state an in-order definition would have left — and every by-name
    // lookup that follows (consumption, RC ownership, flowability) finds it.
    .None => match(
      resolve_pending_definition(identifier_string.clone(), token.module_path.clone()),
      .Resolved({ var : pending_var, frame_id : pending_frame_id }) => {
        found_frame_idx_out.push(adopt_resolved_definition(env, pending_var, pending_frame_id));
        pending_var
      },
      .Error({ msg : pending_msg }) => {
        exn.throw(dyn(pending_msg));
        return(expr);
      },
      .NotPending => {
        // Unresolved OPERATOR names keep the soft fallback.
        if(string_is_operator(identifier_string.clone()), {
          fallback_info := new_expr_info(env, t_unit());
          fallback_info.value = Option(EvalValue).Some(create_unknown_val(t_unit()));
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), fallback_info);
          return(expr);
        });
        // Phase V3: a `requires(...)`/`ensures(...)` predicate references
        // the signature's parameters and the return label — names with NO
        // binding in the env the marker evaluates in (the splice lowering
        // and the verifier's task-registration env are where they really
        // resolve). Soft-fall-back instead of throwing; the V1
        // label-the-return hint still applies to unlabeled ensures below.
        if(ctx.is_evaluating_contract_predicate, {
          pred_info := new_expr_info(env, t_unit());
          pred_info.value = Option(EvalValue).Some(create_unknown_val(t_unit()));
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), pred_info);
          return(expr);
        });
        // Ordinary identifiers throw.
        if(ident_dbg_env.get(`YO_DEBUG_SWALLOW`).is_some(), {
          eprintln(`[var-miss] name=${identifier_string} env_module=${env.module_path} frames=${env.frames.len().to_string()}`);
        });
        // The suggestion doubles as a MECHANICAL REPAIR: the token IS the
        // name to rewrite (plans/archive/LLM_FRIENDLY_TOOLCHAIN_AND_SYNTAX.md §2).
        // Kept separately from the help text so the repair survives the
        // ensures-atom branch below APPENDING advice to the help — a second
        // piece of advice means the rename is no longer the unique fix, and
        // that branch clears the repair for exactly that reason.
        not_found_suggestion := suggest_name(identifier_string, env_candidate_names(env));
        (not_found_repair : Option(String)) = not_found_suggestion;
        not_found_help := match(
          not_found_suggestion,
          .Some(h) => Option(String).Some(`did you mean "${h}"?`),
          .None => Option(String).None
        );
        // A name exported by std (audit §3.1 item 3): say which module, and
        // when EXACTLY ONE std module exports it and no rename is on offer,
        // the import line is the unique mechanical fix — inserted above the
        // first non-comment line, so a module's `//!` docs stay first. A
        // rename candidate AND an import candidate, or two exporting modules,
        // are two fixes: help only, `yo fix` never picks.
        std_exporters := lookup_std_exporters(identifier_string);
        (import_repair : Option(String)) = Option(String).None;
        if(std_exporters.len() > usize(0), {
          first_spec := match(std_exporters.get(usize(0)), .Some(s0) => s0, .None => String.new());
          import_line := `{ ${identifier_string} } :: import("${first_spec}");`;
          (spec_list : String) = String.new();
          (sxi : usize) = usize(0);
          while(sxi < std_exporters.len(), {
            match(
              std_exporters.get(sxi),
              .Some(sx) => {
                if(sxi > usize(0), {
                  spec_list.push_str(", ");
                });
                spec_list.push_string(sx.clone());
              },
              .None => ()
            );
            sxi = (sxi + usize(1));
          });
          import_hint := if(
            std_exporters.len() == usize(1),
            `import it: \`${import_line}\``,
            `it is exported by ${std_exporters.len().to_string()} std modules (${spec_list}) — import one of them`
          );
          not_found_help = match(
            not_found_help,
            .Some(h) => Option(String).Some(`${h} ${import_hint}`),
            .None => Option(String).Some(import_hint)
          );
          if(std_exporters.len() == usize(1), {
            if(not_found_repair.is_none(), {
              import_repair = Option(String).Some(import_line.clone());
            });
            // Rename OR import: two candidates, neither unique.
            not_found_repair = Option(String).None;
          });
        });
        if(is_unlabeled_ensures_atom(ast_expr_id(expr)), {
          // Phase V1 (decision D3, plans/backlog/FORMAL_VERIFICATION.md): the
          // atom sits in an `ensures(...)` predicate of an unlabeled-return
          // function — the missing name is almost certainly the return value
          // the author wants to constrain. Append the targeted hint to the
          // ordinary not-found error (additive, not a new error class).
          label_hint := `to name the return value in 'ensures(...)', label the return: '-> (${identifier_string} : <type>)'`;
          not_found_help = match(
            not_found_help,
            .Some(h) => Option(String).Some(`${h} ${label_hint}`),
            .None => Option(String).Some(label_hint)
          );
          // Two candidate fixes now (rename, or label the return), so neither
          // is unique — `yo fix` must not pick one.
          not_found_repair = Option(String).None;
          import_repair = Option(String).None;
        });
        exn.throw(
          dyn(
            match(
              not_found_repair,
              .Some(fix_name) => format_error_message_with_repair(
                token,
                `Variable "${identifier_string}" not found.`,
                not_found_help,
                fix_name.clone(),
                `rename to "${fix_name}"`
              ),
              .None => match(
                import_repair,
                .Some(line) => format_error_message_with_repair_at(
                  token,
                  `Variable "${identifier_string}" not found.`,
                  not_found_help,
                  Span(path : token.module_path, row : _first_code_row(token.input), col : usize(0), len : usize(0)),
                  `${line}\n`,
                  `add ${line}`
                ),
                .None => format_error_message_with_help(
                  token,
                  `Variable "${identifier_string}" not found.`,
                  not_found_help
                )
              )
            )
          )
        );
        return(expr);
      }
    )
  );
  // Check initialization (unless it's a function type or type value — mutual recursion)
  if((variable.initialized_at_token == Option(Token).None) && throw_error_on_undefined, {
    if(!(is_function_type(variable.ty) || is_type_value(variable.value.get(usize(0)))), {
      exn.throw(
        dyn(
          format_error_message(
            token,
            String.from("Variable \"") + identifier_string + String.from("\" is not initialized")
          )
        )
      );
    });
  });
  // c_include constants (e.g. O_RDONLY from <fcntl.h>) have UnknownValue.
  // NOTE: `is_extern` is not consulted here; skip the runtime-value
  // special-case and always use the variable's compile-time value.
  resolved_value := variable.value.get(usize(0));
  // Build ExprInfo
  info := new_expr_info(env, variable.ty);
  info.value = resolved_value;
  expr_info_set_origin_type(info, Option(TypeValue).Some(variable.ty));
  info.variable_name = Option(String).Some(variable.name);
  info.source_variable = Option(Variable).Some(variable);
  // Add [[variable.name]] to path_collection
  name_path := ArrayList(String).new();
  name_path.push(variable.name);
  expr_info_paths_for_write(info).push(name_path);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  // ------------------------------------------------------------------
  // Closure capture tracking — function body
  // ------------------------------------------------------------------
  match(
    ctx.is_evaluating_function_body_or_async_block,
    .Some(sub_ctx) => {
      match(
        sub_ctx.kind,
        .FunctionBody => {
          match(
            ctx.captured_variables,
            .Some(_) => {
              closure_frame_level := sub_ctx.eval_env.frame_count();
              // Generation-safe INNER test: `variable.frame_level` is stamped
              // at the variable's CREATION env — for the enclosing fn's
              // PARAMS that is a DEEP call-time generation, so comparing it
              // against THIS eval's shallow frame count wrongly classified
              // them as inner and never tracked them (the dyn+Impl(Fn)
              // capture loss, issues/repros/dyn-closure-implfn-capture-loss
              // .yo: params dropped, same-generation locals kept). A
              // variable is inner iff its NAME is bound within the closure's
              // OWN frames (frames at/above closure_frame_level in the
              // CURRENT env — same generation by construction: the
              // FunctionBody ctx is created with the very env the body
              // evaluates in). Names not bound there are outer → captured.
              // Inner iff the name is bound within the closure's OWN frames.
              // Under innermost-first resolution that is EXACTLY "the frame
              // the lookup found it at is >= closure_frame_level" — the
              // index find_variable_in_env_at already recovered. The former
              // per-identifier frames x vars name RESCAN here was a top
              // self-time entry of the stage2-emit `sample` (with its
              // String == calls the #2 entry).
              (cap_is_inner : bool) = false;
              match(
                found_frame_idx_out.get(usize(0)),
                .Some(cap_found_fi) => if(cap_found_fi >= closure_frame_level, {
                  cap_is_inner = true;
                }),
                .None => ()
              );
              if(ident_dbg_env.get(`YO_DEBUG_CAPTURE`).is_some(), {
                cap_dbg_fi := match(found_frame_idx_out.get(usize(0)), .Some(v) => v.to_string(), .None => `?`.to_string());
                cap_dbg_ev_top := match(sub_ctx.eval_env.frames.get(closure_frame_level - usize(1)), .Some(fr) => fr.id.to_string(), .None => `?`.to_string());
                cap_dbg_cur_top := match(env.frames.get(env.frames.len() - usize(1)), .Some(fr2) => fr2.id.to_string(), .None => `?`.to_string());
                eprintln(`[cap-fb] name=${variable.name} found_fi=${cap_dbg_fi} closure_fl=${closure_frame_level.to_string()} var_fl=${variable.frame_level.to_string()} inner=${cap_is_inner.to_string()} ev_top=${cap_dbg_ev_top} cur_frames=${env.frames.len().to_string()} cur_top=${cap_dbg_cur_top}`);
              });
              if(!cap_is_inner && (variable.frame_level < closure_frame_level), {
                track_variable_usage_resolved(
                  variable.name,
                  variable.frame_level,
                  CaptureUsage.Own,
                  token,
                  ctx,
                  Option(bool).Some(variable.is_compile_time_only)
                );
              });
              if(!cap_is_inner && (variable.frame_level >= closure_frame_level), {
                // Cross-generation outer variable (stamped deeper than this
                // eval's frames): record it with a level INSIDE the current
                // generation so the enrichment/access-rewriting math stays
                // in range.
                (cap_rec_level : usize) = usize(0);
                if(closure_frame_level > usize(0), {
                  cap_rec_level = (closure_frame_level - usize(1));
                });
                track_variable_usage_resolved(
                  variable.name,
                  cap_rec_level,
                  CaptureUsage.Own,
                  token,
                  ctx,
                  Option(bool).Some(variable.is_compile_time_only)
                );
              });
            },
            .None => ()
          );
        },
        .AsyncBlock => {
          match(
            ctx.captured_variables,
            .Some(_) => {
              async_frame_level := sub_ctx.eval_env.frame_count();
              // Generation-safe INNER test — the SAME repair the FunctionBody
              // arm above carries (the dyn+Impl(Fn) capture loss), which this
              // arm never got: `variable.frame_level` is stamped at the
              // variable's CREATION env, and for a SPECIALIZED generic fn's
              // PARAMS that is a deep call-time generation, so the old
              // `frame_level < async_frame_level` test wrongly classified
              // them as inner and the async closure's capture struct dropped
              // them — the emitted C then read `buf`/`size`/`io` as bare
              // identifiers (loud clang failure) or garbage (rc=139).
              // issues/fixed/async-loop-awaiting-buffer-taking-method-state-machine-corruption.md.
              // A variable is inner iff the frame the lookup FOUND it at is
              // >= async_frame_level in the CURRENT env (same generation by
              // construction).
              (ab_is_inner : bool) = false;
              match(
                found_frame_idx_out.get(usize(0)),
                .Some(ab_found_fi) => if(ab_found_fi >= async_frame_level, {
                  ab_is_inner = true;
                }),
                .None => ()
              );
              if(!ab_is_inner && (variable.frame_level < async_frame_level), {
                track_variable_usage_resolved(
                  variable.name,
                  variable.frame_level,
                  CaptureUsage.Own,
                  token,
                  ctx,
                  Option(bool).Some(variable.is_compile_time_only)
                );
              });
              if(!ab_is_inner && (variable.frame_level >= async_frame_level), {
                // Cross-generation outer variable: record it with a level
                // inside the current generation so the enrichment /
                // access-rewriting math stays in range (as in the
                // FunctionBody arm).
                (ab_rec_level : usize) = usize(0);
                if(async_frame_level > usize(0), {
                  ab_rec_level = (async_frame_level - usize(1));
                });
                track_variable_usage_resolved(
                  variable.name,
                  ab_rec_level,
                  CaptureUsage.Own,
                  token,
                  ctx,
                  Option(bool).Some(variable.is_compile_time_only)
                );
              });
            },
            .None => ()
          );
        },
        _ => ()
      );
    },
    .None => ()
  );
  expr
});
/// The row of the first line that is neither blank nor a `//` comment — where
/// the E0401 import repair inserts its line, so `//!` module docs stay first.
_first_code_row :: (fn(source : String) -> usize)({
  lines := source.split(String.from("\n"));
  (r : usize) = usize(0);
  while(r < lines.len(), {
    t := match(lines.get(r), .Some(l) => l.trim(), .None => String.new());
    if((t.len() > usize(0)) && !t.starts_with(String.from("//")), {
      return(r);
    });
    r = (r + usize(1));
  });
  usize(0)
});
export(evaluate_identifier_and_operator);
