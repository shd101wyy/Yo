//! evaluate_while — evaluates `while(...)` loops.
//! 1:1 port of `src/evaluator/exprs/while.ts` (Phase 2ad).
//!
//! Phase 2 stubs:
//!   - Comptime while loop unrolling with runtime body (cloneExpr path) deferred to Phase 3
//!
//! Exported symbols: evaluate_while
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_atom_of,
  ast_expr_is_fn_call_of,
  make_err_expr,
  BK_COMPTIME,
  BK_BEGIN,
  BK_WHILE,
  BF_INVARIANT,
  clone_expr_fresh_ids
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set,
  ControlFlowFlags,
  has_control_flow,
  has_any_control_flow
} :: import("../../expr_info.yo");
{ expr_contains_loop_terminator } :: import("../../expr_traversal.yo");
{ Environment } :: import("../../env.yo");
{ Variable } :: import("../../env.yo");
{ EvalContext, LoopBodyCtx, LoopKind } :: import("../context.yo");
{ EvalValue, is_unknown_val } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ is_bool_type, is_unit_type } :: import("../../types/guards.yo");
{ convert_comptime_type_to_runtime_type } :: import("../../types/env_lookup.yo");
{ type_to_string } :: import("../../types/string.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_begin_expression } :: import("./begin.yo");
{ evaluate_expression_raw } :: import("./expr.yo");
{ Exception } :: import("std/error");
// `env` is the Environment parameter name throughout this file, so std/env's
// process-environment namespace is bound under a different name (main.yo:19
// does the same).
_(env : proc_env) :: import("std/env");
// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------
/// Default maximum number of compile-time while loop iterations before bailing
/// out. Mirrors the `MAX_COMPTIME_LOOP_ITERATIONS` IIFE in
/// `src/evaluator/exprs/while.ts:34-41`.
DEFAULT_MAX_COMPTIME_LOOP_ITERATIONS :: usize(10000);
/// Memoized resolution of the limit. Read once per process: the limit is tested
/// once per unrolled iteration, so a fresh `env.get` per test would allocate a
/// String up to `limit` times per comptime loop.
(_g_max_comptime_loop_iterations : Option(usize)) = Option(usize).None;
/// The effective limit: `YO_MAX_COMPTIME_LOOP_ITERATIONS` when it parses as a
/// positive integer, else the default — the behavior the two "To increase the
/// limit, set the YO_MAX_COMPTIME_LOOP_ITERATIONS environment variable" halves
/// of `_throw_max_iterations_error` promise. (TS uses `parseInt`, which also
/// accepts trailing garbage such as `12abc`; `parse_u64` rejects it and falls
/// back to the default. Rejecting a malformed value is the safer half of that
/// divergence.)
max_comptime_loop_iterations :: (fn() -> usize)(
  match(
    _g_max_comptime_loop_iterations,
    .Some(cached) => cached,
    .None => {
      resolved := match(
        proc_env.get(String.from("YO_MAX_COMPTIME_LOOP_ITERATIONS")),
        .None => DEFAULT_MAX_COMPTIME_LOOP_ITERATIONS,
        .Some(raw) => match(
          raw.parse_u64(),
          .None => DEFAULT_MAX_COMPTIME_LOOP_ITERATIONS,
          .Some(parsed) => cond(
            (parsed > u64(0)) => usize(parsed),
            true => DEFAULT_MAX_COMPTIME_LOOP_ITERATIONS
          )
        )
      );
      _g_max_comptime_loop_iterations = Option(usize).Some(resolved);
      resolved
    }
  )
);
// ---------------------------------------------------------------------------
// Phase 0 of plans/FORMAL_VERIFICATION.md §A2: loop invariants must appear as
// the first statement of the loop body. 1:1 port of
// `enforceLoopInvariantPlacement` / `walkForMisplacedInvariant`
// (src/evaluator/exprs/while.ts:106-166).
// ---------------------------------------------------------------------------
/// Find any `invariant(...)` call NESTED inside an expression (cond/match
/// branches, nested begin blocks). Returns the offending node instead of
/// throwing: an `exn.throw` from inside this recursive helper was measured
/// INERT under the def-time trial exn chain (the escaped-flag early-return
/// is not honored here — execution continued past the throw and the
/// misplacement was never reported; tests/spec/contracts_phase0 arm 8).
/// The caller (`evaluate_while`) throws from its own frame instead.
/// Does NOT descend into nested `while(...)` bodies — those are checked by
/// their own `_enforce_loop_invariant_placement` call.
_find_misplaced_invariant :: (fn(expr : AstExpr) -> Option(AstExpr))({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => return(Option(AstExpr).None)
  );
  if(ast_expr_is_fn_call_of(expr, BF_INVARIANT, Option(usize).None), {
    return(Option(AstExpr).Some(expr));
  });
  if(ast_expr_is_fn_call_of(expr, BK_WHILE, Option(usize).None), {
    return(Option(AstExpr).None);
  });
  (found : Option(AstExpr)) = Option(AstExpr).None;
  (wi : usize) = usize(0);
  while((wi < args.len()) && found.is_none(), {
    match(
      args.get(wi),
      .Some(sub) => {
        found = recur(sub);
      },
      .None => ()
    );
    wi = (wi + usize(1));
  });
  found
});
/// Enforce that `invariant(...)` appears only as the first statement of a
/// loop body. Returns the offending node and whether it was a NON-FIRST
/// direct statement (true) or nested in a branch/block (false); the caller
/// throws (see _find_misplaced_invariant on why no throw happens here).
InvariantViolation :: struct(node : AstExpr, non_first_stmt : bool);
_enforce_loop_invariant_placement :: (fn(body_expr : AstExpr) -> Option(InvariantViolation))({
  stmts := cond(
    ast_expr_is_fn_call_of(body_expr, BK_BEGIN, Option(usize).None) => match(
      body_expr,
      .FnCall(_, _, a, _, _) => a,
      .Atom(_, _) => ArrayList(AstExpr).new()
    ),
    true => {
      single := ArrayList(AstExpr).new();
      single.push(body_expr);
      single
    }
  );
  (si : usize) = usize(0);
  while(si < stmts.len(), {
    stmt := match(stmts.get(si), .Some(s) => s, .None => make_err_expr());
    idx := si;
    si = (si + usize(1));
    is_inv := ast_expr_is_fn_call_of(stmt, BF_INVARIANT, Option(usize).None);
    cond(
      (is_inv && (idx == usize(0))) => (),
      is_inv => {
        return(Option(InvariantViolation).Some(InvariantViolation(node : stmt, non_first_stmt : true)));
      },
      true => {
        match(
          _find_misplaced_invariant(stmt),
          .Some(bad) => {
            return(Option(InvariantViolation).Some(InvariantViolation(node : bad, non_first_stmt : false)));
          },
          .None => ()
        );
      }
    );
  });
  Option(InvariantViolation).None
});
// ---------------------------------------------------------------------------
// Helper: _body_has_any_terminator_guaranteed / _body_has_any_terminator_possible
// ---------------------------------------------------------------------------
/// True when the body is GUARANTEED to terminate via break/return/unwind
/// control-flow flags (i.e. every execution path terminates).
///
/// Mirrors the `guaranteed` field of `bodyHasAnyTerminator` in `while.ts`.
_body_has_any_terminator_guaranteed :: (
  fn(
    body_info_cf : Option(ControlFlowFlags)
  ) -> bool
)(
  has_control_flow(body_info_cf, .Break) ||
    (
      has_control_flow(body_info_cf, .Return) ||
        has_control_flow(body_info_cf, .Unwind)
    )
);
/// True when the body MIGHT terminate (either guaranteed or the AST contains
/// any loop-terminator atom/call reachable through a conditional branch).
///
/// Mirrors the `possible` field of `bodyHasAnyTerminator` in `while.ts`.
_body_has_any_terminator_possible :: (
  fn(
    body_expr : AstExpr,
    body_info_cf : Option(ControlFlowFlags)
  ) -> bool
)(
  _body_has_any_terminator_guaranteed(body_info_cf) ||
    expr_contains_loop_terminator(body_expr)
);
// ---------------------------------------------------------------------------
// Helper: _throw_max_iterations_error
// ---------------------------------------------------------------------------
/// Throw an appropriate error for a compile-time while loop that exceeded the
/// maximum iteration count.
///
/// Mirrors `throwMaxIterationsError` in `src/evaluator/exprs/while.ts`.
_throw_max_iterations_error :: (
  fn(
    expr : AstExpr,
    body_expr : AstExpr,
    body_info_cf : Option(ControlFlowFlags),
    exn : Exception
  ) -> AstExpr
)({
  possible := _body_has_any_terminator_possible(body_expr, body_info_cf);
  // Store in local variable to avoid taking address of rvalue literal in C codegen.
  limit := max_comptime_loop_iterations();
  err_msg := cond(
    possible =>
      `Compile-time while loop exceeded the maximum iteration count (${limit.to_string()}). The loop body contains a conditional \`break\`, \`return\`, or \`unwind\`, but the loop did not terminate within the limit.\nIf this is an infinite runtime loop, use \`while true, { ... }\` instead.\nTo increase the limit, set the YO_MAX_COMPTIME_LOOP_ITERATIONS environment variable.`,
    true =>
      `Infinite compile-time while loop detected. The condition is compile-time \`true\` but the loop body has no \`break\`, \`return\`, or \`unwind\` to terminate it.\nIf you need an infinite runtime loop, use \`while true, { ... }\` without the comptime modifier.\nTo increase the limit, set the YO_MAX_COMPTIME_LOOP_ITERATIONS environment variable.`
  );
  exn.throw(dyn(format_error_message(ast_expr_token(expr), err_msg, false, .None)));
  make_err_expr()
});
// ---------------------------------------------------------------------------
// evaluate_while — main function
// ---------------------------------------------------------------------------
/// Evaluate a `while(...)` or `while comptime(...), ...` loop expression.
///
/// Supports both the 2-argument form (`while condition, body`) and the
/// 3-argument form (`while condition, step, body`).
///
/// Parameters:
///   - `expr`                      The while() call expression to evaluate.
///   - `env_in`                    Environment at the call site.
///   - `ctx`                       Mutable evaluator context.
///   - `comptime_iteration_count`  Recursion depth for compile-time unrolling.
///
/// Mirrors `evaluateWhile` in `src/evaluator/exprs/while.ts`.
evaluate_while :: (
  fn(
    expr : AstExpr,
    env_in : Environment,
    ctx : EvalContext,
    comptime_iteration_count : usize,
    exn : Exception
  ) -> AstExpr
)({
  (env : Environment) = env_in;
  // Support both 2-argument (while condition, body) and
  // 3-argument (while condition, step, body) forms.
  // Follow cond.yo pattern: extract args list once, then derive length.
  all_args := match(
    expr,
    .FnCall(_, _, args, _, _) => args,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  n_args := all_args.len();
  if((n_args != usize(2)) && (n_args != usize(3)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected 2 or 3 arguments for while loop, got ${n_args.to_string()}`,
          false,
          .None
        )
      )
    );
  });
  // Extract body and optional step expressions.
  body_idx := cond((n_args == usize(3)) => usize(2), true => usize(1));
  body_expr := match(all_args.get(body_idx), .Some(e) => e, .None => make_err_expr());
  (step_expr_opt : Option(AstExpr)) = Option(AstExpr).None;
  if(n_args == usize(3), {
    step_opt_inner := match(all_args.get(usize(1)), .Some(e) => e, .None => make_err_expr());
    step_expr_opt = Option(AstExpr).Some(step_opt_inner);
  });
  // Phase 0 invariant-placement rule: inside a `while(...)` body,
  // `invariant(...)` may only appear as the first statement of the loop body.
  // See plans/FORMAL_VERIFICATION.md §A2 / while.ts:206-211. The helper
  // RETURNS the violation and the throw happens here — see its doc comment.
  match(
    _enforce_loop_invariant_placement(body_expr),
    .Some(inv_viol) => {
      inv_msg := cond(
        inv_viol.non_first_stmt => String.from("'invariant(...)' must be the first statement of a 'while(...)' loop body. Move this invariant to the top of the loop body, before any other statements."),
        true => String.from("'invariant(...)' must be the first statement of the enclosing 'while(...)' loop body. It cannot appear inside cond/match branches, nested blocks, or as a non-first statement.")
      );
      exn.throw(dyn(format_error_message(ast_expr_token(inv_viol.node), inv_msg, false, .None)));
    },
    .None => ()
  );
  // Detect comptime() modifier on the condition.
  // Re-detected on each recursive call so the AST stays clean across evaluations.
  raw_cond_expr := match(all_args.get(usize(0)), .Some(e) => e, .None => make_err_expr());
  is_comptime_modifier := ast_expr_is_fn_call_of(raw_cond_expr, BK_COMPTIME, .Some(usize(1)));
  inner_cond_expr := cond(
    is_comptime_modifier => match(
      raw_cond_expr,
      .FnCall(_, _, cargs, _, _) => match(cargs.get(usize(0)), .Some(e) => e, .None => make_err_expr()),
      .Atom(_, _) => make_err_expr()
    ),
    true => raw_cond_expr
  );
  // NOTE: Use evaluateBeginExpression here so RC values in the condition are
  // properly managed by the begin-block frame.
  // Evaluate the inner condition expression (without the comptime() wrapper).
  evaluated_cond_expr := evaluate_begin_expression(
    inner_cond_expr,
    env,
    ctx,
    ArrayList(Variable).new(),
    false,
    exn
  );
  // Require ExprInfo for the condition.
  cond_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_cond_expr));
  if(cond_info_opt.is_none(), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(inner_cond_expr),
          `Failed to evaluate the condition expression: ${ast_expr_to_string(inner_cond_expr)}`,
          false,
          .None
        )
      )
    );
  });
  cond_info := match(
    cond_info_opt,
    .Some(ci) => ci,
    .None => {
      return(expr);
    }
  );
  // Require bool type for the condition.
  if(!is_bool_type(cond_info.ty), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(inner_cond_expr),
          `Expected bool type for condition expression, got: ${ast_expr_to_string(inner_cond_expr)}`,
          false,
          .None
        )
      )
    );
  });
  // Snapshot the condition value before any potential mutation below.
  condition_value := cond_info.value;
  // A condition is comptime-KNOWN only if it has a value that is NOT an
  // `UnknownVal`. yo-self represents "type known, value unknown" as
  // `Some(UnknownVal)` (where TS uses `$.value === undefined`); a bare
  // `condition_value.is_some()` would wrongly treat such a runtime-unknown
  // condition (e.g. `i < lhs.len()` on an unknown param, evaluated at
  // definition time) as comptime-known and mis-fire the modifier gate below.
  cond_is_comptime_known := match(condition_value, .Some(cv) => !is_unknown_val(cv), .None => false);
  // Enforce comptime() modifier semantics:
  // With comptime(): condition MUST be compile-time known; error if runtime.
  if(is_comptime_modifier && condition_value.is_none(), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(inner_cond_expr),
          `"while comptime(...)" requires a compile-time known condition, but the condition evaluates to a runtime value.\nRemove the "comptime" modifier to use a runtime while loop: \`while cond, body\`.`,
          false,
          .None
        )
      )
    );
  });
  // Without comptime(): if condition happens to be compile-time known, it must
  // be a literal `true`/`false` atom (not a comptime-only variable that can
  // never change inside a runtime loop).
  if(!is_comptime_modifier && cond_is_comptime_known, {
    (is_literal_bool : bool) = false;
    if(ast_expr_is_atom_of(inner_cond_expr, "true") || ast_expr_is_atom_of(inner_cond_expr, "false"), {
      is_literal_bool = true;
    }, {
      // begin-wrapped literal: begin(true) / begin(false)
      if(ast_expr_is_fn_call_of(inner_cond_expr, "begin", .None), {
        inner_args_lb := match(
          inner_cond_expr,
          .FnCall(_, _, a, _, _) => a,
          .Atom(_, _) => ArrayList(AstExpr).new()
        );
        if(inner_args_lb.len() == usize(1), {
          first_lb := match(inner_args_lb.get(usize(0)), .Some(a) => a, .None => make_err_expr());
          if(ast_expr_is_atom_of(first_lb, "true") || ast_expr_is_atom_of(first_lb, "false"), {
            is_literal_bool = true;
          });
        });
      });
    });
    if(!is_literal_bool, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(inner_cond_expr),
            `while loop condition is compile-time known but the \`comptime\` modifier is missing.\nThe condition depends on comptime-only variable(s) that cannot change inside a runtime loop, which will cause an infinite loop.\nUse \`while comptime(cond), body\` to unroll the loop at compile time.`,
            false,
            .None
          )
        )
      );
    });
    // Literal `true`/`false`: convert to runtime type so this is treated as a
    // runtime loop (e.g. `while true` for infinite loops).
    runtime_type := convert_comptime_type_to_runtime_type(cond_info.ty, cond_info.env);
    cond_info.ty = runtime_type;
    cond_info.value = Option(EvalValue).None;
  });
  // Effective condition value: only comptime when the modifier is present.
  effective_condition_value := cond(
    is_comptime_modifier => condition_value,
    true => Option(EvalValue).None
  );
  is_compile_time := effective_condition_value.is_some();
  // If the effective condition is compile-time false, stop evaluation.
  eff_cond_is_false := match(
    effective_condition_value,
    .None => false,
    .Some(v) => match(v, .BoolVal(b) => !b, _ => false)
  );
  if(eff_cond_is_false, {
    out_info := new_expr_info(env, t_unit());
    out_info.value = cond(
      is_compile_time => Option(EvalValue).Some(EvalValue.UnitVal),
      true => Option(EvalValue).None
    );
    // ADAPTATION: record EMPTY unrolled bodies so codegen emits NOTHING for
    // the eliminated loop. TS emits a dead runtime loop whose unevaluated
    // body statements degrade to benign `// Error:` comments; yo-self's
    // equivalent degradation is `// Failed to transpile` markers, which the
    // honest-hollow gate counts (basic arm 26's `i :: 10; while(comptime(
    // i < 5), ...)`). Semantically identical: zero iterations.
    out_info.comptime_unrolled_bodies = Option(ArrayList(AstExpr)).Some(ArrayList(AstExpr).new());
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    return(expr);
  });
  // Evaluate the body with the loop-body context set so that break/continue
  // inside the body know they are inside a while loop.
  old_loop_body := ctx.is_evaluating_loop_body;
  ctx.is_evaluating_loop_body = Option(LoopBodyCtx).Some(LoopBodyCtx(kind : LoopKind.While, env : env, entry_frame_count : env.frames.len()));
  evaluated_body := evaluate_begin_expression(body_expr, env, ctx, ArrayList(Variable).new(), false, exn);
  ctx.is_evaluating_loop_body = old_loop_body;
  // Require ExprInfo for the body.
  body_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_body));
  if(body_info_opt.is_none(), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(body_expr),
          `Failed to evaluate the body expression: ${ast_expr_to_string(body_expr)}`,
          false,
          .None
        )
      )
    );
  });
  body_info := match(
    body_info_opt,
    .Some(bi) => bi,
    .None => {
      return(expr);
    }
  );
  // Handle control flow produced by the body.
  if(has_any_control_flow(body_info.control_flow), {
    // --- return / unwind ---
    if(has_control_flow(body_info.control_flow, .Return) || has_control_flow(body_info.control_flow, .Unwind), {
      eff_cond_is_true_re := match(
        effective_condition_value,
        .None => false,
        .Some(v) => match(v, .BoolVal(b) => b, _ => false)
      );
      if(eff_cond_is_true_re, {
        // Condition is compile-time true: propagate return/unwind, clear break/continue.
        cf_ret := has_control_flow(body_info.control_flow, .Return);
        cf_esc := has_control_flow(body_info.control_flow, .Unwind);
        prop_cf := ControlFlowFlags(return_flag : cf_ret, unwind_flag : cf_esc, break_flag : false, continue_flag : false);
        out_info := new_expr_info(body_info.env, body_info.ty);
        out_info.value = body_info.value;
        out_info.path_collection = body_info.path_collection;
        out_info.control_flow = Option(ControlFlowFlags).Some(prop_cf);
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
      }, {
        // We might not even enter the loop body — return unit.
        out_info := new_expr_info(env, t_unit());
        out_info.value = cond(
          is_compile_time => Option(EvalValue).Some(EvalValue.UnitVal),
          true => Option(EvalValue).None
        );
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
      });
      return(expr);
    });
    // --- break ---
    if(has_control_flow(body_info.control_flow, .Break), {
      // Break exits the loop — result is unit.
      out_info := new_expr_info(body_info.env, t_unit());
      out_info.value = cond(
        is_compile_time => Option(EvalValue).Some(EvalValue.UnitVal),
        true => Option(EvalValue).None
      );
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
      return(expr);
    });
    // --- continue ---
    if(has_control_flow(body_info.control_flow, .Continue), {
      // Execute the step expression (if any) before re-evaluating the loop.
      (updated_env_cont : Environment) = body_info.env;
      match(
        step_expr_opt,
        .None => (),
        .Some(step_expr_cont) => {
          eval_step_cont := evaluate_expression_raw(step_expr_cont, updated_env_cont, ctx, exn);
          step_info_cont_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_step_cont));
          if(step_info_cont_opt.is_none(), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(step_expr_cont),
                  `Failed to evaluate the step expression: ${ast_expr_to_string(step_expr_cont)}`,
                  false,
                  .None
                )
              )
            );
          });
          updated_env_cont = match(step_info_cont_opt, .Some(si) => si.env, .None => updated_env_cont);
        }
      );
      // If the condition is compile-time known, re-evaluate the loop.
      eff_is_bool_cont := match(
        effective_condition_value,
        .None => false,
        .Some(v) => match(v, .BoolVal(_) => true, _ => false)
      );
      if(eff_is_bool_cont, {
        return(recur(expr, updated_env_cont, ctx, comptime_iteration_count + usize(1), exn));
      }, {
        // Runtime condition: treat continue as returning unit for this evaluation.
        out_info := new_expr_info(updated_env_cont, t_unit());
        out_info.value = cond(
          is_compile_time => Option(EvalValue).Some(EvalValue.UnitVal),
          true => Option(EvalValue).None
        );
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
      });
      return(expr);
    });
    // Fallthrough: some other combination of flags — return the expression.
    return(expr);
  });
  // --- Static analysis for infinite compile-time `while true` loops ---
  //
  // Only applies when the condition is a LITERAL `true` atom (not an expression
  // like `i < 10` that happens to evaluate to true on the first iteration).
  // A literal `while true` will never have its condition change, so we check
  // whether the body can terminate via break/return/unwind.
  //
  // We walk the body AST instead of checking `control_flow` flags because
  // control_flow only reflects *guaranteed* control flow. A `break` inside
  // one branch of `cond` means the loop *may* terminate at runtime, but
  // `control_flow.break_flag` won't be set on the cond expression.
  (is_cond_literal_true : bool) = false;
  {
    eff_cond_is_true_lt := match(
      effective_condition_value,
      .None => false,
      .Some(v) => match(v, .BoolVal(b) => b, _ => false)
    );
    if(eff_cond_is_true_lt, {
      // Direct atom: `true`
      if(ast_expr_is_atom_of(inner_cond_expr, "true"), {
        is_cond_literal_true = true;
      }, {
        // Wrapped in begin: `begin(true)` — check first arg.
        if(ast_expr_is_fn_call_of(inner_cond_expr, "begin", .None), {
          inner_args_lt := match(
            inner_cond_expr,
            .FnCall(_, _, a, _, _) => a,
            .Atom(_, _) => ArrayList(AstExpr).new()
          );
          if(inner_args_lt.len() == usize(1), {
            first_lt := match(inner_args_lt.get(usize(0)), .Some(a) => a, .None => make_err_expr());
            if(ast_expr_is_atom_of(first_lt, "true"), {
              is_cond_literal_true = true;
            });
          });
        });
      });
    });
  };
  if(is_cond_literal_true, {
    guaranteed := _body_has_any_terminator_guaranteed(body_info.control_flow);
    possible := _body_has_any_terminator_possible(body_expr, body_info.control_flow);
    if(!guaranteed && !possible, {
      // No terminator anywhere — this loop can never end.
      _throw_max_iterations_error(expr, body_expr, body_info.control_flow, exn);
    });
    if(!guaranteed && possible, {
      // Conditional terminator exists — emit as a runtime loop.
      out_info := new_expr_info(body_info.env, t_unit());
      out_info.value = Option(EvalValue).None;
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
      return(expr);
    });
  });
  // The while loop body must return unit.
  if(!is_unit_type(body_info.ty), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(body_expr),
          `Expected the while loop body to return unit, but got: ${type_to_string(body_info.ty)}`,
          false,
          .None
        )
      )
    );
  });
  // Update the environment with the body's post-evaluation state.
  env.frames = body_info.env.frames;
  env.module_path = body_info.env.module_path;
  env.function_declaration_frame_level = body_info.env.function_declaration_frame_level;
  env.input_string = body_info.env.input_string;
  // Execute the step expression if provided (3-argument form).
  match(
    step_expr_opt,
    .None => (),
    .Some(step_expr_s) => {
      eval_step_s := evaluate_expression_raw(step_expr_s, env, ctx, exn);
      step_info_s_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_step_s));
      if(step_info_s_opt.is_none(), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(step_expr_s),
              `Failed to evaluate the step expression: ${ast_expr_to_string(step_expr_s)}`,
              false,
              .None
            )
          )
        );
      });
      env = match(step_info_s_opt, .Some(si) => si.env, .None => env);
    }
  );
  // Comptime while loop unrolling with a RUNTIME body — port of TS
  // while.ts:534-634. When the condition is compile-time TRUE but the body
  // carries runtime values, deep-clone and re-evaluate the body per
  // iteration (each clone's ExprInfos bake THAT iteration's comptime
  // constants) and record the clones on `comptime_unrolled_bodies`; the
  // codegen emits them sequentially with no C loop. Without this the stub
  // recursion re-evaluated the SAME nodes (last iteration's constants won)
  // and codegen emitted a runtime loop whose comptime step leaked a raw
  // identifier (`i = 5;` — basic arm 26's undeclared-identifier hard fail).
  eff_cond_is_true_main := match(
    effective_condition_value,
    .None => false,
    .Some(v) => match(v, .BoolVal(b) => b, _ => false)
  );
  body_has_runtime_value := body_info.value.is_none();
  if(eff_cond_is_true_main && body_has_runtime_value, {
    check_cond := clone_expr_fresh_ids(inner_cond_expr);
    check_res := evaluate_begin_expression(check_cond, env, ctx, ArrayList(Variable).new(), false, exn);
    next_cond_val := match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(check_res)),
      .Some(ci) => ci.value,
      .None => Option(EvalValue).None
    );
    next_is_bool := match(next_cond_val, .Some(v) => match(v, .BoolVal(_) => true, _ => false), .None => false);
    if(next_is_bool, {
      unrolled_bodies := ArrayList(AstExpr).new();
      unrolled_bodies.push(body_expr);
      (current_env : Environment) = env;
      (cond_still_true : bool) = match(next_cond_val, .Some(v) => match(v, .BoolVal(b) => b, _ => false), .None => false);
      (unroll_iter : usize) = usize(1);
      (unroll_abort : bool) = false;
      // Hoisted: the limit is memoized, but reading it once per loop keeps the
      // per-iteration condition a plain comparison.
      unroll_limit := max_comptime_loop_iterations();
      while(cond_still_true && (unroll_iter < unroll_limit) && !unroll_abort, {
        cloned_body := clone_expr_fresh_ids(body_expr);
        old_loop_body_u := ctx.is_evaluating_loop_body;
        ctx.is_evaluating_loop_body = Option(LoopBodyCtx).Some(LoopBodyCtx(kind : LoopKind.While, env : current_env, entry_frame_count : current_env.frames.len()));
        eval_body_u := evaluate_begin_expression(cloned_body, current_env, ctx, ArrayList(Variable).new(), false, exn);
        ctx.is_evaluating_loop_body = old_loop_body_u;
        match(
          expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_body_u)),
          .None => {
            unroll_abort = true;
          },
          .Some(ebi) => {
            unrolled_bodies.push(cloned_body);
            current_env = ebi.env;
            // Execute step if provided (3-argument form).
            match(
              step_expr_opt,
              .None => (),
              .Some(step_expr_u) => {
                cloned_step := clone_expr_fresh_ids(step_expr_u);
                eval_step_u := evaluate_expression_raw(cloned_step, current_env, ctx, exn);
                match(
                  expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_step_u)),
                  .Some(sui) => {
                    current_env = sui.env;
                  },
                  .None => {
                    unroll_abort = true;
                  }
                );
              }
            );
            if(!unroll_abort, {
              // Re-evaluate the condition with the updated env.
              cond_clone_u := clone_expr_fresh_ids(inner_cond_expr);
              cond_res_u := evaluate_begin_expression(cond_clone_u, current_env, ctx, ArrayList(Variable).new(), false, exn);
              cond_val_u := match(
                expr_info_table_get(ctx.expr_info_table, ast_expr_id(cond_res_u)),
                .Some(cui) => cui.value,
                .None => Option(EvalValue).None
              );
              match(
                cond_val_u,
                .Some(cv_u) => match(
                  cv_u,
                  .BoolVal(b_u) => {
                    cond_still_true = b_u;
                  },
                  _ => {
                    // Condition became runtime — can't unroll further; keep
                    // what we have and fall back (TS while.ts:607-616).
                    out_rt_u := new_expr_info(current_env, t_unit());
                    out_rt_u.value = Option(EvalValue).None;
                    out_rt_u.comptime_unrolled_bodies = Option(ArrayList(AstExpr)).Some(unrolled_bodies);
                    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_rt_u);
                    return(expr);
                  }
                ),
                .None => {
                  out_rt_u2 := new_expr_info(current_env, t_unit());
                  out_rt_u2.value = Option(EvalValue).None;
                  out_rt_u2.comptime_unrolled_bodies = Option(ArrayList(AstExpr)).Some(unrolled_bodies);
                  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_rt_u2);
                  return(expr);
                }
              );
            });
          }
        );
        unroll_iter = (unroll_iter + usize(1));
      });
      if(!cond_still_true, {
        // Loop terminates — store unrolled bodies (TS while.ts:619-629).
        out_done_u := new_expr_info(current_env, t_unit());
        out_done_u.value = Option(EvalValue).None;
        out_done_u.comptime_unrolled_bodies = Option(ArrayList(AstExpr)).Some(unrolled_bodies);
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_done_u);
        return(expr);
      });
    });
    // Unrolling failed: condition stayed comptime true (or a body/step eval
    // lost its info). Mirrors TS while.ts:632-634.
    _throw_max_iterations_error(expr, body_expr, body_info.control_flow, exn);
  });
  // If the effective condition is compile-time true (pure-comptime body),
  // recurse to evaluate the next iteration.
  if(eff_cond_is_true_main, {
    next_count := (comptime_iteration_count + usize(1));
    if(next_count >= max_comptime_loop_iterations(), {
      _throw_max_iterations_error(expr, body_expr, body_info.control_flow, exn);
    });
    return(recur(expr, env, ctx, next_count, exn));
  }, {
    // Runtime loop condition or compile-time done — result is unit.
    out_info := new_expr_info(env, t_unit());
    out_info.value = cond(
      is_compile_time => Option(EvalValue).Some(EvalValue.UnitVal),
      true => Option(EvalValue).None
    );
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    return(expr);
  });
  expr
});
export(evaluate_while);
