//! evaluate_open — handles the `open(module_or_struct)` builtin.
//!
//! 1:1 port of `src/evaluator/exprs/open.ts`.
//!
//! `open(m)` brings every field of a module value (compile-time only) or
//! every field of a struct value/type (runtime + compile-time) into the
//! current environment as a fresh variable. For struct opens, the per-field
//! bindings are also recorded in `out_info.runtime_destructurings` so codegen
//! can emit the equivalent runtime destructuring.
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  BK_OPEN,
  BF_DOT,
  make_err_expr
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set,
  expr_info_set_runtime_destructurings,
  RuntimeDestructuring
} :: import("../../expr_info.yo");
{ Environment, add_variable_to_env, get_variables_from_env } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, type_of_eval_value, is_module_val } :: import("../../value.yo");
{ get_func_type } :: import("../../function_value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ is_struct_type } :: import("../../types/guards.yo");
{ format_error_message, YoError } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ evaluate_expression, evaluate_expression_raw } :: import("./expr.yo");
/// Walk down a `.`-chain to its leftmost root atom (or any non-`.` expr).
/// Mirrors the TS `while((exprIsFunctionCallOf(rootExpr, ".")))` walk.
walk_to_root :: (fn(e : AstExpr) -> AstExpr)({
  cur := e;
  // Local-mutable loop: while cur is `.`-call, descend to first arg.
  done := false;
  while(!(done), {
    cond(
      ast_expr_is_fn_call_of(cur, BF_DOT, .None) => {
        match(
          cur,
          .FnCall(_, _, args, _, _) =>
            cond(
              (args.len() >= usize(1)) => {
                match(
                  args.get(usize(0)),
                  .Some(child) => {
                    cur = child;
                  },
                  .None => {
                    done = true;
                  }
                );
              },
              true => {
                done = true;
              }
            ),
          .Atom(_, _) => {
            done = true;
          }
        );
      },
      true => {
        done = true;
      }
    );
  });
  cur
});
/// Evaluate `open(expr)`. Validates shape, evaluates the argument via the
/// dispatcher seam, then binds each module/struct field as a fresh variable
/// in `env`. The returned `out_info` carries the new env, type `()`, value
/// `UnitVal`, and (for struct opens) `runtime_destructurings`.
evaluate_open :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  // Validate shape: `open` with exactly 1 argument.
  if(!(ast_expr_is_fn_call_of(expr, BK_OPEN, .Some(usize(1)))), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected "${BK_OPEN}" with 1 argument, got:\n${ast_expr_to_string(expr)}`,
          false,
          .None
        )
      )
    );
  });
  // Pull the single argument out of the FnCall.
  arg_expr := match(
    expr,
    .FnCall(_, _, args, _, _) => match(
      args.get(usize(0)),
      .Some(a) => a,
      .None => make_err_expr()
    ),
    .Atom(_, _) => make_err_expr()
  );
  // Disallow `open` on implicit variables (or `.`-chains rooted at one).
  root_expr := walk_to_root(arg_expr);
  if(ast_expr_is_atom(root_expr), {
    root_name := match(
      root_expr,
      .Atom(_, tok) => tok.value,
      .FnCall(_, _, _, _, _) => String.from("")
    );
    root_vars := get_variables_from_env(env, root_name);
    if(root_vars.len() > usize(0), {
      last_idx := (root_vars.len() - usize(1));
      match(
        root_vars.get(last_idx),
        .Some(v) =>
          if(v.is_implicit, {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(arg_expr),
                  `Cannot use "open" on implicit variable "${v.name}". Implicit variables must be passed via  parameters.`,
                  false,
                  .None
                )
              )
            );
          }),
        .None => ()
      );
    });
  });
  // Recursively evaluate the argument via the dispatcher seam. Use the
  // exn-threading (raw) evaluator so a failure evaluating the argument — most
  // importantly a failed `import("…")` (e.g. an unsupported circular import
  // whose module isn't preloaded yet) — PROPAGATES to the caller's handler
  // instead of being swallowed by the non-raw wrapper (which prints + returns
  // an `err` placeholder and lets evaluation continue into a downstream crash).
  // Mirrors TS `evaluateOpen` calling the propagating `evaluateExpression`.
  evaluated := evaluate_expression_raw(arg_expr, env, ctx, exn);
  arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
  match(
    arg_info_opt,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(evaluated),
            `Failed to evaluate the module argument:\n${ast_expr_to_string(evaluated)}`,
            false,
            .None
          )
        )
      );
    },
    .Some(_) => ()
  );
  arg_info := match(
    arg_info_opt,
    .Some(i) => i,
    .None => new_expr_info(env, t_unit())
  );
  arg_ty := arg_info.ty;
  arg_value := arg_info.value;
  next_env := arg_info.env;
  runtime_destructurings_opt := Option(ArrayList(RuntimeDestructuring)).None;
  // Branch on value/type shape.
  is_module := match(
    arg_value,
    .Some(v) => is_module_val(v),
    .None => false
  );
  is_struct_v := match(
    arg_value,
    .Some(v) => match(v, .StructVal(_, _, _) => true, _ => false),
    .None => false
  );
  is_struct_t := is_struct_type(arg_ty);
  // The module's source-namespace STRUCT TYPE carries each export's DECLARED
  // type: `anonymous_module.yo:516-517` pushes `field_labels`/`field_types` in
  // lockstep with the StructVal's `module_names`/`module_vals`, so index `i` in
  // the is_module loop below lines up. TS reads the field type straight off the
  // struct type (`src/evaluator/exprs/open.ts:68` + `:74`) instead of
  // reconstructing it from the value; these two arrays are how yo-self gets at
  // the same data. Empty on the cycle / no-loader path, where
  // `LoadModuleResult.module_type` is `.Unit`.
  ty_labels := match(arg_ty, .Struct({ field_labels : tls }) => tls, _ => ArrayList(String).new());
  ty_types := match(arg_ty, .Struct({ field_types : tts }) => tts, _ => ArrayList(TypeValue).new());
  cond(
    is_module => {
      // Iterate module fields (parallel `names` / `values`).
      match(
        arg_value,
        .Some(v) => match(
          v,
          .StructVal(_, mnames, mvals) => {
            i := usize(0);
            while(i < mnames.len(), {
              field_name := match(mnames.get(i), .Some(n) => n, .None => String.from(""));
              field_val := match(mvals.get(i), .Some(x) => x, .None => EvalValue.UnitVal);
              // A FuncVal field's type must be its registered Func type (with
              // generic labels), NOT type_of_eval_value — which has no FuncVal arm
              // and returns `unit`. Binding a function under type `unit` made the
              // callee a non-Func, so `try_to_call` soft-fell to unit without
              // inferring generic args (e.g. `open(std/fmt)` then `println(s)`
              // specialized to `(void)` instead of `(String v)` and failed to
              // transpile). Mirrors TS, where the open'd value carries its own
              // `.type`. Named imports already bind via the real Func type.
              // A module-VALUED member (a nested `impl({…})` module, or a
              // comptime struct constant) must take the DECLARED type recorded
              // on the namespace struct type. `type_of_eval_value`'s
              // `.StructVal` arm rebuilds a nested module's type by recursing
              // over its field VALUES (value.yo:937) and has NO `.FuncVal` arm,
              // so every function member of that nested module fell to the
              // `_ => t_unit()` catch-all. `open(import("std/env"))` therefore
              // bound `env` under a struct type whose `get`/`set` members were
              // `unit`; `env.get(name)` resolved to `unit` and `try_to_call`
              // soft-fell without throwing, surfacing two expressions later as
              // "Cannot unify incompatible types: bool vs unit" at the
              // `assert(result.is_some(), …)` — which hollowed the whole batch.
              // The declared type keeps the real `fn(...)` members at any depth.
              // Only consulted when the label at the same index matches, so a
              // desynced namespace type can never mis-type a member.
              declared_ty_opt := cond(
                match(ty_labels.get(i), .Some(tl) => (tl == field_name), .None => false) => ty_types.get(i),
                true => Option(TypeValue).None
              );
              // Every other member takes the DECLARED type too: a comptime
              // constant `K :: u64(7)` is an `IntVal` whose
              // `type_of_eval_value` is the literal default `i32`, so
              // `open(import(m))` re-typed every exported integer constant
              // (`K + u64(1)` failed to unify) while the named import
              // `{ K } :: import(m)` kept `u64`
              // (issues/fixed/open-import-retypes-integer-constants.md).
              field_ty := match(
                field_val,
                .FuncVal(__fvd1, _) => get_func_type(__fvd1.*.func_id),
                _ => match(
                  declared_ty_opt,
                  .Some(declared_ty) => declared_ty,
                  .None => type_of_eval_value(field_val)
                )
              );
              _added := add_variable_to_env(
                next_env,
                field_name,
                field_ty,
                .Some(field_val),
                true,
                false,
                false,
                false,
                ast_expr_token(arg_expr)
              );
              i = (i + usize(1));
            });
          },
          _ => ()
        ),
        .None => ()
      );
    },
    is_struct_t => {
      // Iterate struct type fields. Pull values from StructVal when present.
      rds := ArrayList(RuntimeDestructuring).new();
      match(
        arg_ty,
        .Struct({ field_labels, field_types }) => {
          i := usize(0);
          while(i < field_labels.len(), {
            label := match(field_labels.get(i), .Some(l) => l, .None => String.from(""));
            fty := match(field_types.get(i), .Some(t) => t, .None => t_unit());
            // Pull the corresponding value from the StructVal, if any.
            fval_opt := match(
              arg_value,
              .Some(v) => match(
                v,
                .StructVal(_, _, fvals) => fvals.get(i),
                _ => Option(EvalValue).None
              ),
              .None => Option(EvalValue).None
            );
            is_comptime := match(fval_opt, .Some(_) => true, .None => false);
            _added := add_variable_to_env(
              next_env,
              label,
              fty,
              fval_opt,
              is_comptime,
              false,
              false,
              false,
              ast_expr_token(arg_expr)
            );
            rds.push(
              RuntimeDestructuring(
                label : label,
                ty : fty,
                variable_name : label
              )
            );
            i = (i + usize(1));
          });
        },
        _ => ()
      );
      runtime_destructurings_opt = .Some(rds);
    },
    true => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            `Expected module/struct for "${BK_OPEN}", got:\n${ast_expr_to_string(arg_expr)}`,
            false,
            .None
          )
        )
      );
    }
  );
  // Build out_info: env mutated, type `()`, value `UnitVal`.
  out_info := new_expr_info(next_env, t_unit());
  out_info.value = .Some(EvalValue.UnitVal);
  expr_info_set_runtime_destructurings(out_info, runtime_destructurings_opt);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
export(evaluate_open);
