//! evaluate_import — handles `import("path")` expressions.
//!
//! Dependency-name imports (`import("mylib")`, `import("mylib/sub")`) resolve
//! through the import-root table below, which the build runner fills per
//! artifact and hands to the child compile as `--imports <file>`
//! (plans/archive/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.5.1) — an
//! in-process registry + `yo.lock` lookup would be invisible to a
//! child-process compile, and dropping the rule entirely broke dependency
//! imports
//! (issues/fixed/dependency-imports-never-resolve-in-the-self-hosted-compiler.md).
//!
//! * The `safeRelativePath` Windows cross-drive helper is omitted; absolute
//!   paths returned by `Path.join` are used directly.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array-list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom,
  BK_IMPORT
} :: import("../../expr.yo");
{ stable_sns_module_id } :: import("../../utils.yo");
{ ExprInfo, new_expr_info, expr_info_table_get, expr_info_table_set } :: import("../../expr-info.yo");
{ Environment, env_adopt } :: import("../../env.yo");
{ register_sns_module, EvalContext, LoadModuleResult } :: import("../context.yo");
{ Diagnostic, lookup_std_modules_under } :: import("../../diagnostics.yo");
{ EvalValue, EvalValueNode, type_of_eval_value, value_cell_new } :: import("../../value.yo");
{ TypeValue, TypeValueNode, shared_list } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ YoError, format_error_message, format_error_message_with_help, format_error_message_with_repair, take_error_diagnostics, note_diagnostic_of_token } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ Path } :: import("std/path");
{ cwd } :: import("std/env");
{ stat } :: import("std/libc/sys/stat");
{ GlobalAllocator } :: import("std/allocator");
{ evaluate_expression_raw } :: import("./expr.yo");
{ RefCell } :: import("std/sync/refcell");
/// (seed window) Concrete per-payload variants of refcell.yo's generic
/// fillers: a fn value generic over its element keeps the variable abstract
/// through the slot and its specializations COLLAPSE across element types
/// (see refcell.yo's filler block). Inline the literals back once
/// `SEED_VERSION` carries the ref-spill fix.
/// `ArrayList(String)` (2 uses)
_c_len_1 :: (fn(xs : &ArrayList(String)) -> usize)(xs.len());
// ---------------------------------------------------------------------------
// _file_exists_sync
// ---------------------------------------------------------------------------
/// Synchronous file existence check via libc `stat` — portable to Windows
/// (MSVC has stat in <sys/stat.h>; POSIX `access`/`F_OK` broke the v0.2.0
/// windows seed leg). Matches module-manager.yo's `_path_exists_sync`.
_file_exists_sync :: (fn(absolute_path : &String) -> bool)({
  { malloc, free } :: GlobalAllocator;
  cstr := absolute_path.to_cstr();
  ptr := (*char)(cstr.ptr().unwrap());
  // 512 bytes comfortably exceeds `struct stat` on every supported target;
  // only the return code is read.
  buf := malloc(usize(512)).unwrap();
  status := unsafe(stat(ptr, buf));
  free(.Some(buf));
  status == int(0)
});
// ---------------------------------------------------------------------------
// Import roots — bare names the build runner resolved for this compile
// ---------------------------------------------------------------------------
/// `import("mylib")` / `import("mylib/sub")` resolve through this table: the
/// project's `yo.toml` closure — its own `[modules]`, every dependency's
/// modules under the dependency's name, transitively — as computed by
/// `manifest.resolve_import_roots`. module-manager.yo registers it from the
/// manifest it discovers above the entry file, or from the build runner's
/// explicit `--imports <file>` mapping (plans/archive/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md
/// §4.5.1). Empty for a file outside any project, where only `std/`,
/// relative and CWD-relative imports exist. Rule 0 of `resolve_module_path`.
/// Parallel arrays — the table is a handful of entries.
(g_import_root_names : RefCell(ArrayList(String))) = RefCell(ArrayList(String)).new(ArrayList(String).new());
(g_import_root_paths : RefCell(ArrayList(String))) = RefCell(ArrayList(String)).new(ArrayList(String).new());
/// Declared-but-unavailable names (a git dependency `yo install` has not
/// fetched, a dependency without a module root) and why — so importing one
/// reports the cause instead of "module not found".
(g_import_unavailable_names : RefCell(ArrayList(String))) = RefCell(ArrayList(String)).new(ArrayList(String).new());
(g_import_unavailable_reasons : RefCell(ArrayList(String))) = RefCell(ArrayList(String)).new(ArrayList(String).new());
/// Map an import name (`dep`, or `dep/sub` for a named module) to its module
/// root file (absolute path). A name mapped twice resolves to the FIRST
/// mapping — the resolver rejects duplicate import names before this point.
set_import_root :: (fn(name : &String, root_file : &String) -> unit)({
  n := name.clone();
  g_import_root_names.with_mut({ n }(xs) => xs.push(n));
  p := root_file.clone();
  g_import_root_paths.with_mut({ p }(xs) => xs.push(p));
});
/// Record that `name` is declared by the manifest but cannot be imported,
/// with the reason the diagnostic will carry.
set_import_unavailable :: (fn(name : &String, reason : &String) -> unit)({
  n := name.clone();
  g_import_unavailable_names.with_mut({ n }(xs) => xs.push(n));
  r := reason.clone();
  g_import_unavailable_reasons.with_mut({ r }(xs) => xs.push(r));
});
clear_import_roots :: (fn() -> unit)({
  g_import_root_names.with_mut(xs => xs.clear());
  g_import_root_paths.with_mut(xs => xs.clear());
  g_import_unavailable_names.with_mut(xs => xs.clear());
  g_import_unavailable_reasons.with_mut(xs => xs.clear());
});
lookup_import_unavailable :: (fn(name : &String) -> Option(String))({
  (i : usize) = usize(0);
  while(i < g_import_unavailable_names.with(_c_len_1), {
    matches := match(g_import_unavailable_names.with({ i }(xs) => xs.get_cloned(i)), .Some(n) => (n == name.*), .None => false);
    if(matches, {
      match(
        g_import_unavailable_reasons.with(xs => xs.get_cloned(i)),
        .Some(r) => {
          return(Option(String).Some(r));
        },
        .None => ()
      );
    });
    i = (i + usize(1));
  });
  Option(String).None
});
lookup_import_root :: (fn(name : &String) -> Option(String))({
  (i : usize) = usize(0);
  while(i < g_import_root_names.with(_c_len_1), {
    // `.get(i)` copies the element out: indexing a module-level container
    // for a `ref` argument is rejected (a callee could reallocate it).
    matches := match(g_import_root_names.with({ i }(xs) => xs.get_cloned(i)), .Some(n) => (n == name.*), .None => false);
    if(matches, {
      match(
        g_import_root_paths.with(xs => xs.get_cloned(i)),
        .Some(p) => {
          return(Option(String).Some(p));
        },
        .None => ()
      );
    });
    i = (i + usize(1));
  });
  Option(String).None
});
// ---------------------------------------------------------------------------
// Module file and directory names (plans/backlog/KEBAB_CASE_NAMES.md Part C)
// ---------------------------------------------------------------------------
/// A module file or directory name breaks the naming rule when it holds `_`
/// or an ASCII upper-case letter: a `.yo` file, a directory and a
/// `[modules]` key are kebab-case, because a module path is only ever a
/// string (an `import(…)` argument), never an identifier.
module_name_offends :: (fn(name : &String) -> bool)({
  (mut(i) : usize) = usize(0);
  while(i < name.len(), i = (i + usize(1)), {
    b := name.byte_at(i);
    if((b == u8(95)) || ((b >= u8(65)) && (b <= u8(90))), {
      return(true);
    });
  });
  false
});
/// The kebab-case spelling of a module file or directory name: ASCII upper
/// case lowered and `_` written `-`, with a `-` that would lead or trail a
/// dot-separated part dropped (a name may not start with `-`: `yo check
/// -foo.yo` reads it as a flag). `array_list.yo` → `array-list.yo`,
/// `foo_bar.test.yo` → `foo-bar.test.yo`, `_fsm.yo` → `fsm.yo`. There is no
/// CamelCase splitting (`FooBar` → `foobar`): the rule is one byte-wise
/// normalization, so a name is recognized the same way everywhere.
module_name_kebab :: (fn(name : &String) -> String)({
  parts := name.split(String.from("."));
  out_parts := ArrayList(String).new();
  (mut(pi) : usize) = usize(0);
  while(pi < parts.len(), pi = (pi + usize(1)), {
    p := parts(pi).clone();
    bytes := ArrayList(u8).new();
    (mut(bi) : usize) = usize(0);
    while(bi < p.len(), bi = (bi + usize(1)), {
      b := p.byte_at(bi);
      cond(
        (b == u8(95)) => bytes.push(u8(45)),
        ((b >= u8(65)) && (b <= u8(90))) => bytes.push(b + u8(32)),
        true => bytes.push(b)
      );
    });
    (mut(lo) : usize) = usize(0);
    while((lo < bytes.len()) && (bytes(lo) == u8(45)), {
      lo = (lo + usize(1));
    });
    (mut(hi) : usize) = bytes.len();
    while((hi > lo) && (bytes((hi - usize(1))) == u8(45)), {
      hi = (hi - usize(1));
    });
    kept := ArrayList(u8).new();
    (mut(ki) : usize) = lo;
    while(ki < hi, ki = (ki + usize(1)), {
      kept.push(bytes(ki));
    });
    out_parts.push(String.from_bytes(kept));
  });
  String.from(".").join(&out_parts)
});
// ---------------------------------------------------------------------------
// Module path resolution (shared with main.yo's preload_module_tree)
// ---------------------------------------------------------------------------
/// Result of resolving an `import("…")` path string to a concrete file.
/// `Found` carries the `file://`-prefixed absolute path (with extension).
ModuleResolveResult :: enum(
  Found(abs_path : String),
  NotFound(base : String),
  Ambiguous(base : String),
  /// A name the project's manifest declares whose sources are not available
  /// (not fetched, no module root); `reason` says what to do.
  Unavailable(name : String, reason : String)
);
/// Resolve an import path string (already stripped of surrounding quotes,
/// and known not to be the prelude) to a concrete `file://` module path.
///
/// I/O-free: file existence is probed with `_file_exists_sync` (POSIX
/// `access(2)`), so this is a pure `fn` usable from both the evaluator
/// (`evaluate_import`) and the orchestration layer (`preload_module_tree`
/// in main.yo). Keeping resolution in one place guarantees both compute
/// the *same* cache key for `ctx.load_module`.
///
/// Resolution order:
///   0. `<name>` / `<name>/<sub>` where `<name>` is a mapped import root
///                  → the root file / the mapped `<name>/<sub>` module /
///                    `<sub>` under the root's directory
///   1. `std/…`     → relative to `std_path`
///   2. `std`       → `std_path/index.yo`
///   3. `.`/`..`    → relative to `current_dir`
///   4. otherwise   → relative to CWD
/// then extension resolution: `<path>.yo` xor `<path>/index.yo`.
resolve_module_path :: (
  fn(import_path : &String, current_dir : &String, std_path : &String) -> ModuleResolveResult
)(
  resolve_module_path_ex(import_path, current_dir, std_path, true)
);
/// `resolve_module_path`, with rule 0 (the manifest's import-root mapping)
/// switchable. It is OFF for an ENTRY FILE named on the command line
/// (`mm_resolve_entry_abs`): that argument is a filesystem path, never an
/// import specifier, and a path whose first segment happens to match a mapped
/// name — `yo compile mathlib/src/lib.yo` in a project whose `yo.toml`
/// declares a `mathlib` dependency — was rewritten into the root's directory
/// (`mathlib/src/src/lib.yo`). The file still parsed, through the NotFound
/// fallback, but its module identity was that bogus path: codegen's
/// "defined in the entry module?" test then matched nothing, so a
/// `--static-library` build of it exported NO symbols
/// (issues/fixed/entry-path-shadowed-by-an-import-root-name.md).
resolve_module_path_ex :: (
  fn(
    import_path : &String,
    current_dir : &String,
    std_path : &String,
    consult_import_roots : bool
  ) -> ModuleResolveResult
)({
  (module_path_to_import : String) = import_path.clone();
  // 0. A name the manifest mapped to a module root: `import("dep")` is the
  //    root file itself; `import("dep/sub")` is the dependency's `[modules]
  //    sub` when it declares one, else `sub` under the root's directory (then
  //    the usual extension resolution). Only the FIRST path segment is looked
  //    up for the directory form, and `std` / relative heads are never
  //    consulted, so rules 1–3 cannot be shadowed. The mapped root is
  //    absolute, so the rewritten path falls through rules 1–4 untouched.
  head := match(
    module_path_to_import.index_of("/"),
    .Some(k) => module_path_to_import.substring(usize(0), k),
    .None => module_path_to_import.clone()
  );
  if(consult_import_roots && !(head.starts_with(String.from(".")) || (head == "std")), {
    match(
      lookup_import_root(module_path_to_import.clone()),
      .Some(exact) => {
        return(ModuleResolveResult.Found(`file://${exact}`));
      },
      .None => ()
    );
    match(
      lookup_import_unavailable(head.clone()),
      .Some(reason) => {
        return(ModuleResolveResult.Unavailable(head.clone(), reason));
      },
      .None => ()
    );
    match(
      lookup_import_root(head.clone()),
      .Some(root) => {
        if(head.len() == module_path_to_import.len(), {
          return(ModuleResolveResult.Found(`file://${root}`));
        });
        rest := module_path_to_import.substring(head.len() + usize(1), module_path_to_import.len());
        root_dir := match(
          Path.new(root.clone()).parent(),
          .Some(p) => p.to_string(),
          .None => String.from(".")
        );
        module_path_to_import = Path.new(`${root_dir}/${rest}`).normalize().to_string();
      },
      .None => ()
    );
  });
  // 1. `std/` prefix → resolve relative to std_path.
  if(module_path_to_import.starts_with(String.from("std/")), {
    rel := module_path_to_import.substring(usize(4), module_path_to_import.len());
    module_path_to_import = Path.new(std_path.clone()).join(Path.new(&rel)).to_string();
  });
  // 2. `std` alone → std/index.yo.
  if(module_path_to_import == "std", {
    module_path_to_import = Path.new(std_path.clone()).join(Path.new(String.from("index.yo"))).to_string();
  });
  // 3. Relative paths (`.` or `..` prefix) — resolve relative to current dir.
  //    `normalize()` is REQUIRED, not cosmetic: this string is the module
  //    cache key, so `/std/imm/../allocator.yo` and `/std/allocator.yo` must
  //    not be two keys for one file (that evaluates the module twice). `Path`
  //    records `..` as written — folding it is only valid lexically, which is
  //    exactly what a cache key wants — so ask for the fold explicitly.
  if(module_path_to_import.starts_with(String.from(".")), {
    module_path_to_import = Path.new(`${current_dir}/${module_path_to_import}`).normalize().to_string();
  });
  // 4. Non-relative, non-absolute paths: resolve relative to CWD.
  if(!Path.new(module_path_to_import.clone()).is_absolute(), {
    cwd_result := match(
      cwd(),
      .Ok(p) => p.to_string(),
      .Err(_) => String.from(".")
    );
    module_path_to_import = Path.new(&cwd_result).join(Path.new(module_path_to_import.clone())).to_string();
  });
  // Extension resolution.
  ext_opt := Path.new(module_path_to_import.clone()).extension();
  has_ext := match(ext_opt, .Some(_) => true, .None => false);
  if(has_ext, {
    return(ModuleResolveResult.Found(`file://${module_path_to_import}`));
  });
  yo_file_path := `${module_path_to_import}.yo`;
  index_yo_path := `${module_path_to_import}/index.yo`;
  yo_exists := _file_exists_sync(yo_file_path.clone());
  index_exists := _file_exists_sync(index_yo_path.clone());
  cond(
    (yo_exists && index_exists) => ModuleResolveResult.Ambiguous(module_path_to_import),
    yo_exists => ModuleResolveResult.Found(`file://${yo_file_path}`),
    index_exists => ModuleResolveResult.Found(`file://${index_yo_path}`),
    true => ModuleResolveResult.NotFound(module_path_to_import)
  )
});
/// The import specs an import of a renamed module may mean (VERDICTS-67): every
/// spelling of `spec` with some of its offending segments (`_` or upper case)
/// written in their kebab-case normalization that resolves to an existing
/// module, one per module reached. Normalization equality only: no edit
/// distance, and the import stays an error (nothing resolves under the old
/// name). `.`, `..`, empty segments and a leading `std` are kept; more than six
/// offending segments give no candidate.
renamed_module_candidates :: (
  fn(spec : &String, current_dir : &String, std_path : &String) -> ArrayList(String)
)({
  out := ArrayList(String).new();
  segs := spec.split(String.from("/"));
  idx := ArrayList(usize).new();
  (mut(si) : usize) = usize(0);
  while(si < segs.len(), si = (si + usize(1)), {
    seg := segs(si).clone();
    keep := ((seg == "") || (seg == ".") || (seg == "..") || ((si == usize(0)) && (seg == "std")));
    if(!keep && module_name_offends(&seg) && (module_name_kebab(&seg) != seg) && !module_name_kebab(&seg).is_empty(), {
      idx.push(si);
    });
  });
  if((idx.len() == usize(0)) || (idx.len() > usize(6)), {
    return(out);
  });
  reached := ArrayList(String).new();
  (mut(combos) : usize) = usize(1);
  (mut(ci) : usize) = usize(0);
  while(ci < idx.len(), ci = (ci + usize(1)), {
    combos = (combos * usize(2));
  });
  // Mask 0 is the spelling that just failed.
  (mut(mask) : usize) = usize(1);
  while(mask < combos, mask = (mask + usize(1)), {
    mut(variant) := segs.clone();
    (mut(bit) : usize) = usize(1);
    (mut(bj) : usize) = usize(0);
    while(bj < idx.len(), bj = (bj + usize(1)), {
      if(((mask / bit) % usize(2)) == usize(1), {
        variant(idx(bj)) = module_name_kebab(&segs(idx(bj)));
      });
      bit = (bit * usize(2));
    });
    v := String.from("/").join(&variant);
    match(
      resolve_module_path_ex(v.clone(), current_dir.clone(), std_path.clone(), true),
      .Found(p) => if(_file_exists_sync(&p.replace(String.from("file://"), String.new())) && !reached.contains(&p), {
        reached.push(p);
        out.push(v);
      }),
      _ => ()
    );
  });
  out
});
/// Raise "module not found" for the import `module_arg` (spelling `spec`).
/// A module renamed to kebab-case (plans/backlog/KEBAB_CASE_NAMES.md Part C)
/// is not found under its old name: one candidate under the naming
/// normalization is repaired on the import string; several, or none for a
/// path that breaks the rule, are named in the help (VERDICTS-67).
_throw_module_not_found :: (
  fn(module_arg : &AstExpr, spec : &String, msg : &String, current_dir : &String, std_path : &String, exn : Exception) -> unit
)({
  module_path_to_import := spec.clone();
  arg_raw := ast_expr_token(module_arg).value.*.clone();
  is_literal := (ast_expr_is_atom(module_arg) && arg_raw.starts_with("\"") && !arg_raw.contains("\\"));
  cands := renamed_module_candidates(&module_path_to_import, current_dir, std_path);
  // `import("std/collections")` names a directory without an `index.yo`: the
  // std modules under it are the candidates (the std export index, empty when
  // nothing filled it).
  std_dir_modules := lookup_std_modules_under(&module_path_to_import);
  cond(
    ((cands.len() == usize(1)) && is_literal) => exn.throw(
      dyn(
        Box.new(
          format_error_message_with_repair(
            ast_expr_token(module_arg),
            msg,
            &Option(String).Some(`module file and directory names are kebab-case: did you mean \`import("${cands(usize(0))}")\`?`),
            &`"${cands(usize(0))}"`,
            &`import("${cands(usize(0))}")`
          )
        )
      )
    ),
    (cands.len() > usize(0)) => exn.throw(
      dyn(
        Box.new(
          format_error_message_with_help(
            ast_expr_token(module_arg),
            msg,
            &Option(String).Some(`module file and directory names are kebab-case; these modules match: ${String.from(", ").join(&cands)}`)
          )
        )
      )
    ),
    module_name_offends(&module_path_to_import) => exn.throw(
      dyn(
        Box.new(
          format_error_message_with_help(
            ast_expr_token(module_arg),
            msg,
            &Option(String).Some(String.from("module file and directory names are kebab-case, and no module matches this path's kebab-case spelling either"))
          )
        )
      )
    ),
    (std_dir_modules.len() > usize(0)) => exn.throw(
      dyn(
        Box.new(
          format_error_message_with_help(
            ast_expr_token(module_arg),
            msg,
            &Option(String).Some(`"${module_path_to_import}" is a directory of modules, not a module; import one of them: ${String.from(", ").join(&std_dir_modules)}`)
          )
        )
      )
    ),
    true => exn.throw(dyn(Box.new(format_error_message(ast_expr_token(module_arg), msg))))
  );
});
// ---------------------------------------------------------------------------
// _build_module_val_from_env
// ---------------------------------------------------------------------------
/// Build a source-namespace `StructVal` whose fields are all comptime-known
/// bindings currently visible in `env`. Used as a fallback when no real module loader is
/// registered: in `run_check`'s flatten-eval pipeline all dep exprs run in the
/// same shared env, so the names declared in any imported module are already
/// reachable from `env` by the time the `import("…")` call is evaluated.
/// Outer (lower-index) frames are walked first so newer same-name bindings in
/// inner frames take precedence by overwriting earlier ones via a linear scan
/// in the destructurer.
_build_module_val_from_env :: (fn(env : &Environment) -> EvalValue)({
  names := ArrayList(String).new();
  values := ArrayList(EvalValue).new();
  (fi : usize) = usize(0);
  while(fi < env.frames_len(), {
    match(
      env.frame_at(fi),
      .Some(frame) => {
        (vi : usize) = usize(0);
        while(vi < frame.variables_len(), {
          match(
            frame.variable_at(vi),
            .Some(v) => match(
              v.value().get(usize(0)),
              .Some(val) => {
                // Skip prelude operator / impl-method names (like bool.!, i32.MAX)
                // that would cause "already exported" errors when spread-exporting
                // multiple imports in flatten-eval mode. Real module exports never
                // contain '.' — operator/impl names do.
                // skip — prelude operator binding, not a module export
                if(v.name.contains("."), (), {
                  names.push(v.name.clone());
                  values.push(val);
                });
              },
              .None => ()
            ),
            .None => ()
          );
          vi = (vi + usize(1));
        });
      },
      .None => ()
    );
    fi = (fi + usize(1));
  });
  sns_id2 := stable_sns_module_id(&env.module_path().*);
  register_sns_module(sns_id2.clone(), &env.module_path().*);
  Rc.new(EvalValueNode.StructVal(sns_id2, shared_list(names), value_cell_new(values)))
});
// ---------------------------------------------------------------------------
// evaluate_import
// ---------------------------------------------------------------------------
evaluate_import :: (
  fn(
    expr : &AstExpr,
    env_in : &Environment,
    ctx : &mut EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  (env : Environment) = Rc.clone(env_in);
  if(!ast_expr_is_fn_call_of(expr, BK_IMPORT, .Some(usize(1))), {
    exn.throw(
      dyn(
        Box.new(
          format_error_message(
            ast_expr_token(expr),
            String.from("Expected `import` with exactly 1 argument.")
          )
        )
      )
    );
  });
  // Get the path argument (first arg of the import call).
  module_arg := match(
    expr,
    Rc(.FnCall(_, _, Rc(args), _, _)) => match(
      args.get_cloned(usize(0)),
      .Some(a) => a,
      .None => {
        exn.throw(
          dyn(
            Box.new(
              format_error_message(
                ast_expr_token(expr),
                String.from("import: missing path argument.")
              )
            )
          )
        );
        Rc.clone(expr.*)
      }
    ),
    Rc(.Atom(_, _)) => {
      exn.throw(
        dyn(
          Box.new(
            format_error_message(
              ast_expr_token(expr),
              String.from("import: expected FnCall expression.")
            )
          )
        )
      );
      Rc.clone(expr.*)
    }
  );
  // Evaluate the argument — it must yield a comptime string.
  evaluated_arg := evaluate_expression_raw(&module_arg, &env, ctx, exn);
  arg_info_opt := expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&evaluated_arg));
  arg_info := match(
    arg_info_opt,
    .Some(i) => Rc.clone(i),
    .None => {
      exn.throw(
        dyn(
          Box.new(
            format_error_message(
              ast_expr_token(&module_arg),
              String.from("import: failed to evaluate module path argument.")
            )
          )
        )
      );
      new_expr_info(&env, t_unit())
    }
  );
  env_adopt(&env, &arg_info.env());
  // Extract the comptime string value.
  // StrLit.raw includes the surrounding quotes (e.g., `"std/string"`).
  // Strip the leading and trailing quote character to get the raw path.
  raw_with_quotes := match(
    arg_info.value(),
    .Some(Rc(.StrLit(s))) => s.clone(),
    .Some(_) => {
      exn.throw(
        dyn(
          Box.new(
            format_error_message(
              ast_expr_token(&module_arg),
              String.from("Expected comptime_str for module path.")
            )
          )
        )
      );
      String.new()
    },
    .None => {
      exn.throw(
        dyn(
          Box.new(
            format_error_message(
              ast_expr_token(&module_arg),
              String.from("Expected comptime_str for module path.")
            )
          )
        )
      );
      String.new()
    }
  );
  // Strip leading and trailing quote characters.
  rn := raw_with_quotes.len();
  (module_path_to_import : String) = if(
    rn >= usize(2),
    raw_with_quotes.substring(usize(1), rn - usize(1)),
    raw_with_quotes.clone()
  );
  // Disallow importing the prelude.
  if((module_path_to_import == "std/prelude") || (module_path_to_import == "std/prelude.yo"), {
    exn.throw(
      dyn(
        Box.new(
          format_error_message(
            ast_expr_token(&module_arg),
            String.from("Importing the prelude module is not allowed — it is automatically loaded for every file.")
          )
        )
      )
    );
  });
  // ---------------------------------------------------------------------------
  // Path resolution
  // ---------------------------------------------------------------------------
  // Strip `file://` from the current module path to get the raw file-system path.
  current_file := env.module_path().*.replace(String.from("file://"), String.from(""));
  current_dir := match(
    Path.new(current_file.clone()).parent(),
    .Some(p) => p.to_string(),
    .None => String.from(".")
  );
  // Resolve via the shared resolver so the cache key here matches the one
  // `preload_module_tree` (main.yo) registers under.
  (module_abs_path : String) = match(
    resolve_module_path(module_path_to_import.clone(), current_dir.clone(), ctx.std_path.clone()),
    .Found(p) => {
      // An explicit `.yo` path resolves without a probe; when its file is
      // missing and a kebab-case spelling exists, it is the renamed-module
      // error below rather than a failed read.
      fs_p := p.replace(String.from("file://"), String.new());
      if(!_file_exists_sync(&fs_p) && (renamed_module_candidates(&module_path_to_import, &current_dir, &ctx.std_path).len() > usize(0)), {
        _throw_module_not_found(&module_arg, &module_path_to_import, &`Module not found: "${fs_p}" does not exist`, &current_dir, &ctx.std_path, exn);
      });
      p
    },
    .Ambiguous(base) => {
      exn.throw(
        dyn(
          Box.new(
            format_error_message(
              ast_expr_token(&module_arg),
              `Ambiguous import("${base}": both "${base}.yo" and "${base}/index.yo" exist. Use an explicit path to resolve the ambiguity.)`
            )
          )
        )
      );
      String.from("")
    },
    .NotFound(base) => {
      _throw_module_not_found(&module_arg, &module_path_to_import, &`Module not found: tried "${base}.yo" and "${base}/index.yo"`, &current_dir, &ctx.std_path, exn);
      String.from("")
    },
    .Unavailable(name, reason) => {
      exn.throw(
        dyn(
          Box.new(
            format_error_message(
              ast_expr_token(&module_arg),
              `import("${name}"): ${reason}`
            )
          )
        )
      );
      String.from("")
    }
  );
  // ---------------------------------------------------------------------------
  // Load the module
  // ---------------------------------------------------------------------------
  // When no module loader is registered (e.g. `run_check` flatten-eval path),
  // synthesise a ModuleVal from the current evaluation env. Because
  // `collect_module_deps` flattens all dep exprs into one big list evaluated
  // in a shared env, every name declared in the imported module is already
  // in `env` at the time `import("…")` is evaluated. Building a ModuleVal
  // from `env` lets downstream destructuring (`{ X, Y } :: import("…")`,
  // `{ ... } :: import("…")`) find the names without a real ModuleManager.
  load_result := match(
    ctx.load_module,
    .Some(load_fn) => load_fn(module_abs_path.clone()),
    .None => LoadModuleResult(
      module_value : _build_module_val_from_env(&env),
      module_type : Rc.new(TypeValueNode.Unit),
      module_error : .None
    )
  );
  // Check for a load error (P3 D16, plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md):
  // report the LEAF diagnostic group once, plus ONE note anchored at the
  // import — no nested-render cascade. The leaf's structured group is in the
  // typed stash (module loading stashes text + diagnostics together); the
  // text-wrapping fallback only fires for non-structured load errors.
  match(
    &load_result.module_error,
    .Some(err_msg) => {
      leaf := take_error_diagnostics();
      group := match(
        leaf,
        .Some(ds) => {
          entries := ArrayList(Diagnostic).new();
          (ci : usize) = usize(0);
          while(ci < ds.len(), {
            match(
              ds.get_cloned(ci),
              .Some(d) => {
                entries.push(d);
              },
              .None => ()
            );
            ci = (ci + usize(1));
          });
          entries.push(
            note_diagnostic_of_token(
              ast_expr_token(&module_arg),
              `while importing this module (import chain collapsed — the error above is from the imported file)`
            )
          );
          YoError(diagnostics : entries)
        },
        .None => format_error_message(
          ast_expr_token(&module_arg),
          `Failed to import module "${module_path_to_import}":\n${err_msg}`
        )
      );
      exn.throw(dyn(Box.new(group)));
    },
    .None => ()
  );
  // Record the result.
  mod_val := Rc.clone(load_result.module_value);
  // Prefer the CACHED namespace struct type (real member field types —
  // fn members especially, whose FuncVal values carry no type, so the
  // value-derived reconstruction makes every imported fn unit-typed and
  // every `mod.f(x)` call unit). Fall back to the value-derived type for
  // the cycle path, which has no recorded type.
  mod_ty := match(
    &load_result.module_type,
    Rc(.Unit) => type_of_eval_value(&mod_val),
    _ => Rc.clone(load_result.module_type)
  );
  out_info := new_expr_info(&env, &mod_ty);
  out_info.set_value(.Some(mod_val));
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_info);
  Rc.clone(expr.*)
});
export(evaluate_import, resolve_module_path, ModuleResolveResult, _build_module_val_from_env);
export(set_import_root, set_import_unavailable, clear_import_roots, lookup_import_root, lookup_import_unavailable);
export(resolve_module_path_ex, module_name_offends, module_name_kebab, renamed_module_candidates);
