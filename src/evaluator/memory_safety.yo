//! Memory-safety helpers (Phase C of plans/reference/MEMORY_SAFETY.md).
//!
//! Per-file privilege tracking via `pragma(Pragma.AllowUnsafe);`. When the
//! `pragma` builtin is evaluated, it records the file's URI in the
//! `privileged_files` registry. The pointer-op gates then look up the
//! current expression's source file in this registry — files that declared
//! the pragma bypass the unsafe-wrap requirement.
//!
//! Not ported:
//!   * `record_extern_call_site` — a Phase-C migration helper that writes a
//!     JSON worklist on `process.on("exit")` (gated on the
//!     `YO_EXTERN_WRAP_DUMP_FILE` env var). The compiler has no process-exit
//!     hook and it is not needed for evaluator correctness, so it is deferred.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ cwd } :: import("std/env");
{ Path } :: import("std/path");
{ TypeValue, t_refine_inner } :: import("../types/definitions.yo");
{ type_to_string } :: import("../types/string.yo");
{ canonical_module_path } :: import("../utils.yo");
// NOTE: the compiler reuses the language's own `Pragma` enum
// (defined in `std/prelude.yo`, auto-loaded into every module) as the
// pragma-kind type — one source of truth, no duplicate enum. `Pragma`
// derives `Eq` in the prelude, so `==` is used directly below.
/// One `(module_path, kind)` entry in the per-file pragma registry.
/// (A list of pairs rather than a hash map, to avoid a `HashSet(Pragma)`
/// hashing requirement; the semantics — membership of a `kind` for a
/// `module_path` — are identical.)
PragmaEntry :: struct(module_path : String, kind : Pragma);
/// Per-file pragma registry. Keyed by canonical module URI (the value of
/// `token.module_path`, e.g. `file:///path/to/foo.yo`).
(g_privileged_files : ArrayList(PragmaEntry)) = ArrayList(PragmaEntry).new();
/// Has `module_path` declared a given pragma?
///
/// The registry stores keys through `canonical_module_path`: two spellings
/// of one module coexist (AGENTS.md) — the ENTRY module's tokens carry the
/// plain path while demand-loaded tokens (and, measured, the LSP's
/// evaluation of an open document) carry the `file://<abs>` cache key — so
/// a raw `==` between a reader's spelling and the writer's silently missed
/// (the LSP hover's verification-mode lookup read `runtime` for a
/// `pragma(Pragma.Verify);` document).
file_has_pragma :: (fn(module_path : Option(String), kind : Pragma) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => {
      key := canonical_module_path(mp.clone());
      (found : bool) = false;
      (i : usize) = usize(0);
      n := g_privileged_files.len();
      while((i < n) && !found, {
        match(
          g_privileged_files.get(i),
          .Some(entry) => if((entry.module_path == key) && (entry.kind == kind), {
            found = true;
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    }
  )
);
/// Record that `module_path` declared `pragma(Pragma.X);`. The key is stored
/// CANONICAL (see `file_has_pragma`'s note).
register_file_pragma :: (fn(module_path : String, kind : Pragma) -> unit)({
  canonical := canonical_module_path(module_path);
  if(!file_has_pragma(Option(String).Some(canonical.clone()), kind), {
    g_privileged_files.push(PragmaEntry(module_path : canonical, kind : kind));
  });
});
/// Reset the registry. Used between independent `check` runs.
_clear_pragma_registry :: (fn() -> unit)({
  g_privileged_files = ArrayList(PragmaEntry).new();
  ()
});
/// Drop pragma entries for a single module (LSP edit / cache invalidation).
_clear_pragma_for_module :: (fn(module_path : String) -> unit)({
  key := canonical_module_path(module_path);
  kept := ArrayList(PragmaEntry).new();
  (i : usize) = usize(0);
  n := g_privileged_files.len();
  while(i < n, {
    match(
      g_privileged_files.get(i),
      .Some(entry) => if(entry.module_path != key, {
        kept.push(entry);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  g_privileged_files = kept;
  ()
});
/// Is the module path implicitly unsafe-capable for pointer ops?
///
/// True if the file declared `pragma(Pragma.AllowUnsafe);`, OR the
/// expression came from compiler-synthesized code whose URI is
/// `auto-generated://...` (which inherits the privileged caller's policy).
is_implicitly_unsafe_capable_file :: (fn(module_path : Option(String)) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => if(
      mp.starts_with(String.from("auto-generated://")),
      true,
      file_has_pragma(Option(String).Some(mp.clone()), Pragma.AllowUnsafe)
    )
  )
);
/// Is this module path a compiler-synthesized expansion (macro, derive,
/// prelude desugaring)? Such URIs are tagged `auto-generated://...`.
is_auto_generated_expansion :: (fn(module_path : Option(String)) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => mp.starts_with(String.from("auto-generated://"))
  )
);
/// Is the module path permitted to DEFINE macros (`quote(...)` parameters
/// / `unquote(...)` return types)? True if the file declared
/// `pragma(Pragma.AllowMacroDef);`, OR the code is compiler-synthesized
/// (`auto-generated://` inherits the privileged caller's policy, same as
/// the unsafe gate), OR the file belongs to the standard library
/// (`file://<std_path>/...`).
///
/// The std exemption is BOOTSTRAP-TRANSITIONAL: the seed binary's pragma
/// handler predates `AllowMacroDef`, so std files cannot carry the pragma
/// call until a release that knows the variant becomes the seed. Once one
/// does, add `pragma(Pragma.AllowMacroDef);` to the std macro-defining
/// files and drop the std branch (plans/reference/MACRO_POLICY.md Part 2).
/// Lexically absolutize a path for the std-prefix comparison below: strip a
/// `file://` scheme, then absolutize. Purely lexical — no symlink
/// resolution — matching how the loaders build std module URIs (a join on
/// the same std root). Normalization is delegated to `Path`, whose
/// `is_absolute` recognizes the Windows shapes (`C:/...`, `\\host/...`) and
/// folds `\` to `/`; a hand-rolled leading-`/` check cwd-joins those into
/// `<cwd>/C:/...` garbage, which silently voided the std exemptions below
/// for every Windows invocation whose std path arrived relative
/// (issues/fixed/windows-lex-abs-path-voids-std-exemption.md).
_lex_abs_path :: (fn(p : String) -> String)({
  (s : String) = p.clone();
  if(s.starts_with(`file://`), {
    s = s.slice_copy(usize(7) .. s.len());
  });
  (path : Path) = Path.new(s);
  if(path.is_absolute(), {
    return(path.to_string());
  });
  match(
    cwd(),
    .Ok(d) => d.join(path).to_string(),
    .Err(_) => path.to_string()
  )
});
/// Is `mp` a module under the standard library root? Module paths reach here
/// in several forms — raw relative ("./std/prelude.yo"), absolute `file:///...`
/// URIs (import-resolved std modules), and whatever form `--std-path` /
/// `YO_STD` was given in — so absolutize BOTH sides lexically before the
/// prefix check.
_is_std_module_path :: (fn(mp : String, std_path : String) -> bool)({
  (sp : String) = std_path.clone();
  while(sp.ends_with(`/`), {
    sp = sp.slice_copy(usize(0) .. (sp.len() - usize(1)));
  });
  if(sp.len() == usize(0), {
    return(false);
  });
  _lex_abs_path(mp.clone()).starts_with(`${_lex_abs_path(sp)}/`)
});
is_macro_def_capable_file :: (fn(module_path : Option(String), std_path : String) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => {
      if(mp.starts_with(String.from("auto-generated://")), {
        return(true);
      });
      // std exemption (see _is_std_module_path).
      if(_is_std_module_path(mp.clone(), std_path.clone()), {
        return(true);
      });
      file_has_pragma(Option(String).Some(mp.clone()), Pragma.AllowMacroDef)
    }
  )
);
/// May code in this module HOLD a raw pointer value (bind, pass, store or
/// return one — not only dereference it)? True for unsafe-capable files
/// (`pragma(Pragma.AllowUnsafe)`), for compiler-synthesized expansions
/// (`auto-generated://`, inheriting the caller's policy), and for the
/// standard library — the audited trusted base, whose safe abstractions hand
/// pointers between their own layers (`s.ptr()` into a byte buffer) without
/// dereferencing them in every file. Everything else borrows elements with
/// `for(coll, inout(x) => …)` (plans/archive/INOUT_LOCAL_BINDINGS_AUDIT.md Phase D).
is_pointer_value_capable_file :: (fn(module_path : Option(String), std_path : String) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => {
      if(is_implicitly_unsafe_capable_file(Option(String).Some(mp.clone())), {
        return(true);
      });
      _is_std_module_path(mp.clone(), std_path.clone())
    }
  )
);
/// Is the module path permitted to define an OVERLOAD SET — an exported
/// `Call` member holding a tuple of two or more candidate functions? Yo
/// follows Rust: no function overloading. The single sanctioned use is
/// std/prelude.yo's runtime/comptime operator pairing (`(-)`/`(!)`/`(~)`
/// modules, `Call :: (neg, comptime_neg)`), so only the prelude itself —
/// plus compiler-synthesized `auto-generated://` code, which inherits the
/// privileged caller's policy like the unsafe and macro gates — passes.
/// See plans/reference/FUNCTION_OVERLOADING_POLICY.md.
is_overload_set_capable_file :: (fn(module_path : Option(String), std_path : String) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => {
      if(mp.starts_with(String.from("auto-generated://")), {
        return(true);
      });
      (sp : String) = std_path.clone();
      while(sp.ends_with(`/`), {
        sp = sp.slice_copy(usize(0) .. (sp.len() - usize(1)));
      });
      if(sp.len() == usize(0), {
        return(false);
      });
      return(_lex_abs_path(mp.clone()) == `${_lex_abs_path(sp)}/prelude.yo`);
    }
  )
);
/// ── Safe mode: the class-1 panic vocabulary (D7, decided 2026-09-22;
/// plans/backlog/SAFE_MODE.md §3 0c) ──
///
/// `unwrap` / `expect` / `unwrap_err` on `Option`/`Result` discard failure
/// information the receiver's type ALREADY gave the caller and abort on the
/// failure case. Safe files may not call them: handle the failure case
/// (`match` on the variants, `unwrap_or` / `unwrap_or_else`, or propagate).
/// Deliberate abort (`panic`, `assert`) and value-level traps (indexing,
/// `/`) are NOT class 1 and stay legal — the ban is exactly "a call may not
/// erase a failure the type carries".
///
/// The registry is spelled as these predicates; `public_safe_report` grows
/// the cross-check section when a second library needs the gate.
is_class1_panic_method_name :: (fn(name : String) -> bool)(
  (name == "unwrap") || (name == "expect") || (name == "unwrap_err")
);
/// The receiver types whose extraction methods are class 1: the failure is
/// IN the type. The value must BE an enum (`Option`/`Result` are enums), and
/// the NAME is read through `type_to_string` rather than the `.EnumT` name
/// field: real Option/Result TypeValues frequently carry an EMPTY name (the
/// printer falls back to the display registry), so a name-field comparison
/// never fired — probe-verified 2026-09-22: the fixture receiver's ExprInfo
/// said `Option(i32)` and a name-field comparison returned false. The
/// `(` in the prefix keeps a hypothetical user `OptionEx(` from matching.
is_class1_panic_receiver_type :: (fn(t : TypeValue) -> bool)(
  match(
    t_refine_inner(t),
    .EnumT(_, _, _, _, _, _, _, _, _) => {
      s := type_to_string(t);
      s.starts_with(String.from("Option(")) || s.starts_with(String.from("Result(")) || ((s == "Option") || (s == "Result"))
    },
    // A `*(T)`-typed self parameter (`fn(self : *(Self))`-shaped impls):
    // look through the pointer.
    .Pointer(inner) => is_class1_panic_receiver_type(inner),
    _ => false
  )
);
/// Files exempt from the class-1 ban: the standard library (the trusted
/// base; its own `unwrap` sites migrate on a ratchet, not a big bang),
/// test files (`*.test.yo` — an unwrapped `.None` fails the test loudly
/// with a perfect diagnostic, which is the test doing its job),
/// compiler-synthesized expansions (inheriting the caller's policy, like
/// every gate here), and `pragma(Pragma.AllowUnsafe)` files.
///
/// NOT exempt: comptime contexts. Verified 2026-09-22 on the seed: a
/// comptime-known `Option(i32).None` receiver still emits a runtime unwrap
/// (no CTFE folding), so a comptime carve-out would leave the panic
/// reachable. The carve-out lands when comptime `unwrap` of `.None`
/// becomes a compile error (the plan's VERIFY-and-make-so step).
is_class1_panic_exempt_file :: (fn(module_path : Option(String), std_path : String) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => {
      if(mp.starts_with(String.from("auto-generated://")), {
        return(true);
      });
      if(mp.ends_with(String.from(".test.yo")), {
        return(true);
      });
      if(_is_std_module_path(mp.clone(), std_path.clone()), {
        return(true);
      });
      file_has_pragma(Option(String).Some(mp.clone()), Pragma.AllowUnsafe)
    }
  )
);
export(
  register_file_pragma,
  file_has_pragma,
  _clear_pragma_registry,
  _clear_pragma_for_module,
  is_implicitly_unsafe_capable_file,
  is_auto_generated_expansion,
  is_macro_def_capable_file,
  is_pointer_value_capable_file,
  is_overload_set_capable_file,
  is_class1_panic_method_name,
  is_class1_panic_receiver_type,
  is_class1_panic_exempt_file,
  _lex_abs_path
);
