//! Memory-safety helpers (Phase C of plans/reference/MEMORY_SAFETY.md).
//!
//! 1-to-1 port of `src/evaluator/memory-safety.ts`.
//!
//! Per-file privilege tracking via `pragma(Pragma.AllowUnsafe);`. When the
//! `pragma` builtin is evaluated, it records the file's URI in the
//! `privileged_files` registry. The pointer-op gates then look up the
//! current expression's source file in this registry — files that declared
//! the pragma bypass the unsafe-wrap requirement.
//!
//! Not yet ported from `src/evaluator/memory-safety.ts`:
//!   * `record_extern_call_site` — a Phase-C migration helper that writes a
//!     JSON worklist on `process.on("exit")` (gated on the
//!     `YO_EXTERN_WRAP_DUMP_FILE` env var). yo-self has no process-exit hook
//!     and it is not needed for evaluator correctness, so it is deferred.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ cwd } :: import("std/env");
{ Path } :: import("std/path");
// NOTE: TS's `memory-safety.ts` declares its own internal `PragmaKind`
// string-union, separate from the user-facing `Pragma` enum. yo-self is
// self-hosted, so the compiler reuses the language's own `Pragma` enum
// (defined in `std/prelude.yo`, auto-loaded into every module) as the
// pragma-kind type — one source of truth, no duplicate enum. `Pragma`
// derives `Eq` in the prelude, so `==` is used directly below.
/// One `(module_path, kind)` entry in the per-file pragma registry.
/// (yo-self flattens TS's `Map<string, Set<PragmaKind>>` to a list of pairs
/// to avoid a `HashSet(Pragma)` hashing requirement; the semantics —
/// membership of a `kind` for a `module_path` — are identical.)
PragmaEntry :: struct(module_path : String, kind : Pragma);
/// Per-file pragma registry. Keyed by canonical module URI (the value of
/// `token.module_path`, e.g. `file:///path/to/foo.yo`). Mirrors the
/// `privilegedFiles` map in `src/evaluator/memory-safety.ts`.
(g_privileged_files : ArrayList(PragmaEntry)) = ArrayList(PragmaEntry).new();
/// Has `module_path` declared a given pragma? Mirrors `fileHasPragma`.
/// (Defined before `register_file_pragma`, which calls it — yo-self requires
/// define-before-use; TS hoists.)
file_has_pragma :: (fn(module_path : Option(String), kind : Pragma) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => {
      (found : bool) = false;
      (i : usize) = usize(0);
      n := g_privileged_files.len();
      while((i < n) && !found, {
        match(
          g_privileged_files.get(i),
          .Some(entry) => if((entry.module_path == mp) && (entry.kind == kind), {
            found = true;
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    }
  )
);
/// Record that `module_path` declared `pragma(Pragma.X);`.
/// Mirrors `registerFilePragma`.
register_file_pragma :: (fn(module_path : String, kind : Pragma) -> unit)({
  if(!file_has_pragma(Option(String).Some(module_path.clone()), kind), {
    g_privileged_files.push(PragmaEntry(module_path : module_path, kind : kind));
  });
});
/// Reset the registry. Used between independent `check` runs. Mirrors
/// `_clearPragmaRegistry`.
_clear_pragma_registry :: (fn() -> unit)({
  g_privileged_files = ArrayList(PragmaEntry).new();
  ()
});
/// Drop pragma entries for a single module (LSP edit / cache invalidation).
/// Mirrors `_clearPragmaForModule`.
_clear_pragma_for_module :: (fn(module_path : String) -> unit)({
  kept := ArrayList(PragmaEntry).new();
  (i : usize) = usize(0);
  n := g_privileged_files.len();
  while(i < n, {
    match(
      g_privileged_files.get(i),
      .Some(entry) => if(entry.module_path != module_path, {
        kept.push(entry);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  g_privileged_files = kept;
  ()
});
/// Is the module path implicitly unsafe-capable for pointer ops?
///
/// True if the file declared `pragma(Pragma.AllowUnsafe);`, OR the
/// expression came from compiler-synthesized code whose URI is
/// `auto-generated://...` (which inherits the privileged caller's policy).
/// Mirrors `isImplicitlyUnsafeCapableFile`.
is_implicitly_unsafe_capable_file :: (fn(module_path : Option(String)) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => if(
      mp.starts_with(String.from("auto-generated://")),
      true,
      file_has_pragma(Option(String).Some(mp.clone()), Pragma.AllowUnsafe)
    )
  )
);
/// Is this module path a compiler-synthesized expansion (macro, derive,
/// prelude desugaring)? Such URIs are tagged `auto-generated://...`.
/// Mirrors `isAutoGeneratedExpansion`.
is_auto_generated_expansion :: (fn(module_path : Option(String)) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => mp.starts_with(String.from("auto-generated://"))
  )
);
/// Is the module path permitted to DEFINE macros (`quote(...)` parameters
/// / `unquote(...)` return types)? True if the file declared
/// `pragma(Pragma.AllowMacroDef);`, OR the code is compiler-synthesized
/// (`auto-generated://` inherits the privileged caller's policy, same as
/// the unsafe gate), OR the file belongs to the standard library
/// (`file://<std_path>/...`).
///
/// The std exemption is BOOTSTRAP-TRANSITIONAL: the seed binary's pragma
/// handler predates `AllowMacroDef`, so std files cannot carry the pragma
/// call until a release that knows the variant becomes the seed. Once one
/// does, add `pragma(Pragma.AllowMacroDef);` to the std macro-defining
/// files and drop the std branch (plans/reference/MACRO_POLICY.md Part 2).
/// Lexically absolutize a path for the std-prefix comparison below: strip a
/// `file://` scheme, then absolutize. Purely lexical — no symlink
/// resolution — matching how the loaders build std module URIs (a join on
/// the same std root). Normalization is delegated to `Path`, whose
/// `is_absolute` recognizes the Windows shapes (`C:/...`, `\\host/...`) and
/// folds `\` to `/`; a hand-rolled leading-`/` check cwd-joins those into
/// `<cwd>/C:/...` garbage, which silently voided the std exemptions below
/// for every Windows invocation whose std path arrived relative
/// (issues/windows-lex-abs-path-voids-std-exemption.md).
_lex_abs_path :: (fn(p : String) -> String)({
  (s : String) = p.clone();
  if(s.starts_with(`file://`), {
    s = s.slice_copy(usize(7) .. s.len());
  });
  (path : Path) = Path.new(s);
  if(path.is_absolute(), {
    return(path.to_string());
  });
  match(
    cwd(),
    .Ok(d) => d.join(path).to_string(),
    .Err(_) => path.to_string()
  )
});
is_macro_def_capable_file :: (fn(module_path : Option(String), std_path : String) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => {
      if(mp.starts_with(String.from("auto-generated://")), {
        return(true);
      });
      // std exemption: module paths reach here in several forms — raw
      // relative ("./std/prelude.yo"), absolute `file:///...` URIs
      // (import-resolved std modules), and whatever form `--std-path` /
      // `YO_STD` was given in — so absolutize BOTH sides lexically before
      // the prefix check.
      (sp : String) = std_path.clone();
      while(sp.ends_with(`/`), {
        sp = sp.slice_copy(usize(0) .. (sp.len() - usize(1)));
      });
      if(sp.len() > usize(0), {
        if(_lex_abs_path(mp.clone()).starts_with(`${_lex_abs_path(sp)}/`), {
          return(true);
        });
      });
      file_has_pragma(Option(String).Some(mp.clone()), Pragma.AllowMacroDef)
    }
  )
);
/// Is the module path permitted to define an OVERLOAD SET — an exported
/// `Call` member holding a tuple of two or more candidate functions? Yo
/// follows Rust: no function overloading. The single sanctioned use is
/// std/prelude.yo's runtime/comptime operator pairing (`(-)`/`(!)`/`(~)`
/// modules, `Call :: (neg, comptime_neg)`), so only the prelude itself —
/// plus compiler-synthesized `auto-generated://` code, which inherits the
/// privileged caller's policy like the unsafe and macro gates — passes.
/// See plans/reference/FUNCTION_OVERLOADING_POLICY.md.
is_overload_set_capable_file :: (fn(module_path : Option(String), std_path : String) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => {
      if(mp.starts_with(String.from("auto-generated://")), {
        return(true);
      });
      (sp : String) = std_path.clone();
      while(sp.ends_with(`/`), {
        sp = sp.slice_copy(usize(0) .. (sp.len() - usize(1)));
      });
      if(sp.len() == usize(0), {
        return(false);
      });
      return(_lex_abs_path(mp.clone()) == `${_lex_abs_path(sp)}/prelude.yo`);
    }
  )
);
export(
  register_file_pragma,
  file_has_pragma,
  _clear_pragma_registry,
  _clear_pragma_for_module,
  is_implicitly_unsafe_capable_file,
  is_auto_generated_expansion,
  is_macro_def_capable_file,
  is_overload_set_capable_file,
  _lex_abs_path
);
