//! Memory-safety helpers (Phase C of plans/reference/MEMORY_SAFETY.md).
//!
//! Per-file privilege tracking via `pragma(Pragma.AllowUnsafe);`. When the
//! `pragma` builtin is evaluated, it records the file's URI in the
//! `privileged_files` registry. The pointer-op gates then look up the
//! current expression's source file in this registry — files that declared
//! the pragma bypass the unsafe-wrap requirement.
//!
//! Not ported:
//!   * `record_extern_call_site` — a Phase-C migration helper that writes a
//!     JSON worklist on `process.on("exit")` (gated on the
//!     `YO_EXTERN_WRAP_DUMP_FILE` env var). The compiler has no process-exit
//!     hook and it is not needed for evaluator correctness, so it is deferred.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array-list");
{ HashMap } :: import("std/collections/hash-map");
{ cwd } :: import("std/env");
{ Path } :: import("std/path");
{ TypeValue, t_refine_inner } :: import("../types/definitions.yo");
{ type_to_string } :: import("../types/string.yo");
{ canonical_module_path } :: import("../utils.yo");
{ Token } :: import("../token.yo");
{ format_error_message_with_help, format_error_message_with_rename, with_code } :: import("../error.yo");
{ E_RESERVED_NAME, Span } :: import("../diagnostics.yo");
{ parse } :: import("../parser.yo");
{ AstExpr, ast_expr_id, ast_expr_token, ast_expr_is_fn_call_of, BK_ANON_STRUCT, BK_EXPORT, is_builtin_call_head_name, classify_atom_roles, atom_is_member_or_label, scoped_atoms_of } :: import("../expr.yo");
{ HashSet } :: import("std/collections/hash-set");
{ builtin_type_keyword, is_env_first_c_type_name } :: import("../types/creators.yo");
{ Exception } :: import("std/error");
{ EvalContext } :: import("./context.yo");
{ raise_flow_violation } :: import("../types/flowability.yo");
{ RefCell } :: import("std/sync/refcell");
/// (seed window) Concrete variants of refcell.yo's fillers: a fn value
/// generic over its element keeps the variable abstract through the slot, so
/// uses of the result needing methods fail (see refcell.yo's filler block).
_c_first_cloned_str :: (fn(xs : &ArrayList(String)) -> Option(String))(xs.get_cloned(usize(0)));
/// (seed window) Concrete per-payload variants of refcell.yo's generic
/// fillers: a fn value generic over its element keeps the variable abstract
/// through the slot and its specializations COLLAPSE across element types
/// (see refcell.yo's filler block). Inline the literals back once
/// `SEED_VERSION` carries the ref-spill fix.
/// `ArrayList(PragmaEntry)` (2 uses)
_c_len_1 :: (fn(xs : &ArrayList(PragmaEntry)) -> usize)(xs.len());
// NOTE: the compiler reuses the language's own `Pragma` enum
// (defined in `std/prelude.yo`, auto-loaded into every module) as the
// pragma-kind type — one source of truth, no duplicate enum. `Pragma`
// derives `Eq` in the prelude, so `==` is used directly below.
/// One `(module_path, kind)` entry in the per-file pragma registry.
/// (A list of pairs rather than a hash map, to avoid a `HashSet(Pragma)`
/// hashing requirement; the semantics — membership of a `kind` for a
/// `module_path` — are identical.)
PragmaEntry :: struct(module_path : String, kind : Pragma);
/// `Clone` before the first use (a derive is not order-independent like an
/// `impl`): the registry's element reads clone an entry once `String` is a
/// value (plans/VALUES_BY_DEFAULT.md B8).
derive(PragmaEntry, Clone);
/// Per-file pragma registry. Keyed by canonical module URI (the value of
/// `token.module_path`, e.g. `file:///path/to/foo.yo`).
(g_privileged_files : RefCell(ArrayList(PragmaEntry))) = RefCell(ArrayList(PragmaEntry)).new(ArrayList(PragmaEntry).new());
/// Has `module_path` declared a given pragma?
///
/// The registry stores keys through `canonical_module_path`: two spellings
/// of one module coexist (AGENTS.md) — the ENTRY module's tokens carry the
/// plain path while demand-loaded tokens (and, measured, the LSP's
/// evaluation of an open document) carry the `file://<abs>` cache key — so
/// a raw `==` between a reader's spelling and the writer's silently missed
/// (the LSP hover's verification-mode lookup read `runtime` for a
/// `pragma(Pragma.Verify);` document).
file_has_pragma :: (fn(module_path : &Option(String), kind : Pragma) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => {
      key := canonical_module_path(mp.clone());
      (found : bool) = false;
      (i : usize) = usize(0);
      n := g_privileged_files.with(_c_len_1);
      while((i < n) && !found, {
        match(
          g_privileged_files.with(xs => xs.get_cloned(i)),
          .Some(entry) => if((entry.module_path == key) && (entry.kind == kind), {
            found = true;
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    }
  )
);
/// Record that `module_path` declared `pragma(Pragma.X);`. The key is stored
/// CANONICAL (see `file_has_pragma`'s note).
register_file_pragma :: (fn(module_path : &String, kind : Pragma) -> unit)({
  canonical := canonical_module_path(module_path);
  if(!file_has_pragma(Option(String).Some(canonical.clone()), kind), {
    g_privileged_files.with_mut(xs => xs.push(PragmaEntry(module_path : canonical.clone(), kind : kind)));
  });
});
/// Reset the registry. Used between independent `check` runs.
_clear_pragma_registry :: (fn() -> unit)({
  g_privileged_files.with_mut(xs => xs.clear());
  ()
});
/// Drop pragma entries for a single module (LSP edit / cache invalidation).
_clear_pragma_for_module :: (fn(module_path : &String) -> unit)({
  key := canonical_module_path(module_path);
  kept := ArrayList(PragmaEntry).new();
  (i : usize) = usize(0);
  n := g_privileged_files.with(_c_len_1);
  while(i < n, {
    match(
      g_privileged_files.with(xs => xs.get_cloned(i)),
      .Some(entry) => if(entry.module_path != key, {
        kept.push(entry);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  g_privileged_files.with_mut(xs => xs.clear());
  // The list moves in through the capture list: an implicit capture lent
  // `&mut` inside the closure is a copy under the v0.2.73 seed, so the local
  // would still own (and drop) the moved elements
  // (issues/fixed/2026-11-03-an-implicit-capture-lent-mut-in-a-closure-is-a-copy-under-the-seed.md).
  g_privileged_files.with_mut({ kept }(xs) => xs.extend(kept));
  ()
});
/// Is the module path implicitly unsafe-capable for pointer ops?
///
/// True if the file declared `pragma(Pragma.AllowUnsafe);`, OR the
/// expression came from compiler-synthesized code whose URI is
/// `auto-generated://...` (which inherits the privileged caller's policy).
is_implicitly_unsafe_capable_file :: (fn(module_path : &Option(String)) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => if(
      mp.starts_with(String.from("auto-generated://")),
      true,
      file_has_pragma(Option(String).Some(mp.clone()), Pragma.AllowUnsafe)
    )
  )
);
/// May code at `module_path` READ a member of a `union(...)`?
///
/// An untagged union does not record which member was written last, so a
/// read reinterprets another member's bytes. For a member type with invalid
/// bit patterns (`bool`, a fieldless enum lowered to an integer, a reference)
/// that is C undefined behavior, which safe mode's Promise A excludes. A read
/// is therefore raw-memory reinterpretation, like `*T` and `unsafe.cast`: it
/// needs `pragma(Pragma.AllowUnsafe)` (or an `unsafe(...)` region, which itself
/// needs the pragma). Construction and member writes stay legal everywhere.
/// See issues/fixed/safe-code-can-read-an-inactive-union-member.md.
is_union_member_read_capable :: (fn(module_path : &Option(String), in_unsafe_context : bool) -> bool)(
  in_unsafe_context || is_implicitly_unsafe_capable_file(module_path)
);
/// The diagnostic both union-read gates raise (property access and
/// destructuring).
union_member_read_error_message :: (fn(member : &String, union_type : &String) -> String)(
  `Reading union member \`${member}\` of \`${union_type}\` requires \`pragma(Pragma.AllowUnsafe);\` in this file.

A union does not record which member was written last, so this read may reinterpret another member's bytes, which is undefined behavior for a \`bool\`, an enum or a reference. For a checked sum type use an \`enum\` and \`match\` on its variants.`
);
/// May code at `module_path` call a builtin that destroys a place in place:
/// `___drop`, or an RC release (`__yo_decr_rc`, `__yo_decr_rc_atomic`,
/// `__yo_dyn_drop`, `__yo_sometype_drop`, `__yo_drop_array_element`,
/// `__yo_drop_tuple_element`)? None of them moves the place out, so on a field
/// (`___drop(h.xs)`) the place stays readable after its storage is freed: a
/// use-after-free safe code could write. They are gated like a raw-pointer
/// dereference, except that only the FILE the call is written in counts: an
/// enclosing `unsafe(...)` region does not, because a generic body is
/// evaluated at its call site, so a pragma'd caller's `unsafe(generic_fn(...))`
/// would otherwise admit a destroying call written in a safe file. The drops
/// the compiler synthesizes are parsed from `auto-generated://` code, which
/// the file check admits. See
/// issues/fixed/2026-10-21-the-drop-builtin-is-callable-outside-unsafe.md.
is_destroying_builtin_call_capable :: (fn(module_path : &Option(String)) -> bool)(
  is_implicitly_unsafe_capable_file(module_path)
);
/// The diagnostic every destroying-builtin gate raises; `place` is the
/// argument as written.
destroying_builtin_error_message :: (fn(builtin : &String, place : &String) -> String)(
  `'${builtin}(...)' is not available in safe code: it destroys '${place}' in place without moving it out, so the place stays usable after what it owns is freed.

To end a value early, call 'drop(x)': it moves 'x' in, and a later use is an error. A file that destroys a slot it owns through a raw pointer declares 'pragma(Pragma.AllowUnsafe);' and calls 'unsafe(drop_in_place(p))'.`
);
/// The diagnostic the ownership-accounting builtins raise outside an
/// unsafe-capable file: `__yo_rc_own`, `__yo_capture_field`, `__yo_incr_rc`,
/// `__yo_incr_rc_atomic`, `__yo_dyn_dup`, `__yo_sometype_dup`,
/// `__yo_dup_array_element` and `__yo_dup_tuple_element` add an owner (or a
/// count) the compiler does not record, so the value is freed twice or
/// leaked: `b := __yo_rc_own(a)` was a heap use-after-free in a safe file.
/// They share the destroying builtins' gate
/// (`is_destroying_builtin_call_capable`); the compiler's own uses are
/// parsed from `auto-generated://` code or written in the prelude, which
/// declares the pragma. See
/// issues/fixed/2026-11-21-the-rc-ownership-builtins-are-callable-outside-unsafe.md.
ownership_builtin_error_message :: (fn(builtin : &String, place : &String) -> String)(
  `'${builtin}(...)' is not available in safe code: it adds an owner or a reference count to '${place}' that the compiler does not record, so the value is freed twice, used after it is freed, or leaked.

To share a value, call 'Rc.clone(h)' or 'x.clone()'. These builtins are the compiler's own lowering of copies and drops; a file that genuinely needs one declares 'pragma(Pragma.AllowUnsafe);'.`
);
/// Is this module path a compiler-synthesized expansion (macro, derive,
/// prelude desugaring)? Such URIs are tagged `auto-generated://...`.
is_auto_generated_expansion :: (fn(module_path : &Option(String)) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => mp.starts_with(String.from("auto-generated://"))
  )
);
/// Is the module path permitted to DEFINE macros (`quote(...)` parameters
/// / `unquote(...)` return types)? True if the file declared
/// `pragma(Pragma.AllowMacroDef);`, OR the code is compiler-synthesized
/// (`auto-generated://` inherits the privileged caller's policy, same as
/// the unsafe gate). The standard library has no exemption: each std file
/// that defines a macro declares the pragma like any other file
/// (plans/reference/MACRO_POLICY.md Part 2).
/// Lexically absolutize a path for the std-prefix comparison below: strip a
/// `file://` scheme, then absolutize. Purely lexical — no symlink
/// resolution — matching how the loaders build std module URIs (a join on
/// the same std root). Normalization is delegated to `Path`, whose
/// `is_absolute` recognizes the Windows shapes (`C:/...`, `\\host/...`) and
/// folds `\` to `/`; a hand-rolled leading-`/` check cwd-joins those into
/// `<cwd>/C:/...` garbage, which silently voided the std exemptions below
/// for every Windows invocation whose std path arrived relative
/// (issues/fixed/windows-lex-abs-path-voids-std-exemption.md).
_lex_abs_path :: (fn(p : &String) -> String)({
  (s : String) = p.clone();
  if(s.starts_with(`file://`), {
    s = s.slice_copy(usize(7) .. s.len());
  });
  (path : Path) = Path.new(&s);
  if(path.is_absolute(), {
    return(path.to_string());
  });
  match(
    cwd(),
    .Ok(d) => d.join(&path).to_string(),
    .Err(_) => path.to_string()
  )
});
/// Is `mp` a module under the standard library root? Module paths reach here
/// in several forms — raw relative ("./std/prelude.yo"), absolute `file:///...`
/// URIs (import-resolved std modules), and whatever form `--std-path` /
/// `YO_STD` was given in — so absolutize BOTH sides lexically before the
/// prefix check.
_is_std_module_path :: (fn(mp : &String, std_path : &String) -> bool)({
  (sp : String) = std_path.clone();
  while(sp.ends_with(`/`), {
    sp = sp.slice_copy(usize(0) .. (sp.len() - usize(1)));
  });
  if(sp.len() == usize(0), {
    return(false);
  });
  _lex_abs_path(mp.clone()).starts_with(`${_lex_abs_path(&sp)}/`)
});
/// `_is_std_module_path`, memoized per module path: the call-boundary
/// re-anchoring (calls/function.yo `evaluate_function_call`) asks it for every
/// evaluated call, and the lexical absolutization can hit `cwd()`. The std
/// root is fixed per process; a different one resets the table.
(g_std_path_memo : RefCell(HashMap(String, bool))) = RefCell(HashMap(String, bool)).new(HashMap(String, bool).new());
(g_std_path_memo_root : RefCell(ArrayList(String))) = RefCell(ArrayList(String)).new(ArrayList(String).new());
is_std_module_path :: (fn(mp : &String, std_path : &String) -> bool)({
  if(match(g_std_path_memo_root.with(_c_first_cloned_str), .Some(r) => (r != std_path.*), .None => true), {
    g_std_path_memo.with_mut(m => m.clear());
    g_std_path_memo_root.with_mut(xs => xs.clear());
    std_path_owned := std_path.clone();
    g_std_path_memo_root.with_mut({ std_path_owned }(xs) => xs.push(std_path_owned.clone()));
  });
  match(
    g_std_path_memo.with({ mp : &mp.* }(m) => m.get(mp)),
    .Some(b) => b,
    .None => {
      b := _is_std_module_path(mp.clone(), std_path);
      mp_owned := mp.clone();
      g_std_path_memo.with_mut({ mp_owned, b : b.clone() }(m) => m.insert(mp_owned.clone(), b));
      b
    }
  )
});
/// Does `name` start with `__yo_`, the compiler's namespace (VERDICTS-72)?
/// A name there is a builtin the evaluator or codegen dispatches by spelling,
/// or a runtime symbol whose signature the compiler owns.
is_yo_namespace_name :: (fn(name : &String) -> bool)(
  name.starts_with(String.from("__yo_"))
);
/// May source at `module_path` bind a `__yo_` name (E0407)? Only the std tree
/// (`is_std_module_path`, which absolutizes the as-typed entry spelling and the
/// `file://<abs>` demand-loaded one alike) and compiler-synthesized
/// `auto-generated://` code. `pragma(Pragma.AllowUnsafe)` does not unlock it,
/// and `src/`, `tests/` and fetched dependencies are user code.
may_bind_yo_namespace_name :: (fn(module_path : &String, std_path : &String) -> bool)(
  module_path.starts_with(String.from("auto-generated://")) || is_std_module_path(module_path, std_path)
);
/// The E0407 message for a binder named `name` in the `__yo_` namespace.
reserved_yo_name_message :: (fn(name : &String) -> String)(
  `"${name}" starts with \`__yo_\`, the compiler's namespace: a name there is a compiler builtin or a runtime symbol the compiler owns, so this declaration could never be what a call reaches.`
);
/// The E0407 help line.
reserved_yo_name_help :: (fn() -> String)(
  String.from("delete it and call the std API for the facility, or give your own symbol its own name.")
);
/// Is `tok` an identifier the runner's batch program declares as minted? `yo
/// test` prints each test's AST back to text, and the batch's lexer takes every
/// identifier for one a person wrote. The runner therefore appends the `__yo_`
/// names the parser minted into the printed AST (the atoms whose
/// `TokenData.written` is false: `__yo_tpl_N`, ...) as a last line,
/// `// yo-batch-minted: a b c `, and a binder named there is not a person's.
_is_declared_minted_in_batch :: (fn(tok : &Token) -> bool)({
  if(!tok.module_path.*.contains(String.from(".yo_selftest_batch_")), {
    return(false);
  });
  match(
    tok.input.*.last_index_of(String.from("\n// yo-batch-minted:")),
    .Some(at) => tok.input.*.substring(at, tok.input.*.len()).contains(` ${tok.value.*} `),
    .None => false
  )
});
/// Words the language reserves ahead of their builtin: SPEC_AND_PROOF PR 2
/// (plans/backlog/SPEC_AND_PROOF.md, VERDICTS-92) makes `logic` and `lemma`
/// builtins, and a program that binds either now keeps compiling then.
/// They are reserved, not dispatched: no `BF_` constant names them.
is_reserved_ahead_name :: (fn(name : &String) -> bool)(
  (name.* == "logic") || (name.* == "lemma")
);
/// The E0407 text for a binder named `name` outside the `__yo_` namespace,
/// `.None` when the name may be bound. The reserved set is read from the
/// compiler, not listed here: the call heads its dispatch reaches by spelling
/// (`is_builtin_call_head_name`, src/expr.yo), the builtin type names
/// identifier resolution answers before any binding (`builtin_type_keyword`
/// minus `is_env_first_c_type_name`, src/types/creators.yo), `mut` (it
/// follows `&` in a borrow) and the words reserved ahead of their builtin
/// (`is_reserved_ahead_name`).
reserved_binding_message :: (fn(name : &String) -> Option(String))(
  cond(
    (name.* == "mut") => Option(String).Some(String.from("\"mut\" is reserved: it follows `&` in a borrow (`x : &mut T`, `y := &mut place`, `f(&mut x)`), so it cannot name a binding.")),
    (name.* == "Origin") => Option(String).Some(String.from("\"Origin\" is reserved: it is the kind of an origin (`generic(p : Origin)`), as `Type` is the kind of a type, so it cannot name a binding.")),
    is_builtin_call_head_name(name) => Option(String).Some(`"${name}" names a builtin: a call \`${name}(...)\` reaches the builtin before any binding, so this binding could never be what it calls.`),
    (builtin_type_keyword(name).is_some() && !is_env_first_c_type_name(name)) => Option(String).Some(`"${name}" names a builtin type: \`${name}\` resolves to the type before any binding, so this binding could never be read.`),
    is_reserved_ahead_name(name) => Option(String).Some(`"${name}" is a reserved word: the language reserves it for a builtin, so it cannot name a binding.`),
    true => Option(String).None
  )
);
/// The E0407 help line for `reserved_binding_message`.
reserved_binding_help :: (fn(name : &String) -> String)({
  what := cond(
    (is_reserved_ahead_name(name) || (name.* == "mut") || (name.* == "Origin")) => "a reserved word",
    is_builtin_call_head_name(name) => "a builtin",
    true => "a builtin type"
  );
  `\`${name}\` is ${what}; rename the binding (e.g. \`${name}_\`)`
});
/// Is `name` reserved for every binder outside std's own definitions
/// (`reject_reserved_binder`)? The LSP's rename refuses such a new name.
is_reserved_binding_name :: (fn(name : &String) -> bool)(
  is_yo_namespace_name(name) || reserved_binding_message(name).is_some()
);
/// What a rename of `name` to `renamed` must know about a whole file
/// (`_rename_facts`): the atoms that are a call's head, the atoms a brace
/// group names by pun (`.{ x }`, `{ x } := v`, a capture list), whether an
/// `export(...)` names it, and whether `renamed` is already spelled anywhere.
_RenameFacts :: struct(callees : HashSet(usize), puns : HashSet(usize), exported : bool, taken : bool);
_rename_facts :: (fn(e : &AstExpr, name : &String, renamed : &String, in_export : bool, facts : &mut _RenameFacts) -> unit)(
  match(
    e,
    Rc(.Atom(_, t)) => {
      if(t.value.* == renamed.*, {
        facts.taken = true;
      });
      if(in_export && (t.value.* == name.*), {
        facts.exported = true;
      });
    },
    Rc(.FnCall(_, callee, Rc(args), _, _)) => {
      match(
        callee,
        Rc(.Atom(cid, ct)) => if(ct.value.* == name.*, {
          facts.callees.insert(cid.*);
        }),
        Rc(.FnCall(_, _, _, _, _)) => ()
      );
      is_brace := ast_expr_is_fn_call_of(e, BK_ANON_STRUCT, Option(usize).None);
      sub_export := (in_export || ast_expr_is_fn_call_of(e, BK_EXPORT, Option(usize).None));
      recur(&callee.*, name, renamed, sub_export, facts);
      for(&args, a => {
        if(is_brace, {
          match(
            a,
            Rc(.Atom(aid, at)) => if(at.value.* == name.*, {
              facts.puns.insert(aid.*);
            }),
            Rc(.FnCall(_, _, _, _, _)) => ()
          );
        });
        recur(a, name, renamed, sub_export, facts);
      });
    }
  )
);
/// A local exception for a parse that may fail: the file already lexed and
/// parsed once, but the repair must never be what raises.
_parse_for_rename :: (fn(src : &String, module_path : &String, out : &mut ArrayList(ArrayList(AstExpr))) -> bool)({
  local_exn := Exception(throw : (_err -> unwind(false)));
  out.push(parse(src, module_path, local_exn));
  true
});
_same_position :: (fn(a : &Token, b : &Token) -> bool)((a.row == b.row) && (a.column == b.column));
/// The uses of the binder `tok` (a name `reserved_binding_message`
/// reserves), for E0407's rename repair to `name_`: every atom its syntactic
/// scope gives that binder (`scoped_atoms_of`, src/expr.yo), member names and
/// labels left out. A binder at the top of the module has the module as its
/// scope, unless an `export(...)` names it (an importer's uses are out of
/// reach). `.None`, and so no repair, when the uses are not resolvable:
///
/// - a builtin type name (a use cannot be told from the type it shadows);
/// - a binder whose scope the syntax does not show (a destructuring rename's
///   value side, a capture entry);
/// - a use that heads a call (`name(...)` may mean the builtin) or that a
///   brace group spells by pun (`.{ name }` would rename the field);
/// - an atom the compiler minted, or a file that already spells `name_`.
_reserved_rename_uses :: (fn(tok : &Token) -> Option(ArrayList(Span)))({
  name := tok.value.*.clone();
  if(builtin_type_keyword(&name).is_some(), {
    return(Option(ArrayList(Span)).None);
  });
  parsed := ArrayList(ArrayList(AstExpr)).new();
  if(!_parse_for_rename(&tok.input.*, &tok.module_path.*, &mut parsed), {
    return(Option(ArrayList(Span)).None);
  });
  exprs := parsed(usize(0)).clone();
  renamed := `${name}_`;
  facts := _RenameFacts(callees : HashSet(usize).new(), puns : HashSet(usize).new(), exported : false, taken : false);
  for(&exprs, e => {
    _rename_facts(e, &name, &renamed, false, &mut facts);
  });
  if(facts.taken, {
    return(Option(ArrayList(Span)).None);
  });
  scoped := scoped_atoms_of(&exprs, &name);
  // The binder's own atom and the declaration its scope gives it: itself
  // for a local, none for a binder at the top of the module.
  (found : bool) = false;
  (top_level : bool) = false;
  (own_scope : bool) = false;
  for(&scoped, sa => {
    if(_same_position(&ast_expr_token(&sa.atom), tok), {
      found = true;
      match(
        &sa.scope,
        .Some(d) => {
          own_scope = _same_position(d, tok);
        },
        .None => {
          top_level = true;
        }
      );
    });
  });
  if(!found || (!top_level && !own_scope), {
    return(Option(ArrayList(Span)).None);
  });
  if(top_level && facts.exported, {
    return(Option(ArrayList(Span)).None);
  });
  roles := classify_atom_roles(&exprs);
  uses := ArrayList(Span).new();
  seen := HashSet(String).new();
  name_len := name.clone().chars().count();
  for(&scoped, sa => {
    t := ast_expr_token(&sa.atom);
    same_binding := match(&sa.scope, .Some(d) => (!top_level && _same_position(d, tok)), .None => top_level);
    if(same_binding && !_same_position(&t, tok) && !atom_is_member_or_label(&roles, ast_expr_id(&sa.atom)), {
      id := ast_expr_id(&sa.atom);
      if(!t.written || facts.callees.contains(&id) || facts.puns.contains(&id), {
        return(Option(ArrayList(Span)).None);
      });
      at := `${t.row.to_string()}:${t.column.to_string()}`;
      if(!seen.contains(&at), {
        seen.insert(at);
        uses.push(Span(path : t.module_path.*.clone(), row : usize(t.row), col : usize(t.column), len : name_len));
      });
    });
  });
  if(facts.puns.len() > usize(0), {
    // The binder itself may be a pun (`{ name } := v`): the edit would rename
    // the field it picks.
    for(&scoped, sa => {
      if(_same_position(&ast_expr_token(&sa.atom), tok) && facts.puns.contains(&ast_expr_id(&sa.atom)), {
        return(Option(ArrayList(Span)).None);
      });
    });
  });
  Option(ArrayList(Span)).Some(uses)
});
/// E0407: a binder written in source (`::`, `:=`, a typed `(x : T) =`, a
/// parameter (a closure's included), a closure capture entry, a labeled
/// return, a pattern or destructuring binding, an import rename) named by a
/// reserved word.
///
/// - A name in the `__yo_` namespace (VERDICTS-72 rule (b)) is reserved
///   outside the std tree.
/// - A name `reserved_binding_message` reserves (the maintainer's decision
///   of 2026-11-27 on issues/fixed/builtin-name-shadows-user-definition.md)
///   is reserved everywhere, except for a std module's own top-level
///   definitions (`reject_reserved_definition`).
///
/// The binder is judged by `TokenData.written`, the fact that the lexer made
/// the token: the compiler mints `__yo_tpl_N`, `__yo_self`, `__yo_pat_s` and
/// `__yo_contract_result` into user modules under the user's path, and those
/// are never rejected. Uses stay legal.
///
/// Raised through `raise_flow_violation`: a closure parameter is bound while
/// a call's argument is tried against the callee's signature, and a plain
/// throw there is swallowed with the trial.
reject_reserved_binder :: (fn(tok : &Token, ctx : &EvalContext, exn : Exception) -> unit)({
  if(!tok.written || tok.module_path.*.starts_with(String.from("auto-generated://")), {
    return(());
  });
  name := tok.value.*.clone();
  if(is_yo_namespace_name(&name), {
    if(!may_bind_yo_namespace_name(&tok.module_path.*, &ctx.std_path) && !_is_declared_minted_in_batch(tok), {
      raise_flow_violation(&format_error_message_with_help(tok, &reserved_yo_name_message(&name), &Option(String).Some(reserved_yo_name_help())), ctx, exn);
    });
    return(());
  });
  match(
    reserved_binding_message(&name),
    .Some(msg) => {
      help := Option(String).Some(reserved_binding_help(&name));
      err := match(
        _reserved_rename_uses(tok),
        .Some(uses) => format_error_message_with_rename(tok, &msg, &help, &`${name}_`, &`rename \`${name}\` to \`${name}_\` here and at its ${uses.len().to_string()} use(s)`, &uses),
        .None => format_error_message_with_help(tok, &msg, &help)
      );
      raise_flow_violation(&with_code(&err, E_RESERVED_NAME), ctx, exn);
    },
    .None => ()
  );
});
/// `reject_reserved_binder` for a statement binder (`name :: v`, `name := v`,
/// `(name : T) = v`). A std module's own top-level definition is exempt: std
/// defines builtin-named things on purpose (the prelude's `unsafe` namespace,
/// std/build.yo's `test`, reached as `build.test(...)`), and the exemption is
/// keyed on the resolved std root (`is_std_module_path`), never on a path
/// suffix (issues/fixed/2026-11-27-the-reserved-name-exemption-is-keyed-on-a-path-suffix.md).
/// A std function's parameters and locals are checked like any other.
reject_reserved_definition :: (fn(tok : &Token, ctx : &EvalContext, exn : Exception) -> unit)({
  if(ctx.is_evaluating_function_body_or_async_block.is_none() && is_std_module_path(&tok.module_path.*, &ctx.std_path), {
    return(());
  });
  reject_reserved_binder(tok, ctx, exn);
});
/// Decision 47 step 2 (locals), Generation A (plans/VALUES_BY_DEFAULT.md):
/// the mutability rule for a binding below module level (a write to an
/// unmarked local, pattern or compile-time binding, E0917) is enforced
/// outside the trees not yet swept: the compiler source beside std
/// (`<std>/../src/`), the repository's own build file and scripts
/// (`<std>/../build.yo`, `<std>/../scripts/`, e.g. `scripts/build-site.yo` in
/// the release job), a fetched dependency in the store
/// (`.../store/sha256/...`) and macro expansions. std is NOT exempt: its half
/// of Generation B (v0.2.71, `plans/handover/VBD_RELEASE_SCHEDULE.md` §5c
/// decision 18) marked every written std binding, so a std local that is
/// written must be `mut`. The module-level rules (E0917 on a global, E0916)
/// no longer consult it: globals Generation B swept std and src. The src
/// half of locals Generation B (v0.2.72) sweeps the rest and drops this
/// exemption.
(g_mut_rule_exempt_memo : RefCell(HashMap(String, bool))) = RefCell(HashMap(String, bool)).new(HashMap(String, bool).new());
is_global_mut_rule_exempt :: (fn(mp : &String, std_path : &String) -> bool)(
  match(
    g_mut_rule_exempt_memo.with({ mp : &mp.* }(m) => m.get(mp)),
    .Some(b) => b,
    .None => {
      (sp : String) = std_path.clone();
      while(sp.ends_with(`/`), {
        sp = sp.slice_copy(usize(0) .. (sp.len() - usize(1)));
      });
      abs := _lex_abs_path(mp.clone());
      repo_root := match(Path.new(_lex_abs_path(&sp)).parent(), .Some(pp) => pp.to_string(), .None => String.new());
      src_root := `${repo_root}/src/`;
      scripts_root := `${repo_root}/scripts/`;
      build_file := `${repo_root}/build.yo`;
      store := String.from("/store/sha256/");
      b := (
        mp.starts_with(String.from("auto-generated://")) || (abs.starts_with(&src_root) || (abs.starts_with(&scripts_root) || ((abs == build_file) || abs.contains(&store))))
      );
      mp_owned := mp.clone();
      g_mut_rule_exempt_memo.with_mut({ mp_owned, b : b.clone() }(m) => m.insert(mp_owned.clone(), b));
      b
    }
  )
);
is_macro_def_capable_file :: (fn(module_path : &Option(String)) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => {
      if(mp.starts_with(String.from("auto-generated://")), {
        return(true);
      });
      file_has_pragma(Option(String).Some(mp.clone()), Pragma.AllowMacroDef)
    }
  )
);
/// May code in this module HOLD a raw pointer value (bind, pass, store or
/// return one — not only dereference it)? True for unsafe-capable files
/// (`pragma(Pragma.AllowUnsafe)`), for compiler-synthesized expansions
/// (`auto-generated://`, inheriting the caller's policy), and for the
/// standard library — the audited trusted base, whose safe abstractions hand
/// pointers between their own layers (`s.ptr()` into a byte buffer) without
/// dereferencing them in every file. Everything else borrows elements with
/// `for(&mut coll, x => …)` (plans/archive/INOUT_LOCAL_BINDINGS_AUDIT.md Phase D).
is_pointer_value_capable_file :: (fn(module_path : &Option(String), std_path : &String) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => {
      if(is_implicitly_unsafe_capable_file(Option(String).Some(mp.clone())), {
        return(true);
      });
      _is_std_module_path(mp.clone(), std_path.clone())
    }
  )
);
/// Is the module path permitted to define an OVERLOAD SET — an exported
/// `Call` member holding a tuple of two or more candidate functions? Yo
/// follows Rust: no function overloading. The single sanctioned use is
/// std/prelude.yo's runtime/comptime operator pairing (`(-)`/`(!)`/`(~)`
/// modules, `Call :: (neg, comptime_neg)`), so only the prelude itself —
/// plus compiler-synthesized `auto-generated://` code, which inherits the
/// privileged caller's policy like the unsafe and macro gates — passes.
/// See plans/reference/FUNCTION_OVERLOADING_POLICY.md.
is_overload_set_capable_file :: (fn(module_path : &Option(String), std_path : &String) -> bool)(
  is_prelude_or_generated_file(module_path, std_path)
);
/// Is the module path `std/prelude.yo` itself (under `std_path`), or
/// compiler-synthesized `auto-generated://` code, which inherits the
/// privileged caller's policy? The gate for prelude-only privileges: overload
/// sets (above) and implementing the `Deref` marker
/// (plans/VALUES_BY_DEFAULT.md §3.3, `evaluator/values/impl.yo`).
is_prelude_or_generated_file :: (fn(module_path : &Option(String), std_path : &String) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => {
      if(mp.starts_with(String.from("auto-generated://")), {
        return(true);
      });
      (sp : String) = std_path.clone();
      while(sp.ends_with(`/`), {
        sp = sp.slice_copy(usize(0) .. (sp.len() - usize(1)));
      });
      if(sp.len() == usize(0), {
        return(false);
      });
      return(_lex_abs_path(mp.clone()) == `${_lex_abs_path(&sp)}/prelude.yo`);
    }
  )
);
/// ── Safe mode: the class-1 panic vocabulary (D7, decided 2026-09-22;
/// plans/backlog/SAFE_MODE.md §3 0c) ──
///
/// `unwrap` / `expect` / `unwrap_err` / `expect_err` on `Option`/`Result`
/// discard failure information the receiver's type ALREADY gave the caller
/// and abort on the failure case. Safe files may not call them: handle the failure case
/// (`match` on the variants, `unwrap_or` / `unwrap_or_else`, or propagate).
/// Deliberate abort (`panic`, `assert`) and value-level traps (indexing,
/// `/`) are NOT class 1 and stay legal — the ban is exactly "a call may not
/// erase a failure the type carries".
///
/// The registry is spelled as these predicates. `public_safe_report`'s
/// class-1 section cross-checks the name list against every `Option`/`Result`
/// method that reaches `__yo_panic`, and `tests/internal/memory-safety-paths.test.yo`
/// runs it over the prelude: `expect_err` was missing from this list until
/// that check existed (issues/fixed/result-expect-err-escapes-the-class-1-ban.md).
is_class1_panic_method_name :: (fn(name : &String) -> bool)(
  (name.* == "unwrap") || (name.* == "expect") || (name.* == "unwrap_err") || (name.* == "expect_err")
);
/// The receiver types whose extraction methods are class 1: the failure is
/// IN the type. The value must BE an enum (`Option`/`Result` are enums), and
/// the NAME is read through `type_to_string` rather than the `.EnumT` name
/// field: real Option/Result TypeValues frequently carry an EMPTY name (the
/// printer falls back to the display registry), so a name-field comparison
/// never fired — probe-verified 2026-09-22: the fixture receiver's ExprInfo
/// said `Option(i32)` and a name-field comparison returned false. The
/// `(` in the prefix keeps a hypothetical user `OptionEx(` from matching.
is_class1_panic_receiver_type :: (fn(t : &TypeValue) -> bool)(
  match(
    t_refine_inner(t),
    Rc(.EnumT(_, _, _, _, _, _, _, _, _, _)) => {
      s := type_to_string(t);
      s.starts_with(String.from("Option(")) || s.starts_with(String.from("Result(")) || (s == "Option") || (s == "Result")
    },
    // A `*(T)`-typed self parameter (`fn(self : *(Self))`-shaped impls):
    // look through the pointer.
    Rc(.Pointer(inner)) => is_class1_panic_receiver_type(&inner),
    _ => false
  )
);
/// Files exempt from the class-1 ban: test files (`*.test.yo` — an unwrapped `.None` fails the test loudly
/// with a perfect diagnostic, which is the test doing its job),
/// compiler-synthesized expansions (inheriting the caller's policy, like
/// every gate here), and `pragma(Pragma.AllowUnsafe)` files.
///
/// The standard library gets NO blanket exemption: its safe files are
/// held to the same rule as user code (the ratchet closed 2026-09-23 with
/// the last safe-file sites migrated), and its `AllowUnsafe` files are
/// exempt by the pragma exactly as a user's would be.
///
/// NOT exempt: comptime contexts. Verified 2026-09-22 on the seed: a
/// comptime-known `Option(i32).None` receiver still emits a runtime unwrap
/// (no CTFE folding), so a comptime carve-out would leave the panic
/// reachable. The carve-out lands when comptime `unwrap` of `.None`
/// becomes a compile error (the plan's VERIFY-and-make-so step).
is_class1_panic_exempt_file :: (fn(module_path : &Option(String)) -> bool)(
  match(
    module_path,
    .None => false,
    .Some(mp) => {
      if(mp.starts_with(String.from("auto-generated://")), {
        return(true);
      });
      // `yo test` concatenates *.test.yo files into
      // `.yo_selftest_batch_<pid>_<n>_<m>.yo` — the batch loses the .test.yo
      // suffix this exemption matches, so the batch artifact is exempted by
      // its own distinctive name (found via the wasm32_wasi leg: every test
      // whose body unwraps a Result rejected with E0611).
      if(mp.contains(String.from(".yo_selftest_batch_")), {
        return(true);
      });
      if(mp.ends_with(String.from(".test.yo")), {
        return(true);
      });
      file_has_pragma(Option(String).Some(mp.clone()), Pragma.AllowUnsafe)
    }
  )
);
export(
  register_file_pragma,
  file_has_pragma,
  _clear_pragma_registry,
  _clear_pragma_for_module,
  is_implicitly_unsafe_capable_file,
  is_auto_generated_expansion,
  is_macro_def_capable_file,
  is_global_mut_rule_exempt,
  is_pointer_value_capable_file,
  is_overload_set_capable_file,
  is_prelude_or_generated_file,
  is_union_member_read_capable,
  union_member_read_error_message,
  is_destroying_builtin_call_capable,
  destroying_builtin_error_message,
  ownership_builtin_error_message,
  is_class1_panic_method_name,
  is_class1_panic_receiver_type,
  is_class1_panic_exempt_file,
  is_std_module_path,
  is_yo_namespace_name,
  may_bind_yo_namespace_name,
  reserved_yo_name_message,
  reserved_yo_name_help,
  reject_reserved_binder,
  reject_reserved_definition,
  reserved_binding_message,
  reserved_binding_help,
  is_reserved_binding_name,
  is_reserved_ahead_name,
  _lex_abs_path
);
