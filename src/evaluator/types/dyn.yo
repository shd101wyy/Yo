//! evaluate_dyn_type — handles `Dyn(trait1, !(trait2), …)` type expressions.
//!
//! Scope: argument iteration, trait-type validation, negation
//! detection (`!(...)`), duplicate-id detection, and `DynT` construction.
//!
//! Deferred (commented at the relevant call sites):
//!   * self-constraint / supertrait expansion (needs `selfConstraints` field
//!     on `TraitT`, not yet added)
//!   * function-name conflict check across required traits (needs trait-field
//!     iteration helpers)
//!   * reserved function-name check (___dup, ___drop, ___dispose, dispose)
//!   * `addRcFunctionsToDynType` ARC injection (needs rc_fns infra)
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_fn_call_of,
  BK_DYN_UPPER,
  make_err_expr
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set,
  expr_info_adopt_env
} :: import("../../expr_info.yo");
{ Environment, snapshot_env } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, create_type_value, is_type_value } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_dyn, t_i32 } :: import("../../types/creators.yo");
{ is_trait_type } :: import("../../types/guards.yo");
{ type_of_type } :: import("../../types/hierarchy.yo");
{ type_to_string } :: import("../../types/string.yo");
{ format_error_message, format_eval_failure, with_code } :: import("../../error.yo");
{ E_AMBIGUOUS_METHOD } :: import("../../diagnostics.yo");
{ dyn_member_is_method, dyn_member_unsafe_reason } :: import("../../types/utils.yo");
{ Token } :: import("../../token.yo");
{ Exception } :: import("std/error");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
/// Returns the canonical id of a trait type for duplicate detection.
/// Uses the `id` field on `TraitT` when populated; falls back to the
/// pretty-printed type as an identity proxy.
trait_id_for_dedup :: (fn(imm(t) : TypeValue) -> String)(
  match(
    t,
    .TraitT(_, _, _, _, id, _, _, _, _, _) => {
      if(id.len() > usize(0), {
        return(id);
      });
      type_to_string(t)
    },
    _ => type_to_string(t)
  )
);
/// The vtable slot names one trait gives a `Dyn`: `call` for an `Fn` trait,
/// else every member a `Dyn` can call (`dyn_member_is_method` and no
/// `dyn_member_unsafe_reason`) — exactly the members codegen gives a slot.
_dyn_trait_slot_names :: (fn(imm(t) : TypeValue) -> ArrayList(String))({
  out := ArrayList(String).new();
  match(
    t,
    .FnTraitT(_, _, _, _, _, _, _, _) => out.push(String.from("call")),
    .TraitT({ field_labels : fls, field_types : fts }) => {
      (i : usize) = usize(0);
      while(i < fls.len(), {
        ft := match(fts.get(i), .Some(x) => x, .None => TypeValue.Unit);
        if(dyn_member_is_method(ft) && dyn_member_unsafe_reason(ft).is_none(), {
          match(fls.get(i), .Some(l) => out.push(l), .None => ());
        });
        i = (i + usize(1));
      });
    },
    _ => ()
  );
  out
});
/// E0616 when two traits of one `Dyn` give it a vtable slot of the same name.
_reject_dyn_slot_name_clash :: (fn(imm(traits) : ArrayList(TypeValue), imm(tok) : Token, imm(exn) : Exception) -> unit)({
  seen_names := ArrayList(String).new();
  seen_owner := ArrayList(String).new();
  (ti : usize) = usize(0);
  while(ti < traits.len(), {
    tt := match(traits.get(ti), .Some(x) => x, .None => TypeValue.Unit);
    names := _dyn_trait_slot_names(tt);
    (ni : usize) = usize(0);
    while(ni < names.len(), {
      nm := match(names.get(ni), .Some(x) => x, .None => String.new());
      (si : usize) = usize(0);
      while(si < seen_names.len(), {
        if(match(seen_names.get(si), .Some(x) => (x == nm), .None => false), {
          other := match(seen_owner.get(si), .Some(x) => x, .None => String.new());
          exn.throw(
            dyn(
              with_code(
                format_error_message(
                  tok,
                  `A Dyn cannot hold two methods named "${nm}": both ${other} and ${type_to_string(tt)} declare one. A Dyn calls its methods by name, so the call could not say which trait it means.\nUse one of the traits in this Dyn, or rename one of the methods.`
                ),
                E_AMBIGUOUS_METHOD
              )
            )
          );
        });
        si = (si + usize(1));
      });
      seen_names.push(nm);
      seen_owner.push(type_to_string(tt));
      ni = (ni + usize(1));
    });
    ti = (ti + usize(1));
  });
});
evaluate_dyn_type :: (
  fn(
    imm(expr) : AstExpr,
    imm(env) : Environment,
    imm(ctx) : EvalContext,
    imm(exn) : Exception
  ) -> AstExpr
)({
  if(!ast_expr_is_fn_call_of(expr, BK_DYN_UPPER, .None), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected "Dyn", got:\n${ast_expr_to_string(expr)}`
        )
      )
    );
  });
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  required_traits := ArrayList(TypeValue).new();
  required_levels := ArrayList(usize).new();
  negative_traits := ArrayList(TypeValue).new();
  negative_levels := ArrayList(usize).new();
  required_ids := ArrayList(String).new();
  negative_ids := ArrayList(String).new();
  cur_env := env;
  i := usize(0);
  while(i < args.len(), {
    trait_arg := match(
      args.get(i),
      .Some(a) => a,
      .None => make_err_expr()
    );
    // Detect a negated trait: `!(Trait)`.
    is_negated := ast_expr_is_fn_call_of(trait_arg, "!", .Some(usize(1)));
    actual_arg := if(
      is_negated,
      match(
        trait_arg,
        .FnCall(_, _, inner_args, _, _) => match(
          inner_args.get(usize(0)),
          .Some(a) => a,
          .None => trait_arg
        ),
        _ => trait_arg
      ),
      trait_arg
    );
    eval_trait := evaluate_expression_raw(actual_arg, cur_env, ctx, exn);
    info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_trait));
    trait_info := match(
      info_opt,
      .Some(inf) => inf,
      .None => {
        exn.throw(
          dyn(
            format_eval_failure(
              ast_expr_token(actual_arg),
              `Failed to evaluate argument ${(i + usize(1))} of 'Dyn' expression.`
            )
          )
        );
        new_expr_info(cur_env, t_i32())
      }
    );
    // Validate it is a TypeVal carrying a TraitT.
    inner_ty := match(
      trait_info.value,
      .Some(.TypeVal(it)) => it,
      .Some(_) => t_i32(),
      .None => t_i32()
    );
    if(!is_type_value(trait_info.value), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(actual_arg),
            `Expected a trait type for argument ${(i + usize(1))} of 'Dyn' expression.`
          )
        )
      );
    });
    if(!is_trait_type(inner_ty), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(actual_arg),
            `Expected a trait type for argument ${(i + usize(1))} of 'Dyn' expression, got:\n${type_to_string(inner_ty)}`
          )
        )
      );
    });
    cur_env = expr_info_adopt_env(trait_info);
    tid := trait_id_for_dedup(inner_ty);
    if(is_negated, {
      // Duplicate-in-negative check.
      already := false;
      j := usize(0);
      while(j < negative_ids.len(), {
        existing := match(negative_ids.get(j), .Some(s) => s, .None => String.from(""));
        if(existing == tid, {
          already = true;
        });
        j = (j + usize(1));
      });
      if(already, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(actual_arg),
              `Trait type ${type_to_string(inner_ty)} is already included in negative constraints of 'Dyn' expression.`
            )
          )
        );
      });
      {
        negative_traits.push(inner_ty);
        ();
      };
      {
        negative_levels.push(usize(0));
        ();
      };
      {
        negative_ids.push(tid);
        ();
      };
    }, {
      // Duplicate-in-required check.
      already := false;
      j := usize(0);
      while(j < required_ids.len(), {
        existing := match(required_ids.get(j), .Some(s) => s, .None => String.from(""));
        if(existing == tid, {
          already = true;
        });
        j = (j + usize(1));
      });
      if(already, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(actual_arg),
              `Trait type ${type_to_string(inner_ty)} is already included in 'Dyn' expression.`
            )
          )
        );
      });
      {
        required_traits.push(inner_ty);
        ();
      };
      {
        required_levels.push(usize(0));
        ();
      };
      {
        required_ids.push(tid);
        ();
      };
    });
    i = (i + usize(1));
  });
  // Expand self-constraints (supertraits) from all required traits.
  // e.g. if `Error` has `where(Self <: ToString)`, then `Dyn(Error)` must
  // also carry `ToString` so a `dyn(Error)` value satisfies a `Self <:
  // ToString`-constrained parameter. The loop re-reads `.len()` each
  // iteration, so traits appended here are themselves expanded (BFS).
  qi := usize(0);
  while(qi < required_traits.len(), {
    cur_trait := match(required_traits.get(qi), .Some(t) => t, .None => t_i32());
    scs := match(
      cur_trait,
      .TraitT(_, _, _, _, _, _, sc, _, _, _) => sc,
      _ => ArrayList(TypeValue).new()
    );
    k := usize(0);
    while(k < scs.len(), {
      constraint := match(scs.get(k), .Some(t) => t, .None => t_i32());
      cid := trait_id_for_dedup(constraint);
      already := false;
      m := usize(0);
      while(m < required_ids.len(), {
        eid := match(required_ids.get(m), .Some(s) => s, .None => String.from(""));
        if(eid == cid, {
          already = true;
        });
        m = (m + usize(1));
      });
      if(!already, {
        required_traits.push(constraint);
        required_levels.push(usize(0));
        required_ids.push(cid);
      });
      k = (k + usize(1));
    });
    qi = (qi + usize(1));
  });
  // A vtable dispatches by slot NAME (`d.vtable->get(...)`), so two of the
  // traits may not both give the Dyn a slot with one name: the call could not
  // say which impl it means, and the vtable could hold only one of them
  // (issues/fixed/two-traits-sharing-a-method-name-in-one-dyn-emit-a-duplicate-c-wrapper.md).
  // Only SLOTS count — a method a Dyn cannot call (E0614) has none.
  _reject_dyn_slot_name_clash(required_traits, ast_expr_token(expr), exn);
  // Phase 2aq deferred: reserved function-name check.
  // Phase 2aq deferred: addRcFunctionsToDynType ARC injection.
  dyn_ty := t_dyn(required_traits, required_levels, negative_traits, negative_levels);
  dyn_val := create_type_value(dyn_ty);
  meta_type := type_of_type(dyn_ty);
  out_info := new_expr_info(cur_env, meta_type);
  out_info.value = .Some(dyn_val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
export(evaluate_dyn_type);
