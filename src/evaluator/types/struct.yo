//! evaluate_struct_type — evaluates `struct(...)`, `object(...)`, and `newtype(...)` type expressions.
//!
//! Creates a TypeValue.Struct with the given fields.
//! `is_reference_semantics` is set for `object`, `is_newtype` for `newtype`,
//! and `is_atomic_rc` for `atomic object`.
//! All TypeField metadata is registered in `g_struct_field_registry`.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
import("std/fmt");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  make_err_expr,
  BK_STRUCT,
  BK_NEWTYPE,
  BK_YO_CELL,
  BK_YO_ATOMIC_CELL
} :: import("../../expr.yo");
{ new_expr_info, expr_info_table_set, expr_info_table_get, expr_info_adopt_env } :: import("../../expr_info.yo");
{ Environment, env_adopt } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, create_type_value } :: import("../../value.yo");
{ TypeValue, TypeValueNode, register_struct_field_comptime_flags, shared_list, no_types, no_labels } :: import("../../types/definitions.yo");
{ type_of_type } :: import("../../types/hierarchy.yo");
{ format_error_message, format_error_message_with_help } :: import("../../error.yo");
{ type_to_string } :: import("../../types/string.yo");
{ Exception } :: import("std/error");
{
  TypeField,
  EvalTypeFieldResult,
  evaluate_type_field,
  register_struct_fields
} :: import("./field.yo");
{ stable_position_id, stable_type_id, debug_knob } :: import("../../utils.yo");
{ eprintln } :: import("std/fmt");
{ register_struct_final, _patch_self_shell } :: import("../../types/creators.yo");
{ _type_reaches_root_by_value } :: import("./enum.yo");
{ ArrayList } :: import("std/collections/array_list");
{ auto_derive_traits_for_struct_type, enforce_atomic_object_send } :: import("./utils.yo");
{ fields_have_incompatible_contexts, type_is_control_bound, control_bound_field_message, type_pointee_second_class, type_contains_some_type } :: import("../../types/utils.yo");
{ register_type_decl_module } :: import("../../types/guards.yo");
{ reject_second_class_escape } :: import("../utils.yo");
{ type_key } :: import("../../types/type_key.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ type_is_comptime_only_full } :: import("../trait_checking.yo");
{ _ctfe_args_equal } :: import("../calls/comptime_fn.yo");
{ RefCell } :: import("std/sync/refcell");
evaluate_struct_type :: (
  fn(
    expr : &AstExpr,
    env_in : &Environment,
    ctx : &EvalContext,
    is_atomic_rc : bool,
    force_reference_semantics : bool,
    exn : Exception
  ) -> AstExpr
)({
  (env : Environment) = env_in;
  is_struct_keyword := ast_expr_is_fn_call_of(expr, BK_STRUCT, Option(usize).None);
  is_newtype_keyword := ast_expr_is_fn_call_of(expr, BK_NEWTYPE, Option(usize).None);
  if(!(is_struct_keyword || is_newtype_keyword), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected "struct" or "newtype", got:\n${ast_expr_to_string(expr)}`
        )
      )
    );
  });
  is_reference_semantics := force_reference_semantics;
  is_newtype := is_newtype_keyword;
  // DECLARATION-STABLE id at module level (ctfe_depth == 0) — the enum.yo
  // twin (see there for the full rationale): re-evaluation generations of a
  // module-level struct declaration share one identity; CTFE instantiations
  // (generic constructors) keep eval-fresh ids so distinct instantiations
  // never share (the recorded tk2/MapEntry hazard of the unconditional swap).
  // Phase 2: the identity is the declaration's SOURCE POSITION, not the
  // parse-order `ast_expr_id` — an edit earlier in ANY file renumbers
  // ast ids and used to rename every downstream type. CTFE ids mint per
  // instantiation from the same position (occurrence-indexed), so an edit
  // in another module cannot renumber them either.
  decl_tok := ast_expr_token(expr);
  struct_id := if(
    ctx.ctfe_depth == usize(0),
    stable_position_id(String.from("struct_decl_"), &decl_tok.module_path.*, usize(decl_tok.row), usize(decl_tok.column)),
    stable_type_id(String.from("struct_"), &decl_tok.module_path.*, usize(decl_tok.row), usize(decl_tok.column))
  );
  if(debug_knob(`YO_DEBUG_TMINT`).is_some() && (ctx.ctfe_depth > usize(0)), {
    eprintln(`[tmint-mint] ${struct_id}`);
  });
  // Member visibility: record which module declares this type (guards.yo).
  register_type_decl_module(struct_id.clone(), decl_tok.module_path.*.clone());
  // Preliminary struct type (empty fields) used as SelfType during field evaluation.
  // This allows self-referential types like `struct(val: Option(Self))`.
  // The shell shares the final's `struct_id` (UNLIKE enum.yo's distinct
  // `__self_shell` id): id-based comparisons (compatibility `aid==eid`,
  // codegen C-keying, method dispatch) then treat the shell and final as the
  // same type for free, so only FIELD-reading sites need resolution. The shell
  // is distinguished from the final purely by its EMPTY field list, which is
  // exactly how `resolve_struct_shell`/`_patch_self_shell` detect it.
  prelim_ty := rc(
    TypeValueNode.Struct(
      struct_id.clone(),
      String.from(""),
      no_labels(),
      no_types(),
      is_reference_semantics,
      is_atomic_rc,
      is_newtype,
      String.from(""),
      // constructor_func_id — set later at the comptime-fn call site
      no_types(),
      // type_arguments — set later at the comptime-fn call site
      false // is_source_namespace
    )
  );
  // Temporarily set SelfType in context for field evaluation.
  old_self_type := ctx.self_type;
  ctx.self_type = Option(TypeValue).Some(prelim_ty);
  // RC functions (___drop/___dup) for reference-semantics structs are lowered
  // DIRECTLY in codegen (drop_dup.yo: `is_reference_struct_type` →
  // `__yo_decr_rc`/`__yo_incr_rc`). Evaluator-side ___drop/___dup method
  // synthesis does not apply: it would need to mutate
  // `SelfType.trait.fields`, and the TypeValue is a value enum with NO
  // per-type trait-field list (trait methods live in a side-registry, see
  // [[yo-self-typevalue-enum-interning]]); the direct codegen lowering has
  // the identical effect.
  // Trait MARKERS (Send/Acyclic/Comptime/Runtime) are auto-derived AFTER field
  // evaluation by `auto_derive_traits_for_struct_type` (below).
  // Evaluate fields
  args := match(expr, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  field_labels := ArrayList(String).new();
  field_types := ArrayList(TypeValue).new();
  runtime_field_types := ArrayList(TypeValue).new();
  // Per-field is-compile-time-only flags, parallel to field_types. Recorded
  // in the struct-field-comptime side-table so codegen's
  // get_runtime_struct_fields can filter comptime-only fields (Gap 1).
  field_comptime_flags := ArrayList(bool).new();
  fields := ArrayList(TypeField).new();
  (i : usize) = usize(0);
  while(i < args.len(), {
    arg := match(args.get(i), .Some(a) => a, .None => make_err_expr());
    result := evaluate_type_field(&arg, i, &env, ctx, "struct", exn);
    field := result.field;
    // Check for duplicate labels
    (dup_idx : usize) = usize(0);
    (has_dup : bool) = false;
    while((dup_idx < field_labels.len()) && !has_dup, {
      existing := match(field_labels.get(dup_idx), .Some(l) => l, .None => String.from(""));
      if(existing == field.label, {
        has_dup = true;
      });
      dup_idx = (dup_idx + usize(1));
    });
    if(has_dup, {
      arg_args := match(arg, .FnCall(_, _, a2, _, _) => a2, .Atom(_, _) => ArrayList(AstExpr).new());
      err_tok := if(
        ast_expr_is_fn_call(&arg),
        match(arg_args.get(usize(0)), .Some(fe) => ast_expr_token(&fe), .None => ast_expr_token(&arg)),
        ast_expr_token(&arg)
      );
      exn.throw(
        dyn(
          format_error_message(
            &err_tok,
            `Duplicate label "${field.label}" in struct`
          )
        )
      );
    });
    // RESERVED MEMBER. A reference struct's emitted C layout is
    // `{ __yo_ref_header_t header; <user fields...> }`, so a user field named
    // `header` produced TWO members with that name: "duplicate member
    // 'header'", and every `x.header` access silently resolved to the RC
    // header instead — cascading into incompatible-type errors at the
    // constructor, the traversal function and each use site. It type-checked
    // cleanly, so the only symptom was a wall of C errors naming generated
    // temps. `header` is the ONLY injected member (ref_count, gc_flags,
    // type_id, dispose_fn and friends live INSIDE the header struct, so they
    // do not collide), and value structs inject nothing — hence the
    // is_reference_semantics guard. Rejecting here means `yo check` catches it
    // with a source location. See
    // issues/fixed/ref-struct-field-named-header-collides-with-rc-header.md.
    // `!(field.is_comptime)`: a comptime field is ERASED from the C layout
    // (get_runtime_struct_fields drops it), so `ref(struct(header :: 1))`
    // cannot collide and must stay legal.
    if(is_reference_semantics && !field.is_comptime && (field.label == "header"), {
      res_args := match(arg, .FnCall(_, _, a3, _, _) => a3, .Atom(_, _) => ArrayList(AstExpr).new());
      res_tok := if(
        ast_expr_is_fn_call(&arg),
        match(res_args.get(usize(0)), .Some(fe2) => ast_expr_token(&fe2), .None => ast_expr_token(&arg)),
        ast_expr_token(&arg)
      );
      exn.throw(
        dyn(
          format_error_message(
            &res_tok,
            String.from("\"header\" is a reserved field name in a reference struct: the generated C layout already carries a `header` member (the reference-count header), so a field of that name would collide with it. Rename the field.")
          )
        )
      );
    });
    // A reference (or atomic) object outlives any one frame, so it cannot
    // hold a `ctl` handler: the handler unwinds into the frame that installed
    // it, which is gone by the time a later caller invokes it through the
    // object (issues/fixed/ctl-handler-stored-in-a-ref-struct-field-escapes-its-frame.md).
    // A value struct holding one is itself control-bound and cannot escape.
    if((force_reference_semantics || is_atomic_rc) && !field.is_comptime && type_is_control_bound(&field.ty), {
      exn.throw(dyn(format_error_message(ast_expr_token(&arg), control_bound_field_message(&field.label, &field.ty))));
    });
    // Decision 38 A, type positions: a second-class type (a closure holding
    // a capture-list borrow) may not be stored behind a pointer or in a
    // reference object, which outlive any one borrow: `ArrayList(type_of(f))`
    // instantiates `_ptr : *(T)` and is rejected here.
    if(!field.is_comptime, {
      sc_stored := match(
        type_pointee_second_class(&field.ty),
        .Some(sc_inner) => Option(TypeValue).Some(sc_inner),
        .None => if(force_reference_semantics || is_atomic_rc, Option(TypeValue).Some(field.ty), Option(TypeValue).None)
      );
      match(
        sc_stored,
        .Some(sc_t) => reject_second_class_escape(&sc_t, `the type of the heap-stored field \`${field.label}\` (a second-class type may not be a field type, an element type or a type argument)`, ast_expr_token(&arg), ctx, exn),
        .None => ()
      );
    });
    field_labels.push(field.label.clone());
    field_types.push(field.ty);
    field_comptime_flags.push(field.is_comptime);
    if(!field.is_comptime, {
      runtime_field_types.push(field.ty);
    });
    fields.push(field);
    env_adopt(&env, &result.env);
    i = (i + usize(1));
  });
  // Check newtype constraint: must have exactly one field
  if(is_newtype && !(fields.len() == usize(1)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Newtype struct must have exactly one field, but got ${fields.len()} fields.`
        )
      )
    );
  });
  // Build the final struct in two steps (same scheme as enum.yo): an UNPATCHED
  // pre-final used as the replacement target, then the real final with the
  // self-shell patched out of the field types one level. Deeper self-nesting
  // resolves through the struct-final registry (resolve_struct_shell) at use
  // sites.
  // Shared by the pre-final and the final type.
  field_labels_s := shared_list(field_labels);
  field_types_s := shared_list(field_types);
  pre_final_ty := rc(
    TypeValueNode.Struct(
      struct_id.clone(),
      String.from(""),
      field_labels_s.clone(),
      field_types_s.clone(),
      is_reference_semantics,
      is_atomic_rc,
      is_newtype,
      String.from(""),
      no_types(),
      false
    )
  );
  patched_types := ArrayList(TypeValue).new();
  (pt_i : usize) = usize(0);
  while(pt_i < field_types_s.len(), {
    ft := match(field_types_s.get(pt_i), .Some(t) => t, .None => rc(TypeValueNode.Unit));
    patched_types.push(_patch_self_shell(&ft, struct_id.clone(), &pre_final_ty));
    pt_i = (pt_i + usize(1));
  });
  // Definition-time value-cycle rejection, the enum twin's
  // (enum.yo, issues/fixed/plain-recursive-enum-segfaults-the-evaluator.md):
  // a plain `struct(...)`/`newtype(...)` whose fields reach ITSELF by value —
  // no reference indirection anywhere on the path — has infinite C size, and
  // before this check the cycle surfaced only as the C compiler's "field has
  // incomplete type" (issues/fixed/recursive-type-definitions-have-no-indirection-check.md).
  // `ref(struct(...))` and `atomic(ref(...))` are exempt (pointer-sized), and
  // the walker cuts paths through Rc/ArrayList/ref/pointer fields
  // (`_type_is_ref_indirection`). Run on the PATCHED types: the shell shares
  // the final's struct_id, so a `Self` field is already the root either way.
  if(!(is_reference_semantics || is_atomic_rc), {
    (vc_i : usize) = usize(0);
    while(vc_i < patched_types.len(), {
      vc_ft := match(patched_types.get(vc_i), .Some(t) => t, .None => rc(TypeValueNode.Unit));
      vc_label := match(field_labels_s.get(vc_i), .Some(l) => l, .None => String.from(""));
      if(_type_reaches_root_by_value(&vc_ft, struct_id.clone(), struct_id.clone(), ArrayList(String).new()), {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(expr),
              `recursive value struct: field '${vc_label}' contains the struct itself by value (a path with no reference indirection) — a plain 'struct(...)' would have infinite size. Make it 'ref(struct(...))', or route the recursion through a reference type (ArrayList, Rc, Option of a ref).`
            )
          )
        );
      });
      vc_i = (vc_i + usize(1));
    });
  });
  patched_types_s := shared_list(patched_types);
  // Build final struct TypeValue with all fields populated (shell-patched).
  // (Built before auto-derive so the completed TypeValue can be passed as self_type.)
  struct_ty := rc(
    TypeValueNode.Struct(
      struct_id.clone(),
      String.from(""),
      field_labels_s.clone(),
      patched_types_s.clone(),
      is_reference_semantics,
      is_atomic_rc,
      is_newtype,
      String.from(""),
      // constructor_func_id — set later at the comptime-fn call site
      no_types(),
      // type_arguments — set later at the comptime-fn call site
      false // is_source_namespace
    )
  );
  // Record the finalized form under the struct id so leaked empty-field shells
  // resolve at field-read use sites — see resolve_struct_shell (creators.yo).
  register_struct_final(struct_id.clone(), &struct_ty);
  // Record the per-field comptime-only flags so codegen's
  // get_runtime_struct_fields can filter comptime-only fields (Gap 1).
  register_struct_field_comptime_flags(struct_id.clone(), &field_comptime_flags);
  // Auto-derive trait markers (Send, Acyclic, Comptime, Runtime).
  auto_derive_traits_for_struct_type(
    struct_id.clone(),
    &runtime_field_types,
    is_reference_semantics,
    is_atomic_rc,
    &env,
    &struct_ty
  );
  // Enforce Send for atomic object types — must run AFTER
  // auto-derive so the Send-derivation cycle bracket is closed.
  if(is_atomic_rc, {
    enforce_atomic_object_send(
      &struct_ty,
      &field_labels_s.items,
      &patched_types_s.items,
      &env,
      ast_expr_token(expr),
      exn
    );
  });
  // Validate the struct can exist in at least ONE evaluation context —
  // mixed comptime-only + runtime-only fields (`x : comptime_int, y :
  // Rc(i32)`) have empty availability. Without this check the invalid
  // definition was ACCEPTED and comptime_expect_error's
  // no-error check hollowed the arm (basic arm 24). Structural field scan
  // (see fields_have_incompatible_contexts) — the registry-based check
  // false-fired on pointer-fielded prelude newtypes.
  if(fields_have_incompatible_contexts(&patched_types_s.items), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Type ${type_to_string(&struct_ty)} has incompatible field contexts and cannot be used in any evaluation context.`
        )
      )
    );
  });
  // Restore SelfType
  ctx.self_type = old_self_type;
  // Register TypeField metadata in global registry
  register_struct_fields(struct_id.clone(), &fields);
  struct_val := create_type_value(&struct_ty);
  meta_ty := type_of_type(&struct_ty);
  out_info := new_expr_info(&env, &meta_ty);
  out_info.value = Option(EvalValue).Some(struct_val);
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_info);
  // Annotate callee (expr.func) with the same info
  callee_expr := match(expr, .FnCall(_, f_box, _, _, _) => f_box, .Atom(_, _) => expr);
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&callee_expr), &out_info);
  expr
});
/// One instantiation of a cell primitive: its payload type and its struct id.
_CellInstance :: struct(is_atomic : bool, payload : TypeValue, id : String);
/// Every cell instantiation so far, in creation order. Global for the reason
/// the CTFE memo is (`g_comptime_fn_caches`, calls/comptime_fn.yo): a module
/// loaded on demand evaluates in a fresh context, and it must still name the
/// same cell type.
(g_cell_instances : RefCell(ArrayList(_CellInstance))) = RefCell(ArrayList(_CellInstance)).new(ArrayList(_CellInstance).new());
/// The struct id of the cell `__yo_cell(v)` (`is_atomic` false) or
/// `__yo_atomic_cell(v)`. A payload that the CTFE memo would take for an
/// earlier instantiation's payload (`_ctfe_args_equal`) reuses that
/// instantiation's id, so the cells of one type share one id as the
/// instances of one generic constructor do. Otherwise the id is minted from
/// the builtin's name and `type_key(v)`.
///
/// The memo's equality matters for a recursive declaration. Inside
/// `Node :: struct(next : Option(__yo_cell(Self)))` the payload is the
/// declaration's self-shell, whose `type_key` is the bare declaration id,
/// while `__yo_cell(Node)` written after it keys `Node` by its fields. Minted
/// from the two keys, the two cells had two ids; `type_key`'s cycle guard,
/// which is keyed by the id, then cut the two at different depths and gave
/// them two C types, so storing one into the field failed in the C compiler
/// (`incompatible pointer types`). The memo treats a shell and its final as
/// one type, so both spellings get one id and one C type, as `Rc(Self)` and
/// `Rc(Node)` do.
_cell_instance_id :: (fn(is_atomic : bool, v : &TypeValue) -> String)({
  given := EvalValue.TypeVal(v.clone());
  n := g_cell_instances.with(xs => xs.len());
  (i : usize) = usize(0);
  while(i < n, {
    match(
      g_cell_instances.with(xs => xs.get(i)),
      .Some(inst) => if((inst.is_atomic == is_atomic) && _ctfe_args_equal(&EvalValue.TypeVal(inst.payload.clone()), &given), {
        return(inst.id);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  id := String.from(if(is_atomic, BK_YO_ATOMIC_CELL, BK_YO_CELL));
  id.push_str("#");
  id.push_string(type_key(v));
  g_cell_instances.with_mut(xs => xs.push(_CellInstance(is_atomic : is_atomic, payload : v.clone(), id : id.clone())));
  id
});
/// `__yo_cell(V)` / `__yo_atomic_cell(V)`: the private heap-cell primitive
/// (plans/VALUES_BY_DEFAULT.md §3.5, decided 2026-10-23).
///
/// The type is `ref(struct((*) : V))` (`is_atomic` false: plain `++`/`--`) or
/// `atomic(ref(struct((*) : V)))`: one allocation, the RC header, then `V`
/// inline, so every RC lowering, `c.*`, `ref_count`, the cycle collector's
/// tracking and D3 treat it as they treat `Rc(V)`/`Arc(V)` today. What is
/// new is its identity and its constructor:
/// - **One type per `V`.** The builtin stamps its own name as the
///   `constructor_func_id` and `[V]` as the type arguments, so `type_key`
///   keys it by `V` (one C type wherever it is spelled, and after a generic
///   `V` is substituted). The struct id is one per `V` too
///   (`_cell_instance_id`), so the per-id registries (fields, derived
///   markers) hold one entry per `V`.
/// - **The constructor takes the allocator**: `__yo_cell(V)(v, alloc)`, with
///   `alloc : Option(Allocator)` (the call arm in evaluator/calls/function.yo,
///   `is_cell_primitive_type`).
///
/// Usable only in a `pragma(Pragma.AllowUnsafe)` file (decision 6): safe
/// code gets a reference type only by writing `Rc`/`Arc`.
evaluate_cell_type :: (
  fn(
    expr : &AstExpr,
    env_in : &Environment,
    ctx : &EvalContext,
    is_atomic_rc : bool,
    exn : Exception
  ) -> AstExpr
)({
  (env : Environment) = env_in;
  builtin := if(is_atomic_rc, BK_YO_ATOMIC_CELL, BK_YO_CELL);
  tok := ast_expr_token(expr);
  if(!is_implicitly_unsafe_capable_file(Option(String).Some(tok.module_path.*.clone())), {
    exn.throw(
      dyn(
        format_error_message_with_help(
          &tok,
          `\`${builtin}(...)\` is not available in safe code: it is the private heap-cell primitive behind \`Rc\` and \`Arc\` (plans/VALUES_BY_DEFAULT.md §3.5).`,
          Option(String).Some(String.from("share a value with `rc(v)` (`Rc(T)`) or `arc(v)` (`Arc(T)`); a file that implements a cell wrapper declares `pragma(Pragma.AllowUnsafe);`"))
        )
      )
    );
    return(make_err_expr());
  });
  args := match(expr, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  if(args.len() != usize(1), {
    exn.throw(
      dyn(
        format_error_message(
          &tok,
          `\`${builtin}\` takes exactly one argument, the payload type: \`${builtin}(V)\`, got ${args.len().to_string()}.`
        )
      )
    );
    return(make_err_expr());
  });
  payload_expr := match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
  payload_eval := evaluate_expression_raw(&payload_expr, &env, ctx, exn);
  payload_ty := match(
    expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&payload_eval)),
    .Some(pi) => {
      env = expr_info_adopt_env(&pi);
      match(
        pi.value,
        .Some(.TypeVal(pt)) => Option(TypeValue).Some(pt),
        _ => Option(TypeValue).None
      )
    },
    .None => Option(TypeValue).None
  );
  v := match(
    payload_ty,
    .Some(pt) => pt,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(&payload_expr),
            `\`${builtin}(V)\` expects a type, got:\n${ast_expr_to_string(&payload_expr)}`
          )
        )
      );
      return(make_err_expr());
    }
  );
  // The payload rules of a `ref` object's field (evaluate_struct_type): the
  // cell outlives any one frame, so it holds neither a `ctl` handler nor a
  // second-class value, and a comptime-only payload has no C layout.
  payload_label := String.from("*");
  if(type_is_control_bound(&v), {
    exn.throw(dyn(format_error_message(ast_expr_token(&payload_expr), control_bound_field_message(&payload_label, &v))));
  });
  reject_second_class_escape(&v, String.from("the payload type of a cell (a second-class type may not be a field type, an element type or a type argument)"), ast_expr_token(&payload_expr), ctx, exn);
  // The cell is a run-time object, so its payload must have a run-time
  // representation. A generic payload is decided at its instantiation.
  if(!type_contains_some_type(&v) && type_is_comptime_only_full(&v, &env), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(&payload_expr),
          `\`${builtin}(${type_to_string(&v)})\`: a cell's payload is a run-time value, and ${type_to_string(&v)} exists only at compile time.`
        )
      )
    );
    return(make_err_expr());
  });
  payload_types := ArrayList(TypeValue).new();
  payload_types.push(v);
  cell_id := _cell_instance_id(is_atomic_rc, &v);
  cell_name := String.from(builtin);
  cell_name.push_str("(");
  cell_name.push_string(type_to_string(&v));
  cell_name.push_str(")");
  labels := ArrayList(String).new();
  labels.push(payload_label.clone());
  field_types_s := shared_list(payload_types);
  type_args := ArrayList(TypeValue).new();
  type_args.push(v);
  cell_ty := rc(
    TypeValueNode.Struct(
      cell_id.clone(),
      cell_name,
      shared_list(labels),
      field_types_s.clone(),
      true,
      is_atomic_rc,
      false,
      String.from(builtin),
      shared_list(type_args),
      false
    )
  );
  register_struct_final(cell_id.clone(), &cell_ty);
  flags := ArrayList(bool).new();
  flags.push(false);
  register_struct_field_comptime_flags(cell_id.clone(), &flags);
  auto_derive_traits_for_struct_type(cell_id.clone(), &field_types_s.items, true, is_atomic_rc, &env, &cell_ty);
  fields := ArrayList(TypeField).new();
  fields.push(
    TypeField(
      label : payload_label,
      ty : v,
      is_comptime : false,
      default_value : Option(EvalValue).None,
      assigned_value : Option(EvalValue).None,
      doc_comment : Option(String).None,
      is_effect_param : false
    )
  );
  register_struct_fields(cell_id.clone(), &fields);
  out_info := new_expr_info(&env, &type_of_type(&cell_ty));
  out_info.value = Option(EvalValue).Some(create_type_value(&cell_ty));
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_info);
  callee_expr := match(expr, .FnCall(_, f_box, _, _, _) => f_box, .Atom(_, _) => expr);
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(&callee_expr), &out_info);
  expr
});
export(evaluate_struct_type, evaluate_cell_type);
