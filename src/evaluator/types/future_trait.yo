//! evaluate_future_type — evaluates `Future(T)` or `Future(T, E)` syntax.
//!
//! Creates a FutureTraitT type with output type and at most one effect bundle.
//! Supports:
//!   Future(T)        — basic future
//!   Future(T, E)     — future with a single effect bundle struct E
//!   Future(T, p)     — a future borrowing the places of origin `p`
//!   Future(T, E, p)  — both (decision 43 step 4, N3-1; the origin is
//!                      recognized by kind: a place or an origin, not a type)
//!
//! Multiple effects must be packed into a single struct (e.g.
//!   Ctx :: struct(io : Io, raise : Raise); Future(T, Ctx)).
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  make_err_expr,
  BK_FUTURE,
  BK_TUPLE
}
:: import("../../expr.yo");
{ new_expr_info, expr_info_table_get, expr_info_table_set, expr_info_adopt_env } :: import("../../expr_info.yo");
{ Environment, get_variables_from_env, variable_value_type } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ create_type_value, is_type_value } :: import("../../value.yo");
{ TypeValue, TypeValueNode } :: import("../../types/definitions.yo");
{ t_future_trait_with_origin } :: import("../../types/creators.yo");
{ is_type_hierarchy_type } :: import("../../types/guards.yo");
{ t_origin_elided } :: import("../../types/definitions.yo");
{ evaluate_origin_argument } :: import("./function.yo");
{ note_move_only_possible } :: import("../../types/utils.yo");
{ type_of_type } :: import("../../types/hierarchy.yo");
{ format_error_message, format_eval_failure } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ ArrayList } :: import("std/collections/array_list");
// ---------------------------------------------------------------------------
// Local helpers
// ---------------------------------------------------------------------------
_future_args :: (fn(e : &AstExpr) -> ArrayList(AstExpr))(
  match(
    e,
    .FnCall(_, _, Rc(args), _, _) => args.clone(),
    .Atom(_, _) => ArrayList(AstExpr).new()
  )
);
/// Derive a label name for an individual effect type.
_effect_label_for :: (fn(effect_type : &TypeValue, effect_expr : &AstExpr) -> String)(
  match(
    effect_type,
    Rc(.Struct({ name, is_source_namespace : fl_sns })) => cond(fl_sns.* => name.clone(), true => ast_expr_to_string(effect_expr)),
    Rc(.SomeT(_, name, _, _, _, _, _)) => name.clone(),
    _ => ast_expr_to_string(effect_expr)
  )
);
/// Resolve the effect argument of `Future(T, E)`: one effect type (a bundle
/// struct or a `generic(E : Type.Struct)` variable). A `...(E)` spread is a
/// check error. Pushes the result into out_labels/out_types and returns the
/// updated env.
_resolve_effect_arg :: (
  fn(
    effect_expr : &AstExpr,
    env : &Environment,
    ctx : &mut EvalContext,
    out_labels : &mut ArrayList(String),
    out_types : &mut ArrayList(TypeValue),
    exn : Exception
  ) -> Environment
)({
  // A `...(E)` spread: one `...` call with one atom argument.
  is_spread := (
    ast_expr_is_fn_call(effect_expr) &&
      ast_expr_is_fn_call_of(effect_expr, "...", .Some(usize(1))) &&
        match(_future_args(effect_expr).get(usize(0)), .Some(a) => ast_expr_is_atom(&a), .None => false)
  );
  cond(
    // `Future` takes exactly two arguments, the result type and ONE effect
    // type (a bundle struct, or a `generic(E : Type.Struct)` row variable).
    // A spread could expand into several effects, which the async lowering
    // cannot inject (it reads one bundle), so it is rejected here
    // (plans/archive/ASYNC_IO_API_AUDIT.md F8, decided 2026-10-03).
    is_spread => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(effect_expr),
            `Future takes one effect argument, not a spread: write Future(T, E) for the bundle E, not Future(T, ${ast_expr_to_string(effect_expr)}).`
          )
        )
      );
      Rc.clone(env)
    },
    true => {
      // Individual effect type — evaluate it
      evaluated_expr := evaluate_expression_raw(effect_expr, env, ctx, exn);
      info_opt := expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&evaluated_expr));
      match(
        info_opt,
        .Some(info) => {
          if(!is_type_value(&info.value()), {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(effect_expr),
                  `Future effect argument must be an effect type (a bundle struct or a generic(E : Type.Struct) variable), but got:\n${ast_expr_to_string(effect_expr)}`
                )
              )
            );
          });
          effect_type := match(
            info.value(),
            .Some(v) => match(v, .TypeVal(b) => Rc.clone(b), _ => Rc.new(TypeValueNode.Unit)),
            .None => Rc.new(TypeValueNode.Unit)
          );
          label := _effect_label_for(&effect_type, effect_expr);
          out_labels.push(label);
          out_types.push(effect_type);
          expr_info_adopt_env(&info)
        },
        .None => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(effect_expr),
                `Future effect argument must be an effect type (a bundle struct or a generic(E : Type.Struct) variable), but got:\n${ast_expr_to_string(effect_expr)}`
              )
            )
          );
          Rc.clone(env)
        }
      )
    }
  )
});
// ---------------------------------------------------------------------------
// evaluate_future_type
/// An argument after `T` names an origin, not an effect, when it is not a
/// type (decision 43 step 4, N3-1): `origin(...)`, a tuple of places
/// `(x, y)`, or a name bound to a value or an origin parameter. An effect is
/// a type (a bundle struct, `Io`, a `generic(E : Type.Struct)` variable).
/// `static`, the empty origin, is reserved in origin position (decision 49),
/// so `Future(T, E, static)` reaches the origin reader and its wall
/// (VERDICTS-57 §1).
_is_origin_operand :: (fn(e : &AstExpr, env : &Environment) -> bool)(
  cond(
    ast_expr_is_fn_call_of(e, "origin", .None) => true,
    ast_expr_is_fn_call_of(e, BK_TUPLE, .None) => true,
    (ast_expr_is_atom(e) && (ast_expr_token(e).value.* == "static")) => true,
    ast_expr_is_atom(e) => match(
      get_variables_from_env(env, &ast_expr_token(e).value.*).last_cloned(),
      .Some(v) => !is_type_hierarchy_type(&variable_value_type(&v)),
      .None => false
    ),
    true => false
  )
);
// ---------------------------------------------------------------------------
/// Evaluates the `Future(T, ...)` syntax.
/// Creates a FutureTraitT type with the output type and at most one effect.
///
evaluate_future_type :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &mut EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  mut(expr_args) := _future_args(expr);
  // A trailing origin (`Future(T, p)`, `Future(T, E, p)`) is split off first.
  (origin_type : TypeValue) = t_origin_elided();
  last_arg := match(expr_args.last(), .Some(a) => a, .None => make_err_expr());
  if((expr_args.len() >= usize(2)) && (expr_args.len() <= usize(3)) && _is_origin_operand(&last_arg, env), {
    o_ev := evaluate_origin_argument(&last_arg, env, ctx, exn);
    origin_type = match(
      expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&o_ev)),
      .Some(oi) => match(oi.value(), .Some(.TypeVal(ot)) => Rc.clone(ot), _ => t_origin_elided()),
      .None => t_origin_elided()
    );
    _dropped := expr_args.pop();
  });
  if(expr_args.len() == usize(3), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("The third argument of `Future(T, E, p)` is an origin: a place, a tuple of places or `origin(...)`, not a type.\nTo combine multiple effects, declare a struct that bundles them and pass that struct as E.")
        )
      )
    );
  });
  if((expr_args.len() < usize(1)) || (expr_args.len() > usize(2)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Future type constructor expects 1 to 3 arguments (output type, optional effect bundle struct, optional origin).\nUsage: Future(T), Future(T, E), Future(T, p) or Future(T, E, p).\nTo combine multiple effects, declare a struct that bundles them and pass that struct as E.")
        )
      )
    );
  });
  // Evaluate output type (first arg)
  element_type_expr := match(expr_args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
  evaluated_elem_expr := evaluate_expression_raw(&element_type_expr, env, ctx, exn);
  elem_info_opt := expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&evaluated_elem_expr));
  elem_info := match(
    elem_info_opt,
    .Some(i) => Rc.clone(i),
    .None => {
      exn.throw(
        dyn(
          format_eval_failure(
            ast_expr_token(&element_type_expr),
            `Failed to evaluate the element type expression for Future:\n${ast_expr_to_string(&element_type_expr)}`
          )
        )
      );
      new_expr_info(env, Rc.new(TypeValueNode.Unit))
    }
  );
  (env_mut : Environment) = expr_info_adopt_env(&elem_info);
  if(!is_type_value(&elem_info.value()), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(&element_type_expr),
          `Future type constructor expects a type as its first argument, but got:\n${ast_expr_to_string(&element_type_expr)}`
        )
      )
    );
  });
  output_type := match(
    elem_info.value(),
    .Some(v) => match(v, .TypeVal(b) => Rc.clone(b), _ => Rc.new(TypeValueNode.Unit)),
    .None => Rc.new(TypeValueNode.Unit)
  );
  // Process effect arguments (args 1..N)
  effect_labels := ArrayList(String).new();
  effect_types := ArrayList(TypeValue).new();
  (ei : usize) = usize(1);
  while(ei < expr_args.len(), {
    effect_expr := match(
      expr_args.get(ei),
      .Some(a) => a,
      .None => {
        ei = expr_args.len();
        break;
      }
    );
    env_mut = _resolve_effect_arg(&effect_expr, &env_mut, ctx, &mut effect_labels, &mut effect_types, exn);
    ei = (ei + usize(1));
  });
  // Build the FutureTraitT
  future_type := t_future_trait_with_origin(String.from(BK_FUTURE), &output_type, effect_labels, effect_types, &origin_type);
  // A future is move-only (decision 13): arm the move-only checks.
  note_move_only_possible();
  // Set expr info
  out_info := new_expr_info(&env_mut, type_of_type(&future_type));
  out_info.set_value(.Some(create_type_value(&future_type)));
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_info);
  expr.*
});
export(evaluate_future_type);
