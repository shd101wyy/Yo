import("std/string");
{ AstExpr, ast_expr_token, make_err_expr } :: import("../../expr.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ Exception } :: import("std/error");
{ evaluate_function_type } :: import("./function.yo");
evaluate_closure_type :: (
  fn(
    imm(expr) : AstExpr,
    imm(env) : Environment,
    imm(ctx) : EvalContext,
    imm(exn) : Exception
  ) -> AstExpr
)(
  evaluate_function_type(expr, env, ctx, exn)
);
export(evaluate_closure_type);
