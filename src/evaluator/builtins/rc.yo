//! evaluator/builtins/rc — implements evaluate_ref_count, the `ref_count` builtin.
//!
//! `ref_count(value)` returns the reference counter of a value.
//! For RC types: returns an unknown runtime `usize`.
//! For value types: always returns `1` as a compile-time `usize`.
{ String } :: import("std/string");
{ AstExpr, ast_expr_token, ast_expr_id, ast_expr_to_string } :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  expr_info_adopt_env
} :: import("../../expr_info.yo");
{ Environment, snapshot_env } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, create_unknown_val } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_usize } :: import("../../types/creators.yo");
{ is_rc_type, is_unique_box_type, cell_handle_view } :: import("../../types/guards.yo");
{ type_to_string } :: import("../../types/string.yo");
{ format_error_message, format_error_message_with_help } :: import("../../error.yo");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ attach_temp_variable_to_expr } :: import("../utils.yo");
{ Exception } :: import("std/error");
evaluate_ref_count :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg_ast := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_arg := evaluate_expression_raw(&arg_ast, env, ctx, exn);
  arg_info := match(
    expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&eval_arg)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(&arg_ast),
            String.from("ref_count: failed to evaluate argument")
          )
        )
      );
      new_expr_info(env, t_usize())
    }
  );
  // The unique `Box` has no count (plans/VALUES_BY_DEFAULT.md §3.2: only
  // `Rc` and `Arc` are counted).
  if(is_unique_box_type(&arg_info.ty), {
    exn.throw(
      dyn(
        format_error_message_with_help(
          ast_expr_token(&arg_ast),
          `ref_count: \`${ast_expr_to_string(&arg_ast)}\` is a ${type_to_string(&arg_info.ty)}, a uniquely owned cell with no count.`,
          Option(String).Some(String.from("only `Rc` and `Arc` are counted; a `Box` always has exactly one owner"))
        )
      )
    );
    return(expr);
  });
  cur_env := expr_info_adopt_env(&arg_info);
  out_info := new_expr_info(&cur_env, t_usize());
  // A cell handle (`cell_handle_view`, V5's `Rc`/`Arc`) is counted by its
  // cell: `is_rc_type` stays false for it, its copies being field-wise.
  if(is_rc_type(&arg_info.ty) || cell_handle_view(&arg_info.ty).is_some(), {
    // RC type: count is only known at runtime → unknown value
    out_info.value = Option(EvalValue).None;
    attach_temp_variable_to_expr(expr, true, ctx);
  }, {
    // Value type: reference count is always 1
    out_info.value = Option(EvalValue).Some(EvalValue.IntLit(String.from("1")));
  });
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_info);
  expr
});
export(evaluate_ref_count);
