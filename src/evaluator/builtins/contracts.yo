//! evaluator/builtins/contracts — contract-clause builtin handlers.
//!
//! Partial 1:1 port of `src/evaluator/builtins/contracts.ts` (Phase 0 of
//! plans/backlog/FORMAL_VERIFICATION.md). Ported here: the expression-position
//! handlers for `requires` / `ensures` / `invariant` / `ghost` (no-op markers
//! that evaluate their args and return `unit`) and `ghost_fn` / `old`
//! (transparent pass-throughs).
//!
//! Also ported: `wrap_function_body_with_contracts` — the signature→assert
//! lowering that turns `requires(...)` / `ensures(...)` in a function SIGNATURE
//! into runtime `assert(...)` / `comptime_assert(...)` calls wrapping the body
//! (wired from calls/function_type.yo). The runtime assert callee is the
//! self-contained `import("std/assert").assert` — see `_build_assert_callee`.
{ String } :: import("std/string");
{ StringBuilder } :: import("std/fmt");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom,
  BF_REQUIRES,
  BF_ENSURES,
  BF_INVARIANT,
  BF_DECREASES,
  BF_ASSUMED,
  BF_GHOST,
  BF_GHOST_FN,
  BF_OLD,
  BK_BEGIN,
  BK_TUPLE,
  BF_COMPTIME_ASSERT,
  alloc_global_expr_id,
  clone_expr_fresh_ids,
  make_err_expr
} :: import("../../expr.yo");
{ ExprInfo, ExprInfoTable, new_expr_info, expr_info_table_get, expr_info_table_set }
:: import("../../expr_info.yo");
{ Environment, add_variable_to_env } :: import("../../env.yo");
{ EvalContext, note_unlabeled_ensures_atom } :: import("../context.yo");
{ EvalValue, create_unknown_val } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, t_bool, t_i64, t_u8 } :: import("../../types/creators.yo");
{ Token, TokenKind } :: import("../../token.yo");
{ file_has_pragma } :: import("../memory_safety.yo");
{ ArrayList } :: import("std/collections/array_list");
// V6 task 1: the trait-method contract tables (inheritance + variance).
// The func-contract side tables are reached through HOOKS in the same
// registry — types/function.yo is not importable here (it pulls
// trait_checking.yo → impl.yo, which imports this module).
{
  trait_method_requires,
  trait_method_ensures,
  trait_method_return_label,
  hook_func_requires,
  hook_func_ensures,
  hook_func_return_label,
  hook_register_func_contracts
} :: import("../values/type_trait_methods.yo");
{ HashMap } :: import("std/collections/hash_map");
{ HashSet } :: import("std/collections/hash_set");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ assert, panic } :: import("std/assert");
/// Evaluate any of the no-op contract markers (`requires` / `ensures` /
/// `invariant` / `ghost` in expression position). Each argument is evaluated
/// (so expression-level errors surface), but the call itself returns `unit`.
/// Mirrors `evaluateContractMarker` in `src/evaluator/builtins/contracts.ts`.
_evaluate_contract_marker :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  (cur_env : Environment) = env;
  (i : usize) = usize(0);
  while(i < args.len(), {
    arg := match(args.get(i), .Some(a) => a, .None => make_err_expr());
    // Bracket the predicate evaluation with the contract-predicate flag:
    // parameters and the return label are not bound in this env (they get
    // their real bindings in the splice lowering and the verifier's
    // registration env), so unbound identifiers soft-fall-back to unknowns
    // instead of the hard `Variable not found` error (Phase V3). The same
    // bracket sets ghost context (V5): contract clauses are where the
    // ghost-only builtins (forall/exists/==>) are legal.
    prev_pred_flag := ctx.is_evaluating_contract_predicate;
    prev_ghost_flag := ctx.is_ghost_context;
    ctx.is_evaluating_contract_predicate = true;
    ctx.is_ghost_context = true;
    evaluated := evaluate_expression_raw(arg, cur_env, ctx, exn);
    ctx.is_evaluating_contract_predicate = prev_pred_flag;
    ctx.is_ghost_context = prev_ghost_flag;
    match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated)),
      .Some(info) => {
        cur_env = info.env;
      },
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg),
              String.from("Failed to evaluate argument of contract clause.")
            )
          )
        );
      }
    );
    i = (i + usize(1));
  });
  out_info := new_expr_info(cur_env, t_unit());
  out_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
/// The file set the current command is verifying (absolute or as-given
/// paths — matched by equality against `Token.module_path`). Empty = no
/// verification is recording (plain `yo check`/`compile`), so registry
/// effects are inert. Declared EARLY: the contract-marker handlers
/// (evaluate_ghost and friends) read `_is_verify_target`, and importers
/// can force those lazily before line 900 evaluates.
(g_verify_target_paths : ArrayList(String)) = ArrayList(String).new();
set_verify_target_paths :: (fn(paths : ArrayList(String)) -> unit)({
  g_verify_target_paths = paths;
  ()
});
_is_verify_target :: (fn(module_path : String) -> bool)({
  (found : bool) = false;
  (i : usize) = usize(0);
  while((i < g_verify_target_paths.len()) && !found, {
    match(
      g_verify_target_paths.get(i),
      .Some(p) => if(p == module_path, {
        found = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// `requires(...)` in expression position — no-op marker. Mirrors
/// `evaluateRequires`.
/// Reject a zero-argument contract marker in expression position.
/// Mirrors the `args.length === 0` guards in
/// `src/evaluator/builtins/contracts.ts:96-137`.
_reject_zero_arg_marker :: (fn(expr : AstExpr, message : String, exn : Exception) -> unit)({
  n := match(
    expr,
    .FnCall(_, _, a, _, _) => a.len(),
    .Atom(_, _) => usize(0)
  );
  if(n == usize(0), {
    exn.throw(dyn(format_error_message(ast_expr_token(expr), message)));
  });
});
evaluate_requires :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  _reject_zero_arg_marker(
    expr,
    String.from("'requires(...)' with zero arguments is a syntax error. Omit the clause entirely if there is no precondition."),
    exn
  );
  _evaluate_contract_marker(expr, env, ctx, exn)
});
/// `ensures(...)` in expression position — no-op marker. Mirrors
/// `evaluateEnsures`.
evaluate_ensures :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  _reject_zero_arg_marker(
    expr,
    String.from("'ensures(...)' with zero arguments is a syntax error. Omit the clause entirely if there is no postcondition."),
    exn
  );
  _evaluate_contract_marker(expr, env, ctx, exn)
});
/// `invariant(...)` — no-op marker (loop placement checked in `while`; SMT
/// discharge is a later phase). Mirrors `evaluateInvariant`.
evaluate_invariant :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  _reject_zero_arg_marker(
    expr,
    String.from("'invariant(...)' with zero arguments is a syntax error."),
    exn
  );
  _evaluate_contract_marker(expr, env, ctx, exn)
});
/// `decreases(M)` — no-op marker in expression position: the loop-body
/// statement form (right after `invariant(...)`) is consumed by the V4
/// verifier's loop encoding; the SIGNATURE clause is extracted by the
/// function-type evaluator.
evaluate_decreases :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  _reject_zero_arg_marker(
    expr,
    String.from("'decreases(...)' with zero arguments is a syntax error."),
    exn
  );
  _evaluate_contract_marker(expr, env, ctx, exn)
});
/// V6 task 5 (FORMAL_VERIFICATION.md): `assumed()` in EXPRESSION position —
/// no-op marker, the INVERSE of the others: the zero-argument form is the
/// only legal one (the signature extraction rejects it anywhere else); any
/// argument is a syntax error naming the contract clauses it expected.
evaluate_assumed :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  n := match(
    expr,
    .FnCall(_, _, a, _, _) => a.len(),
    .Atom(_, _) => usize(0)
  );
  if(n != usize(0), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("'assumed()' takes no arguments: it marks the BODY as outside the verifiable subset, and the contracts themselves come from requires(...)/ensures(...)/decreases(...).")
        )
      )
    );
  });
  _evaluate_contract_marker(expr, env, ctx, exn)
});
/// V5 task 5: the std/spec ghost-collection builtins (ghost-only).
BF_SEQ_UNIT :: "seq_unit";
BF_SEQ_APPEND :: "seq_append";
BF_SEQ_LEN :: "seq_len";
BF_SEQ_NTH :: "seq_nth";
BF_STR_BYTES :: "str_bytes";
BF_MS_SINGLE :: "ms_single";
BF_MS_ADD :: "ms_add";
BF_MS_COUNT :: "ms_count";
BF_MS_OF :: "ms_of";
BF_SET_SINGLE :: "set_single";
BF_SET_ADD :: "set_add";
BF_SET_CONTAINS :: "set_contains";
/// V5 task 3: the ghost-BINDING name set. `ghost(name := e)` registers the
/// bound name here; identifier resolution (identifer_and_operator.yo)
/// rejects reads of these names from non-ghost context — the "ghost value
/// escapes specification context" error.
(g_ghost_binding_names : HashSet(String)) = HashSet(String).new();
register_ghost_binding :: (fn(name : String) -> unit)({
  g_ghost_binding_names.insert(name);
  ()
});
is_ghost_binding_name :: (fn(name : String) -> bool)(
  g_ghost_binding_names.contains(name)
);
/// `ghost(...)` — V5 task 3 slice 2: `ghost(name := e)` BINDS the name
/// for spec use ONLY (contract clauses, ghost code, ghost_fn bodies, and —
/// in VERIFICATION targets — assert predicates) in EVERY mode: the binding
/// never reaches codegen, and ordinary code reading it gets the escape
/// error (identifer_and_operator.yo's ghost-name check). Without this, a
/// runtime-mode assert reading a ghost binding emitted an UNDECLARED C
/// identifier — the evaluator resolved the name (Phase 0's marker bound it)
/// while codegen erased the binding. Other `ghost(...)` shapes keep the
/// transparent no-op marker. Mirrors `evaluateGhost`.
evaluate_ghost :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  args0 := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  {
    match(
      args0.get(usize(0)),
      .Some(first) => {
        if(ast_expr_is_fn_call_of(first, ":=", Option(usize).Some(usize(2))), {
          ba := match(
            first,
            .FnCall(_, _, a2, _, _) => a2,
            .Atom(_, _) => ArrayList(AstExpr).new()
          );
          nm := match(
            ba.get(usize(0)),
            .Some(n0) => ast_expr_token(n0).value,
            .None => String.new()
          );
          rhs := match(
            ba.get(usize(1)),
            .Some(r0) => r0,
            .None => make_err_expr()
          );
          // The RHS is ghost code (quantifiers are legal in it).
          prev_ghost := ctx.is_ghost_context;
          ctx.is_ghost_context = true;
          evaluated := evaluate_expression_raw(rhs, env, ctx, exn);
          ctx.is_ghost_context = prev_ghost;
          r_info := match(
            expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated)),
            .Some(ri) => ri,
            .None => new_expr_info(env, t_unit())
          );
          _ := add_variable_to_env(
            env,
            nm.clone(),
            r_info.ty,
            r_info.value,
            false,
            false,
            false,
            false,
            ast_expr_token(first)
          );
          register_ghost_binding(nm.clone());
          out_info := new_expr_info(r_info.env, t_unit());
          out_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
          return(expr);
        });
      },
      .None => ()
    );
  };
  _evaluate_contract_marker(expr, env, ctx, exn)
});
/// Shared transparent pass-through for `ghost_fn(inner)` / `old(inner)`:
/// evaluate the single inner argument and propagate its ExprInfo to the outer
/// call. Mirrors the bodies of `evaluateGhostFn` / `evaluateOld`.
_evaluate_transparent_unary :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  arg := match(
    expr,
    .FnCall(_, _, a, _, _) => match(a.get(usize(0)), .Some(x) => x, .None => make_err_expr()),
    .Atom(_, _) => make_err_expr()
  );
  evaluated := evaluate_expression_raw(arg, env, ctx, exn);
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated)),
    .Some(info) => {
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
    },
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg),
            String.from("Failed to evaluate argument of contract clause.")
          )
        )
      );
    }
  );
  expr
});
/// V5 task 3: the ghost-fn registry. `ghost_fn(...)` registers the wrapped
/// function's func_id here; function.yo's call arm rejects calls to these
/// from non-ghost context (a ghost_fn has no runtime semantics).
(g_ghost_fn_ids : HashSet(String)) = HashSet(String).new();
register_ghost_fn :: (fn(func_id : String) -> unit)({
  g_ghost_fn_ids.insert(func_id);
  ()
});
is_ghost_fn :: (fn(func_id : String) -> bool)(
  g_ghost_fn_ids.contains(func_id)
);
/// `ghost_fn(f)` — marks a function value ghost-only. V5 task 3: the
/// wrapped function is REGISTERED as ghost (calls from non-ghost context
/// are a compile error — function.yo's FuncVal arm checks the registry);
/// the marker itself stays a transparent pass-through. Mirrors
/// `evaluateGhostFn`.
evaluate_ghost_fn :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  if(!ast_expr_is_fn_call_of(expr, BF_GHOST_FN, .Some(usize(1))), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `'ghost_fn(...)' takes exactly one argument, got:\n${ast_expr_to_string(expr)}`
        )
      )
    );
  });
  // A ghost_fn's body IS ghost context (V5): quantifier builtins are
  // well-formed there.
  prev_ghost := ctx.is_ghost_context;
  ctx.is_ghost_context = true;
  out := _evaluate_transparent_unary(expr, env, ctx, exn);
  ctx.is_ghost_context = prev_ghost;
  // Register the wrapped function as ghost: its func_id goes into the
  // ghost-fn registry so every later CALL from non-ghost context errors.
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  match(
    args.get(usize(0)),
    .Some(inner) => {
      match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(inner)),
        .Some(ii) => {
          match(
            ii.value,
            .Some(gv) => {
              match(
                gv,
                .FuncVal(gfvd, _) => {
                  register_ghost_fn(gfvd.*.func_id.clone());
                },
                _ => ()
              );
            },
            .None => ()
          );
        },
        .None => ()
      );
    },
    .None => ()
  );
  out
});
/// The std/spec ghost-collection builtins (V5 task 5): seq_unit /
/// seq_append / seq_len / seq_nth / str_bytes, ms_single / ms_add /
/// ms_count, set_single / set_add / set_contains. Ghost-only (same gate as
/// the quantifiers); evaluates to an UNKNOWN of a plausible element type —
/// these only appear inside one predicate expression, and the VERIFIER's
/// walk gives them their real SMT semantics (Seq / Array sorts).
_evaluate_spec_collection :: (
  fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr
)({
  _reject_not_ghost_context(expr, ctx, exn);
  (cur_env : Environment) = env;
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  (i : usize) = usize(0);
  while(i < args.len(), {
    arg := match(args.get(i), .Some(x) => x, .None => make_err_expr());
    prev_ghost := ctx.is_ghost_context;
    ctx.is_ghost_context = true;
    evaluated := evaluate_expression_raw(arg, cur_env, ctx, exn);
    ctx.is_ghost_context = prev_ghost;
    bi_info := match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated)),
      .Some(x) => x,
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg),
              String.from("Failed to evaluate a spec-collection argument.")
            )
          )
        );
        new_expr_info(cur_env, t_unit())
      }
    );
    cur_env = bi_info.env;
    i = (i + usize(1));
  });
  // Result TYPE per builtin — the evaluator only type-checks the chain;
  // the verifier's walk gives the real SMT semantics. Carriers (unit /
  // append / singles / add / str_bytes) take the FIRST argument's type
  // (Seq(T)/Set(T)/Multiset(T) are erased aliases); counts are i64;
  // contains is bool; nth is u8 (str-content iteration).
  head := ast_expr_token(expr).value;
  arg1_ty := t_bool();
  match(
    args.get(usize(0)),
    .Some(a0) => {
      match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(a0)),
        .Some(a0i) => {
          arg1_ty = a0i.ty;
        },
        .None => ()
      );
    },
    .None => ()
  );
  res_ty := cond(
    ((head == "seq_len") || (head == "ms_count")) => t_i64(),
    (head == "set_contains") => t_bool(),
    (head == "seq_nth") => t_u8(),
    true => arg1_ty
  );
  out_info := new_expr_info(cur_env, res_ty.clone());
  out_info.value = Option(EvalValue).Some(create_unknown_val(res_ty));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
evaluate_seq_unit :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_spec_collection(expr, env, ctx, exn)
);
evaluate_seq_append :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_spec_collection(expr, env, ctx, exn)
);
evaluate_seq_len :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_spec_collection(expr, env, ctx, exn)
);
evaluate_seq_nth :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_spec_collection(expr, env, ctx, exn)
);
evaluate_str_bytes :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_spec_collection(expr, env, ctx, exn)
);
evaluate_ms_single :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_spec_collection(expr, env, ctx, exn)
);
evaluate_ms_add :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_spec_collection(expr, env, ctx, exn)
);
evaluate_ms_count :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_spec_collection(expr, env, ctx, exn)
);
/// `ms_of(a)` (V5 task 6): a fixed-length Array(T, N)'s elements as a
/// ghost Multiset. The evaluator type-checks only (a carrier of the
/// array's own type); the verifier's walk folds the count array over N.
evaluate_ms_of :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_spec_collection(expr, env, ctx, exn)
);
evaluate_set_single :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_spec_collection(expr, env, ctx, exn)
);
evaluate_set_add :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_spec_collection(expr, env, ctx, exn)
);
evaluate_set_contains :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_spec_collection(expr, env, ctx, exn)
);
/// Ghost-only constructs (V5 §6: forall/exists/==>) have NO
/// runtime semantics — outside ghost context they are a compile error,
/// the same stance as `unwind(...)` outside `ctl(...) -> R`.
_reject_not_ghost_context :: (fn(expr : AstExpr, ctx : EvalContext, exn : Exception) -> unit)({
  if(!ctx.is_ghost_context, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("ghost-only builtin (legal only inside contract clauses, ghost(...) bindings, and ghost_fn bodies — it has no runtime semantics; plans/backlog/FORMAL_VERIFICATION.md §6)")
        )
      )
    );
  });
});
/// forall/exists — V5 quantifier builtins, ghost-only. N binder
/// args `(name : Type)` then the predicate body. The binders are bound
/// to UNKNOWN values of their annotated types in a scoped frame for the
/// body's evaluation (the verifier walks the real AST into a Quant
/// term; runtime-mode files are rejected: the gate above fires in the
/// splice lowering's evaluation).
_evaluate_quantifier :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  _reject_not_ghost_context(expr, ctx, exn);
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  if(args.len() < usize(2), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("a quantifier needs at least one binder (name : Type) and a predicate body")
        )
      )
    );
  });
  // Pass 1: evaluate the BINDER annotations (each `(name : Type)` — a
  // 2-arg `:` call evaluating to a TypeVal) and collect the pairs.
  (cur_env : Environment) = env;
  binder_names := ArrayList(String).new();
  binder_types := ArrayList(TypeValue).new();
  (bi : usize) = usize(0);
  while(bi < (args.len() - usize(1)), {
    barg := match(
      args.get(bi),
      .Some(bb) => bb,
      .None => make_err_expr()
    );
    if(!ast_expr_is_fn_call_of(barg, ":", Option(usize).Some(usize(2))), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(barg),
            String.from("quantifier binder must be (name : Type)")
          )
        )
      );
    });
    // The binder's TYPE is the `:`-call's SECOND argument (the type
    // expression evaluates to a TypeVal). The annotation call itself is
    // a binding FORM — never evaluated as an expression.
    ba := match(
      barg,
      .FnCall(_, _, a2, _, _) => a2,
      .Atom(_, _) => ArrayList(AstExpr).new()
    );
    ty_expr := match(
      ba.get(usize(1)),
      .Some(t0) => t0,
      .None => make_err_expr()
    );
    prev_pred_flag := ctx.is_evaluating_contract_predicate;
    ctx.is_evaluating_contract_predicate = true;
    ty_evaluated := evaluate_expression_raw(ty_expr, cur_env, ctx, exn);
    ctx.is_evaluating_contract_predicate = prev_pred_flag;
    ty_info := match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(ty_evaluated)),
      .Some(x) => x,
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(barg),
              String.from("quantifier binder must be (name : Type)")
            )
          )
        );
        new_expr_info(cur_env, t_unit())
      }
    );
    cur_env = ty_info.env;
    bt := match(
      ty_info.value,
      .Some(biv) => match(
        biv,
        .TypeVal(tv) => tv,
        _ => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(barg),
                String.from("quantifier binder must be (name : Type)")
              )
            )
          );
          t_unit()
        }
      ),
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(barg),
              String.from("quantifier binder must be (name : Type)")
            )
          )
        );
        t_unit()
      }
    );
    bn := match(
      ba.get(usize(0)),
      .Some(n0) => ast_expr_token(n0).value,
      .None => String.from("_")
    );
    binder_names.push(bn.clone());
    binder_types.push(bt);
    bi = (bi + usize(1));
  });
  // Pass 2: bind the names to unknowns in a scoped frame and evaluate
  // the body (nested quantifiers stay legal — the flag stays set).
  _ := cur_env.push_frame(true);
  (vi : usize) = usize(0);
  while(vi < binder_names.len(), {
    vname := binder_names.get(vi).unwrap();
    vty := binder_types.get(vi).unwrap();
    _ := add_variable_to_env(
      cur_env,
      vname.clone(),
      vty.clone(),
      Option(EvalValue).Some(create_unknown_val(vty.clone())),
      false,
      false,
      false,
      false,
      ast_expr_token(expr)
    );
    vi = (vi + usize(1));
  });
  body := match(
    args.get(args.len() - usize(1)),
    .Some(bb) => bb,
    .None => make_err_expr()
  );
  prev_pred_flag2 := ctx.is_evaluating_contract_predicate;
  ctx.is_evaluating_contract_predicate = true;
  evaluated_body := evaluate_expression_raw(body, cur_env, ctx, exn);
  ctx.is_evaluating_contract_predicate = prev_pred_flag2;
  cur_env.pop_frame();
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_body)),
    .Some(info2) => {
      cur_env = info2.env;
    },
    .None => ()
  );
  out_info := new_expr_info(cur_env, t_bool());
  out_info.value = Option(EvalValue).Some(create_unknown_val(t_bool()));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
/// forall(...) — ghost-only universal quantifier (V5).
evaluate_forall :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_quantifier(expr, env, ctx, exn)
);
/// exists(...) — ghost-only existential quantifier (V5).
evaluate_exists :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_quantifier(expr, env, ctx, exn)
);
/// `a ==> b` — ghost-only implication (V5). Exactly two args; evaluates
/// to an unknown bool like the quantifiers.
evaluate_implies :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  _reject_not_ghost_context(expr, ctx, exn);
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  if(args.len() != usize(2), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("'==>' takes exactly two arguments")
        )
      )
    );
  });
  (cur_env : Environment) = env;
  (i : usize) = usize(0);
  while(i < args.len(), {
    arg := match(args.get(i), .Some(a) => a, .None => make_err_expr());
    prev_pred_flag := ctx.is_evaluating_contract_predicate;
    ctx.is_evaluating_contract_predicate = true;
    evaluated := evaluate_expression_raw(arg, cur_env, ctx, exn);
    ctx.is_evaluating_contract_predicate = prev_pred_flag;
    match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated)),
      .Some(info) => {
        cur_env = info.env;
      },
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg),
              String.from("Failed to evaluate '==>' argument.")
            )
          )
        );
      }
    );
    i = (i + usize(1));
  });
  out_info := new_expr_info(cur_env, t_bool());
  out_info.value = Option(EvalValue).Some(create_unknown_val(t_bool()));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
/// `old(expr)` — entry-snapshot reference (handled specially inside `ensures`
/// by the wrapper; transparent pass-through elsewhere). Mirrors `evaluateOld`.
evaluate_old :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  if(!ast_expr_is_fn_call_of(expr, BF_OLD, .Some(usize(1))), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `'old(...)' takes exactly one argument, got:\n${ast_expr_to_string(expr)}`
        )
      )
    );
  });
  _evaluate_transparent_unary(expr, env, ctx, exn)
});
// ---------------------------------------------------------------------------
// Phase 0 task #6 of plans/backlog/FORMAL_VERIFICATION.md: lower the `requires(...)` /
// `ensures(...)` clauses extracted from a function signature into runtime
// `assert(P, msg)` / `comptime_assert(P, msg)` calls woven into the body.
// 1:1 port of `wrapFunctionBodyWithContracts` in
// `src/evaluator/builtins/contracts.ts:390-502`.
//
// Lowering shape (all four combinations):
//   no contracts     -> <body> (unchanged)
//   requires only    -> { assert(R1); ...; <body> }
//   ensures only     -> { <ret> := (<body>); assert(E1); ...; <ret> }
//   both             -> { assert(R1); ...; <ret> := (<body>); assert(E1); ...; <ret> }
//
// `<ret>` is the signature's labeled return `-> (name : T)` when present
// (Phase V1, decision D3), else the unspeakable internal name below.
// ---------------------------------------------------------------------------
/// The internal name the wrapper threads the return value under when the
/// return is UNLABELED — deliberately unspeakable so predicates cannot
/// reference it. Phase V1 (decision D3,
/// plans/backlog/FORMAL_VERIFICATION.md) removed the Phase-0 magic `result`
/// identifier: a post-condition names the return value through the labeled
/// return. Replaces `RESULT_IDENTIFIER` (contracts.ts:238).
__YO_CONTRACT_RESULT :: "__yo_contract_result";
/// Phase V1: record the node ids of every identifier atom inside a spliced
/// `ensures(...)` predicate of an UNLABELED-return function, so the ordinary
/// `Variable "x" not found.` error at identifier resolution can append the
/// label-the-return hint. With a labeled return an unbound name is an
/// ordinary typo and nothing registers.
_note_unlabeled_ensures_atoms :: (fn(e : AstExpr) -> unit)(
  match(
    e,
    .Atom(_, _) => {
      note_unlabeled_ensures_atom(ast_expr_id(e));
    },
    .FnCall(_, f_box, f_args, _, _) => {
      recur(f_box);
      (ai : usize) = usize(0);
      while(ai < f_args.len(), {
        match(
          f_args.get(ai),
          .Some(a) => {
            recur(a);
          },
          .None => ()
        );
        ai = (ai + usize(1));
      });
    }
  )
);
/// Build a synthetic atom borrowing `src_tok`'s source position so diagnostics
/// point at the user's contract clause. Mirrors `synthAtom` (contracts.ts:245).
_synth_atom :: (fn(value : String, kind : TokenKind, src_tok : Token) -> AstExpr)(
  AstExpr.Atom(
    alloc_global_expr_id(),
    Token(
      kind : kind,
      value : value,
      row : src_tok.row,
      column : src_tok.column,
      character : src_tok.character,
      byte_offset : src_tok.byte_offset,
      module_path : src_tok.module_path.clone(),
      input : src_tok.input.clone()
    )
  )
);
/// JSON-escape `s` for embedding in a synthetic string-literal token. yo-self's
/// `evaluate_string_literal` runs `decode_str_lit_escapes(tok.value)`, which
/// assumes the raw token value INCLUDES the surrounding double quotes — the
/// same round-trip TS gets from `JSON.stringify` (contracts.ts:274).
_synth_string_token_value :: (fn(s : String) -> String)({
  sb := StringBuilder.new();
  sb.write_byte(u8(0x22));
  {
    it := s.chars();
    while(true, {
      r := match(it.next(), .Some(x) => x, .None => break);
      cond(
        (r.char == u32(0x5C)) => {
          sb.write_byte(u8(0x5C));
          sb.write_byte(u8(0x5C));
        },
        (r.char == u32(0x22)) => {
          sb.write_byte(u8(0x5C));
          sb.write_byte(u8(0x22));
        },
        (r.char == u32(0x0A)) => {
          sb.write_byte(u8(0x5C));
          sb.write_byte(u8(0x6E));
        },
        (r.char == u32(0x0D)) => {
          sb.write_byte(u8(0x5C));
          sb.write_byte(u8(0x72));
        },
        (r.char == u32(0x09)) => {
          sb.write_byte(u8(0x5C));
          sb.write_byte(u8(0x74));
        },
        true => {
          sb.write_rune(r);
        }
      );
    });
  };
  sb.write_byte(u8(0x22));
  sb.to_string()
});
/// Callee for the synthesized contract assert. `comptime_assert` is a builtin
/// keyword and resolves bare; runtime `assert` moved out of the prelude into
/// `std/assert` (explicit import), so a bare `assert` identifier no longer
/// resolves in user files that never import it. Synthesize
/// `import("std/assert").assert` instead — self-contained and immune to local
/// shadowing. Mirrors `buildAssertCallee` (contracts.ts).
_build_assert_callee :: (fn(assert_fn_name : String, pred_tok : Token) -> AstExpr)({
  if(!(assert_fn_name == "assert"), {
    return(_synth_atom(assert_fn_name, TokenKind.Identifier, pred_tok));
  });
  import_args := ArrayList(AstExpr).new();
  import_args.push(
    _synth_atom(
      _synth_string_token_value(String.from("std/assert")),
      TokenKind.StringLit,
      pred_tok.clone()
    )
  );
  import_call := AstExpr.FnCall(
    alloc_global_expr_id(),
    _synth_atom(String.from("import"), TokenKind.Identifier, pred_tok.clone()),
    import_args,
    false,
    pred_tok.clone()
  );
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(import_call);
  dot_args.push(_synth_atom(String.from("assert"), TokenKind.Identifier, pred_tok.clone()));
  AstExpr.FnCall(
    alloc_global_expr_id(),
    _synth_atom(String.from("."), TokenKind.Identifier, pred_tok.clone()),
    dot_args,
    false,
    pred_tok
  )
});
/// Build a synthetic `assert(pred, "<label>: <pred-src>")` (or
/// `comptime_assert(...)`) call. `label_pred` supplies the human-readable
/// message text; `pred` is what actually gets checked (it may have had
/// `old(...)` rewritten to snapshot references).
/// Mirrors `buildAssertCall` (contracts.ts:260-283).
_build_assert_call :: (
  fn(
    pred : AstExpr,
    label_pred : AstExpr,
    label : String,
    assert_fn_name : String
  ) -> AstExpr
)({
  pred_tok := ast_expr_token(pred);
  msg := `${label}: ${ast_expr_to_string(label_pred)}`;
  msg_expr := _synth_atom(
    _synth_string_token_value(msg),
    TokenKind.StringLit,
    pred_tok.clone()
  );
  args := ArrayList(AstExpr).new();
  args.push(pred);
  args.push(msg_expr);
  AstExpr.FnCall(
    alloc_global_expr_id(),
    _build_assert_callee(assert_fn_name, pred_tok.clone()),
    args,
    false,
    pred_tok
  )
});
/// Build a synthetic `name := value` (runtime) or `name :: value` (comptime)
/// binding. Comptime functions need `::` because a `:=` runtime binding is
/// rejected inside a compile-time-only function body.
/// Mirrors `buildBinding` (contracts.ts:290-312).
_build_binding :: (fn(name : String, value : AstExpr, src_tok : Token, op : String) -> AstExpr)({
  bind_tok := Token(
    kind : TokenKind.Identifier,
    value : op,
    row : src_tok.row,
    column : src_tok.column,
    character : src_tok.character,
    byte_offset : src_tok.byte_offset,
    module_path : src_tok.module_path.clone(),
    input : src_tok.input.clone()
  );
  args := ArrayList(AstExpr).new();
  args.push(_synth_atom(name, TokenKind.Identifier, src_tok));
  args.push(value);
  AstExpr.FnCall(
    alloc_global_expr_id(),
    AstExpr.Atom(alloc_global_expr_id(), bind_tok.clone()),
    args,
    true,
    bind_tok
  )
});
/// Monotonic counter for `old(...)` entry-snapshot names. A module-level global
/// rather than TS's local `counter` closure variable: `_hoist_old_in` is a
/// `recur`-style self-recursive function and yo-self cannot thread an
/// `inout(usize)` accumulator through `recur`. Snapshot names only need to be
/// unique WITHIN one wrapped body, and a monotonic global is strictly stronger.
(g_contract_old_counter : usize) = usize(0);
/// Rewrite `old(expr)` occurrences inside one `ensures` predicate: each is
/// hoisted into an entry-time snapshot binding `__yo_contract_old_K := expr`
/// pushed onto `snapshots`, and the `old(expr)` node is replaced by a
/// reference to that snapshot.
/// Mirrors the `rewrite` closure of `hoistOldExpressions` (contracts.ts:328-360).
_hoist_old_in :: (
  fn(
    e : AstExpr,
    snapshots : ArrayList(AstExpr),
    bind_op : String
  ) -> AstExpr
)(
  match(
    e,
    .Atom(_, _) => e,
    .FnCall(_, f_box, f_args, f_infix, f_tok) => cond(
      ast_expr_is_fn_call_of(e, BF_OLD, .Some(usize(1))) => {
        inner := recur(
          match(f_args.get(usize(0)), .Some(x) => x, .None => make_err_expr()),
          snapshots,
          bind_op.clone()
        );
        snap_name := `__yo_contract_old_${g_contract_old_counter.to_string()}`;
        g_contract_old_counter = (g_contract_old_counter + usize(1));
        snapshots.push(
          _build_binding(snap_name.clone(), inner, f_tok.clone(), bind_op.clone())
        );
        _synth_atom(snap_name, TokenKind.Identifier, f_tok.clone())
      },
      true => {
        new_args := ArrayList(AstExpr).new();
        (hi : usize) = usize(0);
        while(hi < f_args.len(), {
          match(
            f_args.get(hi),
            .Some(a) => {
              new_args.push(recur(a, snapshots, bind_op.clone()));
            },
            .None => ()
          );
          hi = (hi + usize(1));
        });
        AstExpr.FnCall(
          alloc_global_expr_id(),
          recur(f_box, snapshots, bind_op.clone()),
          new_args,
          f_infix,
          f_tok.clone()
        )
      }
    )
  )
);
// ============================================================================
// V3: the pending-verification task registry + mode resolution
// (plans/backlog/FORMAL_VERIFICATION.md §Architecture — the evaluator
// RECORDS tasks as it evaluates a verification target; the separate
// verifier pass CONSUMES them after module evaluation. The registry lives
// here, next to the other contract side-table plumbing, so no evaluator
// file needs to import from src/verifier/.)
// ============================================================================
/// One function queued for the verifier pass.
VerifyTask :: ref(
  struct(
    /// Display id — `fn@<module>:<row>` of the fn-type expression. The
    /// defining name binding (`name :: (fn(...))(body)`) is not in scope
    /// at the registration site, so the source location is the id.
    fn_id : String,
    /// The FuncVal's `func_id` — the re-keyed contract side tables are
    /// readable under it, and self-recursion detection compares it.
    func_id : String,
    module_path : String,
    /// The UNWRAPPED body (pre-splice): the verifier walks the real body,
    /// never the assert-spliced one.
    body : AstExpr,
    param_names : ArrayList(String),
    param_types : ArrayList(TypeValue),
    result_type : TypeValue,
    requires_exprs : ArrayList(AstExpr),
    ensures_exprs : ArrayList(AstExpr),
    /// Phase V4 `decreases(M)` termination measure (at most one).
    (decreases_expr : Option(AstExpr)) ?= Option(AstExpr).None,
    return_label : Option(String),
    table : ExprInfoTable,
    /// `"verify"` | `"verify+"` — only those modes register.
    mode : String,
    /// The FuncVal itself — the `verify+` strip pass rewrites its boxed
    /// body data in place (dropping asserts whose predicates proved).
    func_val : EvalValue,
    /// V6 task 5: the signature carried `assumed()` — the verifier reports
    /// the fn as `assumed` without walking the body (raw-pointer internals
    /// are outside the verifiable subset); its contracts still gate callers.
    (body_assumed : bool) ?= false
  )
);
(g_verify_tasks : ArrayList(VerifyTask)) = ArrayList(VerifyTask).new();
/// V5 honest diagnostics: when a verify-target function's definition-time
/// body trial SWALLOWS an error (E0902/E0401 class — the load continues,
/// the body never gets ExprInfo), the real message is recorded here keyed
/// by the task's fn_id, so the verifier can report the CAUSE instead of
/// the misleading "untyped expression" at the hollow body root.
(g_verify_def_eval_failures : HashMap(String, String)) = HashMap(String, String).new();
record_verify_task_def_eval_failure :: (fn(fn_id : String, msg : String) -> unit)({
  g_verify_def_eval_failures.insert(fn_id, msg);
  ()
});
verify_task_def_eval_failure :: (fn(fn_id : String) -> Option(String))(
  g_verify_def_eval_failures.get(fn_id)
);
/// The file set the current command is verifying (absolute or as-given
/// paths — matched by equality against `Token.module_path`). Empty = no
/// verification is recording (plain `yo check`/`compile`), so registry
/// effects are inert.
/// The CLI override (`--verify-mode`); the file pragma is source of truth
/// when present, this decides otherwise.
(g_verify_mode_override : Option(String)) = Option(String).None;
set_verify_mode_override :: (fn(m : Option(String)) -> unit)({
  g_verify_mode_override = m;
  ()
});
/// Declare the verification target file set (and reset any previous one).
/// The verification mode for a module: `"runtime"` | `"verify"` |
/// `"verify+"` | `"ignore"`. The FILE's pragma is the source of truth when
/// present (plans/backlog/FORMAL_VERIFICATION.md §"Verification modes");
/// otherwise the CLI override decides; the default is today's `runtime`.
resolve_verify_mode :: (fn(module_path : String) -> String)(
  cond(
    file_has_pragma(Option(String).Some(module_path.clone()), Pragma.NoContracts) => String.from("ignore"),
    file_has_pragma(Option(String).Some(module_path.clone()), Pragma.Verify) => String.from("verify"),
    file_has_pragma(Option(String).Some(module_path.clone()), Pragma.VerifyOrAssert) => String.from("verify+"),
    true => match(
      g_verify_mode_override,
      .Some(m) => m.clone(),
      .None => String.from("runtime")
    )
  )
);
/// Queue one function. First-wins on `fn_id`: the def site fires once per
/// module evaluation, but a specialization re-entry would re-register the
/// same source — keep the first (definition-site) view.
register_verify_task :: (fn(t : VerifyTask) -> unit)({
  (dup : bool) = false;
  (i : usize) = usize(0);
  while((i < g_verify_tasks.len()) && !dup, {
    match(
      g_verify_tasks.get(i),
      .Some(prev) => if(prev.fn_id == t.fn_id, {
        dup = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  if(!dup, {
    g_verify_tasks.push(t);
  });
  ()
});
/// Diagnostic-evaluate one contract predicate for the verifier task (the
/// plan's "predicates still get one diagnostic evaluation pass"). The
/// fn-type side tables store the ORIGINAL signature AST nodes, but
/// ExprInfo lands on the EVALUATED forms — the verifier's symbolic walk
/// keys everything by ExprInfo, so the task must carry the evaluated
/// nodes. Unbound names (params, the return label) soft-fall-back to
/// VarRef exactly as at signature time.
evaluated_for_verify :: (
  fn(p : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr
)({
  // The verifier's diagnostic predicate pass IS ghost context (V5):
  // quantifier builtins inside requires/ensures/decreases evaluate here.
  prev_ghost_flag := ctx.is_ghost_context;
  ctx.is_ghost_context = true;
  out := evaluate_expression_raw(p, env, ctx, exn);
  ctx.is_ghost_context = prev_ghost_flag;
  out
});
/// Drain the registry (move the tasks out and reset it) for the verifier
/// pass. `yo verify` drains once after evaluating the target set.
take_verify_tasks :: (fn() -> ArrayList(VerifyTask))({
  out := g_verify_tasks;
  g_verify_tasks = ArrayList(VerifyTask).new();
  out
});
/// V6 task 1 (FORMAL_VERIFICATION.md): trait-contract INHERITANCE at impl
/// registration. An impl method declaring NO contracts of its own inherits
/// the trait method's, in two pieces:
///   1. the trait's clauses are planted under the method FuncVal's id, so
///      every later consumer — a dispatch call site's requires/ensures
///      assumptions (`_callee_call_term` reads the callee FuncVal's id) —
///      carries them. The lambda-written impl shape already gets this copy
///      through its expected type's `origin_id` (anonymous_function.yo);
///      this is the named/colon-pair twin.
///   2. a SYNTHETIC verify task proves the impl's BODY against the trait's
///      contracts — the method's own task registered at its application,
///      BEFORE the impl statement ran, with no contracts to assume or
///      prove.
/// An earlier draft planted under the fn-TYPE EXPRESSION id, hoping the
/// application's re-key would carry the clauses to the FuncVal — but the
/// fn-type evaluation and the assert splice both RE-READ those tables by
/// that id, so the planted clauses were evaluated inside the trait entry
/// and tripped the env-sharing defect behind
/// issues/trait-impl-method-contract-clauses-corrupt-operator-dispatch.md.
/// The FuncVal id is never re-read by the evaluator — write-only, safe.
/// (The lambda shape gets piece 1 from origin_id but not piece 2 — no body
/// task exists for lambdas; pre-existing, recorded in the plan.)
register_impl_inheritance_task :: (
  fn(
    trait_id : String,
    label : String,
    method_val : EvalValue,
    fn_ty : TypeValue,
    name_tok : Token,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> unit
)({
  if(!_is_verify_target(name_tok.module_path.clone()), {
    return(());
  });
  __mode := resolve_verify_mode(name_tok.module_path.clone());
  if((__mode != "verify") && (__mode != "verify+"), {
    return(());
  });
  __t_reqs := trait_method_requires(trait_id.clone(), label.clone());
  __t_enss := trait_method_ensures(trait_id.clone(), label.clone());
  if((__t_reqs.len() == usize(0)) && (__t_enss.len() == usize(0)), {
    return(());
  });
  match(
    method_val,
    .FuncVal(__inh_fvd, _) => {
      __fid := __inh_fvd.*.func_id.clone();
      // The impl method declares its own contracts (or already inherits via
      // the lambda origin-copy — the trait's own nodes, indistinguishable
      // and needing no inheritance): variance governs, nothing to plant.
      if((hook_func_requires(__fid.clone()).len() > usize(0)) || (hook_func_ensures(__fid.clone()).len() > usize(0)), {
        return(());
      });
      __t_ret := trait_method_return_label(trait_id.clone(), label.clone());
      // 1. Plant the trait's clauses under the FuncVal id (dispatch sites).
      hook_register_func_contracts(
        __fid.clone(),
        trait_method_requires(trait_id.clone(), label.clone()),
        trait_method_ensures(trait_id.clone(), label.clone()),
        __t_ret.clone()
      );
      // 2. The synthetic body-proof task. Params from the method's
      // registered fn type; the RETURN LABEL is NOT a param — the runner
      // binds it to the walked body value before proving the ensures.
      (p_names : ArrayList(String)) = ArrayList(String).new();
      (p_types : ArrayList(TypeValue)) = ArrayList(TypeValue).new();
      ret_ty := TypeValue.Unit;
      match(
        fn_ty,
        .Func({ meta : __ihm, param_types : __ihpt, result : __ihres }) => {
          (pih : usize) = usize(0);
          while(pih < __ihpt.len(), {
            match(
              __ihpt.get(pih),
              .Some(pt) => {
                p_types.push(pt.clone());
                p_names.push(
                  match(
                    __ihm.*.param_labels.get(pih),
                    .Some(pl) => pl.clone(),
                    .None => String.new()
                  )
                );
              },
              .None => ()
            );
            pih = (pih + usize(1));
          });
          ret_ty = __ihres.clone();
        },
        _ => ()
      );
      pred_env := env;
      pred_env.push_frame(false);
      (bih : usize) = usize(0);
      while(bih < p_names.len(), {
        __pn := match(p_names.get(bih), .Some(x) => x, .None => String.new());
        __pt := match(p_types.get(bih), .Some(x) => x, .None => t_unit());
        if(__pn.len() > usize(0), {
          add_variable_to_env(
            pred_env,
            __pn.clone(),
            __pt.clone(),
            Option(EvalValue).Some(create_unknown_val(__pt.clone())),
            false,
            false,
            false,
            false,
            name_tok
          );
        });
        bih = (bih + usize(1));
      });
      match(
        __t_ret,
        .Some(rl) => {
          add_variable_to_env(
            pred_env,
            rl.clone(),
            ret_ty.clone(),
            Option(EvalValue).Some(create_unknown_val(ret_ty.clone())),
            false,
            false,
            false,
            false,
            name_tok
          );
        },
        .None => ()
      );
      evh_reqs := ArrayList(AstExpr).new();
      (vh : usize) = usize(0);
      while(vh < __t_reqs.len(), {
        match(
          __t_reqs.get(vh),
          .Some(p) => evh_reqs.push(evaluated_for_verify(clone_expr_fresh_ids(p.clone()), pred_env, ctx, exn)),
          .None => ()
        );
        vh = (vh + usize(1));
      });
      evh_enss := ArrayList(AstExpr).new();
      (vh2 : usize) = usize(0);
      while(vh2 < __t_enss.len(), {
        match(
          __t_enss.get(vh2),
          .Some(p) => evh_enss.push(evaluated_for_verify(clone_expr_fresh_ids(p.clone()), pred_env, ctx, exn)),
          .None => ()
        );
        vh2 = (vh2 + usize(1));
      });
      pred_env.pop_frame();
      register_verify_task(
        VerifyTask(
          fn_id : `impl-inherits@${name_tok.module_path}:${name_tok.row.to_string()}:${label}`,
          func_id : __fid.clone(),
          module_path : name_tok.module_path.clone(),
          // The FuncVal's body: `wrap_function_body_with_contracts`
          // returned it UNCHANGED at the application (no contracts were
          // registered under the fn-type expression id then — and verify
          // mode suppresses the splice regardless), so this is the raw
          // body whose ExprInfo the def-time trial stamped.
          body : __inh_fvd.*.body.clone(),
          param_names : p_names,
          param_types : p_types,
          result_type : ret_ty,
          requires_exprs : evh_reqs,
          ensures_exprs : evh_enss,
          return_label : __t_ret,
          table : ctx.expr_info_table,
          mode : __mode.clone(),
          func_val : method_val
        )
      );
    },
    _ => ()
  );
  ()
});
/// Whether two predicate lists are the SAME AST NODES in the same order
/// (node-id identity) — true when one side is an inheritance planting or
/// lambda origin-copy of the other, i.e. not independently declared
/// contracts.
_same_expr_ids :: (fn(a : ArrayList(AstExpr), b : ArrayList(AstExpr)) -> bool)(
  cond(
    (a.len() != b.len()) => false,
    true => {
      (i : usize) = usize(0);
      (same : bool) = true;
      while((i < a.len()) && same, {
        match(
          a.get(i),
          .Some(ax) => {
            match(
              b.get(i),
              .Some(bx) => {
                if(ast_expr_id(ax) != ast_expr_id(bx), {
                  same = false;
                });
              },
              .None => {
                same = false;
              }
            );
          },
          .None => {
            same = false;
          }
        );
        i = (i + usize(1));
      });
      same
    }
  )
);
/// V6 task 2 (FORMAL_VERIFICATION.md): per-call-site CONTRACT INSTANCES
/// for contracted generic callees. A generic function's signature
/// predicates are diagnostic-evaluated at ITS definition, where the
/// parameters are unknowns of the GENERIC types — every operator over
/// them fails to evaluate (no trait impl for a SomeT), the failure is
/// swallowed by the def-time trial, and the stored predicate nodes reach
/// the verifier UNTYPED (no ExprInfo — the walk's `_expr_term` rejects
/// them). At a monomorphized call site the concrete argument types ARE
/// known, so the walker's caller registers EVALUATED CLONES of the
/// callee's predicates with the callee's params bound to unknowns of the
/// CONCRETE types, keyed by the call expression's id; `_callee_call_term`
/// prefers the stash over the raw tables. This is the plan's
/// "monomorphized call sites discharge through the generic's own
/// contracts".
CallsiteContracts :: struct(
  reqs : ArrayList(AstExpr),
  enss : ArrayList(AstExpr)
);
(g_callsite_contracts : HashMap(String, CallsiteContracts)) = HashMap(String, CallsiteContracts).new();
register_callsite_contracts :: (
  fn(call_id : String, reqs : ArrayList(AstExpr), enss : ArrayList(AstExpr)) -> unit
)({
  _ := g_callsite_contracts.insert(call_id, CallsiteContracts(reqs : reqs, enss : enss));
});
callsite_contracts_for :: (fn(call_id : String) -> Option(CallsiteContracts))(
  g_callsite_contracts.get(call_id)
);
/// V6 task 4: specialized FuncVal id → the base (unspecialized) id it
/// was minted from. Written at the specialization mint (calls/helper.yo)
/// so the verifier's mutual-recursion cliques can be spelled in BASE fids
/// while the walk sees SPECIALIZED callee ids (`..._ret_N`).
(g_specialized_base : HashMap(String, String)) = HashMap(String, String).new();
register_specialized_base :: (fn(spec_id : String, base_id : String) -> unit)({
  _ := g_specialized_base.insert(spec_id, base_id);
});
specialized_base_of :: (fn(id : String) -> Option(String))(
  g_specialized_base.get(id)
);
/// Task-registration hook: stash contract instances for every contracted
/// callee call in the task body (see the CallsiteContracts doc).
prepare_callsite_contracts :: (
  fn(
    body : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> unit
)({
  _prepare_callsite_contracts(body, env, ctx, exn);
});
/// Walk a task body and stash evaluated contract instances for every
/// contracted callee call. Follows `ExprInfo.macro_expansion` for macro
/// calls (the optimizer-family discipline). Plain recursion: cond/match
/// arms and begin blocks are FnCall args, so every call site is reached.
_prepare_callsite_contracts :: (
  fn(
    e : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> unit
)({
  // A trailing `; ()` — a sole un-semicoloned `match(...)` would be an
  // E0007 struct literal, and a lone `match(...);` block-value reads as
  // unit anyway; the explicit tail keeps the shape obvious.
  match(
    e,
    .Atom(_, _) => (),
    .FnCall(_, f, args, _, _) => {
      // Macro calls: the semantics live in the expansion.
      expanded := match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(e)),
        .Some(ei) => ei.macro_expansion,
        .None => Option(AstExpr).None
      );
      match(
        expanded,
        .Some(xp) => {
          _prepare_callsite_contracts(xp, env, ctx, exn);
        },
        .None => {
          _stash_callsite_contracts(e, f, env, ctx, exn);
          (ai : usize) = usize(0);
          while(ai < args.len(), {
            match(
              args.get(ai),
              .Some(a) => _prepare_callsite_contracts(a, env, ctx, exn),
              .None => ()
            );
            ai = (ai + usize(1));
          });
        }
      );
    }
  );
  ()
});
/// The declared type of a call's `i`-th argument from its ExprInfo.
_callsite_arg_type :: (
  fn(ctx : EvalContext, e : AstExpr, i : usize) -> Option(TypeValue)
)(
  match(
    e,
    .FnCall(_, _, args, _, _) => match(
      args.get(i),
      .Some(a) => match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(a)),
        .Some(ai) => Option(TypeValue).Some(ai.ty.clone()),
        .None => Option(TypeValue).None
      ),
      .None => Option(TypeValue).None
    ),
    .Atom(_, _) => Option(TypeValue).None
  )
);
/// For one call site: read the callee FuncVal's contracts (through the
/// hooks — types/function.yo is not importable here), evaluate fresh-id
/// clones with the callee's params + return label bound to unknowns of
/// the CONCRETE call-site types, stash under the call node's id. A call
/// whose callee is not a contracted FuncVal is skipped; a predicate that
/// still fails to evaluate throws (a malformed contract at a real call
/// site is an error, not a silent drop).
_stash_callsite_contracts :: (
  fn(
    e : AstExpr,
    f : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> unit
)({
  callee_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(f)),
    .Some(ci) => ci,
    .None => {
      return(());
    }
  );
  fid := match(
    callee_info.value,
    .Some(v) => match(
      v,
      .FuncVal(fvd, _) => fvd.*.func_id.clone(),
      _ => {
        return(());
      }
    ),
    .None => {
      return(());
    }
  );
  raw_reqs := hook_func_requires(fid.clone());
  raw_enss := hook_func_ensures(fid.clone());
  if((raw_reqs.len() == usize(0)) && (raw_enss.len() == usize(0)), {
    return(());
  });
  // The callee's param labels (FuncVal order) and the CONCRETE types:
  // each argument's ExprInfo type at this call site, the call node's own
  // type for the return label.
  fvd_params := match(
    callee_info.value,
    .Some(v2) => match(
      v2,
      .FuncVal(fvd2, _) => fvd2.*.params,
      _ => ArrayList(String).new()
    ),
    .None => ArrayList(String).new()
  );
  ret_ty := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(e)),
    .Some(ei) => ei.ty.clone(),
    .None => t_unit()
  );
  site_env := env;
  site_env.push_frame(false);
  (bi : usize) = usize(0);
  while(bi < fvd_params.len(), {
    __pn := match(fvd_params.get(bi), .Some(x) => x, .None => String.new());
    if(__pn.len() > usize(0), {
      __pt := match(
        _callsite_arg_type(ctx, e, bi),
        .Some(at) => at,
        .None => t_unit()
      );
      add_variable_to_env(
        site_env,
        __pn.clone(),
        __pt.clone(),
        Option(EvalValue).Some(create_unknown_val(__pt.clone())),
        false,
        false,
        false,
        false,
        ast_expr_token(e)
      );
    });
    bi = (bi + usize(1));
  });
  match(
    hook_func_return_label(fid.clone()),
    .Some(rl) => {
      add_variable_to_env(
        site_env,
        rl.clone(),
        ret_ty.clone(),
        Option(EvalValue).Some(create_unknown_val(ret_ty.clone())),
        false,
        false,
        false,
        false,
        ast_expr_token(e)
      );
    },
    .None => ()
  );
  ev_reqs := ArrayList(AstExpr).new();
  (ri : usize) = usize(0);
  while(ri < raw_reqs.len(), {
    match(
      raw_reqs.get(ri),
      .Some(p) => ev_reqs.push(evaluated_for_verify(clone_expr_fresh_ids(p.clone()), site_env, ctx, exn)),
      .None => ()
    );
    ri = (ri + usize(1));
  });
  ev_enss := ArrayList(AstExpr).new();
  (ei : usize) = usize(0);
  while(ei < raw_enss.len(), {
    match(
      raw_enss.get(ei),
      .Some(p) => ev_enss.push(evaluated_for_verify(clone_expr_fresh_ids(p.clone()), site_env, ctx, exn)),
      .None => ()
    );
    ei = (ei + usize(1));
  });
  site_env.pop_frame();
  register_callsite_contracts(ast_expr_id(e).to_string(), ev_reqs, ev_enss);
});
/// Conjoin a non-empty predicate list into ONE expression: nested `&&`
/// (a single predicate passes through unwrapped). Fresh node ids.
_conj_exprs :: (fn(preds : ArrayList(AstExpr), tok : Token) -> AstExpr)({
  out := match(
    preds.get(usize(0)),
    .Some(p0) => clone_expr_fresh_ids(p0.clone()),
    .None => make_err_expr()
  );
  (i : usize) = usize(1);
  while(i < preds.len(), {
    match(
      preds.get(i),
      .Some(p) => {
        args := ArrayList(AstExpr).new();
        args.push(out);
        args.push(clone_expr_fresh_ids(p.clone()));
        out = AstExpr.FnCall(alloc_global_expr_id(), _synth_atom(String.from("&&"), TokenKind.Operator, tok.clone()), args, true, tok.clone());
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});
/// V6 task 1: the trait-contract VARIANCE obligations. An impl method
/// carrying contracts against a trait method that also carries them must
/// prove
///   trait.requires ⇒ impl.requires  (contravariant — dispatch callers
///                                    prove only the trait's)
///   impl.ensures ⇒ trait.ensures    (covariant — the trait's promise is
///                                    the floor)
/// Registered as a SYNTHETIC verify task whose body is a block of
/// `assert((Rt && ...) ==> Ri)` / `assert((Ei && ...) ==> Et)` asserts —
/// the ordinary pipeline (walk → report → strip) runs it with zero driver
/// changes. The return label binds as one extra synthetic PARAMETER (the
/// walk binds params to fresh symbolic Vars BEFORE the body — an
/// in-body label reference would otherwise be unbound). The trait's
/// predicates must use the impl's parameter and label SPELLINGS; a
/// mismatch fails loudly in the walk (`unbound runtime name '<p>'`),
/// which is the honest diagnostic for now. INHERITED contracts are
/// skipped by node-id identity: an inheritance planting (or the lambda
/// origin-copy) puts the trait's OWN AST nodes under the FuncVal id, so
/// both implications would be reflexive — nothing to check (the body
/// proof is the inherit task's job).
register_impl_variance_task :: (
  fn(
    trait_id : String,
    label : String,
    func_id : String,
    name_tok : Token,
    fn_ty : TypeValue,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> unit
)({
  if(!_is_verify_target(name_tok.module_path.clone()), {
    return(());
  });
  __mode := resolve_verify_mode(name_tok.module_path.clone());
  if((__mode != "verify") && (__mode != "verify+"), {
    return(());
  });
  __t_reqs := trait_method_requires(trait_id.clone(), label.clone());
  __t_enss := trait_method_ensures(trait_id.clone(), label.clone());
  if((__t_reqs.len() == usize(0)) && (__t_enss.len() == usize(0)), {
    return(());
  });
  __i_reqs := hook_func_requires(func_id.clone());
  __i_enss := hook_func_ensures(func_id.clone());
  if((__i_reqs.len() == usize(0)) && (__i_enss.len() == usize(0)), {
    return(());
  });
  // INHERITED (this registration's planting, or the lambda origin-copy):
  // the impl's predicate nodes ARE the trait's own — both implications
  // reflexive; the body proof is the inherit task's job.
  if(_same_expr_ids(__i_reqs.clone(), __t_reqs.clone()) && _same_expr_ids(__i_enss.clone(), __t_enss.clone()), {
    return(());
  });
  // The synthetic task's signature: the impl method's params (labels +
  // types from its registered fn type) plus the RETURN LABEL as one extra
  // param of the result type — the symbolic value both sides' ensures
  // compare against.
  (p_names : ArrayList(String)) = ArrayList(String).new();
  (p_types : ArrayList(TypeValue)) = ArrayList(TypeValue).new();
  ret_ty := TypeValue.Unit;
  match(
    fn_ty,
    .Func({ meta : __vm, param_types : __vpt, result : __vres }) => {
      (pi : usize) = usize(0);
      while(pi < __vpt.len(), {
        match(
          __vpt.get(pi),
          .Some(pt) => {
            p_types.push(pt.clone());
            p_names.push(
              match(
                __vm.*.param_labels.get(pi),
                .Some(pl) => pl.clone(),
                .None => String.new()
              )
            );
          },
          .None => ()
        );
        pi = (pi + usize(1));
      });
      ret_ty = __vres.clone();
    },
    _ => ()
  );
  ret_label := hook_func_return_label(func_id.clone());
  match(
    ret_label,
    .Some(rl) => {
      p_names.push(rl.clone());
      p_types.push(ret_ty.clone());
    },
    .None => ()
  );
  if(p_names.len() != p_types.len(), {
    return(());
  });
  pred_env := env;
  pred_env.push_frame(false);
  // `assert` for the synthetic body: the walk matches the BARE `assert`
  // head (its assert arm), but the fixture need not import std/assert —
  // the obligations are compiler-synthesized, not user-written. Evaluate
  // `import("std/assert").assert` once (self-contained, the splice's
  // `_build_assert_callee` idiom) and bind the resulting FuncVal under
  // the bare name, so the diagnostic evaluation of the body gives the
  // asserts exactly the evaluation a user-written body assert gets.
  __asrt_imp_args := ArrayList(AstExpr).new();
  __asrt_imp_args.push(
    _synth_atom(
      _synth_string_token_value(String.from("std/assert")),
      TokenKind.StringLit,
      name_tok.clone()
    )
  );
  __asrt_imp := AstExpr.FnCall(
    alloc_global_expr_id(),
    _synth_atom(String.from("import"), TokenKind.Identifier, name_tok.clone()),
    __asrt_imp_args,
    false,
    name_tok.clone()
  );
  __asrt_dot_args := ArrayList(AstExpr).new();
  __asrt_dot_args.push(__asrt_imp);
  __asrt_dot_args.push(_synth_atom(String.from("assert"), TokenKind.Identifier, name_tok.clone()));
  __asrt_expr := AstExpr.FnCall(
    alloc_global_expr_id(),
    _synth_atom(String.from("."), TokenKind.Identifier, name_tok.clone()),
    __asrt_dot_args,
    false,
    name_tok.clone()
  );
  __asrt_ev := evaluated_for_verify(__asrt_expr, pred_env, ctx, exn);
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(__asrt_ev)),
    .Some(__asrt_info) => {
      match(
        __asrt_info.value,
        .Some(__asrt_val) => {
          add_variable_to_env(
            pred_env,
            String.from("assert"),
            __asrt_info.ty.clone(),
            Option(EvalValue).Some(__asrt_val),
            false,
            false,
            false,
            false,
            name_tok
          );
        },
        .None => ()
      );
    },
    .None => ()
  );
  // Evaluate every predicate once with the params + label bound as
  // unknowns in the scoped frame above — the trait predicates were never
  // evaluated in THIS module (their names must match the impl's).
  (bi : usize) = usize(0);
  while(bi < p_names.len(), {
    __pn := match(p_names.get(bi), .Some(x) => x, .None => String.new());
    __pt := match(p_types.get(bi), .Some(x) => x, .None => t_unit());
    if(__pn.len() > usize(0), {
      add_variable_to_env(
        pred_env,
        __pn.clone(),
        __pt.clone(),
        Option(EvalValue).Some(create_unknown_val(__pt.clone())),
        false,
        false,
        false,
        false,
        name_tok
      );
    });
    bi = (bi + usize(1));
  });
  ev_t_reqs := ArrayList(AstExpr).new();
  ev_t_enss := ArrayList(AstExpr).new();
  ev_i_reqs := ArrayList(AstExpr).new();
  ev_i_enss := ArrayList(AstExpr).new();
  (vi : usize) = usize(0);
  while(vi < __t_reqs.len(), {
    match(
      __t_reqs.get(vi),
      .Some(p) => ev_t_reqs.push(evaluated_for_verify(clone_expr_fresh_ids(p.clone()), pred_env, ctx, exn)),
      .None => ()
    );
    vi = (vi + usize(1));
  });
  (vj : usize) = usize(0);
  while(vj < __t_enss.len(), {
    match(
      __t_enss.get(vj),
      .Some(p) => ev_t_enss.push(evaluated_for_verify(clone_expr_fresh_ids(p.clone()), pred_env, ctx, exn)),
      .None => ()
    );
    vj = (vj + usize(1));
  });
  (vk : usize) = usize(0);
  while(vk < __i_reqs.len(), {
    match(
      __i_reqs.get(vk),
      .Some(p) => ev_i_reqs.push(evaluated_for_verify(clone_expr_fresh_ids(p.clone()), pred_env, ctx, exn)),
      .None => ()
    );
    vk = (vk + usize(1));
  });
  (vl : usize) = usize(0);
  while(vl < __i_enss.len(), {
    match(
      __i_enss.get(vl),
      .Some(p) => ev_i_enss.push(evaluated_for_verify(clone_expr_fresh_ids(p.clone()), pred_env, ctx, exn)),
      .None => ()
    );
    vl = (vl + usize(1));
  });
  // The assert block: one assert per obligation.
  stmts := ArrayList(AstExpr).new();
  if(ev_t_reqs.len() > usize(0), {
    t_conj := _conj_exprs(ev_t_reqs, name_tok.clone());
    (ri : usize) = usize(0);
    while(ri < ev_i_reqs.len(), {
      match(
        ev_i_reqs.get(ri),
        .Some(ir) => stmts.push(_implies_assert(t_conj.clone(), ir.clone(), name_tok.clone())),
        .None => ()
      );
      ri = (ri + usize(1));
    });
  });
  if(ev_i_enss.len() > usize(0), {
    i_conj := _conj_exprs(ev_i_enss, name_tok.clone());
    (ei : usize) = usize(0);
    while(ei < ev_t_enss.len(), {
      match(
        ev_t_enss.get(ei),
        .Some(te) => stmts.push(_implies_assert(i_conj.clone(), te.clone(), name_tok.clone())),
        .None => ()
      );
      ei = (ei + usize(1));
    });
  });
  if(stmts.len() == usize(0), {
    return(());
  });
  // Trailing unit + the begin wrapper (the statement-block shape the
  // walk's `_begin_term` expects). The unit is the PARSER's zero-arg
  // `tuple()` call — a bare "()" atom would go down identifier lookup at
  // the diagnostic evaluation below and die on `Variable "()" not found`.
  stmts.push(
    AstExpr.FnCall(
      alloc_global_expr_id(),
      _synth_atom(String.from(BK_TUPLE), TokenKind.Identifier, name_tok.clone()),
      ArrayList(AstExpr).new(),
      false,
      name_tok.clone()
    )
  );
  body := AstExpr.FnCall(
    alloc_global_expr_id(),
    _synth_atom(String.from(BK_BEGIN), TokenKind.Identifier, name_tok.clone()),
    stmts,
    false,
    name_tok.clone()
  );
  body_ev := evaluated_for_verify(body, pred_env, ctx, exn);
  pred_env.pop_frame();
  register_verify_task(
    VerifyTask(
      fn_id : `impl-variance@${name_tok.module_path}:${name_tok.row.to_string()}:${label}`,
      func_id : func_id.clone(),
      module_path : name_tok.module_path.clone(),
      body : body_ev,
      param_names : p_names,
      param_types : p_types,
      result_type : ret_ty,
      // The trait's requires are ASSUMED on the path — the covariance
      // obligation is "under the trait's domain, the impl's ensures
      // imply the trait's" (the contravariance asserts below spell the
      // implication out themselves, so they hold either way).
      requires_exprs : ev_t_reqs,
      ensures_exprs : ArrayList(AstExpr).new(),
      return_label : Option(String).None,
      table : ctx.expr_info_table,
      mode : __mode.clone(),
      func_val : EvalValue.UnitVal
    )
  );
  ()
});
/// `assert((a) ==> (b))` with fresh node ids — one variance obligation.
_implies_assert :: (fn(a : AstExpr, b : AstExpr, tok : Token) -> AstExpr)({
  imp_args := ArrayList(AstExpr).new();
  imp_args.push(a);
  imp_args.push(b);
  imp := AstExpr.FnCall(
    alloc_global_expr_id(),
    _synth_atom(String.from("==>"), TokenKind.Operator, tok.clone()),
    imp_args,
    true,
    tok.clone()
  );
  as_args := ArrayList(AstExpr).new();
  as_args.push(imp);
  AstExpr.FnCall(
    alloc_global_expr_id(),
    _synth_atom(String.from("assert"), TokenKind.Identifier, tok.clone()),
    as_args,
    false,
    tok.clone()
  )
});
/// The `verify+` strip pass (plan task 6): rewrite a wrapped function
/// body IN PLACE, dropping the spliced `ensures failed` asserts whose
/// corresponding obligation PROVED (the runtime check is dead weight —
/// the proof replaces it). `proved[i]` is the verdict of `ensures#i`
/// (index-aligned with the task's ensures order = the wrapper's splice
/// order). The `requires failed` entry guards are KEPT: their proof
/// obligation lives at CALL SITES (one per caller), and stripping a
/// callee's guard because one caller proved it would be unsound.
/// Returns the number of asserts stripped.
strip_proved_ensures_asserts :: (
  fn(func_val : EvalValue, proved : ArrayList(bool)) -> usize
)(
  match(
    func_val,
    .FuncVal(fvd, _) => {
      body := fvd.*.body;
      match(
        body,
        .FnCall(begin_id, begin_func, args, begin_infix, begin_tok) => {
          kept := ArrayList(AstExpr).new();
          (ens_idx : usize) = usize(0);
          (stripped : usize) = usize(0);
          (i : usize) = usize(0);
          while(i < args.len(), {
            drop := match(
              args.get(i),
              .Some(arg) => {
                is_ens_assert := _is_contract_assert_call(arg, String.from("ensures failed:"));
                if(is_ens_assert, {
                  proved_here := match(
                    proved.get(ens_idx),
                    .Some(p) => p,
                    .None => false
                  );
                  ens_idx = (ens_idx + usize(1));
                  proved_here
                }, false)
              },
              .None => false
            );
            if(!drop, {
              match(
                args.get(i),
                .Some(arg) => {
                  kept.push(arg);
                },
                .None => ()
              );
            }, {
              stripped = (stripped + usize(1));
            });
            i = (i + usize(1));
          });
          if(stripped > usize(0), {
            fvd.*.body = AstExpr.FnCall(begin_id, begin_func, kept, begin_infix, begin_tok);
          });
          stripped
        },
        .Atom(_, _) => usize(0)
      )
    },
    _ => usize(0)
  )
);
/// Whether `e` is a spliced contract assert call whose message atom starts
/// with `prefix` — the wrapper's `_build_assert_call` shape: an
/// `assert`/`comptime_assert` call of two args whose second is a string
/// atom carrying the `<label>: <predicate>` message.
_is_contract_assert_call :: (fn(e : AstExpr, prefix : String) -> bool)(
  // The spliced message atom's token value is QUOTED
  // (`_synth_string_token_value`), so the prefix includes the opening
  // quote: `"ensures failed:`.
  cond(
    _assert_head_is(e, String.from("assert")) => _assert_msg_of(e).starts_with(`"${prefix}`),
    _assert_head_is(e, String.from("comptime_assert")) => _assert_msg_of(e).starts_with(`"${prefix}`),
    true => false
  )
);
/// The member-callee cond (arm-body extraction — no braced single
/// expressions).
_callee_member_cond :: (
  fn(dot_h : AstExpr, dot_args : ArrayList(AstExpr), name : String) -> bool
)(
  cond(
    (ast_expr_token(dot_h).value == ".") => _dot_arg1_is(dot_args, name.clone()),
    true => false
  )
);
/// Whether a `.`-call's SECOND argument is a plain atom named `name`.
_dot_arg1_is :: (fn(dot_args : ArrayList(AstExpr), name : String) -> bool)(
  match(
    dot_args.get(usize(1)),
    .Some(second) => match(
      second,
      .Atom(_, st) => (st.value == name),
      .FnCall(_, _, _, _, _) => false
    ),
    .None => false
  )
);
/// Whether `e` is a call of `name` — either a bare callee atom
/// (`comptime_assert`) or the wrapper's self-contained member callee
/// `.(import("std/assert"), assert)` for the runtime `assert`
/// (`_build_assert_callee`; the self-contained import survives the splice
/// into any body scope).
_assert_head_is :: (fn(e : AstExpr, name : String) -> bool)(
  match(
    e,
    .FnCall(_, f, _, _, _) => _callee_named(f, name.clone()),
    .Atom(_, _) => false
  )
);
/// Whether a callee expression names `name` — bare atom or the
/// `.(import("std/assert"), name)` member form.
_callee_named :: (fn(f : AstExpr, name : String) -> bool)(
  match(
    f,
    .Atom(_, ht) => (ht.value == name),
    .FnCall(_, dot_h, dot_args, _, _) => _callee_member_cond(dot_h, dot_args, name.clone())
  )
);
/// The message argument (arg 1) of an assert-shaped call when it is a
/// plain string atom ("" otherwise).
_assert_msg_of :: (fn(e : AstExpr) -> String)(
  match(
    e,
    .FnCall(_, _, a, _, _) => _arg1_string_atom(a),
    .Atom(_, _) => String.new()
  )
);
/// Arg 1 of a call rendered as a string when it is a plain string atom
/// ("" otherwise).
_arg1_string_atom :: (fn(a : ArrayList(AstExpr)) -> String)(
  match(
    a.get(usize(1)),
    .Some(m_arg) => cond(
      ast_expr_is_atom(m_arg) => ast_expr_token(m_arg).value,
      true => String.new()
    ),
    .None => String.new()
  )
);
/// Splice the contract predicates into `body`.
///
/// `return_label` (Phase V1) is the signature's labeled return
/// `-> (name : T)` — `ensures(...)` predicates reference the return value
/// through it. Unlabeled non-unit returns thread the value under the
/// unspeakable `__yo_contract_result` (decision D3: no magic `result`).
/// `is_comptime_fn` selects `comptime_assert` + `::` over `assert` + `:=`
/// (mirrors `fnType.return.isCompileTimeOnly`). `returns_unit` suppresses the
/// return binding (a `void result = ...` would be invalid C).
/// Returns `body` unchanged when there are no contracts, or when the body's
/// verification mode is not `runtime` (`ignore` erases the clauses —
/// `pragma(Pragma.NoContracts);`, mirrors contracts.ts:406-409 — and `verify`
/// suppresses the splice because the proof replaces the asserts).
wrap_function_body_with_contracts :: (
  fn(
    body : AstExpr,
    requires_exprs : ArrayList(AstExpr),
    ensures_exprs : ArrayList(AstExpr),
    return_label : Option(String),
    is_comptime_fn : bool,
    returns_unit : bool
  ) -> AstExpr
)({
  if((requires_exprs.len() == usize(0)) && (ensures_exprs.len() == usize(0)), {
    return(body);
  });
  body_tok := ast_expr_token(body);
  // V3 mode dispatch (plans/backlog/FORMAL_VERIFICATION.md §"The
  // assert-splice interaction"). Effects apply only when this module is a
  // VERIFICATION TARGET (the `yo verify` file set): a non-target file — the
  // prelude, an imported dependency — keeps today's runtime behavior even
  // under a CLI override, so its un-verified contracts never lose their
  // asserts.
  if(_is_verify_target(body_tok.module_path.clone()), {
    mode := resolve_verify_mode(body_tok.module_path.clone());
    // `ignore` (the `pragma(Pragma.NoContracts);` mode, or the CLI
    // override) — erase contract clauses entirely. Mirrors contracts.ts:406-409.
    if(mode == "ignore", {
      return(body);
    });
    // `verify` — suppress the splice entirely: the verifier consumes the
    // predicates from the fn-type side tables and the emitted code carries
    // no runtime asserts (the proof replaces them). The predicates were
    // still type-checked at signature evaluation, so malformed ones error.
    // `verify+` keeps the splice here; the strip pass for PROVED predicates
    // is V3 task 6.
    if(mode == "verify", {
      return(body);
    });
  });
  assert_fn_name := cond(
    is_comptime_fn => String.from(BF_COMPTIME_ASSERT),
    true => String.from("assert")
  );
  bind_op := cond(is_comptime_fn => String.from("::"), true => String.from(":="));
  // Phase V1 (decision D3): the binding the wrapper threads the return value
  // under — the user's label when present, else the unspeakable internal name.
  ret_name := match(
    return_label,
    .Some(label) => label,
    .None => String.from(__YO_CONTRACT_RESULT)
  );
  // requires asserts. `clone_expr_fresh_ids` gives each spliced predicate its
  // own node ids: yo-self keys ExprInfo by node id (expr.yo:307-313), so
  // reusing the signature's nodes would alias table entries across
  // specializations. TS gets fresh `$` slots for free from object identity.
  requires_asserts := ArrayList(AstExpr).new();
  (ri : usize) = usize(0);
  while(ri < requires_exprs.len(), {
    match(
      requires_exprs.get(ri),
      .Some(p) => {
        requires_asserts.push(
          _build_assert_call(
            clone_expr_fresh_ids(p.clone()),
            p,
            String.from("requires failed"),
            assert_fn_name.clone()
          )
        );
      },
      .None => ()
    );
    ri = (ri + usize(1));
  });
  begin_atom := _synth_atom(String.from(BK_BEGIN), TokenKind.Identifier, body_tok.clone());
  // No ensures: prepend the requires asserts to the body.
  if(ensures_exprs.len() == usize(0), {
    new_args := ArrayList(AstExpr).new();
    (ai : usize) = usize(0);
    while(ai < requires_asserts.len(), {
      match(
        requires_asserts.get(ai),
        .Some(a) => {
          new_args.push(a);
        },
        .None => ()
      );
      ai = (ai + usize(1));
    });
    if(ast_expr_is_fn_call_of(body, BK_BEGIN, Option(usize).None), {
      body_args := match(
        body,
        .FnCall(_, _, ba, _, _) => ba,
        .Atom(_, _) => ArrayList(AstExpr).new()
      );
      (bi : usize) = usize(0);
      while(bi < body_args.len(), {
        match(
          body_args.get(bi),
          .Some(a) => {
            new_args.push(a);
          },
          .None => ()
        );
        bi = (bi + usize(1));
      });
    }, {
      new_args.push(body);
    });
    return(
      AstExpr.FnCall(alloc_global_expr_id(), begin_atom, new_args, false, body_tok.clone())
    );
  });
  // Ensures present: hoist `old(...)` snapshots, then build the wrapped body.
  snapshots := ArrayList(AstExpr).new();
  ensures_asserts := ArrayList(AstExpr).new();
  (ei : usize) = usize(0);
  while(ei < ensures_exprs.len(), {
    match(
      ensures_exprs.get(ei),
      .Some(p) => {
        rewritten := _hoist_old_in(clone_expr_fresh_ids(p.clone()), snapshots, bind_op.clone());
        if(return_label.is_none(), {
          // Phase V1: unlabeled return — register the spliced predicate's
          // atom ids so an unbound-name failure can carry the
          // label-the-return hint. (Unit returns never reach here with a
          // label reference; that case is rejected at signature evaluation.)
          _note_unlabeled_ensures_atoms(rewritten);
        });
        // label_pred is the ORIGINAL predicate (still shows `old(...)`).
        ensures_asserts.push(
          _build_assert_call(
            rewritten,
            p,
            String.from("ensures failed"),
            assert_fn_name.clone()
          )
        );
      },
      .None => ()
    );
    ei = (ei + usize(1));
  });
  out_args := ArrayList(AstExpr).new();
  (si : usize) = usize(0);
  while(si < snapshots.len(), {
    match(
      snapshots.get(si),
      .Some(a) => {
        out_args.push(a);
      },
      .None => ()
    );
    si = (si + usize(1));
  });
  (qi : usize) = usize(0);
  while(qi < requires_asserts.len(), {
    match(
      requires_asserts.get(qi),
      .Some(a) => {
        out_args.push(a);
      },
      .None => ()
    );
    qi = (qi + usize(1));
  });
  if(returns_unit, {
    // Unit return: the return value is not nameable and
    // `void result = ...` is invalid C. Run the body as a statement, then
    // the ensures asserts.
    out_args.push(body);
  }, {
    out_args.push(
      _build_binding(
        ret_name.clone(),
        body,
        body_tok.clone(),
        bind_op.clone()
      )
    );
  });
  (fi : usize) = usize(0);
  while(fi < ensures_asserts.len(), {
    match(
      ensures_asserts.get(fi),
      .Some(a) => {
        out_args.push(a);
      },
      .None => ()
    );
    fi = (fi + usize(1));
  });
  if(!returns_unit, {
    out_args.push(
      _synth_atom(ret_name.clone(), TokenKind.Identifier, body_tok.clone())
    );
  });
  AstExpr.FnCall(alloc_global_expr_id(), begin_atom, out_args, false, body_tok.clone())
});
export(evaluate_requires, evaluate_ensures, evaluate_invariant, evaluate_decreases, evaluate_assumed, evaluate_ghost);
export(evaluate_ghost_fn, evaluate_old, evaluate_forall, evaluate_exists, evaluate_implies);
export(wrap_function_body_with_contracts);
export(
  VerifyTask,
  set_verify_mode_override,
  set_verify_target_paths,
  _is_verify_target,
  resolve_verify_mode,
  register_verify_task,
  evaluated_for_verify,
  take_verify_tasks,
  register_impl_inheritance_task,
  prepare_callsite_contracts,
  callsite_contracts_for,
  register_specialized_base,
  specialized_base_of,
  register_impl_variance_task,
  record_verify_task_def_eval_failure,
  verify_task_def_eval_failure,
  register_ghost_fn,
  is_ghost_fn,
  register_ghost_binding,
  is_ghost_binding_name,
  evaluate_seq_unit,
  evaluate_seq_append,
  evaluate_seq_len,
  evaluate_seq_nth,
  evaluate_str_bytes,
  evaluate_ms_single,
  evaluate_ms_add,
  evaluate_ms_count,
  evaluate_ms_of,
  evaluate_set_single,
  evaluate_set_add,
  evaluate_set_contains,
  strip_proved_ensures_asserts
);
