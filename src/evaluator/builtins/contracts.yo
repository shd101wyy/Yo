//! evaluator/builtins/contracts — contract-clause builtin handlers.
//!
//! Partial 1:1 port of `src/evaluator/builtins/contracts.ts` (Phase 0 of
//! plans/backlog/FORMAL_VERIFICATION.md). Ported here: the expression-position
//! handlers for `requires` / `ensures` / `invariant` / `ghost` (no-op markers
//! that evaluate their args and return `unit`) and `ghost_fn` / `old`
//! (transparent pass-throughs).
//!
//! Also ported: `wrap_function_body_with_contracts` — the signature→assert
//! lowering that turns `requires(...)` / `ensures(...)` in a function SIGNATURE
//! into runtime `assert(...)` / `comptime_assert(...)` calls wrapping the body
//! (wired from calls/function_type.yo). The runtime assert callee is the
//! self-contained `import("std/assert").assert` — see `_build_assert_callee`.
open(import("std/string"));
open(import("std/fmt"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom,
  BF_REQUIRES,
  BF_ENSURES,
  BF_INVARIANT,
  BF_DECREASES,
  BF_GHOST,
  BF_GHOST_FN,
  BF_OLD,
  BK_BEGIN,
  BF_COMPTIME_ASSERT,
  alloc_global_expr_id,
  clone_expr_fresh_ids,
  make_err_expr
} :: import("../../expr.yo");
{ ExprInfo, ExprInfoTable, new_expr_info, expr_info_table_get, expr_info_table_set }
:: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext, note_unlabeled_ensures_atom } :: import("../context.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ Token, TokenKind } :: import("../../token.yo");
{ file_has_pragma } :: import("../memory_safety.yo");
{ ArrayList } :: import("std/collections/array_list");
{ format_error_message } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ assert, panic } :: import("std/assert");
/// Evaluate any of the no-op contract markers (`requires` / `ensures` /
/// `invariant` / `ghost` in expression position). Each argument is evaluated
/// (so expression-level errors surface), but the call itself returns `unit`.
/// Mirrors `evaluateContractMarker` in `src/evaluator/builtins/contracts.ts`.
_evaluate_contract_marker :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  (cur_env : Environment) = env;
  (i : usize) = usize(0);
  while(i < args.len(), {
    arg := match(args.get(i), .Some(a) => a, .None => make_err_expr());
    // Bracket the predicate evaluation with the contract-predicate flag:
    // parameters and the return label are not bound in this env (they get
    // their real bindings in the splice lowering and the verifier's
    // registration env), so unbound identifiers soft-fall-back to unknowns
    // instead of the hard `Variable not found` error (Phase V3).
    prev_pred_flag := ctx.is_evaluating_contract_predicate;
    ctx.is_evaluating_contract_predicate = true;
    evaluated := evaluate_expression_raw(arg, cur_env, ctx, exn);
    ctx.is_evaluating_contract_predicate = prev_pred_flag;
    match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated)),
      .Some(info) => {
        cur_env = info.env;
      },
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg),
              String.from("Failed to evaluate argument of contract clause.")
            )
          )
        );
      }
    );
    i = (i + usize(1));
  });
  out_info := new_expr_info(cur_env, t_unit());
  out_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
/// `requires(...)` in expression position — no-op marker. Mirrors
/// `evaluateRequires`.
/// Reject a zero-argument contract marker in expression position.
/// Mirrors the `args.length === 0` guards in
/// `src/evaluator/builtins/contracts.ts:96-137`.
_reject_zero_arg_marker :: (fn(expr : AstExpr, message : String, exn : Exception) -> unit)({
  n := match(
    expr,
    .FnCall(_, _, a, _, _) => a.len(),
    .Atom(_, _) => usize(0)
  );
  if(n == usize(0), {
    exn.throw(dyn(format_error_message(ast_expr_token(expr), message)));
  });
});
evaluate_requires :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  _reject_zero_arg_marker(
    expr,
    String.from("'requires(...)' with zero arguments is a syntax error. Omit the clause entirely if there is no precondition."),
    exn
  );
  _evaluate_contract_marker(expr, env, ctx, exn)
});
/// `ensures(...)` in expression position — no-op marker. Mirrors
/// `evaluateEnsures`.
evaluate_ensures :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  _reject_zero_arg_marker(
    expr,
    String.from("'ensures(...)' with zero arguments is a syntax error. Omit the clause entirely if there is no postcondition."),
    exn
  );
  _evaluate_contract_marker(expr, env, ctx, exn)
});
/// `invariant(...)` — no-op marker (loop placement checked in `while`; SMT
/// discharge is a later phase). Mirrors `evaluateInvariant`.
evaluate_invariant :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  _reject_zero_arg_marker(
    expr,
    String.from("'invariant(...)' with zero arguments is a syntax error."),
    exn
  );
  _evaluate_contract_marker(expr, env, ctx, exn)
});
/// `decreases(M)` — no-op marker in expression position: the loop-body
/// statement form (right after `invariant(...)`) is consumed by the V4
/// verifier's loop encoding; the SIGNATURE clause is extracted by the
/// function-type evaluator.
evaluate_decreases :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  _reject_zero_arg_marker(
    expr,
    String.from("'decreases(...)' with zero arguments is a syntax error."),
    exn
  );
  _evaluate_contract_marker(expr, env, ctx, exn)
});
/// `ghost(...)` — ghost-binding marker, transparent in Phase 0. Mirrors
/// `evaluateGhost`.
evaluate_ghost :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)(
  _evaluate_contract_marker(expr, env, ctx, exn)
);
/// Shared transparent pass-through for `ghost_fn(inner)` / `old(inner)`:
/// evaluate the single inner argument and propagate its ExprInfo to the outer
/// call. Mirrors the bodies of `evaluateGhostFn` / `evaluateOld`.
_evaluate_transparent_unary :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  arg := match(
    expr,
    .FnCall(_, _, a, _, _) => match(a.get(usize(0)), .Some(x) => x, .None => make_err_expr()),
    .Atom(_, _) => make_err_expr()
  );
  evaluated := evaluate_expression_raw(arg, env, ctx, exn);
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated)),
    .Some(info) => {
      expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
    },
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg),
            String.from("Failed to evaluate argument of contract clause.")
          )
        )
      );
    }
  );
  expr
});
/// `ghost_fn(f)` — marks a function value ghost-only. Phase 0: transparent
/// pass-through. Mirrors `evaluateGhostFn`.
evaluate_ghost_fn :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  if(!ast_expr_is_fn_call_of(expr, BF_GHOST_FN, .Some(usize(1))), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `'ghost_fn(...)' takes exactly one argument, got:\n${ast_expr_to_string(expr)}`
        )
      )
    );
  });
  _evaluate_transparent_unary(expr, env, ctx, exn)
});
/// `old(expr)` — entry-snapshot reference (handled specially inside `ensures`
/// by the wrapper; transparent pass-through elsewhere). Mirrors `evaluateOld`.
evaluate_old :: (fn(expr : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr)({
  if(!ast_expr_is_fn_call_of(expr, BF_OLD, .Some(usize(1))), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `'old(...)' takes exactly one argument, got:\n${ast_expr_to_string(expr)}`
        )
      )
    );
  });
  _evaluate_transparent_unary(expr, env, ctx, exn)
});
// ---------------------------------------------------------------------------
// Phase 0 task #6 of plans/backlog/FORMAL_VERIFICATION.md: lower the `requires(...)` /
// `ensures(...)` clauses extracted from a function signature into runtime
// `assert(P, msg)` / `comptime_assert(P, msg)` calls woven into the body.
// 1:1 port of `wrapFunctionBodyWithContracts` in
// `src/evaluator/builtins/contracts.ts:390-502`.
//
// Lowering shape (all four combinations):
//   no contracts     -> <body> (unchanged)
//   requires only    -> { assert(R1); ...; <body> }
//   ensures only     -> { <ret> := (<body>); assert(E1); ...; <ret> }
//   both             -> { assert(R1); ...; <ret> := (<body>); assert(E1); ...; <ret> }
//
// `<ret>` is the signature's labeled return `-> (name : T)` when present
// (Phase V1, decision D3), else the unspeakable internal name below.
// ---------------------------------------------------------------------------
/// The internal name the wrapper threads the return value under when the
/// return is UNLABELED — deliberately unspeakable so predicates cannot
/// reference it. Phase V1 (decision D3,
/// plans/backlog/FORMAL_VERIFICATION.md) removed the Phase-0 magic `result`
/// identifier: a post-condition names the return value through the labeled
/// return. Replaces `RESULT_IDENTIFIER` (contracts.ts:238).
__YO_CONTRACT_RESULT :: "__yo_contract_result";
/// Phase V1: record the node ids of every identifier atom inside a spliced
/// `ensures(...)` predicate of an UNLABELED-return function, so the ordinary
/// `Variable "x" not found.` error at identifier resolution can append the
/// label-the-return hint. With a labeled return an unbound name is an
/// ordinary typo and nothing registers.
_note_unlabeled_ensures_atoms :: (fn(e : AstExpr) -> unit)(
  match(
    e,
    .Atom(_, _) => {
      note_unlabeled_ensures_atom(ast_expr_id(e));
    },
    .FnCall(_, f_box, f_args, _, _) => {
      recur(f_box);
      (ai : usize) = usize(0);
      while(ai < f_args.len(), {
        match(
          f_args.get(ai),
          .Some(a) => {
            recur(a);
          },
          .None => ()
        );
        ai = (ai + usize(1));
      });
    }
  )
);
/// Build a synthetic atom borrowing `src_tok`'s source position so diagnostics
/// point at the user's contract clause. Mirrors `synthAtom` (contracts.ts:245).
_synth_atom :: (fn(value : String, kind : TokenKind, src_tok : Token) -> AstExpr)(
  AstExpr.Atom(
    alloc_global_expr_id(),
    Token(
      kind : kind,
      value : value,
      row : src_tok.row,
      column : src_tok.column,
      character : src_tok.character,
      byte_offset : src_tok.byte_offset,
      module_path : src_tok.module_path.clone(),
      input : src_tok.input.clone()
    )
  )
);
/// JSON-escape `s` for embedding in a synthetic string-literal token. yo-self's
/// `evaluate_string_literal` runs `decode_str_lit_escapes(tok.value)`, which
/// assumes the raw token value INCLUDES the surrounding double quotes — the
/// same round-trip TS gets from `JSON.stringify` (contracts.ts:274).
_synth_string_token_value :: (fn(s : String) -> String)({
  sb := StringBuilder.new();
  sb.write_byte(u8(0x22));
  {
    it := s.chars();
    while(true, {
      r := match(it.next(), .Some(x) => x, .None => break);
      cond(
        (r.char == u32(0x5C)) => {
          sb.write_byte(u8(0x5C));
          sb.write_byte(u8(0x5C));
        },
        (r.char == u32(0x22)) => {
          sb.write_byte(u8(0x5C));
          sb.write_byte(u8(0x22));
        },
        (r.char == u32(0x0A)) => {
          sb.write_byte(u8(0x5C));
          sb.write_byte(u8(0x6E));
        },
        (r.char == u32(0x0D)) => {
          sb.write_byte(u8(0x5C));
          sb.write_byte(u8(0x72));
        },
        (r.char == u32(0x09)) => {
          sb.write_byte(u8(0x5C));
          sb.write_byte(u8(0x74));
        },
        true => {
          sb.write_rune(r);
        }
      );
    });
  };
  sb.write_byte(u8(0x22));
  sb.to_string()
});
/// Callee for the synthesized contract assert. `comptime_assert` is a builtin
/// keyword and resolves bare; runtime `assert` moved out of the prelude into
/// `std/assert` (explicit import), so a bare `assert` identifier no longer
/// resolves in user files that never import it. Synthesize
/// `import("std/assert").assert` instead — self-contained and immune to local
/// shadowing. Mirrors `buildAssertCallee` (contracts.ts).
_build_assert_callee :: (fn(assert_fn_name : String, pred_tok : Token) -> AstExpr)({
  if(!(assert_fn_name == "assert"), {
    return(_synth_atom(assert_fn_name, TokenKind.Identifier, pred_tok));
  });
  import_args := ArrayList(AstExpr).new();
  import_args.push(
    _synth_atom(
      _synth_string_token_value(String.from("std/assert")),
      TokenKind.StringLit,
      pred_tok.clone()
    )
  );
  import_call := AstExpr.FnCall(
    alloc_global_expr_id(),
    _synth_atom(String.from("import"), TokenKind.Identifier, pred_tok.clone()),
    import_args,
    false,
    pred_tok.clone()
  );
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(import_call);
  dot_args.push(_synth_atom(String.from("assert"), TokenKind.Identifier, pred_tok.clone()));
  AstExpr.FnCall(
    alloc_global_expr_id(),
    _synth_atom(String.from("."), TokenKind.Identifier, pred_tok.clone()),
    dot_args,
    false,
    pred_tok
  )
});
/// Build a synthetic `assert(pred, "<label>: <pred-src>")` (or
/// `comptime_assert(...)`) call. `label_pred` supplies the human-readable
/// message text; `pred` is what actually gets checked (it may have had
/// `old(...)` rewritten to snapshot references).
/// Mirrors `buildAssertCall` (contracts.ts:260-283).
_build_assert_call :: (
  fn(
    pred : AstExpr,
    label_pred : AstExpr,
    label : String,
    assert_fn_name : String
  ) -> AstExpr
)({
  pred_tok := ast_expr_token(pred);
  msg := `${label}: ${ast_expr_to_string(label_pred)}`;
  msg_expr := _synth_atom(
    _synth_string_token_value(msg),
    TokenKind.StringLit,
    pred_tok.clone()
  );
  args := ArrayList(AstExpr).new();
  args.push(pred);
  args.push(msg_expr);
  AstExpr.FnCall(
    alloc_global_expr_id(),
    _build_assert_callee(assert_fn_name, pred_tok.clone()),
    args,
    false,
    pred_tok
  )
});
/// Build a synthetic `name := value` (runtime) or `name :: value` (comptime)
/// binding. Comptime functions need `::` because a `:=` runtime binding is
/// rejected inside a compile-time-only function body.
/// Mirrors `buildBinding` (contracts.ts:290-312).
_build_binding :: (fn(name : String, value : AstExpr, src_tok : Token, op : String) -> AstExpr)({
  bind_tok := Token(
    kind : TokenKind.Identifier,
    value : op,
    row : src_tok.row,
    column : src_tok.column,
    character : src_tok.character,
    byte_offset : src_tok.byte_offset,
    module_path : src_tok.module_path.clone(),
    input : src_tok.input.clone()
  );
  args := ArrayList(AstExpr).new();
  args.push(_synth_atom(name, TokenKind.Identifier, src_tok));
  args.push(value);
  AstExpr.FnCall(
    alloc_global_expr_id(),
    AstExpr.Atom(alloc_global_expr_id(), bind_tok.clone()),
    args,
    true,
    bind_tok
  )
});
/// Monotonic counter for `old(...)` entry-snapshot names. A module-level global
/// rather than TS's local `counter` closure variable: `_hoist_old_in` is a
/// `recur`-style self-recursive function and yo-self cannot thread an
/// `inout(usize)` accumulator through `recur`. Snapshot names only need to be
/// unique WITHIN one wrapped body, and a monotonic global is strictly stronger.
(g_contract_old_counter : usize) = usize(0);
/// Rewrite `old(expr)` occurrences inside one `ensures` predicate: each is
/// hoisted into an entry-time snapshot binding `__yo_contract_old_K := expr`
/// pushed onto `snapshots`, and the `old(expr)` node is replaced by a
/// reference to that snapshot.
/// Mirrors the `rewrite` closure of `hoistOldExpressions` (contracts.ts:328-360).
_hoist_old_in :: (
  fn(
    e : AstExpr,
    snapshots : ArrayList(AstExpr),
    bind_op : String
  ) -> AstExpr
)(
  match(
    e,
    .Atom(_, _) => e,
    .FnCall(_, f_box, f_args, f_infix, f_tok) => cond(
      ast_expr_is_fn_call_of(e, BF_OLD, .Some(usize(1))) => {
        inner := recur(
          match(f_args.get(usize(0)), .Some(x) => x, .None => make_err_expr()),
          snapshots,
          bind_op.clone()
        );
        snap_name := `__yo_contract_old_${g_contract_old_counter.to_string()}`;
        g_contract_old_counter = (g_contract_old_counter + usize(1));
        snapshots.push(
          _build_binding(snap_name.clone(), inner, f_tok.clone(), bind_op.clone())
        );
        _synth_atom(snap_name, TokenKind.Identifier, f_tok.clone())
      },
      true => {
        new_args := ArrayList(AstExpr).new();
        (hi : usize) = usize(0);
        while(hi < f_args.len(), {
          match(
            f_args.get(hi),
            .Some(a) => {
              new_args.push(recur(a, snapshots, bind_op.clone()));
            },
            .None => ()
          );
          hi = (hi + usize(1));
        });
        AstExpr.FnCall(
          alloc_global_expr_id(),
          recur(f_box, snapshots, bind_op.clone()),
          new_args,
          f_infix,
          f_tok.clone()
        )
      }
    )
  )
);
// ============================================================================
// V3: the pending-verification task registry + mode resolution
// (plans/backlog/FORMAL_VERIFICATION.md §Architecture — the evaluator
// RECORDS tasks as it evaluates a verification target; the separate
// verifier pass CONSUMES them after module evaluation. The registry lives
// here, next to the other contract side-table plumbing, so no evaluator
// file needs to import from src/verifier/.)
// ============================================================================
/// One function queued for the verifier pass.
VerifyTask :: ref(
  struct(
    /// Display id — `fn@<module>:<row>` of the fn-type expression. The
    /// defining name binding (`name :: (fn(...))(body)`) is not in scope
    /// at the registration site, so the source location is the id.
    fn_id : String,
    /// The FuncVal's `func_id` — the re-keyed contract side tables are
    /// readable under it, and self-recursion detection compares it.
    func_id : String,
    module_path : String,
    /// The UNWRAPPED body (pre-splice): the verifier walks the real body,
    /// never the assert-spliced one.
    body : AstExpr,
    param_names : ArrayList(String),
    param_types : ArrayList(TypeValue),
    result_type : TypeValue,
    requires_exprs : ArrayList(AstExpr),
    ensures_exprs : ArrayList(AstExpr),
    /// Phase V4 `decreases(M)` termination measure (at most one).
    (decreases_expr : Option(AstExpr)) ?= Option(AstExpr).None,
    return_label : Option(String),
    table : ExprInfoTable,
    /// `"verify"` | `"verify+"` — only those modes register.
    mode : String,
    /// The FuncVal itself — the `verify+` strip pass rewrites its boxed
    /// body data in place (dropping asserts whose predicates proved).
    func_val : EvalValue
  )
);
(g_verify_tasks : ArrayList(VerifyTask)) = ArrayList(VerifyTask).new();
/// The file set the current command is verifying (absolute or as-given
/// paths — matched by equality against `Token.module_path`). Empty = no
/// verification is recording (plain `yo check`/`compile`), so registry
/// effects are inert.
(g_verify_target_paths : ArrayList(String)) = ArrayList(String).new();
/// The CLI override (`--verify-mode`); the file pragma is source of truth
/// when present, this decides otherwise.
(g_verify_mode_override : Option(String)) = Option(String).None;
set_verify_mode_override :: (fn(m : Option(String)) -> unit)({
  g_verify_mode_override = m;
  ()
});
/// Declare the verification target file set (and reset any previous one).
set_verify_target_paths :: (fn(paths : ArrayList(String)) -> unit)({
  g_verify_target_paths = paths;
  ()
});
_is_verify_target :: (fn(module_path : String) -> bool)({
  (found : bool) = false;
  (i : usize) = usize(0);
  while((i < g_verify_target_paths.len()) && !found, {
    match(
      g_verify_target_paths.get(i),
      .Some(p) => if(p == module_path, {
        found = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// The verification mode for a module: `"runtime"` | `"verify"` |
/// `"verify+"` | `"ignore"`. The FILE's pragma is the source of truth when
/// present (plans/backlog/FORMAL_VERIFICATION.md §"Verification modes");
/// otherwise the CLI override decides; the default is today's `runtime`.
resolve_verify_mode :: (fn(module_path : String) -> String)(
  cond(
    file_has_pragma(Option(String).Some(module_path.clone()), Pragma.NoContracts) => String.from("ignore"),
    file_has_pragma(Option(String).Some(module_path.clone()), Pragma.Verify) => String.from("verify"),
    file_has_pragma(Option(String).Some(module_path.clone()), Pragma.VerifyOrAssert) => String.from("verify+"),
    true => match(
      g_verify_mode_override,
      .Some(m) => m.clone(),
      .None => String.from("runtime")
    )
  )
);
/// Queue one function. First-wins on `fn_id`: the def site fires once per
/// module evaluation, but a specialization re-entry would re-register the
/// same source — keep the first (definition-site) view.
register_verify_task :: (fn(t : VerifyTask) -> unit)({
  (dup : bool) = false;
  (i : usize) = usize(0);
  while((i < g_verify_tasks.len()) && !dup, {
    match(
      g_verify_tasks.get(i),
      .Some(prev) => if(prev.fn_id == t.fn_id, {
        dup = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  if(!dup, {
    g_verify_tasks.push(t);
  });
  ()
});
/// Diagnostic-evaluate one contract predicate for the verifier task (the
/// plan's "predicates still get one diagnostic evaluation pass"). The
/// fn-type side tables store the ORIGINAL signature AST nodes, but
/// ExprInfo lands on the EVALUATED forms — the verifier's symbolic walk
/// keys everything by ExprInfo, so the task must carry the evaluated
/// nodes. Unbound names (params, the return label) soft-fall-back to
/// VarRef exactly as at signature time.
evaluated_for_verify :: (
  fn(p : AstExpr, env : Environment, ctx : EvalContext, exn : Exception) -> AstExpr
)(
  evaluate_expression_raw(p, env, ctx, exn)
);
/// Drain the registry (move the tasks out and reset it) for the verifier
/// pass. `yo verify` drains once after evaluating the target set.
take_verify_tasks :: (fn() -> ArrayList(VerifyTask))({
  out := g_verify_tasks;
  g_verify_tasks = ArrayList(VerifyTask).new();
  out
});
/// The `verify+` strip pass (plan task 6): rewrite a wrapped function
/// body IN PLACE, dropping the spliced `ensures failed` asserts whose
/// corresponding obligation PROVED (the runtime check is dead weight —
/// the proof replaces it). `proved[i]` is the verdict of `ensures#i`
/// (index-aligned with the task's ensures order = the wrapper's splice
/// order). The `requires failed` entry guards are KEPT: their proof
/// obligation lives at CALL SITES (one per caller), and stripping a
/// callee's guard because one caller proved it would be unsound.
/// Returns the number of asserts stripped.
strip_proved_ensures_asserts :: (
  fn(func_val : EvalValue, proved : ArrayList(bool)) -> usize
)(
  match(
    func_val,
    .FuncVal(fvd, _) => {
      body := fvd.*.body;
      match(
        body,
        .FnCall(begin_id, begin_func, args, begin_infix, begin_tok) => {
          kept := ArrayList(AstExpr).new();
          (ens_idx : usize) = usize(0);
          (stripped : usize) = usize(0);
          (i : usize) = usize(0);
          while(i < args.len(), {
            drop := match(
              args.get(i),
              .Some(arg) => {
                is_ens_assert := _is_contract_assert_call(arg, String.from("ensures failed:"));
                if(is_ens_assert, {
                  proved_here := match(
                    proved.get(ens_idx),
                    .Some(p) => p,
                    .None => false
                  );
                  ens_idx = (ens_idx + usize(1));
                  proved_here
                }, false)
              },
              .None => false
            );
            if(!drop, {
              match(
                args.get(i),
                .Some(arg) => {
                  kept.push(arg);
                },
                .None => ()
              );
            }, {
              stripped = (stripped + usize(1));
            });
            i = (i + usize(1));
          });
          if(stripped > usize(0), {
            fvd.*.body = AstExpr.FnCall(begin_id, begin_func, kept, begin_infix, begin_tok);
          });
          stripped
        },
        .Atom(_, _) => usize(0)
      )
    },
    _ => usize(0)
  )
);
/// Whether `e` is a spliced contract assert call whose message atom starts
/// with `prefix` — the wrapper's `_build_assert_call` shape: an
/// `assert`/`comptime_assert` call of two args whose second is a string
/// atom carrying the `<label>: <predicate>` message.
_is_contract_assert_call :: (fn(e : AstExpr, prefix : String) -> bool)(
  // The spliced message atom's token value is QUOTED
  // (`_synth_string_token_value`), so the prefix includes the opening
  // quote: `"ensures failed:`.
  cond(
    _assert_head_is(e, String.from("assert")) => _assert_msg_of(e).starts_with(`"${prefix}`),
    _assert_head_is(e, String.from("comptime_assert")) => _assert_msg_of(e).starts_with(`"${prefix}`),
    true => false
  )
);
/// The member-callee cond (arm-body extraction — no braced single
/// expressions).
_callee_member_cond :: (
  fn(dot_h : AstExpr, dot_args : ArrayList(AstExpr), name : String) -> bool
)(
  cond(
    (ast_expr_token(dot_h).value == ".") => _dot_arg1_is(dot_args, name.clone()),
    true => false
  )
);
/// Whether a `.`-call's SECOND argument is a plain atom named `name`.
_dot_arg1_is :: (fn(dot_args : ArrayList(AstExpr), name : String) -> bool)(
  match(
    dot_args.get(usize(1)),
    .Some(second) => match(
      second,
      .Atom(_, st) => (st.value == name),
      .FnCall(_, _, _, _, _) => false
    ),
    .None => false
  )
);
/// Whether `e` is a call of `name` — either a bare callee atom
/// (`comptime_assert`) or the wrapper's self-contained member callee
/// `.(import("std/assert"), assert)` for the runtime `assert`
/// (`_build_assert_callee`; the self-contained import survives the splice
/// into any body scope).
_assert_head_is :: (fn(e : AstExpr, name : String) -> bool)(
  match(
    e,
    .FnCall(_, f, _, _, _) => _callee_named(f, name.clone()),
    .Atom(_, _) => false
  )
);
/// Whether a callee expression names `name` — bare atom or the
/// `.(import("std/assert"), name)` member form.
_callee_named :: (fn(f : AstExpr, name : String) -> bool)(
  match(
    f,
    .Atom(_, ht) => (ht.value == name),
    .FnCall(_, dot_h, dot_args, _, _) => _callee_member_cond(dot_h, dot_args, name.clone())
  )
);
/// The message argument (arg 1) of an assert-shaped call when it is a
/// plain string atom ("" otherwise).
_assert_msg_of :: (fn(e : AstExpr) -> String)(
  match(
    e,
    .FnCall(_, _, a, _, _) => _arg1_string_atom(a),
    .Atom(_, _) => String.new()
  )
);
/// Arg 1 of a call rendered as a string when it is a plain string atom
/// ("" otherwise).
_arg1_string_atom :: (fn(a : ArrayList(AstExpr)) -> String)(
  match(
    a.get(usize(1)),
    .Some(m_arg) => cond(
      ast_expr_is_atom(m_arg) => ast_expr_token(m_arg).value,
      true => String.new()
    ),
    .None => String.new()
  )
);
/// Splice the contract predicates into `body`.
///
/// `return_label` (Phase V1) is the signature's labeled return
/// `-> (name : T)` — `ensures(...)` predicates reference the return value
/// through it. Unlabeled non-unit returns thread the value under the
/// unspeakable `__yo_contract_result` (decision D3: no magic `result`).
/// `is_comptime_fn` selects `comptime_assert` + `::` over `assert` + `:=`
/// (mirrors `fnType.return.isCompileTimeOnly`). `returns_unit` suppresses the
/// return binding (a `void result = ...` would be invalid C).
/// Returns `body` unchanged when there are no contracts, or when the body's
/// verification mode is not `runtime` (`ignore` erases the clauses —
/// `pragma(Pragma.NoContracts);`, mirrors contracts.ts:406-409 — and `verify`
/// suppresses the splice because the proof replaces the asserts).
wrap_function_body_with_contracts :: (
  fn(
    body : AstExpr,
    requires_exprs : ArrayList(AstExpr),
    ensures_exprs : ArrayList(AstExpr),
    return_label : Option(String),
    is_comptime_fn : bool,
    returns_unit : bool
  ) -> AstExpr
)({
  if((requires_exprs.len() == usize(0)) && (ensures_exprs.len() == usize(0)), {
    return(body);
  });
  body_tok := ast_expr_token(body);
  // V3 mode dispatch (plans/backlog/FORMAL_VERIFICATION.md §"The
  // assert-splice interaction"). Effects apply only when this module is a
  // VERIFICATION TARGET (the `yo verify` file set): a non-target file — the
  // prelude, an imported dependency — keeps today's runtime behavior even
  // under a CLI override, so its un-verified contracts never lose their
  // asserts.
  if(_is_verify_target(body_tok.module_path.clone()), {
    mode := resolve_verify_mode(body_tok.module_path.clone());
    // `ignore` (the `pragma(Pragma.NoContracts);` mode, or the CLI
    // override) — erase contract clauses entirely. Mirrors contracts.ts:406-409.
    if(mode == "ignore", {
      return(body);
    });
    // `verify` — suppress the splice entirely: the verifier consumes the
    // predicates from the fn-type side tables and the emitted code carries
    // no runtime asserts (the proof replaces them). The predicates were
    // still type-checked at signature evaluation, so malformed ones error.
    // `verify+` keeps the splice here; the strip pass for PROVED predicates
    // is V3 task 6.
    if(mode == "verify", {
      return(body);
    });
  });
  assert_fn_name := cond(
    is_comptime_fn => String.from(BF_COMPTIME_ASSERT),
    true => String.from("assert")
  );
  bind_op := cond(is_comptime_fn => String.from("::"), true => String.from(":="));
  // Phase V1 (decision D3): the binding the wrapper threads the return value
  // under — the user's label when present, else the unspeakable internal name.
  ret_name := match(
    return_label,
    .Some(label) => label,
    .None => String.from(__YO_CONTRACT_RESULT)
  );
  // requires asserts. `clone_expr_fresh_ids` gives each spliced predicate its
  // own node ids: yo-self keys ExprInfo by node id (expr.yo:307-313), so
  // reusing the signature's nodes would alias table entries across
  // specializations. TS gets fresh `$` slots for free from object identity.
  requires_asserts := ArrayList(AstExpr).new();
  (ri : usize) = usize(0);
  while(ri < requires_exprs.len(), {
    match(
      requires_exprs.get(ri),
      .Some(p) => {
        requires_asserts.push(
          _build_assert_call(
            clone_expr_fresh_ids(p.clone()),
            p,
            String.from("requires failed"),
            assert_fn_name.clone()
          )
        );
      },
      .None => ()
    );
    ri = (ri + usize(1));
  });
  begin_atom := _synth_atom(String.from(BK_BEGIN), TokenKind.Identifier, body_tok.clone());
  // No ensures: prepend the requires asserts to the body.
  if(ensures_exprs.len() == usize(0), {
    new_args := ArrayList(AstExpr).new();
    (ai : usize) = usize(0);
    while(ai < requires_asserts.len(), {
      match(
        requires_asserts.get(ai),
        .Some(a) => {
          new_args.push(a);
        },
        .None => ()
      );
      ai = (ai + usize(1));
    });
    if(ast_expr_is_fn_call_of(body, BK_BEGIN, Option(usize).None), {
      body_args := match(
        body,
        .FnCall(_, _, ba, _, _) => ba,
        .Atom(_, _) => ArrayList(AstExpr).new()
      );
      (bi : usize) = usize(0);
      while(bi < body_args.len(), {
        match(
          body_args.get(bi),
          .Some(a) => {
            new_args.push(a);
          },
          .None => ()
        );
        bi = (bi + usize(1));
      });
    }, {
      new_args.push(body);
    });
    return(
      AstExpr.FnCall(alloc_global_expr_id(), begin_atom, new_args, false, body_tok.clone())
    );
  });
  // Ensures present: hoist `old(...)` snapshots, then build the wrapped body.
  snapshots := ArrayList(AstExpr).new();
  ensures_asserts := ArrayList(AstExpr).new();
  (ei : usize) = usize(0);
  while(ei < ensures_exprs.len(), {
    match(
      ensures_exprs.get(ei),
      .Some(p) => {
        rewritten := _hoist_old_in(clone_expr_fresh_ids(p.clone()), snapshots, bind_op.clone());
        if(return_label.is_none(), {
          // Phase V1: unlabeled return — register the spliced predicate's
          // atom ids so an unbound-name failure can carry the
          // label-the-return hint. (Unit returns never reach here with a
          // label reference; that case is rejected at signature evaluation.)
          _note_unlabeled_ensures_atoms(rewritten);
        });
        // label_pred is the ORIGINAL predicate (still shows `old(...)`).
        ensures_asserts.push(
          _build_assert_call(
            rewritten,
            p,
            String.from("ensures failed"),
            assert_fn_name.clone()
          )
        );
      },
      .None => ()
    );
    ei = (ei + usize(1));
  });
  out_args := ArrayList(AstExpr).new();
  (si : usize) = usize(0);
  while(si < snapshots.len(), {
    match(
      snapshots.get(si),
      .Some(a) => {
        out_args.push(a);
      },
      .None => ()
    );
    si = (si + usize(1));
  });
  (qi : usize) = usize(0);
  while(qi < requires_asserts.len(), {
    match(
      requires_asserts.get(qi),
      .Some(a) => {
        out_args.push(a);
      },
      .None => ()
    );
    qi = (qi + usize(1));
  });
  if(returns_unit, {
    // Unit return: the return value is not nameable and
    // `void result = ...` is invalid C. Run the body as a statement, then
    // the ensures asserts.
    out_args.push(body);
  }, {
    out_args.push(
      _build_binding(
        ret_name.clone(),
        body,
        body_tok.clone(),
        bind_op.clone()
      )
    );
  });
  (fi : usize) = usize(0);
  while(fi < ensures_asserts.len(), {
    match(
      ensures_asserts.get(fi),
      .Some(a) => {
        out_args.push(a);
      },
      .None => ()
    );
    fi = (fi + usize(1));
  });
  if(!returns_unit, {
    out_args.push(
      _synth_atom(ret_name.clone(), TokenKind.Identifier, body_tok.clone())
    );
  });
  AstExpr.FnCall(alloc_global_expr_id(), begin_atom, out_args, false, body_tok.clone())
});
export(evaluate_requires, evaluate_ensures, evaluate_invariant, evaluate_decreases, evaluate_ghost);
export(evaluate_ghost_fn, evaluate_old);
export(wrap_function_body_with_contracts);
export(
  VerifyTask,
  set_verify_mode_override,
  set_verify_target_paths,
  _is_verify_target,
  resolve_verify_mode,
  register_verify_task,
  evaluated_for_verify,
  take_verify_tasks,
  strip_proved_ensures_asserts
);
