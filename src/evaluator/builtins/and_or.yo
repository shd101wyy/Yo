//! evaluator/builtins/and_or — implements evaluate_and_or.
//!
//! Handles short-circuit evaluation of `&&` and `||` operations.
//! - Empty and → true; empty or → false.
//! - Short-circuits on definitive compile-time values.
//! - Returns unknown if any unknown values are encountered without short-circuit.
//! - Returns undefined (runtime) value if any runtime values are encountered.
{ String } :: import("std/string");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  ast_expr_is_fn_call_of,
  BK_OP_AND,
  BK_OP_OR
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  expr_info_adopt_env
} :: import("../../expr_info.yo");
{ Environment, snapshot_env } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{
  EvalValue,
  is_bool_val,
  is_unknown_val,
  create_unknown_val,
  is_runtime_only_unknown_val
} :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_bool } :: import("../../types/creators.yo");
{ is_bool_type } :: import("../../types/guards.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
evaluate_and_or :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  is_and := ast_expr_is_fn_call_of(expr, BK_OP_AND, .None);
  // "and" for &&, "or" for ||
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  // Empty and → true, empty or → false.
  if(args.len() == usize(0), {
    bool_result := is_and;
    out_info := new_expr_info(env, t_bool());
    out_info.value = .Some(EvalValue.BoolVal(bool_result));
    expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_info);
    return(expr);
  });
  // Short-circuiting evaluation.
  (cur_env : Environment) = env;
  // `short_circuit` is the operand value that decided the result (`false`
  // for `&&`, `true` for `||`) when it came before every runtime operand.
  // A compile-time IDENTITY operand (`true` for `&&`, `false` for `||`)
  // decides nothing: it never sets a value, so `true && flag` stays a
  // runtime value (issues/fixed/comptime-identity-operand-folds-and-or-to-a-constant.md).
  (short_circuit : Option(bool)) = .None;
  (has_unknown : bool) = false;
  (has_runtime : bool) = false;
  (i : usize) = usize(0);
  while(i < args.len(), {
    arg_opt := args.get(i);
    i = (i + usize(1));
    match(
      arg_opt,
      .None => {},
      .Some(arg) => {
        evaluated_arg := evaluate_expression_raw(&arg, &cur_env, ctx, exn);
        arg_info_opt := expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&evaluated_arg));
        arg_info := match(
          arg_info_opt,
          .Some(ai) => ai,
          .None => {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(&arg),
                  `Expected bool type for "${if(is_and, String.from("and"), String.from("or"))}" argument, got:\n${ast_expr_to_string(&arg)}`
                )
              )
            );
            new_expr_info(env, t_bool())
          }
        );
        if(!is_bool_type(&arg_info.ty), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(&arg),
                `Expected bool type for "${if(is_and, String.from("and"), String.from("or"))}" argument, got:\n${ast_expr_to_string(&arg)}`
              )
            )
          );
        });
        cur_env = expr_info_adopt_env(&arg_info);
        arg_val_opt := arg_info.value;
        match(
          arg_val_opt,
          .None => {
            // Runtime value — can't determine at compile time.
            has_runtime = true;
          },
          .Some(av) => {
            if(is_unknown_val(&av), {
              // A RUNTIME-ONLY unknown (create_runtime_unknown_val) — classify it as
              // RUNTIME. Folding it into `has_unknown` made the `||`/`&&`
              // result an UNMARKED unknown, which downstream comptime
              // overloads accept: `!((prev == key) || ...)` then preferred
              // `comptime_not` and codegen called an unemitted comptime fn
              // (tests/codegen-bootstrap/short_circuit_rc_temp_drop.yo).
              if(is_runtime_only_unknown_val(&av), {
                has_runtime = true;
              }, {
                has_unknown = true;
              });
            }, {
              if(is_bool_val(&av), {
                bv := match(av, .BoolVal(b) => b, _ => false);
                // `false && …` / `true || …` short-circuits: the operands
                // after it never run. A runtime operand BEFORE it still runs
                // (codegen emits it ahead of the constant), so the result is
                // a compile-time value only when no runtime operand came first
                // (issues/fixed/and-or-short-circuit-after-a-runtime-operand-drops-its-side-effects.md).
                if(bv != is_and, {
                  if(!has_runtime, {
                    short_circuit = .Some(bv);
                  });
                  i = args.len();
                });
              }, {
                // Runtime value.
                has_runtime = true;
              });
            });
          }
        );
      }
    );
  });
  // Determine final result.
  (final_val : Option(EvalValue)) = match(
    short_circuit,
    .Some(b) => .Some(EvalValue.BoolVal(b)),
    .None => cond(
      has_runtime => .None,
      has_unknown => .Some(create_unknown_val(t_bool())),
      // Every operand was a compile-time identity.
      true => .Some(EvalValue.BoolVal(is_and))
    )
  );
  out_info := new_expr_info(&cur_env, t_bool());
  out_info.value = final_val;
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_info);
  expr
});
export(evaluate_and_or);
