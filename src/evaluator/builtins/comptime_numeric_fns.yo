//! evaluator/builtins/comptime_numeric_fns.
//!
//! Implements evaluate_yo_comptime_numeric_functions, which handles all
//! compile-time arithmetic, comparison, bitwise, and unary operations on
//! all numeric types: comptime_int, comptime_float, i8/u8, i16/u16,
//! i32/u32, i64/u64, isize/usize, f32/f64.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  expr_info_adopt_env
} :: import("../../expr_info.yo");
{ Environment, snapshot_env } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, create_unknown_val } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_bool, t_comptime_int, t_comptime_string } :: import("../../types/creators.yo");
{
  is_unsigned_integer_type,
  is_c_compatible_type,
  is_float_type,
  is_comptime_float_type,
  is_comptime_int_type
} :: import("../../types/guards.yo");
{ format_error_message, with_code } :: import("../../error.yo");
{ E_COMPTIME_DIVISION_BY_ZERO } :: import("../../diagnostics.yo");
{ type_to_string } :: import("../../types/string.yo");
{ IntRange, get_integer_type_range, get_integer_type_bits, target_integer_type_range, get_target_pointer_size_bits } :: import("../../types/utils.yo");
{ Token } :: import("../../token.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ parse_raw_int, parse_raw_float, f64_raw_roundtrip } :: import("../utils.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// str_lit_quote: wrap an unquoted string with double-quote chars.
// ---------------------------------------------------------------------------
str_lit_quote :: (fn(s : String) -> String)(
  String.from("\"") + s + String.from("\"")
);
// ---------------------------------------------------------------------------
// apply_bounds: clamp i64 to the representable range of type `ty`.
// ---------------------------------------------------------------------------
apply_bounds :: (fn(n : i64, ty : TypeValue) -> i64)(
  // Two's-complement WRAP to the type's width — the run-time semantics of
  // every operation that can leave the range without trapping (a left shift
  // drops the bits it shifts out). It used to CLAMP signed values and take
  // `|n| mod 2^w` for unsigned ones, so `i32(1) << 31` folded to i32::MAX
  // where the run time computes i32::MIN
  // (issues/fixed/comptime-integer-folding-clamps-instead-of-wrapping.md).
  // The trapping cases (add/sub/mul overflow, a shift count out of range,
  // `-MIN`, `MIN / -1`) are rejected BEFORE the value is built.
  match(
    comptime_int_width(ty),
    .Some(w) => if(w >= u32(64), n, {
      span := (i64(1) << i64(w));
      m := (n & (span - i64(1)));
      signed := match(target_integer_type_range(ty), .Some(r) => (r.min < i64(0)), .None => false);
      if(signed && (m >= (span >> i64(1))), m - span, m)
    }),
    .None => n
  )
);
/// The bit width of a fixed-width integer type at the target (usize/isize
/// follow the target's pointer width); `.None` for `comptime_int` and
/// non-integers.
comptime_int_width :: (fn(ty : TypeValue) -> Option(u32))(
  match(
    ty,
    .Int(bits, _) => Option(u32).Some(u32(bits)),
    .Usize => Option(u32).Some(get_target_pointer_size_bits()),
    .Isize => Option(u32).Some(get_target_pointer_size_bits()),
    _ => Option(u32).None
  )
);
/// `MIN / -1` and `MIN % -1` trap at run time (the quotient does not fit),
/// so on constants they are compile errors; the fold used to clamp the
/// quotient (or trap inside the compiler for i64::MIN).
_reject_min_by_minus_one :: (fn(a : i64, b : i64, ty : TypeValue, unsigned_64 : bool, tok : Token, exn : Exception) -> unit)({
  mn := match(
    target_integer_type_range(ty),
    .Some(r) => if(r.min < i64(0), Option(i64).Some(r.min), Option(i64).None),
    .None => if(is_comptime_int_type(ty), Option(i64).Some(i64.MIN), Option(i64).None)
  );
  match(
    mn,
    .Some(m) => if(!unsigned_64 && (a == m) && (b == i64(-1)), {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            `Integer overflow in compile-time evaluation: ${a.to_string()} / -1 does not fit in ${type_to_string(ty)}`
          )
        )
      );
    }),
    .None => ()
  );
});
// ---------------------------------------------------------------------------
// bit_not_int: bitwise NOT for integer types.
// For types narrower than 64 bits, XOR with the type mask and sign-extend.
// For 64-bit and comptime_int, uses the identity ~n = -(n+1). The add and
// the negation wrap (n = i64.MIN is a live u64 bit pattern), so both legs
// go through the wrapping_* generic instead of raw `0 - n - 1`.
// ---------------------------------------------------------------------------
bit_not_int :: (fn(n : i64, ty : TypeValue) -> i64)(
  match(
    ty,
    .ComptimeInt => i64(0).wrapping_sub(n.wrapping_add(i64(1))),
    .Usize => i64(0).wrapping_sub(n.wrapping_add(i64(1))),
    .Isize => i64(0).wrapping_sub(n.wrapping_add(i64(1))),
    .Int(bits, signed) => cond(
      (bits == u8(8)) => {
        n_lower := (n & i64(255));
        result_u := (n_lower ^ i64(255));
        if(
          signed && (result_u >= i64(128)),
          result_u - i64(256),
          result_u
        )
      },
      (bits == u8(16)) => {
        n_lower := (n & i64(65535));
        result_u := (n_lower ^ i64(65535));
        if(
          signed && (result_u >= i64(32768)),
          result_u - i64(65536),
          result_u
        )
      },
      (bits == u8(32)) => {
        n_lower := (n & i64(4294967295));
        result_u := (n_lower ^ i64(4294967295));
        if(
          signed && (result_u >= i64(2147483648)),
          result_u - i64(4294967296),
          result_u
        )
      },
      true => i64(0).wrapping_sub(n.wrapping_add(i64(1)))
    ),
    _ => i64(0).wrapping_sub(n.wrapping_add(i64(1)))
  )
);
// ---------------------------------------------------------------------------
// make_int_val: create IntLit after applying bounds, or UnknownVal for
// C-compatible types.
// ---------------------------------------------------------------------------
make_int_val :: (fn(n : i64, ty : TypeValue) -> EvalValue)(
  if(
    is_c_compatible_type(ty),
    create_unknown_val(ty),
    EvalValue.IntLit(apply_bounds(n, ty).to_string())
  )
);
// ---------------------------------------------------------------------------
// _i64_op_wrapped: `true` when the i64 arithmetic for `a <op> b` itself wrapped,
// so the EXACT mathematical result is not representable in the i64 used for
// comptime integers. The wrap has to be detected
// explicitly before the range comparison — otherwise `i64(1000000000000) *
// i64(250000000000)` (exact result 2.5e23) folds to a wrapped in-range value
// and the overflow goes unreported.
// ---------------------------------------------------------------------------
_i64_op_wrapped :: (fn(a : i64, b : i64, op_s : String) -> bool)(
  cond(
    (op_s == "add") => cond(
      (b > i64(0)) => (a > (i64.MAX - b)),
      (b < i64(0)) => (a < (i64.MIN - b)),
      true => false
    ),
    (op_s == "sub") => cond(
      (b < i64(0)) => (a > (i64.MAX + b)),
      (b > i64(0)) => (a < (i64.MIN + b)),
      true => false
    ),
    (a == i64(0)) => false,
    (b == i64(0)) => false,
    // The MIN/-1 shapes: wrapping_mul alone cannot see them (the sign test
    // below misreads MIN*2 wrapping to 0, and MIN*(-1) wraps to MIN).
    (a == i64.MIN) => (b != i64(1)),
    (b == i64.MIN) => (a != i64(1)),
    // The division probe `(a * b) / a != b` formed the overflowing product
    // and could divide MIN by -1 — both trap under safe-mode arithmetic.
    // The sign test detects the same wrap with wrapping_mul only: for
    // same-sign operands the wrapped product is negative exactly when the
    // exact product left the range, and for mixed signs it is non-negative.
    ((a < i64(0)) == (b < i64(0))) => (a.wrapping_mul(b) < i64(0)),
    true => (a.wrapping_mul(b) >= i64(0))
  )
);
// ---------------------------------------------------------------------------
// check_int_overflow: reject an add/sub/mul whose result leaves `ty`'s range.
// Types with no integer range — floats and the unbounded `comptime_int` — are
// skipped. Without this check the value silently CLAMPED via
// `apply_bounds`, so `prod :: (i8(50) * i8(25))` was accepted and every
// `comptime_expect_error(...)` wrapped around an overflowing operation failed
// with "Expected compile error, but the expression was evaluated successfully"
// (tests/comptime.test.yo arms 2-5 / 8-11).
// ---------------------------------------------------------------------------
check_int_overflow :: (
  fn(
    value : i64,
    ty : TypeValue,
    op_s : String,
    a : i64,
    b : i64,
    token : Token,
    exn : Exception
  ) -> unit
)({
  rng := match(
    get_integer_type_range(ty),
    .Some(r) => r,
    .None => {
      return(());
    }
  );
  // u64 / usize: comptime integers are carried as i64, so every value above
  // i64::MAX is a NEGATIVE i64 BIT PATTERN (`usize.MAX`, hash constants). Both
  // signed tests below are meaningless there — `u64(9223372036854775807) +
  // u64(1000)` is a valid u64 result that signed-wraps, and `usize.MAX` reads
  // as `-1 < min` — so redo the test in the UNSIGNED domain on the patterns.
  is_unsigned_64 := (is_unsigned_integer_type(ty) && match(get_integer_type_bits(ty), .Some(bw) => (bw == u32(64)), .None => false));
  if(is_unsigned_64, {
    ua := u64(a);
    ub := u64(b);
    uv := u64(value);
    u_over := cond(
      (op_s == "add") => (uv < ua),
      (op_s == "sub") => (ua < ub),
      (ua == u64(0)) => false,
      true => ((uv / ua) != ub)
    );
    if(u_over, {
      u_symbol := cond(
        (op_s == "mul") => String.from("*"),
        (op_s == "add") => String.from("+"),
        true => String.from("-")
      );
      exn.throw(
        dyn(
          format_error_message(
            token,
            `Integer overflow in compile-time evaluation
  ${ua.to_string()} ${u_symbol} ${ub.to_string()} = ${uv.to_string()}
  Result ${uv.to_string()} exceeds ${type_to_string(ty)} range [0, ${rng.max.to_string()}]`
          )
        )
      );
    });
    return(());
  });
  out_of_range := cond(
    _i64_op_wrapped(a, b, op_s.clone()) => true,
    (value < rng.min) => true,
    (value >= i64(0)) => (u64(value) > rng.max),
    true => false
  );
  if(out_of_range, {
    op_symbol := cond(
      (op_s == "mul") => String.from("*"),
      (op_s == "add") => String.from("+"),
      true => String.from("-")
    );
    exn.throw(
      dyn(
        format_error_message(
          token,
          `Integer overflow in compile-time evaluation
  ${a.to_string()} ${op_symbol} ${b.to_string()} = ${value.to_string()}
  Result ${value.to_string()} exceeds ${type_to_string(ty)} range [${rng.min.to_string()}, ${rng.max.to_string()}]`
        )
      )
    );
  });
});
// ---------------------------------------------------------------------------
// make_float_val: create FloatLit, or UnknownVal for C-compatible types.
// ---------------------------------------------------------------------------
make_float_val :: (fn(v : f64, ty : TypeValue) -> EvalValue)(
  if(
    is_c_compatible_type(ty),
    create_unknown_val(ty),
    // ROUND-TRIP rendering — see f64_raw_roundtrip (utils.yo): plain
    // to_string is %g and truncated computed comptime floats to 6 digits.
    EvalValue.FloatLit(f64_raw_roundtrip(v))
  )
);
// ---------------------------------------------------------------------------
// eval_numeric_arg: evaluate one argument expression and return its ExprInfo.
// ---------------------------------------------------------------------------
eval_numeric_arg :: (
  fn(
    arg : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> ExprInfo
)({
  evaluated := evaluate_expression(arg, env, ctx);
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg),
            `Expected numeric value for comptime numeric argument, got:\n${ast_expr_to_string(arg)}`
          )
        )
      );
      new_expr_info(env, t_comptime_int())
    }
  )
});
// ---------------------------------------------------------------------------
// evaluate_yo_comptime_numeric_functions — main entry point.
// ---------------------------------------------------------------------------
evaluate_yo_comptime_numeric_functions :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  // ---- 1. Extract the function name. -------------------------------------
  fn_name := match(
    expr,
    .FnCall(_, func_box, _, _, _) => match(
      func_box,
      .Atom(_, ftok) => ftok.value,
      _ => String.new()
    ),
    _ => String.new()
  );
  // ---- 2. Determine the numeric type and prefix length. ------------------
  (numeric_type : TypeValue) = TypeValue.ComptimeInt;
  (prefix_len : usize) = usize(0);
  cond(
    fn_name.starts_with(`__yo_comptime_usize_`) => {
      numeric_type = TypeValue.Usize;
      prefix_len = usize(20);
    },
    fn_name.starts_with(`__yo_comptime_isize_`) => {
      numeric_type = TypeValue.Isize;
      prefix_len = usize(20);
    },
    fn_name.starts_with(`__yo_comptime_float_`) => {
      numeric_type = TypeValue.ComptimeFloat;
      prefix_len = usize(20);
    },
    fn_name.starts_with(`__yo_comptime_u16_`) => {
      numeric_type = TypeValue.Int(u8(16), false);
      prefix_len = usize(18);
    },
    fn_name.starts_with(`__yo_comptime_i16_`) => {
      numeric_type = TypeValue.Int(u8(16), true);
      prefix_len = usize(18);
    },
    fn_name.starts_with(`__yo_comptime_u32_`) => {
      numeric_type = TypeValue.Int(u8(32), false);
      prefix_len = usize(18);
    },
    fn_name.starts_with(`__yo_comptime_i32_`) => {
      numeric_type = TypeValue.Int(u8(32), true);
      prefix_len = usize(18);
    },
    fn_name.starts_with(`__yo_comptime_u64_`) => {
      numeric_type = TypeValue.Int(u8(64), false);
      prefix_len = usize(18);
    },
    fn_name.starts_with(`__yo_comptime_i64_`) => {
      numeric_type = TypeValue.Int(u8(64), true);
      prefix_len = usize(18);
    },
    fn_name.starts_with(`__yo_comptime_int_`) => {
      numeric_type = TypeValue.ComptimeInt;
      prefix_len = usize(18);
    },
    fn_name.starts_with(`__yo_comptime_f32_`) => {
      numeric_type = TypeValue.Float(u8(32));
      prefix_len = usize(18);
    },
    fn_name.starts_with(`__yo_comptime_f64_`) => {
      numeric_type = TypeValue.Float(u8(64));
      prefix_len = usize(18);
    },
    fn_name.starts_with(`__yo_comptime_u8_`) => {
      numeric_type = TypeValue.Int(u8(8), false);
      prefix_len = usize(17);
    },
    fn_name.starts_with(`__yo_comptime_i8_`) => {
      numeric_type = TypeValue.Int(u8(8), true);
      prefix_len = usize(17);
    },
    true => ()
  );
  // ---- 3. Extract operation name. ----------------------------------------
  op := fn_name.substring(prefix_len, fn_name.len());
  op_s := op.clone();
  // ---- 4. Extract args. --------------------------------------------------
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  // ---- 5. Unary operations (neg, bit_not, to_comptime_string). -----------
  is_unary := ((op_s == "neg") || (op_s == "bit_not") || (op_s == "to_comptime_string"));
  if(is_unary, {
    arg0 := match(
      args.get(usize(0)),
      .Some(a) => a,
      .None => {
        return(expr);
      }
    );
    lhs_info := eval_numeric_arg(arg0, env, ctx, exn);
    lhs_val := lhs_info.value;
    (cur_env : Environment) = expr_info_adopt_env(lhs_info);
    (result_val : EvalValue) = EvalValue.UnitVal;
    (result_ty : TypeValue) = numeric_type;
    cond(
      (op_s == "neg") => {
        if(is_unsigned_integer_type(numeric_type), {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr),
                `Cannot apply negation to unsigned type: ${fn_name}`
              )
            )
          );
        }, {
          result_val = match(
            lhs_val,
            .Some(av) => cond(
              // `__yo_comptime_float_neg` carries numeric_type = ComptimeFloat,
              // which `is_float_type` (.Float only) misses — the FloatLit arg
              // then fell into the integer branch's `_ =>` and produced an
              // UNKNOWN (runtime) value, so `X :: f64(-(50.75))` was rejected
              // with "Got runtime value"; branch on the VALUE, not the type.
              (is_float_type(numeric_type) || is_comptime_float_type(numeric_type)) => match(
                av,
                .FloatLit(raw) => match(
                  parse_raw_float(raw),
                  .Some(v) => make_float_val(f64(0.0) - v, numeric_type),
                  .None => create_unknown_val(numeric_type)
                ),
                _ => create_unknown_val(numeric_type)
              ),
              true => match(
                av,
                .IntLit(raw) => match(
                  parse_raw_int(raw),
                  .Some(n) => {
                    // `-MIN` traps at run time; on a constant it is a compile
                    // error (it used to fold to MIN again, or clamp).
                    neg_min := match(
                      target_integer_type_range(numeric_type),
                      .Some(r) => ((r.min < i64(0)) && (n == r.min)),
                      .None => (is_comptime_int_type(numeric_type) && (n == i64.MIN))
                    );
                    if(neg_min, {
                      exn.throw(
                        dyn(
                          format_error_message(
                            ast_expr_token(expr),
                            `Integer overflow in compile-time evaluation: -(${raw}) does not fit in ${type_to_string(numeric_type)}`
                          )
                        )
                      );
                    });
                    make_int_val(i64(0).wrapping_sub(n), numeric_type)
                  },
                  .None => create_unknown_val(numeric_type)
                ),
                _ => create_unknown_val(numeric_type)
              )
            ),
            .None => create_unknown_val(numeric_type)
          );
        });
      },
      (op_s == "bit_not") => {
        result_val = match(
          lhs_val,
          .Some(av) => match(
            av,
            .IntLit(raw) => match(
              parse_raw_int(raw),
              .Some(n) => make_int_val(bit_not_int(n, numeric_type), numeric_type),
              .None => create_unknown_val(numeric_type)
            ),
            _ => create_unknown_val(numeric_type)
          ),
          .None => create_unknown_val(numeric_type)
        );
      },
      (op_s == "to_comptime_string") => {
        result_ty = t_comptime_string();
        result_val = match(
          lhs_val,
          .Some(av) => match(
            av,
            .IntLit(raw) => EvalValue.StrLit(str_lit_quote(raw)),
            .FloatLit(raw) => EvalValue.StrLit(str_lit_quote(raw)),
            _ => create_unknown_val(t_comptime_string())
          ),
          .None => create_unknown_val(t_comptime_string())
        );
      },
      true => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(expr),
              `Unexpected unary comptime numeric operation: ${op}`
            )
          )
        );
      }
    );
    out_info := new_expr_info(cur_env, result_ty);
    out_info.value = .Some(result_val);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  }, {
    // ---- 6. Binary operations. -------------------------------------------
    arg0 := match(
      args.get(usize(0)),
      .Some(a) => a,
      .None => {
        return(expr);
      }
    );
    arg1 := match(
      args.get(usize(1)),
      .Some(a) => a,
      .None => {
        return(expr);
      }
    );
    lhs_info := eval_numeric_arg(arg0, env, ctx, exn);
    rhs_info := eval_numeric_arg(arg1, lhs_info.env, ctx, exn);
    lhs_val := lhs_info.value;
    rhs_val := rhs_info.value;
    (cur_env : Environment) = expr_info_adopt_env(rhs_info);
    (result_val : EvalValue) = EvalValue.UnitVal;
    (result_ty : TypeValue) = numeric_type;
    // ComptimeFloat must take the float path too — same `is_float_type`
    // gap as the unary-neg note above: every `__yo_comptime_float_*`
    // binary op otherwise fell into the integer branch and yielded
    // unknowns ("Got runtime value" on `X :: (a + b)` comptime floats).
    if(is_float_type(numeric_type) || is_comptime_float_type(numeric_type), {
      // ---- Float binary path. --------------------------------------------
      lhs_f := match(
        lhs_val,
        .Some(av) => match(
          av,
          .FloatLit(raw) => parse_raw_float(raw),
          _ => Option(f64).None
        ),
        .None => Option(f64).None
      );
      rhs_f := match(
        rhs_val,
        .Some(av) => match(
          av,
          .FloatLit(raw) => parse_raw_float(raw),
          _ => Option(f64).None
        ),
        .None => Option(f64).None
      );
      cond(
        ((op_s == "add") || (op_s == "sub") || ((op_s == "mul") || (op_s == "div"))) => {
          match(
            lhs_f,
            .Some(a) => match(
              rhs_f,
              .Some(b) => {
                if((op_s == "div") && (b == f64(0.0)), {
                  exn.throw(
                    dyn(
                      with_code(
                        format_error_message(
                          ast_expr_token(arg1),
                          `Division by zero in compile-time evaluation: ${a.to_string()} / 0.0`
                        ),
                        E_COMPTIME_DIVISION_BY_ZERO
                      )
                    )
                  );
                });
                f_result := cond(
                  (op_s == "add") => (a + b),
                  (op_s == "sub") => (a - b),
                  (op_s == "mul") => (a * b),
                  true => (a / b)
                );
                result_val = make_float_val(f_result, numeric_type);
              },
              .None => {
                result_val = create_unknown_val(numeric_type);
              }
            ),
            .None => {
              result_val = create_unknown_val(numeric_type);
            }
          );
        },
        (
          (op_s == "eq") || (op_s == "neq") ||
            ((op_s == "lt") || (op_s == "lte") || ((op_s == "gt") || (op_s == "gte")))
        ) => {
          result_ty = t_bool();
          match(
            lhs_f,
            .Some(a) => match(
              rhs_f,
              .Some(b) => {
                b_result := cond(
                  (op_s == "eq") => (a == b),
                  (op_s == "neq") => !(a == b),
                  (op_s == "lt") => (a < b),
                  (op_s == "lte") => (a <= b),
                  (op_s == "gt") => (a > b),
                  true => (a >= b)
                );
                result_val = EvalValue.BoolVal(b_result);
              },
              .None => {
                result_val = create_unknown_val(t_bool());
              }
            ),
            .None => {
              result_val = create_unknown_val(t_bool());
            }
          );
        },
        (op_s == "mod") => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr),
                `Modulo operation not supported for floating point types: ${fn_name}`
              )
            )
          );
        },
        true => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr),
                `Unexpected binary comptime float operation: ${op}`
              )
            )
          );
        }
      );
    }, {
      // ---- Integer binary path. ------------------------------------------
      lhs_n := match(
        lhs_val,
        .Some(av) => match(
          av,
          .IntLit(raw) => parse_raw_int(raw),
          _ => Option(i64).None
        ),
        .None => Option(i64).None
      );
      rhs_n := match(
        rhs_val,
        .Some(av) => match(
          av,
          .IntLit(raw) => parse_raw_int(raw),
          _ => Option(i64).None
        ),
        .None => Option(i64).None
      );
      // Comptime integers are carried as `i64`, so a `u64`/`usize` value above
      // `i64.MAX` is a NEGATIVE bit pattern — `u64.MAX` is `-1`. This is the
      // same hazard the overflow check above already redoes in the unsigned
      // domain, and it applies to the OPERATIONS too.
      //
      // `add`/`sub`/`mul`, `eq`/`neq`, `shl` and the bitwise ops are
      // two's-complement identical in both domains and need no split.
      // DIVISION, MODULO, the ORDERING comparisons and the RIGHT SHIFT are
      // not: signed `-1 / 10` is `0`, `-1 % 10` is `-1`, `-1 > 1` is false and
      // `-1 >> 1` is `-1`, none of which are the `u64.MAX` answers.
      unsigned_64 := (
        is_unsigned_integer_type(numeric_type) && match(
          get_integer_type_bits(numeric_type),
          .Some(bw) => (bw == u32(64)),
          .None => false
        )
      );
      cond(
        ((op_s == "add") || (op_s == "sub") || (op_s == "mul")) => {
          match(
            lhs_n,
            .Some(a) => match(
              rhs_n,
              .Some(b) => {
                // The raw result is the i64 BIT PATTERN comptime integers are
                // carried in (u64 values above i64::MAX are negative
                // patterns), so add/sub/mul must WRAP here: the wrapping_*
                // generic keeps every intermediate in range, and
                // check_int_overflow below re-tests the pattern in the
                // unsigned domain for u64/usize.
                n_result := cond(
                  (op_s == "add") => a.wrapping_add(b),
                  (op_s == "sub") => a.wrapping_sub(b),
                  true => a.wrapping_mul(b)
                );
                // Check the EXACT result against the type's range before
                // building the value; `make_int_val` below only CLAMPS.
                check_int_overflow(n_result, numeric_type, op_s.clone(), a, b, ast_expr_token(expr), exn);
                result_val = make_int_val(n_result, numeric_type);
              },
              .None => {
                result_val = create_unknown_val(numeric_type);
              }
            ),
            .None => {
              result_val = create_unknown_val(numeric_type);
            }
          );
        },
        (op_s == "div") => {
          match(
            lhs_n,
            .Some(a) => match(
              rhs_n,
              .Some(b) => {
                if(b == i64(0), {
                  exn.throw(
                    dyn(
                      with_code(
                        format_error_message(
                          ast_expr_token(arg1),
                          `Division by zero in compile-time evaluation: ${cond(unsigned_64 => u64(a).to_string(), true => a.to_string())} / 0`
                        ),
                        E_COMPTIME_DIVISION_BY_ZERO
                      )
                    )
                  );
                });
                _reject_min_by_minus_one(a, b, numeric_type, unsigned_64, ast_expr_token(expr), exn);
                result_val = make_int_val(
                  cond(
                    unsigned_64 => i64(u64(a) / u64(b)),
                    true => (a / b)
                  ),
                  numeric_type
                );
              },
              .None => {
                result_val = create_unknown_val(numeric_type);
              }
            ),
            .None => {
              result_val = create_unknown_val(numeric_type);
            }
          );
        },
        (op_s == "mod") => {
          match(
            lhs_n,
            .Some(a) => match(
              rhs_n,
              .Some(b) => {
                if(b == i64(0), {
                  exn.throw(
                    dyn(
                      with_code(
                        format_error_message(
                          ast_expr_token(arg1),
                          `Remainder by zero in compile-time evaluation: ${cond(unsigned_64 => u64(a).to_string(), true => a.to_string())} % 0`
                        ),
                        E_COMPTIME_DIVISION_BY_ZERO
                      )
                    )
                  );
                });
                _reject_min_by_minus_one(a, b, numeric_type, unsigned_64, ast_expr_token(expr), exn);
                result_val = make_int_val(
                  cond(
                    unsigned_64 => i64(u64(a) % u64(b)),
                    true => (a % b)
                  ),
                  numeric_type
                );
              },
              .None => {
                result_val = create_unknown_val(numeric_type);
              }
            ),
            .None => {
              result_val = create_unknown_val(numeric_type);
            }
          );
        },
        (
          (op_s == "eq") || (op_s == "neq") ||
            ((op_s == "lt") || (op_s == "lte") || ((op_s == "gt") || (op_s == "gte")))
        ) => {
          result_ty = t_bool();
          match(
            lhs_n,
            .Some(a) => match(
              rhs_n,
              .Some(b) => {
                b_result := cond(
                  (op_s == "eq") => (a == b),
                  (op_s == "neq") => !(a == b),
                  unsigned_64 => cond(
                    (op_s == "lt") => (u64(a) < u64(b)),
                    (op_s == "lte") => (u64(a) <= u64(b)),
                    (op_s == "gt") => (u64(a) > u64(b)),
                    true => (u64(a) >= u64(b))
                  ),
                  (op_s == "lt") => (a < b),
                  (op_s == "lte") => (a <= b),
                  (op_s == "gt") => (a > b),
                  true => (a >= b)
                );
                result_val = EvalValue.BoolVal(b_result);
              },
              .None => {
                result_val = create_unknown_val(t_bool());
              }
            ),
            .None => {
              result_val = create_unknown_val(t_bool());
            }
          );
        },
        ((op_s == "bit_and") || (op_s == "bit_or") || (op_s == "bit_xor")) => {
          match(
            lhs_n,
            .Some(a) => match(
              rhs_n,
              .Some(b) => {
                n_result := cond(
                  (op_s == "bit_and") => (a & b),
                  (op_s == "bit_or") => (a | b),
                  true => (a ^ b)
                );
                result_val = make_int_val(n_result, numeric_type);
              },
              .None => {
                result_val = create_unknown_val(numeric_type);
              }
            ),
            .None => {
              result_val = create_unknown_val(numeric_type);
            }
          );
        },
        ((op_s == "shl") || (op_s == "shr")) => {
          match(
            lhs_n,
            .Some(a) => match(
              rhs_n,
              .Some(b) => {
                // The run-time rule: a shift count outside [0, width) traps,
                // so on constants it is a compile error — computing it here
                // CLAMPED (`i32(1) << 40` folded to i32::MAX), and a count
                // of 64 or more would trap inside the compiler itself. A
                // `comptime_int` is unbounded but carried as an i64, so a
                // left shift whose value leaves the i64 is rejected too.
                sh_w := match(comptime_int_width(numeric_type), .Some(w) => w, .None => u32(64));
                if((b < i64(0)) || (b >= i64(sh_w)), {
                  exn.throw(
                    dyn(
                      format_error_message(
                        ast_expr_token(expr),
                        `Integer overflow in compile-time evaluation: shift count ${b.to_string()} is out of range for ${type_to_string(numeric_type)} (0..${sh_w.to_string()})`
                      )
                    )
                  );
                });
                if((op_s == "shl") && is_comptime_int_type(numeric_type) && ((a != i64(0)) && (((a << b) >> b) != a)), {
                  exn.throw(
                    dyn(
                      format_error_message(
                        ast_expr_token(expr),
                        `Integer overflow in compile-time evaluation: ${a.to_string()} << ${b.to_string()} exceeds the compile-time integer range`
                      )
                    )
                  );
                });
                n_result := cond(
                  (op_s == "shl") => (a << b),
                  unsigned_64 => i64(u64(a) >> u64(b)),
                  true => (a >> b)
                );
                result_val = make_int_val(n_result, numeric_type);
              },
              .None => {
                result_val = create_unknown_val(numeric_type);
              }
            ),
            .None => {
              result_val = create_unknown_val(numeric_type);
            }
          );
        },
        true => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(expr),
                `Unexpected binary comptime integer operation: ${op}`
              )
            )
          );
        }
      );
    });
    out_info := new_expr_info(cur_env, result_ty);
    out_info.value = .Some(result_val);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  });
  expr
});
export(evaluate_yo_comptime_numeric_functions);
