//! Pragma handling for yo-self (mirrors `src/evaluator/builtins/pragma.ts`).
//!
//! The TS side runs a `preScanForSkipPrelude` pass before the
//! prelude is auto-loaded, so a file declaring
//! `pragma(Pragma.SkipPrelude);` at the top can opt out of the
//! implicit prelude import. src/evaluator/index.yo used to scan
//! for `// @skip_prelude` comment directives instead; this module
//! ports the AST-based scan so the two evaluators stay aligned.
//!
//! Scope: the SkipPrelude pre-scan that must run before the prelude
//! loads, plus the eval-time `evaluate_pragma` handler with the full
//! Phase-G argument validation (the argument is evaluated and must
//! yield a `Pragma` enum variant — typos, non-Pragma enums and
//! non-enum values are compile errors, mirroring TS).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ eprintln } :: import("std/fmt");
{ AstExpr, ast_expr_is_fn_call_of, ast_expr_token, ast_expr_id, ast_expr_to_string, BF_PRAGMA } :: import("../../expr.yo");
{ TokenKind } :: import("../../token.yo");
{ new_expr_info, expr_info_table_set, expr_info_table_get } :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ type_to_string } :: import("../../types/string.yo");
{ format_error_message } :: import("../../error.yo");
{ register_file_pragma } :: import("../memory_safety.yo");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
// Pragma kinds use the prelude's `Pragma` enum (auto-loaded), not a separate
// internal type — yo-self is self-hosted, so the compiler reuses the
// language's own `Pragma`. (TS keeps a distinct `Pragma` in
// `src/evaluator/memory-safety.ts`; here that collapses to `Pragma`.)
/// Map a `Pragma.X` variant name (as a `str`) to the corresponding
/// `Pragma`. Returns `.None` when the name doesn't match any
/// known variant — typo handling for full evaluation belongs in
/// `evaluatePragma`; the pre-scan just ignores unknown names.
pragma_kind_from_variant_name :: (fn(name : String) -> Option(Pragma))(
  cond(
    (name == "AllowUnsafe") => Option(Pragma).Some(.AllowUnsafe),
    (name == "AllowMacroDef") => Option(Pragma).Some(.AllowMacroDef),
    (name == "SkipPrelude") => Option(Pragma).Some(.SkipPrelude),
    (name == "SkipWasm") => Option(Pragma).Some(.SkipWasm),
    (name == "SkipWasm32Emscripten") => Option(Pragma).Some(.SkipWasm32Emscripten),
    (name == "SkipWasm32Wasi") => Option(Pragma).Some(.SkipWasm32Wasi),
    (name == "SkipWindows") => Option(Pragma).Some(.SkipWindows),
    // Formal-verification pragmas (Phase 0 of plans/FORMAL_VERIFICATION.md).
    // `NoContracts` is read by `wrap_function_body_with_contracts`;
    // `Verify`/`VerifyOrAssert` are registered only (the SMT verifier is a
    // later phase). Mirrors src/evaluator/builtins/pragma.ts:174-183.
    (name == "Verify") => Option(Pragma).Some(.Verify),
    (name == "VerifyOrAssert") => Option(Pragma).Some(.VerifyOrAssert),
    (name == "NoContracts") => Option(Pragma).Some(.NoContracts),
    true => Option(Pragma).None
  )
);
/// Recognise the `Pragma.X` argument shape in a pragma call. Yo
/// parses property access as a `.`-function call:
///   `Pragma.AllowUnsafe`  ==>  `.(Pragma, AllowUnsafe)`
/// Returns `.None` when the argument isn't of the expected
/// `Pragma.<variant>` form. The pre-scan is intentionally narrow:
/// no identifier resolution, no aliased imports. That's fine — full
/// evaluation in `evaluatePragma` handles the general case.
///
/// Mirrors `recognizePragmaArgByAstShape` in
/// `src/evaluator/builtins/pragma.ts`.
recognize_pragma_arg :: (fn(arg : AstExpr) -> Option(Pragma))(
  match(
    arg,
    .Atom(_, _) => Option(Pragma).None,
    .FnCall(_, func_box, args, _, _) => {
      is_dot := match(
        func_box,
        .Atom(_, tok) => (tok.kind == TokenKind.Dot),
        .FnCall(_, _, _, _, _) => false
      );
      if(!is_dot, return(Option(Pragma).None));
      if(args.len() != usize(2), return(Option(Pragma).None));
      lhs_is_pragma := match(
        args.get(usize(0)),
        .Some(lhs) => match(
          lhs,
          .Atom(_, tok) => (tok.value == "Pragma"),
          .FnCall(_, _, _, _, _) => false
        ),
        .None => false
      );
      if(!lhs_is_pragma, return(Option(Pragma).None));
      match(
        args.get(usize(1)),
        .Some(rhs) => match(
          rhs,
          .Atom(_, tok) => pragma_kind_from_variant_name(tok.value.clone()),
          .FnCall(_, _, _, _, _) => Option(Pragma).None
        ),
        .None => Option(Pragma).None
      )
    }
  )
);
/// Pre-evaluation scan for `pragma(Pragma.SkipPrelude);` over the
/// top level of `program`. Used by the `Evaluator` constructor to
/// decide whether to inject the prelude. Pragma calls nested inside
/// function bodies or blocks are not pre-scanned (they couldn't
/// affect prelude loading anyway).
///
/// Mirrors `preScanForSkipPrelude` in
/// `src/evaluator/builtins/pragma.ts`.
pre_scan_for_skip_prelude :: (fn(program : ArrayList(AstExpr)) -> bool)({
  found := false;
  i := usize(0);
  n := program.len();
  while((i < n) && !found, {
    match(
      program.get(i),
      .Some(expr) => {
        if(ast_expr_is_fn_call_of(expr, BF_PRAGMA, Option(usize).Some(usize(1))), {
          match(
            expr,
            .FnCall(_, _, args, _, _) => match(
              args.get(usize(0)),
              .Some(arg) => match(
                recognize_pragma_arg(arg),
                .Some(kind) => match(
                  kind,
                  .SkipPrelude => {
                    found = true;
                  },
                  _ => ()
                ),
                .None => ()
              ),
              .None => ()
            ),
            .Atom(_, _) => ()
          );
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// Files already warned about a not-yet-implemented verify-mode pragma,
/// keyed `<module_path>|<kind>`. Mirrors `warnedVerifyFiles` in
/// `src/evaluator/builtins/pragma.ts`.
(g_warned_verify_files : HashSet(String)) = HashSet(String).new();
/// One-time per-file warning for verify-mode pragmas that the verifier
/// doesn't yet honor. Phase 0 only — these warnings disappear when the
/// verifier lands in Phase 1. Mirrors `warnVerifyModeNotImplemented`.
warn_verify_mode_not_implemented :: (fn(module_path : String, kind_name : String) -> unit)({
  key := `${module_path}|${kind_name}`;
  if(g_warned_verify_files.contains(key.clone()), return(()));
  _added := g_warned_verify_files.insert(key);
  eprintln(
    `[warning] pragma(Pragma.${kind_name}) in ${module_path}: verify mode is not implemented yet (Phase 0 of plans/FORMAL_VERIFICATION.md). Contracts in this file will behave as if no pragma were set — they parse and (in later phases) lower to runtime asserts, but no proof obligations are generated.`
  );
});
/// Eval-time `pragma(...)` handler. Mirrors `evaluatePragma`
/// (`src/evaluator/builtins/pragma.ts`): the `SkipPrelude` AST shape
/// short-circuits (the file may not have `Pragma` in scope — that is exactly
/// what SkipPrelude implies); every other argument is EVALUATED and must
/// yield a `Pragma` enum variant, which catches typos
/// (`pragma(Pragma.AlloeUnsafe)`), non-Pragma enums (`pragma(Ordering.Less)`)
/// and non-enum values (`pragma(42)`) — all previously accepted silently by
/// the syntactic-only handler. The matched variant is registered in the
/// per-file pragma registry. Returns the expr annotated with a unit result.
evaluate_pragma :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  if(args.len() != usize(1), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected 1 arguments, got ${args.len()}:\n${ast_expr_to_string(expr)}`
        )
      )
    );
  });
  arg := match(args.get(usize(0)), .Some(a) => a, .None => expr);
  // Fast path: the pre-scan already recognized and registered
  // `pragma(Pragma.SkipPrelude);` by AST shape — skip evaluation entirely.
  // `AllowMacroDef` is ALSO handled by AST shape (registered here): it must
  // work inside `SkipPrelude` files (the internal evaluator tests define
  // macros in prelude-less snippets), where evaluating the argument cannot
  // resolve `Pragma`.
  skip_fast := match(
    recognize_pragma_arg(arg),
    .Some(k) => match(
      k,
      .SkipPrelude => true,
      .AllowMacroDef => {
        register_file_pragma(ast_expr_token(expr).module_path.clone(), Pragma.AllowMacroDef);
        true
      },
      _ => false
    ),
    .None => false
  );
  if(skip_fast, {
    out0 := new_expr_info(env, t_unit());
    out0.value = Option(EvalValue).Some(EvalValue.UnitVal);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out0);
    return(expr);
  });
  // Normal path: evaluate the argument, then check it's a Pragma enum
  // variant. Catches typos, misuse, and shadowed `Pragma` names.
  evaluated := evaluate_expression_raw(arg, env, ctx, exn);
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
  (arg_env : Environment) = env;
  (variant : Option(String)) = Option(String).None;
  (got_ty_str : String) = String.from("");
  match(
    info_opt,
    .None => exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg),
          `Failed to evaluate the argument of 'pragma(...)'.`
        )
      )
    ),
    .Some(info) => {
      arg_env = info.env;
      got_ty_str = type_to_string(info.ty);
      match(
        info.ty,
        .EnumT({ name, selected_variant_name }) => if(name == "Pragma", {
          variant = selected_variant_name.clone();
        }),
        _ => ()
      );
    }
  );
  match(
    variant,
    .None => exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg),
          `'pragma(...)' expects a 'Pragma.X' argument (e.g. 'pragma(Pragma.AllowUnsafe);'). Got value of type ${got_ty_str} from: ${ast_expr_to_string(arg)}`
        )
      )
    ),
    .Some(vname) => match(
      pragma_kind_from_variant_name(vname.clone()),
      .None => exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg),
            `Unknown 'Pragma' variant '${vname}'. The compiler does not recognize this pragma — make sure the prelude's 'Pragma' enum and 'evaluator/memory_safety.yo' agree on the set of supported variants.`
          )
        )
      ),
      .Some(kind) => {
        tok := ast_expr_token(expr);
        register_file_pragma(tok.module_path.clone(), kind);
        match(
          kind,
          .Verify => warn_verify_mode_not_implemented(tok.module_path.clone(), String.from("Verify")),
          .VerifyOrAssert => warn_verify_mode_not_implemented(tok.module_path.clone(), String.from("VerifyOrAssert")),
          _ => ()
        );
      }
    )
  );
  out := new_expr_info(arg_env, t_unit());
  out.value = Option(EvalValue).Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
  expr
});
export(pre_scan_for_skip_prelude, recognize_pragma_arg, evaluate_pragma);
