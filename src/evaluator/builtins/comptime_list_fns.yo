    first_val,
    .ComptimeListVal(first_elems) => match(
      second_val,
      .ComptimeListVal(second_elems) => {
        new_elems := ArrayList(EvalValue).new();
        (i1 : usize) = usize(0);
        n1 := first_elems.len();
        while(i1 < n1, {
          match(
            first_elems.get(i1),
            .Some(e) => {
              new_elems.push(e);
            },
            .None => ()
