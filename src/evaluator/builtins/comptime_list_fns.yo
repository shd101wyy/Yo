evaluate_yo_comptime_list_append :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  first_arg_e := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  second_arg_e := match(
    args.get(usize(1)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_first := evaluate_expression(first_arg_e, env, ctx);
  first_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_first)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
