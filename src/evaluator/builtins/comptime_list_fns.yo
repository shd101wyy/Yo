            .None
          )
        )
      );
      EvalValue.UnitVal
    }
  );
  eval_cdr := evaluate_expression(cdr_arg_e, cur_env, ctx);
  cdr_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_cdr)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
