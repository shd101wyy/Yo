          .None
        )
      )
    );
  });
  first_val := match(
    first_info.value,
    .Some(v) => v,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(first_arg_e),
            `Expected compile-time value for first argument of "${BF_YO_COMPTIME_LIST_APPEND}"`,
            false,
            .None
          )
        )
      );
      EvalValue.UnitVal
    }
  );
  eval_second := evaluate_expression(second_arg_e, cur_env, ctx);
  second_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_second)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(second_arg_e),
            `Failed to evaluate second argument for "${BF_YO_COMPTIME_LIST_APPEND}"`,
            false,
            .None
          )
        )
      );
      new_expr_info(cur_env, TypeValue.Unit)
    }
  );
  cur_env = second_info.env;
  if(!is_comptime_list_type(second_info.ty), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(second_arg_e),
          `Expected ComptimeList type for second argument of "${BF_YO_COMPTIME_LIST_APPEND}"`,
          false,
          .None
        )
      )
    );
  });
  second_val := match(
    second_info.value,
    .Some(v) => v,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(second_arg_e),
            `Expected compile-time value for second argument of "${BF_YO_COMPTIME_LIST_APPEND}"`,
            false,
            .None
          )
        )
      );
      EvalValue.UnitVal
    }
  );
  if(!are_types_compatible(first_info.ty, second_info.ty), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(first_arg_e),
          `Type mismatch between the two ComptimeList arguments of "${BF_YO_COMPTIME_LIST_APPEND}"`,
          false,
          .None
        )
      )
    );
  });
