//! evaluator/builtins/comptime_list_fns — full 1:1 port of comptime-list-fns.ts.
//!
//! 1:1 port of `src/evaluator/builtins/comptime-list-fns.ts`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  BF_YO_COMPTIME_LIST_CAR,
  BF_YO_COMPTIME_LIST_CDR,
  BF_YO_COMPTIME_LIST_CONS,
  BF_YO_COMPTIME_LIST_APPEND,
  BF_YO_COMPTIME_LIST_LENGTH,
  BF_YO_COMPTIME_LIST_ELEMENT_TYPE,
  BF_YO_COMPTIME_LIST_GET
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, create_unknown_val, create_unknown_val_with_name } :: import("../../value.yo");
{ random_id } :: import("../../utils.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_usize, t_type } :: import("../../types/creators.yo");
{ is_comptime_list_type } :: import("../../types/guards.yo");
{ are_types_compatible } :: import("../../types/compatibility.yo");
{ format_error_message } :: import("../../error.yo");
