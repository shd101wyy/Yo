  if(!is_comptime_list_type(first_info.ty), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(first_arg_e),
          `Expected ComptimeList type for first argument of "${BF_YO_COMPTIME_LIST_APPEND}"`,
