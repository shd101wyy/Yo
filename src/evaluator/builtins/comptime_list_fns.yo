{ Exception } :: import("std/error");
evaluate_yo_comptime_list_car :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg_e := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_arg := evaluate_expression(arg_e, env, ctx);
  info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_arg)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_e),
            `Failed to evaluate argument for "${BF_YO_COMPTIME_LIST_CAR}"`,
            false,
            .None
          )
        )
      );
      new_expr_info(env, TypeValue.Unit)
    }
  );
  (cur_env : Environment) = info.env;
  if(!is_comptime_list_type(info.ty), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_e),
          `Expected ComptimeList type for "${BF_YO_COMPTIME_LIST_CAR}" argument`,
          false,
          .None
        )
      )
    );
  });
  child_ty := match(info.ty, .ComptimeListT(cb) => cb, _ => TypeValue.Unit);
  list_val := match(
    info.value,
    .Some(v) => v,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_e),
            `Expected ComptimeList value for "${BF_YO_COMPTIME_LIST_CAR}" argument`,
            false,
            .None
          )
        )
      );
      EvalValue.UnitVal
    }
  );
  out_info := new_expr_info(cur_env, child_ty);
  // Named variant: promotes an unknown ELEMENT of a ComptimeList(Type) to
  // `TypeVal(SomeT)` — TS passes `__comptime_list_car_${randomId}` here
  // (comptime-list-fns.ts:80) and createUnknownValue returns a TypeValue
  // for Type-universe slots. Without it, `types.first()` on an unknown
  // variadic list yielded a bare UnknownVal that
  // `__yo_are_types_compatible` rejects (tests/variadic_comptime).
  car_unk_name := String.from("__comptime_list_car_");
  car_unk_name.push_string(random_id(env.module_path));
  out_info.value = .Some(create_unknown_val_with_name(child_ty, car_unk_name));
  match(
    list_val,
    .ComptimeListVal(elements) => {
      if(elements.len() > usize(0), {
        match(
          elements.get(usize(0)),
          .Some(first) => {
            out_info.value = .Some(first);
          },
          .None => ()
        );
      }, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg_e),
              `Unexpected empty ComptimeList for "${BF_YO_COMPTIME_LIST_CAR}" argument`,
              false,
              .None
            )
          )
        );
      });
    },
    _ => ()
  );
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
evaluate_yo_comptime_list_cdr :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg_e := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_arg := evaluate_expression(arg_e, env, ctx);
  info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_arg)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_e),
            `Failed to evaluate argument for "${BF_YO_COMPTIME_LIST_CDR}"`,
            false,
            .None
          )
        )
      );
      new_expr_info(env, TypeValue.Unit)
    }
  );
  (cur_env : Environment) = info.env;
  if(!is_comptime_list_type(info.ty), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_e),
          `Expected ComptimeList type for "${BF_YO_COMPTIME_LIST_CDR}" argument`,
          false,
          .None
        )
      )
    );
  });
  list_ty := info.ty;
  list_val := match(
    info.value,
    .Some(v) => v,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_e),
            `Expected ComptimeList value for "${BF_YO_COMPTIME_LIST_CDR}" argument`,
            false,
            .None
          )
        )
      );
      EvalValue.UnitVal
    }
  );
  out_info := new_expr_info(cur_env, list_ty);
  out_info.value = .Some(create_unknown_val(list_ty));
  match(
    list_val,
    .ComptimeListVal(elements) => {
      if(elements.len() > usize(0), {
        new_elems := ArrayList(EvalValue).new();
        (i : usize) = usize(1);
        n := elements.len();
        while(i < n, {
          match(
            elements.get(i),
            .Some(e) => {
              new_elems.push(e);
            },
            .None => ()
          );
          i = (i + usize(1));
        });
        out_info.value = .Some(EvalValue.ComptimeListVal(new_elems));
      }, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg_e),
              `Unexpected empty ComptimeList for "${BF_YO_COMPTIME_LIST_CDR}" argument`,
              false,
              .None
            )
          )
        );
      });
    },
    _ => ()
  );
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
