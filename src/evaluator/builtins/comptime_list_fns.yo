          i1 = (i1 + usize(1));
        });
        (i2 : usize) = usize(0);
        n2 := second_elems.len();
        while(i2 < n2, {
          match(
            second_elems.get(i2),
            .Some(e) => {
              new_elems.push(e);
            },
            .None => ()
          );
          i2 = (i2 + usize(1));
        });
