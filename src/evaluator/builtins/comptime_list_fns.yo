evaluate_yo_comptime_list_length :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg_e := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_arg := evaluate_expression(arg_e, env, ctx);
  info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_arg)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_e),
            `Failed to evaluate argument for "${BF_YO_COMPTIME_LIST_LENGTH}"`,
            false,
            .None
          )
        )
      );
      new_expr_info(env, TypeValue.Unit)
    }
  );
  if(!is_comptime_list_type(info.ty), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_e),
          `Expected ComptimeList type for "${BF_YO_COMPTIME_LIST_LENGTH}" argument`,
          false,
          .None
        )
      )
    );
  });
  list_val := match(
    info.value,
    .Some(v) => v,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_e),
            `Expected compile-time value for "${BF_YO_COMPTIME_LIST_LENGTH}" argument`,
            false,
            .None
          )
        )
      );
      EvalValue.UnitVal
    }
  );
  out_info := new_expr_info(info.env, t_usize());
  out_info.value = .Some(create_unknown_val(t_usize()));
  match(
    list_val,
    .ComptimeListVal(elements) => {
      out_info.value = .Some(EvalValue.IntLit(elements.len().to_string()));
    },
    _ => ()
  );
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
evaluate_yo_comptime_list_element_type :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg_e := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_arg := evaluate_expression(arg_e, env, ctx);
  info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_arg)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_e),
            `Failed to evaluate argument for "${BF_YO_COMPTIME_LIST_ELEMENT_TYPE}"`,
            false,
            .None
          )
        )
      );
      new_expr_info(env, TypeValue.Unit)
    }
  );
  // The argument must be a TypeVal wrapping a ComptimeList type.
  inner_ty := match(
    info.value,
    .Some(v) => match(
      v,
      .TypeVal(ty_box) => ty_box,
      _ => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg_e),
              `Expected TypeVal for "${BF_YO_COMPTIME_LIST_ELEMENT_TYPE}" argument`,
              false,
              .None
            )
          )
        );
        TypeValue.Unit
      }
    ),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_e),
            `Expected TypeVal for "${BF_YO_COMPTIME_LIST_ELEMENT_TYPE}" argument`,
            false,
            .None
          )
        )
      );
      TypeValue.Unit
    }
  );
  if(!is_comptime_list_type(inner_ty), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_e),
          `Expected ComptimeList type inside TypeVal for "${BF_YO_COMPTIME_LIST_ELEMENT_TYPE}"`,
          false,
          .None
        )
      )
    );
  });
  child_ty := match(inner_ty, .ComptimeListT(cb) => cb, _ => TypeValue.Unit);
  out_info := new_expr_info(info.env, t_type());
  out_info.value = .Some(EvalValue.TypeVal(child_ty));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
evaluate_yo_comptime_list_get :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg_e := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_list_arg := evaluate_expression(arg_e, env, ctx);
  list_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_list_arg)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_e),
            `Failed to evaluate list argument for "${BF_YO_COMPTIME_LIST_GET}"`,
            false,
            .None
          )
        )
      );
      new_expr_info(env, TypeValue.Unit)
    }
  );
  if(!is_comptime_list_type(list_info.ty), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_e),
          `Expected ComptimeList type for "${BF_YO_COMPTIME_LIST_GET}" argument`,
          false,
          .None
        )
      )
    );
  });
  child_ty := match(list_info.ty, .ComptimeListT(cb) => cb, _ => TypeValue.Unit);
  (cur_env : Environment) = list_info.env;
  // Same named promotion as the car builtin above (TS
  // comptime-list-fns.ts:606).
  get_unk_name := String.from("__comptime_list_get_");
  get_unk_name.push_string(random_id(env.module_path));
  (out_val : Option(EvalValue)) = .Some(create_unknown_val_with_name(child_ty, get_unk_name));
  match(
    list_info.value,
    .Some(list_v) => match(
      list_v,
      .ComptimeListVal(elements) => {
        list_len := elements.len();
        index_arg_e := match(
          args.get(usize(1)),
          .Some(a) => a,
          .None => {
            return(expr);
          }
        );
        eval_idx_arg := evaluate_expression(index_arg_e, cur_env, ctx);
        match(
          expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_idx_arg)),
          .Some(idx_info) => {
            match(
              idx_info.value,
              .Some(idx_v) => match(
                idx_v,
                .IntLit(raw) => {
                  match(
                    raw.parse_i64(),
                    .Some(idx_i64) => {
                      if((idx_i64 >= i64(0)) && (usize(idx_i64) < list_len), {
                        idx := usize(idx_i64);
                        match(
                          elements.get(idx),
                          .Some(elem) => {
                            out_val = .Some(elem);
                            cur_env = idx_info.env;
                          },
                          .None => {
                            exn.throw(
                              dyn(
                                format_error_message(
                                  ast_expr_token(index_arg_e),
                                  `ComptimeList index out of bounds in "${BF_YO_COMPTIME_LIST_GET}"`,
                                  false,
                                  .None
                                )
                              )
                            );
                          }
                        );
                      }, {
                        exn.throw(
                          dyn(
                            format_error_message(
                              ast_expr_token(index_arg_e),
                              `ComptimeList index out of bounds in "${BF_YO_COMPTIME_LIST_GET}"`,
                              false,
                              .None
                            )
                          )
                        );
                      });
                    },
                    .None => ()
                  );
                },
                _ => ()
              ),
              .None => ()
            );
          },
          .None => {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(arg_e),
                  `Failed to evaluate index argument for "${BF_YO_COMPTIME_LIST_GET}"`,
                  false,
                  .None
                )
              )
            );
          }
        );
      },
      _ => ()
    ),
    .None => ()
  );
  out_info := new_expr_info(cur_env, child_ty);
  out_info.value = out_val;
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
export(
  evaluate_yo_comptime_list_append,
  evaluate_yo_comptime_list_car,
  evaluate_yo_comptime_list_cdr,
  evaluate_yo_comptime_list_cons,
  evaluate_yo_comptime_list_element_type,
  evaluate_yo_comptime_list_get,
  evaluate_yo_comptime_list_length
);
