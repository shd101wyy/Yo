      EvalValue.UnitVal
    }
  );
  child_ty := match(cdr_info.ty, .ComptimeListT(cb) => cb, _ => TypeValue.Unit);
  list_ty := cdr_info.ty;
  if(!are_types_compatible(car_info.ty, child_ty), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(car_arg_e),
