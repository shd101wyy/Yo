//! evaluator/builtins/comptime_expect_error — evaluate_comptime_expect_error.
//!
//! 1:1 port of `src/evaluator/builtins/comptime-expect-error.ts`.
//!
//! Evaluates `comptime_expect_error(expr)` — expects the argument to produce a
//! compile-time error.  If the argument evaluates without error, this builtin
//! throws "Expected compile error, but the expression was evaluated successfully".
//!
//! Phase 3 note: The inner exception handler (given/unwind pattern) is temporarily
//! disabled because the Yo codegen cannot pass `given` bindings via `exn_x` —
//! the generated C call is missing the exn__throw argument, and the unwind handler
//! cannot access outer function parameters.  The `comptime_expect_error` builtin
//! therefore currently panics when the inner expression evaluates without error.
//! Restoring full semantics requires a codegen fix for closure capture of outer params.
open(import("std/string"));
{ Exception } :: import("std/error");
{
  AstExpr,
  ast_expr_token,
  ast_expr_to_string,
  ast_expr_id,
  make_err_expr
} :: import("../../expr.yo");
{ ArrayList } :: import("std/collections/array_list");
{ Environment, Frame, invalidate_frame_index } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ format_error_message } :: import("../../error.yo");
{ EvalValue, value_to_string } :: import("../../value.yo");
{
  expr_info_table_get,
  new_expr_info,
  expr_info_table_set,
  branch_group_stack_len,
  truncate_branch_group_stack,
  module_global_recording_mark,
  rollback_module_level_globals_to
} :: import("../../expr_info.yo");
{ t_unit } :: import("../../types/creators.yo");
{ set_propagate_def_time_errors, set_cee_observed_error, clear_cee_observed_error, cee_observed_error } :: import("../../types/flowability.yo");
{ evaluate_expression, evaluate_expression_raw } :: import("../exprs/expr.yo");
/// Evaluate `arg_expr` and report whether it THREW a compile error. Uses
/// `evaluate_expression_raw` (which propagates via `exn`) under a LOCAL
/// `Exception` whose `throw` unwinds this helper with `true`. If the eval
/// completes without throwing, control reaches the final `false`. This is the
/// `try_populate_expr_info_table` (main.yo) pattern — a local unwinding exn that
/// does NOT capture outer params, so it sidesteps the codegen limitation that
/// disabled the original inline handler. It restores the error-DETECTION
/// `comptime_expect_error` needs (TS uses a plain `try/catch`,
/// comptime-expect-error.ts:23-42; yo-self can't try/catch + continue in one
/// frame, hence the bool-returning helper).
_comptime_expect_error_arg_threw :: (
  fn(arg_expr : AstExpr, env : Environment, ctx : EvalContext) -> bool
)({
  local_exn := Exception(
    throw : (
      (_err) -> unwind(true)
    )
  );
  clear_cee_observed_error();
  _r := evaluate_expression_raw(arg_expr, env, ctx, local_exn);
  // The non-raw wrapper swallows throws raised beneath it (it has no outer
  // exn); in propagate mode it records them on the observation channel —
  // count that as an observed compile error (see flowability.yo).
  observed := cee_observed_error();
  clear_cee_observed_error();
  observed
});
evaluate_comptime_expect_error :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg_expr := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  // Evaluate the argument (a CLONE — TS `cloneExpr`s it, comptime-expect-error.ts:20
  // — so a partial/aborted eval doesn't pollute the original expr's ExprInfo); if
  // it throws a compile error, that's EXPECTED — set unit and return successfully.
  // Mirrors TS `comptime-expect-error.ts:23-42`.
  //
  // Enable "propagate all def-time body-eval errors" mode for the duration of the
  // argument eval: many rejected forms (e.g. an unwrapped `extern "c"` call) throw
  // inside a function BODY, which `_trial_eval_fn_body` normally swallows at
  // definition time (the def-eval wall). Without this, those errors never reach
  // the catch below and `comptime_expect_error` wrongly reports success. The flag
  // is cleared unconditionally on return (the helper's local-unwinding exn returns
  // control here), so no other def-time eval is affected.
  // Snapshot the mutable evaluation state the EXPECTED throw will strand.
  // TS needs no restore here: its envs are persistent (addVariableToEnv
  // returns a new env) and its contexts are spread-copied per call, so a
  // thrown-through eval cannot leave either dirty. yo-self's single mutable
  // Environment/EvalContext use push/mutate + restore-on-return, and the
  // propagating throw UNWINDS PAST those restores — e.g. the expected-error
  // handler's parameter frame stayed pushed on the module env, so a LATER
  // `->` handler in the same module resolved its own params into the stale
  // frame and was rejected with "cannot capture outer runtime variables"
  // (the algebraic_effects batch FTT). Restore env frame depth + the ctx
  // mode fields after the arg eval, success or throw.
  saved_frames_len := env.frames.len();
  // Snapshot the FRAME OBJECTS, not just the depth. The expected throw can
  // unwind past a `pop_frame` and leave the env SHORTER than it started —
  // measured on `cee(begin((p : *(i32)) = i32(0), ()))`: 3 frames in, 2 out,
  // and the frame that vanished was the MODULE frame. A depth-only restore
  // can only pop, never re-push, so every module binding made BEFORE the
  // `comptime_expect_error` was lost and the rest of the file could not see
  // it ("Variable "assert" not found" from a later `test(...)` arm, which
  // then hollowed the whole batch — tests/safe_code_structural_gates.test.yo).
  // TS needs no equivalent: its envs are persistent values, so the rejected
  // eval's env is simply discarded and the caller keeps the original.
  saved_frames := ArrayList(Frame).new();
  {
    (sf_i : usize) = usize(0);
    while(sf_i < env.frames.len(), {
      match(
        env.frames.get(sf_i),
        .Some(sf) => {
          saved_frames.push(sf);
        },
        .None => ()
      );
      sf_i = (sf_i + usize(1));
    });
  };
  // Per-frame variable counts: an EXPECTED throw can strand a half-made
  // binding in a surviving frame (e.g. `cee((z : Point1) := (3, 4))` adds
  // `z` before the type-mismatch throw). TS's persistent envs discard the
  // rejected child env wholesale; yo-self must truncate each surviving
  // frame's variable list back, or the leftover shadows the NEXT `(z : T)`
  // binding and mis-types every later use of the name.
  saved_frame_var_counts := ArrayList(usize).new();
  {
    (sfv_i : usize) = usize(0);
    while(sfv_i < env.frames.len(), {
      match(
        env.frames.get(sfv_i),
        .Some(sfv_f) => {
          saved_frame_var_counts.push(sfv_f.variables.len());
        },
        .None => {
          saved_frame_var_counts.push(usize(0));
        }
      );
      sfv_i = (sfv_i + usize(1));
    });
  };
  saved_is_executing := ctx.is_executing;
  saved_is_validating := ctx.is_validating_function_definition;
  saved_expected := ctx.expected_type;
  saved_fb_ctx := ctx.is_evaluating_function_body_or_async_block;
  saved_impl_block := ctx.is_inside_impl_block;
  saved_caps := ctx.captured_variables;
  saved_own_caps := ctx.own_consumed_captures;
  saved_loop_ctx := ctx.is_evaluating_loop_body;
  saved_self_type := ctx.self_type;
  saved_self_trait := ctx.self_trait_type;
  saved_self_module := ctx.self_module_type;
  saved_receiver := ctx.receiver_type;
  saved_eval_fn_type := ctx.is_evaluating_function_type;
  saved_unsafe_fn_type := ctx.is_unsafe_function_type;
  saved_unsafe_ctx := ctx.unsafe_context;
  saved_ctl_fn_type := ctx.is_control_function_type;
  saved_enclosing_ret := ctx.enclosing_function_return_type;
  saved_ctl_implicits := ctx.has_control_function_implicit_params;
  saved_where := ctx.is_inside_where_clause;
  saved_lhs := ctx.is_lhs_of_assignment;
  saved_ret_impl := ctx.function_return_impl_concrete_type;
  saved_force_ct := ctx.force_compile_time_bindings;
  saved_ctfe_cap := ctx.is_analyzing_ctfe_capability;
  saved_checking := ctx.is_in_function_call_checking_phase;
  saved_io_async := ctx.is_inside_io_async_call;
  saved_ctfe_depth := ctx.ctfe_depth;
  saved_given := ctx.is_inside_given_handler;
  saved_gen_impl := ctx.is_evaluating_generic_impl_specialization;
  saved_spec := ctx.currently_specializing_function;
  saved_spec_stack := ctx.currently_specializing_function_stack;
  // The expected throw can strand cond.yo's branch-group entries (push
  // without pop) — truncate back to this depth after the arg eval.
  saved_branch_groups := branch_group_stack_len();
  // Module-level globals registered by the (expected-to-fail) arg eval must
  // not survive it — see expr_info.yo's rollback comment.
  saved_mg_mark := module_global_recording_mark();
  set_propagate_def_time_errors(true);
  arg_threw := _comptime_expect_error_arg_threw(arg_expr.clone(), env, ctx);
  set_propagate_def_time_errors(false);
  ctx.is_executing = saved_is_executing;
  ctx.is_validating_function_definition = saved_is_validating;
  ctx.expected_type = saved_expected;
  ctx.is_evaluating_function_body_or_async_block = saved_fb_ctx;
  ctx.is_inside_impl_block = saved_impl_block;
  ctx.captured_variables = saved_caps;
  ctx.own_consumed_captures = saved_own_caps;
  ctx.is_evaluating_loop_body = saved_loop_ctx;
  ctx.self_type = saved_self_type;
  ctx.self_trait_type = saved_self_trait;
  ctx.self_module_type = saved_self_module;
  ctx.receiver_type = saved_receiver;
  ctx.is_evaluating_function_type = saved_eval_fn_type;
  ctx.is_unsafe_function_type = saved_unsafe_fn_type;
  ctx.unsafe_context = saved_unsafe_ctx;
  ctx.is_control_function_type = saved_ctl_fn_type;
  ctx.enclosing_function_return_type = saved_enclosing_ret;
  ctx.has_control_function_implicit_params = saved_ctl_implicits;
  ctx.is_inside_where_clause = saved_where;
  ctx.is_lhs_of_assignment = saved_lhs;
  ctx.function_return_impl_concrete_type = saved_ret_impl;
  ctx.force_compile_time_bindings = saved_force_ct;
  ctx.is_analyzing_ctfe_capability = saved_ctfe_cap;
  ctx.is_in_function_call_checking_phase = saved_checking;
  ctx.is_inside_io_async_call = saved_io_async;
  ctx.ctfe_depth = saved_ctfe_depth;
  ctx.is_inside_given_handler = saved_given;
  ctx.is_evaluating_generic_impl_specialization = saved_gen_impl;
  ctx.currently_specializing_function = saved_spec;
  ctx.currently_specializing_function_stack = saved_spec_stack;
  while(env.frames.len() > saved_frames_len, {
    env.pop_frame();
  });
  // ...and re-push the ones it POPPED (see the snapshot comment above).
  {
    (rf_i : usize) = env.frames.len();
    while(rf_i < saved_frames_len, {
      match(
        saved_frames.get(rf_i),
        .Some(rf) => {
          env.frames.push(rf);
        },
        .None => ()
      );
      rf_i = (rf_i + usize(1));
    });
  };
  // Drop variables the (expected-to-fail) arg eval stranded in surviving
  // frames — see the snapshot comment above.
  {
    (rfv_i : usize) = usize(0);
    while(rfv_i < env.frames.len(), {
      rfv_saved := match(saved_frame_var_counts.get(rfv_i), .Some(n) => n, .None => usize(0));
      match(
        env.frames.get(rfv_i),
        .Some(rfv_f) => {
          (rfv_popped : bool) = false;
          while(rfv_f.variables.len() > rfv_saved, {
            rfv_f.variables.pop();
            rfv_popped = true;
            ()
          });
          // A shrunk frame violates Frame.index_key's append-only contract —
          // drop its name index so the next lookup rebuilds from the
          // current list. This invalidation is what makes env.yo's
          // g_frame_indexes size bound sound
          // (issues/fixed/yo-self-frame-index-bound-breaks-fixpoint.md).
          if(rfv_popped, {
            invalidate_frame_index(rfv_f);
          });
        },
        .None => ()
      );
      rfv_i = (rfv_i + usize(1));
    });
  };
  truncate_branch_group_stack(saved_branch_groups);
  rollback_module_level_globals_to(saved_mg_mark);
  if(arg_threw, {
    out_unit := new_expr_info(env, t_unit());
    out_unit.value = Option(EvalValue).Some(EvalValue.UnitVal);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_unit);
    return(expr);
  });
  // No error was thrown — evaluate optional message argument for a better diagnostic.
  match(
    args.get(usize(1)),
    .Some(msg_expr) => {
      eval_msg := evaluate_expression(msg_expr, env, ctx);
      msg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_msg));
      match(
        msg_info_opt,
        .Some(msg_info) => {
          match(
            msg_info.value,
            .Some(v) => {
              err_msg := match(v, .StrLit(raw) => raw, _ => value_to_string(v));
              exn.throw(dyn(format_error_message(ast_expr_token(expr), err_msg, false, .None)));
            },
            .None => ()
          );
        },
        .None => ()
      );
    },
    .None => ()
  );
  exn.throw(
    dyn(
      format_error_message(
        ast_expr_token(expr),
        String.from("Expected compile error, but the expression was evaluated successfully:\n") +
          ast_expr_to_string(arg_expr),
        false,
        .None
      )
    )
  );
  make_err_expr()
});
export(evaluate_comptime_expect_error);
