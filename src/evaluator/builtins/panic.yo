//! evaluator/builtins/panic — implements evaluate_panic for __yo_panic.
//!
//! `__yo_panic(msg)` validates the argument type (str, comptime_str, or *(u8))
//! and annotates the call with the surrounding function's return type (__yo_panic diverges).
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  expr_info_adopt_env
} :: import("../../expr_info.yo");
{ Environment, snapshot_env } :: import("../../env.yo");
{ EvalContext, FuncOrAsyncBlockKind } :: import("../context.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, t_bool, t_ptr, t_never } :: import("../../types/creators.yo");
{ is_comptime_string_type, is_str_type, is_u8_type } :: import("../../types/guards.yo");
{ format_error_message, format_eval_failure } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ panic, assert } :: import("std/assert");
/// A `StrLit`'s raw text keeps its source delimiters; strip one matching
/// pair for the diagnostic.
_unquote_str_lit :: (fn(raw : String) -> String)({
  n := raw.len();
  if(n >= usize(2), {
    first := raw(usize(0));
    last := raw(n - usize(1));
    if((first == last) && ((first == u8(34)) || (first == u8(96))), {
      return(raw.slice_copy(usize(1) .. (n - usize(1))));
    });
  });
  raw
});
evaluate_panic :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  // panic() is only valid inside a function body or test block.
  fn_ctx_opt := ctx.is_evaluating_function_body_or_async_block;
  fn_ctx := match(
    fn_ctx_opt,
    .Some(c) => c,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("__yo_panic() can only be called inside a function body or test block")
          )
        )
      );
      return(expr);
    }
  );
  // During CTFE capability analysis, panic disqualifies the function.
  if(ctx.is_analyzing_ctfe_capability, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("Cannot use \"__yo_panic\" during compile-time function evaluation analysis. Functions containing \"__yo_panic\" cannot be evaluated at compile time.")
        )
      )
    );
  });
  // The panic's type: the propagated expected type (a match arm's
  // sibling-arm type, an assignment RHS, an argument slot) when there is one,
  // else `never` (plans/TYPE_SYSTEM_SOUNDNESS.md Phase 3.6). A `never` panic
  // is the identity of a cond/match join and adopts the join's type, or the
  // enclosing function's declared result when it is the body's tail
  // (`adopt_never_type`), so codegen still gets a real type for the
  // unreachable placeholder. It used to fall back to the function's result
  // type here, which made `x := cond(c => i32(3), true => __yo_panic("boom"))`
  // in an `-> i64` function a spurious "Previous: i32, Current: i64".
  (return_ty : TypeValue) = match(
    ctx.expected_type,
    .Some(et) => et.ty,
    .None => t_never()
  );
  // If there's a message argument, evaluate it and validate its type.
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  (cur_env : Environment) = env;
  // The message text when it is compile-time known (a `comptime_str`
  // literal) — the comptime-panic diagnostic below carries it.
  (ct_msg : Option(String)) = .None;
  if(args.len() > usize(0), {
    msg_expr := match(
      args.get(usize(0)),
      .Some(a) => a,
      .None => {
        return(expr);
      }
    );
    evaluated := evaluate_expression(msg_expr, cur_env, ctx);
    info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated));
    match(
      info_opt,
      .None => {
        exn.throw(
          dyn(
            format_eval_failure(
              ast_expr_token(msg_expr),
              String.from("Failed to evaluate panic message")
            )
          )
        );
      },
      .Some(info) => {
        cur_env = expr_info_adopt_env(info);
        msg_type := info.ty;
        msg_value := info.value;
        match(
          msg_value,
          .Some(mv) => match(
            mv,
            .StrLit(raw) => {
              ct_msg = .Some(_unquote_str_lit(raw));
            },
            _ => ()
          ),
          .None => ()
        );
        // `str` is the fieldless `.Str` TypeValue variant (NOT a Struct named
        // "str") — use the is_str_type guard. The old inline `.Struct(name=="str")`
        // check never matched a real `str` param, so a `panic(msg : str)` body
        // (e.g. `assert`'s `cond(flag => (), true => __yo_panic(msg))`) threw
        // "panic message must be a comptime_str or str", was swallowed by the
        // def-time trial-eval, and left the enclosing cond without ExprInfo →
        // "Failed to transpile cond(...)" in codegen.
        is_str := is_str_type(msg_type);
        // comptime_str: StrLit value, or an UNKNOWN value whose type is
        // comptime_str.
        // Under def-time body evaluation a `comptime_str` parameter binds
        // as a typed unknown; dropping it to `false` made `panic(msg)` the
        // single largest propagated def-eval failure (96 std files).
        is_comptime_str := match(
          msg_value,
          .Some(v) => match(
            v,
            .StrLit(_) => true,
            .UnknownVal(uty, _) => is_comptime_string_type(uty),
            _ => false
          ),
          .None => is_comptime_string_type(msg_type)
        );
        // *(u8) — C string pointer (e.g. a String's to_cstr().ptr())
        is_ptr_to_u8 := match(
          msg_type,
          .Pointer(pointee) => is_u8_type(pointee),
          _ => false
        );
        if(!is_str && !is_comptime_str && !is_ptr_to_u8, {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(msg_expr),
                String.from("__yo_panic message must be comptime_str, str, or *(u8)")
              )
            )
          );
        });
      }
    );
  });
  // A panic REACHED by a live compile-time execution is a compile error:
  // the failure is decided, so it must be reported now, at the panic, with
  // its message. Without this the body produced no value and the failure
  // resurfaced far from its cause — `Z :: Option(i32).None.comptime_unwrap()`
  // passed `yo check` and failed in clang as `use of undeclared identifier
  // 'Z'`, and a free comptime fn reported the message-less "Function body is
  // not evaluated correctly" (issues/fixed/a-comptime-panic-is-not-a-compile-error.md).
  // `ctfe_live` (set by calls/comptime_fn.yo) means every argument is known;
  // the arm-depth equality means no untaken cond/match arm of this body
  // encloses the panic. `is_executing` cannot serve here: a comptime call
  // inside a runtime body's def-time evaluation runs with it false even on
  // its taken path.
  if(fn_ctx.ctfe_live && (ctx.ctfe_untaken_arm_depth == fn_ctx.ctfe_arm_depth), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          match(
            ct_msg,
            .Some(m) => `compile-time panic: ${m}`,
            .None => String.from("compile-time panic")
          )
        )
      )
    );
  });
  info := new_expr_info(cur_env, return_ty);
  // panic never returns a value — leave info.value as .None
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
export(evaluate_panic);
