//! evaluator/builtins/derive_rule — evaluate_derive_rule and derive rule registry.
//!
//! Phase 3 implementation. 1:1 port of `src/evaluator/builtins/derive_rule.ts`.
//!
//! Key difference from TypeScript: TypeScript stores the derive rule directly on
//! FunctionValue/TraitType objects. In yo-self, types are immutable enums, so we
//! use a global HashMap(String, EvalValue) registry instead.
//! The key is the expression-level name of the trait constructor.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ HashMap } :: import("std/collections/hash_map");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token, ast_expr_id, make_err_expr } :: import("../../expr.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, is_func_val } :: import("../../value.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
/// Global registry: trait name → derive rule FuncVal EvalValue.
/// Mirrors `FunctionValue.deriveRule` / `TraitType.deriveRule` from TypeScript,
/// but stored globally since yo-self types are immutable enums.
(g_derive_rules : HashMap(String, EvalValue)) = HashMap(String, EvalValue).new();
/// Parallel registry: trait name → derive rule FuncVal's Func TYPE. Needed so
/// `call_registered_derive_rule` can bind the rule fn with its real type (the
/// call path dispatches on the callee variable's declared type, so a
/// value-only binding evaluates to `<unknown: unit>`). TS carries this on
/// `FunctionValue.type`.
/// Stored as `EvalValue.TypeVal` (reusing `HashMap(String, EvalValue)` — the
/// SAME instantiation as `g_derive_rules` — avoids a distinct `HashMap(String,
/// TypeValue)` codegen type).
(g_derive_rule_types : HashMap(String, EvalValue)) = HashMap(String, EvalValue).new();
/// Look up a registered derive rule's Func type by trait name.
get_derive_rule_type :: (fn(name : String) -> Option(TypeValue))(
  match(
    g_derive_rule_types.get(name),
    .Some(v) => match(v, .TypeVal(t) => Option(TypeValue).Some(t), _ => Option(TypeValue).None),
    .None => Option(TypeValue).None
  )
);
/// Extract the registry key from a trait arg expression.
///   Atom("Clone")       → Some("Clone")
///   FnCall("Eq", [...]) → Some("Eq")
///   Other               → None
extract_derive_key :: (fn(e : AstExpr) -> Option(String))(
  match(
    e,
    .Atom(_, tok) => Option(String).Some(tok.value),
    .FnCall(_, func_box, _, _, _) => match(
      func_box,
      .Atom(_, ftok) => Option(String).Some(ftok.value),
      .FnCall(_, _, _, _, _) => Option(String).None
    )
  )
);
/// Look up a registered derive rule by trait name.
get_derive_rule :: (fn(name : String) -> Option(EvalValue))(
  g_derive_rules.get(name)
);
evaluate_derive_rule :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  tok := ast_expr_token(expr);
  // Extract args[0] (trait constructor) and args[1] (derive function).
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  if(args.len() < usize(2), {
    exn.throw(
      dyn(
        format_error_message(
          tok,
          String.from("derive_rule requires exactly 2 arguments")
        )
      )
    );
  });
  trait_arg_expr := match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
  derive_fn_expr := match(args.get(usize(1)), .Some(a) => a, .None => make_err_expr());
  // Extract the registry key from the trait arg expression (before evaluation).
  key_opt := extract_derive_key(trait_arg_expr);
  key := match(
    key_opt,
    .Some(k) => k,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("derive_rule: first argument must be a trait name or trait constructor call")
          )
        )
      );
      String.from("")
    }
  );
  // Evaluate the derive function argument.
  evaled_derive_fn := evaluate_expression(derive_fn_expr, env, ctx);
  derive_fn_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaled_derive_fn));
  derive_fn_info := match(
    derive_fn_info_opt,
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("derive_rule: failed to evaluate derive function")
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  derive_fn_val := match(
    derive_fn_info.value,
    .Some(v) => v,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            tok,
            String.from("derive_rule: derive function has no compile-time value")
          )
        )
      );
      EvalValue.UnitVal
    }
  );
  if(!is_func_val(derive_fn_val), {
    exn.throw(
      dyn(
        format_error_message(
          tok,
          String.from("derive_rule: second argument must be a function")
        )
      )
    );
  });
  // Store in the global registry (value + Func type).
  _set := g_derive_rules.insert(key.clone(), derive_fn_val);
  _sett := g_derive_rule_types.insert(key, EvalValue.TypeVal(derive_fn_info.ty));
  out := new_expr_info(env, t_unit());
  out.value = Option(EvalValue).Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
  expr
});
export(evaluate_derive_rule);
export(extract_derive_key, get_derive_rule, get_derive_rule_type);
