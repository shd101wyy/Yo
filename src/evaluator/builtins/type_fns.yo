//! evaluator/builtins/type_fns — type introspection builtin functions.
//!
//! Full 1:1 port of `src/evaluator/builtins/type-fns.ts`.
//!
//! Functions implemented:
//!   evaluate_yo_type_to_string, evaluate_yo_are_types_compatible,
//!   evaluate_yo_are_types_equal, evaluate_yo_type_contains_rc_type,
//!   evaluate_yo_type_can_form_rc_cycle, evaluate_yo_type_impls,
//!   evaluate_yo_type_get_info, evaluate_comptime_eval,
//!   evaluate_comptime_string_to_expr, evaluate_type_join_fields,
//!   evaluate_type_map_variants.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token, ast_expr_id, make_err_expr } :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{
  Environment,
  add_variable_to_env,
  synthetic_token
} :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx } :: import("../context.yo");
{
  EvalValue,
  is_type_val,
  is_str_lit,
  is_func_val,
  is_expr_val,
  create_unknown_val,
  create_type_value,
  type_of_eval_value
} :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit, t_bool, t_type, t_comptime_string, t_comptime_int, t_comptime_float, t_expr_t, t_comptime_list } :: import("../../types/creators.yo");
{ is_some_type, is_struct_type, is_enum_type } :: import("../../types/guards.yo");
{ is_type_hierarchy_type, is_trait_type } :: import("../../types/guards.yo");
{ are_types_compatible, are_types_compatible_exact } :: import("../../types/compatibility.yo");
{ type_to_string } :: import("../../types/string.yo");
{ type_contains_rc_type, can_type_form_rc_cycle } :: import("../../types/utils.yo");
{ type_implements_trait_bool } :: import("../trait_checking.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{
  generate_expr_from_code,
  generate_exprs_from_code
} :: import("../../parser.yo");
{ random_id } :: import("../../utils.yo");
{ Exception } :: import("std/error");
/// Helper: extract a TypeValue from an arg's ExprInfo value, or throw.
/// If value is .None (runtime expression), throws.
/// If value is .Some(.TypeVal(tv)), returns tv.
/// If value is .Some(other), throws with a descriptive error.
_extract_type_val :: (
  fn(
    arg : AstExpr,
    info : ExprInfo,
    fn_name : str,
    exn : Exception
  ) -> TypeValue
)(
  match(
    info.value,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg),
            `${fn_name}: expected a type value, got runtime expression`
          )
        )
      );
      TypeValue.Unit
    },
    .Some(v) => match(
      v,
      .TypeVal(tv) => tv,
      _ => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg),
              `${fn_name}: expected a TypeVal, got a non-type value`
            )
          )
        );
        TypeValue.Unit
      }
    )
  )
);
/// __yo_type_to_comptime_string(T) -> comptime_str
/// Returns the string representation of type T.
evaluate_yo_type_to_string :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg0 := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_arg := evaluate_expression(arg0, env, ctx);
  arg_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_arg)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg0),
            String.from("__yo_type_to_comptime_string: failed to evaluate argument")
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  if(!(is_type_hierarchy_type(arg_info.ty)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg0),
          `__yo_type_to_comptime_string: expected a Type argument, got: ${type_to_string(arg_info.ty)}`
        )
      )
    );
  });
  // Default output: unknown comptime_str value.
  out_info := new_expr_info(arg_info.env, t_comptime_string());
  out_info.value = Option(EvalValue).Some(create_unknown_val(t_comptime_string()));
  // If the type is concretely known, compute the string.
  match(
    arg_info.value,
    .Some(v) => match(
      v,
      .TypeVal(tv) => {
        // StrLit comptime-string values carry SURROUNDING double-quotes (the
        // lexer keeps them; `+` concat and the string method shims strip the
        // first/last char to recover the inner text — see eval.yo). The raw type
        // name from `type_to_string` has none, so wrap it to match the
        // convention. Without the quotes the quote-stripping consumers eat the
        // real first/last char — e.g. derive(Clone)'s `__s3(type_name, "(", …)`
        // built `oke(…)` for `Token` and an empty callee for `T`, so the
        // synthesized constructor failed to transpile. Mirrors process.yo's
        // `__yo_process_platform` StrLit construction.
        s := type_to_string(tv);
        quoted := ((String.from("\"") + s) + String.from("\""));
        out_info.value = Option(EvalValue).Some(EvalValue.StrLit(quoted));
      },
      _ => ()
    ),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg0),
            String.from("__yo_type_to_comptime_string: expected type value, got runtime expression")
          )
        )
      );
    }
  );
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
/// __yo_are_types_compatible(expected, given) -> bool
/// Returns true if `given` type is compatible with `expected` type.
evaluate_yo_are_types_compatible :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg0 := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  arg1 := match(
    args.get(usize(1)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  // Evaluate expected type (clear expected_type and self_type for arg eval).
  saved_expected := ctx.expected_type;
  saved_self := ctx.self_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  ctx.self_type = Option(TypeValue).None;
  eval_0 := evaluate_expression(arg0, env, ctx);
  ctx.expected_type = saved_expected;
  ctx.self_type = saved_self;
  info_0 := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_0)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg0),
            String.from("__yo_are_types_compatible: failed to evaluate first argument")
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  if(!(is_type_hierarchy_type(info_0.ty)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg0),
          `__yo_are_types_compatible: expected a Type for first argument, got: ${type_to_string(info_0.ty)}`
        )
      )
    );
  });
  expected_type := _extract_type_val(arg0, info_0, "__yo_are_types_compatible", exn);
  cur_env := info_0.env;
  // Evaluate given type.
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  ctx.self_type = Option(TypeValue).None;
  eval_1 := evaluate_expression(arg1, cur_env, ctx);
  ctx.expected_type = saved_expected;
  ctx.self_type = saved_self;
  info_1 := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_1)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg1),
            String.from("__yo_are_types_compatible: failed to evaluate second argument")
          )
        )
      );
      new_expr_info(cur_env, t_unit())
    }
  );
  if(!(is_type_hierarchy_type(info_1.ty)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg1),
          `__yo_are_types_compatible: expected a Type for second argument, got: ${type_to_string(info_1.ty)}`
        )
      )
    );
  });
  given_type := _extract_type_val(arg1, info_1, "__yo_are_types_compatible", exn);
  cur_env = info_1.env;
  // are_types_compatible(actual, expected) — yo-self param order
  compatible := are_types_compatible(given_type, expected_type);
  out_info := new_expr_info(cur_env, t_bool());
  out_info.value = Option(EvalValue).Some(EvalValue.BoolVal(compatible));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
/// __yo_are_types_equal(a, b) -> bool
/// Returns true if the two types are exactly equal (no implicit conversions).
evaluate_yo_are_types_equal :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg0 := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  arg1 := match(
    args.get(usize(1)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  saved_expected := ctx.expected_type;
  saved_self := ctx.self_type;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  ctx.self_type = Option(TypeValue).None;
  eval_0 := evaluate_expression(arg0, env, ctx);
  ctx.expected_type = saved_expected;
  ctx.self_type = saved_self;
  info_0 := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_0)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg0),
            String.from("__yo_are_types_equal: failed to evaluate first argument")
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  type_a := _extract_type_val(arg0, info_0, "__yo_are_types_equal", exn);
  cur_env := info_0.env;
  ctx.expected_type = Option(ExpectedTypeCtx).None;
  ctx.self_type = Option(TypeValue).None;
  eval_1 := evaluate_expression(arg1, cur_env, ctx);
  ctx.expected_type = saved_expected;
  ctx.self_type = saved_self;
  info_1 := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_1)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg1),
            String.from("__yo_are_types_equal: failed to evaluate second argument")
          )
        )
      );
      new_expr_info(cur_env, t_unit())
    }
  );
  type_b := _extract_type_val(arg1, info_1, "__yo_are_types_equal", exn);
  cur_env = info_1.env;
  // Use exact match (requireExactMatch = true in TS).
  equal := are_types_compatible_exact(type_a, type_b);
  out_info := new_expr_info(cur_env, t_bool());
  out_info.value = Option(EvalValue).Some(EvalValue.BoolVal(equal));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
/// __yo_type_contains_rc_type(T) -> bool
/// Returns true if the type contains an RC-managed type.
/// Delegates to type_contains_rc_type (stub: always false in Phase 2).
evaluate_yo_type_contains_rc_type :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg0 := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_arg := evaluate_expression(arg0, env, ctx);
  arg_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_arg)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg0),
            String.from("__yo_type_contains_rc_type: failed to evaluate argument")
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  if(!(is_type_hierarchy_type(arg_info.ty)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg0),
          `__yo_type_contains_rc_type: expected a Type argument, got: ${type_to_string(arg_info.ty)}`
        )
      )
    );
  });
  type_val := _extract_type_val(arg0, arg_info, "__yo_type_contains_rc_type", exn);
  flag := type_contains_rc_type(type_val);
  out_info := new_expr_info(arg_info.env, t_bool());
  out_info.value = Option(EvalValue).Some(EvalValue.BoolVal(flag));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
/// __yo_type_can_form_rc_cycle(T) -> bool
/// Returns true if the type can form an RC reference cycle.
/// Delegates to can_type_form_rc_cycle (stub: always false in Phase 2).
evaluate_yo_type_can_form_rc_cycle :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg0 := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_arg := evaluate_expression(arg0, env, ctx);
  arg_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_arg)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg0),
            String.from("__yo_type_can_form_rc_cycle: failed to evaluate argument")
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  if(!(is_type_hierarchy_type(arg_info.ty)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg0),
          `__yo_type_can_form_rc_cycle: expected a Type argument, got: ${type_to_string(arg_info.ty)}`
        )
      )
    );
  });
  type_val := _extract_type_val(arg0, arg_info, "__yo_type_can_form_rc_cycle", exn);
  flag := can_type_form_rc_cycle(type_val);
  out_info := new_expr_info(arg_info.env, t_bool());
  out_info.value = Option(EvalValue).Some(EvalValue.BoolVal(flag));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
/// __yo_type_impls(T, Trait) -> bool
/// Returns true if T implements the given Trait.
/// Mirrors `evaluateYoTypeImpls` in `src/evaluator/builtins/type-fns.ts`.
evaluate_yo_type_impls :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg0 := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  arg1 := match(
    args.get(usize(1)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  // Evaluate arg0 (the type to check).
  eval0 := evaluate_expression(arg0, env, ctx);
  info0 := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval0)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg0),
            String.from("__yo_type_impls: failed to evaluate type argument")
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  (cur_env : Environment) = info0.env;
  if(!(is_type_hierarchy_type(info0.ty)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg0),
          String.from("__yo_type_impls: expected Type for first argument")
        )
      )
    );
  });
  target_type := _extract_type_val(arg0, info0, "__yo_type_impls", exn);
  // Evaluate arg1 (the trait to check for).
  eval1 := evaluate_expression(arg1, cur_env, ctx);
  info1 := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval1)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg1),
            String.from("__yo_type_impls: failed to evaluate trait argument")
          )
        )
      );
      new_expr_info(cur_env, t_unit())
    }
  );
  cur_env = info1.env;
  // Determine the trait type from arg1.
  // Case 1: arg1 evaluates to a TypeVal containing a TraitType.
  // Case 2: arg1's type is a TraitType (e.g. an impl parameter).
  // Case 3: arg1's type is TypeUni (unknown generic) — return unknown bool.
  trait_type_opt := match(
    info1.value,
    .Some(v) => if(is_type_val(v), {
      tv := match(v, .TypeVal(b) => b, _ => t_unit());
      if(is_trait_type(tv), Option(TypeValue).Some(tv), Option(TypeValue).None)
    }, Option(TypeValue).None),
    .None => Option(TypeValue).None
  );
  // If not found via value, check if the type itself is a trait type.
  trait_type_opt2 := match(
    trait_type_opt,
    .Some(_) => trait_type_opt,
    .None => if(
      is_trait_type(info1.ty),
      Option(TypeValue).Some(info1.ty),
      Option(TypeValue).None
    )
  );
  // If still not found, check if it's a generic unknown (TypeUni → return unknown bool).
  if(match(trait_type_opt2, .None => is_type_hierarchy_type(info1.ty), .Some(_) => false), {
    out := new_expr_info(cur_env, t_bool());
    out.value = .Some(create_unknown_val(t_bool()));
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
    return(expr);
  });
  trait_type := match(
    trait_type_opt2,
    .Some(tt) => tt,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg1),
            String.from("__yo_type_impls: expected trait type for second argument")
          )
        )
      );
      t_unit()
    }
  );
  result := type_implements_trait_bool(target_type, trait_type, cur_env);
  out := new_expr_info(cur_env, t_bool());
  out.value = .Some(EvalValue.BoolVal(result));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
  expr
});
// ---------------------------------------------------------------------------
// Phase 3 private helpers — used by the five builtins below.
// ---------------------------------------------------------------------------
/// Unwind a string for safe embedding inside a Yo double-quoted string literal.
_ti_escape_str :: (fn(s : String) -> String)({
  s2 := s.replace(String.from("\\"), String.from("\\\\"));
  s2.replace(String.from("\""), String.from("\\\""))
});
/// Format the Yo source for a `TypeFieldInfo("label", ty_var)` call:
///   `TypeFieldInfo("<escaped_label>", <ty_var_name>)`
/// Used by `_ti_build_type_field_info` to build the code string passed
/// to `_ti_eval_code`. Pure string composition.
format_type_field_info_call :: (
  fn(escaped_label : String, ty_var_name : String) -> String
)(
  (((String.from("TypeFieldInfo(\"") + escaped_label) + String.from("\", ")) + ty_var_name) +
    String.from(")")
);
/// Format the Yo source for a `VariantInfo("name", fl, et, usize(idx))` call:
///   `VariantInfo("<escaped_name>", <fl_var>, <et_var>, usize(<idx>))`
/// Used by `_ti_build_variant_info` to build the code string passed to
/// `_ti_eval_code`. Pure string composition.
format_variant_info_call :: (
  fn(escaped_name : String, fl_var_name : String, et_var_name : String, idx_str : String) -> String
)(
  (
    (
      (
        (
          (((String.from("VariantInfo(\"") + escaped_name) + String.from("\", ")) + fl_var_name) +
            String.from(", ")
        ) + et_var_name
      ) + String.from(", usize(")
    ) + idx_str
  ) + String.from("))")
);
/// Bind a TypeValue to a fresh comptime temp variable in the env.
/// Mutates env in place via pointer; returns the generated variable name.
_ti_bind_type :: (
  fn(
    env_ptr : Environment,
    ty : TypeValue,
    _ctx : EvalContext
  ) -> String
)({
  name_str := `__ti_t_${random_id(env_ptr.module_path)}`;
  _add := add_variable_to_env(
    env_ptr,
    name_str.clone(),
    t_type(),
    Option(EvalValue).Some(EvalValue.TypeVal(ty)),
    true,
    false,
    false,
    false,
    synthetic_token(name_str.clone(), env_ptr.module_path)
  );
  name_str
});
/// Evaluate a code string with force_compile_time_bindings=true.
/// Updates env pointed to by env_ptr; returns the resulting EvalValue if any.
_ti_eval_code :: (
  fn(
    env_ptr : Environment,
    code : String,
    ctx : EvalContext,
    exn : Exception
  ) -> Option(EvalValue)
)({
  code_expr := generate_expr_from_code(code.clone(), exn);
  old_force := ctx.force_compile_time_bindings;
  ctx.force_compile_time_bindings = true;
  result_ast := evaluate_expression(code_expr, env_ptr, ctx);
  ctx.force_compile_time_bindings = old_force;
  result_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(result_ast)),
    .Some(i) => i,
    .None => new_expr_info(env_ptr, t_unit())
  );
  env_ptr.frames = result_info.env.frames;
  env_ptr.module_path = result_info.env.module_path;
  env_ptr.function_declaration_frame_level = result_info.env.function_declaration_frame_level;
  env_ptr.input_string = result_info.env.input_string;
  result_info.value
});
/// Build a ComptimeList from EvalValues.  If values is non-empty, the element
/// type is inferred from the first value; otherwise `type_name` is evaluated to
/// obtain the element type.  Binds the list to a fresh temp var and returns its name.
_ti_bind_comptime_list :: (
  fn(
    env_ptr : Environment,
    values : ArrayList(EvalValue),
    type_name : String,
    var_prefix : String,
    ctx : EvalContext,
    exn : Exception
  ) -> String
)({
  elem_type := if(values.len() > usize(0), match(values.get(usize(0)), .Some(v) => type_of_eval_value(v), .None => t_unit()), {
    // Evaluate the type name to discover the element type.
    type_ast := generate_expr_from_code(type_name.clone(), exn);
    old_force := ctx.force_compile_time_bindings;
    ctx.force_compile_time_bindings = true;
    type_result_ast := evaluate_expression(type_ast, env_ptr, ctx);
    ctx.force_compile_time_bindings = old_force;
    type_info := match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(type_result_ast)),
      .Some(i) => i,
      .None => new_expr_info(env_ptr, t_unit())
    );
    env_ptr.frames = type_info.env.frames;
    env_ptr.module_path = type_info.env.module_path;
    env_ptr.function_declaration_frame_level = type_info.env.function_declaration_frame_level;
    env_ptr.input_string = type_info.env.input_string;
    match(
      type_info.value,
      .Some(v) => match(v, .TypeVal(tv) => tv, _ => t_unit()),
      .None => t_unit()
    )
  });
  list_type := t_comptime_list(elem_type);
  list_val := EvalValue.ComptimeListVal(values);
  name_str := `__ti_${var_prefix}_${random_id(env_ptr.module_path)}`;
  _add := add_variable_to_env(
    env_ptr,
    name_str.clone(),
    list_type,
    Option(EvalValue).Some(list_val),
    true,
    false,
    false,
    false,
    synthetic_token(name_str.clone(), env_ptr.module_path)
  );
  name_str
});
/// Build a single TypeFieldInfo value from a label + type pair.
/// Evaluates `TypeFieldInfo("label", ty_var)` in the env via code string.
_ti_build_type_field_info :: (
  fn(
    env_ptr : Environment,
    label : String,
    field_ty : TypeValue,
    ctx : EvalContext,
    exn : Exception
  ) -> EvalValue
)({
  ty_name := _ti_bind_type(env_ptr, field_ty, ctx);
  escaped_label := _ti_escape_str(label);
  code := format_type_field_info_call(escaped_label, ty_name);
  match(
    _ti_eval_code(env_ptr, code, ctx, exn),
    .Some(v) => v,
    .None => EvalValue.UnitVal
  )
});
/// Build a ComptimeList(TypeFieldInfo) from parallel label/type lists.
/// Returns the name of the temp var holding the list.
_ti_bind_type_field_list :: (
  fn(
    env_ptr : Environment,
    labels : ArrayList(String),
    types : ArrayList(TypeValue),
    ctx : EvalContext,
    exn : Exception
  ) -> String
)({
  fi_vals := ArrayList(EvalValue).new();
  (i : usize) = usize(0);
  n := labels.len();
  while(i < n, {
    label := match(labels.get(i), .Some(l) => l, .None => String.from(""));
    field_ty := match(types.get(i), .Some(t) => t, .None => t_unit());
    fi_val := _ti_build_type_field_info(env_ptr, label, field_ty, ctx, exn);
    _push := fi_vals.push(fi_val);
    i = (i + usize(1));
  });
  _ti_bind_comptime_list(env_ptr, fi_vals, String.from("TypeFieldInfo"), String.from("fl"), ctx, exn)
});
/// Build a VariantInfo value from the variant's name, field list, enum type, and index.
/// Evaluates `VariantInfo("name", fl_var, et_var, usize(idx))` via code string.
_ti_build_variant_info :: (
  fn(
    env_ptr : Environment,
    v_name : String,
    v_field_labels : ArrayList(String),
    v_field_types : ArrayList(TypeValue),
    enum_ty : TypeValue,
    v_idx : usize,
    ctx : EvalContext,
    exn : Exception
  ) -> EvalValue
)({
  et_name := _ti_bind_type(env_ptr, enum_ty, ctx);
  fl_name := _ti_bind_type_field_list(env_ptr, v_field_labels, v_field_types, ctx, exn);
  escaped_name := _ti_escape_str(v_name);
  idx_str := v_idx.to_string();
  code := format_variant_info_call(escaped_name, fl_name, et_name, idx_str);
  match(
    _ti_eval_code(env_ptr, code, ctx, exn),
    .Some(v) => v,
    .None => EvalValue.UnitVal
  )
});
/// Build a ComptimeList(VariantInfo) from an EnumT type's variant data.
/// Returns the name of the temp var holding the list.
_ti_bind_variant_info_list :: (
  fn(
    env_ptr : Environment,
    enum_ty : TypeValue,
    variant_names : ArrayList(String),
    variant_fields : ArrayList(ArrayList(TypeValue)),
    variant_field_labels : ArrayList(ArrayList(String)),
    ctx : EvalContext,
    exn : Exception
  ) -> String
)({
  vi_vals := ArrayList(EvalValue).new();
  (i : usize) = usize(0);
  n := variant_names.len();
  while(i < n, {
    v_name := match(variant_names.get(i), .Some(nm) => nm, .None => String.from(""));
    v_fields := match(variant_fields.get(i), .Some(f) => f, .None => ArrayList(TypeValue).new());
    v_field_labels := match(variant_field_labels.get(i), .Some(l) => l, .None => ArrayList(String).new());
    vi_val := _ti_build_variant_info(env_ptr, v_name, v_field_labels, v_fields, enum_ty, i, ctx, exn);
    _push := vi_vals.push(vi_val);
    i = (i + usize(1));
  });
  _ti_bind_comptime_list(env_ptr, vi_vals, String.from("VariantInfo"), String.from("vl"), ctx, exn)
});
/// Build a ComptimeList(TraitInfo) from trait types and bind to a temp var
/// (port of bindTempTraitInfoList, type-fns.ts:1330).
_ti_bind_trait_info_list :: (
  fn(
    env_ptr : Environment,
    trait_types : ArrayList(TypeValue),
    prefix : String,
    ctx : EvalContext,
    exn : Exception
  ) -> String
)({
  values := ArrayList(EvalValue).new();
  (i : usize) = usize(0);
  while(i < trait_types.len(), {
    tt := match(trait_types.get(i), .Some(t) => t, .None => t_unit());
    tt_name := _ti_bind_type(env_ptr, tt, ctx);
    code := String.from("TraitInfo(");
    code.push_string(tt_name);
    code.push_str(")");
    match(
      _ti_eval_code(env_ptr, code, ctx, exn),
      .Some(v) => {
        _p := values.push(v);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  {
    pfx := String.from("trl_");
    pfx.push_string(prefix);
    _ti_bind_comptime_list(env_ptr, values, String.from("TraitInfo"), pfx, ctx, exn)
  }
});
/// Build one ParamInfo value (port of the loop body in bindTempParamInfoList,
/// type-fns.ts:1128).
_ti_build_param_info :: (
  fn(
    env_ptr : Environment,
    label : String,
    ty : TypeValue,
    is_comptime : bool,
    is_variadic : bool,
    ctx : EvalContext,
    exn : Exception
  ) -> EvalValue
)({
  ty_name := _ti_bind_type(env_ptr, ty, ctx);
  code := String.from("ParamInfo(\"");
  code.push_string(_ti_escape_str(label));
  code.push_str("\", ");
  code.push_string(ty_name);
  code.push_str(", ");
  code.push_str(cond(is_comptime => "true", true => "false"));
  code.push_str(", false, ");
  code.push_str(cond(is_variadic => "true", true => "false"));
  code.push_str(")");
  match(_ti_eval_code(env_ptr, code, ctx, exn), .Some(v) => v, .None => EvalValue.UnitVal)
});
/// Build a FunctionInfo temp var from a call signature (port of
/// bindTempFunctionInfo, type-fns.ts:1064). Sources per-param data from
/// what the type value CARRIES (labels/types/foralls/implicits + variadic
/// flag); yo-self keeps per-param comptime in an expr-id side table
/// unreachable from a bare TypeValue — recorded gap in the map.
_ti_bind_function_info :: (
  fn(
    env_ptr : Environment,
    param_labels : ArrayList(String),
    param_types : ArrayList(TypeValue),
    forall_labels : ArrayList(String),
    forall_types : ArrayList(TypeValue),
    implicit_labels : ArrayList(String),
    implicit_types : ArrayList(TypeValue),
    result_ty : TypeValue,
    // The variadic parameter (0-or-1 in variadic_types; label/comptime from
    // FuncMeta) — appended to the params list exactly as TS appends
    // variadicParameter (type-fns.ts:1134).
    variadic_types : ArrayList(TypeValue),
    variadic_label : String,
    variadic_comptime : bool,
    ctx : EvalContext,
    exn : Exception
  ) -> String
)({
  param_vals := ArrayList(EvalValue).new();
  {
    (i : usize) = usize(0);
    n := param_types.len();
    while(i < n, {
      lbl := match(param_labels.get(i), .Some(l) => l, .None => String.new());
      pty := match(param_types.get(i), .Some(t) => t, .None => t_unit());
      _p := param_vals.push(_ti_build_param_info(env_ptr, lbl, pty, false, false, ctx, exn));
      i = (i + usize(1));
    });
    match(
      variadic_types.get(usize(0)),
      .Some(vty) => {
        _pv := param_vals.push(
          _ti_build_param_info(env_ptr, variadic_label.clone(), vty, variadic_comptime, true, ctx, exn)
        );
      },
      .None => ()
    );
  };
  params_name := _ti_bind_comptime_list(env_ptr, param_vals, String.from("ParamInfo"), String.from("pl"), ctx, exn);
  ret_name := _ti_bind_type(env_ptr, result_ty, ctx);
  // Foralls.
  forall_vals := ArrayList(EvalValue).new();
  {
    (i : usize) = usize(0);
    while(i < forall_types.len(), {
      lbl := match(forall_labels.get(i), .Some(l) => l, .None => String.new());
      fty := match(forall_types.get(i), .Some(t) => t, .None => t_unit());
      fn_ty_name := _ti_bind_type(env_ptr, fty, ctx);
      code := String.from("ForallParamInfo(\"");
      code.push_string(_ti_escape_str(lbl));
      code.push_str("\", ");
      code.push_string(fn_ty_name);
      code.push_str(")");
      match(
        _ti_eval_code(env_ptr, code, ctx, exn),
        .Some(v) => {
          _p := forall_vals.push(v);
        },
        .None => ()
      );
      i = (i + usize(1));
    });
  };
  foralls_name := _ti_bind_comptime_list(env_ptr, forall_vals, String.from("ForallParamInfo"), String.from("fpl"), ctx, exn);
  // Implicits.
  implicit_vals := ArrayList(EvalValue).new();
  {
    (i : usize) = usize(0);
    while(i < implicit_types.len(), {
      lbl := match(implicit_labels.get(i), .Some(l) => l, .None => String.new());
      ity := match(implicit_types.get(i), .Some(t) => t, .None => t_unit());
      it_name := _ti_bind_type(env_ptr, ity, ctx);
      code := String.from("ImplicitParamInfo(\"");
      code.push_string(_ti_escape_str(lbl));
      code.push_str("\", ");
      code.push_string(it_name);
      code.push_str(")");
      match(
        _ti_eval_code(env_ptr, code, ctx, exn),
        .Some(v) => {
          _p := implicit_vals.push(v);
        },
        .None => ()
      );
      i = (i + usize(1));
    });
  };
  implicits_name := _ti_bind_comptime_list(env_ptr, implicit_vals, String.from("ImplicitParamInfo"), String.from("ipl"), ctx, exn);
  fni_code := String.from("FunctionInfo(");
  fni_code.push_string(params_name);
  fni_code.push_str(", ");
  fni_code.push_string(ret_name);
  fni_code.push_str(", ");
  fni_code.push_string(foralls_name);
  fni_code.push_str(", ");
  fni_code.push_string(implicits_name);
  fni_code.push_str(", false)");
  fni_name := `__ti_fni_${random_id(env_ptr.module_path)}`;
  match(
    _ti_eval_code(env_ptr, fni_code, ctx, exn),
    .Some(v) => {
      _add := add_variable_to_env(
        env_ptr,
        fni_name.clone(),
        type_of_eval_value(v),
        Option(EvalValue).Some(v),
        true,
        false,
        false,
        false,
        synthetic_token(fni_name.clone(), env_ptr.module_path)
      );
    },
    .None => ()
  );
  fni_name
});
/// Build the TraitFieldInfo list for a TraitT (port of
/// bindTempTraitFieldInfoList, type-fns.ts:1237). A field is an ASSOCIATED
/// TYPE when its label is in the trait's assoc_type_names (TS
/// `field.unassignedSomeType`).
_ti_bind_trait_field_info_list :: (
  fn(
    env_ptr : Environment,
    field_labels : ArrayList(String),
    field_types : ArrayList(TypeValue),
    assoc_type_names : ArrayList(String),
    ctx : EvalContext,
    exn : Exception
  ) -> String
)({
  values := ArrayList(EvalValue).new();
  (i : usize) = usize(0);
  while(i < field_labels.len(), {
    lbl := match(field_labels.get(i), .Some(l) => l, .None => String.new());
    fty := match(field_types.get(i), .Some(t) => t, .None => t_unit());
    ft_name := _ti_bind_type(env_ptr, fty, ctx);
    (is_assoc : bool) = false;
    {
      (ai : usize) = usize(0);
      while(ai < assoc_type_names.len(), {
        match(
          assoc_type_names.get(ai),
          .Some(an) => if(an == lbl, {
            is_assoc = true;
          }),
          .None => ()
        );
        ai = (ai + usize(1));
      });
    };
    code := String.from("TraitFieldInfo(\"");
    code.push_string(_ti_escape_str(lbl));
    code.push_str("\", ");
    code.push_string(ft_name);
    code.push_str(", ");
    code.push_str(cond(is_assoc => "true", true => "false"));
    code.push_str(")");
    match(
      _ti_eval_code(env_ptr, code, ctx, exn),
      .Some(v) => {
        _p := values.push(v);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  _ti_bind_comptime_list(env_ptr, values, String.from("TraitFieldInfo"), String.from("tfl"), ctx, exn)
});
// ---------------------------------------------------------------------------
// Phase 3 builtin implementations
// ---------------------------------------------------------------------------
/// __yo_type_get_info(T) -> TypeInfo
/// Returns a TypeInfo enum value with metadata about the type.
evaluate_yo_type_get_info :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg0 := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval0 := evaluate_expression(arg0, env, ctx);
  info0 := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval0)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg0),
            String.from("__yo_type_get_info: failed to evaluate type argument")
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  (local_env : Environment) = info0.env;
  type_val := _extract_type_val(arg0, info0, "__yo_type_get_info", exn);
  // SomeType → return UnknownVal with TypeInfo type (avoid calling constructors).
  if(is_some_type(type_val), {
    unit_ast := generate_expr_from_code(String.from("TypeInfo.Unit"), exn);
    old_force := ctx.force_compile_time_bindings;
    ctx.force_compile_time_bindings = true;
    unit_result := evaluate_expression(unit_ast, local_env, ctx);
    ctx.force_compile_time_bindings = old_force;
    unit_info := match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(unit_result)),
      .Some(i) => i,
      .None => new_expr_info(local_env, t_unit())
    );
    ti_ty := unit_info.ty;
    unknown_val := create_unknown_val(ti_ty);
    out := new_expr_info(local_env, ti_ty);
    out.value = Option(EvalValue).Some(unknown_val);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
    return(expr);
  });
  // Build code string for each TypeValue variant.
  code := match(
    type_val,
    .Unit => String.from("TypeInfo.Unit"),
    .BoolT => String.from("TypeInfo.Bool"),
    .Void => String.from("TypeInfo.Void"),
    .Usize => String.from("TypeInfo.Usize"),
    .Isize => String.from("TypeInfo.Isize"),
    .ComptimeInt => String.from("TypeInfo.ComptimeInt"),
    .ComptimeFloat => String.from("TypeInfo.ComptimeFloat"),
    .ComptimeString => String.from("TypeInfo.ComptimeStr"),
    .CChar => String.from("TypeInfo.Char"),
    .CShort => String.from("TypeInfo.Short"),
    .CUShort => String.from("TypeInfo.UShort"),
    .CInt => String.from("TypeInfo.Int"),
    .CUInt => String.from("TypeInfo.UInt"),
    .CLong => String.from("TypeInfo.Long"),
    .CULong => String.from("TypeInfo.ULong"),
    .CLongLong => String.from("TypeInfo.LongLong"),
    .CULongLong => String.from("TypeInfo.ULongLong"),
    .CLongDouble => String.from("TypeInfo.LongDouble"),
    .ExprT => String.from("TypeInfo.Expr"),
    .EffectsRowT(_, _) => String.from("TypeInfo.EffectsRow"),
    .TypeAppT(_, _) => String.from("TypeInfo.TypeApplication"),
    .Int(bits, signed) => cond(
      (signed && (bits == u8(8))) => String.from("TypeInfo.I8"),
      (signed && (bits == u8(16))) => String.from("TypeInfo.I16"),
      (signed && (bits == u8(32))) => String.from("TypeInfo.I32"),
      (signed && (bits == u8(64))) => String.from("TypeInfo.I64"),
      (!(signed) && (bits == u8(8))) => String.from("TypeInfo.U8"),
      (!(signed) && (bits == u8(16))) => String.from("TypeInfo.U16"),
      (!(signed) && (bits == u8(32))) => String.from("TypeInfo.U32"),
      (!(signed) && (bits == u8(64))) => String.from("TypeInfo.U64"),
      true => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(expr),
              String.from("__yo_type_get_info: unsupported Int bits")
            )
          )
        );
        String.from("TypeInfo.Unit")
      }
    ),
    .Float(bits) => if(bits == u8(32), String.from("TypeInfo.F32"), String.from("TypeInfo.F64")),
    .TypeUni(level) => ((String.from("TypeInfo.Type(") + level.to_string()) + String.from(")")),
    .Pointer(pointee_box) => {
      cn := _ti_bind_type(local_env, pointee_box, ctx);
      (String.from("TypeInfo.Ptr(") + cn) + String.from(")")
    },
    .Array(element_box, length, _) => {
      cn := _ti_bind_type(local_env, element_box, ctx);
      (((String.from("TypeInfo.Array(") + cn) + String.from(", ")) + length.to_string()) + String.from(")")
    },
    .IsoT(child_box) => {
      cn := _ti_bind_type(local_env, child_box, ctx);
      (String.from("TypeInfo.Iso(") + cn) + String.from(")")
    },
    .ComptimeListT(child_box) => {
      cn := _ti_bind_type(local_env, child_box, ctx);
      (String.from("TypeInfo.ComptimeList(") + cn) + String.from(")")
    },
    .Tuple(labels, types) => {
      fl_name := _ti_bind_type_field_list(local_env, labels, types, ctx, exn);
      (String.from("TypeInfo.Tuple(") + fl_name) + String.from(")")
    },
    .Str => String.from("TypeInfo.Str"),
    .Struct({ field_labels : labels, field_types : types, is_reference_semantics : is_ref, is_atomic_rc : is_atomic, is_newtype }) => {
      fl_name := _ti_bind_type_field_list(local_env, labels, types, ctx, exn);
      kind_str := cond(
        is_newtype => String.from("StructKind.NewType"),
        is_atomic => String.from("StructKind.AtomicObject"),
        is_ref => String.from("StructKind.Object"),
        true => String.from("StructKind.Struct")
      );
      (((String.from("TypeInfo.Struct(") + fl_name) + String.from(", ")) + kind_str) + String.from(")")
    },
    .EnumT(_, _, variant_names, variant_fields, _, variant_field_labels, _, _, _) => {
      vl_name := _ti_bind_variant_info_list(local_env, type_val, variant_names, variant_fields, variant_field_labels, ctx, exn);
      (String.from("TypeInfo.Enum(") + vl_name) + String.from(")")
    },
    .Union(_, labels, types) => {
      fl_name := _ti_bind_type_field_list(local_env, labels, types, ctx, exn);
      (String.from("TypeInfo.Union(") + fl_name) + String.from(")")
    },
    // === SomeType(name, required_traits, negative_traits, resolved_type) ===
    // (type-fns.ts:896-930)
    .SomeT({ name : st_name, required_trait_types : st_req, negative_trait_types : st_neg, resolved_concrete : st_res }) => {
      req_name := _ti_bind_trait_info_list(local_env, st_req, String.from("req"), ctx, exn);
      neg_name := _ti_bind_trait_info_list(local_env, st_neg, String.from("neg"), ctx, exn);
      res_name := match(
        st_res.get(usize(0)),
        .Some(rt) => _ti_bind_type(local_env, rt, ctx),
        .None => String.from("unit")
      );
      {
        sc := String.from("TypeInfo.SomeType(\"");
        sc.push_string(_ti_escape_str(st_name));
        sc.push_str("\", ");
        sc.push_string(req_name);
        sc.push_str(", ");
        sc.push_string(neg_name);
        sc.push_str(", ");
        sc.push_string(res_name);
        sc.push_str(")");
        sc
      }
    },
    // === Dyn(required_traits, negative_traits) === (type-fns.ts:876-894)
    .DynT(dt_req, _, dt_neg, _) => {
      req_name := _ti_bind_trait_info_list(local_env, dt_req, String.from("req"), ctx, exn);
      neg_name := _ti_bind_trait_info_list(local_env, dt_neg, String.from("neg"), ctx, exn);
      {
        dc := String.from("TypeInfo.Dyn(");
        dc.push_string(req_name);
        dc.push_str(", ");
        dc.push_string(neg_name);
        dc.push_str(")");
        dc
      }
    },
    // === Trait(fields, kind) === (type-fns.ts:858-874). yo-self splits TS's
    // TraitType into TraitT / FnTraitT / FutureTraitT — one arm each.
    .TraitT(_, tt_assoc_names, tt_flabels, tt_ftypes, _, _, _, _, _, _) => {
      fl_name := _ti_bind_trait_field_info_list(local_env, tt_flabels, tt_ftypes, tt_assoc_names, ctx, exn);
      {
        tc := String.from("TypeInfo.Trait(");
        tc.push_string(fl_name);
        tc.push_str(", TraitKind.Normal)");
        tc
      }
    },
    .FnTraitT(_, ft_plabels, ft_ptypes, ft_result, ft_ilabels, ft_itypes, _, _) => {
      fni_name := _ti_bind_function_info(
        local_env,
        ft_plabels,
        ft_ptypes,
        ArrayList(String).new(),
        ArrayList(TypeValue).new(),
        ft_ilabels,
        ft_itypes,
        ft_result,
        ArrayList(TypeValue).new(),
        String.from("..."),
        false,
        ctx,
        exn
      );
      empty_fields := _ti_bind_comptime_list(local_env, ArrayList(EvalValue).new(), String.from("TraitFieldInfo"), String.from("tfl"), ctx, exn);
      {
        fc := String.from("TypeInfo.Trait(");
        fc.push_string(empty_fields);
        fc.push_str(", TraitKind.Fn(");
        fc.push_string(fni_name);
        fc.push_str("))");
        fc
      }
    },
    .FutureTraitT(_, fut_output, _, fut_etypes, _) => {
      out_name := _ti_bind_type(local_env, fut_output, ctx);
      eff_name := _ti_bind_trait_info_list(local_env, fut_etypes, String.from("eff"), ctx, exn);
      empty_fields := _ti_bind_comptime_list(local_env, ArrayList(EvalValue).new(), String.from("TraitFieldInfo"), String.from("tfl"), ctx, exn);
      {
        uc := String.from("TypeInfo.Trait(");
        uc.push_string(empty_fields);
        uc.push_str(", TraitKind.Future(");
        uc.push_string(out_name);
        uc.push_str(", ");
        uc.push_string(eff_name);
        uc.push_str("))");
        uc
      }
    },
    // === Function(info) === (type-fns.ts:849-856)
    .Func({ forall_types : fn_fts, param_types : fn_pts, implicit_types : fn_its, result : fn_res, meta : fn_meta, variadic_types : fn_vts }) => {
      fni_name := _ti_bind_function_info(
        local_env,
        fn_meta.*.param_labels,
        fn_pts,
        fn_meta.*.forall_labels,
        fn_fts,
        fn_meta.*.implicit_labels,
        fn_its,
        fn_res,
        fn_vts,
        match(fn_meta.*.variadic_label, .Some(vl) => vl.clone(), .None => String.from("...")),
        fn_meta.*.variadic_comptime,
        ctx,
        exn
      );
      {
        nc := String.from("TypeInfo.Function(");
        nc.push_string(fni_name);
        nc.push_str(")");
        nc
      }
    },
    _ => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("__yo_type_get_info: unsupported type variant")
          )
        )
      );
      String.from("TypeInfo.Unit")
    }
  );
  // Evaluate the TypeInfo constructor code string.
  info_expr := generate_expr_from_code(code.clone(), exn);
  old_force := ctx.force_compile_time_bindings;
  ctx.force_compile_time_bindings = true;
  result_ast := evaluate_expression(info_expr, local_env, ctx);
  ctx.force_compile_time_bindings = old_force;
  result_info := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(result_ast)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            String.from("__yo_type_get_info: failed to create TypeInfo value")
          )
        )
      );
      new_expr_info(local_env, t_unit())
    }
  );
  out := new_expr_info(info0.env, result_info.ty);
  out.value = result_info.value;
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
  expr
});
/// comptime_eval(code_string) -> ()
/// Parses and evaluates a comptime_str as Yo code. Returns unit.
evaluate_comptime_eval :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg0 := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval0 := evaluate_expression(arg0, env, ctx);
  info0 := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval0)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg0),
            String.from("comptime_eval: failed to evaluate argument")
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  (local_env : Environment) = info0.env;
  // Non-StrLit value (e.g. UnknownVal for SomeType) → return unit silently.
  is_str := match(info0.value, .Some(v) => is_str_lit(v), .None => false);
  if(!(is_str), {
    out := new_expr_info(local_env, t_unit());
    out.value = Option(EvalValue).Some(EvalValue.UnitVal);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
    return(expr);
  });
  // Extract the code string from StrLit.raw.
  raw := match(
    info0.value,
    .Some(v) => match(v, .StrLit(r) => r, _ => String.from("")),
    .None => String.from("")
  );
  n_raw := raw.len();
  code_str := if(
    raw.starts_with(String.from("\"")),
    raw.substring(usize(1), n_raw - usize(1)),
    raw
  );
  // Parse and evaluate each expression in the code string.
  code_exprs := generate_exprs_from_code(code_str.clone(), exn);
  (ci : usize) = usize(0);
  n_exprs := code_exprs.len();
  while(ci < n_exprs, {
    code_expr := match(code_exprs.get(ci), .Some(e) => e, .None => make_err_expr());
    old_force := ctx.force_compile_time_bindings;
    ctx.force_compile_time_bindings = false;
    ce_result := evaluate_expression(code_expr, local_env, ctx);
    ctx.force_compile_time_bindings = old_force;
    ce_info := match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(ce_result)),
      .Some(i) => i,
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg0),
              String.from("comptime_eval: failed to evaluate code expression")
            )
          )
        );
        new_expr_info(local_env, t_unit())
      }
    );
    local_env = ce_info.env;
    ci = (ci + usize(1));
  });
  out := new_expr_info(local_env, t_unit());
  out.value = Option(EvalValue).Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
  expr
});
/// __yo_comptime_string_to_expr(code : comptime_str) -> comptime(Expr)
/// Parses a comptime_str as a Yo expression and returns it as a comptime Expr.
evaluate_comptime_string_to_expr :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg0 := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval0 := evaluate_expression(arg0, env, ctx);
  info0 := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval0)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg0),
            String.from("__yo_comptime_string_to_expr: failed to evaluate argument")
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  (local_env : Environment) = info0.env;
  // If the value is not a StrLit, return UnknownVal(Expr) or throw.
  is_str := match(info0.value, .Some(v) => is_str_lit(v), .None => false);
  if(!(is_str), {
    match(
      info0.value,
      .Some(_) => {
        // Value exists but is not a comptime_str → return unknown Expr.
        unknown_val := create_unknown_val(t_expr_t());
        out := new_expr_info(local_env, t_expr_t());
        out.value = Option(EvalValue).Some(unknown_val);
        expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
        return(expr);
      },
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg0),
              String.from("__yo_comptime_string_to_expr: expected a comptime_str argument")
            )
          )
        );
      }
    );
  });
  // Extract code string from StrLit.raw.
  raw := match(
    info0.value,
    .Some(v) => match(v, .StrLit(r) => r, _ => String.from("")),
    .None => String.from("")
  );
  n_raw := raw.len();
  code_str := if(
    raw.starts_with(String.from("\"")),
    raw.substring(usize(1), n_raw - usize(1)),
    raw
  );
  // Parse a single expression.
  parsed_expr := generate_expr_from_code(code_str.clone(), exn);
  expr_val := EvalValue.ExprVal(parsed_expr);
  out := new_expr_info(local_env, t_expr_t());
  out.value = Option(EvalValue).Some(expr_val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
  expr
});
/// __yo_type_join_fields(T, mapper, combiner) -> comptime(Expr)
/// For each field of struct T, calls mapper(FieldInfo) → Expr, then combines
/// all Exprs left-associatively using the combiner operator.
evaluate_type_join_fields :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg0 := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  arg1 := match(
    args.get(usize(1)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  arg2 := match(
    args.get(usize(2)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  // Evaluate T.
  eval0 := evaluate_expression(arg0, env, ctx);
  info0 := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval0)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg0),
            String.from("__yo_type_join_fields: failed to evaluate type argument")
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  (local_env : Environment) = info0.env;
  target_type := _extract_type_val(arg0, info0, "__yo_type_join_fields", exn);
  // SomeType → return UnknownVal(Expr).
  if(is_some_type(target_type), {
    unknown_val := create_unknown_val(t_expr_t());
    out := new_expr_info(local_env, t_expr_t());
    out.value = Option(EvalValue).Some(unknown_val);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
    return(expr);
  });
  if(!(is_struct_type(target_type)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg0),
          String.from("__yo_type_join_fields: expected a struct type")
        )
      )
    );
  });
  // Evaluate mapper.
  eval1 := evaluate_expression(arg1, local_env, ctx);
  info1 := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval1)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg1),
            String.from("__yo_type_join_fields: failed to evaluate mapper")
          )
        )
      );
      new_expr_info(local_env, t_unit())
    }
  );
  local_env = info1.env;
  mapper_val := match(
    info1.value,
    .Some(v) => if(is_func_val(v), v, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg1),
            String.from("__yo_type_join_fields: second argument must be a function")
          )
        )
      );
      EvalValue.UnitVal
    }),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg1),
            String.from("__yo_type_join_fields: mapper is a runtime expression")
          )
        )
      );
      EvalValue.UnitVal
    }
  );
  // Evaluate combiner.
  eval2 := evaluate_expression(arg2, local_env, ctx);
  info2 := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval2)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg2),
            String.from("__yo_type_join_fields: failed to evaluate combiner")
          )
        )
      );
      new_expr_info(local_env, t_unit())
    }
  );
  local_env = info2.env;
  combiner_expr := match(
    info2.value,
    .Some(v) => match(
      v,
      .ExprVal(e_box) => e_box,
      _ => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg2),
              String.from("__yo_type_join_fields: third argument must be a quoted expression")
            )
          )
        );
        make_err_expr()
      }
    ),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg2),
            String.from("__yo_type_join_fields: combiner is a runtime expression")
          )
        )
      );
      make_err_expr()
    }
  );
  // Bind mapper to a temp var so it can be called by name.
  mapper_name := `__dm_${random_id(local_env.module_path)}`;
  _add_mapper := add_variable_to_env(
    local_env,
    mapper_name.clone(),
    info1.ty,
    Option(EvalValue).Some(mapper_val),
    true,
    false,
    false,
    false,
    synthetic_token(mapper_name.clone(), local_env.module_path)
  );
  // Collect struct field label/type lists.
  struct_labels := match(
    target_type,
    .Struct({ field_labels : ls }) => ls,
    _ => ArrayList(String).new()
  );
  struct_types := match(
    target_type,
    .Struct({ field_types : ts }) => ts,
    _ => ArrayList(TypeValue).new()
  );
  n_fields := struct_labels.len();
  if(n_fields == usize(0), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          String.from("__yo_type_join_fields: struct has no fields")
        )
      )
    );
  });
  // For each field, build FieldInfo and call mapper.
  // Resolve the DECLARED `FieldInfo` struct type once for the temp-var
  // bindings — same TS `value.type` parity (and same lossy
  // `type_of_eval_value` pitfall) as the `VariantInfo` resolution in
  // `evaluate_type_map_variants` below.
  fi_declared_ty_opt := match(
    _ti_eval_code(local_env, String.from("FieldInfo"), ctx, exn),
    .Some(fi_tv) => match(fi_tv, .TypeVal(fi_tb) => Option(TypeValue).Some(fi_tb), _ => Option(TypeValue).None),
    .None => Option(TypeValue).None
  );
  result_exprs := ArrayList(AstExpr).new();
  (si : usize) = usize(0);
  while(si < n_fields, {
    label := match(struct_labels.get(si), .Some(l) => l, .None => String.from(""));
    field_ty := match(struct_types.get(si), .Some(t) => t, .None => t_unit());
    // Build FieldInfo("label", type_var).
    ft_name := _ti_bind_type(local_env, field_ty, ctx);
    escaped_label := _ti_escape_str(label);
    fi_code := ((((String.from("FieldInfo(\"") + escaped_label) + String.from("\", ")) + ft_name) + String.from(")"));
    fi_val_opt := _ti_eval_code(local_env, fi_code, ctx, exn);
    fi_val := match(fi_val_opt, .Some(v) => v, .None => EvalValue.UnitVal);
    fi_type := match(fi_declared_ty_opt, .Some(dt) => dt, .None => type_of_eval_value(fi_val));
    // Bind FieldInfo to temp var, then call mapper(fi_name).
    fi_name := `__da_${random_id(local_env.module_path)}`;
    _add_fi := add_variable_to_env(
      local_env,
      fi_name.clone(),
      fi_type,
      Option(EvalValue).Some(fi_val),
      true,
      false,
      false,
      false,
      synthetic_token(fi_name.clone(), local_env.module_path)
    );
    call_code := (((mapper_name + String.from("(")) + fi_name) + String.from(")"));
    call_ast := generate_expr_from_code(call_code.clone(), exn);
    old_force := ctx.force_compile_time_bindings;
    old_expected := ctx.expected_type;
    ctx.force_compile_time_bindings = true;
    ctx.expected_type = Option(ExpectedTypeCtx).None;
    call_result := evaluate_expression(call_ast, local_env, ctx);
    ctx.force_compile_time_bindings = old_force;
    ctx.expected_type = old_expected;
    call_info := match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(call_result)),
      .Some(i) => i,
      .None => new_expr_info(local_env, t_unit())
    );
    local_env = call_info.env;
    result_expr := match(
      call_info.value,
      .Some(v) => match(
        v,
        .ExprVal(e_box) => e_box,
        _ => {
          exn.throw(
            dyn(
              format_error_message(
                ast_expr_token(arg1),
                String.from("__yo_type_join_fields: mapper must return(comptime(Expr))")
              )
            )
          );
          make_err_expr()
        }
      ),
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg1),
              String.from("__yo_type_join_fields: mapper returned no value")
            )
          )
        );
        make_err_expr()
      }
    );
    _push := result_exprs.push(result_expr);
    si = (si + usize(1));
  });
  // Combine all Exprs left-associatively using combiner token.
  tok := ast_expr_token(combiner_expr);
  (acc_expr : AstExpr) = match(result_exprs.get(usize(0)), .Some(e) => e, .None => make_err_expr());
  (ri : usize) = usize(1);
  while(ri < result_exprs.len(), {
    rhs := match(result_exprs.get(ri), .Some(e) => e, .None => make_err_expr());
    combine_args := ArrayList(AstExpr).new();
    _p1 := combine_args.push(acc_expr);
    _p2 := combine_args.push(rhs);
    acc_expr = AstExpr.FnCall(usize(0), AstExpr.Atom(usize(0), tok), combine_args, true, tok);
    ri = (ri + usize(1));
  });
  combined_val := EvalValue.ExprVal(acc_expr);
  out := new_expr_info(local_env, t_expr_t());
  out.value = Option(EvalValue).Some(combined_val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
  expr
});
/// __yo_type_map_variants(T, mapper) -> comptime(ComptimeList(Expr))
/// For each variant of enum T, calls mapper(VariantInfo) → Expr and returns
/// a ComptimeList(Expr) for use with unquote_splicing.
evaluate_type_map_variants :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg0 := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  arg1 := match(
    args.get(usize(1)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  // Evaluate T.
  eval0 := evaluate_expression(arg0, env, ctx);
  info0 := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval0)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg0),
            String.from("__yo_type_map_variants: failed to evaluate type argument")
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  (local_env : Environment) = info0.env;
  target_type := _extract_type_val(arg0, info0, "__yo_type_map_variants", exn);
  // SomeType → return UnknownVal(ComptimeList(Expr)).
  if(is_some_type(target_type), {
    list_type := t_comptime_list(t_expr_t());
    unknown_val := create_unknown_val(list_type);
    out := new_expr_info(local_env, list_type);
    out.value = Option(EvalValue).Some(unknown_val);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
    return(expr);
  });
  if(!(is_enum_type(target_type)), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg0),
          String.from("__yo_type_map_variants: expected an enum type")
        )
      )
    );
  });
  // Evaluate mapper.
  eval1 := evaluate_expression(arg1, local_env, ctx);
  info1 := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval1)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg1),
            String.from("__yo_type_map_variants: failed to evaluate mapper")
          )
        )
      );
      new_expr_info(local_env, t_unit())
    }
  );
  local_env = info1.env;
  mapper_val := match(
    info1.value,
    .Some(v) => if(is_func_val(v), v, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg1),
            String.from("__yo_type_map_variants: second argument must be a function")
          )
        )
      );
      EvalValue.UnitVal
    }),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg1),
            String.from("__yo_type_map_variants: mapper is a runtime expression")
          )
        )
      );
      EvalValue.UnitVal
    }
  );
  // Bind mapper to a temp var.
  mapper_name := `__dvm_${random_id(local_env.module_path)}`;
  _add_mapper := add_variable_to_env(
    local_env,
    mapper_name.clone(),
    info1.ty,
    Option(EvalValue).Some(mapper_val),
    true,
    false,
    false,
    false,
    synthetic_token(mapper_name.clone(), local_env.module_path)
  );
  // Extract enum variant data.
  variant_names := match(target_type, .EnumT(_, _, vn, _, _, _, _, _, _) => vn, _ => ArrayList(String).new());
  variant_fields := match(target_type, .EnumT(_, _, _, vf, _, _, _, _, _) => vf, _ => ArrayList(ArrayList(TypeValue)).new());
  variant_field_labels := match(target_type, .EnumT(_, _, _, _, _, vfl, _, _, _) => vfl, _ => ArrayList(ArrayList(String)).new());
  // Resolve the DECLARED `VariantInfo` struct type from the env once — the
  // type each per-variant temp var is bound with. Mirrors TS `argType:
  // variantInfoValue.type` (type-fns.ts callMapperWithArg): TS values carry
  // their evaluated type. yo-self values don't, and the
  // `type_of_eval_value(vi_val)` stand-in reconstructs field types from field
  // VALUES — lossy for `ComptimeListVal` fields (no case → `unit`), so the
  // mapper param's `fields` slot lost its ComptimeList type and
  // `variant.fields.len()` found no method (dispatch on `unit` → 0 hits) —
  // the derive-enum mapper never folded. Fall back to the old reconstruction
  // if the name is not resolvable here.
  vi_declared_ty_opt := match(
    _ti_eval_code(local_env, String.from("VariantInfo"), ctx, exn),
    .Some(vi_tv) => match(vi_tv, .TypeVal(vi_tb) => Option(TypeValue).Some(vi_tb), _ => Option(TypeValue).None),
    .None => Option(TypeValue).None
  );
  result_vals := ArrayList(EvalValue).new();
  (vi : usize) = usize(0);
  n_variants := variant_names.len();
  while(vi < n_variants, {
    v_name := match(variant_names.get(vi), .Some(nm) => nm, .None => String.from(""));
    v_fields := match(variant_fields.get(vi), .Some(f) => f, .None => ArrayList(TypeValue).new());
    v_field_labels := match(variant_field_labels.get(vi), .Some(l) => l, .None => ArrayList(String).new());
    // Build VariantInfo value.
    vi_val := _ti_build_variant_info(local_env, v_name, v_field_labels, v_fields, target_type, vi, ctx, exn);
    vi_type := match(vi_declared_ty_opt, .Some(dt) => dt, .None => type_of_eval_value(vi_val));
    // Bind VariantInfo to temp var, then call mapper(vi_var_name).
    vi_name := `__dvi_${random_id(local_env.module_path)}`;
    _add_vi := add_variable_to_env(
      local_env,
      vi_name.clone(),
      vi_type,
      Option(EvalValue).Some(vi_val),
      true,
      false,
      false,
      false,
      synthetic_token(vi_name.clone(), local_env.module_path)
    );
    call_code := (((mapper_name + String.from("(")) + vi_name) + String.from(")"));
    call_ast := generate_expr_from_code(call_code.clone(), exn);
    old_force := ctx.force_compile_time_bindings;
    old_expected := ctx.expected_type;
    ctx.force_compile_time_bindings = true;
    ctx.expected_type = Option(ExpectedTypeCtx).None;
    call_result := evaluate_expression(call_ast, local_env, ctx);
    ctx.force_compile_time_bindings = old_force;
    ctx.expected_type = old_expected;
    call_info := match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(call_result)),
      .Some(i) => i,
      .None => new_expr_info(local_env, t_unit())
    );
    local_env = call_info.env;
    // The mapper result should be an ExprVal; wrap it as-is for the list.
    result_ev := match(
      call_info.value,
      .Some(v) => v,
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(arg1),
              String.from("__yo_type_map_variants: mapper returned no value")
            )
          )
        );
        EvalValue.UnitVal
      }
    );
    _push := result_vals.push(result_ev);
    vi = (vi + usize(1));
  });
  // Return a ComptimeList(Expr).
  list_type := t_comptime_list(t_expr_t());
  list_val := EvalValue.ComptimeListVal(result_vals);
  out := new_expr_info(local_env, list_type);
  out.value = Option(EvalValue).Some(list_val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out);
  expr
});
export(
  evaluate_yo_are_types_compatible,
  evaluate_yo_are_types_equal,
  evaluate_yo_type_can_form_rc_cycle,
  evaluate_yo_type_contains_rc_type,
  evaluate_yo_type_impls,
  evaluate_yo_type_to_string,
  evaluate_yo_type_get_info,
  evaluate_comptime_eval,
  evaluate_comptime_string_to_expr,
  evaluate_type_join_fields,
  evaluate_type_map_variants,
  format_type_field_info_call,
  format_variant_info_call
);
