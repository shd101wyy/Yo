//! evaluator/builtins/build — build-system data types, `BuildRegistry`,
//! and the `evaluate_yo_build_functions` evaluator entry point.
//!
//! 1-to-1 port of `src/evaluator/builtins/build.ts`, which holds:
//!
//!   1. The interface / class shapes for build artifacts, dependencies,
//!      and steps (`BuildArtifact`, `BuildTestSuite`, `BuildRunStep`,
//!      `BuildStep`, `BuildGitDependency`, …).
//!   2. The `BuildRegistry` class with all registration / lookup
//!      methods that populate it during `build.yo` evaluation.
//!   3. The `evaluateYoBuildFunctions` evaluator entry point that
//!      dispatches the `__yo_build_*` builtins to registry mutators.
//!
//! Parts (1) and (2) live here as data-type definitions + an `impl`
//! block; part (3) is the `evaluate_yo_build_functions` dispatch at the
//! bottom, which populates the module-level global registry that
//! `get_build_registry` hands out.
//!
//! (Previously, parts (1) and (2) lived in a separate
//! `src/build/build_registry.yo` file with no TS counterpart.
//! That file was folded in here so the structural mapping is 1-to-1.)
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ AnyError, Exception } :: import("std/error");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_fn_call_of,
  BF_YO_BUILD_TARGET_HOST,
  BF_YO_BUILD_TARGET_PARSE,
  BF_YO_BUILD_OPTION,
  BF_YO_BUILD_DEP_MODULE,
  BF_YO_BUILD_EXECUTABLE,
  BF_YO_BUILD_STATIC_LIBRARY,
  BF_YO_BUILD_SHARED_LIBRARY,
  BF_YO_BUILD_TEST,
  BF_YO_BUILD_RUN,
  BF_YO_BUILD_STEP,
  BF_YO_BUILD_STEP_DEPEND_ON,
  BF_YO_BUILD_DEPENDENCY,
  BF_YO_BUILD_PATH_DEPENDENCY,
  BF_YO_BUILD_SYSTEM_LIBRARY,
  BF_YO_BUILD_LINK,
  BF_YO_BUILD_LINK_SYSTEM_LIBRARY,
  BF_YO_BUILD_DEP_ARTIFACT,
  BF_YO_BUILD_MODULE,
  BF_YO_BUILD_MODULE_LINK,
  BF_YO_BUILD_ADD_IMPORT,
  BF_YO_BUILD_ADD_CFLAGS,
  BF_YO_BUILD_DOC
} :: import("../../expr.yo");
{ new_expr_info, expr_info_table_get, expr_info_table_set } :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue } :: import("../../value.yo");
{ t_unit, t_comptime_string } :: import("../../types/creators.yo");
{ host_target, parse_target, TargetInfo } :: import("../../target.yo");
{ format_error_message } :: import("../../error.yo");
// ---------------------------------------------------------------------------
// Data types  (mirrors TypeScript interfaces in build.ts)
// ---------------------------------------------------------------------------
ArtifactKind :: enum(Executable, StaticLibrary, SharedLibrary);
ImportedModule :: ref(
  struct(
    import_name : String,
    module_name : String,
    dependency_name : String,
    resolved_root : Option(String),
    propagated_system_libs : ArrayList(String)
  )
);
BuildArtifact :: ref(
  struct(
    kind : ArtifactKind,
    name : String,
    root : String,
    target : String,
    optimize : String,
    allocator : String,
    sanitize : String,
    /// Redirect the single generated C file here ("" = default sidecar).
    /// REQUIRED, not defaulted: `?=` needs a compile-time-known value and
    /// `String.new()` is a runtime call ("Expected compile-time known value
    /// for default value"). So every BuildArtifact literal must pass it —
    /// including the one in tests/internal/build_runner.test.yo, which is the
    /// site the TS build-system tests could not see and CI caught.
    emit_c_to : String,
    /// Split the emitted C into this many translation units (0 = off). See
    /// plans/CHUNKED_C_EMISSION.md. Same "must be passed explicitly" caveat
    /// as `emit_c_to` above: a `?=` default needs a compile-time-known value.
    emit_chunks : usize,
    link_libraries : ArrayList(String),
    include_paths : ArrayList(String),
    library_paths : ArrayList(String),
    c_sources : ArrayList(String),
    c_flags : ArrayList(String),
    defines : ArrayList(String),
    strip : bool,
    static_link : bool,
    runtime_files : ArrayList(String),
    linked_artifacts : ArrayList(String),
    linked_system_libs : ArrayList(String),
    imported_modules : ArrayList(ImportedModule)
  )
);
BuildTestSuite :: ref(
  struct(
    name : String,
    root : String,
    target : String,
    verbose : bool,
    bail : bool,
    parallel : i32,
    /// Project-relative paths (files or directories) excluded from the walk.
    exclude : ArrayList(String)
  )
);
BuildRunStep :: ref(
  struct(
    name : String,
    artifact_name : String,
    args : ArrayList(String)
  )
);
BuildStep :: ref(
  struct(
    name : String,
    description : String,
    dependency_names : ArrayList(String)
  )
);
BuildGitDependency :: ref(
  struct(
    name : String,
    url : String,
    ref : String,
    path : String
  )
);
BuildPathDependency :: ref(
  struct(
    name : String,
    path : String
  )
);
BuildSystemLibrary :: ref(
  struct(
    name : String,
    fallback_include : String,
    fallback_lib : String,
    fallback_link : String,
    defines : ArrayList(String)
  )
);
DependencyArtifactRef :: ref(
  struct(
    dependency_name : String,
    artifact_name : String
  )
);
BuildModuleEntry :: ref(
  struct(
    name : String,
    root : String,
    linked_system_libraries : ArrayList(String)
  )
);
BuildDocConfig :: ref(
  struct(
    name : String,
    root : String,
    output_dir : String,
    format : String,
    include_private : bool,
    include_deps : bool,
    title : String,
    logo : String,
    favicon : String,
    version : String
  )
);
/// A `-D<name>=<value>` option declared by `build.option(...)`.
/// Mirrors the `{ description, defaultValue }` value type of TS's
/// `BuildRegistry.declaredOptions`.
BuildDeclaredOption :: ref(
  struct(
    description : String,
    default_value : String
  )
);
/// Result of resolving a dependency name to its concrete type.
ResolvedDep :: enum(
  Artifact(value : BuildArtifact),
  Test(value : BuildTestSuite),
  Run(value : BuildRunStep),
  Doc(value : BuildDocConfig),
  Step(value : BuildStep)
);
// ---------------------------------------------------------------------------
// BuildRegistry
// ---------------------------------------------------------------------------
/// Central registry populated by `build.yo` evaluation.
/// Mirrors the `BuildRegistry` class in `src/evaluator/builtins/build.ts`.
BuildRegistry :: ref(
  struct(
    artifacts : ArrayList(BuildArtifact),
    test_suites : ArrayList(BuildTestSuite),
    run_steps : ArrayList(BuildRunStep),
    steps : ArrayList(BuildStep),
    dependencies : ArrayList(BuildGitDependency),
    path_dependencies : ArrayList(BuildPathDependency),
    system_libraries : ArrayList(BuildSystemLibrary),
    dependency_artifacts : ArrayList(DependencyArtifactRef),
    modules : ArrayList(BuildModuleEntry),
    doc_configs : ArrayList(BuildDocConfig),
    cli_options : HashMap(String, String),
    declared_options : HashMap(String, BuildDeclaredOption)
  )
);
impl(
  BuildRegistry,
  new : (fn() -> Self)(
    Self(
      artifacts : ArrayList(BuildArtifact).new(),
      test_suites : ArrayList(BuildTestSuite).new(),
      run_steps : ArrayList(BuildRunStep).new(),
      steps : ArrayList(BuildStep).new(),
      dependencies : ArrayList(BuildGitDependency).new(),
      path_dependencies : ArrayList(BuildPathDependency).new(),
      system_libraries : ArrayList(BuildSystemLibrary).new(),
      dependency_artifacts : ArrayList(DependencyArtifactRef).new(),
      modules : ArrayList(BuildModuleEntry).new(),
      doc_configs : ArrayList(BuildDocConfig).new(),
      cli_options : HashMap(String, String).new(),
      declared_options : HashMap(String, BuildDeclaredOption).new()
    )
  ),
  register_executable : (fn(inout(self) : Self, artifact : BuildArtifact, exn : Exception) -> unit)({
    Self._check_duplicate_artifact_name(self, artifact.name.clone(), exn);
    self.artifacts.push(
      BuildArtifact(
        kind : ArtifactKind.Executable,
        name : artifact.name,
        root : artifact.root,
        target : artifact.target,
        optimize : artifact.optimize,
        allocator : artifact.allocator,
        sanitize : artifact.sanitize,
        emit_c_to : artifact.emit_c_to,
        emit_chunks : artifact.emit_chunks,
        link_libraries : artifact.link_libraries,
        include_paths : artifact.include_paths,
        library_paths : artifact.library_paths,
        c_sources : artifact.c_sources,
        c_flags : artifact.c_flags,
        defines : artifact.defines,
        strip : artifact.strip,
        static_link : artifact.static_link,
        runtime_files : artifact.runtime_files,
        linked_artifacts : artifact.linked_artifacts,
        linked_system_libs : artifact.linked_system_libs,
        imported_modules : artifact.imported_modules
      )
    );
  }),
  register_static_library : (fn(inout(self) : Self, artifact : BuildArtifact, exn : Exception) -> unit)({
    Self._check_duplicate_artifact_name(self, artifact.name.clone(), exn);
    self.artifacts.push(
      BuildArtifact(
        kind : ArtifactKind.StaticLibrary,
        name : artifact.name,
        root : artifact.root,
        target : artifact.target,
        optimize : artifact.optimize,
        allocator : artifact.allocator,
        sanitize : artifact.sanitize,
        emit_c_to : artifact.emit_c_to,
        emit_chunks : artifact.emit_chunks,
        link_libraries : artifact.link_libraries,
        include_paths : artifact.include_paths,
        library_paths : artifact.library_paths,
        c_sources : artifact.c_sources,
        c_flags : artifact.c_flags,
        defines : artifact.defines,
        strip : artifact.strip,
        static_link : artifact.static_link,
        runtime_files : artifact.runtime_files,
        linked_artifacts : artifact.linked_artifacts,
        linked_system_libs : artifact.linked_system_libs,
        imported_modules : artifact.imported_modules
      )
    );
  }),
  register_shared_library : (fn(inout(self) : Self, artifact : BuildArtifact, exn : Exception) -> unit)({
    Self._check_duplicate_artifact_name(self, artifact.name.clone(), exn);
    self.artifacts.push(
      BuildArtifact(
        kind : ArtifactKind.SharedLibrary,
        name : artifact.name,
        root : artifact.root,
        target : artifact.target,
        optimize : artifact.optimize,
        allocator : artifact.allocator,
        sanitize : artifact.sanitize,
        emit_c_to : artifact.emit_c_to,
        emit_chunks : artifact.emit_chunks,
        link_libraries : artifact.link_libraries,
        include_paths : artifact.include_paths,
        library_paths : artifact.library_paths,
        c_sources : artifact.c_sources,
        c_flags : artifact.c_flags,
        defines : artifact.defines,
        strip : artifact.strip,
        static_link : artifact.static_link,
        runtime_files : artifact.runtime_files,
        linked_artifacts : artifact.linked_artifacts,
        linked_system_libs : artifact.linked_system_libs,
        imported_modules : artifact.imported_modules
      )
    );
  }),
  register_test : (fn(inout(self) : Self, suite : BuildTestSuite) -> unit)({
    self.test_suites.push(suite);
  }),
  register_run : (fn(inout(self) : Self, artifact_name : String, args : ArrayList(String)) -> unit)({
    synth_name := `run:${artifact_name}`;
    self.run_steps.push(
      BuildRunStep(
        name : synth_name,
        artifact_name : artifact_name,
        args : args
      )
    );
  }),
  register_step : (fn(inout(self) : Self, name : String, description : String) -> unit)({
    self.steps.push(
      BuildStep(
        name : name,
        description : description,
        dependency_names : ArrayList(String).new()
      )
    );
  }),
  add_step_dependency : (fn(inout(self) : Self, step_name : String, dep_name : String) -> unit)({
    new_steps := ArrayList(BuildStep).new();
    i := usize(0);
    n := self.steps.len();
    while(i < n, {
      step := self.steps(i);
      if(step.name == step_name, {
        already := false;
        j := usize(0);
        m := step.dependency_names.len();
        while(j < m, {
          if(step.dependency_names(j) == dep_name, {
            already = true;
          });
          j = (j + usize(1));
        });
        cond(
          already => (),
          true => {
            step.dependency_names.push(dep_name);
          }
        );
      });
      new_steps.push(step);
      i = (i + usize(1));
    });
    self.steps = new_steps;
  }),
  register_dependency : (fn(inout(self) : Self, dep : BuildGitDependency) -> unit)({
    self.dependencies.push(dep);
  }),
  register_path_dependency : (fn(inout(self) : Self, dep : BuildPathDependency) -> unit)({
    self.path_dependencies.push(dep);
  }),
  register_system_library : (fn(inout(self) : Self, lib : BuildSystemLibrary) -> unit)({
    self.system_libraries.push(lib);
  }),
  register_dependency_artifact : (fn(inout(self) : Self, ref : DependencyArtifactRef) -> unit)({
    already := false;
    i := usize(0);
    n := self.dependency_artifacts.len();
    while(i < n, {
      r := self.dependency_artifacts(i);
      if((r.dependency_name == ref.dependency_name) && (r.artifact_name == ref.artifact_name), {
        already = true;
      });
      i = (i + usize(1));
    });
    cond(
      already => (),
      true => {
        self.dependency_artifacts.push(ref);
      }
    );
  }),
  register_module : (fn(inout(self) : Self, entry : BuildModuleEntry) -> unit)({
    i := usize(0);
    n := self.modules.len();
    while(i < n, {
      if(self.modules(i).name == entry.name, return(()));
      i = (i + usize(1));
    });
    self.modules.push(entry);
    ()
  }),
  register_link : (fn(inout(self) : Self, artifact_name : String, library_name : String) -> unit)({
    new_artifacts := ArrayList(BuildArtifact).new();
    i := usize(0);
    n := self.artifacts.len();
    while(i < n, {
      art := self.artifacts(i);
      if(art.name == artifact_name, {
        already := false;
        j := usize(0);
        m := art.linked_artifacts.len();
        while(j < m, {
          if(art.linked_artifacts(j) == library_name, {
            already = true;
          });
          j = (j + usize(1));
        });
        cond(
          already => (),
          true => {
            art.linked_artifacts.push(library_name);
          }
        );
      });
      new_artifacts.push(art);
      i = (i + usize(1));
    });
    self.artifacts = new_artifacts;
  }),
  register_doc : (fn(inout(self) : Self, config : BuildDocConfig) -> unit)({
    self.doc_configs.push(config);
  }),
  /// Attach a system library to a registered module. No-op when the module is
  /// unknown or the library is already attached. Mirrors `registerModuleLink`.
  register_module_link : (fn(inout(self) : Self, module_name : String, system_library_name : String) -> unit)({
    i := usize(0);
    n := self.modules.len();
    while(i < n, {
      m := self.modules(i);
      if(m.name == module_name, {
        already := false;
        j := usize(0);
        k := m.linked_system_libraries.len();
        while(j < k, {
          if(m.linked_system_libraries(j) == system_library_name, {
            already = true;
          });
          j = (j + usize(1));
        });
        cond(
          already => (),
          true => {
            m.linked_system_libraries.push(system_library_name.clone());
          }
        );
        return(());
      });
      i = (i + usize(1));
    });
    ()
  }),
  /// Attach an imported module to a registered artifact. Silently ignores a
  /// duplicate `import_name` (the caller diagnoses that) and an unknown
  /// artifact. Mirrors `registerImportedModule`.
  register_imported_module : (fn(inout(self) : Self, artifact_name : String, imported : ImportedModule) -> unit)({
    i := usize(0);
    n := self.artifacts.len();
    while(i < n, {
      a := self.artifacts(i);
      if(a.name == artifact_name, {
        j := usize(0);
        m := a.imported_modules.len();
        while(j < m, {
          if(a.imported_modules(j).import_name == imported.import_name, {
            return(());
          });
          j = (j + usize(1));
        });
        a.imported_modules.push(imported);
        return(());
      });
      i = (i + usize(1));
    });
    ()
  }),
  find_artifact : (fn(inout(self) : Self, name : String) -> Option(BuildArtifact))({
    i := usize(0);
    n := self.artifacts.len();
    while(i < n, {
      a := self.artifacts(i);
      if(a.name == name, return(Option(BuildArtifact).Some(a)));
      i = (i + usize(1));
    });
    Option(BuildArtifact).None
  }),
  find_test : (fn(inout(self) : Self, name : String) -> Option(BuildTestSuite))({
    i := usize(0);
    n := self.test_suites.len();
    while(i < n, {
      t := self.test_suites(i);
      if(t.name == name, return(Option(BuildTestSuite).Some(t)));
      i = (i + usize(1));
    });
    Option(BuildTestSuite).None
  }),
  find_run_step : (fn(inout(self) : Self, name : String) -> Option(BuildRunStep))({
    i := usize(0);
    n := self.run_steps.len();
    while(i < n, {
      r := self.run_steps(i);
      if(r.name == name, return(Option(BuildRunStep).Some(r)));
      i = (i + usize(1));
    });
    Option(BuildRunStep).None
  }),
  find_step : (fn(inout(self) : Self, name : String) -> Option(BuildStep))({
    i := usize(0);
    n := self.steps.len();
    while(i < n, {
      s := self.steps(i);
      if(s.name == name, return(Option(BuildStep).Some(s)));
      i = (i + usize(1));
    });
    Option(BuildStep).None
  }),
  find_documentation : (fn(inout(self) : Self, name : String) -> Option(BuildDocConfig))({
    i := usize(0);
    n := self.doc_configs.len();
    while(i < n, {
      d := self.doc_configs(i);
      if(d.name == name, return(Option(BuildDocConfig).Some(d)));
      i = (i + usize(1));
    });
    Option(BuildDocConfig).None
  }),
  find_module : (fn(inout(self) : Self, name : String) -> Option(BuildModuleEntry))({
    i := usize(0);
    n := self.modules.len();
    while(i < n, {
      m := self.modules(i);
      if(m.name == name, return(Option(BuildModuleEntry).Some(m)));
      i = (i + usize(1));
    });
    Option(BuildModuleEntry).None
  }),
  find_dependency : (fn(inout(self) : Self, name : String) -> Option(BuildGitDependency))({
    i := usize(0);
    n := self.dependencies.len();
    while(i < n, {
      d := self.dependencies(i);
      if(d.name == name, return(Option(BuildGitDependency).Some(d)));
      i = (i + usize(1));
    });
    Option(BuildGitDependency).None
  }),
  find_path_dependency : (fn(inout(self) : Self, name : String) -> Option(BuildPathDependency))({
    i := usize(0);
    n := self.path_dependencies.len();
    while(i < n, {
      d := self.path_dependencies(i);
      if(d.name == name, return(Option(BuildPathDependency).Some(d)));
      i = (i + usize(1));
    });
    Option(BuildPathDependency).None
  }),
  find_system_library : (fn(inout(self) : Self, name : String) -> Option(BuildSystemLibrary))({
    i := usize(0);
    n := self.system_libraries.len();
    while(i < n, {
      l := self.system_libraries(i);
      if(l.name == name, return(Option(BuildSystemLibrary).Some(l)));
      i = (i + usize(1));
    });
    Option(BuildSystemLibrary).None
  }),
  get_step_names : (fn(inout(self) : Self) -> ArrayList(String))({
    names := ArrayList(String).new();
    i := usize(0);
    n := self.steps.len();
    while(i < n, {
      names.push(self.steps(i).name);
      i = (i + usize(1));
    });
    names
  }),
  resolve_dependency : (fn(inout(self) : Self, name : String) -> Option(ResolvedDep))({
    match(
      self.find_artifact(name),
      .Some(a) => {
        return(Option(ResolvedDep).Some(ResolvedDep.Artifact(a)));
      },
      .None => ()
    );
    match(
      self.find_test(name),
      .Some(t) => {
        return(Option(ResolvedDep).Some(ResolvedDep.Test(t)));
      },
      .None => ()
    );
    match(
      self.find_run_step(name),
      .Some(r) => {
        return(Option(ResolvedDep).Some(ResolvedDep.Run(r)));
      },
      .None => ()
    );
    match(
      self.find_documentation(name),
      .Some(d) => {
        return(Option(ResolvedDep).Some(ResolvedDep.Doc(d)));
      },
      .None => ()
    );
    match(
      self.find_step(name),
      .Some(s) => {
        return(Option(ResolvedDep).Some(ResolvedDep.Step(s)));
      },
      .None => ()
    );
    Option(ResolvedDep).None
  }),
  clear : (fn(inout(self) : Self) -> unit)({
    self.artifacts = ArrayList(BuildArtifact).new();
    self.test_suites = ArrayList(BuildTestSuite).new();
    self.run_steps = ArrayList(BuildRunStep).new();
    self.steps = ArrayList(BuildStep).new();
    self.dependencies = ArrayList(BuildGitDependency).new();
    self.path_dependencies = ArrayList(BuildPathDependency).new();
    self.system_libraries = ArrayList(BuildSystemLibrary).new();
    self.dependency_artifacts = ArrayList(DependencyArtifactRef).new();
    self.modules = ArrayList(BuildModuleEntry).new();
    self.doc_configs = ArrayList(BuildDocConfig).new();
    self.cli_options = HashMap(String, String).new();
    self.declared_options = HashMap(String, BuildDeclaredOption).new();
  }),
  _check_duplicate_artifact_name : (fn(inout(self) : Self, name : String, exn : Exception) -> unit)({
    i := usize(0);
    n := self.artifacts.len();
    while(i < n, {
      a := self.artifacts(i);
      if(a.name == name, {
        kind_str := match(
          a.kind,
          .Executable => "executable",
          .StaticLibrary => "static_library",
          .SharedLibrary => "shared_library"
        );
        exn.throw(dyn(`Build error: Artifact "${name}" already registered as ${kind_str}. Use a unique name for each artifact.`));
      });
      i = (i + usize(1));
    });
  })
);
// ---------------------------------------------------------------------------
// The global registry
// ---------------------------------------------------------------------------
// `build.yo` evaluation populates ONE registry, which the caller then reads —
// `yo build` for the DAG, `yo fetch`/`yo install` for the dependency list. TS
// keeps it in a module-level `globalRegistry` with lazy construction; this is
// the same thing.
(g_build_registry : Option(BuildRegistry)) = Option(BuildRegistry).None;
/// The global build registry, constructed on first use. Mirrors
/// `getBuildRegistry`.
get_build_registry :: (fn() -> BuildRegistry)(
  match(
    g_build_registry,
    .Some(r) => r,
    .None => {
      r := BuildRegistry.new();
      g_build_registry = Option(BuildRegistry).Some(r);
      r
    }
  )
);
/// Empty the global registry and drop it. Mirrors `clearBuildRegistry`.
clear_build_registry :: (fn() -> unit)({
  match(
    g_build_registry,
    .Some(r) => {
      r.clear();
    },
    .None => ()
  );
  g_build_registry = Option(BuildRegistry).None;
});
/// Install `new_registry` as the global one and return the previous. Mirrors
/// `swapBuildRegistry` — the build runner uses it to evaluate a DEPENDENCY's
/// `build.yo` into a scratch registry without clobbering the project's.
swap_build_registry :: (fn(new_registry : Option(BuildRegistry)) -> Option(BuildRegistry))({
  prev := g_build_registry;
  g_build_registry = new_registry;
  prev
});
// ---------------------------------------------------------------------------
// evaluate_yo_build_functions
// ---------------------------------------------------------------------------
/// Read arg `idx`'s resolved comptime value from the expr-info table.
/// Args are pre-evaluated by the `_expr.yo` dispatch before this runs.
_build_arg_value :: (
  fn(args : ArrayList(AstExpr), idx : usize, ctx : EvalContext) -> Option(EvalValue)
)(
  match(
    args.get(idx),
    .Some(a) => match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(a)),
      .Some(info) => info.value,
      .None => Option(EvalValue).None
    ),
    .None => Option(EvalValue).None
  )
);
/// True when any argument's value is missing or `UnknownVal` — i.e. this
/// is a function-definition type-check ("trial") run rather than a real
/// call with concrete comptime args. Mirrors `isTrialEvaluation` in
/// `build.ts`. During `check`, build calls inside function bodies are
/// always trial (their comptime params are `UnknownVal`).
_build_is_trial :: (
  fn(args : ArrayList(AstExpr), ctx : EvalContext) -> bool
)({
  (i : usize) = usize(0);
  (trial : bool) = false;
  while((i < args.len()) && !(trial), {
    match(
      _build_arg_value(args, i, ctx),
      .None => {
        trial = true;
      },
      .Some(v) => match(
        v,
        .UnknownVal(_, _) => {
          trial = true;
        },
        _ => ()
      )
    );
    i = (i + usize(1));
  });
  trial
});
/// Set the expr's result to `unit`. Mirrors `makeUnitResult`.
_build_unit_result :: (
  fn(expr : AstExpr, env : Environment, ctx : EvalContext) -> AstExpr
)({
  info := new_expr_info(env, t_unit());
  info.value = Option(EvalValue).Some(EvalValue.UnitVal);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
/// Set the expr's result to a `comptime_str` carrying `value`.
/// Mirrors `makeComptimeStringResult`. `StrLit` stores the quoted source
/// form (see `builtins/process.yo`), so `value` is wrapped in quotes.
_build_string_result :: (
  fn(expr : AstExpr, env : Environment, ctx : EvalContext, value : String) -> AstExpr
)({
  raw := ((String.from("\"") + value) + String.from("\""));
  info := new_expr_info(env, t_comptime_string());
  info.value = Option(EvalValue).Some(EvalValue.StrLit(raw));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
/// Extract the (unquoted) comptime-string content of arg `idx`, throwing
/// the build-function arg-type error otherwise. Mirrors
/// `extractComptimeString`.
_build_extract_string :: (
  fn(
    args : ArrayList(AstExpr),
    idx : usize,
    param : str,
    expr : AstExpr,
    ctx : EvalContext,
    exn : Exception
  ) -> String
)(
  match(
    _build_arg_value(args, idx, ctx),
    .Some(v) => match(
      v,
      .StrLit(raw) => {
        n := raw.len();
        if(n < usize(2), String.new(), raw.substring(usize(1), n - usize(1)))
      },
      _ => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(expr),
              `Build function: expected comptime_str for "${param}", got non-string`,
              false,
              .None
            )
          )
        );
        String.new()
      }
    ),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `Build function: expected comptime_str for "${param}", got undefined`,
            false,
            .None
          )
        )
      );
      String.new()
    }
  )
);
/// Read arg `idx` as a boolean. TS uses `Boolean(expr.args[i].$?.value)`, whose
/// only falsy `EvalValue` shapes here are a missing value and `BoolVal(false)`.
_build_extract_bool :: (
  fn(args : ArrayList(AstExpr), idx : usize, ctx : EvalContext) -> bool
)(
  match(
    _build_arg_value(args, idx, ctx),
    .Some(v) => match(v, .BoolVal(b) => b, .UnitVal => false, _ => true),
    .None => false
  )
);
/// Arg `idx` as a `usize` when it is a compile-time integer literal, else
/// `fallback`. Mirrors `_build_extract_bool`'s shape; used for
/// `Executable.emit_chunks`, whose comptime_int arrives as `IntLit(raw)`.
_build_extract_usize_or :: (
  fn(args : ArrayList(AstExpr), idx : usize, fallback : usize, ctx : EvalContext) -> usize
)(
  match(
    _build_arg_value(args, idx, ctx),
    .Some(v) => match(v, .IntLit(raw) => match(raw.parse_u64(), .Some(n) => usize(n), .None => fallback), _ => fallback),
    .None => fallback
  )
);
/// The variant name of arg `idx` when it is an enum value, else `.None`.
/// Used for `build.step.depend_on`'s `dep_kind`.
/// The variant NAME of an enum-valued argument, without the leading dot.
///
/// yo-self stores enum variants dot-prefixed — `EvalValue.EnumVal(".Run", …)`,
/// built as `` `.${variant_name}` `` in `evaluator/calls/function.yo` — while
/// TS's `isEnumValue(v).variantName` is bare (`"Run"`). Callers here are ports of
/// TS comparisons against the bare name, so strip the dot at this boundary
/// rather than dot-prefixing every comparison.
///
/// Without the strip, `__yo_build_step_depend_on` never recognised a `Run`
/// dependency, so `step.depend_on(build.run(exe))` recorded the ARTIFACT name
/// instead of `run:<artifact>`. The run node then vanished from the DAG and
/// `yo build run` built the program, reported "run ok", and never executed it.
_build_extract_variant :: (
  fn(args : ArrayList(AstExpr), idx : usize, ctx : EvalContext) -> Option(String)
)(
  match(
    _build_arg_value(args, idx, ctx),
    .Some(v) => match(
      v,
      .EnumVal(variant, _) => Option(String).Some(
        if(variant.starts_with(String.from(".")), variant.substring(usize(1), variant.len()), variant.clone())
      ),
      _ => Option(String).None
    ),
    .None => Option(String).None
  )
);
/// Split `s` on runs of whitespace, dropping empty pieces — TS's
/// `.split(/\s+/).filter(Boolean)`.
_build_split_ws :: (fn(s : String) -> ArrayList(String))({
  out := ArrayList(String).new();
  cur := String.new();
  bytes := s.as_bytes();
  (i : usize) = usize(0);
  n := bytes.len();
  while(i < n, {
    b := match(bytes.get(i), .Some(x) => x, .None => u8(0));
    cond(
      ((((b == u8(32)) || (b == u8(9))) || (b == u8(10))) || (b == u8(13))) => {
        if(cur.len() > usize(0), {
          out.push(cur.clone());
          cur = String.new();
        });
      },
      true => {
        cur.push_byte(b);
      }
    );
    i = (i + usize(1));
  });
  if(cur.len() > usize(0), {
    out.push(cur);
  });
  out
});
/// Optional string arg: arg `idx` when present, else `fallback`.
_build_extract_string_or :: (
  fn(
    args : ArrayList(AstExpr),
    idx : usize,
    param : str,
    fallback : String,
    expr : AstExpr,
    ctx : EvalContext,
    exn : Exception
  ) -> String
)(
  cond(
    (args.len() > idx) => _build_extract_string(args, idx, param, expr, ctx, exn),
    true => fallback
  )
);
/// Throw the standard "expects N arguments" build-function diagnostic.
_build_require_args :: (
  fn(
    args : ArrayList(AstExpr),
    least : usize,
    message : String,
    expr : AstExpr,
    exn : Exception
  ) -> unit
)({
  if(args.len() < least, {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `${message}, got ${args.len()}`,
          false,
          .None
        )
      )
    );
  });
});
/// A `BuildArtifact` with every list empty and every flag off — the shape TS
/// spreads into `registerExecutable`/`registerStaticLibrary`/
/// `registerSharedLibrary`. `kind` is set by the registry method.
_build_new_artifact :: (
  fn(
    name : String,
    root : String,
    target : String,
    optimize : String,
    allocator : String,
    sanitize : String,
    emit_c_to : String,
    emit_chunks : usize
  ) -> BuildArtifact
)(
  BuildArtifact(
    kind : ArtifactKind.Executable,
    name : name,
    root : root,
    target : target,
    optimize : optimize,
    allocator : allocator,
    sanitize : sanitize,
    emit_c_to : emit_c_to,
    emit_chunks : emit_chunks,
    link_libraries : ArrayList(String).new(),
    include_paths : ArrayList(String).new(),
    library_paths : ArrayList(String).new(),
    c_sources : ArrayList(String).new(),
    c_flags : ArrayList(String).new(),
    defines : ArrayList(String).new(),
    strip : false,
    static_link : false,
    runtime_files : ArrayList(String).new(),
    linked_artifacts : ArrayList(String).new(),
    linked_system_libs : ArrayList(String).new(),
    imported_modules : ArrayList(ImportedModule).new()
  )
);
/// Attach `library_name` to `artifact_name`'s system-library list, if the
/// artifact exists and does not already link it. Shared by `__yo_build_link`
/// (system-library branch) and `__yo_build_link_system_library`.
_build_attach_system_library :: (
  fn(reg : BuildRegistry, artifact_name : String, library_name : String) -> unit
)({
  match(
    reg.find_artifact(artifact_name),
    .Some(art) => {
      (i : usize) = usize(0);
      while(i < art.linked_system_libs.len(), {
        if(art.linked_system_libs(i) == library_name, {
          return(());
        });
        i = (i + usize(1));
      });
      art.linked_system_libs.push(library_name);
    },
    .None => ()
  );
});
/// Dispatch the `__yo_build_*` evaluator builtins to their comptime
/// result. 1-to-1 with `evaluateYoBuildFunctions` in
/// `src/evaluator/builtins/build.ts`.
///
/// During `check`, a build-function call inside a function body is a "trial"
/// evaluation (its comptime params are `UnknownVal`), and the TS reference
/// skips the registry on that path too — so the trial branch only validates
/// arguments and returns each builtin's correct comptime TYPE.
///
/// On the REAL path (concrete comptime args — i.e. a top-level `build.yo` being
/// evaluated) every builtin mutates `get_build_registry()`, exactly as TS does.
/// That is what `yo build`, `yo fetch` and `yo install` read: without it the
/// registry stays empty and `yo build` builds an empty DAG and exits 0.
evaluate_yo_build_functions :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  // ── Trial evaluation (function-definition type-check) ───────────────
  // Mirror build.ts: target_host returns the host triple, option returns
  // "", everything else returns unit — no registry interaction.
  if(_build_is_trial(args, ctx), {
    if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_TARGET_HOST, Option(usize).None), {
      return(_build_string_result(expr, env, ctx, host_target().triple));
    });
    if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_OPTION, Option(usize).None), {
      return(_build_string_result(expr, env, ctx, String.new()));
    });
    return(_build_unit_result(expr, env, ctx));
  });
  // ── Real evaluation (concrete comptime args) ────────────────────────
  // String-returning builtins.
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_TARGET_HOST, Option(usize).None), {
    return(_build_string_result(expr, env, ctx, host_target().triple));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_TARGET_PARSE, Option(usize).None), {
    if(args.len() != usize(1), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `__yo_build_target_parse expects 1 argument (triple), got ${args.len()}`,
            false,
            .None
          )
        )
      );
    });
    triple := _build_extract_string(args, usize(0), "triple", expr, ctx, exn);
    parsed := match(
      parse_target(triple),
      .Ok(t) => t.triple,
      .Err(_) => triple
    );
    return(_build_string_result(expr, env, ctx, parsed));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_OPTION, Option(usize).None), {
    _build_require_args(args, usize(3), String.from("__yo_build_option expects 3 arguments (name, description, default)"), expr, exn);
    opt_name := _build_extract_string(args, usize(0), "name", expr, ctx, exn);
    opt_desc := _build_extract_string(args, usize(1), "description", expr, ctx, exn);
    default_value := _build_extract_string(args, usize(2), "default", expr, ctx, exn);
    reg_opt := get_build_registry();
    _do := reg_opt.declared_options.insert(
      opt_name.clone(),
      BuildDeclaredOption(description : opt_desc, default_value : default_value.clone())
    );
    // A `-D<name>=<value>` on the command line overrides the declared default.
    return(
      _build_string_result(
        expr,
        env,
        ctx,
        match(reg_opt.cli_options.get(opt_name), .Some(v) => v, .None => default_value)
      )
    );
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_DEP_MODULE, Option(usize).None), {
    if(args.len() < usize(2), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `__yo_build_dep_module expects 2 arguments (dependency_name, module_name), got ${args.len()}`,
            false,
            .None
          )
        )
      );
    });
    dep_name := _build_extract_string(args, usize(0), "dependency_name", expr, ctx, exn);
    mod_name := _build_extract_string(args, usize(1), "module_name", expr, ctx, exn);
    // Encode as "dep_name<NUL>module_name" (decoded by the build
    // runner's add_import handling). Mirrors build.ts. The NUL byte is
    // built at runtime via push_byte rather than as a string literal: a
    // literal NUL lowers to a C universal-character-name the C compiler
    // rejects ("refers to a control character").
    nul_sep := String.new();
    nul_sep.push_byte(u8(0));
    encoded := ((dep_name + nul_sep) + mod_name);
    return(_build_string_result(expr, env, ctx, encoded));
  });
  // ── Registry-mutating builtins (all return unit) ────────────────────
  reg := get_build_registry();
  host_triple := host_target().triple;
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_EXECUTABLE, Option(usize).None), {
    _build_require_args(args, usize(2), String.from("__yo_build_executable expects at least 2 arguments (name, root)"), expr, exn);
    reg.register_executable(
      _build_new_artifact(
        _build_extract_string(args, usize(0), "name", expr, ctx, exn),
        _build_extract_string(args, usize(1), "root", expr, ctx, exn),
        _build_extract_string_or(args, usize(2), "target", host_triple.clone(), expr, ctx, exn),
        _build_extract_string_or(args, usize(3), "optimize", String.from("debug"), expr, ctx, exn),
        _build_extract_string_or(args, usize(4), "allocator", String.from("mimalloc"), expr, ctx, exn),
        _build_extract_string_or(args, usize(5), "sanitize", String.from("none"), expr, ctx, exn),
        _build_extract_string_or(args, usize(6), "emit_c_to", String.new(), expr, ctx, exn),
        _build_extract_usize_or(args, usize(7), usize(0), ctx)
      ),
      exn
    );
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_STATIC_LIBRARY, Option(usize).None), {
    _build_require_args(args, usize(2), String.from("__yo_build_static_library expects at least 2 arguments (name, root)"), expr, exn);
    reg.register_static_library(
      _build_new_artifact(
        _build_extract_string(args, usize(0), "name", expr, ctx, exn),
        _build_extract_string(args, usize(1), "root", expr, ctx, exn),
        _build_extract_string_or(args, usize(2), "target", host_triple.clone(), expr, ctx, exn),
        _build_extract_string_or(args, usize(3), "optimize", String.from("debug"), expr, ctx, exn),
        String.from("system"),
        String.from("none"),
        String.new(),
        usize(0)
      ),
      exn
    );
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_SHARED_LIBRARY, Option(usize).None), {
    _build_require_args(args, usize(2), String.from("__yo_build_shared_library expects at least 2 arguments (name, root)"), expr, exn);
    reg.register_shared_library(
      _build_new_artifact(
        _build_extract_string(args, usize(0), "name", expr, ctx, exn),
        _build_extract_string(args, usize(1), "root", expr, ctx, exn),
        _build_extract_string_or(args, usize(2), "target", host_triple.clone(), expr, ctx, exn),
        _build_extract_string_or(args, usize(3), "optimize", String.from("debug"), expr, ctx, exn),
        String.from("system"),
        String.from("none"),
        String.new(),
        usize(0)
      ),
      exn
    );
    return(_build_unit_result(expr, env, ctx));
  });
  // Unified link: a name that matches a registered SYSTEM library attaches as
  // one; anything else is an artifact-to-artifact link.
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_LINK, Option(usize).None), {
    _build_require_args(args, usize(2), String.from("__yo_build_link expects 2 arguments (artifact_name, library_name)"), expr, exn);
    link_artifact := _build_extract_string(args, usize(0), "artifact_name", expr, ctx, exn);
    link_library := _build_extract_string(args, usize(1), "library_name", expr, ctx, exn);
    match(
      reg.find_system_library(link_library.clone()),
      .Some(_) => {
        _build_attach_system_library(reg, link_artifact, link_library);
      },
      .None => {
        reg.register_link(link_artifact, link_library);
      }
    );
    return(_build_unit_result(expr, env, ctx));
  });
  // Kept for backward compatibility; `build.link()` now handles both cases.
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_LINK_SYSTEM_LIBRARY, Option(usize).None), {
    _build_require_args(args, usize(2), String.from("__yo_build_link_system_library expects 2 arguments (artifact_name, system_lib_name)"), expr, exn);
    _build_attach_system_library(
      reg,
      _build_extract_string(args, usize(0), "artifact_name", expr, ctx, exn),
      _build_extract_string(args, usize(1), "system_lib_name", expr, ctx, exn)
    );
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_TEST, Option(usize).None), {
    _build_require_args(args, usize(2), String.from("__yo_build_test expects at least 2 arguments (name, root)"), expr, exn);
    // Comma-separated project-relative paths excluded from the test walk
    // (std/build.yo TestSuite.exclude; "" means no excludes).
    exclude_raw := _build_extract_string_or(args, usize(3), "exclude", String.from(""), expr, ctx, exn);
    exclude_list := ArrayList(String).new();
    exclude_parts := exclude_raw.split(",");
    (epi : usize) = usize(0);
    while(epi < exclude_parts.len(), {
      part := match(exclude_parts.get(epi), .Some(s) => s.trim(), .None => String.new());
      if(part.len() > usize(0), {
        exclude_list.push(part);
      });
      epi = (epi + usize(1));
    });
    reg.register_test(
      BuildTestSuite(
        name : _build_extract_string(args, usize(0), "name", expr, ctx, exn),
        root : _build_extract_string(args, usize(1), "root", expr, ctx, exn),
        target : _build_extract_string_or(args, usize(2), "target", host_triple.clone(), expr, ctx, exn),
        verbose : false,
        bail : false,
        parallel : i32(1),
        exclude : exclude_list
      )
    );
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_RUN, Option(usize).None), {
    _build_require_args(args, usize(1), String.from("__yo_build_run expects at least 1 argument (artifact_name)"), expr, exn);
    reg.register_run(
      _build_extract_string(args, usize(0), "artifact_name", expr, ctx, exn),
      ArrayList(String).new()
    );
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_STEP, Option(usize).None), {
    _build_require_args(args, usize(2), String.from("__yo_build_step expects 2 arguments (name, description)"), expr, exn);
    reg.register_step(
      _build_extract_string(args, usize(0), "name", expr, ctx, exn),
      _build_extract_string(args, usize(1), "description", expr, ctx, exn)
    );
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_DOC, Option(usize).None), {
    _build_require_args(args, usize(10), String.from("__yo_build_doc expects 10 arguments"), expr, exn);
    reg.register_doc(
      BuildDocConfig(
        name : _build_extract_string(args, usize(0), "name", expr, ctx, exn),
        root : _build_extract_string(args, usize(1), "root", expr, ctx, exn),
        output_dir : _build_extract_string(args, usize(2), "output", expr, ctx, exn),
        format : _build_extract_string(args, usize(3), "format", expr, ctx, exn),
        include_private : _build_extract_bool(args, usize(4), ctx),
        include_deps : _build_extract_bool(args, usize(5), ctx),
        title : _build_extract_string(args, usize(6), "title", expr, ctx, exn),
        logo : _build_extract_string(args, usize(7), "logo", expr, ctx, exn),
        favicon : _build_extract_string(args, usize(8), "favicon", expr, ctx, exn),
        version : _build_extract_string(args, usize(9), "version", expr, ctx, exn)
      )
    );
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_STEP_DEPEND_ON, Option(usize).None), {
    _build_require_args(args, usize(3), String.from("__yo_build_step_depend_on expects 3 arguments (step_name, dep_name, dep_kind)"), expr, exn);
    step_name := _build_extract_string(args, usize(0), "step_name", expr, ctx, exn);
    dep_name := _build_extract_string(args, usize(1), "dep_name", expr, ctx, exn);
    // A Run dependency is stored under a `run:` prefix so it cannot collide
    // with the artifact of the same name.
    resolved_dep_name := match(
      _build_extract_variant(args, usize(2), ctx),
      .Some(variant) => cond((variant == "Run") => `run:${dep_name}`, true => dep_name.clone()),
      .None => dep_name.clone()
    );
    reg.add_step_dependency(step_name, resolved_dep_name);
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_DEPENDENCY, Option(usize).None), {
    _build_require_args(args, usize(2), String.from("__yo_build_dependency expects at least 2 arguments (name, url)"), expr, exn);
    reg.register_dependency(
      BuildGitDependency(
        name : _build_extract_string(args, usize(0), "name", expr, ctx, exn),
        url : _build_extract_string(args, usize(1), "url", expr, ctx, exn),
        ref : _build_extract_string_or(args, usize(2), "ref", String.from("HEAD"), expr, ctx, exn),
        path : _build_extract_string_or(args, usize(3), "path", String.new(), expr, ctx, exn)
      )
    );
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_PATH_DEPENDENCY, Option(usize).None), {
    _build_require_args(args, usize(2), String.from("__yo_build_path_dependency expects 2 arguments (name, path)"), expr, exn);
    reg.register_path_dependency(
      BuildPathDependency(
        name : _build_extract_string(args, usize(0), "name", expr, ctx, exn),
        path : _build_extract_string(args, usize(1), "path", expr, ctx, exn)
      )
    );
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_SYSTEM_LIBRARY, Option(usize).None), {
    _build_require_args(args, usize(1), String.from("__yo_build_system_library expects at least 1 argument (name)"), expr, exn);
    reg.register_system_library(
      BuildSystemLibrary(
        name : _build_extract_string(args, usize(0), "name", expr, ctx, exn),
        fallback_include : _build_extract_string_or(args, usize(1), "fallback_include", String.new(), expr, ctx, exn),
        fallback_lib : _build_extract_string_or(args, usize(2), "fallback_lib", String.new(), expr, ctx, exn),
        fallback_link : _build_extract_string_or(args, usize(3), "fallback_link", String.new(), expr, ctx, exn),
        defines : _build_split_ws(_build_extract_string_or(args, usize(4), "defines", String.new(), expr, ctx, exn))
      )
    );
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_DEP_ARTIFACT, Option(usize).None), {
    _build_require_args(args, usize(2), String.from("__yo_build_dep_artifact expects 2 arguments (dependency_name, artifact_name)"), expr, exn);
    reg.register_dependency_artifact(
      DependencyArtifactRef(
        dependency_name : _build_extract_string(args, usize(0), "dependency_name", expr, ctx, exn),
        artifact_name : _build_extract_string(args, usize(1), "artifact_name", expr, ctx, exn)
      )
    );
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_MODULE, Option(usize).None), {
    _build_require_args(args, usize(2), String.from("__yo_build_module expects 2 arguments (name, root)"), expr, exn);
    reg.register_module(
      BuildModuleEntry(
        name : _build_extract_string(args, usize(0), "name", expr, ctx, exn),
        root : _build_extract_string(args, usize(1), "root", expr, ctx, exn),
        linked_system_libraries : ArrayList(String).new()
      )
    );
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_MODULE_LINK, Option(usize).None), {
    _build_require_args(args, usize(2), String.from("__yo_build_module_link expects 2 arguments (module_name, system_library_name)"), expr, exn);
    reg.register_module_link(
      _build_extract_string(args, usize(0), "module_name", expr, ctx, exn),
      _build_extract_string(args, usize(1), "system_library_name", expr, ctx, exn)
    );
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_ADD_IMPORT, Option(usize).None), {
    _build_require_args(args, usize(4), String.from("__yo_build_add_import expects 4 arguments (artifact_name, import_name, module_name, dependency_name)"), expr, exn);
    imp_artifact := _build_extract_string(args, usize(0), "artifact_name", expr, ctx, exn);
    imp_name := _build_extract_string(args, usize(1), "import_name", expr, ctx, exn);
    imp_module := _build_extract_string(args, usize(2), "module_name", expr, ctx, exn);
    imp_dep := _build_extract_string(args, usize(3), "dependency_name", expr, ctx, exn);
    // Diagnose a duplicate import name BEFORE registering — `register_imported_module`
    // silently ignores one, which would otherwise hide the user's mistake.
    match(
      reg.find_artifact(imp_artifact.clone()),
      .Some(art) => {
        (di : usize) = usize(0);
        while(di < art.imported_modules.len(), {
          existing := art.imported_modules(di);
          if(existing.import_name == imp_name, {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(expr),
                  `Duplicate import name "${imp_name}" on artifact "${imp_artifact}". Already imported from module "${existing.module_name}".`,
                  false,
                  .None
                )
              )
            );
          });
          di = (di + usize(1));
        });
      },
      .None => ()
    );
    reg.register_imported_module(
      imp_artifact,
      ImportedModule(
        import_name : imp_name,
        module_name : imp_module,
        dependency_name : imp_dep,
        resolved_root : Option(String).None,
        propagated_system_libs : ArrayList(String).new()
      )
    );
    return(_build_unit_result(expr, env, ctx));
  });
  if(ast_expr_is_fn_call_of(expr, BF_YO_BUILD_ADD_CFLAGS, Option(usize).None), {
    _build_require_args(args, usize(2), String.from("__yo_build_add_cflags expects 2 arguments (artifact_name, flags)"), expr, exn);
    cf_artifact := _build_extract_string(args, usize(0), "artifact_name", expr, ctx, exn);
    cf_flags := _build_split_ws(_build_extract_string(args, usize(1), "flags", expr, ctx, exn));
    match(
      reg.find_artifact(cf_artifact),
      .Some(art) => {
        (fi : usize) = usize(0);
        while(fi < cf_flags.len(), {
          match(
            cf_flags.get(fi),
            .Some(f) => {
              art.c_flags.push(f);
            },
            .None => ()
          );
          fi = (fi + usize(1));
        });
      },
      .None => ()
    );
    return(_build_unit_result(expr, env, ctx));
  });
  exn.throw(
    dyn(
      format_error_message(
        ast_expr_token(expr),
        `Unknown build function: ${ast_expr_token(expr).value}`,
        false,
        .None
      )
    )
  );
  _build_unit_result(expr, env, ctx)
});
// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------
export(
  ArtifactKind,
  BuildArtifact,
  ImportedModule,
  BuildTestSuite,
  BuildRunStep,
  BuildStep,
  BuildGitDependency,
  BuildPathDependency,
  BuildSystemLibrary,
  DependencyArtifactRef,
  BuildModuleEntry,
  BuildDocConfig,
  BuildDeclaredOption,
  ResolvedDep,
  BuildRegistry,
  get_build_registry,
  clear_build_registry,
  swap_build_registry,
  evaluate_yo_build_functions
);
