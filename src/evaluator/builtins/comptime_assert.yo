//! evaluator/builtins/comptime_assert — implements evaluate_comptime_assert.
//!
//! 1:1 port of `src/evaluator/builtins/comptime-assert.ts`.
//!
//! `comptime_assert(cond)` or `comptime_assert(cond, msg)` — evaluates `cond`
//! at compile time and throws if it is false.  When not executing, still
//! type-checks the condition argument.
open(import("std/string"));
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  BF_COMPTIME_ASSERT
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx } :: import("../context.yo");
{
  EvalValue,
  is_bool_val,
  is_unknown_val,
  create_unknown_val,
  value_to_string
} :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ is_unit_type } :: import("../../types/guards.yo");
{ is_bool_type } :: import("../../types/guards.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
evaluate_comptime_assert :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  // Extract arg_expr (condition) and optional message_expr.
  (arg_expr_opt : Option(AstExpr)) = match(
    expr,
    .FnCall(_, _, args, _, _) => args.get(usize(0)),
    _ => .None
  );
  (msg_expr_opt : Option(AstExpr)) = match(
    expr,
    .FnCall(_, _, args, _, _) => args.get(usize(1)),
    _ => .None
  );
  // When not executing, still type-check the condition so malformed expressions
  // are caught during function-definition validation.
  if(ctx.is_validating_function_definition || !ctx.is_executing, {
    match(
      arg_expr_opt,
      .Some(arg_expr) => {
        evaluated_arg := evaluate_expression(arg_expr, env, ctx);
        arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_arg));
        match(
          arg_info_opt,
          .Some(ai) => {
            if(!is_bool_type(ai.ty) && !is_unknown_val(match(ai.value, .Some(v) => v, .None => EvalValue.UnitVal)), {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(arg_expr),
                    `Expected bool expression for "comptime_assert", got:\n${ast_expr_to_string(arg_expr)}\n\nType:\n${String.from("unknown")}`
                  )
                )
              );
            });
          },
          .None => {}
        );
      },
      .None => {}
    );
    // Return type: use expectedType if provided; else unit.
    (ret_type : TypeValue) = match(
      ctx.expected_type,
      .Some(et) => et.ty,
      .None => t_unit()
    );
    (ret_val : Option(EvalValue)) = if(
      is_unit_type(ret_type),
      .Some(EvalValue.UnitVal),
      .Some(create_unknown_val(ret_type))
    );
    out_info := new_expr_info(env, ret_type);
    out_info.value = ret_val;
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
    return(expr);
  });
  // --- Executing path ---
  arg_expr := match(
    arg_expr_opt,
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  evaluated_arg := evaluate_expression(arg_expr, env, ctx);
  arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_arg));
  arg_info := match(
    arg_info_opt,
    .Some(ai) => ai,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            `Expected bool value for "comptime_assert", got:\n${ast_expr_to_string(arg_expr)}`
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  );
  arg_val := match(
    arg_info.value,
    .Some(v) => v,
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            `Expected bool value for "comptime_assert", got:\n${ast_expr_to_string(arg_expr)}`
          )
        )
      );
      EvalValue.UnitVal
    }
  );
  if(!is_bool_val(arg_val), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          `Expected bool value for "comptime_assert", got:\n${ast_expr_to_string(arg_expr)}\n\nValue:\n${value_to_string(arg_val)}`
        )
      )
    );
  });
  bool_val := match(arg_val, .BoolVal(b) => b, _ => false);
  if(bool_val, {
    // Assertion passed — return unit.
    out_info := new_expr_info(env, t_unit());
    out_info.value = .Some(EvalValue.UnitVal);
    expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  }, {
    // Assertion failed — check for message argument.
    err_msg := match(
      msg_expr_opt,
      .Some(msg_expr) => {
        eval_msg := evaluate_expression(msg_expr, env, ctx);
        msg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_msg));
        match(
          msg_info_opt,
          .Some(mi) => match(
            mi.value,
            .Some(mv) => match(
              mv,
              .StrLit(raw) => {
                rn := raw.len();
                raw.substring(usize(1), rn - usize(1))
              },
              _ => value_to_string(mv)
            ),
            .None => String.from("")
          ),
          .None => String.from("")
        )
      },
      .None => String.from("")
    );
    if(err_msg.len() > usize(0), {
      exn.throw(dyn(format_error_message(ast_expr_token(expr), err_msg)));
    }, {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(expr),
            `Assertion failed for "comptime_assert":\n${ast_expr_to_string(arg_expr)}`
          )
        )
      );
    });
  });
  expr
});
export(evaluate_comptime_assert);
