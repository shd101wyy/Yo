//! evaluator/builtins/rc-fns — RC reference-counting builtin evaluators.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array-list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  make_err_expr,
  BF_YO_DECR_RC,
  BF_YO_DECR_RC_ATOMIC,
  BF_YO_DYN_DROP,
  BF_YO_SOMETYPE_DROP,
  BF_YO_DROP_ARRAY_ELEMENT,
  BF_YO_DROP_TUPLE_ELEMENT,
  BF_YO_INCR_RC,
  BF_YO_INCR_RC_ATOMIC,
  BF_YO_RC_OWN
} :: import("../../expr.yo");
{ TypeValue, TypeValueNode, shared_list, no_types, SharedList } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx } :: import("../context.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set
} :: import("../../expr-info.yo");
{ format_error_message, format_eval_failure } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{
  is_destroying_builtin_call_capable,
  destroying_builtin_error_message,
  ownership_builtin_error_message
} :: import("../memory-safety.yo");
create_option_type :: (fn(inner_type : &TypeValue) -> TypeValue)({
  variant_names := ArrayList(String).new();
  variant_names.push(String.from("None"));
  variant_names.push(String.from("Some"));
  none_fields := ArrayList(TypeValue).new();
  some_fields := ArrayList(TypeValue).new();
  some_fields.push(Rc.clone(inner_type));
  variant_fields := ArrayList(SharedList(TypeValue)).new();
  variant_fields.push(shared_list(none_fields));
  variant_fields.push(shared_list(some_fields));
  none_labels := ArrayList(String).new();
  some_labels := ArrayList(String).new();
  // "value" — MUST match prelude Option's `Some(value : T)` label: the
  // enum-signature dedup collapses this synthesized
  // rendition with real Option instances into ONE C type (labels are not in
  // the sig), and the downcast/await emitters hardcode `.Some = { .value =`
  // — a "val"-labelled winner made the field designator miss (the lexer
  // batch "field designator 'value' does not refer to any field").
  some_labels.push(String.from("value"));
  variant_field_labels := ArrayList(SharedList(String)).new();
  variant_field_labels.push(shared_list(none_labels));
  variant_field_labels.push(shared_list(some_labels));
  discs := ArrayList(i64).new();
  discs.push(i64(0));
  discs.push(i64(1));
  Rc.new(
    TypeValueNode.EnumT(
      String.from(""),
      // id: empty (compat checks use name only)
      String.from("Option"),
      shared_list(variant_names),
      shared_list(variant_fields),
      Option(String).None,
      // selected_variant_name
      shared_list(variant_field_labels),
      shared_list(discs),
      false,
      false,
      // type_arguments: none (a synthesized rendition, not a ctor call)
      no_types()
    )
  )
});
// ---------------------------------------------------------------------------
// Helper: evaluate one argument and get its ExprInfo.
// ---------------------------------------------------------------------------
_eval_arg :: (
  fn(
    fn_name : &(str, static),
    expr : &AstExpr,
    env : &Environment,
    ctx : &mut EvalContext,
    arg_idx : usize,
    exn : Exception
  ) -> ExprInfo
)({
  arg_expr := match(
    expr,
    Rc(.FnCall(_, _, Rc(fargs), _, _)) => match(fargs.get_cloned(arg_idx), .Some(x) => x, .None => make_err_expr()),
    _ => make_err_expr()
  );
  eval_arg := evaluate_expression_raw(&arg_expr, env, ctx, exn);
  match(
    expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&eval_arg)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          Box.new(
            format_eval_failure(
              ast_expr_token(&arg_expr),
              `Failed to evaluate argument for ${fn_name}`
            )
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  )
});
/// Reject a builtin that destroys its argument in place (an RC release)
/// outside an unsafe-capable file, as `___drop` is: on a field the place
/// stays readable after its storage is freed
/// (`is_destroying_builtin_call_capable`).
_require_destroying_builtin_capable :: (fn(builtin : &(str, static), expr : &AstExpr, exn : Exception) -> unit)({
  tok := ast_expr_token(expr);
  if(!is_destroying_builtin_call_capable(Option(String).Some(tok.*.module_path.*.clone())), {
    name := String.from(builtin);
    place := _first_arg_text(expr);
    exn.throw(dyn(Box.new(format_error_message(&tok, destroying_builtin_error_message(&name, &place)))));
  });
});
/// Reject a builtin that adds an owner or a count the compiler does not
/// record (`__yo_rc_own`, `__yo_incr_rc`, `__yo_incr_rc_atomic`) outside an
/// unsafe-capable file: the value is then freed twice or leaked
/// (`ownership_builtin_error_message`).
_require_ownership_builtin_capable :: (fn(builtin : &(str, static), expr : &AstExpr, exn : Exception) -> unit)({
  tok := ast_expr_token(expr);
  if(!is_destroying_builtin_call_capable(Option(String).Some(tok.*.module_path.*.clone())), {
    name := String.from(builtin);
    place := _first_arg_text(expr);
    exn.throw(dyn(Box.new(format_error_message(&tok, ownership_builtin_error_message(&name, &place)))));
  });
});
/// The first argument of a builtin call, as written (the place a gate names).
_first_arg_text :: (fn(expr : &AstExpr) -> String)(
  match(
    expr,
    Rc(.FnCall(_, _, Rc(fargs), _, _)) => match(fargs.get_cloned(usize(0)), .Some(x) => ast_expr_to_string(&x), .None => String.new()),
    _ => String.new()
  )
);
// ---------------------------------------------------------------------------
// Simple 1-arg -> unit functions
//
// Each one changes a reference count at runtime, so its value is `.None` (a
// runtime value), never a known `()`: a known value tells codegen the
// expression has no runtime effect, and a block or tuple holding one was
// folded to its value with the call deleted
// (issues/fixed/2026-11-20-a-side-effecting-builtin-is-deleted-when-its-unit-value-is-bound-or-folded.md).
// The 2-arg element drops below follow the same rule.
// ---------------------------------------------------------------------------
evaluate_yo_decr_rc :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &mut EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  _require_destroying_builtin_capable(BF_YO_DECR_RC, expr, exn);
  info := _eval_arg("evaluate_yo_decr_rc", expr, env, ctx, usize(0), exn);
  out := new_expr_info(&info.env(), t_unit());
  out.set_value(.None);
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out);
  Rc.clone(expr.*)
});
evaluate_yo_decr_rc_atomic :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &mut EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  _require_destroying_builtin_capable(BF_YO_DECR_RC_ATOMIC, expr, exn);
  info := _eval_arg("evaluate_yo_decr_rc_atomic", expr, env, ctx, usize(0), exn);
  out := new_expr_info(&info.env(), t_unit());
  out.set_value(.None);
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out);
  Rc.clone(expr.*)
});
