//! evaluator/builtins/drop — implements evaluate_drop.
//!
//! 1:1 port of `src/evaluator/builtins/drop.ts`.
//!
//! NOTE: The RC-owning paths (tuple drop, array drop, struct ___drop()) require
//! `type_contains_rc_type` to return true and `generate_expr_from_code` to exist.
//! Since `type_contains_rc_type` is currently a stub returning `false`, those
//! paths are unreachable and only the simple (non-RC) path is implemented here.
open(import("std/string"));
{ AstExpr, ast_expr_token, ast_expr_id } :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{ format_error_message } :: import("../../error.yo");
{ set_variable_as_consumed } :: import("./consume.yo");
{ evaluate_expression } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
evaluate_drop :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg_expr := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  eval_arg := evaluate_expression(arg_expr, env, ctx);
  arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_arg));
  match(
    arg_info_opt,
    .Some(_) => (),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            String.from("___drop: failed to evaluate the argument expression.")
          )
        )
      );
    }
  );
  arg_info := match(
    arg_info_opt,
    .Some(i) => i,
    .None => {
      return(expr);
    }
  );
  (cur_env : Environment) = arg_info.env;
  arg_type := arg_info.ty;
  variable_name_opt := arg_info.variable_name;
  // NOTE: When type_contains_rc_type is fully implemented, we need to handle:
  //   - tuple types: generateTupleDropCall → evaluate generated code
  //   - array types: generateArrayDropCall → evaluate generated code
  //   - SomeType (non-Future): consume and return unit
  //   - struct types: call .___drop() method
  // For now, type_contains_rc_type() always returns false, so we always take
  // the simple path: consume the variable and return unit.
  // Determine if value is a TypeVal (type values are not consumed).
  is_tv := match(
    arg_info.value,
    .Some(v) => match(v, .TypeVal(_) => true, _ => false),
    .None => false
  );
  match(
    variable_name_opt,
    .Some(vname) => {
      set_variable_as_consumed(vname, ast_expr_token(arg_expr), cur_env, true, is_tv, exn);
    },
    .None => ()
  );
  out_info := new_expr_info(cur_env, t_unit());
  // value is None (runtime) — mirrors `value: undefined` in TS for the non-RC path
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
export(evaluate_drop);
