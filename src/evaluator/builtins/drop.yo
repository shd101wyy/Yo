//! evaluator/builtins/drop — implements evaluate_drop.
//!
//! NOTE: The RC-owning paths (tuple drop, array drop, struct ___drop()) require
//! `type_contains_rc_type` to return true and `generate_expr_from_code` to exist.
//! Since `type_contains_rc_type` is currently a stub returning `false`, those
//! paths are unreachable and only the simple (non-RC) path is implemented here.
{ String } :: import("std/string");
{ AstExpr, ast_expr_token, ast_expr_id, ast_expr_to_string, BF_DROP, BF_YO_DROP_IN_PLACE } :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  expr_info_adopt_env
} :: import("../../expr-info.yo");
{ Environment, snapshot_env } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ is_pointer_type } :: import("../../types/guards.yo");
{ type_to_string } :: import("../../types/string.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{ format_error_message } :: import("../../error.yo");
{ is_destroying_builtin_call_capable, destroying_builtin_error_message } :: import("../memory-safety.yo");
{ set_variable_as_consumed } :: import("./consume.yo");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
evaluate_drop :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &mut EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  arg_expr := match(
    expr,
    Rc(.FnCall(_, _, Rc(fargs), _, _)) => match(
      fargs.get_cloned(usize(0)),
      .Some(a) => a,
      .None => {
        return(Rc.clone(expr.*));
      }
    ),
    _ => {
      return(Rc.clone(expr.*));
    }
  );
  // Memory-safety gate, the same as a raw-pointer dereference: `___drop(place)`
  // runs the place's drop glue without moving it out. It is the std-internal
  // primitive behind `drop_in_place`, Rust's unsafe `ptr::drop_in_place`.
  drop_tok := ast_expr_token(expr);
  if(!is_destroying_builtin_call_capable(Option(String).Some(drop_tok.*.module_path.*.clone())), {
    drop_name := String.from(BF_DROP);
    drop_place := ast_expr_to_string(&arg_expr);
    exn.throw(dyn(Box.new(format_error_message(&drop_tok, destroying_builtin_error_message(&drop_name, &drop_place)))));
  });
  eval_arg := evaluate_expression_raw(&arg_expr, env, ctx, exn);
  arg_info_opt := expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&eval_arg));
  match(
    &arg_info_opt,
    .Some(_) => (),
    .None => {
      exn.throw(
        dyn(
          Box.new(
            format_error_message(
              ast_expr_token(&arg_expr),
              String.from("___drop: failed to evaluate the argument expression.")
            )
          )
        )
      );
    }
  );
  arg_info := match(
    arg_info_opt,
    .Some(i) => Rc.clone(i),
    .None => {
      return(Rc.clone(expr.*));
    }
  );
  (cur_env : Environment) = expr_info_adopt_env(&arg_info);
  arg_type := Rc.clone(arg_info.ty());
  variable_name_opt := arg_info.variable_name();
  // NOTE: When type_contains_rc_type is fully implemented, we need to handle:
  //   - tuple types: generateTupleDropCall → evaluate generated code
  //   - array types: generateArrayDropCall → evaluate generated code
  //   - SomeType (non-Future): consume and return unit
  //   - struct types: call .___drop() method
  // For now, type_contains_rc_type() always returns false, so we always take
  // the simple path: consume the variable and return unit.
  // Determine if value is a TypeVal (type values are not consumed).
  is_tv := match(
    arg_info.value(),
    .Some(v) => match(v, Rc(.TypeVal(_)) => true, _ => false),
    .None => false
  );
  match(
    variable_name_opt,
    .Some(vname) => {
      set_variable_as_consumed(&vname, ast_expr_token(&arg_expr), &cur_env, true, is_tv, exn);
    },
    .None => ()
  );
  out_info := new_expr_info(&cur_env, t_unit());
  // value is None (runtime) for the non-RC path
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_info);
  Rc.clone(expr.*)
});
/// Evaluate `__yo_drop_in_place(p)`: `drop_in_place`'s intrinsic, Rust's
/// `ptr::drop_in_place`. It runs the drop glue of the value `p : *T`
/// addresses and leaves its bytes in place, so the caller must not use the
/// value again. Gated like `___drop`: only an unsafe-capable file calls it.
evaluate_yo_drop_in_place :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &mut EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  fargs := match(expr, Rc(.FnCall(_, _, Rc(a), _, _)) => a.clone(), _ => return(_dip_arity_error(expr, exn)));
  if(fargs.len() != usize(1), {
    return(_dip_arity_error(expr, exn));
  });
  arg_expr := match(fargs.get_cloned(usize(0)), .Some(a) => a, .None => return(_dip_arity_error(expr, exn)));
  tok := ast_expr_token(expr);
  if(!is_destroying_builtin_call_capable(Option(String).Some(tok.*.module_path.*.clone())), {
    name := String.from(BF_YO_DROP_IN_PLACE);
    place := ast_expr_to_string(&arg_expr);
    exn.throw(dyn(Box.new(format_error_message(&tok, destroying_builtin_error_message(&name, &place)))));
  });
  eval_arg := evaluate_expression_raw(&arg_expr, env, ctx, exn);
  arg_info := match(
    expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&eval_arg)),
    .Some(i) => Rc.clone(i),
    .None => {
      exn.throw(dyn(Box.new(format_error_message(ast_expr_token(&arg_expr), String.from("__yo_drop_in_place: failed to evaluate the argument expression.")))));
      return(Rc.clone(expr.*))
    }
  );
  if(!is_pointer_type(&arg_info.ty()), {
    exn.throw(dyn(Box.new(format_error_message(ast_expr_token(&arg_expr), `__yo_drop_in_place takes a raw pointer \`*T\` to the value it drops, not a \`${type_to_string(&arg_info.ty())}\`.`))));
  });
  out_info := new_expr_info(&expr_info_adopt_env(&arg_info), t_unit());
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_info);
  Rc.clone(expr.*)
});
_dip_arity_error :: (fn(expr : &AstExpr, exn : Exception) -> AstExpr)({
  exn.throw(dyn(Box.new(format_error_message(ast_expr_token(expr), String.from("__yo_drop_in_place takes exactly one argument, the pointer to the value it drops.")))));
  Rc.clone(expr.*)
});
export(evaluate_drop, evaluate_yo_drop_in_place);
