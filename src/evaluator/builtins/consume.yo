//! evaluator/builtins/consume — implements evaluate_consume and set_variable_as_consumed.
//!
//! `set_variable_as_consumed` is also exported for use by drop.yo and dup.yo.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ Token } :: import("../../token.yo");
{ AstExpr, ast_expr_token, ast_expr_id, ast_expr_is_fn_call_of, BK_ASSIGN, BF_UNSAFE } :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  expr_info_adopt_env,
  record_branch_consume,
  record_consume_release
} :: import("../../expr_info.yo");
{ is_temp_variable_name } :: import("../../utils.yo");
{
  Variable,
  Environment,
  get_variables_from_env,
  snapshot_env
} :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{
  TokenAndError,
  format_error_messages,
  format_error_message
} :: import("../../error.yo");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
/// Mark the variable identified by `variable_name` in `env` as consumed at `token`.
/// If the variable is already consumed and `allow_consume_again` is false, throws.
/// If `is_type_val` is true, skips consumption (type values are always reusable).
///
/// Split into a standalone helper so callers can pass the ExprInfo fields
/// explicitly (ExprInfo is stored
/// in a separate table rather than inline on the AST node).
set_variable_as_consumed :: (
  fn(
    variable_name : &String,
    token : &Token,
    env : &Environment,
    allow_consume_again : bool,
    is_type_val : bool,
    exn : Exception
  ) -> unit
)({
  // Don't consume type values — they should be reusable.
  if(is_type_val, {
    return(());
  });
  variables := get_variables_from_env(env, variable_name);
  n_vars := variables.len();
  if(n_vars == usize(0), {
    exn.throw(
      dyn(
        format_error_message(
          token,
          `Variable "${variable_name}" is not defined.`
        )
      )
    );
  });
  variable := match(
    variables.get(n_vars - usize(1)),
    .Some(v) => v,
    .None => {
      return(());
    }
  );
  match(
    variable.consumed_at_token,
    .Some(consumed_token) => {
      if(!allow_consume_again, {
        entries := ArrayList(TokenAndError).new();
        entries.push(
          TokenAndError(
            token : token,
            error_message : `use of moved value: \`${variable_name}\``
          )
        );
        entries.push(
          TokenAndError(
            token : consumed_token,
            error_message : String.from("value moved here")
          )
        );
        exn.throw(dyn(format_error_messages(&entries)));
      });
    },
    .None => {
      // Set the variable as consumed. `variable` IS the env's Variable object
      // (get_variables_from_env returns refs; Variable is reference-semantics),
      // so the field write below mutates it in place — no update_existing_variable
      // write-back scan needed. An earlier alias-then-scan version was a pure
      // no-op that dominated evaluation: 88% of a heavy `check` sat in that
      // scan's String-id compares under scope-end drop scheduling.
      // Logged first: per-path move state for joins and loops (a compiler
      // temp's mark is ownership bookkeeping, not a move).
      if(!is_temp_variable_name(&env.module_path, &variable.name), {
        record_branch_consume(variable.id, token.clone(), &variable.initialized_at_token, Option(Token).None);
      });
      variable.consumed_at_token = Option(Token).Some(token.clone());
    }
  );
});
/// `consume(p.* = v)` (also spelled inside `unsafe(...)`): initialization
/// through a raw pointer. The assignment's value is the slot's OLD content,
/// which is uninitialized memory, so the consume's whole point is that nothing
/// releases it.
_is_init_assignment :: (fn(arg : &AstExpr) -> bool)(
  cond(
    ast_expr_is_fn_call_of(arg, BK_ASSIGN, Option(usize).None) => true,
    ast_expr_is_fn_call_of(arg, BF_UNSAFE, Option(usize).Some(usize(1))) => match(
      arg,
      .FnCall(_, _, uargs, _, _) => match(uargs.get(usize(0)), .Some(inner) => recur(&inner), .None => false),
      .Atom(_, _) => false
    ),
    true => false
  )
);
/// `consume(x)` moves `x`, and the builtin returns `unit`, so it is the
/// value's last owner: an owned value is released at the consume, as
/// `drop(x)` releases it, instead of leaking
/// (issues/fixed/2026-10-16-consume-of-an-owned-local-as-a-statement-leaks-it.md).
/// The test mirrors the scope-end drop scheduler's eligibility
/// (`_schedule_scope_end_drops`, evaluator/exprs/begin.yo): the consume's mark
/// suppresses exactly that drop. A capture of the current closure belongs to
/// the closure's capture struct, which releases it.
_consume_releases_variable :: (fn(name : &String, env : &Environment, ctx : &EvalContext) -> bool)({
  vars := get_variables_from_env(env, name);
  v := match(vars.last(), .Some(v) => v, .None => return(false));
  some_undroppable := match(
    v.ty,
    Rc(.SomeT({ required_trait_types : s_rtt, resolution : s_rc })) => (s_rc.is_none() && (s_rtt.len() == usize(0))),
    _ => false
  );
  captured := match(ctx.captured_variables, .Some(cv) => cv.contains_key(v.name.clone()), .None => false);
  v.is_owning_the_rc_value && (type_contains_rc_type(&v.ty) && (!v.is_module_level && (!v.is_ref && (!some_undroppable && (v.consumed_at_token.is_none() && !captured)))))
});
evaluate_consume :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg_expr := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  // Through the caller's `exn`: the 3-argument `evaluate_expression` swallows
  // any throw and hands back an error node whose env is not the caller's, so
  // an error in the argument vanished and the enclosing block went on in the
  // wrong environment (issues/fixed/consume-swallows-its-arguments-error-and-its-env.md).
  eval_arg := evaluate_expression_raw(&arg_expr, env, ctx, exn);
  arg_info_opt := expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&eval_arg));
  (cur_env : Environment) = match(arg_info_opt, .Some(i) => expr_info_adopt_env(&i), .None => env);
  match(
    arg_info_opt,
    .Some(_) => (),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(&arg_expr),
            String.from("consume: failed to evaluate expression.")
          )
        )
      );
    }
  );
  // Determine if value is a TypeVal.
  is_tv := match(
    arg_info_opt,
    .Some(info) => match(
      info.value,
      .Some(v) => match(v, .TypeVal(_) => true, _ => false),
      .None => false
    ),
    .None => false
  );
  // Get variable name from ExprInfo.
  variable_name_opt := match(arg_info_opt, .Some(i) => i.variable_name, .None => Option(String).None);
  match(
    variable_name_opt,
    .Some(vname) => {
      // Decided before the mark: the value is released here exactly when the
      // scope-end drop the mark suppresses would have released it.
      if(!is_tv && !_is_init_assignment(&arg_expr) && _consume_releases_variable(&vname, &cur_env, ctx), {
        record_consume_release(ast_expr_id(expr));
      });
      set_variable_as_consumed(&vname, ast_expr_token(&arg_expr), &cur_env, false, is_tv, exn);
    },
    .None => ()
  );
  out_info := new_expr_info(&cur_env, t_unit());
  out_info.value = Option(EvalValue).Some(EvalValue.UnitVal);
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_info);
  expr
});
export(evaluate_consume, set_variable_as_consumed);
