//! evaluator/builtins/quote — implements evaluate_quote and process_unquotes_in_expr.
//!
//! 1:1 port of `src/evaluator/builtins/quote.ts`.
//!
//! `quote(expr)` lifts an expression as a first-class compile-time value of
//! type `Expr`.  Inside a quoted expression, `unquote(x)` (or `#(x)`)
//! evaluates `x` at compile time and splices the resulting `Expr` value back
//! in, while `unquote_splicing(xs)` (or `...#(xs)`) splices a `ComptimeList(Expr)`
//! into the surrounding argument list.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/collections/array_list"));
{
  AstExpr,
  ExprId,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  make_err_expr,
  clone_expr_fresh_ids,
  BK_QUOTE
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get
} :: import("../../expr_info.yo");
{ Token } :: import("../../token.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext } :: import("../context.yo");
{
  EvalValue,
  is_unknown_val,
  is_expr_val,
  is_comptime_list_val
} :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_expr_t, t_comptime_list } :: import("../../types/creators.yo");
{ is_expr_type, is_expr_list_type } :: import("../../types/guards.yo");
{ format_error_message } :: import("../../error.yo");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ Exception } :: import("std/error");
// Constant string aliases for unquote/unquote_splicing builtin keyword names.
BK_UNQUOTE :: "unquote";
BK_HASH :: "#";
BK_UNQUOTE_SPLICING :: "unquote_splicing";
BK_SPREAD_HASH :: "...#";
BK_SPREAD :: "...";
/// Returns true if `expr` is an `unquote` / `#` call with exactly 1 argument.
_is_unquote :: (fn(e : AstExpr) -> bool)(
  ast_expr_is_fn_call_of(e, BK_UNQUOTE, Option(usize).Some(usize(1))) || ast_expr_is_fn_call_of(e, BK_HASH, Option(usize).Some(usize(1)))
);
/// Returns true if `expr` is an `unquote_splicing` / `...#` call with 1 arg.
_is_unquote_splicing :: (fn(e : AstExpr) -> bool)(
  ast_expr_is_fn_call_of(e, BK_UNQUOTE_SPLICING, Option(usize).Some(usize(1))) || ast_expr_is_fn_call_of(e, BK_SPREAD_HASH, Option(usize).Some(usize(1)))
);
/// Returns true if `expr` is `...#(x)` — spread(unquote(x)).
_is_spread_unquote :: (fn(e : AstExpr) -> bool)(
  match(
    e,
    .FnCall(_, fb, args, _, _) => {
      is_spread := match(fb, .Atom(_, tok) => (tok.value == BK_SPREAD), _ => false);
      if(!is_spread, {
        return(false);
      });
      if(!(args.len() == usize(1)), {
        return(false);
      });
      inner := match(
        args.get(usize(0)),
        .Some(a) => a,
        .None => {
          return(false);
        }
      );
      _is_unquote(inner)
    },
    .Atom(_, _) => false
  )
);
/// Recursively walk `expr`, evaluating any embedded `unquote`/`unquote_splicing`
/// sub-expressions and constructing a new (possibly modified) AST node.
///
/// Mirrors `processUnquotesInExpr` in `src/evaluator/builtins/quote.ts`.
process_unquotes_in_expr :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  // Atom nodes pass through unchanged.
  if(ast_expr_is_atom(expr), {
    return(expr);
  });
  // --- FnCall processing ---
  match(
    expr,
    .FnCall(id, func_box, args, is_infix, tok) => {
      // Case 1: the NODE ITSELF is `unquote(x)` — evaluate the single
      // argument and return the expression it contains. NOTE: the test is
      // on `expr`, NOT on `func_box` — TS checks `exprIsAtomOf(func,
      // unquote)` (quote.ts:46-50), i.e. the CALLEE ATOM; testing the
      // callee with `_is_unquote` (is-the-callee-an-unquote-CALL) never
      // matched, so unquotes were silently left UNSPLICED in every
      // expansion and only "worked" when the unexpanded node happened to
      // evaluate benignly (LHS `unquote(temp) := ...` did not —
      // tests/codegen-bootstrap/try_macro_assign.yo).
      if(_is_unquote(expr), {
        if(!(args.len() == usize(1)), {
          return(expr);
        });
        arg := match(
          args.get(usize(0)),
          .Some(a) => a,
          .None => {
            return(expr);
          }
        );
        eval_arg := evaluate_expression_raw(arg, env, ctx, exn);
        arg_info := match(
          expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_arg)),
          .Some(i) => i,
          .None => {
            exn.throw(
              dyn(
                format_error_message(
                  tok,
                  String.from("unquote: failed to evaluate argument"),
                  false,
                  .None
                )
              )
            );
            new_expr_info(env, t_expr_t())
          }
        );
        val := match(
          arg_info.value,
          .None => {
            exn.throw(dyn(format_error_message(tok, String.from("unquote: argument must have a compile-time value"), false, .None)));
            EvalValue.ExprVal(make_err_expr())
          },
          .Some(v) => v
        );
        // If type is not Expr but value is unknown → leave original expr in
        if(!is_expr_type(arg_info.ty), {
          if(is_unknown_val(val), {
            return(expr);
          });
          exn.throw(dyn(format_error_message(tok, String.from("unquote: expected Expr type"), false, .None)));
        });
        if(is_unknown_val(val), {
          return(expr);
        });
        // FRESH-ID CLONE of the spliced AST — `eb` alone embeds the
        // env-bound ExprVal's nodes (and their ExprInfo keys) into the
        // expansion; see the template-clone comment in `evaluate_quote`.
        inner_expr := match(
          val,
          .ExprVal(eb) => clone_expr_fresh_ids(eb),
          _ => {
            exn.throw(dyn(format_error_message(tok, String.from("unquote: expected ExprVal"), false, .None)));
            make_err_expr()
          }
        );
        return(inner_expr);
      });
      // Case 2: Process func and each arg, expanding unquote_splicing.
      new_func := recur(func_box, env, ctx, exn);
      new_args := ArrayList(AstExpr).new();
      i := usize(0);
      n := args.len();
      while(i < n, {
        opt_arg := args.get(i);
        i = (i + usize(1));
        match(
          opt_arg,
          .None => (),
          .Some(arg) => {
            // Check for unquote_splicing or spread(unquote(...))
            is_splice := (_is_unquote_splicing(arg) || _is_spread_unquote(arg));
            if(is_splice, {
              // Extract the inner unquote argument.
              splice_inner := match(
                arg,
                .FnCall(_, _, splice_args, _, _) =>
                  if(_is_spread_unquote(arg), {
                    // ...#(x): arg is spread(...), its first arg is #(x)
                    inner_arg := match(splice_args.get(usize(0)), .Some(a) => a, .None => arg);
                    match(inner_arg, .FnCall(_, _, ia2, _, _) => match(ia2.get(usize(0)), .Some(a) => a, .None => arg), .Atom(_, _) => arg)
                  }, match(splice_args.get(usize(0)), .Some(a) => a, .None => arg)),
                .Atom(_, _) => arg
              );
              eval_splice := evaluate_expression_raw(splice_inner, env, ctx, exn);
              opt_splice_info := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_splice));
              match(
                opt_splice_info,
                .None => {
                  new_args.push(arg);
                },
                .Some(splice_info) => {
                  opt_splice_val := splice_info.value;
                  match(
                    opt_splice_val,
                    .None => {
                      new_args.push(arg);
                    },
                    .Some(splice_val) => {
                      if(!is_expr_list_type(splice_info.ty), {
                        if(is_unknown_val(splice_val), {
                          new_args.push(arg);
                        }, {
                          exn.throw(
                            dyn(
                              format_error_message(
                                ast_expr_token(arg),
                                String.from("unquote_splicing: expected ComptimeList(Expr) type"),
                                false,
                                .None
                              )
                            )
                          );
                        });
                      }, {
                        if(is_comptime_list_val(splice_val), {
                          match(
                            splice_val,
                            .ComptimeListVal(elems) => {
                              j := usize(0);
                              m := elems.len();
                              while(j < m, {
                                opt_elem := elems.get(j);
                                j = (j + usize(1));
                                match(
                                  opt_elem,
                                  .None => (),
                                  .Some(elem) => {
                                    if(is_expr_val(elem), {
                                      inner_node := match(elem, .ExprVal(eb) => clone_expr_fresh_ids(eb), _ => arg);
                                      new_args.push(inner_node);
                                    }, {
                                      new_args.push(arg);
                                    });
                                  }
                                );
                              });
                            },
                            _ => ()
                          );
                        }, {
                          // Unknown value — keep original arg
                          new_args.push(arg);
                        });
                      });
                    }
                  );
                }
              );
            }, {
              new_args.push(recur(arg, env, ctx, exn));
            });
          }
        );
      });
      AstExpr.FnCall(id, new_func, new_args, is_infix, tok)
    },
    .Atom(_, _) => expr
  )
});
evaluate_quote :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  // Process unquotes inside a FRESH-ID CLONE of the quoted template. The
  // template is part of the macro fn's body AST and is expanded on EVERY
  // call; a derived (id-preserving) clone makes every expansion share
  // ExprInfo-table keys with the template AND with every other expansion
  // of the same macro — table writes then drop values other holders still
  // reference (intermittent allocator SIGTRAPs). TS's cloneExpr creates
  // new objects (fresh `$` slots); `clone_expr_fresh_ids` is its faithful
  // mirror under the id-keyed table.
  quoted := process_unquotes_in_expr(clone_expr_fresh_ids(arg), env, ctx, exn);
  // Wrap result in ExprVal and register ExprInfo.
  val := EvalValue.ExprVal(quoted);
  out_info := new_expr_info(env, t_expr_t());
  out_info.value = Option(EvalValue).Some(val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  expr
});
export(process_unquotes_in_expr, evaluate_quote);
