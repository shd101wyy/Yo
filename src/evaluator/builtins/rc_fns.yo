//! evaluator/builtins/rc_fns — RC reference-counting builtin evaluators.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_to_string,
  make_err_expr,
  BF_YO_DECR_RC,
  BF_YO_DECR_RC_ATOMIC,
  BF_YO_DYN_DROP,
  BF_YO_SOMETYPE_DROP,
  BF_YO_DROP_ARRAY_ELEMENT,
  BF_YO_DROP_TUPLE_ELEMENT
} :: import("../../expr.yo");
{ TypeValue, TypeValueNode, shared_list, no_types, SharedList } :: import("../../types/definitions.yo");
{ t_unit } :: import("../../types/creators.yo");
{ Environment } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx } :: import("../context.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set
} :: import("../../expr_info.yo");
{ EvalValue } :: import("../../value.yo");
{ is_array_type, is_tuple_type } :: import("../../types/guards.yo");
{ type_to_string } :: import("../../types/string.yo");
{ format_error_message, format_eval_failure } :: import("../../error.yo");
{ Exception } :: import("std/error");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ is_destroying_builtin_call_capable, destroying_builtin_error_message } :: import("../memory_safety.yo");
create_option_type :: (fn(inner_type : &TypeValue) -> TypeValue)({
  variant_names := ArrayList(String).new();
  variant_names.push(String.from("None"));
  variant_names.push(String.from("Some"));
  none_fields := ArrayList(TypeValue).new();
  some_fields := ArrayList(TypeValue).new();
  some_fields.push(inner_type);
  variant_fields := ArrayList(SharedList(TypeValue)).new();
  variant_fields.push(shared_list(none_fields));
  variant_fields.push(shared_list(some_fields));
  none_labels := ArrayList(String).new();
  some_labels := ArrayList(String).new();
  // "value" — MUST match prelude Option's `Some(value : T)` label: the
  // enum-signature dedup collapses this synthesized
  // rendition with real Option instances into ONE C type (labels are not in
  // the sig), and the downcast/await emitters hardcode `.Some = { .value =`
  // — a "val"-labelled winner made the field designator miss (the lexer
  // batch "field designator 'value' does not refer to any field").
  some_labels.push(String.from("value"));
  variant_field_labels := ArrayList(SharedList(String)).new();
  variant_field_labels.push(shared_list(none_labels));
  variant_field_labels.push(shared_list(some_labels));
  discs := ArrayList(i64).new();
  discs.push(i64(0));
  discs.push(i64(1));
  rc(
    TypeValueNode.EnumT(
      String.from(""),
      // id: empty (compat checks use name only)
      String.from("Option"),
      shared_list(variant_names),
      shared_list(variant_fields),
      Option(String).None,
      // selected_variant_name
      shared_list(variant_field_labels),
      shared_list(discs),
      false,
      false,
      // type_arguments: none (a synthesized rendition, not a ctor call)
      no_types()
    )
  )
});
// ---------------------------------------------------------------------------
// Helper: evaluate one argument and get its ExprInfo.
// ---------------------------------------------------------------------------
_eval_arg :: (
  fn(
    fn_name : str,
    expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    arg_idx : usize,
    exn : Exception
  ) -> ExprInfo
)({
  args := match(expr, .FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
  arg_expr := match(args.get(arg_idx), .Some(a) => a, .None => make_err_expr());
  eval_arg := evaluate_expression_raw(&arg_expr, env, ctx, exn);
  match(
    expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&eval_arg)),
    .Some(i) => i,
    .None => {
      exn.throw(
        dyn(
          format_eval_failure(
            ast_expr_token(&arg_expr),
            `Failed to evaluate argument for ${fn_name}`
          )
        )
      );
      new_expr_info(env, t_unit())
    }
  )
});
/// Reject a builtin that destroys its argument in place (an RC release)
/// outside an unsafe-capable file, as `___drop` is: on a field the place
/// stays readable after its storage is freed
/// (`is_destroying_builtin_call_capable`).
_require_destroying_builtin_capable :: (fn(builtin : str, expr : &AstExpr, exn : Exception) -> unit)({
  tok := ast_expr_token(expr);
  if(!is_destroying_builtin_call_capable(Option(String).Some(tok.module_path.*.clone())), {
    name := String.from(builtin);
    args := match(expr, .FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
    place := match(args.get(usize(0)), .Some(a) => ast_expr_to_string(&a), .None => String.new());
    exn.throw(dyn(format_error_message(&tok, destroying_builtin_error_message(&name, &place))));
  });
});
// ---------------------------------------------------------------------------
// Simple 1-arg -> unit functions
// ---------------------------------------------------------------------------
evaluate_yo_decr_rc :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  _require_destroying_builtin_capable(BF_YO_DECR_RC, expr, exn);
  info := _eval_arg("evaluate_yo_decr_rc", expr, env, ctx, usize(0), exn);
  out := new_expr_info(&info.env, t_unit());
  out.value = .Some(EvalValue.UnitVal);
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out);
  expr
});
