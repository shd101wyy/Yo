// ---------------------------------------------------------------------------
// 1-arg -> arg type (rc_own passes ownership to caller, no comptime value)
// ---------------------------------------------------------------------------
evaluate_yo_rc_own :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  info := _eval_arg("evaluate_yo_rc_own", expr, env, ctx, usize(0), exn);
  out := new_expr_info(&info.env, &info.ty);
  out.value = .None;
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out);
  expr
});
// ---------------------------------------------------------------------------
// 2-arg -> unit functions
// ---------------------------------------------------------------------------
evaluate_yo_drop_array_element :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  _require_destroying_builtin_capable(BF_YO_DROP_ARRAY_ELEMENT, expr, exn);
  info0 := _eval_arg("evaluate_yo_drop_array_element", expr, env, ctx, usize(0), exn);
  info1 := _eval_arg("evaluate_yo_drop_array_element", expr, &info0.env, ctx, usize(1), exn);
  info1;
  out := new_expr_info(&info0.env, t_unit());
  out.value = .Some(EvalValue.UnitVal);
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out);
  expr
});
evaluate_yo_drop_tuple_element :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  _require_destroying_builtin_capable(BF_YO_DROP_TUPLE_ELEMENT, expr, exn);
  info0 := _eval_arg("evaluate_yo_drop_tuple_element", expr, env, ctx, usize(0), exn);
  info1 := _eval_arg("evaluate_yo_drop_tuple_element", expr, &info0.env, ctx, usize(1), exn);
  info1;
  out := new_expr_info(&info0.env, t_unit());
  out.value = .Some(EvalValue.UnitVal);
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out);
  expr
});
// ---------------------------------------------------------------------------
// 2-arg -> element type (dup returns the duped element value)
// ---------------------------------------------------------------------------
evaluate_yo_dup_array_element :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  info0 := _eval_arg("evaluate_yo_dup_array_element", expr, env, ctx, usize(0), exn);
  info1 := _eval_arg("evaluate_yo_dup_array_element", expr, &info0.env, ctx, usize(1), exn);
  info1;
  array_type := info0.ty;
  args := match(expr, .FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
  if(!is_array_type(&array_type), {
    tok := match(args.get(usize(0)), .Some(a) => ast_expr_token(&a), .None => ast_expr_token(expr));
    exn.throw(
      dyn(
        format_error_message(
          &tok,
          `evaluate_yo_dup_array_element: expected array type, got: ${type_to_string(&array_type)}`
        )
      )
    );
  });
  element_type := match(array_type, Rc(.Array(child_box, _, _)) => child_box, _ => t_unit());
  out := new_expr_info(&info0.env, &element_type);
  out.value = .None;
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out);
  expr
});
evaluate_yo_dup_tuple_element :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  info0 := _eval_arg("evaluate_yo_dup_tuple_element", expr, env, ctx, usize(0), exn);
  info1 := _eval_arg("evaluate_yo_dup_tuple_element", expr, &info0.env, ctx, usize(1), exn);
  tuple_type := info0.ty;
  args := match(expr, .FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
  if(!is_tuple_type(&tuple_type), {
    tok := match(args.get(usize(0)), .Some(a) => ast_expr_token(&a), .None => ast_expr_token(expr));
    exn.throw(
      dyn(
        format_error_message(
          &tok,
          `evaluate_yo_dup_tuple_element: expected tuple type, got: ${type_to_string(&tuple_type)}`
        )
      )
    );
  });
  index_raw := match(
    info1.value,
    .Some(v) => match(v, .IntLit(raw) => raw.clone(), _ => String.from("0")),
    .None => String.from("0")
  );
  index_i64 := match(index_raw.parse_i64(), .Some(v) => v, .None => i64(0));
  index_usize := usize(index_i64);
  field_types := match(tuple_type, Rc(.Tuple(_, fts)) => fts, _ => no_types());
  element_type := match(
    field_types.get(index_usize),
    .Some(ft) => ft,
    .None => {
      tok := match(args.get(usize(1)), .Some(a) => ast_expr_token(&a), .None => ast_expr_token(expr));
      exn.throw(
        dyn(
          format_error_message(
            &tok,
            `evaluate_yo_dup_tuple_element: index ${index_i64} out of bounds for tuple`
          )
        )
      );
      t_unit()
    }
  );
  out := new_expr_info(&info0.env, &element_type);
  out.value = .None;
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out);
  expr
});
export(create_option_type);
export(
  evaluate_yo_decr_rc,
  evaluate_yo_decr_rc_atomic,
  evaluate_yo_drop_array_element,
  evaluate_yo_drop_tuple_element,
  evaluate_yo_dup_array_element,
  evaluate_yo_dup_tuple_element,
  evaluate_yo_dyn_vtable_drop,
  evaluate_yo_dyn_vtable_dup,
  evaluate_yo_incr_rc,
  evaluate_yo_incr_rc_atomic,
  evaluate_yo_rc_own,
  evaluate_yo_some_type_drop,
  evaluate_yo_some_type_dup
);
