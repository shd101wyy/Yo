//! evaluator/builtins/downcast — the two `Dyn` conversions.
//!
//! `downcast(dyn_value, T)`:
//!   - Checks the first argument has a Dyn type.
//!   - Checks the second argument is a type value.
//!   - Returns Option(T) as a runtime unknown value.
//!   - Rejects a move-only T unless the Dyn lists `Clone` (E0901): the
//!     payload is copied out through its `clone`.
//!
//! `upcast(dyn_value, Dyn(Tgt...))` (plans/backlog/TYPE_SYSTEM_SOUNDNESS.md Phase 2.8):
//!   - Checks the first argument has a Dyn type and the second is a Dyn type.
//!   - Checks every trait the target requires is one the source carries, and
//!     every trait the target excludes is one the source excludes: an upcast
//!     only drops traits, so it cannot fail at run time.
//!   - Returns the target Dyn as a runtime unknown value (an owned Dyn that
//!     shares the source's payload; codegen retains it).
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  make_err_expr,
  expect_expr_to_be_fn_call_of,
  BF_DOWNCAST,
  BF_UPCAST,
  ast_expr_is_atom,
  ast_expr_to_string
} :: import("../../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set,
  expr_info_adopt_env,
  note_downcast_reference,
  note_unsize_reference,
  note_dyn_lend,
  migrate_unsized_on,
  record_unsized_site
} :: import("../../expr_info.yo");
{ Environment, snapshot_env } :: import("../../env.yo");
{ TypeValue, TypeValueNode, no_types, t_refine_inner, t_reference } :: import("../../types/definitions.yo");
{ is_dyn_type, is_reference_struct_type } :: import("../../types/guards.yo");
{ projection_call_mode_of, variable_is_reference_binding } :: import("../utils.yo");
{ _eval_builtin_args } :: import("./sizeof.yo");
{ type_to_string } :: import("../../types/string.yo");
{ EvalContext } :: import("../context.yo");
{ EvalValue, create_unknown_val, is_type_value } :: import("../../value.yo");
{ create_option_type } :: import("./rc_fns.yo");
{ attach_temp_variable_to_expr } :: import("../utils.yo");
{ evaluate_expression_raw } :: import("../exprs/expr.yo");
{ format_error_message, format_eval_failure, with_code } :: import("../../error.yo");
{ E_TRAIT_NOT_IMPLEMENTED, E_USE_OF_MOVED_VALUE } :: import("../../diagnostics.yo");
{ type_is_move_only, dyn_type_lists_clone } :: import("../../types/utils.yo");
{ are_types_compatible_exact } :: import("../../types/compatibility.yo");
{ ArrayList } :: import("std/collections/array_list");
{ Exception } :: import("std/error");
/// Evaluate `downcast(dyn_value, T)`.
///
/// Safe downcast: checks if the Dyn value's runtime type matches T,
/// returning Option(T). Dyn only wraps object types (reference-counted),
/// so the result is always an owned reference.
///
///
evaluate_downcast :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &mut EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  (cur_env : Environment) = Rc.clone(env);
  expect_expr_to_be_fn_call_of(expr, BF_DOWNCAST, Option(usize).Some(usize(2)), exn);
  // First argument: the dyn value (runtime).
  dyn_expr := match(
    expr,
    .FnCall(_, _, Rc(fargs), _, _) => match(
      fargs.get(usize(0)),
      .Some(x) => x,
      .None => {
        return(expr);
      }
    ),
    _ => {
      return(expr);
    }
  );
  // Both arguments through the builtin-argument reader, which also reads a
  // written lend (`downcast(&b.*, V)`, `downcast(dyn(&v), V)`).
  (dc_call, dc_infos) := _eval_builtin_args(expr, usize(2), "downcast", &cur_env, ctx, exn);
  dyn_info := Rc.clone(dc_infos(usize(0)));
  type_info := Rc.clone(dc_infos(usize(1)));
  cur_env = expr_info_adopt_env(&dyn_info);
  // The Dyn: an owned value (a legacy `Dyn`), or a reference to one (a lend, a
  // `&Dyn` binding, a reference-kind `dyn(&v)`), whose downcast is a view of
  // the payload (decision 49): `Option(&V)` / `Option(&mut V)`.
  (dyn_type : TypeValue) = Rc.clone(dyn_info.ty());
  (ref_mode : Option(bool)) = Option(bool).None;
  match(
    t_refine_inner(&dyn_type),
    Rc(.Reference(dr_p, dr_m, _)) => if(is_dyn_type(&dr_p), {
      ref_mode = Option(bool).Some(dr_m);
      dyn_type = Rc.clone(&dr_p);
    }),
    _ => if(is_dyn_type(&dyn_type), {
      ref_mode = match(
        projection_call_mode_of(&dyn_expr, ctx),
        .Some(pm) => Option(bool).Some(pm),
        .None => match(
          dyn_info.source_variable(),
          .Some(dv) => if(ast_expr_is_atom(&dyn_expr) && variable_is_reference_binding(&dv), Option(bool).Some(dv.is_ref() && !dv.is_imm_borrow()), Option(bool).None),
          .None => Option(bool).None
        )
      );
    })
  );
  if(!is_dyn_type(&dyn_type), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(&dyn_expr),
          `downcast expects a Dyn type as first argument, got ${type_to_string(&dyn_type)}.`
        )
      )
    );
  });
  if(!is_type_value(&type_info.value()), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(&expr),
          `downcast expects a type as second argument, got ${type_to_string(&type_info.ty())}.`
        )
      )
    );
  });
  type_expr := match(expr, .FnCall(_, _, Rc(fargs2), _, _) => match(fargs2.get(usize(1)), .Some(x) => x, .None => return(expr)), _ => return(expr));
  cur_env = expr_info_adopt_env(&type_info);
  target_type := match(
    type_info.value(),
    .Some(.TypeVal(ty_box)) => Rc.clone(ty_box),
    .Some(_) => Rc.new(TypeValueNode.Unit),
    .None => Rc.new(TypeValueNode.Unit)
  );
  // A reference downcast borrows the payload where it lives: nothing is
  // copied, so a move-only payload is fine. A `ref` object has no place apart
  // from its own pointer (the Dyn's data word IS the object), so a `ref`
  // target keeps the owned form, `Option(V)`, retained: the `ref` spelling
  // goes with V5, and src's `downcast(err, YoError)` reads it.
  match(
    ref_mode,
    .Some(rm) => if(!is_reference_struct_type(&target_type), {
      result_ty := create_option_type(&t_reference(&target_type, rm));
      out_info_r := new_expr_info(&cur_env, &result_ty);
      out_info_r.set_value(Option(EvalValue).Some(create_unknown_val(&result_ty)));
      expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_info_r);
      note_downcast_reference(ast_expr_id(expr), rm);
      attach_temp_variable_to_expr(expr, true, ctx);
      return(dc_call);
    }),
    .None => ()
  );
  // `yo fix --migrate unsized` lists a downcast of an owned Dyn (kind 6): the
  // owning form, `Result(Box(V), Box(Dyn(T)))`, comes with the `?Sized`
  // prelude, and a site that only reads the payload is `downcast(&d.*, V)`
  // (VERDICTS-40 §5).
  if(migrate_unsized_on(), {
    dc_tok := match(expr, .FnCall(_, dc_callee, _, _, _) => ast_expr_token(dc_callee), .Atom(_, t) => t.clone());
    dc_text := ast_expr_to_string(&dyn_expr);
    record_unsized_site(&dc_tok, u8(6), &dc_text);
  });
  // A downcast copies the payload out and the Dyn keeps its own. A move-only
  // payload has no implicit copy, so it is copied through its `Clone`, which
  // codegen reads from the Dyn's evidence: the Dyn must list `Clone`.
  if(type_is_move_only(&target_type) && !dyn_type_lists_clone(&dyn_type), {
    exn.throw(
      dyn(
        with_code(
          format_error_message(
            ast_expr_token(&type_expr),
            `downcast copies the payload out of the Dyn, which keeps its own, and \`${type_to_string(&target_type)}\` is move-only: it is copied with its \`clone\`, so the Dyn must list \`Clone\` (\`${type_to_string(&dyn_type)}\` does not). Downcast from a \`Dyn(..., Clone)\`, such as std/error's \`AnyError\`.`
          ),
          E_USE_OF_MOVED_VALUE
        )
      )
    );
  });
  // Construct Option(T) — Dyn only wraps object types.
  option_type := create_option_type(&target_type);
  result_value := create_unknown_val(&option_type);
  out_info := new_expr_info(&cur_env, &option_type);
  out_info.set_value(Option(EvalValue).Some(result_value));
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_info);
  attach_temp_variable_to_expr(expr, true, ctx);
  dc_call
});
/// Is `t` one of `list` (the identity relation on trait types)?
_trait_in :: (fn(t : &TypeValue, list : &ArrayList(TypeValue)) -> bool)({
  (i : usize) = usize(0);
  while(i < list.len(), {
    if(match(list.get_cloned(i), .Some(x) => are_types_compatible_exact(&x, t), .None => false), {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
/// Evaluate `upcast(dyn_value, Dyn(Tgt...))`: the same payload behind a Dyn
/// with fewer traits. Checked here, so it returns the Dyn (no `Option`).
/// Codegen reads the target vtable out of the source vtable
/// (`__yo_up_<Tgt>`, filled per concrete type at every `dyn()` site of the
/// source Dyn).
evaluate_upcast :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &mut EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  (cur_env : Environment) = Rc.clone(env);
  expect_expr_to_be_fn_call_of(expr, BF_UPCAST, Option(usize).Some(usize(2)), exn);
  dyn_expr := match(
    expr,
    .FnCall(_, _, Rc(fargs), _, _) => match(
      fargs.get(usize(0)),
      .Some(x) => x,
      .None => {
        return(expr);
      }
    ),
    _ => {
      return(expr);
    }
  );
  (uc_call, uc_infos) := _eval_builtin_args(expr, usize(2), "upcast", &cur_env, ctx, exn);
  dyn_info := Rc.clone(uc_infos(usize(0)));
  type_info := Rc.clone(uc_infos(usize(1)));
  cur_env = expr_info_adopt_env(&dyn_info);
  // An upcast through a reference (a lend, a `&Dyn` binding, `dyn(&v)`) is a
  // reference to the same payload behind fewer traits (decision 49): it
  // retains nothing, and its result is a place read as a reference like
  // `unsize`'s.
  (src_type : TypeValue) = Rc.clone(dyn_info.ty());
  (uc_ref : Option(bool)) = Option(bool).None;
  match(
    t_refine_inner(&src_type),
    Rc(.Reference(ur_p, ur_m, _)) => if(is_dyn_type(&ur_p), {
      uc_ref = Option(bool).Some(ur_m);
      src_type = Rc.clone(&ur_p);
    }),
    _ => if(is_dyn_type(&src_type), {
      uc_ref = match(
        projection_call_mode_of(&dyn_expr, ctx),
        .Some(pm) => Option(bool).Some(pm),
        .None => match(
          dyn_info.source_variable(),
          .Some(dv) => if(ast_expr_is_atom(&dyn_expr) && variable_is_reference_binding(&dv), Option(bool).Some(dv.is_ref() && !dv.is_imm_borrow()), Option(bool).None),
          .None => Option(bool).None
        )
      );
    })
  );
  if(!is_dyn_type(&src_type), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(&dyn_expr),
          `upcast expects a Dyn value as first argument, got ${type_to_string(&src_type)}.`
        )
      )
    );
  });
  type_expr := match(expr, .FnCall(_, _, Rc(fargs2), _, _) => match(fargs2.get(usize(1)), .Some(x) => x, .None => return(expr)), _ => return(expr));
  cur_env = expr_info_adopt_env(&type_info);
  target_type := match(
    type_info.value(),
    .Some(v) => match(v, .TypeVal(ty_box) => Rc.clone(ty_box), _ => Rc.new(TypeValueNode.Unit)),
    .None => Rc.new(TypeValueNode.Unit)
  );
  if(!is_dyn_type(&target_type), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(&type_expr),
          `upcast expects a Dyn type as second argument, got ${type_to_string(&type_info.ty())}.`
        )
      )
    );
  });
  src_req := match(&src_type, Rc(.DynT({ required_trait_types : r })) => Rc.clone(r), _ => no_types());
  src_neg := match(&src_type, Rc(.DynT({ negative_trait_types : n })) => Rc.clone(n), _ => no_types());
  tgt_req := match(&target_type, Rc(.DynT({ required_trait_types : r })) => Rc.clone(r), _ => no_types());
  tgt_neg := match(&target_type, Rc(.DynT({ negative_trait_types : n })) => Rc.clone(n), _ => no_types());
  (ri : usize) = usize(0);
  while(ri < tgt_req.len(), {
    rt := match(tgt_req.get(ri), .Some(t) => t, .None => Rc.new(TypeValueNode.Unit));
    if(!_trait_in(&rt, &src_req.items), {
      exn.throw(
        dyn(
          with_code(
            format_error_message(
              ast_expr_token(expr),
              `upcast cannot add a trait: ${type_to_string(&target_type)} requires ${type_to_string(&rt)}, which ${type_to_string(&src_type)} does not carry.\nAn upcast only drops traits. Call dyn(...) on the concrete value with the traits the destination needs, or downcast(...) first.`
            ),
            E_TRAIT_NOT_IMPLEMENTED
          )
        )
      );
    });
    ri = (ri + usize(1));
  });
  (ni : usize) = usize(0);
  while(ni < tgt_neg.len(), {
    nt := match(tgt_neg.get(ni), .Some(t) => t, .None => Rc.new(TypeValueNode.Unit));
    if(!_trait_in(&nt, &src_neg.items), {
      exn.throw(
        dyn(
          with_code(
            format_error_message(
              ast_expr_token(expr),
              `upcast cannot add an exclusion: ${type_to_string(&target_type)} excludes ${type_to_string(&nt)}, which ${type_to_string(&src_type)} does not exclude, so the payload might implement it.`
            ),
            E_TRAIT_NOT_IMPLEMENTED
          )
        )
      );
    });
    ni = (ni + usize(1));
  });
  result_value := create_unknown_val(&target_type);
  out_info := new_expr_info(&cur_env, &target_type);
  out_info.set_value(Option(EvalValue).Some(result_value));
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_info);
  match(
    uc_ref,
    .Some(um) => {
      note_unsize_reference(ast_expr_id(expr), um);
      note_dyn_lend(ast_expr_id(expr));
    },
    .None => attach_temp_variable_to_expr(expr, true, ctx)
  );
  uc_call
});
export(evaluate_downcast, evaluate_upcast);
