//! evaluator/builtins/ptr_fns — implements evaluate_address_call.
//!
//! Handles the `addr_of(expr)` address-of builtin. Creates a pointer type and,
//! when the target is compile-time known, a PtrVal.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token, ast_expr_id, make_err_expr, ast_expr_is_fn_call_of, ast_expr_to_string, BF_DOT } :: import("../../expr.yo");
{ is_array_type, is_struct_type, is_tuple_type } :: import("../../types/guards.yo");
{
  ExprInfo,
  ComptimeRef,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  expr_info_adopt_env,
  expr_info_comptime_ref,
  expr_info_index_trait_ptr_type,
  expr_info_set_comptime_ref,
  expr_info_set_is_index_trait_address_of,
  record_addr_of_site,
  migrate_addr_of_on
} :: import("../../expr_info.yo");
{ Variable, Environment, snapshot_env } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx } :: import("../context.yo");
{
  EvalValue,
  is_unknown_val,
  create_unknown_val,
  is_type_value
} :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ t_ptr } :: import("../../types/creators.yo");
{ format_error_message } :: import("../../error.yo");
{ attach_temp_variable_to_expr } :: import("../utils.yo");
{ evaluate_expression_guarded } :: import("../exprs/expr.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ Exception } :: import("std/error");
/// A fresh single-element PtrVal cell.
_cell1 :: (fn(v : &EvalValue) -> ArrayList(EvalValue))({
  c := ArrayList(EvalValue).new();
  c.push(v);
  c
});
{ panic, assert } :: import("std/assert");
// The type of the aggregate an element/field place points into: the object
// of `obj.f`, else the receiver of `a(i)` (the callee, or the first argument
// of a lowered index builtin) — whichever is an array, struct or tuple.
_aggregate_type_of :: (fn(place : &AstExpr, ctx : &EvalContext) -> Option(TypeValue))(
  match(
    place,
    .FnCall(_, callee, args, _, _) => {
      candidates := ArrayList(AstExpr).new();
      if(!ast_expr_is_fn_call_of(place, BF_DOT, Option(usize).None), {
        candidates.push(callee);
      });
      match(args.get(usize(0)), .Some(a0) => candidates.push(a0), .None => ());
      (found : Option(TypeValue)) = .None;
      (k : usize) = usize(0);
      while((k < candidates.len()) && found.is_none(), k = (k + usize(1)), {
        match(
          expr_info_table_get(ctx.expr_info_table, ast_expr_id(candidates(k))),
          .Some(ci) => if(is_array_type(ci.ty) || is_struct_type(ci.ty) || is_tuple_type(ci.ty), {
            found = .Some(ci.ty);
          }),
          .None => ()
        );
      });
      found
    },
    .Atom(_, _) => .None
  )
);
evaluate_address_call :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    exn : &Exception
  ) -> AstExpr
)({
  args := match(
    expr,
    .FnCall(_, _, a, _, _) => a,
    _ => {
      return(expr);
    }
  );
  arg_expr := match(
    args.get(usize(0)),
    .Some(a) => a,
    .None => {
      return(expr);
    }
  );
  // Phase C structural gate: `addr_of(expr)` produces a raw pointer value
  // (`*(T)`). In safe code that value would have type `*(T)`, which the
  // surrounding rules forbid. Reject at the construction site so the
  // diagnostic points at `addr_of(...)` rather than some downstream use.
  ptok := ast_expr_token(expr);
  if(!ctx.unsafe_context && !is_implicitly_unsafe_capable_file(Option(String).Some(ptok.module_path.clone())), {
    exn.throw(
      dyn(
        format_error_message(
          ptok,
          `Taking an address with 'addr_of(...)' produces a raw pointer ('*(T)'), which is not available in safe code.\n\nFor in-place mutation of a value, use a 'name : &mut T' parameter on the receiving function (the caller lends with '&mut x'); to read without copying, a 'name : &T' parameter (the caller lends with '&x'). For collections, the safe types (Slice(T), ArrayList(T), HashMap(K, V)) own their interior pointers — don't take an address of an element manually. If this file genuinely needs raw pointers, add 'pragma(Pragma.AllowUnsafe);' at the top.`
        )
      )
    );
  });
  // `yo fix --migrate addr-of`: every `&x` this evaluator sees is the
  // raw-pointer address-of of old code (a lent marker was peeled before
  // evaluation, and outside the migration `&x` never reaches here), so the
  // sweep rewrites it to `addr_of(x)`.
  if(migrate_addr_of_on(), match(expr, .FnCall(_, amp_callee, _, _, _) => match(amp_callee, .Atom(_, amp_tok) => record_addr_of_site(amp_tok, ast_expr_to_string(expr), false), _ => ()), _ => ()));
  // Adjust expected type: if expected is a pointer, use the pointee type.
  // Build a FRESH ExpectedTypeCtx — ExpectedTypeCtx is an
  // `object` (reference semantics), so mutating an alias of the current
  // one would corrupt the EXPECTED TYPE captured by enclosing
  // expressions (e.g. a match arm's `et.ty` became the pointee, making
  // `.None => __yo_panic(...)` arms fail "Expected u8, Actual *(u8)").
  old_expected := ctx.expected_type;
  match(
    ctx.expected_type,
    .Some(ectx) => {
      match(
        ectx.ty,
        .Pointer(pointee_box) => {
          ctx.expected_type = Option(ExpectedTypeCtx).Some(
            ExpectedTypeCtx(ty : pointee_box, env : ectx.env)
          );
        },
        _ => ()
      );
    },
    .None => ()
  );
  eval_arg_gout := ArrayList(AstExpr).new();
  eval_arg_gerr := evaluate_expression_guarded(arg_expr, env, ctx, eval_arg_gout);
  ctx.expected_type = old_expected;
  match(eval_arg_gerr, .Some(eval_arg_ge) => exn.throw(eval_arg_ge), .None => ());
  eval_arg := match(eval_arg_gout.get(usize(0)), .Some(eval_arg_g) => eval_arg_g, .None => make_err_expr());
  arg_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(eval_arg));
  match(
    arg_info_opt,
    .Some(_) => (),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(arg_expr),
            String.from("&: failed to evaluate the argument expression for reference.")
          )
        )
      );
    }
  );
  arg_info := match(
    arg_info_opt,
    .Some(i) => i,
    .None => {
      return(expr);
    }
  );
  (cur_env : Environment) = expr_info_adopt_env(arg_info);
  // Error if the argument is a type value — use * for pointer-to-type.
  if(is_type_value(arg_info.value), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(arg_expr),
          String.from("Cannot create a pointer to a type. Did you mean to use \"*\"?")
        )
      )
    );
  });
  arg_type := arg_info.ty;
  pointer_type := t_ptr(arg_type);
  // Determine compile-time pointer value from comptimeRef.
  comptime_ref_opt := expr_info_comptime_ref(arg_info);
  // Each arm wraps the AGGREGATE value in a FRESH single-element cell;
  // aliasing is preserved through the aggregate's SHARED inner
  // elements list, and `target_index` selects the element within it.
  agg_ty := _aggregate_type_of(eval_arg, ctx);
  ptr_val_from_comptime_ref := match(
    comptime_ref_opt,
    .Some(cref) => Option(EvalValue).Some(
      match(
        cref,
        .ArrayRef(elements, index) =>
          EvalValue.PtrVal(_cell1(EvalValue.ArrayVal(elements)), index, agg_ty),
        .ComptimeListRef(elements, index) =>
          EvalValue.PtrVal(_cell1(EvalValue.ComptimeListVal(elements)), index, agg_ty),
        .StructRef(field_values, field_index) =>
          // Treat field_values as an array to enable indexed access.
          EvalValue.PtrVal(_cell1(EvalValue.ArrayVal(field_values)), field_index, agg_ty),
        .TupleRef(fields, field_index) =>
          EvalValue.PtrVal(_cell1(EvalValue.ArrayVal(fields)), field_index, agg_ty)
      )
    ),
    .None => Option(EvalValue).None
  );
  // A compile-time PLACE: `comptimeRef` first, then `sourceVariable`
  // — kept separate from the UnknownValue fallback so the ladder
  // below keeps its order.
  ptr_place_val_opt := match(
    ptr_val_from_comptime_ref,
    .Some(_) => ptr_val_from_comptime_ref,
    .None => match(
      arg_info.source_variable,
      // Hand the variable's OWN value cell to the pointer
      // — writes through `p.*` land in the SAME list the variable reads,
      // the arm-22 mutable-reference semantics. Empty cell = runtime
      // variable — no comptime place.
      //
      // A RUNTIME parameter is never a compile-time place in code that is
      // emitted: a specialization binds it with the call's argument VALUE
      // (`bind_parameter`, so a CTFE execution of the body can read it), and
      // taking `&v` of that cell made the pointer a comptime value codegen
      // cannot emit — `uint64_t* p = /* skip generating value */;` for `&v` in
      // a generic fn called with a literal
      // (issues/fixed/address-of-a-parameter-in-a-generic-fn-emits-a-placeholder.md).
      // Only an executing (CTFE) evaluation addresses the cell.
      .Some(src_var) => if(
        (src_var.value.len() > usize(0)) && (!(src_var.is_parameter && !src_var.is_compile_time_only) || ctx.is_executing),
        Option(EvalValue).Some(EvalValue.PtrVal(src_var.value, usize(0), .None)),
        Option(EvalValue).None
      ),
      .None => Option(EvalValue).None
    )
  );
  // Last arm: the argument itself is a comptime
  // UnknownValue, so `&(arg)` is a comptime unknown pointer too.
  ptr_unknown_val_opt := match(
    arg_info.value,
    .Some(v) => if(
      is_unknown_val(v),
      Option(EvalValue).Some(create_unknown_val(pointer_type)),
      Option(EvalValue).None
    ),
    .None => Option(EvalValue).None
  );
  out_info := new_expr_info(cur_env, pointer_type);
  // The ladder runs IN ORDER, and the order
  // is load-bearing: the place arm must be checked BEFORE index-trait
  // pointers because comptime arrays set both properties, and the place arm
  // creates a comptime pointer whereas the index-trait arm would return a
  // runtime-only pointer (with the index-trait arm first, `p :: &(arr(0))` on
  // a COMPTIME array always took it and every later `p.*` / `p.* = v` failed
  // — tests/comptime.test.yo arms 22/23). The place arm
  // deliberately leaves `ty` at `pointer_type` and does NOT set
  // `is_index_trait_address_of`.
  match(
    ptr_place_val_opt,
    .Some(_) => {
      out_info.value = ptr_place_val_opt;
    },
    .None => match(
      expr_info_index_trait_ptr_type(arg_info),
      .Some(itp_ty) => {
        // Use the Index-trait pointer type; value is runtime only.
        out_info.ty = itp_ty;
        expr_info_set_is_index_trait_address_of(out_info, Option(bool).Some(true));
      },
      .None => {
        out_info.value = ptr_unknown_val_opt;
      }
    )
  );
  // Propagate path_collection from arg.
  out_info.path_collection = arg_info.path_collection;
  // Propagate comptime_ref so callers can mutate through the pointer.
  expr_info_set_comptime_ref(out_info, comptime_ref_opt);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), out_info);
  // Attach a temp variable name (for ownership tracking / codegen).
  attach_temp_variable_to_expr(expr, false, ctx);
  expr
});
export(evaluate_address_call);
