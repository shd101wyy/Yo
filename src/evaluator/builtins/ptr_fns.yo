//! evaluator/builtins/ptr_fns — implements evaluate_address_call.
//!
//! Handles the `addr_of(expr)` address-of builtin. Creates a pointer type and,
//! when the target is compile-time known, a PtrVal.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_token, ast_expr_id, make_err_expr, ast_expr_is_fn_call_of, ast_expr_is_atom_of, ast_expr_to_string, ast_place_text, BF_DOT, projection_tail_mode, ast_expr_is_auto_ref_receiver } :: import("../../expr.yo");
{ is_array_type, is_struct_type, is_tuple_type, is_union_type, is_reference_struct_type } :: import("../../types/guards.yo");
{ fn_param_is_ptr_borrow } :: import("../../types/utils.yo");
{ type_to_string } :: import("../../types/string.yo");
{ E_ADDR_OF_BORROW_PARAM } :: import("../../diagnostics.yo");
{
  ExprInfo,
  ComptimeRef,
  new_expr_info,
  expr_info_table_set,
  expr_info_table_get,
  expr_info_adopt_env,
  expr_info_comptime_ref,
  expr_info_index_trait_ptr_type,
  expr_info_set_comptime_ref,
  expr_info_set_is_index_trait_address_of,
  record_addr_of_site,
  migrate_addr_of_on
} :: import("../../expr_info.yo");
{ Variable, Environment, snapshot_env, get_variables_from_env } :: import("../../env.yo");
{ EvalContext, ExpectedTypeCtx, FuncOrAsyncBlockKind } :: import("../context.yo");
{
  EvalValue,
  is_unknown_val,
  create_unknown_val,
  is_type_value,
  ValueCell,
  value_cell_new
} :: import("../../value.yo");
{ TypeValue, fn_param_is_mut_ref, fn_param_is_by_value } :: import("../../types/definitions.yo");
{ t_ptr } :: import("../../types/creators.yo");
{ format_error_message, format_error_message_with_help, with_code } :: import("../../error.yo");
{ attach_temp_variable_to_expr, projection_call_mode_of, projection_call_root_args, record_copy_pointer_place } :: import("../utils.yo");
{ evaluate_expression_guarded } :: import("../exprs/expr.yo");
{ is_implicitly_unsafe_capable_file } :: import("../memory_safety.yo");
{ call_promote_index_places_for_write } :: import("../context.yo");
{ Exception } :: import("std/error");
/// A fresh single-element PtrVal cell.
_cell1 :: (fn(v : &EvalValue) -> ValueCell)({
  c := ArrayList(EvalValue).new();
  c.push(v);
  value_cell_new(c)
});
{ panic, assert } :: import("std/assert");
// The type of the aggregate an element/field place points into: the object
// of `obj.f`, else the receiver of `a(i)` (the callee, or the first argument
// of a lowered index builtin) — whichever is an array, struct or tuple.
_aggregate_type_of :: (fn(place : &AstExpr, ctx : &EvalContext) -> Option(TypeValue))(
  match(
    place,
    .FnCall(_, callee, args, _, _) => {
      candidates := ArrayList(AstExpr).new();
      if(!ast_expr_is_fn_call_of(place, BF_DOT, Option(usize).None), {
        candidates.push(callee);
      });
      match(args.get(usize(0)), .Some(a0) => candidates.push(a0), .None => ());
      (found : Option(TypeValue)) = .None;
      (k : usize) = usize(0);
      while((k < candidates.len()) && found.is_none(), k = (k + usize(1)), {
        match(
          expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&candidates(k))),
          .Some(ci) => if(is_array_type(&ci.ty) || is_struct_type(&ci.ty) || is_tuple_type(&ci.ty), {
            found = .Some(Rc.clone(ci.ty));
          }),
          .None => ()
        );
      });
      found
    },
    .Atom(_, _) => .None
  )
);
/// Decision 24's root rule (the first cut of `REFERENCES_AND_ORIGINS.md` O3's return rule; R3 before 2026-10-20): the
/// place a projection yields is reached from one of its own borrow
/// parameters, through field steps, element accesses and raw-pointer derefs
/// (`p.*`, which only a `pragma(AllowUnsafe)` file can write). A `&mut place`
/// result needs a `&mut` parameter. Returns the error, or `.None`.
_projection_root_error :: (fn(place : &AstExpr, is_mut : bool, env : &Environment, ctx : &EvalContext) -> Option(String))(
  match(
    place,
    .Atom(_, pr_tok) => match(
      get_variables_from_env(env, pr_tok.value.*.clone()).last(),
      .Some(v) => cond(
        (!v.is_parameter || v.is_compile_time_only || !(v.is_ref || v.is_imm_borrow)) => Option(String).Some(
          `A projection yields a place reached from one of its \`&\`/\`&mut\` parameters, and \`${pr_tok.value.*}\` is ${cond(v.is_parameter => "a by-value parameter", v.is_module_level => "a module-level binding", true => "a local")}: its storage ends with the call (decision 24, the single-root rule).`
        ),
        (is_mut && (!v.is_ref || v.is_imm_borrow)) => Option(String).Some(
          `A \`&mut\` projection yields a place reached from a \`&mut\` parameter, and \`${pr_tok.value.*}\` is a shared borrow (\`&T\`).`
        ),
        true => Option(String).None
      ),
      .None => Option(String).Some(`A projection yields a place reached from one of its \`&\`/\`&mut\` parameters; \`${pr_tok.value.*}\` is not one.`)
    ),
    .FnCall(_, pr_callee, pr_args, _, _) => cond(
      ast_expr_is_fn_call_of(place, BF_DOT, Option(usize).Some(usize(2))) => match(
        pr_args.get(usize(1)),
        // A raw-pointer deref: the place is wherever the pointer points.
        .Some(f) => if(ast_expr_is_atom_of(&f, "*"), Option(String).None, {
          base := match(pr_args.get(usize(0)), .Some(b) => b, .None => make_err_expr());
          _projection_root_error(&base, is_mut, env, ctx)
        }),
        .None => Option(String).None
      ),
      match(expr_info_table_get(&ctx.expr_info_table, ast_expr_id(place)), .Some(pi) => expr_info_index_trait_ptr_type(&pi).is_some(), .None => false) => _projection_root_error(&pr_callee, is_mut, env, ctx),
      projection_call_mode_of(place, ctx).is_some() => _projection_call_root_error(place, is_mut, env, ctx),
      true => Option(String).Some(String.from("A projection yields a place, and this is a temporary: its storage ends with the call (decision 24, the single-root rule)."))
    )
  )
);
/// A projection that yields another projection's result (decision 24): the
/// inner call's place is rooted at its borrowed arguments
/// (`projection_call_root_args`), so each of them must be rooted at this
/// projection's own borrow parameters. A `&mut` inner projection's place is
/// rooted at its `&mut` arguments alone (its own root rule). A `&mut` result
/// needs a `&mut` inner projection.
_projection_call_root_error :: (fn(call : &AstExpr, is_mut : bool, env : &Environment, ctx : &EvalContext) -> Option(String))({
  inner_mut := match(projection_call_mode_of(call, ctx), .Some(m) => m, .None => false);
  if(is_mut && !inner_mut, {
    return(Option(String).Some(`A \`&mut\` projection yields a place it may write, and \`${ast_expr_to_string(call)}\` is the result of a read projection (\`-> &T\`).`));
  });
  roots := projection_call_root_args(call, ctx);
  (checked : usize) = usize(0);
  (i : usize) = usize(0);
  while(i < roots.len(), {
    r := roots(i);
    if(!inner_mut || r.is_mut, {
      match(_projection_root_error(&r.arg, is_mut, env, ctx), .Some(msg) => return(Option(String).Some(msg)), .None => ());
      checked = (checked + usize(1));
    });
    i = (i + usize(1));
  });
  cond(
    (checked == usize(0)) => Option(String).Some(String.from("A projection yields a place, and this call borrows no argument: its storage ends with the call (decision 24, the single-root rule).")),
    true => Option(String).None
  )
});
/// Whether `v` is a `&T` parameter passed BY VALUE: decision 34 passes a
/// `&T` parameter as a copy, except a projection's (`-> &T`, decision 24),
/// which `fn_param_is_ptr_borrow` passes as a pointer and binds `is_ref`. When
/// `v` is a parameter of the innermost function being evaluated, the
/// function's declared modes decide: a specialization's runtime-placeholder
/// re-bind marks every non-`&mut` parameter `is_imm_borrow`
/// (`create_specialized_function_inline`), a by-value one included.
_is_by_value_borrow_param :: (fn(v : &Variable, ctx : &EvalContext) -> bool)({
  if(!v.is_parameter || !v.is_imm_borrow || v.is_ref || v.is_compile_time_only, {
    return(false);
  });
  match(
    ctx.is_evaluating_function_body_or_async_block,
    .Some(fb) => match(
      fb.kind,
      .FunctionBody => match(
        &fb.func_type,
        .Some(ft) => match(
          ft,
          Rc(.Func({ meta : bp_m })) => {
            (i : usize) = usize(0);
            n := bp_m.*.param_labels.len();
            while(i < n, {
              if(match(bp_m.*.param_labels.get(i), .Some(l) => (l == v.name), .None => false), {
                return(
                  !fn_param_is_mut_ref(&ft, i) && !fn_param_is_by_value(&ft, i) && !fn_param_is_ptr_borrow(&ft, i)
                );
              });
              i = (i + usize(1));
            });
            true
          },
          _ => true
        ),
        .None => true
      ),
      _ => true
    ),
    .None => true
  )
});
/// A value aggregate holds its fields and elements inline, so a place inside
/// it is inside its storage; a `ref(struct(...))` handle's fields live in the
/// shared cell, a pointer's target elsewhere.
_holds_its_places_inline :: (fn(e : &AstExpr, ctx : &EvalContext) -> bool)(
  match(
    expr_info_table_get(&ctx.expr_info_table, ast_expr_id(e)),
    .Some(hi) => ((is_struct_type(&hi.ty) && !is_reference_struct_type(&hi.ty)) || is_tuple_type(&hi.ty) || is_union_type(&hi.ty) || is_array_type(&hi.ty)),
    .None => false
  )
);
/// The by-value `&T` parameter (`_is_by_value_borrow_param`) whose own
/// storage `place` names: the parameter itself, or a place reached from it
/// through field steps of value aggregates and element accesses of fixed-size
/// arrays. A raw-pointer dereference (`p.*`), a `ref` handle's field and an
/// `Index` element of a collection reach storage the parameter does not hold.
_by_value_borrow_param_root :: (fn(place : &AstExpr, env : &Environment, ctx : &EvalContext) -> Option(Variable))(
  match(
    place,
    .Atom(_, br_tok) => match(
      get_variables_from_env(env, br_tok.value.*.clone()).last(),
      .Some(v) => if(_is_by_value_borrow_param(&v, ctx), Option(Variable).Some(v), Option(Variable).None),
      .None => Option(Variable).None
    ),
    .FnCall(_, br_callee, br_args, _, _) => cond(
      ast_expr_is_fn_call_of(place, BF_DOT, Option(usize).Some(usize(2))) => match(
        br_args.get(usize(1)),
        .Some(f) => if(ast_expr_is_atom_of(&f, "*"), Option(Variable).None, {
          base := match(br_args.get(usize(0)), .Some(b) => b, .None => make_err_expr());
          if(_holds_its_places_inline(&base, ctx), _by_value_borrow_param_root(&base, env, ctx), Option(Variable).None)
        }),
        .None => Option(Variable).None
      ),
      ((br_args.len() == usize(1)) && match(expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&br_callee)), .Some(ci) => is_array_type(&ci.ty), .None => false)) =>
        _by_value_borrow_param_root(&br_callee, env, ctx),
      true => Option(Variable).None
    )
  )
);
evaluate_address_call :: (
  fn(
    expr : &AstExpr,
    env : &Environment,
    ctx : &EvalContext,
    exn : Exception
  ) -> AstExpr
)({
  arg_expr := match(
    expr,
    .FnCall(_, _, fargs, _, _) => match(
      fargs.get(usize(0)),
      .Some(x) => x,
      .None => {
        return(expr);
      }
    ),
    _ => {
      return(expr);
    }
  );
  // Phase C structural gate: `addr_of(expr)` produces a raw pointer value
  // (`*(T)`). In safe code that value would have type `*(T)`, which the
  // surrounding rules forbid. Reject at the construction site so the
  // diagnostic points at `addr_of(...)` rather than some downstream use.
  ptok := ast_expr_token(expr);
  if(!ctx.unsafe_context && !is_implicitly_unsafe_capable_file(Option(String).Some(ptok.module_path.*.clone())), {
    exn.throw(
      dyn(
        format_error_message(
          &ptok,
          `Taking an address with 'addr_of(...)' produces a raw pointer ('*(T)'), which is not available in safe code.\n\nFor in-place mutation of a value, use a 'name : &mut T' parameter on the receiving function (the caller lends with '&mut x'); to read without copying, a 'name : &T' parameter (the caller lends with '&x'). For collections, the safe types (Slice(T), ArrayList(T), HashMap(K, V)) own their interior pointers — don't take an address of an element manually. If this file genuinely needs raw pointers, add 'pragma(Pragma.AllowUnsafe);' at the top.`
        )
      )
    );
  });
  // `yo fix --migrate addr-of`: every `&x` this evaluator sees is the
  // raw-pointer address-of of old code (a lent marker was peeled before
  // evaluation, and outside the migration `&x` never reaches here), so the
  // sweep rewrites it to `addr_of(x)`.
  if(migrate_addr_of_on(), match(expr, .FnCall(_, amp_callee, _, _, _) => match(amp_callee, .Atom(_, amp_tok) => record_addr_of_site(&amp_tok, ast_expr_to_string(expr), false), _ => ()), _ => ()));
  // Adjust expected type: if expected is a pointer, use the pointee type.
  // Build a FRESH ExpectedTypeCtx — ExpectedTypeCtx is an
  // `object` (reference semantics), so mutating an alias of the current
  // one would corrupt the EXPECTED TYPE captured by enclosing
  // expressions (e.g. a match arm's `et.ty` became the pointee, making
  // `.None => __yo_panic(...)` arms fail "Expected u8, Actual *(u8)").
  old_expected := ctx.expected_type;
  match(
    ctx.expected_type,
    .Some(ectx) => {
      match(
        &ectx.ty,
        Rc(.Pointer(pointee_box)) => {
          ctx.expected_type = Option(ExpectedTypeCtx).Some(
            ExpectedTypeCtx(ty : Rc.clone(pointee_box), env : ectx.env)
          );
        },
        _ => ()
      );
    },
    .None => ()
  );
  eval_arg_gout := ArrayList(AstExpr).new();
  eval_arg_gerr := evaluate_expression_guarded(&arg_expr, env, ctx, &mut eval_arg_gout);
  ctx.expected_type = old_expected;
  match(eval_arg_gerr, .Some(eval_arg_ge) => exn.throw(eval_arg_ge), .None => ());
  eval_arg := match(eval_arg_gout.get(usize(0)), .Some(eval_arg_g) => eval_arg_g, .None => make_err_expr());
  // `yo fix --migrate explicit-copy`: the pointer reaches the storage of the
  // variable the operand is rooted in (`addr_of(marks(i))`), whose copies
  // the migration must then not `.clone()`.
  record_copy_pointer_place(&arg_expr, env, &ptok);
  arg_info_opt := expr_info_table_get(&ctx.expr_info_table, ast_expr_id(&eval_arg));
  match(
    arg_info_opt,
    .Some(_) => (),
    .None => {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(&arg_expr),
            String.from("&: failed to evaluate the argument expression for reference.")
          )
        )
      );
    }
  );
  arg_info := match(
    arg_info_opt,
    .Some(i) => i,
    .None => {
      return(expr);
    }
  );
  (cur_env : Environment) = expr_info_adopt_env(&arg_info);
  // Error if the argument is a type value — use * for pointer-to-type.
  if(is_type_value(&arg_info.value), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(&arg_expr),
          String.from("Cannot create a pointer to a type. Did you mean to use \"*\"?")
        )
      )
    );
  });
  // A raw pointer and a `&mut` projection's result write the place, so its
  // element accesses dispatch `IndexMut` (decision 34, V2b); a `&`
  // projection's result only reads it.
  if(match(projection_tail_mode(expr), .Some(ptm) => ptm, .None => true), {
    call_promote_index_places_for_write(&eval_arg, env, ctx, exn);
  });
  // A projection's result (`rewrite_projection_tails`): the place must be
  // rooted at the projection's own borrow parameters.
  match(
    projection_tail_mode(expr),
    .Some(pt_mut) => match(
      _projection_root_error(&eval_arg, pt_mut, env, ctx),
      .Some(pt_msg) => {
        exn.throw(dyn(format_error_message(ast_expr_token(&arg_expr), &pt_msg)));
      },
      .None => ()
    ),
    .None => ()
  );
  // E0921: a `&T` parameter is passed as a copy (decision 34), so its
  // address — or a place inside it — is the callee's copy, not the caller's
  // place, and dangles once the call returns. Exempt: a projection's result
  // node (its `&T` parameters are pointers, and it yields a borrow), and the
  // `addr_of(receiver)` synthesized for a pointer-receiver method call, whose
  // pointer lives for the call.
  if(projection_tail_mode(expr).is_none() && !ast_expr_is_auto_ref_receiver(expr), {
    match(
      _by_value_borrow_param_root(&eval_arg, env, ctx),
      .Some(bp) => {
        bp_place := ast_place_text(&arg_expr);
        bp_ty := type_to_string(&bp.ty);
        bp_what := if(match(eval_arg, .Atom(_, _) => true, _ => false), `\`${bp.name}\`, a \`&${bp_ty}\` parameter`, `a place inside \`${bp.name}\`, a \`&${bp_ty}\` parameter`);
        exn.throw(
          dyn(
            with_code(
              format_error_message_with_help(
                &ptok,
                `\`addr_of(${bp_place})\` takes the address of ${bp_what}, and a \`&T\` parameter has no stable address: it is passed as a copy (decision 34), so the pointer would point at the callee's copy, not at the caller's place, and dangle once the call returns.`,
                Option(String).Some(
                  `for the caller's address, declare the parameter \`${bp.name} : *${bp_ty}\` and pass \`addr_of(place)\` at the call, or \`${bp.name} : &mut ${bp_ty}\` (passed as a pointer); to read the value, use \`${bp.name}\` itself`
                )
              ),
              E_ADDR_OF_BORROW_PARAM
            )
          )
        );
      },
      .None => ()
    );
  });
  arg_type := Rc.clone(arg_info.ty);
  pointer_type := t_ptr(&arg_type);
  // Determine compile-time pointer value from comptimeRef.
  comptime_ref_opt := expr_info_comptime_ref(&arg_info);
  // Each arm wraps the AGGREGATE value in a FRESH single-element cell;
  // aliasing is preserved through the aggregate's SHARED inner
  // elements list, and `target_index` selects the element within it.
  agg_ty := _aggregate_type_of(&eval_arg, ctx);
  ptr_val_from_comptime_ref := match(
    &comptime_ref_opt,
    .Some(cref) => Option(EvalValue).Some(
      match(
        cref,
        .ArrayRef(elements, index) =>
          EvalValue.PtrVal(_cell1(EvalValue.ArrayVal(Rc.clone(elements))), index, agg_ty),
        .ComptimeListRef(elements, index) =>
          EvalValue.PtrVal(_cell1(EvalValue.ComptimeListVal(Rc.clone(elements))), index, agg_ty),
        .StructRef(field_values, field_index) =>
          // Treat field_values as an array to enable indexed access.
          EvalValue.PtrVal(_cell1(EvalValue.ArrayVal(Rc.clone(field_values))), field_index, agg_ty),
        .TupleRef(fields, field_index) =>
          EvalValue.PtrVal(_cell1(EvalValue.ArrayVal(Rc.clone(fields))), field_index, agg_ty)
      )
    ),
    .None => Option(EvalValue).None
  );
  // A compile-time PLACE: `comptimeRef` first, then `sourceVariable`
  // — kept separate from the UnknownValue fallback so the ladder
  // below keeps its order.
  ptr_place_val_opt := match(
    ptr_val_from_comptime_ref,
    .Some(_) => ptr_val_from_comptime_ref,
    .None => match(
      arg_info.source_variable,
      // Hand the variable's OWN value cell to the pointer
      // — writes through `p.*` land in the SAME list the variable reads,
      // the arm-22 mutable-reference semantics. Empty cell = runtime
      // variable — no comptime place.
      //
      // A RUNTIME parameter is never a compile-time place in code that is
      // emitted: a specialization binds it with the call's argument VALUE
      // (`bind_parameter`, so a CTFE execution of the body can read it), and
      // taking `&v` of that cell made the pointer a comptime value codegen
      // cannot emit — `uint64_t* p = /* skip generating value */;` for `&v` in
      // a generic fn called with a literal
      // (issues/fixed/address-of-a-parameter-in-a-generic-fn-emits-a-placeholder.md).
      // Only an executing (CTFE) evaluation addresses the cell.
      .Some(src_var) => if(
        (src_var.value.len() > usize(0)) && (!(src_var.is_parameter && !src_var.is_compile_time_only) || ctx.is_executing),
        Option(EvalValue).Some(EvalValue.PtrVal(Rc.clone(src_var.value), usize(0), .None)),
        Option(EvalValue).None
      ),
      .None => Option(EvalValue).None
    )
  );
  // Last arm: the argument itself is a comptime
  // UnknownValue, so `&(arg)` is a comptime unknown pointer too.
  ptr_unknown_val_opt := match(
    arg_info.value,
    .Some(v) => if(
      is_unknown_val(&v),
      Option(EvalValue).Some(create_unknown_val(&pointer_type)),
      Option(EvalValue).None
    ),
    .None => Option(EvalValue).None
  );
  out_info := new_expr_info(&cur_env, &pointer_type);
  // The ladder runs IN ORDER, and the order
  // is load-bearing: the place arm must be checked BEFORE index-trait
  // pointers because comptime arrays set both properties, and the place arm
  // creates a comptime pointer whereas the index-trait arm would return a
  // runtime-only pointer (with the index-trait arm first, `p :: &(arr(0))` on
  // a COMPTIME array always took it and every later `p.*` / `p.* = v` failed
  // — tests/comptime.test.yo arms 22/23). The place arm
  // deliberately leaves `ty` at `pointer_type` and does NOT set
  // `is_index_trait_address_of`.
  match(
    ptr_place_val_opt,
    .Some(_) => {
      out_info.value = ptr_place_val_opt;
    },
    .None => match(
      expr_info_index_trait_ptr_type(&arg_info),
      .Some(itp_ty) => {
        // Use the Index-trait pointer type; value is runtime only.
        out_info.ty = itp_ty;
        expr_info_set_is_index_trait_address_of(&out_info, Option(bool).Some(true));
      },
      .None => {
        out_info.value = ptr_unknown_val_opt;
      }
    )
  );
  // Propagate path_collection from arg.
  out_info.path_collection = arg_info.path_collection.clone();
  // Propagate comptime_ref so callers can mutate through the pointer.
  expr_info_set_comptime_ref(&out_info, &comptime_ref_opt);
  expr_info_table_set(&ctx.expr_info_table, ast_expr_id(expr), &out_info);
  // Attach a temp variable name (for ownership tracking / codegen).
  attach_temp_variable_to_expr(expr, false, ctx);
  expr
});
export(evaluate_address_call);
