//! evaluator/module_loader — per-module evaluation cache for `check`.
//!
//! For the `check` subcommand we still need
//! `ctx.load_module` to return *just* an imported file's exports — not
//! the whole flatten-eval env (which conflates prelude + every dep and
//! breaks spread-export with "already exported" errors).
//!
//! This module provides the minimal slice that makes that work within
//! the compiler's constraints:
//!
//!   * I/O (reading + parsing dependency files) cannot happen inside a
//!     plain `fn(path) -> LoadModuleResult` callback — `io` is
//!     control-bound and the callback signature is fixed. So the actual
//!     reading + evaluation is done up front by the orchestration in
//!     `main.yo` (`preload_module_tree`), which has `io`/`exn` in scope.
//!   * That orchestration evaluates each dependency module in isolation
//!     (against a clone of the cached prelude env) and registers the
//!     resulting `ModuleVal` here, keyed by the `file://`-prefixed
//!     absolute path that `evaluate_import` computes.
//!   * `load_module_from_cache` is then a pure lookup, usable directly as
//!     `ctx.load_module`.
//!
//! Net effect: cache + per-module isolation, with all effects kept at
//! the orchestration layer.
{ String } :: import("std/string");
{ RefCell } :: import("std/sync/refcell");
{ ArrayList } :: import("std/collections/array_list");
{ EvalValue } :: import("../value.yo");
{ TypeValue, TypeValueNode, shared_list } :: import("../types/definitions.yo");
{ Environment, Variable } :: import("../env.yo");
{ LoadModuleResult } :: import("./context.yo");
{ set_registration_owner, set_import_closure_fn } :: import("./values/type_trait_methods.yo");
{ HashMap } :: import("std/collections/hash_map");
{ HashSet } :: import("std/collections/hash_set");
{ canonical_module_path } :: import("../utils.yo");
// ---------------------------------------------------------------------------
// In-progress (currently-loading) registry — enables CIRCULAR imports under
// demand-driven loading (main.yo `demand_load_module`). When module A is mid-
// evaluation and imports B, and B imports A, A is "loading": the importer reads
// A's LIVE env (its exported names are already bound as variables) to build a
// partial ModuleVal, instead of erroring "module not preloaded" — the loader
// returns the in-progress module for cycles.
// ---------------------------------------------------------------------------
(g_loading_keys : RefCell(ArrayList(String))) = RefCell(ArrayList(String)).new(ArrayList(String).new());
(g_loading_envs : RefCell(ArrayList(Environment))) = RefCell(ArrayList(Environment)).new(ArrayList(Environment).new());
(g_import_edge_importers : RefCell(ArrayList(String))) = RefCell(ArrayList(String)).new(ArrayList(String).new());
(g_import_edge_imports : RefCell(ArrayList(String))) = RefCell(ArrayList(String)).new(ArrayList(String).new());
(mut(g_import_closure_installed) : bool) = false;
(g_loading_key_by_canonical : RefCell(HashMap(String, String))) = RefCell(HashMap(String, String)).new(HashMap(String, String).new());
/// Canonical spellings and import closures are handed out as `Rc`s, so a
/// memo hit shares the stored value instead of copying a path (or a whole
/// set) per lookup: once collections and `String` are values
/// (VALUES_BY_DEFAULT V2b), a copy out of a map is a deep one
/// (plans/handover/VBD_HANDOVER_2026-10-19.md §3.1).
(_canonical_memo : RefCell(HashMap(String, Rc(String)))) = RefCell(HashMap(String, Rc(String))).new(HashMap(String, Rc(String)).new());
(g_import_closure_memo : RefCell(HashMap(String, Rc(HashSet(String))))) = RefCell(HashMap(String, Rc(HashSet(String)))).new(HashMap(String, Rc(HashSet(String))).new());
(g_always_visible_owners : RefCell(ArrayList(String))) = RefCell(ArrayList(String)).new(ArrayList(String).new());
/// Keep the registries' owner tag in sync with the loading-stack top
/// (Phase B2, plans/reference/INCREMENTAL_COMPILATION.md). The tag lives in
/// type_trait_methods.yo — see `set_registration_owner`'s doc there.
_sync_registration_owner :: (fn() -> unit)({
  n := g_loading_keys.with(xs => xs.len());
  owner := cond(
    (n > usize(0)) => match(g_loading_keys.with(xs => xs.get(n - usize(1))), .Some(k) => k.clone(), .None => String.new()),
    true => String.new()
  );
  set_registration_owner(&owner);
});
/// Register `path` as currently-loading with its live evaluation `env`.
register_loading :: (fn(path : &String, env : &Environment) -> unit)({
  if(!g_import_closure_installed, {
    set_import_closure_fn(import_closure_of);
    g_import_closure_installed = true;
  });
  g_loading_key_by_canonical.with_mut(m => m.insert(_canonical(path).*, path.clone()));
  g_loading_keys.with_mut(xs => xs.push(path));
  g_loading_envs.with_mut(xs => xs.push(env));
  _sync_registration_owner();
});
/// The loading key (`file://<abs>`, or the entry path as typed) under which
/// `module` was registered — the spelling the registries' owner tags use.
/// `.None` for a module never loaded through this loader.
loading_key_for_module :: (fn(module : &String) -> Option(String))({
  canon := _canonical(module);
  g_loading_key_by_canonical.with(m => m.get(&canon.*))
});
/// Remove the most-recent loading entry for `path` (LIFO — nested loads).
unregister_loading :: (fn(path : &String) -> unit)({
  (i : usize) = g_loading_keys.with(xs => xs.len());
  while(i > usize(0), {
    i = (i - usize(1));
    match(
      g_loading_keys.with(xs => xs.get(i)),
      .Some(k) => if(k == path, {
        g_loading_keys.with_mut(xs => xs.drain(i .. (i + usize(1))));
        g_loading_envs.with_mut(xs => xs.drain(i .. (i + usize(1))));
        _sync_registration_owner();
        return(());
      }),
      .None => ()
    );
  });
});
/// The abs path of the module currently being evaluated (top of the
/// loading stack), or `.None` outside any module evaluation. The demand
/// loader uses it to attribute import-graph edges to their importer.
current_loading_module :: (fn() -> Option(String))(
  cond(
    (g_loading_keys.with(xs => xs.len()) > usize(0)) => g_loading_keys.with(xs => xs.last()),
    true => Option(String).None
  )
);
/// The live env of a currently-loading module, or `.None`.
loading_env :: (fn(path : &String) -> Option(Environment))({
  (i : usize) = g_loading_keys.with(xs => xs.len());
  while(i > usize(0), {
    i = (i - usize(1));
    match(
      g_loading_keys.with(xs => xs.get(i)),
      .Some(k) => if(k == path, {
        return(g_loading_envs.with(xs => xs.get(i)));
      }),
      .None => ()
    );
  });
  Option(Environment).None
});
// Parallel-array cache: `g_module_cache_keys(i)` (a `file://…` absolute
// path) maps to `g_module_cache_vals(i)` (that module's exports as a
// `ModuleVal`). Parallel arrays rather than a HashMap to keep the value
// type (`EvalValue`) simple and avoid extra trait requirements.
(g_module_cache_keys : RefCell(ArrayList(String))) = RefCell(ArrayList(String)).new(ArrayList(String).new());
(g_module_cache_vals : RefCell(ArrayList(EvalValue))) = RefCell(ArrayList(EvalValue)).new(ArrayList(EvalValue).new());
(g_module_cache_types : RefCell(ArrayList(TypeValue))) = RefCell(ArrayList(TypeValue)).new(ArrayList(TypeValue).new());
// Import graph, as parallel edge arrays: `g_import_edge_importers(i)`
// imported `g_import_edge_imports(i)` (both `file://…` abs paths). Fed by
// the demand loader on EVERY import request — cache hits included, since a
// hit is still a dependency. Consumed by `invalidate_module`'s
// reverse-closure walk (plans/reference/INCREMENTAL_COMPILATION.md Phase B1).
// (declared at the top of the module, with the loading stack — `register_loading`
// installs the closure provider that reads them.)
/// Canonical spelling of a module key, memoized (the closure walk below
/// touches every edge endpoint).
_canonical :: (fn(p : &String) -> Rc(String))(
  match(
    _canonical_memo.with(m => m.get(p)),
    .Some(c) => c,
    .None => {
      c := rc(canonical_module_path(p));
      _canonical_memo.with_mut(m => m.insert(p, c));
      c
    }
  )
);
/// Import closures (canonical module → canonical reachable set, itself
/// included), memoized; any edge change drops the memo — edges are added
/// at import time and dropped on invalidation, both rare next to the
/// method-resolution lookups that consume the closure.
_clear_import_closure_memo :: (fn() -> unit)({
  g_import_closure_memo.with_mut(m => m.clear());
});
/// Mark a module whose registrations every module may see without importing
/// it: the prelude, whose impls carry `${std_path}/prelude.yo` as their owner
/// (stamped by mm_load_prelude_file, which also calls this so every prelude
/// load path gets both) but which is implicitly in scope everywhere.
mark_owner_always_visible :: (fn(module : &String) -> unit)({
  g_always_visible_owners.with_mut(xs => xs.push(_canonical(module).*));
  _clear_import_closure_memo();
});
/// Every module reachable from `module` through import edges, `module`
/// included, in canonical spelling, plus the always-visible owners. The
/// provider behind `owner_visible_from_current` (type_trait_methods.yo).
import_closure_of :: (fn(module : &String) -> Rc(HashSet(String)))({
  start := _canonical(module);
  match(
    g_import_closure_memo.with(m => m.get(&start.*)),
    .Some(s) => {
      return(s);
    },
    .None => ()
  );
  seen := HashSet(String).new();
  _ := seen.insert(start.*);
  (ai : usize) = usize(0);
  while(ai < g_always_visible_owners.with(xs => xs.len()), {
    match(
      g_always_visible_owners.with(xs => xs.get(ai)),
      .Some(o) => {
        _ := seen.insert(o);
      },
      .None => ()
    );
    ai = (ai + usize(1));
  });
  work := ArrayList(String).new();
  work.push(start.*);
  while(work.len() > usize(0), {
    p := match(work.pop(), .Some(x) => x, .None => String.new());
    n := g_import_edge_importers.with(xs => xs.len());
    (i : usize) = usize(0);
    while(i < n, {
      from_p := match(g_import_edge_importers.with(xs => xs.get(i)), .Some(a) => (_canonical(&a).* == p), .None => false);
      if(from_p, {
        match(
          g_import_edge_imports.with(xs => xs.get(i)),
          .Some(t) => {
            tc := _canonical(&t);
            if(seen.insert(tc.*), {
              work.push(tc.*);
            });
          },
          .None => ()
        );
      });
      i = (i + usize(1));
    });
  });
  closure := rc(seen);
  g_import_closure_memo.with_mut(m => m.insert(start.*, closure));
  closure
});
/// Record that `importer` imports `imported`. Exact-pair duplicates are
/// dropped (a module importing the same dep from several sites is one edge).
record_import_edge :: (fn(importer : &String, imported : &String) -> unit)({
  (i : usize) = usize(0);
  n := g_import_edge_importers.with(xs => xs.len());
  while(i < n, {
    same := (
      match(g_import_edge_importers.with(xs => xs.get(i)), .Some(a) => (a == importer), .None => false) &&
        match(g_import_edge_imports.with(xs => xs.get(i)), .Some(b) => (b == imported), .None => false)
    );
    if(same, {
      return(());
    });
    i = (i + usize(1));
  });
  g_import_edge_importers.with_mut(xs => xs.push(importer));
  g_import_edge_imports.with_mut(xs => xs.push(imported));
  _clear_import_closure_memo();
});
/// Drop every outgoing edge of `importer`. Called when a module is
/// invalidated: its re-evaluation re-records its (possibly changed) edges.
_drop_edges_from :: (fn(importer : &String) -> unit)({
  _clear_import_closure_memo();
  (i : usize) = g_import_edge_importers.with(xs => xs.len());
  while(i > usize(0), {
    i = (i - usize(1));
    same := match(g_import_edge_importers.with(xs => xs.get(i)), .Some(a) => (a == importer), .None => false);
    if(same, {
      g_import_edge_importers.with_mut(xs => xs.drain(i .. (i + usize(1))));
      g_import_edge_imports.with_mut(xs => xs.drain(i .. (i + usize(1))));
    });
  });
});
/// Reset the cache. Call between independent `check` runs so module
/// values from a previous file don't leak into the next.
clear_module_cache :: (fn() -> unit)({
  g_module_cache_keys.with_mut(xs => xs.clear());
  g_module_cache_vals.with_mut(xs => xs.clear());
  g_module_cache_types.with_mut(xs => xs.clear());
  g_loading_keys.with_mut(xs => xs.clear());
  g_loading_envs.with_mut(xs => xs.clear());
  g_import_edge_importers.with_mut(xs => xs.clear());
  g_import_edge_imports.with_mut(xs => xs.clear());
  set_registration_owner(String.new());
  ()
});
/// Find the cache index for `path`, or `.None`.
_module_cache_index :: (fn(path : &String) -> Option(usize))({
  (idx : Option(usize)) = Option(usize).None;
  (i : usize) = usize(0);
  n := g_module_cache_keys.with(xs => xs.len());
  while((i < n) && idx.is_none(), {
    match(
      g_module_cache_keys.with(xs => xs.get(i)),
      .Some(k) => if(k == path, {
        idx = Option(usize).Some(i);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  idx
});
/// True iff a module value has already been registered for `path`.
module_cache_has :: (fn(path : &String) -> bool)(
  _module_cache_index(path).is_some()
);
/// Register the evaluated `module_value` for `path`. First registration
/// wins; callers guard with `module_cache_has` so this is a no-op on
/// re-registration (a duplicate push would still be harmless because
/// `_module_cache_index` returns the first match).
{ eprintln } :: import("std/fmt");
{ debug_knob } :: import("../utils.yo");
register_module :: (fn(path : &String, module_value : &EvalValue, module_type : &TypeValue) -> unit)({
  if(debug_knob(`YO_DEBUG_WARM`).is_some(), {
    eprintln(`[warmcache] register ${path.clone()}`);
  });
  if(!module_cache_has(path.clone()), {
    g_module_cache_keys.with_mut(xs => xs.push(path));
    g_module_cache_vals.with_mut(xs => xs.push(module_value));
    g_module_cache_types.with_mut(xs => xs.push(module_type));
  });
});
/// Pure lookup used as `ctx.load_module`. On a hit, returns the cached
/// module value; on a miss, returns a `LoadModuleResult` carrying an
/// error message so `evaluate_import` can surface it.
load_module_from_cache :: (fn(path : &String) -> LoadModuleResult)(
  match(
    _module_cache_index(path.clone()),
    .Some(i) => LoadModuleResult(
      module_value : match(
        g_module_cache_vals.with(xs => xs.get(i)),
        .Some(v) => v,
        .None => EvalValue.UnitVal
      ),
      module_type : match(
        g_module_cache_types.with(xs => xs.get(i)),
        .Some(t) => t,
        .None => rc(TypeValueNode.Unit)
      ),
      module_error : Option(String).None
    ),
    .None => LoadModuleResult(
      module_value : EvalValue.UnitVal,
      module_type : rc(TypeValueNode.Unit),
      module_error : Option(String).Some(`module not preloaded: ${path}`)
    )
  )
);
/// The module struct type `mt` with field `name`'s type replaced by `ty`,
/// rebuilt; `.None` when `mt` is not a struct or has no such field.
_module_type_with_field :: (fn(mt : &TypeValue, name : &String, ty : &TypeValue) -> Option(TypeValue))(
  match(
    mt,
    Rc(.Struct(sid, sname, tlabels, ttypes, sref, satomic, snt, scfid, stas, ssns)) => {
      new_types := ArrayList(TypeValue).new();
      (found : bool) = false;
      (ti : usize) = usize(0);
      while(ti < ttypes.len(), {
        ft := match(ttypes.get(ti), .Some(t) => t, .None => rc(TypeValueNode.Unit));
        if(match(tlabels.get(ti), .Some(t) => (t == name), .None => false), {
          new_types.push(ty);
          found = true;
        }, {
          new_types.push(ft);
        });
        ti = (ti + usize(1));
      });
      cond(
        found => Option(TypeValue).Some(
          rc(
            TypeValueNode.Struct(
              id : sid,
              name : sname,
              field_labels : tlabels,
              field_types : shared_list(new_types),
              is_reference_semantics : sref,
              is_atomic_rc : satomic,
              is_newtype : snt,
              constructor_func_id : scfid,
              type_arguments : stas,
              is_source_namespace : ssns
            )
          )
        ),
        true => Option(TypeValue).None
      )
    },
    _ => Option(TypeValue).None
  )
);
/// Phase 3b (plans/reference/INCREMENTAL_COMPILATION_ZIG_LESSONS.md §6 step 4): patch
/// ONE exported slot of a cached module in place after its definition was
/// re-evaluated per-def. Importers that hold the whole module value share the
/// StructVal's arrays, so the value update reaches every live consumer without
/// dropping anyone's cache entry (the file-level drop is what this exists to
/// beat). The paired field TYPE is not patched: the cache slot gets a rebuilt
/// module type (`_module_type_with_field`), because a `TypeValue` is a value
/// (plans/VALUES_BY_DEFAULT.md V4). Every load after the patch reads the
/// rebuilt type; an importer that read the module type before it keeps the
/// field type it read, while the value slot it shares is current. `.None`: module not cached.
/// `.Some(false)`: `name` has no slot — either the definition is not exported
/// (fine, nothing to patch) or it is exported under a DIFFERENT label
/// (`export(Foo : bar)`), which the caller must treat as unpatchable and fall
/// back to file-level invalidation.
update_module_cache_slot :: (fn(path : &String, name : &String, var : &Variable) -> Option(bool))(
  match(
    _module_cache_index(path.clone()),
    .None => Option(bool).None,
    .Some(i) => {
      (patched : bool) = false;
      match(
        g_module_cache_vals.with(xs => xs.get(i)),
        .Some(mv) =>
          match(
            mv,
            .StructVal(_, names, vals) => {
              // A binding below the value's cell is a read-only copy; the
              // write goes through an owned handle to the same list.
              slots := vals;
              (ni : usize) = usize(0);
              while(ni < names.len(), {
                match(
                  names.get(ni),
                  .Some(n) => if(n == name, {
                    slots(ni) = match(
                      var.value.get(usize(0)),
                      .Some(v) => v,
                      .None => EvalValue.UnitVal
                    );
                    patched = true;
                  }),
                  .None => ()
                );
                ni = (ni + usize(1));
              });
            },
            _ => ()
          ),
        .None => ()
      );
      // The sns struct TYPE's paired field type. A type is never patched in
      // place (plans/VALUES_BY_DEFAULT.md V4: `TypeValue` is a value, and
      // other holders of the old type keep what they read): the slot gets a
      // rebuilt module type, and every later load reads that one.
      if(patched, {
        match(
          g_module_cache_types.with(xs => xs.get(i)),
          .Some(mt) => match(
            _module_type_with_field(&mt, name, &var.ty),
            .Some(rebuilt) => {
              g_module_cache_types.with_mut(xs => {
                xs(i) = rebuilt;
              });
            },
            .None => ()
          ),
          .None => ()
        );
      });
      Option(bool).Some(patched)
    }
  )
);
/// Drop one module's cache entry (no-op when absent). Its dependencies
/// stay cached; its own outgoing import edges are dropped so the
/// re-evaluation records them fresh.
remove_module :: (fn(path : &String) -> unit)({
  match(
    _module_cache_index(path.clone()),
    .Some(i) => {
      g_module_cache_keys.with_mut(xs => xs.drain(i .. (i + usize(1))));
      g_module_cache_vals.with_mut(xs => xs.drain(i .. (i + usize(1))));
      g_module_cache_types.with_mut(xs => xs.drain(i .. (i + usize(1))));
    },
    .None => ()
  );
  _drop_edges_from(path);
});
/// Invalidate `path`: remove it AND every transitive DEPENDENT (reverse
/// edge closure) from the cache, so no cached module keeps exports built
/// against the old version. Dependencies of the removed set stay cached —
/// they are unchanged. Returns the removed abs paths (the Phase B2 registry
/// purge consumes this). plans/reference/INCREMENTAL_COMPILATION.md Phase B1.
invalidate_module :: (fn(path : &String) -> ArrayList(String))({
  removed := ArrayList(String).new();
  worklist := ArrayList(String).new();
  worklist.push(path);
  while(worklist.len() > usize(0), {
    p := match(
      worklist.pop(),
      .Some(x) => x,
      .None => {
        return(removed);
      }
    );
    (already : bool) = false;
    (ri : usize) = usize(0);
    while(ri < removed.len(), {
      match(
        removed.get(ri),
        .Some(r) => if(r == p, {
          already = true;
        }),
        .None => ()
      );
      ri = (ri + usize(1));
    });
    if(!already, {
      removed.push(p.clone());
      // Collect p's dependents BEFORE remove_module drops p's own edges
      // (dependents are INCOMING edges — unaffected — but keep the order
      // obvious anyway).
      (ei : usize) = usize(0);
      while(ei < g_import_edge_imports.with(xs => xs.len()), {
        hits := match(g_import_edge_imports.with(xs => xs.get(ei)), .Some(t) => (t == p), .None => false);
        if(hits, {
          match(
            g_import_edge_importers.with(xs => xs.get(ei)),
            .Some(dep) => {
              worklist.push(dep);
            },
            .None => ()
          );
        });
        ei = (ei + usize(1));
      });
      remove_module(&p);
    });
  });
  removed
});
export(
  clear_module_cache,
  module_cache_has,
  register_module,
  load_module_from_cache,
  register_loading,
  unregister_loading,
  loading_env,
  current_loading_module,
  record_import_edge,
  loading_key_for_module,
  mark_owner_always_visible,
  remove_module,
  invalidate_module,
  update_module_cache_slot
);
