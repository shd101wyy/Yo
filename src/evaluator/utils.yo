//! evaluator/utils — shared helpers used by multiple evaluator handlers.
//!
//! The env-aware helpers in this file structurally belong in `expr.yo`,
//! `env.yo` and `value.yo`, but the eager destructuring of `import("…")`
//! would turn `expr.yo` ↔ `env.yo` ↔ `value.yo` into a hard import cycle, so
//! they are consolidated in this one module instead.
//!
//! Phase A.4.1: top-level utilities (`generate_new_temp_variable_name`,
//! `is_temp_variable_name`, `random_id`, `generate_temp_variable_name_prefix`)
//! were relocated to `src/utils.yo` — that split was safe because those
//! helpers have no env/value dependencies.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ HashMap } :: import("std/collections/hash_map");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_atom,
  ast_expr_is_fn_call_of,
  ast_expr_to_string,
  make_err_expr,
  BF_DUP,
  BF_DROP,
  BF_DOT,
  BK_BEGIN,
  BK_COND,
  BK_MATCH,
  BK_COLON,
  BK_ASSIGN,
  BK_INIT_ASSIGN,
  ast_expr_is_local_borrow_mode_call,
  ast_expr_strip_borrow_marker
} :: import("../expr.yo");
{
  ExprInfo,
  ExprInfoTable,
  expr_info_table_get,
  expr_info_origin_type,
  expr_info_set_origin_type,
  arm_init_range_in,
  get_branch_init_record,
  sibling_first_flow_records,
  record_branch_consume,
  first_flow_records_in,
  first_flow_record_in,
  last_flow_record_in,
  record_flow_event,
  FlowEventKind,
  branch_init_log_len,
  new_expr_info,
  expr_info_adopt_env,
  expr_info_capture_type,
  expr_info_set_deferred_dup_expressions
} :: import("../expr_info.yo");
{
  Environment,
  Variable,
  value_cell_of,
  Frame,
  new_frame,
  get_variables_from_env,
  env_candidate_names,
  find_variable_in_env,
  make_err_variable,
  generate_variable_id,
  add_variable_to_begin_block_frame,
  find_live_inout_borrowers,
  snapshot_env,
  UndoneMove,
  variable_record_undone_move,
  is_fn_capture_value_binding,
  is_fnonce_capture_frame,
  is_closure_param_frame,
  variable_note_arm_move,
  variable_move_note
} :: import("../env.yo");
{ Token, TokenKind } :: import("../token.yo");
{ EvalContext, LoopBodyCtx, LoopFlowSnapshot, FuncOrAsyncBlockKind, copy_trait_blockers_via_hook } :: import("./context.yo");
{ atof } :: import("std/libc/stdlib");
{
  format_error_message,
  format_error_message_with_help,
  format_error_messages,
  format_error_messages_with_help,
  TokenAndError,
  YoError,
  with_code
} :: import("../error.yo");
{ raise_flow_violation } :: import("../types/flowability.yo");
{ suggest_name, E_USE_OF_MOVED_VALUE, E_MOVED_ON_SOME_PATHS, E_BORROW_ESCAPES, E_BORROW_CONFLICT, E_WRITE_THROUGH_BORROW, E_LOCAL_BORROW_CONFLICT, E_LOCAL_BORROW_ESCAPES, E_CLOSURE_MOVES_CAPTURE } :: import("../diagnostics.yo");
{ Exception } :: import("std/error");
{ generate_new_temp_variable_name, is_temp_variable_name, is_any_temp_variable_name, debug_knob, display_module_path, canonical_module_path }
:: import("../utils.yo");
