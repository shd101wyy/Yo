// `set_expr_as_needs_to_call_dup` builds + evaluates a `___dup(name)` call.
// `parser.yo` is upstream (no cycle); `exprs/expr.yo` is the cycle-free
// late-binding dispatcher (it imports neither utils.yo nor any handler).
{ generate_expr_from_code } :: import("../parser.yo");
{ evaluate_expression_raw } :: import("./exprs/expr.yo");
{ panic, assert } :: import("std/assert");
/// Live capture-list freezes by borrowed root id (`note_second_class_binding`).
(g_capture_freezes : HashMap(usize, ArrayList(_CaptureFreeze))) = HashMap(usize, ArrayList(_CaptureFreeze)).new();

// Local-borrow state (see "Local borrows" below): runtime bindings, so they
// precede every function that reads them.
/// The local borrows in scope, innermost last. A begin block truncates the
/// list to its entry length when it ends (`evaluate_begin_expression`), so a
/// borrow is listed exactly while its block evaluates; `comptime_expect_error`
/// restores the length a thrown-through body left.
(g_local_borrows : ArrayList(LocalBorrowInfo)) = ArrayList(LocalBorrowInfo).new();
(g_local_borrow_patterns : ArrayList(LocalBorrowPatternBinding)) = ArrayList(LocalBorrowPatternBinding).new();
/// The receiver node a `.` access is about to evaluate as part of a place
/// chain: its own evaluator reports no access (the chain's outermost node
/// reports the whole place).
(g_lb_receiver_id : usize) = usize(0);
(g_lb_receiver_armed : bool) = false;
/// The block statements after a borrow binding, for its live range: set by
/// `evaluate_begin_expression` just before it evaluates the binding.
(g_lb_lookahead_stmts : ArrayList(AstExpr)) = ArrayList(AstExpr).new();
(g_lb_lookahead_index : usize) = usize(0);
(g_lb_lookahead_id : usize) = usize(0);
(g_lb_lookahead_armed : bool) = false;
// Phase A.4.1: `generate_temp_variable_name_prefix`,
// `generate_new_temp_variable_name`, `is_temp_variable_name`, and `random_id`
// were relocated to `src/utils.yo`.
// ---------------------------------------------------------------------------
// attach_temp_variable_to_expr
// ---------------------------------------------------------------------------
/// The scrutinee tokens of the consuming `match`es (see
/// `note_consuming_match_scrutinee`).
(g_consuming_match_scrutinees : HashSet(String)) = HashSet(String).new();
/// Attach a generated temp variable to `expr`'s ExprInfo for RC drop-tracking.
///
/// Steps:
///  1. Look up ExprInfo from `ctx.expr_info_table` by `ast_expr_id(expr)`.
///  2. Choose effective type: use `capture_type` when present and RC-containing
///     and `is_owning_the_rc_value` is true (closure capture struct semantics).
///  3. Determine `_is_owning_rc := is_owning_the_rc_value && type_contains_rc_type(ty)`.
///  4. If `ExprInfo.variable_name` already set: update the existing variable.
///  5. Otherwise: generate a fresh temp name, add to nearest begin-block frame,
///     store name + updated env back in the ExprInfo table.
attach_temp_variable_to_expr :: (
  fn(
    imm(expr) : AstExpr,
    is_owning_the_rc_value : bool,
    imm(ctx) : EvalContext
  ) -> unit
)({
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(expr));
  match(
    info_opt,
    .None => (),
    .Some(info) => {
      // A `never` expression has no value to hold (Phase 3.6): a temp would
      // be declared `void` in C.
      if(is_never_type(info.ty), {
        return(());
      });
      // Choose effective type: capture_type for closures with RC captures.
      effective_ty := match(
        expr_info_capture_type(info),
        .Some(cap_ty) => cond(
          (type_contains_rc_type(cap_ty) && is_owning_the_rc_value) => cap_ty,
          true => info.ty
        ),
        .None => info.ty
      );
      // Only mark as owning if the effective type actually contains RC.
      _is_owning_rc := (is_owning_the_rc_value && type_contains_rc_type(effective_ty));
      // A value whose owner is tracked only because decision 36's flip makes
      // it explicit-copy (plain data, no cell) keeps its compile-time value:
      // only a value holding a cell is runtime-only.
      _holds_cell := (_is_owning_rc && type_contains_rc_cell_or_move_only(effective_ty));
      // Compute compile-time-only flag and value: owning RC vars are always runtime.
      // Runtime results are `Some(UnknownVal)` (NOT "no value"), so
      // "has an inlinable value" must read UnknownVal as NO value, or a
      // non-owning runtime temp (e.g. the index-trait element)
      // gets marked compile-time-only and codegen never declares it.
      has_inlinable_value := match(
        info.value,
        .Some(iv) => !is_unknown_val(iv),
        .None => false
      );
      is_ctonly := cond(_holds_cell => false, true => has_inlinable_value);
      var_value := cond(_holds_cell => Option(EvalValue).None, true => info.value);
      expr_tok := ast_expr_token(expr);
      match(
        info.variable_name,
        .Some(existing_name) => {
          // Update the existing variable (if found in env).
          existing_vars := get_variables_from_env(info.env, existing_name);
          if(existing_vars.len() > usize(0), {
            existing_var := match(existing_vars.last(), .Some(v) => v, .None => make_err_variable(info.env));
            // Preserve borrowing: if variable was not owning, keep it not-owning.
            preserved_rc := cond(
              !existing_var.is_owning_the_rc_value => false,
              true => _is_owning_rc
            );
            existing_var.ty = effective_ty;
            existing_var.value = value_cell_of(cond(preserved_rc => Option(EvalValue).None, true => var_value));
            existing_var.is_compile_time_only = cond(preserved_rc => false, true => is_ctonly);
            existing_var.is_owning_the_rc_value = preserved_rc;
            // Update origin_type if not already set.
            match(
              expr_info_origin_type(info),
              .None => {
                expr_info_set_origin_type(info, Option(TypeValue).Some(effective_ty));
              },
              .Some(_) => ()
            );
          }, {
            // Variable name exists but not in env: add it to begin-block frame.
            add_variable_to_begin_block_frame(
              info.env,
              existing_name,
              effective_ty,
              var_value,
              is_ctonly,
              _is_owning_rc,
              expr_tok
            );
            match(
              expr_info_origin_type(info),
              .None => {
                expr_info_set_origin_type(info, Option(TypeValue).Some(effective_ty));
              },
              .Some(_) => ()
            );
            expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
          });
        },
        .None => {
          // Create a new temp variable. Phase 2: occurrence-keyed by this
          // binding's source position, not the global mint order.
          temp_tok := ast_expr_token(expr);
          temp_name := generate_new_temp_variable_name(
            info.env.module_path,
            usize(temp_tok.row),
            usize(temp_tok.column),
            .None,
            .Some(temp_tok.module_path)
          );
          add_variable_to_begin_block_frame(
            info.env,
            temp_name,
            effective_ty,
            var_value,
            is_ctonly,
            _is_owning_rc,
            expr_tok
          );
          info.variable_name = Option(String).Some(temp_name);
          match(
            expr_info_origin_type(info),
            .None => {
              expr_info_set_origin_type(info, Option(TypeValue).Some(effective_ty));
            },
            .Some(_) => ()
          );
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
        }
      );
    }
  );
});
// ---------------------------------------------------------------------------
// is_valid_variable_name
// ---------------------------------------------------------------------------
/// True iff `expr` has a valid binding-LHS shape for `name := rhs`
/// — either an `Identifier` atom or any expression whose token is an
/// `Operator` (e.g. infix `+` defined as a function).
///
/// Note: the atom branch requires an `Identifier` token, while the operator
/// branch applies to both Atom and FnCall shapes.
is_valid_variable_name :: (fn(imm(expr) : AstExpr) -> bool)({
  tok := ast_expr_token(expr);
  (ast_expr_is_atom(expr) && (tok.kind == TokenKind.Identifier)) ||
    (tok.kind == TokenKind.Operator)
  });
// ---------------------------------------------------------------------------
// find_rc_value_owner_relationship
// ---------------------------------------------------------------------------
/// Follow the `is_owning_the_same_rc_value_as` chain to find the root owning
/// variable for the value named in `rhs`'s ExprInfo.
///
/// Returns `.None` if no owner is found or if the chain cycles.
find_rc_value_owner_relationship :: (
  fn(
    imm(rhs) : AstExpr,
    imm(env) : Environment,
    imm(ctx) : EvalContext
  ) -> Option(Variable)
)({
  name_opt := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs)),
    .Some(info) => info.variable_name,
    .None => Option(String).None
  );
  match(
    name_opt,
    .None => Option(Variable).None,
    .Some(var_name) => {
      vars := get_variables_from_env(env, var_name);
      if(vars.len() == usize(0), {
        return(Option(Variable).None);
      });
      (candidate_opt : Option(Variable)) = Option(Variable).Some(
        match(vars.last(), .Some(v) => v, .None => make_err_variable(env))
      );
      visited := HashSet(usize).new();
      // Follow the chain until we find an owning variable or it breaks.
      while(match(
        candidate_opt,
        .Some(c) => c.is_owning_the_same_rc_value_as.is_some(),
        .None => false
      ), {
        match(
          candidate_opt,
          .Some(cand) => {
            if(visited.contains(cand.id), {
              candidate_opt = Option(Variable).None;
              return(candidate_opt);
            });
            visited.insert(cand.id);
            candidate_opt = match(
              cand.is_owning_the_same_rc_value_as,
              .Some(next_box) => Option(Variable).Some(next_box.*),
              .None => Option(Variable).None
            );
          },
          .None => ()
        );
      });
      match(
        candidate_opt,
        .Some(c) => if(
          c.is_owning_the_rc_value,
          Option(Variable).Some(c),
          Option(Variable).None
        ),
        .None => Option(Variable).None
      )
    }
  )
});
// ---------------------------------------------------------------------------
// throw_expr_is_implicit_variable_error
// ---------------------------------------------------------------------------
/// Throw if `rhs` resolves to an implicit (`given(...)`) variable.
///
/// Implicit variables must be passed via `` parameters, not captured
/// through regular assignments.
///
///
throw_expr_is_implicit_variable_error :: (
  fn(
    imm(rhs) : AstExpr,
    imm(env) : Environment,
    imm(ctx) : EvalContext,
    imm(exn) : Exception
  ) -> unit
)({
  // Determine which variable name to check.
  rhs_info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs));
  (var_name_opt : Option(String)) = Option(String).None;
  // Check path_collection first (property-access chains).
  match(
    rhs_info_opt,
    .Some(rhs_info) => {
      n := rhs_info.path_collection.len();
      (i : usize) = usize(0);
      while(i < n, {
        path := match(rhs_info.path_collection.get(i), .Some(p) => p, .None => ArrayList(String).new());
        if(path.len() > usize(0), {
          match(
            path.get(usize(0)),
            .Some(first) => {
              var_name_opt = Option(String).Some(first);
            },
            .None => ()
          );
        });
        i = (i + usize(1));
      });
    },
    .None => ()
  );
  // Fall back to the atom token if no path_collection entry was found.
  if(var_name_opt.is_none(), {
    if(ast_expr_is_atom(rhs), {
      var_name_opt = Option(String).Some(ast_expr_token(rhs).value.clone());
    });
  });
  match(
    var_name_opt,
    .None => (),
    .Some(var_name) => {
      match(
        find_variable_in_env(env, var_name),
        .None => (),
        .Some(rv) => {
          if(rv.is_implicit, {
            exn.throw(
              dyn(
                format_error_message(
                  ast_expr_token(rhs),
                  `Cannot use implicit variable "${var_name}" in assignment. Implicit variables must be passed via  parameters.`
                )
              )
            );
          });
        }
      );
    }
  );
});
// ---------------------------------------------------------------------------
// require_expr_not_consumed
// ---------------------------------------------------------------------------
/// Throw if the variable named by `rhs`'s ExprInfo has already been consumed
/// (moved).
///
///
require_expr_not_consumed :: (
  fn(
    imm(rhs) : AstExpr,
    imm(env) : Environment,
    imm(ctx) : EvalContext,
    imm(exn) : Exception
  ) -> unit
)({
  name_opt := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs)),
    .Some(info) => info.variable_name,
    .None => Option(String).None
  );
  match(
    name_opt,
    .None => (),
    .Some(var_name) => {
      vars := get_variables_from_env(env, var_name);
      if(vars.len() == usize(0), {
        entries := ArrayList(TokenAndError).new();
        entries.push(
          TokenAndError(
            token : ast_expr_token(rhs),
            error_message : `Variable "${var_name}" is not defined.`
          )
        );
        hint := match(
          suggest_name(var_name, env_candidate_names(env)),
          .Some(h) => Option(String).Some(`did you mean "${h}"?`),
          .None => Option(String).None
        );
        exn.throw(dyn(format_error_messages_with_help(entries, hint)));
      });
      v := match(vars.last(), .Some(v) => v, .None => make_err_variable(env));
      match(
        v.consumed_at_token,
        .None => (),
        .Some(consumed_tok) => {
          // RE-EVALUATION exemption: when the recorded move site IS this very
          // token, the "move" came from an earlier evaluation of the SAME
          // expression node (a call node is re-evaluated when it becomes
          // the receiver/argument of an enclosing call). A genuine
          // use-after-move always has a
          // DIFFERENT move site. Without this, `v1_copy.concat(v2).len()`
          // reported 'use of moved value' with BOTH carets on the same
          // token (tests/imm_vec arms 14/17, surfaced by the Step-4a port).
          same_site := (
            (consumed_tok.*.row == ast_expr_token(rhs).row)
            && (consumed_tok.*.column == ast_expr_token(rhs).column)
            && (consumed_tok.*.module_path == ast_expr_token(rhs).module_path)
          );
          if(same_site || migrate_borrowed_match_at(consumed_tok.*), {
            return(());
          });
          exn.throw(dyn(use_of_moved_value_error(var_name, v.ty, ast_expr_token(rhs), variable_move_note(v, consumed_tok.*))));
        }
      );
    }
  );
});
// ---------------------------------------------------------------------------
// expect_expr_to_have_been_evaluated
// ---------------------------------------------------------------------------
/// Unreachable placeholder for `expect_expr_to_have_been_evaluated`'s
/// `.None` branch. `exn.throw` unwinds before this is hit; the call
/// only exists so the match arms unify to `ExprInfo`.
new_expr_info_placeholder_for_unreachable_ :: (fn(imm(_expr) : AstExpr) -> ExprInfo)(
  __yo_panic("unreachable: expect_expr_to_have_been_evaluated placeholder")
);
/// Throw if `expr` has no `ExprInfo` attached — i.e. the evaluator
/// has not yet processed this expression. Returns the `ExprInfo` on
/// success. Takes a custom `error_message` (empty string ⇒ use the
/// default) and reads the ExprInfo from `ctx.expr_info_table`.
expect_expr_to_have_been_evaluated :: (
  fn(
    imm(expr) : AstExpr,
    imm(error_message) : String,
    imm(ctx) : EvalContext,
    imm(exn) : Exception
  ) -> ExprInfo
)(
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(expr)),
    .Some(info) => info,
    .None => {
      entries := ArrayList(TokenAndError).new();
      msg := cond(
        (error_message.len() > usize(0)) => error_message,
        true => `Expected expression to have been evaluated, but it has not been evaluated yet:\n${ast_expr_to_string(expr)}`
      );
      entries.push(
        TokenAndError(token : ast_expr_token(expr), error_message : msg)
      );
      exn.throw(dyn(format_error_messages(entries)));
      // Unreachable. Provide a placeholder so the type checker is
      // satisfied.
      new_expr_info_placeholder_for_unreachable_(expr)
    }
  )
);
// ---------------------------------------------------------------------------
// Move-only values (plans/VALUES_BY_DEFAULT.md §3.4, V3)
// ---------------------------------------------------------------------------
/// The type a `derive(T, Copy, Clone)` suggestion names: the type's own
/// spelling without its arguments (`Pair(i32)` → `Pair`), which is what the
/// user's declaration is called.
_copy_derive_target :: (fn(imm(ty) : TypeValue) -> String)({
  shown := type_to_string(ty);
  match(shown.index_of(`(`), .Some(p) => shown.substring(usize(0), p), .None => shown)
});
/// The E0901 note for a value named `name` of a type that is not implicitly
/// copyable (`type_requires_explicit_copy`): for a move-only type, why it is
/// move-only and the ways to use it without a copy; for an explicit-copy type,
/// the `.clone()` that copies it. `.None` for an implicitly copyable type.
move_only_help :: (fn(imm(name) : String, imm(ty) : TypeValue) -> Option(String))(
  match(
    move_only_reason(ty),
    .Some(why) => Option(String).Some(
      `\`${name}\` is move-only (${why}): move it (\`sink(${name})\`), lend it \`mut\`, or share it through a reference type (\`Rc\`, \`Arc\`, a \`ref(struct(...))\`). An \`imm\` parameter borrows it without a copy (the call lends it with \`&${name}\`).`
    ),
    .None => cond(
      (type_requires_explicit_copy(ty) && !type_contains_rc_cell_or_move_only(ty) && type_lacks_clone(ty)) => Option(String).Some(
        `\`${name}\` has type \`${type_to_string(ty)}\`, which is neither \`Copy\` nor \`Clone\`, so it is move-only (plans/VALUES_BY_DEFAULT.md decision 36): give the type \`derive(${_copy_derive_target(ty)}, Copy, Clone)\` to copy it implicitly, or move it (\`sink(${name})\`).`
      ),
      (type_requires_explicit_copy(ty) && !type_contains_rc_cell_or_move_only(ty)) => Option(String).Some(
        `\`${name}\` has type \`${type_to_string(ty)}\`, which is not \`Copy\` (plans/VALUES_BY_DEFAULT.md decision 36): give the type \`derive(${_copy_derive_target(ty)}, Copy, Clone)\` to copy it implicitly, write \`${name}.clone()\` for a copy, or move it (\`sink(${name})\`).`
      ),
      type_requires_explicit_copy(ty) => Option(String).Some(
        `\`${name}\` is copied explicitly: write \`${name}.clone()\` for a copy, move it (\`sink(${name})\`), or lend it \`mut\`. An \`imm\` parameter borrows it without a copy (the call lends it with \`&${name}\`).`
      ),
      true => Option(String).None
    )
  )
);
/// The E0901 note for a value that has no name of its own (a field, an
/// element, a dereference) and is not implicitly copyable: why its type is
/// move-only, or the `.clone()` that copies an explicit-copy value.
move_only_type_help :: (fn(imm(ty) : TypeValue) -> Option(String))(
  match(
    move_only_reason(ty),
    .Some(why) => Option(String).Some(
      `\`${type_to_string(ty)}\` is move-only (${why}): a value of it is moved, never copied. Lend it to an \`imm\` or \`mut\` parameter, move its whole owner, or share it through a reference type (\`Rc\`, \`Arc\`, a \`ref(struct(...))\`).`
    ),
    .None => cond(
      (type_requires_explicit_copy(ty) && !type_contains_rc_cell_or_move_only(ty) && type_lacks_clone(ty)) => Option(String).Some(
        `\`${type_to_string(ty)}\` is neither \`Copy\` nor \`Clone\`, so it is move-only (plans/VALUES_BY_DEFAULT.md decision 36): give it \`derive(${_copy_derive_target(ty)}, Copy, Clone)\` to copy it implicitly, or move its whole owner.`
      ),
      (type_requires_explicit_copy(ty) && !type_contains_rc_cell_or_move_only(ty)) => Option(String).Some(
        `\`${type_to_string(ty)}\` is not \`Copy\` (plans/VALUES_BY_DEFAULT.md decision 36): give it \`derive(${_copy_derive_target(ty)}, Copy, Clone)\` to copy it implicitly, call \`.clone()\` on it for a copy, or move its whole owner.`
      ),
      type_requires_explicit_copy(ty) => Option(String).Some(
        `\`${type_to_string(ty)}\` is copied explicitly: call \`.clone()\` on it for a copy, lend it to a by-value parameter, or move its whole owner.`
      ),
      true => Option(String).None
    )
  )
);
/// The scrutinee tokens of the consuming `match`es (decision 26), so that a
/// use after one names `match(&x, …)`. Keyed by token position.
_consuming_match_key :: (fn(imm(tok) : Token) -> String)(`${tok.module_path}:${tok.byte_offset}`);
note_consuming_match_scrutinee :: (fn(imm(tok) : Token) -> unit)({
  g_consuming_match_scrutinees.insert(_consuming_match_key(tok));
});
consuming_match_scrutinee_at :: (fn(imm(tok) : Token) -> bool)(
  (g_consuming_match_scrutinees.len() > usize(0)) && g_consuming_match_scrutinees.contains(_consuming_match_key(tok))
);
/// A use of moved value `name` at `use_tok` (moved at `moved_tok`), as E0901,
/// with the move-only note when `ty` is move-only.
use_of_moved_value_error :: (fn(imm(name) : String, imm(ty) : TypeValue, imm(use_tok) : Token, imm(moved_tok) : Token) -> YoError)({
  entries := ArrayList(TokenAndError).new();
  entries.push(TokenAndError(token : use_tok, error_message : `use of moved value: \`${name}\``));
  by_match := consuming_match_scrutinee_at(moved_tok);
  entries.push(
    TokenAndError(
      token : moved_tok,
      error_message : cond(by_match => String.from("value moved here: a `match` takes its scrutinee by value"), true => String.from("value moved here"))
    )
  );
  with_code(format_error_messages_with_help(entries, moved_value_help(name, ty, moved_tok)), E_USE_OF_MOVED_VALUE)
});
/// The E0901 note for a use of `name` after a move at `moved_tok`: a
/// consuming `match` names the borrow that keeps the value, any other move
/// the type's note (`move_only_help`).
moved_value_help :: (fn(imm(name) : String, imm(ty) : TypeValue, imm(moved_tok) : Token) -> Option(String))(
  cond(
    consuming_match_scrutinee_at(moved_tok) => Option(String).Some(
      `a \`match\` consumes an owned scrutinee (plans/VALUES_BY_DEFAULT.md decision 26): match through a borrow to keep using \`${name}\`, \`match(&${name}, …)\`, or \`match(&mut ${name}, …)\` to write through the bindings`
    ),
    true => move_only_help(name, ty)
  )
);
/// `yo fix --migrate match-scrutinee`: a use after the consuming `match`
/// whose scrutinee is `moved_tok` records `&` before that scrutinee instead
/// of being rejected (true when recorded).
migrate_borrowed_match_at :: (fn(imm(moved_tok) : Token) -> bool)(
  cond(
    (migrate_match_scrutinee_on() && consuming_match_scrutinee_at(moved_tok)) => {
      record_migrate_edit(moved_tok, moved_tok.value.len(), `&${moved_tok.value}`, moved_tok.value.clone());
      true
    },
    true => false
  )
);
/// A short rendering of the place `e` names, for a message: a field chain
/// reads as written (`sh.origin.y`, not the general printer's
/// `(sh.origin).y` — its parenthesized dot call leaves one pair behind), a
/// borrow marker is dropped (`&mut x` names `x`), and other expressions keep
/// the source rendering without the one pair of parentheses the printer
/// wraps a call in.
_place_text :: (fn(imm(e) : AstExpr) -> String)({
  (s : AstExpr) = ast_expr_strip_borrow_marker(e);
  cond(
    ast_expr_is_fn_call_of(s, BF_DOT, Option(usize).Some(usize(2))) => match(
      s,
      .FnCall(_, _, dot_args, _, _) => match(
        dot_args.get(usize(0)),
        .Some(recv) => `${_place_text(recv)}.${_place_text(match(dot_args.get(usize(1)), .Some(f) => f, .None => make_err_expr()))}`,
        .None => _place_text_of_other(s)
      ),
      .Atom(_, _) => _place_text_of_other(s)
    ),
    true => _place_text_of_other(s)
  )
});
_place_text_of_other :: (fn(imm(e) : AstExpr) -> String)({
  t := ast_expr_to_string(e);
  if(!(t.starts_with("(") && t.ends_with(")")), {
    return(t);
  });
  // Strip only a pair that encloses the whole text (`(a)(b)` keeps its own).
  (depth : i32) = i32(0);
  (i : usize) = usize(0);
  while(i < (t.len() - usize(1)), {
    b := match(t.get_byte(i), .Some(x) => x, .None => u8(0));
    if(b == u8(40), {
      depth = (depth + i32(1));
    });
    if(b == u8(41), {
      depth = (depth - i32(1));
    });
    if(depth == i32(0), {
      return(t);
    });
    i = (i + usize(1));
  });
  t.substring(usize(1), t.len() - usize(1))
});
/// Move the user-named local `v` at `tok` outside an expression that names it
/// (a closure capture): the flow-logged consumption `set_expr_as_consumed`
/// makes. The owner of a value that is not implicitly copyable gives it up
/// here; a second move or a later read is E0901, a borrowed binding cannot
/// give it up (E0901 too).
/// The innermost OWNING parameter binding named `name` in `env`, if one is
/// visible. A specialized function's CLOSURE parameter is re-bound as a
/// non-owning callable shadow (calls/helper.yo's re-bind loop — an owning
/// re-bind was measured as a second, double release), so the owning
/// `own(cb)` binding the caller's transfer handed the reference to sits in
/// an OUTER frame of the same env. A capture that moves `cb` takes THAT
/// binding's reference; this finds it.
_owning_param_binding_for_capture_move :: (fn(imm(env) : Environment, imm(name) : String) -> Option(Variable))({
  vars := get_variables_from_env(env, name.clone());
  (i : usize) = vars.len();
  while(i > usize(0), {
    i = (i - usize(1));
    match(
      vars.get(i),
      .Some(cv) => if(cv.is_parameter && cv.is_owning_the_rc_value && (!cv.is_ref && !cv.is_module_level) && cv.consumed_at_token.is_none(), {
        return(Option(Variable).Some(cv));
      }),
      .None => ()
    );
  });
  Option(Variable).None
});
/// Decision 37 (plans/VALUES_BY_DEFAULT.md): the call `f(...)` of a closure
/// typed `FnOnce(...)` takes it as `self`, so it CONSUMES the binding `v`
/// that names it: a later use, a second call included, is E0901 pointing at
/// this call. Inside a specialized body `v` is the non-owning shadow of a
/// `sink(f) : Impl(FnOnce(...))` parameter, and the call consumes the owning
/// binding the caller's transfer handed the closure to, as a capture's move
/// does (`move_captured_explicit_copy_variable`). Storage the call cannot
/// take the closure from is rejected: a borrowed parameter (a non-escaping
/// API cannot take `FnOnce`), an `inout` binding, a module-level binding, and
/// the by-value capture of a closure typed `Fn(...)` (E0913). A re-evaluation
/// of the same call site is not a second call.
consume_called_fnonce_closure :: (fn(imm(callee) : AstExpr, imm(v) : Variable, imm(env) : Environment, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  tok := ast_expr_token(callee);
  same_site := match(
    v.consumed_at_token,
    .Some(moved_at) => ((moved_at.*.row == tok.row) && ((moved_at.*.column == tok.column) && (moved_at.*.module_path == tok.module_path))),
    .None => false
  );
  if(same_site, {
    return(());
  });
  if(_is_implicit_closure_capture(v, env, ctx), {
    raise_flow_violation(
      with_code(
        format_error_message_with_help(
          tok,
          `Cannot call \`${v.name}\` here: it is captured implicitly by this closure, and an \`FnOnce(...)\` call consumes the closure it calls, so it would be gone after this closure's first call.`,
          Option(String).Some(`list it and type this closure \`FnOnce(...)\`: \`{ ${v.name} }(...) => ${v.name}()\``)
        ),
        E_CLOSURE_MOVES_CAPTURE
      ),
      ctx,
      exn
    );
    return(());
  });
  owner := if(!v.is_owning_the_rc_value && v.is_parameter && !v.is_ref, _owning_param_binding_beside(env, v), Option(Variable).None);
  // A closure whose captures hold nothing to release (plain data) is called
  // through any binding harmlessly; one holding an RC or move-only value
  // releases it in the call, so the binding must own the closure.
  holds_owned := (type_contains_rc_type(v.ty) || type_requires_explicit_copy(v.ty));
  what := cond(
    v.is_module_level => Option(String).Some(String.from("it is a module-level binding, which lives for the whole program and is never moved")),
    v.is_ref => Option(String).Some(String.from("it is a `mut` binding, which names storage the caller owns")),
    (v.is_parameter && !v.is_owning_the_rc_value && owner.is_none()) => Option(String).Some(String.from("it is a borrowed parameter, and a borrow cannot give the closure away: take the parameter by value, `sink(f) : Impl(FnOnce(...))` (only an API the closure escapes into calls it once)")),
    (!v.is_parameter && !v.is_owning_the_rc_value && holds_owned && !is_fn_capture_value_binding(v.id)) => Option(String).Some(String.from("it is borrowed from the value that holds it (a `match`/`for` binding): move the holder, or match a value you own")),
    true => Option(String).None
  );
  match(
    what,
    .Some(w) => raise_flow_violation(
      with_code(
        format_error_message_with_help(
          tok,
          `use of moved value: cannot call \`${v.name}\`: an \`FnOnce(...)\` call consumes the closure, and \`${v.name}\` cannot give it away: ${w}.`,
          Option(String).Some(String.from("call an `Fn(...)` closure through a borrow; an `FnOnce(...)` closure is called once, by its owner"))
        ),
        E_USE_OF_MOVED_VALUE
      ),
      ctx,
      exn
    ),
    .None => cond(
      is_fn_capture_value_binding(v.id) => raise_flow_violation(
        with_code(
          format_error_message_with_help(
            tok,
            `Cannot call \`${v.name}\` here: it is a by-value capture of a closure typed \`Fn(...)\`, whose call borrows its captures, and an \`FnOnce(...)\` call consumes the closure it calls.`,
            Option(String).Some(String.from("type the enclosing closure `FnOnce(...)`, so its body owns its captures"))
          ),
          E_CLOSURE_MOVES_CAPTURE
        ),
        ctx,
        exn
      ),
      owner.is_some() => {
        // Both moves are logged, so a `cond`/`match` join restores the
        // shadow for a sibling arm as it does the owner.
        o := match(owner, .Some(x) => x, .None => v);
        _log_user_move(o, tok, env);
        o.consumed_at_token = Option(Rc(Token)).Some(rc(tok.clone()));
        _log_user_move(v, tok, env);
        v.consumed_at_token = Option(Rc(Token)).Some(rc(tok.clone()));
      },
      true => set_expr_as_consumed(callee, env, false, ctx, exn)
    )
  );
});
/// The owning binding a specialized body's non-owning closure-parameter
/// shadow `v` stands for: an owning, unconsumed parameter of the same name
/// in the SAME frame as `v` (the re-bind and the caller's transfer bind into
/// one callee frame). Restricted to that frame so a nested function's
/// borrowed parameter never resolves to an unrelated outer `sink` parameter
/// of the same name.
_owning_param_binding_beside :: (fn(imm(env) : Environment, imm(v) : Variable) -> Option(Variable))({
  (fi : usize) = env.frames.len();
  while(fi > usize(0), {
    fi = (fi - usize(1));
    match(
      env.frames.get(fi),
      .Some(fr) => {
        (has_v : bool) = false;
        (vi : usize) = usize(0);
        while(vi < fr.variables.len(), {
          match(
            fr.variables.get(vi),
            .Some(fv) => if(fv.id == v.id, {
              has_v = true;
            }),
            .None => ()
          );
          vi = (vi + usize(1));
        });
        if(has_v, {
          (oi : usize) = usize(0);
          while(oi < fr.variables.len(), {
            match(
              fr.variables.get(oi),
              .Some(ov) => if((ov.id != v.id) && (ov.name == v.name) && ov.is_parameter && ov.is_owning_the_rc_value && (!ov.is_ref && !ov.is_module_level) && ov.consumed_at_token.is_none(), {
                return(Option(Variable).Some(ov));
              }),
              .None => ()
            );
            oi = (oi + usize(1));
          });
          return(Option(Variable).None);
        });
      },
      .None => ()
    );
  });
  Option(Variable).None
});
move_captured_explicit_copy_variable :: (fn(imm(v) : Variable, imm(tok) : Token, imm(env) : Environment, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  match(
    v.consumed_at_token,
    .Some(ct) => {
      same_site := ((ct.*.row == tok.row) && ((ct.*.column == tok.column) && (ct.*.module_path == tok.module_path)));
      if(!same_site, {
        raise_flow_violation(use_of_moved_value_error(v.name.clone(), v.ty, tok, variable_move_note(v, ct.*)), ctx, exn);
      });
    },
    .None => {
      // `v` may be the non-owning re-bind that shadows an
      // `own(cb) : Impl(Fn(…))` parameter inside a SPECIALIZED function body
      // (`_owning_param_binding_for_capture_move` above): the move then
      // consumes the OWNING binding — its scope-end release is skipped and
      // the capture struct owns the reference — which is how a move-only
      // value crosses `Thread.spawn`'s relaying closure
      // (issues/fixed/a-move-only-value-cannot-be-moved-into-thread-spawn.md).
      owner := if(!v.is_owning_the_rc_value && v.is_parameter, _owning_param_binding_for_capture_move(env, v.name.clone()), Option(Variable).None);
      if((!v.is_owning_the_rc_value && owner.is_none()) || (v.is_ref || v.is_module_level), {
        msg := `use of moved value: the closure captures \`${v.name}\`, whose type \`${type_to_string(v.ty)}\` ${_explicit_copy_kind(v.ty)}, so the capture moves it, and \`${v.name}\` cannot be moved: it is borrowed (a by-value parameter, a \`match\`/\`for\` binding, a \`mut\` binding or a module-level binding). Take it \`sink(...)\` to own it.`;
        raise_flow_violation(with_code(format_error_message_with_help(tok, msg, move_only_help(v.name.clone(), v.ty)), E_USE_OF_MOVED_VALUE), ctx, exn);
      });
      moved := match(
        owner,
        .Some(o) => o,
        .None => v
      );
      _log_user_move(moved, tok, env);
      moved.consumed_at_token = Option(Rc(Token)).Some(rc(tok.clone()));
      // Mark the shadow too, so a re-evaluation of the same site against the
      // same bindings takes the `same_site` branch instead of finding every
      // owning binding consumed and raising E0901.
      if(owner.is_some(), {
        v.consumed_at_token = Option(Rc(Token)).Some(rc(tok.clone()));
      });
    }
  );
});
/// `e` is `p.*`: a dereference.
_is_deref_place :: (fn(imm(e) : AstExpr) -> bool)(
  ast_expr_is_fn_call_of(e, BF_DOT, Option(usize).Some(usize(2))) && match(
    e,
    .FnCall(_, _, d_args, _, _) => match(d_args.get(usize(1)), .Some(lbl) => (ast_expr_is_atom(lbl) && (ast_expr_token(lbl).value == "*")), .None => false),
    .Atom(_, _) => false
  )
);
/// "is move-only" or "is copied explicitly (`.clone()`)": the kind of a type
/// that is not implicitly copyable, for a message.
_explicit_copy_kind :: (fn(imm(ty) : TypeValue) -> String)(
  cond(
    type_is_move_only(ty) => String.from("is move-only"),
    // Decision 36: a plain-data type with neither `Copy` nor `Clone` is
    // move-only, with no `.clone()` to offer.
    type_lacks_clone(ty) => String.from("is move-only (it is neither `Copy` nor `Clone`)"),
    true => String.from("is copied only explicitly (`.clone()`)")
  )
);
/// Throw E0901 for a copy of the not-implicitly-copyable value `rhs` out of
/// storage it does not own: an `imm` parameter or a `match`/`for` binding (they borrow), an
/// `inout` binding, a module-level binding, or a projection (a field, an
/// element, a dereference). The value cannot be copied, and moving it out
/// would leave its owner partly moved: Yo has no partial moves, so the owner
/// is moved whole or not at all.
_throw_explicit_copy_violation :: (fn(imm(rhs) : AstExpr, imm(ty) : TypeValue, imm(what) : String, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  name := _place_text(rhs);
  msg := `use of moved value: cannot copy \`${name}\`, whose type \`${type_to_string(ty)}\` ${_explicit_copy_kind(ty)}, and it cannot be moved either: ${what}`;
  help := cond(ast_expr_is_atom(rhs) => move_only_help(name, ty), true => move_only_type_help(ty));
  raise_flow_violation(
    with_code(format_error_message_with_help(ast_expr_token(rhs), msg, help), E_USE_OF_MOVED_VALUE),
    ctx,
    exn
  );
});
/// E0913 for a move out of a by-value capture of a closure typed `Fn(...)`
/// (plans/VALUES_BY_DEFAULT.md decision 37): an `Fn` call borrows the
/// captures so the closure can run again, and a closure that moves one out is
/// call-once. The error names the moving line; the fix is the `FnOnce(...)`
/// type, whose call consumes the closure.
_throw_fn_closure_moves_capture :: (fn(imm(rhs) : AstExpr, imm(ty) : TypeValue, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  name := _place_text(rhs);
  msg := `Cannot move \`${name}\` out of the closure: it is a by-value capture, and the closure is typed \`Fn(...)\`, whose call borrows its captures so it can run again. A closure that moves a capture out is called once.`;
  help := `type the closure \`FnOnce(...)\`: its call consumes the closure, whose body then owns its captures and may move \`${name}\` (\`${type_to_string(ty)}\` ${_explicit_copy_kind(ty)}) out`;
  raise_flow_violation(
    with_code(format_error_message_with_help(ast_expr_token(rhs), msg, Option(String).Some(help)), E_CLOSURE_MOVES_CAPTURE),
    ctx,
    exn
  );
});
/// `v` is captured IMPLICITLY by the closure whose body is being evaluated:
/// it is bound in a frame below the body's own frames, and not in a capture
/// list's frame (an `Fn` closure's by-value entries are checked first; an
/// `FnOnce` closure's, which the body owns, are excluded here).
/// `io.async` bodies are excluded: their state machine owns its captures.
_is_implicit_closure_capture :: (fn(imm(v) : Variable, imm(env) : Environment, imm(ctx) : EvalContext) -> bool)(
  match(
    ctx.is_evaluating_function_body_or_async_block,
    .Some(sub) => match(
      sub.kind,
      .FunctionBody => {
        fid := match(sub.func_value, .Some(fv) => match(fv, .FuncVal(fvd, _) => fvd.*.func_id.clone(), _ => String.from("")), .None => String.from(""));
        if((fid.len() == usize(0)) || !is_closure_fn(fid.clone()) || is_io_async_sm_closure(fid.clone()), {
          return(false);
        });
        body_level := sub.eval_env.frame_count();
        // The first closure parameter frame below the body, walking down, is
        // this closure's own: its parameters are not captures. One further
        // down belongs to an enclosing closure, whose parameters are. The
        // same holds for an `FnOnce` capture-list frame: only this closure's
        // own (below its parameter frame, above any enclosing closure's) is
        // the body's to move from; an enclosing closure's captures are
        // captures here.
        (own_params_seen : bool) = false;
        (enclosing_seen : bool) = false;
        (fi : usize) = env.frames.len();
        while(fi > usize(0), {
          fi = (fi - usize(1));
          match(
            env.frames.get(fi),
            .Some(fr) => {
              is_param_frame := ((fi < body_level) && is_closure_param_frame(fr.id));
              is_own_params := (is_param_frame && !own_params_seen);
              if(is_param_frame && own_params_seen, {
                enclosing_seen = true;
              });
              is_own_capture := (is_fnonce_capture_frame(fr.id) && !enclosing_seen);
              (vi : usize) = usize(0);
              while(vi < fr.variables.len(), {
                match(
                  fr.variables.get(vi),
                  .Some(fv2) => if(fv2.id == v.id, {
                    return((fi < body_level) && !is_own_capture && !is_own_params);
                  }),
                  .None => ()
                );
                vi = (vi + usize(1));
              });
              if(is_own_params, {
                own_params_seen = true;
              });
            },
            .None => ()
          );
        });
        false
      },
      _ => false
    ),
    .None => false
  )
);
/// `v` is the non-owning re-bind that shadows a `sink(f) : Impl(...)`
/// closure parameter inside a SPECIALIZED body (calls/helper.yo's re-bind
/// loop keeps it non-owning: an owning re-bind was a double release). The
/// owning binding the caller's transfer handed the closure to sits in an
/// outer frame (`_owning_param_binding_for_capture_move`); a move of the
/// shadow — forwarding `f` to another `sink` parameter, storing it — moves
/// THAT binding, so its scope-end drop is skipped. Both moves are logged for
/// the `cond`/`match` joins. False (no move) when there is no such owner.
/// (issues/fixed/forwarding-a-sink-closure-parameter-to-a-sink-parameter-is-rejected.md)
_move_through_sink_shadow :: (fn(imm(v) : Variable, imm(rhs) : AstExpr, imm(env) : Environment) -> bool)({
  if(!v.is_parameter || v.is_ref || v.is_module_level, {
    return(false);
  });
  match(
    _owning_param_binding_beside(env, v),
    .Some(o) => {
      tok := ast_expr_token(rhs);
      _log_user_move(o, tok, env);
      o.consumed_at_token = Option(Rc(Token)).Some(rc(tok.clone()));
      _log_user_move(v, tok, env);
      v.consumed_at_token = Option(Rc(Token)).Some(rc(tok.clone()));
      true
    },
    .None => false
  )
});
/// E0913 for a move out of an implicit capture (Generation A of decision 37,
/// as amended 2026-10-07): a closure body owns, and so may move out, only the
/// by-value entries of a capture list, in a closure typed `FnOnce(...)`.
_throw_implicit_capture_move :: (fn(imm(rhs) : AstExpr, imm(ty) : TypeValue, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  name := _place_text(rhs);
  msg := `Cannot move \`${name}\` out of the closure: it is captured implicitly, and a closure body moves a capture out only from a capture list. A closure that moves a capture out is called once.`;
  help := `list the capture and type the closure \`FnOnce(...)\`: \`{ ${name} }(...) => ...\`, whose call consumes the closure (\`${type_to_string(ty)}\` ${_explicit_copy_kind(ty)})`;
  raise_flow_violation(
    with_code(format_error_message_with_help(ast_expr_token(rhs), msg, Option(String).Some(help)), E_CLOSURE_MOVES_CAPTURE),
    ctx,
    exn
  );
});
/// The move of a value that is not implicitly copyable
/// (`type_requires_explicit_copy`: today a move-only one) at a point where a
/// copyable RC value would be dupped (`set_expr_as_needs_to_call_dup`): `:=`,
/// `=`, a `sink` argument, a
/// field or element store, a return, a constructor or literal element. The
/// owner gives the value up, with no dup:
///
/// - an owning temp (a call result, a constructor) transfers, as an RC temp
///   does;
/// - an owning named local is CONSUMED (`set_expr_as_consumed`): a later use
///   is E0901, and its scope-end drop is skipped;
/// - anything else is borrowed storage, and the copy is E0901
///   (`_throw_explicit_copy_violation`).
transfer_explicit_copy_value :: (fn(imm(rhs) : AstExpr, imm(ei) : ExprInfo, imm(variable_name) : String, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  match(
    find_variable_in_env(ei.env, variable_name.clone()),
    .None => (),
    .Some(v) => cond(
      is_temp_variable_name(ei.env.module_path, variable_name) => {
        if(v.is_owning_the_rc_value, {
          if(v.consumed_at_token.is_none(), {
            v.consumed_at_token = Option(Rc(Token)).Some(rc(ast_expr_token(rhs)));
          });
        }, {
          what := cond(
            _is_deref_place(rhs) => String.from("it is the value a pointer or reference points to, and that storage still owns it (a dereference copies, it never moves)."),
            ast_expr_is_fn_call_of(rhs, BF_DOT, Option(usize).Some(usize(2))) => String.from("it is a field of another value, and moving it out would leave that value partly moved (Yo has no partial moves). Move the whole value instead."),
            true => String.from("it is borrowed from the value that holds it (an element, or a binding into another value).")
          );
          _throw_explicit_copy_violation(rhs, ei.ty, what, ctx, exn);
        });
      },
      v.is_module_level => _throw_explicit_copy_violation(rhs, ei.ty, String.from("it is a module-level binding, which lives for the whole program and is never moved. Pass it to an `imm` parameter (a borrow) instead."), ctx, exn),
      v.is_ref => _throw_explicit_copy_violation(rhs, ei.ty, String.from("it is a `mut` binding, which names storage the caller owns. Lend it on with `&mut`, or move the caller's value."), ctx, exn),
      is_fn_capture_value_binding(v.id) => _throw_fn_closure_moves_capture(rhs, ei.ty, ctx, exn),
      _is_implicit_closure_capture(v, ei.env, ctx) => _throw_implicit_capture_move(rhs, ei.ty, ctx, exn),
      v.is_owning_the_rc_value => set_expr_as_consumed(rhs, ei.env, false, ctx, exn),
      _move_through_sink_shadow(v, rhs, ei.env) => (),
      true => _throw_explicit_copy_violation(rhs, ei.ty, String.from("it is borrowed (an `imm` parameter or a `match`/`for` binding), and a borrow cannot give the value away. Take the parameter by value (`x : T`, without `imm`) to own it."), ctx, exn)
    )
  );
});
// ---------------------------------------------------------------------------
// set_expr_as_consumed
// ---------------------------------------------------------------------------
/// Log a move of a user-named variable in the flow log (before the variable
/// is marked): per-path move state for `cond`/`match` joins and loops. A
/// compiler temp's "consumed" mark is ownership bookkeeping, not a move.
_log_user_move :: (fn(imm(v) : Variable, imm(tok) : Token, imm(env) : Environment) -> unit)({
  if(!is_temp_variable_name(env.module_path, v.name), {
    record_branch_consume(v.id, tok, v.initialized_at_token, match(v.consumed_at_token, .Some(ct) => Option(Token).Some(ct.*), .None => Option(Token).None));
  });
});
/// Mark the variable backing `expr` as consumed in `env`:
///
///   1. If `expr.$.value` is a `TypeVal`, type values are reusable —
///      return without marking.
///   2. If `expr.$.variable_name` is `.None`, there is no temp/named
///      variable to consume — return.
///   3. Look up the most-recent binding of that name in `env`. If
///      the name resolves to no variable, throw a use-before-define
///      error.
///   4. If the variable was already consumed AND `allow_consume_again`
///      is `false`, throw a `use of moved value` error pointing both
///      at this expression and at the prior consumption point.
///   5. Otherwise mutate the variable's `consumed_at_token` to this
///      expression's token.
// ---------------------------------------------------------------------------
// Second-class values and capture-list freezes
// (plans/VALUES_BY_DEFAULT.md decisions 18, 35 and 38 A/B)
// ---------------------------------------------------------------------------
/// How a capture-list borrow reads in a message: "`s.items` (its capture
/// `imm(items)` at m.yo:3:5)".
_capture_borrow_note :: (fn(imm(b) : CaptureBorrow) -> String)({
  mode := if(b.is_mut, String.from("mut"), String.from("imm"));
  `\`${capture_borrow_place_string(b)}\` (the capture \`${mode}(${b.label})\` at ${b.site})`
});
/// Decision 38 A: a second-class value (one holding a capture-list borrow,
/// transitively) may not be `how` — returned, stored in a field or a `Dyn`,
/// moved into a `sink` parameter, spawned, or named as a type argument. A
/// no-op for any other type.
reject_second_class_escape :: (fn(imm(ty) : TypeValue, imm(how) : String, imm(tok) : Token, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  if(!type_is_second_class(ty), {
    return(());
  });
  bs := ArrayList(CaptureBorrow).new();
  collect_type_borrows(ty, bs);
  b := match(bs.get(usize(0)), .Some(x) => x, .None => return(()));
  raise_flow_violation(
    with_code(
      format_error_message_with_help(
        tok,
        `This value borrows ${_capture_borrow_note(b)}, so it is second-class and cannot be ${how}: a borrow never outlives the scope that lends it.`,
        Option(String).Some(`capture a value instead (\`{ ${b.label} : ${capture_borrow_place_string(b)}.clone() }\`), or keep the closure local to the scope that owns \`${b.root_name}\` and call it there`)
      ),
      E_BORROW_ESCAPES
    ),
    ctx,
    exn
  );
});
/// The binding with id `id` in `env`, and its (frame, position).
_find_var_by_id :: (fn(imm(env) : Environment, id : usize) -> Option(Tuple(Variable, usize, usize)))({
  (fi : usize) = env.frames.len();
  while(fi > usize(0), {
    fi = (fi - usize(1));
    match(
      env.frames.get(fi),
      .Some(frame) => {
        (vi : usize) = usize(0);
        while(vi < frame.variables.len(), {
          match(
            frame.variables.get(vi),
            .Some(v) => if(v.id == id, {
              return(Option(Tuple(Variable, usize, usize)).Some((v, fi, vi)));
            }),
            .None => ()
          );
          vi = (vi + usize(1));
        });
      },
      .None => ()
    );
  });
  Option(Tuple(Variable, usize, usize)).None
});
/// A live capture-list freeze: while `holder` is in scope and not moved, the
/// borrowed root is frozen (decision 18 rule 2, applied to the places a
/// closure captures, transitively, decision 38 A). Scope-based: the freeze
/// ends with the holder's scope, not at its last use (the last-use refinement
/// lands with decision 18's live ranges).
_CaptureFreeze :: struct(holder_id : usize, holder_name : String, borrow : CaptureBorrow);
/// `holder` was just bound (`:=`, `=`) to a value of type `ty`. If the value
/// is second-class, check that every place it borrows outlives the holder
/// (decision 38 A: a binding may not outlive any place its value borrows),
/// and freeze those places for the holder's scope.
note_second_class_binding :: (fn(imm(holder) : Variable, imm(ty) : TypeValue, imm(tok) : Token, imm(env) : Environment, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  if(!type_is_second_class(ty), {
    return(());
  });
  bs := ArrayList(CaptureBorrow).new();
  collect_type_borrows(ty, bs);
  holder_at := _find_var_by_id(env, holder.id);
  (bi : usize) = usize(0);
  while(bi < bs.len(), {
    b := match(bs.get(bi), .Some(x) => x, .None => return(()));
    outlives := match(
      _find_var_by_id(env, b.root_id),
      .Some(root_at) => match(
        holder_at,
        .Some(h_at) => ((root_at.1 > h_at.1) || ((root_at.1 == h_at.1) && (root_at.2 > h_at.2))),
        .None => false
      ),
      // The borrowed binding is no longer in scope where the value lands:
      // a block or arm result carried it out of the scope that owns it.
      .None => true
    );
    if(outlives, {
      raise_flow_violation(
        with_code(
          format_error_message_with_help(
            tok,
            `\`${holder.name}\` would outlive ${_capture_borrow_note(b)}: \`${b.root_name}\` is dropped first, and the closure would point at freed storage.`,
            Option(String).Some(`declare \`${holder.name}\` after \`${b.root_name}\` and in the same or an inner scope, or capture a value instead (\`{ ${b.label} : ${capture_borrow_place_string(b)}.clone() }\`)`)
          ),
          E_BORROW_ESCAPES
        ),
        ctx,
        exn
      );
    });
    fz := _CaptureFreeze(holder_id : holder.id, holder_name : holder.name.clone(), borrow : b);
    match(
      g_capture_freezes.get(b.root_id),
      .Some(list) => {
        list.push(fz);
      },
      .None => {
        fresh := ArrayList(_CaptureFreeze).new();
        fresh.push(fz);
        g_capture_freezes.insert(b.root_id, fresh);
      }
    );
    bi = (bi + usize(1));
  });
});
/// Decision 38 A, "results": a block, arm or `cond` result of type `ty` may
/// not carry a borrow of a binding declared at or inside frame `scope_frame`
/// of `env` (the scope the result is leaving).
reject_second_class_result_outliving :: (fn(imm(ty) : TypeValue, scope_frame : usize, imm(tok) : Token, imm(env) : Environment, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  if(!type_is_second_class(ty), {
    return(());
  });
  bs := ArrayList(CaptureBorrow).new();
  collect_type_borrows(ty, bs);
  (bi : usize) = usize(0);
  while(bi < bs.len(), {
    b := match(bs.get(bi), .Some(x) => x, .None => return(()));
    match(
      _find_var_by_id(env, b.root_id),
      .Some(root_at) => if(root_at.1 >= scope_frame, {
        raise_flow_violation(
          with_code(
            format_error_message_with_help(
              tok,
              `This result borrows ${_capture_borrow_note(b)}, but \`${b.root_name}\` is declared inside the block or arm the result leaves, so the borrow would outlive it.`,
              Option(String).Some(`declare \`${b.root_name}\` outside the block, or capture a value instead (\`{ ${b.label} : ${capture_borrow_place_string(b)}.clone() }\`)`)
            ),
            E_BORROW_ESCAPES
          ),
          ctx,
          exn
        );
      }),
      .None => ()
    );
    bi = (bi + usize(1));
  });
});
/// An access to the binding `v` (a read, or with `is_write` a write or a
/// move) while a live closure borrows it: a `mut` capture freezes every
/// access, an `imm` capture freezes writes and moves (decision 18 rule 2).
/// A field of `v` is the same root. A no-op unless some capture-list closure
/// borrows `v`.
check_capture_freeze_access :: (fn(imm(v) : Variable, is_write : bool, imm(tok) : Token, imm(env) : Environment, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  if(g_capture_freezes.len() == usize(0), {
    return(());
  });
  match(
    g_capture_freezes.get(v.id),
    .Some(list) => {
      (fi : usize) = usize(0);
      while(fi < list.len(), {
        fz := match(list.get(fi), .Some(x) => x, .None => return(()));
        if(fz.borrow.is_mut || is_write, {
          live := match(
            _find_var_by_id(env, fz.holder_id),
            .Some(h_at) => h_at.0.consumed_at_token.is_none(),
            .None => false
          );
          if(live, {
            what := if(is_write, String.from("written or moved"), String.from("used"));
            raise_flow_violation(
              with_code(
                format_error_message_with_help(
                  tok,
                  `\`${v.name}\` cannot be ${what} here: the closure \`${fz.holder_name}\` borrows ${_capture_borrow_note(fz.borrow)}, and the borrow lasts until \`${fz.holder_name}\`'s scope ends.`,
                  Option(String).Some(`end \`${fz.holder_name}\`'s scope first (put the closure and its calls in a block), or reach \`${v.name}\` through the closure`)
                ),
                E_BORROW_CONFLICT
              ),
              ctx,
              exn
            );
          });
        });
        fi = (fi + usize(1));
      });
    },
    .None => ()
  );
});
/// One place an argument reaches, for decision 28's overlap test: its root
/// binding and its field path, and how a message names it.
_ArgPlace :: struct(root_id : usize, path : ArrayList(String), text : String);
/// The places argument `arg` (evaluated) reaches: the place it names, when it
/// is a field chain rooted at a runtime binding (`z`, `s.items`), and every
/// place a capture-list closure it holds borrows, transitively (decision 38 B).
_arg_places :: (fn(imm(arg) : AstExpr, imm(env) : Environment, imm(ctx) : EvalContext, mut(out) : ArrayList(_ArgPlace)) -> unit)({
  fields_rev := ArrayList(String).new();
  (cur : AstExpr) = arg;
  (walking : bool) = true;
  (is_place : bool) = true;
  while(walking, {
    if(ast_expr_is_fn_call_of(cur, BF_DOT, Option(usize).Some(usize(2))), {
      match(
        cur,
        .FnCall(_, _, d_args, _, _) => {
          fld := match(d_args.get(usize(1)), .Some(f) => f, .None => make_err_expr());
          if(ast_expr_is_atom(fld), {
            fields_rev.push(ast_expr_token(fld).value.clone());
          }, {
            is_place = false;
          });
          cur = match(d_args.get(usize(0)), .Some(r) => r, .None => make_err_expr());
        },
        .Atom(_, _) => {
          walking = false;
        }
      );
    }, {
      walking = false;
    });
  });
  if(is_place && ast_expr_is_atom(cur), {
    match(
      get_variables_from_env(env, ast_expr_token(cur).value.clone()).last(),
      .Some(rv) => if(!rv.is_compile_time_only, {
        path := ArrayList(String).new();
        (ri : usize) = fields_rev.len();
        while(ri > usize(0), {
          ri = (ri - usize(1));
          path.push(match(fields_rev.get(ri), .Some(f) => f, .None => String.new()));
        });
        text := String.from("`");
        text.push_string(ast_expr_to_string(arg));
        text.push_str("`");
        out.push(_ArgPlace(root_id : rv.id, path : path, text : text));
      }),
      .None => ()
    );
  });
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(arg)),
    .Some(ai) => {
      bs := ArrayList(CaptureBorrow).new();
      collect_type_borrows(ai.ty, bs);
      (bi : usize) = usize(0);
      while(bi < bs.len(), {
        match(bs.get(bi), .Some(b) => out.push(_ArgPlace(root_id : b.root_id, path : b.path, text : _capture_borrow_note(b))), .None => ());
        bi = (bi + usize(1));
      });
    },
    .None => ()
  );
});
/// Two places overlap when they share a root and one path is a prefix of the
/// other (decision 28): `s` and `s.items` do, `s.left` and `s.right` do not.
_places_overlap :: (fn(imm(a) : _ArgPlace, imm(b) : _ArgPlace) -> bool)({
  if(a.root_id != b.root_id, {
    return(false);
  });
  n := if(a.path.len() < b.path.len(), a.path.len(), b.path.len());
  (i : usize) = usize(0);
  while(i < n, {
    if(match(a.path.get(i), .Some(x) => x, .None => String.new()) != match(b.path.get(i), .Some(y) => y, .None => String.new()), {
      return(false);
    });
    i = (i + usize(1));
  });
  true
});
/// Decision 28's argument exclusivity for capture-list borrows (decision 38
/// B): within one call (the receiver and a called closure count as
/// arguments), an exclusive argument — a `mut`/`inout` one, or a value that
/// carries a `mut` capture, which is lent exclusively even to an `imm(f)`
/// parameter — may not overlap anything another argument reaches. So
/// `g(&f, &mut z)` (where `f` captures `z`), `f(&g)` (where `g` reaches the
/// `mut`-capturing `f`) and `xs.for_each({ mut(n) : &mut xs.n }(…) => …)` are
/// errors, and a `for_each` literal that borrows a fresh local is not.
/// `extra` is the called closure value, when the callee is one.
require_capture_borrow_exclusivity :: (
  fn(imm(param_is_ref) : ArrayList(bool), imm(args) : ArrayList(AstExpr), imm(extra) : Option(AstExpr), imm(env) : Environment, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit
)({
  if(!capture_borrows_exist(), {
    return(());
  });
  all_args := ArrayList(AstExpr).new();
  excl := ArrayList(bool).new();
  (ai : usize) = usize(0);
  while(ai < args.len(), {
    a := match(args.get(ai), .Some(x) => x, .None => make_err_expr());
    all_args.push(a);
    is_ref_param := match(param_is_ref.get(ai), .Some(r) => r, .None => false);
    carries_mut := match(expr_info_table_get(ctx.expr_info_table, ast_expr_id(a)), .Some(inf) => type_first_mut_borrow(inf.ty).is_some(), .None => false);
    excl.push(is_ref_param || carries_mut);
    ai = (ai + usize(1));
  });
  match(
    extra,
    .Some(callee) => {
      all_args.push(callee);
      excl.push(match(expr_info_table_get(ctx.expr_info_table, ast_expr_id(callee)), .Some(inf) => type_first_mut_borrow(inf.ty).is_some(), .None => false));
    },
    .None => ()
  );
  places := ArrayList(ArrayList(_ArgPlace)).new();
  (pi : usize) = usize(0);
  while(pi < all_args.len(), {
    ps := ArrayList(_ArgPlace).new();
    _arg_places(match(all_args.get(pi), .Some(x) => x, .None => make_err_expr()), env, ctx, ps);
    places.push(ps);
    pi = (pi + usize(1));
  });
  (i : usize) = usize(0);
  while(i < all_args.len(), {
    if(match(excl.get(i), .Some(e) => e, .None => false), {
      pis := match(places.get(i), .Some(x) => x, .None => ArrayList(_ArgPlace).new());
      (j : usize) = usize(0);
      while(j < all_args.len(), {
        if(j != i, {
          pjs := match(places.get(j), .Some(x) => x, .None => ArrayList(_ArgPlace).new());
          (x : usize) = usize(0);
          while(x < pis.len(), {
            pa := match(pis.get(x), .Some(v) => v, .None => return(()));
            (y : usize) = usize(0);
            while(y < pjs.len(), {
              pb := match(pjs.get(y), .Some(v) => v, .None => return(()));
              if(_places_overlap(pa, pb), {
                arg_i := match(all_args.get(i), .Some(v) => v, .None => make_err_expr());
                arg_j := match(all_args.get(j), .Some(v) => v, .None => make_err_expr());
                raise_flow_violation(
                  with_code(
                    format_error_message_with_help(
                      ast_expr_token(arg_i),
                      `\`${ast_expr_to_string(arg_i)}\` is lent exclusively to this call (it is a \`mut\` argument, or it holds a \`mut\` capture), and it reaches ${pa.text}, which \`${ast_expr_to_string(arg_j)}\` in the same call also reaches (${pb.text}): the callee could reach one place through both.`,
                      Option(String).Some(String.from("split the call, or pass the place through the closure alone (call arguments are exclusive, decisions 28 and 38 B)"))
                    ),
                    E_BORROW_CONFLICT
                  ),
                  ctx,
                  exn
                );
              });
              y = (y + usize(1));
            });
            x = (x + usize(1));
          });
        });
        j = (j + usize(1));
      });
    });
    i = (i + usize(1));
  });
});
set_expr_as_consumed :: (
  fn(
    imm(expr) : AstExpr,
    imm(env) : Environment,
    allow_consume_again : bool,
    imm(ctx) : EvalContext,
    imm(exn) : Exception
  ) -> unit
)({
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(expr));
  match(
    info_opt,
    .None => (),
    .Some(info) => cond(
      // Step 1: type values are reusable, never consumed.
      is_type_value(info.value) => (),
      // A value with nothing to transfer (no counted payload, implicitly
      // copyable: a `Copy` value) is copied, never consumed. Since the flip
      // (decision 30) every plain parameter owns its value, so a `usize`
      // parameter returned from one `cond` arm would otherwise read as moved
      // there and not in the others (E0907).
      type_is_bitwise_copy(info.ty) => (),
      true => match(
        info.variable_name,
        // Step 2: no variable name → nothing to consume.
        .None => (),
        .Some(name) => {
          vars := get_variables_from_env(env, name);
          // Step 3: unknown variable.
          if(vars.len() == usize(0), {
            entries := ArrayList(TokenAndError).new();
            entries.push(
              TokenAndError(
                token : ast_expr_token(expr),
                error_message : `Variable "${name}" is not defined.`
              )
            );
            hint := match(
              suggest_name(name, env_candidate_names(env)),
              .Some(h) => Option(String).Some(`did you mean "${h}"?`),
              .None => Option(String).None
            );
            exn.throw(dyn(format_error_messages_with_help(entries, hint)));
          });
          v := match(vars.last(), .Some(x) => x, .None => make_err_variable(env));
          // A compile-time-only FUNCTION binding (`f :: (fn(...) -> R)(...)`)
          // is a code pointer re-materialized at every use: like a type value,
          // it is never consumed. Passing a named function to an `own`
          // parameter (`Thread.spawn(worker)`) marked the definition itself as
          // moved, and every later use of `worker` was "use of moved value"
          // (issues/fixed/passing-a-named-function-to-an-own-parameter-moves-the-definition.md).
          // A local closure VALUE is not compile-time-only and still moves: its
          // captured state moves with it.
          if(v.is_compile_time_only && match(info.value, .Some(cfv) => is_func_val(cfv), .None => false), {
            return(());
          });
          // A place a live capture-list closure borrows cannot be moved
          // (decision 18 rule 2).
          if(!ast_expr_token(expr).module_path.starts_with(String.from("auto-generated://")), {
            check_capture_freeze_access(v, true, ast_expr_token(expr), env, ctx, exn);
          });
          // `inout` local bindings (plans/archive/INOUT_LOCAL_BINDINGS_AUDIT.md §8 B2):
          // a live binding aliases this variable's SLOT; moving the slot's
          // count out (an `own` argument) would leave the alias reading a
          // handle it does not own, and a later write through the alias
          // would over-release it (§2.1). Reject while any borrower is live.
          // A local borrow (decision 18) is live until its last use: a move of
          // a place it freezes is E0911 inside that range, and free after it.
          // Only a binding outside the local-borrow model (none in safe code)
          // keeps the scope-wide gate below.
          if(local_borrows_active(), {
            local_borrow_access(local_borrow_place_of_variable(v), LocalBorrowAccess.Move, ast_expr_token(expr), ctx, exn);
          });
          borrowers := _untracked_inout_borrowers(find_live_inout_borrowers(env, v.id));
          if(borrowers.len() > usize(0), {
            b := match(borrowers.get(usize(0)), .Some(x) => x, .None => make_err_variable(env));
            b_entries := ArrayList(TokenAndError).new();
            b_entries.push(
              TokenAndError(
                token : ast_expr_token(expr),
                error_message : `Cannot move "${name}" while the 'mut' binding "${b.name}" borrows it: the binding would keep a reference to storage whose value was moved out. Copy the value out, or end the binding's scope before moving.`
              )
            );
            b_entries.push(
              TokenAndError(
                token : b.token,
                error_message : `"${b.name}" borrows "${name}" here:`
              )
            );
            exn.throw(dyn(format_error_messages(b_entries)));
          });
          match(
            v.consumed_at_token,
            // Step 5: not yet consumed → mark now. `v` IS the env's Variable
            // (refs from get_variables_from_env; Variable is reference-
            // semantics) so the in-place write is the update — the former
            // alias-then-update_existing_variable write-back was a no-op
            // full-env scan on the hot consumed-marking path (see consume.yo).
            .None => {
              _log_user_move(v, ast_expr_token(expr), env);
              v.consumed_at_token = Option(Rc(Token)).Some(rc(ast_expr_token(expr)));
            },
            .Some(consumed_tok) => cond(
              // Allowed to re-consume — overwrite the consumption point.
              allow_consume_again => {
                _log_user_move(v, ast_expr_token(expr), env);
                v.consumed_at_token = Option(Rc(Token)).Some(rc(ast_expr_token(expr)));
              },
              // Step 4: throw `use of moved value`.
              migrate_borrowed_match_at(consumed_tok.*) => (),
              true => {
                exn.throw(dyn(use_of_moved_value_error(name, v.ty, ast_expr_token(expr), variable_move_note(v, consumed_tok.*))));
              }
            )
          );
        }
      )
    )
  );
});
// ---------------------------------------------------------------------------
// YO_AUDIT_IMPLICIT_COPY (plans/VALUES_BY_DEFAULT.md §6, item 1)
// ---------------------------------------------------------------------------
/// Lists every dup the evaluator inserts that unique ownership turns into an
/// explicit `.clone()`: a store, binding, return, owning argument or capture
/// of an RC-bearing value (every dup is one, `type_contains_rc_type` gates
/// them all) whose source stays alive. One stderr line per site:
/// `file:line:col [implicit-copy] <category> <type> <path> source=<kind> \`<source>\``.
/// A source that is borrowed (a by-value parameter, a `match`/`for` binding,
/// an `inout` slot), a non-owning temporary (a field or index read: no
/// partial moves, decision 19), a module-level value or a closure's own
/// capture cannot be moved from, so its dup is reported at once. An owning
/// local or `own` parameter is held PENDING and judged at its declaring
/// frame's epilogue (`audit_judge_implicit_copies`, exprs/begin.yo): it is a
/// copy only if the variable is read again after the site. Inert unless the
/// knob is set: nothing else in the evaluator reads these tables.
(g_audit_implicit_copy : bool) = debug_knob(`YO_AUDIT_IMPLICIT_COPY`).is_some();
/// One dup whose source is an owning local, waiting for its frame's epilogue.
ImplicitCopyPending :: struct(
  /// The finished report line, printed if the variable is used again.
  line : String,
  /// The site's token position: a read of the variable at a later offset in
  /// the same module is a use after the copy.
  module_path : String,
  byte_offset : u32
);
/// Variable id → its pending copy sites.
(g_implicit_copy_pending : HashMap(usize, ArrayList(ImplicitCopyPending))) = HashMap(usize, ArrayList(ImplicitCopyPending)).new();
/// Lines already printed: def-time trials, the checking phase and each
/// specialization re-evaluate one body, so a site is reported once per
/// distinct line (a generic body once per instantiated type).
(g_implicit_copy_printed : HashSet(String)) = HashSet(String).new();
/// What a `match` binding borrows from, by binding id: `temp` (an owned
/// temporary such as a call result — the binding owns its part, so a store
/// of it is not a copy here; any copy happened inside the callee), `local`
/// (an owning local, `root_id`: the binding is a part of it, a copy if the
/// local is read again), `macro` (a scrutinee a macro introduced — `for`'s
/// element: a borrow) or `place` (a parameter, field, global: a borrow).
ImplicitCopyRoot :: struct(kind : String, root_id : usize);
(g_implicit_copy_match_roots : HashMap(usize, ImplicitCopyRoot)) = HashMap(usize, ImplicitCopyRoot).new();
/// Record what `binding`, a pattern binding of a `match` whose evaluated
/// scrutinee is described by `scr_info`, borrows from.
audit_note_match_binding :: (fn(imm(binding) : Variable, imm(scr_info) : ExprInfo) -> unit)({
  root := match(
    scr_info.variable_name,
    .Some(sn) => match(
      find_variable_in_env(scr_info.env, sn),
      .Some(sv) => match(
        g_implicit_copy_match_roots.get(sv.id),
        .Some(inherited) => inherited,
        .None => cond(
          (canonical_module_path(sv.token.module_path.clone()) != canonical_module_path(binding.token.module_path.clone())) => ImplicitCopyRoot(kind : String.from("macro"), root_id : sv.id),
          // A temporary of plain data (no counted value) owns what it
          // holds, as an owning RC temporary does.
          is_any_temp_variable_name(sv.name.clone()) => ImplicitCopyRoot(kind : cond((sv.is_owning_the_rc_value || !type_contains_rc_type(sv.ty)) => String.from("temp"), true => String.from("place")), root_id : sv.id),
          (sv.is_owning_the_rc_value && !sv.is_module_level && !sv.is_ref) => ImplicitCopyRoot(kind : String.from("local"), root_id : sv.id),
          true => ImplicitCopyRoot(kind : String.from("place"), root_id : sv.id)
        )
      ),
      .None => ImplicitCopyRoot(kind : String.from("place"), root_id : usize(0))
    ),
    .None => ImplicitCopyRoot(kind : String.from("place"), root_id : usize(0))
  );
  g_implicit_copy_match_roots.insert(binding.id, root);
});
audit_implicit_copy_enabled :: (fn() -> bool)(g_audit_implicit_copy);
/// Remove and return the pending sites of variable `id` (its frame's epilogue
/// judges them), or none.
audit_take_implicit_copy_pending :: (fn(id : usize) -> Option(ArrayList(ImplicitCopyPending)))(
  cond(
    (g_implicit_copy_pending.len() == usize(0)) => Option(ArrayList(ImplicitCopyPending)).None,
    true => g_implicit_copy_pending.remove(id)
  )
);
audit_print_implicit_copy :: (fn(imm(line) : String) -> unit)({
  if(g_implicit_copy_printed.insert(line.clone()), {
    eprintln(line);
  });
});
_IC_COLLECTIONS :: "ArrayList|HashMap|HashSet|BTreeMap|Deque|LinkedList|OrderedMap|PriorityQueue";
/// The std collection a struct type name denotes (`ArrayList` or
/// `ArrayList(String)` → `ArrayList`), or none.
_implicit_copy_collection_name :: (fn(imm(name) : String) -> Option(String))({
  bases := String.from(_IC_COLLECTIONS).split("|");
  (i : usize) = usize(0);
  while(i < bases.len(), {
    match(
      bases.get(i),
      .Some(base) => if((name == base) || name.starts_with(`${base}(`), {
        return(Option(String).Some(base));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  Option(String).None
});
/// The category of the first RC-bearing member, for an aggregate.
_implicit_copy_first_member :: (fn(imm(members) : ArrayList(TypeValue), depth : u32) -> Option(String))({
  (mi : usize) = usize(0);
  while(mi < members.len(), {
    match(
      members.get(mi),
      .Some(m) => if(type_contains_rc_type(m), {
        return(Option(String).Some(_implicit_copy_category_at(m, depth + u32(1))));
      }),
      .None => ()
    );
    mi = (mi + usize(1));
  });
  Option(String).None
});
/// No member holds an RC value: a `ref` type of plain data only.
_implicit_copy_plain_members :: (fn(imm(members) : ArrayList(TypeValue)) -> bool)({
  (pi : usize) = usize(0);
  while(pi < members.len(), {
    match(
      members.get(pi),
      .Some(m) => if(type_contains_rc_type(m), {
        return(false);
      }),
      .None => ()
    );
    pi = (pi + usize(1));
  });
  true
});
_implicit_copy_via :: (fn(imm(inner) : Option(String)) -> String)(
  match(
    inner,
    .Some(c) => cond(
      c.starts_with("via:") => c,
      true => `via:${c}`
    ),
    .None => String.from("aggregate")
  )
);
/// The audit category of an RC-bearing type: `String`, a collection's name,
/// `Rc`, `Arc`, `Dyn`, `closure`, `ref-object` (a `ref` struct/enum with an
/// RC-bearing field; V5 makes it an `Rc`), `ref-object(plain)` (a `ref`
/// type whose fields are all plain data), or `via:<category>` for a value
/// aggregate (`Option(String)`, a tuple, a value struct) holding one.
implicit_copy_category :: (fn(imm(ty) : TypeValue) -> String)(
  _implicit_copy_category_at(ty, u32(0))
);
_implicit_copy_category_at :: (fn(imm(ty) : TypeValue, depth : u32) -> String)({
  if(depth > u32(6), {
    return(String.from("other"));
  });
  t := t_refine_inner(ty);
  display := type_to_string(ty);
  if(is_dyn_type(t), {
    return(String.from("Dyn"));
  });
  if(is_iso_type(t), {
    return(String.from("Arc"));
  });
  if(is_box_type(t), {
    return(String.from("Rc"));
  });
  match(
    t,
    // By the PRINTED name: an instantiation (`ArrayList(i32)`) carries an
    // empty `name` (only `Rc(...)` is stamped) and renders through the
    // display-name side table (types/string.yo).
    .Struct({ field_types, is_reference_semantics : is_ref, is_atomic_rc : is_atomic }) => match(
      _implicit_copy_collection_name(display.clone()),
      .Some(collection) => collection,
      .None => cond(
        (display == "String") => String.from("String"),
        display.starts_with("Arc(") => String.from("Arc"),
        (is_ref && is_atomic) => String.from("Arc"),
        (is_ref && _implicit_copy_plain_members(field_types)) => String.from("ref-object(plain)"),
        is_ref => String.from("ref-object"),
        true => _implicit_copy_via(_implicit_copy_first_member(field_types, depth))
      )
    ),
    .EnumT({ variant_fields, is_reference_semantics : is_ref, is_atomic_rc : is_atomic }) => {
      all_fields := ArrayList(TypeValue).new();
      (vi : usize) = usize(0);
      while(vi < variant_fields.len(), {
        match(
          variant_fields.get(vi),
          .Some(vf) => {
            (fi : usize) = usize(0);
            while(fi < vf.len(), {
              match(vf.get(fi), .Some(f) => all_fields.push(f), .None => ());
              fi = (fi + usize(1));
            });
          },
          .None => ()
        );
        vi = (vi + usize(1));
      });
      cond(
        (is_ref && is_atomic) => String.from("Arc"),
        (is_ref && _implicit_copy_plain_members(all_fields)) => String.from("ref-object(plain)"),
        is_ref => String.from("ref-object"),
        true => _implicit_copy_via(_implicit_copy_first_member(all_fields, depth))
      )
    },
    .Tuple(field_labels : _, field_types : tfs) => _implicit_copy_via(_implicit_copy_first_member(tfs, depth)),
    .Union(name : _, field_labels : _, field_types : ufs) => _implicit_copy_via(_implicit_copy_first_member(ufs, depth)),
    .Array(element : el, length : _, length_var : _) => {
      els := ArrayList(TypeValue).new();
      els.push(el);
      _implicit_copy_via(_implicit_copy_first_member(els, depth))
    },
    .Func({ result : _ }) => String.from("closure"),
    // An open type parameter in a definition-time trial: each instantiation
    // reports its concrete type, so this is the generic body itself.
    .SomeT({ required_trait_types : st_traits }) => {
      (sti : usize) = usize(0);
      (is_future : bool) = false;
      while(sti < st_traits.len(), {
        match(
          st_traits.get(sti),
          .Some(st) => if(is_future_trait_type(st), {
            is_future = true;
          }),
          .None => ()
        );
        sti = (sti + usize(1));
      });
      cond(is_future => String.from("future"), true => String.from("generic"))
    },
    _ => String.from("other")
  )
});
/// Record one dup for the audit. `site_tok` is the copied expression's
/// token, `source_name` the variable the dup reads (a temp for a projection),
/// `source_text` the expression as written.
audit_record_implicit_copy :: (
  fn(
    imm(site_tok) : Token,
    imm(ty) : TypeValue,
    copy_path : str,
    imm(env) : Environment,
    imm(source_name) : String,
    imm(source_text) : String,
    imm(ctx) : EvalContext,
    /// False for a closure's own captures: `ctx.captured_variables` is then
    /// the closure being built, not the function the site sits in.
    in_closure_body_check : bool
  ) -> unit
)({
  // Compiler-synthesized code (derives, generated helpers) is not a site a
  // user migrates.
  if(site_tok.module_path.starts_with("auto-generated://"), {
    return(());
  });
  (kind : String) = String.from("unknown");
  (pending_id : Option(usize)) = Option(usize).None;
  match(
    find_variable_in_env(env, source_name.clone()),
    .Some(v) => {
      captured := (in_closure_body_check && match(ctx.captured_variables, .Some(cv) => cv.contains_key(v.name.clone()), .None => false));
      cond(
        is_any_temp_variable_name(v.name.clone()) => {
          kind = String.from("projection");
        },
        v.is_module_level => {
          kind = String.from("global");
        },
        v.is_ref => {
          kind = String.from("inout-borrow");
        },
        captured => {
          kind = String.from("capture-state");
        },
        (!v.is_owning_the_rc_value && g_implicit_copy_match_roots.get(v.id).is_some()) => match(
          g_implicit_copy_match_roots.get(v.id),
          .Some(r) => cond(
            (r.kind == "temp") => {
              kind = String.from("temp-payload");
            },
            (r.kind == "macro") => {
              kind = String.from("for-element");
            },
            (r.kind == "local") => {
              kind = String.from("match-local");
              pending_id = Option(usize).Some(r.root_id);
            },
            true => {
              kind = String.from("match-place");
            }
          ),
          .None => ()
        ),
        !v.is_owning_the_rc_value => {
          kind = cond(v.is_parameter => String.from("param-borrow"), true => String.from("binding-borrow"));
        },
        true => {
          kind = cond(v.is_parameter => String.from("own-param"), true => String.from("local"));
          pending_id = Option(usize).Some(v.id);
        }
      );
    },
    .None => ()
  );
  text := cond(
    (source_text.len() > usize(60)) => `${source_text.substring(usize(0), usize(57))}...`,
    true => source_text
  );
  line := `${display_module_path(site_tok.module_path)}:${(site_tok.row + u32(1)).to_string()}:${(site_tok.column + u32(1)).to_string()} [implicit-copy] ${implicit_copy_category(ty)} ${type_to_string(ty).replace(" ", String.from(""))} ${copy_path} source=${kind} \`${text.replace("\n", String.from(" "))}\``;
  match(
    pending_id,
    .Some(vid) => {
      entry := ImplicitCopyPending(line : line, module_path : site_tok.module_path.clone(), byte_offset : site_tok.byte_offset);
      match(
        g_implicit_copy_pending.get(vid),
        .Some(lst) => lst.push(entry),
        .None => {
          fresh := ArrayList(ImplicitCopyPending).new();
          fresh.push(entry);
          g_implicit_copy_pending.insert(vid, fresh);
        }
      );
    },
    .None => audit_print_implicit_copy(line)
  );
});
// ---------------------------------------------------------------------------
// YO_AUDIT_COPY_TRAIT (plans/VALUES_BY_DEFAULT.md decision 36)
// ---------------------------------------------------------------------------
/// Sizes decision 36's sweep: every implicit copy of a plain-data value (no
/// owned buffer, not move-only) whose type is not `Copy`, with the source
/// used again. Those are exactly the copies Generation B's flip turns into
/// E0901 unless the sweep gives the type `Copy`. One stderr line per site:
/// `file:line:col [copy-trait] <first blocker> <type> <path> source=<kind>
/// needs=<A,B> \`<source>\``, where `needs` lists the named types
/// (`copy_trait_blockers`, trait_checking.yo) that must implement `Copy`.
///
/// The copy points are the explicit-copy audit's (`binding`, `assign`,
/// `field-store`, `element`, `return`, `capture`), plus `argument`: a value
/// passed to a plain parameter, which decision 30 makes by value. The source
/// rules follow the same audit (`audit_record_implicit_copy`), with two
/// differences for plain data: a local or a plain parameter is judged at
/// its frame's end (a plain parameter is the callee's own value under
/// decision 30), and a `match` binding of a temporary owns its payload (it
/// is not a copy). A field read is a copy at once (no partial moves,
/// decision 19). Inert unless the knob is set.
(g_audit_copy_trait : bool) = debug_knob(`YO_AUDIT_COPY_TRAIT`).is_some();
audit_copy_trait_enabled :: (fn() -> bool)(g_audit_copy_trait);
/// Either copy audit: the pending-site tables and the frame-end judge serve
/// both.
audit_pending_copies_enabled :: (fn() -> bool)(g_audit_implicit_copy || g_audit_copy_trait);
/// Record one implicit copy of a plain-data value for `YO_AUDIT_COPY_TRAIT`.
/// `source` is the copied expression as written: a variable (judged by its
/// kind), a field read (`a.b`, a copy at once) or anything else (a
/// temporary, whose copy is a move, and is skipped).
audit_record_copy_trait :: (
  fn(
    imm(site_tok) : Token,
    imm(ty) : TypeValue,
    copy_path : str,
    imm(env) : Environment,
    imm(source) : AstExpr,
    imm(ctx) : EvalContext,
    /// False for a closure's own captures, as for `audit_record_implicit_copy`.
    in_closure_body_check : bool
  ) -> unit
)({
  if(!g_audit_copy_trait || site_tok.module_path.starts_with("auto-generated://") || type_contains_rc_type(ty) || type_requires_explicit_copy(ty), {
    return(());
  });
  // `a.b`, and a dereference `p.*`, which parses as the same dot form.
  is_field_read := ast_expr_is_fn_call_of(source, ".", .Some(usize(2)));
  is_variable := (ast_expr_is_atom(source) && (ast_expr_token(source).kind == TokenKind.Identifier));
  if(!is_field_read && !is_variable, {
    return(());
  });
  needs := copy_trait_blockers_via_hook(ty, env);
  if(needs.len() == usize(0), {
    return(());
  });
  (kind : String) = String.from("field");
  (pending_id : Option(usize)) = Option(usize).None;
  if(is_variable, {
    match(
      find_variable_in_env(env, ast_expr_token(source).value.clone()),
      .Some(v) => {
        captured := (in_closure_body_check && match(ctx.captured_variables, .Some(cv) => cv.contains_key(v.name.clone()), .None => false));
        root := g_implicit_copy_match_roots.get(v.id);
        cond(
          (is_any_temp_variable_name(v.name.clone()) || v.is_compile_time_only) => {
            return(());
          },
          v.is_module_level => {
            kind = String.from("global");
          },
          v.is_ref => {
            kind = String.from("inout-borrow");
          },
          captured => {
            kind = String.from("capture-state");
          },
          root.is_some() => match(
            root,
            .Some(r) => cond(
              (r.kind == "temp") => {
                return(());
              },
              (r.kind == "macro") => {
                kind = String.from("for-element");
              },
              (r.kind == "local") => {
                kind = String.from("match-local");
                pending_id = Option(usize).Some(r.root_id);
              },
              true => {
                kind = String.from("match-place");
              }
            ),
            .None => ()
          ),
          true => {
            kind = cond(v.is_parameter => String.from("param"), true => String.from("local"));
            pending_id = Option(usize).Some(v.id);
          }
        );
      },
      .None => {
        kind = String.from("unknown");
      }
    );
  });
  text := ast_expr_to_string(source);
  shown_text := cond(
    (text.len() > usize(60)) => `${text.substring(usize(0), usize(57))}...`,
    true => text
  );
  first := match(needs.get(usize(0)), .Some(n) => n, .None => String.new());
  line := `${display_module_path(site_tok.module_path)}:${(site_tok.row + u32(1)).to_string()}:${(site_tok.column + u32(1)).to_string()} [copy-trait] ${first} ${type_to_string(ty).replace(" ", String.from(""))} ${copy_path} source=${kind} needs=${String.from(",").join(needs)} \`${shown_text.replace("\n", String.from(" "))}\``;
  match(
    pending_id,
    .Some(vid) => {
      entry := ImplicitCopyPending(line : line, module_path : site_tok.module_path.clone(), byte_offset : site_tok.byte_offset);
      match(
        g_implicit_copy_pending.get(vid),
        .Some(lst) => lst.push(entry),
        .None => {
          fresh := ArrayList(ImplicitCopyPending).new();
          fresh.push(entry);
          g_implicit_copy_pending.insert(vid, fresh);
        }
      );
    },
    .None => audit_print_implicit_copy(line)
  );
});
// ---------------------------------------------------------------------------
// set_expr_as_needs_to_call_dup  (Phase A: dup-on-store)
// ---------------------------------------------------------------------------
/// Mark `rhs` as needing a `___dup` call to transfer/share RC ownership.
///
/// When an owning RC value is shared (stored into a binding/field, passed to an
/// owned param), this either (a) marks the source temp **consumed** and emits no
/// dup when ownership simply transfers, or (b) builds + evaluates `___dup(name)`,
/// stores it in `rhs`'s `deferred_dup_expressions` (codegen emits it and uses the
/// dup-result temp), and consumes that dup-result temp.
///
/// `Variable`/`ExprInfo` are RC objects, so `consumed_at_token` and
/// `deferred_dup_expressions` are mutated in place (same as
/// `consume_case_body_temp_var`).
/// `exn` is threaded because `generate_expr_from_code` /
/// `evaluate_expression_raw` require an explicit exception handler.
///
/// Side-table: evaluated `___dup` call expr id → the USE SITE's source token
/// (the token of the rhs whose dup it is). The dup expr itself is built from
/// generated code (auto-generated token, not comparable with source tokens); the begin
/// block's dup/drop pair optimizer needs the real source position of the
/// ownership transfer to record an accurate consumed_at_token (early returns
/// AFTER the transfer must not re-drop the moved value).
(g_dup_use_site_tokens : HashMap(usize, Token)) = HashMap(usize, Token).new();
get_dup_use_site_token :: (fn(id : usize) -> Option(Token))(g_dup_use_site_tokens.get(id));
///
set_expr_as_needs_to_call_dup :: (
  fn(
    imm(rhs) : AstExpr,
    imm(ctx) : EvalContext,
    imm(exn) : Exception,
    /// The store kind, for YO_AUDIT_IMPLICIT_COPY only: `binding`, `assign`,
    /// `field-store`, `element`, `param`, `return` or `dyn`.
    (copy_path : str) ?= "dup"
  ) -> unit
)({
  // YO_AUDIT_COPY_TRAIT: a plain-data copy, before any early return (a
  // plain value often has no temp name, and a known value is inlined).
  if(g_audit_copy_trait, {
    match(
      expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs)),
      .Some(ct_info) => audit_record_copy_trait(ast_expr_token(rhs), ct_info.ty, copy_path, ct_info.env, rhs, ctx, true),
      .None => ()
    );
  });
  // `expr.$.variableName` — no ExprInfo or no temp variable name ⇒ nothing to do.
  var_name_opt := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs)),
    .Some(info) => info.variable_name,
    .None => Option(String).None
  );
  match(
    var_name_opt,
    .None => (),
    .Some(variable_name) => {
      // Re-fetch the ExprInfo to mutate (guaranteed Some — the table is
      // unchanged since the var_name lookup above; the .None arm is unreachable).
      ei := match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs)),
        .Some(info) => info,
        .None => new_expr_info_placeholder_for_unreachable_(rhs)
      );
      // A value that is not implicitly copyable (a move-only one, §3.4) is
      // moved here, never dupped.
      if(type_requires_explicit_copy(ei.ty), {
        transfer_explicit_copy_value(rhs, ei, variable_name, ctx, exn);
        return(());
      });
      // --- Compile-time value handling ---
      // Runtime results are `Some(UnknownVal)` — treat UnknownVal as NO
      // value here, or a runtime PARAM
      // bound by create_specialized_function_inline's Some(UnknownVal) rebind
      // early-returns WITHOUT the dup (a non-temp name skips the
      // needs_dup_for_non_owning_rc_temp fallthrough): ArrayList.push's
      // `(*target_ptr) = value` then specialized with NO element retain in
      // exactly those specializations — the stage-2 t1.yo impl-method-registry
      // UAF (one EvalValue push retained, its twin didn't).
      // ...AND the value must be one codegen actually INLINES into C (the
      // gate's premise: "compile-time values are inlined, so no C variable
      // exists for the dup to reference"). A concrete value of an RC-BEARING
      // type (AstExprVal in a def-time trial pass, a comptime StructVal…) is
      // NOT inlinable — codegen falls back to the variable NAME, so the C
      // variable DOES exist and skipping the dup here loses the borrowed-
      // return +1 (every `return(expr)` of a borrowed AstExpr param emitted
      // bare instead of duped — the round-2 stage-2 UAF: the eval-dispatch chain
      // under-counts each evaluated node by one, killing AST children read
      // back later, e.g. evaluate_function_parameter's args.get(1); see
      // issues/fixed/yo-self-dyn-throw-double-drop.md). Def-time trial
      // passes carry concrete values for runtime params, so the gate must
      // also require inlinability.
      has_concrete_value := match(
        ei.value,
        .Some(cv) => (!is_unknown_val(cv) && !type_contains_rc_type(ei.ty)),
        .None => false
      );
      if(has_concrete_value, {
        (needs_dup_for_non_owning_rc_temp : bool) = false;
        if(is_temp_variable_name(ei.env.module_path, variable_name) && type_contains_rc_type(ei.ty), {
          match(
            find_variable_in_env(ei.env, variable_name),
            .Some(v) => {
              if(v.is_owning_the_rc_value && v.consumed_at_token.is_none(), {
                v.consumed_at_token = Option(Rc(Token)).Some(rc(ast_expr_token(rhs)));
              });
              // Non-owning RC temp (e.g. index-trait result): codegen does not
              // dup inline for these, so fall through to generate the dup.
              if(!v.is_owning_the_rc_value, {
                needs_dup_for_non_owning_rc_temp = true;
              });
            },
            .None => ()
          );
        });
        if(!needs_dup_for_non_owning_rc_temp, {
          return(());
        });
      });
      // --- Only RC-bearing types need dup/consume. ---
      if(!type_contains_rc_type(ei.ty), {
        return(());
      });
      // Owning temp already holding the value: ownership transfers ⇒ consume, no dup.
      if(is_temp_variable_name(ei.env.module_path, variable_name), {
        is_atom_with_other_name := (ast_expr_is_atom(rhs) && (ast_expr_token(rhs).value != variable_name));
        if(!is_atom_with_other_name, {
          match(
            find_variable_in_env(ei.env, variable_name),
            .Some(v) => {
              if(v.is_owning_the_rc_value, {
                if(v.consumed_at_token.is_none(), {
                  v.consumed_at_token = Option(Rc(Token)).Some(rc(ast_expr_token(rhs)));
                });
                return(());
              });
            },
            .None => ()
          );
        });
      });
      // --- Copy semantics: build + evaluate `___dup(variableName)`. ---
      if(g_audit_implicit_copy, {
        audit_record_implicit_copy(ast_expr_token(rhs), ei.ty, copy_path, ei.env, variable_name.clone(), ast_expr_to_string(rhs), ctx, true);
      });
      dup_expr := generate_expr_from_code(`${BF_DUP}(${variable_name})`, exn);
      saved_expected := ctx.expected_type;
      ctx.expected_type = .None;
      // Evaluate in a PRIVATE copy of the recorded scope: a recorded snapshot is
      // shared between ExprInfos, and a begin/match inside `dup_expr` pops frames.
      evaluated_dup := evaluate_expression_raw(dup_expr, expr_info_adopt_env(ei), ctx, exn);
      ctx.expected_type = saved_expected;
      // Consume the dup-result temp so it is not dropped separately later. The
      // dup temp was added in-place to `ei.env`'s current frame during eval.
      dup_var_name_opt := match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_dup)),
        .Some(di) => di.variable_name,
        .None => Option(String).None
      );
      match(
        dup_var_name_opt,
        .None => (),
        .Some(dvn) => {
          dvars := get_variables_from_env(ei.env, dvn);
          if(dvars.len() > usize(0), {
            dv := match(dvars.last(), .Some(x) => x, .None => make_err_variable(ei.env));
            if(dv.consumed_at_token.is_none(), {
              dv.consumed_at_token = Option(Rc(Token)).Some(rc(ast_expr_token(evaluated_dup)));
            });
          });
        }
      );
      // Stamp the USE SITE's source token for the dup/drop pair optimizer.
      g_dup_use_site_tokens.insert(ast_expr_id(evaluated_dup), ast_expr_token(rhs));
      // Stash the deferred dup expression on the rhs's ExprInfo (codegen emits it).
      dup_list := ArrayList(AstExpr).new();
      dup_list.push(evaluated_dup);
      expr_info_set_deferred_dup_expressions(ei, Option(ArrayList(AstExpr)).Some(dup_list));
      // Propagate the dup call's env onto the rhs's ExprInfo. The dup
      // eval added the `___dup` temp to that env; the deferred-dup codegen in
      // begin/match resolves the dup temp's C name via the rhs ExprInfo's env,
      // so without this the temp is unresolved and the balancing incr is
      // silently dropped (over-release of a borrowed match-arm return — e.g.
      // `func_expr := match(expr, .FnCall(_, fb,…) => fb)` in
      // evaluate_function_call, the stage-2 specialized-body UAF).
      match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_dup)),
        .Some(dup_ei) => {
          ei.env = expr_info_adopt_env(dup_ei);
        },
        .None => ()
      );
    }
  );
});
/// Aliasing Stage 0 (issues/fixed/borrowed-arg-invalidated-by-aliased-container-mutation.md):
/// dup an RC-typed PROJECTION argument passed to a BORROWING parameter,
/// keeping the +1 in the CALLER.
///
/// Unlike `set_expr_as_needs_to_call_dup` above (the own-param path, whose
/// dup RESULT temp is consumed because the callee drops the transferred +1),
/// the dup result here is left OWNING and UNCONSUMED so the caller's normal
/// scope-end drop is the balancing -1, and the SOURCE binding is never
/// consumed (a borrow stays usable). No-ops when the argument's temp already
/// OWNS its value (alive to scope end regardless — no aliasing hole) or when
/// the value is a codegen-inlinable comptime constant (no RC traffic).
set_expr_as_needs_to_call_dup_for_borrowed_projection :: (
  fn(
    imm(rhs) : AstExpr,
    imm(ctx) : EvalContext,
    imm(exn) : Exception,
    /// Dup even when the argument's variable OWNS its value: the same call
    /// passes that variable `inout`, so the callee can replace the value the
    /// argument borrows (`argument_is_aliased_by_inout`, calls/helper.yo).
    (force : bool) ?= false
  ) -> Option(AstExpr)
)({
  var_name_opt := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs)),
    .Some(info) => info.variable_name,
    .None => Option(String).None
  );
  (s0_result : Option(AstExpr)) = Option(AstExpr).None;
  match(
    var_name_opt,
    .None => (),
    .Some(variable_name) => {
      ei := match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(rhs)),
        .Some(info) => info,
        .None => new_expr_info_placeholder_for_unreachable_(rhs)
      );
      // Same concrete-value inlinability gate as set_expr_as_needs_to_call_dup:
      // only a value codegen actually INLINES has no C variable to dup.
      has_concrete_value := match(
        ei.value,
        .Some(cv) => (!is_unknown_val(cv) && !type_contains_rc_type(ei.ty)),
        .None => false
      );
      if(has_concrete_value, {
        return(Option(AstExpr).None);
      });
      if(!type_contains_rc_type(ei.ty), {
        return(Option(AstExpr).None);
      });
      match(
        find_variable_in_env(ei.env, variable_name),
        .None => (),
        .Some(v) => {
          if(v.is_owning_the_rc_value && !force, {
            return(Option(AstExpr).None);
          });
          // SYNTHESIZE the evaluated dup form instead of evaluating it.
          // Evaluating a fresh `___dup(...)` expression from INSIDE a
          // derive/quote-generated body's def-time eval corrupts the
          // enclosing module evaluation through shared state (no throw —
          // bisected in issues/yo-self-dup-eval-inside-macro-generated-body-
          // corrupts-module-eval.md). A dup of a KNOWN temp needs no general
          // evaluation: mint the result temp OWNING in the rhs env (its
          // scope-end drop is the balancing -1; the pair optimizer cannot
          // cancel dup-of-SOURCE against drop-of-RESULT), and stamp the dup
          // node + its arg atom with the ExprInfo codegen's deferred-dup
          // emitter reads (dei.variable_name / target atom env); the
          // nested eval is unsound in def-time contexts.
          dup_expr := generate_expr_from_code(`${BF_DUP}(${variable_name})`, exn);
          // Phase 2: no source position exists for the synthesized dup — key
          // the occurrence by module + the variable being duped.
          dup_temp := generate_new_temp_variable_name(
            ei.env.module_path,
            usize(0),
            usize(0),
            .Some(`dup:${variable_name}`)
          );
          reg_var := add_variable_to_begin_block_frame(
            ei.env,
            dup_temp.clone(),
            ei.ty,
            Option(EvalValue).None,
            false,
            true,
            ast_expr_token(rhs)
          );
          // CONSUME the dup temp immediately: the balancing -1 is the
          // EXPLICIT `___drop` returned below, attached by the caller to the
          // CALL node's deferred drops (single post-call emission). Leaving
          // the temp unconsumed-owning lets the multi-exit cleanup
          // machinery (match-arm exits + escape paths + scope end) emit its
          // drop on NON-exclusive paths — the stage-2 binary over-released
          // context.base and corrupted the whole emit (FIXPOINT_BROKEN,
          // recycled-name garbage; gmalloc-traced to dup-for-value's enum
          // arm).
          match(
            reg_var,
            .Some(rv) => {
              rv.consumed_at_token = Option(Rc(Token)).Some(rc(ast_expr_token(rhs)));
            },
            .None => ()
          );
          dup_info := new_expr_info(ei.env, ei.ty);
          dup_info.variable_name = Option(String).Some(dup_temp.clone());
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(dup_expr), dup_info);
          match(
            dup_expr,
            .FnCall(_, _, dd_args, _, _) => match(
              dd_args.get(usize(0)),
              .Some(dd_atom) => {
                dd_atom_info := new_expr_info(ei.env, ei.ty);
                dd_atom_info.variable_name = Option(String).Some(variable_name.clone());
                expr_info_table_set(ctx.expr_info_table, ast_expr_id(dd_atom), dd_atom_info);
              },
              .None => ()
            ),
            .Atom(_, _) => ()
          );
          g_dup_use_site_tokens.insert(ast_expr_id(dup_expr), ast_expr_token(rhs));
          dup_list := ArrayList(AstExpr).new();
          dup_list.push(dup_expr);
          expr_info_set_deferred_dup_expressions(ei, Option(ArrayList(AstExpr)).Some(dup_list));
          // Synthesize the balancing `___drop(dup_temp)` for the CALLER to
          // attach to the call node's deferred drops.
          s0_drop_expr := generate_expr_from_code(`${BF_DROP}(${dup_temp})`, exn);
          s0_drop_info := new_expr_info(ei.env, ei.ty);
          expr_info_table_set(ctx.expr_info_table, ast_expr_id(s0_drop_expr), s0_drop_info);
          match(
            s0_drop_expr,
            .FnCall(_, _, sd_args, _, _) => match(
              sd_args.get(usize(0)),
              .Some(sd_atom) => {
                sd_atom_info := new_expr_info(ei.env, ei.ty);
                sd_atom_info.variable_name = Option(String).Some(dup_temp.clone());
                expr_info_table_set(ctx.expr_info_table, ast_expr_id(sd_atom), sd_atom_info);
              },
              .None => ()
            ),
            .Atom(_, _) => ()
          );
          s0_result = Option(AstExpr).Some(s0_drop_expr);
          // NOTE: deliberately NOT propagating the dup eval's env onto the
          // rhs ExprInfo (unlike set_expr_as_needs_to_call_dup above). The
          // dup temp was added IN PLACE to ei.env's current frame, so the
          // rhs env already resolves it — and REPLACING ei.env here leaked a
          // def-time BODY env into the enclosing statement flow: the
          // evaluator threads env through statement infos, so a module-level derive's
          // generated-body eval replaced the MODULE env mid-module
          // ("Variable Tok not found" on the impl FOLLOWING derive(Eq) of a
          // String-field ref struct — the tok_i minimal repro).
        }
      );
    }
  );
  s0_result
});
/// Aliasing Stage 0 predicate: a bare field-access chain (`w.b`, `a.b.c`)
/// rooted at a RUNTIME variable — a PROJECTION place. A bare atom is NOT a
/// projection (the caller's binding keeps a plain local alive for the call,
/// +0). A method call (`x.f()`) is not a 2-arg dot call — its `func` is the
/// dot — and produces an owned temp anyway.
/// True when walking `e`'s dot chain reaches an ATOM bound to a RUNTIME
/// variable — the root of a place expression. Shared by the field and index
/// forms of `arg_is_rc_projection_place`.
_place_root_is_runtime_variable :: (fn(imm(e) : AstExpr, imm(env) : Environment) -> bool)({
  (root : AstExpr) = e;
  while(ast_expr_is_fn_call_of(root, BF_DOT, Option(usize).Some(usize(2))), {
    r_args := match(root, .FnCall(_, _, __prv_ra, _, _) => __prv_ra, .Atom(_, _) => ArrayList(AstExpr).new());
    r_a1 := match(r_args.get(usize(1)), .Some(x) => x, .None => return(false));
    if(!ast_expr_is_atom(r_a1), {
      return(false);
    });
    root = match(r_args.get(usize(0)), .Some(x) => x, .None => return(false));
  });
  if(!ast_expr_is_atom(root), {
    return(false);
  });
  vars := get_variables_from_env(env, ast_expr_token(root).value);
  if(vars.len() == usize(0), {
    return(false);
  });
  match(
    vars.last(),
    .Some(v) => !v.is_compile_time_only,
    .None => false
  )
});
arg_is_rc_projection_place :: (fn(imm(e) : AstExpr, imm(env) : Environment) -> bool)({
  // INDEX projection: `arr(i)`, `w.items(i)`. An element read is a view into
  // container storage exactly as a field read is, and a callee can release it
  // the same way — a callee replacing the container in a loop freed the
  // borrowed box and the caller read the recycled allocation. Requiring a
  // 2-arg dot missed every one of these. Widening is safe by construction:
  // the marker no-ops when the argument's temp already OWNS its value.
  if(!ast_expr_is_fn_call_of(e, BF_DOT, Option(usize).Some(usize(2))), {
    if(ast_expr_is_atom(e), {
      return(false);
    });
    e_func := match(e, .FnCall(_, __aipp_f, _, _, _) => __aipp_f, .Atom(_, _) => return(false));
    return(_place_root_is_runtime_variable(e_func, env));
  });
  e_args := match(e, .FnCall(_, _, __aipp_a, _, _) => __aipp_a, .Atom(_, _) => ArrayList(AstExpr).new());
  e_a1 := match(e_args.get(usize(1)), .Some(x) => x, .None => return(false));
  if(!ast_expr_is_atom(e_a1), {
    return(false);
  });
  (root : AstExpr) = match(e_args.get(usize(0)), .Some(x) => x, .None => return(false));
  while(ast_expr_is_fn_call_of(root, BF_DOT, Option(usize).Some(usize(2))), {
    r_args := match(root, .FnCall(_, _, __aipp_ra, _, _) => __aipp_ra, .Atom(_, _) => ArrayList(AstExpr).new());
    r_a1 := match(r_args.get(usize(1)), .Some(x) => x, .None => return(false));
    if(!ast_expr_is_atom(r_a1), {
      return(false);
    });
    root = match(r_args.get(usize(0)), .Some(x) => x, .None => return(false));
  });
  if(!ast_expr_is_atom(root), {
    return(false);
  });
  vars := get_variables_from_env(env, ast_expr_token(root).value);
  if(vars.len() == usize(0), {
    return(false);
  });
  v := match(vars.last(), .Some(x) => x, .None => return(false));
  !v.is_compile_time_only
});
// ---------------------------------------------------------------------------
// doc_comment_lookup_key_from_token
// ---------------------------------------------------------------------------
/// Build the doc-comment lookup key for a token.
///
/// Matches the format produced by `get_doc_comment_lookup_key` in
/// `doc/extractor.yo`: `"<module_path>:<row>:<column>"`.
doc_comment_lookup_key_from_token :: (fn(imm(tok) : Token) -> String)(
  `${tok.module_path}:${tok.row.to_string()}:${tok.column.to_string()}`
);
// ---------------------------------------------------------------------------
// consume_case_body_temp_var
// ---------------------------------------------------------------------------
/// Mark the temporary variable bound by `evaluated_body`'s ExprInfo as
/// consumed at the expression's token.  Only acts if the variable name was
/// generated by `generate_new_temp_variable_name` (i.e. is a temp name).
///
/// The `Variable` is an RC object, so `consumed_at_token` is mutated in-place.
consume_case_body_temp_var :: (
  fn(
    imm(evaluated_body) : AstExpr,
    imm(env) : Environment,
    imm(ctx) : EvalContext
  ) -> unit
)({
  var_name_opt := match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(evaluated_body)),
    .Some(info) => info.variable_name,
    .None => Option(String).None
  );
  match(
    var_name_opt,
    .None => (),
    .Some(var_name) => {
      if(!is_temp_variable_name(env.module_path, var_name), {
        return(());
      });
      vars := get_variables_from_env(env, var_name);
      if(vars.len() == usize(0), {
        return(());
      });
      v := match(vars.last(), .Some(x) => x, .None => make_err_variable(env));
      if(v.consumed_at_token.is_none(), {
        // Variable is an RC object; mutation is in-place and visible through env.
        v.consumed_at_token = Option(Rc(Token)).Some(rc(ast_expr_token(evaluated_body)));
      });
    }
  );
});
// ---------------------------------------------------------------------------
// merge_and_check_envs  (Phase 3 implementation)
// ---------------------------------------------------------------------------
/// Reconcile variable states across multiple cond/match branch environments.
///
/// For each variable in the base env:
/// - Adopts temp variables that leaked from case bodies into a shared frame.
/// - Propagates `initialized_at_token` when all cases initialize it.
/// - Propagates `consumed_at_token` when all cases consume it.
/// - Propagates `is_owning_the_rc_value` when all cases own it.
/// - Generates a fresh variable ID when any branch reassigns the variable.
/// - Throws a compile-time error if branches partially consume/initialize or
///   if frame layouts are inconsistent.
///
/// `Variable` is an RC reference; mutations propagate
/// automatically to all holders. `update_existing_variable` is used for
/// the is_owning_the_rc_value update (since it also zeros out is_owning_the_same_rc_value_as).
/// Before a `cond`/`match` arm: every variable a completed SIBLING arm
/// initialized or moved is back in its state from before the branch.
/// `Variable` is one shared object per binding, so the sibling's events
/// stamped it for every arm: a later arm could read a variable only a sibling
/// initialized, or be told a value was moved when only a sibling moved it, and
/// the join could not tell which arms did what
/// (issues/fixed/cond-arm-initialization-merge-check-never-fires.md).
///
/// A move the previous arm made is undone here for the arms after it, but a
/// cleanup point inside that arm (an early `return`, an effect escape) still
/// runs after it: the move is kept as an `UndoneMove` up to the arm's last
/// token (`prev_arm`), which codegen consults
/// (issues/fixed/a-move-in-a-returning-arm-is-released-again-at-the-return.md).
reset_sibling_flow_state :: (fn(imm(env) : Environment, imm(prev_arm) : Option(AstExpr)) -> unit)({
  recs := sibling_first_flow_records();
  if(recs.len() == usize(0), {
    return(());
  });
  (ri : usize) = usize(0);
  while(ri < recs.len(), {
    match(
      recs.get(ri),
      .Some(r) => match(
        find_variable_by_id(env, r.var_id),
        .Some(v) => {
          match(prev_arm, .Some(pa) => _keep_undone_move(v, r.before_consumed, pa), .None => ());
          v.initialized_at_token = r.before_init;
          v.consumed_at_token = match(r.before_consumed, .Some(bc) => Option(Rc(Token)).Some(rc(bc)), .None => Option(Rc(Token)).None);
        },
        .None => ()
      ),
      .None => ()
    );
    ri = (ri + usize(1));
  });
});
/// Does a `match` arm pattern anywhere in `e` bind `name`?
_pattern_binds_name :: (fn(imm(e) : AstExpr, imm(name) : String) -> bool)(
  match(
    e,
    .FnCall(_, callee, args, _, _) => {
      is_match := ast_expr_is_fn_call_of(e, BK_MATCH, Option(usize).None);
      (i : usize) = usize(0);
      while(i < args.len(), {
        match(
          args.get(i),
          .Some(a) => {
            if(is_match && (i > usize(0)) && ast_expr_is_fn_call_of(a, "=>", Option(usize).None), {
              match(
                a,
                .FnCall(_, _, arm_args, _, _) => match(
                  arm_args.get(usize(0)),
                  .Some(pat) => if(_atom_named_in(pat, name.clone()), {
                    return(true);
                  }),
                  .None => ()
                ),
                .Atom(_, _) => ()
              );
            });
            if(recur(a, name.clone()), {
              return(true);
            });
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      recur(callee, name)
    },
    .Atom(_, _) => false
  )
);
/// Is there an identifier atom spelled `name` anywhere in `e`?
_atom_named_in :: (fn(imm(e) : AstExpr, imm(name) : String) -> bool)(
  match(
    e,
    .Atom(_, tok) => (tok.value == name),
    .FnCall(_, callee, args, _, _) => {
      if(recur(callee, name.clone()), {
        return(true);
      });
      (i : usize) = usize(0);
      while(i < args.len(), {
        match(
          args.get(i),
          .Some(a) => if(recur(a, name.clone()), {
            return(true);
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      false
    }
  )
);
/// The earliest token of `e`'s own source: the start of an arm.
_first_token_of :: (fn(imm(e) : AstExpr, imm(root) : Token) -> Token)({
  (best : Token) = root;
  tok := ast_expr_token(e);
  if((tok.module_path == root.module_path) && (tok.character < best.character), {
    best = tok;
  });
  match(
    e,
    .FnCall(_, callee, args, _, _) => {
      c := recur(callee, root);
      if((c.module_path == root.module_path) && (c.character < best.character), {
        best = c;
      });
      (i : usize) = usize(0);
      while(i < args.len(), {
        match(
          args.get(i),
          .Some(a) => {
            t := recur(a, root);
            if((t.module_path == root.module_path) && (t.character < best.character), {
              best = t;
            });
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .Atom(_, _) => ()
  );
  best
});
/// The latest token of `e`'s own source: the end of an arm.
_last_token_of :: (fn(imm(e) : AstExpr, imm(root) : Token) -> Token)({
  (best : Token) = root;
  tok := ast_expr_token(e);
  if((tok.module_path == root.module_path) && (tok.character > best.character), {
    best = tok;
  });
  match(
    e,
    .FnCall(_, callee, args, _, _) => {
      c := recur(callee, root);
      if((c.module_path == root.module_path) && (c.character > best.character), {
        best = c;
      });
      (i : usize) = usize(0);
      while(i < args.len(), {
        match(
          args.get(i),
          .Some(a) => {
            t := recur(a, root);
            if((t.module_path == root.module_path) && (t.character > best.character), {
              best = t;
            });
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .Atom(_, _) => ()
  );
  best
});
/// Keep the move `v` has now, made by the arm `arm`, when the flow log
/// undoes it back to `before`: codegen's cleanup points inside `arm` still
/// see it (see `reset_sibling_flow_state`).
_keep_undone_move :: (fn(imm(v) : Variable, imm(before) : Option(Token), imm(arm) : AstExpr) -> unit)(
  match(
    v.consumed_at_token,
    .Some(ct) => {
      same := match(before, .Some(b) => ((b.module_path == ct.*.module_path) && (b.character == ct.*.character)), .None => false);
      if(!same, {
        variable_record_undone_move(v, UndoneMove(moved_at : ct.*.clone(), until : _last_token_of(arm, ct.*), inclusive : true));
      });
    },
    .None => ()
  )
);
/// After the last arm of a `cond`/`match`, before the join: keep the moves
/// that arm made. The join restores the state from the arms that reach it,
/// and a diverging last arm is not one of them.
keep_last_arm_moves :: (fn(imm(env) : Environment, imm(last_arm) : AstExpr, group_log_start : usize) -> unit)({
  recs := first_flow_records_in(group_log_start, branch_init_log_len());
  (ri : usize) = usize(0);
  while(ri < recs.len(), {
    match(
      recs.get(ri),
      .Some(r) => match(
        find_variable_by_id(env, r.var_id),
        .Some(v) => _keep_undone_move(v, r.before_consumed, last_arm),
        .None => ()
      ),
      .None => ()
    );
    ri = (ri + usize(1));
  });
});
/// At a `break` or `continue`: the move state of every variable declared
/// outside the loop that the body has touched so far (per path: the arm the
/// jump sits in starts from the state before its branch).
snapshot_loop_flow :: (fn(imm(lc) : LoopBodyCtx, mut(into) : ArrayList(LoopFlowSnapshot), imm(env) : Environment, imm(site) : Token) -> unit)({
  ids := ArrayList(usize).new();
  states := ArrayList(Option(Token)).new();
  recs := first_flow_records_in(lc.log_start, branch_init_log_len());
  (ri : usize) = usize(0);
  while(ri < recs.len(), {
    match(
      recs.get(ri),
      .Some(r) => match(
        find_variable_by_id(env, r.var_id),
        .Some(v) => if(v.frame_level < lc.entry_frame_count, {
          ids.push(v.id);
          states.push(match(v.consumed_at_token, .Some(ct) => Option(Token).Some(ct.*), .None => Option(Token).None));
        }),
        .None => ()
      ),
      .None => ()
    );
    ri = (ri + usize(1));
  });
  into.push(LoopFlowSnapshot(site : site, var_ids : ids, consumed : states));
});
/// A variable's move state at a `break`/`continue` snapshot (`pre` when the
/// body had not touched it yet there).
_snapshot_state_of :: (fn(imm(snap) : LoopFlowSnapshot, id : usize, imm(pre) : Option(Token)) -> Option(Token))({
  (si : usize) = usize(0);
  while(si < snap.var_ids.len(), {
    if(match(snap.var_ids.get(si), .Some(x) => (x == id), .None => false), {
      return(match(snap.consumed.get(si), .Some(c) => c, .None => pre));
    });
    si = (si + usize(1));
  });
  pre
});
/// The move-state rules of a loop, for every variable declared outside it
/// that the body moved or assigned (plans/TYPE_SYSTEM_SOUNDNESS.md Phase 5.1,
/// issues/fixed/moving-a-variable-inside-a-loop-body-is-not-rejected.md):
///
/// - Every way back to the condition (the end of the body when it can
///   complete, each `continue`) must leave a value that was live at loop entry
///   live: the next iteration reads it (E0901).
/// - Every way out (the condition turning false, when it is not
///   compile-time `true`, and each `break`) must agree on whether the value is
///   moved: its drop after the loop is decided statically (E0907).
///
/// Afterwards the variable is in the state the ways out agree on, and a join
/// record gives an enclosing branch or loop the loop's net effect.
check_loop_flow :: (
  fn(imm(lc) : LoopBodyCtx, body_completes : bool, has_normal_exit : bool, imm(env) : Environment, imm(exn) : Exception) -> unit
)({
  recs := first_flow_records_in(lc.log_start, branch_init_log_len());
  (ri : usize) = usize(0);
  while(ri < recs.len(), {
    match(
      recs.get(ri),
      .Some(r) => match(
        find_variable_by_id(env, r.var_id),
        .Some(v) => if(v.frame_level < lc.entry_frame_count, {
          pre := r.before_consumed;
          body_end := match(v.consumed_at_token, .Some(ct) => Option(Token).Some(ct.*), .None => Option(Token).None);
          // Back edges.
          back_moved := ArrayList(Token).new();
          back_live := ArrayList(Token).new();
          if(body_completes, {
            match(body_end, .Some(t) => back_moved.push(t), .None => back_live.push(v.token));
          });
          (ci : usize) = usize(0);
          while(ci < lc.continue_states.len(), {
            match(
              lc.continue_states.get(ci),
              .Some(cs) => match(_snapshot_state_of(cs, v.id, pre), .Some(t) => back_moved.push(t), .None => back_live.push(cs.site)),
              .None => ()
            );
            ci = (ci + usize(1));
          });
          if(pre.is_none() && (back_moved.len() > usize(0)) && !migrate_borrowed_match_at(match(back_moved.get(usize(0)), .Some(t) => t, .None => v.token)), {
            mv_tok := match(back_moved.get(usize(0)), .Some(t) => t, .None => v.token);
            entries := ArrayList(TokenAndError).new();
            entries.push(
              TokenAndError(
                token : mv_tok,
                error_message : `use of moved value: \`${v.name}\` is moved inside the loop, and the next iteration uses it again. Move it only on a path that leaves the loop, or give it a new value before the iteration ends.`
              )
            );
            entries.push(TokenAndError(token : v.token, error_message : String.from("declared outside the loop here")));
            exn.throw(dyn(with_code(format_error_messages_with_help(entries, moved_value_help(v.name, v.ty, mv_tok)), E_USE_OF_MOVED_VALUE)));
          });
          // Ways out.
          exit_moved := ArrayList(Token).new();
          exit_live := ArrayList(Token).new();
          if(has_normal_exit, {
            // The condition reads the state an iteration left: the state at
            // entry, or one a back edge left (the same, when it was live; a
            // value moved before the loop and given a new value inside is
            // moved or not depending on the iteration count).
            match(pre, .Some(t) => exit_moved.push(t), .None => exit_live.push(v.token));
            if(pre.is_some() && (back_live.len() > usize(0)), {
              exit_live.push(match(back_live.get(usize(0)), .Some(t) => t, .None => v.token));
            });
          });
          (bi : usize) = usize(0);
          while(bi < lc.break_states.len(), {
            match(
              lc.break_states.get(bi),
              .Some(bs) => match(_snapshot_state_of(bs, v.id, pre), .Some(t) => exit_moved.push(t), .None => exit_live.push(bs.site)),
              .None => ()
            );
            bi = (bi + usize(1));
          });
          // Only a value with a drop is at stake: without drop flags its drop
          // after the loop cannot be decided. A value with nothing to drop is
          // simply moved after the loop (a later use is E0901).
          if((exit_moved.len() > usize(0)) && (exit_live.len() > usize(0)) && type_contains_rc_type(v.ty) && !migrate_borrowed_match_at(match(exit_moved.get(usize(0)), .Some(t) => t, .None => v.token)), {
            entries2 := ArrayList(TokenAndError).new();
            entries2.push(
              TokenAndError(
                token : match(exit_moved.get(usize(0)), .Some(t) => t, .None => v.token),
                error_message : `Variable "${v.name}" is moved on some ways out of the loop but not on others, so after the loop it would be dropped on some paths only. Moved here:`
              )
            );
            entries2.push(TokenAndError(token : match(exit_live.get(usize(0)), .Some(t) => t, .None => v.token), error_message : String.from("Not moved on the way out here:")));
            exn.throw(dyn(with_code(format_error_messages(entries2), E_MOVED_ON_SOME_PATHS)));
          });
          final := match(exit_moved.get(usize(0)), .Some(t) => Option(Token).Some(t), .None => Option(Token).None);
          if((exit_moved.len() > usize(0)) || (exit_live.len() > usize(0)), {
            v.consumed_at_token = match(final, .Some(ft) => Option(Rc(Token)).Some(rc(ft)), .None => Option(Rc(Token)).None);
          });
          record_flow_event(v.id, TypeValue.Unit, Option(TypeValue).None, FlowEventKind.Join, v.token, r.before_init, pre, v.initialized_at_token, match(v.consumed_at_token, .Some(jc) => Option(Token).Some(jc.*), .None => Option(Token).None));
        }),
        .None => ()
      ),
      .None => ()
    );
    ri = (ri + usize(1));
  });
});
/// The variable with id `id` in `env`, innermost frame first.
find_variable_by_id :: (fn(imm(env) : Environment, id : usize) -> Option(Variable))({
  (fi : usize) = env.frames.len();
  while(fi > usize(0), {
    fi = (fi - usize(1));
    match(
      env.frames.get(fi),
      .Some(frame) => {
        (vi : usize) = frame.variables.len();
        while(vi > usize(0), {
          vi = (vi - usize(1));
          match(
            frame.variables.get(vi),
            .Some(v) => if(v.id == id, {
              return(Option(Variable).Some(v));
            }),
            .None => ()
          );
        });
      },
      .None => ()
    );
  });
  Option(Variable).None
});
/// The first `.Some` token in `toks`.
_first_some_token :: (fn(imm(toks) : ArrayList(Option(Token))) -> Option(Token))({
  (i : usize) = usize(0);
  while(i < toks.len(), {
    match(
      toks.get(i),
      .Some(.Some(t)) => {
        return(Option(Token).Some(t));
      },
      _ => ()
    );
    i = (i + usize(1));
  });
  Option(Token).None
});
/// A value moved in some arms of a `cond`/`match` and kept in others: attach
/// `___drop(name)` to the end of each arm that keeps it (the arm body's
/// deferred drops, which codegen emits inside the arm, after its value).
/// Where the arms meet, the value is then moved or dropped on every path, so
/// the caller marks it consumed. True when the drops are attached, or when
/// the binding owns nothing to drop. False leaves the caller's E0907: a
/// module-level value, or one whose type is not known enough to drop.
_drop_in_arms_that_keep :: (
  fn(
    imm(v) : Variable,
    imm(bodies) : ArrayList(AstExpr),
    imm(consumed_at_tokens) : ArrayList(Option(Token)),
    imm(env) : Environment,
    imm(ctx) : EvalContext,
    imm(exn) : Exception,
    (imm(branch_expr) : Option(AstExpr)) ?= Option(AstExpr).None
  ) -> bool
)({
  if(v.is_module_level, {
    return(false);
  });
  // The drop names the value, so a `match` pattern in the branch that binds
  // the same name (`.Some(x)`) would make the drop release that binding
  // instead: keep E0907 there.
  if(match(branch_expr, .Some(be) => _pattern_binds_name(be, v.name.clone()), .None => false), {
    return(false);
  });
  // A binding that owns nothing (a `match`/`for` binding, a `mut` place)
  // has nothing of its own to drop: what its move consumed is its holder,
  // whose own join drops it in the arms that keep it.
  if(!v.is_owning_the_rc_value || v.is_ref || !type_contains_rc_type(v.ty), {
    return(true);
  });
  if(match(
    v.ty,
    .SomeT({ required_trait_types : s_rtt, resolution : s_rc }) => (s_rc.is_none() && (s_rtt.len() == usize(0))),
    _ => false
  ), {
    return(false);
  });
  // The drop names the value, so an arm that binds the same name (a
  // `.Some(x)` pattern) would drop its own binding instead: keep E0907 there.
  (si : usize) = usize(0);
  while(si < bodies.len(), {
    keeps_s := match(consumed_at_tokens.get(si), .Some(.Some(_)) => false, _ => true);
    if(keeps_s, {
      match(
        bodies.get(si),
        .Some(sb) => match(
          expr_info_table_get(ctx.expr_info_table, ast_expr_id(sb)),
          .Some(sbi) => {
            same_name := get_variables_from_env(sbi.env, v.name.clone());
            (sni : usize) = usize(0);
            while(sni < same_name.len(), {
              match(
                same_name.get(sni),
                .Some(sv) => if(sv.id != v.id, {
                  return(false);
                }),
                .None => ()
              );
              sni = (sni + usize(1));
            });
          },
          .None => ()
        ),
        .None => ()
      );
    });
    si = (si + usize(1));
  });
  // The drop is evaluated with the value still owned, as the scope-end drop
  // of an unmoved local is; the join marks it moved afterwards.
  saved_consumed := v.consumed_at_token;
  v.consumed_at_token = Option(Rc(Token)).None;
  (i : usize) = usize(0);
  while(i < bodies.len(), {
    keeps := match(consumed_at_tokens.get(i), .Some(.Some(_)) => false, _ => true);
    if(keeps, {
      match(
        bodies.get(i),
        .Some(body) => match(
          expr_info_table_get(ctx.expr_info_table, ast_expr_id(body)),
          .Some(bi) => {
            drop_expr := generate_expr_from_code(`${BF_DROP}(${v.name})`, exn);
            evaluated := evaluate_expression_raw(drop_expr, env, ctx, exn);
            v.consumed_at_token = Option(Rc(Token)).None;
            drops := match(bi.deferred_drop_expressions, .Some(l) => l, .None => ArrayList(AstExpr).new());
            drops.push(evaluated);
            bi.deferred_drop_expressions = Option(ArrayList(AstExpr)).Some(drops);
            // A `return` inside this arm already emits the arm's deferred
            // drops (they ride the pending list codegen keeps for the arm),
            // so the early-return pass must not add a second drop there:
            // record the arm as a window in which the value counts as gone.
            arm_tok := ast_expr_token(body);
            variable_record_undone_move(v, UndoneMove(moved_at : _first_token_of(body, arm_tok), until : _last_token_of(body, arm_tok), inclusive : true, arm_drop : true));
          },
          .None => ()
        ),
        .None => ()
      );
    });
    i = (i + usize(1));
  });
  v.consumed_at_token = saved_consumed;
  true
});
/// The closure an arm yields, as its capture struct: a closure literal's
/// `capture_type`, or the resolution of a bound closure identity (a local
/// declared `(f : Impl(Fn...)) = closure`).
_arm_closure_capture_struct :: (fn(imm(info) : ExprInfo) -> Option(TypeValue))(
  match(
    expr_info_capture_type(info),
    .Some(cap) => Option(TypeValue).Some(cap),
    .None => cond(
      is_bound_closure_identity(info.ty) => Option(TypeValue).Some(resolve_cell_chain(info.ty)),
      is_closure_capture_struct(info.ty) => Option(TypeValue).Some(info.ty),
      true => Option(TypeValue).None
    )
  )
);
/// Impl(...) RESULT rule for a `cond`/`match` join: arms yielding DIFFERENT
/// closures cannot unify into one value (static dispatch —
/// `(c : Impl(Fn...)) = cond(a => closureA, b => closureB)` is rejected, and so
/// is a function whose `Impl(Fn)` result is such a join). `bodies` are the
/// arms that reach the join.
reject_mixed_closure_arms :: (
  fn(
    imm(bodies) : ArrayList(AstExpr),
    imm(ctx) : EvalContext,
    imm(exn) : Exception
  ) -> unit
)({
  (first_id : String) = String.new();
  (i : usize) = usize(0);
  while(i < bodies.len(), {
    match(
      bodies.get(i),
      .Some(body) => match(
        expr_info_table_get(ctx.expr_info_table, ast_expr_id(body)),
        .Some(info) => match(
          _arm_closure_capture_struct(info),
          .Some(.Struct({ id : cid })) => if(cid.len() > usize(0), {
            if(first_id.len() == usize(0), {
              first_id = cid;
            }, if(cid != first_id, {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(body),
                    String.from("Branches produce different concrete closure types for an Impl(...) result. Impl(...) uses static dispatch and requires the same concrete type across branches. Consider using Dyn(...) for dynamic dispatch if different concrete types are needed.")
                  )
                )
              );
            }));
          }),
          _ => ()
        ),
        .None => ()
      ),
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// Join the arms of a `cond`/`match` into `env`. `bodies` are the arms that
/// reach the join; `group_log_start` is the flow log's length when the
/// branch began (its arms' records follow it); `arm_ranges` holds each
/// evaluated arm's window into the log (`push_arm_init_range`).
merge_and_check_envs :: (
  fn(
    imm(env) : Environment,
    imm(bodies) : ArrayList(AstExpr),
    group_log_start : usize,
    imm(arm_ranges) : ArrayList(usize),
    imm(ctx) : EvalContext,
    imm(exn) : Exception,
    /// The whole `cond`/`match`, every arm included (a returning arm is not
    /// in `bodies`): a value moved in some arms is moved at its end, so the
    /// early-return drop pass covers the returns inside it.
    (imm(branch_expr) : Option(AstExpr)) ?= Option(AstExpr).None
  ) -> Environment
)({
  if(bodies.len() == usize(0), {
    return(env);
  });
  // Zero-frame env guard: `frames.len() - 1` UNDERFLOWS to 2^64-1 and the
  // per-frame loop below spins (effectively) forever calling
  // `frames.get(i)` → `.None` → continue (std/glob.yo never finished one
  // check). An env with no frames must simply do nothing here.
  if(env.frames.len() == usize(0), {
    return(env);
  });
  max_frame_level := (env.frames.len() - usize(1));
  // Collect case environments from the expr_info_table.
  case_envs := ArrayList(Environment).new();
  // Per-variable scratch lists, hoisted out of the frame × variable loops and
  // `clear()`ed (capacity kept) at the top of each iteration. Minted fresh per
  // variable they were 13% of ALL constructions in a self-check — 127.6 M
  // `ArrayList(Option(Token))` alone
  // (issues/fixed/merge-and-check-envs-mints-five-lists-per-variable-per-branch-merge.md).
  // None of them escapes an iteration: each is read back by index inside it.
  initialized_at_tokens := ArrayList(Option(Token)).new();
  consumed_at_tokens := ArrayList(Option(Token)).new();
  owning_at_tokens := ArrayList(Option(Token)).new();
  var_ids := ArrayList(usize).new();
  cb_tys := ArrayList(TypeValue).new();
  cb_caps := ArrayList(Option(TypeValue)).new();
  cb_body_idx := ArrayList(usize).new();
  (bi : usize) = usize(0);
  while(bi < bodies.len(), {
    body := match(bodies.get(bi), .Some(b) => b, .None => make_err_expr());
    info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(body));
    match(
      info_opt,
      .None => {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(body),
              `Expected the body of the case to be evaluated, but it is not.`
            )
          )
        );
      },
      .Some(info) => {
        case_envs.push(info.env);
      }
    );
    bi = (bi + usize(1));
  });
  // Verify that every case env has a compatible frame depth.
  //
  // Each cond/match arm body is evaluated under a per-arm
  // `push_frame` (cond.yo / match.yo), and the recorded-`ExprInfo.env` SNAPSHOT
  // (issues/fixed/yo-self-recorded-env-aliasing.md) is taken DURING the arm eval, so
  // every arm env is one frame DEEPER than the outer env — uniformly. Comparing
  // to the outer `max_frame_level` would then spuriously throw for EVERY
  // cond/match (swallowed at def-time, but it aborts the enclosing fn body —
  // breaking in-body slice/ref flow gates and assign-escape detection, e.g.
  // slice_flowability's `assign_escape_slice`). Compare each arm to the FIRST
  // arm's depth instead: still catches a genuine inter-arm frame-level
  // inconsistency, but is robust to the uniform arm-frame offset. The per-frame
  // ownership loop below keeps using the outer `max_frame_level`, so it scans
  // exactly the outer frames (present in every arm env) and skips the transient
  // per-arm frame.
  // Each arm env must CONTAIN the outer frames (indices 0..max_frame_level) that
  // the per-frame ownership merge below scans — but arms need NOT have identical
  // TOTAL depth. Each arm is evaluated under a per-arm `push_frame`, and a
  // `begin`-block arm pushes a SECOND (binding) frame while a simple-expr arm
  // does not, so requiring exact depth equality
  // spuriously rejected a cond/match that MIXES begin and non-begin arms — e.g.
  // naming_checker's `index_of`: `cond(… => .Some(i), true => begin(…))`. The
  // transient per-arm / begin frames sit ABOVE max_frame_level and are NOT
  // scanned by the ownership loop; the real inter-arm consistency guard is the
  // per-frame variable-count comparison there.
  //
  // FURTHER RELAXED: even the "outer frames all present" pre-check
  // (`frames.len() < required_depth`) is too strict — an arm whose ONLY missing
  // frame is the innermost (== max_frame_level) is handled safely by the merge
  // loop below (it reads the base frame at :735, falls back to `new_frame(false)`
  // for a missing case frame at :747, and SKIPS the count check at
  // `frame_i == max_frame_level` at :750). And a case env genuinely missing a
  // NON-innermost frame the base has is still rejected by that loop's count
  // check (:789) / name check (:817). So the pre-check is redundant with the
  // loop's own validation; keep only a floor against a fully-uninitialized
  // (0-frame) case env. This drains the "has N, need N+1" def-time-eval throws
  // (await/return/var_fns/function/suspension_analysis/trait_checking) whose
  // arms legitimately differ by one transient frame.
  required_depth := (max_frame_level + usize(1));
  (ci : usize) = usize(0);
  while(ci < case_envs.len(), {
    case_env := match(case_envs.get(ci), .Some(e) => e, .None => env);
    if(case_env.frames.len() == usize(0), {
      exn.throw(
        dyn(
          format_error_message(
            ast_expr_token(match(bodies.get(ci), .Some(b) => b, .None => make_err_expr())),
            `Case env is missing outer frames (has ${case_env.frames.len().to_string()}, need ${required_depth.to_string()}).`
          )
        )
      );
    });
    ci = (ci + usize(1));
  });
  // Process each frame level from 0 to max_frame_level (inclusive).
  (frame_i : usize) = usize(0);
  while(frame_i <= max_frame_level, {
    frame_opt := env.frames.get(frame_i);
    match(
      frame_opt,
      .None => (),
      .Some(frame) => {
        // ---------------------------------------------------------------
        // For each case env, possibly adopt extra temp variables into the
        // base env frame (only for non-innermost frames).
        // ---------------------------------------------------------------
        (cj : usize) = usize(0);
        while(cj < case_envs.len(), {
          case_env := match(case_envs.get(cj), .Some(e) => e, .None => env);
          case_frame := match(case_env.frames.get(frame_i), .Some(f) => f, .None => new_frame(false));
          case_vars_len := case_frame.variables.len();
          base_vars_len := frame.variables.len();
          if((frame_i != max_frame_level) && (case_vars_len != base_vars_len), {
            cond(
              (case_vars_len > base_vars_len) => {
                // Adopt extra TEMP variables into the base env frame (adopted
                // temps must NOT own RC values — each branch handles its own
                // drops); SKIP extra non-temp variables instead of rejecting.
                // A non-temp extra is an ARM-LOCAL binding that the
                // per-arm frame accounting placed in a non-innermost frame —
                // sibling arms legitimately don't have it. The
                // previous all-or-nothing throw ("Frame level N has different
                // number of values for different cases")
                // rejected big match-bodied fns during def-eval and left their
                // WHOLE bodies unstamped (the 16-FTT stage-2 cluster in
                // yo_id_264770/yo_id_360923). Third relaxation of this merge —
                // see [[yo-self-branch-merge-trivial-arm]] for the first two.
                (ek2 : usize) = base_vars_len;
                while(ek2 < case_vars_len, {
                  extra_var2 := match(case_frame.variables.get(ek2), .Some(v) => v, .None => make_err_variable(env));
                  if(is_temp_variable_name(env.module_path, extra_var2.name), {
                    extra_var2.is_owning_the_rc_value = false;
                    {
                      frame.variables.push(extra_var2);
                    };
                  });
                  ek2 = (ek2 + usize(1));
                });
              },
              // case_vars_len < base_vars_len: this case env is SHORTER than the
              // base at a non-innermost frame. This is NOT an inconsistency to
              // reject — it has two legitimate causes, both already handled by
              // the names check + per-column merge below (which read a missing
              // case var as the base var, lines 827/866):
              //   (1) the base frame GREW earlier in THIS cj loop via temp
              //       adoption (line 783), so a later case env compared against
              //       the grown base appears short (the missing vars are exactly
              //       the adopted, non-owning temps);
              //   (2) a trivial arm (`.None => .None`) records no copy of an
              //       enclosing binding the base + destructuring siblings carry.
              // A genuine inconsistency (an arm missing a NON-temp binding the
              // others bound, or a consume/init split) is still caught by the
              // names check (:828) and the per-column consume/init merge (:889+).
              // So defer to them rather than throwing here — symmetric with the
              // case>base all-temps branch above. See
              // issues/fixed/yo-self-p1-transpile-tail.md (branch-merge) +
              // [[yo-self-branch-merge-trivial-arm]].
              true => ()
            );
          });
          // Check variable name consistency.
          (kk : usize) = usize(0);
          while(kk < frame.variables.len(), {
            base_var := match(frame.variables.get(kk), .Some(v) => v, .None => make_err_variable(env));
            // A case env may be SHORTER than the base at this frame: a trivial
            // match arm (e.g. `.None => .None`) records no copy of an enclosing
            // binding (`self_al`) that the base and destructuring sibling arms
            // carry. Such a binding was initialized BEFORE the
            // match, so an arm that simply doesn't re-bind it "retains the base
            // state" — treat a missing case var as the base var rather than a
            // mismatch. (Mirrored in the per-column merge below.) See
            // issues/fixed/yo-self-p1-transpile-tail.md Candidate 3.
            case_var_k := match(case_frame.variables.get(kk), .Some(v) => v, .None => base_var);
            if((base_var.name != case_var_k.name) && !is_temp_variable_name(env.module_path, base_var.name) && !is_temp_variable_name(env.module_path, case_var_k.name), {
              exn.throw(
                dyn(
                  format_error_message(
                    ast_expr_token(match(bodies.get(cj), .Some(b) => b, .None => make_err_expr())),
                    `Frame level ${frame_i} has different variable names for different cases.`
                  )
                )
              );
            });
            kk = (kk + usize(1));
          });
          cj = (cj + usize(1));
        });
        // ---------------------------------------------------------------
        // For each variable column, check and propagate state.
        // ---------------------------------------------------------------
        (var_j : usize) = usize(0);
        while(var_j < frame.variables.len(), {
          base_var := match(frame.variables.get(var_j), .Some(v) => v, .None => make_err_variable(env));
          var_name := base_var.name;
          // Collect per-case values for this variable.
          initialized_at_tokens.clear();
          consumed_at_tokens.clear();
          owning_at_tokens.clear();
          var_ids.clear();
          (ck : usize) = usize(0);
          while(ck < case_envs.len(), {
            case_env := match(case_envs.get(ck), .Some(e) => e, .None => env);
            case_frame_k := match(case_env.frames.get(frame_i), .Some(f) => f, .None => new_frame(false));
            // Missing case var → retains the base (pre-match) state: a trivial
            // arm that doesn't re-bind an enclosing binding leaves it untouched
            // (init'd before the match). Using base_var (vs make_err_variable)
            // keeps the consume/init merge consistent. See the names-check note
            // above + issues/fixed/yo-self-p1-transpile-tail.md Candidate 3.
            case_var := match(case_frame_k.variables.get(var_j), .Some(v) => v, .None => base_var);
            {
              initialized_at_tokens.push(case_var.initialized_at_token);
            };
            {
              consumed_at_tokens.push(match(case_var.consumed_at_token, .Some(b) => Option(Token).Some(b.*), .None => Option(Token).None));
            };
            owning_token := cond(
              case_var.is_owning_the_rc_value => Option(Token).Some(case_var.token),
              true => Option(Token).None
            );
            {
              owning_at_tokens.push(owning_token);
            };
            {
              var_ids.push(case_var.id);
            };
            ck = (ck + usize(1));
          });
          n_cases := case_envs.len();
          // ---- Cross-branch type checks ----
          // Per-branch assigned types come from the branch-init LOG (see
          // expr_info.yo BranchInitRecord) — the shared mutable
          // Variable cannot carry them. Each body's [start,end) window was
          // registered by the arm evaluator; records matching this
          // variable's id give the per-branch (ty, capture).
          {
            cb_tys.clear();
            cb_caps.clear();
            cb_body_idx.clear();
            (cb_i : usize) = usize(0);
            while(cb_i < bodies.len(), {
              cb_body := match(bodies.get(cb_i), .Some(b) => b, .None => make_err_expr());
              match(
                arm_init_range_in(arm_ranges, ast_expr_id(cb_body)),
                .Some(cb_p) => {
                  cb_s := match(arm_ranges.get(cb_p + usize(1)), .Some(x) => x, .None => usize(0));
                  cb_e := match(arm_ranges.get(cb_p + usize(2)), .Some(x) => x, .None => usize(0));
                  // LAST record per arm wins (an arm may assign repeatedly).
                  (cb_found : bool) = false;
                  (cb_ri : usize) = cb_s;
                  while(cb_ri < cb_e, {
                    match(
                      get_branch_init_record(cb_ri),
                      .Some(cb_rec) => if((cb_rec.var_id == base_var.id) && match(cb_rec.kind, .Assign => true, _ => false), {
                        if(cb_found, {
                          cb_tys(cb_tys.len() - usize(1)) = cb_rec.ty;
                          cb_caps(cb_caps.len() - usize(1)) = cb_rec.capture;
                        }, {
                          cb_tys.push(cb_rec.ty);
                          cb_caps.push(cb_rec.capture);
                          cb_body_idx.push(cb_i);
                          cb_found = true;
                        });
                      }),
                      .None => ()
                    );
                    cb_ri = (cb_ri + usize(1));
                  });
                },
                .None => ()
              );
              cb_i = (cb_i + usize(1));
            });
            if(cb_tys.len() > usize(1), {
              cb_first_ty := match(cb_tys.get(usize(0)), .Some(t) => t, .None => TypeValue.Unit);
              cb_first_cap := match(cb_caps.get(usize(0)), .Some(c) => c, .None => Option(TypeValue).None);
              (cb_k : usize) = usize(1);
              while(cb_k < cb_tys.len(), {
                cb_cur_ty := match(cb_tys.get(cb_k), .Some(t) => t, .None => TypeValue.Unit);
                cb_cur_cap := match(cb_caps.get(cb_k), .Some(c) => c, .None => Option(TypeValue).None);
                cb_tok := match(
                  bodies.get(match(cb_body_idx.get(usize(0)), .Some(x) => x, .None => usize(0))),
                  .Some(cb_b0) => ast_expr_token(cb_b0),
                  .None => base_var.token
                );
                // Impl(...) static-dispatch rule: branches resolving to
                // DIFFERENT concrete (capture) types must be rejected.
                (cb_impl_conflict : bool) = false;
                match(
                  cb_first_cap,
                  .Some(cb_fc) => match(
                    cb_cur_cap,
                    .Some(cb_cc) => {
                      // Capture structs are NOMINAL per closure: two
                      // different closures' captures are different concrete
                      // types even when structurally identical (both
                      // capture one i32) — compare struct IDs; the
                      // structural compat check wrongly accepts them.
                      cb_id_conflict := match(
                        cb_fc,
                        .Struct({ id : cb_fid2 }) => match(
                          cb_cc,
                          .Struct({ id : cb_cid2 }) => ((cb_fid2.len() > usize(0)) && (cb_fid2 != cb_cid2)),
                          _ => false
                        ),
                        _ => false
                      );
                      if(cb_id_conflict || !are_types_compatible(cb_cc, cb_fc), {
                        cb_impl_conflict = true;
                        cb_entries := ArrayList(TokenAndError).new();
                        cb_entries.push(
                          TokenAndError(
                            token : cb_tok,
                            error_message :
                              `Variable "${base_var.name}" has type Impl(...) but different concrete types across branches.
Impl(...) uses static dispatch and requires the same concrete type in all branches.
Consider using Dyn(...) for dynamic dispatch if different concrete types are needed.`
                          )
                        );
                        exn.throw(dyn(format_error_messages(cb_entries)));
                      });
                    },
                    .None => ()
                  ),
                  .None => ()
                );
                // General cross-case initialized-type compatibility.
                if(!cb_impl_conflict && !are_types_compatible(cb_cur_ty, cb_first_ty), {
                  cb_entries2 := ArrayList(TokenAndError).new();
                  cb_entries2.push(
                    TokenAndError(
                      token : cb_tok,
                      error_message :
                        `Variable "${base_var.name}" has incompatible types across different cases:
First initialization: ${type_to_string(cb_first_ty)}
Conflicting initialization: ${type_to_string(cb_cur_ty)}`
                    )
                  );
                  exn.throw(dyn(format_error_messages(cb_entries2)));
                });
                cb_k = (cb_k + usize(1));
              });
            });
          };
          // ---- Check initialized_at_token ----
          // Each arm's end state comes from the flow log, not from the per-arm
          // Variable: that is one shared object, left in whatever state the
          // arm evaluated LAST put it. An arm ends in the after-state of its
          // last record for the variable, or in the pre-branch state when it
          // has none (every arm starts there, `reset_sibling_flow_state`). The
          // pre-branch state is the before-state of the branch's first record.
          (flow_joined : bool) = false;
          (flow_pre_init : Option(Token)) = Option(Token).None;
          (flow_pre_consumed : Option(Token)) = Option(Token).None;
          match(
            first_flow_record_in(base_var.id, group_log_start, branch_init_log_len()),
            .Some(fr) => {
              flow_joined = true;
              flow_pre_init = fr.before_init;
              flow_pre_consumed = fr.before_consumed;
              initialized_at_tokens.clear();
              consumed_at_tokens.clear();
              (fl_bi : usize) = usize(0);
              while(fl_bi < bodies.len(), {
                (fl_init : Option(Token)) = flow_pre_init;
                (fl_consumed : Option(Token)) = flow_pre_consumed;
                match(
                  bodies.get(fl_bi),
                  .Some(fl_body) => match(
                    arm_init_range_in(arm_ranges, ast_expr_id(fl_body)),
                    .Some(fl_p) => {
                      fl_s := match(arm_ranges.get(fl_p + usize(1)), .Some(x) => x, .None => usize(0));
                      fl_e := match(arm_ranges.get(fl_p + usize(2)), .Some(x) => x, .None => usize(0));
                      match(
                        last_flow_record_in(base_var.id, fl_s, fl_e),
                        .Some(fl_last) => {
                          fl_init = fl_last.after_init;
                          fl_consumed = fl_last.after_consumed;
                        },
                        .None => ()
                      );
                    },
                    .None => ()
                  ),
                  .None => ()
                );
                initialized_at_tokens.push(fl_init);
                consumed_at_tokens.push(fl_consumed);
                fl_bi = (fl_bi + usize(1));
              });
              // The joined state is decided below from the pre-branch state.
              base_var.initialized_at_token = flow_pre_init;
              base_var.consumed_at_token = match(flow_pre_consumed, .Some(pc) => Option(Rc(Token)).Some(rc(pc)), .None => Option(Rc(Token)).None);
            },
            .None => ()
          );
          // Case 1: the only arm that continues past the branch (the others
          // diverge) initializes it → it is initialized after the branch.
          if(n_cases == usize(1), {
            match(
              initialized_at_tokens.get(usize(0)),
              .Some(.Some(t1)) => if(base_var.initialized_at_token.is_none(), {
                base_var.initialized_at_token = Option(Token).Some(t1);
              }),
              .Some(.None) => (),
              .None => ()
            );
          });
          // Case 2: all cases initialize → propagate to base
          if(n_cases > usize(1), {
            (all_init : bool) = true;
            (any_init : bool) = false;
            (init_i : usize) = usize(0);
            while(init_i < n_cases, {
              tok_opt := match(initialized_at_tokens.get(init_i), .Some(v) => v, .None => Option(Token).None);
              match(
                tok_opt,
                .Some(_) => {
                  any_init = true;
                },
                .None => {
                  all_init = false;
                }
              );
              init_i = (init_i + usize(1));
            });
            if(all_init && !match(base_var.initialized_at_token, .Some(_) => true, .None => false), {
              first_tok := match(initialized_at_tokens.get(usize(0)), .Some(v) => v, .None => Option(Token).None);
              match(
                first_tok,
                .Some(t) => {
                  base_var.initialized_at_token = Option(Token).Some(t);
                },
                .None => ()
              );
            });
            // Case 3: some init, some don't → error
            if(any_init && !all_init, {
              err_list := ArrayList(TokenAndError).new();
              (ei : usize) = usize(0);
              while(ei < n_cases, {
                tok_opt := match(initialized_at_tokens.get(ei), .Some(v) => v, .None => Option(Token).None);
                body_tok := ast_expr_token(match(bodies.get(ei), .Some(b) => b, .None => make_err_expr()));
                msg := cond(
                  (ei == usize(0)) => `Variable "${var_name}" might be initialized in some cases but not initialized in other cases:`,
                  match(tok_opt, .Some(_) => true, .None => false) => `Might be initialized here:`,
                  true => `Not initialized here:`
                );
                err_tok := match(tok_opt, .Some(t) => t, .None => body_tok);
                {
                  err_list.push(TokenAndError(token : err_tok, error_message : msg));
                };
                ei = (ei + usize(1));
              });
              exn.throw(dyn(format_error_messages(err_list)));
            });
          });
          // ---- Check consumed_at_token ----
          // Case 1: single branch consumed → propagate
          if(n_cases == usize(1), {
            first_consumed := match(consumed_at_tokens.get(usize(0)), .Some(v) => v, .None => Option(Token).None);
            match(
              first_consumed,
              .Some(ct) => {
                match(
                  base_var.consumed_at_token,
                  .None => {
                    base_var.consumed_at_token = Option(Rc(Token)).Some(rc(ct.clone()));
                  },
                  .Some(_) => ()
                );
              },
              .None => ()
            );
          });
          // Case 2: all cases consumed → propagate
          if(n_cases > usize(1), {
            (all_consumed : bool) = true;
            (any_consumed : bool) = false;
            (cons_i : usize) = usize(0);
            while(cons_i < n_cases, {
              tok_opt := match(consumed_at_tokens.get(cons_i), .Some(v) => v, .None => Option(Token).None);
              match(
                tok_opt,
                .Some(_) => {
                  any_consumed = true;
                },
                .None => {
                  all_consumed = false;
                }
              );
              cons_i = (cons_i + usize(1));
            });
            if(all_consumed && !match(base_var.consumed_at_token, .Some(_) => true, .None => false), {
              first_tok := match(consumed_at_tokens.get(usize(0)), .Some(v) => v, .None => Option(Token).None);
              // Moved where the branch ends, as for a move in some arms: a
              // `return` in an arm that left the join (a returning arm) is
              // before that point, so the early-return pass drops the value
              // there; one after a move in its own arm is not (the flow log
              // keeps each arm's move as an `UndoneMove`).
              end_tok := match(
                branch_expr,
                .Some(be) => match(first_tok, .Some(ft) => Option(Token).Some(_last_token_of(be, ft)), .None => Option(Token).None),
                .None => first_tok
              );
              match(
                end_tok,
                .Some(t) => {
                  base_var.consumed_at_token = Option(Rc(Token)).Some(rc(t.clone()));
                  variable_note_arm_move(base_var, t, first_tok);
                },
                .None => ()
              );
            });
            // Case 3: partial consumption. An owned value is dropped at the
            // end of every arm that does not move it, so where the arms meet
            // it is gone on every path (the static form of Rust's drop flag:
            // the arms are structured, so no runtime flag is needed). Only a
            // value the elaboration cannot drop is still E0907.
            partial := (any_consumed && !all_consumed);
            elaborated := (partial && _drop_in_arms_that_keep(base_var, bodies, consumed_at_tokens, env, ctx, exn, branch_expr));
            if(elaborated, {
              // Moved where the branch ends: every arm has either moved it
              // or dropped it by then. A `return` inside the branch is before
              // that point, so the early-return drop pass gives it the drop
              // unless the flow log shows a move earlier in its own arm
              // (`variable_moved_at_cleanup_point`), whatever the arm order.
              first_ct := _first_some_token(consumed_at_tokens);
              end_ct := match(
                branch_expr,
                .Some(be) => match(first_ct, .Some(fct) => Option(Token).Some(_last_token_of(be, fct)), .None => Option(Token).None),
                .None => first_ct
              );
              match(
                end_ct,
                .Some(t) => {
                  base_var.consumed_at_token = Option(Rc(Token)).Some(rc(t.clone()));
                  variable_note_arm_move(base_var, t, first_ct);
                },
                .None => ()
              );
            });
            if(partial && !elaborated, {
              err_list := ArrayList(TokenAndError).new();
              (eci : usize) = usize(0);
              while(eci < n_cases, {
                tok_opt := match(consumed_at_tokens.get(eci), .Some(v) => v, .None => Option(Token).None);
                body_tok := ast_expr_token(match(bodies.get(eci), .Some(b) => b, .None => make_err_expr()));
                msg := cond(
                  (eci == usize(0)) => `Variable "${var_name}" is moved in some arms but not in others, so where they meet it would be dropped on some paths only:`,
                  match(tok_opt, .Some(_) => true, .None => false) => `Consumed here:`,
                  true => `Not consumed here:`
                );
                err_tok := match(tok_opt, .Some(t) => t, .None => body_tok);
                {
                  err_list.push(TokenAndError(token : err_tok, error_message : msg));
                };
                eci = (eci + usize(1));
              });
              exn.throw(dyn(with_code(format_error_messages(err_list), E_MOVED_ON_SOME_PATHS)));
            });
          });
          // The branch's net effect, for an enclosing arm or loop.
          if(flow_joined, {
            record_flow_event(
              base_var.id,
              TypeValue.Unit,
              Option(TypeValue).None,
              FlowEventKind.Join,
              base_var.token,
              flow_pre_init,
              flow_pre_consumed,
              base_var.initialized_at_token,
              match(base_var.consumed_at_token, .Some(jc) => Option(Token).Some(jc.*), .None => Option(Token).None)
            );
          });
          // ---- Check is_owning_the_rc_value ----
          // All cases own → propagate
          (all_owning : bool) = true;
          (any_owning : bool) = false;
          (ow_i : usize) = usize(0);
          while(ow_i < n_cases, {
            tok_opt := match(owning_at_tokens.get(ow_i), .Some(v) => v, .None => Option(Token).None);
            match(
              tok_opt,
              .Some(_) => {
                any_owning = true;
              },
              .None => {
                all_owning = false;
              }
            );
            ow_i = (ow_i + usize(1));
          });
          if(all_owning && !base_var.is_owning_the_rc_value, {
            base_var.is_owning_the_rc_value = true;
            base_var.is_owning_the_same_rc_value_as = Option(Rc(Variable)).None;
          });
          // Partial ownership → error
          if(any_owning && !all_owning && !base_var.is_owning_the_rc_value, {
            err_list := ArrayList(TokenAndError).new();
            (oei : usize) = usize(0);
            while(oei < n_cases, {
              tok_opt := match(owning_at_tokens.get(oei), .Some(v) => v, .None => Option(Token).None);
              body_tok := ast_expr_token(match(bodies.get(oei), .Some(b) => b, .None => make_err_expr()));
              msg := cond(
                (oei == usize(0)) => `Variable "${var_name}" might be holding the Rc value in some cases but not holding the Rc value in other cases:`,
                match(tok_opt, .Some(_) => true, .None => false) => `Might be owning the Rc value here:`,
                true => `Might be not owning the Rc value here:`
              );
              err_tok := match(tok_opt, .Some(t) => t, .None => body_tok);
              {
                err_list.push(TokenAndError(token : err_tok, error_message : msg));
              };
              oei = (oei + usize(1));
            });
            exn.throw(dyn(format_error_messages(err_list)));
          });
          // ---- Handle variable ID reassignment across branches ----
          // If any branch has a different variable ID, generate a new one.
          original_id := base_var.id;
          (has_reassignment : bool) = false;
          (rid_i : usize) = usize(0);
          while(rid_i < n_cases, {
            case_id := match(var_ids.get(rid_i), .Some(s) => s, .None => usize(0));
            if(case_id != original_id, {
              has_reassignment = true;
            });
            rid_i = (rid_i + usize(1));
          });
          if(has_reassignment, {
            new_id := generate_variable_id(env.module_path, var_name);
            base_var.id = new_id;
            base_var.value = value_cell_of(Option(EvalValue).None);
            base_var.is_owning_the_same_rc_value_as = Option(Rc(Variable)).None;
          });
          var_j = (var_j + usize(1));
        });
      }
    );
    frame_i = (frame_i + usize(1));
  });
  env
});
// ---------------------------------------------------------------------------
// are_values_equal  (Phase 2ae prerequisite)
// ---------------------------------------------------------------------------
/// Private helper: try to get the concrete (non-runtime) EvalValue from the
/// last entry in a variable lookup list.  Returns .None when the list is
/// empty or the last variable has no compile-time value.
_try_resolve_last_var :: (fn(imm(vars) : ArrayList(Variable)) -> Option(EvalValue))(
  cond(
    (vars.len() == usize(0)) => Option(EvalValue).None,
    true => match(
      vars.last(),
      .None => Option(EvalValue).None,
      .Some(last) => match(
        last.value.get(usize(0)),
        .None => Option(EvalValue).None,
        .Some(v) => cond(
          (is_unknown_val(v) || is_var_ref(v)) => Option(EvalValue).None,
          true => Option(EvalValue).Some(v)
        )
      )
    )
  )
);
/// Private helper: get the declared type from the last entry in a variable
/// lookup list.  Used as a fallback when both VarRef values are unresolvable.
_get_last_var_type :: (fn(imm(vars) : ArrayList(Variable)) -> Option(TypeValue))(
  cond(
    (vars.len() == usize(0)) => Option(TypeValue).None,
    true => match(
      vars.last(),
      .None => Option(TypeValue).None,
      .Some(last) => Option(TypeValue).Some(last.ty)
    )
  )
);
/// Compare two evaluated values for equality, resolving runtime VarRef values
/// through their respective environments.
///
/// - For `VarRef` (a runtime value with a variable name): looks up
///   the most recent binding in the environment and recurses on the resolved
///   value.  When neither side can be resolved, falls back to type
///   compatibility.
/// - For `UnknownVal` (a runtime value without a variable name):
///   compares the declared types with `are_types_compatible`.
/// - For all other concrete value pairs: delegates to structural `==` (which
///   is backed by `eval_value_eq`).
are_values_equal :: (
  fn(
    imm(val1) : EvalValue,
    imm(env1) : Environment,
    imm(val2) : EvalValue,
    imm(env2) : Environment
  ) -> bool
)(
  match(
    val1,
    // val1 is VarRef — try to resolve from env1.
    .VarRef(name1) => {
      vars1 := get_variables_from_env(env1, name1.clone());
      resolved1 := _try_resolve_last_var(vars1);
      match(
        val2,
        // Both VarRef: resolve both and compare; fall back to type compat.
        .VarRef(name2) => {
          vars2 := get_variables_from_env(env2, name2.clone());
          resolved2 := _try_resolve_last_var(vars2);
          match(
            resolved1,
            .Some(r1) => match(
              resolved2,
              .Some(r2) => recur(r1, env1, r2, env2),
              .None => false
            ),
            .None => match(
              resolved2,
              .Some(_) => false,
              .None => {
                ty1_opt := _get_last_var_type(vars1);
                ty2_opt := _get_last_var_type(vars2);
                match(
                  ty1_opt,
                  .Some(t1) => match(
                    ty2_opt,
                    .Some(t2) => are_types_compatible(t1, t2),
                    .None => false
                  ),
                  .None => false
                )
              }
            )
          )
        },
        // val2 is concrete: resolve val1 and compare.
        _ => match(resolved1, .Some(r1) => recur(r1, env1, val2, env2), .None => false)
      )
    },
    // val1 is UnknownVal: compare types with are_types_compatible.
    .UnknownVal(ty1, _) => match(
      val2,
      .UnknownVal(ty2, _) => are_types_compatible(ty1, ty2),
      _ => false
    ),
    // val1 is a concrete value.
    _ => match(
      val2,
      // val2 is VarRef: resolve and compare.
      .VarRef(name2) => {
        vars2 := get_variables_from_env(env2, name2.clone());
        resolved2 := _try_resolve_last_var(vars2);
        match(resolved2, .Some(r2) => recur(val1, env1, r2, env2), .None => false)
      },
      // val2 is UnknownVal: not equal to a concrete value.
      .UnknownVal(_, _) => false,
      // Two TYPE values compare by EXACT type compatibility, not structurally
      // (val1 is the expected side; the compat argument order is
      // (actual, expected)). Overload selection on `= <value>` type
      // parameters relies on this branch (calls/helper.yo
      // Step 5b): `TryInto(i32).try_into` vs `TryInto(i64).try_into` differ
      // ONLY in the assigned `_To` value.
      .TypeVal(ty2) => match(
        val1,
        .TypeVal(ty1) => are_types_compatible_exact(ty2, ty1),
        _ => (val1 == val2)
      ),
      // Both concrete: structural equality.
      _ => (val1 == val2)
    )
  )
);
// ---------------------------------------------------------------------------
// Float literal parsing (integer literals: `parse_raw_int` in src/utils.yo)
// ---------------------------------------------------------------------------
/// Parse a raw float token string (e.g. `"3.14"`, `"1e-5"`) to `f64`.
/// Uses `atof` from the C standard library.
/// Returns `None` if the string has no valid C-string representation.
parse_raw_float :: (fn(imm(raw) : String) -> Option(f64))({
  // The lexer's float loops accept `_` separators exactly like the integer
  // loops, but C `atof` stops at the first `_` — strip them the way
  // `parse_raw_int` does (src/utils.yo), or `1_000.5` parses as `1.0`
  // (issues/fixed/an-underscore-in-a-float-literal-silently-truncates-the-value.md).
  stripped := raw.replace_all(`_`, ``);
  cs := stripped.to_cstr();
  match(
    cs.ptr(),
    .Some(ptr) => .Some(unsafe(atof((*char)(ptr)))),
    .None => .None
  )
});
/// Give a `never`-typed expression the type of the context it flows into
/// (plans/TYPE_SYSTEM_SOUNDNESS.md Phase 3.6). The type checker has already
/// accepted it there — `never` flows into every type — and codegen needs a
/// real type for the unreachable placeholder a diverging expression leaves in
/// a value slot (`generate_panic`'s `(*((T*)NULL))`, the value of a call to a
/// `-> never` function). Reaches the node codegen reads: a block's tail, and
/// the diverging arms of a nested `cond`/`match`. A no-op for a node that is
/// not `never`-typed and for a `never` context.
adopt_never_type :: (fn(imm(e) : AstExpr, imm(ty) : TypeValue, imm(ctx) : EvalContext) -> unit)({
  if(is_never_type(ty), {
    return(());
  });
  match(
    expr_info_table_get(ctx.expr_info_table, ast_expr_id(e)),
    .Some(info) => if(is_never_type(info.ty), {
      info.ty = ty;
      match(
        e,
        .FnCall(_, _, nargs, _, _) => cond(
          ast_expr_is_fn_call_of(e, BK_BEGIN, Option(usize).None) => if(nargs.len() > usize(0), {
            match(nargs.last(), .Some(tail) => recur(tail, ty, ctx), .None => ());
          }),
          (ast_expr_is_fn_call_of(e, BK_COND, Option(usize).None) || ast_expr_is_fn_call_of(e, BK_MATCH, Option(usize).None)) => {
            (ai : usize) = usize(0);
            while(ai < nargs.len(), {
              match(
                nargs.get(ai),
                .Some(arm) => if(ast_expr_is_fn_call_of(arm, "=>", Option(usize).Some(usize(2))), {
                  match(
                    arm,
                    .FnCall(_, _, arm_args, _, _) => match(arm_args.get(usize(1)), .Some(arm_body) => recur(arm_body, ty, ctx), .None => ()),
                    _ => ()
                  );
                }),
                .None => ()
              );
              ai = (ai + usize(1));
            });
          },
          true => ()
        ),
        _ => ()
      );
    }),
    .None => ()
  );
});
export(
  find_rc_value_owner_relationship,
  is_valid_variable_name,
  set_expr_as_consumed,
  expect_expr_to_have_been_evaluated,
  adopt_never_type
);
/// True when the innermost function body under evaluation belongs to a
/// function DECLARED to return a compile-time value (`-> comptime(T)`,
/// `-> Type`, `-> Expr`, …): a compile-time context, where a `:=` (a runtime
/// variable) cannot appear.
///
/// The declared type is the one registered for the function value, not the
/// context's `func_type`: CTFE capability analysis evaluates a RUNTIME
/// function under a synthesized comptime type with the runtime function as
/// its value, and a `comptime_fn` clone carries a comptime type over the
/// runtime body the user wrote. Neither is a compile-time context. A function
/// literal nested in a compile-time body opens its own function-body context,
/// so a runtime method or closure defined there keeps its `:=`.
in_compile_time_fn_body :: (fn(imm(ctx) : EvalContext) -> bool)(
  match(
    ctx.is_evaluating_function_body_or_async_block,
    .Some(fctx) => match(
      fctx.kind,
      .FunctionBody => match(
        fctx.func_value,
        .Some(fv) => match(
          fv,
          .FuncVal(fvd, _) => {
            fid := fvd.*.func_id;
            declared := get_func_type(fid.clone());
            cond(
              is_fn_ctfe_clone(fid) => false,
              is_function_type_and_returns_comptime_value(declared) => true,
              // Unregistered value: fall back to the context's type, which is
              // the declared one for every site that evaluates a user body.
              is_unit_type(declared) => match(
                fctx.func_type,
                .Some(ft) => is_function_type_and_returns_comptime_value(ft),
                .None => false
              ),
              true => false
            )
          },
          _ => false
        ),
        .None => false
      ),
      _ => false
    ),
    .None => false
  )
);
export(in_compile_time_fn_body);
export(throw_expr_is_implicit_variable_error);
export(require_expr_not_consumed);
export(move_only_help, move_only_type_help, use_of_moved_value_error, move_captured_explicit_copy_variable, consume_called_fnonce_closure, transfer_explicit_copy_value);
export(set_expr_as_needs_to_call_dup, set_expr_as_needs_to_call_dup_for_borrowed_projection, arg_is_rc_projection_place);
export(audit_copy_trait_enabled, audit_pending_copies_enabled, audit_record_copy_trait);
export(ImplicitCopyPending, audit_implicit_copy_enabled, audit_note_match_binding, audit_take_implicit_copy_pending, audit_print_implicit_copy, audit_record_implicit_copy, implicit_copy_category);
export(get_dup_use_site_token);
export(attach_temp_variable_to_expr);
export(reject_second_class_escape, note_second_class_binding, reject_second_class_result_outliving, check_capture_freeze_access, require_capture_borrow_exclusivity);
export(doc_comment_lookup_key_from_token);
export(consume_case_body_temp_var, merge_and_check_envs, reject_mixed_closure_arms, reset_sibling_flow_state, keep_last_arm_moves, snapshot_loop_flow, check_loop_flow);
export(are_values_equal);
/// Render an f64 with ROUND-TRIP precision (`%.17g`) for a FloatLit raw.
/// The naive `v.to_string()` is C `%g` — SIX significant digits — and
/// "normalizing" literals through it truncated every float constant in
/// every program past the 6th digit (`0.6303102` and `0.6303103` became
/// the SAME C constant `0.63031`). `%.17g` round-trips every IEEE double.
f64_raw_roundtrip :: (fn(v : f64) -> String)({
  { snprintf } :: import("std/libc/stdio");
  buffer := Array(u8, usize(40)).fill(u8(0));
  buffer_ptr := addr_of(buffer(usize(0)));
  _n := unsafe(snprintf((*char)(buffer_ptr), usize(40), "%.17g", v));
  String.from_cstr(buffer_ptr).unwrap()
});
export(parse_raw_float, f64_raw_roundtrip);
// ---------------------------------------------------------------------------
// Local borrows (plans/VALUES_BY_DEFAULT.md decisions 18, 25 and 38 A)
// ---------------------------------------------------------------------------
/// The `inout` bindings in `bs` the local-borrow model does not track (a
/// borrow it tracks is judged by its live range instead of its scope).
_untracked_inout_borrowers :: (fn(imm(bs) : ArrayList(Variable)) -> ArrayList(Variable))({
  out := ArrayList(Variable).new();
  (i : usize) = usize(0);
  while(i < bs.len(), {
    match(
      bs.get(i),
      .Some(b) => if(local_borrow_info_of(b.name.clone(), b.token).is_none(), {
        out.push(b);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});
/// A place a local borrow freezes, or a place an access touches: a root
/// variable and the field steps from it. The steps stop at the first step
/// whose receiver is a reference cell (a `ref` object, `Box`, `Rc`, `Arc`,
/// `Dyn`): below a cell the cell is the unit (decision 18, rule 2), because
/// other handles reach it and its run-time flag is per cell. They also stop
/// at an index, a dereference, or a member that is not a field of a value
/// aggregate: such a step overlaps its whole receiver.
LocalBorrowPlace :: struct(
  root_name : String,
  /// The root's declaration token. With the name it identifies the root: a
  /// variable's `id` changes when a branch reassigns it.
  root_decl : Token,
  steps : ArrayList(String),
  /// A step entered a reference cell: the place is that cell, whole.
  through_cell : bool,
  /// The root is a module-level binding (decision 18, rule 3).
  module_root : bool,
  /// The place as written, for messages (the steps may be cut short).
  text : String
);
/// One local borrow in scope: `imm(y) := place` or `mut(y) := place`
/// (`inout(y) :=` is `mut`'s Generation A synonym).
LocalBorrowInfo :: ref(
  struct(
    name : String,
    /// The binding's name token: the borrow variable's identity.
    decl : Token,
    is_mut : bool,
    /// The declared place, then the places re-points went through. The
    /// declared place stays frozen for the whole live range (decision 25),
    /// and the set is the union over every re-point (decision 38 A).
    places : ArrayList(LocalBorrowPlace),
    /// The last mention of the borrow in its block.
    last_use : Token,
    /// The end of the live range: the innermost statement holding the last
    /// mention that is not a block or a branch (a whole loop, call or
    /// assignment), so a back edge and a call that receives the borrow keep
    /// it live. An access in `(decl, end]` conflicts.
    end : Token,
    /// The borrows this one is rooted at, nearest first. Each stays live as
    /// long as this one (decision 38 A, transitive freezes).
    parents : ArrayList(Self),
    /// The declaration or a re-point passes through a reference cell.
    crosses_cell : bool,
    /// The declaration roots at a module-level place.
    module_root : bool,
    /// The hidden owning local that holds the cell a re-point stepped into
    /// (decision 25), when the block re-points this borrow.
    step_pin : Option(Variable)
  )
);
/// A `match` binding over a local borrow: a place reached from it, which a
/// re-point may go through (decision 25).
LocalBorrowPatternBinding :: struct(name : String, decl : Token, borrow : LocalBorrowInfo);
/// How an access touches a place.
LocalBorrowAccess :: enum(Read, Write, Move, Exclusive);
/// Any local borrow in scope: the fast gate every access hook checks first.
local_borrows_active :: (fn() -> bool)(g_local_borrows.len() > usize(0));
/// The lengths a begin block restores when it ends (`local_borrows_truncate`).
LocalBorrowMark :: struct(borrows : usize, patterns : usize);
derive(LocalBorrowMark, Copy, Clone);
local_borrows_mark :: (fn() -> LocalBorrowMark)(LocalBorrowMark(borrows : g_local_borrows.len(), patterns : g_local_borrow_patterns.len()));
local_borrows_truncate :: (fn(mark : LocalBorrowMark) -> unit)({
  while(g_local_borrows.len() > mark.borrows, {
    g_local_borrows.pop();
    ()
  });
  while(g_local_borrow_patterns.len() > mark.patterns, {
    g_local_borrow_patterns.pop();
    ()
  });
  g_lb_receiver_armed = false;
  g_lb_lookahead_armed = false;
});
/// Before a `.` access evaluates its receiver `recv`: `recv` is a prefix of
/// the place the access names.
local_borrow_mark_receiver :: (fn(imm(recv) : AstExpr) -> unit)(
  if(local_borrows_active() && (ast_expr_is_atom(recv) || ast_expr_is_fn_call_of(recv, BF_DOT, Option(usize).Some(usize(2)))), {
    g_lb_receiver_id = ast_expr_id(recv);
    g_lb_receiver_armed = true;
  })
);
/// After the receiver was evaluated.
local_borrow_clear_receiver :: (fn() -> unit)({
  g_lb_receiver_armed = false;
});
/// At the entry of `e`'s evaluator: `e` is the receiver of an enclosing `.`
/// access, which reports the place. Clears the mark.
local_borrow_take_receiver :: (fn(imm(e) : AstExpr) -> bool)({
  if(!g_lb_receiver_armed, {
    return(false);
  });
  hit := (g_lb_receiver_id == ast_expr_id(e));
  if(hit, {
    g_lb_receiver_armed = false;
  });
  hit
});
/// `stmt` declares a local borrow: `imm(y) := place`, `mut(y) := place` or
/// `inout(y) := place`.
local_borrow_is_binding_stmt :: (fn(imm(stmt) : AstExpr) -> bool)(
  ast_expr_is_fn_call_of(stmt, BK_INIT_ASSIGN, Option(usize).Some(usize(2))) && match(
    stmt,
    .FnCall(_, _, sargs, _, _) => match(sargs.get(usize(0)), .Some(l) => ast_expr_is_local_borrow_mode_call(l, Option(usize).Some(usize(1))), .None => false),
    .Atom(_, _) => false
  )
);
/// `evaluate_begin_expression`, before it evaluates `stmts(i)`, a borrow
/// binding: hand the binding the statements after it.
local_borrow_set_lookahead :: (fn(imm(stmts) : ArrayList(AstExpr), i : usize, imm(stmt) : AstExpr) -> unit)({
  g_lb_lookahead_stmts = stmts;
  g_lb_lookahead_index = i;
  g_lb_lookahead_id = ast_expr_id(stmt);
  g_lb_lookahead_armed = true;
});
/// A reference cell: a step into it leaves the static place model.
_lb_is_cell_type :: (fn(imm(t) : TypeValue) -> bool)(
  is_reference_struct_type(t) || (is_atomic_reference_struct_type(t) || (is_reference_enum_type(t) || is_dyn_type(t)))
);
_lb_contains :: (fn(imm(xs) : ArrayList(String), imm(x) : String) -> bool)({
  (i : usize) = usize(0);
  while(i < xs.len(), {
    if(match(xs.get(i), .Some(y) => (y == x), .None => false), {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
/// `step` selects a field of a value aggregate of type `recv_ty`: a field of
/// a non-`ref` struct, or a tuple element.
_lb_is_value_field_step :: (fn(imm(recv_ty) : TypeValue, imm(step) : String) -> bool)(
  match(
    t_refine_inner(recv_ty),
    .Struct({ field_labels : fl, is_reference_semantics : r, is_source_namespace : sns }) => (!r && (!sns && _lb_contains(fl, step))),
    .Tuple(_, _) => true,
    _ => false
  )
);
/// The place `e0` names, when it is rooted at a runtime variable: walks `.`
/// steps, an index or call (its callee is the place, whole), a labelled
/// argument, and a call-site borrow marker.
local_borrow_place_of :: (fn(imm(e0) : AstExpr, imm(env) : Environment, imm(ctx) : EvalContext) -> Option(LocalBorrowPlace))({
  (e : AstExpr) = ast_expr_strip_borrow_marker(e0);
  // Outermost first: `steps(k)` selects from `recvs(k)`.
  steps := ArrayList(String).new();
  recvs := ArrayList(AstExpr).new();
  (walking : bool) = true;
  while(walking, {
    match(
      e,
      .Atom(_, _) => {
        walking = false;
      },
      .FnCall(_, callee, args, _, _) => cond(
        ast_expr_is_fn_call_of(e, BF_DOT, Option(usize).Some(usize(2))) => {
          recv := match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
          fld := match(args.get(usize(1)), .Some(a) => a, .None => make_err_expr());
          steps.push(cond(ast_expr_is_atom(fld) => ast_expr_token(fld).value.clone(), true => String.from("?")));
          recvs.push(recv);
          e = recv;
        },
        ast_expr_is_fn_call_of(e, BK_COLON, Option(usize).Some(usize(2))) => {
          e = match(args.get(usize(1)), .Some(a) => a, .None => make_err_expr());
        },
        true => {
          // An index (`xs(i)`) or a call: what the steps so far select lies
          // below it, so the place is the callee, whole.
          steps.clear();
          recvs.clear();
          e = callee;
        }
      )
    );
  });
  if(!ast_expr_is_atom(e), {
    return(Option(LocalBorrowPlace).None);
  });
  tok := ast_expr_token(e);
  if(tok.kind != TokenKind.Identifier, {
    return(Option(LocalBorrowPlace).None);
  });
  root := match(get_variables_from_env(env, tok.value.clone()).last(), .Some(v) => v, .None => return(Option(LocalBorrowPlace).None));
  if(root.is_compile_time_only, {
    return(Option(LocalBorrowPlace).None);
  });
  out := ArrayList(String).new();
  (through_cell : bool) = false;
  (k : usize) = steps.len();
  (stop : bool) = false;
  while((k > usize(0)) && !stop, {
    k = (k - usize(1));
    step := match(steps.get(k), .Some(s) => s, .None => String.from("?"));
    recv_ty := match(
      recvs.get(k),
      .Some(r) => match(expr_info_table_get(ctx.expr_info_table, ast_expr_id(r)), .Some(ri) => ri.ty, .None => root.ty),
      .None => root.ty
    );
    cond(
      _lb_is_cell_type(recv_ty) => {
        through_cell = true;
        stop = true;
      },
      (step == "*") => {
        stop = true;
      },
      _lb_is_value_field_step(recv_ty, step.clone()) => {
        out.push(step);
      },
      true => {
        stop = true;
      }
    );
  });
  Option(LocalBorrowPlace).Some(
    LocalBorrowPlace(
      root_name : root.name.clone(),
      root_decl : root.token,
      steps : out,
      through_cell : through_cell,
      module_root : root.is_module_level,
      text : _place_text(ast_expr_strip_borrow_marker(e0))
    )
  )
});
/// The place `e` as written, for a message.
local_borrow_place_text :: (fn(imm(e) : AstExpr) -> String)(_place_text(e));
/// The place `x` whole, for the variable `v`.
local_borrow_place_of_variable :: (fn(imm(v) : Variable) -> LocalBorrowPlace)(
  LocalBorrowPlace(
    root_name : v.name.clone(),
    root_decl : v.token,
    steps : ArrayList(String).new(),
    // The variable's own slot: no step enters a cell.
    through_cell : false,
    module_root : v.is_module_level,
    text : v.name.clone()
  )
);
_lb_same_decl :: (fn(imm(a_name) : String, imm(a) : Token, imm(b_name) : String, imm(b) : Token) -> bool)(
  (a_name == b_name) && ((a.character == b.character) && (a.module_path == b.module_path))
);
/// One place is a prefix of the other (decision 28's overlap rule).
_lb_places_overlap :: (fn(imm(p) : LocalBorrowPlace, imm(q) : LocalBorrowPlace) -> bool)({
  if(!_lb_same_decl(p.root_name.clone(), p.root_decl, q.root_name.clone(), q.root_decl), {
    return(false);
  });
  n := cond((p.steps.len() < q.steps.len()) => p.steps.len(), true => q.steps.len());
  (i : usize) = usize(0);
  while(i < n, {
    a := match(p.steps.get(i), .Some(x) => x, .None => String.new());
    b := match(q.steps.get(i), .Some(x) => x, .None => String.new());
    if(a != b, {
      return(false);
    });
    i = (i + usize(1));
  });
  true
});
/// `tok` lies in `info`'s live range.
_lb_live_at :: (fn(imm(info) : LocalBorrowInfo, imm(tok) : Token) -> bool)(
  (tok.module_path == info.decl.module_path) && ((tok.character > info.decl.character) && (tok.character <= info.end.character))
);
_lb_place_text :: (fn(imm(p) : LocalBorrowPlace) -> String)(p.text.clone());
_lb_mode :: (fn(imm(info) : LocalBorrowInfo) -> str)(cond(info.is_mut => "mut", true => "imm"));
_lb_verb :: (fn(imm(kind) : LocalBorrowAccess) -> str)(
  match(
    kind,
    .Read => "read",
    .Write => "write",
    .Move => "move",
    .Exclusive => "borrow with `mut`"
  )
);
_lb_is_read :: (fn(imm(kind) : LocalBorrowAccess) -> bool)(match(kind, .Read => true, _ => false));
/// The local borrow named `name` and declared at `decl`, newest first.
local_borrow_info_of :: (fn(imm(name) : String, imm(decl) : Token) -> Option(LocalBorrowInfo))({
  (i : usize) = g_local_borrows.len();
  while(i > usize(0), {
    i = (i - usize(1));
    match(
      g_local_borrows.get(i),
      .Some(info) => if(_lb_same_decl(info.name.clone(), info.decl, name.clone(), decl), {
        return(Option(LocalBorrowInfo).Some(info));
      }),
      .None => ()
    );
  });
  Option(LocalBorrowInfo).None
});
/// A value for the unreachable arm after a throw.
local_borrow_info_placeholder :: (fn(imm(name) : String, imm(tok) : Token) -> LocalBorrowInfo)(
  LocalBorrowInfo(
    name : name,
    decl : tok,
    is_mut : false,
    places : ArrayList(LocalBorrowPlace).new(),
    last_use : tok,
    end : tok,
    parents : ArrayList(LocalBorrowInfo).new(),
    crosses_cell : false,
    module_root : false,
    step_pin : Option(Variable).None
  )
);
/// The local borrow the variable `v` is, if it is one.
local_borrow_info_of_variable :: (fn(imm(v) : Variable) -> Option(LocalBorrowInfo))(
  cond(
    (v.is_ref && local_borrows_active()) => local_borrow_info_of(v.name.clone(), v.token),
    true => Option(LocalBorrowInfo).None
  )
);
/// The local borrow a `match` binding named `name` (declared at `decl`) was
/// reached from.
local_borrow_pattern_source :: (fn(imm(name) : String, imm(decl) : Token) -> Option(LocalBorrowInfo))({
  (i : usize) = g_local_borrow_patterns.len();
  while(i > usize(0), {
    i = (i - usize(1));
    match(
      g_local_borrow_patterns.get(i),
      .Some(pb) => if(_lb_same_decl(pb.name.clone(), pb.decl, name.clone(), decl), {
        return(Option(LocalBorrowInfo).Some(pb.borrow));
      }),
      .None => ()
    );
  });
  Option(LocalBorrowInfo).None
});
/// The local borrow a `match` scrutinee is reached from: a place rooted at a
/// local borrow, or at a `match` binding over one.
local_borrow_scrutinee_source :: (fn(imm(scrutinee) : AstExpr, imm(env) : Environment, imm(ctx) : EvalContext) -> Option(LocalBorrowInfo))(
  match(
    local_borrow_place_of(scrutinee, env, ctx),
    .Some(p) => match(
      local_borrow_info_of(p.root_name.clone(), p.root_decl),
      .Some(info) => Option(LocalBorrowInfo).Some(info),
      .None => local_borrow_pattern_source(p.root_name.clone(), p.root_decl)
    ),
    .None => Option(LocalBorrowInfo).None
  )
);
/// Record that the `match` binding `name` (declared at `decl`) is reached
/// from the local borrow `borrow`.
local_borrow_note_pattern_binding :: (fn(imm(name) : String, imm(decl) : Token, imm(borrow) : LocalBorrowInfo) -> unit)({
  g_local_borrow_patterns.push(LocalBorrowPatternBinding(name : name, decl : decl, borrow : borrow));
});
/// E0911: the access `kind` of `place` at `tok` conflicts with the live
/// borrow `info`, which freezes `frozen`.
_lb_raise_conflict :: (
  fn(imm(info) : LocalBorrowInfo, imm(frozen) : LocalBorrowPlace, imm(place) : LocalBorrowPlace, imm(kind) : LocalBorrowAccess, imm(tok) : Token, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit
)({
  ftext := _lb_place_text(frozen);
  rule := cond(
    info.is_mut => `a \`mut\` borrow is exclusive: while it is live, \`${ftext}\`, the places inside it and the places containing it are reached only through \`${info.name}\``,
    true => `an \`imm\` borrow freezes its place: while it is live, \`${ftext}\`, the places inside it and the places containing it are not written or moved`
  );
  cell_note := cond(frozen.through_cell => " (below a reference cell the cell is the unit, so every place in it overlaps)", true => "");
  entries := ArrayList(TokenAndError).new();
  entries.push(
    TokenAndError(
      token : tok,
      error_message : `Cannot ${_lb_verb(kind)} \`${_lb_place_text(place)}\` here: \`${info.name}\` borrows \`${ftext}\` with \`${_lb_mode(info)}\` and is still live, and ${rule}${cell_note}.`
    )
  );
  entries.push(TokenAndError(token : info.decl, error_message : `\`${info.name}\` borrows \`${ftext}\` here:`));
  entries.push(
    TokenAndError(
      token : info.last_use,
      error_message : cond(
        _lb_tok_after(info.last_use, tok) => `and is used again here, so it is live at the access:`,
        true => `its last use is in the same statement as the access, here:`
      )
    )
  );
  help := cond(
    info.is_mut => `make the access after \`${info.name}\`'s last use, or make it through \`${info.name}\``,
    true => `make the access after \`${info.name}\`'s last use, or borrow with \`mut(${info.name}) := ...\` to write through the borrow`
  );
  raise_flow_violation(with_code(format_error_messages_with_help(entries, Option(String).Some(help)), E_LOCAL_BORROW_CONFLICT), ctx, exn);
});
_lb_tok_after :: (fn(imm(a) : Token, imm(b) : Token) -> bool)((a.module_path == b.module_path) && (a.character > b.character));
/// An access of `place` at `tok`: E0911 if it conflicts with a live local
/// borrow (decision 18, rule 2). A read conflicts with a live `mut` borrow;
/// a write, a move or an exclusive borrow with any live borrow.
local_borrow_access :: (fn(imm(place) : LocalBorrowPlace, imm(kind) : LocalBorrowAccess, imm(tok) : Token, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  (i : usize) = g_local_borrows.len();
  while(i > usize(0), {
    i = (i - usize(1));
    match(
      g_local_borrows.get(i),
      .Some(info) => if((info.is_mut || !_lb_is_read(kind)) && _lb_live_at(info, tok), {
        (pi : usize) = usize(0);
        while(pi < info.places.len(), {
          match(
            info.places.get(pi),
            .Some(fp) => if(_lb_places_overlap(fp, place), {
              _lb_raise_conflict(info, fp, place, kind, tok, ctx, exn);
            }),
            .None => ()
          );
          pi = (pi + usize(1));
        });
      }),
      .None => ()
    );
  });
});
/// An access of the place `e` names (no-op when it is not rooted at a
/// variable or no local borrow is in scope).
local_borrow_access_expr :: (fn(imm(e) : AstExpr, imm(kind) : LocalBorrowAccess, imm(tok) : Token, imm(env) : Environment, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)(
  if(local_borrows_active(), {
    match(
      local_borrow_place_of(e, env, ctx),
      .Some(p) => local_borrow_access(p, kind, tok, ctx, exn),
      .None => ()
    );
  })
);
/// A write of `place` at `tok` that goes through an `imm` local borrow is
/// E0908: the borrow is read-only (decision 18). `what` names the write.
local_borrow_require_writable :: (fn(imm(place) : LocalBorrowPlace, imm(what) : String, imm(tok) : Token, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)(
  match(
    local_borrow_info_of(place.root_name.clone(), place.root_decl),
    .Some(info) => if(!info.is_mut, {
      entries := ArrayList(TokenAndError).new();
      entries.push(
        TokenAndError(
          token : tok,
          error_message : `Cannot ${what}: \`${info.name}\` is an \`imm\` borrow, which is read-only.`
        )
      );
      entries.push(TokenAndError(token : info.decl, error_message : `\`${info.name}\` is declared \`imm\` here:`));
      raise_flow_violation(
        with_code(
          format_error_messages_with_help(entries, Option(String).Some(`declare it \`mut(${info.name}) := ...\` to write through it, or copy the value into a local (\`v := ${info.name};\`) and write the copy`)),
          E_WRITE_THROUGH_BORROW
        ),
        ctx,
        exn
      );
    }),
    .None => ()
  )
);
/// A write (an assignment target, a `mut` argument the callee writes) of the
/// place `e`: E0908 through an `imm` borrow, E0911 against a live borrow.
local_borrow_write_expr :: (fn(imm(e) : AstExpr, imm(what) : String, imm(tok) : Token, imm(env) : Environment, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)(
  if(local_borrows_active(), {
    match(
      local_borrow_place_of(e, env, ctx),
      .Some(p) => {
        local_borrow_require_writable(p, what, tok, ctx, exn);
        local_borrow_access(p, LocalBorrowAccess.Write, tok, ctx, exn);
      },
      .None => ()
    );
  })
);
/// Does `e` NAME STORAGE — the result expression is a place: an identifier
/// atom, or a field-access chain (a `.field` step whose field is a name atom)
/// rooted at one? A call or an index on the place (`y.len()`, `xs(i)`)
/// produces a VALUE — its result is the callee's, not the place — so an
/// expression ending in one is not a place; `local_borrow_place_of` (whose
/// notion of a place is "what an access touches", so `xs(i)` names `xs`
/// whole) does not distinguish the two.
local_borrow_result_is_place :: (fn(imm(e) : AstExpr) -> bool)({
  (p : AstExpr) = ast_expr_strip_borrow_marker(e);
  if(ast_expr_is_atom(p), {
    return(true);
  });
  cond(
    ast_expr_is_fn_call_of(p, BF_DOT, Option(usize).Some(usize(2))) => match(
      p,
      .FnCall(_, _, dot_args, _, _) => match(
        dot_args.get(usize(1)),
        .Some(f) => cond(
          !ast_expr_is_atom(f) => false,
          true => match(
            dot_args.get(usize(0)),
            .Some(recv0) => local_borrow_result_is_place(ast_expr_strip_borrow_marker(recv0)),
            .None => false
          )
        ),
        .None => false
      ),
      .Atom(_, _) => false
    ),
    true => false
  )
});
/// The function-result escape check (decision 18 rule 1, decision 38 A):
/// `e` is a place expression rooted at a local borrow — the borrow itself
/// (`y`) or a place reached from it through the field steps the place model
/// tracks (`y.x`) — so the expression naming the function's result names the
/// BORROW, which is second-class, not the value it reads through.
local_borrow_result_borrow_of :: (fn(imm(e) : AstExpr, imm(env) : Environment, imm(ctx) : EvalContext) -> Option(LocalBorrowInfo))(
  cond(
    local_borrow_result_is_place(e) => match(
      local_borrow_place_of(e, env, ctx),
      .Some(p) => local_borrow_info_of(p.root_name.clone(), p.root_decl),
      .None => Option(LocalBorrowInfo).None
    ),
    true => Option(LocalBorrowInfo).None
  )
);
/// E0912: the local borrow `info` is the function's result — `return(...)`
/// names it as its argument at `tok`, or the body's result expression is the
/// place it names (a block tail that yields it). A borrow is second-class
/// (decision 18 rule 1, decision 38 A): the value it names may be read
/// through and copied out, but the borrow itself never crosses the function
/// boundary.
local_borrow_reject_result_borrow :: (fn(imm(info) : LocalBorrowInfo, imm(tok) : Token, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  ftext := match(
    info.places.get(usize(0)),
    .Some(p0) => _lb_place_text(p0),
    .None => info.name.clone()
  );
  entries := ArrayList(TokenAndError).new();
  entries.push(
    TokenAndError(
      token : tok,
      error_message : `Cannot return the local borrow \`${info.name}\`: it borrows \`${ftext}\` with \`${_lb_mode(info)}\` and is second-class, so it may not cross the function boundary (no return, store, escaping capture or spawn).`
    )
  );
  entries.push(TokenAndError(token : info.decl, error_message : `\`${info.name}\` borrows \`${ftext}\` here:`));
  raise_flow_violation(
    with_code(
      format_error_messages_with_help(
        entries,
        Option(String).Some(`read the value out first — copy it into an owned local (\`v := ${info.name};\`) and return that, or return the value of an operation on it (\`return((${info.name} + i32(0)))\` for a scalar)`)
      ),
      E_LOCAL_BORROW_ESCAPES
    ),
    ctx,
    exn
  );
  ()
});
/// Rule 3 (decision 18): a borrow of a module-level place may not be live
/// across a call, which could reach the place by name. `tok` is the call.
local_borrow_note_call :: (fn(imm(tok) : Token, imm(callee_text) : String, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  (i : usize) = g_local_borrows.len();
  while(i > usize(0), {
    i = (i - usize(1));
    match(
      g_local_borrows.get(i),
      .Some(info) => if(info.module_root && _lb_live_at(info, tok), {
        root_text := match(info.places.get(usize(0)), .Some(p0) => _lb_place_text(p0), .None => info.name.clone());
        entries := ArrayList(TokenAndError).new();
        entries.push(
          TokenAndError(
            token : tok,
            error_message : `Cannot call \`${callee_text}\` while \`${info.name}\` is live: \`${info.name}\` borrows \`${root_text}\`, a module-level place, which has no run-time borrow flag, and a callee can reach a module-level place by name.`
          )
        );
        entries.push(TokenAndError(token : info.decl, error_message : `\`${info.name}\` borrows \`${root_text}\` here:`));
        entries.push(TokenAndError(token : info.last_use, error_message : String.from("and is live until here:")));
        raise_flow_violation(
          with_code(
            format_error_messages_with_help(entries, Option(String).Some(String.from("end the borrow before the call, or copy the value into a local, work on the local, and assign it back after the call"))),
            E_LOCAL_BORROW_CONFLICT
          ),
          ctx,
          exn
        );
      }),
      .None => ()
    );
  });
});
/// Rule 4 (decision 18): a borrow whose declaration or a re-point passes
/// through a reference cell or a module-level place may not be live across
/// an `await`: another task could write the place while this one is
/// suspended. `tok` is the await.
local_borrow_note_await :: (fn(imm(tok) : Token, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  (i : usize) = g_local_borrows.len();
  while(i > usize(0), {
    i = (i - usize(1));
    match(
      g_local_borrows.get(i),
      .Some(info) => if((info.crosses_cell || info.module_root) && _lb_live_at(info, tok), {
        why := cond(info.module_root => "a module-level place", true => "a reference cell (`Rc`, `Arc` or a `ref` object)");
        entries := ArrayList(TokenAndError).new();
        entries.push(
          TokenAndError(
            token : tok,
            error_message : `\`${info.name}\` is live across this \`await\`, and its place passes through ${why}: another task can reach that place while this one is suspended.`
          )
        );
        entries.push(TokenAndError(token : info.decl, error_message : `\`${info.name}\` is declared here:`));
        entries.push(TokenAndError(token : info.last_use, error_message : String.from("and is used again here:")));
        raise_flow_violation(
          with_code(
            format_error_messages_with_help(entries, Option(String).Some(String.from("end the borrow before the `await` and borrow again after it, or borrow a place the task owns (a local value)"))),
            E_LOCAL_BORROW_CONFLICT
          ),
          ctx,
          exn
        );
      }),
      .None => ()
    );
  });
});
// --- Live ranges -------------------------------------------------------------
/// `e` mentions the identifier `name` (a field name after `.` does not count).
_lb_mentions :: (fn(imm(e) : AstExpr, imm(name) : String) -> bool)(
  match(
    e,
    .Atom(_, t) => ((t.kind == TokenKind.Identifier) && (t.value == name)),
    .FnCall(_, callee, args, _, _) => {
      if(_lb_mentions(callee, name.clone()), {
        return(true);
      });
      is_dot := ast_expr_is_fn_call_of(e, BF_DOT, Option(usize).Some(usize(2)));
      (i : usize) = usize(0);
      while(i < args.len(), {
        match(
          args.get(i),
          .Some(a) => if(!(is_dot && ((i == usize(1)) && ast_expr_is_atom(a))) && _lb_mentions(a, name.clone()), {
            return(true);
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      false
    }
  )
);
/// The last token of a mention of `name` in `e`.
_lb_last_mention :: (fn(imm(e) : AstExpr, imm(name) : String, imm(best) : Option(Token)) -> Option(Token))(
  match(
    e,
    .Atom(_, t) => cond(
      ((t.kind == TokenKind.Identifier) && (t.value == name)) => match(
        best,
        .Some(b) => cond(_lb_tok_after(t, b) => Option(Token).Some(t), true => best),
        .None => Option(Token).Some(t)
      ),
      true => best
    ),
    .FnCall(_, callee, args, _, _) => {
      (acc : Option(Token)) = _lb_last_mention(callee, name.clone(), best);
      is_dot := ast_expr_is_fn_call_of(e, BF_DOT, Option(usize).Some(usize(2)));
      (i : usize) = usize(0);
      while(i < args.len(), {
        match(
          args.get(i),
          .Some(a) => if(!(is_dot && ((i == usize(1)) && ast_expr_is_atom(a))), {
            acc = _lb_last_mention(a, name.clone(), acc);
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      acc
    }
  )
);
/// The end of the region of `e` that keeps a borrow named `name` live, `e`
/// holding its last mention: descend through blocks and branch arms into the
/// last child that mentions it; anything else (a loop, a call, an
/// assignment, a closure) is live to its end.
_lb_region_end :: (fn(imm(e) : AstExpr, imm(name) : String, imm(root) : Token) -> Token)({
  args := match(e, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new());
  is_block := ast_expr_is_fn_call_of(e, BK_BEGIN, Option(usize).None);
  is_branch := (ast_expr_is_fn_call_of(e, BK_COND, Option(usize).None) || ast_expr_is_fn_call_of(e, BK_MATCH, Option(usize).None));
  if(!(is_block || is_branch), {
    return(_last_token_of(e, root));
  });
  (j : usize) = args.len();
  while(j > usize(0), {
    j = (j - usize(1));
    child := match(args.get(j), .Some(c) => c, .None => make_err_expr());
    if(_lb_mentions(child, name.clone()), {
      // A branch arm `pattern => body`: the body, or the pattern/condition.
      if(is_branch && ast_expr_is_fn_call_of(child, "=>", Option(usize).Some(usize(2))), {
        arm_args := match(child, .FnCall(_, _, aa, _, _) => aa, .Atom(_, _) => ArrayList(AstExpr).new());
        body := match(arm_args.get(usize(1)), .Some(b) => b, .None => child);
        head := match(arm_args.get(usize(0)), .Some(h) => h, .None => child);
        return(cond(_lb_mentions(body, name.clone()) => _lb_region_end(body, name.clone(), root), true => _last_token_of(head, root)));
      });
      return(_lb_region_end(child, name.clone(), root));
    });
  });
  _last_token_of(e, root)
});
/// `e` re-points the borrow `name` somewhere (`imm(name) = p`, `mut(name) = p`).
_lb_has_repoint :: (fn(imm(e) : AstExpr, imm(name) : String) -> bool)(
  match(
    e,
    .Atom(_, _) => false,
    .FnCall(_, callee, args, _, _) => {
      if(ast_expr_is_fn_call_of(e, BK_ASSIGN, Option(usize).Some(usize(2))), {
        match(
          args.get(usize(0)),
          .Some(l) => if(ast_expr_is_local_borrow_mode_call(l, Option(usize).Some(usize(1))), {
            match(
              l,
              .FnCall(_, _, largs, _, _) => match(
                largs.get(usize(0)),
                .Some(n) => if(match(n, .Atom(_, nt) => (nt.value == name), .FnCall(_, _, _, _, _) => false), {
                  return(true);
                }),
                .None => ()
              ),
              .Atom(_, _) => ()
            );
          }),
          .None => ()
        );
      });
      if(_lb_has_repoint(callee, name.clone()), {
        return(true);
      });
      (i : usize) = usize(0);
      while(i < args.len(), {
        match(
          args.get(i),
          .Some(a) => if(_lb_has_repoint(a, name.clone()), {
            return(true);
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      false
    }
  )
);
/// The live range of a borrow named `name` declared by `binding`: its last
/// mention and its region end. Without a block look-ahead (the binding is
/// not a block statement) the borrow dies at its own binding.
/// `has_repoint` reports whether a later statement re-points it.
LocalBorrowRange :: struct(last_use : Token, end : Token, has_repoint : bool);
local_borrow_range_of :: (fn(imm(binding) : AstExpr, imm(name) : String, imm(decl) : Token) -> LocalBorrowRange)({
  (last : Token) = decl;
  (end : Token) = _last_token_of(binding, decl);
  (repoint : bool) = false;
  if(g_lb_lookahead_armed && (g_lb_lookahead_id == ast_expr_id(binding)), {
    g_lb_lookahead_armed = false;
    stmts := g_lb_lookahead_stmts;
    (j : usize) = stmts.len();
    (found : bool) = false;
    while((j > (g_lb_lookahead_index + usize(1))) && !found, {
      j = (j - usize(1));
      st := match(stmts.get(j), .Some(s) => s, .None => make_err_expr());
      if(_lb_mentions(st, name.clone()), {
        found = true;
        last = match(_lb_last_mention(st, name.clone(), Option(Token).None), .Some(t) => t, .None => decl);
        end = _lb_region_end(st, name.clone(), decl);
      });
    });
    (k : usize) = (g_lb_lookahead_index + usize(1));
    while((k < stmts.len()) && !repoint, {
      repoint = match(stmts.get(k), .Some(s) => _lb_has_repoint(s, name.clone()), .None => false);
      k = (k + usize(1));
    });
  });
  LocalBorrowRange(last_use : last, end : end, has_repoint : repoint)
});
/// Register the local borrow `name` (declared at `decl`) of `place`, live as
/// `range` says. Its parents (the borrows `place` is rooted at) stay live as
/// long as it (decision 38 A).
local_borrow_register :: (
  fn(imm(name) : String, imm(decl) : Token, is_mut : bool, imm(place) : LocalBorrowPlace, imm(range) : LocalBorrowRange, imm(step_pin) : Option(Variable)) -> LocalBorrowInfo
)({
  parents := ArrayList(LocalBorrowInfo).new();
  (crosses : bool) = place.through_cell;
  (module_root : bool) = place.module_root;
  match(
    local_borrow_info_of(place.root_name.clone(), place.root_decl),
    .Some(parent) => {
      parents.push(parent);
      (pi : usize) = usize(0);
      while(pi < parent.parents.len(), {
        match(parent.parents.get(pi), .Some(pp) => parents.push(pp), .None => ());
        pi = (pi + usize(1));
      });
      crosses = (crosses || parent.crosses_cell);
      module_root = (module_root || parent.module_root);
    },
    .None => ()
  );
  places := ArrayList(LocalBorrowPlace).new();
  places.push(place);
  info := LocalBorrowInfo(
    name : name,
    decl : decl,
    is_mut : is_mut,
    places : places,
    last_use : range.last_use,
    end : range.end,
    parents : parents,
    crosses_cell : crosses,
    module_root : module_root,
    step_pin : step_pin
  );
  // Transitive freezes: a parent is live while this borrow is.
  (qi : usize) = usize(0);
  while(qi < parents.len(), {
    match(
      parents.get(qi),
      .Some(p) => {
        if(_lb_tok_after(range.end, p.end), {
          p.end = range.end;
        });
        if(_lb_tok_after(range.last_use, p.last_use), {
          p.last_use = range.last_use;
        });
      },
      .None => ()
    );
    qi = (qi + usize(1));
  });
  g_local_borrows.push(info);
  info
});
/// Decision 38 A: re-pointing `info` at `tok` is an error while a borrow
/// derived from its current target is live.
local_borrow_require_no_live_derived :: (fn(imm(info) : LocalBorrowInfo, imm(tok) : Token, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  (i : usize) = g_local_borrows.len();
  while(i > usize(0), {
    i = (i - usize(1));
    match(
      g_local_borrows.get(i),
      .Some(d) => if(match(d.parents.get(usize(0)), .Some(p) => _lb_same_decl(p.name.clone(), p.decl, info.name.clone(), info.decl), .None => false) && _lb_live_at(d, tok), {
        entries := ArrayList(TokenAndError).new();
        entries.push(
          TokenAndError(
            token : tok,
            error_message : `Cannot re-point \`${info.name}\` here: \`${d.name}\` borrows from \`${info.name}\`'s current target and is still live, and re-pointing would leave \`${d.name}\` borrowing a place \`${info.name}\` no longer holds.`
          )
        );
        entries.push(TokenAndError(token : d.decl, error_message : `\`${d.name}\` borrows from \`${info.name}\` here:`));
        entries.push(TokenAndError(token : d.last_use, error_message : String.from("and is used again here:")));
        raise_flow_violation(
          with_code(
            format_error_messages_with_help(entries, Option(String).Some(`end \`${d.name}\` (its last use) before the re-point`)),
            E_LOCAL_BORROW_CONFLICT
          ),
          ctx,
          exn
        );
      }),
      .None => ()
    );
  });
});
/// After a call evaluated at `tok`: rule 4 at an `await`, rule 3 at any other
/// runtime call. `is_await` marks an `io.await`/`.await` call; `callee_text`
/// names the callee.
local_borrow_note_runtime_call :: (fn(is_await : bool, imm(tok) : Token, imm(callee_text) : String, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)(
  cond(
    is_await => local_borrow_note_await(tok, ctx, exn),
    true => local_borrow_note_call(tok, callee_text, ctx, exn)
  )
);
/// A runtime operator on implicitly copyable scalars (`g + i32(1)`) lowers to
/// a C operator: it is not a call for rule 3.
local_borrow_is_scalar_type :: (fn(imm(t) : TypeValue) -> bool)(
  is_primitive_type(t) || (is_bool_type(t) || is_pointer_type(t))
);
// ---------------------------------------------------------------------------
// The consuming and `mut` match (plans/VALUES_BY_DEFAULT.md decision 26)
// ---------------------------------------------------------------------------
/// A binding a consuming `match` arm owns, still unmoved after the arm's
/// body: it is dropped at the arm's end and at each `return` inside the arm,
/// as a value kept by one arm of a branch is (`_drop_in_arms_that_keep`).
drop_owned_match_binding_at_arm_end :: (fn(imm(v) : Variable, imm(body) : AstExpr, imm(env) : Environment, imm(ctx) : EvalContext, imm(exn) : Exception) -> unit)({
  if(v.consumed_at_token.is_some(), {
    return(());
  });
  bodies := ArrayList(AstExpr).new();
  bodies.push(body);
  toks := ArrayList(Option(Token)).new();
  toks.push(Option(Token).None);
  _kept := _drop_in_arms_that_keep(v, bodies, toks, env, ctx, exn);
});
/// Is the variable `v` a closure's capture (a by-value capture field, or an
/// implicit capture of the enclosing function's local)? A `match` cannot
/// move it out of the closure.
match_scrutinee_is_capture :: (fn(imm(v) : Variable, imm(env) : Environment, imm(ctx) : EvalContext) -> bool)(
  is_fn_capture_value_binding(v.id) || _is_implicit_closure_capture(v, env, ctx)
);
/// Register the `mut` place a `match` arm binds (`name`, declared at `decl`)
/// as an exclusive local borrow of the scrutinee's place, live from the
/// binding to its last mention in the arm `body` (decision 18's rule): the
/// arm cannot read, write or move the scrutinee while the place is live.
local_borrow_register_match_place :: (fn(imm(name) : String, imm(decl) : Token, imm(place) : LocalBorrowPlace, imm(body) : AstExpr) -> unit)({
  last := match(_lb_last_mention(body, name.clone(), Option(Token).None), .Some(t) => t, .None => decl);
  end := cond(_lb_mentions(body, name.clone()) => _lb_region_end(body, name.clone(), decl), true => decl);
  _info := local_borrow_register(name, decl, true, place, LocalBorrowRange(last_use : last, end : end, has_repoint : false), Option(Variable).None);
});
export(drop_owned_match_binding_at_arm_end, match_scrutinee_is_capture, local_borrow_register_match_place, note_consuming_match_scrutinee, consuming_match_scrutinee_at, moved_value_help, migrate_borrowed_match_at);
