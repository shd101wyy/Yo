//! Evaluator context types.
//!
//! Mirrors `src/evaluator/context.ts` — 1:1 port of all exported interfaces,
//! type aliases, and the `trackVariableUsage` helper.
//!
//! Key design decisions vs the TypeScript source:
//!
//! * TypeScript interfaces → Yo `object` types.
//! * Optional TypeScript fields (`field?: T`) → `Option(T)` Yo fields.
//! * TypeScript discriminated-union result fields → Yo enum variants.
//! * `Map<K,V>` → `HashMap(K, V)` from std/collections/hash_map.
//! * `Set<K>` → `HashSet(K)` from std/collections/hash_set.
//! * TypeScript callback types (`LoadModuleFn`, …) → Yo function types.
//! * TypeScript `Type` → `TypeValue` (our enum-based type representation).
//! * TypeScript `Value | ModuleValue | TraitValue | FunctionValue` → `EvalValue`.
//! * TypeScript `Expr | FnCallExpr` → `AstExpr`.
//! * TypeScript `PathCollection` (Path[]) → `PathCollection :: ArrayList(ArrayList(String))`
//!   imported from `src/expr_info.yo` (Phase 2k).
open(import("std/string"));
_(env : ctx_dbg_env) :: import("std/env");
{ eprintln } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ HashSet } :: import("std/collections/hash_set");
{ TypeValue } :: import("../types/definitions.yo");
{ trial_flag_get, trial_flag_set, t_unit, t_ptr } :: import("../types/creators.yo");
{ EvalValue } :: import("../value.yo");
{ Environment, Variable, Frame, _frame_positions, snapshot_env, add_variable_to_env, get_variables_from_frame } :: import("../env.yo");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom,
  ast_expr_is_atom_and_operator,
  ast_expr_to_string,
  BK_CONST,
  BK_COLON,
  BK_ASSIGN,
  BK_IMPL_LOWER,
  BK_COMPTIME,
  BK_IMPORT,
  BK_GENERIC,
  BK_BEGIN,
  BF_DOT
} :: import("../expr.yo");
{ PathCollection, path_collection_new, ExprInfoTable, expr_info_table_new, is_module_level_global, ComptimeRef } :: import("../expr_info.yo");
{ Token } :: import("../token.yo");
// ---------------------------------------------------------------------------
// PathCollection now imported from ../expr_info.yo (Phase 2k)
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// LoadModuleFn result
// ---------------------------------------------------------------------------
/// Return value of a `load_module` callback.  Mirrors the anonymous object
/// `{ moduleValue: ModuleValue; moduleError: Error | undefined }` in the TS source.
LoadModuleResult :: ref(
  struct(
    module_value : EvalValue,
    /// The source-namespace STRUCT TYPE with real member field types.
    /// `type_of_eval_value(module_value)` cannot reconstruct these (FuncVal
    /// values carry no type — every imported fn member arrived unit-typed,
    /// so `mod.f(x)` calls typed unit). `.Unit` when unknown (cycle path).
    module_type : TypeValue,
    module_error : Option(String)
  )
);
// ---------------------------------------------------------------------------
// Sub-context for function / async-block / test-block evaluation
// ---------------------------------------------------------------------------
/// Indicates the kind of the innermost "function-like" evaluation scope.
FuncOrAsyncBlockKind :: enum(
  /// Evaluating a function body (includes the function's type and optional value).
  FunctionBody,
  /// Evaluating an `io.async(...)` closure body.
  AsyncBlock,
  /// Evaluating a `test("...", { ... })` block body.
  TestBlock
);
/// Evaluation sub-context for a function body or async / test block.
///
/// Mirrors the TypeScript union
/// `FunctionEvaluationContext | AsyncBlockEvaluationContext | TestBlockEvaluationContext`.
FuncOrAsyncBlockCtx :: ref(
  struct(
    kind : FuncOrAsyncBlockKind,
    /// The type of the function being evaluated (meaningless for async/test blocks).
    func_type : Option(TypeValue),
    /// The value of the function being evaluated (meaningless for async/test blocks).
    func_value : Option(EvalValue),
    /// The environment at the time the function / async-block body is being evaluated.
    /// Used to determine the frame level for closure variable capture.
    eval_env : Environment
  )
);
// ---------------------------------------------------------------------------
// Loop body context
// ---------------------------------------------------------------------------
LoopKind :: enum(While, For);
LoopBodyCtx :: ref(
  struct(
    kind : LoopKind,
    env : Environment,
    // Frame count SNAPSHOT taken at loop entry. `env` is the live shared
    // Environment whose frames list keeps growing during the body eval, so
    // TS's `variable.frameLevel < isEvaluatingLoopBody.env.frames.length`
    // (assignment.ts:543) must compare against this number, not env's
    // current length — that live read is exactly why the first port of the
    // while-loop init gate false-fired on body-locals and was reverted.
    entry_frame_count : usize
  )
);
// ---------------------------------------------------------------------------
// Expected type hint
// ---------------------------------------------------------------------------
ExpectedTypeCtx :: ref(
  struct(
    ty : TypeValue,
    env : Environment
  )
);
// ---------------------------------------------------------------------------
// Captured variable info
// ---------------------------------------------------------------------------
/// Usage kind for a variable captured by a closure.
CaptureUsage :: enum(Read, Write, Own);
/// Information about a variable captured from an outer scope inside a closure
/// or async block.
CapturedVarInfo :: ref(
  struct(
    frame_level : usize,
    usage : CaptureUsage,
    token : Token
  )
);
// ---------------------------------------------------------------------------
// Specializing function state
// ---------------------------------------------------------------------------
/// Tracks a single in-progress generic function specialization.
SpecializingFunctionInfo :: ref(
  struct(
    original_func_id : String,
    specialized_func_id : String,
    /// The return type of the specialization in progress.
    specialized_return_type : TypeValue,
    /// The original (pre-specialization) function value.
    original_func_value : EvalValue,
    /// Signature of the impl generic bindings injected as `TypeVal` captures on
    /// the method value (`_inject_forall_captures`). TS gives each generic-impl
    /// method instantiation a UNIQUE funcId embedding its substitutions
    /// (impl.ts:1551), so its recursion guard never fires across
    /// instantiations; yo-self keeps ONE shared func_id and injects the
    /// bindings as captures instead — this field carries those bindings so the
    /// guard can distinguish `Eq(ArrayList(i32)).==` in progress from a nested
    /// call to `Eq(i32).==` (same func_id, different instantiation). Empty for
    /// plain generic functions — their guard stays bare-func_id (TS-faithful,
    /// including for polymorphic recursion).
    impl_bindings_sig : String
  )
);
// ---------------------------------------------------------------------------
// Impl concrete-type return tracking
// ---------------------------------------------------------------------------
/// One return-site's concrete type for `Impl(...)` return-type unification.
ImplConcreteTypeInfo :: ref(
  struct(
    concrete_type : TypeValue,
    env : Environment,
    token : Token
  )
);
// ---------------------------------------------------------------------------
// CTFE cache types
// ---------------------------------------------------------------------------
/// One cached call entry for a compile-time function.
///
/// Mirrors `CalledComptimeFunctionCache` in `src/function-value.ts`.
/// Simplified: `env` field dropped (we use callerEnv at lookup time);
/// `body` field dropped (ExprInfoTable makes AST re-evaluation safe).
CalledComptimeFnCache :: ref(
  struct(
    func_id : String,
    arg_values : ArrayList(EvalValue),
    /// `UnknownVal(ty)` for an in-progress recursive call; actual return value when done.
    value : EvalValue
  )
);
/// Per-function CTFE cache bucket, keyed by `func_id`.
///
/// Mirrors the per-`FunctionValue` `calledComptimeFunctionCaches` array in TS,
/// but stored globally in `EvalContext` instead of on the `FuncVal` to avoid
/// circular imports between `value.yo` and `env.yo`.
ComptimeFnCacheEntry :: ref(
  struct(
    func_id : String,
    caches : ArrayList(CalledComptimeFnCache)
  )
);
// ---------------------------------------------------------------------------
// Specialization cache types
// ---------------------------------------------------------------------------
/// One cached specialization of a generic function.
///
/// Mirrors `SpecializedFunctionCache` on TypeScript's `FunctionValue`.
/// Stored in the module-global `g_specialized_fn_caches` (calls/helper.yo,
/// keyed by `func_id`) rather than on `FuncVal`, to avoid updating ~24
/// pattern-match sites while matching TS's process-wide cache lifetime.
SpecializedFunctionCache :: ref(
  struct(
    /// The compile-time argument values (generic + implicit + comptime params)
    /// used to create this specialization.
    compile_time_arg_values : ArrayList(EvalValue),
    /// The concrete runtime parameter types that distinguish this specialization
    /// from others with the same compile-time args.
    runtime_parameter_types : ArrayList(TypeValue),
    /// The specialized function value (EvalValue.FuncVal with updated func_id).
    specialized_func_value : EvalValue,
    /// The environment at cache-creation time (for value equality checks).
    env : Environment
  )
);
/// Per-function bucket of specialization caches, keyed by `func_id`.
SpecializedFunctionCacheEntry :: ref(
  struct(
    func_id : String,
    caches : ArrayList(SpecializedFunctionCache)
  )
);
// ---------------------------------------------------------------------------
// Main EvaluatorContext
// ---------------------------------------------------------------------------
/// The evaluator context threaded through every expression evaluation.
///
/// Mirrors `EvaluatorContext` in `src/evaluator/context.ts`.
EvalContext :: ref(
  struct(
    /// Whether we are currently executing code (`true`) or just type-checking it.
    /// Prevents side effects like `comptime_print` from running during function
    /// definition.
    is_executing : bool,
    /// Whether we are validating a function definition (type-checking its body).
    is_validating_function_definition : bool,
    /// Depth of comptime-fn (CTFE) body evaluation currently in progress.
    /// 0 = module-level evaluation. Used by struct/enum declaration eval to
    /// mint DECLARATION-STABLE ids (derived from the declaration's ast id)
    /// for module-level declarations — every re-evaluation GENERATION of the
    /// same declaration then shares one identity, unifying the ctfe memo and
    /// the C-type registry across generations (SomeT surgery slice 2). Inside
    /// CTFE (> 0), ids stay eval-fresh: generic INSTANTIATIONS (Option(i32)
    /// vs Option(String) evaluate the same enum body via the constructor's
    /// ctfe) must NOT share ids — the recorded tk2/MapEntry failure of the
    /// naive ast-id swap, and the ctfe memo's same-enum-id rule would
    /// conflate instantiations.
    ctfe_depth : usize,
    /// Expected return type from the surrounding context.
    expected_type : Option(ExpectedTypeCtx),
    /// The innermost function body / async block / test block being evaluated.
    is_evaluating_function_body_or_async_block : Option(FuncOrAsyncBlockCtx),
    /// Whether we are inside an `impl(...)` block body.
    is_inside_impl_block : bool,
    /// Variables captured from outer scopes in the current closure / async block.
    captured_variables : Option(HashMap(String, CapturedVarInfo)),
    /// Subset of capturedVariables consumed via `own(self)` parameter passing.
    own_consumed_captures : Option(HashSet(String)),
    /// The innermost loop body being evaluated.
    is_evaluating_loop_body : Option(LoopBodyCtx),
    /// `Self` type for the innermost struct / enum / union definition.
    self_type : Option(TypeValue),
    /// `SelfTrait` type for the innermost trait definition.
    self_trait_type : Option(TypeValue),
    /// `SelfModule` type for the innermost module definition.
    self_module_type : Option(TypeValue),
    /// Receiver type for the innermost `impl(ReceiverType, ...)` block.
    receiver_type : Option(TypeValue),
    /// Whether we are evaluating a function type definition.
    is_evaluating_function_type : bool,
    /// Module loader callback.  Set by the module manager before evaluation
    /// starts and used by `import("...")` expressions.
    load_module : Option((fn(path : String) -> LoadModuleResult)),
    /// Absolute path to the standard library `std/` directory.
    std_path : String,
    /// Module path of the file currently being evaluated.
    current_module_path : Option(String),
    /// Whether the function type being evaluated is marked unsafe.
    is_unsafe_function_type : bool,
    /// Whether the expression currently being evaluated is inside an
    /// `unsafe(...)` block. Set by `evaluate_unsafe`; permits raw-pointer
    /// operations (deref/arith) within. Mirrors TS `EvaluatorContext.unsafeContext`.
    unsafe_context : bool,
    /// Whether the function type being evaluated was declared `ctl(...)
    /// -> ret`. Control functions may contain `unwind` in their body and
    /// are frame-bound (escape boundaries reject them).
    is_control_function_type : bool,
    /// Return type of the enclosing (parent) function; enables `unwind(expr)`.
    enclosing_function_return_type : Option(TypeValue),
    /// Whether the enclosing specialized function has control-flow implicit params.
    has_control_function_implicit_params : bool,
    /// Whether we are inside a where-clause constraint expression.
    is_inside_where_clause : bool,
    /// Whether we are evaluating the LHS of an assignment.
    is_lhs_of_assignment : bool,
    /// Shared mutable container tracking concrete return types of Impl(…) returns.
    function_return_impl_concrete_type : Option(ArrayList(ImplConcreteTypeInfo)),
    /// Force all variable bindings (including `:=`) to be compile-time.
    force_compile_time_bindings : bool,
    /// Whether we are analysing CTFE capability with `UnknownValue` parameters.
    is_analyzing_ctfe_capability : bool,
    /// Whether we are in the argument-checking phase of a function call.
    is_in_function_call_checking_phase : bool,
    /// Whether we are evaluating the closure argument of an `io.async(...)` call.
    is_inside_io_async_call : bool,
    /// Whether we are evaluating the RHS of a `given(...)` assignment.
    is_inside_given_handler : bool,
    /// Whether we are re-evaluating type expressions during generic impl specialisation.
    is_evaluating_generic_impl_specialization : bool,
    /// Innermost in-progress specialization (top of stack).
    currently_specializing_function : Option(SpecializingFunctionInfo),
    /// Full stack of in-progress specializations (for mutual recursion).
    currently_specializing_function_stack : Option(ArrayList(SpecializingFunctionInfo)),
    /// Doc-comment lookup table (position key → comment text).
    doc_comment_lookup : Option(HashMap(String, String)),
    /// Side-table for expression evaluation results (replaces TypeScript's `expr.$` mutation).
    expr_info_table : ExprInfoTable,
    /// CTFE call cache — per-function buckets keyed by `func_id`.
    ///
    /// Stored here (rather than on `FuncVal`) to avoid a circular import between
    /// `value.yo` and `env.yo`.  Each entry holds the cached call results for
    /// one compile-time function.
    comptime_fn_caches : ArrayList(ComptimeFnCacheEntry),
    /// Working-trait field bindings for the trait constructor CURRENTLY
    /// being implemented inside an `impl(...)` block — parallel
    /// label/value arrays. Mirrors TS attaching the progressively-updated
    /// `workingTraitType` to `receiverType.trait` (trait-type.ts:151-203)
    /// so `Self.X` resolves to fields already bound in the SAME trait
    /// entry (e.g. `Output : T` before `index : fn(...) -> *(Self.Output)`);
    /// yo-self TypeValues have value semantics (no trait slot), so the
    /// in-flight bindings live on the context, consulted by
    /// property_access's working-trait associated-type fallback.
    current_impl_trait_field_labels : ArrayList(String),
    current_impl_trait_field_types : ArrayList(TypeValue),
    /// One-shot carrier for a method call's CONCRETE receiver type, set by
    /// the method-call dispatch just before `try_to_call_function_with_arguments`
    /// and consumed (read + cleared) at its entry — the port channel for TS's
    /// `functionType.SelfType` (helper.ts:1015 binds "Self" into calleeEnv
    /// from it). A dedicated field, NOT `self_type`: `self_type` is visible
    /// to the whole body evaluation and repurposing it changed specialization
    /// behavior broadly (measured: fs/temp + sys/bufio runtime regressions).
    pending_method_self_type : Option(TypeValue)
  )
);
/// Create a minimal execution context with sensible defaults.
eval_context_new :: (fn(std_path : String, module_path : String) -> EvalContext)(
  EvalContext(
    is_executing : false,
    is_validating_function_definition : false,
    ctfe_depth : usize(0),
    expected_type : Option(ExpectedTypeCtx).None,
    is_evaluating_function_body_or_async_block : Option(FuncOrAsyncBlockCtx).None,
    is_inside_impl_block : false,
    captured_variables : Option(HashMap(String, CapturedVarInfo)).None,
    own_consumed_captures : Option(HashSet(String)).None,
    is_evaluating_loop_body : Option(LoopBodyCtx).None,
    self_type : Option(TypeValue).None,
    self_trait_type : Option(TypeValue).None,
    self_module_type : Option(TypeValue).None,
    receiver_type : Option(TypeValue).None,
    is_evaluating_function_type : false,
    load_module : Option((fn(path : String) -> LoadModuleResult)).None,
    std_path : std_path,
    current_module_path : Option(String).Some(module_path),
    is_unsafe_function_type : false,
    unsafe_context : false,
    is_control_function_type : false,
    enclosing_function_return_type : Option(TypeValue).None,
    has_control_function_implicit_params : false,
    is_inside_where_clause : false,
    is_lhs_of_assignment : false,
    function_return_impl_concrete_type : Option(ArrayList(ImplConcreteTypeInfo)).None,
    force_compile_time_bindings : false,
    is_analyzing_ctfe_capability : false,
    is_in_function_call_checking_phase : false,
    is_inside_io_async_call : false,
    is_inside_given_handler : false,
    is_evaluating_generic_impl_specialization : false,
    currently_specializing_function : Option(SpecializingFunctionInfo).None,
    currently_specializing_function_stack : Option(ArrayList(SpecializingFunctionInfo)).None,
    doc_comment_lookup : Option(HashMap(String, String)).None,
    expr_info_table : expr_info_table_new(),
    comptime_fn_caches : ArrayList(ComptimeFnCacheEntry).new(),
    current_impl_trait_field_labels : ArrayList(String).new(),
    current_impl_trait_field_types : ArrayList(TypeValue).new(),
    pending_method_self_type : Option(TypeValue).None
  )
);
// ---------------------------------------------------------------------------
// ArgValues
// ---------------------------------------------------------------------------
/// One entry in the args / forallArgs / implicitArgs / variadicArgs arrays.
ArgEntry :: ref(
  struct(
    value : Option(EvalValue),
    parameter_type : TypeValue,
    arg_type : TypeValue
  )
);
/// Variadic argument entry (no parameterType).
VarArgEntry :: ref(
  struct(
    value : Option(EvalValue),
    arg_type : TypeValue
  )
);
/// Mirrors `ArgValues` in `src/evaluator/context.ts`.
ArgValues :: ref(
  struct(
    forall_args : ArrayList(ArgEntry),
    args : ArrayList(ArgEntry),
    implicit_args : Option(ArrayList(ArgEntry)),
    variadic_args : ArrayList(VarArgEntry)
  )
);
// ---------------------------------------------------------------------------
// FunctionCallResult
// ---------------------------------------------------------------------------
/// Mirrors `FunctionCallResult` in `src/evaluator/context.ts`.
FuncCallResult :: ref(
  struct(
    callee_env : Environment,
    caller_env : Environment,
    path_collection : PathCollection,
    return_type : TypeValue,
    return_value : Option(EvalValue),
    arg_values : ArgValues,
    runtime_arg_exprs_in_order : ArrayList(AstExpr),
    /// The specialized FuncVal, if the function had compile-time parameters.
    specialized_function_value : Option(EvalValue),
    /// Drop expressions for RC cleanup of temporary function arguments.
    deferred_drop_expressions : Option(ArrayList(AstExpr))
  )
);
// ---------------------------------------------------------------------------
// ComptimeFnCallResult
// ---------------------------------------------------------------------------
/// Result from `evaluate_comptime_fn_call`.
///
/// Mirrors the anonymous return type of `evaluateComptimeFunctionCall` in
/// `src/evaluator/calls/comptime-fn.ts`.
ComptimeFnCallResult :: ref(
  struct(
    value : EvalValue,
    caller_env : Environment,
    callee_env : Environment,
    /// ComptimeRef from the evaluated function body, so callers (e.g. the
    /// ComptimeIndex dispatch) can treat the result as a comptime place.
    /// Mirrors `comptimeRef: evaluatedFunctionBody.$.comptimeRef`
    /// (TS comptime-fn.ts:297).
    comptime_ref : Option(ComptimeRef)
  )
);
// ---------------------------------------------------------------------------
// TypeCallResult
// ---------------------------------------------------------------------------
/// Mirrors `TypeCallResult`.
TypeCallResult :: ref(
  struct(
    values : ArrayList(Option(EvalValue)),
    path_collection : PathCollection,
    runtime_arg_exprs_in_order : ArrayList(AstExpr),
    caller_env : Environment
  )
);
// ---------------------------------------------------------------------------
// Module / trait / macro / numeric / pointer / index call results
// ---------------------------------------------------------------------------
/// Mirrors `ModuleTypeCallResult`.
ModuleTypeCallResult :: ref(
  struct(
    module_value : EvalValue,
    caller_env : Environment
  )
);
/// Mirrors `TraitTypeCallResult`.
TraitTypeCallResult :: ref(
  struct(
    trait_value : EvalValue,
    caller_env : Environment
  )
);
/// Mirrors `TraitSpecializationResult`.
TraitSpecializationResult :: ref(
  struct(
    specialized_trait_type : TypeValue,
    caller_env : Environment
  )
);
/// Mirrors `MacroFunctionCallResult`.
MacroFuncCallResult :: ref(
  struct(
    callee_env : Environment,
    caller_env : Environment,
    return_expr : AstExpr
  )
);
/// Mirrors `NumericTypeCallResult`.
NumericTypeCallResult :: ref(
  struct(
    expr : AstExpr,
    env : Environment
  )
);
/// Mirrors `PointerTypeCallResult`.
PointerTypeCallResult :: ref(
  struct(
    expr : AstExpr,
    env : Environment
  )
);
/// Mirrors `IndexCallResult`.
IndexCallResult :: ref(
  struct(
    /// Auto-dereferenced value (Output type, not *(Output)).
    value : Option(EvalValue),
    /// Auto-dereferenced type (Output).
    ty : TypeValue,
    /// Pointer type before auto-deref: *(Output).
    ptr_type : TypeValue,
    /// Specialised function type of the index method.
    index_method_type : Option(TypeValue),
    /// Specialised function value of the index method.
    index_method_value : Option(EvalValue),
    caller_env : Environment,
    /// Compile-time index, if known (for array element assignment).
    index : Option(usize),
    /// Compile-time element/field reference produced by a ComptimeIndex
    /// dispatch, enabling `p(0) = v` and `&(p(0))` at compile time.
    /// Mirrors `IndexCallResult.comptimeRef` (src/evaluator/context.ts:449).
    comptime_ref : Option(ComptimeRef)
  )
);
// ---------------------------------------------------------------------------
// FunctionToCall — result discriminated union
// ---------------------------------------------------------------------------
/// Discriminated union of all possible results from a call dispatch.
///
/// Mirrors the anonymous union type on `FunctionToCall.result` in
/// `src/evaluator/context.ts`.
CallResultKind :: enum(
  /// Result from tryToCallFunctionWithArguments.
  FunctionResult(result : FuncCallResult),
  /// Result from tryToCallTypeWithArguments.
  TypeResult(result : TypeCallResult),
  /// Result from tryToImplementFunctionByFunctionType (no payload).
  FunctionTypeResult,
  /// Result from tryToImplementArrayByArrayType (no payload).
  ArrayTypeResult,
  /// Result from tryToImplementClosureByClosureType (no payload).
  ClosureTypeResult,
  /// Result from tryToImplementModuleWithArguments.
  ModuleTypeResult(result : ModuleTypeCallResult),
  /// Result from tryToImplementTraitWithArguments.
  TraitTypeResult(result : TraitTypeCallResult),
  /// Result from trait specialization via `:=` args.
  TraitSpecializationResult(result : TraitSpecializationResult),
  /// Result from tryToConvertToNumericType.
  NumericTypeResult(result : NumericTypeCallResult),
  /// Result from tryToConvertToPointerType.
  PointerTypeResult(result : PointerTypeCallResult),
  /// Result from evaluateIsoValueCall.
  IsoValueResult(call_expr : AstExpr),
  /// Result from tryToCallWithIndexTrait.
  IndexResult(result : IndexCallResult),
  /// An error occurred during call dispatch.
  ErrorResult(message : String)
);
/// Mirrors `FunctionToCall` in `src/evaluator/context.ts`.
FunctionToCall :: ref(
  struct(
    ty : TypeValue,
    args : Option(ArrayList(AstExpr)),
    value : Option(EvalValue),
    result : CallResultKind
  )
);
// ---------------------------------------------------------------------------
// Convenience extractors (mirrors getFunctionCallResult, etc.)
// ---------------------------------------------------------------------------
get_function_call_result :: (fn(ftc : FunctionToCall) -> Option(FuncCallResult))(
  match(
    ftc.result,
    .FunctionResult(r) => Option(FuncCallResult).Some(r),
    _ => Option(FuncCallResult).None
  )
);
get_type_call_result :: (fn(ftc : FunctionToCall) -> Option(TypeCallResult))(
  match(
    ftc.result,
    .TypeResult(r) => Option(TypeCallResult).Some(r),
    _ => Option(TypeCallResult).None
  )
);
get_module_type_call_result :: (fn(ftc : FunctionToCall) -> Option(ModuleTypeCallResult))(
  match(
    ftc.result,
    .ModuleTypeResult(r) => Option(ModuleTypeCallResult).Some(r),
    _ => Option(ModuleTypeCallResult).None
  )
);
get_trait_type_call_result :: (fn(ftc : FunctionToCall) -> Option(TraitTypeCallResult))(
  match(
    ftc.result,
    .TraitTypeResult(r) => Option(TraitTypeCallResult).Some(r),
    _ => Option(TraitTypeCallResult).None
  )
);
get_index_call_result :: (fn(ftc : FunctionToCall) -> Option(IndexCallResult))(
  match(
    ftc.result,
    .IndexResult(r) => Option(IndexCallResult).Some(r),
    _ => Option(IndexCallResult).None
  )
);
get_pointer_type_call_result :: (fn(ftc : FunctionToCall) -> Option(PointerTypeCallResult))(
  match(
    ftc.result,
    .PointerTypeResult(r) => Option(PointerTypeCallResult).Some(r),
    _ => Option(PointerTypeCallResult).None
  )
);
// ---------------------------------------------------------------------------
// trackVariableUsage
// ---------------------------------------------------------------------------
/// Track usage of a variable inside a closure or async block.
///
/// Mirrors `trackVariableUsage` in `src/evaluator/context.ts`.
///
/// - Skips compile-time-only variables (they are not captured at runtime).
/// - Only tracks variables from outer scopes (frame_level < eval_env.frame_count).
/// - Promotes usage type: `own` > `write` > `read`.
///
/// `context` is modified in-place.
/// `track_variable_usage`, with the CALLER-RESOLVED binding's
/// `is_compile_time_only` flag. The tracker re-finds the name in the
/// closure ctx's `eval_env`, which for a DEFERRED generic fn is the
/// DEF-TIME generation — where concrete-typed params are bound
/// compile-time-only placeholders. Gating on THAT stale binding dropped
/// runtime params (`buf`/`size`) from the closure capture while keeping
/// `r`/`io` (whose def-time bindings happen to be runtime), so the emitted
/// C read the dropped names as bare identifiers or garbage
/// (issues/fixed/async-loop-awaiting-buffer-taking-method-state-machine-corruption.md,
/// facet 1). TS is immune: its envs are per-generation, so the re-found
/// binding IS the resolved one. Pass `.Some(resolved.is_compile_time_only)`
/// from identifier resolution; `.None` keeps the legacy stale-binding gate
/// for callers that have no resolved binding at hand.
track_variable_usage_resolved :: (
  fn(
    variable_name : String,
    frame_level : usize,
    usage : CaptureUsage,
    token : Token,
    context : EvalContext,
    resolved_is_comptime : Option(bool)
  ) -> unit
)(
  // Only track when we are inside a function body or async block.
  match(
    context.is_evaluating_function_body_or_async_block,
    .None => (),
    .Some(sub_ctx) => {
      eval_env := sub_ctx.eval_env;
      // Only track variables from outer scopes.
      if(frame_level >= eval_env.frame_count(), {
        return(());
      });
      // Find the variable in the evaluation environment. Per-frame, use the
      // name index when available (see Frame.name_index / _frame_positions —
      // the same fast path get_variables_from_env uses) with the original
      // linear scan as the small-frame fallback: this walk runs once per
      // tracked identifier read under scope-end drop evaluation, and the
      // blind per-candidate `v.name == variable_name` String compares (each
      // paying an Rc incr/decr pair) dominated heavy `check` runs. Semantics
      // identical: first match, outermost frame first (TS context.ts:671
      // does the same frames[i].variables.find scan — cheap there because
      // JS string === has no RC cost).
      var_found := Option(Variable).None;
      actual_frame_level := usize(0);
      fi := usize(0);
      n_frames := eval_env.frame_count();
      while(fi < n_frames, {
        frame_opt := eval_env.frames.get(fi);
        match(
          frame_opt,
          .Some(frame) => {
            match(
              _frame_positions(frame, variable_name),
              .Some(ps) => {
                if(ps.len() > usize(0), {
                  match(
                    ps.get(usize(0)),
                    .Some(pos) => match(
                      frame.variables.get(pos),
                      .Some(v) => {
                        var_found = Option(Variable).Some(v);
                        actual_frame_level = fi;
                        fi = n_frames; // break outer loop
                      },
                      .None => ()
                    ),
                    .None => ()
                  );
                });
              },
              .None => {
                vi := usize(0);
                n_vars := frame.variables.len();
                while(vi < n_vars, {
                  match(
                    frame.variables.get(vi),
                    .Some(v) => {
                      if(v.name == variable_name, {
                        var_found = Option(Variable).Some(v);
                        actual_frame_level = fi;
                        vi = n_vars; // break inner loop
                        fi = n_frames; // break outer loop
                      });
                    },
                    .None => ()
                  );
                  vi = (vi + usize(1));
                });
              }
            );
          },
          .None => ()
        );
        fi = (fi + usize(1));
      });
      match(
        var_found,
        .None => (),
        .Some(v) => {
          // A variable found in the TOP frame of a function body's eval_env
          // is the function's OWN parameter — every body-context creator
          // pushes the parameters frame before creating the context (TS:
          // function-type.ts:380, closure-type.ts:67, anonymous-function.ts:340).
          // Parameters are not captures: recording them made the scope-end
          // drop filter skip the drop of any `own` parameter the body
          // referenced (issues/fixed/own-param-discard-leak.md). Mirrors
          // src/evaluator/context.ts trackVariableUsage.
          is_fn_body := match(sub_ctx.kind, .FunctionBody => true, _ => false);
          if(ctx_dbg_env.get(`YO_DEBUG_CAPTURE`).is_some(), {
            trk_top := (is_fn_body && (actual_frame_level == (eval_env.frame_count() - usize(1))));
            eprintln(`[cap-track] name=${variable_name} actual_fl=${actual_frame_level.to_string()} ev_count=${eval_env.frame_count().to_string()} top_excl=${trk_top.to_string()} cto=${v.is_compile_time_only.to_string()}`);
          });
          if(is_fn_body && (actual_frame_level == (eval_env.frame_count() - usize(1))), {
            return(());
          });
          // A MODULE-level global is not a capture: it lowers to a
          // process-global C symbol (module-mangled; see
          // issues/fixed/module-global-c-names-are-not-namespaced.md), so
          // capturing it adds a phantom capture-struct member the C never
          // declares while some use sites still emit the raw name — a plain
          // closure OR an async closure body referencing a module global
          // then fails the C compile
          // (issues/module-global-referenced-inside-async-closure-undeclared.md;
          // measured: the inline-anon and io.async shapes both break, the
          // module-level named fn works). Cross-module globals never reach
          // here — they resolve through `mod.name` property access.
          if(is_module_level_global(eval_env.module_path, variable_name.clone()), {
            return(());
          });
          // Don't track compile-time-only variables — judged by the
          // CALLER-RESOLVED binding when provided (current generation), not
          // the re-found one (possibly a stale def-time placeholder).
          effective_cto := match(resolved_is_comptime, .Some(rc) => rc, .None => v.is_compile_time_only);
          if(effective_cto, {
            return(());
          });
          // Ensure the capturedVariables map exists.
          match(
            context.captured_variables,
            .None => {
              context.captured_variables = Option(HashMap(String, CapturedVarInfo)).Some(
                HashMap(String, CapturedVarInfo).new()
              );
            },
            .Some(_) => ()
          );
          // Compute the promoted usage type.
          effective_usage := match(
            context.captured_variables,
            .None => usage,
            .Some(map) => match(
              map.get(variable_name),
              .None => usage,
              .Some(existing) => match(
                existing.usage,
                .Own => CaptureUsage.Own,
                .Write => match(usage, .Read => CaptureUsage.Write, _ => usage),
                .Read => usage
              )
            )
          );
          new_entry := CapturedVarInfo(
            frame_level : actual_frame_level,
            usage : effective_usage,
            token : token
          );
          match(
            context.captured_variables,
            .Some(map) => {
              map.insert(variable_name, new_entry);
            },
            .None => ()
          );
        }
      );
    }
  )
);
// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------
// --- deferred def-eval re-run hook (fn arm 14: mutual comptime recursion) --
// A fn defined while a forward-declared comptime fn variable is still
// VALUELESS (`comptime(is_odd) : (fn ...)`; is_even's body references it)
// records call-site ExprInfos with no FuncVal — codegen's fn-pointer
// fallback then emits the raw identifier. TS re-records on its later
// evaluations of the SHARED body nodes; yo-self re-runs the def-time trial
// eval after the forward declaration is FILLED (assignment.yo calls
// through this hook into function_type.yo's pending table).
RerunPendingDefEvalsFn :: (fn(env : Environment, ctx : EvalContext) -> unit);
(g_rerun_pending_def_evals_fn : Option(RerunPendingDefEvalsFn)) = Option(RerunPendingDefEvalsFn).None;
set_rerun_pending_def_evals_fn :: (fn(f : RerunPendingDefEvalsFn) -> unit)({
  g_rerun_pending_def_evals_fn = Option(RerunPendingDefEvalsFn).Some(f);
  ()
});
call_rerun_pending_def_evals :: (fn(env : Environment, ctx : EvalContext) -> unit)(
  match(
    g_rerun_pending_def_evals_fn,
    .Some(f) => f(env, ctx),
    .None => ()
  )
);
// --- P0 forward-reference diagnostic plumbing (plans/LAZY_TOPLEVEL_BINDINGS.md §4.6) ---
// The module walker (values/anonymous_module.yo) records the begin_exprs
// list it is currently walking and how far in it is, so a def-time trial
// that swallows an unbound-name error (calls/function_type.yo's trial cell)
// can tell "bound LATER in this module" from "never bound" — the former is
// a forward reference, which must ERROR at check time instead of hollowing
// the body silently. Nested module loads save/restore around their own
// walks, so a nested import cannot smear its list over the importer's.
// Accessors rather than shared-state imports: module-level mutable
// variables are written reliably only through their OWN module's functions
// (the g_rerun_pending_def_evals_fn pattern directly above).
(g_module_begin_exprs : Option(ArrayList(AstExpr))) = Option(ArrayList(AstExpr)).None;
(g_module_begin_expr_index : usize) = usize(0);
set_module_walk :: (fn(exprs : ArrayList(AstExpr)) -> unit)({
  g_module_begin_exprs = Option(ArrayList(AstExpr)).Some(exprs);
  ()
});
set_module_walk_index :: (fn(idx : usize) -> unit)({
  g_module_begin_expr_index = idx;
  ()
});
restore_module_walk :: (fn(prev : Option(ArrayList(AstExpr)), prev_idx : usize) -> unit)({
  g_module_begin_exprs = prev;
  g_module_begin_expr_index = prev_idx;
  ()
});
get_module_begin_exprs :: (fn() -> Option(ArrayList(AstExpr)))(g_module_begin_exprs);
get_module_begin_expr_index :: (fn() -> usize)(g_module_begin_expr_index);
/// Does this binding LHS bind `name`? (Atom head, `comptime(X) ...`, a typed
/// `(X : T)` head — the module-global spelling `(g : T) = v` — or a
/// parenthesized/annotated head by source-text equality. The wrappers are
/// peeled ITERATIVELY — self-recursion is not visible to a def-time body
/// trial, the very limitation §4.6 exists to diagnose.)
lhs_binds_name :: (fn(lhs : AstExpr, name : String) -> bool)({
  (cur : AstExpr) = lhs;
  while(ast_expr_is_fn_call_of(cur, BK_COMPTIME, .Some(usize(1))) || ast_expr_is_fn_call_of(cur, BK_COLON, .Some(usize(2))), {
    cur = match(
      cur,
      .FnCall(_, _, cargs, _, _) => match(
        cargs.get(usize(0)),
        .Some(inner) => inner,
        .None => cur
      ),
      .Atom(_, _) => cur
    );
  });
  cond(
    ast_expr_is_atom(cur) => (ast_expr_token(cur).value == name),
    true => (ast_expr_to_string(cur) == name)
  )
});
/// Does this module-level expression bind `name`? (`X :: rhs` / `X : rhs` /
/// `X = rhs` / `comptime(X) := ...` / `impl(X, ...)`.)
module_expr_binds_name :: (fn(e : AstExpr, name : String) -> bool)(
  cond(
    // `impl(X, Trait(...))` binds X's inherent/trait methods.
    ast_expr_is_fn_call_of(e, BK_IMPL_LOWER, .None) =>
      match(
        e,
        .FnCall(_, _, iargs, _, _) => match(
          iargs.get(usize(0)),
          .Some(first) => (ast_expr_to_string(first) == name),
          .None => false
        ),
        .Atom(_, _) => false
      ),
    // `X :: rhs` / `X : rhs` / `X = rhs` (module-level bindings).
    (ast_expr_is_fn_call_of(e, BK_CONST, .Some(usize(2))) || ast_expr_is_fn_call_of(e, BK_COLON, .Some(usize(2))) || ast_expr_is_fn_call_of(e, BK_ASSIGN, .Some(usize(2)))) =>
      match(
        e,
        .FnCall(_, _, args, _, _) => match(
          args.get(usize(0)),
          .Some(lhs) => lhs_binds_name(lhs, name),
          .None => false
        ),
        .Atom(_, _) => false
      ),
    // `comptime(X) := ...` at module level.
    ast_expr_is_fn_call_of(e, BK_COMPTIME, .None) =>
      match(
        e,
        .FnCall(_, _, cargs, _, _) => match(
          cargs.get(usize(0)),
          .Some(lhs) => lhs_binds_name(lhs, name),
          .None => false
        ),
        .Atom(_, _) => false
      ),
    true => false
  )
);
/// P0 (plans/LAZY_TOPLEVEL_BINDINGS.md §4.6): a def-time trial that swallowed
/// `Variable "X" not found.` where X IS bound later in the module walk is a
/// forward reference. Returns the diagnostic to re-raise (None when the
/// message is not that shape, or the name is not bound later — a genuine
/// typo keeps today's behavior).
forward_ref_diagnostic :: (fn(msg : String) -> Option(String))({
  marker := String.from("Variable \"");
  match(
    msg.index_of(marker),
    .None => Option(String).None,
    .Some(ms) => {
      after := (ms + marker.len());
      match(
        msg.index_of(String.from("\""), after),
        .None => Option(String).None,
        .Some(me) => {
          name := msg.substring(after, me);
          match(
            g_module_begin_exprs,
            .None => Option(String).None,
            .Some(exprs) => {
              n := exprs.len();
              (j : usize) = (g_module_begin_expr_index + usize(1));
              (found_row : Option(usize)) = Option(usize).None;
              while((j < n) && found_row.is_none(), {
                match(
                  exprs.get(j),
                  .Some(e) => {
                    if(module_expr_binds_name(e, name), {
                      found_row = Option(usize).Some(ast_expr_token(e).row);
                    });
                  },
                  .None => ()
                );
                j = (j + usize(1));
              });
              match(
                found_row,
                .Some(row) => Option(String).Some(
                  `forward reference to "${name}" (bound at line ${(row + usize(1)).to_string()}) — imports, opens, pragmas and runtime bindings are evaluated in order (only \`::\` definitions and \`impl\` registrations are order-independent); move that statement above this use`
                ),
                .None => Option(String).None
              )
            }
          )
        }
      )
    }
  )
});
/// The swallow classes that must surface at check time even from the SILENT
/// trial sites (the deferred-generic trials, TS ts:112 catch parity):
/// forward references get the enriched diagnostic above, and an ARITY
/// mismatch against the resolved callee is knowable at def time — the hole
/// that shipped broken `yo version install` in v0.2.19/v0.2.20: check stayed
/// green, the swallow ate "Argument count mismatch", and the async state
/// machine emitted a too-few-arguments C call (UB — garbage values, not an
/// error). issues/fixed/wrong-arity-call-silently-accepted-version-install-broken.md.
hard_swallow_diagnostic :: (fn(msg : String) -> Option(String))(
  match(
    forward_ref_diagnostic(msg),
    .Some(fwd) => Option(String).Some(fwd),
    .None =>
      cond(
        msg.contains(String.from("Argument count mismatch")) => {
          // The swallowed dyn-message often already carries an "Error: "
          // prefix; format_error_message adds its own — strip one to avoid
          // "Error: Error:".
          err_prefix := String.from("Error: ");
          cond(
            msg.starts_with(err_prefix) => Option(String).Some(msg.substring(err_prefix.len(), msg.len())),
            true => Option(String).Some(msg)
          )
        },
        true => Option(String).None
      )
  )
);
// --- Lazy top-level bindings (plans/LAZY_TOPLEVEL_BINDINGS.md §4, P1 + P2) ---
//
// A module walk (values/anonymous_module.yo) PRE-SCANS its begin_exprs and
// records every deferrable statement — a `name :: <rhs>` definition (P1) or an
// `impl(<receiver>, ...)` registration (P2) — as a PendingDef. The walk still
// evaluates statements in source order, but a statement whose entry was
// already FORCED by an earlier reference is skipped. Forcing happens ONLY on a
// lookup MISS (`evaluate_identifier_and_operator`'s "Variable not found" path,
// `export(...)`, and the fatal method/trait-miss sites for impls), which is
// exactly the set of programs that fail to compile today — so for every
// order-correct program force order == source order and nothing observable
// changes (the byte-identity acceptance test, plan §6).
//
// The model lives HERE (every evaluator module imports context.yo) while the
// forcing itself — which needs `evaluate_expression_raw` — is installed by
// anonymous_module.yo through `set_force_pending_def_fn` (the
// g_rerun_pending_def_evals_fn pattern: a fn slot cannot take the propagating
// `Exception`, so the forcer reports failure as a message and the caller, which
// has `exn` in scope, throws it).
PendingDefState :: enum(Unforced, Forcing, Done, Failed);
/// One deferred module-level statement.
PendingDef :: ref(
  struct(
    /// The bound name (`name :: …`), or the receiver head atom of an `impl`
    /// (`File` in `impl(File, …)`, `ArrayList` in `impl(generic(T), ArrayList(T), …)`;
    /// empty when the head is not nameable — such impls force at any miss).
    name : String,
    /// The whole statement — evaluated verbatim when forced.
    expr : AstExpr,
    /// Position in the walk's begin_exprs (the walker skips a Done entry there).
    index : usize,
    row : usize,
    is_impl : bool,
    state : PendingDefState,
    failure : Option(String),
    /// Phase A (§4.3): the FuncVal + Func type that
    /// `try_to_implement_function_by_function_type` publishes once the RHS's
    /// signature head is evaluated and BEFORE the body trial runs. A reference to
    /// this name from inside its own body (self-recursion) or from a sibling it
    /// forced (mutual recursion) binds this value instead of erroring.
    phase_a_value : Option(EvalValue),
    phase_a_type : Option(TypeValue),
    /// The module-frame Variable once bound — pre-bound from phase A on a
    /// re-entrant reference, otherwise the one the definition's own evaluation
    /// added to the module frame.
    variable : Option(Variable)
  )
);
/// One active module walk. `ctx` is a COPY of the walker's context taken at
/// walk start: a forced statement must evaluate as a module-level statement
/// (no enclosing fn body, no expected type, no impl Self) even when the
/// reference that forces it sits deep inside a def-time body trial.
ModuleWalk :: ref(
  struct(
    module_path : String,
    begin_exprs : ArrayList(AstExpr),
    env : Environment,
    /// `Frame.id` of the walk's module frame: the forcer truncates the walker's
    /// live frame list at this frame (a module-level `{ … }` block may have
    /// pushed frames above it) so the forced definition binds INTO the module
    /// frame, where every later lookup finds it.
    module_frame_id : usize,
    ctx : EvalContext,
    defs : ArrayList(PendingDef),
    /// index in begin_exprs → its entry (the walker's per-statement check).
    by_index : HashMap(usize, PendingDef)
  )
);
(g_module_walks : ArrayList(ModuleWalk)) = ArrayList(ModuleWalk).new();
/// Entries currently being forced, outermost first — the cycle chain
/// (`a → b → a`) and the phase-A publication target.
(g_forcing_stack : ArrayList(PendingDef)) = ArrayList(PendingDef).new();
/// Finished walks' definitions by module path. A generic fn body is
/// re-evaluated at SPECIALIZATION time from its definition-time capture
/// snapshot (a frozen frame copy); a definition forced after that snapshot was
/// taken is not in it, so the miss hook resolves the name from here once the
/// walk is over. Only names this mechanism bound are ever served — never a
/// runtime module global, which a stripped fn env must keep hiding.
(g_finished_walks : HashMap(String, ModuleWalk)) = HashMap(String, ModuleWalk).new();
/// The forcer slot. Returns `.None` on success, `.Some(message)` on failure.
ForcePendingDefFn :: (fn(walk : ModuleWalk, def : PendingDef) -> Option(String));
(g_force_pending_def_fn : Option(ForcePendingDefFn)) = Option(ForcePendingDefFn).None;
set_force_pending_def_fn :: (fn(f : ForcePendingDefFn) -> unit)({
  g_force_pending_def_fn = Option(ForcePendingDefFn).Some(f);
  ()
});
/// Shallow copy of an EvalContext — every field, the shared tables
/// (`expr_info_table`, `comptime_fn_caches`, `load_module`) by reference.
copy_eval_context :: (fn(ctx : EvalContext) -> EvalContext)(
  EvalContext(
    is_executing : ctx.is_executing,
    is_validating_function_definition : ctx.is_validating_function_definition,
    ctfe_depth : ctx.ctfe_depth,
    expected_type : ctx.expected_type,
    is_evaluating_function_body_or_async_block : ctx.is_evaluating_function_body_or_async_block,
    is_inside_impl_block : ctx.is_inside_impl_block,
    captured_variables : ctx.captured_variables,
    own_consumed_captures : ctx.own_consumed_captures,
    is_evaluating_loop_body : ctx.is_evaluating_loop_body,
    self_type : ctx.self_type,
    self_trait_type : ctx.self_trait_type,
    self_module_type : ctx.self_module_type,
    receiver_type : ctx.receiver_type,
    is_evaluating_function_type : ctx.is_evaluating_function_type,
    load_module : ctx.load_module,
    std_path : ctx.std_path,
    current_module_path : ctx.current_module_path,
    is_unsafe_function_type : ctx.is_unsafe_function_type,
    unsafe_context : ctx.unsafe_context,
    is_control_function_type : ctx.is_control_function_type,
    enclosing_function_return_type : ctx.enclosing_function_return_type,
    has_control_function_implicit_params : ctx.has_control_function_implicit_params,
    is_inside_where_clause : ctx.is_inside_where_clause,
    is_lhs_of_assignment : ctx.is_lhs_of_assignment,
    function_return_impl_concrete_type : ctx.function_return_impl_concrete_type,
    force_compile_time_bindings : ctx.force_compile_time_bindings,
    is_analyzing_ctfe_capability : ctx.is_analyzing_ctfe_capability,
    is_in_function_call_checking_phase : ctx.is_in_function_call_checking_phase,
    is_inside_io_async_call : ctx.is_inside_io_async_call,
    is_inside_given_handler : ctx.is_inside_given_handler,
    is_evaluating_generic_impl_specialization : ctx.is_evaluating_generic_impl_specialization,
    currently_specializing_function : ctx.currently_specializing_function,
    currently_specializing_function_stack : ctx.currently_specializing_function_stack,
    doc_comment_lookup : ctx.doc_comment_lookup,
    expr_info_table : ctx.expr_info_table,
    comptime_fn_caches : ctx.comptime_fn_caches,
    current_impl_trait_field_labels : ctx.current_impl_trait_field_labels,
    current_impl_trait_field_types : ctx.current_impl_trait_field_types,
    pending_method_self_type : ctx.pending_method_self_type
  )
);
/// The syntactic head name of an `impl` receiver: the atom itself, the callee
/// atom of a type application (`ArrayList(T)` → `ArrayList`), the member of a
/// property access (`Mod.Ty` → `Ty`). Empty when none applies.
impl_receiver_head_name :: (fn(recv : AstExpr) -> String)(
  cond(
    ast_expr_is_atom(recv) => ast_expr_token(recv).value.clone(),
    ast_expr_is_fn_call_of(recv, BF_DOT, .Some(usize(2))) =>
      match(
        recv,
        .FnCall(_, _, dargs, _, _) => match(
          dargs.get(usize(1)),
          .Some(member) => cond(ast_expr_is_atom(member) => ast_expr_token(member).value.clone(), true => String.new()),
          .None => String.new()
        ),
        .Atom(_, _) => String.new()
      ),
    ast_expr_is_fn_call(recv) =>
      match(
        recv,
        .FnCall(_, callee, _, _, _) => cond(
          (ast_expr_is_atom(callee) && !(ast_expr_is_atom_and_operator(callee))) => ast_expr_token(callee).value.clone(),
          true => String.new()
        ),
        .Atom(_, _) => String.new()
      ),
    true => String.new()
  )
);
_make_pending_def :: (fn(name : String, e : AstExpr, index : usize, is_impl : bool) -> Option(PendingDef))(
  Option(PendingDef).Some(
    PendingDef(
      name : name,
      expr : e,
      index : index,
      row : ast_expr_token(e).row,
      is_impl : is_impl,
      state : PendingDefState.Unforced,
      failure : Option(String).None,
      phase_a_value : Option(EvalValue).None,
      phase_a_type : Option(TypeValue).None,
      variable : Option(Variable).None
    )
  )
);
/// Classify one module-level statement. `.Some(def)` for a deferrable
/// statement, `.None` for an ordered one (imports, opens, pragmas, runtime
/// globals, destructurings, bare expressions, exports).
///
/// Deferrable: `name :: rhs` with an atom LHS whose rhs is not a bare
/// `import(...)` (an import binding is an ordered statement: its effects —
/// loading the module, registering its impls — are the module's observable
/// evaluation), and `impl(<receiver>, ...)` other than the anonymous
/// `impl({ ... })` block form.
classify_pending_def :: (fn(e : AstExpr, index : usize) -> Option(PendingDef))(
  cond(
    ast_expr_is_fn_call_of(e, BK_CONST, .Some(usize(2))) => match(
      e,
      .FnCall(_, _, cargs, _, _) => {
        lhs := match(cargs.get(usize(0)), .Some(l) => l, .None => e);
        rhs := match(cargs.get(usize(1)), .Some(r) => r, .None => e);
        lhs_name := ast_expr_token(lhs).value.clone();
        cond(
          !(ast_expr_is_atom(lhs)) => Option(PendingDef).None,
          (lhs_name == "_") => Option(PendingDef).None,
          ast_expr_is_fn_call_of(rhs, BK_IMPORT, .None) => Option(PendingDef).None,
          true => _make_pending_def(lhs_name, e, index, false)
        )
      },
      .Atom(_, _) => Option(PendingDef).None
    ),
    ast_expr_is_fn_call_of(e, BK_IMPL_LOWER, .None) => match(
      e,
      .FnCall(_, _, iargs, _, _) => {
        // `impl({ ... })` is a module value, not a registration.
        a0_is_block := match(
          iargs.get(usize(0)),
          .Some(a0) => ast_expr_is_fn_call_of(a0, BK_BEGIN, .None),
          .None => true
        );
        cond(
          ((iargs.len() == usize(1)) && a0_is_block) => Option(PendingDef).None,
          (iargs.len() < usize(2)) => Option(PendingDef).None,
          true => {
            // Case 2 (`impl(generic(...), Receiver, ...)`) names the receiver
            // second; Case 3 (`impl(Receiver, ...)`) first.
            a0 := match(iargs.get(usize(0)), .Some(a) => a, .None => e);
            recv := cond(
              ast_expr_is_fn_call_of(a0, BK_GENERIC, .None) => match(iargs.get(usize(1)), .Some(a) => a, .None => e),
              true => a0
            );
            _make_pending_def(impl_receiver_head_name(recv), e, index, true)
          }
        )
      },
      .Atom(_, _) => Option(PendingDef).None
    ),
    true => Option(PendingDef).None
  )
);
/// Start a walk: pre-scan `begin_exprs`, push the walk record. A previous
/// finished-walk table for this module (an LSP re-check) is dropped so stale
/// Variables are never served during the re-evaluation.
begin_module_walk :: (
  fn(begin_exprs : ArrayList(AstExpr), env : Environment, module_frame_id : usize, ctx : EvalContext) -> ModuleWalk
)({
  module_path := match(
    begin_exprs.get(usize(0)),
    .Some(first) => ast_expr_token(first).module_path.clone(),
    .None => env.module_path.clone()
  );
  g_finished_walks.remove(module_path.clone());
  defs := ArrayList(PendingDef).new();
  by_index := HashMap(usize, PendingDef).new();
  (i : usize) = usize(0);
  n := begin_exprs.len();
  while(i < n, {
    match(
      begin_exprs.get(i),
      .Some(e) => match(
        classify_pending_def(e, i),
        .Some(def) => {
          defs.push(def);
          by_index.insert(i, def);
        },
        .None => ()
      ),
      .None => ()
    );
    i = (i + usize(1));
  });
  walk := ModuleWalk(
    module_path : module_path,
    begin_exprs : begin_exprs,
    env : env,
    module_frame_id : module_frame_id,
    ctx : copy_eval_context(ctx),
    defs : defs,
    by_index : by_index
  );
  g_module_walks.push(walk);
  walk
});
/// Finish a walk: pop it and keep its definitions for the post-walk miss
/// fallback. Pops the TOP entry — walks nest strictly (an import evaluates
/// inside its importer's walk and returns before it continues).
end_module_walk :: (fn(walk : ModuleWalk) -> unit)({
  g_module_walks.pop();
  g_finished_walks.insert(walk.module_path.clone(), walk);
  ()
});
walk_pending_def_at :: (fn(walk : ModuleWalk, index : usize) -> Option(PendingDef))(
  walk.by_index.get(index)
);
_find_def_by_name :: (fn(defs : ArrayList(PendingDef), name : String, is_impl : bool) -> Option(PendingDef))({
  (found : Option(PendingDef)) = Option(PendingDef).None;
  (i : usize) = usize(0);
  while((i < defs.len()) && found.is_none(), {
    match(
      defs.get(i),
      .Some(d) => if((d.is_impl == is_impl) && (d.name == name), {
        found = Option(PendingDef).Some(d);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// The innermost active walk for `module_path`.
_active_walk_for :: (fn(module_path : String) -> Option(ModuleWalk))({
  (found : Option(ModuleWalk)) = Option(ModuleWalk).None;
  (i : usize) = g_module_walks.len();
  while((i > usize(0)) && found.is_none(), {
    i = (i - usize(1));
    match(
      g_module_walks.get(i),
      .Some(w) => if(w.module_path == module_path, {
        found = Option(ModuleWalk).Some(w);
      }),
      .None => ()
    );
  });
  found
});
/// The entry whose statement is currently being evaluated (top of the forcing
/// stack), if any.
current_forcing_def :: (fn() -> Option(PendingDef))(
  cond(
    (g_forcing_stack.len() > usize(0)) => g_forcing_stack.get(g_forcing_stack.len() - usize(1)),
    true => Option(PendingDef).None
  )
);
push_forcing_def :: (fn(def : PendingDef) -> unit)({
  def.state = PendingDefState.Forcing;
  g_forcing_stack.push(def);
});
pop_forcing_def :: (fn() -> unit)({
  g_forcing_stack.pop();
  ()
});
/// Token rows are 0-based; diagnostics print 1-based lines (error.yo).
_def_display :: (fn(d : PendingDef) -> String)(
  cond(
    d.is_impl => `impl(${d.name}, …) (line ${(d.row + usize(1)).to_string()})`,
    true => `${d.name} (line ${(d.row + usize(1)).to_string()})`
  )
);
/// `cyclic definition: a (line 12) → b (line 40) → a` — the forcing stack from
/// `def`'s own position back to `def`.
cyclic_definition_message :: (fn(def : PendingDef) -> String)({
  out := String.from("cyclic definition: ");
  (started : bool) = false;
  (i : usize) = usize(0);
  while(i < g_forcing_stack.len(), {
    match(
      g_forcing_stack.get(i),
      .Some(d) => {
        if(((!(started) && (d.name == def.name)) && (d.is_impl == def.is_impl)), {
          started = true;
        });
        if(started, {
          out.push_string(_def_display(d));
          out.push_str(" → ");
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  out.push_string(def.name.clone());
  out.push_str(" — a definition's value depends on itself. Function definitions may reference each other (their signatures bind before their bodies evaluate); a constant or type definition may not name itself. Anonymous `->`/`=>` function literals have no separately evaluated signature: write the recursive function as `(fn(...) -> R)(body)`.");
  out
});
/// Phase A (§4.3): called by `try_to_implement_function_by_function_type`
/// right after the FuncVal is minted and BEFORE the def-time body trial. When
/// `rhs_id` is the RHS node of the definition being forced, its FuncVal becomes
/// the value a re-entrant reference binds.
publish_pending_phase_a :: (fn(rhs_id : usize, value : EvalValue, ty : TypeValue) -> unit)(
  match(
    current_forcing_def(),
    .Some(def) => if((!(def.is_impl) && def.phase_a_value.is_none()), {
      def_rhs_id := match(
        def.expr,
        .FnCall(_, _, cargs, _, _) => match(cargs.get(usize(1)), .Some(r) => ast_expr_id(r), .None => usize(0)),
        .Atom(_, _) => usize(0)
      );
      if(def_rhs_id == rhs_id, {
        def.phase_a_value = Option(EvalValue).Some(value);
        def.phase_a_type = Option(TypeValue).Some(ty);
      });
    }),
    .None => ()
  )
);
/// The Variable pre-bound for `name` from phase A while ITS definition is being
/// evaluated — `evaluate_initialization_assignment` fills it in place instead
/// of adding a second binding (and skips the no-shadowing check against it).
/// True iff `tok` is the LHS token of `def`'s statement — the guard that keeps
/// a same-named LOCAL binding inside the definition's own RHS (a body-local
/// `x := …` while forcing module-level `x`) from being mistaken for it.
_def_lhs_token_is :: (fn(def : PendingDef, tok : Token) -> bool)(
  match(
    def.expr,
    .FnCall(_, _, cargs, _, _) => match(
      cargs.get(usize(0)),
      .Some(lhs) => {
        lt := ast_expr_token(lhs);
        (((lt.row == tok.row) && (lt.column == tok.column)) && (lt.module_path == tok.module_path))
      },
      .None => false
    ),
    .Atom(_, _) => false
  )
);
pending_prebound_variable :: (fn(name : String, lhs_tok : Token) -> Option(Variable))(
  match(
    current_forcing_def(),
    .Some(def) => cond(
      ((((!(def.is_impl) && (def.name == name)) && match(def.state, .Forcing => true, _ => false)) && _def_lhs_token_is(def, lhs_tok))) => def.variable,
      true => Option(Variable).None
    ),
    .None => Option(Variable).None
  )
);
/// Record the Variable a definition's own evaluation bound (the tail of
/// `evaluate_initialization_assignment`).
record_pending_def_variable :: (fn(name : String, lhs_tok : Token, var : Variable) -> unit)(
  match(
    current_forcing_def(),
    .Some(def) => if((((!(def.is_impl) && (def.name == name)) && def.variable.is_none()) && _def_lhs_token_is(def, lhs_tok)), {
      def.variable = Option(Variable).Some(var);
    }),
    .None => ()
  )
);
/// The module env a forced statement evaluates in: the walker's live frames
/// truncated at (and including) the module frame — a FRESH list sharing the
/// Frame handles, so pushes during the forced evaluation cannot corrupt the
/// walker's list, while `add_variable_to_env` still appends into the shared
/// module Frame.
module_walk_force_env :: (fn(walk : ModuleWalk) -> Environment)({
  frames := ArrayList(Frame).new();
  (cut : usize) = walk.env.frames.len();
  (i : usize) = walk.env.frames.len();
  while(i > usize(0), {
    i = (i - usize(1));
    match(
      walk.env.frames.get(i),
      .Some(f) => if((cut == walk.env.frames.len()) && (f.id == walk.module_frame_id), {
        cut = (i + usize(1));
      }),
      .None => ()
    );
  });
  (j : usize) = usize(0);
  while(j < cut, {
    match(
      walk.env.frames.get(j),
      .Some(f) => {
        frames.push(f);
      },
      .None => ()
    );
    j = (j + usize(1));
  });
  Environment(
    frames : frames,
    module_path : walk.env.module_path,
    function_declaration_frame_level : walk.env.function_declaration_frame_level,
    input_string : walk.env.input_string
  )
});
/// The innermost binding named `name` in the walk's module frame.
module_frame_variable :: (fn(walk : ModuleWalk, name : String) -> Option(Variable))({
  fenv := module_walk_force_env(walk);
  match(
    fenv.frames.get(fenv.frames.len() - usize(1)),
    .Some(frame) => {
      vars := get_variables_from_frame(frame, name);
      cond(
        (vars.len() > usize(0)) => vars.get(vars.len() - usize(1)),
        true => Option(Variable).None
      )
    },
    .None => Option(Variable).None
  )
});
/// Drop walks above `depth` — the walker's abort edge (an error unwound
/// through it) resets the stacks to what they were when it started.
truncate_module_walks :: (fn(depth : usize) -> unit)({
  while(g_module_walks.len() > depth, {
    g_module_walks.pop();
  });
});
truncate_forcing_stack :: (fn(depth : usize) -> unit)({
  while(g_forcing_stack.len() > depth, {
    match(
      g_forcing_stack.pop(),
      // An entry abandoned mid-force: leave it re-forceable rather than
      // permanently "Forcing" (a later reference would misreport a cycle).
      .Some(d) => if(match(d.state, .Forcing => true, _ => false), {
        d.state = PendingDefState.Unforced;
      }),
      .None => ()
    );
  });
});
/// Run the forcer on an Unforced entry and settle its state. Returns the
/// failure message, if any.
force_pending_def :: (fn(walk : ModuleWalk, def : PendingDef) -> Option(String))({
  // YO_DEBUG_LAZY=1 prints every out-of-order force — the first thing to
  // read when a program's evaluation order (and so its emitted C) differs
  // from the in-order baseline.
  if(ctx_dbg_env.get(`YO_DEBUG_LAZY`).is_some(), {
    eprintln(`[force] ${_def_display(def)} in ${walk.module_path} (walk index ${def.index.to_string()}, forcing depth ${g_forcing_stack.len().to_string()})`);
  });
  push_forcing_def(def);
  result := match(
    g_force_pending_def_fn,
    .Some(f) => f(walk, def),
    .None => Option(String).Some(String.from("internal error: pending-definition forcer not installed"))
  );
  pop_forcing_def();
  match(
    result,
    .None => {
      def.state = PendingDefState.Done;
      if((!(def.is_impl) && def.variable.is_none()), {
        def.variable = module_frame_variable(walk, def.name.clone());
      });
    },
    .Some(msg) => {
      def.state = PendingDefState.Failed;
      def.failure = Option(String).Some(msg);
    }
  );
  result
});
/// Outcome of a lookup-miss resolution. `Resolved` carries the defining
/// module frame's id so the caller can adopt the Variable into its own env
/// (`adopt_resolved_definition`).
PendingResolution :: enum(NotPending, Resolved(var : Variable, frame_id : usize), Error(msg : String));
/// Make a resolved definition visible to BY-NAME lookups in `env`. Def-time
/// body envs, call-time capture envs and per-file clones all hold PRIVATE
/// frame copies (fresh `Frame` objects sharing Variable handles), so a
/// definition bound after the copy was taken is absent from them, and the
/// ~100 by-name helpers (`require_expr_not_consumed`, `set_expr_as_consumed`,
/// the RC owner walks, …) would report it "not defined" right after the
/// identifier resolved it. Append it to the env's copy of the module frame
/// (matched by `Frame.id`, which copies preserve) — exactly the state an
/// in-order definition would have produced — or, in a flat capture env
/// without that frame, to its capture frame (frame 0: the FuncVal's own
/// capture list, so later calls see it too). Returns the frame index the
/// Variable now lives at (the `find_variable_in_env_at` contract).
adopt_resolved_definition :: (fn(env : Environment, var : Variable, module_frame_id : usize) -> usize)({
  n := env.frames.len();
  (target : Option(usize)) = Option(usize).None;
  (i : usize) = n;
  while((i > usize(0)) && target.is_none(), {
    i = (i - usize(1));
    match(
      env.frames.get(i),
      .Some(f) => if(f.id == module_frame_id, {
        target = Option(usize).Some(i);
      }),
      .None => ()
    );
  });
  idx := match(
    target,
    .Some(t) => t,
    .None => usize(0)
  );
  match(
    env.frames.get(idx),
    .Some(frame) => {
      (present : bool) = false;
      existing := get_variables_from_frame(frame, var.name.clone());
      (ei : usize) = usize(0);
      while((ei < existing.len()) && !(present), {
        match(
          existing.get(ei),
          .Some(ev) => if(ev.id == var.id, {
            present = true;
          }),
          .None => ()
        );
        ei = (ei + usize(1));
      });
      if(!(present), {
        frame.variables.push(var);
      });
    },
    .None => ()
  );
  idx
});
/// The identifier-miss hook (§4.2). `module_path` is the identifier TOKEN's
/// module path — the module whose definitions the name can refer to (a macro
/// expanded elsewhere still names its definition site's module).
resolve_pending_definition :: (fn(name : String, module_path : String) -> PendingResolution)(
  match(
    _active_walk_for(module_path.clone()),
    .Some(walk) => match(
      _find_def_by_name(walk.defs, name.clone(), false),
      .None => PendingResolution.NotPending,
      .Some(def) => match(
        def.state,
        .Done => match(
          def.variable,
          .Some(v) => PendingResolution.Resolved(v, walk.module_frame_id),
          .None => PendingResolution.NotPending
        ),
        .Failed => PendingResolution.Error(match(def.failure, .Some(m) => m.clone(), .None => String.from("definition failed"))),
        .Forcing => match(
          def.variable,
          .Some(v) => PendingResolution.Resolved(v, walk.module_frame_id),
          .None => match(
            def.phase_a_value,
            .Some(fv) => {
              // Pre-bind (§4.3): the signature is known, the body is still
              // evaluating — bind the head FuncVal into the module frame now.
              fty := match(def.phase_a_type, .Some(t) => t, .None => t_unit());
              lhs_tok := match(
                def.expr,
                .FnCall(_, _, cargs, _, _) => match(cargs.get(usize(0)), .Some(l) => ast_expr_token(l), .None => ast_expr_token(def.expr)),
                .Atom(_, _) => ast_expr_token(def.expr)
              );
              match(
                add_variable_to_env(module_walk_force_env(walk), def.name.clone(), fty, Option(EvalValue).Some(fv), true, false, false, false, lhs_tok),
                .Some(v) => {
                  def.variable = Option(Variable).Some(v);
                  PendingResolution.Resolved(v, walk.module_frame_id)
                },
                .None => PendingResolution.Error(String.from("internal error: module frame missing while pre-binding a definition"))
              )
            },
            .None => PendingResolution.Error(cyclic_definition_message(def))
          )
        ),
        .Unforced => match(
          force_pending_def(walk, def),
          .Some(msg) => PendingResolution.Error(msg),
          .None => match(
            def.variable,
            .Some(v) => PendingResolution.Resolved(v, walk.module_frame_id),
            .None => PendingResolution.Error(`definition "${name}" did not bind a variable`)
          )
        )
      )
    ),
    .None => match(
      g_finished_walks.get(module_path),
      .Some(fwalk) => match(
        _find_def_by_name(fwalk.defs, name, false),
        .Some(def) => match(
          def.variable,
          .Some(v) => PendingResolution.Resolved(v, fwalk.module_frame_id),
          .None => PendingResolution.NotPending
        ),
        .None => PendingResolution.NotPending
      ),
      .None => PendingResolution.NotPending
    )
  )
);
/// Outcome of a method/trait-miss impl forcing (§4.4).
PendingImplOutcome :: enum(NoneForced, Forced, Error(msg : String));
/// Force every Unforced pending `impl` whose receiver head is `type_name`, plus
/// the un-nameable ones, across the active walks (innermost first). `.Forced`
/// tells the caller to retry its lookup; `.Error` carries the first failure.
force_pending_impls_for_type_name :: (fn(type_name : String) -> PendingImplOutcome)({
  // An unnamed receiver (SomeT, primitive, tuple, …) cannot select an impl.
  if(type_name.len() == usize(0), {
    return(PendingImplOutcome.NoneForced);
  });
  // While an impl of THIS type is itself being evaluated, a method miss on the
  // type is the in-block sibling forward reference that impl.yo's shell
  // pre-pass and in-flight registry own — forcing a LATER impl of the same
  // type in the middle of that registration evaluated `impl(Sha1, Digest(update
  // : self.update(data)))` against a half-registered Sha1 and left its trait
  // methods resolving through the trait record (`__yo_t18.update`,
  // tests/crypto/digest.test.yo). Cross-block references still force from
  // free functions, generic bodies and other types' impls.
  (fi : usize) = usize(0);
  while(fi < g_forcing_stack.len(), {
    match(
      g_forcing_stack.get(fi),
      .Some(fd) => if(fd.is_impl && (fd.name == type_name), {
        return(PendingImplOutcome.NoneForced);
      }),
      .None => ()
    );
    fi = (fi + usize(1));
  });
  (forced : bool) = false;
  (err : Option(String)) = Option(String).None;
  (wi : usize) = g_module_walks.len();
  while((wi > usize(0)) && err.is_none(), {
    wi = (wi - usize(1));
    match(
      g_module_walks.get(wi),
      .Some(walk) => {
        (di : usize) = usize(0);
        while((di < walk.defs.len()) && err.is_none(), {
          match(
            walk.defs.get(di),
            .Some(def) => {
              is_target := ((def.is_impl && match(def.state, .Unforced => true, _ => false)) && ((def.name == type_name) || (def.name.len() == usize(0))));
              if(is_target, {
                match(
                  force_pending_def(walk, def),
                  .Some(msg) => {
                    err = Option(String).Some(msg);
                  },
                  .None => {
                    forced = true;
                  }
                );
              });
            },
            .None => ()
          );
          di = (di + usize(1));
        });
      },
      .None => ()
    );
  });
  match(
    err,
    .Some(m) => PendingImplOutcome.Error(m),
    .None => cond(forced => PendingImplOutcome.Forced, true => PendingImplOutcome.NoneForced)
  )
});
/// The nominal head name of a type for impl forcing — the `name` of a
/// struct/enum/union/trait (a generic instantiation's `Name(args)` spelling
/// is cut at the paren), looked up through pointers (method dispatch
/// auto-derefs the receiver). Empty for anything unnamed (SomeT, primitives,
/// tuples, …) — no impl is forced for those.
type_head_name_for_impl_forcing :: (fn(ty : TypeValue) -> String)({
  raw := match(
    ty,
    .Struct({ name : sn }) => sn.clone(),
    .EnumT(_, en, _, _, _, _, _, _, _) => en.clone(),
    .Union(un, _, _) => un.clone(),
    .TraitT(tn, _, _, _, _, _, _, _, _, _) => tn.clone(),
    .Pointer(pointee) => recur(pointee),
    _ => String.new()
  );
  match(
    raw.index_of(String.from("(")),
    .Some(p) => raw.substring(usize(0), p),
    .None => raw
  )
});
// --- Impl-block sibling forcing (plans/LAZY_TOPLEVEL_BINDINGS.md P3) ---
//
// The colon-pair fields of an `impl(...)` block being evaluated are pending
// definitions scoped to the block: a method lookup on the receiver that misses
// while the block is in flight (a sibling referenced before its own field —
// `caller` calling `self.callee()` defined below it) FORCES that field's
// evaluation out of order, exactly as a module-level miss forces a `::`
// definition. The field's REAL FuncVal (its real func_id) is what gets
// registered, so no shell, no shell→real redirect and no codegen thunk exist
// any more (the pre-P3 `_try_create_forward_shell` pre-pass). Mutual recursion
// between siblings rides the same phase-A channel as module-level functions:
// the field's `def` sits on the forcing stack while its value evaluates, so
// `try_to_implement_function_by_function_type` publishes the head FuncVal
// into it, and a re-entrant miss registers that value.
//
// The model lives here so the module walker's abort edge can truncate the
// in-flight stack with the others; the evaluators live in values/impl.yo.
ImplFieldState :: enum(Unforced, Forcing, Done, Failed);
ImplPendingField :: ref(
  struct(
    label : String,
    /// The `name : value` colon pair.
    colon_expr : AstExpr,
    /// Index of the impl argument this field belongs to — the field's own
    /// index for a direct field, the trait constructor's for an inner one.
    top_index : usize,
    is_inner : bool,
    state : ImplFieldState,
    failure : Option(String),
    /// The forcing-stack entry (phase-A publication target).
    def : PendingDef,
    /// Case 2 results, pushed into the impl's field arrays IN SOURCE ORDER by
    /// the field loop whether the field was forced early or evaluated in place.
    result_ty : Option(TypeValue),
    result_value : Option(EvalValue),
    /// True once a phase-A entry for this field is in the method registry
    /// (the completing evaluation then updates that entry in place).
    phase_a_registered : bool
  )
);
ImplInFlight :: ref(
  struct(
    recv_id : String,
    is_generic : bool,
    receiver_ty : TypeValue,
    receiver_name : String,
    /// The impl's live env (Case 3 `local_env` / Case 2 `forall_env`); the loops
    /// sync it in and out around each field so a force sees the env at the
    /// current position.
    env : Environment,
    ctx : EvalContext,
    fields : ArrayList(ImplPendingField),
    /// The impl argument the field loop is on, and — inside a trait
    /// constructor — that trait's type. An inner field is forcible only from
    /// within its OWN trait entry (its expected type and working bindings
    /// belong to that entry).
    current_top_index : usize,
    current_trait_ty : Option(TypeValue),
    forall_names : ArrayList(String)
  )
);
(g_impls_in_flight : ArrayList(ImplInFlight)) = ArrayList(ImplInFlight).new();
push_impl_in_flight :: (fn(rec : ImplInFlight) -> unit)({
  g_impls_in_flight.push(rec);
});
pop_impl_in_flight :: (fn() -> unit)({
  g_impls_in_flight.pop();
  ()
});
truncate_impls_in_flight :: (fn(depth : usize) -> unit)({
  while(g_impls_in_flight.len() > depth, {
    g_impls_in_flight.pop();
  });
});
/// Snapshot of the three forcing stacks (module walks, forcing defs, impls in
/// flight). Every site that CATCHES an evaluation error and continues — the
/// module walker's abort edge, `comptime_expect_error`, the def-time body-trial
/// swallows, the pending-definition forcer, the in-block field forcer — takes
/// one before the guarded evaluation and truncates back to it afterwards: an
/// impl (or forced definition) that threw mid-way never reaches its own pops,
/// and a stale `ImplInFlight` record would otherwise let a later method miss
/// force a member of an ABANDONED impl into existence
/// (issues/fixed/abandoned-impl-members-survive-the-error.md). Truncating to a
/// depth that did not change is a no-op, so the restore is unconditional.
ForcingDepths :: struct(walks : usize, forcing : usize, impls : usize);
forcing_depths :: (fn() -> ForcingDepths)(
  ForcingDepths(walks : g_module_walks.len(), forcing : g_forcing_stack.len(), impls : g_impls_in_flight.len())
);
truncate_forcing_depths :: (fn(d : ForcingDepths) -> unit)({
  truncate_module_walks(d.walks);
  truncate_forcing_stack(d.forcing);
  truncate_impls_in_flight(d.impls);
});
/// The newest in-flight impl on `recv_id`, if any.
newest_impl_in_flight_for :: (fn(recv_id : String) -> Option(ImplInFlight))({
  (found : Option(ImplInFlight)) = Option(ImplInFlight).None;
  (i : usize) = g_impls_in_flight.len();
  while((i > usize(0)) && found.is_none(), {
    i = (i - usize(1));
    match(
      g_impls_in_flight.get(i),
      .Some(r) => if(r.recv_id == recv_id, {
        found = Option(ImplInFlight).Some(r);
      }),
      .None => ()
    );
  });
  found
});
make_impl_pending_field :: (fn(label : String, colon_expr : AstExpr, top_index : usize, is_inner : bool) -> ImplPendingField)(
  ImplPendingField(
    label : label.clone(),
    colon_expr : colon_expr,
    top_index : top_index,
    is_inner : is_inner,
    state : ImplFieldState.Unforced,
    failure : Option(String).None,
    def : PendingDef(
      name : label,
      expr : colon_expr,
      index : top_index,
      row : ast_expr_token(colon_expr).row,
      is_impl : false,
      state : PendingDefState.Unforced,
      failure : Option(String).None,
      phase_a_value : Option(EvalValue).None,
      phase_a_type : Option(TypeValue).None,
      variable : Option(Variable).None
    ),
    result_ty : Option(TypeValue).None,
    result_value : Option(EvalValue).None,
    phase_a_registered : false
  )
);
/// The DIRECT field at impl argument `top_index`, if that argument is a
/// pending colon pair.
impl_direct_field_at :: (fn(rec : ImplInFlight, top_index : usize) -> Option(ImplPendingField))({
  (found : Option(ImplPendingField)) = Option(ImplPendingField).None;
  (i : usize) = usize(0);
  while((i < rec.fields.len()) && found.is_none(), {
    match(
      rec.fields.get(i),
      .Some(f) => if(!(f.is_inner) && (f.top_index == top_index), {
        found = Option(ImplPendingField).Some(f);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// The INNER field `label` of the trait constructor at `top_index`.
impl_inner_field_at :: (fn(rec : ImplInFlight, top_index : usize, label : String) -> Option(ImplPendingField))({
  (found : Option(ImplPendingField)) = Option(ImplPendingField).None;
  (i : usize) = usize(0);
  while((i < rec.fields.len()) && found.is_none(), {
    match(
      rec.fields.get(i),
      .Some(f) => if((f.is_inner && (f.top_index == top_index)) && (f.label == label), {
        found = Option(ImplPendingField).Some(f);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// The field a sibling miss on `label` may force: a direct field, or an inner
/// field of the trait entry currently being evaluated.
impl_forcible_field :: (fn(rec : ImplInFlight, label : String) -> Option(ImplPendingField))({
  (found : Option(ImplPendingField)) = Option(ImplPendingField).None;
  (i : usize) = usize(0);
  while((i < rec.fields.len()) && found.is_none(), {
    match(
      rec.fields.get(i),
      .Some(f) => if((f.label == label) && (!(f.is_inner) || (f.top_index == rec.current_top_index)), {
        found = Option(ImplPendingField).Some(f);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// A pending-impl / impl-field force that FAILED while answering a method
/// miss. The lookup helpers have no `exn`, so the failure is parked here and
/// thrown by the no-method arm of `evaluate_function_call` (calls/function.yo),
/// which otherwise would report a misleading "No matching call found".
(g_pending_impl_force_error : Option(String)) = Option(String).None;
flag_pending_impl_force_error :: (fn(msg : String) -> unit)({
  g_pending_impl_force_error = Option(String).Some(msg);
  ()
});
take_pending_impl_force_error :: (fn() -> Option(String))({
  r := g_pending_impl_force_error;
  g_pending_impl_force_error = Option(String).None;
  r
});
/// True while a DEFINITION-time body trial is running
/// (`_trial_eval_fn_body`, calls/function_type.yo — set/restored at its
/// call sites, since a swallowed error unwinds out of the helper itself).
/// Read by impl.yo's `_resolve_one_forall_binding`: the NAME-channel
/// acceptance of an abstract (different-SomeT) generic binding is scoped
/// to def-time trials — unscoped it broke std module evaluation
/// ("Incompatible function return type", measured 2026-08-13), while at
/// def time it is what lets a sibling impl's method dispatch resolve
/// (array_list's Clone -> len, family A root #3).
/// Storage lives in types/creators.yo (`trial_flag_get`/`trial_flag_set`)
/// so types/compatibility.yo can read the flag without an evaluator-layer
/// import cycle; these accessors remain the public API.
in_def_time_trial :: (fn() -> bool)(trial_flag_get());
set_in_def_time_trial :: (fn(v : bool) -> bool)(trial_flag_set(v));
/// Creates a fresh evaluation context for function body evaluation.
///
/// Mirrors `createFunctionBodyEvaluationContext` in `src/evaluator/calls/function-type.ts`.
///
/// In TypeScript the function returns `{ evaluationContext, functionBodyContext }`.
/// In Yo, `functionBodyContext` is embedded inside the returned `EvalContext` as
/// `is_evaluating_function_body_or_async_block`, so we return just `EvalContext`.
///
/// Phase 3c: IMPLEMENTED.
create_function_body_evaluation_context :: (
  fn(
    function_type : TypeValue,
    function_value : EvalValue,
    env : Environment,
    ctx : EvalContext
  ) -> EvalContext
)({
  // Build the FuncOrAsyncBlockCtx (FunctionEvaluationContext in TypeScript).
  func_body_ctx := FuncOrAsyncBlockCtx(
    kind : FuncOrAsyncBlockKind.FunctionBody,
    func_type : Option(TypeValue).Some(function_type),
    func_value : Option(EvalValue).Some(function_value),
    eval_env : snapshot_env(env)
  );
  // Compute enclosing function's return type.
  // If the parent is a function body, the enclosing return type is its return type.
  // If the parent is a test/async block, the enclosing return type is unit.
  enclosing_return_type := match(
    ctx.is_evaluating_function_body_or_async_block,
    .None => Option(TypeValue).None,
    .Some(block) => match(
      block.kind,
      .FunctionBody => match(
        block.func_type,
        .Some(ft) => match(
          ft,
          .Func({ result : ret_box }) => Option(TypeValue).Some(ret_box),
          _ => Option(TypeValue).None
        ),
        .None => Option(TypeValue).None
      ),
      _ => Option(TypeValue).Some(t_unit())
    )
  );
  // Extract the return type from function_type for expected_type.
  // For `-> inout(T)` functions the body produces a place expression
  // (`*(T)` at the C ABI) — set the body's expected type to `*(T)` so
  // unification across `match`/`cond` arms agrees on the pointer shape
  // (e.g. `match(opt, .Some(b) => &(b(i)), .None => __yo_panic(...))`).
  // Mirrors TS function-type.ts `bodyExpectedType = return.isRef ?
  // createPtrType(return.type) : return.type`.
  return_type := match(
    function_type,
    .Func({ result : ret_box, meta : __fm1 }) => cond(
      __fm1.*.result_is_ref => t_ptr(ret_box),
      true => ret_box
    ),
    _ => t_unit()
  );
  // Build the new EvalContext with overrides (mirrors `{ ...context, overrides }` in TS).
  EvalContext(
    // Overridden fields
    is_executing : false,
    is_validating_function_definition : true,
    ctfe_depth : ctx.ctfe_depth,
    expected_type : Option(ExpectedTypeCtx).Some(
      ExpectedTypeCtx(ty : return_type, env : env)
    ),
    is_evaluating_function_body_or_async_block : Option(FuncOrAsyncBlockCtx).Some(func_body_ctx),
    is_evaluating_function_type : false,
    is_evaluating_loop_body : Option(LoopBodyCtx).None,
    captured_variables : Option(HashMap(String, CapturedVarInfo)).Some(
      HashMap(String, CapturedVarInfo).new()
    ),
    own_consumed_captures : Option(HashSet(String)).Some(HashSet(String).new()),
    function_return_impl_concrete_type : Option(ArrayList(ImplConcreteTypeInfo)).Some(
      ArrayList(ImplConcreteTypeInfo).new()
    ),
    enclosing_function_return_type : enclosing_return_type,
    force_compile_time_bindings : false,
    is_analyzing_ctfe_capability : false,
    // Copied from parent context (mirrors `...context` spread in TS)
    is_inside_impl_block : ctx.is_inside_impl_block,
    self_type : ctx.self_type,
    self_trait_type : ctx.self_trait_type,
    self_module_type : ctx.self_module_type,
    receiver_type : ctx.receiver_type,
    load_module : ctx.load_module,
    std_path : ctx.std_path,
    current_module_path : ctx.current_module_path,
    is_unsafe_function_type : ctx.is_unsafe_function_type,
    unsafe_context : ctx.unsafe_context,
    is_control_function_type : ctx.is_control_function_type,
    has_control_function_implicit_params : ctx.has_control_function_implicit_params,
    is_inside_where_clause : ctx.is_inside_where_clause,
    is_lhs_of_assignment : ctx.is_lhs_of_assignment,
    is_in_function_call_checking_phase : ctx.is_in_function_call_checking_phase,
    is_inside_io_async_call : ctx.is_inside_io_async_call,
    is_inside_given_handler : ctx.is_inside_given_handler,
    is_evaluating_generic_impl_specialization : ctx.is_evaluating_generic_impl_specialization,
    currently_specializing_function : ctx.currently_specializing_function,
    currently_specializing_function_stack : ctx.currently_specializing_function_stack,
    doc_comment_lookup : ctx.doc_comment_lookup,
    // Shared mutable tables — same instance as parent so results are visible
    expr_info_table : ctx.expr_info_table,
    comptime_fn_caches : ctx.comptime_fn_caches,
    current_impl_trait_field_labels : ctx.current_impl_trait_field_labels,
    current_impl_trait_field_types : ctx.current_impl_trait_field_types,
    pending_method_self_type : Option(TypeValue).None
  )
});

track_variable_usage :: (
  fn(
    variable_name : String,
    frame_level : usize,
    usage : CaptureUsage,
    token : Token,
    context : EvalContext
  ) -> unit
)(
  // Legacy entry: no resolved-binding flag — the compile-time-only gate
  // falls back to the re-found binding (see the note in the _resolved
  // variant).
  track_variable_usage_resolved(variable_name, frame_level, usage, token, context, Option(bool).None)
);

