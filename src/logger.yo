//! Optional debug-print helper.
//!
//! Forwards to `println` only when `NODE_ENV` is unset or set to something
//! other than "production", and `DEBUG` is set to a non-empty value.
//!
//! Currently nothing in the compiler pipeline calls `debug`; it is kept
//! as the standard debug hook.
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ env } :: import("std/env");
/// Print `msg` to stdout iff:
///   - `NODE_ENV` is unset, OR set to anything other than "production"; AND
///   - `DEBUG` is set to any non-empty value.
///
/// Takes a single pre-formatted string; callers format with template literals.
debug :: (fn(msg : String) -> unit)({
  is_production := match(
    env.get(String.from("NODE_ENV")),
    .Some(v) => (v == "production"),
    .None => false
  );
  if(is_production, {
    return(());
  });
  has_debug := match(
    env.get(String.from("DEBUG")),
    .Some(v) => (v.len() > usize(0)),
    .None => false
  );
  if(has_debug, {
    println(msg);
  });
});
export(debug);
