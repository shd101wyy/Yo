//! lsp/references — textDocument/references (plans/archive/P4_LSP.md slice 5),
//! and the symbol-occurrence collector rename.yo shares.
//!
//! Same-file references to the BINDING under the cursor, not to its
//! spelling. The target atom's ExprInfo env resolves it to a variable whose
//! declaration token is the identity; every other atom with the same name is
//! resolved the same way and dropped only when it names a DIFFERENT
//! declaration. An atom the evaluator never reached (a `generic(...)` or
//! `comptime` function's body is deferred until a call specializes it, and
//! the specialization evaluates a copy, so its atoms carry no ExprInfo) is
//! judged by its syntactic scope instead (`_scoped_atoms`): the innermost fn
//! literal, closure or `match` arm that declares the name, or a `:=`
//! binding above it in its block. An atom no such scope covers is kept by
//! NAME, as is the `name :: value` declaration atom itself (its ExprInfo env
//! predates the binding); so is every atom when the target cannot be
//! resolved either way. Before the scope, a parameter in a deferred body
//! was kept by name: a rename of `g`'s `x` rewrote the body of a generic
//! `f` with its own `x`
//! (issues/fixed/2026-10-24-lsp-references-of-a-parameter-match-every-same-named-parameter-of-the-module.md). Member names and
//! labels (`p.x`, `Point(x : 1)`) are never references (hover.yo "Atom
//! roles"). Before this, renaming a local `x` rewrote the struct field `x`,
//! the label `x :` and the access `p.x` — a destructive edit
//! (issues/fixed/lsp-references-and-rename-match-by-spelling.md).
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ Exception } :: import("std/error");
{ Token, TokenKind } :: import("../token.yo");
{ tokenize } :: import("../lexer.yo");
{ AstExpr, ast_expr_id, ast_expr_is_fn_call_of, ast_expr_is_atom, ast_expr_token, ast_expr_is_capture_list_params } :: import("../expr.yo");
{ ExprInfoTable, expr_info_table_get } :: import("../expr_info.yo");
{ get_variables_from_env } :: import("../env.yo");
{ JsonValue } :: import("std/encoding/json");
{ jb, jstr, jnum, j_range_in, uri_to_fs_path } :: import("./protocol.yo");
{
  AtomRoles,
  classify_atom_roles,
  atom_is_member_or_label,
  _find_token_at,
  _collect_candidates,
  _best_candidate,
  _select_best_variable
} :: import("./hover.yo");

/// The declaration token of the variable `atom` refers to, through its
/// ExprInfo env; `.None` when the atom was never evaluated or names no
/// variable.
_binding_token_of :: (
  fn(atom : &AstExpr, tok : &Token, info_table : &ExprInfoTable) -> Option(Token)
)({
  info := match(
    expr_info_table_get(info_table, ast_expr_id(atom)),
    .Some(i) => i,
    .None => {
      return(Option(Token).None);
    }
  );
  vars := get_variables_from_env(&info.env, tok.value.clone());
  if(vars.len() == usize(0), {
    return(Option(Token).None);
  });
  match(
    _select_best_variable(&vars, tok),
    .Some(v) => match(
      v.initialized_at_token,
      .Some(it) => Option(Token).Some(it),
      .None => Option(Token).Some(v.token)
    ),
    .None => Option(Token).None
  )
});
/// Same declaration site: same file (either `file://` spelling) and position.
_same_declaration :: (fn(a : &Token, b : &Token) -> bool)(
  (a.row == b.row) && (a.column == b.column) &&
    (uri_to_fs_path(&a.module_path.*) == uri_to_fs_path(&b.module_path.*))
);

/// The declaration token of a TOP-LEVEL binding of `name`, found
/// syntactically: `name :: value`, `name := value` or the typed
/// `(name : T) = value` form (the shapes `symbols.yo` walks). The env-based
/// `_binding_token_of` answers `.None` on the `::` declaration atom itself
/// (its ExprInfo env predates the binding), so without this fallback
/// `context.includeDeclaration == false` kept the declaration whenever the
/// cursor sat ON it, and documentHighlight called it Text instead of Write
/// (issues/lsp-references-ignore-include-declaration-on-comptime-decl.md).
/// Position-only labeling: an occurrence is only dropped where it SITS on
/// the returned token, so same-spelled locals in deferred bodies are
/// unaffected.
_top_level_decl_token :: (fn(exprs : &ArrayList(AstExpr), name : &String) -> Option(Token))({
  (i : usize) = usize(0);
  while(i < exprs.len(), {
    match(
      exprs.get(i),
      .Some(e) => {
        if(ast_expr_is_fn_call_of(&e, "::", .Some(usize(2))) || ast_expr_is_fn_call_of(&e, ":=", .Some(usize(2))), {
          match(
            e,
            .FnCall(_, _, args, _, _) => match(
              args.get(usize(0)),
              .Some(lhs) => match(
                lhs,
                .Atom(_, t) => {
                  if(t.value == name, {
                    return(Option(Token).Some(t));
                  });
                },
                .FnCall(_, _, _, _, _) => ()
              ),
              .None => ()
            ),
            .Atom(_, _) => ()
          );
        });
        if(ast_expr_is_fn_call_of(&e, "=", .Some(usize(2))), {
          match(
            e,
            .FnCall(_, _, args, _, _) => match(
              args.get(usize(0)),
              .Some(lhs) => {
                if(ast_expr_is_fn_call_of(&lhs, ":", .Some(usize(2))), {
                  match(
                    lhs,
                    .FnCall(_, _, pair, _, _) => match(
                      pair.get(usize(0)),
                      .Some(name_expr) => {
                        if(ast_expr_is_atom(&name_expr), {
                          name_tok := ast_expr_token(&name_expr);
                          if(name_tok.value == name, {
                            return(Option(Token).Some(name_tok));
                          });
                        });
                      },
                      .None => ()
                    ),
                    .Atom(_, _) => ()
                  );
                });
              },
              .None => ()
            ),
            .Atom(_, _) => ()
          );
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  Option(Token).None
});

/// An atom spelled like the target, with the declaration its syntactic
/// scope gives it (`_scoped_atoms`), or none at the top level.
_ScopedAtom :: struct(atom : AstExpr, scope : Option(Token));
/// The atom spelled `name` that `e`, a declaring position, introduces: a
/// parameter (`x`, `x : T`, `comptime(x) : T`, `(x : T) ?= d`), a pattern
/// binding (`.Some(x)`, `{ x }`, `(x := p)`, `(p && (g))`'s `p`) or a binding's
/// left-hand side (`x`, `mut(x)`, `{ x, y }`). Only the declaring side of a
/// `:`, `=`, `?=` or guard is searched, never a type, a default or a guard,
/// and never a `where(...)` clause.
_decl_atom :: (fn(e : &AstExpr, name : &String) -> Option(Token))(
  match(
    e,
    .Atom(_, t) => if((t.value == name) && (t.kind == TokenKind.Identifier), Option(Token).Some(t), Option(Token).None),
    .FnCall(_, _, args, _, _) => cond(
      ast_expr_is_fn_call_of(e, "where", Option(usize).None) => Option(Token).None,
      (ast_expr_is_fn_call_of(e, ":", Option(usize).Some(usize(2))) || ast_expr_is_fn_call_of(e, "=", Option(usize).Some(usize(2))) || ast_expr_is_fn_call_of(e, "?=", Option(usize).Some(usize(2))) || ast_expr_is_fn_call_of(e, "&&", Option(usize).Some(usize(2)))) => recur(&args(usize(0)), name),
      true => {
        (found : Option(Token)) = Option(Token).None;
        (k : usize) = usize(0);
        while((k < args.len()) && found.is_none(), k = (k + usize(1)), {
          found = recur(&args(k), name);
        });
        found
      }
    )
  )
);
/// The parameter `name` of the fn literal application `e`
/// (`(fn(params) -> R)(body)`, also `unsafe_fn` and `ctl`), or none.
_fn_literal_decl :: (fn(e : &AstExpr, name : &String) -> Option(Token))(
  match(
    e,
    .FnCall(_, callee, _, _, _) => cond(
      ast_expr_is_fn_call_of(&callee, "->", Option(usize).Some(usize(2))) => match(
        callee,
        .FnCall(_, _, ft_args, _, _) => {
          head := ft_args(usize(0));
          cond(
            (ast_expr_is_fn_call_of(&head, "fn", Option(usize).None) || ast_expr_is_fn_call_of(&head, "unsafe_fn", Option(usize).None) || ast_expr_is_fn_call_of(&head, "ctl", Option(usize).None)) => _decl_atom(&head, name),
            true => Option(Token).None
          )
        },
        .Atom(_, _) => Option(Token).None
      ),
      true => Option(Token).None
    ),
    .Atom(_, _) => Option(Token).None
  )
);
/// The parameter `name` of a closure's parameter part `params`
/// (`x`, `(x : T)`, `{ captures }(params)`, whose captures are skipped), or
/// none.
_closure_param_decl :: (fn(params : &AstExpr, name : &String) -> Option(Token))(
  cond(
    ast_expr_is_capture_list_params(params) => match(
      params,
      .FnCall(_, _, p_args, _, _) => {
        (found : Option(Token)) = Option(Token).None;
        (k : usize) = usize(0);
        while((k < p_args.len()) && found.is_none(), k = (k + usize(1)), {
          found = _decl_atom(&p_args(k), name);
        });
        found
      },
      .Atom(_, _) => Option(Token).None
    ),
    true => _decl_atom(params, name)
  )
);
/// The declaration of `name` a statement of a block makes for the
/// statements after it: `name := v`, `name :: v`, a destructuring
/// `{ name } := v`, or a typed `(name : T) = v`. A plain `name = v` assigns.
_stmt_decl :: (fn(stmt : &AstExpr, name : &String) -> Option(Token))(
  match(
    stmt,
    .FnCall(_, _, s_args, _, _) => cond(
      (ast_expr_is_fn_call_of(stmt, ":=", Option(usize).Some(usize(2))) || ast_expr_is_fn_call_of(stmt, "::", Option(usize).Some(usize(2)))) => _decl_atom(&s_args(usize(0)), name),
      (ast_expr_is_fn_call_of(stmt, "=", Option(usize).Some(usize(2))) && ast_expr_is_fn_call_of(&s_args(usize(0)), ":", Option(usize).Some(usize(2)))) => _decl_atom(&s_args(usize(0)), name),
      true => Option(Token).None
    ),
    .Atom(_, _) => Option(Token).None
  )
);
/// Every atom spelled `name` under `e`, each with the declaration its
/// syntactic scope gives it (`scope` at `e`): a fn literal's or a closure's
/// parameter covers the literal, a `match` arm's pattern binding covers the
/// arm, and a block's `name := v` covers its left-hand side and the
/// statements after it. A `cond` arm's condition declares nothing. The LSP
/// judges an atom the evaluator never reached by this scope (module header).
_scoped_atoms :: (fn(e : &AstExpr, name : &String, scope : &Option(Token), out : &mut ArrayList(_ScopedAtom)) -> unit)({
  match(
    e,
    .Atom(_, tok) => {
      if(tok.value == name, {
        out.push(_ScopedAtom(atom : e.clone(), scope : scope.clone()));
      });
    },
    .FnCall(_, callee, args, _, _) => {
      if(ast_expr_is_fn_call_of(e, "begin", Option(usize).None), {
        (cur : Option(Token)) = scope.clone();
        (k : usize) = usize(0);
        while(k < args.len(), k = (k + usize(1)), {
          stmt := args(k);
          match(
            _stmt_decl(&stmt, name),
            .Some(d) => {
              new_scope := Option(Token).Some(d);
              match(
                stmt,
                .FnCall(_, s_callee, s_args, _, _) => {
                  recur(&s_callee, name, &cur, out);
                  recur(&s_args(usize(0)), name, &new_scope, out);
                  (j : usize) = usize(1);
                  while(j < s_args.len(), j = (j + usize(1)), {
                    recur(&s_args(j), name, &cur, out);
                  });
                },
                .Atom(_, _) => ()
              );
              cur = new_scope;
            },
            .None => recur(&stmt, name, &cur, out)
          );
        });
        return(());
      });
      if(ast_expr_is_fn_call_of(e, "match", Option(usize).None) || ast_expr_is_fn_call_of(e, "cond", Option(usize).None), {
        is_match := ast_expr_is_fn_call_of(e, "match", Option(usize).None);
        recur(&callee, name, scope, out);
        (k : usize) = usize(0);
        while(k < args.len(), k = (k + usize(1)), {
          arm := args(k);
          if(ast_expr_is_fn_call_of(&arm, "=>", Option(usize).Some(usize(2))), {
            arm_scope := match(
              if(is_match, match(arm, .FnCall(_, _, arm_args, _, _) => _decl_atom(&arm_args(usize(0)), name), .Atom(_, _) => Option(Token).None), Option(Token).None),
              .Some(d) => Option(Token).Some(d),
              .None => scope.clone()
            );
            match(
              arm,
              .FnCall(_, arm_callee, arm_args, _, _) => {
                recur(&arm_callee, name, &arm_scope, out);
                (j : usize) = usize(0);
                while(j < arm_args.len(), j = (j + usize(1)), {
                  recur(&arm_args(j), name, &arm_scope, out);
                });
              },
              .Atom(_, _) => ()
            );
          }, {
            recur(&arm, name, scope, out);
          });
        });
        return(());
      });
      own := cond(
        ast_expr_is_fn_call_of(e, "=>", Option(usize).Some(usize(2))) => _closure_param_decl(&args(usize(0)), name),
        true => _fn_literal_decl(e, name)
      );
      inner := match(own, .Some(d) => Option(Token).Some(d), .None => scope.clone());
      recur(&callee, name, &inner, out);
      (k : usize) = usize(0);
      while(k < args.len(), k = (k + usize(1)), {
        recur(&args(k), name, &inner, out);
      });
    }
  );
});
/// The atoms spelled `name` in `exprs` with their syntactic scopes
/// (`_scoped_atoms`).
scoped_atoms_of :: (fn(exprs : &ArrayList(AstExpr), name : &String) -> ArrayList(_ScopedAtom))({
  out := ArrayList(_ScopedAtom).new();
  top := Option(Token).None;
  (k : usize) = usize(0);
  while(k < exprs.len(), k = (k + usize(1)), {
    _scoped_atoms(&exprs(k), name, &top, &mut out);
  });
  out
});
/// The declaration the syntactic scope gives the atom at `target`'s
/// position (`_scoped_atoms`), or none: what the LSP answers for an atom the
/// evaluator never reached, in a deferred body.
syntactic_decl_at :: (fn(exprs : &ArrayList(AstExpr), target : &Token) -> Option(Token))({
  scoped := scoped_atoms_of(exprs, &target.value);
  (k : usize) = usize(0);
  while(k < scoped.len(), k = (k + usize(1)), {
    sa := scoped(k);
    t := ast_expr_token(&sa.atom);
    if((t.row == target.row) && (t.column == target.column), {
      return(sa.scope);
    });
  });
  Option(Token).None
});
/// The occurrences of `target`'s binding in the program (see the module
/// header), as tokens, deduplicated by position — the same Atom can be
/// reachable through several AST paths. Empty when the target is a member
/// name or a label.
collect_symbol_occurrences :: (
  fn(
    exprs : &ArrayList(AstExpr),
    info_table : &ExprInfoTable,
    target : &Token
  ) -> ArrayList(Token)
)(
  collect_symbol_occurrences_with_decl(exprs, info_table, target, ArrayList(Token).new())
);
/// `collect_symbol_occurrences`, additionally reporting the binding's
/// declaration token (`decl_out`, empty when it cannot be resolved or the
/// target is a member/label) — `handle_references` drops the declaration
/// occurrence when the client sends `context.includeDeclaration == false`
/// (issues/fixed/lsp-references-ignore-include-declaration.md).
collect_symbol_occurrences_with_decl :: (
  fn(
    exprs : &ArrayList(AstExpr),
    info_table : &ExprInfoTable,
    target : &Token,
    decl_out : &mut ArrayList(Token)
  ) -> ArrayList(Token)
)({
  out := ArrayList(Token).new();
  cands := ArrayList(AstExpr).new();
  (ci : usize) = usize(0);
  while(ci < exprs.len(), {
    match(
      exprs.get(ci),
      .Some(e) => _collect_candidates(&e, target, &mut cands),
      .None => ()
    );
    ci = (ci + usize(1));
  });
  roles := classify_atom_roles(exprs);
  scoped := scoped_atoms_of(exprs, &target.value);
  (def : Option(Token)) = Option(Token).None;
  match(
    _best_candidate(&cands, info_table),
    .Some(best) => {
      if(atom_is_member_or_label(&roles, ast_expr_id(&best)), {
        return(out);
      });
      def = _binding_token_of(&best, target, info_table);
    },
    .None => ()
  );
  // A target the evaluator never reached (a deferred body) takes its
  // syntactic scope's declaration.
  if(def.is_none(), {
    def = syntactic_decl_at(exprs, target);
  });
  // The `::` declaration atom resolves to no declaration through its env —
  // fall back to the syntactic top-level walk so the declaration occurrence
  // is still identified (includeDeclaration, documentHighlight's Write).
  match(
    def,
    .None => {
      def = _top_level_decl_token(exprs, target.value.clone());
    },
    .Some(_) => ()
  );
  match(
    def,
    .Some(d) => decl_out.push(d),
    .None => ()
  );
  seen := HashSet(String).new();
  (si : usize) = usize(0);
  while(si < scoped.len(), si = (si + usize(1)), {
    sa := scoped(si);
    tok := ast_expr_token(&sa.atom);
    if(!atom_is_member_or_label(&roles, ast_expr_id(&sa.atom)), {
      // Excluded only when the atom resolves to a DIFFERENT declaration:
      // through its ExprInfo env, or, for an atom the evaluator never
      // reached (a deferred body), through its syntactic scope. One with
      // neither (the `name :: value` declaration atom, whose ExprInfo env
      // predates the binding; a name no scope declares) is kept by name.
      include := match(
        def,
        .None => true,
        .Some(d) => match(
          _binding_token_of(&sa.atom, &tok, info_table),
          .Some(bt) => _same_declaration(&bt, &d),
          .None => match(sa.scope, .Some(sd) => _same_declaration(&sd, &d), .None => true)
        )
      );
      if(include, {
        key := `${tok.row}:${tok.column}`;
        if(!seen.contains(key.clone()), {
          seen.insert(key);
          out.push(tok);
        });
      });
    });
  });
  out
});
/// All same-file references to the symbol at (line, character) — RUNE
/// positions in, wire-encoded ranges out. `include_declaration == false`
/// drops the declaration occurrence (`context.includeDeclaration`, LSP).
handle_references :: (
  fn(
    text : &String,
    doc_abs : &String,
    lines : &ArrayList(String),
    uri : &String,
    exprs : &ArrayList(AstExpr),
    info_table : &ExprInfoTable,
    line : usize,
    character : usize,
    (include_declaration : bool) ?= true
  ) -> JsonValue
)({
  empty := ArrayList(JsonValue).new();
  lex_exn := Exception(
    throw : (
      _err -> unwind(JsonValue.Array(items : ArrayList(JsonValue).new()))
    )
  );
  tokens := tokenize(text.clone(), doc_abs.clone(), lex_exn);
  target := match(
    _find_token_at(&tokens, line, character),
    .Some(t) => t,
    .None => {
      return(JsonValue.Array(items : empty));
    }
  );
  if(target.kind != TokenKind.Identifier, {
    return(JsonValue.Array(items : empty));
  });
  decl := ArrayList(Token).new();
  occurrences := collect_symbol_occurrences_with_decl(exprs, info_table, &target, &mut decl);
  out := ArrayList(JsonValue).new();
  (oi : usize) = usize(0);
  while(oi < occurrences.len(), {
    match(
      occurrences.get(oi),
      .Some(tk) => {
        is_decl := match(
          decl.get(usize(0)),
          .Some(d) => ((usize(tk.row) == usize(d.row)) && (usize(tk.column) == usize(d.column))),
          .None => false
        );
        if(include_declaration || !is_decl, {
          // RUNE width (plans/archive/STD_API_AUDIT_D4_PLAN.md §5.2 S11).
          out.push(
            jb().put("uri", jstr(uri.clone())).put("range", j_range_in(lines, usize(tk.row), usize(tk.column), usize(tk.row), usize(tk.column) + tk.value.clone().chars().count())).obj()
          );
        });
      },
      .None => ()
    );
    oi = (oi + usize(1));
  });
  JsonValue.Array(items : out)
});
/// `textDocument/documentHighlight` (plans/archive/LSP_AUDIT_2026-09-29.md §3):
/// the same binding-identity occurrences `handle_references` computes, as
/// DocumentHighlight items — the declaration occurrence is a Write (3),
/// every other occurrence a Text (1). Members and labels highlight
/// nothing (an empty array), matching references/rename.
handle_document_highlight :: (
  fn(
    text : &String,
    doc_abs : &String,
    lines : &ArrayList(String),
    exprs : &ArrayList(AstExpr),
    info_table : &ExprInfoTable,
    line : usize,
    character : usize
  ) -> JsonValue
)({
  lex_exn := Exception(
    throw : (
      _err -> unwind(JsonValue.Array(items : ArrayList(JsonValue).new()))
    )
  );
  tokens := tokenize(text.clone(), doc_abs.clone(), lex_exn);
  target := match(
    _find_token_at(&tokens, line, character),
    .Some(t) => t,
    .None => {
      return(JsonValue.Array(items : ArrayList(JsonValue).new()));
    }
  );
  if(target.kind != TokenKind.Identifier, {
    return(JsonValue.Array(items : ArrayList(JsonValue).new()));
  });
  decl := ArrayList(Token).new();
  occurrences := collect_symbol_occurrences_with_decl(exprs, info_table, &target, &mut decl);
  out := ArrayList(JsonValue).new();
  (oi : usize) = usize(0);
  while(oi < occurrences.len(), {
    match(
      occurrences.get(oi),
      .Some(tk) => {
        is_decl := match(
          decl.get(usize(0)),
          .Some(d) => ((usize(tk.row) == usize(d.row)) && (usize(tk.column) == usize(d.column))),
          .None => false
        );
        // DocumentHighlightKind: 1 Text, 3 Write.
        kind := cond(is_decl => usize(3), true => usize(1));
        out.push(
          jb().put("range", j_range_in(lines, usize(tk.row), usize(tk.column), usize(tk.row), usize(tk.column) + tk.value.clone().chars().count())).put("kind", jnum(kind)).obj()
        );
      },
      .None => ()
    );
    oi = (oi + usize(1));
  });
  JsonValue.Array(items : out)
});
export(handle_references, handle_document_highlight, collect_symbol_occurrences, collect_symbol_occurrences_with_decl, syntactic_decl_at);
