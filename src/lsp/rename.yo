//! lsp/rename — textDocument/rename (plans/archive/P4_LSP.md slice 5).
//!
//! Renames the BINDING under the cursor: the occurrences come from
//! references.yo's `collect_symbol_occurrences` (declaration identity, not
//! spelling — see that module's header), and the WorkspaceEdit maps the
//! document uri to one TextEdit per occurrence. A cursor on a member name or
//! a label answers nothing, so the client shows "cannot rename" instead of
//! rewriting a field.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
open(import("std/error"));
{ Token, TokenKind } :: import("../token.yo");
{ tokenize } :: import("../lexer.yo");
{ AstExpr } :: import("../expr.yo");
{ ExprInfoTable } :: import("../expr_info.yo");
{ JsonValue } :: import("std/encoding/json");
{ jb, jstr, j_range_in } :: import("./protocol.yo");
{ _find_token_at } :: import("./hover.yo");
{ collect_symbol_occurrences } :: import("./references.yo");

/// Build the WorkspaceEdit for renaming the symbol at (line, character), or
/// `.None` when there is nothing renameable under the cursor. RUNE positions
/// in, wire-encoded ranges out.
handle_rename :: (
  fn(
    text : String,
    doc_abs : String,
    lines : ArrayList(String),
    uri : String,
    exprs : ArrayList(AstExpr),
    info_table : ExprInfoTable,
    line : usize,
    character : usize,
    new_name : String
  ) -> Option(JsonValue)
)({
  lex_exn := Exception(
    throw : (
      _err -> unwind(Option(JsonValue).None)
    )
  );
  tokens := tokenize(text.clone(), doc_abs.clone(), lex_exn);
  target := match(
    _find_token_at(tokens, line, character),
    .Some(t) => t,
    .None => {
      return(Option(JsonValue).None);
    }
  );
  if((target.kind != TokenKind.Identifier) || (new_name.len() == usize(0)), {
    return(Option(JsonValue).None);
  });
  occurrences := collect_symbol_occurrences(exprs, info_table, target);
  if(occurrences.len() == usize(0), {
    return(Option(JsonValue).None);
  });
  edits := ArrayList(JsonValue).new();
  (oi : usize) = usize(0);
  while(oi < occurrences.len(), {
    match(
      occurrences.get(oi),
      .Some(tk) => {
        edits.push(
          // RUNE column + RUNE width (plans/archive/STD_API_AUDIT_D4_PLAN.md §5.2 S11),
          // converted to the wire encoding — a byte or rune width on the
          // wire would make the replaced range overrun the identifier.
          jb().put("range", j_range_in(lines, tk.row, tk.column, tk.row, tk.column + tk.value.chars().count())).put("newText", jstr(new_name.clone())).obj()
        );
      },
      .None => ()
    );
    oi = (oi + usize(1));
  });
  changes_keys := ArrayList(String).new();
  changes_vals := ArrayList(JsonValue).new();
  changes_keys.push(uri.clone());
  changes_vals.push(JsonValue.Array(items : edits));
  Option(JsonValue).Some(
    jb().put("changes", JsonValue.Object(keys : changes_keys, values : changes_vals)).obj()
  )
});
export(handle_rename);
