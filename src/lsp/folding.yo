//! lsp/folding — textDocument/foldingRange (plans/archive/P4_LSP.md slice 5).
//!
//! Region ranges from multi-line `{...}`
//! and `(...)` pairs (a shared stack — a
//! mismatched closer pops whatever is on top, which is fine for folding),
//! plus comment ranges for multi-line block comments. A `(` and a `{` that
//! open on one line and close on another — every `(fn(...) -> T)({ ... })`
//! body — describe the SAME fold, so identical (start, end) pairs are
//! emitted once (issues/fixed/lsp-folding-emits-duplicate-ranges.md).
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ HashMap } :: import("std/collections/hash_map");
{ Exception } :: import("std/error");
{ Token, TokenKind } :: import("../token.yo");
{ tokenize } :: import("../lexer.yo");
{ AstExpr, ast_expr_id } :: import("../expr.yo");
{ ExprInfoTable, expr_info_table_get } :: import("../expr_info.yo");
{ EvalValue } :: import("../value.yo");
{ classify_atom_roles, AtomRoles } :: import("./hover.yo");
{ keyword_names } :: import("./completion.yo");
{ JsonValue } :: import("std/encoding/json");
{ jb, jstr, jnum, line_at, rune_col_to_client } :: import("./protocol.yo");

_push_fold :: (
  fn(mut(out) : ArrayList(JsonValue), mut(seen) : HashSet(String), start_line : usize, end_line : usize, kind : str) -> unit
)({
  key := `${start_line}:${end_line}:${kind}`;
  if(seen.contains(key.clone()), {
    return(());
  });
  seen.insert(key);
  out.push(
    jb().put("startLine", jnum(start_line)).put("endLine", jnum(end_line)).put("kind", jstr(String.from(kind))).obj()
  );
});

/// Folding ranges for the document text.
handle_folding_ranges :: (fn(imm(text) : String, imm(doc_abs) : String) -> JsonValue)({
  out := ArrayList(JsonValue).new();
  lex_exn := Exception(
    throw : (
      _err -> unwind(JsonValue.Array(items : ArrayList(JsonValue).new()))
    )
  );
  tokens := tokenize(text.clone(), doc_abs.clone(), lex_exn);
  open_rows := ArrayList(usize).new();
  seen := HashSet(String).new();
  (i : usize) = usize(0);
  n := tokens.len();
  while(i < n, {
    t := match(
      tokens.get(i),
      .Some(x) => x,
      .None => {
        return(JsonValue.Array(items : out));
      }
    );
    is_open := ((t.kind == TokenKind.LCurlyBracket) || (t.kind == TokenKind.LParen));
    is_close := ((t.kind == TokenKind.RCurlyBracket) || (t.kind == TokenKind.RParen));
    cond(
      is_open => {
        open_rows.push(usize(t.row));
      },
      is_close => {
        if(open_rows.len() > usize(0), {
          open_row := match(open_rows.last(), .Some(r) => r, .None => usize(t.row));
          _p := open_rows.pop();
          if(open_row < usize(t.row), {
            _push_fold(out, seen, open_row, usize(t.row), "region");
          });
        });
      },
      (
        (t.kind == TokenKind.MultiLineComment) ||
          (t.kind == TokenKind.DocBlockComment) || (t.kind == TokenKind.InnerDocBlockComment)
      ) => {
        line_count := t.value.split(String.from("\n")).len();
        if(line_count > usize(1), {
          _push_fold(out, seen, usize(t.row), (usize(t.row) + line_count) - usize(1), "comment");
        });
      },
      true => ()
    );
    i = (i + usize(1));
  });
  JsonValue.Array(items : out)
});
export(handle_folding_ranges, handle_semantic_tokens);

// ---------------------------------------------------------------------------
// textDocument/semanticTokens (plans/archive/LSP_AUDIT_2026-09-29.md §3) — a
// syntactic first cut: what a TextMate grammar cannot know (which
// identifiers are types, functions, members/labels vs plain variables),
// read off the ExprInfo side table and the atom roles; literals, comments
// and keywords come straight from the lexer. Legend indices: 0 keyword,
// 1 type, 2 function, 3 variable, 4 property, 5 string, 6 number,
// 7 comment.
_SEM_KEYWORD :: usize(0);
_SEM_TYPE :: usize(1);
_SEM_FUNCTION :: usize(2);
_SEM_VARIABLE :: usize(3);
_SEM_PROPERTY :: usize(4);
_SEM_STRING :: usize(5);
_SEM_NUMBER :: usize(6);
_SEM_COMMENT :: usize(7);

/// Record the semantic kind of every ATOM of the program, keyed
/// "row:column" — a member or label is a property, a type-valued expr is a
/// type, a Func-typed expr a function, everything else a variable. Written
/// only on first sight (duplicate AST paths classify identically).
_semantic_walk :: (
  fn(
    imm(e) : AstExpr,
    imm(roles) : AtomRoles,
    imm(info_table) : ExprInfoTable,
    mut(out) : HashMap(String, usize)
  ) -> unit
)({
  match(
    e,
    .Atom(
      id,
      tok
    ) => {
      key := `${usize(tok.row)}:${usize(tok.column)}`;
      if(!out.contains_key(key.clone()), {
        kind := _SEM_VARIABLE;
        if(roles.members.contains(id) || roles.labels.contains(id), {
          kind = _SEM_PROPERTY;
        });
        if(kind == _SEM_VARIABLE, {
          match(
            expr_info_table_get(info_table, id),
            .Some(info) => {
              is_type_val := match(
                info.value,
                .Some(v) => match(
                  v,
                  .TypeVal(_) => true,
                  _ => false
                ),
                .None => false
              );
              if(is_type_val, {
                kind = _SEM_TYPE;
              }, {
                match(
                  info.ty,
                  .Func(_, _, _, _, _, _, _) => {
                    kind = _SEM_FUNCTION;
                  },
                  _ => ()
                );
              });
            },
            .None => ()
          );
        });
        out.insert(key, kind);
      });
    },
    .FnCall(
      _,
      func_box,
      args,
      _,
      _
    ) => {
      recur(func_box, roles, info_table, out);
      (i : usize) = usize(0);
      while(i < args.len(), {
        match(
          args.get(i),
          .Some(a) => recur(a, roles, info_table, out),
          .None => ()
        );
        i = (i + usize(1));
      });
    }
  );
});

/// The delta-encoding cursor for the semantic-tuples below: the last emitted
/// token's (line, WIRE character). Passed through and returned by
/// `_emit_sem_segment` — a struct, the house shape for a multi-value return.
SemCursor :: struct(
  prev_line : usize,
  prev_char : usize
);

/// Append one token's 5-tuple, converting the segment's start column AND
/// width to the negotiated wire encoding against the segment's own line
/// (`rune_col_to_client` is monotonic, so the width is the difference of the
/// two converted columns). Returns the advanced cursor.
_emit_sem_segment :: (
  fn(
    imm(lines) : ArrayList(String),
    mut(data) : ArrayList(JsonValue),
    row : usize,
    col : usize,
    width : usize,
    kind : usize,
    imm(cur) : SemCursor
  ) -> SemCursor
)({
  line := line_at(lines, row);
  wire_col := rune_col_to_client(line.clone(), col);
  wire_end := rune_col_to_client(line.clone(), col + width);
  delta_line := (row - cur.prev_line);
  delta_char := cond((row == cur.prev_line) => (wire_col - cur.prev_char), true => wire_col);
  data.push(jnum(delta_line));
  data.push(jnum(delta_char));
  data.push(jnum(wire_end - wire_col));
  data.push(jnum(kind));
  data.push(jnum(usize(0)));
  SemCursor(prev_line : row, prev_char : wire_col)
});

/// `textDocument/semanticTokens/full`: the whole document's tokens,
/// delta-encoded 5-tuples (deltaLine, deltaStartChar, length, tokenType,
/// tokenModifiers — always 0, no modifiers in the legend). Identifiers the
/// analysis could not classify (a stale token match) are SKIPPED rather
/// than guessed; keywords are classified from the token itself.
///
/// Positions and lengths are WIRE-encoded (utf-16 by default), like every
/// other emitted column, and a token spanning lines (a block comment, a
/// multi-line template string) is split into one segment per line — the
/// protocol has no multi-line token. Both come from the token's exact
/// SOURCE span — `t.byte_offset` up to the next token's `byte_offset`,
/// trimmed back over whitespace — never from `t.value`: template-string
/// values are escape-DECODED (a `\uXXXX` escape is six source runes but one
/// value rune), so a value-derived length undercounts
/// (issues/lsp-semantic-tokens-emit-rune-columns-and-value-lengths.md).
handle_semantic_tokens :: (
  fn(imm(text) : String, imm(doc_abs) : String, imm(exprs) : ArrayList(AstExpr), imm(info_table) : ExprInfoTable) -> JsonValue
)({
  lex_exn := Exception(
    throw : (
      _err -> unwind(jb().put("data", JsonValue.Array(items : ArrayList(JsonValue).new())).obj())
    )
  );
  tokens := tokenize(text.clone(), doc_abs.clone(), lex_exn);
  roles := classify_atom_roles(exprs);
  atom_kinds := HashMap(String, usize).new();
  (wi : usize) = usize(0);
  while(wi < exprs.len(), {
    match(
      exprs.get(wi),
      .Some(e) => _semantic_walk(e, roles, info_table, atom_kinds),
      .None => ()
    );
    wi = (wi + usize(1));
  });
  kws := keyword_names();
  lines := text.split(String.from("\n"));
  data := ArrayList(JsonValue).new();
  cursor := SemCursor(prev_line : usize(0), prev_char : usize(0));
  (ti : usize) = usize(0);
  while(ti < tokens.len(), {
    t := match(
      tokens.get(ti),
      .Some(x) => x,
      .None => {
        return(jb().put("data", JsonValue.Array(items : data)).obj());
      }
    );
    ti = (ti + usize(1));
    if(t.kind == TokenKind.Whitespace, {
      continue;
    });
    kind := match(
      t.kind,
      TokenKind.StringLit => _SEM_STRING,
      TokenKind.TemplateString => _SEM_STRING,
      TokenKind.CharLit => _SEM_STRING,
      TokenKind.Integer => _SEM_NUMBER,
      TokenKind.Float => _SEM_NUMBER,
      TokenKind.Bool => _SEM_KEYWORD,
      TokenKind.SingleLineComment => _SEM_COMMENT,
      TokenKind.MultiLineComment => _SEM_COMMENT,
      TokenKind.DocLineComment => _SEM_COMMENT,
      TokenKind.DocBlockComment => _SEM_COMMENT,
      TokenKind.InnerDocLineComment => _SEM_COMMENT,
      TokenKind.InnerDocBlockComment => _SEM_COMMENT,
      TokenKind.Identifier => {
        is_kw := false;
        (ki : usize) = usize(0);
        while((ki < kws.len()) && !is_kw, {
          match(
            kws.get(ki),
            .Some(kw) => {
              if(kw == t.value, {
                is_kw = true;
              });
            },
            .None => ()
          );
          ki = (ki + usize(1));
        });
        cond(
          is_kw => _SEM_KEYWORD,
          true => match(
            atom_kinds.get(`${usize(t.row)}:${usize(t.column)}`),
            .Some(k) => k,
            .None => usize(999)
          )
        )
      },
      _ => usize(999)
    );
    if(kind == usize(999), {
      continue;
    });
    // The token's source span ends where the NEXT token begins (EOF for the
    // last one), trimmed back over whitespace between the two — a gap
    // between consecutive tokens is whitespace by construction, and the
    // token's own text never ends in whitespace except a trailing-space
    // comment, where one lost space is cosmetic.
    (end_byte : usize) = text.len();
    match(
      tokens.get(ti),
      .Some(nx) => {
        end_byte = usize(nx.byte_offset);
      },
      .None => ()
    );
    start_byte := usize(t.byte_offset);
    while((end_byte > start_byte) && _sem_is_ws_byte(text.byte_at(end_byte - usize(1))), {
      end_byte = (end_byte - usize(1));
    });
    if(end_byte <= start_byte, {
      continue;
    });
    // Walk the span's bytes, closing one segment per newline; rune columns
    // advance on UTF-8 LEAD bytes only (ASCII or >= 0xC0), never on
    // continuation bytes.
    (seg_row : usize) = usize(t.row);
    (seg_start : usize) = usize(t.column);
    (cur_col : usize) = usize(t.column);
    (bi : usize) = start_byte;
    while(bi < end_byte, {
      b := text.byte_at(bi);
      if(b == u8(0x0A), {
        if((cur_col - seg_start) > usize(0), {
          cursor = _emit_sem_segment(lines, data, seg_row, seg_start, cur_col - seg_start, kind, cursor);
        });
        seg_row = (seg_row + usize(1));
        cur_col = usize(0);
        seg_start = usize(0);
      }, {
        if((b < u8(0x80)) || (b >= u8(0xC0)), {
          cur_col = (cur_col + usize(1));
        });
      });
      bi = (bi + usize(1));
    });
    if((cur_col - seg_start) > usize(0), {
      cursor = _emit_sem_segment(lines, data, seg_row, seg_start, cur_col - seg_start, kind, cursor);
    });
  });
  jb().put("data", JsonValue.Array(items : data)).obj()
});

/// The whitespace bytes that can separate two consecutive tokens: space,
/// tab, newline, carriage return.
_sem_is_ws_byte :: (fn(b : u8) -> bool)(
  (b == u8(0x20)) || (b == u8(0x09)) || (b == u8(0x0A)) || (b == u8(0x0D))
);
