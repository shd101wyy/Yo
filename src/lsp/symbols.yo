//! lsp/symbols — textDocument/documentSymbol (plans/archive/P4_LSP.md slice 3).
//!
//! Walk the top-level statements for
//! `name :: value` bindings and map each to an LSP DocumentSymbol whose
//! kind follows the bound value's AST shape (fn → Function, struct →
//! Struct, enum → Enum, trait → Interface, impl → Namespace, everything
//! else → Constant). Purely syntactic — works even while the document has
//! evaluation errors.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ tokenize } :: import("../lexer.yo");
{ Exception } :: import("std/error");
{ _find_token_at } :: import("./hover.yo");
{ AstExpr, ast_expr_token, ast_expr_is_fn_call_of, ast_expr_is_atom } :: import("../expr.yo");
{ JsonValue } :: import("std/encoding/json");
{ jb, jstr, jnum, j_range_in } :: import("./protocol.yo");

/// Is `e` a function TYPE expression? `fn(...) -> T` parses as an `->`
/// INFIX call whose first argument is the `fn(...)` call, so both shapes
/// count.
_is_fn_type_expr :: (fn(e : AstExpr) -> bool)({
  if(ast_expr_is_fn_call_of(e, "fn", .None), {
    return(true);
  });
  if(ast_expr_is_fn_call_of(e, "->", .Some(usize(2))), {
    match(
      e,
      .FnCall(_, _, arrow_args, _, _) => match(
        arrow_args.get(usize(0)),
        .Some(lhs) => {
          return(ast_expr_is_fn_call_of(lhs, "fn", .None));
        },
        .None => ()
      ),
      .Atom(_, _) => ()
    );
  });
  false
});

/// LSP SymbolKind for the bound value's AST shape.
_symbol_kind_of :: (fn(value_expr : AstExpr) -> usize)({
  // Function 12, Struct 23, Enum 10, Interface 11, Namespace 3,
  // Constant 14 (the LSP SymbolKind table).
  if(_is_fn_type_expr(value_expr), {
    return(usize(12));
  });
  if(ast_expr_is_fn_call_of(value_expr, "struct", .None) || ast_expr_is_fn_call_of(value_expr, "newtype", .None), {
    return(usize(23));
  });
  if(ast_expr_is_fn_call_of(value_expr, "enum", .None) || ast_expr_is_fn_call_of(value_expr, "union", .None), {
    return(usize(10));
  });
  if(ast_expr_is_fn_call_of(value_expr, "trait", .None), {
    return(usize(11));
  });
  if(ast_expr_is_fn_call_of(value_expr, "impl", .None), {
    return(usize(3));
  });
  // `(fn(...) -> T)(body)` — the common function-definition shape: the
  // CALLEE is the fn type.
  match(
    value_expr,
    .FnCall(_, func_box, _, _, _) => {
      if(_is_fn_type_expr(func_box), {
        return(usize(12));
      });
    },
    .Atom(_, _) => ()
  );
  usize(14)
});

/// A top-level typed declaration `(name : T) = value`: an infix `=` whose
/// first argument is a `name : T` pair with an Atom left side — the mutable
/// module-constant form every file in `src/` uses
/// (`(g_shutdown_requested : bool) = false;`). Reported as a Variable
/// (kind 13): the binding is a mutable slot regardless of the value's shape
/// (issues/fixed/lsp-document-symbol-misses-typed-declarations.md).
_typed_decl_symbol :: (fn(e : AstExpr, lines : ArrayList(String)) -> Option(SymbolEntry))({
  if(!ast_expr_is_fn_call_of(e, "=", .Some(usize(2))), {
    return(Option(SymbolEntry).None);
  });
  match(
    e,
    .FnCall(_, _, args, _, _) => match(
      args.get(usize(0)),
      .Some(lhs) => {
        if(!ast_expr_is_fn_call_of(lhs, ":", .Some(usize(2))), {
          return(Option(SymbolEntry).None);
        });
        match(
          lhs,
          .FnCall(_, _, pair, _, _) => match(
            pair.get(usize(0)),
            .Some(name_expr) => {
              if(!ast_expr_is_atom(name_expr), {
                return(Option(SymbolEntry).None);
              });
              name_tok := ast_expr_token(name_expr);
              rng := j_range_in(
                lines,
                usize(name_tok.row),
                usize(name_tok.column),
                usize(name_tok.row),
                usize(name_tok.column) + name_tok.value.chars().count()
              );
              Option(SymbolEntry).Some(
                SymbolEntry(name : name_tok.value.clone(), kind : usize(13), range : rng)
              )
            },
            .None => Option(SymbolEntry).None
          ),
          .Atom(_, _) => Option(SymbolEntry).None
        )
      },
      .None => Option(SymbolEntry).None
    ),
    .Atom(_, _) => Option(SymbolEntry).None
  )
});

/// One collected top-level symbol — the shared shape of documentSymbol and
/// workspace/symbol. `range` is already wire-encoded against `lines`.
SymbolEntry :: struct(
  name : String,
  kind : usize,
  range : JsonValue
);
/// The bound-name token of a declaration left side: the atom itself
/// (`name :=`), or the atom inside `thread_local(name)`.
_decl_name_tok :: (fn(lhs : AstExpr) -> Option(Token))(
  match(
    lhs,
    .Atom(
      _,
      t
    ) => Option(Token).Some(t),
    .FnCall(
      _,
      _,
      targs,
      _,
      _
    ) => {
      (tl_name : Option(Token)) = Option(Token).None;
      if(ast_expr_is_fn_call_of(lhs, "thread_local", .Some(usize(1))), {
        match(
          targs.get(usize(0)),
          .Some(.Atom(_, t)) => {
            tl_name = Option(Token).Some(t);
          },
          .Some(_) => (),
          .None => ()
        );
      });
      tl_name
    }
  )
);

/// A top-level RUNTIME declaration — `name := value;` (a module static),
/// `thread_local(name) := init;` or `(thread_local(name) : T) = init;` —
/// reported as a Variable (13): the binding is a mutable slot regardless of
/// the initializer's shape, like the typed module constant
/// (issues/lsp-document-symbol-misses-runtime-and-thread-local-declarations.md).
_runtime_decl_symbol :: (fn(e : AstExpr, lines : ArrayList(String)) -> Option(SymbolEntry))({
  // `name := value` and `thread_local(name) := init`.
  if(ast_expr_is_fn_call_of(e, ":=", .Some(usize(2))), {
    match(
      e,
      .FnCall(_, _, args, _, _) =>
        match(
          args.get(usize(0)),
          .Some(lhs) => {
            match(
              _decl_name_tok(lhs),
              .Some(t) => {
                rng := j_range_in(
                  lines,
                  usize(t.row),
                  usize(t.column),
                  usize(t.row),
                  // RUNE column + RUNE width (plans/archive/STD_API_AUDIT_D4_PLAN.md §5.2 S11).
                  usize(t.column) + t.value.chars().count()
                );
                return(
                  Option(SymbolEntry).Some(SymbolEntry(name : t.value.clone(), kind : usize(13), range : rng))
                );
              },
              .None => ()
            );
          },
          .None => ()
        ),
      .Atom(_, _) => ()
    );
  });
  // `(thread_local(name) : T) = init` — the typed thread-local form.
  if(ast_expr_is_fn_call_of(e, "=", .Some(usize(2))), {
    match(
      e,
      .FnCall(_, _, args, _, _) =>
        match(
          args.get(usize(0)),
          .Some(lhs) => {
            if(ast_expr_is_fn_call_of(lhs, ":", .Some(usize(2))), {
              match(
                lhs,
                .FnCall(_, _, pair, _, _) =>
                  match(
                    pair.get(usize(0)),
                    .Some(name_expr) => {
                      match(
                        _decl_name_tok(name_expr),
                        .Some(t) => {
                          rng := j_range_in(
                            lines,
                            usize(t.row),
                            usize(t.column),
                            usize(t.row),
                            usize(t.column) + t.value.chars().count()
                          );
                          return(
                            Option(SymbolEntry).Some(
                              SymbolEntry(name : t.value.clone(), kind : usize(13), range : rng)
                            )
                          );
                        },
                        .None => ()
                      );
                    },
                    .None => ()
                  ),
                .Atom(_, _) => ()
              );
            });
          },
          .None => ()
        ),
      .Atom(_, _) => ()
    );
  });
  Option(SymbolEntry).None
});

/// Collect the top-level symbols of one document (see the module header):
/// `name :: value` bindings, typed `(name : T) = value` declarations and the
/// runtime `:=` / `thread_local(...)` declaration forms.
collect_document_symbols :: (
  fn(exprs : ArrayList(AstExpr), lines : ArrayList(String), out : ArrayList(SymbolEntry)) -> unit
)({
  (i : usize) = usize(0);
  while(i < exprs.len(), {
    e := match(
      exprs.get(i),
      .Some(x) => x,
      .None => {
        return(());
      }
    );
    if(ast_expr_is_fn_call_of(e, "::", .Some(usize(2))), {
      match(
        e,
        .FnCall(_, _, args, _, _) => {
          name_expr := match(args.get(usize(0)), .Some(a) => a, .None => e);
          value_expr := match(args.get(usize(1)), .Some(a) => a, .None => e);
          if(ast_expr_is_atom(name_expr), {
            name_tok := ast_expr_token(name_expr);
            rng := j_range_in(
              lines,
              usize(name_tok.row),
              usize(name_tok.column),
              usize(name_tok.row),
              // RUNE column + RUNE width (plans/archive/STD_API_AUDIT_D4_PLAN.md §5.2 S11).
              usize(name_tok.column) + name_tok.value.chars().count()
            );
            out.push(
              SymbolEntry(name : name_tok.value.clone(), kind : _symbol_kind_of(value_expr), range : rng)
            );
          });
        },
        .Atom(_, _) => ()
      );
    }, {
      match(
        _typed_decl_symbol(e, lines),
        .Some(sym) => {
          out.push(sym);
        },
        .None => {
          match(
            _runtime_decl_symbol(e, lines),
            .Some(sym) => {
              out.push(sym);
            },
            .None => ()
          );
        }
      );
    });
    i = (i + usize(1));
  });
});
/// Collect DocumentSymbols from the top-level statements. Ranges are
/// converted to the wire encoding against `lines`.
handle_document_symbols :: (
  fn(exprs : ArrayList(AstExpr), lines : ArrayList(String)) -> JsonValue
)({
  entries := ArrayList(SymbolEntry).new();
  collect_document_symbols(exprs, lines, entries);
  items := ArrayList(JsonValue).new();
  (i : usize) = usize(0);
  while(i < entries.len(), {
    match(
      entries.get(i),
      .Some(en) => {
        items.push(
          jb().put("name", jstr(en.name.clone())).put("kind", jnum(en.kind)).put("range", en.range).put("selectionRange", en.range).obj()
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  JsonValue.Array(items : items)
});
/// `textDocument/documentSymbol` for clients WITHOUT
/// `hierarchicalDocumentSymbolSupport`: the same entries as FLAT
/// `SymbolInformation` items — `{name, kind, location : {uri, range}}` —
/// which is the only shape such clients can render. The hierarchical
/// DocumentSymbol reply assumes the capability; VS Code's client always
/// declares it, the bare cli-case driver does not
/// (issues/lsp-document-symbol-shape-ignores-the-client-capability.md).
handle_document_symbols_flat :: (
  fn(exprs : ArrayList(AstExpr), lines : ArrayList(String), uri : String) -> JsonValue
)({
  entries := ArrayList(SymbolEntry).new();
  collect_document_symbols(exprs, lines, entries);
  items := ArrayList(JsonValue).new();
  (i : usize) = usize(0);
  while(i < entries.len(), {
    match(
      entries.get(i),
      .Some(en) => {
        items.push(
          jb().put("name", jstr(en.name.clone())).put("kind", jnum(en.kind)).put(
            "location",
            jb().put("uri", jstr(uri.clone())).put("range", en.range).obj()
          ).obj()
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  JsonValue.Array(items : items)
});
/// One open document for `textDocument/workspaceSymbol` — the server's
/// dispatch fills this list from its open-documents table, which keeps the
/// handler here testable without a running server.
WorkspaceDoc :: struct(
  uri : String,
  exprs : ArrayList(AstExpr),
  lines : ArrayList(String)
);
/// `textDocument/workspaceSymbol` (plans/archive/LSP_AUDIT_2026-09-29.md §3): the
/// top-level symbols of every OPEN document whose name matches `query`
/// (case-insensitive substring; an empty query lists everything), as
/// SymbolInformation items pointing into their document.
handle_workspace_symbols :: (fn(query : String, docs : ArrayList(WorkspaceDoc)) -> JsonValue)({
  out := ArrayList(JsonValue).new();
  q := query.to_lowercase();
  (di : usize) = usize(0);
  while(di < docs.len(), {
    match(
      docs.get(di),
      .Some(doc) => {
        entries := ArrayList(SymbolEntry).new();
        collect_document_symbols(doc.exprs, doc.lines, entries);
        (ei : usize) = usize(0);
        while(ei < entries.len(), {
          match(
            entries.get(ei),
            .Some(en) => {
              if((q.len() == usize(0)) || en.name.to_lowercase().contains(q.clone()), {
                out.push(
                  jb().put("name", jstr(en.name.clone())).put("kind", jnum(en.kind)).put("location", jb().put("uri", jstr(doc.uri.clone())).put("range", en.range).obj()).obj()
                );
              });
            },
            .None => ()
          );
          ei = (ei + usize(1));
        });
      },
      .None => ()
    );
    di = (di + usize(1));
  });
  JsonValue.Array(items : out)
});

/// Does impl-argument `e` (a Self type or a trait) name `name`? A bare
/// atom, or an instantiated head — `ArrayList(T)` for a cursor on
/// `ArrayList`, `ToString(...)` for a cursor on the trait.
_impl_arg_is :: (fn(e : AstExpr, name : String) -> bool)(
  match(
    e,
    .Atom(_, t) => (t.value == name),
    .FnCall(_, func_box, _, _, _) => match(
      func_box,
      .Atom(_, ht) => (ht.value == name),
      .FnCall(_, _, _, _, _) => false
    )
  )
);
/// `args.get(a)` is a `generic(...)` clause (the leading clauses of
/// `impl(generic(T : Type), ArrayList(T), ...)`); false past the end.
_impl_arg_is_generic :: (fn(args : ArrayList(AstExpr), a : usize) -> bool)(
  match(
    args.get(a),
    .Some(arg) => ast_expr_is_fn_call_of(arg, "generic", .None),
    .None => false
  )
);
/// `textDocument/implementation` — a syntactic, SAME-FILE first cut (the
/// same-file stance of references/rename; scanning every loaded module
/// wants an index shape first). The cursor names a type or a trait: every
/// top-level `impl(...)` block of this document that implements it answers
/// a Location at the impl block's head token — the Self argument for a
/// type cursor (`impl(Point, ...)`, `impl(generic(...), ArrayList(T), ...)`),
/// the trait argument for a trait cursor (`impl(Point, ToString(...))`).
handle_implementations :: (
  fn(
    text : String,
    doc_abs : String,
    uri : String,
    lines : ArrayList(String),
    exprs : ArrayList(AstExpr),
    line : usize,
    character : usize
  ) -> JsonValue
)({
  out := ArrayList(JsonValue).new();
  lex_exn := Exception(
    throw : (
      _err -> unwind(JsonValue.Array(items : ArrayList(JsonValue).new()))
    )
  );
  tokens := tokenize(text.clone(), doc_abs.clone(), lex_exn);
  target := match(
    _find_token_at(tokens, line, character),
    .Some(t) => t,
    .None => {
      return(JsonValue.Array(items : out));
    }
  );
  if(target.kind != TokenKind.Identifier, {
    return(JsonValue.Array(items : out));
  });
  (i : usize) = usize(0);
  while(i < exprs.len(), {
    match(
      exprs.get(i),
      .Some(e) => {
        if(ast_expr_is_fn_call_of(e, "impl", .None), {
          match(
            e,
            .FnCall(_, _, args, _, itok) => {
              // Skip the leading generic(...) clauses; the first remaining
              // argument is the Self type, the second (when present) the
              // trait.
              (a : usize) = usize(0);
              while(_impl_arg_is_generic(args, a), {
                a = (a + usize(1));
              });
              self_matches := match(
                args.get(a),
                .Some(self_expr) => _impl_arg_is(self_expr, target.value.clone()),
                .None => false
              );
              trait_matches := match(
                args.get(a + usize(1)),
                .Some(trait_expr) => _impl_arg_is(trait_expr, target.value.clone()),
                .None => false
              );
              if(self_matches || trait_matches, {
                out.push(
                  jb().put("uri", jstr(uri.clone())).put(
                    "range",
                    j_range_in(
                      lines,
                      usize(itok.row),
                      usize(itok.column),
                      usize(itok.row),
                      usize(itok.column) + itok.value.chars().count()
                    )
                  ).obj()
                );
              });
            },
            .Atom(_, _) => ()
          );
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  JsonValue.Array(items : out)
});

export(
  handle_document_symbols,
  handle_document_symbols_flat,
  handle_workspace_symbols,
  handle_implementations,
  SymbolEntry,
  WorkspaceDoc
);
