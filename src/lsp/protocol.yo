//! lsp/protocol — small JSON-RPC / LSP payload construction helpers, the
//! position-encoding boundary, and the `file:` URI ↔ filesystem path pair.
//!
//! `std/encoding/json`'s `JsonValue.Object(keys, values)` is the wire type;
//! these helpers keep the server's handlers readable. `JsonObjBuilder` is a
//! ref struct, so `put` chains without copies.
//!
//! **Column bases.** The server's INTERNAL columns are RUNE (UTF-32) columns:
//! the lexer materializes `input.chars()` and stores that loop's counter as
//! `Token.column` (`src/lexer.yo`); `Span.col` (`src/diagnostics.yo`) is the
//! same unit. The WIRE column is whatever `initialize` negotiated — `utf-32`
//! when the client offers it (then the two bases coincide), otherwise the
//! protocol default `utf-16`, where one astral-plane rune (an emoji, CJK
//! extension B, …) occupies TWO units. `client_col_to_rune` /
//! `rune_col_to_client` are the boundary: every `position.character` a
//! handler receives goes through the first, every column it emits through the
//! second (`j_range_in`). `String` itself is BYTE-indexed
//! (`plans/archive/STD_API_AUDIT_D4_PLAN.md` D4), so a handler that SLICES a
//! line converts a third time, with `rune_col_to_byte_offset`.
{ rune, String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ JsonValue } :: import("std/encoding/json");
percent :: import("std/encoding/percent");

/// Chainable JSON object builder.
JsonObjBuilder :: ref(
  struct(
    keys : ArrayList(String),
    values : ArrayList(JsonValue)
  )
);
impl(
  JsonObjBuilder,
  put : (fn(self : Self, key : str, v : JsonValue) -> Self)({
    self.keys.push(String.from(key));
    self.values.push(v);
    return(self);
  }),
  obj : (fn(self : Self) -> JsonValue)(
    JsonValue.Object(keys : self.keys, values : self.values)
  )
);
/// Fresh builder.
jb :: (fn() -> JsonObjBuilder)(
  JsonObjBuilder(
    keys : ArrayList(String).new(),
    values : ArrayList(JsonValue).new()
  )
);
/// JSON string value.
jstr :: (fn(s : String) -> JsonValue)(JsonValue.Str(value : s));
/// JSON number value from a usize.
jnum :: (fn(n : usize) -> JsonValue)(JsonValue.Number(value : f64(n)));
/// LSP Position (0-based line/character). `character` is already in the
/// WIRE encoding — callers with a rune column go through `j_range_in`.
j_position :: (fn(line : usize, character : usize) -> JsonValue)(
  jb().put("line", jnum(line)).put("character", jnum(character)).obj()
);
/// LSP Range from WIRE-encoded columns (see `j_range_in` for rune columns).
j_range :: (
  fn(start_line : usize, start_col : usize, end_line : usize, end_col : usize) -> JsonValue
)(
  jb().put("start", j_position(start_line, start_col)).put("end", j_position(end_line, end_col)).obj()
);

// ---------------------------------------------------------------------------
// Position encoding
/// Whether the wire encoding is UTF-16 (the protocol default). `initialize`
/// flips this to false when the client lists `utf-32` in
/// `general.positionEncodings` — the server's native unit, so no conversion
/// runs at all. Module-level because it must survive across messages.
(g_utf16_positions : bool) = true;
set_utf16_positions :: (fn(utf16 : bool) -> unit)({
  g_utf16_positions = utf16;
});
utf16_positions :: (fn() -> bool)(g_utf16_positions);

/// UTF-16 code units one rune occupies: 2 above the Basic Multilingual Plane.
_utf16_units :: (fn(c : rune) -> usize)(
  cond((c.to_u32() > u32(65535)) => usize(2), true => usize(1))
);

/// UTF-16 column of RUNE column `col` within `line`. A `col` at or past the
/// line's rune count clamps to the line's total unit count.
rune_col_to_utf16_col :: (fn(line : String, col : usize) -> usize)({
  (seen : usize) = usize(0);
  (units : usize) = usize(0);
  it := line.chars();
  while(seen < col, {
    match(
      it.next(),
      .None => {
        break;
      },
      .Some(c) => {
        units = (units + _utf16_units(c));
        seen = (seen + usize(1));
      }
    );
  });
  units
});
/// RUNE column of the rune that starts at, or spans, UTF-16 column `col` of
/// `line` — the inverse of `rune_col_to_utf16_col`. A `col` that lands on the
/// low half of a surrogate pair belongs to that rune; a `col` past the end
/// clamps to the line's rune count.
utf16_col_to_rune_col :: (fn(line : String, col : usize) -> usize)({
  (units : usize) = usize(0);
  (runes : usize) = usize(0);
  it := line.chars();
  while(units < col, {
    match(
      it.next(),
      .None => {
        break;
      },
      .Some(c) => {
        units = (units + _utf16_units(c));
        runes = (runes + usize(1));
      }
    );
  });
  runes
});
/// A `position.character` from the client → RUNE column, per the negotiated
/// encoding.
client_col_to_rune :: (fn(line : String, col : usize) -> usize)(
  cond(g_utf16_positions => utf16_col_to_rune_col(line, col), true => col)
);
/// A RUNE column → the client's `character`, per the negotiated encoding.
rune_col_to_client :: (fn(line : String, col : usize) -> usize)(
  cond(g_utf16_positions => rune_col_to_utf16_col(line, col), true => col)
);
/// The `row`-th line of a document split on `\n` ("" past the end). A
/// trailing `\r` (CRLF documents) stays on the line — it sits after every
/// column, so conversions are unaffected.
line_at :: (fn(lines : ArrayList(String), row : usize) -> String)(
  match(lines.get(row), .Some(l) => l, .None => String.new())
);
/// LSP Range from RUNE columns, converted to the wire encoding against the
/// document's lines (`text.split("\n")`).
j_range_in :: (
  fn(
    lines : ArrayList(String),
    start_line : usize,
    start_col : usize,
    end_line : usize,
    end_col : usize
  ) -> JsonValue
)(
  j_range(
    start_line,
    rune_col_to_client(line_at(lines, start_line), start_col),
    end_line,
    rune_col_to_client(line_at(lines, end_line), end_col)
  )
);

/// LSP Diagnostic with source "yo". `severity` is the protocol's numeric
/// DiagnosticSeverity (1 error, 2 warning, 3 information, 4 hint); `code` is
/// the registry code (`E0401`) when the diagnostic carries one.
j_diagnostic :: (
  fn(range : JsonValue, severity : usize, code : Option(String), message : String) -> JsonValue
)({
  b := jb().put("range", range).put("severity", jnum(severity));
  match(
    code,
    .Some(c) => {
      _b := b.put("code", jstr(c));
    },
    .None => ()
  );
  b.put("source", jstr(String.from("yo"))).put("message", jstr(message)).obj()
});
/// A JSON-RPC response carrying `result` for request `id`.
j_response :: (fn(id : JsonValue, result : JsonValue) -> JsonValue)(
  jb().put("jsonrpc", jstr(String.from("2.0"))).put("id", id).put("result", result).obj()
);
/// A JSON-RPC error response for request `id`.
j_error_response :: (fn(id : JsonValue, code : i64, message : String) -> JsonValue)(
  jb().put("jsonrpc", jstr(String.from("2.0"))).put("id", id).put(
    "error",
    jb().put("code", JsonValue.Number(value : f64(code))).put("message", jstr(message)).obj()
  ).obj()
);
/// BYTE offset within `line` of RUNE column `col`.
///
/// `String` is BYTE-indexed (`plans/archive/STD_API_AUDIT_D4_PLAN.md` D4), so
/// a handler that SLICES a line — rather than just comparing columns — has to
/// convert first, or it cuts at the wrong place (and, at a non-boundary,
/// panics).
///
/// `col` at or past the line's rune count clamps to the line's byte length,
/// which is a boundary.
rune_col_to_byte_offset :: (fn(line : String, col : usize) -> usize)({
  (seen : usize) = usize(0);
  it := line.char_indices();
  while(true, {
    match(
      it.next(),
      .None => {
        break;
      },
      .Some(p) => {
        if(seen == col, {
          return(p._0);
        });
        seen = (seen + usize(1));
      }
    );
  });
  line.len()
});
/// RUNE column within `line` of the first rune starting at or after BYTE
/// offset `off` — the inverse of `rune_col_to_byte_offset` for any `off` that
/// is a rune boundary.
///
/// An offset past the end clamps to the line's rune count.
byte_offset_to_rune_col :: (fn(line : String, off : usize) -> usize)({
  (col : usize) = usize(0);
  it := line.char_indices();
  while(true, {
    match(
      it.next(),
      .None => {
        break;
      },
      .Some(p) => {
        if(p._0 >= off, {
          return(col);
        });
        col = (col + usize(1));
      }
    );
  });
  col
});
/// A JSON-RPC notification.
j_notification :: (fn(method : str, params : JsonValue) -> JsonValue)(
  jb().put("jsonrpc", jstr(String.from("2.0"))).put("method", jstr(String.from(method))).put("params", params).obj()
);

// ---------------------------------------------------------------------------
// file: URI ↔ filesystem path
/// True iff `b` is an ASCII letter.
_is_ascii_alpha :: (fn(b : u8) -> bool)(
  ((b >= u8(65)) && (b <= u8(90))) || ((b >= u8(97)) && (b <= u8(122)))
);
/// `/X:` or `/X|` at the start of `p` — the path part of a Windows
/// `file:///C:/…` URI (`|` is the legacy drive spelling).
_has_leading_drive :: (fn(p : String) -> bool)({
  bytes := p.as_bytes();
  if(bytes.len() < usize(3), {
    return(false);
  });
  b0 := match(bytes.get(usize(0)), .Some(x) => x, .None => u8(0));
  b1 := match(bytes.get(usize(1)), .Some(x) => x, .None => u8(0));
  b2 := match(bytes.get(usize(2)), .Some(x) => x, .None => u8(0));
  (b0 == u8(47)) && (_is_ascii_alpha(b1) && ((b2 == u8(58)) || (b2 == u8(124))))
});

/// `file:` URI → filesystem path: strip the scheme, percent-decode (editors
/// escape spaces, `#` and non-ASCII in document URIs), and drop the leading
/// `/` of a Windows drive path — a `file:` URI for an absolute path has an
/// EMPTY authority, so `file:///C:/w/a.yo` names `C:/w/a.yo`, not `/C:/w/a.yo`
/// (issues/fixed/lsp-uri-to-fs-path-leaves-a-leading-slash-on-windows-drive-uris.md).
/// The legacy `file:///C|/…` spelling decodes to the same `C:/…`. A string
/// that is not a `file:` URI (no scheme) is returned decoded as-is.
///
/// A malformed escape (`%zz`) makes the URI invalid; the bytes are then kept
/// literally, so the caller still gets a stable key for that document.
uri_to_fs_path :: (fn(uri : String) -> String)({
  (s : String) = uri.clone();
  if(s.starts_with(String.from("file://")), {
    s = s.substring(usize(7), s.len());
  });
  decoded := match(
    percent.decode_bytes(s.clone()),
    .Ok(bytes) => String.from_bytes(bytes),
    .Err(_) => s
  );
  if(_has_leading_drive(decoded.clone()), {
    drive := decoded.substring(usize(1), usize(2));
    return(`${drive}:${decoded.substring(usize(3), decoded.len())}`);
  });
  decoded
});

/// Filesystem path → `file:` URI, percent-encoding each path segment (RFC
/// 3986 unreserved characters pass; `/` separates segments). A POSIX absolute
/// path yields `file:///abs`; a Windows drive path yields `file:///C%3A/…`,
/// the spelling VS Code itself emits. Backslash separators are normalized to
/// `/` first
/// (issues/fixed/lsp-definition-uri-is-built-without-percent-encoding.md).
fs_path_to_uri :: (fn(path : String) -> String)({
  p := path.replace(String.from("\\"), String.from("/"));
  segs := p.split(String.from("/"));
  encoded := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < segs.len(), {
    match(
      segs.get(i),
      .Some(seg) => {
        encoded.push(percent.encode(seg));
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  joined := String.from("/").join(encoded);
  cond(
    joined.starts_with(String.from("/")) => `file://${joined}`,
    true => `file:///${joined}`
  )
});
/// A token's `module_path` as an LSP `file:` URI. Module paths arrive either
/// as `file:///abs` (import-resolved) or plain `/abs`; both are treated as a
/// filesystem path and encoded by `fs_path_to_uri`.
module_path_to_uri :: (fn(mp : String) -> String)(
  cond(
    mp.starts_with(String.from("file://")) => fs_path_to_uri(mp.substring(usize(7), mp.len())),
    true => fs_path_to_uri(mp)
  )
);

export(
  rune_col_to_byte_offset,
  byte_offset_to_rune_col,
  rune_col_to_utf16_col,
  utf16_col_to_rune_col,
  set_utf16_positions,
  utf16_positions,
  client_col_to_rune,
  rune_col_to_client,
  line_at,
  j_range_in,
  uri_to_fs_path,
  fs_path_to_uri,
  module_path_to_uri,
  JsonObjBuilder,
  jb,
  jstr,
  jnum,
  j_position,
  j_range,
  j_diagnostic,
  j_response,
  j_error_response,
  j_notification
);
