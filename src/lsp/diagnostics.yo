//! lsp/diagnostics — evaluate a document's text and turn evaluator errors
//! into LSP diagnostics.
//!
//! Analysis rides the same module_manager service `check` uses: the prelude
//! env is process-cached, imports demand-load and cache, and the document
//! itself is evaluated FRESH per call from its in-editor text (never from
//! disk, never registered in the module cache). Errors arrive as rendered
//! `YoError` strings (the P1 human format of src/diagnostics.yo) and
//! `parse_error_text` parses that EXACT renderer shape — `severity:` header
//! lines, `--> path:row:col` anchors, and the caret run itself as the
//! underline length, so ranges are exact. A structured (token, message)
//! channel that makes the parsing unnecessary is P3 of
//! plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md.
//!
//! Analysis state is kept even when the document has an error: a parse
//! failure yields `parsed == false` (the server then keeps serving the last
//! parsed outcome), an evaluation failure keeps the parsed program AND the
//! ExprInfo the evaluator recorded up to the error (`mm_eval_entry_exprs`
//! returns its real ctx on failure), so hover / completion / signature help
//! keep working on the part of the file that evaluated
//! (issues/fixed/lsp-analysis-state-lost-on-parse-and-eval-errors.md).
//!
//! Imports: an edit to an open imported file is visible to the next analysis
//! of an importing document (Phase B, plans/reference/INCREMENTAL_COMPILATION.md
//! — overlay + `mm_invalidate_document` in server.yo). Re-analysis purges the
//! document's previous registry generation before re-registering.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
open(import("std/error"));
{ parse } :: import("../parser.yo");
{ Diagnostic, Severity } :: import("../diagnostics.yo");
{ stash_error_diagnostics, take_error_diagnostics } :: import("../error.yo");
{ AstExpr } :: import("../expr.yo");
{ ExprInfoTable, expr_info_table_new } :: import("../expr_info.yo");
{
  mm_resolve_entry_abs,
  mm_eval_entry_exprs,
  mm_preload_prelude,
  mm_has_prelude_env,
  _take_load_error
} :: import("../module_manager.yo");

/// One analysis finding, 0-based positions (LSP convention; Token.row and
/// Token.column are already 0-based internally — the +1 lives only in the
/// display formatting, which is why the parser below subtracts 1).
LspDiag :: struct(
  row : usize,
  col : usize,
  end_col : usize,
  /// LSP DiagnosticSeverity: 1 error, 2 warning, 3 information (a `note`),
  /// 4 hint (a `help`).
  severity : usize,
  /// Registry code (`E0401`) when the diagnostic carries one.
  code : Option(String),
  message : String
);
/// LSP severity number for a renderer/registry `Severity`.
lsp_severity_of :: (fn(sev : Severity) -> usize)(
  match(
    sev,
    .Error => usize(1),
    .Warning => usize(2),
    .Note => usize(3),
    .Help => usize(4)
  )
);
export(LspDiag);

/// Parse-error stash: effect handlers cannot capture outer runtime
/// variables, so the analyzer's local exception handler records the thrown
/// error here (the same pattern as module_manager's load-error stash).
(g_parse_error : Option(String)) = Option(String).None;
_stash_parse_error :: (fn(msg : String) -> unit)({
  if(g_parse_error.is_none(), {
    g_parse_error = Option(String).Some(msg);
  });
});
_take_parse_error :: (fn() -> Option(String))({
  taken := g_parse_error;
  g_parse_error = Option(String).None;
  taken
});

/// True iff byte `b` is an ASCII digit.
_is_digit_byte :: (fn(b : u8) -> bool)(
  (b >= u8(48)) && (b <= u8(57))
);

/// The number of `^` bytes in `s` — the underline length the renderer drew
/// (the caret is ASCII, so bytes == runes).
_count_carets :: (fn(s : String) -> usize)({
  bytes := s.as_bytes();
  (n : usize) = usize(0);
  (i : usize) = usize(0);
  while(i < bytes.len(), {
    match(
      bytes.get(i),
      .Some(b) => {
        if(b == u8(94), {
          n = (n + usize(1));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  n
});

/// True iff `l` is the renderer's row line (`NN | source`, `NN` optionally
/// space-padded to the group's gutter width).
_is_row_line :: (fn(l : String) -> bool)({
  t := l.trim();
  bytes := t.as_bytes();
  (i : usize) = usize(0);
  (digits : usize) = usize(0);
  (scanning : bool) = true;
  while((i < bytes.len()) && scanning, {
    b := match(
      bytes.get(i),
      .Some(x) => x,
      .None => u8(0)
    );
    if(_is_digit_byte(b), {
      digits = (digits + usize(1));
      i = (i + usize(1));
    }, {
      scanning = false;
    });
  });
  if((digits == usize(0)) || ((i + usize(2)) > bytes.len()), {
    return(false);
  });
  b0 := match(
    bytes.get(i),
    .Some(x) => x,
    .None => u8(0)
  );
  b1 := match(
    bytes.get(i + usize(1)),
    .Some(x) => x,
    .None => u8(0)
  );
  (b0 == u8(32)) && (b1 == u8(124))
});

/// A rendered block's header, split: the LSP severity of the header word,
/// the `[CODE]` when present, and the message after the colon.
SevPrefix :: struct(
  severity : usize,
  code : Option(String),
  message : String
);
/// `<word>` optionally followed by `[CODE]`, then `: ` — strip through the
/// colon; .None when the message does not start with that shape.
_strip_sev_word :: (fn(message : String, word : str, severity : usize) -> Option(SevPrefix))({
  w := String.from(word);
  rest := String.new();
  (code : Option(String)) = Option(String).None;
  if((message.len() > w.len()) && message.starts_with(w), {
    rest = message.substring(w.len(), message.len());
    if(rest.starts_with(String.from("[")), {
      close := rest.index_of(String.from("]"));
      match(
        close,
        .Some(c) => {
          code = Option(String).Some(rest.substring(usize(1), c));
          rest = rest.substring(c + usize(1), rest.len());
        },
        .None => {
          rest = String.new();
        }
      );
    });
  });
  if((rest.len() > usize(0)) && rest.starts_with(String.from(": ")), {
    return(
      Option(SevPrefix).Some(
        SevPrefix(severity : severity, code : code, message : rest.substring(usize(2), rest.len()))
      )
    );
  });
  Option(SevPrefix).None
});
/// Split one severity header prefix off a rendered block's message — the
/// bare form (`error: `) and the coded form (`error[E0401]: `), which is
/// what the renderer emits for classified diagnostics (P2). A message with
/// no header is an error with no code.
_strip_severity_prefix :: (fn(message : String) -> SevPrefix)({
  match(
    _strip_sev_word(message.clone(), "error", usize(1)),
    .Some(p) => {
      return(p);
    },
    .None => ()
  );
  match(
    _strip_sev_word(message.clone(), "warning", usize(2)),
    .Some(p) => {
      return(p);
    },
    .None => ()
  );
  match(
    _strip_sev_word(message.clone(), "note", usize(3)),
    .Some(p) => {
      return(p);
    },
    .None => ()
  );
  match(
    _strip_sev_word(message.clone(), "help", usize(4)),
    .Some(p) => {
      return(p);
    },
    .None => ()
  );
  SevPrefix(severity : usize(1), code : Option(String).None, message : message)
});

/// Extract diagnostics from a rendered diagnostic-group string (the P1
/// human format of src/diagnostics.yo): blocks of `severity[code]: message`
/// lines followed by `<indent>--> <path>:<row+1>:<col+1>`, `<indent>|`,
/// `NN | source`, `<indent>| <spaces>^^^^`. The underline length is read
/// from the caret run itself, so end columns are exact — no identifier
/// guessing. Entries whose path is the analyzed document map to precise
/// ranges; entries in OTHER files (a broken import) surface at 0:0 with the
/// full message so the user still sees them.
parse_error_text :: (
  fn(err_text : String, doc_abs : String, doc_text : String) -> ArrayList(LspDiag)
)({
  out := ArrayList(LspDiag).new();
  lines := err_text.split(String.from("\n"));
  // Message accumulator: lines since the last anchor group.
  msg_parts := ArrayList(String).new();
  (li : usize) = usize(0);
  n := lines.len();
  while(li < n, {
    line := match(
      lines.get(li),
      .Some(l) => l,
      .None => String.new()
    );
    trimmed := line.trim();
    (handled : bool) = false;
    if(trimmed.starts_with(String.from("--> ")), {
      body := trimmed.substring(usize(4), trimmed.len());
      segs := body.split(String.from(":"));
      if(segs.len() >= usize(3), {
        col_s := match(
          segs.get(segs.len() - usize(1)),
          .Some(s) => s,
          .None => String.new()
        );
        row_s := match(
          segs.get(segs.len() - usize(2)),
          .Some(s) => s,
          .None => String.new()
        );
        match(
          row_s.parse_u64(),
          .Some(r1) => match(
            col_s.parse_u64(),
            .Some(c1) => {
              if((r1 >= u64(1)) && (c1 >= u64(1)), {
                handled = true;
                a_row := (usize(r1) - usize(1));
                a_col := (usize(c1) - usize(1));
                // path = body minus ":row:col" (split from the right, so a
                // path containing ':' cannot confuse it)
                tail_len := (row_s.len() + col_s.len() + usize(2));
                a_path := body.substring(usize(0), body.len() - tail_len);
                header := _strip_severity_prefix(
                  String.from("\n").join(msg_parts).trim()
                );
                message := header.message;
                if(message.len() > usize(0), {
                  same_file := ((a_path == doc_abs) || a_path.ends_with(doc_abs.clone()));
                  cond(
                    same_file => {
                      // The renderer emits up to three snippet lines after
                      // the anchor; consume exactly that shape and read the
                      // underline length off the caret run.
                      caret_len := usize(1);
                      (k : usize) = (li + usize(1));
                      (consumed : usize) = usize(0);
                      if(k < n, {
                        t0 := match(
                          lines.get(k),
                          .Some(x) => x,
                          .None => String.new()
                        );
                        if(t0.trim() == String.from("|"), {
                          k = (k + usize(1));
                          consumed = (consumed + usize(1));
                        });
                      });
                      if(k < n, {
                        t1 := match(
                          lines.get(k),
                          .Some(x) => x,
                          .None => String.new()
                        );
                        if(_is_row_line(t1), {
                          k = (k + usize(1));
                          consumed = (consumed + usize(1));
                        });
                      });
                      if(k < n, {
                        t2 := match(
                          lines.get(k),
                          .Some(x) => x,
                          .None => String.new()
                        );
                        t2t := t2.trim();
                        if(t2t.starts_with(String.from("| ")), {
                          cnt := _count_carets(t2t);
                          if(cnt > usize(0), {
                            caret_len = cnt;
                            consumed = (consumed + usize(1));
                          });
                        });
                      });
                      li = (li + consumed);
                      end_col := (a_col + caret_len);
                      out.push(
                        LspDiag(
                          row : a_row,
                          col : a_col,
                          end_col : end_col,
                          severity : header.severity,
                          code : header.code,
                          message : message
                        )
                      );
                    },
                    true => {
                      out.push(
                        LspDiag(
                          row : usize(0),
                          col : usize(0),
                          end_col : usize(1),
                          severity : header.severity,
                          code : header.code,
                          message : `${message} (in ${a_path}:${(a_row + usize(1))}:${(a_col + usize(1))})`
                        )
                      );
                    }
                  );
                });
                msg_parts = ArrayList(String).new();
              });
            },
            .None => ()
          ),
          .None => ()
        );
      });
    });
    if(!handled, {
      // The P2 `help: run yo explain …` tail line belongs to the block just
      // rendered — it must not leak into the NEXT entry's message text.
      if(!trimmed.starts_with(String.from("help: ")), {
        msg_parts.push(line);
      });
    });
    li = (li + usize(1));
  });
  // Nothing anchored (a bare string throw): one whole-message diagnostic at
  // 0:0.
  if((out.len() == usize(0)) && (err_text.trim().len() > usize(0)), {
    out.push(
      LspDiag(
        row : usize(0),
        col : usize(0),
        end_col : usize(1),
        severity : usize(1),
        code : Option(String).None,
        message : err_text.trim()
      )
    );
  });
  out
});
export(parse_error_text);

/// Prelude bootstrap, once per process. A separate fn so its swallowing
/// handler's `unwind(())` exits THIS unit-typed frame — `unwind` exits the
/// function that BOUND the ctl value, and a value/frame type mismatch is a
/// codegen-level error `check` cannot see (the handler transpiles hollow;
/// plans/archive/P4_LSP.md slice 0 notes — this bit this very file's first draft,
/// caught by the stage-2 hollow count).
_ensure_prelude :: (fn(std_path : String, io : Io) -> unit)({
  if(mm_has_prelude_env(), {
    return(());
  });
  pre_exn := Exception(
    throw : (
      err -> {
        _stash_parse_error(err.to_string());
        unwind(())
      }
    )
  );
  // The return value is deliberately ignored HERE and only here: a language
  // server must degrade, not die, when the prelude is broken — the stashed
  // parse error is surfaced as a diagnostic instead. Every other caller exits
  // (issues/fixed/failed-prelude-load-prints-twice-and-continues.md).
  mm_preload_prelude(std_path.clone(), false, io, pre_exn);
});

/// The retained result of one document analysis: the parsed program and
/// the ExprInfo side table the evaluation filled in. Hover / definition /
/// symbols read these between edits (plans/archive/P4_LSP.md slice 3+).
///
/// `parsed == false` means the text did not parse: `exprs` is empty and
/// `info_table` fresh, and the server keeps the previous outcome for feature
/// requests. `parsed && !ok` means the evaluation stopped at an error:
/// `exprs` is the full program and `info_table` holds everything recorded
/// before the error.
AnalyzeOutcome :: ref(
  struct(
    ok : bool,
    parsed : bool,
    exprs : ArrayList(AstExpr),
    info_table : ExprInfoTable
  )
);
export(AnalyzeOutcome);
/// Parse the document text under a swallowing handler; `.None` when it does
/// not parse. The handler's `unwind` exits THIS Option-typed frame (see
/// _ensure_prelude's note — the unwind value must match the frame the
/// Exception was bound in). A separate frame from `_analyze_eval` so a
/// failed EVALUATION cannot discard the successfully parsed program.
_parse_document :: (
  fn(entry_abs : String, text : String) -> Option(ArrayList(AstExpr))
)({
  local_exn := Exception(
    throw : (
      err -> {
        _stash_parse_error(err.to_string());
        stash_error_diagnostics(err);
        unwind(Option(ArrayList(AstExpr)).None)
      }
    )
  );
  Option(ArrayList(AstExpr)).Some(parse(text, entry_abs.clone(), local_exn))
});
/// The evaluation half: `ok` plus the ExprInfo table the run filled in.
EvalOutcome :: struct(
  ok : bool,
  info_table : ExprInfoTable
);
/// A failed evaluation with nothing recorded — what the loader-thrown path
/// (an imported file that does not parse) unwinds with. A FUNCTION because
/// an effect handler cannot reference outer runtime variables.
_failed_eval :: (fn() -> EvalOutcome)(
  EvalOutcome(ok : false, info_table : expr_info_table_new())
);
/// Evaluate the parsed program. Evaluation errors are captured INSIDE
/// `mm_eval_entry_exprs` (its `_eval_module_exprs_capturing_error`), which
/// then returns `ok : false` with the real ctx — so the ExprInfo recorded
/// before the error survives here. Only a throw from the demand LOADER
/// (an import whose file fails to read or parse) reaches the local handler,
/// which unwinds with an empty table.
_analyze_eval :: (
  fn(entry_abs : String, exprs : ArrayList(AstExpr), std_path : String, io : Io) -> EvalOutcome
)({
  local_exn := Exception(
    throw : (
      err -> {
        _stash_parse_error(err.to_string());
        stash_error_diagnostics(err);
        unwind(_failed_eval())
      }
    )
  );
  outcome := mm_eval_entry_exprs(entry_abs.clone(), std_path.clone(), exprs, local_exn);
  EvalOutcome(ok : outcome.ok, info_table : outcome.ctx.expr_info_table)
});

/// Map STRUCTURED diagnostics (the P3 typed channel) to LSP diagnostics —
/// exact ranges from the spans, no text parsing. Same-file entries get
/// precise ranges; foreign-file entries (a broken import's leaf) surface at
/// 0:0 with the location in the message, mirroring the text parser.
_typed_to_lsp :: (
  fn(diags : ArrayList(Diagnostic), doc_abs : String) -> ArrayList(LspDiag)
)({
  out := ArrayList(LspDiag).new();
  (i : usize) = usize(0);
  while(i < diags.len(), {
    match(
      diags.get(i),
      .Some(d) => {
        same_file := ((d.span.path == doc_abs) || d.span.path.ends_with(doc_abs.clone()));
        if(same_file, {
          out.push(
            LspDiag(
              row : d.span.row,
              col : d.span.col,
              end_col : (d.span.col + d.span.len),
              severity : lsp_severity_of(d.severity),
              code : d.code,
              message : d.message
            )
          );
        }, {
          out.push(
            LspDiag(
              row : usize(0),
              col : usize(0),
              end_col : usize(1),
              severity : lsp_severity_of(d.severity),
              code : d.code,
              message : `${d.message} (in ${d.span.path}:${(d.span.row + usize(1))}:${(d.span.col + usize(1))})`
            )
          );
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});
/// Evaluate `text` as the module at `doc_fs_path` and return diagnostics.
/// Empty result = clean file.
analyze_document :: (
  fn(
    doc_fs_path : String,
    text : String,
    std_path : String,
    io : Io,
    out_state : ArrayList(AnalyzeOutcome)
  ) -> ArrayList(LspDiag)
)({
  _ensure_prelude(std_path.clone(), io);
  entry_abs := mm_resolve_entry_abs(doc_fs_path.clone(), std_path.clone());
  outcome := match(
    _parse_document(entry_abs.clone(), text.clone()),
    .Some(exprs) => {
      ev := _analyze_eval(entry_abs.clone(), exprs, std_path.clone(), io);
      AnalyzeOutcome(ok : ev.ok, parsed : true, exprs : exprs, info_table : ev.info_table)
    },
    .None => AnalyzeOutcome(
      ok : false,
      parsed : false,
      exprs : ArrayList(AstExpr).new(),
      info_table : expr_info_table_new()
    )
  );
  out_state.push(outcome);
  diags := ArrayList(LspDiag).new();
  // Drain EVERY error channel this round filled, unconditionally — a
  // handler stashes the same error as typed diagnostics AND as rendered
  // text, and a stash left behind is reported by the NEXT round as a
  // phantom diagnostic (issues/fixed/lsp-stale-parse-diagnostic-survives-the-fix.md).
  typed := take_error_diagnostics();
  parse_text := _take_parse_error();
  load_text := _take_load_error();
  // P3 typed channel first: structured diagnostics for BOTH parse and eval
  // failures (every stage throws YoError now). The text parsers remain the
  // fallback for non-structured string throws only.
  match(
    typed,
    .Some(tds) => {
      mapped := _typed_to_lsp(tds, entry_abs.clone());
      (ti : usize) = usize(0);
      while(ti < mapped.len(), {
        match(
          mapped.get(ti),
          .Some(d) => {
            diags.push(d);
          },
          .None => ()
        );
        ti = (ti + usize(1));
      });
    },
    .None => ()
  );
  if(diags.len() == usize(0), {
    match(
      parse_text,
      .Some(pe) => {
        pds := parse_error_text(pe, entry_abs.clone(), text.clone());
        (pi : usize) = usize(0);
        while(pi < pds.len(), {
          match(
            pds.get(pi),
            .Some(d) => {
              diags.push(d);
            },
            .None => ()
          );
          pi = (pi + usize(1));
        });
      },
      .None => ()
    );
    match(
      load_text,
      .Some(le) => {
        lds := parse_error_text(le, entry_abs.clone(), text.clone());
        (ei : usize) = usize(0);
        while(ei < lds.len(), {
          match(
            lds.get(ei),
            .Some(d2) => {
              diags.push(d2);
            },
            .None => ()
          );
          ei = (ei + usize(1));
        });
      },
      .None => ()
    );
  });
  diags
});
export(analyze_document);
