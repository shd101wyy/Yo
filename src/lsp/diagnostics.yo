//! lsp/diagnostics — evaluate a document's text and turn evaluator errors
//! into LSP diagnostics.
//!
//! Analysis rides the same module_manager service `check` uses: the prelude
//! env is process-cached, imports demand-load and cache, and the document
//! itself is evaluated FRESH per call from its in-editor text (never from
//! disk, never registered in the module cache). Errors arrive as rendered
//! `YoError` strings (the P1 human format of src/diagnostics.yo) and
//! `parse_error_text` parses that EXACT renderer shape — `severity:` header
//! lines, `--> path:row:col` anchors, and the caret run itself as the
//! underline length, so ranges are exact. A structured (token, message)
//! channel that makes the parsing unnecessary is P3 of
//! plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md.
//!
//! KNOWN MVP LIMITS (plans/archive/P4_LSP.md kickoff notes):
//!   - Imports are cached for the process lifetime: an edit to an imported
//!     file is not seen until the server restarts. Invalidation is the
//!     incremental-compilation arc (plans/reference/INCREMENTAL_COMPILATION.md).
//!   - Re-analysis re-registers the document's impls under fresh type ids;
//!     the stale entries leak (bounded by edit count). The site-keyed
//!     duplicate-inherent-method gate is replay-safe by construction.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
open(import("std/error"));
{ parse } :: import("../parser.yo");
{ Diagnostic } :: import("../diagnostics.yo");
{ stash_error_diagnostics, take_error_diagnostics } :: import("../error.yo");
{ AstExpr } :: import("../expr.yo");
{ ExprInfoTable, expr_info_table_new } :: import("../expr_info.yo");
{
  mm_resolve_entry_abs,
  mm_eval_entry_exprs,
  mm_preload_prelude,
  mm_has_prelude_env,
  _take_load_error
} :: import("../module_manager.yo");

/// One analysis finding, 0-based positions (LSP convention; Token.row and
/// Token.column are already 0-based internally — the +1 lives only in the
/// display formatting, which is why the parser below subtracts 1).
LspDiag :: struct(
  row : usize,
  col : usize,
  end_col : usize,
  message : String
);
export(LspDiag);

/// Parse-error stash: effect handlers cannot capture outer runtime
/// variables, so the analyzer's local exception handler records the thrown
/// error here (the same pattern as module_manager's load-error stash).
(g_parse_error : Option(String)) = Option(String).None;
_stash_parse_error :: (fn(msg : String) -> unit)({
  if(g_parse_error.is_none(), {
    g_parse_error = Option(String).Some(msg);
  });
});
_take_parse_error :: (fn() -> Option(String))({
  taken := g_parse_error;
  g_parse_error = Option(String).None;
  taken
});

/// True iff byte `b` is an ASCII digit.
_is_digit_byte :: (fn(b : u8) -> bool)(
  (b >= u8(48)) && (b <= u8(57))
);

/// The number of `^` bytes in `s` — the underline length the renderer drew
/// (the caret is ASCII, so bytes == runes).
_count_carets :: (fn(s : String) -> usize)({
  bytes := s.as_bytes();
  (n : usize) = usize(0);
  (i : usize) = usize(0);
  while(i < bytes.len(), {
    match(
      bytes.get(i),
      .Some(b) => {
        if(b == u8(94), {
          n = (n + usize(1));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  n
});

/// True iff `l` is the renderer's row line (`NN | source`, `NN` optionally
/// space-padded to the group's gutter width).
_is_row_line :: (fn(l : String) -> bool)({
  t := l.trim();
  bytes := t.as_bytes();
  (i : usize) = usize(0);
  (digits : usize) = usize(0);
  (scanning : bool) = true;
  while((i < bytes.len()) && scanning, {
    b := match(
      bytes.get(i),
      .Some(x) => x,
      .None => u8(0)
    );
    if(_is_digit_byte(b), {
      digits = (digits + usize(1));
      i = (i + usize(1));
    }, {
      scanning = false;
    });
  });
  if((digits == usize(0)) || ((i + usize(2)) > bytes.len()), {
    return(false);
  });
  b0 := match(
    bytes.get(i),
    .Some(x) => x,
    .None => u8(0)
  );
  b1 := match(
    bytes.get(i + usize(1)),
    .Some(x) => x,
    .None => u8(0)
  );
  (b0 == u8(32)) && (b1 == u8(124))
});

/// `<word>` optionally followed by `[CODE]`, then `: ` — strip through the
/// colon; .None when the message does not start with that shape.
_strip_sev_word :: (fn(message : String, word : str) -> Option(String))({
  w := String.from(word);
  rest := String.new();
  if((message.len() > w.len()) && message.starts_with(w), {
    rest = message.substring(w.len(), message.len());
    if(rest.starts_with(String.from("[")), {
      close := rest.index_of(String.from("]"));
      match(
        close,
        .Some(c) => {
          rest = rest.substring(c + usize(1), rest.len());
        },
        .None => {
          rest = String.new();
        }
      );
    });
  });
  if((rest.len() > usize(0)) && rest.starts_with(String.from(": ")), {
    return(Option(String).Some(rest.substring(usize(2), rest.len())));
  });
  Option(String).None
});
/// Strip one severity header prefix off a rendered block's message — the
/// bare form (`error: `) and the coded form (`error[E0401]: `), which is
/// what the renderer emits for classified diagnostics (P2).
_strip_severity_prefix :: (fn(message : String) -> String)(
  cond(
    _strip_sev_word(message, "error").is_some() => _strip_sev_word(message, "error").unwrap_or(message),
    _strip_sev_word(message, "warning").is_some() => _strip_sev_word(message, "warning").unwrap_or(message),
    _strip_sev_word(message, "note").is_some() => _strip_sev_word(message, "note").unwrap_or(message),
    _strip_sev_word(message, "help").is_some() => _strip_sev_word(message, "help").unwrap_or(message),
    true => message
  )
);

/// Extract diagnostics from a rendered diagnostic-group string (the P1
/// human format of src/diagnostics.yo): blocks of `severity[code]: message`
/// lines followed by `<indent>--> <path>:<row+1>:<col+1>`, `<indent>|`,
/// `NN | source`, `<indent>| <spaces>^^^^`. The underline length is read
/// from the caret run itself, so end columns are exact — no identifier
/// guessing. Entries whose path is the analyzed document map to precise
/// ranges; entries in OTHER files (a broken import) surface at 0:0 with the
/// full message so the user still sees them.
parse_error_text :: (
  fn(err_text : String, doc_abs : String, doc_text : String) -> ArrayList(LspDiag)
)({
  out := ArrayList(LspDiag).new();
  lines := err_text.split(String.from("\n"));
  // Message accumulator: lines since the last anchor group.
  msg_parts := ArrayList(String).new();
  (li : usize) = usize(0);
  n := lines.len();
  while(li < n, {
    line := match(
      lines.get(li),
      .Some(l) => l,
      .None => String.new()
    );
    trimmed := line.trim();
    (handled : bool) = false;
    if(trimmed.starts_with(String.from("--> ")), {
      body := trimmed.substring(usize(4), trimmed.len());
      segs := body.split(String.from(":"));
      if(segs.len() >= usize(3), {
        col_s := match(
          segs.get(segs.len() - usize(1)),
          .Some(s) => s,
          .None => String.new()
        );
        row_s := match(
          segs.get(segs.len() - usize(2)),
          .Some(s) => s,
          .None => String.new()
        );
        match(
          row_s.parse_u64(),
          .Some(r1) => match(
            col_s.parse_u64(),
            .Some(c1) => {
              if((r1 >= u64(1)) && (c1 >= u64(1)), {
                handled = true;
                a_row := (usize(r1) - usize(1));
                a_col := (usize(c1) - usize(1));
                // path = body minus ":row:col" (split from the right, so a
                // path containing ':' cannot confuse it)
                tail_len := (row_s.len() + col_s.len() + usize(2));
                a_path := body.substring(usize(0), body.len() - tail_len);
                message := _strip_severity_prefix(
                  String.from("\n").join(msg_parts).trim()
                );
                if(message.len() > usize(0), {
                  same_file := ((a_path == doc_abs) || a_path.ends_with(doc_abs.clone()));
                  cond(
                    same_file => {
                      // The renderer emits up to three snippet lines after
                      // the anchor; consume exactly that shape and read the
                      // underline length off the caret run.
                      caret_len := usize(1);
                      (k : usize) = (li + usize(1));
                      (consumed : usize) = usize(0);
                      if(k < n, {
                        t0 := match(
                          lines.get(k),
                          .Some(x) => x,
                          .None => String.new()
                        );
                        if(t0.trim() == String.from("|"), {
                          k = (k + usize(1));
                          consumed = (consumed + usize(1));
                        });
                      });
                      if(k < n, {
                        t1 := match(
                          lines.get(k),
                          .Some(x) => x,
                          .None => String.new()
                        );
                        if(_is_row_line(t1), {
                          k = (k + usize(1));
                          consumed = (consumed + usize(1));
                        });
                      });
                      if(k < n, {
                        t2 := match(
                          lines.get(k),
                          .Some(x) => x,
                          .None => String.new()
                        );
                        t2t := t2.trim();
                        if(t2t.starts_with(String.from("| ")), {
                          cnt := _count_carets(t2t);
                          if(cnt > usize(0), {
                            caret_len = cnt;
                            consumed = (consumed + usize(1));
                          });
                        });
                      });
                      li = (li + consumed);
                      end_col := (a_col + caret_len);
                      out.push(
                        LspDiag(row : a_row, col : a_col, end_col : end_col, message : message)
                      );
                    },
                    true => {
                      out.push(
                        LspDiag(
                          row : usize(0),
                          col : usize(0),
                          end_col : usize(1),
                          message : `${message} (in ${a_path}:${(a_row + usize(1))}:${(a_col + usize(1))})`
                        )
                      );
                    }
                  );
                });
                msg_parts = ArrayList(String).new();
              });
            },
            .None => ()
          ),
          .None => ()
        );
      });
    });
    if(!handled, {
      // The P2 `help: run yo explain …` tail line belongs to the block just
      // rendered — it must not leak into the NEXT entry's message text.
      if(!trimmed.starts_with(String.from("help: ")), {
        msg_parts.push(line);
      });
    });
    li = (li + usize(1));
  });
  // Nothing anchored (a bare string throw): one whole-message diagnostic at
  // 0:0.
  if((out.len() == usize(0)) && (err_text.trim().len() > usize(0)), {
    out.push(
      LspDiag(
        row : usize(0),
        col : usize(0),
        end_col : usize(1),
        message : err_text.trim()
      )
    );
  });
  out
});
export(parse_error_text);

/// Prelude bootstrap, once per process. A separate fn so its swallowing
/// handler's `unwind(())` exits THIS unit-typed frame — `unwind` exits the
/// function that BOUND the ctl value, and a value/frame type mismatch is a
/// codegen-level error `check` cannot see (the handler transpiles hollow;
/// plans/archive/P4_LSP.md slice 0 notes — this bit this very file's first draft,
/// caught by the stage-2 hollow count).
_ensure_prelude :: (fn(std_path : String, io : Io) -> unit)({
  if(mm_has_prelude_env(), {
    return(());
  });
  pre_exn := Exception(
    throw : (
      err -> {
        _stash_parse_error(err.to_string());
        unwind(())
      }
    )
  );
  mm_preload_prelude(std_path.clone(), false, io, pre_exn);
});

/// The retained result of one document analysis: the parsed program and
/// the ExprInfo side table the evaluation filled in. Hover / definition /
/// symbols read these between edits (plans/archive/P4_LSP.md slice 3+).
AnalyzeOutcome :: ref(
  struct(
    ok : bool,
    exprs : ArrayList(AstExpr),
    info_table : ExprInfoTable
  )
);
export(AnalyzeOutcome);
/// Parse + evaluate the document text under a swallowing handler. The
/// handler's `unwind` exits THIS AnalyzeOutcome-typed frame (see
/// _ensure_prelude's note — the unwind value must match the frame the
/// Exception was bound in). Mirrors module_manager's
/// _eval_module_exprs_capturing_error structure.
_analyze_eval :: (
  fn(entry_abs : String, text : String, std_path : String, io : Io) -> AnalyzeOutcome
)({
  local_exn := Exception(
    throw : (
      err -> {
        _stash_parse_error(err.to_string());
        stash_error_diagnostics(err);
        unwind(
          AnalyzeOutcome(
            ok : false,
            exprs : ArrayList(AstExpr).new(),
            info_table : expr_info_table_new()
          )
        )
      }
    )
  );
  exprs := parse(text, entry_abs.clone(), local_exn);
  outcome := mm_eval_entry_exprs(entry_abs.clone(), std_path.clone(), exprs, local_exn);
  AnalyzeOutcome(ok : outcome.ok, exprs : exprs, info_table : outcome.ctx.expr_info_table)
});

/// Map STRUCTURED diagnostics (the P3 typed channel) to LSP diagnostics —
/// exact ranges from the spans, no text parsing. Same-file entries get
/// precise ranges; foreign-file entries (a broken import's leaf) surface at
/// 0:0 with the location in the message, mirroring the text parser.
_typed_to_lsp :: (
  fn(diags : ArrayList(Diagnostic), doc_abs : String) -> ArrayList(LspDiag)
)({
  out := ArrayList(LspDiag).new();
  (i : usize) = usize(0);
  while(i < diags.len(), {
    match(
      diags.get(i),
      .Some(d) => {
        same_file := ((d.span.path == doc_abs) || d.span.path.ends_with(doc_abs.clone()));
        if(same_file, {
          out.push(
            LspDiag(
              row : d.span.row,
              col : d.span.col,
              end_col : (d.span.col + d.span.len),
              message : d.message
            )
          );
        }, {
          out.push(
            LspDiag(
              row : usize(0),
              col : usize(0),
              end_col : usize(1),
              message : `${d.message} (in ${d.span.path}:${(d.span.row + usize(1))}:${(d.span.col + usize(1))})`
            )
          );
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});
/// Evaluate `text` as the module at `doc_fs_path` and return diagnostics.
/// Empty result = clean file.
analyze_document :: (
  fn(
    doc_fs_path : String,
    text : String,
    std_path : String,
    io : Io,
    out_state : ArrayList(AnalyzeOutcome)
  ) -> ArrayList(LspDiag)
)({
  _ensure_prelude(std_path.clone(), io);
  entry_abs := mm_resolve_entry_abs(doc_fs_path.clone(), std_path.clone());
  outcome := _analyze_eval(entry_abs.clone(), text.clone(), std_path.clone(), io);
  out_state.push(outcome);
  diags := ArrayList(LspDiag).new();
  // P3 typed channel first: structured diagnostics for BOTH parse and eval
  // failures (every stage throws YoError now). The text parsers remain the
  // fallback for non-structured string throws only.
  typed := take_error_diagnostics();
  match(
    typed,
    .Some(tds) => {
      mapped := _typed_to_lsp(tds, entry_abs.clone());
      (ti : usize) = usize(0);
      while(ti < mapped.len(), {
        match(
          mapped.get(ti),
          .Some(d) => {
            diags.push(d);
          },
          .None => ()
        );
        ti = (ti + usize(1));
      });
    },
    .None => ()
  );
  if(diags.len() == usize(0), {
    match(
      _take_parse_error(),
      .Some(pe) => {
        pds := parse_error_text(pe, entry_abs.clone(), text.clone());
        (pi : usize) = usize(0);
        while(pi < pds.len(), {
          match(
            pds.get(pi),
            .Some(d) => {
              diags.push(d);
            },
            .None => ()
          );
          pi = (pi + usize(1));
        });
      },
      .None => ()
    );
    match(
      _take_load_error(),
      .Some(le) => {
        lds := parse_error_text(le, entry_abs.clone(), text.clone());
        (ei : usize) = usize(0);
        while(ei < lds.len(), {
          match(
            lds.get(ei),
            .Some(d2) => {
              diags.push(d2);
            },
            .None => ()
          );
          ei = (ei + usize(1));
        });
      },
      .None => ()
    );
  });
  diags
});
export(analyze_document);
