//! lsp/server — the `yo lsp` language server (plans/archive/P4_LSP.md slice 1 + 2).
//!
//! Speaks LSP over stdio: base-protocol framing (transport.yo), JSON-RPC
//! dispatch, the initialize handshake, FULL text-document sync, and push
//! diagnostics on open/change (diagnostics.yo). One message is handled at a
//! time — the protocol methods served so far are all sequential-safe.
//!
//! Every message is handled inside `_handle_message`, whose LOCAL exception
//! handler turns a malformed frame or JSON body into a skipped message
//! instead of a dead server (`unwind` exits the INSTALLING function, so the
//! handler must live in the per-message helper, not the loop).
//!
//! Positions cross this file in the CLIENT's encoding and leave it as RUNE
//! columns (`_rune_position`); handlers emit ranges through `j_range_in`,
//! which converts back. The encoding itself is negotiated in `initialize`
//! (protocol.yo, "Column bases").
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ Exception } :: import("std/error");
{ eprintln } :: import("std/fmt");
json :: import("std/encoding/json");
{ JsonValue } :: import("std/encoding/json");
{ read_lsp_message, write_lsp_message, prepare_wire } :: import("./transport.yo");
{
  jb,
  jstr,
  jnum,
  j_diagnostic,
  j_range,
  j_range_in,
  j_response,
  j_error_response,
  j_notification,
  uri_to_fs_path,
  module_path_to_uri,
  set_position_encoding,
  set_hover_markdown,
  client_col_to_rune,
  line_at
} :: import("./protocol.yo");
{ analyze_document, LspDiag, RelatedInfo, AnalyzeOutcome } :: import("./diagnostics.yo");
{ handle_hover } :: import("./hover.yo");
{ handle_definition, handle_type_definition, handle_document_links } :: import("./definition.yo");
{ handle_document_symbols, handle_document_symbols_flat, handle_workspace_symbols, handle_implementations, WorkspaceDoc } :: import("./symbols.yo");
{ handle_references, handle_document_highlight } :: import("./references.yo");
{ handle_folding_ranges, handle_semantic_tokens } :: import("./folding.yo");
{ handle_rename, handle_prepare_rename, rename_rejection } :: import("./rename.yo");
{ handle_signature_help } :: import("./signature_help.yo");
{ handle_completion } :: import("./completion.yo");
{ format_yo_source } :: import("../formatter.yo");
{ resolve_std_path, mm_invalidate_document, mm_set_open_document, mm_forget_open_document, mm_module_source } :: import("../module_manager.yo");
{ BufReader } :: import("std/io/bufio");
{ Stdin, stdin } :: import("std/io/stdio");

/// Per-document retained state: the editor's newest text (and its lines,
/// split once for column conversion), the resolved module path, and the
/// analysis outcome feature requests read. `outcome` is the LAST PARSED
/// outcome — a text that fails to parse (most keystrokes mid-expression)
/// keeps the previous program and ExprInfo in place, so hover, symbols and
/// completion keep answering from the last shape the parser accepted
/// (issues/fixed/lsp-analysis-state-lost-on-parse-and-eval-errors.md).
/// Positions are matched against `text` by token (value, row, column), so a
/// stale outcome answers only where the two still agree, never wrongly.
DocState :: ref(
  struct(
    text : String,
    lines : ArrayList(String),
    entry_abs : String,
    outcome : AnalyzeOutcome,
    /// This version's diagnostics, kept for `textDocument/codeAction`: the
    /// quickfixes are the `Repair`s they carry.
    diags : ArrayList(LspDiag)
  )
);

/// Lifecycle state (LSP's `initialize`/`shutdown`/`exit` sequence): 0 =
/// uninitialized (only `initialize` and `exit` are served), 1 = running,
/// 2 = shut down (only `exit` is served; `exit` then exits 0). Module-level
/// because it must survive across `_handle_message` calls
/// (issues/fixed/lsp-jsonrpc-lifecycle-and-dollar-requests.md).
(g_server_state : usize) = usize(0);

/// Whether the client declared
/// `textDocument.documentSymbol.hierarchicalDocumentSymbolSupport` — read at
/// `initialize`; without it `textDocument/documentSymbol` replies with FLAT
/// `SymbolInformation[]` instead of hierarchical `DocumentSymbol[]`, which
/// such clients cannot render (VS Code's client always declares it; the
/// cli-case driver does not).
(g_hierarchical_symbols : bool) = false;

/// Read a string field out of a JSON object; empty string when absent.
_jfield_str :: (fn(v : JsonValue, key : str) -> String)(
  match(
    v.get(String.from(key)),
    .Some(f) => match(f, .Str(x) => x, _ => String.new()),
    .None => String.new()
  )
);
/// Read a numeric field as usize; 0 when absent or not a number.
_jfield_usize :: (fn(v : JsonValue, key : str) -> usize)(
  match(
    v.get(String.from(key)),
    // LSP integer fields (line, character, id) parse as .Int — without this
    // arm every one of them would silently read 0.
    .Some(f) => match(f, .Int(i) => usize(i), .Number(n) => usize(n), _ => usize(0)),
    .None => usize(0)
  )
);
/// Read a boolean field; `dflt` when absent or not a boolean.
_jfield_bool :: (fn(v : JsonValue, key : str, dflt : bool) -> bool)(
  match(
    v.get(String.from(key)),
    .Some(f) => match(f, .Bool(b) => b, _ => dflt),
    .None => dflt
  )
);
/// `params.textDocument.uri`; empty string when absent.
_params_uri :: (fn(params : JsonValue) -> String)(
  match(
    params.get(String.from("textDocument")),
    .Some(td) => _jfield_str(td, "uri"),
    .None => String.new()
  )
);

/// A document position in RUNE columns.
LspPos :: struct(
  line : usize,
  character : usize
);
/// `params.position`, with `character` converted from the client's encoding
/// to a RUNE column against the document's line.
_rune_position :: (fn(params : JsonValue, lines : ArrayList(String)) -> LspPos)(
  match(
    params.get(String.from("position")),
    .Some(pos) => {
      line := _jfield_usize(pos, "line");
      character := _jfield_usize(pos, "character");
      LspPos(line : line, character : client_col_to_rune(line_at(lines, line), character))
    },
    .None => LspPos(line : usize(0), character : usize(0))
  )
);

/// The `relatedInformation` array for one diagnostic's note/help entries,
/// or Null when it has none. A related span converts to the wire encoding
/// against ITS file's lines — this document's, or the target module's
/// current source (open-buffer overlay or disk, the same reader
/// definition.yo uses); only when the target cannot be read are the rune
/// columns emitted unconverted (exact for BMP-only lines, the only thing
/// knowable without the text).
_related_json :: (fn(related : ArrayList(RelatedInfo), lines : ArrayList(String), doc_fs : String) -> JsonValue)({
  if(related.len() == usize(0), {
    return(JsonValue.Null);
  });
  items := ArrayList(JsonValue).new();
  (i : usize) = usize(0);
  while(i < related.len(), {
    match(
      related.get(i),
      .Some(r) => {
        same_doc := (uri_to_fs_path(r.path.clone()) == doc_fs.clone());
        range := cond(
          same_doc => j_range_in(lines, r.row, r.col, r.row, r.end_col),
          true => match(
            mm_module_source(uri_to_fs_path(r.path.clone())),
            .Some(src) => j_range_in(src.split(String.from("\n")), r.row, r.col, r.row, r.end_col),
            .None => j_range(r.row, r.col, r.row, r.end_col)
          )
        );
        items.push(
          jb().put("location", jb().put("uri", jstr(module_path_to_uri(r.path.clone()))).put("range", range).obj()).put("message", jstr(r.message.clone())).obj()
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  JsonValue.Array(items : items)
});

/// Analyze `text` as the document at `uri`, retain the analysis state for
/// feature requests, and push publishDiagnostics.
_analyze_and_publish :: (
  fn(uri : String, text : String, std_path : String, docs : HashMap(String, DocState), io : Io) -> unit
)({
  fs_path := uri_to_fs_path(uri.clone());
  // Phase B1 (plans/reference/INCREMENTAL_COMPILATION.md): the editor holds this
  // file's newest text — record it as the loader's open-buffer overlay,
  // then drop any cached module built from an older version PLUS every
  // transitive dependent. Together these make an edit to an IMPORTED file
  // visible to the next analysis of any importing document (previously:
  // invisible until the server restarted).
  mm_set_open_document(fs_path.clone(), text.clone());
  _inv := mm_invalidate_document(fs_path.clone());
  out_state := ArrayList(AnalyzeOutcome).new();
  diags := analyze_document(fs_path.clone(), text.clone(), std_path, io, out_state);
  lines := text.split(String.from("\n"));
  match(
    out_state.get(usize(0)),
    .Some(oc) => {
      // A text that did not parse keeps the last parsed outcome (see
      // DocState); an evaluation error keeps this run's program + partial
      // ExprInfo.
      retained := cond(
        oc.parsed => oc,
        true => match(
          docs.get(uri.clone()),
          .Some(prev) => prev.outcome,
          .None => oc
        )
      );
      docs.insert(
        uri.clone(),
        DocState(text : text.clone(), lines : lines, entry_abs : fs_path.clone(), outcome : retained, diags : diags.clone())
      );
    },
    .None => ()
  );
  items := ArrayList(JsonValue).new();
  (i : usize) = usize(0);
  while(i < diags.len(), {
    match(
      diags.get(i),
      .Some(d) => {
        items.push(
          j_diagnostic(j_range_in(lines, d.row, d.col, d.row, d.end_col), d.severity, d.code, d.message, _related_json(d.related, lines, fs_path))
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  params := jb().put("uri", jstr(uri)).put("diagnostics", JsonValue.Array(items : items)).obj();
  write_lsp_message(json.stringify(j_notification("textDocument/publishDiagnostics", params)));
});

/// Send an empty diagnostics list for `uri` (clears squiggles on close).
_publish_empty :: (fn(uri : String) -> unit)({
  params := jb().put("uri", jstr(uri)).put("diagnostics", JsonValue.Array(items : ArrayList(JsonValue).new())).obj();
  write_lsp_message(json.stringify(j_notification("textDocument/publishDiagnostics", params)));
});

/// signatureHelp trigger characters: "(" and ",".
_sig_triggers :: (fn() -> ArrayList(JsonValue))({
  ts := ArrayList(JsonValue).new();
  ts.push(jstr(String.from("(")));
  ts.push(jstr(String.from(",")));
  ts
});

/// The semanticTokens legend's token types (folding.yo's _SEM_* indices).
_semantic_token_types :: (fn() -> ArrayList(JsonValue))({
  ts := ArrayList(JsonValue).new();
  ts.push(jstr(String.from("keyword")));
  ts.push(jstr(String.from("type")));
  ts.push(jstr(String.from("function")));
  ts.push(jstr(String.from("variable")));
  ts.push(jstr(String.from("property")));
  ts.push(jstr(String.from("string")));
  ts.push(jstr(String.from("number")));
  ts.push(jstr(String.from("comment")));
  ts
});

/// completion trigger characters: member access and import-path strings.
_completion_triggers :: (fn() -> ArrayList(JsonValue))({
  ts := ArrayList(JsonValue).new();
  ts.push(jstr(String.from(".")));
  ts.push(jstr(String.from("\"")));
  ts.push(jstr(String.from("/")));
  ts
});

/// The client's `capabilities.general.positionEncodings` list, or an empty
/// list when absent.
_client_position_encodings :: (fn(params : JsonValue) -> ArrayList(String))({
  out := ArrayList(String).new();
  encodings := match(
    params.get(String.from("capabilities")),
    .Some(caps) => match(
      caps.get(String.from("general")),
      .Some(general) => general.get(String.from("positionEncodings")),
      .None => Option(JsonValue).None
    ),
    .None => Option(JsonValue).None
  );
  match(
    encodings,
    .Some(encs) => match(
      encs,
      .Array(items) => {
        (i : usize) = usize(0);
        while(i < items.len(), {
          match(
            items.get(i),
            .Some(.Str(s)) => out.push(s.clone()),
            .Some(_) => (),
            .None => ()
          );
          i = (i + usize(1));
        });
        out
      },
      _ => out
    ),
    .None => out
  )
});

/// The encoding to negotiate: `utf-32` (1, the server's native column unit —
/// nothing is converted) when the client offers it, else `utf-16` (0), else
/// `utf-8` (2). An absent or empty list takes the protocol default utf-16;
/// the answer is never an encoding the client did not offer
/// (issues/lsp-position-encoding-is-negotiated-against-the-clients-list.md).
_negotiated_encoding :: (fn(params : JsonValue) -> usize)({
  offered := _client_position_encodings(params);
  (i : usize) = usize(0);
  while(i < offered.len(), {
    match(
      offered.get(i),
      .Some(s) => {
        if(s == String.from("utf-32"), {
          return(usize(1));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  (j : usize) = usize(0);
  while(j < offered.len(), {
    match(
      offered.get(j),
      .Some(s) => {
        if(s == String.from("utf-16"), {
          return(usize(0));
        });
      },
      .None => ()
    );
    j = (j + usize(1));
  });
  (k : usize) = usize(0);
  while(k < offered.len(), {
    match(
      offered.get(k),
      .Some(s) => {
        if(s == String.from("utf-8"), {
          return(usize(2));
        });
      },
      .None => ()
    );
    k = (k + usize(1));
  });
  usize(0)
});

/// True iff the client declared
/// `textDocument.documentSymbol.hierarchicalDocumentSymbolSupport` — without
/// it the documentSymbol reply must be FLAT SymbolInformation[], not the
/// hierarchical DocumentSymbol[] (VS Code's client always declares it).
_client_wants_hierarchical_symbols :: (fn(params : JsonValue) -> bool)(
  match(
    params.get(String.from("capabilities")),
    .Some(caps) => match(
      caps.get(String.from("textDocument")),
      .Some(td) => match(
        td.get(String.from("documentSymbol")),
        .Some(ds) => _jfield_bool(ds, "hierarchicalDocumentSymbolSupport", false),
        .None => false
      ),
      .None => false
    ),
    .None => false
  )
);

/// True iff the client accepts markdown hover content: false only when
/// `textDocument.hover.contentFormat` is a NONEMPTY list without "markdown"
/// (absent means the protocol default, markdown first).
_client_accepts_markdown_hover :: (fn(params : JsonValue) -> bool)({
  fmts := match(
    params.get(String.from("capabilities")),
    .Some(caps) => match(
      caps.get(String.from("textDocument")),
      .Some(td) => match(
        td.get(String.from("hover")),
        .Some(h) => h.get(String.from("contentFormat")),
        .None => Option(JsonValue).None
      ),
      .None => Option(JsonValue).None
    ),
    .None => Option(JsonValue).None
  );
  match(
    fmts,
    .Some(.Array(items)) => {
      if(items.len() == usize(0), {
        return(true);
      });
      (i : usize) = usize(0);
      while(i < items.len(), {
        match(
          items.get(i),
          .Some(.Str(s)) => {
            if(s == String.from("markdown"), {
              return(true);
            });
          },
          .Some(_) => (),
          .None => ()
        );
        i = (i + usize(1));
      });
      false
    },
    _ => true
  )
});

/// The `initialize` response: full-document sync, every feature provider,
/// and the negotiated `positionEncoding` — `utf-32` when the client offers
/// it (the server's native unit, so nothing is converted), else `utf-16`
/// (the protocol default), else `utf-8`; every emitted and received column
/// is converted to/from it (issues/fixed/lsp-emits-rune-columns-where-the-protocol-says-utf16.md,
/// issues/fixed/lsp-initialize-discards-the-clients-params.md). Push
/// diagnostics carry no capability flag. The client's documentSymbol and
/// hover capability shapes are recorded for the reply builders
/// (`g_hierarchical_symbols`, `set_hover_markdown`).
_initialize_result :: (fn(params : JsonValue) -> JsonValue)({
  enc := _negotiated_encoding(params);
  set_position_encoding(enc);
  g_hierarchical_symbols = _client_wants_hierarchical_symbols(params);
  set_hover_markdown(_client_accepts_markdown_hover(params));
  encoding := cond(
    (enc == usize(1)) => String.from("utf-32"),
    (enc == usize(2)) => String.from("utf-8"),
    true => String.from("utf-16")
  );
  jb().put("capabilities", jb().put("positionEncoding", jstr(encoding)).put("textDocumentSync", jnum(usize(1))).put("hoverProvider", JsonValue.Bool(value : true)).put("definitionProvider", JsonValue.Bool(value : true)).put("declarationProvider", JsonValue.Bool(value : true)).put("implementationProvider", JsonValue.Bool(value : true)).put("documentLinkProvider", JsonValue.Bool(value : true)).put("typeDefinitionProvider", JsonValue.Bool(value : true)).put("documentHighlightProvider", JsonValue.Bool(value : true)).put("documentSymbolProvider", JsonValue.Bool(value : true)).put("referencesProvider", JsonValue.Bool(value : true)).put("foldingRangeProvider", JsonValue.Bool(value : true)).put("renameProvider", jb().put("prepareProvider", JsonValue.Bool(value : true)).obj()).put("codeActionProvider", JsonValue.Bool(value : true)).put("documentFormattingProvider", JsonValue.Bool(value : true)).put("workspaceSymbolProvider", JsonValue.Bool(value : true)).put("semanticTokensProvider", jb().put("legend", jb().put("tokenTypes", JsonValue.Array(items : _semantic_token_types())).put("tokenModifiers", JsonValue.Array(items : ArrayList(JsonValue).new())).obj()).put("full", JsonValue.Bool(value : true)).obj()).put("signatureHelpProvider", jb().put("triggerCharacters", JsonValue.Array(items : _sig_triggers())).obj()).put("completionProvider", jb().put("triggerCharacters", JsonValue.Array(items : _completion_triggers())).obj()).obj()).put(
    "serverInfo",
    // No `version` field on purpose: it is optional in the protocol, the
    // client can ask `yo --version`, and a version here would churn the
    // lsp cli-case golden on every release bump.
    jb().put("name", jstr(String.from("yo-lsp"))).obj()
  ).obj()
});

/// Whole-document formatting via `yo fmt`'s format_yo_source. Returns the
/// LSP result: an ARRAY with one whole-document TextEdit, an EMPTY array
/// when already canonical, or Null (own unwind frame) when the source does
/// not parse — the client keeps the buffer untouched.
_format_document :: (fn(text : String, doc_abs : String) -> JsonValue)({
  fmt_exn := Exception(
    throw : (
      _err -> unwind(JsonValue.Null)
    )
  );
  formatted := format_yo_source(text.clone(), doc_abs.clone(), fmt_exn);
  if(formatted == text, {
    return(JsonValue.Array(items : ArrayList(JsonValue).new()));
  });
  lines := text.split(String.from("\n"));
  line_count := lines.len();
  edits := ArrayList(JsonValue).new();
  edits.push(
    // The replacement ends INSIDE the document — at the last line's end —
    // never one line past it: an out-of-bounds end is a protocol violation
    // strict clients reject, and it used to be pinned in the lsp-handshake
    // golden (issues/fixed/lsp-formatting-edit-end-position-past-document-end.md).
    // Column 0 needs no wire conversion; the end column runs through
    // j_range_in like every emitted column.
    jb().put("range", j_range_in(lines, usize(0), usize(0), line_count - usize(1), line_at(lines, line_count - usize(1)).chars().count())).put("newText", jstr(formatted)).obj()
  );
  JsonValue.Array(items : edits)
});

/// Write the response for `id_opt` (a REQUEST); a notification-shaped
/// message (no id) gets nothing back.
_respond :: (fn(id_opt : Option(JsonValue), result : JsonValue) -> unit)({
  match(
    id_opt,
    .Some(id) => write_lsp_message(json.stringify(j_response(id, result))),
    .None => ()
  );
});

/// Handle one JSON-RPC message. Returns 0 = keep serving, 10 = exit(0),
/// 11 = exit(1) (`exit` without a preceding `shutdown`).
_handle_message :: (
  fn(
    body : String,
    docs : HashMap(String, DocState),
    std_path : String,
    io : Io
  ) -> i32
)({
  local_exn := Exception(
    throw : (
      err -> {
        eprintln(`yo-lsp: skipping malformed message: ${err.to_string()}`);
        // JSON-RPC 2.0: a body that does not parse is answered with
        // ParseError (-32700) under a null id — the id is unknowable from
        // an unparseable body. Swallowing it silently left a strict client
        // waiting on a reply that never comes.
        write_lsp_message(
          json.stringify(
            j_error_response(JsonValue.Null, i64(0) - i64(32700), `parse error: ${err.to_string()}`)
          )
        );
        unwind(i32(0))
      }
    )
  );
  // D13: json.parse_string's Result form is for callers outside an effect
  // scope; this caller is already inside one, so it takes the _exn wrapper.
  v := json.parse_string_exn(body, local_exn);
  method := _jfield_str(v, "method");
  id_opt := v.get(String.from("id"));
  params_opt := v.get(String.from("params"));
  cond(
    (method == String.from("initialize")) => {
      // One initialize per connection (LSP): a second is InvalidRequest,
      // like any request after shutdown.
      cond(
        (g_server_state == usize(0)) => {
          g_server_state = usize(1);
          params := match(params_opt, .Some(p) => p, .None => JsonValue.Null);
          _respond(id_opt, _initialize_result(params));
        },
        true => {
          match(
            id_opt,
            .Some(id) => write_lsp_message(
              json.stringify(
                j_error_response(id, i64(0) - i64(32600), `initialize may only be sent once`)
              )
            ),
            .None => ()
          );
        }
      );
    },
    (method == String.from("exit")) => {
      return(cond((g_server_state == usize(2)) => i32(10), true => i32(11)));
    },
    (method == String.from("")) => {
      // A message with an id but NO method is a RESPONSE to a server-side
      // request (there are none today, but nothing here may answer one),
      // and no-method-no-id is malformed — both are ignored, in any
      // lifecycle state, rather than falling into the unknown-method arm
      // and being answered with -32601 under the client's own id.
      ();
    },
    (g_server_state == usize(0)) => {
      // Requests before initialize are ServerNotInitialized; notifications
      // (e.g. an early `initialized`) are ignored.
      match(
        id_opt,
        .Some(id) => write_lsp_message(
          json.stringify(
            j_error_response(id, i64(0) - i64(32002), `server not initialized: ${method} arrived before initialize`)
          )
        ),
        .None => ()
      );
    },
    (g_server_state == usize(2)) => {
      // After `shutdown` only `exit` is served; requests are InvalidRequest.
      match(
        id_opt,
        .Some(id) => write_lsp_message(
          json.stringify(
            j_error_response(id, i64(0) - i64(32600), `server is shut down: ${method} arrived after shutdown`)
          )
        ),
        .None => ()
      );
    },
    method.starts_with(String.from("$/")) => {
      // "$/ requests must be answered with MethodNotFound so clients can
      // feature-probe; $/ NOTIFICATIONS are ignored" (LSP 3.17, "$ /
      // Requests") — a request dropped here would leave the client waiting
      // forever (issues/fixed/lsp-jsonrpc-lifecycle-and-dollar-requests.md).
      // This arm sits BEHIND the lifecycle states: a request that arrives
      // before initialize or after shutdown is a lifecycle violation
      // whatever its method name, so those answers win.
      match(
        id_opt,
        .Some(id) => write_lsp_message(
          json.stringify(
            j_error_response(id, i64(0) - i64(32601), `method not found: ${method}`)
          )
        ),
        .None => ()
      );
    },
    (method == String.from("initialized")) => (),
    (method == String.from("shutdown")) => {
      g_server_state = usize(2);
      _respond(id_opt, JsonValue.Null);
    },
    (method == String.from("textDocument/hover")) => {
      (hover_result : JsonValue) = JsonValue.Null;
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            pos := _rune_position(params, st.lines);
            match(
              handle_hover(st.text, st.entry_abs, st.lines, st.outcome.exprs, st.outcome.info_table, pos.line, pos.character),
              .Some(h) => {
                hover_result = h;
              },
              .None => ()
            );
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, hover_result);
    },
    (method == String.from("textDocument/definition")) => {
      (def_result : JsonValue) = JsonValue.Null;
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            pos := _rune_position(params, st.lines);
            match(
              handle_definition(st.text, st.entry_abs, st.lines, std_path.clone(), st.outcome.exprs, st.outcome.info_table, pos.line, pos.character),
              .Some(loc) => {
                def_result = loc;
              },
              .None => ()
            );
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, def_result);
    },
    (method == String.from("textDocument/declaration")) => {
      // A binding's declaration IS its definition in yo (no separate .h
      // shape), so this answers exactly what `textDocument/definition`
      // does — clients that bind "go to declaration" separately keep
      // working.
      (decl_result : JsonValue) = JsonValue.Null;
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            pos := _rune_position(params, st.lines);
            match(
              handle_definition(st.text, st.entry_abs, st.lines, std_path.clone(), st.outcome.exprs, st.outcome.info_table, pos.line, pos.character),
              .Some(loc) => {
                decl_result = loc;
              },
              .None => ()
            );
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, decl_result);
    },
    (method == String.from("textDocument/typeDefinition")) => {
      (td_result : JsonValue) = JsonValue.Null;
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            pos := _rune_position(params, st.lines);
            match(
              handle_type_definition(st.text, st.entry_abs, st.lines, st.outcome.exprs, st.outcome.info_table, pos.line, pos.character),
              .Some(loc) => {
                td_result = loc;
              },
              .None => ()
            );
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, td_result);
    },
    (method == String.from("textDocument/implementation")) => {
      (impl_result : JsonValue) = JsonValue.Array(items : ArrayList(JsonValue).new());
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            pos := _rune_position(params, st.lines);
            impl_result = handle_implementations(
              st.text,
              st.entry_abs,
              _params_uri(params),
              st.lines,
              st.outcome.exprs,
              pos.line,
              pos.character
            );
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, impl_result);
    },
    (method == String.from("textDocument/documentHighlight")) => {
      (dh_result : JsonValue) = JsonValue.Array(items : ArrayList(JsonValue).new());
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            pos := _rune_position(params, st.lines);
            dh_result = handle_document_highlight(st.text, st.entry_abs, st.lines, st.outcome.exprs, st.outcome.info_table, pos.line, pos.character);
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, dh_result);
    },
    (method == String.from("textDocument/documentSymbol")) => {
      (sym_result : JsonValue) = JsonValue.Array(items : ArrayList(JsonValue).new());
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            // Hierarchical DocumentSymbol[] only for clients that declared
            // the capability; flat SymbolInformation[] otherwise.
            sym_result = cond(
              g_hierarchical_symbols => handle_document_symbols(st.outcome.exprs, st.lines),
              true => handle_document_symbols_flat(st.outcome.exprs, st.lines, _params_uri(params))
            );
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, sym_result);
    },
    (method == String.from("workspace/symbol")) => {
      // The top-level symbols of every OPEN document whose name matches the
      // query (plans/archive/LSP_AUDIT_2026-09-29.md §3) — open-docs-only by design;
      // cross-module symbol search wants an index shape decision first.
      (ws_result : JsonValue) = JsonValue.Array(items : ArrayList(JsonValue).new());
      match(
        params_opt,
        .Some(params) => {
          query := _jfield_str(params, "query");
          ws_docs := ArrayList(WorkspaceDoc).new();
          // `for(map, ...)` hands out owned entries (into_iter); `iter()`
          // would need raw pointers.
          for(docs, entry => {
            ws_docs.push(
              WorkspaceDoc(
                uri : entry.key.clone(),
                exprs : entry.value.outcome.exprs,
                lines : entry.value.lines
              )
            );
          });
          ws_result = handle_workspace_symbols(query, ws_docs);
        },
        .None => ()
      );
      _respond(id_opt, ws_result);
    },
    (method == String.from("textDocument/references")) => {
      (refs_result : JsonValue) = JsonValue.Array(items : ArrayList(JsonValue).new());
      match(
        params_opt,
        .Some(params) => {
          uri := _params_uri(params);
          // `context.includeDeclaration` (LSP) — absent context keeps the
          // declaration, the pre-audit behavior
          // (issues/fixed/lsp-references-ignore-include-declaration.md).
          include_decl := match(
            params.get(String.from("context")),
            .Some(ctx) => _jfield_bool(ctx, "includeDeclaration", true),
            .None => true
          );
          match(
            docs.get(uri.clone()),
            .Some(st) => {
              pos := _rune_position(params, st.lines);
              refs_result = handle_references(st.text, st.entry_abs, st.lines, uri.clone(), st.outcome.exprs, st.outcome.info_table, pos.line, pos.character, include_decl);
            },
            .None => ()
          );
        },
        .None => ()
      );
      _respond(id_opt, refs_result);
    },
    (method == String.from("textDocument/foldingRange")) => {
      (fold_result : JsonValue) = JsonValue.Array(items : ArrayList(JsonValue).new());
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            fold_result = handle_folding_ranges(st.text, st.entry_abs);
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, fold_result);
    },
    (method == String.from("textDocument/semanticTokens/full")) => {
      (st_result : JsonValue) = jb().put("data", JsonValue.Array(items : ArrayList(JsonValue).new())).obj();
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            st_result = handle_semantic_tokens(st.text, st.entry_abs, st.outcome.exprs, st.outcome.info_table);
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, st_result);
    },
    (method == String.from("textDocument/prepareRename")) => {
      (pr_result : JsonValue) = JsonValue.Null;
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            pos := _rune_position(params, st.lines);
            match(
              handle_prepare_rename(st.text, st.entry_abs, st.lines, st.outcome.exprs, st.outcome.info_table, pos.line, pos.character),
              .Some(pr) => {
                pr_result = pr;
              },
              .None => ()
            );
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, pr_result);
    },
    (method == String.from("textDocument/rename")) => {
      // newName is validated BEFORE any edit is built: an illegal identifier
      // gets a RequestFailed error (the client shows the reason in the
      // rename box) instead of a WorkspaceEdit that corrupts the buffer
      // (issues/fixed/lsp-rename-accepts-any-new-name.md).
      (rn_result : JsonValue) = JsonValue.Null;
      (rn_rejected : bool) = false;
      match(
        params_opt,
        .Some(params) => {
          uri := _params_uri(params);
          new_name := _jfield_str(params, "newName");
          match(
            rename_rejection(new_name.clone()),
            .Some(reason) => {
              rn_rejected = true;
              match(
                id_opt,
                .Some(id) => write_lsp_message(
                  json.stringify(
                    j_error_response(id, i64(0) - i64(32803), `rename rejected: ${reason}`)
                  )
                ),
                .None => ()
              );
            },
            .None => {
              match(
                docs.get(uri.clone()),
                .Some(st) => {
                  pos := _rune_position(params, st.lines);
                  match(
                    handle_rename(st.text, st.entry_abs, st.lines, uri.clone(), st.outcome.exprs, st.outcome.info_table, pos.line, pos.character, new_name),
                    .Some(we) => {
                      rn_result = we;
                    },
                    .None => ()
                  );
                },
                .None => ()
              );
            }
          );
        },
        .None => ()
      );
      if(!rn_rejected, {
        _respond(id_opt, rn_result);
      });
    },
    (method == String.from("textDocument/codeAction")) => {
      // Quickfixes = the compiler's own `Repair`s (plans/backlog/
      // LLM_AUTHORING_AUDIT_2026-09-19.md §3.2): one action per stored
      // diagnostic that carries a repair and touches the requested range's
      // lines. The edit is the same `yo fix` applies, so an editor and the
      // CLI never disagree about the fix.
      actions := ArrayList(JsonValue).new();
      match(
        params_opt,
        .Some(params) => {
          uri := _params_uri(params);
          match(
            docs.get(uri.clone()),
            .Some(st) => {
              (from_line : usize) = usize(0);
              (to_line : usize) = usize(0);
              match(
                params.get(String.from("range")),
                .Some(rg) => {
                  from_line = match(rg.get(String.from("start")), .Some(sp) => _jfield_usize(sp, "line"), .None => usize(0));
                  to_line = match(rg.get(String.from("end")), .Some(ep) => _jfield_usize(ep, "line"), .None => from_line);
                },
                .None => ()
              );
              (di : usize) = usize(0);
              while(di < st.diags.len(), {
                match(
                  st.diags.get(di),
                  .Some(d) => match(
                    d.repair,
                    .Some(r) => if((d.row >= from_line) && (d.row <= to_line), {
                      edits := ArrayList(JsonValue).new();
                      edits.push(
                        jb().put("range", j_range_in(st.lines, r.span.row, r.span.col, r.span.row, r.span.col + r.span.len)).put("newText", jstr(r.replacement.clone())).obj()
                      );
                      ck := ArrayList(String).new();
                      cv := ArrayList(JsonValue).new();
                      ck.push(uri.clone());
                      cv.push(JsonValue.Array(items : edits));
                      diag_items := ArrayList(JsonValue).new();
                      diag_items.push(j_diagnostic(j_range_in(st.lines, d.row, d.col, d.row, d.end_col), d.severity, d.code, d.message.clone()));
                      actions.push(
                        jb().put("title", jstr(r.description.clone())).put("kind", jstr(String.from("quickfix"))).put("isPreferred", JsonValue.Bool(value : true)).put("diagnostics", JsonValue.Array(items : diag_items)).put("edit", jb().put("changes", JsonValue.Object(keys : ck, values : cv)).obj()).obj()
                      );
                    }),
                    .None => ()
                  ),
                  .None => ()
                );
                di = (di + usize(1));
              });
            },
            .None => ()
          );
        },
        .None => ()
      );
      _respond(id_opt, JsonValue.Array(items : actions));
    },
    (method == String.from("textDocument/formatting")) => {
      (fmt_result : JsonValue) = JsonValue.Null;
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            fmt_result = _format_document(st.text, st.entry_abs);
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, fmt_result);
    },
    (method == String.from("textDocument/signatureHelp")) => {
      (sh_result : JsonValue) = JsonValue.Null;
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            pos := _rune_position(params, st.lines);
            match(
              handle_signature_help(st.outcome.exprs, st.outcome.info_table, pos.line, pos.character),
              .Some(sh) => {
                sh_result = sh;
              },
              .None => ()
            );
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, sh_result);
    },
    (method == String.from("textDocument/completion")) => {
      (comp_result : JsonValue) = JsonValue.Null;
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            pos := _rune_position(params, st.lines);
            comp_result = handle_completion(st.text, st.entry_abs, std_path.clone(), st.outcome.exprs, st.outcome.info_table, pos.line, pos.character, io);
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, comp_result);
    },
    (method == String.from("textDocument/documentLink")) => {
      (links_result : JsonValue) = JsonValue.Array(items : ArrayList(JsonValue).new());
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            links_result = handle_document_links(st.text, st.entry_abs, st.lines, std_path.clone());
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, links_result);
    },
    (method == String.from("textDocument/didOpen")) => {
      match(
        params_opt,
        .Some(params) => match(
          params.get(String.from("textDocument")),
          .Some(td) => {
            uri := _jfield_str(td, "uri");
            text := _jfield_str(td, "text");
            if(uri.len() > usize(0), {
              _analyze_and_publish(uri, text, std_path.clone(), docs, io);
            });
          },
          .None => ()
        ),
        .None => ()
      );
    },
    (method == String.from("textDocument/didChange")) => {
      match(
        params_opt,
        .Some(params) => {
          uri := _params_uri(params);
          // Full sync: the last contentChanges entry's `text` is the whole
          // document (we advertise TextDocumentSyncKind.Full).
          text_opt := match(
            params.get(String.from("contentChanges")),
            .Some(changes) => match(
              changes,
              .Array(items) => cond(
                (items.len() > usize(0)) => match(
                  items.last(),
                  .Some(last) => Option(String).Some(_jfield_str(last, "text")),
                  .None => Option(String).None
                ),
                true => Option(String).None
              ),
              _ => Option(String).None
            ),
            .None => Option(String).None
          );
          match(
            text_opt,
            .Some(text) => if(uri.len() > usize(0), {
              _analyze_and_publish(uri, text, std_path.clone(), docs, io);
            }),
            .None => ()
          );
        },
        .None => ()
      );
    },
    (method == String.from("textDocument/didClose")) => {
      match(
        params_opt,
        .Some(params) => match(
          params.get(String.from("textDocument")),
          .Some(td) => {
            uri := _jfield_str(td, "uri");
            if(uri.len() > usize(0), {
              _r := docs.remove(uri.clone());
              // Phase B1: the disk becomes this file's truth again — drop
              // the open-buffer overlay and anything cached from it.
              closed_fs := uri_to_fs_path(uri.clone());
              mm_forget_open_document(closed_fs.clone());
              _inv2 := mm_invalidate_document(closed_fs);
              _publish_empty(uri);
            });
          },
          .None => ()
        ),
        .None => ()
      );
    },
    (method == String.from("workspace/didChangeWatchedFiles")) => {
      // A file changed OUTSIDE the editor: purge it (and every dependent)
      // from the loader cache, then re-analyze each OPEN document so its
      // diagnostics and analyses see the new on-disk imports — this used
      // to need a server restart. Open documents manage their own state
      // (their buffer is the truth), so their own paths are not purged.
      match(
        params_opt,
        .Some(params) => match(
          params.get(String.from("changes")),
          .Some(.Array(changes)) => {
            (ci : usize) = usize(0);
            while(ci < changes.len(), {
              match(
                changes.get(ci),
                .Some(ch) => {
                  changed_fs := uri_to_fs_path(_jfield_str(ch, "uri"));
                  if(changed_fs.len() > usize(0), {
                    is_open := false;
                    for(docs, entry => {
                      if(entry.value.entry_abs == changed_fs, {
                        is_open = true;
                      });
                    });
                    if(!is_open, {
                      _inv3 := mm_invalidate_document(changed_fs);
                    });
                  });
                },
                .None => ()
              );
              ci = (ci + usize(1));
            });
            // Re-analyze every open document against the purged cache;
            // the open buffer's own text stays authoritative for its file.
            open_uris := ArrayList(String).new();
            open_texts := ArrayList(String).new();
            for(docs, entry => {
              open_uris.push(entry.key.clone());
            });
            (oi : usize) = usize(0);
            while(oi < open_uris.len(), {
              match(
                open_uris.get(oi),
                .Some(u) => match(
                  docs.get(u.clone()),
                  .Some(st) => {
                    open_texts.push(st.text.clone());
                  },
                  .None => ()
                ),
                .None => ()
              );
              oi = (oi + usize(1));
            });
            (ai : usize) = usize(0);
            while(ai < open_uris.len(), {
              match(
                open_uris.get(ai),
                .Some(u) => match(
                  open_texts.get(ai),
                  .Some(txt) => {
                    _analyze_and_publish(u.clone(), txt.clone(), std_path.clone(), docs, io);
                  },
                  .None => ()
                ),
                .None => ()
              );
              ai = (ai + usize(1));
            });
          },
          _ => ()
        ),
        .None => ()
      );
    },
    true => {
      // Unknown REQUESTS get MethodNotFound; unknown notifications are
      // ignored per the JSON-RPC spec.
      match(
        id_opt,
        .Some(id) => write_lsp_message(
          json.stringify(
            j_error_response(id, i64(0) - i64(32601), `method not found: ${method}`)
          )
        ),
        .None => ()
      );
    }
  );
  i32(0)
});

/// `yo lsp` entry: serve LSP over stdio until `exit` or EOF.
run_lsp_server :: (fn(io : Io, exn : Exception) -> unit)({
  // Windows text-mode stdout would corrupt every frame header
  // (issues/fixed/lsp-windows-text-mode-framing-breaks-every-client.md) — flip it
  // to binary before anything can be written.
  prepare_wire();
  // The server re-forces definitions of finished walks on every edit
  // (`mm_revalidate_apply`), but only OPEN documents' walks keep their
  // evaluation context (`mm_set_open_document`); a revalidation that reaches
  // another module takes the file-level fallback for it.
  reader := BufReader(Stdin).new(stdin());
  docs := HashMap(String, DocState).new();
  std_path := resolve_std_path();
  // No startup banner: the cli-case harness merges stderr into stdout, and
  // stderr/stdout interleaving is not deterministic. Real editors surface
  // server liveness through the initialize handshake.
  (running : bool) = true;
  (exit_code : i32) = i32(0);
  while(running, {
    msg_opt := read_lsp_message(reader, io, exn);
    match(
      msg_opt,
      .None => {
        // Clean EOF: client is gone.
        running = false;
      },
      .Some(body) => {
        action := _handle_message(body, docs, std_path.clone(), io);
        if(action == i32(10), {
          running = false;
        });
        if(action == i32(11), {
          running = false;
          exit_code = i32(1);
        });
      }
    );
  });
  if(exit_code != i32(0), {
    exn.throw(dyn(`lsp: exit notification received without a shutdown request`));
  });
});
export(run_lsp_server);
