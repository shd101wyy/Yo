//! lsp/server — the `yo lsp` language server (plans/archive/P4_LSP.md slice 1 + 2).
//!
//! Speaks LSP over stdio: base-protocol framing (transport.yo), JSON-RPC
//! dispatch, the initialize handshake, FULL text-document sync, and push
//! diagnostics on open/change (diagnostics.yo). One message is handled at a
//! time — the protocol methods served so far are all sequential-safe.
//!
//! Every message is handled inside `_handle_message`, whose LOCAL exception
//! handler turns a malformed frame or JSON body into a skipped message
//! instead of a dead server (`unwind` exits the INSTALLING function, so the
//! handler must live in the per-message helper, not the loop).
//!
//! Positions cross this file in the CLIENT's encoding and leave it as RUNE
//! columns (`_rune_position`); handlers emit ranges through `j_range_in`,
//! which converts back. The encoding itself is negotiated in `initialize`
//! (protocol.yo, "Column bases").
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ Exception } :: import("std/error");
{ eprintln } :: import("std/fmt");
{ JsonValue, json_parse_string_exn, json_stringify } :: import("std/encoding/json");
{ read_lsp_message, write_lsp_message } :: import("./transport.yo");
{
  jb,
  jstr,
  jnum,
  j_diagnostic,
  j_range,
  j_range_in,
  j_response,
  j_error_response,
  j_notification,
  uri_to_fs_path,
  set_utf16_positions,
  client_col_to_rune,
  line_at
} :: import("./protocol.yo");
{ analyze_document, LspDiag, AnalyzeOutcome } :: import("./diagnostics.yo");
{ handle_hover } :: import("./hover.yo");
{ handle_definition } :: import("./definition.yo");
{ handle_document_symbols } :: import("./symbols.yo");
{ handle_references } :: import("./references.yo");
{ handle_folding_ranges } :: import("./folding.yo");
{ handle_rename } :: import("./rename.yo");
{ handle_signature_help } :: import("./signature_help.yo");
{ handle_completion } :: import("./completion.yo");
{ format_yo_source } :: import("../formatter.yo");
{ resolve_std_path, mm_invalidate_document, mm_set_open_document, mm_forget_open_document } :: import("../module_manager.yo");
{ BufReader } :: import("std/io/bufio");
{ Stdin, stdin } :: import("std/io/stdio");

/// Per-document retained state: the editor's newest text (and its lines,
/// split once for column conversion), the resolved module path, and the
/// analysis outcome feature requests read. `outcome` is the LAST PARSED
/// outcome — a text that fails to parse (most keystrokes mid-expression)
/// keeps the previous program and ExprInfo in place, so hover, symbols and
/// completion keep answering from the last shape the parser accepted
/// (issues/fixed/lsp-analysis-state-lost-on-parse-and-eval-errors.md).
/// Positions are matched against `text` by token (value, row, column), so a
/// stale outcome answers only where the two still agree, never wrongly.
DocState :: ref(
  struct(
    text : String,
    lines : ArrayList(String),
    entry_abs : String,
    outcome : AnalyzeOutcome
  )
);

/// `shutdown` latch: the LSP spec's `exit` notification exits 0 only when a
/// `shutdown` request preceded it. Module-level because it must survive
/// across `_handle_message` calls.
(g_shutdown_requested : bool) = false;

/// Read a string field out of a JSON object; empty string when absent.
_jfield_str :: (fn(v : JsonValue, key : str) -> String)(
  match(
    v.get(String.from(key)),
    .Some(f) => match(f, .Str(x) => x, _ => String.new()),
    .None => String.new()
  )
);
/// Read a numeric field as usize; 0 when absent or not a number.
_jfield_usize :: (fn(v : JsonValue, key : str) -> usize)(
  match(
    v.get(String.from(key)),
    .Some(f) => match(f, .Number(n) => usize(n), _ => usize(0)),
    .None => usize(0)
  )
);
/// `params.textDocument.uri`; empty string when absent.
_params_uri :: (fn(params : JsonValue) -> String)(
  match(
    params.get(String.from("textDocument")),
    .Some(td) => _jfield_str(td, "uri"),
    .None => String.new()
  )
);

/// A document position in RUNE columns.
LspPos :: struct(
  line : usize,
  character : usize
);
/// `params.position`, with `character` converted from the client's encoding
/// to a RUNE column against the document's line.
_rune_position :: (fn(params : JsonValue, lines : ArrayList(String)) -> LspPos)(
  match(
    params.get(String.from("position")),
    .Some(pos) => {
      line := _jfield_usize(pos, "line");
      character := _jfield_usize(pos, "character");
      LspPos(line : line, character : client_col_to_rune(line_at(lines, line), character))
    },
    .None => LspPos(line : usize(0), character : usize(0))
  )
);

/// Analyze `text` as the document at `uri`, retain the analysis state for
/// feature requests, and push publishDiagnostics.
_analyze_and_publish :: (
  fn(uri : String, text : String, std_path : String, docs : HashMap(String, DocState), io : Io) -> unit
)({
  fs_path := uri_to_fs_path(uri.clone());
  // Phase B1 (plans/reference/INCREMENTAL_COMPILATION.md): the editor holds this
  // file's newest text — record it as the loader's open-buffer overlay,
  // then drop any cached module built from an older version PLUS every
  // transitive dependent. Together these make an edit to an IMPORTED file
  // visible to the next analysis of any importing document (previously:
  // invisible until the server restarted).
  mm_set_open_document(fs_path.clone(), text.clone());
  _inv := mm_invalidate_document(fs_path.clone());
  out_state := ArrayList(AnalyzeOutcome).new();
  diags := analyze_document(fs_path.clone(), text.clone(), std_path, io, out_state);
  lines := text.split(String.from("\n"));
  match(
    out_state.get(usize(0)),
    .Some(oc) => {
      // A text that did not parse keeps the last parsed outcome (see
      // DocState); an evaluation error keeps this run's program + partial
      // ExprInfo.
      retained := cond(
        oc.parsed => oc,
        true => match(
          docs.get(uri.clone()),
          .Some(prev) => prev.outcome,
          .None => oc
        )
      );
      docs.insert(
        uri.clone(),
        DocState(text : text.clone(), lines : lines, entry_abs : fs_path.clone(), outcome : retained)
      );
    },
    .None => ()
  );
  items := ArrayList(JsonValue).new();
  (i : usize) = usize(0);
  while(i < diags.len(), {
    match(
      diags.get(i),
      .Some(d) => {
        items.push(
          j_diagnostic(j_range_in(lines, d.row, d.col, d.row, d.end_col), d.severity, d.code, d.message)
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  params := jb().put("uri", jstr(uri)).put("diagnostics", JsonValue.Array(items : items)).obj();
  write_lsp_message(json_stringify(j_notification("textDocument/publishDiagnostics", params)));
});

/// Send an empty diagnostics list for `uri` (clears squiggles on close).
_publish_empty :: (fn(uri : String) -> unit)({
  params := jb().put("uri", jstr(uri)).put("diagnostics", JsonValue.Array(items : ArrayList(JsonValue).new())).obj();
  write_lsp_message(json_stringify(j_notification("textDocument/publishDiagnostics", params)));
});

/// signatureHelp trigger characters: "(" and ",".
_sig_triggers :: (fn() -> ArrayList(JsonValue))({
  ts := ArrayList(JsonValue).new();
  ts.push(jstr(String.from("(")));
  ts.push(jstr(String.from(",")));
  ts
});

/// completion trigger characters: member access and import-path strings.
_completion_triggers :: (fn() -> ArrayList(JsonValue))({
  ts := ArrayList(JsonValue).new();
  ts.push(jstr(String.from(".")));
  ts.push(jstr(String.from("\"")));
  ts.push(jstr(String.from("/")));
  ts
});

/// True iff the client's `capabilities.general.positionEncodings` lists
/// `utf-32` — the server's native column unit.
_client_offers_utf32 :: (fn(params : JsonValue) -> bool)({
  encodings := match(
    params.get(String.from("capabilities")),
    .Some(caps) => match(
      caps.get(String.from("general")),
      .Some(general) => general.get(String.from("positionEncodings")),
      .None => Option(JsonValue).None
    ),
    .None => Option(JsonValue).None
  );
  match(
    encodings,
    .Some(encs) => match(
      encs,
      .Array(items) => {
        (i : usize) = usize(0);
        while(i < items.len(), {
          match(
            items.get(i),
            .Some(item) => match(
              item,
              .Str(s) => if(s == String.from("utf-32"), {
                return(true);
              }),
              _ => ()
            ),
            .None => ()
          );
          i = (i + usize(1));
        });
        false
      },
      _ => false
    ),
    .None => false
  )
});

/// The `initialize` response: full-document sync, every feature provider,
/// and the negotiated `positionEncoding` — `utf-32` when the client offers
/// it (the server's native unit, so nothing is converted), else the
/// protocol default `utf-16`, which every emitted and received column is
/// converted to/from (issues/fixed/lsp-emits-rune-columns-where-the-protocol-says-utf16.md,
/// issues/fixed/lsp-initialize-discards-the-clients-params.md). Push
/// diagnostics carry no capability flag.
_initialize_result :: (fn(params : JsonValue) -> JsonValue)({
  utf32 := _client_offers_utf32(params);
  set_utf16_positions(!utf32);
  encoding := cond(utf32 => String.from("utf-32"), true => String.from("utf-16"));
  jb().put("capabilities", jb().put("positionEncoding", jstr(encoding)).put("textDocumentSync", jnum(usize(1))).put("hoverProvider", JsonValue.Bool(value : true)).put("definitionProvider", JsonValue.Bool(value : true)).put("documentSymbolProvider", JsonValue.Bool(value : true)).put("referencesProvider", JsonValue.Bool(value : true)).put("foldingRangeProvider", JsonValue.Bool(value : true)).put("renameProvider", JsonValue.Bool(value : true)).put("documentFormattingProvider", JsonValue.Bool(value : true)).put("signatureHelpProvider", jb().put("triggerCharacters", JsonValue.Array(items : _sig_triggers())).obj()).put("completionProvider", jb().put("triggerCharacters", JsonValue.Array(items : _completion_triggers())).obj()).obj()).put(
    "serverInfo",
    // No `version` field on purpose: it is optional in the protocol, the
    // client can ask `yo --version`, and a version here would churn the
    // lsp cli-case golden on every release bump.
    jb().put("name", jstr(String.from("yo-lsp"))).obj()
  ).obj()
});

/// Whole-document formatting via `yo fmt`'s format_yo_source. Returns the
/// LSP result: an ARRAY with one whole-document TextEdit, an EMPTY array
/// when already canonical, or Null (own unwind frame) when the source does
/// not parse — the client keeps the buffer untouched.
_format_document :: (fn(text : String, doc_abs : String) -> JsonValue)({
  fmt_exn := Exception(
    throw : (
      _err -> unwind(JsonValue.Null)
    )
  );
  formatted := format_yo_source(text.clone(), doc_abs.clone(), fmt_exn);
  if(formatted == text, {
    return(JsonValue.Array(items : ArrayList(JsonValue).new()));
  });
  line_count := text.split(String.from("\n")).len();
  edits := ArrayList(JsonValue).new();
  edits.push(
    // Column 0 is the same in every encoding, so no conversion here.
    jb().put("range", j_range(usize(0), usize(0), line_count, usize(0))).put("newText", jstr(formatted)).obj()
  );
  JsonValue.Array(items : edits)
});

/// Write the response for `id_opt` (a REQUEST); a notification-shaped
/// message (no id) gets nothing back.
_respond :: (fn(id_opt : Option(JsonValue), result : JsonValue) -> unit)({
  match(
    id_opt,
    .Some(id) => write_lsp_message(json_stringify(j_response(id, result))),
    .None => ()
  );
});

/// Handle one JSON-RPC message. Returns 0 = keep serving, 10 = exit(0),
/// 11 = exit(1) (`exit` without a preceding `shutdown`).
_handle_message :: (
  fn(
    body : String,
    docs : HashMap(String, DocState),
    std_path : String,
    io : Io
  ) -> i32
)({
  local_exn := Exception(
    throw : (
      err -> {
        eprintln(`yo-lsp: skipping malformed message: ${err.to_string()}`);
        unwind(i32(0))
      }
    )
  );
  // D13: json_parse_string's Result form is for callers outside an effect
  // scope; this caller is already inside one, so it takes the _exn wrapper.
  v := json_parse_string_exn(body, local_exn);
  method := _jfield_str(v, "method");
  id_opt := v.get(String.from("id"));
  params_opt := v.get(String.from("params"));
  cond(
    (method == String.from("initialize")) => {
      params := match(params_opt, .Some(p) => p, .None => JsonValue.Null);
      _respond(id_opt, _initialize_result(params));
    },
    (method == String.from("initialized")) => (),
    (method == String.from("shutdown")) => {
      g_shutdown_requested = true;
      _respond(id_opt, JsonValue.Null);
    },
    (method == String.from("exit")) => {
      return(cond(g_shutdown_requested => i32(10), true => i32(11)));
    },
    (method == String.from("textDocument/hover")) => {
      (hover_result : JsonValue) = JsonValue.Null;
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            pos := _rune_position(params, st.lines);
            match(
              handle_hover(st.text, st.entry_abs, st.lines, st.outcome.exprs, st.outcome.info_table, pos.line, pos.character),
              .Some(h) => {
                hover_result = h;
              },
              .None => ()
            );
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, hover_result);
    },
    (method == String.from("textDocument/definition")) => {
      (def_result : JsonValue) = JsonValue.Null;
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            pos := _rune_position(params, st.lines);
            match(
              handle_definition(st.text, st.entry_abs, st.lines, std_path.clone(), st.outcome.exprs, st.outcome.info_table, pos.line, pos.character),
              .Some(loc) => {
                def_result = loc;
              },
              .None => ()
            );
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, def_result);
    },
    (method == String.from("textDocument/documentSymbol")) => {
      (sym_result : JsonValue) = JsonValue.Array(items : ArrayList(JsonValue).new());
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            sym_result = handle_document_symbols(st.outcome.exprs, st.lines);
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, sym_result);
    },
    (method == String.from("textDocument/references")) => {
      (refs_result : JsonValue) = JsonValue.Array(items : ArrayList(JsonValue).new());
      match(
        params_opt,
        .Some(params) => {
          uri := _params_uri(params);
          match(
            docs.get(uri.clone()),
            .Some(st) => {
              pos := _rune_position(params, st.lines);
              refs_result = handle_references(st.text, st.entry_abs, st.lines, uri.clone(), st.outcome.exprs, st.outcome.info_table, pos.line, pos.character);
            },
            .None => ()
          );
        },
        .None => ()
      );
      _respond(id_opt, refs_result);
    },
    (method == String.from("textDocument/foldingRange")) => {
      (fold_result : JsonValue) = JsonValue.Array(items : ArrayList(JsonValue).new());
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            fold_result = handle_folding_ranges(st.text, st.entry_abs);
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, fold_result);
    },
    (method == String.from("textDocument/rename")) => {
      (rn_result : JsonValue) = JsonValue.Null;
      match(
        params_opt,
        .Some(params) => {
          uri := _params_uri(params);
          new_name := _jfield_str(params, "newName");
          match(
            docs.get(uri.clone()),
            .Some(st) => {
              pos := _rune_position(params, st.lines);
              match(
                handle_rename(st.text, st.entry_abs, st.lines, uri.clone(), st.outcome.exprs, st.outcome.info_table, pos.line, pos.character, new_name),
                .Some(we) => {
                  rn_result = we;
                },
                .None => ()
              );
            },
            .None => ()
          );
        },
        .None => ()
      );
      _respond(id_opt, rn_result);
    },
    (method == String.from("textDocument/formatting")) => {
      (fmt_result : JsonValue) = JsonValue.Null;
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            fmt_result = _format_document(st.text, st.entry_abs);
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, fmt_result);
    },
    (method == String.from("textDocument/signatureHelp")) => {
      (sh_result : JsonValue) = JsonValue.Null;
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            pos := _rune_position(params, st.lines);
            match(
              handle_signature_help(st.outcome.exprs, st.outcome.info_table, pos.line, pos.character),
              .Some(sh) => {
                sh_result = sh;
              },
              .None => ()
            );
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, sh_result);
    },
    (method == String.from("textDocument/completion")) => {
      (comp_result : JsonValue) = JsonValue.Null;
      match(
        params_opt,
        .Some(params) => match(
          docs.get(_params_uri(params)),
          .Some(st) => {
            pos := _rune_position(params, st.lines);
            comp_result = handle_completion(st.text, st.entry_abs, std_path.clone(), st.outcome.exprs, st.outcome.info_table, pos.line, pos.character, io);
          },
          .None => ()
        ),
        .None => ()
      );
      _respond(id_opt, comp_result);
    },
    (method == String.from("textDocument/didOpen")) => {
      match(
        params_opt,
        .Some(params) => match(
          params.get(String.from("textDocument")),
          .Some(td) => {
            uri := _jfield_str(td, "uri");
            text := _jfield_str(td, "text");
            if(uri.len() > usize(0), {
              _analyze_and_publish(uri, text, std_path.clone(), docs, io);
            });
          },
          .None => ()
        ),
        .None => ()
      );
    },
    (method == String.from("textDocument/didChange")) => {
      match(
        params_opt,
        .Some(params) => {
          uri := _params_uri(params);
          // Full sync: the last contentChanges entry's `text` is the whole
          // document (we advertise TextDocumentSyncKind.Full).
          text_opt := match(
            params.get(String.from("contentChanges")),
            .Some(changes) => match(
              changes,
              .Array(items) => cond(
                (items.len() > usize(0)) => match(
                  items.get(items.len() - usize(1)),
                  .Some(last) => Option(String).Some(_jfield_str(last, "text")),
                  .None => Option(String).None
                ),
                true => Option(String).None
              ),
              _ => Option(String).None
            ),
            .None => Option(String).None
          );
          match(
            text_opt,
            .Some(text) => if(uri.len() > usize(0), {
              _analyze_and_publish(uri, text, std_path.clone(), docs, io);
            }),
            .None => ()
          );
        },
        .None => ()
      );
    },
    (method == String.from("textDocument/didClose")) => {
      match(
        params_opt,
        .Some(params) => match(
          params.get(String.from("textDocument")),
          .Some(td) => {
            uri := _jfield_str(td, "uri");
            if(uri.len() > usize(0), {
              _r := docs.remove(uri.clone());
              // Phase B1: the disk becomes this file's truth again — drop
              // the open-buffer overlay and anything cached from it.
              closed_fs := uri_to_fs_path(uri.clone());
              mm_forget_open_document(closed_fs.clone());
              _inv2 := mm_invalidate_document(closed_fs);
              _publish_empty(uri);
            });
          },
          .None => ()
        ),
        .None => ()
      );
    },
    method.starts_with(String.from("$/")) => (),
    true => {
      // Unknown REQUESTS get MethodNotFound; unknown notifications are
      // ignored per the JSON-RPC spec.
      match(
        id_opt,
        .Some(id) => write_lsp_message(
          json_stringify(
            j_error_response(id, i64(0) - i64(32601), `method not found: ${method}`)
          )
        ),
        .None => ()
      );
    }
  );
  i32(0)
});

/// `yo lsp` entry: serve LSP over stdio until `exit` or EOF.
run_lsp_server :: (fn(io : Io, exn : Exception) -> unit)({
  reader := BufReader(Stdin).new(stdin());
  docs := HashMap(String, DocState).new();
  std_path := resolve_std_path();
  // No startup banner: the cli-case harness merges stderr into stdout, and
  // stderr/stdout interleaving is not deterministic. Real editors surface
  // server liveness through the initialize handshake.
  (running : bool) = true;
  (exit_code : i32) = i32(0);
  while(running, {
    msg_opt := read_lsp_message(reader, io, exn);
    match(
      msg_opt,
      .None => {
        // Clean EOF: client is gone.
        running = false;
      },
      .Some(body) => {
        action := _handle_message(body, docs, std_path.clone(), io);
        if(action == i32(10), {
          running = false;
        });
        if(action == i32(11), {
          running = false;
          exit_code = i32(1);
        });
      }
    );
  });
  if(exit_code != i32(0), {
    exn.throw(dyn(`lsp: exit notification received without a shutdown request`));
  });
});
export(run_lsp_server);
