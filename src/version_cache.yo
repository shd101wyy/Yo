//! Version cache management for Yo.
//!
//! Downloads and caches specific versions of Yo as NATIVE RELEASE BUNDLES
//! from GitHub Releases (npm publishing stopped at v0.2.0 — the npm channel
//! is dead for every later version; see plans/P3_DISTRIBUTION.md item 2).
//! Cached versions are stored in `~/.cache/yo/versions/<version>/` as a plain
//! bundle extraction: `bin/yo` (+`.exe` on Windows), `std/`, `vendor/`,
//! LICENSE — exactly the layout `scripts/install.sh` installs, so the two
//! mechanisms share one shape and the bundle self-locates its std.
//!
//! Download flow:
//!   1. Resolve the host platform's bundle name (yo-v<v>-<os>-<arch>,
//!      with a `-musl` suffix on Linux — musl-only since 2026-08-20).
//!   2. Download `https://github.com/<repo>/releases/download/v<v>/<bundle>.tar.gz`.
//!   3. Extract; the tarball root is a `<bundle>/` directory — move it to the
//!      version cache directory.
//!
//! This mirrors `src/version-cache.ts`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
{ Command } :: import("std/process/command");
{ AnyError, Exception, IoExn } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ Path } :: import("std/path");
{ exists, write_string } :: import("std/fs/file");
{ FetchOptions, fetch_with } :: import("std/http/client");
{ tls_available } :: import("std/crypto/tls");
{
  FileType,
  create_dir_all,
  read_dir,
  remove_dir,
  remove_file,
  rename
} :: import("std/fs/dir");
{ remove_dir_all } :: import("std/fs/walker");
{ TempDir } :: import("std/fs/temp");
{ env } :: import("std/env");
{
  host_target,
  is_target_windows,
  is_target_macos,
  is_target_linux,
  os_to_str,
  arch_to_str
} :: import("./target.yo");
{
  get_global_versions_cache_dir,
  get_version_cache_dir,
  get_install_versions_dir,
  get_install_version_dir
} :: import("./cache.yo");
// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------
/// The first release that ships native bundles for all platforms.
MIN_BUNDLE_VERSION :: "0.2.1";
/// Overridable for forks/tests — matches scripts/install.sh's YO_REPO.
/// Computed lazily (env reads are runtime, not comptime).
_github_repo :: (fn() -> String)(
  match(
    env.get(`YO_REPO`),
    .Some(r) => r,
    .None => `shd101wyy/Yo`
  )
);
_releases_api_url :: (fn() -> String)(`https://api.github.com/repos/${_github_repo()}/releases`);
_releases_download_url :: (fn() -> String)(`https://github.com/${_github_repo()}/releases/download`);
// ---------------------------------------------------------------------------
// Local helpers
// ---------------------------------------------------------------------------
/// Extract the string value of a JSON field named `key`.
/// Handles both `"key":"value"` and `"key": "value"` forms.
/// Returns `.None` if the field is not found.
_json_string_for_key :: (fn(json : String, key : String) -> Option(String))({
  pat1 := `"${key}":"`;
  pat2 := `"${key}": "`;
  start_opt := match(
    json.index_of(pat1),
    .Some(i) => Option(usize).Some(i + pat1.len()),
    .None => match(
      json.index_of(pat2),
      .Some(i) => Option(usize).Some(i + pat2.len()),
      .None => Option(usize).None
    )
  );
  match(
    start_opt,
    .None => Option(String).None,
    .Some(start) => {
      rest := json.substring(start, json.len());
      match(
        rest.index_of(String.from("\"")),
        .None => Option(String).None,
        .Some(end) => .Some(rest.substring(usize(0), end))
      )
    }
  )
});
/// Compare two semver strings. Returns negative if a < b, 0 if equal, positive if a > b.
compare_semver :: (fn(a : String, b : String) -> i64)({
  pa := a.split(String.from("."));
  pb := b.split(String.from("."));
  na0 := match(pa.get(usize(0)), .None => i64(0), .Some(s) => match(s.parse_i64(), .None => i64(0), .Some(n) => n));
  nb0 := match(pb.get(usize(0)), .None => i64(0), .Some(s) => match(s.parse_i64(), .None => i64(0), .Some(n) => n));
  na1 := match(pa.get(usize(1)), .None => i64(0), .Some(s) => match(s.parse_i64(), .None => i64(0), .Some(n) => n));
  nb1 := match(pb.get(usize(1)), .None => i64(0), .Some(s) => match(s.parse_i64(), .None => i64(0), .Some(n) => n));
  na2 := match(pa.get(usize(2)), .None => i64(0), .Some(s) => match(s.parse_i64(), .None => i64(0), .Some(n) => n));
  nb2 := match(pb.get(usize(2)), .None => i64(0), .Some(s) => match(s.parse_i64(), .None => i64(0), .Some(n) => n));
  diff0 := (na0 - nb0);
  diff1 := (na1 - nb1);
  diff2 := (na2 - nb2);
  cond(
    (diff0 != i64(0)) => diff0,
    (diff1 != i64(0)) => diff1,
    true => diff2
  )
});
/// Sort an ArrayList(String) by semver order (ascending) using selection sort.
/// Returns a new sorted list.
_sort_by_semver :: (fn(versions : ArrayList(String)) -> ArrayList(String))({
  n := versions.len();
  result := ArrayList(String).with_capacity(n);
  added := ArrayList(bool).with_capacity(n);
  i := usize(0);
  while(i < n, {
    added.push(false);
    i = (i + usize(1));
  });
  selected := usize(0);
  while(selected < n, {
    min_idx := usize(0);
    found := false;
    j := usize(0);
    while(j < n, {
      flag := match(added.get(j), .None => true, .Some(f) => f);
      if(!(flag), {
        if(!(found), {
          min_idx = j;
          found = true;
        }, {
          j_ver := match(versions.get(j), .None => String.new(), .Some(v) => v);
          min_ver := match(versions.get(min_idx), .None => String.new(), .Some(v) => v);
          if(compare_semver(j_ver, min_ver) < i64(0), {
            min_idx = j;
          });
        });
      });
      j = (j + usize(1));
    });
    match(
      versions.get(min_idx),
      .None => (),
      .Some(v) => {
        result.push(v);
      }
    );
    match(
      added.ptr(),
      .None => (),
      .Some(p) => {
        (p.add(min_idx)).* = true;
      }
    );
    selected = (selected + usize(1));
  });
  result
});
// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------
/// The cached compiler binary inside a version directory.
cached_binary_path :: (fn(version_dir : String) -> String)({
  bin_name := cond(
    is_target_windows(host_target()) => `yo.exe`,
    true => `yo`
  );
  `${version_dir}/bin/${bin_name}`
});
/// The PRE-MUSL release-bundle basename (`yo-v<v>-<os>-<arch>`, no suffix).
/// Only the Linux glibc-era fallback in `download_version` should use this
/// directly — everything else goes through `host_bundle_name`.
_host_bundle_name_base :: (fn(version : String, exn : Exception) -> String)({
  target := host_target();
  os_name := cond(
    is_target_macos(target) => `macos`,
    is_target_linux(target) => `linux`,
    is_target_windows(target) => `windows`,
    true => {
      platform_str := String.from(os_to_str(target.os));
      exn.throw(
        dyn(
          `Unsupported platform for Yo release bundles: ${platform_str}. Available targets: linux-x64-musl, linux-arm64-musl, macos-arm64, macos-x64, windows-x64.`
        )
      );
      String.new()
    }
  );
  arch_name := match(
    target.arch,
    .X86_64 => `x64`,
    .Aarch64 => `arm64`,
    _ => {
      arch_str := String.from(arch_to_str(target.arch));
      exn.throw(
        dyn(`Unsupported CPU architecture for Yo release bundles: ${arch_str}. Available: x64, arm64.`)
      );
      String.new()
    }
  );
  `yo-v${version}-${os_name}-${arch_name}`
});
/// The release-bundle basename in canonical target-triple form,
/// e.g. `yo-v0.2.19-aarch64-apple-darwin` / `yo-v0.2.19-x86_64-unknown-linux-musl`.
///
/// This is the name releases carry from the one after v0.2.18
/// (plans/RELEASE_ASSET_TRIPLES.md); `download_version` bridges the changeover
/// by falling back to the short `host_bundle_name` form. The triple is the
/// PUBLISHED asset name only — the compiler's own `--target` vocabulary stays
/// vendor-less (`aarch64-macos`), see that plan's "what does NOT change".
host_bundle_triple_name :: (fn(version : String, exn : Exception) -> String)({
  target := host_target();
  triple := cond(
    is_target_macos(target) =>
      match(
        target.arch,
        .X86_64 => `x86_64-apple-darwin`,
        .Aarch64 => `aarch64-apple-darwin`,
        _ => String.new()
      ),
    // Linux is musl-only: the static musl bundle IS the Linux bundle and runs
    // on glibc hosts too (see `host_bundle_name`).
    is_target_linux(target) =>
      match(
        target.arch,
        .X86_64 => `x86_64-unknown-linux-musl`,
        .Aarch64 => `aarch64-unknown-linux-musl`,
        _ => String.new()
      ),
    is_target_windows(target) =>
      match(
        target.arch,
        .X86_64 => `x86_64-pc-windows-msvc`,
        .Aarch64 => `aarch64-pc-windows-msvc`,
        _ => String.new()
      ),
    true => String.new()
  );
  if(triple.is_empty(), {
    // Reuse the short-name builder's diagnostics: it throws naming the
    // supported platforms and architectures. If it ever stops throwing for a
    // host this table has no triple for, refuse rather than build a bogus name.
    ___ := _host_bundle_name_base(version, exn);
    exn.throw(dyn(`No release-bundle target triple for this host.`));
  });
  `yo-v${version}-${triple}`
});
/// The release-bundle basename for a version on the HOST platform,
/// e.g. `yo-v0.2.13-linux-x64-musl` / `yo-v0.2.13-macos-arm64`. Mirrors
/// scripts/install.sh. Linux is musl-only (2026-08-20): the static musl
/// bundle is THE Linux bundle and runs on glibc and musl systems alike; the
/// glibc names exist only on releases that predate the musl legs (x64:
/// v0.2.7+, arm64: v0.2.12+), which `download_version` falls back to.
host_bundle_name :: (fn(version : String, exn : Exception) -> String)({
  base := _host_bundle_name_base(version, exn);
  cond(
    is_target_linux(host_target()) => `${base}-musl`,
    true => base
  )
});
/// Check if a specific Yo version is already cached locally.
/// A cached version is a bundle extraction whose `bin/yo` exists.
/// A path that can never exist — the placeholder for the hoisted-await
/// pattern (an `io.await` may not sit in a `cond` condition or a later
/// branch, so "no path to check" must still be AWAITED as a real path).
/// `String.new()` was used before, but `Path.new("")` NORMALIZES to `.`,
/// which exists — so `is_version_cached` reported EVERY version as installed
/// ("Yo vX is already cached." in a fresh HOME) and `_scan_versions_root`
/// scanned the CWD (measured 2026-08-17, the version-install-pinned
/// differential case; issues/fixed/version-cache-empty-path-exists.md).
_never_path :: (fn() -> String)(String.from("/nonexistent/.yo-version-never"));
is_version_cached :: (
  fn(
    version : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(bool, IoExn))
)(
  io.async((e : IoExn) => {
    // Look in the INSTALL root first, then the download cache. P3 item 1's
    // "installer/cache unification": scripts/install.sh lays versions out at
    // <prefix>/lib/yo/<tag> in exactly the same bundle shape the cache uses,
    // but nothing looked there — so a `.yo-version` pin could not see a
    // script-installed version and would offer to re-download it.
    // Install root wins because it is the version the user deliberately
    // installed; the cache is a download side-effect.
    // The await is HOISTED out of the match arm on purpose. Inside an
    // `io.async` block `io.await` may not sit in a `cond` condition or in a
    // later branch, and `match`/`if` both lower to `cond` (std/prelude.yo's
    // `if` macro). The self-hosted compiler accepts the nested form; the TS
    // compiler rejects it, and TS is what builds the release bundles — so the
    // nested form passed every PR check and broke the v0.2.5 release run.
    // Resolving to a path FIRST and awaiting unconditionally is the shape the
    // rest of this file already uses. An empty path simply does not exist.
    inst_path := match(
      get_install_version_dir(version.clone()),
      .Some(d) => cached_binary_path(d),
      .None => _never_path()
    );
    installed := e.io.await(exists(Path.new(inst_path), e.io), e.io);
    if(installed, {
      return(true);
    });
    version_dir := get_version_cache_dir(version);
    e.io.await(exists(Path.new(cached_binary_path(version_dir)), e.io), e.io)
  })
);
/// Resolve the directory holding `version`, preferring a script-installed copy
/// over a downloaded one. `.None` when neither exists.
resolve_version_dir :: (
  fn(
    version : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(Option(String), IoExn))
)(
  io.async((e : IoExn) => {
    // Both awaits hoisted for the same reason as `is_version_cached` above:
    // no `io.await` in a cond condition or a later branch.
    inst_dir := match(
      get_install_version_dir(version.clone()),
      .Some(d) => d,
      .None => _never_path()
    );
    inst_found := e.io.await(exists(Path.new(cached_binary_path(inst_dir.clone())), e.io), e.io);
    if(inst_found, {
      return(Option(String).Some(inst_dir));
    });
    cached := get_version_cache_dir(version);
    cached_found := e.io.await(exists(Path.new(cached_binary_path(cached.clone())), e.io), e.io);
    if(cached_found, {
      return(Option(String).Some(cached));
    });
    Option(String).None
  })
);
/// Is `name` already in `xs`? Used to de-duplicate a version that exists in
/// both the install root and the download cache.
_contains_version :: (fn(xs : ArrayList(String), name : String) -> bool)({
  i := usize(0);
  while(i < xs.len(), {
    match(
      xs.get(i),
      .Some(v) => if(v == name, {
        return(true);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  false
});
/// List all locally cached Yo versions (directories holding a `bin/yo`).
/// Returns an ArrayList sorted by semver (ascending). Old npm-shaped cache
/// entries (package.json + node_modules) are ignored — that channel is dead.
_scan_versions_root :: (
  fn(
    versions_dir : String,
    out : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    root_exists := e.io.await(exists(Path.new(versions_dir.clone()), e.io), e.io);
    if(!(root_exists), {
      return(());
    });
    entries := e.io.await(read_dir(Path.new(versions_dir.clone()), e.io), e);
    i := usize(0);
    while(i < entries.len(), {
      match(
        entries.get(i),
        .None => (),
        .Some(entry) => {
          if(match(entry.file_type, .Directory => true, _ => false), {
            entry_path := `${versions_dir}/${entry.name}`;
            bin_exists := e.io.await(exists(Path.new(cached_binary_path(entry_path)), e.io), e.io);
            // A version present in BOTH roots must appear once.
            if(bin_exists && !(_contains_version(out, entry.name.clone())), {
              out.push(entry.name);
            });
          });
        }
      );
      i = (i + usize(1));
    });
  })
);
list_cached_versions :: (
  fn(
    io : Io,
    exn : Exception
  ) -> Impl(Future(ArrayList(String), IoExn))
)(
  io.async((e : IoExn) => {
    versions := ArrayList(String).new();
    // Scan BOTH roots: the download cache and — when this binary was
    // script-installed — <prefix>/lib/yo. Without the second, `yo version list`
    // omits the very version the user is running (P3 item 1's installer/cache
    // unification). Install root FIRST so it wins on duplicates.
    //
    // Each root is scanned by its OWN async function rather than an inner loop.
    // Nesting a while-with-awaits inside another while-with-awaits made the
    // v0.2.4 SEED emit `goto after_while_loop_0` with no such label, breaking
    // stage-1 on every seed-driven job. The seed is a RELEASED binary, so the
    // only fix available here is to not generate that shape.
    inst_root := match(
      get_install_versions_dir(),
      .Some(d) => d,
      .None => _never_path()
    );
    e.io.await(_scan_versions_root(inst_root, versions, e.io, e.exn), e);
    e.io.await(_scan_versions_root(get_global_versions_cache_dir(), versions, e.io, e.exn), e);
    _sort_by_semver(versions)
  })
);
/// Remove a specific cached version, or all cached versions when `version_opt` is `.None`.
clean_version_cache :: (
  fn(
    version_opt : Option(String),
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    match(
      version_opt,
      .Some(version) => {
        version_dir := get_version_cache_dir(version);
        dir_exists := e.io.await(exists(Path.new(version_dir), e.io), e.io);
        if(dir_exists, {
          e.io.await(remove_dir_all(Path.new(version_dir), e.io), e);
        });
      },
      .None => {
        versions_dir := get_global_versions_cache_dir();
        dir_exists := e.io.await(exists(Path.new(versions_dir), e.io), e.io);
        if(dir_exists, {
          e.io.await(remove_dir_all(Path.new(versions_dir), e.io), e);
        });
      }
    );
  })
);
/// HTTP GET via std/http (D6 PR-3 — the curl shell-out is gone), sending
/// the headers GitHub's API requires. Follows redirects. Returns the
/// response body as a String. HTTP 403 throws the rate-limit message, any
/// other status >= 400 throws `HTTP <code> fetching <url>`. (The old
/// signature also declared an `exn` parameter no call site ever passed —
/// the arity mismatch was invisible to `check` because def-time trial
/// failures are swallowed.)
_http_get :: (
  fn(url : String, io : Io) -> Impl(Future(String, IoExn))
)(
  io.async((e : IoExn) => {
    opts := FetchOptions.new();
    opts = opts.with_header(`User-Agent`, `yo-version-cache`);
    opts = opts.with_header(`Accept`, `application/vnd.github+json`);
    opts = opts.with_max_redirects(usize(5));
    resp := e.io.await(fetch_with(url, opts, e.io), e);
    if(resp.status_code == i32(403), {
      // Unauthenticated GitHub API rate limit (60 requests/hour/IP).
      e.exn.throw(
        dyn(
          `GitHub API rate limit reached (HTTP 403). Wait a bit and retry, or check https://github.com/${_github_repo()}/releases in a browser.`
        )
      );
    });
    if(resp.status_code >= i32(400), {
      e.exn.throw(dyn(`HTTP ${resp.status_code} fetching ${url}`));
    });
    resp.body
  })
);
/// Download a URL to `dest_path` via std/http (D6 PR-3). Follows redirects.
/// Returns the final HTTP status code as a 3-digit String (e.g. "200",
/// "404") so the caller can map statuses to messages. Like the curl
/// `-o`/`-w` pair it replaces: the body is written to `dest_path` whatever
/// the status, and only a transport failure throws.
_download_file :: (
  fn(
    url : String,
    dest_path : String,
    io : Io
  ) -> Impl(Future(String, IoExn))
)(
  io.async((e : IoExn) => {
    opts := FetchOptions.new();
    opts = opts.with_header(`User-Agent`, `yo-version-cache`);
    opts = opts.with_max_redirects(usize(5));
    // Release bundles are tens of MiB; give them ample headroom over the
    // 64 MiB default response cap.
    opts = opts.with_max_response_bytes(usize(536870912));
    resp := e.io.await(fetch_with(url, opts, e.io), e);
    e.io.await(write_string(Path.new(dest_path), resp.body, e.io), e);
    `${resp.status_code}`
  })
);
/// One page of the GitHub Releases API scan: the non-draft, non-prerelease
/// tag names (leading "v" stripped) plus the TOTAL count of top-level
/// objects seen (drafts included) — the <100 early-stop signal.
_ReleasePage :: struct(tags : ArrayList(String), object_count : i64);
/// Byte-level scanner for one GitHub Releases API response page (a
/// top-level JSON ARRAY of release objects). Walks the bytes tracking
/// string/escape state and brace depth; each depth-1 object span is
/// sliced out (byte-level, so non-ASCII release bodies cannot skew
/// rune-based indices) and probed for `tag_name` / `draft` / `prerelease`.
/// Both `"key":value` and `"key": value` spacings are handled.
_scan_release_page :: (fn(json : String) -> _ReleasePage)({
  tags := ArrayList(String).new();
  object_count := i64(0);
  bytes := json.as_bytes(); // shared RC reference, no copy
  n := bytes.len();
  pos := usize(0);
  in_string := false;
  skip_next := false;
  obj_depth := i32(0);
  obj_start := usize(0);
  while(pos < n, {
    b := match(bytes.get(pos), .None => u8(0), .Some(x) => x);
    cond(
      skip_next => {
        skip_next = false;
      },
      in_string => cond(
        // '\' escapes the next byte inside a string
        (b == u8(92)) => {
          skip_next = true;
        },
        // closing '"'
        (b == u8(34)) => {
          in_string = false;
        },
        true => ()
      ),
      // opening '"'
      (b == u8(34)) => {
        in_string = true;
      },
      // '{'
      (b == u8(123)) => {
        if(obj_depth == i32(0), {
          obj_start = pos;
        });
        obj_depth = (obj_depth + i32(1));
      },
      // '}'
      (b == u8(125)) => {
        obj_depth = (obj_depth - i32(1));
        if(obj_depth == i32(0), {
          object_count = (object_count + i64(1));
          span := String.from_bytes(bytes.slice_copy(obj_start .. (pos + usize(1))));
          is_draft := (span.contains(String.from("\"draft\":true")) || span.contains(String.from("\"draft\": true")));
          is_prerelease := (span.contains(String.from("\"prerelease\":true")) || span.contains(String.from("\"prerelease\": true")));
          if(!(is_draft || is_prerelease), {
            match(
              _json_string_for_key(span, String.from("tag_name")),
              .None => (),
              .Some(tag) => {
                cleaned := cond(
                  tag.starts_with(String.from("v")) => tag.substring(usize(1), tag.len()),
                  true => tag
                );
                tags.push(cleaned);
              }
            );
          });
        });
      },
      true => ()
    );
    pos = (pos + usize(1));
  });
  _ReleasePage(tags : tags, object_count : object_count)
});
/// Failure cleanup for `download_version`: remove the (possibly partial)
/// version directory and the temp directory. Ports the TS catch+finally.
_cleanup_failed_download :: (
  fn(
    version_dir : String,
    tmp_path : Path,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    ver_exists := e.io.await(exists(Path.new(version_dir), e.io), e.io);
    if(ver_exists, {
      e.io.await(remove_dir_all(Path.new(version_dir), e.io), e);
    });
    e.io.await(remove_dir_all(tmp_path, e.io), e);
  })
);
/// Download a specific Yo version's native bundle from GitHub Releases and
/// cache it. Returns the path to the cached version directory.
download_version :: (
  fn(
    version : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(String, IoExn))
)(
  io.async((e : IoExn) => {
    min_version := String.from(MIN_BUNDLE_VERSION);
    if(compare_semver(version, min_version) < i64(0), {
      e.exn.throw(
        dyn(
          `Yo v${version} predates the native release bundles (first bundled release: v${min_version}) and is no longer distributed — npm publishing stopped at v0.2.0. Pin v${min_version} or later.`
        )
      );
    });
    // GitHub Releases is HTTPS-only, and std/http's https goes through the
    // TLS backend. On a machine where that backend is unavailable (no
    // OpenSSL; Windows Schannel pending) say so plainly instead of letting
    // fetch_with fail somewhere deep inside the handshake.
    if(!(tls_available()), {
      e.exn.throw(
        dyn(
          `TLS is unavailable in this build, and downloading Yo versions requires HTTPS. Install OpenSSL (macOS: brew install openssl@3; the Windows Schannel backend is still pending) and retry.`
        )
      );
    });
    // Releases from the one after v0.2.18 name their assets by canonical target
    // triple; v0.2.18 and earlier carry only the short form. Try the triple,
    // then fall back — this BRIDGES the changeover so the current release stays
    // installable, and is removable once nothing in use predates it
    // (plans/RELEASE_ASSET_TRIPLES.md).
    (bundle_name : String) = host_bundle_triple_name(version, e.exn);
    version_dir := get_version_cache_dir(version);
    // 1. Download the tarball to a temp directory.
    tmp_dir := e.io.await(TempDir.new(e.io), e);
    tmp_path_str := tmp_dir.path().to_string();
    (url : String) = `${_releases_download_url()}/v${version}/${bundle_name}.tar.gz`;
    (tarball_path : String) = `${tmp_path_str}/${bundle_name}.tar.gz`;
    println(`Downloading Yo v${version} (${bundle_name}) from GitHub Releases...`);
    code_str := e.io.await(_download_file(url, tarball_path, e.io), e);
    (code : i64) = match(code_str.parse_i64(), .None => i64(0), .Some(c) => c);
    // Pre-triple fallback: the short `yo-v<v>-<os>-<arch>[-musl]` name.
    if(code == i64(404), {
      // NOT named `short`: that shadows the prelude C-interop integer type,
      // and builtin-first dispatch makes the interpolation below resolve the
      // BUILTIN — the def-eval swallow then hollowed this whole async body,
      // which is what broke `yo version install` in v0.2.19/v0.2.20
      // (issues/builtin-name-shadows-user-definition.md, third face;
      // issues/fixed/wrong-arity-call-silently-accepted-version-install-broken.md).
      short_name := host_bundle_name(version, e.exn);
      println(`No ${bundle_name}.tar.gz on v${version} — retrying the pre-triple bundle name (${short_name})...`);
      bundle_name = short_name;
      url = `${_releases_download_url()}/v${version}/${bundle_name}.tar.gz`;
      tarball_path = `${tmp_path_str}/${bundle_name}.tar.gz`;
      short_code_str := e.io.await(_download_file(url, tarball_path, e.io), e);
      code = match(short_code_str.parse_i64(), .None => i64(0), .Some(c1) => c1);
    });
    // Linux glibc-era fallback: releases that predate the musl legs only
    // published `yo-v<v>-linux-<arch>` bundles. On a glibc host that bundle
    // is fully functional; on a musl host it will not run, but a download
    // that exists beats a hard 404 (install.sh makes the same call).
    if((code == i64(404)) && is_target_linux(host_target()), {
      legacy := _host_bundle_name_base(version, e.exn);
      println(`No ${bundle_name}.tar.gz on v${version} — retrying the pre-musl bundle name (${legacy})...`);
      bundle_name = legacy;
      url = `${_releases_download_url()}/v${version}/${bundle_name}.tar.gz`;
      tarball_path = `${tmp_path_str}/${bundle_name}.tar.gz`;
      legacy_code_str := e.io.await(_download_file(url, tarball_path, e.io), e);
      code = match(legacy_code_str.parse_i64(), .None => i64(0), .Some(c2) => c2);
    });
    if(code == i64(404), {
      e.io.await(_cleanup_failed_download(version_dir, tmp_dir.path(), e.io, e.exn), e);
      msg := `Yo v${version} has no ${bundle_name}.tar.gz release asset.`;
      msg.push_string(String.from("\nRun `yo version list --remote` to see the published releases, or check "));
      msg.push_string(`https://github.com/${_github_repo()}/releases`);
      e.exn.throw(dyn(msg));
    });
    if(code >= i64(400), {
      e.io.await(_cleanup_failed_download(version_dir, tmp_dir.path(), e.io, e.exn), e);
      e.exn.throw(dyn(`HTTP ${code.to_string()} downloading ${url}`));
    });
    // 2. Extract; the tarball root is a `<bundleName>/` directory holding
    // bin/, std/ and vendor/ as SIBLINGS (the compiler resolves its std by
    // walking up from the executable, and mimalloc as <std>/../vendor).
    tar_cmd := Command.new(String.from("tar"));
    tar_cmd.arg(String.from("xzf"));
    tar_cmd.arg(tarball_path);
    tar_cmd.arg(String.from("-C"));
    tar_cmd.arg(tmp_path_str);
    tar_out := e.io.await(tar_cmd.output(e.io), e);
    if(!(tar_out.status.success()), {
      e.io.await(_cleanup_failed_download(version_dir, tmp_dir.path(), e.io, e.exn), e);
      e.exn.throw(dyn(`Failed to extract ${bundle_name}.tar.gz for Yo v${version}`));
    });
    // The tarball root is conventionally named after the asset, but do not
    // REQUIRE that: the asset-name/directory-name coupling is what forced the
    // triple rename to ship duplicate tarballs rather than duplicate upload
    // names (plans/RELEASE_ASSET_TRIPLES.md). Find the extracted root by
    // looking for the directory that holds bin/ and std/, and fall back to the
    // conventional name only for the error message.
    (extracted_dir : String) = `${tmp_path_str}/${bundle_name}`;
    (found_root : bool) = false;
    entries := e.io.await(read_dir(Path.new(tmp_path_str), e.io), e);
    (ei : usize) = usize(0);
    while(runtime((ei < entries.len()) && (found_root == false)), {
      entry := entries(ei);
      cand := `${tmp_path_str}/${entry.name}`;
      cand_bin := e.io.await(exists(Path.new(`${cand}/bin`), e.io), e.io);
      cand_std := e.io.await(exists(Path.new(`${cand}/std`), e.io), e.io);
      if(cand_bin && cand_std, {
        extracted_dir = cand;
        found_root = true;
      });
      ei = (ei + usize(1));
    });
    if(found_root == false, {
      e.io.await(_cleanup_failed_download(version_dir, tmp_dir.path(), e.io, e.exn), e);
      e.exn.throw(dyn(`Unexpected bundle layout in ${bundle_name}.tar.gz (no directory with bin/ and std/).`));
    });
    // 3. Remove any existing partial extraction (or a dead npm-shaped
    // entry), then MOVE the extracted bundle root to the version directory.
    ver_exists := e.io.await(exists(Path.new(version_dir), e.io), e.io);
    if(ver_exists, {
      e.io.await(remove_dir_all(Path.new(version_dir), e.io), e);
    });
    e.io.await(create_dir_all(Path.new(get_global_versions_cache_dir()), e.io), e);
    e.io.await(rename(Path.new(extracted_dir), Path.new(version_dir), e.io), e);
    println(`Installed Yo v${version} to ${version_dir}`);
    // 4. Clean up the temp directory (the tarball stays behind in it).
    e.io.await(remove_dir_all(tmp_dir.path(), e.io), e);
    version_dir
  })
);
/// Ensure a specific Yo version is cached. Downloads it if not already present.
/// Returns the path to the cached version directory.
ensure_cached_version :: (
  fn(
    version : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(String, IoExn))
)(
  io.async((e : IoExn) => {
    // Arity fix (2026-08-30): this call passed TWO args to the THREE-param
    // is_version_cached for its entire life — the def-eval swallow accepts
    // wrong-arity calls, and the missing `exn` record made `cached` read
    // stack garbage at runtime: truthy garbage silently no-opped the install
    // (rc=0, nothing cached), falsy garbage continued into corrupted state
    // (rc=134) — `yo version install` was broken in every release
    // (issues/fixed/wrong-arity-call-silently-accepted-version-install-broken.md).
    cached := e.io.await(is_version_cached(version, e.io, e.exn), e);
    if(cached, {
      return(get_version_cache_dir(version));
    });
    e.io.await(download_version(version, e.io, e.exn), e)
  })
);
/// Fetch all published Yo versions from the GitHub Releases API.
/// Returns a semver-sorted ArrayList of version strings (tags with the `v`
/// prefix stripped); drafts and prereleases are excluded.
fetch_remote_versions :: (
  fn(
    io : Io,
    exn : Exception
  ) -> Impl(Future(ArrayList(String), IoExn))
)(
  io.async((e : IoExn) => {
    // Same TLS gate as download_version: the GitHub API is HTTPS-only.
    if(!(tls_available()), {
      e.exn.throw(
        dyn(
          `TLS is unavailable in this build, and listing remote versions requires HTTPS. Install OpenSSL (macOS: brew install openssl@3; the Windows Schannel backend is still pending) and retry.`
        )
      );
    });
    versions := ArrayList(String).new();
    // The API pages at 100 releases; three pages is far beyond the horizon.
    page := i64(1);
    done := false;
    while((page <= i64(3)) && (!(done)), {
      url := `${_releases_api_url()}?per_page=100&page=${page}`;
      body := e.io.await(_http_get(url, e.io), e);
      trimmed := body.trim();
      if(!(trimmed.starts_with(String.from("["))), {
        e.exn.throw(dyn(`Unexpected GitHub Releases API response shape.`));
      });
      scanned := _scan_release_page(body);
      i := usize(0);
      while(i < scanned.tags.len(), {
        match(
          scanned.tags.get(i),
          .None => (),
          .Some(t) => {
            versions.push(t);
          }
        );
        i = (i + usize(1));
      });
      if(scanned.object_count < i64(100), {
        done = true;
      });
      page = (page + i64(1));
    });
    _sort_by_semver(versions)
  })
);
// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------
export(
  compare_semver,
  cached_binary_path,
  host_bundle_name,
  host_bundle_triple_name,
  is_version_cached,
  resolve_version_dir,
  list_cached_versions,
  clean_version_cache,
  download_version,
  ensure_cached_version,
  fetch_remote_versions
);
