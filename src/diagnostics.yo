//! src/diagnostics — the structured diagnostic value and its renderers.
//!
//! P1 of plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md: a diagnostic is DATA first —
//! `code`/`severity`/`message`/`span` (+ the extracted `source_line`) — and
//! every output format (human, short; JSON in P2) is a rendering of that
//! value. No consumer ever parses a rendering back except the LSP adapter,
//! which P3 replaces with the typed channel.
//!
//! Position conventions (stated once, load-bearing): rows and columns are
//! 0-based internally (the `Token` basis) and RUNE columns, not bytes; the
//! `+1` is display-only, and the caret padding counts runes so the underline
//! lands under the right character on lines with multibyte text before it.
{ String } :: import("std/string");
{ println, eprintln } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
json :: import("std/encoding/json");
{ JsonValue } :: import("std/encoding/json");
/// The error-rendering format for this process: "human" (default), "short",
/// or "json" (JSON Lines — one object per diagnostic, on stdout). Set once
/// at CLI startup from `--error-format`/`YO_ERROR_FORMAT`; every edge that
/// prints or rethrows a rendered diagnostic goes through
/// `render_diagnostics_for_mode` so the choice is global and consistent.
(g_error_format : String) = String.from("human");
set_error_format :: (fn(mode : String) -> unit)({
  g_error_format = mode;
});
error_format :: (fn() -> String)(g_error_format);
/// Print already-rendered diagnostic text on the right stream: JSON Lines
/// are DATA (stdout); human/short go to stderr like every compiler's
/// diagnostics.
emit_rendered_text :: (fn(text : String) -> unit)({
  cond(
    ((g_error_format == "json") || (g_error_format == "sarif")) => println(text),
    true => eprintln(text)
  );
});
/// Progress chatter (`check: …`): stdout normally, stderr under
/// `--error-format json` so the data channel stays pure JSON Lines.
emit_chatter :: (fn(text : String) -> unit)({
  cond(
    ((g_error_format == "json") || (g_error_format == "sarif")) => eprintln(text),
    true => println(text)
  );
});
/// ── Warnings channel (P4, plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md — D15) ───────
/// Whether warning-severity diagnostics are COLLECTED during evaluation.
/// The CLI edges that surface warnings (check / compile / build / test)
/// switch this on for the process and flush the stash at the end; the LSP
/// and `yo fix` leave it off — they consume the error channel only, and an
/// unflushed stash would grow across a server's lifetime. Detection sites
/// (the evaluator's scope-end walks) call `emit_warning`, which is a no-op
/// while this is off, so a disabled run pays one bool test per scope.
(g_warnings_enabled : bool) = false;
set_warnings_enabled :: (fn(on : bool) -> unit)({
  g_warnings_enabled = on;
});
warnings_enabled :: (fn() -> bool)(g_warnings_enabled);
/// The collected warnings, deduped: a variable that lives in a frame
/// walked twice (a re-evaluated generic body) warns once. Linear scan —
/// per-scope emission keeps N small.
(g_pending_warnings : ArrayList(Diagnostic)) = ArrayList(Diagnostic).new();
emit_warning :: (fn(d : Diagnostic) -> unit)({
  if(g_warnings_enabled, {
    (pi : usize) = usize(0);
    while(pi < g_pending_warnings.len(), {
      match(
        g_pending_warnings.get(pi),
        .Some(p) => if((p.span.path == d.span.path) && ((p.span.row == d.span.row) && ((p.span.col == d.span.col) && (p.message == d.message))), {
          return;
        }),
        .None => ()
      );
      pi = (pi + usize(1));
    });
    g_pending_warnings.push(d);
  });
});
/// Take (and clear) the pending warnings — the CLI edge renders whatever
/// accumulated during the command, in the process's current format.
take_warnings :: (fn() -> ArrayList(Diagnostic))({
  out := g_pending_warnings;
  g_pending_warnings = ArrayList(Diagnostic).new();
  out
});
/// ── Diagnostic codes (P2, plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md §5) ──────────
/// `E` + 4 digits, allocated per error FAMILY (never renumbered once
/// published). Bands: E00xx–E02xx syntax (lexer+parser), E03xx–E05xx
/// name/scope/module resolution, E06xx–E08xx types & traits, E09xx–E10xx
/// ownership/moves/effects/async, E11xx–E12xx comptime, E13xx internal
/// codegen, E15xx CLI/build/deps. These `str` constants are the only
/// spelling of each code in the tree.
// Syntax (lexer + parser).
E_UNEXPECTED_TOKEN :: "E0001";
E_EXPECTED_TOKEN :: "E0002";
E_ADJACENT_OPERATORS :: "E0003";
E_UNTERMINATED :: "E0004";
E_UNEXPECTED_CHARACTER :: "E0005";
E_UNKNOWN_OPERATOR :: "E0006";
E_STRUCT_LITERAL_VS_BLOCK :: "E0007";
E_CALL_SYNTAX :: "E0008";
// Name / scope / module resolution.
E_VARIABLE_NOT_FOUND :: "E0401";
E_ENUM_VARIANT_NOT_FOUND :: "E0402";
E_MODULE_FIELD_NOT_FOUND :: "E0403";
E_NOT_DEFINED :: "E0404";
E_PRIVATE_MEMBER :: "E0405";
/// A field read names no field of the struct, tuple or union (Phase 4.3).
E_FIELD_NOT_FOUND :: "E0406";
// Types & traits.
E_INCOMPATIBLE_TYPES :: "E0601";
E_TRAIT_NOT_IMPLEMENTED :: "E0602";
E_ARGUMENT_COUNT_MISMATCH :: "E0603";
E_RETURN_TYPE_MISMATCH :: "E0604";
E_TYPE_MISMATCH :: "E0605";
E_NOT_CALLABLE :: "E0606";
E_MATCH_NOT_EXHAUSTIVE :: "E0607";
E_MATCH_UNREACHABLE_ARM :: "E0608";
E_INVALID_PATTERN :: "E0609";
/// A call with no matching candidate: a method the receiver type lacks, or
/// arguments no candidate accepts.
E_NO_MATCHING_CALL :: "E0610";
/// Safe mode D7: `unwrap`/`expect`/`unwrap_err` on an Option/Result receiver
/// in a safe file discards the failure the type carries.
E_OPTIMISTIC_PANIC :: "E0611";
/// A second impl of one trait for one type (plans/reference/TRAIT_COHERENCE.md).
E_CONFLICTING_IMPL :: "E0612";
/// A call's type parameter that no argument and no expected type determines
/// (plans/TYPE_SYSTEM_SOUNDNESS.md Phase 2.4).
E_CANNOT_INFER :: "E0613";
/// A trait method called through a `Dyn` receiver that a Dyn cannot call:
/// `Self` outside the receiver, or `generic(...)` binders
/// (plans/TYPE_SYSTEM_SOUNDNESS.md Phase 2.7, docs/en-US/DYN_DESIGN.md).
E_DYN_UNCALLABLE :: "E0614";
/// An argument label that names another parameter than the one at its
/// position: labels document a call, they never reorder it
/// (plans/TYPE_SYSTEM_SOUNDNESS.md Phase 4.4).
E_ARGUMENT_LABEL_MISMATCH :: "E0615";
// Ownership / moves / effects / async.
E_USE_OF_MOVED_VALUE :: "E0901";
E_CANNOT_REASSIGN :: "E0902";
E_MAYBE_UNINITIALIZED :: "E0903";
/// A construct an `io.async` body that awaits cannot hold yet: an `io.await`
/// the state machine cannot split, a non-classic pattern in an awaiting
/// `match`, an `inout(name) :=` binding (plans/TYPE_SYSTEM_SOUNDNESS.md Phase 4.1).
E_AWAIT_PLACEMENT :: "E0904";
E_NEVER_FULLY_EVALUATED :: "E0905";
E_FORWARD_REFERENCE :: "E0906";
// Comptime.
E_COMPTIME_ARGUMENT :: "E1101";
E_COMPTIME_OVERFLOW :: "E1102";
/// A compile-time `/` or `%` whose divisor is zero.
E_COMPTIME_DIVISION_BY_ZERO :: "E1103";
/// The severity of a diagnostic entry. The FIRST entry of an error group is
/// the primary (`Error`, or `Warning` once a warnings channel exists);
/// secondary entries ("value moved here", "Defined here:") are `Note`s.
Severity :: enum(Error, Warning, Note, Help);
derive(Severity, Clone);
/// A source location: file, 0-based row, 0-based RUNE column, and the
/// span's rune length (how many `^` the underline draws).
Span :: struct(
  path : String,
  row : usize,
  col : usize,
  len : usize
);
derive(Span, Clone);
/// A secondary location attached to a diagnostic. P1 carries secondary
/// locations as follow-on `Note` entries instead; labels are the P2/P3
/// channel (plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md §3).
Label :: struct(
  severity : Severity,
  message : String,
  span : Span
);
/// A MECHANICAL REPAIR — the edit that fixes this diagnostic, when exactly
/// one edit does. `yo fix` applies it and `--error-format json` carries it, so
/// an agent does not have to re-derive a fix the compiler already knows
/// (plans/archive/LLM_FRIENDLY_TOOLCHAIN_AND_SYNTAX.md §2).
///
/// The edit replaces the runes `[span.col, span.col + span.len)` on
/// `span.row` of `span.path` with `replacement` — rune-indexed like `Span`
/// itself, so a non-ASCII line is handled by the same conversion the renderer
/// uses. A repair is only ever set when it is the UNIQUE fix: `yo fix` never
/// guesses between alternatives.
Repair :: struct(
  span : Span,
  replacement : String,
  description : String
);
derive(Repair, Clone);
derive(Diagnostic, Clone);

/// ── Color (P4, plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md — D14) ──────────────────
/// Whether the human renderer wraps its output in ANSI SGR sequences. The
/// CLI front door resolves `--color auto|always|never` / `YO_COLOR` (auto =
/// stderr is a terminal, `NO_COLOR` unset, `TERM != dumb`) and sets this
/// once at startup; every render reads it. Only the HUMAN renderer colors —
/// `short` stays grep-able and `json`/`sarif` stay parseable regardless of
/// the flag, including the human text embedded in their payloads.
(g_color_enabled : bool) = false;
set_color_enabled :: (fn(on : bool) -> unit)({
  g_color_enabled = on;
});
color_enabled :: (fn() -> bool)(g_color_enabled);
/// Wrap `text` in the SGR sequence `code` when `color` is on, else return
/// it byte-identical — a disabled render is exactly the pre-color output.
/// Takes the switch EXPLICITLY rather than reading the process global: the
/// json/sarif renderers color-proof their embedded human text by passing
/// `false` even when `--color always` is in force.
/// (`\u{1b}` is ESC: the lexer's escape table has no `\x` form.)
_colorize :: (fn(text : String, code : str, color : bool) -> String)(
  cond(
    color => `\u{1b}[${code}m${text}\u{1b}[0m`,
    true => text
  )
);
/// SGR codes: the severity header and its carets carry the severity color;
/// the `-->` anchor and the gutter (`|` + row number) carry the location
/// color. Bold variants throughout, rustc-style.
_ANSI_ERROR :: "1;31";
_ANSI_WARNING :: "1;33";
_ANSI_NOTE :: "1;36";
_ANSI_HELP :: "1;35";
_ANSI_LOCATION :: "1;34";
_severity_ansi :: (fn(sev : Severity) -> str)(
  match(
    sev,
    .Error => _ANSI_ERROR,
    .Warning => _ANSI_WARNING,
    .Note => _ANSI_NOTE,
    .Help => _ANSI_HELP
  )
);

/// Normalize a path for directory-prefix comparison: strip a `file://`
/// scheme and any trailing separator, so the same resolver output spelled
/// either way compares equal.
_normalize_path_prefix :: (fn(p : String) -> String)({
  out := p;
  if(out.starts_with(String.from("file://")), {
    out = out.substring(usize(7), out.len());
  });
  while((out.len() > usize(1)) && (out.substring(out.len() - usize(1), out.len()) == "/"), {
    out = out.substring(usize(0), out.len() - usize(1));
  });
  out
});
/// True when `path` IS `dir` or lives UNDER it — a path-COMPONENT check,
/// not a bare string prefix, so `<repo>/stdlib_extra/x.yo` does not match
/// a `<repo>/std` root.
_path_is_under :: (fn(path : String, dir : String) -> bool)({
  d := _normalize_path_prefix(dir);
  pd := _normalize_path_prefix(path);
  if(d.len() == usize(0), {
    return(false);
  });
  if(pd == d, {
    return(true);
  });
  pd.starts_with(`${d}/`)
});
/// Take the pending warnings that belong to USER code. Warnings under
/// `std_root` (the std this command imported — `yo check ./std` is how
/// std's own warnings surface) or `cache_root` (content-addressed
/// dependency sources) are dropped; everything else comes back and the
/// stash is cleared. Pure data — edges decide where and whether to render.
take_user_warnings :: (fn(std_root : String, cache_root : String) -> ArrayList(Diagnostic))({
  ws := take_warnings();
  kept := ArrayList(Diagnostic).new();
  (kwi : usize) = usize(0);
  while(kwi < ws.len(), {
    match(
      ws.get(kwi),
      .Some(w) => {
        under_std := _path_is_under(w.span.path, std_root);
        under_cache := _path_is_under(w.span.path, cache_root);
        if(!under_std && !under_cache, {
          kept.push(w.clone());
        });
      },
      .None => ()
    );
    kwi = (kwi + usize(1));
  });
  kept
});
/// Take + render + print the user warnings in the process's current
/// format; a no-op while the warnings gate is off or nothing survives the
/// filter. Edges call this wherever warnings should surface: the end of
/// main, after each watch round, and on the error-exit path (before the
/// error renders — warnings were emitted first).
flush_user_warnings :: (fn(std_root : String, cache_root : String) -> unit)({
  if(!g_warnings_enabled, {
    return;
  });
  kept := take_user_warnings(std_root, cache_root);
  if(kept.len() > usize(0), {
    emit_rendered_text(render_diagnostics_for_mode(kept));
  });
});
/// One diagnostic entry. `source_line` is the source text at `span.row`,
/// extracted once at construction — the renderer never re-reads files.
/// `help` (P3) carries an in-band repair hint ("did you mean …"); it
/// defaults to none so P1-era construction sites stay unchanged.
/// A span path as a person reads it: a demand-loaded module's key is a
/// `file://` URI, which the human and short renderers print as the plain path
/// (the JSON and SARIF renderers keep the path as recorded).
_display_path :: (fn(p : String) -> String)(
  cond(
    p.starts_with(`file://`) => p.slice_copy(usize(7) .. p.len()),
    true => p.clone()
  )
);
Diagnostic :: struct(
  code : Option(String),
  severity : Severity,
  message : String,
  span : Span,
  source_line : String,
  (help : Option(String)) ?= Option(String).None,
  (repair : Option(Repair)) ?= Option(Repair).None
);
_max_usize :: (fn(a : usize, b : usize) -> usize)(
  cond(
    (a > b) => a,
    true => b
  )
);
_min_usize :: (fn(a : usize, b : usize) -> usize)(
  cond((a < b) => a, true => b)
);
/// Levenshtein distance between two strings (byte-wise — identifier
/// suggestions are ASCII in practice, and the registry's codes are).
edit_distance :: (fn(a : String, b : String) -> usize)({
  m := a.len();
  n := b.len();
  if(m == usize(0), {
    return(n);
  });
  if(n == usize(0), {
    return(m);
  });
  prev := ArrayList(usize).new();
  cur := ArrayList(usize).new();
  (j : usize) = usize(0);
  while(j <= n, {
    prev.push(j);
    cur.push(usize(0));
    j = (j + usize(1));
  });
  i := usize(1);
  while(i <= m, {
    cur(usize(0)) = i;
    j2 := usize(1);
    while(j2 <= n, {
      ac := a.byte_at(i - usize(1));
      bc := b.byte_at(j2 - usize(1));
      cost := cond((ac == bc) => usize(0), true => usize(1));
      cand := _min_usize(
        prev(j2) + usize(1),
        _min_usize(cur(j2 - usize(1)) + usize(1), prev(j2 - usize(1)) + cost)
      );
      cur(j2) = cand;
      j2 = (j2 + usize(1));
    });
    k := usize(0);
    while(k <= n, {
      prev(k) = cur(k);
      k = (k + usize(1));
    });
    i = (i + usize(1));
  });
  prev(n)
});
/// The std export index behind the E0401 missing-import repair: which std
/// module specs (`std/fmt`) export a given name. Filled once per process by
/// the CLI front doors (`_index_std_exports` in main.yo) from the
/// `export(...)` lines of every std module's PUBLIC file; empty when nothing
/// filled it (the LSP, a compile without a std root) — then no import repair
/// is offered, never a wrong one. Parallel arrays, a few hundred entries.
(g_std_export_names : ArrayList(String)) = ArrayList(String).new();
(g_std_export_modules : ArrayList(String)) = ArrayList(String).new();
register_std_export :: (fn(name : String, module_spec : String) -> unit)({
  g_std_export_names.push(name);
  g_std_export_modules.push(module_spec);
});
std_export_index_size :: (fn() -> usize)(g_std_export_names.len());
/// Every std module spec exporting `name`, in registration (sorted-walk) order.
lookup_std_exporters :: (fn(name : String) -> ArrayList(String))({
  out := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < g_std_export_names.len(), {
    match(
      g_std_export_names.get(i),
      .Some(n) => if(n == name, {
        match(g_std_export_modules.get(i), .Some(m) => out.push(m.clone()), .None => ());
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});
/// The closest candidate within distance 3 — the did-you-mean engine for
/// unresolved names (P3) and unknown codes. First-listed wins ties.
suggest_name :: (fn(target : String, candidates : ArrayList(String)) -> Option(String))({
  best := Option(String).None;
  (best_d : usize) = usize(4);
  (i : usize) = usize(0);
  while(i < candidates.len(), {
    match(
      candidates.get(i),
      .Some(c) => {
        if(c == target, {
          return(Option(String).None);
        });
        d := edit_distance(target, c);
        if(d < best_d, {
          best_d = d;
          best = Option(String).Some(c);
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  best
});
_severity_prefix :: (fn(sev : Severity) -> String)(
  match(
    sev,
    .Error => String.from("error"),
    .Warning => String.from("warning"),
    .Note => String.from("note"),
    .Help => String.from("help")
  )
);
/// Number of digits of `n` (≥ 1) — a row number's gutter width.
_row_digits :: (fn(n : usize) -> usize)({
  s := `${n}`;
  cond(
    (s.len() == usize(0)) => usize(1),
    true => s.len()
  )
});
/// The first line of `message` (the header line of a rendered block).
_first_message_line :: (fn(message : String) -> String)({
  lines := message.split(String.from("\n"));
  match(
    lines.get(usize(0)),
    .Some(line) => line,
    .None => String.new()
  )
});
/// Render one entry into `out`: the `severity[code]: message` header, the
/// message's continuation lines verbatim, and (when a path is known) the
/// `-->` anchor plus gutter / source line / full-span underline. `w` is the
/// shared gutter width — the max row digits over the whole group — so the
/// `|` gutters of every block in the group align. `color` wraps the header,
/// anchor, gutter, carets and `help:` labels in ANSI SGR sequences; with it
/// off the output is byte-identical to the pre-color renderer.
_render_block :: (fn(d : Diagnostic, w : usize, color : bool, out : ArrayList(String)) -> unit)({
  prefix := _severity_prefix(d.severity);
  sev_ansi := _severity_ansi(d.severity);
  msg_lines := d.message.split(String.from("\n"));
  (mi : usize) = usize(0);
  while(mi < msg_lines.len(), {
    match(
      msg_lines.get(mi),
      .Some(line) => {
        if(mi == usize(0), {
          match(
            d.code,
            .Some(c) => out.push(`${_colorize(`${prefix}[${c}]`, sev_ansi, color)}: ${line}`),
            .None => out.push(`${_colorize(prefix, sev_ansi, color)}: ${line}`)
          );
        }, {
          out.push(line);
        });
      },
      .None => ()
    );
    mi = (mi + usize(1));
  });
  if(d.span.path.len() > usize(0), {
    row_plus1 := (d.span.row + usize(1));
    col_plus1 := (d.span.col + usize(1));
    indent := String.from(" ").repeat(w + usize(1));
    out.push(_colorize(`${indent}--> ${_display_path(d.span.path)}:${row_plus1}:${col_plus1}`, _ANSI_LOCATION, color));
    if(d.source_line.len() > usize(0), {
      out.push(_colorize(`${indent}|`, _ANSI_LOCATION, color));
      padded := `${row_plus1}`;
      while(padded.len() < w, {
        padded = ` ${padded}`;
      });
      out.push(`${_colorize(`${padded} |`, _ANSI_LOCATION, color)} ${d.source_line}`);
      underline_len := cond(
        (d.span.len == usize(0)) => usize(1),
        true => d.span.len
      );
      col_spaces := String.from(" ").repeat(d.span.col);
      carets := String.from("^").repeat(underline_len);
      out.push(`${_colorize(`${indent}|`, _ANSI_LOCATION, color)} ${col_spaces}${_colorize(carets, sev_ansi, color)}`);
    });
  });
  if(d.help.is_some(), {
    h := match(
      d.help,
      .Some(hh) => hh,
      .None => String.new()
    );
    out.push(`${_colorize(`help:`, _ANSI_HELP, color)} ${h}`);
  });
  if(d.code.is_some(), {
    c := match(
      d.code,
      .Some(cc) => cc,
      .None => String.new()
    );
    out.push(`${_colorize(`help:`, _ANSI_HELP, color)} run \`yo explain ${c}\` for more information`);
  });
});
/// The human rendering of a diagnostic group (rustc-shaped): each entry in
/// order — entry 0 is the primary error, the rest are notes — separated by
/// a blank line. This is what `YoError.to_string()` returns and what the
/// CLI edges print; one location per entry, exactly once. Colored per the
/// process-wide `color_enabled()` (P4/D14).
render_diagnostics_human :: (fn(diagnostics : ArrayList(Diagnostic)) -> String)(
  _render_diagnostics_human_colored(diagnostics, g_color_enabled)
);
/// The human rendering with an EXPLICIT color switch — the one true body;
/// `render_diagnostics_human` passes the process flag and the machine
/// formats (json/sarif) pass `false` so their embedded human text is never
/// colored, whatever `--color` says.
_render_diagnostics_human_colored :: (
  fn(diagnostics : ArrayList(Diagnostic), color : bool) -> String
)({
  out := ArrayList(String).new();
  w := usize(1);
  (di : usize) = usize(0);
  while(di < diagnostics.len(), {
    match(
      diagnostics.get(di),
      .Some(d) => {
        w = _max_usize(w, _row_digits(d.span.row + usize(1)));
      },
      .None => ()
    );
    di = (di + usize(1));
  });
  (dj : usize) = usize(0);
  while(dj < diagnostics.len(), {
    match(
      diagnostics.get(dj),
      .Some(d) => {
        if(dj > usize(0), {
          out.push(String.new());
        });
        _render_block(d, w, color, out);
      },
      .None => ()
    );
    dj = (dj + usize(1));
  });
  String.from("\n").join(out)
});
/// The one-line-per-entry rendering: `path:row:col: severity[code]: msg`
/// (1-based positions, first message line) — for CI logs and greps.
render_diagnostics_short :: (fn(diagnostics : ArrayList(Diagnostic)) -> String)({
  out := ArrayList(String).new();
  (di : usize) = usize(0);
  while(di < diagnostics.len(), {
    match(
      diagnostics.get(di),
      .Some(d) => {
        prefix := _severity_prefix(d.severity);
        head := _first_message_line(d.message);
        match(
          d.code,
          .Some(c) => out.push(
            `${_display_path(d.span.path)}:${(d.span.row + usize(1))}:${(d.span.col + usize(1))}: ${prefix}[${c}]: ${head}`
          ),
          .None => out.push(
            `${_display_path(d.span.path)}:${(d.span.row + usize(1))}:${(d.span.col + usize(1))}: ${prefix}: ${head}`
          )
        );
      },
      .None => ()
    );
    di = (di + usize(1));
  });
  String.from("\n").join(out)
});
/// The JSON Lines rendering (P2): one JSON object per diagnostic, one line
/// each — so `head`/`jq` work per line. Positions are 0-based (the internal
/// `Token` basis; the +1 is display-only) and `end_col` = col + span length.
/// `rendered` carries the human block verbatim: agents get fields for logic
/// and the caret block for reading, without re-deriving either.
/// `labels`/`notes`/`help` exist (empty for now) so the schema is stable
/// when P3 fills them.
render_diagnostics_json :: (fn(diagnostics : ArrayList(Diagnostic)) -> String)({
  out := ArrayList(String).new();
  (di : usize) = usize(0);
  while(di < diagnostics.len(), {
    match(
      diagnostics.get(di),
      .Some(d) => {
        single := ArrayList(Diagnostic).new();
        single.push(d);
        sev := _severity_prefix(d.severity);
        span_keys := ArrayList(String).new();
        span_vals := ArrayList(JsonValue).new();
        span_keys.push(String.from("file"));
        span_vals.push(JsonValue.Str(value : d.span.path));
        span_keys.push(String.from("row"));
        span_vals.push(JsonValue.Number(value : f64(d.span.row)));
        span_keys.push(String.from("col"));
        span_vals.push(JsonValue.Number(value : f64(d.span.col)));
        span_keys.push(String.from("end_col"));
        span_vals.push(JsonValue.Number(value : f64(d.span.col + d.span.len)));
        keys := ArrayList(String).new();
        vals := ArrayList(JsonValue).new();
        keys.push(String.from("code"));
        vals.push(
          match(
            d.code,
            .Some(c) => JsonValue.Str(value : c),
            .None => JsonValue.Null
          )
        );
        keys.push(String.from("severity"));
        vals.push(JsonValue.Str(value : sev));
        keys.push(String.from("message"));
        vals.push(JsonValue.Str(value : d.message));
        keys.push(String.from("span"));
        vals.push(JsonValue.Object(keys : span_keys, values : span_vals));
        keys.push(String.from("labels"));
        vals.push(JsonValue.Array(items : ArrayList(JsonValue).new()));
        keys.push(String.from("notes"));
        vals.push(JsonValue.Array(items : ArrayList(JsonValue).new()));
        keys.push(String.from("repair"));
        vals.push(
          match(
            d.repair,
            .Some(r) => {
              rk := ArrayList(String).new();
              rv := ArrayList(JsonValue).new();
              rk.push(String.from("file"));
              rv.push(JsonValue.Str(value : r.span.path));
              rk.push(String.from("row"));
              rv.push(JsonValue.Number(value : f64(r.span.row)));
              rk.push(String.from("col"));
              rv.push(JsonValue.Number(value : f64(r.span.col)));
              rk.push(String.from("end_col"));
              rv.push(JsonValue.Number(value : f64(r.span.col + r.span.len)));
              rk.push(String.from("replacement"));
              rv.push(JsonValue.Str(value : r.replacement));
              rk.push(String.from("description"));
              rv.push(JsonValue.Str(value : r.description));
              JsonValue.Object(keys : rk, values : rv)
            },
            .None => JsonValue.Null
          )
        );
        keys.push(String.from("help"));
        vals.push(
          match(
            d.help,
            .Some(h) => JsonValue.Str(value : h),
            .None => JsonValue.Null
          )
        );
        keys.push(String.from("rendered"));
        vals.push(JsonValue.Str(value : _render_diagnostics_human_colored(single, false)));
        out.push(json.stringify(JsonValue.Object(keys : keys, values : vals)));
      },
      .None => ()
    );
    di = (di + usize(1));
  });
  String.from("\n").join(out)
});
/// One SARIF `region` for a span: 1-BASED lines/columns (SARIF's own
/// convention — the opposite of our json render, whose 0-based basis is
/// stated in its doc comment), `endColumn` EXCLUSIVE per SARIF §3.30.8, so
/// a full-token span is startColumn = col+1, endColumn = col+1+len and a
/// len-0 span (the insertion repairs) collapses to a zero-width region.
_sarif_region :: (fn(span : Span) -> JsonValue)({
  keys := ArrayList(String).new();
  vals := ArrayList(JsonValue).new();
  keys.push(String.from("startLine"));
  vals.push(JsonValue.Number(value : f64(span.row + usize(1))));
  keys.push(String.from("startColumn"));
  vals.push(JsonValue.Number(value : f64(span.col + usize(1))));
  keys.push(String.from("endColumn"));
  vals.push(JsonValue.Number(value : f64(span.col + span.len + usize(1))));
  JsonValue.Object(keys : keys, values : vals)
});
/// The SARIF 2.1.0 rendering (P4): the whole diagnostic group as ONE SARIF
/// log — `runs[0].results[]` carries one result per diagnostic, so a
/// multi-entry ownership group stays one result set. A distinct `code`
/// becomes a driver rule (first-seen order); uncoded diagnostics omit
/// `ruleId`. A mechanical `repair` maps to SARIF `fixes` — the field
/// GitHub code scanning hangs its "apply fix" button on, carrying the same
/// edit `yo fix` applies. Never colored, whatever `--color` says: data.
render_diagnostics_sarif :: (fn(diagnostics : ArrayList(Diagnostic)) -> String)({
  // The distinct codes, first-seen order — the driver's `rules`.
  rule_ids := ArrayList(String).new();
  (ri : usize) = usize(0);
  while(ri < diagnostics.len(), {
    match(
      diagnostics.get(ri),
      .Some(d) => match(
        d.code,
        .Some(c) => {
          (seen : bool) = false;
          (ki : usize) = usize(0);
          while(ki < rule_ids.len(), {
            match(
              rule_ids.get(ki),
              .Some(k) => if(k == c, {
                seen = true;
              }),
              .None => ()
            );
            ki = (ki + usize(1));
          });
          if(!seen, {
            rule_ids.push(c.clone());
          });
        },
        .None => ()
      ),
      .None => ()
    );
    ri = (ri + usize(1));
  });
  rule_vals := ArrayList(JsonValue).new();
  (wi : usize) = usize(0);
  while(wi < rule_ids.len(), {
    match(
      rule_ids.get(wi),
      .Some(id) => {
        rk := ArrayList(String).new();
        rv := ArrayList(JsonValue).new();
        rk.push(String.from("id"));
        rv.push(JsonValue.Str(value : id.clone()));
        rule_vals.push(JsonValue.Object(keys : rk, values : rv));
      },
      .None => ()
    );
    wi = (wi + usize(1));
  });
  results := ArrayList(JsonValue).new();
  (di : usize) = usize(0);
  while(di < diagnostics.len(), {
    match(
      diagnostics.get(di),
      .Some(d) => {
        keys := ArrayList(String).new();
        vals := ArrayList(JsonValue).new();
        match(
          d.code,
          .Some(c) => {
            keys.push(String.from("ruleId"));
            vals.push(JsonValue.Str(value : c.clone()));
          },
          .None => ()
        );
        keys.push(String.from("level"));
        vals.push(
          JsonValue.Str(
            value : match(
              d.severity,
              .Error => String.from("error"),
              .Warning => String.from("warning"),
              .Note => String.from("note"),
              .Help => String.from("note")
            )
          )
        );
        mkeys := ArrayList(String).new();
        mvals := ArrayList(JsonValue).new();
        mkeys.push(String.from("text"));
        mvals.push(JsonValue.Str(value : d.message.clone()));
        keys.push(String.from("message"));
        vals.push(JsonValue.Object(keys : mkeys, values : mvals));
        if(d.span.path.len() > usize(0), {
          lkeys := ArrayList(String).new();
          lvals := ArrayList(JsonValue).new();
          lkeys.push(String.from("uri"));
          lvals.push(JsonValue.Str(value : d.span.path.clone()));
          pkeys := ArrayList(String).new();
          pvals := ArrayList(JsonValue).new();
          pkeys.push(String.from("artifactLocation"));
          pvals.push(JsonValue.Object(keys : lkeys, values : lvals));
          pkeys.push(String.from("region"));
          pvals.push(_sarif_region(d.span));
          plkeys := ArrayList(String).new();
          plvals := ArrayList(JsonValue).new();
          plkeys.push(String.from("physicalLocation"));
          plvals.push(JsonValue.Object(keys : pkeys, values : pvals));
          locs := ArrayList(JsonValue).new();
          locs.push(JsonValue.Object(keys : plkeys, values : plvals));
          keys.push(String.from("locations"));
          vals.push(JsonValue.Array(items : locs));
        });
        match(
          d.repair,
          .Some(r) => {
            fkeys := ArrayList(String).new();
            fvals := ArrayList(JsonValue).new();
            dsk := ArrayList(String).new();
            dsv := ArrayList(JsonValue).new();
            dsk.push(String.from("text"));
            dsv.push(JsonValue.Str(value : r.description.clone()));
            fkeys.push(String.from("description"));
            fvals.push(JsonValue.Object(keys : dsk, values : dsv));
            alkeys := ArrayList(String).new();
            alvals := ArrayList(JsonValue).new();
            alkeys.push(String.from("uri"));
            alvals.push(JsonValue.Str(value : r.span.path.clone()));
            rkeys := ArrayList(String).new();
            rvals := ArrayList(JsonValue).new();
            rkeys.push(String.from("deletedRegion"));
            rvals.push(_sarif_region(r.span));
            ick := ArrayList(String).new();
            icv := ArrayList(JsonValue).new();
            ick.push(String.from("text"));
            icv.push(JsonValue.Str(value : r.replacement.clone()));
            rkeys.push(String.from("insertedContent"));
            rvals.push(JsonValue.Object(keys : ick, values : icv));
            changes := ArrayList(JsonValue).new();
            changes.push(
              JsonValue.Object(
                keys : rkeys,
                values : rvals
              )
            );
            achkeys := ArrayList(String).new();
            achvals := ArrayList(JsonValue).new();
            achkeys.push(String.from("artifactLocation"));
            achvals.push(JsonValue.Object(keys : alkeys, values : alvals));
            achkeys.push(String.from("replacements"));
            achvals.push(JsonValue.Array(items : changes));
            acs := ArrayList(JsonValue).new();
            acs.push(JsonValue.Object(keys : achkeys, values : achvals));
            fkeys.push(String.from("artifactChanges"));
            fvals.push(JsonValue.Array(items : acs));
            fixes := ArrayList(JsonValue).new();
            fixes.push(JsonValue.Object(keys : fkeys, values : fvals));
            keys.push(String.from("fixes"));
            vals.push(JsonValue.Array(items : fixes));
          },
          .None => ()
        );
        results.push(JsonValue.Object(keys : keys, values : vals));
      },
      .None => ()
    );
    di = (di + usize(1));
  });
  driver_keys := ArrayList(String).new();
  driver_vals := ArrayList(JsonValue).new();
  driver_keys.push(String.from("name"));
  driver_vals.push(JsonValue.Str(value : String.from("yo")));
  driver_keys.push(String.from("informationUri"));
  driver_vals.push(JsonValue.Str(value : String.from("https://github.com/shd101wyy/Yo")));
  driver_keys.push(String.from("rules"));
  driver_vals.push(JsonValue.Array(items : rule_vals));
  tool_keys := ArrayList(String).new();
  tool_vals := ArrayList(JsonValue).new();
  tool_keys.push(String.from("driver"));
  tool_vals.push(JsonValue.Object(keys : driver_keys, values : driver_vals));
  run_keys := ArrayList(String).new();
  run_vals := ArrayList(JsonValue).new();
  run_keys.push(String.from("tool"));
  run_vals.push(JsonValue.Object(keys : tool_keys, values : tool_vals));
  run_keys.push(String.from("results"));
  run_vals.push(JsonValue.Array(items : results));
  runs := ArrayList(JsonValue).new();
  runs.push(JsonValue.Object(keys : run_keys, values : run_vals));
  top_keys := ArrayList(String).new();
  top_vals := ArrayList(JsonValue).new();
  top_keys.push(String.from("$schema"));
  top_vals.push(JsonValue.Str(value : String.from("https://json.schemastore.org/sarif-2.1.0.json")));
  top_keys.push(String.from("version"));
  top_vals.push(JsonValue.Str(value : String.from("2.1.0")));
  top_keys.push(String.from("runs"));
  top_vals.push(JsonValue.Array(items : runs));
  json.stringify(JsonValue.Object(keys : top_keys, values : top_vals))
});
/// Render a diagnostic group in the process's current format (defined after
/// the renderers it dispatches to — module-level order matters).
render_diagnostics_for_mode :: (fn(diagnostics : ArrayList(Diagnostic)) -> String)(
  cond(
    (g_error_format == "short") => render_diagnostics_short(diagnostics),
    (g_error_format == "json") => render_diagnostics_json(diagnostics),
    (g_error_format == "sarif") => render_diagnostics_sarif(diagnostics),
    true => render_diagnostics_human(diagnostics)
  )
);

