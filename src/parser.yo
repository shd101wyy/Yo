//! Yo parser — converts a token stream (from the lexer) into an AST (list of AstExpr).
//! The parser uses recursive descent.
//!
//! Note: The AST type is `AstExpr` (not `Expr`) to avoid conflict with the prelude's Expr type.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList, array_list } :: import("std/collections/array_list");
{ TokenKind, Token, find_matching_bracket } :: import("./token.yo");
{ tokenize } :: import("./lexer.yo");
{ YoError, format_error_message, format_raw_error } :: import("./error.yo");
{
  AstExpr,
  ExprId,
  alloc_global_expr_id,
  BK_TUPLE,
  BK_TUPLE_TYPE,
  BK_ARRAY,
  BK_SLICE,
  BK_ARRAY_VAL,
  BK_BEGIN,
  BK_IMPORT,
  BK_ANON_STRUCT,
  make_err_expr,
  ast_expr_to_string,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_atom_and_operator,
  ast_expr_is_infix_op_fn_call,
  ast_expr_token,
  desugar_program_if_calls
} :: import("./expr.yo");
/// Result of parsing one expression: the expression and the next token index.
ParseResult :: struct(
  expr : AstExpr,
  index : usize
);
/// Intermediate result of parsing function arguments.
FnArgsResult :: struct(
  args : ArrayList(AstExpr),
  index : usize
);
/// Parse errors used to be a local `ParseError` struct rendered by its own
/// `ToString` — the only rustc-shaped renderer in the tree while every other
/// stage printed plain blocks. P1 of plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md
/// deleted it: `make_parse_error`/`make_parse_error_raw` now build the same
/// structured `YoError` the evaluator and lexer throw, so one renderer (src/
/// diagnostics.yo) and one CLI-edge prefix rule serve every stage.
/// Extract the Nth source line (0-indexed) from the input string.
/// Returns an empty string if the row is out of range.
extract_source_line :: (fn(input : String, row : usize) -> String)({
  lines_list := input.split(String.from("\n"));
  match(
    lines_list.get(row),
    .None => String.from(""),
    .Some(line) => line
  )
});
/// Build a parse-error `YoError` from a token (message + full span + source
/// line, rendered by the shared renderer).
make_parse_error :: (fn(tok : Token, message : String) -> YoError)(
  format_error_message(tok, message)
);
/// Build a parse-error `YoError` without source context (end-of-input and
/// internal errors): path-anchored, no snippet.
make_parse_error_raw :: (fn(module_path : String, message : String) -> YoError)(
  format_raw_error(module_path, message)
);
// Per-process monotonic counter for AstExpr ids. Each Parser instance
// pulls from this so ids are unique across files in multi-file `check`
// (otherwise inner.yo's id=N and index.yo's id=N collide in the
// expr_info_table and the second-parsed file's import value gets stamped
// over by the first-parsed file's matching-id expression — observed as
// `import("./rune.yo")` resolving to `i32` at export-spread time).
// Global expr-id counter moved to expr.yo (shared with synthesized nodes).
/// The PREFIX-capable operators (plans/reference/PREFIX_OPERATOR_OPERAND_RULE.md
/// Rule 1): a BARE one of these in expression position, followed by a
/// primary-starter, is a prefix CALL binding exactly one postfix
/// expression — `-1`, `!x`, `&v`, `~m`, `*T`, `?T`, `^v`, and chains like
/// `**i32` = `*(*(i32))`. `+` and the rest stay infix-only. The prefix
/// dot (`.Variant`) has its own branch in parse_primary_end.
_is_prefix_op_token :: (fn(t : Token) -> bool)(
  (t.kind == TokenKind.Operator) && ((t.value == "-") || ((t.value == "!") || ((t.value == "~") || ((t.value == "&") || ((t.value == "*") || ((t.value == "?") || (t.value == "^")))))))
);
/// The result of peeling a `:spec` suffix off a template-string interpolation.
/// `spec` is empty when the text carries none, in which case `expr_text` is the
/// original text unchanged.
_SpecSplit :: struct(
  expr_text : String,
  spec : String
);
Parser :: struct(
  input_string : String,
  module_path : String,
  tokens : ArrayList(Token),
  program : ArrayList(AstExpr),
  has_template_string : bool,
  /// Did any interpolation carry a `:spec` suffix? Decides which fmt module the
  /// auto-import pulls in, so a file with no specs keeps a byte-identical
  /// import closure.
  has_template_spec : bool,
  next_expr_id : usize
);
impl(
  Parser,
  new : (
    fn(
      input_string : String,
      module_path : String,
      exn : Exception
    ) -> Self
  )({
    toks := tokenize(input_string, module_path, exn);
    Parser(
      input_string : input_string,
      module_path : module_path,
      tokens : toks,
      program : ArrayList(AstExpr).new(),
      has_template_string : false,
      has_template_spec : false,
      next_expr_id : usize(0)
    )
  }),
  get_tokens : (fn(self : Self) -> ArrayList(Token))(self.tokens),
  alloc_id : (fn(inout(self) : Self) -> ExprId)({
    id := alloc_global_expr_id();
    self.next_expr_id = (self.next_expr_id + usize(1));
    id
  }),
  make_syn_tok : (fn(inout(self) : Self, kind : TokenKind, value : String) -> Token)(
    Token(
      kind : kind,
      value : value,
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : self.module_path,
      input : self.input_string
    )
  ),
  make_unit_call : (fn(inout(self) : Self, ref_tok : Token) -> AstExpr)({
    unit_tok := Token(
      kind : TokenKind.Identifier,
      value : String.from(BK_TUPLE),
      row : ref_tok.row,
      column : ref_tok.column,
      character : ref_tok.character,
      byte_offset : ref_tok.byte_offset,
      module_path : ref_tok.module_path,
      input : ref_tok.input
    );
    .FnCall(self.alloc_id(), .Atom(self.alloc_id(), unit_tok), ArrayList(AstExpr).new(), false, unit_tok)
  }),
  skip_ws_fwd : (fn(inout(self) : Self, index : usize) -> usize)({
    i := index;
    n := self.tokens.len();
    while(i < n, {
      match(
        self.tokens.get(i),
        .None => {
          break;
        },
        .Some(tok) => {
          is_ws := (((((((tok.kind == TokenKind.Whitespace) || (tok.kind == TokenKind.SingleLineComment)) || (tok.kind == TokenKind.MultiLineComment)) || (tok.kind == TokenKind.DocLineComment)) || (tok.kind == TokenKind.InnerDocLineComment)) || (tok.kind == TokenKind.DocBlockComment)) || (tok.kind == TokenKind.InnerDocBlockComment));
          if(is_ws == false, {
            break;
          });
          i = (i + usize(1));
        }
      );
    });
    i
  }),
  skip_ws_bwd : (fn(inout(self) : Self, index : usize) -> usize)({
    i := index;
    while(true, {
      match(
        self.tokens.get(i),
        .None => {
          break;
        },
        .Some(tok) => {
          is_ws := (((((((tok.kind == TokenKind.Whitespace) || (tok.kind == TokenKind.SingleLineComment)) || (tok.kind == TokenKind.MultiLineComment)) || (tok.kind == TokenKind.DocLineComment)) || (tok.kind == TokenKind.InnerDocLineComment)) || (tok.kind == TokenKind.DocBlockComment)) || (tok.kind == TokenKind.InnerDocBlockComment));
          if(is_ws == false, {
            break;
          });
          if(i == usize(0), {
            break;
          });
          i = (i - usize(1));
        }
      );
    });
    i
  }),
  range_has_newline : (fn(inout(self) : Self, start : usize, end : usize) -> bool)({
    nl_str := String.from("\n");
    i := start;
    result := false;
    while(i < end, {
      match(
        self.tokens.get(i),
        .None => {
          break;
        },
        .Some(tok) => {
          if((tok.kind == TokenKind.Whitespace) && tok.value.contains(nl_str), {
            result = true;
            break;
          });
          i = (i + usize(1));
        }
      );
    });
    result
  }),
  is_op_at_line_start : (fn(inout(self) : Self, op_idx : usize) -> bool)({
    if(op_idx == usize(0), {
      return(true);
    });
    nl_str := String.from("\n");
    j := op_idx;
    result := false;
    scan_done := false;
    while(scan_done == false, {
      if(j == usize(0), {
        result = true;
        scan_done = true;
      }, {
        j = (j - usize(1));
        match(
          self.tokens.get(j),
          .None => {
            scan_done = true;
          },
          .Some(tok) => cond(
            ((tok.kind == TokenKind.Whitespace) && tok.value.contains(nl_str)) => {
              // Found newline — check tokens[j+1..op_idx) are all whitespace
              all_ws := true;
              k := (j + usize(1));
              while(k < op_idx, {
                match(
                  self.tokens.get(k),
                  .None => {
                    break;
                  },
                  .Some(kt) => {
                    if(kt.kind != TokenKind.Whitespace, {
                      all_ws = false;
                      break;
                    });
                    k = (k + usize(1));
                  }
                );
              });
              result = all_ws;
              scan_done = true;
            },
            (tok.kind != TokenKind.Whitespace) => {
              result = false;
              scan_done = true;
            },
            true => ()
          )
        );
      });
    });
    result
  }),
  is_parenthesized_expr : (fn(inout(self) : Self, start : usize, end : usize) -> bool)({
    s := self.skip_ws_fwd(start);
    e := self.skip_ws_bwd(end);
    s_tok := match(
      self.tokens.get(s),
      .Some(t) => t,
      .None => {
        return(false);
      }
    );
    e_tok := match(
      self.tokens.get(e),
      .Some(t) => t,
      .None => {
        return(false);
      }
    );
    if(s_tok.kind != TokenKind.LParen, {
      return(false);
    });
    if(e_tok.kind != TokenKind.RParen, {
      return(false);
    });
    match_idx := match(
      find_matching_bracket(self.tokens, s),
      .None => {
        return(false);
      },
      .Some(m) => m
    );
    match_idx == e
  }),
  parse_template_string : (fn(inout(self) : Self, tok : Token, index : usize, exn : Exception) -> ParseResult)({
    self.has_template_string = true;
    template_value := tok.value;
    // Collect chars of the template string into an ArrayList(rune)
    ts_chars := ArrayList(rune).new();
    {
      c_iter := template_value.chars();
      while(true, {
        match(
          c_iter.next(),
          .None => {
            break;
          },
          .Some(c) => {
            ts_chars.push(c);
          }
        );
      });
    };
    n := ts_chars.len();
    // Parts: each part is either a literal string or an interpolated expression
    part_is_expr := ArrayList(bool).new();
    part_content := ArrayList(String).new();
    cur_sb := StringBuilder.new();
    i := usize(0);
    while(i < n, {
      c := match(ts_chars.get(i), .Some(r) => r, .None => rune(u32(0)));
      cond(
        // Escaped dollar: \$  →  $
        (
          (c.char == u32(0x5C)) && {
            nc := match(ts_chars.get(i + usize(1)), .Some(r) => r, .None => rune(u32(0)));
            nc.char == u32(0x24)
          }
        ) => {
          cur_sb.write_byte(u8(0x24));
          i = (i + usize(2));
        },
        // Interpolation start: ${
        (
          (c.char == u32(0x24)) && {
            nc := match(ts_chars.get(i + usize(1)), .Some(r) => r, .None => rune(u32(0)));
            nc.char == u32(0x7B)
          }
        ) => {
          // Save current string part if non-empty
          if(cur_sb.len() > usize(0), {
            part_is_expr.push(false);
            part_content.push(cur_sb.to_string());
            cur_sb = StringBuilder.new();
          });
          // Scan for matching closing brace
          brace_depth := usize(1);
          expr_sb := StringBuilder.new();
          j := (i + usize(2));
          while((j < n) && (brace_depth > usize(0)), {
            cj := match(ts_chars.get(j), .Some(r) => r, .None => rune(u32(0)));
            cond(
              (cj.char == u32(0x7B)) => {
                brace_depth = (brace_depth + usize(1));
              },
              (cj.char == u32(0x7D)) => {
                brace_depth = (brace_depth - usize(1));
              },
              true => ()
            );
            if(brace_depth > usize(0), {
              expr_sb.write_rune(cj);
            });
            j = (j + usize(1));
          });
          part_is_expr.push(true);
          part_content.push(expr_sb.to_string());
          i = j;
        },
        true => {
          cond(
            (c.char == u32(0x5C)) => cur_sb.write_str("\\\\"),
            (c.char == u32(0x22)) => cur_sb.write_str("\\\""),
            (c.char == u32(0x0A)) => cur_sb.write_str("\\n"),
            (c.char == u32(0x09)) => cur_sb.write_str("\\t"),
            (c.char == u32(0x0D)) => cur_sb.write_str("\\r"),
            (c.char == u32(0x00)) => cur_sb.write_str("\\0"),
            true => cur_sb.write_rune(c)
          );
          i = (i + usize(1));
        }
      );
    });
    // Save remaining string content
    if(cur_sb.len() > usize(0), {
      part_is_expr.push(false);
      part_content.push(cur_sb.to_string());
    });
    // If no parts, use empty string literal
    if(part_content.len() == usize(0), {
      part_is_expr.push(false);
      part_content.push(String.from(""));
    });
    // Synthetic tokens for building the expression chain
    dot_tok := self.make_syn_tok(TokenKind.Dot, String.from("."));
    plus_tok := self.make_syn_tok(TokenKind.Operator, String.from("+"));
    to_str_tok := self.make_syn_tok(TokenKind.Identifier, String.from("to_string"));
    fmt_tok := self.make_syn_tok(TokenKind.Identifier, String.from("format"));
    // Helper: build `e.to_string()` — takes explicit params since local fns
    // can't capture outer values. The four synthetic sub-expressions need
    // UNIQUE expr ids (passed in via `id_*`): hardcoding `usize(0)` made
    // every template-string sub-expr collide on id 0 in the per-ctx
    // `expr_info_table`, corrupting their evaluated types (a downstream
    // `.to_string()` dispatch then saw garbage and failed to unify). Mirrors
    // the global-expr-id collision fixed in commit 354b235b.
    make_ts_call :: (
      fn(
        e : AstExpr,
        d_tok : Token,
        ts_tok : Token,
        outer_tok : Token,
        id_ts_atom : usize,
        id_dot_atom : usize,
        id_prop : usize,
        id_outer : usize
      ) -> AstExpr
    )({
      prop_args := ArrayList(AstExpr).new();
      prop_args.push(e);
      prop_args.push(.Atom(id_ts_atom, ts_tok));
      (prop : AstExpr) = .FnCall(id_prop, .Atom(id_dot_atom, d_tok), prop_args, true, d_tok);
      .FnCall(id_outer, prop, ArrayList(AstExpr).new(), false, outer_tok)
    });
    // Twin of `make_ts_call` for a spec'd interpolation: emits
    // `e.format("<spec>")` instead of `e.to_string()`. The spec text can never
    // contain a quote or a backslash — the peel's character set excludes both —
    // so wrapping it in double quotes needs no escaping.
    make_ts_spec_call :: (
      fn(
        e : AstExpr,
        d_tok : Token,
        fmt_tok : Token,
        outer_tok : Token,
        spec_tok : Token,
        id_fmt_atom : usize,
        id_dot_atom : usize,
        id_prop : usize,
        id_spec_atom : usize,
        id_outer : usize
      ) -> AstExpr
    )({
      prop_args := ArrayList(AstExpr).new();
      prop_args.push(e);
      prop_args.push(.Atom(id_fmt_atom, fmt_tok));
      (prop : AstExpr) = .FnCall(id_prop, .Atom(id_dot_atom, d_tok), prop_args, true, d_tok);
      outer_args := ArrayList(AstExpr).new();
      outer_args.push(.Atom(id_spec_atom, spec_tok));
      .FnCall(id_outer, prop, outer_args, false, outer_tok)
    });
    // `${expr:spec}` (STD_API_AUDIT D3.10). The spec is peeled off the RIGHT
    // END by walking backward over a CLOSED character set that deliberately
    // excludes `)`, `]`, `}`, quotes, comma and whitespace — so the walk can
    // physically never cross out of a call's argument list, out of a bracket,
    // or into a string literal. That is what defeats the colon ambiguity
    // without any depth or quote tracking.
    //
    // Three further conditions, all required: the run must be non-empty, the
    // character before it must be `:`, and the character before THAT must not
    // be whitespace. The last one is what preserves a spaced colon-pair
    // (`${a : b}` keeps its meaning) while `${x:>8}` splits.
    _is_spec_char :: (fn(c : rune) -> bool)(
      (((((c.char >= u32(0x30)) && (c.char <= u32(0x39))) || ((c.char >= u32(0x41)) && (c.char <= u32(0x5A)))) || ((c.char >= u32(0x61)) && (c.char <= u32(0x7A)))) || (((c.char == u32(0x2E)) || (c.char == u32(0x3C))) || ((c.char == u32(0x3E)) || (c.char == u32(0x5E))))) || ((((c.char == u32(0x2B)) || (c.char == u32(0x2D))) || ((c.char == u32(0x23)) || (c.char == u32(0x2A)))) || (((c.char == u32(0x5F)) || (c.char == u32(0x3D))) || (c.char == u32(0x7E))))
    );
    // `k` and `tn` are RUNE indices into `tc`, so the two cuts at the end are
    // resolved through the rune->byte map `char_indices()` gives rather than
    // handed to `substring`. This is plans/STD_API_AUDIT_D4_PLAN.md §5.2 S4:
    // `substring` takes BYTE offsets since D4, so feeding it these rune
    // indices would cut a template string like `${名前:>8}` apart in the
    // middle of a codepoint (and panic on the non-boundary).
    _peel_spec :: (fn(text : String) -> _SpecSplit)({
      tc := ArrayList(rune).new();
      // `toff(i)` is the byte offset rune `i` starts at.
      toff := ArrayList(usize).new();
      {
        ti := text.char_indices();
        while(runtime(true), {
          match(
            ti.next(),
            .None => {
              break;
            },
            .Some(pair) => {
              toff.push(pair._0);
              tc.push(pair._1);
            }
          );
        });
      };
      tn := tc.len();
      (k : usize) = tn;
      while((k > usize(0)) && _is_spec_char(tc(k - usize(1))), {
        k = (k - usize(1));
      });
      cond(
        // no run, no colon before it, or a colon with nothing in front
        ((k == tn) || (k < usize(2))) => _SpecSplit(expr_text : text, spec : String.new()),
        (tc(k - usize(1)).char != u32(0x3A)) => _SpecSplit(expr_text : text, spec : String.new()),
        // a SPACE before the colon means an ordinary colon-pair, not a spec
        ((tc(k - usize(2)).char == u32(0x20)) || (tc(k - usize(2)).char == u32(0x09))) =>
          _SpecSplit(expr_text : text, spec : String.new()),
        true => {
          // Both cuts land on rune boundaries by construction: they come out
          // of `char_indices()`, so `try_substring` can only answer `.Some`.
          colon_byte := match(
            toff.get(k - usize(1)),
            .Some(b) => b,
            .None => text.len()
          );
          spec_byte := match(toff.get(k), .Some(b) => b, .None => text.len());
          _SpecSplit(
            expr_text : match(
              text.try_substring(usize(0), colon_byte),
              .Some(sub) => sub,
              .None => String.new()
            ),
            spec : match(
              text.try_substring(spec_byte, text.len()),
              .Some(sub) => sub,
              .None => String.new()
            )
          )
        }
      )
    });
    num_parts := part_content.len();
    (result_expr_opt : Option(AstExpr)) = .None;
    pi := usize(0);
    while(pi < num_parts, {
      is_expr := match(part_is_expr.get(pi), .Some(b) => b, .None => false);
      content := match(part_content.get(pi), .Some(s) => s, .None => String.from(""));
      (part_expr : AstExpr) = cond(
        is_expr => {
          // Peel a `:spec` suffix BEFORE parsing, so the spec text never reaches
          // the expression parser (D3.10).
          sp := _peel_spec(content);
          // Parse the interpolated expression via the module-level holder
          // (avoids forward reference: parse_template_string → get_program cycle)
          (inner_prog : ArrayList(AstExpr)) = Parser.new(sp.expr_text, self.module_path, exn).get_program(exn);
          if(inner_prog.len() == usize(0), {
            exn.throw(dyn(make_parse_error(tok, `empty expression in template string interpolation`)));
          });
          inner_expr := match(
            inner_prog.get(usize(0)),
            .Some(e) => e,
            .None => {
              return(ParseResult(expr : make_err_expr(), index : (index + usize(1))));
            }
          );
          cond(
            (sp.spec.len() > usize(0)) => {
              self.has_template_spec = true;
              spec_tok := Token(
                kind : TokenKind.StringLit,
                value : ((String.from("\"") + sp.spec) + String.from("\"")),
                row : tok.row,
                column : tok.column,
                character : tok.character,
                byte_offset : tok.byte_offset,
                module_path : tok.module_path,
                input : tok.input
              );
              make_ts_spec_call(
                inner_expr,
                dot_tok,
                fmt_tok,
                tok,
                spec_tok,
                self.alloc_id(),
                self.alloc_id(),
                self.alloc_id(),
                self.alloc_id(),
                self.alloc_id()
              )
            },
            true => make_ts_call(inner_expr, dot_tok, to_str_tok, tok, self.alloc_id(), self.alloc_id(), self.alloc_id(), self.alloc_id())
          )
        },
        true => {
          // Literal string part: "content".to_string()
          // Build the escaped string by wrapping content in double quotes
          content_str := content.clone();
          str_tok := Token(
            kind : TokenKind.StringLit,
            value : ((String.from("\"") + content) + String.from("\"")),
            row : tok.row,
            column : tok.column,
            character : tok.character,
            byte_offset : tok.byte_offset,
            module_path : tok.module_path,
            input : tok.input
          );
          make_ts_call(.Atom(self.alloc_id(), str_tok), dot_tok, to_str_tok, tok, self.alloc_id(), self.alloc_id(), self.alloc_id(), self.alloc_id())
        }
      );
      result_expr_opt = match(
        result_expr_opt,
        .None => Option(AstExpr).Some(part_expr),
        .Some(prev) => {
          // prev.(+)(part_expr)
          prop_args := ArrayList(AstExpr).new();
          prop_args.push(prev);
          prop_args.push(.Atom(self.alloc_id(), plus_tok));
          (prop : AstExpr) = .FnCall(self.alloc_id(), .Atom(self.alloc_id(), dot_tok), prop_args, true, dot_tok);
          call_args := ArrayList(AstExpr).new();
          call_args.push(part_expr);
          Option(AstExpr).Some(.FnCall(self.alloc_id(), prop, call_args, false, tok))
        }
      );
      pi = (pi + usize(1));
    });
    final_expr := match(
      result_expr_opt,
      .Some(e) => e,
      .None => {
        return(ParseResult(expr : make_err_expr(), index : (index + usize(1))));
      }
    );
    ParseResult(expr : final_expr, index : (index + usize(1)))
  }),
  parse_fn_args : (
    fn(
      inout(self) : Self,
      index : usize,
      has_whitespace : bool,
      exn : Exception
    ) -> FnArgsResult
  )({
    args := ArrayList(AstExpr).new();
    idx := self.skip_ws_fwd(index);
    // Empty paren call: func()
    if(has_whitespace == false, {
      curr_kind := match(self.tokens.get(idx), .Some(t) => t.kind, .None => TokenKind.RParen);
      if(curr_kind == TokenKind.RParen, {
        return(FnArgsResult(args : args, index : (idx + usize(1))));
      });
    });
    while(true, {
      arg_pr := self.parse_expression(idx, exn);
      args.push(arg_pr.expr);
      idx = arg_pr.index;
      curr := match(
        self.tokens.get(idx),
        .Some(t) => t,
        .None => {
          return(FnArgsResult(args : args, index : idx));
        }
      );
      cond(
        (curr.kind == TokenKind.Comma) => {
          // TS (parser.ts:1269-1271) just advances past the comma and loops
          // back into parseExpression — a trailing comma before `)` is then
          // REJECTED there ("Unexpected token"). A previous port accepted
          // trailing commas here, silently admitting programs the TS
          // bootstrap rejects.
          idx = (idx + usize(1));
        },
        (((curr.kind == TokenKind.Semicolon) || (curr.kind == TokenKind.RBracket)) || (curr.kind == TokenKind.RCurlyBracket)) => {
          return(FnArgsResult(args : args, index : idx));
        },
        (curr.kind == TokenKind.RParen) => {
          return(
            FnArgsResult(
              args : args,
              index : cond(has_whitespace => idx, true => (idx + usize(1)))
            )
          );
        },
        true => {
          exn.throw(
            dyn(
              make_parse_error(
                curr,
                cond(
                  has_whitespace => `expected ; to end function call`,
                  true => `expected , or ) in function call`
                )
              )
            )
          );
          return(FnArgsResult(args : args, index : idx));
        }
      );
    });
    FnArgsResult(args : args, index : idx)
  }),
  parse_fn_call : (
    fn(
      inout(self) : Self,
      func : AstExpr,
      index : usize,
      has_whitespace : bool,
      exn : Exception
    ) -> ParseResult
  )({
    fn_tok := ast_expr_token(func);
    fa := self.parse_fn_args(index, has_whitespace, exn);
    ParseResult(
      expr : .FnCall(self.alloc_id(), func, fa.args, false, fn_tok),
      index : fa.index
    )
  }),
  parse_paren_expr : (fn(inout(self) : Self, index : usize, exn : Exception) -> ParseResult)({
    (tok : Token) = match(
      self.tokens.get(index),
      .None => exn.throw(dyn(make_parse_error_raw(self.module_path, `unexpected end of input`))),
      .Some(t) => t
    );
    if(tok.kind != TokenKind.LParen, {
      exn.throw(dyn(make_parse_error(tok, `expected (`)));
    });
    // Check for unit ()
    next_tok_kind := match(
      self.tokens.get(index + usize(1)),
      .Some(t) => t.kind,
      .None => TokenKind.Identifier
    );
    if(next_tok_kind == TokenKind.RParen, {
      unit_tok := Token(
        kind : TokenKind.Identifier,
        value : String.from(BK_TUPLE),
        row : tok.row,
        column : tok.column,
        character : tok.character,
        byte_offset : tok.byte_offset,
        module_path : tok.module_path,
        input : tok.input
      );
      return(
        ParseResult(
          expr : .FnCall(self.alloc_id(), .Atom(self.alloc_id(), unit_tok), ArrayList(AstExpr).new(), false, unit_tok),
          index : (index + usize(2))
        )
      );
    });
    pr := self.parse_expression(index + usize(1), exn);
    (expr : AstExpr) = pr.expr;
    idx := pr.index;
    (curr_kind : TokenKind) = match(
      self.tokens.get(idx),
      .Some(t) => t.kind,
      .None => exn.throw(dyn(make_parse_error(tok, `expected ) or , in (...)`)))
    );
    // Single expression wrapped in parens: (expr)
    if(curr_kind == TokenKind.RParen, {
      return(ParseResult(expr : expr, index : (idx + usize(1))));
    });
    // Tuple or Tuple type
    (separator_is_comma : Option(bool)) = .None;
    args := ArrayList(AstExpr).new();
    args.push(expr);
    while(true, {
      (curr : Token) = match(
        self.tokens.get(idx),
        .None => exn.throw(dyn(make_parse_error(tok, `expected ) or , for tuple`))),
        .Some(t) => t
      );
      cond(
        (curr.kind == TokenKind.Comma) => {
          separator_is_comma = match(
            separator_is_comma,
            .None => Option(bool).Some(true),
            .Some(__sb) => cond(
              __sb => Option(bool).Some(true),
              true => {
                exn.throw(dyn(make_parse_error(curr, `cannot mix , and ; in (...)`)));
                Option(bool).Some(false)
              }
            )
          );
          idx = (idx + usize(1));
        },
        (curr.kind == TokenKind.Semicolon) => {
          separator_is_comma = match(
            separator_is_comma,
            .None => Option(bool).Some(false),
            .Some(__sb) => cond(
              __sb => {
                exn.throw(dyn(make_parse_error(curr, `cannot mix ; and , in (...)`)));
                Option(bool).Some(true)
              },
              true => Option(bool).Some(false)
            )
          );
          idx = (idx + usize(1));
        },
        true => ()
      );
      idx = self.skip_ws_fwd(idx);
      (curr2 : Token) = match(
        self.tokens.get(idx),
        .None => exn.throw(dyn(make_parse_error(tok, `expected ) for tuple`))),
        .Some(t) => t
      );
      if(curr2.kind == TokenKind.RParen, {
        break;
      });
      arg_pr := self.parse_expression(idx, exn);
      args.push(arg_pr.expr);
      idx = arg_pr.index;
    });
    // comma separator → Tuple type; semicolon separator → tuple value
    is_tuple_type := match(
      separator_is_comma,
      .None => true,
      .Some(__sb) => ((__sb) == false)
    );
    kw := cond(is_tuple_type => BK_TUPLE_TYPE, true => BK_TUPLE);
    func_tok := Token(
      kind : TokenKind.Identifier,
      value : String.from(kw),
      row : tok.row,
      column : tok.column,
      character : tok.character,
      byte_offset : tok.byte_offset,
      module_path : tok.module_path,
      input : tok.input
    );
    ParseResult(
      expr : .FnCall(self.alloc_id(), .Atom(self.alloc_id(), func_tok), args, false, func_tok),
      index : (idx + usize(1))
    )
  }),
  parse_array_expr : (fn(inout(self) : Self, index : usize, exn : Exception) -> ParseResult)({
    (tok : Token) = match(
      self.tokens.get(index),
      .None => exn.throw(dyn(make_parse_error_raw(self.module_path, `unexpected end of input`))),
      .Some(t) => t
    );
    if(tok.kind != TokenKind.LBracket, {
      exn.throw(dyn(make_parse_error(tok, `expected [`)));
    });
    idx := (index + usize(1));
    (separator_is_comma : Option(bool)) = .None;
    args := ArrayList(AstExpr).new();
    while(true, {
      (curr : Token) = match(
        self.tokens.get(idx),
        .None => exn.throw(dyn(make_parse_error(tok, `expected ] or , for array`))),
        .Some(t) => t
      );
      cond(
        (curr.kind == TokenKind.Comma) => {
          separator_is_comma = match(
            separator_is_comma,
            .None => Option(bool).Some(true),
            .Some(__sb) => cond(
              __sb => Option(bool).Some(true),
              true => {
                exn.throw(dyn(make_parse_error(curr, `cannot mix , and ; in [...]`)));
                Option(bool).Some(false)
              }
            )
          );
          idx = (idx + usize(1));
        },
        (curr.kind == TokenKind.Semicolon) => {
          separator_is_comma = match(
            separator_is_comma,
            .None => Option(bool).Some(false),
            .Some(__sb) => cond(
              __sb => {
                exn.throw(dyn(make_parse_error(curr, `cannot mix ; and , in [...]`)));
                Option(bool).Some(true)
              },
              true => Option(bool).Some(false)
            )
          );
          idx = (idx + usize(1));
        },
        true => ()
      );
      (curr2 : Token) = match(
        self.tokens.get(idx),
        .None => exn.throw(dyn(make_parse_error(tok, `expected ]`))),
        .Some(t) => t
      );
      if(curr2.kind == TokenKind.RBracket, {
        break;
      });
      arg_pr := self.parse_expression(idx, exn);
      args.push(arg_pr.expr);
      idx = arg_pr.index;
    });
    // [T; N] → Array(T, N), [T] or [T;] → Slice(T), [a, b] → array(a, b)
    is_array_or_slice_type := match(
      separator_is_comma,
      .None => true,
      .Some(__sb) => ((__sb) == false)
    );
    n_args := args.len();
    if(is_array_or_slice_type && (n_args > usize(2)), {
      exn.throw(dyn(make_parse_error(tok, `expected at most 2 arguments for Array type, or 1 for Slice type`)));
    });
    is_array_type := (is_array_or_slice_type && (n_args == usize(2)));
    is_slice_type := (is_array_or_slice_type && (n_args == usize(1)));
    kw := cond(
      is_array_type => BK_ARRAY,
      is_slice_type => BK_SLICE,
      true => BK_ARRAY_VAL
    );
    func_tok := Token(
      kind : TokenKind.Identifier,
      value : String.from(kw),
      row : tok.row,
      column : tok.column,
      character : tok.character,
      byte_offset : tok.byte_offset,
      module_path : tok.module_path,
      input : tok.input
    );
    ParseResult(
      expr : .FnCall(self.alloc_id(), .Atom(self.alloc_id(), func_tok), args, false, func_tok),
      index : (idx + usize(1))
    )
  }),
  is_valid_struct_field_arg : (fn(inout(self) : Self, expr : AstExpr) -> bool)(
    match(
      expr,
      .Atom(_, _) => true,
      .FnCall(_, func_box, _, is_infix, _) => cond(
        is_infix => match(
          func_box,
          .Atom(_, func_tok) => (func_tok.value == ":"),
          .FnCall(_, _, _, _, _) => false
        ),
        true => match(
          func_box,
          .Atom(_, func_tok2) => (func_tok2.value == "..."),
          .FnCall(_, _, _, _, _) => false
        )
      )
    )
  ),
  parse_curly_bracket_expr : (fn(inout(self) : Self, index : usize, exn : Exception) -> ParseResult)({
    (tok : Token) = match(
      self.tokens.get(index),
      .None => exn.throw(dyn(make_parse_error_raw(self.module_path, `unexpected end of input`))),
      .Some(t) => t
    );
    if(tok.kind != TokenKind.LCurlyBracket, {
      exn.throw(dyn(make_parse_error(tok, `expected {`)));
    });
    args := ArrayList(AstExpr).new();
    (separator_is_comma : Option(bool)) = .None;
    idx := (index + usize(1));
    while(true, {
      idx = self.skip_ws_fwd(idx);
      (curr : Token) = match(
        self.tokens.get(idx),
        .None => exn.throw(dyn(make_parse_error(tok, `unexpected end of {...}`))),
        .Some(t) => t
      );
      cond(
        (curr.kind == TokenKind.Comma) => {
          separator_is_comma = match(
            separator_is_comma,
            .None => Option(bool).Some(true),
            .Some(__sb) => cond(
              __sb => Option(bool).Some(true),
              true => {
                exn.throw(dyn(make_parse_error(curr, `cannot mix , and ; in {...}`)));
                Option(bool).Some(false)
              }
            )
          );
          idx = (idx + usize(1));
        },
        (curr.kind == TokenKind.Semicolon) => {
          separator_is_comma = match(
            separator_is_comma,
            .None => Option(bool).Some(false),
            .Some(__sb) => cond(
              __sb => {
                exn.throw(dyn(make_parse_error(curr, `cannot mix ; and , in {...}`)));
                Option(bool).Some(true)
              },
              true => Option(bool).Some(false)
            )
          );
          idx = (idx + usize(1));
        },
        true => ()
      );
      idx = self.skip_ws_fwd(idx);
      (curr2 : Token) = match(
        self.tokens.get(idx),
        .None => exn.throw(dyn(make_parse_error(tok, `unexpected end of {...}`))),
        .Some(t) => t
      );
      if(curr2.kind == TokenKind.RCurlyBracket, {
        // Check if the last non-ws token before } was a `;` or `{` — if so, add trailing unit
        last_nws_idx := self.skip_ws_bwd(idx - usize(1));
        last_tok := match(
          self.tokens.get(last_nws_idx),
          .Some(t) => t,
          .None => Token(
            kind : TokenKind.LCurlyBracket,
            value : String.from("{"),
            row : usize(0),
            column : usize(0),
            character : usize(0),
            module_path : String.from(""),
            input : String.from("")
          )
        );
        is_semi := match(separator_is_comma, .None => false, .Some(__sb) => ((__sb) == false));
        if(is_semi && ((last_tok.kind == TokenKind.Semicolon) || (last_tok.kind == TokenKind.LCurlyBracket)), {
          unit_tok := Token(
            kind : TokenKind.Identifier,
            value : String.from(BK_TUPLE),
            row : last_tok.row,
            column : last_tok.column,
            character : last_tok.character,
            byte_offset : last_tok.byte_offset,
            module_path : last_tok.module_path,
            input : last_tok.input
          );
          args.push(.FnCall(self.alloc_id(), .Atom(self.alloc_id(), unit_tok), ArrayList(AstExpr).new(), false, unit_tok));
        });
        break;
      });
      arg_pr := self.parse_expression(idx, exn);
      args.push(arg_pr.expr);
      idx = arg_pr.index;
    });
    // No separator or comma separator -> anonymous struct; semicolon separator -> begin block.
    is_comma := match(
      separator_is_comma,
      .None => true,
      .Some(__sb) => __sb
    );
    cond(
      is_comma => {
        (vi : usize) = usize(0);
        vn := args.len();
        while(vi < vn, {
          match(
            args.get(vi),
            .None => (),
            .Some(arg) => {
              if(!(self.is_valid_struct_field_arg(arg)), {
                exn.throw(
                  dyn(
                    make_parse_error(
                      tok,
                      String.from(
                        "{ ... } without semicolons is parsed as a struct literal, not a block. To write a block, use semicolons: { stmt1; stmt2; }"
                      )
                    )
                  )
                );
              });
            }
          );
          vi = (vi + usize(1));
        });
        // Anonymous struct: { x, y: 2 } → _(x: x, y: 2)
        n_args := args.len();
        final_args := ArrayList(AstExpr).new();
        ai := usize(0);
        while(ai < n_args, {
          match(
            args.get(ai),
            .None => {
              break;
            },
            .Some(arg) => {
              (new_arg : AstExpr) = cond(
                ast_expr_is_atom(arg) => {
                  colon_tok := Token(
                    kind : TokenKind.Operator,
                    value : String.from(":"),
                    row : tok.row,
                    column : tok.column,
                    character : tok.character,
                    byte_offset : tok.byte_offset,
                    module_path : tok.module_path,
                    input : tok.input
                  );
                  arg_copy := match(args.get(ai), .Some(a) => a, .None => make_err_expr());
                  .FnCall(self.alloc_id(), .Atom(self.alloc_id(), colon_tok), array_list(arg, arg_copy), true, colon_tok)
                },
                true => arg
              );
              final_args.push(new_arg);
              ai = (ai + usize(1));
            }
          );
        });
        anon_tok := Token(
          kind : TokenKind.Identifier,
          value : String.from(BK_ANON_STRUCT),
          row : tok.row,
          column : tok.column,
          character : tok.character,
          byte_offset : tok.byte_offset,
          module_path : tok.module_path,
          input : tok.input
        );
        ParseResult(
          expr : .FnCall(self.alloc_id(), .Atom(self.alloc_id(), anon_tok), final_args, false, tok),
          index : (idx + usize(1))
        )
      },
      true => {
        // Begin block: begin(e1, e2, ...)
        begin_tok := Token(
          kind : TokenKind.Identifier,
          value : String.from(BK_BEGIN),
          row : tok.row,
          column : tok.column,
          character : tok.character,
          byte_offset : tok.byte_offset,
          module_path : tok.module_path,
          input : tok.input
        );
        ParseResult(
          expr : .FnCall(self.alloc_id(), .Atom(self.alloc_id(), begin_tok), args, false, begin_tok),
          index : (idx + usize(1))
        )
      }
    )
  }),
  parse_left_assoc_op : (
    fn(
      inout(self) : Self,
      primary : AstExpr,
      op_tok : Token,
      rhs : AstExpr,
      index : usize,
      exn : Exception
    ) -> ParseResult
  )({
    // Mirrors parser.ts:894-899 EXACTLY: rhs is a FnCall AND isInfix AND its
    // callee is an Atom whose token is NOT a Dot. No arg-count restriction
    // and no callee-token-kind restriction — TS has neither (same guard
    // pattern removed from the infix branch's rhs_is_chained_op).
    rhs_is_infix_non_dot := match(
      rhs,
      .FnCall(_, rfb, _, ris_infix, _) => cond(
        (ris_infix == false) => false,
        true => match(
          rfb,
          .Atom(_, ft) => (ft.kind != TokenKind.Dot),
          .FnCall(_, _, _, _, _) => false
        )
      ),
      .Atom(_, _) => false
    );
    if(rhs_is_infix_non_dot, {
      (left_operand : AstExpr) = match(
        rhs,
        .FnCall(_, _, rargs, _, _) => match(
          rargs.get(usize(0)),
          .Some(a) => a,
          .None => exn.throw(dyn(make_parse_error_raw(self.module_path, `internal: missing left arg in rhs`)))
        ),
        .Atom(_, _) => exn.throw(dyn(make_parse_error_raw(self.module_path, `internal: rhs is atom`)))
      );
      (right_operand : AstExpr) = match(
        rhs,
        .FnCall(_, _, rargs, _, _) => match(
          rargs.get(usize(1)),
          .Some(a) => a,
          .None => exn.throw(dyn(make_parse_error_raw(self.module_path, `internal: missing right arg in rhs`)))
        ),
        .Atom(_, _) => exn.throw(dyn(make_parse_error_raw(self.module_path, `internal: rhs is atom`)))
      );
      rhs_func_tok := match(
        rhs,
        .FnCall(_, rfb, _, _, _) => match(
          rfb,
          .Atom(_, ft) => ft,
          .FnCall(_, _, _, _, ft) => ft
        ),
        .Atom(_, t) => t
      );
      left_side_args := ArrayList(AstExpr).new();
      left_side_args.push(primary);
      left_side_args.push(left_operand);
      (left_side : AstExpr) = .FnCall(self.alloc_id(), .Atom(self.alloc_id(), op_tok), left_side_args, true, op_tok);
      new_args := ArrayList(AstExpr).new();
      new_args.push(left_side);
      new_args.push(right_operand);
      (new_primary : AstExpr) = .FnCall(self.alloc_id(), .Atom(self.alloc_id(), rhs_func_tok), new_args, true, rhs_func_tok);
      self.parse_primary_end(new_primary, index, exn)
    }, {
      simple_args := ArrayList(AstExpr).new();
      simple_args.push(primary);
      simple_args.push(rhs);
      self.parse_primary_end(.FnCall(self.alloc_id(), .Atom(self.alloc_id(), op_tok), simple_args, true, op_tok), index, exn)
    })
  }),
  parse_primary : (fn(inout(self) : Self, index : usize, exn : Exception) -> ParseResult)({
    idx := self.skip_ws_fwd(index);
    (tok : Token) = match(
      self.tokens.get(idx),
      .None => exn.throw(dyn(make_parse_error_raw(self.module_path, `unexpected end of input`))),
      .Some(t) => t
    );
    cond(
      // Atom kinds
      (((((((tok.kind == TokenKind.Identifier) || (tok.kind == TokenKind.Operator)) || (tok.kind == TokenKind.Bool)) || (tok.kind == TokenKind.Integer)) || (tok.kind == TokenKind.Float)) || (tok.kind == TokenKind.StringLit)) || (tok.kind == TokenKind.CharLit)) =>
        ParseResult(expr : .Atom(self.alloc_id(), tok), index : (idx + usize(1))),
      (tok.kind == TokenKind.LParen) => self.parse_paren_expr(idx, exn),
      (tok.kind == TokenKind.LBracket) => self.parse_array_expr(idx, exn),
      (tok.kind == TokenKind.LCurlyBracket) => self.parse_curly_bracket_expr(idx, exn),
      (tok.kind == TokenKind.Dot) => ParseResult(expr : .Atom(self.alloc_id(), tok), index : (idx + usize(1))),
      (tok.kind == TokenKind.TemplateString) => self.parse_template_string(tok, idx, exn),
      true => exn.throw(dyn(make_parse_error(tok, `unexpected token: ${tok.value}`)))
    )
  }),
  parse_primary_end : (
    fn(
      inout(self) : Self,
      primary_expr : AstExpr,
      index : usize,
      exn : Exception
    ) -> ParseResult
  )({
    orig_idx := index;
    next_idx := self.skip_ws_fwd(index);
    has_ws_fwd := (next_idx != index);
    prev_idx_for_ws := cond((index > usize(0)) => (index - usize(1)), true => usize(0));
    has_ws_bwd := match(
      self.tokens.get(prev_idx_for_ws),
      .Some(t) => (t.kind == TokenKind.Whitespace),
      .None => false
    );
    idx := next_idx;
    tok := match(
      self.tokens.get(idx),
      .Some(t) => t,
      .None => {
        return(ParseResult(expr : primary_expr, index : idx));
      }
    );
    // Terminators: stop parsing the current expression
    if(((((tok.kind == TokenKind.Semicolon) || (tok.kind == TokenKind.Comma)) || (tok.kind == TokenKind.RParen)) || (tok.kind == TokenKind.RBracket)) || (tok.kind == TokenKind.RCurlyBracket), {
      return(ParseResult(expr : primary_expr, index : idx));
    });
    primary_is_dot := match(
      primary_expr,
      .Atom(_, pt) => (pt.kind == TokenKind.Dot),
      .FnCall(_, _, _, _, _) => false
    );
    // Dot at start of new line (method chaining across lines)
    is_dot_at_line_start := cond(
      ((tok.kind == TokenKind.Dot) && has_ws_fwd) => {
        next_after_dot_kind := match(
          self.tokens.get(idx + usize(1)),
          .Some(t) => t.kind,
          .None => TokenKind.Whitespace
        );
        ((next_after_dot_kind != TokenKind.Whitespace) && self.range_has_newline(orig_idx, next_idx)) && self.is_op_at_line_start(idx)
      },
      true => false
    );
    // Immediate dot (no whitespace on either side)
    is_immediate_dot := (
      (tok.kind == TokenKind.Dot) && (
        (has_ws_fwd == false) && (
          (has_ws_bwd == false) && {
            next_after_dot_kind := match(
              self.tokens.get(idx + usize(1)),
              .Some(t) => t.kind,
              .None => TokenKind.Whitespace
            );
            next_after_dot_kind != TokenKind.Whitespace
          }
        )
      )
    );
    cond(
      // Dot: field access or enum variant
      ((primary_is_dot || is_dot_at_line_start) || is_immediate_dot) => {
        dot_tok := match(
          self.tokens.get(idx),
          .Some(t) => t,
          .None => Token(
            kind : TokenKind.Dot,
            value : String.from("."),
            row : usize(0),
            column : usize(0),
            character : usize(0),
            module_path : String.from(""),
            input : String.from("")
          )
        );
        rhs_start := cond(primary_is_dot => idx, true => (idx + usize(1)));
        rhs_pr := self.parse_primary(rhs_start, exn);
        rhs_expr := rhs_pr.expr;
        rhs_idx := rhs_pr.index;
        dot_fn_tok := cond(
          primary_is_dot =>
            match(primary_expr, .Atom(_, pt) => pt, .FnCall(_, _, _, _, pt) => pt),
          true => dot_tok
        );
        init_args := cond(
          primary_is_dot => array_list(rhs_expr),
          true => array_list(primary_expr, rhs_expr)
        );
        init_infix := (primary_is_dot == false);
        // Accumulate further immediate dot-chains (no whitespace)
        (cur_expr : AstExpr) = .FnCall(self.alloc_id(), .Atom(self.alloc_id(), dot_fn_tok), init_args, init_infix, dot_fn_tok);
        cur_idx := rhs_idx;
        while(true, {
          match(
            self.tokens.get(cur_idx),
            .None => {
              break;
            },
            .Some(next_dot) => {
              if(next_dot.kind != TokenKind.Dot, {
                break;
              });
              chain_pr := self.parse_primary(cur_idx + usize(1), exn);
              chain_args := array_list(cur_expr, chain_pr.expr);
              cur_expr = .FnCall(self.alloc_id(), .Atom(self.alloc_id(), dot_tok), chain_args, true, dot_tok);
              cur_idx = chain_pr.index;
            }
          );
        });
        recur(self, cur_expr, cur_idx, exn)
      },
      // Infix operator
      ((tok.kind == TokenKind.Operator) || ((tok.kind == TokenKind.Dot) && (has_ws_fwd == false))) => {
        rhs_start := self.skip_ws_fwd(idx + usize(1));
        rhs_pr := self.parse_expression(rhs_start, exn);
        rhs := rhs_pr.expr;
        rhs_end := rhs_pr.index;
        // Check if rhs is an infix (non-dot) expression
        // Check if the RHS is already an operator expression (chained
        // operators). Mirrors parser.ts:1083-1088 EXACTLY: rhs is a FnCall
        // AND isInfix AND its callee is an Atom whose token is NOT a Dot
        // (dot chains are allowed). No arg-count restriction and no
        // callee-token-kind restriction — TS has neither (a previous port
        // added `rargs.len() == 2` and `kind ∈ {Operator, Dot}` guards,
        // which silently ACCEPTED chains TS rejects).
        rhs_is_chained_op := match(
          rhs,
          .FnCall(_, rfb, _, ris_infix, _) => cond(
            (ris_infix == false) => false,
            true => match(
              rfb,
              .Atom(_, ft) => (ft.kind != TokenKind.Dot),
              .FnCall(_, _, _, _, _) => false
            )
          ),
          .Atom(_, _) => false
        );
        rhs_is_parenthesized := self.is_parenthesized_expr(rhs_start, rhs_end - usize(1));
        if(rhs_is_chained_op && (rhs_is_parenthesized == false), {
          // Stricter operator grouping (plans/archive/OPERATOR_ASSOCIATIVITY.md): a chain
          // of the SAME operator left-associates; adjacent DIFFERENT operators
          // require explicit parentheses. No precedence, no newline rule (source
          // layout no longer affects grouping).
          rhs_op_value := match(
            rhs,
            .FnCall(_, rfb2, _, _, _) => match(
              rfb2,
              .Atom(_, ft2) => ft2.value,
              .FnCall(_, _, _, _, _) => String.from("")
            ),
            .Atom(_, _) => String.from("")
          );
          cond(
            (tok.value == rhs_op_value) =>
              self.parse_left_assoc_op(primary_expr, tok, rhs, rhs_end, exn),
            true =>
              exn.throw(
                dyn(
                  make_parse_error(
                    tok,
                    `Adjacent different operators need parentheses to clarify grouping (near ${tok.value}).`
                  )
                )
              )
          )
        }, {
          rhs_args := ArrayList(AstExpr).new();
          rhs_args.push(primary_expr);
          rhs_args.push(rhs);
          recur(
            self,
            .FnCall(self.alloc_id(), .Atom(self.alloc_id(), tok), rhs_args, true, tok),
            rhs_end,
            exn
          )
        })
      },
      // Function call without whitespace: `func(arg1, arg2)`
      ((has_ws_fwd == false) && (tok.kind == TokenKind.LParen)) => {
        fn_pr := self.parse_fn_call(primary_expr, idx + usize(1), false, exn);
        recur(self, fn_pr.expr, fn_pr.index, exn)
      },
      ((has_ws_fwd == true) && (tok.kind == TokenKind.LParen)) => {
        exn.throw(dyn(make_parse_error(tok, `whitespace before '(' is not allowed in function calls`)));
        ParseResult(expr : primary_expr, index : idx)
      },
      true => {
        exn.throw(dyn(make_parse_error(tok, `paren-less function and operator calls are not supported; use parentheses`)));
        ParseResult(expr : primary_expr, index : idx)
      }
    )
  }),
  /// True if the token at `idx` can start a prefix operand (a primary or
  /// another prefix operator). Terminators/commas/infix-only operators
  /// return false, so `(!)` in `(not) :: (!)` stays an operator ATOM.
  token_starts_prefix_operand : (fn(inout(self) : Self, idx : usize) -> bool)(
    match(
      self.tokens.get(idx),
      .None => false,
      .Some(t) => cond(
        ((((((((((t.kind == TokenKind.Identifier) || (t.kind == TokenKind.Integer)) || (t.kind == TokenKind.Float)) || (t.kind == TokenKind.Bool)) || (t.kind == TokenKind.StringLit)) || (t.kind == TokenKind.CharLit)) || (t.kind == TokenKind.TemplateString)) || (t.kind == TokenKind.LParen)) || (t.kind == TokenKind.LBracket)) || ((t.kind == TokenKind.LCurlyBracket) || (t.kind == TokenKind.Dot))) => true,
        true => _is_prefix_op_token(t)
      )
    )
  ),
  /// Parse ONE prefix operand (plans/reference/PREFIX_OPERATOR_OPERAND_RULE.md
  /// Rule 1): a primary plus its TIGHT postfix ends (no-whitespace calls
  /// and immediate dot-chains) — never an infix chain, so `-a.b(c) + d`
  /// binds `a.b(c)` and `+ d` applies to the prefix result. A nested bare
  /// prefix operator recurses: `**i32` = `*(*(i32))`, `- -1` = `-(-(1))`.
  parse_prefix_operand : (fn(inout(self) : Self, index : usize, exn : Exception) -> ParseResult)({
    idx := self.skip_ws_fwd(index);
    pr := self.parse_primary(idx, exn);
    (cur_expr : AstExpr) = pr.expr;
    (cur_idx : usize) = pr.index;
    started_at_op := match(
      self.tokens.get(idx),
      .Some(t) => _is_prefix_op_token(t),
      .None => false
    );
    prim_is_op_atom := match(
      cur_expr,
      .Atom(_, at) => _is_prefix_op_token(at),
      .FnCall(_, _, _, _, _) => false
    );
    if(started_at_op && prim_is_op_atom, {
      // A no-whitespace `(` is the operator-CALL form — the postfix loop
      // below consumes it (`- -(1)` ends up identical either way).
      nxt_is_immediate_lparen := match(
        self.tokens.get(cur_idx),
        .Some(t) => (t.kind == TokenKind.LParen),
        .None => false
      );
      if(!(nxt_is_immediate_lparen) && self.token_starts_prefix_operand(self.skip_ws_fwd(cur_idx)), {
        op_tok := match(cur_expr, .Atom(_, at) => at, .FnCall(_, _, _, _, ft) => ft);
        inner := self.parse_prefix_operand(cur_idx, exn);
        cur_expr = .FnCall(self.alloc_id(), cur_expr, array_list(inner.expr), false, op_tok);
        cur_idx = inner.index;
      });
    });
    // Tight postfix ends: no-whitespace calls and immediate dot-chains.
    while(true, {
      t := match(
        self.tokens.get(cur_idx),
        .Some(x) => x,
        .None => {
          break;
        }
      );
      cond(
        (t.kind == TokenKind.LParen) => {
          fn_pr := self.parse_fn_call(cur_expr, cur_idx + usize(1), false, exn);
          cur_expr = fn_pr.expr;
          cur_idx = fn_pr.index;
        },
        (t.kind == TokenKind.Dot) => {
          nk := match(
            self.tokens.get(cur_idx + usize(1)),
            .Some(x) => x.kind,
            .None => TokenKind.Whitespace
          );
          if(nk == TokenKind.Whitespace, {
            break;
          });
          rhs_pr := self.parse_primary(cur_idx + usize(1), exn);
          cur_expr = .FnCall(self.alloc_id(), .Atom(self.alloc_id(), t), array_list(cur_expr, rhs_pr.expr), true, t);
          cur_idx = rhs_pr.index;
        },
        true => {
          break;
        }
      );
    });
    ParseResult(expr : cur_expr, index : cur_idx)
  }),
  parse_expression : (fn(inout(self) : Self, index : usize, exn : Exception) -> ParseResult)({
    idx := self.skip_ws_fwd(index);
    pr := self.parse_primary(idx, exn);
    // PREFIX_OPERATOR_OPERAND_RULE.md Rule 1: a BARE prefix-capable
    // operator atom followed by a primary-starter is a prefix CALL —
    // `-1`, `!x`, `?*T`, `3 - -3`. Bare = the primary began at the
    // operator token itself; a PARENTHESIZED operator atom (`(not) :: (!)`,
    // `(!) == y`) keeps today's meaning. The no-whitespace `(` form stays
    // the operator-call path in parse_primary_end (`-(a)`, multi-arg
    // `-(a, b)`).
    started_at_op := match(
      self.tokens.get(idx),
      .Some(t) => _is_prefix_op_token(t),
      .None => false
    );
    prim_is_op_atom := match(
      pr.expr,
      .Atom(_, at) => _is_prefix_op_token(at),
      .FnCall(_, _, _, _, _) => false
    );
    if(started_at_op && prim_is_op_atom, {
      immediate_lparen := match(
        self.tokens.get(pr.index),
        .Some(t) => (t.kind == TokenKind.LParen),
        .None => false
      );
      if(!(immediate_lparen) && self.token_starts_prefix_operand(self.skip_ws_fwd(pr.index)), {
        op_tok := match(pr.expr, .Atom(_, at) => at, .FnCall(_, _, _, _, ft) => ft);
        operand := self.parse_prefix_operand(pr.index, exn);
        return(self.parse_primary_end(.FnCall(self.alloc_id(), pr.expr, array_list(operand.expr), false, op_tok), operand.index, exn));
      });
    });
    self.parse_primary_end(pr.expr, pr.index, exn)
  }),
  do_parse : (fn(inout(self) : Self, exn : Exception) -> unit)({
    idx := usize(0);
    n := self.tokens.len();
    exprs := ArrayList(AstExpr).new();
    while(idx < n, {
      match(
        self.tokens.get(idx),
        .None => {
          break;
        },
        .Some(tok) => {
          is_skip := (((((((tok.kind == TokenKind.Whitespace) || (tok.kind == TokenKind.Semicolon)) || (tok.kind == TokenKind.SingleLineComment)) || (tok.kind == TokenKind.MultiLineComment)) || (tok.kind == TokenKind.DocLineComment)) || (tok.kind == TokenKind.InnerDocLineComment)) || ((tok.kind == TokenKind.DocBlockComment) || (tok.kind == TokenKind.InnerDocBlockComment)));
          if(is_skip, {
            idx = (idx + usize(1));
          }, {
            pr := self.parse_expression(idx, exn);
            exprs.push(pr.expr);
            idx = pr.index;
          });
        }
      );
    });
    // If last non-ws token is `;`, append trailing unit
    if(n > usize(0), {
      last_nws := self.skip_ws_bwd(n - usize(1));
      match(
        self.tokens.get(last_nws),
        .None => (),
        .Some(last_tok) => {
          if(last_tok.kind == TokenKind.Semicolon, {
            unit_tok := Token(
              kind : TokenKind.Identifier,
              value : String.from(BK_TUPLE),
              row : last_tok.row,
              column : last_tok.column,
              character : last_tok.character,
              byte_offset : last_tok.byte_offset,
              module_path : last_tok.module_path,
              input : last_tok.input
            );
            exprs.push(.FnCall(self.alloc_id(), .Atom(self.alloc_id(), unit_tok), ArrayList(AstExpr).new(), false, unit_tok));
          });
        }
      );
    });
    self.program = exprs;
  }),
  get_program : (fn(inout(self) : Self, exn : Exception) -> ArrayList(AstExpr))({
    self.do_parse(exn);
    if(self.has_template_string, {
      import_tok := Token(
        kind : TokenKind.Identifier,
        value : String.from(BK_IMPORT),
        row : usize(0),
        column : usize(0),
        character : usize(0),
        module_path : self.module_path,
        input : self.input_string
      );
      str_tok := Token(
        kind : TokenKind.StringLit,
        value : if(self.has_template_spec, String.from("\"std/fmt/format\""), String.from("\"std/fmt/to_string\"")),
        row : usize(0),
        column : usize(0),
        character : usize(0),
        module_path : self.module_path,
        input : self.input_string
      );
      (import_atom : AstExpr) = .Atom(self.alloc_id(), import_tok);
      (str_atom : AstExpr) = .Atom(self.alloc_id(), str_tok);
      (import_expr : AstExpr) = .FnCall(
        self.alloc_id(),
        import_atom,
        array_list(str_atom),
        false,
        import_tok
      );
      result := ArrayList(AstExpr).new();
      result.push(import_expr);
      i := usize(0);
      n := self.program.len();
      while(i < n, {
        match(
          self.program.get(i),
          .None => {
            break;
          },
          .Some(e) => {
            result.push(e);
            i = (i + usize(1));
          }
        );
      });
      return(result);
    });
    self.program
  })
);
/// Parse Yo source code and return the top-level expression list.
parse :: (
  fn(
    input_string : String,
    module_path : String,
    exn : Exception
  ) -> ArrayList(AstExpr)
)({
  p := Parser.new(input_string, module_path, exn);
  // Desugar `if(...)` calls to `cond(...)` on the fresh parse — every
  // consumer of `parse` (module loads, compile entries, the test runner)
  // gets a macro-head-free tree. The formatter does NOT go through here
  // (it works on the token stream), so `yo fmt` round-trips `if` intact.
  desugar_program_if_calls(p.get_program(exn))
});
/// Parse a single Yo expression from a code string and return it.
/// Expects exactly one expression in `code`.
/// Mirrors `generateExprFromCode` in `src/parser.ts`.
generate_expr_from_code :: (
  fn(
    code : String,
    exn : Exception
  ) -> AstExpr
)({
  module_path := `auto-generated://\n// === START auto-generated code ===\n${code}\n// === END auto-generated code ===\n`;
  exprs := parse(code.clone(), module_path, exn);
  n := exprs.len();
  cond(
    (n == usize(1)) => match(
      exprs.get(usize(0)),
      .Some(e) => e,
      .None => make_err_expr()
    ),
    true => {
      exn.throw(
        dyn(
          make_parse_error_raw(
            String.from(""),
            String.from("generate_expr_from_code: expected exactly 1 expression from parsed code, got: ") + n.to_string()
          )
        )
      );
      make_err_expr()
    }
  )
});
/// Parse all Yo expressions from a code string and return them.
/// Mirrors `generateExprsFromCode` in `src/parser.ts`.
generate_exprs_from_code :: (
  fn(
    code : String,
    exn : Exception
  ) -> ArrayList(AstExpr)
)({
  module_path := `auto-generated://\n// === START auto-generated code ===\n${code}\n// === END auto-generated code ===\n`;
  parse(code.clone(), module_path, exn)
});
export(ParseResult, FnArgsResult, Parser, parse);
export(extract_source_line, make_parse_error, make_parse_error_raw);
export(generate_expr_from_code, generate_exprs_from_code);
