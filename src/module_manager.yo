//! `module_manager.yo` — the shared "evaluate a `.yo` file and read its
//! exports" service. Port of `src/module-manager.ts`.
//!
//! TS's `ModuleManager` is what `build`, `fetch`, `install`, `doc`, the test
//! runner and codegen all import; the pattern at every one of those call sites
//! is the same three lines:
//!
//! ```ts
//! const moduleManager = new ModuleManager();
//! moduleManager.loadModule(modulePath);   // evaluate for its registry effects
//! moduleManager.resetAllState();
//! ```
//!
//! This module is the yo-self counterpart of exactly that. It owns the
//! demand-driven module loader (previously inline in `main.yo`), the cached
//! prelude environment, the shared codegen `ExprInfoTable`, and the std-path
//! resolution — so a subcommand that needs to evaluate a `.yo` file calls
//! `mm_load_yo_file` instead of growing its own half-copy of the loader.
//!
//! Structural note: TS keys its cache off the module path and stores per-module
//! annotations ON the AST node (`expr.$`), so its `ModuleManager` can hold a map
//! of live `Evaluator` instances. yo-self keys a SIDE table by expr id and holds
//! the module cache in `evaluator/module_loader.yo`, so the state that TS keeps
//! in instance fields lives here as module-level globals. The API is the same
//! service; the storage is not, and a literal port of the class would have been
//! wrong (plans/archive/P1_CLI_PARITY.md §7).
// `resolve_std_path` reads `YO_STD` through libc `getenv`, which needs a raw
// `*(char)` — same reason `main.yo` carries this pragma.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ Exception } :: import("std/error");
{ eprintln } :: import("std/fmt");
{ Path } :: import("std/path");
{ ArrayList } :: import("std/collections/array_list");
{ getenv } :: import("std/libc/stdlib");
{ current_exe, cwd } :: import("std/env");
{ record_input_file } :: import("./input_record.yo");
{ Instant } :: import("std/time/instant");
{ profile_record_module } :: import("./utils.yo");
{ AstExpr } :: import("./expr.yo");
{ ExprInfoTable } :: import("./expr_info.yo");
{ parse } :: import("./parser.yo");
{ Environment, clone_env, build_prelude_var_cache } :: import("./env.yo");
{ EvalContext, eval_context_new, LoadModuleResult } :: import("./evaluator/context.yo");
{ register_evaluate_expression, evaluator_deadline_tripped, evaluator_deadline_message } :: import("./evaluator/exprs/_expr.yo");
{ evaluate_anonymous_module_begin_exprs } :: import("./evaluator/values/anonymous_module.yo");
{
  resolve_module_path,
  resolve_module_path_ex,
  ModuleResolveResult,
  _build_module_val_from_env,
  set_import_root,
  set_import_unavailable,
  clear_import_roots
} :: import("./evaluator/exprs/import.yo");
{
  find_manifest,
  load_manifest,
  resolve_import_roots,
  read_lock_text,
  read_file_sync,
  file_exists_sync
} :: import("./manifest.yo");
{ clear_module_cache, module_cache_has, register_module, load_module_from_cache, register_loading, unregister_loading, loading_env, current_loading_module, record_import_edge, invalidate_module } :: import("./evaluator/module_loader.yo");
{ purge_type_trait_methods_owned_by } :: import("./evaluator/values/type_trait_methods.yo");
{ purge_generic_impls_owned_by } :: import("./evaluator/values/impl.yo");
{ EvalValue, type_of_eval_value } :: import("./value.yo");
{ TypeValue } :: import("./types/definitions.yo");
{ clear_type_display_names } :: import("./types/string.yo");
{ render_any_error, stash_error_diagnostics } :: import("./error.yo");
{ emit_rendered_text, emit_chatter } :: import("./diagnostics.yo");
// ---------------------------------------------------------------------------
// State
// ---------------------------------------------------------------------------
// Cached prelude env — populated on first load, reused thereafter.
(g_cached_prelude_env : Option(Environment)) = Option(Environment).None;
// Demand-driven module loader state (set per load run). The import handler
// `ctx.load_module` has a fixed `(path) -> LoadModuleResult` signature with no
// `exn`, so the loading context is stashed here for the on-demand load
// path. This enables CIRCULAR imports: a module is registered as "loading"
// (with its live env) before its body runs, so a cyclic import reads its
// partial exports instead of failing "module not preloaded".
(g_loader_std_path : Option(String)) = Option(String).None;
(g_loader_exn : Option(Exception)) = Option(Exception).None;
// Shared ExprInfoTable for codegen: when set (during `compile`), every
// demand-loaded module's eval context writes its per-expression metadata into
// THIS one table instead of a fresh per-module table. Codegen emits the bodies
// of functions collected across ALL modules (e.g. std `println`/`to_string`),
// so their ExprInfo must live in a single table. ExprIds are globally unique
// (alloc_global_expr_id), so a shared table has no cross-module key collisions.
// `.None` during `check`/`test` (each file keeps its own table).
(g_shared_expr_info_table : Option(ExprInfoTable)) = Option(ExprInfoTable).None;
/// Message slot for a module-eval error captured inside
/// `_eval_module_exprs_capturing_error`'s handler. Handlers cannot reference
/// outer runtime variables, but they CAN call module-level FUNCTIONS — so the
/// handler stashes the message here and the loader takes it after the unwind,
/// surfacing it as `LoadModuleResult.module_error`. That routes a failed
/// `import("…")` back through the CALLER's exn at the import site
/// (`evaluate_import` rethrows `module_error`), where `comptime_expect_error`
/// can catch it — TS parity: a module whose top-level eval throws inside
/// `comptime_expect_error(import("…"))` is an EXPECTED error, not a
/// driver-fatal one (tests/circular_import.test.yo's circular_error fixture).
(g_load_module_error : Option(String)) = Option(String).None;
/// Outcome of evaluating one `.yo` file: `ok` plus the module value/type when
/// the evaluation succeeded. This is yo-self's `{ moduleValue, moduleError }`.
///
/// `env` and `ctx` are carried too. TS keeps the live `Evaluator` in
/// `ModuleManager.modules`, and `doc-command.ts` reaches through it for the
/// module's environment; codegen needs both. Dropping them here would force
/// every such caller to re-run the load with its own copy of the loader setup.
ModuleLoadOutcome :: struct(
  ok : bool,
  module_value : EvalValue,
  module_type : TypeValue,
  env : Environment,
  ctx : EvalContext
);
/// A not-ok outcome with throwaway env/ctx. Written as a FUNCTION because an
/// effect handler cannot reference outer runtime variables but CAN call a
/// module-level function — `mm_load_file`'s handler needs to unwind one of
/// these.
_failed_outcome :: (fn() -> ModuleLoadOutcome)(
  ModuleLoadOutcome(
    ok : false,
    module_value : EvalValue.UnitVal,
    module_type : TypeValue.Unit,
    env : Environment.new(String.from("")),
    ctx : eval_context_new(String.from(""), String.from(""))
  )
);
// ---------------------------------------------------------------------------
// std path resolution — TS `findStdDirectory` / `ModuleManager.stdPath`
// ---------------------------------------------------------------------------
/// The `--std-path` CLI override (highest-precedence std root). `main.yo`
/// strips the flag from argv before subcommand dispatch and stashes the
/// value here — the TS counterpart is the root-level yargs option +
/// `setStdPathOverride` middleware in `yo-cli.ts`.
(g_std_path_override : Option(String)) = Option(String).None;
set_std_path_override :: (fn(path : String) -> unit)({
  g_std_path_override = Option(String).Some(path);
});
/// The stashed `--std-path` override, if any. `build_runner.yo` forwards it
/// to child `compile`/`test` processes — TS needs no equivalent because its
/// build runner compiles artifacts in-process, where the override already
/// applies.
get_std_path_override :: (fn() -> Option(String))({
  return(g_std_path_override.clone());
});
/// Resolve the standard-library root. The proper evaluator needs this so
/// `import("std/...")` can be satisfied — without it, the prelude cannot be
/// loaded and the majority of user code references (`Option`, `Box`, `+`, …)
/// fail with "Variable not found".
///
/// Canonicalize a std-directory spelling: absolute (against the cwd when
/// relative), separators normalized, `.`/`..` folded LEXICALLY. The resolved
/// std path feeds module paths, which feed TYPE KEYS and mangled C names —
/// two spellings of one directory (`YO_STD=<abs>` vs `--std-path ./std`)
/// otherwise produce different emitted C, so any two-stage comparison whose
/// stages resolve std differently (a local bootstrap fixpoint: stage-1 via
/// exe-walk-up, stage-3 via the ./std fallback) false-fails on ~19k lines of
/// `__yo_tN` renumbering churn
/// (issues/fixpoint-gate-std-path-spelling-changes-type-keys.md). Lexical
/// only — no symlink resolution: this is sync and runs inside the module
/// loader. Falls back to the raw spelling when the cwd is unobtainable.
_std_canonicalize :: (fn(p : String) -> String)({
  path := Path.new(p.clone());
  if(!path.is_absolute(), {
    match(
      cwd(),
      .Ok(base) => {
        path = base.join(path);
      },
      .Err(_) => ()
    );
  });
  path.normalize().to_string()
});
/// Lookup order (mirrors TS `module-manager.ts` `findStdDirectory`):
///   1. The `--std-path` CLI flag (stashed via `set_std_path_override`).
///   2. `YO_STD` env var, if set and non-empty.
///   3. A `std` directory next to — or in any ancestor of — the running
///      executable's directory. This is what makes an installed release
///      bundle (`<prefix>/bin/yo` + `<prefix>/std`) self-locating.
///   4. `./std` relative to the current working directory (repo dev flow).
///
/// Every branch returns the CANONICALIZED spelling (see `_std_canonicalize`)
/// so the resolution route never leaks into module paths or emitted C.
resolve_std_path :: (fn() -> String)({
  match(
    g_std_path_override,
    .Some(p) => {
      return(_std_canonicalize(p.clone()));
    },
    .None => {}
  );
  name_cstr := String.from("YO_STD").to_cstr().ptr().unwrap();
  val_ptr := unsafe(getenv((*char)(name_cstr)));
  match(
    val_ptr,
    .None => {},
    .Some(ptr) => {
      v := String.from_cstr((*u8)(ptr)).unwrap();
      if(v.len() > usize(0), {
        return(_std_canonicalize(v));
      });
    }
  );
  match(
    current_exe(),
    .Err(_) => {},
    .Ok(exe_path) => {
      dir := exe_path.parent();
      while(dir.is_some(), {
        d := dir.unwrap();
        candidate := d.join(Path.new(String.from("std")));
        if(file_exists_sync(candidate.to_string()), {
          return(_std_canonicalize(candidate.to_string()));
        });
        dir = d.parent();
      });
    }
  );
  _std_canonicalize(String.from("./std"))
});
// ---------------------------------------------------------------------------
// State accessors (main.yo's compile path drives these directly)
// ---------------------------------------------------------------------------
/// Stash the std-path / exn the demand loader will use for nested imports.
mm_set_loader_context :: (
  fn(
    std_path : String,
    exn : Exception
  ) -> unit
)({
  g_loader_std_path = Option(String).Some(std_path);
  g_loader_exn = Option(Exception).Some(exn);
});
mm_prelude_env :: (fn() -> Option(Environment))(g_cached_prelude_env);
mm_has_prelude_env :: (fn() -> bool)(!g_cached_prelude_env.is_none());
mm_clear_prelude_env :: (fn() -> unit)({
  g_cached_prelude_env = Option(Environment).None;
});
/// Publish the shared codegen ExprInfoTable. Every module loaded from here on
/// routes its per-expression metadata into `t`.
mm_set_shared_expr_info_table :: (fn(t : ExprInfoTable) -> unit)({
  g_shared_expr_info_table = Option(ExprInfoTable).Some(t);
});
mm_shared_expr_info_table :: (fn() -> Option(ExprInfoTable))(
  g_shared_expr_info_table
);
/// Clone the cached prelude env, or start a fresh one keyed on `module_path`
/// when no prelude has been loaded yet.
mm_fresh_module_env :: (fn(module_path : String) -> Environment)({
  env := clone_env(
    match(g_cached_prelude_env, .Some(pe) => pe, .None => Environment.new(module_path.clone()))
  );
  env.module_path = module_path;
  env
});
/// Resolve `input_path` (as written on the command line) to the `file://`
/// absolute path `evaluate_import` would compute for the same module, so cache
/// keys agree.
mm_resolve_entry_abs :: (fn(input_path : String, std_path : String) -> String)(
  match(
    // `false`: the entry is a FILE PATH, so the manifest's import-root names
    // must not rewrite it (issues/fixed/entry-path-shadowed-by-an-import-root-name.md).
    resolve_module_path_ex(input_path.clone(), String.from("."), std_path, false),
    .Found(p) => p,
    .NotFound(_) => input_path.clone(),
    .Ambiguous(_) => input_path.clone(),
    .Unavailable(_, _) => input_path
  )
);
// Open-document text overlay (Phase B1): the LSP holds newer text for open
// buffers than the disk does. `_load_module_at_abs` consults this AFTER its
// disk read, so an importing document's analysis sees the editor's version
// of an imported file, saved or not. Parallel arrays, keyed by FS path.
(g_open_doc_paths : ArrayList(String)) = ArrayList(String).new();
(g_open_doc_texts : ArrayList(String)) = ArrayList(String).new();
_open_doc_index :: (fn(fs_path : String) -> Option(usize))({
  (i : usize) = usize(0);
  n := g_open_doc_paths.len();
  while(i < n, {
    match(
      g_open_doc_paths.get(i),
      .Some(p) => if(p == fs_path, {
        return(Option(usize).Some(i));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  Option(usize).None
});
/// Record (or replace) the open-buffer text for `fs_path`.
mm_set_open_document :: (fn(fs_path : String, text : String) -> unit)({
  match(
    _open_doc_index(fs_path.clone()),
    .Some(i) => {
      g_open_doc_texts(i) = text;
    },
    .None => {
      g_open_doc_paths.push(fs_path);
      g_open_doc_texts.push(text);
    }
  );
});
/// Drop the overlay for `fs_path` (didClose — disk becomes the truth again).
mm_forget_open_document :: (fn(fs_path : String) -> unit)({
  match(
    _open_doc_index(fs_path.clone()),
    .Some(i) => {
      g_open_doc_paths.drain(i .. (i + usize(1)));
      g_open_doc_texts.drain(i .. (i + usize(1)));
    },
    .None => ()
  );
});
_open_doc_text :: (fn(fs_path : String) -> Option(String))(
  match(
    _open_doc_index(fs_path.clone()),
    .Some(i) => g_open_doc_texts.get(i),
    .None => Option(String).None
  )
);
/// The current source text of the module at filesystem path `fs_path`: the
/// open-buffer overlay when the editor holds it, else the file on disk;
/// `.None` when neither exists. The LSP reads a definition target's text
/// through this to convert its columns to the wire encoding — the target is
/// usually an IMPORTED file the server has no `DocState` for.
mm_module_source :: (fn(fs_path : String) -> Option(String))({
  match(
    _open_doc_text(fs_path.clone()),
    .Some(t) => {
      return(Option(String).Some(t));
    },
    .None => ()
  );
  read_exn := Exception(
    throw : (
      _err -> unwind(Option(String).None)
    )
  );
  Option(String).Some(String.from_bytes(read_file_sync(fs_path, read_exn)))
});
/// LSP invalidation entry (Phase B1, plans/reference/INCREMENTAL_COMPILATION.md):
/// drop the module cached for this FILESYSTEM path and every transitive
/// dependent, so the next analysis of any document re-evaluates exactly the
/// stale part of its import closure. Returns the removed `file://` paths
/// (Phase B2's registry purge consumes this). The cached prelude env is NOT
/// touched — editing std/prelude.yo still needs a server restart.
mm_invalidate_document :: (fn(fs_path : String) -> ArrayList(String))({
  removed := invalidate_module(`file://${fs_path}`);
  // Phase B2: each removed module's registry entries go with it — its
  // re-evaluation re-registers them (under fresh type ids). Without this,
  // every LSP edit leaked a registry generation, and stale generic-impl
  // entries lengthened every candidate scan.
  (i : usize) = usize(0);
  while(i < removed.len(), {
    match(
      removed.get(i),
      .Some(owner) => {
        purge_type_trait_methods_owned_by(owner.clone());
        purge_generic_impls_owned_by(owner);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  removed
});
/// TS `ModuleManager.resetAllState()`. Drops the module cache, the cached
/// prelude env, the shared ExprInfoTable and the loader context, so the next
/// load starts from a clean evaluator universe.
mm_reset :: (fn() -> unit)({
  clear_module_cache();
  clear_type_display_names();
  g_cached_prelude_env = Option(Environment).None;
  g_shared_expr_info_table = Option(ExprInfoTable).None;
  g_loader_std_path = Option(String).None;
  g_loader_exn = Option(Exception).None;
  g_load_module_error = Option(String).None;
});
/// The `--imports <file>` mapping (global flag, stripped by main.yo like
/// `--std-path`): one `name=/abs/root.yo` per line, `#` comments allowed. The
/// build runner writes it per artifact; the child compile loads it into the
/// evaluator's import-root table on the first module load
/// (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.5.1). Per-process
/// configuration — `mm_reset` leaves it alone.
(g_imports_file_override : Option(String)) = Option(String).None;
(g_imports_file_loaded : bool) = false;
set_imports_file_override :: (fn(path : String) -> unit)({
  g_imports_file_override = Option(String).Some(path);
  g_imports_file_loaded = false;
});
get_imports_file_override :: (fn() -> Option(String))(g_imports_file_override.clone());
/// Load the `--imports` mapping once. A relative root is absolutized against
/// the process cwd (the runner writes absolute paths; the flag is usable by
/// hand too). Malformed lines (no `=`, empty name or root) are errors — the
/// file is machine-written, so a bad line means a bug, not a typo.
_load_imports_file :: (fn(exn : Exception) -> unit)({
  if(g_imports_file_loaded, {
    return(());
  });
  g_imports_file_loaded = true;
  match(
    g_imports_file_override,
    .None => (),
    .Some(p) => {
      text := String.from_bytes(read_file_sync(p.clone(), exn));
      clear_import_roots();
      cwd_str := match(cwd(), .Ok(c) => c.to_string(), .Err(_) => String.from("."));
      lines := text.split("\n");
      (i : usize) = usize(0);
      while(i < lines.len(), {
        line := lines(i).trim();
        if(!((line.len() == usize(0)) || line.starts_with(String.from("#"))), {
          match(
            line.index_of("="),
            .None => {
              exn.throw(dyn(`--imports ${p}: line ${(i + usize(1)).to_string()} is not "name=/path/to/root.yo": ${line}`));
            },
            .Some(k) => {
              name := line.substring(usize(0), k).trim();
              root := line.substring(k + usize(1), line.len()).trim();
              if((name.len() == usize(0)) || (root.len() == usize(0)), {
                exn.throw(dyn(`--imports ${p}: line ${(i + usize(1)).to_string()} has an empty name or root: ${line}`));
              });
              abs_root := if(
                Path.new(root.clone()).is_absolute(),
                root,
                Path.new(cwd_str.clone()).join(Path.new(root)).normalize().to_string()
              );
              set_import_root(name, abs_root);
            }
          );
        });
        i = (i + usize(1));
      });
    }
  );
});
/// The manifest whose import-root closure is registered: its path, or "" when
/// the last entry had none above it. One process serves many entries (`check
/// ./src`, the test runner's batches, an LSP session) that share a manifest,
/// so the closure is computed once per manifest.
(g_manifest_roots_for : Option(String)) = Option(String).None;
/// Register the `import("name")` roots of the project the entry file `fs_path`
/// belongs to (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.5.1): the
/// nearest `yo.toml` at or above its directory, resolved by
/// `manifest.resolve_import_roots` — so `compile`, `check`, `test`, `doc` and
/// the LSP resolve dependency imports without a build. The build runner's
/// `--imports` file is the explicit, complete mapping for an artifact; when
/// it is set, discovery is skipped. A malformed manifest is an error here —
/// it is a compile error of the entry, reported once by the owning edge.
_register_manifest_import_roots :: (fn(fs_path : String, exn : Exception) -> unit)({
  if(g_imports_file_override.is_some(), {
    return(());
  });
  entry_dir := match(
    Path.new(fs_path.clone()).parent(),
    .Some(p) => {
      ps := p.to_string();
      if(ps.len() == usize(0), String.from("."), ps)
    },
    .None => String.from(".")
  );
  found := find_manifest(entry_dir);
  key := match(found, .Some(p) => p, .None => String.new());
  match(
    g_manifest_roots_for,
    .Some(k) => if(k == key, {
      return(());
    }),
    .None => ()
  );
  g_manifest_roots_for = Option(String).Some(key.clone());
  clear_import_roots();
  match(
    found,
    .None => (),
    .Some(manifest_path) => {
      manifest := match(
        load_manifest(manifest_path.clone(), exn),
        .Ok(m) => m,
        .Err(msg) => {
          // Forget the failed registration so a corrected manifest is re-read.
          g_manifest_roots_for = Option(String).None;
          exn.throw(dyn(msg));
          load_manifest(manifest_path, exn).unwrap()
        }
      );
      roots := match(
        resolve_import_roots(manifest, read_lock_text(manifest, exn), exn),
        .Ok(r) => r,
        .Err(msg) => {
          g_manifest_roots_for = Option(String).None;
          exn.throw(dyn(`${manifest.path}: ${msg}`));
          resolve_import_roots(manifest, Option(String).None, exn).unwrap()
        }
      );
      (i : usize) = usize(0);
      while(i < roots.roots.len(), {
        set_import_root(roots.roots(i).name.clone(), roots.roots(i).root.clone());
        i = (i + usize(1));
      });
      (u : usize) = usize(0);
      while(u < roots.unavailable.len(), {
        set_import_unavailable(roots.unavailable(u).name.clone(), roots.unavailable(u).reason.clone());
        u = (u + usize(1));
      });
    }
  );
});
// ---------------------------------------------------------------------------
// The demand loader
// ---------------------------------------------------------------------------
_stash_load_error :: (fn(msg : String) -> unit)({
  g_load_module_error = Option(String).Some(msg);
});
_take_load_error :: (fn() -> Option(String))({
  r := g_load_module_error;
  g_load_module_error = Option(String).None;
  r
});
/// Evaluate a module's top-level exprs, catching any evaluator error locally so
/// the caller can unregister the currently-loading entry before re-throwing.
/// Success: pushes the module value to `out`. Failure: the handler STASHES the
/// rendered diagnostic (handlers cannot capture outer runtime vars, so a module
/// global is the channel) and unwinds — `out` stays empty, which is the
/// caller's signal. The owning CLI edge then prints it exactly once (the P1
/// single-print rule, plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md D2): `check` via
/// `check_single_file`, watch rounds in `check_watch.yo`, `compile` by
/// re-throwing the stash, the LSP by parsing it into diagnostics.
_eval_module_exprs_capturing_error :: (
  fn(
    mod_exprs : ArrayList(AstExpr),
    env : Environment,
    ctx : EvalContext,
    out : ArrayList(EvalValue),
    out_tys : ArrayList(TypeValue)
  ) -> bool
)({
  local_exn := Exception(
    throw : (
      err -> {
        _stash_load_error(render_any_error(err));
        stash_error_diagnostics(err);
        unwind(false)
      }
    )
  );
  result := evaluate_anonymous_module_begin_exprs(mod_exprs, env, ctx, false, false, true, local_exn);
  out.push(result.module_value);
  out_tys.push(result.module_type);
  true
});
export(_eval_module_exprs_capturing_error, _take_load_error);
/// Profiling nesting accumulator (Phase 0): total wall nanos of demand loads
/// completed inside the CURRENTLY OPEN module-evaluation window. Each window
/// zeroes it on entry, subtracts it from its own wall (→ exclusive row) and
/// hands its parent (saved + own total) on the way out. Unconditionally
/// maintained — the arithmetic is free — while `profile_record_module` itself
/// no-ops unless profiling is armed.
(g_prof_child_load_ns : i64) = i64(0);
/// Read + parse + evaluate the module at resolved abs `file://` path `abs` and
/// register its exports. Registers it as "loading" (with its live env) BEFORE
/// evaluating, so a circular import resolves to its partial exports. Uses the
/// loader io / std_path / exn stashed by `mm_set_loader_context`. Returns
/// `.Some(error)` when the module's top-level evaluation failed — the caller
/// (`demand_load_module`) surfaces it as `LoadModuleResult.module_error` so the
/// error rethrows through the IMPORT SITE's exn (catchable by
/// `comptime_expect_error`), instead of unwinding the stashed driver exn.
_load_module_at_abs :: (fn(abs : String) -> Option(String))({
  if(abs.ends_with(String.from("prelude.yo")), {
    return(Option(String).None);
  });
  if(module_cache_has(abs.clone()), {
    return(Option(String).None);
  });
  std_path := match(g_loader_std_path, .Some(s) => s, .None => String.from(""));
  exn := match(g_loader_exn, .Some(e) => e, .None => return(Option(String).None));
  fs_path := abs.replace(String.from("file://"), String.new());
  // Phase 0: this load's read+parse / evaluation walls. `prof_t0` spans the
  // WHOLE load so the parent window subtracts the load's true total.
  prof_t0 := Instant.now();
  // COMPTIME read — synchronous on purpose (see manifest.yo `read_file_sync`): the demand
  // loader runs inside the evaluator's comptime import resolution, where the
  // async read's blocking poll loop would nest the event loop (C37/C42).
  record_input_file(fs_path.clone());
  src_bytes := read_file_sync(fs_path.clone(), exn);
  (src : String) = String.from_bytes(src_bytes);
  // Open-buffer overlay (Phase B1): the editor's text wins over the disk
  // read above. The read still ALWAYS runs — it is a plain synchronous
  // statement (no async-lowering shape to respect), and import resolution
  // requires the file to exist on disk anyway.
  match(
    _open_doc_text(fs_path.clone()),
    .Some(open_text) => {
      src = open_text.clone();
    },
    .None => ()
  );
  mod_exprs := parse(src, abs.clone(), exn);
  (prof_parse_ns : i64) = prof_t0.elapsed().as_nanos();
  prof_eval_t0 := Instant.now();
  (prof_saved_child : i64) = g_prof_child_load_ns;
  g_prof_child_load_ns = i64(0);
  env := mm_fresh_module_env(abs.clone());
  ctx := eval_context_new(std_path.clone(), abs.clone());
  ctx.is_executing = true;
  ctx.load_module = Option((fn(path : String) -> LoadModuleResult)).Some(demand_load_module);
  // Codegen: route this module's per-expression metadata into the shared table
  // (see g_shared_expr_info_table). No-op during check/test.
  match(
    g_shared_expr_info_table,
    .Some(t) => {
      ctx.expr_info_table = t;
    },
    .None => ()
  );
  register_evaluate_expression();
  register_loading(abs.clone(), env);
  out_vals := ArrayList(EvalValue).new();
  out_tys := ArrayList(TypeValue).new();
  _eval_module_exprs_capturing_error(mod_exprs, env, ctx, out_vals, out_tys);
  // ALWAYS unregister — a leaked currently-loading entry poisons every
  // LATER check that imports this module: `demand_load_module` then
  // returns partial exports from the dead env (hangs/crashes; see
  // issues/fixed/yo-self-dir-check-state-corruption-after-failure.md).
  unregister_loading(abs.clone());
  // Phase 0: exclusive evaluation wall (this module's own work, minus the
  // demand loads it triggered), then hand the parent this load's total.
  (prof_eval_ns : i64) = (prof_eval_t0.elapsed().as_nanos() - g_prof_child_load_ns);
  g_prof_child_load_ns = (prof_saved_child + prof_t0.elapsed().as_nanos());
  profile_record_module(fs_path.clone(), prof_parse_ns, prof_eval_ns);
  match(
    out_vals.get(usize(0)),
    .Some(mv) => {
      reg_ty := match(out_tys.get(usize(0)), .Some(t) => t, .None => TypeValue.Unit);
      register_module(abs.clone(), mv, reg_ty);
      Option(String).None
    },
    // Root-cause detail printed by the helper's handler (and stashed).
    // RETURN the error instead of throwing the stashed driver exn: the
    // import site rethrows it through its own exn, so an import inside
    // `comptime_expect_error` is caught as the EXPECTED error.
    .None => Option(String).Some(
      match(
        _take_load_error(),
        .Some(m) => m,
        .None => `Failed to evaluate module "${abs}"`
      )
    )
  )
});
/// Demand-driven `ctx.load_module`. `path` is the resolved `file://` abs path
/// computed by `evaluate_import`. Cache hit -> cached exports; currently-loading
/// (cycle) -> partial exports from the module's live env; else load on demand.
demand_load_module :: (fn(path : String) -> LoadModuleResult)({
  // Import-graph edge: whoever is mid-evaluation (loading-stack top) depends
  // on `path`. Recorded on EVERY request — a cache hit is still a dependency
  // — so `invalidate_module` can walk dependents. Phase B1,
  // plans/reference/INCREMENTAL_COMPILATION.md.
  match(
    current_loading_module(),
    .Some(importer) => record_import_edge(importer, path.clone()),
    .None => ()
  );
  if(module_cache_has(path.clone()), {
    return(load_module_from_cache(path));
  });
  match(
    loading_env(path.clone()),
    .Some(env) => {
      return(
        LoadModuleResult(
          module_value : _build_module_val_from_env(env),
          module_type : TypeValue.Unit,
          module_error : Option(String).None
        )
      );
    },
    .None => ()
  );
  match(
    _load_module_at_abs(path.clone()),
    .Some(load_err) => {
      return(
        LoadModuleResult(
          module_value : EvalValue.UnitVal,
          module_type : TypeValue.Unit,
          module_error : Option(String).Some(load_err)
        )
      );
    },
    .None => ()
  );
  load_module_from_cache(path)
});
/// The demand loader, for assigning to `ctx.load_module`. Sits AFTER
/// `demand_load_module` on purpose: forcing the loader from higher up would
/// trial-evaluate the helpers it calls before the runtime globals they read
/// (`g_open_doc_paths`, …) are bound — the E0906 ordered-statement rule.
mm_demand_loader :: (fn() -> Option((fn(path : String) -> LoadModuleResult)))(
  Option((fn(path : String) -> LoadModuleResult)).Some(demand_load_module)
);
// ---------------------------------------------------------------------------
// Loading a file
// ---------------------------------------------------------------------------
/// Evaluate `std/prelude.yo` and cache the resulting env. The prelude is
/// injected (cloned) into every other file's env, so it is never routed through
/// the module loader.
///
/// Populate-once: REPLACING an existing cached env — e.g. when a directory
/// sweep reaches `std/prelude.yo` as a target AFTER a pre-load — forks the type
/// universe. Every later file clones the NEW prelude (fresh FuncVal/trait ids)
/// while demand-loaded modules stay cached from the OLD lineage, so an id-keyed
/// check like `K <: Eq(K)` mints a trait no registered impl can match ("Type
/// String does not implement required trait ...").
mm_load_prelude_file :: (
  fn(
    input_path : String,
    std_path : String,
    exprs : ArrayList(AstExpr),
    local_exn : Exception
  ) -> bool
)({
  prelude_env := Environment.new(input_path.clone());
  prelude_ctx := eval_context_new(std_path.clone(), input_path.clone());
  prelude_ctx.is_executing = true;
  // Route the prelude's per-expression metadata into the shared codegen table
  // when set (compile path), so codegen finds the body ExprInfo of prelude
  // functions emitted directly (e.g. `assert`). No-op for `check`/`test`
  // (g_shared is None there → the prelude uses its own throwaway table).
  match(
    g_shared_expr_info_table,
    .Some(t) => {
      prelude_ctx.expr_info_table = t;
    },
    .None => ()
  );
  register_evaluate_expression();
  // Phase 0: the prelude's evaluation window (its read+parse belongs to the
  // caller that owns the parse step). Exclusive like every other module row.
  prof_t0 := Instant.now();
  g_prof_child_load_ns = i64(0);
  // keep_frame_at_end=true so the prelude's bindings survive into the cached
  // env (see issues/yo-self-multi-file-prelude-bindings.md).
  _rp := evaluate_anonymous_module_begin_exprs(
    exprs,
    prelude_env,
    prelude_ctx,
    false,
    true,
    true,
    local_exn
  );
  profile_record_module(
    mm_resolve_entry_abs(input_path.clone(), std_path.clone()).replace(
      String.from("file://"),
      String.new()
    ),
    i64(0),
    prof_t0.elapsed().as_nanos() - g_prof_child_load_ns
  );
  if(g_cached_prelude_env.is_none(), {
    g_cached_prelude_env = Option(Environment).Some(prelude_env);
  });
  true
});
/// Evaluate the already-parsed top-level `exprs` of the entry module at
/// `entry_abs`, with the demand loader wired in. Shared by every caller that
/// has its own parse step (`check`, `compile`, and the library front doors).
mm_eval_entry_exprs :: (
  fn(
    entry_abs : String,
    std_path : String,
    exprs : ArrayList(AstExpr),
    exn : Exception
  ) -> ModuleLoadOutcome
)({
  mm_set_loader_context(std_path.clone(), exn);
  _load_imports_file(exn);
  _register_manifest_import_roots(entry_abs.replace(String.from("file://"), String.new()), exn);
  env := mm_fresh_module_env(entry_abs.clone());
  ctx := eval_context_new(std_path.clone(), entry_abs.clone());
  ctx.is_executing = true;
  ctx.load_module = Option((fn(path : String) -> LoadModuleResult)).Some(demand_load_module);
  match(
    g_shared_expr_info_table,
    .Some(t) => {
      ctx.expr_info_table = t;
    },
    .None => ()
  );
  register_evaluate_expression();
  // Phase 0: the entry module's own evaluation window. Its read+parse is the
  // DRIVER's phase (it owns the parse step); this row carries evaluation only,
  // exclusive of the demand loads it triggers (which record their own rows).
  prof_t0 := Instant.now();
  g_prof_child_load_ns = i64(0);
  register_loading(entry_abs.clone(), env);
  out_vals := ArrayList(EvalValue).new();
  out_tys := ArrayList(TypeValue).new();
  _eval_module_exprs_capturing_error(exprs, env, ctx, out_vals, out_tys);
  profile_record_module(
    entry_abs.clone().replace(String.from("file://"), String.new()),
    i64(0),
    prof_t0.elapsed().as_nanos() - g_prof_child_load_ns
  );
  // ALWAYS unregister, error or not — a leaked currently-loading entry poisons
  // every LATER file in a directory check (see
  // issues/fixed/yo-self-dir-check-state-corruption-after-failure.md).
  unregister_loading(entry_abs.clone());
  match(
    out_vals.get(usize(0)),
    .Some(mv) => ModuleLoadOutcome(
      ok : true,
      module_value : mv,
      module_type : match(out_tys.get(usize(0)), .Some(t) => t, .None => TypeValue.Unit),
      env : env,
      ctx : ctx
    ),
    // Not ok, but with the REAL env/ctx: the evaluation stopped at its first
    // error, and everything it recorded before that — the ExprInfo of every
    // expression it did reach — lives in `ctx.expr_info_table`. The LSP
    // serves hover/completion/signature help from that table while the
    // document has an error (issues/fixed/lsp-analysis-state-lost-on-parse-and-eval-errors.md);
    // `check`/`build` read only `ok` on this path.
    .None => ModuleLoadOutcome(
      ok : false,
      module_value : EvalValue.UnitVal,
      module_type : TypeValue.Unit,
      env : env,
      ctx : ctx
    )
  )
});
/// The load outcome for `std/prelude.yo`, built from the CACHED env rather
/// than from a second evaluation.
///
/// Both prelude paths through `mm_load_file` — the cache hit and the first
/// load — used to answer `UnitVal`/`Unit`, which is not a description of
/// anything. `yo doc` asks `is_module_type(module_type)` before it reads a
/// single declaration, so `std/prelude.yo` rendered as an empty page and the
/// core traits were never available to donate their method docs to the
/// trait-impl methods across `std/`
/// (issues/fixed/yo-doc-renders-the-prelude-empty.md). Re-evaluating the
/// prelude to get a namespace is NOT an option — it re-registers every impl
/// under fresh type identities and corrupts where-constrained generic-impl
/// resolution for every file checked afterwards
/// (issues/fixed/seed-built-stage1-array-fill-method-miss.md) — so the
/// namespace is reconstructed from the bindings the cached env already holds.
_prelude_load_outcome :: (fn(input_path : String, std_path : String) -> ModuleLoadOutcome)({
  prelude_env := match(
    g_cached_prelude_env,
    .Some(pe) => pe,
    .None => Environment.new(input_path.clone())
  );
  prelude_val := _build_module_val_from_env(prelude_env);
  ModuleLoadOutcome(
    ok : true,
    module_value : prelude_val,
    module_type : type_of_eval_value(prelude_val),
    env : prelude_env,
    ctx : eval_context_new(std_path.clone(), input_path.clone())
  )
});
/// Run the evaluator against a single `.yo` file, catching any thrown evaluator
/// error via a local exception handler so a directory walk keeps going across
/// files. `verbose` prints the `check: …` progress chatter.
///
/// This is TS `ModuleManager.loadModule` — with the prelude bootstrap folded in,
/// because unlike TS (where the prelude is just another cached module) yo-self
/// clones a cached prelude env into every file.
mm_load_file :: (
  fn(
    input_path : String,
    std_path : String,
    verbose : bool,
    io : Io,
    exn : Exception
  ) -> ModuleLoadOutcome
)({
  // Local exception handler escapes the function body with a failed outcome.
  // Effect-handler bodies cannot capture outer runtime vars (per Yo's `->`
  // rule), so we can't name the file here — the caller logs that from `ok`.
  // The rendered diagnostic is STASHED, not printed (the P1 single-print
  // rule, plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md D2): the owning edge prints.
  local_exn := Exception(
    throw : (
      err -> {
        _stash_load_error(render_any_error(err));
        stash_error_diagnostics(err);
        unwind(_failed_outcome())
      }
    )
  );
  _load_imports_file(exn);
  _register_manifest_import_roots(mm_resolve_entry_abs(input_path.clone(), std_path.clone()).replace(String.from("file://"), String.new()), exn);
  // A prelude that is already cached is a HIT — never re-evaluate it (TS
  // parity: a checked prelude is a module-cache hit in `loadModule`). The env
  // cache below is populate-once, but before this guard the prelude BODY was
  // still re-evaluated, registering every impl a second time into the
  // process-wide registries under fresh type identities — which corrupts
  // where-constrained generic-impl resolution for every file checked after it
  // (see issues/fixed/seed-built-stage1-array-fill-method-miss.md).
  if(input_path.ends_with(String.from("prelude.yo")) && !g_cached_prelude_env.is_none(), {
    if(verbose, {
      emit_chatter(`check: ${input_path} — evaluator OK`);
    });
    return(_prelude_load_outcome(input_path.clone(), std_path.clone()));
  });
  // ANY already-cached module is a HIT — never re-evaluate it (TS parity:
  // `check`'s CodeGenerator reuse makes a file already loaded as a DEPENDENCY
  // of an earlier file "a cache hit on the second pass; we still re-run the
  // 'evaluator OK' report … but no real work happens", yo-cli.ts). The guard
  // above covered only the prelude; every other cached module was
  // re-evaluated, re-registering its impls under fresh type identities — the
  // re-check of std/string/string.yo then def-evaled its `Eq(String)` impl's
  // `(!=)` body against the SPLIT registration state and died with "No
  // matching call found: !(self == other)" (order-dependent: only when the
  // module was first pulled in as a dependency — GATE 3's `check ./std`).
  mm_hit_abs := mm_resolve_entry_abs(input_path.clone(), std_path.clone());
  if(module_cache_has(mm_hit_abs.clone()), {
    if(verbose, {
      emit_chatter(`check: ${input_path} — evaluator OK`);
    });
    mm_hit := load_module_from_cache(mm_hit_abs.clone());
    return(
      ModuleLoadOutcome(
        ok : true,
        module_value : mm_hit.module_value,
        module_type : mm_hit.module_type,
        env : match(g_cached_prelude_env, .Some(pe) => pe, .None => Environment.new(input_path.clone())),
        ctx : eval_context_new(std_path.clone(), input_path.clone())
      )
    );
  });
  if(verbose, {
    emit_chatter(`check: parsing ${input_path}`);
  });
  // COMPTIME read — synchronous on purpose (see manifest.yo `read_file_sync`): evaluating
  // a module runs inside the evaluator, and under `yo build` inside
  // run_build's async task, where the async read's blocking poll loop would
  // nest the event loop (C37/C42).
  record_input_file(input_path.clone());
  src_bytes := read_file_sync(input_path.clone(), exn);
  src := String.from_bytes(src_bytes);
  exprs := parse(src, input_path.clone(), local_exn);
  if(verbose, {
    emit_chatter(`check: parsed ${exprs.len().to_string()} top-level exprs`);
  });
  if(input_path.ends_with(String.from("prelude.yo")), {
    if(verbose, {
      emit_chatter(`check: invoking evaluate_anonymous_module_begin_exprs (prelude)`);
    });
    _pr := mm_load_prelude_file(input_path.clone(), std_path.clone(), exprs, local_exn);
    if(verbose, {
      emit_chatter(`check: ${input_path} — evaluator OK`);
    });
    // The FIRST load of the prelude answers with the same namespace the cache
    // hit above does — `yo doc <one file>` reaches the prelude by this path,
    // not by that one.
    return(_prelude_load_outcome(input_path.clone(), std_path.clone()));
  });
  // Ensure the prelude env is cached (single-file loads skip any pre-load step).
  if(g_cached_prelude_env.is_none(), {
    _pre := recur(`${std_path}/prelude.yo`, std_path.clone(), verbose, io, exn);
  });
  entry_abs := mm_resolve_entry_abs(input_path.clone(), std_path.clone());
  if(verbose, {
    emit_chatter(`check: invoking evaluate_anonymous_module_begin_exprs`);
  });
  // The demand loader must use the LOCAL exn: a nested import's failure has to
  // unwind this file's handler, not the driver's.
  outcome := mm_eval_entry_exprs(entry_abs, std_path.clone(), exprs, local_exn);
  if(outcome.ok && verbose, {
    emit_chatter(`check: ${input_path} — evaluator OK`);
  });
  outcome
});
/// Ensure the prelude env is cached AND its O(1) variable cache is built. Call
/// once per run before checking a corpus, so the cached env is free of the first
/// file's own bindings.
/// Load the prelude into the cached env, printing its diagnostic if it fails.
///
/// **Returns whether the prelude is usable**, and the caller must act on it. A
/// prelude that fails to evaluate is the ROOT cause of everything that follows,
/// so continuing produces a SECOND diagnostic for the same fault: the compile
/// path used to print the prelude error here and then walk straight into
/// `mm_eval_entry_exprs`, which failed for the same reason and printed the
/// rendered error again. Two identical lines, no context — visible whenever the
/// prelude is what breaks, e.g. `--compile-timeout-ms 1`, where the cooperative
/// deadline is LATCHED and every later dispatch rethrows
/// (`issues/fixed/failed-prelude-load-prints-twice-and-continues.md`).
///
/// The decision cannot live in here: `src/lsp/diagnostics.yo` calls this on
/// every analysis and must DEGRADE rather than die, so an `exit` at this edge
/// would take the language server down with it.
mm_preload_prelude :: (
  fn(
    std_path : String,
    verbose : bool,
    io : Io,
    exn : Exception
  ) -> bool
)({
  (ok : bool) = true;
  if(g_cached_prelude_env.is_none(), {
    pre_outcome := mm_load_file(`${std_path}/prelude.yo`, std_path.clone(), verbose, io, exn);
    // Print its diagnostic here, once, at this edge (the P1 single-print rule;
    // the loader's handlers only stash).
    if(!pre_outcome.ok, {
      ok = false;
      // A TRIPPED DEADLINE outranks whatever error surfaced: once it trips the
      // evaluator's state is unreliable, so the next diagnostic is a
      // half-evaluated expression's own complaint, not the fault. Reporting
      // that instead would point at innocent code and hide the timeout
      // (issues/fixed/a-tripped-deadline-is-masked-by-the-next-type-error.md).
      cond(
        evaluator_deadline_tripped() => eprintln(evaluator_deadline_message()),
        true => match(
          _take_load_error(),
          .Some(rendered) => eprintln(rendered),
          .None => eprintln(`check: error in: ${std_path}/prelude.yo`)
        )
      );
    });
    // Build the O(1) prelude variable cache here rather than inside
    // `mm_load_file`, to avoid interference with the compile path.
    match(g_cached_prelude_env, .Some(pe) => build_prelude_var_cache(pe), .None => ());
  });
  ok
});
/// The front door for a subcommand that just needs a `.yo` file evaluated for
/// its exports / registry side effects — TS's three-line
/// `new ModuleManager(); loadModule(path); resetAllState();` pattern, minus the
/// reset (callers that want a clean universe afterwards call `mm_reset`).
///
/// Resolves the std path itself, so callers do not each re-derive it.
mm_load_yo_file :: (
  fn(
    input_path : String,
    io : Io,
    exn : Exception
  ) -> ModuleLoadOutcome
)({
  std_path := resolve_std_path();
  mm_load_file(input_path, std_path, false, io, exn)
});
export(
  ModuleLoadOutcome,
  resolve_std_path,
  set_std_path_override,
  get_std_path_override,
  set_imports_file_override,
  get_imports_file_override,
  mm_set_loader_context,
  mm_demand_loader,
  mm_prelude_env,
  mm_has_prelude_env,
  mm_clear_prelude_env,
  mm_set_shared_expr_info_table,
  mm_shared_expr_info_table,
  mm_fresh_module_env,
  mm_resolve_entry_abs,
  mm_invalidate_document,
  mm_set_open_document,
  mm_forget_open_document,
  mm_module_source,
  mm_reset,
  demand_load_module,
  mm_load_prelude_file,
  mm_eval_entry_exprs,
  mm_load_file,
  mm_preload_prelude,
  mm_load_yo_file
);
