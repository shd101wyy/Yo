//! Error types and formatting utilities for the Yo compiler.
//!
//! P1 of plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md: `YoError` carries structured
//! `Diagnostic` values (code/severity/message/span/source-line); the human
//! text — including the location block — is RENDERED from that data at the
//! edge, never baked into the message string. The single-message and batch
//! builders keep taking a `Token` (+ verbatim message), so the ~1000
//! emission sites across the evaluator are untouched by the restructure.
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ Token } :: import("./token.yo");
{ assert } :: import("std/assert");
{
  Severity,
  Span,
  Diagnostic,
  render_diagnostics_human,
  render_diagnostics_for_mode,
  E_UNEXPECTED_TOKEN,
  E_EXPECTED_TOKEN,
  E_ADJACENT_OPERATORS,
  E_UNTERMINATED,
  E_UNEXPECTED_CHARACTER,
  E_UNKNOWN_OPERATOR,
  E_STRUCT_LITERAL_VS_BLOCK,
  E_CALL_SYNTAX,
  E_VARIABLE_NOT_FOUND,
  E_ENUM_VARIANT_NOT_FOUND,
  E_MODULE_FIELD_NOT_FOUND,
  E_NOT_DEFINED,
  E_INCOMPATIBLE_TYPES,
  E_TRAIT_NOT_IMPLEMENTED,
  E_ARGUMENT_COUNT_MISMATCH,
  E_RETURN_TYPE_MISMATCH,
  E_TYPE_MISMATCH,
  E_USE_OF_MOVED_VALUE,
  E_CANNOT_REASSIGN,
  E_MAYBE_UNINITIALIZED,
  E_AWAIT_PLACEMENT,
  E_NEVER_FULLY_EVALUATED,
  E_FORWARD_REFERENCE,
  E_COMPTIME_ARGUMENT,
  E_COMPTIME_OVERFLOW
} :: import("./diagnostics.yo");
/// A token paired with an error message for error reporting — the input
/// currency of the batch builder (ownership-flow errors collect several
/// related locations in one group).
TokenAndError :: struct(
  token : Token,
  error_message : String
);
derive(TokenAndError, Clone);
/// A token paired with a warning message for warning reporting.
TokenAndWarning :: struct(
  token : Token,
  warning_message : String
);
derive(TokenAndWarning, Clone);
/// The `Span` of a token: its module path, 0-based row/rune column, and the
/// token's rune length as the underline (D5 — the caret used to sit at the
/// token's MIDDLE; it now underlines the whole token from its start).
_span_of_token :: (fn(token : Token) -> Span)(
  Span(
    path : token.module_path,
    row : token.row,
    col : token.column,
    len : token.value.chars().count()
  )
);
/// The source line at the token's row ("" when the row is out of range).
_source_line_of_token :: (fn(token : Token) -> String)({
  lines := token.input.split(String.from("\n"));
  match(
    lines.get(token.row),
    .Some(line) => line,
    .None => String.new()
  )
});
/// Wrap a static code constant as the classifier's return value.
_coded :: (fn(c : str) -> Option(String))(Option(String).Some(String.from(c)));
/// Classify a message into its diagnostic code FAMILY (P2,
/// plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md §5). Codes are allocated per family —
/// the 1000+ emission sites collapse into these — and the classification is
/// central on purpose: one table to test, no per-site sweep, and messages
/// carry their family's distinctive vocabulary verbatim (checked by
/// tests/internal/error.test.yo). Specific rules come BEFORE generic ones.
_classify_message :: (fn(error_message : String) -> Option(String))({
  msg := error_message.trim();
  // ── Syntax (E00xx–E02xx) ────────────────────────────────────────────────
  if(msg.starts_with(String.from("unexpected token")), {
    return(_coded(E_UNEXPECTED_TOKEN));
  });
  if(msg.starts_with(String.from("expected ")), {
    return(_coded(E_EXPECTED_TOKEN));
  });
  if(msg.contains(String.from("Adjacent different operators")), {
    return(_coded(E_ADJACENT_OPERATORS));
  });
  if(msg.starts_with(String.from("unterminated ")), {
    return(_coded(E_UNTERMINATED));
  });
  if(msg.starts_with(String.from("unexpected character")), {
    return(_coded(E_UNEXPECTED_CHARACTER));
  });
  if(msg.starts_with(String.from("unknown operator in")), {
    return(_coded(E_UNKNOWN_OPERATOR));
  });
  if(msg.contains(String.from("without semicolons is parsed as a struct literal")), {
    return(_coded(E_STRUCT_LITERAL_VS_BLOCK));
  });
  if(msg.contains(String.from("paren-less function")) || msg.contains(
    String.from("whitespace before '('")
  ), {
    return(_coded(E_CALL_SYNTAX));
  });
  // ── Name / scope / module resolution (E03xx–E05xx) ─────────────────────
  if(msg.contains(String.from("Enum variant \"")), {
    return(_coded(E_ENUM_VARIANT_NOT_FOUND));
  });
  if(msg.contains(String.from("Module field \"")), {
    return(_coded(E_MODULE_FIELD_NOT_FOUND));
  });
  if(msg.contains(String.from("is not defined.")), {
    return(_coded(E_NOT_DEFINED));
  });
  if(msg.contains(String.from("not found.")) || msg.contains(
    String.from("not found ")
  ) || msg.contains(String.from("\" not found")), {
    return(_coded(E_VARIABLE_NOT_FOUND));
  });
  // ── Types & traits (E06xx–E08xx) ───────────────────────────────────────
  if(msg.contains(String.from("Argument count mismatch")), {
    return(_coded(E_ARGUMENT_COUNT_MISMATCH));
  });
  if(msg.contains(String.from("does not implement required trait")) || msg.contains(
    String.from("must NOT implement")
  ), {
    return(_coded(E_TRAIT_NOT_IMPLEMENTED));
  });
  if(msg.contains(String.from("return type")) && (
    msg.contains(String.from("Incompatible")) || msg.contains(
      String.from("mismatch")
    )
  ), {
    return(_coded(E_RETURN_TYPE_MISMATCH));
  });
  if(msg.starts_with(String.from("Incompatible type")) || msg.starts_with(
    String.from("Incompatible types")
  ) || msg.starts_with(String.from("Assigned value type mismatch")) || msg.starts_with(
    String.from("Pattern type ")
  ), {
    return(_coded(E_INCOMPATIBLE_TYPES));
  });
  if(msg.contains(String.from("type mismatch")) || msg.contains(
    String.from("Type mismatch")
  ) || msg.contains(String.from("Failed to call the type")), {
    return(_coded(E_TYPE_MISMATCH));
  });
  // ── Ownership / moves / effects / async (E09xx–E10xx) ──────────────────
  if(msg.starts_with(String.from("use of moved value")), {
    return(_coded(E_USE_OF_MOVED_VALUE));
  });
  if(msg.starts_with(String.from("Cannot reassign")), {
    return(_coded(E_CANNOT_REASSIGN));
  });
  if(msg.contains(String.from("might be initialized in some cases")), {
    return(_coded(E_MAYBE_UNINITIALIZED));
  });
  if(msg.contains(String.from("must BE the first condition")), {
    return(_coded(E_AWAIT_PLACEMENT));
  });
  if(msg.contains(String.from("was never fully evaluated")), {
    return(_coded(E_NEVER_FULLY_EVALUATED));
  });
  if(msg.contains(String.from("forward reference")), {
    return(_coded(E_FORWARD_REFERENCE));
  });
  // ── Comptime (E11xx–E12xx) ─────────────────────────────────────────────
  if(msg.starts_with(String.from("Integer overflow")), {
    return(_coded(E_COMPTIME_OVERFLOW));
  });
  if(msg.contains(String.from("comptime_assert")), {
    return(_coded(E_COMPTIME_ARGUMENT));
  });
  Option(String).None
});
/// One diagnostic entry from a token + verbatim message.
_diagnostic_of_token :: (
  fn(token : Token, severity : Severity, error_message : String) -> Diagnostic
)(
  Diagnostic(
    code : _classify_message(error_message),
    severity : severity,
    message : error_message.trim(),
    span : _span_of_token(token),
    source_line : _source_line_of_token(token)
  )
);
/// Compiler error: a group of diagnostics — entry 0 the primary error,
/// every later entry a related location rendered as a `note:` block
/// (D6 — they used to render with an `Error:` prefix).
YoError :: ref(
  struct(
    diagnostics : ArrayList(Diagnostic)
  )
);
impl(
  YoError,
  ToString(
    to_string : (fn(inout(self) : Self) -> String)(
      render_diagnostics_human(self.diagnostics)
    )
  )
);
impl(YoError, Error());
/// Wrap one diagnostic as a single-entry `YoError`.
_yo_error_of :: (fn(entry : Diagnostic) -> YoError)({
  entries := ArrayList(Diagnostic).new();
  entries.push(entry);
  YoError(diagnostics : entries)
});
/// Create a `YoError` from a single token and error message.
format_error_message :: (fn(token : Token, error_message : String) -> YoError)(
  _yo_error_of(_diagnostic_of_token(token, Severity.Error, error_message))
);
/// Create a `YoError` from a token, a message, and a P3 repair hint —
/// the did-you-mean channel ("help: did you mean …?").
format_error_message_with_help :: (
  fn(token : Token, error_message : String, help : Option(String)) -> YoError
)({
  d := _diagnostic_of_token(token, Severity.Error, error_message);
  if(help.is_some(), {
    h := match(
      help,
      .Some(hh) => hh,
      .None => String.new()
    );
    d.help = Option(String).Some(h);
  });
  _yo_error_of(d)
});
/// Create a `YoError` with a path anchor but no snippet — end-of-input and
/// other position-less parser errors.
format_raw_error :: (fn(module_path : String, error_message : String) -> YoError)(
  _yo_error_of(
    Diagnostic(
      code : _classify_message(error_message),
      severity : Severity.Error,
      message : error_message.trim(),
      span : Span(path : module_path, row : usize(0), col : usize(0), len : usize(0)),
      source_line : String.new()
    )
  )
);
/// Create a `YoError` from a list of token + error message pairs: the first
/// entry is the primary error, every later entry renders as a note.
format_error_messages :: (fn(token_and_error_list : ArrayList(TokenAndError)) -> YoError)({
  assert(token_and_error_list.len() > usize(0), "token_and_error_list must not be empty");
  entries := ArrayList(Diagnostic).new();
  (i : usize) = usize(0);
  while(i < token_and_error_list.len(), {
    match(
      token_and_error_list.get(i),
      .Some(entry) => {
        if(i == usize(0), {
          entries.push(_diagnostic_of_token(entry.token, Severity.Error, entry.error_message));
        }, {
          entries.push(_diagnostic_of_token(entry.token, Severity.Note, entry.error_message));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  YoError(diagnostics : entries)
});
/// The batch builder with a repair hint attached to the PRIMARY entry
/// (the P3 did-you-mean channel for the ownership-flow family's raises).
format_error_messages_with_help :: (
  fn(token_and_error_list : ArrayList(TokenAndError), help : Option(String)) -> YoError
)({
  err := format_error_messages(token_and_error_list);
  match(
    err.diagnostics.get(usize(0)),
    .Some(first) => {
      first.help = help;
    },
    .None => ()
  );
  err
});
/// A lexer error as a `YoError` diagnostic group. The lexer's internal
/// struct carries no file context (D3), so the throw site supplies the
/// module path, the full input (for the source line), and the 0-based
/// row/rune column.
format_lexer_error :: (
  fn(
    module_path : String,
    input : String,
    row : usize,
    column : usize,
    message : String
  ) -> YoError
)({
  lines := input.split(String.from("\n"));
  line := match(
    lines.get(row),
    .Some(l) => l,
    .None => String.new()
  );
  _yo_error_of(
    Diagnostic(
      code : _classify_message(message),
      severity : Severity.Error,
      message : message.trim(),
      span : Span(path : module_path, row : row, col : column, len : usize(1)),
      source_line : line
    )
  )
});
/// Render any thrown error in the process's current format (P2): a
/// structured `YoError` renders per `--error-format`; everything else keeps
/// its own `to_string`. This is what every printing edge goes through —
/// handlers stash THIS text, so the format choice is global.
render_any_error :: (fn(err : AnyError) -> String)(
  match(
    downcast(err, YoError),
    .Some(ye) => render_diagnostics_for_mode(ye.diagnostics),
    .None => err.to_string()
  )
);
/// The typed diagnostics channel (P3): the last thrown YoError's structured
/// group. Every stash-and-print edge (module loading, the LSP, import-site
/// collapse) reads STRUCTURED data from here instead of parsing rendered
/// text — one stash next to the text stash, populated at the same points.
(g_last_error_diagnostics : Option(ArrayList(Diagnostic))) = Option(
  ArrayList(Diagnostic)
).None;
stash_error_diagnostics :: (fn(err : AnyError) -> unit)({
  match(
    downcast(err, YoError),
    .Some(ye) => {
      g_last_error_diagnostics = Option(ArrayList(Diagnostic)).Some(ye.diagnostics);
    },
    .None => ()
  );
});
take_error_diagnostics :: (fn() -> Option(ArrayList(Diagnostic)))({
  taken := g_last_error_diagnostics;
  g_last_error_diagnostics = Option(ArrayList(Diagnostic)).None;
  taken
});
/// A Note-severity diagnostic anchored at a token (the import-chain note).
note_diagnostic_of_token :: (fn(token : Token, message : String) -> Diagnostic)(
  _diagnostic_of_token(token, Severity.Note, message)
);
/// Get the source line at the token's position with a caret indicator
/// (the legacy pre-P1 block, still used by the warnings path).
get_line_at_token :: (fn(token : Token) -> String)({
  lines := token.input.split(String.from("\n"));
  row_line := match(
    lines.get(token.row),
    .Some(line) => line,
    .None => String.new()
  );
  // `token.column` is a RUNE column (src/lexer.yo indexes an ArrayList(rune)),
  // so the half-width offset added to it has to be a rune count too — say so,
  // rather than inheriting whatever basis `len()` happens to have
  // (plans/STD_API_AUDIT_D4_PLAN.md §5.2 S7).
  caret_col := (token.column + (token.value.chars().count() / usize(2)));
  spaces := String.from(" ").repeat(caret_col);
  row_plus1 := (token.row + usize(1));
  col_plus1 := (token.column + usize(1));
  `${token.module_path}:${row_plus1}:${col_plus1}:\n${row_line}\n${spaces}^`
});
/// Get the source line at a given position with a caret indicator
/// (the legacy pre-P1 block).
get_line_at_position :: (
  fn(module_path : String, input_string : String, row : usize, column : usize) -> String
)({
  lines := input_string.split(String.from("\n"));
  row_line := match(
    lines.get(row),
    .Some(line) => line,
    .None => String.new()
  );
  spaces := String.from(" ").repeat(column);
  row_plus1 := (row + usize(1));
  col_plus1 := (column + usize(1));
  `${module_path}:${row_plus1}:${col_plus1}:\n  \n${row_line}\n${spaces}^`
});
/// Format warning messages into a single string (legacy pre-P1 block; the
/// warnings channel itself is P4, plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md §7).
format_warning_messages :: (
  fn(warning_message : Option(String), token_and_warning_list : ArrayList(TokenAndWarning)) -> String
)({
  parts := ArrayList(String).new();
  n := token_and_warning_list.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      token_and_warning_list.get(i),
      .Some(entry) => {
        line := get_line_at_token(entry.token);
        parts.push(`Warning: ${entry.warning_message}\n${line}`);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  sep := String.from("\n\n");
  warnings := sep.join(parts);
  match(
    warning_message,
    .Some(msg) => `Warning: ${msg}\n${warnings}`,
    .None => warnings
  )
});
export(TokenAndError, TokenAndWarning, YoError);
// Exported for the registry/classifier tests (tests/internal).
export(_classify_message);
export(get_line_at_token, get_line_at_position);
export(
  format_error_message,
  format_error_message_with_help,
  format_error_messages,
  format_error_messages_with_help,
  format_lexer_error,
  format_raw_error,
  format_warning_messages,
  render_any_error,
  stash_error_diagnostics,
  take_error_diagnostics,
  note_diagnostic_of_token
);
