//! The compile's INPUT RECORD
//! (plans/archive/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.9, §5.1).
//!
//! Every file this process read while evaluating, in first-open order and
//! without duplicates. `yo compile --emit-deps <file>` writes the list, and the
//! build runner's artifact stamp hashes exactly it — instead of walking every
//! `.yo` under the project plus the whole std tree, per artifact.
//!
//! Two kinds of input land here:
//!
//!   - `.yo` MODULES, recorded by `module_manager.yo` at the two places a
//!     source file is actually read (the entry module in `mm_load_file`, every
//!     demand-loaded module in `_load_module_at_abs`), so a module that is a
//!     cache hit on a later pass is still listed from its first open;
//!   - DATA files read by `comptime_read_file` (§5.1). Without this edge a
//!     build would cache over an edited data file forever.
//!
//! It lives in a module of its own rather than in `module_manager.yo` because
//! the evaluator builtin that records the second kind cannot import the module
//! manager — the module manager imports the evaluator.
//!
//! Paths are ABSOLUTE, always. The two spellings of a module path meet in this
//! list: a demand-loaded module arrives as the `file://<abs>` cache key, while
//! the ENTRY arrives exactly as typed on the command line (`src/main.yo`, so
//! diagnostics stay relative). A depfile mixing the two only works while its
//! reader shares the writer's cwd, and the build runner reads it from wherever
//! `yo build` was invoked.
{ String } :: import("std/string");
{ Path } :: import("std/path");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ HashSet } :: import("std/collections/hash_set");
{ cwd } :: import("std/env");
(g_input_files : ArrayList(String)) = ArrayList(String).new();
/// Parallel to `g_input_files`: the sha256 of each input's bytes AS READ.
///
/// This is the whole point of recording a hash here rather than re-reading the
/// file later. The build runner used to compute the artifact's recorded stamp
/// AFTER the child compile exited, by re-hashing every input from disk — so an
/// edit landing during the compile (the window is minutes for a large artifact)
/// was recorded as though it had been compiled, and every later build matched
/// that stamp and served the stale artifact forever
/// (issues/fixed/yo-build-artifact-cache-serves-a-stale-binary.md). Only the reader
/// knows what it read, so the reader records it.
///
/// Empty string when hashing is off — see `set_input_hashing`.
(g_input_hashes : ArrayList(String)) = ArrayList(String).new();
/// Hashing is OFF unless a consumer of the depfile turns it on. `yo build`'s
/// child compiles pass `--emit-deps` and enable it; `yo check`, `yo test` and
/// the LSP never pay for it.
(mut(g_input_hashing) : bool) = false;
// The module touch log (see "What a cached module's load read" below).
/// Every record and every module hit this compile, in call order, WITHOUT
/// dedup: one module's load is a slice of it.
(g_touches : ArrayList(String)) = ArrayList(String).new();
/// Module key -> what its last load touched (persists across compiles).
(g_module_touches : HashMap(String, ArrayList(String))) = HashMap(String, ArrayList(String)).new();
/// The modules already replayed into this compile's record.
(g_replayed_modules : HashSet(String)) = HashSet(String).new();
/// True while a hit is being replayed.
(mut(g_replaying) : bool) = false;
set_input_hashing :: (fn(enabled : bool) -> unit)({
  g_input_hashing = enabled;
});
input_hashing_enabled :: (fn() -> bool)(g_input_hashing);
/// Absolutize against the cwd (when relative) and fold `.`/`..` LEXICALLY —
/// the same treatment the std path gets. Lexical only: this runs inside the
/// module loader, which is synchronous, and symlink resolution is not.
_canonicalize :: (fn(p : &String) -> String)({
  path := Path.new(p.clone());
  if(!path.is_absolute(), {
    match(
      cwd(),
      .Ok(base) => {
        path = base.join(&path);
      },
      .Err(_) => ()
    );
  });
  path.normalize().to_string()
});
/// Record `path` as an input of this compile, together with the sha256 of the
/// bytes the caller just read. A repeat is ignored, so the list is the SET of
/// inputs in first-open order.
///
/// `content_sha256` must be the hash of the bytes THIS COMPILE CONSUMED — the
/// disk bytes, never an editor overlay applied on top of them, because the next
/// build hashes the disk. Pass `""` when hashing is disabled.
record_input_file :: (fn(path : &String, content_sha256 : &String) -> unit)({
  fs := _canonicalize(path.replace(String.from("file://"), String.new()));
  if(fs.len() == usize(0), {
    return(());
  });
  // A replay's records are already named by the `@<key>` entry that
  // triggered it.
  if(g_input_hashing && !g_replaying, {
    g_touches.push(`${_hash_marker(content_sha256)} ${fs}`);
  });
  (i : usize) = usize(0);
  while(i < g_input_files.len(), {
    match(
      g_input_files.get(i),
      .Some(seen) => if(seen == fs, {
        return(());
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  g_input_files.push(fs);
  g_input_hashes.push(content_sha256.clone());
});
/// Start a fresh record. `yo compile` calls this before evaluating, so a
/// long-lived process (the LSP, `check --watch`) does not accumulate.
reset_input_files :: (fn() -> unit)({
  g_input_files.clear();
  g_input_hashes.clear();
  g_touches.clear();
  g_replayed_modules.clear();
});
// ── What a cached module's load read
//
// A module-cache hit neither re-reads the module nor re-imports what it
// imports, so a compile that finds a module already loaded, as every warm
// `yo build --watch` round does, recorded only the files it read itself. Its
// depfile then named a subset, the next cold build re-hashed only that
// subset, matched, and served a stale binary after an edit to a module the
// warm round had not re-read
// (issues/fixed/yo-build-artifact-cache-serves-a-stale-binary.md).
//
// So each module load remembers what it touched: every input recorded during
// it, as `<hash> <path>` (hash `-` when hashing was off), plus `@<key>` for each
// module it found cached. A later hit replays that list, once per compile and
// recursively through the `@` entries, with the hashes taken when the bytes
// were READ. A cached module whose load was never observed records its path
// with no hash, which makes the stamp unusable and forces a recompile.
_hash_marker :: (fn(h : &String) -> String)(
  cond(
    (h.len() > usize(0)) => h.clone(),
    true => String.from("-")
  )
);
/// Start observing a module load; pass the result to `module_load_end`.
module_load_begin :: (fn() -> usize)(g_touches.len());
/// Remember what the load of `key` touched since `mark`.
module_load_end :: (fn(key : &String, mark : usize) -> unit)({
  // Only a compile that writes a depfile (hashing on) needs the log; `check`,
  // `test` and the LSP would only accumulate it.
  if(!g_input_hashing, {
    return(());
  });
  out := ArrayList(String).new();
  (i : usize) = mark;
  while(i < g_touches.len(), {
    match(
      g_touches.get(i),
      .Some(t) => out.push(t.clone()),
      .None => ()
    );
    i = (i + usize(1));
  });
  g_module_touches.insert(key.clone(), out);
});
/// Module `key` was found in the module cache: note it in the touch log (so an
/// enclosing load's slice names it) and replay its inputs into this compile's
/// record the first time.
module_cache_hit :: (fn(key : &String) -> unit)({
  if(!g_input_hashing, {
    return(());
  });
  g_touches.push(`@${key}`);
  g_replaying = true;
  _replay_module(key);
  g_replaying = false;
});
_replay_module :: (fn(key : &String) -> unit)({
  if(g_replayed_modules.contains(key), {
    return(());
  });
  g_replayed_modules.insert(key.clone());
  match(
    g_module_touches.get(key),
    .Some(list) => {
      (i : usize) = usize(0);
      while(i < list.len(), {
        match(
          list.get(i),
          .Some(t) => _replay_touch(&t),
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .None => {
      // Never observed: name it with no hash, so the stamp cannot match.
      record_input_file(key, &String.new());
    }
  );
});
_replay_touch :: (fn(t : &String) -> unit)({
  if(t.starts_with("@"), {
    _replay_module(&t.substring(usize(1), t.len()));
    return(());
  });
  match(
    t.index_of(" ", usize(0)),
    .Some(sp) => {
      h := t.substring(usize(0), sp);
      p := t.substring(sp + usize(1), t.len());
      record_input_file(&p, &cond((h == "-") => String.new(), true => h));
    },
    .None => ()
  );
});
/// The files read so far, in first-open order.
input_files :: (fn() -> ArrayList(String))(g_input_files.clone());
/// The inputs as `<sha256> <absolute path>` lines, in first-open order — the
/// depfile's format. The hash comes FIRST so a path containing spaces still
/// parses by splitting at the first space.
///
/// An entry whose hash is empty (hashing was off) is emitted with a `-`
/// placeholder, which the build runner treats as "unusable, recompile".
input_file_entries :: (fn() -> ArrayList(String))({
  out := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < g_input_files.len(), {
    path := match(g_input_files.get(i), .Some(p) => p.clone(), .None => String.new());
    h := match(g_input_hashes.get(i), .Some(x) => x.clone(), .None => String.new());
    marker := cond(
      (h.len() > usize(0)) => h,
      true => String.from("-")
    );
    out.push(`${marker} ${path}`);
    i = (i + usize(1));
  });
  out
});
// ── Environment reads (plans/archive/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §5.4)
//
// `build.env` lets a build file branch on the invoking shell, which makes the
// shell an INPUT. Each read is recorded as `name=value` (or `name=<unset>`) and
// folded into the artifact stamp, so changing a variable the build file reads
// rebuilds rather than serving a stale artifact.
//
// Recorded in first-read order, deduplicated by NAME AND VALUE: one name read
// twice is one entry, and a name whose value somehow differed between reads
// keeps both, because both influenced the build.
(g_env_reads : ArrayList(String)) = ArrayList(String).new();
/// Record that the build read `name`, seeing `rendered` (`<unset>` when absent).
record_env_read :: (fn(name : &String, rendered : &String) -> unit)({
  entry := `${name}=${rendered}`;
  (i : usize) = usize(0);
  while(i < g_env_reads.len(), {
    match(
      g_env_reads.get(i),
      .Some(seen) => if(seen == entry, {
        return(());
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  g_env_reads.push(entry);
});
/// The environment reads so far, as `name=value` lines in first-read order.
env_reads :: (fn() -> ArrayList(String))(g_env_reads.clone());
export(
  record_input_file,
  reset_input_files,
  module_load_begin,
  module_load_end,
  module_cache_hit,
  input_files,
  input_file_entries,
  set_input_hashing,
  input_hashing_enabled,
  record_env_read,
  env_reads
);
