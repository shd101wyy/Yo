export(pattern_bindings, pattern_is_irrefutable, pattern_to_string);
export(match_missing_witness, ArmReach, arm_reachability, pattern_test_exprs);
export(gadt_branch_reachable, gadt_resolve_tca_entry, norm_position_type, variant_field_types);
