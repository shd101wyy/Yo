//! Build runner — `yo build` implementation.
//!
//! Evaluates `build.yo` using the Yo evaluator.  Build functions
//! (build.executable, build.test, etc.) populate a `BuildRegistry`.
//! After evaluation the runner reads the registry and orchestrates
//! compilation for each artifact.
//!
//! Mirrors `src/build-runner.ts`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ Exception, IoExn } :: import("std/error");
{ Path } :: import("std/path");
{ cwd, chdir } :: import("std/env");
// Imported under an alias: `args` collides with the `args` parameter/field used
// throughout this file (`run_step.args`). Same rename form main.yo uses for `env`.
_(args : proc_args) :: import("std/env");
{ exists, read, write_string } :: import("std/fs/file");
{ read_dir, DirEntry } :: import("std/fs/dir");
{ sha256_hex } :: import("std/crypto/sha256");
{ CURRENT_YO_VERSION } :: import("./version.yo");
_(env : proc_env) :: import("std/env");
{ create_dir_all } :: import("std/fs/dir");
{ Command, Output, ExitStatus } :: import("std/process/command");
{ yield } :: import("std/async");
{ mm_load_yo_file, mm_reset, get_std_path_override, resolve_std_path } :: import("./module_manager.yo");
{ exit } :: import("std/libc/stdlib");
{
  ArtifactKind,
  BuildArtifact,
  BuildTestSuite,
  BuildRunStep,
  BuildStep,
  BuildDocConfig,
  BuildModuleEntry,
  BuildRegistry,
  ResolvedDep,
  BuildSystemLibrary,
  get_build_registry,
  clear_build_registry
} :: import("./evaluator/builtins/build.yo");
{ are_deps_cached, fetch_all_deps } :: import("./fetch.yo");
{ resolve_all_system_libraries } :: import("./pkg_config.yo");
{ DocCommandOptions, run_doc } :: import("./doc_command.yo");
{ TargetInfo, parse_target, host_target, is_target_windows, is_target_wasm } :: import("./target.yo");
// ---------------------------------------------------------------------------
// Build options  (mirrors TypeScript BuildOptions interface)
// ---------------------------------------------------------------------------
BuildOptions :: ref(
  struct(
    build_file : String,
    target_triple : Option(String),
    verbose : bool,
    dry_run : bool,
    list_steps : bool,
    steps : ArrayList(String),
    defines : HashMap(String, String),
    c_compiler : Option(String),
    sysroot : Option(String),
    summary : bool
  )
);
// ---------------------------------------------------------------------------
// DAG types
// ---------------------------------------------------------------------------
DAGNodeKind :: enum(Artifact, Test, Run, Step, Doc);
DAGNode :: ref(
  struct(
    name : String,
    kind : DAGNodeKind,
    depends_on : ArrayList(String)
  )
);
StepResult :: ref(
  struct(
    name : String,
    kind : DAGNodeKind,
    success : bool,
    duration_ms : i64,
    description : String
  )
);
ExecutionContext :: ref(
  struct(
    registry : BuildRegistry,
    project_dir : String,
    c_compiler : String,
    target_triple : Option(String),
    sysroot : Option(String),
    verbose : bool,
    dry_run : bool,
    summary : bool
  )
);
/// `git describe --tags --always` in the project dir, or `.None` when that fails
/// for any reason (not a repo, no git, non-zero exit, empty output). Mirrors
/// `getGitVersion` (src/build-runner.ts:1417-1429), whose entire body is a
/// try/catch returning undefined — the version is decoration on the "Building …"
/// line, never a reason to fail a build.
_git_output_task :: (fn(cmd : Command, io : Io) -> Impl(Future(Output, IoExn)))(
  io.async((e : IoExn) => {
    // Local swallow handler: a missing git / spawn failure must unwind THIS
    // task (read as `.None` at the JoinHandle below), never reach the
    // build's own handler and fail the build. The unwind payload must match
    // the future's payload type — any other type fails def-eval and silently
    // hollows this SM (the C22-adjacent swallow hole); the value itself is
    // discarded, the task aborts either way.
    swallow := Exception(
      throw : (
        (_e) -> unwind(
          Output(
            status : ExitStatus(raw : i32(0)),
            stdout : ArrayList(u8).new(),
            stderr : ArrayList(u8).new()
          )
        )
      )
    );
    e.io.await(cmd.output(e.io), IoExn(io : e.io, exn : swallow))
  })
);
_git_version :: (
  fn(
    project_dir : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(Option(String), IoExn))
)(
  io.async((e : IoExn) => {
    // `git -C <dir>` rather than a cwd on the Command — `std/process/command.yo`
    // has no `current_dir`, and this is git's own equivalent of TS's
    // `execSync(..., { cwd: projectDir })`. The output future runs as a
    // SPAWNED TASK polled with is_finished + yield: a blocking await from
    // inside a task nests the event loop (C37), and awaiting an aborted
    // future directly would discard this closure's continuation.
    cmd := Command.new(String.from("git"));
    cmd.arg(String.from("-C"));
    cmd.arg(project_dir);
    cmd.arg(String.from("describe"));
    cmd.arg(String.from("--tags"));
    cmd.arg(String.from("--always"));
    t := e.io.spawn(_git_output_task(cmd, e.io), e);
    while(runtime(!(t.is_finished())), {
      e.io.await(yield(e.io), e.io);
    });
    out_opt := t.await(e.io);
    out := match(out_opt, .Some(o) => o, .None => return(Option(String).None));
    if(!(out.status.success()), return(Option(String).None));
    v := String.from_bytes(out.stdout).trim();
    if(v.len() == usize(0), Option(String).None, Option(String).Some(v))
  })
);
/// The compiler binary to invoke for sub-steps (artifact compiles, test runs).
///
/// `src/build-runner.ts` compiles IN PROCESS (`codeGenerator.compileModule`) —
/// it never shells out — so the reference implementation cannot pick up a
/// stranger's binary. yo-self shells out instead, and used the literal name
/// `yo-cli`, resolved through `PATH`. In a clean sandbox that resolved to an
/// unrelated globally-installed `yo` package, so every `build run` failed with
/// a yargs stack trace (caught by `tests/cli-cases/build-run`).
///
/// `argv[0]` is this binary, which is the only correct answer for a self-hosted
/// compiler: `yo build` must invoke the compiler the user actually ran, not
/// whatever `PATH` happens to offer. Falls back to the old name only if
/// `argv[0]` is somehow empty.
_self_exe :: (fn() -> String)({
  argv := proc_args();
  if(argv.len() == usize(0), return(String.from("yo-cli")));
  a0 := argv(usize(0));
  if(a0.len() == usize(0), String.from("yo-cli"), a0)
});
// ---------------------------------------------------------------------------
// Artifact output file name
// ---------------------------------------------------------------------------
/// Compute the output file name for a build artifact.
/// Mirrors `getArtifactOutputFileName` in build-runner.ts.
get_artifact_output_file_name :: (
  fn(
    kind : ArtifactKind,
    name : String,
    artifact_target : String,
    c_flags : ArrayList(String),
    target_triple_opt : Option(String)
  ) -> String
)({
  match(
    kind,
    .StaticLibrary => {
      return(`lib${name}`);
    },
    .SharedLibrary => {
      return(name.clone());
    },
    .Executable => ()
  );
  effective_str := match(
    target_triple_opt,
    .Some(t) => t,
    .None => artifact_target.clone()
  );
  parsed_result := parse_target(effective_str);
  match(
    parsed_result,
    .Err(_) => {
      return(name.clone());
    },
    .Ok(info) => {
      if(is_target_windows(info), return(`${name}.exe`));
      if(is_target_wasm(info), {
        has_modularize := false;
        i := usize(0);
        n := c_flags.len();
        while(i < n, {
          if(c_flags(i).contains(String.from("-sMODULARIZE")), {
            has_modularize = true;
          });
          i = (i + usize(1));
        });
        ext := if(has_modularize, "js", "html");
        return(`${name}.${ext}`);
      });
      name.clone()
    }
  )
});
/// Get the target-specific output directory.
/// Layout: <project>/yo-out/<target>/bin/ or …/lib/
_get_target_output_dir :: (
  fn(
    project_dir : String,
    target_triple : String,
    kind : str
  ) -> String
)(
  `${project_dir}/yo-out/${target_triple}/${kind}`
);
// ---------------------------------------------------------------------------
// Build DAG
// ---------------------------------------------------------------------------
_walk_dag :: (
  fn(
    registry : BuildRegistry,
    nodes : HashMap(String, DAGNode),
    visited : HashMap(String, bool),
    name : String
  ) -> unit
)({
  if(visited.contains_key(name), return(()));
  visited.insert(name, true);
  match(
    registry.resolve_dependency(name.clone()),
    .None => {
      return(());
    },
    .Some(resolved) => match(
      resolved,
      .Artifact(artifact) => {
        deps := ArrayList(String).new();
        i := usize(0);
        n := artifact.linked_artifacts.len();
        while(i < n, {
          linked := artifact.linked_artifacts(i);
          deps.push(linked);
          recur(registry, nodes, visited, linked);
          i = (i + usize(1));
        });
        nodes.insert(name, DAGNode(name : name, kind : DAGNodeKind.Artifact, depends_on : deps));
      },
      .Test(_t) => {
        nodes.insert(name, DAGNode(name : name, kind : DAGNodeKind.Test, depends_on : ArrayList(String).new()));
      },
      .Run(run_step) => {
        deps := ArrayList(String).new();
        deps.push(run_step.artifact_name);
        recur(registry, nodes, visited, run_step.artifact_name);
        nodes.insert(name, DAGNode(name : name, kind : DAGNodeKind.Run, depends_on : deps));
      },
      .Doc(_d) => {
        nodes.insert(name, DAGNode(name : name, kind : DAGNodeKind.Doc, depends_on : ArrayList(String).new()));
      },
      .Step(step) => {
        deps := ArrayList(String).new();
        i := usize(0);
        n := step.dependency_names.len();
        while(i < n, {
          dep_name := step.dependency_names(i);
          deps.push(dep_name);
          recur(registry, nodes, visited, dep_name);
          i = (i + usize(1));
        });
        nodes.insert(name, DAGNode(name : name, kind : DAGNodeKind.Step, depends_on : deps));
      }
    )
  );
});
/// Build a DAG by walking the step's dependency tree.
build_dag :: (
  fn(
    registry : BuildRegistry,
    root_step_name : String
  ) -> ArrayList(DAGNode)
)({
  nodes := HashMap(String, DAGNode).new();
  visited := HashMap(String, bool).new();
  _walk_dag(registry, nodes, visited, root_step_name.clone());
  result := ArrayList(DAGNode).new();
  iter := nodes.values();
  more := true;
  while(more, {
    match(
      iter.next(),
      .None => {
        more = false;
      },
      .Some(v) => {
        result.push(v);
      }
    );
  });
  result
});
// DFS colors for cycle detection
_COLOR_WHITE :: i32(0);
_COLOR_GRAY :: i32(1);
_COLOR_BLACK :: i32(2);
_dfs_cycle :: (
  fn(
    node_map : HashMap(String, DAGNode),
    color : HashMap(String, i32),
    name : String
  ) -> Option(String)
)({
  color.insert(name, _COLOR_GRAY);
  match(
    node_map.get(name),
    .None => {
      color.insert(name, _COLOR_BLACK);
      return(Option(String).None);
    },
    .Some(node) => {
      i := usize(0);
      nd := node.depends_on.len();
      while(i < nd, {
        dep := node.depends_on(i);
        if(!(node_map.contains_key(dep)), {
          i = (i + usize(1));
        });
        dep_color := color.get(dep).unwrap_or(_COLOR_WHITE);
        if(dep_color == _COLOR_GRAY, return(Option(String).Some(dep)));
        if(dep_color == _COLOR_WHITE, {
          res := recur(node_map, color, dep);
          match(
            res,
            .Some(c) => {
              return(Option(String).Some(c));
            },
            .None => ()
          );
        });
        i = (i + usize(1));
      });
    }
  );
  color.insert(name, _COLOR_BLACK);
  Option(String).None
});
/// Detect cycles in a DAG via DFS. Returns the cycle node name if found.
detect_cycle :: (fn(dag : ArrayList(DAGNode)) -> Option(String))({
  node_map := HashMap(String, DAGNode).new();
  i := usize(0);
  n := dag.len();
  while(i < n, {
    node := dag(i);
    node_map.insert(node.name, node);
    i = (i + usize(1));
  });
  color := HashMap(String, i32).new();
  i = usize(0);
  while(i < n, {
    color.insert(dag(i).name, _COLOR_WHITE);
    i = (i + usize(1));
  });
  i = usize(0);
  while(i < n, {
    node_name := dag(i).name;
    if(color.get(node_name).unwrap_or(_COLOR_WHITE) == _COLOR_WHITE, {
      result := _dfs_cycle(node_map, color, node_name);
      match(
        result,
        .Some(c) => {
          return(Option(String).Some(c));
        },
        .None => ()
      );
    });
    i = (i + usize(1));
  });
  Option(String).None
});
// ---------------------------------------------------------------------------
// Artifact compilation
// ---------------------------------------------------------------------------
/// Compile a build artifact by invoking the Yo compiler.
// ---------------------------------------------------------------------------
// Artifact input cache (plans/INCREMENTAL_COMPILATION.md Phase A).
// A compile is SKIPPED when the sha256 over (child argv + compiler version +
// every project/std `.yo` file + yo.lock) matches the stamp recorded next to
// the output on the last successful compile. Approximations, documented:
// the system C compiler and vendor C sources are NOT stamped (the compiler
// version + argv covers the yo side); delete yo-out or set
// YO_BUILD_NO_CACHE=1 to bypass.
// ---------------------------------------------------------------------------
_read_dir_task :: (fn(dir : String, io : Io) -> Impl(Future(ArrayList(DirEntry), IoExn)))(
  io.async((e : IoExn) => {
    // Local swallow handler: read_dir on a FILE (or a vanished dir) unwinds
    // THIS task, read as `.None` at the JoinHandle below — that failure IS
    // the dir-vs-file test, so no stat is needed (the readdir-order lesson
    // still applies: names are sorted by the consumer). The unwind payload
    // must match the future's payload type or def-eval fails and silently
    // hollows this SM; the value is discarded, the task aborts either way.
    swallow := Exception(throw : ((_e) -> unwind(ArrayList(DirEntry).new())));
    e.io.await(read_dir(Path.new(dir.clone()), e.io), IoExn(io : e.io, exn : swallow))
  })
);
/// Collect `*.yo` files under `dir`, skipping build outputs and VCS/tooling
/// directories. Names are sorted per directory for a deterministic stamp —
/// read_dir order is platform-dependent (the readdir-order lesson). Each
/// directory's read_dir runs as a spawned task polled with is_finished +
/// yield (a blocking await from inside a task nests the event loop, C37);
/// breadth-first over a worklist, which visits exactly the recursion's set.
_cache_collect_yo_files :: (
  fn(dir : String, out : ArrayList(String), io : Io) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    work := ArrayList(String).new();
    work.push(dir.clone());
    (wi : usize) = usize(0);
    while(wi < work.len(), {
      d := work(wi).clone();
      wi = (wi + usize(1));
      t := e.io.spawn(_read_dir_task(d.clone(), e.io), e);
      while(runtime(!(t.is_finished())), {
        e.io.await(yield(e.io), e.io);
      });
      entries := match(t.await(e.io), .Some(es) => es, .None => ArrayList(DirEntry).new());
      names := ArrayList(String).new();
      (i : usize) = usize(0);
      while(i < entries.len(), {
        match(
          entries.get(i),
          .Some(en) => {
            names.push(en.name.clone());
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      names.sort();
      (j : usize) = usize(0);
      while(j < names.len(), {
        name := names(j);
        skip := (
          (name == "yo-out") ||
            ((name == ".git") || ((name == "node_modules") || (name.starts_with(String.from("tmp")))))
        );
        if(!(skip), {
          full := Path.new(d.clone()).join(Path.new(name.clone())).to_string();
          cond(
            name.ends_with(String.from(".yo")) => {
              out.push(full);
            },
            true => {
              // Directories are queued; the next round's read_dir on a FILE
              // unwinds its task (skipped above), so no stat is needed here.
              if(!(name.contains(String.from("."))), {
                work.push(full);
              });
            }
          );
        });
        j = (j + usize(1));
      });
    });
  })
);
_read_bytes_task :: (fn(path : String, io : Io) -> Impl(Future(ArrayList(u8), IoExn)))(
  io.async((e : IoExn) => {
    // Local swallow handler: an unreadable file unwinds THIS task, read as
    // `.None` at the JoinHandle below. The unwind payload must match the
    // future's payload type or def-eval fails and silently hollows this SM;
    // the value is discarded, the task aborts either way.
    swallow := Exception(throw : ((_e) -> unwind(ArrayList(u8).new())));
    e.io.await(read(Path.new(path.clone()), e.io), IoExn(io : e.io, exn : swallow))
  })
);
/// Read a file into the stamp accumulator; `.None` (file vanished mid-walk)
/// disables the cache for this artifact rather than mis-stamping it.
_cache_read_file :: (
  fn(path : String, io : Io) -> Impl(Future(Option(ArrayList(u8)), IoExn))
)(
  io.async((e : IoExn) => {
    t := e.io.spawn(_read_bytes_task(path.clone(), e.io), e);
    while(runtime(!(t.is_finished())), {
      e.io.await(yield(e.io), e.io);
    });
    match(
      t.await(e.io),
      .Some(bytes) => Option(ArrayList(u8)).Some(bytes),
      .None => Option(ArrayList(u8)).None
    )
  })
);
/// Append `s2` and a newline to the stamp accumulator. A module-level fn
/// rather than a local closure, so the io.async body using it stays a plain
/// statement sequence.
_stamp_push_str :: (fn(dst : ArrayList(u8), s2 : String) -> unit)({
  b := s2.as_bytes();
  (bi : usize) = usize(0);
  while(bi < b.len(), {
    dst.push(b(bi));
    bi = (bi + usize(1));
  });
  dst.push(u8(10));
});
/// The artifact's input stamp, or "" when stamping failed (cache disabled).
_artifact_input_stamp :: (
  fn(argv : ArrayList(String), project_dir : String, io : Io) -> Impl(Future(String, IoExn))
)(
  io.async((e : IoExn) => {
    acc := ArrayList(u8).new();
    _stamp_push_str(acc, `yo-version ${CURRENT_YO_VERSION}`);
    sep := String.from(" ");
    _stamp_push_str(acc, `argv ${sep.join(argv)}`);
    files := ArrayList(String).new();
    e.io.await(_cache_collect_yo_files(project_dir.clone(), files, e.io), e);
    std_root := resolve_std_path();
    if(std_root.len() > usize(0), {
      e.io.await(
        _cache_collect_yo_files(std_root.replace(String.from("file://"), String.new()), files, e.io),
        e
      );
    });
    lock_path := Path.new(project_dir.clone()).join(Path.new(String.from("yo.lock"))).to_string();
    files.push(lock_path);
    (fi : usize) = usize(0);
    while(fi < files.len(), {
      fpath := files(fi);
      bytes_opt := e.io.await(_cache_read_file(fpath.clone(), e.io), e);
      match(
        bytes_opt,
        .Some(bytes) => {
          _stamp_push_str(acc, `${fpath} ${sha256_hex(bytes)}`);
        },
        .None => {
          // yo.lock legitimately may not exist; any OTHER unreadable input
          // disables the cache.
          if(!(fpath.ends_with(String.from("yo.lock"))), {
            return(String.new());
          });
        }
      );
      fi = (fi + usize(1));
    });
    sha256_hex(acc)
  })
);
/// Read the recorded stamp next to an output, `.None` when absent.
_read_stamp :: (fn(path : String, io : Io) -> Impl(Future(Option(String), IoExn)))(
  io.async((e : IoExn) => {
    t := e.io.spawn(_read_bytes_task(path.clone(), e.io), e);
    while(runtime(!(t.is_finished())), {
      e.io.await(yield(e.io), e.io);
    });
    match(
      t.await(e.io),
      .Some(bytes) => Option(String).Some(String.from_bytes(bytes)),
      .None => Option(String).None
    )
  })
);
_write_string_task :: (fn(path : String, data : String, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async((e : IoExn) => {
    // Local swallow handler: stamp write failures unwind THIS task, read as
    // `.None` at the JoinHandle below (the cache is an optimization). The
    // unwind payload matches the future's payload — write_string's own
    // unit — or def-eval fails and silently hollows this SM.
    swallow := Exception(throw : ((_e) -> unwind(())));
    e.io.await(write_string(Path.new(path.clone()), data.clone(), e.io), IoExn(io : e.io, exn : swallow))
  })
);
/// Record the stamp; failures are silent (the cache is an optimization).
/// An EMPTY stamp (cache disabled or stamping failed) is still written: it
/// truncates the previous stamp, making the next build a guaranteed cache
/// miss — which is the correct outcome in both of those cases anyway.
_write_stamp :: (fn(path : String, stamp : String, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async((e : IoExn) => {
    t := e.io.spawn(_write_string_task(path.clone(), stamp.clone(), e.io), e);
    while(runtime(!(t.is_finished())), {
      e.io.await(yield(e.io), e.io);
    });
    match(
      t.await(e.io),
      .Some(_u) => (),
      .None => ()
    )
  })
);
compile_artifact :: (
  fn(
    artifact : BuildArtifact,
    ctx : ExecutionContext,
    io : Io,
    exn : Exception
  ) -> Impl(Future(Result(unit, String), IoExn))
)(
  io.async((e : IoExn) => {
    effective_target := match(
      ctx.target_triple,
      .Some(t) => t,
      .None => artifact.target
    );
    is_lib := match(
      artifact.kind,
      .StaticLibrary => true,
      .SharedLibrary => true,
      .Executable => false
    );
    kind_dir := if(is_lib, "lib", "bin");
    output_dir := _get_target_output_dir(ctx.project_dir.clone(), effective_target.clone(), kind_dir);
    // Create the output directory before compiling into it (src/build-runner.ts:937-939).
    // Without this the compiler is handed `-o <missing dir>/<name>` and dies with
    // a bare ENOENT — "file or directory not found" — with nothing to say which
    // path was missing. `yo build` could not build ANYTHING in a fresh project.
    e.io.await(create_dir_all(Path.new(output_dir.clone()), e.io), e);
    output_name := get_artifact_output_file_name(
      artifact.kind,
      artifact.name.clone(),
      artifact.target.clone(),
      artifact.c_flags,
      ctx.target_triple
    );
    output_path := Path.new(output_dir).join(Path.new(output_name));
    source_path := Path.new(ctx.project_dir).join(Path.new(artifact.root));
    // Byte-for-byte `src/build-runner.ts:948-956`: UNCONDITIONAL (not behind
    // --verbose), the PROJECT name (first registered module) rather than the
    // artifact's, a `git describe` suffix when the project dir is a repo, a
    // U+2192 arrow, the output path RELATIVE to the project dir, and a `.a`
    // suffix for static libraries. `tests/cli-cases/build-run` compares this
    // line.
    project_name := if(
      ctx.registry.modules.len() > usize(0),
      ctx.registry.modules(usize(0)).name,
      artifact.name.clone()
    );
    git_v := e.io.await(_git_version(ctx.project_dir.clone(), e.io, e.exn), e);
    version_suffix := match(
      git_v,
      .Some(v) => ` ${v}`,
      .None => String.new()
    );
    rel_output := Path.new(output_path.to_string()).strip_prefix(Path.new(ctx.project_dir.clone()));
    lib_suffix := match(artifact.kind, .StaticLibrary => ".a", _ => "");
    println(`Building ${project_name}${version_suffix} → ${rel_output}${lib_suffix}`);
    cmd := Command.new(_self_exe());
    cmd.arg(String.from("compile"));
    // Forward the parent's `--std-path` override to the child compile. TS
    // needs no equivalent: its build runner compiles artifacts in-process,
    // where the override already applies.
    match(
      get_std_path_override(),
      .Some(sp) => {
        cmd.arg(String.from("--std-path"));
        cmd.arg(sp);
      },
      .None => {}
    );
    cmd.arg(source_path.to_string());
    cmd.arg(String.from("-o"));
    cmd.arg(output_path.to_string());
    // TS sets the internal `emccEnvironment` to "web" for wasm targets
    // (build-runner.ts:1017/1891) because it calls codegen in-process. We shell
    // out to `compile`, so it has to travel as a flag — without it the plain
    // `compile` default (`-sNODERAWFS=1`) would leak into `yo build` output.
    eff_ti_emcc := match(
      parse_target(effective_target.clone()),
      .Ok(t) => t,
      .Err(_) => host_target()
    );
    if(is_target_wasm(eff_ti_emcc), {
      cmd.arg(String.from("--emcc-environment"));
      cmd.arg(String.from("web"));
    });
    // Pass --target whenever it is not the host. The old condition was
    // `effective_target != artifact.target`, which meant an artifact declaring
    // its OWN target — the normal case — never got one: `effective_target`
    // equals `artifact.target` unless the CLI overrides it. TS does not hit
    // this because it calls codegen IN-PROCESS with parsedTarget; we shell out,
    // so the target must travel on the command line or the child silently
    // builds for the host.
    //
    // Run 31875845879 is what that looks like: `yo build` for
    // Wasm32_Unknown_Emscripten produced yo-out/wasm32-unknown-emscripten/bin/hello-world.html
    // that was an 18 KB EXECUTABLE ELF — clang building natively, with the
    // wasm-shaped path and extension applied around it. No .js, no .wasm.
    //
    // Still skipped for the native case, deliberately: passing --target there
    // would add `--target=<host triple>` to the clang line on every ordinary
    // build, which is a cross-compile flag those proven link lines have never
    // carried.
    if((effective_target != "") && (effective_target != host_target().triple), {
      cmd.arg(String.from("--target"));
      cmd.arg(effective_target.clone());
    });
    // Force emcc for wasm targets (build-runner.ts:902-907). `compile` also
    // auto-selects it, but only from a target it can SEE — and ctx.c_compiler
    // defaults to "clang", which would otherwise be passed through explicitly
    // and defeat that auto-selection.
    eff_ti_cc := match(parse_target(effective_target.clone()), .Ok(t) => t, .Err(_) => host_target());
    if(is_target_wasm(eff_ti_cc), {
      cmd.arg(String.from("--cc"));
      cmd.arg(String.from("emcc"));
    }, {
      if(ctx.c_compiler != "clang", {
        cmd.arg(String.from("--cc"));
        cmd.arg(ctx.c_compiler);
      });
    });
    match(
      ctx.sysroot,
      .Some(s) => {
        cmd.arg(String.from("--sysroot"));
        cmd.arg(s);
      },
      .None => ()
    );
    i := usize(0);
    n := artifact.c_sources.len();
    while(i < n, {
      cmd.arg(String.from("--extern"));
      cmd.arg(artifact.c_sources(i));
      i = (i + usize(1));
    });
    i = usize(0);
    n = artifact.include_paths.len();
    while(i < n, {
      cmd.arg(String.from("-I"));
      cmd.arg(artifact.include_paths(i));
      i = (i + usize(1));
    });
    // Forward the artifact's compile options — the §9 debt in
    // plans/P1_CLI_PARITY.md. Mirrors the `codeGenerator.compileModule`
    // option mapping in `src/build-runner.ts:967-996`: `release` is true for
    // every level except debug/release-safe, `mapOptimize` sends
    // release-safe/-small to -O2 and release-fast to -O3, allocator is passed
    // unconditionally, sanitize only when not "none".
    // Only `--optimize <level>` is emitted: `yo compile` has no `--release`
    // flag any more (it was a pure alias of `--optimize 2`, removed 2026-08-28).
    optimize_num := cond(
      (artifact.optimize == "release-safe") => String.from("2"),
      (artifact.optimize == "release-fast") => String.from("3"),
      (artifact.optimize == "release-small") => String.from("2"),
      true => String.new()
    );
    if(optimize_num.len() > usize(0), {
      cmd.arg(String.from("--optimize"));
      cmd.arg(optimize_num);
    });
    cmd.arg(String.from("--allocator"));
    cmd.arg(artifact.allocator.clone());
    // `emit_c_to` redirects the generated C file. "" means unset (comptime_str
    // has no None). Resolved against the project dir, matching how `root` is
    // resolved: a path in build.yo means "relative to the project", not to
    // whatever cwd the build runs from.
    if(artifact.emit_c_to.len() > usize(0), {
      cmd.arg(String.from("--emit-c-to"));
      cmd.arg(Path.new(ctx.project_dir.clone()).join(Path.new(artifact.emit_c_to.clone())).to_string());
    });
    // Chunked C emission (plans/CHUNKED_C_EMISSION.md): 0 = off, which is the
    // default, so an unset field adds nothing to the child argv and the
    // emission stays byte-identical. The Phase A artifact stamp hashes this
    // argv, so flipping the field invalidates the build cache for free.
    if(artifact.emit_chunks > usize(0), {
      cmd.arg(String.from("--emit-chunks"));
      cmd.arg(artifact.emit_chunks.to_string());
    });
    if(artifact.sanitize != "none", {
      cmd.arg(String.from("--sanitize"));
      cmd.arg(artifact.sanitize.clone());
    });
    i = usize(0);
    n = artifact.defines.len();
    while(i < n, {
      cmd.arg(String.from("-D"));
      cmd.arg(artifact.defines(i));
      i = (i + usize(1));
    });
    i = usize(0);
    n = artifact.library_paths.len();
    while(i < n, {
      cmd.arg(String.from("-L"));
      cmd.arg(artifact.library_paths(i));
      i = (i + usize(1));
    });
    i = usize(0);
    n = artifact.link_libraries.len();
    while(i < n, {
      cmd.arg(String.from("-l"));
      cmd.arg(artifact.link_libraries(i));
      i = (i + usize(1));
    });
    if(artifact.strip, {
      cmd.arg(String.from("--strip"));
    });
    if(artifact.static_link, {
      cmd.arg(String.from("--static"));
    });
    is_static_lib := match(artifact.kind, .StaticLibrary => true, _ => false);
    if(is_static_lib, {
      cmd.arg(String.from("--static-library"));
    });
    if(artifact.c_flags.len() > usize(0), {
      joined := ` `.join(artifact.c_flags);
      cmd.arg(String.from("--cflags"));
      cmd.arg(joined);
    });
    // STREAM the child's output rather than capturing it. `src/build-runner.ts`
    // compiles in-process, so its "Generated C code written to …" / "Compiling
    // with: …" lines and every clang diagnostic land on the build's own stdout.
    // Capturing them hid compile errors from the user entirely unless the whole
    // step failed.
    // Every await-bearing step below is a TOP-LEVEL statement of this
    // async closure ON PURPOSE: an await nested inside an if-branch here
    // silently lost its continuation (the cache-skip block after it never
    // ran) — issues/async-await-in-nested-if-drops-continuation.md. The
    // unconditional exists()/read are harmless when the cache is disabled.
    cache_enabled := match(proc_env.get(`YO_BUILD_NO_CACHE`), .Some(v) => (v != "1"), .None => true);
    // The stamp is computed unconditionally (a top-level await on purpose —
    // see the comment above) and only USED when the cache is enabled; the
    // walk is exactly the work a cached build needs, and YO_BUILD_NO_CACHE
    // remains the escape hatch for it.
    stamp_raw := e.io.await(_artifact_input_stamp(cmd._args, ctx.project_dir.clone(), e.io), e);
    stamp := cond(
      cache_enabled => stamp_raw,
      true => String.new()
    );
    stamp_path := `${output_path.to_string()}.inputs-sha256`;
    // The static-library child appends `.a` itself (the same suffix the
    // Building line shows), so the existence probe must too — without it a
    // static-library artifact could never cache-hit.
    out_exists := e.io.await(exists(Path.new(`${output_path.to_string()}${lib_suffix}`), e.io), e.io);
    prev_stamp := e.io.await(_read_stamp(stamp_path.clone(), e.io), e);
    stamp_matches := match(prev_stamp, .Some(prev) => (prev == stamp), .None => false);
    use_cache := (((cache_enabled && (stamp.len() > usize(0))) && out_exists) && stamp_matches);
    if(use_cache, {
      println(`  (cached: inputs unchanged, skipping compile)`);
      return(Result(unit, String).Ok(()));
    });
    st := e.io.await(cmd.status(e.io), e);
    // The write decision is DATA, not a branch: an empty stamp (cache off or
    // stamping failed) is written as-is and truncates — see _write_stamp.
    stamp_to_write := cond(
      ((st.success() && cache_enabled) && (stamp.len() > usize(0))) => stamp.clone(),
      true => String.new()
    );
    _ := e.io.await(_write_stamp(stamp_path.clone(), stamp_to_write, e.io), e);
    cond(
      st.success() => Result(unit, String).Ok(()),
      true => {
        code := st.code().unwrap_or(i32(-1));
        Result(unit, String).Err(`Compilation failed (exit ${code})`)
      }
    )
  })
);
// ---------------------------------------------------------------------------
// Run executable
// ---------------------------------------------------------------------------
run_executable :: (
  fn(
    artifact : BuildArtifact,
    args : ArrayList(String),
    ctx : ExecutionContext,
    io : Io,
    exn : Exception
  ) -> Impl(Future(Result(unit, String), IoExn))
)(
  io.async((e : IoExn) => {
    effective_target := match(
      ctx.target_triple,
      .Some(t) => t,
      .None => artifact.target
    );
    output_dir := _get_target_output_dir(ctx.project_dir.clone(), effective_target.clone(), "bin");
    exe_name := get_artifact_output_file_name(
      artifact.kind,
      artifact.name.clone(),
      artifact.target.clone(),
      artifact.c_flags,
      ctx.target_triple
    );
    exe_path := Path.new(output_dir).join(Path.new(exe_name));
    // Missing-binary pre-flight (build-runner.ts:1918-1921): a step chain that
    // skipped the compile must fail HERE with a diagnostic, not with the
    // shell's exec error.
    exe_found := e.io.await(exists(Path.new(exe_path.to_string()), e.io), e.io);
    if(!(exe_found), {
      return(Result(unit, String).Err(`Error: Compiled executable not found at ${exe_path.to_string()}`));
    });
    // The program runs with cwd = project dir (TS spawnSync {cwd: projectDir},
    // build-runner.ts:1938-1942). `Command` has no cwd builder, so chdir
    // around the spawn — the runner is single-threaded, and the exe path is
    // made absolute FIRST so the chdir cannot invalidate it.
    (abs_exe : String) = exe_path.to_string();
    if(!(Path.new(abs_exe.clone()).is_absolute()), {
      base := match(cwd(), .Ok(cb) => cb.to_string(), .Err(_) => String.from("."));
      abs_exe = Path.new(base).join(Path.new(abs_exe.clone())).to_string();
    });
    prev_dir := match(cwd(), .Ok(pc) => pc.to_string(), .Err(_) => String.from("."));
    _cd_in := chdir(Path.new(ctx.project_dir.clone()));
    // wasm artifacts run through node on the emitted .js shim
    // (build-runner.ts:1924-1937).
    eff_ti_run := match(parse_target(effective_target.clone()), .Ok(t) => t, .Err(_) => host_target());
    cmd := if(is_target_wasm(eff_ti_run), {
      js_path := if(
        abs_exe.ends_with(".html"),
        `${abs_exe.substring(usize(0), (abs_exe.len() - usize(5)))}.js`,
        abs_exe.clone()
      );
      wcmd := Command.new(String.from("node"));
      wcmd.arg(js_path);
      wcmd
    }, Command.new(abs_exe.clone()));
    i := usize(0);
    n := args.len();
    while(i < n, {
      cmd.arg(args(i));
      i = (i + usize(1));
    });
    // Streamed, not captured: `runExecutable` in src/build-runner.ts spawns with
    // `stdio: "inherit"`, so the program the user asked to run writes to the
    // user's terminal. Capturing swallowed its output entirely.
    st := e.io.await(cmd.status(e.io), e);
    _cd_back := chdir(Path.new(prev_dir));
    if(st.success(), Result(unit, String).Ok(()), {
      code := st.code().unwrap_or(i32(-1));
      Result(unit, String).Err(`Executable exited with code ${code}`)
    })
  })
);
// ---------------------------------------------------------------------------
// Test suite
// ---------------------------------------------------------------------------
run_test_suite :: (
  fn(
    suite : BuildTestSuite,
    ctx : ExecutionContext,
    io : Io,
    exn : Exception
  ) -> Impl(Future(Result(unit, String), IoExn))
)(
  io.async((e : IoExn) => {
    test_path := Path.new(ctx.project_dir).join(Path.new(suite.root));
    cmd := Command.new(_self_exe());
    cmd.arg(String.from("test"));
    // Forward the build's C compiler to the child test run (TS passes
    // cCompiler through runTests, build-runner.ts:1955-1978; hollow before
    // the runner's own --cc forwarding landed in P2.5 step 5).
    cmd.arg(String.from("--c-compiler"));
    cmd.arg(ctx.c_compiler.clone());
    // Forward the parent's `--std-path` override to the child test run (same
    // rationale as the compile_artifact forwarding above).
    match(
      get_std_path_override(),
      .Some(sp) => {
        cmd.arg(String.from("--std-path"));
        cmd.arg(sp);
      },
      .None => {}
    );
    cmd.arg(test_path.to_string());
    // Suite excludes are project-relative; the child test runner resolves
    // `--exclude` against its CWD, so anchor them to the project dir (TS
    // does the same in-process via path.resolve(projectDir, e)).
    (exi : usize) = usize(0);
    while(exi < suite.exclude.len(), {
      match(
        suite.exclude.get(exi),
        .Some(ex) => {
          cmd.arg(String.from("--exclude"));
          cmd.arg(Path.new(ctx.project_dir.clone()).join(Path.new(ex.clone())).to_string());
        },
        .None => {}
      );
      exi = (exi + usize(1));
    });
    if(suite.verbose, {
      _arg_c := cmd.arg(String.from("--verbose"));
    });
    if(suite.bail, {
      _arg_c := cmd.arg(String.from("--bail"));
    });
    if(suite.parallel > i32(1), {
      cmd.arg(String.from("--parallel"));
      cmd.arg(suite.parallel.to_string());
    });
    if(ctx.verbose, {
      _arg_c := cmd.arg(String.from("--verbose"));
    });
    // Streamed, not captured — `runTestSuite` in src/build-runner.ts inherits
    // stdio, so the test runner's own report is the point of running it.
    st := e.io.await(cmd.status(e.io), e);
    if(st.success(), Result(unit, String).Ok(()), {
      code := st.code().unwrap_or(i32(-1));
      Result(unit, String).Err(`Tests failed (exit ${code})`)
    })
  })
);
/// Run a documentation step, mapping any thrown error to `false` (TS wraps
/// runDocGeneration in try/catch, build-runner.ts:745-757).
_run_doc_step :: (fn(opts : DocCommandOptions, io : Io) -> bool)({
  doc_exn := Exception(
    throw : (
      (doc_err) -> {
        eprintln(`doc step failed: ${doc_err.to_string()}`);
        unwind(false);
      }
    )
  );
  run_doc(opts, io, doc_exn);
  true
});
/// Append every element of `src` onto `dst` (ArrayList has no extend()).
_push_all_strings :: (fn(dst : ArrayList(String), src : ArrayList(String)) -> unit)({
  (pa_i : usize) = usize(0);
  while(pa_i < src.len(), {
    match(
      src.get(pa_i),
      .Some(s) => {
        _p := dst.push(s.clone());
      },
      .None => ()
    );
    pa_i = (pa_i + usize(1));
  });
});
// ---------------------------------------------------------------------------
// Node execution
// ---------------------------------------------------------------------------
/// Execute a single DAG node.
execute_node :: (
  fn(
    node : DAGNode,
    ctx : ExecutionContext,
    io : Io,
    exn : Exception
  ) -> Impl(Future(StepResult, IoExn))
)(
  io.async((e : IoExn) => {
    description := node.name.clone();
    success := true;
    match(
      node.kind,
      .Artifact => {
        match(
          ctx.registry.find_artifact(node.name.clone()),
          .None => (),
          .Some(artifact) => {
            kind_label := match(
              artifact.kind,
              .StaticLibrary => "lib",
              .SharedLibrary => "shared lib",
              .Executable => "exe"
            );
            description = `compile ${kind_label} ${artifact.name}`;
            result := e.io.await(compile_artifact(artifact, ctx, e.io, e.exn), e);
            match(
              result,
              .Ok(_) => (),
              .Err(err) => {
                println(`Compilation error: ${err}`);
                success = false;
              }
            );
          }
        );
      },
      .Test => {
        match(
          ctx.registry.find_test(node.name.clone()),
          .None => (),
          .Some(suite) => {
            description = `test ${suite.name}`;
            result := e.io.await(run_test_suite(suite, ctx, e.io, e.exn), e);
            match(
              result,
              .Ok(_) => (),
              .Err(_) => {
                success = false;
              }
            );
          }
        );
      },
      .Run => {
        match(
          ctx.registry.find_run_step(node.name.clone()),
          .None => (),
          .Some(run_step) => {
            description = `run ${run_step.artifact_name}`;
            match(
              ctx.registry.find_artifact(run_step.artifact_name.clone()),
              .None => (),
              .Some(artifact) => {
                result := e.io.await(run_executable(artifact, run_step.args, ctx, e.io, e.exn), e);
                match(
                  result,
                  .Ok(_) => (),
                  .Err(_) => {
                    success = false;
                  }
                );
              }
            );
          }
        );
      },
      .Step => (),
      .Doc => {
        match(
          ctx.registry.find_documentation(node.name.clone()),
          .None => (),
          .Some(doc_cfg) => {
            description = `doc ${doc_cfg.name}`;
            // Actually generate the documentation (runDocGeneration,
            // src/build-runner.ts:745-757 + :1987-2010). Previously this arm
            // printed success and ran nothing — `yo init` scaffolds a doc
            // step, so every scaffolded project's `yo build doc` was hollow.
            println(`Generating documentation: ${doc_cfg.name}`);
            doc_root := Path.new(ctx.project_dir.clone()).join(Path.new(doc_cfg.root.clone())).to_string();
            doc_out := Path.new(ctx.project_dir.clone()).join(Path.new(doc_cfg.output_dir.clone())).to_string();
            doc_fmt := if(doc_cfg.format.len() == usize(0), String.from("html"), doc_cfg.format.clone());
            doc_ok := _run_doc_step(
              DocCommandOptions(
                input : doc_root,
                output_dir : doc_out,
                include_private : doc_cfg.include_private,
                verbose : ctx.verbose,
                title : doc_cfg.title.clone(),
                format : doc_fmt,
                version : doc_cfg.version.clone()
              ),
              io
            );
            if(!(doc_ok), {
              success = false;
            });
          }
        );
      }
    );
    StepResult(
      name : node.name,
      kind : node.kind,
      success : success,
      duration_ms : i64(0),
      description : description
    )
  })
);
// ---------------------------------------------------------------------------
// DAG executor (Kahn's algorithm)
// ---------------------------------------------------------------------------
/// Execute nodes in dependency order (Kahn's algorithm).
execute_dag :: (
  fn(
    dag : ArrayList(DAGNode),
    ctx : ExecutionContext,
    io : Io,
    exn : Exception
  ) -> Impl(Future(HashMap(String, StepResult), IoExn))
)(
  io.async((e : IoExn) => {
    results := HashMap(String, StepResult).new();
    n := dag.len();
    if(n == usize(0), return(results));
    in_degree := HashMap(String, i32).new();
    completed := HashMap(String, bool).new();
    // Compute initial in-degrees
    i := usize(0);
    while(i < n, {
      node := dag(i);
      if(!(in_degree.contains_key(node.name)), {
        in_degree.insert(node.name, i32(0));
      });
      j := usize(0);
      nd := node.depends_on.len();
      while(j < nd, {
        dep := node.depends_on(j);
        // Only count if dep is in the dag
        k := usize(0);
        dep_in_dag := false;
        while(k < n, {
          if(dag(k).name == dep, {
            dep_in_dag = true;
          });
          k = (k + usize(1));
        });
        if(dep_in_dag, {
          cur := in_degree.get(node.name).unwrap_or(i32(0));
          in_degree.insert(node.name, cur + i32(1));
        });
        j = (j + usize(1));
      });
      i = (i + usize(1));
    });
    // Kahn's algorithm
    while(completed.len() < n, {
      ready := ArrayList(DAGNode).new();
      i = usize(0);
      while(i < n, {
        node := dag(i);
        if(!(completed.contains_key(node.name)) && (in_degree.get(node.name).unwrap_or(i32(0)) == i32(0)), {
          ready.push(node);
        });
        i = (i + usize(1));
      });
      if(ready.len() == usize(0), {
        e.exn.throw(dyn(String.from("Error: Build DAG stalled — possible undetected cycle.")));
      });
      // Execute ready nodes
      rn := ready.len();
      k := usize(0);
      while(k < rn, {
        node := ready(k);
        result := e.io.await(execute_node(node, ctx, e.io, e.exn), e);
        results.insert(node.name, result);
        k = (k + usize(1));
      });
      // Mark complete and update in-degrees
      k = usize(0);
      while(k < rn, {
        completed_name := ready(k).name;
        completed.insert(completed_name, true);
        // Decrement in-degree of all not-yet-completed nodes that depend on this
        m := usize(0);
        while(m < n, {
          other := dag(m);
          if(!(completed.contains_key(other.name)), {
            j := usize(0);
            nd := other.depends_on.len();
            while(j < nd, {
              dep := other.depends_on(j);
              if(dep == completed_name, {
                cur := in_degree.get(other.name).unwrap_or(i32(1));
                in_degree.insert(other.name, cur - i32(1));
              });
              j = (j + usize(1));
            });
          });
          m = (m + usize(1));
        });
        k = (k + usize(1));
      });
    });
    results
  })
);
// ---------------------------------------------------------------------------
// Build summary
// ---------------------------------------------------------------------------
_print_summary_node :: (
  fn(
    node : DAGNode,
    results : HashMap(String, StepResult),
    node_map : HashMap(String, DAGNode),
    line_prefix : String,
    children_prefix : String,
    is_root : bool
  ) -> unit
)({
  status_str := match(
    results.get(node.name),
    .None => String.from("skipped"),
    .Some(r) => if(r.success, String.from("ok"), String.from("FAILED"))
  );
  desc := match(
    results.get(node.name),
    .None => node.name,
    .Some(r) => r.description
  );
  if(
    is_root,
    println(`${desc} ${status_str}`),
    println(`${line_prefix}${desc} ${status_str}`)
  );
  nd := node.depends_on.len();
  i := usize(0);
  while(i < nd, {
    dep_name := node.depends_on(i);
    match(
      node_map.get(dep_name),
      .None => (),
      .Some(child) => {
        is_last := (i == (nd - usize(1)));
        connector := if(is_last, "└── ", "├── ");
        next_child_pfx := if(is_last, "    ", "│   ");
        recur(
          child,
          results,
          node_map,
          `${children_prefix}${connector}`,
          `${children_prefix}${next_child_pfx}`,
          false
        );
      }
    );
    i = (i + usize(1));
  });
});
print_build_summary :: (
  fn(
    results : HashMap(String, StepResult),
    dag : ArrayList(DAGNode),
    root_name : String
  ) -> unit
)({
  n := dag.len();
  total := n;
  succeeded := usize(0);
  i := usize(0);
  while(i < n, {
    match(
      results.get(dag(i).name),
      .None => (),
      .Some(r) => {
        if(r.success, {
          succeeded = (succeeded + usize(1));
        });
      }
    );
    i = (i + usize(1));
  });
  println("");
  println(`Build Summary: ${succeeded}/${total} steps succeeded`);
  // Find root node and print tree
  i = usize(0);
  while(i < n, {
    if(dag(i).name == root_name, {
      node_map := HashMap(String, DAGNode).new();
      j := usize(0);
      while(j < n, {
        nd := dag(j);
        node_map.insert(nd.name, nd);
        j = (j + usize(1));
      });
      _print_summary_node(dag(i), results, node_map, String.new(), String.new(), true);
    });
    i = (i + usize(1));
  });
});
// ---------------------------------------------------------------------------
// Step execution
// ---------------------------------------------------------------------------
execute_step :: (
  fn(
    step_name : String,
    ctx : ExecutionContext,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    match(
      ctx.registry.find_step(step_name),
      .None => {
        available := ctx.registry.get_step_names();
        names_str := String.new();
        i := usize(0);
        n := available.len();
        while(i < n, {
          if(i > usize(0), names_str.push_str(", "));
          names_str.push_string(available(i).clone());
          i = (i + usize(1));
        });
        if(names_str.len() == usize(0), names_str.push_str("(none)"));
        e.exn.throw(dyn(`Error: Unknown step "${step_name}". Available: ${names_str}`));
      },
      .Some(_) => ()
    );
    dag := build_dag(ctx.registry, step_name);
    match(
      detect_cycle(dag),
      .Some(cycle_node) => {
        e.exn.throw(dyn(`Error: Cycle in build DAG involving "${cycle_node}"`));
      },
      .None => ()
    );
    results := e.io.await(execute_dag(dag, ctx, e.io, e.exn), e);
    if(ctx.summary, print_build_summary(results, dag, step_name));
    // A failed step must fail the build. execute_node folds per-step errors
    // into StepResult.success so the DAG finishes and the summary can show
    // WHICH step broke — but exiting 0 after a failed compile would let CI
    // pass silently. Mirrors runBuild (src/build-runner.ts). See
    // issues/fixed/yo-build-exits-zero-on-failed-step.md
    (any_failed : bool) = false;
    (ri : usize) = usize(0);
    while(ri < dag.len(), {
      match(
        results.get(dag(ri).name),
        .Some(r) => if(!(r.success), {
          any_failed = true;
        }),
        .None => ()
      );
      ri = (ri + usize(1));
    });
    if(any_failed, {
      unsafe(exit(int(1)));
    });
  })
);
// ---------------------------------------------------------------------------
/// Byte-for-byte `printSteps` (src/build-runner.ts:342-354): the header wording,
/// the empty-registry line, and the TAB between name and description are all
/// load-bearing — `tests/cli-cases/build-list-steps` diffs this stdout against
/// the reference compiler's.
print_steps :: (fn(registry : BuildRegistry) -> unit)({
  steps := registry.steps;
  n := steps.len();
  if(n == usize(0), {
    println("No build steps defined.");
    return(());
  });
  println("Available steps:");
  i := usize(0);
  while(i < n, {
    step := steps(i);
    is_default := if(step.name == "install", " (default)", "");
    println(`  ${step.name}${is_default}\t${step.description}`);
    i = (i + usize(1));
  });
});
// ---------------------------------------------------------------------------
// Build file evaluation
// ---------------------------------------------------------------------------
/// Evaluate a `build.yo` file and return the `BuildRegistry` its
/// `build.executable(...)` / `build.step(...)` / … calls populated.
///
/// This used to shell out to `yo-cli build --serialize-registry` and parse JSON
/// from stdout. That flag DOES NOT EXIST in `src/` (zero grep hits), and the
/// JSON parser was `BuildRegistry.new()` — it ignored its input entirely — so
/// `yo build` built an empty DAG and exited 0. See plans/P1_CLI_PARITY.md §3.
///
/// The real thing, mirroring `src/build-runner.ts`: clear the global registry,
/// evaluate the file through the module manager (the builtins mutate the
/// registry as a side effect of evaluation), then read the registry back.
///
/// Evaluation errors are SWALLOWED, exactly as in TS: "the evaluator populates
/// the registry during compile-time evaluation; some errors are expected if the
/// build file has runtime components." A partially-populated registry is the
/// intended outcome there, not a failure.
evaluate_build_file :: (
  fn(
    build_file : String,
    defines : HashMap(String, String),
    io : Io,
    exn : Exception
  ) -> Impl(Future(BuildRegistry, IoExn))
)(
  io.async((e : IoExn) => {
    clear_build_registry();
    // Seed `-Dname=value` overrides BEFORE evaluating: `build.option(...)`
    // reads `cli_options` at evaluation time and returns the override in place
    // of its declared default.
    reg := get_build_registry();
    reg.cli_options = defines;
    _outcome := mm_load_yo_file(build_file, e.io, e.exn);
    mm_reset();
    get_build_registry()
  })
);
// ---------------------------------------------------------------------------
// Exports
run_build :: (
  fn(
    options : BuildOptions,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    build_file_path := Path.new(options.build_file);
    build_file_exists := e.io.await(exists(build_file_path, e.io), e.io);
    if(!(build_file_exists), {
      e.exn.throw(dyn(`Error: Build file not found: ${build_file_path.to_string()}`));
    });
    // `path.dirname` semantics, which is what src/build-runner.ts uses. Yo's
    // `Path.parent()` follows Rust — `Path::new("foo").parent()` is `Some("")` —
    // so the default `./build.yo` yielded an EMPTY project dir, and every derived
    // path became absolute: the output dir was `/yo-out/<target>/bin`, and
    // `yo build` died with a bare "read-only filesystem" (macOS's root volume).
    // `yo build` could not build anything from a relative build file.
    project_dir := match(
      build_file_path.parent(),
      .Some(p) => {
        ps := p.to_string();
        if(ps.len() == usize(0), String.from("."), ps)
      },
      .None => String.from(".")
    );
    c_compiler := match(
      options.c_compiler,
      .Some(cc) => cc,
      .None => String.from("clang")
    );
    // Evaluate build.yo to populate the registry.
    registry := e.io.await(
      evaluate_build_file(
        build_file_path.to_string(),
        options.defines,
        e.io,
        e.exn
      ),
      e
    );
    if(options.list_steps, {
      print_steps(registry);
      return(());
    });
    // Fetch git dependencies before building (build-runner.ts:216-232).
    // setRootBuildProjectDir + fetchTransitiveDependencies belong to the
    // step-11 dependency-subsystem decision (plans/P2_5_RETIRE_EXECUTION.md)
    // and are not yet ported — this is the direct-dependency wiring only.
    if(registry.dependencies.len() > usize(0), {
      deps_cached := e.io.await(are_deps_cached(project_dir.clone(), registry.dependencies, e.io, e.exn), e);
      if(!(deps_cached), {
        if(options.verbose, {
          println(String.from("Dependencies not cached — fetching..."));
        });
        _fetched := e.io.await(fetch_all_deps(project_dir.clone(), registry.dependencies, options.verbose, false, e.io, e.exn), e);
      }, {
        if(options.verbose, {
          println(String.from("All dependencies cached."));
        });
      });
    });
    // Resolve system libraries per-artifact via pkg-config
    // (build-runner.ts:234-275). Each artifact only gets flags for libraries
    // it explicitly linked; wasm targets skip host pkg-config/vcpkg (paths
    // are incompatible) but still add `-l<name>` for the emscripten linker.
    if(registry.system_libraries.len() > usize(0), {
      (sa_i : usize) = usize(0);
      while(sa_i < registry.artifacts.len(), {
        art_opt := registry.artifacts.get(sa_i);
        sa_i = (sa_i + usize(1));
        match(
          art_opt,
          .Some(art) => if(art.linked_system_libs.len() > usize(0), {
            linked := ArrayList(BuildSystemLibrary).new();
            (sl_i : usize) = usize(0);
            while(sl_i < registry.system_libraries.len(), {
              match(
                registry.system_libraries.get(sl_i),
                .Some(slib) => {
                  (is_linked : bool) = false;
                  (ln_i : usize) = usize(0);
                  while((ln_i < art.linked_system_libs.len()) && !(is_linked), {
                    match(
                      art.linked_system_libs.get(ln_i),
                      .Some(ln) => if(ln == slib.name, {
                        is_linked = true;
                      }),
                      .None => ()
                    );
                    ln_i = (ln_i + usize(1));
                  });
                  if(is_linked, {
                    linked.push(slib);
                  });
                },
                .None => ()
              );
              sl_i = (sl_i + usize(1));
            });
            if(linked.len() > usize(0), {
              eff_target := match(options.target_triple, .Some(t) => t, .None => art.target.clone());
              eff_ti := match(parse_target(eff_target.clone()), .Ok(t) => t, .Err(_) => host_target());
              if(is_target_wasm(eff_ti), {
                (wl_i : usize) = usize(0);
                while(wl_i < linked.len(), {
                  match(
                    linked.get(wl_i),
                    .Some(wlib) => {
                      (already : bool) = false;
                      (al_i : usize) = usize(0);
                      while((al_i < art.link_libraries.len()) && !(already), {
                        match(
                          art.link_libraries.get(al_i),
                          .Some(aln) => if(aln == wlib.name, {
                            already = true;
                          }),
                          .None => ()
                        );
                        al_i = (al_i + usize(1));
                      });
                      if(!(already), {
                        art.link_libraries.push(wlib.name.clone());
                      });
                    },
                    .None => ()
                  );
                  wl_i = (wl_i + usize(1));
                });
              }, {
                sys_flags := e.io.await(resolve_all_system_libraries(linked, options.verbose, e.io, e.exn), e);
                _push_all_strings(art.include_paths, sys_flags.include_paths);
                _push_all_strings(art.library_paths, sys_flags.library_paths);
                _push_all_strings(art.link_libraries, sys_flags.link_libraries);
                _push_all_strings(art.defines, sys_flags.defines);
                _push_all_strings(art.c_flags, sys_flags.c_flags);
                (rf_i : usize) = usize(0);
                while(rf_i < sys_flags.runtime_files.len(), {
                  match(
                    sys_flags.runtime_files.get(rf_i),
                    .Some(rf) => {
                      (rf_seen : bool) = false;
                      (rfe_i : usize) = usize(0);
                      while((rfe_i < art.runtime_files.len()) && !(rf_seen), {
                        match(
                          art.runtime_files.get(rfe_i),
                          .Some(rfe) => if(rfe == rf, {
                            rf_seen = true;
                          }),
                          .None => ()
                        );
                        rfe_i = (rfe_i + usize(1));
                      });
                      if(!(rf_seen), {
                        art.runtime_files.push(rf.clone());
                      });
                    },
                    .None => ()
                  );
                  rf_i = (rf_i + usize(1));
                });
              });
            });
          }),
          .None => ()
        );
      });
    });
    ctx := ExecutionContext(
      registry : registry,
      project_dir : project_dir,
      c_compiler : c_compiler,
      target_triple : options.target_triple,
      sysroot : options.sysroot,
      verbose : options.verbose,
      dry_run : options.dry_run,
      summary : options.summary
    );
    requested := if(options.steps.len() == usize(0), {
      defaults := ArrayList(String).new();
      defaults.push(String.from("install"));
      defaults
    }, options.steps);
    i := usize(0);
    n := requested.len();
    while(i < n, {
      step_name := requested(i).clone();
      // `--dry-run` names the steps and executes NOTHING (src/build-runner.ts:293-297).
      // It was accepted and ignored here, so `yo build --dry-run` did a full build.
      if(options.dry_run, {
        println(`[dry-run] Would execute step: ${step_name}`);
      }, {
        e.io.await(execute_step(step_name, ctx, e.io, e.exn), e);
      });
      i = (i + usize(1));
    });
  })
);
