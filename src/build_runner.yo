//! Build runner — `yo build` implementation.
//!
//! Evaluates `build.yo` using the Yo evaluator.  Build functions
//! (build.executable, build.test, etc.) populate a `BuildRegistry`.
//! After evaluation the runner reads the registry and orchestrates
//! compilation for each artifact.
//!
//! Mirrors `src/build-runner.ts`.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ println, eprintln } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ Exception, IoExn } :: import("std/error");
{ Path } :: import("std/path");
{ cwd, chdir } :: import("std/env");
// Imported under an alias: `args` collides with the `args` parameter/field used
// throughout this file (`run_step.args`). Same rename form main.yo uses for `env`.
_(args : proc_args) :: import("std/env");
{ exists, read, write_string } :: import("std/fs/file");
{ read_dir, DirEntry, symlink, remove_file } :: import("std/fs/dir");
{ platform, Platform } :: import("std/process");
{ get_global_cache_dir, store_tree_dir } :: import("./cache.yo");
{ parse_lock_file } :: import("./lock_file.yo");
{ sha256_hex } :: import("std/crypto/sha256");
{ CURRENT_YO_VERSION } :: import("./version.yo");
_(env : proc_env) :: import("std/env");
{ create_dir_all } :: import("std/fs/dir");
{ Command, Output, ExitStatus } :: import("std/process/command");
{ error_format, emit_rendered_text } :: import("./diagnostics.yo");
{ yield } :: import("std/async");
{ mm_load_yo_file, mm_reset, get_std_path_override, resolve_std_path, _take_load_error } :: import("./module_manager.yo");
{ exit } :: import("std/libc/stdlib");
{ Instant } :: import("std/time/instant");
{
  ArtifactKind,
  BuildArtifact,
  BuildTestSuite,
  BuildRunStep,
  BuildStep,
  BuildDocConfig,
  BuildModuleEntry,
  BuildRegistry,
  ResolvedDep,
  BuildSystemLibrary,
  get_build_registry,
  clear_build_registry,
  swap_build_registry
} :: import("./evaluator/builtins/build.yo");
{
  Manifest,
  ImportRoot,
  ImportRoots,
  UnavailableImport,
  MANIFEST_FILENAME,
  find_manifest,
  load_manifest,
  resolve_import_roots,
  read_lock_text,
  dependency_dir,
  file_exists_sync
} :: import("./manifest.yo");
{ install_dependencies } :: import("./install_command.yo");
{ ResolveMode } :: import("./resolver.yo");
{ resolve_all_system_libraries } :: import("./pkg_config.yo");
{ DocCommandOptions, run_doc } :: import("./doc_command.yo");
{ TargetInfo, parse_target, host_target, is_target_windows, is_target_macos, is_target_wasm } :: import("./target.yo");
// ---------------------------------------------------------------------------
// Build options  (mirrors TypeScript BuildOptions interface)
// ---------------------------------------------------------------------------
BuildOptions :: ref(
  struct(
    build_file : String,
    target_triple : Option(String),
    verbose : bool,
    dry_run : bool,
    list_steps : bool,
    /// `--list-options`: print the options this build file DECLARES (name,
    /// default, description) and build nothing. The docs promised `yo build
    /// --help` would list them, and nothing ever did (the plan's B4).
    list_options : bool,
    /// Everything after `--`, handed to whatever a `run` step executes.
    run_args : ArrayList(String),
    /// `-j N` / `--jobs N`: nodes per DAG level to run at once (default 1).
    jobs : usize,
    steps : ArrayList(String),
    defines : HashMap(String, String),
    c_compiler : Option(String),
    sysroot : Option(String),
    summary : bool,
    /// `--locked`: fail if fetching dependencies would change `yo.lock`.
    locked : bool,
    /// `--offline`: fail if fetching dependencies would need the network.
    offline : bool
  )
);
// ---------------------------------------------------------------------------
// DAG types
// ---------------------------------------------------------------------------
DAGNodeKind :: enum(Artifact, Test, Run, Step, Doc);
DAGNode :: ref(
  struct(
    name : String,
    kind : DAGNodeKind,
    depends_on : ArrayList(String)
  )
);
StepResult :: ref(
  struct(
    name : String,
    kind : DAGNodeKind,
    success : bool,
    duration_ms : i64,
    description : String
  )
);
ExecutionContext :: ref(
  struct(
    registry : BuildRegistry,
    project_dir : String,
    /// `[package] name` of the project's `yo.toml` ("" without one) — the
    /// name the "Building …" line prints.
    project_name : String,
    c_compiler : String,
    target_triple : Option(String),
    sysroot : Option(String),
    verbose : bool,
    dry_run : bool,
    summary : bool,
    /// Everything after `--` on the `yo build` command line: the arguments a
    /// `run` step hands to the program it runs. `BuildRunStep.args` was always
    /// empty and there was no way to pass any (the plan's B9).
    run_args : ArrayList(String),
    /// `-j N`: how many nodes of one DAG level may run at once (§4.8). 1 keeps
    /// their output in DAG order, which every recorded golden depends on.
    jobs : usize
  )
);
/// `git describe --tags --always` in the project dir, or `.None` when that fails
/// for any reason (not a repo, no git, non-zero exit, empty output). Mirrors
/// `getGitVersion` (src/build-runner.ts:1417-1429), whose entire body is a
/// try/catch returning undefined — the version is decoration on the "Building …"
/// line, never a reason to fail a build.
_git_output_task :: (fn(cmd : Command, io : Io) -> Impl(Future(Output, IoExn)))(
  io.async((e : IoExn) => {
    // Local swallow handler: a missing git / spawn failure must unwind THIS
    // task (read as `.None` at the JoinHandle below), never reach the
    // build's own handler and fail the build. The unwind payload must match
    // the future's payload type — any other type fails def-eval and silently
    // hollows this SM (the C22-adjacent swallow hole); the value itself is
    // discarded, the task aborts either way.
    swallow := Exception(
      throw : (
        (_e) -> unwind(
          Output(
            status : ExitStatus(raw : i32(0)),
            stdout : ArrayList(u8).new(),
            stderr : ArrayList(u8).new()
          )
        )
      )
    );
    e.io.await(cmd.output(e.io), IoExn(io : e.io, exn : swallow))
  })
);
_git_version :: (
  fn(
    project_dir : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(Option(String), IoExn))
)(
  io.async((e : IoExn) => {
    // `git -C <dir>` rather than a cwd on the Command — `std/process/command.yo`
    // has no `current_dir`, and this is git's own equivalent of TS's
    // `execSync(..., { cwd: projectDir })`. The output future runs as a
    // SPAWNED TASK polled with is_finished + yield: a blocking await from
    // inside a task nests the event loop (C37), and awaiting an aborted
    // future directly would discard this closure's continuation.
    cmd := Command.new(String.from("git"));
    cmd.arg(String.from("-C"));
    cmd.arg(project_dir);
    cmd.arg(String.from("describe"));
    cmd.arg(String.from("--tags"));
    cmd.arg(String.from("--always"));
    t := e.io.spawn(_git_output_task(cmd, e.io), e);
    while(runtime(!(t.is_finished())), {
      e.io.await(yield(e.io), e.io);
    });
    out_opt := t.await(e.io);
    out := match(out_opt, .Some(o) => o, .None => return(Option(String).None));
    if(!(out.status.success()), return(Option(String).None));
    v := String.from_bytes(out.stdout).trim();
    if(v.len() == usize(0), Option(String).None, Option(String).Some(v))
  })
);
/// The compiler binary to invoke for sub-steps (artifact compiles, test runs).
///
/// `src/build-runner.ts` compiles IN PROCESS (`codeGenerator.compileModule`) —
/// it never shells out — so the reference implementation cannot pick up a
/// stranger's binary. yo-self shells out instead, and used the literal name
/// `yo-cli`, resolved through `PATH`. In a clean sandbox that resolved to an
/// unrelated globally-installed `yo` package, so every `build run` failed with
/// a yargs stack trace (caught by `tests/cli-cases/build-run`).
///
/// `argv[0]` is this binary, which is the only correct answer for a self-hosted
/// compiler: `yo build` must invoke the compiler the user actually ran, not
/// whatever `PATH` happens to offer. Falls back to the old name only if
/// `argv[0]` is somehow empty.
_self_exe :: (fn() -> String)({
  argv := proc_args();
  if(argv.len() == usize(0), return(String.from("yo-cli")));
  a0 := argv(usize(0));
  if(a0.len() == usize(0), String.from("yo-cli"), a0)
});
// ---------------------------------------------------------------------------
// Artifact output file name
// ---------------------------------------------------------------------------
/// Compute the output file name for a build artifact.
/// Mirrors `getArtifactOutputFileName` in build-runner.ts.
get_artifact_output_file_name :: (
  fn(
    kind : ArtifactKind,
    name : String,
    artifact_target : String,
    c_flags : ArrayList(String),
    target_triple_opt : Option(String)
  ) -> String
)({
  match(
    kind,
    .StaticLibrary => {
      return(`lib${name}`);
    },
    .SharedLibrary => {
      // The platform extension is appended by the child compile, exactly as
      // `.a` is for a static library (plan §4.5.4).
      return(`lib${name}`);
    },
    .Executable => ()
  );
  effective_str := match(
    target_triple_opt,
    .Some(t) => t,
    .None => artifact_target.clone()
  );
  parsed_result := parse_target(effective_str);
  match(
    parsed_result,
    .Err(_) => {
      return(name.clone());
    },
    .Ok(info) => {
      if(is_target_windows(info), return(`${name}.exe`));
      if(is_target_wasm(info), {
        has_modularize := false;
        i := usize(0);
        n := c_flags.len();
        while(i < n, {
          if(c_flags(i).contains(String.from("-sMODULARIZE")), {
            has_modularize = true;
          });
          i = (i + usize(1));
        });
        ext := if(has_modularize, "js", "html");
        return(`${name}.${ext}`);
      });
      name.clone()
    }
  )
});
/// Get the target-specific output directory.
/// Layout: <project>/yo-out/<target>/bin/ or …/lib/
_get_target_output_dir :: (
  fn(
    project_dir : String,
    target_triple : String,
    kind : str
  ) -> String
)(
  `${project_dir}/yo-out/${target_triple}/${kind}`
);
/// Where ONE artifact's output goes. A dependency's artifact (§4.5.2) is not
/// this project's output: it lands under `deps/<package>/`, so two packages
/// may define a `lib` of the same name and neither shadows ours.
_artifact_output_dir :: (
  fn(
    artifact : BuildArtifact,
    project_dir : String,
    target_triple : String,
    kind : str
  ) -> String
)(
  if(
    artifact.package_name.len() == usize(0),
    _get_target_output_dir(project_dir.clone(), target_triple.clone(), kind),
    `${project_dir}/yo-out/${target_triple}/deps/${artifact.package_name}/${kind}`
  )
);
// ---------------------------------------------------------------------------
// Import roots — the manifest's closure → the child compile's `--imports` file
// ---------------------------------------------------------------------------
/// The `name=/abs/root.yo` lines every artifact's compile receives as
/// `--imports` (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.5.1): the
/// project's `[modules]`, each dependency's modules under its name and,
/// transitively, the dependencies' own dependencies — the closure
/// `manifest.resolve_import_roots` computes. One flat mapping for the whole
/// project: a dependency's modules import THEIR dependencies by name too, and
/// they are compiled as part of this project's artifacts. Empty for a project
/// without `yo.toml`. Set by `resolve_build_import_roots`.
(g_import_lines : ArrayList(String)) = ArrayList(String).new();
/// The project's manifest — the nearest `yo.toml` at or above `project_dir`
/// — or `.None` when it has none. A manifest that does not parse fails the
/// build with its message.
project_manifest :: (fn(project_dir : String, exn : Exception) -> Option(Manifest))(
  match(
    find_manifest(project_dir),
    .None => Option(Manifest).None,
    .Some(path) => match(
      load_manifest(path, exn),
      .Ok(m) => Option(Manifest).Some(m),
      .Err(msg) => {
        exn.throw(dyn(`Error: ${msg}`));
        Option(Manifest).None
      }
    )
  )
);
/// The manifest's import-root closure, or the build error it reports.
_manifest_roots :: (fn(manifest : Manifest, exn : Exception) -> ImportRoots)(
  match(
    resolve_import_roots(manifest, read_lock_text(manifest, exn), exn),
    .Ok(r) => r,
    .Err(msg) => {
      exn.throw(dyn(`Error: ${manifest.path}: ${msg}`));
      ImportRoots(roots : ArrayList(ImportRoot).new(), unavailable : ArrayList(UnavailableImport).new())
    }
  )
);
/// Would `yo install` make some unavailable import available?
_has_fetchable_unavailable :: (fn(roots : ImportRoots) -> bool)({
  (i : usize) = usize(0);
  while(i < roots.unavailable.len(), {
    if(roots.unavailable(i).fetchable, return(true));
    i = (i + usize(1));
  });
  false
});
/// A copy of `g_import_lines` for a compile (a module-level container is
/// read through a plain fn, never captured by an async body directly).
_import_lines :: (fn() -> ArrayList(String))({
  out := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < g_import_lines.len(), {
    match(g_import_lines.get(i), .Some(l) => out.push(l), .None => ());
    i = (i + usize(1));
  });
  out
});
/// Compute `g_import_lines` for this build. A git dependency that is not in
/// the cache is fetched first (the same resolution `yo install` runs), so a
/// fresh clone builds without a separate step; a dependency that is still
/// unavailable afterwards fails the build with its reason. Every
/// `build.dependency("name")` the build file referenced must be declared by
/// the manifest. Every await is a top-level statement of the async body on
/// purpose (see compile_artifact).
resolve_build_import_roots :: (
  fn(
    manifest_opt : Option(Manifest),
    registry : BuildRegistry,
    locked : bool,
    offline : bool,
    verbose : bool,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    g_import_lines = ArrayList(String).new();
    has_manifest := manifest_opt.is_some();
    if(!(has_manifest) && (registry.referenced_dependencies.len() > usize(0)), {
      e.exn.throw(dyn(`Error: build.dependency("${registry.referenced_dependencies(usize(0))}") needs a ${MANIFEST_FILENAME} declaring it, and this project has none.`));
    });
    if(!(has_manifest), {
      return(());
    });
    manifest := manifest_opt.unwrap();
    (ri : usize) = usize(0);
    while(ri < registry.referenced_dependencies.len(), {
      dep_name := registry.referenced_dependencies(ri);
      if(manifest.find_dependency(dep_name.clone()).is_none(), {
        e.exn.throw(dyn(`Error: build.dependency("${dep_name}") is not declared in ${manifest.path}. Add it with 'yo add'.`));
      });
      ri = (ri + usize(1));
    });
    roots := _manifest_roots(manifest, e.exn);
    needs_fetch := _has_fetchable_unavailable(roots);
    if(needs_fetch && verbose, {
      println(String.from("Dependencies not cached — fetching..."));
    });
    if(needs_fetch, {
      _ := e.io.await(install_dependencies(manifest, ResolveMode.Install, locked, offline, verbose, e.io, e.exn), e);
    });
    final_roots := if(needs_fetch, _manifest_roots(manifest, e.exn), roots);
    if(final_roots.unavailable.len() > usize(0), {
      first := final_roots.unavailable(usize(0));
      e.exn.throw(dyn(`Error: dependency "${first.name}": ${first.reason}`));
    });
    lines := ArrayList(String).new();
    (li : usize) = usize(0);
    while(li < final_roots.roots.len(), {
      r := final_roots.roots(li);
      lines.push(`${r.name}=${r.root}`);
      li = (li + usize(1));
    });
    g_import_lines = lines;
    e.io.await(_link_store_trees(manifest, e.io, e.exn), e);
    ()
  })
);
/// The editor's view of the store (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md
/// §4.4): `yo-out/deps/<name>` → the store tree of every git dependency the
/// lock records, so a dependency's source can be opened by a stable path.
/// Outputs, not inputs — the compile receives the absolute roots — and not
/// created on Windows, where a symlink needs a privilege a build must not
/// depend on. A stale link (a `yo update` moved the tree) is replaced.
_link_store_trees :: (
  fn(
    manifest : Manifest,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    if(platform == Platform.Windows, {
      return(());
    });
    lock_text := match(read_lock_text(manifest, e.exn), .Some(t) => t.clone(), .None => String.new());
    if(lock_text.len() == usize(0), {
      return(());
    });
    lock := match(
      parse_lock_file(lock_text),
      .Ok(l) => l,
      .Err(_) => {
        return(());
      }
    );
    cache_root := get_global_cache_dir();
    deps_dir := `${manifest.dir}/yo-out/deps`;
    (has_git : bool) = false;
    (i : usize) = usize(0);
    while(i < lock.packages.len(), {
      if(lock.packages(i).integrity.len() > usize(0), {
        has_git = true;
      });
      i = (i + usize(1));
    });
    if(!has_git, {
      return(());
    });
    e.io.await(create_dir_all(Path.new(deps_dir.clone()), e.io), e);
    // What is in `yo-out/deps` now — a dangling link is not `exists`, so the
    // directory listing (which reports a link as a link) is what says whether
    // a name has to be unlinked before it can be linked again.
    entries := e.io.await(read_dir(Path.new(deps_dir.clone()), e.io), e);
    (pi : usize) = usize(0);
    while(pi < lock.packages.len(), {
      entry := lock.packages(pi);
      pi = (pi + usize(1));
      tree := if(entry.integrity.len() == usize(0), String.new(), match(store_tree_dir(cache_root.clone(), entry.integrity.clone()), .Ok(d) => d, .Err(_) => String.new()));
      link := `${deps_dir}/${entry.name}`;
      is_link := _names_a_symlink(entries, entry.name.clone());
      if((tree.len() > usize(0)) && is_link, {
        e.io.await(remove_file(Path.new(link.clone()), e.io), e);
      });
      if(tree.len() > usize(0), {
        e.io.await(symlink(Path.new(tree.clone()), Path.new(link.clone()), e.io), e);
      });
    });
    ()
  })
);
/// Is `name` a symbolic link among `entries`?
_names_a_symlink :: (fn(entries : ArrayList(DirEntry), name : String) -> bool)({
  (i : usize) = usize(0);
  while(i < entries.len(), {
    if(entries(i).name == name, {
      return(match(entries(i).file_type, .Symlink => true, _ => false));
    });
    i = (i + usize(1));
  });
  false
});
/// The import closure of a DEPENDENCY package, keyed by its directory: the
/// artifacts a dependency's own `build.yo` defines compile against ITS
/// `yo.toml`, not ours (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.5.2).
/// Filled by `_evaluate_dependency_builds`, read by `compile_artifact` through
/// `_package_import_lines`.
(g_dep_import_dirs : ArrayList(String)) = ArrayList(String).new();
(g_dep_import_texts : ArrayList(ArrayList(String))) = ArrayList(ArrayList(String)).new();
/// The `--imports` lines for an artifact of `package_dir` — this project's
/// closure when the artifact is ours (`package_dir` empty), the package's own
/// when it came from a dependency's build file.
_package_import_lines :: (fn(package_dir : String) -> ArrayList(String))({
  if(package_dir.len() == usize(0), {
    return(_import_lines());
  });
  (i : usize) = usize(0);
  while(i < g_dep_import_dirs.len(), {
    if(g_dep_import_dirs(i) == package_dir, {
      out := ArrayList(String).new();
      lines := g_dep_import_texts(i);
      (j : usize) = usize(0);
      while(j < lines.len(), {
        out.push(lines(j));
        j = (j + usize(1));
      });
      return(out);
    });
    i = (i + usize(1));
  });
  ArrayList(String).new()
});
/// Record a package's import closure (see `g_dep_import_dirs`).
_record_package_import_lines :: (fn(package_dir : String, lines : ArrayList(String)) -> unit)({
  (i : usize) = usize(0);
  while(i < g_dep_import_dirs.len(), {
    if(g_dep_import_dirs(i) == package_dir, {
      return(());
    });
    i = (i + usize(1));
  });
  g_dep_import_dirs.push(package_dir);
  g_dep_import_texts.push(lines);
});
/// The `-D` options a dependency sees: the consumer's `-D<dep>.<name>=<value>`
/// with the prefix stripped. A dependency never reads the parent's own
/// options — its build file declared its own names.
_namespaced_defines :: (fn(dep_name : String, defines : HashMap(String, String)) -> HashMap(String, String))({
  out := HashMap(String, String).new();
  prefix := dep_name.concat(String.from("."));
  iter := defines.keys();
  more := true;
  while(more, {
    match(
      iter.next(),
      .None => {
        more = false;
      },
      .Some(k) => {
        if(k.starts_with(prefix.clone()), {
          match(
            defines.get(k.clone()),
            .Some(v) => {
              out.insert(k.substring(prefix.len(), k.len()), v);
            },
            .None => ()
          );
        });
      }
    );
  });
  out
});
/// Evaluate ONE dependency's `build.yo` in a scratch registry and return it.
/// `swap_build_registry` keeps the project's registry untouched — the
/// dependency's `build.executable(...)` calls must not become our artifacts.
/// An evaluation failure is reported with the dependency's name and file and
/// then fails the build; it is never swallowed (the B3 rule).
_evaluate_dependency_build_file :: (
  fn(
    dep_name : String,
    dep_dir : String,
    build_file : String,
    defines : HashMap(String, String),
    io : Io,
    exn : Exception
  ) -> Impl(Future(BuildRegistry, IoExn))
)(
  io.async((e : IoExn) => {
    scratch := BuildRegistry.new();
    scratch.cli_options = _namespaced_defines(dep_name.clone(), defines);
    dep_manifest_opt := project_manifest(dep_dir.clone(), e.exn);
    scratch.manifest_fields = _manifest_fields(dep_manifest_opt);
    prev := swap_build_registry(Option(BuildRegistry).Some(scratch));
    outcome := mm_load_yo_file(build_file.clone(), e.io, e.exn);
    load_error := _take_load_error();
    evaluated := get_build_registry();
    swap_build_registry(prev);
    if(!(outcome.ok), {
      match(
        load_error,
        .Some(rendered) => emit_rendered_text(rendered),
        .None => eprintln(`build: error in: ${build_file} (no diagnostic recorded)`)
      );
      e.exn.throw(dyn(`Error: dependency "${dep_name}": failed to evaluate ${build_file}`));
    });
    evaluated
  })
);
/// §4.5.2: every `dep.artifact("name")` this build file named becomes a REAL
/// artifact. The dependency's own `build.yo` is evaluated in isolation and the
/// named artifact is merged into this registry, stamped with the package it
/// came from — `compile_artifact` then reads its root and its `--imports`
/// against the DEPENDENCY's directory, and the DAG builds it before whatever
/// links it. Without this the reference was decorative: nothing built the
/// archive and the link failed with an undefined symbol.
_evaluate_dependency_builds :: (
  fn(
    manifest : Manifest,
    registry : BuildRegistry,
    defines : HashMap(String, String),
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    refs := registry.dependency_artifacts;
    if(refs.len() == usize(0), {
      return(());
    });
    lock_text := read_lock_text(manifest, e.exn);
    (i : usize) = usize(0);
    while(i < refs.len(), {
      r := refs(i);
      i = (i + usize(1));
      dep := match(
        manifest.find_dependency(r.dependency_name.clone()),
        .Some(d) => d,
        .None => {
          e.exn.throw(dyn(`Error: build.dependency("${r.dependency_name}") is not declared in ${manifest.path}. Add it with 'yo add'.`));
          return(());
        }
      );
      dir := match(
        dependency_dir(dep, manifest.dir.clone(), lock_text.clone()),
        .Ok(d) => d,
        .Err(u) => {
          e.exn.throw(dyn(`Error: dependency "${r.dependency_name}": ${u.reason}`));
          String.new()
        }
      );
      build_file := `${dir}/build.yo`;
      if(!file_exists_sync(build_file.clone()), {
        e.exn.throw(
          dyn(
            `Error: dependency "${r.dependency_name}" has no build.yo, so .artifact("${r.artifact_name}") has nothing to build (looked for ${build_file}).`
          )
        );
      });
      // Already merged by an earlier reference to the same artifact.
      merged := match(
        registry.find_artifact(r.artifact_name.clone()),
        .Some(existing) => (existing.package_dir == dir),
        .None => false
      );
      if(!merged, {
        dep_reg := e.io.await(
          _evaluate_dependency_build_file(r.dependency_name.clone(), dir.clone(), build_file.clone(), defines, e.io, e.exn),
          e
        );
        art := match(
          dep_reg.find_artifact(r.artifact_name.clone()),
          .Some(a) => a,
          .None => {
            e.exn.throw(dyn(`Error: dependency "${r.dependency_name}" defines no artifact "${r.artifact_name}" in ${build_file}.`));
            return(());
          }
        );
        is_lib := match(art.kind, .StaticLibrary => true, _ => false);
        if(!is_lib, {
          e.exn.throw(
            dyn(
              `Error: dependency "${r.dependency_name}": "${r.artifact_name}" is not a static library, and only a static library can be linked into this project.`
            )
          );
        });
        _record_package_import_lines(dir.clone(), _dependency_import_lines(dir.clone(), lock_text.clone(), e.exn));
        registry.register_static_library(
          BuildArtifact(
            kind : ArtifactKind.StaticLibrary,
            name : art.name.clone(),
            root : art.root.clone(),
            target : art.target.clone(),
            optimize : art.optimize.clone(),
            allocator : art.allocator.clone(),
            heap_size : art.heap_size,
            sanitize : art.sanitize.clone(),
            emit_c_to : art.emit_c_to.clone(),
            emit_chunks : art.emit_chunks,
            link_libraries : art.link_libraries,
            include_paths : art.include_paths,
            library_paths : art.library_paths,
            c_sources : art.c_sources,
            c_flags : art.c_flags,
            defines : art.defines,
            strip : art.strip,
            static_link : art.static_link,
            runtime_files : art.runtime_files,
            linked_artifacts : ArrayList(String).new(),
            linked_system_libs : art.linked_system_libs,
            package_dir : dir.clone(),
            package_name : r.dependency_name.clone()
          ),
          e.exn
        );
        // A `-D<dep>.<opt>` the dependency does not declare is a typo too.
        dep_unknown := undeclared_options(dep_reg);
        if(dep_unknown.len() > usize(0), {
          dep_joined := `", "`.join(dep_unknown);
          e.exn.throw(
            dyn(
              `Error: -D${r.dependency_name}."${dep_joined}" is not an option of dependency "${r.dependency_name}" (${build_file}).`
            )
          );
        });
        // The system libraries the dependency's build file declared, so the
        // consumer's link line can resolve what its archive needs.
        (si : usize) = usize(0);
        while(si < dep_reg.system_libraries.len(), {
          registry.system_libraries.push(dep_reg.system_libraries(si));
          si = (si + usize(1));
        });
      });
    });
    ()
  })
);
/// A dependency package's own import closure, as `name=<root file>` lines. Its
/// manifest names its modules and its dependencies; the LOCK is the root
/// project's — dependencies' git dependencies are recorded there.
_dependency_import_lines :: (
  fn(dep_dir : String, root_lock_text : Option(String), exn : Exception) -> ArrayList(String)
)({
  lines := ArrayList(String).new();
  dep_manifest := match(project_manifest(dep_dir.clone(), exn), .Some(m) => m, .None => return(lines));
  roots := match(
    resolve_import_roots(dep_manifest, root_lock_text, exn),
    .Ok(r) => r,
    .Err(msg) => {
      exn.throw(dyn(`Error: ${dep_dir}/${MANIFEST_FILENAME}: ${msg}`));
      return(lines)
    }
  );
  (i : usize) = usize(0);
  while(i < roots.roots.len(), {
    r := roots.roots(i);
    lines.push(`${r.name}=${r.root}`);
    i = (i + usize(1));
  });
  lines
});
// ---------------------------------------------------------------------------
// Linked static libraries
// ---------------------------------------------------------------------------
/// The `.a` files an artifact links, transitively through the linked
/// libraries' own `link` calls, as absolute paths under
/// `<project>/yo-out/<target>/lib/`. Names that resolve to no artifact (system
/// libraries attached elsewhere, or a typo the DAG walk also drops) are
/// skipped; a library reached twice is listed once.
///
/// `Step.link(lib)` used to produce only a DAG edge, so the library was built
/// first and then never handed to the consumer's link — the documented
/// `extern("Yo", …)` example failed with an undefined symbol
/// (issues/fixed/step-link-does-not-link-the-static-library.md).
_collect_linked_static_libs :: (
  fn(
    registry : BuildRegistry,
    artifact : BuildArtifact,
    project_dir : String,
    effective_target : String,
    target_triple_opt : Option(String)
  ) -> ArrayList(String)
)({
  out := ArrayList(String).new();
  seen := ArrayList(String).new();
  pending := ArrayList(String).new();
  i := usize(0);
  while(i < artifact.linked_artifacts.len(), {
    pending.push(artifact.linked_artifacts(i).clone());
    i = (i + usize(1));
  });
  // Each linked library's directory is its own: ours in `lib/`, a dependency's
  // in `deps/<package>/lib/` (§4.5.2) — see `_artifact_output_dir` below.
  while(pending.len() > usize(0), {
    name := pending.pop().unwrap();
    already := false;
    j := usize(0);
    while(j < seen.len(), {
      if(seen(j) == name, {
        already = true;
      });
      j = (j + usize(1));
    });
    if(!(already), {
      seen.push(name.clone());
      match(
        registry.find_artifact(name.clone()),
        .Some(lib) => {
          match(
            lib.kind,
            .StaticLibrary => {
              file_name := get_artifact_output_file_name(
                lib.kind,
                lib.name.clone(),
                lib.target.clone(),
                lib.c_flags,
                target_triple_opt
              );
              out.push(
                `${_artifact_output_dir(lib, project_dir.clone(), effective_target.clone(), "lib")}/${file_name}.a`
              );
              k := usize(0);
              while(k < lib.linked_artifacts.len(), {
                pending.push(lib.linked_artifacts(k).clone());
                k = (k + usize(1));
              });
            },
            _ => ()
          );
        },
        .None => ()
      );
    });
  });
  out
});
/// The `-L`/`-l`/rpath flags for every SHARED library an artifact links,
/// transitively (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.5.3). A
/// shared library is found by the loader at RUN time, so its directory travels
/// with the program as an rpath — otherwise the program builds and then dies
/// with "image not found". Windows resolves DLLs by directory, so it gets no
/// rpath. Returns flat pairs: `-L`, dir, `-l`, name, … followed by the rpath
/// flags, which the caller appends to `--cflags`.
_collect_linked_shared_libs :: (
  fn(
    registry : BuildRegistry,
    artifact : BuildArtifact,
    project_dir : String,
    effective_target : String,
    dirs_out : ArrayList(String),
    names_out : ArrayList(String)
  ) -> unit
)({
  seen := ArrayList(String).new();
  pending := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < artifact.linked_artifacts.len(), {
    pending.push(artifact.linked_artifacts(i).clone());
    i = (i + usize(1));
  });
  while(pending.len() > usize(0), {
    name := pending.pop().unwrap();
    already := false;
    (j : usize) = usize(0);
    while(j < seen.len(), {
      if(seen(j) == name, {
        already = true;
      });
      j = (j + usize(1));
    });
    if(!already, {
      seen.push(name.clone());
      match(
        registry.find_artifact(name.clone()),
        .Some(lib) => {
          match(
            lib.kind,
            .SharedLibrary => {
              dirs_out.push(_artifact_output_dir(lib, project_dir.clone(), effective_target.clone(), "lib"));
              names_out.push(lib.name.clone());
              (k : usize) = usize(0);
              while(k < lib.linked_artifacts.len(), {
                pending.push(lib.linked_artifacts(k).clone());
                k = (k + usize(1));
              });
            },
            .StaticLibrary => {
              (k2 : usize) = usize(0);
              while(k2 < lib.linked_artifacts.len(), {
                pending.push(lib.linked_artifacts(k2).clone());
                k2 = (k2 + usize(1));
              });
            },
            _ => ()
          );
        },
        .None => ()
      );
    });
  });
});
// ---------------------------------------------------------------------------
// Build DAG
// ---------------------------------------------------------------------------
_walk_dag :: (
  fn(
    registry : BuildRegistry,
    nodes : HashMap(String, DAGNode),
    visited : HashMap(String, bool),
    name : String,
    missing : ArrayList(String)
  ) -> unit
)({
  if(visited.contains_key(name), return(()));
  visited.insert(name, true);
  match(
    registry.resolve_dependency(name.clone()),
    .None => {
      // A name nothing defines: `install.depend_on(<typo>)` used to be a
      // silent no-op, so the artifact it meant to build was never built and
      // the build reported success (the plan's B6). The caller turns this
      // into an error naming the step.
      missing.push(name.clone());
      return(());
    },
    .Some(resolved) => match(
      resolved,
      .Artifact(artifact) => {
        deps := ArrayList(String).new();
        i := usize(0);
        n := artifact.linked_artifacts.len();
        while(i < n, {
          linked := artifact.linked_artifacts(i);
          deps.push(linked);
          recur(registry, nodes, visited, linked, missing);
          i = (i + usize(1));
        });
        nodes.insert(name, DAGNode(name : name, kind : DAGNodeKind.Artifact, depends_on : deps));
      },
      .Test(_t) => {
        nodes.insert(name, DAGNode(name : name, kind : DAGNodeKind.Test, depends_on : ArrayList(String).new()));
      },
      .Run(run_step) => {
        deps := ArrayList(String).new();
        deps.push(run_step.artifact_name);
        recur(registry, nodes, visited, run_step.artifact_name, missing);
        nodes.insert(name, DAGNode(name : name, kind : DAGNodeKind.Run, depends_on : deps));
      },
      .Doc(_d) => {
        nodes.insert(name, DAGNode(name : name, kind : DAGNodeKind.Doc, depends_on : ArrayList(String).new()));
      },
      .Step(step) => {
        deps := ArrayList(String).new();
        i := usize(0);
        n := step.dependency_names.len();
        while(i < n, {
          dep_name := step.dependency_names(i);
          deps.push(dep_name);
          recur(registry, nodes, visited, dep_name, missing);
          i = (i + usize(1));
        });
        nodes.insert(name, DAGNode(name : name, kind : DAGNodeKind.Step, depends_on : deps));
      }
    )
  );
});
/// Build a DAG by walking the step's dependency tree.
build_dag :: (
  fn(
    registry : BuildRegistry,
    root_step_name : String
  ) -> ArrayList(DAGNode)
)(
  build_dag_checked(registry, root_step_name, ArrayList(String).new())
);
/// `build_dag`, also reporting every dependency name that resolved to NOTHING
/// in `missing` (the plan's B6). `execute_step` fails the build on those
/// rather than building a DAG with a silent hole in it.
build_dag_checked :: (
  fn(
    registry : BuildRegistry,
    root_step_name : String,
    missing : ArrayList(String)
  ) -> ArrayList(DAGNode)
)({
  nodes := HashMap(String, DAGNode).new();
  visited := HashMap(String, bool).new();
  _walk_dag(registry, nodes, visited, root_step_name.clone(), missing);
  result := ArrayList(DAGNode).new();
  iter := nodes.values();
  more := true;
  while(more, {
    match(
      iter.next(),
      .None => {
        more = false;
      },
      .Some(v) => {
        result.push(v);
      }
    );
  });
  result
});
// DFS colors for cycle detection
_COLOR_WHITE :: i32(0);
_COLOR_GRAY :: i32(1);
_COLOR_BLACK :: i32(2);
_dfs_cycle :: (
  fn(
    node_map : HashMap(String, DAGNode),
    color : HashMap(String, i32),
    name : String
  ) -> Option(String)
)({
  color.insert(name, _COLOR_GRAY);
  match(
    node_map.get(name),
    .None => {
      color.insert(name, _COLOR_BLACK);
      return(Option(String).None);
    },
    .Some(node) => {
      i := usize(0);
      nd := node.depends_on.len();
      while(i < nd, {
        dep := node.depends_on(i);
        // A dependency that is not a node (it resolved to nothing) is not a
        // cycle candidate — and the skip has to CONTINUE: bumping `i` and
        // falling through incremented it twice, so the next dependency was
        // never examined at all (the plan's B12).
        if(!(node_map.contains_key(dep)), {
          i = (i + usize(1));
          continue;
        });
        dep_color := color.get(dep).unwrap_or(_COLOR_WHITE);
        if(dep_color == _COLOR_GRAY, return(Option(String).Some(dep)));
        if(dep_color == _COLOR_WHITE, {
          res := recur(node_map, color, dep);
          match(
            res,
            .Some(c) => {
              return(Option(String).Some(c));
            },
            .None => ()
          );
        });
        i = (i + usize(1));
      });
    }
  );
  color.insert(name, _COLOR_BLACK);
  Option(String).None
});
/// Detect cycles in a DAG via DFS. Returns the cycle node name if found.
detect_cycle :: (fn(dag : ArrayList(DAGNode)) -> Option(String))({
  node_map := HashMap(String, DAGNode).new();
  i := usize(0);
  n := dag.len();
  while(i < n, {
    node := dag(i);
    node_map.insert(node.name, node);
    i = (i + usize(1));
  });
  color := HashMap(String, i32).new();
  i = usize(0);
  while(i < n, {
    color.insert(dag(i).name, _COLOR_WHITE);
    i = (i + usize(1));
  });
  i = usize(0);
  while(i < n, {
    node_name := dag(i).name;
    if(color.get(node_name).unwrap_or(_COLOR_WHITE) == _COLOR_WHITE, {
      result := _dfs_cycle(node_map, color, node_name);
      match(
        result,
        .Some(c) => {
          return(Option(String).Some(c));
        },
        .None => ()
      );
    });
    i = (i + usize(1));
  });
  Option(String).None
});
// ---------------------------------------------------------------------------
// Artifact compilation
// ---------------------------------------------------------------------------
/// Compile a build artifact by invoking the Yo compiler.
// ---------------------------------------------------------------------------
// Artifact input cache (plans/reference/INCREMENTAL_COMPILATION.md Phase A).
// A compile is SKIPPED when the sha256 over (child argv + compiler version +
// every project/std `.yo` file + yo.lock) matches the stamp recorded next to
// the output on the last successful compile. Approximations, documented:
// the system C compiler and vendor C sources are NOT stamped (the compiler
// version + argv covers the yo side); delete yo-out or set
// YO_BUILD_NO_CACHE=1 to bypass.
// ---------------------------------------------------------------------------
_read_dir_task :: (fn(dir : String, io : Io) -> Impl(Future(ArrayList(DirEntry), IoExn)))(
  io.async((e : IoExn) => {
    // Local swallow handler: read_dir on a FILE (or a vanished dir) unwinds
    // THIS task, read as `.None` at the JoinHandle below — that failure IS
    // the dir-vs-file test, so no stat is needed (the readdir-order lesson
    // still applies: names are sorted by the consumer). The unwind payload
    // must match the future's payload type or def-eval fails and silently
    // hollows this SM; the value is discarded, the task aborts either way.
    swallow := Exception(throw : ((_e) -> unwind(ArrayList(DirEntry).new())));
    e.io.await(read_dir(Path.new(dir.clone()), e.io), IoExn(io : e.io, exn : swallow))
  })
);
/// Collect `*.yo` files under `dir`, skipping build outputs and VCS/tooling
/// directories. Names are sorted per directory for a deterministic stamp —
/// read_dir order is platform-dependent (the readdir-order lesson). Each
/// directory's read_dir runs as a spawned task polled with is_finished +
/// yield (a blocking await from inside a task nests the event loop, C37);
/// breadth-first over a worklist, which visits exactly the recursion's set.
/// Is `name` a directory among `entries`? A symlink is not followed: a link
/// loop would hang the walk, and a linked source tree is stamped where it
/// really lives.
_entry_is_dir :: (fn(entries : ArrayList(DirEntry), name : String) -> bool)({
  (i : usize) = usize(0);
  while(i < entries.len(), {
    en := entries(i);
    if(en.name == name, {
      return(match(en.file_type, .Directory => true, _ => false));
    });
    i = (i + usize(1));
  });
  false
});
_cache_collect_yo_files :: (
  fn(dir : String, out : ArrayList(String), io : Io) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    work := ArrayList(String).new();
    work.push(dir.clone());
    (wi : usize) = usize(0);
    while(wi < work.len(), {
      d := work(wi).clone();
      wi = (wi + usize(1));
      t := e.io.spawn(_read_dir_task(d.clone(), e.io), e);
      while(runtime(!(t.is_finished())), {
        e.io.await(yield(e.io), e.io);
      });
      entries := match(t.await(e.io), .Some(es) => es, .None => ArrayList(DirEntry).new());
      names := ArrayList(String).new();
      (i : usize) = usize(0);
      while(i < entries.len(), {
        match(
          entries.get(i),
          .Some(en) => {
            names.push(en.name.clone());
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      names.sort();
      (j : usize) = usize(0);
      while(j < names.len(), {
        name := names(j);
        skip := (
          (name == "yo-out") ||
            ((name == ".git") || ((name == "node_modules") || (name.starts_with(String.from("tmp")))))
        );
        if(!(skip), {
          full := Path.new(d.clone()).join(Path.new(name.clone())).to_string();
          cond(
            name.ends_with(String.from(".yo")) => {
              out.push(full);
            },
            true => {
              // Queue it when the DIRECTORY ENTRY says it is one. The old test
              // was "the name has no dot", a heuristic that silently excluded
              // every real source directory with a dot in its name (`my.pkg/`,
              // `v1.2/`): nothing under it was stamped, so editing those
              // sources left the artifact "cached" (the plan's B10).
              if(_entry_is_dir(entries, name.clone()), {
                work.push(full);
              });
            }
          );
        });
        j = (j + usize(1));
      });
    });
  })
);
_read_bytes_task :: (fn(path : String, io : Io) -> Impl(Future(ArrayList(u8), IoExn)))(
  io.async((e : IoExn) => {
    // Local swallow handler: an unreadable file unwinds THIS task, read as
    // `.None` at the JoinHandle below. The unwind payload must match the
    // future's payload type or def-eval fails and silently hollows this SM;
    // the value is discarded, the task aborts either way.
    swallow := Exception(throw : ((_e) -> unwind(ArrayList(u8).new())));
    e.io.await(read(Path.new(path.clone()), e.io), IoExn(io : e.io, exn : swallow))
  })
);
/// Read a file into the stamp accumulator; `.None` (file vanished mid-walk)
/// disables the cache for this artifact rather than mis-stamping it.
_cache_read_file :: (
  fn(path : String, io : Io) -> Impl(Future(Option(ArrayList(u8)), IoExn))
)(
  io.async((e : IoExn) => {
    t := e.io.spawn(_read_bytes_task(path.clone(), e.io), e);
    while(runtime(!(t.is_finished())), {
      e.io.await(yield(e.io), e.io);
    });
    match(
      t.await(e.io),
      .Some(bytes) => Option(ArrayList(u8)).Some(bytes),
      .None => Option(ArrayList(u8)).None
    )
  })
);
/// Append `s2` and a newline to the stamp accumulator. A module-level fn
/// rather than a local closure, so the io.async body using it stays a plain
/// statement sequence.
_stamp_push_str :: (fn(dst : ArrayList(u8), s2 : String) -> unit)({
  b := s2.as_bytes();
  (bi : usize) = usize(0);
  while(bi < b.len(), {
    dst.push(b(bi));
    bi = (bi + usize(1));
  });
  dst.push(u8(10));
});
/// The artifact's input stamp, or "" when stamping failed or the cache is off.
_artifact_input_stamp :: (
  fn(
    argv : ArrayList(String),
    project_dir : String,
    cache_enabled : bool,
    io : Io
  ) -> Impl(Future(String, IoExn))
)(
  io.async((e : IoExn) => {
    if(!cache_enabled, {
      return(String.new());
    });
    acc := ArrayList(u8).new();
    _stamp_push_str(acc, `yo-version ${CURRENT_YO_VERSION}`);
    sep := String.from(" ");
    _stamp_push_str(acc, `argv ${sep.join(argv)}`);
    files := ArrayList(String).new();
    e.io.await(_cache_collect_yo_files(project_dir.clone(), files, e.io), e);
    std_root := resolve_std_path();
    if(std_root.len() > usize(0), {
      e.io.await(
        _cache_collect_yo_files(std_root.replace(String.from("file://"), String.new()), files, e.io),
        e
      );
    });
    lock_path := Path.new(project_dir.clone()).join(Path.new(String.from("yo.lock"))).to_string();
    files.push(lock_path);
    (fi : usize) = usize(0);
    while(fi < files.len(), {
      fpath := files(fi);
      bytes_opt := e.io.await(_cache_read_file(fpath.clone(), e.io), e);
      match(
        bytes_opt,
        .Some(bytes) => {
          _stamp_push_str(acc, `${fpath} ${sha256_hex(bytes)}`);
        },
        .None => {
          // yo.lock legitimately may not exist; any OTHER unreadable input
          // disables the cache.
          if(!(fpath.ends_with(String.from("yo.lock"))), {
            return(String.new());
          });
        }
      );
      fi = (fi + usize(1));
    });
    sha256_hex(acc)
  })
);
/// Read the recorded stamp next to an output, `.None` when absent.
_read_stamp :: (fn(path : String, io : Io) -> Impl(Future(Option(String), IoExn)))(
  io.async((e : IoExn) => {
    t := e.io.spawn(_read_bytes_task(path.clone(), e.io), e);
    while(runtime(!(t.is_finished())), {
      e.io.await(yield(e.io), e.io);
    });
    match(
      t.await(e.io),
      .Some(bytes) => Option(String).Some(String.from_bytes(bytes)),
      .None => Option(String).None
    )
  })
);
_write_string_task :: (fn(path : String, data : String, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async((e : IoExn) => {
    // Local swallow handler: stamp write failures unwind THIS task, read as
    // `.None` at the JoinHandle below (the cache is an optimization). The
    // unwind payload matches the future's payload — write_string's own
    // unit — or def-eval fails and silently hollows this SM.
    swallow := Exception(throw : ((_e) -> unwind(())));
    e.io.await(write_string(Path.new(path.clone()), data.clone(), e.io), IoExn(io : e.io, exn : swallow))
  })
);
/// Record the stamp; failures are silent (the cache is an optimization).
/// An EMPTY stamp (cache disabled or stamping failed) is still written: it
/// truncates the previous stamp, making the next build a guaranteed cache
/// miss — which is the correct outcome in both of those cases anyway.
_write_stamp :: (fn(path : String, stamp : String, io : Io) -> Impl(Future(unit, IoExn)))(
  io.async((e : IoExn) => {
    t := e.io.spawn(_write_string_task(path.clone(), stamp.clone(), e.io), e);
    while(runtime(!(t.is_finished())), {
      e.io.await(yield(e.io), e.io);
    });
    match(
      t.await(e.io),
      .Some(_u) => (),
      .None => ()
    )
  })
);
compile_artifact :: (
  fn(
    artifact : BuildArtifact,
    ctx : ExecutionContext,
    io : Io,
    exn : Exception
  ) -> Impl(Future(Result(unit, String), IoExn))
)(
  io.async((e : IoExn) => {
    effective_target := match(
      ctx.target_triple,
      .Some(t) => t,
      .None => artifact.target
    );
    is_lib := match(
      artifact.kind,
      .StaticLibrary => true,
      .SharedLibrary => true,
      .Executable => false
    );
    kind_dir := if(is_lib, "lib", "bin");
    output_dir := _artifact_output_dir(artifact, ctx.project_dir.clone(), effective_target.clone(), kind_dir);
    // Create the output directory before compiling into it (src/build-runner.ts:937-939).
    // Without this the compiler is handed `-o <missing dir>/<name>` and dies with
    // a bare ENOENT — "file or directory not found" — with nothing to say which
    // path was missing. `yo build` could not build ANYTHING in a fresh project.
    e.io.await(create_dir_all(Path.new(output_dir.clone()), e.io), e);
    output_name := get_artifact_output_file_name(
      artifact.kind,
      artifact.name.clone(),
      artifact.target.clone(),
      artifact.c_flags,
      ctx.target_triple
    );
    output_path := Path.new(output_dir).join(Path.new(output_name));
    // A dependency's artifact (§4.5.2) has its own package root: its `root` is
    // relative to the DEPENDENCY's directory, not to this project's.
    package_dir := if(artifact.package_dir.len() > usize(0), artifact.package_dir.clone(), ctx.project_dir.clone());
    source_path := Path.new(package_dir.clone()).join(Path.new(artifact.root));
    // Byte-for-byte `src/build-runner.ts:948-956`: UNCONDITIONAL (not behind
    // --verbose), the PROJECT name (the manifest's, else the first registered
    // module's) rather than the
    // artifact's, a `git describe` suffix when the project dir is a repo, a
    // U+2192 arrow, the output path RELATIVE to the project dir, and a `.a`
    // suffix for static libraries. `tests/cli-cases/build-run` compares this
    // line.
    // A dependency's artifact announces ITS package, not ours (§4.5.2), and
    // its version line describes the dependency's checkout.
    project_name := cond(
      (artifact.package_name.len() > usize(0)) => artifact.package_name.clone(),
      (ctx.project_name.len() > usize(0)) => ctx.project_name.clone(),
      (ctx.registry.modules.len() > usize(0)) => ctx.registry.modules(usize(0)).name,
      true => artifact.name.clone()
    );
    git_v := e.io.await(_git_version(package_dir.clone(), e.io, e.exn), e);
    version_suffix := match(
      git_v,
      .Some(v) => ` ${v}`,
      .None => String.new()
    );
    rel_output := Path.new(output_path.to_string()).relative_to(Path.new(ctx.project_dir.clone()));
    // The child appends these itself; the Building line and the cache's
    // existence probe have to agree with it.
    eff_ti_lib := match(parse_target(effective_target.clone()), .Ok(t) => t, .Err(_) => host_target());
    shared_ext := cond(
      is_target_windows(eff_ti_lib) => String.from(".dll"),
      is_target_macos(eff_ti_lib) => String.from(".dylib"),
      true => String.from(".so")
    );
    lib_suffix := match(artifact.kind, .StaticLibrary => String.from(".a"), .SharedLibrary => shared_ext.clone(), _ => String.new());
    println(`Building ${project_name}${version_suffix} → ${rel_output}${lib_suffix}`);
    // The manifest's import roots → the child's `--imports` mapping file,
    // written beside the output. Top-level awaits (see the cache block below).
    import_lines := _package_import_lines(artifact.package_dir.clone());
    imports_path := `${output_path.to_string()}.imports`;
    nl := String.from("\n");
    imports_text := if(import_lines.len() > usize(0), `${nl.join(import_lines)}\n`, String.new());
    e.io.await(_write_stamp(imports_path.clone(), imports_text.clone(), e.io), e);
    cmd := Command.new(_self_exe());
    cmd.arg(String.from("compile"));
    if(import_lines.len() > usize(0), {
      cmd.arg(String.from("--imports"));
      cmd.arg(imports_path.clone());
    });
    // Forward the parent's `--std-path` override to the child compile. TS
    // needs no equivalent: its build runner compiles artifacts in-process,
    // where the override already applies.
    match(
      get_std_path_override(),
      .Some(sp) => {
        cmd.arg(String.from("--std-path"));
        cmd.arg(sp);
      },
      .None => {}
    );
    cmd.arg(source_path.to_string());
    cmd.arg(String.from("-o"));
    cmd.arg(output_path.to_string());
    // TS sets the internal `emccEnvironment` to "web" for wasm targets
    // (build-runner.ts:1017/1891) because it calls codegen in-process. We shell
    // out to `compile`, so it has to travel as a flag — without it the plain
    // `compile` default (`-sNODERAWFS=1`) would leak into `yo build` output.
    eff_ti_emcc := match(
      parse_target(effective_target.clone()),
      .Ok(t) => t,
      .Err(_) => host_target()
    );
    if(is_target_wasm(eff_ti_emcc), {
      cmd.arg(String.from("--emcc-environment"));
      cmd.arg(String.from("web"));
    });
    // Pass --target whenever it is not the host. The old condition was
    // `effective_target != artifact.target`, which meant an artifact declaring
    // its OWN target — the normal case — never got one: `effective_target`
    // equals `artifact.target` unless the CLI overrides it. TS does not hit
    // this because it calls codegen IN-PROCESS with parsedTarget; we shell out,
    // so the target must travel on the command line or the child silently
    // builds for the host.
    //
    // Run 31875845879 is what that looks like: `yo build` for
    // Wasm32_Unknown_Emscripten produced yo-out/wasm32-unknown-emscripten/bin/hello-world.html
    // that was an 18 KB EXECUTABLE ELF — clang building natively, with the
    // wasm-shaped path and extension applied around it. No .js, no .wasm.
    //
    // Still skipped for the native case, deliberately: passing --target there
    // would add `--target=<host triple>` to the clang line on every ordinary
    // build, which is a cross-compile flag those proven link lines have never
    // carried.
    if((effective_target != "") && (effective_target != host_target().triple), {
      cmd.arg(String.from("--target"));
      cmd.arg(effective_target.clone());
    });
    // Force emcc for wasm targets (build-runner.ts:902-907). `compile` also
    // auto-selects it, but only from a target it can SEE — and ctx.c_compiler
    // defaults to "clang", which would otherwise be passed through explicitly
    // and defeat that auto-selection.
    eff_ti_cc := match(parse_target(effective_target.clone()), .Ok(t) => t, .Err(_) => host_target());
    if(is_target_wasm(eff_ti_cc), {
      cmd.arg(String.from("--cc"));
      cmd.arg(String.from("emcc"));
    }, {
      if(ctx.c_compiler != "clang", {
        cmd.arg(String.from("--cc"));
        cmd.arg(ctx.c_compiler);
      });
    });
    match(
      ctx.sysroot,
      .Some(s) => {
        cmd.arg(String.from("--sysroot"));
        cmd.arg(s);
      },
      .None => ()
    );
    i := usize(0);
    n := artifact.c_sources.len();
    while(i < n, {
      cmd.arg(String.from("--extern"));
      cmd.arg(artifact.c_sources(i));
      i = (i + usize(1));
    });
    // Static libraries this artifact links (`Step.link`), built earlier in the
    // DAG, reach the child's link line the same way C sources do.
    linked_libs := _collect_linked_static_libs(
      ctx.registry,
      artifact,
      ctx.project_dir.clone(),
      effective_target.clone(),
      ctx.target_triple
    );
    i = usize(0);
    n = linked_libs.len();
    while(i < n, {
      cmd.arg(String.from("--extern"));
      cmd.arg(linked_libs(i));
      i = (i + usize(1));
    });
    // Shared libraries are linked by name out of their directory, and that
    // directory travels as an rpath so the loader still finds them (§4.5.3).
    shared_dirs := ArrayList(String).new();
    shared_names := ArrayList(String).new();
    _collect_linked_shared_libs(
      ctx.registry,
      artifact,
      ctx.project_dir.clone(),
      effective_target.clone(),
      shared_dirs,
      shared_names
    );
    rpath_flags := ArrayList(String).new();
    i = usize(0);
    while(i < shared_dirs.len(), {
      cmd.arg(String.from("-L"));
      cmd.arg(shared_dirs(i).clone());
      cmd.arg(String.from("-l"));
      cmd.arg(shared_names(i).clone());
      if(!(is_target_windows(eff_ti_lib)), {
        // ABSOLUTE: the loader resolves an rpath at run time, from whatever
        // directory the program is started in, so a `./yo-out/...` rpath would
        // only work from the project root.
        d := shared_dirs(i);
        abs_d := if(Path.new(d.clone()).is_absolute(), d.clone(), {
          base := match(cwd(), .Ok(c) => c.to_string(), .Err(_) => String.from("."));
          Path.new(base).join(Path.new(d.clone())).normalize().to_string()
        });
        rpath_flags.push(`-Wl,-rpath,${abs_d}`);
      });
      i = (i + usize(1));
    });
    i = usize(0);
    n = artifact.include_paths.len();
    while(i < n, {
      cmd.arg(String.from("-I"));
      cmd.arg(artifact.include_paths(i));
      i = (i + usize(1));
    });
    // Forward the artifact's compile options — the §9 debt in
    // plans/archive/P1_CLI_PARITY.md. Mirrors the `codeGenerator.compileModule`
    // option mapping in `src/build-runner.ts:967-996`: `release` is true for
    // every level except debug/release-safe, `mapOptimize` sends
    // release-safe/-small to -O2 and release-fast to -O3, allocator is passed
    // unconditionally, sanitize only when not "none".
    // Only `--optimize <level>` is emitted: `yo compile` has no `--release`
    // flag any more (it was a pure alias of `--optimize 2`, removed 2026-08-28).
    optimize_num := cond(
      (artifact.optimize == "release-safe") => String.from("2"),
      (artifact.optimize == "release-fast") => String.from("3"),
      (artifact.optimize == "release-small") => String.from("2"),
      true => String.new()
    );
    if(optimize_num.len() > usize(0), {
      cmd.arg(String.from("--optimize"));
      cmd.arg(optimize_num);
    });
    cmd.arg(String.from("--allocator"));
    cmd.arg(artifact.allocator.clone());
    // Fixed-region heap: only under `fixed` (the child compile rejects the
    // pairing otherwise), mirroring plans/reference/FIXED_REGION_ALLOCATOR.md
    // §2.6. Non-fixed builds add nothing, so their child argv is unchanged.
    if(artifact.allocator == "fixed", {
      cmd.arg(String.from("--heap-size"));
      cmd.arg(artifact.heap_size.to_string());
    });
    // `emit_c_to` redirects the generated C file. "" means unset (comptime_str
    // has no None). Resolved against the project dir, matching how `root` is
    // resolved: a path in build.yo means "relative to the project", not to
    // whatever cwd the build runs from.
    if(artifact.emit_c_to.len() > usize(0), {
      cmd.arg(String.from("--emit-c-to"));
      cmd.arg(Path.new(ctx.project_dir.clone()).join(Path.new(artifact.emit_c_to.clone())).to_string());
    });
    // Chunked C emission (plans/reference/CHUNKED_C_EMISSION.md): 0 = off, which is the
    // default, so an unset field adds nothing to the child argv and the
    // emission stays byte-identical. The Phase A artifact stamp hashes this
    // argv, so flipping the field invalidates the build cache for free.
    if(artifact.emit_chunks > usize(0), {
      cmd.arg(String.from("--emit-chunks"));
      cmd.arg(artifact.emit_chunks.to_string());
    }, {
      // Phase 1 dev-profile default (plans/INCREMENTAL_COMPILATION_ZIG_LESSONS.md
      // §4.4): a DEBUG (−O0) executable build chunks automatically — the
      // measured 3.3× C-leg win with identical runtime, no ThinLTO needed.
      // Gated OFF for optimized builds (the ThinLTO link is the floor there),
      // libraries (run_compile rejects the combination), `emit_c_to` (one C
      // file is the contract), and wasm (chunked wasm is out of scope).
      // YO_JOBS=1 is the opt-out: it caps auto at one chunk.
      if(((!(is_lib) && (optimize_num.len() == usize(0))) && (artifact.emit_c_to.len() == usize(0)))
      && !(effective_target.starts_with(String.from("wasm"))), {
        cmd.arg(String.from("--emit-chunks"));
        cmd.arg(String.from("auto"));
      });
    });
    if(artifact.sanitize != "none", {
      cmd.arg(String.from("--sanitize"));
      cmd.arg(artifact.sanitize.clone());
    });
    i = usize(0);
    n = artifact.defines.len();
    while(i < n, {
      cmd.arg(String.from("-D"));
      cmd.arg(artifact.defines(i));
      i = (i + usize(1));
    });
    i = usize(0);
    n = artifact.library_paths.len();
    while(i < n, {
      cmd.arg(String.from("-L"));
      cmd.arg(artifact.library_paths(i));
      i = (i + usize(1));
    });
    i = usize(0);
    n = artifact.link_libraries.len();
    while(i < n, {
      cmd.arg(String.from("-l"));
      cmd.arg(artifact.link_libraries(i));
      i = (i + usize(1));
    });
    if(artifact.strip, {
      cmd.arg(String.from("--strip"));
    });
    if(artifact.static_link, {
      cmd.arg(String.from("--static"));
    });
    is_static_lib := match(artifact.kind, .StaticLibrary => true, _ => false);
    if(is_static_lib, {
      cmd.arg(String.from("--static-library"));
    });
    is_shared_lib := match(artifact.kind, .SharedLibrary => true, _ => false);
    if(is_shared_lib, {
      cmd.arg(String.from("--shared-library"));
    });
    // Forward the error format so artifact-compile failures render per
    // --error-format (P3 threading, plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md).
    if(!(error_format() == "human"), {
      cmd.arg(String.from("--error-format"));
      cmd.arg(error_format());
    });
    // The artifact's own cflags plus the rpaths its shared libraries need —
    // `--cflags` is the only channel to the C driver's link line.
    all_cflags := ArrayList(String).new();
    i = usize(0);
    while(i < artifact.c_flags.len(), {
      all_cflags.push(artifact.c_flags(i).clone());
      i = (i + usize(1));
    });
    i = usize(0);
    while(i < rpath_flags.len(), {
      all_cflags.push(rpath_flags(i).clone());
      i = (i + usize(1));
    });
    if(all_cflags.len() > usize(0), {
      joined := ` `.join(all_cflags);
      cmd.arg(String.from("--cflags"));
      cmd.arg(joined);
    });
    // STREAM the child's output rather than capturing it. `src/build-runner.ts`
    // compiles in-process, so its "Generated C code written to …" / "Compiling
    // with: …" lines and every clang diagnostic land on the build's own stdout.
    // Capturing them hid compile errors from the user entirely unless the whole
    // step failed.
    // Every await-bearing step below is a TOP-LEVEL statement of this
    // async closure ON PURPOSE: an await nested inside an if-branch here
    // silently lost its continuation (the cache-skip block after it never
    // ran) — issues/async-await-in-nested-if-drops-continuation.md. The
    // unconditional exists()/read are harmless when the cache is disabled.
    cache_enabled := match(proc_env.get(`YO_BUILD_NO_CACHE`), .Some(v) => (v != "1"), .None => true);
    // The stamp is computed unconditionally (a top-level await on purpose —
    // see the comment above) and only USED when the cache is enabled; the
    // walk is exactly the work a cached build needs, and YO_BUILD_NO_CACHE
    // remains the escape hatch for it.
    stamp_inputs := ArrayList(String).new();
    (si : usize) = usize(0);
    while(si < cmd._args.len(), {
      stamp_inputs.push(cmd._args(si).clone());
      si = (si + usize(1));
    });
    si = usize(0);
    while(si < import_lines.len(), {
      stamp_inputs.push(import_lines(si).clone());
      si = (si + usize(1));
    });
    // `YO_BUILD_NO_CACHE=1` means "do not consult the cache", and the walk is
    // the expensive part — it read and hashed every `.yo` under the project
    // AND the whole std tree for an answer nothing would look at (the plan's
    // B10). The flag rides INTO the stamp function so the await here stays a
    // top-level statement.
    stamp_raw := e.io.await(_artifact_input_stamp(stamp_inputs, ctx.project_dir.clone(), cache_enabled, e.io), e);
    stamp := cond(
      cache_enabled => stamp_raw,
      true => String.new()
    );
    stamp_path := `${output_path.to_string()}.inputs-sha256`;
    // The static-library child appends `.a` itself (the same suffix the
    // Building line shows), so the existence probe must too — without it a
    // static-library artifact could never cache-hit.
    out_exists := e.io.await(exists(Path.new(`${output_path.to_string()}${lib_suffix}`), e.io), e.io);
    prev_stamp := e.io.await(_read_stamp(stamp_path.clone(), e.io), e);
    stamp_matches := match(prev_stamp, .Some(prev) => (prev == stamp), .None => false);
    use_cache := (((cache_enabled && (stamp.len() > usize(0))) && out_exists) && stamp_matches);
    if(use_cache, {
      println(`  (cached: inputs unchanged, skipping compile)`);
      return(Result(unit, String).Ok(()));
    });
    st := e.io.await(cmd.status(e.io), e);
    // The write decision is DATA, not a branch: an empty stamp (cache off or
    // stamping failed) is written as-is and truncates — see _write_stamp.
    stamp_to_write := cond(
      ((st.success() && cache_enabled) && (stamp.len() > usize(0))) => stamp.clone(),
      true => String.new()
    );
    e.io.await(_write_stamp(stamp_path.clone(), stamp_to_write, e.io), e);
    cond(
      st.success() => Result(unit, String).Ok(()),
      true => {
        code := st.code().unwrap_or(i32(-1));
        Result(unit, String).Err(`Compilation failed (exit ${code})`)
      }
    )
  })
);
// ---------------------------------------------------------------------------
// Run executable
// ---------------------------------------------------------------------------
run_executable :: (
  fn(
    artifact : BuildArtifact,
    args : ArrayList(String),
    ctx : ExecutionContext,
    io : Io,
    exn : Exception
  ) -> Impl(Future(Result(unit, String), IoExn))
)(
  io.async((e : IoExn) => {
    effective_target := match(
      ctx.target_triple,
      .Some(t) => t,
      .None => artifact.target
    );
    output_dir := _get_target_output_dir(ctx.project_dir.clone(), effective_target.clone(), "bin");
    exe_name := get_artifact_output_file_name(
      artifact.kind,
      artifact.name.clone(),
      artifact.target.clone(),
      artifact.c_flags,
      ctx.target_triple
    );
    exe_path := Path.new(output_dir).join(Path.new(exe_name));
    // Missing-binary pre-flight (build-runner.ts:1918-1921): a step chain that
    // skipped the compile must fail HERE with a diagnostic, not with the
    // shell's exec error.
    exe_found := e.io.await(exists(Path.new(exe_path.to_string()), e.io), e.io);
    if(!(exe_found), {
      return(Result(unit, String).Err(`Error: Compiled executable not found at ${exe_path.to_string()}`));
    });
    // The program runs with cwd = project dir (TS spawnSync {cwd: projectDir},
    // build-runner.ts:1938-1942). `Command` has no cwd builder, so chdir
    // around the spawn — the runner is single-threaded, and the exe path is
    // made absolute FIRST so the chdir cannot invalidate it.
    (abs_exe : String) = exe_path.to_string();
    if(!(Path.new(abs_exe.clone()).is_absolute()), {
      base := match(cwd(), .Ok(cb) => cb.to_string(), .Err(_) => String.from("."));
      abs_exe = Path.new(base).join(Path.new(abs_exe.clone())).to_string();
    });
    prev_dir := match(cwd(), .Ok(pc) => pc.to_string(), .Err(_) => String.from("."));
    _cd_in := chdir(Path.new(ctx.project_dir.clone()));
    // wasm artifacts run through node on the emitted .js shim
    // (build-runner.ts:1924-1937).
    eff_ti_run := match(parse_target(effective_target.clone()), .Ok(t) => t, .Err(_) => host_target());
    cmd := if(is_target_wasm(eff_ti_run), {
      js_path := if(
        abs_exe.ends_with(".html"),
        `${abs_exe.substring(usize(0), (abs_exe.len() - usize(5)))}.js`,
        abs_exe.clone()
      );
      wcmd := Command.new(String.from("node"));
      wcmd.arg(js_path);
      wcmd
    }, Command.new(abs_exe.clone()));
    i := usize(0);
    n := args.len();
    while(i < n, {
      cmd.arg(args(i));
      i = (i + usize(1));
    });
    // Streamed, not captured: `runExecutable` in src/build-runner.ts spawns with
    // `stdio: "inherit"`, so the program the user asked to run writes to the
    // user's terminal. Capturing swallowed its output entirely.
    st := e.io.await(cmd.status(e.io), e);
    _cd_back := chdir(Path.new(prev_dir));
    if(st.success(), Result(unit, String).Ok(()), {
      code := st.code().unwrap_or(i32(-1));
      Result(unit, String).Err(`Executable exited with code ${code}`)
    })
  })
);
// ---------------------------------------------------------------------------
// Test suite
// ---------------------------------------------------------------------------
run_test_suite :: (
  fn(
    suite : BuildTestSuite,
    ctx : ExecutionContext,
    io : Io,
    exn : Exception
  ) -> Impl(Future(Result(unit, String), IoExn))
)(
  io.async((e : IoExn) => {
    test_path := Path.new(ctx.project_dir).join(Path.new(suite.root));
    cmd := Command.new(_self_exe());
    cmd.arg(String.from("test"));
    // Forward the build's C compiler to the child test run (TS passes
    // cCompiler through runTests, build-runner.ts:1955-1978; hollow before
    // the runner's own --cc forwarding landed in P2.5 step 5).
    cmd.arg(String.from("--c-compiler"));
    cmd.arg(ctx.c_compiler.clone());
    // Forward the parent's `--std-path` override to the child test run (same
    // rationale as the compile_artifact forwarding above).
    match(
      get_std_path_override(),
      .Some(sp) => {
        cmd.arg(String.from("--std-path"));
        cmd.arg(sp);
      },
      .None => {}
    );
    cmd.arg(test_path.to_string());
    // Suite excludes are project-relative; the child test runner resolves
    // `--exclude` against its CWD, so anchor them to the project dir (TS
    // does the same in-process via path.resolve(projectDir, e)).
    (exi : usize) = usize(0);
    while(exi < suite.exclude.len(), {
      match(
        suite.exclude.get(exi),
        .Some(ex) => {
          cmd.arg(String.from("--exclude"));
          cmd.arg(Path.new(ctx.project_dir.clone()).join(Path.new(ex.clone())).to_string());
        },
        .None => {}
      );
      exi = (exi + usize(1));
    });
    if(suite.verbose, {
      _arg_c := cmd.arg(String.from("--verbose"));
    });
    if(suite.bail, {
      _arg_c := cmd.arg(String.from("--bail"));
    });
    if(suite.parallel > i32(1), {
      cmd.arg(String.from("--parallel"));
      cmd.arg(suite.parallel.to_string());
    });
    if(ctx.verbose, {
      _arg_c := cmd.arg(String.from("--verbose"));
    });
    // Streamed, not captured — `runTestSuite` in src/build-runner.ts inherits
    // stdio, so the test runner's own report is the point of running it.
    st := e.io.await(cmd.status(e.io), e);
    if(st.success(), Result(unit, String).Ok(()), {
      code := st.code().unwrap_or(i32(-1));
      Result(unit, String).Err(`Tests failed (exit ${code})`)
    })
  })
);
/// Run a documentation step, mapping any thrown error to `false` (TS wraps
/// runDocGeneration in try/catch, build-runner.ts:745-757).
_run_doc_step :: (fn(opts : DocCommandOptions, io : Io) -> bool)({
  doc_exn := Exception(
    throw : (
      (doc_err) -> {
        eprintln(`doc step failed: ${doc_err.to_string()}`);
        unwind(false);
      }
    )
  );
  run_doc(opts, io, doc_exn);
  true
});
/// Append every element of `src` onto `dst` (ArrayList has no extend()).
_push_all_strings :: (fn(dst : ArrayList(String), src : ArrayList(String)) -> unit)({
  (pa_i : usize) = usize(0);
  while(pa_i < src.len(), {
    match(
      src.get(pa_i),
      .Some(s) => {
        dst.push(s.clone());
      },
      .None => ()
    );
    pa_i = (pa_i + usize(1));
  });
});
// ---------------------------------------------------------------------------
// Node execution
// ---------------------------------------------------------------------------
/// Execute a single DAG node.
execute_node :: (
  fn(
    node : DAGNode,
    ctx : ExecutionContext,
    io : Io,
    exn : Exception
  ) -> Impl(Future(StepResult, IoExn))
)(
  io.async((e : IoExn) => {
    description := node.name.clone();
    success := true;
    match(
      node.kind,
      .Artifact => {
        match(
          ctx.registry.find_artifact(node.name.clone()),
          .None => (),
          .Some(artifact) => {
            kind_label := match(
              artifact.kind,
              .StaticLibrary => "lib",
              .SharedLibrary => "shared lib",
              .Executable => "exe"
            );
            description = `compile ${kind_label} ${artifact.name}`;
            result := e.io.await(compile_artifact(artifact, ctx, e.io, e.exn), e);
            match(
              result,
              .Ok(_) => (),
              .Err(err) => {
                println(`Compilation error: ${err}`);
                success = false;
              }
            );
          }
        );
      },
      .Test => {
        match(
          ctx.registry.find_test(node.name.clone()),
          .None => (),
          .Some(suite) => {
            description = `test ${suite.name}`;
            result := e.io.await(run_test_suite(suite, ctx, e.io, e.exn), e);
            match(
              result,
              .Ok(_) => (),
              .Err(msg) => {
                // The message was computed and thrown away, so a failed suite
                // showed up only as a red row in the summary (the plan's B6).
                eprintln(`Error: ${msg}`);
                success = false;
              }
            );
          }
        );
      },
      .Run => {
        match(
          ctx.registry.find_run_step(node.name.clone()),
          .None => (),
          .Some(run_step) => {
            description = `run ${run_step.artifact_name}`;
            match(
              ctx.registry.find_artifact(run_step.artifact_name.clone()),
              .None => (),
              .Some(artifact) => {
                // The build file's own args first, then the command line's
                // (`yo build run -- --flag value`).
                run_argv := ArrayList(String).new();
                (ra_i : usize) = usize(0);
                while(ra_i < run_step.args.len(), {
                  run_argv.push(run_step.args(ra_i).clone());
                  ra_i = (ra_i + usize(1));
                });
                ra_i = usize(0);
                while(ra_i < ctx.run_args.len(), {
                  run_argv.push(ctx.run_args(ra_i).clone());
                  ra_i = (ra_i + usize(1));
                });
                result := e.io.await(run_executable(artifact, run_argv, ctx, e.io, e.exn), e);
                match(
                  result,
                  .Ok(_) => (),
                  .Err(msg) => {
                    eprintln(`Error: ${msg}`);
                    success = false;
                  }
                );
              }
            );
          }
        );
      },
      .Step => (),
      .Doc => {
        match(
          ctx.registry.find_documentation(node.name.clone()),
          .None => (),
          .Some(doc_cfg) => {
            description = `doc ${doc_cfg.name}`;
            // Actually generate the documentation (runDocGeneration,
            // src/build-runner.ts:745-757 + :1987-2010). Previously this arm
            // printed success and ran nothing — `yo init` scaffolds a doc
            // step, so every scaffolded project's `yo build doc` was hollow.
            println(`Generating documentation: ${doc_cfg.name}`);
            doc_root := Path.new(ctx.project_dir.clone()).join(Path.new(doc_cfg.root.clone())).to_string();
            doc_out := Path.new(ctx.project_dir.clone()).join(Path.new(doc_cfg.output_dir.clone())).to_string();
            doc_fmt := if(doc_cfg.format.len() == usize(0), String.from("html"), doc_cfg.format.clone());
            doc_ok := _run_doc_step(
              DocCommandOptions(
                input : doc_root,
                output_dir : doc_out,
                include_private : doc_cfg.include_private,
                verbose : ctx.verbose,
                title : doc_cfg.title.clone(),
                format : doc_fmt,
                version : doc_cfg.version.clone()
              ),
              io
            );
            if(!(doc_ok), {
              success = false;
            });
          }
        );
      }
    );
    StepResult(
      name : node.name,
      kind : node.kind,
      success : success,
      duration_ms : i64(0),
      description : description
    )
  })
);
// ---------------------------------------------------------------------------
// DAG executor (Kahn's algorithm)
// ---------------------------------------------------------------------------
/// Execute nodes in dependency order (Kahn's algorithm).
/// Did a dependency of `node` already fail? A dependent must NOT run: the
/// runner used to execute a `run` step whose executable had just failed to
/// compile, turning one clear compile error into a second, confusing one
/// (the plan's B6).
_dependency_failed :: (fn(node : DAGNode, results : HashMap(String, StepResult)) -> bool)({
  (i : usize) = usize(0);
  while(i < node.depends_on.len(), {
    match(
      results.get(node.depends_on(i)),
      .Some(r) => if(!(r.success), {
        return(true);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  false
});
/// `execute_node`, unless a dependency failed — then the node is reported as
/// skipped without running. The branch lives in its own async fn so the
/// caller's `await` stays a top-level statement (an await nested in an
/// if-branch loses its continuation — issues/async-await-in-nested-if-drops-continuation.md).
_execute_node_unless_blocked :: (
  fn(
    node : DAGNode,
    blocked : bool,
    ctx : ExecutionContext,
    io : Io,
    exn : Exception
  ) -> Impl(Future(StepResult, IoExn))
)(
  io.async((e : IoExn) => {
    if(blocked, {
      println(`Skipping ${node.name}: a step it depends on failed`);
      return(
        StepResult(
          name : node.name.clone(),
          kind : node.kind,
          success : false,
          duration_ms : i64(0),
          description : `skipped ${node.name}`
        )
      );
    });
    node_t0 := Instant.now();
    r := e.io.await(execute_node(node, ctx, e.io, e.exn), e);
    r.duration_ms = node_t0.elapsed().as_millis();
    r
  })
);
/// True while any handle in `handles` is still running. The poll predicate of
/// `_execute_batch` below — a plain `fn` so the `while` condition carries no
/// suspension point.
_any_task_pending :: (fn(handles : ArrayList(JoinHandle(StepResult))) -> bool)({
  (i : usize) = usize(0);
  while(i < handles.len(), {
    if(!(handles(i).is_finished()), {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
/// Run a batch of ready nodes CONCURRENTLY and collect their results in the
/// batch's own order (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.8). Each
/// node is a task; the compile/test/run children they spawn are what actually
/// overlap. A task that unwinds is recorded as a failure rather than losing
/// the node.
_execute_batch :: (
  fn(
    batch : ArrayList(DAGNode),
    results : HashMap(String, StepResult),
    ctx : ExecutionContext,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    handles := ArrayList(JoinHandle(StepResult)).new();
    (i : usize) = usize(0);
    while(i < batch.len(), {
      node := batch(i);
      blocked := _dependency_failed(node, results);
      handles.push(e.io.spawn(_execute_node_unless_blocked(node, blocked, ctx, e.io, e.exn), e));
      i = (i + usize(1));
    });
    // NOT `join_all`. Its body awaits each handle in turn, and
    // `JoinHandle.await` on a handle that has NOT finished is a blocking
    // `__yo_async_poll_step` loop — while `_execute_batch` itself runs inside
    // `run_build`'s RESUMED continuation, so that loop nests the event loop.
    // C37's guard aborts on exactly this under `YO_ASYNC_STRICT=1`
    // (issues/fixed/build-scheduler-join-all-nests-the-event-loop.md), and
    // outside strict mode it silently serialises the scheduler it was added to
    // parallelise.
    //
    // The shape the guard's own message prescribes instead: poll
    // `is_finished()` and await `yield`. Once every handle is terminal,
    // `h.await` reads the result without polling at all — the emitted loop's
    // condition is false on entry.
    while(runtime(_any_task_pending(handles)), {
      e.io.await(yield(e.io), e.io);
    });
    outs := ArrayList(Option(StepResult)).new();
    (oi : usize) = usize(0);
    while(oi < handles.len(), {
      outs.push(handles(oi).await(e.io));
      oi = (oi + usize(1));
    });
    i = usize(0);
    while(i < batch.len(), {
      node := batch(i);
      result := match(
        outs.get(i),
        .Some(o) => match(
          o,
          .Some(r) => r,
          .None => StepResult(
            name : node.name.clone(),
            kind : node.kind,
            success : false,
            duration_ms : i64(0),
            description : `failed ${node.name}`
          )
        ),
        .None => StepResult(
          name : node.name.clone(),
          kind : node.kind,
          success : false,
          duration_ms : i64(0),
          description : `failed ${node.name}`
        )
      );
      results.insert(node.name, result);
      i = (i + usize(1));
    });
    ()
  })
);
execute_dag :: (
  fn(
    dag : ArrayList(DAGNode),
    ctx : ExecutionContext,
    io : Io,
    exn : Exception
  ) -> Impl(Future(HashMap(String, StepResult), IoExn))
)(
  io.async((e : IoExn) => {
    results := HashMap(String, StepResult).new();
    n := dag.len();
    if(n == usize(0), return(results));
    in_degree := HashMap(String, i32).new();
    completed := HashMap(String, bool).new();
    // Compute initial in-degrees
    i := usize(0);
    while(i < n, {
      node := dag(i);
      if(!(in_degree.contains_key(node.name)), {
        in_degree.insert(node.name, i32(0));
      });
      j := usize(0);
      nd := node.depends_on.len();
      while(j < nd, {
        dep := node.depends_on(j);
        // Only count if dep is in the dag
        k := usize(0);
        dep_in_dag := false;
        while(k < n, {
          if(dag(k).name == dep, {
            dep_in_dag = true;
          });
          k = (k + usize(1));
        });
        if(dep_in_dag, {
          cur := in_degree.get(node.name).unwrap_or(i32(0));
          in_degree.insert(node.name, cur + i32(1));
        });
        j = (j + usize(1));
      });
      i = (i + usize(1));
    });
    // Kahn's algorithm
    while(completed.len() < n, {
      ready := ArrayList(DAGNode).new();
      i = usize(0);
      while(i < n, {
        node := dag(i);
        if(!(completed.contains_key(node.name)) && (in_degree.get(node.name).unwrap_or(i32(0)) == i32(0)), {
          ready.push(node);
        });
        i = (i + usize(1));
      });
      if(ready.len() == usize(0), {
        e.exn.throw(dyn(String.from("Error: Build DAG stalled — possible undetected cycle.")));
      });
      // Execute the ready nodes, `ctx.jobs` at a time (§4.8). The default is
      // 1: the nodes' output streams to the user's terminal in DAG order, and
      // every recorded cli-case golden depends on that order. `-j N` opts into
      // overlap, and then the nodes' output interleaves, the way `make -j`
      // does.
      rn := ready.len();
      width := if(ctx.jobs < usize(1), usize(1), ctx.jobs);
      k := usize(0);
      while(k < rn, {
        batch := ArrayList(DAGNode).new();
        (bi : usize) = usize(0);
        while((bi < width) && ((k + bi) < rn), {
          batch.push(ready(k + bi));
          bi = (bi + usize(1));
        });
        k = (k + batch.len());
        e.io.await(_execute_batch(batch, results, ctx, e.io, e.exn), e);
      });
      // Mark complete and update in-degrees
      k = usize(0);
      while(k < rn, {
        completed_name := ready(k).name;
        completed.insert(completed_name, true);
        // Decrement in-degree of all not-yet-completed nodes that depend on this
        m := usize(0);
        while(m < n, {
          other := dag(m);
          if(!(completed.contains_key(other.name)), {
            j := usize(0);
            nd := other.depends_on.len();
            while(j < nd, {
              dep := other.depends_on(j);
              if(dep == completed_name, {
                cur := in_degree.get(other.name).unwrap_or(i32(1));
                in_degree.insert(other.name, cur - i32(1));
              });
              j = (j + usize(1));
            });
          });
          m = (m + usize(1));
        });
        k = (k + usize(1));
      });
    });
    results
  })
);
// ---------------------------------------------------------------------------
// Build summary
// ---------------------------------------------------------------------------
_print_summary_node :: (
  fn(
    node : DAGNode,
    results : HashMap(String, StepResult),
    node_map : HashMap(String, DAGNode),
    line_prefix : String,
    children_prefix : String,
    is_root : bool
  ) -> unit
)({
  status_str := match(
    results.get(node.name),
    .None => String.from("skipped"),
    .Some(r) => if(r.success, String.from("ok"), String.from("FAILED"))
  );
  desc := match(
    results.get(node.name),
    .None => node.name,
    .Some(r) => r.description
  );
  // The duration is part of what the summary promises; a node that never ran
  // (skipped) has none to show.
  timing := match(
    results.get(node.name),
    .None => String.new(),
    .Some(r) => ` (${r.duration_ms.to_string()} ms)`
  );
  if(
    is_root,
    println(`${desc} ${status_str}${timing}`),
    println(`${line_prefix}${desc} ${status_str}${timing}`)
  );
  nd := node.depends_on.len();
  i := usize(0);
  while(i < nd, {
    dep_name := node.depends_on(i);
    match(
      node_map.get(dep_name),
      .None => (),
      .Some(child) => {
        is_last := (i == (nd - usize(1)));
        connector := if(is_last, "└── ", "├── ");
        next_child_pfx := if(is_last, "    ", "│   ");
        recur(
          child,
          results,
          node_map,
          `${children_prefix}${connector}`,
          `${children_prefix}${next_child_pfx}`,
          false
        );
      }
    );
    i = (i + usize(1));
  });
});
print_build_summary :: (
  fn(
    results : HashMap(String, StepResult),
    dag : ArrayList(DAGNode),
    root_name : String
  ) -> unit
)({
  n := dag.len();
  total := n;
  succeeded := usize(0);
  i := usize(0);
  while(i < n, {
    match(
      results.get(dag(i).name),
      .None => (),
      .Some(r) => {
        if(r.success, {
          succeeded = (succeeded + usize(1));
        });
      }
    );
    i = (i + usize(1));
  });
  println("");
  println(`Build Summary: ${succeeded}/${total} steps succeeded`);
  // Find root node and print tree
  i = usize(0);
  while(i < n, {
    if(dag(i).name == root_name, {
      node_map := HashMap(String, DAGNode).new();
      j := usize(0);
      while(j < n, {
        nd := dag(j);
        node_map.insert(nd.name, nd);
        j = (j + usize(1));
      });
      _print_summary_node(dag(i), results, node_map, String.new(), String.new(), true);
    });
    i = (i + usize(1));
  });
});
// ---------------------------------------------------------------------------
// Step execution
// ---------------------------------------------------------------------------
/// The DAG for `step_name`, with every check a build owes the user before it
/// runs anything: the step exists, no dependency name resolves to nothing, and
/// the graph has no cycle. `--dry-run` runs exactly this and stops (the plan's
/// B7: it used to print a line per requested step without building a DAG,
/// validating the step or detecting a cycle).
_plan_step :: (
  fn(step_name : String, ctx : ExecutionContext, exn : Exception) -> ArrayList(DAGNode)
)({
  match(
    ctx.registry.find_step(step_name.clone()),
    .None => {
      available := ctx.registry.get_step_names();
      names_str := String.new();
      (i : usize) = usize(0);
      while(i < available.len(), {
        if(i > usize(0), names_str.push_str(", "));
        names_str.push_string(available(i).clone());
        i = (i + usize(1));
      });
      if(names_str.len() == usize(0), names_str.push_str("(none)"));
      exn.throw(dyn(`Error: Unknown step "${step_name}". Available: ${names_str}`));
    },
    .Some(_) => ()
  );
  missing := ArrayList(String).new();
  dag := build_dag_checked(ctx.registry, step_name.clone(), missing);
  if(missing.len() > usize(0), {
    joined := `", "`.join(missing);
    exn.throw(
      dyn(
        `Error: step "${step_name}" depends on "${joined}", which no artifact, test, run, doc or step defines.`
      )
    );
  });
  match(
    detect_cycle(dag),
    .Some(cycle_node) => {
      exn.throw(dyn(`Error: Cycle in build DAG involving "${cycle_node}"`));
    },
    .None => ()
  );
  dag
});
/// Print a resolved graph, one node per line in dependency order — what
/// `--dry-run` shows instead of building.
_print_plan :: (fn(step_name : String, dag : ArrayList(DAGNode)) -> unit)({
  println(`[dry-run] step "${step_name}" resolves to ${dag.len().to_string()} node(s):`);
  (i : usize) = usize(0);
  while(i < dag.len(), {
    node := dag(i);
    kind_label := match(
      node.kind,
      .Artifact => "artifact",
      .Test => "test",
      .Run => "run",
      .Doc => "doc",
      .Step => "step"
    );
    // The separator is bound first ON PURPOSE: a template nested inside an
    // interpolation is only parsed correctly by a compiler carrying
    // issues/fixed/nested-template-in-an-interpolation-takes-the-auto-import.md,
    // and the SEED builds this file.
    sep := String.from(", ");
    deps := if(node.depends_on.len() == usize(0), String.new(), ` <- ${sep.join(node.depends_on)}`);
    println(`[dry-run]   ${kind_label} ${node.name}${deps}`);
    i = (i + usize(1));
  });
});
execute_step :: (
  fn(
    step_name : String,
    ctx : ExecutionContext,
    dry_run : bool,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    // Planning is the same work either way — the step must exist, every
    // dependency name must resolve and the graph must be acyclic — so
    // `--dry-run` is a REAL resolution that stops here (the plan's B7).
    // The early return keeps the await below a top-level statement: an await
    // nested in an if-branch loses its continuation
    // (issues/async-await-in-nested-if-drops-continuation.md).
    dag := _plan_step(step_name.clone(), ctx, e.exn);
    if(dry_run, {
      _print_plan(step_name.clone(), dag);
      return(());
    });
    results := e.io.await(execute_dag(dag, ctx, e.io, e.exn), e);
    if(ctx.summary, print_build_summary(results, dag, step_name));
    // A failed step must fail the build. execute_node folds per-step errors
    // into StepResult.success so the DAG finishes and the summary can show
    // WHICH step broke — but exiting 0 after a failed compile would let CI
    // pass silently. Mirrors runBuild (src/build-runner.ts). See
    // issues/fixed/yo-build-exits-zero-on-failed-step.md
    (any_failed : bool) = false;
    (ri : usize) = usize(0);
    while(ri < dag.len(), {
      match(
        results.get(dag(ri).name),
        .Some(r) => if(!(r.success), {
          any_failed = true;
        }),
        .None => ()
      );
      ri = (ri + usize(1));
    });
    if(any_failed, {
      unsafe(exit(int(1)));
    });
  })
);
// ---------------------------------------------------------------------------
/// Byte-for-byte `printSteps` (src/build-runner.ts:342-354): the header wording,
/// the empty-registry line, and the TAB between name and description are all
/// load-bearing — `tests/cli-cases/build-list-steps` diffs this stdout against
/// the reference compiler's.
/// `yo build --list-options`: every `build.option(...)` the build file
/// declared, with its default and description, plus the value in force.
print_options :: (fn(registry : BuildRegistry) -> unit)({
  names := ArrayList(String).new();
  iter := registry.declared_options.keys();
  more := true;
  while(more, {
    match(
      iter.next(),
      .None => {
        more = false;
      },
      .Some(k) => names.push(k)
    );
  });
  if(names.len() == usize(0), {
    println("No build options declared.");
    return(());
  });
  names.sort();
  println("Available options:");
  (i : usize) = usize(0);
  while(i < names.len(), {
    name := names(i);
    i = (i + usize(1));
    match(
      registry.declared_options.get(name.clone()),
      .Some(opt) => {
        value := match(registry.cli_options.get(name.clone()), .Some(v) => v, .None => opt.default_value.clone());
        println(`  -D${name}=<value>\t${opt.description} (default: "${opt.default_value}", now: "${value}")`);
      },
      .None => ()
    );
  });
});
/// Every `-D<name>=<value>` the command line carried that no `build.option`
/// declares. A namespaced `-D<dep>.<opt>` belongs to a DEPENDENCY's build file
/// and is checked there (`_evaluate_dependency_builds`), so it is not reported
/// here. Undeclared names used to be accepted in silence, which makes a typo
/// in `-Dstrip=true` look like a build that ignored you (the plan's B4).
undeclared_options :: (fn(registry : BuildRegistry) -> ArrayList(String))({
  out := ArrayList(String).new();
  iter := registry.cli_options.keys();
  more := true;
  while(more, {
    match(
      iter.next(),
      .None => {
        more = false;
      },
      .Some(k) => {
        if(!(k.contains(String.from(".")) || registry.declared_options.contains_key(k.clone())), {
          out.push(k);
        });
      }
    );
  });
  out.sort();
  out
});
print_steps :: (fn(registry : BuildRegistry) -> unit)({
  steps := registry.steps;
  n := steps.len();
  if(n == usize(0), {
    println("No build steps defined.");
    return(());
  });
  println("Available steps:");
  i := usize(0);
  while(i < n, {
    step := steps(i);
    is_default := if(step.name == "install", " (default)", "");
    println(`  ${step.name}${is_default}\t${step.description}`);
    i = (i + usize(1));
  });
});
// ---------------------------------------------------------------------------
// Build file evaluation
// ---------------------------------------------------------------------------
/// The `[package]` table `build.manifest` reads, keyed by field name. A
/// project without a `yo.toml` contributes nothing, so every field is "".
_manifest_fields :: (fn(manifest_opt : Option(Manifest)) -> HashMap(String, String))({
  fields := HashMap(String, String).new();
  match(
    manifest_opt,
    .Some(m) => {
      fields.insert(String.from("name"), m.name.clone());
      fields.insert(String.from("version"), m.version.clone());
    },
    .None => ()
  );
  fields
});
/// Evaluate a `build.yo` file and return the `BuildRegistry` its
/// `build.executable(...)` / `build.step(...)` / … calls populated.
///
/// This used to shell out to `yo-cli build --serialize-registry` and parse JSON
/// from stdout. That flag DOES NOT EXIST in `src/` (zero grep hits), and the
/// JSON parser was `BuildRegistry.new()` — it ignored its input entirely — so
/// `yo build` built an empty DAG and exited 0. See plans/archive/P1_CLI_PARITY.md §3.
///
/// The real thing, mirroring `src/build-runner.ts`: clear the global registry,
/// evaluate the file through the module manager (the builtins mutate the
/// registry as a side effect of evaluation), then read the registry back.
///
/// A parse or evaluation error in the build file is a BUILD FAILURE: the
/// loader's handlers stash the rendered diagnostic (the single-print rule,
/// plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md D2), this edge prints it once
/// and throws. It used to be swallowed ("some errors are expected if the build
/// file has runtime components", mirroring TS), which turned every mistake in
/// a build file — a syntax error, a duplicate artifact name, a wrong field
/// type — into `Unknown step "install". Available: (none)` with no location
/// (issues/fixed/build-yo-evaluation-errors-are-swallowed.md).
evaluate_build_file :: (
  fn(
    build_file : String,
    defines : HashMap(String, String),
    manifest_opt : Option(Manifest),
    io : Io,
    exn : Exception
  ) -> Impl(Future(BuildRegistry, IoExn))
)(
  io.async((e : IoExn) => {
    clear_build_registry();
    // Seed `-Dname=value` overrides BEFORE evaluating: `build.option(...)`
    // reads `cli_options` at evaluation time and returns the override in place
    // of its declared default. The manifest's `[package]` table goes in the
    // same way — `build.manifest.name` reads it during evaluation.
    reg := get_build_registry();
    reg.cli_options = defines;
    reg.manifest_fields = _manifest_fields(manifest_opt);
    outcome := mm_load_yo_file(build_file, e.io, e.exn);
    load_error := _take_load_error();
    // No `mm_reset()` here: the caller resets once, after the manifest's
    // import roots are resolved. Re-loading the prelude after a reset
    // registers every prelude impl a second time into the process-wide
    // registries (see the cached-prelude guard in module_manager.yo), which
    // broke a second build file's `{ assert, panic } :: import("std/assert")`.
    if(!(outcome.ok), {
      match(
        load_error,
        .Some(rendered) => emit_rendered_text(rendered),
        .None => eprintln(`build: error in: ${build_file} (no diagnostic recorded)`)
      );
      e.exn.throw(dyn(`Error: Failed to evaluate build file ${build_file}`));
    });
    get_build_registry()
  })
);
// ---------------------------------------------------------------------------
// Exports
run_build :: (
  fn(
    options : BuildOptions,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    build_file_path := Path.new(options.build_file);
    build_file_exists := e.io.await(exists(build_file_path, e.io), e.io);
    if(!(build_file_exists), {
      e.exn.throw(dyn(`Error: Build file not found: ${build_file_path.to_string()}`));
    });
    // `path.dirname` semantics, which is what src/build-runner.ts uses. Yo's
    // `Path.parent()` follows Rust — `Path::new("foo").parent()` is `Some("")` —
    // so the default `./build.yo` yielded an EMPTY project dir, and every derived
    // path became absolute: the output dir was `/yo-out/<target>/bin`, and
    // `yo build` died with a bare "read-only filesystem" (macOS's root volume).
    // `yo build` could not build anything from a relative build file.
    project_dir := match(
      build_file_path.parent(),
      .Some(p) => {
        ps := p.to_string();
        if(ps.len() == usize(0), String.from("."), ps)
      },
      .None => String.from(".")
    );
    c_compiler := match(
      options.c_compiler,
      .Some(cc) => cc,
      .None => String.from("clang")
    );
    // The project's manifest (yo.toml): its `[package]` table is what
    // `build.manifest` reads during the evaluation below, its dependency
    // closure is what every artifact's `import("name")` resolves through, and
    // its git dependencies are fetched further down. Reading it needs no
    // evaluator — `load_manifest` parses TOML.
    manifest_opt := project_manifest(project_dir.clone(), e.exn);
    // Evaluate build.yo to populate the registry.
    registry := e.io.await(
      evaluate_build_file(
        build_file_path.to_string(),
        options.defines,
        manifest_opt,
        e.io,
        e.exn
      ),
      e
    );
    if(options.list_steps, {
      print_steps(registry);
      return(());
    });
    if(options.list_options, {
      print_options(registry);
      return(());
    });
    unknown_opts := undeclared_options(registry);
    if(unknown_opts.len() > usize(0), {
      joined := `", "`.join(unknown_opts);
      e.exn.throw(
        dyn(
          `Error: -D"${joined}" is not an option of this build file. Run 'yo build --list-options' to see the ones it declares.`
        )
      );
    });
    // Fetching the git dependencies the manifest declares runs before the
    // single evaluator reset that follows (see evaluate_build_file).
    e.io.await(resolve_build_import_roots(manifest_opt, registry, options.locked, options.offline, options.verbose, e.io, e.exn), e);
    // Every `dep.artifact(...)` this build file named becomes a real artifact
    // of ours, built from the dependency's own build.yo (§4.5.2). Runs after
    // the fetch above, so a git dependency's sources are on disk.
    match(
      manifest_opt,
      .Some(m) => e.io.await(_evaluate_dependency_builds(m, registry, options.defines, e.io, e.exn), e),
      .None => ()
    );
    project_name := match(manifest_opt, .Some(m) => m.name.clone(), .None => String.new());
    mm_reset();
    // Resolve system libraries per-artifact via pkg-config
    // (build-runner.ts:234-275). Each artifact only gets flags for libraries
    // it explicitly linked; wasm targets skip host pkg-config/vcpkg (paths
    // are incompatible) but still add `-l<name>` for the emscripten linker.
    if(registry.system_libraries.len() > usize(0), {
      (sa_i : usize) = usize(0);
      while(sa_i < registry.artifacts.len(), {
        art_opt := registry.artifacts.get(sa_i);
        sa_i = (sa_i + usize(1));
        match(
          art_opt,
          .Some(art) => if(art.linked_system_libs.len() > usize(0), {
            linked := ArrayList(BuildSystemLibrary).new();
            (sl_i : usize) = usize(0);
            while(sl_i < registry.system_libraries.len(), {
              match(
                registry.system_libraries.get(sl_i),
                .Some(slib) => {
                  (is_linked : bool) = false;
                  (ln_i : usize) = usize(0);
                  while((ln_i < art.linked_system_libs.len()) && !(is_linked), {
                    match(
                      art.linked_system_libs.get(ln_i),
                      .Some(ln) => if(ln == slib.name, {
                        is_linked = true;
                      }),
                      .None => ()
                    );
                    ln_i = (ln_i + usize(1));
                  });
                  if(is_linked, {
                    linked.push(slib);
                  });
                },
                .None => ()
              );
              sl_i = (sl_i + usize(1));
            });
            if(linked.len() > usize(0), {
              eff_target := match(options.target_triple, .Some(t) => t, .None => art.target.clone());
              eff_ti := match(parse_target(eff_target.clone()), .Ok(t) => t, .Err(_) => host_target());
              if(is_target_wasm(eff_ti), {
                (wl_i : usize) = usize(0);
                while(wl_i < linked.len(), {
                  match(
                    linked.get(wl_i),
                    .Some(wlib) => {
                      (already : bool) = false;
                      (al_i : usize) = usize(0);
                      while((al_i < art.link_libraries.len()) && !(already), {
                        match(
                          art.link_libraries.get(al_i),
                          .Some(aln) => if(aln == wlib.name, {
                            already = true;
                          }),
                          .None => ()
                        );
                        al_i = (al_i + usize(1));
                      });
                      if(!(already), {
                        art.link_libraries.push(wlib.name.clone());
                      });
                    },
                    .None => ()
                  );
                  wl_i = (wl_i + usize(1));
                });
              }, {
                sys_flags := e.io.await(resolve_all_system_libraries(linked, options.verbose, e.io, e.exn), e);
                _push_all_strings(art.include_paths, sys_flags.include_paths);
                _push_all_strings(art.library_paths, sys_flags.library_paths);
                _push_all_strings(art.link_libraries, sys_flags.link_libraries);
                _push_all_strings(art.defines, sys_flags.defines);
                _push_all_strings(art.c_flags, sys_flags.c_flags);
                (rf_i : usize) = usize(0);
                while(rf_i < sys_flags.runtime_files.len(), {
                  match(
                    sys_flags.runtime_files.get(rf_i),
                    .Some(rf) => {
                      (rf_seen : bool) = false;
                      (rfe_i : usize) = usize(0);
                      while((rfe_i < art.runtime_files.len()) && !(rf_seen), {
                        match(
                          art.runtime_files.get(rfe_i),
                          .Some(rfe) => if(rfe == rf, {
                            rf_seen = true;
                          }),
                          .None => ()
                        );
                        rfe_i = (rfe_i + usize(1));
                      });
                      if(!(rf_seen), {
                        art.runtime_files.push(rf.clone());
                      });
                    },
                    .None => ()
                  );
                  rf_i = (rf_i + usize(1));
                });
              });
            });
          }),
          .None => ()
        );
      });
    });
    ctx := ExecutionContext(
      registry : registry,
      project_dir : project_dir,
      project_name : project_name,
      c_compiler : c_compiler,
      target_triple : options.target_triple,
      sysroot : options.sysroot,
      verbose : options.verbose,
      dry_run : options.dry_run,
      summary : options.summary,
      run_args : options.run_args,
      jobs : options.jobs
    );
    requested := if(options.steps.len() == usize(0), {
      defaults := ArrayList(String).new();
      defaults.push(String.from("install"));
      defaults
    }, options.steps);
    i := usize(0);
    n := requested.len();
    while(i < n, {
      step_name := requested(i).clone();
      // `--dry-run` resolves the graph and executes NOTHING. It is a REAL
      // resolution: the step must exist, every dependency name must resolve,
      // and a cycle is an error — the help text promises "resolve the build
      // graph without running it", and printing one line per requested step
      // promised nothing (the plan's B7). `execute_step` itself branches,
      // after planning and before its only await.
      e.io.await(execute_step(step_name, ctx, options.dry_run, e.io, e.exn), e);
      i = (i + usize(1));
    });
  })
);
// ---------------------------------------------------------------------------
