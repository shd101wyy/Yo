  SolverProbe,
  probe_solver_at,
  probe_solver,
  forget_solver_probe,
  set_require_solver,
  solver_required,
  set_solver_notice_file,
  solver_unavailable_line,
  report_solver_unavailable,
  fetch_z3_release,
  try_fetch_z3_release,
  ensure_z3,
  run_z3_script,
  _z3_exists_sync,
  _z3_read_file_sync,
  _z3_write_file_sync,
  _z3_unlink_sync,
  _z3_ensure_dir_sync,
  Z3Sexpr,
  parse_z3_sexprs,
  z3_sexpr_to_string,
  z3_check_sat_of,
  z3_unsat_core_of,
  z3_error_before_verdict,
  z3_value_pairs_of,
  z3_reason_unknown_of,
  z3_rlimit_used_of,
  z3_version_of_binary
);
