//! verifier/z3 — the Z3 solver harness (V2): pin, discovery, acquisition,
//! and the request/response protocol.
//!
//! One solver, pinned and versioned (decision D2). Same source + same
//! compiler + same pin ⇒ byte-identical verdicts:
//!   - `:rlimit` budgets (deterministic resource accounting), never
//!     wall-clock semantics; the `:timeout` is a crash-guard backstop only.
//!   - fixed `:random-seed 0`.
//!   - one fresh Z3 process per query — stronger isolation than the plan's
//!     original "one process per function with push/pop" (no solver state
//!     bleeds between obligations at all) at a few ms of spawn cost.
//!
//! SYNCHRONOUS ON PURPOSE (the `module-manager.yo` comptime-file-IO
//! idiom): the verifier runs inside compile-time evaluation and inside
//! async CLI tasks, where async `std/fs` compiles to a blocking poll loop
//! that drives the event loop from inside a task (C37/C42 — the runtime
//! guard aborts under YO_ASYNC_STRICT=1). Script I/O and the solver spawn
//! use libc directly (`system(3)` + open/read/fopen); the ONLY async path
//! is the one-time download (`fetch_z3_release` — std/http has no sync
//! form), which mirrors `src/version-cache.yo`'s release-fetch shape.
//!
//! The query protocol (plan §"The query protocol"): each obligation runs as
//! a complete SMT-LIB script passed as a FILE argument (`z3 -smt2 <file>`)
//! with stdout/stderr redirected to a second file — no pipes, no
//! truncation, no interactive state. The script asserts the assumptions,
//! the NEGATED goal, and asks check-sat, then requests evidence:
//!   unsat    ⇒ Proved (get-unsat-core names the participating clauses)
//!   sat      ⇒ Refuted (get-value over the declarations = counter-example)
//!   unknown  ⇒ Unproven (budget); `(get-info :reason-unknown)` and
//!              `(get-info :rlimit)` say whether the budget or the
//!              wall-clock backstop stopped it
pragma(Pragma.AllowUnsafe);
{ String, StringBuilder } :: import("std/string");
{ eprintln } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array-list");
{ env, temp_dir } :: import("std/env");
{ Exception, IoExn } :: import("std/error");
{ FetchOptions, fetch_with } :: import("std/http/client");
{ Command } :: import("std/process/command");
{ host_target, is_target_windows, is_target_linux, is_target_macos, arch_triple_str } :: import("../target.yo");
{ get_global_cache_dir } :: import("../cache.yo");
{ CURRENT_YO_VERSION, yo_releases_download_url } :: import("../version.yo");
{ tls_available } :: import("std/crypto/tls");
{ Instant } :: import("std/time/instant");
stat :: import("std/libc/sys/stat");
fcntl :: import("std/libc/fcntl");
unistd :: import("std/libc/unistd");
stdio :: import("std/libc/stdio");
stdlib :: import("std/libc/stdlib");
{ GlobalAllocator } :: import("std/allocator");
{ malloc, free } :: GlobalAllocator;
// ============================================================================
// Pin manifest
// ============================================================================
/// The one pinned Z3 version (bumped 4.13.3 → 5.1.0, 2026-09-08). Bumps are
/// deliberate release-note events, never a side effect. The release builds
/// this version from source for every target it publishes
/// (`scripts/build-static-z3.sh`, `.github/workflows/solver.yml`).
Z3_VERSION :: "5.1.0";
/// The canonical target triple of this host's solver build: the triple the
/// release names the asset by and the solver directory carries. Linux is
/// always the static musl build, which runs on glibc and musl systems alike
/// (plans/backlog/DEFAULT_ON_VERIFICATION.md §2.3). `""` for a host the
/// release publishes no solver for.
z3_host_triple :: (fn() -> String)({
  t := host_target();
  arch := String.from(arch_triple_str(t.arch));
  cond(
    (is_target_linux(&t) && (arch == "x86_64")) => String.from("x86_64-unknown-linux-musl"),
    (is_target_linux(&t) && (arch == "aarch64")) => String.from("aarch64-unknown-linux-musl"),
    (is_target_macos(&t) && (arch == "x86_64")) => String.from("x86_64-apple-darwin"),
    (is_target_macos(&t) && (arch == "aarch64")) => String.from("aarch64-apple-darwin"),
    (is_target_windows(&t) && (arch == "x86_64")) => String.from("x86_64-pc-windows-msvc"),
    (is_target_windows(&t) && (arch == "aarch64")) => String.from("aarch64-pc-windows-msvc"),
    true => String.from("")
  )
});
/// Where fetched solvers live: `<yo cache>/solvers` (`src/cache.yo`'s root,
/// the same one the installers compute).
z3_solvers_root :: (fn() -> String)(`${get_global_cache_dir()}/solvers`);
/// The solver binary's path inside the solver cache:
/// `<solvers>/z3-<pin>-<triple>/bin/z3[.exe]`.
z3_binary_path :: (fn() -> String)({
  exe := cond(
    is_target_windows(host_target()) => String.from("z3.exe"),
    true => String.from("z3")
  );
  `${z3_solvers_root()}/z3-${Z3_VERSION}-${z3_host_triple()}/bin/${exe}`
});
/// The release asset that carries Yo `yo_version`'s solver for this host:
/// `yo-v<version>-<triple>-z3.tar.gz`, whose one top-level directory is
/// `z3-<pin>-<triple>/` (`bin/z3`, `LICENSE.txt`). Named by the Yo version so
/// an installer needs no copy of the pin.
z3_release_asset_name :: (fn(yo_version : &String) -> String)(`yo-v${yo_version}-${z3_host_triple()}-z3.tar.gz`);
z3_release_asset_url :: (fn(yo_version : &String) -> String)(
  `${yo_releases_download_url()}/v${yo_version}/${z3_release_asset_name(yo_version)}`
);
// ============================================================================
// Sync file shims (the module-manager.yo comptime-file-IO idiom)
// ============================================================================
/// Whether `path` exists (libc `stat`; 512-byte statx buffer like
/// module_manager's `_path_exists_sync`).
_z3_exists_sync :: (fn(path : &String) -> bool)({
  path_buf := path.to_cstr();
  cstr := path_buf.ptr().unwrap();
  buf := malloc(usize(512)).unwrap();
  status := unsafe(stat.stat((*char)(cstr), buf));
  free(.Some(buf));
  status == int(0)
});
/// Read a whole file synchronously; `.None` on any failure (the caller
/// decides what a missing/unreadable file means).
_z3_read_file_sync :: (fn(path : &String) -> Option(String))({
  path_c := path.to_cstr();
  cstr := path_c.ptr().unwrap();
  fd := unsafe(fcntl.open((*char)(cstr), int(fcntl.O_RDONLY)));
  if(fd < int(0), {
    return(Option(String).None);
  });
  result := ArrayList(u8).new();
  buf := (*u8)(malloc(usize(4096)).unwrap());
  while(true, {
    // i64 immediately: `ssize_t` has no nameable constructor, but casting
    // its RESULT is fine (module-manager.yo's note).
    n := i64(unsafe(unistd.read(fd, (*void)(buf), usize(4096))));
    cond(
      (n < i64(0)) => {
        free(.Some((*void)(buf)));
        unsafe(unistd.close(fd));
        return(Option(String).None);
      },
      (n == i64(0)) => break,
      true => {
        (i : usize) = usize(0);
        while(i < usize(n), {
          result.push((buf.add(i)).*);
          i = (i + usize(1));
        });
      }
    );
  });
  free(.Some((*void)(buf)));
  unsafe(unistd.close(fd));
  match(
    String.from_utf8(result),
    .Ok(s) => Option(String).Some(s),
    .Err(_) => Option(String).None
  )
});
/// Write a whole file synchronously (fopen "w": creates/truncates).
/// `.false` on failure.
_z3_write_file_sync :: (fn(path : &String, contents : &String) -> bool)({
  path_c := path.to_cstr();
  pcstr := path_c.ptr().unwrap();
  mode_c := String.from("w").to_cstr();
  mcstr := mode_c.ptr().unwrap();
  f := unsafe(stdio.fopen((*char)(pcstr), (*char)(mcstr)));
  match(
    f,
    .Some(fh) => {
      // B4-1b: the raw pointer is taken straight from the borrowed `contents`
      // (the handle copy this replaced is what the migration flagged as a
      // raw-pointer alias); `ptr`/`len` both borrow their receiver.
      bptr := match(
        contents.ptr(),
        .Some(p) => p,
        .None => (*u8)(malloc(usize(1)).unwrap())
      );
      wrote := unsafe(stdio.fwrite((*void)(bptr), usize(1), contents.len(), fh));
      unsafe(stdio.fclose(fh));
      wrote == contents.len()
    },
    .None => false
  )
});
/// Unlink a file (best effort — failures ignored; the temp dir recovers).
_z3_unlink_sync :: (fn(path : &String) -> unit)({
  path_c := path.to_cstr();
  cstr := path_c.ptr().unwrap();
  unsafe(unistd.unlink((*char)(cstr)));
  ()
});
/// Ensure a directory (and its parents) exist — portable BECAUSE it shells
/// out: libc `mkdir` is 2-arg on POSIX but 1-arg in the Windows CRT, and the
/// 2-arg call breaks the Windows cross-emit even from dead code, while
/// `system(3)` — already this module's solver-spawn primitive — compiles
/// everywhere. POSIX `mkdir -p` and cmd's `md` both create intermediates;
/// the exit status is advisory (Windows `md` errors on an existing dir) and
/// deliberately ignored: a failed creation surfaces as the fopen failure in
/// `_z3_write_file_sync`, i.e. "cache off", not a verifier error.
_z3_ensure_dir_sync :: (fn(path : &String) -> unit)({
  cmd := cond(
    is_target_windows(host_target()) => `cmd /c md "${path}"`,
    true => `mkdir -p "${path}"`
  );
  cmd_buf := cmd.to_cstr();
  cmd_cstr := cmd_buf.ptr().unwrap();
  unsafe(stdlib.system(Option(*char).Some((*char)(cmd_cstr))));
  ()
});
/// Monotonic counter for temp-file names — unique within one process run,
/// like the contract wrapper's `g_contract_old_counter`.
(mut(g_z3_tmp_counter) : usize) = usize(0);
/// Per-process temp-name prefix: the monotonic clock at nanosecond
/// resolution, captured lazily on first use. LOAD-BEARING for concurrency:
/// the temp dir is SHARED, and a counter-only name let one concurrent yo
/// process's z3 read another's script or output file — wrong verdicts,
/// different verify+ strips, and emitted C that flips under load
/// (issues/fixed/z3-temp-names-collided-across-concurrent-yo-processes.md). Temp names
/// never reach emitted C, so seeding them from the wall of the clock does
/// not affect compile determinism.
(mut(g_z3_tmp_prefix) : Option(i64)) = Option(i64).None;
/// A fresh temp path under the system temp dir
/// (`<tmp>/yo-verify-<start-nanos>-<n>.<ext>`, unique per process AND per
/// query).
_z3_temp_path :: (fn(ext : &String) -> String)({
  match(
    g_z3_tmp_prefix,
    .None => {
      t := Instant.now();
      g_z3_tmp_prefix = Option(i64).Some((t.secs * i64(1000000000)) + t.nanos);
    },
    .Some(_) => ()
  );
  prefix := g_z3_tmp_prefix;
  n := g_z3_tmp_counter;
  g_z3_tmp_counter = (n + usize(1));
  p := `${temp_dir()}/yo-verify-${prefix.unwrap().to_string()}-${n.to_string()}.${ext}`;
  p
});
// ============================================================================
// Discovery & acquisition
// ============================================================================
/// Discovery order (plan §"Acquisition"): `YO_Z3_PATH` env override → the
/// pinned install in the cache. `.None` when neither exists.
discover_z3 :: (fn() -> Option(String))({
  override := env.get(String.from("YO_Z3_PATH"));
  match(
    override,
    .Some(p) => Option(String).Some(p),
    .None => {
      cached := z3_binary_path();
      if(
        _z3_exists_sync(cached.clone()),
        Option(String).Some(cached),
        Option(String).None
      )
    }
  )
});
/// What a probe of the solver found. `probe_solver` runs once per process,
/// so a missing or broken solver is reported in one line for the whole run,
/// not once per function or file (plans/backlog/DEFAULT_ON_VERIFICATION.md
/// §5 item 8).
SolverProbe :: enum(
  /// The binary runs; `identity` is its `--version` line.
  Usable(path : String, identity : String),
  /// No `YO_Z3_PATH`, and nothing in the solver cache.
  Missing,
  /// `YO_Z3_PATH` or `--solver-path` names no file.
  NotFound(path : String),
  /// The file exists and does not run: `detail` is the first line its
  /// `--version` printed (a loader error, "Permission denied", ...).
  Unusable(path : String, detail : String)
);
derive(SolverProbe, Clone);
/// Probe the solver at `path`: it must exist and answer `--version`.
probe_solver_at :: (fn(path : &String) -> SolverProbe)({
  if(!_z3_exists_sync(path.clone()), {
    return(SolverProbe.NotFound(path : path.clone()));
  });
  match(
    _z3_run_version(path),
    .Ok(id) => SolverProbe.Usable(path : path.clone(), identity : id),
    .Err(detail) => SolverProbe.Unusable(path : path.clone(), detail : detail)
  )
});
/// The explicit path the memoized probe answered for (`""` = discovery).
(mut(g_solver_probe_key) : Option(String)) = Option(String).None;
(mut(g_solver_probe) : Option(SolverProbe)) = Option(SolverProbe).None;
/// The solver this process uses: `explicit` (a `--solver-path`) when given,
/// else discovery. Probed once per process and path; later calls return the
/// first answer until `forget_solver_probe`.
probe_solver :: (fn(explicit : &Option(String)) -> SolverProbe)({
  key := match(explicit, .Some(p) => p.clone(), .None => String.new());
  same := match(g_solver_probe_key.clone(), .Some(k) => (k == key), .None => false);
  if(same, {
    match(
      g_solver_probe.clone(),
      .Some(known) => {
        return(known);
      },
      .None => ()
    );
  });
  probe := match(
    explicit,
    .Some(p) => probe_solver_at(p),
    .None => match(
      discover_z3(),
      .Some(found) => probe_solver_at(&found),
      .None => SolverProbe.Missing
    )
  );
  g_solver_probe_key = Option(String).Some(key);
  g_solver_probe = Option(SolverProbe).Some(probe.clone());
  probe
});
/// Drop the memoized probe, so the next `probe_solver` looks again (after an
/// install put a solver in place).
forget_solver_probe :: (fn() -> unit)({
  g_solver_probe_key = Option(String).None;
  g_solver_probe = Option(SolverProbe).None;
});
// ----------------------------------------------------------------------------
// Reporting a solver that is missing or cannot run
// ----------------------------------------------------------------------------
/// `--require-solver` (compile, check, build): a verification that cannot run
/// for want of a solver fails instead of reporting one line.
(mut(g_require_solver) : bool) = false;
set_require_solver :: (fn(on : bool) -> unit)({
  g_require_solver = on;
});
/// `--require-solver` or `YO_REQUIRE_SOLVER=1`.
solver_required :: (fn() -> bool)(
  g_require_solver || match(env.get(String.from("YO_REQUIRE_SOLVER")), .Some(v) => (v == "1"), .None => false)
);
/// `--solver-notice <file>` (set by `yo build` on its compiles): write the
/// solver line to this file instead of printing it, and the build prints it
/// once for the whole build.
(mut(g_solver_notice_file) : Option(String)) = Option(String).None;
set_solver_notice_file :: (fn(path : Option(String)) -> unit)({
  g_solver_notice_file = path;
});
(mut(g_solver_notice_printed) : bool) = false;
/// The one line for a verification that has tasks and no usable solver.
/// `needs_proofs`: a `verify`-mode task is among them (its runtime asserts are
/// suppressed, so `compile` fails); `required`: `solver_required()`.
solver_unavailable_line :: (fn(probe : &SolverProbe, needs_proofs : bool, required : bool) -> String)({
  what := match(
    probe,
    .Missing => String.from("no Z3 solver found"),
    .NotFound(path) => `solver path '${path}' does not exist`,
    .Unusable(path, detail) => `the Z3 solver at '${path}' cannot run (${detail})`,
    .Usable(path, _) => `the Z3 solver at '${path}' was not used`
  );
  remedy := `Run 'yo verify <file>' once to fetch Z3 ${Z3_VERSION}, or point YO_Z3_PATH at one.`;
  cond(
    required => `verify: error: ${what}, and --require-solver (or YO_REQUIRE_SOLVER=1) requires one. ${remedy}`,
    needs_proofs => `verify: ${what} — this file's verify-mode ensures clauses need proofs (their runtime asserts are suppressed). ${remedy}`,
    true => `verify: ${what} — verify+ contracts keep their runtime asserts, so nothing is proved. ${remedy}`
  )
});
/// Report `line` once per process: on stderr, or into the `--solver-notice`
/// file when `yo build` asked for it (every compile writes its own file).
report_solver_unavailable :: (fn(line : &String) -> unit)({
  match(
    g_solver_notice_file.clone(),
    .Some(path) => {
      _ := _z3_write_file_sync(&path, line);
    },
    .None => {
      if(!g_solver_notice_printed, {
        eprintln(line);
        g_solver_notice_printed = true;
      });
    }
  );
});
/// Download Yo release `yo_version`'s solver asset and unpack it into the
/// solver cache. `.Ok(binary)` once the pinned binary is in place (`.Ok(the
/// solvers root)` for another release's asset, whose pin this compiler does
/// not know); `.Err(why)`
/// for every expected failure (no asset for this host, no TLS, an HTTP error,
/// an extraction failure). A transport failure inside `fetch_with` throws
/// through `e.exn`, as every std/http call does; `try_fetch_z3_release` turns
/// that into an `.Err` too. The one async path of the harness (std/http has no
/// sync form): straight-line awaits on String values, the shape of
/// `src/version-cache.yo`'s release fetch.
fetch_z3_release :: (
  fn(yo_version : &String, io : Io) -> Impl(Future(Result(String, String), IoExn))
)({
  owned_version := yo_version.clone();
  io.async((e : IoExn) => {
    triple := z3_host_triple();
    if(triple.len() == usize(0), {
      return(Result(String, String).Err(`no Yo release publishes a Z3 build for this host (${host_target().triple})`));
    });
    if(!tls_available(), {
      return(Result(String, String).Err(String.from("TLS is unavailable in this build, and the download needs HTTPS")));
    });
    root := z3_solvers_root();
    _z3_ensure_dir_sync(&root);
    archive := _z3_temp_path(String.from("tar.gz"));
    url := z3_release_asset_url(&owned_version);
    opts := FetchOptions.new();
    opts = opts.with_header(`User-Agent`, `yo-verifier`);
    opts = opts.with_max_redirects(usize(5));
    opts = opts.with_max_response_bytes(usize(268435456));
    resp := e.io.await(fetch_with(url.clone(), &opts, e.io), e);
    if(resp.status.is_error(), {
      return(Result(String, String).Err(`HTTP ${resp.status.to_string()} fetching ${url}`));
    });
    if(!_z3_write_file_sync(archive.clone(), &resp.body), {
      return(Result(String, String).Err(`could not write ${archive}`));
    });
    // The archive's one top-level directory is `z3-<pin>-<triple>/`, so it
    // unpacks straight into the solvers root.
    mut(tc) := Command.new(String.from("tar"));
    tc = tc.arg(String.from("-xzf"));
    tc = tc.arg(archive.clone());
    tc = tc.arg(String.from("-C"));
    tc = tc.arg(root.clone());
    tout := e.io.await(tc.output(e.io), e);
    _z3_unlink_sync(archive.clone());
    if(!tout.status.success(), {
      return(Result(String, String).Err(`'tar' could not unpack ${url}`));
    });
    forget_solver_probe();
    // Another release's asset may carry another pin (`yo version install`):
    // it unpacked under its own `z3-<pin>-<triple>/`, which is where that
    // release's compiler looks.
    if(owned_version != CURRENT_YO_VERSION, {
      return(Result(String, String).Ok(root));
    });
    bin := z3_binary_path();
    if(!_z3_exists_sync(bin.clone()), {
      return(Result(String, String).Err(`${url} does not hold ${bin}`));
    });
    Result(String, String).Ok(bin)
  })
});
/// `fetch_z3_release` as a task with its own swallow handler, so a transport
/// failure reads as `.Err` instead of failing the caller (`yo build`'s
/// first-need fetch and `yo version install` must not fail over the solver).
_z3_fetch_task :: (
  fn(sink(version) : String, io : Io) -> Impl(Future(Result(String, String), IoExn))
)(
  io.async((e : IoExn) => {
    // The unwind payload must match the future's payload type (see
    // `_git_output_task` in src/build-runner.yo); the task aborts either way.
    swallow := Exception(throw : (_e -> unwind(Result(String, String).Err(String.new()))));
    e.io.await(fetch_z3_release(&version, e.io), IoExn(io : e.io, exn : swallow))
  })
);
try_fetch_z3_release :: (
  fn(yo_version : &String, io : Io) -> Impl(Future(Result(String, String), IoExn))
)({
  owned_version := yo_version.clone();
  io.async((e : IoExn) => {
    url := z3_release_asset_url(&owned_version);
    // Spawned and JOINED: `join` reads the task's abort as `.None`.
    t := e.io.spawn(_z3_fetch_task(owned_version.clone(), e.io), e);
    out_opt := e.io.await(t.join(e.io), e.io);
    match(
      out_opt,
      .Some(r) => r,
      .None => Result(String, String).Err(`could not download ${url}`)
    )
  })
});
/// Resolve the solver for `yo verify`: discovery first, then this compiler's
/// own release asset.
ensure_z3 :: (
  fn(io : Io, exn : Exception) -> Impl(Future(String, IoExn))
)(
  io.async((e : IoExn) => {
    found := discover_z3();
    match(
      found,
      .Some(p) => {
        return(p);
      },
      .None => ()
    );
    version := String.from(CURRENT_YO_VERSION);
    eprintln(`verify: fetching Z3 ${Z3_VERSION} from ${z3_release_asset_url(&version)}`);
    fetched := e.io.await(fetch_z3_release(&version, e.io), e);
    match(
      fetched,
      .Ok(p) => p,
      .Err(why) => {
        e.exn.throw(dyn(Box.new(`verify: could not fetch Z3 ${Z3_VERSION}: ${why}. Set YO_Z3_PATH to an existing z3 binary.`)));
        String.new()
      }
    )
  })
);
// ============================================================================
// The query protocol
// ============================================================================
/// Run one complete SMT-LIB script through a fresh `z3 -smt2 <file>`
/// process and return its combined stdout (stderr redirected in). Errors
/// carry the exit status and the captured output for the diagnostic.
run_z3_script :: (fn(binary : &String, script : &String) -> Result(String, String))({
  script_path := _z3_temp_path(String.from("smt2"));
  out_path := _z3_temp_path(String.from("out"));
  sp_write := script_path.clone();
  if(!_z3_write_file_sync(&sp_write, script), {
    return(Result(String, String).Err(`verify: failed to write ${script_path}`));
  });
  cmd := `${binary} -smt2 ${script_path} > ${out_path} 2>&1`;
  // Bind the WHOLE ArrayList, not just its raw pointer: a method-chain
  // temporary (`cmd.to_cstr().ptr().unwrap()`) is dropped only on some
  // codegen paths, leaking its heap buffer (ASan: 40B per solver run).
  cmd_buf := cmd.to_cstr();
  cmd_cstr := cmd_buf.ptr().unwrap();
  status := unsafe(stdlib.system(Option(*char).Some((*char)(cmd_cstr))));
  op_read := out_path.clone();
  out_opt := _z3_read_file_sync(&op_read);
  sp_unlink := script_path.clone();
  _z3_unlink_sync(&sp_unlink);
  op_unlink := out_path.clone();
  _z3_unlink_sync(&op_unlink);
  out := match(
    out_opt,
    .Some(o) => o,
    .None => String.new()
  );
  if(status < int(0), {
    return(Result(String, String).Err(`verify: failed to spawn z3 (${status.to_string()})`));
  });
  // system(3) returns the WAIT status; the exit code is the high byte.
  exit_code := (status / int(256));
  // z3 exits nonzero when a post-check-sat EVIDENCE request is unavailable
  // (get-value on unsat, get-unsat-core on sat) — it still prints the error
  // AND the verdict, so a parseable verdict wins over the exit status.
  out_scan := out.clone();
  if((exit_code != int(0)) && z3_check_sat_of(parse_z3_sexprs(&out_scan)).is_none(), {
    return(
      Result(String, String).Err(`verify: z3 exited with status ${exit_code.to_string()}\n${out}`)
    );
  });
  Result(String, String).Ok(out)
});
/// The solver binary's own identity: the trimmed output of
/// `<binary> --version` (`Z3 version 5.1.0 - 64 bit`). `.None` when the
/// probe cannot run, exits nonzero or prints nothing. The verify cache keys
/// on this, not on `Z3_VERSION`: discovery honours `YO_Z3_PATH`, which
/// accepts any z3, and a verdict from one solver must not answer for
/// another
/// (issues/fixed/2026-11-04-the-verify-cache-stores-wall-clock-unknown-verdicts-and-keys-on-the-pinned-z3-version-not-the-binary.md).
z3_version_of_binary :: (fn(binary : &String) -> Option(String))(
  match(
    _z3_run_version(binary),
    .Ok(v) => Option(String).Some(v),
    .Err(_) => Option(String).None
  )
);
/// Run `<binary> --version`: `.Ok(trimmed output)`, or `.Err(why)` with the
/// first line the binary printed (a loader error, "Permission denied") or its
/// exit status.
_z3_run_version :: (fn(binary : &String) -> Result(String, String))({
  out_path := _z3_temp_path(String.from("version"));
  cmd := `${binary} --version > ${out_path} 2>&1`;
  cmd_buf := cmd.to_cstr();
  cmd_cstr := cmd_buf.ptr().unwrap();
  status := unsafe(stdlib.system(Option(*char).Some((*char)(cmd_cstr))));
  op_read := out_path.clone();
  out_opt := _z3_read_file_sync(&op_read);
  op_unlink := out_path.clone();
  _z3_unlink_sync(&op_unlink);
  text := match(
    out_opt,
    .Some(o) => o.trim(),
    .None => String.new()
  );
  if(status != int(0), {
    first := match(
      text.index_of(String.from("\n")),
      .Some(nl) => text.substring(usize(0), nl).trim(),
      .None => text.clone()
    );
    return(
      Result(String, String).Err(
        if(first.len() == usize(0), `exit status ${(status / int(256)).to_string()}`, first)
      )
    );
  });
  if(text.len() == usize(0), {
    return(Result(String, String).Err(String.from("it printed no version")));
  });
  Result(String, String).Ok(text)
});
// ============================================================================
// S-expression scanning (verdict parsing — pure, unit-testable)
// ============================================================================
/// A parsed S-expression: atom or list. A value tree: a `List` owns its
/// items (plans/VALUES_BY_DEFAULT.md §6 V4).
Z3Sexpr :: enum(Atom(text : String), List(items : ArrayList(Self)));
derive(Z3Sexpr, Clone);
/// Parse ALL top-level S-expressions in `text` (whitespace and `;` line
/// comments tolerated). Unclosed lists are dropped rather than thrown —
/// the caller decides what missing evidence means.
parse_z3_sexprs :: (fn(text : &String) -> ArrayList(Z3Sexpr))({
  out := ArrayList(Z3Sexpr).new();
  stack := ArrayList(ArrayList(Z3Sexpr)).new();
  b := text.clone();
  (i : usize) = usize(0);
  while(i < b.len(), {
    c := match(b.get_byte(i), .Some(x) => x, .None => u8(0));
    cond(
      ((c == u8(0x20)) || (c == u8(0x09)) || (c == u8(0x0A)) || (c == u8(0x0D))) => {
        i = (i + usize(1));
      },
      (c == u8(0x3B)) => {
        // ';' comment — skip to end of line (leave the \n for the next pass).
        (j : usize) = i;
        while(j < b.len(), {
          cc := match(b.get_byte(j), .Some(x) => x, .None => u8(0x0A));
          if(cc == u8(0x0A), {
            break;
          });
          j = (j + usize(1));
        });
        i = j;
      },
      (c == u8(0x28)) => {
        frame := ArrayList(Z3Sexpr).new();
        stack.push(frame);
        i = (i + usize(1));
      },
      (c == u8(0x29)) => {
        frame := match(
          stack.pop(),
          .Some(f) => f,
          .None => ArrayList(Z3Sexpr).new()
        );
        list := Z3Sexpr.List(frame);
        match(
          stack.pop(),
          .Some(found) => {
            parent := found;
            parent.push(list);
            stack.push(parent);
          },
          .None => {
            out.push(list);
          }
        );
        i = (i + usize(1));
      },
      true => {
        // Atom: run of bytes that are not whitespace, parens, or comment.
        start := i;
        while(i < b.len(), {
          cc := match(b.get_byte(i), .Some(x) => x, .None => u8(0));
          if((cc == u8(0x20)) || (cc == u8(0x09)) || (cc == u8(0x0A)) || (cc == u8(0x0D)) || (cc == u8(0x28)) || (cc == u8(0x29)) || (cc == u8(0x3B)), {
            break;
          });
          i = (i + usize(1));
        });
        // substring takes (start, END), not (start, len).
        atom := Z3Sexpr.Atom(text.substring(start, i));
        match(
          stack.pop(),
          .Some(found) => {
            parent := found;
            parent.push(atom);
            stack.push(parent);
          },
          .None => {
            out.push(atom);
          }
        );
      }
    );
  });
  out
});
/// Render one sexpr back to text (counter-example rendering).
z3_sexpr_to_string :: (fn(s : &Z3Sexpr) -> String)(
  match(
    s,
    .Atom(t) => t.clone(),
    .List(items) => {
      sb := StringBuilder.new();
      sb.write_byte(u8(0x28));
      (i : usize) = usize(0);
      while(i < items.len(), {
        match(
          items.get_cloned(i),
          .Some(x) => {
            if(i > usize(0), {
              sb.write_byte(u8(0x20));
            });
            sb.write_string(z3_sexpr_to_string(&x));
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      sb.write_byte(u8(0x29));
      sb.to_string()
    }
  )
);
/// The check-sat verdict of a response stream: the FIRST top-level atom
/// among `unsat` / `sat` / `unknown`. `.None` when the stream has none
/// (solver error — the caller reports the raw output).
z3_check_sat_of :: (fn(forms : &ArrayList(Z3Sexpr)) -> Option(String))({
  (i : usize) = usize(0);
  while(i < forms.len(), {
    match(
      forms.get_cloned(i),
      .Some(form) => {
        // Nested patterns do not parse — match twice.
        match(
          form,
          .Atom(t) => {
            if((t == "unsat") || (t == "sat") || (t == "unknown"), {
              return(Option(String).Some(t.clone()));
            });
          },
          _ => ()
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  Option(String).None
});
/// An `(error "...")` form that z3 printed BEFORE its check-sat verdict:
/// the script itself was rejected (a malformed declaration, an unknown
/// constant), and the verdict that follows judges whatever survived the
/// parse — a `sat` there is not a counter-example. `.None` when every
/// error form comes after the verdict (the tolerated post-check-sat
/// evidence errors) or there is none
/// (issues/fixed/verifier-a-malformed-smt-script-reports-refuted-with-an-empty-model.md).
z3_error_before_verdict :: (fn(forms : &ArrayList(Z3Sexpr)) -> Option(String))({
  (i : usize) = usize(0);
  while(i < forms.len(), {
    match(
      forms.get_cloned(i),
      .Some(form) => match(
        &form,
        .Atom(t) => {
          if((t.* == "unsat") || (t.* == "sat") || (t.* == "unknown"), {
            return(Option(String).None);
          });
        },
        .List(items) => match(
          _head_atom_text(&items.*),
          .Some(h) => if(h == "error", {
            return(Option(String).Some(z3_sexpr_to_string(&form)));
          }),
          .None => ()
        )
      ),
      .None => ()
    );
    i = (i + usize(1));
  });
  Option(String).None
});
/// The text of `items[0]` when it is an atom (`.None` otherwise) — the
/// nested-match helper for keyword-led response forms.
_head_atom_text :: (fn(items : &ArrayList(Z3Sexpr)) -> Option(String))(
  match(
    items.get_cloned(usize(0)),
    .Some(.Atom(t)) => Option(String).Some(t.clone()),
    .Some(_) => Option(String).None,
    .None => Option(String).None
  )
);
/// The value of a top-level `(get-info <keyword>)` response, `(:kw v …)`:
/// the atoms after the keyword joined by spaces (the scanner splits a
/// quoted string at its spaces), with one pair of surrounding quotes
/// removed. `.None` when the stream has no such form (an older z3 that
/// rejects the keyword answers with a tolerated post-verdict error).
_z3_info_of :: (fn(forms : &ArrayList(Z3Sexpr), keyword : &String) -> Option(String))({
  (i : usize) = usize(0);
  while(i < forms.len(), {
    match(
      forms.get_cloned(i),
      .Some(.List(items)) => {
        if(match(_head_atom_text(&items), .Some(h) => (h == keyword.*), .None => false), {
          sb := StringBuilder.new();
          (j : usize) = usize(1);
          while(j < items.len(), {
            if(j > usize(1), {
              sb.write_byte(u8(0x20));
            });
            match(
              items.get_cloned(j),
              .Some(item) => {
                sb.write_string(z3_sexpr_to_string(&item));
              },
              .None => ()
            );
            j = (j + usize(1));
          });
          text := sb.to_string();
          n := text.len();
          if((n >= usize(2)) && (text.byte_at(usize(0)) == u8(0x22)) && (text.byte_at(n - usize(1)) == u8(0x22)), {
            return(Option(String).Some(text.substring(usize(1), n - usize(1))));
          });
          return(Option(String).Some(text));
        });
      },
      _ => ()
    );
    i = (i + usize(1));
  });
  Option(String).None
});
/// Why z3 answered `unknown`: its `(get-info :reason-unknown)` response
/// (`canceled`, `timeout`, `incomplete quantifiers`, …).
z3_reason_unknown_of :: (fn(forms : &ArrayList(Z3Sexpr)) -> Option(String))(
  _z3_info_of(forms, String.from(":reason-unknown"))
);
/// The resource count the query consumed: its `(get-info :rlimit)`
/// response. Comparing it with the `:rlimit` budget tells an exhausted
/// budget (deterministic) from a wall-clock `:timeout` that fired first
/// (load-dependent): z3 5.1.0 can report either as `canceled`, so the
/// reason alone cannot separate them.
z3_rlimit_used_of :: (fn(forms : &ArrayList(Z3Sexpr)) -> Option(usize))(
  match(
    _z3_info_of(forms, String.from(":rlimit")),
    .Some(text) => match(
      text.parse_u64(),
      .Some(n) => Option(usize).Some(usize(n)),
      .None => Option(usize).None
    ),
    .None => Option(usize).None
  )
);
/// The unsat core: the first top-level BARE list of atoms (z3 prints it as
/// `(name1 name2 ...)` right after unsat). Keyword-led forms (`(error …)`,
/// `(model …)`, `(define-fun …)`, the `(:reason-unknown …)` and
/// `(:rlimit …)` get-info answers) and the get-value response shape are
/// skipped.
z3_unsat_core_of :: (fn(forms : &ArrayList(Z3Sexpr)) -> ArrayList(String))({
  out := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < forms.len(), {
    match(
      forms.get_cloned(i),
      .Some(form) => {
        match(
          form,
          .List(items) => {
            head_kw := match(
              _head_atom_text(&items),
              .Some(t) => (
                (t == "error") || (t == "model") || (t == "define-fun") || ((t.len() > usize(0)) && (t.byte_at(usize(0)) == u8(0x3A)))
              ),
              .None => false
            );
            if(!head_kw, {
              all_atoms := true;
              (j : usize) = usize(0);
              while(j < items.len(), {
                match(
                  items.get_cloned(j),
                  .Some(item) => {
                    match(
                      item,
                      .Atom(_) => (),
                      _ => {
                        all_atoms = false;
                      }
                    );
                  },
                  .None => ()
                );
                if(!all_atoms, {
                  break;
                });
                j = (j + usize(1));
              });
              if(all_atoms && (items.len() > usize(0)), {
                (k : usize) = usize(0);
                while(k < items.len(), {
                  match(
                    items.get_cloned(k),
                    .Some(item2) => {
                      match(
                        item2,
                        .Atom(t) => {
                          out.push(t.clone());
                        },
                        _ => ()
                      );
                    },
                    .None => ()
                  );
                  k = (k + usize(1));
                });
                return(out);
              });
            });
          },
          _ => ()
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});
/// The `(get-value ...)` response: a top-level list of `(name value)`
/// pairs, rendered as `name = value` strings in response order.
z3_value_pairs_of :: (fn(forms : &ArrayList(Z3Sexpr)) -> ArrayList(String))({
  out := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < forms.len(), {
    match(
      forms.get_cloned(i),
      .Some(form) => {
        match(
          form,
          .List(pairs) => {
            plausible := (pairs.len() > usize(0));
            (j : usize) = usize(0);
            while(j < pairs.len(), {
              match(
                pairs.get_cloned(j),
                .Some(pair) => {
                  match(
                    pair,
                    .List(kv) => {
                      if(kv.len() != usize(2), {
                        plausible = false;
                      });
                    },
                    _ => {
                      plausible = false;
                    }
                  );
                },
                .None => {
                  plausible = false;
                }
              );
              if(!plausible, {
                break;
              });
              j = (j + usize(1));
            });
            if(plausible, {
              (k : usize) = usize(0);
              while(k < pairs.len(), {
                match(
                  pairs.get_cloned(k),
                  .Some(pair2) => {
                    match(
                      pair2,
                      .List(kv2) => {
                        n := match(
                          kv2.get_cloned(usize(0)),
                          .Some(.Atom(t)) => t.clone(),
                          .Some(_) => String.from("?"),
                          .None => String.from("?")
                        );
                        v := match(
                          kv2.get_cloned(usize(1)),
                          .Some(value_form) => z3_sexpr_to_string(&value_form),
                          .None => String.from("?")
                        );
                        out.push(`${n} = ${v}`);
                      },
                      _ => ()
                    );
                  },
                  .None => ()
                );
                k = (k + usize(1));
              });
              return(out);
            });
          },
          _ => ()
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});
