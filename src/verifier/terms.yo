//! verifier/terms — the in-memory VC term representation (V2).
//!
//! Pure data, no I/O: sorts, terms, quantifiers, and the per-obligation
//! query shape the encoder turns into SMT-LIB 2 and the solver harness
//! discharges. The term vocabulary follows the SMT encoding reference in
//! plans/backlog/FORMAL_VERIFICATION.md (bitvectors first — Yo's integers
//! are the exact-width two's-complement values the C backend emits).
//!
//! Query shape: one obligation is a list of ASSUMED terms plus one GOAL.
//! The runner asserts the assumptions, asserts the negation of the goal,
//! and asks check-sat:
//!   unsat    ⇒ the goal is PROVED under the assumptions
//!   sat      ⇒ REFUTED — the model is the counter-example
//!   unknown  ⇒ Unproven (budget)
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ ToString } :: import("std/fmt/to_string");
// ============================================================================
// Sorts
// ============================================================================
/// A VC sort. The verifiable subset starts at `bool` and exact-width
/// bitvectors (the plan's sorts table); datatypes/arrays/Seq join in V3–V5.
VcSort :: ref(
  enum(
    /// SMT `Bool`.
    BoolS,
    /// SMT `(_ BitVec <width>)` — widths 8/16/32/64 (and the target's usize).
    BvS(width : usize),
    /// A DECLARED DATATYPE sort (V3: value enums). The name is the
    /// sanitized datatype name; the `(declare-datatypes ...)` block rides
    /// `VcQuery.datatypes` (rendered once, before the constants).
    DataS(name : String),
    /// SMT `(Seq <elem>)` — z3's built-in sequences (V5 task 5: the
    /// `std/spec` ghost collections' element carrier; also `str` content
    /// as `Seq (_ BitVec 8)`).
    SeqS(elem : Self),
    /// SMT `(Array <domain> <range>)` — Set(T) is `Array T Bool` (membership),
    /// Multiset(T) is `Array T (_ BitVec 64)` (element → count; 64-bit so
    /// counts never wrap in any realistic spec).
    FunS(domain : Self, range : Self),
    /// SMT `(Array (_ BitVec 64) <elem>)` — a fixed-length `Array(T, N)`
    /// value (V5 task 6). The SMT sort ignores `len` (SMT arrays are
    /// unbounded); `len` is the compile-time element count the WALK uses
    /// for index-bounds obligations and `ms_of` folding.
    ArrS(elem : Self, len : usize),
    /// V6 task 2 (FORMAL_VERIFICATION.md §680): an UNINTERPRETED sort —
    /// the placeholder for a generic type parameter in an abstractly
    /// verified body. Values of the sort support only equality and
    /// pass-through; every other operation is a loud subset failure
    /// (task 2's "type variables used opaquely" scope). The name is the
    /// mangled SomeT identity, declared once per query via
    /// `VcQuery.sorts` (`(declare-sort <name> 0)`).
    Uninterpreted(name : String)
  )
);
derive(VcSort, Eq(VcSort));
// SAFETY: a VcSort has no back edges. Its only children are `Self`
// payloads (`SeqS`, `FunS`, `ArrS`), and it holds no list or cell. The
// language admits a variant-field write (`s.elem = s` would close a cycle),
// but an audit of src/ (2026-10-21) found none on a VcSort, so a node only
// points at nodes older than itself.
// Declaring `Acyclic` keeps VcSort nodes out of the cycle collector
// (plans/VALUES_BY_DEFAULT.md §3.12, decision 21's trees).
impl(VcSort, Acyclic());
impl(
  VcSort,
  ToString(
    to_string : (fn(self : &Self) -> String)(
      match(
        self,
        .BoolS => String.from("bool"),
        .BvS(w) => `bv${w.to_string()}`,
        .DataS(name) => name.clone(),
        .SeqS(_) => String.from("seq"),
        .FunS(_, _) => String.from("array"),
        .ArrS(_, _) => String.from("array"),
        .Uninterpreted(name) => name.clone()
      )
    )
  )
);
// ============================================================================
// Operators
// ============================================================================
/// A VC operator. Variant names follow SMT-LIB where there is one; the
/// encoder maps each to its exact SMT-LIB spelling.
VcOp :: enum(
  // Bitvector arithmetic (exact-width, two's complement — matches the
  // emitted C under -fwrapv).
  BvAdd,
  BvSub,
  BvMul,
  BvSdiv,
  BvUdiv,
  BvSrem,
  BvUrem,
  BvNeg,
  // Bitvector shifts and bitwise.
  BvShl,
  BvLshr,
  BvAshr,
  BvNotOp,
  BvAndOp,
  BvOrOp,
  BvXorOp,
  // Bitvector comparisons (signedness is per the plan's operator table).
  BvUlt,
  BvUle,
  BvUgt,
  BvUge,
  BvSlt,
  BvSle,
  BvSgt,
  BvSge,
  // Equality over any one sort.
  EqOp,
  DistinctOp,
  // Boolean connectives.
  NotOp,
  AndOp,
  OrOp,
  ImpOp,
  /// `ite` — if-then-else (3 args: cond, then, else).
  IteOp,
  // Width-changing casts (payload = bits added / hi..lo extracted).
  /// `(_ sign_extend k)` — k = extra bits.
  SignExtendOp(extra : usize),
  /// `(_ zero_extend k)` — k = extra bits.
  ZeroExtendOp(extra : usize),
  /// `(_ extract hi lo)` — hi..lo inclusive, hi >= lo.
  ExtractOp(hi : usize, lo : usize),
  /// `(concat a b)`: `a`'s bits above `b`'s (a lexicographic measure).
  ConcatOp,
  // V5 task 5 — sequences and arrays (the std/spec ghost collections).
  /// `(seq.unit x)` — the one-element sequence.
  SeqUnit,
  /// `(seq.++ a b)` — concatenation.
  SeqConcat,
  /// `(seq.len a)` — length (SMT Int; the walk compares it as an integer
  /// expression — casts to/from bitvectors at the walk's edges).
  SeqLen,
  /// `(seq.nth a i)` — indexed element (0-based).
  SeqNth,
  /// `(store a k v)` — array update.
  StoreOp,
  /// `(select a k)` — array read.
  SelectOp,
  /// `((_ int2bv w) x)` — integer to bitvector (seq_len's Int result back
  /// into the subset's bitvector world).
  IntToBvOp(width : usize),
  /// `(bv2nat x)` — bitvector to unsigned integer (seq_nth's index into
  /// the Int the SMT sequences expect).
  Bv2NatOp
);
derive(VcOp, Copy, Clone);
derive(VcOp, Eq(VcOp));
// ============================================================================
// Terms
// ============================================================================
/// Quantifier kind (V5 surface; the term IR carries them from V2 so the
/// encoder and goldens are stable across phases).
VcQuantKind :: enum(Forall, Exists);
derive(VcQuantKind, Copy, Clone);
/// One node of a VC term: the payload behind a `VcTerm` handle. Variables
/// reference DECLARED constants (SSA-style: every Yo binding/renaming
/// introduces a fresh declared name — no let binders).
///
/// `VcTerm` is `Rc(VcTermNode)` (plans/VALUES_BY_DEFAULT.md decision 21, as
/// amended 2026-10-18): the symbolic walk snapshots its environment at every
/// branch and merges the snapshots with `ite` terms, so subterms are shared,
/// and every child is an `Rc(Self)` handle. A node is never copied and a
/// copy of a term is one count bump. Build a term with
/// `rc(VcTermNode.X(...))`; a `match` on a `VcTerm` spells the handle,
/// `Rc(.X(...))`.
VcTermNode :: enum(
  /// Reference to a declared constant.
  Var(name : String, sort : VcSort),
  /// Bitvector literal as its unsigned two's-complement bit pattern
  /// (covers every value of widths <= 64).
  BvLit(value : u64, width : usize),
  /// Boolean literal.
  BoolLit(value : bool),
  /// Operator application. Arity/widths are the BUILDER's responsibility
  /// (checked at VC-construction time in V3, not re-checked here).
  App(op : VcOp, args : ArrayList(Rc(Self))),
  /// Datatype constructor application (`.Variant(args...)`).
  Ctor(name : String, args : ArrayList(Rc(Self))),
  /// Datatype tester `(is-<Ctor> t)` — a match arm's discriminator.
  Test(ctor : String, t : Rc(Self)),
  /// Datatype field projection `(<Ctor>-<idx> t)` — a match arm's
  /// pattern binding.
  Proj(ctor : String, idx : usize, t : Rc(Self)),
  /// Quantifier with explicitly-typed bound variables. `triggers`
  /// carries E-matching patterns (each rendered as its own `:pattern`
  /// attribute — an OR of independently sufficient patterns); empty =
  /// solver-default instantiation (MBQI).
  Quant(
    kind : VcQuantKind,
    names : ArrayList(String),
    sorts : ArrayList(VcSort),
    body : Rc(Self),
    triggers : ArrayList(Rc(Self))
  ),
  /// `(const <sort> <lit>)` — the everywhere-constant array (an empty
  /// Set / Multiset). `lit` is a BoolLit or a BvLit.
  ArrConst(sort : VcSort, lit : Rc(Self))
);
/// A VC term: a shared, immutable handle to a `VcTermNode`.
VcTerm :: Rc(VcTermNode);
// SAFETY: a VcTerm has no back edges. No code in src/ writes a `Self`
// payload of a built term (the language admits a variant-field write; an
// audit of src/ (2026-10-21) found none), and each `args`/`triggers` list
// is filled before its node is built (`_app1`..`_app3`, `vc_eq` and the
// rest build a fresh list per node): an audit of src/ (2026-10-20) found no push, insert or set into the
// list of a term that already exists. Substitution shares subterms, which is
// why the children are `Rc` (decision 21's 2026-10-18 amendment); sharing a
// subterm adds no back edge. So no term reaches itself. Declaring `Acyclic`
// keeps terms, `ArrayList(VcTerm)` and `VcQuery` out of the cycle collector
// (plans/VALUES_BY_DEFAULT.md §3.12;
// issues/fixed/2026-10-18-a-linkedlist-of-managed-elements-forms-uncollected-cycles.md).
impl(VcTerm, Acyclic());
/// One declared constant of a query.
VcDecl :: struct(name : String, sort : VcSort);
/// One uninterpreted function symbol (R2: a recursive `ghost_fn`), rendered
/// as `(declare-fun <name> (<args>) <result>)` before the axioms that
/// define it.
VcFunDecl :: struct(name : String, args : ArrayList(VcSort), result : VcSort);
/// One assumed term of a query. The optional name participates in unsat
/// cores (`(! term :named <name>)`) so a proof failure can name the
/// smallest violated clause.
VcAssumption :: struct(name : Option(String), term : VcTerm);
/// One verification obligation: assumptions Φ and a goal P. Discharging
/// means proving Φ ⇒ P (the runner checks Φ ∧ ¬P for unsat).
VcQuery :: ref(
  struct(
    /// Obligation group name (function name + site) for diagnostics.
    name : String,
    /// Declared constants (variables of Φ and P).
    declarations : ArrayList(VcDecl),
    /// Assumed terms, conjoined.
    assumptions : ArrayList(VcAssumption),
    /// The obligation proper.
    goal : VcTerm,
    /// Function declarations — the elem SORT of each distinct
    /// `__yo_msof_<elem>` multiset function used by the terms (V5 task 6).
    /// Rendered as one `declare-fun` per entry before the constants.
    fundecls : ArrayList(VcSort),
    /// Axioms assumed by EVERY obligation (V5 task 6): closed quantified
    /// terms (the per-array `ms_of` definitions, with `:pattern` triggers)
    /// asserted ahead of the path assumptions.
    axioms : ArrayList(VcTerm),
    /// Uninterpreted function symbols the axioms and terms apply (R2).
    fun_decls : ArrayList(VcFunDecl),
    /// Declared UNINTERPRETED sorts (V6 task 2) — one mangled name per
    /// abstractly verified generic parameter. Rendered as
    /// `(declare-sort <name> 0)` lines before the datatypes.
    sorts : ArrayList(String),
    /// Datatype declaration BLOCK CONTENT — one entry per datatype, the
    /// `(name 0)` arity pair plus its constructors. Rendered as ONE
    /// combined `declare-datatypes` before the constants so mutually
    /// recursive datatypes need no ordering.
    datatypes : ArrayList(String)
  )
);
impl(
  VcQuery,
  /// Builder: push a declaration.
  declare : (fn(self : &Self, name : &String, sort : &VcSort) -> Self)({
    self.declarations.push(VcDecl(name : name.clone(), sort : sort));
    self
  }),
  /// Builder: push an unnamed assumption.
  assume : (fn(self : &Self, term : &VcTerm) -> Self)({
    self.assumptions.push(VcAssumption(name : Option(String).None, term : term));
    self
  }),
  /// Builder: push a named assumption (unsat-core attribution).
  assume_named : (fn(self : &Self, name : &String, term : &VcTerm) -> Self)({
    self.assumptions.push(VcAssumption(name : Option(String).Some(name.clone()), term : term));
    self
  })
);
/// Construct an empty query with a diagnostic name.
new_vc_query :: (fn(name : &String) -> VcQuery)(
  VcQuery(
    name : name,
    declarations : ArrayList(VcDecl).new(),
    assumptions : ArrayList(VcAssumption).new(),
    goal : rc(VcTermNode.BoolLit(true)),
    fundecls : ArrayList(VcSort).new(),
    axioms : ArrayList(VcTerm).new(),
    fun_decls : ArrayList(VcFunDecl).new(),
    sorts : ArrayList(String).new(),
    datatypes : ArrayList(String).new()
  )
);
// ============================================================================
// Convenience constructors (keep VC construction sites terse and uniform)
// ============================================================================
/// Boolean negation.
vc_not :: (fn(t : &VcTerm) -> VcTerm)({
  args := ArrayList(VcTerm).new();
  args.push(t);
  rc(VcTermNode.App(VcOp.NotOp, args))
});
/// N-ary conjunction.
vc_and :: (fn(ts : &ArrayList(VcTerm)) -> VcTerm)({
  if(ts.len() == usize(0), {
    return(rc(VcTermNode.BoolLit(true)));
  });
  if(ts.len() == usize(1), {
    return(match(ts.get(usize(0)), .Some(t) => t, .None => rc(VcTermNode.BoolLit(true))));
  });
  rc(VcTermNode.App(VcOp.AndOp, ts))
});
/// N-ary disjunction.
vc_or :: (fn(ts : &ArrayList(VcTerm)) -> VcTerm)({
  if(ts.len() == usize(0), {
    return(rc(VcTermNode.BoolLit(false)));
  });
  if(ts.len() == usize(1), {
    return(match(ts.get(usize(0)), .Some(t) => t, .None => rc(VcTermNode.BoolLit(false))));
  });
  rc(VcTermNode.App(VcOp.OrOp, ts))
});
/// Implication `a => b` (right-associative chain when built pairwise).
vc_imp :: (fn(a : &VcTerm, b : &VcTerm) -> VcTerm)({
  args := ArrayList(VcTerm).new();
  args.push(a);
  args.push(b);
  rc(VcTermNode.App(VcOp.ImpOp, args))
});
/// Equality `a = b`.
vc_eq :: (fn(a : &VcTerm, b : &VcTerm) -> VcTerm)({
  args := ArrayList(VcTerm).new();
  args.push(a);
  args.push(b);
  rc(VcTermNode.App(VcOp.EqOp, args))
});
/// Distinctness `a != b`.
vc_distinct :: (fn(a : &VcTerm, b : &VcTerm) -> VcTerm)({
  args := ArrayList(VcTerm).new();
  args.push(a);
  args.push(b);
  rc(VcTermNode.App(VcOp.DistinctOp, args))
});
export(
  VcSort,
  VcOp,
  VcTerm,
  VcTermNode,
  VcQuantKind,
  VcDecl,
  VcFunDecl,
  VcAssumption,
  VcQuery,
  new_vc_query,
  vc_not,
  vc_and,
  vc_or,
  vc_imp,
  vc_eq,
  vc_distinct
);
