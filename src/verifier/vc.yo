//! verifier/vc — symbolic execution of a function body into verification
//! conditions (V3: the straight-line Dafny core).
//!
//! Input is the DEFINITION-SITE view: the body AST, the param labels/types
//! and result type, the contract predicates from the Phase-0 side tables,
//! and the shared ExprInfoTable (types, comptime-folded values, callee
//! FuncVals). Output: a list of obligations for the driver —
//!
//!   callee-side  — assume requires ⊢ prove ensures (label bound)
//!   caller-side  — at each call to a contracted callee: prove requires,
//!                  then assume ensures with the result bound
//!   assert sites — prove Φ ⇒ P
//!   AoRTE        — `/`/`%` divisor non-zero, shift amount < width
//!
//! V3 subset (violations are precise errors, never silent gaps): integer
//! and bool arithmetic, comparisons, logical ops, `cond` (as ite VALUES),
//! begin blocks with `:=` bindings, calls to contracted or comptime-
//! foldable callees, `panic` (diverging). Loops, match, recursion, slices,
//! effects, unsafe → V4+ or out of subset.
pragma(Pragma.AllowUnsafe);
{ String, StringBuilder } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{
  AstExpr,
  ExprId,
  BK_TUPLE,
  ast_expr_id,
  ast_expr_token,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  ast_expr_is_atom,
  ast_expr_to_string,
  make_err_expr
} :: import("../expr.yo");
{ ExprInfo, ExprInfoTable, expr_info_table_get } :: import("../expr_info.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ EvalValue, is_func_val } :: import("../value.yo");
{ VcSort, VcOp, VcTerm, VcQuery, VcQuantKind, new_vc_query, vc_eq, vc_and, vc_or, vc_not, vc_distinct } :: import("./terms.yo");
{ mangle_vc_name, encode_sort } :: import("./encode.yo");
{
  get_func_requires_exprs,
  get_func_ensures_exprs,
  get_func_return_label
} :: import("../evaluator/types/function.yo");
// ============================================================================
// Small type probes (local, to keep this module's import fan-in minimal)
// ============================================================================
_is_bool_type :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .BoolT => true,
    _ => false
  )
);
/// Width in bits of an integer-ish type; `.None` for non-integers.
_int_width :: (fn(t : TypeValue) -> Option(usize))(
  match(
    t,
    .Int({ bits : b }) => Option(usize).Some(usize(b)),
    .Usize => Option(usize).Some(usize(64)),
    .Isize => Option(usize).Some(usize(64)),
    _ => Option(usize).None
  )
);
_int_is_signed :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .Int({ signed : s }) => s,
    .Isize => true,
    _ => false
  )
);
_type_sort :: (fn(t : TypeValue) -> Option(VcSort))(
  match(
    _int_width(t),
    .Some(w) => Option(VcSort).Some(VcSort.BvS(width : w)),
    .None => cond(
      _is_bool_type(t) => Option(VcSort).Some(VcSort.BoolS),
      // Value enums: a declared datatype (V3). ref enums are heap handles —
      // outside the verifiable subset's integer/bool/enum core.
      true => _enum_sort_or_none(t)
    )
  )
);
_enum_sort_or_none :: (fn(t : TypeValue) -> Option(VcSort))(
  match(
    t,
    .EnumT({ id : e_id, is_reference_semantics : e_ref }) => cond(
      (e_ref || (e_id.len() == usize(0))) => Option(VcSort).None,
      true => Option(VcSort).Some(VcSort.DataS(name : _enum_dt_name(e_id.clone())))
    ),
    _ => Option(VcSort).None
  )
);
/// The datatype name for an enum id (`enum_decl_<astid>_<module>`): a
/// sanitized SMT identifier unique per declaration.
_enum_dt_name :: (fn(enum_id : String) -> String)(
  `__yo_d${_smt_sanitize(enum_id.clone())}`
);
/// Map every non-[A-Za-z0-9_] rune of `s` to `_` (SMT identifier rules).
_smt_sanitize :: (fn(s : String) -> String)({
  sb := StringBuilder.new();
  {
    it := s.chars();
    while(true, {
      r := match(it.next(), .Some(x) => x, .None => break);
      c := r.char;
      if(((c >= u32(0x41)) && (c <= u32(0x5A))) ||
        ((c >= u32(0x61)) && (c <= u32(0x7A))) ||
          ((c >= u32(0x30)) && (c <= u32(0x39))) || (c == u32(0x5F)), {
        sb.write_rune(r);
      }, {
        sb.write_byte(u8(0x5F));
      });
    });
  };
  sb.to_string()
});
/// The constructor name for one variant: `<dt>_<variant>`.
_enum_ctor_name :: (fn(enum_id : String, variant : String) -> String)(
  `${_enum_dt_name(enum_id.clone())}_${variant}`
);
// ============================================================================
// Results
// ============================================================================
/// One obligation discovered in a body.
VcObligation :: ref(
  struct(
    name : String,
    query : VcQuery
  )
);
/// Why a function could not be verified (subset gate).
VcSubsetError :: ref(
  struct(
    construct : String,
    source : String
  )
);
/// Symbolic execution result for one function.
VcBodyResult :: ref(
  struct(
    obligations : ArrayList(VcObligation),
    /// The body's value as a term (for ensures binding); `.None` when a
    /// subset error aborted the walk.
    value : Option(VcTerm),
    error : Option(VcSubsetError)
  )
);
// ============================================================================
// The executor context
// ============================================================================
VcCtx :: ref(
  struct(
    table : ExprInfoTable,
    fn_name : String,
    /// The FuncVal's `func_id` — self-recursion detection at call sites.
    func_id : String,
    /// Source-name → current term (SSA by rebinding).
    vars : HashMap(String, VcTerm),
    /// Path assumptions (requires, branch conditions), conjoined.
    path : ArrayList(VcTerm),
    obligations : ArrayList(VcObligation),
    subset_error : Option(VcSubsetError),
    /// Counter for query names and synthetic vars.
    fresh : usize,
    /// Havoc-version counter for loop encodings (V4): each `while` gets a
    /// distinct post-havoc generation so nested/back-to-back loops never
    /// share a synthetic constant.
    havoc : usize,
    /// This function's `decreases(M)` measure (V4 recursion), if any.
    decreases : Option(AstExpr),
    /// Break sites of the loop body being walked (V4.2): each `break`
    /// snapshots the path condition and every binding — the loop's exit
    /// state is the disjunction of these with the fresh-havoc cond-exit.
    break_sites : ArrayList(BreakSite),
    /// The invariant predicates of the loop being walked (V4.2): a
    /// `continue` site proves them over the state at the statement.
    loop_invariants : ArrayList(AstExpr),
    /// The loop being walked's `decreases(M)` AST, if any (V4.2 continue).
    loop_measure : Option(AstExpr),
    /// The head (havoced) measure TERM of the loop being walked, if any —
    /// a `continue` site proves its own `M(now) < M(head)` step against it.
    head_measure : Option(VcTerm),
    /// The current straight-line path has exited the loop (break or
    /// continue): statements after the exit statement are dead, not walked.
    path_dead : bool,
    /// Loop nesting depth during a body walk (0 outside any loop body).
    loop_depth : usize,
    /// The FUNCTION-ENTRY binding snapshot (params + module bindings at
    /// body start, taken before the walk): `old(e)` walks e against it
    /// (V5 two-state). Body-locals have no entry binding.
    entry_vars : HashMap(String, VcTerm),
    /// Datatype declaration entries (`<dt-name>|<ctor0> <ctor1> (f0 sort) ...`)
    /// for every enum sort used so far — merged into each obligation's
    /// VcQuery.datatypes at `_emit` time so the emitted script declares
    /// everything the terms mention.
    datatypes : ArrayList(String)
  )
);
_new_vc_ctx :: (fn(table : ExprInfoTable, fn_name : String, func_id : String) -> VcCtx)(
  VcCtx(
    table : table,
    fn_name : fn_name,
    func_id : func_id,
    vars : HashMap(String, VcTerm).new(),
    path : ArrayList(VcTerm).new(),
    obligations : ArrayList(VcObligation).new(),
    subset_error : Option(VcSubsetError).None,
    fresh : usize(0),
    havoc : usize(0),
    decreases : Option(AstExpr).None,
    break_sites : ArrayList(BreakSite).new(),
    loop_invariants : ArrayList(AstExpr).new(),
    loop_measure : Option(AstExpr).None,
    head_measure : Option(VcTerm).None,
    path_dead : false,
    loop_depth : usize(0),
    entry_vars : HashMap(String, VcTerm).new(),
    datatypes : ArrayList(String).new()
  )
);
_next_fresh :: (fn(inout(ctx) : VcCtx) -> usize)({
  n := ctx.fresh;
  ctx.fresh = (ctx.fresh + usize(1));
  n
});
_fail_subset :: (fn(inout(ctx) : VcCtx, construct : String, at : AstExpr) -> unit)({
  match(
    ctx.subset_error,
    .Some(_) => (),
    .None => {
      ctx.subset_error = Option(VcSubsetError).Some(
        VcSubsetError(
          construct : construct,
          source : ast_expr_to_string(at)
        )
      );
    }
  );
  ()
});
/// Emit one obligation: prove `Φ ∧ assumptions ⇒ goal`.
_emit :: (
  fn(
    inout(ctx) : VcCtx,
    label : String,
    extra_assumptions : ArrayList(VcTerm),
    goal : VcTerm
  ) -> unit
)({
  q := new_vc_query(`${ctx.fn_name}/${label}`);
  // Declarations: every source variable the obligations may mention — in
  // the goal, the extra assumptions, AND the path condition (a `requires`
  // param that never appears in the goal is still ASSUMED, and an
  // undeclared name in an assumption is an SMT error).
  declared := HashMap(String, VcSort).new();
  _collect_declared(goal, declared);
  (ei : usize) = usize(0);
  extra := extra_assumptions;
  while(ei < extra.len(), {
    match(
      extra.get(ei),
      .Some(t) => {
        _collect_declared(t, declared);
      },
      .None => ()
    );
    ei = (ei + usize(1));
  });
  (pi0 : usize) = usize(0);
  while(pi0 < ctx.path.len(), {
    match(
      ctx.path.get(pi0),
      .Some(t) => {
        _collect_declared(t, declared);
      },
      .None => ()
    );
    pi0 = (pi0 + usize(1));
  });
  keys := ArrayList(String).new();
  {
    it := declared.keys();
    (go : bool) = true;
    while(go, {
      match(
        it.next(),
        .Some(k) => {
          keys.push(k.clone());
        },
        .None => {
          go = false;
        }
      );
    });
  };
  sorted_keys := _sorted_strings(keys);
  (ki : usize) = usize(0);
  while(ki < sorted_keys.len(), {
    match(
      sorted_keys.get(ki),
      .Some(k) => {
        match(
          declared.get(k.clone()),
          .Some(srt) => {
            _ := q.declare(mangle_vc_name(ctx.fn_name.clone(), k.clone()), srt);
            ();
          },
          .None => ()
        );
      },
      .None => ()
    );
    ki = (ki + usize(1));
  });
  // Rename every Var into the mangled form via a term rewrite.
  rename_map := HashMap(String, String).new();
  (ri : usize) = usize(0);
  while(ri < sorted_keys.len(), {
    match(
      sorted_keys.get(ri),
      .Some(k) => {
        rename_map.insert(k.clone(), mangle_vc_name(ctx.fn_name.clone(), k.clone()));
      },
      .None => ()
    );
    ri = (ri + usize(1));
  });
  all := ArrayList(VcTerm).new();
  (pi : usize) = usize(0);
  while(pi < ctx.path.len(), {
    match(
      ctx.path.get(pi),
      .Some(t) => {
        all.push(_rename_vars(t, rename_map));
      },
      .None => ()
    );
    pi = (pi + usize(1));
  });
  (xi : usize) = usize(0);
  while(xi < extra.len(), {
    match(
      extra.get(xi),
      .Some(t) => {
        all.push(_rename_vars(t, rename_map));
      },
      .None => ()
    );
    xi = (xi + usize(1));
  });
  (ai : usize) = usize(0);
  while(ai < all.len(), {
    _ := q.assume(all.get(ai).unwrap());
    ai = (ai + usize(1));
  });
  q.goal = _rename_vars(goal, rename_map);
  (dti : usize) = usize(0);
  while(dti < ctx.datatypes.len(), {
    match(
      ctx.datatypes.get(dti),
      .Some(entry) => {
        q.datatypes.push(entry.clone());
      },
      .None => ()
    );
    dti = (dti + usize(1));
  });
  ctx.obligations.push(VcObligation(name : `${ctx.fn_name}/${label}`, query : q));
  ()
});
/// Sort a small string list into a FRESH list (deterministic declaration
/// order; the std sort API is a comptime trait dance not worth it here).
_sorted_strings :: (fn(xs : ArrayList(String)) -> ArrayList(String))({
  out := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < xs.len(), {
    match(
      xs.get(i),
      .Some(x) => {
        out.push(x.clone());
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  // Insertion sort over the COPY via ptr writes (ArrayList has no set()).
  buf := out.ptr().unwrap();
  (j : usize) = usize(1);
  while(j < out.len(), {
    key := unsafe((buf.add(j)).*).clone();
    (k : usize) = j;
    while(k > usize(0), {
      prev := unsafe((buf.add(k - usize(1))).*);
      if(prev <= key, {
        break;
      });
      unsafe((buf.add(k)).* = prev);
      k = (k - usize(1));
    });
    unsafe((buf.add(k)).* = key);
    j = (j + usize(1));
  });
  out
});
/// A term-level variable declaration collector: every `Var` in `t` needs a
/// matching `declare-fun` in the query.
_collect_declared :: (fn(t : VcTerm, out : HashMap(String, VcSort)) -> unit)(
  match(
    t,
    .Var(name, sort) => {
      if(!out.contains_key(name.clone()), {
        out.insert(name.clone(), sort);
      });
    },
    .BvLit(_, _) => (),
    .BoolLit(_) => (),
    .App(_, args) => {
      (i : usize) = usize(0);
      while(i < args.len(), {
        match(
          args.get(i),
          .Some(a) => {
            _collect_declared(a, out);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .Ctor(_, cargs) => {
      (ci : usize) = usize(0);
      while(ci < cargs.len(), {
        match(
          cargs.get(ci),
          .Some(a) => {
            _collect_declared(a, out);
          },
          .None => ()
        );
        ci = (ci + usize(1));
      });
    },
    // Child bindings NOT named `t`: shadowing the scrutinee hit the
    // self-referential-initializer codegen UB (C11 6.2.1p4), which the
    // v0.2.29 seed still miscompiles.
    .Test(_, child) => _collect_declared(child, out),
    .Proj(_, _, child) => _collect_declared(child, out),
    // A quantifier's BINDERS are not top-level declarations: collect the
    // body's free vars into a fresh map, drop the bound names, then merge
    // (an outer occurrence of the same name elsewhere in the goal still
    // declares it — the merge is insert-if-absent).
    .Quant(_, names, _, body) => {
      inner := HashMap(String, VcSort).new();
      _collect_declared(body, inner);
      (qi : usize) = usize(0);
      while(qi < names.len(), {
        match(
          names.get(qi),
          .Some(bn) => {
            _ := inner.remove(bn.clone());
          },
          .None => ()
        );
        qi = (qi + usize(1));
      });
      kit := inner.keys();
      (kgo : bool) = true;
      while(kgo, {
        match(
          kit.next(),
          .Some(kn) => {
            match(
              inner.get(kn.clone()),
              .Some(ks) => {
                if(!out.contains_key(kn.clone()), {
                  out.insert(kn.clone(), ks);
                });
              },
              .None => ()
            );
          },
          .None => {
            kgo = false;
          }
        );
      });
    }
  )
);
/// Rewrite Var names per `map` (leaves unmapped names alone).
_rename_vars :: (fn(t : VcTerm, map : HashMap(String, String)) -> VcTerm)(
  match(
    t,
    .Var(name, sort) => match(
      map.get(name.clone()),
      .Some(m) => VcTerm.Var(name : m.clone(), sort : sort),
      .None => t
    ),
    .BvLit(_, _) => t,
    .BoolLit(_) => t,
    .App(op, args) => {
      out := ArrayList(VcTerm).new();
      (i : usize) = usize(0);
      while(i < args.len(), {
        match(
          args.get(i),
          .Some(a) => {
            out.push(_rename_vars(a, map));
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      VcTerm.App(op, out)
    },
    .Ctor(name, cargs) => {
      out := ArrayList(VcTerm).new();
      (ci : usize) = usize(0);
      while(ci < cargs.len(), {
        match(
          cargs.get(ci),
          .Some(a) => {
            out.push(_rename_vars(a, map));
          },
          .None => ()
        );
        ci = (ci + usize(1));
      });
      VcTerm.Ctor(name : name.clone(), args : out)
    },
    .Test(ctor, child) => VcTerm.Test(ctor : ctor.clone(), t : _rename_vars(child, map)),
    .Proj(ctor, idx, child) => VcTerm.Proj(ctor : ctor.clone(), idx : idx, t : _rename_vars(child, map)),
    // Bound names are NOT renamed (the binder keeps its raw spelling; a
    // coinciding outer name stays outer everywhere else).
    .Quant(kind, names, sorts, body) => {
      inner_map := HashMap(String, String).new();
      mit := map.keys();
      (mgo : bool) = true;
      while(mgo, {
        match(
          mit.next(),
          .Some(mk) => {
            is_bound := false;
            (qi2 : usize) = usize(0);
            while(qi2 < names.len(), {
              match(
                names.get(qi2),
                .Some(bn2) => {
                  if(mk == bn2, {
                    is_bound = true;
                  });
                },
                .None => ()
              );
              qi2 = (qi2 + usize(1));
            });
            if(!is_bound, {
              match(
                map.get(mk.clone()),
                .Some(mv) => {
                  inner_map.insert(mk.clone(), mv);
                },
                .None => ()
              );
            });
          },
          .None => {
            mgo = false;
          }
        );
      });
      VcTerm.Quant(kind, names, sorts, _rename_vars(body, inner_map))
    }
  )
);
// ============================================================================
// Literal folding
// ============================================================================
/// IntLit raw text ("-5", "42", "0xFF") → two's-complement bit pattern.
_int_lit_bits :: (fn(raw : String) -> Option(u64))(
  match(
    raw.parse_i64_radix(u32(10)),
    .Some(n) => Option(u64).Some(u64(n)),
    .None => Option(u64).None
  )
);
/// A comptime-known EvalValue as a literal term of sort `sort`.
_lit_term :: (fn(v : EvalValue, sort : VcSort) -> Option(VcTerm))(
  match(
    v,
    .BoolVal(b) => Option(VcTerm).Some(VcTerm.BoolLit(b)),
    .IntLit(raw) => match(
      sort,
      .BvS(w) => match(
        _int_lit_bits(raw.clone()),
        .Some(bits) => Option(VcTerm).Some(VcTerm.BvLit(value : bits, width : w)),
        .None => Option(VcTerm).None
      ),
      _ => Option(VcTerm).None
    ),
    _ => Option(VcTerm).None
  )
);
// ============================================================================
// The term builder
// ============================================================================
_app1 :: (fn(op : VcOp, a : VcTerm) -> VcTerm)({
  args := ArrayList(VcTerm).new();
  args.push(a);
  VcTerm.App(op, args)
});
_app2 :: (fn(op : VcOp, a : VcTerm, b : VcTerm) -> VcTerm)({
  args := ArrayList(VcTerm).new();
  args.push(a);
  args.push(b);
  VcTerm.App(op, args)
});
_zero_of :: (fn(w : usize) -> VcTerm)(VcTerm.BvLit(value : u64(0), width : w));
/// Build the term for `e`. `.None` = outside the subset (already recorded).
_expr_term :: (fn(inout(ctx) : VcCtx, e : AstExpr) -> Option(VcTerm))({
  info := match(
    expr_info_table_get(ctx.table, ast_expr_id(e)),
    .Some(i) => i,
    .None => {
      _fail_subset(ctx, String.from("untyped expression"), e);
      return(Option(VcTerm).None);
    }
  );
  // Comptime-folded value ⇒ literal of the expression's own type.
  match(
    info.value,
    .Some(v) => {
      match(
        _type_sort(info.ty),
        .Some(sort) => {
          match(
            _lit_term(v, sort),
            .Some(t) => {
              return(Option(VcTerm).Some(t));
            },
            .None => ()
          );
        },
        .None => ()
      );
    },
    .None => ()
  );
  // Runtime paths — statement-form ifs with early returns (arm-value
  // unification between a match-tail and a return-tail block is a unit
  // trap; see the V2 notes in issues/async-closure-*).
  if(ast_expr_is_atom(e), {
    name := ast_expr_token(e).value;
    return(
      match(
        ctx.vars.get(name.clone()),
        .Some(t) => Option(VcTerm).Some(t),
        .None => {
          _fail_subset(ctx, `unbound runtime name '${name}'`, e);
          Option(VcTerm).None
        }
      )
    );
  });
  if(ast_expr_is_fn_call(e), {
    args := match(
      e,
      .FnCall(_, _, a, _, _) => a,
      .Atom(_, _) => ArrayList(AstExpr).new()
    );
    head := match(
      e,
      .FnCall(_, f, _, _, _) => ast_expr_token(f).value,
      .Atom(_, _) => String.new()
    );
    return(_call_term(ctx, e, head, args, info));
  });
  _fail_subset(ctx, String.from("non-call expression"), e);
  Option(VcTerm).None
});
/// Register the datatype declaration entry for a VALUE enum type once per
/// context (idempotent by dt name). The entry format is
/// `<dt-name>|<ctor0> <ctor1> (f0 <sort>) ...` — encode_content splits at
/// the `|` and renders the combined declare-datatypes block.
_note_enum_datatype :: (fn(inout(ctx) : VcCtx, t : TypeValue) -> unit)(
  match(
    t,
    .EnumT({
      id : e_id,
      variant_names : e_names,
      variant_fields : e_fields,
      variant_field_labels : e_labels,
      is_reference_semantics : e_ref
    }) => {
      if(!e_ref && (e_id.len() > usize(0)), {
        dt := _enum_dt_name(e_id.clone());
        already := _dt_registered(ctx.datatypes, dt.clone());
        if(!already, {
          sb := StringBuilder.new();
          sb.write_string(dt.clone());
          sb.write_byte(u8(0x7C));
          (vi : usize) = usize(0);
          while(vi < e_names.len(), {
            vname := match(e_names.get(vi), .Some(n) => n, .None => String.new());
            if(vi > usize(0), {
              sb.write_byte(u8(0x20));
            });
            sb.write_string(_enum_ctor_name(e_id.clone(), vname.clone()));
            vfs := match(e_fields.get(vi), .Some(l) => l, .None => ArrayList(TypeValue).new());
            vls := match(e_labels.get(vi), .Some(l) => l, .None => ArrayList(String).new());
            if(vfs.len() > usize(0), {
              // A SPACE separates the ctor name from its field group —
              // the encoder's segment scanner keys on it.
              sb.write_byte(u8(0x20));
              sb.write_byte(u8(0x28));
              (fi : usize) = usize(0);
              while(fi < vfs.len(), {
                fty := match(vfs.get(fi), .Some(x) => x, .None => TypeValue.Unit);
                flabel := match(
                  vls.get(fi),
                  .Some(fl) => fl.clone(),
                  .None => {
                    l := String.from("_");
                    l.push_string(fi.to_string());
                    l
                  }
                );
                if(fi > usize(0), {
                  sb.write_byte(u8(0x20));
                });
                // `(accessor sort)` — z3 rejects a bare sort in a
                // constructor field list, and accessors share the whole
                // datatype's namespace, so mangle `<ctor>_<label>` (same
                // spelling the walk's Proj terms carry).
                sb.write_byte(u8(0x28));
                sb.write_string(_enum_ctor_name(e_id.clone(), vname.clone()));
                sb.write_byte(u8(0x5F));
                sb.write_string(flabel);
                sb.write_byte(u8(0x20));
                sb.write_string(
                  match(
                    _type_sort(fty),
                    .Some(fs) => encode_sort(fs),
                    .None => String.from("Int")
                  )
                );
                sb.write_byte(u8(0x29));
                fi = (fi + usize(1));
              });
              sb.write_byte(u8(0x29));
            });
            vi = (vi + usize(1));
          });
          ctx.datatypes.push(sb.to_string());
        });
      });
    },
    _ => ()
  )
);
_dt_registered :: (fn(entries : ArrayList(String), dt : String) -> bool)({
  (found : bool) = false;
  (i : usize) = usize(0);
  while((i < entries.len()) && !found, {
    match(
      entries.get(i),
      .Some(entry) => {
        bar := entry.index_of(String.from("|"));
        nm := match(
          bar,
          .Some(b) => entry.substring(usize(0), b),
          .None => entry.clone()
        );
        if(nm == dt, {
          found = true;
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// Whether `t` is a non-ref, non-anonymous enum type.
_is_value_enum_type :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .EnumT({ id : e_id, is_reference_semantics : e_ref }) => (!e_ref && (e_id.len() > usize(0))),
    _ => false
  )
);
/// `.(Variant, args...)` construction as a datatype Ctor term.
_enum_ctor_term :: (
  fn(inout(ctx) : VcCtx, e : AstExpr, dot_args : ArrayList(AstExpr), info : ExprInfo) -> Option(VcTerm)
)(
  match(
    dot_args.get(usize(0)),
    .Some(v_atom) => _enum_ctor_first(ctx, e, info, v_atom, dot_args),
    .None => {
      _fail_subset(ctx, String.from("malformed enum construction"), e);
      Option(VcTerm).None
    }
  )
);
_enum_ctor_first :: (
  fn(inout(ctx) : VcCtx, e : AstExpr, info : ExprInfo, v_atom : AstExpr, dot_args : ArrayList(AstExpr)) -> Option(VcTerm)
)(
  cond(
    ast_expr_is_atom(v_atom) => _enum_ctor_named(ctx, e, info, ast_expr_token(v_atom).value, dot_args),
    true => {
      _fail_subset(ctx, String.from("non-atom enum variant in construction"), e);
      Option(VcTerm).None
    }
  )
);
_enum_ctor_named :: (
  fn(inout(ctx) : VcCtx, e : AstExpr, info : ExprInfo, variant : String, dot_args : ArrayList(AstExpr)) -> Option(VcTerm)
)(
  match(
    info.ty,
    .EnumT({ id : e_id, variant_names : e_names, variant_fields : e_fields }) => _build_enum_ctor(ctx, e, e_id.clone(), e_names, e_fields, variant, dot_args),
    _ => {
      _fail_subset(ctx, String.from("field/method access (outside the V3 core subset)"), e);
      Option(VcTerm).None
    }
  )
);
_build_enum_ctor :: (
  fn(
    inout(ctx) : VcCtx,
    e : AstExpr,
    e_id : String,
    e_names : ArrayList(String),
    e_fields : ArrayList(ArrayList(TypeValue)),
    variant : String,
    dot_args : ArrayList(AstExpr)
  ) -> Option(VcTerm)
)(
  cond(
    _variant_named(e_names, variant.clone()) => {
      vidx := _variant_index_of(e_names, variant.clone());
      vname := match(e_names.get(vidx), .Some(n) => n, .None => String.new());
      vfs := match(e_fields.get(vidx), .Some(l) => l, .None => ArrayList(TypeValue).new());
      // The construction's VALUE args are the dot-args AFTER the variant
      // atom.
      cargs := ArrayList(VcTerm).new();
      (i : usize) = usize(1);
      while(i < dot_args.len(), {
        a := match(dot_args.get(i), .Some(x) => x, .None => make_err_expr());
        v := _expr_term(ctx, a);
        match(
          v,
          .Some(vt) => {
            cargs.push(vt);
          },
          .None => {
            return(Option(VcTerm).None);
          }
        );
        i = (i + usize(1));
      });
      if(!(cargs.len() == vfs.len()), {
        _fail_subset(
          ctx,
          `enum construction with ${cargs.len().to_string()} args (expected ${vfs.len().to_string()})`,
          e
        );
        return(Option(VcTerm).None);
      });
      _note_enum_datatype(
        ctx,
        .EnumT(
          e_id.clone(),
          String.new(),
          e_names,
          e_fields,
          Option(String).None,
          ArrayList(ArrayList(String)).new(),
          ArrayList(i64).new(),
          false,
          false
        )
      );
      Option(VcTerm).Some(VcTerm.Ctor(name : _enum_ctor_name(e_id, vname), args : cargs))
    },
    true => {
      _fail_subset(ctx, String.from("field/method access (outside the V3 core subset)"), e);
      Option(VcTerm).None
    }
  )
);
/// Whether `vname` (bare, no dot) names a variant.
_variant_named :: (fn(e_names : ArrayList(String), vname : String) -> bool)(
  _variant_index_of(e_names, vname) < e_names.len()
);
/// The variant index for a BARE variant name; the list length when not
/// found.
_variant_index_of :: (fn(e_names : ArrayList(String), vname : String) -> usize)({
  (i : usize) = usize(0);
  (hit : usize) = e_names.len();
  while((i < e_names.len()) && (hit == e_names.len()), {
    match(
      e_names.get(i),
      .Some(n) => if(n == vname, {
        hit = i;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  hit
});
/// match(scrutinee, arms...) as a nested ite VALUE tree: each arm
/// `.Variant(b1, b2) => body` contributes
/// `(ite (is-Ctor S) body[b := Ctor-i S] ...)`; a wildcard arm is the
/// else. Nested patterns are outside the V3 subset.
_match_term :: (fn(inout(ctx) : VcCtx, at : AstExpr, args : ArrayList(AstExpr)) -> Option(VcTerm))({
  if(args.len() < usize(2), {
    _fail_subset(ctx, String.from("match with too few arguments"), at);
    return(Option(VcTerm).None);
  });
  scrut := _expr_term(ctx, args.get(usize(0)).unwrap());
  scrut_info := expr_info_table_get(ctx.table, ast_expr_id(args.get(usize(0)).unwrap()));
  // The scrutinee's TYPE names the datatype's CONSTRUCTORS and ACCESSORS
  // (SMT-unique across enums): every Test/Proj the walk builds must use
  // the same spellings the declare-datatypes block declares.
  e_ty := match(scrut_info, .Some(si) => si.ty, .None => TypeValue.Unit);
  match(
    scrut,
    .Some(s) => {
      // Register the scrutinee's datatype.
      match(
        scrut_info,
        .Some(si) => _note_enum_datatype(ctx, si.ty),
        .None => ()
      );
      _match_arms(ctx, at, s, args, usize(1), e_ty)
    },
    .None => Option(VcTerm).None
  )
});
/// Fold arms [from, len) into the ite tree.
_match_arms :: (
  fn(inout(ctx) : VcCtx, at : AstExpr, scrut : VcTerm, args : ArrayList(AstExpr), from : usize, e_ty : TypeValue) -> Option(VcTerm)
)(
  cond(
    (from >= args.len()) => {
      _fail_subset(ctx, String.from("match without a final arm"), at);
      Option(VcTerm).None
    },
    true => _match_one_arm(ctx, at, scrut, args, from, e_ty)
  )
);
_match_one_arm :: (
  fn(inout(ctx) : VcCtx, at : AstExpr, scrut : VcTerm, args : ArrayList(AstExpr), idx : usize, e_ty : TypeValue) -> Option(VcTerm)
)(
  cond(
    ((idx + usize(1)) >= args.len()) => _match_last_arm(ctx, scrut, args, idx, e_ty),
    true => _match_folded_arm(ctx, at, scrut, args, idx, e_ty)
  )
);
_match_last_arm :: (
  fn(inout(ctx) : VcCtx, scrut : VcTerm, args : ArrayList(AstExpr), idx : usize, e_ty : TypeValue) -> Option(VcTerm)
)(_match_arm_value(ctx, scrut, args.get(idx).unwrap(), e_ty));
_match_folded_arm :: (
  fn(inout(ctx) : VcCtx, at : AstExpr, scrut : VcTerm, args : ArrayList(AstExpr), idx : usize, e_ty : TypeValue) -> Option(VcTerm)
)({
  tail := _match_arms(ctx, at, scrut, args, idx + usize(1), e_ty);
  match(
    tail,
    .Some(tail_t) => _match_arm_conditioned(ctx, scrut, args.get(idx).unwrap(), tail_t, e_ty),
    .None => Option(VcTerm).None
  )
});
_match_arm_value :: (fn(inout(ctx) : VcCtx, scrut : VcTerm, arm : AstExpr, e_ty : TypeValue) -> Option(VcTerm))({
  aa := _arm_parts(arm);
  body := match(
    aa.get(usize(1)),
    .Some(b) => b,
    .None => {
      _fail_subset(ctx, String.from("match arm outside => shape"), arm);
      return(Option(VcTerm).None);
    }
  );
  pat := match(
    aa.get(usize(0)),
    .Some(p) => p,
    .None => {
      _fail_subset(ctx, String.from("match arm outside => shape"), arm);
      return(Option(VcTerm).None);
    }
  );
  _arm_under_pattern(ctx, scrut, pat, body, e_ty)
});
_match_arm_conditioned :: (
  fn(inout(ctx) : VcCtx, scrut : VcTerm, arm : AstExpr, tail : VcTerm, e_ty : TypeValue) -> Option(VcTerm)
)({
  aa := _arm_parts(arm);
  pat := match(
    aa.get(usize(0)),
    .Some(p) => p,
    .None => {
      _fail_subset(ctx, String.from("match arm outside => shape"), arm);
      return(Option(VcTerm).None);
    }
  );
  body := match(
    aa.get(usize(1)),
    .Some(b) => b,
    .None => {
      _fail_subset(ctx, String.from("match arm outside => shape"), arm);
      return(Option(VcTerm).None);
    }
  );
  cond(
    _is_wildcard_pattern(pat) => Option(VcTerm).Some(_arm_body_value(ctx, body, tail)),
    true => _arm_conditioned_variant(ctx, scrut, pat, body, tail, e_ty)
  )
});
/// The arm's two parts (pattern, body) — `"=>"(p, b)`.
_arm_parts :: (fn(arm : AstExpr) -> ArrayList(AstExpr))(
  match(
    arm,
    .FnCall(_, _, a, _, _) => a,
    .Atom(_, _) => ArrayList(AstExpr).new()
  )
);
_is_wildcard_pattern :: (fn(pat : AstExpr) -> bool)(
  match(
    pat,
    .Atom(_, pt) => (pt.value == "_"),
    .FnCall(_, _, _, _, _) => false
  )
);
/// Evaluate the body and pair it with the else-value (wildcard arm).
_arm_body_value :: (fn(inout(ctx) : VcCtx, body : AstExpr, tail : VcTerm) -> VcTerm)({
  v := _expr_term(ctx, body);
  match(
    v,
    .Some(vt) => vt,
    .None => tail
  )
});
/// A conditioned `.Variant(b...)` arm: ite(Test) with the body under the
/// projected bindings; falls back to the tail on a walk failure.
_arm_conditioned_variant :: (
  fn(inout(ctx) : VcCtx, scrut : VcTerm, pat : AstExpr, body : AstExpr, tail : VcTerm, e_ty : TypeValue) -> Option(VcTerm)
)(
  match(
    _pattern_variant(pat),
    .Some(variant) => {
      v := _arm_under_pattern(ctx, scrut, pat, body, e_ty);
      match(
        v,
        .Some(vt) => Option(VcTerm).Some(_mk_test_ite(scrut, _variant_ctor_name(e_ty, variant), vt, tail)),
        .None => Option(VcTerm).None
      )
    },
    .None => {
      _fail_subset(ctx, String.from("non-variant match pattern (outside the V3 subset)"), pat);
      Option(VcTerm).None
    }
  )
);
/// The MANGLED constructor name for `variant` of enum type `e_ty`
/// (Unit/non-enum → the bare name; the walk on those is outside the
/// subset anyway).
_variant_ctor_name :: (fn(e_ty : TypeValue, variant : String) -> String)(
  match(
    e_ty,
    .EnumT({ id : e_id }) => _enum_ctor_name(e_id.clone(), variant.clone()),
    _ => variant.clone()
  )
);
/// The mangled ACCESSOR names for `variant`'s fields of enum type `e_ty`,
/// `count` of them (aligned with the pattern's bindings). SMT accessors
/// share the datatype's whole namespace, so `<ctor>_<label>` keeps two
/// variants that both have an `n` field from colliding; a missing label
/// falls back to the field index.
_variant_accessors :: (fn(e_ty : TypeValue, variant : String, count : usize) -> ArrayList(String))({
  out := ArrayList(String).new();
  ctor := _variant_ctor_name(e_ty, variant.clone());
  vls := match(
    e_ty,
    .EnumT({ variant_names : e_names, variant_field_labels : e_labels }) => match(
      e_labels.get(_variant_index_of(e_names, variant.clone())),
      .Some(l) => l,
      .None => ArrayList(String).new()
    ),
    _ => ArrayList(String).new()
  );
  (i : usize) = usize(0);
  while(i < count, {
    label := match(
      vls.get(i),
      .Some(fl) => fl.clone(),
      .None => {
        l := String.from("_");
        l.push_string(i.to_string());
        l
      }
    );
    nm := ctor.clone();
    nm.push_byte(u8(0x5F));
    nm.push_string(label);
    out.push(nm);
    i = (i + usize(1));
  });
  out
});
/// The pattern's BINDING argument list: the pattern call's OWN args
/// (`.(Some)(v)` → [v]); empty for the bare `.(Off)` form.
_pattern_binding_args :: (fn(pat : AstExpr) -> ArrayList(AstExpr))(
  match(
    pat,
    // `.(On)(v)` — callee is the NESTED dot-call (a FnCall): the pattern
    // call's own args are the bindings. `.(Off)` — callee is the "."
    // ATOM: no bindings.
    .FnCall(_, pf, pargs, _, _) => cond(
      ast_expr_is_atom(pf) => ArrayList(AstExpr).new(),
      true => pargs
    ),
    .Atom(_, _) => ArrayList(AstExpr).new()
  )
);
/// The first argument of a `.`-call as a variant name when it is a plain
/// atom.
_dot_first_atom :: (fn(pargs : ArrayList(AstExpr)) -> Option(String))(
  match(
    pargs.get(usize(0)),
    .Some(first) => cond(
      ast_expr_is_atom(first) => Option(String).Some(ast_expr_token(first).value),
      true => Option(String).None
    ),
    .None => Option(String).None
  )
);
/// A pattern's VARIANT name: `.On` parses as `.(On)` and `.Some(v)` as
/// `.(Some, v)` — a dot-call whose FIRST argument is the variant atom.
/// `.Some(v)`'s bindings are the remaining arguments. `.None` for
/// non-variant patterns (an wildcard atom handled separately, a literal,
/// anything else).
_pattern_variant :: (fn(pat : AstExpr) -> Option(String))(
  match(
    pat,
    .FnCall(_, pf, pargs, _, _) => cond(
      // `.(Off)` — the callee IS the dot atom; the variant is the single
      // argument. Distinguish by SHAPE, not by token: the nested
      // `.(On)(v)` callee is a FnCall whose token is ALSO ".".
      ast_expr_is_atom(pf) => cond(
        (ast_expr_token(pf).value == ".") => _dot_first_atom(pargs),
        true => Option(String).None
      ),
      true => _pattern_variant_of_callee(pf)
    ),
    .Atom(_, _) => Option(String).None
  )
);
/// The variant name from a pattern's CALLEE: `.Off` is `.(Off)` (a bare
/// dot-call); `.Some(v)` is `.(Some)` APPLIED to `(v)` — the parser gives
/// the method-call shape (callee = the nested dot-call, args = bindings).
_pattern_variant_of_callee :: (fn(pf : AstExpr) -> Option(String))(
  match(
    pf,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, pf2, pf_args, _, _) => cond(
      (ast_expr_token(pf2).value == ".") => _dot_first_atom(pf_args),
      true => Option(String).None
    )
  )
);
/// `(ite (is-<ctor> S) v tail)` — `variant` is the MANGLED constructor
/// name (the same spelling the declare-datatypes block declares).
_mk_test_ite :: (fn(scrut : VcTerm, variant : String, v : VcTerm, tail : VcTerm) -> VcTerm)({
  ite_args := ArrayList(VcTerm).new();
  ite_args.push(VcTerm.Test(ctor : variant.clone(), t : scrut));
  ite_args.push(v);
  ite_args.push(tail);
  VcTerm.App(VcOp.IteOp, ite_args)
});
/// Evaluate `body` with the pattern's bindings bound to the scrutinee's
/// projections (bindings saved and restored). Projections carry the
/// MANGLED accessor names (`<ctor>_<label>`) the declare-datatypes block
/// declares — z3 resolves field access by accessor symbol, not position.
_arm_under_pattern :: (
  fn(inout(ctx) : VcCtx, scrut : VcTerm, pat : AstExpr, body : AstExpr, e_ty : TypeValue) -> Option(VcTerm)
)({
  saved_names := ArrayList(String).new();
  saved_vals := ArrayList(Option(VcTerm)).new();
  match(
    _pattern_variant(pat),
    .Some(variant) => {
      pargs := _pattern_binding_args(pat);
      accessors := _variant_accessors(e_ty, variant.clone(), pargs.len());
      // Bindings: `.Some(v)` = `.(Some)(v)` — the pattern call's OWN args.
      (bi : usize) = usize(0);
      while(bi < pargs.len(), {
        b := match(pargs.get(bi), .Some(x) => x, .None => make_err_expr());
        if(ast_expr_is_atom(b), {
          bname := ast_expr_token(b).value;
          if(!(bname == "_"), {
            saved_names.push(bname.clone());
            saved_vals.push(ctx.vars.get(bname.clone()));
            ctx.vars.insert(
              bname.clone(),
              VcTerm.Proj(
                ctor : match(
                  accessors.get(bi),
                  .Some(a) => a.clone(),
                  .None => _variant_ctor_name(e_ty, variant.clone())
                ),
                idx : bi,
                t : scrut
              )
            );
          });
        }, {
          _fail_subset(ctx, String.from("nested match pattern (outside the V3 subset)"), pat);
          return(Option(VcTerm).None);
        });
        bi = (bi + usize(1));
      });
    },
    .None => ()
  );
  v := _expr_term(ctx, body);
  (si : usize) = saved_names.len();
  while(si > usize(0), {
    si = (si - usize(1));
    sn := saved_names.get(si).unwrap();
    match(
      saved_vals.get(si),
      .Some(sv) => {
        match(
          sv,
          .Some(old) => {
            ctx.vars.insert(sn.clone(), old);
          },
          .None => {
            _ := ctx.vars.remove(sn.clone());
            ()
          }
        );
      },
      .None => ()
    );
  });
  v
});
// ============================================================================
// Loops (V4): the havoc-invariant rule
// ============================================================================
/// Conjoin a non-empty term list with AndOp (single terms pass through).
_and_terms :: (fn(ts : ArrayList(VcTerm)) -> VcTerm)({
  r := ts.get(usize(0)).unwrap();
  (i : usize) = usize(1);
  while(i < ts.len(), {
    nxt := ts.get(i).unwrap();
    r = _app2(VcOp.AndOp, r, nxt);
    i = (i + usize(1));
  });
  r
});
/// Disjoin a non-empty term list with OrOp (single terms pass through).
_or_terms :: (fn(ts : ArrayList(VcTerm)) -> VcTerm)({
  r := ts.get(usize(0)).unwrap();
  (i : usize) = usize(1);
  while(i < ts.len(), {
    nxt := ts.get(i).unwrap();
    r = _app2(VcOp.OrOp, r, nxt);
    i = (i + usize(1));
  });
  r
});
/// Collect every source name ASSIGNED inside a loop body: `:=`/`=` LHS
/// names (the havoc set). Follows `ExprInfo.macro_expansion` for macro
/// calls (`for`, collection literals, user macros — the branch structure
/// lives in the expansion, not the macro call; the optimizer-family
/// discipline from issues/fixed/where-constraints-arraylist-96b-leak.md).
/// Names already in `out` are skipped (idempotent).
_scan_assigned :: (fn(table : ExprInfoTable, e : AstExpr, inout(out) : ArrayList(String)) -> unit)(
  match(
    e,
    .Atom(_, _) => (),
    .FnCall(_, f, fargs, _, _) => {
      // Macro calls: the semantics live in the expansion.
      expanded := match(
        expr_info_table_get(table, ast_expr_id(e)),
        .Some(ei) => ei.macro_expansion,
        .None => Option(AstExpr).None
      );
      match(
        expanded,
        .Some(xp) => _scan_assigned(table, xp, out),
        .None => {
          head := ast_expr_token(f).value;
          if(((head == ":=") || (head == "=")) && (fargs.len() == usize(2)), {
            match(
              _binding_name_of(fargs.get(usize(0)).unwrap()),
              .Some(name) => {
                if(!out.contains(name.clone()), {
                  out.push(name.clone());
                });
              },
              .None => ()
            );
          });
          (i : usize) = usize(0);
          while(i < fargs.len(), {
            match(
              fargs.get(i),
              .Some(a) => _scan_assigned(table, a, out),
              .None => ()
            );
            i = (i + usize(1));
          });
        }
      );
    }
  )
);
/// Extract the loop body's leading `invariant(...)` predicates and the
/// optional trailing `decreases(...)` measure; every other statement is
/// the executable body. Returns `.None` when no invariant leads the body.
_loop_annotations :: (
  fn(body : AstExpr) -> Option(LoopAnnotations)
)(
  match(
    body,
    .FnCall(_, f, stmts, _, _) => match(
      stmts.get(usize(0)),
      .Some(first) => match(
        first,
        .FnCall(_, invf, inv_args, _, _) => if(ast_expr_token(invf).value == "invariant", {
          measure := Option(AstExpr).None;
          rest_at := usize(1);
          match(
            stmts.get(usize(1)),
            .Some(second) => match(
              second,
              .FnCall(_, df, dargs, _, _) => if((ast_expr_token(df).value == "decreases") && (dargs.len() == usize(1)), {
                measure = dargs.get(usize(0));
                rest_at = usize(2);
              }),
              .Atom(_, _) => ()
            ),
            .None => ()
          );
          rest := ArrayList(AstExpr).new();
          (i : usize) = rest_at;
          while(i < stmts.len(), {
            match(
              stmts.get(i),
              .Some(s) => rest.push(s.clone()),
              .None => ()
            );
            i = (i + usize(1));
          });
          Option(LoopAnnotations).Some(LoopAnnotations(invariants : inv_args.clone(), decreases : measure, body : rest))
        }, Option(LoopAnnotations).None),
        .Atom(_, _) => Option(LoopAnnotations).None
      ),
      .None => Option(LoopAnnotations).None
    ),
    .Atom(_, _) => Option(LoopAnnotations).None
  )
);
LoopAnnotations :: struct(invariants : ArrayList(AstExpr), decreases : Option(AstExpr), body : ArrayList(AstExpr));
/// One `break` site (V4.2): the path condition at the break — the AND of
/// `ctx.path` at the statement, which includes the iterate assumptions and
/// every taken guard — and the full binding snapshot at that point. Terms
/// are shared refs (the IR is immutable once built).
BreakSite :: struct(path : VcTerm, vals : HashMap(String, VcTerm));
/// `break` parses as a plain atom or a zero-arg call (like `continue`).
_is_break_stmt :: (fn(e : AstExpr) -> bool)(
  cond(
    ast_expr_is_atom(e) => (ast_expr_token(e).value == "break"),
    true => ast_expr_is_fn_call_of(e, "break", Option(usize).None)
  )
);
_is_continue_stmt :: (fn(e : AstExpr) -> bool)(
  cond(
    ast_expr_is_atom(e) => (ast_expr_token(e).value == "continue"),
    true => ast_expr_is_fn_call_of(e, "continue", Option(usize).None)
  )
);
/// Snapshot the current state as one break site.
_record_break_site :: (fn(inout(ctx) : VcCtx) -> unit)({
  vals := HashMap(String, VcTerm).new();
  it := ctx.vars.keys();
  (go : bool) = true;
  while(go, {
    match(
      it.next(),
      .Some(k) => {
        // Keys come from ctx.vars itself, so the get always succeeds.
        vals.insert(k.clone(), ctx.vars.get(k.clone()).unwrap());
      },
      .None => {
        go = false;
      }
    );
  });
  ctx.break_sites.push(BreakSite(path : _and_terms(ctx.path), vals : vals));
});
/// A `continue` site jumps to the head, so the invariant must hold (and
/// the measure strictly decrease) over the state AT the statement — an
/// obligation emitted here, not only at the back-edge.
_continue_obligations :: (fn(inout(ctx) : VcCtx, at : AstExpr) -> bool)({
  (ok : bool) = true;
  inv_terms := ArrayList(VcTerm).new();
  (i : usize) = usize(0);
  while(i < ctx.loop_invariants.len(), {
    match(
      _expr_term(ctx, ctx.loop_invariants.get(i).unwrap()),
      .Some(t) => {
        inv_terms.push(t);
      },
      .None => {
        ok = false;
      }
    );
    i = (i + usize(1));
  });
  if(!ok, {
    return(false);
  });
  if(inv_terms.len() > usize(0), {
    _emit(ctx, String.from("loop-invariant-continue"), ArrayList(VcTerm).new(), _and_terms(inv_terms));
  });
  match(
    ctx.loop_measure,
    .Some(m_ast) => {
      if(ctx.head_measure.is_some(), {
        m_now := _expr_term(ctx, m_ast);
        match(
          m_now,
          .Some(mn) => {
            _emit(ctx, String.from("loop-variant-continue"), ArrayList(VcTerm).new(), _app2(VcOp.BvSlt, mn, ctx.head_measure.unwrap()));
          },
          .None => {
            _fail_subset(ctx, String.from("decreases measure outside the subset at a continue"), at);
            ok = false;
          }
        );
      });
    },
    .None => ()
  );
  ok
});
/// The havoc constant's sort for an existing binding: a Var carries its
/// own; anything else keeps the term's bit width (width 1 = bool).
_havoc_binding_sort :: (fn(old : VcTerm) -> VcSort)(
  match(
    old,
    .Var(_, s) => s,
    _ => cond(
      (_term_width(old) > usize(1)) => VcSort.BvS(width : _term_width(old)),
      true => VcSort.BoolS
    )
  )
);
/// Rebind every assigned name to a fresh unconstrained constant under a
/// NEW havoc generation (nested/back-to-back loops never share constants).
_havoc_assigned :: (fn(inout(ctx) : VcCtx, assigned : ArrayList(String)) -> unit)({
  ctx.havoc = (ctx.havoc + usize(1));
  (ai : usize) = usize(0);
  while(ai < assigned.len(), {
    name := assigned.get(ai).unwrap();
    srt := match(
      ctx.vars.get(name.clone()),
      .Some(old) => _havoc_binding_sort(old),
      .None => VcSort.BoolS
    );
    hv := `__yo_hv${ctx.havoc.to_string()}_${name.clone()}`;
    ctx.vars.insert(name.clone(), VcTerm.Var(name : hv, sort : srt));
    ai = (ai + usize(1));
  });
});
/// The havoc-invariant encoding of `while(cond, { invariant(...); body })`:
///
/// 1. ENTRY — prove `Inv` over the current state.
/// 2. ITERATE — assume `Inv ∧ Cond` over a HAVOCED state (every assigned
///    name rebound to a fresh unconstrained constant), execute the body
///    symbolically, prove `Inv` over the resulting state. Body obligations
///    (asserts, callee requires) emitted during the walk carry the iterate
///    assumptions through `ctx.path`.
/// 3. EXIT — the post-body bindings stay, with `Inv ∧ ¬Cond` over them
///    pushed onto `ctx.path` for everything after the loop.
///
/// `decreases(M)`: at iterate, prove `0 <= M` over the havoced state and
/// `M' < M` over the post-body state (M < M compared SIGNED at M's width —
/// the measure must be an integer expression).
_while_term :: (fn(inout(ctx) : VcCtx, e : AstExpr, args : ArrayList(AstExpr)) -> Option(VcTerm))({
  if(args.len() != usize(2), {
    _fail_subset(ctx, String.from("while with unexpected arity"), e);
    return(Option(VcTerm).None);
  });
  ann := _loop_annotations(args.get(usize(1)).unwrap());
  if(ann.is_none(), {
    _fail_subset(ctx, String.from("while loop without a leading invariant(...)"), e);
    return(Option(VcTerm).None);
  });
  a := ann.unwrap();
  if(a.invariants.len() == usize(0), {
    _fail_subset(ctx, String.from("invariant(...) with no predicates"), e);
    return(Option(VcTerm).None);
  });
  // 1. ENTRY: Inv over the current state.
  inv_entry_terms := ArrayList(VcTerm).new();
  (ii : usize) = usize(0);
  while(ii < a.invariants.len(), {
    match(
      _expr_term(ctx, a.invariants.get(ii).unwrap()),
      .Some(t) => inv_entry_terms.push(t),
      .None => {
        return(Option(VcTerm).None);
      }
    );
    ii = (ii + usize(1));
  });
  _emit(ctx, String.from("loop-invariant-entry"), ArrayList(VcTerm).new(), _and_terms(inv_entry_terms));
  // 2. HAVOC: rebind every assigned name to a fresh constant.
  assigned := ArrayList(String).new();
  (bi : usize) = usize(0);
  while(bi < a.body.len(), {
    match(
      a.body.get(bi),
      .Some(s) => _scan_assigned(ctx.table, s, assigned),
      .None => ()
    );
    bi = (bi + usize(1));
  });
  _havoc_assigned(ctx, assigned);
  // ITERATE assumptions over the havoced state.
  inv_havoc_terms := ArrayList(VcTerm).new();
  (hi : usize) = usize(0);
  while(hi < a.invariants.len(), {
    match(
      _expr_term(ctx, a.invariants.get(hi).unwrap()),
      .Some(t) => inv_havoc_terms.push(t),
      .None => {
        return(Option(VcTerm).None);
      }
    );
    hi = (hi + usize(1));
  });
  cond_havoc := _expr_term(ctx, args.get(usize(0)).unwrap());
  if(cond_havoc.is_none(), {
    return(Option(VcTerm).None);
  });
  path_mark := ctx.path.len();
  ctx.path.push(_and_terms(inv_havoc_terms));
  ctx.path.push(cond_havoc.unwrap());
  // Optional measure over the havoced state.
  m_havoc := match(
    a.decreases,
    .Some(dm) => _expr_term(ctx, dm),
    .None => Option(VcTerm).None
  );
  if(m_havoc.is_some(), {
    m := m_havoc.unwrap();
    zero := VcTerm.BvLit(value : u64(0), width : _term_width(m));
    _emit(ctx, String.from("loop-variant-nonneg"), ArrayList(VcTerm).new(), _app2(VcOp.BvSge, m, zero));
  });
  // 3. Walk the executable body (obligations inside carry the iterate
  //    assumptions via ctx.path). `_begin_term` is the statement walker —
  //    it is what knows `:=`/`=` rebind ctx.vars, records break sites
  //    (with the path snapshot at the statement), and emits the
  //    continue-site obligations. `path_dead` after the walk means every
  //    remaining path exited mid-body — there is no body-end state, so
  //    the iterate/variant goals are skipped (the continue sites proved
  //    the invariant at their statements) and the exit is only the break
  //    disjuncts plus the cond-exit.
  saved_invariants := ctx.loop_invariants;
  saved_measure := ctx.loop_measure;
  saved_head_measure := ctx.head_measure;
  ctx.loop_invariants = a.invariants;
  ctx.loop_measure = a.decreases;
  ctx.head_measure = m_havoc;
  saved_sites := ctx.break_sites;
  ctx.break_sites = ArrayList(BreakSite).new();
  ctx.path_dead = false;
  ctx.loop_depth = (ctx.loop_depth + usize(1));
  bd := _begin_term(ctx, a.body.clone());
  sites := ctx.break_sites;
  ctx.break_sites = saved_sites;
  ctx.loop_depth = (ctx.loop_depth - usize(1));
  fell_through := !ctx.path_dead;
  ctx.path_dead = false;
  ctx.loop_invariants = saved_invariants;
  ctx.loop_measure = saved_measure;
  ctx.head_measure = saved_head_measure;
  if(bd.is_none(), {
    return(Option(VcTerm).None);
  });
  if(fell_through, {
    // ITERATE goal: Inv (and the measure step) over the post-body state.
    inv_after_terms := ArrayList(VcTerm).new();
    (ti : usize) = usize(0);
    while(ti < a.invariants.len(), {
      match(
        _expr_term(ctx, a.invariants.get(ti).unwrap()),
        .Some(t) => inv_after_terms.push(t),
        .None => {
          return(Option(VcTerm).None);
        }
      );
      ti = (ti + usize(1));
    });
    _emit(ctx, String.from("loop-invariant-iterate"), ArrayList(VcTerm).new(), _and_terms(inv_after_terms));
    if(m_havoc.is_some(), {
      m2 := match(
        a.decreases,
        .Some(dm) => _expr_term(ctx, dm),
        .None => Option(VcTerm).None
      );
      if(m2.is_none(), {
        return(Option(VcTerm).None);
      });
      _emit(
        ctx,
        String.from("loop-variant-decreases"),
        ArrayList(VcTerm).new(),
        _app2(VcOp.BvSlt, m2.unwrap(), m_havoc.unwrap())
      );
    });
  });
  // 4. EXIT. Pop back to the pre-iterate mark — the iterate assumptions
  //    (and anything the walk pushed above them: callee ensures, dead-arm
  //    guards) constrain the iteration's terms; the break sites carry
  //    their own full snapshots, and no post-loop obligation may lean on
  //    the dropped ones. The cond-exit state is a FRESH havoc generation:
  //    a concrete cond-exit can be the zero-iteration pre-state, which
  //    the walked body's output cannot represent — the exit facts are
  //    Inv ∧ ¬Cond over unconstrained constants, the standard modular
  //    rule (issues/fixed/verifier-loop-exit-pins-post-body-bindings.md).
  while(ctx.path.len() > path_mark, {
    _ := ctx.path.pop();
  });
  _havoc_assigned(ctx, assigned);
  inv_exit := ArrayList(VcTerm).new();
  (xi : usize) = usize(0);
  while(xi < a.invariants.len(), {
    match(
      _expr_term(ctx, a.invariants.get(xi).unwrap()),
      .Some(t) => inv_exit.push(t),
      .None => {
        return(Option(VcTerm).None);
      }
    );
    xi = (xi + usize(1));
  });
  cond_exit := _expr_term(ctx, args.get(usize(0)).unwrap());
  if(cond_exit.is_none(), {
    return(Option(VcTerm).None);
  });
  if(sites.len() == usize(0), {
    // No breaks: the exit is just the fresh-havoc Inv ∧ ¬Cond.
    ctx.path.push(_and_terms(inv_exit));
    ctx.path.push(_app1(VcOp.NotOp, cond_exit.unwrap()));
    return(Option(VcTerm).Some(VcTerm.BoolLit(true)));
  });
  // With breaks: a fresh selector b_k per site. Every assigned name's
  // post-loop binding selects the site's snapshot value when that break
  // fired, else the fresh cond-exit constant; the path assumes the
  // matching state disjunction (the site's snapshot path includes the
  // iterate assumptions and every guard taken to reach the break).
  bs := ArrayList(VcTerm).new();
  (ki : usize) = usize(0);
  while(ki < sites.len(), {
    bs.push(VcTerm.Var(name : `__yo_br${ctx.havoc.to_string()}_${ki.to_string()}`, sort : VcSort.BoolS));
    ki = (ki + usize(1));
  });
  (ni : usize) = usize(0);
  while(ni < assigned.len(), {
    name := assigned.get(ni).unwrap();
    base := match(
      ctx.vars.get(name.clone()),
      .Some(cur) => cur,
      .None => VcTerm.BoolLit(true)
    );
    chain := box(base);
    (ci2 : usize) = sites.len();
    while(ci2 > usize(0), {
      ci2 = (ci2 - usize(1));
      site := sites.get(ci2).unwrap();
      site_v := match(
        site.vals.get(name.clone()),
        .Some(sv) => sv,
        .None => chain.*
      );
      ite_a := ArrayList(VcTerm).new();
      ite_a.push(bs.get(ci2).unwrap());
      ite_a.push(site_v);
      ite_a.push(chain.*);
      chain.* = VcTerm.App(VcOp.IteOp, ite_a);
    });
    ctx.vars.insert(name.clone(), chain.*);
    ni = (ni + usize(1));
  });
  exit_terms := ArrayList(VcTerm).new();
  exit_terms.push(_app1(VcOp.NotOp, _or_terms(bs)));
  (ii2 : usize) = usize(0);
  while(ii2 < inv_exit.len(), {
    exit_terms.push(inv_exit.get(ii2).unwrap());
    ii2 = (ii2 + usize(1));
  });
  exit_terms.push(_app1(VcOp.NotOp, cond_exit.unwrap()));
  disj := ArrayList(VcTerm).new();
  disj.push(_and_terms(exit_terms));
  (di3 : usize) = usize(0);
  while(di3 < sites.len(), {
    d_args := ArrayList(VcTerm).new();
    d_args.push(bs.get(di3).unwrap());
    d_args.push(sites.get(di3).unwrap().path);
    disj.push(_and_terms(d_args));
    di3 = (di3 + usize(1));
  });
  ctx.path.push(_or_terms(disj));
  Option(VcTerm).Some(VcTerm.BoolLit(true))
});
/// forall/exists (V5 §6): N binder args `(name : Type)` then the
/// predicate body. Each binder shadows any outer binding for the body
/// walk (saved/restored like the cond-arm pre-state); the SMT binder
/// handles scoping at the solver level. Instantiation relies on z3's
/// MBQI for now — explicit `:pattern` triggers are deferred until a
/// real benchmark needs them (recorded in the plan's V5 banner).
_quant_term :: (
  fn(inout(ctx) : VcCtx, at : AstExpr, head : String, args : ArrayList(AstExpr)) -> Option(VcTerm)
)({
  kind := cond(
    (head == "forall") => VcQuantKind.Forall,
    true => VcQuantKind.Exists
  );
  qnames := ArrayList(String).new();
  qsorts := ArrayList(VcSort).new();
  saved_names := ArrayList(String).new();
  saved_vals := ArrayList(Option(VcTerm)).new();
  (bi : usize) = usize(0);
  while(bi < (args.len() - usize(1)), {
    b := match(
      args.get(bi),
      .Some(bb) => bb,
      .None => {
        return(Option(VcTerm).None);
      }
    );
    if(!ast_expr_is_fn_call_of(b, ":", Option(usize).Some(usize(2))), {
      _fail_subset(ctx, String.from("quantifier binder must be (name : Type)"), b);
      return(Option(VcTerm).None);
    });
    ba := match(
      b,
      .FnCall(_, _, a2, _, _) => a2,
      .Atom(_, _) => ArrayList(AstExpr).new()
    );
    nm_arg := match(
      ba.get(usize(0)),
      .Some(n0) => n0,
      .None => make_err_expr()
    );
    if(!ast_expr_is_atom(nm_arg), {
      _fail_subset(ctx, String.from("quantifier binder name must be a plain name"), b);
      return(Option(VcTerm).None);
    });
    bn := ast_expr_token(nm_arg).value;
    // The binder's sort: the `:`-call's SECOND argument (the type
    // expression) evaluates to a TypeVal; the annotation call itself
    // does not carry one.
    ty_arg := match(
      ba.get(usize(1)),
      .Some(t0) => t0,
      .None => make_err_expr()
    );
    srt := match(
      expr_info_table_get(ctx.table, ast_expr_id(ty_arg)),
      .Some(bi2) => match(
        bi2.value,
        .Some(vb) => match(
          vb,
          .TypeVal(tv) => _type_sort(tv),
          _ => _type_sort(bi2.ty)
        ),
        .None => _type_sort(bi2.ty)
      ),
      .None => Option(VcSort).None
    );
    match(
      srt,
      .Some(s) => {
        qnames.push(bn.clone());
        qsorts.push(s);
        saved_names.push(bn.clone());
        saved_vals.push(ctx.vars.get(bn.clone()));
        ctx.vars.insert(bn.clone(), VcTerm.Var(name : bn.clone(), sort : s));
      },
      .None => {
        _fail_subset(ctx, `quantifier binder '${bn.clone()}' has a type outside the integer/bool subset`, b);
        return(Option(VcTerm).None);
      }
    );
    bi = (bi + usize(1));
  });
  body := _expr_term(ctx, args.get(args.len() - usize(1)).unwrap());
  // Restore the shadowed bindings (a missing binding goes back to missing).
  (si : usize) = saved_names.len();
  while(si > usize(0), {
    si = (si - usize(1));
    match(
      saved_names.get(si),
      .Some(sn) => {
        match(
          saved_vals.get(si),
          .Some(sv) => {
            match(
              sv,
              .Some(old) => {
                ctx.vars.insert(sn.clone(), old);
              },
              .None => {
                _ := ctx.vars.remove(sn.clone());
                ()
              }
            );
          },
          .None => ()
        );
      },
      .None => ()
    );
  });
  match(
    body,
    .Some(bt) => Option(VcTerm).Some(VcTerm.Quant(kind : kind, names : qnames, sorts : qsorts, body : bt)),
    .None => Option(VcTerm).None
  )
});
/// The operator/cast/call dispatch.
_call_term :: (
  fn(inout(ctx) : VcCtx, e : AstExpr, head : String, args : ArrayList(AstExpr), info : ExprInfo)
  -> Option(VcTerm)
)({
  n := args.len();
  // --- integer casts: i32(x), u8(x), i64(x), … ---------------------------
  cast_w := _cast_width(head);
  if(cast_w.is_some() && (n == usize(1)), {
    arg := args.get(usize(0)).unwrap();
    arg_info := match(
      expr_info_table_get(ctx.table, ast_expr_id(arg)),
      .Some(ai) => ai,
      .None => {
        _fail_subset(ctx, String.from("untyped cast operand"), e);
        return(Option(VcTerm).None);
      }
    );
    target_w := match(
      cast_w,
      .Some(w) => w,
      .None => usize(0)
    );
    src_t := _expr_term(ctx, arg);
    return(
      match(
        src_t,
        .Some(st) => match(
          _int_width(arg_info.ty),
          .Some(src_w) => Option(VcTerm).Some(_widen_or_trunc(st, src_w, target_w, _int_is_signed(arg_info.ty))),
          .None => {
            _fail_subset(ctx, String.from("cast of non-integer operand"), e);
            Option(VcTerm).None
          }
        ),
        .None => Option(VcTerm).None
      )
    );
  });
  // --- binary arithmetic / comparisons -----------------------------------
  bin := _binop_of_ctx(ctx, head, args);
  if(bin.is_some() && (n == usize(2)), {
    a_opt := _expr_term(ctx, args.get(usize(0)).unwrap());
    b_opt := _expr_term(ctx, args.get(usize(1)).unwrap());
    if(a_opt.is_none() || b_opt.is_none(), {
      return(Option(VcTerm).None);
    });
    at := a_opt.unwrap();
    bt := b_opt.unwrap();
    op := match(
      bin,
      .Some(o) => o,
      .None => VcOp.BvAdd
    );
    // AoRTE: division/remainder divisor non-zero.
    if((op == VcOp.BvSdiv) || (op == VcOp.BvUdiv) || ((op == VcOp.BvSrem) || (op == VcOp.BvUrem)), {
      _emit(ctx, String.from("divisor-nonzero"), ArrayList(VcTerm).new(), _nonzero_term(bt));
    });
    // AoRTE: shift amount within the shifted operand's width.
    if((op == VcOp.BvShl) || (op == VcOp.BvLshr) || (op == VcOp.BvAshr), {
      shift_w := match(
        expr_info_table_get(ctx.table, ast_expr_id(args.get(usize(0)).unwrap())),
        .Some(ai) => match(
          _int_width(ai.ty),
          .Some(w) => w,
          .None => usize(64)
        ),
        .None => usize(64)
      );
      _emit(
        ctx,
        String.from("shift-in-width"),
        ArrayList(VcTerm).new(),
        _lt_unsigned_term(bt, VcTerm.BvLit(value : u64(shift_w), width : _term_width(bt)))
      );
    });
    return(Option(VcTerm).Some(_app2(op, at, bt)));
  });
  // --- unary --------------------------------------------------------------
  if((n == usize(1)) && ((head == "-") || (head == "~") || (head == "!")), {
    a := _expr_term(ctx, args.get(usize(0)).unwrap());
    return(
      match(
        a,
        .Some(at) => Option(VcTerm).Some(
          cond(
            (head == "-") => _app1(VcOp.BvNeg, at),
            (head == "~") => _app1(VcOp.BvNotOp, at),
            true => _app1(VcOp.NotOp, at)
          )
        ),
        .None => Option(VcTerm).None
      )
    );
  });
  // --- cond(...) as an ite VALUE tree -------------------------------------
  if(head == "cond", {
    return(_cond_ite(ctx, e, args));
  });
  // --- enum construction: `.Variant(args...)` ------------------------------
  // Parses as `.(Variant, args...)` — a dot-call whose FIRST argument
  // names the variant. Only reached when the call's own type is a VALUE
  // enum (the guard below); other dot-calls fall through to the subset
  // error at the callee-call tail.
  if((head == ".") && _is_value_enum_type(info.ty), {
    return(_enum_ctor_term(ctx, e, args, info));
  });
  // --- match(scrutinee, arms...) ---------------------------------------------
  if(head == "match", {
    return(_match_term(ctx, e, args));
  });
  // --- while: the V4 havoc-invariant encoding ----------------------
  // `for` is a macro over while whose expansion drives an iterator
  // (`iter.next()` — an uncontracted trait call over collection state);
  // that needs the collection model of the later phases, so it stays
  // outside the subset with a precise error (the idiomatic replacement —
  // `while(runtime(true), { invariant(...); ...; if(done, {break;}) })` —
  // IS verifiable: `runtime` is the identity, below, and break is the
  // V4.2 exit-path disjunction).
  if(head == "while", {
    return(_while_term(ctx, e, args));
  });
  if(head == "for", {
    _fail_subset(ctx, String.from("for loop (write it as a while with an invariant — the iterator model is outside the subset for now)"), e);
    return(Option(VcTerm).None);
  });
  // break/continue are STATEMENT-level constructs (V4.2): `_begin_term`
  // handles them with the site machinery. Reaching this gate means one
  // appeared in EXPRESSION position (`x := (break, 1)`-shaped code),
  // where there is no state to snapshot as a single exit disjunct.
  if((head == "break") || (head == "continue") ||
    (ast_expr_is_atom(e) && ((ast_expr_token(e).value == "break") || (ast_expr_token(e).value == "continue"))), {
    _fail_subset(
      ctx,
      String.from("break/continue in expression position (supported as statements only)"),
      e
    );
    return(Option(VcTerm).None);
  });
  // --- begin blocks --------------------------------------------------------
  if(head == "begin", {
    return(_begin_term(ctx, args));
  });
  // --- the unit literal `()` ------------------------------------------------
  // A zero-arg `tuple` call — the parser's unit, e.g. an empty cond arm
  // (`true => ()`). As a VALUE it carries no information.
  if(_is_unit_lit(e), {
    return(Option(VcTerm).Some(VcTerm.BoolLit(true)));
  });
  // --- assert sites --------------------------------------------------------
  if((head == "assert") && (n >= usize(1)), {
    p := _expr_term(ctx, args.get(usize(0)).unwrap());
    return(
      match(
        p,
        .Some(pt) => {
          _emit(ctx, String.from("assert"), ArrayList(VcTerm).new(), pt);
          Option(VcTerm).Some(VcTerm.BoolLit(true))
        },
        .None => Option(VcTerm).None
      )
    );
  });
  // --- panic: diverging ----------------------------------------------------
  if(head == "panic", {
    // Diverging path — contributes nothing (SPARK's stance).
    return(Option(VcTerm).Some(VcTerm.BoolLit(true)));
  });
  // --- old(...): the two-state ENTRY snapshot (V5) ---------------------------
  // `old(e)` evaluates e in the FUNCTION-ENTRY state: the walk runs against
  // a copy of ctx.entry_vars. The V3 identity was sound only while bodies
  // could not rebind — V4 legalized `=` on locals, and identity then read
  // the CURRENT binding, a false PROOF (`y := x; y = (y + 1);
  // assert(y == old(y))` "proved" though it is false for every x).
  if((head == "old") && (n == usize(1)), {
    oa := args.get(usize(0)).unwrap();
    // A bare name must be bound AT ENTRY — a body-local name has no entry
    // value (the Dafny rule); a complex arg's own unbound names error
    // precisely during the snapshot walk below.
    if(ast_expr_is_atom(oa) && !ctx.entry_vars.contains_key(ast_expr_token(oa).value), {
      _fail_subset(
        ctx,
        `old(...) of '${ast_expr_token(oa).value}' — the name is not bound at function entry (old is the entry state; a body-local has no entry value)`,
        e
      );
      return(Option(VcTerm).None);
    });
    saved_vars := ctx.vars;
    entry_copy := HashMap(String, VcTerm).new();
    eit := ctx.entry_vars.keys();
    (ego : bool) = true;
    while(ego, {
      match(
        eit.next(),
        .Some(ek) => {
          match(
            ctx.entry_vars.get(ek.clone()),
            .Some(ev) => {
              entry_copy.insert(ek.clone(), ev);
            },
            .None => ()
          );
        },
        .None => {
          ego = false;
        }
      );
    });
    ctx.vars = entry_copy;
    t := _expr_term(ctx, oa);
    ctx.vars = saved_vars;
    return(t);
  });
  // --- runtime(...): identity ------------------------------------------------
  // The comptime/runtime barrier marker: `runtime(e)` IS `e` at runtime.
  // This is what makes the infinite-loop idiom `while(runtime(true),
  // { invariant(...); ...; if(done, { break; }) })` walkable.
  if((head == "runtime") && (n == usize(1)), {
    return(_expr_term(ctx, args.get(usize(0)).unwrap()));
  });
  // --- ghost quantifiers/implication (V5 §6) ----------------------------------
  // `a ==> b` lowers to the boolean implication; forall/exists
  // build a Quant term over the annotated binders. Both are ghost-only
  // at the evaluator level (no runtime semantics) — the walk sees them
  // only inside contract predicates.
  if((head == "==>") && (n == usize(2)), {
    a := _expr_term(ctx, args.get(usize(0)).unwrap());
    if(a.is_none(), {
      return(Option(VcTerm).None);
    });
    b := _expr_term(ctx, args.get(usize(1)).unwrap());
    if(b.is_none(), {
      return(Option(VcTerm).None);
    });
    return(Option(VcTerm).Some(_app2(VcOp.ImpOp, a.unwrap(), b.unwrap())));
  });
  if(((head == "forall") || (head == "exists")) && (n >= usize(2)), {
    return(_quant_term(ctx, e, head, args));
  });
  // --- calls to contracted callees ----------------------------------------
  return(_callee_call_term(ctx, e, args, info));
});
/// Cast head → target width (i8..i64/u8..u64/isize/usize).
_cast_width :: (fn(head : String) -> Option(usize))(
  cond(
    (head == "i8") => Option(usize).Some(usize(8)),
    (head == "u8") => Option(usize).Some(usize(8)),
    (head == "i16") => Option(usize).Some(usize(16)),
    (head == "u16") => Option(usize).Some(usize(16)),
    (head == "i32") => Option(usize).Some(usize(32)),
    (head == "u32") => Option(usize).Some(usize(32)),
    (head == "i64") => Option(usize).Some(usize(64)),
    (head == "u64") => Option(usize).Some(usize(64)),
    (head == "usize") => Option(usize).Some(usize(64)),
    (head == "isize") => Option(usize).Some(usize(64)),
    true => Option(usize).None
  )
);
/// Operator head → VcOp with signedness resolved by `signed`.
_binop_of_with_sign :: (fn(head : String, signed : bool) -> Option(VcOp))(
  cond(
    (head == "+") => Option(VcOp).Some(VcOp.BvAdd),
    (head == "-") => Option(VcOp).Some(VcOp.BvSub),
    (head == "*") => Option(VcOp).Some(VcOp.BvMul),
    (head == "/") => Option(VcOp).Some(cond(signed => VcOp.BvSdiv, true => VcOp.BvUdiv)),
    (head == "%") => Option(VcOp).Some(cond(signed => VcOp.BvSrem, true => VcOp.BvUrem)),
    (head == "<") => Option(VcOp).Some(cond(signed => VcOp.BvSlt, true => VcOp.BvUlt)),
    (head == "<=") => Option(VcOp).Some(cond(signed => VcOp.BvSle, true => VcOp.BvUle)),
    (head == ">") => Option(VcOp).Some(cond(signed => VcOp.BvSgt, true => VcOp.BvUgt)),
    (head == ">=") => Option(VcOp).Some(cond(signed => VcOp.BvSge, true => VcOp.BvUge)),
    (head == "==") => Option(VcOp).Some(VcOp.EqOp),
    (head == "!=") => Option(VcOp).Some(VcOp.DistinctOp),
    (head == "&&") => Option(VcOp).Some(VcOp.AndOp),
    (head == "||") => Option(VcOp).Some(VcOp.OrOp),
    (head == "<<") => Option(VcOp).Some(VcOp.BvShl),
    (head == ">>") => Option(VcOp).Some(cond(signed => VcOp.BvAshr, true => VcOp.BvLshr)),
    (head == "&") => Option(VcOp).Some(VcOp.BvAndOp),
    (head == "|") => Option(VcOp).Some(VcOp.BvOrOp),
    (head == "^") => Option(VcOp).Some(VcOp.BvXorOp),
    true => Option(VcOp).None
  )
);
/// Signedness comes from the FIRST argument's type.
_binop_of_ctx :: (fn(inout(ctx) : VcCtx, head : String, args : ArrayList(AstExpr)) -> Option(VcOp))({
  signed := match(
    args.get(usize(0)),
    .Some(a) => match(
      expr_info_table_get(ctx.table, ast_expr_id(a)),
      .Some(ai) => _int_is_signed(ai.ty),
      .None => true
    ),
    .None => true
  );
  _binop_of_with_sign(head, signed)
});
_widen_or_trunc :: (fn(t : VcTerm, src_w : usize, dst_w : usize, src_signed : bool) -> VcTerm)({
  if(dst_w == src_w, {
    return(t);
  });
  if(dst_w > src_w, {
    if(src_signed, {
      return(_app1(VcOp.SignExtendOp(extra : (dst_w - src_w)), t));
    }, {
      return(_app1(VcOp.ZeroExtendOp(extra : (dst_w - src_w)), t));
    });
  });
  _app1(VcOp.ExtractOp(hi : (dst_w - usize(1)), lo : usize(0)), t)
});
/// `cond(c1 => v1, …, true => vN)` as nested ite VALUES (V3: no branch-local
/// obligations — the whole cond is one value).
/// Remove `guard_count` entries starting at index `base` of ctx.path,
/// keeping everything ABOVE them (stacked off and restored in order).
/// The cond-arm guards are arm-local; assumptions pushed DURING the arm
/// walk — callee ensures at call sites — must survive the arm.
_unwind_path_guards :: (fn(inout(ctx) : VcCtx, base : usize, guard_count : usize) -> unit)({
  keep := ArrayList(VcTerm).new();
  (k : usize) = (ctx.path.len() - (base + guard_count));
  while(k > usize(0), {
    match(
      ctx.path.get(ctx.path.len() - usize(1)),
      .Some(top) => keep.push(top),
      .None => ()
    );
    _ := ctx.path.pop();
    k = (k - usize(1));
  });
  (g : usize) = guard_count;
  while(g > usize(0), {
    _ := ctx.path.pop();
    g = (g - usize(1));
  });
  (r : usize) = keep.len();
  while(r > usize(0), {
    r = (r - usize(1));
    match(
      keep.get(r),
      .Some(t) => ctx.path.push(t),
      .None => ()
    );
  });
});
_cond_ite :: (fn(inout(ctx) : VcCtx, at : AstExpr, args : ArrayList(AstExpr)) -> Option(VcTerm))({
  // Pair up (condition, value); the trailing `true => v` arm is the else.
  // An arm may ASSIGN (a block value): every arm walks from the SAME
  // pre-cond state, and each assigned name's post-cond binding is the
  // phi ite-fold over the arm guards (exactly one arm runs).
  conds := ArrayList(VcTerm).new();
  vals := ArrayList(VcTerm).new();
  // Parallel to the arms: true when that arm's walk exited the loop
  // (break/continue inside) — the arm has no fall-through contribution.
  dead_flags := ArrayList(bool).new();
  // Pre-pass: the union of names assigned in any arm, and the pre-cond
  // bindings they are restored to between arms.
  phi_names := ArrayList(String).new();
  (ai0 : usize) = usize(0);
  while(ai0 < args.len(), {
    arm0 := args.get(ai0).unwrap();
    if(ast_expr_is_fn_call_of(arm0, "=>", Option(usize).Some(usize(2))), {
      aa0 := match(
        arm0,
        .FnCall(_, _, a2, _, _) => a2,
        .Atom(_, _) => ArrayList(AstExpr).new()
      );
      _scan_assigned(ctx.table, aa0.get(usize(1)).unwrap(), phi_names);
    });
    ai0 = (ai0 + usize(1));
  });
  pre_vals := ArrayList(Option(VcTerm)).new();
  (pi0 : usize) = usize(0);
  while(pi0 < phi_names.len(), {
    pre_vals.push(ctx.vars.get(phi_names.get(pi0).unwrap().clone()));
    pi0 = (pi0 + usize(1));
  });
  // Per-arm resulting bindings for the phi names (parallel to the arms).
  arm_states := ArrayList(HashMap(String, VcTerm)).new();
  (i : usize) = usize(0);
  while(i < args.len(), {
    arm := args.get(i).unwrap();
    // Each arm is FnCall("=>", [cond, value]).
    if(ast_expr_is_fn_call_of(arm, "=>", Option(usize).Some(usize(2))), {
      aa := match(
        arm,
        .FnCall(_, _, a2, _, _) => a2,
        .Atom(_, _) => ArrayList(AstExpr).new()
      );
      c_opt := _expr_term(ctx, aa.get(usize(0)).unwrap());
      // The arm's value walks under its GUARD (this condition ∧ the
      // negation of every earlier condition): obligations inside the arm
      // — callee requires, asserts — are reachable only on that path.
      guard_cell := box(match(c_opt, .Some(c0) => c0, .None => VcTerm.BoolLit(true)));
      path_base := ctx.path.len();
      (pi : usize) = usize(0);
      pushed := usize(0);
      while(pi < conds.len(), {
        ng := _app1(VcOp.NotOp, conds.get(pi).unwrap());
        ctx.path.push(ng);
        pushed = (pushed + usize(1));
        pi = (pi + usize(1));
      });
      if(c_opt.is_some(), {
        ctx.path.push(c_opt.unwrap());
        pushed = (pushed + usize(1));
      });
      ctx.path_dead = false;
      v_opt := _expr_term(ctx, aa.get(usize(1)).unwrap());
      // Capture this arm's resulting bindings, then restore the pre-cond
      // state so the NEXT arm walks from it (exactly one arm runs).
      state := HashMap(String, VcTerm).new();
      (ci : usize) = usize(0);
      while(ci < phi_names.len(), {
        nm := phi_names.get(ci).unwrap();
        match(
          ctx.vars.get(nm.clone()),
          .Some(now) => {
            state.insert(nm.clone(), now);
          },
          .None => ()
        );
        match(
          pre_vals.get(ci),
          .Some(pre) => {
            match(
              pre,
              .Some(old) => {
                ctx.vars.insert(nm.clone(), old);
              },
              .None => {
                _ := ctx.vars.remove(nm.clone());
                ()
              }
            );
          },
          .None => ()
        );
        ci = (ci + usize(1));
      });
      arm_states.push(state);
      _unwind_path_guards(ctx, path_base, pushed);
      // An arm that exited the loop never falls through: its guard can
      // never hold on the fall-through path, so assume ¬guard there
      // permanently (the exit itself — site snapshot or continue
      // obligation — was recorded during the arm's walk).
      dead_flags.push(ctx.path_dead);
      if(ctx.path_dead, {
        ctx.path.push(_app1(VcOp.NotOp, guard_cell.*));
      });
      if(c_opt.is_none() || v_opt.is_none(), {
        return(Option(VcTerm).None);
      });
      ct := guard_cell.*;
      vt := v_opt.unwrap();
      conds.push(ct);
      vals.push(vt);
    }, {
      _fail_subset(ctx, String.from("cond arm outside ite shape"), arm);
      return(Option(VcTerm).None);
    });
    i = (i + usize(1));
  });
  if(vals.len() == usize(0), {
    _fail_subset(ctx, String.from("empty cond"), at);
    return(Option(VcTerm).None);
  });
  // At least one arm must fall through — the cond's VALUE (and the phi
  // bindings) would otherwise be unreachable garbage. With live arms,
  // their guards (plus the pushed ¬guards of the dead ones) are
  // exhaustive on the fall-through path. The cond itself falls through,
  // so the enclosing block keeps walking.
  last_live := usize(0);
  (found_live : bool) = false;
  (ll : usize) = dead_flags.len();
  while((ll > usize(0)) && !found_live, {
    ll = (ll - usize(1));
    match(
      dead_flags.get(ll),
      .Some(df) => {
        if(!df, {
          last_live = ll;
          found_live = true;
        });
      },
      .None => ()
    );
  });
  if(!found_live, {
    _fail_subset(ctx, String.from("cond arm exits the loop on every arm (break/continue) — the cond has no fall-through value"), at);
    return(Option(VcTerm).None);
  });
  ctx.path_dead = false;
  // Phi-fold every assigned name: the post-cond binding is the ite over
  // the guards of each LIVE arm's resulting term (an arm that does not
  // assign keeps the pre-cond value); the LAST live arm is the else — its
  // entry is the fold base (dead arms are excluded: their guards cannot
  // hold on the fall-through path).
  (fi : usize) = usize(0);
  while(fi < phi_names.len(), {
    fname := phi_names.get(fi).unwrap();
    pre_opt := pre_vals.get(fi);
    base := match(
      arm_states.get(last_live),
      .Some(last_state) => match(
        last_state.get(fname.clone()),
        .Some(v) => v,
        .None => match(
          pre_opt,
          .Some(pv) => match(
            pv,
            .Some(pv2) => pv2,
            .None => VcTerm.BoolLit(true)
          ),
          .None => VcTerm.BoolLit(true)
        )
      ),
      .None => VcTerm.BoolLit(true)
    );
    phi_cell := box(base);
    (fj : usize) = last_live;
    while(true, {
      if(fj == usize(0), {
        break;
      });
      fj = (fj - usize(1));
      arm_dead := match(
        dead_flags.get(fj),
        .Some(df) => df,
        .None => false
      );
      if(arm_dead, {
        // Skip to the next lower index without folding this arm.
        continue;
      });
      arm_v := match(
        arm_states.get(fj),
        .Some(st) => match(
          st.get(fname.clone()),
          .Some(v) => v,
          .None => match(
            pre_opt,
            .Some(pv) => match(
              pv,
              .Some(pv2) => pv2,
              .None => phi_cell.*
            ),
            .None => phi_cell.*
          )
        ),
        .None => phi_cell.*
      );
      ite_a := ArrayList(VcTerm).new();
      ite_a.push(conds.get(fj).unwrap());
      ite_a.push(arm_v);
      ite_a.push(phi_cell.*);
      phi_cell.* = VcTerm.App(VcOp.IteOp, ite_a);
    });
    ctx.vars.insert(fname.clone(), phi_cell.*);
    fi = (fi + usize(1));
  });
  // Fold right: else = the last LIVE arm's value; each earlier live arm
  // ites on its condition (dead arms are skipped — their guards cannot
  // hold on the fall-through path). VcTerm is a ref enum, so the folded
  // cell is written through a pointer.
  acc := vals.get(last_live).unwrap();
  acc_cell := box(acc);
  (j : usize) = last_live;
  while(true, {
    if(j == usize(0), {
      break;
    });
    j = (j - usize(1));
    arm_dead2 := match(
      dead_flags.get(j),
      .Some(df2) => df2,
      .None => false
    );
    if(arm_dead2, {
      continue;
    });
    c := conds.get(j).unwrap();
    v := vals.get(j).unwrap();
    ite_args := ArrayList(VcTerm).new();
    ite_args.push(c);
    ite_args.push(v);
    ite_args.push(acc_cell.*);
    acc_cell.* = VcTerm.App(VcOp.IteOp, ite_args);
  });
  Option(VcTerm).Some(acc_cell.*)
});
/// begin block: sequence statements; `name := expr` binds; the LAST expr is
/// the value.
/// The first argument's name when it is a plain atom.
_atom_arg_name :: (fn(args : ArrayList(AstExpr)) -> Option(String))(
  match(
    args.get(usize(0)),
    .Some(first) => cond(
      ast_expr_is_atom(first) => Option(String).Some(ast_expr_token(first).value),
      true => Option(String).None
    ),
    .None => Option(String).None
  )
);
/// A `(name : T)` lhs's name: the `:`-call's first argument.
_typed_binding_lhs_name :: (fn(lhs : AstExpr) -> Option(String))(
  match(
    lhs,
    .FnCall(_, _, la, _, _) => _atom_arg_name(la),
    .Atom(_, _) => Option(String).None
  )
);
/// The name a binding statement binds: `x := v` / `x = v` (Atom lhs) or
/// the declared form `(x : T) = v` (`:`-call lhs). `.None` for anything
/// else (field writes, index writes — outside the V3 subset).
_binding_name_of :: (fn(lhs : AstExpr) -> Option(String))(
  cond(
    ast_expr_is_atom(lhs) => Option(String).Some(ast_expr_token(lhs).value),
    ast_expr_is_fn_call_of(lhs, ":", Option(usize).Some(usize(2))) => _typed_binding_lhs_name(lhs),
    true => Option(String).None
  )
);
/// The `()` unit literal — the parser's trailing element of blocks that
/// end in a statement (parser.yo's make_unit_call: a zero-arg `tuple`
/// call).
_is_unit_lit :: (fn(e : AstExpr) -> bool)(
  match(
    e,
    .Atom(_, at) => (at.value == "()"),
    .FnCall(_, f, a, _, _) => ((ast_expr_token(f).value == BK_TUPLE) && (a.len() == usize(0)))
  )
);
_begin_term :: (fn(inout(ctx) : VcCtx, args : ArrayList(AstExpr)) -> Option(VcTerm))({
  (i : usize) = usize(0);
  result := Option(VcTerm).None;
  while(i < args.len(), {
    stmt := args.get(i).unwrap();
    // A prior statement exited the loop (break/continue): everything
    // after it in this block is dead — stop walking.
    if(ctx.path_dead, {
      break;
    });
    // `break`/`continue` as STATEMENTS (V4.2): break snapshots the state
    // as an exit disjunct; continue proves the invariant (and measure
    // step) at the statement — the head is reached from exactly here.
    // Both kill the rest of the block.
    if(_is_break_stmt(stmt), {
      if(ctx.loop_depth == usize(0), {
        _fail_subset(ctx, String.from("break outside a loop"), stmt);
        return(Option(VcTerm).None);
      });
      _record_break_site(ctx);
      ctx.path_dead = true;
      result = Option(VcTerm).Some(VcTerm.BoolLit(true));
      break;
    });
    if(_is_continue_stmt(stmt), {
      if(ctx.loop_depth == usize(0), {
        _fail_subset(ctx, String.from("continue outside a loop"), stmt);
        return(Option(VcTerm).None);
      });
      if(!_continue_obligations(ctx, stmt), {
        return(Option(VcTerm).None);
      });
      ctx.path_dead = true;
      result = Option(VcTerm).Some(VcTerm.BoolLit(true));
      break;
    });
    // Bindings: `name := value` and `name = value` / `(name : T) = value`.
    // A reassignment is an SSA REBIND of the same source name — sound for
    // straight-line code (the old term is simply shadowed); mutation-based
    // two-state reasoning is V5. Non-name assignments (field/index writes)
    // are outside the subset.
    is_bind := ast_expr_is_fn_call_of(stmt, ":=", Option(usize).Some(usize(2)));
    is_assign := ast_expr_is_fn_call_of(stmt, "=", Option(usize).Some(usize(2)));
    if(is_bind || is_assign, {
      ba := match(
        stmt,
        .FnCall(_, _, a2, _, _) => a2,
        .Atom(_, _) => ArrayList(AstExpr).new()
      );
      match(
        _binding_name_of(ba.get(usize(0)).unwrap()),
        .Some(name) => {
          v := _expr_term(ctx, ba.get(usize(1)).unwrap());
          match(
            v,
            .Some(vt) => {
              ctx.vars.insert(name.clone(), vt);
              result = Option(VcTerm).Some(vt);
            },
            .None => {
              return(Option(VcTerm).None);
            }
          );
        },
        .None => {
          _fail_subset(ctx, String.from("assignment to a non-name (field/index writes are outside the V3 subset)"), stmt);
          return(Option(VcTerm).None);
        }
      );
    }, {
      // The parser appends a trailing `()` to statement-final blocks — a
      // block ending in a statement (the while-body shape) carries it.
      if(_is_unit_lit(stmt), {
        result = Option(VcTerm).Some(VcTerm.BoolLit(true));
      }, {
        v := _expr_term(ctx, stmt);
        match(
          v,
          .Some(vt) => {
            result = Option(VcTerm).Some(vt);
          },
          .None => {
            return(Option(VcTerm).None);
          }
        );
      });
    });
    i = (i + usize(1));
  });
  result
});
/// Calls to a contracted callee: prove requires under the caller path,
/// then assume ensures with a fresh result var bound.
_callee_call_term :: (
  fn(inout(ctx) : VcCtx, e : AstExpr, args : ArrayList(AstExpr), info : ExprInfo)
  -> Option(VcTerm)
)({
  // The callee's FuncVal rides the callee atom's ExprInfo.
  callee_atom := match(
    e,
    .FnCall(_, f, _, _, _) => f,
    .Atom(_, _) => e
  );
  callee_id := match(
    expr_info_table_get(ctx.table, ast_expr_id(callee_atom)),
    .Some(ci) => match(
      ci.value,
      .Some(v) => match(
        v,
        .FuncVal(fvd, _) => Option(String).Some(fvd.*.func_id.clone()),
        _ => Option(String).None
      ),
      .None => Option(String).None
    ),
    .None => Option(String).None
  );
  if(callee_id.is_none(), {
    _fail_subset(ctx, String.from("call to an uncontracted, untyped callee"), e);
    return(Option(VcTerm).None);
  });
  fid := callee_id.unwrap();
  // Recursion (V4): a self-call needs `decreases(M)`. The measure of the
  // CURRENT state is captured BEFORE the param rebinding; after the
  // rebinding (callee params = actual terms) the measure evaluates as the
  // ACTUALS' measure, and the call proves M(actuals) < M(current) — the
  // well-foundedness step that makes the ensures-assume below sound.
  m_current := Option(VcTerm).None;
  if((fid == ctx.func_id) && ctx.decreases.is_some(), {
    m_current = _expr_term(ctx, ctx.decreases.unwrap());
  });
  if((fid == ctx.func_id) && m_current.is_none(), {
    _fail_subset(ctx, String.from("recursion (requires decreases(...) in the signature)"), e);
    return(Option(VcTerm).None);
  });
  reqs := get_func_requires_exprs(fid.clone());
  enss := get_func_ensures_exprs(fid.clone());
  if((reqs.len() == usize(0)) && (enss.len() == usize(0)), {
    // No contracts: the plan's case 3 — result unconstrained beyond type.
    _fail_subset(ctx, String.from("call to a callee without contracts"), e);
    return(Option(VcTerm).None);
  });
  // Evaluate the argument terms FIRST (a failure aborts the call), then
  // prove each requires under the caller path. V3 note: requires/ensures
  // predicates are evaluated in the CALLER's scope; substituting callee
  // param names with caller argument terms happens via ctx.vars rebinding
  // keyed by the callee's param labels (FuncValData.params order). The
  // rebindings (plus the callee's return-label binding, below) are SAVED
  // and restored after the call — the caller's own bindings must survive.
  callee_params := match(
    expr_info_table_get(ctx.table, ast_expr_id(callee_atom)),
    .Some(ci2) => match(
      ci2.value,
      .Some(v2) => match(
        v2,
        .FuncVal(fvd2, _) => fvd2.*.params,
        _ => ArrayList(String).new()
      ),
      .None => ArrayList(String).new()
    ),
    .None => ArrayList(String).new()
  );
  saved_names := ArrayList(String).new();
  saved_vals := ArrayList(Option(VcTerm)).new();
  (i : usize) = usize(0);
  while(i < args.len(), {
    match(
      args.get(i),
      .Some(a) => {
        v := _expr_term(ctx, a);
        match(
          v,
          .Some(vt) => {
            match(
              callee_params.get(i),
              .Some(cp) => {
                saved_names.push(cp.clone());
                saved_vals.push(ctx.vars.get(cp.clone()));
                ctx.vars.insert(cp.clone(), vt);
              },
              .None => ()
            );
          },
          .None => {
            return(Option(VcTerm).None);
          }
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  if((fid == ctx.func_id) && m_current.is_some(), {
    m_actual := _expr_term(ctx, ctx.decreases.unwrap());
    match(
      m_actual,
      .Some(ma) => {
        _emit(ctx, String.from("decreases-step"), ArrayList(VcTerm).new(), _app2(VcOp.BvSlt, ma, m_current.unwrap()));
      },
      .None => ()
    );
  });
  (ri : usize) = usize(0);
  while(ri < reqs.len(), {
    match(
      reqs.get(ri),
      .Some(req) => {
        rt := _expr_term(ctx, req);
        match(
          rt,
          .Some(rtt) => {
            _emit(ctx, `requires#${ri.to_string()}`, ArrayList(VcTerm).new(), rtt);
          },
          .None => ()
        );
      },
      .None => ()
    );
    ri = (ri + usize(1));
  });
  // Assume ensures with a fresh result bound. The callee's ensures name
  // the return value through ITS return label (V1 decision D3) — bind that
  // label to the fresh result var while the predicates are evaluated.
  ret_sort := match(
    _type_sort(info.ty),
    .Some(s) => s,
    .None => VcSort.BoolS
  );
  fresh_idx := _next_fresh(ctx);
  ret_name := `__ret_${fresh_idx.to_string()}`;
  ret_var := VcTerm.Var(name : ret_name.clone(), sort : ret_sort);
  ctx.vars.insert(ret_name.clone(), ret_var);
  callee_label := get_func_return_label(fid.clone());
  match(
    callee_label,
    .Some(cl) => {
      saved_names.push(cl.clone());
      saved_vals.push(ctx.vars.get(cl.clone()));
      ctx.vars.insert(cl.clone(), ret_var);
    },
    .None => ()
  );
  (ei : usize) = usize(0);
  while(ei < enss.len(), {
    match(
      enss.get(ei),
      .Some(ens) => {
        et := _expr_term(ctx, ens);
        match(
          et,
          .Some(ett) => {
            ctx.path.push(ett);
          },
          .None => {
            _fail_subset(ctx, String.from("callee ensures outside the subset (dropped assumption)"), ens);
          }
        );
      },
      .None => ()
    );
    ei = (ei + usize(1));
  });
  // Restore the caller's bindings (a missing binding goes back to missing).
  (si : usize) = saved_names.len();
  while(si > usize(0), {
    si = (si - usize(1));
    match(
      saved_names.get(si),
      .Some(sn) => {
        match(
          saved_vals.get(si),
          .Some(sv) => {
            match(
              sv,
              .Some(old) => {
                ctx.vars.insert(sn.clone(), old);
              },
              .None => {
                _ := ctx.vars.remove(sn.clone());
                ()
              }
            );
          },
          .None => ()
        );
      },
      .None => ()
    );
  });
  Option(VcTerm).Some(ret_var)
});
// ============================================================================
// Small term helpers
// ============================================================================
_nonzero_term :: (fn(t : VcTerm) -> VcTerm)(
  match(
    t,
    .BoolLit(_) => t,
    _ => {
      w := _term_width(t);
      vc_distinct(t, VcTerm.BvLit(value : u64(0), width : w))
    }
  )
);
_lt_unsigned_term :: (fn(a : VcTerm, b : VcTerm) -> VcTerm)(_app2(VcOp.BvUlt, a, b));
_term_width :: (fn(t : VcTerm) -> usize)(
  match(
    t,
    .Var(_, sort) => match(
      sort,
      .BvS(w) => w,
      _ => usize(1)
    ),
    .BvLit(_, w) => w,
    .BoolLit(_) => usize(1),
    .App(op, args) => match(
      args.get(usize(0)),
      .Some(a) => _term_width(a),
      .None => usize(1)
    ),
    .Ctor(_, _) => usize(1),
    .Test(_, _) => usize(1),
    .Proj(_, _, _) => usize(1),
    .Quant(_, _, _, _) => usize(1)
  )
);
// ============================================================================
// The per-function entry point
// ============================================================================
/// VerifyInput: everything the definition site knows.
VerifyFnInput :: ref(
  struct(
    fn_name : String,
    /// The FuncVal's `func_id` (recursion detection; the re-keyed
    /// contract side tables are readable under it).
    func_id : String,
    body : AstExpr,
    param_names : ArrayList(String),
    param_types : ArrayList(TypeValue),
    result_type : TypeValue,
    requires_exprs : ArrayList(AstExpr),
    ensures_exprs : ArrayList(AstExpr),
    /// Phase V4 `decreases(M)` termination measure (recursion).
    (decreases_expr : Option(AstExpr)) ?= Option(AstExpr).None,
    return_label : Option(String),
    table : ExprInfoTable
  )
);
/// Symbolically execute one function definition. Always returns a result —
/// subset violations land in `.error`, never thrown.
verify_function_body :: (fn(input : VerifyFnInput) -> VcBodyResult)({
  ctx := _new_vc_ctx(input.table, input.fn_name.clone(), input.func_id.clone());
  // Bind params as declared vars.
  (i : usize) = usize(0);
  while(i < input.param_names.len(), {
    match(
      input.param_names.get(i),
      .Some(pn) => {
        match(
          input.param_types.get(i),
          .Some(pt) => {
            match(
              _type_sort(pt),
              .Some(sort) => {
                ctx.vars.insert(pn.clone(), VcTerm.Var(name : pn.clone(), sort : sort));
              },
              .None => {
                _fail_subset(ctx, String.from("parameter outside the integer/bool subset"), input.body);
              }
            );
          },
          .None => ()
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  ctx.decreases = input.decreases_expr;
  // V5 two-state: snapshot the ENTRY state (params; module constants fold
  // into literals) — `old(e)` walks against this, never the live bindings.
  eit0 := ctx.vars.keys();
  (ego0 : bool) = true;
  while(ego0, {
    match(
      eit0.next(),
      .Some(ek0) => {
        match(
          ctx.vars.get(ek0.clone()),
          .Some(ev0) => {
            ctx.entry_vars.insert(ek0.clone(), ev0);
          },
          .None => ()
        );
      },
      .None => {
        ego0 = false;
      }
    );
  });
  // A body whose ROOT has no ExprInfo never completed its definition-time
  // evaluation (the trial swallowed the real error at load — E0902/E0401
  // class). Say THAT instead of the misleading "untyped expression".
  root_typed := match(
    expr_info_table_get(ctx.table, ast_expr_id(input.body)),
    .Some(_) => true,
    .None => false
  );
  if(!root_typed, {
    _fail_subset(
      ctx,
      String.from("the body's definition-time evaluation did not complete (its error was swallowed at load — run yo check on the file for the underlying cause)"),
      input.body
    );
  });
  // Callee-side: ASSUME the requires.
  (ri : usize) = usize(0);
  while(ri < input.requires_exprs.len(), {
    match(
      input.requires_exprs.get(ri),
      .Some(r) => {
        rt := _expr_term(ctx, r);
        match(
          rt,
          .Some(rtt) => {
            ctx.path.push(rtt);
          },
          .None => ()
        );
      },
      .None => ()
    );
    ri = (ri + usize(1));
  });
  // V4 termination: with a `decreases(M)` measure, prove M >= 0 on entry
  // (the well-foundedness ground for every recursive call's decrease) —
  // under the assumed requires, where it is actually provable.
  match(
    ctx.decreases,
    .Some(dm) => {
      m := _expr_term(ctx, dm);
      match(
        m,
        .Some(mt) => {
          zero := VcTerm.BvLit(value : u64(0), width : _term_width(mt));
          _emit(ctx, String.from("decreases-nonneg"), ArrayList(VcTerm).new(), _app2(VcOp.BvSge, mt, zero));
        },
        .None => ()
      );
    },
    .None => ()
  );
  // Bind the return label to the body value; then prove each ensures.
  body_val := if(
    !root_typed,
    Option(VcTerm).None,
    _expr_term(ctx, input.body)
  );
  match(
    body_val,
    .Some(bv) => {
      match(
        input.return_label,
        .Some(lbl) => {
          ctx.vars.insert(lbl.clone(), bv);
        },
        .None => ()
      );
      (ei : usize) = usize(0);
      while(ei < input.ensures_exprs.len(), {
        match(
          input.ensures_exprs.get(ei),
          .Some(ens) => {
            et := _expr_term(ctx, ens);
            match(
              et,
              .Some(ett) => {
                _emit(ctx, `ensures#${ei.to_string()}`, ArrayList(VcTerm).new(), ett);
              },
              .None => ()
            );
          },
          .None => ()
        );
        ei = (ei + usize(1));
      });
    },
    .None => ()
  );
  VcBodyResult(
    obligations : ctx.obligations,
    value : body_val,
    error : ctx.subset_error
  )
});
export(
  VcObligation,
  VcSubsetError,
  VcBodyResult,
  VerifyFnInput,
  verify_function_body
);
