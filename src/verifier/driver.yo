  verify_cache_key,
  verdict_of_response,
  run_vc_query,
  resolve_solver_sync,
  SolverResolution,
  verifier_harness_self_test,
  VerifyFnObligation,
  VerifyFnReport,
  verify_registered_functions,
  verify_and_strip_tasks,
  unmangle_for_display
);
