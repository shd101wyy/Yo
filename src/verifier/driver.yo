//! verifier/driver — scheduling, budgets, verdicts, caching (V2).
//!
//! The driver owns the per-obligation lifecycle: build the cache key
//! (sha256 of the query's SMT content + the solver binary's own
//! `--version` + the run options), look
//! the verdict up in `~/.cache/yo/verify-cache/<key>.json`, and only on a
//! miss spawn the solver. Cache hits are reported (`cached: proved`) so CI
//! logs stay honest. Any input change — predicate text, callee contract
//! set, solver binary, mode, options — invalidates the key. Only
//! reproducible verdicts are stored: sat, unsat, and an `unknown` whose
//! deterministic `:rlimit` ran out; a wall-clock timeout is asked again.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ StringBuilder } :: import("std/fmt");
{ ArrayList } :: import("std/collections/array_list");
{ env, home_dir } :: import("std/env");
{ Exception, IoExn } :: import("std/error");
json :: import("std/encoding/json");
{ JsonValue } :: import("std/encoding/json");
{ sha256_hex } :: import("std/crypto/sha256");
{ VcQuery, VcSort, VcTerm, VcTermNode, VcOp, new_vc_query, vc_eq } :: import("./terms.yo");
{ encode_content, encode_script, encode_term, EncodeOptions, default_encode_options } :: import("./encode.yo");
{ VerifyFnInput, verify_function_body, register_recursion_cliques, register_frame_tasks, GuardSite } :: import("./vc.yo");
{ take_verify_tasks, VerifyTask, strip_proved_ensures_asserts, verify_task_def_eval_failure, ProvedGuardSite, record_proved_guard_site } :: import("../evaluator/builtins/contracts.yo");
{ get_current_target } :: import("../target.yo");
{
  ensure_z3,
  discover_z3,
  run_z3_script,
  parse_z3_sexprs,
  z3_check_sat_of,
  z3_error_before_verdict,
  z3_unsat_core_of,
  z3_value_pairs_of,
  z3_reason_unknown_of,
  z3_rlimit_used_of,
  z3_version_of_binary,
  _z3_exists_sync,
  _z3_read_file_sync,
  _z3_write_file_sync,
  _z3_ensure_dir_sync
} :: import("./z3.yo");
// ============================================================================
// Options & verdicts
// ============================================================================
/// Verification mode per the plan's pragma table (`runtime` default).
VerifyMode :: enum(
  /// Contracts lower to runtime asserts — today's behavior, no solver.
  Runtime,
  /// Proof obligations; refuted or unprovable ⇒ compile error.
  Verify,
  /// Flagship: prove when possible, fall back to runtime asserts.
  VerifyOrAssert
);
derive(VerifyMode, Copy, Clone);
/// Parse a `--verify-mode` spelling (`runtime` / `verify` / `verify+`).
verify_mode_of_string :: (fn(s : &String) -> Option(VerifyMode))(
  cond(
    (s == "runtime") => Option(VerifyMode).Some(VerifyMode.Runtime),
    (s == "verify") => Option(VerifyMode).Some(VerifyMode.Verify),
    (s == "verify+") => Option(VerifyMode).Some(VerifyMode.VerifyOrAssert),
    true => Option(VerifyMode).None
  )
);
/// Run configuration: budgets and overrides. Part of the cache key.
VerifyRunConfig :: struct(
  /// Solver binary override (`--solver-path`); `.None` = discover/install.
  solver_path : Option(String),
  /// Encode/run options (rlimit budget, seed, backstop, evidence).
  encode_opts : EncodeOptions,
  /// Skip the verification cache for this run (`--no-cache`).
  no_cache : bool,
  /// 5b Phase 2: also generate the elision-only obligations (`yo compile`
  /// when it records guard sites, `yo verify --elision`). Not part of the
  /// cache key: each obligation is its own query.
  (elision_obligations : bool) ?= false
);
/// Default run config: default encode options, no override, cache on.
default_verify_run_config :: (fn() -> VerifyRunConfig)(
  VerifyRunConfig(
    solver_path : Option(String).None,
    encode_opts : default_encode_options(),
    no_cache : false
  )
);
/// The verdict of one obligation.
VerifyVerdict :: enum(
  /// unsat — the goal holds under the assumptions. Carries the unsat
  /// core's clause names when available.
  Proved(core : ArrayList(String)),
  /// sat — the goal FAILS; the counter-example names the inputs.
  Refuted(counterexample : ArrayList(String)),
  /// unknown / budget exhausted — nothing concluded.
  Unproven(reason : String),
  /// The solver could not be run at all (missing, crashed).
  SolverError(message : String)
);
// B4-1b: the verdict payloads are plain lists/strings; derived so report
// copies and b4-1a's deferred sites can spell `.clone()`.
derive(VerifyVerdict, Clone);
/// One obligation result: what was asked and what came back.
VerifyResult :: struct(
  query_name : String,
  verdict : VerifyVerdict,
  /// `true` when the verdict came from the cache, not the solver.
  cached : bool
);
// ============================================================================
// JSON helpers
// ============================================================================
/// A two-key JSON object.
_json_obj2 :: (fn(k1 : &String, v1 : &JsonValue, k2 : &String, v2 : &JsonValue) -> JsonValue)({
  ks := ArrayList(String).new();
  ks.push(k1.clone());
  ks.push(k2.clone());
  vs := ArrayList(JsonValue).new();
  vs.push(v1.clone());
  vs.push(v2.clone());
  JsonValue.Object(keys : ks, values : vs)
});
/// A JSON array of strings.
_strs_to_json :: (fn(ss : &ArrayList(String)) -> JsonValue)({
  items := ArrayList(JsonValue).new();
  (i : usize) = usize(0);
  while(i < ss.len(), {
    match(
      ss.get_cloned(i),
      .Some(s) => {
        items.push(JsonValue.Str(s.clone()));
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  JsonValue.Array(items)
});
/// A `ArrayList(String)` out of a JSON array of strings (mismatched items
/// are skipped).
_strs_of_json :: (fn(j : &JsonValue) -> ArrayList(String))({
  out := ArrayList(String).new();
  match(
    j.as_array(),
    .Some(items) => {
      (i : usize) = usize(0);
      while(i < items.len(), {
        match(
          items.get_cloned(i),
          .Some(item) => {
            // Nested patterns do not parse — match twice.
            match(
              item,
              .Str(s) => {
                out.push(s.clone());
              },
              _ => ()
            );
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .None => ()
  );
  out
});
/// Serialize a verdict to the cache-file JSON shape.
_verdict_to_json :: (fn(v : &VerifyVerdict) -> JsonValue)(
  match(
    v,
    .Proved(core) => _json_obj2(
      String.from("verdict"),
      JsonValue.Str(String.from("proved")),
      String.from("core"),
      _strs_to_json(&core)
    ),
    .Refuted(ce) => _json_obj2(
      String.from("verdict"),
      JsonValue.Str(String.from("refuted")),
      String.from("counterexample"),
      _strs_to_json(&ce)
    ),
    .Unproven(reason) => _json_obj2(
      String.from("verdict"),
      JsonValue.Str(String.from("unproven")),
      String.from("reason"),
      JsonValue.Str(reason.clone())
    ),
    .SolverError(msg) => _json_obj2(
      String.from("verdict"),
      JsonValue.Str(String.from("solver-error")),
      String.from("message"),
      JsonValue.Str(msg.clone())
    )
  )
);
/// Parse a cached verdict back. Returns `.None` on any shape mismatch —
/// a corrupt cache entry is a miss, not an error.
_verdict_of_json :: (fn(v : &JsonValue) -> Option(VerifyVerdict))({
  // Nested patterns (`.Some(.Str(s))`) do not parse — match twice, and arm
  // bodies nest their match DIRECTLY (a `{ match(...); }` block would make
  // the arm's value unit).
  kind := match(
    v.get(String.from("verdict")),
    .Some(.Str(s)) => s.clone(),
    .Some(_) => String.new(),
    .None => String.new()
  );
  if(kind.len() == usize(0), {
    return(Option(VerifyVerdict).None);
  });
  cond(
    (kind == "proved") => match(
      v.get(String.from("core")),
      .Some(core_json) => Option(VerifyVerdict).Some(VerifyVerdict.Proved(_strs_of_json(&core_json))),
      .None => Option(VerifyVerdict).Some(VerifyVerdict.Proved(ArrayList(String).new()))
    ),
    (kind == "refuted") => match(
      v.get(String.from("counterexample")),
      .Some(ce_json) => Option(VerifyVerdict).Some(VerifyVerdict.Refuted(_strs_of_json(&ce_json))),
      .None => Option(VerifyVerdict).None
    ),
    (kind == "unproven") => match(
      v.get(String.from("reason")),
      .Some(.Str(r)) => Option(VerifyVerdict).Some(VerifyVerdict.Unproven(r.clone())),
      .Some(_) => Option(VerifyVerdict).None,
      .None => Option(VerifyVerdict).None
    ),
    (kind == "solver-error") => match(
      v.get(String.from("message")),
      .Some(.Str(m)) => Option(VerifyVerdict).Some(VerifyVerdict.SolverError(m.clone())),
      .Some(_) => Option(VerifyVerdict).None,
      .None => Option(VerifyVerdict).None
    ),
    true => Option(VerifyVerdict).None
  )
});
// ============================================================================
// Cache
// ============================================================================
/// The verification cache directory.
verify_cache_dir :: (fn() -> String)({
  root := match(
    env.get(String.from("YO_CACHE_DIR")),
    .Some(d) => d,
    .None => match(
      env.get(String.from("XDG_CACHE_HOME")),
      .Some(d) => d.concat(String.from("/yo")),
      .None => match(
        home_dir(),
        .Some(h) => h.concat(String.from("/.cache/yo")),
        .None => String.from(".yo-cache")
      )
    )
  );
  `${root}/verify-cache`
});
/// The cache key: sha256 of (solver identity, run options, query content).
/// All inputs are text; each part is newline-terminated so the
/// concatenation is unambiguous.
/// Bump when the verifier's encoding or verdict semantics change in a way
/// the query content does not capture, so no cached verdict from the old
/// semantics is reused. 2 (2026-09-28): `usize`/`isize` widths follow the
/// target, guard obligations carry their site in the query name, and stores
/// key by the run's own budget. 3 (2026-11-04): the key names the solver
/// binary that ran (its `--version`), not the `Z3_VERSION` pin, and a
/// wall-clock `unknown` is no longer stored; epoch-2 entries may hold one.
VERIFIER_CACHE_EPOCH :: "3";
/// `solver` is the running binary's identity (`z3_version_of_binary`):
/// `YO_Z3_PATH` and `--solver-path` accept any z3, and a verdict one solver
/// computed must not answer for another.
verify_cache_key :: (fn(q : &VcQuery, cfg : &VerifyRunConfig, solver : &String) -> String)({
  material := StringBuilder.new();
  material.write_string(`epoch=${VERIFIER_CACHE_EPOCH}\n`);
  material.write_string(`solver=${solver}\n`);
  material.write_string(`rlimit=${cfg.encode_opts.rlimit.to_string()}\n`);
  material.write_string(`seed=${cfg.encode_opts.random_seed.to_string()}\n`);
  material.write_string(`timeout=${cfg.encode_opts.timeout_ms.to_string()}\n`);
  material.write_string(encode_content(q));
  sha256_hex(material.to_string().to_bytes())
});
// ============================================================================
// Running one obligation
// ============================================================================
/// Interpret a raw solver response stream into a verdict (pure — the
/// unit-testable seam between the harness and the protocol).
verdict_of_response :: (fn(response : &String) -> VerifyVerdict)({
  forms := parse_z3_sexprs(response);
  // A script z3 rejected before answering is a solver error whatever the
  // verdict token after the errors says (the `sat` of an empty assertion
  // set read as a refutation with an empty model — the R1 datatype bug).
  match(
    z3_error_before_verdict(&forms),
    .Some(err) => {
      return(VerifyVerdict.SolverError(`z3 rejected the script: ${err}`));
    },
    .None => ()
  );
  match(
    z3_check_sat_of(&forms),
    .Some(v) => cond(
      (v == "unsat") => VerifyVerdict.Proved(z3_unsat_core_of(&forms)),
      (v == "sat") => VerifyVerdict.Refuted(z3_value_pairs_of(&forms)),
      true => match(
        z3_reason_unknown_of(&forms),
        .Some(why) => VerifyVerdict.Unproven(`${v}: ${why}`),
        .None => VerifyVerdict.Unproven(v)
      )
    ),
    .None => VerifyVerdict.SolverError(response.trim())
  )
});
/// Cache lookup for one obligation: `.Some(result)` on a hit, `.None` on
/// miss/no-cache/corrupt entry. Synchronous (see the z3.yo header note).
_cache_lookup :: (fn(q : &VcQuery, cfg : &VerifyRunConfig, solver : &String) -> Option(VerifyResult))({
  if(cfg.no_cache, {
    return(Option(VerifyResult).None);
  });
  key := verify_cache_key(q, cfg, solver);
  cache_path := `${verify_cache_dir()}/${key}.json`;
  match(
    _z3_read_file_sync(cache_path.clone()),
    .None => Option(VerifyResult).None,
    .Some(content) => match(
      json.parse_string(&content),
      // The store's shape is {query, verdict: {...}} — unwrap the verdict
      // member before parsing it. A corrupt cache entry is a MISS, not an
      // error — the store overwrites.
      .Ok(j) => match(
        j.get(String.from("verdict")),
        .Some(vj) => match(
          _verdict_of_json(&vj),
          .Some(v) => Option(VerifyResult).Some(VerifyResult(query_name : q.name.clone(), verdict : v, cached : true)),
          .None => Option(VerifyResult).None
        ),
        .None => Option(VerifyResult).None
      ),
      .Err(_) => Option(VerifyResult).None
    )
  )
});
/// Cache store for one obligation. The caller stores only a cacheable
/// answer (`SolverAnswer.cacheable`): never a SolverError (missing/crashed
/// solver) nor a wall-clock `unknown`, which must retry on the next run.
/// Keyed by the run's own `cfg`, the same key `_cache_lookup` reads. Keying
/// by the default config stored a `--rlimit N` verdict where a later
/// default-budget run would reuse a verdict it could not reproduce itself.
_cache_store :: (fn(q : &VcQuery, cfg : &VerifyRunConfig, solver : &String, verdict : &VerifyVerdict) -> unit)({
  _z3_ensure_dir_sync(verify_cache_dir());
  key := verify_cache_key(q, cfg, solver);
  cache_path := `${verify_cache_dir()}/${key}.json`;
  payload := _json_obj2(
    String.from("query"),
    JsonValue.Str(q.name.clone()),
    String.from("verdict"),
    _verdict_to_json(verdict)
  );
  _z3_write_file_sync(cache_path.clone(), json.stringify(&payload));
  ()
});
/// One solver answer: the verdict, and whether the cache may keep it.
SolverAnswer :: struct(verdict : VerifyVerdict, cacheable : bool);
/// The store predicate over one raw solver response, run under the budget
/// `opts` set (pure — the unit-testable seam beside `verdict_of_response`).
/// sat and unsat are conclusive and cache. An `unknown` caches only when the
/// deterministic `:rlimit` ran out: the `(get-info :rlimit)` count reached
/// the budget and z3 did not name the clock. Then the same solver, query,
/// seed and budget answer `unknown` again. When the wall-clock `:timeout`
/// backstop fired first (z3 says `timeout`, or `canceled` with budget left)
/// the verdict depends on machine load, so it is reported as a wall-clock
/// timeout and asked again on the next run: only conclusive results are
/// cached (SPARK UG §7.3.6;
/// issues/fixed/2026-11-04-the-verify-cache-stores-wall-clock-unknown-verdicts-and-keys-on-the-pinned-z3-version-not-the-binary.md).
/// Any other `unknown` (incompleteness, no reason or count reported) and
/// every SolverError are not stored either.
solver_answer_of_response :: (fn(response : &String, opts : &EncodeOptions) -> SolverAnswer)({
  verdict := verdict_of_response(response);
  is_unknown := match(&verdict, .Unproven(_) => true, _ => false);
  if(!is_unknown, {
    conclusive := match(&verdict, .SolverError(_) => false, _ => true);
    return(SolverAnswer(verdict : verdict, cacheable : conclusive));
  });
  forms := parse_z3_sexprs(response);
  reason := match(z3_reason_unknown_of(&forms), .Some(r) => r, .None => String.new());
  used := z3_rlimit_used_of(&forms);
  budget := opts.rlimit;
  budget_ran_out := match(used, .Some(n) => (n >= budget), .None => false);
  budget_left := match(used, .Some(n) => (n < budget), .None => false);
  used_text := match(used, .Some(n) => n.to_string(), .None => String.from("?"));
  wall_clock := ((reason == "timeout") || ((reason == "canceled") && budget_left));
  cond(
    wall_clock => SolverAnswer(
      verdict : VerifyVerdict.Unproven(
        `unknown: wall-clock timeout (the ${opts.timeout_ms.to_string()} ms backstop fired after rlimit ${used_text} of ${budget.to_string()}); not cached`
      ),
      cacheable : false
    ),
    budget_ran_out => SolverAnswer(
      verdict : VerifyVerdict.Unproven(`unknown: rlimit exhausted (${used_text} of ${budget.to_string()})`),
      cacheable : true
    ),
    true => SolverAnswer(verdict : verdict, cacheable : false)
  )
});
/// Spawn the solver on `q` under `opts` and read its answer.
_solve :: (fn(q : &VcQuery, opts : EncodeOptions, binary : &String) -> SolverAnswer)({
  script := encode_script(q, opts);
  match(
    run_z3_script(binary.clone(), &script),
    .Ok(response) => solver_answer_of_response(&response, &opts),
    .Err(msg) => SolverAnswer(verdict : VerifyVerdict.SolverError(msg), cacheable : false)
  )
});
/// The last binary `_solver_identity` probed, and its identity.
(mut(g_solver_identity_binary) : Option(String)) = Option(String).None;
(mut(g_solver_identity) : Option(String)) = Option(String).None;
/// The cache's name for the solver at `binary`: its own `--version` output,
/// probed once per process per binary (one extra spawn per run, not per
/// query). `.None` when the binary cannot say what it is; the caller then
/// neither reads nor writes the cache.
_solver_identity :: (fn(binary : &String) -> Option(String))({
  probed := g_solver_identity_binary.clone();
  same := match(probed, .Some(b) => (b == binary.clone()), .None => false);
  if(same, {
    return(g_solver_identity.clone());
  });
  id := z3_version_of_binary(binary);
  g_solver_identity_binary = Option(String).Some(binary.clone());
  g_solver_identity = id.clone();
  id
});
/// Run one obligation end-to-end: cache lookup → solver → parse → cache
/// store. Synchronous — the solver spawn itself is libc `system(3)`
/// (z3.yo), so there is no event-loop interaction anywhere in the hot path.
///
/// Budget escalation (V5 task 6): a quantified goal the default budget
/// leaves Unproven gets ONE deterministic retry at 20× the rlimit and 4×
/// the wall backstop (fixed ladder — deterministic, and cheap queries
/// stay cheap; measured: the insertion sort's outer iterate needs
/// ~10⁸ rlimit / ~80 s and proves, while every small goal finishes far
/// under the first stage). The final stage's answer caches when
/// `solver_answer_of_response` calls it reproducible, under the key of the
/// solver that ran.
run_vc_query :: (fn(q : &VcQuery, cfg : &VerifyRunConfig, binary : &String) -> VerifyResult)({
  solver_id := if(cfg.no_cache, Option(String).None, _solver_identity(binary));
  match(
    solver_id.clone(),
    .Some(id) => match(
      _cache_lookup(q, cfg, &id),
      .Some(cached) => {
        return(cached);
      },
      .None => ()
    ),
    .None => ()
  );
  answer := _solve(q, cfg.encode_opts, binary);
  match(
    &answer.verdict,
    .Unproven(_) => {
      retry_opts := EncodeOptions(
        rlimit : (cfg.encode_opts.rlimit * usize(20)),
        random_seed : cfg.encode_opts.random_seed,
        timeout_ms : (cfg.encode_opts.timeout_ms * u64(4)),
        want_unsat_core : cfg.encode_opts.want_unsat_core,
        want_counterexample : cfg.encode_opts.want_counterexample
      );
      answer = _solve(q, retry_opts, binary);
    },
    _ => ()
  );
  match(
    solver_id,
    .Some(id) => {
      if(answer.cacheable, {
        _cache_store(q, cfg, &id, &answer.verdict);
      });
    },
    .None => ()
  );
  VerifyResult(query_name : q.name.clone(), verdict : answer.verdict.clone(), cached : false)
});
/// Outcome of the synchronous solver resolution.
SolverResolution :: enum(
  /// A usable binary path.
  Resolved(path : String),
  /// Nothing found — the caller may run the async one-time install
  /// (`ensure_z3`).
  Installable,
  /// An explicit `--solver-path` that does not exist (a hard error).
  InvalidPath(path : String)
);
/// Sync solver resolution: an explicit `--solver-path` is validated;
/// otherwise discovery. No event-loop interaction.
resolve_solver_sync :: (fn(cfg : &VerifyRunConfig) -> SolverResolution)(
  match(
    &cfg.solver_path,
    .Some(p) => if(
      _z3_exists_sync(p.clone()),
      SolverResolution.Resolved(path : p.clone()),
      SolverResolution.InvalidPath(path : p.clone())
    ),
    // `discover_z3` hands back the `YO_Z3_PATH` override as given, so check
    // it exists: a dangling override is `InvalidPath`, not a solver. As
    // `Resolved` it let a warm verify cache answer `proved` with no solver
    // present (issues/fixed/compile-missing-solver-handling-ignores-verify-plus-and-trusts-a-dangling-z3-path.md).
    .None => match(
      discover_z3(),
      .Some(p) => if(
        _z3_exists_sync(p.clone()),
        SolverResolution.Resolved(path : p),
        SolverResolution.InvalidPath(path : p)
      ),
      .None => SolverResolution.Installable
    )
  )
);
// ============================================================================
// Harness self-test (V2): the two canonical obligations
// ============================================================================
/// The self-test assumption `x == (bvadd 1 1)` over a fresh 32-bit x.
_self_test_sum_assumption :: (fn() -> VcTerm)({
  eq_args := ArrayList(VcTerm).new();
  eq_args.push(Rc.new(VcTermNode.Var(name : String.from("x"), sort : VcSort.BvS(width : usize(32)))));
  add_args := ArrayList(VcTerm).new();
  add_args.push(Rc.new(VcTermNode.BvLit(value : u64(1), width : usize(32))));
  add_args.push(Rc.new(VcTermNode.BvLit(value : u64(1), width : usize(32))));
  eq_args.push(Rc.new(VcTermNode.App(VcOp.BvAdd, add_args)));
  Rc.new(VcTermNode.App(VcOp.EqOp, eq_args))
});
/// Build one self-test obligation: `x := 1+1 ⊢ x == goal_val`.
_self_test_query :: (fn(name : &String, goal_val : u64) -> VcQuery)({
  q := new_vc_query(name);
  q.declare(String.from("x"), VcSort.BvS(width : usize(32)));
  q.assume(_self_test_sum_assumption());
  q.goal = vc_eq(
    Rc.new(VcTermNode.Var(name : String.from("x"), sort : VcSort.BvS(width : usize(32)))),
    Rc.new(VcTermNode.BvLit(value : goal_val, width : usize(32)))
  );
  q
});
/// The harness self-test obligations (plan V2 task 6): `1+1==2` must prove
/// (unsat) and `1+1==3` must refute with a concrete counter-example (sat +
/// model). They exercise the full encode → spawn → parse → cache pipeline
/// with zero language surface.
verifier_harness_self_test :: (fn(cfg : &VerifyRunConfig, binary : &String) -> ArrayList(VerifyResult))({
  results := ArrayList(VerifyResult).new();
  q1 := _self_test_query(String.from("self-test: one_plus_one_eq_2"), u64(2));
  results.push(run_vc_query(&q1, cfg, binary.clone()));
  q2 := _self_test_query(String.from("self-test: one_plus_one_eq_3"), u64(3));
  results.push(run_vc_query(&q2, cfg, binary.clone()));
  results
});
// ============================================================================
// The per-function verification pass (V3)
// ============================================================================
/// One obligation's outcome inside a function report.
VerifyFnObligation :: struct(
  name : String,
  verdict : VerifyVerdict,
  cached : bool,
  /// Discharged by the literal-construction CTFE folding in `_emit` —
  /// answered WITHOUT the cache → encode → solve pipeline, so summary
  /// telemetry counts it as `folded`, never as a solver `query`.
  (folded : bool) ?= false,
  /// The obligation's goal term rendered as SMT-LIB (`--explain`'s VC
  /// display; the JSON report's `goal` field). Empty only if the
  /// rendering was never requested.
  goal : String,
  /// The runtime guard this obligation discharges (`vc.yo`'s `GuardSite`);
  /// `.None` for contract, loop and assert obligations.
  (site : Option(GuardSite)) ?= Option(GuardSite).None,
  /// Proved with no unenforced assumption on its path (`VcObligation.elidable`).
  (elidable : bool) ?= false,
  /// Decides a guard only; never counts toward the outcome
  /// (`VcObligation.elision_only`).
  (elision_only : bool) ?= false
);
/// The verification report for one function.
VerifyFnReport :: struct(
  fn_id : String,
  /// "verify" | "verify+" (the mode the file resolved to).
  mode : String,
  /// "ok" | "refuted" | "unproven" | "solver-error" | "subset-error".
  outcome : String,
  obligations : ArrayList(VerifyFnObligation),
  /// Populated only for `outcome == "subset-error"`.
  subset_construct : String,
  subset_source : String
);
/// True when a report passed WITHOUT proving anything: outcome `ok` and an
/// empty obligation list means the body generated no obligation at all (no
/// index, no division, no shift, no assert, no contract), not that a proof
/// succeeded. Both renderers ask this one function so the text and the JSON
/// can never disagree, and so the self-verification ratchet
/// (plans/SELF_VERIFICATION.md) counts only functions that discharged
/// something. See
/// `issues/fixed/verify-ok-with-zero-obligations-is-indistinguishable-from-a-proof.md`.
verify_report_is_vacuous :: (fn(rp : &VerifyFnReport) -> bool)(
  (rp.outcome == "ok") && (verify_correctness_obligation_count(rp) == usize(0))
);
/// The obligations that count toward the outcome: every one but the 5b
/// elision-only ones, which decide a guard and nothing else.
verify_correctness_obligation_count :: (fn(rp : &VerifyFnReport) -> usize)({
  (n : usize) = usize(0);
  (i : usize) = usize(0);
  while(i < rp.obligations.len(), {
    if(!rp.obligations(i).elision_only, {
      n = (n + usize(1));
    });
    i = (i + usize(1));
  });
  n
});
/// The outcome vocabulary, in report order. `--deny` validates against this
/// and the usage error lists it, so the CLI can never drift from the set of
/// outcomes `verify_and_strip_tasks` actually produces.
verify_outcome_names :: (fn() -> ArrayList(String))({
  out := ArrayList(String).new();
  out.push(String.from("ok"));
  out.push(String.from("assumed"));
  out.push(String.from("outside-subset"));
  out.push(String.from("unproven"));
  out.push(String.from("refuted"));
  out.push(String.from("solver-error"));
  out.push(String.from("subset-error"));
  out
});
/// True when `name` is one of the outcomes above.
is_verify_outcome_name :: (fn(name : &String) -> bool)(
  _str_list_contains(verify_outcome_names(), name)
);
_str_list_contains :: (fn(xs : &ArrayList(String), needle : &String) -> bool)({
  (i : usize) = usize(0);
  while(i < xs.len(), {
    match(
      xs.get_cloned(i),
      .Some(x) => {
        if(x == needle, {
          return(true);
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  false
});
/// The outcomes that pass WITHOUT being denied: a proof, contracts the author
/// declared `assumed()`, and a contract-less body the walk could not enter
/// (infrastructure — nothing was promised). Everything else is a finding.
_verify_outcome_passes_by_default :: (fn(outcome : &String) -> bool)(
  (outcome == "ok") || (outcome == "assumed") || (outcome == "outside-subset")
);
/// Does this report FAIL the run, given the `--deny` set?
///
/// With an empty deny set this is exactly the historical rule: refuted always
/// fails, the other findings fail in `verify` and degrade to a runtime assert
/// in `verify+`, and the three outcomes above pass. `--deny` (and its alias
/// `--strict`) turns named outcomes into hard failures in EVERY mode — which
/// is the point of a laws gate: a run must not go green because every contract
/// was `assumed()` away
/// (plans/backlog/BEND_LAWS_AND_AGENT_LOOP_LESSONS.md §A1/B0).
verify_report_is_failure :: (fn(rp : &VerifyFnReport, denied : &ArrayList(String)) -> bool)({
  if(_str_list_contains(denied, rp.outcome.clone()), {
    return(true);
  });
  if(_verify_outcome_passes_by_default(rp.outcome.clone()), {
    return(false);
  });
  (rp.outcome == "refuted") || (rp.mode == "verify")
});
/// True when the report is a finding that `verify+` degraded to a runtime
/// assert rather than a failure — the case that prints the fallback note.
verify_report_is_degraded :: (fn(rp : &VerifyFnReport, denied : &ArrayList(String)) -> bool)(
  !verify_report_is_failure(rp, denied) && !_verify_outcome_passes_by_default(rp.outcome.clone())
);
/// Per-outcome counts over a report list, in `verify_outcome_names()` order,
/// plus the derived tallies the summary line prints. Counting lives here so
/// the text summary, the JSON summary and the self-verification sweep cannot
/// disagree about what a run contained.
VerifySummary :: struct(
  total : usize,
  /// Parallel to `verify_outcome_names()`.
  counts : ArrayList(usize),
  /// `ok` reports that discharged nothing (see `verify_report_is_vacuous`).
  vacuous : usize,
  /// Obligations put through the cache → encode → solve pipeline, and how
  /// many of those were answered from the verification cache.
  queries : usize,
  cached : usize,
  /// Obligations discharged by the literal-construction CTFE folding
  /// (`VcObligation.pre`) — never sent to the pipeline, so they are
  /// counted separately from `queries`: a fold-heavy run must not read
  /// as solver load.
  folded : usize
);
summarize_verify_reports :: (fn(reports : &ArrayList(VerifyFnReport)) -> VerifySummary)({
  names := verify_outcome_names();
  counts := ArrayList(usize).new();
  (ni : usize) = usize(0);
  while(ni < names.len(), {
    counts.push(usize(0));
    ni = (ni + usize(1));
  });
  (vacuous : usize) = usize(0);
  (queries : usize) = usize(0);
  (cached : usize) = usize(0);
  (folded : usize) = usize(0);
  for(&reports, rp => {
    (ci : usize) = usize(0);
    while(ci < names.len(), {
      match(
        names.get_cloned(ci),
        .Some(nm) => {
          if(nm == rp.outcome, {
            counts(ci) = (match(counts.get(ci), .Some(c) => c, .None => usize(0)) + usize(1));
          });
        },
        .None => ()
      );
      ci = (ci + usize(1));
    });
    if(verify_report_is_vacuous(&rp), {
      vacuous = (vacuous + usize(1));
    });
    for(&rp.obligations, obl => {
      if(obl.folded, {
        folded = (folded + usize(1));
      }, {
        queries = (queries + usize(1));
      });
      if(obl.cached, {
        cached = (cached + usize(1));
      });
    });
  });
  VerifySummary(
    total : reports.len(),
    counts : counts,
    vacuous : vacuous,
    queries : queries,
    cached : cached,
    folded : folded
  )
});
/// The count recorded for `outcome` in a summary ("" / unknown name -> 0).
verify_summary_count :: (fn(sum : &VerifySummary, outcome : &String) -> usize)({
  names := verify_outcome_names();
  (i : usize) = usize(0);
  while(i < names.len(), {
    match(
      names.get_cloned(i),
      .Some(nm) => {
        if(nm == outcome, {
          return(match(sum.counts.get(i), .Some(c) => c, .None => usize(0)));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  usize(0)
});
/// Verify every task the evaluator recorded (drains the registry). Each
/// task symbolically executes once (`verify_function_body`), then every
/// obligation runs through the same cache → encode → spawn → parse
/// pipeline as the self-test. Subset errors abort that function's
/// obligations list (there is nothing sound to check).
verify_registered_functions :: (fn(cfg : &VerifyRunConfig, binary : &String) -> ArrayList(VerifyFnReport))(
  verify_and_strip_tasks(cfg, binary, take_verify_tasks())
);
/// The per-ensures-index PROVED table for the strip pass, parsed from the
/// obligation names (`<fn_id>/ensures#N`). Indices beyond the parsed max
/// default to NOT proved (conservative: keep the assert).
_proved_ensures :: (fn(obligations : &ArrayList(VerifyFnObligation)) -> ArrayList(bool))({
  marks := ArrayList(bool).new();
  for(&obligations, obl => {
    match(
      &obl.verdict,
      .Proved(_) => {
        idx_opt := _ens_obligation_index(obl.name.clone());
        match(
          idx_opt,
          .Some(n) => {
            while(marks.len() <= n, {
              marks.push(false);
            });
            // ArrayList has no set(): write through the raw pointer
            // (the bounds were just established above).
            unsafe(((marks.ptr().unwrap()).add(n)).* = true);
          },
          .None => ()
        );
      },
      _ => ()
    );
  });
  marks
});
/// Parse the `N` of an obligation name ending in `/ensures#N` (`.None` for
/// every other obligation kind — caller-side requires, AoRTE, asserts).
_ens_obligation_index :: (fn(name : &String) -> Option(usize))({
  marker := String.from("/ensures#");
  match(
    name.index_of(marker.clone()),
    .Some(at) => {
      digits := name.substring(at + marker.len(), name.len());
      match(
        digits.parse_u64(),
        .Some(n) => Option(usize).Some(usize(n)),
        .None => Option(usize).None
      )
    },
    .None => Option(usize).None
  )
});
/// Verify an explicit task list (the check/compile integration drains
/// first to decide whether a solver is needed at all). `verify+` tasks
/// additionally get their PROVED `ensures` asserts stripped from the
/// function body (plan task 6): the report's verdicts index-map onto the
/// wrapper's splice order.
/// Record every guard these reports license codegen to remove
/// (plans/backlog/SAFE_MODE_5B_VERIFIED_GUARD_ELISION.md §5.1): the
/// function's outcome is `ok` (all-or-nothing, rule 2); the obligation is
/// `Proved`, folded proofs included (rule 1); it has a guard site and no
/// unenforced assumption on its path (rule 3); and the target's pointer width
/// is 64 (rule 4, conservative until the wasm32 twin case is validated).
/// Returns how many sites were recorded.
record_elidable_guard_sites :: (fn(reports : &ArrayList(VerifyFnReport)) -> usize)({
  if(get_current_target().pointer_size_bits != u32(64), {
    return(usize(0));
  });
  (n : usize) = usize(0);
  for(&reports, rp => {
    if(rp.outcome == "ok", {
      for(&rp.obligations, obl => {
        proved := match(&obl.verdict, .Proved(_) => true, _ => false);
        match(
          &obl.site,
          .Some(gs) => if(proved && obl.elidable, {
            record_proved_guard_site(ProvedGuardSite(node_id : gs.node_id, module : gs.module.clone(), row : gs.row, column : gs.column, class : gs.class.clone()));
            n = (n + usize(1));
          }),
          .None => ()
        );
      });
    });
  });
  n
});
verify_and_strip_tasks :: (
  fn(cfg : &VerifyRunConfig, binary : &String, tasks : &ArrayList(VerifyTask)) -> ArrayList(VerifyFnReport)
)({
  reports := ArrayList(VerifyFnReport).new();
  // V6 task 4: compute the batch's mutual-recursion cliques BEFORE the
  // first walk — the walk's clique-edge decrease obligation consults
  // them (see g_recursion_cliques in vc.yo).
  register_recursion_cliques(tasks);
  // The call-site frame classifies a verify-mode callee by its task's body.
  register_frame_tasks(tasks);
  (ti : usize) = usize(0);
  while(ti < tasks.len(), {
    match(
      tasks.get(ti),
      .Some(t) => {
        // V6 task 5: an `assumed()` fn — its contracts gate callers, its
        // body is outside the verifiable subset (raw pointers, allocator
        // calls). No walk: report the honest outcome and move on. This
        // fires BEFORE the def-eval-failure check on purpose — an assumed
        // DEFERRED (generic) body has no ExprInfo and no recorded trial
        // failure; that is expected, not a swallowed error.
        if(t.body_assumed, {
          reports.push(
            VerifyFnReport(
              fn_id : t.fn_id.clone(),
              mode : t.mode.clone(),
              outcome : String.from("assumed"),
              obligations : ArrayList(VerifyFnObligation).new(),
              subset_construct : String.from("contracts assumed — body outside the verifiable subset (assumed())"),
              subset_source : String.new()
            )
          );
          ti = (ti + usize(1));
          continue;
        });
        // V5 honest diagnostics: a body whose definition-time trial
        // SWALLOWED (E0902/E0401 class) reaches here hollow — report the
        // recorded CAUSE instead of walking into "untyped expression".
        // V6 task 5: on a CONTRACT-LESS fn (no requires/ensures/decreases,
        // not assumed) the subset failure degrades to the passing
        // `outside-subset` outcome — nothing was promised, the body is
        // infrastructure (raw pointers, allocator calls); the flagship
        // (AoRTE refutations on unannotated code) is unaffected: a walk
        // that REFUTES stays a refutation whatever the fn's contracts.
        contract_less := (
          (t.requires_exprs.len() == usize(0)) &&
            (t.ensures_exprs.len() == usize(0)) && t.decreases_expr.is_none()
        );
        degrade_outcome := cond(
          contract_less => String.from("outside-subset"),
          true => String.from("subset-error")
        );
        match(
          verify_task_def_eval_failure(t.fn_id.clone()),
          .Some(msg) => {
            reports.push(
              VerifyFnReport(
                fn_id : t.fn_id.clone(),
                mode : t.mode.clone(),
                outcome : degrade_outcome.clone(),
                obligations : ArrayList(VerifyFnObligation).new(),
                subset_construct : `body's definition-time evaluation failed (swallowed at load): ${msg}`,
                subset_source : String.new()
              )
            );
            ti = (ti + usize(1));
            continue;
          },
          .None => ()
        );
        input := VerifyFnInput(
          fn_name : t.fn_id.clone(),
          func_id : t.func_id.clone(),
          body : t.body.clone(),
          param_names : t.param_names.clone(),
          param_types : t.param_types.clone(),
          result_type : t.result_type.clone(),
          requires_exprs : t.requires_exprs.clone(),
          ensures_exprs : t.ensures_exprs.clone(),
          decreases_expr : t.decreases_expr.clone(),
          return_label : t.return_label.clone(),
          table : t.table.clone(),
          requires_enforced : t.requires_enforced.clone(),
          elision_obligations : cfg.elision_obligations,
          body_abstract : t.body_abstract
        );
        body_res := verify_function_body(&input);
        match(
          &body_res.error,
          .Some(err) => {
            reports.push(
              VerifyFnReport(
                fn_id : t.fn_id.clone(),
                mode : t.mode.clone(),
                outcome : degrade_outcome.clone(),
                obligations : ArrayList(VerifyFnObligation).new(),
                subset_construct : err.construct.clone(),
                subset_source : err.source.clone()
              )
            );
          },
          .None => {
            obligations := ArrayList(VerifyFnObligation).new();
            (worst : usize) = usize(0);
            for(&body_res.obligations, obl => {
              // Literal-construction CTFE folding: a pre-resolved
              // obligation skips the solver entirely (the verdict came
              // from constant folding, which is a proof).
              (pre_done : bool) = false;
              (pre_is_proved : bool) = false;
              match(
                obl.pre,
                .Some(pv) => {
                  pre_done = true;
                  match(
                    pv,
                    .PreProved => {
                      pre_is_proved = true;
                    },
                    .PreRefuted => ()
                  );
                },
                .None => ()
              );
              if(pre_done, {
                pre_verdict := if(
                  pre_is_proved,
                  VerifyVerdict.Proved(ArrayList(String).new()),
                  VerifyVerdict.Refuted(ArrayList(String).new())
                );
                obligations.push(
                  VerifyFnObligation(
                    name : obl.name.clone(),
                    verdict : pre_verdict,
                    cached : false,
                    folded : true,
                    goal : encode_term(&obl.query.goal),
                    site : obl.site.clone(),
                    elidable : obl.elidable,
                    elision_only : obl.elision_only
                  )
                );
                rank := if(pre_is_proved, usize(0), usize(3));
                if((rank > worst) && !obl.elision_only, {
                  worst = rank;
                });
              });
              if(!pre_done, {
                r := run_vc_query(&obl.query, cfg, binary.clone());
                // Counter-examples carry source names: unmangle the
                // model's `__yo_v<fn>_<name> = value` pairs against
                // this function's id at report-construction time, so
                // every consumer (text, JSON, tests) sees `x = ...`.
                clean_verdict := match(
                  &r.verdict,
                  .Refuted(ce) => VerifyVerdict.Refuted(_unmangle_pairs(t.fn_id.clone(), &ce)),
                  .Proved(core) => VerifyVerdict.Proved(core.clone()),
                  .Unproven(reason) => VerifyVerdict.Unproven(reason.clone()),
                  .SolverError(msg) => VerifyVerdict.SolverError(msg.clone())
                );
                obligations.push(
                  VerifyFnObligation(
                    name : r.query_name.clone(),
                    verdict : clean_verdict,
                    cached : r.cached,
                    goal : encode_term(&obl.query.goal),
                    site : obl.site.clone(),
                    elidable : obl.elidable,
                    elision_only : obl.elision_only
                  )
                );
                // 0 ok < 1 unproven < 2 solver-error < 3 refuted
                rank := match(
                  &r.verdict,
                  .Proved(_) => usize(0),
                  .Unproven(_) => usize(1),
                  .SolverError(_) => usize(2),
                  .Refuted(_) => usize(3)
                );
                if((rank > worst) && !obl.elision_only, {
                  worst = rank;
                });
              });
            });
            outcome := cond(
              (worst == usize(3)) => String.from("refuted"),
              (worst == usize(2)) => String.from("solver-error"),
              (worst == usize(1)) => String.from("unproven"),
              true => String.from("ok")
            );
            // verify+ strip pass: `ensures#N` obligations that PROVED have
            // their spliced asserts removed from the function body. A
            // REFUTED function never reaches here (it is a compile error at
            // the caller); unproven ones keep their asserts (the fallback).
            if(t.mode == "verify+", {
              strip_proved_ensures_asserts(&t.func_val, _proved_ensures(&obligations));
              ()
            });
            reports.push(
              VerifyFnReport(
                fn_id : t.fn_id.clone(),
                mode : t.mode.clone(),
                outcome : outcome,
                obligations : obligations,
                subset_construct : String.new(),
                subset_source : String.new()
              )
            );
          }
        );
      },
      .None => ()
    );
    ti = (ti + usize(1));
  });
  reports
});
/// Render a mangled SMT variable name back toward its source spelling for
/// display: `__yo_v<fn>_<name>` → `<name>` when the prefix matches this
/// function, else the raw mangled form (a cross-function name is still
/// informative).
unmangle_for_display :: (fn(fn_id : &String, mangled : &String) -> String)({
  prefix := `__yo_v${_sanitize_for_display(fn_id.clone())}_`;
  if(mangled.starts_with(prefix.clone()), {
    return(mangled.substring(prefix.len(), mangled.len()));
  });
  mangled.clone()
});
/// The fn_id → SMT-name sanitizer mirror (encode.yo's `_sanitize_smt_name`
/// is private to the encoder; this reproduces its exact rules —
/// [A-Za-z0-9_] kept, every other RUNE one underscore — for the
/// display-side prefix strip).
_sanitize_for_display :: (fn(s : &String) -> String)({
  sb := StringBuilder.new();
  {
    it := s.clone().chars();
    while(true, {
      r := match(it.next(), .Some(x) => x, .None => break);
      c := r.char;
      if(((c >= u32(0x41)) && (c <= u32(0x5A))) ||
        ((c >= u32(0x61)) && (c <= u32(0x7A))) ||
          ((c >= u32(0x30)) && (c <= u32(0x39))) || (c == u32(0x5F)), {
        sb.write_rune(r);
      }, {
        sb.write_byte(u8(0x5F));
      });
    });
  };
  sb.to_string()
});
/// Un-mangle counter-example pair strings (`mangled = value`) toward the
/// source spelling; unmatched shapes pass through untouched.
_unmangle_pairs :: (fn(fn_id : &String, ce : &ArrayList(String)) -> ArrayList(String))({
  out := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < ce.len(), {
    match(
      ce.get_cloned(i),
      .Some(pair) => {
        sep := pair.index_of(String.from(" = "));
        match(
          sep,
          .Some(at) => {
            mangled := pair.substring(usize(0), at);
            value := pair.substring(at + usize(3), pair.len());
            out.push(`${unmangle_for_display(fn_id.clone(), &mangled)} = ${value}`);
          },
          .None => {
            out.push(pair.clone());
          }
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});
export(
  VerifyMode,
  verify_mode_of_string,
  VerifyRunConfig,
  default_verify_run_config,
  VerifyVerdict,
  VerifyResult,
  verify_cache_dir,
  verify_cache_key,
  verdict_of_response,
  SolverAnswer,
  solver_answer_of_response,
  run_vc_query,
  resolve_solver_sync,
  SolverResolution,
  verifier_harness_self_test,
  VerifyFnObligation,
  VerifyFnReport,
  verify_report_is_vacuous,
  verify_correctness_obligation_count,
  verify_outcome_names,
  is_verify_outcome_name,
  verify_report_is_failure,
  verify_report_is_degraded,
  VerifySummary,
  summarize_verify_reports,
  verify_summary_count,
  verify_registered_functions,
  verify_and_strip_tasks,
  record_elidable_guard_sites,
  unmangle_for_display
);
