/// Target system for the Yo compiler.
///
/// Distinguishes between the host (machine running the compiler) and the target
/// (machine the compiled binary will run on).
///
/// Targets are named by their canonical Rust-style triple — the same strings
/// `rustc --target` takes and the same strings the release assets are named by:
///
///   <arch>-<vendor>-<os>[-<env>]      e.g. aarch64-apple-darwin,
///                                          x86_64-unknown-linux-gnu,
///                                          x86_64-pc-windows-msvc,
///                                          wasm32-unknown-emscripten
///   wasm32-wasip1                     (the one two-component form: WASI
///                                      preview 1, where Rust folds the
///                                      `p1` environment into the os word)
///
/// The vendor is determined by the OS (`apple` for darwin, `pc` for windows,
/// `unknown` otherwise) and the environment is REQUIRED where it disambiguates
/// an ABI (linux: gnu | musl, windows: msvc | gnu) and forbidden where the OS
/// has exactly one (darwin, freebsd, emscripten). There are no shorthands and
/// no aliases: an unknown spelling is an error that lists the supported set.
///
/// Two vocabularies live here, and they differ on purpose, exactly as Rust's
/// `cfg(target_os)` differs from its triples: the TRIPLE spells macOS as
/// `apple-darwin` and 32-bit x86 as `i686`, while the strings the comptime
/// `__yo_process_platform()` / `__yo_process_arch()` builtins return — matched
/// by `std/process`'s `Platform` / `Arch` enums — are the cfg names `macos` and
/// `x86`. `os_to_str` / `arch_to_str` give the cfg names; `os_triple_str` /
/// `arch_triple_str` give the triple words.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Path } :: import("std/path");
{ Exception, IoExn } :: import("std/error");
{ DirEntry, read_dir } :: import("std/fs/dir");
{ platform, Platform, arch, Arch : ProcessArch } :: import("std/process");
// ── Supported architectures ───────────────────────────────────────────
Arch :: enum(X86_64, Aarch64, X86, Arm, Wasm32);
derive(Arch, Eq(Arch));
// ── Supported operating systems ───────────────────────────────────────
Os :: enum(Linux, Macos, Windows, FreeBSD, Wasi, Emscripten);
derive(Os, Eq(Os));
// ── Supported environments (Rust's `target_env`) ──────────────────────
/// `P1` is WASI preview 1 — the `p1` of `wasm32-wasip1`.
Abi :: enum(Gnu, Musl, Msvc, P1);
derive(Abi, Eq(Abi));
// ── Target info ───────────────────────────────────────────────────────
TargetInfo :: ref(
  struct(
    arch : Arch,
    os : Os,
    abi : Option(Abi),
    pointer_size_bits : u32,
    /// The canonical triple, e.g. `aarch64-apple-darwin`. Always the
    /// normalized spelling, whatever the user typed.
    triple : String
  )
);
// ── Host info ─────────────────────────────────────────────────────────
HostInfo :: ref(
  struct(
    platform : Os,
    arch : Arch
  )
);
/// The complete list of supported targets, for error messages. Kept in the
/// order docs/en-US/BUILD_SYSTEM.md lists them.
SUPPORTED_TARGETS :: "x86_64-unknown-linux-gnu, x86_64-unknown-linux-musl, aarch64-unknown-linux-gnu, aarch64-unknown-linux-musl, aarch64-apple-darwin, x86_64-apple-darwin, x86_64-pc-windows-msvc, aarch64-pc-windows-msvc, x86_64-pc-windows-gnu, x86_64-unknown-freebsd, aarch64-unknown-freebsd, wasm32-wasip1, wasm32-unknown-emscripten";
// ── Enum ↔ string helpers ────────────────────────────────────────────
/// The cfg-style architecture name — what `__yo_process_arch()` returns and
/// what `std/process`'s `Arch` parses (`x86`, not `i686`).
arch_to_str :: (fn(a : Arch) -> str)(
  match(
    a,
    .X86_64 => "x86_64",
    .Aarch64 => "aarch64",
    .X86 => "x86",
    .Arm => "arm",
    .Wasm32 => "wasm32"
  )
);
/// The architecture word of the triple (`i686`, not `x86`).
arch_triple_str :: (fn(a : Arch) -> str)(
  match(
    a,
    .X86_64 => "x86_64",
    .Aarch64 => "aarch64",
    .X86 => "i686",
    .Arm => "arm",
    .Wasm32 => "wasm32"
  )
);
/// The cfg-style OS name — what `__yo_process_platform()` returns and what
/// `std/process`'s `Platform` parses (`macos`, not `darwin`).
os_to_str :: (fn(o : Os) -> str)(
  match(
    o,
    .Linux => "linux",
    .Macos => "macos",
    .Windows => "windows",
    .FreeBSD => "freebsd",
    .Wasi => "wasi",
    .Emscripten => "emscripten"
  )
);
/// The OS word of the triple (`darwin`, not `macos`; `wasip1` for WASI, where
/// the environment is folded into the word).
os_triple_str :: (fn(o : Os) -> str)(
  match(
    o,
    .Linux => "linux",
    .Macos => "darwin",
    .Windows => "windows",
    .FreeBSD => "freebsd",
    .Wasi => "wasip1",
    .Emscripten => "emscripten"
  )
);
/// The vendor word the triple carries for an OS. WASI has none — its triple
/// is the two-component `wasm32-wasip1`.
os_vendor_str :: (fn(o : Os) -> str)(
  match(
    o,
    .Linux => "unknown",
    .Macos => "apple",
    .Windows => "pc",
    .FreeBSD => "unknown",
    .Wasi => "",
    .Emscripten => "unknown"
  )
);
/// 1-to-1 alias of `os_to_str`. The Yo `__yo_process_platform()` builtin
/// returns one of these strings.
target_os_to_yo_string :: (fn(o : Os) -> str)(os_to_str(o));
/// 1-to-1 alias of `arch_to_str`. The Yo `__yo_process_arch()` builtin
/// returns one of these strings.
target_arch_to_yo_string :: (fn(a : Arch) -> str)(arch_to_str(a));
abi_to_str :: (fn(a : Abi) -> str)(
  match(
    a,
    .Gnu => "gnu",
    .Musl => "musl",
    .Msvc => "msvc",
    .P1 => "p1"
  )
);
/// Parse the architecture word of a triple.
parse_arch :: (fn(s : String) -> Option(Arch))(
  cond(
    (s == "x86_64") => Option(Arch).Some(Arch.X86_64),
    (s == "aarch64") => Option(Arch).Some(Arch.Aarch64),
    (s == "i686") => Option(Arch).Some(Arch.X86),
    (s == "arm") => Option(Arch).Some(Arch.Arm),
    (s == "wasm32") => Option(Arch).Some(Arch.Wasm32),
    true => Option(Arch).None
  )
);
/// Parse the OS word of a triple.
parse_os :: (fn(s : String) -> Option(Os))(
  cond(
    (s == "linux") => Option(Os).Some(Os.Linux),
    (s == "darwin") => Option(Os).Some(Os.Macos),
    (s == "windows") => Option(Os).Some(Os.Windows),
    (s == "freebsd") => Option(Os).Some(Os.FreeBSD),
    (s == "wasip1") => Option(Os).Some(Os.Wasi),
    (s == "emscripten") => Option(Os).Some(Os.Emscripten),
    true => Option(Os).None
  )
);
/// Parse the environment word of a triple.
parse_abi :: (fn(s : String) -> Option(Abi))(
  cond(
    (s == "gnu") => Option(Abi).Some(Abi.Gnu),
    (s == "musl") => Option(Abi).Some(Abi.Musl),
    (s == "msvc") => Option(Abi).Some(Abi.Msvc),
    (s == "p1") => Option(Abi).Some(Abi.P1),
    true => Option(Abi).None
  )
);
// ── Pointer size ──────────────────────────────────────────────────────
pointer_size_for_arch :: (fn(a : Arch) -> u32)(
  match(
    a,
    .X86_64 => u32(64),
    .Aarch64 => u32(64),
    .X86 => u32(32),
    .Arm => u32(32),
    .Wasm32 => u32(32)
  )
);
// ── Build TargetInfo ──────────────────────────────────────────────────
/// The canonical triple for (arch, os, env). Inverse of `parse_target`.
_build_triple :: (fn(a : Arch, o : Os, abi : Option(Abi)) -> String)({
  s := String.from(arch_triple_str(a));
  match(
    o,
    .Wasi => {
      // `wasm32-wasip1`: no vendor, and the environment IS the os word.
      s.push_str("-");
      s.push_str(os_triple_str(o));
    },
    _ => {
      s.push_str("-");
      s.push_str(os_vendor_str(o));
      s.push_str("-");
      s.push_str(os_triple_str(o));
      match(
        abi,
        .None => (),
        .Some(b) => {
          s.push_str("-");
          s.push_str(abi_to_str(b));
        }
      );
    }
  );
  s
});
_build_target_info :: (fn(a : Arch, o : Os, abi : Option(Abi)) -> TargetInfo)(
  TargetInfo(
    arch : a,
    os : o,
    abi : abi,
    pointer_size_bits : pointer_size_for_arch(a),
    triple : _build_triple(a, o, abi)
  )
);
// ── Linux musl detection ──────────────────────────────────────────────
/// Detect whether the host Linux system uses musl libc.
/// Currently returns Abi.Gnu — musl detection via /lib filesystem reads
/// requires synchronous I/O which is not yet available in the compiler's
/// compile-time evaluation.
detect_linux_abi :: (fn() -> Abi)(Abi.Gnu);
// ── Host detection ────────────────────────────────────────────────────
/// Detect the host machine's platform and architecture from compile-time constants.
detect_host :: (fn() -> HostInfo)({
  host_os := cond(
    (platform == Platform.Linux) => Os.Linux,
    (platform == Platform.Macos) => Os.Macos,
    (platform == Platform.Windows) => Os.Windows,
    (platform == Platform.FreeBSD) => Os.FreeBSD,
    (platform == Platform.Wasi) => Os.Wasi,
    (platform == Platform.Emscripten) => Os.Emscripten,
    true => Os.Linux
  );
  host_arch := cond(
    (arch == ProcessArch.X86_64) => Arch.X86_64,
    (arch == ProcessArch.Aarch64) => Arch.Aarch64,
    (arch == ProcessArch.X86) => Arch.X86,
    (arch == ProcessArch.Arm) => Arch.Arm,
    (arch == ProcessArch.Wasm32) => Arch.Wasm32,
    true => Arch.X86_64
  );
  HostInfo(platform : host_os, arch : host_arch)
});
/// Return a TargetInfo representing the host machine (native compilation).
host_target :: (fn() -> TargetInfo)({
  host := detect_host();
  linux_abi := detect_linux_abi();
  abi := cond(
    (host.platform == Os.Linux) => Option(Abi).Some(linux_abi),
    (host.platform == Os.Windows) => Option(Abi).Some(Abi.Msvc),
    (host.platform == Os.Wasi) => Option(Abi).Some(Abi.P1),
    true => Option(Abi).None
  );
  _build_target_info(host.arch, host.platform, abi)
});
// ── Current compilation target ────────────────────────────────────────
// The target of the CURRENT compilation, set early in the pipeline
// (before the evaluator or codegen runs) and read by the comptime
// `__yo_process_platform` / `__yo_process_arch` / `__yo_pointer_size_bits`
// builtins.
//
// WHY THIS EXISTS: those builtins used to answer from `detect_host()`, so
// every target-conditional `cond(platform == ...)` in std/ folded for the
// HOST even under `--target`. Cross-emission therefore baked host values —
// `AT_FDCWD = -2` into a linux target
// (issues/yo-self-cross-emit-host-constants.md) — and, under
// `--target wasm32-wasip1`/`--cc emcc` on Linux, std/crypto/random.yo took its
// Linux arm and the link failed with `undefined symbol: getrandom`.
(g_current_target : Option(TargetInfo)) = Option(TargetInfo).None;
/// Set the target for the current compilation.
set_current_target :: (fn(t : TargetInfo) -> unit)({
  g_current_target = Option(TargetInfo).Some(t);
  ()
});
/// The current compilation target, falling back to the host when a caller
/// (e.g. `check`) never set one.
get_current_target :: (fn() -> TargetInfo)(
  match(g_current_target, .Some(t) => t, .None => host_target())
);
// ── Parse target triple ───────────────────────────────────────────────
/// `parse_os` plus the two cfg names a user is likely to type into a triple
/// by mistake (`macos`, `wasi`) — used ONLY to phrase a did-you-mean hint,
/// never to accept a spelling.
_parse_os_for_hint :: (fn(s : String) -> Option(Os))(
  cond(
    (s == "macos") => Option(Os).Some(Os.Macos),
    (s == "wasi") => Option(Os).Some(Os.Wasi),
    true => parse_os(s)
  )
);
/// The environment to put in a did-you-mean hint: the one the user typed if
/// it fits, else the OS's usual one.
_hint_abi :: (fn(o : Os, typed : Option(Abi)) -> Option(Abi))(
  match(
    o,
    .Linux => cond((typed == Option(Abi).Some(Abi.Musl)) => Option(Abi).Some(Abi.Musl), true => Option(Abi).Some(Abi.Gnu)),
    .Windows => cond((typed == Option(Abi).Some(Abi.Gnu)) => Option(Abi).Some(Abi.Gnu), true => Option(Abi).Some(Abi.Msvc)),
    .Wasi => Option(Abi).Some(Abi.P1),
    _ => Option(Abi).None
  )
);
_target_error :: (fn(triple : String, why : String) -> Result(TargetInfo, String))(
  Result(TargetInfo, String).Err(`Invalid target "${triple}": ${why}\nSupported targets: ${SUPPORTED_TARGETS}`)
);
/// Parse a canonical target triple such as "x86_64-unknown-linux-gnu" into a
/// TargetInfo. Returns Err(message) on any spelling that is not exactly one
/// of the supported targets — there are no aliases.
///
/// Accepted forms:
///   - `<arch>-<vendor>-<os>`         (darwin, freebsd, emscripten — no env)
///   - `<arch>-<vendor>-<os>-<env>`   (linux: gnu | musl; windows: msvc | gnu)
///   - `wasm32-wasip1`
parse_target :: (fn(triple : String) -> Result(TargetInfo, String))({
  parts := triple.split(String.from("-"));
  parts_n := parts.len();
  if((parts_n < usize(2)) || (parts_n > usize(4)), {
    return(_target_error(triple, String.from("expected <arch>-<vendor>-<os>[-<env>] or wasm32-wasip1.")));
  });
  arch_str := match(parts.get(usize(0)), .None => String.new(), .Some(p) => p);
  a := match(
    parse_arch(arch_str),
    .None => {
      return(
        _target_error(
          triple,
          cond(
            (arch_str == "wasm") => `WebAssembly is "wasm32" — did you mean "wasm32-wasip1" or "wasm32-unknown-emscripten"?`,
            true => `unknown architecture "${arch_str}".`
          )
        )
      );
    },
    .Some(v) => v
  );
  // The two-component form is exactly `wasm32-wasip1`.
  if(parts_n == usize(2), {
    os_word := match(parts.get(usize(1)), .None => String.new(), .Some(p) => p);
    if(os_word != "wasip1", {
      // `aarch64-macos`, `wasm32-wasi`, `x86_64-linux`: an OS where the vendor
      // belongs — the pre-triple vocabulary. Say what the triple is.
      match(
        _parse_os_for_hint(os_word),
        .Some(vo) => {
          return(_target_error(triple, `the triple needs a vendor — did you mean "${_build_triple(a, vo, _hint_abi(vo, Option(Abi).None))}"?`));
        },
        .None => ()
      );
      return(_target_error(triple, String.from("expected <arch>-<vendor>-<os>[-<env>] or wasm32-wasip1.")));
    });
    if(a != Arch.Wasm32, {
      return(_target_error(triple, `WASI targets are wasm32 only, not "${arch_str}".`));
    });
    return(Result(TargetInfo, String).Ok(_build_target_info(Arch.Wasm32, Os.Wasi, Option(Abi).Some(Abi.P1))));
  });
  vendor_str := match(parts.get(usize(1)), .None => String.new(), .Some(p) => p);
  os_str := match(parts.get(usize(2)), .None => String.new(), .Some(p) => p);
  // `x86_64-linux-gnu`, `x86_64-windows-msvc`: an OS in the vendor slot is the
  // pre-triple vocabulary. Say what the triple is, keeping a typed env.
  match(
    _parse_os_for_hint(vendor_str),
    .Some(vo) => {
      return(_target_error(triple, `"${vendor_str}" is an OS and the triple needs a vendor — did you mean "${_build_triple(a, vo, _hint_abi(vo, parse_abi(os_str)))}"?`));
    },
    .None => ()
  );
  o := match(
    parse_os(os_str),
    .None => {
      return(_target_error(triple, `unknown OS "${os_str}".`));
    },
    .Some(v) => v
  );
  if(o == Os.Wasi, {
    return(_target_error(triple, String.from("WASI is spelled wasm32-wasip1.")));
  });
  expected_vendor := os_vendor_str(o);
  if(vendor_str != expected_vendor, {
    return(_target_error(triple, `vendor "${vendor_str}" does not go with "${os_str}" (expected "${expected_vendor}").`));
  });
  // wasm32 runs only on the wasm OSes, and the wasm OSes only on wasm32.
  if((a == Arch.Wasm32) != (o == Os.Emscripten), {
    return(_target_error(triple, `architecture "${arch_str}" does not go with "${os_str}".`));
  });
  abi := cond(
    (parts_n == usize(4)) => {
      env_str := match(parts.get(usize(3)), .None => String.new(), .Some(p) => p);
      env := match(
        parse_abi(env_str),
        .None => {
          return(_target_error(triple, `unknown environment "${env_str}".`));
        },
        .Some(v) => v
      );
      allowed := match(
        o,
        .Linux => ((env == Abi.Gnu) || (env == Abi.Musl)),
        .Windows => ((env == Abi.Msvc) || (env == Abi.Gnu)),
        _ => false
      );
      if(!(allowed), {
        return(
          _target_error(
            triple,
            match(
              o,
              .Linux => `linux takes the environment gnu or musl, not "${env_str}".`,
              .Windows => `windows takes the environment msvc or gnu, not "${env_str}".`,
              _ => `${os_str} takes no environment.`
            )
          )
        );
      });
      Option(Abi).Some(env)
    },
    true => {
      match(
        o,
        .Linux => {
          return(_target_error(triple, String.from("linux needs an environment: -gnu or -musl.")));
        },
        .Windows => {
          return(_target_error(triple, String.from("windows needs an environment: -msvc or -gnu.")));
        },
        _ => ()
      );
      Option(Abi).None
    }
  );
  Result(TargetInfo, String).Ok(_build_target_info(a, o, abi))
});
// ── Clang triple ──────────────────────────────────────────────────────
/// The triple to hand clang's `--target=`. The canonical triple is already
/// what LLVM speaks, except where LLVM's own spelling differs: MinGW is
/// `<arch>-w64-mingw32`, and WASI is `wasm32-wasi` (accepted by every
/// wasi-sdk clang, where `wasm32-wasip1` needs LLVM ≥ 19).
clang_triple :: (fn(target : TargetInfo) -> String)(
  cond(
    ((target.os == Os.Windows) && (target.abi == Option(Abi).Some(Abi.Gnu))) => {
      s := String.from(arch_triple_str(target.arch));
      s.push_str("-w64-mingw32");
      s
    },
    (target.os == Os.Wasi) => String.from("wasm32-wasi"),
    true => target.triple.clone()
  )
);
// ── Convenience queries ───────────────────────────────────────────────
is_target_windows :: (fn(target : TargetInfo) -> bool)(
  target.os == Os.Windows
);
is_target_linux :: (fn(target : TargetInfo) -> bool)(
  target.os == Os.Linux
);
is_target_macos :: (fn(target : TargetInfo) -> bool)(
  target.os == Os.Macos
);
is_target_wasm :: (fn(target : TargetInfo) -> bool)(
  (target.arch == Arch.Wasm32) || ((target.os == Os.Wasi) || (target.os == Os.Emscripten))
);
is_target_emscripten :: (fn(target : TargetInfo) -> bool)(
  target.os == Os.Emscripten
);
is_target_standalone_wasi :: (fn(target : TargetInfo) -> bool)(
  target.os == Os.Wasi
);
is_target_musl :: (fn(target : TargetInfo) -> bool)(
  target.abi == Option(Abi).Some(Abi.Musl)
);
is_target_posix :: (fn(target : TargetInfo) -> bool)(
  (!(is_target_windows(target))) && (!(is_target_wasm(target)))
);
export(
  Arch,
  Os,
  Abi,
  TargetInfo,
  HostInfo,
  SUPPORTED_TARGETS,
  arch_to_str,
  arch_triple_str,
  os_to_str,
  os_triple_str,
  os_vendor_str,
  abi_to_str,
  target_os_to_yo_string,
  target_arch_to_yo_string,
  parse_arch,
  parse_os,
  parse_abi,
  pointer_size_for_arch,
  detect_linux_abi,
  detect_host,
  host_target,
  set_current_target,
  get_current_target,
  parse_target,
  clang_triple,
  is_target_windows,
  is_target_linux,
  is_target_macos,
  is_target_wasm,
  is_target_emscripten,
  is_target_standalone_wasi,
  is_target_musl,
  is_target_posix
);
