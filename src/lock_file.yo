//! `yo.lock` v2 — the resolved dependency graph
//! (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.3).
//!
//! ```toml
//! # yo.lock — generated by `yo add` / `yo install` / `yo update`; commit this file.
//! version = 2
//!
//! [[package]]
//! name = "raylib_yo"
//! version = "0.0.6"
//! source = "git+https://github.com/shd101wyy/raylib_yo#v0.0.6"
//! commit = "973b8cb6c1e362839534df8c16a735aa8a684dc9"
//! integrity = "sha256-…"
//! dependencies = ["utils"]
//!
//! [[package]]
//! name = "mylib"
//! source = "path+../mylib"
//! ```
//!
//! Written by `std/encoding/toml.stringify` (a generated file needs no
//! comment preservation), read by `std/encoding/toml.parse`. Entries are
//! sorted by name and written atomically (temp + rename). The v1 format
//! (`[[dependencies]]` with `url`/`ref`/`hash`) is not read — a v1 lock is
//! regenerated by the next `yo install`. The resolver (`src/resolver.yo`)
//! produces the entries; `src/manifest.yo` reads them synchronously to map a
//! git dependency to its cache directory.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ Path } :: import("std/path");
{ Exception, IoExn } :: import("std/error");
{ ToString } :: import("std/fmt");
{ exists, read_to_string, write_string } :: import("std/fs/file");
{ rename } :: import("std/fs/dir");
{ parse, stringify, TomlValue } :: import("std/encoding/toml");
/// The lock format this compiler writes and reads.
LOCK_VERSION :: i64(2);
/// The lock file's name, beside `yo.toml`.
LOCK_FILE_NAME :: "yo.lock";
// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------
/// One resolved package.
LockEntry :: ref(
  struct(
    /// The import name (the `[dependencies]` key).
    name : String,
    /// The semver of the chosen tag ("" for a branch, a commit, or a path).
    version : String,
    /// `git+<url>#<ref>` or `path+<path relative to the root manifest>`.
    source : String,
    /// The fetched commit ("" for a path package).
    commit : String,
    /// `sha256-…` of the fetched tree ("" for a path package — it is live).
    integrity : String,
    /// The names of the package's own (non-dev) dependencies.
    dependencies : ArrayList(String)
  )
);
impl(
  LockEntry,
  /// True for a `git+…` source.
  is_git : (fn(self : Self) -> bool)(
    self.source.starts_with("git+")
  ),
  /// The repository URL of a git source ("" otherwise).
  url : (fn(self : Self) -> String)({
    if(!self.is_git(), return(String.new()));
    rest := self.source.substring(usize(4), self.source.len());
    match(
      rest.last_index_of("#"),
      .Some(k) => rest.substring(usize(0), k),
      .None => rest
    )
  }),
  /// The ref (tag, branch, commit) of a git source ("" otherwise).
  ref : (fn(self : Self) -> String)({
    if(!self.is_git(), return(String.new()));
    rest := self.source.substring(usize(4), self.source.len());
    match(
      rest.last_index_of("#"),
      .Some(k) => rest.substring(k + usize(1), rest.len()),
      .None => String.new()
    )
  }),
  /// The path of a `path+…` source ("" otherwise).
  path : (fn(self : Self) -> String)(
    if(self.source.starts_with("path+"), self.source.substring(usize(5), self.source.len()), String.new())
  )
);
/// `git+<url>#<ref>`.
git_source :: (fn(url : String, ref : String) -> String)(
  `git+${url}#${ref}`
);
/// `path+<path>`.
path_source :: (fn(path : String) -> String)(
  `path+${path}`
);
/// In-memory representation of a `yo.lock` file.
LockFile :: ref(
  struct(
    packages : ArrayList(LockEntry)
  )
);
impl(
  LockFile,
  /// An empty lock file (no packages).
  empty : (fn() -> Self)(
    Self(packages : ArrayList(LockEntry).new())
  )
);
// ---------------------------------------------------------------------------
// Parsing
// ---------------------------------------------------------------------------
_string_or_empty :: (fn(table : TomlValue, key : str) -> String)(
  match(
    table.get(String.from(key)),
    .Some(v) => match(v.as_string(), .Some(s) => s, .None => String.new()),
    .None => String.new()
  )
);
/// Parse a `yo.lock` document. `.Err` for a document that is not TOML, has no
/// `version = 2`, or has a malformed `[[package]]` entry.
parse_lock_file :: (fn(content : String) -> Result(LockFile, String))({
  if(content.trim().len() == usize(0), {
    return(Result(LockFile, String).Ok(LockFile.empty()));
  });
  root := match(
    parse(content),
    .Ok(v) => v,
    .Err(err) => {
      return(Result(LockFile, String).Err(`yo.lock: ${err.to_string()}`));
    }
  );
  version := match(
    root.get(String.from("version")),
    .Some(v) => match(v.as_int(), .Some(n) => n, .None => i64(0)),
    .None => i64(0)
  );
  if(version != LOCK_VERSION, {
    return(Result(LockFile, String).Err(`yo.lock: format version ${version.to_string()} is not ${LOCK_VERSION.to_string()} (a lock written by an older yo is regenerated by \`yo install\`)`));
  });
  packages := ArrayList(LockEntry).new();
  match(
    root.get(String.from("package")),
    .None => (),
    .Some(list) => match(
      list.as_array(),
      .None => {
        return(Result(LockFile, String).Err(String.from("yo.lock: [[package]] must be an array of tables")));
      },
      .Some(items) => {
        (i : usize) = usize(0);
        while(i < items.len(), {
          item := items(i);
          if(!item.is_table(), {
            return(Result(LockFile, String).Err(String.from("yo.lock: a [[package]] entry is not a table")));
          });
          name := _string_or_empty(item, "name");
          source := _string_or_empty(item, "source");
          if((name.len() == usize(0)) || (source.len() == usize(0)), {
            return(Result(LockFile, String).Err(`yo.lock: [[package]] entry ${(i + usize(1)).to_string()} needs name and source`));
          });
          if(!(source.starts_with("git+") || source.starts_with("path+")), {
            return(Result(LockFile, String).Err(`yo.lock: package "${name}" has an unknown source kind: ${source}`));
          });
          deps := ArrayList(String).new();
          match(
            item.get(String.from("dependencies")),
            .None => (),
            .Some(dv) => match(
              dv.as_array(),
              .Some(ds) => {
                (d : usize) = usize(0);
                while(d < ds.len(), {
                  match(ds(d).as_string(), .Some(s) => deps.push(s), .None => ());
                  d = (d + usize(1));
                });
              },
              .None => ()
            )
          );
          packages.push(
            LockEntry(
              name : name,
              version : _string_or_empty(item, "version"),
              source : source,
              commit : _string_or_empty(item, "commit"),
              integrity : _string_or_empty(item, "integrity"),
              dependencies : deps
            )
          );
          i = (i + usize(1));
        });
      }
    )
  );
  Result(LockFile, String).Ok(LockFile(packages : packages))
});
// ---------------------------------------------------------------------------
// Serialisation
// ---------------------------------------------------------------------------
/// The packages sorted by name (insertion sort — a lock holds a handful).
_sorted :: (fn(packages : ArrayList(LockEntry)) -> ArrayList(LockEntry))({
  out := ArrayList(LockEntry).new();
  (i : usize) = usize(0);
  while(i < packages.len(), {
    out.push(packages(i));
    i = (i + usize(1));
  });
  (a : usize) = usize(1);
  while(a < out.len(), {
    (b : usize) = a;
    while((b > usize(0)) && (out(b - usize(1)).name > out(b).name), {
      out.swap(b - usize(1), b);
      b = (b - usize(1));
    });
    a = (a + usize(1));
  });
  out
});
/// Serialise a `LockFile` to TOML text: the header comment, `version`, then
/// one `[[package]]` per entry sorted by name. Empty fields are omitted.
write_lock_file_content :: (fn(lock : LockFile) -> String)({
  root := TomlValue.new_table();
  _ := root.insert(String.from("version"), TomlValue.Int(LOCK_VERSION));
  items := ArrayList(TomlValue).new();
  sorted := _sorted(lock.packages);
  (i : usize) = usize(0);
  while(i < sorted.len(), {
    p := sorted(i);
    t := TomlValue.new_table();
    _ := t.insert(String.from("name"), TomlValue.Str(p.name.clone()));
    if(p.version.len() > usize(0), {
      _ := t.insert(String.from("version"), TomlValue.Str(p.version.clone()));
    });
    _ := t.insert(String.from("source"), TomlValue.Str(p.source.clone()));
    if(p.commit.len() > usize(0), {
      _ := t.insert(String.from("commit"), TomlValue.Str(p.commit.clone()));
    });
    if(p.integrity.len() > usize(0), {
      _ := t.insert(String.from("integrity"), TomlValue.Str(p.integrity.clone()));
    });
    if(p.dependencies.len() > usize(0), {
      deps := ArrayList(TomlValue).new();
      (d : usize) = usize(0);
      while(d < p.dependencies.len(), {
        deps.push(TomlValue.Str(p.dependencies(d).clone()));
        d = (d + usize(1));
      });
      _ := t.insert(String.from("dependencies"), TomlValue.Array(deps));
    });
    items.push(t);
    i = (i + usize(1));
  });
  if(items.len() > usize(0), {
    _ := root.insert(String.from("package"), TomlValue.Array(items));
  });
  body := stringify(root);
  `# yo.lock — generated by \`yo add\` / \`yo install\` / \`yo update\`; commit this file.\n${body}`
});
// ---------------------------------------------------------------------------
// Disk I/O
// ---------------------------------------------------------------------------
/// What reading the lock found.
LockRead :: ref(
  struct(
    lock : LockFile,
    /// True when the file was absent.
    absent : bool,
    /// The parse problem of a present-but-unusable file (a v1 lock, or
    /// corruption); the resolver regenerates such a lock.
    problem : Option(String)
  )
);
/// Read `<project_dir>/yo.lock`. Absent or unusable → an empty lock, with
/// the flags telling which.
read_lock_file :: (
  fn(
    project_dir : Path,
    io : Io,
    exn : Exception
  ) -> Impl(Future(LockRead, IoExn))
)(
  io.async((e : IoExn) => {
    lock_path := project_dir.join(Path.new(String.from(LOCK_FILE_NAME)));
    file_exists := e.io.await(exists(lock_path, e.io), e.io);
    if(!file_exists, {
      return(LockRead(lock : LockFile.empty(), absent : true, problem : Option(String).None));
    });
    content := e.io.await(read_to_string(lock_path, e.io), e);
    match(
      parse_lock_file(content),
      .Ok(lock) => LockRead(lock : lock, absent : false, problem : Option(String).None),
      .Err(msg) => LockRead(lock : LockFile.empty(), absent : false, problem : Option(String).Some(msg))
    )
  })
);
/// Write `lock` to `<project_dir>/yo.lock` atomically (temp file + rename).
save_lock_file :: (
  fn(
    project_dir : Path,
    lock : LockFile,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    lock_path := project_dir.join(Path.new(String.from(LOCK_FILE_NAME)));
    tmp_path := project_dir.join(Path.new(String.from("yo.lock.tmp")));
    content := write_lock_file_content(lock);
    e.io.await(write_string(tmp_path, content, e.io), e);
    e.io.await(rename(tmp_path, lock_path, e.io), e);
  })
);
// ---------------------------------------------------------------------------
// Queries
// ---------------------------------------------------------------------------
/// The entry named `name`, or `.None`.
find_lock_entry :: (fn(lock : LockFile, name : String) -> Option(LockEntry))({
  (i : usize) = usize(0);
  while(i < lock.packages.len(), {
    p := lock.packages(i);
    if(p.name == name, {
      return(Option(LockEntry).Some(p));
    });
    i = (i + usize(1));
  });
  Option(LockEntry).None
});
/// True when the two locks record the same packages (name, source, commit,
/// integrity, version, dependencies) — what `--locked` compares.
lock_files_equal :: (fn(a : LockFile, b : LockFile) -> bool)({
  if(a.packages.len() != b.packages.len(), return(false));
  sa := _sorted(a.packages);
  sb := _sorted(b.packages);
  (i : usize) = usize(0);
  while(i < sa.len(), {
    x := sa(i);
    y := sb(i);
    same := ((x.name == y.name) && ((x.source == y.source) && ((x.commit == y.commit) && ((x.integrity == y.integrity) && (x.version == y.version)))));
    if(!same, return(false));
    if(x.dependencies.len() != y.dependencies.len(), return(false));
    (d : usize) = usize(0);
    while(d < x.dependencies.len(), {
      if(x.dependencies(d) != y.dependencies(d), return(false));
      d = (d + usize(1));
    });
    i = (i + usize(1));
  });
  true
});
export(
  LOCK_VERSION,
  LOCK_FILE_NAME,
  LockEntry,
  LockFile,
  LockRead,
  git_source,
  path_source,
  parse_lock_file,
  write_lock_file_content,
  read_lock_file,
  save_lock_file,
  find_lock_entry,
  lock_files_equal
);
