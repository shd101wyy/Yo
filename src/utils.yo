//! Top-level utilities for the self-hosted Yo compiler.
//!
//! Provides:
//!   * `generate_temp_variable_name_prefix` — derives a per-module prefix
//!     used by `generate_new_temp_variable_name`.
//!   * `generate_new_temp_variable_name` — returns a fresh `_<prefix>_temp_<n>`
//!     identifier.
//!   * `is_temp_variable_name` — predicate matching names produced by
//!     `generate_new_temp_variable_name`.
{ rune, String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ Path } :: import("std/path");
{ cwd, env } :: import("std/env");
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Unicode escape scanning — shared by the lexer (template strings, and
// VALIDATION of double-quoted ones) and by the evaluator's string-literal
// decoder, so the two forms cannot disagree about what a `\u` escape means.
// ---------------------------------------------------------------------------
/// The value of a hex-digit rune, or `.None` when the rune is not one.
///
/// The failure channel is the whole point. The version this replaces answered
/// `0` for a non-hex rune, so `"\uZZZZ"` decoded to U+0000 and `"\u{41}"` —
/// whose four runes are `{`, `4`, `1`, `}` — decoded to U+0410 rather than
/// U+0041, both silently
/// (issues/fixed/unicode-escape-accepts-non-hex-digits.md).
hex_digit_value :: (fn(r : rune) -> Option(u32))({
  c := r.char;
  cond(
    ((c >= u32(0x30)) && (c <= u32(0x39))) => Option(u32).Some(c - u32(0x30)),
    ((c >= u32(0x41)) && (c <= u32(0x46))) => Option(u32).Some((c - u32(0x41)) + u32(10)),
    ((c >= u32(0x61)) && (c <= u32(0x66))) => Option(u32).Some((c - u32(0x61)) + u32(10)),
    true => Option(u32).None
  )
});
/// How a `\u` escape scanned.
///
/// `consumed` counts the runes taken INCLUDING the `u` but excluding the
/// backslash, so a caller advances by `1 + consumed`.
UnicodeEscape :: enum(
  /// A well-formed escape and its code point.
  Ok(code : u32, consumed : usize),
  /// Not well formed. Carries the diagnostic to report.
  Bad(reason : String)
);
/// Scan the `\u` escape whose `u` sits at `at`. Accepts BOTH spellings:
///
/// - `\uXXXX` — exactly four hex digits, JSON's form, which is what Yo has
///   always documented. A high surrogate is returned AS the surrogate value so
///   the caller can combine it with a following low surrogate (JSON's way of
///   writing an astral code point); this function does not look past the four
///   digits.
/// - `\u{X}` … `\u{XXXXXX}` — one to six hex digits in braces, Rust's form.
///   Accepted because it is what a reader coming from Rust writes, and because
///   the alternative was decoding it to a WRONG code point in silence. A value
///   above U+10FFFF, or a lone surrogate, is rejected here — neither is a
///   scalar value, and Rust rejects both.
///
/// Anything else is `.Bad`, which is the behaviour change: this used to be
/// undiagnosed.
scan_unicode_escape :: (fn(runes : ArrayList(rune), at : usize) -> UnicodeEscape)({
  n := runes.len();
  nul := rune(u32(0));
  opener := match(runes.get(at + usize(1)), .Some(r) => r, .None => nul);
  cond(
    (opener.char == u32(0x7B)) => {
      // `\u{...}` — Rust's form.
      (v : u32) = u32(0);
      (digits : usize) = usize(0);
      (j : usize) = (at + usize(2));
      (bad : Option(String)) = Option(String).None;
      (closed : bool) = false;
      while((j < n) && bad.is_none() && !closed, {
        r := match(runes.get(j), .Some(rr) => rr, .None => nul);
        cond(
          (r.char == u32(0x7D)) => {
            closed = true;
          },
          true => match(
            hex_digit_value(r),
            .Some(d) => {
              digits = (digits + usize(1));
              cond(
                (digits > usize(6)) => {
                  bad = Option(String).Some(
                    String.from("unicode escape \\u{...} takes at most six hex digits")
                  );
                },
                true => {
                  v = ((v * u32(16)) + d);
                  j = (j + usize(1));
                }
              );
            },
            .None => {
              bad = Option(String).Some(
                String.from("invalid character in unicode escape: \\u{...} takes hex digits only")
              );
            }
          )
        );
      });
      match(
        bad,
        .Some(msg) => UnicodeEscape.Bad(msg),
        .None => cond(
          !closed => UnicodeEscape.Bad(
            String.from("unterminated unicode escape: \\u{ was never closed by }")
          ),
          (digits == usize(0)) => UnicodeEscape.Bad(
            String.from("empty unicode escape: \\u{} has no hex digits")
          ),
          (v > u32(0x10FFFF)) => UnicodeEscape.Bad(
            String.from("unicode escape is out of range: the largest code point is 10FFFF")
          ),
          ((v >= u32(0xD800)) && (v <= u32(0xDFFF))) => UnicodeEscape.Bad(
            String.from(
              "unicode escape names a surrogate, which is not a character; write the astral code point itself"
            )
          ),
          // `u` + `{` + digits + `}`
          true => UnicodeEscape.Ok(v, digits + usize(3))
        )
      )
    },
    true => {
      // `\uXXXX` — JSON's form, exactly four hex digits.
      (v : u32) = u32(0);
      (ok : bool) = true;
      (j : usize) = usize(0);
      while((j < usize(4)) && ok, {
        r := match(runes.get(at + usize(1) + j), .Some(rr) => rr, .None => nul);
        match(
          hex_digit_value(r),
          .Some(d) => {
            v = ((v * u32(16)) + d);
            j = (j + usize(1));
          },
          .None => {
            ok = false;
          }
        );
      });
      cond(
        ok => UnicodeEscape.Ok(v, usize(5)),
        true => UnicodeEscape.Bad(
          String.from(
            "invalid unicode escape: \\uXXXX takes exactly four hex digits (or use \\u{X..XXXXXX})"
          )
        )
      )
    }
  )
});
// ---------------------------------------------------------------------------
// Position-stable IDs and temp variable name generation (Phase 2,
// plans/reference/INCREMENTAL_COMPILATION_ZIG_LESSONS.md §5)
// ---------------------------------------------------------------------------
/// FNV-1a 64 over the bytes (same constants as std/hash's Fnv1aHasher —
/// inlined here because the Hasher trait is not exported from std/hash).
/// The shared content-hash behind the stable id/name schemes.
fnv1a64 :: (fn(s : String) -> u64)({
  (state : u64) = u64(14695981039346656037);
  bytes := s.as_bytes();
  (i : usize) = usize(0);
  while(i < bytes.len(), {
    b := match(bytes.get(i), .Some(x) => x, .None => u8(0));
    // FNV-1a's multiply wraps BY DESIGN (the hash identity depends on the
    // modular arithmetic; -fwrapv used to make that silent — Phase 3a-ii
    // migrated std/hash's copy but missed this inlined one).
    state = (state ^ u64(b)).wrapping_mul(u64(1099511628211));
    i = (i + usize(1));
  });
  state
});
/// The identity half of a function's emitted C name: the last two path
/// segments of its defining module (readable, and "index" only collides
/// across same-named directories), every byte outside [A-Za-z0-9_] mapped
/// to `_`, extension `.yo` dropped. Deterministic in the module's PATH,
/// which an edit elsewhere in the tree never changes.
_stable_id_module_stem :: (fn(module_path : String) -> String)({
  p := module_path.clone();
  if(p.starts_with(String.from("file://")), {
    p = p.substring(usize(7), p.len());
  });
  if((p.len() > usize(3)) && p.ends_with(String.from(".yo")), {
    p = p.substring(usize(0), p.len() - usize(3));
  });
  segments := p.split("/");
  out := String.new();
  (start_at : usize) = cond(
    (segments.len() >= usize(2)) => (segments.len() - usize(2)),
    true => usize(0)
  );
  (si : usize) = usize(0);
  while(si < segments.len(), {
    if(si >= start_at, {
      if(out.len() > usize(0), {
        out.push_str("__");
      });
      seg := match(segments.get(si), .Some(s) => s, .None => String.new());
      bytes := seg.as_bytes();
      (bi : usize) = usize(0);
      while(bi < bytes.len(), {
        b := match(bytes.get(bi), .Some(x) => x, .None => u8(0));
        cond(
          (((b >= u8(97)) && (b <= u8(122))) || ((b >= u8(65)) && (b <= u8(90)))) => {
            out.push_byte(b);
          },
          ((b >= u8(48)) && (b <= u8(57))) => {
            out.push_byte(b);
          },
          true => {
            out.push_str("_");
          }
        );
        bi = (bi + usize(1));
      });
    });
    si = (si + usize(1));
  });
  out
});
/// Mint registry: stable id → the `<module_path>:<row>:<column>` source key
/// that claimed it. The SAME source position minting again (a re-evaluated
/// generation of the same module) REUSES its id — identity merge, exactly
/// what the closure fid-source registry already does. A DIFFERENT source
/// position colliding on the same stem+row+col (two `…/x/index.yo` files)
/// takes the `_x2`, `_x3`… suffixes.
(g_stable_id_owner : HashMap(String, String)) = HashMap(String, String).new();
/// Occurrence counters (Phase 2 companion to `stable_position_id`): how many
/// times each source position has minted a SAME-SITE-DISTINCT name in this
/// process. For constructs that legitimately mint several names from one
/// site — an `_` binding evaluated per inlined call, a loop label re-emitted
/// per enclosing function — the k-th mint gets suffix `_n<k-1>`, so the names
/// stay a function of WHAT is at that position, not of the global mint order.
(g_stable_occurrence : HashMap(String, usize)) = HashMap(String, usize).new();
/// The next 0-based occurrence index for `key`. Keys are caller-composed:
/// `<module>:<row>:<column>` where a source position exists, a semantic key
/// (`<module>:dup:<var>`) where one does not.
/// Reset ALL occurrence counters. Called at the start of a COLD compile
/// (`run_compile` with the evaluator universe cleared): within one compile
/// the ids these counters shape must be a function of (source, position,
/// mint-order-within-this-compile). Deliberately NOT called on a warm-reuse
/// pass — its cached modules skip their mints, so a reset would shift the
/// sequence and collide fresh ids with the surviving registries' entries
/// (issues/warm-compile-selfcheck.md). Byte-identical warm emission needs
/// those registries purged per compile instead.
stable_occurrence_reset :: (fn() -> unit)({
  g_stable_occurrence = HashMap(String, usize).new();
  ()
});
/// Emission-name occurrence counters — a SEPARATE namespace from
/// `g_stable_occurrence`, reset at the start of EVERY compile (cold or warm).
/// Emission names (temp variables, loop labels, short-circuit temps) are
/// per-ARTIFACT: each emitted C file is self-contained, so the same source
/// site must mint the SAME name in every compile of one process. The
/// identity table (`g_stable_occurrence`) deliberately persists across a
/// warm pass — its ids name cross-compile identities — which is exactly why
/// emission names must not draw from it (they would continue pass 1's
/// ordinals and the second compile's C would differ byte-for-byte;
/// issues/warm-compile-selfcheck.md).
/// Keyed by the 64-bit FNV-1a hash of the site key, not the key string: the
/// strings were full module paths plus a position, and a `check src/main.yo`
/// kept 428 K of them (66 MB) alive only to count
/// (plans/EVALUATOR_MEMORY_REDUCTION.md §0.10). A hash collision merges two
/// sites' counters, which only renumbers them: the names built from these
/// ordinals also carry the hash (temps) or the position (labels), so a shared
/// counter still hands out distinct names.
(g_emission_occurrence : HashMap(u64, usize)) = HashMap(u64, usize).new();
emission_occurrence_key :: (fn(key : String) -> usize)(
  emission_occurrence_hashed(fnv1a64(key))
);
/// `emission_occurrence_key` for a caller that already hashed its key.
emission_occurrence_hashed :: (fn(h : u64) -> usize)({
  next := match(
    g_emission_occurrence.get(h),
    .Some(n) => n,
    .None => usize(0)
  );
  g_emission_occurrence.insert(h, next + usize(1));
  next
});
/// Reset the emission-name counters. Called at the start of every compile.
emission_occurrence_reset :: (fn() -> unit)({
  g_emission_occurrence = HashMap(u64, usize).new();
  ()
});
stable_occurrence_key :: (fn(key : String) -> usize)({
  next := match(
    g_stable_occurrence.get(key),
    .Some(n) => n,
    .None => usize(0)
  );
  g_stable_occurrence.insert(key.clone(), next + usize(1));
  next
});
/// A top-level statement of a module, as an anchor for identity mints
/// (plans/TYPE_SYSTEM_SOUNDNESS.md Phase 3.3): where it starts, and a label
/// that does not depend on where it is — the bound name (`P` for
/// `P :: struct(...)`), `impl_<receiver>` for an impl, and for an unnamed
/// statement the previous label plus a count (`P_s1`).
TopLevelAnchor :: struct(row : usize, column : usize, label : String);
/// Anchors per module, keyed by the module path its tokens carry, ordered by
/// position. Written by the module walk before it evaluates anything
/// (`register_top_level_anchors`); a re-walk of the same module (an LSP edit,
/// `--watch`) replaces its entry.
(g_top_level_anchors : HashMap(String, ArrayList(TopLevelAnchor))) = HashMap(String, ArrayList(TopLevelAnchor)).new();
register_top_level_anchors :: (fn(module_path : String, anchors : ArrayList(TopLevelAnchor)) -> unit)({
  g_top_level_anchors.insert(module_path, anchors);
  ()
});
/// The position part of an identity mint: `(key, spelling)`. Relative to the
/// enclosing top-level statement when the module registered anchors — its
/// label, then the row offset from its first line and the column — so an edit
/// ABOVE a declaration (a comment, another declaration) leaves the id, and
/// every C name derived from it, byte-identical. Absolute `row`/`column` for
/// a position outside any registered module. Injective: each position has
/// exactly one enclosing anchor (the last one starting at or before it), labels
/// are unique within a module, and `(row offset, column)` is unique within one
/// anchor.
_anchored_position :: (fn(module_path : String, row : usize, column : usize) -> Tuple(String, String))(
  match(
    g_top_level_anchors.get(module_path),
    .Some(list) => {
      (lo : usize) = usize(0);
      (hi : usize) = list.len();
      while(lo < hi, {
        mid := ((lo + hi) / usize(2));
        at_or_before := match(
          list.get(mid),
          .Some(a) => ((a.row < row) || ((a.row == row) && (a.column <= column))),
          .None => false
        );
        if(at_or_before, {
          lo = (mid + usize(1));
        }, {
          hi = mid;
        });
      });
      match(
        if(lo > usize(0), list.get(lo - usize(1)), Option(TopLevelAnchor).None),
        .Some(a) => {
          drow := (row - a.row);
          (`@${a.label}:${drow.to_string()}:${column.to_string()}`, `_${a.label}_r${drow.to_string()}c${column.to_string()}`)
        },
        .None => (`${row.to_string()}:${column.to_string()}`, `_r${row.to_string()}c${column.to_string()}`)
      )
    },
    .None => (
      `${row.to_string()}:${column.to_string()}`,
      `_r${row.to_string()}c${column.to_string()}`
    )
  )
);
/// A stable, unique-per-emission label for `prefix` at a source position:
/// `<prefix>r<row>c<col>_n<k>`, where k is that position's occurrence index.
/// The codegen label/temp mints that used to embed the global `random_id`
/// counter (loop labels, short-circuit temps, …) go through here (Phase 2).
stable_label_id :: (
  fn(prefix : String, module_path : String, row : usize, column : usize) -> String
)({
  // EMISSION-name namespace (reset per compile) — labels are per-artifact.
  (pos_key, pos_part) := _anchored_position(module_path, row, column);
  k := emission_occurrence_key(`${module_path}:${pos_key}`);
  `${prefix}${pos_part.substring(usize(1), pos_part.len())}_n${k.to_string()}`
});
/// Type-id mint registry: id → the canonical path of the module that minted
/// it (`stable_type_id`). A module's two path spellings (AGENTS.md) share one
/// owner.
(g_stable_type_id_owner : HashMap(String, String)) = HashMap(String, String).new();
/// Memo of `canonical_module_path` for type-id owners: a type id is minted
/// per instantiation, and canonicalizing reads the cwd.
(g_stable_type_id_owner_memo : HashMap(String, String)) = HashMap(String, String).new();
/// A TYPE identity mint at a source position:
/// `<prefix><module_stem>_<anchor>_r<row offset>c<col>_n<k>`, the position
/// relative to the enclosing top-level statement (`_anchored_position`), so a
/// comment or a declaration added above does not rename the type or its C
/// name (plans/TYPE_SYSTEM_SOUNDNESS.md Phase 3.3). `k` counts in the IDENTITY namespace
/// (`g_stable_occurrence`, cold-only reset). Struct / enum / trait / union
/// ids (and an anonymous struct's field labels) key the id-keyed registries
/// that SURVIVE a warm pass (`g_struct_field_registry`, `g_type_intern`,
/// `g_struct_cfid_keys`, …), so they must never re-count from zero: a warm
/// compile skips its cached modules' mints, and an emission-namespace `k`
/// restarting at 0 gave a fresh `ArrayList(GenericImplEntry)` the id of pass
/// 1's `ArrayList(DocImplAssocType)` — its registry entries then answered
/// for the wrong type (`Cannot unify incompatible struct types:
/// "GenericImplEntry" and "DocImplAssocType"`;
/// issues/fixed/warm-test-batches-doc-stability-genericimplentry.md). On a
/// cold compile both namespaces reset together, so the ids are the same.
///
/// The id carries the defining module's stem (`_stable_id_module_stem`), as
/// `stable_position_id` does: without it two declarations at the same row and
/// column of different modules got one id (`std/collections/deque.yo`'s and
/// `array_list.yo`'s structs, both at 38:5, and `std/log.yo`'s `Sink` with
/// `std/async/stream.yo`'s `Stream`), and every id-keyed table answered for
/// both — `type_to_string` printed `Deque(T)` as `ArrayList(T)`
/// (issues/fixed/trait-ids-omit-the-module-so-two-traits-can-share-one-id.md).
/// Two modules whose stems coincide (`a/x/index.yo`, `b/x/index.yo`) are told
/// apart by `g_stable_type_id_owner`: the second takes `_x2`, `_x3`, ….
stable_type_id :: (
  fn(prefix : String, module_path : String, row : usize, column : usize) -> String
)({
  (pos_key, pos_part) := _anchored_position(module_path, row, column);
  k := stable_occurrence_key(`tid:${module_path}:${pos_key}`);
  base := `${prefix}${_stable_id_module_stem(module_path)}${pos_part}_n${k.to_string()}`;
  owner := _stable_type_id_owner_key(module_path);
  (candidate : String) = base.clone();
  (suffix : usize) = usize(1);
  while(runtime(true), {
    match(
      g_stable_type_id_owner.get(candidate),
      .Some(prev) => {
        if(prev == owner, {
          return(candidate);
        });
        suffix = (suffix + usize(1));
        candidate = `${base}_x${suffix.to_string()}`;
      },
      .None => {
        g_stable_type_id_owner.insert(candidate.clone(), owner);
        return(candidate);
      }
    );
  });
  candidate
});
_stable_type_id_owner_key :: (fn(module_path : String) -> String)(
  match(
    g_stable_type_id_owner_memo.get(module_path),
    .Some(c) => c,
    .None => {
      c := canonical_module_path(module_path);
      g_stable_type_id_owner_memo.insert(module_path.clone(), c.clone());
      c
    }
  )
);
/// A stable ID for a definition: `<prefix><module_stem>_<anchor>_r<row
/// offset>c<column>` (`_anchored_position`). Content-derived (defining module,
/// enclosing top-level statement, offset within it), so an edit anywhere ELSE
/// — including above it in the same file — leaves it and every emitted C name
/// derived from it byte-identical. Callers that genuinely need per-mint uniqueness (gensym)
/// keep `random_id`.
stable_position_id :: (
  fn(prefix : String, module_path : String, row : usize, column : usize) -> String
)({
  (pos_key, pos_part) := _anchored_position(module_path, row, column);
  src_key := `${module_path}:${pos_key}`;
  base := `${prefix}${_stable_id_module_stem(module_path)}${pos_part}`;
  (candidate : String) = base.clone();
  (suffix : usize) = usize(1);
  while(runtime(true), {
    match(
      g_stable_id_owner.get(candidate),
      .Some(owner) => {
        if(owner == src_key, {
          return(candidate);
        });
        suffix = (suffix + usize(1));
        candidate = `${base}_x${suffix.to_string()}`;
      },
      .None => {
        g_stable_id_owner.insert(candidate.clone(), src_key.clone());
        return(candidate);
      }
    );
  });
  candidate
});
/// A function identity mint (Phase 2): `<prefix>yo_id_<h><occ>` where `h` is
/// the FNV-1a 64 of the mint's anchored source position (`_anchored_position`)
/// and `occ` is that position's
/// occurrence ordinal zero-padded to 6 digits. Two properties the evaluator's
/// fid-keyed tables (specializations, capture info, param-default copies)
/// demand at once:
///
///   * UNIQUE PER MINT — a trial and a real evaluation of one function, and
///     two functions the derive/macro machinery generates from the same
///     expansion site, must never share a fid: sharing merges their
///     specializations and emits one body under another function's signature.
///     The occurrence ordinal provides this exactly like the global counter
///     `random_id` it replaces did.
///   * POSITION-DERIVED — an edit elsewhere in the tree, or above this
///     statement in its own file, changes neither `h` nor the mint count at
///     this position, so the fid (and every C name
///     derived from it) is byte-identical across unrelated edits.
///
/// The fixed 6-digit width keeps the digit string injective in practice:
/// `h1·10^6 + o1 == h2·10^6 + o2` forces `h1 == h2, o1 == o2` while ordinals
/// stay below one million (a single source position minting a million
/// functions does not happen; if it ever did, the unpadded tail merely risks
/// a collision, which register_function's backstop would catch and `_x`-suffixed).
///
/// Callers pass the HEAD-era prefixes so shape-sensitive consumers keep
/// matching: `""` → `yo_id_<digits>`, `"fn_"` → `fn_yo_id_<digits>`,
/// `"closure_"` → `closure_yo_id_<digits>`.
stable_func_id :: (
  fn(prefix : String, module_path : String, row : usize, column : usize) -> String
)({
  (pos_key, _pos_part) := _anchored_position(module_path, row, column);
  src_key := `fid:${module_path}:${pos_key}`;
  k := stable_occurrence_key(src_key);
  h := fnv1a64(`${prefix}:${module_path}:${pos_key}`);
  occ := k.to_string();
  while(occ.len() < usize(6), {
    occ = `0${occ}`;
  });
  `${prefix}yo_id_${h.to_string()}${occ}`
});
/// A positionless mint (Phase 2): `<prefix><occurrence>` where the occurrence
/// counter is scoped to (prefix, module). For evaluator-side names that have
/// no source position — unknown-value display names, comptime instance
/// labels. Unique per mint exactly like the `random_id` it replaces; stable
/// across unrelated edits because a module's mints are counted against its
/// own counter only, so an edit that changes ANOTHER module's mint count
/// cannot renumber this one.
stable_module_id :: (fn(prefix : String, module_path : String) -> String)({
  k := stable_occurrence_key(`${prefix}:${module_path}`);
  `${prefix}${k.to_string()}`
});
/// The source-namespace struct id for a module value. `stable_module_id`
/// alone gives every module's FIRST mint the same id (the occurrence counter
/// is per module), which made the sns id→module attribution map
/// (`g_sns_module`) last-wins ACROSS modules — in a directory check a later
/// module's mint overwrote the id a subsequent importer looked up, and its
/// destructured read was recorded against the wrong module
/// (issues/fixed/per-def-dependent-trial-resolves-stale-callee.md). Embedding the
/// module-path hash keeps ids unique per module (a re-mint of the SAME
/// module still gets a fresh occurrence, and both map back to it).
stable_sns_module_id :: (fn(module_path : String) -> String)({
  h := fnv1a64(module_path.clone());
  stable_module_id(`source_namespace_${h.to_string()}_`, module_path)
});
export(
  TopLevelAnchor,
  register_top_level_anchors,
  stable_position_id,
  stable_occurrence_key,
  stable_label_id,
  stable_type_id,
  stable_func_id,
  stable_module_id,
  stable_sns_module_id,
  stable_occurrence_reset,
  emission_occurrence_reset,
  fnv1a64,
  _stable_id_module_stem
);
/// Byte-exact StrLit unquote: drop the first and last BYTE (the ASCII `"`
/// delimiters the StrLit convention keeps). It was written because the
/// historical pattern `raw.substring(1, raw.len()-1)` mixed a BYTE length with
/// a then-CHAR-indexed `substring` — correct for ASCII, CORRUPTING for
/// multibyte content (the em-dash template-segment corruption in the stage-2
/// binary). `substring` is byte-indexed since
/// `plans/archive/STD_API_AUDIT_D4_PLAN.md` D4, so that mismatch no longer exists;
/// this stays as the explicit byte-level spelling. Only strips when both ends
/// are `"`; anything else passes through unchanged.
str_lit_unquote_bytes :: (fn(raw : String) -> String)({
  n := raw.as_bytes().len();
  if((n >= usize(2)) && ((raw.byte_at(usize(0)) == u8(34)) && (raw.byte_at(n - usize(1)) == u8(34))), {
    bytes := raw.as_bytes();
    inner := ArrayList(u8).new();
    (i : usize) = usize(1);
    while(i < (n - usize(1)), {
      inner.push(match(bytes.get(i), .Some(b) => b, .None => u8(0)));
      i = (i + usize(1));
    });
    String.from_bytes(inner)
  }, raw.clone())
});

// ---------------------------------------------------------------------------
// Compile-time profiling (Phase 0, plans/reference/INCREMENTAL_COMPILATION_ZIG_LESSONS.md §3)
// ---------------------------------------------------------------------------
// Process-wide, opt-in state behind `yo compile --profile` /
// `yo test --profile`. The module loader (per-module rows), codegen
// (collection/emission split + function census) and the compile driver
// (phase walls) all record here; the driver renders the stderr table and the
// `--profile-json` file. No std/time import in this leaf module: callers hold
// their own Instant handles and hand raw nanos in, so every record function
// stays a plain parallel-array append.
(g_prof_enabled : bool) = false;
profile_set_enabled :: (fn(on : bool) -> unit)({
  g_prof_enabled = on;
});
profile_enabled :: (fn() -> bool)(g_prof_enabled);
/// Phase wall-times, name → accumulated nanos. A phase entered twice in one
/// process SUMS (the shape watch rounds will need); first record inserts.
(g_prof_phase_names : ArrayList(String)) = ArrayList(String).new();
(g_prof_phase_nanos : ArrayList(i64)) = ArrayList(i64).new();
profile_record_phase :: (fn(name : String, nanos : i64) -> unit)({
  if(!g_prof_enabled, {
    return(());
  });
  (i : usize) = usize(0);
  while(i < g_prof_phase_names.len(), {
    if(g_prof_phase_names(i) == name, {
      g_prof_phase_nanos(i) = (g_prof_phase_nanos(i) + nanos);
      return(());
    });
    i = (i + usize(1));
  });
  g_prof_phase_names.push(name.clone());
  g_prof_phase_nanos.push(nanos);
});
profile_phase_count :: (fn() -> usize)(g_prof_phase_names.len());
profile_phase_name_at :: (fn(i : usize) -> String)(
  match(
    g_prof_phase_names.get(i),
    .Some(n) => n.clone(),
    .None => String.new()
  )
);
profile_phase_nanos_at :: (fn(i : usize) -> i64)(
  match(
    g_prof_phase_nanos.get(i),
    .Some(n) => n,
    .None => i64(0)
  )
);
/// Per-module read+parse and evaluation times, keyed by ABSOLUTE module path.
/// Rows are EXCLUSIVE — the wall a module's evaluation spends demand-loading
/// OTHER modules is subtracted out by the loader's nesting accumulator — so
/// the rows decompose total evaluation time without double-counting.
(g_prof_mod_paths : ArrayList(String)) = ArrayList(String).new();
(g_prof_mod_parse_ns : ArrayList(i64)) = ArrayList(i64).new();
(g_prof_mod_eval_ns : ArrayList(i64)) = ArrayList(i64).new();
profile_record_module :: (fn(path : String, parse_ns : i64, eval_ns : i64) -> unit)({
  if(!g_prof_enabled, {
    return(());
  });
  (i : usize) = usize(0);
  while(i < g_prof_mod_paths.len(), {
    if(g_prof_mod_paths(i) == path, {
      g_prof_mod_parse_ns(i) = (g_prof_mod_parse_ns(i) + parse_ns);
      g_prof_mod_eval_ns(i) = (g_prof_mod_eval_ns(i) + eval_ns);
      return(());
    });
    i = (i + usize(1));
  });
  g_prof_mod_paths.push(path.clone());
  g_prof_mod_parse_ns.push(parse_ns);
  g_prof_mod_eval_ns.push(eval_ns);
});
profile_module_count :: (fn() -> usize)(g_prof_mod_paths.len());
profile_module_path_at :: (fn(i : usize) -> String)(
  match(
    g_prof_mod_paths.get(i),
    .Some(p) => p.clone(),
    .None => String.new()
  )
);
profile_module_parse_ns_at :: (fn(i : usize) -> i64)(
  match(
    g_prof_mod_parse_ns.get(i),
    .Some(n) => n,
    .None => i64(0)
  )
);
profile_module_eval_ns_at :: (fn(i : usize) -> i64)(
  match(
    g_prof_mod_eval_ns.get(i),
    .Some(n) => n,
    .None => i64(0)
  )
);
/// Function census (Phase 0 §3 question 3): how many functions reach
/// emission, how many existed when body emission STARTED (the delta is the
/// specializations minted DURING emission — they have no single home module),
/// and how many are defined under std.
(g_prof_fn_total : usize) = usize(0);
(g_prof_fn_at_collect : usize) = usize(0);
(g_prof_fn_std : usize) = usize(0);
profile_record_function_census :: (
  fn(total : usize, at_collect : usize, std_defs : usize) -> unit
)({
  g_prof_fn_total = total;
  g_prof_fn_at_collect = at_collect;
  g_prof_fn_std = std_defs;
});
profile_fn_total :: (fn() -> usize)(g_prof_fn_total);
profile_fn_at_collect :: (fn() -> usize)(g_prof_fn_at_collect);
profile_fn_std :: (fn() -> usize)(g_prof_fn_std);
/// Clear every accumulator. `run_compile` calls this before arming the flag
/// so each compile's report is that compile alone.
profile_reset :: (fn() -> unit)({
  g_prof_enabled = false;
  g_prof_phase_names = ArrayList(String).new();
  g_prof_phase_nanos = ArrayList(i64).new();
  g_prof_mod_paths = ArrayList(String).new();
  g_prof_mod_parse_ns = ArrayList(i64).new();
  g_prof_mod_eval_ns = ArrayList(i64).new();
  g_prof_fn_total = usize(0);
  g_prof_fn_at_collect = usize(0);
  g_prof_fn_std = usize(0);
});

// ---------------------------------------------------------------------------
// Temp variable name generation
// ---------------------------------------------------------------------------
/// Compute the module-specific prefix for temp variables.
///
/// Every non-alphanumeric character of the module path is replaced with `_`
/// and the first 12 bytes are taken, which is unique enough to keep
/// modules' temps from colliding.
generate_temp_variable_name_prefix :: (fn(module_path : String) -> String)({
  result := String.new();
  bytes := module_path.as_bytes();
  n := bytes.len();
  i := usize(0);
  taken := usize(0);
  while((i < n) && (taken < usize(12)), {
    b := match(bytes.get(i), .Some(x) => x, .None => u8(0));
    is_alnum := (
      ((b >= u8(97)) && (b <= u8(122))) || // 'a'-'z'
      ((b >= u8(65)) && (b <= u8(90))) || // 'A'-'Z'
      ((b >= u8(48)) && (b <= u8(57))) // '0'-'9'
    );
    if(is_alnum, {
      result.push_byte(b);
    }, {
      result.push_str("_");
    });
    i = (i + usize(1));
    taken = (taken + usize(1));
  });
  out := `_${result}_temp_`;
  out
});
/// Generate a unique temp variable name for `_` discarded bindings.
///
/// The digit tail is an occurrence index for the mint SITE (source position, or
/// the caller's semantic slot when no position exists) instead of a global
/// counter — the `_<prefix>_temp_<digits>` shape the predicates match is
/// unchanged, and an edit elsewhere in the tree no longer renumbers every
/// later temp.
generate_new_temp_variable_name :: (
  fn(
    module_path : String,
    (row : usize) ?= usize(0),
    (column : usize) ?= usize(0),
    (slot : String) ?= String.new()
  ) -> String
)({
  prefix := generate_temp_variable_name_prefix(module_path);
  // The digit tail is a HASH of the mint site's identity (prefix + position
  // + slot) with this key's occurrence index appended — digits only, keeping
  // the `_<prefix>_temp_<digits>` shape the predicates match. The hash
  // separates DIFFERENT sites (the `_` LHS token and the discarded RHS expr
  // are two positions of one statement; a plain occurrence counter let both
  // take 0 and collide, and keying by the raw path is wrong — two spellings
  // sanitize to one prefix). The occurrence digit separates several
  // COEXISTING temps from one site — a trial and a real evaluation of the
  // same binding mint into the same frame with different types, which the
  // old global counter kept apart by construction.
  // The key uses the CANONICAL module path, not the truncated prefix: the
  // 12-byte prefix is shared by every `file:///home/**` module, so keying by
  // it merged the occurrence counters of unrelated modules — a new binding
  // anywhere renumbered same-position temps elsewhere. `file://` stripped,
  // the two spellings of one module hash equal; different modules never
  // share a key.
  mp := module_path.clone();
  if(mp.starts_with(String.from("file://")), {
    mp = mp.substring(usize(7), mp.len());
  });
  // Anchored to the enclosing top-level statement (`_anchored_position`), so
  // a comment added above a function leaves its temps' names alone.
  (pos_key, _pos_part) := _anchored_position(module_path, row, column);
  key := `${mp}:${pos_key}:${slot}`;
  k := fnv1a64(key);
  // EMISSION-name namespace (reset per compile) — see g_emission_occurrence.
  n := emission_occurrence_hashed(k);
  `${prefix}${k.to_string()}${n.to_string()}`
});
/// Return true if `var_name` was generated by `generate_new_temp_variable_name`
/// for the given `module_path`.
is_temp_variable_name :: (fn(module_path : String, var_name : String) -> bool)({
  prefix := generate_temp_variable_name_prefix(module_path);
  var_name.starts_with(prefix)
});
/// True iff `b` is a byte `generate_temp_variable_name_prefix` can emit
/// between its underscores: an alphanumeric it kept, or the `_` it
/// substituted.
_is_temp_prefix_byte :: (fn(b : u8) -> bool)(
  ((b >= u8(97)) && (b <= u8(122))) || ((b >= u8(65)) && (b <= u8(90))) ||
    (((b >= u8(48)) && (b <= u8(57))) || (b == u8(95)))
);
/// True iff `var_name` has the shape `generate_new_temp_variable_name`
/// produces for ANY module path: `_`, at most twelve prefix bytes, `_temp_`,
/// then one or more digits. The module-path-keyed `is_temp_variable_name`
/// needs the path spelling the generator saw, which a consumer holding only
/// the binding (the LSP's completion, which must hide these internals) does
/// not reliably have — the prelude's temporaries are minted against the plain
/// std path while their tokens carry the `file://` spelling
/// (issues/fixed/lsp-completion-lists-compiler-temporaries.md).
is_any_temp_variable_name :: (fn(var_name : String) -> bool)({
  bytes := var_name.as_bytes();
  n := bytes.len();
  // `_` + `_temp_` + one digit is the shortest possible spelling (an empty
  // module path yields the prefix `__temp_`).
  if((n < usize(8)) || (match(bytes.get(usize(0)), .Some(b) => b, .None => u8(0)) != u8(95)), {
    return(false);
  });
  marker := String.from("_temp_");
  // The prefix bytes span from index 1 to the `_temp_` marker; try each
  // legal length (0..=12) so a sanitized path that itself ends in `_temp_`
  // cannot confuse the split.
  (k : usize) = usize(0);
  while(k <= usize(12), {
    start := (usize(1) + k);
    if((start + usize(6)) < n, {
      (prefix_ok : bool) = true;
      (i : usize) = usize(1);
      while(i < start, {
        if(!_is_temp_prefix_byte(match(bytes.get(i), .Some(b) => b, .None => u8(0))), {
          prefix_ok = false;
        });
        i = (i + usize(1));
      });
      if(prefix_ok && (var_name.substring(start, start + usize(6)) == marker), {
        (digits_ok : bool) = true;
        (j : usize) = (start + usize(6));
        while(j < n, {
          d := match(bytes.get(j), .Some(b) => b, .None => u8(0));
          if((d < u8(48)) || (d > u8(57)), {
            digits_ok = false;
          });
          j = (j + usize(1));
        });
        if(digits_ok, {
          return(true);
        });
      });
    });
    k = (k + usize(1));
  });
  false
});
// ---------------------------------------------------------------------------
export(str_lit_unquote_bytes);

// ---------------------------------------------------------------------------
// Debug knobs (`YO_DEBUG_*`), read from the environment ONCE per name.
// ---------------------------------------------------------------------------
// The evaluator's hot paths (`synthesize`, identifier evaluation, parameter
// matching) each guarded a probe with `env.get(\`YO_DEBUG_...\`)` — a `getenv`
// per CALL, i.e. a locked linear scan of `environ` — and `__findenv_locked`
// was 4.4% of `check src/main.yo`'s self time
// (issues/fixed/check-self-time-is-two-linear-scans-was-self-bound-and-lookup-enum-cfid.md).
// The process environment does not change while the compiler runs, so the
// first read is the only one that has to touch libc.
(g_debug_knobs : HashMap(String, Option(String))) = HashMap(String, Option(String)).new();
/// The value of the `YO_DEBUG_*` knob `name`, read from the environment once.
debug_knob :: (fn(name : String) -> Option(String))(
  match(
    g_debug_knobs.get(name),
    .Some(cached) => cached,
    .None => {
      fresh := env.get(name);
      _prev := g_debug_knobs.insert(name, fresh);
      fresh
    }
  )
);
/// The loading key of the module whose evaluation is registering things
/// (mirrored here by `type_trait_methods.set_registration_owner`, which the
/// module loader drives), so low-level modules such as `types/intern.yo` can
/// owner-tag their registries without importing the evaluator.
(g_current_owner : String) = String.new();
set_current_owner :: (fn(owner : String) -> unit)({
  g_current_owner = owner;
});
current_owner :: (fn() -> String)(g_current_owner.clone());
/// Keys a registry wrote, grouped by the owner current at the write
/// (plans/EVALUATOR_MEMORY_REDUCTION.md Phase 1 step 5): `owned_keys_record`
/// at insert, `owned_keys_take` when `mm_invalidate_document` drops that owner.
OwnedKeys :: ref(struct(by_owner : HashMap(String, ArrayList(String))));
owned_keys_new :: (fn() -> OwnedKeys)(OwnedKeys(by_owner : HashMap(String, ArrayList(String)).new()));
/// Record `key` under the current owner (no-op outside a module load).
owned_keys_record :: (fn(log : OwnedKeys, key : String) -> unit)({
  if(g_current_owner.len() == usize(0), {
    return(());
  });
  match(
    log.by_owner.get(g_current_owner.clone()),
    .Some(keys) => keys.push(key),
    .None => {
      keys := ArrayList(String).new();
      keys.push(key);
      log.by_owner.insert(g_current_owner.clone(), keys);
      ()
    }
  );
});
/// Remove and return the keys recorded under `owner`.
owned_keys_take :: (fn(log : OwnedKeys, owner : String) -> ArrayList(String))(
  match(log.by_owner.remove(owner), .Some(keys) => keys, .None => ArrayList(String).new())
);
export(set_current_owner, current_owner, OwnedKeys, owned_keys_new, owned_keys_record, owned_keys_take);
export(debug_knob);
// ---------------------------------------------------------------------------
// Template interpolation scanning — shared by the lexer (where a template
// ends), the parser (where each `${...}` body ends, and where it sits in the
// file) and the formatter (the raw template text), so the three cannot
// disagree about which `}` closes an interpolation.
// ---------------------------------------------------------------------------
/// Scanner states: interpolation CODE, a `{ ... }` GROUP inside code, and the
/// literal TEXT of a template nested inside the code.
_TS_CODE :: u8(0);
_TS_GROUP :: u8(1);
_TS_TEXT :: u8(2);
/// Past-the-end index of the `"..."` / `'...'` literal whose opening quote is
/// at `at`: a backslash escapes the next byte, and a newline ends the scan
/// (an unterminated literal is the lexer's diagnostic, not this scanner's).
_skip_quoted_literal :: (fn(bytes : ArrayList(u8), at : usize) -> usize)({
  n := bytes.len();
  quote := bytes(at);
  (i : usize) = (at + usize(1));
  (end : usize) = n;
  while(i < n, {
    b := bytes(i);
    cond(
      (b == u8(0x5C)) => {
        i = (i + usize(2));
      },
      ((b == quote) || (b == u8(0x0A))) => {
        end = cond((b == quote) => (i + usize(1)), true => i);
        i = n;
      },
      true => {
        i = (i + usize(1));
      }
    );
  });
  end
});
/// Byte index of the `}` that closes a template interpolation whose body
/// starts at `start` (just past its `${`), or `bytes.len()` when the input
/// ends first.
///
/// The body is Yo CODE, so a brace inside a string or char literal, or inside
/// a nested template's text, is not a delimiter: `${f("}")}` closes at the
/// LAST brace, and `${g(`{`)}` likewise. Counting every brace (what the lexer,
/// parser and formatter each did) cut `${f("}")}` short and decoded the
/// template escapes of the code (`${s.concat("\n")}` became an unterminated
/// literal); see
/// issues/fixed/template-interpolation-body-is-not-scanned-as-code.md.
/// Byte-level on purpose: every delimiter is ASCII, and no byte of a UTF-8
/// multi-byte sequence is.
interpolation_body_end :: (fn(bytes : ArrayList(u8), start : usize) -> usize)({
  n := bytes.len();
  modes := ArrayList(u8).new();
  modes.push(_TS_CODE);
  (i : usize) = start;
  (result : usize) = n;
  while(i < n, {
    b := bytes(i);
    nb := cond(((i + usize(1)) < n) => bytes(i + usize(1)), true => u8(0));
    top := modes(modes.len() - usize(1));
    cond(
      (top == _TS_TEXT) => cond(
        (b == u8(0x5C)) => {
          i = (i + usize(2));
        },
        ((b == u8(0x24)) && (nb == u8(0x7B))) => {
          modes.push(_TS_CODE);
          i = (i + usize(2));
        },
        (b == u8(0x60)) => {
          modes.pop();
          i = (i + usize(1));
        },
        true => {
          i = (i + usize(1));
        }
      ),
      ((b == u8(0x22)) || (b == u8(0x27))) => {
        i = _skip_quoted_literal(bytes, i);
      },
      (b == u8(0x60)) => {
        modes.push(_TS_TEXT);
        i = (i + usize(1));
      },
      (b == u8(0x7B)) => {
        modes.push(_TS_GROUP);
        i = (i + usize(1));
      },
      (b == u8(0x7D)) => {
        modes.pop();
        if(modes.len() == usize(0), {
          result = i;
          i = n;
        }, {
          i = (i + usize(1));
        });
      },
      true => {
        i = (i + usize(1));
      }
    );
  });
  result
});
export(hex_digit_value, UnicodeEscape, scan_unicode_escape, interpolation_body_end);
export(
  generate_temp_variable_name_prefix,
  generate_new_temp_variable_name,
  is_temp_variable_name,
  is_any_temp_variable_name,
  profile_set_enabled,
  profile_enabled,
  profile_record_phase,
  profile_phase_count,
  profile_phase_name_at,
  profile_phase_nanos_at,
  profile_record_module,
  profile_module_count,
  profile_module_path_at,
  profile_module_parse_ns_at,
  profile_module_eval_ns_at,
  profile_record_function_census,
  profile_fn_total,
  profile_fn_at_collect,
  profile_fn_std,
  profile_reset
);

// ---------------------------------------------------------------------------
// Module identity — one spelling for the two forms a module path takes.
// ---------------------------------------------------------------------------
/// The canonical spelling of a module path. A demand-loaded module's tokens
/// and every `env.module_path` carry the `file://<abs>` cache key, but the
/// ENTRY module's tokens carry the path exactly as typed on the command line
/// (`src/lib.yo`, so diagnostics stay relative) — so two paths naming the
/// same file must never be compared with `==` (AGENTS.md; the
/// `--static-library exports no symbols` bug was exactly that). Strip the
/// scheme, absolutize against the cwd, normalize.
canonical_module_path :: (fn(p : String) -> String)({
  stripped := p.replace(String.from("file://"), String.new());
  abs := if(Path.new(stripped.clone()).is_absolute(), stripped, {
    cwd_str := match(cwd(), .Ok(c) => c.to_string(), .Err(_) => String.from("."));
    Path.new(cwd_str).join(Path.new(stripped)).to_string()
  });
  Path.new(abs).normalize().to_string()
});
/// The module path as an ID / DIAGNOSTIC spelling: `file://` stripped and,
/// when the module lives under the working directory, relative to it.
///
/// Two spellings of one module coexist (AGENTS.md): the ENTRY module's tokens
/// carry the path as typed on the command line, a demand-loaded module's carry
/// the `file://<abs>` cache key. A `VerifyTask.fn_id` built from the raw
/// `module_path` therefore renders one module two ways — and that id is not
/// only printed: it is the SMT mangling prefix (`mangle_vc_name`), so it
/// reaches the query text and through it the verification cache key. An
/// absolute path there makes every cached verdict machine-specific.
/// See `issues/fixed/verify-report-fn-id-carries-file-scheme-absolute-path.md`.
display_module_path :: (fn(p : String) -> String)({
  canon := canonical_module_path(p);
  cwd_str := match(cwd(), .Ok(c) => c.to_string(), .Err(_) => String.new());
  if(cwd_str.len() == usize(0), {
    return(canon);
  });
  match(
    Path.new(canon.clone()).strip_prefix(Path.new(cwd_str)),
    .Some(rel) => {
      rel_str := rel.to_string();
      // An empty remainder means the path IS the cwd — keep the canonical
      // spelling rather than rendering it as nothing.
      if(rel_str.len() == usize(0), canon, rel_str)
    },
    .None => canon
  )
});
/// The directory a module path lives in (canonical spelling).
canonical_module_dir :: (fn(p : String) -> String)(
  match(Path.new(canonical_module_path(p)).parent(), .Some(d) => d.to_string(), .None => String.new())
);
/// MEMBER VISIBILITY (plans/reference/MEMBER_VISIBILITY.md, decided
/// 2026-09-16): a struct field or impl method whose name starts with `_` is
/// private to the module that declares its type or impl AND to that module's
/// SIBLINGS — every module in the same directory. The sibling rule is what
/// the tree's own usage requires: every caller of `Mutex`'s `_raw_lock` /
/// `_raw_unlock` / `_raw_handle_ptr` lives in `std/sync/` beside `mutex.yo`.
/// No new syntax: the convention the tree already writes is what is enforced,
/// so `std/` needs no seed-gated marker to adopt it.
is_private_member_name :: (fn(name : String) -> bool)({
  if(!name.starts_with(String.from("_")), {
    return(false);
  });
  // `_0`, `_1`, … are POSITIONAL labels (tuple-shaped structs, `derive`d
  // payload records), not a privacy marker.
  rest := name.substring(usize(1), name.len());
  if(rest.len() == usize(0), {
    return(false);
  });
  (all_digits : bool) = true;
  (i : usize) = usize(0);
  while(i < rest.len(), {
    b := rest.byte_at(i);
    if((b < u8(48)) || (b > u8(57)), {
      all_digits = false;
    });
    i = (i + usize(1));
  });
  !all_digits
});
/// True when code in `access_module` may touch a private member declared in
/// `decl_module`: the same file, or a file in the same directory.
member_visible_from :: (fn(decl_module : String, access_module : String) -> bool)({
  d := canonical_module_path(decl_module.clone());
  a := canonical_module_path(access_module.clone());
  if(d == a, {
    return(true);
  });
  canonical_module_dir(decl_module) == canonical_module_dir(access_module)
});
/// True when `label` names a private member that code in `access_module` may
/// NOT touch: the name is `_`-prefixed and the declaring module (`Some`) is
/// neither `access_module` nor one of its same-directory siblings. `None`
/// (no declaring module recorded — builtins, source-namespace module structs,
/// trait-declared signatures) never blocks, and names starting with `___`
/// are compiler-reserved (the synthesized RC hooks) and never private.
private_member_blocked :: (
  fn(label : String, decl_module_opt : Option(String), access_module : String) -> bool
)({
  if(!is_private_member_name(label.clone()) || label.starts_with(String.from("___")), {
    return(false);
  });
  // A synthesized token has no lexical module — `synthetic_token`,
  // `placeholder_token`'s `"_"`, and the `auto-generated://` pseudo-path
  // `generate_expr_from_code` stamps on code the compiler writes for itself
  // (type_fns.yo's `VariantInfo(...)` / `TypeFieldInfo(...)` constructions):
  // compiler-generated accesses are never blocked.
  if((access_module.len() == usize(0)) || (access_module == "_") || access_module.starts_with(
    String.from("auto-generated://")
  ), {
    return(false);
  });
  match(
    decl_module_opt,
    .Some(d) => !member_visible_from(d, access_module),
    .None => false
  )
});
export(canonical_module_path, canonical_module_dir, display_module_path, is_private_member_name, member_visible_from, private_member_blocked);
