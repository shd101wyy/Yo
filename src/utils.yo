//! Top-level utilities for the self-hosted Yo compiler.
//!
//! 1-to-1 port of (a subset of) `src/utils.ts`.
//!
//! Provides:
//!   * `generate_temp_variable_name_prefix` — derives a per-module prefix
//!     used by `generate_new_temp_variable_name`. (TS counterpart uses the
//!     first 10 chars of SHA-1; yo-self uses a simpler alphanumeric
//!     sanitisation.)
//!   * `generate_new_temp_variable_name` — returns a fresh `_<prefix>_temp_<n>`
//!     identifier. Mirrors `generateNewTempVariableName` in `src/utils.ts`.
//!   * `is_temp_variable_name` — predicate matching names produced by
//!     `generate_new_temp_variable_name`. Mirrors `isTempVariableName`.
//!   * `random_id` — module-scoped fresh ID counter. Mirrors `randomId`.
//!
//! Phase A.4.1: split out of src/evaluator/utils.yo so that the file
//! mirrors `src/utils.ts` (top-level utility helpers) instead of being
//! tangled into the evaluator-only utils module.
//!
//! Not yet ported from src/utils.ts:
//!   * `generateModuleId`, `resetModuleIdCounter`, `generateVarialeId`,
//!     `hashString`, `clearAllModuleCounters`. These are deferred until
//!     their TS callers gain yo-self counterparts.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
// ---------------------------------------------------------------------------
// Position-stable IDs (Phase 2, plans/INCREMENTAL_COMPILATION_ZIG_LESSONS.md §5)
// ---------------------------------------------------------------------------
/// FNV-1a 64 over the bytes (same constants as std/hash's Fnv1aHasher —
/// inlined here because the Hasher trait is not exported from std/hash).
/// The shared content-hash behind the stable id/name schemes.
fnv1a64 :: (fn(s : String) -> u64)({
  (state : u64) = u64(14695981039346656037);
  bytes := s.as_bytes();
  (i : usize) = usize(0);
  while(i < bytes.len(), {
    b := match(bytes.get(i), .Some(x) => x, .None => u8(0));
    state = ((state ^ u64(b)) * u64(1099511628211));
    i = (i + usize(1));
  });
  state
});
/// The identity half of a function's emitted C name: the last two path
/// segments of its defining module (readable, and "index" only collides
/// across same-named directories), every byte outside [A-Za-z0-9_] mapped
/// to `_`, extension `.yo` dropped. Deterministic in the module's PATH,
/// which an edit elsewhere in the tree never changes.
_stable_id_module_stem :: (fn(module_path : String) -> String)({
  p := module_path.clone();
  if(p.starts_with(String.from("file://")), {
    p = p.substring(usize(7), p.len());
  });
  if((p.len() > usize(3)) && p.ends_with(String.from(".yo")), {
    p = p.substring(usize(0), p.len() - usize(3));
  });
  segments := p.split("/");
  out := String.new();
  (start_at : usize) = cond(
    (segments.len() >= usize(2)) => (segments.len() - usize(2)),
    true => usize(0)
  );
  (si : usize) = usize(0);
  while(si < segments.len(), {
    if(si >= start_at, {
      if(out.len() > usize(0), {
        out.push_str("__");
      });
      seg := match(segments.get(si), .Some(s) => s, .None => String.new());
      bytes := seg.as_bytes();
      (bi : usize) = usize(0);
      while(bi < bytes.len(), {
        b := match(bytes.get(bi), .Some(x) => x, .None => u8(0));
        cond(
          (((b >= u8(97)) && (b <= u8(122))) || ((b >= u8(65)) && (b <= u8(90)))) => {
            out.push_byte(b);
          },
          ((b >= u8(48)) && (b <= u8(57))) => {
            out.push_byte(b);
          },
          true => {
            out.push_str("_");
          }
        );
        bi = (bi + usize(1));
      });
    });
    si = (si + usize(1));
  });
  out
});
/// Mint registry: stable id → the `<module_path>:<row>:<column>` source key
/// that claimed it. The SAME source position minting again (a re-evaluated
/// generation of the same module) REUSES its id — identity merge, exactly
/// what the closure fid-source registry already does. A DIFFERENT source
/// position colliding on the same stem+row+col (two `…/x/index.yo` files)
/// takes the `_x2`, `_x3`… suffixes.
(g_stable_id_owner : HashMap(String, String)) = HashMap(String, String).new();
/// Occurrence counters (Phase 2 companion to `stable_position_id`): how many
/// times each source position has minted a SAME-SITE-DISTINCT name in this
/// process. For constructs that legitimately mint several names from one
/// site — an `_` binding evaluated per inlined call, a loop label re-emitted
/// per enclosing function — the k-th mint gets suffix `_n<k-1>`, so the names
/// stay a function of WHAT is at that position, not of the global mint order.
(g_stable_occurrence : HashMap(String, usize)) = HashMap(String, usize).new();
/// The next 0-based occurrence index for `key`. Keys are caller-composed:
/// `<module>:<row>:<column>` where a source position exists, a semantic key
/// (`<module>:dup:<var>`) where one does not.
stable_occurrence_key :: (fn(key : String) -> usize)({
  next := match(
    g_stable_occurrence.get(key),
    .Some(n) => n,
    .None => usize(0)
  );
  g_stable_occurrence.insert(key.clone(), next + usize(1));
  next
});
/// A stable, unique-per-emission label for `prefix` at a source position:
/// `<prefix>r<row>c<col>_n<k>`, where k is that position's occurrence index.
/// The codegen label/temp mints that used to embed the global `random_id`
/// counter (loop labels, short-circuit temps, …) go through here (Phase 2).
stable_label_id :: (
  fn(prefix : String, module_path : String, row : usize, column : usize) -> String
)({
  k := stable_occurrence_key(`${module_path}:${row.to_string()}:${column.to_string()}`);
  `${prefix}r${row.to_string()}c${column.to_string()}_n${k.to_string()}`
});
/// A stable ID for a definition: `<prefix><module_stem>_r<row>c<column>`.
/// Content-derived (defining module + source position), so an edit anywhere
/// ELSE in the tree leaves it — and every emitted C name derived from it —
/// byte-identical. Callers that genuinely need per-mint uniqueness (gensym)
/// keep `random_id`.
stable_position_id :: (
  fn(prefix : String, module_path : String, row : usize, column : usize) -> String
)({
  src_key := `${module_path}:${row.to_string()}:${column.to_string()}`;
  base := `${prefix}${_stable_id_module_stem(module_path)}_r${row.to_string()}c${column.to_string()}`;
  (candidate : String) = base.clone();
  (suffix : usize) = usize(1);
  while(runtime(true), {
    match(
      g_stable_id_owner.get(candidate),
      .Some(owner) => {
        if(owner == src_key, {
          return(candidate);
        });
        suffix = (suffix + usize(1));
        candidate = `${base}_x${suffix.to_string()}`;
      },
      .None => {
        g_stable_id_owner.insert(candidate.clone(), src_key.clone());
        return(candidate);
      }
    );
  });
  candidate
});
export(stable_position_id, stable_occurrence_key, stable_label_id, fnv1a64, _stable_id_module_stem);
/// Byte-exact StrLit unquote: drop the first and last BYTE (the ASCII `"`
/// delimiters yo-self's StrLit convention keeps). It was written because the
/// historical pattern `raw.substring(1, raw.len()-1)` mixed a BYTE length with
/// a then-CHAR-indexed `substring` — correct for ASCII, CORRUPTING for
/// multibyte content (the em-dash template-segment corruption in the stage-2
/// binary). `substring` is byte-indexed since
/// `plans/archive/STD_API_AUDIT_D4_PLAN.md` D4, so that mismatch no longer exists;
/// this stays as the explicit byte-level spelling. Only strips when both ends
/// are `"`; anything else passes through unchanged.
str_lit_unquote_bytes :: (fn(raw : String) -> String)({
  n := raw.as_bytes().len();
  if((n >= usize(2)) && ((raw.byte_at(usize(0)) == u8(34)) && (raw.byte_at(n - usize(1)) == u8(34))), {
    bytes := raw.as_bytes();
    inner := ArrayList(u8).new();
    (i : usize) = usize(1);
    while(i < (n - usize(1)), {
      inner.push(match(bytes.get(i), .Some(b) => b, .None => u8(0)));
      i = (i + usize(1));
    });
    String.from_bytes(inner)
  }, raw.clone())
});

// ---------------------------------------------------------------------------
// Compile-time profiling (Phase 0, plans/INCREMENTAL_COMPILATION_ZIG_LESSONS.md §3)
// ---------------------------------------------------------------------------
// Process-wide, opt-in state behind `yo compile --profile` /
// `yo test --profile`. The module loader (per-module rows), codegen
// (collection/emission split + function census) and the compile driver
// (phase walls) all record here; the driver renders the stderr table and the
// `--profile-json` file. No std/time import in this leaf module: callers hold
// their own Instant handles and hand raw nanos in, so every record function
// stays a plain parallel-array append.
(g_prof_enabled : bool) = false;
profile_set_enabled :: (fn(on : bool) -> unit)({
  g_prof_enabled = on;
});
profile_enabled :: (fn() -> bool)(g_prof_enabled);
/// Phase wall-times, name → accumulated nanos. A phase entered twice in one
/// process SUMS (the shape watch rounds will need); first record inserts.
(g_prof_phase_names : ArrayList(String)) = ArrayList(String).new();
(g_prof_phase_nanos : ArrayList(i64)) = ArrayList(i64).new();
profile_record_phase :: (fn(name : String, nanos : i64) -> unit)({
  if(!g_prof_enabled, {
    return(());
  });
  (i : usize) = usize(0);
  while(i < g_prof_phase_names.len(), {
    if(g_prof_phase_names(i) == name, {
      g_prof_phase_nanos(i) = (g_prof_phase_nanos(i) + nanos);
      return(());
    });
    i = (i + usize(1));
  });
  g_prof_phase_names.push(name.clone());
  g_prof_phase_nanos.push(nanos);
});
profile_phase_count :: (fn() -> usize)(g_prof_phase_names.len());
profile_phase_name_at :: (fn(i : usize) -> String)(
  match(
    g_prof_phase_names.get(i),
    .Some(n) => n.clone(),
    .None => String.new()
  )
);
profile_phase_nanos_at :: (fn(i : usize) -> i64)(
  match(
    g_prof_phase_nanos.get(i),
    .Some(n) => n,
    .None => i64(0)
  )
);
/// Per-module read+parse and evaluation times, keyed by ABSOLUTE module path.
/// Rows are EXCLUSIVE — the wall a module's evaluation spends demand-loading
/// OTHER modules is subtracted out by the loader's nesting accumulator — so
/// the rows decompose total evaluation time without double-counting.
(g_prof_mod_paths : ArrayList(String)) = ArrayList(String).new();
(g_prof_mod_parse_ns : ArrayList(i64)) = ArrayList(i64).new();
(g_prof_mod_eval_ns : ArrayList(i64)) = ArrayList(i64).new();
profile_record_module :: (fn(path : String, parse_ns : i64, eval_ns : i64) -> unit)({
  if(!g_prof_enabled, {
    return(());
  });
  (i : usize) = usize(0);
  while(i < g_prof_mod_paths.len(), {
    if(g_prof_mod_paths(i) == path, {
      g_prof_mod_parse_ns(i) = (g_prof_mod_parse_ns(i) + parse_ns);
      g_prof_mod_eval_ns(i) = (g_prof_mod_eval_ns(i) + eval_ns);
      return(());
    });
    i = (i + usize(1));
  });
  g_prof_mod_paths.push(path.clone());
  g_prof_mod_parse_ns.push(parse_ns);
  g_prof_mod_eval_ns.push(eval_ns);
});
profile_module_count :: (fn() -> usize)(g_prof_mod_paths.len());
profile_module_path_at :: (fn(i : usize) -> String)(
  match(
    g_prof_mod_paths.get(i),
    .Some(p) => p.clone(),
    .None => String.new()
  )
);
profile_module_parse_ns_at :: (fn(i : usize) -> i64)(
  match(
    g_prof_mod_parse_ns.get(i),
    .Some(n) => n,
    .None => i64(0)
  )
);
profile_module_eval_ns_at :: (fn(i : usize) -> i64)(
  match(
    g_prof_mod_eval_ns.get(i),
    .Some(n) => n,
    .None => i64(0)
  )
);
/// Function census (Phase 0 §3 question 3): how many functions reach
/// emission, how many existed when body emission STARTED (the delta is the
/// specializations minted DURING emission — they have no single home module),
/// and how many are defined under std.
(g_prof_fn_total : usize) = usize(0);
(g_prof_fn_at_collect : usize) = usize(0);
(g_prof_fn_std : usize) = usize(0);
profile_record_function_census :: (
  fn(total : usize, at_collect : usize, std_defs : usize) -> unit
)({
  g_prof_fn_total = total;
  g_prof_fn_at_collect = at_collect;
  g_prof_fn_std = std_defs;
});
profile_fn_total :: (fn() -> usize)(g_prof_fn_total);
profile_fn_at_collect :: (fn() -> usize)(g_prof_fn_at_collect);
profile_fn_std :: (fn() -> usize)(g_prof_fn_std);
/// Clear every accumulator. `run_compile` calls this before arming the flag
/// so each compile's report is that compile alone.
profile_reset :: (fn() -> unit)({
  g_prof_enabled = false;
  g_prof_phase_names = ArrayList(String).new();
  g_prof_phase_nanos = ArrayList(i64).new();
  g_prof_mod_paths = ArrayList(String).new();
  g_prof_mod_parse_ns = ArrayList(i64).new();
  g_prof_mod_eval_ns = ArrayList(i64).new();
  g_prof_fn_total = usize(0);
  g_prof_fn_at_collect = usize(0);
  g_prof_fn_std = usize(0);
});

// ---------------------------------------------------------------------------
// Temp variable name generation
// ---------------------------------------------------------------------------
/// Compute the module-specific prefix for temp variables.
///
/// In TypeScript this uses the first 10 characters of SHA-1(modulePath).
/// Here we use a simplified sanitisation: replace every non-alphanumeric
/// character with `_` and take the first 12 bytes, which is unique
/// enough for the yo-self bootstrap.
///
/// Mirrors `generateTempVariableNamePrefix` in `src/utils.ts`.
generate_temp_variable_name_prefix :: (fn(module_path : String) -> String)({
  result := String.new();
  bytes := module_path.as_bytes();
  n := bytes.len();
  i := usize(0);
  taken := usize(0);
  while((i < n) && (taken < usize(12)), {
    b := match(bytes.get(i), .Some(x) => x, .None => u8(0));
    is_alnum := (
      ((b >= u8(97)) && (b <= u8(122))) || // 'a'-'z'
      ((b >= u8(65)) && (b <= u8(90))) || // 'A'-'Z'
      ((b >= u8(48)) && (b <= u8(57))) // '0'-'9'
    );
    if(is_alnum, {
      result.push_byte(b);
    }, {
      result.push_str("_");
    });
    i = (i + usize(1));
    taken = (taken + usize(1));
  });
  out := `_${result}_temp_`;
  out
});
/// Generate a unique temp variable name for `_` discarded bindings.
///
/// Mirrors `generateNewTempVariableName` in `src/utils.ts`. Phase 2: the
/// digit tail is an occurrence index for the mint SITE (source position, or
/// the caller's semantic slot when no position exists) instead of a global
/// counter — the `_<prefix>_temp_<digits>` shape the predicates match is
/// unchanged, and an edit elsewhere in the tree no longer renumbers every
/// later temp.
generate_new_temp_variable_name :: (
  fn(
    module_path : String,
    (row : usize) ?= usize(0),
    (column : usize) ?= usize(0),
    (slot : String) ?= String.new()
  ) -> String
)({
  prefix := generate_temp_variable_name_prefix(module_path);
  // The digit tail is a HASH of the mint site's identity (prefix + position
  // + slot) with this key's occurrence index appended — digits only, keeping
  // the `_<prefix>_temp_<digits>` shape the predicates match. The hash
  // separates DIFFERENT sites (the `_` LHS token and the discarded RHS expr
  // are two positions of one statement; a plain occurrence counter let both
  // take 0 and collide, and keying by the raw path is wrong — two spellings
  // sanitize to one prefix). The occurrence digit separates several
  // COEXISTING temps from one site — a trial and a real evaluation of the
  // same binding mint into the same frame with different types, which the
  // old global counter kept apart by construction.
  key := `${prefix}:${row.to_string()}:${column.to_string()}:${slot}`;
  k := fnv1a64(key);
  n := stable_occurrence_key(key);
  `${prefix}${k.to_string()}${n.to_string()}`
});
/// Return true if `var_name` was generated by `generate_new_temp_variable_name`
/// for the given `module_path`.
///
/// Mirrors `isTempVariableName` in `src/utils.ts`.
is_temp_variable_name :: (fn(module_path : String, var_name : String) -> bool)({
  prefix := generate_temp_variable_name_prefix(module_path);
  var_name.starts_with(prefix)
});
/// True iff `b` is a byte `generate_temp_variable_name_prefix` can emit
/// between its underscores: an alphanumeric it kept, or the `_` it
/// substituted.
_is_temp_prefix_byte :: (fn(b : u8) -> bool)(
  ((b >= u8(97)) && (b <= u8(122))) || ((b >= u8(65)) && (b <= u8(90))) ||
    (((b >= u8(48)) && (b <= u8(57))) || (b == u8(95)))
);
/// True iff `var_name` has the shape `generate_new_temp_variable_name`
/// produces for ANY module path: `_`, at most twelve prefix bytes, `_temp_`,
/// then one or more digits. The module-path-keyed `is_temp_variable_name`
/// needs the path spelling the generator saw, which a consumer holding only
/// the binding (the LSP's completion, which must hide these internals) does
/// not reliably have — the prelude's temporaries are minted against the plain
/// std path while their tokens carry the `file://` spelling
/// (issues/fixed/lsp-completion-lists-compiler-temporaries.md).
is_any_temp_variable_name :: (fn(var_name : String) -> bool)({
  bytes := var_name.as_bytes();
  n := bytes.len();
  // `_` + `_temp_` + one digit is the shortest possible spelling (an empty
  // module path yields the prefix `__temp_`).
  if((n < usize(8)) || (match(bytes.get(usize(0)), .Some(b) => b, .None => u8(0)) != u8(95)), {
    return(false);
  });
  marker := String.from("_temp_");
  // The prefix bytes span from index 1 to the `_temp_` marker; try each
  // legal length (0..=12) so a sanitized path that itself ends in `_temp_`
  // cannot confuse the split.
  (k : usize) = usize(0);
  while(k <= usize(12), {
    start := (usize(1) + k);
    if((start + usize(6)) < n, {
      (prefix_ok : bool) = true;
      (i : usize) = usize(1);
      while(i < start, {
        if(!_is_temp_prefix_byte(match(bytes.get(i), .Some(b) => b, .None => u8(0))), {
          prefix_ok = false;
        });
        i = (i + usize(1));
      });
      if(prefix_ok && (var_name.substring(start, start + usize(6)) == marker), {
        (digits_ok : bool) = true;
        (j : usize) = (start + usize(6));
        while(j < n, {
          d := match(bytes.get(j), .Some(b) => b, .None => u8(0));
          if((d < u8(48)) || (d > u8(57)), {
            digits_ok = false;
          });
          j = (j + usize(1));
        });
        if(digits_ok, {
          return(true);
        });
      });
    });
    k = (k + usize(1));
  });
  false
});
// ---------------------------------------------------------------------------
// random_id
// ---------------------------------------------------------------------------
/// Global counter for generating module-scoped unique IDs.
/// Mirrors the `moduleIdCounters` map in `src/utils.ts`.
///
/// Note: We use a single global counter (not per-module) for simplicity.
/// The resulting IDs are globally unique and will not satisfy
/// `is_temp_variable_name` (they start with `yo_id_`, not `_…_temp_`).
(g_random_id_counter : usize) = usize(0);
/// Generate a unique ID for a module-scoped value (e.g. recur result names).
///
/// Mirrors `randomId` in `src/utils.ts`.
random_id :: (fn(_module_path : String) -> String)({
  count := g_random_id_counter;
  g_random_id_counter = (g_random_id_counter + usize(1));
  `yo_id_${count.to_string()}`
});
export(str_lit_unquote_bytes);
export(
  generate_temp_variable_name_prefix,
  generate_new_temp_variable_name,
  is_temp_variable_name,
  is_any_temp_variable_name,
  random_id,
  profile_set_enabled,
  profile_enabled,
  profile_record_phase,
  profile_phase_count,
  profile_phase_name_at,
  profile_phase_nanos_at,
  profile_record_module,
  profile_module_count,
  profile_module_path_at,
  profile_module_parse_ns_at,
  profile_module_eval_ns_at,
  profile_record_function_census,
  profile_fn_total,
  profile_fn_at_collect,
  profile_fn_std,
  profile_reset
);
