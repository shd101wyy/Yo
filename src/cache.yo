//! Global cache directory resolution for the Yo build system.
//!
//! Resolution order for the cache root:
//!   1. `$YO_CACHE_DIR`  (environment variable, highest priority)
//!   2. `$XDG_CACHE_HOME/yo`
//!   3. `~/.cache/yo`  (Linux/macOS default)
//!   4. `%LOCALAPPDATA%\yo\cache`  (Windows default)
//!
//! Cache structure (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.4):
//! ```
//!   <cache_root>/
//!     store/sha256/<64 hex>/   — one extracted package tree per content hash
//!     store/sha256/<64 hex>.verified — written after a full hash confirmed the tree
//!     git/<sha256(url)>.git/   — bare mirrors of the remotes, fetched on demand
//!     index/<sha256(url)>.tags — the last `git ls-remote --tags` answer per remote
//!     store.lock               — the flock around store and mirror mutations
//!     projects                 — the projects `yo install` ran in (for `yo cache gc`)
//!     versions/                — versioned Yo installations (<version>/)
//! ```
//!
//! A package tree is named by the hash of its normalized contents
//! (`fetch.compute_content_hash`, the lock's `integrity`), so the same tree
//! reached through two names or two commits is stored once, and a tree whose
//! contents drift no longer answers to its name.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ sha256_hex } :: import("std/crypto/sha256");
{ Path } :: import("std/path");
{ env, current_exe, home_dir } :: import("std/env");
{ platform, Platform } :: import("std/process");
{ create_dir_all } :: import("std/fs/dir");
{ AnyError, Exception, IoExn } :: import("std/error");
// ---------------------------------------------------------------------------
// Cache root resolution
// ---------------------------------------------------------------------------
/// Return the global Yo cache root directory.
///
/// Resolution order:
///   1. `$YO_CACHE_DIR`
///   2. `$XDG_CACHE_HOME/yo`
///   3. Platform default — `%LOCALAPPDATA%\yo\cache` (Windows) or `~/.cache/yo`
get_global_cache_dir :: (fn() -> String)({
  yo_cache_env := env.get(String.from("YO_CACHE_DIR"));
  match(
    yo_cache_env,
    .Some(d) => d,
    .None => {
      xdg := env.get(String.from("XDG_CACHE_HOME"));
      match(
        xdg,
        .Some(d) => d.concat(String.from("/yo")),
        .None =>
          cond(
            (platform == Platform.Windows) => {
              local_app_data := match(
                env.get(String.from("LOCALAPPDATA")),
                .Some(p) => p,
                .None => match(
                  home_dir(),
                  .Some(h) => h.concat(String.from("/AppData/Local")),
                  .None => String.from("C:/Users/Default/AppData/Local")
                )
              );
              local_app_data.concat(String.from("/yo/cache"))
            },
            true => match(
              home_dir(),
              .Some(h) => h.concat(String.from("/.cache/yo")),
              .None => String.from("~/.cache/yo")
            )
          )
      )
    }
  )
});
/// The lock's `integrity` values start with this; the store strips it.
INTEGRITY_PREFIX :: "sha256-";
/// `<cache_root>/store/sha256` — the package trees, one directory per hash.
get_store_dir :: (fn(cache_root : String) -> String)(
  cache_root.concat(String.from("/store/sha256"))
);
_is_lower_hex :: (fn(s : String) -> bool)({
  bytes := s.as_bytes();
  n := bytes.len();
  (i : usize) = usize(0);
  while(i < n, {
    b := match(bytes.get(i), .Some(x) => x, .None => u8(0));
    is_digit := ((b >= u8(48)) && (b <= u8(57)));
    is_af := ((b >= u8(97)) && (b <= u8(102)));
    if(!(is_digit || is_af), {
      return(false);
    });
    i = (i + usize(1));
  });
  true
});
/// The store directory of the tree whose lock `integrity` is `sha256-<64 hex>`
/// (`<cache_root>/store/sha256/<hex>`), or what is wrong with the value.
/// Pure path arithmetic — the manifest resolver computes it synchronously from
/// `yo.lock`; the fetcher writes into it.
store_tree_dir :: (fn(cache_root : String, integrity : String) -> Result(String, String))({
  prefix := String.from(INTEGRITY_PREFIX);
  if(!integrity.starts_with(prefix.clone()), {
    return(Result(String, String).Err(`integrity "${integrity}" does not start with "${INTEGRITY_PREFIX}"`));
  });
  hex := integrity.substring(prefix.len(), integrity.len());
  if((hex.len() != usize(64)) || !_is_lower_hex(hex.clone()), {
    return(Result(String, String).Err(`integrity "${integrity}" is not "${INTEGRITY_PREFIX}" followed by 64 lowercase hex digits`));
  });
  dir := get_store_dir(cache_root);
  dir.push_str("/");
  dir.push_string(hex);
  Result(String, String).Ok(dir)
});
/// `<tree dir>.verified` — a sibling file written only after a full hash of
/// the landed tree matched its name. A tree without it is re-hashed before it
/// is trusted (an interrupted install, a hand-edited store).
store_verified_marker :: (fn(tree_dir : String) -> String)(
  tree_dir.concat(String.from(".verified"))
);
/// `<cache_root>/git` — the bare mirrors.
get_git_mirrors_dir :: (fn(cache_root : String) -> String)(
  cache_root.concat(String.from("/git"))
);
/// The hex SHA-256 of a remote URL — the file-system name every per-remote
/// artifact (mirror, tag index) is filed under.
url_key :: (fn(url : String) -> String)(
  sha256_hex(url.as_bytes())
);
/// `<cache_root>/git/<sha256(url)>.git` — the bare mirror of `url`.
git_mirror_dir :: (fn(cache_root : String, url : String) -> String)({
  dir := get_git_mirrors_dir(cache_root);
  dir.push_str("/");
  dir.push_string(url_key(url));
  dir.push_str(".git");
  dir
});
/// `<cache_root>/index` — the per-remote `ls-remote` answers.
get_index_dir :: (fn(cache_root : String) -> String)(
  cache_root.concat(String.from("/index"))
);
/// `<cache_root>/index/<sha256(url)>.tags` — the last `git ls-remote --tags`
/// output for `url`, rewritten every online run and the ONLY tag source under
/// `--offline`.
tags_index_path :: (fn(cache_root : String, url : String) -> String)({
  p := get_index_dir(cache_root);
  p.push_str("/");
  p.push_string(url_key(url));
  p.push_str(".tags");
  p
});
/// `<cache_root>/store.lock` — held (`flock`) around every store and mirror
/// mutation, so two installs never extract into the same name at once.
store_lock_path :: (fn(cache_root : String) -> String)(
  cache_root.concat(String.from("/store.lock"))
);
/// `<cache_root>/projects` — one absolute project directory per line, every
/// project `yo install` has resolved; `yo cache gc` keeps what their locks
/// reference and forgets projects that no longer exist.
projects_registry_path :: (fn(cache_root : String) -> String)(
  cache_root.concat(String.from("/projects"))
);
/// Create the store, mirror and index directories and return the cache root.
ensure_cache_layout :: (fn(io : Io, exn : Exception) -> Impl(Future(String, IoExn)))(
  io.async((e : IoExn) => {
    root := get_global_cache_dir();
    e.io.await(create_dir_all(Path.new(get_store_dir(root.clone())), e.io), e);
    e.io.await(create_dir_all(Path.new(get_git_mirrors_dir(root.clone())), e.io), e);
    e.io.await(create_dir_all(Path.new(get_index_dir(root.clone())), e.io), e);
    root
  })
);
/// Return the global versioned Yo installations cache directory (`<cache_root>/versions`).
get_global_versions_cache_dir :: (fn() -> String)(
  get_global_cache_dir().concat(String.from("/versions"))
);
/// Return the cache directory for a specific Yo version.
get_version_cache_dir :: (fn(version : String) -> String)(
  get_global_versions_cache_dir().concat(String.from("/")).concat(version)
);
/// Return the INSTALL root that `scripts/install.sh` lays versions out under —
/// `<prefix>/lib/yo` — or `.None` when this binary was not script-installed.
///
/// Why this exists (P3 item 1's "installer/cache unification"): the installer
/// writes `<prefix>/lib/yo/<tag>/{bin,std,vendor}` while `yo version install`
/// writes `<cache_root>/versions/<version>/`. Both are the SAME shape — a plain
/// bundle extraction — but nothing looked in the installer's root, so a
/// `.yo-version` pin could not see a script-installed version and would offer
/// to re-download a version already on disk.
///
/// The re-rooting is derived, not configured: a script-installed compiler runs
/// from `<prefix>/lib/yo/<tag>/bin/yo`, so the binary can recover its own root
/// by walking up from `current_exe()`. Nothing has to be passed in, and it
/// works for any `--prefix` the user chose.
///
/// DELIBERATELY NOT the other direction (installing INTO the version cache).
/// A cache is by definition safe to delete — `yo version clean` removes the
/// whole versions tree — so installing there would let a routine cache clean
/// delete the user's actual installation.
///
/// Returns `.None` rather than guessing when the layout does not match (a
/// bundle run in place, a dev build out of `yo-out/`, a binary copied to
/// `/tmp`), so callers fall back to cache-only behaviour exactly as before.
get_install_versions_dir :: (fn() -> Option(String))({
  exe := match(current_exe(), .Ok(p) => p, .Err(_) => return(Option(String).None));
  // <prefix>/lib/yo/<tag>/bin/yo  ->  walk up bin and <tag>, then require the
  // grandparent to be `yo` sitting directly inside `lib`. Both names are
  // checked: `<x>/yo/<tag>/bin/yo` alone is a shape a dev tree could hit.
  bin_dir := match(exe.parent(), .Some(p) => p, .None => return(Option(String).None));
  tag_dir := match(bin_dir.parent(), .Some(p) => p, .None => return(Option(String).None));
  yo_dir := match(tag_dir.parent(), .Some(p) => p, .None => return(Option(String).None));
  lib_dir := match(yo_dir.parent(), .Some(p) => p, .None => return(Option(String).None));
  yo_name := match(yo_dir.file_name(), .Some(n) => n, .None => return(Option(String).None));
  lib_name := match(lib_dir.file_name(), .Some(n) => n, .None => return(Option(String).None));
  if((yo_name != "yo") || (lib_name != "lib"), {
    return(Option(String).None);
  });
  Option(String).Some(yo_dir.to_string())
});
/// Return the install directory for a specific version, when this binary was
/// script-installed. `.None` otherwise.
get_install_version_dir :: (fn(version : String) -> Option(String))(
  match(
    get_install_versions_dir(),
    .Some(root) => Option(String).Some(root.concat(String.from("/")).concat(version)),
    .None => Option(String).None
  )
);
export(
  get_global_cache_dir,
  INTEGRITY_PREFIX,
  get_store_dir,
  store_tree_dir,
  store_verified_marker,
  get_git_mirrors_dir,
  url_key,
  git_mirror_dir,
  get_index_dir,
  tags_index_path,
  store_lock_path,
  projects_registry_path,
  ensure_cache_layout,
  get_global_versions_cache_dir,
  get_version_cache_dir,
  get_install_versions_dir,
  get_install_version_dir
);
