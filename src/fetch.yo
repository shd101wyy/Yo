//! The dependency store primitives (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md
//! §4.4): `fetch_package` brings ONE git package at ONE ref into the
//! content-addressed store (`<cache>/store/sha256/<hash>`) — deciding its
//! commit (the lock's, or `git ls-remote`), reusing a stored tree the lock
//! names, otherwise bringing the commit into the remote's bare mirror
//! (`<cache>/git/<sha256(url)>.git`), extracting it, hashing it and landing
//! it under its hash — plus the content hashing itself (`compute_content_hash`),
//! the `ls-remote --tags` index (`<cache>/index`), the `flock` around store
//! mutations, the projects registry and `yo cache gc`. Which packages and
//! which refs is the resolver's decision (`src/resolver.yo`); `yo.lock` itself
//! is `src/lock_file.yo`.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ Command } :: import("std/process/command");
{ AnyError, Exception, IoExn } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ Path } :: import("std/path");
{ File, OpenMode, read, read_to_string, write_string, exists } :: import("std/fs/file");
{ DirEntry, FileType, read_dir, remove_file, rename, create_dir_all } :: import("std/fs/dir");
{ remove_dir_all } :: import("std/fs/walker");
{ flock, LOCK_EX, LOCK_UN } :: import("std/sys/lock");
{ Rng } :: import("std/rand");
{ Sha256 } :: import("std/crypto/sha256");
hex :: import("std/encoding/hex");
{
  get_store_dir,
  store_tree_dir,
  store_verified_marker,
  get_git_mirrors_dir,
  url_key,
  git_mirror_dir,
  get_index_dir,
  tags_index_path,
  store_lock_path,
  projects_registry_path
} :: import("./cache.yo");
{ LockFile, parse_lock_file } :: import("./lock_file.yo");
{ abs_under } :: import("./manifest.yo");
// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------
/// What fetching one package into the store yields.
FetchedPackage :: ref(
  struct(
    /// The commit the package's tree is at.
    commit : String,
    /// `sha256-…` of the normalized tree (`compute_content_hash`) — the
    /// lock's `integrity` and the tree's name in the store.
    integrity : String,
    /// The store directory holding the tree.
    dir : String
  )
);
// ---------------------------------------------------------------------------
// Utilities
// ---------------------------------------------------------------------------
/// Selection-sort a list of DirEntry values by name (ascending ASCII order).
sort_dir_entries :: (fn(entries : ArrayList(DirEntry)) -> ArrayList(DirEntry))({
  n := entries.len();
  result := ArrayList(DirEntry).with_capacity(n);
  // Track which entries have been moved to result
  added := ArrayList(bool).with_capacity(n);
  i := usize(0);
  while(i < n, {
    added.push(false);
    i = (i + usize(1));
  });
  selected := usize(0);
  while(selected < n, {
    // Find the minimum-name entry not yet added
    min_idx := usize(0);
    found := false;
    j := usize(0);
    while(j < n, {
      flag := match(added.get(j), .None => true, .Some(f) => f);
      if(!flag, {
        if(!found, {
          min_idx = j;
          found = true;
        }, {
          j_name := match(entries.get(j), .None => String.new(), .Some(e) => e.name);
          min_name := match(entries.get(min_idx), .None => String.new(), .Some(e) => e.name);
          if(j_name < min_name, {
            min_idx = j;
          });
        });
      });
      j = (j + usize(1));
    });
    match(
      entries.get(min_idx),
      .None => (),
      .Some(e) => {
        result.push(e);
      }
    );
    // Mark min_idx as added via raw pointer (bool is a primitive, safe to write)
    match(
      added.ptr(),
      .None => (),
      .Some(p) => {
        (p.add(min_idx)).* = true;
      }
    );
    selected = (selected + usize(1));
  });
  result
});
/// Strip `\r` from `\r\n` sequences — ensures cross-platform hash stability.
normalize_line_endings :: (fn(bytes : ArrayList(u8)) -> ArrayList(u8))({
  // Quick path: no CR in input
  has_cr := false;
  i := usize(0);
  while((i < bytes.len()) && !has_cr, {
    match(
      bytes.get(i),
      .None => (),
      .Some(b) => if(b == u8(13), {
        has_cr = true;
      })
    );
    i = (i + usize(1));
  });
  if(!has_cr, bytes, {
    out := ArrayList(u8).with_capacity(bytes.len());
    j := usize(0);
    while(j < bytes.len(), {
      match(
        bytes.get(j),
        .None => (),
        .Some(b) => {
          is_cr := (b == u8(13));
          next_is_lf := match(
            bytes.get(j + usize(1)),
            .None => false,
            .Some(next) => (next == u8(10))
          );
          if(!(is_cr && next_is_lf), {
            out.push(b);
          });
        }
      );
      j = (j + usize(1));
    });
    out
  })
});
/// Push a str literal as bytes into an ArrayList(u8).
_push_str_bytes :: (fn(buf : ArrayList(u8), s : str) -> unit)({
  p := s.ptr();
  n := s.len();
  k := usize(0);
  while(k < n, {
    {
      buf.push((p.add(k)).*);
    };
    k = (k + usize(1));
  });
});
/// Push a String's bytes into an ArrayList(u8).
_push_string_bytes :: (fn(buf : ArrayList(u8), s : String) -> unit)({
  bytes := s.as_bytes();
  n := bytes.len();
  k := usize(0);
  while(k < n, {
    match(
      bytes.get(k),
      .None => (),
      .Some(b) => {
        buf.push(b);
      }
    );
    k = (k + usize(1));
  });
});
/// Internal item type for the iterative DFS hash stack.
_HashWorkItem :: ref(
  struct(
    abs_path : String,
    rel_path : String,
    is_dir : bool
  )
);
/// Compute a content hash for a directory using iterative DFS.
/// Returns `"sha256-<hex>"`.
compute_content_hash :: (
  fn(
    dir_path : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(String, IoExn))
)(
  io.async((e : IoExn) => {
    hasher := Sha256.new();
    // Bootstrap: push root entries in reversed sorted order so LIFO pop gives forward order
    root_entries := e.io.await(read_dir(Path.new(dir_path), e.io), e);
    root_sorted := sort_dir_entries(root_entries);
    stack := ArrayList(_HashWorkItem).new();
    // Push root entries in reversed sorted order
    ri := root_sorted.len();
    while(ri > usize(0), {
      ri = (ri - usize(1));
      match(
        root_sorted.get(ri),
        .None => (),
        .Some(de) => {
          is_dir := match(de.file_type, .Directory => true, _ => false);
          {
            stack.push(
              _HashWorkItem(
                abs_path : dir_path,
                rel_path : de.name,
                is_dir : is_dir
              )
            );
          };
        }
      );
    });
    while(stack.len() > usize(0), {
      item := match(
        stack.pop(),
        .None => {
          return(String.new());
        },
        .Some(it) => it
      );
      // Compute entry name from rel_path (last segment)
      entry_name := {
        slash_idx := item.rel_path.last_index_of(String.from("/"));
        match(
          slash_idx,
          .None => item.rel_path,
          .Some(idx) => item.rel_path.substring(idx + usize(1), item.rel_path.len())
        )
      };
      if(item.is_dir, {
        // Check for hidden directory (starts with '.')
        first_byte := entry_name.as_bytes().get(usize(0));
        is_hidden := match(
          first_byte,
          .None => false,
          .Some(c) => (c == u8(46)) // '.'
        );
        if(!is_hidden, {
          // Hash "dir:rel_path\n"
          prefix_bytes := ArrayList(u8).new();
          _push_str_bytes(prefix_bytes, "dir:");
          _push_string_bytes(prefix_bytes, item.rel_path);
          prefix_bytes.push(u8(10)); // '\n'
          hasher = hasher.update(prefix_bytes);
          // Read and sort subdir entries, push in reversed order
          abs_sub := item.abs_path.clone();
          abs_sub.push_str("/");
          abs_sub.push_string(entry_name);
          sub_entries := e.io.await(read_dir(Path.new(abs_sub), e.io), e);
          sub_sorted := sort_dir_entries(sub_entries);
          si := sub_sorted.len();
          while(si > usize(0), {
            si = (si - usize(1));
            match(
              sub_sorted.get(si),
              .None => (),
              .Some(de) => {
                sub_rel := item.rel_path.clone();
                sub_rel.push_str("/");
                sub_rel.push_string(de.name);
                is_subdir := match(de.file_type, .Directory => true, _ => false);
                {
                  stack.push(
                    _HashWorkItem(
                      abs_path : abs_sub,
                      rel_path : sub_rel,
                      is_dir : is_subdir
                    )
                  );
                };
              }
            );
          });
        });
      }, {
        // File entry. The statements sit DIRECTLY in the arm: a nested bare
        // block `{ …await…; }` as an arm's statement inside an async loop is
        // silently dropped by the async lowering of the SEED compiler (the
        // file bytes never reached the hasher and every tree hashed alike —
        // issues/fixed/async-nested-bare-block-in-loop-arm-dropped.md). Fixed
        // in this tree's emitter; the flat shape stays until the seed
        // carries the fix.
        // Hash "file:rel_path\n"
        prefix_bytes := ArrayList(u8).new();
        _push_str_bytes(prefix_bytes, "file:");
        _push_string_bytes(prefix_bytes, item.rel_path);
        prefix_bytes.push(u8(10)); // '\n'
        hasher = hasher.update(prefix_bytes);
        // Read file content, normalize line endings, then hash
        abs_file := item.abs_path.clone();
        abs_file.push_str("/");
        abs_file.push_string(entry_name);
        content := e.io.await(read(Path.new(abs_file), e.io), e);
        normalized := normalize_line_endings(content);
        hasher = hasher.update(normalized);
      });
    });
    // Produce "sha256-<hex>"
    digest := hasher.finish();
    hex_bytes := ArrayList(u8).with_capacity(usize(32));
    k := usize(0);
    while(k < usize(32), {
      hex_bytes.push(digest(k));
      k = (k + usize(1));
    });
    hex_str := hex.encode(hex_bytes);
    result := String.from("sha256-");
    result.push_string(hex_str);
    result
  })
);
// ---------------------------------------------------------------------------
// Git children
// ---------------------------------------------------------------------------
/// A `git` child that never prompts: `GIT_TERMINAL_PROMPT=0` refuses the
/// terminal, `GIT_ASKPASS=echo` answers every credential prompt with an empty
/// line, so a private or missing remote fails instead of hanging the install.
/// Every git child the compiler spawns is built here.
git_command :: (fn() -> Command)({
  cmd := Command.new(String.from("git"));
  cmd.env(String.from("GIT_TERMINAL_PROMPT"), String.from("0"));
  cmd.env(String.from("GIT_ASKPASS"), String.from("echo"));
  cmd
});
/// Resolve a git ref to a commit SHA using `git ls-remote`.
resolve_git_ref :: (
  fn(
    url : String,
    ref : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(String, IoExn))
)(
  io.async((e : IoExn) => {
    cmd := git_command();
    cmd.arg(String.from("ls-remote"));
    cmd.arg(String.from("--"));
    cmd.arg(url);
    cmd.arg(ref);
    out := e.io.await(cmd.output(e.io), e);
    text := String.from_bytes(out.stdout).trim();
    if(text.len() == usize(0), {
      // Assume ref is already a commit SHA
      return(ref);
    });
    // Take first non-empty line and split on \t
    lines := text.split(String.from("\n"));
    first_line := match(
      lines.get(usize(0)),
      .None => {
        e.exn.throw(dyn(`git ls-remote returned empty output`));
        String.new()
      },
      .Some(l) => l
    );
    parts := first_line.split(String.from("\t"));
    sha := match(
      parts.get(usize(0)),
      .None => {
        e.exn.throw(dyn(`Could not parse git ls-remote output`));
        String.new()
      },
      .Some(s) => s
    );
    sha
  })
);
// ---------------------------------------------------------------------------
// The store lock
// ---------------------------------------------------------------------------
/// The exclusive `flock` on `<cache>/store.lock`, held across a store or
/// mirror mutation so two installs never extract into one name at once.
StoreLock :: ref(struct(file : File));
/// Take the store lock (blocking — another `yo install` holds it for the
/// length of one fetch). The lock file is created on first use.
acquire_store_lock :: (
  fn(
    cache_root : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(StoreLock, IoExn))
)(
  io.async((e : IoExn) => {
    lock_path := store_lock_path(cache_root);
    file := e.io.await(File.open(Path.new(lock_path.clone()), OpenMode.Append, e.io), e);
    rc := flock(file.fd(), LOCK_EX);
    if(rc < i32(0), {
      e.exn.throw(dyn(`Error: could not lock ${lock_path} (errno ${(i32(0) - rc).to_string()})`));
    });
    StoreLock(file : file)
  })
);
/// Release the store lock and close its file.
release_store_lock :: (
  fn(
    lock : StoreLock,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    _ := flock(lock.file.fd(), LOCK_UN);
    e.io.await(lock.file.close(e.io), e);
  })
);
/// A fresh name component for a temporary directory inside the store.
_random_suffix :: (fn() -> String)({
  rng := Rng.from_entropy();
  rng.next_u64().to_string()
});
// ---------------------------------------------------------------------------
// Mirrors
// ---------------------------------------------------------------------------
/// The bare mirror of `url` (`git clone --mirror` on first use; the clone
/// lands under a temporary name and is renamed in). Under `offline` a missing
/// mirror is an error.
ensure_mirror :: (
  fn(
    cache_root : String,
    url : String,
    offline : bool,
    verbose : bool,
    io : Io,
    exn : Exception
  ) -> Impl(Future(String, IoExn))
)(
  io.async((e : IoExn) => {
    mirror := git_mirror_dir(cache_root.clone(), url.clone());
    present := e.io.await(exists(Path.new(mirror.clone()), e.io), e.io);
    if(present, {
      return(mirror);
    });
    if(offline, {
      e.exn.throw(dyn(`Error: --offline: ${url} has no mirror in the cache`));
    });
    if(verbose, {
      println(`  mirroring ${url}...`);
    });
    tmp := `${mirror}.tmp-${_random_suffix()}`;
    cmd := git_command();
    cmd.arg(String.from("clone"));
    cmd.arg(String.from("--mirror"));
    cmd.arg(String.from("--quiet"));
    cmd.arg(String.from("--"));
    cmd.arg(url.clone());
    cmd.arg(tmp.clone());
    status := e.io.await(cmd.status(e.io), e);
    if(!status.success(), {
      e.exn.throw(dyn(`Error: git clone --mirror failed for ${url}`));
    });
    e.io.await(rename(Path.new(tmp), Path.new(mirror.clone()), e.io), e);
    mirror
  })
);
/// `ref` resolved to a commit by the mirror alone (`rev-parse <ref>^{commit}`),
/// or `.None` when the mirror does not know it — the `--offline` answer to
/// "which commit is v1.2.0".
mirror_rev_parse :: (
  fn(
    mirror : String,
    ref : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(Option(String), IoExn))
)(
  io.async((e : IoExn) => {
    cmd := git_command();
    cmd.arg(String.from("--git-dir"));
    cmd.arg(mirror);
    cmd.arg(String.from("rev-parse"));
    cmd.arg(String.from("--verify"));
    cmd.arg(String.from("--quiet"));
    cmd.arg(`${ref}^{commit}`);
    out := e.io.await(cmd.output(e.io), e);
    text := String.from_bytes(out.stdout).trim();
    if(!out.status.success() || (text.len() == usize(0)), Option(String).None, Option(String).Some(text))
  })
);
/// Does the mirror hold `commit`?
_mirror_has_commit :: (
  fn(
    mirror : String,
    commit : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(bool, IoExn))
)(
  io.async((e : IoExn) => {
    cmd := git_command();
    cmd.arg(String.from("--git-dir"));
    cmd.arg(mirror);
    cmd.arg(String.from("cat-file"));
    cmd.arg(String.from("-e"));
    cmd.arg(`${commit}^{commit}`);
    status := e.io.await(cmd.status(e.io), e);
    status.success()
  })
);
/// Run one `git --git-dir <mirror> fetch --quiet origin [what]`; the exit
/// status is not an error by itself (the commit check afterwards decides).
_mirror_fetch :: (
  fn(
    mirror : String,
    what : Option(String),
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    cmd := git_command();
    cmd.arg(String.from("--git-dir"));
    cmd.arg(mirror);
    cmd.arg(String.from("fetch"));
    cmd.arg(String.from("--quiet"));
    cmd.arg(String.from("origin"));
    match(
      what,
      .Some(w) => {
        cmd.arg(w.clone());
      },
      .None => ()
    );
    _ := e.io.await(cmd.status(e.io), e);
  })
);
/// Bring `commit` into the mirror: nothing when it is already there, else a
/// full `fetch origin` (every ref, incremental), else a direct fetch of the
/// commit for one no ref reaches. Under `offline` a missing commit is an
/// error.
ensure_commit :: (
  fn(
    mirror : String,
    url : String,
    commit : String,
    offline : bool,
    verbose : bool,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    has := e.io.await(_mirror_has_commit(mirror.clone(), commit.clone(), e.io, e.exn), e);
    if(has, {
      return(());
    });
    if(offline, {
      e.exn.throw(dyn(`Error: --offline: commit ${commit} of ${url} is not in the cache`));
    });
    if(verbose, {
      println(`  fetching ${url}...`);
    });
    e.io.await(_mirror_fetch(mirror.clone(), Option(String).None, e.io, e.exn), e);
    has_after_fetch := e.io.await(_mirror_has_commit(mirror.clone(), commit.clone(), e.io, e.exn), e);
    if(has_after_fetch, {
      return(());
    });
    e.io.await(_mirror_fetch(mirror.clone(), Option(String).Some(commit.clone()), e.io, e.exn), e);
    has_after_direct := e.io.await(_mirror_has_commit(mirror.clone(), commit.clone(), e.io, e.exn), e);
    if(!has_after_direct, {
      e.exn.throw(dyn(`Error: commit ${commit} of ${url} could not be fetched (not reachable from any ref, and the remote refuses direct commit fetches)`));
    });
  })
);
/// Write the tree at `commit` into `dest` (created here) through a throwaway
/// index, so the bare mirror stays untouched. `.git` never enters the store.
_extract_tree :: (
  fn(
    mirror : String,
    commit : String,
    dest : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    e.io.await(create_dir_all(Path.new(dest.clone()), e.io), e);
    index := `${dest}.index`;
    cmd := git_command();
    cmd.env(String.from("GIT_INDEX_FILE"), index.clone());
    cmd.arg(String.from("--git-dir"));
    cmd.arg(mirror);
    cmd.arg(String.from("--work-tree"));
    cmd.arg(dest.clone());
    cmd.arg(String.from("checkout"));
    cmd.arg(String.from("--quiet"));
    cmd.arg(commit.clone());
    cmd.arg(String.from("--"));
    cmd.arg(String.from("."));
    status := e.io.await(cmd.status(e.io), e);
    index_present := e.io.await(exists(Path.new(index.clone()), e.io), e.io);
    if(index_present, {
      e.io.await(remove_file(Path.new(index), e.io), e);
    });
    if(!status.success(), {
      e.exn.throw(dyn(`Error: git checkout of ${commit} failed`));
    });
  })
);
// ---------------------------------------------------------------------------
// The tag index
// ---------------------------------------------------------------------------
/// The last `git ls-remote --tags` answer recorded for `url`, or `.None`.
read_tags_index :: (
  fn(
    cache_root : String,
    url : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(Option(String), IoExn))
)(
  io.async((e : IoExn) => {
    path := tags_index_path(cache_root, url);
    present := e.io.await(exists(Path.new(path.clone()), e.io), e.io);
    if(!present, Option(String).None, {
      text := e.io.await(read_to_string(Path.new(path), e.io), e);
      Option(String).Some(text)
    })
  })
);
/// Record `url`'s `git ls-remote --tags` answer for `--offline` runs.
write_tags_index :: (
  fn(
    cache_root : String,
    url : String,
    text : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    e.io.await(create_dir_all(Path.new(get_index_dir(cache_root.clone())), e.io), e);
    e.io.await(write_string(Path.new(tags_index_path(cache_root, url)), text, e.io), e);
  })
);
// ---------------------------------------------------------------------------
// The projects registry
// ---------------------------------------------------------------------------
/// The recorded project directories (one per line; blank lines dropped).
_read_projects :: (
  fn(
    cache_root : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(ArrayList(String), IoExn))
)(
  io.async((e : IoExn) => {
    path := projects_registry_path(cache_root);
    out := ArrayList(String).new();
    present := e.io.await(exists(Path.new(path.clone()), e.io), e.io);
    if(!present, {
      return(out);
    });
    text := e.io.await(read_to_string(Path.new(path), e.io), e);
    lines := text.split(String.from("\n"));
    (i : usize) = usize(0);
    while(i < lines.len(), {
      line := lines(i).trim();
      if(line.len() > usize(0), {
        out.push(line);
      });
      i = (i + usize(1));
    });
    out
  })
);
_write_projects :: (
  fn(
    cache_root : String,
    projects : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    text := String.new();
    (i : usize) = usize(0);
    while(i < projects.len(), {
      text.push_string(projects(i).clone());
      text.push_str("\n");
      i = (i + usize(1));
    });
    e.io.await(write_string(Path.new(projects_registry_path(cache_root)), text, e.io), e);
  })
);
_contains_string :: (fn(list : ArrayList(String), item : String) -> bool)({
  (i : usize) = usize(0);
  while(i < list.len(), {
    if(list(i) == item, {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
/// Remember that `project_dir` resolved its dependencies out of this cache,
/// so `yo cache gc` keeps what its lock references.
record_project :: (
  fn(
    cache_root : String,
    project_dir : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    projects := e.io.await(_read_projects(cache_root.clone(), e.io, e.exn), e);
    if(_contains_string(projects, project_dir.clone()), {
      return(());
    });
    projects.push(project_dir);
    e.io.await(_write_projects(cache_root, projects, e.io, e.exn), e);
  })
);
// ---------------------------------------------------------------------------
// Fetching one package
// ---------------------------------------------------------------------------
/// The `git+<url>#<ref>` source's URL, as the manifest wrote it.
_source_url :: (fn(source : String) -> Option(String))({
  prefix := String.from("git+");
  if(!source.starts_with(prefix.clone()), {
    return(Option(String).None);
  });
  rest := source.substring(prefix.len(), source.len());
  match(
    rest.last_index_of(String.from("#")),
    .Some(i) => Option(String).Some(rest.substring(usize(0), i)),
    .None => Option(String).Some(rest)
  )
});
/// A manifest `git` value that is a local path (`./x.git`, `../x`, `/abs`) —
/// git resolves those against the CURRENT DIRECTORY of the child, so the
/// resolver hands the fetcher an absolute path instead.
is_local_git_path :: (fn(url : String) -> bool)(
  url.starts_with(String.from("./")) || (url.starts_with(String.from("../")) || url.starts_with(String.from("/")))
);
/// The URL git is given for a manifest `git` value: a local path is made
/// absolute against the manifest's directory, anything else is as written.
git_remote_url :: (fn(project_dir : String, url : String) -> String)(
  if(is_local_git_path(url.clone()), abs_under(project_dir, url), url)
);
/// Fetch ONE git package into the store
/// (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.4): decide its commit —
/// the lock's `locked_commit` unless `refresh` (`yo update`), else `git
/// ls-remote` for `ref` — then, when the lock names the tree
/// (`expected_integrity`) and the store has it, reuse it: without a full hash
/// when its `.verified` marker is present, after one otherwise (a tree that
/// does not hash to its name is removed and re-fetched). Anything else is
/// brought into the remote's bare mirror, extracted under a temporary name,
/// hashed, and renamed to `store/sha256/<hash>`; a fetched tree whose hash
/// disagrees with the lock is an integrity error. Under `offline` any step
/// that would touch the network is an error instead. `url` is what git is
/// given (`git_remote_url`). Every await is a top-level statement of the
/// body.
fetch_package :: (
  fn(
    cache_root : String,
    name : String,
    url : String,
    ref : String,
    locked_commit : Option(String),
    expected_integrity : Option(String),
    refresh : bool,
    offline : bool,
    verbose : bool,
    io : Io,
    exn : Exception
  ) -> Impl(Future(FetchedPackage, IoExn))
)(
  io.async((e : IoExn) => {
    (commit : String) = match(locked_commit, .Some(c) => if(refresh, String.new(), c.clone()), .None => String.new());
    needs_ls_remote := (commit.len() == usize(0));
    mirror_dir := git_mirror_dir(cache_root.clone(), url.clone());
    mirror_present := e.io.await(exists(Path.new(mirror_dir.clone()), e.io), e.io);
    // Offline, the mirror is the only place a ref can be resolved.
    if(needs_ls_remote && (offline && mirror_present), {
      from_mirror := e.io.await(mirror_rev_parse(mirror_dir.clone(), ref.clone(), e.io, e.exn), e);
      commit = match(from_mirror, .Some(c) => c.clone(), .None => String.new());
    });
    if(needs_ls_remote && (offline && (commit.len() == usize(0))), {
      e.exn.throw(dyn(`Error: --offline: resolving "${name}" (${url} @ ${ref}) to a commit needs the network`));
    });
    if(needs_ls_remote && !offline, {
      if(verbose, {
        println(`  ${name}: resolving ${ref} at ${url}...`);
      });
      resolved := e.io.await(resolve_git_ref(url.clone(), ref.clone(), e.io, e.exn), e);
      commit = resolved;
    });
    expected := match(expected_integrity, .Some(h) => h.clone(), .None => String.new());
    // The fast path: the lock names the tree and the store has it.
    (known_dir : String) = String.new();
    if(expected.len() > usize(0), {
      known_dir = match(
        store_tree_dir(cache_root.clone(), expected.clone()),
        .Ok(d) => d,
        .Err(msg) => {
          e.exn.throw(dyn(`Error: yo.lock entry for "${name}": ${msg}`));
          String.new()
        }
      );
    });
    (have_tree : bool) = false;
    if(known_dir.len() > usize(0), {
      present := e.io.await(exists(Path.new(known_dir.clone()), e.io), e.io);
      have_tree = present;
    });
    (verified : bool) = false;
    if(have_tree, {
      marked := e.io.await(exists(Path.new(store_verified_marker(known_dir.clone())), e.io), e.io);
      verified = marked;
    });
    (rehash_matches : bool) = false;
    if(have_tree && !verified, {
      actual := e.io.await(compute_content_hash(known_dir.clone(), e.io, e.exn), e);
      rehash_matches = (actual == expected);
    });
    if(have_tree && (!verified && rehash_matches), {
      e.io.await(write_string(Path.new(store_verified_marker(known_dir.clone())), `${expected}\n`, e.io), e);
      verified = true;
    });
    if(have_tree && (!verified && !rehash_matches), {
      println(`  ${name}: the stored tree ${expected} does not hash to its name — re-fetching`);
      e.io.await(remove_dir_all(Path.new(known_dir.clone()), e.io), e);
      have_tree = false;
    });
    if(have_tree && verified, {
      if(verbose, {
        println(`  ${name}: in the store`);
      });
      return(FetchedPackage(commit : commit, integrity : expected, dir : known_dir));
    });
    // The slow path: mirror, extract, hash, land — under the store lock.
    if(offline && !mirror_present, {
      e.exn.throw(dyn(`Error: --offline: "${name}" (${url} @ ${commit}) is not in the cache`));
    });
    lock := e.io.await(acquire_store_lock(cache_root.clone(), e.io, e.exn), e);
    mirror := e.io.await(ensure_mirror(cache_root.clone(), url.clone(), offline, verbose, e.io, e.exn), e);
    e.io.await(ensure_commit(mirror.clone(), url.clone(), commit.clone(), offline, verbose, e.io, e.exn), e);
    tmp := `${get_store_dir(cache_root.clone())}/.tmp-${commit.substring(usize(0), usize(12))}-${_random_suffix()}`;
    e.io.await(_extract_tree(mirror.clone(), commit.clone(), tmp.clone(), e.io, e.exn), e);
    integrity := e.io.await(compute_content_hash(tmp.clone(), e.io, e.exn), e);
    mismatch := ((expected.len() > usize(0)) && (expected != integrity));
    if(mismatch, {
      e.io.await(remove_dir_all(Path.new(tmp.clone()), e.io), e);
      e.io.await(release_store_lock(lock, e.io, e.exn), e);
      e.exn.throw(dyn(`Error: integrity mismatch for "${name}" at ${commit}: yo.lock records ${expected}, the fetched tree hashes to ${integrity}. If the dependency's history was rewritten, run \`yo update ${name}\`.`));
    });
    final_dir := match(
      store_tree_dir(cache_root.clone(), integrity.clone()),
      .Ok(d) => d,
      .Err(msg) => {
        e.exn.throw(dyn(`Error: ${msg}`));
        String.new()
      }
    );
    landed := e.io.await(exists(Path.new(final_dir.clone()), e.io), e.io);
    if(landed, {
      // Another install landed the same tree meanwhile.
      e.io.await(remove_dir_all(Path.new(tmp.clone()), e.io), e);
    }, {
      e.io.await(rename(Path.new(tmp.clone()), Path.new(final_dir.clone()), e.io), e);
    });
    e.io.await(write_string(Path.new(store_verified_marker(final_dir.clone())), `${integrity}\n`, e.io), e);
    e.io.await(release_store_lock(lock, e.io, e.exn), e);
    if(verbose, {
      println(`  ${name}: stored as ${integrity}`);
    });
    FetchedPackage(commit : commit, integrity : integrity, dir : final_dir)
  })
);
// ---------------------------------------------------------------------------
// yo cache gc
// ---------------------------------------------------------------------------
/// What `yo cache gc` found and did.
GcReport :: ref(
  struct(
    projects_kept : usize,
    projects_forgotten : usize,
    trees_kept : usize,
    trees_removed : usize,
    mirrors_removed : usize,
    indexes_removed : usize
  )
);
/// The store names (hex) and remote keys one project's lock references.
_lock_references :: (fn(lock : LockFile, project_dir : String, tree_names : ArrayList(String), remote_keys : ArrayList(String)) -> unit)({
  prefix := String.from("sha256-");
  (i : usize) = usize(0);
  while(i < lock.packages.len(), {
    entry := lock.packages(i);
    if(entry.integrity.starts_with(prefix.clone()), {
      tree_names.push(entry.integrity.substring(prefix.len(), entry.integrity.len()));
    });
    match(
      _source_url(entry.source.clone()),
      .Some(u) => {
        remote_keys.push(url_key(git_remote_url(project_dir.clone(), u)));
      },
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// The entries of `dir` whose base name (before `strip`) is not in `keep`,
/// removed (directories recursively). Returns how many ITEMS were removed:
/// with `count_dirs` the directories (a store tree, a mirror — the marker
/// beside a tree is a companion, not an item), else the files (tag lists).
_sweep_dir :: (
  fn(
    dir : String,
    strip : String,
    keep : ArrayList(String),
    count_dirs : bool,
    io : Io,
    exn : Exception
  ) -> Impl(Future(usize, IoExn))
)(
  io.async((e : IoExn) => {
    present := e.io.await(exists(Path.new(dir.clone()), e.io), e.io);
    if(!present, {
      return(usize(0));
    });
    entries := e.io.await(read_dir(Path.new(dir.clone()), e.io), e);
    (removed : usize) = usize(0);
    (i : usize) = usize(0);
    while(i < entries.len(), {
      entry := entries(i);
      i = (i + usize(1));
      base := if((strip.len() > usize(0)) && entry.name.ends_with(strip.clone()), entry.name.substring(usize(0), entry.name.len() - strip.len()), entry.name.clone());
      keep_it := _contains_string(keep, base);
      full := `${dir}/${entry.name}`;
      is_dir := match(entry.file_type, .Directory => true, _ => false);
      if(!keep_it && is_dir, {
        e.io.await(remove_dir_all(Path.new(full.clone()), e.io), e);
      });
      if(!keep_it && !is_dir, {
        e.io.await(remove_file(Path.new(full.clone()), e.io), e);
      });
      if(!keep_it && (is_dir == count_dirs), {
        removed = (removed + usize(1));
      });
    });
    removed
  })
);
/// Count the entries of `dir` whose name is in `keep`.
_count_kept :: (
  fn(
    dir : String,
    keep : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> Impl(Future(usize, IoExn))
)(
  io.async((e : IoExn) => {
    present := e.io.await(exists(Path.new(dir.clone()), e.io), e.io);
    if(!present, {
      return(usize(0));
    });
    entries := e.io.await(read_dir(Path.new(dir.clone()), e.io), e);
    (kept : usize) = usize(0);
    (i : usize) = usize(0);
    while(i < entries.len(), {
      is_dir := match(entries(i).file_type, .Directory => true, _ => false);
      if(is_dir && _contains_string(keep, entries(i).name.clone()), {
        kept = (kept + usize(1));
      });
      i = (i + usize(1));
    });
    kept
  })
);
/// `yo cache gc`: every recorded project's `yo.lock` is read (a project whose
/// directory or lock is gone is forgotten); every store tree, mirror and tag
/// index none of them references is removed. Runs under the store lock.
gc_store :: (
  fn(
    cache_root : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(GcReport, IoExn))
)(
  io.async((e : IoExn) => {
    lock := e.io.await(acquire_store_lock(cache_root.clone(), e.io, e.exn), e);
    projects := e.io.await(_read_projects(cache_root.clone(), e.io, e.exn), e);
    kept_projects := ArrayList(String).new();
    tree_names := ArrayList(String).new();
    remote_keys := ArrayList(String).new();
    (pi : usize) = usize(0);
    while(pi < projects.len(), {
      project_dir := projects(pi).clone();
      pi = (pi + usize(1));
      lock_path := `${project_dir}/yo.lock`;
      has_lock := e.io.await(exists(Path.new(lock_path.clone()), e.io), e.io);
      (text : String) = String.new();
      if(has_lock, {
        read_text := e.io.await(read_to_string(Path.new(lock_path.clone()), e.io), e);
        text = read_text;
      });
      if(has_lock, {
        match(
          parse_lock_file(text.clone()),
          .Ok(l) => {
            _lock_references(l, project_dir.clone(), tree_names, remote_keys);
            kept_projects.push(project_dir.clone());
          },
          .Err(_) => ()
        );
      });
    });
    e.io.await(_write_projects(cache_root.clone(), kept_projects, e.io, e.exn), e);
    store_dir := get_store_dir(cache_root.clone());
    trees_kept := e.io.await(_count_kept(store_dir.clone(), tree_names, e.io, e.exn), e);
    trees_removed_dirs := e.io.await(_sweep_dir(store_dir.clone(), String.from(".verified"), tree_names, true, e.io, e.exn), e);
    mirrors_removed := e.io.await(_sweep_dir(get_git_mirrors_dir(cache_root.clone()), String.from(".git"), remote_keys, true, e.io, e.exn), e);
    indexes_removed := e.io.await(_sweep_dir(get_index_dir(cache_root.clone()), String.from(".tags"), remote_keys, false, e.io, e.exn), e);
    e.io.await(release_store_lock(lock, e.io, e.exn), e);
    GcReport(
      projects_kept : kept_projects.len(),
      projects_forgotten : (projects.len() - kept_projects.len()),
      trees_kept : trees_kept,
      trees_removed : trees_removed_dirs,
      mirrors_removed : mirrors_removed,
      indexes_removed : indexes_removed
    )
  })
);
// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------
export(
  remove_dir_all,
  FetchedPackage,
  normalize_line_endings,
  sort_dir_entries,
  compute_content_hash,
  git_command,
  resolve_git_ref,
  StoreLock,
  acquire_store_lock,
  release_store_lock,
  ensure_mirror,
  mirror_rev_parse,
  ensure_commit,
  read_tags_index,
  write_tags_index,
  record_project,
  is_local_git_path,
  git_remote_url,
  fetch_package,
  GcReport,
  gc_store
);
