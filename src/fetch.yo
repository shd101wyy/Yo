//! The dependency cache primitives (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md
//! §4.3–§4.4, the cache half): `fetch_package` brings ONE git package at ONE
//! ref into the global cache (`~/.cache/yo/deps/<name>-<commit12>`) — deciding
//! its commit (the lock's, or `git ls-remote`), verifying a cached tree against
//! the lock's `integrity`, cloning what is missing — and the content hashing
//! behind that (`compute_content_hash`, the `.yo-content-hash` sidecar). Which
//! packages and which refs is the resolver's decision (`src/resolver.yo`);
//! `yo.lock` itself is `src/lock_file.yo`.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ println } :: import("std/fmt");
{ Command } :: import("std/process/command");
{ AnyError, Exception, IoExn } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
{ Path } :: import("std/path");
{ read, write_string, write, exists } :: import("std/fs/file");
{
  DirEntry,
  FileType,
  read_dir,
  remove_dir,
  remove_file,
  rename
} :: import("std/fs/dir");
{ remove_dir_all } :: import("std/fs/walker");
{ Sha256 } :: import("std/crypto/sha256");
hex :: import("std/encoding/hex");
{ get_cached_dep_dir } :: import("./cache.yo");
// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------
/// Status of a cached dependency.
CachedDepStatus :: enum(Ok, MissingPath, MissingHash, HashMismatch);
/// Result of inspecting a cached dependency.
CachedDepState :: ref(
  struct(
    status : CachedDepStatus,
    cached_path : String,
    actual_hash : Option(String)
  )
);
/// Result of fetching one dependency.
/// What fetching one package into the cache yields.
FetchedPackage :: ref(
  struct(
    /// The commit the package's tree is at.
    commit : String,
    /// `sha256-…` of the normalized tree (`compute_content_hash`).
    integrity : String,
    /// The cache directory holding the tree.
    dir : String
  )
);
// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------
SIDECAR_FILENAME :: ".yo-content-hash";
// ---------------------------------------------------------------------------
// Utilities
// ---------------------------------------------------------------------------
/// Selection-sort a list of DirEntry values by name (ascending ASCII order).
sort_dir_entries :: (fn(entries : ArrayList(DirEntry)) -> ArrayList(DirEntry))({
  n := entries.len();
  result := ArrayList(DirEntry).with_capacity(n);
  // Track which entries have been moved to result
  added := ArrayList(bool).with_capacity(n);
  i := usize(0);
  while(i < n, {
    added.push(false);
    i = (i + usize(1));
  });
  selected := usize(0);
  while(selected < n, {
    // Find the minimum-name entry not yet added
    min_idx := usize(0);
    found := false;
    j := usize(0);
    while(j < n, {
      flag := match(added.get(j), .None => true, .Some(f) => f);
      if(!flag, {
        if(!found, {
          min_idx = j;
          found = true;
        }, {
          j_name := match(entries.get(j), .None => String.new(), .Some(e) => e.name);
          min_name := match(entries.get(min_idx), .None => String.new(), .Some(e) => e.name);
          if(j_name < min_name, {
            min_idx = j;
          });
        });
      });
      j = (j + usize(1));
    });
    match(
      entries.get(min_idx),
      .None => (),
      .Some(e) => {
        result.push(e);
      }
    );
    // Mark min_idx as added via raw pointer (bool is a primitive, safe to write)
    match(
      added.ptr(),
      .None => (),
      .Some(p) => {
        (p.add(min_idx)).* = true;
      }
    );
    selected = (selected + usize(1));
  });
  result
});
/// Strip `\r` from `\r\n` sequences — ensures cross-platform hash stability.
normalize_line_endings :: (fn(bytes : ArrayList(u8)) -> ArrayList(u8))({
  // Quick path: no CR in input
  has_cr := false;
  i := usize(0);
  while((i < bytes.len()) && !has_cr, {
    match(
      bytes.get(i),
      .None => (),
      .Some(b) => if(b == u8(13), {
        has_cr = true;
      })
    );
    i = (i + usize(1));
  });
  if(!has_cr, bytes, {
    out := ArrayList(u8).with_capacity(bytes.len());
    j := usize(0);
    while(j < bytes.len(), {
      match(
        bytes.get(j),
        .None => (),
        .Some(b) => {
          is_cr := (b == u8(13));
          next_is_lf := match(
            bytes.get(j + usize(1)),
            .None => false,
            .Some(next) => (next == u8(10))
          );
          if(!(is_cr && next_is_lf), {
            out.push(b);
          });
        }
      );
      j = (j + usize(1));
    });
    out
  })
});
/// Push a str literal as bytes into an ArrayList(u8).
_push_str_bytes :: (fn(buf : ArrayList(u8), s : str) -> unit)({
  p := s.ptr();
  n := s.len();
  k := usize(0);
  while(k < n, {
    {
      buf.push((p.add(k)).*);
    };
    k = (k + usize(1));
  });
});
/// Push a String's bytes into an ArrayList(u8).
_push_string_bytes :: (fn(buf : ArrayList(u8), s : String) -> unit)({
  bytes := s.as_bytes();
  n := bytes.len();
  k := usize(0);
  while(k < n, {
    match(
      bytes.get(k),
      .None => (),
      .Some(b) => {
        buf.push(b);
      }
    );
    k = (k + usize(1));
  });
});
/// Internal item type for the iterative DFS hash stack.
_HashWorkItem :: ref(
  struct(
    abs_path : String,
    rel_path : String,
    is_dir : bool
  )
);
/// Compute a content hash for a directory using iterative DFS.
/// Returns `"sha256-<hex>"`.
compute_content_hash :: (
  fn(
    dir_path : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(String, IoExn))
)(
  io.async((e : IoExn) => {
    hasher := Sha256.new();
    // Bootstrap: push root entries in reversed sorted order so LIFO pop gives forward order
    root_entries := e.io.await(read_dir(Path.new(dir_path), e.io), e);
    root_sorted := sort_dir_entries(root_entries);
    stack := ArrayList(_HashWorkItem).new();
    // Push root entries in reversed sorted order
    ri := root_sorted.len();
    while(ri > usize(0), {
      ri = (ri - usize(1));
      match(
        root_sorted.get(ri),
        .None => (),
        .Some(de) => {
          is_dir := match(de.file_type, .Directory => true, _ => false);
          {
            stack.push(
              _HashWorkItem(
                abs_path : dir_path,
                rel_path : de.name,
                is_dir : is_dir
              )
            );
          };
        }
      );
    });
    while(stack.len() > usize(0), {
      item := match(
        stack.pop(),
        .None => {
          return(String.new());
        },
        .Some(it) => it
      );
      // Compute entry name from rel_path (last segment)
      entry_name := {
        slash_idx := item.rel_path.last_index_of(String.from("/"));
        match(
          slash_idx,
          .None => item.rel_path,
          .Some(idx) => item.rel_path.substring(idx + usize(1), item.rel_path.len())
        )
      };
      if(item.is_dir, {
        // Check for hidden directory (starts with '.')
        first_byte := entry_name.as_bytes().get(usize(0));
        is_hidden := match(
          first_byte,
          .None => false,
          .Some(c) => (c == u8(46)) // '.'
        );
        if(!is_hidden, {
          // Hash "dir:rel_path\n"
          prefix_bytes := ArrayList(u8).new();
          _push_str_bytes(prefix_bytes, "dir:");
          _push_string_bytes(prefix_bytes, item.rel_path);
          prefix_bytes.push(u8(10)); // '\n'
          hasher = hasher.update(prefix_bytes);
          // Read and sort subdir entries, push in reversed order
          abs_sub := item.abs_path.clone();
          abs_sub.push_str("/");
          abs_sub.push_string(entry_name);
          sub_entries := e.io.await(read_dir(Path.new(abs_sub), e.io), e);
          sub_sorted := sort_dir_entries(sub_entries);
          si := sub_sorted.len();
          while(si > usize(0), {
            si = (si - usize(1));
            match(
              sub_sorted.get(si),
              .None => (),
              .Some(de) => {
                sub_rel := item.rel_path.clone();
                sub_rel.push_str("/");
                sub_rel.push_string(de.name);
                is_subdir := match(de.file_type, .Directory => true, _ => false);
                {
                  stack.push(
                    _HashWorkItem(
                      abs_path : abs_sub,
                      rel_path : sub_rel,
                      is_dir : is_subdir
                    )
                  );
                };
              }
            );
          });
        });
      }, {
        // File entry — skip the sidecar hash file
        is_sidecar := (entry_name == SIDECAR_FILENAME);
        if(!is_sidecar, {
          // Hash "file:rel_path\n"
          prefix_bytes := ArrayList(u8).new();
          _push_str_bytes(prefix_bytes, "file:");
          _push_string_bytes(prefix_bytes, item.rel_path);
          prefix_bytes.push(u8(10)); // '\n'
          hasher = hasher.update(prefix_bytes);
          // Read file content, normalize line endings, then hash
          abs_file := item.abs_path.clone();
          abs_file.push_str("/");
          abs_file.push_string(entry_name);
          content := e.io.await(read(Path.new(abs_file), e.io), e);
          normalized := normalize_line_endings(content);
          hasher = hasher.update(normalized);
        });
      });
    });
    // Produce "sha256-<hex>"
    digest := hasher.finish();
    hex_bytes := ArrayList(u8).with_capacity(usize(32));
    k := usize(0);
    while(k < usize(32), {
      hex_bytes.push(digest(k));
      k = (k + usize(1));
    });
    hex_str := hex.encode(hex_bytes);
    result := String.from("sha256-");
    result.push_string(hex_str);
    result
  })
);
/// Write a sidecar `.yo-content-hash` file for fast future verification.
write_sidecar_hash :: (
  fn(
    cached_path : String,
    content_hash : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    sidecar := Path.new(cached_path).join(Path.new(String.from(SIDECAR_FILENAME)));
    sidecar_content := content_hash.clone();
    sidecar_content.push_str("\n");
    e.io.await(write_string(sidecar, sidecar_content, e.io), e);
  })
);
/// Read the sidecar hash file, returning None if it doesn't exist or can't be read.
read_sidecar_hash :: (
  fn(
    cached_path : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(Option(String), IoExn))
)(
  io.async((e : IoExn) => {
    sidecar := Path.new(cached_path).join(Path.new(String.from(SIDECAR_FILENAME)));
    sidecar_exists := e.io.await(exists(sidecar, e.io), e.io);
    if(!sidecar_exists, Option(String).None, {
      content := e.io.await(read(sidecar, e.io), e);
      text := String.from_bytes(content).trim();
      Option(String).Some(text)
    })
  })
);
/// Check whether a cached dependency is present and valid.
inspect_cached_dep :: (
  fn(
    cache_dir : String,
    dep_name : String,
    commit : String,
    hash : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(CachedDepState, IoExn))
)(
  io.async((e : IoExn) => {
    cached_path := get_cached_dep_dir(cache_dir, dep_name, commit);
    path_exists := e.io.await(exists(Path.new(cached_path), e.io), e.io);
    if(
      !path_exists,
      CachedDepState(
        status : CachedDepStatus.MissingPath,
        cached_path : cached_path,
        actual_hash : .None
      ),
      if(hash.len() == usize(0), CachedDepState(
        status : CachedDepStatus.MissingHash,
        cached_path : cached_path,
        actual_hash : .None
      ), {
        // Try sidecar first for O(1) verification
        sidecar_hash := e.io.await(read_sidecar_hash(cached_path, e.io, e.exn), e);
        // `h.clone()`, not `h`: the SEED compiler hands a borrowed payload out
        // of the non-awaiting arm of an awaiting match without a dup, so the
        // sidecar string was released twice at completion and the caller
        // read a freed `actual_hash` (the rc=133 second `yo install`). Fixed
        // in this tree's emitter
        // (issues/fixed/async-match-arm-borrowed-payload-released-twice.md);
        // the clone stays until the seed carries the fix.
        actual_hash := match(
          sidecar_hash,
          .Some(h) => h.clone(),
          .None => {
            // Recompute and write sidecar
            h := e.io.await(compute_content_hash(cached_path, e.io, e.exn), e);
            e.io.await(write_sidecar_hash(cached_path, h, e.io, e.exn), e);
            h
          }
        );
        if(
          actual_hash == hash,
          CachedDepState(
            status : CachedDepStatus.Ok,
            cached_path : cached_path,
            actual_hash : .Some(actual_hash)
          ),
          CachedDepState(
            status : CachedDepStatus.HashMismatch,
            cached_path : cached_path,
            actual_hash : .Some(actual_hash)
          )
        )
      })
    )
  })
);
// ---------------------------------------------------------------------------
// Git operations
// ---------------------------------------------------------------------------
/// Resolve a git ref to a commit SHA using `git ls-remote`.
resolve_git_ref :: (
  fn(
    url : String,
    ref : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(String, IoExn))
)(
  io.async((e : IoExn) => {
    cmd := Command.new(String.from("git"));
    cmd.arg(String.from("ls-remote"));
    cmd.arg(String.from("--"));
    cmd.arg(url);
    cmd.arg(ref);
    out := e.io.await(cmd.output(e.io), e);
    text := String.from_bytes(out.stdout).trim();
    if(text.len() == usize(0), {
      // Assume ref is already a commit SHA
      return(ref);
    });
    // Take first non-empty line and split on \t
    lines := text.split(String.from("\n"));
    first_line := match(
      lines.get(usize(0)),
      .None => {
        e.exn.throw(dyn(`git ls-remote returned empty output`));
        String.new()
      },
      .Some(l) => l
    );
    parts := first_line.split(String.from("\t"));
    sha := match(
      parts.get(usize(0)),
      .None => {
        e.exn.throw(dyn(`Could not parse git ls-remote output`));
        String.new()
      },
      .Some(s) => s
    );
    sha
  })
);
/// Clone a git repo at a specific commit into the cache directory.
/// Returns the path to the cloned directory.
clone_repo :: (
  fn(
    cache_dir : String,
    url : String,
    commit : String,
    dep_name : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(String, IoExn))
)(
  io.async((e : IoExn) => {
    target_dir := get_cached_dep_dir(cache_dir, dep_name, commit);
    // Return early if already cloned
    already_exists := e.io.await(exists(Path.new(target_dir), e.io), e.io);
    if(already_exists, {
      return(target_dir);
    });
    // Use a temp dir for atomic clone
    temp_dir := {
      t := cache_dir.clone();
      t.push_str("/_tmp_");
      t.push_string(dep_name);
      t
    };
    // Clone shallow
    clone_cmd := Command.new(String.from("git"));
    clone_cmd.arg(String.from("clone"));
    clone_cmd.arg(String.from("--depth"));
    clone_cmd.arg(String.from("1"));
    clone_cmd.arg(url);
    clone_cmd.arg(temp_dir);
    clone_status := e.io.await(clone_cmd.status(e.io), e);
    if(!clone_status.success(), {
      clone_fail_msg := String.from("git clone failed for ");
      clone_fail_msg.push_string(url);
      e.exn.throw(dyn(clone_fail_msg));
    });
    // Try to checkout the specific commit
    checkout_cmd := Command.new(String.from("git"));
    checkout_cmd.arg(String.from("-C"));
    checkout_cmd.arg(temp_dir);
    checkout_cmd.arg(String.from("checkout"));
    checkout_cmd.arg(commit);
    checkout_ok := false;
    checkout_st := e.io.await(checkout_cmd.status(e.io), e);
    checkout_ok = checkout_st.success();
    if(!checkout_ok, {
      // Shallow clone may not have the commit — fetch it explicitly
      fetch_cmd := Command.new(String.from("git"));
      fetch_cmd.arg(String.from("-C"));
      fetch_cmd.arg(temp_dir);
      fetch_cmd.arg(String.from("fetch"));
      fetch_cmd.arg(String.from("--depth"));
      fetch_cmd.arg(String.from("1"));
      fetch_cmd.arg(String.from("origin"));
      fetch_cmd.arg(commit);
      e.io.await(fetch_cmd.status(e.io), e);
      checkout_cmd2 := Command.new(String.from("git"));
      checkout_cmd2.arg(String.from("-C"));
      checkout_cmd2.arg(temp_dir);
      checkout_cmd2.arg(String.from("checkout"));
      checkout_cmd2.arg(commit);
      checkout_st2 := e.io.await(checkout_cmd2.status(e.io), e);
      if(!checkout_st2.success(), {
        checkout_fail_msg := String.from("git checkout failed for commit ");
        checkout_fail_msg.push_string(commit);
        e.exn.throw(dyn(checkout_fail_msg));
      });
    });
    // Remove .git directory to save space
    git_dir_path := {
      p := temp_dir.clone();
      p.push_str("/.git");
      p
    };
    git_dir_exists := e.io.await(exists(Path.new(git_dir_path), e.io), e.io);
    if(git_dir_exists, {
      e.io.await(remove_dir_all(Path.new(git_dir_path), e.io), e);
    });
    // Atomic rename to final location
    e.io.await(rename(Path.new(temp_dir), Path.new(target_dir), e.io), e);
    target_dir
  })
);
// ---------------------------------------------------------------------------
// Dependency fetching
// ---------------------------------------------------------------------------
/// Fetch ONE git package into the global cache
/// (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.3–§4.4, the cache half):
/// decide its commit — the lock's `locked_commit` unless `refresh`
/// (`yo update`), else `git ls-remote` for `ref` — then reuse the cached tree
/// when it is present and its content hash matches `expected_integrity`
/// (the lock's), and clone otherwise. A tree whose hash disagrees with the
/// lock is evicted and re-fetched; a re-fetched tree that STILL disagrees is
/// an integrity error. Under `offline` any step that would touch the network
/// is an error instead. Every await is a top-level statement of the body.
fetch_package :: (
  fn(
    cache_dir : String,
    name : String,
    url : String,
    ref : String,
    locked_commit : Option(String),
    expected_integrity : Option(String),
    refresh : bool,
    offline : bool,
    verbose : bool,
    io : Io,
    exn : Exception
  ) -> Impl(Future(FetchedPackage, IoExn))
)(
  io.async((e : IoExn) => {
    (commit : String) = match(locked_commit, .Some(c) => if(refresh, String.new(), c), .None => String.new());
    needs_ls_remote := (commit.len() == usize(0));
    if(needs_ls_remote && offline, {
      e.exn.throw(dyn(`Error: --offline: resolving "${name}" (${url} @ ${ref}) to a commit needs the network`));
    });
    if(needs_ls_remote, {
      if(verbose, {
        println(`  ${name}: resolving ${ref} at ${url}...`);
      });
      resolved := e.io.await(resolve_git_ref(url.clone(), ref.clone(), e.io, e.exn), e);
      commit = resolved;
    });
    expected := match(expected_integrity, .Some(h) => h, .None => String.new());
    state := e.io.await(inspect_cached_dep(cache_dir.clone(), name.clone(), commit.clone(), expected.clone(), e.io, e.exn), e);
    (integrity : String) = match(state.actual_hash, .Some(h) => h, .None => String.new());
    (dir : String) = state.cached_path.clone();
    is_ok := match(state.status, .Ok => true, _ => false);
    // Present, but the lock has no hash to compare against: the sidecar (or a
    // full hash) is the tree's integrity.
    needs_hash := match(state.status, .MissingHash => true, _ => false);
    if(needs_hash, {
      sidecar := e.io.await(read_sidecar_hash(dir.clone(), e.io, e.exn), e);
      integrity = match(sidecar, .Some(h) => h, .None => String.new());
    });
    needs_full_hash := (needs_hash && (integrity.len() == usize(0)));
    if(needs_full_hash, {
      computed := e.io.await(compute_content_hash(dir.clone(), e.io, e.exn), e);
      e.io.await(write_sidecar_hash(dir.clone(), computed.clone(), e.io, e.exn), e);
      integrity = computed;
    });
    is_mismatch := match(state.status, .HashMismatch => true, _ => false);
    if(is_mismatch, {
      println(`  ${name}: cached tree ${dir} does not match yo.lock (${expected}) — re-fetching`);
      e.io.await(remove_dir_all(Path.new(dir.clone()), e.io), e);
    });
    needs_clone := (is_mismatch || match(state.status, .MissingPath => true, _ => false));
    if(needs_clone && offline, {
      e.exn.throw(dyn(`Error: --offline: "${name}" (${url} @ ${commit}) is not in the cache`));
    });
    if(needs_clone, {
      if(verbose, {
        println(`  ${name}: cloning ${url} @ ${commit}...`);
      });
      cloned := e.io.await(clone_repo(cache_dir.clone(), url.clone(), commit.clone(), name.clone(), e.io, e.exn), e);
      dir = cloned;
      computed := e.io.await(compute_content_hash(dir.clone(), e.io, e.exn), e);
      e.io.await(write_sidecar_hash(dir.clone(), computed.clone(), e.io, e.exn), e);
      integrity = computed;
      if((expected.len() > usize(0)) && (expected != integrity), {
        e.exn.throw(dyn(`Error: integrity mismatch for "${name}" at ${commit}: yo.lock records ${expected}, the fetched tree hashes to ${integrity}. If the dependency's history was rewritten, run \`yo update ${name}\`.`));
      });
    });
    if(is_ok && verbose, {
      println(`  ${name}: cached at ${dir}`);
    });
    FetchedPackage(commit : commit, integrity : integrity, dir : dir)
  })
);
// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------
export(
  remove_dir_all,
  CachedDepStatus,
  CachedDepState,
  FetchedPackage,
  SIDECAR_FILENAME,
  normalize_line_endings,
  sort_dir_entries,
  compute_content_hash,
  write_sidecar_hash,
  read_sidecar_hash,
  inspect_cached_dep,
  resolve_git_ref,
  clone_repo,
  fetch_package
);
