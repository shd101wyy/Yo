main :: (fn(io : Io) -> unit)({
  exn := Exception(
    throw : (
      (err) -> {
        // A structured YoError renders itself in the process's format
        // (--error-format) on the right stream. Anything else keeps the
        // yo: error: wrapper, unless it is a rendered diagnostic rethrown
        // as a string — no doubled prefixes (P1, D4).
        match(
          downcast(err, YoError),
          .Some(ye) => {
            emit_rendered_text(render_diagnostics_for_mode(ye.diagnostics));
          },
          .None => {
            text := err.to_string();
            if(text.starts_with(String.from("error: ")), {
              emit_rendered_text(text);
            }, {
              eprintln(`yo: error: ${text}`);
            });
          }
        );
        unsafe(exit(int(1)));
        unwind();
      }
    )
  );
  // The error-rendering format: `--error-format human|short|json` (global,
  // stripped before subcommand dispatch, like --std-path) or the
  // YO_ERROR_FORMAT env var (lower precedence). Set BEFORE anything can
  // render an error, so every edge agrees.
  (err_format : String) = String.from("");
  env_fmt := proc_env.get(String.from("YO_ERROR_FORMAT"));
  if(env_fmt.is_some(), {
    err_format = env_fmt.unwrap_or(String.from(""));
  });
  raw_argv0 := args();
  argv0 := ArrayList(String).new();
  ai0 := usize(0);
  while(ai0 < raw_argv0.len(), {
    a0 := raw_argv0(ai0);
    if(a0 == "--error-format", {
      if((ai0 + usize(1)) < raw_argv0.len(), {
        err_format = raw_argv0(ai0 + usize(1)).clone();
        ai0 = (ai0 + usize(1));
      }, {
        exn.throw(dyn(`--error-format requires a value: human, short or json`));
      });
    }, {
      if(a0.starts_with(String.from("--error-format=")), {
        err_format = a0.substring(usize(15), a0.len());
      }, {
        argv0.push(a0);
      });
    });
    ai0 = (ai0 + usize(1));
  });
  if(err_format.len() > usize(0), {
    if(!((err_format == "human") || ((err_format == "short") || (err_format == "json"))), {
      exn.throw(
        dyn(
          `Invalid --error-format '${err_format}' (expected: human, short or json). Set --error-format or YO_ERROR_FORMAT.`
        )
      );
    });
    set_error_format(err_format);
  });
  raw_argv := argv0;
  // Global `--std-path <dir>` flag: strip it from argv before subcommand
  // dispatch and stash the override with the module manager. The TS
  // counterpart is the root-level yargs `std-path` option in `yo-cli.ts`.
  // The global `--lang <lc>` flag (CLI output language, src/cli_lang.yo)
  // strips the same way and also matches anywhere in argv.
  argv := ArrayList(String).new();
  ai := usize(0);
  while(ai < raw_argv.len(), {
    a := raw_argv(ai);
    if(a == "--std-path", {
      if((ai + usize(1)) < raw_argv.len(), {
        set_std_path_override(raw_argv(ai + usize(1)).clone());
        ai = (ai + usize(1));
      }, {
        exn.throw(dyn(`--std-path requires a directory argument`));
      });
    }, {
      if(a == "--lang", {
        if((ai + usize(1)) < raw_argv.len(), {
          set_cli_lang_override(raw_argv(ai + usize(1)).clone());
          ai = (ai + usize(1));
        }, {
          exn.throw(dyn(tr(`--lang requires a language code (e.g. en, zh-CN)`, `--lang 需要一个语言代码（例如 en、zh-CN）`)));
        });
      }, {
        if(a.starts_with(String.from("--lang=")), {
          set_cli_lang_override(a.substring(usize(7), a.len()));
        }, {
          argv.push(a);
        });
      });
    });
    ai = (ai + usize(1));
  });
  // Top-level `--help` / `--version` (TS: yargs `.help()` + the version
  // middleware, src/yo-cli.ts:1354-1372) — checked BEFORE the subcommand
  // demand so `yo --help` exits 0 with the usage text instead of erroring.
  if((argv.len() >= usize(2)) && ((argv(usize(1)) == "--help") || (argv(usize(1)) == "-h")), {
    println(_top_level_help_text());
    return(());
  });
  if((argv.len() >= usize(2)) && (argv(usize(1)) == "--version"), {
    println(`yo ${String.from(CURRENT_YO_VERSION)}`);
    return(());
  });
  // A bare `yo` prints the FULL help to stderr and exits 1, matching TS
  // (yargs `.demandCommand()`, src/yo-cli.ts). The one-line "no subcommand
  // given" error this replaced was a porting gap: it named the subcommands but
  // taught nothing about them, so the first thing a newly-installed user saw
  // was a scold rather than the usage text they were about to ask for.
  //
  // stderr + rc=1, not stdout + rc=0: no action was performed, so a script
  // that runs `yo` with no arguments should still see a failure — the same
  // reasoning as `git`. Explicit `--help` remains stdout + rc=0.
  if(argv.len() < usize(2), {
    eprintln(_top_level_help_text());
    unsafe(exit(int(1)));
  });
  subcmd := argv(usize(1));
  // Per-subcommand `--help` / `-h`: answered LOCALLY, before the .yo-version
  // pre-dispatch (help must not require a cached binary or a network). The
  // scan stops at `--` so pass-through arguments (e.g. a program's own
  // --help after `--`) are never intercepted. Unknown subcommands fall back
  // to the top-level usage text.
  (help_wanted : bool) = false;
  (help_i : usize) = usize(2);
  while((help_i < argv.len()) && !(help_wanted), {
    help_a := argv(help_i);
    if(help_a == "--", {
      help_i = argv.len();
    }, {
      if((help_a == "--help") || (help_a == "-h"), {
        help_wanted = true;
      });
      help_i = (help_i + usize(1));
    });
  });
  if(help_wanted, {
    match(
      _subcommand_help_text(subcmd),
      .Some(t) => println(t),
      .None => println(_top_level_help_text())
    );
    return(());
  });
  // .yo-version PRE-DISPATCH (src/yo-cli.ts:118-195 parity): before any
  // subcommand runs, a project pinning a DIFFERENT version re-dispatches to
  // that version's cached native binary. Skipped for `version` itself, for
  // --help/--version (handled above), and when already dispatched.
  if(((subcmd != "version") && (subcmd != "lsp")) && match(proc_env.get(`YO_VERSION_DISPATCHED`), .Some(dv) => (dv != "1"), .None => true), {
    dispatch_cwd := match(
      proc_env.get(`YO_ORIGINAL_CWD`),
      .Some(oc) => oc,
      .None => match(cwd(), .Ok(cp) => cp.to_string(), .Err(_) => String.from("."))
    );
    pin_exn := Exception(throw : ((_pe) -> unwind(())));
    pinned_opt := io.await(read_yo_version(Path.new(dispatch_cwd.clone()), io, pin_exn), IoExn(io : io, exn : pin_exn));
    match(
      pinned_opt,
      .Some(pinned_v) => if(pinned_v != String.from(CURRENT_YO_VERSION), {
        cached_dir := io.await(ensure_cached_version(pinned_v.clone(), io, exn), IoExn(io : io, exn : exn));
        bin_path := cached_binary_path(cached_dir);
        bin_found := io.await(exists(Path.new(bin_path.clone()), io), io);
        if(!(bin_found), {
          exn.throw(dyn(`Error: Cached Yo v${pinned_v} is missing its compiler binary at ${bin_path}`));
        });
        _e1 := proc_env.set(String.from("YO_VERSION_DISPATCHED"), String.from("1"));
        _e2 := proc_env.set(String.from("YO_ORIGINAL_CWD"), dispatch_cwd.clone());
        dcmd := Command.new(bin_path.clone());
        (dai : usize) = usize(1);
        while(dai < argv.len(), {
          dcmd.arg(argv(dai));
          dai = (dai + usize(1));
        });
        dst := io.await(dcmd.status(io), IoExn(io : io, exn : exn));
        unsafe(exit(int(dst.raw)));
      }),
      .None => ()
    );
  });
  if(subcmd == "explain", {
    run_explain(argv, io, exn);
  }, if(subcmd == "lsp", {
    run_lsp_server(io, exn);
  }, if(subcmd == "compile", {
    run_compile(argv, io, exn);
  }, if(subcmd == "test", {
    run_test(argv, io, exn);
  }, if(subcmd == "fmt", {
    run_fmt(argv, io, exn);
  }, if(subcmd == "check", {
    run_check(argv, io, exn);
  }, if(subcmd == "init", {
    run_init(argv, io, exn);
  }, if(subcmd == "build", {
    run_build_cmd(argv, io, exn);
  }, if(subcmd == "fetch", {
    run_fetch_cmd(argv, io, exn);
  }, if(subcmd == "install", {
    run_install_cmd(argv, io, exn);
  }, if(subcmd == "cache", {
    run_cache(argv, io, exn);
  }, if(subcmd == "doc", {
    run_doc_cmd(argv, io, exn);
  }, if(subcmd == "unsafe-report", {
    run_unsafe_report_cmd(argv, io, exn);
  }, if(subcmd == "public-safe-report", {
    run_public_safe_report_cmd(argv, io, exn);
  }, if(subcmd == "skills", {
    run_skills_install(argv, io, exn);
  }, if(subcmd == "version", {
    run_version_cmd(argv, io, exn);
  }, {
    exn.throw(dyn(tr(`unknown subcommand '${subcmd}'. Usage: yo <compile|test|fmt|check|init|build|fetch|install|cache|doc|version|lsp|unsafe-report|public-safe-report|skills> ...`, `未知子命令 '${subcmd}'。用法：yo <compile|test|fmt|check|init|build|fetch|install|cache|doc|version|lsp|unsafe-report|public-safe-report|skills> ...`)));
  })))))))))))))));
});
export(main);
