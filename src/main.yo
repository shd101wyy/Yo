{ Environment } :: import("./env.yo");
// The demand-driven module loader, the cached prelude env, the shared codegen
// ExprInfoTable and std-path resolution all live in `module_manager.yo` — the
// counterpart of TS's `src/module-manager.ts`. They used to be inline globals
// here, which meant every OTHER subcommand that needs to evaluate a `.yo` file
// (build, fetch, install, doc) would have had to grow its own copy.
{
  ModuleLoadOutcome,
  resolve_std_path,
  get_std_path_override,
  set_std_path_override,
  mm_clear_prelude_env,
  mm_set_shared_expr_info_table,
  mm_reset,
  mm_resolve_entry_abs,
  mm_eval_entry_exprs,
  mm_load_file,
  mm_preload_prelude,
  _take_load_error
} :: import("./module_manager.yo");
{ YoError, render_any_error } :: import("./error.yo");
{
  render_diagnostics_for_mode,
  set_error_format,
  error_format,
  emit_rendered_text,
  emit_chatter
} :: import("./diagnostics.yo");
{ eval_context_new } :: import("./evaluator/context.yo");
{ register_evaluate_expression, set_evaluator_deadline } :: import("./evaluator/exprs/_expr.yo");
{ evaluate_anonymous_module_begin_exprs } :: import("./evaluator/values/anonymous_module.yo");
{ clear_module_cache } :: import("./evaluator/module_loader.yo");
{ run_check_watch, run_watch_once, watch_snapshot, wait_for_change } :: import("./check_watch.yo");
{
  lookup_explain,
