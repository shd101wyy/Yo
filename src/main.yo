  // missing run-command branch. Verified locally with emcc 4.0.12: `-o X.bin`
  // yields `JavaScript source` for BOTH wasm targets.
  batch_ext := cond(
    run_is_wasi => String.from(".wasm"),
    run_is_emcc => String.from(".js"),
    true => String.from(".bin")
