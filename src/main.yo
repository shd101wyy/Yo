    if(chunk_auto_cap == usize(0), {
      chunk_auto_cap = get_hardware_threads();
    });
  });
  // --jobs default: 8, or the auto cap (no point minting more chunks than
  // the driver will compile at once).
  if(jobs == usize(0), {
    jobs = cond((chunk_auto_cap >= usize(1)) => chunk_auto_cap, true => usize(8));
  });
  // ----- C compiler resolution (src/yo-cli.ts:468-486) ---------------------
  // Auto-select emcc for wasm targets when --cc was not given; otherwise probe
  // for the first available compiler instead of assuming clang.
  if((cc == "") && target_triple.starts_with("wasm"), {
    cc = String.from("emcc");
  });
  if((cc == "") && !skip_cc, {
    match(
      _find_available_compiler(io),
      .Some(found_cc) => {
        cc = found_cc;
      },
      .None => {
        exn.throw(dyn(String.from("Error: No C compiler found. Please install a C compiler (cc, gcc, clang, or zig) or specify one using the -cc/--c-compiler flag.")));
      }
    );
  });
  // emcc implies wasm32-unknown-emscripten when no target was given (yo-cli.ts:488-490).
  if((cc == "emcc") && (target_triple == ""), {
    target_triple = String.from("wasm32-unknown-emscripten");
  });
  // Arm the cooperative evaluator deadline before anything is evaluated. A
  // malformed value disarms rather than failing the compile: this is runner
  // infrastructure, and refusing to compile because a TIMEOUT was misspelled
  // would be worse than not enforcing one.
  if(compile_timeout_ms != "", {
    match(
      compile_timeout_ms.parse_u64(),
      .None => (),
      .Some(ms) => set_evaluator_deadline(usize(ms))
    );
  });
  // Resolve the compilation target: --target <triple> if given, else host.
  // Placed BEFORE the module is evaluated, matching TS (yo-cli.ts:502-503
  // parses the target, then :521 calls compileModule, which evaluates). It
  // also has to precede the evaluate+emit scope below, because that scope must
  // be free to drop everything it created.
  target := match(
    cond(
      (target_triple == "") => Result(TargetInfo, String).Ok(host_target()),
      true => parse_target(target_triple)
    ),
    .Ok(t) => t,
    .Err(e) => {
      exn.throw(dyn(`compile: ${e}`));
      return(())
    }
  );
  // Publish the resolved target BEFORE the module is evaluated, so the
  // comptime `__yo_process_platform`/`_arch`/`_pointer_size_bits` builtins
  // fold for the TARGET rather than the emitting host. TS does the same at
  // codegen/index.ts:194. Must precede evaluation: `cond(platform == ...)`
  // arms in std/ are selected during evaluation, and the untaken arm never
  // reaches the AST.
  set_current_target(target);
  // The fixed-region heap becomes a size_t-typed static array in the emitted
  // C; a 32-bit target's size_t cannot hold a 4 GiB byte count.
  if(((allocator == "fixed") && (target.pointer_size_bits == u32(32))) && (heap_size > usize(4294967295)), {
    exn.throw(dyn(`compile: --heap-size ${_format_heap_size(heap_size)} does not fit a 32-bit target (max 4294967295 bytes)`));
  });
  // The pointer-size global feeds get_size_of_type's sizeof/alignof folding.
  // TS pairs these two setters at the same spot (codegen/index.ts:194-195);
  // yo-self had NO caller for this setter, so sizeof folded 64-bit pointer
  // layouts into wasm32 C — e.g. sizeof(MapNode) = 16 while typed-pointer
  // `.add()` arithmetic scales by the REAL 8-byte wasm32 element, mixing
  // strides inside std/imm/map's child arrays (the imm_map wasi unwrap-None
  // trap; issues/repros/imm-map-wasm32-unwrap-none.yo). The test runner
  // shells out to `self compile --target ...` per batch, so this one call
  // covers both the compile and test paths.
  set_target_pointer_size(target.pointer_size_bits);
  // Auto-add the output extension when none was given (yo-cli.ts:494-509):
  // emcc → `.wasm` for standalone WASI, else `.html`; Windows targets → `.exe`.
  if((cc == "emcc") && !(_path_has_extension(output)), {
    output = if(is_target_standalone_wasi(target), `${output}.wasm`, `${output}.html`);
  });
  if((is_target_windows(target) && !(shared_library)) && !(_path_has_extension(output)), {
    output = `${output}.exe`;
  });
  // A shared library carries the platform's extension, the way the static
  // path appends `.a` (plan §4.5.4). The runner names the file `lib<name>`;
  // a hand-written `-o libfoo.dylib` is left alone.
  if(shared_library, {
    so_ext := cond(
      is_target_windows(target) => ".dll",
      is_target_macos(target) => ".dylib",
      true => ".so"
    );
    output = if(output.ends_with(so_ext), output.clone(), `${output}${so_ext}`);
  });
  // mimalloc isn't available on wasm (codegen/index.ts:193-199) — downgrade
  // BEFORE codegen so the emitted runtime matches the link line.
  if((allocator == "mimalloc") && is_target_wasm(target), {
    allocator = String.from("system");
  });
  std_path := resolve_std_path();
  // Create the shared ExprInfoTable BEFORE loading the prelude, and publish it
  // via g_shared_expr_info_table now (not after the prelude load). The prelude
  // is def-eval'd inside check_single_file; routing its per-expression metadata
  // into THIS table makes codegen find the body ExprInfo of non-specialized
  // prelude functions (e.g. `assert`'s `cond(flag => (), true => __yo_panic(msg))`).
  // Previously the prelude loaded into a discarded table and g_shared was only
  // set to the entry ctx's table afterwards, so a prelude function emitted
  // directly (not re-specialized at a call site) had no cond ExprInfo →
  // "Failed to transpile cond(...)". See issues/yo-self-cond-panic-arm-codegen.md.
  // Make this compile SELF-CONTAINED. `run_test` calls `run_compile` once per
  // test batch IN-PROCESS, and a fresh ExprInfoTable is created just below — but
  // two caches outlive that table: the module cache (`g_module_cache_*`) and
  // `g_cached_prelude_env`. On a SECOND batch the cached std/prelude ASTs are
  // reused while their ExprInfo lives in the FIRST batch's discarded table, so
  // codegen finds no info for those nodes and emits `// Failed to transpile` for
  // std internals (ArrayList._length/_ptr/_capacity, String._bytes, std/env
  // getenv, ...).
  //
  // MEASURED 2026-08-05: `test ./tests/string` (5 files) emitted 47 FTT markers
  // on the second file's batch while every one of those files passed ALONE, and
  // `test ./tests/internal` did the same with 59 — with an IDENTICAL import list
  // either side, so the trigger was purely "second compile in one process". That
  // is also why every per-file gate was green: they only ever compile one batch.
  //
  // This clearing is DEFENCE IN DEPTH, not the fix — it took 47 markers to 18,
  // because the specialization and impl registries outlive the table too. The
  // actual fix is that `run_test` now compiles each batch in a CHILD PROCESS, so
  // no second in-process compile happens at all. Kept because it makes
  // `run_compile` self-contained (free: a one-compile process starts with these
  // caches empty), which is the invariant the child-process design relies on.
  //
  // TS needs no equivalent: it stores node info ON the AST node (`expr.$`), so a
  // cached AST carries its annotations, whereas yo-self keys a SIDE TABLE by
  // expr id. `run_check` already clears the module cache for the same reason.
  //
  // ---------------------------------------------------------------------
  // EVALUATE + EMIT SCOPE. Everything the evaluator and the code generator
  // build lives inside this block, so that all of it is DROPPED before the
  // C compiler is spawned below.
  //
  // This is not tidiness, it is the fix for a reproducing CI failure
  // (issues/compiler-holds-emit-memory-during-cc.md). On run 31864299243
  // the 140 MB .c was written at 04:36 and the process was STILL holding
  // its ~12 GB evaluator arena at 04:40:59 when it died — while clang,
  // which needs only 3.17 GB on its own, ran alongside it. Neither peak is
  // fatal alone; the SUM on a 16 GB runner is.
  //
  // Nothing after the block reads any of it: `c_path` (declared outside so
  // it survives) and `target` are the only values the link line needs.
  // ---------------------------------------------------------------------
  (c_path : String) = String.new();
  // Chunked emission: every written chunk `.c` (all become cc inputs), plus a
  // content hash per chunk taken AT WRITE TIME (the `.o` cache key's text
  // half — hashing here avoids re-reading ~140 MB back off disk at link time).
  chunk_c_files := ArrayList(String).new();
  chunk_text_hashes := ArrayList(String).new();
  // Whether the chunk `.o` cache actually served anything, plus the compile
  // flag prefix — both needed to retry without the cache if the link fails.
  (chunk_used_cache : bool) = false;
  chunk_link_flags := ArrayList(String).new();
  // Phase 0: arm the profiler before anything is evaluated (the module loader
  // and codegen record only when armed). `profile_reset` first so this
  // compile's report is this compile alone even in a long-lived process.
  profile_reset();
  if(profile, {
    profile_set_enabled(true);
  });
  {
    clear_module_cache();
    mm_clear_prelude_env();
    // §4.9: this compile's input record starts empty. `run_compile` can be
    // reached more than once in a process (the LSP, `check --watch`), and a
    // depfile naming a previous compile's inputs would over-invalidate.
    reset_input_files();
    shared_info_table := expr_info_table_new();
    mm_set_shared_expr_info_table(shared_info_table);
    // Ensure the prelude env is cached (provides std types to the evaluator).
    // Quiet: `compile` has no `check:` chatter.
    // A prelude that fails to evaluate is the root cause of everything that
    // follows; continuing printed the SAME diagnostic a second time from
    // `mm_eval_entry_exprs` below
    // (issues/fixed/failed-prelude-load-prints-twice-and-continues.md).
    // `mm_preload_prelude` already emitted it, so exit without adding a word.
    // The prelude load is a phase of its own: every child compile, every test
    // batch and every artifact re-pays it (Phase 0's first question).
    prof_prelude_t0 := Instant.now();
    if(!mm_preload_prelude(std_path.clone(), false, io, exn), {
      unsafe(exit(int(1)));
    });
    profile_record_phase(String.from("prelude evaluation"), prof_prelude_t0.elapsed().as_nanos());
    // Read + parse the input module.
    prof_parse_t0 := Instant.now();
    src_bytes := io.await(read(Path.new(input_path.clone()), io), IoExn(io : io, exn : exn));
    // The entry is read HERE, not through `mm_load_file`, so it reports its own
    // open — otherwise the depfile would omit the one file the artifact is
    // named after.
    record_input_file(input_path.clone());
    src := String.from_bytes(src_bytes);
    exprs := parse(src, input_path.clone(), exn);
    profile_record_phase(String.from("read+parse entry"), prof_parse_t0.elapsed().as_nanos());
    // Demand-driven module loading. The entry module's eval context reuses the
    // shared ExprInfoTable (created above, also used by the prelude load and every
    // demand-loaded module) so codegen has metadata for the bodies of ALL
    // collected functions — the prelude's, every imported module's, and the entry
    // module's. `mm_eval_entry_exprs` applies it from the published slot.
    entry_abs := mm_resolve_entry_abs(input_path.clone(), std_path.clone());
    // V3: arm the entry file as the verification target (both path
    // spellings) so verify/verify+ functions register during evaluation —
    // unless the caller opted out (--no-verify: the test runner's batches).
    if(!(no_verify), {
      v_targets := ArrayList(String).new();
      v_targets.push(input_path.clone());
      v_targets.push(entry_abs.clone());
      set_verify_target_paths(v_targets);
    });
    prof_eval_t0 := Instant.now();
    outcome := mm_eval_entry_exprs(entry_abs, std_path.clone(), exprs, exn);
    // Wall, not exclusive: the entry's evaluation includes every demand load
    // it triggered (the per-module rows decompose this same wall exclusively).
    profile_record_phase(String.from("entry module evaluation"), prof_eval_t0.elapsed().as_nanos());
    if(!(outcome.ok), {
      // The eval failure's rendered diagnostic is in the loader's stash (its
      // handlers no longer print — the P1 single-print rule). Emit it on the
      // format-aware stream and exit 1 — the throw only ever existed to
      // reach the top-level handler, and a rethrown string would regain the
      // yo: error: wrapper under --error-format json (D2).
      // Same rule as the prelude edge: a tripped deadline outranks the
      // diagnostic that surfaced after it
      // (issues/fixed/a-tripped-deadline-is-masked-by-the-next-type-error.md).
      cond(
        evaluator_deadline_tripped() => {
          emit_rendered_text(evaluator_deadline_message());
          unsafe(exit(int(1)));
        },
        true => match(
          _take_load_error(),
          .Some(rendered) => {
            emit_rendered_text(rendered);
            unsafe(exit(int(1)));
          },
          .None => exn.throw(dyn(`compile: failed to evaluate module "${input_path}"`))
        )
      );
      return(());
    });
    module_value := outcome.module_value;
    env := outcome.env;
    ctx := outcome.ctx;
    // §4.9: the evaluation is what opens files, so the record is complete now.
    // Written before codegen so `--skip-codegen` and `--skip-c-compiler`
    // callers get a depfile too.
    if(emit_deps_to.len() > usize(0), {
      io.await(_write_depfile(emit_deps_to.clone(), input_files(), io, exn), IoExn(io : io, exn : exn));
    });
    // V3: contract verification runs BEFORE codegen (the verify+ strip
    // rewrites function bodies in place); a failure exits 1 — the
    // per-function lines are already printed by the helper.
    prof_verify_t0 := Instant.now();
    if(!(_run_contract_verification(io, exn)), {
      unsafe(exit(int(1)));
    });
    profile_record_phase(String.from("contract verification"), prof_verify_t0.elapsed().as_nanos());
    // --skip-codegen: evaluate only (type-check), emit no C.
    if(skip_codegen, {
      _print_compile_profile(profile_json.clone(), io, exn);
      return(());
    });
    // Generate C11 from the evaluated module. A LIBRARY — static or shared —
    // has no main() wrapper and gives its top-level exports plain, externally
    // linked C names (is_library = true). Allocator + debug-logging flags are
    // threaded through to the code generator (mirrors
    // CodeGeneratorC.compileModule).
    is_library_build := (static_library || shared_library);
    chunk_parts := ArrayList(String).new();
    c_src := compile_module(module_value, ctx.expr_info_table, target, allocator.clone(), heap_size, debug_heap, debug_gc, debug_parallelism, debug_async_await, is_library_build, ctx, env, exn, chunk_parts, emit_chunks, chunk_auto_cap);
    // `--emit-chunks auto` resolved its N inside compile_module (from the
    // actual emitted bytes); read it back so every later decision — the
    // chunk writer, the ThinLTO gate, the driver report — sees the real N.
    if(emit_chunks_auto, {
      emit_chunks = cond(
        (chunk_parts.len() > usize(1)) => (chunk_parts.len() - usize(1)),
        true => usize(0)
      );
    });
    // --emit-c prints the generated C to stdout (module-manager.ts:473-475) —
    // and compilation continues; only --skip-c-compiler stops before the link.
    if(emit_c, {
      println(c_src);
    });
    // Strip a target-format extension so `app.html` gets `app.c`, not
    // `app.html.c` (codegen/index.ts:226-228).
    (c_base : String) = output.clone();
    cond(
      c_base.ends_with(".html") => {
        c_base = c_base.substring(usize(0), c_base.len() - usize(5));
      },
      c_base.ends_with(".wasm") => {
        c_base = c_base.substring(usize(0), c_base.len() - usize(5));
      },
      c_base.ends_with(".exe") => {
        c_base = c_base.substring(usize(0), c_base.len() - usize(4));
      },
      c_base.ends_with(".js") => {
        c_base = c_base.substring(usize(0), c_base.len() - usize(3));
      },
      true => ()
    );
    // `--emit-c-to` overrides the derived sidecar path entirely, and its parent
    // directory is created — the point of the flag is to place the file
    // somewhere deliberate (e.g. `dist/yo.c`) that need not exist yet.
    c_path = if(emit_c_to.len() > usize(0), emit_c_to.clone(), `${c_base}.c`);
    if(emit_c_to.len() > usize(0), {
      match(
        Path.new(c_path.clone()).parent(),
        .Some(pdir) => {
          io.await(create_dir_all(pdir, io), IoExn(io : io, exn : exn));
        },
        .None => ()
      );
    });
    prof_write_t0 := Instant.now();
    cond(
      (emit_chunks >= usize(1)) => {
        // Chunked emission (plans/reference/CHUNKED_C_EMISSION.md step 2): parts[0] is
        // the shared header, parts[1..] the linkage-split translation-unit
        // bodies. Each chunk #includes the header BY BASENAME (quoted
        // includes resolve relative to the including file, and the files are
        // siblings by construction — a full relative path would double the
        // directory prefix). Every chunk file becomes a cc input.
        shared_h := `${c_base}_shared.h`;
        shared_h_base := match(Path.new(shared_h.clone()).file_name(), .Some(bn) => bn, .None => shared_h.clone());
        io.await(
          write_string(Path.new(shared_h.clone()), match(chunk_parts.get(usize(0)), .Some(x) => x, .None => String.new()), io),
          IoExn(io : io, exn : exn)
        );
        (pi2 : usize) = usize(1);
        while(pi2 < chunk_parts.len(), {
          cf := `${c_base}_chunk${_pad3(pi2 - usize(1))}.c`;
          cbody := String.new();
          cbody.push_str("#include \"");
          cbody.push_string(shared_h_base.clone());
          cbody.push_str("\"\n");
          cbody.push_string(match(chunk_parts.get(pi2), .Some(x) => x, .None => String.new()));
          io.await(write_string(Path.new(cf.clone()), cbody.clone(), io), IoExn(io : io, exn : exn));
          chunk_c_files.push(cf);
          chunk_text_hashes.push(sha256_hex(cbody.as_bytes()));
          pi2 = (pi2 + usize(1));
        });
        c_path = match(chunk_c_files.get(usize(0)), .Some(x) => x.clone(), .None => c_path.clone());
      },
      true => {
        io.await(write_string(Path.new(c_path.clone()), c_src, io), IoExn(io : io, exn : exn));
      }
    );
    profile_record_phase(String.from("write C"), prof_write_t0.elapsed().as_nanos());
  };
  // The scope above has dropped the AST, the evaluated module, the env, the
  // eval context and the 140 MB C string. The module-manager GLOBALS still
  // pin the rest of the universe, though, and no scope can reach them: the
  // module cache (every evaluated module's values, for the whole import
  // closure), the cached prelude env, and the shared ExprInfoTable. Clearing
  // them is the other half of the fix — either half alone frees nothing,
  // because each still holds a reference to what the other drops.
  // TS equivalent: ModuleManager.resetAllState().
  mm_reset();
  // --skip-c-compiler: write the C and stop.
  if(skip_cc, {
    _print_compile_profile(profile_json.clone(), io, exn);
    return(());
  });
  // ----- assemble the C-compiler invocation (mirrors src/codegen/index.ts) ---
  std_root := resolve_std_path();
  // Flags are RECORDED rather than pushed straight into a Command, so the
  // chunked path can replay the identical flag list for per-chunk `cc -c`
  // jobs. `CcArgv.arg` matches `Command.arg`, so every assembly call site
  // below is unchanged.
  cmd := CcArgv.new();
  // `zig` is invoked as `zig cc ...`.
  if(cc == "zig", {
    cmd.arg(String.from("cc"));
  });
  cmd.arg(String.from("-std=c11"));
  cmd.arg(String.from("-fno-strict-aliasing"));
  // -fwrapv: define signed overflow as two's-complement wrap (MEMORY_SAFETY.md
  // Limitation #6); without it the optimizer may exploit overflow-UB.
  cmd.arg(String.from("-fwrapv"));
  // Inline assembly with intel_syntax needs the C compiler in Intel mode
  // (mirrors codegen/index.ts:580-583; skipped for wasm targets).
  if(get_needs_intel_asm_syntax() && !(is_target_wasm(target)), {
    cmd.arg(String.from("-masm=intel"));
  });
  // Optimization + warnings. `--optimize` is the ONE mechanism here: an empty
  // or "0" level means the -O0 default, anything else is an optimized build.
  //
  // WARNINGS ARE NOT PURELY A FUNCTION OF THE OPTIMIZATION LEVEL. Generated C is
  // full of harmless noise (unused temporaries, redundant parens, pointer-sign
  // on string literals), so an optimized build silences it wholesale and then
  // re-enables the few diagnostics that can ONLY mean the code GENERATOR
  // emitted something inconsistent with its own prototypes.
  //
  // THE BLANKET FLAG MUST BE `-Wno-everything`, NOT `-w`. `-w` is ABSOLUTE: no
  // later `-W…` or even `-Werror=…` can bring a diagnostic back, so the
  // re-enable list below was decorative for as long as it sat after `-w`.
  // MEASURED (clang 21.1.7, 2026-08-25) on a two-line file passing a `char *`
  // to an `int *` parameter:
  //   -Wincompatible-pointer-types                 -> warning
  //   -w -Wincompatible-pointer-types              -> SILENT
  //   -w -Werror=incompatible-pointer-types        -> SILENT
  //   -Wno-everything -Wincompatible-pointer-types -> warning (comes back)
  // The two int/implicit-decl entries appeared to work only because clang 16+
  // made them errors BY DEFAULT, and `-w` cannot suppress an error — they
  // would fire with or without this list. See
  // issues/fixed/release-builds-suppress-all-c-warnings.md, whose fix this
  // makes effective for the first time.
  //
  // This is not hypothetical: a specialized generic's `inout` parameter lost its
  // by-ref binding, so codegen passed a `T**` where its own prototype said `T*`.
  // That is only -Wincompatible-pointer-types, `-w` swallowed it, and the
  // program silently returned an uninitialised value — a formatted string came
  // back as padding with no body. See
  // issues/fixed/specialized-inout-param-loses-ref-with-comptime-arg.md and
  // issues/release-builds-suppress-all-c-warnings.md. A pointer-type mismatch
  // between generated code and its own generated prototype is never noise:
  // both sides are written by this compiler.
  //
  // `-Werror=return-type` is on the list for the same reason, and must be
  // -Werror rather than a bare -W because a warning would still let the build
  // succeed. A function whose body codegen could not transpile becomes
  // `// Failed to transpile` COMMENTS with no return statement, and falling
  // off the end of a value-returning function is undefined behaviour — that is
  // how a missed rename inside an `io.async` closure made std/fs/walker's walk
  // silently return an empty list with `check`, `build` and the whole suite
  // green. See issues/ftt-stub-in-live-closure-falls-off-non-void-function.md.
  //
  // A call with NO prototype is in the same family and is never benign: the
  // return value is truncated to `int` and the arguments go through default
  // promotion, so it is an ERROR here rather than the warning `-Wno-everything`
  // would otherwise leave behind. That warning is what hid a dropped extern
  // prototype at -O2 while -O0 rejected it outright
  // (issues/fixed/two-externs-of-one-signature-emit-one-prototype.md).
  //
  // The -O0 arm below needs no such re-enabling — `-Wall` and clang's
  // defaults already include all three.
  cond(
    ((optimize != "") && (optimize != "0")) => {
      cmd.arg(String.from("-Wno-everything"));
      cmd.arg(String.from("-Wincompatible-pointer-types"));
      cmd.arg(String.from("-Wint-conversion"));
      cmd.arg(String.from("-Werror=implicit-function-declaration"));
      cmd.arg(String.from("-Werror=return-type"));
      cmd.arg(`-O${optimize}`);
    },
    true => {
      cmd.arg(String.from("-Wall"));
      cmd.arg(String.from("-Wextra"));
      cmd.arg(String.from("-Wno-unused-variable"));
      cmd.arg(String.from("-Wno-unused-parameter"));
      cmd.arg(String.from("-Wno-unused-function"));
      cmd.arg(String.from("-Wno-unused-but-set-variable"));
      cmd.arg(String.from("-Wno-unused-label"));
      cmd.arg(String.from("-Wno-unused-value"));
      cmd.arg(String.from("-Wno-parentheses-equality"));
      cmd.arg(String.from("-Werror=return-type"));
      cmd.arg(String.from("-O0"));
    }
  );
  // Chunked emission needs ThinLTO **at -O1 and above**, and there it is NOT an
  // optional tuning knob (plans/reference/CHUNKED_C_EMISSION.md). Splitting the program
  // into N translation units externalizes every generated function, so an
  // optimizing build can no longer internalize or dead-strip them: MEASURED on
  // an N=4 self-build at -O2, the binary went 9 MB / 3.5k symbols -> 24 MB /
  // 7.2k symbols and ran 14.2% SLOWER on `check ./src` (102.8s vs 90.0s).
  // `-flto=thin` gives the linker back the cross-module inlining and the same
  // build runs 87.4s — slightly FASTER than single-file.
  //
  // At -O0 the opposite is true: clang neither inlines nor dead-strips there,
  // so externalization costs nothing (MEASURED: +12% symbols, and `check ./std`
  // 40.2s chunked vs 40.7s single-file — identical) while the parallel C phase
  // is 3.3x faster (5.5s vs 18.2s). Paying for a thin-link at -O0 would spend
  // that win on nothing, so LTO tracks the OPTIMIZATION LEVEL rather than the
  // chunk flag. The condition mirrors the -O selection above exactly.
  // Not for wasm: emcc's LTO story is separate and chunked wasm is out of scope.
  chunk_lto_wanted := ((optimize != "") && (optimize != "0"));
  if((emit_chunks >= usize(1)) && (chunk_lto_wanted && (!(chunk_no_lto) && !(is_target_wasm(target)))), {
    cmd.arg(String.from("-flto=thin"));
  });
  if(debug_symbols, {
    cmd.arg(String.from("-g"));
  });
  if(strip_syms, {
    cmd.arg(String.from("-s"));
  });
  if(static_link, {
    cmd.arg(String.from("-static"));
  });
  // Sanitizers (clang/gcc; mirror of TS getSanitizerFlags for the Unix path).
  // emcc takes none — TS gates the whole block on `!isEmcc`
  // (codegen/index.ts:465), and the test path already mirrors that.
  if(cc == "emcc", {
    sanitize = String.from("");
  });
  cond(
    (sanitize == "address") => {
      // Functionality probe first (TS getSanitizerFlags): a clang/ASan
      // runtime mismatch produces binaries that deadlock in ASan's own
      // init before main — skip the flags with TS's warning instead.
      if(_asan_runtime_is_usable(output, io), {
        cmd.arg(String.from("-fsanitize=address"));
        cmd.arg(String.from("-fno-omit-frame-pointer"));
      }, {
        eprintln(String.from("AddressSanitizer is not functional with this compiler setup (likely a version mismatch between clang and the ASAN runtime library). Skipping sanitizer. Install a matching ASAN runtime or use --cc with a compatible compiler."));
      });
    },
    (sanitize == "leak") => {
      _arg_c := cmd.arg(String.from("-fsanitize=leak"));
    },
    (sanitize == "thread") => {
      cmd.arg(String.from("-fsanitize=thread"));
      cmd.arg(String.from("-fno-omit-frame-pointer"));
    },
    true => ()
  );
  // -I include paths, -D defines, -L library search paths.
  (ii : usize) = usize(0);
  while(ii < include_paths.len(), {
    match(
      include_paths.get(ii),
      .Some(p) => {
        _arg_c := cmd.arg(`-I${p}`);
      },
      .None => ()
    );
    ii = (ii + usize(1));
  });
  (di : usize) = usize(0);
  while(di < defines.len(), {
    match(
      defines.get(di),
      .Some(d) => {
        _arg_c := cmd.arg(`-D${d}`);
      },
      .None => ()
    );
    di = (di + usize(1));
  });
  (li : usize) = usize(0);
  while(li < library_paths.len(), {
    match(
      library_paths.get(li),
      .Some(p) => {
        _arg_c := cmd.arg(`-L${p}`);
      },
      .None => ()
    );
    li = (li + usize(1));
  });
  // Arbitrary custom flags (--cflags "a b c").
  if(cflags != "", {
    parts := cflags.split(" ");
    (ci : usize) = usize(0);
    while(ci < parts.len(), {
      match(
        parts.get(ci),
        .Some(f) => if(f.len() > usize(0), {
          _arg_c := cmd.arg(f.clone());
        }),
        .None => ()
      );
      ci = (ci + usize(1));
    });
  });
  // Bundled mimalloc allocator (else system): add static.c + its include path,
  // guarded by existence with TS's fallback warning (codegen/index.ts:534-555).
  if(allocator == "mimalloc", {
    mim_static := `${std_root}/../vendor/mimalloc/src/static.c`;
    mim_found := io.await(exists(Path.new(mim_static.clone()), io), io);
    if(mim_found, {
      cmd.arg(`-I${std_root}/../vendor/mimalloc/include`);
      cmd.arg(mim_static.clone());
      println(String.from("Using bundled mimalloc"));
    }, {
      eprintln(String.from("Bundled mimalloc not found, falling back to standard malloc"));
    });
  }, {
    if(allocator == "fixed", {
      // The region is a static .bss array inside the emitted C — nothing
      // joins the link line for this allocator.
      println(`Using fixed-region allocator (${_format_heap_size(heap_size)} heap)`);
    }, {
      println(String.from("Using system allocator"));
    });
  });
  // Cross-compile target / sysroot pass-through. Skipped entirely for emcc,
  // which handles its own target internally (codegen/index.ts:636-641) — it
  // rejects `--target=wasm32-unknown-emscripten`.
  if(cc != "emcc", {
    if(target_triple != "", {
      // The canonical triple is what LLVM speaks, except MinGW
      // (`<arch>-w64-mingw32`) and WASI (`wasm32-wasi`) — `clang_triple`
      // owns those spellings, so never hand clang the raw --target string.
      cmd.arg(`--target=${clang_triple(target)}`);
    }, {
      // Native compiles trust the C compiler's DEFAULT triple to equal the
      // host. On Windows that trust is misplaced: an x86_64 LLVM build runs
      // transparently under Windows-on-ARM emulation and defaults to
      // x86_64-pc-windows-msvc, so a native compile on an arm64 host would
      // silently produce an x64 binary while every comptime platform/arch
      // constant had already folded for arm64 (first hit: suite run
      // 32413596987, where tests/asm.test.yo's aarch64 inline-asm templates
      // reached an x64-targeting clang). Pin the resolved host triple
      // explicitly — clang only; gcc has no --target flag.
      if(is_target_windows(target) && cc.contains("clang"), {
        cmd.arg(`--target=${clang_triple(target)}`);
      });
    });
    if(sysroot != "", {
      cmd.arg(`--sysroot=${sysroot}`);
    });
  });
  // Emscripten-specific link flags (codegen/index.ts:605-634).
  if(cc == "emcc", {
    // WASM call_indirect demands exact signature matches, but codegen casts
    // void* to function pointers — without this every such call traps.
    cmd.arg(String.from("-sEMULATE_FUNCTION_POINTER_CASTS=1"));
    // Yo emits C11, not C++. Emscripten 4.0.23+ otherwise fails to link on
    // __cxa_increment_exception_refcount from its JS symbols library.
    cmd.arg(String.from("-fno-exceptions"));
    if(is_target_standalone_wasi(target), {
      // Standalone WASI: a bare .wasm with no JS glue.
      cmd.arg(String.from("-sSTANDALONE_WASM"));
    }, {
      // Node: use the real filesystem instead of MEMFS. Skipped for `web`,
      // where NODERAWFS's require('fs') does not exist.
      if(emcc_environment != "web", {
        cmd.arg(String.from("-sNODERAWFS=1"));
      });
    });
    // `&& !standalone_wasi` — emcc REJECTS the combination outright:
    // "explicitly setting EXIT_RUNTIME not compatible with STANDALONE_WASM".
    // TS's test runner carries this same guard (test-runner.ts:667
    // `usesParallelism && !isWasi`); only its codegen path omits it, and that
    // is the copy this was ported from, so the bug arrived with the port.
    if(get_uses_parallelism() && !(is_target_standalone_wasi(target)), {
      cmd.arg(String.from("-pthread"));
      cmd.arg(String.from("-sPTHREAD_POOL_SIZE=4"));
      cmd.arg(String.from("-sEXIT_RUNTIME=1"));
    });
  });
  // --shared-library: the executable link line with `-shared -fPIC` and no
  // `main` — the emission already left the wrapper out (plan §4.5.4). Every
  // system library the runtime needs (-lm/-pthread/-luring/OpenSSL, below) is
  // linked into the library itself, so a consumer needs only -l<name>.
  if(shared_library, {
    cmd.arg(String.from("-shared"));
    if(!(is_target_windows(target)), {
      cmd.arg(String.from("-fPIC"));
    });
    // The name a CONSUMER records for this library. Without it macOS records
    // the `-o` path verbatim — `yo-out/<triple>/lib/libx.dylib`, relative —
    // and the program only runs from the directory it was built in; with
    // `@rpath` the consumer's `-Wl,-rpath` (an absolute directory, added by
    // the build runner) is what resolves it. Linux's equivalent is the soname.
    so_base := match(
      Path.new(output.clone()).file_name(),
      .Some(b) => b,
      .None => output.clone()
    );
    if(is_target_macos(target), {
      cmd.arg(`-Wl,-install_name,@rpath/${so_base}`);
    });
    if(is_target_linux(target), {
      cmd.arg(`-Wl,-soname,${so_base}`);
    });
  });
  // --static-library: compile to a .o (-c -fPIC) then archive into a .a.
  // Otherwise compile + link into an executable.
  if(static_library, {
    obj_path := `${output}.o`;
    cmd.arg(String.from("-c"));
    if(!(is_target_windows(target)), {
      cmd.arg(String.from("-fPIC"));
    });
    cmd.arg(c_path.clone());
    cmd.arg(String.from("-o"));
    cmd.arg(obj_path.clone());
    cst := io.await(_cc_command(cc.clone(), cmd.recorded).status(io), IoExn(io : io, exn : exn));
    if(cst.raw != i32(0), {
      exn.throw(dyn(`compile: C compiler failed (exit ${cst.code().unwrap_or(i32(-1)).to_string()}) on ${c_path}`));
      return(())
    });
    ar_out := if(output.clone().ends_with(".a"), output.clone(), `${output}.a`);
    arcmd := Command.new(String.from("ar"));
    arcmd.arg(String.from("rcs"));
    arcmd.arg(ar_out.clone());
    arcmd.arg(obj_path.clone());
    ast := io.await(arcmd.status(io), IoExn(io : io, exn : exn));
    if(ast.raw != i32(0), {
      exn.throw(dyn(`compile: ar failed (exit ${ast.code().unwrap_or(i32(-1)).to_string()}) creating ${ar_out}`));
    });
    return(())
  });
  // Executable: source + externs, output, then link libraries. Chunked
  // emission passes every chunk `.c` — cc compiles each TU and links them in
  // the one invocation (parallel per-chunk `cc -c` + a `.o` cache is step 3).
  cond(
    (chunk_c_files.len() > usize(0)) => {
      // Everything recorded so far is the COMPILE flag set; replay it for one
      // `cc -c` per chunk, in parallel and behind the `.o` cache, then link
      // the objects with the same command line.
      chunk_hits := ArrayList(usize).new();
      prof_cc_t0 := Instant.now();
      chunk_objs := _compile_chunks_parallel(
        cc.clone(),
        cmd.recorded,
        chunk_c_files,
        chunk_text_hashes,
        output.clone(),
        jobs,
        false,
        chunk_hits,
        io,
        exn
      );
      profile_record_phase(String.from("cc compile (chunks)"), prof_cc_t0.elapsed().as_nanos());
      chunk_link_flags = cmd.recorded;
      chunk_used_cache = match(chunk_hits.get(usize(0)), .Some(h) => (h > usize(0)), .None => false);
      (cci : usize) = usize(0);
      while(cci < chunk_objs.len(), {
        match(
          chunk_objs.get(cci),
          .Some(f) => {
            _arg_c := cmd.arg(f.clone());
          },
          .None => ()
        );
        cci = (cci + usize(1));
      });
    },
    true => {
      _arg_c := cmd.arg(c_path.clone());
    }
  );
  (ei : usize) = usize(0);
  while(ei < externs.len(), {
    match(
      externs.get(ei),
      .Some(f) => {
        _arg_c := cmd.arg(f.clone());
      },
      .None => ()
    );
    ei = (ei + usize(1));
  });
  cmd.arg(String.from("-o"));
  cmd.arg(output.clone());
  // POSIX-only: MSVC has no m.lib (math lives in the CRT — LNK1181 on the
  // first native-Windows probe smoke) and -pthread is meaningless there.
  // (TS passes neither for native targets; kept on POSIX to avoid touching
  // proven link lines.)
  //
  // WASM excluded: TS gates EVERY system library on `!isWasm`
  // (codegen/index.ts:526), and `-pthread` in particular is not inert for
  // emcc — it switches Emscripten into pthreads mode, which changes the shape
  // of the generated output. Passing it unconditionally is why the first
  // self-hosted wasm smoke test built `hello-world.html` but produced no
  // `hello-world.js` for the runner to execute (run 31874422392).
  if(!(is_target_windows(target)) && !(is_target_wasm(target)), {
    cmd.arg(String.from("-lm"));
    cmd.arg(String.from("-pthread"));
  });
  // liburing for async I/O (io_uring) on Linux — see `_probe_liburing`. Without
  // it every emitted `io_uring_*` reference is an undefined symbol at link time.
  if(is_target_linux(target), {
    ur := ArrayList(bool).new();
    _probe_liburing(io, ur);
    if(match(ur.get(usize(0)), .Some(b) => b, .None => false), {
      cmd.arg(String.from("-luring"));
    });
  });
  // OpenSSL for std/crypto/tls — the same probe-and-add stance as liburing
  // (plans/archive/D6_TLS_PLAN.md): when pkg-config finds it, its include/lib dirs
  // and -lssl -lcrypto are added so a program importing the tls module
  // compiles and links; when absent, only tls users fail, at their own
  // build, with the linker naming the missing library.
  if(!(is_target_windows(target)) && !(is_target_wasm(target)), {
    if(_probe_openssl(io), {
      (oi : usize) = usize(0);
      while(oi < g_openssl_includes.len(), {
        oinc := match(g_openssl_includes.get(oi), .Some(x) => x, .None => String.new());
        _arg_c := cmd.arg(`-I${oinc}`);
        oi = (oi + usize(1));
      });
      (ol : usize) = usize(0);
      while(ol < g_openssl_libdirs.len(), {
        olib := match(g_openssl_libdirs.get(ol), .Some(x) => x, .None => String.new());
        _arg_c := cmd.arg(`-L${olib}`);
        ol = (ol + usize(1));
      });
      cmd.arg(String.from("-lssl"));
      cmd.arg(String.from("-lcrypto"));
    });
  });
  (xi : usize) = usize(0);
  while(xi < libraries.len(), {
    match(
      libraries.get(xi),
      .Some(lib) => {
        _arg_c := cmd.arg(`-l${lib}`);
      },
      .None => ()
    );
    xi = (xi + usize(1));
  });
  if(is_target_windows(target), {
    cmd.arg(String.from("-lws2_32"));
    cmd.arg(String.from("-lbcrypt"));
    // mimalloc's Windows large-page support needs advapi32
    // (OpenProcessToken/LookupPrivilegeValueA); harmless when unused.
    cmd.arg(String.from("-ladvapi32"));
    // std/crypto/tls's Schannel backend (SSPI). Both ship with Windows, so
    // unlike OpenSSL there is nothing to probe for — added unconditionally,
    // the same stance as ws2_32/bcrypt above.
    cmd.arg(String.from("-lsecur32"));
    cmd.arg(String.from("-lcrypt32"));
  });
  prof_link_t0 := Instant.now();
  st := io.await(_cc_command(cc.clone(), cmd.recorded).status(io), IoExn(io : io, exn : exn));
  profile_record_phase(
    cond(
      (chunk_c_files.len() > usize(0)) => String.from("link"),
      true => String.from("cc compile+link")
    ),
    prof_link_t0.elapsed().as_nanos()
  );
  if(st.raw != i32(0), {
    // A chunk `.o` can be present with a matching stamp yet unusable (a
    // truncated or clobbered file — the stamp records the INPUTS, so it cannot
    // detect that). Rather than make the user discover `YO_BUILD_NO_CACHE=1`,
    // treat a link failure after cache hits as a poisoned cache: recompile
    // every chunk from source and link once more. A second failure is real.
    if(chunk_used_cache, {
      eprintln(String.from("compile: link failed with cached chunk objects — recompiling all chunks and retrying"));
      retry_hits := ArrayList(usize).new();
      _r := _compile_chunks_parallel(
        cc.clone(),
        chunk_link_flags,
        chunk_c_files,
        chunk_text_hashes,
        output.clone(),
        jobs,
        true,
        retry_hits,
        io,
        exn
      );
      st2 := io.await(_cc_command(cc.clone(), cmd.recorded).status(io), IoExn(io : io, exn : exn));
      if(st2.raw != i32(0), {
        exn.throw(dyn(`compile: C compiler failed (exit ${st2.code().unwrap_or(i32(-1)).to_string()} on ${c_path}`));
      });
      return(())
    });
    exn.throw(dyn(`compile: C compiler failed (exit ${st.code().unwrap_or(i32(-1)).to_string()} on ${c_path}`));
  });
  _print_compile_profile(profile_json.clone(), io, exn);
});
/// Recursively collect `*.test.yo` files under `path_str` (or `[path_str]`
/// for a file). Mirrors `findTestFiles` in src/test-runner.ts (reuses the
/// check walker, then filters to `.test.yo`).
_collect_test_files :: (
  fn(
    path_str : String,
    excludes : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> ArrayList(String)
)({
  // `excludes` has the same semantics as `check --exclude`: a path is skipped if
  // it equals an exclude or lives under one. Needed so `test ./tests` can skip
  // `tests/internal`, whose files each pull ~99k lines through their import
  // closure and peak near 6.5 GB — they cannot share a run with the fast
  // language tests. Mirrors the `exclude` option on the TS `test` subcommand
  // (src/yo-cli.ts) and `findTestFiles` (src/test-runner.ts).
  all := collect_check_files(path_str, excludes, io, exn);
  out := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < all.len(), {
    match(
      all.get(i),
      .Some(f) => if(f.ends_with(String.from(".test.yo")), {
        out.push(f.clone());
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});
/// One extracted `test("name", { body })` declaration (source-string form).
TestDecl :: struct(name : String, body_src : String);
/// Run `*.test.yo` files with the self-hosted pipeline. Port of the TS
/// test runner's BATCHED strategy (src/test-runner.ts): per file, parse and
/// split `test(name, body)` declarations from the non-test content, synthesize
/// ONE program whose `main` dispatches on the `YO_TEST_INDEX` env var over the
/// inlined test bodies (generateBatchedTestProgram, test-runner.ts:340),
/// compile it ONCE through the normal compile driver, then run the binary once
/// per test (the spawn runtime passes the parent environment through, so a
/// parent `setenv` reaches the child). v1 scope: sequential execution
/// (--parallel accepted for CLI compatibility), --bail and
/// --test-name-pattern honored; per-test ✓/✗ lines + the Test Summary
/// footer mirror the TS output (without durations/colors).
///
/// Tests are compiled in batches of `TEST_BATCH_SIZE`, mirroring TS's
/// `DEFAULT_TEST_BATCH_SIZE` (src/test-runner.ts:54).
TEST_BATCH_SIZE :: usize(100);
run_test :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  // The positional path defaults to "." (TS: .positional("path", {default: "."}),
  // src/yo-cli.ts:697-703) — a bare `yo test` runs the current directory.
  (target_path : String) = String.from(".");
  (bail : bool) = false;
  (name_pattern : String) = String.from("");
  (verbose : bool) = false;
  (no_sanitize : bool) = false;
  // Phase 0: forward --profile to every batch-compile child (each prints the
  // per-phase/per-module table on stderr) and print a per-file wall line —
  // `tests/internal`'s 22 min is the number this measures.
  (test_profile : bool) = false;
  (test_cc : String) = String.from("");
  (test_target : String) = String.from("");
  // Allocator choice forwarded to every batch compile (`--allocator fixed`
  // gives the suite a deterministic OOM oracle; plans/reference/FIXED_REGION_ALLOCATOR.md
  // §2.6 — without the forwarding the suite cannot run under `fixed` at all).
  (test_allocator : String) = String.from("");
  (test_heap_size_raw : String) = String.new();
  (test_debug_heap : bool) = false;
  (json_summary : bool) = false;
  (batch_size : usize) = TEST_BATCH_SIZE;
  // `--exclude <path>` (repeatable), same semantics as `check --exclude`.
  excludes := ArrayList(String).new();
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    a := argv(ai);
    cond(
      ((a == "--bail") || (a == "-b")) => {
        bail = true;
        ai = (ai + usize(1));
      },
      (a == "--test-name-pattern") => {
        name_pattern = _arg_val(argv, ai);
        ai = (ai + usize(2));
      },
      ((a == "--parallel") || (a == "-p")) => {
        // Accepted for CLI compatibility; v1 runs sequentially.
        ai = (ai + usize(2));
      },
      (a == "--exclude") => {
        excludes.push(_arg_val(argv, ai));
        ai = (ai + usize(2));
      },
      ((a == "-v") || (a == "--verbose")) => {
        verbose = true;
        ai = (ai + usize(1));
      },
      ((a == "--cc") || (a == "--c-compiler")) => {
        test_cc = _arg_val_req(argv, ai, a.clone(), exn);
        ai = (ai + usize(2));
      },
      (a == "--target") => {
        test_target = _arg_val_req(argv, ai, a.clone(), exn);
        ai = (ai + usize(2));
      },
      (a == "--allocator") => {
        test_allocator = _arg_val_req(argv, ai, a.clone(), exn);
        ai = (ai + usize(2));
      },
      (a == "--heap-size") => {
        test_heap_size_raw = _arg_val_req(argv, ai, a.clone(), exn);
        ai = (ai + usize(2));
      },
      (a == "--debug-heap") => {
        test_debug_heap = true;
        ai = (ai + usize(1));
      },
      (a == "--test-batch-size") => {
        bs_raw := _arg_val_req(argv, ai, a.clone(), exn);
        match(
          bs_raw.parse_u32(),
          .Some(bsv) => if(bsv > u32(0), {
            batch_size = usize(bsv);
          }, {
            exn.throw(dyn(`test: --test-batch-size must be a positive integer, got '${bs_raw}'`));
          }),
          .None => {
            exn.throw(dyn(`test: --test-batch-size must be a positive integer, got '${bs_raw}'`));
          }
        );
        ai = (ai + usize(2));
      },
      (a == "--disable-sanitize") => {
        no_sanitize = true;
        ai = (ai + usize(1));
      },
      // Consumed for CLI compatibility; the sequential in-process runner has
      // no use for them yet — accepted divergence, tracked in
      // plans/archive/P1_CLI_PARITY.md §6.
      (a == "--json-summary") => {
        json_summary = true;
        ai = (ai + usize(1));
      },
      ((a == "--keep-generated-files") || (a == "-k")) => {
        ai = (ai + usize(1));
      },
      (a == "--profile") => {
        test_profile = true;
        ai = (ai + usize(1));
      },
      a.starts_with(String.from("-")) => {
        // TS's yargs is .strict(): an unknown option is an error, never a
        // path (yo-cli.ts:1348).
        exn.throw(dyn(`test: unknown option '${a}'. Usage: yo test <path> [--bail] [--test-name-pattern P] [--parallel N] [--exclude PATH]`));
      },
      true => {
        target_path = a.clone();
        ai = (ai + usize(1));
      }
    );
  });
  // --test-name-pattern is a REGEX, exactly as TS (`new RegExp(pattern)`,
  // src/test-runner.ts:1469-1477) — the old substring match made anchored
  // patterns like '^test 19' match nothing. Compiled once; an invalid
  // pattern is an error up front.
  (name_regex : Option(Regex)) = Option(Regex).None;
  if(name_pattern.len() > usize(0), {
    match(
      Regex.new(name_pattern.clone()),
      .Ok(re) => {
        name_regex = Option(Regex).Some(re);
      },
      .Err(re_err) => {
        exn.throw(dyn(`test: invalid regex pattern '${name_pattern}': ${re_err}`));
      }
    );
    println(`Filtering tests matching: ${name_pattern}`);
  });
  // Allocator-flag validation mirrors `compile`: fixed is a valid choice and
  // --heap-size/--debug-heap belong to it alone. Parse the heap size here so
  // a bad value fails BEFORE any batch compiles.
  (test_heap_size : usize) = usize(16777216);
  if(test_allocator.len() > usize(0), {
    if(((test_allocator != "mimalloc") && (test_allocator != "system")) && (test_allocator != "fixed"), {
      exn.throw(dyn(`test: invalid --allocator "${test_allocator}". Choices: mimalloc, system, fixed`));
    });
  });
  if(test_heap_size_raw.len() > usize(0), {
    if(test_allocator != "fixed", {
      exn.throw(dyn(String.from("test: --heap-size requires --allocator fixed")));
    });
    match(
      _parse_heap_size(test_heap_size_raw.clone()),
      .Ok(bytes) => {
        test_heap_size = bytes;
      },
      .Err(why) => {
        exn.throw(dyn(`test: invalid --heap-size "${test_heap_size_raw}": ${why}`));
      }
    );
  });
  if(test_debug_heap && (test_allocator != "fixed"), {
    exn.throw(dyn(String.from("test: --debug-heap requires --allocator fixed")));
  });
  files := _collect_test_files(target_path, excludes, io, exn);
  // `Pragma.SkipWasm` pre-scan for wasm targets (hasSkipDirectiveForTarget,
  // src/test-runner.ts:152-170 + its filter loop at :1425-1453): a file whose
  // first 50 lines carry `pragma(Pragma.SkipWasm)` — or the targeted
  // `SkipWasm32Wasi`/`SkipWasm32Emscripten` variant — is skipped when the
  // corresponding wasm target is selected (via --target or --cc emcc).
  wasm_target_kind := cond(
    test_target.starts_with("wasm") => test_target.clone(),
    (test_cc == "emcc") => String.from("wasm32-unknown-emscripten"),
    true => String.from("")
  );
  // HOW a compiled batch must be built and run. A wasm artifact is NOT a host
  // executable: exec'ing one fails with `permission denied`, which is exactly
  // what both converted wasm legs hit (run 31878327019). WASI runs under
  // wasmtime, Emscripten under node — src/test-runner.ts:448-456 for the
  // extension and :747-775 for the command.
  run_is_wasi := cond(
    (wasm_target_kind == "") => false,
    true => match(
      parse_target(wasm_target_kind.clone()),
      .Ok(wt) => is_target_standalone_wasi(wt),
      .Err(_) => false
    )
  );
  run_is_emcc := ((wasm_target_kind != "") && !(run_is_wasi));
  // The extension is LOAD-BEARING, not cosmetic: emcc selects its OUTPUT
  // FORMAT from it. With the flat `.bin` name this runner used, even
  // `--target wasm32-wasip1` produced JS glue and the standalone `.wasm` the leg
  // needs was never emitted — after which the failure merely LOOKS like a
  // missing run-command branch. Verified locally with emcc 4.0.12: `-o X.bin`
  // yields `JavaScript source` for BOTH wasm targets.
  batch_ext := cond(
    run_is_wasi => String.from(".wasm"),
    run_is_emcc => String.from(".js"),
    true => String.from(".bin")
