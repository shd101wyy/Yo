    file_t0 := Instant.now();
    println(``);
    println(`${file}`);
    src_bytes := io.await(read(Path.new(file.clone()), io), IoExn(io : io, exn : exn));
    src := String.from_bytes(src_bytes);
    prog := parse(src, file.clone(), exn);
    tests := ArrayList(TestDecl).new();
    non_test := ArrayList(String).new();
    (pi : usize) = usize(0);
    while(pi < prog.len(), {
      e := match(prog.get(pi), .Some(x) => x, .None => make_err_expr());
      pi = (pi + usize(1));
      if(ast_expr_is_fn_call_of(e, BK_TEST, .None), {
        targs := match(e, .FnCall(_, _, a2, _, _) => a2, _ => ArrayList(AstExpr).new());
        if(targs.len() >= usize(2), {
          // Go through extract_test_name, which strips the surrounding quotes a
          // StringLit token value carries ("name" -> name). That matches what TS
          // reports: it reads the EVALUATED comptime string
          // (src/test-runner.ts:316) and only falls back to the raw token value.
          // Taking ntok.value directly printed `✓ "name"` and made
          // --test-name-pattern match against the quote characters.
          tname := match(extract_test_name(e), .Some(n) => n, .None => String.from("unnamed_test"));
          tbody := match(extract_test_body(e), .Some(b) => b, .None => make_err_expr());
          keep := match(name_regex, .Some(nre) => nre.is_match(tname.clone()), .None => true);
          if(keep, {
            tests.push(TestDecl(name : tname, body_src : ast_expr_to_string(tbody)));
          });
        });
      }, {
        non_test.push(ast_expr_to_string(e));
      });
    });
    if(tests.len() == usize(0), {
      println(String.from("  (no tests)"));
    }, {
      // Split the file's tests into batches of TEST_BATCH_SIZE, exactly as TS
      // does (`DEFAULT_TEST_BATCH_SIZE = 100`, src/test-runner.ts:54, sliced at
      // :1312-1315). This is not just parity — a single batch nests ONE BRACE
      // LEVEL PER TEST in the emitted `cond` chain, so a file with >~250 tests
      // exceeded clang's default `-fbracket-depth=256` and failed to compile at
      // all: tests/string/string.test.yo (252 tests) emitted C nested 261 deep
      // and died with "bracket nesting level exceeded maximum of 256". TS never
      // hit it because it was already batching — its emit for the same file
      // peaks at depth 105 across 3 batches.
      // See issues/fixed/yo-self-hollow-language-test-files.md.
      (batch_start : usize) = usize(0);
      (bi : usize) = usize(0);
      while((batch_start < tests.len()) && !(bailed), {
        batch_end := cond(
          ((batch_start + batch_size) < tests.len()) => (batch_start + batch_size),
          true => tests.len()
        );
        // Synthesize the batched program (mirror generateBatchedTestProgram).
        prog_src := String.new();
        (ni : usize) = usize(0);
        while(ni < non_test.len(), {
          match(
            non_test.get(ni),
            .Some(l) => {
              prog_src.push_string(l.clone());
              prog_src.push_str(";\n");
            },
            .None => ()
          );
          ni = (ni + usize(1));
        });
        prog_src.push_str("__yo_batch_env :: import(\"std/env\");\n");
        prog_src.push_str("main :: (fn() -> unit)({\n");
        prog_src.push_str("  io :: __yo_builtin_io;\n");
        prog_src.push_str("  match(__yo_batch_env.env.get(`YO_TEST_INDEX`),\n");
        prog_src.push_str("    .Some(__yo_test_idx) => cond(\n");
        // Arms are numbered RELATIVE to the batch (0..n-1), so YO_TEST_INDEX below
        // is the within-batch index, not the file-wide one.
        (ti : usize) = batch_start;
        while(ti < batch_end, {
          t := match(tests.get(ti), .Some(x) => x, .None => TestDecl(name : String.from(""), body_src : String.from("()")));
          prog_src.push_str("      (__yo_test_idx == `");
          prog_src.push_string((ti - batch_start).to_string());
          prog_src.push_str("`) => { ");
          prog_src.push_string(t.body_src.clone());
          prog_src.push_str("; },\n");
          ti = (ti + usize(1));
        });
        prog_src.push_str("      true => ()\n");
        prog_src.push_str("    ),\n");
        prog_src.push_str("    .None => ()\n");
        prog_src.push_str("  );\n");
        prog_src.push_str("});\n");
        prog_src.push_str("export(main);\n");
        // Write the batch program NEXT TO the test file (mirrors TS
        // compileBatchedBinary: path.join(path.dirname(filePath), baseName)) —
        // the batch must inherit the test file's relative-import base, so a
        // /tmp placement breaks every `import("./...")` in non-test content.
        batch_dir := match(
          file.last_index_of(`/`),
          .Some(sidx) => file.substring(usize(0), sidx),
          .None => String.from(".")
        );
        // The batch index is part of the name so a multi-batch file does not have
        // its batches overwrite each other (and so YO_KEEP_BATCH leaves all of
        // them behind for inspection).
        batch_base := `${batch_dir}/.yo_selftest_batch_${fi.to_string()}_${bi.to_string()}`;
        tmp_yo := `${batch_base}.yo`;
        tmp_bin := `${batch_base}${batch_ext}`;
        // The C sidecar does NOT simply append `.c`: run_compile STRIPS a
        // known target-format extension first (`.html`/`.wasm`/`.exe`/`.js`,
        // main.yo:1341-1358), so `X.js` emits `X.c` while the plain `X.bin`
        // keeps `X.bin.c`. Cleanup must follow the same rule — deleting a path
        // that was never written throws `file or directory not found` and
        // aborts the rest of the cleanup with it.
        tmp_c := if(run_is_wasi || run_is_emcc, `${batch_base}.c`, `${tmp_bin}.c`);
        io.await(write_string(Path.new(tmp_yo.clone()), prog_src.clone(), io), IoExn(io : io, exn : exn));
        // Compile the batch in a CHILD PROCESS, not in-process.
        //
        // WHY: `run_compile` creates a fresh ExprInfoTable, but compiler state lives
        // in module-level globals (func-type registry, specialization caches, impl
        // registry, module cache, prelude env, ...) that OUTLIVE it. A second
        // in-process compile therefore reused cached std ASTs whose ExprInfo was in
        // the first batch's discarded table, and codegen emitted
        // `// Failed to transpile` for std internals (ArrayList._length,
        // String._bytes, Option.unwrap, std/env getenv). MEASURED 2026-08-05: 47
        // markers on `test ./tests/string` — five ORDINARY language tests — and 59
        // on tests/internal, while every one of those files passed ALONE. Batch 1
        // and batch 2 had an IDENTICAL import list, so the trigger was purely
        // "second compile in one process".
        //
        // TS gets fresh state per batch by construction: `src/test-runner.ts:503`
        // does `moduleManager = new ModuleManager()`. yo-self has no instance to
        // re-create, so a fresh PROCESS is the faithful equivalent — and it
        // reproduces EXACTLY the standalone path, which is the verified-green one
        // (all 58 tests/internal and all 187 ./tests files pass standalone).
        //
        // Uses argv(0), so the binary must be invoked by a usable path. CI and every
        // gate script invoke it by explicit path (/tmp/yo-stage1,
        // ./src/yo-self-bin). See issues/fixed/yo-self-second-batch-in-process-ftt.md.
        self_exe := argv(usize(0));
        ccmd := Command.new(self_exe.clone());
        ccmd.arg(String.from("compile"));
        ccmd.arg(tmp_yo.clone());
        ccmd.arg(String.from("-o"));
        ccmd.arg(tmp_bin.clone());
        // Forward the runner's compiler/target choices to the child compile
        // (previously consumed-and-dropped — `yo test --cc gcc` silently
        // compiled with clang; P2.5 step 5).
        if(test_cc != "", {
          ccmd.arg(String.from("--c-compiler"));
          ccmd.arg(test_cc.clone());
        });
        if(test_target != "", {
          ccmd.arg(String.from("--target"));
          ccmd.arg(test_target.clone());
        });
        // Forward the allocator choice (and its two fixed-only companions)
        // to the batch compile — the same forwarding --cc/--target get.
        if(test_allocator != "", {
          ccmd.arg(String.from("--allocator"));
          ccmd.arg(test_allocator.clone());
        });
        if(test_allocator == "fixed", {
          ccmd.arg(String.from("--heap-size"));
          ccmd.arg(test_heap_size.to_string());
          if(test_debug_heap, {
            ccmd.arg(String.from("--debug-heap"));
          });
        });
        // Forward the error format so a batch-compile failure renders per
        // --error-format (P3 threading).
        if(!(error_format() == "human"), {
          ccmd.arg(String.from("--error-format"));
          ccmd.arg(error_format());
        });
        // `--std-path` is a GLOBAL flag: main strips it from argv before
        // subcommand dispatch and stashes it with the module manager, so the
        // RUNNER honours it — but the child `compile` is spawned with a fresh
        // argv that never carried it, and falls back to YO_STD / exe-walk-up /
        // ./std. The runner then evaluated against one std and compiled the
        // batch against another, silently.
        // See issues/fixed/yo-test-does-not-forward-std-path-to-batch-compile.md.
        match(
          get_std_path_override(),
          .Some(sp) => {
            ccmd.arg(String.from("--std-path"));
            ccmd.arg(sp);
          },
          .None => ()
        );
        // `--imports` is global the same way and travels to the batch compile
        // for the same reason.
        match(
          get_imports_file_override(),
          .Some(imf) => {
            ccmd.arg(String.from("--imports"));
            ccmd.arg(imf);
          },
          .None => ()
        );
        // Cooperative compile deadline, ported from TS's test runner
        // (`src/test-runner.ts:544`, SEQUENTIAL_COMPILE_TIMEOUT_MS). TS arms
        // it in-process; we compile in a CHILD, so it travels as a flag. A
        // runaway comptime loop in one batch now fails THAT batch with a
        // named error instead of hanging until the CI job timeout with no
        // indication of which file was responsible.
        ccmd.arg(String.from("--compile-timeout-ms"));
        ccmd.arg(String.from("600000"));
        // The runner's --profile rides along: the child prints its own
        // per-phase table (stderr is inherited).
        if(test_profile, {
          ccmd.arg(String.from("--profile"));
        });
        // The test runner is a RUNTIME harness: verification is a static
        // gate (yo check / yo compile / yo verify), and legs without Z3
        // could not run verify-pragma fixtures at all if the batch compile
        // armed their targets (the splice suppression would leave the
        // binary unasserted AND unsolvable). Opt the batch out.
        ccmd.arg(String.from("--no-verify"));
        // WASI batch binaries embed the whole evaluator, whose `evaluate()`
        // has 693+ locals; emcc's defaults (64 KB stack, 16 MB initial
        // memory) cannot hold a frame that size. TS applies these in the TEST
        // RUNNER only (test-runner.ts:655-663), never in plain `compile`, so
        // they travel as --cflags rather than becoming a compile-wide default
        // for every WASI build.
        if(run_is_wasi, {
          ccmd.arg(String.from("--cflags"));
          ccmd.arg(String.from("-sSTACK_SIZE=16777216 -sINITIAL_MEMORY=134217728"));
        });
        // TS's test runner compiles emcc batches at -O2, everything else at
        // -O0 (test-runner.ts:606, `isEmcc ? "-O2" : "-O0"`). This is
        // LOAD-BEARING for stack: the batch main inlines every test body, so
        // at -O0 each multi-KB temp (e.g. a MaybeUninit(Array(u8, 4096))
        // materialization is THREE 4 KB locals) gets its own slot and the
        // frame can exceed emcc's 64 KB default stack — LLVM's stack coloring
        // only runs at -O1+. emcc 4 squeaked under; CI's emcc 6 overflowed on
        // tests/sys/path.test.yo ("Stack overflow detected", realpath test).
        if(run_is_wasi || run_is_emcc, {
          ccmd.arg(String.from("--optimize"));
          ccmd.arg(String.from("2"));
        });
        // Default sanitizer is "address"; YO_TEST_SANITIZE overrides (e.g.
        // "thread" for the TSan CI leg) and --disable-sanitize turns it off.
        // MSVC and emcc take no sanitizer, exactly as TS
        // (src/test-runner.ts:556-566). The child compile owns the flag
        // mapping and the ASan-usability probe.
        san_choice := match(
          proc_env.get(`YO_TEST_SANITIZE`),
          .Some(sv) => sv,
          .None => String.from("address")
        );
        // `run_is_wasi` is part of the emcc test, not just the literal cc
        // string: the WASI leg selects its compiler with `--target wasm32-wasip1`
        // and never sets `--c-compiler`, so `test_cc` is "" and this gate used
        // to hand `-fsanitize=address` to emcc. TS never does, because it
        // resolves the cc first and reads `isEmcc` off the RESULT.
        if((!(no_sanitize)) && ((test_cc != "emcc") && !(run_is_wasi)), {
          ccmd.arg(String.from("--sanitize"));
          ccmd.arg(san_choice.clone());
        });
        bst := io.await(ccmd.status(io), IoExn(io : io, exn : exn));
        if(bst.raw != i32(0), {
          exn.throw(dyn(`test: batch compile failed (exit ${bst.code().unwrap_or(i32(-1)).to_string()}) for ${tmp_yo}`));
        });
        // Run each test: YO_TEST_INDEX in the PARENT env (the spawn runtime
        // passes environ through when envp is NULL). The ASan run environment
        // (TS test-runner.ts:776-840 / compiler-utils.ts:305-341) rides the
        // same channel: setting ASAN_OPTIONS/LSAN_OPTIONS on the parent
        // process reaches every test child — process-wide instead of TS's
        // per-child env object, same observable effect for the children.
        host_ti := host_target();
        // Same `run_is_wasi` correction as the --sanitize gate above: without
        // it the WASI leg built an lsan suppression file and applied a
        // LeakSanitizer verdict to an emcc artifact that carries no ASan.
        use_asan := ((!(no_sanitize)) && ((san_choice == "address") && ((test_cc != "emcc") && !(run_is_wasi))));
        // YO_TEST_LEAK_VERDICT=0 stages leak checking off entirely: LSan's
        // OWN nonzero exit fails a leaking child regardless of the runner's
        // verdict, so `detect_leaks` itself must follow the flag — ASan's
        // crash detection (UAF/double-free) stays fully armed either way.
        // The staging ratchet for the pre-existing self-hosted-emit leak
        // debt (issues/self-hosted-emit-leaks-remaining-classes.md); the
        // default stays TS-parity ON.
        leak_verdict := match(
          proc_env.get(`YO_TEST_LEAK_VERDICT`),
          .Some(lv) => (lv != "0"),
          .None => true
        );
        (lsan_supp_file : String) = String.from("");
        if(use_asan, {
          _sv_asan := proc_env.set(String.from("ASAN_OPTIONS"), if(leak_verdict, String.from("detect_leaks=1"), String.from("detect_leaks=0")));
          // Every test child runs with the nested-event-loop guard ARMED: a blocking
          // await inside a task (C37) is a deterministic panic under `yo test`, while
          // ordinary programs stay relaxed until the compiler's own build scheduler is
          // made async — measured 2026-08-29: strict mode is clean here
          // (issues/retired/compiler-build-runner-nests-event-loop.md).
          _sv_strict := proc_env.set(String.from("YO_ASYNC_STRICT"), String.from("1"));
          // macOS: suppress the well-known system-library leak reports
          // (getMacOSLsanSuppressions, compiler-utils.ts:334-341).
          if(is_target_macos(host_ti), {
            lsan_supp_file = `${tmp_bin}.lsan_supp.txt`;
            io.await(write_string(Path.new(lsan_supp_file.clone()), String.from("leak:libobjc\nleak:libdyld\nleak:libxpc\nleak:libsystem_malloc\nleak:dyld"), io), IoExn(io : io, exn : exn));
            _sv_lsan := proc_env.set(String.from("LSAN_OPTIONS"), `suppressions=${lsan_supp_file}`);
          });
          // Windows + clang: the ASan runtime DLL directory must be on PATH
          // (findClangAsanDllPath, compiler-utils.ts:231-274).
          if(is_target_windows(host_ti) && (((test_cc == "") || (test_cc == "cc")) || (test_cc == "clang")), {
            dll_cc := if((test_cc == "") || (test_cc == "cc"), String.from("clang"), test_cc.clone());
            match(
              _find_clang_asan_dll_path(dll_cc, io),
              .Some(dll_dir) => {
                cur_path := match(proc_env.get(`PATH`), .Some(pv) => pv, .None => String.from(""));
                _sv_path := proc_env.set(String.from("PATH"), `${dll_dir};${cur_path}`);
              },
              .None => ()
            );
          });
        });
        (ri : usize) = batch_start;
        while((ri < batch_end) && !(bailed), {
          t := match(tests.get(ri), .Some(x) => x, .None => TestDecl(name : String.from(""), body_src : String.from("()")));
          // std/env's portable wrapper, NOT raw libc setenv — Windows has no
          // setenv (the v0.2.0 windows seed leg failed on it); env.set
          // branches to _putenv_s there.
          _sv := proc_env.set(String.from("YO_TEST_INDEX"), (ri - batch_start).to_string());
          // Capture output (TS stdio:"pipe") — the diagnostics on failure and
          // the LeakSanitizer verdict both need it; the old `.status()` run
          // streamed everything and left a bare `✗ name` undiagnosable.
          // A wasm batch is not a host executable — see run_is_wasi/run_is_emcc.
          tcmd := cond(
            run_is_wasi => {
              wc := Command.new(String.from("wasmtime"));
              // The guest's default stack is far below what this suite's
              // recursion needs (test-runner.ts:750-753).
              wc.arg(String.from("-W"));
              wc.arg(String.from("max-wasm-stack=16777216"));
              // WASI is deny-by-default for the filesystem. All three grants
              // are load-bearing: without them file-I/O tests fail in a way
              // that reads as a compiler bug rather than a missing capability.
              wc.arg(String.from("--dir"));
              wc.arg(batch_dir.clone());
              wc.arg(String.from("--dir"));
              wc.arg(String.from("/tmp"));
              wc.arg(String.from("--dir"));
              wc.arg(run_cwd.clone());
              // --env, NOT proc_env.set: a wasmtime guest does not inherit the
              // host environment, so the process-wide YO_TEST_INDEX set above
              // would leave EVERY test in the batch running as index 0.
              wc.arg(String.from("--env"));
              wc.arg(`YO_TEST_INDEX=${(ri - batch_start).to_string()}`);
              wc.arg(tmp_bin.clone());
              wc
            },
            // Emscripten emits JS glue plus a sibling .wasm; node runs the
            // glue, which inherits the process env normally.
            run_is_emcc => {
              nc := Command.new(String.from("node"));
              nc.arg(tmp_bin.clone());
              nc
            },
            true => Command.new(tmp_bin.clone())
          );
          tout := io.await(tcmd.output(io), IoExn(io : io, exn : exn));
          (combined : String) = String.from_bytes(tout.stdout);
          combined.push_string(String.from_bytes(tout.stderr));
          (t_status : i32) = tout.status.raw;
          // Older ASan runtimes: "detect_leaks is not supported" → retry once
          // without leak detection (test-runner.ts:806-826).
          if(use_asan && combined.contains("detect_leaks is not supported"), {
            _sv_asan2 := proc_env.set(String.from("ASAN_OPTIONS"), String.from("detect_leaks=0"));
            tcmd2 := Command.new(tmp_bin.clone());
            tout2 := io.await(tcmd2.output(io), IoExn(io : io, exn : exn));
            combined = String.from_bytes(tout2.stdout);
            combined.push_string(String.from_bytes(tout2.stderr));
            t_status = tout2.status.raw;
            _sv_asan3 := proc_env.set(String.from("ASAN_OPTIONS"), if(leak_verdict, String.from("detect_leaks=1"), String.from("detect_leaks=0")));
          });
          // A leak is a FAILURE even at exit 0 (test-runner.ts:835-843) —
          // unless staged off via YO_TEST_LEAK_VERDICT=0 (hoisted above,
          // where it also disables LSan's own exit-code).
          has_leak := ((leak_verdict && ((test_cc != "emcc") && use_asan)) && (((combined.contains("LeakSanitizer") || combined.contains("detected memory leaks")) || combined.contains("Direct leak")) || combined.contains("Indirect leak")));
          if((t_status == i32(0)) && !(has_leak), {
            passed = (passed + usize(1));
            println(`  ✓ ${t.name}`);
            // Streamed output parity: tests print through the child's stdout,
            // which is now captured — re-emit it so passing tests keep their
            // visible output exactly as before.
            if(combined.len() > usize(0), {
              print(combined.clone());
            });
          }, {
            failed = (failed + usize(1));
            println(`  ✗ ${t.name}`);
            err_msg := if(
              has_leak,
              `Memory leak detected:\n${combined}`,
              `Test failed with exit code ${t_status.to_string()}\n${combined}`
            );
            // -v prints the whole diagnostic indented; the default prints the
            // first line (test-runner.ts:1263-1276).
            if(verbose, {
              err_lines := err_msg.split("\n");
              (eli : usize) = usize(0);
              while(eli < err_lines.len(), {
                el := match(err_lines.get(eli), .Some(l) => l, .None => String.from(""));
                println(`    ${el}`);
                eli = (eli + usize(1));
              });
            }, {
              first_line := match(err_msg.split("\n").get(usize(0)), .Some(l) => l, .None => String.from(""));
              println(`    ${first_line}`);
            });
            if(bail, {
              bailed = true;
            });
          });
          ri = (ri + usize(1));
        });
        if(lsan_supp_file != "", {
          io.await(remove_file(Path.new(lsan_supp_file.clone()), io), IoExn(io : io, exn : exn));
        });
        // Clean up the batch artifacts (mirrors TS cleanup()) — they live in
        // the test file's directory now, not /tmp. Debug affordance (yo-self
        // only, no TS counterpart): YO_KEEP_BATCH=1 skips the cleanup so a
        // failing batch's .yo/.c can be inspected — batch-only miscompiles
        // (the collections residuals) are unreproducible otherwise.
        if(proc_env.get(`YO_KEEP_BATCH`).is_none(), {
          // Tolerant removal (retry + warn), NOT a raw remove_file: Windows
          // holds a just-exited batch .exe for a few ms (process reaping /
          // Defender), and the raw throw aborted the whole suite — see
          // _remove_batch_artifact.
          _remove_batch_artifact(tmp_yo.clone(), io);
          _remove_batch_artifact(tmp_bin.clone(), io);
          _remove_batch_artifact(tmp_c.clone(), io);
          // Emscripten's second output: the JS glue at `tmp_bin` is paired
          // with a sibling `<base>.wasm` that no other cleanup path names, so
          // without this every emcc batch leaks one file into the test tree
          // (TS tracks it as `testWasmPath`, test-runner.ts:459).
          if(run_is_emcc, {
            _remove_batch_artifact(`${batch_base}.wasm`, io);
          });
        });
        batch_start = batch_end;
        bi = (bi + usize(1));
      });
    });
    if(test_profile, {
      eprintln(`profile: file ${file} ${_fmt_profile_ms(file_t0.elapsed().as_nanos())}`);
    });
  });
  if(test_profile, {
    eprintln(`profile: files ${files.len().to_string()} total ${_fmt_profile_ms(profile_t0.elapsed().as_nanos())}`);
  });
  if(bailed, {
    println(``);
    println(String.from("Bailing out early due to test failure (--bail)"));
  });
  println(``);
  println(String.from("Test Summary"));
  println(String.from("─────────────────────────────────"));
  if(passed > usize(0), {
    println(`${passed.to_string()} passed`);
  });
  if(failed > usize(0), {
    println(`${failed.to_string()} failed`);
  });
  println(`${(passed + failed).to_string()} total`);
  // --json-summary (P3): the same footer as one machine-readable line —
  // previously accepted-and-ignored.
  if(json_summary, {
    println(
      `{"passed":${passed.to_string()},"failed":${failed.to_string()},"total":${(passed + failed).to_string()}}`
    );
  });
  if(failed > usize(0), {
    // Route the nonzero exit through the top-level throw handler (its
    // `unsafe(exit(int(1)))` runs in the ctl-handler context, which exits
    // cleanly); a plain exit() here on the normal path aborts under the
    // self-compiled runtime (SIGABRT in teardown).
    exn.throw(dyn(`${failed.to_string()} test(s) failed`));
  });
});
/// Run the `init` subcommand — scaffold a new Yo project.
///
/// Flag contract mirrors the TS command (`src/yo-cli.ts:840-859`):
///   yo init [dir] [--name <project-name>] [--no-skills]
/// `dir` is a POSITIONAL defaulting to "." and `--name` overrides the project
/// name that would otherwise be derived from the directory basename. Anything
/// else is rejected rather than silently swallowed — `main.yo`'s other arg loops
/// assign unrecognized tokens to a path, which is how `yo test ./tests --profile`
/// ends up running against a path literally named `--profile`
/// (plans/archive/P1_CLI_PARITY.md §3). Do not copy that shape here.
/// `--no-skills` is a post-P2.5 addition (no TS counterpart): it skips the
/// bundled agent skill files and the AGENTS.md/CLAUDE.md scaffolding.
run_init :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  (dir : String) = String.from(".");
  (dir_seen : bool) = false;
  (name : Option(String)) = Option(String).None;
  (install_skills : bool) = true;
  (ai : usize) = usize(2); // skip program name + "init"
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      (arg == "--name") => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("init: --name requires a value")));
        });
        name = Option(String).Some(argv(ai + usize(1)));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--name=")) => {
        name = Option(String).Some(arg.substring(usize(7), arg.len()));
      },
      (arg == "--no-skills") => {
        install_skills = false;
      },
      arg.starts_with(String.from("-")) => {
        exn.throw(dyn(`init: unknown option '${arg}'. Usage: yo init [dir] [--name <name>] [--no-skills]`));
      },
      dir_seen => {
        exn.throw(dyn(`init: unexpected extra argument '${arg}'. Usage: yo init [dir] [--name <name>] [--no-skills]`));
      },
      true => {
        dir = arg;
        dir_seen = true;
      }
    );
    ai = (ai + usize(1));
  });
  project_dir := io.await(init_project(InitOptions(dir : dir, name : name), io, exn), IoExn(io : io, exn : exn));
  // Agent scaffolding runs AFTER the scaffold itself and degrades to a note
  // when the bundled skills are missing — it must never fail `yo init`.
  // install_agent_files is SYNC (blocking awaits inside, like
  // run_skills_install) — a plain call, no io.await.
  if(install_skills, {
    install_agent_files(project_dir, io, exn);
  });
});
run_fmt :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  // Parse arguments — collect positional paths, detect --check flag.
  input_paths := ArrayList(String).new();
  (check_mode : bool) = false;
  (ai : usize) = usize(2); // skip program name + "fmt"
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      (arg == "--check") => {
        check_mode = true;
      },
      arg.starts_with(String.from("-")) => {
        // TS's yargs is .strict(): an unknown option is an error, never a
        // path (yo-cli.ts:1348).
        exn.throw(dyn(`fmt: unknown option '${arg}'. Usage: yo fmt [paths...] [--check]`));
      },
      true => {
        input_paths.push(arg);
      }
    );
    ai = (ai + usize(1));
  });
  // TS resolves against the user's directory (yo-cli.ts:1071:
  // `process.env.YO_ORIGINAL_CWD ?? process.cwd()`).
  fmt_cwd := match(
    proc_env.get(`YO_ORIGINAL_CWD`),
    .Some(oc) => oc,
    .None => match(cwd(), .Ok(cp) => cp.to_string(), .Err(_) => String.from("."))
  );
  // TS wraps the whole handler in try/catch and prints the BARE message —
  // no `yo: error:` prefix (yo-cli.ts:1088-1090).
  fmt_exn := Exception(
    throw : (
      (fmt_err) -> {
        eprintln(`${fmt_err.to_string()}`);
        unsafe(exit(int(1)));
        unwind();
      }
    )
  );
  options := FormatYoFilesOptions(check : check_mode, cwd : fmt_cwd.clone());
  result := format_yo_files(input_paths, options, io, fmt_exn);
  // Report — TS yo-cli.ts:1077-1087: check mode lists cwd-relative paths on
  // STDERR under a header and exits 1; write mode prints one summary line.
  cn := result.changed.len();
  cond(
    check_mode => {
      if(cn > usize(0), {
        eprintln(String.from("The following Yo files need formatting:"));
        (cidx : usize) = usize(0);
        while(cidx < cn, {
          match(
            result.changed.get(cidx),
            .Some(c) => eprintln(
              Path.new(c.clone()).relative_to(Path.new(fmt_cwd.clone())).to_string()
            ),
            .None => ()
          );
          cidx = (cidx + usize(1));
        });
        unsafe(exit(int(1)));
      });
    },
    true => {
      if(cn > usize(0), {
        println(`Formatted ${cn} Yo file(s).`);
      });
    }
  );
});
/// Run the `cache` subcommand — inspect or clear the global dependency cache.
///
/// Flag contract mirrors `src/yo-cli.ts:1141-1164`:
///   yo cache <path|clean>
run_cache :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  usage := "Usage: yo cache <path|clean|gc>";
  if(argv.len() < usize(3), {
    exn.throw(dyn(`cache: missing action. ${usage}`));
  });
  action := argv(usize(2));
  if(argv.len() > usize(3), {
    exn.throw(dyn(`cache: unexpected extra argument '${argv(usize(3))}'. ${usage}`));
  });
  cache_dir := get_global_cache_dir();
  cond(
    (action == "path") => println(cache_dir),
    (action == "clean") => _cache_clean(cache_dir, io, exn),
    (action == "gc") => _cache_gc(cache_dir, io, exn),
    true => {
      exn.throw(dyn(`cache: unknown action '${action}'. ${usage}`));
    }
  );
});
/// `yo cache clean`: remove the dependency store — `store/`, `git/`, `index/`,
/// the store lock and the projects registry — and nothing else; `versions/`
/// belongs to `yo version clean`.
_cache_clean :: (
  fn(
    cache_dir : String,
    io : Io,
    exn : Exception
  ) -> unit
)({
  present := io.await(exists(Path.new(cache_dir.clone()), io), io);
  if(!present, {
    println(`Cache directory does not exist: ${cache_dir}`);
    return(());
  });
  e := IoExn(io : io, exn : exn);
  // `store/` (the parent of `store/sha256`), the mirrors and the tag index.
  dirs := ArrayList(String).new();
  dirs.push(cache_dir.concat(String.from("/store")));
  dirs.push(get_git_mirrors_dir(cache_dir.clone()));
  dirs.push(get_index_dir(cache_dir.clone()));
  (i : usize) = usize(0);
  while(i < dirs.len(), {
    d := dirs(i);
    i = (i + usize(1));
    d_present := io.await(exists(Path.new(d.clone()), io), io);
    if(d_present, {
      io.await(remove_dir_all(Path.new(d), io), e);
    });
  });
  files := ArrayList(String).new();
  files.push(store_lock_path(cache_dir.clone()));
  files.push(projects_registry_path(cache_dir.clone()));
  (j : usize) = usize(0);
  while(j < files.len(), {
    f := files(j);
    j = (j + usize(1));
    f_present := io.await(exists(Path.new(f.clone()), io), io);
    if(f_present, {
      io.await(remove_file(Path.new(f), io), e);
    });
  });
  println(`Removed the dependency store under ${cache_dir} (store/, git/, index/). versions/ is kept — 'yo version clean' removes it.`);
});
/// `yo cache gc`: drop every store tree, mirror and tag list no recorded
/// project's `yo.lock` references.
_cache_gc :: (
  fn(
    cache_dir : String,
    io : Io,
    exn : Exception
  ) -> unit
)({
  present := io.await(exists(Path.new(cache_dir.clone()), io), io);
  if(!present, {
    println(`Cache directory does not exist: ${cache_dir}`);
    return(());
  });
  report := io.await(gc_store(cache_dir.clone(), io, exn), IoExn(io : io, exn : exn));
  println(`Kept ${report.trees_kept.to_string()} tree(s) referenced by ${report.projects_kept.to_string()} project(s); removed ${report.trees_removed.to_string()} tree(s), ${report.mirrors_removed.to_string()} mirror(s), ${report.indexes_removed.to_string()} tag list(s); forgot ${report.projects_forgotten.to_string()} project(s) whose yo.lock is gone.`);
});
/// Run the `add` subcommand — declare a dependency in `yo.toml`, resolve and
/// fetch it, write `yo.lock`.
///
///   yo add <spec> [--dev] [--path <subdir>] [--name <name>] [--branch <b>] [--rev <sha>] [--verbose|-v]
run_add_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  usage := "Usage: yo add <spec> [--dev] [--path <subdir>] [--name <name>] [--branch <branch>] [--rev <sha>] [--verbose]";
  (package_spec : String) = String.new();
  (package_seen : bool) = false;
  (dev : bool) = false;
  (subdir : Option(String)) = Option(String).None;
  (name : Option(String)) = Option(String).None;
  (branch : Option(String)) = Option(String).None;
  (rev : Option(String)) = Option(String).None;
  (verbose : bool) = false;
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    arg := argv(ai);
    needs_value := ((arg == "--path") || ((arg == "--name") || ((arg == "--branch") || (arg == "--rev"))));
    cond(
      needs_value => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(`add: ${arg} requires a value. ${usage}`));
        });
        value := argv(ai + usize(1));
        cond(
          (arg == "--path") => {
            subdir = Option(String).Some(value);
          },
          (arg == "--name") => {
            name = Option(String).Some(value);
          },
          (arg == "--branch") => {
            branch = Option(String).Some(value);
          },
          true => {
            rev = Option(String).Some(value);
          }
        );
        ai = (ai + usize(1));
      },
      (arg == "--dev") => {
        dev = true;
      },
      ((arg == "--verbose") || (arg == "-v")) => {
        verbose = true;
      },
      arg.starts_with(String.from("-")) => {
        exn.throw(dyn(`add: unknown option '${arg}'. ${usage}`));
      },
      package_seen => {
        exn.throw(dyn(`add: unexpected extra argument '${arg}'. ${usage}`));
      },
      true => {
        package_spec = arg;
        package_seen = true;
      }
    );
    ai = (ai + usize(1));
  });
  if(!(package_seen), {
    exn.throw(dyn(`add: missing package. ${usage}`));
  });
  io.await(
    run_add(
      AddOptions(
        package_spec : package_spec,
        dev : dev,
        subdir : subdir,
        name : name,
        branch : branch,
        rev : rev,
        verbose : verbose
      ),
      io,
      exn
    ),
    IoExn(io : io, exn : exn)
  );
});
/// Run the `remove` subcommand — delete a dependency from `yo.toml` and prune
/// it from `yo.lock`.
///
///   yo remove <name> [--verbose|-v]
run_remove_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  usage := "Usage: yo remove <name> [--verbose]";
  (name : String) = String.new();
  (name_seen : bool) = false;
  (verbose : bool) = false;
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      ((arg == "--verbose") || (arg == "-v")) => {
        verbose = true;
      },
      arg.starts_with(String.from("-")) => {
        exn.throw(dyn(`remove: unknown option '${arg}'. ${usage}`));
      },
      name_seen => {
        exn.throw(dyn(`remove: unexpected extra argument '${arg}'. ${usage}`));
      },
      true => {
        name = arg;
        name_seen = true;
      }
    );
    ai = (ai + usize(1));
  });
  if(!(name_seen), {
    exn.throw(dyn(`remove: missing dependency name. ${usage}`));
  });
  io.await(run_remove(name, verbose, io, exn), IoExn(io : io, exn : exn));
});
/// Run the `install` subcommand — fetch every git dependency `yo.toml` names
/// into the global cache and write `yo.lock`.
///
///   yo install [--locked] [--offline] [--verbose|-v]
run_install_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  usage := "Usage: yo install [--locked] [--offline] [--verbose]";
  (verbose : bool) = false;
  (locked : bool) = false;
  (offline : bool) = false;
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      ((arg == "--verbose") || (arg == "-v")) => {
        verbose = true;
      },
      (arg == "--locked") => {
        locked = true;
      },
      (arg == "--offline") => {
        offline = true;
      },
      (arg == "--frozen") => {
        locked = true;
        offline = true;
      },
      arg.starts_with(String.from("-")) => {
        exn.throw(dyn(`install: unknown option '${arg}'. ${usage}`));
      },
      true => {
        exn.throw(dyn(`install: unexpected argument '${arg}'. \`yo install\` fetches what yo.toml declares; add a dependency with \`yo add ${arg}\`.`));
      }
    );
    ai = (ai + usize(1));
  });
  io.await(
    run_install(
      InstallOptions(update : false, names : ArrayList(String).new(), latest : false, locked : locked, offline : offline, verbose : verbose),
      io,
      exn
    ),
    IoExn(io : io, exn : exn)
  );
});
/// Run the `update` subcommand — re-resolve dependencies within their
/// requirements (all, or the named ones) and rewrite `yo.lock`.
///
///   yo update [name…] [--latest] [--offline] [--verbose|-v]
run_update_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  usage := "Usage: yo update [name...] [--latest] [--offline] [--verbose]";
  names := ArrayList(String).new();
  (verbose : bool) = false;
  (latest : bool) = false;
  (offline : bool) = false;
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      ((arg == "--verbose") || (arg == "-v")) => {
        verbose = true;
      },
      (arg == "--latest") => {
        latest = true;
      },
      (arg == "--offline") => {
        offline = true;
      },
      arg.starts_with(String.from("-")) => {
        exn.throw(dyn(`update: unknown option '${arg}'. ${usage}`));
      },
      true => names.push(arg)
    );
    ai = (ai + usize(1));
  });
  io.await(
    run_install(InstallOptions(update : true, names : names, latest : latest, locked : false, offline : offline, verbose : verbose), io, exn),
    IoExn(io : io, exn : exn)
  );
});
/// Run the `build` subcommand — evaluate `build.yo` and execute the requested
/// steps (default: `install`).
///
/// Flag contract mirrors `src/yo-cli.ts:927-…`:
///   yo build [steps..] [--cc <c>] [-t|--target <triple>] [--sysroot <dir>]
///            [--build-file <path>] [--list-steps] [--list-options] [--dry-run] [--verbose|-v]
/// One watch-mode build round: a full `run_build` whose failure is reported
/// but never exits the loop (`unwind` returns `false` from THIS fn).
_build_round_watch :: (fn(opts : BuildOptions, io : Io) -> bool)({
  swallow := Exception(
    throw : (
      (err) -> {
        eprintln(`build: FAILED — ${err.to_string()}`);
        unwind(false)
      }
    )
  );
  io.await(run_build(opts, io, swallow), IoExn(io : io, exn : swallow));
  true
});
/// `-j N` — nodes per DAG level (§4.8). Zero, a non-number or a negative
/// value is an error rather than a silent 1: a mistyped `-j` should not look
/// like a sequential build.
_parse_jobs :: (fn(value : String, exn : Exception) -> usize)(
  match(
    value.parse_u64(),
    .Some(n) => if(n > u64(0), usize(n), {
      exn.throw(dyn(`build: -j needs a positive number of jobs, got "${value}"`));
      usize(1)
    }),
    .None => {
      exn.throw(dyn(`build: -j needs a positive number of jobs, got "${value}"`));
      usize(1)
    }
  )
);
///            [--summary] [-D<name>=<value>]
run_build_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  steps := ArrayList(String).new();
  defines := HashMap(String, String).new();
  (c_compiler : Option(String)) = Option(String).None;
  (target_triple : Option(String)) = Option(String).None;
  (sysroot : Option(String)) = Option(String).None;
  (build_file : String) = String.from("./build.yo");
  (list_steps : bool) = false;
  (list_options : bool) = false;
  // Everything after `--` goes to whatever a `run` step executes (the plan's
  // B9): `yo build run -- --port 8080`.
  run_args := ArrayList(String).new();
  (after_dashdash : bool) = false;
  // `-j N` / `--jobs N`: how many nodes of one DAG level run at once (§4.8).
  // The default is 1 — concurrent nodes interleave their output.
  (jobs : usize) = usize(1);
  (dry_run : bool) = false;
  (verbose : bool) = false;
  (summary : bool) = false;
  (locked : bool) = false;
  (offline : bool) = false;
  (watch : bool) = false;
  (poll_ms : u64) = u64(200);
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      ((arg == "--cc") || (arg == "--c-compiler")) => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("build: --cc requires a value")));
        });
        c_compiler = Option(String).Some(argv(ai + usize(1)));
        ai = (ai + usize(1));
      },
      ((arg == "-t") || (arg == "--target")) => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("build: --target requires a value")));
        });
        target_triple = Option(String).Some(argv(ai + usize(1)));
        ai = (ai + usize(1));
      },
      (arg == "--sysroot") => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("build: --sysroot requires a value")));
        });
        sysroot = Option(String).Some(argv(ai + usize(1)));
        ai = (ai + usize(1));
      },
      (arg == "--build-file") => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("build: --build-file requires a value")));
        });
        build_file = argv(ai + usize(1));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--build-file=")) => {
        build_file = arg.substring(usize(13), arg.len());
      },
      // NB: the loop advances `ai` itself; only an arm that consumes an EXTRA
      // argument (a flag's value) bumps it. Bumping it here too swallowed
      // every other token: `-- one two three` arrived as `two`.
      after_dashdash => {
        run_args.push(arg.clone());
      },
      (arg == "--") => {
        after_dashdash = true;
      },
      (arg == "--list-options") => {
        list_options = true;
      },
      ((arg == "-j") || (arg == "--jobs")) => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("build: -j requires a value")));
        });
        jobs = _parse_jobs(argv(ai + usize(1)), exn);
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--jobs=")) => {
        jobs = _parse_jobs(arg.substring(usize(7), arg.len()), exn);
      },
      (arg == "--list-steps") => {
        list_steps = true;
      },
      (arg == "--dry-run") => {
        dry_run = true;
      },
      ((arg == "--verbose") || (arg == "-v")) => {
        verbose = true;
      },
      (arg == "--summary") => {
        summary = true;
      },
      (arg == "--locked") => {
        locked = true;
      },
      (arg == "--offline") => {
        offline = true;
      },
      (arg == "--frozen") => {
        locked = true;
        offline = true;
      },
      (arg == "--watch") => {
        watch = true;
      },
      (arg == "--poll-ms") => {
        pv := _arg_val_req(argv, ai, String.from("--poll-ms"), exn);
        poll_ms = match(pv.parse_u64(), .Some(n) => n, .None => u64(200));
        ai = (ai + usize(1));
      },
      // `-Dname=value` sets a build option declared by `build.option(...)`.
      (arg.starts_with(String.from("-D")) && (arg.len() > usize(2))) => {
        body := arg.substring(usize(2), arg.len());
        match(
          body.index_of(String.from("=")),
          .Some(pos) => {
            defines.insert(body.substring(usize(0), pos), body.substring(pos + usize(1), body.len()));
          },
          .None => {
            defines.insert(body.clone(), String.from("true"));
          }
        );
      },
      arg.starts_with(String.from("-")) => {
        exn.throw(dyn(`build: unknown option '${arg}'. Usage: yo build [steps..] [--build-file <path>] [--list-steps] [--list-options] [-j N] [--dry-run] [--locked] [--offline] [--verbose] [--summary] [-- <run args>]`));
      },
      true => {
        steps.push(arg);
      }
    );
    ai = (ai + usize(1));
  });
  opts := BuildOptions(
    steps : steps,
    c_compiler : c_compiler,
    target_triple : target_triple,
    sysroot : sysroot,
    build_file : build_file,
    list_steps : list_steps,
    list_options : list_options,
    run_args : run_args,
    jobs : jobs,
    dry_run : dry_run,
    verbose : verbose,
    summary : summary,
    defines : defines,
    locked : locked,
    offline : offline
  );
  if(!(watch), {
    io.await(run_build(opts, io, exn), IoExn(io : io, exn : exn));
    return(());
  });
  // `yo build --watch` (Phase C, plans/reference/INCREMENTAL_COMPILATION.md): a thin
  // loop — every round is a full `run_build`, and the Phase A inputs-sha256
  // artifact cache makes unchanged artifacts a no-op. Evaluator state is NOT
  // kept warm across rounds: artifacts compile in child processes anyway,
  // and `run_compile`'s self-containment invariant (fresh ExprInfoTable per
  // compile) is exactly what a warm parent would violate. A failing round
  // does not exit the loop.
  _first := _build_round_watch(opts, io);
  watch_files := collect_check_files(String.from("."), ArrayList(String).new(), io, exn);
  stats := HashMap(String, String).new();
  watch_snapshot(watch_files, stats, io);
  println(`build: watching ${watch_files.len().to_string()} file(s), polling every ${poll_ms.to_string()}ms — Ctrl-C to exit`);
  while(true, {
    changed := wait_for_change(watch_files, stats, poll_ms, io);
    println(`build: ${changed.len().to_string()} file(s) changed — rebuilding`);
    _ok := _build_round_watch(opts, io);
    ()
  });
});
/// Parse `yo doc [path] [options]` argv and run the doc command. Flag
/// surface mirrors the yargs definition in `src/yo-cli.ts` ("doc [path]"):
/// positional path (default "."), -o/--output (default "yo-out/doc"),
/// --title, --document-private, -v/--verbose, -f/--format
/// (html|markdown|json, default html), --version, --logo, --favicon.
/// `yo unsafe-report [path] [--json]` — the unsafe-surface audit (port of
/// the TS subcommand; scanning lives in unsafe_report.yo). A nonexistent
/// path reports on stderr and exits 1, like TS.
run_unsafe_report_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  (target : String) = String.from(".");
  (as_json : bool) = false;
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      (arg == "--json") => {
        as_json = true;
      },
      true => {
        target = arg.clone();
      }
    );
    ai = (ai + usize(1));
  });
  // Path.new(".") normalizes to the empty path, so check the CWD directly.
  target_exists := if(target == ".", true, io.await(exists(Path.new(target.clone()), io), io));
  if(!(target_exists), {
    eprintln(`unsafe-report: path does not exist: ${target}`);
    exn.throw(dyn(`unsafe-report: path does not exist`));
  });
  report := io.await(generate_unsafe_report(target.clone(), io, exn), IoExn(io : io, exn : exn));
  if(as_json, {
    println(unsafe_report_to_json(report));
  }, {
    println(format_unsafe_report(report));
  });
});
/// `yo public-safe-report [path] [--json]` — the public-signature raw-
/// pointer lint (port of the TS subcommand; scanning lives in
/// public_safe_report.yo). Informational: findings do NOT fail the exit.
run_public_safe_report_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  (target : String) = String.from("./std");
  (as_json : bool) = false;
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      (arg == "--json") => {
        as_json = true;
      },
      true => {
        target = arg.clone();
      }
    );
    ai = (ai + usize(1));
  });
  // Path.new(".") normalizes to the empty path, so check the CWD directly.
  target_exists := if(target == ".", true, io.await(exists(Path.new(target.clone()), io), io));
  if(!(target_exists), {
    eprintln(`public-safe-report: path does not exist: ${target}`);
    exn.throw(dyn(`public-safe-report: path does not exist`));
  });
  report := io.await(generate_public_safe_report(target.clone(), io, exn), IoExn(io : io, exn : exn));
  if(as_json, {
    println(public_safe_report_to_json(report));
  }, {
    println(format_public_safe_report(report));
  });
});
run_doc_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  (input : String) = String.from(".");
  (output_dir : String) = String.from("yo-out/doc");
  (title : String) = String.new();
  (include_private : bool) = false;
  (verbose : bool) = false;
  (format : String) = String.from("html");
  (version : String) = String.new();
  // `--logo` / `--favicon`: `build.documentation` has carried these since it
  // was written and nothing read them (the plan's B13); they render now.
  (logo : String) = String.new();
  (favicon : String) = String.new();
  (saw_input : bool) = false;
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      ((arg == "-o") || (arg == "--output")) => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("doc: --output requires a value")));
        });
        output_dir = argv(ai + usize(1));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--output=")) => {
        output_dir = arg.substring(usize(9), arg.len());
      },
      (arg == "--title") => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("doc: --title requires a value")));
        });
        title = argv(ai + usize(1));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--title=")) => {
        title = arg.substring(usize(8), arg.len());
      },
      (arg == "--document-private") => {
        include_private = true;
      },
      ((arg == "-v") || (arg == "--verbose")) => {
        verbose = true;
      },
      ((arg == "-f") || (arg == "--format")) => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("doc: --format requires a value")));
        });
        format = argv(ai + usize(1));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--format=")) => {
        format = arg.substring(usize(9), arg.len());
      },
      (arg == "--version") => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("doc: --version requires a value")));
        });
        version = argv(ai + usize(1));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--version=")) => {
        version = arg.substring(usize(10), arg.len());
      },
      (arg == "--logo") => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("doc: --logo requires a value")));
        });
        logo = argv(ai + usize(1));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--logo=")) => {
        logo = arg.substring(usize(7), arg.len());
      },
      (arg == "--favicon") => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("doc: --favicon requires a value")));
        });
        favicon = argv(ai + usize(1));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--favicon=")) => {
        favicon = arg.substring(usize(10), arg.len());
      },
      arg.starts_with(String.from("-")) => {
        exn.throw(dyn(`doc: unknown option '${arg}'. Usage: yo doc [path] [-o <dir>] [--title <t>] [--document-private] [-v] [-f html|markdown|json] [--version <v>] [--logo <path>] [--favicon <path>]`));
      },
      true => {
        if(saw_input, {
          exn.throw(dyn(`doc: unexpected extra positional '${arg}'`));
        });
        input = arg.clone();
        saw_input = true;
      }
    );
    ai = (ai + usize(1));
  });
  if(!((format == "html") || (format == "markdown") || (format == "json")), {
    exn.throw(dyn(`doc: invalid --format '${format}' (choices: html, markdown, json)`));
  });
  run_doc(
    DocCommandOptions(
      input : input,
      output_dir : output_dir,
      include_private : include_private,
      verbose : verbose,
      title : title,
      format : format,
      version : version,
      logo : logo,
      favicon : favicon
    ),
    io,
    exn
  );
});
/// The `version` subcommand — mirrors src/yo-cli.ts's `version [action] [value]`:
/// no action prints the current + pinned version; pin/install/list/clean
/// manage the GitHub-Releases-backed native-bundle cache
/// (plans/archive/P3_DISTRIBUTION.md item 2).
run_version_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  (action : String) = String.from("");
  (value : String) = String.from("");
  (remote : bool) = false;
  (vi : usize) = usize(2);
  while(vi < argv.len(), {
    a := argv(vi);
    cond(
      (a == "--remote") => {
        remote = true;
        vi = (vi + usize(1));
      },
      a.starts_with("-") => {
        exn.throw(dyn(`version: unknown option '${a}'`));
        vi = (vi + usize(1));
      },
      (action == "") => {
        action = a.clone();
        vi = (vi + usize(1));
      },
      true => {
        value = a.clone();
        vi = (vi + usize(1));
      }
    );
  });
  version_cwd := match(
    proc_env.get(`YO_ORIGINAL_CWD`),
    .Some(oc) => oc,
    .None => match(cwd(), .Ok(cp) => cp.to_string(), .Err(_) => String.from("."))
  );
  if(action == "", {
    current := String.from(CURRENT_YO_VERSION);
    println(`Yo ${current}`);
    pinned := io.await(read_yo_version(Path.new(version_cwd.clone()), io, exn), IoExn(io : io, exn : exn));
    match(
      pinned,
      .Some(pv) => if(pv == current, {
        println(`.yo-version: ${pv} (matches current)`);
      }, {
        println(`.yo-version: ${pv} (current: ${current})`);
      }),
      .None => println(String.from("No .yo-version file found in project."))
    );
    return(());
  });
  cond(
    (action == "pin") => {
      version_to_pin := if(value == "", String.from(CURRENT_YO_VERSION), value.clone());
      if(value != "", {
        remote_versions := io.await(fetch_remote_versions(io, exn), IoExn(io : io, exn : exn));
        (found_pin : bool) = false;
        (rvi : usize) = usize(0);
        while(rvi < remote_versions.len(), {
          match(
            remote_versions.get(rvi),
            .Some(rv) => if(rv == version_to_pin, {
              found_pin = true;
            }),
            .None => ()
          );
          rvi = (rvi + usize(1));
        });
        if(!(found_pin), {
          exn.throw(dyn(`Error: Yo version ${version_to_pin} is not available. Run \`yo version list --remote\` to see the published releases.`));
        });
      });
      io.await(write_string(Path.new(`${version_cwd}/.yo-version`), `${version_to_pin}\n`, io), IoExn(io : io, exn : exn));
      println(`Pinned Yo version to ${version_to_pin} in .yo-version`);
    },
    (action == "install") => {
      if(value == "", {
        exn.throw(dyn(String.from("Error: Specify a version to install.\nUsage: yo version install <version>")));
      });
      already := io.await(is_version_cached(value.clone(), io, exn), IoExn(io : io, exn : exn));
      if(already, {
        println(`Yo v${value} is already cached.`);
      }, {
        _dir := io.await(ensure_cached_version(value.clone(), io, exn), IoExn(io : io, exn : exn));
      });
    },
    (action == "list") => {
      current_v := String.from(CURRENT_YO_VERSION);
      if(remote, {
        remote_versions := io.await(fetch_remote_versions(io, exn), IoExn(io : io, exn : exn));
        println(String.from("Available releases:"));
        (li : usize) = usize(0);
        while(li < remote_versions.len(), {
          match(
            remote_versions.get(li),
            .Some(rv) => {
              cached_mark := if(io.await(is_version_cached(rv.clone(), io, exn), IoExn(io : io, exn : exn)), String.from(" (cached)"), String.from(""));
              current_mark := if(rv == current_v, String.from(" (current)"), String.from(""));
              println(`  ${rv}${current_mark}${cached_mark}`);
            },
            .None => ()
          );
          li = (li + usize(1));
        });
      }, {
        cached_list := io.await(list_cached_versions(io, exn), IoExn(io : io, exn : exn));
        if(cached_list.len() == usize(0), {
          println(String.from("No cached versions. Use `yo version install <version>` to cache a version."));
        }, {
          println(String.from("Cached versions:"));
          (ci : usize) = usize(0);
          while(ci < cached_list.len(), {
            match(
              cached_list.get(ci),
              .Some(cv) => {
                current_mark2 := if(cv == current_v, String.from(" (current)"), String.from(""));
                println(`  ${cv}${current_mark2}`);
              },
              .None => ()
            );
            ci = (ci + usize(1));
          });
        });
      });
    },
    (action == "clean") => {
      if(value != "", {
        was_cached := io.await(is_version_cached(value.clone(), io, exn), IoExn(io : io, exn : exn));
        if(!(was_cached), {
          println(`Yo v${value} is not cached.`);
        }, {
          io.await(clean_version_cache(Option(String).Some(value.clone()), io, exn), IoExn(io : io, exn : exn));
          println(`Removed cached Yo v${value}.`);
        });
      }, {
        cached_list2 := io.await(list_cached_versions(io, exn), IoExn(io : io, exn : exn));
        if(cached_list2.len() == usize(0), {
          println(String.from("No cached versions to remove."));
        }, {
          io.await(clean_version_cache(Option(String).None, io, exn), IoExn(io : io, exn : exn));
          println(`Removed ${cached_list2.len().to_string()} cached version(s).`);
        });
      });
    },
    true => {
      exn.throw(dyn(`Unknown action: ${action}\nAvailable actions: pin, install, list, clean`));
    }
  );
});
/// The top-level usage text (mirrors the TS `.usage(...)` block,
/// src/yo-cli.ts:209-281; the `help` cli-case golden pins this output).
_top_level_help_text :: (fn() -> String)({
  (h : String) = String.from("The Yo Programming Language ");
  h.push_str(CURRENT_YO_VERSION);
  h.push_string(
    tr(
      `
Usage:

yo compile <file> [options]      Compile a '.yo' file
Examples:
  $ yo compile main.yo -o app
  $ yo compile main.yo -cc clang -o app
  $ yo compile main.yo --target x86_64-unknown-linux-gnu -o app
  $ yo compile main.yo -l m -o app
  $ yo compile main.yo -I./include -L./lib -l mylib -o app
  $ yo compile main.yo --optimize 2 -D NDEBUG -o app
  $ yo compile main.yo -g -o app_debug
  $ yo compile main.yo --optimize 2 -s --cflags='-march=native' -o app
  $ yo compile main.yo --optimize 2 --emit-chunks 16 -o app
                                 Split the emitted C into 16 translation units
                                 (opt-in; implies -flto=thin, --no-chunk-lto opts out)

yo build [steps] [options]       Build project using build.yo
Examples:
  $ yo build                     Build all artifacts (default: install step)
  $ yo build run                 Build and run the application
  $ yo build test                Run the test suite
  $ yo build --list-steps        Show available build steps
  $ yo build --summary           Print build summary tree
  $ yo build -Dstrip=true        Pass build option to build.yo

yo init [dir] [options]          Initialize a new Yo project
Examples:
  $ yo init                      Initialize in current directory
  $ yo init my-project           Initialize in ./my-project

yo add <spec>                    Declare a dependency in yo.toml and fetch it
Examples:
  $ yo add user/repo             Latest release tag, as version = "^X.Y.Z"
  $ yo add user/repo@^1.2        Semver range
  $ yo add ./path/to/dep         Local path dependency

yo remove <name>                 Delete a dependency from yo.toml
yo install                       Fetch what yo.toml declares, write yo.lock
yo update [name...]              Re-resolve dependencies (--latest bumps ranges)

yo test [path] [options]         Run tests
Example:
  $ yo test                      Run all *.test.yo files in the workspace
  $ yo test ./tests              Run all *.test.yo files in ./tests directory
  $ yo test ./some-file.yo       Run tests in some-file.yo

yo fmt [paths...] [options]      Format Yo source files
Examples:
  $ yo fmt                       Format all .yo files in the current directory
  $ yo fmt src tests             Format .yo files under src and tests
  $ yo fmt --check               Check formatting without writing files

yo verify [path] [options]       Compile-time verification (Z3)
Examples:
  $ yo verify ./src              Verify a file/directory
  $ yo verify --format json      Machine-readable verdicts

yo doc [path] [options]          Generate API documentation
Examples:
  $ yo doc                       Document all .yo files in current directory
  $ yo doc ./src                 Document all .yo files in ./src
  $ yo doc ./src/main.yo         Document a single file
  $ yo doc -o docs               Output to ./docs directory
  $ yo doc --title "My Project"  Set doc site title

yo version                       Manage Yo versions
Examples:
  $ yo version                     Show current version and .yo-version
  $ yo version pin                 Pin current version to .yo-version
  $ yo version pin 0.1.12          Pin specific version
  $ yo version install 0.1.12      Pre-download a version
  $ yo version list                List cached versions
  $ yo version clean               Remove all cached versions

yo skills install                Install AI agent skill files into this project
Examples:
  $ yo skills install             Copy skills into every agent config dir found
                                  (.github, .agents, .claude, .opencode,
                                  .openai, .cursor; defaults to .agents)

yo --help                        Show this help message
yo <subcommand> --help           Show help for a subcommand
yo --version                     Show version number`,
      `
用法：

yo compile <file> [options]      编译 '.yo' 文件
示例：
  $ yo compile main.yo -o app
  $ yo compile main.yo -cc clang -o app
  $ yo compile main.yo --target x86_64-unknown-linux-gnu -o app
  $ yo compile main.yo -l m -o app
  $ yo compile main.yo -I./include -L./lib -l mylib -o app
  $ yo compile main.yo --optimize 2 -D NDEBUG -o app
  $ yo compile main.yo -g -o app_debug
  $ yo compile main.yo --optimize 2 -s --cflags='-march=native' -o app
  $ yo compile main.yo --optimize 2 --emit-chunks 16 -o app
                                 把生成的 C 拆成 16 个翻译单元
                                 （可选；隐含 -flto=thin，--no-chunk-lto 可退出）

yo build [steps] [options]       使用 build.yo 构建项目
示例：
  $ yo build                     构建全部产物（默认：install 步骤）
  $ yo build run                 构建并运行应用
  $ yo build test                运行测试套件
  $ yo build --list-steps        列出可用的构建步骤
  $ yo build --summary           打印构建摘要树
  $ yo build -Dstrip=true        给 build.yo 传递构建选项

yo init [dir] [options]          初始化一个新的 Yo 项目
示例：
  $ yo init                      在当前目录初始化
  $ yo init my-project           初始化到 ./my-project

yo add <spec>                    把依赖写入 yo.toml 并抓取
示例：
  $ yo add user/repo             最新发布标签，写成 version = "^X.Y.Z"
  $ yo add user/repo@^1.2        semver 范围
  $ yo add ./path/to/dep         本地路径依赖

yo remove <name>                 从 yo.toml 删除依赖
yo install                       抓取 yo.toml 声明的依赖并写入 yo.lock
yo update [name...]              在范围内重新解析依赖

yo test [path] [options]         运行测试
示例：
  $ yo test                      运行工作区内全部 *.test.yo 文件
  $ yo test ./tests              运行 ./tests 目录下的全部 *.test.yo 文件
  $ yo test ./some-file.yo       运行 some-file.yo 中的测试

yo fmt [paths...] [options]      格式化 Yo 源文件
示例：
  $ yo fmt                       格式化当前目录下所有 .yo 文件
  $ yo fmt src tests             格式化 src 和 tests 下的 .yo 文件
  $ yo fmt --check               只检查格式，不写入文件

yo verify [path] [options]       编译期验证（Z3）
示例：
  $ yo verify ./src              验证文件/目录
  $ yo verify --format json      输出机器可读的判定结果

yo doc [path] [options]          生成 API 文档
示例：
  $ yo doc                       为当前目录所有 .yo 文件生成文档
  $ yo doc ./src                 为 ./src 下所有 .yo 文件生成文档
  $ yo doc ./src/main.yo         为单个文件生成文档
  $ yo doc -o docs               输出到 ./docs 目录
  $ yo doc --title "My Project"  设置文档站标题

yo version                       管理 Yo 版本
示例：
  $ yo version                     显示当前版本和 .yo-version
  $ yo version pin                 把当前版本锁定到 .yo-version
  $ yo version pin 0.1.12          锁定指定版本
  $ yo version install 0.1.12      预下载某个版本
  $ yo version list                列出已缓存的版本
  $ yo version clean               删除所有缓存的版本

yo skills install                把 AI 代理技能文件安装到本项目
示例：
  $ yo skills install             复制技能到每个已存在的 agent 配置目录
                                  （.github、.agents、.claude、.opencode、
                                  .openai、.cursor；默认建 .agents）

yo --help                        显示本帮助
yo <subcommand> --help           显示子命令帮助
yo --version                     显示版本号`
    )
  );
  h
});
/// Per-subcommand help text (`yo <subcommand> --help`). Returns `.None` for
/// an unknown subcommand (the caller falls back to the top-level usage).
/// Print each line of `text` indented two spaces (registry examples).
_print_indented :: (fn(text : String) -> unit)({
  parts := text.split(String.from("\n"));
  (i : usize) = usize(0);
  while(i < parts.len(), {
    match(
      parts.get(i),
      .Some(l) => println(`  ${l}`),
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// `yo explain <CODE>` — print a diagnostic code's bilingual explanation,
/// offline, from the compiled-in registry (P2,
/// plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md §6). `--list` enumerates every code;
/// `--format json` carries both languages; `--lang zh-CN` (or the YO_LANG
/// env var) selects the Chinese prose. Exit 0 when found; an unknown code
/// exits 1 with a did-you-mean over the registry.
run_explain :: (
  fn(argv : ArrayList(String), io : Io, exn : Exception) -> unit
)({
  (show_list : bool) = false;
  (as_json : bool) = false;
  // The global `--lang` pre-scan and YO_LANG both resolve here now
  // (src/cli_lang.yo); explain keeps no private language handling.
  lang := cli_lang();
  (target : String) = String.new();
  (ai : usize) = usize(1);
  while(ai < argv.len(), {
    a := argv(ai);
    if(a == "--list", {
      show_list = true;
      ai = (ai + usize(1));
    }, {
      if(a == "--format", {
        as_json = true;
        ai = (ai + usize(2));
      }, {
        if(a.starts_with(String.from("--format=")), {
          as_json = (a.substring(usize(9), a.len()) == "json");
          ai = (ai + usize(1));
        }, {
          target = a.clone();
          ai = (ai + usize(1));
        });
      });
    });
  });
  if(show_list, {
    entries := registry_entries();
    (ei : usize) = usize(0);
    while(ei < entries.len(), {
      match(
        entries.get(ei),
        .Some(e) => {
          if(as_json, {
            println(explain_to_json(e));
          }, {
            if((lang == "zh-CN"), {
              println(`${e.code}  ${e.title_zh}`);
            }, {
              println(`${e.code}  ${e.title}`);
            });
          });
        },
        .None => ()
      );
      ei = (ei + usize(1));
    });
    return(());
  });
  if(target.len() == usize(0), {
    exn.throw(
      dyn(`explain: missing error code. Usage: yo explain <CODE> | yo explain --list`)
    );
  });
  match(
    lookup_explain(target),
    .Some(e) => {
      if(as_json, {
        println(explain_to_json(e));
        return(());
      });
      if((lang == "zh-CN"), {
        println(`${e.code} — ${e.title_zh}`);
        println(``);
        println(e.summary_zh);
        println(``);
        println(e.explanation_zh);
        println(``);
        println(`示例 — 这样会报错：`);
        _print_indented(e.bad);
        println(`示例 — 改成这样：`);
        _print_indented(e.good);
        _print_indented(e.why_zh);
      }, {
        println(`${e.code} — ${e.title}`);
        println(``);
        println(e.summary);
        println(``);
        println(e.explanation);
        println(``);
        println(`Example — this fails:`);
        _print_indented(e.bad);
        println(`Example — write this instead:`);
        _print_indented(e.good);
        _print_indented(e.why);
      });
      println(`Run 'yo explain --list' for all codes.`);
    },
    .None => {
      hint := suggest_code(target);
      match(
        hint,
        .Some(h) => exn.throw(
          dyn(
            `explain: unknown error code '${target}'\nhelp: did you mean '${h}'? Run 'yo explain --list' for all codes.`
          )
        ),
        .None => exn.throw(
          dyn(
            `explain: unknown error code '${target}'. Run 'yo explain --list' for all codes.`
          )
        )
      );
    }
  );
});
_subcommand_help_text :: (fn(subcmd : String) -> Option(String))(
  cond(
    (subcmd == "compile") => Option(String).Some(
      tr(
        `Usage: yo compile <file.yo> [options]

Compile a '.yo' source file to a native executable (via C11).

Options:
  -o <path>                 Output binary path
  --optimize <level>        C optimization level (0|1|2|3); default is -O0.
                            Use 2 for real builds. Any level above 0 also
                            enables the ThinLTO pairing that --emit-chunks
                            requires.
  -g, --debug-symbols       Emit debug symbols
  -s, --strip               Strip the output binary
  --cc, --c-compiler <cc>   C compiler to use (clang|gcc|zig|emcc)
  -t, --target <triple>     Cross-compile target (e.g. x86_64-unknown-linux-gnu, wasm32-wasip1)
  --sysroot <dir>           Sysroot for cross-compilation
  --cflags '<flags>'        Extra flags passed to the C compiler
  -D, --define <N[=V]>      Preprocessor define for the C compile
  -I <dir> / -L <dir>       Include / library search path
  -l <name>                 Link a library
  --extern <spec>           Extern library spec (pkg-config integration)
  --static                  Static link
  --static-library          Build a static library instead of an executable
  --shared-library          Build a shared library (lib<name>.dylib/.so/.dll)
  --sanitize <kind>         Sanitizer (address|thread|undefined)
  --disable-sanitize        Drop sanitizer flags added by defaults
  --allocator <name>        Allocator (system|mimalloc|fixed)
  --heap-size <size>        Fixed-region heap, e.g. 16M (only with --allocator fixed; 64K..4G)
  --debug-heap              Print heap stats + live-at-exit leak oracle at exit (fixed only)
  --emit-c                  Print the generated C to stdout and stop
  --emit-c-to <path>        Write the generated C to a file and stop
  --emit-deps <path>        Write the files this compile read, one per line
  --skip-c-compiler         Generate C but skip the C compile
  --skip-codegen            Evaluate only (no C generation)
  --emit-chunks <n|auto>    Split emitted C into n translation units (implies -flto=thin);
                            auto picks n from emitted size and core count (YO_JOBS overrides)
  --no-chunk-lto            Opt out of ThinLTO for chunked builds
  --jobs <n>                Parallel C compiles for chunked builds
  --compile-timeout-ms <ms> C compiler timeout
  --profile                 Print per-phase / per-module timing on stderr
  --profile-json <path>     Write the profile as JSON (module keys are absolute paths)
  --emcc-environment <env>  Emscripten environment (node|web)
  --debug-gc / --debug-async-await / --debug-parallelism
                            Runtime debug logging in the emitted binary
  --std-path <dir>          Override the std library directory

Examples:
  $ yo compile main.yo -o app
  $ yo compile main.yo --optimize 2 --target x86_64-unknown-linux-gnu -o app
  $ yo compile main.yo --emit-c --skip-c-compiler --optimize 2`,
        `用法：yo compile <file.yo> [options]

把 '.yo' 源文件编译为原生可执行文件（经 C11）。

选项：
  -o <path>                 输出二进制路径
  --optimize <level>        C 优化级别（0|1|2|3）；默认 -O0。
                            真实构建请用 2。大于 0 的级别还会启用
                            --emit-chunks 所依赖的 ThinLTO 配对。
  -g, --debug-symbols       生成调试符号
  -s, --strip               剥离输出二进制
  --cc, --c-compiler <cc>   使用的 C 编译器（clang|gcc|zig|emcc）
  -t, --target <triple>     交叉编译目标（如 x86_64-unknown-linux-gnu、wasm32-wasip1）
  --sysroot <dir>           交叉编译的 sysroot
  --cflags '<flags>'        传给 C 编译器的额外标志
  -D, --define <N[=V]>      C 编译阶段的预处理器宏定义
  -I <dir> / -L <dir>       头文件 / 库文件搜索路径
  -l <name>                 链接一个库
  --extern <spec>           外部库规格（pkg-config 集成）
  --static                  静态链接
  --static-library          构建静态库而非可执行文件
  --shared-library          构建动态库（lib<name>.dylib/.so/.dll）
  --sanitize <kind>         清理器（address|thread|undefined）
  --disable-sanitize        去掉默认追加的清理器标志
  --allocator <name>        分配器（system|mimalloc|fixed）
  --heap-size <size>        固定区域堆大小，如 16M（仅 --allocator fixed；64K..4G）
  --debug-heap              退出时打印堆统计与存活块泄漏检查（仅 fixed）
  --emit-c                  把生成的 C 打印到 stdout 然后停止
  --emit-c-to <path>        把生成的 C 写入文件然后停止
  --emit-deps <path>        把本次编译读取的文件逐行写入该文件
  --skip-c-compiler         只生成 C，跳过 C 编译
  --skip-codegen            只做求值（不生成 C）
  --emit-chunks <n|auto>    把生成的 C 拆成 n 个翻译单元（隐含 -flto=thin）；
                            auto 按产物大小与核数选 n（可用 YO_JOBS 覆盖）
  --no-chunk-lto            分块构建时退出 ThinLTO
  --jobs <n>                分块构建的并行 C 编译数
  --compile-timeout-ms <ms> C 编译器超时
  --profile                 在 stderr 上打印分阶段/分模块耗时
  --profile-json <path>     把耗时写成 JSON（模块键为绝对路径）
  --emcc-environment <env>  Emscripten 环境（node|web）
  --debug-gc / --debug-async-await / --debug-parallelism
                            产出二进制内的运行时调试日志
  --std-path <dir>          覆盖标准库目录

示例：
  $ yo compile main.yo -o app
  $ yo compile main.yo --optimize 2 --target x86_64-unknown-linux-gnu -o app
  $ yo compile main.yo --emit-c --skip-c-compiler --optimize 2`
      )
