// Temporary C source path used during compilation.
C_TMP :: "/tmp/yo_self_out.c";
extract_bare_import_path :: (fn(e : AstExpr) -> Option(String))(
  match(
    e,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, func_box, fn_imp_args, is_infix, _) => cond(
      is_infix => Option(String).None,
      (fn_imp_args.len() != usize(1)) => Option(String).None,
      (
        !(
          match(
            func_box,
            .Atom(_, tok) => (tok.value == BK_IMPORT),
            .FnCall(_, _, _, _, _) => false
          )
        )
      ) => Option(String).None,
      true => match(
        fn_imp_args.get(usize(0)),
        .None => Option(String).None,
        .Some(path_arg) => match(
          path_arg,
          .FnCall(_, _, _, _, _) => Option(String).None,
          .Atom(_, ptok) => {
            raw := ptok.value.clone();
            n := raw.len();
            cond(
              (n < usize(2)) => Option(String).None,
              true => .Some(raw.substring(usize(1), n - usize(1)))
            )
          }
        )
      )
    )
  )
);
/// Extract the import path from any import form:
///   - `{ Names } :: import("path")` (infix `::`, RHS is import call)
///   - `import("path")` (bare import call)
/// Returns the path without surrounding quotes, or .None if not an import expression.
extract_import_path :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, func_box, fn_imp_args, is_infix, _) => {
      fval := match(
        func_box,
        .Atom(_, tok) => tok.value.clone(),
        .FnCall(_, _, _, _, _) => String.new()
      );
      cond(
        // Pattern: { Names } :: import "path" (infix ::)
        (((fval == "::") && is_infix) && (fn_imp_args.len() >= usize(2))) =>
          match(
            fn_imp_args.get(usize(1)),
            .None => Option(String).None,
            .Some(rhs) => extract_bare_import_path(rhs)
          ),
        // Pattern: bare import "path"
        true => extract_bare_import_path(expr)
      )
    }
  )
);
export(extract_bare_import_path, extract_import_path);
/// Recursively collect every `import(...)` path reachable from `expr`,
/// including imports NESTED inside `impl({...})` / module / `begin`
/// bodies. `extract_import_path` only inspects a single expression, so a
/// top-level-only walk misses e.g. `env :: impl({ { getenv, setenv } ::
/// import("./libc/stdlib"); ... })` — the import lives inside the impl
/// body, not at module top level. The preload step (main.yo) needs these
/// nested imports cached, otherwise `evaluate_import` fails with
/// "module not preloaded" when the impl body is evaluated.
///
/// Paths may appear more than once (e.g. a `{ ... } :: import(p)` node
/// yields `p`, and recursing into its `import(p)` child yields `p`
/// again); callers dedup by resolved path.
collect_import_paths_recursive :: (
  fn(expr : AstExpr, out : ArrayList(String)) -> unit
)({
  match(
    extract_import_path(expr),
    .Some(p) => {
      out.push(p);
    },
    .None => ()
  );
  match(
    expr,
    .Atom(_, _) => (),
    .FnCall(_, fb, walk_args, _, _) => {
      recur(fb, out);
      (i : usize) = usize(0);
      while(i < walk_args.len(), {
        match(
          walk_args.get(i),
          .Some(a) => recur(a, out),
          .None => ()
        );
        i = (i + usize(1));
      });
    }
  );
});
export(collect_import_paths_recursive);
// Temporary binary path used for test execution.
TEST_BIN_TMP :: "/tmp/yo_self_test_bin";
/// Derive a simple module ID string from a file path String.
/// For Phase 5a/5b: returns a fixed safe C identifier — sufficient for compilation.
module_id_from_path :: (fn(path : String) -> String)(
  // path reserved for future use (filename stem extraction)
  String.from("yo_module")
);
/// Stream A: try to populate the typed AST metadata table by running the
/// proper evaluator over the parsed top-level expressions. On any failure
/// (the evaluator's coverage of real source files is still incomplete),
/// return `.None` so the codegen dispatcher uses its AST-only bootstrap
/// heuristics. See `plans/archive/BOOTSTRAPPING.md` Path Forward Stream A.
try_populate_expr_info_table :: (
  fn(
    exprs : ArrayList(AstExpr),
    module_path : String
  ) -> Option(ExprInfoTable)
)({
  // Local exception handler: on any throw from the evaluator, unwind this
  // helper with `.None`. The handler is scoped to this function so the
  // outer compile / test pipeline keeps its own top-level handler intact.
  local_exn := Exception(
    throw : (
      (_err) -> unwind(Option(ExprInfoTable).None)
    )
  );
  // Build a fresh Environment + EvalContext for this compilation. std_path
  // is resolved from `YO_STD` (or `./std` fallback) so the modular import
  // handler can find `std/...` modules. The local exception unwind catches
  // any evaluator coverage gap (e.g. unported HKT/RC features in prelude).
  env := Environment.new(module_path);
  ctx := eval_context_new(resolve_std_path(), module_path);
  ctx.is_executing = true;
  // Wire the proper expression-evaluator function pointer.
  register_evaluate_expression();
  // Drive the module body through the proper evaluator. We discard the
  // returned AnonModuleResult and just keep the table that
  // `ctx.expr_info_table` accumulated as a side effect.
  _r := evaluate_anonymous_module_begin_exprs(
    exprs,
    env,
    ctx,
    false,
    false,
    true,
    local_exn
  );
  Option(ExprInfoTable).Some(ctx.expr_info_table)
});
/// Extract the test name string from a `test("name", { body })` expression.
/// Returns None if the expression is not a 2-arg test call.
extract_test_name :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, func_box, fn_args, is_infix, _) => cond(
      (is_infix) => Option(String).None,
      (fn_args.len() < usize(2)) => Option(String).None,
      (
        !(
          match(
            func_box,
            .Atom(_, ftok) => (ftok.value == "test"),
            .FnCall(_, _, _, _, _) => false
          )
        )
      ) => Option(String).None,
      true => match(
        fn_args.get(usize(0)),
        .None => Option(String).None,
        .Some(name_expr) => match(
          name_expr,
          .FnCall(_, _, _, _, _) => Option(String).None,
          .Atom(_, ntok) => cond(
            (ntok.kind == TokenKind.StringLit) => {
              // StringLit token values include surrounding double-quotes: "name"
              // Strip them with substring(1, len-1).
              n := ntok.value.len();
              cond(
                (n >= usize(2)) => .Some(ntok.value.substring(usize(1), n - usize(1))),
                true => .Some(ntok.value)
              )
            },
            true => Option(String).None
          )
        )
      )
    )
  )
);
/// Extract the test body expression from a `test("name", { body })` call.
/// Returns the second argument (the body expression).
extract_test_body :: (fn(expr : AstExpr) -> Option(AstExpr))(
  match(
    expr,
    .Atom(_, _) => Option(AstExpr).None,
    .FnCall(_, _, fn_args, _, _) => cond(
      (fn_args.len() < usize(2)) => Option(AstExpr).None,
      true => fn_args.get(usize(1))
    )
  )
);
// ---------------------------------------------------------------------------
// Phase 5g: import resolution helpers
// ---------------------------------------------------------------------------
/// Normalize an import path: append `.yo` if not already present.
normalize_import_path :: (fn(path_str : String) -> String)(
  cond(
    (path_str.ends_with(".yo") || path_str.ends_with(".test.yo")) => path_str.clone(),
    true => `${path_str}.yo`
  )
);
/// Recursively collect all transitive module declarations for a given import.
///
/// - `path_str`: unquoted import path (e.g. `"../types/tags.yo"`)
/// - `base_dir`: directory of the importing file (for relative path resolution)
/// - `visited`: pointer to set of already-visited absolute paths (deduplication)
/// - `all_exprs`: pointer to accumulator; declarations are appended in post-order
///
/// Skips `std/` imports — those are provided by the C preamble headers.
/// Uses DFS post-order so each module's dependencies appear before it.
collect_module_deps :: (
  fn(
    path_str : String,
    base_dir : String,
    std_base : String,
    visited : ArrayList(String),
    all_exprs : ArrayList(AstExpr),
    io : Io,
    exn : Exception
  ) -> unit
)({
  // Standard library imports: when std_base is empty, skip (legacy behavior —
  // codegen handles std symbols via the C preamble). When std_base is set,
  // rewrite `std/foo` → `{std_base}/foo` and follow it like a regular dep so
  // the evaluator can see prelude/std declarations.
  (effective_path : String) = path_str.clone();
  (effective_base : String) = base_dir.clone();
  if(path_str.starts_with("std/"), {
    if(std_base.len() == usize(0), {
      return(());
    });
    rest := path_str.substring(usize(4), path_str.len());
    effective_path = rest.clone();
    effective_base = std_base.clone();
  });
  // Normalize extension: append .yo if missing
  norm_path := normalize_import_path(effective_path.clone());
  // Resolve absolute path by normalizing base_dir/norm_path as one string.
  // The explicit `normalize()` folds ".." for relative imports like
  // "../types/tags.yo": `Path` records ".." as written (folding it is wrong
  // over symlinks), and this string has to match resolve_module_path's cache
  // key, which folds the same way.
  abs_path_raw := Path.new(`${effective_base}/${norm_path}`).normalize().to_string();
  // When std_base is empty, also skip paths that resolve into std/ (e.g.
  // relative imports like "../string" from within std/imm/). With std_base
  // set, std/ resolves into std_base and these paths should be followed.
  if((std_base.len() == usize(0)) &&
    abs_path_raw.clone().starts_with(String.from("std/")), {
    return(());
  });
  // Handle directory modules: if path.yo doesn't exist but path/index.yo does, use the latter.
  (abs_path : String) = abs_path_raw.clone();
  (file_found : bool) = io.await(exists(Path.new(abs_path_raw.clone()), io), io);
  if(!(file_found), {
    // Strip the trailing .yo (3 chars) to get the base name, then try index.yo
    base_len := abs_path_raw.len();
    base_no_ext := abs_path_raw.substring(usize(0), base_len - usize(3));
    index_path := `${base_no_ext}/index.yo`;
    index_found := io.await(exists(Path.new(index_path), io), io);
    cond(
      index_found => {
        abs_path = index_path;
      },
      true => {
        return(());
      }
    );
  });
  // Deduplication: skip if already visited (also handles import cycles)
  nv := visited.len();
  (iv : usize) = usize(0);
  (already_visited : bool) = false;
  while((iv < nv) && (!(already_visited)), {
    iv = (iv + usize(1));
    match(
      visited.get(iv - usize(1)),
      .None => (),
      .Some(v) => {
        if(v == abs_path, {
          already_visited = true;
        });
      }
    );
  });
  if(already_visited, {
    return(());
  });
  // Mark as visited before recursing (prevents infinite loops on cycles)
  visited.push(abs_path.clone());
  // Compute the base directory of the imported module for recursive resolution
  mod_base_dir := match(
    Path.new(abs_path.clone()).parent(),
    .None => String.from("."),
    .Some(p) => p.to_string()
  );
  // Read and parse the imported module
  src_bytes := io.await(read(Path.new(abs_path.clone()), io), IoExn(io : io, exn : exn));
  src := String.from_bytes(src_bytes);
  mod_exprs := parse(src, mod_base_dir.clone(), exn);
  // Recursively collect dependencies of this module first (post-order DFS)
  nm := mod_exprs.len();
  (im : usize) = usize(0);
  while(im < nm, {
    im = (im + usize(1));
    match(
      mod_exprs.get(im - usize(1)),
      .None => (),
      .Some(e) => match(
        extract_import_path(e),
        .None => (),
        .Some(child_path) => {
          recur(
            child_path.clone(),
            mod_base_dir.clone(),
            std_base,
            visited,
            all_exprs,
            io,
            exn
          );
        }
      )
    );
  });
  // Append this module's declarations to all_exprs (after its deps)
  im = usize(0);
  while(im < nm, {
    im = (im + usize(1));
    match(
      mod_exprs.get(im - usize(1)),
      .None => (),
      .Some(e) => {
        all_exprs.push(e);
      }
    );
  });
});
/// Resolve a path for exclude comparison: make it absolute against the cwd,
/// normalize separators to `/`, and fold `.`/`..` segments — the value-level
/// equivalent of TS `path.resolve` for matching purposes.
_resolve_for_match :: (fn(p : String) -> String)({
  cwd_str := match(cwd(), .Ok(c) => c.to_string(), .Err(_) => String.from("."));
  (joined : String) = p.clone();
  is_abs := (p.starts_with("/") || ((p.len() > usize(1)) && (p.byte_at(usize(1)) == u8(58))));
  if(!(is_abs), {
    joined = `${cwd_str}/${p}`;
  });
  norm := joined.replace(String.from("\\"), String.from("/"));
  parts := norm.split("/");
  kept := ArrayList(String).new();
  (pi : usize) = usize(0);
  while(pi < parts.len(), {
    part := match(parts.get(pi), .Some(s) => s, .None => String.from(""));
    pi = (pi + usize(1));
    cond(
      ((part == "") || (part == ".")) => (),
      (part == "..") => if(kept.len() > usize(0), {
        _popped := kept.pop();
      }),
      true => {
        kept.push(part);
      }
    );
  });
  (rebuilt : String) = String.from("");
  (ki : usize) = usize(0);
  while(ki < kept.len(), {
    seg := match(kept.get(ki), .Some(s) => s, .None => String.from(""));
    rebuilt.push_string(String.from("/"));
    rebuilt.push_string(seg);
    ki = (ki + usize(1));
  });
  if(rebuilt.len() == usize(0), {
    rebuilt = String.from("/");
  });
  rebuilt
});
/// Recursive helper for `collect_check_files` — walks a directory
/// tree appending each `.yo` file path to `out`.
_walk_check_dir :: (
  fn(
    dir : String,
    out : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  entries := io.await(read_dir(Path.new(dir.clone()), io), IoExn(io : io, exn : exn));
  (n : usize) = entries.len();
  (i : usize) = usize(0);
  while(i < n, {
    i = (i + usize(1));
    match(
      entries.get(i - usize(1)),
      .None => (),
      .Some(entry) => {
        full := Path.new(dir.clone()).join(Path.new(entry.name.clone())).to_string();
        match(
          entry.file_type,
          .Directory => {
            // Skip noisy infrastructure dirs (mirror src/yo-cli.ts:walkCheckDir).
            skip := cond(
              (entry.name == "node_modules") => true,
              (entry.name == "vendor") => true,
              (entry.name == ".git") => true,
              (entry.name == "vscode-extension") => true,
              (entry.name == "outdated") => true,
              true => false
            );
            if(!(skip), {
              recur(full, out, io, exn);
            });
          },
          .File => {
            // Skip dot-prefixed `.yo` files — auto-generated, not-yet-
            // cleaned-up test-batch artifacts (`.yo_test_batch_*.yo`), not
            // source. Mirrors `walkCheckDir` in `src/yo-cli.ts`.
            if((entry.name.ends_with(String.from(".yo")) || entry.name.ends_with(String.from(".test.yo"))) && !(entry.name.starts_with(String.from("."))), {
              out.push(full);
            });
          },
          .Symlink => (),
          .Other => ()
        );
      }
    );
  });
});
/// Collect every `.yo` file at or under `path_str`. If `path_str` is a
/// file, returns `[path_str]`. If it's a directory, walks recursively
/// and returns sorted absolute paths. `.test.yo` files are included
/// (they have `test("name", { body })` declarations which the
/// evaluator can still typecheck). Noisy infra dirs like
/// `node_modules`/`.git`/`vscode-extension`/`outdated` are skipped.
/// Mirrors `collectCheckFiles` in `src/yo-cli.ts`.
collect_check_files :: (
  fn(
    path_str : String,
    excludes : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> ArrayList(String)
)({
  raw := ArrayList(String).new();
  meta := io.await(metadata(Path.new(path_str.clone()), io), IoExn(io : io, exn : exn));
  cond(
    meta.is_file() => {
      if(path_str.ends_with(String.from(".yo")) || path_str.ends_with(String.from(".test.yo")), {
        raw.push(path_str.clone());
      });
    },
    meta.is_dir() => _walk_check_dir(path_str, raw, io, exn),
    true => ()
  );
  // ANCHORED exclude matching, TS parity (src/yo-cli.ts:58-64): both sides
  // resolve against the cwd, and a file is excluded when it IS the exclude
  // path or lives under it (`p === ex || p.startsWith(ex + sep)`). The old
  // substring `fp.contains(ex)` over-matched — `--exclude tests/fn` also
  // dropped `tests/fn_pointers.test.yo` (P2.5 step 6).
  resolved_excludes := ArrayList(String).new();
  (rei : usize) = usize(0);
  while(rei < excludes.len(), {
    rex := match(excludes.get(rei), .Some(e) => e, .None => String.from(""));
    if(!(rex.is_empty()), {
      resolved_excludes.push(_resolve_for_match(rex));
    });
    rei = (rei + usize(1));
  });
  out := ArrayList(String).new();
  (ri : usize) = usize(0);
  while(ri < raw.len(), {
    fp := match(raw.get(ri), .Some(p) => p, .None => String.from(""));
    fp_res := _resolve_for_match(fp.clone());
    (skip : bool) = false;
    (ei : usize) = usize(0);
    while((ei < resolved_excludes.len()) && !(skip), {
      ex := match(resolved_excludes.get(ei), .Some(e) => e, .None => String.from(""));
      if((fp_res == ex) || fp_res.starts_with(`${ex}/`), {
        skip = true;
      });
      ei = (ei + usize(1));
    });
    if(!(skip), {
      out.push(fp);
    });
    ri = (ri + usize(1));
  });
  // Sort for deterministic check order (TS parity: src/yo-cli.ts:76).
  // Raw readdir order is filesystem-dependent (ext4 hash order varies per
  // checkout), which made `check ./std` order — and therefore whether the
  // prelude was reached as a target before its dependents — a lottery.
  // See issues/fixed/seed-built-stage1-array-fill-method-miss.md.
  out.sort();
  out
});
/// Run the evaluator against a single `.yo` file. Returns `true` on
/// success; on any thrown evaluator error, `mm_load_file`'s local exception
/// handler catches it and the outcome comes back not-ok, so a directory walk
/// keeps going across files. The evaluator's own `evaluate_expression: …`
/// diagnostic has already been printed by the time the throw fires, so the
/// caller just needs to log which file failed.
///
/// The loading itself lives in `module_manager.yo` — `check` is one caller of
/// that service, not its owner.
/// V3 (plan task 6, the check/compile integration): drain the VerifyTask
/// registry after an evaluation whose entry file was armed as a
/// verification target, discharge the obligations, and apply the
/// `verify+` strip pass. Prints one line per function report; the
/// failure policy per the plan's verdict table: REFUTED is always a
/// failure; unproven/solver-error/subset fail in `verify` mode and
/// degrade to warnings in `verify+` (the runtime asserts stay). A
/// missing solver is a FAILURE, not a skip: verify-mode codegen carries
/// NO runtime asserts (the splice was suppressed), so shipping without
/// the proofs would be unsound.
_run_contract_verification :: (fn(io : Io, exn : Exception) -> bool)({
  tasks := take_verify_tasks();
  if((tasks.len() == usize(0)), {
    return(true);
  });
  cfg := default_verify_run_config();
  binary := match(
    resolve_solver_sync(cfg),
    .Resolved(p) => p,
    .InvalidPath(p) => {
      eprintln(`verify: solver path '${p}' does not exist`);
      return(false);
    },
    .Installable => {
      eprintln(
        `verify: no Z3 solver found — this file's verify-mode contracts need proofs (their runtime asserts are suppressed). Run 'yo verify <file>' once to auto-install the pinned Z3, or point YO_Z3_PATH at one.`
      );
      return(false);
    }
  );
  reports := verify_and_strip_tasks(cfg, binary, tasks);
  (all_ok : bool) = true;
  (ri : usize) = usize(0);
  while(ri < reports.len(), {
    match(
      reports.get(ri),
      .Some(rp) => {
        _print_verify_fn_report(rp, false);
        if(!(rp.outcome == "ok"), {
          if((rp.outcome == "refuted") || (rp.mode == "verify"), {
            all_ok = false;
          }, {
            eprintln(`           (verify+ fallback: the runtime assert stays)`);
          });
        });
      },
      .None => ()
    );
    ri = (ri + usize(1));
  });
  all_ok
});
check_single_file :: (
  fn(
    input_path : String,
    std_path : String,
    io : Io,
    exn : Exception
  ) -> bool
)({
  // V3: arm this file as THE verification target (both path spellings —
  // Token.module_path is the path exactly as passed in, imported modules'
  // tokens carry the resolved absolute form). Registration (and the
  // assert-splice suppression) only fire for files whose own pragma — or
  // the absence of one — resolves to verify/verify+.
  targets := ArrayList(String).new();
  targets.push(input_path.clone());
  targets.push(mm_resolve_entry_abs(input_path.clone(), std_path.clone()));
  set_verify_target_paths(targets);
  outcome := mm_load_file(input_path, std_path, true, io, exn);
  if(!(outcome.ok), {
    // The loader's handlers only stash the rendered diagnostic (the P1
    // single-print rule, plans/reference/ERROR_DIAGNOSTICS_OVERHAUL.md D2) — check's
    // own edge prints it here, exactly once, anchored at the failing file.
    match(
      _take_load_error(),
      .Some(rendered) => emit_rendered_text(rendered),
      .None => eprintln(`check: error in: ${input_path} (no diagnostic recorded)`)
    );
    return(false);
  });
  _run_contract_verification(io, exn)
});
/// The argv entry following index `i` (the value of a `--flag value` pair), or
/// "" if `i` is the last argument. Used by the `compile` flag parser.
_arg_val :: (fn(argv : ArrayList(String), i : usize) -> String)(
  if((i + usize(1)) < argv.len(), argv(i + usize(1)), String.from(""))
);
/// Like `_arg_val`, but a MISSING trailing value is an error instead of `""`
/// (mirrors yargs `requiresArg` behavior — `yo compile -o` with nothing after
/// silently produced an empty output name and a `.c` sidecar named `.c`).
_arg_val_req :: (
  fn(argv : ArrayList(String), i : usize, flag : String, exn : Exception) -> String
)({
  if((i + usize(1)) < argv.len(), {
    return(argv(i + usize(1)));
  });
  exn.throw(dyn(`compile: option '${flag}' requires a value`));
  String.from("")
});
/// Run the `check` subcommand — evaluator-only.
///
/// Accepts either a single `.yo` file or a directory. For a directory
/// the bootstrap walks `*.yo` (excluding `.test.yo`) and runs each one
/// through the evaluator; cross-file evaluator state pollution is
/// possible but acceptable for the "find evaluator coverage gaps"
/// workflow.
///
/// Exits 0 if every file passes, non-zero if any file's evaluator
/// throws.
run_check :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  if(argv.len() < usize(3), {
    exn.throw(dyn(`check: missing input file. Usage: yo check <input.yo | dir>`));
  });
  // Positional + `--exclude <path>` (repeatable) in any order; unknown
  // options are errors — TS's yargs is .strict() (yo-cli.ts:1348).
  (target_path : String) = String.new();
  excludes := ArrayList(String).new();
  (watch : bool) = false;
  (watch_once : bool) = false;
  (poll_ms : u64) = u64(200);
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    a := argv(ai);
    cond(
      (a == "--exclude") => {
        next_i := (ai + usize(1));
        if(next_i < argv.len(), {
          excludes.push(argv(next_i));
          ai = (ai + usize(2));
        }, {
          ai = (ai + usize(1));
        });
      },
      (a == "--watch") => {
        watch = true;
        ai = (ai + usize(1));
      },
      (a == "--watch-once") => {
        watch_once = true;
        ai = (ai + usize(1));
      },
      (a == "--poll-ms") => {
        pv := _arg_val_req(argv, ai, String.from("--poll-ms"), exn);
        poll_ms = match(pv.parse_u64(), .Some(n) => n, .None => u64(200));
        ai = (ai + usize(2));
      },
      a.starts_with(String.from("-")) => {
        exn.throw(dyn(`check: unknown option '${a}'. Usage: yo check <input.yo | dir> [--exclude PATH] [--watch | --watch-once] [--poll-ms N]`));
      },
      true => {
        target_path = a.clone();
        ai = (ai + usize(1));
      }
    );
  });
  if(target_path.len() == usize(0), {
    exn.throw(dyn(`check: missing input file. Usage: yo check <input.yo | dir>`));
  });
  files := collect_check_files(target_path.clone(), excludes, io, exn);
  if(files.len() == usize(0), {
    exn.throw(dyn(`check: no .yo files found at ${target_path}`));
  });
  std_path := resolve_std_path();
  // Reset the per-module loader cache for this run. Keys are absolute
  // paths, so cache entries are valid for the whole run (a module
  // imported by several files is evaluated once).
  clear_module_cache();
  // Pre-load the prelude so the cached prelude env is a clean prelude-only
  // environment before any file is checked. (mm_load_file also self-bootstraps
  // the prelude, but doing it once here keeps the cached env free of the first
  // file's own bindings.)
  // Same rule as the compile path: a broken prelude makes every per-file
  // result below a restatement of one fault, so stop at the root cause
  // (issues/fixed/failed-prelude-load-prints-twice-and-continues.md).
  if(!mm_preload_prelude(std_path.clone(), true, io, exn), {
    unsafe(exit(int(1)));
  });
  (failed : usize) = usize(0);
  (fi : usize) = usize(0);
  total := files.len();
  while(fi < total, {
    match(
      files.get(fi),
      .None => (),
      .Some(file_path) => {
        if(!(check_single_file(file_path, std_path.clone(), io, exn)), {
          failed = (failed + usize(1));
        });
      }
    );
    fi = (fi + usize(1));
  });
  if(total > usize(1), {
    passed := (total - failed);
    emit_chatter(`check: ${passed.to_string()}/${total.to_string()} file(s) passed`);
  });
  // Watch modes survive a failing initial pass — that is their whole point.
  // (Phase C, plans/reference/INCREMENTAL_COMPILATION.md; src/check_watch.yo.)
  if(watch_once, {
    run_watch_once(files, std_path.clone(), io, exn);
  });
  if(watch, {
    run_check_watch(files, std_path.clone(), poll_ms, io, exn);
  });
  if(failed > usize(0), {
    exn.throw(dyn(`check: ${failed.to_string()} file(s) failed evaluator coverage`));
  });
});
/// Run the `verify` subcommand — the compile-time verifier driver
/// (V2+V3 of plans/backlog/FORMAL_VERIFICATION.md).
///
/// Resolve the pinned Z3 (YO_Z3_PATH → `~/.cache/yo/solvers/…`,
/// auto-install on miss), run the harness SELF-TEST obligations through
/// the full encode → spawn → parse → cache pipeline, then evaluate the
/// target file set with the mode override armed — the evaluator records
/// one VerifyTask per verifiable function — and discharge every task's
/// obligations (callee-side ensures, caller-side requires, assert sites,
/// AoRTE). Non-zero exit on any refuted/unproven/subset-error report.
run_verify_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  (target_path : String) = String.new();
  (solver_path : Option(String)) = Option(String).None;
  (mode_str : String) = String.new();
  (rlimit_opt : Option(usize)) = Option(usize).None;
  (format_json : bool) = false;
  (no_cache : bool) = false;
  (explain_fn : Option(String)) = Option(String).None;
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    a := argv(ai);
    (a_name : String) = a.clone();
    (a_val : Option(String)) = Option(String).None;
    if(a.starts_with("--"), {
      (eq_at : isize) = (isize(0) - isize(1));
      (sc_i : usize) = usize(0);
      while((sc_i < a.len()) && (eq_at < isize(0)), {
        if(a.byte_at(sc_i) == u8(61), {
          eq_at = isize(sc_i);
        });
        sc_i = (sc_i + usize(1));
      });
      if(eq_at > isize(0), {
        a_name = a.substring(usize(0), usize(eq_at));
        a_val = Option(String).Some(a.substring(usize(eq_at) + usize(1), a.len()));
      });
    });
    cond(
      ((a_name == "--verify-mode") || (a_name == "--solver-path")) => {
        v := _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        if(a_name == "--verify-mode", {
          mode_str = v;
        }, {
          solver_path = Option(String).Some(v);
        });
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--rlimit") => {
        v2 := _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        match(
          v2.parse_u64(),
          .Some(n) => {
            rlimit_opt = Option(usize).Some(usize(n));
          },
          .None => {
            exn.throw(dyn(`verify: --rlimit expects a non-negative integer, got '${v2}'`));
          }
        );
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--format") => {
        v3 := _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        if(v3 == "json", {
          format_json = true;
        }, {
          if(v3 == "text", {
            format_json = false;
          }, {
            exn.throw(dyn(`verify: --format expects 'text' or 'json', got '${v3}'`));
          });
        });
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--no-cache") => {
        no_cache = true;
        ai = (ai + usize(1));
      },
      (a_name == "--explain") => {
        explain_fn = Option(String).Some(_opt_value(argv, ai, a_name.clone(), a_val.clone(), exn));
        ai = (ai + _opt_step(a_val));
      },
      a.starts_with(String.from("-")) => {
        exn.throw(
          dyn(
            `verify: unknown option '${a}'. Usage: yo verify [path] [--verify-mode runtime|verify|verify+] [--solver-path PATH] [--rlimit N] [--format text|json] [--explain FN] [--no-cache]`
          )
        );
      },
      true => {
        if(target_path.len() > usize(0), {
          exn.throw(dyn(`verify: multiple paths given ('${target_path}' and '${a}') — verify one path per invocation`));
        });
        target_path = a.clone();
        ai = (ai + usize(1));
      }
    );
  });
  // V3: the mode. The flag wins over the per-file pragmas (which are the
  // source of truth inside a file); with neither, `yo verify` defaults to
  // `verify` — this IS the verification command, and the plan's AoRTE
  // promise is that zero-contract files still get bounds/div-by-zero
  // obligations.
  if(mode_str.len() == usize(0), {
    mode_str = String.from("verify");
  });
  match(
    verify_mode_of_string(mode_str.clone()),
    .Some(_) => (),
    .None => {
      exn.throw(
        dyn(`verify: --verify-mode expects 'runtime', 'verify', or 'verify+', got '${mode_str}'`)
      );
    }
  );
  // Validate the target path up front (fail fast on a typo).
  if(target_path.len() == usize(0), {
    exn.throw(dyn(`verify: missing input file. Usage: yo verify <input.yo | dir> [options]`));
  });
  files := collect_check_files(target_path.clone(), ArrayList(String).new(), io, exn);
  if(files.len() == usize(0), {
    exn.throw(dyn(`verify: no .yo files found at ${target_path}`));
  });
  cfg := default_verify_run_config();
  cfg.solver_path = solver_path;
  cfg.no_cache = no_cache;
  match(
    rlimit_opt,
    .Some(n) => {
      cfg.encode_opts.rlimit = n;
    },
    .None => ()
  );
  // Sync resolution first (discovery / explicit path); only a discovery MISS
  // runs the async one-time download install — the rest of the harness is
  // synchronous by design (see src/verifier/z3.yo's header note).
  binary := match(
    resolve_solver_sync(cfg),
    .Resolved(path) => path,
    .InvalidPath(path) => {
      exn.throw(dyn(`verify: solver path '${path}' does not exist`));
      String.new()
    },
    .Installable => io.await(ensure_z3(io, exn), IoExn(io : io, exn : exn))
  );
  results := verifier_harness_self_test(cfg, binary.clone());
  // Harness health: obligation 1 must PROVE, obligation 2 must REFUTE with
  // a concrete counter-example (guards against a solver that answers
  // garbage, or an encoding that proves by being wrong).
  (harness_ok : bool) = true;
  match(
    results.get(usize(0)),
    .Some(r1) => {
      match(
        r1.verdict,
        .Proved(_) => (),
        _ => {
          harness_ok = false;
        }
      );
    },
    .None => {
      harness_ok = false;
    }
  );
  match(
    results.get(usize(1)),
    .Some(r2) => {
      match(
        r2.verdict,
        .Refuted(ce) => {
          if(ce.len() == usize(0), {
            harness_ok = false;
          });
        },
        _ => {
          harness_ok = false;
        }
      );
    },
    .None => {
      harness_ok = false;
    }
  );
  // V3: evaluate the target set with the mode override and target paths
  // armed, so the evaluator records one VerifyTask per verifiable
  // function (evaluator/builtins/contracts.yo). Targets carry BOTH the
  // collected spelling (Token.module_path is the path EXACTLY as passed
  // to mm_load_file) and the normalized absolute form (what an imported
  // module's tokens carry).
  std_path := resolve_std_path();
  abs_targets := ArrayList(String).new();
  (fi : usize) = usize(0);
  while(fi < files.len(), {
    match(
      files.get(fi),
      .Some(fp) => {
        abs_targets.push(fp.clone());
        abs_targets.push(mm_resolve_entry_abs(fp.clone(), std_path.clone()));
      },
      .None => ()
    );
    fi = (fi + usize(1));
  });
  set_verify_mode_override(Option(String).Some(mode_str.clone()));
  set_verify_target_paths(abs_targets.clone());
  clear_module_cache();
  if(!mm_preload_prelude(std_path.clone(), true, io, exn), {
    unsafe(exit(int(1)));
  });
  (eval_failed : usize) = usize(0);
  (fi2 : usize) = usize(0);
  while(fi2 < files.len(), {
    match(
      files.get(fi2),
      .Some(fp) => {
        outcome := mm_load_file(fp.clone(), std_path.clone(), true, io, exn);
        if(!(outcome.ok), {
          eval_failed = (eval_failed + usize(1));
          match(
            _take_load_error(),
            .Some(rendered) => emit_rendered_text(rendered),
            .None => eprintln(`verify: error in: ${fp} (no diagnostic recorded)`)
          );
        });
      },
      .None => ()
    );
    fi2 = (fi2 + usize(1));
  });
  if(eval_failed > usize(0), {
    exn.throw(dyn(`verify: ${eval_failed.to_string()} file(s) failed evaluation`));
  });
  all_reports := verify_registered_functions(cfg, binary.clone());
  // `--explain FN` narrows the report to functions whose id matches
  // (substring, so a bare name or a `file:line` both work) and forces the
  // detailed rendering.
  reports := ArrayList(VerifyFnReport).new();
  match(
    explain_fn,
    .Some(pat) => {
      (xi : usize) = usize(0);
      while(xi < all_reports.len(), {
        match(
          all_reports.get(xi),
          .Some(rp) => if(rp.fn_id.contains(pat.clone()), {
            reports.push(rp);
          }),
          .None => ()
        );
        xi = (xi + usize(1));
      });
      if(reports.len() == usize(0), {
        exn.throw(dyn(`verify: --explain '${pat}' matched no verified function (of ${all_reports.len().to_string()})`));
      });
    },
    .None => {
      reports = all_reports;
    }
  );
  // Aggregate the exit status: every report must be `ok`.
  (bad : usize) = usize(0);
  (refuted_n : usize) = usize(0);
  (ri3 : usize) = usize(0);
  while(ri3 < reports.len(), {
    match(
      reports.get(ri3),
      .Some(rp) => {
        if(!(rp.outcome == "ok"), {
          bad = (bad + usize(1));
          if(rp.outcome == "refuted", {
            refuted_n = (refuted_n + usize(1));
          });
        });
      },
      .None => ()
    );
    ri3 = (ri3 + usize(1));
  });
  if(format_json, {
    fn_entries := ArrayList(JsonValue).new();
    (rj : usize) = usize(0);
    while(rj < reports.len(), {
      match(
        reports.get(rj),
        .Some(rp) => {
          fn_entries.push(_verify_fn_report_json(rp));
        },
        .None => ()
      );
      rj = (rj + usize(1));
    });
    ks2 := ArrayList(String).new();
    ks2.push(String.from("solver"));
    ks2.push(String.from("z3_pin"));
    ks2.push(String.from("mode"));
    ks2.push(String.from("harness_ok"));
    ks2.push(String.from("self_test"));
    ks2.push(String.from("functions"));
    vs2 := ArrayList(JsonValue).new();
    vs2.push(JsonValue.Str(binary.clone()));
    vs2.push(JsonValue.Str(String.from(Z3_VERSION)));
    vs2.push(JsonValue.Str(mode_str.clone()));
    vs2.push(JsonValue.Bool(harness_ok));
    vs2.push(JsonValue.Array(_verify_self_test_json(results)));
    vs2.push(JsonValue.Array(fn_entries));
    println(json.stringify(JsonValue.Object(keys : ks2, values : vs2)));
  }, {
    println(`verify: solver: ${binary} (z3 ${Z3_VERSION})`);
    println(
      `verify: target: ${target_path} (${files.len().to_string()} .yo file(s), mode ${mode_str})`
    );
    (rk : usize) = usize(0);
    while(rk < reports.len(), {
      match(
        reports.get(rk),
        .Some(rp) => {
          _print_verify_fn_report(rp, explain_fn.is_some());
        },
        .None => ()
      );
      rk = (rk + usize(1));
    });
    if(reports.len() == usize(0), {
      println(
        tr(
          String.from("verify: no functions to verify (no verify/verify+ functions in the target set)"),
          String.from("verify：没有可验证的函数（目标集合中没有 verify/verify+ 函数）")
        )
      );
    });
    println(
      cond(
        harness_ok => tr(String.from("verify: harness OK"), String.from("verify：自检通过")),
        true => tr(String.from("verify: harness FAILED"), String.from("verify：自检失败"))
      )
    );
  });
  if(!(harness_ok), {
    exn.throw(dyn(String.from("verify: solver harness self-test failed")));
  });
  if(bad > usize(0), {
    exn.throw(
      dyn(
        `verify: ${bad.to_string()} function(s) not verified (${refuted_n.to_string()} refuted) — see the report above`
      )
    );
  });
});
/// One function report as JSON (the verify subcommand's V3 shape).
_verify_fn_report_json :: (fn(rp : VerifyFnReport) -> JsonValue)({
  obl_entries := ArrayList(JsonValue).new();
  (i : usize) = usize(0);
  while(i < rp.obligations.len(), {
    match(
      rp.obligations.get(i),
      .Some(obl) => {
        model := match(
          obl.verdict,
          .Refuted(ce) => _verify_json_strs(ce),
          _ => JsonValue.Array(ArrayList(JsonValue).new())
        );
        verdict_str := match(
          obl.verdict,
          .Proved(_) => String.from("proved"),
          .Refuted(_) => String.from("refuted"),
          .Unproven(_) => String.from("unproven"),
          .SolverError(_) => String.from("solver-error")
        );
        ks := ArrayList(String).new();
        ks.push(String.from("name"));
        ks.push(String.from("verdict"));
        ks.push(String.from("cached"));
        ks.push(String.from("model"));
        vs := ArrayList(JsonValue).new();
        vs.push(JsonValue.Str(obl.name.clone()));
        vs.push(JsonValue.Str(verdict_str));
        vs.push(JsonValue.Bool(obl.cached));
        vs.push(model);
        obl_entries.push(JsonValue.Object(keys : ks, values : vs));
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  ks2 := ArrayList(String).new();
  ks2.push(String.from("fn_id"));
  ks2.push(String.from("mode"));
  ks2.push(String.from("outcome"));
  ks2.push(String.from("obligations"));
  ks2.push(String.from("subset_construct"));
  ks2.push(String.from("subset_source"));
  vs2 := ArrayList(JsonValue).new();
  vs2.push(JsonValue.Str(rp.fn_id.clone()));
  vs2.push(JsonValue.Str(rp.mode.clone()));
  vs2.push(JsonValue.Str(rp.outcome.clone()));
  vs2.push(JsonValue.Array(obl_entries));
  vs2.push(JsonValue.Str(rp.subset_construct.clone()));
  vs2.push(JsonValue.Str(rp.subset_source.clone()));
  JsonValue.Object(keys : ks2, values : vs2)
});
/// The self-test results as JSON (the V2 shape, kept verbatim).
_verify_self_test_json :: (fn(results : ArrayList(VerifyResult)) -> ArrayList(JsonValue))({
  entries := ArrayList(JsonValue).new();
  (ri : usize) = usize(0);
  while(ri < results.len(), {
    match(
      results.get(ri),
      .Some(r) => {
        verdict_json := match(
          r.verdict,
          .Proved(_) => JsonValue.Str(String.from("proved")),
          .Refuted(ce) => _verify_json_strs(ce),
          .Unproven(reason) => JsonValue.Str(`unproven: ${reason}`),
          .SolverError(msg) => JsonValue.Str(`solver-error: ${msg}`)
        );
        ks := ArrayList(String).new();
        ks.push(String.from("query"));
        ks.push(String.from("verdict"));
        ks.push(String.from("cached"));
        vs := ArrayList(JsonValue).new();
        vs.push(JsonValue.Str(r.query_name.clone()));
        vs.push(verdict_json);
        vs.push(JsonValue.Bool(r.cached));
        entries.push(JsonValue.Object(keys : ks, values : vs));
      },
      .None => ()
    );
    ri = (ri + usize(1));
  });
  entries
});
/// Text rendering of one function report. `detailed` (from `--explain`)
/// prints every obligation; the default prints per-function lines plus the
/// failing obligations' counter-examples.
_print_verify_fn_report :: (fn(rp : VerifyFnReport, detailed : bool) -> unit)(
  cond(
    (rp.outcome == "subset-error") => {
      println(
        `  subset   ${rp.fn_id} [${rp.mode}] — cannot verify: ${rp.subset_construct}`
      );
      println(`           ${rp.subset_source}`);
      ()
    },
    (rp.outcome == "ok") => {
      println(
        `  ok       ${rp.fn_id} [${rp.mode}] — ${rp.obligations.len().to_string()} obligation(s) proved`
      );
      ()
    },
    true => {
      println(`  ${rp.outcome}  ${rp.fn_id} [${rp.mode}]`);
      (i : usize) = usize(0);
      while(i < rp.obligations.len(), {
        match(
          rp.obligations.get(i),
          .Some(obl) => {
            bad := match(
              obl.verdict,
              .Proved(_) => false,
              _ => true
            );
            if(bad || detailed, {
              detail := match(
                obl.verdict,
                .Proved(_) => String.from("PROVED"),
                .Refuted(ce) => `REFUTED  counter-example: ${_verify_join_strs(ce, String.from(", "))}`,
                .Unproven(reason) => `UNPROVEN  ${reason}`,
                .SolverError(msg) => `SOLVER-ERROR  ${msg}`
              );
              cached_mark := if(obl.cached, String.from(" (cached)"), String.new());
              println(`    ${obl.name}: ${detail}${cached_mark}`);
            });
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      ()
    }
  )
);
/// JSON array of strings (the verify subcommand's counter-example shape).
_verify_json_strs :: (fn(ss : ArrayList(String)) -> JsonValue)({
  items := ArrayList(JsonValue).new();
  (i : usize) = usize(0);
  while(i < ss.len(), {
    match(
      ss.get(i),
      .Some(s) => {
        items.push(JsonValue.Str(s.clone()));
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  JsonValue.Array(items)
});
/// Comma-join (the verify subcommand's text rendering).
_verify_join_strs :: (fn(ss : ArrayList(String), sep : String) -> String)({
  sb := StringBuilder.new();
  (i : usize) = usize(0);
  while(i < ss.len(), {
    match(
      ss.get(i),
      .Some(s) => {
        if(i > usize(0), {
          sb.write_string(sep);
        });
        sb.write_string(s);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  sb.to_string()
});
/// How far the arg cursor advances for a value option: 1 when the value was
/// attached (`--flag=value`), 2 for the space form.
_opt_step :: (fn(attached : Option(String)) -> usize)(
  match(attached, .Some(_) => usize(1), .None => usize(2))
);
/// The value of a value option: the attached `=value` when present, else the
/// (required) next argv entry.
_opt_value :: (
  fn(argv : ArrayList(String), i : usize, flag : String, attached : Option(String), exn : Exception) -> String
)(
  match(attached, .Some(v) => v, .None => _arg_val_req(argv, i, flag, exn))
);
/// `--heap-size <n>[K|M|G]` (suffix case-insensitive) -> bytes, validated:
/// 64 KiB minimum (the TLSF control block alone needs ~8 KiB), 4 GiB maximum
/// (FL_INDEX_MAX = 32 caps the size classes at 2^32), rounded DOWN to a
/// 16-byte granule. `.Err(message)` on a malformed or out-of-range value.
/// plans/reference/FIXED_REGION_ALLOCATOR.md §2.2.
_parse_heap_size :: (fn(raw : String) -> Result(usize, String))({
  if(raw.len() == usize(0), {
    return(Result(usize, String).Err(String.from("empty value")));
  });
  (num_end : usize) = raw.len();
  (mult : u64) = u64(1);
  last := raw.byte_at((raw.len() - usize(1)));
  cond(
    ((last == u8(75)) || (last == u8(107))) => {
      num_end = (raw.len() - usize(1));
      mult = u64(1024);
    },
    ((last == u8(77)) || (last == u8(109))) => {
      num_end = (raw.len() - usize(1));
      mult = u64(1048576);
    },
    ((last == u8(71)) || (last == u8(103))) => {
      num_end = (raw.len() - usize(1));
      mult = u64(1073741824);
    },
    true => ()
  );
  if(num_end == usize(0), {
    return(Result(usize, String).Err(String.from("no digits before the unit")));
  });
  num := raw.substring(usize(0), num_end);
  match(
    num.parse_u64(),
    .Some(n) => {
      // Check BEFORE multiplying so a huge digit count cannot wrap u64.
      (max_bytes : u64) = u64(4294967296);
      if((n == u64(0)) || (n > (max_bytes / mult)), {
        return(Result(usize, String).Err(String.from("out of range (64 KiB .. 4 GiB)")));
      });
      (bytes : u64) = ((n * mult) & (~u64(15)));
      if(bytes < u64(65536), {
        return(Result(usize, String).Err(String.from("out of range (64 KiB .. 4 GiB)")));
      });
      Result(usize, String).Ok(usize(bytes))
    },
    .None => Result(usize, String).Err(String.from("not a number"))
  )
});
/// Human-readable heap size for the allocator notice: the largest of
/// GiB/MiB/KiB that divides it exactly, else raw bytes (16 MiB, 64 KiB, ...).
_format_heap_size :: (fn(bytes : usize) -> String)(
  cond(
    ((bytes % usize(1073741824)) == usize(0)) => `${(bytes / usize(1073741824)).to_string()} GiB`,
    ((bytes % usize(1048576)) == usize(0)) => `${(bytes / usize(1048576)).to_string()} MiB`,
    ((bytes % usize(1024)) == usize(0)) => `${(bytes / usize(1024)).to_string()} KiB`,
    true => `${bytes.to_string()} bytes`
  )
);
/// `compiler --version` probe (mirrors `checkCompilerAvailable`,
/// src/compiler-utils.ts:66-73 — stdio ignored, availability = exit 0).
_check_compiler_available :: (fn(compiler : String, io : Io) -> bool)({
  probe := Command.new(compiler.clone());
  probe.arg(String.from("--version"));
  // A spawn failure (missing binary) throws through IoExn — treat it as
  // "not available" rather than propagating.
  inner_exn := Exception(throw : ((_e) -> unwind(false)));
  out := io.await(probe.output(io), IoExn(io : io, exn : inner_exn));
  out.status.raw == i32(0)
});
/// First available C compiler, in TS's order (`findAvailableCompiler`,
/// src/compiler-utils.ts:79-88).
_find_available_compiler :: (fn(io : Io) -> Option(String))({
  candidates := ArrayList(String).new();
  candidates.push(String.from("clang"));
  candidates.push(String.from("cc"));
  candidates.push(String.from("gcc"));
  candidates.push(String.from("zig"));
  (fci : usize) = usize(0);
  while(fci < candidates.len(), {
    c := match(candidates.get(fci), .Some(x) => x, .None => String.from(""));
    if(_check_compiler_available(c.clone(), io), {
      return(Option(String).Some(c));
    });
    fci = (fci + usize(1));
  });
  Option(String).None
});
/// The parent directory of a Windows-or-POSIX path (both separators).
_win_dirname :: (fn(p : String) -> String)({
  (last_sep : isize) = (isize(0) - isize(1));
  (di : usize) = usize(0);
  while(di < p.len(), {
    ch := p.byte_at(di);
    if((ch == u8(47)) || (ch == u8(92)), {
      last_sep = isize(di);
    });
    di = (di + usize(1));
  });
  if(last_sep <= isize(0), {
    return(p.clone());
  });
  p.substring(usize(0), usize(last_sep))
});
/// Windows: the directory holding clang's ASan runtime DLL, to prepend to
/// PATH before running ASan-instrumented test binaries
/// (`findClangAsanDllPath`, src/compiler-utils.ts:231-274 — the DLL lives at
/// `<llvm-root>/lib/clang/<version>/lib/windows`). `.None` on any failure or
/// off Windows.
_find_clang_asan_dll_path :: (fn(compiler : String, io : Io) -> Option(String))({
  if(!(is_target_windows(host_target())), {
    return(Option(String).None);
  });
  inner_exn := Exception(throw : ((_e) -> unwind(Option(String).None)));
  wcmd := Command.new(String.from("where.exe"));
  wcmd.arg(compiler.clone());
  wout := io.await(wcmd.output(io), IoExn(io : io, exn : inner_exn));
  if(wout.status.raw != i32(0), {
    return(Option(String).None);
  });
  wtxt := String.from_bytes(wout.stdout);
  first_line := match(wtxt.split("\n").get(usize(0)), .Some(l) => l.trim(), .None => String.from(""));
  if(first_line.len() == usize(0), {
    return(Option(String).None);
  });
  compiler_dir := _win_dirname(first_line.clone());
  llvm_root := _win_dirname(compiler_dir.clone());
  clang_lib := `${llvm_root}\\lib\\clang`;
  clang_lib_found := io.await(exists(Path.new(clang_lib.clone()), io), io);
  if(!(clang_lib_found), {
    return(Option(String).None);
  });
  ver_entries := io.await(read_dir(Path.new(clang_lib.clone()), io), IoExn(io : io, exn : inner_exn));
  (vei : usize) = usize(0);
  while(vei < ver_entries.len(), {
    ve := match(ver_entries.get(vei), .Some(e) => Option(String).Some(e.name.clone()), .None => Option(String).None);
    vei = (vei + usize(1));
    match(
      ve,
      .Some(vname) => {
        win_lib := `${clang_lib}\\${vname}\\lib\\windows`;
        win_found := io.await(exists(Path.new(win_lib.clone()), io), io);
        if(win_found, {
          return(Option(String).Some(win_lib));
        });
      },
      .None => ()
    );
  });
  Option(String).None
});
/// True when the path's basename carries an extension (TS `path.extname(p) !== ""`).
_path_has_extension :: (fn(p : String) -> bool)({
  (last_slash : isize) = (isize(0) - isize(1));
  (last_dot : isize) = (isize(0) - isize(1));
  (pi : usize) = usize(0);
  while(pi < p.len(), {
    ch := p.byte_at(pi);
    if(ch == u8(47), {
      last_slash = isize(pi);
    });
    if(ch == u8(46), {
      last_dot = isize(pi);
    });
    pi = (pi + usize(1));
  });
  // A dot counts only after the last slash and not as the basename's first
  // character (path.extname(".bashrc") === "" in Node).
  last_dot > (last_slash + isize(1))
});
/// One removal attempt under a swallowing handler (the `unwind` needs its own
/// fn boundary, same pattern as `_probe_liburing`). Success is signalled by
/// the push; a throw of any kind leaves `ok` empty.
_try_remove_once :: (fn(path : String, io : Io, ok : ArrayList(bool)) -> unit)({
  try_exn := Exception(
    throw : (
      (_e) -> {
        unwind(());
      }
    )
  );
  io.await(remove_file(Path.new(path.clone()), io), IoExn(io : io, exn : try_exn));
  ok.push(true);
});
/// Remove a test-batch artifact, tolerating Windows's just-exited-executable
/// lock. Deleting a batch `.exe` ~40 ms after its last test child exits can
/// return "permission denied" while the process object (or a Defender scan)
/// still holds the file — first hit on the windows-arm64 suite run
/// 32402145272, where the raw `remove_file` throw aborted the whole run two
/// files in. Retries with a growing pause (~3 s total budget); a FINAL
/// failure downgrades to a warning, because a leaked temp artifact must
/// never abort a test run. (The TS runner's cleanup was equally non-fatal
/// only by never having run the suite on Windows.)
_remove_batch_artifact :: (fn(path : String, io : Io) -> unit)({
  (attempt : usize) = usize(0);
  (removed : bool) = false;
  (pause_ms : usize) = usize(25);
  while(!(removed) && (attempt < usize(8)), {
    ok := ArrayList(bool).new();
    _try_remove_once(path.clone(), io, ok);
    removed = (ok.len() > usize(0));
    attempt = (attempt + usize(1));
    // No pause after the FINAL failed attempt — it would only delay the warning.
    if(!(removed) && (attempt < usize(8)), {
      sleep_blocking(Duration.from_millis(i64(pause_ms)));
      pause_ms = (pause_ms * usize(2));
    });
  });
  if(!(removed), {
    println(`  warning: could not remove batch artifact ${path} (still locked?) — leaving it behind`);
  });
});
/// Is liburing available for linking? Mirrors `isLiburingAvailable` in
/// `src/compiler-utils.ts`: probe `pkg-config --exists liburing`.
///
/// LOAD-BEARING ON LINUX. `codegen/async/runtime_io_linux.yo` emits io_uring
/// calls guarded by `#if __has_include(<liburing.h>)`, so when the header IS
/// present the emitted C references `io_uring_*` and the LINK fails without
/// `-luring`. That is exactly how tests/io/bufio, tests/fs/{file,temp,walker},
/// async_await and imm_string failed in CI with "undefined reference to
/// io_uring_peek_batch_cqe" etc. while passing on macOS, which uses kqueue and
/// never references those symbols. TS adds the flag in TWO places
/// (`codegen/index.ts` and `test-runner.ts`); yo-self funnels `compile` and
/// `test` through one link path, so it is added once here.
///
/// The probe runs under a SWALLOWING handler because `pkg-config` may not exist
/// at all, in which case spawning throws (TS wraps the same probe in try/catch).
/// A swallowed probe leaves `out` empty, read as "not available", so a box
/// without liburing still links — matching TS, which warns and omits the flag.
/// OpenSSL discovery for `std/crypto/tls` (plans/archive/D6_TLS_PLAN.md): run
/// `pkg-config --cflags --libs openssl`, retrying under the Homebrew keg
/// pkg-config paths on failure (brew does not put keg `.pc` dirs on the
/// default path). Pushes `-I` dirs into `includes`, `-L` dirs into
/// `libdirs`, and `true` into `ok` on success. Same swallowing-handler
/// stance as `_probe_liburing`: no pkg-config / no openssl simply leaves
/// `ok` empty and only tls users fail (at their own link) — everything
/// else is unaffected. Result cached process-wide.
(g_openssl_probe : Option(bool)) = Option(bool).None;
(g_openssl_includes : ArrayList(String)) = ArrayList(String).new();
(g_openssl_libdirs : ArrayList(String)) = ArrayList(String).new();
_probe_openssl :: (fn(io : Io) -> bool)({
  match(
    g_openssl_probe,
    .Some(p) => {
      return(p);
    },
    .None => ()
  );
  probe_exn := Exception(
    throw : (
      (_e) -> {
        unwind(());
      }
    )
  );
  (flags : Option(String)) = Option(String).None;
  probe := Command.new(String.from("pkg-config"));
  probe.arg(String.from("--cflags"));
  probe.arg(String.from("--libs"));
  probe.arg(String.from("openssl"));
  out := io.await(probe.output(io), IoExn(io : io, exn : probe_exn));
  cond(
    (out.status.raw == i32(0)) => {
      flags = Option(String).Some(String.from_bytes(out.stdout));
    },
    true => ()
  );
  // Homebrew keg fallbacks (macOS): apple/arm and intel prefixes.
  (ki : usize) = usize(0);
  kegs := ArrayList(String).new();
  kegs.push(String.from("/opt/homebrew/opt/openssl/lib/pkgconfig"));
  kegs.push(String.from("/usr/local/opt/openssl/lib/pkgconfig"));
  while((ki < kegs.len()) && flags.is_none(), {
    keg := kegs(ki);
    kprobe := Command.new(String.from("pkg-config"));
    kprobe.env(String.from("PKG_CONFIG_PATH"), keg);
    kprobe.arg(String.from("--cflags"));
    kprobe.arg(String.from("--libs"));
    kprobe.arg(String.from("openssl"));
    kout := io.await(kprobe.output(io), IoExn(io : io, exn : probe_exn));
    cond(
      (kout.status.raw == i32(0)) => {
        flags = Option(String).Some(String.from_bytes(kout.stdout));
      },
      true => ()
    );
    ki = (ki + usize(1));
  });
  match(
    flags,
    .Some(fl) => {
      toks := fl.trim().split(String.from(" "));
      (ti : usize) = usize(0);
      while(ti < toks.len(), {
        t := toks(ti);
        cond(
          (t.starts_with("-I") && (t.len() > usize(2))) => {
            g_openssl_includes.push(t.substring(usize(2), t.len()));
          },
          (t.starts_with("-L") && (t.len() > usize(2))) => {
            g_openssl_libdirs.push(t.substring(usize(2), t.len()));
          },
          true => ()
        );
        ti = (ti + usize(1));
      });
      g_openssl_probe = Option(bool).Some(true);
      true
    },
    .None => {
      g_openssl_probe = Option(bool).Some(false);
      false
    }
  )
});
_probe_liburing :: (fn(io : Io, out : ArrayList(bool)) -> unit)({
  probe_exn := Exception(
    throw : (
      (_e) -> {
        unwind(());
      }
    )
  );
  probe := Command.new(String.from("pkg-config"));
  probe.arg(String.from("--exists"));
  probe.arg(String.from("liburing"));
  st := io.await(probe.status(io), IoExn(io : io, exn : probe_exn));
  out.push(st.raw == i32(0));
});
/// AddressSanitizer functionality probe — faithful port of TS
/// `asanRuntimeIsUsable` (src/compiler-utils.ts): compile a trivial C program
/// with `-fsanitize=address` via the SYSTEM `cc` (matching TS, which probes
/// `cc` regardless of --cc) and run it under a 3-second shell watchdog. A
/// healthy ASan binary exits 0 immediately; a clang/ASan-runtime mismatch
/// (e.g. Nix clang 21 whose libclang_rt.asan deadlocks in its own dyld
/// initializer BEFORE main on this macOS) never returns — the watchdog
/// SIGKILLs it and the probe reports unusable, so the compile proceeds
/// WITHOUT the sanitizer plus the same warning TS prints, instead of
/// emitting a binary that hangs at startup (issues/fixed/yo-self-asan-init-hang.md).
/// Result is cached process-wide (TS caches in _asanUsable).
(g_asan_usable : Option(bool)) = Option(bool).None;
_asan_runtime_is_usable :: (fn(base : String, io : Io) -> bool)({
  match(
    g_asan_usable,
    .Some(u) => {
      return(u);
    },
    .None => ()
  );
  // Any probe-step IO failure means "unusable" (TS's catch -> false).
  probe_exn := Exception(
    throw : (
      (_e) -> {
        unwind(false);
      }
    )
  );
  probe_src := `${base}.asan_probe.c`;
  probe_bin := `${base}.asan_probe`;
  io.await(write_string(Path.new(probe_src.clone()), String.from("int main(void) { return 0; }\n"), io), IoExn(io : io, exn : probe_exn));
  cc_cmd := Command.new(String.from("cc"));
  cc_cmd.arg(String.from("-x"));
  cc_cmd.arg(String.from("c"));
  cc_cmd.arg(String.from("-std=c11"));
  cc_cmd.arg(String.from("-fsanitize=address"));
  cc_cmd.arg(String.from("-o"));
  cc_cmd.arg(probe_bin.clone());
  cc_cmd.arg(probe_src.clone());
  cc_st := io.await(cc_cmd.status(io), IoExn(io : io, exn : probe_exn));
  (usable : bool) = false;
  if(cc_st.success(), {
    // Shell watchdog: `wait $p` yields the probe's own exit status; the
    // backgrounded killer turns an ASan init deadlock into SIGKILL (137,
    // not success). A healthy probe exits 0 long before the 3s fire.
    run_cmd := Command.new(String.from("sh"));
    run_cmd.arg(String.from("-c"));
    run_cmd.arg(String.from("ASAN_OPTIONS=detect_leaks=0 \"$0\" & p=$!; { sleep 3; kill -9 $p; } 2>/dev/null & wait $p"));
    run_cmd.arg(probe_bin.clone());
    run_st := io.await(run_cmd.status(io), IoExn(io : io, exn : probe_exn));
    usable = run_st.success();
  });
  // Cleanup (TS's finally-unlinks). The bin is only present when cc
  // succeeded; a removal failure routes through probe_exn -> false, which
  // is the correct verdict for any probe-environment breakage anyway.
  io.await(remove_file(Path.new(probe_src.clone()), io), IoExn(io : io, exn : probe_exn));
  if(cc_st.success(), {
    io.await(remove_file(Path.new(probe_bin.clone()), io), IoExn(io : io, exn : probe_exn));
  });
  g_asan_usable = Option(bool).Some(usable);
  usable
});
/// Zero-pad a chunk index to 3 digits (`7` → `"007"`) for the
/// `<base>_chunkNNN.c` file names of `--emit-chunks`.
_pad3 :: (fn(i : usize) -> String)({
  s := i.to_string();
  cond(
    (s.len() >= usize(3)) => s,
    (s.len() == usize(2)) => `0${s}`,
    true => `00${s}`
  )
});
/// Records the C-compiler argv as it is assembled, so the chunked path can
/// replay EXACTLY the same flags for per-chunk `cc -c` jobs. The method name
/// and signature deliberately match `Command.arg`, so `run_compile`'s ~99
/// flag-assembly call sites are untouched — and therefore cannot drift or
/// reorder the single-file argv, which the bootstrap gates depend on.
CcArgv :: ref(struct(recorded : ArrayList(String)));
impl(
  CcArgv,
  new : (fn() -> Self)(
    Self(recorded : ArrayList(String).new())
  ),
  arg : (fn(inout(self) : Self, a : String) -> unit)({
    self.recorded.push(a);
    ()
  })
);
/// Build a runnable `Command` from a recorded argv.
_cc_command :: (fn(program : String, argv : ArrayList(String)) -> Command)({
  c := Command.new(program.clone());
  (i : usize) = usize(0);
  while(i < argv.len(), {
    match(
      argv.get(i),
      .Some(a) => {
        _arg_c := c.arg(a.clone());
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  c
});
/// Single-quote `s` for POSIX `sh`, escaping embedded single quotes as
/// `'\''`. Flag values can carry user text (`-D`, `-I`, `--cflags`), so the
/// generated compile script must never let them reach the shell unquoted.
_sh_quote :: (fn(s : String) -> String)({
  out := String.from("'");
  b := s.as_bytes();
  (i : usize) = usize(0);
  while(i < b.len(), {
    ch := match(b.get(i), .Some(x) => x, .None => u8(0));
    if(ch == u8(39), {
      out.push_str("'\\''");
    }, {
      out.push_byte(ch);
    });
    i = (i + usize(1));
  });
  out.push_str("'");
  out
});
/// Read a file's bytes, or `.None` when unreadable.
_chunk_read :: (fn(path : String, io : Io) -> Option(ArrayList(u8)))({
  rd_exn := Exception(throw : ((_e) -> unwind(Option(ArrayList(u8)).None)));
  bytes := io.await(read(Path.new(path.clone()), io), IoExn(io : io, exn : rd_exn));
  Option(ArrayList(u8)).Some(bytes)
});
/// Recorded stamp beside an object file, `.None` when absent.
_chunk_read_stamp :: (fn(path : String, io : Io) -> Option(String))(
  match(_chunk_read(path, io), .Some(b) => Option(String).Some(String.from_bytes(b)), .None => Option(String).None)
);
/// Record a stamp; failures are silent (the cache is only an optimization).
_chunk_write_stamp :: (fn(path : String, stamp : String, io : Io) -> unit)({
  wr_exn := Exception(throw : ((_e) -> unwind(())));
  io.await(write_string(Path.new(path.clone()), stamp.clone(), io), IoExn(io : io, exn : wr_exn));
});
/// Compile the chunk `.c` files to `.o` in PARALLEL and return the object
/// paths, honouring a content-addressed cache.
///
/// Parallelism is done by generating a POSIX `sh` script rather than by
/// spawning children from Yo: `io.spawn` in a loop currently hangs
/// (issues/fixed/io-spawn-in-loop-or-recursion-hangs.md), and one `sh` child running
/// `cc ... & ... ; wait` needs no async machinery at all. Failures are
/// detected per job (`wait $pid`), since bare `wait` always reports success.
/// On a WINDOWS host there is no `sh`, so the compiles run sequentially — the
/// `.o` cache still applies.
///
/// Cache key per chunk: sha256(text hash of `shared.h ++ chunk.c` computed at
/// emission time, the compile flags, and the compiler version) — so a flag
/// change or a type renumbering invalidates every chunk, which is the
/// intended behaviour. `YO_BUILD_NO_CACHE=1` disables it.
_compile_chunks_parallel :: (
  fn(
    cc : String,
    flags : ArrayList(String),
    chunk_c_files : ArrayList(String),
    chunk_text_hashes : ArrayList(String),
    out_base : String,
    jobs : usize,
    force_recompile : bool,
    hits_out : ArrayList(usize),
    io : Io,
    exn : Exception
  ) -> ArrayList(String)
)({
  objs := ArrayList(String).new();
  no_cache := (force_recompile || match(proc_env.get(`YO_BUILD_NO_CACHE`), .Some(v) => (v == "1"), .None => false));
  flags_key := String.from(" ").join(flags);
  // Per-chunk decision: reuse the cached `.o`, or add a compile line.
  lines := ArrayList(String).new();
  stamps := ArrayList(String).new();
  stamp_paths := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < chunk_c_files.len(), {
    cf := match(chunk_c_files.get(i), .Some(x) => x, .None => String.new());
    obj := `${cf.substring(usize(0), cf.len() - usize(2))}.o`;
    objs.push(obj.clone());
    text_hash := match(chunk_text_hashes.get(i), .Some(h) => h, .None => String.new());
    stamp_src := ArrayList(u8).new();
    sb := `${text_hash}\n${flags_key}\n${CURRENT_YO_VERSION}`.as_bytes();
    (si : usize) = usize(0);
    while(si < sb.len(), {
      stamp_src.push(match(sb.get(si), .Some(x) => x, .None => u8(0)));
      si = (si + usize(1));
    });
    stamp := sha256_hex(stamp_src);
    stamp_path := `${obj}.inputs-sha256`;
    obj_exists := io.await(exists(Path.new(obj.clone()), io), io);
    cached := (!(no_cache) && (obj_exists && match(_chunk_read_stamp(stamp_path.clone(), io), .Some(prev) => (prev == stamp), .None => false)));
    if(!(cached), {
      cmdline := String.new();
      cmdline.push_string(_sh_quote(cc.clone()));
      (fi : usize) = usize(0);
      while(fi < flags.len(), {
        cmdline.push_str(" ");
        cmdline.push_string(_sh_quote(match(flags.get(fi), .Some(f) => f, .None => String.new())));
        fi = (fi + usize(1));
      });
      cmdline.push_str(" -c ");
      cmdline.push_string(_sh_quote(cf.clone()));
      cmdline.push_str(" -o ");
      cmdline.push_string(_sh_quote(obj.clone()));
      lines.push(cmdline);
      stamps.push(stamp);
      stamp_paths.push(stamp_path);
    });
    i = (i + usize(1));
  });
  hits := (chunk_c_files.len() - lines.len());
  hits_out.push(hits);
  println(`chunks: ${chunk_c_files.len().to_string()} unit(s), ${hits.to_string()} cached, ${lines.len().to_string()} to compile (jobs=${jobs.to_string()})`);
  if(lines.len() == usize(0), {
    return(objs);
  });
  windows_host := is_target_windows(host_target());
  cond(
    windows_host => {
      // No `sh`: compile sequentially, one Command per chunk.
      (li : usize) = usize(0);
      while(li < chunk_c_files.len(), {
        cf := match(chunk_c_files.get(li), .Some(x) => x, .None => String.new());
        obj := match(objs.get(li), .Some(x) => x, .None => String.new());
        seq := _cc_command(cc.clone(), flags);
        seq.arg(String.from("-c"));
        seq.arg(cf.clone());
        seq.arg(String.from("-o"));
        seq.arg(obj.clone());
        sst := io.await(seq.status(io), IoExn(io : io, exn : exn));
        if(sst.raw != i32(0), {
          exn.throw(dyn(`compile: C compiler failed (exit ${sst.code().unwrap_or(i32(-1)).to_string()}) on ${cf}`));
          return(objs);
        });
        li = (li + usize(1));
      });
    },
    true => {
      // One `sh` child; `cc` jobs run in background waves of `jobs`, and each
      // job's status is collected individually.
      script := String.from("pids=\"\"\nrc=0\n");
      (li : usize) = usize(0);
      (in_wave : usize) = usize(0);
      while(li < lines.len(), {
        script.push_string(match(lines.get(li), .Some(l) => l, .None => String.new()));
        script.push_str(" & pids=\"$pids $!\"\n");
        in_wave = (in_wave + usize(1));
        if(in_wave >= jobs, {
          script.push_str("for p in $pids; do wait $p || rc=1; done\npids=\"\"\n");
          in_wave = usize(0);
        });
        li = (li + usize(1));
      });
      script.push_str("for p in $pids; do wait $p || rc=1; done\nexit $rc\n");
      script_path := `${out_base}_chunks_compile.sh`;
      io.await(write_string(Path.new(script_path.clone()), script, io), IoExn(io : io, exn : exn));
      shcmd := Command.new(String.from("sh"));
      shcmd.arg(script_path.clone());
      shst := io.await(shcmd.status(io), IoExn(io : io, exn : exn));
      if(shst.raw != i32(0), {
        exn.throw(dyn(`compile: C compiler failed (exit ${shst.code().unwrap_or(i32(-1)).to_string()}) compiling chunks — see ${script_path}`));
        return(objs);
      });
    }
  );
  // Only stamp AFTER a successful compile, so a failed build never leaves a
  // stamp that would make the next run skip a missing/partial object.
  (wi : usize) = usize(0);
  while(wi < stamp_paths.len(), {
    _chunk_write_stamp(
      match(stamp_paths.get(wi), .Some(p) => p, .None => String.new()),
      match(stamps.get(wi), .Some(s) => s, .None => String.new()),
      io
    );
    wi = (wi + usize(1));
  });
  objs
});
/// Nanoseconds → "1234.5 ms" (one decimal, integer arithmetic — no float
/// formatting drift between builds).
_fmt_profile_ms :: (fn(ns : i64) -> String)({
  tenths := (ns / i64(100000));
  `${(tenths / i64(10)).to_string()}.${(tenths % i64(10)).to_string()} ms`
});
/// Minimal JSON string escaping: backslash, double quote, and control bytes
/// as \u00XX. Module paths are the only strings that flow through here.
_json_escape :: (fn(s : String) -> String)({
  bytes := s.as_bytes();
  out := ArrayList(u8).new();
  hexdigits := String.from("0123456789abcdef");
  (i : usize) = usize(0);
  while(i < bytes.len(), {
    b := match(bytes.get(i), .Some(x) => x, .None => u8(0));
    cond(
      (b == u8(92)) => {
        out.push(u8(92));
        out.push(u8(92));
      },
      (b == u8(34)) => {
        out.push(u8(92));
        out.push(u8(34));
      },
      (b < u8(32)) => {
        (hi : usize) = (usize(b) / usize(16));
        (lo : usize) = (usize(b) % usize(16));
        out.push(u8(92));
        out.push(u8(117));
        out.push(hexdigits.byte_at(hi));
        out.push(hexdigits.byte_at(lo));
      },
      true => {
        out.push(b);
      }
    );
    i = (i + usize(1));
  });
  String.from_bytes(out)
});
/// The `--profile` report (Phase 0, plans/INCREMENTAL_COMPILATION_ZIG_LESSONS.md §3).
/// Phase rows are WALL times in record order; module rows are EXCLUSIVE (the
/// loader subtracts nested demand loads), top 20 by evaluation time; the
/// census line answers "how many functions reach emission, from where, how
/// many minted during emission". A non-empty `json_path` also writes the
/// machine-readable form — module keys are absolute paths, sorted, so the
/// file diffs cleanly across commits and machines.
_print_compile_profile :: (
  fn(
    json_path : String,
    io : Io,
    exn : Exception
  ) -> unit
)({
  if(!(profile_enabled()), {
    return(());
  });
  eprintln(String.from("profile: phases"));
  (i : usize) = usize(0);
  while(i < profile_phase_count(), {
    eprintln(
      `profile: phase ${profile_phase_name_at(i)} ${_fmt_profile_ms(profile_phase_nanos_at(i))}`
    );
    i = (i + usize(1));
  });
  n := profile_module_count();
  k := cond((n < usize(20)) => n, true => usize(20));
  eprintln(
    `profile: modules top ${k.to_string()} of ${n.to_string()} by evaluation (exclusive)`
  );
  taken := ArrayList(bool).new();
  (ti : usize) = usize(0);
  while(ti < n, {
    taken.push(false);
    ti = (ti + usize(1));
  });
  (pick : usize) = usize(0);
  while(pick < k, {
    (best : usize) = n;
    (best_ns : i64) = i64(-1);
    (mi : usize) = usize(0);
    while(mi < n, {
      if(!(taken(mi)), {
        ns := profile_module_eval_ns_at(mi);
        if(ns > best_ns, {
          best_ns = ns;
          best = mi;
        });
      });
      mi = (mi + usize(1));
    });
    if(best < n, {
      taken(best) = true;
      eprintln(
        `profile: module ${_fmt_profile_ms(profile_module_eval_ns_at(best))} (parse ${_fmt_profile_ms(profile_module_parse_ns_at(best))}) ${profile_module_path_at(best)}`
      );
    });
    pick = (pick + usize(1));
  });
  ft := profile_fn_total();
  fs := profile_fn_std();
  eprintln(
    `profile: functions ${ft.to_string()} total, ${fs.to_string()} std, ${(ft - fs).to_string()} project, ${(ft - profile_fn_at_collect()).to_string()} minted-during-emission`
  );
  if(json_path.len() > usize(0), {
    // Modules sorted by path: byte-stable regardless of load order.
    order := ArrayList(usize).new();
    (oi : usize) = usize(0);
    while(oi < n, {
      order.push(oi);
      oi = (oi + usize(1));
    });
    (oa : usize) = usize(1);
    while(oa < n, {
      (ob : usize) = oa;
      while((ob > usize(0)) && (profile_module_path_at(order(ob)) < profile_module_path_at(order(ob - usize(1)))), {
        tmp := order(ob);
        order(ob) = order(ob - usize(1));
        order(ob - usize(1)) = tmp;
        ob = (ob - usize(1));
      });
      oa = (oa + usize(1));
    });
    js := String.new();
    js.push_str("{\"phases\":{");
    (pi : usize) = usize(0);
    while(pi < profile_phase_count(), {
      if(pi > usize(0), {
        js.push_str(",");
      });
      js.push_str("\"");
      js.push_string(_json_escape(profile_phase_name_at(pi)));
      js.push_str("\":");
      js.push_string(profile_phase_nanos_at(pi).to_string());
      pi = (pi + usize(1));
    });
    js.push_str("},\"modules\":{");
    (oi2 : usize) = usize(0);
    while(oi2 < order.len(), {
      idx := match(order.get(oi2), .Some(x) => x, .None => usize(0));
      if(oi2 > usize(0), {
        js.push_str(",");
      });
      js.push_str("\"");
      js.push_string(_json_escape(profile_module_path_at(idx)));
      js.push_str("\":{\"parse_ns\":");
      js.push_string(profile_module_parse_ns_at(idx).to_string());
      js.push_str(",\"eval_ns\":");
      js.push_string(profile_module_eval_ns_at(idx).to_string());
      js.push_str("}");
      oi2 = (oi2 + usize(1));
    });
    js.push_str("},\"functions\":{\"total\":");
    js.push_string(profile_fn_total().to_string());
    js.push_str(",\"std\":");
    js.push_string(profile_fn_std().to_string());
    js.push_str(",\"project\":");
    js.push_string((profile_fn_total() - profile_fn_std()).to_string());
    js.push_str(",\"minted_during_emission\":");
    js.push_string((profile_fn_total() - profile_fn_at_collect()).to_string());
    js.push_str("}}\n");
    io.await(write_string(Path.new(json_path.clone()), js, io), IoExn(io : io, exn : exn));
  });
});
/// Write the evaluation's input list for `--emit-deps`
/// (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.9): one absolute path per
/// line, in first-open order, newline-terminated. Deliberately NOT make's
/// `target: dep dep` syntax — nothing here feeds `make`, and a bare list needs
/// no escaping for the spaces and colons a real path contains.
_write_depfile :: (
  fn(path : String, files : ArrayList(String), io : Io, exn : Exception) -> Impl(Future(unit, IoExn))
)(
  io.async((e : IoExn) => {
    body := String.new();
    (i : usize) = usize(0);
    while(i < files.len(), {
      match(
        files.get(i),
        .Some(f) => {
          body.push_string(f.clone());
          body.push_str("\n");
        },
        .None => ()
      );
      i = (i + usize(1));
    });
    e.io.await(write_string(Path.new(path.clone()), body, e.io), e)
  })
);
/// Run the `compile` subcommand.
run_compile :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  if(argv.len() < usize(3), {
    exn.throw(dyn(`compile: missing input file. Usage: yo compile <input.yo> [-o out] [--c-compiler cc] [--target <triple>] [--emit-c]`));
  });
  // Parse args. Mirrors the `compile` command options of the TypeScript
  // `yo-cli` (src/yo-cli.ts / src/codegen/index.ts) for the clang/gcc/zig path.
  (input_path : String) = String.from("");
  (output : String) = String.from("a.out");
  // `cc` stays empty until the user passes it; resolution (wasm → emcc, else
  // findAvailableCompiler) happens after the loop, mirroring
  // src/yo-cli.ts:468-486.
  (cc : String) = String.from("");
  (target_triple : String) = String.from("");
  (sysroot : String) = String.from("");
  (allocator : String) = String.from("system");
  // `--heap-size <n>[K|M|G]`: raw string kept so validation can name the
  // flag; heap_size carries the parsed default (16 MiB) until then.
  (heap_size_raw : String) = String.new();
  (heap_size : usize) = usize(16777216);
  (debug_heap : bool) = false;
  (emit_chunks : usize) = usize(0);
  // `--emit-chunks auto` (Phase 1, plans/INCREMENTAL_COMPILATION_ZIG_LESSONS.md
  // §4): N is resolved AFTER emission, from the actual emitted bytes —
  // clamp(1, cap, emitted / MIN_CHUNK_BYTES) — with cap = YO_JOBS or the
  // hardware thread count.
  (emit_chunks_auto : bool) = false;
  (chunk_no_lto : bool) = false;
  // --jobs J: parallel per-chunk `cc -c` jobs (chunked emission only).
  // 0 = not given: defaults to 8, or to the auto cap when --emit-chunks auto
  // resolves N from the core count (no point minting more chunks than the
  // driver will compile at once).
  (jobs : usize) = usize(0);
  (optimize : String) = String.from(""); // "" = unset; "0".."3"
  (sanitize : String) = String.from(""); // "" / "address" / "leak" / "thread"
  (cflags : String) = String.from("");
  (emit_c : bool) = false;
  // `--emit-c-to <path>`: write the single generated C file to exactly this
  // path instead of the `<output>.c` sidecar. "" = unset.
  (emit_c_to : String) = String.new();
  // `--emit-deps <path>`: write one line per file the EVALUATION opened — the
  // `-MD` idea (plans/BUILD_AND_DEPENDENCY_SYSTEM_REDESIGN.md §4.9). The build
  // runner hashes exactly that list on the next build instead of walking the
  // whole project and the whole std tree per artifact. "" = unset.
  (emit_deps_to : String) = String.new();
  // `--emcc-environment <web|node>`: mirrors the TS-internal `emccEnvironment`
  // codegen option (codegen/index.ts:187). TS has no CLI flag for it because
  // its build-runner calls codegen in-process; ours SHELLS OUT to `compile`,
  // so the value needs a flag to travel on. "" = unset, which is exactly TS's
  // `undefined` for the plain `yo compile` path and adds `-sNODERAWFS=1`;
  // build_runner passes `web` for wasm targets, which suppresses it.
  (emcc_environment : String) = String.new();
  // Cooperative evaluator deadline in milliseconds; empty = disarmed. Set by
  // the test runner on its batch-compile children (see `set_evaluator_deadline`
  // in evaluator/exprs/_expr.yo for why this travels as a flag).
  (compile_timeout_ms : String) = String.new();
  // Phase 0 (plans/INCREMENTAL_COMPILATION_ZIG_LESSONS.md §3): print the
  // per-phase / per-module timing table on stderr after the compile, and
  // optionally write the machine-readable form (keys are absolute module
  // paths) for diffing across commits.
  (profile : bool) = false;
  (profile_json : String) = String.new();
  // V3: opt OUT of the post-eval contract verification (the test runner's
  // batch compiles — a runtime harness; legs without Z3 could not compile
  // verify-pragma fixtures otherwise).
  (no_verify : bool) = false;
  (skip_cc : bool) = false;
  (skip_codegen : bool) = false;
  (debug_gc : bool) = false;
  (debug_parallelism : bool) = false;
  (debug_async_await : bool) = false;
  (debug_symbols : bool) = false; // -g
  (strip_syms : bool) = false; // -s
  (static_link : bool) = false; // --static
  (static_library : bool) = false; // --static-library
  // --shared-library: the same library EMISSION as --static-library (plain
  // exported names, no `main` wrapper), linked with `-shared -fPIC` into
  // lib<name>.{dylib,so,dll} (plan §4.5.4).
  (shared_library : bool) = false;
  defines := ArrayList(String).new(); // -D
  include_paths := ArrayList(String).new(); // -I
  library_paths := ArrayList(String).new(); // -L
  libraries := ArrayList(String).new(); // -l
  externs := ArrayList(String).new(); // --extern
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    a := argv(ai);
    // `--flag=value` normalization: split at the FIRST '=' (values may
    // themselves contain '=', e.g. `--cflags=-march=native`). Mirrors yargs,
    // and the file's own precedent at the doc/build subcommands.
    (a_name : String) = a.clone();
    (a_val : Option(String)) = Option(String).None;
    if(a.starts_with("--"), {
      (eq_at : isize) = (isize(0) - isize(1));
      (sc_i : usize) = usize(0);
      while((sc_i < a.len()) && (eq_at < isize(0)), {
        if(a.byte_at(sc_i) == u8(61), {
          eq_at = isize(sc_i);
        });
        sc_i = (sc_i + usize(1));
      });
      if(eq_at > isize(0), {
        a_name = a.substring(usize(0), usize(eq_at));
        a_val = Option(String).Some(a.substring(usize(eq_at) + usize(1), a.len()));
      });
    });
    cond(
      (a_name == "-o") => {
        output = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      ((a_name == "--c-compiler") || (a_name == "--cc") || (a_name == "-cc")) => {
        cc = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      ((a_name == "--target") || (a_name == "-t")) => {
        target_triple = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--sysroot") => {
        sysroot = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--emcc-environment") => {
        emcc_environment = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--no-verify") => {
        no_verify = true;
        ai = (ai + usize(1));
      },
      (a_name == "--compile-timeout-ms") => {
        compile_timeout_ms = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--profile") => {
        profile = true;
        ai = (ai + usize(1));
      },
      (a_name == "--profile-json") => {
        profile_json = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--allocator") => {
        allocator = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--heap-size") => {
        heap_size_raw = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--debug-heap") => {
        debug_heap = true;
        ai = (ai + usize(1));
      },
      (a_name == "--optimize") => {
        optimize = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--sanitize") => {
        sanitize = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--cflags") => {
        cflags = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      // Array options. Space/`=` forms are GREEDY like yargs `type: "array"`:
      // following non-dash args join the list (`-I a b` = two include paths —
      // previously `b` silently became input_path, a wrong-file success).
      ((a_name == "-D") || (a_name == "--define")) => {
        defines.push(_opt_value(argv, ai, a_name.clone(), a_val.clone(), exn));
        ai = (ai + _opt_step(a_val));
        while((ai < argv.len()) && !(argv(ai).starts_with("-")), {
          defines.push(argv(ai));
          ai = (ai + usize(1));
        });
      },
      (a_name == "-I") => {
        include_paths.push(_opt_value(argv, ai, a_name.clone(), a_val.clone(), exn));
        ai = (ai + _opt_step(a_val));
        while((ai < argv.len()) && !(argv(ai).starts_with("-")), {
          include_paths.push(argv(ai));
          ai = (ai + usize(1));
        });
      },
      (a_name == "-L") => {
        library_paths.push(_opt_value(argv, ai, a_name.clone(), a_val.clone(), exn));
        ai = (ai + _opt_step(a_val));
        while((ai < argv.len()) && !(argv(ai).starts_with("-")), {
          library_paths.push(argv(ai));
          ai = (ai + usize(1));
        });
      },
      (a_name == "-l") => {
        libraries.push(_opt_value(argv, ai, a_name.clone(), a_val.clone(), exn));
        ai = (ai + _opt_step(a_val));
        while((ai < argv.len()) && !(argv(ai).starts_with("-")), {
          libraries.push(argv(ai));
          ai = (ai + usize(1));
        });
      },
      (a_name == "--extern") => {
        externs.push(_opt_value(argv, ai, a_name.clone(), a_val.clone(), exn));
        ai = (ai + _opt_step(a_val));
        while((ai < argv.len()) && !(argv(ai).starts_with("-")), {
          externs.push(argv(ai));
          ai = (ai + usize(1));
        });
      },
      // Attached short forms, gcc-style: `-I./include`, `-L./lib`, `-lm`,
      // `-DFOO=1`, `-oout` (the TS help's own examples, src/yo-cli.ts:320-346).
      // One value each; checked AFTER the exact matches so `-l` alone still
      // takes the next arg.
      (a.starts_with("-I") && ((a.len() > usize(2)) && !(a.starts_with("--")))) => {
        include_paths.push(a.substring(usize(2), a.len()));
        ai = (ai + usize(1));
      },
      (a.starts_with("-L") && ((a.len() > usize(2)) && !(a.starts_with("--")))) => {
        library_paths.push(a.substring(usize(2), a.len()));
        ai = (ai + usize(1));
      },
      (a.starts_with("-l") && ((a.len() > usize(2)) && !(a.starts_with("--")))) => {
        libraries.push(a.substring(usize(2), a.len()));
        ai = (ai + usize(1));
      },
      (a.starts_with("-D") && ((a.len() > usize(2)) && !(a.starts_with("--")))) => {
        defines.push(a.substring(usize(2), a.len()));
        ai = (ai + usize(1));
      },
      (a.starts_with("-o") && ((a.len() > usize(2)) && !(a.starts_with("--")))) => {
        output = a.substring(usize(2), a.len());
        ai = (ai + usize(1));
      },
      // `--emit-c` PRINTS the generated C to stdout and still compiles/links
      // (TS module-manager.ts:473-475); `--skip-c-compiler` gates the link
      // (TS codegen/index.ts:234). Previously conflated.
      (a_name == "--emit-c") => {
        emit_c = true;
        ai = (ai + usize(1));
      },
      // `--emit-deps <path>`: the evaluation's input list, one path per line.
      // Written once the module evaluates; a compile that dies earlier leaves
      // no depfile, and the next build then falls back to the whole-tree walk
      // — conservative, which is the safe direction for a cache.
      (a_name == "--emit-deps") => {
        emit_deps_to = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      // `--emit-c-to <path>` REDIRECTS the sidecar (it does not add a second
      // copy), so the C compiler consumes this same path. Distinct from
      // `--emit-c`, which only prints to stdout.
      (a_name == "--emit-c-to") => {
        emit_c_to = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--skip-c-compiler") => {
        skip_cc = true;
        ai = (ai + usize(1));
      },
      (a == "--skip-codegen") => {
        skip_codegen = true;
        ai = (ai + usize(1));
      },
      (a == "--release") => {
        // Removed 2026-08-28: it was a pure alias of `--optimize 2` (no
        // profile, no NDEBUG, no warning difference). Say so instead of
        // failing as an unknown flag.
        exn.throw(dyn(String.from("compile: --release was removed; use --optimize 2 (it was exactly that)")));
      },
      (a == "--debug-gc") => {
        debug_gc = true;
        ai = (ai + usize(1));
      },
      (a == "--no-chunk-lto") => {
        chunk_no_lto = true;
        ai = (ai + usize(1));
      },
      (a == "--jobs") => {
        jv := _arg_val_req(argv, ai, String.from("--jobs"), exn);
        jobs = match(jv.parse_u64(), .Some(n) => if(n > u64(0), usize(n), usize(1)), .None => usize(8));
        ai = (ai + usize(2));
      },
      (a == "--emit-chunks") => {
        ecv := _arg_val_req(argv, ai, String.from("--emit-chunks"), exn);
        cond(
          (ecv == "auto") => {
            emit_chunks_auto = true;
          },
          true => {
            emit_chunks = match(ecv.parse_u64(), .Some(n) => usize(n), .None => usize(0));
          }
        );
        ai = (ai + usize(2));
      },
      (a == "--debug-parallelism") => {
        debug_parallelism = true;
        ai = (ai + usize(1));
      },
      (a == "--debug-async-await") => {
        debug_async_await = true;
        ai = (ai + usize(1));
      },
      ((a == "-g") || (a == "--debug-symbols")) => {
        debug_symbols = true;
        ai = (ai + usize(1));
      },
      ((a == "-s") || (a == "--strip")) => {
        strip_syms = true;
        ai = (ai + usize(1));
      },
      (a == "--static") => {
        static_link = true;
        ai = (ai + usize(1));
      },
      (a == "--static-library") => {
        static_library = true;
        ai = (ai + usize(1));
      },
      (a == "--shared-library") => {
        shared_library = true;
        ai = (ai + usize(1));
      },
      // Accepted for parity; `compile` has no default sanitizer in either
      // compiler (the TEST runner's default is where --disable-sanitize bites).
      (a == "--disable-sanitize") => {
        ai = (ai + usize(1));
      },
      a.starts_with("-") => {
        // yargs is .strict() (src/yo-cli.ts:1358): an unknown option is an
        // error. The old silent catch-all dropped mistyped flags — a
        // `--sanitizer address` typo compiled unsanitized with rc=0.
        exn.throw(dyn(`compile: unknown option '${a}'`));
        ai = (ai + usize(1));
      },
      true => {
        input_path = a;
        ai = (ai + usize(1));
      }
    );
  });
  // ----- choices validation (yargs `choices:` parity, src/yo-cli.ts) -------
  if(((cc != "") && (((cc != "cc") && (cc != "gcc")) && ((cc != "clang") && (cc != "zig")))) && (cc != "emcc"), {
    exn.throw(dyn(`compile: invalid --c-compiler "${cc}". Choices: cc, gcc, clang, zig, emcc`));
  });
  if(((allocator != "mimalloc") && (allocator != "system")) && (allocator != "fixed"), {
    exn.throw(dyn(`compile: invalid --allocator "${allocator}". Choices: mimalloc, system, fixed`));
  });
  // --heap-size / --debug-heap belong to the fixed-region allocator only
  // (plans/reference/FIXED_REGION_ALLOCATOR.md §2.2/§2.4): a silent ignore would
  // let a build believe it has a bounded heap while it runs on libc malloc.
  if(heap_size_raw.len() > usize(0), {
    if(allocator != "fixed", {
      exn.throw(dyn(String.from("compile: --heap-size requires --allocator fixed")));
    });
    match(
      _parse_heap_size(heap_size_raw.clone()),
      .Ok(bytes) => {
        heap_size = bytes;
      },
      .Err(why) => {
        exn.throw(dyn(`compile: invalid --heap-size "${heap_size_raw}": ${why}`));
      }
    );
  });
  if(debug_heap && (allocator != "fixed"), {
    exn.throw(dyn(String.from("compile: --debug-heap requires --allocator fixed")));
  });
  if((optimize != "") && (((optimize != "0") && (optimize != "1")) && ((optimize != "2") && (optimize != "3"))), {
    exn.throw(dyn(`compile: invalid --optimize "${optimize}". Choices: 0, 1, 2, 3`));
  });
  if((sanitize != "") && (((sanitize != "address") && (sanitize != "leak")) && (sanitize != "thread")), {
    exn.throw(dyn(`compile: invalid --sanitize "${sanitize}". Choices: address, leak, thread`));
  });
  if((emcc_environment != "") && ((emcc_environment != "web") && (emcc_environment != "node")), {
    exn.throw(dyn(`compile: invalid --emcc-environment "${emcc_environment}". Choices: web, node`));
  });
  // Chunked emission drives multiple TU inputs through the executable link
  // line; the static-library path compiles ONE input to ONE `.o`.
  if(((emit_chunks >= usize(1)) || emit_chunks_auto) && static_library, {
    exn.throw(dyn(String.from("compile: --emit-chunks is not supported with --static-library")));
  });
  if(static_library && shared_library, {
    exn.throw(dyn(String.from("compile: --static-library and --shared-library are mutually exclusive")));
  });
  // Both flags decide what C files get WRITTEN, so the combination is
  // ambiguous rather than merely redundant: `--emit-c-to` names ONE file, and
  // the chunked path writes a header plus N chunks. (`--emit-c`, which only
  // PRINTS the single-file equivalent, stays allowed.)
  if(((emit_chunks >= usize(1)) || emit_chunks_auto) && (emit_c_to.len() > usize(0)), {
    exn.throw(dyn(String.from("compile: --emit-c-to writes one C file and --emit-chunks writes a header plus N chunks — pass only one")));
  });
  // `--emit-chunks auto` cap (Phase 1): YO_JOBS wins when set to a usable
  // value, else the hardware thread count. A malformed YO_JOBS warns and
  // falls back — it is a tuning knob, not a correctness setting.
  (chunk_auto_cap : usize) = usize(0);
  if(emit_chunks_auto, {
    match(
      proc_env.get(String.from("YO_JOBS")),
      .Some(v) => match(
        v.parse_u64(),
        .Some(n) => if(n > u64(0), {
          chunk_auto_cap = usize(n);
        }, {
          eprintln(String.from("compile: YO_JOBS must be a positive integer; ignoring it"));
        }),
        .None => {
          eprintln(String.from("compile: YO_JOBS must be a positive integer; ignoring it"));
        }
