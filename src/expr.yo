/// Throws if `expr` is not a FnCall of `func_name` with an optional exact `arg_count`.
///
expect_expr_to_be_fn_call_of :: (
  fn(
    imm(expr) : AstExpr,
    func_name : str,
    arg_count : Option(usize),
    imm(exn) : Exception
  ) -> unit
)({
  if(!ast_expr_is_fn_call(expr), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected function call, got atom:\n${ast_expr_to_string(expr)}`
        )
      )
    );
  });
  if(!ast_expr_is_fn_call_of(expr, func_name, .None), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected function call of "${String.from(func_name)}", got:\n${ast_expr_to_string(expr)}`
        )
      )
    );
  });
  match(
    arg_count,
    .Some(n) => {
      actual := match(
        expr,
        .FnCall(_, _, args, _, _) => args.len(),
        _ => usize(0)
      );
      if(actual != n, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(expr),
              `Expected ${n.to_string()} arguments, got ${actual.to_string()}:\n${ast_expr_to_string(expr)}`
            )
          )
        );
      });
    },
    .None => ()
  )
});
/// Throws if `expr` is not a FnCall of one of `func_names` with an optional exact `arg_count`.
expect_expr_to_be_fn_call_of_any :: (
  fn(
    imm(expr) : AstExpr,
    imm(func_names) : ArrayList(str),
    arg_count : Option(usize),
    imm(exn) : Exception
  ) -> unit
)({
  if(!ast_expr_is_fn_call(expr), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected function call, got atom:\n${ast_expr_to_string(expr)}`
        )
      )
    );
  });
  if(!ast_expr_is_fn_call_of_any(expr, func_names, .None), {
    exn.throw(
      dyn(
        format_error_message(
          ast_expr_token(expr),
          `Expected function call of one of the expected names, got:\n${ast_expr_to_string(expr)}`
        )
      )
    );
  });
  match(
    arg_count,
    .Some(n) => {
      actual := match(
        expr,
        .FnCall(_, _, args, _, _) => args.len(),
        _ => usize(0)
      );
      if(actual != n, {
        exn.throw(
          dyn(
            format_error_message(
              ast_expr_token(expr),
              `Expected ${n.to_string()} arguments, got ${actual.to_string()}:\n${ast_expr_to_string(expr)}`
            )
          )
        );
      });
    },
    .None => ()
  )
});
/// Synthesize a token for a desugared node, inheriting position and
/// provenance from `ref_tok` so errors keep pointing at the source site.
_synth_desugar_tok :: (fn(kind : TokenKind, value : str, imm(ref_tok) : Token) -> Token)(
  // A fixed keyword: intern it, or each desugared `if` keeps its own `cond`,
  // `=>`, `true` and `tuple` buffers (plans/EVALUATOR_MEMORY_REDUCTION.md §0.23).
  _synth_desugar_tok_s(kind, intern_token_str(String.from(value)), ref_tok)
);
/// `_synth_desugar_tok` for a name built at desugar time.
_synth_desugar_tok_s :: (fn(kind : TokenKind, imm(value) : String, imm(ref_tok) : Token) -> Token)(
  Token(
    kind : kind,
    value : value,
    row : ref_tok.row,
    column : ref_tok.column,
    character : ref_tok.character,
    byte_offset : ref_tok.byte_offset,
    // SHARE module_path and input — never .clone() them. String.clone()
    // deep-copies the buffer, and `input` is the ENTIRE SOURCE FILE: the
    // original desugar cloned it into every synthesized (and, worse, every
    // REBUILT) node's token, giving each AST node a private copy of the
    // file. Measured on `yo check` of the vendor/markdown_yo closure:
    // 16.5s/3.1GB -> 60s/7.0GB — the v0.2.15 evaluator regression. Sharing
    // also restores the __yo_ptr_eq fast path in String's Eq, which
    // begin.yo's _m3_tokens_comparable (`left.input == right.input`) relies
    // on — with per-node copies every comparability check memcmp'd the
    // whole file (issues/desugar-token-clones-evaluator-regression.md).
    module_path : ref_tok.module_path,
    input : ref_tok.input
  )
);
/// Unwrap an optional `label : value` wrapper on an `if` argument.
/// `.Some(value)` when the arg is unlabeled or carries the expected label;
/// `.None` when it carries a DIFFERENT label — the caller then bails out of
/// the rewrite and the prelude `if` macro path reports the proper
/// label-mismatch error.
_unwrap_if_label :: (fn(imm(arg) : AstExpr, label : str) -> Option(AstExpr))({
  if(!ast_expr_is_fn_call_of(arg, ":", .Some(usize(2))), {
    return(Option(AstExpr).Some(arg));
  });
  pair_args := match(
    arg,
    .FnCall(_, _, pa, _, _) => pa,
    .Atom(_, _) => ArrayList(AstExpr).new()
  );
  label_matches := match(
    pair_args.get(usize(0)),
    .Some(.Atom(_, ltok)) => (ltok.value == label),
    _ => false
  );
  cond(
    label_matches => match(
      pair_args.get(usize(1)),
      .Some(v) => Option(AstExpr).Some(v),
      .None => Option(AstExpr).None
    ),
    true => Option(AstExpr).None
  )
});
/// Desugar `if(c, t)` / `if(c, t, e)` / labeled `if(c, then : t, else : e)`
/// calls into the builtin `cond(c => t, true => e)` form, recursively,
/// WITHOUT descending into `quote(...)` subtrees (quoted ASTs are
/// user-visible comptime values; code spliced OUT of them is desugared at
/// the splice sites in evaluator/calls/function.yo and
/// evaluator/builtins/derive.yo instead).
///
/// This runs on every freshly parsed program (parser.yo `parse`,
/// evaluator/index.yo `Evaluator.new`), so downstream passes — codegen,
/// the async state machine, the dup/drop optimizer — see a real `cond`
/// node instead of an `if` macro head and never need the
/// `ExprInfo.macro_expansion` side-table for `if` (plans/reference/MACRO_POLICY.md
/// Part 3.2).
///
/// Anything this walk does NOT rewrite (odd arity, mismatched labels,
/// dynamically constructed `if` calls that reach evaluation without a
/// splice hook) falls back to the prelude's `if` macro, which is retained
/// for seed-generation compatibility — the failure mode is the previous
/// behavior, never a new error.
///
/// The rewritten node KEEPS the original call's ExprId (the rewrite runs
/// before any ExprInfo for the node is written, and the `if` node it
/// replaces is discarded); synthesized inner nodes mint fresh ids.
/// Allocation-free pre-scan: does `e` contain a desugar target — a 2- or
/// 3-arg `if(...)` call, or a `c_include(...)` / `extern(...)` call — anywhere
/// outside quote(...)? The desugar rebuild only pays for itself on trees that
/// actually carry one — a target-free subtree is returned unchanged by the
/// copy-on-write check below, so parsing a module with neither costs one
/// read-only walk instead of a full AST reconstruction.
// ---------------------------------------------------------------------------
// `&T` / `&mut T` in the declaration slots (plans/VALUES_BY_DEFAULT.md
// decision 42, Generation A)
// ---------------------------------------------------------------------------
// Decision 42 spells a borrow `&T` / `&mut T` in every slot that holds one.
// Generation A accepts the new spelling as an exact synonym of the mode words
// by rewriting it, here, into the form every later pass already reads:
//   `x : &T`             → `imm(x) : T`   (a parameter, a receiver
//   `x : &mut T`         → `mut(x) : T`    `self : &Self`, a closure
//                                          parameter, an `Fn(...)` slot;
//                                          `comptime(x) : &T` →
//                                          `comptime(imm(x)) : T`)
//   `-> &T` / `-> &mut T`                → `-> imm(T)` / `-> mut(T)`
//   `y := &place` / `y := &mut place`    → `imm(y) := place` / `mut(y) := place`
//   `(y : &T) = &place`                  → `imm(y, T) := place` (the
//                                          annotation, checked against the
//                                          place's type by the binding)
//   `y = &place` / `cur = &mut place`    → `imm(y) = place` / `mut(cur) = place`
//   `{ y : &y, z : &mut z }(…) =>`       → `{ imm(y) : &y, mut(z) : &mut z }(…) =>`
//   `{ &y, &mut z }(…) =>` (puns)        → `{ imm(y), mut(z) }(…) =>`
//   `for(&xs, x => …)`                   → `for(xs, x => …)`
//   `for(&mut xs, x => …)`               → `for(xs, mut(x) => …)` (and the
//                                          map form's `(k, v)` → `(k, mut(v))`)
// A `&T` anywhere else (`T :: &i32`, `ArrayList(&T)`, a field's type) is not
// rewritten and is rejected by the evaluator as a borrow mode, not a type.
// The formatter never sees this: it renders the token stream, so a file keeps
// the spelling it was written in. The synthesized mode tokens sit at the
// sigil, so a diagnostic about the mode points at the `&`.
/// A borrow sigil: `&e` or `&mut e`, a one-operand prefix call.
_BorrowSigil :: struct(is_mut : bool, inner : AstExpr, tok : Token);
_borrow_sigil_of :: (fn(imm(e) : AstExpr) -> Option(_BorrowSigil))(
  match(
    e,
    .FnCall(_, sf, sargs, s_infix, _) => cond(
      (s_infix || (sargs.len() != usize(1))) => Option(_BorrowSigil).None,
      true => match(
        sf,
        .Atom(_, sft) => cond(
          ((sft.value == BK_BORROW_MUT) || (sft.value == BF_ADDRESS_OF)) => Option(_BorrowSigil).Some(
            _BorrowSigil(is_mut : (sft.value == BK_BORROW_MUT), inner : match(sargs.get(usize(0)), .Some(a) => a, .None => make_err_expr()), tok : sft)
          ),
          true => Option(_BorrowSigil).None
        ),
        .FnCall(_, _, _, _, _) => Option(_BorrowSigil).None
      )
    ),
    .Atom(_, _) => Option(_BorrowSigil).None
  )
);
/// `imm(args...)` / `mut(args...)`, its head synthesized at the sigil `at`.
_borrow_mode_call :: (fn(is_mut : bool, imm(args) : ArrayList(AstExpr), imm(at) : Token) -> AstExpr)({
  mtok := _synth_desugar_tok(TokenKind.Identifier, cond(is_mut => BK_MUT, true => BK_IMM), at);
  AstExpr.FnCall(alloc_global_expr_id(), AstExpr.Atom(alloc_global_expr_id(), mtok), args, false, mtok)
});
_borrow_mode_call1 :: (fn(is_mut : bool, imm(arg) : AstExpr, imm(at) : Token) -> AstExpr)({
  one := ArrayList(AstExpr).new();
  one.push(arg);
  _borrow_mode_call(is_mut, one, at)
});
/// The two operands of an infix call `a op b`, when `e` is one.
_BsPair :: struct(lhs : AstExpr, rhs : AstExpr);
_bs_infix_pair :: (fn(imm(e) : AstExpr, op : str) -> Option(_BsPair))(
  match(
    e,
    .FnCall(_, pf, pargs, p_infix, _) => cond(
      (p_infix && (pargs.len() == usize(2)) && ast_expr_is_atom_of(pf, op)) => Option(_BsPair).Some(
        _BsPair(lhs : match(pargs.get(usize(0)), .Some(a) => a, .None => make_err_expr()), rhs : match(pargs.get(usize(1)), .Some(a) => a, .None => make_err_expr()))
      ),
      true => Option(_BsPair).None
    ),
    .Atom(_, _) => Option(_BsPair).None
  )
);
/// Rebuild the infix node `e` (same id, head and token) with new operands.
_bs_with_operands :: (fn(imm(e) : AstExpr, imm(lhs) : AstExpr, imm(rhs) : AstExpr) -> AstExpr)(
  match(
    e,
    .FnCall(wid, wf, _, w_infix, wtok) => {
      ops := ArrayList(AstExpr).new();
      ops.push(lhs);
      ops.push(rhs);
      AstExpr.FnCall(wid, wf, ops, w_infix, wtok)
    },
    .Atom(_, _) => e
  )
);
/// Rebuild the prefix call `e` (same id, head and token) with new arguments.
_bs_with_args :: (fn(imm(e) : AstExpr, imm(args) : ArrayList(AstExpr)) -> AstExpr)(
  match(
    e,
    .FnCall(wid, wf, _, w_infix, wtok) => AstExpr.FnCall(wid, wf, args, w_infix, wtok),
    .Atom(_, _) => e
  )
);
_bs_args :: (fn(imm(e) : AstExpr) -> ArrayList(AstExpr))(
  match(e, .FnCall(_, _, a, _, _) => a, .Atom(_, _) => ArrayList(AstExpr).new())
);
/// An identifier atom: the only name a local borrow or a capture pun binds.
_bs_is_name :: (fn(imm(e) : AstExpr) -> bool)(
  match(e, .Atom(_, t) => (t.kind == TokenKind.Identifier), .FnCall(_, _, _, _, _) => false)
);
/// The heads whose arguments are parameter declarations.
_bs_is_param_list_head :: (fn(imm(e) : AstExpr) -> bool)(
  match(
    e,
    .FnCall(_, hf, _, h_infix, _) => (!h_infix && (ast_expr_is_atom_of(hf, BK_FN) || ast_expr_is_atom_of(hf, BK_CTL) || ast_expr_is_atom_of(hf, BK_FN_TRAIT) || ast_expr_is_atom_of(hf, BK_FN_ONCE_TRAIT))),
    .Atom(_, _) => false
  )
);
/// The label `L` of a slot `L : &T` in its mode: `x` → `imm(x)`,
/// `comptime(x)` → `comptime(imm(x))`, `sink(x)` → `sink(imm(x))` (which the
/// evaluator rejects as the combination it is).
_bs_wrap_label :: (fn(imm(label) : AstExpr, imm(s) : _BorrowSigil) -> AstExpr)(
  cond(
    (ast_expr_is_fn_call_of(label, BK_COMPTIME, Option(usize).Some(usize(1))) || ast_expr_is_fn_call_of(label, "sink", Option(usize).Some(usize(1)))) => {
      inner := ArrayList(AstExpr).new();
      inner.push(_borrow_mode_call1(s.is_mut, match(_bs_args(label).get(usize(0)), .Some(a) => a, .None => make_err_expr()), s.tok));
      _bs_with_args(label, inner)
    },
    true => _borrow_mode_call1(s.is_mut, label, s.tok)
  )
);
/// A declared parameter `L : &T` / `L : &mut T`, through a `?= default` or
/// an `= value`: `.Some(rewritten)`, else `.None`.
_bs_param :: (fn(imm(p) : AstExpr) -> Option(AstExpr))(
  match(
    _bs_infix_pair(p, BK_COLON),
    .Some(pr) => match(
      _borrow_sigil_of(pr.rhs),
      .Some(s) => Option(AstExpr).Some(_bs_with_operands(p, _bs_wrap_label(pr.lhs, s), s.inner)),
      .None => Option(AstExpr).None
    ),
    .None => match(
      match(_bs_infix_pair(p, "?="), .Some(d) => Option(_BsPair).Some(d), .None => _bs_infix_pair(p, BK_ASSIGN)),
      .Some(dp) => match(
        recur(dp.lhs),
        .Some(new_lhs) => Option(AstExpr).Some(_bs_with_operands(p, new_lhs, dp.rhs)),
        .None => Option(AstExpr).None
      ),
      .None => Option(AstExpr).None
    )
  )
);
/// Every argument of `args` through `_bs_param`; `.None` when none changed.
_bs_params :: (fn(imm(args) : ArrayList(AstExpr)) -> Option(ArrayList(AstExpr)))({
  if(!_bs_any_param_is_target(args), {
    return(Option(ArrayList(AstExpr)).None);
  });
  out := ArrayList(AstExpr).new();
  (changed : bool) = false;
  (i : usize) = usize(0);
  while(i < args.len(), i = (i + usize(1)), {
    a := match(args.get(i), .Some(x) => x, .None => make_err_expr());
    match(
      _bs_param(a),
      .Some(na) => {
        out.push(na);
        changed = true;
      },
      .None => out.push(a)
    );
  });
  cond(changed => Option(ArrayList(AstExpr)).Some(out), true => Option(ArrayList(AstExpr)).None)
});
/// One capture-list entry (decision 35): `y : &p` → `imm(y) : &p`,
/// `z : &mut p` → `mut(z) : &mut p`, the puns `&y` → `imm(y)` and
/// `&mut z` → `mut(z)`.
_bs_capture_entry :: (fn(imm(c) : AstExpr) -> Option(AstExpr))(
  match(
    _bs_infix_pair(c, BK_COLON),
    .Some(pr) => cond(
      _bs_is_name(pr.lhs) => match(
        _borrow_sigil_of(pr.rhs),
        .Some(s) => Option(AstExpr).Some(_bs_with_operands(c, _borrow_mode_call1(s.is_mut, pr.lhs, s.tok), pr.rhs)),
        .None => Option(AstExpr).None
      ),
      true => Option(AstExpr).None
    ),
    .None => match(
      _borrow_sigil_of(c),
      .Some(s) => cond(
        _bs_is_name(s.inner) => Option(AstExpr).Some(_borrow_mode_call1(s.is_mut, s.inner, s.tok)),
        true => Option(AstExpr).None
      ),
      .None => Option(AstExpr).None
    )
  )
);
/// The left side of a closure literal's `=>`: one parameter `x : &T`, a
/// parameter list `(a : &T, b : U)`, or a capture list with parameters
/// `{ … }(params)`. `.Some(rewritten)` when something changed.
_bs_closure_lhs :: (fn(imm(lhs) : AstExpr) -> Option(AstExpr))(
  cond(
    ast_expr_is_fn_call_of(lhs, BK_TUPLE, Option(usize).None) => match(
      _bs_params(_bs_args(lhs)),
      .Some(np) => Option(AstExpr).Some(_bs_with_args(lhs, np)),
      .None => Option(AstExpr).None
    ),
    ast_expr_is_capture_list_params(lhs) => match(
      lhs,
      .FnCall(lid, cl_callee, cl_params, cl_infix, ltok) => {
        (changed : bool) = false;
        entries := _bs_args(cl_callee);
        new_entries := ArrayList(AstExpr).new();
        (ei : usize) = usize(0);
        while(ei < entries.len(), ei = (ei + usize(1)), {
          en := match(entries.get(ei), .Some(x) => x, .None => make_err_expr());
          match(
            _bs_capture_entry(en),
            .Some(ne) => {
              new_entries.push(ne);
              changed = true;
            },
            .None => new_entries.push(en)
          );
        });
        new_params := match(
          _bs_params(cl_params),
          .Some(np) => {
            changed = true;
            np
          },
          .None => cl_params
        );
        cond(
          changed => Option(AstExpr).Some(AstExpr.FnCall(lid, _bs_with_args(cl_callee, new_entries), new_params, cl_infix, ltok)),
          true => Option(AstExpr).None
        )
      },
      .Atom(_, _) => Option(AstExpr).None
    ),
    true => _bs_param(lhs)
  )
);
/// `for(&mut xs, h)`'s handle: `x => body` → `mut(x) => body`, `(k, v) =>
/// body` → `(k, mut(v)) => body`. A handle already spelling `mut` is kept.
_bs_mut_for_handle :: (fn(imm(h) : AstExpr, imm(at) : Token) -> AstExpr)(
  match(
    _bs_infix_pair(h, "=>"),
    .Some(hp) => cond(
      _bs_is_name(hp.lhs) => _bs_with_operands(h, _borrow_mode_call1(true, hp.lhs, at), hp.rhs),
      (ast_expr_is_fn_call_of(hp.lhs, BK_TUPLE, Option(usize).Some(usize(2))) && _bs_is_name(match(_bs_args(hp.lhs).get(usize(1)), .Some(v) => v, .None => make_err_expr()))) => {
        kv := _bs_args(hp.lhs);
        nkv := ArrayList(AstExpr).new();
        nkv.push(match(kv.get(usize(0)), .Some(k) => k, .None => make_err_expr()));
        nkv.push(_borrow_mode_call1(true, match(kv.get(usize(1)), .Some(v) => v, .None => make_err_expr()), at));
        _bs_with_operands(h, _bs_with_args(hp.lhs, nkv), hp.rhs)
      },
      true => h
    ),
    .None => h
  )
);
/// `e` is a borrow sigil `&x` / `&mut x` (allocation-free).
_bs_is_sigil :: (fn(imm(e) : AstExpr) -> bool)(
  ast_expr_is_fn_call_of(e, BF_ADDRESS_OF, Option(usize).Some(usize(1))) || ast_expr_is_fn_call_of(e, BK_BORROW_MUT, Option(usize).Some(usize(1)))
);
_bs_arg :: (fn(imm(e) : AstExpr, i : usize) -> AstExpr)(
  match(e, .FnCall(_, _, a, _, _) => match(a.get(i), .Some(x) => x, .None => make_err_expr()), .Atom(_, _) => make_err_expr())
);
_bs_is_infix_of :: (fn(imm(e) : AstExpr, op : str) -> bool)(
  match(e, .FnCall(_, f, a, infix, _) => (infix && (a.len() == usize(2)) && ast_expr_is_atom_of(f, op)), .Atom(_, _) => false)
);
/// `L : &T`, through a `?=` default or an `= value` (allocation-free).
_bs_param_is_target :: (fn(imm(p) : AstExpr) -> bool)(
  cond(
    _bs_is_infix_of(p, BK_COLON) => _bs_is_sigil(_bs_arg(p, usize(1))),
    (_bs_is_infix_of(p, "?=") || _bs_is_infix_of(p, BK_ASSIGN)) => recur(_bs_arg(p, usize(0))),
    true => false
  )
);
_bs_any_param_is_target :: (fn(imm(args) : ArrayList(AstExpr)) -> bool)({
  (i : usize) = usize(0);
  while(i < args.len(), i = (i + usize(1)), {
    if(match(args.get(i), .Some(a) => _bs_param_is_target(a), .None => false), {
      return(true);
    });
  });
  false
});
/// The pre-scan for `_borrow_spelling_rewrite` (allocation-free): does `e`
/// itself spell a borrow in a declaration slot?
_is_borrow_spelling_target :: (fn(imm(e) : AstExpr) -> bool)(
  match(
    e,
    .Atom(_, _) => false,
    .FnCall(_, _, args, _, _) => cond(
      _bs_is_param_list_head(e) => _bs_any_param_is_target(args),
      _bs_is_infix_of(e, "->") => (_bs_is_param_list_head(_bs_arg(e, usize(0))) && (_bs_is_sigil(_bs_arg(e, usize(1))) || _bs_param_is_target(_bs_arg(e, usize(1))))),
      _bs_is_infix_of(e, "=>") => {
        lhs := _bs_arg(e, usize(0));
        cond(
          ast_expr_is_fn_call_of(lhs, BK_TUPLE, Option(usize).None) => _bs_any_param_is_target(_bs_args(lhs)),
          ast_expr_is_capture_list_params(lhs) => {
            entries := match(lhs, .FnCall(_, cc, _, _, _) => _bs_args(cc), .Atom(_, _) => ArrayList(AstExpr).new());
            (hit : bool) = _bs_any_param_is_target(_bs_args(lhs));
            (ci : usize) = usize(0);
            while(!hit && (ci < entries.len()), ci = (ci + usize(1)), {
              en := match(entries.get(ci), .Some(x) => x, .None => make_err_expr());
              hit = cond(
                _bs_is_infix_of(en, BK_COLON) => (_bs_is_name(_bs_arg(en, usize(0))) && _bs_is_sigil(_bs_arg(en, usize(1)))),
                true => (_bs_is_sigil(en) && _bs_is_name(_bs_arg(en, usize(0))))
              );
            });
            hit
          },
          true => _bs_param_is_target(lhs)
        )
      },
      _bs_is_infix_of(e, BK_INIT_ASSIGN) => (_bs_is_name(_bs_arg(e, usize(0))) && _bs_is_sigil(_bs_arg(e, usize(1)))),
      _bs_is_infix_of(e, BK_ASSIGN) => (
        _bs_is_sigil(_bs_arg(e, usize(1))) && (_bs_is_name(_bs_arg(e, usize(0))) || (_bs_is_infix_of(_bs_arg(e, usize(0)), BK_COLON) && _bs_is_name(_bs_arg(_bs_arg(e, usize(0)), usize(0))) && _bs_is_sigil(_bs_arg(_bs_arg(e, usize(0)), usize(1)))))
      ),
      ast_expr_is_fn_call_of(e, "for", Option(usize).Some(usize(2))) => _bs_is_sigil(_bs_arg(e, usize(0))),
      true => false
    )
  )
);
/// One node's decision 42 rewrite, or `.None` when `e` spells no borrow in
/// a declaration slot. Only `e` itself is rewritten; `desugar_if_calls`
/// recurses into the result.
_borrow_spelling_rewrite :: (fn(imm(e) : AstExpr) -> Option(AstExpr))({
  // `fn(x : &T)`, `ctl(…)`, `Fn(…)`, `FnOnce(…)`: the parameters.
  if(_bs_is_param_list_head(e), {
    return(
      match(
        _bs_params(_bs_args(e)),
        .Some(np) => Option(AstExpr).Some(_bs_with_args(e, np)),
        .None => Option(AstExpr).None
      )
    );
  });
  // `(fn(…) -> &T)`, `-> (name : &mut T)`: the result slot.
  match(
    _bs_infix_pair(e, "->"),
    .Some(rp) => if(_bs_is_param_list_head(rp.lhs), {
      match(
        _borrow_sigil_of(rp.rhs),
        .Some(s) => return(Option(AstExpr).Some(_bs_with_operands(e, rp.lhs, _borrow_mode_call1(s.is_mut, s.inner, s.tok)))),
        .None => ()
      );
      match(
        _bs_param(rp.rhs),
        .Some(nr) => return(Option(AstExpr).Some(_bs_with_operands(e, rp.lhs, nr))),
        .None => ()
      );
      return(Option(AstExpr).None);
    }),
    .None => ()
  );
  // A closure literal's parameters and capture list.
  match(
    _bs_infix_pair(e, "=>"),
    .Some(ap) => return(
      match(
        _bs_closure_lhs(ap.lhs),
        .Some(nl) => Option(AstExpr).Some(_bs_with_operands(e, nl, ap.rhs)),
        .None => Option(AstExpr).None
      )
    ),
    .None => ()
  );
  // `y := &place` / `y := &mut place`: a local borrow (decision 18).
  match(
    _bs_infix_pair(e, BK_INIT_ASSIGN),
    .Some(ip) => return(
      cond(
        _bs_is_name(ip.lhs) => match(
          _borrow_sigil_of(ip.rhs),
          .Some(s) => Option(AstExpr).Some(_bs_with_operands(e, _borrow_mode_call1(s.is_mut, ip.lhs, s.tok), s.inner)),
          .None => Option(AstExpr).None
        ),
        true => Option(AstExpr).None
      )
    ),
    .None => ()
  );
  // `y = &place` / `cur = &mut place`: a re-point (decision 25); and the
  // annotated local borrow `(y : &T) = &place`.
  match(
    _bs_infix_pair(e, BK_ASSIGN),
    .Some(sp) => {
      rs := _borrow_sigil_of(sp.rhs);
      if(_bs_is_name(sp.lhs), {
        return(
          match(
            rs,
            .Some(s) => Option(AstExpr).Some(_bs_with_operands(e, _borrow_mode_call1(s.is_mut, sp.lhs, s.tok), s.inner)),
            .None => Option(AstExpr).None
          )
        );
      });
      match(
        _bs_infix_pair(sp.lhs, BK_COLON),
        .Some(ap) => if(_bs_is_name(ap.lhs), {
          match(
            _borrow_sigil_of(ap.rhs),
            .Some(ts) => match(
              rs,
              .Some(s) => if(s.is_mut == ts.is_mut, {
                ann := ArrayList(AstExpr).new();
                ann.push(ap.lhs);
                ann.push(ts.inner);
                bind_tok := _synth_desugar_tok(TokenKind.Operator, BK_INIT_ASSIGN, ast_expr_token(e));
                ops := ArrayList(AstExpr).new();
                ops.push(_borrow_mode_call(ts.is_mut, ann, ts.tok));
                ops.push(s.inner);
                return(Option(AstExpr).Some(AstExpr.FnCall(ast_expr_id(e), AstExpr.Atom(alloc_global_expr_id(), bind_tok), ops, true, bind_tok)));
              }),
              .None => ()
            ),
            .None => ()
          );
        }),
        .None => ()
      );
      return(Option(AstExpr).None);
    },
    .None => ()
  );
  // `for(&xs, …)` / `for(&mut xs, …)`: the borrowed `for`.
  if(ast_expr_is_fn_call_of(e, "for", Option(usize).Some(usize(2))), {
    fa := _bs_args(e);
    match(
      _borrow_sigil_of(match(fa.get(usize(0)), .Some(c) => c, .None => make_err_expr())),
      .Some(s) => {
        h := match(fa.get(usize(1)), .Some(x) => x, .None => make_err_expr());
        nfa := ArrayList(AstExpr).new();
        nfa.push(s.inner);
        nfa.push(cond(s.is_mut => _bs_mut_for_handle(h, s.tok), true => h));
        return(Option(AstExpr).Some(_bs_with_args(e, nfa)));
      },
      .None => ()
    );
  });
  Option(AstExpr).None
});
/// `match(&x, …)` or `match(&mut x, …)`: a scrutinee marked as a borrow
/// (decision 33), peeled by `desugar_if_calls`.
_is_borrowed_match_scrutinee :: (fn(imm(e) : AstExpr) -> bool)(
  ast_expr_is_fn_call_of(e, BK_MATCH, .None) && match(
    e,
    .FnCall(_, _, ms_args, _, _) => match(
      ms_args.get(usize(0)),
      .Some(s0) => (ast_expr_is_fn_call_of(s0, BK_BORROW_MUT, Option(usize).Some(usize(1))) || ast_expr_is_fn_call_of(s0, BF_ADDRESS_OF, Option(usize).Some(usize(1)))),
      .None => false
    ),
    .Atom(_, _) => false
  )
);
_contains_desugar_target :: (fn(imm(e) : AstExpr) -> bool)(
  match(
    e,
    .Atom(_, _) => false,
    .FnCall(_, func_box, args, _, _) => {
      if(ast_expr_is_fn_call_of(e, BK_QUOTE, .None), {
        return(false);
      });
      n_args := args.len();
      if(ast_expr_is_fn_call_of(e, "if", .None) && ((n_args == usize(2)) || (n_args == usize(3))), {
        return(true);
      });
      if(_is_extern_decl_call(e), {
        return(true);
      });
      if(_is_return_of_await(e), {
        return(true);
      });
      if(_is_borrowed_match_scrutinee(e), {
        return(true);
      });
      if(_is_borrow_spelling_target(e), {
        return(true);
      });
      if(recur(func_box), {
        return(true);
      });
      (ci : usize) = usize(0);
      while(ci < n_args, {
        match(
          args.get(ci),
          .Some(a) => if(recur(a), {
            return(true);
          }),
          .None => ()
        );
        ci = (ci + usize(1));
      });
      false
    }
  )
);
/// A `<recv>.await(...)` method call — `io.await(f, io)`, an effect bundle's
/// `e.io.await(f, e.io)`, `handle.await(io)`: the shapes the await analysis
/// recognises, matched syntactically (the parser has no types).
_is_await_method_call :: (fn(imm(e) : AstExpr) -> bool)(
  match(
    e,
    .Atom(_, _) => false,
    .FnCall(_, .FnCall(_, dot, dargs, is_infix, _), _, _, _) => (
      is_infix && (dargs.len() == usize(2)) &&
        match(dot, .Atom(_, dt) => (dt.kind == TokenKind.Dot), .FnCall(_, _, _, _, _) => false) && match(
          dargs.get(usize(1)),
          .Some(m) => ast_expr_is_atom_of(m, "await"),
          .None => false
        )
    ),
    .FnCall(_, _, _, _, _) => false
  )
);
/// `return(<recv>.await(...))`.
_is_return_of_await :: (fn(imm(e) : AstExpr) -> bool)({
  if(!ast_expr_is_fn_call_of(e, "return", Option(usize).Some(usize(1))), {
    return(false);
  });
  match(
    e,
    .FnCall(_, _, a, _, _) => match(a.get(usize(0)), .Some(arg) => _is_await_method_call(arg), .None => false),
    .Atom(_, _) => false
  )
});
/// A `c_include(...)` or `extern(...)` call — the two declaration forms that
/// evaluate to a MODULE VALUE (plans/reference/C_INCLUDE_EXTERN_MODULE_VALUE.md).
_is_extern_decl_call :: (fn(imm(e) : AstExpr) -> bool)(
  ast_expr_is_fn_call_of(e, BK_C_INCLUDE, .None) || ast_expr_is_fn_call_of(e, BK_EXTERN, .None)
);
/// Statement-position sugar: a bare `c_include(...)` / `extern(...)` statement
/// is `{ ... } :: c_include(...)` — the glob destructure of the module value it
/// evaluates to. The wrapper nodes get fresh ids; `decl` (already desugared
/// below it) keeps its own id, which is where the evaluator records the
/// module type and value. The synthesized tokens share the declaration's
/// position, so a no-shadowing error on one of the names points at the
/// declaration. The formatter never sees this: it works on the token stream.
_wrap_glob_destructure :: (fn(imm(decl) : AstExpr) -> AstExpr)({
  tok := ast_expr_token(decl);
  pat_args := ArrayList(AstExpr).new();
  pat_args.push(AstExpr.Atom(alloc_global_expr_id(), _synth_desugar_tok(TokenKind.Operator, "...", tok)));
  pat := AstExpr.FnCall(
    alloc_global_expr_id(),
    AstExpr.Atom(alloc_global_expr_id(), _synth_desugar_tok(TokenKind.Identifier, BK_ANON_STRUCT, tok)),
    pat_args,
    false,
    tok
  );
  bind_args := ArrayList(AstExpr).new();
  bind_args.push(pat);
  bind_args.push(decl);
  AstExpr.FnCall(
    alloc_global_expr_id(),
    AstExpr.Atom(alloc_global_expr_id(), _synth_desugar_tok(TokenKind.Operator, BK_CONST, tok)),
    bind_args,
    true,
    tok
  )
});
desugar_if_calls :: (fn(imm(e) : AstExpr) -> AstExpr)(
  match(
    e,
    .Atom(_, _) => e,
    .FnCall(id, func_box, args, is_infix, tok) => {
      if(ast_expr_is_fn_call_of(e, BK_QUOTE, .None), {
        return(e);
      });
      // COPY-ON-WRITE: an if-free subtree is returned UNCHANGED instead of
      // being reconstructed node by node (fresh ArrayList + FnCall + token
      // per node, for every module ever parsed). Paired with the token-
      // sharing fix in _synth_desugar_tok — the two together close the
      // v0.2.15 evaluator regression
      // (issues/desugar-token-clones-evaluator-regression.md).
      if(!_contains_desugar_target(e), {
        return(e);
      });
      // `&T` / `&mut T` in a declaration slot (decision 42, Generation A):
      // rewritten into the mode-word form, then desugared as usual.
      if(_is_borrow_spelling_target(e), {
        match(
          _borrow_spelling_rewrite(e),
          .Some(bs) => return(recur(bs)),
          .None => ()
        );
      });
      n_args := args.len();
      if(ast_expr_is_fn_call_of(e, "if", .None) && ((n_args == usize(2)) || (n_args == usize(3))), {
        cond_arg := match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr());
        then_opt := _unwrap_if_label(
          match(args.get(usize(1)), .Some(a) => a, .None => make_err_expr()),
          "then"
        );
        (else_opt : Option(AstExpr)) = Option(AstExpr).None;
        (labels_ok : bool) = then_opt.is_some();
        if(n_args == usize(3), {
          else_opt = _unwrap_if_label(
            match(args.get(usize(2)), .Some(a) => a, .None => make_err_expr()),
            "else"
          );
          labels_ok = (labels_ok && else_opt.is_some());
        });
        if(labels_ok, {
          then_expr := match(then_opt, .Some(t) => t, .None => make_err_expr());
          arrow1_args := ArrayList(AstExpr).new();
          arrow1_args.push(recur(cond_arg));
          arrow1_args.push(recur(then_expr));
          arrow1 := AstExpr.FnCall(
            alloc_global_expr_id(),
            AstExpr.Atom(alloc_global_expr_id(), _synth_desugar_tok(TokenKind.Operator, "=>", tok)),
            arrow1_args,
            true,
            tok
          );
          else_expr := match(
            else_opt,
            .Some(ee) => recur(ee),
            .None => {
              unit_tok := _synth_desugar_tok(TokenKind.Identifier, BK_TUPLE, tok);
              AstExpr.FnCall(
                alloc_global_expr_id(),
                AstExpr.Atom(alloc_global_expr_id(), unit_tok),
                ArrayList(AstExpr).new(),
                false,
                unit_tok
              )
            }
          );
          arrow2_args := ArrayList(AstExpr).new();
          arrow2_args.push(AstExpr.Atom(alloc_global_expr_id(), _synth_desugar_tok(TokenKind.Bool, "true", tok)));
          arrow2_args.push(else_expr);
          arrow2 := AstExpr.FnCall(
            alloc_global_expr_id(),
            AstExpr.Atom(alloc_global_expr_id(), _synth_desugar_tok(TokenKind.Operator, "=>", tok)),
            arrow2_args,
            true,
            tok
          );
          cond_args := ArrayList(AstExpr).new();
          cond_args.push(arrow1);
          cond_args.push(arrow2);
          return(
            AstExpr.FnCall(
              id,
              AstExpr.Atom(alloc_global_expr_id(), _synth_desugar_tok(TokenKind.Identifier, BK_COND, tok)),
              cond_args,
              false,
              tok
            )
          );
        });
      });
      // `return(x.await(...))` → `begin(t := x.await(...), return(t))`. The two
      // mean the same thing everywhere. The segment lowering could only split
      // at the second form (issues/fixed/return-of-an-await-is-rejected-inside-io-async.md);
      // the single-pass lowering suspends in either, and the rewrite is kept
      // as an equivalence. The temp is a compiler-minted `__yo_` name, unique
      // per node.
      if(_is_return_of_await(e), {
        awaited := recur(match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr()));
        tmp_name := String.from("__yo_return_await_");
        tmp_name.push_string(alloc_global_expr_id().to_string());
        bind_args := ArrayList(AstExpr).new();
        bind_args.push(AstExpr.Atom(alloc_global_expr_id(), _synth_desugar_tok_s(TokenKind.Identifier, tmp_name.clone(), tok)));
        bind_args.push(awaited);
        bind := AstExpr.FnCall(
          alloc_global_expr_id(),
          AstExpr.Atom(alloc_global_expr_id(), _synth_desugar_tok(TokenKind.Operator, BK_INIT_ASSIGN, tok)),
          bind_args,
          true,
          tok
        );
        ret_args := ArrayList(AstExpr).new();
        ret_args.push(AstExpr.Atom(alloc_global_expr_id(), _synth_desugar_tok_s(TokenKind.Identifier, tmp_name, tok)));
        ret := AstExpr.FnCall(id, func_box, ret_args, is_infix, tok);
        block_args := ArrayList(AstExpr).new();
        block_args.push(bind);
        block_args.push(ret);
        return(
          AstExpr.FnCall(
            alloc_global_expr_id(),
            AstExpr.Atom(alloc_global_expr_id(), _synth_desugar_tok(TokenKind.Identifier, BK_BEGIN, tok)),
            block_args,
            false,
            tok
          )
        );
      });
      // `match(&x, …)` / `match(&mut x, …)` → `match(x, …)`, with the marker
      // recorded in `g_borrowed_match_sites` (plans/VALUES_BY_DEFAULT.md
      // decisions 26 and 33): a plain scrutinee is taken by value, `&x`
      // matches through an `imm` borrow and `&mut x` binds `mut` places, and
      // the evaluator reads which one from the table. No program matches on
      // a raw pointer `&x` (the address-of is `addr_of(x)`), so peeling is
      // unambiguous.
      if(_is_borrowed_match_scrutinee(e), {
        bm_kind := match(args.get(usize(0)), .Some(s0) => if(ast_expr_is_fn_call_of(s0, BK_BORROW_MUT, Option(usize).Some(usize(1))), u8(2), u8(1)), .None => u8(1));
        _bm_old := g_borrowed_match_sites.insert(_borrowed_match_site_key(tok), bm_kind);
        bm_args := ArrayList(AstExpr).new();
        (bm_i : usize) = usize(0);
        while(bm_i < n_args, {
          match(
            args.get(bm_i),
            .Some(a) => {
              bm_args.push(recur(if(bm_i == usize(0), ast_expr_strip_borrow_marker(a), a)));
            },
            .None => ()
          );
          bm_i = (bm_i + usize(1));
        });
        return(AstExpr.FnCall(id, recur(func_box), bm_args, is_infix, tok));
      });
      // Every argument of a `begin` block is a statement: a bare
      // `c_include(...)` / `extern(...)` there is the glob-destructure sugar.
      is_begin := ast_expr_is_fn_call_of(e, BK_BEGIN, .None);
      new_args := ArrayList(AstExpr).new();
      (di : usize) = usize(0);
      dn := args.len();
      while(di < dn, {
        match(
          args.get(di),
          .Some(a) => {
            da := recur(a);
            new_args.push(if(is_begin && _is_extern_decl_call(a), _wrap_glob_destructure(da), da));
          },
          .None => ()
        );
        di = (di + usize(1));
      });
      AstExpr.FnCall(id, recur(func_box), new_args, is_infix, tok)
    }
  )
);
/// Desugar every top-level statement of a freshly parsed program: `if` →
/// `cond` throughout, `return(x.await(...))` → `begin(t := x.await(...),
/// return(t))`, and a bare `c_include(...)` / `extern(...)` statement → its
/// glob destructure. Returns a new statement list (ArrayList has no
/// in-place `set`).
desugar_program_if_calls :: (fn(imm(program) : ArrayList(AstExpr)) -> ArrayList(AstExpr))({
  out := ArrayList(AstExpr).new();
  (pi : usize) = usize(0);
  pn := program.len();
  while(pi < pn, {
    match(
      program.get(pi),
      .Some(s) => {
        ds := desugar_if_calls(s);
        out.push(if(_is_extern_decl_call(s), _wrap_glob_destructure(ds), ds));
      },
      .None => ()
    );
    pi = (pi + usize(1));
  });
  out
});
export(ast_expr_is_atom_of, ast_expr_is_atom_of_any);
export(ast_expr_is_fn_call_of, ast_expr_is_fn_call_of_any);
export(ast_expr_is_size_of_call, ast_expr_is_align_of_call, ast_expr_is_type_of_call, ast_expr_is_type_id_call, ast_expr_is_address_of_call, ast_expr_is_inout_mode_call, ast_expr_is_old_mode_spelling, old_mode_spelling_message, ast_place_text, ast_expr_strip_borrow_marker, ast_expr_is_capture_mode_entry, ast_expr_is_capture_list_params, ast_expr_is_local_borrow_mode_call);
export(desugar_if_calls, desugar_program_if_calls, borrow_mode_not_a_type_message);
export(exprs_are_equal);
export(expect_expr_to_be_fn_call_of, expect_expr_to_be_fn_call_of_any);
export(is_function_boundary_arrow);
export(alloc_global_expr_id, next_global_expr_id, clone_expr_fresh_ids, cloned_expr_node_count);
/// Wrap `body` in a synthetic `begin(body)` call when it is not already a
/// `begin(...)` node. The wrap gives even a bare-atom body the begin
/// machinery — in particular the begin-tail ownership pass, so a
/// borrowed-param tail like `to_string : (...)(self)` receives its balancing
/// ___dup. Def-time trials route through the expression DISPATCHER (a direct
/// begin.yo import from values/ would close an import cycle), so the wrap
/// happens here at the AST level; a curly body is already a begin call and
/// passes through untouched.
wrap_body_in_begin :: (fn(imm(body) : AstExpr) -> AstExpr)({
  // Narrow to bare-ATOM and bare FIELD-ACCESS (2-arg `.`) bodies: a curly
  // body IS a begin; a general call body's result flows through the call's
  // ExprInfo, and wrapping closure call bodies perturbed the async closure
  // result-refine pipeline (io_async corpus). But an atom tail
  // (`(...)(self)`) AND a bare field-access tail (`(fn(p : Pair) ->
  // Krate)(p.inner)`) both return a BORROWED value and miss the begin-tail
  // ownership pass without the wrap — the field case emitted no balancing
  // ___dup, so the caller's scope drop over-dropped the field (round-3
  // borrowed-field-tail UAF). Method-call bodies (`x.f()`) are NOT
  // 2-arg dot calls (their func is the dot) and stay unwrapped.
  is_bare_field_access := ast_expr_is_fn_call_of(body, BF_DOT, Option(usize).Some(usize(2)));
  if(!(ast_expr_is_atom(body) || is_bare_field_access), {
    return(body);
  });
  tok := ast_expr_token(body);
  begin_tok := Token(
    kind : TokenKind.Identifier,
    value : intern_token_str(String.from(BK_BEGIN)),
    row : tok.row,
    column : tok.column,
    character : tok.character,
    byte_offset : tok.byte_offset,
    module_path : tok.module_path,
    input : tok.input
  );
  args := ArrayList(AstExpr).new();
  args.push(body);
  AstExpr.FnCall(alloc_global_expr_id(), AstExpr.Atom(alloc_global_expr_id(), begin_tok.clone()), args, false, begin_tok)
});
export(wrap_body_in_begin);
