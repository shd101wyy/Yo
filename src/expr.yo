/// Phase A of plans/reference/MEMORY_SAFETY.md — the `unsafe(expr)` builtin
/// marks an expression whose raw-pointer operations are permitted.
BF_UNSAFE :: "unsafe";
/// Phase C of plans/reference/MEMORY_SAFETY.md — the `pragma(Pragma.X);`
/// builtin records a file-level flag (e.g. AllowUnsafe, SkipPrelude,
/// SkipWasm*). The pre-scan looks for `Pragma.SkipPrelude`
/// before the prelude loads.
BF_PRAGMA :: "pragma";
BF_DROP :: "___drop";
BF_DUP :: "___dup";
BF_VA_START :: "va_start";
/// Phase 0 of plans/backlog/FORMAL_VERIFICATION.md — contract builtins. Evaluated as
/// no-op markers (their args are evaluated; the call returns `unit`).
/// `requires`/`ensures` in a function SIGNATURE are extracted + lowered to
/// runtime asserts by the function-type evaluator; these handlers fire when the
/// builtins appear in EXPRESSION position. `ghost_fn`/`old` are transparent
/// pass-throughs.
BF_REQUIRES :: "requires";
BF_ENSURES :: "ensures";
BF_INVARIANT :: "invariant";
BF_DECREASES :: "decreases";
/// V6 task 5 (FORMAL_VERIFICATION.md): the zero-argument signature marker
/// `assumed()` — declares that this function's BODY is outside the
/// verifiable subset (raw pointers, allocator calls) while its CONTRACTS
/// (requires/ensures/decreases, at least one required) still gate callers.
/// The verifier reports the fn as `assumed` instead of walking the body.
BF_ASSUMED :: "assumed";
/// B1 (plans/backlog/BEND_LAWS_AND_AGENT_LOOP_LESSONS.md §A2): `law(fn-type)` —
/// a standalone CLAIM. One argument, a function TYPE carrying `requires` /
/// `ensures` and NO body; its `ensures` predicates are obligations the verifier
/// must discharge, its `requires` are assumed on entry. Evaluates to `unit`, so
/// `name :: law(...)` binds unit and codegen emits nothing. This is how a
/// specification states a property about code it does not live in.
BF_LAW :: "law";
/// V6 task 3 (FORMAL_VERIFICATION.md §7): the refinement annotation
/// `refine(T, p)` — evaluates to `T` (the erasure rule; zero runtime
/// cost) while recording `p` in the annotation registry; the verifier
/// discharges it (assumed at the callee entry, proved as `refine#N` at
/// call sites).
BF_REFINE :: "refine";
BF_GHOST :: "ghost";
BF_GHOST_FN :: "ghost_fn";
BF_OLD :: "old";
/// V5 ghost-only builtins (plans/backlog/FORMAL_VERIFICATION.md §6):
/// well-formed only inside ghost context (contract clauses, ghost
/// bindings, ghost_fn bodies) — they have no runtime semantics.
BF_FORALL :: "forall";
BF_EXISTS :: "exists";
BF_IMPLIES :: "==>";
