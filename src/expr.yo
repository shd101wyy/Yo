//! AST (Abstract Syntax Tree) node types for the Yo parser.
//! The Yo AST uses only two node kinds: Atom and FnCall.
//!
//! Note: Named `AstExpr` (not `Expr`) to avoid conflict with the prelude's builtin `Expr` type.
pragma(Pragma.AllowUnsafe);
{ String, StringBuilder } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TokenKind, Token, intern_token_str } :: import("./token.yo");
{ format_error_message } :: import("./error.yo");
{ Exception } :: import("std/error");
/// The borrow marker each `match(&x, …)` / `match(&mut x, …)` was written
/// with (plans/VALUES_BY_DEFAULT.md decisions 26 and 33): 1 for `&`, 2 for
/// `&mut`. The desugar peels the marker so every consumer of the tree reads a
/// plain scrutinee; the evaluator asks this table how the match takes it.
/// Keyed by the `match` call's token position, which a rebuilt or cloned node
/// keeps (`clone_expr_fresh_ids` mints new ids, so an id key would lose the
/// marker in every generic specialization).
(g_borrowed_match_sites : HashMap(String, u8)) = HashMap(String, u8).new();
_borrowed_match_site_key :: (fn(imm(tok) : Token) -> String)(`${tok.module_path}:${tok.byte_offset}`);
/// 0 when the `match` at `tok` was written with a plain scrutinee, 1 for
/// `match(&x, …)`, 2 for `match(&mut x, …)`.
borrowed_match_scrutinee_kind :: (fn(imm(tok) : Token) -> u8)(
  cond(
    (g_borrowed_match_sites.len() == usize(0)) => u8(0),
    true => match(g_borrowed_match_sites.get(_borrowed_match_site_key(tok)), .Some(k) => k, .None => u8(0))
  )
);
export(borrowed_match_scrutinee_kind);
