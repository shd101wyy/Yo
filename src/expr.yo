BF_SEQ_APPEND :: "seq_append";
BF_SEQ_LEN :: "seq_len";
BF_SEQ_NTH :: "seq_nth";
/// `seq_of(xs)`: an `ArrayList(T)`'s elements as a ghost Seq (R2 task 2).
BF_SEQ_OF :: "seq_of";
/// `produced(xs)`: inside a `for` over the list `xs`, the elements consumed
