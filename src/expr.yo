/// The V3b parameter modes (plans/VALUES_BY_DEFAULT.md decision 30).
/// Generation A: `mut(x) : T` and `mut(y) := place` are exact synonyms of
/// `inout(...)`, and `imm(x) : T` is a plain (borrowing) parameter.
BK_MUT :: "mut";
BK_IMM :: "imm";
/// The call-site `&mut x` marker (decision 33): ONE prefix token, lexed by
/// `tokenize` when `&` is directly followed by the word `mut`.
BK_BORROW_MUT :: "&mut";
/// A stable identifier for an AST expression node. Assigned during parsing.
ExprId :: usize;
/// An AST expression node. There are exactly two kinds:
///  - Atom: a single token (identifier, literal, operator, dot, …)
///  - FnCall: a function call with a func expression, args list, infix flag, and token
AstExpr :: ref(
  enum(
    Atom(id : ExprId, token : Token),
    FnCall(id : ExprId, func : Self, args : ArrayList(Self), is_infix : bool, token : Token)
  )
);
// SHARE-on-recursion Clone (replaces `derive(AstExpr, Clone)`). `AstExpr` is now
// a `ref(enum)`, so its `func` (a `Self` handle) and `args` (`ArrayList(Self)`)
// fields are RC handles — cloning SHARES them (RC-bump) rather than deep-copying.
// This is O(1), preserves node ids (matching the derived clone's id-keeping
// semantics that the ExprInfo table relies on), and avoids the def-time
// body-eval infinite recursion a deep clone hits on a shell-less recursive
// ref-enum (`ArrayList(Self).clone` → `elem.clone` → here). Same rationale as the
// manual `TypeValue` clone in `types/definitions.yo`. Use `clone_expr_fresh_ids`
// (below) when fresh ids are needed.
impl(
  AstExpr,
  Clone(
    clone : (fn(mut(self) : Self) -> Self)(
      match(
        self,
        .Atom(aid, atok) => AstExpr.Atom(aid, atok.clone()),
        .FnCall(fid, ffunc, fargs, finfix, ftok) => AstExpr.FnCall(fid, ffunc, fargs, finfix, ftok.clone())
      )
    )
  )
);
/// Global expression-id counter — moved here from parser.yo so SYNTHESIZED
/// nodes (gensym, quote expansions, fresh-id clones below) can mint ids
/// from the SAME sequence as parsed nodes. The ExprInfo table is keyed by
/// this id — every distinct evaluated node MUST have a distinct id or table
/// writes drop values other holders still use.
///
/// Starts at 1: id 0 is `make_err_expr`'s, the node every swallowing
/// evaluation returns, and a caller tests "the evaluation failed" by that
/// node having no ExprInfo. When the first parsed node was also id 0, `compile`
/// (one ExprInfoTable shared by the prelude and every module) found the
/// prelude's first node's info there, and reported a derived error instead of
/// the swallowed cause
/// (issues/fixed/compile-reports-a-derived-error-instead-of-the-safe-code-raw-pointer-rejection.md).
(g_next_global_expr_id : usize) = usize(1);
/// Mint a fresh ExprId (parser nodes and synthesized nodes share the
/// sequence).
alloc_global_expr_id :: (fn() -> ExprId)({
  id := g_next_global_expr_id;
  g_next_global_expr_id = (g_next_global_expr_id + usize(1));
  id
});
/// The id the next `alloc_global_expr_id` will return. `clone_expr_fresh_ids`
/// mints one id per node, consecutively, so reading this before and after a
/// clone brackets exactly the ids that clone made (`purge_expr_infos_in_id_range`).
next_global_expr_id :: (fn() -> ExprId)(g_next_global_expr_id);
/// Deep-clone an expression giving every node a FRESH id. The derived
/// `AstExpr` Clone keeps ids, so a
/// derived-clone + evaluate writes the ORIGINAL tree's ExprInfo entries
/// (and id-0 synthesized nodes all collide); use THIS for trial dry-runs,
/// macro templates/expansions, and quoted-argument binding.
/// Nodes minted by `clone_expr_fresh_ids` so far — the size of the
/// specialization / trial-clone population (`YO_SPEC_REPORT=1`,
/// plans/EVALUATOR_MEMORY_REDUCTION.md Phase 0 step 4).
(g_cloned_expr_nodes : usize) = usize(0);
cloned_expr_node_count :: (fn() -> usize)(g_cloned_expr_nodes);
clone_expr_fresh_ids :: (fn(imm(e) : AstExpr) -> AstExpr)({
  g_cloned_expr_nodes = (g_cloned_expr_nodes + usize(1));
  match(
    e,
    .Atom(_, tok) => AstExpr.Atom(alloc_global_expr_id(), tok.clone()),
    .FnCall(_, func_box, args, is_infix, tok) => {
      new_args := ArrayList(AstExpr).new();
      (ci : usize) = usize(0);
      n := args.len();
      while(ci < n, {
        match(
          args.get(ci),
          .Some(a) => {
            new_args.push(recur(a));
          },
          .None => ()
        );
        ci = (ci + usize(1));
      });
      AstExpr.FnCall(alloc_global_expr_id(), recur(func_box), new_args, is_infix, tok.clone())
    }
  )
});
/// Build a placeholder Atom expression used as a fallback in error paths.
make_err_expr :: (fn() -> AstExpr)(
  .Atom(
    usize(0),
    Token(
      kind : TokenKind.Identifier,
      value : String.from("?"),
      row : u32(0),
      column : u32(0),
      character : u32(0),
      module_path : String.from(""),
      input : String.from("")
    )
  )
);
/// Return the representative token of an expression (used for error reporting).
ast_expr_token :: (fn(imm(e) : AstExpr) -> Token)(
  match(
    e,
    .Atom(_, tok) => tok,
    .FnCall(_, _, _, _, tok) => tok
  )
);
/// Return the stable ExprId of an expression node.
ast_expr_id :: (fn(imm(e) : AstExpr) -> ExprId)(
  match(
    e,
    .Atom(id, _) => id,
    .FnCall(id, _, _, _, _) => id
  )
);
/// True if `e` is an Atom.
ast_expr_is_atom :: (fn(imm(e) : AstExpr) -> bool)(
  match(
    e,
    .Atom(_, _) => true,
    .FnCall(_, _, _, _, _) => false
  )
);
/// True if `e` is a FnCall.
ast_expr_is_fn_call :: (fn(imm(e) : AstExpr) -> bool)(
  match(
    e,
    .Atom(_, _) => false,
    .FnCall(_, _, _, _, _) => true
  )
);
/// True if `e` is an Atom whose token is an Operator.
ast_expr_is_atom_and_operator :: (fn(imm(e) : AstExpr) -> bool)(
  match(
    e,
    .Atom(_, tok) => (tok.kind == TokenKind.Operator),
    .FnCall(_, _, _, _, _) => false
  )
);
/// True if `e` is an infix FnCall with an Operator func and exactly 2 args.
ast_expr_is_infix_op_fn_call :: (fn(imm(e) : AstExpr) -> bool)(
  match(
    e,
    .Atom(_, _) => false,
    .FnCall(_, func_box, args, is_infix, _) => cond(
      (is_infix == false) => false,
      (args.len() != usize(2)) => false,
      true => match(
        func_box,
        .Atom(_, ftok) => (ftok.kind == TokenKind.Operator),
        .FnCall(_, _, _, _, _) => false
      )
    )
  )
);
/// Convert an expression to a compact string representation (for debugging/error messages).
ast_expr_to_string :: (fn(imm(e) : AstExpr) -> String)(
  match(
    e,
    .Atom(_, tok) => tok.value,
    .FnCall(_, func_box, args, is_infix, _) => {
      n := args.len();
      func_is_op_or_dot := match(
        func_box,
        .Atom(_, ftok) => ((ftok.kind == TokenKind.Operator) || (ftok.kind == TokenKind.Dot)),
        .FnCall(_, _, _, _, _) => false
      );
      func_is_tuple_kw := match(
        func_box,
        .Atom(_, ftok) => (ftok.value == BK_TUPLE),
        .FnCall(_, _, _, _, _) => false
      );
      cond(
        func_is_op_or_dot => {
          func_tok_val := match(
            func_box,
            .Atom(_, ftok) => ftok.value,
            .FnCall(_, _, _, _, _) => String.from("?")
          );
          cond(
            (n == usize(1)) => {
              arg0_str := recur(match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr()));
              is_fc := ast_expr_is_fn_call(match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr()));
              cond(
                (func_tok_val == ".") => cond(
                  is_fc => `${func_tok_val}(${arg0_str})`,
                  true => `${func_tok_val}${arg0_str}`
                ),
                true => `${func_tok_val}(${arg0_str})`
              )
            },
            ((n == usize(2)) && is_infix) => {
              lhs0 := recur(match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr()));
              rhs0 := recur(match(args.get(usize(1)), .Some(a) => a, .None => make_err_expr()));
              lhs := cond(
                (ast_expr_is_infix_op_fn_call(match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr())) || ast_expr_is_atom_and_operator(match(args.get(usize(0)), .Some(a) => a, .None => make_err_expr()))) => `(${lhs0})`,
                true => lhs0
              );
              rhs := cond(
                (ast_expr_is_infix_op_fn_call(match(args.get(usize(1)), .Some(a) => a, .None => make_err_expr())) || ast_expr_is_atom_and_operator(match(args.get(usize(1)), .Some(a) => a, .None => make_err_expr()))) => `(${rhs0})`,
                true => rhs0
              );
              cond(
                (func_tok_val == ".") => {
                  rhs_final := cond(
                    ast_expr_is_fn_call(match(args.get(usize(1)), .Some(a) => a, .None => make_err_expr())) => `(${rhs})`,
                    true => rhs
                  );
                  `(${lhs}.${rhs_final})`
                },
                true => `${lhs} ${func_tok_val} ${rhs}`
              )
            },
            true => {
              func_str := recur(func_box);
              sb := StringBuilder.new();
              i := usize(0);
              while(i < n, {
                if(i > usize(0), {
                  sb.write_str(", ");
                });
                arg := match(args.get(i), .Some(a) => a, .None => make_err_expr());
                sb.write_string(recur(arg));
                i = (i + usize(1));
              });
              `${func_str}(${sb.to_string()})`
            }
          )
        },
        func_is_tuple_kw => {
          sb := StringBuilder.new();
          i := usize(0);
          while(i < n, {
            if(i > usize(0), {
              sb.write_str(", ");
            });
            arg := match(args.get(i), .Some(a) => a, .None => make_err_expr());
            sb.write_string(recur(arg));
            i = (i + usize(1));
          });
          args_str := sb.to_string();
          cond(
            (n == usize(1)) => `(${args_str},)`,
            true => `(${args_str})`
          )
        },
        true => {
          // General function call
          func_str0 := recur(func_box);
          func_str := cond(
            (ast_expr_is_infix_op_fn_call(func_box) || ast_expr_is_atom_and_operator(func_box)) => `(${func_str0})`,
            true => func_str0
          );
          // A `match(&x, …)` the desugar peeled prints with its marker.
          scr_marker := cond(
            (func_str0 == BK_MATCH) => borrowed_match_scrutinee_kind(match(e, .FnCall(_, _, _, _, mtok) => mtok, .Atom(_, atok) => atok)),
            true => u8(0)
          );
          sb := StringBuilder.new();
          i := usize(0);
          while(i < n, {
            if(i > usize(0), {
              sb.write_str(", ");
            });
            if((i == usize(0)) && (scr_marker == u8(1)), {
              sb.write_str("&");
            });
            if((i == usize(0)) && (scr_marker == u8(2)), {
              sb.write_str("&mut ");
            });
            arg := match(args.get(i), .Some(a) => a, .None => make_err_expr());
            sb.write_string(recur(arg));
            i = (i + usize(1));
          });
          `${func_str}(${sb.to_string()})`
        }
      )
    }
  )
);
export(AstExpr, ExprId, BK_TUPLE, BK_TUPLE_TYPE, BK_ARRAY, BK_ARRAY_VAL, BK_BEGIN, BK_IMPORT, BK_ANON_STRUCT, BK_EXPORT);
export(BF_RUNTIME, BF_UNWIND, BF_RECUR, BF_DOT);
export(BF_SIZE_OF, BF_ALIGN_OF, BF_TYPE_OF, BF_TYPE_ID, BF_ADDR_OF, BK_MUT, BK_IMM, BK_BORROW_MUT);
export(BK_COMPTIME, BK_GIVEN, BK_GENERIC, BK_COLON, BK_ASSIGN, BK_INIT_ASSIGN, BK_CONST, BK_COND, BK_MATCH, BK_THREAD_LOCAL);
export(BK_WHILE, BK_RETURN, BK_BREAK, BK_TEST);
export(BK_EXTERN, BK_C_INCLUDE, BK_SUBTYPE_OF, BK_WHERE);
export(make_err_expr, ast_expr_token, ast_expr_id, ast_expr_is_atom, ast_expr_is_fn_call, ast_expr_is_atom_and_operator, ast_expr_is_infix_op_fn_call, ast_expr_to_string);
// ---------------------------------------------------------------------------
// Atom / FnCall predicate helpers
// ---------------------------------------------------------------------------
/// True if `e` is an Atom whose token value equals `value`.
ast_expr_is_atom_of :: (fn(imm(e) : AstExpr, value : str) -> bool)(
  match(
    e,
    .Atom(_, tok) => (tok.value == value),
    .FnCall(_, _, _, _, _) => false
  )
);
/// True if `e` is an Atom whose token value is found in `values`.
ast_expr_is_atom_of_any :: (fn(imm(e) : AstExpr, imm(values) : ArrayList(str)) -> bool)(
  match(
    e,
    .Atom(_, tok) => {
      n := values.len();
      i := usize(0);
      while(i < n, {
        v := match(values.get(i), .Some(s) => s, .None => "~unreachable~");
        if(tok.value == v, {
          return(true);
        });
        i = (i + usize(1));
      });
      false
    },
    .FnCall(_, _, _, _, _) => false
  )
);
/// True if `e` is a FnCall whose func is an Atom equal to `func_name`,
/// and whose argument count equals `arg_count` (if `.Some`).
ast_expr_is_fn_call_of :: (fn(imm(e) : AstExpr, func_name : str, arg_count : Option(usize)) -> bool)(
  match(
    e,
    .Atom(_, _) => false,
    .FnCall(_, func_box, args, _, _) => {
      func_name_matches := match(
        func_box,
        .Atom(_, tok) => (tok.value == func_name),
        .FnCall(_, _, _, _, _) => false
      );
      if(!func_name_matches, {
        return(false);
      });
      count_ok := match(
        arg_count,
        .None => true,
        .Some(n) => (args.len() == n)
      );
      count_ok
    }
  )
);
/// `sizeof(T)` or its snake_case synonym `size_of(T)` (V3b Generation A).
ast_expr_is_size_of_call :: (fn(imm(e) : AstExpr, arg_count : Option(usize)) -> bool)(
  ast_expr_is_fn_call_of(e, BF_SIZE_OF, arg_count)
);
/// `alignof(T)` or `align_of(T)` (V3b Generation A).
ast_expr_is_align_of_call :: (fn(imm(e) : AstExpr, arg_count : Option(usize)) -> bool)(
  ast_expr_is_fn_call_of(e, BF_ALIGN_OF, arg_count)
);
/// `typeof(x)` or `type_of(x)` (V3b Generation A).
ast_expr_is_type_of_call :: (fn(imm(e) : AstExpr, arg_count : Option(usize)) -> bool)(
  ast_expr_is_fn_call_of(e, BF_TYPE_OF, arg_count)
);
/// `typeid(T)` or `type_id(T)` (V3b Generation A).
ast_expr_is_type_id_call :: (fn(imm(e) : AstExpr, arg_count : Option(usize)) -> bool)(
  ast_expr_is_fn_call_of(e, BF_TYPE_ID, arg_count)
);
/// The raw-pointer address-of: `&x` or `addr_of(x)` (decision 33).
ast_expr_is_address_of_call :: (fn(imm(e) : AstExpr, arg_count : Option(usize)) -> bool)(
  ast_expr_is_fn_call_of(e, BF_ADDRESS_OF, arg_count) || ast_expr_is_fn_call_of(e, BF_ADDR_OF, arg_count)
);
/// An exclusive-borrow wrapper on a parameter label or a local binding:
/// `mut(x)` (decision 30). Its old spelling `inout(x)` is not one: V3b
/// Generation B step 3 deleted it, and `ast_expr_is_old_mode_spelling` names
/// it for the error.
ast_expr_is_inout_mode_call :: (fn(imm(e) : AstExpr, arg_count : Option(usize)) -> bool)(
  ast_expr_is_fn_call_of(e, BK_MUT, arg_count)
);
/// A deleted parameter-mode spelling with one argument: `inout(x)` (now
/// `mut(x)`) or `own(x)` (now `sink(x)`). Returns the replacement word, or
/// `.None`. An `asm(...)` operand's `inout(reg, v)` has two arguments and is
/// not one.
ast_expr_is_old_mode_spelling :: (fn(imm(e) : AstExpr) -> Option(String))(
  cond(
    ast_expr_is_fn_call_of(e, BK_INOUT, Option(usize).Some(usize(1))) => Option(String).Some(String.from("mut")),
    ast_expr_is_fn_call_of(e, BK_OWN, Option(usize).Some(usize(1))) => Option(String).Some(String.from("sink")),
    true => Option(String).None
  )
);
/// The error for a deleted mode spelling (see `ast_expr_is_old_mode_spelling`):
/// `old` is the word written, `new_word` its replacement.
old_mode_spelling_message :: (fn(imm(old) : String, imm(new_word) : String) -> String)(
  cond(
    (new_word == "mut") => `\`${old}(x)\` was deleted: an exclusive borrow is spelled \`x : &mut T\` (a local one \`y := &mut place\`, the borrowed loop \`for(&mut xs, x => ...)\`) (plans/VALUES_BY_DEFAULT.md decision 42). \`yo fix <path> --migrate borrow-spelling\` rewrites it.`,
    true => `\`${old}(x)\` is spelled \`${new_word}(x)\`: the \`${old}\` spelling was deleted (plans/VALUES_BY_DEFAULT.md V3b). \`yo fix <path> --migrate modes\` rewrites it.`
  )
);
/// The error for a borrow sigil applied to a TYPE outside the slots that
/// hold one (`T :: &i32`, `ArrayList(&T)`, a field `f : &T`, `&&T`): in
/// Generation A of decision 42 a borrow is a mode a slot spells, not a type
/// (decision 43 makes it one). `ty` is the type as written, `is_mut` picks
/// `&mut`.
borrow_mode_not_a_type_message :: (fn(imm(ty) : String, is_mut : bool) -> String)({
  sig := if(is_mut, String.from("&mut "), String.from("&"));
  `\`${sig}${ty}\` is a borrow mode, not a type: it is written on a parameter (\`x : ${sig}${ty}\`), a closure or \`Fn(...)\` parameter, a receiver (\`self : ${sig}Self\`) or a local borrow (\`(y : ${sig}${ty}) = ${sig}place\`), and cannot name a type, be a type argument or a field's type (plans/VALUES_BY_DEFAULT.md decision 42; references become types with decision 43).`
});
/// A capture-list borrow entry's left side, `imm(y)` or `mut(z)`: a prefix
/// call of the mode word with one identifier (plans/VALUES_BY_DEFAULT.md
/// decision 35). In a `{ … }` record it is a pun (`imm(y)` is
/// `imm(y) : &y`) or, as the label of `:`, a renamed borrow
/// (`imm(name) : &self.name`).
ast_expr_is_capture_mode_entry :: (fn(imm(e) : AstExpr) -> bool)(
  (ast_expr_is_fn_call_of(e, BK_IMM, Option(usize).Some(usize(1))) || ast_expr_is_fn_call_of(e, BK_MUT, Option(usize).Some(usize(1)))) && match(
    e,
    .FnCall(_, _, ce_args, ce_infix, _) => (!ce_infix && match(ce_args.get(usize(0)), .Some(a) => ast_expr_is_atom(a), .None => false)),
    .Atom(_, _) => false
  )
);
/// A closure literal with a capture list, `{ x, imm(y) }(params) => body`:
/// the parser's `{…}` → `_(…)` desugar makes the arrow's left side a call
/// whose callee is the `_(…)` record literal (decision 35). `lhs` is the
/// arrow's left operand.
ast_expr_is_capture_list_params :: (fn(imm(lhs) : AstExpr) -> bool)(
  match(
    lhs,
    .FnCall(_, cl_callee, _, cl_infix, _) => (!cl_infix && ast_expr_is_fn_call_of(cl_callee, BK_ANON_STRUCT, .None)),
    .Atom(_, _) => false
  )
);

/// The mode wrapper of a LOCAL borrow binding or re-point (decisions 18 and
/// 25): `imm(y)` or `mut(y)`, on the left of `:=` or `=`. `y := &place` and
/// `y := &mut place` are rewritten to it at parse time (decision 42), and the
/// annotated `(y : &T) = &place` to `imm(y, T) := place`: so an `arg_count` of
/// one also accepts that second, annotation argument, and every reader of the
/// bound name keeps reading argument 0.
ast_expr_is_local_borrow_mode_call :: (fn(imm(e) : AstExpr, arg_count : Option(usize)) -> bool)({
  n_ok := match(
    arg_count,
    .Some(n) => cond(
      (n == usize(1)) => (ast_expr_is_fn_call_of(e, BK_MUT, Option(usize).Some(usize(1))) || ast_expr_is_fn_call_of(e, BK_IMM, Option(usize).Some(usize(1))) || ast_expr_is_fn_call_of(e, BK_MUT, Option(usize).Some(usize(2))) || ast_expr_is_fn_call_of(e, BK_IMM, Option(usize).Some(usize(2)))),
      true => (ast_expr_is_inout_mode_call(e, arg_count) || ast_expr_is_fn_call_of(e, BK_IMM, arg_count))
    ),
    .None => (ast_expr_is_inout_mode_call(e, arg_count) || ast_expr_is_fn_call_of(e, BK_IMM, arg_count))
  );
  n_ok
});
/// The place under a call-site borrow marker (decision 33): `&mut x` and a
/// `&x` that lends to a borrowing parameter both name the place `x`. Every
/// walker that roots an argument's PLACE (the `inout` alias roots, D3, the
/// mutation summary) reads through the marker with this; a `&x` that is the
/// raw-pointer address-of is about `x` too, so seeing through it is sound for
/// both readings. Anything else is returned unchanged.
ast_expr_strip_borrow_marker :: (fn(imm(e) : AstExpr) -> AstExpr)(
  cond(
    (ast_expr_is_fn_call_of(e, BK_BORROW_MUT, Option(usize).Some(usize(1))) || ast_expr_is_fn_call_of(e, BF_ADDRESS_OF, Option(usize).Some(usize(1)))) => match(
      e,
      .FnCall(_, _, sm_args, _, _) => match(sm_args.get(usize(0)), .Some(sm_a) => sm_a, .None => e),
      .Atom(_, _) => e
    ),
    true => e
  )
);
/// A place as the user writes it, for diagnostics: `x`, `self.*.buf`,
/// `xs(i).name`. `ast_expr_to_string` parenthesizes every operator node
/// (`((self.(*)).buf)`), which reads badly in a message that tells the user
/// what to type. Anything that is not a name, a field or dereference step or
/// a call falls back to `ast_expr_to_string`.
ast_place_text :: (fn(imm(e) : AstExpr) -> String)(
  match(
    e,
    .Atom(_, tok) => tok.value,
    .FnCall(_, pf, pargs, _, _) => cond(
      ast_expr_is_fn_call_of(e, BF_DOT, Option(usize).Some(usize(2))) => {
        base := recur(match(pargs.get(usize(0)), .Some(b) => b, .None => make_err_expr()));
        field := match(
          pargs.get(usize(1)),
          .Some(.Atom(_, ft)) => ft.value,
          .Some(f) => recur(f),
          .None => String.new()
        );
        `${base}.${field}`
      },
      (ast_expr_is_fn_call(e) && match(pf, .Atom(_, pft) => ((pft.kind != TokenKind.Operator) && (pft.kind != TokenKind.Dot)), .FnCall(_, _, _, _, _) => true)) => {
        // A fresh buffer: `recur(pf)` on a name returns the token's own
        // (interned, shared) `value`, and `push_str` writes in place, so
        // appending to it renamed the callee in the AST — `xs` became
        // `xs(i)` for every later evaluation of the node
        // (issues/fixed/ast-place-text-renames-the-callee-of-an-element-place.md).
        out := String.new();
        out.push_string(recur(pf));
        out.push_str("(");
        (pi : usize) = usize(0);
        while(pi < pargs.len(), pi = (pi + usize(1)), {
          if(pi > usize(0), {
            out.push_str(", ");
          });
          out.push_string(ast_expr_to_string(match(pargs.get(pi), .Some(a) => a, .None => make_err_expr())));
        });
        out.push_str(")");
        out
      },
      true => ast_expr_to_string(e)
    )
  )
);
/// True if `e` is a FnCall whose func is an Atom found in `func_names`,
/// and whose argument count equals `arg_count` (if `.Some`).
ast_expr_is_fn_call_of_any :: (fn(imm(e) : AstExpr, imm(func_names) : ArrayList(str), arg_count : Option(usize)) -> bool)(
  match(
    e,
    .Atom(_, _) => false,
    .FnCall(_, func_box, args, _, _) => {
      func_name_in_list := match(
        func_box,
        .Atom(_, tok) => {
          n := func_names.len();
          i := usize(0);
          found := false;
          while(i < n, {
            v := match(func_names.get(i), .Some(s) => s, .None => "~unreachable~");
            if(tok.value == v, {
              found = true;
              return(found);
            });
            i = (i + usize(1));
          });
          found
        },
        .FnCall(_, _, _, _, _) => false
      );
      if(!func_name_in_list, {
        return(false);
      });
      count_ok := match(
        arg_count,
        .None => true,
        .Some(n) => (args.len() == n)
      );
      count_ok
    }
  )
);
/// Structural equality for two AstExpr nodes.
/// Atoms are equal if their token values are equal.
/// FnCalls are equal if their func and all args are recursively equal.
///
///
exprs_are_equal :: (fn(imm(e1) : AstExpr, imm(e2) : AstExpr) -> bool)(
  match(
    e1,
    .Atom(_, tok1) => match(
      e2,
      .Atom(_, tok2) => (tok1.value == tok2.value),
      .FnCall(_, _, _, _, _) => false
    ),
    .FnCall(_, func1, args1, _, _) => match(
      e2,
      .Atom(_, _) => false,
      .FnCall(_, func2, args2, _, _) => {
        if(!recur(func1, func2), {
          return(false);
        });
        n1 := args1.len();
        n2 := args2.len();
        if(n1 != n2, {
          return(false);
        });
        i := usize(0);
        while(i < n1, {
          a1 := match(args1.get(i), .Some(a) => a, .None => make_err_expr());
          a2 := match(args2.get(i), .Some(a) => a, .None => make_err_expr());
          if(!recur(a1, a2), {
            return(false);
          });
          i = (i + usize(1));
        });
        true
      }
    )
  )
);
// ---------------------------------------------------------------------------
// Expr traversal helpers
// ---------------------------------------------------------------------------
/// True if `expr` introduces a new function/closure boundary and should NOT
/// be recursed into when scanning for unwind/return/await.
///
///
/// A simplified port: checks for `->`, `=>`, `=>>` operators, and the
/// `(fn(...) -> T)({body})` pattern (outer FnCall whose func is a fn-type call).
is_function_boundary_arrow :: (fn(imm(e) : AstExpr) -> bool)(
  match(
    e,
    .Atom(_, _) => false,
    .FnCall(_, .Atom(_, tok), _, _, _) => {
      v := tok.value.clone();
      (v == "->") || (v == "=>") || (v == "=>>")
    },
    .FnCall(_, .FnCall(_, .Atom(_, inner_tok), _, _, _), _, _, _) => {
      iv := inner_tok.value.clone();
      (iv == BK_FN) || (iv == BK_UNSAFE_FN) || (iv == BK_CTL) || (iv == BK_FN_TRAIT) || (iv == BK_FN_ONCE_TRAIT)
    },
    .FnCall(_, _, _, _, _) => false
  )
);
/// Traverse an evaluated expression tree checking for an `unwind` keyword usage.
/// Skips new function/closure boundaries (`->`, `=>`, function type calls).
/// Recurses into `cond`/`match` branches without treating branch arrows as
/// function boundaries.
///
// `evaluated_body_contains_unwind` and `expr_tree_contains_return` were
// relocated to `./expr_traversal.yo`.
export(BK_FN, BK_UNSAFE_FN, BK_CTL, BK_FN_TRAIT, BK_FN_ONCE_TRAIT, BK_ATOMIC, BK_STRUCT, BK_NEWTYPE, BK_ENUM, BK_UNION);
export(BK_TRAIT, BK_IMPL_UPPER, BK_IMPL_LOWER, BK_PTR, BK_ISO);
export(BK_COMPTIME_LIST_TYPE, BK_FUTURE, BK_CONCRETE, BK_DYN_UPPER, BK_DYN_LOWER);
export(BK_OP_AND, BK_OP_OR, BK_QUOTE, BK_GENSYM, BK_COMPTIME_LIST_VAL, BK_REF, BK_INOUT, BK_OWN);
