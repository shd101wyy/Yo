//! Doc model builder — combines doc comment extraction with evaluator type
//! info to produce structured documentation.
//!
//! This file holds the TOKEN-SCANNING half (everything reachable
//! from tokens alone: trait-impl extraction, impl-info extraction, the
//! token-only fallback builder, and cross-references). The evaluator half
//! (`build_doc_module`) follows in the same file — see
//! plans/archive/P1_CLI_PARITY.md §5's worksheet.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ HashSet } :: import("std/collections/hash_set");
{ Token, TokenKind } :: import("../token.yo");
{ is_any_temp_variable_name } :: import("../utils.yo");
{
  DocParam,
  DocField,
  DocVariant,
  DocAssociatedType,
  DocImplAssocType,
  DocImpl,
  DocFunction,
  DocType,
  DocTrait,
  DocConstant,
  DocModule,
  DocItemKind,
  DocTraitKind
} :: import("./model.yo");
{ DocExtractionResult } :: import("./extractor.yo");
{ parse_doc_comment } :: import("./sections.yo");
{ TypeValue } :: import("../types/definitions.yo");
{
  is_struct_type,
  is_enum_type,
  is_union_type,
  is_trait_type,
  is_module_type,
  is_function_type,
  is_function_type_and_is_type_function
} :: import("../types/guards.yo");
{ type_to_string } :: import("../types/string.yo");
{ EvalValue, value_to_string } :: import("../value.yo");
{ Environment } :: import("../env.yo");
{ MethodEntry, get_type_trait_methods_for_type } :: import("../evaluator/values/type_trait_methods.yo");
{ GenericImplDocEntry, get_generic_impl_doc_entries } :: import("../evaluator/values/impl.yo");
{ get_func_param_comptime, get_func_param_defaults } :: import("../evaluator/types/function.yo");
{ get_func_type } :: import("../function_value.yo");
// ---------------------------------------------------------------------------
// Shared small types
// ---------------------------------------------------------------------------
/// Parsed section fields shared by DocType, DocTrait, and DocConstant.
DocSections :: struct(
  deprecated : Option(String),
  examples : Option(String)
);
/// Per-type info extracted from `impl(...)` token scanning.
TokenImplInfo :: struct(
  trait_impls : ArrayList(String),
  impls : ArrayList(DocImpl),
  methods : ArrayList(DocFunction)
);
TraitBodyExtraction :: struct(
  method_names : ArrayList(String),
  associated_types : ArrayList(DocImplAssocType),
  methods : ArrayList(DocFunction)
);
// ---------------------------------------------------------------------------
// Doc-comment helpers
// ---------------------------------------------------------------------------
/// Extract deprecated/examples sections from a doc comment string.
/// `.None` doc → both `.None`.
extract_doc_sections :: (fn(imm(doc) : Option(String)) -> DocSections)(
  match(
    doc,
    .None => DocSections(deprecated : Option(String).None, examples : Option(String).None),
    .Some(text) => {
      parsed := parse_doc_comment(&text);
      DocSections(
        deprecated : parsed.sections.get(String.from("deprecated")),
        examples : parsed.sections.get(String.from("examples"))
      )
    }
  )
);
/// The module's stability marker: its whole `## Stability` doc section,
/// collapsed to a single line (`unstable — new in v0.2.20; …`), or `.None`
/// when the module has none. Renderers key the badge on its first word.
///
/// The section is COLLAPSED, not truncated. A marker is ordinary prose and
/// wraps at the source file's line width, so reading only its first line cut
/// every marker longer than one source line mid-clause — in the JSON
/// `"stability"` key, the HTML badge and the Markdown note alike, with no
/// warning. Blank lines are dropped and the remaining lines are joined with a
/// single space, which is exactly the paragraph the author wrote.
module_stability :: (fn(imm(doc) : Option(String)) -> Option(String))(
  match(
    doc,
    .None => Option(String).None,
    .Some(text) => match(
      parse_doc_comment(&text).sections.get(String.from("stability")),
      .None => Option(String).None,
      .Some(sec) => {
        (collapsed : String) = String.from("");
        lines := sec.split(`\n`);
        (i : usize) = usize(0);
        n := lines.len();
        while(i < n, {
          match(
            lines.get(i),
            .Some(line) => {
              piece := line.trim();
              if(piece.len() > usize(0), {
                collapsed = if(collapsed.len() > usize(0), collapsed + String.from(" ") + piece, piece);
              });
            },
            .None => ()
          );
          i = (i + usize(1));
        });
        // An empty or whitespace-only section is no marker at all; it used to
        // render as an empty badge.
        if(collapsed.len() == usize(0), Option(String).None, Option(String).Some(collapsed))
      }
    )
  )
);
/// Build a lookup map from declaration name → doc comment content.
build_doc_lookup :: (fn(imm(extraction) : DocExtractionResult) -> HashMap(String, String))({
  lookup := HashMap(String, String).new();
  (i : usize) = usize(0);
  n := extraction.declarations.len();
  while(i < n, {
    match(
      extraction.declarations.get(i),
      .Some(assoc) => if(assoc.declaration_name.len() > usize(0), {
        lookup.insert(assoc.declaration_name.clone(), assoc.comment.content.clone());
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  lookup
});
/// The receiver-qualified doc key for an impl member: `Receiver.member`.
/// Identifiers never contain `.`, so these keys cannot collide with the
/// bare-name entries `build_doc_lookup` records.
_member_doc_key :: (fn(imm(receiver) : String, imm(member) : String) -> String)(`${receiver}.${member}`);
/// A method's doc comment: the receiver-qualified entry the impl scan
/// recorded for THIS type's member, else the bare member name (a method whose
/// impl the token scan cannot key — one living in another module, say).
///
/// Keying by bare name alone crossed same-named members between types: `new`
/// on both `Vs` and `Rs` in one file rendered the later impl's prose on BOTH
/// methods (issues/fixed/stddoc-core-doc-comment-attached-by-bare-member-name.md).
_method_doc :: (
  fn(imm(doc_lookup) : HashMap(String, String), imm(receiver) : String, imm(member) : String) -> Option(String)
)(
  match(
    doc_lookup.get(_member_doc_key(receiver, member)),
    .Some(content) => Option(String).Some(content),
    .None => doc_lookup.get(member.clone())
  )
);
// ---------------------------------------------------------------------------
// Method / trait-name merging
// ---------------------------------------------------------------------------
/// Merge two method lists — secondary entries whose name a
/// primary entry already has are dropped.
merge_methods :: (
  fn(imm(primary) : ArrayList(DocFunction), imm(secondary) : ArrayList(DocFunction)) -> ArrayList(DocFunction)
)({
  seen := ArrayList(String).new();
  merged := ArrayList(DocFunction).new();
  (i : usize) = usize(0);
  while(i < primary.len(), {
    match(
      primary.get(i),
      .Some(m) => {
        seen.push(m.name.clone());
        merged.push(m);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  (j : usize) = usize(0);
  while(j < secondary.len(), {
    match(
      secondary.get(j),
      .Some(m) => if(!seen.contains(&m.name), {
        seen.push(m.name.clone());
        merged.push(m);
      }),
      .None => ()
    );
    j = (j + usize(1));
  });
  merged
});
/// Merge two trait-impl name lists — dedup preserving first-occurrence order.
merge_trait_impl_names :: (
  fn(imm(primary) : ArrayList(String), imm(secondary) : ArrayList(String)) -> ArrayList(String)
)({
  merged := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < primary.len(), {
    match(
      primary.get(i),
      .Some(n) => if(!merged.contains(&n), {
        merged.push(n.clone());
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  (j : usize) = usize(0);
  while(j < secondary.len(), {
    match(
      secondary.get(j),
      .Some(n) => if(!merged.contains(&n), {
        merged.push(n.clone());
      }),
      .None => ()
    );
    j = (j + usize(1));
  });
  merged
});
// ---------------------------------------------------------------------------
// Token-scanning primitives
// ---------------------------------------------------------------------------
_is_trivia_token :: (fn(imm(token) : Token) -> bool)(
  (token.kind == TokenKind.Whitespace) || (token.kind == TokenKind.SingleLineComment) || (token.kind == TokenKind.MultiLineComment) || (token.kind == TokenKind.DocLineComment) || (token.kind == TokenKind.InnerDocLineComment) || (token.kind == TokenKind.DocBlockComment) || (token.kind == TokenKind.InnerDocBlockComment)
);
/// Skip past balanced parentheses starting at `(`. Returns index after `)`.
_skip_balanced_parens :: (fn(imm(toks) : ArrayList(Token), start : usize) -> usize)({
  at_lparen := match(
    toks.get(start),
    .Some(t) => (t.kind == TokenKind.LParen),
    .None => false
  );
  if(!at_lparen, {
    return(start);
  });
  (depth : usize) = usize(1);
  (j : usize) = (start + usize(1));
  while((j < toks.len()) && (depth > usize(0)), {
    match(
      toks.get(j),
      .Some(t) => {
        if(t.kind == TokenKind.LParen, {
          depth = (depth + usize(1));
        }, {
          if(t.kind == TokenKind.RParen, {
            depth = (depth - usize(1));
          });
        });
      },
      .None => ()
    );
    j = (j + usize(1));
  });
  j
});
/// The source text spanned by tokens [start_index, end_index], trimmed.
_slice_token_text :: (
  fn(imm(toks) : ArrayList(Token), start_index : usize, end_index : usize) -> String
)({
  if((start_index > end_index) || (end_index >= toks.len()), {
    return(String.new());
  });
  start_tok := match(
    toks.get(start_index),
    .Some(t) => t,
    .None => {
      return(String.new());
    }
  );
  end_tok := match(
    toks.get(end_index),
    .Some(t) => t,
    .None => {
      return(String.new());
    }
  );
  // BYTE offsets, both of them. `Token.character` is a RUNE offset and
  // `input` is byte-indexed, so slicing with `character` cut at the wrong
  // place on any source containing a multibyte character (the same defect as
  // `issues/fixed/yo-self-formatter-corrupts-files-with-non-ascii.md`).
  // `Token.byte_offset` is that issue's named follow-up field; `value.len()`
  // is the token's byte width, which is the matching unit
  // (plans/archive/STD_API_AUDIT_D4_PLAN.md §5.2 S8).
  start := usize(start_tok.byte_offset);
  end := (usize(end_tok.byte_offset) + end_tok.value.len());
  end_tok.input.substring(start, end).trim()
});
/// Skip one comma-delimited argument at any nesting depth. Returns the index
/// of the delimiter that ended it.
_skip_delimited_argument :: (fn(imm(toks) : ArrayList(Token), start : usize) -> usize)({
  (paren_depth : usize) = usize(0);
  (bracket_depth : usize) = usize(0);
  (brace_depth : usize) = usize(0);
  (index : usize) = start;
  (done : bool) = false;
  while((index < toks.len()) && !done, {
    token := match(
      toks.get(index),
      .Some(t) => t,
      .None => {
        done = true;
        continue;
      }
    );
    cond(
      (token.kind == TokenKind.LParen) => {
        paren_depth = (paren_depth + usize(1));
      },
      (token.kind == TokenKind.RParen) => {
        if((paren_depth == usize(0)) && (bracket_depth == usize(0)) && (brace_depth == usize(0)), {
          done = true;
        }, {
          paren_depth = (paren_depth - usize(1));
        });
      },
      (token.kind == TokenKind.LBracket) => {
        bracket_depth = (bracket_depth + usize(1));
      },
      (token.kind == TokenKind.RBracket) => {
        bracket_depth = (bracket_depth - usize(1));
      },
      (token.kind == TokenKind.LCurlyBracket) => {
        brace_depth = (brace_depth + usize(1));
      },
      (token.kind == TokenKind.RCurlyBracket) => {
        brace_depth = (brace_depth - usize(1));
      },
      ((token.kind == TokenKind.Comma) && (paren_depth == usize(0)) && (bracket_depth == usize(0)) && (brace_depth == usize(0))) => {
        done = true;
      },
      true => ()
    );
    if(!done, {
      index = (index + usize(1));
    });
  });
  index
});
/// First identifier token's text in [start, end], or "".
_extract_receiver_type_name :: (
  fn(imm(toks) : ArrayList(Token), start : usize, end : usize) -> String
)({
  (i : usize) = start;
  while(i <= end, {
    match(
      toks.get(i),
      .Some(t) => if(t.kind == TokenKind.Identifier, {
        return(t.value.clone());
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  String.new()
});
/// The return-type text after the LAST `->` of a signature, with unbalanced
/// trailing `)` stripped.
_extract_return_type_from_signature :: (fn(imm(signature) : String) -> String)({
  arrow_index := match(
    signature.last_index_of(`->`),
    .Some(i) => i,
    .None => {
      return(String.from("unknown"));
    }
  );
  (return_type : String) = signature.substring(arrow_index + usize(2), signature.len()).trim();
  // Only strip unbalanced trailing closing parens (from the outer fn(...)
  // wrapper). Balanced parens like Option(Slice(T)) must be preserved.
  // '(' / ')' are ASCII, so a byte walk cannot split a multibyte char.
  (balance : isize) = isize(0);
  bytes := return_type;
  (bi : usize) = usize(0);
  while(bi < bytes.len(), {
    b := bytes.byte_at(bi);
    if(b == u8(40), {
      balance = (balance + isize(1));
    }, {
      if(b == u8(41), {
        balance = (balance - isize(1));
      });
    });
    bi = (bi + usize(1));
  });
  while((balance < isize(0)) && return_type.ends_with(`)`), {
    return_type = return_type.substring(usize(0), return_type.len() - usize(1));
    balance = (balance + isize(1));
  });
  return_type.trim()
});
// ---------------------------------------------------------------------------
// Source-derived top-level function signatures
// ---------------------------------------------------------------------------
// Doc signatures for TOP-LEVEL functions are rendered from the declaration
// source tokens (`name :: (fn(...) -> Ret)(body)`) instead of the evaluated
// function type: the source spelling is the canonical form — it keeps
// where-constraints and `?=` defaults, and never leaks internal wrappers
// like `comptime(T)`. See issues/fixed/doc-builder-generic-signature-divergence.md.
/// Source-derived doc info for one top-level `name :: (fn ...)(...)`
/// declaration.
SourceSignatureInfo :: struct(
  signature : String,
  parameters : ArrayList(DocParam),
  type_params : ArrayList(DocParam),
  return_type : String
);
/// Render tokens [start, end] as canonical single-line text: token values
/// joined with a space wherever the source had a gap, except after `(` and
/// before `)` / `,` / `;`. Collapses multi-line declarations onto one line
/// and drops comments interleaved in the span.
_render_token_span :: (
  fn(imm(toks) : ArrayList(Token), start : usize, end_index : usize) -> String
)({
  (out : String) = String.new();
  (k : usize) = start;
  while((k <= end_index) && (k < toks.len()), {
    t := match(
      toks.get(k),
      .Some(tok) => tok,
      .None => {
        k = (k + usize(1));
        continue;
      }
    );
    if(k > start, {
      prev := match(toks.get(k - usize(1)), .Some(pt) => pt, .None => t);
      // `Token.character` is a RUNE offset, so the token width added to one
      // has to be a rune count (plans/archive/STD_API_AUDIT_D4_PLAN.md §5.2 S11).
      adjacent := ((usize(prev.character) + prev.value.chars().count()) == usize(t.character));
      suppress := ((prev.kind == TokenKind.LParen) || (t.kind == TokenKind.RParen) || (t.kind == TokenKind.Comma) || (t.kind == TokenKind.Semicolon));
      if(!adjacent && !suppress, {
        out = `${out} `;
      });
    });
    out = `${out}${t.value}`;
    k = (k + usize(1));
  });
  out
});
/// Parse one value parameter from tokens [start, end_index] (one
/// comma-delimited argument of a fn type's parameter list). Handles
/// `name : Type`, `(name : Type) ?= default`, and wrapper forms like
/// `comptime(name) : Type` / `inout(name) : Type`. `.None` for anything
/// else.
_parse_source_param :: (
  fn(imm(toks) : ArrayList(Token), start : usize, end_index : usize) -> Option(DocParam)
)({
  if(start > end_index, {
    return(Option(DocParam).None);
  });
  // Split off a trailing `?= default` at the top nesting level of the arg.
  (default_value : Option(String)) = Option(String).None;
  (core_end : usize) = end_index;
  (depth : usize) = usize(0);
  (q : usize) = start;
  (found_default : bool) = false;
  while((q <= end_index) && !found_default, {
    t := match(
      toks.get(q),
      .Some(tok) => tok,
      .None => {
        q = (q + usize(1));
        continue;
      }
    );
    cond(
      (t.kind == TokenKind.LParen) => {
        depth = (depth + usize(1));
      },
      (t.kind == TokenKind.RParen) => {
        if(depth > usize(0), {
          depth = (depth - usize(1));
        });
      },
      ((depth == usize(0)) && (t.kind == TokenKind.Operator) && (t.value == `?=`)) => {
        if((q + usize(1)) <= end_index, {
          default_value = Option(String).Some(_render_token_span(toks, q + usize(1), end_index));
        });
        if(q == start, {
          return(Option(DocParam).None);
        });
        core_end = (q - usize(1));
        found_default = true;
      },
      true => ()
    );
    if(!found_default, {
      q = (q + usize(1));
    });
  });
  // Unwrap a paren around the whole core: `(msg : T) ?= default`.
  (core_start : usize) = start;
  starts_with_paren := match(
    toks.get(core_start),
    .Some(t) => (t.kind == TokenKind.LParen),
    .None => false
  );
  if(starts_with_paren && (_skip_balanced_parens(toks, core_start) == (core_end + usize(1))), {
    core_start = (core_start + usize(1));
    core_end = (core_end - usize(1));
  });
  if(core_start > core_end, {
    return(Option(DocParam).None);
  });
  // The name: either a bare identifier, or a wrapper like `comptime(x)` /
  // `inout(x)` whose first inner identifier is the name.
  head := match(
    toks.get(core_start),
    .Some(t) => t,
    .None => {
      return(Option(DocParam).None);
    }
  );
  if(head.kind != TokenKind.Identifier, {
    return(Option(DocParam).None);
  });
  (name : String) = String.new();
  (is_comptime : bool) = false;
  (after_name : usize) = (core_start + usize(1));
  wrapper_paren := match(
    toks.get(core_start + usize(1)),
    .Some(t) => (((core_start + usize(1)) <= core_end) && (t.kind == TokenKind.LParen)),
    .None => false
  );
  if(wrapper_paren, {
    wrap_end := _skip_balanced_parens(toks, core_start + usize(1));
    name = _extract_receiver_type_name(toks, core_start + usize(2), wrap_end - usize(2));
    is_comptime = (head.value == `comptime`);
    after_name = wrap_end;
  }, {
    name = head.value.clone();
  });
  if(name.len() == usize(0), {
    return(Option(DocParam).None);
  });
  // The declared type: everything after the `:`.
  if((after_name + usize(1)) > core_end, {
    return(Option(DocParam).None);
  });
  colon_ok := match(
    toks.get(after_name),
    .Some(t) => ((t.kind == TokenKind.Operator) && (t.value == `:`)),
    .None => false
  );
  if(!colon_ok, {
    return(Option(DocParam).None);
  });
  Option(DocParam).Some(
    DocParam(
      name : name,
      type_ : _render_token_span(toks, after_name + usize(1), core_end),
      is_comptime : is_comptime,
      is_implicit : false,
      default_value : default_value,
      doc : Option(String).None
    )
  )
});
/// Parse a `(fn(...) -> Ret)` type-paren group starting at `type_start` (the
/// `(` before `fn`) into a SourceSignatureInfo.
///
/// `where(...)` clauses are constraints, not inputs: they stay visible
/// verbatim in `signature` but are deliberately NOT emitted as `parameters`
/// or `type_params` entries — the generic clause already carries each type
/// parameter, and duplicating the constraint into the tables would desync
/// them from the evaluator-derived tables used everywhere else.
_parse_source_fn_signature :: (
  fn(imm(toks) : ArrayList(Token), type_start : usize) -> Option(SourceSignatureInfo)
)({
  fn_paren_end := _skip_balanced_parens(toks, type_start);
  // Needs at least `(`, `fn`, `(`, `)`, `)`.
  if((fn_paren_end - usize(2)) < (type_start + usize(1)), {
    return(Option(SourceSignatureInfo).None);
  });
  param_list_start := (type_start + usize(2));
  param_list_ok := match(
    toks.get(param_list_start),
    .Some(t) => ((param_list_start < (fn_paren_end - usize(1))) && (t.kind == TokenKind.LParen)),
    .None => false
  );
  if(!param_list_ok, {
    return(Option(SourceSignatureInfo).None);
  });
  signature := _render_token_span(toks, type_start + usize(1), fn_paren_end - usize(2));
  param_end := _skip_balanced_parens(toks, param_list_start);
  parameters := ArrayList(DocParam).new();
  type_params := ArrayList(DocParam).new();
  (p : usize) = (param_list_start + usize(1));
  while(p < (param_end - usize(1)), {
    arg_end := _skip_delimited_argument(toks, p);
    first := match(
      toks.get(p),
      .Some(t) => t,
      .None => {
        p = (p + usize(1));
        continue;
      }
    );
    second_is_lparen := match(
      toks.get(p + usize(1)),
      .Some(t) => (((p + usize(1)) < arg_end) && (t.kind == TokenKind.LParen)),
      .None => false
    );
    cond(
      ((first.kind == TokenKind.Identifier) && (first.value == `generic`) && second_is_lparen) => {
        // generic(T : Type, ...) -> the type parameters.
        gen_end := _skip_balanced_parens(toks, p + usize(1));
        (g : usize) = (p + usize(2));
        while(g < (gen_end - usize(1)), {
          g_end := _skip_delimited_argument(toks, g);
          g_tok := match(
            toks.get(g),
            .Some(t) => t,
            .None => {
              g = (g + usize(1));
              continue;
            }
          );
          if(g_tok.kind == TokenKind.Identifier, {
            has_constraint := match(
              toks.get(g + usize(1)),
              .Some(t) => (((g + usize(1)) < g_end) && (t.kind == TokenKind.Operator) && (t.value == `:`)),
              .None => false
            );
            // `generic(T : Type)` -> "Type"; a bare `generic(T)` means Type.
            constraint := if(has_constraint, _render_token_span(toks, g + usize(2), g_end - usize(1)), String.from("Type"));
            type_params.push(
              DocParam(
                name : g_tok.value.clone(),
                type_ : constraint,
                is_comptime : true,
                is_implicit : false,
                default_value : Option(String).None,
                doc : Option(String).None
              )
            );
          });
          g = g_end;
          g_is_comma := match(
            toks.get(g),
            .Some(t) => ((g < (gen_end - usize(1))) && (t.kind == TokenKind.Comma)),
            .None => false
          );
          if(g_is_comma, {
            g = (g + usize(1));
          });
        });
      },
      ((first.kind == TokenKind.Identifier) && (first.value == `where`) && second_is_lparen) => {
        // Constraint clause — kept out of the parameter tables (see above).
      },
      true => {
        match(
          _parse_source_param(toks, p, arg_end - usize(1)),
          .Some(param) => {
            parameters.push(param);
          },
          .None => ()
        );
      }
    );
    p = arg_end;
    p_is_comma := match(
      toks.get(p),
      .Some(t) => ((p < (param_end - usize(1))) && (t.kind == TokenKind.Comma)),
      .None => false
    );
    if(p_is_comma, {
      p = (p + usize(1));
    });
  });
  // The return type: everything after the depth-0 `->` between the param
  // list and the type-paren close.
  (return_type : String) = String.from("unknown");
  (depth : usize) = usize(0);
  (q : usize) = param_end;
  (found_arrow : bool) = false;
  while((q < (fn_paren_end - usize(1))) && !found_arrow, {
    t := match(
      toks.get(q),
      .Some(tok) => tok,
      .None => {
        q = (q + usize(1));
        continue;
      }
    );
    cond(
      (t.kind == TokenKind.LParen) => {
        depth = (depth + usize(1));
      },
      (t.kind == TokenKind.RParen) => {
        if(depth > usize(0), {
          depth = (depth - usize(1));
        });
      },
      ((depth == usize(0)) && (t.kind == TokenKind.Operator) && (t.value == `->`) && ((q + usize(1)) <= (fn_paren_end - usize(2)))) => {
        return_type = _render_token_span(toks, q + usize(1), fn_paren_end - usize(2));
        found_arrow = true;
      },
      true => ()
    );
    if(!found_arrow, {
      q = (q + usize(1));
    });
  });
  Option(SourceSignatureInfo).Some(
    SourceSignatureInfo(
      signature : signature,
      parameters : parameters,
      type_params : type_params,
      return_type : return_type
    )
  )
});
/// Scan the module's tokens for top-level `name :: (fn(...) -> Ret)(...)`
/// declarations and map each name to its source-derived signature info.
/// Nested declarations always live inside parens, so skipping every balanced
/// paren group keeps the scan at the top level.
_extract_top_level_fn_signatures :: (
  fn(imm(tokens) : ArrayList(Token)) -> HashMap(String, SourceSignatureInfo)
)({
  result := HashMap(String, SourceSignatureInfo).new();
  // Filter to non-trivia tokens for easier scanning.
  toks := ArrayList(Token).new();
  (fi : usize) = usize(0);
  while(fi < tokens.len(), {
    match(
      tokens.get(fi),
      .Some(t) => if(!_is_trivia_token(&t), {
        toks.push(t);
      }),
      .None => ()
    );
    fi = (fi + usize(1));
  });
  (i : usize) = usize(0);
  while(i < toks.len(), {
    token := match(
      toks.get(i),
      .Some(t) => t,
      .None => {
        i = (i + usize(1));
        continue;
      }
    );
    is_decl := if((token.kind == TokenKind.Identifier) && ((i + usize(3)) < toks.len()), {
      t1_ok := match(
        toks.get(i + usize(1)),
        .Some(t) => ((t.kind == TokenKind.Operator) && (t.value == `::`)),
        .None => false
      );
      t2_ok := match(
        toks.get(i + usize(2)),
        .Some(t) => (t.kind == TokenKind.LParen),
        .None => false
      );
      t3_ok := match(
        toks.get(i + usize(3)),
        .Some(t) => ((t.kind == TokenKind.Identifier) && (t.value == `fn`)),
        .None => false
      );
      t1_ok && t2_ok && t3_ok
    }, false);
    if(is_decl, {
      match(
        _parse_source_fn_signature(&toks, i + usize(2)),
        .Some(info) => {
          already := match(
            result.get(token.value.clone()),
            .Some(_) => true,
            .None => false
          );
          if(!already, {
            result.insert(token.value.clone(), info);
          });
        },
        .None => ()
      );
      i = _skip_balanced_parens(&toks, i + usize(2));
      continue;
    });
    if(token.kind == TokenKind.LParen, {
      i = _skip_balanced_parens(&toks, i);
    }, {
      i = (i + usize(1));
    });
  });
  result
});
/// Clone `params` with each entry's `doc` filled from `doc_lookup`.
_with_param_docs :: (
  fn(imm(params) : ArrayList(DocParam), imm(doc_lookup) : Option(HashMap(String, String))) -> ArrayList(DocParam)
)({
  out := ArrayList(DocParam).new();
  (i : usize) = usize(0);
  while(i < params.len(), {
    p := match(
      params.get(i),
      .Some(x) => x,
      .None => {
        i = (i + usize(1));
        continue;
      }
    );
    (d : Option(String)) = Option(String).None;
    match(
      doc_lookup,
      .Some(lookup) => {
        d = lookup.get(p.name.clone());
      },
      .None => ()
    );
    out.push(
      DocParam(
        name : p.name.clone(),
        type_ : p.type_.clone(),
        is_comptime : p.is_comptime,
        is_implicit : p.is_implicit,
        default_value : p.default_value,
        doc : d
      )
    );
    i = (i + usize(1));
  });
  out
});
/// True when the parenthesized region starting at `l_paren_index` contains a
/// top-or-nested `name :` pair — i.e. it is an impl BODY, not a type-args
/// list.
_paren_contains_trait_body :: (fn(imm(toks) : ArrayList(Token), l_paren_index : usize) -> bool)({
  end := _skip_balanced_parens(toks, l_paren_index);
  (i : usize) = (l_paren_index + usize(1));
  while((i + usize(1)) < (end - usize(1)), {
    is_pair := match(
      toks.get(i),
      .Some(t) => if(
        t.kind == TokenKind.Identifier,
        match(
          toks.get(i + usize(1)),
          .Some(t2) => ((t2.kind == TokenKind.Operator) && (t2.value == `:`)),
          .None => false
        ),
        false
      ),
      .None => false
    );
    if(is_pair, {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
/// Strip a doc-line comment's `/// ` (or `///`) prefix.
_strip_doc_line_prefix :: (fn(imm(text) : String) -> String)(
  cond(
    text.starts_with(`/// `) => text.substring(usize(4), text.len()),
    text.starts_with(String.from("///")) => {
      rest := text.substring(usize(3), text.len());
      // `\s?` — at most ONE whitespace after ///.
      cond(
        rest.starts_with(String.from("\t")) => rest.substring(usize(1), rest.len()),
        rest.starts_with(` `) => rest.substring(usize(1), rest.len()),
        true => rest
      )
    },
    true => text.clone()
  )
);
/// Strip a `/** ... */` block comment to its content, removing per-line
/// leading ` * ` gutters.
_strip_doc_block_comment :: (fn(imm(text) : String) -> String)({
  (t : String) = text.clone();
  if(t.starts_with(String.from("/**")), {
    t = t.substring(usize(3), t.len()).trim_start();
  });
  if(t.ends_with(String.from("*/")), {
    t = t.substring(usize(0), t.len() - usize(2)).trim_end();
  });
  lines := t.split(String.from("\n"));
  out_lines := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < lines.len(), {
    line := match(lines.get(i), .Some(l) => l, .None => String.new());
    // `^\s*\*\s?` — only rewrite lines that HAVE a `*` gutter.
    stripped := line.trim_start();
    if(stripped.starts_with(`*`), {
      rest := stripped.substring(usize(1), stripped.len());
      cond(
        rest.starts_with(` `) => {
          out_lines.push(rest.substring(usize(1), rest.len()));
        },
        rest.starts_with(String.from("\t")) => {
          out_lines.push(rest.substring(usize(1), rest.len()));
        },
        true => {
          out_lines.push(rest);
        }
      );
    }, {
      out_lines.push(line.clone());
    });
    i = (i + usize(1));
  });
  String.from("\n").join(&out_lines).trim()
});
/// Collect `///` / `/** */` doc comment lines immediately preceding the token
/// at (row, character) in the FULL (trivia-included) token array.
_collect_doc_comment_before :: (
  fn(imm(full_tokens) : ArrayList(Token), row : usize, character : usize) -> Option(String)
)({
  (idx : isize) = (isize(0) - isize(1));
  (i : usize) = usize(0);
  (found : bool) = false;
  while((i < full_tokens.len()) && !found, {
    match(
      full_tokens.get(i),
      .Some(t) => if((usize(t.row) > row) || ((usize(t.row) == row) && (usize(t.character) >= character)), {
        idx = isize(i);
        found = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  if(idx <= isize(0), {
    return(Option(String).None);
  });
  // Walk backwards from idx-1 collecting doc comments (skipping whitespace),
  // then reverse into order.
  collected_rev := ArrayList(String).new();
  (bi : isize) = (idx - isize(1));
  (stop : bool) = false;
  while((bi >= isize(0)) && !stop, {
    match(
      full_tokens.get(usize(bi)),
      .Some(t) => cond(
        (t.kind == TokenKind.Whitespace) => (),
        (t.kind == TokenKind.DocLineComment) => {
          collected_rev.push(_strip_doc_line_prefix(&t.value));
        },
        (t.kind == TokenKind.DocBlockComment) => {
          collected_rev.push(_strip_doc_block_comment(&t.value));
        },
        true => {
          stop = true;
        }
      ),
      .None => {
        stop = true;
      }
    );
    bi = (bi - isize(1));
  });
  if(collected_rev.len() == usize(0), {
    return(Option(String).None);
  });
  collected_rev.reverse();
  Option(String).Some(String.from("\n").join(&collected_rev).trim())
});
// ---------------------------------------------------------------------------
// impl(...) token scanning
// ---------------------------------------------------------------------------
/// Extract trait implementation names per type from the token stream.
///
/// `derive(Type, Trait(...))` counts as well as `impl(Type, Trait(...))`: the
/// two spell the same relationship with the same argument shape, so one walk
/// reads both. Scanning only `impl` left every DERIVED impl invisible — an
/// empty `trait_impls` — and the trait-doc inheritance pass keys on exactly
/// that list, so 25 `source` and 24 `to_string` methods rendered as bare
/// signatures even once their traits carried documentation
/// (issues/fixed/yo-doc-renders-the-prelude-empty.md, measured after the
/// prelude fix). It is also what a reader wants on the type's page: a derived
/// `Eq` is an implemented `Eq`. Only the NAME scanner learns this — the
/// impl-INFO scanner below reads method bodies, and a derive call has none.
extract_trait_impls_from_tokens :: (
  fn(imm(tokens) : ArrayList(Token)) -> HashMap(String, ArrayList(String))
)({
  result := HashMap(String, ArrayList(String)).new();
  // Filter to non-trivia tokens for easier scanning.
  toks := ArrayList(Token).new();
  (fi : usize) = usize(0);
  while(fi < tokens.len(), {
    match(
      tokens.get(fi),
      .Some(t) => if(!_is_trivia_token(&t), {
        toks.push(t);
      }),
      .None => ()
    );
    fi = (fi + usize(1));
  });
  (i : usize) = usize(0);
  while(i < toks.len(), {
    tok := match(
      toks.get(i),
      .Some(t) => t,
      .None => {
        i = (i + usize(1));
        continue;
      }
    );
    is_impl := (
      (tok.kind == TokenKind.Identifier) && ((tok.value == `impl`) || (tok.value == `derive`))
    );
    has_lparen := match(
      toks.get(i + usize(1)),
      .Some(t) => (t.kind == TokenKind.LParen),
      .None => false
    );
    if(!(is_impl && has_lparen), {
      i = (i + usize(1));
      continue;
    });
    // Skip past `impl(`.
    (j : usize) = (i + usize(2));
    // Skip `generic(...)` if present.
    is_generic := match(
      toks.get(j),
      .Some(t) => ((t.kind == TokenKind.Identifier) && (t.value == `generic`)),
      .None => false
    );
    if(is_generic, {
      j = _skip_balanced_parens(&toks, j + usize(1));
      match(
        toks.get(j),
        .Some(t) => if(t.kind == TokenKind.Comma, {
          j = (j + usize(1));
        }),
        .None => ()
      );
    });
    // Skip `where(...)` if present.
    is_where := match(
      toks.get(j),
      .Some(t) => ((t.kind == TokenKind.Identifier) && (t.value == `where`)),
      .None => false
    );
    if(is_where, {
      j = _skip_balanced_parens(&toks, j + usize(1));
      match(
        toks.get(j),
        .Some(t) => if(t.kind == TokenKind.Comma, {
          j = (j + usize(1));
        }),
        .None => ()
      );
    });
    // The receiver type name.
    type_name := match(
      toks.get(j),
      .Some(t) => if(t.kind == TokenKind.Identifier, t.value.clone(), String.new()),
      .None => String.new()
    );
    if(type_name.len() == usize(0), {
      i = (i + usize(1));
      continue;
    });
    j = (j + usize(1));
    // Skip type parameters like `(T)` after the type name.
    is_lp := match(
      toks.get(j),
      .Some(t) => (t.kind == TokenKind.LParen),
      .None => false
    );
    if(is_lp, {
      j = _skip_balanced_parens(&toks, j);
    });
    // If next is comma, the item after is the trait name.
    is_comma := match(
      toks.get(j),
      .Some(t) => (t.kind == TokenKind.Comma),
      .None => false
    );
    if(!is_comma, {
      i = (i + usize(1));
      continue;
    });
    j = (j + usize(1));
    trait_name := match(
      toks.get(j),
      .Some(t) => if(t.kind == TokenKind.Identifier, t.value.clone(), String.new()),
      .None => String.new()
    );
    if(trait_name.len() == usize(0), {
      i = (i + usize(1));
      continue;
    });
    // Verify it's followed by `(` to confirm it's a trait (not another arg).
    trait_lp := match(
      toks.get(j + usize(1)),
      .Some(t) => (t.kind == TokenKind.LParen),
      .None => false
    );
    if(!trait_lp, {
      i = (i + usize(1));
      continue;
    });
    existing := match(
      result.get(type_name.clone()),
      .Some(l) => l,
      .None => ArrayList(String).new()
    );
    if(!existing.contains(&trait_name), {
      existing.push(trait_name.clone());
    });
    result.insert(type_name.clone(), existing);
    i = (i + usize(1));
  });
  result
});
/// Extract method names, associated types, and full method info from a trait
/// impl body.
/// `full_tokens` is the trivia-INCLUDED array for doc-comment recovery; pass
/// an empty list to skip doc extraction.
_extract_trait_body_members :: (
  fn(
    imm(toks) : ArrayList(Token),
    l_paren_index : usize,
    imm(full_tokens) : ArrayList(Token)
  ) -> TraitBodyExtraction
)({
  end := _skip_balanced_parens(toks, l_paren_index);
  method_names := ArrayList(String).new();
  associated_types := ArrayList(DocImplAssocType).new();
  methods := ArrayList(DocFunction).new();
  (i : usize) = (l_paren_index + usize(1));
  while(i < (end - usize(1)), {
    is_pair := match(
      toks.get(i),
      .Some(t) => if(
        t.kind == TokenKind.Identifier,
        if(
          (i + usize(1)) < (end - usize(1)),
          match(
            toks.get(i + usize(1)),
            .Some(t2) => ((t2.kind == TokenKind.Operator) && (t2.value == `:`)),
            .None => false
          ),
          false
        ),
        false
      ),
      .None => false
    );
    if(is_pair, {
      name_tok := match(
        toks.get(i),
        .Some(t) => t,
        .None => {
          i = (i + usize(1));
          continue;
        }
      );
      name := name_tok.value.clone();
      doc := if(
        full_tokens.len() > usize(0),
        _collect_doc_comment_before(full_tokens, usize(name_tok.row), usize(name_tok.character)),
        Option(String).None
      );
      // Is the type after ":" a function type (method) or a plain type
      // (associated type)?
      type_start := (i + usize(2));
      if(type_start < (end - usize(1)), {
        type_tok_is_lparen := match(
          toks.get(type_start),
          .Some(t) => (t.kind == TokenKind.LParen),
          .None => false
        );
        is_fn_type := (
          type_tok_is_lparen && ((type_start + usize(1)) < (end - usize(1))) && match(
            toks.get(type_start + usize(1)),
            .Some(t) => ((t.kind == TokenKind.Identifier) && (t.value == `fn`)),
            .None => false
          )
        );
        if(is_fn_type, {
          method_names.push(name.clone());
          // The fn type signature: (fn(...) -> ReturnType).
          fn_paren_end := _skip_balanced_parens(toks, type_start);
          fn_signature := _slice_token_text(toks, type_start, fn_paren_end - usize(1));
          return_type := _extract_return_type_from_signature(&fn_signature);
          // Parameters — between the inner parens after `fn`.
          params := ArrayList(DocParam).new();
          param_start := (type_start + usize(2));
          param_start_is_lp := match(
            toks.get(param_start),
            .Some(t) => (t.kind == TokenKind.LParen),
            .None => false
          );
          if((param_start < fn_paren_end) && param_start_is_lp, {
            param_end := _skip_balanced_parens(toks, param_start);
            (p : usize) = (param_start + usize(1));
            while(p < (param_end - usize(1)), {
              param_name := match(
                toks.get(p),
                .Some(t) => if(t.kind == TokenKind.Identifier, t.value.clone(), String.new()),
                .None => String.new()
              );
              (advanced : bool) = false;
              if(param_name.len() > usize(0), {
                // A later `self` is treated as an ordinary name.
                if((param_name != `self`) || (params.len() == usize(0)), {
                  has_colon := (
                    ((p + usize(1)) < (param_end - usize(1))) && match(
                      toks.get(p + usize(1)),
                      .Some(t) => ((t.kind == TokenKind.Operator) && (t.value == `:`)),
                      .None => false
                    )
                  );
                  if(has_colon, {
                    type_arg_start := (p + usize(2));
                    type_arg_end := _skip_delimited_argument(toks, type_arg_start);
                    param_type := _slice_token_text(toks, type_arg_start, type_arg_end - usize(1));
                    if(param_name != `self`, {
                      params.push(
                        DocParam(
                          name : param_name.clone(),
                          type_ : param_type,
                          is_comptime : false,
                          is_implicit : false,
                          default_value : Option(String).None,
                          doc : Option(String).None
                        )
                      );
                    });
                    p = type_arg_end;
                    comma_next := (
                      (p < (param_end - usize(1))) && match(
                        toks.get(p),
                        .Some(t) => (t.kind == TokenKind.Comma),
                        .None => false
                      )
                    );
                    if(comma_next, {
                      p = (p + usize(1));
                    });
                    advanced = true;
                  });
                });
              });
              if(!advanced, {
                p = (p + usize(1));
              });
            });
          });
          methods.push(
            DocFunction(
              name : name.clone(),
              doc : doc,
              signature : fn_signature,
              parameters : params,
              return_type : return_type,
              type_params : Option(ArrayList(DocParam)).None,
              effects : Option(ArrayList(DocParam)).None,
              is_method : true,
              self_type : Option(String).None,
              returns : Option(String).None,
              errors : Option(String).None,
              deprecated : Option(String).None,
              examples : Option(String).None,
              inherited_from : Option(String).None
            )
          );
        }, {
          // Associated type — collect the type expression text.
          type_end := if(
            type_tok_is_lparen,
            _skip_balanced_parens(toks, type_start),
            _skip_delimited_argument(toks, type_start)
          );
          associated_types.push(
            DocImplAssocType(
              name : name.clone(),
              type_ : _slice_token_text(toks, type_start, type_end - usize(1)),
              doc : doc
            )
          );
        });
      });
    });
    // Skip balanced nested parens to avoid false matches inside type exprs.
    at_lp := match(
      toks.get(i),
      .Some(t) => (t.kind == TokenKind.LParen),
      .None => false
    );
    if(at_lp, {
      i = _skip_balanced_parens(toks, i);
    }, {
      i = (i + usize(1));
    });
  });
  TraitBodyExtraction(
    method_names : method_names,
    associated_types : associated_types,
    methods : methods
  )
});
/// Extract per-type impl info (trait names, impl signatures, methods) from the
/// token stream.
extract_impl_info_from_tokens :: (
  fn(
    imm(tokens) : ArrayList(Token),
    mut(doc_lookup) : HashMap(String, String)
  ) -> HashMap(String, TokenImplInfo)
)({
  result := HashMap(String, TokenImplInfo).new();
  toks := ArrayList(Token).new();
  (fi : usize) = usize(0);
  while(fi < tokens.len(), {
    match(
      tokens.get(fi),
      .Some(t) => if(!_is_trivia_token(&t), {
        toks.push(t);
      }),
      .None => ()
    );
    fi = (fi + usize(1));
  });
  (i : usize) = usize(0);
  while(i < toks.len(), {
    tok := match(
      toks.get(i),
      .Some(t) => t,
      .None => {
        i = (i + usize(1));
        continue;
      }
    );
    is_impl := ((tok.kind == TokenKind.Identifier) && (tok.value == `impl`));
    has_lparen := match(
      toks.get(i + usize(1)),
      .Some(t) => (t.kind == TokenKind.LParen),
      .None => false
    );
    if(!(is_impl && has_lparen), {
      i = (i + usize(1));
      continue;
    });
    impl_end := _skip_balanced_parens(&toks, i + usize(1));
    (current : usize) = (i + usize(2));
    signature_parts := ArrayList(String).new();
    // `generic(...)` prefix.
    is_generic := match(
      toks.get(current),
      .Some(t) => ((t.kind == TokenKind.Identifier) && (t.value == `generic`)),
      .None => false
    );
    if(is_generic, {
      forall_end := _skip_balanced_parens(&toks, current + usize(1));
      signature_parts.push(_slice_token_text(&toks, current, forall_end - usize(1)));
      current = forall_end;
      match(
        toks.get(current),
        .Some(t) => if(t.kind == TokenKind.Comma, {
          current = (current + usize(1));
        }),
        .None => ()
      );
    });
    // `where(...)` before the receiver.
    is_where := match(
      toks.get(current),
      .Some(t) => ((t.kind == TokenKind.Identifier) && (t.value == `where`)),
      .None => false
    );
    if(is_where, {
      where_end := _skip_balanced_parens(&toks, current + usize(1));
      signature_parts.push(_slice_token_text(&toks, current, where_end - usize(1)));
      current = where_end;
      match(
        toks.get(current),
        .Some(t) => if(t.kind == TokenKind.Comma, {
          current = (current + usize(1));
        }),
        .None => ()
      );
    });
    // Receiver.
    receiver_start := current;
    receiver_end := _skip_delimited_argument(&toks, receiver_start);
    receiver_type_name := _extract_receiver_type_name(&toks, receiver_start, receiver_end - usize(1));
    if(receiver_type_name.len() == usize(0), {
      i = impl_end;
      continue;
    });
    signature_parts.push(_slice_token_text(&toks, receiver_start, receiver_end - usize(1)));
    current = receiver_end;
    match(
      toks.get(current),
      .Some(t) => if(t.kind == TokenKind.Comma, {
        current = (current + usize(1));
      }),
      .None => ()
    );
    // `where(...)` AFTER the receiver — inserted before it in the signature.
    is_where2 := match(
      toks.get(current),
      .Some(t) => ((t.kind == TokenKind.Identifier) && (t.value == `where`)),
      .None => false
    );
    if(is_where2, {
      where_end := _skip_balanced_parens(&toks, current + usize(1));
      receiver_part := match(signature_parts.pop(), .Some(p) => p, .None => String.new());
      signature_parts.push(_slice_token_text(&toks, current, where_end - usize(1)));
      signature_parts.push(receiver_part);
      current = where_end;
      match(
        toks.get(current),
        .Some(t) => if(t.kind == TokenKind.Comma, {
          current = (current + usize(1));
        }),
        .None => ()
      );
    });
    entry := match(
      result.get(receiver_type_name.clone()),
      .Some(e) => e,
      .None => TokenImplInfo(
        trait_impls : ArrayList(String).new(),
        impls : ArrayList(DocImpl).new(),
        methods : ArrayList(DocFunction).new()
      )
    );
    anonymous_method_names := ArrayList(String).new();
    while(current < (impl_end - usize(1)), {
      arg_start := current;
      arg_end := _skip_delimited_argument(&toks, arg_start);
      first := match(
        toks.get(arg_start),
        .Some(t) => t,
        .None => {
          current = (arg_end + usize(1));
          continue;
        }
      );
      second_is_colon := match(
        toks.get(arg_start + usize(1)),
        .Some(t) => ((t.kind == TokenKind.Operator) && (t.value == `:`)),
        .None => false
      );
      if((first.kind == TokenKind.Identifier) && second_is_colon, {
        // Anonymous member: `name : (fn ...)`.
        method_name := first.value.clone();
        anonymous_method_names.push(method_name.clone());
        type_start := (arg_start + usize(2));
        type_start_is_lp := match(
          toks.get(type_start),
          .Some(t) => (t.kind == TokenKind.LParen),
          .None => false
        );
        type_end := if(type_start_is_lp, _skip_balanced_parens(&toks, type_start), type_start + usize(1));
        signature := _slice_token_text(&toks, type_start, type_end - usize(1));
        // The comment physically preceding THIS member — the same join
        // `_extract_trait_body_members` uses — falling back to the bare-name
        // entry when the extractor attached through a token the position walk
        // stops at (a `//` note between comment and member, say). A bare-name
        // lookup alone crossed same-named members between types
        // (issues/fixed/stddoc-core-doc-comment-attached-by-bare-member-name.md).
        member_doc := match(
          _collect_doc_comment_before(tokens, usize(first.row), usize(first.character)),
          .Some(content) => Option(String).Some(content),
          .None => doc_lookup.get(method_name.clone())
        );
        // Record the receiver-qualified key for the evaluator-side lookups
        // (`_extract_methods`, `_extract_generic_impl_info`), which see no
        // token positions. `HashMap` is a ref type, so this writes through to
        // the caller's map.
        match(
          member_doc,
          .Some(content) => {
            doc_lookup.insert(
              _member_doc_key(receiver_type_name.clone(), method_name.clone()),
              content.clone()
            );
          },
          .None => ()
        );
        entry.methods.push(
          DocFunction(
            name : method_name.clone(),
            doc : member_doc,
            signature : signature.clone(),
            parameters : ArrayList(DocParam).new(),
            return_type : _extract_return_type_from_signature(&signature),
            type_params : Option(ArrayList(DocParam)).None,
            effects : Option(ArrayList(DocParam)).None,
            is_method : true,
            self_type : Option(String).Some(receiver_type_name.clone()),
            returns : Option(String).None,
            errors : Option(String).None,
            deprecated : Option(String).None,
            examples : Option(String).None,
            inherited_from : Option(String).None
          )
        );
      }, {
        if(first.kind == TokenKind.Identifier, {
          // Trait entry: `TraitName(...)` / `TraitName(args)(body)`.
          (trait_signature : String) = first.value.clone();
          (trait_method_names : ArrayList(String)) = ArrayList(String).new();
          (trait_assoc_types : ArrayList(DocImplAssocType)) = ArrayList(DocImplAssocType).new();
          (trait_methods : ArrayList(DocFunction)) = ArrayList(DocFunction).new();
          next_is_lp := match(
            toks.get(arg_start + usize(1)),
            .Some(t) => (t.kind == TokenKind.LParen),
            .None => false
          );
          if(next_is_lp, {
            first_paren_end := _skip_balanced_parens(&toks, arg_start + usize(1));
            first_has_body := _paren_contains_trait_body(&toks, arg_start + usize(1));
            second_is_lp := match(
              toks.get(first_paren_end),
              .Some(t) => (t.kind == TokenKind.LParen),
              .None => false
            );
            cond(
              (!first_has_body && (first_paren_end <= arg_end) && second_is_lp) => {
                // e.g. Index(usize)(body...) — type args first, body second.
                trait_signature = _slice_token_text(&toks, arg_start, first_paren_end - usize(1));
                if(_paren_contains_trait_body(&toks, first_paren_end), {
                  extracted := _extract_trait_body_members(&toks, first_paren_end, tokens);
                  trait_method_names = extracted.method_names;
                  trait_assoc_types = extracted.associated_types;
                  trait_methods = extracted.methods;
                  trait_signature = `${trait_signature}(...)`;
                });
              },
              !first_has_body => {
                trait_signature = _slice_token_text(&toks, arg_start, first_paren_end - usize(1));
              },
              true => {
                extracted := _extract_trait_body_members(&toks, arg_start + usize(1), tokens);
                trait_method_names = extracted.method_names;
                trait_assoc_types = extracted.associated_types;
                trait_methods = extracted.methods;
                trait_signature = `${first.value}(...)`;
              }
            );
          });
          // Add extracted trait methods to the entry's method list, stamped
          // with the receiver type.
          (tmi : usize) = usize(0);
          while(tmi < trait_methods.len(), {
            match(
              trait_methods.get(tmi),
              .Some(m) => {
                // Same receiver-qualified record as anonymous members, so the
                // evaluator-side lookups cannot cross these between types
                // either.
                match(
                  m.doc,
                  .Some(content) => {
                    doc_lookup.insert(
                      _member_doc_key(receiver_type_name.clone(), m.name.clone()),
                      content.clone()
                    );
                  },
                  .None => ()
                );
                entry.methods.push(
                  DocFunction(
                    name : m.name,
                    doc : m.doc,
                    signature : m.signature,
                    parameters : m.parameters,
                    return_type : m.return_type,
                    type_params : m.type_params,
                    effects : m.effects,
                    is_method : m.is_method,
                    self_type : Option(String).Some(receiver_type_name.clone()),
                    returns : m.returns,
                    errors : m.errors,
                    deprecated : m.deprecated,
                    examples : m.examples,
                    inherited_from : Option(String).None
                  )
                );
              },
              .None => ()
            );
            tmi = (tmi + usize(1));
          });
          entry.trait_impls.push(first.value.clone());
          full_parts := ArrayList(String).new();
          (spi : usize) = usize(0);
          while(spi < signature_parts.len(), {
            match(
              signature_parts.get(spi),
              .Some(p) => {
                full_parts.push(p.clone());
              },
              .None => ()
            );
            spi = (spi + usize(1));
          });
          full_parts.push(trait_signature.clone());
          (assoc_opt : Option(ArrayList(DocImplAssocType))) = Option(ArrayList(DocImplAssocType)).None;
          if(trait_assoc_types.len() > usize(0), {
            assoc_opt = Option(ArrayList(DocImplAssocType)).Some(trait_assoc_types);
          });
          entry.impls.push(
            DocImpl(
              signature : `impl(${String.from(", ").join(&full_parts)})`,
              trait_name : Option(String).Some(first.value.clone()),
              method_names : trait_method_names,
              associated_types : assoc_opt
            )
          );
        });
      });
      current = arg_end;
      match(
        toks.get(current),
        .Some(t) => if(t.kind == TokenKind.Comma, {
          current = (current + usize(1));
        }),
        .None => ()
      );
    });
    if(anonymous_method_names.len() > usize(0), {
      entry.impls.push(
        DocImpl(
          signature : `impl(${String.from(", ").join(&signature_parts)}, ...)`,
          trait_name : Option(String).None,
          method_names : anonymous_method_names,
          associated_types : Option(ArrayList(DocImplAssocType)).None
        )
      );
    });
    result.insert(receiver_type_name.clone(), entry);
    i = impl_end;
  });
  result
});
// ---------------------------------------------------------------------------
// Token-only fallback builder + cross references
// ---------------------------------------------------------------------------
/// One paren group of the declaration walk: the identifier that heads it
/// (`struct`, `enum`, `trait`, `impl`, `fn`, a call name; "" for anonymous
/// groups) and the top-level declaration whose right-hand side the group
/// belongs to.
_TokenGroupFrame :: struct(
  head : String,
  owner : String,
  /// This group's `(` index in the filtered token list.
  open_index : usize
);
/// The declaration STRUCTURE of a module's tokens — what the token-only
/// fallback needs to emit the same ITEMS the evaluated path would.
///
/// The fallback used to flatten every doc-commented member — impl methods,
/// struct fields, enum variants, trait methods, unexported helpers — into
/// standalone `(unknown)` constants, so a degraded run counted ~1.8x the
/// items of the evaluated one and read as the BETTER run. The evaluated path
/// counts exported top-level declarations only (its items are the module
/// TYPE's fields, and a module without an `export(...)` statement exports
/// nothing — `std/math.yo`'s zero-item page); this structure lets the token
/// path apply the same rule, with members attached to their owners
/// (issues/fixed/yo-doc-without-std-path-silently-emits-token-only-docs.md).
TokenDeclStructure :: struct(
  /// The trivia-filtered token list the indices below refer into.
  toks : ArrayList(Token),
  /// "row:column" of every top-level binding NAME token (`Name :: ...`,
  /// `Name := ...`, `(name : T) = ...`).
  top_level_positions : HashSet(String),
  /// member name "row:column" -> "struct" | "union" | "enum" | "trait".
  member_kinds : HashMap(String, String),
  /// member name "row:column" -> the top-level declaration that owns it.
  member_owners : HashMap(String, String),
  /// member name "row:column" -> the sliced type text (struct/union fields).
  member_field_types : HashMap(String, String),
  /// top-level name -> "struct" | "union" | "enum" | "trait" when its
  /// right-hand side is a type or trait body.
  body_kinds : HashMap(String, String),
  /// trait declaration name -> the `(` index of its body group in `toks`.
  trait_body_lparens : HashMap(String, usize),
  /// The module's exported names (from every `export(...)` statement).
  exported : HashSet(String)
);
/// The head identifiers whose group makes an identifier a MEMBER of a type or
/// trait declaration. `trait` members are covered by the trait body
/// extraction (`_extract_trait_body_members`), so the map records them only
/// to keep them OUT of the top-level emission.
_token_member_head :: (fn(imm(head) : String) -> Option(String))(
  cond(
    ((head == `struct`) || (head == `union`)) => Option(String).Some(`struct`),
    (head == `enum`) => Option(String).Some(`enum`),
    (head == `trait`) => Option(String).Some(`trait`),
    true => Option(String).None
  )
);
/// Walk the token stream once and record which identifiers name top-level
/// bindings, which name members of a type/trait declaration (and of which
/// owner), and which names the module exports. See `TokenDeclStructure`.
_classify_token_declarations :: (fn(imm(tokens) : ArrayList(Token)) -> TokenDeclStructure)({
  toks := ArrayList(Token).new();
  (fi : usize) = usize(0);
  while(fi < tokens.len(), {
    match(
      tokens.get(fi),
      .Some(t) => if(!_is_trivia_token(&t), {
        toks.push(t);
      }),
      .None => ()
    );
    fi = (fi + usize(1));
  });
  structure := TokenDeclStructure(
    toks : toks,
    top_level_positions : HashSet(String).new(),
    member_kinds : HashMap(String, String).new(),
    member_owners : HashMap(String, String).new(),
    member_field_types : HashMap(String, String).new(),
    body_kinds : HashMap(String, String).new(),
    trait_body_lparens : HashMap(String, usize).new(),
    exported : HashSet(String).new()
  );
  frames := ArrayList(_TokenGroupFrame).new();
  (current_top : String) = String.new();
  (i : usize) = usize(0);
  while(i < toks.len(), {
    tok := match(
      toks.get(i),
      .Some(t) => t,
      .None => {
        i = (i + usize(1));
        continue;
      }
    );
    if(tok.kind == TokenKind.LParen, {
      head := match(
        // A leading LParen can only be a parenthesized statement in a file
        // with no imports/pragmas; there is no identifier before it then.
        if(i > usize(0), toks.get(i - usize(1)), Option(Token).None),
        .Some(prev) => if(prev.kind == TokenKind.Identifier, prev.value.clone(), String.new()),
        .None => String.new()
      );
      if(_token_member_head(head.clone()).is_some() && (current_top.len() > usize(0)), {
        structure.body_kinds.insert(current_top.clone(), head.clone());
        if(head == `trait`, {
          structure.trait_body_lparens.insert(current_top.clone(), i);
        });
      });
      frames.push(
        _TokenGroupFrame(head : head, owner : current_top.clone(), open_index : i)
      );
      i = (i + usize(1));
      continue;
    });
    if(tok.kind == TokenKind.RParen, {
      if(frames.len() > usize(0), {
        frames.pop();
      });
      i = (i + usize(1));
      continue;
    });
    if(tok.kind != TokenKind.Identifier, {
      i = (i + usize(1));
      continue;
    });
    next := match(
      toks.get(i + usize(1)),
      .Some(t) => t,
      .None => {
        i = (i + usize(1));
        continue;
      }
    );
    is_binding := (
      (next.kind == TokenKind.Operator)
      && ((next.value == `::`) || ((next.value == `:`) || (next.value == `:=`)))
    );
    key := `${tok.row}:${tok.column}`;
    if(frames.len() == usize(0), {
      // Top level. `impl(`/`derive(`/`export(` heads are followed by `(`,
      // not a binding operator, so block keywords never land here.
      if(is_binding, {
        structure.top_level_positions.insert(key.clone());
        current_top = tok.value.clone();
      });
      // `export(a, b, ...)` names the module's exports. A spread's
      // `...(_source)` sits one paren deeper, so only plain names are read.
      if((tok.value == `export`) && (next.kind == TokenKind.LParen), {
        (j : usize) = (i + usize(2));
        (depth : usize) = usize(1);
        while((j < toks.len()) && (depth > usize(0)), {
          inner := match(
            toks.get(j),
            .Some(t) => t,
            .None => {
              j = (j + usize(1));
              continue;
            }
          );
          if(inner.kind == TokenKind.LParen, {
            depth = (depth + usize(1));
          }, {
            if(inner.kind == TokenKind.RParen, {
              depth = (depth - usize(1));
            }, {
              if((depth == usize(1)) && (inner.kind == TokenKind.Identifier), {
                // `export(Label : orig)` exports the definition `orig` under
                // `Label`; both names may carry the definition's docs.
                structure.exported.insert(inner.value.clone());
              });
            });
          });
          j = (j + usize(1));
        });
      });
      i = (i + usize(1));
      continue;
    });
    // Inside a group. A statement-level typed binding `(name : T) = ...` —
    // its parens open at depth 1 and do not start with `fn`, unlike a fn
    // TYPE's parameter list — still names a top-level binding.
    outer := match(
      frames.get(frames.len() - usize(1)),
      .Some(f) => f,
      .None => _TokenGroupFrame(
        head : String.new(),
        owner : String.new(),
        open_index : usize(0)
      )
    );
    statement_binding := (
      (frames.len() == usize(1))
      && (outer.head.len() == usize(0))
      && is_binding
      && match(
        toks.get(outer.open_index + usize(1)),
        .Some(first) => !((first.kind == TokenKind.Identifier) && (first.value == `fn`)),
        .None => false
      )
    );
    if(statement_binding, {
      structure.top_level_positions.insert(key.clone());
      current_top = tok.value.clone();
      i = (i + usize(1));
      continue;
    });
    // Member classification: walk the group stack outward. Anonymous groups
    // and `ref(`/`atomic(` wrappers are transparent; `fn(`, `impl(` and any
    // other call head (a variant payload `Some(...)`, a `where(...)`) are
    // opaque — identifiers inside them belong to their own scope, and impl
    // bodies are covered by `extract_impl_info_from_tokens`.
    (k : isize) = (isize(frames.len()) - isize(1));
    while(k >= isize(0), {
      frame := match(
        frames.get(usize(k)),
        .Some(f) => f,
        .None => {
          break;
        }
      );
      head := frame.head.clone();
      if((head.len() == usize(0)) || ((head == `ref`) || (head == `atomic`)), {
        k = (k - isize(1));
        continue;
      });
      match(
        _token_member_head(head.clone()),
        .Some(kind) => {
          if(frame.owner.len() > usize(0), {
            structure.member_kinds.insert(key.clone(), kind.clone());
            structure.member_owners.insert(key.clone(), frame.owner.clone());
            // A struct/union field's type text: `name : <type>` up to the
            // argument's delimiter.
            if((kind == `struct`) && is_binding, {
              type_start := (i + usize(2));
              type_end := _skip_delimited_argument(&toks, type_start);
              if(type_end > type_start, {
                structure.member_field_types.insert(
                  key.clone(),
                  _slice_token_text(&toks, type_start, type_end - usize(1))
                );
              });
            });
          });
          break;
        },
        .None => ()
      );
      // `fn`, `impl`, or an ordinary call head: opaque.
      break;
    });
    i = (i + usize(1));
  });
  structure
});
/// Append `field` to `types(idx)`'s field list, creating the list on first
/// use (the write-back pattern `build_cross_references` uses for traits).
_attach_token_field :: (fn(imm(types) : ArrayList(DocType), idx : usize, imm(field) : DocField) -> unit)({
  t := match(
    types.get(idx),
    .Some(x) => x,
    .None => {
      return(());
    }
  );
  fields := match(
    t.fields,
    .Some(fs) => fs,
    .None => ArrayList(DocField).new()
  );
  fields.push(field);
  types(idx) = DocType(
    name : t.name,
    doc : t.doc,
    kind : t.kind,
    signature : t.signature,
    type_params : t.type_params,
    fields : Option(ArrayList(DocField)).Some(fields),
    variants : t.variants,
    methods : t.methods,
    trait_impls : t.trait_impls,
    impls : t.impls,
    deprecated : t.deprecated,
    examples : t.examples
  );
});
/// Append `variant` to `types(idx)`'s variant list, creating the list on
/// first use.
_attach_token_variant :: (fn(imm(types) : ArrayList(DocType), idx : usize, imm(variant) : DocVariant) -> unit)({
  t := match(
    types.get(idx),
    .Some(x) => x,
    .None => {
      return(());
    }
  );
  variants := match(
    t.variants,
    .Some(vs) => vs,
    .None => ArrayList(DocVariant).new()
  );
  variants.push(variant);
  types(idx) = DocType(
    name : t.name,
    doc : t.doc,
    kind : t.kind,
    signature : t.signature,
    type_params : t.type_params,
    fields : t.fields,
    variants : Option(ArrayList(DocVariant)).Some(variants),
    methods : t.methods,
    trait_impls : t.trait_impls,
    impls : t.impls,
    deprecated : t.deprecated,
    examples : t.examples
  );
});
/// Build a DocModule from token extraction only (no evaluator). Emits the
/// same ITEMS the evaluated path counts — exported top-level declarations —
/// with members attached to their types: impl methods and their docs ride on
/// the receiver type (`extract_impl_info_from_tokens`), struct fields and
/// enum variants on their declaration, trait methods on the trait. The doc
/// comment of every emitted item is the one the extractor already associated
/// with it (issues/fixed/yo-doc-renders-the-prelude-empty.md, root cause 3).
build_doc_module_from_tokens :: (
  fn(
    imm(name) : String,
    imm(path) : String,
    imm(extraction) : DocExtractionResult,
    imm(tokens) : ArrayList(Token)
  ) -> DocModule
)({
  doc_lookup := build_doc_lookup(extraction);
  trait_impl_map := extract_trait_impls_from_tokens(tokens);
  impl_info_map := extract_impl_info_from_tokens(tokens, &mut doc_lookup);
  structure := _classify_token_declarations(tokens);
  (module_doc : Option(String)) = Option(String).None;
  match(
    extraction.module_doc,
    .Some(md) => {
      module_doc = Option(String).Some(md.content.clone());
    },
    .None => ()
  );
  types := ArrayList(DocType).new();
  traits := ArrayList(DocTrait).new();
  constants := ArrayList(DocConstant).new();
  /// name -> index into `types` (members attach through this).
  type_index := HashMap(String, usize).new();
  (i : usize) = usize(0);
  while(i < extraction.declarations.len(), {
    assoc := match(
      extraction.declarations.get(i),
      .Some(a) => a,
      .None => {
        i = (i + usize(1));
        continue;
      }
    );
    if(assoc.declaration_name.len() == usize(0), {
      i = (i + usize(1));
      continue;
    });
    decl_name := assoc.declaration_name.clone();
    sections := extract_doc_sections(Option(String).Some(assoc.comment.content.clone()));
    key := match(
      assoc.declaration_position,
      .Some(pos) => `${pos.row}:${pos.column}`,
      .None => String.new()
    );
    body_kind := structure.body_kinds.get(decl_name.clone());
    if(structure.top_level_positions.contains(key.clone()), {
      // A top-level declaration — and only an EXPORTED one is an item: the
      // evaluated path documents the module's exports, and a module with no
      // export statement exports nothing (`std/math.yo`'s zero-item page).
      // Both spellings of an aliased export (`export(Label : orig)`) are
      // recorded, so a definition's docs are never dropped for its label's
      // sake.
      if(!structure.exported.contains(decl_name.clone()), {
        i = (i + usize(1));
        continue;
      });
      // A type/trait body decides the entry; an impl receiver is a type
      // (with its methods); anything else is a constant — the shapes the
      // evaluated path would classify the same way, minus the signatures
      // only the evaluator has.
      if(body_kind == Option(String).Some(`trait`), {
        (trait_methods : ArrayList(DocFunction)) = ArrayList(DocFunction).new();
        match(
          structure.trait_body_lparens.get(decl_name.clone()),
          .Some(lp) => {
            extracted := _extract_trait_body_members(&structure.toks, lp, tokens);
            trait_methods = extracted.methods;
          },
          .None => ()
        );
        traits.push(
          DocTrait(
            name : decl_name.clone(),
            doc : Option(String).Some(assoc.comment.content.clone()),
            kind : DocTraitKind.Trait,
            signature : decl_name.clone(),
            type_params : Option(ArrayList(DocParam)).None,
            associated_types : Option(ArrayList(DocAssociatedType)).None,
            methods : trait_methods,
            implementors : ArrayList(String).new(),
            deprecated : sections.deprecated,
            examples : sections.examples
          )
        );
      }, {
        // A type body (`struct(`/`enum(`/`union(`) or an impl receiver is a
        // TYPE; every other top-level declaration is a constant, exactly the
        // split the evaluator's classification would make.
        is_type_entry := (
          body_kind.is_some() || trait_impl_map.get(decl_name.clone()).is_some()
        );
        if(is_type_entry, {
          item_kind := cond(
            (body_kind == Option(String).Some(`enum`)) => DocItemKind.Enum,
            (body_kind == Option(String).Some(`union`)) => DocItemKind.Union,
            true => DocItemKind.Struct
          );
          (methods : ArrayList(DocFunction)) = ArrayList(DocFunction).new();
          (trait_impls : ArrayList(String)) = ArrayList(String).new();
          match(
            impl_info_map.get(decl_name.clone()),
            .Some(info) => {
              methods = info.methods;
            },
            .None => ()
          );
          match(
            trait_impl_map.get(decl_name.clone()),
            .Some(ti) => {
              trait_impls = ti;
            },
            .None => ()
          );
          types.push(
            DocType(
              name : decl_name.clone(),
              doc : Option(String).Some(assoc.comment.content.clone()),
              kind : item_kind,
              signature : decl_name.clone(),
              type_params : Option(ArrayList(DocParam)).None,
              fields : Option(ArrayList(DocField)).None,
              variants : Option(ArrayList(DocVariant)).None,
              methods : methods,
              trait_impls : trait_impls,
              impls : Option(ArrayList(DocImpl)).None,
              deprecated : sections.deprecated,
              examples : sections.examples
            )
          );
          type_index.insert(decl_name.clone(), types.len() - usize(1));
        }, {
          constants.push(
            DocConstant(
              name : decl_name.clone(),
              doc : Option(String).Some(assoc.comment.content.clone()),
              type_ : String.from("(unknown)"),
              value : Option(String).None,
              deprecated : sections.deprecated,
              examples : sections.examples
            )
          );
        });
      });
    }, {
      match(
        structure.member_kinds.get(key.clone()),
        .Some(kind) => {
          // A trait-declared method is covered by the trait body extraction
          // in the top-level arm above; attaching it again would synthesize
          // a bogus TYPE named after the trait.
          if(kind != `trait`, {
            owner := match(
              structure.member_owners.get(key.clone()),
              .Some(o) => o,
              .None => {
                i = (i + usize(1));
                continue;
              }
            );
            // Members of an unexported type are not items either.
            if(!structure.exported.contains(owner.clone()), {
              i = (i + usize(1));
              continue;
            });
            // The owner's own association came first (its comment sits above
            // `Name :: ...`), so a member reaching an owner without an entry
            // means the type is undocumented: synthesize the entry so the
            // member's doc survives on it.
            idx := match(
              type_index.get(owner.clone()),
              .Some(ix) => ix,
              .None => {
                owner_kind := cond(
                  (kind == `enum`) => DocItemKind.Enum,
                  true => DocItemKind.Struct
                );
                types.push(
                  DocType(
                    name : owner.clone(),
                    doc : Option(String).None,
                    kind : owner_kind,
                    signature : owner.clone(),
                    type_params : Option(ArrayList(DocParam)).None,
                    fields : Option(ArrayList(DocField)).None,
                    variants : Option(ArrayList(DocVariant)).None,
                    methods : ArrayList(DocFunction).new(),
                    trait_impls : ArrayList(String).new(),
                    impls : Option(ArrayList(DocImpl)).None,
                    deprecated : Option(String).None,
                    examples : Option(String).None
                  )
                );
                types.len() - usize(1)
              }
            );
            if((kind == `struct`) || (kind == `union`), {
              field_type := match(
                structure.member_field_types.get(key.clone()),
                .Some(t) => t,
                .None => String.from("(unknown)")
              );
              _attach_token_field(
                &types,
                idx,
                DocField(
                  name : decl_name.clone(),
                  type_ : field_type,
                  doc : Option(String).Some(assoc.comment.content.clone()),
                  default_value : Option(String).None
                )
              );
            }, {
              _attach_token_variant(
                &types,
                idx,
                DocVariant(
                  name : decl_name.clone(),
                  fields : Option(ArrayList(DocField)).None,
                  doc : Option(String).Some(assoc.comment.content.clone()),
                  discriminant : Option(String).None
                )
              );
            });
          });
        },
        // An impl-scope member (its doc rides on the receiver type's
        // methods via `impl_info_map`), a trait-declared method (covered
        // by the trait body extraction), a parameter, or the `impl`/
        // `derive`/`export` keywords themselves — none is an item.
        .None => ()
      );
    });
    i = (i + usize(1));
  });
  // Impl receivers with no association of their own still need their type
  // entry: their methods carry docs that must not vanish. Sorted, so the
  // emission order does not depend on the HashMap's iteration order.
  orphan_receivers := ArrayList(String).new();
  // `for(map, ...)` hands out owned entries (into_iter); `iter()` would need
  // raw pointers (same route as lsp/server.yo's workspace/symbols).
  for(impl_info_map, entry => {
    receiver := entry.key;
    if(!type_index.contains_key(receiver.clone()) && structure.exported.contains(receiver.clone()), {
      orphan_receivers.push(receiver.clone());
    });
  });
  orphan_receivers.sort();
  (oi : usize) = usize(0);
  while(oi < orphan_receivers.len(), {
    receiver := match(
      orphan_receivers.get(oi),
      .Some(r) => r,
      .None => {
        oi = (oi + usize(1));
        continue;
      }
    );
    (methods : ArrayList(DocFunction)) = ArrayList(DocFunction).new();
    (trait_impls : ArrayList(String)) = ArrayList(String).new();
    match(
      impl_info_map.get(receiver.clone()),
      .Some(info) => {
        methods = info.methods;
      },
      .None => ()
    );
    match(
      trait_impl_map.get(receiver.clone()),
      .Some(ti) => {
        trait_impls = ti;
      },
      .None => ()
    );
    types.push(
      DocType(
        name : receiver.clone(),
        doc : Option(String).None,
        kind : DocItemKind.Struct,
        signature : receiver.clone(),
        type_params : Option(ArrayList(DocParam)).None,
        fields : Option(ArrayList(DocField)).None,
        variants : Option(ArrayList(DocVariant)).None,
        methods : methods,
        trait_impls : trait_impls,
        impls : Option(ArrayList(DocImpl)).None,
        deprecated : Option(String).None,
        examples : Option(String).None
      )
    );
    oi = (oi + usize(1));
  });
  DocModule(
    name : name,
    path : path,
    doc : module_doc,
    stability : module_stability(&module_doc),
    functions : ArrayList(DocFunction).new(),
    types : types,
    traits : traits,
    constants : constants,
    submodules : ArrayList(Rc(DocModule)).new()
  )
});
/// Fill in `trait.implementors` across all modules from `type.trait_impls`.
/// — mutates in place.
build_cross_references :: (fn(imm(modules) : ArrayList(DocModule)) -> unit)({
  // Collect all trait → implementor relationships (insertion-ordered,
  // deduplicated).
  trait_names := ArrayList(String).new();
  trait_implementors := ArrayList(ArrayList(String)).new();
  (mi : usize) = usize(0);
  while(mi < modules.len(), {
    m := match(
      modules.get(mi),
      .Some(x) => x,
      .None => {
        mi = (mi + usize(1));
        continue;
      }
    );
    (ti : usize) = usize(0);
    while(ti < m.types.len(), {
      t := match(
        m.types.get(ti),
        .Some(x) => x,
        .None => {
          ti = (ti + usize(1));
          continue;
        }
      );
      (tri : usize) = usize(0);
      while(tri < t.trait_impls.len(), {
        trait_name := match(t.trait_impls.get(tri), .Some(n) => n, .None => String.new());
        if(trait_name.len() > usize(0), {
          idx := trait_names.index_of(&trait_name);
          match(
            idx,
            .Some(existing_idx) => {
              lst := match(trait_implementors.get(existing_idx), .Some(l) => l, .None => ArrayList(String).new());
              if(!lst.contains(&t.name), {
                lst.push(t.name.clone());
              });
            },
            .None => {
              lst := ArrayList(String).new();
              lst.push(t.name.clone());
              trait_names.push(trait_name.clone());
              trait_implementors.push(lst);
            }
          );
        });
        tri = (tri + usize(1));
      });
      ti = (ti + usize(1));
    });
    mi = (mi + usize(1));
  });
  // Fill in implementors on traits (sorted).
  (mj : usize) = usize(0);
  while(mj < modules.len(), {
    m := match(
      modules.get(mj),
      .Some(x) => x,
      .None => {
        mj = (mj + usize(1));
        continue;
      }
    );
    (tj : usize) = usize(0);
    while(tj < m.traits.len(), {
      tr := match(
        m.traits.get(tj),
        .Some(x) => x,
        .None => {
          tj = (tj + usize(1));
          continue;
        }
      );
      match(
        trait_names.index_of(&tr.name),
        .Some(found_idx) => {
          impls := match(trait_implementors.get(found_idx), .Some(l) => l, .None => ArrayList(String).new());
          sorted := ArrayList(String).new();
          (si : usize) = usize(0);
          while(si < impls.len(), {
            match(
              impls.get(si),
              .Some(s) => {
                sorted.push(s.clone());
              },
              .None => ()
            );
            si = (si + usize(1));
          });
          sorted.sort();
          m.traits(tj) = DocTrait(
            name : tr.name,
            doc : tr.doc,
            kind : tr.kind,
            signature : tr.signature,
            type_params : tr.type_params,
            associated_types : tr.associated_types,
            methods : tr.methods,
            implementors : sorted,
            deprecated : tr.deprecated,
            examples : tr.examples
          );
        },
        .None => ()
      );
      tj = (tj + usize(1));
    });
    mj = (mj + usize(1));
  });
  _inherit_trait_method_docs(modules);
  _fill_re_exported_docs(modules);
});
/// Fill in the documentation of a RE-EXPORTED declaration from the module that
/// declares it.
///
/// Each module is documented from its OWN file's tokens, so a type declared in
/// `foo/thing.yo` and re-exported by `foo/index.yo` renders bare under the
/// module a reader actually opens — no type doc, and no doc on any method.
/// `std/` is organised exactly that way, which is why `yo doc ./std` reported
/// 1554 of 3345 members undocumented while the source carries a `///` on nearly
/// all of them
/// (issues/fixed/yo-doc-drops-every-doc-comment-of-a-re-exported-type.md).
///
/// This is a fill-in, not an inheritance: a re-exported type IS the declared
/// type, so its doc is that declaration's own text and needs no attribution.
/// Only `.None` is filled, so a module that documents a re-export itself keeps
/// what it wrote — and a donor that reaches itself is therefore a no-op.
///
/// **Matched on name AND signature.** The name alone is not safe — `std/` has
/// several same-named types in different modules — but a genuine re-export is
/// the same declaration, so its rendered signature is identical by
/// construction, while two distinct types sharing a name differ in theirs. A
/// type whose signature matches no documented donor is left alone.
///
/// Runs after `_inherit_trait_method_docs` so a donor that took its method docs
/// from a trait passes those on too, attribution included — the re-export then
/// reads exactly as the declaring module does.
///
/// Writes back by INDEX (`types(ti) = DocType(…)`, `methods(mi) = DocFunction(…)`)
/// because `DocType` and `DocFunction` are value structs: mutating a `.get()`
/// result changes a copy and is silently lost. Same reason the trait-inheritance
/// pass above rebuilds each entry.
_fill_re_exported_docs :: (fn(imm(modules) : ArrayList(DocModule)) -> unit)({
  // Donors: every type that HAS documentation to give, keyed by name+signature.
  d_keys := ArrayList(String).new();
  d_types := ArrayList(DocType).new();
  (mi : usize) = usize(0);
  while(mi < modules.len(), {
    m := match(
      modules.get(mi),
      .Some(x) => x,
      .None => {
        mi = (mi + usize(1));
        continue;
      }
    );
    (ti : usize) = usize(0);
    while(ti < m.types.len(), {
      match(
        m.types.get(ti),
        .Some(t) => {
          score := _doc_type_doc_count(&t);
          if(score > usize(0), {
            key := `${t.name}|${t.signature}`;
            match(
              d_keys.index_of(key.clone()),
              // Keep the RICHEST donor, not the first one seen. A re-exporting
              // module's own entry can carry a doc or two — `String` in
              // `string/index` has `format`, inherited from the `Format` trait
              // — and registering that would let it claim the key and block the
              // declaring module's fully documented entry. Module walk order is
              // not something to depend on either way.
              .Some(di) => if(score > _doc_type_doc_count(match(d_types.get(di), .Some(x) => x, .None => t)), {
                d_types(di) = t;
              }),
              .None => {
                d_keys.push(key);
                d_types.push(t);
              }
            );
          });
        },
        .None => ()
      );
      ti = (ti + usize(1));
    });
    mi = (mi + usize(1));
  });
  // Recipients: every type missing documentation a donor can supply.
  (mj : usize) = usize(0);
  while(mj < modules.len(), {
    m2 := match(
      modules.get(mj),
      .Some(x) => x,
      .None => {
        mj = (mj + usize(1));
        continue;
      }
    );
    (tj : usize) = usize(0);
    while(tj < m2.types.len(), {
      t2 := match(
        m2.types.get(tj),
        .Some(x) => x,
        .None => {
          tj = (tj + usize(1));
          continue;
        }
      );
      match(
        d_keys.index_of(`${t2.name}|${t2.signature}`),
        .Some(di) => match(
          d_types.get(di),
          .Some(donor) => {
            // Methods, fields and variants live in ArrayLists, which are shared
            // handles even through a struct copy — indexed assignment on them
            // reaches the model.
            _fill_doc_methods_from(&mut t2, &donor);
            _fill_doc_fields_from(&t2, &donor);
            _fill_doc_variants_from(&t2, &donor);
            // The type's OWN doc is a value field, so it needs a rebuilt entry.
            if(t2.doc.is_none() && donor.doc.is_some(), {
              m2.types(tj) = DocType(
                name : t2.name,
                doc : donor.doc,
                kind : t2.kind,
                signature : t2.signature,
                type_params : t2.type_params,
                fields : t2.fields,
                variants : t2.variants,
                methods : t2.methods,
                trait_impls : t2.trait_impls,
                impls : t2.impls,
                deprecated : match(t2.deprecated, .Some(d) => .Some(d), .None => donor.deprecated),
                examples : match(t2.examples, .Some(e) => .Some(e), .None => donor.examples)
              );
            });
          },
          .None => ()
        ),
        .None => ()
      );
      tj = (tj + usize(1));
    });
    mj = (mj + usize(1));
  });
});
/// How many documented items this type carries — its own doc, plus every
/// method, field and variant that has one. Used to pick the richest donor for a
/// given name+signature; `0` means it has nothing to give.
_doc_type_doc_count :: (fn(imm(t) : DocType) -> usize)({
  (n : usize) = usize(0);
  if(t.doc.is_some(), {
    n = (n + usize(1));
  });
  (i : usize) = usize(0);
  while(i < t.methods.len(), {
    match(
      t.methods.get(i),
      .Some(f) => if(f.doc.is_some(), {
        n = (n + usize(1));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  match(
    t.fields,
    .Some(fs) => {
      (fi : usize) = usize(0);
      while(fi < fs.len(), {
        match(
          fs.get(fi),
          .Some(f2) => if(f2.doc.is_some(), {
            n = (n + usize(1));
          }),
          .None => ()
        );
        fi = (fi + usize(1));
      });
    },
    .None => ()
  );
  match(
    t.variants,
    .Some(vs) => {
      (vi : usize) = usize(0);
      while(vi < vs.len(), {
        match(
          vs.get(vi),
          .Some(v) => if(v.doc.is_some(), {
            n = (n + usize(1));
          }),
          .None => ()
        );
        vi = (vi + usize(1));
      });
    },
    .None => ()
  );
  n
});
/// Per-name method doc fill-in, carrying the trait attribution with the text.
_fill_doc_methods_from :: (fn(mut(dst) : DocType, imm(src) : DocType) -> unit)({
  (i : usize) = usize(0);
  while(i < dst.methods.len(), {
    match(
      dst.methods.get(i),
      .Some(dm) => if(dm.doc.is_none(), {
        (found : Option(String)) = Option(String).None;
        (found_from : Option(String)) = Option(String).None;
        (j : usize) = usize(0);
        while(j < src.methods.len(), {
          match(
            src.methods.get(j),
            .Some(sm) => if((sm.name == dm.name) && sm.doc.is_some(), {
              found = sm.doc;
              found_from = sm.inherited_from;
              j = src.methods.len();
            }),
            .None => ()
          );
          j = (j + usize(1));
        });
        if(found.is_some(), {
          dst.methods(i) = DocFunction(
            name : dm.name,
            doc : found,
            signature : dm.signature,
            parameters : dm.parameters,
            return_type : dm.return_type,
            type_params : dm.type_params,
            effects : dm.effects,
            is_method : dm.is_method,
            self_type : dm.self_type,
            returns : dm.returns,
            errors : dm.errors,
            deprecated : dm.deprecated,
            examples : dm.examples,
            inherited_from : match(dm.inherited_from, .Some(x) => .Some(x), .None => found_from)
          );
        });
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// Per-name field doc fill-in (structs).
_fill_doc_fields_from :: (fn(imm(dst) : DocType, imm(src) : DocType) -> unit)({
  dfs := match(dst.fields, .Some(x) => x, .None => return(()));
  sfs := match(src.fields, .Some(x) => x, .None => return(()));
  (i : usize) = usize(0);
  while(i < dfs.len(), {
    match(
      dfs.get(i),
      .Some(df) => if(df.doc.is_none(), {
        (j : usize) = usize(0);
        while(j < sfs.len(), {
          match(
            sfs.get(j),
            .Some(sf) => if((sf.name == df.name) && sf.doc.is_some(), {
              dfs(i) = DocField(name : df.name, type_ : df.type_, doc : sf.doc, default_value : df.default_value);
              j = sfs.len();
            }),
            .None => ()
          );
          j = (j + usize(1));
        });
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// Per-name variant doc fill-in (enums).
_fill_doc_variants_from :: (fn(imm(dst) : DocType, imm(src) : DocType) -> unit)({
  dvs := match(dst.variants, .Some(x) => x, .None => return(()));
  svs := match(src.variants, .Some(x) => x, .None => return(()));
  (i : usize) = usize(0);
  while(i < dvs.len(), {
    match(
      dvs.get(i),
      .Some(dv) => if(dv.doc.is_none(), {
        (j : usize) = usize(0);
        while(j < svs.len(), {
          match(
            svs.get(j),
            .Some(sv) => if((sv.name == dv.name) && sv.doc.is_some(), {
              dvs(i) = DocVariant(name : dv.name, fields : dv.fields, doc : sv.doc, discriminant : dv.discriminant);
              j = svs.len();
            }),
            .None => ()
          );
          j = (j + usize(1));
        });
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// Give every undocumented trait-impl method the TRAIT's documentation.
///
/// Rustdoc, which this library follows deliberately, states a method's contract
/// once at the trait and shows it on every implementation that does not
/// override it. `yo doc` did not, so 454 trait-impl methods across `std/`
/// rendered as bare signatures — `hash`, `clone`, `next`, `to_string`,
/// `dispose`, one per implementing type, 139 of them in `std/prelude.yo` alone
/// (`issues/fixed/yo-doc-trait-impl-methods-never-inherit-the-trait-doc.md`).
///
/// The fix belongs here rather than in `std/`: 454 per-instance restatements of
/// "returns the hash of `self`" would be noise, would drift from the trait's
/// text, and would still leave every USER crate's impls blank.
///
/// Two rules, both load-bearing:
///
/// * **An impl-site doc always wins.** Several `std/` impls document a
///   DIVERGENCE at the impl — `imm/*`'s `IntoIterator` says it is eager rather
///   than lazy — and replacing that with the trait's generic text would make
///   the docs actively wrong. Only a method whose `doc` is `.None` inherits.
/// * **The trait must actually be implemented by that type.** The lookup is
///   keyed on the type's own `trait_impls` list, so a method that merely shares
///   a name with some unrelated trait's method inherits nothing.
///
/// Runs after implementors are filled in, over ALL modules, because a trait and
/// its implementors are almost never in the same file: `ToString` lives in
/// `std/fmt/to_string` and is implemented across the whole library.
_inherit_trait_method_docs :: (fn(imm(modules) : ArrayList(DocModule)) -> unit)({
  // trait name -> (method name -> doc). Parallel arrays rather than a map of
  // maps: the trait count is small and this keeps the lookup allocation-free.
  t_names := ArrayList(String).new();
  t_method_names := ArrayList(ArrayList(String)).new();
  t_method_docs := ArrayList(ArrayList(String)).new();
  (mi : usize) = usize(0);
  while(mi < modules.len(), {
    m := match(
      modules.get(mi),
      .Some(x) => x,
      .None => {
        mi = (mi + usize(1));
        continue;
      }
    );
    (ti : usize) = usize(0);
    while(ti < m.traits.len(), {
      tr := match(
        m.traits.get(ti),
        .Some(x) => x,
        .None => {
          ti = (ti + usize(1));
          continue;
        }
      );
      names := ArrayList(String).new();
      docs := ArrayList(String).new();
      (fi : usize) = usize(0);
      while(fi < tr.methods.len(), {
        match(
          tr.methods.get(fi),
          .Some(fnc) => match(
            fnc.doc,
            .Some(d) => if(d.len() > usize(0), {
              names.push(fnc.name.clone());
              docs.push(d.clone());
            }),
            .None => ()
          ),
          .None => ()
        );
        fi = (fi + usize(1));
      });
      if(names.len() > usize(0), {
        t_names.push(tr.name.clone());
        t_method_names.push(names);
        t_method_docs.push(docs);
      });
      ti = (ti + usize(1));
    });
    mi = (mi + usize(1));
  });
  if(t_names.len() == usize(0), {
    return(());
  });
  (mj : usize) = usize(0);
  while(mj < modules.len(), {
    m2 := match(
      modules.get(mj),
      .Some(x) => x,
      .None => {
        mj = (mj + usize(1));
        continue;
      }
    );
    (tj : usize) = usize(0);
    while(tj < m2.types.len(), {
      ty := match(
        m2.types.get(tj),
        .Some(x) => x,
        .None => {
          tj = (tj + usize(1));
          continue;
        }
      );
      (fj : usize) = usize(0);
      while(fj < ty.methods.len(), {
        mm := match(
          ty.methods.get(fj),
          .Some(x) => x,
          .None => {
            fj = (fj + usize(1));
            continue;
          }
        );
        // An impl-site doc wins; only a bare method inherits.
        if(mm.doc.is_none(), {
          (found_doc : Option(String)) = Option(String).None;
          (found_trait : Option(String)) = Option(String).None;
          (ii : usize) = usize(0);
          while((ii < ty.trait_impls.len()) && found_doc.is_none(), {
            tn := match(ty.trait_impls.get(ii), .Some(x) => x, .None => String.new());
            match(
              t_names.index_of(tn.clone()),
              .Some(k) => {
                names := match(t_method_names.get(k), .Some(x) => x, .None => ArrayList(String).new());
                match(
                  names.index_of(mm.name.clone()),
                  .Some(di) => {
                    docs := match(t_method_docs.get(k), .Some(x) => x, .None => ArrayList(String).new());
                    match(
                      docs.get(di),
                      .Some(d2) => {
                        found_doc = Option(String).Some(d2.clone());
                        found_trait = Option(String).Some(tn.clone());
                      },
                      .None => ()
                    );
                  },
                  .None => ()
                );
              },
              .None => ()
            );
            ii = (ii + usize(1));
          });
          if(found_doc.is_some(), {
            ty.methods(fj) = DocFunction(
              name : mm.name,
              doc : found_doc,
              signature : mm.signature,
              parameters : mm.parameters,
              return_type : mm.return_type,
              type_params : mm.type_params,
              effects : mm.effects,
              is_method : mm.is_method,
              self_type : mm.self_type,
              returns : mm.returns,
              errors : mm.errors,
              deprecated : mm.deprecated,
              examples : mm.examples,
              inherited_from : found_trait
            );
          });
        });
        fj = (fj + usize(1));
      });
      tj = (tj + usize(1));
    });
    mj = (mj + usize(1));
  });
});
// ---------------------------------------------------------------------------
// Evaluator half — buildDocModule and its helpers
// ---------------------------------------------------------------------------
///'s return shape.
GenericImplInfo :: struct(
  methods : ArrayList(DocFunction),
  impls : ArrayList(DocImpl),
  trait_impls : ArrayList(String)
);
/// Resolve the "inner" type behind a type-constructor function.
///: when the field is a
/// type-constructor Func and its VALUE is a FuncVal whose registered type has
/// a non-Type return, that return IS the inner struct/enum/trait; a generic
/// constructor (return still Type) keeps the wrapper Func type.
_resolve_inner_type :: (fn(imm(field_type) : TypeValue, imm(value) : EvalValue) -> TypeValue)({
  if(is_function_type(field_type) && is_function_type_and_is_type_function(field_type), {
    match(
      value,
      .FuncVal(data, _) => {
        registered := get_func_type(&data.*.func_id);
        match(
          registered,
          .Func({ result }) => {
            is_type_uni_result := match(result, .TypeUni(_) => true, _ => false);
            if(!is_type_uni_result, {
              return(result);
            });
          },
          _ => ()
        );
      },
      _ => ()
    );
    return(field_type);
  });
  field_type
});
/// Convert a Func type's value parameters to DocParams. Per-param comptime
/// flags and defaults ride the func-id side tables (evaluator/types/function.yo)
/// keyed by `meta.origin_id`; the default VALUE is side-tabled, so
/// `value_to_string` stands in.
_function_params_to_doc_params :: (
  fn(imm(func_type) : TypeValue, imm(doc_lookup) : Option(HashMap(String, String))) -> ArrayList(DocParam)
)({
  out := ArrayList(DocParam).new();
  match(
    func_type,
    .Func({ param_types, meta }) => {
      labels := meta.*.param_labels;
      origin := match(meta.*.origin_id, .Some(oid) => oid, .None => String.new());
      comptime_flags := get_func_param_comptime(&origin);
      defaults := get_func_param_defaults(&origin);
      (i : usize) = usize(0);
      while((i < labels.len()) && (i < param_types.len()), {
        label := match(labels.get(i), .Some(l) => l, .None => String.new());
        ty := match(
          param_types.get(i),
          .Some(t) => t,
          .None => {
            i = (i + usize(1));
            continue;
          }
        );
        is_ct := match(comptime_flags.get(i), .Some(b) => b, .None => false);
        (default_str : Option(String)) = Option(String).None;
        match(
          defaults.get(i),
          .Some(.Some(v)) => {
            default_str = Option(String).Some(value_to_string(&v));
          },
          .Some(.None) => (),
          .None => ()
        );
        (doc : Option(String)) = Option(String).None;
        match(
          doc_lookup,
          .Some(dl) => {
            doc = dl.get(label.clone());
          },
          .None => ()
        );
        out.push(
          DocParam(
            name : label.clone(),
            type_ : type_to_string(&ty),
            is_comptime : is_ct,
            is_implicit : false,
            default_value : default_str,
            doc : doc
          )
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  );
  out
});
/// Convert a Func type's generic (forall) parameters to DocParams — always
/// comptime, no defaults.
_forall_params_to_doc_params :: (
  fn(imm(func_type) : TypeValue, imm(doc_lookup) : Option(HashMap(String, String))) -> ArrayList(DocParam)
)({
  out := ArrayList(DocParam).new();
  match(
    func_type,
    .Func({ forall_types, meta }) => {
      labels := meta.*.forall_labels;
      (i : usize) = usize(0);
      while((i < labels.len()) && (i < forall_types.len()), {
        label := match(labels.get(i), .Some(l) => l, .None => String.new());
        ty := match(
          forall_types.get(i),
          .Some(t) => t,
          .None => {
            i = (i + usize(1));
            continue;
          }
        );
        (doc : Option(String)) = Option(String).None;
        match(
          doc_lookup,
          .Some(dl) => {
            doc = dl.get(label.clone());
          },
          .None => ()
        );
        out.push(
          DocParam(
            name : label.clone(),
            type_ : type_to_string(&ty),
            is_comptime : true,
            is_implicit : false,
            default_value : Option(String).None,
            doc : doc
          )
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  );
  out
});
/// Build a DocFunction from a Func TypeValue.
build_doc_function :: (
  fn(
    imm(name) : String,
    imm(func_type) : TypeValue,
    imm(doc) : Option(String),
    is_method : bool,
    imm(self_type) : Option(String),
    imm(doc_lookup) : Option(HashMap(String, String)),
    /// Prepended as `(Receiver) fn(...)` in the signature: Func has no
    /// self-type field, so the registry-method path passes the receiver name
    /// here; "" = no prefix (trait/module/token/generic-impl methods render
    /// unprefixed).
    imm(signature_prefix) : String,
    /// A source-derived signature (top-level `name :: (fn ...)(...)`
    /// declarations only) is the canonical form: it preserves
    /// where-constraints and `?=` defaults exactly as written and never
    /// leaks internal wrappers like `comptime(T)` the way type_to_string
    /// does. See issues/fixed/doc-builder-generic-signature-divergence.md.
    imm(source_info) : Option(SourceSignatureInfo)
  ) -> DocFunction
)({
  base_signature := match(
    source_info,
    .Some(si) => si.signature.clone(),
    .None => type_to_string(func_type)
  );
  signature := if(signature_prefix.len() > usize(0), `(${signature_prefix}) ${base_signature}`, base_signature.clone());
  (returns : Option(String)) = Option(String).None;
  (errors : Option(String)) = Option(String).None;
  (deprecated : Option(String)) = Option(String).None;
  (examples : Option(String)) = Option(String).None;
  match(
    doc,
    .Some(text) => {
      parsed := parse_doc_comment(&text);
      returns = parsed.sections.get(String.from("returns"));
      errors = parsed.sections.get(String.from("errors"));
      deprecated = parsed.sections.get(String.from("deprecated"));
      examples = parsed.sections.get(String.from("examples"));
    },
    .None => ()
  );
  (return_type : String) = String.from("unknown");
  (type_params : Option(ArrayList(DocParam))) = Option(ArrayList(DocParam)).None;
  (parameters : ArrayList(DocParam)) = ArrayList(DocParam).new();
  match(
    source_info,
    .Some(si) => {
      return_type = si.return_type.clone();
      if(si.type_params.len() > usize(0), {
        type_params = Option(ArrayList(DocParam)).Some(_with_param_docs(&si.type_params, doc_lookup));
      });
      parameters = _with_param_docs(&si.parameters, doc_lookup);
    },
    .None => {
      match(
        func_type,
        .Func({ result, meta }) => {
          return_type = type_to_string(&result);
          if(meta.*.forall_labels.len() > usize(0), {
            type_params = Option(ArrayList(DocParam)).Some(_forall_params_to_doc_params(func_type, doc_lookup));
          });
        },
        _ => ()
      );
      parameters = _function_params_to_doc_params(func_type, doc_lookup);
    }
  );
  DocFunction(
    name : name,
    doc : doc,
    signature : signature,
    parameters : parameters,
    return_type : return_type,
    type_params : type_params,
    effects : Option(ArrayList(DocParam)).None,
    is_method : is_method,
    self_type : self_type,
    returns : returns,
    errors : errors,
    deprecated : deprecated,
    examples : examples,
    inherited_from : Option(String).None
  )
});
/// The nominal name of a named type, "" otherwise.
_doc_type_name :: (fn(imm(t) : TypeValue) -> String)(
  match(
    t,
    .Struct({ name }) => name.clone(),
    .EnumT({ name }) => name.clone(),
    .Union({ name }) => name.clone(),
    .TraitT({ name }) => name.clone(),
    _ => String.new()
  )
);
/// Extract a type's methods. Members are not attached to the type itself;
/// they live in the type_trait_methods registry keyed by the
/// type's id. `___`-prefixed (compiler-generated) members are skipped.
_extract_methods :: (
  fn(imm(type_id) : String, imm(type_name) : String, imm(doc_lookup) : HashMap(String, String)) -> ArrayList(DocFunction)
)({
  methods := ArrayList(DocFunction).new();
  if(type_id.len() == usize(0), {
    return(methods);
  });
  entries := get_type_trait_methods_for_type(type_id);
  (i : usize) = usize(0);
  while(i < entries.len(), {
    entry := match(
      entries.get(i),
      .Some(e) => e,
      .None => {
        i = (i + usize(1));
        continue;
      }
    );
    if(is_function_type(&entry.ty) && !entry.label.starts_with(String.from("___")), {
      (receiver_name : String) = type_name.clone();
      match(
        entry.self_type,
        .Some(st) => {
          st_name := _doc_type_name(&st);
          if(st_name.len() > usize(0), {
            receiver_name = st_name;
          });
        },
        .None => ()
      );
      methods.push(
        build_doc_function(
          entry.label.clone(),
          &entry.ty,
          _method_doc(doc_lookup, type_name.clone(), entry.label.clone()),
          true,
          Option(String).Some(type_name.clone()),
          Option(HashMap(String, String)).Some(doc_lookup),
          &receiver_name,
          Option(SourceSignatureInfo).None
        )
      );
    });
    i = (i + usize(1));
  });
  methods
});
/// Extract generic-impl info: the registry's matched
/// entries as DocFunctions + DocImpls + trait names. DocImpl entries emit the
/// declared DocImpl shape — the model carries no extra raw-FunctionType
/// `methods` array.
_extract_generic_impl_info :: (
  fn(
    imm(concrete_type) : TypeValue,
    imm(type_name) : String,
    imm(doc_lookup) : HashMap(String, String),
    imm(env) : Environment
  ) -> GenericImplInfo
)({
  entries := get_generic_impl_doc_entries(concrete_type, env, type_name.clone());
  methods := ArrayList(DocFunction).new();
  impls := ArrayList(DocImpl).new();
  trait_impls := ArrayList(String).new();
  seen_method_names := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < entries.len(), {
    entry := match(
      entries.get(i),
      .Some(e) => e,
      .None => {
        i = (i + usize(1));
        continue;
      }
    );
    match(
      entry.trait_name,
      .Some(tn) => if(!trait_impls.contains(&tn), {
        trait_impls.push(tn.clone());
      }),
      .None => ()
    );
    (mi : usize) = usize(0);
    while((mi < entry.method_names.len()) && (mi < entry.method_types.len()), {
      m_name := match(entry.method_names.get(mi), .Some(n) => n, .None => String.new());
      m_type := match(
        entry.method_types.get(mi),
        .Some(t) => t,
        .None => {
          mi = (mi + usize(1));
          continue;
        }
      );
      if(!seen_method_names.contains(&m_name), {
        seen_method_names.push(m_name.clone());
        methods.push(
          build_doc_function(
            m_name.clone(),
            &m_type,
            _method_doc(doc_lookup, type_name.clone(), m_name.clone()),
            true,
            Option(String).Some(type_name.clone()),
            Option(HashMap(String, String)).Some(doc_lookup),
            String.new(),
            Option(SourceSignatureInfo).None
          )
        );
      });
      mi = (mi + usize(1));
    });
    impls.push(
      DocImpl(
        signature : entry.signature.clone(),
        trait_name : entry.trait_name,
        method_names : entry.method_names,
        associated_types : Option(ArrayList(DocImplAssocType)).None
      )
    );
    i = (i + usize(1));
  });
  GenericImplInfo(methods : methods, impls : impls, trait_impls : trait_impls)
});
_get_type_kind :: (fn(imm(t) : TypeValue) -> DocItemKind)({
  if(is_struct_type(t), {
    return(
      match(
        t,
        .Struct({ is_reference_semantics, is_atomic_rc, is_newtype }) => cond(
          is_newtype => DocItemKind.Newtype,
          is_atomic_rc => DocItemKind.AtomicObject,
          is_reference_semantics => DocItemKind.Object,
          true => DocItemKind.Struct
        ),
        _ => DocItemKind.Struct
      )
    );
  });
  cond(
    is_enum_type(t) => DocItemKind.Enum,
    is_union_type(t) => DocItemKind.Union,
    is_trait_type(t) => DocItemKind.Trait,
    is_module_type(t) => DocItemKind.Module,
    true => DocItemKind.TypeAlias
  )
});
/// Struct/Union
/// TypeValues carry no per-field default values (they live in func-id side
/// tables that do not apply to type fields), so `default_value` is `.None`.
_type_fields_to_doc_fields :: (
  fn(
    imm(field_labels) : ArrayList(String),
    imm(field_types) : ArrayList(TypeValue),
    imm(doc_lookup) : HashMap(String, String)
  ) -> ArrayList(DocField)
)({
  out := ArrayList(DocField).new();
  (i : usize) = usize(0);
  while((i < field_labels.len()) && (i < field_types.len()), {
    label := match(field_labels.get(i), .Some(l) => l, .None => String.new());
    ty := match(
      field_types.get(i),
      .Some(t) => t,
      .None => {
        i = (i + usize(1));
        continue;
      }
    );
    out.push(
      DocField(
        name : label.clone(),
        type_ : type_to_string(&ty),
        doc : doc_lookup.get(label.clone()),
        default_value : Option(String).None
      )
    );
    i = (i + usize(1));
  });
  out
});
/// Every variant carries a
/// discriminant (auto-numbered when not explicit), so the
/// always-populated `variant_discriminants` matches. A payload-free variant
/// (empty field list) gets `.None` fields.
_enum_variants_to_doc_variants :: (
  fn(imm(enum_type) : TypeValue, imm(doc_lookup) : HashMap(String, String)) -> ArrayList(DocVariant)
)({
  out := ArrayList(DocVariant).new();
  match(
    enum_type,
    .EnumT({ variant_names, variant_fields, variant_field_labels, variant_discriminants }) => {
      (i : usize) = usize(0);
      while(i < variant_names.len(), {
        v_name := match(variant_names.get(i), .Some(n) => n, .None => String.new());
        v_field_types := match(variant_fields.get(i), .Some(f) => f, .None => ArrayList(TypeValue).new());
        v_field_labels := match(variant_field_labels.get(i), .Some(l) => l, .None => ArrayList(String).new());
        (fields_opt : Option(ArrayList(DocField))) = Option(ArrayList(DocField)).None;
        if(v_field_types.len() > usize(0), {
          fields_opt = Option(ArrayList(DocField)).Some(_type_fields_to_doc_fields(&v_field_labels, &v_field_types, doc_lookup));
        });
        (disc : Option(String)) = Option(String).None;
        match(
          variant_discriminants.get(i),
          .Some(d) => {
            disc = Option(String).Some(d.to_string());
          },
          .None => ()
        );
        out.push(
          DocVariant(
            name : v_name.clone(),
            fields : fields_opt,
            doc : doc_lookup.get(v_name.clone()),
            discriminant : disc
          )
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  );
  out
});
/// Extract the generic params of a type-constructor field, from forall
/// params or comptime value params.
_get_type_constructor_params :: (fn(imm(field_type) : TypeValue) -> Option(ArrayList(DocParam)))({
  if(!(is_function_type(field_type) && is_function_type_and_is_type_function(field_type)), {
    return(Option(ArrayList(DocParam)).None);
  });
  has_forall := match(
    field_type,
    .Func({ meta }) => (meta.*.forall_labels.len() > usize(0)),
    _ => false
  );
  if(has_forall, {
    return(Option(ArrayList(DocParam)).Some(_forall_params_to_doc_params(field_type, Option(HashMap(String, String)).None)));
  });
  // Regular comptime params used as type params.
  all_params := _function_params_to_doc_params(field_type, Option(HashMap(String, String)).None);
  comptime_params := ArrayList(DocParam).new();
  (i : usize) = usize(0);
  while(i < all_params.len(), {
    match(
      all_params.get(i),
      .Some(p) => if(p.is_comptime, {
        comptime_params.push(p);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  if(comptime_params.len() > usize(0), {
    return(Option(ArrayList(DocParam)).Some(comptime_params));
  });
  Option(ArrayList(DocParam)).None
});
/// The nominal id of a named type, "" otherwise (for the method registry).
_doc_type_id :: (fn(imm(t) : TypeValue) -> String)(
  match(
    t,
    .Struct({ id }) => id.clone(),
    .EnumT({ id }) => id.clone(),
    .TraitT({ id }) => id.clone(),
    _ => String.new()
  )
);
/// Build a DocModule from evaluator output and extracted doc comments.
/// `module_value`/`module_type`
/// come from module_manager's load outcome (the type is carried separately
/// since FuncVals are untyped).
/// Is `field_name` a compiler-internal module field rather than public API?
///
/// Three shapes, none of which may reach a page, a sidebar link or the search
/// index:
///
/// - the empty label an anonymous impl block carries;
/// - `___*` (synthesized RC / trait plumbing) and `__yo_*` (runtime builtins);
/// - the evaluator's TEMPORARIES — `_<sanitized module path>_temp_<digits>`,
///   minted by `generate_new_temp_variable_name` (src/utils.yo).
///
/// The prefix list handled the first two and silently admitted the third for
/// as long as `yo doc` has existed: 790 of them were published as `constant`
/// entries in `prelude` alone. A temp's prefix is the MODULE PATH, so its
/// spelling differs per module (`__private_tmp_temp_…` is only what the
/// prelude's path sanitizes to) — matching a literal prefix would clean one
/// module and miss every other, which is why this defers to the canonical
/// `is_any_temp_variable_name`. The LSP's completion list had the same bug
/// and the same fix (issues/fixed/lsp-completion-lists-compiler-temporaries.md).
is_compiler_internal_field_name :: (fn(imm(field_name) : String) -> bool)(
  (field_name.len() == usize(0)) || field_name.starts_with(String.from("___")) || field_name.starts_with(String.from("__yo_")) || is_any_temp_variable_name(field_name)
);
build_doc_module :: (
  fn(
    imm(name) : String,
    imm(path) : String,
    imm(module_value) : EvalValue,
    imm(module_type) : TypeValue,
    imm(extraction) : DocExtractionResult,
    imm(tokens) : ArrayList(Token),
    imm(env) : Environment
  ) -> DocModule
)({
  doc_lookup := build_doc_lookup(extraction);
  trait_impl_map := extract_trait_impls_from_tokens(tokens);
  token_impl_info_map := extract_impl_info_from_tokens(tokens, &mut doc_lookup);
  source_fn_signatures := _extract_top_level_fn_signatures(tokens);
  (module_doc : Option(String)) = Option(String).None;
  match(
    extraction.module_doc,
    .Some(md) => {
      module_doc = Option(String).Some(md.content.clone());
    },
    .None => ()
  );
  functions := ArrayList(DocFunction).new();
  types := ArrayList(DocType).new();
  traits := ArrayList(DocTrait).new();
  constants := ArrayList(DocConstant).new();
  result := DocModule(
    name : name.clone(),
    path : path.clone(),
    doc : module_doc,
    stability : module_stability(&module_doc),
    functions : functions,
    types : types,
    traits : traits,
    constants : constants,
    submodules : ArrayList(Rc(DocModule)).new()
  );
  if(!is_module_type(module_type), {
    return(result);
  });
  (ns_field_labels : ArrayList(String)) = ArrayList(String).new();
  (ns_field_types : ArrayList(TypeValue)) = ArrayList(TypeValue).new();
  match(
    module_type,
    .Struct({ field_labels, field_types }) => {
      ns_field_labels = field_labels;
      ns_field_types = field_types;
    },
    _ => ()
  );
  (value_list : ArrayList(EvalValue)) = ArrayList(EvalValue).new();
  match(
    module_value,
    .StructVal(_, _, field_values) => {
      value_list = field_values;
    },
    _ => ()
  );
  (i : usize) = usize(0);
  while(i < ns_field_labels.len(), {
    field_name := match(ns_field_labels.get(i), .Some(l) => l, .None => String.new());
    field_type := match(
      ns_field_types.get(i),
      .Some(t) => t,
      .None => {
        i = (i + usize(1));
        continue;
      }
    );
    value := match(value_list.get(i), .Some(v) => v, .None => EvalValue.UnitVal);
    doc := doc_lookup.get(field_name.clone());
    // Skip empty-label fields (anonymous impl blocks) and compiler-internal
    // names.
    if(is_compiler_internal_field_name(field_name.clone()), {
      i = (i + usize(1));
      continue;
    });
    // -- Type declarations (value holds the actual type) --
    (handled : bool) = false;
    match(
      value,
      .TypeVal(actual_type) => {
        handled = true;
        sections := extract_doc_sections(&doc);
        cond(
          is_struct_type(&actual_type) => {
            direct_methods := _extract_methods(_doc_type_id(&actual_type), field_name.clone(), &doc_lookup);
            generic_impl_info := _extract_generic_impl_info(&actual_type, field_name.clone(), &doc_lookup, env);
            (token_methods : ArrayList(DocFunction)) = ArrayList(DocFunction).new();
            (token_trait_impls : ArrayList(String)) = ArrayList(String).new();
            (token_impls : ArrayList(DocImpl)) = ArrayList(DocImpl).new();
            match(
              token_impl_info_map.get(field_name.clone()),
              .Some(tii) => {
                token_methods = tii.methods;
                token_trait_impls = tii.trait_impls;
                token_impls = tii.impls;
              },
              .None => ()
            );
            all_impls := ArrayList(DocImpl).new();
            (gi : usize) = usize(0);
            while(gi < generic_impl_info.impls.len(), {
              match(
                generic_impl_info.impls.get(gi),
                .Some(im) => {
                  all_impls.push(im);
                },
                .None => ()
              );
              gi = (gi + usize(1));
            });
            (ti2 : usize) = usize(0);
            while(ti2 < token_impls.len(), {
              match(
                token_impls.get(ti2),
                .Some(im) => {
                  all_impls.push(im);
                },
                .None => ()
              );
              ti2 = (ti2 + usize(1));
            });
            (st_fields : ArrayList(DocField)) = ArrayList(DocField).new();
            match(
              actual_type,
              .Struct({ field_labels : sfl, field_types : sft }) => {
                st_fields = _type_fields_to_doc_fields(&sfl, &sft, &doc_lookup);
              },
              _ => ()
            );
            base_trait_impls := match(
              trait_impl_map.get(field_name.clone()),
              .Some(l) => l,
              .None => ArrayList(String).new()
            );
            types.push(
              DocType(
                name : field_name.clone(),
                doc : doc,
                kind : _get_type_kind(&actual_type),
                signature : type_to_string(&actual_type),
                type_params : _get_type_constructor_params(&field_type),
                fields : Option(ArrayList(DocField)).Some(st_fields),
                variants : Option(ArrayList(DocVariant)).None,
                methods : merge_methods(merge_methods(&direct_methods, &generic_impl_info.methods), &token_methods),
                trait_impls : merge_trait_impl_names(merge_trait_impl_names(&base_trait_impls, &generic_impl_info.trait_impls), &token_trait_impls),
                impls : Option(ArrayList(DocImpl)).Some(all_impls),
                deprecated : sections.deprecated,
                examples : sections.examples
              )
            );
          },
          is_enum_type(&actual_type) => {
            direct_methods := _extract_methods(_doc_type_id(&actual_type), field_name.clone(), &doc_lookup);
            generic_impl_info := _extract_generic_impl_info(&actual_type, field_name.clone(), &doc_lookup, env);
            (token_methods : ArrayList(DocFunction)) = ArrayList(DocFunction).new();
            (token_trait_impls : ArrayList(String)) = ArrayList(String).new();
            (token_impls : ArrayList(DocImpl)) = ArrayList(DocImpl).new();
            match(
              token_impl_info_map.get(field_name.clone()),
              .Some(tii) => {
                token_methods = tii.methods;
                token_trait_impls = tii.trait_impls;
                token_impls = tii.impls;
              },
              .None => ()
            );
            all_impls := ArrayList(DocImpl).new();
            (gi : usize) = usize(0);
            while(gi < generic_impl_info.impls.len(), {
              match(
                generic_impl_info.impls.get(gi),
                .Some(im) => {
                  all_impls.push(im);
                },
                .None => ()
              );
              gi = (gi + usize(1));
            });
            (ti2 : usize) = usize(0);
            while(ti2 < token_impls.len(), {
              match(
                token_impls.get(ti2),
                .Some(im) => {
                  all_impls.push(im);
                },
                .None => ()
              );
              ti2 = (ti2 + usize(1));
            });
            base_trait_impls := match(
              trait_impl_map.get(field_name.clone()),
              .Some(l) => l,
              .None => ArrayList(String).new()
            );
            types.push(
              DocType(
                name : field_name.clone(),
                doc : doc,
                kind : DocItemKind.Enum,
                signature : type_to_string(&actual_type),
                type_params : _get_type_constructor_params(&field_type),
                fields : Option(ArrayList(DocField)).None,
                variants : Option(ArrayList(DocVariant)).Some(_enum_variants_to_doc_variants(&actual_type, &doc_lookup)),
                methods : merge_methods(merge_methods(&direct_methods, &generic_impl_info.methods), &token_methods),
                trait_impls : merge_trait_impl_names(merge_trait_impl_names(&base_trait_impls, &generic_impl_info.trait_impls), &token_trait_impls),
                impls : Option(ArrayList(DocImpl)).Some(all_impls),
                deprecated : sections.deprecated,
                examples : sections.examples
              )
            );
          },
          is_union_type(&actual_type) => {
            generic_impl_info := _extract_generic_impl_info(&actual_type, field_name.clone(), &doc_lookup, env);
            (token_methods : ArrayList(DocFunction)) = ArrayList(DocFunction).new();
            (token_trait_impls : ArrayList(String)) = ArrayList(String).new();
            (token_impls : ArrayList(DocImpl)) = ArrayList(DocImpl).new();
            match(
              token_impl_info_map.get(field_name.clone()),
              .Some(tii) => {
                token_methods = tii.methods;
                token_trait_impls = tii.trait_impls;
                token_impls = tii.impls;
              },
              .None => ()
            );
            all_impls := ArrayList(DocImpl).new();
            (gi : usize) = usize(0);
            while(gi < generic_impl_info.impls.len(), {
              match(
                generic_impl_info.impls.get(gi),
                .Some(im) => {
                  all_impls.push(im);
                },
                .None => ()
              );
              gi = (gi + usize(1));
            });
            (ti2 : usize) = usize(0);
            while(ti2 < token_impls.len(), {
              match(
                token_impls.get(ti2),
                .Some(im) => {
                  all_impls.push(im);
                },
                .None => ()
              );
              ti2 = (ti2 + usize(1));
            });
            (un_fields : ArrayList(DocField)) = ArrayList(DocField).new();
            match(
              actual_type,
              .Union(_, ufl, uft) => {
                un_fields = _type_fields_to_doc_fields(&ufl, &uft, &doc_lookup);
              },
              _ => ()
            );
            base_trait_impls := match(
              trait_impl_map.get(field_name.clone()),
              .Some(l) => l,
              .None => ArrayList(String).new()
            );
            types.push(
              DocType(
                name : field_name.clone(),
                doc : doc,
                kind : DocItemKind.Union,
                signature : type_to_string(&actual_type),
                type_params : _get_type_constructor_params(&field_type),
                fields : Option(ArrayList(DocField)).Some(un_fields),
                variants : Option(ArrayList(DocVariant)).None,
                methods : merge_methods(&generic_impl_info.methods, &token_methods),
                trait_impls : merge_trait_impl_names(merge_trait_impl_names(&base_trait_impls, &generic_impl_info.trait_impls), &token_trait_impls),
                impls : Option(ArrayList(DocImpl)).Some(all_impls),
                deprecated : sections.deprecated,
                examples : sections.examples
              )
            );
          },
          is_trait_type(&actual_type) => {
            trait_methods := ArrayList(DocFunction).new();
            associated_types := ArrayList(DocAssociatedType).new();
            match(
              actual_type,
              .TraitT({ assoc_type_names, field_labels : tfl, field_types : tft }) => {
                (fi : usize) = usize(0);
                while((fi < tfl.len()) && (fi < tft.len()), {
                  t_label := match(tfl.get(fi), .Some(l) => l, .None => String.new());
                  t_type := match(
                    tft.get(fi),
                    .Some(t) => t,
                    .None => {
                      fi = (fi + usize(1));
                      continue;
                    }
                  );
                  if(assoc_type_names.contains(&t_label), {
                    associated_types.push(
                      DocAssociatedType(
                        name : t_label.clone(),
                        doc : doc_lookup.get(t_label.clone()),
                        constraint : Option(String).Some(type_to_string(&t_type))
                      )
                    );
                  }, {
                    if(is_function_type(&t_type) && !t_label.starts_with(String.from("___")), {
                      trait_methods.push(
                        build_doc_function(
                          t_label.clone(),
                          &t_type,
                          doc_lookup.get(t_label.clone()),
                          true,
                          Option(String).Some(field_name.clone()),
                          Option(HashMap(String, String)).Some(doc_lookup),
                          String.new(),
                          Option(SourceSignatureInfo).None
                        )
                      );
                    });
                  });
                  fi = (fi + usize(1));
                });
              },
              _ => ()
            );
            (assoc_opt : Option(ArrayList(DocAssociatedType))) = Option(ArrayList(DocAssociatedType)).None;
            if(associated_types.len() > usize(0), {
              assoc_opt = Option(ArrayList(DocAssociatedType)).Some(associated_types);
            });
            traits.push(
              DocTrait(
                name : field_name.clone(),
                doc : doc,
                kind : DocTraitKind.Trait,
                signature : type_to_string(&actual_type),
                type_params : _get_type_constructor_params(&field_type),
                associated_types : assoc_opt,
                methods : trait_methods,
                implementors : ArrayList(String).new(),
                deprecated : sections.deprecated,
                examples : sections.examples
              )
            );
          },
          is_module_type(&actual_type) => {
            module_methods := ArrayList(DocFunction).new();
            match(
              actual_type,
              .Struct({ field_labels : mfl, field_types : mft }) => {
                (fi : usize) = usize(0);
                while((fi < mfl.len()) && (fi < mft.len()), {
                  m_label := match(mfl.get(fi), .Some(l) => l, .None => String.new());
                  m_type := match(
                    mft.get(fi),
                    .Some(t) => t,
                    .None => {
                      fi = (fi + usize(1));
                      continue;
                    }
                  );
                  if(is_function_type(&m_type) && !m_label.starts_with(String.from("___")) && (m_label.len() > usize(0)), {
                    module_methods.push(
                      build_doc_function(
                        m_label.clone(),
                        &m_type,
                        doc_lookup.get(m_label.clone()),
                        true,
                        Option(String).Some(field_name.clone()),
                        Option(HashMap(String, String)).Some(doc_lookup),
                        String.new(),
                        Option(SourceSignatureInfo).None
                      )
                    );
                  });
                  fi = (fi + usize(1));
                });
              },
              _ => ()
            );
            traits.push(
              DocTrait(
                name : field_name.clone(),
                doc : doc,
                kind : DocTraitKind.Module,
                signature : type_to_string(&actual_type),
                type_params : _get_type_constructor_params(&field_type),
                associated_types : Option(ArrayList(DocAssociatedType)).None,
                methods : module_methods,
                implementors : ArrayList(String).new(),
                deprecated : sections.deprecated,
                examples : sections.examples
              )
            );
          },
          true => {
            // Other TypeValue — document as a type alias.
            base_trait_impls := match(
              trait_impl_map.get(field_name.clone()),
              .Some(l) => l,
              .None => ArrayList(String).new()
            );
            types.push(
              DocType(
                name : field_name.clone(),
                doc : doc,
                kind : DocItemKind.TypeAlias,
                signature : type_to_string(&actual_type),
                type_params : Option(ArrayList(DocParam)).None,
                fields : Option(ArrayList(DocField)).None,
                variants : Option(ArrayList(DocVariant)).None,
                methods : ArrayList(DocFunction).new(),
                trait_impls : base_trait_impls,
                impls : Option(ArrayList(DocImpl)).None,
                deprecated : sections.deprecated,
                examples : sections.examples
              )
            );
          }
        );
      },
      _ => ()
    );
    if(handled, {
      i = (i + usize(1));
      continue;
    });
    // -- Function declarations --
    if(is_function_type(&field_type), {
      if(is_function_type_and_is_type_function(&field_type), {
        inner_type := _resolve_inner_type(&field_type, &value);
        sections := extract_doc_sections(&doc);
        cond(
          is_struct_type(&inner_type) => {
            direct_methods := _extract_methods(_doc_type_id(&inner_type), field_name.clone(), &doc_lookup);
            generic_impl_info := _extract_generic_impl_info(&inner_type, field_name.clone(), &doc_lookup, env);
            (token_methods : ArrayList(DocFunction)) = ArrayList(DocFunction).new();
            (token_trait_impls : ArrayList(String)) = ArrayList(String).new();
            (token_impls : ArrayList(DocImpl)) = ArrayList(DocImpl).new();
            match(
              token_impl_info_map.get(field_name.clone()),
              .Some(tii) => {
                token_methods = tii.methods;
                token_trait_impls = tii.trait_impls;
                token_impls = tii.impls;
              },
              .None => ()
            );
            all_impls := ArrayList(DocImpl).new();
            (gi : usize) = usize(0);
            while(gi < generic_impl_info.impls.len(), {
              match(
                generic_impl_info.impls.get(gi),
                .Some(im) => {
                  all_impls.push(im);
                },
                .None => ()
              );
              gi = (gi + usize(1));
            });
            (ti2 : usize) = usize(0);
            while(ti2 < token_impls.len(), {
              match(
                token_impls.get(ti2),
                .Some(im) => {
                  all_impls.push(im);
                },
                .None => ()
              );
              ti2 = (ti2 + usize(1));
            });
            (st_fields : ArrayList(DocField)) = ArrayList(DocField).new();
            match(
              inner_type,
              .Struct({ field_labels : sfl, field_types : sft }) => {
                st_fields = _type_fields_to_doc_fields(&sfl, &sft, &doc_lookup);
              },
              _ => ()
            );
            base_trait_impls := match(
              trait_impl_map.get(field_name.clone()),
              .Some(l) => l,
              .None => ArrayList(String).new()
            );
            types.push(
              DocType(
                name : field_name.clone(),
                doc : doc,
                kind : _get_type_kind(&inner_type),
                signature : type_to_string(&field_type),
                type_params : _get_type_constructor_params(&field_type),
                fields : Option(ArrayList(DocField)).Some(st_fields),
                variants : Option(ArrayList(DocVariant)).None,
                methods : merge_methods(merge_methods(&direct_methods, &generic_impl_info.methods), &token_methods),
                trait_impls : merge_trait_impl_names(merge_trait_impl_names(&base_trait_impls, &generic_impl_info.trait_impls), &token_trait_impls),
                impls : Option(ArrayList(DocImpl)).Some(all_impls),
                deprecated : sections.deprecated,
                examples : sections.examples
              )
            );
          },
          is_enum_type(&inner_type) => {
            direct_methods := _extract_methods(_doc_type_id(&inner_type), field_name.clone(), &doc_lookup);
            generic_impl_info := _extract_generic_impl_info(&inner_type, field_name.clone(), &doc_lookup, env);
            (token_methods : ArrayList(DocFunction)) = ArrayList(DocFunction).new();
            (token_trait_impls : ArrayList(String)) = ArrayList(String).new();
            (token_impls : ArrayList(DocImpl)) = ArrayList(DocImpl).new();
            match(
              token_impl_info_map.get(field_name.clone()),
              .Some(tii) => {
                token_methods = tii.methods;
                token_trait_impls = tii.trait_impls;
                token_impls = tii.impls;
              },
              .None => ()
            );
            all_impls := ArrayList(DocImpl).new();
            (gi : usize) = usize(0);
            while(gi < generic_impl_info.impls.len(), {
              match(
                generic_impl_info.impls.get(gi),
                .Some(im) => {
                  all_impls.push(im);
                },
                .None => ()
              );
              gi = (gi + usize(1));
            });
            (ti2 : usize) = usize(0);
            while(ti2 < token_impls.len(), {
              match(
                token_impls.get(ti2),
                .Some(im) => {
                  all_impls.push(im);
                },
                .None => ()
              );
              ti2 = (ti2 + usize(1));
            });
            base_trait_impls := match(
              trait_impl_map.get(field_name.clone()),
              .Some(l) => l,
              .None => ArrayList(String).new()
            );
            types.push(
              DocType(
                name : field_name.clone(),
                doc : doc,
                kind : DocItemKind.Enum,
                signature : type_to_string(&field_type),
                type_params : _get_type_constructor_params(&field_type),
                fields : Option(ArrayList(DocField)).None,
                variants : Option(ArrayList(DocVariant)).Some(_enum_variants_to_doc_variants(&inner_type, &doc_lookup)),
                methods : merge_methods(merge_methods(&direct_methods, &generic_impl_info.methods), &token_methods),
                trait_impls : merge_trait_impl_names(merge_trait_impl_names(&base_trait_impls, &generic_impl_info.trait_impls), &token_trait_impls),
                impls : Option(ArrayList(DocImpl)).Some(all_impls),
                deprecated : sections.deprecated,
                examples : sections.examples
              )
            );
          },
          is_trait_type(&inner_type) => {
            trait_methods := ArrayList(DocFunction).new();
            associated_types := ArrayList(DocAssociatedType).new();
            match(
              inner_type,
              .TraitT({ assoc_type_names, field_labels : tfl, field_types : tft }) => {
                (fi : usize) = usize(0);
                while((fi < tfl.len()) && (fi < tft.len()), {
                  t_label := match(tfl.get(fi), .Some(l) => l, .None => String.new());
                  t_type := match(
                    tft.get(fi),
                    .Some(t) => t,
                    .None => {
                      fi = (fi + usize(1));
                      continue;
                    }
                  );
                  if(assoc_type_names.contains(&t_label), {
                    associated_types.push(
                      DocAssociatedType(
                        name : t_label.clone(),
                        doc : doc_lookup.get(t_label.clone()),
                        constraint : Option(String).Some(type_to_string(&t_type))
                      )
                    );
                  }, {
                    if(is_function_type(&t_type) && !t_label.starts_with(String.from("___")), {
                      trait_methods.push(
                        build_doc_function(
                          t_label.clone(),
                          &t_type,
                          doc_lookup.get(t_label.clone()),
                          true,
                          Option(String).Some(field_name.clone()),
                          Option(HashMap(String, String)).Some(doc_lookup),
                          String.new(),
                          Option(SourceSignatureInfo).None
                        )
                      );
                    });
                  });
                  fi = (fi + usize(1));
                });
              },
              _ => ()
            );
            (assoc_opt : Option(ArrayList(DocAssociatedType))) = Option(ArrayList(DocAssociatedType)).None;
            if(associated_types.len() > usize(0), {
              assoc_opt = Option(ArrayList(DocAssociatedType)).Some(associated_types);
            });
            traits.push(
              DocTrait(
                name : field_name.clone(),
                doc : doc,
                kind : DocTraitKind.TraitFunction,
                signature : type_to_string(&field_type),
                type_params : _get_type_constructor_params(&field_type),
                associated_types : assoc_opt,
                methods : trait_methods,
                implementors : ArrayList(String).new(),
                deprecated : sections.deprecated,
                examples : sections.examples
              )
            );
          },
          is_module_type(&inner_type) => {
            module_methods := ArrayList(DocFunction).new();
            match(
              inner_type,
              .Struct({ field_labels : mfl, field_types : mft }) => {
                (fi : usize) = usize(0);
                while((fi < mfl.len()) && (fi < mft.len()), {
                  m_label := match(mfl.get(fi), .Some(l) => l, .None => String.new());
                  m_type := match(
                    mft.get(fi),
                    .Some(t) => t,
                    .None => {
                      fi = (fi + usize(1));
                      continue;
                    }
                  );
                  if(is_function_type(&m_type) && !m_label.starts_with(String.from("___")) && (m_label.len() > usize(0)), {
                    module_methods.push(
                      build_doc_function(
                        m_label.clone(),
                        &m_type,
                        doc_lookup.get(m_label.clone()),
                        true,
                        Option(String).Some(field_name.clone()),
                        Option(HashMap(String, String)).Some(doc_lookup),
                        String.new(),
                        Option(SourceSignatureInfo).None
                      )
                    );
                  });
                  fi = (fi + usize(1));
                });
              },
              _ => ()
            );
            traits.push(
              DocTrait(
                name : field_name.clone(),
                doc : doc,
                kind : DocTraitKind.ModuleFunction,
                signature : type_to_string(&field_type),
                type_params : _get_type_constructor_params(&field_type),
                associated_types : Option(ArrayList(DocAssociatedType)).None,
                methods : module_methods,
                implementors : ArrayList(String).new(),
                deprecated : sections.deprecated,
                examples : sections.examples
              )
            );
          },
          true => {
            // TypeUni carries no baseType, so a level >= 1 return classifies
            // as trait-function and anything else falls through
            // to the unresolvable generic type constructor.
            is_hierarchy := match(
              field_type,
              .Func({ result : fn_result }) => match(fn_result, .TypeUni(lvl) => (lvl >= usize(1)), _ => false),
              _ => false
            );
            if(is_hierarchy, {
              traits.push(
                DocTrait(
                  name : field_name.clone(),
                  doc : doc,
                  kind : DocTraitKind.TraitFunction,
                  signature : type_to_string(&field_type),
                  type_params : _get_type_constructor_params(&field_type),
                  associated_types : Option(ArrayList(DocAssociatedType)).None,
                  methods : ArrayList(DocFunction).new(),
                  implementors : ArrayList(String).new(),
                  deprecated : sections.deprecated,
                  examples : sections.examples
                )
              );
            }, {
              // Generic type constructor that we can't resolve.
              generic_impl_info := _extract_generic_impl_info(&field_type, field_name.clone(), &doc_lookup, env);
              (token_methods : ArrayList(DocFunction)) = ArrayList(DocFunction).new();
              (token_trait_impls : ArrayList(String)) = ArrayList(String).new();
              (token_impls : ArrayList(DocImpl)) = ArrayList(DocImpl).new();
              match(
                token_impl_info_map.get(field_name.clone()),
                .Some(tii) => {
                  token_methods = tii.methods;
                  token_trait_impls = tii.trait_impls;
                  token_impls = tii.impls;
                },
                .None => ()
              );
              all_impls := ArrayList(DocImpl).new();
              (gi : usize) = usize(0);
              while(gi < generic_impl_info.impls.len(), {
                match(
                  generic_impl_info.impls.get(gi),
                  .Some(im) => {
                    all_impls.push(im);
                  },
                  .None => ()
                );
                gi = (gi + usize(1));
              });
              (ti2 : usize) = usize(0);
              while(ti2 < token_impls.len(), {
                match(
                  token_impls.get(ti2),
                  .Some(im) => {
                    all_impls.push(im);
                  },
                  .None => ()
                );
                ti2 = (ti2 + usize(1));
              });
              base_trait_impls := match(
                trait_impl_map.get(field_name.clone()),
                .Some(l) => l,
                .None => ArrayList(String).new()
              );
              types.push(
                DocType(
                  name : field_name.clone(),
                  doc : doc,
                  kind : DocItemKind.TypeFunction,
                  signature : type_to_string(&field_type),
                  type_params : _get_type_constructor_params(&field_type),
                  fields : Option(ArrayList(DocField)).None,
                  variants : Option(ArrayList(DocVariant)).None,
                  methods : merge_methods(&generic_impl_info.methods, &token_methods),
                  trait_impls : merge_trait_impl_names(merge_trait_impl_names(&base_trait_impls, &generic_impl_info.trait_impls), &token_trait_impls),
                  impls : Option(ArrayList(DocImpl)).Some(all_impls),
                  deprecated : sections.deprecated,
                  examples : sections.examples
                )
              );
            });
          }
        );
        i = (i + usize(1));
        continue;
      });
      // Regular function or comptime function.
      functions.push(
        build_doc_function(
          field_name.clone(),
          &field_type,
          &doc,
          false,
          Option(String).None,
          Option(HashMap(String, String)).Some(doc_lookup),
          String.new(),
          source_fn_signatures.get(field_name.clone())
        )
      );
      i = (i + usize(1));
      continue;
    });
    // -- Constant --
    const_sections := extract_doc_sections(&doc);
    constants.push(
      DocConstant(
        name : field_name.clone(),
        doc : doc,
        type_ : type_to_string(&field_type),
        value : Option(String).Some(value_to_string(&value)),
        deprecated : const_sections.deprecated,
        examples : const_sections.examples
      )
    );
    i = (i + usize(1));
  });
  result
});
export(
  DocSections,
  is_compiler_internal_field_name,
  TokenImplInfo,
  TraitBodyExtraction,
  extract_doc_sections,
  build_doc_lookup,
  merge_methods,
  merge_trait_impl_names,
  extract_trait_impls_from_tokens,
  extract_impl_info_from_tokens,
  build_doc_module_from_tokens,
  build_cross_references,
  GenericImplInfo,
  build_doc_function,
  build_doc_module,
  module_stability
);
