// Section parser for Yo doc comments.
//
// Mirrors `src/doc/sections.ts` — 1:1 port.
//
// Splits doc comment markdown by ## headings to extract structured sections
// (Returns, Errors, Panics, Examples, Safety, Deprecated).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
/// Parsed doc comment with summary, description, and named sections.
ParsedDocComment :: struct(
  /// First paragraph — used as summary in search results and completions.
  summary : String,
  /// Full description (everything before the first ## heading).
  description : String,
  /// Named sections keyed by lowercase heading (e.g., "returns", "examples").
  sections : HashMap(String, String)
);
/// Check if a section name is a well-known section heading.
is_known_section :: (fn(name : String) -> bool)({
  lower := name.to_lowercase();
  cond(
    (lower == `returns`) => true,
    (lower == `errors`) => true,
    (lower == `panics`) => true,
    (lower == `examples`) => true,
    (lower == `safety`) => true,
    (lower == `deprecated`) => true,
    (lower == `stability`) => true,
    true => false
  )
});
// Returns true if `line` is a section heading: `## <anything>`, or `# <name>`
// where <name> is a well-known section (`# Examples`, `# Returns`, ...).
// Authors write either level — std alone had 70 single-`#` headings against 5
// double ones, and the single-`#` sections were silently folded into the
// description (issues/fixed/doc-sections-require-double-hash-but-std-writes-single-hash.md).
// An arbitrary `# heading` stays description content.
is_section_heading_ :: (fn(line : String) -> bool)(
  cond(
    (line.len() < usize(3)) => false,
    line.starts_with(`## `) => (line.len() >= usize(4)),
    line.starts_with(`# `) => is_known_section(line.substring(usize(2), line.len()).trim()),
    true => false
  )
);
// Returns the heading text after `## ` / `# ` (trimmed).
get_section_heading_ :: (fn(line : String) -> String)(
  cond(
    line.starts_with(`## `) => line.substring(usize(3), line.len()).trim(),
    true => line.substring(usize(2), line.len()).trim()
  )
);
// Trim leading/trailing blank lines from section content; join with \n.
trim_section_content_ :: (fn(lines : ArrayList(String)) -> String)({
  count := lines.len();
  // Find start: skip leading blank lines
  start := usize(0);
  while(start < count, {
    line := match(
      lines.get(start),
      .Some(l) => l,
      .None => {
        break;
      }
    );
    if(!(line.trim() == ``), {
      break;
    });
    start = (start + usize(1));
  });
  // Find end: skip trailing blank lines
  end := count;
  while(end > start, {
    prev := (end - usize(1));
    line := match(
      lines.get(prev),
      .Some(l) => l,
      .None => {
        break;
      }
    );
    if(!(line.trim() == ``), {
      break;
    });
    end = prev;
  });
  // Collect lines[start..end] and join
  result := ArrayList(String).new();
  i := start;
  while(i < end, {
    line := match(
      lines.get(i),
      .Some(l) => l,
      .None => {
        break;
      }
    );
    result.push(line);
    i = (i + usize(1));
  });
  `\n`.join(result)
});
// Extract the first paragraph (up to first blank line) as the summary.
extract_summary_ :: (fn(description : String) -> String)({
  if(description == ``, {
    return(``);
  });
  lines := description.split(`\n`);
  summary_lines := ArrayList(String).new();
  count := lines.len();
  i := usize(0);
  while(i < count, {
    line := match(
      lines.get(i),
      .Some(l) => l,
      .None => {
        break;
      }
    );
    if(line.trim() == ``, {
      break;
    });
    summary_lines.push(line);
    i = (i + usize(1));
  });
  `\n`.join(summary_lines)
});
/// Parse a doc comment into structured sections.
///
/// - Everything before the first `## ` heading is the description.
/// - The first paragraph of the description (up to the first blank line) is the summary.
/// - `## Returns`, `## Errors`, etc. are parsed as named sections.
/// - Unknown headings are kept as-is (key = lowercase heading text).
/// - Section content continues until the next `## ` heading or end of text.
parse_doc_comment :: (fn(text : String) -> ParsedDocComment)({
  if(text.trim() == ``, {
    return(
      ParsedDocComment(
        summary : ``,
        description : ``,
        sections : HashMap(String, String).new()
      )
    );
  });
  lines := text.split(`\n`);
  sections := HashMap(String, String).new();
  description_lines := ArrayList(String).new();
  current_section_name := Option(String).None;
  current_section_lines := ArrayList(String).new();
  count := lines.len();
  i := usize(0);
  in_fence := false;
  while(i < count, {
    line := match(
      lines.get(i),
      .Some(l) => l,
      .None => {
        break;
      }
    );
    // A `#` line inside a fenced code block (a shell comment in a ```sh
    // example, a Markdown heading in quoted output) is code, not a heading.
    if(line.trim().starts_with(`\`\`\``), {
      in_fence = !in_fence;
    });
    if(!in_fence && is_section_heading_(line), {
      match(
        current_section_name,
        .Some(name) => {
          sections.insert(name, trim_section_content_(current_section_lines));
          current_section_lines = ArrayList(String).new();
        },
        .None => ()
      );
      current_section_name = Option(String).Some(get_section_heading_(line).to_lowercase());
    }, {
      match(
        current_section_name,
        .Some(_) => {
          current_section_lines.push(line);
        },
        .None => {
          description_lines.push(line);
        }
      );
    });
    i = (i + usize(1));
  });
  match(
    current_section_name,
    .Some(name) => {
      sections.insert(name, trim_section_content_(current_section_lines));
    },
    .None => ()
  );
  description := trim_section_content_(description_lines);
  summary := extract_summary_(description);
  ParsedDocComment(summary : summary, description : description, sections : sections)
});
export(parse_doc_comment, is_known_section);
