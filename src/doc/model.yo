//! Documentation model types for the Yo compiler.
//!
//! Represents the structured documentation IR produced by combining doc
//! comment extraction with evaluator type information.
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
// ---------------------------------------------------------------------------
// DocItemKind — discriminates the kind of a documented item
// ---------------------------------------------------------------------------
DocItemKind :: enum(
  Function,
  Struct,
  Object,
  AtomicObject,
  Enum,
  Newtype,
  Union,
  Trait,
  Module,
  Constant,
  TypeAlias,
  TypeFunction
);
/// Convert a DocItemKind to its canonical string representation.
doc_item_kind_to_string :: (fn(kind : DocItemKind) -> String)(
  match(
    kind,
    .Function => `function`,
    .Struct => `struct`,
    .Object => `object`,
    .AtomicObject => `atomic object`,
    .Enum => `enum`,
    .Newtype => `newtype`,
    .Union => `union`,
    .Trait => `trait`,
    .Module => `module`,
    .Constant => `constant`,
    .TypeAlias => `type-alias`,
    .TypeFunction => `type-function`
  )
);
// ---------------------------------------------------------------------------
// DocTraitKind — discriminates the kind of a documented trait/module
// ---------------------------------------------------------------------------
DocTraitKind :: enum(
  Trait,
  Module,
  TraitFunction,
  ModuleFunction
);
/// Convert a DocTraitKind to its canonical string representation.
doc_trait_kind_to_string :: (fn(kind : DocTraitKind) -> String)(
  match(
    kind,
    .Trait => `trait`,
    .Module => `module`,
    .TraitFunction => `trait-function`,
    .ModuleFunction => `module-function`
  )
);
// ---------------------------------------------------------------------------
// Parameter and field documentation
// ---------------------------------------------------------------------------
DocParam :: struct(
  name : String,
  type_ : String,
  is_comptime : bool,
  is_implicit : bool,
  default_value : Option(String),
  doc : Option(String)
);
DocField :: struct(
  name : String,
  type_ : String,
  doc : Option(String),
  default_value : Option(String)
);
DocVariant :: struct(
  name : String,
  fields : Option(ArrayList(DocField)),
  doc : Option(String),
  discriminant : Option(String)
);
DocAssociatedType :: struct(
  name : String,
  doc : Option(String),
  constraint : Option(String)
);
DocImplAssocType :: struct(
  name : String,
  type_ : String,
  doc : Option(String)
);
DocImpl :: struct(
  signature : String,
  trait_name : Option(String),
  method_names : ArrayList(String),
  associated_types : Option(ArrayList(DocImplAssocType))
);
// ---------------------------------------------------------------------------
// Function documentation
// ---------------------------------------------------------------------------
DocFunction :: struct(
  name : String,
  doc : Option(String),
  signature : String,
  parameters : ArrayList(DocParam),
  return_type : String,
  type_params : Option(ArrayList(DocParam)),
  effects : Option(ArrayList(DocParam)),
  is_method : bool,
  self_type : Option(String),
  returns : Option(String),
  errors : Option(String),
  deprecated : Option(String),
  examples : Option(String),
  /// The trait this method's `doc` was INHERITED from, when the impl carried
  /// no doc comment of its own.
  ///
  /// Rustdoc, which this library follows deliberately, shows a trait impl's
  /// methods with the TRAIT's documentation unless the impl overrides it: the
  /// contract is stated once at the trait and inherited by every
  /// implementation. Without that, 454 trait-impl methods across `std/`
  /// rendered as bare signatures — `hash`, `clone`, `next`, `to_string`,
  /// `dispose`, one per implementing type — and the alternative, writing 454
  /// per-instance restatements into `std/`, would be noise that drifts from
  /// the trait's text and would still leave every user crate's impls blank
  /// (`issues/fixed/yo-doc-trait-impl-methods-never-inherit-the-trait-doc.md`).
  ///
  /// `.None` when the doc is the method's own, which is also the case for a
  /// method that overrides the trait's text — an impl-site comment always
  /// wins, because several `std/` impls document a DIVERGENCE there
  /// (`imm/*`'s `IntoIterator` says it is eager rather than lazy).
  inherited_from : Option(String)
);
// ---------------------------------------------------------------------------
// Type documentation
// ---------------------------------------------------------------------------
DocType :: struct(
  name : String,
  doc : Option(String),
  kind : DocItemKind,
  signature : String,
  type_params : Option(ArrayList(DocParam)),
  fields : Option(ArrayList(DocField)),
  variants : Option(ArrayList(DocVariant)),
  methods : ArrayList(DocFunction),
  trait_impls : ArrayList(String),
  impls : Option(ArrayList(DocImpl)),
  deprecated : Option(String),
  examples : Option(String)
);
// ---------------------------------------------------------------------------
// Trait documentation
// ---------------------------------------------------------------------------
DocTrait :: struct(
  name : String,
  doc : Option(String),
  kind : DocTraitKind,
  signature : String,
  type_params : Option(ArrayList(DocParam)),
  associated_types : Option(ArrayList(DocAssociatedType)),
  methods : ArrayList(DocFunction),
  implementors : ArrayList(String),
  deprecated : Option(String),
  examples : Option(String)
);
// ---------------------------------------------------------------------------
// Constant documentation
// ---------------------------------------------------------------------------
DocConstant :: struct(
  name : String,
  doc : Option(String),
  type_ : String,
  value : Option(String),
  deprecated : Option(String),
  /// Both builder paths populate this from the doc's `## Examples` section,
  /// so the model (and its JSON) carries one whenever such a section exists —
  /// kept explicit for render_json parity.
  examples : Option(String)
);
// ---------------------------------------------------------------------------
// Module documentation (recursive via ArrayList)
// ---------------------------------------------------------------------------
DocModule :: struct(
  name : String,
  path : String,
  doc : Option(String),
  /// Stability marker from the module's `## Stability` doc section — `unstable`
  /// while a new module settles (plans/archive/STD_API_AUDIT.md §1: additive-only
  /// changes once stable; new modules enter with this marker for one release).
  /// `.None` = stable (the default for every std module).
  stability : Option(String),
  functions : ArrayList(DocFunction),
  types : ArrayList(DocType),
  traits : ArrayList(DocTrait),
  constants : ArrayList(DocConstant),
  submodules : ArrayList(Box(Self))
);
// ---------------------------------------------------------------------------
// Top-level documentation model
// ---------------------------------------------------------------------------
DocModel :: struct(
  name : String,
  modules : ArrayList(DocModule),
  version : Option(String),
  /// `yo doc --logo <path>` / `build.documentation({ logo })`: an image shown
  /// in the sidebar header. `.None` = no logo.
  ///
  /// DEFAULTED, and the default is the documented meaning: a model built
  /// without a logo has none. Four construction sites across the doc tests
  /// were left behind when these two fields landed without defaults, and the
  /// PR that added them merged with its CI cancelled, so the break reached
  /// develop — one default here is the fix for every such site, present and
  /// future.
  (logo : Option(String)) ?= Option(String).None,
  /// `--favicon <path>`: the site's `<link rel="icon">`. `.None` = none.
  (favicon : Option(String)) ?= Option(String).None
);
export(
  DocItemKind,
  doc_item_kind_to_string,
  DocTraitKind,
  doc_trait_kind_to_string,
  DocParam,
  DocField,
  DocVariant,
  DocAssociatedType,
  DocImplAssocType,
  DocImpl,
  DocFunction,
  DocType,
  DocTrait,
  DocConstant,
  DocModule,
  DocModel
);
/// The stability LEVEL word for a marker — the badge's CSS class and label.
///
/// The marker itself is ordinary prose, so its first word is not a clean
/// token: std alone writes `unstable`, `unstable,`, `unstable.`, `stable`,
/// `stable.`, `Stable.` and `**stable` (measured 2026-09-17 across 174
/// markers). Feeding that straight into a class name produced
/// `stability-unstable,` and `stability-**stable`, which match no rule in the
/// stylesheet — so the badge lost its colour for exactly the markers whose
/// authors added punctuation.
///
/// Strips markdown emphasis and trailing punctuation, lowercases, and returns
/// `""` when the result is not a level the renderers know — a marker opening
/// with prose ("close to freezing", "The shapes are…") has no level, and an
/// unrecognised word must not become a class.
stability_level :: (fn(marker : String) -> String)({
  first := match(marker.trim().split(` `).get(usize(0)), .Some(w) => w, .None => String.new());
  (cleaned : String) = String.new();
  (i : usize) = usize(0);
  while(i < first.len(), {
    ch := first.substring(i, i + usize(1));
    keep := !((ch == `*`) || (ch == `_`) || (ch == "`") || (ch == `,`) || (ch == `.`) || (ch == `:`) || (ch == `;`) || (ch == `!`));
    if(keep, {
      cleaned.push_string(ch);
    });
    i = (i + usize(1));
  });
  lower := cleaned.to_lowercase();
  cond(
    (lower == `stable`) => lower,
    (lower == `unstable`) => lower,
    (lower == `deprecated`) => lower,
    (lower == `experimental`) => lower,
    true => String.new()
  )
});
export(stability_level);
