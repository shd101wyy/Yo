//! Core code emitter for the self-hosted Yo C code generator.
//!
//! Accumulates C source text in three separate string buffers that are
//! concatenated by `print()`:
//!
//!   headers      — #include directives and forward declarations
//!   declarations — struct/enum/typedef declarations
//!   code         — function definitions and other body code
// The code spill writes raw buffers (`write_sync`).
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ HashSet } :: import("std/collections/hash_set");
{ HashMap } :: import("std/collections/hash_map");
{ ArrayList } :: import("std/collections/array_list");
{ open_sync, close_sync, write_sync } :: import("std/sys/file");
{ panic } :: import("std/assert");
{ O_WRONLY, O_CREAT, O_TRUNC, O_CLOEXEC, DEFAULT_FILE_MODE } :: import("std/sys/constants");
/// True iff `b` is a C identifier byte: [A-Za-z0-9_].
_emitter_is_ident_byte :: (fn(b : u8) -> bool)(
  ((b >= u8(48)) && (b <= u8(57))) || ((b >= u8(65)) && (b <= u8(90))) || ((b >= u8(97)) && (b <= u8(122))) || (b == u8(95))
);
/// True iff `cn` looks like an eval-minted temp C name: contains `_temp_`
/// followed by ONLY digits to the end (mirrors begin.yo `_looks_like_minted_temp`).
/// Kept local so this low-level module needs no codegen imports.
_emitter_is_minted_temp :: (fn(imm(cn) : String) -> bool)({
  marker := String.from("_temp_");
  match(
    cn.index_of(&marker),
    .None => false,
    .Some(idx) => {
      start := (idx + marker.len());
      n := cn.len();
      if(start >= n, {
        return(false);
      });
      (i : usize) = start;
      (ok : bool) = true;
      while(i < n, {
        b := cn.byte_at(i);
        if(!((b >= u8(48)) && (b <= u8(57))), {
          ok = false;
        });
        i = (i + usize(1));
      });
      ok
    }
  )
});
/// When a line declares a minted temp (`<type> <temp> = …`), record its C name
/// in `set`. The drop-emission gate skips a `___drop` for any minted temp NOT
/// in declared_c_var_names, and the
/// many temp-decl paths that build the declaration via get_type_string (not
/// get_variable_type_string) otherwise leave their temps untracked → the gate
/// wrongly skips their (live-RC) drops → LEAK. Recorded in C-emission order so
/// forward-ref protection holds; a `___drop((cast)(temp))` use has the temp inside
/// parens (not in `<type> <name> =` position), so genuine never-declared phantoms
/// are never recorded. See issues/fixed/yo-self-fixpoint-eval-phase-leak.md.
_emitter_record_declared_temp :: (fn(mut(set) : HashSet(String), imm(line) : String) -> unit)({
  if(!line.contains(String.from("_temp_")), {
    return(());
  });
  eq_opt := line.index_of(String.from(" = "));
  match(
    eq_opt,
    .None => (),
    .Some(eq) => {
      if(eq == usize(0), {
        return(());
      });
      // Walk back over the identifier immediately preceding " = ".
      (ns : usize) = eq;
      while((ns > usize(0)) && _emitter_is_ident_byte(line.byte_at(ns - usize(1))), {
        ns = (ns - usize(1));
      });
      if(ns == eq, {
        return(());
      });
      // Declaration position: the identifier must be preceded by `<type> ` — i.e.
      // a space (ns-1) that is itself preceded by a non-space type char (ns-2).
      // An assignment `<temp> = …` has the identifier at line start (only indent
      // before it) → skip (it declares nothing new).
      if(ns < usize(2), {
        return(());
      });
      if(line.byte_at(ns - usize(1)) != u8(32), {
        return(());
      });
      if(line.byte_at(ns - usize(2)) == u8(32), {
        return(());
      });
      name := line.substring(ns, eq);
      if(_emitter_is_minted_temp(name.clone()), {
        set.insert(name);
      });
    }
  )
});
/// Pop the block-scope stack back through (and including) the most recent `"{"`
/// sentinel — i.e. close one C block, discarding the names it declared.
_emitter_pop_block :: (fn(mut(stack) : ArrayList(String)) -> unit)({
  (done : bool) = false;
  while(!done && (stack.len() > usize(0)), {
    match(
      stack.pop(),
      .Some(v) => if(v == "{", {
        done = true;
      }),
      .None => {
        done = true;
      }
    );
  });
});
/// If `line` DECLARES a C var (`<type> <name> = …`, name preceded by `<type> `),
/// push that name onto the top scope frame. Assignments (`<name> = …`, name at
/// line start after indent) and field initializers (`.field = …`, name preceded
/// by `.`) declare nothing and are skipped. Called BEFORE brace scanning so a
/// compound-literal decl (`Type name = { … }`) records `name` in the enclosing
/// frame, above the `{` its initializer opens.
_emitter_record_scope_decl :: (fn(mut(stack) : ArrayList(String), imm(line) : String) -> unit)({
  eq_opt := line.index_of(String.from(" = "));
  match(
    eq_opt,
    .None => (),
    .Some(eq) => {
      if(eq == usize(0), {
        return(());
      });
      (ns : usize) = eq;
      while((ns > usize(0)) && _emitter_is_ident_byte(line.byte_at(ns - usize(1))), {
        ns = (ns - usize(1));
      });
      if(ns == eq, {
        return(());
      });
      if(ns < usize(2), {
        return(());
      });
      if(line.byte_at(ns - usize(1)) != u8(32), {
        return(());
      });
      if(line.byte_at(ns - usize(2)) == u8(32), {
        return(());
      });
      name := line.substring(ns, eq);
      stack.push(name);
    }
  )
});
/// Maintain the C block-scope stack for the escape-gate liveness signal, encoded
/// as a flat `ArrayList(String)` of declared C var names with `"{"` sentinels
/// marking block boundaries (a real C identifier can never equal `"{"`, so the
/// sentinel is unambiguous). This tracks EVERY C brace — begin-block, `if`/`else`,
/// `switch`/`case`, and compound-literal braces alike — by scanning the emitted
/// line character-by-character (skipping string literals, char literals and `//`
/// comments so braces inside them are not miscounted): each structural `{` pushes
/// a `"{"` sentinel, each `}` pops back through the last sentinel (discarding that
/// block's declared names), and a declaration pushes its name first (recorded in
/// the enclosing frame). Because a closed block's names are popped, the list only
/// ever holds names from currently-open C blocks — so the escape gate keeps a
/// pending drop iff its target APPEARS in the list (declared before this point AND
/// still in C scope). This is the block-scope-aware, C-emission-order signal the
/// flat set and source-token heuristics could not provide: begin-block markers
/// alone are too coarse (a control-flow-initialized local buried in a `switch`/`if`
/// C block goes out of C scope when that block closes, so its escape drop must be
/// skipped, but a marker-only tracker never sees the intervening close). A flat
/// `ArrayList(String)` is used rather than a stack of `HashSet` frames because
/// the self-hosted compiler's own codegen mis-drops the nested `ArrayList(HashSet(String))`
/// generic (double-free in the self-compiled binary). See
/// issues/fixed/yo-self-fixpoint-eval-phase-leak.md.
_emitter_track_scope :: (fn(mut(stack) : ArrayList(String), imm(line) : String) -> unit)({
  _emitter_record_scope_decl(stack, line.clone());
  // BYTE count, not len() (chars): the loop indexes with byte_at. Bounding by
  // char count under-scans any line containing multibyte text — a closing
  // `}`/`"` in the lost tail is missed, a compound-literal `{` becomes a
  // phantom open sentinel, and the enclosing block's REAL close pops the
  // phantom instead — its declared names then stay "in scope" forever and the
  // escape gate emits drops for same-named locals of later sibling blocks
  // before their C declaration (the regex.test.yo `undeclared m2` cluster).
  // ASCII structural bytes cannot occur inside UTF-8 continuation sequences,
  // so a plain byte scan is exact. See issues/fixed/yo-self-emitter-scope-scan-chars-vs-bytes.md.
  n := line.len();
  (i : usize) = usize(0);
  (in_str : bool) = false;
  (in_chr : bool) = false;
  while(i < n, {
    b := line.byte_at(i);
    if(in_str, {
      if(b == u8(92), {
        i = (i + usize(1));
      }, if(b == u8(34), {
        in_str = false;
      }));
    }, if(in_chr, {
      if(b == u8(92), {
        i = (i + usize(1));
      }, if(b == u8(39), {
        in_chr = false;
      }));
    }, {
      if((b == u8(47)) && ((i + usize(1)) < n) && (line.byte_at(i + usize(1)) == u8(47)), {
        i = n;
      }, {
        if(b == u8(34), {
          in_str = true;
        });
        if(b == u8(39), {
          in_chr = true;
        });
        if(b == u8(123), {
          stack.push(String.from("{"));
        });
        if(b == u8(125), {
          _emitter_pop_block(stack);
        });
      });
    }));
    i = (i + usize(1));
  });
});
/// Count `\n` bytes — the physical-line accounting `#line` restore numbers
/// need (plans/reference/LINE_DIRECTIVES.md).
_emitter_count_newlines :: (fn(imm(s) : String) -> usize)({
  bytes := s;
  n := bytes.len();
  (i : usize) = usize(0);
  (count : usize) = usize(0);
  while(i < n, {
    match(
      bytes.get_byte(i),
      .Some(b) => if(b == u8(10), {
        count = (count + usize(1));
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  count
});
/// Overwrite byte `i` of a buffer taken out of the code string
/// (`into_bytes()`, no copy when unique) — the in-place `#line` restore-number
/// patch must not copy the ~100 MB code buffer the spill lever exists to avoid
/// copying.
_emitter_set_byte :: (fn(imm(bytes) : ArrayList(u8), i : usize, b : u8) -> unit)({
  match(
    bytes.ptr(),
    .Some(p) => {
      q := p.add(i);
      unsafe(q.* = b);
    },
    .None => ()
  );
});
/// Quote a path for a `#line "…"` directive: escape `\` (a Windows path
/// separator) and `"` per C's pp-string rules.
_emitter_quote_c_filename :: (fn(imm(p) : String) -> String)({
  out := String.new();
  (i : usize) = usize(0);
  while(i < p.len(), {
    b := p.byte_at(i);
    cond(
      (b == u8(92)) => {
        out.push_str("\\\\");
      },
      (b == u8(34)) => {
        out.push_str("\\\"");
      },
      true => {
        out.push_byte(b);
      }
    );
    i = (i + usize(1));
  });
  out
});
/// The restore-marker prefix: 8 placeholder zeros never occur in a real line
/// number, so the patch passes (here and in chunk_assembly.yo) can recognize
/// their own directives and nothing else. A function, not a `::` constant —
/// a module-level `String.from(...)` is a runtime value.
line_restore_marker :: (fn() -> String)(String.from("#line 00000000 \""));
/// Simple string emitter with three output sections.
///
/// Three buffers are maintained separately so that forward declarations
/// and type definitions can be emitted out-of-order and still appear
/// before function bodies in the final output.
Emitter :: ref(
  struct(
    headers : String,
    declarations : String,
    code : String,
    /// When `.Some`, points at the current function's `declared_c_var_names`
    /// (set by generate_function). `emit_*` code-section writes record any
    /// minted-temp declaration into it so the drop-emission gate has the
    /// C-emission-order ground truth. See `_emitter_record_declared_temp`.
    declared_ref : Option(Rc(HashSet(String))),
    /// When `.Some`, points at the current function's block-scope stack
    /// (declared_scopes). Each emitted body line pushes/pops `"{"` frames on every
    /// C brace and records named-local + temp decls — the escape gate's
    /// block-scope-aware liveness signal. See `_emitter_track_scope`.
    scope_ref : Option(Rc(ArrayList(String))),
    /// Code spill (plans/CODEGEN_MEMORY_REDUCTION.md §3 lever 3): with a
    /// `code_spill_path`, finished code past `CODE_SPILL_BYTES` is written
    /// to that file between functions and the `code` buffer is cleared, so
    /// the ~117 MB of C bodies never sit in memory at once.
    /// `code_spilled_bytes` is how much of the code section is on disk,
    /// ahead of `code`.
    code_spill_fd : i32,
    code_spill_path : String,
    code_spilled_bytes : usize,
    /// Spill once `code` holds this many bytes (`CODE_SPILL_BYTES`; tests
    /// lower it to spill after every function).
    code_spill_threshold : usize,
    /// `#line` directives (plans/reference/LINE_DIRECTIVES.md): ON = the
    /// statement flush points map the emitted C back to its `.yo` position and
    /// compiler-generated regions restore honest C numbering, so a C debugger
    /// or a C-compiler diagnostic steps through Yo. OFF (default) keeps the
    /// emission byte-identical to the pre-directive compiler.
    line_directives : bool,
    /// The C file name restore directives attribute generated code to (the
    /// `<output>.c` sidecar). Chunked emission rewrites the name per chunk at
    /// assembly time (chunk_assembly.yo): the emitter cannot know which chunk
    /// a function lands in.
    line_c_name : String,
    /// The RAW `.yo` path spelling of the last directive (the comparison key —
    /// a module's tokens always carry one spelling), with its 0-based token
    /// row. `.None` = honest C numbering (no user directive active). Adjacent
    /// statements from one `.yo` line pay zero directives.
    line_last_path : Option(String),
    line_last_row : usize,
    /// Deferred moves out of a task slot, marker → the statements that empty
    /// the slot. A consuming read of a slot renders the slot itself plus a
    /// unique `/*yo_mv:…*/` marker; the move happens where the line holding
    /// that marker runs (the consuming call, binding or store), so the slot is
    /// emptied right after that line. Emptied at the read, a later argument
    /// of the same call read the empty slot (`S(a : xs, n : xs.len())`), and
    /// a C temp holding the value did not survive an await in a later
    /// argument (issues/fixed/a-move-out-of-a-task-slot-empties-it-before-the-consuming-call-runs.md).
    move_zeroes : HashMap(String, String),
    /// The code-section text written since the last newline, while a move is
    /// pending: a line assembled from `emit`/`emit_string` pieces is checked
    /// whole when its newline arrives.
    partial_line : String
  )
);
/// The code buffer is spilled once it holds this much (8 MiB).
CODE_SPILL_BYTES :: usize(8388608);
impl(
  Emitter,
  /// Create a new empty emitter.
  new : (fn() -> Self)(
    Self(
      headers : String.new(),
      declarations : String.new(),
      code : String.new(),
      declared_ref : Option(Rc(HashSet(String))).None,
      scope_ref : Option(Rc(ArrayList(String))).None,
      code_spill_fd : i32(-1),
      code_spill_path : String.new(),
      code_spilled_bytes : usize(0),
      code_spill_threshold : CODE_SPILL_BYTES,
      line_directives : false,
      line_c_name : String.new(),
      line_last_path : Option(String).None,
      line_last_row : usize(0),
      move_zeroes : HashMap(String, String).new(),
      partial_line : String.new()
    )
  ),
  /// Empty a slot right after the line holding `marker` is emitted.
  defer_move_zero : (fn(mut(self) : Self, imm(marker) : String, imm(stmts) : String) -> unit)({
    self.move_zeroes.insert(marker, stmts);
  }),
  /// After a code line: the pending moves whose marker it holds.
  _flush_move_zeroes : (fn(mut(self) : Self, imm(line) : String) -> unit)({
    whole := self.partial_line.clone();
    whole.push_string(line);
    self.partial_line = String.new();
    if(!whole.contains(String.from("/*yo_mv:")), {
      return(());
    });
    hits := ArrayList(String).new();
    ks := self.move_zeroes.keys();
    (more : bool) = true;
    while(more, {
      match(
        ks.next(),
        .Some(k) => if(whole.contains(k.clone()), {
          hits.push(k);
        }),
        .None => {
          more = false;
        }
      );
    });
    (hi : usize) = usize(0);
    while(hi < hits.len(), {
      match(
        hits.get(hi),
        .Some(k) => match(
          self.move_zeroes.remove(&k),
          .Some(stmts) => {
            self.code.push_string(&stmts);
            self.code.push_str("\n");
          },
          .None => ()
        ),
        .None => ()
      );
      hi = (hi + usize(1));
    });
  }),
  /// Spill finished code to `path` from now on. The file is created at the
  /// first spill, so a program whose code never reaches the threshold (and a
  /// compile that fails before it does) leaves no file behind.
  start_code_spill : (fn(mut(self) : Self, imm(path) : String) -> unit)({
    self.code_spill_path = path;
    self.code_spilled_bytes = usize(0);
  }),
  _open_code_spill : (fn(mut(self) : Self) -> bool)({
    cpath := self.code_spill_path.to_cstr();
    fd := open_sync(cpath.ptr().unwrap(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, i32(DEFAULT_FILE_MODE));
    if(fd < i32(0), {
      // Unopenable: stop trying; the code stays in memory.
      self.code_spill_path = String.new();
      return(false);
    });
    self.code_spill_fd = fd;
    true
  }),
  /// Between functions: write the code buffer to the spill file once it holds
  /// `code_spill_threshold` bytes, then clear it (the capacity stays, bounded by the
  /// threshold). Callers only spill at a function boundary — every in-buffer
  /// offset a function takes (`before`, stub marks) is then still valid.
  spill_code_if_large : (fn(mut(self) : Self) -> unit)(
    if((self.code_spill_path.len() > usize(0)) && (self.code.len() >= self.code_spill_threshold), {
      if((self.code_spill_fd < i32(0)) && !self._open_code_spill(), {
        return(());
      });
      bytes := self.code;
      n := bytes.len();
      base_ptr := bytes.ptr().unwrap();
      (done : usize) = usize(0);
      while(done < n, {
        w := write_sync(self.code_spill_fd, base_ptr.add(done), u32(n - done), u64(self.code_spilled_bytes + done));
        if(w <= i32(0), {
          panic(`yo: writing the C code spill file failed (${w.to_string()}); ${(self.code_spilled_bytes + done).to_string()} bytes written`);
        });
        done = (done + usize(w));
      });
      self.code_spilled_bytes = (self.code_spilled_bytes + n);
      self.code.clear();
    })
  ),
  /// Replace the spilled code with `bytes` (the FTT-stub attribute insert,
  /// `_insert_attr_before_first_decl`, when the first declaration was
  /// already spilled). Rare; it rewrites the whole file.
  rewrite_code_spill : (fn(mut(self) : Self, sink(bytes) : ArrayList(u8)) -> unit)({
    close_sync(self.code_spill_fd);
    cpath := self.code_spill_path.to_cstr();
    fd := open_sync(cpath.ptr().unwrap(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, i32(DEFAULT_FILE_MODE));
    if(fd < i32(0), {
      panic(`yo: reopening the C code spill file failed (${fd.to_string()})`);
    });
    self.code_spill_fd = fd;
    n := bytes.len();
    (done : usize) = usize(0);
    if(n > usize(0), {
      base_ptr := bytes.ptr().unwrap();
      while(done < n, {
        w := write_sync(fd, base_ptr.add(done), u32(n - done), u64(done));
        if(w <= i32(0), {
          panic(`yo: rewriting the C code spill file failed (${w.to_string()})`);
        });
        done = (done + usize(w));
      });
    });
    self.code_spilled_bytes = n;
  }),
  /// Close the spill file (its contents stay for the caller to splice).
  close_code_spill : (fn(mut(self) : Self) -> unit)(
    if(self.code_spill_fd >= i32(0), {
      close_sync(self.code_spill_fd);
      self.code_spill_fd = i32(-1);
    })
  ),
  /// Append text to the code section (no trailing newline).
  emit : (fn(mut(self) : Self, c : str) -> unit)({
    self.code.push_str(c);
    if(self.move_zeroes.len() > usize(0), {
      self.partial_line.push_str(c);
    });
  }),
  /// Append text + newline to the code section.
  emit_line : (fn(mut(self) : Self, c : str) -> unit)({
    self.code.push_str(c);
    self.code.push_str("\n");
    match(self.declared_ref, .Some(s) => _emitter_record_declared_temp(&mut s.*, String.from(c)), .None => ());
    match(self.scope_ref, .Some(st) => _emitter_track_scope(&mut st.*, String.from(c)), .None => ());
    if(self.move_zeroes.len() > usize(0), {
      self._flush_move_zeroes(String.from(c));
    });
  }),
  /// Append text + newline to the headers section.
  emit_header_line : (fn(mut(self) : Self, c : str) -> unit)({
    self.headers.push_str(c);
    self.headers.push_str("\n");
  }),
  /// Append a raw `String` value to the headers section.
  emit_header_string : (fn(mut(self) : Self, imm(c) : String) -> unit)(
    self.headers.push_string(c)
  ),
  /// Append a raw `String` value + newline to the headers section.
  emit_header_string_line : (fn(mut(self) : Self, imm(c) : String) -> unit)({
    self.headers.push_string(c);
    self.headers.push_str("\n");
  }),
  /// Append text + newline to the declarations section.
  emit_declaration_line : (fn(mut(self) : Self, c : str) -> unit)({
    self.declarations.push_str(c);
    self.declarations.push_str("\n");
  }),
  /// Append text (no newline) to the declarations section.
  emit_declaration : (fn(mut(self) : Self, c : str) -> unit)(
    self.declarations.push_str(c)
  ),
  /// Append a raw `String` value (no newline) to the declarations section.
  emit_declaration_string : (fn(mut(self) : Self, imm(c) : String) -> unit)(
    self.declarations.push_string(c)
  ),
  /// Append a raw `String` value + newline to the declarations section.
  emit_declaration_string_line : (fn(mut(self) : Self, imm(c) : String) -> unit)({
    self.declarations.push_string(c);
    self.declarations.push_str("\n");
  }),
  /// Append a raw `String` value to the code section.
  emit_string : (fn(mut(self) : Self, imm(c) : String) -> unit)({
    if(self.move_zeroes.len() > usize(0), {
      self.partial_line.push_string(c.clone());
    });
    self.code.push_string(c);
  }),
  /// Append a raw `String` value + newline to the code section.
  emit_string_line : (fn(mut(self) : Self, imm(c) : String) -> unit)({
    match(self.declared_ref, .Some(s) => _emitter_record_declared_temp(&mut s.*, c.clone()), .None => ());
    match(self.scope_ref, .Some(st) => _emitter_track_scope(&mut st.*, c.clone()), .None => ());
    self.code.push_string(c.clone());
    self.code.push_str("\n");
    if(self.move_zeroes.len() > usize(0), {
      self._flush_move_zeroes(c);
    });
  }),
  /// Record `name` in the CURRENT C block of the block-scope stack. For a
  /// declaration the line scan cannot see: a result temp declared bare
  /// (`T tv;`, no ` = `) and assigned inside the branches of the `switch`/`if`
  /// chain that follows. Its owner calls this once that chain is CLOSED, so an
  /// early exit inside a branch (before the assignment) still skips the temp
  /// and every exit after it releases the value
  /// (issues/fixed/match-argument-temp-is-never-released-on-an-explicit-return.md).
  mark_declared_in_scope : (fn(mut(self) : Self, imm(name) : String) -> unit)(
    match(self.scope_ref, .Some(st) => st.*.push(name), .None => ())
  ),
  /// A `#line` directive must start a physical line: an `emit`/`emit_string`
  /// fragment with no trailing newline gets its newline first, so a directive
  /// is never spliced mid-line.
  _ensure_code_line_start : (fn(mut(self) : Self) -> unit)(
    if((self.code.len() > usize(0)) && (self.code.byte_at(self.code.len() - usize(1)) != u8(10)), {
      self.code.push_str("\n");
    })
  ),
  /// [`#line` directives] Attribute the C that follows to `.yo`
  /// `path`:`row` (a 0-based Token row — the directive prints row+1). Emits a
  /// directive only when the position CHANGES from the previous statement's,
  /// so adjacent statements from one `.yo` line pay zero directives. Called by
  /// the statement flush points (begin/function-body/loop-body/case-body
  /// loops in src/codegen/).
  set_yo_line_position : (fn(mut(self) : Self, imm(path) : String, row : u32) -> unit)({
    if(!self.line_directives, {
      return(());
    });
    // Eval-minted and error nodes carry "_", synthesized drops carry "drop",
    // and macro/derive expansions carry `auto-generated://` pseudo-paths
    // (which embed the expansion TEXT, newlines included — unusable in a
    // directive, and the position is not a real source location anyway).
    if((path.len() == usize(0)) || (path == String.from("_")) || (path == String.from("drop")) || path.starts_with(String.from("auto-generated://")), {
      return(());
    });
    if(path.contains(String.from("\n")), {
      return(());
    });
    match(
      self.line_last_path,
      .Some(last) => if((last == path) && (self.line_last_row == usize(row)), {
        return(());
      }),
      .None => ()
    );
    norm := path.clone();
    if(norm.starts_with(String.from("file://")), {
      norm = norm.slice_copy(usize(7) .. norm.len());
    });
    self._ensure_code_line_start();
    line := String.from("#line ");
    line.push_string((usize(row) + usize(1)).to_string());
    line.push_str(" \"");
    line.push_string(_emitter_quote_c_filename(norm.clone()));
    line.push_str("\"");
    self.emit_string_line(&line);
    self.line_last_path = Option(String).Some(path.clone());
    self.line_last_row = usize(row);
  }),
  /// [`#line` directives] Leave user-code attribution: the C that follows is
  /// compiler-generated (drops, state-machine plumbing, runtime scaffolding),
  /// so emit a restore directive. The number is the placeholder
  /// `line_restore_marker` until `patch_restore_line_numbers` runs — the
  /// header/declaration sizes, which shift every code line, are final only
  /// when emission is complete. A no-op when honest numbering is already
  /// active, so the function-boundary call sites cost one bool check.
  clear_yo_line_position : (fn(mut(self) : Self) -> unit)({
    if(!self.line_directives, {
      return(());
    });
    match(
      self.line_last_path,
      .Some(_) => {
        self._ensure_code_line_start();
        line := line_restore_marker();
        line.push_string(_emitter_quote_c_filename(self.line_c_name.clone()));
        line.push_str("\"");
        self.emit_string_line(&line);
        self.line_last_path = Option(String).None;
      },
      .None => ()
    )
  }),
  /// [`#line` directives] Replace every restore marker's placeholder zeros
  /// with the honest physical line number of the line AFTER it, in the final
  /// `headers ++ "\n" ++ declarations ++ "\n" ++ code` stream. `sections` and
  /// `print` call this once emission is complete; chunked emission patches the
  /// same markers per chunk instead (chunk_assembly.yo) and this patch then
  /// fixes the monolithic `--emit-c` view. In-place byte writes: the code
  /// buffer is the ~100 MB the spill lever exists to avoid copying.
  patch_restore_line_numbers : (fn(mut(self) : Self) -> unit)({
    if(!self.line_directives, {
      return(());
    });
    base := (_emitter_count_newlines(&self.headers) + _emitter_count_newlines(&self.declarations) + usize(2));
    // Patch the buffer in place: take it out of `self.code` (with the field
    // emptied the buffer is unique, so `into_bytes` moves it out with no
    // copy), write the line numbers, and put it back below.
    taken := self.code;
    self.code = String.new();
    bytes := taken.into_bytes();
    n := bytes.len();
    marker := line_restore_marker();
    mb := marker;
    mlen := mb.len();
    (ls : usize) = usize(0);
    (c_nl : usize) = usize(0);
    while(ls < n, {
      // Line extent [ls, le); `has_nl` says whether le sits ON the newline.
      (le : usize) = ls;
      (has_nl : bool) = false;
      while((le < n) && !has_nl, {
        match(
          bytes.get(le),
          .Some(b) => if(b == u8(10), {
            has_nl = true;
          }, {
            le = (le + usize(1));
          }),
          .None => {
            le = (le + usize(1));
          }
        );
      });
      if((le - ls) >= mlen, {
        (mi : usize) = usize(0);
        (all_eq : bool) = true;
        while((mi < mlen) && all_eq, {
          a := match(bytes.get(ls + mi), .Some(b0) => b0, .None => u8(0));
          b := match(mb.get_byte(mi), .Some(b1) => b1, .None => u8(1));
          if(a != b, {
            all_eq = false;
          });
          mi = (mi + usize(1));
        });
        if(all_eq, {
          // The directive is physical line (base + c_nl + 1); `#line N` names
          // the line AFTER it, so N = base + c_nl + 2. The number is written
          // LEFT-aligned over the 8 placeholder digits, space-filled: a
          // zero-padded number reads as OCTAL to a pre-C99-conforming
          // preprocessor and clang warns about it.
          value := (base + c_nl + usize(2));
          if(value > usize(99999999), {
            value = usize(99999999);
          });
          digits := value.to_string();
          (wi : usize) = usize(0);
          while(wi < usize(8), {
            b := if(wi < digits.len(), digits.byte_at(wi), u8(32));
            _emitter_set_byte(&bytes, ls + usize(6) + wi, b);
            wi = (wi + usize(1));
          });
        });
      });
      if(has_nl, {
        c_nl = (c_nl + usize(1));
        ls = (le + usize(1));
      }, {
        ls = le;
      });
    });
    self.code = String.from_bytes(bytes);
  }),
  /// The full C source as its parts in order — headers, "\n", declarations,
  /// "\n", code: the bytes of `print()`, sharing the three buffers instead of
  /// concatenating them. With a code spill, the spilled bytes come between
  /// the second "\n" and the last part (`code_spilled_bytes` says how many). The compiler's own C is ~125 MB, and the
  /// concatenated copy (grown by doubling) was the peak of `compile`
  /// (plans/CODEGEN_MEMORY_REDUCTION.md §0.6).
  sections : (fn(mut(self) : Self) -> ArrayList(String))({
    self.patch_restore_line_numbers();
    parts := ArrayList(String).with_capacity(usize(5));
    parts.push(self.headers);
    parts.push(String.from("\n"));
    parts.push(self.declarations);
    parts.push(String.from("\n"));
    parts.push(self.code);
    parts
  }),
  /// Return the full C source: headers + "\n" + declarations + "\n" + code.
  print : (fn(mut(self) : Self) -> String)({
    self.patch_restore_line_numbers();
    result := String.new();
    result.push_string(&self.headers);
    result.push_str("\n");
    result.push_string(&self.declarations);
    result.push_str("\n");
    result.push_string(&self.code);
    result
  })
);
export(Emitter, line_restore_marker);
