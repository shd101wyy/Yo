//! Frame-based mutable environment for the self-hosted evaluator.
//!
//! Mirrors the essential parts of `src/env.ts` but in a more direct,
//! object-oriented style. A single `Environment` owns a stack of `Frame`s,
//! each of which owns its own list of `Variable`s. Lookups walk frames
//! from the innermost outward.
//!
//! Phase-2a scope: just the operations needed to evaluate primitive
//! literals, arithmetic, and simple function bodies. The full env in
//! `src/env.ts` also tracks where-clause constraints, ownership/RC, and
//! ID allocation — those land in later phases.
//!
//! Phase-2c adds: `id`, `is_owning_the_rc_value`, `is_owning_the_same_rc_value_as`
//! to `Variable`; global ID counter; `get_variables_from_env`.
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue } :: import("./types/type.yo");
{ EvalValue } :: import("./value.yo");
{ Token, TokenKind } :: import("./token.yo");
/// Global counter used by `generate_variable_id` to assign unique IDs.
(g_var_id_counter : usize) = usize(0);
/// Generate a unique, stable ID string for a new variable binding.
/// Mirrors `generateVarialeId` in `src/utils.ts` but uses a simple
/// monotonic counter instead of SHA-1 hashing; uniqueness is all that matters.
generate_variable_id :: (fn(_module_path : String, _name : String) -> String)({
  local_c := g_var_id_counter;
  s := local_c.to_string();
  g_var_id_counter = (g_var_id_counter + usize(1));
  s
});
/// A binding in some scope. `is_compile_time_only` mirrors the TS field of
/// the same name and indicates that the value was computed at compile time
/// (so codegen should not emit a runtime declaration for it).
Variable :: object(
  /// Unique identifier for this binding (monotonic counter string).
  id : String,
  name : String,
  ty : TypeValue,
  is_compile_time_only : bool,
  /// Frame index where this variable was introduced. Used so callers can
  /// detect cross-function references in closures or recursive lambdas.
  frame_level : usize,
  /// The compile-time value of this binding, if known. `None` for runtime
  /// variables whose value cannot be determined at compile time.
  value : Option(EvalValue),
  /// Whether this variable holds (owns) the RC value vs. borrows it.
  is_owning_the_rc_value : bool,
  /// Points to another variable that owns a share of the same RC object.
  /// Used for dup/drop optimisation across reassignments.
  is_owning_the_same_rc_value_as : Option(Box(Self)),
  /// Whether this variable can be reassigned (via `=`).
  /// Function parameters are not reassignable; locals declared with `:=` are.
  is_reassignable : bool,
  /// Token at which the variable was declared.
  token : Token,
  /// Token at which the variable was initialized; `.None` if uninitialized.
  initialized_at_token : Option(Token),
  /// Token at which the variable was consumed (linear-type tracking);
  /// `.None` if not yet consumed.
  consumed_at_token : Option(Token),
  /// Whether this variable was declared with `given(...)` and is therefore
  /// available as evidence for `using(...)` parameters in subsequent calls.
  is_implicit : bool,
  /// Whether this binding was created from destructuring an atom variable.
  /// Required by ownership analysis to suppress duplicate drop emission.
  is_created_from_destructuring_atom_variable : bool,
  /// Override C identifier for anonymous-fn parameter aliasing.
  parameter_alias : Option(String),
  /// Whether this variable was injected from an effect-row spread
  /// (`using(...(E))`). Such variables cannot satisfy concrete named
  /// `using()` requirements at call sites.
  is_from_effect_spread : bool,
  /// Whether this variable is the effect parameter of an `io.async` closure
  /// (captured into the closure's runtime state struct).
  is_effect_param : bool,
  /// Whether this variable is a module-level binding (`:=` at module scope).
  /// Module-level vars become C file-scope statics.
  is_module_level : bool,
  /// Doc comment associated with the declaration of this variable.
  doc_comment : Option(String)
);
/// Synthesize a placeholder `Token` for use when no real token exists
/// (e.g. internal compiler-injected bindings). Mirrors the way the TS
/// evaluator reuses zero-position tokens for internal variables.
synthetic_token :: (fn(name : String, module_path : String) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : name,
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : module_path,
    input : String.from("")
  )
);
/// Construct a `Variable` with all "advanced" fields defaulted. Used by the
/// internal define/define_val helpers that pre-date the production-style
/// shape. Callers that need fine-grained control should construct
/// `Variable(...)` directly or use `add_variable_to_env`.
make_default_variable :: (
  fn(
    id : String,
    name : String,
    ty : TypeValue,
    is_compile_time_only : bool,
    frame_level : usize,
    value : Option(EvalValue),
    token : Token
  ) -> Variable
)(
  Variable(
    id : id,
    name : name,
    ty : ty,
    is_compile_time_only : is_compile_time_only,
    frame_level : frame_level,
    value : value,
    is_owning_the_rc_value : false,
    is_owning_the_same_rc_value_as : Option(Box(Variable)).None,
    is_reassignable : false,
    token : token,
    initialized_at_token : Option(Token).None,
    consumed_at_token : Option(Token).None,
    is_implicit : false,
    is_created_from_destructuring_atom_variable : false,
    parameter_alias : Option(String).None,
    is_from_effect_spread : false,
    is_effect_param : false,
    is_module_level : false,
    doc_comment : Option(String).None
  )
);
/// A single lexical scope. Created by `push_frame`, destroyed by
/// `pop_frame`. `is_begin_block` marks frames originating from a `{ ; }`
/// begin-block (vs. function-call frames) so that temp variables can
/// later be hoisted to the nearest begin-block frame.
Frame :: object(
  variables : ArrayList(Variable),
  is_begin_block : bool
);
new_frame :: (fn(is_begin_block : bool) -> Frame)(
  Frame(variables : ArrayList(Variable).new(), is_begin_block : is_begin_block)
);
/// The environment itself.
Environment :: object(
  frames : ArrayList(Frame),
  module_path : String
);
impl(
  Environment,
  /// Create an environment with a single empty top-level frame.
  new : (fn(module_path : String) -> Self)({
    frames := ArrayList(Frame).new();
    frames.push(new_frame(true));
    Environment(frames : frames, module_path : module_path)
  }),
  /// Number of frames currently on the stack.
  frame_count : (fn(self : Self) -> usize)(self.frames.len()),
  /// Push a fresh frame onto the stack and return its 0-based index.
  push_frame : (fn(self : *(Self), is_begin_block : bool) -> usize)({
    self.frames.push(new_frame(is_begin_block));
    self.frames.len() - usize(1)
  }),
  /// Pop the innermost frame. Calling `pop_frame` on an empty stack is
  /// a no-op (Phase 2a doesn't yet have a panic API; the caller should
  /// check `frame_count` first when correctness matters).
  pop_frame : (fn(self : *(Self)) -> unit)(
    cond(
      (self.frames.len() > usize(0)) => {
        ___ := self.frames.pop();
        ()
      },
      true => ()
    )
  ),
  /// Define a new variable in the innermost frame. Returns the frame
  /// index it was placed in.
  define : (fn(self : *(Self), name : String, ty : TypeValue, is_compile_time_only : bool) -> usize)({
    n := self.frames.len();
    cond(
      (n == usize(0)) => {
        // Auto-create an outermost frame so we never crash. This matches
        // the TS env's `createEmptyEnv` behavior of always having at
        // least one frame.
        ___ := recur(self, name, ty, is_compile_time_only);
        usize(0)
      },
      true => {
        idx := (n - usize(1));
        var := make_default_variable(
          generate_variable_id(self.module_path, name),
          name,
          ty,
          is_compile_time_only,
          idx,
          Option(EvalValue).None,
          synthetic_token(name, self.module_path)
        );
        ___ := (&(self.frames)).index(idx).*.variables.push(var);
        idx
      }
    )
  }),
  /// Define a new variable in the innermost frame with an initial compile-time
  /// value. Returns the frame index. For runtime variables pass `Option(EvalValue).None`.
  define_val : (fn(self : *(Self), name : String, ty : TypeValue, is_compile_time_only : bool, value : Option(EvalValue)) -> usize)({
    n := self.frames.len();
    cond(
      (n == usize(0)) => {
        ___ := recur(self, name, ty, is_compile_time_only, value);
        usize(0)
      },
      true => {
        idx := (n - usize(1));
        var := make_default_variable(
          generate_variable_id(self.module_path, name),
          name,
          ty,
          is_compile_time_only,
          idx,
          value,
          synthetic_token(name, self.module_path)
        );
        ___ := (&(self.frames)).index(idx).*.variables.push(var);
        idx
      }
    )
  }),
  /// Mutate the value of an existing binding, walking from innermost to
  /// outermost frame. Returns `true` if the variable was found and updated.
  set_value : (fn(self : *(Self), name : String, new_value : EvalValue) -> bool)({
    n := self.frames.len();
    (found : bool) = false;
    (i : usize) = n;
    while(runtime(i > usize(0)), {
      i = (i - usize(1));
      frame_ptr := (&(self.frames)).index(i);
      m := frame_ptr.*.variables.len();
      (j : usize) = m;
      while(runtime(j > usize(0)), {
        j = (j - usize(1));
        var_ptr := (&(frame_ptr.*.variables)).index(j);
        cond(
          (var_ptr.*.name == name) => {
            var_ptr.*.value =.Some(new_value);
            found = true;
            j = usize(0);
            i = usize(0);
          },
          true => ()
        );
      });
    });
    found
  }),
  /// Look up a variable by name, walking from innermost to outermost
  /// frame. Returns the most recent binding if shadowed.
  lookup : (fn(self : Self, name : String) -> Option(Variable))({
    n := self.frames.len();
    (found : Option(Variable)) =.None;
    (i : usize) = n;
    while(runtime(i > usize(0)), {
      i = (i - usize(1));
      match(
        self.frames.get(i),
        .Some(frame) => {
          vars := frame.variables;
          m := vars.len();
          (j : usize) = m;
          while(runtime(j > usize(0)), {
            j = (j - usize(1));
            match(
              vars.get(j),
              .Some(var) =>
                cond(
                  (var.name == name) => {
                    found =.Some(var);
                    j = usize(0);
                    i = usize(0);
                  },
                  true => ()
                ),
              .None => ()
            );
          });
        },
        .None => ()
      );
    });
    found
  }),
  /// True if `name` is bound in any frame.
  contains : (fn(self : Self, name : String) -> bool)(
    match(
      self.lookup(name),
      .Some(_) => true,
      .None => false
    )
  )
);
/// Filter the variables of a single frame by name. Mirrors
/// `getVariablesFromFrame` in `src/env.ts`. Used by
/// `find_variable_frame_level` and any other check that wants to know
/// whether a specific frame defines a given binding.
get_variables_from_frame :: (fn(frame : Frame, name : String) -> ArrayList(Variable))({
  result := ArrayList(Variable).new();
  m := frame.variables.len();
  (j : usize) = usize(0);
  while(runtime(j < m), {
    match(
      frame.variables.get(j),
      .Some(var) => cond(
        (var.name == name) => {
          ___ := result.push(var);
          ()
        },
        true => ()
      ),
      .None => ()
    );
    j = (j + usize(1));
  });
  result
});
/// Walk frames from innermost to outermost and return the frame index
/// of the first frame containing a variable named `name`. Returns
/// `.None` when no such variable exists in `env`. Mirrors TS
/// `findVariableFrameLevel` in `src/env.ts`.
find_variable_frame_level :: (fn(env : Environment, name : String) -> Option(usize))({
  n := env.frames.len();
  cond(
    (n == usize(0)) => Option(usize).None,
    true => {
      (result : Option(usize)) = Option(usize).None;
      (i : usize) = (n - usize(1));
      // Walk innermost (n-1) → outermost (0). Break when result set.
      while(runtime(result.is_none() && (i < n)), {
        match(
          env.frames.get(i),
          .None => (),
          .Some(frame) => {
            vars := get_variables_from_frame(frame, name);
            if(vars.len() > usize(0), {
              result = Option(usize).Some(i);
            });
          }
        );
        // Decrement; underflow guard since i is usize. If i == 0 and
        // not found, set result to None-equivalent to break the loop.
        cond(
          (i == usize(0)) => {
            // Force loop exit by setting i past n. result stays None.
            i = n;
          },
          true => {
            i = (i - usize(1));
          }
        );
      });
      result
    }
  )
});
/// Search every frame (outermost → innermost) for bindings with the given
/// name and return them all in that order. Mirrors `getVariablesFromEnv` in
/// `src/env.ts`. Useful for suspension analysis which needs all shadowed
/// definitions of the same name.
get_variables_from_env :: (fn(env : Environment, name : String) -> ArrayList(Variable))({
  result := ArrayList(Variable).new();
  n := env.frames.len();
  (i : usize) = usize(0);
  while(runtime(i < n), {
    match(
      env.frames.get(i),
      .Some(frame) => {
        vars := frame.variables;
        m := vars.len();
        (j : usize) = usize(0);
        while(runtime(j < m), {
          match(
            vars.get(j),
            .Some(var) => {
              cond(
                (var.name == name) => {
                  ___ := result.push(var);
                  ()
                },
                true => ()
              );
            },
            .None => ()
          );
          j = (j + usize(1));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  result
});
/// Return all variables from all frames (outermost → innermost).
///
/// Mirrors `getVariablesFromEnvByFilter(env, () => true)` from `src/env.ts`.
/// Used by `validateFunctionReturnType` to search for transitive SomeType usage.
get_all_variables_from_env :: (fn(env : Environment) -> ArrayList(Variable))({
  result := ArrayList(Variable).new();
  n := env.frames.len();
  (i : usize) = usize(0);
  while(runtime(i < n), {
    match(
      env.frames.get(i),
      .Some(frame) => {
        vars := frame.variables;
        m := vars.len();
        (j : usize) = usize(0);
        while(runtime(j < m), {
          match(
            vars.get(j),
            .Some(var) => {
              ___ := result.push(var);
            },
            .None => ()
          );
          j = (j + usize(1));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  result
});
/// Spec for adding a variable to an environment, mirroring the production
/// `addVariableToEnv` API. The `id` and `frame_level` are filled in by
/// `add_variable_to_env` itself, so callers leave them unset (they are
/// ignored if provided).
///
/// The Yo env is mutable, so `add_variable_to_env` mutates `env` in place
/// and returns the produced `Variable` (the production TS variant clones
/// the env; this is a deliberate divergence — Yo's env is built around
/// frame-stack mutation already).
add_variable_to_env :: (
  fn(
    env : *(Environment),
    name : String,
    ty : TypeValue,
    value : Option(EvalValue),
    is_compile_time_only : bool,
    is_reassignable : bool,
    is_owning_the_rc_value : bool,
    is_implicit : bool,
    token : Token
  ) -> Option(Variable)
)({
  n := env.frames.len();
  if(n == usize(0), {
    return(Option(Variable).None);
  });
  idx := (n - usize(1));
  var := Variable(
    id : generate_variable_id(env.module_path, name),
    name : name,
    ty : ty,
    is_compile_time_only : is_compile_time_only,
    frame_level : idx,
    value : value,
    is_owning_the_rc_value : is_owning_the_rc_value,
    is_owning_the_same_rc_value_as : Option(Box(Variable)).None,
    is_reassignable : is_reassignable,
    token : token,
    initialized_at_token : Option(Token).Some(token),
    consumed_at_token : Option(Token).None,
    is_implicit : is_implicit,
    is_created_from_destructuring_atom_variable : false,
    parameter_alias : Option(String).None,
    is_from_effect_spread : false,
    is_effect_param : false,
    is_module_level : false,
    doc_comment : Option(String).None
  );
  match(
    env.frames.get(idx),
    .Some(frame) => {
      ___ := frame.variables.push(var);
      ()
    },
    .None => ()
  );
  Option(Variable).Some(var)
});
/// Find the variable with the same `id` as `old_var` in the env and update its
/// mutable fields to match `new_var`.  Since `Variable` is an `object` (RC
/// reference), mutation is in-place and all references in the env see the change.
///
/// Mirrors `updateExistingVariable` from `src/env.ts`.
update_existing_variable :: (fn(env : Environment, old_var : Variable, new_var : Variable) -> unit)({
  n := env.frames.len();
  (i : usize) = n;
  while(runtime(i > usize(0)), {
    i = (i - usize(1));
    match(
      env.frames.get(i),
      .Some(frame) => {
        vars := frame.variables;
        m := vars.len();
        (j : usize) = m;
        while(runtime(j > usize(0)), {
          j = (j - usize(1));
          match(
            vars.get(j),
            .Some(v) => {
              if(v.id == old_var.id, {
                v.ty = new_var.ty;
                v.value = new_var.value;
                v.is_compile_time_only = new_var.is_compile_time_only;
                v.is_owning_the_rc_value = new_var.is_owning_the_rc_value;
                v.initialized_at_token = new_var.initialized_at_token;
                v.consumed_at_token = new_var.consumed_at_token;
                v.is_reassignable = new_var.is_reassignable;
              });
            },
            .None => ()
          );
        });
      },
      .None => ()
    );
  });
});
/// Return a dummy placeholder `Variable` for use in unreachable match-arm
/// fallbacks (analogous to `make_err_expr` for `AstExpr`). The body uses
/// `_dummy.module_path` so the result is always a runtime value — the CTFE
/// evaluator cannot inline a constant when any field depends on a runtime
/// argument, preventing codegen from hitting the "unhandled comptime RC
/// object" path.
make_err_variable :: (fn(_dummy : Environment) -> Variable)(
  Variable(
    id : String.from("__err__"),
    name : String.from("__err__"),
    ty : TypeValue.Unit,
    is_compile_time_only : false,
    frame_level : usize(0),
    value : Option(EvalValue).None,
    is_owning_the_rc_value : false,
    is_owning_the_same_rc_value_as : Option(Box(Variable)).None,
    is_reassignable : false,
    token : Token(
      kind : TokenKind.Identifier,
      value : String.from("__err__"),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : _dummy.module_path,
      input : String.from("")
    ),
    initialized_at_token : Option(Token).None,
    consumed_at_token : Option(Token).None,
    is_implicit : false,
    is_created_from_destructuring_atom_variable : false,
    parameter_alias : Option(String).None,
    is_from_effect_spread : false,
    is_effect_param : false,
    is_module_level : false,
    doc_comment : Option(String).None
  )
);
/// Add a variable to the **nearest begin-block frame**, searching from the
/// innermost frame outward.  Falls back to the innermost frame when no
/// begin-block frame is found.
///
/// Mirrors `addVariableToEnv` with `addToBeginBlockFrame: true` in `src/env.ts`.
add_variable_to_begin_block_frame :: (
  fn(
    env : *(Environment),
    name : String,
    ty : TypeValue,
    value : Option(EvalValue),
    is_compile_time_only : bool,
    is_owning_the_rc_value : bool,
    token : Token
  ) -> Option(Variable)
)({
  n := env.frames.len();
  if(n == usize(0), {
    return(Option(Variable).None);
  });
  // Find the nearest begin-block frame (innermost first).
  (found_idx : usize) = (n - usize(1));
  (fi : usize) = n;
  while(runtime(fi > usize(0)), {
    fi = (fi - usize(1));
    match(
      env.frames.get(fi),
      .Some(f) => {
        if(f.is_begin_block, {
          found_idx = fi;
          fi = usize(0); // break
        });
      },
      .None => ()
    );
  });
  var := Variable(
    id : generate_variable_id(env.module_path, name),
    name : name,
    ty : ty,
    is_compile_time_only : is_compile_time_only,
    frame_level : found_idx,
    value : value,
    is_owning_the_rc_value : is_owning_the_rc_value,
    is_owning_the_same_rc_value_as : Option(Box(Variable)).None,
    is_reassignable : true,
    token : token,
    initialized_at_token : Option(Token).Some(token),
    consumed_at_token : Option(Token).None,
    is_implicit : false,
    is_created_from_destructuring_atom_variable : false,
    parameter_alias : Option(String).None,
    is_from_effect_spread : false,
    is_effect_param : false,
    is_module_level : false,
    doc_comment : Option(String).None
  );
  match(
    env.frames.get(found_idx),
    .Some(frame) => {
      ___ := frame.variables.push(var);
    },
    .None => ()
  );
  Option(Variable).Some(var)
});
/// Create an independent shallow clone of an Environment.
///
/// Each frame gets a fresh ArrayList(Variable) that shares the same Variable
/// RC objects as the original. This means existing variables are shared
/// (mutations to a Variable propagate), but new variables added to a cloned
/// frame do NOT affect the original. Used by `evaluate_ctl_function_body_inline`
/// to build a specialized env without contaminating the caller's env.
///
/// Mirrors `pushEnvFrame` semantics: the clone has the same frame stack depth,
/// so callers should push an extra frame after cloning if needed.
///
/// Mirrors the shallow-copy used by `pushEnvFrame` in `src/env.ts`.
clone_env :: (fn(env : Environment) -> Environment)({
  cloned_frames := ArrayList(Frame).new();
  n := env.frames.len();
  (i : usize) = usize(0);
  while(runtime(i < n), {
    match(
      env.frames.get(i),
      .Some(orig_frame) => {
        new_vars := ArrayList(Variable).new();
        m := orig_frame.variables.len();
        (j : usize) = usize(0);
        while(runtime(j < m), {
          match(
            orig_frame.variables.get(j),
            .Some(v) => {
              ___ := new_vars.push(v);
            },
            .None => ()
          );
          j = (j + usize(1));
        });
        cloned_frames.push(Frame(variables : new_vars, is_begin_block : orig_frame.is_begin_block));
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  Environment(frames : cloned_frames, module_path : (&(env.module_path)).clone())
});
export(
  Variable,
  Frame,
  Environment,
  new_frame,
  generate_variable_id,
  get_variables_from_env,
  get_variables_from_frame,
  get_all_variables_from_env,
  find_variable_frame_level,
  make_default_variable,
  make_err_variable,
  synthetic_token,
  add_variable_to_env,
  add_variable_to_begin_block_frame,
  update_existing_variable,
  clone_env
);
