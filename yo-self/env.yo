//! Frame-based mutable environment for the self-hosted evaluator.
//!
//! Mirrors the essential parts of `src/env.ts` but in a more direct,
//! object-oriented style. A single `Environment` owns a stack of `Frame`s,
//! each of which owns its own list of `Variable`s. Lookups walk frames
//! from the innermost outward.
//!
//! Phase-2a scope: just the operations needed to evaluate primitive
//! literals, arithmetic, and simple function bodies. The full env in
//! `src/env.ts` also tracks where-clause constraints, ownership/RC, and
//! ID allocation — those land in later phases.
//!
//! Phase-2c adds: `id`, `is_owning_the_rc_value`, `is_owning_the_same_rc_value_as`
//! to `Variable`; global ID counter; `get_variables_from_env`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TypeValue } :: import("./types/definitions.yo");
{ type_to_string } :: import("./types/string.yo");
{
  is_some_type,
  is_trait_type,
  is_pointer_type,
  is_function_type,
  is_comptime_int_type,
  is_comptime_float_type,
  is_comptime_string_type,
  is_dyn_type,
  is_type_application_type
} :: import("./types/guards.yo");
{ t_i32, t_f64, t_str } :: import("./types/creators.yo");
{ type_contains_rc_type } :: import("./types/utils.yo");
{ are_types_compatible } :: import("./types/compatibility.yo");
{
  MethodEntry,
  get_type_trait_methods_by_name,
  type_id_or_empty
} :: import("./evaluator/values/type_trait_methods.yo");
{ EvalValue } :: import("./value.yo");
{ clone_value } :: import("./evaluator/values/clone_value.yo");
{ Token, TokenKind } :: import("./token.yo");
/// Global counter used by `generate_variable_id` to assign unique IDs.
(g_var_id_counter : usize) = usize(0);
/// Generate a unique, stable ID string for a new variable binding.
/// Mirrors `generateVarialeId` in `src/utils.ts` but uses a simple
/// monotonic counter instead of SHA-1 hashing; uniqueness is all that matters.
generate_variable_id :: (fn(_module_path : String, _name : String) -> String)({
  local_c := g_var_id_counter;
  s := local_c.to_string();
  g_var_id_counter = (g_var_id_counter + usize(1));
  s
});
/// A binding in some scope. `is_compile_time_only` mirrors the TS field of
/// the same name and indicates that the value was computed at compile time
/// (so codegen should not emit a runtime declaration for it).
Variable :: object(
  /// Unique identifier for this binding (monotonic counter string).
  id : String,
  name : String,
  ty : TypeValue,
  is_compile_time_only : bool,
  /// Frame index where this variable was introduced. Used so callers can
  /// detect cross-function references in closures or recursive lambdas.
  frame_level : usize,
  /// The compile-time value of this binding, if known. `None` for runtime
  /// variables whose value cannot be determined at compile time.
  value : Option(EvalValue),
  /// Whether this variable holds (owns) the RC value vs. borrows it.
  is_owning_the_rc_value : bool,
  /// Points to another variable that owns a share of the same RC object.
  /// Used for dup/drop optimisation across reassignments.
  is_owning_the_same_rc_value_as : Option(Box(Self)),
  /// Whether this variable can be reassigned (via `=`).
  /// Function parameters are not reassignable; locals declared with `:=` are.
  is_reassignable : bool,
  /// Token at which the variable was declared.
  token : Token,
  /// Token at which the variable was initialized; `.None` if uninitialized.
  initialized_at_token : Option(Token),
  /// Token at which the variable was consumed (linear-type tracking);
  /// `.None` if not yet consumed. `Box`ed: almost always `.None`, so an inline
  /// `Option(Token)` reserved ~sizeof(Token) (~104 B) in every Variable (×2.6M
  /// in the self-compile) for nothing — boxing reclaims it (P2). The rare `.Some`
  /// allocates a transient heap Token; consumers unwrap with `.*`.
  consumed_at_token : Option(Box(Token)),
  /// Whether this variable was declared with `given(...)` and is therefore
  /// available as evidence for `...` parameters in subsequent calls.
  is_implicit : bool,
  /// Whether this binding was created from destructuring an atom variable.
  /// Required by ownership analysis to suppress duplicate drop emission.
  is_created_from_destructuring_atom_variable : bool,
  /// Override C identifier for anonymous-fn parameter aliasing.
  parameter_alias : Option(String),
  /// Whether this variable was injected from an effect-row spread
  /// (`E : Type.Struct`). Such variables cannot satisfy concrete named
  /// `` requirements at call sites.
  is_from_effect_spread : bool,
  /// Whether this variable is the effect parameter of an `io.async` closure
  /// (captured into the closure's runtime state struct).
  is_effect_param : bool,
  /// Whether this variable is a module-level binding (`:=` at module scope).
  /// Module-level vars become C file-scope statics.
  is_module_level : bool,
  /// Doc comment associated with the declaration of this variable.
  doc_comment : Option(String),
  /// Whether this binding is a by-reference borrow — a `ref(name) : T`
  /// parameter or a `ref(name) := ...` local. Mirrors `Variable.isRef` in
  /// TypeScript; consumed by `is_flowable_expr` (R1 of the `ref(T)`-flow
  /// soundness check). Appended last so existing positional constructions only
  /// need trailing arguments.
  is_ref : bool,
  /// Whether this binding is a function parameter (any parameter, not just
  /// `ref`). Mirrors `Variable.isParameter`; consumed by the slice-flowability
  /// arm of `is_flowable_expr` (R1'').
  is_parameter : bool
);
/// Synthesize a placeholder `Token` for use when no real token exists
/// (e.g. internal compiler-injected bindings). Mirrors the way the TS
/// evaluator reuses zero-position tokens for internal variables.
synthetic_token :: (fn(name : String, module_path : String) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : name,
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : module_path,
    input : String.from("")
  )
);
/// Construct a `Variable` with all "advanced" fields defaulted. Used by the
/// internal define/define_val helpers that pre-date the production-style
/// shape. Callers that need fine-grained control should construct
/// `Variable(..., is_ref : false, is_parameter : false)` directly or use `add_variable_to_env`.
make_default_variable :: (
  fn(
    id : String,
    name : String,
    ty : TypeValue,
    is_compile_time_only : bool,
    frame_level : usize,
    value : Option(EvalValue),
    token : Token
  ) -> Variable
)(
  Variable(
    id : id,
    name : name,
    ty : ty,
    is_compile_time_only : is_compile_time_only,
    frame_level : frame_level,
    value : value,
    is_owning_the_rc_value : false,
    is_owning_the_same_rc_value_as : Option(Box(Variable)).None,
    is_reassignable : false,
    token : token,
    initialized_at_token : Option(Token).None,
    consumed_at_token : Option(Box(Token)).None,
    is_implicit : false,
    is_created_from_destructuring_atom_variable : false,
    parameter_alias : Option(String).None,
    is_from_effect_spread : false,
    is_effect_param : false,
    is_module_level : false,
    doc_comment : Option(String).None,
    is_ref : false,
    is_parameter : false
  )
);
/// A where-clause constraint attached to a single `SomeType` (or to a
/// `TypeApplication` keyed by its structural id) in some frame. Mirrors
/// the TS `WhereClauseConstraints` record.
///
/// `some_type` is the constrained type variable (always a `.SomeT(...)`
/// for plain SomeType constraints; for TypeApplication constraints it
/// stores the constructor SomeType for backward compatibility, while the
/// HashMap key encodes the structural identity).
WhereClauseConstraints :: object(
  some_type : TypeValue,
  required_traits : ArrayList(TypeValue),
  negative_traits : ArrayList(TypeValue)
);
/// A single lexical scope. Created by `push_frame`, destroyed by
/// `pop_frame`. `is_begin_block` marks frames originating from a `{ ; }`
/// begin-block (vs. function-call frames) so that temp variables can
/// later be hoisted to the nearest begin-block frame.
///
/// `id` is a monotonic-counter string used by the evaluator to
/// distinguish frames for trace logging. `where_clause_constraints`
/// holds frame-scoped where-clause evidence; it is discarded when the
/// frame is popped.
Frame :: object(
  id : String,
  variables : ArrayList(Variable),
  is_begin_block : bool,
  where_clause_constraints : HashMap(String, WhereClauseConstraints)
);
new_frame :: (fn(is_begin_block : bool) -> Frame)(
  Frame(
    id : generate_variable_id(String.from(""), String.from("frame")),
    variables : ArrayList(Variable).new(),
    is_begin_block : is_begin_block,
    where_clause_constraints : HashMap(String, WhereClauseConstraints).new()
  )
);
/// The environment itself.
///
/// `function_declaration_frame_level` mirrors TS
/// `Environment.functionDeclarationFrameLevel` — the frame index at
/// which the enclosing function was declared, used so closures can
/// detect captures from outer scopes. `Option(usize).None` means
/// no enclosing function (TS represents this with `-1`).
///
/// `input_string` mirrors TS `Environment.inputString` — the full
/// source text of the module, kept on the env so error formatters
/// can locate token positions back into the original source.
Environment :: object(
  frames : ArrayList(Frame),
  module_path : String,
  function_declaration_frame_level : Option(usize),
  input_string : String
);
impl(
  Environment,
  /// Create an environment with a single empty top-level frame.
  new : (fn(module_path : String) -> Self)({
    frames := ArrayList(Frame).new();
    frames.push(new_frame(true));
    Environment(
      frames : frames,
      module_path : module_path,
      function_declaration_frame_level : Option(usize).None,
      input_string : String.from("")
    )
  }),
  /// Number of frames currently on the stack.
  frame_count : (fn(self : Self) -> usize)(self.frames.len()),
  /// Push a fresh frame onto the stack and return its 0-based index.
  push_frame : (fn(self : Self, is_begin_block : bool) -> usize)({
    self.frames.push(new_frame(is_begin_block));
    self.frames.len() - usize(1)
  }),
  /// Pop the innermost frame. Calling `pop_frame` on an empty stack is
  /// a no-op (Phase 2a doesn't yet have a panic API; the caller should
  /// check `frame_count` first when correctness matters).
  pop_frame : (fn(self : Self) -> unit)(
    cond(
      (self.frames.len() > usize(0)) => {
        ___ := self.frames.pop();
        ()
      },
      true => ()
    )
  ),
  /// Pop the innermost frame WITHOUT mutating the current `frames` list:
  /// reassign `self.frames` to a fresh list holding all-but-the-last frame
  /// (same `Frame` refs). Use this when the current `frames` list may be
  /// shared with a recorded `ExprInfo.env` snapshot (which must keep its
  /// frame set) — an in-place `pop` would corrupt that snapshot. See
  /// `snapshot_env` + issues/fixed/yo-self-recorded-env-aliasing.md.
  pop_frame_nonmutating : (fn(self : Self) -> unit)(
    cond(
      (self.frames.len() > usize(0)) => {
        kept := ArrayList(Frame).new();
        keep_n := (self.frames.len() - usize(1));
        (i : usize) = usize(0);
        while(i < keep_n, {
          match(
            self.frames.get(i),
            .Some(f) => {
              ___ := kept.push(f);
            },
            .None => ()
          );
          i = (i + usize(1));
        });
        self.frames = kept;
        ()
      },
      true => ()
    )
  ),
  /// Define a new variable in the innermost frame. Returns the frame
  /// index it was placed in.
  define : (fn(self : Self, name : String, ty : TypeValue, is_compile_time_only : bool) -> usize)({
    n := self.frames.len();
    cond(
      (n == usize(0)) => {
        // Auto-create an outermost frame so we never crash. This matches
        // the TS env's `createEmptyEnv` behavior of always having at
        // least one frame.
        ___ := recur(self, name, ty, is_compile_time_only);
        usize(0)
      },
      true => {
        idx := (n - usize(1));
        var := make_default_variable(
          generate_variable_id(self.module_path, name),
          name,
          ty,
          is_compile_time_only,
          idx,
          Option(EvalValue).None,
          synthetic_token(name, self.module_path)
        );
        ___ := self.frames(idx).variables.push(var);
        idx
      }
    )
  }),
  /// Define a new variable in the innermost frame with an initial compile-time
  /// value. Returns the frame index. For runtime variables pass `Option(EvalValue).None`.
  define_val : (fn(self : Self, name : String, ty : TypeValue, is_compile_time_only : bool, value : Option(EvalValue)) -> usize)({
    n := self.frames.len();
    cond(
      (n == usize(0)) => {
        ___ := recur(self, name, ty, is_compile_time_only, value);
        usize(0)
      },
      true => {
        idx := (n - usize(1));
        var := make_default_variable(
          generate_variable_id(self.module_path, name),
          name,
          ty,
          is_compile_time_only,
          idx,
          value,
          synthetic_token(name, self.module_path)
        );
        ___ := self.frames(idx).variables.push(var);
        idx
      }
    )
  }),
  /// Mutate the value of an existing binding, walking from innermost to
  /// outermost frame. Returns `true` if the variable was found and updated.
  set_value : (fn(self : Self, name : String, new_value : EvalValue) -> bool)({
    n := self.frames.len();
    (found : bool) = false;
    (i : usize) = n;
    while(i > usize(0), {
      i = (i - usize(1));
      frame_ptr := &(self.frames(i));
      m := frame_ptr.*.variables.len();
      (j : usize) = m;
      while(j > usize(0), {
        j = (j - usize(1));
        var_ptr := &(frame_ptr.*.variables(j));
        cond(
          (var_ptr.*.name == name) => {
            var_ptr.*.value =.Some(new_value);
            found = true;
            j = usize(0);
            i = usize(0);
          },
          true => ()
        );
      });
    });
    found
  }),
  /// Look up a variable by name, walking from innermost to outermost
  /// frame. Returns the most recent binding if shadowed.
  lookup : (fn(self : Self, name : String) -> Option(Variable))({
    n := self.frames.len();
    (found : Option(Variable)) =.None;
    (i : usize) = n;
    while(i > usize(0), {
      i = (i - usize(1));
      match(
        self.frames.get(i),
        .Some(frame) => {
          vars := frame.variables;
          m := vars.len();
          (j : usize) = m;
          while(j > usize(0), {
            j = (j - usize(1));
            match(
              vars.get(j),
              .Some(var) =>
                cond(
                  (var.name == name) => {
                    found =.Some(var);
                    j = usize(0);
                    i = usize(0);
                  },
                  true => ()
                ),
              .None => ()
            );
          });
        },
        .None => ()
      );
    });
    found
  }),
  /// True if `name` is bound in any frame.
  contains : (fn(self : Self, name : String) -> bool)(
    match(
      self.lookup(name),
      .Some(_) => true,
      .None => false
    )
  )
);
/// Filter the variables of a single frame by name. Mirrors
/// `getVariablesFromFrame` in `src/env.ts`. Used by
/// `find_variable_frame_level` and any other check that wants to know
/// whether a specific frame defines a given binding.
get_variables_from_frame :: (fn(frame : Frame, name : String) -> ArrayList(Variable))({
  result := ArrayList(Variable).new();
  m := frame.variables.len();
  (j : usize) = usize(0);
  while(j < m, {
    match(
      frame.variables.get(j),
      .Some(var) => cond(
        (var.name == name) => {
          ___ := result.push(var);
          ()
        },
        true => ()
      ),
      .None => ()
    );
    j = (j + usize(1));
  });
  result
});
/// Walk frames from innermost to outermost and return the frame index
/// of the first frame containing a variable named `name`. Returns
/// `.None` when no such variable exists in `env`. Mirrors TS
/// `findVariableFrameLevel` in `src/env.ts`.
find_variable_frame_level :: (fn(env : Environment, name : String) -> Option(usize))({
  n := env.frames.len();
  cond(
    (n == usize(0)) => Option(usize).None,
    true => {
      (result : Option(usize)) = Option(usize).None;
      (i : usize) = (n - usize(1));
      // Walk innermost (n-1) → outermost (0). Break when result set.
      while(result.is_none() && (i < n), {
        match(
          env.frames.get(i),
          .None => (),
          .Some(frame) => {
            vars := get_variables_from_frame(frame, name);
            if(vars.len() > usize(0), {
              result = Option(usize).Some(i);
            });
          }
        );
        // Decrement; underflow guard since i is usize. If i == 0 and
        // not found, set result to None-equivalent to break the loop.
        cond(
          (i == usize(0)) => {
            // Force loop exit by setting i past n. result stays None.
            i = n;
          },
          true => {
            i = (i - usize(1));
          }
        );
      });
      result
    }
  )
});
/// Search every frame (outermost → innermost) for bindings with the given
/// name and return them all in that order. Mirrors `getVariablesFromEnv` in
/// `src/env.ts`. Useful for suspension analysis which needs all shadowed
/// definitions of the same name.
get_variables_from_env :: (fn(env : Environment, name : String) -> ArrayList(Variable))({
  result := ArrayList(Variable).new();
  n := env.frames.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      env.frames.get(i),
      .Some(frame) => {
        vars := frame.variables;
        m := vars.len();
        (j : usize) = usize(0);
        while(j < m, {
          match(
            vars.get(j),
            .Some(var) => {
              cond(
                (var.name == name) => {
                  ___ := result.push(var);
                  ()
                },
                true => ()
              );
            },
            .None => ()
          );
          j = (j + usize(1));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  result
});
/// Return all variables from all frames (outermost → innermost).
///
/// Mirrors `getVariablesFromEnvByFilter(env, () => true)` from `src/env.ts`.
/// Used by `validateFunctionReturnType` to search for transitive SomeType usage.
get_all_variables_from_env :: (fn(env : Environment) -> ArrayList(Variable))({
  result := ArrayList(Variable).new();
  n := env.frames.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      env.frames.get(i),
      .Some(frame) => {
        vars := frame.variables;
        m := vars.len();
        (j : usize) = usize(0);
        while(j < m, {
          match(
            vars.get(j),
            .Some(var) => {
              ___ := result.push(var);
            },
            .None => ()
          );
          j = (j + usize(1));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  result
});
/// Spec for adding a variable to an environment, mirroring the production
/// `addVariableToEnv` API. The `id` and `frame_level` are filled in by
/// `add_variable_to_env` itself, so callers leave them unset (they are
/// ignored if provided).
///
/// The Yo env is mutable, so `add_variable_to_env` mutates `env` in place
/// and returns the produced `Variable` (the production TS variant clones
/// the env; this is a deliberate divergence — Yo's env is built around
/// frame-stack mutation already).
add_variable_to_env :: (
  fn(
    env : Environment,
    name : String,
    ty : TypeValue,
    value : Option(EvalValue),
    is_compile_time_only : bool,
    is_reassignable : bool,
    is_owning_the_rc_value : bool,
    is_implicit : bool,
    token : Token
  ) -> Option(Variable)
)({
  n := env.frames.len();
  if(n == usize(0), {
    return(Option(Variable).None);
  });
  idx := (n - usize(1));
  var := Variable(
    id : generate_variable_id(env.module_path, name),
    name : name,
    ty : ty,
    is_compile_time_only : is_compile_time_only,
    frame_level : idx,
    value : value,
    is_owning_the_rc_value : is_owning_the_rc_value,
    is_owning_the_same_rc_value_as : Option(Box(Variable)).None,
    is_reassignable : is_reassignable,
    token : token,
    initialized_at_token : Option(Token).Some(token),
    consumed_at_token : Option(Box(Token)).None,
    is_implicit : is_implicit,
    is_created_from_destructuring_atom_variable : false,
    parameter_alias : Option(String).None,
    is_from_effect_spread : false,
    is_effect_param : false,
    is_module_level : false,
    doc_comment : Option(String).None,
    is_ref : false,
    is_parameter : false
  );
  match(
    env.frames.get(idx),
    .Some(frame) => {
      ___ := frame.variables.push(var);
      ()
    },
    .None => ()
  );
  Option(Variable).Some(var)
});
/// Like `add_variable_to_env`, but also sets the `is_ref` and `is_parameter`
/// flags on the resulting Variable (so `is_flowable_expr` can recognise
/// `ref`-bound params and parameter sources). Mirrors TS parameter binding
/// (`function.ts:711-713`).
add_parameter_to_env :: (
  fn(
    env : Environment,
    name : String,
    ty : TypeValue,
    value : Option(EvalValue),
    is_compile_time_only : bool,
    is_reassignable : bool,
    is_owning_the_rc_value : bool,
    is_implicit : bool,
    is_ref : bool,
    is_parameter : bool,
    token : Token
  ) -> Option(Variable)
)({
  n := env.frames.len();
  if(n == usize(0), {
    return(Option(Variable).None);
  });
  idx := (n - usize(1));
  var := Variable(
    id : generate_variable_id(env.module_path, name),
    name : name,
    ty : ty,
    is_compile_time_only : is_compile_time_only,
    frame_level : idx,
    value : value,
    is_owning_the_rc_value : is_owning_the_rc_value,
    is_owning_the_same_rc_value_as : Option(Box(Variable)).None,
    is_reassignable : is_reassignable,
    token : token,
    initialized_at_token : Option(Token).Some(token),
    consumed_at_token : Option(Box(Token)).None,
    is_implicit : is_implicit,
    is_created_from_destructuring_atom_variable : false,
    parameter_alias : Option(String).None,
    is_from_effect_spread : false,
    is_effect_param : false,
    is_module_level : false,
    doc_comment : Option(String).None,
    is_ref : is_ref,
    is_parameter : is_parameter
  );
  match(
    env.frames.get(idx),
    .Some(frame) => {
      ___ := frame.variables.push(var);
      ()
    },
    .None => ()
  );
  Option(Variable).Some(var)
});
/// Find the variable with the same `id` as `old_var` in the env and update its
/// mutable fields to match `new_var`.  Since `Variable` is an `object` (RC
/// reference), mutation is in-place and all references in the env see the change.
///
/// Mirrors `updateExistingVariable` from `src/env.ts`.
update_existing_variable :: (fn(env : Environment, old_var : Variable, new_var : Variable) -> unit)({
  n := env.frames.len();
  (i : usize) = n;
  while(i > usize(0), {
    i = (i - usize(1));
    match(
      env.frames.get(i),
      .Some(frame) => {
        vars := frame.variables;
        m := vars.len();
        (j : usize) = m;
        while(j > usize(0), {
          j = (j - usize(1));
          match(
            vars.get(j),
            .Some(v) => {
              if(v.id == old_var.id, {
                v.ty = new_var.ty;
                v.value = new_var.value;
                v.is_compile_time_only = new_var.is_compile_time_only;
                v.is_owning_the_rc_value = new_var.is_owning_the_rc_value;
                v.initialized_at_token = new_var.initialized_at_token;
                v.consumed_at_token = new_var.consumed_at_token;
                v.is_reassignable = new_var.is_reassignable;
              });
            },
            .None => ()
          );
        });
      },
      .None => ()
    );
  });
});
/// Return a dummy placeholder `Variable` for use in unreachable match-arm
/// fallbacks (analogous to `make_err_expr` for `AstExpr`). The body uses
/// `_dummy.module_path` so the result is always a runtime value — the CTFE
/// evaluator cannot inline a constant when any field depends on a runtime
/// argument, preventing codegen from hitting the "unhandled comptime RC
/// object" path.
make_err_variable :: (fn(_dummy : Environment) -> Variable)(
  Variable(
    id : String.from("__err__"),
    name : String.from("__err__"),
    ty : TypeValue.Unit,
    is_compile_time_only : false,
    frame_level : usize(0),
    value : Option(EvalValue).None,
    is_owning_the_rc_value : false,
    is_owning_the_same_rc_value_as : Option(Box(Variable)).None,
    is_reassignable : false,
    token : Token(
      kind : TokenKind.Identifier,
      value : String.from("__err__"),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : _dummy.module_path,
      input : String.from("")
    ),
    initialized_at_token : Option(Token).None,
    consumed_at_token : Option(Box(Token)).None,
    is_implicit : false,
    is_created_from_destructuring_atom_variable : false,
    parameter_alias : Option(String).None,
    is_from_effect_spread : false,
    is_effect_param : false,
    is_module_level : false,
    doc_comment : Option(String).None,
    is_ref : false,
    is_parameter : false
  )
);
/// Add a variable to the **nearest begin-block frame**, searching from the
/// innermost frame outward.  Falls back to the innermost frame when no
/// begin-block frame is found.
///
/// Mirrors `addVariableToEnv` with `addToBeginBlockFrame: true` in `src/env.ts`.
add_variable_to_begin_block_frame :: (
  fn(
    env : Environment,
    name : String,
    ty : TypeValue,
    value : Option(EvalValue),
    is_compile_time_only : bool,
    is_owning_the_rc_value : bool,
    token : Token
  ) -> Option(Variable)
)({
  n := env.frames.len();
  if(n == usize(0), {
    return(Option(Variable).None);
  });
  // Find the nearest begin-block frame (innermost first).
  (found_idx : usize) = (n - usize(1));
  (fi : usize) = n;
  while(fi > usize(0), {
    fi = (fi - usize(1));
    match(
      env.frames.get(fi),
      .Some(f) => {
        if(f.is_begin_block, {
          found_idx = fi;
          fi = usize(0); // break
        });
      },
      .None => ()
    );
  });
  var := Variable(
    id : generate_variable_id(env.module_path, name),
    name : name,
    ty : ty,
    is_compile_time_only : is_compile_time_only,
    frame_level : found_idx,
    value : value,
    is_owning_the_rc_value : is_owning_the_rc_value,
    is_owning_the_same_rc_value_as : Option(Box(Variable)).None,
    is_reassignable : true,
    token : token,
    initialized_at_token : Option(Token).Some(token),
    consumed_at_token : Option(Box(Token)).None,
    is_implicit : false,
    is_created_from_destructuring_atom_variable : false,
    parameter_alias : Option(String).None,
    is_from_effect_spread : false,
    is_effect_param : false,
    is_module_level : false,
    doc_comment : Option(String).None,
    is_ref : false,
    is_parameter : false
  );
  match(
    env.frames.get(found_idx),
    .Some(frame) => {
      ___ := frame.variables.push(var);
    },
    .None => ()
  );
  Option(Variable).Some(var)
});
/// Sentinel name used by the production evaluator for the implicit
/// receiver binding inside `impl` and `trait` method bodies. Mirrors
/// the TS `export const YoSelf = "__yo_self";`.
YO_SELF :: "__yo_self";
/// Module-level slot holding the cached "prelude" environment — the one
/// built once when the standard prelude is loaded, then reused as the
/// starting env for every compiled module. `None` until
/// `set_env_containing_prelude` is called.
///
/// Mirrors the file-scope `let _envContainingPrelude` in `src/env.ts`.
(_env_containing_prelude : Option(Environment)) = Option(Environment).None;
/// Cache the prelude env. Called once by the driver after the prelude
/// module has been evaluated. Mirrors `setEnvContainingPrelude`.
set_env_containing_prelude :: (fn(env : Environment) -> unit)({
  _env_containing_prelude = Option(Environment).Some(env);
});
/// Forget the cached prelude env (used by tests that swap preludes).
/// Mirrors `clearEnvContainingPrelude`.
clear_env_containing_prelude :: (fn() -> unit)({
  _env_containing_prelude = Option(Environment).None;
});
/// Return the cached prelude env, or panic if it hasn't been set yet.
/// Mirrors `createEnvContainingPrelude` — the TS variant throws, so we
/// `panic` here for the same hard-fail behavior.
create_env_containing_prelude :: (fn() -> Environment)(
  match(
    _env_containing_prelude,
    .Some(e) => e,
    .None => panic("Environment containing prelude is not set.")
  )
);
/// Walk frames from innermost (highest index) to outermost and return
/// the index of the first frame whose `is_begin_block` is true.
///
/// Mirrors `findNearestBeginBlockFrameLevel` in `src/env.ts`, but
/// returns `Option(usize)` instead of `-1` because Yo doesn't use
/// negative sentinels for indices.
find_nearest_begin_block_frame_level :: (fn(env : Environment) -> Option(usize))({
  n := env.frames.len();
  cond(
    (n == usize(0)) => Option(usize).None,
    true => {
      (result : Option(usize)) = Option(usize).None;
      (i : usize) = (n - usize(1));
      while(result.is_none() && (i < n), {
        match(
          env.frames.get(i),
          .Some(frame) => {
            if(frame.is_begin_block, {
              result = Option(usize).Some(i);
            });
          },
          .None => ()
        );
        cond(
          (i == usize(0)) => {
            i = n;
          },
          true => {
            i = (i - usize(1));
          }
        );
      });
      result
    }
  )
});
/// Return `true` iff the **innermost** (top) frame contains a variable
/// named `name`. Used by binding-introduction code to detect shadowing
/// within the same scope.
///
/// Mirrors `variableExistsInEnvTopFrame` in `src/env.ts`.
variable_exists_in_env_top_frame :: (fn(env : Environment, name : String) -> bool)({
  n := env.frames.len();
  cond(
    (n == usize(0)) => false,
    true => {
      (found : bool) = false;
      match(
        env.frames.get(n - usize(1)),
        .Some(top_frame) => {
          m := top_frame.variables.len();
          (j : usize) = usize(0);
          while((j < m) && !(found), {
            match(
              top_frame.variables.get(j),
              .Some(v) => {
                if(v.name == name, {
                  found = true;
                });
              },
              .None => ()
            );
            j = (j + usize(1));
          });
        },
        .None => ()
      );
      found
    }
  )
});
/// Render a single `Variable` as a human-readable summary, mirroring
/// the object literal produced by `getVariableInfo` in `src/env.ts`.
/// Used by `print_env_var_names` / `print_env_frame` to dump the env
/// during evaluator debugging.
///
/// NOTE: This slim form omits the type/value rendering present in the
/// TS variant. Calling `type_to_string(v.ty)` and `value_to_string(...)`
/// from inside the template-string interpolations below triggers a 10x
/// compile-time regression in the TS reference evaluator
/// (issues/ts-evaluator-slow-compile-of-nested-tostring-calls.md). The
/// expanded form is preserved in that issue and should be restored once
/// the evaluator bug is fixed.
get_variable_info :: (fn(v : Variable) -> String)({
  is_undefined := v.initialized_at_token.is_none();
  is_consumed := v.consumed_at_token.is_some();
  owning_alias := match(
    v.is_owning_the_same_rc_value_as,
    .Some(boxed) => boxed.*.name,
    .None => String.from("<none>")
  );
  `{id: ${v.id}, name: ${v.name}, isCompileTimeOnly: ${v.is_compile_time_only.to_string()}, isUndefined: ${is_undefined.to_string()}, isOwningTheRcValue: ${v.is_owning_the_rc_value.to_string()}, isOwningTheSameRcValueAs: ${owning_alias}, isReassignable: ${v.is_reassignable.to_string()}, isConsumed: ${is_consumed.to_string()}}`
});
/// Dump every variable in every frame of `env` to stdout, one per line,
/// prefixed by the frame index. Mirrors `printEnvVarNames`.
print_env_var_names :: (fn(env : Environment) -> unit)({
  n := env.frames.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      env.frames.get(i),
      .Some(frame) => {
        println(`-- frame ${i.to_string()} (is_begin_block=${frame.is_begin_block.to_string()}) --`);
        m := frame.variables.len();
        (j : usize) = usize(0);
        while(j < m, {
          match(
            frame.variables.get(j),
            .Some(v) => {
              println(get_variable_info(v));
            },
            .None => ()
          );
          j = (j + usize(1));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// Dump every variable in a single `Frame` to stdout, one per line.
/// Mirrors `printEnvFrame`.
print_env_frame :: (fn(frame : Frame) -> unit)({
  m := frame.variables.len();
  (j : usize) = usize(0);
  while(j < m, {
    match(
      frame.variables.get(j),
      .Some(v) => {
        println(get_variable_info(v));
      },
      .None => ()
    );
    j = (j + usize(1));
  });
});
/// Return every variable across all frames (outermost → innermost) for
/// which `predicate(variable)` is `true`. Mirrors
/// `getVariablesFromEnvByFilter` in `src/env.ts`. Heavily used by the
/// calls/helper evaluator to find `given(...)` evidence for `...`
/// parameters.
get_variables_from_env_by_filter :: (
  fn(env : Environment, predicate : Impl(Fn(v : Variable) -> bool)) -> ArrayList(Variable)
)({
  result := ArrayList(Variable).new();
  n := env.frames.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      env.frames.get(i),
      .Some(frame) => {
        m := frame.variables.len();
        (j : usize) = usize(0);
        while(j < m, {
          match(
            frame.variables.get(j),
            .Some(v) => {
              if(predicate(v), {
                ___ := result.push(v);
              });
            },
            .None => ()
          );
          j = (j + usize(1));
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  result
});
/// Walk frames from innermost to outermost and return the index of the
/// first frame containing at least one variable matching `predicate`.
/// Returns `.None` when no frame matches; mirrors
/// `findInnermostFrameWithGivenVariable` but returns `Option(usize)`
/// instead of `-1`.
find_innermost_frame_with_given_variable :: (
  fn(env : Environment, predicate : Impl(Fn(v : Variable) -> bool)) -> Option(usize)
)({
  n := env.frames.len();
  cond(
    (n == usize(0)) => Option(usize).None,
    true => {
      (result : Option(usize)) = Option(usize).None;
      (i : usize) = (n - usize(1));
      while(result.is_none() && (i < n), {
        match(
          env.frames.get(i),
          .Some(frame) => {
            m := frame.variables.len();
            (j : usize) = usize(0);
            (found_here : bool) = false;
            while((j < m) && !(found_here), {
              match(
                frame.variables.get(j),
                .Some(v) => {
                  if(predicate(v), {
                    found_here = true;
                  });
                },
                .None => ()
              );
              j = (j + usize(1));
            });
            if(found_here, {
              result = Option(usize).Some(i);
            });
          },
          .None => ()
        );
        cond(
          (i == usize(0)) => {
            i = n;
          },
          true => {
            i = (i - usize(1));
          }
        );
      });
      result
    }
  )
});
/// Return a fresh `Environment` whose frames contain the same variables
/// as `env` except those flagged `is_implicit`. Used when the evaluator
/// must hide `given(...)` evidence (e.g. when evaluating a default
/// argument expression where `...` evidence shouldn't leak).
///
/// Mirrors `stripImplicitVariablesFromEnv` in `src/env.ts`.
strip_implicit_variables_from_env :: (fn(env : Environment) -> Environment)({
  new_frames := ArrayList(Frame).new();
  n := env.frames.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      env.frames.get(i),
      .Some(frame) => {
        new_vars := ArrayList(Variable).new();
        m := frame.variables.len();
        (j : usize) = usize(0);
        while(j < m, {
          match(
            frame.variables.get(j),
            .Some(v) => {
              if(!(v.is_implicit), {
                ___ := new_vars.push(v);
              });
            },
            .None => ()
          );
          j = (j + usize(1));
        });
        ___ := new_frames.push(
          Frame(
            id : frame.id.clone(),
            variables : new_vars,
            is_begin_block : frame.is_begin_block,
            where_clause_constraints : frame.where_clause_constraints
          )
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  Environment(
    frames : new_frames,
    module_path : env.module_path.clone(),
    function_declaration_frame_level : env.function_declaration_frame_level,
    input_string : env.input_string.clone()
  )
});
/// Return a fresh `Environment` that preserves the top-level (index 0)
/// frame as-is, and from every other frame keeps only variables that are
/// `is_compile_time_only` and not `is_implicit`. Used by the evaluator
/// when transitioning into a function whose body must see comptime
/// bindings but not runtime locals or `given(...)` evidence.
///
/// Mirrors `keepTopLevelFrameAndComptimeVariablesFromEnv` in `src/env.ts`.
keep_top_level_frame_and_comptime_variables_from_env :: (fn(env : Environment) -> Environment)({
  new_frames := ArrayList(Frame).new();
  n := env.frames.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      env.frames.get(i),
      .Some(frame) => {
        cond(
          (i == usize(0)) => {
            // Keep frame 0 as-is (shares the variable list with the original).
            ___ := new_frames.push(frame);
          },
          true => {
            new_vars := ArrayList(Variable).new();
            m := frame.variables.len();
            (j : usize) = usize(0);
            while(j < m, {
              match(
                frame.variables.get(j),
                .Some(v) => {
                  if(v.is_compile_time_only && !(v.is_implicit), {
                    ___ := new_vars.push(v);
                  });
                },
                .None => ()
              );
              j = (j + usize(1));
            });
            ___ := new_frames.push(
              Frame(
                id : frame.id.clone(),
                variables : new_vars,
                is_begin_block : frame.is_begin_block,
                where_clause_constraints : frame.where_clause_constraints
              )
            );
          }
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  Environment(
    frames : new_frames,
    module_path : env.module_path.clone(),
    function_declaration_frame_level : env.function_declaration_frame_level,
    input_string : env.input_string.clone()
  )
});
/// Create an independent shallow clone of an Environment.
///
/// Each frame gets a fresh ArrayList(Variable) that shares the same Variable
/// RC objects as the original. This means existing variables are shared
/// (mutations to a Variable propagate), but new variables added to a cloned
/// frame do NOT affect the original. Used by `evaluate_ctl_function_body_inline`
/// Shallow snapshot: a fresh `Environment` whose `frames` is a NEW `ArrayList`
/// holding the SAME `Frame` references. The frames LIST is independent of the
/// source env's list, so later in-place `push_frame`/`pop_frame` on the source
/// (which mutate `self.frames`) do NOT alter this snapshot's frame set — while
/// the shared `Frame` objects keep their bindings visible. Used by
/// `new_expr_info` so a recorded `ExprInfo.env` reflects the scope in force when
/// the expression was evaluated and is immune to a later `pop_frame` (e.g. a
/// begin block popping its scope frame). Much cheaper than `clone_env` (no
/// per-frame variable-list copy). See issues/fixed/yo-self-recorded-env-aliasing.md.
snapshot_env :: (fn(env : Environment) -> Environment)({
  fr := ArrayList(Frame).new();
  (i : usize) = usize(0);
  n := env.frames.len();
  while(i < n, {
    match(
      env.frames.get(i),
      .Some(f) => {
        ___ := fr.push(f);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  Environment(
    frames : fr,
    module_path : env.module_path,
    function_declaration_frame_level : env.function_declaration_frame_level,
    input_string : env.input_string
  )
});
/// to build a specialized env without contaminating the caller's env.
///
/// Mirrors `pushEnvFrame` semantics: the clone has the same frame stack depth,
/// so callers should push an extra frame after cloning if needed.
///
/// Mirrors the shallow-copy used by `pushEnvFrame` in `src/env.ts`.
clone_env :: (fn(env : Environment) -> Environment)({
  cloned_frames := ArrayList(Frame).new();
  n := env.frames.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      env.frames.get(i),
      .Some(orig_frame) => {
        new_vars := ArrayList(Variable).new();
        m := orig_frame.variables.len();
        (j : usize) = usize(0);
        while(j < m, {
          match(
            orig_frame.variables.get(j),
            .Some(v) => {
              ___ := new_vars.push(v);
            },
            .None => ()
          );
          j = (j + usize(1));
        });
        cloned_frames.push(
          Frame(
            id : orig_frame.id.clone(),
            variables : new_vars,
            is_begin_block : orig_frame.is_begin_block,
            where_clause_constraints : orig_frame.where_clause_constraints
          )
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  Environment(
    frames : cloned_frames,
    module_path : env.module_path.clone(),
    function_declaration_frame_level : env.function_declaration_frame_level,
    input_string : env.input_string.clone()
  )
});
/// Deep-clone a single `WhereClauseConstraints` entry: a fresh
/// `some_type` reference plus fresh trait-list arrays sharing the
/// same `TypeValue` references inside. Mirrors the inline
/// `{...entry, requiredTraits: [...entry.requiredTraits], …}` shape
/// used by TS `cloneWhereClauseConstraints` in `src/env.ts`.
_clone_where_clause_constraints_entry :: (
  fn(entry : WhereClauseConstraints) -> WhereClauseConstraints
)({
  new_required := ArrayList(TypeValue).new();
  rm := entry.required_traits.len();
  (ri : usize) = usize(0);
  while(ri < rm, {
    match(
      entry.required_traits.get(ri),
      .Some(t) => {
        ___ := new_required.push(t);
      },
      .None => ()
    );
    ri = (ri + usize(1));
  });
  new_negative := ArrayList(TypeValue).new();
  nm := entry.negative_traits.len();
  (ni : usize) = usize(0);
  while(ni < nm, {
    match(
      entry.negative_traits.get(ni),
      .Some(t) => {
        ___ := new_negative.push(t);
      },
      .None => ()
    );
    ni = (ni + usize(1));
  });
  WhereClauseConstraints(
    some_type : entry.some_type,
    required_traits : new_required,
    negative_traits : new_negative
  )
});
/// Build a fresh `HashMap(String, WhereClauseConstraints)` whose
/// entries are independent (deep) clones of those in `src`. Mirrors
/// `cloneWhereClauseConstraints` in `src/env.ts`. Used by
/// `clone_env_for_ctfe_check` so that constraints added during a
/// speculative CTFE pass do not leak back into the original frame.
_clone_where_clause_constraints :: (
  fn(src : HashMap(String, WhereClauseConstraints)) -> HashMap(String, WhereClauseConstraints)
)({
  dst := HashMap(String, WhereClauseConstraints).new();
  it := src.into_iter();
  (running : bool) = true;
  while(running, {
    match(
      it.next(),
      .None => {
        running = false;
      },
      .Some(bucket) => {
        ___ := dst.set(bucket.key, _clone_where_clause_constraints_entry(bucket.value));
      }
    );
  });
  dst
});
/// Deep-enough clone of an `Environment` for use during the CTFE-check
/// phase of overload resolution. Mirrors `cloneEnvForCTFECheck` in
/// `src/env.ts`.
///
/// Differences from the plain `clone_env`:
///   - Each frame gets its OWN fresh
///     `where_clause_constraints : HashMap(...)` so a probe that
///     records a temporary constraint cannot leak the binding back
///     into the caller's frame after the probe is discarded.
///   - Each `Variable` is reconstructed as a fresh RC with all
///     fields copied, and its `.value` is deep-cloned via
///     `clone_value(ev, preserve_pointer_refs = false)`. Mirrors
///     TS `cloneEnvForCTFECheck`'s `cloneVariable` step, including
///     the explicit "do not preserve pointer references during
///     CTFE check" choice (src/env.ts:306).
///
/// Difference from the TS variant:
///   - TS threads a `targetValueMapping : Map<[Value], [Value]>`
///     through `cloneValue` to ensure pointers that share a target
///     after cloning still point to the same cloned cell. yo-self's
///     `clone_value` doesn't yet plumb that mapping — pointer
///     aliasing across the cloned env is best-effort. When the
///     proper-evaluator's CTFE-overload-resolution path needs
///     it, `clone_value` grows the mapping arg and this site
///     calls it.
clone_env_for_ctfe_check :: (fn(env : Environment) -> Environment)({
  cloned_frames := ArrayList(Frame).new();
  n := env.frames.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      env.frames.get(i),
      .Some(orig_frame) => {
        new_vars := ArrayList(Variable).new();
        m := orig_frame.variables.len();
        (j : usize) = usize(0);
        while(j < m, {
          match(
            orig_frame.variables.get(j),
            .Some(v) => {
              // Build a fresh `Variable` whose mutable fields are
              // independent of the original, and whose `.value` is
              // a `clone_value`-deep-cloned EvalValue. Mirrors TS
              // `cloneEnvForCTFECheck`'s
              // `cloneVariable`: `{ ...variable, value: clonedValueArray }`.
              // `preserve_pointer_refs = false` matches TS's
              // "do not preserve pointer references during CTFE
              // check" comment (src/env.ts:306).
              cloned_val := match(
                v.value,
                .Some(ev) => Option(EvalValue).Some(clone_value(ev, false)),
                .None => Option(EvalValue).None
              );
              fresh := Variable(
                id : v.id.clone(),
                name : v.name.clone(),
                ty : v.ty,
                is_compile_time_only : v.is_compile_time_only,
                frame_level : v.frame_level,
                value : cloned_val,
                is_owning_the_rc_value : v.is_owning_the_rc_value,
                is_owning_the_same_rc_value_as : v.is_owning_the_same_rc_value_as,
                is_reassignable : v.is_reassignable,
                token : v.token,
                initialized_at_token : v.initialized_at_token,
                consumed_at_token : v.consumed_at_token,
                is_implicit : v.is_implicit,
                is_created_from_destructuring_atom_variable : v.is_created_from_destructuring_atom_variable,
                parameter_alias : v.parameter_alias,
                is_from_effect_spread : v.is_from_effect_spread,
                is_effect_param : v.is_effect_param,
                is_module_level : v.is_module_level,
                doc_comment : v.doc_comment,
                is_ref : false,
                is_parameter : false
              );
              ___ := new_vars.push(fresh);
            },
            .None => ()
          );
          j = (j + usize(1));
        });
        cloned_frames.push(
          Frame(
            id : orig_frame.id.clone(),
            variables : new_vars,
            is_begin_block : orig_frame.is_begin_block,
            where_clause_constraints : _clone_where_clause_constraints(orig_frame.where_clause_constraints)
          )
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  Environment(
    frames : cloned_frames,
    module_path : env.module_path.clone(),
    function_declaration_frame_level : env.function_declaration_frame_level,
    input_string : env.input_string.clone()
  )
});
/// Extract the `id` field of a `SomeT(...)` TypeValue. Returns the
/// empty string for any other variant — TS callers rely on `.id` being
/// non-undefined, but in Yo we surface failures by yielding "" instead.
_some_type_id :: (fn(t : TypeValue) -> String)(
  match(
    t,
    .SomeT(id, _, _, _, _, _, _, _, _, _) => id,
    _ => String.from("")
  )
);
/// Extract the `name` field of a `SomeT(...)` TypeValue. Returns the
/// empty string for any other variant.
_some_type_name :: (fn(t : TypeValue) -> String)(
  match(
    t,
    .SomeT(_, name, _, _, _, _, _, _, _, _) => name,
    _ => String.from("")
  )
);
/// Extract the `id` field of a `TraitT(...)` TypeValue. Returns the
/// empty string for any other variant.
_trait_type_id :: (fn(t : TypeValue) -> String)(
  match(
    t,
    .TraitT(_, _, _, _, id, _, _, _) => id,
    _ => String.from("")
  )
);
/// Append every trait in `src` to `dst` unless `dst` already contains a
/// trait with the same id. Used by `get_where_clause_constraints_for_*`
/// to deduplicate merged constraints from multiple frames.
_merge_trait_list :: (fn(dst : ArrayList(TypeValue), src : ArrayList(TypeValue)) -> unit)({
  sm := src.len();
  (si : usize) = usize(0);
  while(si < sm, {
    match(
      src.get(si),
      .Some(trait) => {
        tid := _trait_type_id(trait);
        dm := dst.len();
        (di : usize) = usize(0);
        (already : bool) = false;
        while((di < dm) && !(already), {
          match(
            dst.get(di),
            .Some(existing) => {
              if(_trait_type_id(existing) == tid, {
                already = true;
              });
            },
            .None => ()
          );
          di = (di + usize(1));
        });
        if(!(already), {
          ___ := dst.push(trait);
        });
      },
      .None => ()
    );
    si = (si + usize(1));
  });
});
/// Record a where-clause constraint `someType <: traitType` (or its
/// negation when `is_negated` is true) in the innermost frame. Mirrors
/// `addWhereClauseConstraintToEnv` in `src/env.ts`. Constraints are
/// deduplicated by trait id within each list.
add_where_clause_constraint_to_env :: (
  fn(
    env : Environment,
    some_type : TypeValue,
    trait_type : TypeValue,
    is_negated : bool
  ) -> unit
)({
  n := env.frames.len();
  if(n == usize(0), {
    return(());
  });
  key := _some_type_id(some_type);
  trait_id := _trait_type_id(trait_type);
  match(
    env.frames.get(n - usize(1)),
    .None => (),
    .Some(target_frame) => {
      entry := match(
        target_frame.where_clause_constraints.get(key),
        .Some(existing) => existing,
        .None => {
          fresh := WhereClauseConstraints(
            some_type : some_type,
            required_traits : ArrayList(TypeValue).new(),
            negative_traits : ArrayList(TypeValue).new()
          );
          ___ := target_frame.where_clause_constraints.set(key, fresh);
          fresh
        }
      );
      target_list := if(is_negated, entry.negative_traits, entry.required_traits);
      m := target_list.len();
      (already : bool) = false;
      (k : usize) = usize(0);
      while((k < m) && !(already), {
        match(
          target_list.get(k),
          .Some(existing_trait) => {
            if(_trait_type_id(existing_trait) == trait_id, {
              already = true;
            });
          },
          .None => ()
        );
        k = (k + usize(1));
      });
      if(!(already), {
        ___ := target_list.push(trait_type);
      });
    }
  );
});
/// Look up every where-clause constraint applicable to `some_type` in
/// `env`, walking all frames (outermost → innermost). Returns `.None`
/// when no constraint matches. Mirrors
/// `getWhereClauseConstraintsForSomeType` in `src/env.ts`, including
/// the alias-name fallback so that constraints attached under one
/// name (e.g. `_Self`) still apply to a parameter bound to that
/// SomeType under a different name (e.g. `Output`).
///
/// The returned value is itself a `WhereClauseConstraints` whose
/// `some_type` field is the queried `some_type`; trait lists are fresh
/// ArrayLists holding the merged, deduplicated constraints.
get_where_clause_constraints_for_some_type :: (
  fn(env : Environment, some_type : TypeValue) -> Option(WhereClauseConstraints)
)({
  some_id := _some_type_id(some_type);
  required_traits := ArrayList(TypeValue).new();
  negative_traits := ArrayList(TypeValue).new();
  alias_names := ArrayList(String).new();
  (found : bool) = false;
  // First pass: collect alias-name set for variables whose value is a
  // TypeVal wrapping a SomeT with the same id.
  fn := env.frames.len();
  (fi : usize) = usize(0);
  while(fi < fn, {
    match(
      env.frames.get(fi),
      .None => (),
      .Some(frame) => {
        vm := frame.variables.len();
        (vi : usize) = usize(0);
        while(vi < vm, {
          match(
            frame.variables.get(vi),
            .Some(var) => {
              match(
                var.value,
                .Some(eval_val) => {
                  match(
                    eval_val,
                    .TypeVal(boxed_ty) => {
                      inner_ty := boxed_ty.*;
                      if(is_some_type(inner_ty) && (_some_type_id(inner_ty) == some_id), {
                        ___ := alias_names.push(var.name.clone());
                      });
                    },
                    _ => ()
                  );
                },
                .None => ()
              );
            },
            .None => ()
          );
          vi = (vi + usize(1));
        });
      }
    );
    fi = (fi + usize(1));
  });
  // Second pass: collect matching constraint entries.
  (fj : usize) = usize(0);
  while(fj < fn, {
    match(
      env.frames.get(fj),
      .None => (),
      .Some(frame) => {
        vals_iter := frame.where_clause_constraints.values();
        (running : bool) = true;
        while(running, {
          match(
            vals_iter.next(),
            .None => {
              running = false;
            },
            .Some(entry) => {
              entry_id := _some_type_id(entry.some_type);
              entry_name := _some_type_name(entry.some_type);
              matches_id := (entry_id == some_id);
              matches_alias := cond(
                matches_id => false,
                true => {
                  am := alias_names.len();
                  (ai : usize) = usize(0);
                  (hit : bool) = false;
                  while((ai < am) && !(hit), {
                    match(
                      alias_names.get(ai),
                      .Some(an) => {
                        if(an == entry_name, {
                          hit = true;
                        });
                      },
                      .None => ()
                    );
                    ai = (ai + usize(1));
                  });
                  hit
                }
              );
              if(matches_id || matches_alias, {
                found = true;
                _merge_trait_list(required_traits, entry.required_traits);
                _merge_trait_list(negative_traits, entry.negative_traits);
              });
            }
          );
        });
      }
    );
    fj = (fj + usize(1));
  });
  cond(
    found => Option(WhereClauseConstraints).Some(
      WhereClauseConstraints(
        some_type : some_type,
        required_traits : required_traits,
        negative_traits : negative_traits
      )
    ),
    true => Option(WhereClauseConstraints).None
  )
});
/// Build the structural HashMap key for a `TypeApplication` constraint.
/// Mirrors `typeApplicationConstraintKey` in `src/env.ts`: the key
/// encodes `constructor.id` followed by every arg id, so two
/// applications with the same constructor and arg ids share an entry.
_type_application_constraint_key :: (fn(type_app : TypeValue) -> String)(
  match(
    type_app,
    .TypeAppT(constructor, args) => {
      ctor_id := _some_type_id(constructor.*);
      arg_keys := String.from("");
      m := args.len();
      (i : usize) = usize(0);
      while(i < m, {
        match(
          args.get(i),
          .Some(arg) => {
            // Each arg's id: prefer SomeT.id, otherwise type_to_string for stability.
            piece := cond(
              is_some_type(arg) => _some_type_id(arg),
              true => type_to_string(arg)
            );
            if(i > usize(0), {
              arg_keys.push_str(",");
            });
            arg_keys.push_string(piece);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      `typeapp:${ctor_id}:${arg_keys}`
    },
    _ => String.from("")
  )
);
/// Record a where-clause constraint for a `TypeApplication` such as
/// `F(A) <: Functor(F)`. Mirrors
/// `addWhereClauseConstraintForTypeApplication` in `src/env.ts`. The
/// entry's `some_type` field stores the application's constructor
/// SomeType for backward compatibility with `someType`-keyed
/// constraint lookups.
add_where_clause_constraint_for_type_application :: (
  fn(
    env : Environment,
    type_app : TypeValue,
    trait_type : TypeValue,
    is_negated : bool
  ) -> unit
)({
  n := env.frames.len();
  if(n == usize(0), {
    return(());
  });
  key := _type_application_constraint_key(type_app);
  trait_id := _trait_type_id(trait_type);
  ctor := match(
    type_app,
    .TypeAppT(constructor, _) => constructor.*,
    _ => type_app
  );
  match(
    env.frames.get(n - usize(1)),
    .None => (),
    .Some(target_frame) => {
      entry := match(
        target_frame.where_clause_constraints.get(key),
        .Some(existing) => existing,
        .None => {
          fresh := WhereClauseConstraints(
            some_type : ctor,
            required_traits : ArrayList(TypeValue).new(),
            negative_traits : ArrayList(TypeValue).new()
          );
          ___ := target_frame.where_clause_constraints.set(key, fresh);
          fresh
        }
      );
      target_list := if(is_negated, entry.negative_traits, entry.required_traits);
      m := target_list.len();
      (already : bool) = false;
      (k : usize) = usize(0);
      while((k < m) && !(already), {
        match(
          target_list.get(k),
          .Some(existing_trait) => {
            if(_trait_type_id(existing_trait) == trait_id, {
              already = true;
            });
          },
          .None => ()
        );
        k = (k + usize(1));
      });
      if(!(already), {
        ___ := target_list.push(trait_type);
      });
    }
  );
});
/// Look up every where-clause constraint applicable to `type_app` in
/// `env`. Matches by structural key (constructor id + arg ids). Returns
/// `.None` when no frame contains a matching entry. Mirrors
/// `getWhereClauseConstraintsForTypeApplication` in `src/env.ts`.
get_where_clause_constraints_for_type_application :: (
  fn(env : Environment, type_app : TypeValue) -> Option(WhereClauseConstraints)
)({
  key := _type_application_constraint_key(type_app);
  required_traits := ArrayList(TypeValue).new();
  negative_traits := ArrayList(TypeValue).new();
  (found : bool) = false;
  (ctor : TypeValue) = match(
    type_app,
    .TypeAppT(constructor, _) => constructor.*,
    _ => type_app
  );
  n := env.frames.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      env.frames.get(i),
      .None => (),
      .Some(frame) => {
        match(
          frame.where_clause_constraints.get(key),
          .None => (),
          .Some(entry) => {
            found = true;
            _merge_trait_list(required_traits, entry.required_traits);
            _merge_trait_list(negative_traits, entry.negative_traits);
          }
        );
      }
    );
    i = (i + usize(1));
  });
  cond(
    found => Option(WhereClauseConstraints).Some(
      WhereClauseConstraints(
        some_type : ctor,
        required_traits : required_traits,
        negative_traits : negative_traits
      )
    ),
    true => Option(WhereClauseConstraints).None
  )
});
/// Construct a fresh `Environment` with no frames. Mirrors
/// `createNewEnv` in `src/env.ts`. Callers that want an environment
/// ready to receive bindings should use `create_empty_env` (which
/// pushes a single top-level frame) or `Environment.new` (also pushes
/// a top-level frame, but is parameterised by module path only).
create_new_env :: (fn(module_path : String, input_string : String) -> Environment)(
  Environment(
    frames : ArrayList(Frame).new(),
    module_path : module_path,
    function_declaration_frame_level : Option(usize).None,
    input_string : input_string
  )
);
/// Construct an `Environment` with empty module/input paths and a
/// single top-level frame. Mirrors `createEmptyEnv` in `src/env.ts`,
/// used by tests / sub-evaluators that just need a working env.
create_empty_env :: (fn() -> Environment)({
  env := create_new_env(String.from(""), String.from(""));
  ___ := env.frames.push(new_frame(false));
  env
});
/// Push a fresh (or supplied) frame onto `env` and return its 0-based
/// index. Mirrors `pushEnvFrame` in `src/env.ts`. The TS variant
/// returns a new env; yo-self mutates in place.
push_env_frame :: (fn(env : Environment, is_begin_block : bool) -> usize)({
  env.frames.push(new_frame(is_begin_block));
  env.frames.len() - usize(1)
});
/// Pop the innermost frame from `env`. Mirrors `popEnvFrame` in
/// `src/env.ts` without the unconsumed/uninitialized variable checks
/// — those will be wired up when the TS pop's pre-pop validation
/// fully lands (it now has the prerequisite
/// `get_variables_needing_drop` below).
pop_env_frame :: (fn(env : Environment) -> unit)(
  cond(
    (env.frames.len() > usize(0)) => {
      ___ := env.frames.pop();
      ()
    },
    true => ()
  )
);
/// Add a `Variable` to a specific `Frame`, returning the frame index
/// it lives in. Mirrors `addVariableToFrame` in `src/env.ts`.
///
/// The function:
///   - skips `"_"` names (TS does the same: `_` is a "don't care"
///     placeholder),
///   - panics on duplicate non-`_` names within the same frame
///     (TS throws a `Failed to define variable` error),
///   - replaces a same-named *uninitialised* variable if one exists
///     (matches the TS `existingUndefinedVariableIndex` path).
///
/// Returns the frame index in the env that hosts this frame, or
/// `Option(usize).None` when the frame is not part of `env`.
add_variable_to_frame :: (
  fn(env : Environment, frame : Frame, variable : Variable) -> Option(usize)
)({
  if(variable.name == String.from("_"), {
    return(Option(usize).None);
  });
  // Locate the frame in env by identity (matching `id` string).
  n := env.frames.len();
  (target_idx : Option(usize)) = Option(usize).None;
  (i : usize) = usize(0);
  while((i < n) && target_idx.is_none(), {
    match(
      env.frames.get(i),
      .Some(f) => {
        if(f.id == frame.id, {
          target_idx = Option(usize).Some(i);
        });
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  match(
    target_idx,
    .None => Option(usize).None,
    .Some(idx) => {
      // Look for duplicate / uninitialised existing variable.
      m := frame.variables.len();
      (j : usize) = usize(0);
      (replaced : bool) = false;
      (duplicate : bool) = false;
      while(((j < m) && !(duplicate)) && !(replaced), {
        match(
          frame.variables.get(j),
          .Some(existing) => cond(
            (existing.name == variable.name) => cond(
              existing.initialized_at_token.is_none() => {
                // Replace the uninitialised binding in place.
                frame.variables(j) = variable;
                replaced = true;
              },
              true => {
                duplicate = true;
              }
            ),
            true => ()
          ),
          .None => ()
        );
        j = (j + usize(1));
      });
      cond(
        duplicate => panic("Failed to define variable: already defined in the same scope"),
        replaced => Option(usize).Some(idx),
        true => {
          ___ := frame.variables.push(variable);
          Option(usize).Some(idx)
        }
      )
    }
  )
});
/// Return the variables in the innermost frame that still need to be
/// dropped (consumed) before the frame is popped. Mirrors
/// `getVariablesNeedingDrop` in `src/env.ts`. Returns variables in
/// REVERSE insertion order so the caller can `___drop` them
/// last-in / first-out (LIFO).
///
/// A variable qualifies when ALL of the following hold:
///   - not yet consumed (`consumed_at_token.is_none()`),
///   - owns an RC value (`is_owning_the_rc_value`),
///   - its type transitively contains an RC type
///     (`type_contains_rc_type`),
///   - is not a module-level binding (those are C file-scope statics
///     and live for the program's lifetime),
///   - is not a bare unresolved `SomeT(...)` with no required-trait
///     constraints (we can't generate concrete drop code for an
///     abstract type parameter; bounded SomeTypes — e.g.
///     `Impl(Future(T))` — DO need to be dropped, hence the
///     required-traits exception).
///
/// Divergence from TS: yo-self's `SomeT` variant does not carry a
/// `resolvedConcreteType` field (TS uses it as the "fast path" when
/// the parameter has already been bound to a concrete type). The
/// equivalent fast path is to check `required_trait_types.len() > 0`,
/// which keeps `Impl(Future(T))`-style values eligible. SomeTypes
/// that have a concrete binding flow through the env via
/// `getValueOfSomeTypeFromEnv` at the caller level rather than via
/// an embedded field.
get_variables_needing_drop :: (fn(env : Environment) -> ArrayList(Variable))({
  result := ArrayList(Variable).new();
  n := env.frames.len();
  if(n == usize(0), {
    return(result);
  });
  match(
    env.frames.get(n - usize(1)),
    .None => (),
    .Some(top_frame) => {
      m := top_frame.variables.len();
      // Walk forwards to collect, then reverse afterwards to get the
      // LIFO drop order the codegen wants.
      collected := ArrayList(Variable).new();
      (i : usize) = usize(0);
      while(i < m, {
        match(
          top_frame.variables.get(i),
          .None => (),
          .Some(v) => {
            // Cheap "needs-drop" predicate.
            // SomeT with no required-trait constraints can't be
            // dropped concretely — skip them; bounded SomeTypes
            // (e.g. Impl(Future(T))) are kept.
            keep_for_some_check := match(
              v.ty,
              .SomeT(
                id : _,
                name : _,
                frame_level : _,
                parent_type : _,
                required_trait_types : rtt,
                required_trait_levels : _,
                negative_trait_types : _,
                negative_trait_levels : _,
                is_effects_row : _
              ) => cond(
                (rtt.len() == usize(0)) => false,
                true => true
              ),
              _ => true
            );
            qualifies := cond(
              v.consumed_at_token.is_some() => false,
              !(v.is_owning_the_rc_value) => false,
              !(type_contains_rc_type(v.ty)) => false,
              v.is_module_level => false,
              true => keep_for_some_check
            );
            if(qualifies, {
              ___ := collected.push(v);
            });
          }
        );
        i = (i + usize(1));
      });
      // Reverse collected into result (LIFO drop order).
      c := collected.len();
      (k : usize) = c;
      while(k > usize(0), {
        k = (k - usize(1));
        match(
          collected.get(k),
          .Some(v) => {
            ___ := result.push(v);
          },
          .None => ()
        );
      });
    }
  );
  result
});
/// Type of the generic-impl method-finder callback. Mirrors the
/// signature of `find_methods_from_generic_impls` in
/// `evaluator/values/impl.yo` after adapting its `MethodCandidate`
/// results into `MethodEntry`s. The slot is wired up at module
/// init time by `impl.yo` — same callback-injection pattern as
/// `set_type_implements_trait_fn` (impl.yo:104-112), and for the
/// same reason: `impl.yo` already imports `env.yo`, so env.yo
/// cannot import it back without re-creating a module cycle.
FindMethodsFromGenericImplsFn :: (
  fn(env : Environment, method_name : String, ty : TypeValue) -> ArrayList(MethodEntry)
);
/// Module-level slot. Stays `.None` until `impl.yo`'s init block
/// calls `set_find_methods_from_generic_impls_fn` with the adapter
/// wrapper. While unset, `get_type_trait_methods_by_name_from_env`
/// returns registry hits only (which is what the function did
/// before this commit landed).
(_g_find_methods_from_generic_impls_fn : Option(FindMethodsFromGenericImplsFn)) =
  Option(FindMethodsFromGenericImplsFn).None;
/// Install the generic-impl-fallback adapter. Called once from
/// `evaluator/values/impl.yo`'s init block.
set_find_methods_from_generic_impls_fn :: (
  fn(f : FindMethodsFromGenericImplsFn) -> unit
)({
  _g_find_methods_from_generic_impls_fn =
    Option(FindMethodsFromGenericImplsFn).Some(f);
});
/// Look up the trait methods on a TYPE (not on a receiver value)
/// that match `method_name`. Mirrors
/// `getTypeTraitMethodsByNameFromEnv` in `src/env.ts:1070-1152`,
/// used for static method calls on `TypeValue` (e.g.
/// `EvenNumber.try_from(...)`).
///
/// Storage divergence from TS: TS keeps each type's methods on the
/// type's `.trait.fields`; yo-self keeps them in a module-level
/// registry keyed by the type's `id` string
/// (`evaluator/values/type_trait_methods.yo`). The semantics are the
/// same — entries with `label == ""` carry whole impl'd trait
/// values; entries with non-empty `label` are direct trait methods.
///
/// Generic-impl fallback: when no registry hit is found,
/// `evaluator/values/impl.yo:find_methods_from_generic_impls` is
/// consulted via the `_g_find_methods_from_generic_impls_fn`
/// callback slot. The slot is installed by impl.yo's init block;
/// it stays `.None` only at very early bootstrap moments (before
/// impl.yo has been loaded), in which case the fallback is
/// silently skipped — matching the pre-callback behaviour.
get_type_trait_methods_by_name_from_env :: (
  fn(env : Environment, method_name : String, ty : TypeValue) -> ArrayList(MethodEntry)
)({
  id := type_id_or_empty(ty);
  cond(
    (id == String.from("")) => ArrayList(MethodEntry).new(),
    true => {
      result := get_type_trait_methods_by_name(id, method_name);
      // TS: `if (methods.length === 0) methods.push(...generic)`
      // — the generic-impl fallback only kicks in when no direct
      // method was found.
      cond(
        (result.len() > usize(0)) => result,
        true => match(
          _g_find_methods_from_generic_impls_fn,
          .None => result,
          .Some(f) => f(env, method_name, ty)
        )
      )
    }
  )
});
/// Look up the prelude `str` type in `env`. Inlined from
/// `types/env_lookup.yo:create_str_type` to avoid importing
/// env_lookup.yo (which itself imports env.yo). Returns
/// `t_i32()` as a benign fallback when `str` is not bound — same
/// behaviour as the env_lookup version. Used only by the
/// comptime-receiver retry path of
/// `get_receiver_methods_by_name_from_env`.
_resolve_str_type_from_env :: (fn(env : Environment) -> TypeValue)({
  vars := get_variables_from_env(env, String.from("str"));
  (i : usize) = usize(0);
  (found : Option(TypeValue)) =.None;
  n := vars.len();
  while(i < n, {
    match(
      vars.get(i),
      .Some(v) => match(
        v.value,
        .Some(ev) => match(
          ev,
          .TypeVal(ty) => {
            found =.Some(ty.*);
          },
          _ => ()
        ),
        .None => ()
      ),
      .None => ()
    );
    i = (i + usize(1));
  });
  // Fall back to the builtin `str` (`.Str`), NOT `t_i32()` — this resolves the
  // runtime equivalent of a `comptime_str` receiver (e.g. for `"x".to_string()`).
  // The old `t_i32()` fallback made a `comptime_str` receiver resolve to `i32`
  // when no `str` type variable was bound in the env, so `"x".to_string()`
  // dispatched against `i32.to_string` and mis-compiled. See
  // issues/yo-self-comptime-str-to-string-codegen.md.
  match(found,.Some(t) => t,.None => t_str())
});
/// Convert a `comptime_*` receiver type to its runtime equivalent.
/// Mirrors the `expected = None` arm of
/// `convert_comptime_type_to_runtime_type` in
/// `types/env_lookup.yo` — inlined here for the same env.yo ↔
/// env_lookup.yo cycle reason as `_resolve_str_type_from_env`.
_comptime_receiver_to_runtime :: (
  fn(env : Environment, ty : TypeValue) -> TypeValue
)(
  cond(
    is_comptime_int_type(ty) => t_i32(),
    is_comptime_float_type(ty) => t_f64(),
    is_comptime_string_type(ty) => _resolve_str_type_from_env(env),
    true => ty
  )
);
/// Unwrap `*(T)` repeatedly to expose the underlying pointee type.
/// Used by `get_receiver_methods_by_name_from_env` to apply
/// method lookup to the dereferenced receiver. Mirrors TS:
///
///   while (isPtrType(dereferencedReceiverType)) {
///     dereferencedReceiverType = dereferencedReceiverType.childType;
///   }
_unwrap_ptr_chain :: (fn(t : TypeValue) -> TypeValue)({
  (cur : TypeValue) = t;
  (running : bool) = true;
  while(running, {
    cond(
      is_pointer_type(cur) => {
        cur = match(
          cur,
          .Pointer(inner) => inner.*,
          _ => cur
        );
      },
      true => {
        running = false;
      }
    );
  });
  cur
});
/// Extract the first parameter's `TypeValue` from a `Func`-typed
/// `ty`, or `Option(TypeValue).None` if `ty` is not a `Func` or
/// has no parameters.
_first_param_ty :: (fn(ty : TypeValue) -> Option(TypeValue))(
  match(
    ty,
    .Func({ param_types }) =>
      param_types.get(usize(0)),
    _ => Option(TypeValue).None
  )
);
/// Drop / annotate entries based on whether the method's first
/// parameter accepts the caller's receiver. Mirrors a subset of
/// TS `filterMethodsByReceiverType` in `src/env.ts:1288-1499`.
/// Rules applied:
///
///   1. Drop 0-arg `Func`-typed entries (TS:1306-1308 "Methods
///      must have at least one parameter (receiver)").
///   2. When `is_infix_operator_call` is true, drop entries whose
///      first parameter is `*(T)`. Mirrors the negative half of
///      TS:1326: infix-operator calls do NOT trigger
///      auto-pointer-conversion.
///   3. When `is_infix_operator_call` is false AND the first
///      parameter is `*(T)` AND the receiver is type-compatible
///      with `T` (via `are_types_compatible`), keep the entry
///      with `needs_pointer_conversion = true`. Mirrors the
///      positive half of TS:1326-1368: codegen will insert the
///      address-of so callers can pass `&receiver` automatically.
///      Comptime receivers are converted to their runtime
///      equivalents before the compatibility check, mirroring
///      TS:1332-1348.
///
/// Still owed (deferred to follow-up commits, all flagged in the
/// parent function's doc-comment):
///   - SelfType specialization (TS:1958-1961).
///   - SomeType-with-resolvedConcreteType matching (TS:1390-1406).
///   - The env-frames "compatible-SomeType" scan (TS:1927-1948)
///     — that one collects MORE methods rather than filtering,
///     so it'll land back in the lookup function, not here.
_filter_receiver_methods :: (
  fn(
    methods : ArrayList(MethodEntry),
    receiver_type : TypeValue,
    env : Environment,
    is_infix_operator_call : bool
  ) -> ArrayList(MethodEntry)
)({
  out := ArrayList(MethodEntry).new();
  // Resolve the effective receiver once — for ptr-compat checks
  // we compare against the comptime-converted runtime form.
  effective_receiver := cond(
    (
      is_comptime_int_type(receiver_type)
      || is_comptime_float_type(receiver_type)
      || is_comptime_string_type(receiver_type)
    ) => _comptime_receiver_to_runtime(env, receiver_type),
    true => receiver_type
  );
  n := methods.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      methods.get(i),
      .Some(m) => {
        // Decide keep / drop / annotate.
        cond(
          // Non-Func entries pass through unchanged.
          !(is_function_type(m.ty)) => {
            ___ := out.push(m);
          },
          // Rule 1: 0-arg Func is never a method.
          match(
            m.ty,
            .Func({ param_labels }) =>
              (param_labels.len() == usize(0)),
            _ => false
          ) => (),
          true => {
            // Inspect first parameter type.
            match(
              _first_param_ty(m.ty),
              .None => {
                ___ := out.push(m);
              },
              .Some(first_param) => cond(
                // Rule 3: *(T) first param + non-infix call.
                (!(is_infix_operator_call) && is_pointer_type(first_param)) => {
                  // Check if receiver is compatible with the
                  // pointee.
                  pointee := match(
                    first_param,
                    .Pointer(inner) => inner.*,
                    _ => first_param
                  );
                  cond(
                    are_types_compatible(effective_receiver, pointee) => {
                      // Materialise a new MethodEntry carrying
                      // the ptr-conversion flag. Mutating the
                      // input entry would leak across the
                      // registry's shared references.
                      ___ := out.push(
                        MethodEntry(
                          label : m.label,
                          ty : m.ty,
                          value : m.value,
                          source_trait_id : m.source_trait_id,
                          needs_pointer_conversion : true,
                          self_type : m.self_type
                        )
                      );
                    },
                    true => {
                      // Incompatible — keep without conversion
                      // flag; later filter passes / call-site
                      // overload checks may still accept it.
                      ___ := out.push(m);
                    }
                  );
                },
                // Infix call + *(T) first param: keep WITHOUT the
                // pointer-conversion flag. TS only gates the conversion
                // marking on `!isInfixOperatorCall` (env.ts:1278) — it
                // never drops the method; pointer-receiver operators
                // (`zp &+ zi`) match the `*(T)` first param directly and
                // the call-site parameter check validates. The previous
                // drop rule made every pointer-arithmetic operator
                // soft-fall to `unit`.
                true => {
                  ___ := out.push(m);
                }
              )
            );
          }
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});
/// Look up the trait methods that a *receiver value* of type
/// `receiver_type` can dispatch on. Mirrors TS
/// `getReceiverMethodsByNameFromEnv` in `src/env.ts:1158-2207`.
///
/// **First-cut port — direct path only.** The full TS function is
/// 1050 LoC and handles, in order:
///
///   1. ptr auto-deref (we do this — `_unwrap_ptr_chain`)
///   2. trait inspection on the OUTER (ptr) type
///   3. trait inspection on the DEREF'd type
///   4. comptime-receiver conversion + retry (i32/f64/str)
///   5. TypeApplication (HKT) unwrap
///   6. generic-impl registry (we delegate via the existing
///      `_g_find_methods_from_generic_impls_fn` callback,
///      installed by `evaluator/values/impl.yo`'s init block)
///   7. SomeType + where-clause-constraint walk
///   8. Dyn vtable dispatch
///   9. infix-operator overloads (`isInfixOperatorCall = true`)
///   10. final `filterMethodsByReceiverType` (compat checks +
///       `needsPointerConversion` flag)
///
/// This commit's incremental coverage now reaches: (1) + the
/// registry-side of (2)/(3) + (4) the comptime-receiver retry +
/// (5) TypeApplication where-clause walk + (6) the generic-impl
/// fallback + (7) the SomeType + where-clause walk + (8) Dyn
/// vtable dispatch + (9) the infix-operator overload filter +
/// a minimal (10) — enough for static-method dispatch on concrete
/// types, instance-method dispatch on direct receivers,
/// comptime-literal method calls like `5.to_string()`,
/// trait-bounded generic dispatch via `Impl(Trait)` or
/// `where(T <: Trait)`, dynamic dispatch through `Dyn(Trait1,
/// Trait2, ...)`, HKT dispatch via `where(F(A) <: Functor(F))`,
/// and infix-operator overload pruning (`a + b` correctly skips
/// any `+` method that takes `self` by `*(Self)`).
///
/// `_filter_receiver_methods` also now (this commit's batch)
/// implements the positive half of TS:1326-1368: when a method's
/// first parameter is `*(T)` and the (comptime-converted)
/// receiver is compatible with `T`, the returned `MethodEntry`
/// carries `needs_pointer_conversion = true` so codegen inserts
/// the address-of automatically.
///
/// Deferred (each call site in TS that uses one of these paths is
/// flagged):
///   - **SomeType resolvedConcreteType fast path** (TS:1390-1406).
///     yo-self's `SomeT` variant doesn't carry a
///     `resolved_concrete_type` field — concrete-binding lookup
///     goes through `getValueOfSomeTypeFromEnv` at the call-site
///     evaluator instead, not here.
///
/// SelfType specialization (TS:1958-1961) is now landed: the
/// SomeT, Dyn, and TypeApplication trait-walk branches set
/// `MethodEntry.self_type = Some(dereferenced)` on every emitted
/// entry so call sites can resolve `Self` references in the
/// method's signature to the concrete receiver type.
///
/// The `context` parameter on the TS side threads through into
/// `createUnknownValue` warning/debug paths. yo-self's
/// `EvalContext` lives in `evaluator/context.yo`, which already
/// imports `env.yo` (cycle). Pulling it in here would force
/// another callback-injection ceremony. For now the context arg
/// is dropped — `MethodEntry.value` is whatever the registry / the
/// generic-impl adapter stored, with no on-the-fly UnknownValue
/// synthesis. Once the proper-evaluator gap-fill stream needs the
/// synthesised values, we'll thread context through via the
/// callback pattern (same as
/// `set_find_methods_from_generic_impls_fn`).
get_receiver_methods_by_name_from_env :: (
  fn(
    env : Environment,
    method_name : String,
    receiver_type : TypeValue,
    is_infix_operator_call : bool
  ) -> ArrayList(MethodEntry)
)({
  // `is_infix_operator_call` is consumed below by the
  // `_filter_receiver_methods` call site — see that helper's
  // doc-comment for the negative-half-of-TS:1326 semantics it
  // implements today.
  methods := ArrayList(MethodEntry).new();
  dereferenced := _unwrap_ptr_chain(receiver_type);
  // Direct method lookup against the receiver's id.
  outer_id := type_id_or_empty(receiver_type);
  if(outer_id != String.from(""), {
    direct := get_type_trait_methods_by_name(outer_id, method_name);
    nd := direct.len();
    (di : usize) = usize(0);
    while(di < nd, {
      match(
        direct.get(di),
        .Some(m) => {
          ___ := methods.push(m);
        },
        .None => ()
      );
      di = (di + usize(1));
    });
  });
  // If receiver was a pointer chain, also try the dereferenced type.
  deref_id := type_id_or_empty(dereferenced);
  if((deref_id != String.from("")) && (deref_id != outer_id), {
    deref_methods := get_type_trait_methods_by_name(deref_id, method_name);
    nm := deref_methods.len();
    (mi : usize) = usize(0);
    while(mi < nm, {
      match(
        deref_methods.get(mi),
        .Some(m) => {
          ___ := methods.push(m);
        },
        .None => ()
      );
      mi = (mi + usize(1));
    });
  });
  // Comptime-receiver conversion retry. Mirrors TS
  // `src/env.ts:1703-1793`: when the receiver is `comptime_int`,
  // `comptime_float`, or `comptime_str`, also try the method
  // on its runtime equivalent (`i32`, `f64`, `str`). Comptime
  // literals expose the same methods as their runtime
  // counterparts — e.g. `5.to_string()` resolves to `i32.to_string`.
  //
  // We compose with the registry primitives we already have
  // rather than the TS implementation's direct `.trait.fields`
  // walk (yo-self stores trait methods in the module-level
  // registry keyed by type id; see
  // `evaluator/values/type_trait_methods.yo`, io).
  is_comptime_receiver := (
    is_comptime_int_type(dereferenced)
    || is_comptime_float_type(dereferenced)
    || is_comptime_string_type(dereferenced)
  );
  if(is_comptime_receiver, {
    runtime_ty := _comptime_receiver_to_runtime(env, dereferenced);
    runtime_id := type_id_or_empty(runtime_ty);
    if(runtime_id != String.from(""), {
      from_runtime := get_type_trait_methods_by_name(runtime_id, method_name);
      nr := from_runtime.len();
      (ri : usize) = usize(0);
      while(ri < nr, {
        match(
          from_runtime.get(ri),
          .Some(m) => {
            ___ := methods.push(m);
          },
          .None => ()
        );
        ri = (ri + usize(1));
      });
    });
    // Also let the generic-impl fallback see the runtime type when
    // no direct hits were found — mirrors the inner
    // `if (methods.length === 0) methods.push(...findMethodsFromGenericImpls(runtimeType))`
    // path inside the TS comptime branch.
    if(methods.len() == usize(0), {
      match(
        _g_find_methods_from_generic_impls_fn,
        .None => (),
        .Some(f) => {
          from_generic_rt := f(env, method_name, runtime_ty);
          ng2 := from_generic_rt.len();
          (gj : usize) = usize(0);
          while(gj < ng2, {
            match(
              from_generic_rt.get(gj),
              .Some(m) => {
                ___ := methods.push(m);
              },
              .None => ()
            );
            gj = (gj + usize(1));
          });
        }
      );
    });
  });
  // SomeType + where-clause walk. Mirrors TS `src/env.ts:1795-2094`.
  //
  // When the receiver is a `SomeT(...)`, methods can live on:
  //   (a) the SomeType's own `required_trait_types` field
  //       (e.g. `Impl(Id)` produces a SomeT whose required-trait
  //       list contains `Id`), and
  //   (b) where-clause constraints attached to this SomeType in
  //       any enclosing frame (e.g. `where(T <: Id)` inside a
  //       `forall(T)` block).
  //
  // For each candidate trait we look up the method by name in the
  // trait's `field_labels` / `field_types` arrays. The method
  // VALUE is left as `None` — yo-self stores trait method values
  // in `TraitVal`s registered separately; at this dispatch site
  // we only need the type so the call-site evaluator can pick the
  // right overload, and the concrete value will be resolved by
  // the call-site path that consults the env / generic-impl
  // registry once the receiver type is bound.
  //
  // Carry-forward divergences (still owed, will land in
  // follow-up commits):
  //   - resolvedConcreteType static-dispatch fast path
  //     (yo-self's `SomeT` variant doesn't carry a
  //     `resolved_concrete_type` field — lookup goes through
  //     `getValueOfSomeTypeFromEnv` at the call-site evaluator
  //     instead, not here).
  //   - The env-frames "compatible-SomeType" scan that picks up
  //     constraints registered against a DIFFERENT SomeType that
  //     happens to be compatible with this receiver. That requires
  //     `are_types_compatible` (in `types/compatibility.yo` which
  //     imports `env.yo` — cycle). It'll land via the
  //     callback-injection pattern already used by
  //     `set_find_methods_from_generic_impls_fn`.
  //   - `needsPointerConversion` + SelfType specialization.
  if(is_some_type(dereferenced) && (methods.len() == usize(0)), {
    // Collect candidate traits (deduplicated by trait id) from:
    //   1. the SomeT's own required_trait_types,
    //   2. direct where-clause constraints in the env.
    candidate_traits := ArrayList(TypeValue).new();
    seen_trait_ids := ArrayList(String).new();
    _push_trait_if_new := (
      fn(traits : ArrayList(TypeValue), seen : ArrayList(String), trait_ty : TypeValue) -> unit
    )({
      tid := _trait_type_id(trait_ty);
      if(tid != String.from(""), {
        sn := seen.len();
        (si : usize) = usize(0);
        (already : bool) = false;
        while((si < sn) && !(already), {
          match(
            seen.get(si),
            .Some(s) => {
              if(s == tid, {
                already = true;
              });
            },
            .None => ()
          );
          si = (si + usize(1));
        });
        if(!(already), {
          seen.push(tid);
          traits.push(trait_ty);
        });
      });
    });
    // (1) SomeT's required_trait_types.
    match(
      dereferenced,
      .SomeT(
        id : _,
        name : _,
        frame_level : _,
        parent_type : _,
        required_trait_types : rtt,
        required_trait_levels : _,
        negative_trait_types : _,
        negative_trait_levels : _,
        is_effects_row : _
      ) => {
        m := rtt.len();
        (i : usize) = usize(0);
        while(i < m, {
          match(
            rtt.get(i),
            .Some(t) => _push_trait_if_new(candidate_traits, seen_trait_ids, t),
            .None => ()
          );
          i = (i + usize(1));
        });
      },
      _ => ()
    );
    // (2) Direct where-clause constraints attached to this SomeType.
    match(
      get_where_clause_constraints_for_some_type(env, dereferenced),
      .Some(wcc) => {
        m := wcc.required_traits.len();
        (i : usize) = usize(0);
        while(i < m, {
          match(
            wcc.required_traits.get(i),
            .Some(t) => _push_trait_if_new(candidate_traits, seen_trait_ids, t),
            .None => ()
          );
          i = (i + usize(1));
        });
      },
      .None => ()
    );
    // (3) Env-frames "compatible-SomeType" scan. Mirrors TS
    // `src/env.ts:1927-1948`. Walks every frame's where-clause
    // constraints — for each entry whose `someType` is type-
    // compatible with the dereferenced receiver, fold its
    // required traits into the candidate list. Picks up
    // constraints registered against a DIFFERENT SomeType that
    // happens to match this receiver structurally (a fairly
    // common case in HKT-heavy code where a constraint binds
    // `_Self` and the call site sees `Output` aliased to it).
    fn_count := env.frames.len();
    (ef : usize) = usize(0);
    while(ef < fn_count, {
      match(
        env.frames.get(ef),
        .None => (),
        .Some(frame) => {
          // Iterate the frame's where_clause_constraints values.
          it := frame.where_clause_constraints.values();
          (running : bool) = true;
          while(running, {
            match(
              it.next(),
              .None => {
                running = false;
              },
              .Some(constraint_entry) => {
                if(are_types_compatible(
                  constraint_entry.some_type,
                  dereferenced
                ), {
                  rm := constraint_entry.required_traits.len();
                  (ri : usize) = usize(0);
                  while(ri < rm, {
                    match(
                      constraint_entry.required_traits.get(ri),
                      .Some(rt) =>
                        _push_trait_if_new(candidate_traits, seen_trait_ids, rt),
                      .None => ()
                    );
                    ri = (ri + usize(1));
                  });
                });
              }
            );
          });
        }
      );
      ef = (ef + usize(1));
    });
    // For each candidate trait, find the method by name in
    // `field_labels` / `field_types`. The trait's `id` becomes
    // `source_trait_id` so callers can disambiguate which trait
    // contributed the method.
    nc := candidate_traits.len();
    (ci : usize) = usize(0);
    while(ci < nc, {
      match(
        candidate_traits.get(ci),
        .Some(tt) => match(
          tt,
          .TraitT(_, _, field_labels, field_types, tid, _, _, _) => {
            nfields := field_labels.len();
            (fi : usize) = usize(0);
            (found_one : bool) = false;
            while((fi < nfields) && !(found_one), {
              match(
                field_labels.get(fi),
                .Some(lbl) => {
                  if(lbl == method_name, {
                    match(
                      field_types.get(fi),
                      .Some(fty) => cond(
                        is_function_type(fty) => {
                          ___ := methods.push(
                            MethodEntry(
                              label : method_name.clone(),
                              ty : fty,
                              value : Option(EvalValue).None,
                              source_trait_id : tid.clone(),
                              needs_pointer_conversion : false,
                              self_type : Option(TypeValue).Some(dereferenced)
                            )
                          );
                          found_one = true;
                        },
                        true => ()
                      ),
                      .None => ()
                    );
                  });
                },
                .None => ()
              );
              fi = (fi + usize(1));
            });
          },
          _ => ()
        ),
        .None => ()
      );
      ci = (ci + usize(1));
    });
  });
  // TypeApplication (HKT) where-clause walk. Mirrors TS
  // `src/env.ts:1691-1701`.
  //
  // When the receiver is `F(A)` for some higher-kinded type
  // constructor `F` and we haven't found a method yet, consult
  // any where-clause constraints attached to this exact
  // TypeApplication (e.g. `where(F(A) <: Functor(F))`). For each
  // required trait, find the method by label and emit a
  // `MethodEntry` with the trait id as `source_trait_id` — same
  // shape as the SomeT branch above.
  if(is_type_application_type(dereferenced) && (methods.len() == usize(0)), {
    match(
      get_where_clause_constraints_for_type_application(env, dereferenced),
      .Some(wcc) => {
        m := wcc.required_traits.len();
        (i : usize) = usize(0);
        while(i < m, {
          match(
            wcc.required_traits.get(i),
            .Some(tt) => match(
              tt,
              .TraitT(_, _, field_labels, field_types, tid, _, _, _) => {
                nfields := field_labels.len();
                (fi : usize) = usize(0);
                (found_one : bool) = false;
                while((fi < nfields) && !(found_one), {
                  match(
                    field_labels.get(fi),
                    .Some(lbl) => {
                      if(lbl == method_name, {
                        match(
                          field_types.get(fi),
                          .Some(fty) => cond(
                            is_function_type(fty) => {
                              ___ := methods.push(
                                MethodEntry(
                                  label : method_name.clone(),
                                  ty : fty,
                                  value : Option(EvalValue).None,
                                  source_trait_id : tid.clone(),
                                  needs_pointer_conversion : false,
                                  self_type : Option(TypeValue).Some(dereferenced)
                                )
                              );
                              found_one = true;
                            },
                            true => ()
                          ),
                          .None => ()
                        );
                      });
                    },
                    .None => ()
                  );
                  fi = (fi + usize(1));
                });
              },
              _ => ()
            ),
            .None => ()
          );
          i = (i + usize(1));
        });
      },
      .None => ()
    );
  });
  // Dyn vtable dispatch. Mirrors TS `src/env.ts:2095-2145`.
  //
  // `Dyn(Trait1, Trait2, ...)` is a heap-erased object whose
  // concrete impls of each required trait sit behind a vtable.
  // For lookup purposes, we treat the DynT exactly like a SomeT
  // bounded by its required trait set: walk every required trait
  // and pull the first matching method.
  //
  // Skipped vs TS:
  //   - "First, check the dyn object's own trait for its Rc
  //     methods (___drop / ___dup / ___dispose)." yo-self's
  //     `DynT` variant doesn't carry a `.trait` slot (those Rc
  //     fns live in the codegen-side dyn registry, not on the
  //     type). When the receiver-method lookup needs to find
  //     `___drop` etc. on a Dyn value, the call site queries the
  //     codegen dyn registry directly.
  //   - `areTypesCompatible` first-parameter filtering. yo-self's
  //     `are_types_compatible` lives in `types/compatibility.yo`
  //     which already imports `env.yo` (cycle); the call site
  //     handles the compatibility check post-lookup until that
  //     cycle is broken via the callback-injection pattern.
  if(is_dyn_type(dereferenced), {
    match(
      dereferenced,
      .DynT(
        required_trait_types : dyn_traits,
        required_trait_levels : _,
        negative_trait_types : _,
        negative_trait_levels : _
      ) => {
        nt := dyn_traits.len();
        (ti : usize) = usize(0);
        while(ti < nt, {
          match(
            dyn_traits.get(ti),
            .Some(tt) => match(
              tt,
              .TraitT(_, _, field_labels, field_types, tid, _, _, _) => {
                nfields := field_labels.len();
                (fi : usize) = usize(0);
                while(fi < nfields, {
                  match(
                    field_labels.get(fi),
                    .Some(lbl) => {
                      if(lbl == method_name, {
                        match(
                          field_types.get(fi),
                          .Some(fty) => cond(
                            is_function_type(fty) => {
                              ___ := methods.push(
                                MethodEntry(
                                  label : method_name.clone(),
                                  ty : fty,
                                  value : Option(EvalValue).None,
                                  source_trait_id : tid.clone(),
                                  needs_pointer_conversion : false,
                                  self_type : Option(TypeValue).Some(dereferenced)
                                )
                              );
                            },
                            true => ()
                          ),
                          .None => ()
                        );
                      });
                    },
                    .None => ()
                  );
                  fi = (fi + usize(1));
                });
              },
              _ => ()
            ),
            .None => ()
          );
          ti = (ti + usize(1));
        });
      },
      _ => ()
    );
  });
  // Generic-impl fallback (non-comptime path). Mirrors TS:
  //   if (methods.length === 0) methods.push(...findMethodsFromGenericImpls(...))
  // We go through the callback installed by impl.yo's init block
  // (see `set_find_methods_from_generic_impls_fn` above) so env.yo
  // doesn't have to import `impl.yo` directly and re-create the
  // module cycle.
  if(methods.len() == usize(0), {
    match(
      _g_find_methods_from_generic_impls_fn,
      .None => (),
      .Some(f) => {
        // Try the ORIGINAL receiver type first, then the dereferenced one.
        // TS's trait-compat scan checks both (env.ts:1153-1159: original,
        // then "Continue checking with the dereferencedReceiverType").
        // Pointer-receiver generic impls — `impl(forall(T), *(T), (&+) :
        // ...)` — only match the ORIGINAL `*(u8)`; dereferencing to `u8`
        // before matching made every pointer-arithmetic operator soft-fall
        // to `unit` under def-eval.
        from_generic := f(env, method_name, receiver_type);
        ng := from_generic.len();
        (gi : usize) = usize(0);
        while(gi < ng, {
          match(
            from_generic.get(gi),
            .Some(m) => {
              ___ := methods.push(m);
            },
            .None => ()
          );
          gi = (gi + usize(1));
        });
        if((methods.len() == usize(0)) && is_pointer_type(receiver_type), {
          from_generic2 := f(env, method_name, dereferenced);
          ng2 := from_generic2.len();
          (gi2 : usize) = usize(0);
          while(gi2 < ng2, {
            match(
              from_generic2.get(gi2),
              .Some(m2) => {
                ___ := methods.push(m2);
              },
              .None => ()
            );
            gi2 = (gi2 + usize(1));
          });
        });
      }
    );
  });
  _filter_receiver_methods(methods, receiver_type, env, is_infix_operator_call)
});
