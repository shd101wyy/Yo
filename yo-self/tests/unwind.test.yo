/// Tests for yo-self/evaluator/exprs/unwind.yo — Phase 2r
///
/// Covers `evaluate_unwind` — the production handler for `unwind(value)`.
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr, ast_expr_id, BF_UNWIND } :: import("../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set,
  ControlFlowKind,
  control_flow_of,
  has_control_flow
}
:: import("../expr_info.yo");
{ Environment } :: import("../env.yo");
{ EvalContext, eval_context_new } :: import("../evaluator/context.yo");
{ EvalValue } :: import("../value.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ t_i32 } :: import("../types/creators.yo");
{ set_evaluate_expression_fn, evaluate_expression }
:: import("../evaluator/exprs/expr.yo");
{ evaluate_unwind } :: import("../evaluator/exprs/unwind.yo");
{ Exception } :: import("std/error");
mk_token :: (fn(value : str) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);
mk_escape_call :: (fn(arg_id : usize, arg_value : str, call_id : usize) -> AstExpr)({
  arg_atom := AstExpr.Atom(arg_id, mk_token(arg_value));
  callee := AstExpr.Atom(call_id + usize(1000), mk_token(BF_UNWIND));
  args := ArrayList(AstExpr).new();
  args.push(arg_atom);
  AstExpr.FnCall(call_id, callee, args, false, mk_token(BF_UNWIND))
});
stub_evaluate_i32 :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext
  ) -> AstExpr
)({
  info := new_expr_info(env, t_i32());
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
test("evaluate_unwind: writes ExprInfo with Unwind control flow", {
  set_evaluate_expression_fn(stub_evaluate_i32);
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  ctx := eval_context_new(String.from("/std"), String.from("test"));
  ctx_ptr := ctx;
  i32_ty := t_i32();
  ctx_ptr.enclosing_function_return_type =.Some(i32_ty);
  ctx_ptr.is_inside_given_handler = true;
  env := Environment.new(String.from("test"));
  call := mk_escape_call(usize(21), "0", usize(22));
  result := evaluate_unwind(call, env, ctx, exn);
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(result));
  assert(match(info_opt,.Some(_) => true,.None => false), "unwind(did not record an ExprInfo)");
  info := match(
    info_opt,
    .Some(i) => i,
    .None => new_expr_info(env, t_i32())
  );
  // Type should be i32 (from stub).
  match(
    info.ty,
    .Int(bits, signed) => {
      assert(bits == u8(32), "expected unwind(to inherit i32 bits=32)");
      assert(signed, "expected unwind(to inherit i32 signed=true)");
    },
    _ => assert(false, "expected unwind(ty to be Int(32, true))")
  );
  // value must be .None
  match(
    info.value,
    .None => (),
    .Some(_) => assert(false, "expected unwind(to leave value = .None)")
  );
  // Control flow flag must include Unwind.
  assert(
    has_control_flow(info.control_flow,.Unwind),
    "expected unwind(to set control_flow = .Unwind)"
  );
});
