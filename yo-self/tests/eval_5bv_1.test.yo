  src := "n := i32(1);\ns := i32(0);\nwhile((n <= i32(15)), {\nod := cond(((n % i32(2)) != i32(0)) => i32(1), true => i32(0));\nnd3 := cond(((n % i32(3)) != i32(0)) => i32(1), true => i32(0));\ns = (s + ((od * nd3) * n));\nn = (n + i32(1));\n});\nexport(s);\n";
