  src := "arr := [i32(5), i32(3), i32(8), i32(1), i32(9), i32(2), i32(7), i32(4)];\nmx := i32(0);\nmn := i32(9999);\ni := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap();\nmx = cond((v > mx) => v, true => mx);\nmn = cond((v < mn) => v, true => mn);\ni = (i + i32(1));\n});\nresult := (mx - mn);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
