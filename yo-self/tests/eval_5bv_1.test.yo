// @skip_wasm32-emscripten
// @skip_wasm32-wasi
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
empty_env :: (fn() -> Environment)(Environment.new(`test`));

// ---------------------------------------------------------------------------
// Phase 5bva — Collatz sequences and OR-condition counting
// ---------------------------------------------------------------------------
test("Phase 5bva: Collatz steps from n=6 = 8", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 6->3->10->5->16->8->4->2->1 = 8 steps
  src := "n := i32(6);\nsteps := i32(0);\nwhile((n > i32(1)), {\nev := cond(((n % i32(2)) == i32(0)) => i32(1), true => i32(0));\nn = cond((ev == i32(1)) => (n / i32(2)), true => ((i32(3) * n) + i32(1)));\nsteps = (steps + i32(1));\n});\nexport(steps);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "8", "8"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
