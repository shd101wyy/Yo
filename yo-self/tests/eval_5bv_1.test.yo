          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5bvd — grand combos (row sums)
// ---------------------------------------------------------------------------
test("Phase 5bvd: collatz6 + collatz11 + sum_div6 = 8+14+36 = 58", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "n1 := i32(6);\nst1 := i32(0);\nwhile((n1 > i32(1)), {\nev1 := cond(((n1 % i32(2)) == i32(0)) => i32(1), true => i32(0));\nn1 = cond((ev1 == i32(1)) => (n1 / i32(2)), true => ((i32(3) * n1) + i32(1)));\nst1 = (st1 + i32(1));\n});\nn2 := i32(11);\nst2 := i32(0);\nwhile((n2 > i32(1)), {\nev2 := cond(((n2 % i32(2)) == i32(0)) => i32(1), true => i32(0));\nn2 = cond((ev2 == i32(1)) => (n2 / i32(2)), true => ((i32(3) * n2) + i32(1)));\nst2 = (st2 + i32(1));\n});\nn3 := i32(1);\ns3 := i32(0);\nwhile((n3 <= i32(20)), {\nm2 := cond(((n3 % i32(2)) == i32(0)) => i32(1), true => i32(0));\nm3 := cond(((n3 % i32(3)) == i32(0)) => i32(1), true => i32(0));\ns3 = (s3 + ((m2 * m3) * n3));\nn3 = (n3 + i32(1));\n});\nresult := ((st1 + st2) + s3);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "58", "58"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
