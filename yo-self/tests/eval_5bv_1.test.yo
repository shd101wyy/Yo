test("Phase 5bva: sum n in 1..20 where n divisible by both 2 and 3 = 36", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // multiples of 6: 6,12,18 => 6+12+18=36
  src := "n := i32(1);\ns := i32(0);\nwhile((n <= i32(20)), {\nm2 := cond(((n % i32(2)) == i32(0)) => i32(1), true => i32(0));\nm3 := cond(((n % i32(3)) == i32(0)) => i32(1), true => i32(0));\ns = (s + ((m2 * m3) * n));\nn = (n + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "36", "36"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bva: count n in 1..100 where n%4==0 OR n%6==0 = 33", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // mult4:25, mult6:16, mult12:8 => 25+16-8=33
  src := "n := i32(1);\ncnt := i32(0);\nwhile((n <= i32(100)), {\nm4 := cond(((n % i32(4)) == i32(0)) => i32(1), true => i32(0));\nm6 := cond(((n % i32(6)) == i32(0)) => i32(1), true => i32(0));\nor := cond(((m4 + m6) > i32(0)) => i32(1), true => i32(0));\ncnt = (cnt + or);\nn = (n + i32(1));\n});\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "33", "33"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5bvb — array max/min/mean patterns
// ---------------------------------------------------------------------------
test("Phase 5bvb: maximum element of [5,3,8,1,9,2,7,4] = 9", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(5), i32(3), i32(8), i32(1), i32(9), i32(2), i32(7), i32(4)];\nmx := i32(0);\ni := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap();\nmx = cond((v > mx) => v, true => mx);\ni = (i + i32(1));\n});\nexport(mx);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "9", "9"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bvb: sum of elements strictly above minimum in [5,3,8,1,9,2,7,4] = 38", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // min=1; sum of elements > 1: 5+3+8+9+2+7+4=38
  src := "arr := [i32(5), i32(3), i32(8), i32(1), i32(9), i32(2), i32(7), i32(4)];\nmn := i32(9999);\ni := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap();\nmn = cond((v < mn) => v, true => mn);\ni = (i + i32(1));\n});\ni2 := i32(0);\ns := i32(0);\nwhile((i2 < i32(8)), {\nv2 := arr.get(i2).unwrap();\ngt := cond((v2 > mn) => i32(1), true => i32(0));\ns = (s + (gt * v2));\ni2 = (i2 + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "38", "38"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bvb: count elements above mean (sum=39, n=8) in [5,3,8,1,9,2,7,4] = 4", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
