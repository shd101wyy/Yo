});
test("Phase 5bvb: sum of elements != min AND != max in [5,3,8,1,9,2,7,4] = 29", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // min=1, max=9; skip those; 5+3+8+2+7+4=29
  src := "arr := [i32(5), i32(3), i32(8), i32(1), i32(9), i32(2), i32(7), i32(4)];\ni := i32(0);\ns := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap();\nneq1 := cond((v != i32(1)) => i32(1), true => i32(0));\nneq9 := cond((v != i32(9)) => i32(1), true => i32(0));\ns = (s + ((neq1 * neq9) * v));\ni = (i + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "29", "29"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

