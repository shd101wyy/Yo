// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5ao series: array HOF edge cases and pipelines.
/// Covers join pipelines, any/all predicates, find+unwrap_or, enumerate, and
/// zip length + or_else/flat_map combos.
///
/// Phases covered:
///   5aoa — ArrayVal.join pipelines (split+join, string array join, join+contains, join+len)
///   5aob — ArrayVal.any and ArrayVal.all predicates (true/false outcomes)
///   5aoc — ArrayVal.find combined with is_some/is_none and unwrap_or
///   5aod — ArrayVal.enumerate length and first element
///   5aoe — Combos: zip len, or_else for None Option, flat_map result len
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5aoa — ArrayVal.join pipelines
// ---------------------------------------------------------------------------
test("Phase 5aoa: split then join with different separator", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := \"a,b,c\";\nparts := s.split(\",\");\nresult := parts.join(\"-\");\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.StrLit(raw) => assert(raw.as_str() == "\"a-b-c\"", "a-b-c"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

