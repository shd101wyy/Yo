// ---------------------------------------------------------------------------
// Phase 5aoe — Combos: zip len, or_else for None Option, flat_map result len
// ---------------------------------------------------------------------------
test("Phase 5aoe: zip equal-length arrays gives same length", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "a := [i32(1), i32(2), i32(3)];\nb := [i32(4), i32(5), i32(6)];\nresult := a.zip(b).len();\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5aoe: or_else on None Option calls fallback", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "opt := i64.None;\nresult := opt.or_else((fn() -> Option(i64))(i64.Some(i64(42))));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .EnumVal(tag, fields) => {
              assert(tag.as_str() == ".Some", "Some");
              match(
                fields.get(usize(0)),
                .Some(inner) => match(inner,.IntLit(n) => assert(n.as_str() == "42", "42"), _ => assert(false, "t")),
                .None => assert(false, "f")
              );
            },
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5aoe: or_else on Some Option skips fallback", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "opt := i64.Some(i64(7));\nresult := opt.or_else((fn() -> Option(i64))(i64.Some(i64(99))));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .EnumVal(tag, fields) => {
              assert(tag.as_str() == ".Some", "Some");
              match(
                fields.get(usize(0)),
                .Some(inner) => match(inner,.IntLit(n) => assert(n.as_str() == "7", "7"), _ => assert(false, "t")),
                .None => assert(false, "f")
              );
            },
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5aoe: flat_map flattens nested arrays and count result", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(1), i32(2), i32(3)];\nresult := arr.flat_map((fn(x : i32) -> [i32])([x, x])).len();\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "6"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
