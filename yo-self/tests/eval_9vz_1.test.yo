// @skip_wasm32-emscripten
// @skip_wasm32-wasi
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
empty_env :: (fn() -> Environment)(Environment.new(`test`));
test("Phase 12io/9vz: T1 running_max_sum of [3,9,6,3,10,7,11,1,5] = 83", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(3), i32(9), i32(6), i32(3), i32(10), i32(7), i32(11), i32(1), i32(5)];\ns := i32(0); mx := i32(0); i := i32(0);\nwhile((i < i32(9)), {\nv := arr.get(i).unwrap(); mx = cond((v > mx) => v, true => mx); s = (s + mx); i = (i + i32(1));\n});\npms := s;\nr := pms;\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "83", "83"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

