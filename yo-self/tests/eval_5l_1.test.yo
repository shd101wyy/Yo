test("Phase 5la: clamp via nested limits.lo and limits.hi", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Limits :: struct(lo : i32, hi : i32);\nRange :: struct(limits : Limits, val : i32);\nimpl(Range, Math(\n  clamp : (fn(x : Range) -> i32)(cond(\n    (x.val < x.limits.lo) => x.limits.lo,\n    (x.val > x.limits.hi) => x.limits.hi,\n    true => x.val\n  ))\n));\nr := Range(limits: Limits(lo: i32(0), hi: i32(10)), val: i32(15));\nexport(r.clamp());";
  exprs := generate_exprs_from_code(src, using(exn));
