// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5l series: advanced impl method patterns.
///
/// Phases covered:
///   5la — nested struct field access in impl methods (x.inner.field)
///   5lb — string field methods in impl methods (starts_with, ends_with, contains)
///   5lc — impl method calling another impl method on the same struct
///   5ld — multi-export patterns (two or more export() calls)
///   5le — complex combinations (nesting + while + helpers + enum fields)
///
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5la — nested struct field access in impl methods
// ---------------------------------------------------------------------------
test("Phase 5la: inner.val + outer.extra", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Inner :: struct(val : i32);\nOuter :: struct(inner : Inner, extra : i32);\nimpl(Outer, Math(\n  combined : (fn(x : Outer) -> i32)({ (x.inner.val + x.extra) })\n));\no := Outer(inner: Inner(val: i32(3)), extra: i32(4));\nexport(o.combined());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "7", "3+4=7"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
