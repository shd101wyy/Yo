  }, _ => assert(false, "m")));
});
test("Phase 5lc: bool chain — is_positive and is_even via methods", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(v : i32);\nimpl(N, Logic(\n  is_pos  : (fn(x : N) -> bool)({ (x.v > i32(0)) }),\n  is_even : (fn(x : N) -> bool)({ ((x.v % i32(2)) == i32(0)) }),\n  pos_even : (fn(x : N) -> bool)({ (x.is_pos() && x.is_even()) })\n));\nn := N(v: i32(4));\nexport(n.pos_even());";
