test("Phase 5le: while + method-calls-method + enum match", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Sign :: enum(Pos, Neg, Zero);\nN :: struct(v : i32);\nimpl(N, Math(\n  sign_of  : (fn(x : N) -> Sign)(cond(\n    (x.v > i32(0)) => .Pos,\n    (x.v < i32(0)) => .Neg,\n    true => .Zero\n  )),\n  sign_val : (fn(x : N) -> i32)(match(x.sign_of(), .Pos => i32(1), .Neg => i32(-(1)), .Zero => i32(0))),\n  sum_signs : (fn(x : N) -> i32)({\n    (acc : i32) = i32(0);\n    (i : i32) = i32(0);\n    (n : i32) = x.v;\n    while(runtime((i < n)), {\n      acc = (acc + i32(1));\n      i = (i + i32(1));\n    });\n    (acc * x.sign_val())\n  })\n));\nv := N(v: i32(5));\nexport(v.sum_signs());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "5", "5*1=5"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
