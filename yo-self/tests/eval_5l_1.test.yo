test("Phase 5la: sum_to via while using inner.limit", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Ctrl :: struct(limit : i32);\nLoop :: struct(ctrl : Ctrl, start : i32);\nimpl(Loop, Math(\n  sum_to : (fn(x : Loop) -> i32)({\n    (acc : i32) = i32(0);\n    (i : i32) = x.start;\n    while(runtime((i <= x.ctrl.limit)), {\n      acc = (acc + i);\n      i = (i + i32(1));\n    });\n    acc\n  })\n));\nl := Loop(ctrl: Ctrl(limit: i32(5)), start: i32(1));\nexport(l.sum_to());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "15", "1+2+3+4+5=15"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
