/// Tests for yo-self/codegen/exprs/other_fn_call.yo (partial port).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ split_top_level_args_list } :: import("../codegen/exprs/other_fn_call.yo");
test("split_top_level_args_list: empty string → empty list", {
  out := split_top_level_args_list(String.from(""));
  assert(out.len() == usize(0), "no elements");
});
test("split_top_level_args_list: single argument", {
  out := split_top_level_args_list(String.from("x"));
  assert(out.len() == usize(1), "one element");
  match(out.get(usize(0)),.Some(s) => assert(s == String.from("x"), "x"),.None => assert(false, "expected Some"));
});
test("split_top_level_args_list: a, b, c → 3 trimmed elements", {
  out := split_top_level_args_list(String.from("a, b, c"));
  assert(out.len() == usize(3), "three elements");
  match(out.get(usize(0)),.Some(s) => assert(s == String.from("a"), "a"),.None => assert(false, "0"));
  match(out.get(usize(1)),.Some(s) => assert(s == String.from("b"), "b"),.None => assert(false, "1"));
  match(out.get(usize(2)),.Some(s) => assert(s == String.from("c"), "c"),.None => assert(false, "2"));
});
test("split_top_level_args_list: parens nest properly", {
  // The comma inside foo(a,b) should not split the outer list.
  out := split_top_level_args_list(String.from("foo(a, b), bar"));
  assert(out.len() == usize(2), "two elements");
  match(out.get(usize(0)),.Some(s) => assert(s == String.from("foo(a, b)"), "foo(a, b)"),.None => assert(false, "0"));
  match(out.get(usize(1)),.Some(s) => assert(s == String.from("bar"), "bar"),.None => assert(false, "1"));
});
test("split_top_level_args_list: brackets and braces also nest", {
  out := split_top_level_args_list(String.from("arr[0, 1], { x, y }, z"));
  assert(out.len() == usize(3), "three elements");
  match(out.get(usize(0)),.Some(s) => assert(s == String.from("arr[0, 1]"), "arr[0, 1]"),.None => assert(false, "0"));
  match(out.get(usize(1)),.Some(s) => assert(s == String.from("{ x, y }"), "{ x, y }"),.None => assert(false, "1"));
  match(out.get(usize(2)),.Some(s) => assert(s == String.from("z"), "z"),.None => assert(false, "2"));
});
test("split_top_level_args_list: whitespace-only input → empty", {
  out := split_top_level_args_list(String.from("   "));
  assert(out.len() == usize(0), "whitespace → empty");
});
test("split_top_level_args_list: trailing whitespace is trimmed", {
  out := split_top_level_args_list(String.from("a,   b   "));
  assert(out.len() == usize(2), "two elements");
  match(out.get(usize(1)),.Some(s) => assert(s == String.from("b"), "trimmed b"),.None => assert(false, "1"));
});
test("split_top_level_args_list: nested calls keep their inner commas", {
  out := split_top_level_args_list(String.from("(a + b), foo(x, bar(y, z)), c"));
  assert(out.len() == usize(3), "three elements");
  match(out.get(usize(1)),.Some(s) => assert(s == String.from("foo(x, bar(y, z))"), "nested call"),.None => assert(false, "1"));
});
