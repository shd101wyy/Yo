  src := "f2 := (fn(x : i32) -> i32)((x * i32(2)));\nf3 := (fn(x : i32) -> i32)((x * i32(3)));\nf4 := (fn(x : i32) -> i32)((x * i32(4)));\nresults := [f2(i32(3)), f3(i32(4)), f4(i32(2))];\nexport(results.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x))));\n";
