          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bbb: function applied to multiple arguments yields correct result", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // clamp(x, lo, hi) = max(lo, min(hi, x))
  // clamp(15, 0, 10) = 10
  src := "clamp := (fn(x : i32, lo : i32, hi : i32) -> i32)(cond((x < lo) => lo, (x > hi) => hi, true => x));\nexport(clamp(i32(15), i32(0), i32(10)));\n";
