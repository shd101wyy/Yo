// ---------------------------------------------------------------------------
// Phase 5bbd — Complex while patterns
// ---------------------------------------------------------------------------
test("Phase 5bbd: accumulate running sum stopping when over threshold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // Start at 1, add 1 each iteration; stop when total > 10
  // 0+1=1, 1+2=3, 3+3=6, 6+4=10, 10+5=15 > 10 → stop at i=5, total=15, count=5
  src := "(i : i32) = i32(1);\n(total : i32) = i32(0);\nwhile((total <= i32(10)), {\ntotal = (total + i);\ni = (i + i32(1));\n});\nexport(i);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "6"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bbd: GCD via Euclidean algorithm in while loop", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // GCD(56, 14) = 14
  src := "(a : i32) = i32(56);\n(b : i32) = i32(14);\nwhile((b != i32(0)), {\n(temp : i32) = b;\nb = (a % b);\na = temp;\n});\nexport(a);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "14", "14"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bbd: alternating add and multiply in while", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // Start acc=1, i=0..3; even i: acc+=i, odd i: acc*=2
  // i=0: acc=1+0=1, i=1: acc=1*2=2, i=2: acc=2+2=4, i=3: acc=4*2=8
  src := "(acc : i32) = i32(1);\n(i : i32) = i32(0);\nwhile((i < i32(4)), {\nacc = cond(((i % i32(2)) == i32(0)) => (acc + i), true => (acc * i32(2)));\ni = (i + i32(1));\n});\nexport(acc);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "8", "8"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bbd: count iterations until product exceeds 100", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // prod=1; multiply by 2 each step; prod>100 after 7 steps (2^7=128)
  src := "(prod : i32) = i32(1);\n(steps : i32) = i32(0);\nwhile((prod <= i32(100)), {\nprod = (prod * i32(2));\nsteps = (steps + i32(1));\n});\nexport(steps);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "7", "7"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5bbe — Grand combos: mixed pipelines and composed patterns
// ---------------------------------------------------------------------------
test("Phase 5bbe: map squares then filter by threshold then fold sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,2,3,4,5] squares=[1,4,9,16,25] filter>5=[9,16,25] sum=50
  src := "nums := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nsquares := nums.map((fn(x : i32) -> i32)((x * x)));\nlarge := squares.filter((fn(x : i32) -> bool)((x > i32(5))));\nexport(large.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x))));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "50", "50"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bbe: while builds array of squares then sum via fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
