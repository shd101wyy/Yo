/// Tests for yo-self/evaluator/exprs/initialization_assignment.yo — Phase 2w
///
/// Covers:
///   - Invalid shape (not `:=` or `::`) throws
///   - `name := rhs` — runtime variable declaration, variable added to env
///   - `name :: rhs` — compile-time constant declaration, variable added
///   - `_ := rhs` — discard: renamed to temp var (ExprInfo.variable_name set)
///   - `name := handler` — given wrapper detection
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{
  AstExpr,
  ast_expr_id,
  BK_INIT_ASSIGN,
  BK_CONST,
  BK_GIVEN,
  make_err_expr
} :: import("../expr.yo");
{ ExprInfo, new_expr_info, expr_info_table_set, expr_info_table_get } :: import("../expr_info.yo");
{ Environment, Variable, add_variable_to_env } :: import("../env.yo");
{ EvalContext, eval_context_new } :: import("../evaluator/context.yo");
{ EvalValue } :: import("../value.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ t_bool, t_i32, t_unit } :: import("../types/creators.yo");
{ set_evaluate_expression_fn, set_evaluate_expression_raw_fn } :: import("../evaluator/exprs/expr.yo");
{ evaluate_initialization_assignment } :: import("../evaluator/exprs/initialization_assignment.yo");
{ Exception } :: import("std/error");
// ---------------------------------------------------------------------------
// Helpers — shared across all tests
// ---------------------------------------------------------------------------
mk_token :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);
mk_ident :: (fn(id : usize, name : str) -> AstExpr)(
  AstExpr.Atom(id, mk_token(TokenKind.Identifier, name))
);
mk_op_atom :: (fn(id : usize, op : str) -> AstExpr)(
  AstExpr.Atom(id, mk_token(TokenKind.Operator, op))
);
/// Build `op(args…)` FnCall — callee is Atom with an Operator token.
mk_op_call :: (fn(id : usize, op : str, args : ArrayList(AstExpr)) -> AstExpr)({
  callee := mk_op_atom(id + usize(10000), op);
  AstExpr.FnCall(id, callee, args, true, mk_token(TokenKind.Operator, op))
});
/// Build `name(args…)` FnCall — callee is Atom with an Identifier token.
mk_ident_call :: (fn(id : usize, name : str, args : ArrayList(AstExpr)) -> AstExpr)({
  callee := mk_ident(id + usize(10000), name);
  AstExpr.FnCall(id, callee, args, false, mk_token(TokenKind.Identifier, name))
});
/// Build `lhs := rhs` initialization assignment expression.
mk_init_assign :: (fn(id : usize, lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  mk_op_call(id, BK_INIT_ASSIGN, args)
});
/// Build `lhs :: rhs` const declaration expression.
mk_const :: (fn(id : usize, lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  mk_op_call(id, BK_CONST, args)
});
/// Stub evaluator: stores t_bool() + BoolVal(true) ExprInfo for any expr.
stub_eval_bool :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext
  ) -> AstExpr
)({
  info := new_expr_info(env, t_bool());
  info.value = Option(EvalValue).Some(EvalValue.BoolVal(true));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
/// Raw-seam variant of stub_eval_bool (ignores the custom handler).
stub_eval_bool_raw :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)(
  stub_eval_bool(expr, env, ctx)
);
/// Stub evaluator: stores t_i32() + IntLit("42") ExprInfo for any expr.
stub_eval_i32 :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext
  ) -> AstExpr
)({
  info := new_expr_info(env, t_i32());
  info.value = Option(EvalValue).Some(EvalValue.IntLit(String.from("42")));
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
// ---------------------------------------------------------------------------
// evaluate_initialization_assignment — error cases
// ---------------------------------------------------------------------------
/// Returns true iff evaluate_initialization_assignment throws on invalid shape.
test_invalid_shape_throws :: (fn() -> bool)({
  set_evaluate_expression_fn(stub_eval_bool);
  set_evaluate_expression_raw_fn(stub_eval_bool_raw);
  exn := Exception(
    throw : (
      (err) -> {
        unwind(true);
      }
    )
  );
  ctx := eval_context_new(String.from("/std"), String.from("test"));
  (env : Environment) = Environment.new(String.from("test"));
  env.push_frame(false);
  // Build a plain assignment `=` (not `:=` or `::`) — invalid for this handler.
  lhs := mk_ident(usize(1), "x");
  rhs := mk_ident(usize(2), "true");
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  expr := mk_op_call(usize(10), "=", args);
  _r := evaluate_initialization_assignment(expr, env, ctx, exn);
  false
});
test("init_assign: invalid shape (not := or ::) throws", {
  assert(test_invalid_shape_throws(), "expected error for invalid shape");
});
// ---------------------------------------------------------------------------
// evaluate_initialization_assignment — happy path :=
// ---------------------------------------------------------------------------
test("init_assign: name := rhs adds variable to env", {
  set_evaluate_expression_fn(stub_eval_bool);
  set_evaluate_expression_raw_fn(stub_eval_bool_raw);
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  ctx := eval_context_new(String.from("/std"), String.from("test"));
  (env : Environment) = Environment.new(String.from("test"));
  env.push_frame(false);
  lhs := mk_ident(usize(3), "myvar");
  rhs := mk_ident(usize(4), "true");
  expr := mk_init_assign(usize(20), lhs, rhs);
  result := evaluate_initialization_assignment(expr, env, ctx, exn);
  // Variable should be findable in env.
  var_opt := env.lookup(String.from("myvar"));
  match(
    var_opt,
    .Some(v) => {
      assert(v.name == String.from("myvar"), "variable name should be myvar");
      assert(v.is_reassignable, "variable should be reassignable");
    },
    .None => assert(false, "variable myvar not found in env")
  );
  // ExprInfo for the whole expression should be set.
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(result));
  match(
    info_opt,
    .Some(_) => (),
    .None => assert(false, "ExprInfo not set for init assign result")
  );
});
// ---------------------------------------------------------------------------
// evaluate_initialization_assignment — happy path ::
// ---------------------------------------------------------------------------
test("init_assign: name :: rhs adds non-reassignable variable to env", {
  set_evaluate_expression_fn(stub_eval_bool);
  set_evaluate_expression_raw_fn(stub_eval_bool_raw);
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  ctx := eval_context_new(String.from("/std"), String.from("test"));
  (env : Environment) = Environment.new(String.from("test"));
  env.push_frame(false);
  lhs := mk_ident(usize(5), "constvar");
  rhs := mk_ident(usize(6), "true");
  expr := mk_const(usize(30), lhs, rhs);
  result := evaluate_initialization_assignment(expr, env, ctx, exn);
  var_opt := env.lookup(String.from("constvar"));
  match(
    var_opt,
    .Some(v) => {
      assert(v.name == String.from("constvar"), "variable name should be constvar");
      // Both := and :: create reassignable variables; :: sets is_compile_time_only.
      assert(v.is_reassignable, "variable should be reassignable (:: sets is_compile_time_only instead)");
      assert(v.is_compile_time_only, "const variable should be compile-time only");
    },
    .None => assert(false, "variable constvar not found in env")
  );
});
// ---------------------------------------------------------------------------
// evaluate_initialization_assignment — discard `_ :=`
// ---------------------------------------------------------------------------
test("init_assign: rhs renames to temp var", {
  set_evaluate_expression_fn(stub_eval_bool);
  set_evaluate_expression_raw_fn(stub_eval_bool_raw);
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  ctx := eval_context_new(String.from("/std"), String.from("test"));
  (env : Environment) = Environment.new(String.from("test"));
  env.push_frame(false);
  // `_` as LHS should be renamed to a temp variable name.
  lhs := mk_ident(usize(7), "_");
  rhs := mk_ident(usize(8), "true");
  expr := mk_init_assign(usize(40), lhs, rhs);
  result := evaluate_initialization_assignment(expr, env, ctx, exn);
  // ExprInfo for the result should record a variable_name (the temp name).
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(result));
  match(
    info_opt,
    .Some(info) => match(
      info.variable_name,
      .Some(vn) => assert(!(vn == String.from("_")), "temp var should not be named _"),
      .None => () // also acceptable — temp var name may be stored on lhs ExprInfo
    ),
    .None => assert(false, "ExprInfo not set for _ init assign result")
  );
});
// NOTE: Duplicate variable declaration error is not yet tested here because
// yo-self's add_variable_to_env does not yet implement the shadowing check
// (Phase 2w limitation). The TS evaluator throws "Variable X is already
// defined here" inside addVariableToEnv. This will be added once env.yo
// gains exception-throwing support in add_variable_to_env.
