/// Tests for yo-self/codegen/utils/fixup.yo.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue, t_i32 } :: import("../types/type.yo");
{ type_to_string } :: import("../types/string.yo");
{ EvalValue } :: import("../value.yo");
{ CodegenContext, CodegenTypeEntry, CodegenDynImplEntry } :: import("../codegen/context.yo");
{ fixup_dyn_impl_keys } :: import("../codegen/utils/fixup.yo");
mk_struct :: (fn(name : str) -> TypeValue)(
  TypeValue.Struct(
    String.from(""),
    String.from(name),
    ArrayList(String).new(),
    ArrayList(TypeValue).new(),
    true,
    false,
    false
  )
);
mk_dyn :: (fn() -> TypeValue)({
  empty := ArrayList(TypeValue).new();
  empty_levels := ArrayList(usize).new();
  TypeValue.DynT(empty, empty_levels, empty.clone(), empty_levels.clone())
});
install_type :: (
  fn(ctx : *(CodegenContext), ty : TypeValue, c_name : str) -> unit
)({
  entry := CodegenTypeEntry(type_value : ty, c_name : String.from(c_name));
  _ := ctx.*.types.set(type_to_string(ty), entry);
});
test("fixup_dyn_impl_keys: rebuilds keys with C-name form", {
  ctx := CodegenContext.new();
  obj := mk_struct("Counter");
  install_type(&(ctx), obj, "yo_counter");
  dyn_ty := mk_dyn();
  install_type(&(ctx), dyn_ty, "yo_dyn_show");
  // Insert an entry under a non-canonical key.
  entry := CodegenDynImplEntry(
    dyn_type : dyn_ty,
    concrete_type : obj,
    data_type : obj,
    trait_values : ArrayList(EvalValue).new()
  );
  _ := ctx.dyn_impls.set(String.from("legacy_key_v0"), entry);
  fixup_dyn_impl_keys(&(ctx));
  // After fixup the canonical key is present...
  assert(
    ctx.dyn_impls.get(String.from("yo_counter_yo_dyn_show")).is_some(),
    "canonical key registered"
  );
  // ...and the legacy key is gone.
  assert(
    ctx.dyn_impls.get(String.from("legacy_key_v0")).is_none(),
    "legacy key dropped"
  );
});
test("fixup_dyn_impl_keys: empty map is a no-op", {
  ctx := CodegenContext.new();
  fixup_dyn_impl_keys(&(ctx));
  assert(ctx.dyn_impls.len() == usize(0), "still empty");
});
test("fixup_dyn_impl_keys: idempotent on canonical keys", {
  ctx := CodegenContext.new();
  obj := mk_struct("Counter");
  install_type(&(ctx), obj, "yo_counter");
  dyn_ty := mk_dyn();
  install_type(&(ctx), dyn_ty, "yo_dyn_show");
  entry := CodegenDynImplEntry(
    dyn_type : dyn_ty,
    concrete_type : obj,
    data_type : obj,
    trait_values : ArrayList(EvalValue).new()
  );
  canonical_key := String.from("yo_counter_yo_dyn_show");
  _ := ctx.dyn_impls.set(canonical_key, entry);
  fixup_dyn_impl_keys(&(ctx));
  // Same key present, same length (1).
  assert(ctx.dyn_impls.len() == usize(1), "still one entry");
  assert(
    ctx.dyn_impls.get(canonical_key).is_some(),
    "key unchanged"
  );
});
