  src := "ii := i32(0);\nresult := i32(0);\nwhile((ii < i32(9)), {\nval := ((ii + i32(1)) * i32(10));\nresult = (result + cond(((ii % i32(3)) == i32(0)) => val, true => i32(0)));\nii = (ii + i32(1));\n});\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
