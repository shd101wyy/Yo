  src := "a := [i32(1),i32(2),i32(3)];\nb := [i32(4),i32(5),i32(6)];\nab := a.zip(b);\ndot := ab.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)((acc + (p.0 * p.1))));\nks := [i32(1),i32(2),i32(3),i32(4),i32(5)];\nkcount := ks.filter((fn(k : i32) -> bool)((((k * k) + i32(1)) % i32(5)) == i32(0))).fold(i32(0), (fn(acc : i32, k_unused : i32) -> i32)((acc + i32(1))));\nfact := i32(1);\nii := i32(1);\nwhile((ii <= i32(4)), {\nfact = (fact * ii);\nii = (ii + i32(1));\n});\ntotal := ((dot + kcount) + fact);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "58", "58"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
