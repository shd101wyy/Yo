// ---------------------------------------------------------------------------
// Phase 5bne — grand combo finale tests
// ---------------------------------------------------------------------------
test("Phase 5bne: matrix trace + dot product + while-power grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // trace(2x2 identity×2) = 2+2=4; dot [1,2]·[3,4]=11; 2^5=32; total=47
  src := "c00 := ((i32(1) * i32(2)) + (i32(0) * i32(0)));\nc11 := ((i32(0) * i32(0)) + (i32(1) * i32(2)));\ntrace := (c00 + c11);\na := [i32(1),i32(2)];\nb := [i32(3),i32(4)];\nab := a.zip(b);\ndot := ab.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)((acc + (p.0 * p.1))));\npow := i32(1);\nnn := i32(0);\nwhile((nn < i32(5)), {\npow = (pow * i32(2));\nnn = (nn + i32(1));\n});\ntotal := ((trace + dot) + pow);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
