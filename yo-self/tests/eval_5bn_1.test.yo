});

// ---------------------------------------------------------------------------
// Phase 5bnb — number-theory / digit patterns
// ---------------------------------------------------------------------------
test("Phase 5bnb: sum of array lengths that are prime", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // lengths [2,3,5,3,4,6]; primes: 2,3,5,3; sum=13
  src := "lens := [i32(2),i32(3),i32(5),i32(3),i32(4),i32(6)];\nresult := lens.filter((fn(n : i32) -> bool)(cond((n == i32(2)) => true, (n == i32(3)) => true, (n == i32(5)) => true, (n == i32(7)) => true, true => false))).fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "13", "13"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bnb: sum of two-digit numbers with odd digit sum", {
  env := empty_env();
