  src := "a := [i32(5),i32(3),i32(7)];\nb := [i32(2),i32(1),i32(4)];\nab := a.zip(b);\nresult := ab.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)((acc + ((p.0 - p.1) * (p.0 - p.1)))));\nexport(result);\n";
