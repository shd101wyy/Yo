        assert(false, "e");
        escape(());
      }
    )
  );
  // nums [12,13,21,31,42]; digit sums 3,4,3,4,6; odd: 12,21; sum=33
  src := "nums := [i32(12),i32(13),i32(21),i32(31),i32(42)];\nresult := nums.filter((fn(n : i32) -> bool)(((((n / i32(10)) + (n % i32(10))) % i32(2)) == i32(1)))).fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(result);\n";
