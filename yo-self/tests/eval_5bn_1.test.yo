        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bne: mega grand combo — matrix-trace + prime-filter + factorial + dot", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // trace=69; prime sum of [2,3,4,5,6]=10; 3!=6; dot [1,1,1]·[7,8,9]=24; total=109
  src := "a0 := [i32(1),i32(2)];\na1 := [i32(3),i32(4)];\nb0 := [i32(5),i32(7)];\nb1 := [i32(6),i32(8)];\nc00 := ((a0.get(usize(0)).unwrap() * b0.get(usize(0)).unwrap()) + (a0.get(usize(1)).unwrap() * b0.get(usize(1)).unwrap()));\nc11 := ((a1.get(usize(0)).unwrap() * b1.get(usize(0)).unwrap()) + (a1.get(usize(1)).unwrap() * b1.get(usize(1)).unwrap()));\ntrace := (c00 + c11);\nmixed := [i32(2),i32(3),i32(4),i32(5),i32(6)];\nprime_sum := mixed.filter((fn(nv : i32) -> bool)(cond((nv == i32(2)) => true, (nv == i32(3)) => true, (nv == i32(5)) => true, true => false))).fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nfact := i32(1);\nii := i32(1);\nwhile((ii <= i32(3)), {\nfact = (fact * ii);\nii = (ii + i32(1));\n});\nu := [i32(1),i32(1),i32(1)];\nv := [i32(7),i32(8),i32(9)];\nuv := u.zip(v);\ndot := uv.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)((acc + (p.0 * p.1))));\ntotal := (((trace + prime_sum) + fact) + dot);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "109", "109"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
