// @skip_wasm32-emscripten
// @skip_wasm32-wasi
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
empty_env :: (fn() -> Environment)(Environment.new(`test`));

// ---------------------------------------------------------------------------
// Phase 5bna — matrix-like / dot product patterns
// ---------------------------------------------------------------------------
test("Phase 5bna: 2x2 matrix multiply trace (via parallel arrays)", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // A=[[1,2],[3,4]], B=[[5,6],[7,8]]
  // C[0][0]=1*5+2*7=19, C[1][1]=3*6+4*8=50, trace=69
  src := "a0 := [i32(1), i32(2)];\na1 := [i32(3), i32(4)];\nb0 := [i32(5), i32(7)];\nb1 := [i32(6), i32(8)];\nc00 := ((a0.get(usize(0)).unwrap() * b0.get(usize(0)).unwrap()) + (a0.get(usize(1)).unwrap() * b0.get(usize(1)).unwrap()));\nc11 := ((a1.get(usize(0)).unwrap() * b1.get(usize(0)).unwrap()) + (a1.get(usize(1)).unwrap() * b1.get(usize(1)).unwrap()));\ntrace := (c00 + c11);\nexport(trace);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "69", "69"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bna: 2x2 matrix determinant A=[[4,3],[2,1]]", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // det = 4*1 - 3*2 = -2; abs = 2
  src := "det := ((i32(4) * i32(1)) - (i32(3) * i32(2)));\nabs_det := cond((det < i32(0)) => (i32(0) - det), true => det);\nexport(abs_det);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bna: dot product [1,3,5] · [2,4,6]", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 1*2+3*4+5*6=2+12+30=44
  src := "a := [i32(1),i32(3),i32(5)];\nb := [i32(2),i32(4),i32(6)];\nab := a.zip(b);\ndot := ab.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)((acc + (p.0 * p.1))));\nexport(dot);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "44", "44"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bna: sum of squares of differences [5,3,7] - [2,1,4]", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
