test("Phase 5bnc: alternating-sign sum [1..6] abs value", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 1-2+3-4+5-6 = -3; abs = 3
  src := "sign := i32(1);\nresult := i32(0);\nii := i32(1);\nwhile((ii <= i32(6)), {\nresult = (result + (sign * ii));\nsign = (i32(0) - sign);\nii = (ii + i32(1));\n});\nabs_result := cond((result < i32(0)) => (i32(0) - result), true => result);\nexport(abs_result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bnc: sum of elements at indices divisible by 3", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
