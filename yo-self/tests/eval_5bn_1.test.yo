      _ => assert(false, "m")
    )
  );
});
test("Phase 5bnb: while — first n where n! exceeds 1000", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // product updates before n increments; after p=5040>1000, n=8
  src := "n := i32(1);\np := i32(1);\nwhile((p <= i32(1000)), {\np = (p * n);\nn = (n + i32(1));\n});\nexport(n);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "8", "8"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
