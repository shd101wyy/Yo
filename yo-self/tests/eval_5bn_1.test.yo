test("Phase 5bnd: abs(det) + proper-divs(6) + 2^3 grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // abs(det([[4,3],[2,1]]))=2, proper-divs(6)=1+2+3=6, 2^3=8; total=16
  src := "det := ((i32(4) * i32(1)) - (i32(3) * i32(2)));\nabs_det := cond((det < i32(0)) => (i32(0) - det), true => det);\npdiv_sum := i32(0);\nd := i32(1);\nwhile((d < i32(6)), {\npdiv_sum = (pdiv_sum + cond(((i32(6) % d) == i32(0)) => d, true => i32(0)));\nd = (d + i32(1));\n});\npow := i32(1);\nnn := i32(0);\nwhile((nn < i32(3)), {\npow = (pow * i32(2));\nnn = (nn + i32(1));\n});\ntotal := ((abs_det + pdiv_sum) + pow);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "16", "16"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bnd: dot product + count-k-where-k^2+1-div5 + factorial grand combo", {
  env := empty_env();
