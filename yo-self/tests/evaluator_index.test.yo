/// Tests for Phase 2i: `yo-self/evaluator/index.yo`
///
/// Covers:
///   - `has_comment_attribute` (token list scanning)
///   - `Evaluator.new` with skip-prelude sources (avoids needing a real std dir)
///
/// Note: This file does NOT use the skip-prelude directive — the test binary
/// needs the prelude for the `test` keyword and Io injection. The sources
/// passed to `Evaluator.new` carry their own skip-prelude directives.
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ EvalValue } :: import("../value.yo");
{ has_comment_attribute, Evaluator } :: import("../evaluator/index.yo");
{ assert, panic } :: import("std/assert");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
make_token :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("<test>"),
    input : String.from("")
  )
);
make_comment :: (fn(text : str) -> Token)(
  make_token(TokenKind.SingleLineComment, text)
);
noop_loader :: (fn(_path : String) -> Option(EvalValue))(
  Option(EvalValue).None
);
// ---------------------------------------------------------------------------
// has_comment_attribute
// ---------------------------------------------------------------------------
test("has_comment_attribute: returns false for empty list", {
  toks := ArrayList(Token).new();
  result := has_comment_attribute(toks, `@skip_prelude`);
  assert(!(result), "expected false for empty token list");
});
test("has_comment_attribute: returns false when no comments", {
  toks := ArrayList(Token).new();
  toks.push(make_token(TokenKind.Identifier, "hello"));
  toks.push(make_token(TokenKind.Integer, "42"));
  result := has_comment_attribute(toks, `@skip_prelude`);
  assert(!(result), "expected false when no comment tokens");
});
test("has_comment_attribute: returns false when comment missing attribute", {
  toks := ArrayList(Token).new();
  toks.push(make_comment("// some comment"));
  result := has_comment_attribute(toks, `@skip_prelude`);
  assert(!(result), "expected false when attribute absent");
});
test("has_comment_attribute: returns true for SingleLineComment with attribute", {
  toks := ArrayList(Token).new();
  toks.push(make_comment("// @skip_prelude"));
  result := has_comment_attribute(toks, `@skip_prelude`);
  assert(result, "expected true for SingleLineComment containing @skip_prelude");
});
test("has_comment_attribute: returns true for MultiLineComment with attribute", {
  toks := ArrayList(Token).new();
  toks.push(make_token(TokenKind.MultiLineComment, "/* @skip_prelude */"));
  result := has_comment_attribute(toks, `@skip_prelude`);
  assert(result, "expected true for MultiLineComment containing @skip_prelude");
});
test("has_comment_attribute: returns false for DocLineComment with attribute", {
  toks := ArrayList(Token).new();
  toks.push(make_token(TokenKind.DocLineComment, "/// @skip_prelude"));
  result := has_comment_attribute(toks, `@skip_prelude`);
  assert(!(result), "expected false: doc comments are excluded from attribute scan");
});
test("has_comment_attribute: returns false for InnerDocLineComment with attribute", {
  toks := ArrayList(Token).new();
  toks.push(make_token(TokenKind.InnerDocLineComment, "//! @skip_prelude"));
  result := has_comment_attribute(toks, `@skip_prelude`);
  assert(!(result), "expected false: doc comments are excluded from attribute scan");
});
test("has_comment_attribute: returns false for DocBlockComment with attribute", {
  toks := ArrayList(Token).new();
  toks.push(make_token(TokenKind.DocBlockComment, "/** @skip_prelude */"));
  result := has_comment_attribute(toks, `@skip_prelude`);
  assert(!(result), "expected false: doc comments are excluded from attribute scan");
});
test("has_comment_attribute: returns false for InnerDocBlockComment with attribute", {
  toks := ArrayList(Token).new();
  toks.push(make_token(TokenKind.InnerDocBlockComment, "/*! @skip_prelude */"));
  result := has_comment_attribute(toks, `@skip_prelude`);
  assert(!(result), "expected false: doc comments are excluded from attribute scan");
});
test("has_comment_attribute: finds attribute in later token", {
  toks := ArrayList(Token).new();
  toks.push(make_token(TokenKind.Identifier, "x"));
  toks.push(make_comment("// ordinary comment"));
  toks.push(make_comment("// @skip_prelude here"));
  result := has_comment_attribute(toks, `@skip_prelude`);
  assert(result, "expected true — attribute present in third token");
});
test("has_comment_attribute: returns true for custom attribute", {
  toks := ArrayList(Token).new();
  toks.push(make_comment("// @my_custom_attr"));
  result := has_comment_attribute(toks, `@my_custom_attr`);
  assert(result, "expected true for custom attribute");
});
test("has_comment_attribute: returns false for different attribute", {
  toks := ArrayList(Token).new();
  toks.push(make_comment("// @other_attr"));
  result := has_comment_attribute(toks, `@skip_prelude`);
  assert(!(result), "expected false when only a different attribute is present");
});
// ---------------------------------------------------------------------------
// Evaluator.new — basic smoke tests with skip-prelude sources
// ---------------------------------------------------------------------------
test("Evaluator.new: empty source with skip_prelude", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  eval := Evaluator.new(
    String.from("<test>"),
    String.from("<no-std>"),
    noop_loader,
    String.from("pragma(Pragma.SkipPrelude);\n"),
    exn
  );
  // Should parse and evaluate without error.
  match(
    eval.get_module_error(),
    .Some(_err) => {
      assert(false, "unexpected module_error");
    },
    .None => ()
  );
});
test("Evaluator.new: simple binding with skip_prelude", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  // `x :: 42` (comptime) — TS rejects exporting a runtime `:=` binding
  // ("not a compile-time variable"), and the Evaluator now evaluates through
  // the real module evaluator, matching that semantics.
  src := String.from("pragma(Pragma.SkipPrelude);\nx :: 42;\nexport(x);\n");
  eval := Evaluator.new(
    String.from("<test>"),
    String.from("<no-std>"),
    noop_loader,
    src,
    exn
  );
  match(
    eval.get_module_error(),
    .Some(_err) => {
      assert(false, "unexpected module_error");
    },
    .None => ()
  );
  // Should have produced a module value.
  match(
    eval.get_module_value(),
    .Some(_) => (),
    .None => {
      assert(false, "expected module_value to be present");
    }
  );
});
test("Evaluator.new: get_tokens returns non-empty list", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  src := String.from("pragma(Pragma.SkipPrelude);\nx := 42;\n");
  eval := Evaluator.new(
    String.from("<test>"),
    String.from("<no-std>"),
    noop_loader,
    src,
    exn
  );
  toks := eval.get_tokens();
  assert(toks.len() > usize(0), "expected non-empty token list");
});
test("Evaluator.new: get_program returns non-empty AST", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  src := String.from("pragma(Pragma.SkipPrelude);\nx := 42;\n");
  eval := Evaluator.new(
    String.from("<test>"),
    String.from("<no-std>"),
    noop_loader,
    src,
    exn
  );
  prog := eval.get_program();
  assert(prog.len() > usize(0), "expected non-empty program");
});
test("Evaluator.new: get_env returns Some environment", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  src := String.from("pragma(Pragma.SkipPrelude);\n");
  eval := Evaluator.new(
    String.from("<test>"),
    String.from("<no-std>"),
    noop_loader,
    src,
    exn
  );
  match(
    eval.get_env(),
    .Some(_) => (),
    .None => {
      assert(false, "expected get_env to return(Some)");
    }
  );
});
test("Evaluator.new: module_value contains exported name", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  // `msg :: 99` (comptime) — TS rejects exporting a runtime `:=` binding.
  src := String.from("pragma(Pragma.SkipPrelude);\nmsg :: 99;\nexport(msg);\n");
  eval := Evaluator.new(
    String.from("<test>"),
    String.from("<no-std>"),
    noop_loader,
    src,
    exn
  );
  match(
    eval.get_module_value(),
    .Some(mv) =>
      match(
        mv,
        .StructVal(_, names, _values) => {
          (found : bool) = false;
          (i : usize) = usize(0);
          n := names.len();
          while(i < n, {
            match(
              names.get(i),
              .Some(nm) => {
                if(nm == String.from("msg"), {
                  found = true;
                });
              },
              .None => ()
            );
            i = (i + usize(1));
          });
          assert(found, "expected 'msg' in exported names");
        },
        _ => {
          assert(false, "expected module StructVal");
        }
      ),
    .None => {
      assert(false, "expected module_value");
    }
  );
});
