test("Phase 5gn: catalan numbers iterative", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "catalan := (fn(n : i32) -> i32)({\narr := ArrayList(i32).new();\narr.push(i32(1));\narr.push(i32(1));\n(i : i32) = i32(2);\nwhile((i <= n), {\n(sum : i32) = i32(0);\n(j : i32) = i32(0);\nwhile((j < i), {\na := match(arr.get(j.to_usize()), .Some(v) => v, .None => i32(0));\nb := match(arr.get(((i - i32(1)) - j).to_usize()), .Some(v) => v, .None => i32(0));\nsum = (sum + (a * b));\nj = (j + i32(1));\n});\narr.push(sum);\ni = (i + i32(1));\n});\nmatch(arr.get(n.to_usize()), .Some(v) => v, .None => i32(0))\n});\nexport(catalan(i32(4)));\nexport(catalan(i32(5)));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "14", "C(4)=14"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "42", "C(5)=42"), _ => assert(false, "t")),.None => assert(false, "v"));
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5gn: array remove duplicates keep first", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(1), i32(2), i32(3), i32(2), i32(1), i32(4), i32(3)];\nunique := ArrayList(i32).new();\nfor(x, arr, {\ncond(!(unique.contains(x)) => unique.push(x), true => ());\n});\nexport(unique.len());\nexport(match(unique.first(), .Some(v) => v, .None => i32(0)));\nexport(match(unique.last(), .Some(v) => v, .None => i32(0)));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "4 unique"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "first=1"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(2)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "last=4"), _ => assert(false, "t")),.None => assert(false, "v"));
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5gn: iterative lucas numbers", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "lucas := (fn(n : i32) -> i32)({\n(a : i32) = i32(2);\n(b : i32) = i32(1);\ncond((n == i32(0)) => a, (n == i32(1)) => b, true => {\n(i : i32) = i32(2);\nwhile((i <= n), {\n(temp : i32) = (a + b);\na = b;\nb = temp;\ni = (i + i32(1));\n});\nb\n})\n});\nexport(lucas(i32(0)));\nexport(lucas(i32(5)));\nexport(lucas(i32(10)));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "L(0)=2"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "11", "L(5)=11"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(2)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "123", "L(10)=123"), _ => assert(false, "t")),.None => assert(false, "v"));
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5gn: string index of all occurrences", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := \"abcabcabc\";\npattern := \"abc\";\n(count : i32) = i32(0);\n(i : i32) = i32(0);\nwhile(((i + pattern.len()) <= s.len()), {\n(match_found : bool) = true;\n(j : i32) = i32(0);\nwhile((j < pattern.len()), {\ncond((s.char_at((i + j).to_usize()) != pattern.char_at(j.to_usize())) => { match_found = false; j = pattern.len(); }, true => ());\nj = (j + i32(1));\n});\ncond(match_found => { count = (count + i32(1)); i = (i + pattern.len()); }, true => { i = (i + i32(1)); });\n});\nexport(count);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result,.None => assert(false, "N"),.Some(m) => match(m,.ModuleVal(_, v) => match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3 occurrences"), _ => assert(false, "t")),.None => assert(false, "v")), _ => assert(false, "m")));
});
test("Phase 5gn: array chunk sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8), i32(9)];\nchunk_size := i32(3);\nchunk_sums := ArrayList(i32).new();\n(i : i32) = i32(0);\nwhile((i < arr.len()), {\n(chunk_sum : i32) = i32(0);\n(j : i32) = i32(0);\nwhile(((j < chunk_size) && ((i + j) < arr.len())), {\nchunk_sum = (chunk_sum + match(arr.get((i + j).to_usize()), .Some(v) => v, .None => i32(0)));\nj = (j + i32(1));\n});\nchunk_sums.push(chunk_sum);\ni = (i + chunk_size);\n});\nexport(chunk_sums.len());\nexport(match(chunk_sums.first(), .Some(v) => v, .None => i32(0)));\nexport(match(chunk_sums.last(), .Some(v) => v, .None => i32(0)));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3 chunks"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "1+2+3=6"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(2)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "24", "7+8+9=24"), _ => assert(false, "t")),.None => assert(false, "v"));
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5gn: enum option chaining", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "Res := enum(Ok(i32), Err(i32));\nresult := Res.Ok(i32(42));\ndoubled := match(result, .Ok(v) => Res.Ok((v * i32(2))), .Err(e) => Res.Err(e));\nfinal_val := match(doubled, .Ok(v) => v, .Err(_) => i32(-(1)));\nexport(final_val);\nerr_result := Res.Err(i32(404));\nerr_doubled := match(err_result, .Ok(v) => Res.Ok((v * i32(2))), .Err(e) => Res.Err(e));\nerr_val := match(err_doubled, .Ok(v) => v, .Err(e) => e);\nexport(err_val);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
