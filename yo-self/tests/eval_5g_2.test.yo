test("Phase 5gu: collatz sequence length", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // NOTE: collatz_len(27) = 111 steps needs ~830 MB C stack through proto-evaluator.
  // Using collatz_len(6) only (8 steps, ~60 MB, fits in 256 MB macOS stack reserve).
  src := "collatz_len := (fn(n : i32) -> i32)(cond((n == i32(1)) => i32(0), ((n % i32(2)) == i32(0)) => (i32(1) + recur((n / i32(2)))), true => (i32(1) + recur(((i32(3) * n) + i32(1))))));\nexport(collatz_len(i32(6)));";
