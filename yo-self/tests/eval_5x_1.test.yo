// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5x series: array.concat, array.reverse,
/// array.slice, StrLit.as_bytes, StrLit.to_cstr, StrLit.replace,
/// StrLit.index_of, ArrayVal.find, and combos.
///
/// Phases covered:
///   5xa — ArrayVal.concat(other)
///   5xb — ArrayVal.reverse()
///   5xc — ArrayVal.slice(start, end)
///   5xd — StrLit.replace(old, new) and StrLit.index_of(needle)
///   5xe — StrLit.as_bytes() and StrLit.to_cstr()
///   5xf — ArrayVal.find(fn)
///   5xg — Combo tests
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5xa — ArrayVal.concat(other)
// ---------------------------------------------------------------------------
test("Phase 5xa: concat two non-empty arrays", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "a := [i32(1), i32(2)];\nb := [i32(3), i32(4)];\nc := a.concat(b);\nexport(c.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "4"), _ => assert(false, "t")),.None => assert(false, "v"));
      },
      _ => assert(false, "m")
    )
  );
});
