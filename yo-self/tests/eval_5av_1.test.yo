// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5av series: any/all predicates, join, substring,
/// parse_i64, replace_all, enumerate, zip, and mixed pipelines.
///
/// Phases covered:
///   5ava — Array any/all predicates
///   5avb — String join and substring
///   5avc — parse_i64 and replace_all
///   5avd — enumerate/zip lengths and zip with mismatched sizes
///   5ave — Mixed pipelines combining several methods
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5ava — any / all predicates
// ---------------------------------------------------------------------------
test("Phase 5ava: any with at least one matching element is true", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(1), i32(2), i32(5), i32(3)];\nb := arr.any((fn(x : i32) -> bool)((x > i32(4))));\nexport(b);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "true"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5ava: any with no matching element is false", {
  env := empty_env();
  given(exn) := Exception(
