test("Phase 5ave: substring then join two substrings equals combined", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := \"hello\";\npart1 := s.substring(i32(0), i32(2));\npart2 := s.substring(i32(3), i32(5));\narr := [part1, part2];\nr := arr.join(\"-\");\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .StrLit(raw) => assert(raw.as_str() == "\"he-lo\"", "he-lo"),
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
