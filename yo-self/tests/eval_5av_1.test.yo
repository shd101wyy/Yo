// ---------------------------------------------------------------------------
// Phase 5avb — String join and substring
// ---------------------------------------------------------------------------
test("Phase 5avb: join array of strings with comma separator", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [\"hello\", \"world\"];\nr := arr.join(\",\");\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .StrLit(raw) => assert(raw.as_str() == "\"hello,world\"", "hello,world"),
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

