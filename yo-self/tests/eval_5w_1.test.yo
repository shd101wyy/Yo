// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5w series: bitwise operators, extern/c_include/where/forall,
/// String.from, is_empty on arrays and strings.
///
/// Phases covered:
///   5wa — Bitwise operators: | & ^ << >>
///   5wb — extern / c_include / where / forall — all return UnitVal
///   5wc — String.from(str) — type constructor returning TypeVal
///   5wd — ArrayVal.is_empty() and StrLit.is_empty()
///   5we — Combos: bitwise in functions, extern+c_include, chained string checks
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5wa — Bitwise operators: | & ^ << >>
// ---------------------------------------------------------------------------
test("Phase 5wa: bitwise OR (5 | 3) = 7", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "x := (i32(5) | i32(3));\nexport(x);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "7", "7"), _ => assert(false, "t")),.None => assert(false, "v"));
      },
      _ => assert(false, "m")
    )
  );
});
