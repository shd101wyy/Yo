  src := "acc := i32(0);\ni := i32(0);\nwhile((i < i32(4)), { acc = (acc | (i32(1) << i)); i = (i + i32(1)); });\nexport(acc);\n";
  exprs := generate_exprs_from_code(src, using(exn));
