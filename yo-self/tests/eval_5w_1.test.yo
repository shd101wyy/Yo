// ---------------------------------------------------------------------------
// Phase 5wd — ArrayVal.is_empty() and StrLit.is_empty()
// ---------------------------------------------------------------------------
test("Phase 5wd: empty array is_empty() returns true", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [];\nb := arr.is_empty();\nexport(b);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(v.get(usize(0)),.Some(x) => match(x,.BoolVal(b) => assert(b, "should be true"), _ => assert(false, "t")),.None => assert(false, "v"));
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5wd: non-empty array is_empty() returns false", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
