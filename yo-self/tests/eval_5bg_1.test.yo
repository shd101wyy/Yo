    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "5"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
// ---------------------------------------------------------------------------
// Phase 5bgc — multi-array operations
// ---------------------------------------------------------------------------
test("Phase 5bgc: two arrays — filter one, map other, zip and fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[1,2,3,4], doubled=[2,4,6,8], filter a>=2=[2,3,4], filter doubled>=4=[4,6,8]
  // Just: map a to squares, fold → 1+4+9+16=30
  src := "a := [i32(1), i32(2), i32(3), i32(4)];\nb := [i32(10), i32(20), i32(30), i32(40)];\nasq := a.map((fn(x : i32) -> i32)((x * x)));\nbhalf := b.map((fn(x : i32) -> i32)((x / i32(2))));\ncombined := asq.zip(bhalf);\nsums := combined.map((fn(p : (i32, i32)) -> i32)((p.0 + p.1)));\ntotal := sums.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .IntLit(n) => assert(n.as_str() == "80", "80"),
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bgc: concat results of two maps", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[1,2,3] → doubled=[2,4,6] sum=12; b=[4,5,6] → tripled=[12,15,18] sum=45; total=57
  src := "a := [i32(1), i32(2), i32(3)];\nb := [i32(4), i32(5), i32(6)];\ndoubled := a.map((fn(x : i32) -> i32)((x * i32(2))));\ntripled := b.map((fn(x : i32) -> i32)((x * i32(3))));\nsum_a := doubled.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nsum_b := tripled.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\ntotal := (sum_a + sum_b);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
