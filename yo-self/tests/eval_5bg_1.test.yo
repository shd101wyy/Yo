});
test("Phase 5bgb: while count digits in number", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 12345 has 5 digits
  src := "n := i32(12345);\ncount := i32(0);\nwhile((n > i32(0)), {\nn = (n / i32(10));\ncount = (count + i32(1));\n});\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
