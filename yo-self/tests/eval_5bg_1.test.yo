  // count 3s in [1,3,2,3,4,3,5] = 3
  src := "arr := [i32(1), i32(3), i32(2), i32(3), i32(4), i32(3), i32(5)];\ncount := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)({\ncond((x == i32(3)) => (acc + i32(1)), true => acc)\n}));\nexport(count);\n";
