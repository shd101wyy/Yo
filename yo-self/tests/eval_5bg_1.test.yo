  src := "arr := [i32(3), i32(1), i32(7), i32(2), i32(9), i32(4)];\nmaximum := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)({\ncond((x > acc) => x, true => acc)\n}));\nexport(maximum);\n";
