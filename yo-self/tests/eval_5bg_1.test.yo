test("Phase 5bgd: sum of squares of evens", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1..8] → evens=[2,4,6,8] → squares=[4,16,36,64] → sum=120
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8)];\nevens := arr.filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(0))));\nsquares := evens.map((fn(x : i32) -> i32)((x * x)));\ntotal := squares.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "120", "120"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bgd: alternating sign sum via fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,2,3,4,5] alternating: 1-2+3-4+5=3
  // zip with signs [1,-1,1,-1,1], multiply, sum
  src := "vals := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nsigns := [i32(1), (i32(0)-i32(1)), i32(1), (i32(0)-i32(1)), i32(1)];\npairs := vals.zip(signs);\nproducts := pairs.map((fn(p : (i32, i32)) -> i32)((p.0 * p.1)));\ntotal := products.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bgd: sum of multiples of 3 or 5 below 20", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // multiples of 3 or 5 below 20: 3,5,6,9,10,12,15,18 → but careful with duplicates
  // 3+5+6+9+10+12+15+18=78
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8), i32(9), i32(10), i32(11), i32(12), i32(13), i32(14), i32(15), i32(16), i32(17), i32(18), i32(19)];\nfilt := arr.filter((fn(x : i32) -> bool)({\ncond(((x % i32(3)) == i32(0)) => true, ((x % i32(5)) == i32(0)) => true, true => false)\n}));\ntotal := filt.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "78", "78"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
