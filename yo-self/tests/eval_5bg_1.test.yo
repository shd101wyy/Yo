test("Phase 5bge: while build sum + array pipeline grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // while sum 1..5=15; arr=[1,2,3] → squares=[1,4,9] sum=14; total=15+14=29
  src := "i := i32(1);\nwhile_sum := i32(0);\nwhile((i <= i32(5)), {\nwhile_sum = (while_sum + i);\ni = (i + i32(1));\n});\narr := [i32(1), i32(2), i32(3)];\nsquares := arr.map((fn(x : i32) -> i32)((x * x)));\narr_sum := squares.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\ntotal := (while_sum + arr_sum);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "29", "29"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bge: zip + fold max-of-pair + let chain grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[3,7,2,9,1], b=[5,4,8,1,6] → max-of-pair=[5,7,8,9,6] → sum=35
  src := "a := [i32(3), i32(7), i32(2), i32(9), i32(1)];\nb := [i32(5), i32(4), i32(8), i32(1), i32(6)];\npairs := a.zip(b);\nmaxes := pairs.map((fn(p : (i32, i32)) -> i32)({\ncond((p.0 >= p.1) => p.0, true => p.1)\n}));\ntotal := maxes.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "35", "35"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bge: multi-filter + fold + while grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // arr=[1..10] → evens sum=30; while count of multiples of 3 up to 30: 3,6,9,12,...,30 → 10
  // total = 30 + 10 = 40
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8), i32(9), i32(10)];\nevens := arr.filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(0))));\neven_sum := evens.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nj := i32(3);\nmult3_count := i32(0);\nwhile((j <= i32(30)), {\nmult3_count = (mult3_count + i32(1));\nj = (j + i32(3));\n});\ntotal := (even_sum + mult3_count);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "40", "40"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bge: all-operations grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [2,3,4,5,6] → filter evens=[2,4,6] sum=12
  // zip [2,4,6] with [1,2,3] → products=[2,8,18] sum=28
  // grand total = 12 + 28 = 40... wait let me recalculate
  // actually zip [2,4,6] with [1,2,3]: pairs=(2,1),(4,2),(6,3) → products=2,8,18 → sum=28
  // grand total = 12 + 28 = 40
  src := "arr := [i32(2), i32(3), i32(4), i32(5), i32(6)];\nevens := arr.filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(0))));\neven_sum := evens.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nmults := [i32(1), i32(2), i32(3)];\npairs := evens.zip(mults);\nproducts := pairs.map((fn(p : (i32, i32)) -> i32)((p.0 * p.1)));\nprod_sum := products.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\ntotal := (even_sum + prod_sum);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "40", "40"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
