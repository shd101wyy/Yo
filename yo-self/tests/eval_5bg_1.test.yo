// Phase 5bgb — while + accumulator patterns
// ---------------------------------------------------------------------------
test("Phase 5bgb: while power — 2^8 = 256", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // compute 2^8 by repeated multiplication
  src := "result := i32(1);\ni := i32(0);\nwhile((i < i32(8)), {\nresult = (result * i32(2));\ni = (i + i32(1));\n});\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "256", "256"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
