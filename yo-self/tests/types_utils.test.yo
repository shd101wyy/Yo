/// Tests for `yo-self/types/utils.yo` — pointer size config, integer bit-width,
/// integer range, and comptime cast checks.
open(import("std/string"));
open(import("std/fmt"));
{ TypeValue } :: import("../types/definitions.yo");
{ t_i8, t_i16, t_i32, t_i64, t_u8, t_u16, t_u32, t_u64, t_usize, t_isize, t_bool, t_unit, t_f32, t_f64, t_comptime_int, t_comptime_float, t_comptime_string, t_some_t, t_array, t_iso, t_dyn_simple, t_future_trait_simple } :: import("../types/creators.yo");
{ Environment } :: import("../env.yo");
{ ArrayList } :: import("std/collections/array_list");
{ assert, panic } :: import("std/assert");
{
  IntRange,
  set_target_pointer_size,
  get_target_pointer_size_bits,
  get_target_pointer_size_bytes,
  get_integer_type_bits,
  get_integer_type_range,
  can_comptime_int_cast_to,
  can_comptime_float_cast_to,
  type_implements_runtime_builtin,
  type_implements_runtime,
  type_is_comptime_only,
  type_requires_comptime_modifier,
  type_prohibits_comptime_modifier,
  get_all_some_types,
  type_contains_rc_type
}
:: import("../types/utils.yo");
// ---------------------------------------------------------------------------
// Pointer size config
// ---------------------------------------------------------------------------
test("pointer size: default is 64 bits / 8 bytes", {
  assert(get_target_pointer_size_bits() == u32(64), "default bits");
  assert(get_target_pointer_size_bytes() == u32(8), "default bytes");
});
test("pointer size: set to 32 bits", {
  set_target_pointer_size(u32(32));
  assert(get_target_pointer_size_bits() == u32(32), "32 bits");
  assert(get_target_pointer_size_bytes() == u32(4), "4 bytes");
  // restore default
  set_target_pointer_size(u32(64));
});
test("pointer size: invalid (not div by 8) is ignored", {
  set_target_pointer_size(u32(64));
  set_target_pointer_size(u32(7)); // invalid — must be ignored
  assert(get_target_pointer_size_bits() == u32(64), "unchanged");
});
// ---------------------------------------------------------------------------
// get_integer_type_bits
// ---------------------------------------------------------------------------
test("get_integer_type_bits: i8 → 8", {
  b := get_integer_type_bits(t_i8());
  assert(b.is_some(), "i8 has bits");
  assert(b.unwrap() == u32(8), "i8 bits = 8");
});
test("get_integer_type_bits: u8 → 8", {
  b := get_integer_type_bits(t_u8());
  assert(b.is_some(), "u8 has bits");
  assert(b.unwrap() == u32(8), "u8 bits = 8");
});
test("get_integer_type_bits: i16 → 16", {
  b := get_integer_type_bits(t_i16());
  assert(b.is_some(), "i16 has bits");
  assert(b.unwrap() == u32(16), "i16 bits = 16");
});
test("get_integer_type_bits: u16 → 16", {
  b := get_integer_type_bits(t_u16());
  assert(b.is_some(), "u16 has bits");
  assert(b.unwrap() == u32(16), "u16 bits = 16");
});
test("get_integer_type_bits: i32 → 32", {
  b := get_integer_type_bits(t_i32());
  assert(b.is_some(), "i32 has bits");
  assert(b.unwrap() == u32(32), "i32 bits = 32");
});
test("get_integer_type_bits: u32 → 32", {
  b := get_integer_type_bits(t_u32());
  assert(b.is_some(), "u32 has bits");
  assert(b.unwrap() == u32(32), "u32 bits = 32");
});
test("get_integer_type_bits: i64 → 64", {
  b := get_integer_type_bits(t_i64());
  assert(b.is_some(), "i64 has bits");
  assert(b.unwrap() == u32(64), "i64 bits = 64");
});
test("get_integer_type_bits: u64 → 64", {
  b := get_integer_type_bits(t_u64());
  assert(b.is_some(), "u64 has bits");
  assert(b.unwrap() == u32(64), "u64 bits = 64");
});
test("get_integer_type_bits: usize → pointer size (64)", {
  set_target_pointer_size(u32(64));
  b := get_integer_type_bits(t_usize());
  assert(b.is_some(), "usize has bits");
  assert(b.unwrap() == u32(64), "usize bits = 64");
});
test("get_integer_type_bits: isize → pointer size (64)", {
  set_target_pointer_size(u32(64));
  b := get_integer_type_bits(t_isize());
  assert(b.is_some(), "isize has bits");
  assert(b.unwrap() == u32(64), "isize bits = 64");
});
test("get_integer_type_bits: bool → None", {
  assert(get_integer_type_bits(t_bool()).is_none(), "bool none");
});
test("get_integer_type_bits: f32 → None", {
  assert(get_integer_type_bits(t_f32()).is_none(), "f32 none");
});
// ---------------------------------------------------------------------------
// get_integer_type_range
// ---------------------------------------------------------------------------
test("get_integer_type_range: i8", {
  r := get_integer_type_range(t_i8());
  match(
    r,
    .Some(ir) => {
      assert(ir.min == i64(-(128)), "i8 min");
      assert(ir.max == u64(127), "i8 max");
    },
    .None => assert(false, "unreachable")
  );
});
test("get_integer_type_range: u8", {
  r := get_integer_type_range(t_u8());
  match(
    r,
    .Some(ir) => {
      assert(ir.min == i64(0), "u8 min");
      assert(ir.max == u64(255), "u8 max");
    },
    .None => assert(false, "unreachable")
  );
});
test("get_integer_type_range: i16", {
  r := get_integer_type_range(t_i16());
  match(
    r,
    .Some(ir) => {
      assert(ir.min == i64(-(32768)), "i16 min");
      assert(ir.max == u64(32767), "i16 max");
    },
    .None => assert(false, "unreachable")
  );
});
test("get_integer_type_range: u16", {
  r := get_integer_type_range(t_u16());
  match(
    r,
    .Some(ir) => {
      assert(ir.min == i64(0), "u16 min");
      assert(ir.max == u64(65535), "u16 max");
    },
    .None => assert(false, "unreachable")
  );
});
test("get_integer_type_range: i32", {
  r := get_integer_type_range(t_i32());
  match(
    r,
    .Some(ir) => {
      assert(ir.min == i64(-(2147483648)), "i32 min");
      assert(ir.max == u64(2147483647), "i32 max");
    },
    .None => assert(false, "unreachable")
  );
});
test("get_integer_type_range: u32", {
  r := get_integer_type_range(t_u32());
  match(
    r,
    .Some(ir) => {
      assert(ir.min == i64(0), "u32 min");
      assert(ir.max == u64(4294967295), "u32 max");
    },
    .None => assert(false, "unreachable")
  );
});
test("get_integer_type_range: i64", {
  r := get_integer_type_range(t_i64());
  match(
    r,
    .Some(ir) => {
      assert(ir.min == i64(-(9223372036854775808)), "i64 min");
      assert(ir.max == u64(9223372036854775807), "i64 max");
    },
    .None => assert(false, "unreachable")
  );
});
test("get_integer_type_range: u64", {
  r := get_integer_type_range(t_u64());
  match(
    r,
    .Some(ir) => {
      assert(ir.min == i64(0), "u64 min");
      assert(ir.max == u64(18446744073709551615), "u64 max");
    },
    .None => assert(false, "unreachable")
  );
});
test("get_integer_type_range: usize (64-bit)", {
  set_target_pointer_size(u32(64));
  r := get_integer_type_range(t_usize());
  match(
    r,
    .Some(ir) => {
      assert(ir.min == i64(0), "usize min");
      assert(ir.max == u64(18446744073709551615), "usize max");
    },
    .None => assert(false, "unreachable")
  );
});
test("get_integer_type_range: isize (64-bit)", {
  set_target_pointer_size(u32(64));
  r := get_integer_type_range(t_isize());
  match(
    r,
    .Some(ir) => {
      assert(ir.min == i64(-(9223372036854775808)), "isize min");
      assert(ir.max == u64(9223372036854775807), "isize max");
    },
    .None => assert(false, "unreachable")
  );
});
test("get_integer_type_range: bool → None", {
  r := get_integer_type_range(t_bool());
  assert(r.is_none(), "bool has no range");
});
test("get_integer_type_range: f64 → None", {
  r := get_integer_type_range(t_f64());
  assert(r.is_none(), "f64 has no range");
});
// ---------------------------------------------------------------------------
// can_comptime_int_cast_to
// ---------------------------------------------------------------------------
test("can_comptime_int_cast_to: integer types return(true)", {
  assert(can_comptime_int_cast_to(t_i8()), "i8");
  assert(can_comptime_int_cast_to(t_u8()), "u8");
  assert(can_comptime_int_cast_to(t_i16()), "i16");
  assert(can_comptime_int_cast_to(t_u16()), "u16");
  assert(can_comptime_int_cast_to(t_i32()), "i32");
  assert(can_comptime_int_cast_to(t_u32()), "u32");
  assert(can_comptime_int_cast_to(t_i64()), "i64");
  assert(can_comptime_int_cast_to(t_u64()), "u64");
  assert(can_comptime_int_cast_to(t_usize()), "usize");
  assert(can_comptime_int_cast_to(t_isize()), "isize");
  assert(can_comptime_int_cast_to(.ComptimeInt), "comptime_int self");
});
test("can_comptime_int_cast_to: non-integer types return(false)", {
  assert(!(can_comptime_int_cast_to(t_f32())), "f32");
  assert(!(can_comptime_int_cast_to(t_f64())), "f64");
  assert(!(can_comptime_int_cast_to(t_bool())), "bool");
  assert(!(can_comptime_int_cast_to(t_unit())), "unit");
  assert(!(can_comptime_int_cast_to(.ComptimeFloat)), "comptime_float");
});
// ---------------------------------------------------------------------------
// can_comptime_float_cast_to
// ---------------------------------------------------------------------------
test("can_comptime_float_cast_to: float types return(true)", {
  assert(can_comptime_float_cast_to(t_f32()), "f32");
  assert(can_comptime_float_cast_to(t_f64()), "f64");
  assert(can_comptime_float_cast_to(.ComptimeFloat), "comptime_float self");
});
test("can_comptime_float_cast_to: non-float types return(false)", {
  assert(!(can_comptime_float_cast_to(t_i32())), "i32");
  assert(!(can_comptime_float_cast_to(t_u64())), "u64");
  assert(!(can_comptime_float_cast_to(t_bool())), "bool");
  assert(!(can_comptime_float_cast_to(t_unit())), "unit");
  assert(!(can_comptime_float_cast_to(.ComptimeInt)), "comptime_int");
});
// ---------------------------------------------------------------------------
// type_implements_runtime / type_is_comptime_only (Phase 2as)
// ---------------------------------------------------------------------------
test("type_implements_runtime_builtin: runtime types yield Some(true)", {
  match(
    type_implements_runtime_builtin(t_i32()),
    .Some(b) => assert(b, "i32 should be runtime"),
    .None => assert(false, "i32 should be decided")
  );
  match(
    type_implements_runtime_builtin(t_bool()),
    .Some(b) => assert(b, "bool should be runtime"),
    .None => assert(false, "bool should be decided")
  );
  match(
    type_implements_runtime_builtin(t_f64()),
    .Some(b) => assert(b, "f64 should be runtime"),
    .None => assert(false, "f64 should be decided")
  );
});
test("type_implements_runtime_builtin: comptime types yield Some(false)", {
  match(
    type_implements_runtime_builtin(t_comptime_int()),
    .Some(b) => assert(!(b), "comptime_int should NOT be runtime"),
    .None => assert(false, "comptime_int should be decided")
  );
  match(
    type_implements_runtime_builtin(t_comptime_float()),
    .Some(b) => assert(!(b), "comptime_float should NOT be runtime"),
    .None => assert(false, "comptime_float should be decided")
  );
  match(
    type_implements_runtime_builtin(t_comptime_string()),
    .Some(b) => assert(!(b), "comptime_str should NOT be runtime"),
    .None => assert(false, "comptime_str should be decided")
  );
});
test("type_implements_runtime: env-fallback returns false for undecided", {
  env := Environment.new(String.from(""));
  // i32 is decided runtime
  assert(type_implements_runtime(t_i32()), "i32 runtime");
  // comptime_int is decided non-runtime
  assert(!(type_implements_runtime(t_comptime_int())), "comptime_int not runtime");
});
test("type_is_comptime_only: comptime types are comptime-only", {
  env := Environment.new(String.from(""));
  assert(type_is_comptime_only(t_comptime_int()), "comptime_int");
  assert(type_is_comptime_only(t_comptime_float()), "comptime_float");
  assert(type_is_comptime_only(t_comptime_string()), "comptime_str");
});
test("type_is_comptime_only: runtime primitives are not comptime-only", {
  env := Environment.new(String.from(""));
  assert(!(type_is_comptime_only(t_i32())), "i32 not comptime-only");
  assert(!(type_is_comptime_only(t_bool())), "bool not comptime-only");
  assert(!(type_is_comptime_only(t_unit())), "unit not comptime-only");
});
// ---------------------------------------------------------------------------
// type_requires_comptime_modifier / type_prohibits_comptime_modifier
// ---------------------------------------------------------------------------
test("type_requires_comptime_modifier: comptime-only types require comptime", {
  env := Environment.new(String.from(""));
  assert(type_requires_comptime_modifier(t_comptime_int()), "comptime_int needs comptime");
  assert(type_requires_comptime_modifier(t_comptime_float()), "comptime_float needs comptime");
  assert(type_requires_comptime_modifier(t_comptime_string()), "comptime_str needs comptime");
  assert(type_requires_comptime_modifier(TypeValue.TypeUni(usize(0))), "TypeUni(0) needs comptime");
});
test("type_requires_comptime_modifier: runtime types do not require comptime", {
  env := Environment.new(String.from(""));
  assert(!(type_requires_comptime_modifier(t_i32())), "i32 does not need comptime");
  assert(!(type_requires_comptime_modifier(t_bool())), "bool does not need comptime");
  assert(!(type_requires_comptime_modifier(t_unit())), "unit does not need comptime");
  assert(!(type_requires_comptime_modifier(t_f64())), "f64 does not need comptime");
});
test("type_prohibits_comptime_modifier: runtime-only types prohibit comptime", {
  env := Environment.new(String.from(""));
  assert(type_prohibits_comptime_modifier(TypeValue.Void), "Void prohibits comptime");
  assert(type_prohibits_comptime_modifier(TypeValue.CInt), "CInt prohibits comptime");
  assert(type_prohibits_comptime_modifier(TypeValue.CChar), "CChar prohibits comptime");
});
test("type_prohibits_comptime_modifier: primitives and comptime types do not prohibit", {
  env := Environment.new(String.from(""));
  assert(!(type_prohibits_comptime_modifier(t_i32())), "i32 does not prohibit comptime");
  assert(!(type_prohibits_comptime_modifier(t_bool())), "bool does not prohibit comptime");
  assert(!(type_prohibits_comptime_modifier(t_comptime_int())), "comptime_int does not prohibit");
});
// ---------------------------------------------------------------------------
// get_all_some_types
// ---------------------------------------------------------------------------
test("get_all_some_types: primitive type has no SomeT", {
  result := get_all_some_types(t_i32());
  assert(result.len() == usize(0), "i32 should have no SomeT");
});
test("get_all_some_types: SomeT itself is collected", {
  ty := t_some_t(String.from("T"), usize(0));
  result := get_all_some_types(ty);
  assert(result.len() == usize(1), "SomeT should return(1 element)");
  match(
    result.get(usize(0)),
    .Some(found) => match(
      found,
      .SomeT(_, name : n, _, _, _, _, _, _, _, _) =>
        assert(n == String.from("T"), "collected SomeT should have name T"),
      _ => assert(false, "expected SomeT variant")
    ),
    .None => assert(false, "expected element at index 0")
  );
});
test("get_all_some_types: SomeT nested in Array is collected", {
  inner := t_some_t(String.from("E"), usize(1));
  ty := t_array(inner, usize(3));
  result := get_all_some_types(ty);
  assert(result.len() == usize(1), "Array(SomeT) should yield 1 SomeT");
});
test("get_all_some_types: bool has no SomeT", {
  result := get_all_some_types(t_bool());
  assert(result.len() == usize(0), "bool should have no SomeT");
});
// ---------------------------------------------------------------------------
// type_contains_rc_type: Phase 3 implementation tests
// ---------------------------------------------------------------------------
test("type_contains_rc_type: primitives return(false)", {
  assert(!(type_contains_rc_type(t_i32())), "i32 → false");
  assert(!(type_contains_rc_type(t_bool())), "bool → false");
  assert(!(type_contains_rc_type(t_unit())), "unit → false");
});
test("type_contains_rc_type: array of i32 returns false", {
  ty := t_array(t_i32(), usize(3));
  assert(!(type_contains_rc_type(ty)), "Array(i32) → false");
});
test("type_contains_rc_type: object struct is RC", {
  labels := ArrayList(String).new();
  types := ArrayList(TypeValue).new();
  obj := TypeValue.Struct(
    id : String.from("id1"),
    name : String.from("Obj"),
    field_labels : labels,
    field_types : types,
    is_reference_semantics : true,
    is_atomic_rc : false,
    is_newtype : false,
    constructor_func_id : String.from(""),
    type_arguments : ArrayList(TypeValue).new(),
    is_source_namespace : false
  );
  assert(type_contains_rc_type(obj), "object → true");
});
test("type_contains_rc_type: plain struct returns false", {
  labels := ArrayList(String).new();
  types := ArrayList(TypeValue).new();
  s := TypeValue.Struct(
    id : String.from("id2"),
    name : String.from("Point"),
    field_labels : labels,
    field_types : types,
    is_reference_semantics : false,
    is_atomic_rc : false,
    is_newtype : false,
    constructor_func_id : String.from(""),
    type_arguments : ArrayList(TypeValue).new(),
    is_source_namespace : false
  );
  assert(!(type_contains_rc_type(s)), "plain struct → false");
});
test("type_contains_rc_type: struct containing object field returns true", {
  field_labels := ArrayList(String).new();
  field_labels.push(String.from("inner"));
  inner_types := ArrayList(TypeValue).new();
  inner_types.push(
    TypeValue.Struct(
      id : String.from("id3"),
      name : String.from("Inner"),
      field_labels : ArrayList(String).new(),
      field_types : ArrayList(TypeValue).new(),
      is_reference_semantics : true,
      is_atomic_rc : false,
      is_newtype : false,
      constructor_func_id : String.from(""),
      type_arguments : ArrayList(TypeValue).new(),
      is_source_namespace : false
    )
  );
  outer := TypeValue.Struct(
    id : String.from("id4"),
    name : String.from("Outer"),
    field_labels : field_labels,
    field_types : inner_types,
    is_reference_semantics : false,
    is_atomic_rc : false,
    is_newtype : false,
    constructor_func_id : String.from(""),
    type_arguments : ArrayList(TypeValue).new(),
    is_source_namespace : false
  );
  assert(type_contains_rc_type(outer), "Struct(object field) → true");
});
test("type_contains_rc_type: IsoT returns true", {
  iso := t_iso(t_i32());
  assert(type_contains_rc_type(iso), "IsoT → true");
});
test("type_contains_rc_type: DynT returns true", {
  dyn := t_dyn_simple(ArrayList(TypeValue).new());
  assert(type_contains_rc_type(dyn), "DynT → true");
});
test("type_contains_rc_type: unresolved SomeT is conservatively true", {
  // Unresolved generic — conservative: true
  some := t_some_t(String.from("T"), usize(0));
  assert(type_contains_rc_type(some), "SomeT unresolved → true");
});
