//! Tests for yo-self/types/guards.yo.
//!
//! Covers all guards that have real implementations (Phase 2a).
//! Phase 2b stubs (returning false) are tested to confirm they return false —
//! so a future implementation landing out of order gets caught.

open import "std/string";

{ TypeValue,
  t_unit, t_bool, t_void,
  t_i32, t_u8, t_i8, t_u16, t_i16, t_u32, t_u64, t_i64,
  t_f32, t_f64,
  t_usize, t_isize,
  t_comptime_int, t_comptime_float, t_comptime_string,
  t_ptr, t_slice, t_array,
  t_func_simple,
  t_trait_simple, t_module_simple, t_some_t,
  is_int_type, is_float_type
} :: import "../types/type.yo";
{ ArrayList } :: import "std/collections/array_list";
{
  is_primitive_type,
  is_comptime_int_type,
  is_comptime_float_type,
  is_comptime_string_type,
  is_comptime_list_type,
  is_expr_list_type,
  is_usize_type,
  is_isize_type,
  is_u8_type, is_i8_type,
  is_u16_type, is_i16_type,
  is_u32_type, is_i32_type,
  is_u64_type, is_i64_type,
  is_f32_type, is_f64_type,
  is_expr_type,
  is_unit_type,
  is_bool_type,
  is_void_type,
  is_tuple_type,
  is_union_type,
  is_struct_type,
  is_enum_type,
  is_function_type,
  is_trait_type,
  is_module_type,
  is_some_type,
  is_object_type,
  is_atomic_object_type,
  is_newtype_type,
  is_fn_trait_type,
  is_function_type_and_is_type_function,
  is_function_type_and_is_macro_function,
  is_function_type_and_returns_comptime_value,
  is_type_hierarchy_type,
  is_type_0,
  is_iso_type,
  is_dyn_type,
  is_type_application_type,
  is_rc_type,
  is_integer_type,
  is_unsigned_integer_type,
  is_char_type,
  is_short_type,
  is_u_short_type,
  is_c_int_type,
  is_c_uint_type,
  is_long_type,
  is_u_long_type,
  is_long_long_type,
  is_u_long_long_type,
  is_long_double_type,
  is_future_trait_type,
  is_concrete_trait_type,
  is_c_compatible_type,
  is_function_type_generic,
  is_function_type_hard_generic,
  is_function_specializable,
  is_boxed_type,
  is_effects_row_type,
  is_pointer_type,
  is_slice_type,
  is_array_type,
  is_signed_int_type,
  is_numeric_type
} :: import "../types/guards.yo";

// Helper constructors for types not exposed by type.yo
t_cchar      :: (fn() -> TypeValue)(.CChar);
t_cshort     :: (fn() -> TypeValue)(.CShort);
t_cushort    :: (fn() -> TypeValue)(.CUShort);
t_cint       :: (fn() -> TypeValue)(.CInt);
t_cuint      :: (fn() -> TypeValue)(.CUInt);
t_clong      :: (fn() -> TypeValue)(.CLong);
t_culong     :: (fn() -> TypeValue)(.CULong);
t_clonglong  :: (fn() -> TypeValue)(.CLongLong);
t_culonglong :: (fn() -> TypeValue)(.CULongLong);
t_clongdouble :: (fn() -> TypeValue)(.CLongDouble);
t_typeuni0   :: (fn() -> TypeValue)(.TypeUni(usize(0)));
t_typeuni1   :: (fn() -> TypeValue)(.TypeUni(usize(1)));
t_tuple_empty :: (fn() -> TypeValue)(
  .Tuple(ArrayList(String).new(), ArrayList(TypeValue).new())
);
t_union_empty :: (fn() -> TypeValue)(
  .Union(String.from("U"), ArrayList(String).new(), ArrayList(TypeValue).new())
);

// ---------------------------------------------------------------------------
// Primitive guards
// ---------------------------------------------------------------------------

test "is_primitive_type: value types", {
  assert(is_primitive_type(t_unit()),        "unit");
  assert(is_primitive_type(t_bool()),        "bool");
  assert(is_primitive_type(t_usize()),       "usize");
  assert(is_primitive_type(t_isize()),       "isize");
  assert(is_primitive_type(t_i32()),         "i32");
  assert(is_primitive_type(t_u8()),          "u8");
  assert(is_primitive_type(t_f32()),         "f32");
  assert(is_primitive_type(t_cchar()),       "cchar");
  assert(is_primitive_type(t_clong()),       "clong");
};

test "is_primitive_type: non-primitives return false", {
  assert(!(is_primitive_type(t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit()))), "func");
  assert(!(is_primitive_type(t_trait_simple(String.from("T")))),       "trait");
  assert(!(is_primitive_type(t_some_t(String.from("A"), usize(0)))),   "some_t");
  assert(!(is_primitive_type(t_comptime_int())),                       "comptime_int not primitive");
  assert(!(is_primitive_type(t_comptime_float())),                     "comptime_float not primitive");
};

// ---------------------------------------------------------------------------
// Comptime type guards
// ---------------------------------------------------------------------------

test "is_comptime_int_type", {
  assert(is_comptime_int_type(t_comptime_int()),   "comptime_int");
  assert(!(is_comptime_int_type(t_i32())),         "i32 not comptime_int");
  assert(!(is_comptime_int_type(t_usize())),       "usize not comptime_int");
};

test "is_comptime_float_type", {
  assert(is_comptime_float_type(t_comptime_float()),   "comptime_float");
  assert(!(is_comptime_float_type(t_f32())),           "f32 not comptime_float");
};

test "is_comptime_string_type", {
  assert(is_comptime_string_type(t_comptime_string()),  "comptime_string");
  assert(!(is_comptime_string_type(t_bool())),          "bool not comptime_string");
};

test "is_comptime_list_type: Phase 2b stub returns false", {
  assert(!(is_comptime_list_type(t_unit())), "stub false");
};

test "is_expr_list_type: Phase 2b stub returns false", {
  assert(!(is_expr_list_type(t_unit())), "stub false");
};

// ---------------------------------------------------------------------------
// Exact integer width guards
// ---------------------------------------------------------------------------

test "is_usize_type / is_isize_type", {
  assert(is_usize_type(t_usize()),  "usize");
  assert(!(is_usize_type(t_i32())), "i32 not usize");
  assert(is_isize_type(t_isize()),  "isize");
  assert(!(is_isize_type(t_u8())), "u8 not isize");
};

test "fixed-width integer guards", {
  assert(is_u8_type(t_u8()),    "u8");
  assert(is_i8_type(t_i8()),    "i8");
  assert(is_u16_type(t_u16()), "u16");
  assert(is_i16_type(t_i16()), "i16");
  assert(is_u32_type(t_u32()), "u32");
  assert(is_i32_type(t_i32()), "i32");
  assert(is_u64_type(t_u64()), "u64");
  assert(is_i64_type(t_i64()), "i64");
  // Cross-checks
  assert(!(is_u8_type(t_i8())),   "i8 not u8");
  assert(!(is_i32_type(t_u32())), "u32 not i32");
  assert(!(is_u64_type(t_i64())), "i64 not u64");
};

test "float guards", {
  assert(is_f32_type(t_f32()),    "f32");
  assert(is_f64_type(t_f64()),    "f64");
  assert(!(is_f32_type(t_f64())), "f64 not f32");
  assert(!(is_f64_type(t_i32())), "i32 not f64");
};

test "is_expr_type: Phase 2b stub returns false", {
  assert(!(is_expr_type(t_unit())), "stub false");
};

// ---------------------------------------------------------------------------
// Simple scalar guards
// ---------------------------------------------------------------------------

test "is_unit_type / is_bool_type / is_void_type", {
  assert(is_unit_type(t_unit()),   "unit");
  assert(is_bool_type(t_bool()),   "bool");
  assert(is_void_type(t_void()),   "void");
  assert(!(is_unit_type(t_bool())), "bool not unit");
  assert(!(is_bool_type(t_void())), "void not bool");
};

// ---------------------------------------------------------------------------
// Compound type guards
// ---------------------------------------------------------------------------

test "is_tuple_type", {
  assert(is_tuple_type(t_tuple_empty()),  "tuple");
  assert(!(is_tuple_type(t_i32())),       "i32 not tuple");
};

test "is_union_type", {
  assert(is_union_type(t_union_empty()),  "union");
  assert(!(is_union_type(t_i32())),       "i32 not union");
};

test "is_struct_type / is_enum_type / is_function_type / is_trait_type / is_module_type / is_some_type", {
  s := TypeValue.Struct(String.from("S"), ArrayList(String).new(), ArrayList(TypeValue).new());
  e := TypeValue.EnumT(String.from("E"), ArrayList(String).new(), ArrayList(ArrayList(TypeValue)).new());
  f := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  tr := t_trait_simple(String.from("T"));
  m := t_module_simple(String.from("M"));
  sm := t_some_t(String.from("A"), usize(0));

  assert(is_struct_type(s),   "struct");
  assert(is_enum_type(e),     "enum");
  assert(is_function_type(f), "function");
  assert(is_trait_type(tr),   "trait");
  assert(is_module_type(m),   "module");
  assert(is_some_type(sm),    "some_t");

  assert(!(is_struct_type(t_i32())),    "i32 not struct");
  assert(!(is_function_type(t_bool())), "bool not function");
};

test "Phase 2b stubs: object / atomic / newtype / fn_trait / iso / dyn / type_app / rc / specializable / boxed / effects_row", {
  assert(!(is_object_type(t_i32())),           "object stub");
  assert(!(is_atomic_object_type(t_i32())),    "atomic_object stub");
  assert(!(is_newtype_type(t_i32())),          "newtype stub");
  assert(!(is_fn_trait_type(t_i32())),         "fn_trait stub");
  assert(!(is_iso_type(t_i32())),              "iso stub");
  assert(!(is_dyn_type(t_i32())),              "dyn stub");
  assert(!(is_type_application_type(t_i32())), "type_app stub");
  assert(!(is_rc_type(t_i32())),               "rc stub");
  assert(!(is_function_specializable(t_i32())), "specializable stub");
  assert(!(is_boxed_type(t_i32())),            "boxed stub");
  assert(!(is_effects_row_type(t_i32())),      "effects_row stub");
  assert(!(is_future_trait_type(t_i32())),     "future_trait stub");
  assert(!(is_concrete_trait_type(t_i32())),   "concrete_trait stub");
  assert(!(is_function_type_and_is_macro_function(t_i32())),             "macro_fn stub");
  assert(!(is_function_type_and_returns_comptime_value(t_i32())),        "comptime_fn stub");
};

// ---------------------------------------------------------------------------
// Type hierarchy guards
// ---------------------------------------------------------------------------

test "is_type_hierarchy_type / is_type_0", {
  assert(is_type_hierarchy_type(t_typeuni0()),  "TypeUni(0)");
  assert(is_type_hierarchy_type(t_typeuni1()),  "TypeUni(1)");
  assert(!(is_type_hierarchy_type(t_i32())),    "i32 not TypeUni");

  assert(is_type_0(t_typeuni0()),               "level 0");
  assert(!(is_type_0(t_typeuni1())),            "level 1 is not 0");
};

test "is_function_type_and_is_type_function", {
  f_ret_type := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_typeuni0());
  f_ret_unit := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  assert(is_function_type_and_is_type_function(f_ret_type), "fn returning TypeUni");
  assert(!(is_function_type_and_is_type_function(f_ret_unit)), "fn returning unit");
};

// ---------------------------------------------------------------------------
// Numeric extended guards
// ---------------------------------------------------------------------------

test "is_integer_type: includes Usize/Isize", {
  assert(is_integer_type(t_i32()),   "i32");
  assert(is_integer_type(t_u8()),    "u8");
  assert(is_integer_type(t_usize()), "usize");
  assert(is_integer_type(t_isize()), "isize");
  assert(!(is_integer_type(t_f32())), "f32 not integer");
  assert(!(is_integer_type(t_bool())), "bool not integer");
};

test "is_unsigned_integer_type", {
  assert(is_unsigned_integer_type(t_u8()),    "u8");
  assert(is_unsigned_integer_type(t_u32()),   "u32");
  assert(is_unsigned_integer_type(t_usize()), "usize");
  assert(!(is_unsigned_integer_type(t_i32())),  "i32 not unsigned");
  assert(!(is_unsigned_integer_type(t_isize())), "isize not unsigned");
};

// ---------------------------------------------------------------------------
// C-compatible guards
// ---------------------------------------------------------------------------

test "C type guards", {
  assert(is_char_type(t_cchar()),         "cchar");
  assert(is_short_type(t_cshort()),       "cshort");
  assert(is_u_short_type(t_cushort()),    "cushort");
  assert(is_c_int_type(t_cint()),         "cint");
  assert(is_c_uint_type(t_cuint()),       "cuint");
  assert(is_long_type(t_clong()),         "clong");
  assert(is_u_long_type(t_culong()),      "culong");
  assert(is_long_long_type(t_clonglong()), "clonglong");
  assert(is_u_long_long_type(t_culonglong()), "culonglong");
  assert(is_long_double_type(t_clongdouble()), "clongdouble");

  assert(!(is_char_type(t_i32())), "i32 not cchar");
};

test "is_c_compatible_type", {
  assert(is_c_compatible_type(t_cchar()),      "cchar");
  assert(is_c_compatible_type(t_cshort()),     "cshort");
  assert(is_c_compatible_type(t_cushort()),    "cushort");
  assert(is_c_compatible_type(t_cint()),       "cint");
  assert(is_c_compatible_type(t_cuint()),      "cuint");
  assert(is_c_compatible_type(t_clong()),      "clong");
  assert(is_c_compatible_type(t_culong()),     "culong");
  assert(is_c_compatible_type(t_clonglong()),  "clonglong");
  assert(is_c_compatible_type(t_culonglong()), "culonglong");
  assert(is_c_compatible_type(t_clongdouble()), "clongdouble");

  assert(!(is_c_compatible_type(t_i32())),     "i32 not C");
  assert(!(is_c_compatible_type(t_usize())),   "usize not C");
  assert(!(is_c_compatible_type(t_bool())),    "bool not C");
};

// ---------------------------------------------------------------------------
// Function genericity guards
// ---------------------------------------------------------------------------

test "is_function_type_generic: simple func not generic", {
  f := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  assert(!(is_function_type_generic(f)), "simple func");
};

test "is_function_type_generic: forall func is generic", {
  // Build a Func variant with one forall label
  fl := ArrayList(String).new();
  ft := ArrayList(TypeValue).new();
  fl.push(String.from("T"));
  ft.push(TypeValue.TypeUni(usize(0)));
  f := TypeValue.Func(
    fl, ft,
    ArrayList(String).new(), ArrayList(TypeValue).new(),
    ArrayList(String).new(), ArrayList(TypeValue).new(),
    ArrayList(bool).new(),
    ArrayList(TypeValue).new(),
    box(t_unit())
  );
  assert(is_function_type_generic(f),      "forall func generic");
  assert(is_function_type_hard_generic(f), "forall func hard generic");
};

test "is_function_type_generic: implicit params make generic (but not hard)", {
  // Build a Func with one implicit (using) label and no forall
  il := ArrayList(String).new();
  it_ := ArrayList(TypeValue).new();
  is_ := ArrayList(bool).new();
  il.push(String.from("io"));
  it_.push(t_module_simple(String.from("IO")));
  is_.push(false);
  f := TypeValue.Func(
    ArrayList(String).new(), ArrayList(TypeValue).new(),
    ArrayList(String).new(), ArrayList(TypeValue).new(),
    il, it_, is_,
    ArrayList(TypeValue).new(),
    box(t_unit())
  );
  assert(is_function_type_generic(f),       "implicit func generic");
  assert(!(is_function_type_hard_generic(f)), "implicit func NOT hard generic");
};

test "is_function_type_hard_generic: simple func not hard generic", {
  f := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  assert(!(is_function_type_hard_generic(f)), "simple not hard generic");
};

// ---------------------------------------------------------------------------
// Re-exported guards from type.yo
// ---------------------------------------------------------------------------

test "re-exported guards from type.yo still work", {
  assert(is_int_type(t_i32()),          "is_int_type i32");
  assert(is_float_type(t_f32()),        "is_float_type f32");
  assert(is_signed_int_type(t_i32()),   "is_signed_int_type i32");
  assert(!(is_signed_int_type(t_u32())), "u32 not signed");
  assert(is_pointer_type(t_ptr(t_i32())), "pointer");
  assert(is_slice_type(t_slice(t_u8())),  "slice");
  assert(is_array_type(t_array(t_u8(), usize(4))), "array");
};
