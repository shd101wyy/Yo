  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(3),i32(1),i32(4),i32(1),i32(5),i32(9),i32(2),i32(6)];\nmxv := i32(0);\nmnv := i32(100);\nii := i32(0);\nwhile((ii < i32(8)), {\nvv := arr.get(ii).unwrap();\nmxv = cond((vv > mxv) => vv, true => mxv);\nmnv = cond((vv < mnv) => vv, true => mnv);\nii = (ii + i32(1));\n});\nrng := (mxv - mnv);\nsd := i32(0);\ndd := i32(1);\nwhile((dd < i32(12)), {\nadd := cond(((i32(12) % dd) == i32(0)) => dd, true => i32(0));\nsd = (sd + add);\ndd = (dd + i32(1));\n});\ncev := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)(cond(((x % i32(2)) == i32(0)) => (acc + i32(1)), true => acc)));\ntotal := ((rng + sd) + cev);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "27", "27"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
