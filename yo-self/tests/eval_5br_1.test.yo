test("Phase 5bre: prod_odd + sum_divs_28 + sum_bits_1to8 = 945+28+13 = 986", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // product odd 1..9=945, proper divs 28=28, popcount sum 1..8=13
  src := "pp := i32(1);\nnv := i32(1);\nwhile((nv < i32(10)), {\niod := cond(((nv % i32(2)) != i32(0)) => i32(1), true => i32(0));\npp = cond((iod == i32(1)) => (pp * nv), true => pp);\nnv = (nv + i32(1));\n});\nsd28 := i32(0);\nee := i32(1);\nwhile((ee < i32(28)), {\naddv := cond(((i32(28) % ee) == i32(0)) => ee, true => i32(0));\nsd28 = (sd28 + addv);\nee = (ee + i32(1));\n});\nbits := [i32(1),i32(1),i32(2),i32(1),i32(2),i32(2),i32(3),i32(1)];\nsbt := bits.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\ntotal := ((pp + sd28) + sbt);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "986", "986"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
