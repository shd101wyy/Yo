// ---------------------------------------------------------------------------
// Phase 5brc — bit counting, divisor sums
// ---------------------------------------------------------------------------
test("Phase 5brc: count set bits in 42 = 3 via while loop", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 42 = 101010 in binary, 3 set bits
  src := "n := i32(42);\ncnt := i32(0);\nwhile((n > i32(0)), {\ncnt = (cnt + (n % i32(2)));\nn = (n / i32(2));\n});\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5brc: sum of proper divisors of 12 = 16", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // proper divisors of 12: 1,2,3,4,6 → sum=16
  src := "s := i32(0);\nd := i32(1);\nwhile((d < i32(12)), {\nadd := cond(((i32(12) % d) == i32(0)) => d, true => i32(0));\ns = (s + add);\nd = (d + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "16", "16"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
