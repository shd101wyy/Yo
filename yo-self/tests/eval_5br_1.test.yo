test("Phase 5brd: mult6_count + prod_odd + bits_42 = 5+945+3 = 953", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "cnt6 := i32(0);\nn6 := i32(1);\nwhile((n6 < i32(31)), {\ncnt6 = cond(((n6 % i32(6)) == i32(0)) => (cnt6 + i32(1)), true => cnt6);\nn6 = (n6 + i32(1));\n});\npodd := i32(1);\nnv := i32(1);\nwhile((nv < i32(10)), {\niod := cond(((nv % i32(2)) != i32(0)) => i32(1), true => i32(0));\npodd = cond((iod == i32(1)) => (podd * nv), true => podd);\nnv = (nv + i32(1));\n});\nnb := i32(42);\nbc := i32(0);\nwhile((nb > i32(0)), {\nbc = (bc + (nb % i32(2)));\nnb = (nb / i32(2));\n});\ntotal := ((cnt6 + podd) + bc);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "953", "953"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
