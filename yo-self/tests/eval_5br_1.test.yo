// @skip_wasm32-emscripten
// @skip_wasm32-wasi
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
empty_env :: (fn() -> Environment)(Environment.new(`test`));

// ---------------------------------------------------------------------------
// Phase 5bra — multi-condition filtering: multiples, products, coprime
// ---------------------------------------------------------------------------
test("Phase 5bra: count multiples of 6 in 1..30 = 5", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 6,12,18,24,30 = 5 multiples
  src := "cnt := i32(0);\nn := i32(1);\nwhile((n < i32(31)), {\ncnt = cond(((n % i32(6)) == i32(0)) => (cnt + i32(1)), true => cnt);\nn = (n + i32(1));\n});\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "5"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bra: sum of n in 1..15 not divisible by 3 = 75", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // sum(1..15)=120, sum(3,6,9,12,15)=45, 120-45=75
  src := "s := i32(0);\nn := i32(1);\nwhile((n < i32(16)), {\ns = cond(((n % i32(3)) != i32(0)) => (s + n), true => s);\nn = (n + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "75", "75"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bra: product of odd numbers 1..9 = 945", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 1*3*5*7*9 = 945
  src := "p := i32(1);\nn := i32(1);\nwhile((n < i32(10)), {\niod := cond(((n % i32(2)) != i32(0)) => i32(1), true => i32(0));\np = cond((iod == i32(1)) => (p * n), true => p);\nn = (n + i32(1));\n});\nexport(p);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "945", "945"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bra: count n in 1..30 coprime to 6 (n%2!=0 AND n%3!=0) = 10", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 1,5,7,11,13,17,19,23,25,29 = 10 numbers coprime to 6
  src := "cnt := i32(0);\nn := i32(1);\nwhile((n < i32(31)), {\nnd2 := cond(((n % i32(2)) != i32(0)) => i32(1), true => i32(0));\nnd3 := cond(((n % i32(3)) != i32(0)) => i32(1), true => i32(0));\ncnt = cond(((nd2 * nd3) == i32(1)) => (cnt + i32(1)), true => cnt);\nn = (n + i32(1));\n});\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "10", "10"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5brb — array stats: sum, range, count-gt, count-even
// ---------------------------------------------------------------------------
test("Phase 5brb: sum of [3,1,4,1,5,9,2,6] = 31 via fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(3),i32(1),i32(4),i32(1),i32(5),i32(9),i32(2),i32(6)];\ns := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "31", "31"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5brb: max-min (range) of [3,1,4,1,5,9,2,6] = 8", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // max=9, min=1, range=8
  src := "arr := [i32(3),i32(1),i32(4),i32(1),i32(5),i32(9),i32(2),i32(6)];\nmx := i32(0);\nmn := i32(100);\ni := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap();\nmx = cond((v > mx) => v, true => mx);\nmn = cond((v < mn) => v, true => mn);\ni = (i + i32(1));\n});\nrng := (mx - mn);\nexport(rng);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "8", "8"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
