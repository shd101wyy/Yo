/// Codegen tests for inline builtin function calls.
///
/// Validates the per-handler module `yo-self/codegen/exprs/inline_fns.yo`,
/// which is a 1-to-1 port of `src/codegen/exprs/inline-fns.ts`
/// (`generateYoInlineFunctionCall`).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  generate_yo_inline_function_call,
  is_yo_inline_builtin,
  emit_cast,
  emit_cast_enum_tag,
  emit_slice_construction
} :: import("../codegen/exprs/inline_fns.yo");
mk_args1 :: (fn(a0 : str) -> ArrayList(String))({
  out := ArrayList(String).new();
  out.push(String.from(a0));
  out
});
mk_args2 :: (fn(a0 : str, a1 : str) -> ArrayList(String))({
  out := ArrayList(String).new();
  out.push(String.from(a0));
  out.push(String.from(a1));
  out
});
test("generate_yo_inline_function_call: __yo_op_add emits binary +", {
  out := generate_yo_inline_function_call("__yo_op_add", mk_args2("x", "y"));
  match(
    out,
    .None => assert(false, "expected Some output"),
    .Some(code) => assert(code == "((x) + (y))", "expected binary add")
  );
});
test("generate_yo_inline_function_call: __yo_op_neg emits unary -", {
  out := generate_yo_inline_function_call("__yo_op_neg", mk_args1("a"));
  match(
    out,
    .None => assert(false, "expected Some output"),
    .Some(code) => assert(code == "(-(a))", "expected unary negation")
  );
});
test("generate_yo_inline_function_call: __yo_ptr_eq emits == without parens around args", {
  out := generate_yo_inline_function_call("__yo_ptr_eq", mk_args2("p", "q"));
  match(
    out,
    .None => assert(false, "expected Some output"),
    .Some(code) => assert(code == "(p == q)", "expected pointer equality")
  );
});
test("generate_yo_inline_function_call: __yo_slice_len accesses .length field", {
  out := generate_yo_inline_function_call("__yo_slice_len", mk_args1("s"));
  match(
    out,
    .None => assert(false, "expected Some output"),
    .Some(code) => assert(code == "(s.length)", "expected slice length access")
  );
});
test("generate_yo_inline_function_call: __yo_noop emits empty string", {
  out := generate_yo_inline_function_call("__yo_noop", ArrayList(String).new());
  match(
    out,
    .None => assert(false, "expected Some output"),
    .Some(code) => assert(code == "", "expected empty noop")
  );
});
test("generate_yo_inline_function_call: __yo_decr_rc emits void* cast", {
  out := generate_yo_inline_function_call("__yo_decr_rc", mk_args1("rc"));
  match(
    out,
    .None => assert(false, "expected Some output"),
    .Some(code) => assert(code == "__yo_decr_rc((void*)(rc))", "expected decr_rc with void* cast")
  );
});
test("is_yo_inline_builtin: known builtins return true", {
  assert(is_yo_inline_builtin("__yo_op_add"), "op_add is inline");
  assert(is_yo_inline_builtin("__yo_ptr_lt"), "ptr_lt is inline");
  assert(is_yo_inline_builtin("__yo_slice_ptr"), "slice_ptr is inline");
  assert(is_yo_inline_builtin("__yo_noop"), "noop is inline");
});
test("is_yo_inline_builtin: unknown names return false", {
  assert(!(is_yo_inline_builtin("printf")), "printf is not inline");
  assert(!(is_yo_inline_builtin("__yo_typeid_register")), "typeid_register is not inline");
  assert(!(is_yo_inline_builtin("foo_bar")), "foo_bar is not inline");
});
// ─── pure cast / slice-construction emitters ────────────────────────────────
test("emit_cast: wraps target type and value", {
  out := emit_cast("int32_t", "x");
  assert(out == String.from("((int32_t)(x))"), "cast shape");
});
test("emit_cast_enum_tag: extracts .tag from scrutinee", {
  out := emit_cast_enum_tag("int32_t", "color");
  assert(out == String.from("((int32_t)((color).tag))"), "tag-cast shape");
});
test("emit_slice_construction: composes (Type){ .data = <p>, .length = <n> }", {
  out := emit_slice_construction("Slice_u8", "buf", "len");
  assert(
    out == String.from("(Slice_u8){ .data = buf, .length = len }"),
    "slice construction"
  );
});
