      match(fvals.get(usize(0)), .Some(v0) => match(v0, .IntLit(n) => assert(n.as_str() == "5", "5"), _ => assert(false, "t")), .None => assert(false, "f0"));
      match(fvals.get(usize(1)), .Some(v1) => match(v1, .BoolVal(b) => assert(b, "true"), _ => assert(false, "t")), .None => assert(false, "f1"));
    }, _ => assert(false, "not StructVal")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
