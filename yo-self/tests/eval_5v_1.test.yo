      match(fvals.get(usize(1)), .Some(v1) => match(v1, .IntLit(n) => assert(n.as_str() == "9", "9"), _ => assert(false, "t")), .None => assert(false, "f1"));
    }, _ => assert(false, "not StructVal")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
