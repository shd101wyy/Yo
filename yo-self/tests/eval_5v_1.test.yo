  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .BoolVal(b) => assert(b, "same"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
// ---------------------------------------------------------------------------
// Phase 5vb — Tuple expressions (a, b, c) → StructVal with numeric fields
// ---------------------------------------------------------------------------
test("Phase 5vb: (i32(1), i32(2)) — 2-tuple is StructVal with two fields", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "t := (i32(1), i32(2));\nexport(t);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .StructVal(_, fnames, fvals) => {
      assert(fnames.len() == usize(2), "2 fields");
      assert(fvals.len() == usize(2), "2 vals");
    }, _ => assert(false, "not StructVal")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5vb: tuple field 0 has correct value", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "t := (i32(7), i32(42));\nexport(t);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .StructVal(_, _, fvals) => {
      match(fvals.get(usize(0)), .Some(v0) => match(v0, .IntLit(n) => assert(n.as_str() == "7", "7"), _ => assert(false, "t")), .None => assert(false, "no f0"));
    }, _ => assert(false, "not StructVal")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5vb: tuple field 1 has correct value", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "t := (i32(7), i32(42));\nexport(t);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .StructVal(_, _, fvals) => {
      match(fvals.get(usize(1)), .Some(v1) => match(v1, .IntLit(n) => assert(n.as_str() == "42", "42"), _ => assert(false, "t")), .None => assert(false, "no f1"));
    }, _ => assert(false, "not StructVal")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5vb: 3-tuple has 3 fields", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "t := (i32(1), i32(2), i32(3));\nexport(t);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .StructVal(_, fnames, _) => {
      assert(fnames.len() == usize(3), "3 fields");
    }, _ => assert(false, "not StructVal")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5vb: tuple field names are numeric strings 0,1,2", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "t := (i32(10), i32(20), i32(30));\nexport(t);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .StructVal(_, fnames, _) => {
      match(fnames.get(usize(0)), .Some(n0) => assert(n0.as_str() == "0", "f0=0"), .None => assert(false, "no f0"));
      match(fnames.get(usize(1)), .Some(n1) => assert(n1.as_str() == "1", "f1=1"), .None => assert(false, "no f1"));
      match(fnames.get(usize(2)), .Some(n2) => assert(n2.as_str() == "2", "f2=2"), .None => assert(false, "no f2"));
    }, _ => assert(false, "not StructVal")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
