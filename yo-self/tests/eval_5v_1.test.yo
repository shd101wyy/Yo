// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5v series: FnMut closures, tuples, integer conversions, String.
///
/// Phases covered:
///   5va — FnMut closures (x) =>> body in source strings (same as => for proto-eval)
///   5vb — Tuple expressions (a, b, c) → StructVal with numeric fields
///   5vc — Integer conversion methods: .to_usize() / .to_i64() / .to_i32() / .abs() / .min() / .max()
///   5vd — String type constructor, String.from (as TypeVal), clone() passthrough
///   5ve — Combos: FnMut in HOF, tuple destructuring, negation + conversion chains

open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5va — FnMut closures (=>> operator) in source strings
// ---------------------------------------------------------------------------
test("Phase 5va: FnMut closure (x) =>> x produces FuncVal", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "f := ((x) =>> x);\nexport(f);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .FuncVal(_, _, _, _, _, _, _, _, _) => (), _ => assert(false, "not FuncVal")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5va: FnMut closure call (x) =>> (x + i32(1)) with arg 5 → 6", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "f := ((x) =>> (x + i32(1)));\nexport(f(i32(5)));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "6", "6"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
