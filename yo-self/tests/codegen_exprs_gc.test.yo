/// Codegen tests for `__yo_gc_collect()` builtin.
///
/// Validates the per-handler module `yo-self/codegen/exprs/gc.yo`, which is a
/// 1-to-1 port of `src/codegen/exprs/gc.ts`.
open(import("std/fmt"));
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr } :: import("../expr.yo");
{ TokenKind, Token } :: import("../token.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{ generate_yo_gc_collect } :: import("../codegen/exprs/gc.yo");
make_token :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
test("generate_yo_gc_collect: zero args emits __yo_gc_collect()", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  ind := String.new();
  args := ArrayList(AstExpr).new();
  out := generate_yo_gc_collect(args, pctx, ind);
  assert(out == "__yo_gc_collect()", "expected __yo_gc_collect()");
});
test("generate_yo_gc_collect: arity error emits comment", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  ind := String.new();
  args := ArrayList(AstExpr).new();
  args.push(AstExpr.Atom(usize(0), make_token(TokenKind.Identifier, "x")));
  out := generate_yo_gc_collect(args, pctx, ind);
  assert(out == "// Error: __yo_gc_collect requires exactly 0 arguments", "expected error comment");
});
