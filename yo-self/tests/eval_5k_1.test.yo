test("Phase 5kb: Sign enum — is_positive and actual_val", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Sign :: enum(Positive, Zero, Negative);\nSignNum :: struct(sign : Sign, mag : i32);\nimpl(SignNum, Ops(\n  is_positive : (fn(n : SignNum) -> bool)({\n    match(n.sign, .Positive => true, .Zero => false, .Negative => false)\n  }),\n  actual_val : (fn(n : SignNum) -> i32)({\n    match(n.sign, .Positive => n.mag, .Zero => i32(0), .Negative => (i32(0) - n.mag))\n  })\n));\np := SignNum(sign: .Positive, mag: i32(7));\nneg := SignNum(sign: .Negative, mag: i32(4));\nexport(p.is_positive());\nexport(neg.actual_val());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.BoolVal(b) => assert(b, "Positive is_positive"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "-4", "Negative mag=4 → -4"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5kb: two enum fields — combined code", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "SuitB :: enum(Clubs, Spades, Hearts, Diamonds);\nRankB :: enum(Low, Mid, High);\nItem :: struct(suit : SuitB, rank : RankB);\nimpl(Item, Ops(\n  code : (fn(it : Item) -> i32)({\n    (match(it.suit, .Clubs => i32(0), .Spades => i32(10), .Hearts => i32(20), .Diamonds => i32(30)) + match(it.rank, .Low => i32(1), .Mid => i32(2), .High => i32(3)))\n  })\n));\nx := Item(suit: .Spades, rank: .High);\ny := Item(suit: .Diamonds, rank: .Low);\nexport(x.code());\nexport(y.code());";
