test("Phase 5kb: Color enum field — luminance method", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Color :: enum(Red, Green, Blue);\nLight :: struct(color : Color, intensity : i32);\nimpl(Light, Ops(\n  luminance : (fn(l : Light) -> i32)({\n    match(l.color, .Red => (l.intensity * i32(3)), .Green => (l.intensity * i32(5)), .Blue => (l.intensity * i32(2)))\n  })\n));\nled := Light(color: .Blue, intensity: i32(10));\ngrn := Light(color: .Green, intensity: i32(4));\nexport(led.luminance());\nexport(grn.luminance());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "20", "blue*2=20"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "20", "green*5=20"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
