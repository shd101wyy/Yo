// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5k series: advanced impl method patterns.
///
/// Phases covered:
///   5ka — impl methods that call standalone helper functions
///   5kb — enum field in struct, trait method dispatches on enum variant
///   5kc — boolean-logic-heavy methods (and/or/not/xor/implication)
///   5kd — array accumulation via struct method calls (for loops)
///   5ke — complex while-loop and recur patterns inside impl methods
///
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5ka — impl methods calling standalone helper functions
// ---------------------------------------------------------------------------
test("Phase 5ka: abs helper — magnitude method", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "abs2 :: (fn(x : i32) -> i32)(cond((x >= i32(0)) => x, true => (i32(0) - x)));\nV :: struct(n : i32);\nimpl(V, Ops(\n  magnitude : (fn(v : V) -> i32)({ abs2(v.n) })\n));\na := V(n: i32(-(5)));\nb := V(n: i32(3));\nexport(a.magnitude());\nexport(b.magnitude());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "abs(-5)=5"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "abs(3)=3"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
