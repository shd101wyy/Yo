  }, _ => assert(false, "m")));
});
test("Phase 5ke: Collatz step count via while", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(n : i32);\nimpl(N, Math(\n  collatz_steps : (fn(x : N) -> i32)({\n    (steps : i32) = i32(0);\n    (n : i32) = x.n;\n    while(runtime((n != i32(1))), {\n      cond(((n % i32(2)) == i32(0)) => { n = (n / i32(2)); }, true => { n = ((i32(3) * n) + i32(1)); });\n      steps = (steps + i32(1));\n    });\n    steps\n  })\n));\na := N(n: i32(6));\nexport(a.collatz_steps());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "8", "collatz(6)=8 steps"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ke: factorial via while (6!)", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(n : i32);\nimpl(N, Math(\n  factorial : (fn(x : N) -> i32)({\n    (acc : i32) = i32(1);\n    (i : i32) = i32(1);\n    while(runtime((i <= x.n)), {\n      acc = (acc * i);\n      i = (i + i32(1));\n    });\n    acc\n  })\n));\na := N(n: i32(6));\nexport(a.factorial());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "720", "6!=720"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
