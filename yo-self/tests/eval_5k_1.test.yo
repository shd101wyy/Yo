    match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "8", "Low=8"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5kb: Direction enum — is_vertical bool method", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Dir :: enum(Up, Down, Left, Right);\nMove :: struct(dir : Dir, dist : i32);\nimpl(Move, Ops(\n  is_vertical : (fn(m : Move) -> bool)({\n    match(m.dir, .Up => true, .Down => true, .Left => false, .Right => false)\n  })\n));\nm1 := Move(dir: .Up, dist: i32(5));\nm2 := Move(dir: .Right, dist: i32(3));\nexport(m1.is_vertical());\nexport(m2.is_vertical());";
