  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "ScoreR :: struct(pts : i32, active : bool);\nimpl(ScoreR, Ops(\n  contrib : (fn(s : ScoreR) -> i32)({ cond(s.active => s.pts, true => i32(0)) })\n));\nscores := [ScoreR(pts: i32(10), active: true), ScoreR(pts: i32(20), active: false), ScoreR(pts: i32(30), active: true)];\n(total : i32) = i32(0);\nfor(s, scores, {\n  total = (total + s.contrib());\n});\nexport(total);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "40", "10+0+30=40"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
