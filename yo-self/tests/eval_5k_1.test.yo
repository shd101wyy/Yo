    match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "min(9,4)=4"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ka: max2 helper — max3 method", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "max2 :: (fn(a : i32, b : i32) -> i32)(cond((a >= b) => a, true => b));\nT :: struct(a : i32, b : i32, c : i32);\nimpl(T, Ops(\n  max3 : (fn(t : T) -> i32)({ max2(max2(t.a, t.b), t.c) })\n));\nx := T(a: i32(4), b: i32(9), c: i32(2));\ny := T(a: i32(1), b: i32(3), c: i32(7));\nexport(x.max3());\nexport(y.max3());";
