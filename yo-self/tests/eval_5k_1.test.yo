    match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "7", "max(1,3,7)=7"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ka: clamp via inline cond — three boundary cases", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Bounded :: struct(val : i32, lo : i32, hi : i32);\nimpl(Bounded, Ops(\n  clamped : (fn(b : Bounded) -> i32)({\n    cond((b.val < b.lo) => b.lo, (b.val > b.hi) => b.hi, true => b.val)\n  })\n));\nr1 := Bounded(val: i32(5), lo: i32(10), hi: i32(20));\nr2 := Bounded(val: i32(15), lo: i32(10), hi: i32(20));\nr3 := Bounded(val: i32(25), lo: i32(10), hi: i32(20));\nexport(r1.clamped());\nexport(r2.clamped());\nexport(r3.clamped());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "10", "clamp(5,10,20)=10"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "15", "clamp(15,10,20)=15"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(2)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "20", "clamp(25,10,20)=20"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ka: lcm via gcd helper", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "gcd2 :: (fn(a : i32, b : i32) -> i32)(cond((b == i32(0)) => a, true => recur(b, (a % b))));\nPair :: struct(a : i32, b : i32);\nimpl(Pair, Math(\n  lcm : (fn(p : Pair) -> i32)({ ((p.a / gcd2(p.a, p.b)) * p.b) })\n));\np1 := Pair(a: i32(4), b: i32(6));\np2 := Pair(a: i32(5), b: i32(7));\nexport(p1.lcm());\nexport(p2.lcm());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "12", "lcm(4,6)=12"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "35", "lcm(5,7)=35"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ka: power via while loop", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Pow :: struct(base : i32, exp : i32);\nimpl(Pow, Math(\n  compute : (fn(p : Pow) -> i32)({\n    (result : i32) = i32(1);\n    (e : i32) = p.exp;\n    while(runtime((e > i32(0))), {\n      result = (result * p.base);\n      e = (e - i32(1));\n    });\n    result\n  })\n));\nx := Pow(base: i32(2), exp: i32(8));\nexport(x.compute());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "256", "2^8=256"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ka: digit sum via while loop", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Num :: struct(n : i32);\nimpl(Num, Ops(\n  digit_sum : (fn(x : Num) -> i32)({\n    (acc : i32) = i32(0);\n    (n : i32) = x.n;\n    while(runtime((n > i32(0))), {\n      acc = (acc + (n % i32(10)));\n      n = (n / i32(10));\n    });\n    acc\n  })\n));\na := Num(n: i32(1234));\nexport(a.digit_sum());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "10", "digit_sum(1234)=10"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ka: digit count via while loop", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Num :: struct(n : i32);\nimpl(Num, Ops(\n  digit_count : (fn(x : Num) -> i32)({\n    (count : i32) = i32(0);\n    (n : i32) = x.n;\n    while(runtime((n > i32(0))), {\n      count = (count + i32(1));\n      n = (n / i32(10));\n    });\n    count\n  })\n));\na := Num(n: i32(12345));\nexport(a.digit_count());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "digit_count(12345)=5"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ka: two helpers — sum of square and cube", {
  env := empty_env();
