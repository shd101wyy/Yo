  }, _ => assert(false, "m")));
});
test("Phase 5ka: 3-arg recur power — method wraps helper", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "pow3 :: (fn(b : i32, e : i32, acc : i32) -> i32)(cond((e == i32(0)) => acc, true => recur(b, (e - i32(1)), (acc * b))));\nV :: struct(b : i32, e : i32);\nimpl(V, Math(\n  pow : (fn(v : V) -> i32)({ pow3(v.b, v.e, i32(1)) })\n));\nx := V(b: i32(3), e: i32(4));\ny := V(b: i32(2), e: i32(10));\nexport(x.pow());\nexport(y.pow());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "81", "3^4=81"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1024", "2^10=1024"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
