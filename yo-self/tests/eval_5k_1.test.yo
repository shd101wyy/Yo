});
test("Phase 5ke: iterative power via while (5^3)", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Pow2 :: struct(b : i32, e : i32);\nimpl(Pow2, Math(\n  result : (fn(p : Pow2) -> i32)({\n    (acc : i32) = i32(1);\n    (e : i32) = p.e;\n    while(runtime((e > i32(0))), {\n      acc = (acc * p.b);\n      e = (e - i32(1));\n    });\n    acc\n  })\n));\nx := Pow2(b: i32(5), e: i32(3));\nexport(x.result());";
