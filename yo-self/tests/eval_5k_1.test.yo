    match(v.get(usize(0)),.Some(x) => match(x,.BoolVal(b) => assert(b, "Up is_vertical"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(1)),.Some(x) => match(x,.BoolVal(b) => assert(!(b), "Right !vertical"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5kb: Status enum — effective score (cond on match)", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Status :: enum(Active, Inactive, Pending);\nUser :: struct(status : Status, score : i32);\nimpl(User, Ops(\n  effective_score : (fn(u : User) -> i32)({\n    cond(match(u.status, .Active => true, .Inactive => false, .Pending => false) => u.score, true => i32(0))\n  })\n));\nu1 := User(status: .Active, score: i32(100));\nu2 := User(status: .Inactive, score: i32(50));\nexport(u1.effective_score());\nexport(u2.effective_score());";
