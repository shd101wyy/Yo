test("Phase 5ke: digit reversal via while", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(n : i32);\nimpl(N, Ops(\n  reversed : (fn(x : N) -> i32)({\n    (r : i32) = i32(0);\n    (n : i32) = x.n;\n    while(runtime((n > i32(0))), {\n      r = ((r * i32(10)) + (n % i32(10)));\n      n = (n / i32(10));\n    });\n    r\n  })\n));\na := N(n: i32(1234));\nexport(a.reversed());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4321", "rev(1234)=4321"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ke: GCD Euclidean via while in method body", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "PairG :: struct(a : i32, b : i32);\nimpl(PairG, Math(\n  gcd_val : (fn(p : PairG) -> i32)({\n    (a : i32) = p.a;\n    (b : i32) = p.b;\n    (t : i32) = i32(0);\n    while(runtime((b != i32(0))), {\n      t = b;\n      b = (a % b);\n      a = t;\n    });\n    a\n  })\n));\np1 := PairG(a: i32(48), b: i32(18));\np2 := PairG(a: i32(100), b: i32(75));\nexport(p1.gcd_val());\nexport(p2.gcd_val());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "gcd(48,18)=6"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "25", "gcd(100,75)=25"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ke: iterative Fibonacci via while", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(n : i32);\nimpl(N, Math(\n  fib : (fn(x : N) -> i32)({\n    (a : i32) = i32(0);\n    (b : i32) = i32(1);\n    (i : i32) = i32(0);\n    (t : i32) = i32(0);\n    while(runtime((i < x.n)), {\n      t = b;\n      b = (a + b);\n      a = t;\n      i = (i + i32(1));\n    });\n    a\n  })\n));\nf := N(n: i32(7));\nexport(f.fib());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "13", "fib(7)=13"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ke: bit popcount via while (n/2 loop)", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Num :: struct(n : i32);\nimpl(Num, Bits(\n  popcount : (fn(x : Num) -> i32)({\n    (cnt : i32) = i32(0);\n    (n : i32) = x.n;\n    while(runtime((n > i32(0))), {\n      cnt = (cnt + (n % i32(2)));\n      n = (n / i32(2));\n    });\n    cnt\n  })\n));\na := Num(n: i32(7));\nb := Num(n: i32(12));\nexport(a.popcount());\nexport(b.popcount());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "7=0b111, pop=3"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "12=0b1100, pop=2"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ke: sum of squares via 2-arg recur", {
  env := empty_env();
