/// Phase 13at step 3 — typeid codegen handler test.
///
/// Exercises `yo-self/codegen/exprs/typeid.yo` end-to-end with a populated
/// ExprInfoTable. The metadata records that the argument expression has
/// the compile-time value `EvalValue.TypeVal(i32)`, and the handler emits:
///
///   - a `static const char __yo_typeid_i32 = 0;` declaration (deduped),
///   - the call result `(uintptr_t)&__yo_typeid_i32`.
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr, ast_expr_id, BF_TYPEID } :: import("../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_new,
  expr_info_table_set
} :: import("../expr_info.yo");
{ Environment } :: import("../env.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ t_i32 } :: import("../types/creators.yo");
{ EvalValue } :: import("../value.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{
  generate_typeid,
  extract_type_value,
  format_typeid_static_name,
  format_typeid_static_decl,
  format_typeid_address_expr
} :: import("../codegen/exprs/typeid.yo");
{ sanitize_for_c_identifier_str } :: import("../codegen/utils/index.yo");
mk_atom :: (fn(id : usize, value : str, kind : TokenKind) -> AstExpr)(
  AstExpr.Atom(
    id,
    Token(
      kind : kind,
      value : String.from(value),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from("test"),
      input : String.from("")
    )
  )
);
test("sanitize_for_c_identifier: identifier chars passthrough", {
  out := sanitize_for_c_identifier_str("i32");
  assert(out == String.from("i32"), "i32 unchanged");
  out2 := sanitize_for_c_identifier_str("_yo_foo123");
  assert(out2 == String.from("_yo_foo123"), "underscore + digits passthrough");
});
test("sanitize_for_c_identifier: non-identifier chars get _u<code>_ mangled", {
  // TS-equivalent mangling: `(` (40) → `_u40_`, `)` (41) → `_u41_`,
  // `*` (42) → `_u42_`. Collisions are avoided because each special
  // byte produces a distinct decimal-coded mangle.
  out := sanitize_for_c_identifier_str("Slice(u8)");
  assert(out == String.from("Slice_u40_u8_u41_"), "parens become _u40_/_u41_");
  out2 := sanitize_for_c_identifier_str("*(i32)");
  assert(out2 == String.from("_u42__u40_i32_u41_"), "star + parens");
});
test("extract_type_value: TypeVal yields inner type", {
  ev := EvalValue.TypeVal(box(t_i32()));
  match(
    extract_type_value(ev),
    .Some(ty) => match(
      ty,
      .Int(bits, signed) => {
        assert(bits == u8(32), "i32 bits=32");
        assert(signed, "i32 signed=true");
      },
      _ => assert(false, "expected Int variant")
    ),
    .None => assert(false, "expected Some")
  );
});
test("extract_type_value: non-TypeVal yields None", {
  ev := EvalValue.IntLit(String.from("42"));
  assert(extract_type_value(ev).is_none(), "IntLit is not TypeVal");
});
test("generate_typeid: returns None when no metadata is available", {
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(11), "i32", TokenKind.Identifier));
  // No expr_info_table installed → ctx.get_expr_info returns None →
  // generate_typeid returns None.
  result := generate_typeid(args, ctx);
  assert(result.is_none(), "no metadata → None");
});
test("generate_typeid: emits declaration and returns address expression", {
  ctx := CodegenContext.new();
  // Manually populate an ExprInfoTable: arg id 11 evaluates to TypeVal(i32).
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  info := new_expr_info(env, t_i32());
  info.value = Option(EvalValue).Some(EvalValue.TypeVal(box(t_i32())));
  expr_info_table_set(table, usize(11), info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(11), "i32", TokenKind.Identifier));
  result := generate_typeid(args, ctx);
  match(
    result,
    .None => assert(false, "expected Some when metadata present"),
    .Some(c_expr) => {
      assert(
        c_expr == String.from("(uintptr_t)&__yo_typeid_i32"),
        "address-of expression"
      );
    }
  );
  // Declaration must be in the declarations section.
  decls := ctx.emitter.declarations;
  assert(
    decls.contains(String.from("static const char __yo_typeid_i32 = 0;")),
    "declaration emitted"
  );
});
test("generate_typeid: deduplicates declaration on repeated calls", {
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  info_a := new_expr_info(env, t_i32());
  info_a.value = Option(EvalValue).Some(EvalValue.TypeVal(box(t_i32())));
  expr_info_table_set(table, usize(21), info_a);
  info_b := new_expr_info(env, t_i32());
  info_b.value = Option(EvalValue).Some(EvalValue.TypeVal(box(t_i32())));
  expr_info_table_set(table, usize(22), info_b);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args1 := ArrayList(AstExpr).new();
  args1.push(mk_atom(usize(21), "i32", TokenKind.Identifier));
  _ := generate_typeid(args1, ctx);
  args2 := ArrayList(AstExpr).new();
  args2.push(mk_atom(usize(22), "i32", TokenKind.Identifier));
  _ := generate_typeid(args2, ctx);
  // The declaration appears exactly once.
  decls := ctx.emitter.declarations;
  // Count occurrences of the static declaration line.
  needle := String.from("static const char __yo_typeid_i32 = 0;");
  (count : usize) = usize(0);
  (idx : usize) = usize(0);
  while(true, {
    match(
      decls.index_of(needle, idx),
      .None => {
        return(());
      },
      .Some(found) => {
        count = (count + usize(1));
        idx = (found + usize(1));
      }
    );
  });
  assert(count == usize(1), "exactly one declaration emitted across calls");
});
test("generate_typeid: adds <stdint.h> to ctx.c_includes", {
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from(""));
  info := new_expr_info(env, t_i32());
  info.value = Option(EvalValue).Some(EvalValue.TypeVal(box(t_i32())));
  expr_info_table_set(table, usize(31), info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  // Before invocation, c_includes is empty (or whatever the preamble
  // installs — currently empty by default since the preamble's static
  // includes don't flow through this set).
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(31), "i32", TokenKind.Identifier));
  _ := generate_typeid(args, ctx);
  // After: <stdint.h> is in the set because typeid expressions emit
  // `(uintptr_t)&...`, which needs the stdint header. Mirrors
  // `context.cIncludes.add("<stdint.h>")` in TS generateTypeid.
  assert(
    ctx.has_c_include(String.from("<stdint.h>")) == true,
    "<stdint.h> tracked"
  );
});
// ─── pure string formatters ─────────────────────────────────────────────────
test("format_typeid_static_name: prepends __yo_typeid_ to sanitized id", {
  out := format_typeid_static_name(String.from("i32"));
  assert(out == String.from("__yo_typeid_i32"), "static name shape");
});
test("format_typeid_static_decl: emits `static const char <name> = 0;`", {
  out := format_typeid_static_decl(String.from("__yo_typeid_i32"));
  assert(
    out == String.from("static const char __yo_typeid_i32 = 0;"),
    "static decl shape"
  );
});
test("format_typeid_address_expr: emits `(uintptr_t)&<name>`", {
  out := format_typeid_address_expr(String.from("__yo_typeid_i32"));
  assert(out == String.from("(uintptr_t)&__yo_typeid_i32"), "address expr shape");
});
