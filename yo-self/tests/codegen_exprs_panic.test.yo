/// Phase 13at — codegen panic handler test.
///
/// Exercises `yo-self/codegen/exprs/panic.yo` end-to-end with a populated
/// ExprInfoTable. Verifies:
///   - `panic()` emits `abort();` and returns the dummy expression.
///   - `panic("lit")` with a compile-time string emits an fprintf with the
///     quoted literal, then abort.
///   - `panic(rt_str_var)` with `str`-newtype metadata emits the
///     `fprintf("%.*s\n", (int)x.length, x.data)` path.
///   - With no metadata for the call expression, the handler returns `.None`.
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr, ast_expr_id } :: import("../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_new,
  expr_info_table_set
} :: import("../expr_info.yo");
{ Environment } :: import("../env.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ t_i32, t_bool } :: import("../types/creators.yo");
{ EvalValue } :: import("../value.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{ set_generate_expr_fn, call_gen_expr } :: import("../codegen/exprs/expr.yo");
{
  generate_panic,
  extract_comptime_string_value,
  quote_as_c_string,
  format_panic_abort_line,
  format_panic_fprintf_cstr,
  format_panic_fprintf_str_newtype,
  format_panic_unreachable_dummy
} :: import("../codegen/exprs/panic.yo");
{ is_str_type } :: import("../types/guards.yo");
mk_atom :: (fn(id : usize, value : str, kind : TokenKind) -> AstExpr)(
  AstExpr.Atom(
    id,
    Token(
      kind : kind,
      value : String.from(value),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from("test"),
      input : String.from("")
    )
  )
);
// A stub generate_expr that just emits the atom's token value as the C
// expression. Mirrors what the bootstrap dispatcher would do for a bare
// identifier — enough for the runtime-message path tests.
stub_generate_expr :: (
  fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    expr,
    .Atom(_, tok) => Option(String).Some(tok.value.clone()),
    .FnCall(_, _, _, _, _) => Option(String).Some(String.from("expr"))
  )
);
test("extract_comptime_string_value: StrLit yields raw", {
  ev := EvalValue.StrLit(String.from("\"hi\""));
  match(
    extract_comptime_string_value(ev),
    .Some(raw) => assert(raw == String.from("\"hi\""), "raw preserved"),
    .None => assert(false, "expected Some")
  );
});
test("extract_comptime_string_value: non-string yields None", {
  ev := EvalValue.IntLit(String.from("42"));
  assert(extract_comptime_string_value(ev).is_none(), "IntLit is not a string");
});
test("is_str_type: matches Struct(name=str, is_newtype=true)", {
  fl := ArrayList(String).new();
  ft := ArrayList(TypeValue).new();
  str_ty := TypeValue.Struct(
    String.from(""),
    String.from("str"),
    fl,
    ft,
    false,
    false,
    true
  );
  assert(is_str_type(str_ty), "str newtype detected");
});
test("is_str_type: rejects non-newtype Struct", {
  fl := ArrayList(String).new();
  ft := ArrayList(TypeValue).new();
  plain_ty := TypeValue.Struct(
    String.from(""),
    String.from("str"),
    fl,
    ft,
    false,
    false,
    false
  );
  assert(!(is_str_type(plain_ty)), "non-newtype rejected");
});
test("quote_as_c_string: strips surrounding quotes and escapes", {
  q := quote_as_c_string(String.from("\"hello\""));
  assert(q == String.from("\"hello\""), "literal already-quoted preserved");
  q2 := quote_as_c_string(String.from("hello"));
  assert(q2 == String.from("\"hello\""), "bare string wrapped in quotes");
  q3 := quote_as_c_string(String.from("line\nbreak"));
  assert(q3 == String.from("\"line\\nbreak\""), "newline escaped");
});
test("generate_panic: returns None when call expression has no metadata", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  call := AstExpr.FnCall(
    usize(31),
    box(mk_atom(usize(30), "panic", TokenKind.Identifier)),
    args,
    false,
    Token(
      kind : TokenKind.Identifier,
      value : String.from("panic"),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from("test"),
      input : String.from("")
    )
  );
  result := generate_panic(call, args, ctx, String.from(""));
  assert(result.is_none(), "no call metadata → None");
});
test("generate_panic: zero-arg panic emits abort and returns dummy of return type", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  // panic() return type recorded as i32.
  call_info := new_expr_info(env, t_i32());
  expr_info_table_set(table, usize(41), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  call := AstExpr.FnCall(
    usize(41),
    box(mk_atom(usize(40), "panic", TokenKind.Identifier)),
    args,
    false,
    Token(
      kind : TokenKind.Identifier,
      value : String.from("panic"),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from("test"),
      input : String.from("")
    )
  );
  result := generate_panic(call, args, ctx, String.from("  "));
  match(
    result,
    .None => assert(false, "expected Some"),
    .Some(c_expr) => assert(
      c_expr == String.from("(*((int32_t*)NULL))"),
      "dummy expression of return type"
    )
  );
  code := ctx.emitter.code;
  assert(code.contains(String.from("abort();")), "abort emitted");
  assert(!(code.contains(String.from("fprintf"))), "no fprintf for zero-arg form");
});
test("generate_panic: comptime string emits quoted fprintf + abort", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  call_info := new_expr_info(env, t_bool());
  expr_info_table_set(table, usize(51), call_info);
  arg_info := new_expr_info(env, t_i32());
  arg_info.value = Option(EvalValue).Some(EvalValue.StrLit(String.from("\"oops\\n\"")));
  expr_info_table_set(table, usize(50), arg_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(50), "\"oops\\n\"", TokenKind.StringLit));
  call := AstExpr.FnCall(
    usize(51),
    box(mk_atom(usize(52), "panic", TokenKind.Identifier)),
    args,
    false,
    Token(
      kind : TokenKind.Identifier,
      value : String.from("panic"),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from("test"),
      input : String.from("")
    )
  );
  result := generate_panic(call, args, ctx, String.from("  "));
  assert(result.is_some(), "comptime string path returns Some");
  match(
    result,
    .Some(c_expr) => assert(
      c_expr == String.from("(*((bool*)NULL))"),
      "dummy of bool"
    ),
    .None => ()
  );
  code := ctx.emitter.code;
  assert(
    code.contains(String.from("fprintf(stderr, \"%s\\n\", \"oops\\n\");")),
    "quoted message"
  );
  assert(code.contains(String.from("abort();")), "abort emitted");
});
// ─── pure-string formatters ─────────────────────────────────────────────────
test("format_panic_abort_line: prefixes indent before abort();", {
  out := format_panic_abort_line(String.from("  "));
  assert(out == String.from("  abort();"), "abort line shape");
});
test("format_panic_fprintf_cstr: composes fprintf(stderr, \"%s\\n\", <msg>);", {
  out := format_panic_fprintf_cstr(String.from("    "), String.from("msg"));
  assert(
    out == String.from("    fprintf(stderr, \"%s\\n\", msg);"),
    "fprintf cstr shape"
  );
});
test("format_panic_fprintf_str_newtype: composes %.*s with length and data", {
  out := format_panic_fprintf_str_newtype(String.from("  "), String.from("x"));
  assert(
    out == String.from("  fprintf(stderr, \"%.*s\\n\", (int)x.length, x.data);"),
    "fprintf str newtype shape"
  );
});
test("format_panic_unreachable_dummy: wraps return type in (*((T*)NULL))", {
  out := format_panic_unreachable_dummy(String.from("int32_t"));
  assert(out == String.from("(*((int32_t*)NULL))"), "dummy expression shape");
});
