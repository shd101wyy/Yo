  src := "arr := [true, false, true, false, true];\nnegated := arr.map((fn(x : bool) -> bool)(!(x)));\nresult := negated.filter((fn(x : bool) -> bool)(x));\nexport(result.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
