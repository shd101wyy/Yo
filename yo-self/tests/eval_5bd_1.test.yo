  // max of each pair: (1,4)→4, (3,2)→3, (5,5)→5, sum=12
  src := "a := [i32(1), i32(3), i32(5)];\nb := [i32(4), i32(2), i32(5)];\npairs := a.zip(b);\nmaxes := pairs.map((fn(p : (i32, i32)) -> i32)(cond((p.0 > p.1) => p.0, true => p.1)));\nresult := maxes.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(result);\n";
