        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "9", "9"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bdb: three-stage pipeline map-filter-fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1..8] → map x^2 → [1,4,9,16,25,36,49,64] → filter >15 → [16,25,36,49,64] → sum=190
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8)];\nsquares := arr.map((fn(x : i32) -> i32)((x * x)));\nlarge := squares.filter((fn(x : i32) -> bool)((x > i32(15))));\nresult := large.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "190", "190"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bdb: apply two-arg fn to compute range sum via fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // clamp(x,lo,hi): clamp each [0,5,10,15,20] to [2,12] → [2,5,10,12,12], sum=41
  src := "arr := [i32(0), i32(5), i32(10), i32(15), i32(20)];\nclamp_lo := i32(2);\nclamp_hi := i32(12);\nclamped := arr.map((fn(x : i32) -> i32)(cond((x < clamp_lo) => clamp_lo, (x > clamp_hi) => clamp_hi, true => x)));\nresult := clamped.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "41", "41"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5bdc — boolean logic trees
// ---------------------------------------------------------------------------
test("Phase 5bdc: all elements satisfy predicate via fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // all [2,4,6,8] are even → true
  src := "arr := [i32(2), i32(4), i32(6), i32(8)];\nresult := arr.fold(true, (fn(acc : bool, x : i32) -> bool)((acc && ((x % i32(2)) == i32(0)))));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "true"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

