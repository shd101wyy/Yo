    )
  );
  // words with 'e': "apple","cherry","lemon" (3); weights [10,20,30]; zip → sum weighted = 10+20+30=60
  src := "words := [\"apple\", \"banana\", \"cherry\", \"mango\", \"lemon\"];\nhas_e := words.filter((fn(w : str) -> bool)(w.contains(\"e\")));\nweights := [i32(10), i32(20), i32(30)];\npairs := has_e.zip(weights);\nresult := pairs.fold(i32(0), (fn(acc : i32, p : (str, i32)) -> i32)((acc + p.1)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "60", "60"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bde: while squares + cond classify + fold grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // squares of [1,2,3,4,5] = [1,4,9,16,25], classify ≥10→1 else 0: [0,0,0,1,1], sum=2
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nsquares := arr.map((fn(x : i32) -> i32)((x * x)));\ncodes := squares.map((fn(x : i32) -> i32)(cond((x >= i32(10)) => i32(1), true => i32(0))));\nresult := codes.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
