test("Phase 5bdd: cond multi-branch FizzBuzz code for 15", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // FizzBuzz code: divisible by 15 → 3, by 3 → 1, by 5 → 2, else → 0; for n=15 → 3
  src := "n := i32(15);\nresult := cond(((n % i32(15)) == i32(0)) => i32(3), ((n % i32(3)) == i32(0)) => i32(1), ((n % i32(5)) == i32(0)) => i32(2), true => i32(0));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bdd: recursive cond-based sign function", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // sign(-3)=-1, sign(0)=0, sign(5)=1; sum = -1+0+1 = 0 ... use abs instead
  // abs_val([3,1,4]) via fold = 8
  src := "abs_val := (fn(x : i32) -> i32)(cond((x < i32(0)) => (i32(0) - x), true => x));\narr := [i32(3), i32(1), i32(4)];\nresult := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + abs_val(x))));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "8", "8"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

