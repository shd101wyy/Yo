// ---------------------------------------------------------------------------
// Phase 5bdd — nested cond patterns
// ---------------------------------------------------------------------------
test("Phase 5bdd: classify numbers into buckets via nested cond", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // classify [1,5,10,50,100] as 0=tiny(<5), 1=small(<20), 2=large; sum codes = 0+0+1+2+2 = 5
  src := "arr := [i32(1), i32(5), i32(10), i32(50), i32(100)];\ncodes := arr.map((fn(x : i32) -> i32)(cond((x < i32(5)) => i32(0), (x < i32(20)) => i32(1), true => i32(2))));\nresult := codes.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "6"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

