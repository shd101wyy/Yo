          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bdb: map with double then filter positives then fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // map [1,2,3,4,5] with x*2-5: [-3,-1,1,3,5], filter >0: [1,3,5], sum=9
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5)];\ntransformed := arr.map((fn(x : i32) -> i32)(((x * i32(2)) - i32(5))));\npositive := transformed.filter((fn(x : i32) -> bool)((x > i32(0))));\nresult := positive.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(result);\n";
