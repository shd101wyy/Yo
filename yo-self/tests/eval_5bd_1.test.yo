test("Phase 5bde: recursive pow + map + fold grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // pow(2,1)=2, pow(2,2)=4, pow(2,3)=8, pow(2,4)=16; sum = 30
  src := "pow :: (fn(base : i32, exp : i32) -> i32)(cond((exp <= i32(0)) => i32(1), true => (base * recur(base, (exp - i32(1))))));\nexps := [i32(1), i32(2), i32(3), i32(4)];\nvalues := exps.map((fn(e : i32) -> i32)(pow(i32(2), e)));\nresult := values.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "30", "30"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

