/// Tests for yo-self/codegen/exprs/return.yo (partial port — pure
/// Token/AstExpr helpers).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../lexer/token.yo");
{ AstExpr } :: import("../expr/expr.yo");
{
  tokens_are_comparable,
  token_is_at_or_before,
  get_last_comparable_token_in_expr,
  variable_was_consumed_before_cleanup_point
} :: import("../codegen/exprs/return.yo");
/// Build a Token with the given character offset; module/input default
/// to the same fixture so by default tokens are `comparable`.
make_tok :: (fn(ch : usize) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from("v"),
    row : usize(0),
    column : ch,
    character : ch,
    module_path : String.from("M"),
    input : String.from("S")
  )
);
/// Build a Token with custom module and input strings.
make_tok_at :: (fn(ch : usize, m : String, s : String) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from("v"),
    row : usize(0),
    column : ch,
    character : ch,
    module_path : m,
    input : s
  )
);
test("tokens_are_comparable: same module + input ⇒ true", {
  a := make_tok(usize(0));
  b := make_tok(usize(10));
  assert(tokens_are_comparable(a, b), "same module + input");
});
test("tokens_are_comparable: different module ⇒ false", {
  a := make_tok_at(usize(0), String.from("A"), String.from("S"));
  b := make_tok_at(usize(0), String.from("B"), String.from("S"));
  assert(!(tokens_are_comparable(a, b)), "different module");
});
test("tokens_are_comparable: different input ⇒ false", {
  a := make_tok_at(usize(0), String.from("M"), String.from("S1"));
  b := make_tok_at(usize(0), String.from("M"), String.from("S2"));
  assert(!(tokens_are_comparable(a, b)), "different input");
});
test("token_is_at_or_before: equal characters ⇒ true", {
  a := make_tok(usize(5));
  b := make_tok(usize(5));
  assert(token_is_at_or_before(a, b), "equal");
});
test("token_is_at_or_before: a before b ⇒ true", {
  a := make_tok(usize(3));
  b := make_tok(usize(7));
  assert(token_is_at_or_before(a, b), "a < b");
});
test("token_is_at_or_before: a after b ⇒ false", {
  a := make_tok(usize(9));
  b := make_tok(usize(2));
  assert(!(token_is_at_or_before(a, b)), "a > b");
});
test("token_is_at_or_before: non-comparable ⇒ false even when before", {
  a := make_tok_at(usize(0), String.from("A"), String.from("S"));
  b := make_tok_at(usize(10), String.from("B"), String.from("S"));
  assert(!(token_is_at_or_before(a, b)), "non-comparable");
});
test("get_last_comparable_token_in_expr: Atom returns its own token", {
  tok := make_tok(usize(4));
  expr := AstExpr.Atom(usize(0), tok);
  ref := make_tok(usize(0));
  last := get_last_comparable_token_in_expr(expr, ref);
  assert(last.character == usize(4), "atom token surfaces");
});
test("get_last_comparable_token_in_expr: FnCall finds latest arg token", {
  func_tok := make_tok(usize(2));
  arg0_tok := make_tok(usize(5));
  arg1_tok := make_tok(usize(11));
  arg2_tok := make_tok(usize(8));
  args := ArrayList(AstExpr).new();
  args.push(AstExpr.Atom(usize(0), arg0_tok));
  args.push(AstExpr.Atom(usize(0), arg1_tok));
  args.push(AstExpr.Atom(usize(0), arg2_tok));
  func := AstExpr.Atom(usize(0), func_tok);
  call := AstExpr.FnCall(usize(0), box(func), args, false, func_tok);
  ref := make_tok(usize(0));
  last := get_last_comparable_token_in_expr(call, ref);
  assert(last.character == usize(11), "max(2,5,11,8) == 11");
});
test("get_last_comparable_token_in_expr: ignores incomparable tokens", {
  // The FnCall root is comparable (module/input "M"/"S") but an arg
  // belongs to a different module — that arg must be skipped.
  call_tok := make_tok(usize(3));
  good_arg := make_tok(usize(6));
  alien_arg := make_tok_at(usize(99), String.from("OTHER"), String.from("S"));
  args := ArrayList(AstExpr).new();
  args.push(AstExpr.Atom(usize(0), good_arg));
  args.push(AstExpr.Atom(usize(0), alien_arg));
  func := AstExpr.Atom(usize(0), call_tok);
  call := AstExpr.FnCall(usize(0), box(func), args, false, call_tok);
  ref := make_tok(usize(0));
  last := get_last_comparable_token_in_expr(call, ref);
  assert(last.character == usize(6), "alien arg ignored");
});
test("variable_was_consumed_before_cleanup_point: same module, consumed before ⇒ true", {
  consumed := make_tok(usize(2));
  cleanup_expr := AstExpr.Atom(usize(0), make_tok(usize(8)));
  assert(
    variable_was_consumed_before_cleanup_point(consumed, cleanup_expr),
    "2 ≤ 8 ⇒ consumed before"
  );
});
test("variable_was_consumed_before_cleanup_point: consumed after ⇒ false", {
  consumed := make_tok(usize(20));
  cleanup_expr := AstExpr.Atom(usize(0), make_tok(usize(5)));
  assert(
    !(variable_was_consumed_before_cleanup_point(consumed, cleanup_expr)),
    "20 > 5 ⇒ not before"
  );
});
test("variable_was_consumed_before_cleanup_point: incomparable ⇒ false", {
  consumed := make_tok_at(usize(0), String.from("A"), String.from("S"));
  cleanup_expr := AstExpr.Atom(
    usize(0),
    make_tok_at(usize(0), String.from("B"), String.from("S"))
  );
  assert(
    !(variable_was_consumed_before_cleanup_point(consumed, cleanup_expr)),
    "incomparable ⇒ false"
  );
});
