/// Tests for yo-self/codegen/exprs/property_access.yo (partial port).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue, t_i32 } :: import("../types/type.yo");
{ generate_newtype_field_access } :: import("../codegen/exprs/property_access.yo");
/// Build a single-field newtype struct with the given field label.
mk_newtype_struct :: (fn(name : str, field_label : str) -> TypeValue)({
  field_labels := ArrayList(String).new();
  field_labels.push(String.from(field_label));
  field_types := ArrayList(TypeValue).new();
  field_types.push(t_i32());
  TypeValue.Struct(
    String.from(""),
    String.from(name),
    field_labels,
    field_types,
    false,
    false,
    true
  )
});
/// Build a non-newtype struct with the given field labels.
mk_plain_struct :: (fn(name : str, labels : ArrayList(String)) -> TypeValue)({
  types := ArrayList(TypeValue).new();
  i := usize(0);
  while(runtime(i < labels.len()), {
    types.push(t_i32());
    i = (i + usize(1));
  });
  TypeValue.Struct(
    String.from(""),
    String.from(name),
    labels,
    types,
    false,
    false,
    false
  )
});
test("newtype field access: single-field newtype passes through", {
  ty := mk_newtype_struct("UserId", "value");
  out := generate_newtype_field_access(
    String.from("u"),
    ty,
    String.from("value")
  );
  match(
    out,
    .Some(s) => assert(s == String.from("u"), "object_code returned"),
    .None => assert(false, "expected Some")
  );
});
test("newtype field access: field-name mismatch → None", {
  ty := mk_newtype_struct("UserId", "value");
  out := generate_newtype_field_access(
    String.from("u"),
    ty,
    String.from("wrong")
  );
  assert(out.is_none(), "wrong field → None");
});
test("newtype field access: non-newtype struct → None", {
  labels := ArrayList(String).new();
  labels.push(String.from("x"));
  ty := mk_plain_struct("Point", labels);
  out := generate_newtype_field_access(
    String.from("p"),
    ty,
    String.from("x")
  );
  assert(out.is_none(), "plain struct → None");
});
test("newtype field access: primitive types → None", {
  out := generate_newtype_field_access(
    String.from("n"),
    t_i32(),
    String.from("value")
  );
  assert(out.is_none(), "i32 → None");
});
