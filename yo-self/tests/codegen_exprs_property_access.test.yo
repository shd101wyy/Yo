/// Tests for yo-self/codegen/exprs/property_access.yo (partial port).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue } :: import("../types/definitions.yo");
{ t_i32 } :: import("../types/creators.yo");
{ EvalValue } :: import("../value.yo");
{ Token, TokenKind } :: import("../token.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{
  generate_newtype_field_access,
  generate_method_field_access,
  format_ptr_deref,
  format_ptr_to_slice_field_access
} :: import("../codegen/exprs/property_access.yo");
/// Build a single-field newtype struct with the given field label.
mk_newtype_struct :: (fn(name : str, field_label : str) -> TypeValue)({
  field_labels := ArrayList(String).new();
  field_labels.push(String.from(field_label));
  field_types := ArrayList(TypeValue).new();
  field_types.push(t_i32());
  TypeValue.Struct(
    String.from(""),
    String.from(name),
    field_labels,
    field_types,
    false,
    false,
    true
  )
});
/// Build a non-newtype struct with the given field labels.
mk_plain_struct :: (fn(name : str, labels : ArrayList(String)) -> TypeValue)({
  types := ArrayList(TypeValue).new();
  i := usize(0);
  while(i < labels.len(), {
    types.push(t_i32());
    i = (i + usize(1));
  });
  TypeValue.Struct(
    String.from(""),
    String.from(name),
    labels,
    types,
    false,
    false,
    false
  )
});
test("newtype field access: single-field newtype passes through", {
  ty := mk_newtype_struct("UserId", "value");
  out := generate_newtype_field_access(
    String.from("u"),
    ty,
    String.from("value")
  );
  match(
    out,
    .Some(s) => assert(s == String.from("u"), "object_code returned"),
    .None => assert(false, "expected Some")
  );
});
test("newtype field access: field-name mismatch → None", {
  ty := mk_newtype_struct("UserId", "value");
  out := generate_newtype_field_access(
    String.from("u"),
    ty,
    String.from("wrong")
  );
  assert(out.is_none(), "wrong field → None");
});
test("newtype field access: non-newtype struct → None", {
  labels := ArrayList(String).new();
  labels.push(String.from("x"));
  ty := mk_plain_struct("Point", labels);
  out := generate_newtype_field_access(
    String.from("p"),
    ty,
    String.from("x")
  );
  assert(out.is_none(), "plain struct → None");
});
test("newtype field access: primitive types → None", {
  out := generate_newtype_field_access(
    String.from("n"),
    t_i32(),
    String.from("value")
  );
  assert(out.is_none(), "i32 → None");
});
// ─── generate_method_field_access ───────────────────────────────────────────
mk_func_val :: (fn(id : str) -> EvalValue)(
  EvalValue.FuncVal(
    forall_names : ArrayList(String).new(),
    params : ArrayList(String).new(),
    param_type_names : ArrayList(String).new(),
    evidence_params : ArrayList(String).new(),
    body : box(.Atom(usize(0), Token(kind : TokenKind.Identifier, value : String.from(""), row : usize(0), column : usize(0), character : usize(0), module_path : String.from(""), input : String.from("")))),
    cap_names : ArrayList(String).new(),
    cap_tys : ArrayList(TypeValue).new(),
    cap_vals : ArrayList(EvalValue).new(),
    func_id : String.from(id)
  )
);
test("method field access: registered FuncVal → C name", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  fv := mk_func_val("greet_id");
  pctx.register_function(String.from("greet_id"), fv, String.from("fn_greet"));
  match(
    generate_method_field_access(fv, pctx),
    .Some(s) => assert(s == String.from("fn_greet"), "registered c_name"),
    .None => assert(false, "expected Some")
  );
});
test("method field access: unregistered FuncVal → fallback to func_id", {
  // Mirrors the TS `?? functionValue.funcId` short-circuit when the
  // function value hasn't been registered yet.
  ctx := CodegenContext.new();
  fv := mk_func_val("orphan_id");
  match(
    generate_method_field_access(fv, ctx),
    .Some(s) => assert(s == String.from("orphan_id"), "fallback to func_id"),
    .None => assert(false, "expected Some(func_id fallback)")
  );
});
test("method field access: non-FuncVal → None", {
  // The handler is a sentinel for the FuncVal-only branch. Anything
  // else (a struct value, an enum, etc.) returns None so the caller
  // defers to the bootstrap struct/field-access path.
  ctx := CodegenContext.new();
  assert(
    generate_method_field_access(EvalValue.IntLit(String.from("0")), ctx).is_none(),
    "IntLit → None"
  );
  assert(
    generate_method_field_access(EvalValue.UnitVal, ctx).is_none(),
    "UnitVal → None"
  );
});
// ─── pointer-deref / pointer-to-slice formatters ────────────────────────────
test("format_ptr_deref: parenthesises (*obj)", {
  // The parens matter: `(*ptr)` parses as a primary expression while
  // `*ptr` could chain with member access incorrectly. Mirrors TS
  // `return `(*${objectCode})`;`.
  assert(format_ptr_deref(String.from("p")) == String.from("(*p)"), "simple");
  assert(
    format_ptr_deref(String.from("a + b")) == String.from("(*a + b)"),
    "no inner parens"
  );
});
test("format_ptr_to_slice_field_access: arrow + sanitised name", {
  // `obj->field` plain identifier case.
  out := format_ptr_to_slice_field_access(
    String.from("slc"),
    String.from("length")
  );
  assert(out == String.from("slc->length"), "plain field");
});
test("format_ptr_to_slice_field_access: field name with operator chars", {
  // Sanitisation kicks in for non-identifier chars in the field name.
  // (e.g. an operator field used in a slice-like binding). Pin that
  // the formatter routes through sanitize_for_c_identifier.
  out := format_ptr_to_slice_field_access(
    String.from("slc"),
    String.from("+")
  );
  // `+` is byte 43 — `sanitize_for_c_identifier` produces `_u43_`.
  assert(out == String.from("slc->_u43_"), "operator sanitised");
});
