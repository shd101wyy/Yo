/// Tests for yo-self/codegen/exprs/match.yo (partial port — pure
/// helpers).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../lexer/token.yo");
{ AstExpr } :: import("../expr.yo");
{ EvalValue } :: import("../evaluator/value.yo");
{
  is_control_flow_code,
  is_or_pattern,
  flatten_or_pattern,
  c_literal_from_eval_value
} :: import("../codegen/exprs/match.yo");
mk_token :: (fn(value : str) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
mk_atom :: (fn(value : str) -> AstExpr)(
  AstExpr.Atom(usize(0), mk_token(value))
);
/// Build a 2-arg `|` infix FnCall (the shape of an or-pattern).
mk_or :: (fn(left : AstExpr, right : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(left);
  args.push(right);
  AstExpr.FnCall(
    usize(0),
    box(mk_atom("|")),
    args,
    true,
    mk_token("|")
  )
});
test("is_control_flow_code: empty string", {
  assert(is_control_flow_code(String.from("")), "empty");
});
test("is_control_flow_code: break / continue", {
  assert(is_control_flow_code(String.from("break")), "break");
  assert(is_control_flow_code(String.from("continue")), "continue");
});
test("is_control_flow_code: goto prefix", {
  assert(is_control_flow_code(String.from("goto exit_label")), "goto");
});
test("is_control_flow_code: bare return keyword in stmt", {
  assert(is_control_flow_code(String.from("return x;")), "return stmt");
  assert(is_control_flow_code(String.from("if (cond) return;")), "return after if");
});
test("is_control_flow_code: `return` as identifier suffix is NOT control flow", {
  // `return_flag = 1` is a normal assignment, not a control flow exit.
  assert(
    !(is_control_flow_code(String.from("return_flag = 1"))),
    "return_flag → false"
  );
  assert(
    !(is_control_flow_code(String.from("noreturn_thing"))),
    "noreturn_thing → false"
  );
});
test("is_control_flow_code: regular expression is not control flow", {
  assert(
    !(is_control_flow_code(String.from("x + 1"))),
    "x + 1 → false"
  );
  assert(
    !(is_control_flow_code(String.from("foo(bar)"))),
    "function call → false"
  );
});
test("is_or_pattern: |-infix call returns true", {
  expr := mk_or(mk_atom("A"), mk_atom("B"));
  assert(is_or_pattern(expr), "or-pattern matched");
});
test("is_or_pattern: bare atom returns false", {
  assert(!(is_or_pattern(mk_atom("A"))), "atom is not or-pattern");
});
test("flatten_or_pattern: single atom yields singleton", {
  out := flatten_or_pattern(mk_atom("A"));
  assert(out.len() == usize(1), "singleton");
});
test("flatten_or_pattern: A | B yields [A, B]", {
  expr := mk_or(mk_atom("A"), mk_atom("B"));
  out := flatten_or_pattern(expr);
  assert(out.len() == usize(2), "two elements");
});
test("flatten_or_pattern: (A | B) | C yields [A, B, C]", {
  inner := mk_or(mk_atom("A"), mk_atom("B"));
  expr := mk_or(inner, mk_atom("C"));
  out := flatten_or_pattern(expr);
  assert(out.len() == usize(3), "three elements");
});
test("flatten_or_pattern: A | (B | C) yields [A, B, C]", {
  inner := mk_or(mk_atom("B"), mk_atom("C"));
  expr := mk_or(mk_atom("A"), inner);
  out := flatten_or_pattern(expr);
  assert(out.len() == usize(3), "three elements");
});
test("c_literal_from_eval_value: BoolVal(true) → \"true\"", {
  match(
    c_literal_from_eval_value(EvalValue.BoolVal(true)),
    .Some(s) => assert(s == String.from("true"), "true"),
    .None => assert(false, "expected Some")
  );
});
test("c_literal_from_eval_value: BoolVal(false) → \"false\"", {
  match(
    c_literal_from_eval_value(EvalValue.BoolVal(false)),
    .Some(s) => assert(s == String.from("false"), "false"),
    .None => assert(false, "expected Some")
  );
});
test("c_literal_from_eval_value: IntLit raw text passes through", {
  match(
    c_literal_from_eval_value(EvalValue.IntLit(String.from("42"))),
    .Some(s) => assert(s == String.from("42"), "42"),
    .None => assert(false, "expected Some")
  );
  match(
    c_literal_from_eval_value(EvalValue.IntLit(String.from("0xFF"))),
    .Some(s) => assert(s == String.from("0xFF"), "0xFF"),
    .None => assert(false, "expected Some")
  );
});
test("c_literal_from_eval_value: UnitVal / other variants → None", {
  assert(
    c_literal_from_eval_value(EvalValue.UnitVal).is_none(),
    "UnitVal → None"
  );
  assert(
    c_literal_from_eval_value(EvalValue.StrLit(String.from("\"x\""))).is_none(),
    "StrLit → None"
  );
});
