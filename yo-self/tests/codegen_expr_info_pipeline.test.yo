/// Phase 13at step 2 — end-to-end smoke test for the typed-AST pipeline.
///
/// Demonstrates that the proper evaluator (`evaluator/exprs/_expr.yo`)
/// populates `EvalContext.expr_info_table`, and that the same table can be
/// installed on `CodegenContext` so codegen handlers can call
/// `get_expr_info(id)` and observe the metadata.
///
/// This is the smallest vertical slice of the pipeline that actually
/// produces non-`.None` metadata at codegen time. Wiring this into
/// `yo-self/main.yo`'s compile flow comes in a follow-up step.
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr, ast_expr_id } :: import("../expr.yo");
{ Environment } :: import("../env.yo");
{ EvalContext, eval_context_new } :: import("../evaluator/context.yo");
{ EvalValue, is_type_val } :: import("../evaluator/value.yo");
{
  set_evaluate_expression_fn,
  set_evaluate_expression_raw_fn
} :: import("../evaluator/exprs/expr.yo");
{
  _evaluate_expression_wrapper,
  _evaluate_expression_raw_wrapper
} :: import("../evaluator/exprs/_expr.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{ Exception } :: import("std/error");
mk_ident_token :: (fn(value : str) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);
mk_ident :: (fn(id : usize, name : str) -> AstExpr)(
  AstExpr.Atom(id, mk_ident_token(name))
);
test("Phase 13at step 2: proper evaluator populates table, codegen reads it", {
  // Register the real evaluator (not the stub used by handler tests).
  set_evaluate_expression_fn(_evaluate_expression_wrapper);
  set_evaluate_expression_raw_fn(_evaluate_expression_raw_wrapper);
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error from real evaluator");
        escape(());
      }
    )
  );
  // Evaluate the builtin keyword `i32` — produces a TypeVal annotated
  // on the resulting AstExpr via the ExprInfoTable.
  env := Environment.new(String.from("test"));
  ectx := eval_context_new(String.from(""), String.from("test"));
  expr := mk_ident(usize(7), "i32");
  _ := _evaluate_expression_wrapper(expr, env, &(ectx));
  // Hand the populated table to a CodegenContext and verify the
  // get_expr_info accessor returns the metadata the evaluator recorded.
  cctx := CodegenContext.new();
  cctx.expr_info_table = Option(typeof(ectx.expr_info_table)).Some(ectx.expr_info_table);
  info_opt := (&(cctx)).get_expr_info(usize(7));
  assert(info_opt.is_some(), "codegen sees expr info for id 7");
  match(
    info_opt,
    .Some(info) => {
      assert(info.value.is_some(), "value present (typeof i32 is TypeVal)");
      match(
        info.value,
        .Some(v) => assert(is_type_val(v), "value is TypeVal"),
        .None => assert(false, "unexpected None")
      );
    },
    .None => assert(false, "unexpected None from accessor")
  );
});
test("Phase 13at step 2: codegen falls back to None for unevaluated expressions", {
  // CodegenContext with a populated table but query an id that the
  // evaluator never visited. Must return .None — the lock-in for the
  // graceful-fallback contract handlers rely on.
  cctx := CodegenContext.new();
  // Leave expr_info_table at its default .None.
  result := (&(cctx)).get_expr_info(usize(99));
  assert(result.is_none(), "no table installed → .None");
  // Also check that when a table IS installed but the id is missing,
  // get_expr_info still returns .None.
  ectx := eval_context_new(String.from(""), String.from("test"));
  cctx.expr_info_table = Option(typeof(ectx.expr_info_table)).Some(ectx.expr_info_table);
  result2 := (&(cctx)).get_expr_info(usize(99));
  assert(result2.is_none(), "table installed but id missing → .None");
});
