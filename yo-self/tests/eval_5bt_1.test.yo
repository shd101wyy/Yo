          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5btb: product of elements at 1-indexed positions divisible by 3 in [3,1,4,1,5,9,2,6] = 36", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // pos 3 => val 4, pos 6 => val 9 => 4*9=36
  src := "arr := [i32(3), i32(1), i32(4), i32(1), i32(5), i32(9), i32(2), i32(6)];\ni := i32(0);\nprod := i32(1);\nwhile((i < i32(8)), {\npos := (i + i32(1));\nis3 := cond(((pos % i32(3)) == i32(0)) => i32(1), true => i32(0));\nv := arr.get(i).unwrap();\nprod = cond((is3 == i32(1)) => (prod * v), true => prod);\ni = (i + i32(1));\n});\nexport(prod);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "36", "36"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
