test("Phase 5btd: tri_sum + odd_sq_sum + perf_sq_count = 56+165+5 = 226", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "k := i32(1);\ns1 := i32(0);\nwhile((k <= i32(6)), {\ntri := (k * (k + i32(1)));\nhalf := (tri / i32(2));\ns1 = (s1 + half);\nk = (k + i32(1));\n});\nk2 := i32(0);\ns2 := i32(0);\nwhile((k2 < i32(5)), {\nodd := ((i32(2) * k2) + i32(1));\ns2 = (s2 + (odd * odd));\nk2 = (k2 + i32(1));\n});\ncnt := i32(0);\nsq := i32(1);\nssq := i32(1);\nwhile((ssq <= i32(30)), {\ncnt = (cnt + i32(1));\nsq = (sq + i32(1));\nssq = (sq * sq);\n});\nresult := ((s1 + s2) + cnt);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "226", "226"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
