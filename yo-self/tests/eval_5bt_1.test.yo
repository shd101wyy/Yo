// @skip_wasm32-emscripten
// @skip_wasm32-wasi
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
empty_env :: (fn() -> Environment)(Environment.new(`test`));

// ---------------------------------------------------------------------------
// Phase 5bta — triangle numbers, odd squares, perfect squares, max-of-pair
// ---------------------------------------------------------------------------
test("Phase 5bta: sum of triangle numbers T(k)=k*(k+1)/2 for k=1..6 = 56", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // T(1)+T(2)+...+T(6) = 1+3+6+10+15+21 = 56
  src := "k := i32(1);\ns := i32(0);\nwhile((k <= i32(6)), {\ntri := (k * (k + i32(1)));\nhalf := (tri / i32(2));\ns = (s + half);\nk = (k + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "56", "56"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bta: sum of squares of first 5 odd numbers = 165", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 1^2+3^2+5^2+7^2+9^2 = 1+9+25+49+81 = 165
  src := "k := i32(0);\ns := i32(0);\nwhile((k < i32(5)), {\nodd := ((i32(2) * k) + i32(1));\ns = (s + (odd * odd));\nk = (k + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "165", "165"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bta: count perfect squares <= 30 = 5", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 1,4,9,16,25 => 5
  src := "cnt := i32(0);\nsq := i32(1);\nssq := i32(1);\nwhile((ssq <= i32(30)), {\ncnt = (cnt + i32(1));\nsq = (sq + i32(1));\nssq = (sq * sq);\n});\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "5"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bta: sum of max(n, 11-n) for n=1..10 = 80", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // max(1,10)+max(2,9)+...+max(5,6)+max(6,5)+...+max(10,1) = 10+9+8+7+6+6+7+8+9+10 = 80
  src := "i := i32(1);\ns := i32(0);\nwhile((i <= i32(10)), {\na := i;\nb := (i32(11) - i);\nm := cond((a > b) => a, true => b);\ns = (s + m);\ni = (i + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "80", "80"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5btb — array index/value patterns
// ---------------------------------------------------------------------------
test("Phase 5btb: sum elements where both index and value are even in [3,1,4,1,5,9,2,6] = 6", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // even idx: 0(v=3,odd),2(v=4,even),4(v=5,odd),6(v=2,even) => 4+2=6
  src := "arr := [i32(3), i32(1), i32(4), i32(1), i32(5), i32(9), i32(2), i32(6)];\ni := i32(0);\ns := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap();\nei := cond(((i % i32(2)) == i32(0)) => i32(1), true => i32(0));\nev := cond(((v % i32(2)) == i32(0)) => i32(1), true => i32(0));\ns = (s + ((ei * ev) * v));\ni = (i + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "6"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
