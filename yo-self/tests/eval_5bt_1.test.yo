});

// ---------------------------------------------------------------------------
// Phase 5btc — index-value comparisons, coprime, abs-diff, running avg
// ---------------------------------------------------------------------------
test("Phase 5btc: sum elements where val <= 1-indexed position in [3,1,4,1,5,9,2,6] = 15", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // pos2:1, pos4:1, pos5:5, pos7:2, pos8:6 => 1+1+5+2+6=15
  src := "arr := [i32(3), i32(1), i32(4), i32(1), i32(5), i32(9), i32(2), i32(6)];\ni := i32(0);\ns := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap();\npos := (i + i32(1));\nle := cond((v <= pos) => i32(1), true => i32(0));\ns = (s + (le * v));\ni = (i + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "15", "15"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5btc: count elements coprime with 6 in [3,1,4,1,5,9,2,6] = 3", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // coprime with 6 (not div by 2 or 3): 1,1,5 => 3
  src := "arr := [i32(3), i32(1), i32(4), i32(1), i32(5), i32(9), i32(2), i32(6)];\ni := i32(0);\ncnt := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap();\nnd2 := cond(((v % i32(2)) != i32(0)) => i32(1), true => i32(0));\nnd3 := cond(((v % i32(3)) != i32(0)) => i32(1), true => i32(0));\ncnt = (cnt + (nd2 * nd3));\ni = (i + i32(1));\n});\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
