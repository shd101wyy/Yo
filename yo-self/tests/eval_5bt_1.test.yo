});
test("Phase 5btc: sum of running floor-averages of [3,1,4,1,5,9,2,6] = 20", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // floor(3/1)+floor(4/2)+floor(8/3)+floor(9/4)+floor(14/5)+floor(23/6)+floor(25/7)+floor(31/8)
  // = 3+2+2+2+2+3+3+3 = 20
  src := "arr := [i32(3), i32(1), i32(4), i32(1), i32(5), i32(9), i32(2), i32(6)];\ni := i32(0);\ns := i32(0);\nrs := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap();\nrs = (rs + v);\nk := (i + i32(1));\ns = (s + (rs / k));\ni = (i + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
