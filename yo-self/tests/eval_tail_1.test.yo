test("Phase 5q: cond with multiple arms evaluates correct branch", {
  // x := 5; cond((x < 0) => -1, (x == 0) => 0, true => 1) => IntLit(1)
  env := empty_env();
  stmts := ArrayList(AstExpr).new();
  stmts.push(make_infix(String.from(":="), make_atom(TokenKind.Identifier, String.from("x")), make_atom(TokenKind.Integer, String.from("5"))));
  arms := ArrayList(AstExpr).new();
  arms.push(
    make_arm(
      make_infix(String.from("<"), make_atom(TokenKind.Identifier, String.from("x")), make_atom(TokenKind.Integer, String.from("0"))),
      make_atom(TokenKind.Integer, String.from("-1"))
    )
  );
  arms.push(
    make_arm(
      make_infix(String.from("=="), make_atom(TokenKind.Identifier, String.from("x")), make_atom(TokenKind.Integer, String.from("0"))),
      make_atom(TokenKind.Integer, String.from("0"))
    )
  );
  arms.push(
    make_arm(
      make_atom(TokenKind.Bool, String.from("true")),
      make_atom(TokenKind.Integer, String.from("1"))
    )
  );
  stmts.push(make_cond(arms));
  block := make_begin(stmts);
  result := evaluate(block, env);
  match(
    result,
    .None => assert(false, "cond returned None"),
    .Some(r) => match(
      r.value,
      .IntLit(n) => assert(n == "1", "expected 1 from true branch"),
      _ => assert(false, "expected IntLit(1)")
    )
  );
});
