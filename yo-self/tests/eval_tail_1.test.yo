pragma(Pragma.SkipWasm32Wasi); // split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator core — Phase 3a/3b/3c/3d (literals + identifier lookup +
/// begin/cond/define/assign + arithmetic/comparison/boolean operators +
/// enum variant construction + match + while loops) through Phase 3ah
/// (integer div/mod + function composition + string equality + impl method call).
pragma(Pragma.AllowUnsafe);
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ TokenKind, Token } :: import("../token.yo");
{
  AstExpr,
  BK_BEGIN,
  BK_TUPLE,
  BK_ANON_STRUCT,
  BK_EXPORT,
  BK_OPEN,
  BK_IMPORT,
  BK_ENUM,
  BK_STRUCT,
  BK_NEWTYPE,
  BK_UNION,
  BK_TRAIT,
  BK_ARRAY_VAL
} :: import("../expr.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ type_value_tag, t_i32, t_bool, t_u32, t_f32, t_type, t_unit, t_comptime_int, t_comptime_float, t_comptime_string } :: import("../types/creators.yo");
{ TypeTag } :: import("../types/tags.yo");
{ Environment } :: import("../env.yo");
{ EvalValue, EvalResult } :: import("../value.yo");
{ evaluate, parse_raw_int, evaluate_module_body, set_module_loader } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
make_token :: (fn(kind : TokenKind, value : String) -> Token)(
  Token(
    kind : kind,
    value : value.clone(),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
make_atom :: (fn(kind : TokenKind, value : String) -> AstExpr)(
  .Atom(usize(0), make_token(kind, value))
);
make_ident :: (fn(name : String) -> AstExpr)(
  make_atom(TokenKind.Identifier, name)
);
make_infix :: (fn(op : String, lhs : AstExpr, rhs : AstExpr) -> AstExpr)(
  .FnCall(usize(0), box(.Atom(usize(0), make_token(TokenKind.Operator, op))), {
    args := ArrayList(AstExpr).new();
    args.push(lhs);
    args.push(rhs);
    args
  }, true, make_token(TokenKind.Operator, op))
);
/// Build a begin-block `{ stmts… }` from an ArrayList of statements.
make_begin :: (fn(stmts : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, String.from(BK_BEGIN)))),
    stmts,
    false,
    make_token(TokenKind.Identifier, String.from(BK_BEGIN))
  )
);
/// Build the unit expression `()`.
make_unit :: (fn() -> AstExpr)(
  .FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, String.from(BK_TUPLE)))),
    ArrayList(AstExpr).new(),
    false,
    make_token(TokenKind.Identifier, String.from(BK_TUPLE))
  )
);
/// Build a cond arm `condition => body` (infix =>).
make_arm :: (fn(cond_expr : AstExpr, body_expr : AstExpr) -> AstExpr)(
  .FnCall(usize(0), box(.Atom(usize(0), make_token(TokenKind.Operator, String.from("=>")))), {
    a := ArrayList(AstExpr).new();
    a.push(cond_expr);
    a.push(body_expr);
    a
  }, true, make_token(TokenKind.Operator, String.from("=>")))
);
/// Build `cond(arm1, arm2, …)`.
make_cond :: (fn(arms : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, String.from("cond")))),
    arms,
    false,
    make_token(TokenKind.Identifier, String.from("cond"))
  )
);
/// Build `keyword(arg1, arg2, …)` — used for enum/struct/union/trait/object/newtype.
make_typedef_call :: (fn(keyword : String, type_args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, keyword))),
    type_args,
    false,
    make_token(TokenKind.Identifier, keyword)
  )
);
/// Build `func_name(arg1, arg2, …)` — a non-infix function call.
make_fncall_atom :: (fn(name : String, call_args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, name))),
    call_args,
    false,
    make_token(TokenKind.Identifier, name)
  )
);
/// Build a `label : type_expr` labeled field expression (infix colon).
make_labeled_field :: (fn(label : String, type_expr : AstExpr) -> AstExpr)(
  .FnCall(usize(0), box(.Atom(usize(0), make_token(TokenKind.Operator, String.from(":")))), {
    a := ArrayList(AstExpr).new();
    a.push(make_ident(label));
    a.push(type_expr);
    a
  }, true, make_token(TokenKind.Operator, String.from(":")))
);
/// Build `VariantName(field1, field2, …)` — enum variant with fields.
make_variant :: (fn(name : String, field_args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, name))),
    field_args,
    false,
    make_token(TokenKind.Identifier, name)
  )
);
empty_env :: (fn() -> Environment)(Environment.new(`test`));
check_some :: (fn(result : Option(EvalResult), label : String) -> unit)(
  match(
    result,
    .Some(_) => (),
    .None => {
      println(`FAIL [${label}]: expected Some, got None`);
      assert_dyn(false, label);
    }
  )
);
check_none :: (fn(result : Option(EvalResult), label : String) -> unit)(
  match(
    result,
    .Some(_) => {
      println(`FAIL [${label}]: expected None, got Some`);
      assert_dyn(false, label);
    },
    .None => ()
  )
);
check_some_eval_val :: (fn(result : Option(EvalValue), label : String) -> unit)(
  match(
    result,
    .Some(_) => (),
    .None => {
      println(`FAIL [${label}]: expected Some(EvalValue), got None`);
      assert_dyn(false, label);
    }
  )
);
