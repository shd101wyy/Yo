    make_infix(String.from("+"), make_ident(String.from("x")), make_atom(TokenKind.Integer, String.from("1")))
  );
  define_f := make_infix(String.from(":="), make_ident(String.from("f")), lambda);
  _ := evaluate(define_f, env);
  // f(5)
