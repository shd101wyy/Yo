  );
  // f64 arithmetic: 1.5 + 2.5 = 4.0, 4.0 > 3.0
  src := "a := f64(1.5); b := f64(2.5); s := (a + b); gt := (s > f64(3.0)); export(s); export(gt);";
  exprs := generate_exprs_from_code(src, exn);
  result := evaluate_module_body(exprs, env);
  match(
    result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(
        mod_val,
        .ModuleVal(names, vals) => {
          assert(names.len() == usize(2), "2 exports");
          // s = 1.5 + 2.5 = 4.0
          match(
            vals.get(usize(0)),
            .Some(v1) =>
              match(
                v1,
                .FloatLit(raw) => assert(raw == "4", "s is 4"),
                _ => assert(false, "s not FloatLit")
              ),
            .None => assert(false, "no s")
          );
          // gt = 4.0 > 3.0 = true
          match(
            vals.get(usize(1)),
            .Some(v2) =>
              match(
                v2,
                .BoolVal(b) => assert(b, "gt is true"),
                _ => assert(false, "gt not BoolVal")
              ),
            .None => assert(false, "no gt")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
});
