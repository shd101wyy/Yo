});
test("Phase 5p: where clause in fn definition does not crash", {
  // fn(forall(T), where(T <: Trait), x : T) -> T
  // We just verify the function definition succeeds without crashing
  env := empty_env();
  // Build: id :: (fn(forall(T), where(T <: Clone), x : T) -> T)(x)
  params := ArrayList(AstExpr).new();
  params.push(
    make_call("forall", {
      fa := ArrayList(AstExpr).new();
      fa.push(make_atom(TokenKind.Identifier, String.from("T")));
      fa
    })
  );
  params.push(
    make_call("where", {
      wa := ArrayList(AstExpr).new();
      wa.push(make_infix(String.from("<:"), make_atom(TokenKind.Identifier, String.from("T")), make_atom(TokenKind.Identifier, String.from("Clone"))));
      wa
    })
  );
  params.push(make_infix(String.from(":"), make_atom(TokenKind.Identifier, String.from("x")), make_atom(TokenKind.Identifier, String.from("T"))));
  fn_params := make_call("fn", params);
  fn_type := make_infix(String.from("->"), fn_params, make_atom(TokenKind.Identifier, String.from("T")));
  // Apply: fn_type(x)
  body_args := ArrayList(AstExpr).new();
  body_args.push(make_atom(TokenKind.Identifier, String.from("x")));
  fn_tok := Token(kind : TokenKind.Identifier, value : String.new(), row : usize(0), column : usize(0), character : usize(0), module_path : String.new(), input : String.new());
  fn_app := AstExpr.FnCall(usize(0), box(fn_type), body_args, false, fn_tok);
  def := make_infix(String.from("::"), make_atom(TokenKind.Identifier, String.from("id_clone")), fn_app);
  result := evaluate(def, env);
  // Should succeed (defines id_clone as FuncVal)
  lookup := evaluate(make_atom(TokenKind.Identifier, String.from("id_clone")), env);
  match(
    lookup,
    .None => assert(false, "id_clone not defined"),
    .Some(v) => match(
      v.value,
      .FuncVal(_, _, _, _, _, _, _, _, _) => (),
      _ => assert(false, "id_clone should be FuncVal")
    )
  );
});
