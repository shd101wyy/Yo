test("Phase 5v: FnMut closure (x) =>> (x + 1) creates FuncVal", {
  env := empty_env();
  lambda := make_infix(String.from("=>>"), make_ident(String.from("x")), make_infix(String.from("+"), make_ident(String.from("x")), make_atom(TokenKind.Integer, String.from("1"))));
  result := evaluate(lambda, env);
  match(
    result,
    .None => assert(false, "=>> lambda returned None"),
    .Some(r) =>
      match(
        r.value,
        .FuncVal(_, params, _, _, _, _, _, _, _) =>
          assert(params.len() == usize(1), "=>> lambda should have 1 param"),
        _ => assert(false, "expected FuncVal from =>>")
      )
  );
});
test("Phase 5v: FnMut closure called returns result", {
  env := empty_env();
  // f := (x) =>> (x + 10)
  lambda := make_infix(String.from("=>>"), make_ident(String.from("x")), make_infix(String.from("+"), make_ident(String.from("x")), make_atom(TokenKind.Integer, String.from("10"))));
  _ := evaluate(make_infix(String.from(":="), make_ident(String.from("f")), lambda), env);
  // f(5)
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, String.from("5")));
  call_f := AstExpr.FnCall(usize(0), box(make_ident(String.from("f"))), call_args, false, make_token(TokenKind.Identifier, String.from("f")));
  result := evaluate(call_f, env);
  match(
    result,
    .None => assert(false, "=>> call returned None"),
    .Some(r) =>
      match(
        r.value,
        .IntLit(raw) => assert(raw == "15", "f(5) with =>> should be 15"),
        _ => assert(false, "expected IntLit from =>> call")
      )
  );
});
