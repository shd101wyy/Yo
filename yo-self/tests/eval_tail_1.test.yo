// Phase 3k — TypeVal: type names as first-class compile-time values
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Phase 3l helpers — build fn defs with typed / forall params
// ---------------------------------------------------------------------------
/// Build a typed param `name : type_name` as an infix `:` FnCall.
make_typed_param :: (fn(name : String, type_name : String) -> AstExpr)(
  .FnCall(usize(0), box(.Atom(usize(0), make_token(TokenKind.Operator, String.from(":")))), {
    a := ArrayList(AstExpr).new();
    a.push(make_atom(TokenKind.Identifier, name));
    a.push(make_atom(TokenKind.Identifier, type_name));
    a
  }, true, make_token(TokenKind.Operator, String.from(":")))
);
/// Build a forall param `forall(name)` as a non-infix FnCall.
make_forall_param :: (fn(name : String) -> AstExpr)(
  .FnCall(usize(0), box(.Atom(usize(0), make_token(TokenKind.Identifier, String.from("forall")))), {
    a := ArrayList(AstExpr).new();
    a.push(make_atom(TokenKind.Identifier, name));
    a
  }, false, make_token(TokenKind.Identifier, String.from("forall")))
);
/// Build `(fn(param_exprs…) -> unit)(body)` from an ArrayList of AstExpr params.
/// More general than `make_fn_def` which only accepts bare atom param names.
make_fn_def_from_param_exprs :: (fn(param_exprs : ArrayList(AstExpr), body : AstExpr) -> AstExpr)({
  (fn_expr : AstExpr) =.FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, String.from("fn")))),
    param_exprs,
    false,
    make_token(TokenKind.Identifier, String.from("fn"))
  );
  arrow_args := ArrayList(AstExpr).new();
  arrow_args.push(fn_expr);
  arrow_args.push(.Atom(usize(0), make_token(TokenKind.Identifier, String.from("unit"))));
  (fn_sig : AstExpr) =.FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Operator, String.from("->")))),
    arrow_args,
    true,
    make_token(TokenKind.Operator, String.from("->"))
  );
  outer_args := ArrayList(AstExpr).new();
  outer_args.push(body);
  (result : AstExpr) =.FnCall(usize(0), box(fn_sig), outer_args, false, make_token(TokenKind.Operator, String.from("->")));
  result
});
// ---------------------------------------------------------------------------
// Phase 3l — Generic specialization / forall param binding
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Phase 3m helpers — build export, open, and import AST nodes
// ---------------------------------------------------------------------------
/// Build `export(names…)` as a non-infix FnCall.
make_export :: (fn(names : ArrayList(String)) -> AstExpr)({
  export_tok := make_token(TokenKind.Identifier, String.from(BK_EXPORT));
  args := ArrayList(AstExpr).new();
  (i : usize) = usize(0);
  n := names.len();
  while(i < n, {
    match(
      names.get(i),
      .Some(name) => {
        args.push(make_ident(name));
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  .FnCall(usize(0), box(.Atom(usize(0), export_tok)), args, false, export_tok)
});
/// Build `open(expr)` as a non-infix FnCall.
make_open :: (fn(expr : AstExpr) -> AstExpr)({
  open_tok := make_token(TokenKind.Identifier, String.from(BK_OPEN));
  args := ArrayList(AstExpr).new();
  args.push(expr);
  .FnCall(usize(0), box(.Atom(usize(0), open_tok)), args, false, open_tok)
});
/// Build `import("path")` as a non-infix FnCall (path is a string literal).
make_import_expr :: (fn(path : String) -> AstExpr)({
  import_tok := make_token(TokenKind.Identifier, String.from(BK_IMPORT));
  path_lit := `"${path}"`;
  args := ArrayList(AstExpr).new();
  args.push(make_atom(TokenKind.StringLit, path_lit.clone()));
  .FnCall(usize(0), box(.Atom(usize(0), import_tok)), args, false, import_tok)
});
/// Build `{ A, B } :: import("path")` — anon-struct LHS destructure.
make_destructure_import :: (fn(names : ArrayList(String), path : String) -> AstExpr)({
  anon_tok := make_token(TokenKind.Identifier, String.from(BK_ANON_STRUCT));
  name_exprs := ArrayList(AstExpr).new();
  (i : usize) = usize(0);
  n := names.len();
  while(i < n, {
    match(
      names.get(i),
      .Some(nm) => {
        name_exprs.push(make_ident(nm));
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  lhs := (AstExpr).FnCall(usize(0), box(.Atom(usize(0), anon_tok)), name_exprs, false, anon_tok);
  rhs := make_import_expr(path);
  make_infix(String.from("::"), lhs, rhs)
});
// ---------------------------------------------------------------------------
// Phase 3m — Module system
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Phase 3n — if expressions, float arithmetic, comptime param names
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Phase 3o — evidence params / name : Type / evidence passing
// ---------------------------------------------------------------------------
/// Build `inner_expr` call — used both for param declarations and
/// call-site evidence passing.
make_using_call :: (fn(inner : AstExpr) -> AstExpr)({
  ua := ArrayList(AstExpr).new();
  ua.push(inner);
  .FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, String.from("using")))),
    ua,
    false,
    make_token(TokenKind.Identifier, String.from("using"))
  )
});
/// Build `name : Type` param for a function definition.
make_using_param :: (fn(name : String, type_name : String) -> AstExpr)({
  ca := ArrayList(AstExpr).new();
  ca.push(make_ident(name));
  ca.push(make_ident(type_name));
  colon_expr := (AstExpr).FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Operator, String.from(":")))),
    ca,
    true,
    make_token(TokenKind.Operator, String.from(":"))
  );
  make_using_call(colon_expr)
});
/// Build `(fn(params…) -> ret_type)(body)` function definition expression.
make_typed_fn_def :: (
  fn(
    fn_params : ArrayList(AstExpr),
    ret_type : AstExpr,
    body : AstExpr
  ) -> AstExpr
)({
  fn_head := (AstExpr).FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, String.from("fn")))),
    fn_params,
    false,
    make_token(TokenKind.Identifier, String.from("fn"))
  );
  arr_a := ArrayList(AstExpr).new();
  arr_a.push(fn_head);
  arr_a.push(ret_type);
  fn_sig := (AstExpr).FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Operator, String.from("->")))),
    arr_a,
    true,
    make_token(TokenKind.Operator, String.from("->"))
  );
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  (AstExpr).FnCall(usize(0), box(fn_sig), body_args, false, make_token(TokenKind.Operator, String.from("->")))
});
// ---------------------------------------------------------------------------
// Phase 3 Validation Milestone — evaluate a simple hello_world-style module
//
// Constructs the AST for:
//   main :: (fn(io : Io) -> unit)({ io; });
//   export(main);
// and verifies evaluate_module_body produces a ModuleVal exporting a FuncVal
// with evidence_params=["io"] and no regular params.
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Phase 2bk — anonymous struct literal evaluation
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Phase 3z — Type definition keyword handlers
// (enum, struct, object, newtype, union, trait)
// ---------------------------------------------------------------------------
/// Helper: build a fresh env with `T` bound to `TypeVal(i32)`.
make_env_with_T :: (fn() -> Environment)({
  env := Environment.new(`T_env`);
  (ti32 : TypeValue) = t_i32();
  _ := env.define_val(
    String.from("T"),
    t_type(),
    true,
    .Some(.TypeVal(box(ti32)))
  );
  env
});
