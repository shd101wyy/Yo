  call_args.push(make_atom(TokenKind.Integer, String.from("5")));
  call_f := AstExpr.FnCall(
    usize(0),
    box(make_ident(String.from("f"))),
    call_args,
    false,
    make_token(TokenKind.Identifier, String.from("f"))
  );
  result := evaluate(call_f, env);
  match(
    result,
    .None => assert(false, "lambda call returned None"),
    .Some(r) =>
      match(
        r.value,
        .IntLit(raw) => assert(raw == "6", "f(5) should be 6"),
        _ => assert(false, "expected IntLit from lambda call")
      )
  );
});
test("Phase 5u: continue in while loop skips rest of body", {
  // sum = 0; i = 0; while (i < 5) { i = i + 1; if (i == 3) continue; sum = sum + i; }
  // Expected: sum = 1+2+4+5 = 12 (skips adding when i=3)
  env := empty_env();
  // sum := 0
  _ := evaluate(make_infix(String.from(":="), make_ident(String.from("sum")), make_atom(TokenKind.Integer, String.from("0"))), env);
  // i := 0
  _ := evaluate(make_infix(String.from(":="), make_ident(String.from("i")), make_atom(TokenKind.Integer, String.from("0"))), env);
  // Build: while((i < 5), { i = (i + 1); if((i == 3), continue); sum = (sum + i); })
  cond_expr := make_infix(String.from("<"), make_ident(String.from("i")), make_atom(TokenKind.Integer, String.from("5")));
  inc_i := make_infix(String.from("="), make_ident(String.from("i")), make_infix(String.from("+"), make_ident(String.from("i")), make_atom(TokenKind.Integer, String.from("1"))));
  // if((i == 3), continue)
  if_args := ArrayList(AstExpr).new();
  if_args.push(make_infix(String.from("=="), make_ident(String.from("i")), make_atom(TokenKind.Integer, String.from("3"))));
  if_args.push(make_fncall_atom("continue", ArrayList(AstExpr).new()));
  if_expr := make_fncall_atom("if", if_args);
  add_sum := make_infix(String.from("="), make_ident(String.from("sum")), make_infix(String.from("+"), make_ident(String.from("sum")), make_ident(String.from("i"))));
  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(inc_i);
  body_stmts.push(if_expr);
  body_stmts.push(add_sum);
  body_block := AstExpr.FnCall(
    usize(0),
    box(make_atom(TokenKind.Identifier, String.from(BK_BEGIN))),
    body_stmts,
    false,
    make_token(TokenKind.Identifier, String.from(BK_BEGIN))
  );
  while_args := ArrayList(AstExpr).new();
  while_args.push(cond_expr);
  while_args.push(body_block);
  while_expr := make_fncall_atom("while", while_args);
  _ := evaluate(while_expr, env);
  // Check sum
  result := evaluate(make_ident(String.from("sum")), env);
  match(
    result,
    .None => assert(false, "continue while returned None"),
    .Some(r) =>
      match(
        r.value,
        .IntLit(raw) => assert(raw == "12", "sum with continue should be 12"),
        _ => assert(false, "expected IntLit for sum")
      )
  );
});
test("Phase 5u: continue in for loop skips iteration", {
  // arr = [1,2,3,4,5]; sum = 0; for(item, arr, { if (item == 3) continue; sum = sum + item; })
  // Expected: sum = 1+2+4+5 = 12
  env := empty_env();
  // arr := [1,2,3,4,5]
  arr_elems := ArrayList(AstExpr).new();
  arr_elems.push(make_atom(TokenKind.Integer, String.from("1")));
  arr_elems.push(make_atom(TokenKind.Integer, String.from("2")));
  arr_elems.push(make_atom(TokenKind.Integer, String.from("3")));
  arr_elems.push(make_atom(TokenKind.Integer, String.from("4")));
  arr_elems.push(make_atom(TokenKind.Integer, String.from("5")));
  arr_lit := AstExpr.FnCall(
    usize(0),
    box(make_atom(TokenKind.Identifier, String.from(BK_ARRAY_VAL))),
    arr_elems,
    false,
    make_token(TokenKind.Identifier, String.from(BK_ARRAY_VAL))
  );
  _ := evaluate(make_infix(String.from(":="), make_ident(String.from("arr")), arr_lit), env);
  // sum := 0
  _ := evaluate(make_infix(String.from(":="), make_ident(String.from("sum")), make_atom(TokenKind.Integer, String.from("0"))), env);
  // Build for(item, arr, { if((item == 3), continue); sum = (sum + item); })
  if_args := ArrayList(AstExpr).new();
  if_args.push(make_infix(String.from("=="), make_ident(String.from("item")), make_atom(TokenKind.Integer, String.from("3"))));
  if_args.push(make_fncall_atom("continue", ArrayList(AstExpr).new()));
  if_expr := make_fncall_atom("if", if_args);
  add_sum := make_infix(String.from("="), make_ident(String.from("sum")), make_infix(String.from("+"), make_ident(String.from("sum")), make_ident(String.from("item"))));
  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(if_expr);
  body_stmts.push(add_sum);
  body_block := AstExpr.FnCall(
    usize(0),
    box(make_atom(TokenKind.Identifier, String.from(BK_BEGIN))),
    body_stmts,
    false,
    make_token(TokenKind.Identifier, String.from(BK_BEGIN))
  );
  for_args := ArrayList(AstExpr).new();
  for_args.push(make_ident(String.from("item")));
  for_args.push(make_ident(String.from("arr")));
  for_args.push(body_block);
  for_expr := make_fncall_atom("for", for_args);
  _ := evaluate(for_expr, env);
  result := evaluate(make_ident(String.from("sum")), env);
  match(
    result,
    .None => assert(false, "continue for returned None"),
    .Some(r) =>
      match(
        r.value,
        .IntLit(raw) => assert(raw == "12", "sum with continue in for should be 12"),
        _ => assert(false, "expected IntLit for sum")
      )
  );
});
