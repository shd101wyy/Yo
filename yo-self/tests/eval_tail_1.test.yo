            .Some(v1) =>
              match(
                v1,
                .BoolVal(b) => assert(b, "hello world ends_with world is true"),
                _ => assert(false, "b not BoolVal")
              ),
            .None => assert(false, "no b")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
});
test("evaluate_module_body: string contains true", {
  env := empty_env();
  exn := Exception(
    throw : (
      (err) -> {
        _ := err;
        assert(false, "parse error");
        unwind(());
      }
    )
  );
  // s := "hello world"; b := s.contains("lo wo"); export(b);
  src := "s := \"hello world\"; b := s.contains(\"lo wo\"); export(b);";
  exprs := generate_exprs_from_code(src, exn);
  result := evaluate_module_body(exprs, env);
  match(
    result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(
        mod_val,
        .ModuleVal(names, vals) => {
          assert(names.len() == usize(1), "1 export");
          match(
            vals.get(usize(0)),
            .Some(v1) =>
              match(
                v1,
                .BoolVal(b) => assert(b, "hello world contains lo wo is true"),
                _ => assert(false, "b not BoolVal")
              ),
            .None => assert(false, "no b")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
});
test("Phase 5m: name := rhs binds name in scope", {
  // handler := value — should look up the bound value
  env := empty_env();
  // Build: handler := 42
  handler_atom := make_ident(String.from("handler"));
  given_args := ArrayList(AstExpr).new();
  given_args.push(handler_atom);
  given_e := make_call("given", given_args);
  rhs_e := make_atom(TokenKind.Integer, String.from("42"));
  given_binding := make_infix(String.from(":="), given_e, rhs_e);
  bind_res := evaluate(given_binding, env);
  match(
    bind_res,
    .None => assert(false, "given binding returned None"),
    .Some(_) => ()
  );
  // Now `handler` should be in scope
  lookup := evaluate(make_ident(String.from("handler")), env);
  match(
    lookup,
    .None => assert(false, "handler not found in scope after given binding"),
    .Some(res) =>
      match(
        res.value,
        .IntLit(raw) => assert(raw == "42", "handler value is 42"),
        _ => assert(false, "expected IntLit(42)")
      )
  );
});
test("Phase 5m: name := rhs binds as compile-time value", {
  // given bindings are always compile-time in Yo
  env := empty_env();
  // Build: ctx := true
  ctx_atom := make_ident(String.from("ctx"));
  given_args := ArrayList(AstExpr).new();
  given_args.push(ctx_atom);
  given_e := make_call("given", given_args);
  rhs_e := make_atom(TokenKind.Bool, String.from("true"));
  given_binding := make_infix(String.from(":="), given_e, rhs_e);
  _bind := evaluate(given_binding, env);
  // Lookup should succeed and value is compile-time
  lookup := evaluate(make_ident(String.from("ctx")), env);
  match(
    lookup,
    .None => assert(false, "ctx not found after given binding"),
    .Some(res) =>
      // BoolVal is always a compile-time value
      match(
        res.value,
        .BoolVal(_) => (),
        // compile-time bool — correct
        _ => assert(false, "expected BoolVal (compile-time bool)")
      )
  );
});
test("Phase 5o: multiple defines in same env", {
  // Verify that defining multiple names in same env works and doesn't clobber
  env := empty_env();
  _r1 := evaluate(
    make_infix(
      "::",
      make_ident(String.from("aaa")),
      make_atom(TokenKind.Integer, String.from("10"))
    ),
    env
  );
  _r2 := evaluate(
    make_infix(
      "::",
      make_ident(String.from("bbb")),
      make_atom(TokenKind.Integer, String.from("20"))
    ),
    env
  );
  ra := evaluate(make_ident(String.from("aaa")), env);
  rb := evaluate(make_ident(String.from("bbb")), env);
  match(
    ra,
    .None => assert(false, "aaa not found"),
    .Some(va) => assert(
      va.value == EvalValue.IntLit(String.from("10")),
      "aaa should be 10"
    )
  );
  match(
    rb,
    .None => assert(false, "bbb not found"),
    .Some(vb) => assert(
      vb.value == EvalValue.IntLit(String.from("20")),
      "bbb should be 20"
    )
  );
});
test("Phase 5o: nested arithmetic evaluation", {
  // ((2 + 3) * (4 - 1)) should equal 15
  env := empty_env();
  two_args := ArrayList(AstExpr).new();
  two_args.push(make_atom(TokenKind.Integer, String.from("2")));
  three_args := ArrayList(AstExpr).new();
  three_args.push(make_atom(TokenKind.Integer, String.from("3")));
  four_args := ArrayList(AstExpr).new();
  four_args.push(make_atom(TokenKind.Integer, String.from("4")));
  one_args := ArrayList(AstExpr).new();
  one_args.push(make_atom(TokenKind.Integer, String.from("1")));
  add := make_infix(String.from("+"), make_call("i32", two_args), make_call("i32", three_args));
  sub := make_infix(String.from("-"), make_call("i32", four_args), make_call("i32", one_args));
  mul := make_infix(String.from("*"), add, sub);
  result := evaluate(mul, env);
  match(
    result,
    .None => assert(false, "nested arithmetic returned None"),
    .Some(r) => assert(
      r.value == EvalValue.IntLit(String.from("15")),
      "((2+3)*(4-1)) == 15"
    )
  );
});
