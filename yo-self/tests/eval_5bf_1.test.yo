test("Phase 5bfa: zip absolute difference fold sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[5,1,8,3], b=[2,4,2,7] → abs-diffs=[3,3,6,4] → sum=16
  src := "a := [i32(5), i32(1), i32(8), i32(3)];\nb := [i32(2), i32(4), i32(2), i32(7)];\npairs := a.zip(b);\ntotal := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)({\nd := (p.0 - p.1);\ncond((d >= i32(0)) => (acc + d), true => (acc - d))\n}));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
