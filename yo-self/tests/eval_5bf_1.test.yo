  src := "arr := [i32(3), i32(5), i32(15), i32(7)];\ncodes := arr.map((fn(x : i32) -> i32)({\ndiv15 := ((x % i32(15)) == i32(0));\ndiv3 := ((x % i32(3)) == i32(0));\ndiv5 := ((x % i32(5)) == i32(0));\ncond(div15 => i32(3), div3 => i32(1), div5 => i32(2), true => i32(0))\n}));\ntotal := codes.fold(i32(0), (fn(acc : i32, c : i32) -> i32)((acc + c)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "6"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bfc: cond-clamp to 0-10 then fold sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [-2,3,8,12,-5] clamped to [0,10] → [0,3,8,10,0] → sum=21
  src := "arr := [(i32(0)-i32(2)), i32(3), i32(8), i32(12), (i32(0)-i32(5))];\nclamped := arr.map((fn(x : i32) -> i32)({\ncond((x < i32(0)) => i32(0), (x > i32(10)) => i32(10), true => x)\n}));\ntotal := clamped.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "21", "21"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
