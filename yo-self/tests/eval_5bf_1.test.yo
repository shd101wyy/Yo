// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5bf series: zip combos, multi-fn composition,
/// deeper cond trees, string classification, and grand combos.
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5bfa — zip combos with fold
// ---------------------------------------------------------------------------
test("Phase 5bfa: zip two arrays and fold min of each pair", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[1,4,2,5], b=[3,2,6,1] → mins=[1,2,2,1] → sum=6
  src := "a := [i32(1), i32(4), i32(2), i32(5)];\nb := [i32(3), i32(2), i32(6), i32(1)];\npairs := a.zip(b);\ntotal := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)({\ncond((p.0 <= p.1) => (acc + p.0), true => (acc + p.1))\n}));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "6"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
