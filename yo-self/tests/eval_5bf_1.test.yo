test("Phase 5bfc: cond sign-code map then fold sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [-3,0,5,-1,2] → codes=[-1,0,1,-1,1] → sum=0
  src := "arr := [(i32(0)-i32(3)), i32(0), i32(5), (i32(0)-i32(1)), i32(2)];\ncodes := arr.map((fn(x : i32) -> i32)({\ncond((x > i32(0)) => i32(1), (x == i32(0)) => i32(0), true => (i32(0)-i32(1)))\n}));\ntotal := codes.fold(i32(0), (fn(acc : i32, c : i32) -> i32)((acc + c)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
