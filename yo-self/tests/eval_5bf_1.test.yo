  src := "a := [i32(1), i32(2), i32(3)];\nb := [i32(4), i32(5), i32(6)];\npairs := a.zip(b);\nsums := pairs.map((fn(p : (i32, i32)) -> i32)((p.0 + p.1)));\ntotal := sums.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
