test("Phase 5bfd: count strings starting with vowel", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // ["apple","banana","orange","grape","echo"] → starts with a/e/o: apple,orange,echo → 3
  src := "words := [\"apple\", \"banana\", \"orange\", \"grape\", \"echo\"];\ncount := words.fold(i32(0), (fn(acc : i32, w : str) -> i32)({\ncond(w.starts_with(\"a\") => (acc + i32(1)), w.starts_with(\"e\") => (acc + i32(1)), w.starts_with(\"o\") => (acc + i32(1)), true => acc)\n}));\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
