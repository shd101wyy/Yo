  src := "arr := [i32(3), (i32(0)-i32(1)), i32(8), i32(0), i32(5), (i32(0)-i32(2)), i32(6)];\npos := arr.filter((fn(x : i32) -> bool)((x > i32(0))));\nhalved := pos.map((fn(x : i32) -> i32)((x / i32(2))));\ntotal := halved.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
