// ---------------------------------------------------------------------------
// Phase 5bfe — grand combos
// ---------------------------------------------------------------------------
test("Phase 5bfe: zip+filter+fold — weighted sum of active pairs", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // vals=[1,2,3,4,5], weights=[3,0,2,0,4] → active: (1,3),(3,2),(5,4) → 1*3+3*2+5*4=29
  src := "vals := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nweights := [i32(3), i32(0), i32(2), i32(0), i32(4)];\npairs := vals.zip(weights);\nactive := pairs.filter((fn(p : (i32, i32)) -> bool)((p.1 > i32(0))));\ntotal := active.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)((acc + (p.0 * p.1))));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "29", "29"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bfe: let-chain + map + zip grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[1,2,3], doubled=[2,4,6], b=[10,20,30] → zip pairs, sum(p.0+p.1)=12+24+36=72
  src := "a := [i32(1), i32(2), i32(3)];\ndoubled := a.map((fn(x : i32) -> i32)((x * i32(2))));\nb := [i32(10), i32(20), i32(30)];\npairs := doubled.zip(b);\nsums := pairs.map((fn(p : (i32, i32)) -> i32)((p.0 + p.1)));\ntotal := sums.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "72", "72"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bfe: flat_map then filter then fold grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,2,3,4] → flat_map(x→[x,x*x])=[1,1,2,4,3,9,4,16] → filter>3=[4,4,9,16] → sum=33
  src := "arr := [i32(1), i32(2), i32(3), i32(4)];\nexpanded := arr.flat_map((fn(x : i32) -> [i32])([x, (x * x)]));\nbig := expanded.filter((fn(x : i32) -> bool)((x > i32(3))));\ntotal := big.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "33", "33"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bfe: map then zip then filter then fold grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[1,2,3,4,5], doubled=[2,4,6,8,10], zip a with doubled
  // filter pairs where p.1 > 5 → (3,6),(4,8),(5,10) → sum p.0+p.1 = 9+12+15=36
  src := "a := [i32(1), i32(2), i32(3), i32(4), i32(5)];\ndoubled := a.map((fn(x : i32) -> i32)((x * i32(2))));\npairs := a.zip(doubled);\nbig := pairs.filter((fn(p : (i32, i32)) -> bool)((p.1 > i32(5))));\nsums := big.map((fn(p : (i32, i32)) -> i32)((p.0 + p.1)));\ntotal := sums.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "36", "36"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
