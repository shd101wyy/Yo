// ---------------------------------------------------------------------------
// Phase 5aad — Multi-level Option/Result chain combos
// ---------------------------------------------------------------------------
test("Phase 5aad: Option chain map -> and_then -> unwrap_or", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "double := (fn(x : i32) -> i32)({ (x * i32(2)) });\nto_opt := (fn(x : i32) -> Option(i32))({ cond((x > i32(5)) => Option(i32).Some(x), true => Option(i32).None) });\nopt := Option(i32).Some(i32(4));\nresult := opt.map(double).and_then(to_opt).unwrap_or(i32(-(1)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "8", "8"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
