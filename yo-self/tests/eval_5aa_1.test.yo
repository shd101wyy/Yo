// ---------------------------------------------------------------------------
// Phase 5aae — Accumulator patterns (while + HOF mixed)
// ---------------------------------------------------------------------------
test("Phase 5aae: while loop builds result array, then HOF processes it", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "(squares : [i32]) = [];\n(i : i32) = i32(1);\nwhile((i <= i32(5)), {\nsquares = squares.concat([(i * i),]);\ni = (i + i32(1));\n});\ntotal := squares.fold(i32(0), (fn(s : i32, x : i32) -> i32)((s + x)));\nexport(squares.len());\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "len 5"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "55", "55"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5aae: while + concat builds full array", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "(result : [i32]) = [];\n(i : i32) = i32(0);\nwhile((i < i32(4)), {\nresult = result.concat([i, (i * i32(10)),]);\ni = (i + i32(1));\n});\nexport(result.len());\nexport(result.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x))));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "8", "len 8"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "66", "66"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5aae: HOF pipeline then while-based verification", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6)];\nevens := arr.filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(0))));\ndoubled := evens.map((fn(x : i32) -> i32)((x * i32(2))));\n(sum : i32) = i32(0);\n(i : i32) = i32(0);\nwhile((i < doubled.len()), {\nmatch(doubled.get(i.to_usize()), .Some(v) => { sum = (sum + v); }, .None => ());\ni = (i + i32(1));\n});\nexport(evens.len());\nexport(sum);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3 evens"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "24", "24"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
