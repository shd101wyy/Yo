    )
  );
});
test("Phase 5aag: Result chain + escape combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "safe_sqrt := (fn(x : i32) -> Result(i32, str))({\ncond((x < i32(0)) => { escape(Result(i32, str).Err(\"negative\")); }, true => ());\nResult(i32, str).Ok(x)\n});\nresults := [i32(4), i32(-(1)), i32(9),].map((fn(x : i32) -> Result(i32, str))(safe_sqrt(x)));\nok_count := results.filter((fn(r : Result(i32, str)) -> bool)(r.is_ok())).len();\nerr_count := results.filter((fn(r : Result(i32, str)) -> bool)(r.is_err())).len();\nexport(ok_count);\nexport(err_count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2 ok"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "1 err"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
