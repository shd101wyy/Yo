  );
  src := "r := Result(i32, str).Ok(i32(42));\nopt := r.ok();\ndoubled := opt.map((fn(x : i32) -> i32)((x * i32(2))));\nexport(doubled.is_some());\nexport(doubled.unwrap());\n";
  exprs := generate_exprs_from_code(src, using(exn));
