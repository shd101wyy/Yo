// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5aa series: complex algorithm patterns using
/// combinations of features (split+join pipelines, min/max chains, substring
/// operations, multi-level Option/Result chains, accumulator patterns).
///
/// Phases covered:
///   5aaa — StrLit.split + pipeline processing
///   5aab — IntLit.min() / IntLit.max() in complex arithmetic
///   5aac — StrLit.substring() with various ranges
///   5aad — Multi-level Option/Result chain combos
///   5aae — Accumulator patterns (while + HOF mixed)
///   5aaf — Complex struct + impl method combos
///   5aag — Grand combo tests
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5aaa — StrLit.split + pipeline processing
// ---------------------------------------------------------------------------
test("Phase 5aaa: split by space then join with comma", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := \"a b c d\";\nparts := s.split(\" \");\nresult := parts.join(\",\");\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.StrLit(s) => assert(s.as_str() == "\"a,b,c,d\"", "a,b,c,d"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
