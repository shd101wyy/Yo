      .ModuleVal(_, v) => {
        assert(v.len() == usize(3), "3 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "0", "0"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "7", "7"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
        match(
          v.get(usize(2)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "10", "10"), _ => assert(false, "t2")),
          .None => assert(false, "v2")
        );
      },
      _ => assert(false, "m")
    )
  );
});
