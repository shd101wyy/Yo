  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .StrLit(s) => assert(s.as_str() == "\"QUICK-BROWN-JUMPS\"", "QUICK-BROWN-JUMPS"),
            _ => assert(false, "t0")
          ),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5aag: parse_i64 + Result chain + min/max", {
