test("Phase 5aaa: split then find first containing substring", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := \"red green blue\";\nwords := s.split(\" \");\nfound := words.find((fn(w : str) -> bool)(w.contains(\"ee\")));\nexport(found.is_some());\nexport(found.unwrap());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "found"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.StrLit(s) => assert(s.as_str() == "\"green\"", "green"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
// ---------------------------------------------------------------------------
// Phase 5aab — IntLit.min() / IntLit.max() in complex arithmetic
// ---------------------------------------------------------------------------
test("Phase 5aab: min and max in fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(3), i32(1), i32(4), i32(1), i32(5), i32(9), i32(2)];\nmin_val := arr.fold(i32(999), (fn(acc : i32, x : i32) -> i32)(acc.min(x)));\nmax_val := arr.fold(i32(-(999)), (fn(acc : i32, x : i32) -> i32)(acc.max(x)));\nexport(min_val);\nexport(max_val);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "min=1"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "9", "max=9"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5aab: clamp via min+max", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "clamp := (fn(x : i32, lo : i32, hi : i32) -> i32)({ x.max(lo).min(hi) });\nexport(clamp(i32(-(5)), i32(0), i32(10)));\nexport(clamp(i32(7), i32(0), i32(10)));\nexport(clamp(i32(15), i32(0), i32(10)));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
