test("Phase 12ol/10bw: T19 find_min of [4,9,6,9,9,1,12,2,9] = 1", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
