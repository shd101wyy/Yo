/// Codegen tests for async Future completion helpers.
///
/// Validates `yo-self/codegen/exprs/async_completion.yo`, the 1-to-1 port of
/// `src/codegen/exprs/async-completion.ts`.
open(import("std/string"));
{ Emitter } :: import("../emitter.yo");
{ AsyncCompletionOptions, emit_async_future_completion, emit_async_future_escape } :: import("../codegen/exprs/async_completion.yo");
test("emit_async_future_completion: emits result, completed state, continuation, drop, return", {
  emitter := Emitter.new();
  (pemitter : *(Emitter)) = &(emitter);
  emit_async_future_completion(
    AsyncCompletionOptions(
      emitter : pemitter,
      indent : String.from("  "),
      result_code : Option(String).Some(String.from("value")),
      debug_label : Option(String).Some(String.from("test_fn"))
    )
  );
  out := emitter.print();
  assert(out.contains(String.from("  sm->result = value;")), "expected result assignment");
  assert(out.contains(String.from("  ASYNC_DEBUG(\"test_fn: Setting state to COMPLETED\\n\");")), "expected completed debug");
  assert(out.contains(String.from("  sm->state = -1;  // -1 = completed")), "expected completed state");
  assert(out.contains(String.from("  __yo_async_spawn_task(continuation_fn, continuation_sm);")), "expected continuation spawn");
  assert(out.contains(String.from("  __yo_decr_rc((void*)sm);")), "expected rc decrement");
  assert(out.contains(String.from("  return;")), "expected return");
});
test("emit_async_future_escape: emits escaped state without optional result/debug", {
  emitter := Emitter.new();
  (pemitter : *(Emitter)) = &(emitter);
  emit_async_future_escape(
    AsyncCompletionOptions(
      emitter : pemitter,
      indent : String.new(),
      result_code : Option(String).None,
      debug_label : Option(String).None
    )
  );
  out := emitter.print();
  assert(out.contains(String.from("sm->state = -2;  // -2 = escaped")), "expected escaped state");
  assert(out.contains(String.from("__yo_async_spawn_task(continuation_fn, continuation_sm);")), "expected continuation spawn");
  assert(out.contains(String.from("__yo_decr_rc((void*)sm);")), "expected rc decrement");
  assert(out.contains(String.from("return;")), "expected return");
});
