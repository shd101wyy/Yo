      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "35", "35"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bqc: count local maxima in [1,3,2,5,4,7,6] = 3", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // local maxima at indices 1(3>1,3>2), 3(5>2,5>4), 5(7>4,7>6) => count=3
  src := "arr := [i32(1),i32(3),i32(2),i32(5),i32(4),i32(7),i32(6)];\ncnt := i32(0);\ni := i32(1);\nwhile((i < i32(6)), {\nprev := arr.get((i - i32(1))).unwrap();\ncurr := arr.get(i).unwrap();\nnxt := arr.get((i + i32(1))).unwrap();\ngt_p := cond((curr > prev) => i32(1), true => i32(0));\ngt_n := cond((curr > nxt) => i32(1), true => i32(0));\ncnt = cond(((gt_p * gt_n) == i32(1)) => (cnt + i32(1)), true => cnt);\ni = (i + i32(1));\n});\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bqc: second maximum of [3,1,4,1,5,9,2,6] = 6", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // max=9, second max=6
  src := "arr := [i32(3),i32(1),i32(4),i32(1),i32(5),i32(9),i32(2),i32(6)];\nm1 := i32(0);\ni := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap();\nm1 = cond((v > m1) => v, true => m1);\ni = (i + i32(1));\n});\nm2 := i32(0);\nj := i32(0);\nwhile((j < i32(8)), {\nv := arr.get(j).unwrap();\ngt_m2 := cond((v > m2) => i32(1), true => i32(0));\nlt_m1 := cond((v < m1) => i32(1), true => i32(0));\nm2 = cond(((gt_m2 * lt_m1) == i32(1)) => v, true => m2);\nj = (j + i32(1));\n});\nexport(m2);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "6"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

