test("Phase 5bqd: prefix_sum_sum + local_maxima + second_max = 35+3+6 = 44", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr1 := [i32(1),i32(2),i32(3),i32(4),i32(5)];\ncum := i32(0);\npss := i32(0);\npi := i32(0);\nwhile((pi < i32(5)), {\nv := arr1.get(pi).unwrap();\ncum = (cum + v);\npss = (pss + cum);\npi = (pi + i32(1));\n});\narr2 := [i32(1),i32(3),i32(2),i32(5),i32(4),i32(7),i32(6)];\nlmc := i32(0);\nli := i32(1);\nwhile((li < i32(6)), {\nprev := arr2.get((li - i32(1))).unwrap();\ncurr := arr2.get(li).unwrap();\nnxt := arr2.get((li + i32(1))).unwrap();\ngt_p := cond((curr > prev) => i32(1), true => i32(0));\ngt_n := cond((curr > nxt) => i32(1), true => i32(0));\nlmc = cond(((gt_p * gt_n) == i32(1)) => (lmc + i32(1)), true => lmc);\nli = (li + i32(1));\n});\narr3 := [i32(3),i32(1),i32(4),i32(1),i32(5),i32(9),i32(2),i32(6)];\nsm1 := i32(0);\nsi := i32(0);\nwhile((si < i32(8)), {\nsv := arr3.get(si).unwrap();\nsm1 = cond((sv > sm1) => sv, true => sm1);\nsi = (si + i32(1));\n});\nsm2 := i32(0);\nsj := i32(0);\nwhile((sj < i32(8)), {\nsv := arr3.get(sj).unwrap();\nggt := cond((sv > sm2) => i32(1), true => i32(0));\nllt := cond((sv < sm1) => i32(1), true => i32(0));\nsm2 = cond(((ggt * llt) == i32(1)) => sv, true => sm2);\nsj = (sj + i32(1));\n});\ntotal := ((pss + lmc) + sm2);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "44", "44"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
