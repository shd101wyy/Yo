    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // prefix sums: 1,3,6,10,15; sum=35
  src := "arr := [i32(1),i32(2),i32(3),i32(4),i32(5)];\ncum := i32(0);\ntotal := i32(0);\ni := i32(0);\nwhile((i < i32(5)), {\nv := arr.get(i).unwrap();\ncum = (cum + v);\ntotal = (total + cum);\ni = (i + i32(1));\n});\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
