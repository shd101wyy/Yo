  src := "pow3 := i32(1);\ni := i32(0);\nwhile((i < i32(5)), {\npow3 = (pow3 * i32(3));\ni = (i + i32(1));\n});\narr := [i32(1),i32(2),i32(3),i32(4),i32(5)];\ncum := i32(0);\npss := i32(0);\nj := i32(0);\nwhile((j < i32(5)), {\nv := arr.get(j).unwrap();\ncum = (cum + v);\npss = (pss + cum);\nj = (j + i32(1));\n});\nc62 := ((i32(6) * i32(5)) / (i32(2) * i32(1)));\ntotal := ((pow3 + pss) + c62);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
