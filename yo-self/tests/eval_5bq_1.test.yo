  // C(6,3) = 6*5*4 / 3*2*1 = 20; Catalan(3) = 20/4 = 5
  src := "c63 := (((i32(6) * i32(5)) * i32(4)) / ((i32(3) * i32(2)) * i32(1)));\ncat3 := (c63 / i32(4));\nexport(cat3);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "5"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
