  );
});
test("Phase 5bqe: abs_diff_consec + local_maxima + second_max = 19+3+6 = 28", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr1 := [i32(1),i32(3),i32(6),i32(2),i32(8),i32(4)];\nads := i32(0);\nai := i32(0);\nwhile((ai < i32(5)), {\na := arr1.get(ai).unwrap();\nb := arr1.get((ai + i32(1))).unwrap();\nd := cond((a > b) => (a - b), true => (b - a));\nads = (ads + d);\nai = (ai + i32(1));\n});\narr2 := [i32(1),i32(3),i32(2),i32(5),i32(4),i32(7),i32(6)];\nlmc := i32(0);\nli := i32(1);\nwhile((li < i32(6)), {\nprev := arr2.get((li - i32(1))).unwrap();\ncurr := arr2.get(li).unwrap();\nnxt := arr2.get((li + i32(1))).unwrap();\ngt_p := cond((curr > prev) => i32(1), true => i32(0));\ngt_n := cond((curr > nxt) => i32(1), true => i32(0));\nlmc = cond(((gt_p * gt_n) == i32(1)) => (lmc + i32(1)), true => lmc);\nli = (li + i32(1));\n});\narr3 := [i32(3),i32(1),i32(4),i32(1),i32(5),i32(9),i32(2),i32(6)];\nsm1 := i32(0);\nsi := i32(0);\nwhile((si < i32(8)), {\nsv := arr3.get(si).unwrap();\nsm1 = cond((sv > sm1) => sv, true => sm1);\nsi = (si + i32(1));\n});\nsm2 := i32(0);\nsj := i32(0);\nwhile((sj < i32(8)), {\nsv := arr3.get(sj).unwrap();\nggt := cond((sv > sm2) => i32(1), true => i32(0));\nllt := cond((sv < sm1) => i32(1), true => i32(0));\nsm2 = cond(((ggt * llt) == i32(1)) => sv, true => sm2);\nsj = (sj + i32(1));\n});\ntotal := ((ads + lmc) + sm2);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "28", "28"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
