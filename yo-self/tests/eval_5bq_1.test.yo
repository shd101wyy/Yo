// ---------------------------------------------------------------------------
// Phase 5bqc — array operations: abs-diffs, prefix sums, local maxima, second max
// ---------------------------------------------------------------------------
test("Phase 5bqc: sum of abs diffs of consecutive elements in [1,3,6,2,8,4] = 19", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // |3-1|+|6-3|+|2-6|+|8-2|+|4-8| = 2+3+4+6+4 = 19
  src := "arr := [i32(1),i32(3),i32(6),i32(2),i32(8),i32(4)];\ns := i32(0);\ni := i32(0);\nwhile((i < i32(5)), {\na := arr.get(i).unwrap();\nb := arr.get((i + i32(1))).unwrap();\nd := cond((a > b) => (a - b), true => (b - a));\ns = (s + d);\ni = (i + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "19", "19"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bqc: sum of prefix sums of [1,2,3,4,5] = 35", {
  env := empty_env();
