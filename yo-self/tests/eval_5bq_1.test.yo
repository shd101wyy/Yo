test("Phase 5bqb: 2^10 mod 1000 = 24 via while loop", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "p := i32(1);\ni := i32(0);\nwhile((i < i32(10)), {\np = ((p * i32(2)) % i32(1000));\ni = (i + i32(1));\n});\nexport(p);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
