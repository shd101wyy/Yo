test("Phase 5bsa: count n*(n+1) divisible by 6 in 1..20 = 13", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // n*(n+1) always div by 2; also div by 3 when n%3==0 or (n+1)%3==0 => 13 cases
  src := "cnt := i32(0);\nn := i32(1);\nwhile((n < i32(21)), {\nprd := (n * (n + i32(1)));\ncnt = cond(((prd % i32(6)) == i32(0)) => (cnt + i32(1)), true => cnt);\nn = (n + i32(1));\n});\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "13", "13"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
