test("Phase 5bsb: sum of max(arr[i], arr[i+1]) for consecutive pairs = 40", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // max(3,1)+max(1,4)+max(4,1)+max(1,5)+max(5,9)+max(9,2)+max(2,6)=3+4+4+5+9+9+6=40
  src := "arr := [i32(3),i32(1),i32(4),i32(1),i32(5),i32(9),i32(2),i32(6)];\ns := i32(0);\ni := i32(0);\nwhile((i < i32(7)), {\na := arr.get(i).unwrap();\nb := arr.get((i + i32(1))).unwrap();\ns = (s + cond((a > b) => a, true => b));\ni = (i + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "40", "40"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
