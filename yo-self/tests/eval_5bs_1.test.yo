// ---------------------------------------------------------------------------
// Phase 5bsb — array index and pair patterns on [3,1,4,1,5,9,2,6]
// ---------------------------------------------------------------------------
test("Phase 5bsb: sum of elements at even indices in [3,1,4,1,5,9,2,6] = 14", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // indices 0,2,4,6: 3+4+5+2 = 14
  src := "arr := [i32(3),i32(1),i32(4),i32(1),i32(5),i32(9),i32(2),i32(6)];\ns := i32(0);\ni := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap();\ns = cond(((i % i32(2)) == i32(0)) => (s + v), true => s);\ni = (i + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "14", "14"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
