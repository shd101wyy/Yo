test("Phase 5bsc: count increases in [3,1,4,1,5,9,2,6] = 4", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // increases: 1→4, 1→5, 5→9, 2→6 = 4
  src := "arr := [i32(3),i32(1),i32(4),i32(1),i32(5),i32(9),i32(2),i32(6)];\ncnt := i32(0);\ni := i32(1);\nwhile((i < i32(8)), {\nprev := arr.get((i - i32(1))).unwrap();\ncurr := arr.get(i).unwrap();\ncnt = cond((curr > prev) => (cnt + i32(1)), true => cnt);\ni = (i + i32(1));\n});\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "4"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bsc: sum of increase diffs in [3,1,4,1,5,9,2,6] = 15", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // (4-1)+(5-1)+(9-5)+(6-2) = 3+4+4+4 = 15
  src := "arr := [i32(3),i32(1),i32(4),i32(1),i32(5),i32(9),i32(2),i32(6)];\ns := i32(0);\ni := i32(1);\nwhile((i < i32(8)), {\nprev := arr.get((i - i32(1))).unwrap();\ncurr := arr.get(i).unwrap();\nd := cond((curr > prev) => (curr - prev), true => i32(0));\ns = (s + d);\ni = (i + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "15", "15"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5bsd — grand combos I
// ---------------------------------------------------------------------------
test("Phase 5bsd: sum_n2 + sum_nn1 + count_div6 = 385+70+13 = 468", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "sn2 := i32(0);\nni := i32(1);\nwhile((ni < i32(11)), {\nsn2 = (sn2 + (ni * ni));\nni = (ni + i32(1));\n});\nsnn := i32(0);\nnj := i32(1);\nwhile((nj < i32(6)), {\nsnn = (snn + (nj * (nj + i32(1))));\nnj = (nj + i32(1));\n});\ncd6 := i32(0);\nnk := i32(1);\nwhile((nk < i32(21)), {\nprd := (nk * (nk + i32(1)));\ncd6 = cond(((prd % i32(6)) == i32(0)) => (cd6 + i32(1)), true => cd6);\nnk = (nk + i32(1));\n});\ntotal := ((sn2 + snn) + cd6);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "468", "468"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bsd: sum_mods + sum_even_idx + sum_odd_idx = 30+14+17 = 61", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "sm := i32(0);\nnm := i32(1);\nwhile((nm < i32(11)), {\nsm = (sm + ((nm % i32(3)) + (nm % i32(5))));\nnm = (nm + i32(1));\n});\narr := [i32(3),i32(1),i32(4),i32(1),i32(5),i32(9),i32(2),i32(6)];\nse := i32(0);\nii := i32(0);\nwhile((ii < i32(8)), {\nvv := arr.get(ii).unwrap();\nse = cond(((ii % i32(2)) == i32(0)) => (se + vv), true => se);\nii = (ii + i32(1));\n});\nso := i32(0);\njj := i32(0);\nwhile((jj < i32(8)), {\nvv := arr.get(jj).unwrap();\nso = cond(((jj % i32(2)) != i32(0)) => (so + vv), true => so);\njj = (jj + i32(1));\n});\ntotal := ((sm + se) + so);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "61", "61"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
