// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5t series: Option/Result chaining.
///
/// Phases covered:
///   5ta — TypeVal.Some/None/Ok/Err constructors + basic is_some/is_none/is_ok/is_err/unwrap
///   5tb — Option.map(fn)
///   5tc — Option.and_then(fn)
///   5td — Option.unwrap_or(default) + Option.or_else(fn)
///   5te — Result.is_ok/is_err/unwrap/unwrap_or/map/map_err/ok/err + combos

open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5ta — TypeVal.Some/None/Ok/Err constructors + basic methods
// ---------------------------------------------------------------------------
test("Phase 5ta: Option(i32).Some(i32(42)) produces EnumVal .Some", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "opt := Option(i32).Some(i32(42));\nexport(opt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .EnumVal(tag, flds) => {
      assert(tag.as_str() == ".Some", ".Some tag");
      match(flds.get(usize(0)), .Some(iv) => match(iv, .IntLit(n) => assert(n.as_str() == "42", "42"), _ => assert(false, "t")), .None => assert(false, "fld"));
    }, _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
