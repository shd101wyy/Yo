};

test "Phase 5hf: recursive flatten sum", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "sum_range := (fn(lo : i32, hi : i32, acc : i32) -> i32)(cond((lo > hi) => acc, true => recur((lo + i32(1)), hi, (acc + lo))));\nexport sum_range(i32(1), i32(50), i32(0));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "1275"), "sum 1..50=1275"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

test "Phase 5hf: for with index tracking", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "arr := [i32(10), i32(20), i32(30), i32(40), i32(50)];\n(weighted_sum : i32) = i32(0);\n(idx : i32) = i32(0);\nfor(v, arr, {\nweighted_sum = (weighted_sum + (v * (idx + i32(1))));\nidx = (idx + i32(1));\n});\nexport weighted_sum;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "550"), "10*1+20*2+30*3+40*4+50*5=550"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

test "Phase 5hf: multiple struct types interaction", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "Vec2 :: struct(x : i32, y : i32);\nCircle :: struct(center : Vec2, radius : i32);\nadd := (fn(a : Vec2, b : Vec2) -> Vec2)(Vec2(x: (a.x + b.x), y: (a.y + b.y)));\nc := Circle(center: Vec2(x: i32(3), y: i32(4)), radius: i32(5));\nmoved := Circle(center: add(c.center, Vec2(x: i32(10), y: i32(20))), radius: c.radius);\nexport moved.center.x;\nexport moved.center.y;\nexport moved.radius;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "13"), "3+10=13"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "24"), "4+20=24"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "5"), "radius=5"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

// Phase 5hg: windowed diffs, recursive string, computed stats struct, enum direction count, fib tail, split filter, modular pow, break first odd, digit count, cubed sum
test "Phase 5hg: array windowed differences", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "arr := [i32(3), i32(7), i32(2), i32(9), i32(1), i32(6)];\ndiffs := ArrayList(i32).new();\n(i : i32) = i32(1);\nwhile((i < arr.len()), {\nmatch(arr.get(i.to_usize()), .Some(curr) => match(arr.get((i - i32(1)).to_usize()), .Some(prev) => {\ndiffs.push((curr - prev));\n}, .None => ()), .None => ());\ni = (i + i32(1));\n});\nexport diffs.len();\nexport diffs.fold(i32(0), (fn(a : i32, b : i32) -> i32)((a + b)));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "5"), "5 diffs"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "3"), "sum of diffs = last-first = 6-3=3"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

