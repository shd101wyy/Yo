    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "105"), "1+..+14=105"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "15"), "i=15 after loop"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

