  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "Config :: struct(width : i32, height : i32, depth : i32);\nc1 := Config(width: i32(10), height: i32(20), depth: i32(30));\nc2 := Config(width: i32(10), height: i32(20), depth: i32(30));\nc3 := Config(width: i32(10), height: i32(20), depth: i32(31));\nexport (c1 == c2);\nexport (c1 == c3);\nexport ((c1.width + c1.height) + c1.depth);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .BoolVal(b) => assert(b, "c1==c2"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .BoolVal(b) => assert(!(b), "c1!=c3"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "60"), "10+20+30=60"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

