// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator core — Phase 3a/3b/3c/3d (literals + identifier lookup +
/// begin/cond/define/assign + arithmetic/comparison/boolean operators +
/// enum variant construction + match + while loops) through Phase 3ah
/// (integer div/mod + function composition + string equality + impl method call).

open import "std/fmt";
open import "std/string";
open import "std/error";
{ ArrayList } :: import "std/collections/array_list";

{ TokenKind, Token } :: import "../lexer/token.yo";
{ AstExpr, BK_BEGIN, BK_TUPLE, BK_ANON_STRUCT, BK_EXPORT, BK_OPEN, BK_IMPORT,
  BK_ENUM, BK_STRUCT, BK_OBJECT, BK_NEWTYPE, BK_UNION, BK_TRAIT, BK_ARRAY_VAL } :: import "../expr/expr.yo";
{ TypeValue, type_value_tag,
  t_i32, t_bool, t_u32, t_f32, t_type, t_unit,
  t_comptime_int, t_comptime_float, t_comptime_string } :: import "../types/type.yo";
{ TypeTag } :: import "../types/tags.yo";
{ Environment } :: import "../env/env.yo";
{ EvalValue, EvalResult } :: import "../evaluator/value.yo";
{ evaluate, parse_raw_int, evaluate_module_body, set_module_loader } :: import "../evaluator/eval.yo";
{ generate_exprs_from_code } :: import "../parser/parser.yo";

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

make_token :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind:        kind,
    value:       String.from(value),
    row:         usize(0),
    column:      usize(0),
    character:   usize(0),
    module_path: String.from(""),
    input:       String.from("")
  )
);

make_atom :: (fn(kind : TokenKind, value : str) -> AstExpr)(
  .Atom(usize(0), make_token(kind, value))
);

make_ident :: (fn(name : str) -> AstExpr)(
  make_atom(TokenKind.Identifier, name)
);

make_infix :: (fn(op : str, lhs : AstExpr, rhs : AstExpr) -> AstExpr)(
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Operator, op))),
    {
      args := ArrayList(AstExpr).new();
      args.push(lhs);
      args.push(rhs);
      args
    },
    true,
    make_token(TokenKind.Operator, op)
  )
);

/// Build a begin-block `{ stmts… }` from an ArrayList of statements.
make_begin :: (fn(stmts : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, BK_BEGIN))),
    stmts,
    false,
    make_token(TokenKind.Identifier, BK_BEGIN)
  )
);

/// Build the unit expression `()`.
make_unit :: (fn() -> AstExpr)(
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, BK_TUPLE))),
    ArrayList(AstExpr).new(),
    false,
    make_token(TokenKind.Identifier, BK_TUPLE)
  )
);

/// Build a cond arm `condition => body` (infix =>).
make_arm :: (fn(cond_expr : AstExpr, body_expr : AstExpr) -> AstExpr)(
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Operator, "=>"))),
    {
      a := ArrayList(AstExpr).new();
      a.push(cond_expr);
      a.push(body_expr);
      a
    },
    true,
    make_token(TokenKind.Operator, "=>")
  )
);

/// Build `cond(arm1, arm2, …)`.
make_cond :: (fn(arms : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "cond"))),
    arms,
    false,
    make_token(TokenKind.Identifier, "cond")
  )
);

/// Build `keyword(arg1, arg2, …)` — used for enum/struct/union/trait/object/newtype.
make_typedef_call :: (fn(keyword : str, type_args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, keyword))),
    type_args,
    false,
    make_token(TokenKind.Identifier, keyword)
  )
);

/// Build `func_name(arg1, arg2, …)` — a non-infix function call.
make_fncall_atom :: (fn(name : str, call_args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, name))),
    call_args,
    false,
    make_token(TokenKind.Identifier, name)
  )
);

/// Build a `label : type_expr` labeled field expression (infix colon).
make_labeled_field :: (fn(label : str, type_expr : AstExpr) -> AstExpr)(
  .FnCall(usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Operator, ":"))),
    {
      a := ArrayList(AstExpr).new();
      a.push(make_ident(label));
      a.push(type_expr);
      a
    },
    true,
    make_token(TokenKind.Operator, ":")
  )
);

/// Build `VariantName(field1, field2, …)` — enum variant with fields.
make_variant :: (fn(name : str, field_args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, name))),
    field_args,
    false,
    make_token(TokenKind.Identifier, name)
  )
);

empty_env :: (fn() -> Environment)(Environment.new(`test`));

check_some :: (fn(result : Option(EvalResult), label : str) -> unit)(
  match(result,
    .Some(_) => (),
    .None => {
      println(`FAIL [${label}]: expected Some, got None`);
      assert(false, label);
    }
  )
);

check_none :: (fn(result : Option(EvalResult), label : str) -> unit)(
  match(result,
    .Some(_) => {
      println(`FAIL [${label}]: expected None, got Some`);
      assert(false, label);
    },
    .None => ()
  )
);

check_some_eval_val :: (fn(result : Option(EvalValue), label : str) -> unit)(
  match(result,
    .Some(_) => (),
    .None => {
      println(`FAIL [${label}]: expected Some(EvalValue), got None`);
      assert(false, label);
    }
  )
);

// ---------------------------------------------------------------------------
// Bool literals
// ---------------------------------------------------------------------------

test "Phase 5he: combined operations pipeline", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "nums := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8), i32(9), i32(10)];\nresult := nums.filter((fn(x : i32) -> bool)((x % i32(2)) == i32(0))).map((fn(x : i32) -> i32)((x * x))).fold(i32(0), (fn(a : i32, b : i32) -> i32)((a + b)));\nexport result;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "220"), "4+16+36+64+100=220"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

// Phase 5hf: selection sort min, fast power, rectangle ops, factorial countdown, enum message data, chunk sums, word reverse, range sum, weighted index, struct interaction
test "Phase 5hf: array selection sort minimum finding", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "arr := [i32(5), i32(3), i32(8), i32(1), i32(4)];\n(min_val : i32) = i32(999);\n(min_idx : i32) = i32(0);\n(i : i32) = i32(0);\nwhile((i < arr.len()), {\nmatch(arr.get(i.to_usize()), .Some(v) => cond((v < min_val) => { min_val = v; min_idx = i; }, true => ()), .None => ());\ni = (i + i32(1));\n});\nexport min_val;\nexport min_idx;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "1"), "min=1"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "3"), "at idx 3"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5hf: recursive power with even optimization", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "fast_pow := (fn(base : i32, exp : i32) -> i32)(cond((exp == i32(0)) => i32(1), ((exp % i32(2)) == i32(0)) => {\nhalf := recur(base, (exp / i32(2)));\n(half * half)\n}, true => (base * recur(base, (exp - i32(1))))));\nexport fast_pow(i32(2), i32(10));\nexport fast_pow(i32(3), i32(5));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "1024"), "2^10=1024"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "243"), "3^5=243"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5hf: struct rectangle operations", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "Rect :: struct(w : i32, h : i32);\narea := (fn(r : Rect) -> i32)((r.w * r.h));\nperimeter := (fn(r : Rect) -> i32)(((r.w + r.h) * i32(2)));\nis_square := (fn(r : Rect) -> bool)((r.w == r.h));\nr1 := Rect(w: i32(5), h: i32(3));\nr2 := Rect(w: i32(4), h: i32(4));\nexport area(r1);\nexport perimeter(r1);\nexport is_square(r1);\nexport is_square(r2);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "15"), "5*3=15"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "16"), "(5+3)*2=16"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .BoolVal(b) => assert(!(b), "not square"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(3)), .Some(x) => match(x, .BoolVal(b) => assert(b, "is square"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5hf: while countdown with accumulator", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "(n : i32) = i32(10);\n(acc : i32) = i32(1);\nwhile((n > i32(1)), {\nacc = (acc * n);\nn = (n - i32(1));\n});\nexport acc;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "3628800"), "10!=3628800"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

test "Phase 5hf: enum message with data", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "Msg :: enum(Hello(i32), Goodbye(i32), Reset);\nvalue := (fn(m : Msg) -> i32)(match(m, .Hello(n) => (n * i32(2)), .Goodbye(n) => (n * i32(3)), .Reset => i32(0)));\nmsgs := [Msg.Hello(i32(5)), Msg.Goodbye(i32(4)), Msg.Reset, Msg.Hello(i32(10))];\n(total : i32) = i32(0);\nfor(m, msgs, { total = (total + value(m)); });\nexport total;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "42"), "5*2+4*3+0+10*2=42"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

test "Phase 5hf: array chunk processing", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8), i32(9)];\nchunk_size := i32(3);\n(chunk_sums : i32) = i32(0);\n(i : i32) = i32(0);\nwhile((i < arr.len()), {\n(chunk_sum : i32) = i32(0);\n(j : i32) = i32(0);\nwhile(((j < chunk_size) && ((i + j) < arr.len())), {\nmatch(arr.get((i + j).to_usize()), .Some(v) => { chunk_sum = (chunk_sum + v); }, .None => ());\nj = (j + i32(1));\n});\nchunk_sums = (chunk_sums + (chunk_sum * chunk_sum));\ni = (i + chunk_size);\n});\nexport chunk_sums;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "837"), "(1+2+3)^2+(4+5+6)^2+(7+8+9)^2=36+225+576=837"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

