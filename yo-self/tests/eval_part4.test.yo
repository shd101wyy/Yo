test "Phase 5ip: recursive digital root", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "digit_sum := (fn(n : i32) -> i32)(cond((n < i32(10)) => n, true => ((n % i32(10)) + recur((n / i32(10))))));\ndigital_root := (fn(n : i32) -> i32)(cond((n < i32(10)) => n, true => recur(digit_sum(n))));\nexport digital_root(i32(9));\nexport digital_root(i32(38));\nexport digital_root(i32(493));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
