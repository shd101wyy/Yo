test "Phase 5hg: struct with computed fields", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "Stats :: struct(min : i32, max : i32, sum : i32, count : i32);\ncompute := (fn(arr : [i32]) -> Stats)({\n(mn : i32) = i32(999);\n(mx : i32) = i32(0);\n(sm : i32) = i32(0);\n(ct : i32) = i32(0);\nfor(v, arr, {\ncond((v < mn) => { mn = v; }, true => ());\ncond((v > mx) => { mx = v; }, true => ());\nsm = (sm + v);\nct = (ct + i32(1));\n});\nStats(min: mn, max: mx, sum: sm, count: ct)\n});\ns := compute([i32(5), i32(2), i32(8), i32(1), i32(9), i32(3)]);\nexport s.min;\nexport s.max;\nexport s.sum;\nexport s.count;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "1"), "min=1"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "9"), "max=9"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "28"), "sum=28"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(3)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "6"), "count=6"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5hg: enum tree depth", {
