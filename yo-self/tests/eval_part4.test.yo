test "eval while sum until overflow", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "sum := i32(0);\ni := i32(1);\nwhile((sum < i32(100)), {\n  sum = (sum + i);\n  i = (i + i32(1));\n});\nexport sum;\nexport i;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  // 1+2+3+...+13=91, +14=105 >= 100. sum=105, i=15
