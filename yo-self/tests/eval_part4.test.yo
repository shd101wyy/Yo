  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "Color :: enum { Red, Green, Blue, Yellow };\ncolors := [Color.Red, Color.Blue, Color.Green, Color.Yellow, Color.Red];\nred_count := i32(0);\nfor(c, colors, {\n  match(c, .Red => { red_count = (red_count + i32(1)); }, _ => ());\n});\nexport red_count;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "2"), "2 reds"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

test "eval fold product and sum", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "nums := [2, 3, 4, 5];\nproduct := nums.fold(i32(1), (acc, x) => (acc * x));\nsum := nums.fold(i32(0), (acc, x) => (acc + x));\ndiff := (product - sum);\nexport diff;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  // product = 120, sum = 14, diff = 106
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "106"), "120-14=106"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

