// ---------------------------------------------------------------------------
// Phase 5acd — Nested loop / multi-level iteration
// ---------------------------------------------------------------------------
test("Phase 5acd: nested while loop — multiplication table sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "(total : i32) = i32(0);\n(i : i32) = i32(1);\nwhile(runtime((i <= i32(3))), {\n  (j : i32) = i32(1);\n  while(runtime((j <= i32(3))), {\n    total = (total + (i * j));\n    j = (j + i32(1));\n  });\n  i = (i + i32(1));\n});\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "36", "total=36"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5acd: while loop counting pairs that sum to target", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "target := i32(7);\nvals := [i32(1), i32(3), i32(4), i32(6), i32(2)];\n(count : i32) = i32(0);\n(i : usize) = usize(0);\nwhile(runtime((i < vals.len())), {\n  (j : usize) = (i + usize(1));\n  while(runtime((j < vals.len())), {\n    vi := vals.get(i).unwrap();\n    vj := vals.get(j).unwrap();\n    cond(((vi + vj) == target) => { count = (count + i32(1)); }, true => ());\n    j = (j + usize(1));\n  });\n  i = (i + usize(1));\n});\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2 pairs"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
// ---------------------------------------------------------------------------
// Phase 5ace — Multi-stage Result/Option pipeline combos
// ---------------------------------------------------------------------------
test("Phase 5ace: array of Results, filter Ok, map value, sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "results := [Result(i32, str).Ok(i32(10)), Result(i32, str).Err(\"bad\"), Result(i32, str).Ok(i32(20)), Result(i32, str).Ok(i32(30)), Result(i32, str).Err(\"fail\")];\nok_vals := results.filter((fn(r : i32) -> bool)(r.is_ok())).map((fn(r : i32) -> i32)(r.unwrap()));\ntotal := ok_vals.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\nexport(ok_vals.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "60", "total=60"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3 ok"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
