// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5ac series: advanced patterns combining
/// multiple features — mutable structs, chained transforms, dual-array ops,
/// nested loops, and multi-stage pipelines.
///
/// Phases covered:
///   5aca — Mutable struct field updates via while loop
///   5acb — Chained string transforms (split → filter → map → join)
///   5acc — Two-array zip-fold and pairwise operations
///   5acd — Nested loop matrix operations
///   5ace — Multi-stage Result/Option pipeline combos
///   5acf — Mixed numeric and string combos
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5aca — Mutable struct field updates
// ---------------------------------------------------------------------------
test("Phase 5aca: accumulate struct field via while loop", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "Counter :: struct(value: i32);\n(c : Counter) = Counter(value: i32(0));\n(i : i32) = i32(0);\nwhile(runtime((i < i32(5))), {\n  c = Counter(value: (c.value + i32(1)));\n  i = (i + i32(1));\n});\nexport(c.value);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "c=5"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5aca: struct fields in arithmetic pipeline", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "Point :: struct(x: i32, y: i32);\npoints := [Point(x: i32(1), y: i32(2)), Point(x: i32(3), y: i32(4)), Point(x: i32(5), y: i32(6))];\nsum_x := points.fold(i32(0), (fn(acc : i32, p : i32) -> i32)((acc + p.x)));\nsum_y := points.fold(i32(0), (fn(acc : i32, p : i32) -> i32)((acc + p.y)));\nexport(sum_x);\nexport(sum_y);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "9", "sum_x=9"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "12", "sum_y=12"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
