          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "6"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
