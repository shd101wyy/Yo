});
// ---------------------------------------------------------------------------
// Phase 5acf — Mixed numeric and string combos
// ---------------------------------------------------------------------------
test("Phase 5acf: build number from digits via fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "digits := [i32(1), i32(2), i32(3), i32(4)];\nnum := digits.fold(i32(0), (fn(acc : i32, d : i32) -> i32)(((acc * i32(10)) + d)));\nexport(num);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1234", "1234"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5acf: map numbers to even/odd labels, count evens", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "nums := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6)];\nevens := nums.filter((fn(n : i32) -> bool)(((n % i32(2)) == i32(0))));\nexport(evens.len());\nexport(evens.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x))));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3 evens"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "12", "sum=12"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5acf: fibonacci sequence via while, nth value", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "(a : i32) = i32(0);\n(b : i32) = i32(1);\n(i : i32) = i32(0);\nwhile(runtime((i < i32(7))), {\n  (tmp : i32) = b;\n  b = (a + b);\n  a = tmp;\n  i = (i + i32(1));\n});\nexport(a);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "13", "fib(7)=13"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5acf: string repeat via fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "n := i32(4);\n(i : i32) = i32(0);\n(result : str) = \"\";\nwhile(runtime((i < n)), {\n  result = (result + \"ab\");\n  i = (i + i32(1));\n});\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.StrLit(s) => assert(s.as_str() == "\"abababab\"", "abababab"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5acf: mixed string+number summary", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "words := \"the quick brown fox\";\narr := words.split(\" \");\nword_count := arr.len();\ntotal_len := arr.fold(i32(0), (fn(acc : i32, w : str) -> i32)((acc + w.len())));\nlongest := arr.fold(i32(0), (fn(acc : i32, w : str) -> i32)(acc.max(w.len())));\nexport(word_count);\nexport(total_len);\nexport(longest);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(3), "3 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "4 words"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "16", "16 chars"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
        match(
          v.get(usize(2)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "longest=5"), _ => assert(false, "t2")),
          .None => assert(false, "v2")
        );
      },
      _ => assert(false, "m")
    )
  );
});
