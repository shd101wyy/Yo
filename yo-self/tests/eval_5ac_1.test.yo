// Phase 5acc — Two-array zip-fold and pairwise operations
// ---------------------------------------------------------------------------
test("Phase 5acc: zip two arrays and fold to dot product", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "a := [i32(1), i32(2), i32(3)];\nb := [i32(4), i32(5), i32(6)];\npairs := a.zip(b);\ndot := pairs.fold(i32(0), (fn(acc : i32, p : i32) -> i32)((acc + (p.0 * p.1))));\nexport(dot);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "32", "dot=32"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
