test("Phase 5acb: split then filter non-empty then join", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := \"a,,b,,c\";\nparts := s.split(\",\");\nnon_empty := parts.filter((fn(w : str) -> bool)((w.len() > i32(0))));\nresult := non_empty.join(\"-\");\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.StrLit(s) => assert(s.as_str() == "\"a-b-c\"", "a-b-c"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
