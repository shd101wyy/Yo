test "Phase 5dx: while newton method isqrt", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "isqrt_newton := (fn(n : i32) -> i32)({ (x : i32) = n; while(((x * x) > n), { x = (((x + (n / x)) / i32(2))); }); x }); r := isqrt_newton(i32(144)); export r;";
  exprs := generate_exprs_from_code(src, using(exn));
