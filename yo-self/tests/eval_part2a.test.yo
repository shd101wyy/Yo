      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "64"), "largest pow2 < 100 = 64"),
            _ => assert(false, "not IntLit")
          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

test "Phase 5dw: fold with string comparison simulation", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "arr := [i32(3), i32(1), i32(4), i32(1), i32(5), i32(9)]; count_ones := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)(cond((x == i32(1)) => (acc + i32(1)), true => acc))); export count_ones;";
