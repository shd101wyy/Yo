      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(b, "Coord(5,8) == Coord(5,8)"),
            _ => assert(false, "not BoolVal")
          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

// Phase 5dy: final tests for this batch
test "Phase 5dy: recursive tribonacci iterative", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "trib_iter := (fn(n : i32) -> i32)({ (a : i32) = i32(0); (b : i32) = i32(0); (c : i32) = i32(1); (i : i32) = i32(2); while((i < n), { (next : i32) = ((a + b) + c); a = b; b = c; c = next; i = (i + i32(1)); }); c }); r := trib_iter(i32(8)); export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "24"), "trib(8)=24"),
            _ => assert(false, "not IntLit")
          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

test "Phase 5dy: enum multi-variant with data extraction", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "Msg :: enum(Ping, Pong(i32), Error(i32)); handle := (fn(m : Msg) -> i32)(match(m, .Ping => i32(1), .Pong(v) => (v * i32(2)), .Error(code) => -(code))); r1 := handle(Msg.Pong(i32(5))); r2 := handle(Msg.Error(i32(3))); export r1; export r2;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(2)), "2 exports");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "10"), "Pong(5)*2=10"),
            _ => assert(false, "r1 not IntLit")
          ),
          .None => assert(false, "no r1")
        );
        match(vals.get(usize(1)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "-3"), "Error(3)=>-3"),
            _ => assert(false, "r2 not IntLit")
          ),
          .None => assert(false, "no r2")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

test "Phase 5dy: while loop compute gcd and lcm together", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "gcd := (fn(a : i32, b : i32) -> i32)({ (x : i32) = a; (y : i32) = b; while((y != i32(0)), { (tmp : i32) = y; y = (x % y); x = tmp; }); x }); g := gcd(i32(15), i32(20)); lcm := ((i32(15) * i32(20)) / g); r := (g + lcm); export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "65"), "gcd(15,20)=5, lcm=60, sum=65"),
            _ => assert(false, "not IntLit")
          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

test "Phase 5dy: array all and any combined", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "arr := [i32(2), i32(4), i32(6), i32(8)]; r1 := arr.all((fn(x : i32) -> bool)(((x % i32(2)) == i32(0)))); r2 := arr.any((fn(x : i32) -> bool)((x > i32(10)))); export r1; export r2;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(2)), "2 exports");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(b, "all even"),
            _ => assert(false, "r1 not BoolVal")
          ),
          .None => assert(false, "no r1")
        );
        match(vals.get(usize(1)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(!(b), "none > 10"),
            _ => assert(false, "r2 not BoolVal")
          ),
          .None => assert(false, "no r2")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};
