  src := "Res :: enum(Ok(i32), Err); safe_div := (fn(a : i32, b : i32) -> Res)(cond((b == i32(0)) => Res.Err, true => Res.Ok((a / b)))); r := safe_div(i32(10), i32(2)); export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "safe_div returned None"),
