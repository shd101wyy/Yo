          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

test "Phase 5dw: fn with boolean return and multiple conditions", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "is_prime_small := (fn(n : i32) -> bool)(cond((n <= i32(1)) => false, (n <= i32(3)) => true, ((n % i32(2)) == i32(0)) => false, ((n % i32(3)) == i32(0)) => false, true => true)); r1 := is_prime_small(i32(7)); r2 := is_prime_small(i32(9)); export r1; export r2;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(2)), "2 exports");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(b, "7 is prime"),
            _ => assert(false, "r1 not BoolVal")
          ),
          .None => assert(false, "no r1")
        );
        match(vals.get(usize(1)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(!(b), "9 not prime"),
            _ => assert(false, "r2 not BoolVal")
          ),
          .None => assert(false, "no r2")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

// Phase 5dx: advanced patterns
test "Phase 5dx: while loop euclidean distance approx", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "isqrt := (fn(n : i32) -> i32)({ (x : i32) = i32(1); while(((x * x) <= n), { x = (x + i32(1)); }); (x - i32(1)) }); dist_sq := ((i32(3) * i32(3)) + (i32(4) * i32(4))); r := isqrt(dist_sq); export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "5"), "sqrt(9+16)=5"),
            _ => assert(false, "not IntLit")
          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

test "Phase 5dx: map square then filter even then fold", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5)]; r := arr.map((fn(x : i32) -> i32)((x * x))).filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(0)))).fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x))); export r;";
