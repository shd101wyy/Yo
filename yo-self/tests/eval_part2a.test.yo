test "Phase 5dw: array filter none match", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "arr := [i32(1), i32(2), i32(3)]; filtered := arr.filter((fn(x : i32) -> bool)((x > i32(10)))); r := filtered.len(); export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "0"), "none > 10"),
            _ => assert(false, "not IntLit")
          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

test "Phase 5dw: recursive largest power of 2 less than n", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "largest_pow2 := (fn(n : i32) -> i32)({ (p : i32) = i32(1); while(((p * i32(2)) < n), { p = (p * i32(2)); }); p }); r := largest_pow2(i32(100)); export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
