// ─── Unit and parenthesized expressions ──────────────────────────────────────
test("Parse unit value ()", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  prog := parse(`()`, `test.yo`, exn);
  e := only_expr(prog);
  assert(ast_expr_is_fn_call(e), "expected FnCall (unit is FnCall('tuple',[]))");
  assert_str_eq(ast_expr_to_string(e), `()`, "unit value");
});
test("Parse parenthesized expression (x)", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  prog := parse(`(x)`, `test.yo`, exn);
  e := only_expr(prog);
  // single expr in parens → the inner expr, not a wrapper
  assert_str_eq(ast_expr_to_string(e), `x`, "parenthesized expr unwrapped");
});
