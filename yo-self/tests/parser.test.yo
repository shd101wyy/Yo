// ─── Phase 5g: Error formatting ──────────────────────────────────────────────
test("extract_source_line: row 0 returns first line", {
  src := String.from("hello\nworld\nfoo");
  result := extract_source_line(src, usize(0));
  assert_str_eq(result, String.from("hello"), "row 0 should return(first line)");
});
test("extract_source_line: row 1 returns second line", {
  src := String.from("hello\nworld\nfoo");
  result := extract_source_line(src, usize(1));
  assert_str_eq(result, String.from("world"), "row 1 should return(second line)");
});
test("extract_source_line: out-of-range returns empty string", {
  src := String.from("hello\nworld");
  result := extract_source_line(src, usize(99));
  assert_str_eq(result, String.from(""), "out-of-range row should return(empty string)");
});
test("ParseError.to_string: format with source line", {
  err := ParseError(
    message : String.from("unexpected token: }"),
    row : usize(3),
    column : usize(0),
    module_path : String.from("test.yo"),
    source_line : String.from("}")
  );
  s := err.to_string();
  assert(s.contains(String.from("error: unexpected token: }")), "should contain error message");
  assert(s.contains(String.from("--> test.yo:4:0")), "should show row+1=4 in location");
  assert(s.contains(String.from("4 | }")), "should show source line with row+1");
});
// ---------------------------------------------------------------------------
// generate_expr_from_code
// ---------------------------------------------------------------------------
test("generate_expr_from_code: integer literal produces atom", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  expr := generate_expr_from_code(String.from("42"), exn);
  assert(ast_expr_is_atom(expr), "42 should be an atom expression");
});
test("generate_expr_from_code: identifier produces atom", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  expr := generate_expr_from_code(String.from("x"), exn);
  assert(ast_expr_is_atom(expr), "identifier should be an atom expression");
});
test("generate_expr_from_code: function call produces fn call expr", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  expr := generate_expr_from_code(String.from("foo()"), exn);
  assert(ast_expr_is_fn_call(expr), "foo() should be a fn call expression");
});
