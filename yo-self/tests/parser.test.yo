// ─── Multiple top-level expressions ──────────────────────────────────────────
test("Parse two top-level expressions separated by semicolon", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  prog := parse(`a; b`, `test.yo`, exn);
  assert(prog.len() == usize(2), "expected 2 expressions");
  match(
    prog.get(usize(0)),
    .None => assert(false, "no first expr"),
    .Some(e) => assert_str_eq(ast_expr_to_string(e), `a`, "first expr")
  );
  match(
    prog.get(usize(1)),
    .None => assert(false, "no second expr"),
    .Some(e) => assert_str_eq(ast_expr_to_string(e), `b`, "second expr")
  );
});
test("Parse trailing semicolon appends unit expression", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  prog := parse(`x;`, `test.yo`, exn);
  assert(prog.len() == usize(2), "expected 2 exprs (x and trailing unit)");
  match(
    prog.get(usize(0)),
    .None => assert(false, "no first expr"),
    .Some(e) => assert_str_eq(ast_expr_to_string(e), `x`, "first is x")
  );
  match(
    prog.get(usize(1)),
    .None => assert(false, "no second expr"),
    .Some(e) => assert_str_eq(ast_expr_to_string(e), `()`, "second is unit")
  );
});
