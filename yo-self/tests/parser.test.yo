      }
    )
  );
  prog := parse(`// this is a comment`, `test.yo`, exn);
  assert(prog.len() == usize(0), "comment-only program has 0 expressions");
});
// ─── Dot variant (enum constructor start) ────────────────────────────────────
test("Parse dot-prefixed identifier .Some", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  prog := parse(`.Some`, `test.yo`, exn);
  e := only_expr(prog);
  // .Some → FnCall(Atom("."), [Atom("Some")], true) — unary dot
  assert(ast_expr_is_fn_call(e), "expected FnCall for .Some");
  assert_str_eq(ast_expr_to_string(e), `.Some`, "dot-prefixed atom");
});
test("Parse dot-prefixed call .Ok(x)", {
