open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_to_string, ast_expr_is_atom, ast_expr_is_fn_call, make_err_expr } :: import("../expr.yo");
{ ParseError, parse, extract_source_line, generate_expr_from_code } :: import("../parser.yo");
{ assert, panic } :: import("std/assert");
// ─── Helpers ─────────────────────────────────────────────────────────────────
// Check that two String values are equal; fails with msg if not.
assert_str_eq :: (fn(actual : String, expected : String, msg : str) -> unit)(
  if(actual == expected, (), {
    println(`assert_str_eq FAILED: expected="${expected}" actual="${actual}" — ${msg}`);
    assert(false, msg);
  })
);
// Retrieve the only expression from a program, asserting length == 1.
only_expr :: (fn(prog : ArrayList(AstExpr)) -> AstExpr)({
  assert(prog.len() == usize(1), "expected program with exactly 1 top-level expression");
  match(
    prog.get(usize(0)),
    .None => {
      assert(false, "no expression at index 0");
      make_err_expr()
    },
    .Some(e) => e
  )
});
// ─── Atoms ───────────────────────────────────────────────────────────────────
test("Parse single identifier", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  prog := parse(`hello`, `test.yo`, exn);
  e := only_expr(prog);
  assert(ast_expr_is_atom(e), "expected Atom");
  assert_str_eq(ast_expr_to_string(e), `hello`, "identifier value");
});
