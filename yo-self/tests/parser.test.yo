  );
  prog := parse(`.Ok(x)`, `test.yo`, exn);
  e := only_expr(prog);
  assert(ast_expr_is_fn_call(e), "expected FnCall");
  assert_str_eq(ast_expr_to_string(e), `.Ok(x)`, "dot-prefixed call");
});
