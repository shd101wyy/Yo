test("Phase 5ql: T1+T2+T3 of [1, 2, 6, 9, 7, 4, 3, 5, 8] = 98", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(1), i32(2), i32(6), i32(9), i32(7), i32(4), i32(3), i32(5), i32(8)];\nT1 := i32(0); mx1 := i32(0); i := i32(0);\nwhile((i < i32(9)), { v := arr.get(i).unwrap(); mx1 = cond((v > mx1) => v, true => mx1); T1 = (T1 + mx1); i = (i + i32(1)); });\nT2 := i32(0); mn2 := i32(9999); j := i32(8);\nwhile((j >= i32(0)), { v := arr.get(j).unwrap(); mn2 = cond((v < mn2) => v, true => mn2); T2 = (T2 + mn2); j = (j - i32(1)); });\nT3 := i32(0); mx3 := i32(0); k := i32(0);\nwhile((k < i32(9)), { v := arr.get(k).unwrap(); is_new := cond((v > mx3) => i32(1), true => i32(0)); T3 = (T3 + is_new); mx3 = cond((v > mx3) => v, true => mx3); k = (k + i32(1)); });\nr := ((T1 + T2) + T3);\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "98", "98"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
