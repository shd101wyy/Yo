test("Phase 5ql: T1+T5+T9 of [1, 2, 6, 9, 7, 4, 3, 5, 8] = 89", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
