// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5ab series: is_empty, struct-array HOF,
/// numeric algorithms, string transformations, nested Option/Result patterns.
///
/// Phases covered:
///   5aba — ArrayVal.is_empty() and StrLit.is_empty()
///   5abb — Struct array with HOF field access
///   5abc — Numeric algorithms (GCD, power, digit count)
///   5abd — String building and transformation
///   5abe — Nested Option/Result patterns
///   5abf — Edge cases with empty collections
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5aba — ArrayVal.is_empty() and StrLit.is_empty()
// ---------------------------------------------------------------------------
test("Phase 5aba: ArrayVal.is_empty() on empty array", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "(arr : [i32]) = [];\nexport(arr.is_empty());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "empty"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
