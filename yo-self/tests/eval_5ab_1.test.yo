// Phase 5abd — String building and transformation
// ---------------------------------------------------------------------------
test("Phase 5abd: build string from words via fold+concat", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "words := [\"foo\", \"bar\", \"baz\"];\nresult := words.fold(\"\", (fn(acc : str, w : str) -> str)(cond(acc.is_empty() => w, true => ((acc + \" \") + w))));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.StrLit(s) => assert(s.as_str() == "\"foo bar baz\"", "foo bar baz"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
