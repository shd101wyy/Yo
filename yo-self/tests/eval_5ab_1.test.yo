// ---------------------------------------------------------------------------
// Phase 5abe — Nested Option/Result patterns
// ---------------------------------------------------------------------------
test("Phase 5abe: Option.and_then with condition", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "outer := Option(i32).Some(i32(42));\nresult := outer.and_then((fn(x : i32) -> i32)(cond((x > i32(10)) => Option(i32).Some((x * i32(2))), true => Option(i32).None)));\nexport(result.is_some());\nexport(result.unwrap());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "is_some"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "84", "84"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5abe: array of Options, count Some values", {
