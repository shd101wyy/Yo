        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b == false, "not empty"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
