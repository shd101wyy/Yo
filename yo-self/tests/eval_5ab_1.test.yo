test("Phase 5abb: struct array, find by field value", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "Entry :: struct(key: i32, val: i32);\nentries := [Entry(key: i32(10), val: i32(100)), Entry(key: i32(20), val: i32(200)), Entry(key: i32(30), val: i32(300))];\nfound := entries.find((fn(e : i32) -> bool)((e.key == i32(20))));\nexport(found.is_some());\nexport(found.unwrap().val);\n";
  exprs := generate_exprs_from_code(src, using(exn));
