test("Phase 5abe: Result.ok() chain with map", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "r := Result(i32, str).Ok(i32(7));\nopt := r.ok();\ndoubled := opt.map((fn(x : i32) -> i32)((x * i32(2))));\nexport(doubled.is_some());\nexport(doubled.unwrap());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "is_some"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "14", "14"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5abe: Result chain — map then and_then then unwrap_or", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "r := Result(i32, str).Ok(i32(5));\nresult := r.map((fn(x : i32) -> i32)((x * i32(3)))).and_then((fn(x : i32) -> i32)(cond((x > i32(10)) => Result(i32, str).Ok((x + i32(1))), true => Result(i32, str).Ok(x)))).unwrap_or(i32(0));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
