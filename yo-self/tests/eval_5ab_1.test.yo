// Phase 5abb — Struct array with HOF field access
// ---------------------------------------------------------------------------
test("Phase 5abb: array of structs, fold on field sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "Item :: struct(value: i32, weight: i32);\nitems := [Item(value: i32(10), weight: i32(2)), Item(value: i32(20), weight: i32(3)), Item(value: i32(15), weight: i32(1))];\ntotal := items.fold(i32(0), (fn(acc : i32, item : i32) -> i32)((acc + item.value)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "45", "45"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
