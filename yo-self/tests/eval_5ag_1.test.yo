test("Phase 5age: zip then filter to keep pairs where both are positive", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "a := [i32(1), (i32(0) - i32(2)), i32(3), (i32(0) - i32(4))];\nb := [i32(5), i32(6), (i32(0) - i32(7)), i32(8)];\npairs := a.zip(b);\nresult := pairs.filter((fn(t : (i32, i32)) -> bool)((t.0 > i32(0)) && (t.1 > i32(0))));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .ArrayVal(arr) => assert(arr.len() == usize(1), "1 pair both positive"),
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5age: enumerate + all — check all values are greater than zero", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(5), i32(10), i32(15)];\npairs := arr.enumerate();\nresult := pairs.all((fn(t : (usize, i32)) -> bool)(t.1 > i32(0)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "all vals > 0"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5age: filter by ends_with then count", {
