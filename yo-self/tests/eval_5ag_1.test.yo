              match(arr.get(usize(0)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "0", "idx0=0"), _ => assert(false, "0")),.None => assert(false, "0"));
              match(arr.get(usize(1)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "1", "idx1=1"), _ => assert(false, "1")),.None => assert(false, "1"));
              match(arr.get(usize(2)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "2", "idx2=2"), _ => assert(false, "2")),.None => assert(false, "2"));
            },
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5agc: enumerate then filter to keep elements at even indices", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(10), i32(20), i32(30), i32(40), i32(50)];\nenum_arr := arr.enumerate();\neven_idx := enum_arr.filter((fn(t : (usize, i32)) -> bool)((t.0 % usize(2)) == usize(0)));\nresult := even_idx.map((fn(t : (usize, i32)) -> i32)(t.1));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .ArrayVal(arr) => {
              assert(arr.len() == usize(3), "len=3 (indices 0,2,4)");
              match(arr.get(usize(0)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "10", "idx0=10"), _ => assert(false, "0")),.None => assert(false, "0"));
              match(arr.get(usize(1)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "30", "idx2=30"), _ => assert(false, "1")),.None => assert(false, "1"));
              match(arr.get(usize(2)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "50", "idx4=50"), _ => assert(false, "2")),.None => assert(false, "2"));
            },
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
