// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5ag series: find, any/all combos, zip,
/// enumerate, starts_with/ends_with pipelines, contains combos.
///
/// Phases covered:
///   5aga — ArrayVal.find(fn) returns Option (Some/None)
///   5agb — ArrayVal.any(fn) / ArrayVal.all(fn) with complex predicates
///   5agc — ArrayVal.zip(other) and enumerate pipelines
///   5agd — StrLit.starts_with / ends_with / contains combos
///   5age — Complex multi-method pipelines
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5aga — ArrayVal.find(fn) returns Option (Some/None)
// ---------------------------------------------------------------------------
test("Phase 5aga: find returns Some(first element satisfying predicate)", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(1), i32(2), i32(3), i32(4)];\nresult := arr.find((fn(x : i32) -> bool)(x > i32(2)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .EnumVal(tag, fields) => {
              assert(tag.as_str() == ".Some", "tag=Some");
              match(
                fields.get(usize(0)),
                .Some(inner) => match(inner,.IntLit(n) => assert(n.as_str() == "3", "first>2 is 3"), _ => assert(false, "inner")),
                .None => assert(false, "inner")
              );
            },
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
