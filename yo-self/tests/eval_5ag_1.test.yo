// ---------------------------------------------------------------------------
// Phase 5agc — ArrayVal.zip and enumerate pipelines
// ---------------------------------------------------------------------------
test("Phase 5agc: zip two arrays and map to sum of pairs", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "a := [i32(1), i32(2), i32(3)];\nb := [i32(10), i32(20), i32(30)];\npairs := a.zip(b);\nresult := pairs.map((fn(t : (i32, i32)) -> i32)(t.0 + t.1));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .ArrayVal(arr) => {
              assert(arr.len() == usize(3), "len=3");
              match(arr.get(usize(0)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "11", "sum0=11"), _ => assert(false, "0")),.None => assert(false, "0"));
              match(arr.get(usize(1)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "22", "sum1=22"), _ => assert(false, "1")),.None => assert(false, "1"));
              match(arr.get(usize(2)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "33", "sum2=33"), _ => assert(false, "2")),.None => assert(false, "2"));
            },
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5agc: zip then fold to compute dot product", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "a := [i32(1), i32(2), i32(3)];\nb := [i32(4), i32(5), i32(6)];\npairs := a.zip(b);\nresult := pairs.fold(i32(0), (fn(acc : i32, t : (i32, i32)) -> i32)(acc + (t.0 * t.1)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "32", "dot=1*4+2*5+3*6=32"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
