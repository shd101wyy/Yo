test("Phase 5oe: full combo break+continue+struct+helper+method", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "double := (fn(x : i32) -> i32)({ (x * i32(2)) });\nS :: struct(items : ArrayList(i32), limit : i32);\nimpl(S, Process(\n  run : (fn(s : S) -> i32)({\n    acc := i32(0);\n    for(x, s.items, {\n      cond((x < i32(0)) => continue(), (double(x) > s.limit) => break(), true => ());\n      acc = (acc + double(x));\n    });\n    acc\n  })\n));\narr := ArrayList(i32).new();\narr.push(i32(2));\narr.push(i32(0) - i32(1));\narr.push(i32(3));\narr.push(i32(7));\narr.push(i32(1));\ns := S(items: arr, limit: i32(12));\nexport(s.run());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "10", "double(2)+double(3)=10"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
