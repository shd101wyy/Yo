// ---------------------------------------------------------------------------
// Phase 5oc — break and continue inside impl method bodies
// ---------------------------------------------------------------------------
test("Phase 5oc: method finds first element above threshold via break", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "S :: struct(items : ArrayList(i32), thresh : i32);\nimpl(S, Find(\n  first_above : (fn(s : S) -> i32)({\n    result := i32(0);\n    for(x, s.items, {\n      cond((x > s.thresh) => { result = x; break(); }, true => ());\n    });\n    result\n  })\n));\narr := ArrayList(i32).new();\narr.push(i32(1));\narr.push(i32(3));\narr.push(i32(7));\narr.push(i32(2));\ns := S(items: arr, thresh: i32(4));\nexport(s.first_above());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "7", "first>4=7"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5oc: method sums elements until partial sum exceeds limit", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "S :: struct(items : ArrayList(i32), limit : i32);\nimpl(S, SumUntil(\n  sum_until : (fn(s : S) -> i32)({\n    acc := i32(0);\n    for(x, s.items, {\n      acc = (acc + x);\n      cond((acc > s.limit) => break(), true => ());\n    });\n    acc\n  })\n));\narr := ArrayList(i32).new();\narr.push(i32(3));\narr.push(i32(4));\narr.push(i32(5));\narr.push(i32(6));\ns := S(items: arr, limit: i32(10));\nexport(s.sum_until());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "12", "3+4+5=12>10"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5oc: method counts non-zero elements via continue", {
