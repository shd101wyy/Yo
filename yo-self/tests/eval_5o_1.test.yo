// Phase 5ob — continue in while loops (module level)
// ---------------------------------------------------------------------------
test("Phase 5ob: sum even numbers in [0..9] via continue", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "(i : i32) = i32(0);\nresult := i32(0);\nwhile(runtime(i < i32(10)), {\n  cond(((i % i32(2)) != i32(0)) => { i = (i + i32(1)); continue(); }, true => ());\n  result = (result + i);\n  i = (i + i32(1));\n});\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "20", "0+2+4+6+8=20"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ob: skip negatives/zero via continue, sum positives", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "arr := ArrayList(i32).new();\narr.push(i32(0) - i32(2));\narr.push(i32(0) - i32(1));\narr.push(i32(0));\narr.push(i32(1));\narr.push(i32(2));\narr.push(i32(3));\narr.push(i32(4));\nresult := i32(0);\n(i : usize) = usize(0);\nwhile(runtime(i < arr.len()), {\n  match(arr.get(i), .Some(v) => cond((v <= i32(0)) => { i = (i + usize(1)); continue(); }, true => { result = (result + v); }), .None => ());\n  i = (i + usize(1));\n});\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "10", "1+2+3+4=10"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
