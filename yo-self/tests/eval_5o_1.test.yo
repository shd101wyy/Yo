test("Phase 5oa: first element > 5 in ArrayList via while+break", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "arr := ArrayList(i32).new();\narr.push(i32(0));\narr.push(i32(3));\narr.push(i32(8));\narr.push(i32(2));\narr.push(i32(9));\narr.push(i32(1));\narr.push(i32(6));\nresult := i32(0);\n(i : usize) = usize(0);\nn := arr.len();\nwhile(runtime(i < n), {\n  match(arr.get(i), .Some(v) => cond((v > i32(5)) => { result = v; break(); }, true => ()), .None => ());\n  i = (i + usize(1));\n});\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "8", "first>5=8"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
