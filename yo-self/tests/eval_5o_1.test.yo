// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5o series: break and continue in loops.
///
/// Phases covered:
///   5oa — break in while loops (module level)
///   5ob — continue in while loops (module level)
///   5oc — break and continue inside impl method bodies
///   5od — break and continue in for-loops at module level
///   5oe — complex combos: break/continue + struct + helper + multi-export

open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5oa — break in while loops (module level)
// ---------------------------------------------------------------------------
test("Phase 5oa: break when i > 5, result = first such i", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "(i : i32) = i32(0);\nresult := i32(0);\nwhile(runtime(i < i32(10)), {\n  cond((i > i32(5)) => { result = i; break(); }, true => ());\n  i = (i + i32(1));\n});\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "6", "i>5 first=6"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5oa: break when cumulative sum exceeds 10", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "result := i32(0);\n(i : i32) = i32(1);\nwhile(runtime(i < i32(20)), {\n  result = (result + i);\n  cond((result > i32(10)) => break(), true => ());\n  i = (i + i32(1));\n});\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "15", "1+2+3+4+5=15"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
