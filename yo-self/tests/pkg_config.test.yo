open(import("std/fmt"));
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  parse_cflags,
  parse_ldflags_into,
  build_fallback,
  apply_system_library_metadata,
  PkgConfigResult,
  BuildSystemLibrary
} :: import("../pkg_config.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
_make_lib :: (
  fn(
    name : String,
    fallback_include : String,
    fallback_lib : String,
    fallback_link : String
  ) -> BuildSystemLibrary
)(
  BuildSystemLibrary(
    name : name,
    fallback_include : fallback_include,
    fallback_lib : fallback_lib,
    fallback_link : fallback_link,
    defines : ArrayList(String).new()
  )
);
_make_lib_with_defines :: (
  fn(
    name : String,
    defines : ArrayList(String)
  ) -> BuildSystemLibrary
)(
  BuildSystemLibrary(
    name : name,
    fallback_include : String.new(),
    fallback_lib : String.new(),
    fallback_link : String.new(),
    defines : defines
  )
);
_empty_for_test :: (fn() -> PkgConfigResult)(
  PkgConfigResult(
    c_flags : ArrayList(String).new(),
    ld_flags : ArrayList(String).new(),
    include_paths : ArrayList(String).new(),
    library_paths : ArrayList(String).new(),
    link_libraries : ArrayList(String).new(),
    defines : ArrayList(String).new(),
    runtime_files : ArrayList(String).new()
  )
);
// ---------------------------------------------------------------------------
// parse_cflags tests
// ---------------------------------------------------------------------------
test("parse_cflags: empty string gives empty result", {
  r := parse_cflags(String.new());
  assert(r.include_paths.len() == usize(0), "no include paths");
  assert(r.c_flags.len() == usize(0), "no c_flags");
});
test("parse_cflags: -I flag is added to include_paths", {
  r := parse_cflags(String.from("-I/usr/include/foo"));
  assert(r.include_paths.len() == usize(1), "one include path");
  ip := match(r.include_paths.get(usize(0)),.None => String.new(),.Some(p) => p);
  assert(ip == "/usr/include/foo", "correct include path");
  assert(r.c_flags.len() == usize(0), "no other c_flags");
});
test("parse_cflags: non-I flags go to c_flags", {
  r := parse_cflags(String.from("-pthread -fPIC"));
  assert(r.c_flags.len() == usize(2), "two c_flags");
  assert(r.include_paths.len() == usize(0), "no include paths");
});
test("parse_cflags: mixed flags are split correctly", {
  r := parse_cflags(String.from("-I/usr/include -pthread -DFOO_ENABLED"));
  assert(r.include_paths.len() == usize(1), "one include path");
  assert(r.c_flags.len() == usize(2), "two c_flags");
  ip := match(r.include_paths.get(usize(0)),.None => String.new(),.Some(p) => p);
  assert(ip == "/usr/include", "correct include path");
});
// ---------------------------------------------------------------------------
// parse_ldflags_into tests
// ---------------------------------------------------------------------------
test("parse_ldflags_into: empty string gives empty result", {
  r := parse_cflags(String.new());
  r2 := parse_ldflags_into(String.new(), r);
  assert(r2.library_paths.len() == usize(0), "no library paths");
  assert(r2.link_libraries.len() == usize(0), "no link libraries");
  assert(r2.ld_flags.len() == usize(0), "no ld_flags");
});
test("parse_ldflags_into: -L and -l are split correctly", {
  r := parse_cflags(String.new());
  r2 := parse_ldflags_into(String.from("-L/usr/lib -lz -lio"), r);
  assert(r2.library_paths.len() == usize(1), "one library path");
  assert(r2.link_libraries.len() == usize(2), "two link libraries");
  lp := match(r2.library_paths.get(usize(0)),.None => String.new(),.Some(p) => p);
  assert(lp == "/usr/lib", "correct library path");
  ll0 := match(r2.link_libraries.get(usize(0)),.None => String.new(),.Some(p) => p);
  assert(ll0 == "z", "first link library is z");
});
test("parse_ldflags_into: non-L/l flags go to ld_flags", {
  r := parse_cflags(String.new());
  r2 := parse_ldflags_into(String.from("-Wl,-rpath,/usr/lib64"), r);
  assert(r2.ld_flags.len() == usize(1), "one ld_flag");
  assert(r2.link_libraries.len() == usize(0), "no link libraries");
});
// ---------------------------------------------------------------------------
// build_fallback tests
// ---------------------------------------------------------------------------
test("build_fallback: empty paths give empty result", {
  lib := _make_lib(String.from("zlib"), String.new(), String.new(), String.new());
  r := build_fallback(lib);
  assert(r.include_paths.len() == usize(0), "no include paths");
  assert(r.library_paths.len() == usize(0), "no library paths");
  assert(r.link_libraries.len() == usize(0), "no link libraries");
});
test("build_fallback: sets include, library, and link paths", {
  lib := _make_lib(
    String.from("mylib"),
    String.from("/opt/mylib/include"),
    String.from("/opt/mylib/lib"),
    String.from("mylib mylib-extra")
  );
  r := build_fallback(lib);
  assert(r.include_paths.len() == usize(1), "one include path");
  assert(r.library_paths.len() == usize(1), "one library path");
  assert(r.link_libraries.len() == usize(2), "two link libraries");
  ip := match(r.include_paths.get(usize(0)),.None => String.new(),.Some(p) => p);
  assert(ip == "/opt/mylib/include", "correct include path");
});
// ---------------------------------------------------------------------------
// apply_system_library_metadata tests
// ---------------------------------------------------------------------------
test("apply_system_library_metadata: adds defines to result", {
  defines := ArrayList(String).new();
  defines.push(String.from("USE_OPENSSL"));
  defines.push(String.from("OPENSSL_DEPRECATED_ALLOWED"));
  lib := _make_lib_with_defines(String.from("openssl"), defines);
  r := _empty_for_test();
  r2 := apply_system_library_metadata(lib, r);
  assert(r2.defines.len() == usize(2), "two defines added");
  d0 := match(r2.defines.get(usize(0)),.None => String.new(),.Some(p) => p);
  assert(d0 == "USE_OPENSSL", "first define");
});
test("apply_system_library_metadata: empty defines leaves result unchanged", {
  lib := _make_lib(String.from("zlib"), String.new(), String.new(), String.new());
  r := _empty_for_test();
  r2 := apply_system_library_metadata(lib, r);
  assert(r2.defines.len() == usize(0), "no defines added");
});
