  src := "sq := (fn(x : i32) -> i32)({ (x * x) });\narr := ArrayList(i32).new();\narr.push(i32(2));\narr.push(i32(3));\narr.push(i32(4));\nsquared := arr.map(sq);\nacc := i32(0);\nfor(v, squared, { acc = (acc + v); });\nexport(acc);\n";
