// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5p series: higher-order array methods.
///
/// Phases covered:
///   5pa — ArrayList.map() with named and inline functions
///   5pb — ArrayList.filter() on various conditions
///   5pc — ArrayList.fold(), any(), all()
///   5pd — ArrayList.concat(), reverse(), first(), last(), slice()
///   5pe — complex combos: map+filter+fold + structs + impl

open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5pa — ArrayList.map() with named and inline functions
// ---------------------------------------------------------------------------
test("Phase 5pa: map doubles each element via named fn", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "double := (fn(x : i32) -> i32)({ (x * i32(2)) });\narr := ArrayList(i32).new();\narr.push(i32(1));\narr.push(i32(2));\narr.push(i32(3));\nmapped := arr.map(double);\nexport(mapped.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "3", "map len=3"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
