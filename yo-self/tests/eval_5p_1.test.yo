  src := "even := (fn(x : i32) -> bool)({ ((x % i32(2)) == i32(0)) });\nadd := (fn(a : i32, x : i32) -> i32)({ (a + x) });\narr := ArrayList(i32).new();\narr.push(i32(1));\narr.push(i32(2));\narr.push(i32(3));\narr.push(i32(4));\narr.push(i32(5));\nsliced := arr.slice(usize(1), usize(4));\nresult := sliced.filter(even).fold(i32(0), add);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "6", "2+4=6"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5pe: two exports: map len and filter len", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "dbl := (fn(x : i32) -> i32)({ (x * i32(2)) });\neven := (fn(x : i32) -> bool)({ ((x % i32(2)) == i32(0)) });\narr := ArrayList(i32).new();\narr.push(i32(1));\narr.push(i32(2));\narr.push(i32(3));\narr.push(i32(4));\nmapped := arr.map(dbl);\nevens := arr.filter(even);\nexport(mapped.len());\nexport(evens.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "4", "map len=4"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "2", "filter len=2"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5pe: all-in-one: build, map, filter, fold, concat, any", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "add := (fn(a : i32, x : i32) -> i32)({ (a + x) });\ndbl := (fn(x : i32) -> i32)({ (x * i32(2)) });\ngt10 := (fn(x : i32) -> bool)({ (x > i32(10)) });\na := ArrayList(i32).new();\na.push(i32(2));\na.push(i32(4));\nb := ArrayList(i32).new();\nb.push(i32(6));\nb.push(i32(8));\nall := a.concat(b);\ndoubled := all.map(dbl);\nbig := doubled.filter(gt10);\nresult := big.fold(i32(0), add);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "28", "12+16=28"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
