});
test("Phase 5pa: map bool predicate, count true results", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "is_even := (fn(x : i32) -> bool)({ ((x % i32(2)) == i32(0)) });\narr := ArrayList(i32).new();\narr.push(i32(1));\narr.push(i32(2));\narr.push(i32(3));\narr.push(i32(4));\narr.push(i32(5));\nbools := arr.map(is_even);\ncnt := i32(0);\nfor(b, bools, { cond(b => { cnt = (cnt + i32(1)); }, true => ()); });\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "2", "2 evens in 1-5"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
