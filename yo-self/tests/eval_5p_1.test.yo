    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "120", "2*3*4*5=120"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5pc: fold counts elements by adding 1 each time", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "cnt := (fn(acc : i32, x : i32) -> i32)({ (acc + i32(1)) });\narr := ArrayList(i32).new();\narr.push(i32(10));\narr.push(i32(20));\narr.push(i32(30));\nresult := arr.fold(i32(0), cnt);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
