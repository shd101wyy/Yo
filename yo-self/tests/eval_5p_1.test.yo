// Phase 5pb — ArrayList.filter() on various conditions
// ---------------------------------------------------------------------------
test("Phase 5pb: filter keeps evens only", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "is_even := (fn(x : i32) -> bool)({ ((x % i32(2)) == i32(0)) });\narr := ArrayList(i32).new();\narr.push(i32(1));\narr.push(i32(2));\narr.push(i32(3));\narr.push(i32(4));\narr.push(i32(5));\narr.push(i32(6));\nevens := arr.filter(is_even);\nexport(evens.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
