  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "(evens : i32) = i32(0);\n(odds : i32) = i32(0);\n(i : i32) = i32(1);\nwhile(runtime((i <= i32(10))), {\n  cond(((i % i32(2)) == i32(0)) => { evens = (evens + i); }, true => { odds = (odds + i); });\n  i = (i + i32(1));\n});\nexport(evens);\nexport(odds);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
