test("Phase 5ade: contains check on array via any", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(3), i32(7), i32(1), i32(9), i32(5)];\nhas_seven := arr.any((fn(x : i32) -> bool)((x == i32(7))));\nhas_ten := arr.any((fn(x : i32) -> bool)((x == i32(10))));\nexport(has_seven);\nexport(has_ten);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "has 7"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.BoolVal(b) => assert(b == false, "no 10"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
