// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5ad series: advanced cond branching patterns,
/// multi-variable while loops, enum-tagged dispatch, and recursive algorithm
/// patterns with iterative equivalents.
///
/// Phases covered:
///   5ada — Complex cond branching with multiple conditions
///   5adb — Multi-variable while loops (two mutable counters)
///   5adc — Enum-like dispatch via struct tags
///   5add — Classic algorithm patterns (binary search, selection, run-length)
///   5ade — HOF composition chains (map → filter → map → fold)
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5ada — Complex cond branching
// ---------------------------------------------------------------------------
test("Phase 5ada: FizzBuzz count via while — count fizzbuzz hits", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "(i : i32) = i32(1);\n(fb_count : i32) = i32(0);\nwhile(runtime((i <= i32(20))), {\n  is_fizzbuzz := (((i % i32(3)) == i32(0)) && ((i % i32(5)) == i32(0)));\n  cond(is_fizzbuzz => { fb_count = (fb_count + i32(1)); }, true => ());\n  i = (i + i32(1));\n});\nexport(fb_count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "fb=1"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5ada: cond chain — grade classification", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "grades := [i32(95), i32(82), i32(74), i32(61), i32(45)];\na_count := grades.filter((fn(g : i32) -> bool)((g >= i32(90)))).len();\nb_count := grades.filter((fn(g : i32) -> bool)(((g >= i32(80)) && (g < i32(90))))).len();\nfail_count := grades.filter((fn(g : i32) -> bool)((g < i32(60)))).len();\nexport(a_count);\nexport(b_count);\nexport(fail_count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(3), "3 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "1 A"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "1 B"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
        match(
          v.get(usize(2)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "1 fail"), _ => assert(false, "t2")),
          .None => assert(false, "v2")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5ada: nested cond in map", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "nums := [(i32(0) - i32(3)), i32(0), i32(5), (i32(0) - i32(1)), i32(2)];\nsigns := nums.map((fn(x : i32) -> i32)(cond((x > i32(0)) => i32(1), (x < i32(0)) => (i32(0) - i32(1)), true => i32(0))));\npos_count := signs.filter((fn(s : i32) -> bool)((s == i32(1)))).len();\nneg_count := signs.filter((fn(s : i32) -> bool)((s == (i32(0) - i32(1))))).len();\nexport(pos_count);\nexport(neg_count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2 pos"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2 neg"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
// ---------------------------------------------------------------------------
// Phase 5adb — Multi-variable while loops
// ---------------------------------------------------------------------------
test("Phase 5adb: two-pointer approach — count complement pairs", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "(lo : i32) = i32(1);\n(hi : i32) = i32(10);\ntarget := i32(11);\n(count : i32) = i32(0);\nwhile(runtime((lo < hi)), {\n  s := (lo + hi);\n  cond((s == target) => { count = (count + i32(1)); lo = (lo + i32(1)); hi = (hi - i32(1)); }, (s < target) => { lo = (lo + i32(1)); }, true => { hi = (hi - i32(1)); });\n});\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "5 pairs"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
