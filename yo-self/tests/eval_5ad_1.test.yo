test("Phase 5add: linear search — find index of value", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "haystack := [i32(10), i32(20), i32(30), i32(40), i32(50)];\nneedle := i32(30);\npairs := haystack.enumerate();\nfound := pairs.find((fn(p : i32) -> bool)((p.1 == needle)));\nexport(found.is_some());\nexport(found.unwrap().0);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        assert(v.len() == usize(2), "2 exports");
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "found"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "idx=2"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5add: run-length encoding — count consecutive equal values", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "seq := [i32(1), i32(1), i32(2), i32(3), i32(3), i32(3), i32(1)];\n(groups : i32) = i32(1);\n(i : usize) = usize(1);\nwhile(runtime((i < seq.len())), {\n  prev := seq.get((i - usize(1))).unwrap();\n  curr := seq.get(i).unwrap();\n  cond((curr != prev) => { groups = (groups + i32(1)); }, true => ());\n  i = (i + usize(1));\n});\nexport(groups);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "4 groups"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
