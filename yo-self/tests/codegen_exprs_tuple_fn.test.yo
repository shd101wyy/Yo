/// Phase 13au -- codegen anonymous tuple handler tests.
///
/// Exercises `yo-self/codegen/exprs/tuple_fn.yo`, the 1-to-1 port of
/// `src/codegen/exprs/tuple-fn.ts` using the ExprInfo side-table.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr, BK_TUPLE } :: import("../expr.yo");
{ new_expr_info, expr_info_table_new, expr_info_table_set }
:: import("../expr_info.yo");
{ Environment } :: import("../env.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ t_i32, t_bool } :: import("../types/creators.yo");
{ type_to_string } :: import("../types/string.yo");
{ CodegenContext, CodegenTypeEntry } :: import("../codegen/context.yo");
{ set_generate_expr_fn } :: import("../codegen/exprs/expr.yo");
{
  generate_anonymous_tuple,
  format_tuple_compound_literal,
  format_tuple_field_assignment
} :: import("../codegen/exprs/tuple_fn.yo");
{
  get_type_string_opt,
  get_variable_type_string_opt_str
} :: import("../codegen/utils/index.yo");

mk_token :: (fn(value : str, kind : TokenKind) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);

mk_atom :: (fn(id : usize, value : str, kind : TokenKind) -> AstExpr)(
  AstExpr.Atom(id, mk_token(value, kind))
);

mk_tuple_call :: (fn(id : usize, args : ArrayList(AstExpr)) -> AstExpr)(
  AstExpr.FnCall(
    id,
    box(mk_atom(id + usize(1000), BK_TUPLE, TokenKind.Identifier)),
    args,
    false,
    mk_token(BK_TUPLE, TokenKind.Identifier)
  )
);

stub_generate_expr :: (
  fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    expr,
    .Atom(_, tok) => Option(String).Some(tok.value.clone()),
    .FnCall(_, _, _, _, _) => Option(String).Some(String.from("expr"))
  )
);

mk_pair_ty :: (fn() -> TypeValue)({
  labels := ArrayList(String).new();
  labels.push(String.from(""));
  labels.push(String.from(""));
  fields := ArrayList(TypeValue).new();
  fields.push(t_i32());
  fields.push(t_bool());
  TypeValue.Tuple(labels, fields)
});

install_tuple_type :: (fn(ctx : CodegenContext, ty : TypeValue, c_name : str) -> unit)({
  ctx.types.set(
    type_to_string(ty),
    CodegenTypeEntry(type_value : ty, c_name : String.from(c_name))
  );
});

test("get_type_string_opt: reads tuple C name from context types", {
  ctx := CodegenContext.new();
  ty := mk_pair_ty();
  install_tuple_type(ctx, ty, "__yo_tuple_i32_bool");
  match(
    get_type_string_opt(ty, ctx),
    .None => assert(false, "expected tuple c name"),
    .Some(c_name) => assert(c_name == String.from("__yo_tuple_i32_bool"), "tuple c name")
  );
});

test("get_variable_type_string_opt_str: sanitizes tuple-temp variable name", {
  ctx := CodegenContext.new();
  ty := mk_pair_ty();
  install_tuple_type(ctx, ty, "__yo_tuple_i32_bool");
  match(
    get_variable_type_string_opt_str(ty, "tmp.value", ctx),
    .None => assert(false, "expected variable type string"),
    .Some(s) => assert(
      s == String.from("__yo_tuple_i32_bool tmp_u46_value"),
      "sanitized variable name"
    )
  );
});

test("generate_anonymous_tuple: returns None without metadata for non-unit tuple", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(10), "x", TokenKind.Identifier));
  args.push(mk_atom(usize(11), "true", TokenKind.Identifier));
  call := mk_tuple_call(usize(12), args);
  result := generate_anonymous_tuple(call, args, ctx, String.from(""));
  assert(result.is_none(), "no metadata falls back to legacy tuple lowering");
});

test("generate_anonymous_tuple: zero-arg unit tuple returns empty string without metadata", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  call := mk_tuple_call(usize(20), args);
  result := generate_anonymous_tuple(call, args, ctx, String.from(""));
  match(
    result,
    .None => assert(false, "expected unit tuple Some"),
    .Some(code) => assert(code == String.from(""), "unit tuple code")
  );
});

test("generate_anonymous_tuple: emits compound literal from metadata", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  ty := mk_pair_ty();
  install_tuple_type(ctx, ty, "__yo_tuple_i32_bool");
  call_info := new_expr_info(env, ty);
  expr_info_table_set(table, usize(32), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(30), "x", TokenKind.Identifier));
  args.push(mk_atom(usize(31), "true", TokenKind.Identifier));
  call := mk_tuple_call(usize(32), args);
  result := generate_anonymous_tuple(call, args, ctx, String.from("  "));
  match(
    result,
    .None => assert(false, "expected tuple code"),
    .Some(code) => assert(
      code == String.from("(__yo_tuple_i32_bool){ ._0 = x, ._1 = true }"),
      "compound tuple literal"
    )
  );
});

test("generate_anonymous_tuple: runtime arg order overrides source args", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  ty := mk_pair_ty();
  install_tuple_type(ctx, ty, "__yo_tuple_i32_bool");
  call_info := new_expr_info(env, ty);
  runtime_args := ArrayList(AstExpr).new();
  runtime_args.push(mk_atom(usize(40), "y", TokenKind.Identifier));
  runtime_args.push(mk_atom(usize(41), "false", TokenKind.Identifier));
  call_info.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(runtime_args);
  expr_info_table_set(table, usize(42), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  source_args := ArrayList(AstExpr).new();
  source_args.push(mk_atom(usize(43), "x", TokenKind.Identifier));
  source_args.push(mk_atom(usize(44), "true", TokenKind.Identifier));
  call := mk_tuple_call(usize(42), source_args);
  result := generate_anonymous_tuple(call, source_args, ctx, String.from(""));
  match(
    result,
    .None => assert(false, "expected tuple code"),
    .Some(code) => assert(
      code == String.from("(__yo_tuple_i32_bool){ ._0 = y, ._1 = false }"),
      "runtime arg order"
    )
  );
});

test("generate_anonymous_tuple: variable_name emits temp declaration and returns temp", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  ty := mk_pair_ty();
  install_tuple_type(ctx, ty, "__yo_tuple_i32_bool");
  call_info := new_expr_info(env, ty);
  call_info.variable_name = Option(String).Some(String.from("tmp.tuple"));
  expr_info_table_set(table, usize(52), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(50), "x", TokenKind.Identifier));
  args.push(mk_atom(usize(51), "true", TokenKind.Identifier));
  call := mk_tuple_call(usize(52), args);
  result := generate_anonymous_tuple(call, args, ctx, String.from("  "));
  match(
    result,
    .None => assert(false, "expected tuple temp"),
    .Some(code) => assert(code == String.from("tmp_u46_tuple"), "returns sanitized temp")
  );
  out := ctx.emitter.code;
  assert(
    out.contains(String.from("  __yo_tuple_i32_bool tmp_u46_tuple = (__yo_tuple_i32_bool){ ._0 = x, ._1 = true };")),
    "temp declaration emitted"
  );
});

test("generate_anonymous_tuple: missing registered type emits diagnostic comment", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  ty := mk_pair_ty();
  call_info := new_expr_info(env, ty);
  expr_info_table_set(table, usize(62), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(60), "x", TokenKind.Identifier));
  args.push(mk_atom(usize(61), "true", TokenKind.Identifier));
  call := mk_tuple_call(usize(62), args);
  result := generate_anonymous_tuple(call, args, ctx, String.from(""));
  match(
    result,
    .None => assert(false, "expected diagnostic"),
    .Some(code) => assert(code.contains(String.from("tuple type not found")), "diagnostic comment")
  );
});
// ─── pure string formatters ─────────────────────────────────────────────────
test("format_tuple_compound_literal: composes (Type){ <args> }", {
  out := format_tuple_compound_literal(
    String.from("Pair_i32_bool"),
    String.from("._0 = 1, ._1 = true")
  );
  assert(
    out == String.from("(Pair_i32_bool){ ._0 = 1, ._1 = true }"),
    "tuple compound literal"
  );
});
test("format_tuple_compound_literal: empty args list", {
  out := format_tuple_compound_literal(String.from("Unit"), String.from(""));
  assert(out == String.from("(Unit){  }"), "empty payload");
});
test("format_tuple_field_assignment: ._<i> = <value>", {
  out := format_tuple_field_assignment(usize(0), String.from("x"));
  assert(out == String.from("._0 = x"), "index 0");
  out2 := format_tuple_field_assignment(usize(3), String.from("expr"));
  assert(out2 == String.from("._3 = expr"), "index 3");
});
