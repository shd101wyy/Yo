/// Tests for the type-shape predicates in yo-self/types/guards.yo
/// that support metadata-aware codegen handler ports (panic, open,
/// dyn, downcast, drop-dup, ptr-fns, …).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue } :: import("../types/definitions.yo");
{ t_bool, t_i32 } :: import("../types/creators.yo");
{
  is_iso_type,
  is_dyn_type,
  is_object_type,
  is_atomic_object_type,
  is_newtype_type,
  is_str_type,
  is_box_type
} :: import("../types/guards.yo");
mk_struct :: (
  fn(
    name : str,
    field_labels : ArrayList(String),
    is_reference_semantics : bool,
    is_atomic_rc : bool,
    is_newtype : bool
  ) -> TypeValue
)(
  TypeValue.Struct(
    id : String.from(""),
    name : String.from(name),
    field_labels : field_labels,
    field_types : ArrayList(TypeValue).new(),
    is_reference_semantics : is_reference_semantics,
    is_atomic_rc : is_atomic_rc,
    is_newtype : is_newtype,
    constructor_func_id : String.from(""),
    type_arguments : ArrayList(TypeValue).new(),
    is_source_namespace : false
  )
);
empty_labels :: (fn() -> ArrayList(String))(ArrayList(String).new());
box_labels :: (fn() -> ArrayList(String))({
  l := ArrayList(String).new();
  l.push(String.from("*"));
  l
});
test("is_iso_type matches IsoT only", {
  iso_ty := TypeValue.IsoT(box(t_i32()));
  assert(is_iso_type(iso_ty), "IsoT");
  assert(!(is_iso_type(t_i32())), "i32 is not Iso");
  assert(!(is_iso_type(t_bool())), "bool is not Iso");
});
test("is_dyn_type matches DynT only", {
  empty_traits := ArrayList(TypeValue).new();
  empty_levels := ArrayList(usize).new();
  dyn_ty := TypeValue.DynT(empty_traits, empty_levels, empty_traits.clone(), empty_levels.clone());
  assert(is_dyn_type(dyn_ty), "DynT");
  assert(!(is_dyn_type(t_i32())), "i32 is not Dyn");
});
test("is_object_type matches reference-semantics struct only", {
  obj := mk_struct("Counter", empty_labels(), true, false, false);
  val := mk_struct("Point", empty_labels(), false, false, false);
  assert(is_object_type(obj), "object Counter");
  assert(!(is_object_type(val)), "value Point");
  assert(!(is_object_type(t_i32())), "i32 is not an object");
});
test("is_atomic_object_type requires both reference-semantics + atomic_rc", {
  atomic := mk_struct("A", empty_labels(), true, true, false);
  plain_obj := mk_struct("B", empty_labels(), true, false, false);
  value_struct := mk_struct("C", empty_labels(), false, true, false); // is_atomic_rc on value is nonsense but should not match
  assert(is_atomic_object_type(atomic), "atomic object");
  assert(!(is_atomic_object_type(plain_obj)), "non-atomic object");
  assert(!(is_atomic_object_type(value_struct)), "value struct can't be atomic");
});
test("is_newtype_type", {
  nt := mk_struct("MyId", empty_labels(), false, false, true);
  not_nt := mk_struct("Pair", empty_labels(), false, false, false);
  assert(is_newtype_type(nt), "newtype");
  assert(!(is_newtype_type(not_nt)), "plain struct");
});
test("is_str_type matches Struct(name=str, is_newtype=true)", {
  str_ty := mk_struct("str", empty_labels(), false, false, true);
  not_str_name := mk_struct("string", empty_labels(), false, false, true);
  not_str_newtype := mk_struct("str", empty_labels(), false, false, false);
  assert(is_str_type(str_ty), "str newtype");
  assert(!(is_str_type(not_str_name)), "wrong name");
  assert(!(is_str_type(not_str_newtype)), "not a newtype");
});
test("is_box_type matches reference-semantics Struct named Box(T) with single field *", {
  box_ty := mk_struct("Box(i32)", box_labels(), true, false, false);
  assert(is_box_type(box_ty), "Box(i32)");
  // Not a Box because it's a value struct.
  not_box_value := mk_struct("Box(i32)", box_labels(), false, false, false);
  assert(!(is_box_type(not_box_value)), "value struct named Box(...) isn't a Box");
  // Not a Box because name doesn't start with "Box(".
  wrong_name_labels := box_labels();
  not_box_name := mk_struct("Other", wrong_name_labels, true, false, false);
  assert(!(is_box_type(not_box_name)), "wrong name");
  // Not a Box because the field isn't labeled `*`.
  no_star_labels := ArrayList(String).new();
  no_star_labels.push(String.from("inner"));
  not_box_field := mk_struct("Box(i32)", no_star_labels, true, false, false);
  assert(!(is_box_type(not_box_field)), "wrong field label");
});
