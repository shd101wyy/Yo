test("Phase 5byd: max_minus_min + dot_mirror + sum_not_div_3_7 = 8+101+126 = 235", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
