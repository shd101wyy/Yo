test("Phase 5byc: sum n in 1..20 where n not divisible by 3 and not by 7 = 126", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "acc := i32(0);\nn := i32(1);\nwhile((n <= i32(20)), {\nd3 := cond(((n % i32(3)) == i32(0)) => i32(1), true => i32(0));\nd7 := cond(((n % i32(7)) == i32(0)) => i32(1), true => i32(0));\nflag := cond(((d3 + d7) == i32(0)) => i32(1), true => i32(0));\nacc = (acc + (n * flag));\nn = (n + i32(1));\n});\nexport(acc);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "126", "126"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

