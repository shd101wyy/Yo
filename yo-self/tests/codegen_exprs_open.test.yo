/// Phase 13at — codegen open(struct) handler test.
///
/// Exercises `yo-self/codegen/exprs/open.yo` end-to-end with a populated
/// ExprInfoTable.
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr, ast_expr_id } :: import("../expr.yo");
{
  ExprInfo,
  RuntimeDestructuring,
  new_expr_info,
  expr_info_table_new,
  expr_info_table_set
} :: import("../expr_info.yo");
{ Environment } :: import("../env.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ t_i32, t_bool } :: import("../types/creators.yo");
{ EvalValue } :: import("../value.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{ set_generate_expr_fn } :: import("../codegen/exprs/expr.yo");
{
  generate_open,
  format_destructure_field_decl
} :: import("../codegen/exprs/open.yo");
{ get_type_string } :: import("../codegen/utils/index.yo");
mk_atom :: (fn(id : usize, value : str, kind : TokenKind) -> AstExpr)(
  AstExpr.Atom(
    id,
    Token(
      kind : kind,
      value : String.from(value),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from("test"),
      input : String.from("")
    )
  )
);
stub_generate_expr :: (
  fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    expr,
    .Atom(_, tok) => Option(String).Some(tok.value.clone()),
    .FnCall(_, _, _, _, _) => Option(String).Some(String.from("expr"))
  )
);
mk_struct_ty :: (fn(name : str, field_labels : ArrayList(String), field_types : ArrayList(TypeValue)) -> TypeValue)(
  TypeValue.Struct(
    String.from(""),
    String.from(name),
    field_labels,
    field_types,
    false,
    false,
    false
  )
);
test("get_type_string: known primitives → C types (open field path)", {
  ctx := CodegenContext.new();
  assert(get_type_string(t_i32(), ctx) == String.from("int32_t"), "i32");
  assert(get_type_string(t_bool(), ctx) == String.from("bool"), "bool");
});
test("get_type_string: unknown unregistered type → int32_t fallback", {
  fl := ArrayList(String).new();
  ft := ArrayList(TypeValue).new();
  struct_ty := mk_struct_ty("Unknown", fl, ft);
  ctx := CodegenContext.new();
  // Struct types are not in type_value_to_c_field's primitive set and
  // the ctx.types registry is empty → canonical int32_t fallback.
  assert(get_type_string(struct_ty, ctx) == String.from("int32_t"), "fallback");
});
test("generate_open: returns None when call has no metadata", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(70), "p", TokenKind.Identifier));
  call := AstExpr.FnCall(
    usize(71),
    box(mk_atom(usize(72), "open", TokenKind.Identifier)),
    args,
    false,
    Token(
      kind : TokenKind.Identifier,
      value : String.from("open"),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from("test"),
      input : String.from("")
    )
  );
  result := generate_open(call, args, ctx, String.from(""));
  assert(result.is_none(), "no metadata → None");
});
test("generate_open: emits one decl per runtime_destructuring", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  // Build call_info with two runtime destructurings (x, y).
  call_info := new_expr_info(env, t_bool());
  destructurings := ArrayList(RuntimeDestructuring).new();
  destructurings.push(
    RuntimeDestructuring(
      label : String.from("x"),
      ty : t_i32(),
      variable_name : String.from("x")
    )
  );
  destructurings.push(
    RuntimeDestructuring(
      label : String.from("y"),
      ty : t_i32(),
      variable_name : String.from("y")
    )
  );
  call_info.runtime_destructurings = Option(ArrayList(RuntimeDestructuring)).Some(destructurings);
  expr_info_table_set(table, usize(81), call_info);
  // Argument: identifier `p` whose info has type `Struct(Point, ...)` and
  // no compile-time value (runtime struct).
  field_labels := ArrayList(String).new();
  field_labels.push(String.from("x"));
  field_labels.push(String.from("y"));
  field_types := ArrayList(TypeValue).new();
  field_types.push(t_i32());
  field_types.push(t_i32());
  arg_info := new_expr_info(env, mk_struct_ty("Point", field_labels, field_types));
  expr_info_table_set(table, usize(80), arg_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(80), "p", TokenKind.Identifier));
  call := AstExpr.FnCall(
    usize(81),
    box(mk_atom(usize(82), "open", TokenKind.Identifier)),
    args,
    false,
    Token(
      kind : TokenKind.Identifier,
      value : String.from("open"),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from("test"),
      input : String.from("")
    )
  );
  result := generate_open(call, args, ctx, String.from("  "));
  assert(result.is_some(), "open with destructurings returns Some");
  match(
    result,
    .Some(c_expr) => assert(c_expr == String.from(""), "open returns empty expression"),
    .None => ()
  );
  code := ctx.emitter.code;
  assert(code.contains(String.from("int32_t x = p.x;")), "first decl emitted");
  assert(code.contains(String.from("int32_t y = p.y;")), "second decl emitted");
});
test("generate_open: skips emission when arg has compile-time value", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  call_info := new_expr_info(env, t_bool());
  destructurings := ArrayList(RuntimeDestructuring).new();
  destructurings.push(
    RuntimeDestructuring(
      label : String.from("x"),
      ty : t_i32(),
      variable_name : String.from("x")
    )
  );
  call_info.runtime_destructurings = Option(ArrayList(RuntimeDestructuring)).Some(destructurings);
  expr_info_table_set(table, usize(91), call_info);
  // Arg has compile-time value → handler skips emission.
  field_labels := ArrayList(String).new();
  field_labels.push(String.from("x"));
  field_types := ArrayList(TypeValue).new();
  field_types.push(t_i32());
  arg_info := new_expr_info(env, mk_struct_ty("P", field_labels, field_types));
  arg_info.value = Option(EvalValue).Some(EvalValue.IntLit(String.from("0")));
  expr_info_table_set(table, usize(90), arg_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(90), "p", TokenKind.Identifier));
  call := AstExpr.FnCall(
    usize(91),
    box(mk_atom(usize(92), "open", TokenKind.Identifier)),
    args,
    false,
    Token(
      kind : TokenKind.Identifier,
      value : String.from("open"),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from("test"),
      input : String.from("")
    )
  );
  result := generate_open(call, args, ctx, String.from(""));
  assert(result.is_some(), "Some result even when skipped");
  code := ctx.emitter.code;
  assert(!(code.contains(String.from("int32_t x ="))), "no decl emitted for comptime value");
});
test("format_destructure_field_decl: composes indented decl with field access", {
  out := format_destructure_field_decl(
    String.from("  "),
    String.from("int32_t"),
    String.from("x"),
    String.from("s"),
    String.from("x")
  );
  assert(
    out == String.from("  int32_t x = s.x;"),
    "destructure field decl shape"
  );
});
test("format_destructure_field_decl: works without indent", {
  out := format_destructure_field_decl(
    String.from(""),
    String.from("bool"),
    String.from("flag"),
    String.from("opt"),
    String.from("present")
  );
  assert(out == String.from("bool flag = opt.present;"), "no indent");
});
