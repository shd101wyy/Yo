test("Phase 5bic: compose double then filter divisible by 3 then fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1..8] → doubled=[2,4,6,8,10,12,14,16] → filter %3==0: [6,12] → sum=18
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8)];\ndoubled := arr.map((fn(x : i32) -> i32)((x * i32(2))));\ndiv3 := doubled.filter((fn(x : i32) -> bool)(((x % i32(3)) == i32(0))));\ntotal := div3.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "18", "18"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bic: apply two separate maps then zip products", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,2,3,4] → sq=[1,4,9,16], cubes=[1,8,27,64]
  // zip+product: sq[0]*cubes[0]=1, sq[1]*cubes[1]=32, sq[2]*cubes[2]=243, sq[3]*cubes[3]=1024
  // Hmm large numbers. Let's use smaller: [1,2,3] → sq=[1,4,9], cubes=[1,8,27]
  // products=[1,32,243] → sum=276
  src := "arr := [i32(1), i32(2), i32(3)];\nsq := arr.map((fn(x : i32) -> i32)((x * x)));\ncb := arr.map((fn(x : i32) -> i32)({\ns := (x * x);\n(s * x)\n}));\npairs := sq.zip(cb);\nproducts := pairs.map((fn(p : (i32, i32)) -> i32)((p.0 * p.1)));\ntotal := products.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "276", "276"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bic: filter-map-fold chain with multiple conditions", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1..10] → filter divisible by 2 or 5 → [2,4,5,6,8,10] → square → sum
  // [4,16,25,36,64,100] → sum=245
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8), i32(9), i32(10)];\nfiltered := arr.filter((fn(x : i32) -> bool)({\ncond(((x % i32(2)) == i32(0)) => true, ((x % i32(5)) == i32(0)) => true, true => false)\n}));\nsquared := filtered.map((fn(x : i32) -> i32)((x * x)));\ntotal := squared.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "245", "245"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
