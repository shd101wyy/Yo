});
// ---------------------------------------------------------------------------
// Phase 5bid — string + number grand combos
// ---------------------------------------------------------------------------
test("Phase 5bid: string count + arithmetic grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // strings=["go","rust","python","c"] → count strings with len > 3: rust(4),python(6) → 2
  // numbers=[1..5] → sum=15
  // result = count * sum = 2 * 15 = 30
  src := "words := [\"go\", \"rust\", \"python\", \"c\"];\nlong_count := words.fold(i32(0), (fn(acc : i32, w : str) -> i32)({\ncond((w.len() > i32(3)) => (acc + i32(1)), true => acc)\n}));\nnums := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nnum_sum := nums.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nresult := (long_count * num_sum);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "30", "30"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bid: while + HOF grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // while sum of 1..10 = 55
  // HOF: [1..5] squared and summed = 1+4+9+16+25=55
  // grand result = (while_sum * hof_sum) / 55 = 55*55/55 = 55
  src := "i := i32(1);\nwhile_sum := i32(0);\nwhile((i <= i32(10)), {\nwhile_sum = (while_sum + i);\ni = (i + i32(1));\n});\narr := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nhof_sum := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + (x * x))));\nresult := (while_sum + hof_sum);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "110", "110"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bid: multi-array comparison grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[1,2,3,4,5], b=[5,4,3,2,1]
  // sum_a=15, sum_b=15, prod_a=1*2*3*4*5=120, prod_b=5*4*3*2*1=120
  // zip count where a[i] > b[i]: only positions 3,4 (4>2,5>1) → count=2
  src := "a := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nb := [i32(5), i32(4), i32(3), i32(2), i32(1)];\npairs := a.zip(b);\ncount := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)({\ncond((p.0 > p.1) => (acc + i32(1)), true => acc)\n}));\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
