test("Phase 5bie: cumulative product of odds", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1..10] → filter odd=[1,3,5,7,9] → product=945
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8), i32(9), i32(10)];\nodds := arr.filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(1))));\nprod := odds.fold(i32(1), (fn(acc : i32, x : i32) -> i32)((acc * x)));\nexport(prod);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "945", "945"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bie: zip-diff then count positives", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[5,3,8,2,9], b=[4,6,7,1,10] → diffs=[1,-3,1,1,-1] → count positive=3
  src := "a := [i32(5), i32(3), i32(8), i32(2), i32(9)];\nb := [i32(4), i32(6), i32(7), i32(1), i32(10)];\npairs := a.zip(b);\ndiffs := pairs.map((fn(p : (i32, i32)) -> i32)((p.0 - p.1)));\ncount := diffs.fold(i32(0), (fn(acc : i32, d : i32) -> i32)({\ncond((d > i32(0)) => (acc + i32(1)), true => acc)\n}));\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bie: while + array fold sum grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // while: sum of [1..6]=21; array fold: [7,8,9,10] sum=34; grand=21+34=55
  src := "i := i32(1);\nloop_sum := i32(0);\nwhile((i <= i32(6)), {\nloop_sum = (loop_sum + i);\ni = (i + i32(1));\n});\narr := [i32(7), i32(8), i32(9), i32(10)];\narr_sum := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\ntotal := (loop_sum + arr_sum);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "55", "55"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bie: count elements where square exceeds 2x", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,2,3,4,5]: x*x > 2*x? 1>2✗,4>4✗,9>6✓,16>8✓,25>10✓ → count=3
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5)];\ncount := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)({\nsq := (x * x);\nthresh := (x * i32(2));\ncond((sq > thresh) => (acc + i32(1)), true => acc)\n}));\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
