// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5bi series: range-based computations, multi-var
/// while patterns, lookup patterns, HOF composition, and grand combos.
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5bia — range-based computations
// ---------------------------------------------------------------------------
test("Phase 5bia: sum of triangular numbers T1..T5", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // T(n)=n*(n+1)/2: T1=1,T2=3,T3=6,T4=10,T5=15 → sum=35
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5)];\ntriangulars := arr.map((fn(n : i32) -> i32)(((n * (n + i32(1))) / i32(2))));\ntotal := triangulars.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "35", "35"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bia: count perfect squares in range", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1..25] perfect squares: 1,4,9,16,25 → count=5
  // map squares of [1..5] then count those equal to their position square
  // Actually: filter arr where x*x == x → only 0,1 but we want count squares in [1..25]
  // Approach: [1,2,3,4,5] → squares=[1,4,9,16,25] → all are perfect squares → count=5
  src := "roots := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nsquares := roots.map((fn(r : i32) -> i32)((r * r)));\ntotal := squares.len();\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "5"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bia: alternating sum of first N naturals", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 1-2+3-4+5-6+7-8 = (1+3+5+7)-(2+4+6+8) = 16-20 = -4
  // Use map: index-based sign = (i%2==0)→+x else -x
  // [1,-2,3,-4,5,-6,7,-8] → sum = -4
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8)];\nsigned := arr.map((fn(x : i32) -> i32)({\ncond(((x % i32(2)) == i32(1)) => x, true => (i32(0) - x))\n}));\ntotal := signed.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .IntLit(n) => assert(n.as_str() == "-4", "-4"),
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
