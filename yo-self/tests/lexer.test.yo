test("Double-quoted string literal", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(lex_or_panic(`"hello"`, exn));
  assert(toks.len() == usize(1), "expected 1 token");
  match(
    toks.get(usize(0)),
    .None => assert(false, "no token"),
    .Some(tok) => {
