test("All bracket kinds", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(lex_or_panic(`()[]{}`, exn));
  assert(toks.len() == usize(6), "expected 6 tokens");
  match(toks.get(usize(0)),.None => assert(false, "0"),.Some(tok) => assert(tok.kind == TokenKind.LParen, "0: LParen"));
  match(toks.get(usize(1)),.None => assert(false, "1"),.Some(tok) => assert(tok.kind == TokenKind.RParen, "1: RParen"));
  match(toks.get(usize(2)),.None => assert(false, "2"),.Some(tok) => assert(tok.kind == TokenKind.LBracket, "2: LBracket"));
  match(toks.get(usize(3)),.None => assert(false, "3"),.Some(tok) => assert(tok.kind == TokenKind.RBracket, "3: RBracket"));
  match(toks.get(usize(4)),.None => assert(false, "4"),.Some(tok) => assert(tok.kind == TokenKind.LCurlyBracket, "4: LCurlyBracket"));
  match(toks.get(usize(5)),.None => assert(false, "5"),.Some(tok) => assert(tok.kind == TokenKind.RCurlyBracket, "5: RCurlyBracket"));
});
test("Comma and semicolon", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(lex_or_panic(`,;`, exn));
  assert(toks.len() == usize(2), "expected 2 tokens");
  match(toks.get(usize(0)),.None => assert(false, "0"),.Some(tok) => assert(tok.kind == TokenKind.Comma, "0: Comma"));
  match(toks.get(usize(1)),.None => assert(false, "1"),.Some(tok) => assert(tok.kind == TokenKind.Semicolon, "1: Semicolon"));
});
