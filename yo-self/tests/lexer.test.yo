// ─── Row and column tracking ─────────────────────────────────────────────────
test("Token row tracking across newlines", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  sb := StringBuilder.new();
  sb.write_str("hello");
  sb.write_byte(u8(10));
  sb.write_str("world");
  src := sb.to_string();
  toks := non_ws(tokenize(src, `test.yo`, exn));
  assert(toks.len() == usize(2), "expected 2 tokens");
  match(
    toks.get(usize(0)),
    .None => assert(false, "no token 0"),
    .Some(tok) => {
      assert(tok.row == usize(0), "hello is on row 0");
      assert(tok.column == usize(0), "hello starts at col 0");
    }
  );
  match(
    toks.get(usize(1)),
    .None => assert(false, "no token 1"),
    .Some(tok) => {
      assert(tok.row == usize(1), "world is on row 1");
      assert(tok.column == usize(0), "world starts at col 0");
    }
  );
});
test("Column offset within a line", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(tokenize(`abc def`, `test.yo`, exn));
  assert(toks.len() == usize(2), "expected 2 tokens");
  match(
    toks.get(usize(0)),
    .None => assert(false, "no token 0"),
    .Some(tok) => assert(tok.column == usize(0), "abc at column 0")
  );
  match(
    toks.get(usize(1)),
    .None => assert(false, "no token 1"),
    .Some(tok) => assert(tok.column == usize(4), "def at column 4")
  );
});
// ─── find_matching_bracket ───────────────────────────────────────────────────
test("find_matching_bracket basic paren", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(tokenize(`(a, b)`, `test.yo`, exn));
  // indices: 0=(  1=a  2=,  3=b  4=)
  result := find_matching_bracket(toks, usize(0));
  match(
    result,
    .None => assert(false, "should find matching paren"),
    .Some(idx) => assert(idx == usize(4), "closing paren at index 4")
  );
});
test("find_matching_bracket nested parens", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(tokenize(`((a))`, `test.yo`, exn));
  // 0=(  1=(  2=a  3=)  4=)
  result := find_matching_bracket(toks, usize(0));
  match(
    result,
    .None => assert(false, "should find outer closing paren"),
    .Some(idx) => assert(idx == usize(4), "outer closing paren at index 4")
  );
});
test("find_matching_bracket curly", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(tokenize(`{x}`, `test.yo`, exn));
  result := find_matching_bracket(toks, usize(0));
  match(
    result,
    .None => assert(false, "should find closing curly"),
    .Some(idx) => assert(idx == usize(2), "closing curly at index 2")
  );
});
test("find_matching_bracket returns None for non-bracket", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(tokenize(`hello`, `test.yo`, exn));
  result := find_matching_bracket(toks, usize(0));
  assert(result ==.None, "identifier has no matching bracket");
});
// ─── Error handling ───────────────────────────────────────────────────────────
test("Unterminated string literal raises LexerError", {
  exn := Exception(
    throw : (
      (err) -> {
        match(
          downcast(err, LexerError),
          .Some(le) => assert(le.message == `unterminated string literal`, "wrong error message"),
          .None => assert(false, "expected LexerError")
        );
        unwind(());
      }
    )
  );
  tokenize(`"unterminated`, `test.yo`, exn);
  assert(false, "expected a lexer error to be raised");
});
test("Unterminated block comment raises LexerError", {
  exn := Exception(
    throw : (
      (err) -> {
        match(
          downcast(err, LexerError),
          .Some(le) => assert(le.message == `unterminated block comment`, "wrong error message"),
          .None => assert(false, "expected LexerError")
        );
        unwind(());
      }
    )
  );
  tokenize(`/* unterminated`, `test.yo`, exn);
  assert(false, "expected a lexer error to be raised");
});
test("Unterminated template string raises LexerError", {
  exn := Exception(
    throw : (
      (err) -> {
        match(
          downcast(err, LexerError),
          .Some(le) => assert(le.message == `unterminated template string`, "wrong error message"),
          .None => assert(false, "expected LexerError")
        );
        unwind(());
      }
    )
  );
  sb := StringBuilder.new();
  sb.write_byte(u8(0x60));
  sb.write_str("unterminated");
  src := sb.to_string();
  tokenize(src, `test.yo`, exn);
  assert(false, "expected a lexer error to be raised");
});
