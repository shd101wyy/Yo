    .None => assert(false, "no token at 0"),
    .Some(tok) => {
      assert(tok.kind == TokenKind.Identifier, "expected Identifier");
      assert(tok.value == `my_var_2`, "value must be 'my_var_2'");
    }
  );
});
test("Bool literals true and false", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  toks := non_ws(lex_or_panic(`true false`, exn));
  assert(toks.len() == usize(2), "expected 2 tokens");
  match(
    toks.get(usize(0)),
    .None => assert(false, "no token at 0"),
    .Some(tok) => {
      assert(tok.kind == TokenKind.Bool, "expected Bool");
      assert(tok.value == `true`, "value must be 'true'");
    }
  );
  match(
    toks.get(usize(1)),
    .None => assert(false, "no token at 1"),
    .Some(tok) => {
      assert(tok.kind == TokenKind.Bool, "expected Bool");
      assert(tok.value == `false`, "value must be 'false'");
    }
  );
});
