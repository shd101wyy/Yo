});
test("Template string content", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  sb := StringBuilder.new();
  sb.write_byte(u8(0x60));
  sb.write_str("hello");
  sb.write_byte(u8(0x60));
  src := sb.to_string();
  toks := non_ws(lex_or_panic(src, exn));
  assert(toks.len() == usize(1), "expected 1 token");
  match(
    toks.get(usize(0)),
    .None => assert(false, "no token"),
    .Some(tok) => {
      assert(tok.kind == TokenKind.TemplateString, "expected TemplateString");
      assert(tok.value == `hello`, "template string value must be 'hello'");
    }
  );
});
