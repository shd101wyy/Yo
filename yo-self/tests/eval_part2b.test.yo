test "Phase 5dz: array filter then fold product", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6)]; evens := arr.filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(0)))); r := evens.fold(i32(1), (fn(acc : i32, x : i32) -> i32)((acc * x))); export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
