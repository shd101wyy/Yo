  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(_, vals) => {
        match(vals.get(usize(0)),
          .Some(v) => match(v, .BoolVal(b) => assert(b, "starts hello"), _ => assert(false, "not bool")),
          .None => assert(false, "no val 0")
        );
        match(vals.get(usize(1)),
          .Some(v) => match(v, .BoolVal(b) => assert(b, "ends world"), _ => assert(false, "not bool")),
          .None => assert(false, "no val 1")
        );
        match(vals.get(usize(2)),
          .Some(v) => match(v, .BoolVal(b) => assert(!(b), "not starts world"), _ => assert(false, "not bool")),
          .None => assert(false, "no val 2")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

