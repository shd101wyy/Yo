/// Tests for yo-self/codegen/exprs/downcast.yo (partial port —
/// non-boxed-object leaf path).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue, t_i32, t_bool, t_ptr } :: import("../types/type.yo");
{ type_to_string } :: import("../types/string.yo");
{ CodegenContext, CodegenTypeEntry } :: import("../codegen/context.yo");
{
  generate_downcast_for_resolved_types,
  format_box_extract,
  format_typed_incr_rc_cast,
  format_dyn_typeid_check,
  format_ternary_expr,
  format_option_some_construction,
  format_option_none_construction
} :: import("../codegen/exprs/downcast.yo");
mk_struct :: (
  fn(
    name : str,
    is_reference_semantics : bool,
    is_atomic_rc : bool
  ) -> TypeValue
)(
  TypeValue.Struct(
    String.from(""),
    String.from(name),
    ArrayList(String).new(),
    ArrayList(TypeValue).new(),
    is_reference_semantics,
    is_atomic_rc,
    false
  )
);
mk_dyn :: (fn() -> TypeValue)({
  empty_traits := ArrayList(TypeValue).new();
  empty_levels := ArrayList(usize).new();
  TypeValue.DynT(empty_traits, empty_levels, empty_traits.clone(), empty_levels.clone())
});
/// Build a 2-variant Option-like enum where the Some variant carries
/// the given payload type.
mk_option :: (fn(payload : TypeValue) -> TypeValue)({
  none_fields := ArrayList(TypeValue).new();
  some_fields := ArrayList(TypeValue).new();
  some_fields.push(payload);
  variants := ArrayList(ArrayList(TypeValue)).new();
  variants.push(none_fields);
  variants.push(some_fields);
  variant_names := ArrayList(String).new();
  variant_names.push(String.from("None"));
  variant_names.push(String.from("Some"));
  variant_field_labels := ArrayList(ArrayList(String)).new();
  variant_field_labels.push(ArrayList(String).new());
  variant_field_labels.push(ArrayList(String).new());
  variant_discriminants := ArrayList(i64).new();
  variant_discriminants.push(i64(0));
  variant_discriminants.push(i64(1));
  TypeValue.EnumT(
    String.from(""),
    String.from("Option"),
    variant_names,
    variants,
    Option(String).None,
    variant_field_labels,
    variant_discriminants
  )
});
install_type :: (
  fn(ctx : *(CodegenContext), ty : TypeValue, c_name : str) -> unit
)({
  entry := CodegenTypeEntry(type_value : ty, c_name : String.from(c_name));
  _ := ctx.*.types.set(type_to_string(ty), entry);
});
test("downcast: non-Dyn source returns None", {
  ctx := CodegenContext.new();
  obj := mk_struct("Counter", true, false);
  opt := mk_option(obj);
  out := generate_downcast_for_resolved_types(
    String.from("d"),
    t_i32(),
    // not Dyn
    obj,
    opt,
    &(ctx)
  );
  assert(out.is_none(), "i32 is not Dyn → None");
});
test("downcast: non-object target returns None", {
  ctx := CodegenContext.new();
  out := generate_downcast_for_resolved_types(
    String.from("d"),
    mk_dyn(),
    t_i32(),
    // not an object
    mk_option(t_i32()),
    &(ctx)
  );
  assert(out.is_none(), "i32 target → None");
});
test("downcast: nullable-pointer Option(*T) emits ternary with NULL", {
  ctx := CodegenContext.new();
  obj := mk_struct("Counter", true, false);
  install_type(&(ctx), obj, "yo_counter");
  // The TS canonical canOptimizeAsNullablePointer wants `Some(*T)`,
  // so the Some payload is a pointer.
  opt_ptr := mk_option(t_ptr(t_i32()));
  install_type(&(ctx), opt_ptr, "yo_option_ptr");
  out := generate_downcast_for_resolved_types(
    String.from("d"),
    mk_dyn(),
    obj,
    opt_ptr,
    &(ctx)
  );
  match(
    out,
    .Some(s) => {
      assert(s.contains(String.from("? ((yo_counter)__yo_incr_rc((void*)d.data)) : NULL)")), "nullable ternary cast + NULL");
      assert(s.contains(String.from(".vtable->__yo_type_id == (uintptr_t)&__yo_typeid_")), "typeid check");
    },
    .None => assert(false, "expected Some")
  );
});
test("downcast: non-nullable Option(T) emits tagged-union construction", {
  ctx := CodegenContext.new();
  obj := mk_struct("Counter", true, false);
  install_type(&(ctx), obj, "yo_counter");
  // Option(i32) — payload is a value type, so no nullable opt.
  opt_val := mk_option(t_i32());
  install_type(&(ctx), opt_val, "yo_option_i32");
  out := generate_downcast_for_resolved_types(
    String.from("d"),
    mk_dyn(),
    obj,
    opt_val,
    &(ctx)
  );
  match(
    out,
    .Some(s) => {
      // Some branch: assignment to .value with the cast.
      assert(s.contains(String.from(".tag = YO_OPTION_I32_SOME")), "Some tag");
      assert(s.contains(String.from(".Some = { .value = ((yo_counter)__yo_incr_rc((void*)d.data)) }")), "Some payload + cast");
      // None branch: just the tag.
      assert(s.contains(String.from(".tag = YO_OPTION_I32_NONE }")), "None tag");
    },
    .None => assert(false, "expected Some")
  );
});
test("downcast: typeid static is registered on the codegen context", {
  ctx := CodegenContext.new();
  obj := mk_struct("Counter", true, false);
  install_type(&(ctx), obj, "yo_counter");
  opt := mk_option(t_ptr(t_i32()));
  install_type(&(ctx), opt, "yo_option_ptr");
  // First call must register the static; second call must reuse it
  // (typeid_statics is keyed by type_to_string).
  _ := generate_downcast_for_resolved_types(
    String.from("d"),
    mk_dyn(),
    obj,
    opt,
    &(ctx)
  );
  // Verify a typeid entry was registered for Counter.
  key := type_to_string(obj);
  match(
    ctx.type_id_statics.get(key),
    .None => assert(false, "expected typeid_statics entry"),
    .Some(name) => {
      assert(name.starts_with(String.from("__yo_typeid_")), "static name prefix");
    }
  );
});
test("downcast: missing Some/None variant tags return None", {
  ctx := CodegenContext.new();
  obj := mk_struct("Counter", true, false);
  install_type(&(ctx), obj, "yo_counter");
  // Construct an enum *without* registering it — get_enum_variant_c_name
  // will return .None, propagating to the result.
  opt_val := mk_option(t_i32());
  // No install_type for opt_val.
  out := generate_downcast_for_resolved_types(
    String.from("d"),
    mk_dyn(),
    obj,
    opt_val,
    &(ctx)
  );
  assert(out.is_none(), "unregistered option enum → None");
});
// ─── pure formatters ────────────────────────────────────────────────────────
test("format_box_extract: typedef cast + .data + field access", {
  out := format_box_extract(
    String.from("__yo_box_String"),
    String.from("dv"),
    String.from("value")
  );
  assert(
    out == String.from("((__yo_box_String*)dv.data)->value"),
    "box extract shape"
  );
});
test("format_typed_incr_rc_cast: non-atomic dup-and-cast", {
  // Non-atomic variant: `((<target>)__yo_incr_rc((void*)<inner>))`.
  out := format_typed_incr_rc_cast(
    String.from("Counter"),
    String.from("dv.data"),
    false
  );
  assert(
    out == String.from("((Counter)__yo_incr_rc((void*)dv.data))"),
    "non-atomic shape"
  );
});
test("format_typed_incr_rc_cast: atomic variant", {
  // Atomic variant uses `__yo_incr_rc_atomic`. Same outer wrap shape.
  out := format_typed_incr_rc_cast(
    String.from("AtomicCounter"),
    String.from("dv.data"),
    true
  );
  assert(
    out == String.from("((AtomicCounter)__yo_incr_rc_atomic((void*)dv.data))"),
    "atomic shape"
  );
});
// ─── pure string formatters ─────────────────────────────────────────────────
test("format_dyn_typeid_check: composes typeid equality check", {
  out := format_dyn_typeid_check(
    String.from("dyn_v"),
    String.from("__yo_typeid_Counter")
  );
  assert(
    out == String.from("dyn_v.vtable->__yo_type_id == (uintptr_t)&__yo_typeid_Counter"),
    "typeid check shape"
  );
});
test("format_ternary_expr: composes `((<c>) ? <t> : <e>)`", {
  out := format_ternary_expr(
    String.from("x > 0"),
    String.from("yes"),
    String.from("no")
  );
  assert(out == String.from("((x > 0) ? yes : no)"), "ternary shape");
});
test("format_option_some_construction: composes Some compound literal", {
  out := format_option_some_construction(
    String.from("Option_Counter"),
    String.from("Option_Counter_Some"),
    String.from("cv")
  );
  assert(
    out ==
      String.from(
        "(Option_Counter){ .tag = Option_Counter_Some, .data = { .Some = { .value = cv } } }"
      ),
    "Some construction shape"
  );
});
test("format_option_none_construction: composes None compound literal", {
  out := format_option_none_construction(
    String.from("Option_Counter"),
    String.from("Option_Counter_None")
  );
  assert(
    out == String.from("(Option_Counter){ .tag = Option_Counter_None }"),
    "None construction shape"
  );
});
