// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5ba series: Result.Ok/Err patterns, binary
/// search via while, string fold join, mixed cond selection, and HOF pipelines.
///
/// Phases covered:
///   5baa — Result.Ok / Result.Err construction and match
///   5bab — Binary-search-style while loops
///   5bac — String building via fold (custom separator join)
///   5bad — Mixed cond selection and classification
///   5bae — Grand combos: HOF pipelines, compose chains
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5baa — Option patterns (is_some, is_none, unwrap_or)
// ---------------------------------------------------------------------------
test("Phase 5baa: Option.Some wraps a value and is_some returns true", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "r := Option(i32).Some(i32(42));\nexport(r.is_some());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "true"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

