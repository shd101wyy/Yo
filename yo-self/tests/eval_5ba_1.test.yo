// ---------------------------------------------------------------------------
// Phase 5bae — Grand combos: HOF pipelines, compose chains
// ---------------------------------------------------------------------------
test("Phase 5bae: double then square via two-step map pipeline", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,2,3] → double [2,4,6] → square [4,16,36] → sum = 56
  src := "nums := [i32(1), i32(2), i32(3)];\ndoubled := nums.map((fn(x : i32) -> i32)((x * i32(2))));\nsquared := doubled.map((fn(x : i32) -> i32)((x * x)));\nexport(squared.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x))));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "56", "56"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bae: filter then map then fold: sum of squares of evens in 1..5", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,2,3,4,5] evens=[2,4] squares=[4,16] sum=20
  src := "nums := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nevens := nums.filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(0))));\nsquares := evens.map((fn(x : i32) -> i32)((x * x)));\nexport(squares.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x))));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "20", "20"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bae: zip two arrays and compute dot product", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,2,3] · [4,5,6] = 4+10+18 = 32
  src := "a := [i32(1), i32(2), i32(3)];\nb := [i32(4), i32(5), i32(6)];\ndot := a.zip(b).fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)((acc + (p.0 * p.1))));\nexport(dot);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "32", "32"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

