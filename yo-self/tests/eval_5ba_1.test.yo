// ---------------------------------------------------------------------------
// Phase 5bab — Binary-search-style while loops
// ---------------------------------------------------------------------------
test("Phase 5bab: while loop counting multiples of 7 below 50", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // multiples of 7 below 50: 7,14,21,28,35,42,49 → 7 multiples
  src := "(n : i32) = i32(1);\n(count : i32) = i32(0);\nwhile((n < i32(50)), {\nif(((n % i32(7)) == i32(0)), {\ncount = (count + i32(1));\n});\nn = (n + i32(1));\n});\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "7", "7"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bab: sum digits of a number via while loop (digits of 1234 sum to 10)", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 1234: 1+2+3+4 = 10
  src := "(n : i32) = i32(1234);\n(sum : i32) = i32(0);\nwhile((n > i32(0)), {\nsum = (sum + (n % i32(10)));\nn = (n / i32(10));\n});\nexport(sum);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "10", "10"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bab: power of 2 via while: 2^7 = 128", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "(result : i32) = i32(1);\n(i : i32) = i32(0);\nwhile((i < i32(7)), {\nresult = (result * i32(2));\ni = (i + i32(1));\n});\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
