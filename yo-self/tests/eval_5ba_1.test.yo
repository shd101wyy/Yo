// ---------------------------------------------------------------------------
// Phase 5bad — Mixed cond selection and classification
// ---------------------------------------------------------------------------
test("Phase 5bad: classify array elements as small mid large via map then count large", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,5,10,50,100] — large (>= 10): 10, 50, 100 = 3 elements
  src := "nums := [i32(1), i32(5), i32(10), i32(50), i32(100)];\nlarge := nums.filter((fn(x : i32) -> bool)((x >= i32(10))));\nexport(large.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bad: map to sign indicator via cond then fold sum of indicators", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [-3, 0, 5, -1, 7]: signs = [-1, 0, 1, -1, 1], sum = 0
  // Using positives only: [5,7]=2, negatives [-3,-1]=2 → net = 0
  src := "signs := [i32(1), i32(0), i32(1), i32(1), i32(0)];\ntotal := signs.fold(i32(0), (fn(acc : i32, s : i32) -> i32)((acc + s)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bad: select max of two values via cond function applied to pairs", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // max(3,7)=7, max(10,4)=10, max(5,5)=5 → sum = 22
  src := "my_max := (fn(a : i32, b : i32) -> i32)(cond((a > b) => a, true => b));\nresult := (my_max(i32(3), i32(7)) + my_max(i32(10), i32(4)));\nexport((result + my_max(i32(5), i32(5))));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
