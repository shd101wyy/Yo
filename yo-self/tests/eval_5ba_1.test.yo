          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bab: Collatz steps from 6 to 1 takes 8 steps", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 6 → 3 → 10 → 5 → 16 → 8 → 4 → 2 → 1 (8 steps)
  src := "(n : i32) = i32(6);\n(steps : i32) = i32(0);\nwhile((n != i32(1)), {\nn = cond(((n % i32(2)) == i32(0)) => (n / i32(2)), true => ((n * i32(3)) + i32(1)));\nsteps = (steps + i32(1));\n});\nexport(steps);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "8", "8"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5bac — Fold-based reduction patterns
// ---------------------------------------------------------------------------
test("Phase 5bac: fold booleans with OR to check if any is true", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [false, true, false] → any true → true
  src := "flags := [false, true, false];\nany_true := flags.fold(false, (fn(acc : bool, x : bool) -> bool)((acc || x)));\nexport(any_true);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "true"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bac: fold to find running maximum of array", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [3, 1, 4, 1, 5, 9, 2] → max = 9
  src := "nums := [i32(3), i32(1), i32(4), i32(1), i32(5), i32(9), i32(2)];\nmax_val := nums.fold(i32(0), (fn(acc : i32, x : i32) -> i32)(cond((x > acc) => x, true => acc)));\nexport(max_val);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "9", "9"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bac: fold to count elements greater than threshold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [3, 1, 4, 1, 5, 9, 2, 6] elements > 5: [9, 6] → count = 2
  src := "nums := [i32(3), i32(1), i32(4), i32(1), i32(5), i32(9), i32(2), i32(6)];\ncount := nums.fold(i32(0), (fn(acc : i32, x : i32) -> i32)(cond((x > i32(5)) => (acc + i32(1)), true => acc)));\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

