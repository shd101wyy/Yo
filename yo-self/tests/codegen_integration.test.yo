  p_first := make_dot_expr(make_atom_expr(TokenKind.Identifier, "p"), make_atom_expr(TokenKind.Identifier, "first"));
  p_second := make_dot_expr(make_atom_expr(TokenKind.Identifier, "p"), make_atom_expr(TokenKind.Identifier, "second"));
  sum_body := make_infix_expr("+", p_first, p_second);
  body_args := ArrayList(AstExpr).new();
  body_args.push(sum_body);
  fn_app := AstExpr.FnCall(usize(0), box(fn_type), body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "sum"), fn_app));
  main_params := ArrayList(AstExpr).new();
  main_fn_type := make_infix_expr("->", make_fncall_expr("fn", main_params), make_atom_expr(TokenKind.Identifier, "i32"));
  main_body_args := ArrayList(AstExpr).new();
  main_body_args.push(make_atom_expr(TokenKind.Integer, "0"));
  main_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app));
  result := compile_module_to_c(exprs, "field_mod", "main");
  match(
    result,
