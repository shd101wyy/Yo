});
test("validation: Self.method static dispatch uses current impl type", {
  args := ArrayList(AstExpr).new();
  args.push(make_atom_expr(TokenKind.Identifier, "n"));
  call_expr := make_method_call_expr(make_atom_expr(TokenKind.Identifier, "Self"), "callee", args);
  ctx := CodegenContext.new();
  ctx.register_fn_with_params(String.from("P_callee"), String.new());
  ctx.set_self_type("P");
  pctx := ctx;
  ind := String.new();
  result := generate_expr(call_expr, pctx, ind);
  match(
    result,
    .None => assert(false, "Self.callee should generate"),
    .Some(code) => {
      assert(code == String.from("fn_P_callee(n)"), "Self should resolve to current impl type");
    }
  );
});
