test("validation: ArrayList(Token) has concrete bootstrap value layout", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  src := String.from("Token :: object(name : String); to_str :: (fn(toks : ArrayList(Token), i : usize) -> String)({ n := toks.len(); match(toks.get(i), .Some(p) => String.concat(p.name, `tail`), .None => `none`) }); main :: (fn() -> unit)({ toks := ArrayList(Token).new(); toks.push(Token(name : `a`)); s := to_str(toks, usize(0)); assert(s == `atail`, \"ok\"); }); export(main);");
  exprs := parse(src, String.from("<test>"), exn);
  opt_c := compile_module_to_c(exprs, "arraylist_token_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("typedef struct { Token data[1024]; size_t length; Token* _ptr; } ArrayList_Token;")), "ArrayList_Token typedef");
      assert(c.contains(String.from("static const char* fn_to_str(ArrayList_Token toks, size_t i);")), "ArrayList(Token) parameter type");
      assert(c.contains(String.from("(ArrayList_Token){.data = {0}, .length = 0, ._ptr = NULL}")), "ArrayList(Token).new concrete init");
      assert(c.contains(String.from("__auto_type n = toks.length;")), "ArrayList(Token).len lowers to length");
      assert(c.contains(String.from("toks.data[i]")), "ArrayList(Token).get lowers to data access");
      assert(c.contains(String.from("__yo_str_concat(p.name, \"tail\")")), "String.concat lowers in function body");
    }
  );
});
test("validation: cond branch begin block returns inside selected branch", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  src := String.from("build_tag :: (fn(n : i32) -> String)(cond((n <= i32(0)) => `end`, true => { tail := recur(n - i32(1)); String.concat(`x`, tail) })); main :: (fn() -> unit)({ s := build_tag(i32(3)); assert(s == `xxxend`, \"ok\"); }); export(main);");
  exprs := parse(src, String.from("<test>"), exn);
  opt_c := compile_module_to_c(exprs, "cond_begin_return_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("if ((n <= (int32_t)(0))) {")), "cond should emit branch if");
      assert(c.contains(String.from("return \"end\";")), "base branch should return directly");
      assert(c.contains(String.from("__auto_type tail = fn_build_tag((n - (int32_t)(1)));")), "recursive local should stay in branch");
      assert(c.contains(String.from("return __yo_str_concat(\"x\", tail);")), "recursive branch should return concat");
      assert(!(c.contains(String.from("__auto_type tail = fn_build_tag((n - (int32_t)(1)));\n  0;\n  return ((n <= (int32_t)(0))"))), "recursive local must not be hoisted before cond");
    }
  );
});
test("validation: ClosureType begin body captures mutable local copy", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  src := String.from("main :: (fn() -> unit)({ x := i32(1); ClosureType :: Impl(Fn(y : i32) -> i32); T :: Type.to_comptime_string(ClosureType); closure := ClosureType({ x = (x + y); return(x); }); closure2 := closure; closure(1); closure(1); result := closure(2); assert((x == i32(1)), \"outer x\"); assert((result == i32(5)), \"result\"); }); export(main);");
  exprs := parse(src, String.from("<test>"), exn);
  opt_c := compile_module_to_c(exprs, "closure_type_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("typedef struct { __typeof__(x) x; } __yo_closure_env_closure;")), "closure env should capture x by value");
      assert(c.contains(String.from("__yo_closure_env_closure closure = { .x = x };")), "closure value should initialize env copy");
      assert(c.contains(String.from("((closure.x = (closure.x + 1)), closure.x);")), "closure call should mutate env copy");
      assert(c.contains(String.from("__auto_type result = ((closure.x = (closure.x + 2)), closure.x);")), "closure result should come from env copy");
    }
  );
});
test("validation: typed Impl lambda captures mutable local copy", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  src := String.from("main :: (fn() -> unit)({ x := i32(1); (closure : Impl(Fn(y : i32) -> i32)) = ((y) => { x = (x + y); return(x); }); closure2 := closure; closure(1); closure(1); result := closure(2); result2 := closure2(2); assert((x == i32(1)), \"outer x\"); assert((result == i32(5)), \"result\"); assert((result2 == i32(3)), \"copy result\"); }); export(main);");
  exprs := parse(src, String.from("<test>"), exn);
  opt_c := compile_module_to_c(exprs, "typed_closure_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("typedef struct { __typeof__(x) x; } __yo_closure_env_closure;")), "typed closure env should capture x");
      assert(c.contains(String.from("__yo_closure_env_closure closure = { .x = x };")), "typed closure should initialize env copy");
      assert(c.contains(String.from("__auto_type result = ((closure.x = (closure.x + 2)), closure.x);")), "typed closure result should use env copy");
      assert(c.contains(String.from("__auto_type result2 = ((closure2.x = (closure2.x + 2)), closure2.x);")), "closure copy call should use copied env");
    }
  );
});
test("validation: object payload field lowers through star accessor", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  src := String.from("MyBox :: object((*) : i32); main :: (fn() -> unit)({ x := MyBox(i32(1)); x.* = (x.* + i32(1)); assert((x.* == i32(2)), \"payload\"); }); export(main);");
  exprs := parse(src, String.from("<test>"), exn);
  opt_c := compile_module_to_c(exprs, "object_payload_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("typedef struct { int32_t _0; } MyBox;")), "object payload should emit _0 field");
      assert(c.contains(String.from("x._0 = (x._0 + (int32_t)(1));")), "star assignment should use _0 field");
      assert(c.contains(String.from("if (!((x._0 == (int32_t)(2)))) { exit(1); }")), "star assertion should use _0 field");
    }
  );
});
test("validation: Impl closure capturing object shares payload", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  src := String.from("MyBox :: object((*) : i32); main :: (fn() -> unit)({ x := MyBox(i32(1)); ClosureType :: Impl(Fn(y : i32) -> i32); closure := ClosureType({ x.* = (x.* + y); return(x.*); }); closure2 := closure; result := closure(i32(4)); result2 := closure2(i32(2)); assert((result == i32(5)), \"result\"); assert((result2 == i32(7)), \"copy result\"); assert((x.* == i32(7)), \"shared box\"); }); export(main);");
  exprs := parse(src, String.from("<test>"), exn);
  opt_c := compile_module_to_c(exprs, "rc_closure_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("typedef struct { __typeof__(&x) x; } __yo_closure_env_closure;")), "object closure should capture pointer to x");
      assert(c.contains(String.from("__yo_closure_env_closure closure = { .x = &x };")), "object closure should initialize pointer env");
      assert(c.contains(String.from("__auto_type result = ((closure.x->_0 = (closure.x->_0 + (int32_t)(4))), closure.x->_0);")), "closure call should mutate shared payload");
      assert(c.contains(String.from("__auto_type result2 = ((closure2.x->_0 = (closure2.x->_0 + (int32_t)(2))), closure2.x->_0);")), "closure copy should mutate shared payload");
      assert(c.contains(String.from("if (!((x._0 == (int32_t)(7)))) { exit(1); }")), "outer object should see shared payload");
    }
  );
});
test("validation: Dyn closure captures mutable shared env", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  src := String.from("main :: (fn() -> unit)({ x := i32(1); (closure : Dyn(Fn(y : i32) -> i32)) = dyn(box((y) => { x = (x + y); return(x); })); closure2 := closure; closure(i32(1)); closure2(i32(1)); result := closure(i32(2)); assert((x == i32(1)), \"outer x\"); assert((result == i32(5)), \"result\"); }); export(main);");
  exprs := parse(src, String.from("<test>"), exn);
  opt_c := compile_module_to_c(exprs, "dyn_closure_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("__yo_closure_env_closure __yo_closure_storage_closure = { .x = x };")), "Dyn closure should allocate storage env");
      assert(c.contains(String.from("__yo_closure_env_closure* closure = &__yo_closure_storage_closure;")), "Dyn closure value should be env pointer");
      assert(c.contains(String.from("((closure->x = (closure->x + (int32_t)(1))), closure->x);")), "Dyn closure should mutate pointer env");
      assert(c.contains(String.from("((closure2->x = (closure2->x + (int32_t)(1))), closure2->x);")), "Dyn closure copy should share pointer env");
      assert(c.contains(String.from("__auto_type result = ((closure->x = (closure->x + (int32_t)(2))), closure->x);")), "Dyn closure result should use shared pointer env");
    }
  );
});
