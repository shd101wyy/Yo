  compile_module_to_c,
  compile_test_body_to_c
} :: import("../codegen/driver.yo");
// ---------------------------------------------------------------------------
// AST construction helpers
// ---------------------------------------------------------------------------
make_token_raw :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
make_atom_expr :: (fn(kind : TokenKind, value : str) -> AstExpr)(
  .Atom(usize(0), make_token_raw(kind, value))
);
make_infix_expr :: (fn(op : str, lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  op_tok := make_token_raw(TokenKind.Operator, op);
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), args, true, op_tok)
});
make_unary_expr :: (fn(op : str, operand : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(operand);
  op_tok := make_token_raw(TokenKind.Operator, op);
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), args, false, op_tok)
});
make_fncall_expr :: (fn(name : str, args : ArrayList(AstExpr)) -> AstExpr)({
  name_tok := make_token_raw(TokenKind.Identifier, name);
  .FnCall(usize(0), box(.Atom(usize(0), name_tok)), args, false, name_tok)
});
make_begin_expr :: (fn(stmts : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("begin", stmts)
);
make_cond_expr :: (fn(arms : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("cond", arms)
);
make_cond_arm :: (fn(cond_e : AstExpr, body_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(body_e);
  op_tok := make_token_raw(TokenKind.Operator, "=>");
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), a, true, op_tok)
});
make_if_expr :: (fn(cond_e : AstExpr, then_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(then_e);
  make_fncall_expr("if", a)
});
make_if_else_expr :: (fn(cond_e : AstExpr, then_e : AstExpr, else_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(then_e);
  a.push(else_e);
  make_fncall_expr("if", a)
});
make_while_expr :: (fn(cond_e : AstExpr, body_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(body_e);
  make_fncall_expr("while", a)
});
make_runtime_cond :: (fn(inner : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(inner);
  make_fncall_expr("runtime", a)
});
// Phase 4d helpers ——————————————————————————————————————————————————————————
/// Build `FnCall(Dot, [lhs, rhs], is_infix=true)` — dot field/variant access.
make_dot_expr :: (fn(lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(lhs);
  a.push(rhs);
  dot_tok := make_token_raw(TokenKind.Dot, ".");
  .FnCall(usize(0), box(.Atom(usize(0), dot_tok)), a, true, dot_tok)
});
/// Build `FnCall(FnCall(Dot, [obj, method], true), args, false)` — method call.
make_method_call_expr :: (fn(obj : AstExpr, method : str, args : ArrayList(AstExpr)) -> AstExpr)({
  dot_tok := make_token_raw(TokenKind.Dot, ".");
  method_tok := make_token_raw(TokenKind.Identifier, method);
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(obj);
  dot_args.push(AstExpr.Atom(usize(0), method_tok));
  dot_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  AstExpr.FnCall(usize(0), box(dot_expr), args, false, dot_tok)
});
/// Build `FnCall(":", [name_expr, ty_expr], is_infix=true)` — type annotation.
make_colon_expr :: (fn(name_e : AstExpr, ty_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(name_e);
  a.push(ty_e);
  colon_tok := make_token_raw(TokenKind.Operator, ":");
  .FnCall(usize(0), box(.Atom(usize(0), colon_tok)), a, true, colon_tok)
});
/// Build `FnCall("=", [lhs, rhs], is_infix=true)` — assignment or typed decl.
make_assign_expr :: (fn(lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(lhs);
  a.push(rhs);
  eq_tok := make_token_raw(TokenKind.Operator, "=");
  .FnCall(usize(0), box(.Atom(usize(0), eq_tok)), a, true, eq_tok)
});
/// Build a typed declaration `(x : T) = val`.
make_typed_decl_expr :: (fn(name : str, ty_name : str, val_e : AstExpr) -> AstExpr)(
  make_assign_expr(
    make_colon_expr(
      make_atom_expr(TokenKind.Identifier, name),
      make_atom_expr(TokenKind.Identifier, ty_name)
    ),
    val_e
  )
);
/// Convenience: run generate_expr with a fresh context and empty indent.
run_gen :: (fn(expr : AstExpr) -> Option(String))({
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  ind := String.new();
  generate_expr(expr, pctx, ind)
});
/// Convenience: run generate_expr and also return the emitted code.
run_gen_with_ctx :: (fn(expr : AstExpr) -> CodegenContext)({
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  ind := String.new();
  _r := generate_expr(expr, pctx, ind);
  ctx
});
{ parse, ParseError } :: import("../parser.yo");
/// Build `FnCall(Atom("fn"), params, false)` — fn type prefix.
make_fn_type_prefix :: (fn(params : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("fn", params)
);
/// Build `FnCall(Atom("->"), [fn_prefix, ret_ty], true)` — fn type with return.
make_fn_type :: (fn(params : ArrayList(AstExpr), ret_ty : AstExpr) -> AstExpr)({
  fn_prefix := make_fn_type_prefix(params);
  make_infix_expr("->", fn_prefix, ret_ty)
});
/// Build the whole `(fn(params) -> ret_ty)(body)` function literal application.
make_fn_app :: (fn(params : ArrayList(AstExpr), ret_ty : AstExpr, body : AstExpr) -> AstExpr)({
  fn_type := make_fn_type(params, ret_ty);
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  fn_type_tok := make_token_raw(TokenKind.Operator, "->");
  .FnCall(usize(0), box(fn_type), body_args, false, fn_type_tok)
});
/// Build `FnCall(Atom("::"), [name_atom, fn_app], true)` — named constant define.
make_define_expr :: (fn(name : str, rhs : AstExpr) -> AstExpr)(
  make_infix_expr("::", make_atom_expr(TokenKind.Identifier, name), rhs)
);
/// Build `FnCall(Atom(":"), [name, ty], true)` — typed param (reuses make_colon_expr).
make_param :: (fn(name : str, ty_name : str) -> AstExpr)(
  make_colon_expr(
    make_atom_expr(TokenKind.Identifier, name),
    make_atom_expr(TokenKind.Identifier, ty_name)
  )
);
/// Build a `name : Type` evidence param expression.
make_using_param :: (fn(ev_name : str, ty_name : str) -> AstExpr)({
  inner := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, ev_name),
    make_atom_expr(TokenKind.Identifier, ty_name)
  );
  a := ArrayList(AstExpr).new();
  a.push(inner);
  make_fncall_expr("using", a)
});
// ---------------------------------------------------------------------------
// Integration test: compile a complete program through compile_module_to_c
// ---------------------------------------------------------------------------
test("compile_module_to_c: complete program with struct, fn, and main", {
  // Program:
  //   Point :: struct(x : i32, y : i32);
  //   add_points :: (fn(a : Point, b : Point) -> Point)(
  //     Point(x: (a.x + b.x), y: (a.y + b.y))
  //   );
  //   main :: (fn() -> i32)(0);
  //   export(main);
  exprs := ArrayList(AstExpr).new();
  // Point :: struct(x : i32, y : i32)
  struct_args := ArrayList(AstExpr).new();
  struct_args.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "i32")));
  struct_args.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "y"), make_atom_expr(TokenKind.Identifier, "i32")));
  struct_call := make_fncall_expr("struct", struct_args);
  point_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "Point"), struct_call);
  exprs.push(point_def);
  // add_points :: (fn(a : Point, b : Point) -> Point)(body)
  fn_params := ArrayList(AstExpr).new();
  fn_params.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "a"), make_atom_expr(TokenKind.Identifier, "Point")));
  fn_params.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "b"), make_atom_expr(TokenKind.Identifier, "Point")));
  fn_type_call := make_fncall_expr("fn", fn_params);
  fn_type := make_infix_expr("->", fn_type_call, make_atom_expr(TokenKind.Identifier, "Point"));
  fn_body_args := ArrayList(AstExpr).new();
  fn_body_args.push(make_atom_expr(TokenKind.Integer, "0")); // simplified body
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  fn_app := AstExpr.FnCall(usize(0), box(fn_type), fn_body_args, false, fn_tok);
  add_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "add_points"), fn_app);
  exprs.push(add_def);
  // main :: (fn() -> i32)(0)
  main_params := ArrayList(AstExpr).new();
  main_fn_type_call := make_fncall_expr("fn", main_params);
  main_fn_type := make_infix_expr("->", main_fn_type_call, make_atom_expr(TokenKind.Identifier, "i32"));
  main_body_args := ArrayList(AstExpr).new();
  main_body_args.push(make_atom_expr(TokenKind.Integer, "0"));
  main_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_body_args, false, fn_tok);
  main_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app);
  exprs.push(main_def);
  result := compile_module_to_c(exprs, "point_mod", "main");
  match(
    result,
    .None => assert(false, "full program should compile"),
    .Some(c_code) => {
      // Should contain the struct typedef
      assert(c_code.contains(String.from("typedef struct")), "should have typedef struct");
      assert(c_code.contains(String.from("Point")), "should have Point type");
      // Should contain the function
      assert(c_code.contains(String.from("add_points")), "should have add_points function");
      // Should contain int main()
      assert(c_code.contains(String.from("int main")), "should have main function");
      // Should contain the #include <stdint.h> from preamble
      assert(c_code.contains(String.from("#include")), "should have #include directives");
    }
  );
});
test("compile_module_to_c: program with enum and match emits switch", {
  // Program:
  //   Color :: enum(Red, Green, Blue);
  //   main :: (fn() -> i32)(0);
  //   export(main);
  exprs := ArrayList(AstExpr).new();
  // Color :: enum(Red, Green, Blue)
  enum_args := ArrayList(AstExpr).new();
  enum_args.push(make_atom_expr(TokenKind.Identifier, "Red"));
  enum_args.push(make_atom_expr(TokenKind.Identifier, "Green"));
  enum_args.push(make_atom_expr(TokenKind.Identifier, "Blue"));
  enum_call := make_fncall_expr("enum", enum_args);
  color_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "Color"), enum_call);
  exprs.push(color_def);
  // main :: (fn() -> i32)(0)
  main_params := ArrayList(AstExpr).new();
  main_fn_type_call := make_fncall_expr("fn", main_params);
  main_fn_type := make_infix_expr("->", main_fn_type_call, make_atom_expr(TokenKind.Identifier, "i32"));
  main_body_args := ArrayList(AstExpr).new();
  main_body_args.push(make_atom_expr(TokenKind.Integer, "0"));
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  main_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_body_args, false, fn_tok);
  main_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app);
  exprs.push(main_def);
  result := compile_module_to_c(exprs, "color_mod", "main");
  match(
    result,
    .None => assert(false, "enum program should compile"),
    .Some(c_code) => {
      // Should contain the enum type
      assert(c_code.contains(String.from("Color")), "should have Color enum");
      // Should contain enum variants as defines or enum values
      assert(c_code.contains(String.from("Color_Red")), "should have Color_Red variant");
      assert(c_code.contains(String.from("Color_Green")), "should have Color_Green variant");
      assert(c_code.contains(String.from("Color_Blue")), "should have Color_Blue variant");
      // Should contain int main()
      assert(c_code.contains(String.from("int main")), "should have main");
    }
  );
});
test("compile_module_to_c: program with impl method emits TypeName_method", {
  // Program:
  //   Counter :: struct(count : i32);
  //   impl(Counter, inc : (fn(self : *(Self)) -> unit)(...));
  //   main :: (fn() -> i32)(0);
  //   export(main);
  exprs := ArrayList(AstExpr).new();
  // Counter :: struct(count : i32)
  struct_args := ArrayList(AstExpr).new();
  struct_args.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "count"), make_atom_expr(TokenKind.Identifier, "i32")));
  struct_call := make_fncall_expr("struct", struct_args);
  counter_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "Counter"), struct_call);
  exprs.push(counter_def);
  // impl(Counter, inc : (fn(self : *(Self)) -> unit)(0))
  impl_args := ArrayList(AstExpr).new();
  impl_args.push(make_atom_expr(TokenKind.Identifier, "Counter"));
  // inc : fn_def
  fn_params_i := ArrayList(AstExpr).new();
  fn_params_i.push(
    make_infix_expr(
      ":",
      make_atom_expr(TokenKind.Identifier, "self"),
      make_fncall_expr("*", {
        pa := ArrayList(AstExpr).new();
        pa.push(make_atom_expr(TokenKind.Identifier, "Self"));
        pa
      })
    )
  );
  fn_type_call_i := make_fncall_expr("fn", fn_params_i);
  fn_type_i := make_infix_expr("->", fn_type_call_i, make_atom_expr(TokenKind.Identifier, "unit"));
  fn_body_args_i := ArrayList(AstExpr).new();
  fn_body_args_i.push(make_atom_expr(TokenKind.Integer, "0"));
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  fn_app_i := AstExpr.FnCall(usize(0), box(fn_type_i), fn_body_args_i, false, fn_tok);
  meth_def := make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "inc"), fn_app_i);
  impl_args.push(meth_def);
  impl_call := make_fncall_expr("impl", impl_args);
  exprs.push(impl_call);
  // main :: (fn() -> i32)(0)
  main_params := ArrayList(AstExpr).new();
  main_fn_type_call := make_fncall_expr("fn", main_params);
  main_fn_type := make_infix_expr("->", main_fn_type_call, make_atom_expr(TokenKind.Identifier, "i32"));
  main_body_args := ArrayList(AstExpr).new();
  main_body_args.push(make_atom_expr(TokenKind.Integer, "0"));
  main_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_body_args, false, fn_tok);
  main_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app);
  exprs.push(main_def);
  result := compile_module_to_c(exprs, "counter_mod", "main");
  match(
    result,
    .None => assert(false, "impl program should compile"),
    .Some(c_code) => {
      // Should contain the struct typedef
      assert(c_code.contains(String.from("Counter")), "should have Counter type");
      // Should contain the impl method as Counter_inc
      assert(c_code.contains(String.from("Counter_inc")), "should have Counter_inc method");
      // Should contain int main()
      assert(c_code.contains(String.from("int main")), "should have main");
    }
  );
});
// ---------------------------------------------------------------------------
// Phase 5q: codegen integration tests — richer program patterns
// ---------------------------------------------------------------------------
test("compile_module_to_c: program with if/else emits conditional", {
  // abs :: (fn(x : i32) -> i32)({ if((x < 0), (0 - x), x); });
  // main :: (fn() -> i32)(0);
  exprs := ArrayList(AstExpr).new();
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  fn_params := ArrayList(AstExpr).new();
  fn_params.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "i32")));
  fn_type := make_infix_expr("->", make_fncall_expr("fn", fn_params), make_atom_expr(TokenKind.Identifier, "i32"));
  cond_e := make_infix_expr("<", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Integer, "0"));
  then_e := make_infix_expr("-", make_atom_expr(TokenKind.Integer, "0"), make_atom_expr(TokenKind.Identifier, "x"));
  else_e := make_atom_expr(TokenKind.Identifier, "x");
  if_expr := make_if_else_expr(cond_e, then_e, else_e);
  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(if_expr);
  body := make_begin_expr(body_stmts);
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  fn_app := AstExpr.FnCall(usize(0), box(fn_type), body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "abs"), fn_app));
  main_params := ArrayList(AstExpr).new();
  main_fn_type := make_infix_expr("->", make_fncall_expr("fn", main_params), make_atom_expr(TokenKind.Identifier, "i32"));
  main_body_args := ArrayList(AstExpr).new();
  main_body_args.push(make_atom_expr(TokenKind.Integer, "0"));
  main_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app));
  result := compile_module_to_c(exprs, "if_mod", "main");
  match(
    result,
    .None => assert(false, "if/else program should compile"),
    .Some(c_code) => {
      assert(c_code.contains(String.from("abs")), "should have abs function");
      assert(c_code.contains(String.from("int main")), "should have main");
      has_if := (c_code.contains(String.from("if")) || c_code.contains(String.from("?")));
      assert(has_if, "should have if or ternary");
    }
  );
});
test("compile_module_to_c: program with while loop emits while", {
  // countdown :: (fn(n : i32) -> i32)({
  //   (x : i32) = n; while runtime((x > 0)), { x = (x - 1); }; x;
  // });
  // main :: (fn() -> i32)(0);
  exprs := ArrayList(AstExpr).new();
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  fn_params := ArrayList(AstExpr).new();
  fn_params.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "n"), make_atom_expr(TokenKind.Identifier, "i32")));
  fn_type := make_infix_expr("->", make_fncall_expr("fn", fn_params), make_atom_expr(TokenKind.Identifier, "i32"));
  x_decl := make_assign_expr(
    make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "i32")),
    make_atom_expr(TokenKind.Identifier, "n")
  );
  while_cond := make_runtime_cond(make_infix_expr(">", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Integer, "0")));
  while_body_stmts := ArrayList(AstExpr).new();
  while_body_stmts.push(make_assign_expr(make_atom_expr(TokenKind.Identifier, "x"), make_infix_expr("-", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Integer, "1"))));
  while_body := make_begin_expr(while_body_stmts);
  while_expr := make_while_expr(while_cond, while_body);
  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(x_decl);
  body_stmts.push(while_expr);
  body_stmts.push(make_atom_expr(TokenKind.Identifier, "x"));
  body := make_begin_expr(body_stmts);
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  fn_app := AstExpr.FnCall(usize(0), box(fn_type), body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "countdown"), fn_app));
  main_params := ArrayList(AstExpr).new();
  main_fn_type := make_infix_expr("->", make_fncall_expr("fn", main_params), make_atom_expr(TokenKind.Identifier, "i32"));
  main_body_args := ArrayList(AstExpr).new();
  main_body_args.push(make_atom_expr(TokenKind.Integer, "0"));
  main_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app));
  result := compile_module_to_c(exprs, "while_mod", "main");
  match(
    result,
    .None => assert(false, "while loop program should compile"),
    .Some(c_code) => {
      assert(c_code.contains(String.from("countdown")), "should have countdown function");
      assert(c_code.contains(String.from("while")), "should have while loop");
      assert(c_code.contains(String.from("int main")), "should have main");
    }
  );
});
test("compile_module_to_c: program with function calling function", {
