  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app));
  result := compile_module_to_c(exprs, "cond_mod", "main");
  match(
    result,
    .None => assert(false, "cond program should compile"),
    .Some(c_code) => {
      assert(c_code.contains(String.from("classify")), "should have classify function");
      assert(c_code.contains(String.from("int main")), "should have main");
    }
  );
});
