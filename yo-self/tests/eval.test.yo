test "Phase 5gv: recursive palindrome check", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "is_pal := (fn(s : str) -> bool)(cond((s.len() <= i32(1)) => true, true => {\nfirst := s.char_at(usize(0));\nlast := s.char_at((s.len() - i32(1)).to_usize());\ncond((first == last) => recur(s.substring(usize(1), (s.len() - i32(1)).to_usize())), true => false)\n}));\nexport is_pal(\"racecar\");\nexport is_pal(\"hello\");";
