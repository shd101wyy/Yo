  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "is_sorted := [i32(1), i32(3), i32(5), i32(7), i32(9)];\nnot_sorted := [i32(1), i32(5), i32(3), i32(7)];\ncheck := (fn(arr : [i32]) -> bool)({\n(ok : bool) = true;\n(i : i32) = i32(1);\nwhile((i < arr.len()), {\nmatch(arr.get((i - i32(1)).to_usize()), .Some(prev) => match(arr.get(i.to_usize()), .Some(curr) => cond((prev > curr) => { ok = false; break; }, true => ()), .None => ()), .None => ());\ni = (i + i32(1));\n});\nok\n});\nexport check(is_sorted);\nexport check(not_sorted);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .BoolVal(b) => assert(b, "sorted"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .BoolVal(b) => assert(!(b), "not sorted"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

