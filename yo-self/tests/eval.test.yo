test "Phase 5er: recursive integer sqrt", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "isqrt := (fn(n : i32) -> i32)({ (lo : i32) = i32(0); (hi : i32) = n; while(((hi - lo) > i32(1)), { mid := ((lo + hi) / i32(2)); lo = cond(((mid * mid) <= n) => mid, true => lo); hi = cond(((mid * mid) > n) => mid, true => hi); }); lo }); r := isqrt(i32(144)); export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
