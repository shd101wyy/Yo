test "Phase 5ae: ArrayVal.first returns Some on non-empty", {
  env := empty_env();
  arr_items := ArrayList(AstExpr).new();
  arr_items.push(make_atom(TokenKind.Integer, "10"));
  arr_items.push(make_atom(TokenKind.Integer, "20"));
  arr_tok := make_token(TokenKind.Identifier, BK_ARRAY_VAL);
  arr_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), arr_tok)), arr_items, false, arr_tok);
  def_expr := make_infix(":=", make_atom(TokenKind.Identifier, "af"), arr_expr);
  _ := evaluate(def_expr, &env);
  // af.first()
  dot_tok := make_token(TokenKind.Dot, ".");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(make_atom(TokenKind.Identifier, "af"));
  dot_args.push(make_atom(TokenKind.Identifier, "first"));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_expr := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, dot_tok);
  result := evaluate(call_expr, &env);
  match(result,
    .None => assert(false, "first returned None"),
    .Some(r) =>
      match(r.value,
        .EnumVal(tag, fields) => {
          assert((tag.as_str() == ".Some"), "should be .Some");
          match(fields.get(usize(0)),
            .Some(fv) => match(fv, .IntLit(n) => assert((n.as_str() == "10"), "first should be 10"), _ => assert(false, "field should be IntLit")),
            .None => assert(false, "should have field 0")
          );
        },
        _ => assert(false, "first should return EnumVal")
      )
  );
};

