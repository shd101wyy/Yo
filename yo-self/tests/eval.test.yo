test "Phase 3am: ArrayVal push and len", {
  src := "arr := ArrayList(String).new(); arr.push(\"hello\"); arr.push(\"world\"); n :: arr.len(); export n;";
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "1 export");
          match(vals.get(usize(0)),
            .Some(v1) =>
              match(v1,
                .IntLit(n) => assert((n.as_str() == "2"), "ArrayList has len 2 after 2 pushes"),
                _ => assert(false, "n not IntLit")
              ),
            .None => assert(false, "no n")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

test "Phase 3am: ArrayVal get returns Some(element)", {
  src := "arr := ArrayList(String).new(); arr.push(\"hello\"); first :: arr.get(0); export first;";
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "1 export");
          match(vals.get(usize(0)),
            .Some(v1) =>
              match(v1,
                .EnumVal(tag, ev_fields) => {
                  assert((tag.as_str() == ".Some"), "first is .Some");
                  match(ev_fields.get(usize(0)),
                    .None => assert(false, "no first elem"),
                    .Some(first_elem) =>
                      match(first_elem,
                        .StrLit(s) => assert((s.as_str() == "\"hello\""), "first elem is hello"),
                        _ => assert(false, "first elem not StrLit")
                      )
                  );
                },
                _ => assert(false, "first not EnumVal")
              ),
            .None => assert(false, "no first")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

