// ---------------------------------------------------------------------------
// Phase 3i — closure capture / lexical scoping
// ---------------------------------------------------------------------------

test "evaluate: closure captures outer variable (make_adder)", {
  // Verify lexical scoping: inner_fn captures x from the call frame of make_adder.
  // make_adder := (fn(x)(fn(y)(x + y)))
  // add5  := make_adder(5)  — creates closure with x=5 captured
  // result := add5(3)       — evaluates x+y with x=5, y=3 → 8
  env := empty_env();

  // Build inner function body: x + y
  inner_body := make_infix("+", make_ident("x"), make_ident("y"));
  inner_params := ArrayList(String).new();
  inner_params.push(String.from("y"));
  inner_fn := make_fn_def(inner_params, inner_body);

  // Build outer function: (fn(x) -> unit)(inner_fn)
  outer_params := ArrayList(String).new();
  outer_params.push(String.from("x"));
  make_adder_def := make_fn_def(outer_params, inner_fn);

  // make_adder := make_adder_def
  _d1 := evaluate(make_infix(":=", make_ident("make_adder"), make_adder_def), &env);

  // add5 := make_adder(5)
  adder_args := ArrayList(AstExpr).new();
  adder_args.push(make_atom(TokenKind.Integer, "5"));
  _d2 := evaluate(
    make_infix(":=", make_ident("add5"), make_call("make_adder", adder_args)),
    &env
  );

  // result := add5(3)
  add5_args := ArrayList(AstExpr).new();
  add5_args.push(make_atom(TokenKind.Integer, "3"));
  result := evaluate(make_call("add5", add5_args), &env);

  check_some(result, "add5(3) closure");
  match(result,
    .Some(r) => assert(
      (r.value == EvalValue.IntLit(String.from("8"))),
      "closure: 5+3=8"
    ),
    .None => ()
  );
};

// ---------------------------------------------------------------------------
// Phase 3j — method dispatch on StructVal and impl block registration
// ---------------------------------------------------------------------------

test "evaluate: method dispatch on StructVal (manual registration)", {
  // Manually register Point.get_x := (fn(self) -> i32)(self.x) in env,
  // then call point.get_x() and expect IntLit("1").
  env := empty_env();

  // Register Point.get_x in env
  self_param := ArrayList(String).new();
  self_param.push(String.from("self"));
  get_x_body := make_infix(".", make_ident("self"), make_ident("x"));
  get_x_fn := make_fn_def(self_param, get_x_body);
  match(evaluate(get_x_fn, &env),
    .Some(fres) => {
      _dm := env.define_val(
        String.from("Point.get_x"),
        fres.ty, true, .Some(fres.value)
      );
    },
    .None => assert(false, "get_x fn def failed")
  );

  // point := Point(x: i32(1), y: i32(2))
  one_args := ArrayList(AstExpr).new();
  one_args.push(make_atom(TokenKind.Integer, "1"));
  two_args := ArrayList(AstExpr).new();
  two_args.push(make_atom(TokenKind.Integer, "2"));
  x_arg := make_infix(":", make_ident("x"), make_call("i32", one_args));
  y_arg := make_infix(":", make_ident("y"), make_call("i32", two_args));
  call_a := ArrayList(AstExpr).new();
  call_a.push(x_arg);
  call_a.push(y_arg);
  _dp := evaluate(make_infix(":=", make_ident("point"), make_call("Point", call_a)), &env);

  // point.get_x()
  empty_args := ArrayList(AstExpr).new();
  method_call := make_infix(".", make_ident("point"), make_call("get_x", empty_args));
  result := evaluate(method_call, &env);

  check_some(result, "point.get_x()");
  match(result,
    .Some(r) => assert(
      (r.value == EvalValue.IntLit(String.from("1"))),
      "point.get_x() == 1"
    ),
    .None => ()
  );
};

test "evaluate: impl block registers methods", {
  // impl(Point, get_y: (fn(self)(self.y))) then point.get_y() == 2
  env := empty_env();

  // point := Point(x: i32(1), y: i32(2))
  one_args := ArrayList(AstExpr).new();
  one_args.push(make_atom(TokenKind.Integer, "1"));
  two_args := ArrayList(AstExpr).new();
  two_args.push(make_atom(TokenKind.Integer, "2"));
  x_arg := make_infix(":", make_ident("x"), make_call("i32", one_args));
  y_arg := make_infix(":", make_ident("y"), make_call("i32", two_args));
  point_args := ArrayList(AstExpr).new();
  point_args.push(x_arg);
  point_args.push(y_arg);
  _dp := evaluate(make_infix(":=", make_ident("point"), make_call("Point", point_args)), &env);

  // Build impl(Point, get_y: (fn(self)(self.y)))
  self_p := ArrayList(String).new();
  self_p.push(String.from("self"));
  get_y_body := make_infix(".", make_ident("self"), make_ident("y"));
  get_y_fn := make_fn_def(self_p, get_y_body);
  impl_method := make_infix(":", make_ident("get_y"), get_y_fn);
  impl_args := ArrayList(AstExpr).new();
  impl_args.push(make_ident("Point"));
  impl_args.push(impl_method);
  impl_expr := make_call("impl", impl_args);
  _di := evaluate(impl_expr, &env);

  // point.get_y()
  empty_a := ArrayList(AstExpr).new();
  method_call := make_infix(".", make_ident("point"), make_call("get_y", empty_a));
  result := evaluate(method_call, &env);

  check_some(result, "point.get_y() via impl");
  match(result,
    .Some(r) => assert(
      (r.value == EvalValue.IntLit(String.from("2"))),
      "point.get_y() == 2"
    ),
    .None => ()
  );
};

// ---------------------------------------------------------------------------
// Phase 3k — TypeVal: type names as first-class compile-time values
// ---------------------------------------------------------------------------

test "evaluate: type identifier i32 resolves to TypeVal", {
  env := empty_env();
  result := evaluate(make_ident("i32"), &env);
  check_some(result, "i32 identifier");
  match(result,
    .Some(r) => {
      match(r.value,
        .TypeVal(ty) =>
          match(ty.*,
            .Int(bits, signed) => {
              assert((bits == u8(32)), "i32 must have 32 bits");
              assert(signed, "i32 must be signed");
            },
            _ => { assert(false, "TypeVal ty must be Int(32, true)"); }
          ),
        _ => { assert(false, "result must be TypeVal"); }
      );
      // The type-of a TypeVal is Type (TypeUni level 0)
      match(r.ty,
        .TypeUni(_) => (),
        _ => { assert(false, "type-of TypeVal must be TypeUni"); }
      );
    },
    .None => ()
  );
};

test "evaluate: type identifier bool resolves to TypeVal", {
  env := empty_env();
  result := evaluate(make_ident("bool"), &env);
  check_some(result, "bool identifier");
  match(result,
    .Some(r) =>
      match(r.value,
        .TypeVal(ty) =>
          match(ty.*,
            .BoolT => (),
            _ => { assert(false, "TypeVal ty must be BoolT"); }
          ),
        _ => { assert(false, "result must be TypeVal"); }
      ),
    .None => ()
  );
};

test "evaluate: type identifier usize resolves to TypeVal", {
  env := empty_env();
  result := evaluate(make_ident("usize"), &env);
  check_some(result, "usize identifier");
  match(result,
    .Some(r) =>
      match(r.value,
        .TypeVal(ty) =>
          match(ty.*,
            .Usize => (),
            _ => { assert(false, "TypeVal ty must be Usize"); }
          ),
        _ => { assert(false, "result must be TypeVal"); }
      ),
    .None => ()
  );
};

test "evaluate: TypeVal is comptime", {
  env := empty_env();
  result := evaluate(make_ident("i32"), &env);
  match(result,
    .Some(r) => {
      match(r.value,
        .TypeVal(_) => (),
        _ => { assert(false, "expected TypeVal"); }
      );
      // TypeVal equality: two TypeVals for i32 should compare equal
      (tv_a : EvalValue) = EvalValue.TypeVal(box(t_i32()));
      (tv_b : EvalValue) = EvalValue.TypeVal(box(t_i32()));
      assert((tv_a == tv_b), "TypeVal(i32) == TypeVal(i32)");
      (tv_c : EvalValue) = EvalValue.TypeVal(box(t_bool()));
      assert(!(tv_a == tv_c), "TypeVal(i32) != TypeVal(bool)");
    },
    .None => { assert(false, "expected Some"); }
  );
};

test "evaluate: unknown identifier not a type name still returns None", {
  env := empty_env();
  // "MyCustomType" is not a primitive type name, not in env → None
  result := evaluate(make_ident("MyCustomType"), &env);
  match(result,
    .None => (), // expected — unknown ident returns None
    .Some(_) => { assert(false, "unknown ident must return None"); }
  );
};

// ---------------------------------------------------------------------------
// Phase 3l helpers — build fn defs with typed / forall params
// ---------------------------------------------------------------------------

/// Build a typed param `name : type_name` as an infix `:` FnCall.
make_typed_param :: (fn(name : str, type_name : str) -> AstExpr)(
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Operator, ":"))),
    {
      a := ArrayList(AstExpr).new();
      a.push(make_atom(TokenKind.Identifier, name));
      a.push(make_atom(TokenKind.Identifier, type_name));
      a
    },
    true,
    make_token(TokenKind.Operator, ":")
  )
);

/// Build a forall param `forall(name)` as a non-infix FnCall.
make_forall_param :: (fn(name : str) -> AstExpr)(
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "forall"))),
    {
      a := ArrayList(AstExpr).new();
      a.push(make_atom(TokenKind.Identifier, name));
      a
    },
    false,
    make_token(TokenKind.Identifier, "forall")
  )
);

/// Build `(fn(param_exprs…) -> unit)(body)` from an ArrayList of AstExpr params.
/// More general than `make_fn_def` which only accepts bare atom param names.
make_fn_def_from_param_exprs :: (fn(param_exprs : ArrayList(AstExpr), body : AstExpr) -> AstExpr)({
  (fn_expr : AstExpr) = .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "fn"))),
    param_exprs,
    false,
    make_token(TokenKind.Identifier, "fn")
  );
  arrow_args := ArrayList(AstExpr).new();
  arrow_args.push(fn_expr);
  arrow_args.push(.Atom(usize(0), make_token(TokenKind.Identifier, "unit")));
  (fn_sig : AstExpr) = .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Operator, "->"))),
    arrow_args,
    true,
    make_token(TokenKind.Operator, "->")
  );
  outer_args := ArrayList(AstExpr).new();
  outer_args.push(body);
  (result : AstExpr) = .FnCall(usize(0), box(fn_sig), outer_args, false, make_token(TokenKind.Operator, "->"));
  result
});

// ---------------------------------------------------------------------------
// Phase 3l — Generic specialization / forall param binding
// ---------------------------------------------------------------------------

test "evaluate: forall param name is extracted into FuncVal.forall_names", {
  env := empty_env();
  // id := (fn(forall(A), x : A) -> unit)(x)
  param_exprs := ArrayList(AstExpr).new();
  param_exprs.push(make_forall_param("A"));
  param_exprs.push(make_typed_param("x", "A"));
  fn_def := make_fn_def_from_param_exprs(param_exprs, make_ident("x"));
  define_e := make_infix(":=", make_ident("id"), fn_def);
  _ := evaluate(define_e, &env);
  // Look up id — should be FuncVal with forall_names = ["A"], params = ["x"],
  // param_type_names = ["A"]
  id_res := evaluate(make_ident("id"), &env);
  check_some(id_res, "id is bound");
  match(id_res,
    .Some(r) => match(r.value,
      .FuncVal(fnames, ps, ptnames, _, _, _, _, _, _) => {
        assert((fnames.len() == usize(1)), "1 forall name");
        assert((ps.len() == usize(1)), "1 value param");
        assert((ptnames.len() == usize(1)), "1 param type name");
        match(fnames.get(usize(0)),
          .Some(fn_name) => assert((fn_name.as_str() == "A"), "forall name is A"),
          .None => assert(false, "expected forall name A")
        );
        match(ps.get(usize(0)),
          .Some(pn) => assert((pn.as_str() == "x"), "param name is x"),
          .None => assert(false, "expected param x")
        );
        match(ptnames.get(usize(0)),
          .Some(ptn) => assert((ptn.as_str() == "A"), "param type name is A"),
          .None => assert(false, "expected param type name A")
        );
      },
      _ => assert(false, "expected FuncVal")
    ),
    .None => ()
  );
};

test "evaluate: generic identity fn call with integer arg", {
  env := empty_env();
  // id := (fn(forall(A), x : A) -> unit)(x); id(42) → IntLit("42")
  param_exprs := ArrayList(AstExpr).new();
  param_exprs.push(make_forall_param("A"));
  param_exprs.push(make_typed_param("x", "A"));
  fn_def := make_fn_def_from_param_exprs(param_exprs, make_ident("x"));
  _d := evaluate(make_infix(":=", make_ident("id"), fn_def), &env);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, "42"));
  result := evaluate(make_call("id", call_args), &env);
  check_some(result, "id(42)");
  match(result,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("42"))), "identity returns 42"),
    .None => ()
  );
};

test "evaluate: generic identity fn call with bool arg", {
  env := empty_env();
  param_exprs := ArrayList(AstExpr).new();
  param_exprs.push(make_forall_param("A"));
  param_exprs.push(make_typed_param("x", "A"));
  fn_def := make_fn_def_from_param_exprs(param_exprs, make_ident("x"));
  _d := evaluate(make_infix(":=", make_ident("id_b"), fn_def), &env);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Bool, "true"));
  result := evaluate(make_call("id_b", call_args), &env);
  match(result,
    .Some(r) => assert((r.value == EvalValue.BoolVal(true)), "identity returns true"),
    .None => assert(false, "expected Some for id_b(true)")
  );
};

test "evaluate: forall TypeVal is bound inside fn body", {
  env := empty_env();
  // lookup_type := (fn(forall(A), x : A) -> unit)({ A })
  // When called with an int, body returns TypeVal(ComptimeInt)
  param_exprs := ArrayList(AstExpr).new();
  param_exprs.push(make_forall_param("A"));
  param_exprs.push(make_typed_param("x", "A"));
  // Body: just return A (the TypeVal that should be bound)
  fn_def := make_fn_def_from_param_exprs(param_exprs, make_ident("A"));
  _d := evaluate(make_infix(":=", make_ident("lookup_type"), fn_def), &env);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, "99"));
  result := evaluate(make_call("lookup_type", call_args), &env);
  check_some(result, "lookup_type(99)");
  match(result,
    .Some(r) =>
      match(r.value,
        .TypeVal(ty) =>
          // arg was IntLit → type is ComptimeInt
          match(ty.*,
            .ComptimeInt => (),
            _ => { assert(false, "A should be TypeVal(ComptimeInt) when called with int"); }
          ),
        _ => { assert(false, "A inside body should return TypeVal"); }
      ),
    .None => ()
  );
};

test "evaluate: two forall params both inferred correctly", {
  env := empty_env();
  // swap_types := (fn(forall(A), forall(B), x : A, y : B) -> unit)({ A })
  // When called with (int, bool), A = TypeVal(ComptimeInt)
  param_exprs := ArrayList(AstExpr).new();
  param_exprs.push(make_forall_param("A"));
  param_exprs.push(make_forall_param("B"));
  param_exprs.push(make_typed_param("x", "A"));
  param_exprs.push(make_typed_param("y", "B"));
  fn_def := make_fn_def_from_param_exprs(param_exprs, make_ident("A"));
  _d := evaluate(make_infix(":=", make_ident("type_of_first"), fn_def), &env);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, "1"));
  call_args.push(make_atom(TokenKind.Bool, "false"));
  result := evaluate(make_call("type_of_first", call_args), &env);
  match(result,
    .Some(r) =>
      match(r.value,
        .TypeVal(ty) =>
          match(ty.*,
            .ComptimeInt => (),
            _ => { assert(false, "A should be ComptimeInt"); }
          ),
        _ => { assert(false, "expected TypeVal for A"); }
      ),
    .None => assert(false, "expected Some")
  );
};

test "evaluate: bare (untyped) params still work after Phase 3l", {
  // Ensure existing bare-param functions aren't broken by the new extraction.
  env := empty_env();
  params := ArrayList(String).new();
  params.push(String.from("x"));
  params.push(String.from("y"));
  fn_def := make_fn_def(params, make_infix("+", make_ident("x"), make_ident("y")));
  _d := evaluate(make_infix(":=", make_ident("add_bare"), fn_def), &env);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, "3"));
  call_args.push(make_atom(TokenKind.Integer, "4"));
  result := evaluate(make_call("add_bare", call_args), &env);
  match(result,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("7"))), "3 + 4 = 7"),
    .None => assert(false, "expected Some for add_bare(3, 4)")
  );
};

// ---------------------------------------------------------------------------
// Phase 3m helpers — build export, open, and import AST nodes
// ---------------------------------------------------------------------------

/// Build `export(names…)` as a non-infix FnCall.
make_export :: (fn(names : ArrayList(str)) -> AstExpr)({
  export_tok := make_token(TokenKind.Identifier, BK_EXPORT);
  args := ArrayList(AstExpr).new();
  (i : usize) = usize(0);
  n := names.len();
  while runtime((i < n)), {
    match(names.get(i),
      .Some(name) => { args.push(make_ident(name)); },
      .None => ()
    );
    i = (i + usize(1));
  };
  .FnCall(usize(0), box(.Atom(usize(0), export_tok)), args, false, export_tok)
});

/// Build `open(expr)` as a non-infix FnCall.
make_open :: (fn(expr : AstExpr) -> AstExpr)({
  open_tok := make_token(TokenKind.Identifier, BK_OPEN);
  args := ArrayList(AstExpr).new();
  args.push(expr);
  .FnCall(usize(0), box(.Atom(usize(0), open_tok)), args, false, open_tok)
});

/// Build `import("path")` as a non-infix FnCall (path is a string literal).
make_import_expr :: (fn(path : str) -> AstExpr)({
  import_tok := make_token(TokenKind.Identifier, BK_IMPORT);
  path_lit   := `"${String.from(path)}"`;
  args := ArrayList(AstExpr).new();
  args.push(make_atom(TokenKind.StringLit, path_lit.as_str()));
  .FnCall(usize(0), box(.Atom(usize(0), import_tok)), args, false, import_tok)
});

/// Build `{ A, B } :: import("path")` — anon-struct LHS destructure.
make_destructure_import :: (fn(names : ArrayList(str), path : str) -> AstExpr)({
  anon_tok := make_token(TokenKind.Identifier, BK_ANON_STRUCT);
  name_exprs := ArrayList(AstExpr).new();
  (i : usize) = usize(0);
  n := names.len();
  while runtime((i < n)), {
    match(names.get(i),
      .Some(nm) => { name_exprs.push(make_ident(nm)); },
      .None => ()
    );
    i = (i + usize(1));
  };
  lhs := (AstExpr).FnCall(usize(0), box(.Atom(usize(0), anon_tok)), name_exprs, false, anon_tok);
  rhs := make_import_expr(path);
  make_infix("::", lhs, rhs)
});

// ---------------------------------------------------------------------------
// Phase 3m — Module system
// ---------------------------------------------------------------------------

test "evaluate_module_body: exports two bindings into ModuleVal", {
  env := empty_env();
  // Body: x := 42; y := true; export x, y;
  define_x := make_infix(":=", make_ident("x"), make_atom(TokenKind.Integer, "42"));
  define_y := make_infix(":=", make_ident("y"), make_atom(TokenKind.Bool, "true"));
  export_names := ArrayList(str).new();
  export_names.push("x");
  export_names.push("y");
  export_expr := make_export(export_names);
  exprs := ArrayList(AstExpr).new();
  exprs.push(define_x);
  exprs.push(define_y);
  exprs.push(export_expr);
  result := evaluate_module_body(exprs, &env);
  match(result,
    .Some(mv) =>
      match(mv,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(2)), "2 exported names");
          assert((vals.len() == usize(2)), "2 exported values");
          match(names.get(usize(0)),
            .Some(n0) => assert((n0.as_str() == "x"), "first export is x"),
            .None => assert(false, "missing first export name")
          );
          match(vals.get(usize(0)),
            .Some(v0) => assert((v0 == EvalValue.IntLit(String.from("42"))), "x == 42"),
            .None => assert(false, "missing first export value")
          );
          match(names.get(usize(1)),
            .Some(n1) => assert((n1.as_str() == "y"), "second export is y"),
            .None => assert(false, "missing second export name")
          );
          match(vals.get(usize(1)),
            .Some(v1) => assert((v1 == EvalValue.BoolVal(true)), "y == true"),
            .None => assert(false, "missing second export value")
          );
        },
        _ => assert(false, "expected ModuleVal")
      ),
    .None => assert(false, "evaluate_module_body returned None")
  );
};

test "evaluate: open(ModuleVal) brings all fields into scope", {
  env := empty_env();
  // Build a module body that exports x = 10 and y = false
  define_x := make_infix(":=", make_ident("x"), make_atom(TokenKind.Integer, "10"));
  define_y := make_infix(":=", make_ident("y"), make_atom(TokenKind.Bool, "false"));
  export_names := ArrayList(str).new();
  export_names.push("x");
  export_names.push("y");
  export_expr := make_export(export_names);
  exprs := ArrayList(AstExpr).new();
  exprs.push(define_x);
  exprs.push(define_y);
  exprs.push(export_expr);
  mod_env := empty_env();
  mod_val_opt := evaluate_module_body(exprs, &mod_env);
  assert(match(mod_val_opt, .Some(_) => true, .None => false), "module body evaluated");
  // Bind the module into a variable, then open it
  mod_val := match(mod_val_opt, .Some(v) => v, .None => EvalValue.UnitVal);
  _def := env.define_val(String.from("m"), t_i32(), true, .Some(mod_val));
  open_expr := make_open(make_ident("m"));
  open_res := evaluate(open_expr, &env);
  check_some(open_res, "open returned Some");
  // Now x and y should be in scope
  x_res := evaluate(make_ident("x"), &env);
  y_res := evaluate(make_ident("y"), &env);
  check_some(x_res, "x is in scope after open");
  check_some(y_res, "y is in scope after open");
  match(x_res,
    .Some(xr) => assert((xr.value == EvalValue.IntLit(String.from("10"))), "x == 10"),
    .None => ()
  );
  match(y_res,
    .Some(yr) => assert((yr.value == EvalValue.BoolVal(false)), "y == false"),
    .None => ()
  );
};

test "evaluate: { A, B } :: ModuleVal destructures correctly", {
  env := empty_env();
  // Build a module val with exports a = 1, b = 2
  define_a := make_infix(":=", make_ident("a"), make_atom(TokenKind.Integer, "1"));
  define_b := make_infix(":=", make_ident("b"), make_atom(TokenKind.Integer, "2"));
  export_names := ArrayList(str).new();
  export_names.push("a");
  export_names.push("b");
  export_expr := make_export(export_names);
  exprs := ArrayList(AstExpr).new();
  exprs.push(define_a);
  exprs.push(define_b);
  exprs.push(export_expr);
  mod_env := empty_env();
  mod_val_opt := evaluate_module_body(exprs, &mod_env);
  check_some_eval_val(mod_val_opt, "module body");
  mod_val := match(mod_val_opt, .Some(v) => v, .None => EvalValue.UnitVal);
  // Bind module as a constant and then destructure: { a, b } :: m
  _def := env.define_val(String.from("m"), t_i32(), true, .Some(mod_val));
  anon_tok := make_token(TokenKind.Identifier, BK_ANON_STRUCT);
  a_arg_list := ArrayList(AstExpr).new();
  a_arg_list.push(make_ident("a"));
  a_arg_list.push(make_ident("b"));
  lhs := (AstExpr).FnCall(usize(0), box(.Atom(usize(0), anon_tok)), a_arg_list, false, anon_tok);
  destr_expr := make_infix("::", lhs, make_ident("m"));
  destr_res := evaluate(destr_expr, &env);
  check_some(destr_res, "destructure result");
  // a and b should now be bound in env
  a_res := evaluate(make_ident("a"), &env);
  b_res := evaluate(make_ident("b"), &env);
  check_some(a_res, "a is bound after destructure");
  check_some(b_res, "b is bound after destructure");
  match(a_res,
    .Some(ar) => assert((ar.value == EvalValue.IntLit(String.from("1"))), "a == 1"),
    .None => ()
  );
  match(b_res,
    .Some(br) => assert((br.value == EvalValue.IntLit(String.from("2"))), "b == 2"),
    .None => ()
  );
};

test "evaluate: import uses module loader callback", {
  env := empty_env();
  // Register a mock loader that builds the module inline (no closure capture needed)
  set_module_loader((fn(path : String) -> Option(EvalValue))(
    cond(
      (path.as_str() == "test/my_module") => {
        mock_names_l := ArrayList(String).new();
        mock_names_l.push(String.from("val"));
        mock_vals_l := ArrayList(EvalValue).new();
        mock_vals_l.push(EvalValue.IntLit(String.from("77")));
        .Some(EvalValue.ModuleVal(mock_names_l, mock_vals_l))
      },
      true => Option(EvalValue).None
    )
  ));
  // Evaluate import("test/my_module") and check we get back the module
  import_expr := make_import_expr("test/my_module");
  result := evaluate(import_expr, &env);
  check_some(result, "import returned Some");
  match(result,
    .Some(r) =>
      match(r.value,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "module has 1 export");
          match(names.get(usize(0)),
            .Some(n) => assert((n.as_str() == "val"), "export name is val"),
            .None => assert(false, "missing export name")
          );
          match(vals.get(usize(0)),
            .Some(v) => assert((v == EvalValue.IntLit(String.from("77"))), "val == 77"),
            .None => assert(false, "missing export value")
          );
        },
        _ => assert(false, "expected ModuleVal from import")
      ),
    .None => ()
  );
};

