test "evaluate: struct construction Point(x: i32(1), y: i32(2))", {
  env := empty_env();
  one_args := ArrayList(AstExpr).new();
  one_args.push(make_atom(TokenKind.Integer, "1"));
  two_args := ArrayList(AstExpr).new();
  two_args.push(make_atom(TokenKind.Integer, "2"));
  x_arg := make_infix(":", make_ident("x"), make_call("i32", one_args));
  y_arg := make_infix(":", make_ident("y"), make_call("i32", two_args));
  call_a := ArrayList(AstExpr).new();
  call_a.push(x_arg);
  call_a.push(y_arg);
  result := evaluate(make_call("Point", call_a), &env);
  check_some(result, "Point(x:1,y:2)");
  match(result,
    .Some(r) => {
      fn_list := ArrayList(String).new();
      fn_list.push(String.from("x"));
      fn_list.push(String.from("y"));
      fv_list := ArrayList(EvalValue).new();
      fv_list.push(EvalValue.IntLit(String.from("1")));
      fv_list.push(EvalValue.IntLit(String.from("2")));
      expected := EvalValue.StructVal(String.from("Point"), fn_list, fv_list);
      assert((r.value == expected), "StructVal matches");
    },
    .None => ()
  );
};

