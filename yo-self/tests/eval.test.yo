test "Phase 5ds: fn returns bool from comparison", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "in_range := (fn(x : i32, lo : i32, hi : i32) -> bool)(((x >= lo) && (x <= hi))); r1 := in_range(i32(5), i32(1), i32(10)); r2 := in_range(i32(15), i32(1), i32(10)); export r1; export r2;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(2)), "2 exports");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(b, "5 in 1..10"),
            _ => assert(false, "r1 not BoolVal")
          ),
          .None => assert(false, "no r1")
        );
        match(vals.get(usize(1)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(!(b), "15 not in 1..10"),
            _ => assert(false, "r2 not BoolVal")
          ),
          .None => assert(false, "no r2")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

