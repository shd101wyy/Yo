test "Phase 5ff: Ackermann function", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "ackermann := (fn(m : i32, n : i32) -> i32)(cond((m == i32(0)) => (n + i32(1)), ((m > i32(0)) && (n == i32(0))) => recur((m - i32(1)), i32(1)), true => recur((m - i32(1)), recur(m, (n - i32(1))))));\nexport ackermann(i32(2), i32(3));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(_, vals) => match(vals.get(usize(0)),
