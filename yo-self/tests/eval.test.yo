test "evaluate_module_body: return early exit from function", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  // sign(n) returns -1/0/1 using early return
  src := "sign := (fn(n : i32) -> i32)({ if((n < i32(0)), { return i32(-1); }); if((n == i32(0)), { return i32(0); }); i32(1) }); r1 := sign(i32(-5)); r2 := sign(i32(0)); r3 := sign(i32(7)); export r1; export r2; export r3;";
  exprs := generate_exprs_from_code(src, using(exn));

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(3)), "3 exports");
          // r1 = sign(-5) = -1
          match(vals.get(usize(0)),
            .Some(v1) =>
              match(v1,
                .IntLit(raw) => assert((raw.as_str() == "-1"), "r1 is -1"),
                _ => assert(false, "r1 not IntLit")
              ),
            .None => assert(false, "no r1")
          );
          // r2 = sign(0) = 0
          match(vals.get(usize(1)),
            .Some(v2) =>
              match(v2,
                .IntLit(raw) => assert((raw.as_str() == "0"), "r2 is 0"),
                _ => assert(false, "r2 not IntLit")
              ),
            .None => assert(false, "no r2")
          );
          // r3 = sign(7) = 1
          match(vals.get(usize(2)),
            .Some(v3) =>
              match(v3,
                .IntLit(raw) => assert((raw.as_str() == "1"), "r3 is 1"),
                _ => assert(false, "r3 not IntLit")
              ),
            .None => assert(false, "no r3")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

