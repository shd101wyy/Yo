test "Phase 5ds: recursive digital root", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "sum_digits := (fn(n : i32) -> i32)(cond((n < i32(10)) => n, true => ((n % i32(10)) + recur((n / i32(10)))))); digital_root := (fn(n : i32) -> i32)({ (v : i32) = n; while((v >= i32(10)), { v = sum_digits(v); }); v }); r := digital_root(i32(9875)); export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
