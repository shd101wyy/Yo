// Phase 5ep: while loops and arithmetic
test "Phase 5ep: while loop count primes", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "is_prime := (fn(n : i32) -> bool)({ (d : i32) = i32(2); (result : bool) = cond((n < i32(2)) => false, true => true); while(((d * d) <= n), { result = cond(((n % d) == i32(0)) => false, true => result); d = (d + i32(1)); }); result }); count := { (c : i32) = i32(0); (i : i32) = i32(2); while((i <= i32(20)), { c = cond(is_prime(i) => (c + i32(1)), true => c); i = (i + i32(1)); }); c }; export count;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "8"), "8 primes <= 20"),
            _ => assert(false, "not IntLit")
          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

test "Phase 5ep: recursive count even digits", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "count_even := (fn(n : i32) -> i32)(cond((n == i32(0)) => i32(0), true => { digit := (n % i32(10)); inc := cond(((digit % i32(2)) == i32(0)) => i32(1), true => i32(0)); (inc + recur((n / i32(10)))) })); r := count_even(i32(24680)); export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "5"), "all 5 digits even"),
