// Phase 5bj: open import (merge module exports into scope)
test "Phase 5bj: open import merges into scope", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  // Set up a loader for "test/utils" with two exports
  set_module_loader((fn(path : String) -> Option(EvalValue))(
    cond(
      (path.as_str() == "test/utils") => {
        mod_names := ArrayList(String).new();
        mod_names.push(String.from("add"));
        mod_names.push(String.from("PI"));
        mod_vals := ArrayList(EvalValue).new();
        mod_vals.push(EvalValue.IntLit(String.from("0")));
        mod_vals.push(EvalValue.IntLit(String.from("314")));
        .Some(EvalValue.ModuleVal(mod_names, mod_vals))
      },
      true => Option(EvalValue).None
    )
  ));
  src := "open import \"test/utils\"; r := PI; export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "open import returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v, .IntLit(raw) => assert((raw.as_str() == "314"), "PI=314"), _ => assert(false, "not IntLit")),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

