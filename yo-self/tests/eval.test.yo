};

// Phase 5bg: comparison operators on integers
test "Phase 5bg: integer comparison chain", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "a := (i32(3) < i32(5)); b := (i32(5) <= i32(5)); c := (i32(7) > i32(3)); d := (i32(3) >= i32(4)); export a; export b; export c; export d;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "cmp returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(4)), "4 exports");
        match(vals.get(usize(0)), .Some(v) => match(v, .BoolVal(b) => assert(b, "3<5"), _ => assert(false, "a")), .None => assert(false, "a"));
        match(vals.get(usize(1)), .Some(v) => match(v, .BoolVal(b) => assert(b, "5<=5"), _ => assert(false, "b")), .None => assert(false, "b"));
        match(vals.get(usize(2)), .Some(v) => match(v, .BoolVal(b) => assert(b, "7>3"), _ => assert(false, "c")), .None => assert(false, "c"));
        match(vals.get(usize(3)), .Some(v) => match(v, .BoolVal(b) => assert((!b), "3>=4 false"), _ => assert(false, "d")), .None => assert(false, "d"));
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

