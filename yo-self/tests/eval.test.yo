// Phase 5dq: more boolean operations, enum chaining
test "Phase 5dq: nested boolean operations", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "a := true; b := false; c := true; r1 := ((a && c) || b); r2 := ((a || b) && (!(b))); export r1; export r2;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(2)), "2 exports");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(b, "(T&&T)||F = T"),
            _ => assert(false, "r1 not BoolVal")
          ),
          .None => assert(false, "no r1")
        );
        match(vals.get(usize(1)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(b, "(T||F)&&(!F) = T"),
            _ => assert(false, "r2 not BoolVal")
          ),
          .None => assert(false, "no r2")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

test "Phase 5dq: while loop binary search style", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "r := { (lo : i32) = i32(0); (hi : i32) = i32(100); while(((hi - lo) > i32(1)), { (mid : i32) = ((lo + hi) / i32(2)); cond(((mid * mid) <= i32(50)) => { lo = mid; }, true => { hi = mid; }); }); lo }; export r;";
  exprs := generate_exprs_from_code(src, using(exn));
