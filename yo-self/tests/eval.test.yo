test "Phase 5fb: multiple enum types", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "Color :: enum(Red, Green, Blue);\nDir :: enum(Up, Down, Left, Right);\nc := Color.Red;\nd := Dir.Left;\ncr := match(c, .Red => i32(1), .Green => i32(2), .Blue => i32(3));\ndr := match(d, .Up => i32(10), .Down => i32(20), .Left => i32(30), .Right => i32(40));\nr := (cr + dr);\nexport r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
