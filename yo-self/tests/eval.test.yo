    .Some(r) => match(r.value,
      .ArrayVal(items) => {
        assert((items.len() == usize(2)), "slice(1,3) should return 2 elements");
        match(items.get(usize(0)),
          .Some(v0) => match(v0, .IntLit(s0) => assert((s0.as_str() == "20"), "first is 20"), _ => assert(false, "not IntLit")),
          .None => assert(false, "no first")
        );
        match(items.get(usize(1)),
          .Some(v1) => match(v1, .IntLit(s1) => assert((s1.as_str() == "30"), "second is 30"), _ => assert(false, "not IntLit")),
          .None => assert(false, "no second")
        );
      },
      _ => assert(false, "expected ArrayVal")
    )
  );
};

