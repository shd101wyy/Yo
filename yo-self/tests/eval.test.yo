  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "(a : i32) = i32(1);\n(b : i32) = i32(1);\n(count : i32) = i32(2);\nwhile((b < i32(100)), {\nnext := (a + b);\na = b;\nb = next;\ncount = (count + i32(1));\n});\nexport b;\nexport count;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "144"), "first fib >= 100 is 144"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "12"), "12 fibs"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

