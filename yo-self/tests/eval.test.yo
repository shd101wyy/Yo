      fv_list.push(EvalValue.IntLit(String.from("1")));
      fv_list.push(EvalValue.IntLit(String.from("2")));
      expected := EvalValue.StructVal(String.from("Point"), fn_list, fv_list);
      assert((r.value == expected), "StructVal matches");
    },
    .None => ()
  );
};

