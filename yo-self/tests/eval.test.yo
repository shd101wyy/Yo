  // arr_al.all(pos)
  dot_tok := make_token(TokenKind.Dot, ".");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(make_atom(TokenKind.Identifier, "arr_al"));
  dot_args.push(make_atom(TokenKind.Identifier, "all"));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Identifier, "pos"));
  call_expr := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, dot_tok);
  result := evaluate(call_expr, &env);
  match(result,
    .None => assert(false, "all returned None"),
    .Some(r) =>
      match(r.value,
        .BoolVal(b) => assert((!(b)), "all should be false since -2 < 0"),
        _ => assert(false, "all should return BoolVal")
      )
  );
};

// Phase 5ai — ArrayVal.concat/reverse

test "Phase 5ai: ArrayVal.concat merges two arrays", {
  env := empty_env();
  // arr1 := [1, 2]
  arr1_items := ArrayList(AstExpr).new();
  arr1_items.push(make_atom(TokenKind.Integer, "1"));
  arr1_items.push(make_atom(TokenKind.Integer, "2"));
  arr1_tok := make_token(TokenKind.Identifier, BK_ARRAY_VAL);
  arr1_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), arr1_tok)), arr1_items, false, arr1_tok);
  def_arr1 := make_infix(":=", make_atom(TokenKind.Identifier, "arr1"), arr1_expr);
  _ := evaluate(def_arr1, &env);
  // arr2 := [3, 4]
  arr2_items := ArrayList(AstExpr).new();
  arr2_items.push(make_atom(TokenKind.Integer, "3"));
  arr2_items.push(make_atom(TokenKind.Integer, "4"));
  arr2_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), arr1_tok)), arr2_items, false, arr1_tok);
  def_arr2 := make_infix(":=", make_atom(TokenKind.Identifier, "arr2"), arr2_expr);
  _ := evaluate(def_arr2, &env);
  // arr1.concat(arr2)
  dot_tok := make_token(TokenKind.Dot, ".");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(make_atom(TokenKind.Identifier, "arr1"));
  dot_args.push(make_atom(TokenKind.Identifier, "concat"));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Identifier, "arr2"));
  call_expr := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, dot_tok);
  result := evaluate(call_expr, &env);
  match(result,
    .None => assert(false, "concat returned None"),
    .Some(r) =>
      match(r.value,
        .ArrayVal(items) => {
          assert((items.len() == usize(4)), "concat should produce 4 elements");
          match(items.get(usize(3)),
            .Some(v3) => match(v3, .IntLit(s) => assert((s.as_str() == "4"), "last should be 4"), _ => assert(false, "should be IntLit")),
            .None => assert(false, "missing elem 3")
          );
        },
        _ => assert(false, "concat should return ArrayVal")
      )
  );
};

test "Phase 5ai: ArrayVal.reverse reverses order", {
  env := empty_env();
  arr_items := ArrayList(AstExpr).new();
  arr_items.push(make_atom(TokenKind.Integer, "1"));
  arr_items.push(make_atom(TokenKind.Integer, "2"));
  arr_items.push(make_atom(TokenKind.Integer, "3"));
  arr_tok := make_token(TokenKind.Identifier, BK_ARRAY_VAL);
  arr_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), arr_tok)), arr_items, false, arr_tok);
  def_arr := make_infix(":=", make_atom(TokenKind.Identifier, "arr_rv"), arr_expr);
  _ := evaluate(def_arr, &env);
  // arr_rv.reverse()
  dot_tok := make_token(TokenKind.Dot, ".");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(make_atom(TokenKind.Identifier, "arr_rv"));
  dot_args.push(make_atom(TokenKind.Identifier, "reverse"));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_expr := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, dot_tok);
  result := evaluate(call_expr, &env);
  match(result,
    .None => assert(false, "reverse returned None"),
    .Some(r) =>
      match(r.value,
        .ArrayVal(items) => {
          assert((items.len() == usize(3)), "reverse should have 3 elements");
          match(items.get(usize(0)),
            .Some(v0) => match(v0, .IntLit(s) => assert((s.as_str() == "3"), "first should be 3 (reversed)"), _ => assert(false, "should be IntLit")),
            .None => assert(false, "missing elem 0")
          );
          match(items.get(usize(2)),
            .Some(v2) => match(v2, .IntLit(s) => assert((s.as_str() == "1"), "last should be 1 (reversed)"), _ => assert(false, "should be IntLit")),
            .None => assert(false, "missing elem 2")
          );
        },
        _ => assert(false, "reverse should return ArrayVal")
      )
  );
};

// Phase 5aj — tuple destructuring

test "Phase 5aj: tuple destructuring (a, b) := (1, 2)", {
  env := empty_env();
  // First create the tuple (1, 2)
  tup_args := ArrayList(AstExpr).new();
  tup_args.push(make_atom(TokenKind.Integer, "1"));
  tup_args.push(make_atom(TokenKind.Integer, "2"));
  tup_tok := make_token(TokenKind.Identifier, BK_TUPLE);
  tup_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), tup_tok)), tup_args, false, tup_tok);
  // LHS: (a, b)
  lhs_args := ArrayList(AstExpr).new();
  lhs_args.push(make_atom(TokenKind.Identifier, "a"));
  lhs_args.push(make_atom(TokenKind.Identifier, "b"));
  lhs_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), tup_tok)), lhs_args, false, tup_tok);
  // (a, b) := (1, 2)
  def_expr := make_infix(":=", lhs_expr, tup_expr);
  _ := evaluate(def_expr, &env);
  // Check a == 1
  result_a := evaluate(make_atom(TokenKind.Identifier, "a"), &env);
  match(result_a,
    .None => assert(false, "a not found"),
    .Some(r) => match(r.value, .IntLit(v) => assert((v.as_str() == "1"), "a should be 1"), _ => assert(false, "a should be IntLit"))
  );
  // Check b == 2
  result_b := evaluate(make_atom(TokenKind.Identifier, "b"), &env);
  match(result_b,
    .None => assert(false, "b not found"),
    .Some(r) => match(r.value, .IntLit(v) => assert((v.as_str() == "2"), "b should be 2"), _ => assert(false, "b should be IntLit"))
  );
};

test "Phase 5aj: tuple destructuring with wildcard (_, b) := (1, 2)", {
  env := empty_env();
  tup_args := ArrayList(AstExpr).new();
  tup_args.push(make_atom(TokenKind.Integer, "10"));
  tup_args.push(make_atom(TokenKind.Integer, "20"));
  tup_tok := make_token(TokenKind.Identifier, BK_TUPLE);
  tup_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), tup_tok)), tup_args, false, tup_tok);
  lhs_args := ArrayList(AstExpr).new();
  lhs_args.push(make_atom(TokenKind.Identifier, "_"));
  lhs_args.push(make_atom(TokenKind.Identifier, "b2"));
  lhs_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), tup_tok)), lhs_args, false, tup_tok);
  def_expr := make_infix(":=", lhs_expr, tup_expr);
  _ := evaluate(def_expr, &env);
  // b2 should be 20, _ should not be defined (wildcard)
  result_b := evaluate(make_atom(TokenKind.Identifier, "b2"), &env);
  match(result_b,
    .None => assert(false, "b2 not found"),
    .Some(r) => match(r.value, .IntLit(v) => assert((v.as_str() == "20"), "b2 should be 20"), _ => assert(false, "b2 should be IntLit"))
  );
};

