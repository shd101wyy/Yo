// Phase 5ag — ArrayVal.map/filter with FuncVal

test "Phase 5ag: ArrayVal.map doubles each element", {
  env := empty_env();
  // Define double := (x) => x * 2
  // x * 2 as infix AST:
  double_body := make_infix("*", make_atom(TokenKind.Identifier, "x"), make_atom(TokenKind.Integer, "2"));
  // (x) => double_body
  double_lam := make_infix("=>", make_atom(TokenKind.Identifier, "x"), double_body);
  def_double := make_infix(":=", make_atom(TokenKind.Identifier, "double"), double_lam);
  _ := evaluate(def_double, &env);
  // Define arr := [1, 2, 3]
  arr_items := ArrayList(AstExpr).new();
  arr_items.push(make_atom(TokenKind.Integer, "1"));
  arr_items.push(make_atom(TokenKind.Integer, "2"));
  arr_items.push(make_atom(TokenKind.Integer, "3"));
  arr_tok := make_token(TokenKind.Identifier, BK_ARRAY_VAL);
  arr_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), arr_tok)), arr_items, false, arr_tok);
  def_arr := make_infix(":=", make_atom(TokenKind.Identifier, "arr_m"), arr_expr);
  _ := evaluate(def_arr, &env);
  // arr_m.map(double)
  dot_tok := make_token(TokenKind.Dot, ".");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(make_atom(TokenKind.Identifier, "arr_m"));
  dot_args.push(make_atom(TokenKind.Identifier, "map"));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Identifier, "double"));
  call_expr := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, dot_tok);
  result := evaluate(call_expr, &env);
  match(result,
    .None => assert(false, "map returned None"),
    .Some(r) =>
      match(r.value,
        .ArrayVal(items) => {
          assert((items.len() == usize(3)), "map should produce 3 elements");
          match(items.get(usize(0)),
            .Some(v0) => match(v0, .IntLit(s) => assert((s.as_str() == "2"), "first should be 2"), _ => assert(false, "should be IntLit")),
            .None => assert(false, "missing elem 0")
          );
          match(items.get(usize(2)),
            .Some(v2) => match(v2, .IntLit(s) => assert((s.as_str() == "6"), "third should be 6"), _ => assert(false, "should be IntLit")),
            .None => assert(false, "missing elem 2")
          );
        },
        _ => assert(false, "map should return ArrayVal")
      )
  );
};

test "Phase 5ag: ArrayVal.filter keeps evens", {
  env := empty_env();
  // Define is_even := (x) => (x % 2) == 0
  mod_expr := make_infix("%", make_atom(TokenKind.Identifier, "x"), make_atom(TokenKind.Integer, "2"));
  eq_expr := make_infix("==", mod_expr, make_atom(TokenKind.Integer, "0"));
  even_lam := make_infix("=>", make_atom(TokenKind.Identifier, "x"), eq_expr);
  def_even := make_infix(":=", make_atom(TokenKind.Identifier, "is_even"), even_lam);
  _ := evaluate(def_even, &env);
  // Define arr := [1, 2, 3, 4, 5]
  arr_items := ArrayList(AstExpr).new();
  arr_items.push(make_atom(TokenKind.Integer, "1"));
  arr_items.push(make_atom(TokenKind.Integer, "2"));
  arr_items.push(make_atom(TokenKind.Integer, "3"));
  arr_items.push(make_atom(TokenKind.Integer, "4"));
  arr_items.push(make_atom(TokenKind.Integer, "5"));
  arr_tok := make_token(TokenKind.Identifier, BK_ARRAY_VAL);
  arr_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), arr_tok)), arr_items, false, arr_tok);
  def_arr := make_infix(":=", make_atom(TokenKind.Identifier, "arr_f"), arr_expr);
  _ := evaluate(def_arr, &env);
  // arr_f.filter(is_even)
  dot_tok := make_token(TokenKind.Dot, ".");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(make_atom(TokenKind.Identifier, "arr_f"));
  dot_args.push(make_atom(TokenKind.Identifier, "filter"));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Identifier, "is_even"));
  call_expr := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, dot_tok);
  result := evaluate(call_expr, &env);
  match(result,
    .None => assert(false, "filter returned None"),
    .Some(r) =>
      match(r.value,
        .ArrayVal(items) => {
          assert((items.len() == usize(2)), "filter should keep 2 evens");
          match(items.get(usize(0)),
            .Some(v0) => match(v0, .IntLit(s) => assert((s.as_str() == "2"), "first even should be 2"), _ => assert(false, "should be IntLit")),
            .None => assert(false, "missing elem 0")
          );
          match(items.get(usize(1)),
            .Some(v1) => match(v1, .IntLit(s) => assert((s.as_str() == "4"), "second even should be 4"), _ => assert(false, "should be IntLit")),
            .None => assert(false, "missing elem 1")
          );
        },
        _ => assert(false, "filter should return ArrayVal")
      )
  );
};

// Phase 5ah — ArrayVal.fold/any/all

test "Phase 5ah: ArrayVal.fold sum", {
  env := empty_env();
  // add := (acc, x) => acc + x
  add_body := make_infix("+", make_atom(TokenKind.Identifier, "acc"), make_atom(TokenKind.Identifier, "x"));
  tup_tok := make_token(TokenKind.Identifier, BK_TUPLE);
  param_args := ArrayList(AstExpr).new();
  param_args.push(make_atom(TokenKind.Identifier, "acc"));
  param_args.push(make_atom(TokenKind.Identifier, "x"));
  params := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), tup_tok)), param_args, false, tup_tok);
  add_lam := make_infix("=>", params, add_body);
  def_add := make_infix(":=", make_atom(TokenKind.Identifier, "add_fn"), add_lam);
  _ := evaluate(def_add, &env);
  // arr := [1, 2, 3, 4]
  arr_items := ArrayList(AstExpr).new();
  arr_items.push(make_atom(TokenKind.Integer, "1"));
  arr_items.push(make_atom(TokenKind.Integer, "2"));
  arr_items.push(make_atom(TokenKind.Integer, "3"));
  arr_items.push(make_atom(TokenKind.Integer, "4"));
  arr_tok := make_token(TokenKind.Identifier, BK_ARRAY_VAL);
  arr_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), arr_tok)), arr_items, false, arr_tok);
  def_arr := make_infix(":=", make_atom(TokenKind.Identifier, "arr_fo"), arr_expr);
  _ := evaluate(def_arr, &env);
  // arr_fo.fold(0, add_fn)
  dot_tok := make_token(TokenKind.Dot, ".");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(make_atom(TokenKind.Identifier, "arr_fo"));
  dot_args.push(make_atom(TokenKind.Identifier, "fold"));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, "0"));
  call_args.push(make_atom(TokenKind.Identifier, "add_fn"));
  call_expr := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, dot_tok);
  result := evaluate(call_expr, &env);
  match(result,
    .None => assert(false, "fold returned None"),
    .Some(r) =>
      match(r.value,
        .IntLit(v) => assert((v.as_str() == "10"), "sum of 1+2+3+4 should be 10"),
        _ => assert(false, "fold should return IntLit")
      )
  );
};

test "Phase 5ah: ArrayVal.any returns true when match found", {
  env := empty_env();
  // gt3 := (x) => x > 3
  gt_body := make_infix(">", make_atom(TokenKind.Identifier, "x"), make_atom(TokenKind.Integer, "3"));
  gt_lam := make_infix("=>", make_atom(TokenKind.Identifier, "x"), gt_body);
  def_gt := make_infix(":=", make_atom(TokenKind.Identifier, "gt3"), gt_lam);
  _ := evaluate(def_gt, &env);
  // arr := [1, 2, 5]
  arr_items := ArrayList(AstExpr).new();
  arr_items.push(make_atom(TokenKind.Integer, "1"));
  arr_items.push(make_atom(TokenKind.Integer, "2"));
  arr_items.push(make_atom(TokenKind.Integer, "5"));
  arr_tok := make_token(TokenKind.Identifier, BK_ARRAY_VAL);
  arr_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), arr_tok)), arr_items, false, arr_tok);
  def_arr := make_infix(":=", make_atom(TokenKind.Identifier, "arr_an"), arr_expr);
  _ := evaluate(def_arr, &env);
  // arr_an.any(gt3)
  dot_tok := make_token(TokenKind.Dot, ".");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(make_atom(TokenKind.Identifier, "arr_an"));
  dot_args.push(make_atom(TokenKind.Identifier, "any"));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Identifier, "gt3"));
  call_expr := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, dot_tok);
  result := evaluate(call_expr, &env);
  match(result,
    .None => assert(false, "any returned None"),
    .Some(r) =>
      match(r.value,
        .BoolVal(b) => assert(b, "any should be true since 5 > 3"),
        _ => assert(false, "any should return BoolVal")
      )
  );
};

test "Phase 5ah: ArrayVal.all returns false when not all match", {
  env := empty_env();
  // pos := (x) => x > 0
  pos_body := make_infix(">", make_atom(TokenKind.Identifier, "x"), make_atom(TokenKind.Integer, "0"));
  pos_lam := make_infix("=>", make_atom(TokenKind.Identifier, "x"), pos_body);
