  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "nums := [i32(1), i32(2), i32(3)]; (total : i32) = i32(0); for(n, nums, { total = (total + n); }); export total;";
  exprs := generate_exprs_from_code(src, using(exn));
