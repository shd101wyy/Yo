          assert((fvals.len() == usize(3)), "tuple should have 3 fields");
          match(fvals.get(usize(0)),
            .Some(v0) => match(v0, .IntLit(s) => assert((s.as_str() == "1"), "first elem should be 1"), _ => assert(false, "elem 0 should be IntLit")),
            .None => assert(false, "should have elem 0")
          );
        },
        _ => assert(false, "tuple should return StructVal")
      )
  );
};

