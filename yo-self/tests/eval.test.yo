test "evaluate: comptime(Name) param extracted in fn def", {
  env := empty_env();
  // Build param: `comptime(T) : Type` (infix colon with comptime(T) as name)
  ct_inner_args := ArrayList(AstExpr).new();
  ct_inner_args.push(make_ident("T"));
  ct_param_name := (AstExpr).FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "comptime"))),
    ct_inner_args,
    false,
    make_token(TokenKind.Identifier, "comptime")
  );
  colon_args := ArrayList(AstExpr).new();
  colon_args.push(ct_param_name);
  colon_args.push(make_ident("Type"));
  colon_param := (AstExpr).FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Operator, ":"))),
    colon_args,
    true,
    make_token(TokenKind.Operator, ":")
  );
  // Build (fn(colon_param) -> unit)(T) — body just returns T
  param_list := ArrayList(AstExpr).new();
  param_list.push(colon_param);
  fn_head := (AstExpr).FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "fn"))),
    param_list,
    false,
    make_token(TokenKind.Identifier, "fn")
  );
  arrow_args := ArrayList(AstExpr).new();
  arrow_args.push(fn_head);
  arrow_args.push(make_ident("unit"));
  fn_sig := (AstExpr).FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Operator, "->"))),
    arrow_args,
    true,
    make_token(TokenKind.Operator, "->")
  );
  outer_args := ArrayList(AstExpr).new();
  outer_args.push(make_ident("T"));
  fn_def := (AstExpr).FnCall(usize(0), box(fn_sig), outer_args, false, make_token(TokenKind.Operator, "->"));
  // f := fn_def
  _d := evaluate(make_infix(":=", make_ident("f"), fn_def), &env);
  // Call f(3) — T should be bound to IntLit("3"), body returns T
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, "3"));
  result := evaluate(make_call("f", call_args), &env);
  check_some(result, "comptime param call");
  match(result,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("3"))), "f(3)=3"),
    .None => ()
  );
};

// ---------------------------------------------------------------------------
// Phase 3o — evidence params / using(name : Type) / evidence passing
// ---------------------------------------------------------------------------

/// Build `using(inner_expr)` call — used both for param declarations and
/// call-site evidence passing.
make_using_call :: (fn(inner : AstExpr) -> AstExpr)({
  ua := ArrayList(AstExpr).new();
  ua.push(inner);
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "using"))),
    ua,
    false,
    make_token(TokenKind.Identifier, "using")
  )
});

/// Build `using(name : Type)` param for a function definition.
make_using_param :: (fn(name : str, type_name : str) -> AstExpr)({
  ca := ArrayList(AstExpr).new();
  ca.push(make_ident(name));
  ca.push(make_ident(type_name));
  colon_expr := (AstExpr).FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Operator, ":"))),
    ca,
    true,
    make_token(TokenKind.Operator, ":")
  );
  make_using_call(colon_expr)
});

/// Build `(fn(params…) -> ret_type)(body)` function definition expression.
make_typed_fn_def :: (fn(
  fn_params : ArrayList(AstExpr),
  ret_type  : AstExpr,
  body      : AstExpr
) -> AstExpr)({
  fn_head := (AstExpr).FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "fn"))),
    fn_params,
    false,
    make_token(TokenKind.Identifier, "fn")
  );
  arr_a := ArrayList(AstExpr).new();
  arr_a.push(fn_head);
  arr_a.push(ret_type);
  fn_sig := (AstExpr).FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Operator, "->"))),
    arr_a,
    true,
    make_token(TokenKind.Operator, "->")
  );
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  (AstExpr).FnCall(usize(0), box(fn_sig), body_args, false, make_token(TokenKind.Operator, "->"))
});

test "evaluate: using param is extracted into FuncVal.evidence_params", {
  env := empty_env();
  // Build (fn(using(ev : bool)) -> bool)(ev)
  params_e := ArrayList(AstExpr).new();
  params_e.push(make_using_param("ev", "bool"));
  fn_def_e := make_typed_fn_def(params_e, make_ident("bool"), make_ident("ev"));
  // f := fn_def_e
  _d := evaluate(make_infix(":=", make_ident("f"), fn_def_e), &env);
  // Look up f — FuncVal should have evidence_params=["ev"], params=[]
  f_var := env.lookup(String.from("f"));
  match(f_var,
    .Some(v) => match(v.value,
      .Some(fval) => match(fval,
        .FuncVal(_, ps, _, ev_ps, _, _, _, _, _) => {
          assert((ps.len() == usize(0)), "no regular params");
          assert((ev_ps.len() == usize(1)), "1 evidence param");
          match(ev_ps.get(usize(0)),
            .Some(evn) => assert((evn.as_str() == "ev"), "evidence name is ev"),
            .None => assert(false, "no evidence name")
          );
        },
        _ => assert(false, "expected FuncVal")
      ),
      .None => assert(false, "no value")
    ),
    .None => assert(false, "f not found")
  );
};

test "evaluate: using(name) at call site evaluates to bound value", {
  env := empty_env();
  // Bind: my_ev = BoolVal(false)
  _d := env.define_val(String.from("my_ev"), t_bool(), true, .Some(EvalValue.BoolVal(false)));
  // Evaluate using(my_ev) — should look up my_ev and return BoolVal(false)
  result := evaluate(make_using_call(make_ident("my_ev")), &env);
  check_some(result, "using(my_ev)");
  match(result,
    .Some(r) => assert((r.value == EvalValue.BoolVal(false)), "using(my_ev)=false"),
    .None => ()
  );
};

test "evaluate: evidence param is in scope inside function body", {
  env := empty_env();
  // Bind: ev_val = BoolVal(true)
  _dv := env.define_val(String.from("ev_val"), t_bool(), true, .Some(EvalValue.BoolVal(true)));
  // Build (fn(using(ev : bool)) -> bool)(ev) — body returns ev
  params_b := ArrayList(AstExpr).new();
  params_b.push(make_using_param("ev", "bool"));
  fn_def_b := make_typed_fn_def(params_b, make_ident("bool"), make_ident("ev"));
  // f := fn_def_b
  _d := evaluate(make_infix(":=", make_ident("f"), fn_def_b), &env);
  // Call f(using(ev_val)) — evidence passes BoolVal(true) as ev
  call_args_b := ArrayList(AstExpr).new();
  call_args_b.push(make_using_call(make_ident("ev_val")));
  result := evaluate(make_call("f", call_args_b), &env);
  check_some(result, "evidence in body");
  match(result,
    .Some(r) => assert((r.value == EvalValue.BoolVal(true)), "ev=true in body"),
    .None => ()
  );
};

test "evaluate: evidence param passed alongside regular params", {
  env := empty_env();
  // Bind: factor = IntLit("3")
  _dv := env.define_val(String.from("factor"), t_comptime_int(), true, .Some(EvalValue.IntLit(String.from("3"))));
  // Build (fn(x : i32, using(m : i32)) -> i32)(x * m)
  colon_x := make_infix(":", make_ident("x"), make_ident("i32"));
  params_m := ArrayList(AstExpr).new();
  params_m.push(colon_x);
  params_m.push(make_using_param("m", "i32"));
  fn_def_m := make_typed_fn_def(params_m, make_ident("i32"), make_infix("*", make_ident("x"), make_ident("m")));
  _d := evaluate(make_infix(":=", make_ident("mul"), fn_def_m), &env);
  // Call mul(5, using(factor)) — x=5, m=3 → 15
  call_args_m := ArrayList(AstExpr).new();
  call_args_m.push(make_atom(TokenKind.Integer, "5"));
  call_args_m.push(make_using_call(make_ident("factor")));
  result := evaluate(make_call("mul", call_args_m), &env);
  check_some(result, "mul with evidence");
  match(result,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("15"))), "5*3=15"),
    .None => ()
  );
};

test "evaluate: function with only using params (no regular params)", {
  env := empty_env();
  // Bind: my_flag = BoolVal(true)
  _dv := env.define_val(String.from("my_flag"), t_bool(), true, .Some(EvalValue.BoolVal(true)));
  // Build (fn(using(flag : bool)) -> bool)({ flag })
  params_f2 := ArrayList(AstExpr).new();
  params_f2.push(make_using_param("flag", "bool"));
  stmts_f2 := ArrayList(AstExpr).new();
  stmts_f2.push(make_ident("flag"));
  fn_def_f2 := make_typed_fn_def(params_f2, make_ident("bool"), make_begin(stmts_f2));
  _d := evaluate(make_infix(":=", make_ident("get_flag"), fn_def_f2), &env);
  // Call get_flag(using(my_flag))
  call_args_f2 := ArrayList(AstExpr).new();
  call_args_f2.push(make_using_call(make_ident("my_flag")));
  result := evaluate(make_call("get_flag", call_args_f2), &env);
  check_some(result, "only-evidence call");
  match(result,
    .Some(r) => assert((r.value == EvalValue.BoolVal(true)), "flag=true"),
    .None => ()
  );
};

// ---------------------------------------------------------------------------
// Phase 3 Validation Milestone — evaluate a simple hello_world-style module
//
// Constructs the AST for:
//   main :: (fn(using(io : IO)) -> unit)({ io; });
//   export main;
// and verifies evaluate_module_body produces a ModuleVal exporting a FuncVal
// with evidence_params=["io"] and no regular params.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Phase 2bk — anonymous struct literal evaluation
// ---------------------------------------------------------------------------

test "evaluate: anonymous struct literal _(x: 42, y: true)", {
  env := empty_env();

  // Build: _(x: 42, y: true)
  //   = FnCall(Atom("_"), [infix ":" (Atom("x"), Atom("42")), infix ":" (Atom("y"), Atom("true"))], false)
  field_x := make_infix(":", make_ident("x"), make_atom(TokenKind.Integer, "42"));
  field_y := make_infix(":", make_ident("y"), make_atom(TokenKind.Bool, "true"));
  as_args := ArrayList(AstExpr).new();
  as_args.push(field_x);
  as_args.push(field_y);
  anon_struct_expr := make_call(BK_ANON_STRUCT, as_args);

  result := evaluate(anon_struct_expr, &env);

  match(result,
    .None => assert(false, "evaluate returned None for anonymous struct"),
    .Some(res) => match(res.value,
      .StructVal(_, field_names, field_vals) => {
        assert((field_names.len() == usize(2)), "struct has 2 fields");
        assert((field_vals.len()  == usize(2)), "struct has 2 values");
        match(field_names.get(usize(0)),
          .Some(n) => assert((n.as_str() == "x"), "first field is x"),
          .None    => assert(false, "no first field name")
        );
        match(field_names.get(usize(1)),
          .Some(n) => assert((n.as_str() == "y"), "second field is y"),
          .None    => assert(false, "no second field name")
        );
        match(field_vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(raw) => assert((raw.as_str() == "42"), "x value is 42"),
            _ => assert(false, "x value is not IntLit")
          ),
          .None => assert(false, "no x value")
        );
        match(field_vals.get(usize(1)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(b, "y value is true"),
            _ => assert(false, "y value is not BoolVal")
          ),
          .None => assert(false, "no y value")
        );
      },
      _ => assert(false, "result is not StructVal")
    )
  );
};

test "evaluate: anonymous struct shorthand _(val) — unlabeled field", {
  env := empty_env();

  // Build: _(42)  — positional/unlabeled single field
  pos_args := ArrayList(AstExpr).new();
  pos_args.push(make_atom(TokenKind.Integer, "42"));
  anon_expr := make_call(BK_ANON_STRUCT, pos_args);

  result := evaluate(anon_expr, &env);

  match(result,
    .None => assert(false, "evaluate returned None for unlabeled anon struct"),
    .Some(res) => match(res.value,
      .StructVal(_, names, vals) => {
        assert((names.len() == usize(1)), "struct has 1 field");
        assert((vals.len()  == usize(1)), "struct has 1 value");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(raw) => assert((raw.as_str() == "42"), "field value is 42"),
            _ => assert(false, "field value is not IntLit")
          ),
          .None => assert(false, "no field value")
        );
      },
      _ => assert(false, "result is not StructVal")
    )
  );
};

test "validation milestone: evaluate hello_world module", {
  env := empty_env();

  // ── Build the function definition: (fn(using(io : IO)) -> unit)({ io; }) ──
  params_hw := ArrayList(AstExpr).new();
  params_hw.push(make_using_param("io", "IO"));
  stmts_hw := ArrayList(AstExpr).new();
  stmts_hw.push(make_ident("io"));
  fn_def_hw := make_typed_fn_def(params_hw, make_ident("unit"), make_begin(stmts_hw));

  // ── Build: main :: fn_def_hw (infix ::) ──
  bind_main := make_infix("::", make_ident("main"), fn_def_hw);

  // ── Build: export main; ──
  export_names_hw := ArrayList(str).new();
  export_names_hw.push("main");
  export_main_hw := make_export(export_names_hw);

  // ── Assemble the module body ──
  module_exprs := ArrayList(AstExpr).new();
  module_exprs.push(bind_main);
  module_exprs.push(export_main_hw);

  // ── Evaluate the module ──
  result := evaluate_module_body(module_exprs, &env);

  // ── Verify the result is a ModuleVal exporting "main" as a FuncVal ──
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(mod_names, mod_values) => {
          assert((mod_names.len() == usize(1)), "exactly 1 export");
          match(mod_names.get(usize(0)),
            .Some(n) => assert((n.as_str() == "main"), "exported name is main"),
            .None    => assert(false, "no exported name")
          );
          match(mod_values.get(usize(0)),
            .Some(fn_val) => match(fn_val,
              .FuncVal(_, ps, _, ev_ps, _, _, _, _, _) => {
                assert((ps.len() == usize(0)), "main has no regular params");
                assert((ev_ps.len() == usize(1)), "main has 1 evidence param");
                match(ev_ps.get(usize(0)),
                  .Some(evn) => assert((evn.as_str() == "io"), "evidence param is io"),
                  .None      => assert(false, "no evidence param name")
                );
              },
              _ => assert(false, "exported main is not a FuncVal")
            ),
            .None => assert(false, "no exported value")
          );
        },
        _ => assert(false, "result is not a ModuleVal")
      )
  );
};

// ---------------------------------------------------------------------------
// Phase 3z — Type definition keyword handlers
// (enum, struct, object, newtype, union, trait)
// ---------------------------------------------------------------------------

/// Helper: build a fresh env with `T` bound to `TypeVal(i32)`.
make_env_with_T :: (fn() -> Environment)({
  env := Environment.new(`T_env`);
  (ti32 : TypeValue) = t_i32();
  _ := (&env).define_val(
    String.from("T"),
    t_type(),
    true,
    .Some(.TypeVal(box(ti32)))
  );
  env
});

test "evaluate: enum(None, Some(value: T)) creates EnumT TypeVal", {
  env      := make_env_with_T();
  env_ptr  := (&env);

  none_expr := make_ident("None");
  val_field := make_labeled_field("value", make_ident("T"));
  some_args := ArrayList(AstExpr).new();
  some_args.push(val_field);
  some_expr := make_variant("Some", some_args);

  type_args := ArrayList(AstExpr).new();
  type_args.push(none_expr);
  type_args.push(some_expr);
  expr := make_typedef_call(BK_ENUM, type_args);

  result := evaluate(expr, env_ptr);
  check_some(result, "enum(...) should return Some");
  match(result,
    .Some(r) => {
      assert((type_value_tag(r.ty) == TypeTag.TType), "result.ty should be TType");
      match(r.value,
        .TypeVal(tyb) =>
          match(tyb.*,
            .EnumT(_, _, vnames, vfields_all, _, _, _) => {
              assert((vnames.len() == usize(2)), "should have 2 variants");
              match(vnames.get(usize(0)), .Some(n) => assert((n.as_str() == "None"), "first variant is None"), .None => assert(false, "no variant 0"));
              match(vnames.get(usize(1)), .Some(n) => assert((n.as_str() == "Some"), "second variant is Some"), .None => assert(false, "no variant 1"));
              match(vfields_all.get(usize(0)), .Some(f) => assert((f.len() == usize(0)), "None has no fields"), .None => assert(false, "no fields 0"));
              match(vfields_all.get(usize(1)), .Some(f) => assert((f.len() == usize(1)), "Some has 1 field"), .None => assert(false, "no fields 1"));
            },
            _ => assert(false, "not an EnumT")
          ),
        _ => assert(false, "not a TypeVal")
      );
    },
    .None => ()
  );
};

test "evaluate: enum(Red, Green, Blue) plain fieldless variants", {
  env     := empty_env();
  env_ptr := (&env);

  type_args := ArrayList(AstExpr).new();
  type_args.push(make_ident("Red"));
  type_args.push(make_ident("Green"));
  type_args.push(make_ident("Blue"));
  expr := make_typedef_call(BK_ENUM, type_args);

  result := evaluate(expr, env_ptr);
  check_some(result, "plain enum");
  match(result,
    .Some(r) =>
      match(r.value,
        .TypeVal(tyb) =>
          match(tyb.*,
            .EnumT(_, _, vnames, _, _, _, vdiscs) => {
              assert((vnames.len() == usize(3)), "3 variants");
              assert((vdiscs.len() == usize(3)), "3 discriminants");
              match(vdiscs.get(usize(0)), .Some(d) => assert((d == i64(0)), "Red=0"), .None => assert(false, "no disc 0"));
              match(vdiscs.get(usize(1)), .Some(d) => assert((d == i64(1)), "Green=1"), .None => assert(false, "no disc 1"));
              match(vdiscs.get(usize(2)), .Some(d) => assert((d == i64(2)), "Blue=2"), .None => assert(false, "no disc 2"));
            },
            _ => assert(false, "not EnumT")
          ),
        _ => assert(false, "not TypeVal")
      ),
    .None => ()
  );
};

test "evaluate: struct(x: i32, y: bool) creates Struct TypeVal", {
  env     := empty_env();
  env_ptr := (&env);

  type_args := ArrayList(AstExpr).new();
  type_args.push(make_labeled_field("x", make_ident("i32")));
  type_args.push(make_labeled_field("y", make_ident("bool")));
  expr := make_typedef_call(BK_STRUCT, type_args);

  result := evaluate(expr, env_ptr);
  check_some(result, "struct");
  match(result,
    .Some(r) => {
      assert((type_value_tag(r.ty) == TypeTag.TType), "ty is TType");
      match(r.value,
        .TypeVal(tyb) =>
          match(tyb.*,
            .Struct(_, _, labels, types, is_ref_sem, _, is_newtype) => {
              assert((labels.len() == usize(2)), "2 fields");
              assert((!(is_ref_sem)), "not ref sem");
              assert((!(is_newtype)), "not newtype");
              match(labels.get(usize(0)), .Some(l) => assert((l.as_str() == "x"), "first field x"), .None => assert(false, "no label 0"));
              match(labels.get(usize(1)), .Some(l) => assert((l.as_str() == "y"), "second field y"), .None => assert(false, "no label 1"));
              match(types.get(usize(0)), .Some(t) => assert((type_value_tag(t) == TypeTag.TI32), "x:i32"), .None => assert(false, "no type 0"));
              match(types.get(usize(1)), .Some(t) => assert((type_value_tag(t) == TypeTag.TBool), "y:bool"), .None => assert(false, "no type 1"));
            },
            _ => assert(false, "not Struct")
          ),
        _ => assert(false, "not TypeVal")
      );
    },
    .None => ()
  );
};

test "evaluate: object(x: i32) creates Struct with is_reference_semantics=true", {
  env     := empty_env();
  env_ptr := (&env);

  type_args := ArrayList(AstExpr).new();
  type_args.push(make_labeled_field("x", make_ident("i32")));
  expr := make_typedef_call(BK_OBJECT, type_args);

  result := evaluate(expr, env_ptr);
  check_some(result, "object");
  match(result,
    .Some(r) =>
      match(r.value,
        .TypeVal(tyb) =>
          match(tyb.*,
            .Struct(_, _, _, _, is_ref_sem, _, is_newtype) => {
              assert(is_ref_sem, "object has reference semantics");
              assert((!(is_newtype)), "not newtype");
            },
            _ => assert(false, "not Struct")
          ),
        _ => assert(false, "not TypeVal")
      ),
    .None => ()
  );
};

test "evaluate: newtype(i32) creates Struct with is_newtype=true", {
  env     := empty_env();
  env_ptr := (&env);

  type_args := ArrayList(AstExpr).new();
  type_args.push(make_ident("i32"));
  expr := make_typedef_call(BK_NEWTYPE, type_args);

  result := evaluate(expr, env_ptr);
  check_some(result, "newtype");
  match(result,
    .Some(r) =>
      match(r.value,
        .TypeVal(tyb) =>
          match(tyb.*,
            .Struct(_, _, labels, types, is_ref_sem, _, is_newtype) => {
              assert((!(is_ref_sem)), "newtype is not ref sem");
              assert(is_newtype, "is_newtype is true");
              assert((labels.len() == usize(1)), "1 wrapped field");
              match(labels.get(usize(0)), .Some(l) => assert((l.as_str() == "*"), "field label is *"), .None => assert(false, "no label"));
              match(types.get(usize(0)), .Some(t) => assert((type_value_tag(t) == TypeTag.TI32), "wrapped type is i32"), .None => assert(false, "no type"));
            },
            _ => assert(false, "not Struct")
          ),
        _ => assert(false, "not TypeVal")
      ),
    .None => ()
  );
};

test "evaluate: union(x: i32, y: bool) creates Union TypeVal", {
  env     := empty_env();
  env_ptr := (&env);

  type_args := ArrayList(AstExpr).new();
  type_args.push(make_labeled_field("x", make_ident("i32")));
  type_args.push(make_labeled_field("y", make_ident("bool")));
