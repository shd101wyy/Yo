test "evaluate_module_body: boolean && short-circuit", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  src := "x := i32(5); r1 := ((x > i32(3)) && (x < i32(10))); r2 := ((x > i32(3)) && (x > i32(10))); export r1; export r2;";
  exprs := generate_exprs_from_code(src, using(exn));

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(2)), "2 exports");
          // r1: 5>3 && 5<10 = true
          match(vals.get(usize(0)),
            .Some(v1) =>
              match(v1,
                .BoolVal(b) => assert(b, "r1 is true"),
                _ => assert(false, "r1 not BoolVal")
              ),
            .None => assert(false, "no r1")
          );
          // r2: 5>3 && 5>10 = false
          match(vals.get(usize(1)),
            .Some(v2) =>
              match(v2,
                .BoolVal(b) => assert((!(b)), "r2 is false"),
                _ => assert(false, "r2 not BoolVal")
              ),
            .None => assert(false, "no r2")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

// ---------------------------------------------------------------------------
// Phase 3af — recur (recursive self-call), ||, multi-capture closures
// ---------------------------------------------------------------------------

test "evaluate_module_body: recur factorial(1) = 1", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  // Use recur for self-recursion. factorial(0)=1, factorial(1)=1.
  // Limited to fact(1) to stay safe under ASAN stack depth limits.
  src := "factorial := (fn(n : i32) -> i32)(cond((n <= i32(0)) => i32(1), true => (n * recur((n - i32(1)))))); result := factorial(i32(1)); export result;";
  exprs := generate_exprs_from_code(src, using(exn));

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "1 export");
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                // factorial(1) = 1*factorial(0) = 1*1 = 1
                .IntLit(raw) => assert((raw.as_str() == "1"), "result is 1"),
                _ => assert(false, "not IntLit")
              ),
            .None => assert(false, "no export value")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

test "evaluate_module_body: boolean || short-circuit", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  src := "x := i32(5); r1 := ((x < i32(3)) || (x > i32(4))); r2 := ((x < i32(3)) || (x > i32(10))); export r1; export r2;";
  exprs := generate_exprs_from_code(src, using(exn));

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(2)), "2 exports");
          // r1: 5<3 || 5>4 = false || true = true
          match(vals.get(usize(0)),
            .Some(v1) =>
              match(v1,
                .BoolVal(b) => assert(b, "r1 is true"),
                _ => assert(false, "r1 not BoolVal")
              ),
            .None => assert(false, "no r1")
          );
          // r2: 5<3 || 5>10 = false || false = false
          match(vals.get(usize(1)),
            .Some(v2) =>
              match(v2,
                .BoolVal(b) => assert((!(b)), "r2 is false"),
                _ => assert(false, "r2 not BoolVal")
              ),
            .None => assert(false, "no r2")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

