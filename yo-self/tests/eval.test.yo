test "evaluate: if true takes then branch", {
  env := empty_env();
  args := ArrayList(AstExpr).new();
  args.push(make_atom(TokenKind.Bool, "true"));
  args.push(make_atom(TokenKind.Integer, "42"));
  result := evaluate(make_call("if", args), &env);
  check_some(result, "if true then");
  match(result,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("42"))), "if(true,42)=42"),
    .None => ()
  );
};

