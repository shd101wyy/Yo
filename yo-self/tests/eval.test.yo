test "Phase 5ii: while loop GCD multiple numbers", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "gcd := (fn(a : i32, b : i32) -> i32)(cond((b == i32(0)) => a, true => recur(b, (a % b))));\nnums := [i32(48), i32(36), i32(60), i32(84)];\n(result : i32) = i32(48);\n(idx : i32) = i32(1);\nwhile((idx < i32(4)), {\nval := cond((idx == i32(1)) => i32(36), (idx == i32(2)) => i32(60), true => i32(84));\nresult = gcd(result, val);\nidx = (idx + i32(1));\n});\nexport result;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "12"), "GCD(48,36,60,84)=12"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

