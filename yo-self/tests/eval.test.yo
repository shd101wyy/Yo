test "Phase 3ap: while loop with break exits early", {
  src := "(i : i64) = i64(0); while runtime(true), { i = (i + i64(1)); cond((i >= i64(3)) => break(), true => ()); }; r :: i; export r;";
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  exprs := generate_exprs_from_code(src, using(exn));
