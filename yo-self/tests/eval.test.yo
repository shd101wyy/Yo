// ===========================================================================
// Phase 5s — Integration tests: for loop, array literal, given, string concat
// ===========================================================================

test "Phase 5s: array literal [1, 2, 3] produces ArrayVal with 3 elements", {
  // [1, 2, 3] → FnCall(Atom("array"), [IntLit(1), IntLit(2), IntLit(3)], false)
  env := empty_env();
  elems := ArrayList(AstExpr).new();
  elems.push(make_atom(TokenKind.Integer, "1"));
  elems.push(make_atom(TokenKind.Integer, "2"));
  elems.push(make_atom(TokenKind.Integer, "3"));
  arr_expr := AstExpr.FnCall(usize(0),
    box(make_atom(TokenKind.Identifier, BK_ARRAY_VAL)),
    elems,
    false,
    make_token(TokenKind.Identifier, BK_ARRAY_VAL)
  );
  result := evaluate(arr_expr, &env);
  match(result,
    .None => assert(false, "array literal returned None"),
    .Some(r) =>
      match(r.value,
        .ArrayVal(arr) => {
          assert((arr.len() == usize(3)), "array should have 3 elements");
          match(arr.get(usize(0)),
            .Some(v) => match(v, .IntLit(s) => assert((s.as_str() == "1"), "first elem should be 1"), _ => assert(false, "elem 0 not IntLit")),
            .None => assert(false, "elem 0 missing")
          );
          match(arr.get(usize(2)),
            .Some(v) => match(v, .IntLit(s) => assert((s.as_str() == "3"), "third elem should be 3"), _ => assert(false, "elem 2 not IntLit")),
            .None => assert(false, "elem 2 missing")
          );
        },
        _ => assert(false, "expected ArrayVal")
      )
  );
};

test "Phase 5s: for loop iterates over array elements", {
  // sum := 0; for(x, [1, 2, 3], { sum = sum + x; }); export sum;
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error in for test"); escape (); }));
  src := "sum := 0; arr := [1, 2, 3]; for(x, arr, { sum = (sum + x); }); export sum;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "for loop returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(_, vals) =>
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                .IntLit(raw) => assert((raw.as_str() == "6"), "sum should be 6"),
                _ => assert(false, "expected IntLit for sum")
              ),
            .None => assert(false, "no export value")
          ),
        _ => assert(false, "not ModuleVal")
      )
  );
};

test "Phase 5s: for loop with early return exits iteration", {
  // for(x, [10, 20, 30], { if((x == 20), return x); }); export 0;
  // → should return ReturnVal(IntLit("20"))
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error in for-return test"); escape (); }));
  src := "arr := [10, 20, 30]; result := for(x, arr, { if((x == 20), return x); }); export result;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "for-return returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(_, vals) =>
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                .ReturnVal(inner, _) =>
                  match(inner.*,
                    .IntLit(raw) => assert((raw.as_str() == "20"), "return value should be 20"),
                    _ => assert(false, "expected IntLit inside ReturnVal")
                  ),
                .IntLit(raw) => assert((raw.as_str() == "20"), "direct int should be 20"),
                _ => assert(false, "expected ReturnVal or IntLit")
              ),
            .None => assert(false, "no export value")
          ),
        _ => assert(false, "not ModuleVal")
      )
  );
};

test "Phase 5s: string concatenation with + operator", {
  // "hello" + " world" → StrLit("hello world")
  env := empty_env();
  str_plus := make_infix("+",
    make_atom(TokenKind.StringLit, "\"hello\""),
    make_atom(TokenKind.StringLit, "\" world\"")
  );
  result := evaluate(str_plus, &env);
  match(result,
    .None => assert(false, "string + returned None"),
    .Some(r) =>
      match(r.value,
        .StrLit(raw) => assert((raw.as_str() == "\"hello world\""), "concat should be hello world"),
        _ => assert(false, "expected StrLit from string +")
      )
  );
};

test "Phase 5s: given declaration binds value in env", {
  // given(handler) := SomeVal; — binds handler to SomeVal in env as comptime
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error in given test"); escape (); }));
  src := "given(h) := 42; export h;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "given test returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(_, vals) =>
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                .IntLit(raw) => assert((raw.as_str() == "42"), "given value should be 42"),
                _ => assert(false, "expected IntLit from given")
              ),
            .None => assert(false, "no export value")
          ),
        _ => assert(false, "not ModuleVal")
      )
  );
};

test "Phase 5s: for loop with break stops iteration", {
  // count := 0; for(x, [1,2,3,4,5], { if((x > 3), break()); count = (count + 1); }); export count;
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error in for-break test"); escape (); }));
  src := "count := 0; arr := [1, 2, 3, 4, 5]; for(x, arr, { if((x > 3), break()); count = (count + 1); }); export count;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "for-break returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(_, vals) =>
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                .IntLit(raw) => assert((raw.as_str() == "3"), "count should be 3 (break after x>3)"),
                _ => assert(false, "expected IntLit for count")
              ),
            .None => assert(false, "no export value")
          ),
        _ => assert(false, "not ModuleVal")
      )
  );
};

// ===========================================================================
// Phase 5t — Closure (=>) evaluation tests using raw AST construction
// (The self-hosted parser currently crashes on `=>` — see issues/parser-lambda-crash.md)
// ===========================================================================

test "Phase 5t: simple lambda (x) => x creates FuncVal", {
  // (x) => x → FnCall(Atom("=>"), [Atom("x"), Atom("x")], is_infix=true)
  env := empty_env();
  lambda := make_infix("=>", make_ident("x"), make_ident("x"));
  result := evaluate(lambda, &env);
  match(result,
    .None => assert(false, "lambda returned None"),
    .Some(r) =>
      match(r.value,
        .FuncVal(_, params, _, _, _, _, _, _, _) =>
          assert((params.len() == usize(1)), "lambda should have 1 param"),
        _ => assert(false, "expected FuncVal from lambda")
      )
  );
};

test "Phase 5t: multi-param lambda (x, y) => (x + y) creates FuncVal", {
  // Build: (x, y) => (x + y)
  // LHS is tuple(x, y): FnCall(Atom("tuple"), [Atom("x"), Atom("y")], false)
  env := empty_env();
  param_list := ArrayList(AstExpr).new();
  param_list.push(make_ident("x"));
  param_list.push(make_ident("y"));
  params_tuple := AstExpr.FnCall(usize(0),
    box(make_atom(TokenKind.Identifier, BK_TUPLE)),
    param_list,
    false,
    make_token(TokenKind.Identifier, BK_TUPLE)
  );
  body := make_infix("+", make_ident("x"), make_ident("y"));
  lambda := make_infix("=>", params_tuple, body);
  result := evaluate(lambda, &env);
  match(result,
    .None => assert(false, "multi lambda returned None"),
    .Some(r) =>
      match(r.value,
        .FuncVal(_, params, _, _, _, _, _, _, _) =>
          assert((params.len() == usize(2)), "lambda should have 2 params"),
        _ => assert(false, "expected FuncVal from multi-lambda")
      )
  );
};

test "Phase 5t: lambda captures outer variable", {
  // Define a := 10 in env, then create (x) => (x + a)
  // The closure should capture 'a' in its cap_vals
  env := empty_env();
  // First define 'a' in the env
  define_a := make_infix(":=",
    make_ident("a"),
    make_atom(TokenKind.Integer, "10")
  );
  _ := evaluate(define_a, &env);
  // Create lambda that references 'a'
  lambda := make_infix("=>", make_ident("x"), make_infix("+", make_ident("x"), make_ident("a")));
  result := evaluate(lambda, &env);
  match(result,
    .None => assert(false, "capture lambda returned None"),
    .Some(r) =>
      match(r.value,
        .FuncVal(_, params, _, _, _, cap_names, _, _, _) => {
          assert((params.len() == usize(1)), "lambda should have 1 param");
          assert((cap_names.len() > usize(0)), "lambda should capture at least 'a'");
        },
        _ => assert(false, "expected FuncVal with captures")
      )
  );
};

test "Phase 5t: lambda invocation returns computed result", {
  // Define: f := (x) => (x + 1), then call f(5) → should get 6
  env := empty_env();
  // f := (x) => (x + 1)
  lambda := make_infix("=>",
    make_ident("x"),
    make_infix("+", make_ident("x"), make_atom(TokenKind.Integer, "1"))
  );
  define_f := make_infix(":=", make_ident("f"), lambda);
  _ := evaluate(define_f, &env);
  // f(5)
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, "5"));
  call_f := AstExpr.FnCall(usize(0),
    box(make_ident("f")),
    call_args,
    false,
    make_token(TokenKind.Identifier, "f")
  );
  result := evaluate(call_f, &env);
  match(result,
    .None => assert(false, "lambda call returned None"),
    .Some(r) =>
      match(r.value,
        .IntLit(raw) => assert((raw.as_str() == "6"), "f(5) should be 6"),
        _ => assert(false, "expected IntLit from lambda call")
      )
  );
};

// ===========================================================================
// Phase 5u — continue keyword, assert, and comptime_assert
// ===========================================================================

test "Phase 5u: continue in while loop skips rest of body", {
  // sum = 0; i = 0; while (i < 5) { i = i + 1; if (i == 3) continue; sum = sum + i; }
  // Expected: sum = 1+2+4+5 = 12 (skips adding when i=3)
  env := empty_env();

  // sum := 0
  _ := evaluate(make_infix(":=", make_ident("sum"), make_atom(TokenKind.Integer, "0")), &env);
  // i := 0
  _ := evaluate(make_infix(":=", make_ident("i"), make_atom(TokenKind.Integer, "0")), &env);

  // Build: while((i < 5), { i = (i + 1); if((i == 3), continue); sum = (sum + i); })
  cond_expr := make_infix("<", make_ident("i"), make_atom(TokenKind.Integer, "5"));
  inc_i := make_infix("=", make_ident("i"), make_infix("+", make_ident("i"), make_atom(TokenKind.Integer, "1")));

  // if((i == 3), continue)
  if_args := ArrayList(AstExpr).new();
  if_args.push(make_infix("==", make_ident("i"), make_atom(TokenKind.Integer, "3")));
  if_args.push(make_fncall_atom("continue", ArrayList(AstExpr).new()));
  if_expr := make_fncall_atom("if", if_args);

  add_sum := make_infix("=", make_ident("sum"), make_infix("+", make_ident("sum"), make_ident("i")));

  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(inc_i);
  body_stmts.push(if_expr);
  body_stmts.push(add_sum);
  body_block := AstExpr.FnCall(usize(0),
    box(make_atom(TokenKind.Identifier, BK_BEGIN)),
    body_stmts,
    false,
    make_token(TokenKind.Identifier, BK_BEGIN)
  );

  while_args := ArrayList(AstExpr).new();
  while_args.push(cond_expr);
  while_args.push(body_block);
  while_expr := make_fncall_atom("while", while_args);

  _ := evaluate(while_expr, &env);

  // Check sum
  result := evaluate(make_ident("sum"), &env);
  match(result,
    .None => assert(false, "continue while returned None"),
    .Some(r) =>
      match(r.value,
        .IntLit(raw) => assert((raw.as_str() == "12"), "sum with continue should be 12"),
        _ => assert(false, "expected IntLit for sum")
      )
  );
};

test "Phase 5u: continue in for loop skips iteration", {
  // arr = [1,2,3,4,5]; sum = 0; for(item, arr, { if (item == 3) continue; sum = sum + item; })
  // Expected: sum = 1+2+4+5 = 12
  env := empty_env();

  // arr := [1,2,3,4,5]
  arr_elems := ArrayList(AstExpr).new();
  arr_elems.push(make_atom(TokenKind.Integer, "1"));
  arr_elems.push(make_atom(TokenKind.Integer, "2"));
  arr_elems.push(make_atom(TokenKind.Integer, "3"));
  arr_elems.push(make_atom(TokenKind.Integer, "4"));
  arr_elems.push(make_atom(TokenKind.Integer, "5"));
  arr_lit := AstExpr.FnCall(usize(0),
    box(make_atom(TokenKind.Identifier, BK_ARRAY_VAL)),
    arr_elems,
    false,
    make_token(TokenKind.Identifier, BK_ARRAY_VAL)
  );
  _ := evaluate(make_infix(":=", make_ident("arr"), arr_lit), &env);
  // sum := 0
  _ := evaluate(make_infix(":=", make_ident("sum"), make_atom(TokenKind.Integer, "0")), &env);

  // Build for(item, arr, { if((item == 3), continue); sum = (sum + item); })
  if_args := ArrayList(AstExpr).new();
  if_args.push(make_infix("==", make_ident("item"), make_atom(TokenKind.Integer, "3")));
  if_args.push(make_fncall_atom("continue", ArrayList(AstExpr).new()));
  if_expr := make_fncall_atom("if", if_args);

  add_sum := make_infix("=", make_ident("sum"), make_infix("+", make_ident("sum"), make_ident("item")));

  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(if_expr);
  body_stmts.push(add_sum);
  body_block := AstExpr.FnCall(usize(0),
    box(make_atom(TokenKind.Identifier, BK_BEGIN)),
    body_stmts,
    false,
    make_token(TokenKind.Identifier, BK_BEGIN)
  );

  for_args := ArrayList(AstExpr).new();
  for_args.push(make_ident("item"));
  for_args.push(make_ident("arr"));
  for_args.push(body_block);
  for_expr := make_fncall_atom("for", for_args);

  _ := evaluate(for_expr, &env);

  result := evaluate(make_ident("sum"), &env);
  match(result,
    .None => assert(false, "continue for returned None"),
    .Some(r) =>
      match(r.value,
        .IntLit(raw) => assert((raw.as_str() == "12"), "sum with continue in for should be 12"),
        _ => assert(false, "expected IntLit for sum")
      )
  );
};

test "Phase 5u: assert(true, msg) returns unit", {
  env := empty_env();
  assert_args := ArrayList(AstExpr).new();
  assert_args.push(make_atom(TokenKind.Bool, "true"));
  assert_args.push(make_atom(TokenKind.StringLit, "\"ok\""));
  assert_expr := make_fncall_atom("assert", assert_args);
  result := evaluate(assert_expr, &env);
  match(result,
    .None => assert(false, "assert(true) returned None"),
    .Some(r) =>
      match(r.value,
        .UnitVal => (),
        _ => assert(false, "assert(true) should return UnitVal")
      )
  );
};

test "Phase 5u: assert(false, msg) returns None (error)", {
  env := empty_env();
  assert_args := ArrayList(AstExpr).new();
  assert_args.push(make_atom(TokenKind.Bool, "false"));
  assert_args.push(make_atom(TokenKind.StringLit, "\"fail\""));
  assert_expr := make_fncall_atom("assert", assert_args);
  result := evaluate(assert_expr, &env);
  match(result,
    .None => (),
    .Some(_) => assert(false, "assert(false) should return None")
  );
};

test "Phase 5u: comptime_assert(true, msg) returns unit", {
  env := empty_env();
  ca_args := ArrayList(AstExpr).new();
  ca_args.push(make_atom(TokenKind.Bool, "true"));
  ca_args.push(make_atom(TokenKind.StringLit, "\"ok\""));
  ca_expr := make_fncall_atom("comptime_assert", ca_args);
  result := evaluate(ca_expr, &env);
  match(result,
    .None => assert(false, "comptime_assert(true) returned None"),
    .Some(r) =>
      match(r.value,
        .UnitVal => (),
        _ => assert(false, "comptime_assert(true) should return UnitVal")
      )
  );
};
