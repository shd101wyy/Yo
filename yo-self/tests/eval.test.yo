test "Phase 5dl: while loop gcd", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "gcd := (fn(a : i32, b : i32) -> i32)({ (x : i32) = a; (y : i32) = b; while((y != i32(0)), { (tmp : i32) = y; y = (x % y); x = tmp; }); x }); r := gcd(i32(48), i32(18)); export r;";
