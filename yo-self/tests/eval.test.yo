  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, "2"));
  call_expr := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, dot_tok);
  result := evaluate(call_expr, &env);
  match(result,
    .None => assert(false, "contains returned None"),
    .Some(r) =>
      match(r.value,
        .BoolVal(b) => assert(b, "array should contain 2"),
        _ => assert(false, "contains should return BoolVal")
      )
  );
};

