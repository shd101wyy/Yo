          assert((names.len() == usize(2)), "2 exports");
          // a = 10 / 3 = 3
          match(vals.get(usize(0)),
            .Some(v1) =>
              match(v1,
                .IntLit(raw) => assert((raw.as_str() == "3"), "a is 3"),
                _ => assert(false, "a not IntLit")
              ),
            .None => assert(false, "no a")
          );
          // b = 10 % 3 = 1
          match(vals.get(usize(1)),
            .Some(v2) =>
              match(v2,
                .IntLit(raw) => assert((raw.as_str() == "1"), "b is 1"),
                _ => assert(false, "b not IntLit")
              ),
            .None => assert(false, "no b")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

test "evaluate_module_body: function composition", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  // double(n) = n + n; triple(n) = n + double(n)
  // triple(5) = 5 + double(5) = 5 + 10 = 15
  src := "double := (fn(n : i32) -> i32)((n + n)); triple := (fn(n : i32) -> i32)((n + double(n))); r := triple(i32(5)); export r;";
  exprs := generate_exprs_from_code(src, using(exn));

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "1 export");
          match(vals.get(usize(0)),
            .Some(v1) =>
              match(v1,
                .IntLit(raw) => assert((raw.as_str() == "15"), "r is 15"),
                _ => assert(false, "r not IntLit")
              ),
            .None => assert(false, "no r")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

