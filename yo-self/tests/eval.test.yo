test "evaluate: fn call arity mismatch returns None", {
  // add := (fn(x, y) -> unit)((x+y)); add(1) → None (arity mismatch)
  env := empty_env();
  params := ArrayList(String).new();
  params.push(String.from("x"));
  params.push(String.from("y"));
  fn_def := make_fn_def(params, make_infix("+", make_ident("x"), make_ident("y")));
  _d := evaluate(make_infix(":=", make_ident("add"), fn_def), &env);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, "1"));
  result := evaluate(make_call("add", call_args), &env);
  check_none(result, "arity mismatch");
};

// ---------------------------------------------------------------------------
// Phase 3f — recur (recursive calls) and :: (constant declarations)
// ---------------------------------------------------------------------------

test "evaluate: recur simple countdown", {
  // count := (fn(n) -> unit)(cond(n > 0 => recur(n - 1), true => n)); count(3) → 0
  env := empty_env();
  params := ArrayList(String).new();
  params.push(String.from("n"));
  // cond(n > 0 => recur(n-1), true => n)
  recur_args := ArrayList(AstExpr).new();
  recur_args.push(make_infix("-", make_ident("n"), make_atom(TokenKind.Integer, "1")));
  recur_call := make_call("recur", recur_args);
  arms := ArrayList(AstExpr).new();
  arms.push(make_arm(make_infix(">", make_ident("n"), make_atom(TokenKind.Integer, "0")), recur_call));
  arms.push(make_arm(make_atom(TokenKind.Bool, "true"), make_ident("n")));
  body := make_cond(arms);
  fn_def := make_fn_def(params, body);
  _d := evaluate(make_infix(":=", make_ident("count"), fn_def), &env);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, "3"));
  result := evaluate(make_call("count", call_args), &env);
  check_some(result, "countdown");
  match(result,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("0"))), "count(3)=0"),
    .None => ()
  );
};

test "evaluate: recur factorial", {
  // fact := (fn(n) -> unit)(cond(n <= 1 => 1, true => n * recur(n-1))); fact(5) → 120
  env := empty_env();
  params := ArrayList(String).new();
  params.push(String.from("n"));
  recur_args := ArrayList(AstExpr).new();
  recur_args.push(make_infix("-", make_ident("n"), make_atom(TokenKind.Integer, "1")));
  mul_recur := make_infix("*", make_ident("n"), make_call("recur", recur_args));
  arms := ArrayList(AstExpr).new();
  arms.push(make_arm(make_infix("<=", make_ident("n"), make_atom(TokenKind.Integer, "1")), make_atom(TokenKind.Integer, "1")));
  arms.push(make_arm(make_atom(TokenKind.Bool, "true"), mul_recur));
  body := make_cond(arms);
  fn_def := make_fn_def(params, body);
  _d := evaluate(make_infix(":=", make_ident("fact"), fn_def), &env);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, "3"));
  result := evaluate(make_call("fact", call_args), &env);
  check_some(result, "fact(3)");
  match(result,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("6"))), "3! = 6"),
    .None => ()
  );
};

