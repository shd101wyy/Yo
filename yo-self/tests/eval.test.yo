// ---------------------------------------------------------------------------
// Identifier lookup
// ---------------------------------------------------------------------------

test "evaluate: identifier found — returns VarRef when no value stored", {
  env := Environment.new(`test`);
  _d := env.define(`x`, t_i32(), false);
  e := make_atom(TokenKind.Identifier, "x");
  result := evaluate(e, &env);
  check_some(result, "identifier x");
  match(result,
    .Some(r) => {
      assert((r.value == EvalValue.VarRef(String.from("x"))), "expected VarRef(x)");
      assert((type_value_tag(r.ty) == TypeTag.TI32), "expected TI32");
    },
    .None => ()
  );
};

test "evaluate: identifier found — returns stored comptime value", {
  env := Environment.new(`test`);
  _d := env.define_val(`n`, t_comptime_int(), true, .Some(EvalValue.IntLit(String.from("7"))));
  e := make_atom(TokenKind.Identifier, "n");
  result := evaluate(e, &env);
  check_some(result, "identifier n with value");
  match(result,
    .Some(r) => {
      assert((r.value == EvalValue.IntLit(String.from("7"))), "expected IntLit(7)");
      assert((type_value_tag(r.ty) == TypeTag.TComptimeInt), "expected TComptimeInt");
    },
    .None => ()
  );
};

test "evaluate: identifier not found → None", {
  env := empty_env();
  e := make_atom(TokenKind.Identifier, "unknown");
  check_none(evaluate(e, &env), "unknown identifier");
};

test "evaluate: identifier in nested frame", {
  env := Environment.new(`test`);
  _d0 := env.define(`outer`, t_bool(), false);
  _pushed := env.push_frame(true);
  _d1 := env.define(`inner`, t_f32(), false);
  e_outer := make_atom(TokenKind.Identifier, "outer");
  e_inner := make_atom(TokenKind.Identifier, "inner");
  match(evaluate(e_outer, &env),
    .Some(r) => assert((type_value_tag(r.ty) == TypeTag.TBool), "outer type"),
    .None => assert(false, "outer must be found")
  );
  match(evaluate(e_inner, &env),
    .Some(r) => assert((type_value_tag(r.ty) == TypeTag.TF32), "inner type"),
    .None => assert(false, "inner must be found")
  );
};

// ---------------------------------------------------------------------------
// Non-literal / unsupported atoms → None
// ---------------------------------------------------------------------------

test "evaluate: operator atom → None", {
  e := make_atom(TokenKind.Operator, "+");
  env := empty_env();
  check_none(evaluate(e, &env), "operator atom");
};

test "evaluate: fn call (unknown fn) → None", {
  (e : AstExpr) = .FnCall(
    box(make_ident("foo")),
    ArrayList(AstExpr).new(),
    false,
    make_token(TokenKind.Identifier, "foo")
  );
  env := empty_env();
  check_none(evaluate(e, &env), "fn call");
};

// ---------------------------------------------------------------------------
// Unit expression
// ---------------------------------------------------------------------------

test "evaluate: unit expression ()", {
  e := make_unit();
  env := empty_env();
  result := evaluate(e, &env);
  check_some(result, "unit expr");
  match(result,
    .Some(r) => {
      assert((r.value == EvalValue.UnitVal), "expected UnitVal");
      assert((type_value_tag(r.ty) == TypeTag.TUnit), "expected TUnit");
    },
    .None => ()
  );
};

// ---------------------------------------------------------------------------
// Begin blocks
// ---------------------------------------------------------------------------

test "evaluate: empty begin block → unit", {
  e := make_begin(ArrayList(AstExpr).new());
  env := empty_env();
  result := evaluate(e, &env);
  check_some(result, "empty begin");
  match(result,
    .Some(r) => {
      assert((r.value == EvalValue.UnitVal), "expected UnitVal");
      assert((type_value_tag(r.ty) == TypeTag.TUnit), "expected TUnit");
    },
    .None => ()
  );
};

test "evaluate: begin block returns last stmt value", {
  stmts := ArrayList(AstExpr).new();
  stmts.push(make_atom(TokenKind.Integer, "1"));
  stmts.push(make_atom(TokenKind.Integer, "2"));
  stmts.push(make_atom(TokenKind.Integer, "42"));
  e := make_begin(stmts);
  env := empty_env();
  result := evaluate(e, &env);
  check_some(result, "begin last value");
  match(result,
    .Some(r) => {
      assert((r.value == EvalValue.IntLit(String.from("42"))), "expected IntLit(42)");
    },
    .None => ()
  );
};

test "evaluate: begin block with define then lookup", {
  // { x := 99; x }
  define_stmt := make_infix(":=", make_ident("x"), make_atom(TokenKind.Integer, "99"));
  stmts := ArrayList(AstExpr).new();
  stmts.push(define_stmt);
  stmts.push(make_ident("x"));
  e := make_begin(stmts);
  env := empty_env();
  result := evaluate(e, &env);
  check_some(result, "begin define+lookup");
  match(result,
    .Some(r) => {
      assert((r.value == EvalValue.IntLit(String.from("99"))), "expected IntLit(99)");
      assert((type_value_tag(r.ty) == TypeTag.TComptimeInt), "expected TComptimeInt");
    },
    .None => ()
  );
};

test "evaluate: begin block scope is isolated from outer env", {
  env := Environment.new(`test`);
  define_stmt := make_infix(":=", make_ident("tmp"), make_atom(TokenKind.Integer, "5"));
  stmts := ArrayList(AstExpr).new();
  stmts.push(define_stmt);
  e := make_begin(stmts);
  _r := evaluate(e, &env);
  // after the begin block, 'tmp' should NOT be visible in the outer env
  lookup_result := evaluate(make_ident("tmp"), &env);
  check_none(lookup_result, "tmp not visible outside begin");
};

// ---------------------------------------------------------------------------
// cond expression
// ---------------------------------------------------------------------------

test "evaluate: cond — first true arm wins", {
  // cond(true => 1, true => 2)  →  1
  arms := ArrayList(AstExpr).new();
  arms.push(make_arm(make_atom(TokenKind.Bool, "true"), make_atom(TokenKind.Integer, "1")));
  arms.push(make_arm(make_atom(TokenKind.Bool, "true"), make_atom(TokenKind.Integer, "2")));
  e := make_cond(arms);
  env := empty_env();
  result := evaluate(e, &env);
  check_some(result, "cond first true");
  match(result,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("1"))), "expected 1"),
    .None => ()
  );
};

test "evaluate: cond — false arm skipped", {
  // cond(false => 1, true => 2)  →  2
  arms := ArrayList(AstExpr).new();
  arms.push(make_arm(make_atom(TokenKind.Bool, "false"), make_atom(TokenKind.Integer, "1")));
  arms.push(make_arm(make_atom(TokenKind.Bool, "true"), make_atom(TokenKind.Integer, "2")));
  e := make_cond(arms);
  env := empty_env();
  result := evaluate(e, &env);
  check_some(result, "cond skip false");
  match(result,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("2"))), "expected 2"),
    .None => ()
  );
};

test "evaluate: cond — no arm matches → None", {
  // cond(false => 1)  →  None (no default arm)
  arms := ArrayList(AstExpr).new();
  arms.push(make_arm(make_atom(TokenKind.Bool, "false"), make_atom(TokenKind.Integer, "1")));
  e := make_cond(arms);
  env := empty_env();
  check_none(evaluate(e, &env), "cond no match");
};

// ---------------------------------------------------------------------------
// Variable define (:=)
// ---------------------------------------------------------------------------

test "evaluate: define stores value in env", {
  env := Environment.new(`test`);
  define_e := make_infix(":=", make_ident("x"), make_atom(TokenKind.Integer, "10"));
  result := evaluate(define_e, &env);
  check_some(result, "define result");
  match(result,
    .Some(r) => assert((r.value == EvalValue.UnitVal), "define returns unit"),
    .None => ()
  );
  // now lookup x
  lookup := evaluate(make_ident("x"), &env);
  check_some(lookup, "lookup after define");
  match(lookup,
    .Some(r) => {
      assert((r.value == EvalValue.IntLit(String.from("10"))), "x should be 10");
    },
    .None => ()
  );
};

test "evaluate: define bool variable", {
  env := Environment.new(`test`);
  define_e := make_infix(":=", make_ident("flag"), make_atom(TokenKind.Bool, "true"));
  _r := evaluate(define_e, &env);
  lookup := evaluate(make_ident("flag"), &env);
  check_some(lookup, "flag lookup");
  match(lookup,
    .Some(r) => {
      assert((r.value == EvalValue.BoolVal(true)), "flag should be true");
      assert((type_value_tag(r.ty) == TypeTag.TBool), "flag type TBool");
    },
    .None => ()
  );
};

// ---------------------------------------------------------------------------
// Variable assign (=)
// ---------------------------------------------------------------------------

test "evaluate: assign updates stored value", {
  env := Environment.new(`test`);
  // x := 1
  define_e := make_infix(":=", make_ident("x"), make_atom(TokenKind.Integer, "1"));
  _d := evaluate(define_e, &env);
  // x = 2
  assign_e := make_infix("=", make_ident("x"), make_atom(TokenKind.Integer, "2"));
  result := evaluate(assign_e, &env);
  check_some(result, "assign result");
  // check x is now 2
  lookup := evaluate(make_ident("x"), &env);
  check_some(lookup, "lookup after assign");
  match(lookup,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("2"))), "x should be 2"),
    .None => ()
  );
};


// ---------------------------------------------------------------------------
// Phase 3d helpers: build enum-variant AST nodes
// ---------------------------------------------------------------------------

/// Build the dot-token and dot-atom.
make_dot_tok :: (fn() -> Token)(make_token(TokenKind.Dot, "."));
make_dot_atom :: (fn() -> AstExpr)(make_atom(TokenKind.Dot, "."));

/// Build a fieldless enum variant: `.None`
/// Parsed representation: FnCall(Atom(Dot), [Atom(Identifier, "None")], is_infix=true)
make_fieldless_variant :: (fn(name : str) -> AstExpr)(
  .FnCall(
    box(make_dot_atom()),
    {
      a := ArrayList(AstExpr).new();
      a.push(make_ident(name));
      a
    },
    true,
    make_dot_tok()
  )
);

/// Build a variant-with-args call: `.Some(arg)`
/// Representation: FnCall(FnCall(Atom(Dot), [Atom("Some")], true), [arg], false)
make_variant_call :: (fn(name : str, args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(
    box(make_fieldless_variant(name)),
    args,
    false,
    make_token(TokenKind.Identifier, name)
  )
);

/// Build a `match(scrutinee, arm1, …)` call.
make_match :: (fn(scrutinee : AstExpr, arms : ArrayList(AstExpr)) -> AstExpr)({
  all := ArrayList(AstExpr).new();
  all.push(scrutinee);
  (i : usize) = usize(0);
  while runtime((i < arms.len())), {
    match(arms.get(i),
      .Some(arm) => { all.push(arm); },
      .None => ()
    );
    i = (i + usize(1));
  };
  .FnCall(
    box(.Atom(make_token(TokenKind.Identifier, "match"))),
    all,
    false,
    make_token(TokenKind.Identifier, "match")
  )
});

/// Build `while condition, body`.
make_while :: (fn(cond_expr : AstExpr, body_expr : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(cond_expr);
  args.push(body_expr);
  .FnCall(
    box(.Atom(make_token(TokenKind.Identifier, "while"))),
    args,
    false,
    make_token(TokenKind.Identifier, "while")
  )
});

/// Build `runtime(expr)`.
make_runtime :: (fn(inner : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(inner);
  .FnCall(
    box(.Atom(make_token(TokenKind.Identifier, "runtime"))),
    args,
    false,
    make_token(TokenKind.Identifier, "runtime")
  )
});

// ---------------------------------------------------------------------------
// Phase 3d — enum variant construction
// ---------------------------------------------------------------------------

test "evaluate: fieldless variant .None", {
  env := empty_env();
  expr := make_fieldless_variant("None");
  result := evaluate(expr, &env);
  check_some(result, ".None");
  match(result,
    .Some(r) => {
      expected := EvalValue.EnumVal(String.from(".None"), ArrayList(EvalValue).new());
      assert((r.value == expected), "expected EnumVal(.None)");
    },
    .None => ()
  );
};

test "evaluate: variant .Some(42)", {
  env := empty_env();
  args := ArrayList(AstExpr).new();
  args.push(make_atom(TokenKind.Integer, "42"));
  expr := make_variant_call("Some", args);
  result := evaluate(expr, &env);
  check_some(result, ".Some(42)");
  match(result,
    .Some(r) => {
      inner := ArrayList(EvalValue).new();
      inner.push(.IntLit(String.from("42")));
      expected := EvalValue.EnumVal(String.from(".Some"), inner);
      assert((r.value == expected), "expected EnumVal(.Some, [IntLit(42)])");
    },
    .None => ()
  );
};

test "evaluate: variant .Ok(true)", {
  env := empty_env();
  args := ArrayList(AstExpr).new();
  args.push(make_atom(TokenKind.Bool, "true"));
  expr := make_variant_call("Ok", args);
  result := evaluate(expr, &env);
  check_some(result, ".Ok(true)");
  match(result,
    .Some(r) => {
      inner := ArrayList(EvalValue).new();
      inner.push(.BoolVal(true));
      expected := EvalValue.EnumVal(String.from(".Ok"), inner);
      assert((r.value == expected), "expected EnumVal(.Ok, [BoolVal(true)])");
    },
    .None => ()
  );
};

test "evaluate: nested variant .Some(.None)", {
  env := empty_env();
  args := ArrayList(AstExpr).new();
  args.push(make_fieldless_variant("None"));
  expr := make_variant_call("Some", args);
  result := evaluate(expr, &env);
  check_some(result, ".Some(.None)");
  match(result,
    .Some(r) => {
      inner_none_fields := ArrayList(EvalValue).new();
      inner_none := EvalValue.EnumVal(String.from(".None"), inner_none_fields);
      inner := ArrayList(EvalValue).new();
      inner.push(inner_none);
      expected := EvalValue.EnumVal(String.from(".Some"), inner);
      assert((r.value == expected), "expected EnumVal(.Some, [EnumVal(.None)])");
    },
    .None => ()
  );
};

// ---------------------------------------------------------------------------
// Phase 3d — match expressions
// ---------------------------------------------------------------------------

test "evaluate: match fieldless variant", {
  env := empty_env();
  // match(.None, .None => 1, .Some(_) => 2)
  scrutinee := make_fieldless_variant("None");
  arm1 := make_arm(make_fieldless_variant("None"), make_atom(TokenKind.Integer, "1"));
  arm2_pat_args := ArrayList(AstExpr).new();
  arm2_pat_args.push(make_ident("_"));
  arm2 := make_arm(make_variant_call("Some", arm2_pat_args), make_atom(TokenKind.Integer, "2"));
  arms := ArrayList(AstExpr).new();
  arms.push(arm1);
  arms.push(arm2);
  expr := make_match(scrutinee, arms);
  result := evaluate(expr, &env);
  check_some(result, "match .None");
  match(result,
    .Some(r) =>
      assert((r.value == EvalValue.IntLit(String.from("1"))), "expected arm1 body"),
    .None => ()
  );
};

test "evaluate: match .Some(x) binds variable", {
  env := empty_env();
  // match(.Some(42), .None => 0, .Some(x) => x)
  scrutinee_args := ArrayList(AstExpr).new();
  scrutinee_args.push(make_atom(TokenKind.Integer, "42"));
  scrutinee := make_variant_call("Some", scrutinee_args);

  arm_none := make_arm(make_fieldless_variant("None"), make_atom(TokenKind.Integer, "0"));
  arm_some_pat_args := ArrayList(AstExpr).new();
  arm_some_pat_args.push(make_ident("x"));
  arm_some := make_arm(make_variant_call("Some", arm_some_pat_args), make_ident("x"));
  arms := ArrayList(AstExpr).new();
  arms.push(arm_none);
  arms.push(arm_some);
  expr := make_match(scrutinee, arms);
  result := evaluate(expr, &env);
  check_some(result, "match .Some binds x");
  match(result,
    .Some(r) =>
      assert((r.value == EvalValue.IntLit(String.from("42"))), "expected bound x = 42"),
    .None => ()
  );
};

test "evaluate: match wildcard arm", {
  env := empty_env();
  // match(.None, _ => 99)
  scrutinee := make_fieldless_variant("None");
  arm_wild := make_arm(make_ident("_"), make_atom(TokenKind.Integer, "99"));
  arms := ArrayList(AstExpr).new();
  arms.push(arm_wild);
  expr := make_match(scrutinee, arms);
  result := evaluate(expr, &env);
  check_some(result, "wildcard match");
  match(result,
    .Some(r) =>
      assert((r.value == EvalValue.IntLit(String.from("99"))), "expected 99 from wildcard"),
    .None => ()
  );
};

test "evaluate: match variable binding whole scrutinee", {
  env := empty_env();
  // match(.None, v => v)  — binds whole scrutinee to v
  scrutinee := make_fieldless_variant("None");
  arm_v := make_arm(make_ident("v"), make_ident("v"));
  arms := ArrayList(AstExpr).new();
  arms.push(arm_v);
  expr := make_match(scrutinee, arms);
  result := evaluate(expr, &env);
  check_some(result, "var-bind match");
  match(result,
    .Some(r) => {
      expected := EvalValue.EnumVal(String.from(".None"), ArrayList(EvalValue).new());
      assert((r.value == expected), "expected bound v = .None");
    },
    .None => ()
  );
};

test "evaluate: match arm scope isolated", {
  outer_env := Environment.new(`test`);
  // match(.Some(7), .Some(x) => x);  x should not leak outside
  scrutinee_args := ArrayList(AstExpr).new();
  scrutinee_args.push(make_atom(TokenKind.Integer, "7"));
  scrutinee := make_variant_call("Some", scrutinee_args);
  arm_pat_args := ArrayList(AstExpr).new();
  arm_pat_args.push(make_ident("x"));
  arm := make_arm(make_variant_call("Some", arm_pat_args), make_ident("x"));
  arms := ArrayList(AstExpr).new();
  arms.push(arm);
  expr := make_match(scrutinee, arms);
  _r := evaluate(expr, &outer_env);
  // x should not exist outside the match arm
  x_lookup := evaluate(make_ident("x"), &outer_env);
  check_none(x_lookup, "x should not leak out of match arm scope");
};

// ---------------------------------------------------------------------------
// Phase 3d — while loops
// ---------------------------------------------------------------------------

test "evaluate: while false never executes", {
  env := empty_env();
  // while false, 42  → unit (condition false on first check)
  expr := make_while(make_atom(TokenKind.Bool, "false"), make_atom(TokenKind.Integer, "42"));
  result := evaluate(expr, &env);
  check_some(result, "while false");
  match(result,
    .Some(r) => assert((r.value == EvalValue.UnitVal), "expected UnitVal from while false"),
    .None => ()
  );
};

test "evaluate: while loop runs to completion", {
  env := Environment.new(`test`);
  // n := 3; while n > 0, { n = n - 1 }
  define_e := make_infix(":=", make_ident("n"), make_atom(TokenKind.Integer, "3"));
  _d := evaluate(define_e, &env);
  cond_e := make_infix(">", make_ident("n"), make_atom(TokenKind.Integer, "0"));
  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(make_infix("=", make_ident("n"), make_infix("-", make_ident("n"), make_atom(TokenKind.Integer, "1"))));
  body_e := make_begin(body_stmts);
  expr := make_while(cond_e, body_e);
  result := evaluate(expr, &env);
  check_some(result, "while runs");
  // n should be 0 after loop
  n_lookup := evaluate(make_ident("n"), &env);
  check_some(n_lookup, "n after while");
  match(n_lookup,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("0"))), "n should be 0"),
    .None => ()
  );
};

test "evaluate: while with runtime(...) wrapper", {
  env := Environment.new(`test`);
  // n := 2; while runtime(n > 0), { n = n - 1 }
  define_e := make_infix(":=", make_ident("n"), make_atom(TokenKind.Integer, "2"));
  _d := evaluate(define_e, &env);
  raw_cond := make_infix(">", make_ident("n"), make_atom(TokenKind.Integer, "0"));
  wrapped_cond := make_runtime(raw_cond);
  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(make_infix("=", make_ident("n"), make_infix("-", make_ident("n"), make_atom(TokenKind.Integer, "1"))));
  body_e := make_begin(body_stmts);
  expr := make_while(wrapped_cond, body_e);
  result := evaluate(expr, &env);
  check_some(result, "while runtime runs");
  n_lookup := evaluate(make_ident("n"), &env);
  match(n_lookup,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("0"))), "n should be 0 after while runtime"),
    .None => ()
  );
};

// ---------------------------------------------------------------------------
// Phase 3e helpers — function definitions and calls
// ---------------------------------------------------------------------------

/// Build the param-list part of a fn expression: FnCall(Atom("fn"), [p1, p2, …], false).
/// Params are bare atoms (no type annotation) for test simplicity.
make_fn_params :: (fn(param_names : ArrayList(String)) -> AstExpr)({
  param_exprs := ArrayList(AstExpr).new();
  (i : usize) = usize(0);
  while runtime((i < param_names.len())), {
    match(param_names.get(i),
      .Some(n) => {
        param_exprs.push(.Atom(make_token(TokenKind.Identifier, n.as_str())));
      },
      .None => ()
    );
    i = (i + usize(1));
  };
  .FnCall(
    box(.Atom(make_token(TokenKind.Identifier, "fn"))),
    param_exprs,
    false,
    make_token(TokenKind.Identifier, "fn")
  )
});

/// Build `(fn(params) -> unit)(body)`.
make_fn_def :: (fn(param_names : ArrayList(String), body : AstExpr) -> AstExpr)({
  fn_expr := make_fn_params(param_names);
  arrow_args := ArrayList(AstExpr).new();
  arrow_args.push(fn_expr);
  arrow_args.push(.Atom(make_token(TokenKind.Identifier, "unit")));
  (fn_sig : AstExpr) = .FnCall(
    box(.Atom(make_token(TokenKind.Operator, "->"))),
    arrow_args,
    true,
    make_token(TokenKind.Operator, "->")
  );
  outer_args := ArrayList(AstExpr).new();
  outer_args.push(body);
  (result : AstExpr) = .FnCall(box(fn_sig), outer_args, false, make_token(TokenKind.Operator, "->"));
  result
});

/// Build a function call `name(args…)`.
make_call :: (fn(name : str, call_args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(
    box(.Atom(make_token(TokenKind.Identifier, name))),
    call_args,
    false,
    make_token(TokenKind.Identifier, name)
  )
);

/// Build `return expr`.
make_return :: (fn(expr : AstExpr) -> AstExpr)({
  ret_args := ArrayList(AstExpr).new();
  ret_args.push(expr);
  .FnCall(
    box(.Atom(make_token(TokenKind.Identifier, "return"))),
    ret_args,
    false,
    make_token(TokenKind.Identifier, "return")
  )
});

// ---------------------------------------------------------------------------
// Phase 3e — function definitions and calls
// ---------------------------------------------------------------------------

test "evaluate: fn def stores FuncVal", {
  // f := (fn(x) -> unit)(x) — defines identity function
  env := empty_env();
  params := ArrayList(String).new();
  params.push(String.from("x"));
  fn_def := make_fn_def(params, make_ident("x"));
  define_e := make_infix(":=", make_ident("f"), fn_def);
  result := evaluate(define_e, &env);
  check_some(result, "fn def define");
  match(result,
    .Some(r) => assert((r.value == EvalValue.UnitVal), "define returns unit"),
    .None => ()
  );
  // Look up f — should be FuncVal
  f_res := evaluate(make_ident("f"), &env);
  check_some(f_res, "f is bound");
  match(f_res,
    .Some(r) => match(r.value,
      .FuncVal(_, ps, _, _, _, _, _) => assert((ps.len() == usize(1)), "1 param"),
      _ => assert(false, "expected FuncVal")
    ),
    .None => ()
  );
};

test "evaluate: fn call identity", {
  // f := (fn(x) -> unit)(x); f(42) → 42
  env := empty_env();
  params := ArrayList(String).new();
  params.push(String.from("x"));
  fn_def := make_fn_def(params, make_ident("x"));
  _d := evaluate(make_infix(":=", make_ident("f"), fn_def), &env);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, "42"));
  result := evaluate(make_call("f", call_args), &env);
  check_some(result, "identity call");
  match(result,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("42"))), "identity returns arg"),
    .None => ()
  );
};

test "evaluate: fn call arithmetic", {
  // add := (fn(x, y) -> unit)((x + y)); add(3, 4) → 7
  env := empty_env();
  params := ArrayList(String).new();
  params.push(String.from("x"));
