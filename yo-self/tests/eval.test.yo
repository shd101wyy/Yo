  match(result,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("7"))), "3+4=7"),
    .None => ()
  );
};

test "evaluate: fn call with return", {
  // f := (fn(x) -> unit)({ return x; }); f(99) → 99
