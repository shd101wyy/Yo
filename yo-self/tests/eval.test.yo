test "Phase 5eq: while loop XOR simulation", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "r := { (a : i32) = i32(42); (b : i32) = i32(27); (xor : i32) = i32(0); (bit : i32) = i32(1); (i : i32) = i32(0); while((i < i32(8)), { da := ((a / bit) % i32(2)); db := ((b / bit) % i32(2)); xor = cond((da != db) => (xor + bit), true => xor); bit = (bit * i32(2)); i = (i + i32(1)); }); xor }; export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
