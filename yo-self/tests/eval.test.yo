// Phase 5el: more recursion and struct patterns
test "Phase 5el: recursive gcd", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "gcd := (fn(a : i32, b : i32) -> i32)(cond((b == i32(0)) => a, true => recur(b, (a % b)))); r := gcd(i32(48), i32(18)); export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "6"), "gcd(48,18)=6"),
            _ => assert(false, "not IntLit")
          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

test "Phase 5el: struct field mutation in while", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "Counter :: struct(val : i32); c := Counter(val: i32(1)); (i : i32) = i32(0); while((i < i32(6)), { c.val = (c.val * i32(2)); i = (i + i32(1)); }); r := c.val; export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
