  match(result,
    .Some(r) => assert((r.value == EvalValue.IntLit(String.from("99"))), "return propagates"),
    .None => ()
  );
};

test "evaluate: return stops begin block", {
  // f := (fn(x) -> unit)({ return x; 100 }); f(7) → 7 (not 100)
  env := empty_env();
