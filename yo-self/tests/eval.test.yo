      match(r.value,
        .TypeVal(tyb) =>
          match(tyb.*,
            .Union(_, labels, types) => {
              assert((labels.len() == usize(2)), "2 union fields");
              match(labels.get(usize(0)), .Some(l) => assert((l.as_str() == "x"), "label x"), .None => assert(false, "no label 0"));
              match(types.get(usize(0)), .Some(t) => assert((type_value_tag(t) == TypeTag.TI32), "x:i32"), .None => assert(false, "no type 0"));
            },
            _ => assert(false, "not Union")
          ),
        _ => assert(false, "not TypeVal")
      );
    },
    .None => ()
  );
};

test "evaluate: trait() stub creates TraitT TypeVal", {
  env     := empty_env();
