// Phase 5ab — string replace, index_of, string ordering comparisons

test "Phase 5ab: StrLit.replace replaces substring", {
  env := empty_env();
  // "hello world".replace("world", "yo")
  dot_tok := make_token(TokenKind.Dot, ".");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(make_atom(TokenKind.StringLit, "\"hello world\""));
  dot_args.push(make_atom(TokenKind.Identifier, "replace"));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.StringLit, "\"world\""));
  call_args.push(make_atom(TokenKind.StringLit, "\"yo\""));
  call_expr := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, dot_tok);
  result := evaluate(call_expr, &env);
  match(result,
    .None => assert(false, "replace returned None"),
    .Some(r) =>
      match(r.value,
        .StrLit(v) => assert((v.as_str() == "\"hello yo\""), "replace should produce hello yo"),
        _ => assert(false, "replace should return StrLit")
      )
  );
};

test "Phase 5ab: StrLit.index_of finds substring position", {
  env := empty_env();
  // "hello".index_of("ll")
  dot_tok := make_token(TokenKind.Dot, ".");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(make_atom(TokenKind.StringLit, "\"hello\""));
  dot_args.push(make_atom(TokenKind.Identifier, "index_of"));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.StringLit, "\"ll\""));
  call_expr := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, dot_tok);
  result := evaluate(call_expr, &env);
  match(result,
    .None => assert(false, "index_of returned None"),
    .Some(r) =>
      match(r.value,
        .EnumVal(tag, fields) => {
          assert((tag.as_str() == ".Some"), "should be .Some");
          match(fields.get(usize(0)),
            .Some(fv) => match(fv, .IntLit(n) => assert((n.as_str() == "2"), "position should be 2"), _ => assert(false, "field should be IntLit")),
            .None => assert(false, "should have field 0")
          );
        },
        _ => assert(false, "index_of should return EnumVal")
      )
  );
};

