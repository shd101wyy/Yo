/// Codegen tests for parallelism builtin helpers.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr } :: import("../expr.yo");
{ TokenKind, Token } :: import("../token.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{ generate_expr } :: import("../codegen/exprs.yo");
{ set_generate_expr_fn } :: import("../codegen/exprs/expr.yo");
{
  generate_yo_thread_set_maximum_threads,
  format_thread_spawn_call,
  format_worker_spawn_call,
  format_spawn_heap_alloc,
  format_thread_set_max_call
} :: import("../codegen/exprs/parallelism.yo");
make_token :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
test("generate_yo_thread_set_maximum_threads: wraps generated arg", {
  set_generate_expr_fn(generate_expr);
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  ind := String.new();
  args := ArrayList(AstExpr).new();
  args.push(AstExpr.Atom(usize(0), make_token(TokenKind.Integer, "4")));
  out := generate_yo_thread_set_maximum_threads(args, pctx, ind);
  match(
    out,
    .None => assert(false, "expected output"),
    .Some(code) => assert(code == "__yo_thread_set_maximum_threads(4)", "expected maximum thread call")
  );
});
test("generate_yo_thread_set_maximum_threads: missing arg emits error comment", {
  set_generate_expr_fn(generate_expr);
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  ind := String.new();
  args := ArrayList(AstExpr).new();
  out := generate_yo_thread_set_maximum_threads(args, pctx, ind);
  match(
    out,
    .None => assert(false, "expected error output"),
    .Some(code) => assert(code == "// Error: __yo_thread_set_maximum_threads requires exactly 1 argument", "expected error comment")
  );
});
// ─── pure formatters ────────────────────────────────────────────────────────
test("format_thread_spawn_call: composes runtime call", {
  out := format_thread_spawn_call(
    String.from("__yo_spawn_wrapper_x"),
    String.from("_thread_closure_data_a")
  );
  assert(
    out == String.from("__yo_thread_spawn(__yo_spawn_wrapper_x, _thread_closure_data_a)"),
    "thread spawn shape"
  );
});
test("format_worker_spawn_call: same shape, worker name", {
  out := format_worker_spawn_call(
    String.from("__yo_spawn_wrapper_y"),
    String.from("_worker_closure_data_b")
  );
  assert(
    out == String.from("__yo_worker_spawn(__yo_spawn_wrapper_y, _worker_closure_data_b)"),
    "worker spawn shape"
  );
});
test("format_spawn_heap_alloc: typedef + malloc line", {
  out := format_spawn_heap_alloc(
    String.from("__yo_closure_capture_t"),
    String.from("_h")
  );
  assert(
    out ==
      String.from(
        "__yo_closure_capture_t* _h = (__yo_closure_capture_t*)__yo_malloc(sizeof(__yo_closure_capture_t));"
      ),
    "heap-alloc line"
  );
});
test("format_thread_set_max_call: composes __yo_thread_set_maximum_threads(<n>)", {
  out := format_thread_set_max_call(String.from("4"));
  assert(
    out == String.from("__yo_thread_set_maximum_threads(4)"),
    "thread set max shape"
  );
});
