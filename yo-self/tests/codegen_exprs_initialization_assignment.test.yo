/// Tests for yo-self/codegen/exprs/initialization_assignment.yo
/// (partial port).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr } :: import("../expr.yo");
{
  is_skipped_init_lhs,
  destructuring_field_name
} :: import("../codegen/exprs/initialization_assignment.yo");
mk_token :: (fn(value : str) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
mk_atom :: (fn(value : str) -> AstExpr)(
  AstExpr.Atom(usize(0), mk_token(value))
);
mk_call_1 :: (fn(func_name : str, a : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(a);
  AstExpr.FnCall(
    usize(0),
    box(mk_atom(func_name)),
    args,
    false,
    mk_token(func_name)
  )
});
test("is_skipped_init_lhs: bare atom → false", {
  assert(!(is_skipped_init_lhs(mk_atom("x"))), "atom is not skipped");
});
test("is_skipped_init_lhs: comptime(x) → true", {
  assert(
    is_skipped_init_lhs(mk_call_1("comptime", mk_atom("x"))),
    "comptime → skip"
  );
});
test("is_skipped_init_lhs: given(x) → true", {
  assert(
    is_skipped_init_lhs(mk_call_1("given", mk_atom("x"))),
    "given → skip"
  );
});
test("is_skipped_init_lhs: foo(x) → false", {
  assert(
    !(is_skipped_init_lhs(mk_call_1("foo", mk_atom("x")))),
    "non-comptime/given call not skipped"
  );
});
test("is_skipped_init_lhs: comptime(x, y) (2-arg) → false", {
  // The TS check enforces arity == 1.
  args := ArrayList(AstExpr).new();
  args.push(mk_atom("x"));
  args.push(mk_atom("y"));
  expr := AstExpr.FnCall(
    usize(0),
    box(mk_atom("comptime")),
    args,
    false,
    mk_token("comptime")
  );
  assert(
    !(is_skipped_init_lhs(expr)),
    "2-arg comptime is rejected"
  );
});
// ─── destructuring_field_name ───────────────────────────────────────────────
test("destructuring_field_name: digit-only labels get leading underscore", {
  // Tuple positional fields lower to `_0`, `_1`, ...
  assert(
    destructuring_field_name(String.from("0")) == String.from("_0"),
    "0 → _0"
  );
  assert(
    destructuring_field_name(String.from("12")) == String.from("_12"),
    "12 → _12"
  );
});
test("destructuring_field_name: plain identifiers passthrough sanitize", {
  // sanitize_for_c_identifier is the identity on plain `[A-Za-z0-9_]`
  // strings, so a normal field label round-trips unchanged.
  assert(
    destructuring_field_name(String.from("count")) == String.from("count"),
    "count unchanged"
  );
});
test("destructuring_field_name: operator labels sanitised", {
  // Operator-named field (e.g. `+`) gets the canonical mangle.
  assert(
    destructuring_field_name(String.from("+")) == String.from("_u43_"),
    "+ → _u43_"
  );
});
test("destructuring_field_name: empty label routes through sanitize", {
  // Empty label is "not all digits" (TS regex `^\d+$` requires ≥1
  // digit), so it falls through to sanitize, which on the empty
  // string is the identity.
  assert(
    destructuring_field_name(String.from("")) == String.from(""),
    "empty unchanged"
  );
});
