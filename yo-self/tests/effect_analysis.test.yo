//! Tests for yo-self/evaluator/effects/effect_analysis.yo
//! Mirrors src/evaluator/effects/effect-analysis.ts
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TokenKind, Token } :: import("../token.yo");
{ AstExpr } :: import("../expr.yo");
{ ExprInfo, new_expr_info } :: import("../expr_info.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ t_unit, t_bool } :: import("../types/creators.yo");
{ Environment } :: import("../env.yo");
{
  is_effect_call_,
  has_effect_in_spread_,
  is_transitive_effect_call_,
  analyze_effect_call_points
} :: import("../evaluator/effects/effect_analysis.yo");
// ---------------------------------------------------------------------------
// Test helpers
// ---------------------------------------------------------------------------
make_token :: (fn(kind : TokenKind, v : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(v),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
make_token_at :: (fn(kind : TokenKind, v : str, character : usize) -> Token)(
  Token(
    kind : kind,
    value : String.from(v),
    row : usize(0),
    column : usize(0),
    character : character,
    module_path : String.from(""),
    input : String.from("")
  )
);
make_ident :: (fn(v : str) -> AstExpr)(
  AstExpr.Atom(usize(0), make_token(TokenKind.Identifier, v))
);
/// Create `func_name(arg)` — a simple call expression.
make_simple_call :: (fn(func_name : str, arg : AstExpr, char_pos : usize) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(arg);
  AstExpr.FnCall(
    usize(0),
    Box(AstExpr)(make_ident(func_name)),
    args,
    false,
    make_token_at(TokenKind.Identifier, func_name, char_pos)
  )
});
/// Create `module_name.method_name(arg)` — a dotted-access call expression.
make_dot_call :: (fn(module_name : str, method_name : str, arg : AstExpr) -> AstExpr)({
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(make_ident(module_name));
  dot_args.push(AstExpr.Atom(usize(0), make_token(TokenKind.Identifier, method_name)));
  dot_fncall := AstExpr.FnCall(
    usize(0),
    Box(AstExpr)(AstExpr.Atom(usize(0), make_token(TokenKind.Dot, "."))),
    dot_args,
    true,
    make_token(TokenKind.Dot, ".")
  );
  outer_args := ArrayList(AstExpr).new();
  outer_args.push(arg);
  AstExpr.FnCall(
    usize(0),
    Box(AstExpr)(dot_fncall),
    outer_args,
    false,
    make_token(TokenKind.Identifier, method_name)
  )
});
/// get_info that always returns None (no type information).
get_info_none :: (fn(e : AstExpr) -> Option(ExprInfo))(
  Option(ExprInfo).None
);
/// Build an EffectsRowT with a single function-type effect named `effect_name`.
make_effects_row_with :: (fn(effect_name : String) -> TypeValue)({
  labels := ArrayList(String).new();
  labels.push(effect_name.clone());
  types := ArrayList(TypeValue).new();
  // Use a simple function type: fn() -> unit
  forall_labels := ArrayList(String).new();
  forall_types := ArrayList(TypeValue).new();
  param_labels := ArrayList(String).new();
  param_types := ArrayList(TypeValue).new();
  implicit_labels := ArrayList(String).new();
  implicit_types := ArrayList(TypeValue).new();
  implicit_spreads := ArrayList(bool).new();
  where_types := ArrayList(TypeValue).new();
  fn_ty := TypeValue.Func(
    forall_labels,
    forall_types,
    param_labels,
    param_types,
    implicit_labels,
    implicit_types,
    implicit_spreads,
    where_types,
    Box(TypeValue)(t_unit()),
    false,
    ArrayList(bool).new(),
    ArrayList(bool).new(),
    false,
    false,
    Option(String).None,
    Option(String).None,
    false
  );
  types.push(fn_ty);
  TypeValue.EffectsRowT(labels, types)
});
/// Build an empty Environment (single top-level frame, no variables).
make_empty_env :: (fn() -> Environment)(
  Environment.new(String.from("test"))
);
// ---------------------------------------------------------------------------
// is_effect_call_: direct call to effect param
// ---------------------------------------------------------------------------
test("is_effect_call_: atom is not a call => false", {
  expr := make_ident("raise");
  result := is_effect_call_(
    expr,
    String.from("raise"),
    Option(ArrayList(String)).None,
    true,
    get_info_none
  );
  assert(!(result), "atom should not be an effect call");
});
test("is_effect_call_: call to matching name, allow_missing_type=true => true", {
  // raise(x) — func name matches effect param, get_info returns None
  // With allow_missing_type=true, None type is allowed
  expr := make_simple_call("raise", make_ident("x"), usize(1));
  result := is_effect_call_(
    expr,
    String.from("raise"),
    Option(ArrayList(String)).None,
    true,
    get_info_none
  );
  assert(result, "raise(x) should match when allow_missing_type=true");
});
test("is_effect_call_: call to matching name, allow_missing_type=false => false (no type)", {
  // raise(x) — func name matches but get_info returns None, strict mode
  expr := make_simple_call("raise", make_ident("x"), usize(1));
  result := is_effect_call_(
    expr,
    String.from("raise"),
    Option(ArrayList(String)).None,
    false,
    get_info_none
  );
  assert(!(result), "raise(x) should not match when type is unknown and allow_missing_type=false");
});
test("is_effect_call_: call to non-matching name => false", {
  // foo(x) — func name does not match "raise"
  expr := make_simple_call("foo", make_ident("x"), usize(1));
  result := is_effect_call_(
    expr,
    String.from("raise"),
    Option(ArrayList(String)).None,
    true,
    get_info_none
  );
  assert(!(result), "foo(x) should not match raise");
});
test("is_effect_call_: dotted call with field_path match => true", {
  // ctl.raise(x) with field_path = Some(["raise"])
  expr := make_dot_call("ctl", "raise", make_ident("x"));
  field_path := ArrayList(String).new();
  field_path.push(String.from("raise"));
  result := is_effect_call_(
    expr,
    String.from("ctl"),
    Option(ArrayList(String)).Some(field_path),
    true,
    get_info_none
  );
  assert(result, "ctl.raise(x) with field_path=[raise] should match");
});
test("is_effect_call_: dotted call with wrong field_path => false", {
  // ctl.other(x) with field_path = Some(["raise"])
  expr := make_dot_call("ctl", "other", make_ident("x"));
  field_path := ArrayList(String).new();
  field_path.push(String.from("raise"));
  result := is_effect_call_(
    expr,
    String.from("ctl"),
    Option(ArrayList(String)).Some(field_path),
    true,
    get_info_none
  );
  assert(!(result), "ctl.other(x) should not match field_path=[raise]");
});
// ---------------------------------------------------------------------------
// has_effect_in_spread_: EffectsRowT detection
// ---------------------------------------------------------------------------
test("has_effect_in_spread_: direct EffectsRowT with matching name => true", {
  ert := make_effects_row_with(String.from("raise"));
  env := make_empty_env();
  result := has_effect_in_spread_(
    String.from("effects"),
    ert,
    String.from("raise"),
    env
  );
  assert(result, "EffectsRowT with 'raise' should return(true)");
});
test("has_effect_in_spread_: direct EffectsRowT with struct evidence => true", {
  labels := ArrayList(String).new();
  labels.push(String.from("raise"));
  types := ArrayList(TypeValue).new();
  struct_labels := ArrayList(String).new();
  struct_types := ArrayList(TypeValue).new();
  types.push(
    TypeValue.Struct(
      id : String.from("struct_raise"),
      name : String.from("Raise"),
      field_labels : struct_labels,
      field_types : struct_types,
      is_reference_semantics : false,
      is_atomic_rc : false,
      is_newtype : false,
      constructor_func_id : String.from(""),
      type_arguments : ArrayList(TypeValue).new(),
      is_source_namespace : false
    )
  );
  ert := TypeValue.EffectsRowT(labels, types);
  env := make_empty_env();
  result := has_effect_in_spread_(
    String.from("effects"),
    ert,
    String.from("raise"),
    env
  );
  assert(result, "EffectsRowT with struct(evidence should return(true))");
});
test("has_effect_in_spread_: direct EffectsRowT with non-matching name => false", {
  ert := make_effects_row_with(String.from("other_effect"));
  env := make_empty_env();
  result := has_effect_in_spread_(
    String.from("effects"),
    ert,
    String.from("raise"),
    env
  );
  assert(!(result), "EffectsRowT without 'raise' should return(false)");
});
test("has_effect_in_spread_: non-effects-row type (unit) => false", {
  env := make_empty_env();
  result := has_effect_in_spread_(
    String.from("effects"),
    t_unit(),
    String.from("raise"),
    env
  );
  assert(!(result), "unit type should return(false for has_effect_in_spread_)");
});
test("has_effect_in_spread_: bool type => false", {
  env := make_empty_env();
  result := has_effect_in_spread_(
    String.from("effects"),
    t_bool(),
    String.from("raise"),
    env
  );
  assert(!(result), "bool type should return(false for has_effect_in_spread_)");
});
// ---------------------------------------------------------------------------
// is_transitive_effect_call_: basic structural tests
// ---------------------------------------------------------------------------
test("is_transitive_effect_call_: atom (non-call) => None", {
  expr := make_ident("raise");
  result := is_transitive_effect_call_(
    expr,
    String.from("raise"),
    get_info_none
  );
  is_none := match(result,.None => true,.Some(_) => false);
  assert(is_none, "atom should return(None for transitive check)");
});
test("is_transitive_effect_call_: call where get_info returns None => None", {
  // foo(x) — no type info for foo, so can't check implicit params
  expr := make_simple_call("foo", make_ident("x"), usize(1));
  result := is_transitive_effect_call_(
    expr,
    String.from("raise"),
    get_info_none
  );
  is_none := match(result,.None => true,.Some(_) => false);
  assert(is_none, "call with unknown func type returns None");
});
// ---------------------------------------------------------------------------
// analyze_effect_call_points: basic structural tests
// ---------------------------------------------------------------------------
test("analyze_effect_call_points: atom body => no effect call points", {
  body := make_ident("unit");
  result := analyze_effect_call_points(
    body,
    String.from("raise"),
    t_unit(),
    false,
    Option(ArrayList(String)).None,
    get_info_none
  );
  assert(!(result.has_effects), "atom body should have no effects");
  assert(result.effect_call_points.len() == usize(0), "no effect call points");
  assert(result.captured_variables.len() == usize(0), "no captured vars");
});
test("analyze_effect_call_points: non-effect call body => no effect call points", {
  // foo(x) — not an effect call
  body := make_simple_call("foo", make_ident("x"), usize(0));
  result := analyze_effect_call_points(
    body,
    String.from("raise"),
    t_unit(),
    false,
    Option(ArrayList(String)).None,
    get_info_none
  );
  assert(!(result.has_effects), "non-effect call should have no effects");
  assert(result.effect_call_points.len() == usize(0), "no effect call points for foo(x)");
});
test("analyze_effect_call_points: effect call but no type info => no suspension point", {
  // raise(x) — matches name but get_info returns None, so no type to determine arg types
  // The detect function requires operation_arg_types.len() > 0 to push a suspension point
  body := make_simple_call("raise", make_ident("x"), usize(5));
  result := analyze_effect_call_points(
    body,
    String.from("raise"),
    t_unit(),
    false,
    Option(ArrayList(String)).None,
    get_info_none
  );
  // No arg types known => no suspension point pushed
  assert(result.effect_call_points.len() == usize(0), "no call points without type info");
});
test("analyze_effect_call_points: result has correct param name", {
  body := make_ident("unit");
  result := analyze_effect_call_points(
    body,
    String.from("my_effect"),
    t_unit(),
    false,
    Option(ArrayList(String)).None,
    get_info_none
  );
  assert(result.effect_parameter_name == "my_effect", "param name should be preserved");
});
test("analyze_effect_call_points: result field_path is preserved", {
  body := make_ident("unit");
  result := analyze_effect_call_points(
    body,
    String.from("raise"),
    t_unit(),
    false,
    Option(ArrayList(String)).None,
    get_info_none
  );
  has_path := match(result.effect_field_path,.Some(_) => true,.None => false);
  assert(!(has_path), "None field_path should be preserved as None");
});
test("analyze_effect_call_points: include_transitive=false does not change empty result", {
  body := make_ident("unit");
  result_notransitive := analyze_effect_call_points(
    body,
    String.from("raise"),
    t_unit(),
    false,
    Option(ArrayList(String)).None,
    get_info_none
  );
  assert(result_notransitive.effect_call_points.len() == usize(0), "no call points, not transitive");
});
