test("Phase 5aed: abs() on negative, positive, and zero values", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "a := (i32(0) - i32(5));\nb := i32(5);\nc := i32(0);\nexport(a.abs());\nexport(b.abs());\nexport(c.abs());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "abs(-5)=5"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "abs(5)=5"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
        match(
          v.get(usize(2)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "0", "abs(0)=0"), _ => assert(false, "t2")),
          .None => assert(false, "v2")
        );
      },
      _ => assert(false, "m")
    )
  );
});
// ---------------------------------------------------------------------------
// Phase 5aee — Complex pipeline combinations
// ---------------------------------------------------------------------------
test("Phase 5aee: flat_map squares then fold sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(2), i32(3)];\nexpanded := arr.flat_map((fn(x : i32) -> [i32])([x, (x * x)]));\ntotal := expanded.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        // expanded = [2, 4, 3, 9], total = 2+4+3+9 = 18
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "18", "sum=18"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
