// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5ae series: first, last, flat_map, string
/// operations (trim/substring/char_at/repeat), replace_all, index_of, abs, and
/// complex pipeline combinations.
///
/// Phases covered:
///   5aea — ArrayVal.first() and ArrayVal.last()
///   5aeb — ArrayVal.flat_map(fn)
///   5aec — StrLit.trim(), substring(), char_at(), repeat()
///   5aed — StrLit.replace_all(), index_of(), IntLit.abs()
///   5aee — Complex pipeline combinations
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5aea — ArrayVal.first() and ArrayVal.last()
// ---------------------------------------------------------------------------
test("Phase 5aea: first() on non-empty array returns first element", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(5), i32(3), i32(8)];\nresult := arr.first().unwrap();\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "first=5"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
