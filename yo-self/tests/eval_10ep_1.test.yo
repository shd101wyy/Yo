// @skip_wasm32-emscripten
// @skip_wasm32-wasi
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
empty_env :: (fn() -> Environment)(Environment.new(`test`));

test("Phase 12re/10ep: T1 running_max_sum of [4,12,9,6,12] = 52", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(4), i32(12), i32(9), i32(6), i32(12)];\ns := i32(0); mx := i32(0); i := i32(0);\nwhile((i < i32(5)), {\nv := arr.get(i).unwrap(); mx = cond((v > mx) => v, true => mx); s = (s + mx); i = (i + i32(1));\n});\npms := s;\nr := pms;\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "52", "52"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 12re/10ep: T2 running_min_sum_rev of [5,7,1,15,5,1] = 6", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(5), i32(7), i32(1), i32(15), i32(5), i32(1)];\ns := i32(0); mn := i32(9999); i := i32(5);\nwhile((i >= i32(0)), {\nv := arr.get(i).unwrap(); mn = cond((v < mn) => v, true => mn); s = (s + mn); i = (i - i32(1));\n});\nr := s;\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "6"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 12re/10ep: T3 new_max_count of [11,6,4,6,3,13,5,12,5] = 2", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(11), i32(6), i32(4), i32(6), i32(3), i32(13), i32(5), i32(12), i32(5)];\ncnt := i32(0); mx := i32(0); i := i32(0);\nwhile((i < i32(9)), {\nv := arr.get(i).unwrap(); is_new := (v > mx); mx = cond(is_new => v, true => mx); cnt = cond(is_new => (cnt + i32(1)), true => cnt); i = (i + i32(1));\n});\nr := cnt;\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

