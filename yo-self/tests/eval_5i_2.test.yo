  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "trib := (fn(n : i32) -> i32)(cond((n == i32(0)) => i32(0), (n == i32(1)) => i32(0), (n == i32(2)) => i32(1), true => ((recur((n - i32(1))) + recur((n - i32(2)))) + recur((n - i32(3))))));\nexport trib(i32(4));\nexport trib(i32(6));\nexport trib(i32(7));";
