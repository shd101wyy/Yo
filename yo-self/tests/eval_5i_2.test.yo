test "Phase 5ik: array operations chain", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "arr := [i32(10), i32(20), i32(30), i32(40), i32(50)];\nrev := arr.reverse();\nexport arr.len();\nexport rev.len();\nexport arr.contains(i32(30));\nexport rev.contains(i32(99));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "5"), "len=5"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "5"), "rev len=5"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .BoolVal(b) => assert(b, "has 30"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(3)), .Some(x) => match(x, .BoolVal(b) => assert(!(b), "no 99"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5ik: recursive sum multiples", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "sum_multiples := (fn(limit : i32, k : i32) -> i32)(cond((limit <= i32(0)) => i32(0), ((limit % k) == i32(0)) => (limit + recur((limit - i32(1)), k)), true => recur((limit - i32(1)), k)));\nexport sum_multiples(i32(15), i32(3));\nexport sum_multiples(i32(20), i32(5));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "45"), "3+6+9+12+15=45"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "50"), "5+10+15+20=50"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5ik: enum and simple operations", {
