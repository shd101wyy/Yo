  }, _ => assert(false, "m")));
};

test "Phase 5il: struct RGB color mixing", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "RGB :: struct(r : i32, g : i32, b : i32);\nc1 := RGB(r: i32(200), g: i32(100), b: i32(50));\nc2 := RGB(r: i32(100), g: i32(200), b: i32(150));\nmixed := RGB(r: ((c1.r + c2.r) / i32(2)), g: ((c1.g + c2.g) / i32(2)), b: ((c1.b + c2.b) / i32(2)));\nexport mixed.r;\nexport mixed.g;\nexport mixed.b;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "150"), "(200+100)/2=150"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "150"), "(100+200)/2=150"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "100"), "(50+150)/2=100"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5il: while loop digit extraction", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "(n : i32) = i32(12345);\ndigits := ArrayList(i32).new();\nwhile((n > i32(0)), {\ndigits.push((n % i32(10)));\nn = (n / i32(10));\n});\nexport digits.len();\nexport digits.fold(i32(0), (fn(a : i32, b : i32) -> i32)((a + b)));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "5"), "5 digits"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "15"), "1+2+3+4+5=15"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

