  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "factors := [i32(2), i32(3), i32(5), i32(7)];\n(product : i32) = i32(1);\nfor(f, factors, {\nproduct = (product * f);\n});\nexport product;\nexport (product > i32(200));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "210"), "2*3*5*7=210"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .BoolVal(b) => assert(b, "210>200"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5iu: struct equality chain", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "Color :: struct(r : i32, g : i32, b : i32);\nred := Color(r: i32(255), g: i32(0), b: i32(0));\ngreen := Color(r: i32(0), g: i32(255), b: i32(0));\nred2 := Color(r: i32(255), g: i32(0), b: i32(0));\nexport (red == red2);\nexport (red == green);\nexport ((red.r + green.g) + red2.r);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .BoolVal(b) => assert(b, "red==red2"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .BoolVal(b) => assert(!(b), "red!=green"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "765"), "255+255+255=765"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};
