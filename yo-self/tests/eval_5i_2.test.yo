  src := "Season :: enum(Spring, Summer, Autumn, Winter);\nmonths := [Season.Winter, Season.Winter, Season.Spring, Season.Spring, Season.Spring, Season.Summer, Season.Summer, Season.Summer, Season.Autumn, Season.Autumn, Season.Autumn, Season.Winter];\n(warm : i32) = i32(0);\nfor(m, months, {\nmatch(m, .Spring => { warm = (warm + i32(1)); }, .Summer => { warm = (warm + i32(1)); }, _ => ());\n});\nexport warm;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "6"), "3 spring + 3 summer = 6 warm"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

test "Phase 5ik: for loop with running average", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "scores := [i32(80), i32(90), i32(70), i32(85), i32(95)];\n(sum : i32) = i32(0);\n(count : i32) = i32(0);\nfor(s, scores, {\nsum = (sum + s);\ncount = (count + i32(1));\n});\navg := (sum / count);\nexport sum;\nexport avg;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "420"), "80+90+70+85+95=420"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "84"), "420/5=84"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

