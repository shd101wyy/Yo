/// Tests for synthesize_types (evaluator/types/synthesizer.yo) — SomeType
/// unification / generic inference. Locks in structural binding through
/// composite types (a generic used INSIDE a Func param type must bind from the
/// argument's corresponding position — the effect-polymorphism class fixed in
/// commit 702de11c9; see tests/codegen-bootstrap/effect_polymorphism_forall_infer.yo
/// for the end-to-end version).
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue } :: import("../types/definitions.yo");
{ t_func_simple, t_some_t, t_ptr, t_i32, t_bool } :: import("../types/creators.yo");
{ is_some_type } :: import("../types/guards.yo");
{ Environment } :: import("../env.yo");
{ get_value_of_some_type_from_env } :: import("../types/env_lookup.yo");
{ SynthesizeOptions, TypePair, synthesize_types } :: import("../evaluator/types/synthesizer.yo");
{ assert, panic } :: import("std/assert");
// Run one synthesis with a swallowing exn; returns true when it completed
// without throwing.
_synth_ok :: (
  fn(expected_ty : TypeValue, ee : Environment, given_ty : TypeValue, ge : Environment) -> bool
)({
  local_exn := Exception(throw : ((_err) -> unwind(false)));
  checked := ArrayList(TypePair).new();
  (opts : Option(SynthesizeOptions)) = Option(SynthesizeOptions).None;
  _r := synthesize_types(expected_ty, ee, given_ty, ge, checked, opts, local_exn);
  true
});
test("synthesize_types: SomeT binds to a concrete given type", {
  ee := Environment.new(`test`);
  ge := Environment.new(`test`);
  st := t_some_t(`T`, usize(0));
  ok := _synth_ok(st, ee, t_i32(), ge);
  assert(ok, "synthesis completes");
  bound := get_value_of_some_type_from_env(ee, st);
  assert(!(is_some_type(bound)), "T resolved to a concrete type");
});
test("synthesize_types: generic inside a Func param binds structurally", {
  ee := Environment.new(`test`);
  ge := Environment.new(`test`);
  st := t_some_t(`T`, usize(0));
  // expected: fn(a : T) -> bool ; given: fn(a : i32) -> bool  ⇒ T := i32
  pl_e := ArrayList(String).new();
  pl_e.push(`a`);
  pt_e := ArrayList(TypeValue).new();
  pt_e.push(st);
  expected_fn := t_func_simple(pl_e, pt_e, t_bool());
  pl_g := ArrayList(String).new();
  pl_g.push(`a`);
  pt_g := ArrayList(TypeValue).new();
  pt_g.push(t_i32());
  given_fn := t_func_simple(pl_g, pt_g, t_bool());
  ok := _synth_ok(expected_fn, ee, given_fn, ge);
  assert(ok, "structural synthesis completes");
  bound := get_value_of_some_type_from_env(ee, st);
  assert(!(is_some_type(bound)), "T bound through the Func param position");
});
test("synthesize_types: concrete-vs-concrete match is a no-op success", {
  ee := Environment.new(`test`);
  ge := Environment.new(`test`);
  assert(_synth_ok(t_i32(), ee, t_i32(), ge), "i32 vs i32 ok");
  assert(_synth_ok(t_ptr(t_i32()), ee, t_ptr(t_i32()), ge), "ptr(i32) vs ptr(i32) ok");
});
