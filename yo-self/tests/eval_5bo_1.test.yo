  );
  // cub=100; c35=9; max=9; total=118
  src := "cub := i32(0);\nn := i32(1);\nwhile((n <= i32(4)), {\ncub = (cub + ((n * n) * n));\nn = (n + i32(1));\n});\nc35 := i32(0);\nnn := i32(1);\nwhile((nn <= i32(20)), {\nd3 := ((nn % i32(3)) == i32(0));\nd5 := ((nn % i32(5)) == i32(0));\nc35 = cond((d3 || d5) => (c35 + i32(1)), true => c35);\nnn = (nn + i32(1));\n});\narr := [i32(3),i32(1),i32(4),i32(1),i32(5),i32(9),i32(2),i32(6)];\nmx := i32(0);\ni := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap();\nmx = cond((v > mx) => v, true => mx);\ni = (i + i32(1));\n});\ntotal := ((cub + c35) + mx);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "118", "118"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
