});
test("Phase 5boa: product of [1,2,3,4,5] via while loop", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 1*2*3*4*5=120
  src := "prod := i32(1);\nn := i32(1);\nwhile((n <= i32(5)), {\nprod = (prod * n);\nn = (n + i32(1));\n});\nexport(prod);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "120", "120"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5boa: sum of running maximums of [2,4,1,6,3,8]", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // running_max=[2,4,4,6,6,8]; sum=2+4+4+6+6+8=30
  src := "arr := [i32(2),i32(4),i32(1),i32(6),i32(3),i32(8)];\nrm := i32(0);\ns := i32(0);\ni := i32(0);\nwhile((i < i32(6)), {\nv := arr.get(i).unwrap();\nrm = cond((v > rm) => v, true => rm);\ns = (s + rm);\ni = (i + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "30", "30"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5bob — divisibility filters and modular arithmetic
// ---------------------------------------------------------------------------
test("Phase 5bob: count n in [1..30] divisible by 7", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 7,14,21,28 → count=4
  src := "cnt := i32(0);\nn := i32(1);\nwhile((n <= i32(30)), {\ncnt = cond(((n % i32(7)) == i32(0)) => (cnt + i32(1)), true => cnt);\nn = (n + i32(1));\n});\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "4"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bob: count n in [1..20] divisible by 3 OR 5", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 3,5,6,9,10,12,15,18,20 → count=9
  src := "cnt := i32(0);\nn := i32(1);\nwhile((n <= i32(20)), {\nd3 := ((n % i32(3)) == i32(0));\nd5 := ((n % i32(5)) == i32(0));\ncnt = cond((d3 || d5) => (cnt + i32(1)), true => cnt);\nn = (n + i32(1));\n});\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "9", "9"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
