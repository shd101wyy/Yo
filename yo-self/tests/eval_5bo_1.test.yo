test("Phase 5bob: count n in [1..50] where n^2 mod 7 == 0", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // n div by 7: 7,14,21,28,35,42,49 → count=7
  src := "cnt := i32(0);\nn := i32(1);\nwhile((n <= i32(50)), {\nsq := (n * n);\ncnt = cond(((sq % i32(7)) == i32(0)) => (cnt + i32(1)), true => cnt);\nn = (n + i32(1));\n});\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "7", "7"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

