// ---------------------------------------------------------------------------
// Phase 5bod — grand combo tests
// ---------------------------------------------------------------------------
test("Phase 5bod: max[array] + sum-multiples-4-1..24 + product-1..5 grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // max=9; sum_mult4=84; prod=120; total=213
  src := "arr := [i32(3),i32(1),i32(4),i32(1),i32(5),i32(9),i32(2),i32(6)];\nmx := i32(0);\ni := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap();\nmx = cond((v > mx) => v, true => mx);\ni = (i + i32(1));\n});\ns4 := i32(0);\nnn := i32(1);\nwhile((nn <= i32(24)), {\ns4 = cond(((nn % i32(4)) == i32(0)) => (s4 + nn), true => s4);\nnn = (nn + i32(1));\n});\nprod := i32(1);\nkk := i32(1);\nwhile((kk <= i32(5)), {\nprod = (prod * kk);\nkk = (kk + i32(1));\n});\ntotal := ((mx + s4) + prod);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "213", "213"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
