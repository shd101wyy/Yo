// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5al series: ArrayVal.remove, ArrayVal.set,
/// ArrayVal.get (as exported value), to_cstr/to_f64/to_usize/to_i32, and combos.
///
/// Phases covered:
///   5ala — ArrayVal.remove(idx)
///   5alb — ArrayVal.set(idx, val)
///   5alc — ArrayVal.get(idx) as exported EnumVal
///   5ald — to_cstr(), to_f64(), to_usize(), to_i32() passthroughs
///   5ale — Combos: remove+first, set+get, remove+len, set+last
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5ala — ArrayVal.remove(idx)
// ---------------------------------------------------------------------------
test("Phase 5ala: remove(0) on 3-element array yields 2 elements starting at former index 1", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i64(1), i64(2), i64(3)];\nresult := arr.remove(i64(0));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .ArrayVal(items) => {
              assert(items.len() == usize(2), "len2");
              match(
                items.get(usize(0)),
                .Some(e0) => match(e0,.IntLit(n) => assert(n.as_str() == "2", "2"), _ => assert(false, "t0")),
                .None => assert(false, "e0")
              );
            },
            _ => assert(false, "arr")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5ala: remove(2) on 3-element array yields 2 elements, last = former index 1", {
