// ---------------------------------------------------------------------------
// Phase 5alc — ArrayVal.get(idx) as exported EnumVal
// ---------------------------------------------------------------------------
test("Phase 5alc: get(0) on non-empty array returns Some with first element", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i64(1), i64(2), i64(3)];\nresult := arr.get(i64(0));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .EnumVal(tag, fields) => {
              assert(tag.as_str() == ".Some", "Some");
              match(
                fields.get(usize(0)),
                .Some(inner) => match(inner,.IntLit(n) => assert(n.as_str() == "1", "1"), _ => assert(false, "ti")),
                .None => assert(false, "flds")
              );
            },
            _ => assert(false, "enum")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

