// ---------------------------------------------------------------------------
// Phase 5ale — Combos: remove+first, set+get, remove+len, set+last
// ---------------------------------------------------------------------------
test("Phase 5ale: remove(0) then first() returns former second element", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i64(1), i64(2), i64(3)];\nresult := arr.remove(i64(0)).first();\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .EnumVal(tag, fields) => {
              assert(tag.as_str() == ".Some", "Some");
              match(
                fields.get(usize(0)),
                .Some(inner) => match(inner,.IntLit(n) => assert(n.as_str() == "2", "2"), _ => assert(false, "ti")),
                .None => assert(false, "flds")
              );
            },
            _ => assert(false, "enum")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

