  src := "arr := [i32(3), i32(1), i32(4), i32(1), i32(5)];\ntotal := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
