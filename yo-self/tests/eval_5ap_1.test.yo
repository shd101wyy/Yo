// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5ap series: fold, multi-export, and_then, map+filter, complex pipelines.
/// Covers fold (sum/product/map-then-fold/filter-then-fold), multi-export programs (two and
/// three exports), and_then arithmetic transforms, map+filter combinations, and complex
/// filter-map-fold pipelines.
///
/// Phases covered:
///   5apa — ArrayVal.fold: sum, product, map-then-fold, filter-then-fold
///   5apb — Multi-export programs: two int/bool/mixed, three exports
///   5apc — EnumVal.and_then: arithmetic lambdas, None passthrough, via variable
///   5apd — map + filter combinations: map-then-filter, filter-then-map, pipeline length
///   5ape — Complex multi-step programs: filter-map-fold, string trim, parse_i64 pipeline
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5apa — ArrayVal.fold: sum, product, map-then-fold, filter-then-fold
// ---------------------------------------------------------------------------
test("Phase 5apa: fold sum of four integers", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "result := [i32(1), i32(2), i32(3), i32(4)].fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "10", "10"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

