// ---------------------------------------------------------------------------
// Phase 5apd — map + filter combinations
// ---------------------------------------------------------------------------
test("Phase 5apd: map doubled then filter above threshold gives length two", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(1), i32(2), i32(3), i32(4)];\ndoubled := arr.map((fn(x : i32) -> i32)((x * i32(2))));\nbig := doubled.filter((fn(x : i32) -> bool)((x > i32(4))));\nexport(big.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

