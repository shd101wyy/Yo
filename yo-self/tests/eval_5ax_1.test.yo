// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5ax series: multi-argument functions,
/// nested conditionals, Option chaining, flat_map, and mixed combos.
///
/// Phases covered:
///   5axa — Multi-argument function definitions and calls
///   5axb — Nested cond expressions and complex boolean logic
///   5axc — Option/Result method chaining (and_then, or_else, chains)
///   5axd — While loop with accumulation patterns
///   5axe — flat_map, zip-based patterns, and grand combos
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5axa — Multi-argument function definitions and calls
// ---------------------------------------------------------------------------
test("Phase 5axa: two-arg function add returns correct sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "add := (fn(x : i32, y : i32) -> i32)((x + y));\nexport(add(i32(7), i32(5)));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "12", "12"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

