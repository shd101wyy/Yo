});

test("Phase 5axa: two-arg string concat function", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "greet := (fn(name : str, greeting : str) -> str)((greeting + name));\nexport(greet(\"World\", \"Hello \"));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .StrLit(raw) => assert(raw.as_str() == "\"Hello World\"", "Hello World"),
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5axb — Nested cond expressions and complex boolean logic
// ---------------------------------------------------------------------------
test("Phase 5axb: fizzbuzz for 15 returns fizzbuzz string", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "fizzbuzz := (fn(n : i32) -> str)(cond((((n % i32(15)) == i32(0))) => \"fizzbuzz\", (((n % i32(3)) == i32(0))) => \"fizz\", (((n % i32(5)) == i32(0))) => \"buzz\", true => \"other\"));\nexport(fizzbuzz(i32(15)));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .StrLit(raw) => assert(raw.as_str() == "\"fizzbuzz\"", "fizzbuzz"),
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

