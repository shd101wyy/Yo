// Phase 5axc — Option/Result method chaining
// ---------------------------------------------------------------------------
test("Phase 5axc: and_then chain doubles value twice", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "dbl := (fn(x : i32) -> i32)((x * i32(2)));\nstart := Option(i32).Some(i32(3));\nr := start.and_then(dbl);\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
