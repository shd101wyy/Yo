  src := "classify := (fn(n : i32) -> str)(cond((n < i32(0)) => \"neg\", (n == i32(0)) => \"zero\", true => \"pos\"));\na := classify(i32(5));\nb := classify(i32(0));\nc := classify((i32(0) - i32(3)));\nexport(a);\n";
