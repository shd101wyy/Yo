/// Phase 6d verification: AST reflection methods on ExprVal.
/// These are needed for the real std/prelude.yo `for` macro:
///   handle.is_fn_call(), handle.get_callee(), handle.get_args(),
///   callee.is_atom(), etc.
///
/// We define a macro that uses .is_atom() inside a comptime cond
/// and returns a different expression depending on the result.
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ EvalValue } :: import("../value.yo");
{ has_comment_attribute, Evaluator } :: import("../evaluator/index.yo");
noop_loader :: (fn(_path : String) -> Option(EvalValue))(
  Option(EvalValue).None
);
test("Phase6d: ExprVal.is_atom() returns true for atoms", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  src := String.from("// @skip_prelude\ncheck_atom :: (fn(quote(e) : Expr) -> unquote(Expr))(cond((e.is_atom()) => quote(1), true => quote(0)));\nr := check_atom(42);\nexport(r);\n");
  eval := Evaluator.new(
    String.from("<phase6d1>"),
    String.from("<no-std>"),
    noop_loader,
    src,
    exn
  );
  match(
    eval.get_module_error(),
    .Some(_) => {
      assert(false, "module_error on is_atom test");
    },
    .None => ()
  );
  match(
    eval.get_module_value(),
    .None => {
      assert(false, "no module value");
    },
    .Some(mv) => match(
      mv,
      .ModuleVal(names, values) => {
        (i : usize) = usize(0);
        n := names.len();
        (found : Option(usize)) =.None;
        while(i < n, {
          match(
            names.get(i),
            .Some(nm) => cond(
              (nm == "r") => {
                found =.Some(i);
              },
              true => ()
            ),
            .None => ()
          );
          i = (i + usize(1));
        });
        match(
          found,
          .None => {
            assert(false, "r not found");
          },
          .Some(idx) => match(
            values.get(idx),
            .None => {
              assert(false, "r idx missing");
            },
            .Some(rv) => match(
              rv,
              .IntLit(s) => assert(s == "1", "expected 1 (e was atom)"),
              _ => {
                assert(false, "r is not IntLit");
              }
            )
          )
        );
      },
      _ => {
        assert(false, "not ModuleVal");
      }
    )
  );
});
test("Phase6d: ExprVal.is_fn_call() returns true for fn calls", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  src := String.from("// @skip_prelude\ncheck_call :: (fn(quote(e) : Expr) -> unquote(Expr))(cond((e.is_fn_call()) => quote(1), true => quote(0)));\nr := check_call((1 + 2));\nexport(r);\n");
  eval := Evaluator.new(
    String.from("<phase6d2>"),
    String.from("<no-std>"),
    noop_loader,
    src,
    exn
  );
  match(
    eval.get_module_error(),
    .Some(_) => {
      assert(false, "module_error on is_fn_call test");
    },
    .None => ()
  );
  match(
    eval.get_module_value(),
    .None => {
      assert(false, "no module value");
    },
    .Some(mv) => match(
      mv,
      .ModuleVal(names, values) => {
        (i : usize) = usize(0);
        n := names.len();
        (found : Option(usize)) =.None;
        while(i < n, {
          match(
            names.get(i),
            .Some(nm) => cond(
              (nm == "r") => {
                found =.Some(i);
              },
              true => ()
            ),
            .None => ()
          );
          i = (i + usize(1));
        });
        match(
          found,
          .None => {
            assert(false, "r not found");
          },
          .Some(idx) => match(
            values.get(idx),
            .None => {
              assert(false, "r idx missing");
            },
            .Some(rv) => match(
              rv,
              .IntLit(s) => assert(s == "1", "expected 1 (e was fn call)"),
              _ => {
                assert(false, "r is not IntLit");
              }
            )
          )
        );
      },
      _ => {
        assert(false, "not ModuleVal");
      }
    )
  );
});
test("Phase6d: get_callee and get_args extract structure", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  // Macro inspects an fn-call expression `(3 + 4)` (which parses as FnCall(+, [3, 4])).
  // We just verify that get_args returns something whose .len() is 2.
  src := String.from("// @skip_prelude\narg_count :: (fn(quote(e) : Expr) -> unquote(Expr))(cond((e.get_args().len() == 2) => quote(2), true => quote(0)));\nv := arg_count((3 + 4));\nexport(v);\n");
  eval := Evaluator.new(
    String.from("<phase6d3>"),
    String.from("<no-std>"),
    noop_loader,
    src,
    exn
  );
  match(
    eval.get_module_error(),
    .Some(_) => {
      assert(false, "module_error on arg_count");
    },
    .None => ()
  );
  match(
    eval.get_module_value(),
    .None => {
      assert(false, "no module value");
    },
    .Some(mv) => match(
      mv,
      .ModuleVal(names, values) => {
        (i : usize) = usize(0);
        n := names.len();
        (found : Option(usize)) =.None;
        while(i < n, {
          match(
            names.get(i),
            .Some(nm) => cond(
              (nm == "v") => {
                found =.Some(i);
              },
              true => ()
            ),
            .None => ()
          );
          i = (i + usize(1));
        });
        match(
          found,
          .None => {
            assert(false, "v not found");
          },
          .Some(idx) => match(
            values.get(idx),
            .None => {
              assert(false, "v idx missing");
            },
            .Some(rv) => match(
              rv,
              .IntLit(s) => assert(s == "2", "expected 2 args"),
              _ => {
                assert(false, "v is not IntLit");
              }
            )
          )
        );
      },
      _ => {
        assert(false, "not ModuleVal");
      }
    )
  );
});
