/// Phase 13ay -- codegen while handler tests.
///
/// Exercises `yo-self/codegen/exprs/while.yo`, the 1-to-1 port of
/// `src/codegen/exprs/while.ts`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr, BK_BEGIN } :: import("../expr.yo");
{ new_expr_info, expr_info_table_new, expr_info_table_set }
:: import("../expr_info.yo");
{ Environment } :: import("../env.yo");
{ t_unit } :: import("../types/creators.yo");
{ set_generate_expr_fn } :: import("../codegen/exprs/expr.yo");
{ generate_expr } :: import("../codegen/exprs.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{
  generate_step_expression,
  generate_while_loop,
  strip_comptime_condition,
  format_while_true_open,
  format_while_if_negate,
  format_while_break_line,
  format_while_break_close,
  format_while_close,
  format_while_label_line,
  format_while_step_line
} :: import("../codegen/exprs/while.yo");

mk_token :: (fn(value : str, kind : TokenKind) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);

mk_atom :: (fn(id : usize, value : str, kind : TokenKind) -> AstExpr)(
  AstExpr.Atom(id, mk_token(value, kind))
);

mk_ident :: (fn(id : usize, value : str) -> AstExpr)(
  mk_atom(id, value, TokenKind.Identifier)
);

mk_call :: (fn(id : usize, name : str, args : ArrayList(AstExpr)) -> AstExpr)(
  AstExpr.FnCall(
    id,
    box(mk_ident(id + usize(1000), name)),
    args,
    false,
    mk_token(name, TokenKind.Identifier)
  )
);

mk_infix :: (fn(id : usize, op : str, lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  AstExpr.FnCall(
    id,
    box(mk_atom(id + usize(1000), op, TokenKind.Operator)),
    args,
    true,
    mk_token(op, TokenKind.Operator)
  )
});

mk_begin :: (fn(id : usize, args : ArrayList(AstExpr)) -> AstExpr)(
  mk_call(id, BK_BEGIN, args)
);

mk_while :: (fn(id : usize, args : ArrayList(AstExpr)) -> AstExpr)(
  mk_call(id, "while", args)
);

stub_generate_expr :: (
  fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    expr,
    .Atom(_, tok) => Option(String).Some(tok.value.clone()),
    .FnCall(_, func_box, args, is_infix, _) => match(
      func_box.*,
      .FnCall(_, _, _, _, _) => Option(String).Some(String.from("expr")),
      .Atom(_, tok) => cond(
        (is_infix && (args.len() == usize(2))) => match(
          args.get(usize(0)),
          .None => Option(String).Some(String.from("expr")),
          .Some(lhs) => match(
            args.get(usize(1)),
            .None => Option(String).Some(String.from("expr")),
            .Some(rhs) => match(
              recur(lhs, ctx, indent),
              .None => Option(String).Some(String.from("expr")),
              .Some(lhs_code) => match(
                recur(rhs, ctx, indent),
                .None => Option(String).Some(String.from("expr")),
                .Some(rhs_code) => {
                  out := String.from("(");
                  out.push_string(lhs_code);
                  out.push_str(" ");
                  out.push_string(tok.value);
                  out.push_str(" ");
                  out.push_string(rhs_code);
                  out.push_str(")");
                  Option(String).Some(out)
                }
              )
            )
          )
        ),
        true => Option(String).Some(tok.value.clone())
      )
    )
  )
);

test("generate_step_expression: single assignment is inline", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  step := mk_infix(usize(10), "=", mk_ident(usize(11), "i"), mk_ident(usize(12), "next"));
  code := generate_step_expression(step, ctx);
  assert(code == String.from("i = next"), "single assignment step");
});

test("generate_step_expression: begin joins assignments with comma", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  items := ArrayList(AstExpr).new();
  items.push(mk_infix(usize(20), "=", mk_ident(usize(21), "i"), mk_ident(usize(22), "next_i")));
  items.push(mk_infix(usize(23), "=", mk_ident(usize(24), "j"), mk_ident(usize(25), "next_j")));
  step := mk_begin(usize(26), items);
  code := generate_step_expression(step, ctx);
  assert(code == String.from("i = next_i, j = next_j"), "comma joined step");
});

test("strip_comptime_condition: unwraps one comptime layer", {
  inner := mk_ident(usize(30), "running");
  args := ArrayList(AstExpr).new();
  args.push(inner);
  wrapped := mk_call(usize(31), "comptime", args);
  result := strip_comptime_condition(wrapped);
  match(
    result,
    .Atom(_, tok) => assert(tok.value == String.from("running"), "unwrapped"),
    .FnCall(_, _, _, _, _) => assert(false, "expected atom")
  );
});

test("generate_while_loop: 2-arg loop emits while true with condition break", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(40), "running"));
  args.push(mk_ident(usize(41), "step"));
  call := mk_while(usize(42), args);
  result := generate_while_loop(call, args, ctx, String.from(""));
  output := ctx.emitter.print();
  assert(match(result,.None => false,.Some(s) => (s.len() == usize(0))), "empty result");
  assert(output.contains(String.from("while (true)")), "while true");
  assert(output.contains(String.from("if (!(running))")), "condition break check");
  assert(output.contains(String.from("step;")), "body emitted");
  assert(output.contains(String.from("loop_")), "loop label emitted");
});

test("generate_expr: 3-arg while routes continue to step label", {
  set_generate_expr_fn(generate_expr);
  ctx := CodegenContext.new();
  step := mk_infix(usize(50), "=", mk_ident(usize(51), "i"), mk_ident(usize(52), "next"));
  body_items := ArrayList(AstExpr).new();
  body_items.push(mk_ident(usize(53), "continue"));
  body := mk_begin(usize(54), body_items);
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(55), "running"));
  args.push(step);
  args.push(body);
  call := mk_while(usize(56), args);
  _result := generate_expr(call, ctx, String.from(""));
  output := ctx.emitter.print();
  assert(output.contains(String.from("goto continue_")), "continue jumps to step label");
  assert(output.contains(String.from("i = next;")), "step emitted after continue label");
});

test("generate_while_loop: comptime unrolled bodies emit sequentially", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  bodies := ArrayList(AstExpr).new();
  bodies.push(mk_ident(usize(60), "body_one"));
  bodies.push(mk_ident(usize(61), "body_two"));
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  call_info := new_expr_info(env, t_unit());
  call_info.comptime_unrolled_bodies = Option(ArrayList(AstExpr)).Some(bodies);
  expr_info_table_set(table, usize(62), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(63), "ignored_cond"));
  args.push(mk_ident(usize(64), "ignored_body"));
  call := mk_while(usize(62), args);
  result := generate_while_loop(call, args, ctx, String.from(""));
  output := ctx.emitter.print();
  assert(match(result,.None => false,.Some(s) => (s.len() == usize(0))), "empty result");
  assert(!(output.contains(String.from("while (true)"))), "no loop for unrolled bodies");
  assert(output.contains(String.from("body_one;")), "first body emitted");
  assert(output.contains(String.from("body_two;")), "second body emitted");
});
// ─── pure string formatters ─────────────────────────────────────────────────
test("format_while_true_open: prepends indent before `while (true) {`", {
  out := format_while_true_open(String.from("  "));
  assert(out == String.from("  while (true) {"), "while true open shape");
});
test("format_while_if_negate: composes `<indent>  if (!(<cond>)) {`", {
  out := format_while_if_negate(String.from(""), String.from("x < y"));
  assert(out == String.from("  if (!(x < y)) {"), "if-negate shape");
});
test("format_while_break_line: emits 4-space-indented break;", {
  out := format_while_break_line(String.from(""));
  assert(out == String.from("    break;"), "break line shape");
});
test("format_while_break_close: emits 2-space-indented closing brace", {
  out := format_while_break_close(String.from(""));
  assert(out == String.from("  }"), "break close shape");
});
test("format_while_close: emits closing `<indent>}`", {
  out := format_while_close(String.from("  "));
  assert(out == String.from("  }"), "while close shape");
});
test("format_while_label_line: composes `<indent><label>:;`", {
  out := format_while_label_line(String.from("    "), String.from("loop_42"));
  assert(out == String.from("    loop_42:;"), "label line shape");
});
test("format_while_step_line: emits 2-space-indented step + semicolon", {
  out := format_while_step_line(String.from(""), String.from("i = i + 1"));
  assert(out == String.from("  i = i + 1;"), "step line shape");
});
