// ---------------------------------------------------------------------------
// Phase 5ayb — Tuple/pair field access and zip-based pipelines
// ---------------------------------------------------------------------------
test("Phase 5ayb: zip then access first element of each pair", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "keys := [i32(1), i32(2), i32(3)];\nvals := [i32(10), i32(20), i32(30)];\npairs := keys.zip(vals);\nfirsts := pairs.map((fn(p : i32) -> i32)(p.0));\nexport(firsts.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x))));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "6"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

