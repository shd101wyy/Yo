// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5ay series: mutual recursion, named functions,
/// tuple/pair operations, string predicates, and large pipeline combos.
///
/// Phases covered:
///   5aya — Named function definitions (fn_name :: ...) and recursive calls
///   5ayb — Tuple field access (p.0, p.1) and zip-based pipelines
///   5ayc — String predicate chains (starts_with, ends_with, contains)
///   5ayd — Index-of and array position tests
///   5aye — Grand combo programs mixing all subsystems
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5aya — Named function definitions and recursive calls
// ---------------------------------------------------------------------------
test("Phase 5aya: named function fib(6)=8 via cond recursion", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "fib :: (fn(n : i32) -> i32)(cond((n <= i32(1)) => n, true => (recur((n - i32(1))) + recur((n - i32(2))))));\nexport(fib(i32(6)));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "8", "8"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5aya: named function power(2,10)=1024", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "pow :: (fn(base : i32, exp : i32) -> i32)(cond((exp == i32(0)) => i32(1), true => (base * recur(base, (exp - i32(1))))));\nexport(pow(i32(2), i32(10)));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1024", "1024"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

