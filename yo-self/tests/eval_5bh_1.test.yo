test("Phase 5bhd: flat_map of doubled arrays then fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [[1,2],[3,4]] flattened via flat_map → [1,2,3,4] then doubled=[2,4,6,8] → sum=20
  src := "arr := [i32(1), i32(2), i32(3), i32(4)];\ndoubled := arr.flat_map((fn(x : i32) -> [i32])([x, x]));\ntotal := doubled.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "20", "20"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bhd: map then flat_map then filter then fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,2,3] → doubled=[2,4,6] → flat_map(x→[x,x+1])=[2,3,4,5,6,7] → filter even=[2,4,6] → sum=12
  src := "arr := [i32(1), i32(2), i32(3)];\ndoubled := arr.map((fn(x : i32) -> i32)((x * i32(2))));\nexpanded := doubled.flat_map((fn(x : i32) -> [i32])([x, (x + i32(1))]));\nevens := expanded.filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(0))));\ntotal := evens.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "12", "12"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bhd: zip then map products then filter large then fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[2,3,4,5], b=[3,4,5,6] → products=[6,12,20,30] → filter>10=[12,20,30] → sum=62
  src := "a := [i32(2), i32(3), i32(4), i32(5)];\nb := [i32(3), i32(4), i32(5), i32(6)];\npairs := a.zip(b);\nproducts := pairs.map((fn(p : (i32, i32)) -> i32)((p.0 * p.1)));\nlarge := products.filter((fn(x : i32) -> bool)((x > i32(10))));\ntotal := large.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "62", "62"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
// ---------------------------------------------------------------------------
// Phase 5bhe — grand combos
// ---------------------------------------------------------------------------
test("Phase 5bhe: string + arithmetic + while grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // total len of ["abc","de","fghi"] = 3+2+4=9; while sum 1..4=10; grand=9+10=19
  src := "words := [\"abc\", \"de\", \"fghi\"];\nstr_total := words.fold(i32(0), (fn(acc : i32, w : str) -> i32)((acc + w.len())));\ni := i32(1);\nnum_total := i32(0);\nwhile((i <= i32(4)), {\nnum_total = (num_total + i);\ni = (i + i32(1));\n});\ntotal := (str_total + num_total);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "19", "19"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bhe: multi-stage pipeline grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1..6] → evens=[2,4,6] → squares=[4,16,36] → zip with [1,2,3] → products=[4,32,108] → sum=144
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6)];\nevens := arr.filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(0))));\nsquares := evens.map((fn(x : i32) -> i32)((x * x)));\nmults := [i32(1), i32(2), i32(3)];\npairs := squares.zip(mults);\nproducts := pairs.map((fn(p : (i32, i32)) -> i32)((p.0 * p.1)));\ntotal := products.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "144", "144"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
