      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [10,20,30,40,50] → sum=150, 150%7=3 (150=21*7+3)
  src := "arr := [i32(10), i32(20), i32(30), i32(40), i32(50)];\ntotal := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nresult := (total % i32(7));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bhb: count numbers with digit sum > 10 in array", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [29,55,37,11,46,99] → digit sums=[11,10,10,2,10,18] → >10: 29(11),99(18) → count=2
  src := "arr := [i32(29), i32(55), i32(37), i32(11), i32(46), i32(99)];\ncount := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)({\ntens := (x / i32(10));\nones := (x % i32(10));\nds := (tens + ones);\ncond((ds > i32(10)) => (acc + i32(1)), true => acc)\n}));\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
