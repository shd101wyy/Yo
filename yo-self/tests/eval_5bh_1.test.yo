});
// ---------------------------------------------------------------------------
// Phase 5bhb — integer patterns
// ---------------------------------------------------------------------------
test("Phase 5bhb: sum of digits of a number", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // digit sum of 9834: 9+8+3+4=24
  src := "n := i32(9834);\ndigit_sum := i32(0);\nwhile((n > i32(0)), {\ndigit_sum = (digit_sum + (n % i32(10)));\nn = (n / i32(10));\n});\nexport(digit_sum);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "24", "24"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bhb: Collatz sequence length starting from 27", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // Collatz from 6: 6→3→10→5→16→8→4→2→1 = 9 steps (including start)
  src := "n := i32(6);\nsteps := i32(1);\nwhile((n != i32(1)), {\ncond(((n % i32(2)) == i32(0)) => {\nn = (n / i32(2));\n}, true => {\nn = ((n * i32(3)) + i32(1));\n});\nsteps = (steps + i32(1));\n});\nexport(steps);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "9", "9"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
