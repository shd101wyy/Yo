test("Phase 5bhc: cond-based tax calculation on income", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // income=80: tax = cond <30 => 0, <60 => 10, <100 => 20, else => 30
  // 80 is >=60 and <100 → tax=20
  src := "income := i32(80);\ntax := cond((income < i32(30)) => i32(0), (income < i32(60)) => i32(10), (income < i32(100)) => i32(20), true => i32(30));\nexport(tax);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "20", "20"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bhc: map array with cond-threshold to codes then sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [5,15,25,35,45] → code: <10→1, <20→2, <30→3, else→4
  // codes=[1,2,3,4,4] → sum=14
  src := "arr := [i32(5), i32(15), i32(25), i32(35), i32(45)];\ncodes := arr.map((fn(x : i32) -> i32)({\ncond((x < i32(10)) => i32(1), (x < i32(20)) => i32(2), (x < i32(30)) => i32(3), true => i32(4))\n}));\ntotal := codes.fold(i32(0), (fn(acc : i32, c : i32) -> i32)((acc + c)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "14", "14"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
