/// Tests for yo-self/codegen/exprs/comptime_value.yo.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ EvalValue } :: import("../value.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ AstExpr, make_err_expr } :: import("../expr.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{ type_to_string } :: import("../types/string.yo");
{
  generate_comptime_value,
  normalize_float_raw,
  format_enum_tag_construction,
  format_enum_data_construction,
  format_tuple_construction
} :: import("../codegen/exprs/comptime_value.yo");
test("normalize_float_raw: adds .0 when no decimal point", {
  assert(
    normalize_float_raw(String.from("3")) == String.from("3.0"),
    "3 → 3.0"
  );
  assert(
    normalize_float_raw(String.from("42")) == String.from("42.0"),
    "42 → 42.0"
  );
});
test("normalize_float_raw: leaves existing decimal points alone", {
  assert(
    normalize_float_raw(String.from("3.14")) == String.from("3.14"),
    "3.14 unchanged"
  );
  assert(
    normalize_float_raw(String.from("0.5")) == String.from("0.5"),
    "0.5 unchanged"
  );
});
test("generate_comptime_value: IntLit returns raw text", {
  ctx := CodegenContext.new();
  match(
    generate_comptime_value(EvalValue.IntLit(String.from("123")), ctx),
    .Some(s) => assert(s == String.from("123"), "IntLit 123"),
    .None => assert(false, "expected Some")
  );
  match(
    generate_comptime_value(EvalValue.IntLit(String.from("0xFF")), ctx),
    .Some(s) => assert(s == String.from("0xFF"), "IntLit 0xFF"),
    .None => assert(false, "expected Some")
  );
});
test("generate_comptime_value: FloatLit normalises missing decimal point", {
  ctx := CodegenContext.new();
  match(
    generate_comptime_value(EvalValue.FloatLit(String.from("3")), ctx),
    .Some(s) => assert(s == String.from("3.0"), "FloatLit 3 → 3.0"),
    .None => assert(false, "expected Some")
  );
  match(
    generate_comptime_value(EvalValue.FloatLit(String.from("3.14")), ctx),
    .Some(s) => assert(s == String.from("3.14"), "FloatLit 3.14 unchanged"),
    .None => assert(false, "expected Some")
  );
});
test("generate_comptime_value: BoolVal returns true/false", {
  ctx := CodegenContext.new();
  match(
    generate_comptime_value(EvalValue.BoolVal(true), ctx),
    .Some(s) => assert(s == String.from("true"), "BoolVal(true)"),
    .None => assert(false, "expected Some")
  );
  match(
    generate_comptime_value(EvalValue.BoolVal(false), ctx),
    .Some(s) => assert(s == String.from("false"), "BoolVal(false)"),
    .None => assert(false, "expected Some")
  );
});
test("generate_comptime_value: StrLit with surrounding quotes passes through", {
  ctx := CodegenContext.new();
  // The Yo lexer emits StringLit raws WITH outer quotes and lexer-preserved
  // escape sequences, so they are valid C string literals as-is.
  match(
    generate_comptime_value(EvalValue.StrLit(String.from("\"hello\"")), ctx),
    .Some(s) => assert(s == String.from("\"hello\""), "literal passthrough"),
    .None => assert(false, "expected Some")
  );
});
test("generate_comptime_value: StrLit bare segment is wrapped + escaped", {
  ctx := CodegenContext.new();
  // Template-string segments are lexed WITHOUT outer quotes; quote_as_c_string
  // adds them and escapes special bytes.
  match(
    generate_comptime_value(EvalValue.StrLit(String.from("hello")), ctx),
    .Some(s) => assert(s == String.from("\"hello\""), "bare → quoted"),
    .None => assert(false, "expected Some")
  );
});
test("generate_comptime_value: complex variants defer (return None)", {
  ctx := CodegenContext.new();
  // UnitVal and unknown variants are not yet covered by the partial
  // port — they return None so callers can fall back to the AST-only
  // path. This pins down the contract.
  assert(
    generate_comptime_value(EvalValue.UnitVal, ctx).is_none(),
    "UnitVal → None (partial-port deferral)"
  );
});
// ─── FuncVal handling via functions registry ────────────────────────────────
make_func_val_with_id :: (fn(id : str) -> EvalValue)(
  EvalValue.FuncVal(
    forall_names : ArrayList(String).new(),
    params : ArrayList(String).new(),
    param_type_names : ArrayList(String).new(),
    evidence_params : ArrayList(String).new(),
    body : box(make_err_expr()),
    cap_names : ArrayList(String).new(),
    cap_tys : ArrayList(TypeValue).new(),
    cap_vals : ArrayList(EvalValue).new(),
    func_id : String.from(id)
  )
);
test("generate_comptime_value: FuncVal returns registered c_name", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  fv := make_func_val_with_id("f1");
  pctx.register_function(String.from("f1"), fv, String.from("fn_my_func"));
  match(
    generate_comptime_value(fv, pctx),
    .Some(s) => assert(s == String.from("fn_my_func"), "registered c_name"),
    .None => assert(false, "expected Some")
  );
});
test("generate_comptime_value: unregistered FuncVal returns None", {
  // When the function value has not been registered yet (e.g. the
  // evaluator visited it but codegen hasn't reached its definition),
  // the comptime-value handler returns None so the caller can fall
  // back to the bootstrap path. Mirrors the TS `??` short-circuit.
  ctx := CodegenContext.new();
  fv := make_func_val_with_id("never_registered");
  assert(
    generate_comptime_value(fv, ctx).is_none(),
    "unregistered → None"
  );
});
// ─── TypeVal handling via types registry ────────────────────────────────────
test("generate_comptime_value: TypeVal returns registered c_name for type", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  // Register a fake struct type under the same key that
  // `type_to_string` would produce for it. Use the unit type as a
  // dummy TypeValue stand-in — `register_type` doesn't inspect the
  // TypeValue beyond storing it on the entry.
  ty := TypeValue.Unit;
  pctx.register_type(
    type_to_string(ty),
    ty,
    String.from("__yo_user_struct_42")
  );
  tv := EvalValue.TypeVal(box(ty));
  match(
    generate_comptime_value(tv, pctx),
    .Some(s) => assert(s == String.from("__yo_user_struct_42"), "registered c_name"),
    .None => assert(false, "expected Some")
  );
});
test("generate_comptime_value: unregistered TypeVal returns None", {
  // Type wasn't registered, so the lookup misses and the handler
  // defers to None (caller falls back to bootstrap / get_type_string
  // default).
  ctx := CodegenContext.new();
  // Use a primitive-ish stand-in that won't be in the registry by
  // default. Primitives go through type_value_to_c_field, not the
  // types registry, so for the registry-miss path we use Unit.
  tv := EvalValue.TypeVal(box(TypeValue.Unit));
  assert(
    generate_comptime_value(tv, ctx).is_none(),
    "unregistered TypeVal → None"
  );
});
// ─── enum / tuple construction formatters ───────────────────────────────────
test("format_enum_tag_construction: tag-only", {
  out := format_enum_tag_construction(
    String.from("Color"),
    String.from("COLOR_RED")
  );
  assert(out == String.from("(Color){ .tag = COLOR_RED }"), "tag-only");
});
test("format_enum_data_construction: tag + named fields", {
  out := format_enum_data_construction(
    String.from("Shape"),
    String.from("SHAPE_CIRCLE"),
    String.from("Circle"),
    String.from(".radius = 5")
  );
  assert(
    out ==
      String.from("(Shape){ .tag = SHAPE_CIRCLE, .data = { .Circle = { .radius = 5 } } }"),
    "tagged + data"
  );
});
test("format_enum_data_construction: multi-field caller pre-joins", {
  // The formatter doesn't join — the caller is expected to format
  // and join field initialisers itself.
  out := format_enum_data_construction(
    String.from("Rect"),
    String.from("RECT_NEW"),
    String.from("New"),
    String.from(".w = 10, .h = 20")
  );
  assert(
    out ==
      String.from("(Rect){ .tag = RECT_NEW, .data = { .New = { .w = 10, .h = 20 } } }"),
    "multi-field"
  );
});
test("format_tuple_construction: numeric field initialisers", {
  // Tuples always use numeric field names _0, _1, _2... in the
  // generated C compound literal. Caller pre-joins the initialisers.
  out := format_tuple_construction(
    String.from("Tuple2_i32_str"),
    String.from("._0 = 1, ._1 = \"hi\"")
  );
  assert(
    out == String.from("(Tuple2_i32_str){ ._0 = 1, ._1 = \"hi\" }"),
    "tuple shape"
  );
});
