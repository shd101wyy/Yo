// ---------------------------------------------------------------------------
// Phase 5atd — replace+contains, to_upper+starts_with, recur+string, mixed
// ---------------------------------------------------------------------------
test("Phase 5atd: replace then contains checks new substring", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := \"hello world\";\ns2 := s.replace(\"world\", \"yo\");\nb := s2.contains(\"yo\");\nexport(b);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "true"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

