// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5at series: more string methods,
/// array index_of, split pipelines, tuple destructuring, and mixed programs.
///
/// Phases covered:
///   5ata — to_uppercase, to_lowercase, split length, replace
///   5atb — repeat, char_at, string index_of (Some/None)
///   5atc — array index_of, split+for loop, while+accumulate, char_at chain
///   5atd — tuple destructuring, named-fn + for, replace+contains, recursive enum check
///   5ate — split+fold, starts_with filter, multi-source, mixed
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5ata — to_uppercase, to_lowercase, split, replace
// ---------------------------------------------------------------------------
test("Phase 5ata: to_uppercase hello gives HELLO", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := \"hello\";\nr := s.to_uppercase();\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.StrLit(raw) => assert(raw.as_str() == "\"HELLO\"", "HELLO"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

