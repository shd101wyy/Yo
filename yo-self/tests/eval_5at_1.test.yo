          v.get(usize(0)),
          .Some(x) => match(
            x,
            .EnumVal(tag, _) => assert(tag.as_str() == ".None", "none"),
            _ => assert(false, "e")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
