  src := "a := [i32(2), i32(3), i32(4), i32(5)];\nb := [i32(5), i32(4), i32(3), i32(2)];\npairs := a.zip(b);\ntotal := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)((acc + (p.0 * p.1))));\nexport(total);\n";
