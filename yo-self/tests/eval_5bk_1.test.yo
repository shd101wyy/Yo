test("Phase 5bka: tribonacci a=0 b=0 c=1 iterate 8 times", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // Tribonacci: a=0,b=0,c=1; after 8 iters c=81
  src := "a := i32(0);\nb := i32(0);\nc := i32(1);\ni := i32(0);\nwhile((i < i32(8)), {\nt := c;\nc = ((a + b) + c);\na = b;\nb = t;\ni = (i + i32(1));\n});\nexport(c);\n";
  exprs := generate_exprs_from_code(src, using(exn));
