// @skip_wasm32-emscripten
// @skip_wasm32-wasi
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
empty_env :: (fn() -> Environment)(Environment.new(`test`));

// ---------------------------------------------------------------------------
// Phase 5bka — Fibonacci-like integer sequences
// ---------------------------------------------------------------------------
test("Phase 5bka: fibonacci from a=1 b=1 iterate 8 times", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=1,b=1; after 8 iterations: b=55 (F(10))
  src := "a := i32(1);\nb := i32(1);\ni := i32(0);\nwhile((i < i32(8)), {\nt := b;\nb = (a + b);\na = t;\ni = (i + i32(1));\n});\nexport(b);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "55", "55"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
