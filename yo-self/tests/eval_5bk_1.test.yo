test("Phase 5bkd: grand combo — zip products with sum then filter then multiply", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[1,2,3,4,5,6,7,8] b=[8,7,6,5,4,3,2,1]
  // zip products=[8,14,18,20,20,18,14,8] → all > 7 → count=8
  // also sum of products = 120 → sum / count = 15
  src := "a := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8)];\nb := [i32(8), i32(7), i32(6), i32(5), i32(4), i32(3), i32(2), i32(1)];\npairs := a.zip(b);\nprod_sum := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)((acc + (p.0 * p.1))));\ncount := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)({\ncond(((p.0 * p.1) > i32(7)) => (acc + i32(1)), true => acc)\n}));\nresult := (prod_sum / count);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "15", "15"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
