// ---------------------------------------------------------------------------
// Phase 5bkc — alternating operations and special sequences
// ---------------------------------------------------------------------------
test("Phase 5bkc: alternating add/sub fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // Start at 10; subtract [1,3,5,7] (even indices 0,2,4,6) add [2,4,6,8] (odd) → 10-1+2-3+4-5+6-7+8=14
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8)];\nacc := i32(10);\ni := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(usize(i));\nacc = match(v, .Some(x) => cond(((i % i32(2)) == i32(0)) => (acc - x), true => (acc + x)), .None => acc);\ni = (i + i32(1));\n});\nexport(acc);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "14", "14"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bkc: Collatz steps starting at 6", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 6→3→10→5→16→8→4→2→1 = 8 steps
  src := "n := i32(6);\nsteps := i32(0);\nwhile((n != i32(1)), {\nn = cond(((n % i32(2)) == i32(0)) => (n / i32(2)), true => ((n * i32(3)) + i32(1)));\nsteps = (steps + i32(1));\n});\nexport(steps);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "8", "8"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
