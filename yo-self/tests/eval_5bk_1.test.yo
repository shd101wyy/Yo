test("Phase 5bkb: product of odd-indexed elements (0-based)", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [10,3,8,5,6,7] → indices 1,3,5 → [3,5,7] → product=105
  src := "arr := [i32(10), i32(3), i32(8), i32(5), i32(6), i32(7)];\nprod := i32(1);\ni := i32(1);\nwhile((i < i32(6)), {\nv := arr.get(usize(i));\nprod = match(v, .Some(x) => (prod * x), .None => prod);\ni = (i + i32(2));\n});\nexport(prod);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
