test("Phase 5bkb: filter strings by length then sum lengths", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // words=['apple','hi','banana','go','cherry'] → filter len>3: apple(5)+banana(6)+cherry(6)=17
  src := "words := [\"apple\", \"hi\", \"banana\", \"go\", \"cherry\"];\nlong_words := words.filter((fn(w : str) -> bool)((w.len() > i32(3))));\ntotal := long_words.fold(i32(0), (fn(acc : i32, w : str) -> i32)((acc + w.len())));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "17", "17"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
