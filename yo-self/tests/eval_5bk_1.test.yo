test("Phase 5bke: zip count where both greater than 3", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[1,2,3,4,5] b=[6,1,7,2,8] → both>3: only (4,_) and (5,8) i.e. where a>3 AND b>3 = (4,?) b[3]=2→no; (5,8)→yes, count=1
  src := "a := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nb := [i32(6), i32(1), i32(7), i32(2), i32(8)];\npairs := a.zip(b);\ncount := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)({\ncond(((p.0 > i32(3)) == (p.1 > i32(3))) => cond((p.0 > i32(3)) => (acc + i32(1)), true => acc), true => acc)\n}));\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "1"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bke: while two-var accumulation 5 iterations", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=1, b=2; each iter: a+=b; b+=1; 5 times → a=21
  src := "a := i32(1);\nb := i32(2);\ni := i32(0);\nwhile((i < i32(5)), {\na = (a + b);\nb = (b + i32(1));\ni = (i + i32(1));\n});\nexport(a);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "21", "21"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
