test("Phase 5bkd: sum of sums of three arrays", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // sum([1,2,3])+sum([4,5,6])+sum([7,8,9]) = 6+15+24 = 45
  src := "a := [i32(1), i32(2), i32(3)];\nb := [i32(4), i32(5), i32(6)];\nc := [i32(7), i32(8), i32(9)];\nsa := a.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nsb := b.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nsc := c.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\ntotal := ((sa + sb) + sc);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "45", "45"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
