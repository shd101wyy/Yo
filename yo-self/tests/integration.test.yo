/// Integration test — Phase 4 validation milestone.
///
/// Compile a Yo program end-to-end using the self-hosted compiler:
///   1. Parse Yo source text with the self-hosted lexer+parser
///   2. Generate C11 source with compile_module_to_c (the compiler driver)
///   3. Write C to a temp file
///   4. Compile with the system C compiler (`cc`)
///   5. Run the binary and verify exit code 0
///
/// This validates the complete pipeline: Yo source → C → binary → run.
pragma(Pragma.SkipWasm32Emscripten); // no process model / no cc in WASM
pragma(Pragma.SkipWasm32Wasi); // no process model / no cc in WASM
open(import("std/string"));
open(import("std/error"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ Path } :: import("std/path");
{ write_file } :: import("std/fs/file");
{ Command } :: import("std/process/command");
{ parse } :: import("../parser.yo");
{ compile_module_to_c } :: import("../codegen/driver.yo");
// Temp file paths used across the integration tests.
C_TMP :: "/tmp/yo_bootstrap_hello.c";
BIN_TMP :: "/tmp/yo_bootstrap_hello";
test("Phase 4 integration: parse → C → cc → run (trivial void main)", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  // 1. Parse
  src := String.from("main :: (fn() -> unit)({ }); export(main);");
  exprs := parse(src, String.from("<integration_test>"), exn);
  // 2. Compile to C
  opt_c := compile_module_to_c(exprs, "integration_module", "main");
  c_src := match(
    opt_c,
    .None => {
      assert(false, "compile_module_to_c returned None");
      String.new()
    },
    .Some(c) => c
  );
  // 3. Write C to temp file
  io.await(write_file(Path.new(String.from(C_TMP)), c_src), io);
  // 4. Compile with system C compiler
  cc := Command.new(`cc`);
  cc.arg(String.from(C_TMP));
  cc.arg(`-o`);
  cc.arg(String.from(BIN_TMP));
  compile_st := io.await(cc.status(), io);
  assert(compile_st.success(), "C compilation should succeed (cc returned non-zero)");
  // 5. Run the binary — must exit 0
  run := Command.new(String.from(BIN_TMP));
  run_st := io.await(run.status(), io);
  assert(run_st.success(), "compiled binary should exit 0");
});
test("Phase 4 integration: parse → C → cc → run (fn with i32 return)", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  // A main that returns an i32 — in C the static fn returns int32_t, and
  // int main(void) calls it as a statement (return value ignored), then
  // returns 0.  So exit code is always 0.
  src := String.from("main :: (fn() -> unit)({ }); export(main);");
  exprs := parse(src, String.from("<integration_test2>"), exn);
  opt_c := compile_module_to_c(exprs, "integration_module2", "main");
  c_src := match(
    opt_c,
    .None => {
      assert(false, "no C output");
      String.new()
    },
    .Some(c) => c
  );
  io.await(write_file(Path.new(String.from(C_TMP)), c_src), io);
  cc := Command.new(`cc`);
  cc.arg(String.from(C_TMP));
  cc.arg(`-o`);
  cc.arg(String.from(BIN_TMP));
  st := io.await(cc.status(), io);
  assert(st.success(), "C compilation (void main) should succeed");
  run := Command.new(String.from(BIN_TMP));
  assert((io.await(run.status(), io)).success(), "binary should exit 0");
});
