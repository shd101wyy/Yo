test("Phase 12qa/10dl: T20 sum_all of [14,7,12,3,12,7,8,11] = 74", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(14), i32(7), i32(12), i32(3), i32(12), i32(7), i32(8), i32(11)];\ns := i32(0); i := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap(); s = (s + v); i = (i + i32(1));\n});\nr := s;\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "74", "74"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
