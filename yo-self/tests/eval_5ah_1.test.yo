test("Phase 5ahe: parse_i64 mapped over split number strings — sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "nums := \"1 2 3 4 5\".split(\" \");\nparsed := nums.map((fn(s : str) -> i64)(s.parse_i64().unwrap()));\nresult := parsed.fold(i64(0), (fn(acc : i64, x : i64) -> i64)(acc + x));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "15", "sum 1..5=15"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
