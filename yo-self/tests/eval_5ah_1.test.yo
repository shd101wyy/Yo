// ---------------------------------------------------------------------------
// Phase 5ahe — Complex combos
// ---------------------------------------------------------------------------
test("Phase 5ahe: concat then reverse produces reversed concatenation", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "a := [i32(1), i32(2)];\nb := [i32(3), i32(4)];\nresult := a.concat(b).reverse();\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .ArrayVal(arr) => {
              assert(arr.len() == usize(4), "len=4");
              match(arr.get(usize(0)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "4", "r0=4"), _ => assert(false, "0")),.None => assert(false, "0"));
              match(arr.get(usize(3)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "1", "r3=1"), _ => assert(false, "3")),.None => assert(false, "3"));
            },
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5ahe: slice then map to double values", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nresult := arr.slice(usize(1), usize(4)).map((fn(x : i32) -> i32)(x * i32(2)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .ArrayVal(arr) => {
              assert(arr.len() == usize(3), "len=3");
              match(arr.get(usize(0)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "4", "2*2=4"), _ => assert(false, "0")),.None => assert(false, "0"));
              match(arr.get(usize(1)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "6", "3*2=6"), _ => assert(false, "1")),.None => assert(false, "1"));
              match(arr.get(usize(2)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "8", "4*2=8"), _ => assert(false, "2")),.None => assert(false, "2"));
            },
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
