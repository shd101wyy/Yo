// ---------------------------------------------------------------------------
// Phase 5ahd — StrLit.parse_i64 and StrLit.is_empty
// ---------------------------------------------------------------------------
test("Phase 5ahd: parse_i64 on valid integer string returns Some", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := \"42\";\nresult := s.parse_i64();\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .EnumVal(tag, fields) => {
              assert(tag.as_str() == ".Some", "tag=Some");
              match(
                fields.get(usize(0)),
                .Some(inner) => match(inner,.IntLit(n) => assert(n.as_str() == "42", "parsed=42"), _ => assert(false, "inner")),
                .None => assert(false, "inner")
              );
            },
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
