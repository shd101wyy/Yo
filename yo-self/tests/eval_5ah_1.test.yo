// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5ah series: concat, reverse, slice,
/// is_empty, to_uppercase/to_lowercase, parse_i64.
///
/// Phases covered:
///   5aha — ArrayVal.concat(other) and ArrayVal.reverse()
///   5ahb — ArrayVal.slice(start, end) and ArrayVal.is_empty()
///   5ahc — StrLit.to_uppercase() and StrLit.to_lowercase()
///   5ahd — StrLit.parse_i64() and StrLit.is_empty()
///   5ahe — Complex combos: concat+reverse, slice+map, case pipelines
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5aha — ArrayVal.concat and ArrayVal.reverse
// ---------------------------------------------------------------------------
test("Phase 5aha: concat two arrays produces combined array", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "a := [i32(1), i32(2)];\nb := [i32(3), i32(4), i32(5)];\nresult := a.concat(b);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .ArrayVal(arr) => {
              assert(arr.len() == usize(5), "len=5");
              match(arr.get(usize(0)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "1", "0=1"), _ => assert(false, "0")),.None => assert(false, "0"));
              match(arr.get(usize(4)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "5", "4=5"), _ => assert(false, "4")),.None => assert(false, "4"));
            },
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
