            x,
            .ArrayVal(arr) => {
              assert(arr.len() == usize(4), "len=4");
              match(arr.get(usize(0)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "4", "r0=4"), _ => assert(false, "0")),.None => assert(false, "0"));
              match(arr.get(usize(3)),.Some(e) => match(e,.IntLit(n) => assert(n.as_str() == "1", "r3=1"), _ => assert(false, "3")),.None => assert(false, "3"));
            },
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
