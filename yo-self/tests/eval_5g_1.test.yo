test("Phase 5gk: recursive min in array", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "find_min := (fn(arr : [i32], idx : i32, curr_min : i32) -> i32)(cond((idx >= arr.len()) => curr_min, true => {\nval := match(arr.get(idx.to_usize()), .Some(v) => v, .None => i32(0));\nnew_min := cond((val < curr_min) => val, true => curr_min);\nrecur(arr, (idx + i32(1)), new_min)\n}));\narr := [i32(7), i32(3), i32(9), i32(1), i32(5), i32(8), i32(2)];\nexport(find_min(arr, i32(1), match(arr.first(), .Some(v) => v, .None => i32(0))));";
