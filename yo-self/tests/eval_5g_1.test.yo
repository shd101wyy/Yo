        match(v.get(usize(0)),.Some(x) => match(x,.BoolVal(b) => assert(b, "contains world"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(1)),.Some(x) => match(x,.BoolVal(b) => assert(!(b), "no xyz"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(2)),.Some(x) => match(x,.BoolVal(b) => assert(b, "starts hello"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(3)),.Some(x) => match(x,.BoolVal(b) => assert(b, "ends hello"), _ => assert(false, "t")),.None => assert(false, "v"));
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5gm: collatz conjecture path", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "collatz_len := (fn(n : i32) -> i32)({\n(x : i32) = n;\n(steps : i32) = i32(0);\nwhile((x != i32(1)), {\ncond(((x % i32(2)) == i32(0)) => { x = (x / i32(2)); }, true => { x = ((i32(3) * x) + i32(1)); });\nsteps = (steps + i32(1));\n});\nsteps\n});\nexport(collatz_len(i32(6)));\nexport(collatz_len(i32(27)));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "8", "collatz(6)=8"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "111", "collatz(27)=111"), _ => assert(false, "t")),.None => assert(false, "v"));
      },
      _ => assert(false, "m")
    )
  );
});
