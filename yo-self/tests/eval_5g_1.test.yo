test("Phase 5gm: nested while loops matrix diagonal sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "mat := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8), i32(9)];\nsize := i32(3);\n(diag_sum : i32) = i32(0);\n(i : i32) = i32(0);\nwhile((i < size), {\nidx := ((i * size) + i);\nmatch(mat.get(idx.to_usize()), .Some(v) => { diag_sum = (diag_sum + v); }, .None => ());\ni = (i + i32(1));\n});\nexport(diag_sum);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result,.None => assert(false, "N"),.Some(m) => match(m,.ModuleVal(_, v) => match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "15", "1+5+9=15"), _ => assert(false, "t")),.None => assert(false, "v")), _ => assert(false, "m")));
});
test("Phase 5gm: recursive multiply without operator", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "multiply := (fn(a : i32, b : i32) -> i32)(cond((b == i32(0)) => i32(0), (b > i32(0)) => (a + recur(a, (b - i32(1)))), true => (i32(0) - recur(a, (i32(0) - b)))));\nexport(multiply(i32(7), i32(6)));\nexport(multiply(i32(3), i32(0)));\nexport(multiply(i32(5), i32(-(3))));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "42", "7*6=42"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "0", "3*0=0"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(2)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "-15", "5*-3=-15"), _ => assert(false, "t")),.None => assert(false, "v"));
      },
      _ => assert(false, "m")
    )
  );
});
