/// Tests for yo-self/codegen/constants.yo.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ is_builtin_yo_inline_function } :: import("../codegen/constants.yo");
test("is_builtin_yo_inline_function: arithmetic op names", {
  assert(is_builtin_yo_inline_function("__yo_op_add"), "add");
  assert(is_builtin_yo_inline_function("__yo_op_sub"), "sub");
  assert(is_builtin_yo_inline_function("__yo_op_neg"), "neg");
});
test("is_builtin_yo_inline_function: pointer + slice + cast", {
  assert(is_builtin_yo_inline_function("__yo_ptr_add"), "ptr add");
  assert(is_builtin_yo_inline_function("__yo_slice_len"), "slice len");
  assert(is_builtin_yo_inline_function("__yo_as"), "as");
});
test("is_builtin_yo_inline_function: indexing range variants", {
  assert(is_builtin_yo_inline_function("__yo_array_index"), "array index");
  assert(is_builtin_yo_inline_function("__yo_array_index_range"), "exclusive");
  assert(
    is_builtin_yo_inline_function("__yo_array_index_range_inclusive"),
    "inclusive"
  );
});
test("is_builtin_yo_inline_function: maybe-uninit + others", {
  assert(is_builtin_yo_inline_function("__yo_maybe_uninit_new"), "maybe new");
  assert(is_builtin_yo_inline_function("__yo_noop"), "noop");
  assert(is_builtin_yo_inline_function("__yo_return_self"), "return_self");
  assert(is_builtin_yo_inline_function("__yo_ms_sleep"), "ms_sleep");
});
test("is_builtin_yo_inline_function: non-inline names rejected", {
  assert(
    !(is_builtin_yo_inline_function("__yo_decr_rc")),
    "decr_rc is not inline"
  );
  assert(
    !(is_builtin_yo_inline_function("__yo_drop")),
    "drop is not inline"
  );
  assert(!(is_builtin_yo_inline_function("foo")), "user fn rejected");
  assert(!(is_builtin_yo_inline_function("")), "empty rejected");
});
