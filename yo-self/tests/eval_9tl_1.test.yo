        escape(());
      }
    )
  );
  src := "arr := [i32(10), i32(3), i32(2), i32(2), i32(12), i32(8), i32(12), i32(10), i32(6)];\ns := i32(0); mx := i32(0); i := i32(0);\nwhile((i < i32(9)), {\nv := arr.get(i).unwrap(); mx = cond((v > mx) => v, true => mx); s = (s + mx); i = (i + i32(1));\n});\npms := s;\nr := pms;\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
