      _ => assert(false, "m")
    )
  );
});

test("Phase 5bea: let chain — multi-step arithmetic pipeline", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // start=3, step1=3*3=9, step2=9+6=15, step3=15*2=30, step4=30-5=25
  src := "start := i32(3);\nstep1 := (start * start);\nstep2 := (step1 + i32(6));\nstep3 := (step2 * i32(2));\nstep4 := (step3 - i32(5));\nexport(step4);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "25", "25"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bea: let chain with boolean results", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // x=7, is_pos=(x>0)=true, is_odd=(x%2==1)=true, both=(is_pos && is_odd)=true
  src := "x := i32(7);\nis_pos := (x > i32(0));\nis_odd := ((x % i32(2)) == i32(1));\nboth := (is_pos && is_odd);\nexport(both);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "true"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

