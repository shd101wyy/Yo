test("Phase 5bee: all-pipeline grand combo — zip filter fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[1,2,3,4,5], b=[5,4,3,2,1], zip → filter p.0+p.1>6 → [(3,3),(4,2),(5,1)] wait
  // p.0+p.1: 6,6,6,6,6 — all equal! Change: a=[1,2,3,4,5], b=[1,3,5,7,9]
  // p.0+p.1 = 2,5,8,11,14 → filter >6: (3,5),(4,7),(5,9); map to p.0: [3,4,5]; sum=12
  src := "a := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nb := [i32(1), i32(3), i32(5), i32(7), i32(9)];\npairs := a.zip(b);\nbig := pairs.filter((fn(p : (i32, i32)) -> bool)(((p.0 + p.1) > i32(6))));\nfirsts := big.map((fn(p : (i32, i32)) -> i32)(p.0));\nresult := firsts.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "12", "12"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
