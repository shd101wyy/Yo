  src := "words := [\"hi\", \"hello\", \"yo\", \"world\"];\nlens := words.map((fn(w : str) -> i32)(w.len()));\nresult := lens.fold(i32(0), (fn(acc : i32, x : i32) -> i32)(cond((x > acc) => x, true => acc)));\nexport(result);\n";
