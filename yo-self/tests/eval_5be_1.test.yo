test("Phase 5bec: map then map pipeline", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,2,3,4] → map *2 → [2,4,6,8] → map +1 → [3,5,7,9] → fold sum=24
  src := "arr := [i32(1), i32(2), i32(3), i32(4)];\ndoubled := arr.map((fn(x : i32) -> i32)((x * i32(2))));\nincremented := doubled.map((fn(x : i32) -> i32)((x + i32(1))));\nresult := incremented.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "24", "24"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bec: filter then map pipeline", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
