test("Phase 5beb: while to find first element > threshold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // multiples of 7 from 1 to 50: 7,14,21,28,35,42,49 → count=7
  src := "i := i32(1);\ncount := i32(0);\nwhile((i <= i32(50)), {\ncond(((i % i32(7)) == i32(0)) => {\ncount = (count + i32(1));\n}, true => ());\ni = (i + i32(1));\n});\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "7", "7"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

