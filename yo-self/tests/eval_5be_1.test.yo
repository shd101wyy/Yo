      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "120", "120"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bec: flat_map then filter pipeline", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,2,3] → flat_map [x,x+10] → [1,11,2,12,3,13] → filter >5 → [11,12,13] → len=3
  src := "arr := [i32(1), i32(2), i32(3)];\nflat := arr.flat_map((fn(x : i32) -> [i32])([x, (x + i32(10))]));\nbig := flat.filter((fn(x : i32) -> bool)((x > i32(5))));\nexport(big.len());\n";
