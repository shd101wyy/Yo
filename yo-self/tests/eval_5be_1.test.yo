// ---------------------------------------------------------------------------
// Phase 5bee — grand combos
// ---------------------------------------------------------------------------
test("Phase 5bee: let chain + recursive fn + fold grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // fact(n) for n in [1,2,3,4]: [1,2,6,24], sum=33
  src := "fact :: (fn(n : i32) -> i32)(cond((n <= i32(1)) => i32(1), true => (n * recur((n - i32(1))))));\narr := [i32(1), i32(2), i32(3), i32(4)];\nfacts := arr.map((fn(n : i32) -> i32)(fact(n)));\nresult := facts.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "33", "33"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

