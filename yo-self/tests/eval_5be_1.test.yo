test("Phase 5bed: count strings by length threshold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // words with len > 4: "apple"(5),"cherry"(6),"banana"(6),"kiwi"(4-no),"mango"(5) → 4
  src := "words := [\"apple\", \"cherry\", \"banana\", \"kiwi\", \"mango\"];\nlens := words.map((fn(w : str) -> i32)(w.len()));\nlong_count := lens.filter((fn(n : i32) -> bool)((n > i32(4))));\nexport(long_count.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "4"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

