  src := "N :: struct(v : i32);\nimpl(N, Base(\n  get_v : (fn(n : N) -> i32)({ n.v })\n));\nimpl(N, Derived(\n  quad : (fn(n : N) -> i32)({ (n.get_v() * i32(4)) })\n));\nx := N(v: i32(3));\nexport(x.quad());\n";
