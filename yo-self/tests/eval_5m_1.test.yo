// Phase 5mc — impl methods with additional arguments beyond the receiver
// ---------------------------------------------------------------------------
test("Phase 5mc: method with extra i32 arg — n.add(5)", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(v : i32);\nimpl(N, Math(\n  add : (fn(n : N, m : i32) -> i32)({ (n.v + m) })\n));\nx := N(v: i32(3));\nexport(x.add(i32(5)));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "8", "3+5=8"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5mc: method with extra bool arg — conditional computation", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(v : i32);\nimpl(N, Math(\n  cond_double : (fn(n : N, flag : bool) -> i32)({ cond(flag => (n.v * i32(2)), true => n.v) })\n));\nx := N(v: i32(6));\nexport(x.cond_double(true));\nexport(x.cond_double(false));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
