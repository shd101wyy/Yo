// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5m series: field mutation, multi-trait, extra-arg methods.
///
/// Phases covered:
///   5ma — struct field mutation on local variables (Phase 3aq patterns)
///   5mb — multiple trait impls on the same struct
///   5mc — impl methods with additional arguments beyond the receiver
///   5md — impl methods that return StructVal (checking returned struct fields)
///   5me — complex combinations and new patterns

open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5ma — struct field mutation on local variables
// ---------------------------------------------------------------------------
test("Phase 5ma: simple field set then read", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "P :: struct(x : i32);\np := P(x: i32(3));\np.x = i32(10);\nexport(p.x);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "10", "set to 10"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ma: two-field struct, mutate one and read both", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "P :: struct(x : i32, y : i32);\np := P(x: i32(3), y: i32(7));\np.x = i32(99);\nexport(p.x);\nexport(p.y);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "99", "x=99"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(y) => match(y, .IntLit(n) => assert(n.as_str() == "7", "y unchanged"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ma: increment field via mutation (x = x + 1 twice)", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "C :: struct(n : i32);\nc := C(n: i32(5));\nc.n = (c.n + i32(1));\nc.n = (c.n + i32(1));\nexport(c.n);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "7", "5+1+1=7"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ma: mutation in while loop — accumulate in struct field", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Acc :: struct(sum : i32);\nacc := Acc(sum: i32(0));\n(i : i32) = i32(1);\nwhile(runtime((i <= i32(4))), {\n  acc.sum = (acc.sum + i);\n  i = (i + i32(1));\n});\nexport(acc.sum);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "10", "1+2+3+4=10"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ma: mutation in cond branch — set to different value based on bool", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "S :: struct(v : i32);\ns := S(v: i32(0));\nflag := true;\ncond(flag => { s.v = i32(42); }, true => { s.v = i32(99); });\nexport(s.v);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
