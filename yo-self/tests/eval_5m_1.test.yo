});
// ---------------------------------------------------------------------------
// Phase 5mb — multiple trait impls on the same struct
// ---------------------------------------------------------------------------
test("Phase 5mb: two traits (Math + Logic) on same struct", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(v : i32);\nimpl(N, Math(\n  double : (fn(n : N) -> i32)({ (n.v * i32(2)) })\n));\nimpl(N, Logic(\n  is_pos : (fn(n : N) -> bool)({ (n.v > i32(0)) })\n));\nx := N(v: i32(5));\nexport(x.double());\nexport(x.is_pos());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "10", "double=10"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(y) => match(y, .BoolVal(b) => assert(b, "pos=true"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5mb: three traits on same struct", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(v : i32);\nimpl(N, A(\n  f1 : (fn(n : N) -> i32)({ (n.v + i32(1)) })\n));\nimpl(N, B(\n  f2 : (fn(n : N) -> i32)({ (n.v + i32(2)) })\n));\nimpl(N, C(\n  f3 : (fn(n : N) -> i32)({ (n.v + i32(3)) })\n));\nx := N(v: i32(10));\nexport(x.f1());\nexport(x.f2());\nexport(x.f3());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(a) => match(a, .IntLit(n) => assert(n.as_str() == "11", "10+1=11"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(b) => match(b, .IntLit(n) => assert(n.as_str() == "12", "10+2=12"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(c) => match(c, .IntLit(n) => assert(n.as_str() == "13", "10+3=13"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5mb: one trait with two methods, another with one", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(v : i32);\nimpl(N, Math(\n  double : (fn(n : N) -> i32)({ (n.v * i32(2)) }),\n  triple : (fn(n : N) -> i32)({ (n.v * i32(3)) })\n));\nimpl(N, Logic(\n  is_even : (fn(n : N) -> bool)({ ((n.v % i32(2)) == i32(0)) })\n));\nx := N(v: i32(4));\nexport(x.double());\nexport(x.triple());\nexport(x.is_even());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(a) => match(a, .IntLit(n) => assert(n.as_str() == "8", "4*2=8"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(b) => match(b, .IntLit(n) => assert(n.as_str() == "12", "4*3=12"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(c) => match(c, .BoolVal(b) => assert(b, "4 is even"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5mb: two different struct types each implementing same trait name", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "A :: struct(v : i32);\nB :: struct(v : i32);\nimpl(A, Math(\n  double : (fn(x : A) -> i32)({ (x.v * i32(2)) })\n));\nimpl(B, Math(\n  double : (fn(x : B) -> i32)({ (x.v * i32(3)) })\n));\na := A(v: i32(5));\nb := B(v: i32(5));\nexport(a.double());\nexport(b.double());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(a) => match(a, .IntLit(n) => assert(n.as_str() == "10", "A.double=10"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(b) => match(b, .IntLit(n) => assert(n.as_str() == "15", "B.double=15"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5mb: method in one trait calls method registered in another trait", {
