    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "12", "3*4=12"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5mb: four traits on same struct, all called", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(v : i32);\nimpl(N, T1(\n  m1 : (fn(n : N) -> i32)({ (n.v + i32(1)) })\n));\nimpl(N, T2(\n  m2 : (fn(n : N) -> i32)({ (n.v + i32(2)) })\n));\nimpl(N, T3(\n  m3 : (fn(n : N) -> i32)({ (n.v + i32(3)) })\n));\nimpl(N, T4(\n  m4 : (fn(n : N) -> i32)({ (n.v + i32(4)) })\n));\nx := N(v: i32(0));\nexport((((x.m1() + x.m2()) + x.m3()) + x.m4()));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "10", "1+2+3+4=10"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5mb: multi-trait used with field mutation — mutate then call both traits", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(v : i32);\nimpl(N, Math(\n  double : (fn(n : N) -> i32)({ (n.v * i32(2)) })\n));\nimpl(N, Logic(\n  is_pos : (fn(n : N) -> bool)({ (n.v > i32(0)) })\n));\nx := N(v: i32(-(1)));\nx.v = i32(5);\nexport(x.double());\nexport(x.is_pos());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(a) => match(a, .IntLit(n) => assert(n.as_str() == "10", "double=10"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(b) => match(b, .BoolVal(bv) => assert(bv, "is_pos=true"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5mb: multi-trait: negate via Math, abs via Check", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(v : i32);\nimpl(N, Math(\n  negate : (fn(n : N) -> i32)({ (i32(0) - n.v) })\n));\nimpl(N, Check(\n  is_negative : (fn(n : N) -> bool)({ (n.v < i32(0)) })\n));\nx := N(v: i32(7));\nexport(x.negate());\nexport(x.is_negative());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(a) => match(a, .IntLit(n) => assert(n.as_str() == "-7", "negate=-(7)"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(b) => match(b, .BoolVal(bv) => assert(!(bv), "7 not negative"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5mb: struct with string field, two traits: len-check and prefix-check", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "S :: struct(label : str);\nimpl(S, Len(\n  nonempty : (fn(s : S) -> bool)({ !(s.label.is_empty()) })\n));\nimpl(S, Prefix(\n  starts_hi : (fn(s : S) -> bool)({ s.label.starts_with(\"hi\") })\n));\nx := S(label: \"hi world\");\nexport(x.nonempty());\nexport(x.starts_hi());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(a) => match(a, .BoolVal(bv) => assert(bv, "nonempty"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(b) => match(b, .BoolVal(bv) => assert(bv, "starts_hi"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5mb: bool field, two traits using it differently", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
