// ---------------------------------------------------------------------------
// Phase 5ub — logical NOT !(expr) and unary negation -(expr)
// ---------------------------------------------------------------------------
test("Phase 5ub: !(true) produces BoolVal(false)", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "x := !(true);\nexport(x);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(v.get(usize(0)),.Some(x) => match(x,.BoolVal(b) => assert(!(b), "not true"), _ => assert(false, "t")),.None => assert(false, "v"));
      },
      _ => assert(false, "m")
    )
  );
});
