// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5u series: assert, NOT, negation, pass-throughs, type constructors.
///
/// Phases covered:
///   5ua — assert(cond) / comptime_assert(cond) in source strings
///   5ub — logical NOT !(expr) + unary negation -(expr)
///   5uc — runtime(expr) / dyn(expr) / comptime(expr) pass-throughs
///   5ud — type constructors (Option, Result, Box, Pointer, Slice, Future, Array, HashMap, Impl, Fn)
///   5ue — type_of / size_of / align_of / println / print / unreachable / panic / todo / derive
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5ua — assert + comptime_assert in source strings
// ---------------------------------------------------------------------------
test("Phase 5ua: assert(true, msg) in source — evaluator succeeds", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "assert(true, \"ok\");\nexport(i32(1));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "v"), _ => assert(false, "t")),.None => assert(false, "v"));
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5ua: assert(false, msg) in source — evaluator returns None", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "assert(false, \"bad\");\nexport(i32(1));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result,.None => (),.Some(_) => assert(false, "should fail"));
});
