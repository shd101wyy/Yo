  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8)];\ncount := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)({\nsq := (x * x);\ncube := (sq * x);\ncond((cube < i32(500)) => (acc + i32(1)), true => acc)\n}));\nexport(count);\n";
