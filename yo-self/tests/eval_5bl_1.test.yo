  src := "count := i32(0);\ni := i32(1);\nwhile((i <= i32(20)), {\ncount = cond(((i % i32(2)) == i32(1)) => (count + i32(1)), true => count);\ni = (i + i32(1));\n});\nexport(count);\n";
