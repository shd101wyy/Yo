  );
});
test("Phase 5ble: filter then map then fold — squared evens sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1..6] filter even=[2,4,6] square=[4,16,36] sum=56
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6)];\nevens := arr.filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(0))));\nsquared := evens.map((fn(x : i32) -> i32)((x * x)));\ntotal := squared.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "56", "56"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5ble: grand combo — Fibonacci + divisors + filter-sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // fib after 6 iters from a=0,b=1: b=13; divisors(13)=2 (1,13 prime); filter [4,7,10,13]>=7: 7+10+13=30; total=13+2+30=45
  src := "a := i32(0);\nb := i32(1);\ni := i32(0);\nwhile((i < i32(6)), {\nt := b;\nb = (a + b);\na = t;\ni = (i + i32(1));\n});\nfib_val := b;\ndiv_count := i32(0);\nj := i32(1);\nwhile((j <= fib_val), {\ndiv_count = cond(((fib_val % j) == i32(0)) => (div_count + i32(1)), true => div_count);\nj = (j + i32(1));\n});\narr := [i32(4), i32(7), i32(10), i32(13)];\nfilt_sum := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)(cond((x >= i32(7)) => (acc + x), true => acc)));\ntotal := ((fib_val + div_count) + filt_sum);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "45", "45"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
