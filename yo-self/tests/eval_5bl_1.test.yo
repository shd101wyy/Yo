test("Phase 5bld: zip products where sum exceeds 7", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[1..5] b=[6..10] all pairs sum: 7,9,11,13,15 → filter >7: (2,7),(3,8),(4,9),(5,10) → products=14+24+36+50=124
  src := "a := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nb := [i32(6), i32(7), i32(8), i32(9), i32(10)];\npairs := a.zip(b);\ntotal := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)({\ncond(((p.0 + p.1) > i32(7)) => (acc + (p.0 * p.1)), true => acc)\n}));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "124", "124"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bld: three arrays zip — sum of element-wise maximums", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[1,9,2] b=[5,3,8] → zip ab → max each: a=(1,5)→5 b=(9,3)→9 c=(2,8)→8 → sum=22; then zip with c=[4,6,7] → max of each pair with c
  // Actually: max3(1,5,4)=5, max3(9,3,6)=9, max3(2,8,7)=8 → sum=22
  src := "a := [i32(1), i32(9), i32(2)];\nb := [i32(5), i32(3), i32(8)];\nc := [i32(4), i32(6), i32(7)];\nab := a.zip(b);\nab_max := ab.map((fn(p : (i32, i32)) -> i32)(cond((p.0 > p.1) => p.0, true => p.1)));\nabc := ab_max.zip(c);\ntotal := abc.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)({\ncond((p.0 > p.1) => (acc + p.0), true => (acc + p.1))\n}));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "22", "22"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bld: filter map zip — grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[1..8] filter even=[2,4,6,8]; b=[8..1] filter odd=[7,5,3,1]; zip [(2,7),(4,5),(6,3),(8,1)]; sum products=14+20+18+8=60
  src := "a := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8)];\nb := [i32(8), i32(7), i32(6), i32(5), i32(4), i32(3), i32(2), i32(1)];\na_evens := a.filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(0))));\nb_odds := b.filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(1))));\npairs := a_evens.zip(b_odds);\ntotal := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)((acc + (p.0 * p.1))));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "60", "60"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bld: grand combo — digit sum + divisor-count + fold sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // digit_sum(123)=6; divisors_of_12=6; arr=[1,2,3] sum=6; total=6+6+6=18
  src := "n := i32(123);\nd_sum := i32(0);\nwhile((n > i32(0)), {\nd_sum = (d_sum + (n % i32(10)));\nn = (n / i32(10));\n});\nm := i32(12);\nd_count := i32(0);\nj := i32(1);\nwhile((j <= m), {\nd_count = cond(((m % j) == i32(0)) => (d_count + i32(1)), true => d_count);\nj = (j + i32(1));\n});\narr := [i32(1), i32(2), i32(3)];\narr_sum := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\ntotal := ((d_sum + d_count) + arr_sum);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "18", "18"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
