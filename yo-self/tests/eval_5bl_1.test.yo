test("Phase 5blc: while accumulate absolute differences", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // |5-3|+|5-7|+|5-1|+|5-9|+|5-4| = 2+2+4+4+1 = 13
  src := "arr := [i32(3), i32(7), i32(1), i32(9), i32(4)];\ncenter := i32(5);\ntotal := i32(0);\ni := i32(0);\nwhile((i < i32(5)), {\nv := arr.get(usize(i));\ntotal = match(v, .Some(x) => {\nd := (center - x);\nabs_d := cond((d < i32(0)) => (i32(0) - d), true => d);\n(total + abs_d)\n}, .None => total);\ni = (i + i32(1));\n});\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "13", "13"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
// ---------------------------------------------------------------------------
// Phase 5bld — multi-array grand combos
