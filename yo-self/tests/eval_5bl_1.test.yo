test("Phase 5blc: count elements where square exceeds 30", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,2,3,4,5,6,7] squares=[1,4,9,16,25,36,49] >30: [36,49] count=2
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7)];\ncount := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)({\nsq := (x * x);\ncond((sq > i32(30)) => (acc + i32(1)), true => acc)\n}));\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
