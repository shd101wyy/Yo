test("Phase 5blb: count even-length strings", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // ['yo','hello','hi','world','cat','ok'] → even-len: yo(2),hi(2),ok(2) → count=3
  src := "words := [\"yo\", \"hello\", \"hi\", \"world\", \"cat\", \"ok\"];\ncount := words.fold(i32(0), (fn(acc : i32, w : str) -> i32)({\ncond(((w.len() % i32(2)) == i32(0)) => (acc + i32(1)), true => acc)\n}));\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5blb: count same-length pairs", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=['hi','bye','yo','abc'] b=['no','hey','ok','def'] → same len: hi/no(2/2), yo/ok(2/2), abc/def(3/3) and bye/hey(3/3) → count=4
  src := "a := [\"hi\", \"bye\", \"yo\", \"abc\"];\nb := [\"no\", \"hey\", \"ok\", \"def\"];\npairs := a.zip(b);\ncount := pairs.fold(i32(0), (fn(acc : i32, p : (str, str)) -> i32)({\ncond((p.0.len() == p.1.len()) => (acc + i32(1)), true => acc)\n}));\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
