test("Phase 5buc: sum of Fibonacci at 1-indexed positions divisible by 3 (positions 3,6,9) = 44", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // Fib(3)=2, Fib(6)=8, Fib(9)=34 => 2+8+34=44
  src := "a := i32(1);\nb := i32(1);\ni := i32(1);\ns := i32(0);\nwhile((i <= i32(9)), {\nge3 := cond(((i % i32(3)) == i32(0)) => i32(1), true => i32(0));\ns = (s + (ge3 * a));\nt := (a + b);\na = b;\nb = t;\ni = (i + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "44", "44"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5bud — grand combos (row sums)
// ---------------------------------------------------------------------------
test("Phase 5bud: pow2_sum + pow3_sum + pow2mod100_sum = 1023+364+223 = 1610", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "i := i32(0);\ns1 := i32(0);\np := i32(1);\nwhile((i < i32(10)), {\ns1 = (s1 + p);\np = (p * i32(2));\ni = (i + i32(1));\n});\ni2 := i32(0);\ns2 := i32(0);\np2 := i32(1);\nwhile((i2 < i32(6)), {\ns2 = (s2 + p2);\np2 = (p2 * i32(3));\ni2 = (i2 + i32(1));\n});\ni3 := i32(0);\ns3 := i32(0);\np3 := i32(1);\nwhile((i3 < i32(10)), {\ns3 = (s3 + (p3 % i32(100)));\np3 = (p3 * i32(2));\ni3 = (i3 + i32(1));\n});\nresult := ((s1 + s2) + s3);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1610", "1610"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
