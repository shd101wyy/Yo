test("Phase 5buc: sum of first 8 Fibonacci numbers (1,1,2,3,5,8,13,21) = 54", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "a := i32(1);\nb := i32(1);\ns := i32(0);\ncnt := i32(0);\nwhile((cnt < i32(8)), {\ns = (s + a);\nt := (a + b);\na = b;\nb = t;\ncnt = (cnt + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "54", "54"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
