test("Phase 5bua: count k in 0..9 where 2^k >= 10 = 6", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 2^4=16,2^5=32,...,2^9=512 => 6 values
  src := "i := i32(0);\ncnt := i32(0);\np := i32(1);\nwhile((i < i32(10)), {\nge10 := cond((p >= i32(10)) => i32(1), true => i32(0));\ncnt = (cnt + ge10);\np = (p * i32(2));\ni = (i + i32(1));\n});\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "6"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5bub — modular arithmetic patterns
// ---------------------------------------------------------------------------
test("Phase 5bub: sum of n mod 7 for n=1..20 = 63", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // two full cycles of 0+1+2+3+4+5+6=21 plus partial => 21*3=63
  src := "n := i32(1);\ns := i32(0);\nwhile((n <= i32(20)), {\ns = (s + (n % i32(7)));\nn = (n + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "63", "63"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bub: count n in 1..50 where n%5==0 AND n%7==0 = 1", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // only n=35 satisfies both => count=1
  src := "n := i32(1);\ncnt := i32(0);\nwhile((n <= i32(50)), {\nm5 := cond(((n % i32(5)) == i32(0)) => i32(1), true => i32(0));\nm7 := cond(((n % i32(7)) == i32(0)) => i32(1), true => i32(0));\ncnt = (cnt + (m5 * m7));\nn = (n + i32(1));\n});\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "1"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bub: sum n in 1..30 where n%3==1 AND n%4==2 = 32", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // n=10 (10%3=1, 10%4=2) and n=22 (22%3=1, 22%4=2) => 10+22=32
  src := "n := i32(1);\ns := i32(0);\nwhile((n <= i32(30)), {\nm3 := cond(((n % i32(3)) == i32(1)) => i32(1), true => i32(0));\nm4 := cond(((n % i32(4)) == i32(2)) => i32(1), true => i32(0));\ns = (s + ((m3 * m4) * n));\nn = (n + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "32", "32"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bub: sum of squares of non-multiples of 3 in 1..10 = 259", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 1+4+16+25+49+64+100 = 259 (skip 9,36,81)
  src := "n := i32(1);\ns := i32(0);\nwhile((n <= i32(10)), {\nnotm3 := cond(((n % i32(3)) != i32(0)) => i32(1), true => i32(0));\ns = (s + (notm3 * (n * n)));\nn = (n + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "259", "259"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

