/// Tests for yo-self/codegen/exprs/drop_dup.yo (partial port —
/// leaf drop and dup code emit).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue, t_i32, t_bool } :: import("../types/type.yo");
{ type_to_string } :: import("../types/string.yo");
{ CodegenContext, CodegenTypeEntry } :: import("../codegen/context.yo");
{
  generate_drop_code_for_leaf_type,
  generate_dup_code_for_leaf_type
} :: import("../codegen/exprs/drop_dup.yo");
mk_struct :: (
  fn(
    name : str,
    is_reference_semantics : bool,
    is_atomic_rc : bool,
    is_newtype : bool
  ) -> TypeValue
)(
  TypeValue.Struct(
    String.from(""),
    String.from(name),
    ArrayList(String).new(),
    ArrayList(TypeValue).new(),
    is_reference_semantics,
    is_atomic_rc,
    is_newtype
  )
);
mk_dyn :: (fn() -> TypeValue)({
  empty_traits := ArrayList(TypeValue).new();
  empty_levels := ArrayList(usize).new();
  TypeValue.DynT(empty_traits, empty_levels, empty_traits.clone(), empty_levels.clone())
});
test("leaf drop: Dyn(T) emits decr_rc on the .data slot", {
  dyn_ty := mk_dyn();
  out := generate_drop_code_for_leaf_type(String.from("x"), dyn_ty);
  match(
    out,
    .Some(s) => assert(
      s == String.from("__yo_decr_rc((void*)(x).data)"),
      "Dyn decr"
    ),
    .None => assert(false, "expected Some for Dyn")
  );
});
test("leaf drop: non-atomic Object emits non-atomic decr_rc", {
  obj := mk_struct("Counter", true, false, false);
  out := generate_drop_code_for_leaf_type(String.from("y"), obj);
  match(
    out,
    .Some(s) => assert(
      s == String.from("__yo_decr_rc((void*)(y))"),
      "object decr"
    ),
    .None => assert(false, "expected Some for object")
  );
});
test("leaf drop: atomic Object emits atomic decr_rc", {
  atom := mk_struct("Atomic", true, true, false);
  out := generate_drop_code_for_leaf_type(String.from("z"), atom);
  match(
    out,
    .Some(s) => assert(
      s == String.from("__yo_decr_rc_atomic((void*)(z))"),
      "atomic decr"
    ),
    .None => assert(false, "expected Some for atomic object")
  );
});
test("leaf drop: Iso(T) emits atomic decr_rc", {
  iso_ty := TypeValue.IsoT(box(t_i32()));
  out := generate_drop_code_for_leaf_type(String.from("w"), iso_ty);
  match(
    out,
    .Some(s) => assert(
      s == String.from("__yo_decr_rc_atomic((void*)(w))"),
      "iso decr"
    ),
    .None => assert(false, "expected Some for Iso")
  );
});
test("leaf drop: value-semantics struct returns None (defer)", {
  val := mk_struct("Point", false, false, false);
  assert(
    generate_drop_code_for_leaf_type(String.from("p"), val).is_none(),
    "value struct → None"
  );
});
test("leaf drop: primitive types return None (defer)", {
  assert(
    generate_drop_code_for_leaf_type(String.from("n"), t_i32()).is_none(),
    "i32 → None"
  );
  assert(
    generate_drop_code_for_leaf_type(String.from("b"), t_bool()).is_none(),
    "bool → None"
  );
});
test("leaf drop: precedence — atomic object before plain object", {
  // mk_struct sets BOTH is_reference_semantics and is_atomic_rc.
  // The output must come from the atomic branch, not the object branch.
  atomic := mk_struct("AtomicCell", true, true, false);
  out := generate_drop_code_for_leaf_type(String.from("a"), atomic);
  match(
    out,
    .Some(s) => assert(
      s == String.from("__yo_decr_rc_atomic((void*)(a))"),
      "atomic chosen over object"
    ),
    .None => assert(false, "expected Some")
  );
});
test("leaf drop: complex value_code expressions are wrapped in parens", {
  obj := mk_struct("Box", true, false, false);
  out := generate_drop_code_for_leaf_type(String.from("a + b"), obj);
  match(
    out,
    .Some(s) => assert(
      s == String.from("__yo_decr_rc((void*)(a + b))"),
      "complex expr wrapped"
    ),
    .None => assert(false, "expected Some")
  );
});
/// Helper: register `ty` under `c_name` in `ctx.types`, mirroring how
/// the bootstrap codegen populates the registry for object / iso / dyn
/// types before lookups occur.
install_type :: (
  fn(ctx : *(CodegenContext), ty : TypeValue, c_name : str) -> unit
)({
  entry := CodegenTypeEntry(type_value : ty, c_name : String.from(c_name));
  _ := ctx.*.types.set(type_to_string(ty), entry);
});
test("leaf dup: non-atomic Object emits cast + incr_rc", {
  obj := mk_struct("Counter", true, false, false);
  ctx := CodegenContext.new();
  install_type(&(ctx), obj, "yo_counter");
  out := generate_dup_code_for_leaf_type(String.from("y"), obj, &(ctx));
  match(
    out,
    .Some(s) => assert(
      s == String.from("((yo_counter)__yo_incr_rc((void*)(y)))"),
      "object dup"
    ),
    .None => assert(false, "expected Some")
  );
});
test("leaf dup: atomic Object emits cast + atomic incr_rc", {
  atom := mk_struct("AtomicCell", true, true, false);
  ctx := CodegenContext.new();
  install_type(&(ctx), atom, "yo_atomic_cell");
  out := generate_dup_code_for_leaf_type(String.from("z"), atom, &(ctx));
  match(
    out,
    .Some(s) => assert(
      s == String.from("((yo_atomic_cell)__yo_incr_rc_atomic((void*)(z)))"),
      "atomic dup"
    ),
    .None => assert(false, "expected Some")
  );
});
test("leaf dup: Iso(T) emits cast + atomic incr_rc", {
  iso_ty := TypeValue.IsoT(box(t_i32()));
  ctx := CodegenContext.new();
  install_type(&(ctx), iso_ty, "__yo_iso_i32");
  out := generate_dup_code_for_leaf_type(String.from("w"), iso_ty, &(ctx));
  match(
    out,
    .Some(s) => assert(
      s == String.from("((__yo_iso_i32)__yo_incr_rc_atomic((void*)(w)))"),
      "iso dup"
    ),
    .None => assert(false, "expected Some")
  );
});
test("leaf dup: Dyn(T) emits struct literal with .data and .vtable", {
  dyn_ty := mk_dyn();
  ctx := CodegenContext.new();
  install_type(&(ctx), dyn_ty, "yo_dyn_trait");
  out := generate_dup_code_for_leaf_type(String.from("d"), dyn_ty, &(ctx));
  match(
    out,
    .Some(s) => assert(
      s == String.from("((yo_dyn_trait){ .data = __yo_incr_rc((void*)(d).data), .vtable = (d).vtable })"),
      "dyn dup struct literal"
    ),
    .None => assert(false, "expected Some")
  );
});
test("leaf dup: value-semantics struct returns None (defer)", {
  val := mk_struct("Point", false, false, false);
  ctx := CodegenContext.new();
  assert(
    generate_dup_code_for_leaf_type(String.from("p"), val, &(ctx)).is_none(),
    "value struct → None"
  );
});
test("leaf dup: primitive types return None (defer)", {
  ctx := CodegenContext.new();
  assert(
    generate_dup_code_for_leaf_type(String.from("n"), t_i32(), &(ctx)).is_none(),
    "i32 → None"
  );
  assert(
    generate_dup_code_for_leaf_type(String.from("b"), t_bool(), &(ctx)).is_none(),
    "bool → None"
  );
});
test("leaf dup: unregistered Object falls back to int32_t cast", {
  // The canonical `get_type_string` uses `int32_t` as its fallback
  // when neither the registry nor `type_value_to_c_field` matches.
  // For an unregistered object type this gives a (technically wrong)
  // `((int32_t)__yo_incr_rc((void*)(x)))` — same as TS getTypeString.
  obj := mk_struct("Unregistered", true, false, false);
  ctx := CodegenContext.new();
  out := generate_dup_code_for_leaf_type(String.from("u"), obj, &(ctx));
  match(
    out,
    .Some(s) => assert(
      s == String.from("((int32_t)__yo_incr_rc((void*)(u)))"),
      "fallback to int32_t cast"
    ),
    .None => assert(false, "expected Some")
  );
});
