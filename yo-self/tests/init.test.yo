open(import("std/string"));
open(import("std/fmt"));
{
  sanitize_project_name,
  generate_build_yo,
  generate_main_source,
  generate_lib_source,
  generate_test_file,
  generate_deps_yo,
  generate_gitignore,
  generate_readme
} :: import("../init.yo");
// ---------------------------------------------------------------------------
// sanitize_project_name
// ---------------------------------------------------------------------------
test("sanitize_project_name: alphanumeric unchanged", {
  name := sanitize_project_name(String.from("my_project-123"));
  assert(name == "my_project-123", "valid chars unchanged");
});
test("sanitize_project_name: spaces replaced with hyphens", {
  name := sanitize_project_name(String.from("my project"));
  assert(name == "my-project", "spaces become hyphens");
});
test("sanitize_project_name: dots replaced with hyphens", {
  name := sanitize_project_name(String.from("my.project"));
  assert(name == "my-project", "dots become hyphens");
});
test("sanitize_project_name: mixed special chars", {
  name := sanitize_project_name(String.from("foo@bar!baz"));
  assert(name == "foo-bar-baz", "special chars replaced");
});
test("sanitize_project_name: empty string returns empty", {
  name := sanitize_project_name(String.from(""));
  assert(name.len() == usize(0), "empty in, empty out");
});
// ---------------------------------------------------------------------------
// generate_build_yo
// ---------------------------------------------------------------------------
test("generate_build_yo: contains project name", {
  out := generate_build_yo(String.from("myapp"));
  assert(out.contains(String.from("myapp")), "build.yo contains project name");
});
test("generate_build_yo: contains install step", {
  out := generate_build_yo(String.from("x"));
  assert(out.contains(String.from("install")), "build.yo has install step");
});
// ---------------------------------------------------------------------------
// generate_readme
// ---------------------------------------------------------------------------
test("generate_readme: contains project name as heading", {
  out := generate_readme(String.from("cool-lib"));
  assert(out.contains(String.from("cool-lib")), "README contains project name");
});
// ---------------------------------------------------------------------------
// generate_* pure string functions compile and return non-empty
// ---------------------------------------------------------------------------
test("generate_main_source: non-empty", {
  s := String.from(generate_main_source());
  assert(s.len() > usize(0), "main source is non-empty");
});
test("generate_lib_source: non-empty", {
  s := String.from(generate_lib_source());
  assert(s.len() > usize(0), "lib source is non-empty");
});
test("generate_test_file: non-empty", {
  s := String.from(generate_test_file());
  assert(s.len() > usize(0), "test file is non-empty");
});
test("generate_deps_yo: contains export(imports)", {
  s := String.from(generate_deps_yo());
  assert(s.contains(String.from("export(imports)")), "deps.yo exports imports");
});
test("generate_gitignore: contains yo-out/", {
  s := String.from(generate_gitignore());
  assert(s.contains(String.from("yo-out/")), "gitignore excludes yo-out/");
});
