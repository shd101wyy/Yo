test("Phase 5db: boolean xor via != operator", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape(()); }));
  src := "xor := (fn(a : bool, b : bool) -> bool)((a != b)); r1 := xor(true, false); r2 := xor(true, true); export(r1); export(r2);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(2)), "2 exports");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(b, "true xor false = true"),
            _ => assert(false, "r1 not BoolVal")
          ),
          .None => assert(false, "no r1")
        );
        match(vals.get(usize(1)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(!(b), "true xor true = false"),
            _ => assert(false, "r2 not BoolVal")
          ),
          .None => assert(false, "no r2")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
});

test("Phase 5db: array filter odds then len", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape(()); }));
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8), i32(9), i32(10)]; odds := arr.filter((fn(x : i32) -> bool)(((x % i32(2)) != i32(0)))); r := odds.len(); export(r);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
