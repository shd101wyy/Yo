test("Phase 5da: sum of squares via fold", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape(()); }));
  src := "arr := [i32(1), i32(2), i32(3), i32(4)]; r := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + (x * x)))); export(r);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "30"), "1+4+9+16=30"),
            _ => assert(false, "not IntLit")
          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
});

test("Phase 5da: fibonacci iterative while", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape(()); }));
  src := "fib := (fn(n : i32) -> i32)({ (a : i32) = i32(0); (b : i32) = i32(1); (i : i32) = i32(0); while((i < n), { (tmp : i32) = b; b = (a + b); a = tmp; i = (i + i32(1)); }); a }); r := fib(i32(10)); export(r);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "55"), "fib(10)=55"),
            _ => assert(false, "not IntLit")
          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
});

