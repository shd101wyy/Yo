test("Phase 5da: multiple exports int and bool", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape(()); }));
  src := "x := i32(42); y := true; z := i32(7); export(x); export(y); export(z);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(3)), "3 exports");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "42"), "x=42"),
            _ => assert(false, "x not IntLit")
          ),
          .None => assert(false, "no x")
        );
        match(vals.get(usize(1)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(b, "y=true"),
            _ => assert(false, "y not BoolVal")
          ),
          .None => assert(false, "no y")
        );
        match(vals.get(usize(2)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "7"), "z=7"),
            _ => assert(false, "z not IntLit")
          ),
          .None => assert(false, "no z")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
});

