open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ assert, panic } :: import("std/assert");
{
  LockEntry,
  LockFile,
  parse_lock_file,
  write_lock_file_content,
  find_lock_entry,
  upsert_lock_entry
} :: import("../lock_file.yo");
// ---------------------------------------------------------------------------
// parse_lock_file tests
// ---------------------------------------------------------------------------
test("parse_lock_file: empty string returns empty lock file", {
  lock := parse_lock_file(String.from(""));
  assert(lock.dependencies.len() == usize(0), "empty content → no deps");
});
test("parse_lock_file: single dependency", {
  content := String.from("[[dependencies]]\nname   = \"json-parser\"\nurl    = \"https://github.com/user/json-parser.git\"\nref    = \"v1.0.0\"\ncommit = \"abc123\"\nhash   = \"sha256-XXXXX\"\n");
  lock := parse_lock_file(content);
  assert(lock.dependencies.len() == usize(1), "one dep");
  dep_opt := lock.dependencies.get(usize(0));
  match(
    dep_opt,
    .None => assert(false, "dep at index 0 expected"),
    .Some(dep) => {
      assert(dep.name == "json-parser", "name");
      assert(dep.url == "https://github.com/user/json-parser.git", "url");
      assert(dep.ref == "v1.0.0", "ref");
      assert(dep.commit == "abc123", "commit");
      assert(dep.hash == "sha256-XXXXX", "hash");
    }
  );
});
test("parse_lock_file: two dependencies", {
  content := String.from("[[dependencies]]\nname   = \"dep-a\"\nurl    = \"https://github.com/a/a.git\"\nref    = \"v1.0.0\"\ncommit = \"aaa\"\nhash   = \"sha256-AAA\"\n\n[[dependencies]]\nname   = \"dep-b\"\nurl    = \"https://github.com/b/b.git\"\nref    = \"main\"\ncommit = \"bbb\"\nhash   = \"sha256-BBB\"\n");
  lock := parse_lock_file(content);
  assert(lock.dependencies.len() == usize(2), "two deps");
  a_opt := lock.dependencies.get(usize(0));
  b_opt := lock.dependencies.get(usize(1));
  match(
    a_opt,
    .None => assert(false, "dep-a missing"),
    .Some(a) => {
      assert(a.name == "dep-a", "first dep is dep-a");
    }
  );
  match(
    b_opt,
    .None => assert(false, "dep-b missing"),
    .Some(b) => {
      assert(b.name == "dep-b", "second dep is dep-b");
    }
  );
});
test("parse_lock_file: comments and blank lines are skipped", {
  content := String.from("# auto-generated\n\n[[dependencies]]\n# a comment\nname   = \"x\"\nurl    = \"https://example.com/x.git\"\nref    = \"HEAD\"\ncommit = \"ccc\"\nhash   = \"sha256-CCC\"\n");
  lock := parse_lock_file(content);
  assert(lock.dependencies.len() == usize(1), "comments ignored, one dep");
});
test("parse_lock_file: missing ref defaults to HEAD", {
  content := String.from("[[dependencies]]\nname   = \"no-ref\"\nurl    = \"https://github.com/x/y.git\"\ncommit = \"ddd\"\nhash   = \"sha256-DDD\"\n");
  lock := parse_lock_file(content);
  dep_opt := lock.dependencies.get(usize(0));
  match(
    dep_opt,
    .None => assert(false, "dep expected"),
    .Some(dep) => assert(dep.ref == "HEAD", "default ref is HEAD")
  );
});
// ---------------------------------------------------------------------------
// write_lock_file_content tests
// ---------------------------------------------------------------------------
test("write_lock_file_content: empty lock file has header only", {
  lock := LockFile.empty();
  out := write_lock_file_content(lock);
  assert(out.contains(String.from("auto-generated")), "header present");
});
test("write_lock_file_content: round-trip single dependency", {
  dep := LockEntry(
    name : String.from("mylib"),
    url : String.from("https://github.com/user/mylib.git"),
    ref : String.from("v2.0.0"),
    commit : String.from("deadbeef"),
    hash : String.from("sha256-FFFF")
  );
  deps := ArrayList(LockEntry).new();
  deps.push(dep);
  lock := LockFile(dependencies : deps);
  out := write_lock_file_content(lock);
  reparsed := parse_lock_file(out);
  assert(reparsed.dependencies.len() == usize(1), "one dep after round-trip");
  entry_opt := reparsed.dependencies.get(usize(0));
  match(
    entry_opt,
    .None => assert(false, "entry expected"),
    .Some(e) => {
      assert(e.name == "mylib", "name");
      assert(e.url == "https://github.com/user/mylib.git", "url");
      assert(e.ref == "v2.0.0", "ref");
      assert(e.commit == "deadbeef", "commit");
      assert(e.hash == "sha256-FFFF", "hash");
    }
  );
});
// ---------------------------------------------------------------------------
// find_lock_entry tests
// ---------------------------------------------------------------------------
test("find_lock_entry: returns None for unknown name", {
  lock := LockFile.empty();
  result := find_lock_entry(lock, String.from("unknown"));
  match(result,.Some(_) => assert(false, "expected None"),.None => ());
});
test("find_lock_entry: finds existing entry by name", {
  dep := LockEntry(
    name : String.from("found"),
    url : String.from("https://github.com/x/found.git"),
    ref : String.from("v1.0.0"),
    commit : String.from("aaabbb"),
    hash : String.from("sha256-AB")
  );
  deps := ArrayList(LockEntry).new();
  deps.push(dep);
  lock := LockFile(dependencies : deps);
  result := find_lock_entry(lock, String.from("found"));
  match(
    result,
    .None => assert(false, "expected Some"),
    .Some(e) => assert(e.name == "found", "correct entry returned")
  );
});
// ---------------------------------------------------------------------------
// upsert_lock_entry tests
// ---------------------------------------------------------------------------
test("upsert_lock_entry: inserts new entry into empty lock", {
  lock := LockFile.empty();
  entry := LockEntry(
    name : String.from("new"),
    url : String.from("https://github.com/x/new.git"),
    ref : String.from("v0.1.0"),
    commit : String.from("fffff"),
    hash : String.from("sha256-FF")
  );
  updated := upsert_lock_entry(lock, entry);
  assert(updated.dependencies.len() == usize(1), "one dep after insert");
});
test("upsert_lock_entry: replaces existing entry with same name", {
  old_dep := LockEntry(
    name : String.from("lib"),
    url : String.from("https://github.com/x/lib.git"),
    ref : String.from("v1.0.0"),
    commit : String.from("old"),
    hash : String.from("sha256-OLD")
  );
  deps := ArrayList(LockEntry).new();
  deps.push(old_dep);
  lock := LockFile(dependencies : deps);
  new_dep := LockEntry(
    name : String.from("lib"),
    url : String.from("https://github.com/x/lib.git"),
    ref : String.from("v2.0.0"),
    commit : String.from("new"),
    hash : String.from("sha256-NEW")
  );
  updated := upsert_lock_entry(lock, new_dep);
  assert(updated.dependencies.len() == usize(1), "still one dep");
  entry_opt := updated.dependencies.get(usize(0));
  match(
    entry_opt,
    .None => assert(false, "entry expected"),
    .Some(e) => {
      assert(e.commit == "new", "commit replaced");
      assert(e.ref == "v2.0.0", "ref replaced");
    }
  );
});
test("upsert_lock_entry: preserves other entries", {
  dep_a := LockEntry(
    name : String.from("a"),
    url : String.from("https://github.com/x/a.git"),
    ref : String.from("v1.0.0"),
    commit : String.from("aaa"),
    hash : String.from("sha256-A")
  );
  dep_b := LockEntry(
    name : String.from("b"),
    url : String.from("https://github.com/x/b.git"),
    ref : String.from("v1.0.0"),
    commit : String.from("bbb"),
    hash : String.from("sha256-B")
  );
  deps := ArrayList(LockEntry).new();
  deps.push(dep_a);
  deps.push(dep_b);
  lock := LockFile(dependencies : deps);
  new_dep_a := LockEntry(
    name : String.from("a"),
    url : String.from("https://github.com/x/a.git"),
    ref : String.from("v2.0.0"),
    commit : String.from("aaa2"),
    hash : String.from("sha256-A2")
  );
  updated := upsert_lock_entry(lock, new_dep_a);
  assert(updated.dependencies.len() == usize(2), "still two deps");
  b_opt := find_lock_entry(updated, String.from("b"));
  match(
    b_opt,
    .None => assert(false, "dep-b should still be there"),
    .Some(b) => assert(b.commit == "bbb", "dep-b unchanged")
  );
});
