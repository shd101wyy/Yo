      _ => assert(false, "m")
    )
  );
});

test("Phase 5azd: abs value via cond expression", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "my_abs := (fn(x : i32) -> i32)(cond((x < i32(0)) => (i32(0) - x), true => x));\nexport(my_abs((i32(0) - i32(7))));\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "7", "7"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5aze — Mixed grand combos
// ---------------------------------------------------------------------------
test("Phase 5aze: boolean array all check via all predicate", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "nums := [i32(2), i32(4), i32(6), i32(8), i32(10)];\nall_even := nums.all((fn(x : i32) -> bool)(((x % i32(2)) == i32(0))));\nexport(all_even);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "true"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5aze: slice of sorted array then min via fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(5), i32(3), i32(8), i32(1), i32(9), i32(2)];\nsliced := arr.slice(usize(1), usize(4));\nmin_val := sliced.fold(i32(999), (fn(acc : i32, x : i32) -> i32)(cond((x < acc) => x, true => acc)));\nexport(min_val);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "1"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5aze: concat filter and count via fold returns correct total", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "a := [i32(1), i32(2), i32(3)];\nb := [i32(4), i32(5), i32(6), i32(7)];\nbig := a.concat(b).filter((fn(x : i32) -> bool)((x > i32(3))));\nexport(big.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "4"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5aze: uppercase map then join with separator", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "words := [\"yo\", \"is\", \"great\"];\nupper := words.map((fn(w : str) -> str)(w.to_uppercase()));\njoined := upper.join(\" | \");\nexport(joined);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .StrLit(raw) => assert(raw.as_str() == "\"YO | IS | GREAT\"", "YO | IS | GREAT"),
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
