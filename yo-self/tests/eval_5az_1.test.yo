// ---------------------------------------------------------------------------
// Phase 5azd — Conditional assignment patterns
// ---------------------------------------------------------------------------
test("Phase 5azd: conditional assignment via cond expression", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "score := i32(85);\ngrade := cond((score >= i32(90)) => \"A\", (score >= i32(80)) => \"B\", (score >= i32(70)) => \"C\", true => \"F\");\nexport(grade);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .StrLit(raw) => assert(raw.as_str() == "\"B\"", "B"),
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5azd: count even numbers 1 to 10 via while loop", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "(n : i32) = i32(1);\n(count : i32) = i32(0);\nwhile((n <= i32(10)), {\nif(((n % i32(2)) == i32(0)), {\ncount = (count + i32(1));\n});\nn = (n + i32(1));\n});\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "5"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

