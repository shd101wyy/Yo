test("Phase 5sc: enumerate count tuples where index is even", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "arr := [i32(1), i32(2), i32(3), i32(4)];\ne := arr.enumerate();\ncount := e.fold(i32(0), (fn(acc : i32, pair : i32) -> i32)({ cond(((pair.0 % i32(2)) == i32(0)) => (acc + i32(1)), true => acc) }));\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "2", "count=2"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
