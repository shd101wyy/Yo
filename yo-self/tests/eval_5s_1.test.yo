// ---------------------------------------------------------------------------
// Phase 5sc — arr.enumerate() via source strings
// ---------------------------------------------------------------------------
test("Phase 5sc: enumerate len of 3-element array is 3", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "arr := [i32(1), i32(2), i32(3)];\nenumerated := arr.enumerate();\nexport(enumerated.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "3", "len=3"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
