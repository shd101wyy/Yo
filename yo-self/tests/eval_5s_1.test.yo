  }, _ => assert(false, "m")));
});
test("Phase 5sc: enumerate sum of indices via fold", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "arr := [i32(10), i32(20), i32(30)];\nenumerated := arr.enumerate();\ntotal := enumerated.fold(i32(0), (fn(acc : i32, pair : i32) -> i32)({ (acc + pair.0) }));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "3", "sum_idx=3"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
