test("Phase 5bje: fold min element from array", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [7,3,9,1,5,8,2] → min=1 (start fold at first element 7)
  src := "arr := [i32(7), i32(3), i32(9), i32(1), i32(5), i32(8), i32(2)];\nmin_val := arr.fold(i32(999), (fn(acc : i32, x : i32) -> i32)({\ncond((x < acc) => x, true => acc)\n}));\nexport(min_val);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "1"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bje: while power then subtract square", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 2^7=128; 10^2=100; result=128-100=28
  src := "base := i32(2);\nexp := i32(7);\npow := i32(1);\ni := i32(0);\nwhile((i < exp), {\npow = (pow * base);\ni = (i + i32(1));\n});\nresult := (pow - i32(100));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "28", "28"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bje: zip with running accumulator in fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[1,2,3,4,5] b=[5,4,3,2,1] → diffs=[4,2,0,-2,-4] → sum abs: fold |d|
  // |4|+|2|+|0|+|2|+|4|=12
  src := "a := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nb := [i32(5), i32(4), i32(3), i32(2), i32(1)];\npairs := a.zip(b);\nabs_sum := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)({\nd := (p.1 - p.0);\nabs_d := cond((d < i32(0)) => (i32(0) - d), true => d);\n(acc + abs_d)\n}));\nexport(abs_sum);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "12", "12"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bje: grand combo — string len + zip max + while", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // str total len: ["yo","hello","world"] = 2+5+5=12
  // zip max: a=[1,9,3] b=[8,2,7] → max each=[8,9,7] → sum=24
  // while: sum 1+2+3=6
  // grand = 12 + 24 - 6 = 30
  src := "words := [\"yo\", \"hello\", \"world\"];\nstr_len := words.fold(i32(0), (fn(acc : i32, w : str) -> i32)((acc + w.len())));\na := [i32(1), i32(9), i32(3)];\nb := [i32(8), i32(2), i32(7)];\npairs := a.zip(b);\nmax_sum := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)({\ncond((p.0 > p.1) => (acc + p.0), true => (acc + p.1))\n}));\ni := i32(1);\nloop_sum := i32(0);\nwhile((i <= i32(3)), {\nloop_sum = (loop_sum + i);\ni = (i + i32(1));\n});\nresult := ((str_len + max_sum) - loop_sum);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "30", "30"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
