  src := "arr := [i32(10), i32(25), i32(40), i32(55), i32(70)];\nbucket_sum := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)({\nb := cond((x < i32(20)) => i32(1), (x < i32(40)) => i32(2), (x < i32(60)) => i32(3), true => i32(4));\n(acc + b)\n}));\nexport(bucket_sum);\n";
  exprs := generate_exprs_from_code(src, using(exn));
