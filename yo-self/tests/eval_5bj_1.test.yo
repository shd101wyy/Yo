test("Phase 5bjb: clamp function then fold", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // clamp(x, 0, 10): [-5, 3, 15, 7, 12, 0] → [0,3,10,7,10,0] → sum=30
  src := "arr := [i32(0) - i32(5), i32(3), i32(15), i32(7), i32(12), i32(0)];\nclamped := arr.map((fn(x : i32) -> i32)({\ncond((x < i32(0)) => i32(0), (x > i32(10)) => i32(10), true => x)\n}));\ntotal := clamped.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "30", "30"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bjb: nested cond in fold — bucket distribution", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
