// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5bj series: boolean aggregation, cond with let,
/// multiple exports, sequence comparisons, and grand combos.
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5bja — boolean aggregation
// ---------------------------------------------------------------------------
test("Phase 5bja: all elements positive — count-based check", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,2,3,4,5] all positive → count_positive=5 == len=5 → 1 (true)
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5)];\ncount_pos := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)({\ncond((x > i32(0)) => (acc + i32(1)), true => acc)\n}));\nresult := cond((count_pos == i32(5)) => i32(1), true => i32(0));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "1"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bja: any element divisible by 7 — count-based check", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [3,7,11,14,20] → divisible by 7: 7,14 → count=2 → any=1
  src := "arr := [i32(3), i32(7), i32(11), i32(14), i32(20)];\ncount_div7 := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)({\ncond(((x % i32(7)) == i32(0)) => (acc + i32(1)), true => acc)\n}));\nresult := cond((count_div7 > i32(0)) => i32(1), true => i32(0));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
