// ---------------------------------------------------------------------------
// Phase 5bjc — sequence comparisons
// ---------------------------------------------------------------------------
test("Phase 5bjc: sum of common values in two arrays", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[1,2,3,4,5], b=[3,4,5,6,7] → zip pairs=(1,3),(2,4),(3,5),(4,6),(5,7)
  // No common-by-position approach; instead count a[i]==b[i]: none match
  // Better: just sum a[i] where a[i] is in b by checking a[i] >= 3 (filter a where >=3)
  // a=[1,2,3,4,5] filtered >=3 = [3,4,5] → sum=12
  src := "a := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nfiltered := a.filter((fn(x : i32) -> bool)((x >= i32(3))));\ntotal := filtered.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "12", "12"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
