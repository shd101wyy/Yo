test("Phase 5bjd: string filter by length then sum lens", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // ["a","bb","ccc","dddd","eeeee"] → filter len>2: ["ccc","dddd","eeeee"] → sum lens=3+4+5=12
  src := "words := [\"a\", \"bb\", \"ccc\", \"dddd\", \"eeeee\"];\nlong_words := words.filter((fn(w : str) -> bool)((w.len() > i32(2))));\ntotal_len := long_words.fold(i32(0), (fn(acc : i32, w : str) -> i32)((acc + w.len())));\nexport(total_len);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "12", "12"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bjd: while countdown + filter evens grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // while count from 10 down to 1: sum=55; evens=[2,4,6,8,10] sum=30; grand=55-30=25
  src := "i := i32(10);\nloop_sum := i32(0);\nwhile((i > i32(0)), {\nloop_sum = (loop_sum + i);\ni = (i - i32(1));\n});\narr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8), i32(9), i32(10)];\nevens := arr.filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(0))));\neven_sum := evens.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nresult := (loop_sum - even_sum);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "25", "25"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bjd: zip sums vs threshold grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[10,20,30,40,50], b=[5,25,15,35,45]
  // sums=[15,45,45,75,95] → filter > 40: [45,45,75,95] → count=4
  src := "a := [i32(10), i32(20), i32(30), i32(40), i32(50)];\nb := [i32(5), i32(25), i32(15), i32(35), i32(45)];\npairs := a.zip(b);\nsums := pairs.map((fn(p : (i32, i32)) -> i32)((p.0 + p.1)));\ncount := sums.fold(i32(0), (fn(acc : i32, x : i32) -> i32)({\ncond((x > i32(40)) => (acc + i32(1)), true => acc)\n}));\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "4"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bjd: multi-stage HOF with negation grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1..6] → map to negated odds, doubled evens:
  // 1→-1, 2→4, 3→-3, 4→8, 5→-5, 6→12 → sum = -1+4-3+8-5+12 = 15
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6)];\ntransformed := arr.map((fn(x : i32) -> i32)({\ncond(((x % i32(2)) == i32(1)) => (i32(0) - x), true => (x * i32(2)))\n}));\ntotal := transformed.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "15", "15"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
