          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "1"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bja: count pairs where both elements are even", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // a=[2,3,4,5,6], b=[4,6,8,3,2] → both even: (2,4)✓,(4,8)✓,(6,2)✓ → count=3
  src := "a := [i32(2), i32(3), i32(4), i32(5), i32(6)];\nb := [i32(4), i32(6), i32(8), i32(3), i32(2)];\npairs := a.zip(b);\ncount := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)({\na_even := ((p.0 % i32(2)) == i32(0));\nb_even := ((p.1 % i32(2)) == i32(0));\ncond((a_even) => cond((b_even) => (acc + i32(1)), true => acc), true => acc)\n}));\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bja: count elements equal to their index squared", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // arr=[0,1,5,9,16,25]: indices 0..5; i^2=[0,1,4,9,16,25]
  // matches: 0==0✓,1==1✓,5!=4✗,9==9✓,16==16✓,25==25✓ → count=5
  // Easier approach: just count with known array and fold
  // arr=[0,1,4,9,16,25] — all match their index-square
  src := "arr := [i32(0), i32(1), i32(4), i32(9), i32(16), i32(25)];\nroots := [i32(0), i32(1), i32(2), i32(3), i32(4), i32(5)];\npairs := arr.zip(roots);\ncount := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)({\nexpected := (p.1 * p.1);\ncond((p.0 == expected) => (acc + i32(1)), true => acc)\n}));\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "6"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
