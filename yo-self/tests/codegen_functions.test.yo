/// Tests for self-hosted function-codegen helper ports.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  expand_implicit_parameters,
  function_declaration_linkage_prefix,
  generate_capture_dispose_function_declarations,
  generate_closure_constructor_declarations,
  generate_closure_vtable_declarations,
  generate_function_declaration,
  generate_function_prototype,
  generate_object_constructor_declarations,
  get_evidence_parameters
} :: import("../codegen/functions/declarations.yo");
{ sanitize_for_c_identifier } :: import("../codegen/utils/index.yo");
{ CodegenClosureCaptureEntry, CodegenContext, CodegenTypeEntry } :: import("../codegen/context.yo");
{ TypeValue, t_bool, t_effects_row, t_func_simple, t_i32, t_module, t_some_t, t_unit } :: import("../types/type.yo");

make_effect_fn_type :: (fn() -> TypeValue)({
  param_labels := ArrayList(String).new();
  param_types := ArrayList(TypeValue).new();
  param_labels.push(String.from("message"));
  param_types.push(t_i32());
  t_func_simple(param_labels, param_types, t_i32())
});

make_function_type_with_implicits :: (
  fn(
    implicit_labels : ArrayList(String),
    implicit_types : ArrayList(TypeValue),
    implicit_spreads : ArrayList(bool)
  ) -> TypeValue
)(
  .Func(
    ArrayList(String).new(),
    ArrayList(TypeValue).new(),
    ArrayList(String).new(),
    ArrayList(TypeValue).new(),
    implicit_labels,
    implicit_types,
    implicit_spreads,
    ArrayList(TypeValue).new(),
    box(t_unit())
  )
);

test("function declarations: bare function implicit becomes evidence", {
  implicit_labels := ArrayList(String).new();
  implicit_types := ArrayList(TypeValue).new();
  implicit_spreads := ArrayList(bool).new();
  implicit_labels.push(String.from("raise"));
  implicit_types.push(make_effect_fn_type());
  implicit_spreads.push(false);
  function_type := make_function_type_with_implicits(implicit_labels, implicit_types, implicit_spreads);
  evidence_params := get_evidence_parameters(function_type);
  assert(evidence_params.len() == usize(1), "one evidence param");
  match(
    evidence_params.get(usize(0)),
    .Some(ep) => {
      assert(ep.implicit_label == String.from("raise"), "implicit label");
      assert(ep.field_label == String.from("raise"), "field label");
      assert(ep.field_path.len() == usize(1), "field path length");
      assert(ep.c_param_name == String.from("raise"), "c param");
    },
    .None => assert(false, "missing evidence param")
  );
});

test("function declarations: nested module fields become evidence paths", {
  raise_fn := make_effect_fn_type();
  errors_labels := ArrayList(String).new();
  errors_types := ArrayList(TypeValue).new();
  errors_labels.push(String.from("raise"));
  errors_types.push(raise_fn);
  errors_module := t_module(String.from("Errors"), errors_labels, errors_types);
  effect_labels := ArrayList(String).new();
  effect_types := ArrayList(TypeValue).new();
  effect_labels.push(String.from("errors"));
  effect_types.push(errors_module);
  effect_module := t_module(String.from("RaiseModule"), effect_labels, effect_types);
  implicit_labels := ArrayList(String).new();
  implicit_types := ArrayList(TypeValue).new();
  implicit_spreads := ArrayList(bool).new();
  implicit_labels.push(String.from("raise_mod"));
  implicit_types.push(effect_module);
  implicit_spreads.push(false);
  function_type := make_function_type_with_implicits(implicit_labels, implicit_types, implicit_spreads);
  evidence_params := get_evidence_parameters(function_type);
  assert(evidence_params.len() == usize(1), "one nested evidence param");
  match(
    evidence_params.get(usize(0)),
    .Some(ep) => {
      assert(ep.implicit_label == String.from("raise_mod"), "implicit label");
      assert(ep.field_label == String.from("errors__raise"), "field label");
      assert(ep.field_path.len() == usize(2), "field path length");
      assert(ep.c_param_name == String.from("raise_mod__errors__raise"), "c param");
    },
    .None => assert(false, "missing nested evidence param")
  );
});

test("function declarations: effect row spread expands implicit parameters", {
  row_labels := ArrayList(String).new();
  row_types := ArrayList(TypeValue).new();
  row_labels.push(String.from("raise"));
  row_types.push(make_effect_fn_type());
  row_type := t_effects_row(row_labels, row_types);
  implicit_labels := ArrayList(String).new();
  implicit_types := ArrayList(TypeValue).new();
  implicit_spreads := ArrayList(bool).new();
  implicit_labels.push(String.from("E"));
  implicit_types.push(row_type);
  implicit_spreads.push(true);
  function_type := make_function_type_with_implicits(implicit_labels, implicit_types, implicit_spreads);
  expanded := expand_implicit_parameters(function_type);
  evidence_params := get_evidence_parameters(function_type);
  assert(expanded.len() == usize(1), "spread expands one implicit");
  assert(evidence_params.len() == usize(1), "spread produces evidence");
  match(
    evidence_params.get(usize(0)),
    .Some(ep) => {
      assert(ep.implicit_label == String.from("raise"), "expanded implicit label");
      assert(ep.c_param_name == String.from("raise"), "expanded c param");
    },
    .None => assert(false, "missing spread evidence param")
  );
});

test("function declarations: sanitize_for_c_identifier mirrors C reserved handling", {
  assert(sanitize_for_c_identifier(String.from("return")) == String.from("__yo_c_reserved_return"), "reserved word");
  assert(sanitize_for_c_identifier(String.from("raise.mod")) == String.from("raise_u46_mod"), "special char");
});

test("function declarations: generate_function_prototype regular params", {
  param_labels := ArrayList(String).new();
  param_types := ArrayList(TypeValue).new();
  param_labels.push(String.from("x"));
  param_types.push(t_i32());
  fn_type := t_func_simple(param_labels, param_types, t_i32());
  proto := generate_function_prototype(fn_type, String.from("fn_inc"),.None,.None);
  assert(proto == String.from("int32_t fn_inc(int32_t x)"), "regular prototype");
});

test("function declarations: generate_function_prototype function pointer param", {
  param_labels := ArrayList(String).new();
  param_types := ArrayList(TypeValue).new();
  param_labels.push(String.from("callback"));
  param_types.push(make_effect_fn_type());
  fn_type := t_func_simple(param_labels, param_types, t_i32());
  proto := generate_function_prototype(fn_type, String.from("fn_call"),.None,.None);
  assert(proto == String.from("int32_t fn_call(int32_t (*callback)(int32_t message))"), "function pointer prototype");
});

test("function declarations: generate_function_prototype evidence params", {
  effect_labels := ArrayList(String).new();
  effect_types := ArrayList(TypeValue).new();
  effect_labels.push(String.from("raise"));
  effect_types.push(make_effect_fn_type());
  effect_module := t_module(String.from("RaiseModule"), effect_labels, effect_types);
  implicit_labels := ArrayList(String).new();
  implicit_types := ArrayList(TypeValue).new();
  implicit_spreads := ArrayList(bool).new();
  implicit_labels.push(String.from("raise_mod"));
  implicit_types.push(effect_module);
  implicit_spreads.push(false);
  fn_type := make_function_type_with_implicits(implicit_labels, implicit_types, implicit_spreads);
  proto := generate_function_prototype(fn_type, String.from("fn_run"),.None,.None);
  assert(proto == String.from("void fn_run(int32_t (*raise_mod__raise)(int32_t message))"), "evidence prototype");
});

test("function declarations: linkage prefix mirrors declaration rules", {
  assert(function_declaration_linkage_prefix(String.from("fn_ext"), true, false) == String.from("extern "), "extern prefix");
  assert(function_declaration_linkage_prefix(String.from("__yo_user_main"), false, false) == String.from(""), "user main exported");
  assert(function_declaration_linkage_prefix(String.from("fn___drop"), false, false) == String.from("static inline __attribute__((always_inline)) "), "rc inline prefix");
  assert(function_declaration_linkage_prefix(String.from("fn_regular"), false, false) == String.from("static inline "), "regular static inline");
});

test("function declarations: generate_function_declaration emits declaration line", {
  param_labels := ArrayList(String).new();
  param_types := ArrayList(TypeValue).new();
  param_labels.push(String.from("x"));
  param_types.push(t_i32());
  fn_type := t_func_simple(param_labels, param_types, t_i32());
  ctx := CodegenContext.new();
  generate_function_declaration(fn_type, String.from("fn_inc"), false, &(ctx),.None,.None, false);
  output := ctx.emitter.print();
  assert(output.contains(String.from("static inline int32_t fn_inc(int32_t x);")), "declaration prototype");
  assert(output.contains(String.from("// fn(x : i32) -> i32")), "type comment");
});

test("function declarations: generate_function_declaration supports override return type", {
  fn_type := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_i32());
  ctx := CodegenContext.new();
  generate_function_declaration(fn_type, String.from("fn_override"), false, &(ctx),.Some(String.from("void*")),.None, false);
  output := ctx.emitter.print();
  assert(output.contains(String.from("static inline void* fn_override();")), "override return type");
});

test("function declarations: object constructor declarations include runtime helpers and objects", {
  field_labels := ArrayList(String).new();
  field_types := ArrayList(TypeValue).new();
  field_labels.push(String.from("x"));
  field_types.push(t_i32());
  field_labels.push(String.from("is_ok"));
  field_types.push(t_bool());
  object_type := TypeValue.Struct(
    String.from("point-id"),
    String.from("Point"),
    field_labels,
    field_types,
    true,
    false,
    false
  );
  ctx := CodegenContext.new();
  ctx.types.set(
    String.from("point-id"),
    CodegenTypeEntry(
      type_value : object_type,
      c_name : String.from("__yo_struct_test_id_1")
    )
  );
  generate_object_constructor_declarations(&(ctx));
  output := ctx.emitter.print();
  assert(output.contains(String.from("static inline void __yo_decr_rc(void* ptr); // Decrement reference count")), "rc declaration");
  assert(output.contains(String.from("static void __yo_gc_collect(); // Trigger garbage collection")), "gc declaration");
  assert(output.contains(String.from("static __yo_struct_test_id_1* __yo_new___yo_struct_test_id_1(int32_t x, bool is_ok); // Constructor")), "object constructor declaration");
});

test("function declarations: object constructor declarations skip value structs", {
  field_labels := ArrayList(String).new();
  field_types := ArrayList(TypeValue).new();
  field_labels.push(String.from("x"));
  field_types.push(t_i32());
  value_type := TypeValue.Struct(
    String.from("value-id"),
    String.from("ValuePoint"),
    field_labels,
    field_types,
    false,
    false,
    false
  );
  ctx := CodegenContext.new();
  ctx.types.set(
    String.from("value-id"),
    CodegenTypeEntry(
      type_value : value_type,
      c_name : String.from("__yo_struct_test_id_2")
    )
  );
  generate_object_constructor_declarations(&(ctx));
  output := ctx.emitter.print();
  assert(!(output.contains(String.from("__yo_new___yo_struct_test_id_2"))), "value struct constructor skipped");
});

test("function declarations: object constructor declarations skip nested generic fields", {
  field_labels := ArrayList(String).new();
  field_types := ArrayList(TypeValue).new();
  field_labels.push(String.from("items"));
  field_types.push(TypeValue.Array(box(t_some_t(String.from("T"), usize(0))), usize(4)));
  generic_object_type := TypeValue.Struct(
    String.from("generic-id"),
    String.from("GenericBox"),
    field_labels,
    field_types,
    true,
    false,
    false
  );
  ctx := CodegenContext.new();
  ctx.types.set(
    String.from("generic-id"),
    CodegenTypeEntry(
      type_value : generic_object_type,
      c_name : String.from("__yo_struct_test_id_3")
    )
  );
  generate_object_constructor_declarations(&(ctx));
  output := ctx.emitter.print();
  assert(!(output.contains(String.from("__yo_new___yo_struct_test_id_3"))), "nested generic field constructor skipped");
});

test("function declarations: capture dispose declarations follow closure capture map", {
  fn_type := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  ctx := CodegenContext.new();
  ctx.closure_capture_map.set(
    String.from("closure_1"),
    CodegenClosureCaptureEntry(
      closure_type : fn_type,
      closure_c_name : String.from("__yo_closure_1"),
      capture_type : t_unit(),
      capture_c_name : String.from("__yo_capture_1")
    )
  );
  generate_capture_dispose_function_declarations(&(ctx));
  output := ctx.emitter.print();
  assert(output.contains(String.from("static void __yo_dispose_closure_closure_1(void* closure_ptr);")), "capture dispose declaration");
});

test("function declarations: closure constructor and vtable declaration helpers are no-ops", {
  ctx := CodegenContext.new();
  generate_closure_constructor_declarations(&(ctx));
  generate_closure_vtable_declarations(&(ctx));
  output := ctx.emitter.print();
  assert(output == String.from("\n\n"), "closure declaration no-ops");
});
