test "Phase 5ap: recursive factorial via recur", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "fact := (fn(n : i32) -> i32)(cond((n == i32(0)) => i32(1), true => (n * recur((n - i32(1)))))); result := fact(i32(5)); export result;";
