test "Phase 5ak: escape acts like return", {
  env := empty_env();
  // escape 42 → ReturnVal wrapping IntLit("42")
  esc_expr := AstExpr.FnCall(usize(0), box(make_atom(TokenKind.Identifier, "escape")), {
    (a := ArrayList(AstExpr).new());
    a.push(make_atom(TokenKind.Integer, "42"));
    a
  }, false, make_token(TokenKind.Identifier, "escape"));
  result := evaluate(esc_expr, &env);
  match(result,
    .None => assert(false, "escape returned None"),
    .Some(r) => match(r.value,
      .ReturnVal(inner, _) => match(inner.*,
        .IntLit(v) => assert((v.as_str() == "42"), "escape should wrap 42"),
        _ => assert(false, "expected IntLit inside ReturnVal")
      ),
      _ => assert(false, "expected ReturnVal")
    )
  );
};

