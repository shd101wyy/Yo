test "Phase 5al: ArrayVal.find(fn) returns first match", {
  env := empty_env();
  // Build arr = [1, 2, 3, 4]
  arr_items := ArrayList(EvalValue).new();
  arr_items.push(.IntLit(String.from("1")));
  arr_items.push(.IntLit(String.from("2")));
  arr_items.push(.IntLit(String.from("3")));
  arr_items.push(.IntLit(String.from("4")));
  _ := env.define_val(String.from("arr3"), t_unit(), true, .Some(EvalValue.ArrayVal(arr_items)));
  // Build lambda: (x) => (x > 2) — returns true for 3,4
  gt_body := make_infix(">", make_ident("x"), make_atom(TokenKind.Integer, "2"));
  lambda := make_infix("=>", make_ident("x"), gt_body);

  // arr3.find(lambda)
  recv_ast := make_atom(TokenKind.Identifier, "arr3");
  dot_tok := make_token(TokenKind.Dot, ".");
  method_tok := make_token(TokenKind.Identifier, "find");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(recv_ast);
  dot_args.push(AstExpr.Atom(usize(0), method_tok));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_args.push(lambda);
  method_call := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, method_tok);
  result := evaluate(method_call, &env);
  match(result,
    .None => assert(false, "find returned None"),
    .Some(r) => match(r.value,
      .EnumVal(tag, fields) => {
        assert((tag.as_str() == ".Some"), "find should return .Some");
        match(fields.get(usize(0)),
          .Some(ev) => match(ev, .IntLit(v) => assert((v.as_str() == "3"), "first > 2 is 3"), _ => assert(false, "expected IntLit")),
          .None => assert(false, "missing inner value")
        );
      },
      _ => assert(false, "expected EnumVal")
    )
  );
};

test "Phase 5am: ArrayVal.enumerate() returns index-value tuples", {
  env := empty_env();
  arr_items := ArrayList(EvalValue).new();
  arr_items.push(.IntLit(String.from("10")));
  arr_items.push(.IntLit(String.from("20")));
  arr_items.push(.IntLit(String.from("30")));
  _ := env.define_val(String.from("arr"), t_unit(), true, .Some(EvalValue.ArrayVal(arr_items)));
  // arr.enumerate()
  recv_ast := make_atom(TokenKind.Identifier, "arr");
  dot_tok := make_token(TokenKind.Dot, ".");
  method_tok := make_token(TokenKind.Identifier, "enumerate");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(recv_ast);
  dot_args.push(AstExpr.Atom(usize(0), method_tok));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  method_call := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, method_tok);
  result := evaluate(method_call, &env);
  match(result,
    .None => assert(false, "enumerate returned None"),
    .Some(r) => match(r.value,
      .ArrayVal(items) => {
        assert((items.len() == usize(3)), "enumerate should return 3 tuples");
        // Check first tuple: (0, 10)
        match(items.get(usize(0)),
          .Some(t0) => match(t0,
            .StructVal(_, fnames, fvals) => {
              match(fvals.get(usize(0)),
                .Some(idx_v) => match(idx_v, .IntLit(iv) => assert((iv.as_str() == "0"), "idx 0"), _ => assert(false, "idx not IntLit")),
                .None => assert(false, "no idx")
              );
              match(fvals.get(usize(1)),
                .Some(val_v) => match(val_v, .IntLit(vv) => assert((vv.as_str() == "10"), "val 10"), _ => assert(false, "val not IntLit")),
                .None => assert(false, "no val")
              );
            },
            _ => assert(false, "expected StructVal tuple")
          ),
          .None => assert(false, "no first tuple")
        );
        // Check third tuple: (2, 30)
        match(items.get(usize(2)),
          .Some(t2) => match(t2,
            .StructVal(_, fnames2, fvals2) => {
              match(fvals2.get(usize(0)),
                .Some(idx_v2) => match(idx_v2, .IntLit(iv2) => assert((iv2.as_str() == "2"), "idx 2"), _ => assert(false, "idx not IntLit")),
                .None => assert(false, "no idx2")
              );
              match(fvals2.get(usize(1)),
                .Some(val_v2) => match(val_v2, .IntLit(vv2) => assert((vv2.as_str() == "30"), "val 30"), _ => assert(false, "val not IntLit")),
                .None => assert(false, "no val2")
              );
            },
            _ => assert(false, "expected StructVal tuple 2")
          ),
          .None => assert(false, "no third tuple")
        );
      },
      _ => assert(false, "expected ArrayVal")
    )
  );
};

test "Phase 5am: ArrayVal.zip combines two arrays", {
  env := empty_env();
  arr1_items := ArrayList(EvalValue).new();
  arr1_items.push(.IntLit(String.from("1")));
  arr1_items.push(.IntLit(String.from("2")));
  arr1_items.push(.IntLit(String.from("3")));
  _ := env.define_val(String.from("a1"), t_unit(), true, .Some(EvalValue.ArrayVal(arr1_items)));
  arr2_items := ArrayList(EvalValue).new();
  arr2_items.push(.StrLit(String.from("\"x\"")));
  arr2_items.push(.StrLit(String.from("\"y\"")));
  _ := env.define_val(String.from("a2"), t_unit(), true, .Some(EvalValue.ArrayVal(arr2_items)));
  // a1.zip(a2)
  recv_ast := make_atom(TokenKind.Identifier, "a1");
  dot_tok := make_token(TokenKind.Dot, ".");
  method_tok := make_token(TokenKind.Identifier, "zip");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(recv_ast);
  dot_args.push(AstExpr.Atom(usize(0), method_tok));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Identifier, "a2"));
  method_call := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, method_tok);
  result := evaluate(method_call, &env);
  match(result,
    .None => assert(false, "zip returned None"),
    .Some(r) => match(r.value,
      .ArrayVal(items) => {
        // min(3, 2) = 2 tuples
        assert((items.len() == usize(2)), "zip should return 2 tuples");
        // Check first tuple: (1, "x")
        match(items.get(usize(0)),
          .Some(t0) => match(t0,
            .StructVal(_, _, fvals) => {
              match(fvals.get(usize(0)),
                .Some(lv) => match(lv, .IntLit(li) => assert((li.as_str() == "1"), "left 1"), _ => assert(false, "left not IntLit")),
                .None => assert(false, "no left")
              );
              match(fvals.get(usize(1)),
                .Some(rv) => match(rv, .StrLit(rs) => assert((rs.as_str() == "\"x\""), "right x"), _ => assert(false, "right not StrLit")),
                .None => assert(false, "no right")
              );
            },
            _ => assert(false, "expected StructVal")
          ),
          .None => assert(false, "no first tuple")
        );
      },
      _ => assert(false, "expected ArrayVal")
    )
  );
};

