test "Phase 5aa: tuple (1, 2, 3) creates StructVal", {
  env := empty_env();
  // (1, 2, 3) — BK_TUPLE with 3 args
  tup_args := ArrayList(AstExpr).new();
  tup_args.push(make_atom(TokenKind.Integer, "1"));
  tup_args.push(make_atom(TokenKind.Integer, "2"));
  tup_args.push(make_atom(TokenKind.Integer, "3"));
  tup_tok := make_token(TokenKind.Identifier, BK_TUPLE);
  tup_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), tup_tok)), tup_args, false, tup_tok);
  result := evaluate(tup_expr, &env);
  match(result,
    .None => assert(false, "tuple returned None"),
    .Some(r) =>
      match(r.value,
        .StructVal(name, fnames, fvals) => {
          assert((name.as_str() == "_"), "tuple name should be _");
          assert((fvals.len() == usize(3)), "tuple should have 3 fields");
          match(fvals.get(usize(0)),
            .Some(v0) => match(v0, .IntLit(s) => assert((s.as_str() == "1"), "first elem should be 1"), _ => assert(false, "elem 0 should be IntLit")),
            .None => assert(false, "should have elem 0")
          );
        },
        _ => assert(false, "tuple should return StructVal")
      )
  );
};

