test "Phase 5an: ArrayVal.flat_map flattens mapped arrays", {
  env := empty_env();
  // Define arr2 = [[1,2], [3,4]] and flat_map with identity (x) => x
  inner1 := ArrayList(EvalValue).new();
  inner1.push(.IntLit(String.from("1")));
  inner1.push(.IntLit(String.from("2")));
  inner2 := ArrayList(EvalValue).new();
  inner2.push(.IntLit(String.from("3")));
  inner2.push(.IntLit(String.from("4")));
  arr2_items := ArrayList(EvalValue).new();
  arr2_items.push(.ArrayVal(inner1));
  arr2_items.push(.ArrayVal(inner2));
  _ := env.define_val(String.from("arr2"), t_unit(), true, .Some(EvalValue.ArrayVal(arr2_items)));
  // lambda: identity (x) => x
  lambda := make_infix("=>", make_ident("x"), make_ident("x"));
  // arr2.flat_map(lambda)
  recv_ast := make_atom(TokenKind.Identifier, "arr2");
  dot_tok := make_token(TokenKind.Dot, ".");
  method_tok := make_token(TokenKind.Identifier, "flat_map");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(recv_ast);
  dot_args.push(AstExpr.Atom(usize(0), method_tok));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_args.push(lambda);
  method_call := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, method_tok);
  result := evaluate(method_call, &env);
  match(result,
    .None => assert(false, "flat_map returned None"),
    .Some(r) => match(r.value,
      .ArrayVal(items) => {
        assert((items.len() == usize(4)), "flat_map should flatten to 4 elements");
        match(items.get(usize(0)),
          .Some(v0) => match(v0, .IntLit(s0) => assert((s0.as_str() == "1"), "elem 0 is 1"), _ => assert(false, "not IntLit")),
          .None => assert(false, "no elem 0")
        );
        match(items.get(usize(3)),
          .Some(v3) => match(v3, .IntLit(s3) => assert((s3.as_str() == "4"), "elem 3 is 4"), _ => assert(false, "not IntLit")),
          .None => assert(false, "no elem 3")
        );
      },
      _ => assert(false, "expected ArrayVal")
    )
  );
};

test "Phase 5ao: for loop over array with accumulator", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "arr :: [i64(1), i64(2), i64(3), i64(4), i64(5)]; (sum : i64) = i64(0); for(x, arr, { sum = (sum + x); }); export sum;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "for loop returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v, .IntLit(raw) => assert((raw.as_str() == "15"), "sum is 15"), _ => assert(false, "not IntLit")),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

