    .Some(r) => match(r.value,
      .ReturnVal(inner, _) => match(inner.*, .UnitVal => assert(true, "ok"), _ => assert(false, "expected UnitVal")),
      _ => assert(false, "expected ReturnVal")
    )
  );
};

test "Phase 5al: StrLit.as_bytes() returns byte array", {
  env := empty_env();
  // "AB".as_bytes() should return [65, 66]
  recv := make_atom(TokenKind.StringLit, "\"AB\"");
  dot_tok := make_token(TokenKind.Dot, ".");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(recv);
  dot_args.push(make_atom(TokenKind.Identifier, "as_bytes"));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  method_call := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, dot_tok);
  result := evaluate(method_call, &env);
  match(result,
    .None => assert(false, "as_bytes returned None"),
    .Some(r) => match(r.value,
      .ArrayVal(items) => {
        assert((items.len() == usize(2)), "AB has 2 bytes");
        match(items.get(usize(0)), .Some(ev0) => match(ev0, .IntLit(v) => assert((v.as_str() == "65"), "A is 65"), _ => assert(false, "expected IntLit")), .None => assert(false, "missing 0"));
        match(items.get(usize(1)), .Some(ev1) => match(ev1, .IntLit(v) => assert((v.as_str() == "66"), "B is 66"), _ => assert(false, "expected IntLit")), .None => assert(false, "missing 1"));
      },
      _ => assert(false, "expected ArrayVal")
    )
  );
};

test "Phase 5al: StrLit.as_bytes() empty string", {
  env := empty_env();
  recv := make_atom(TokenKind.StringLit, "\"\"");
  dot_tok := make_token(TokenKind.Dot, ".");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(recv);
  dot_args.push(make_atom(TokenKind.Identifier, "as_bytes"));
