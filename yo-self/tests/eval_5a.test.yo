  dot_args.push(make_atom(TokenKind.StringLit, "\"hello\""));
  dot_args.push(make_atom(TokenKind.Identifier, "index_of"));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.StringLit, "\"xyz\""));
  call_expr := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, dot_tok);
  result := evaluate(call_expr, &env);
  match(result,
    .None => assert(false, "index_of returned None (error)"),
    .Some(r) =>
      match(r.value,
        .EnumVal(tag, _) => assert((tag.as_str() == ".None"), "should be .None when not found"),
        _ => assert(false, "index_of should return EnumVal")
      )
  );
};

test "Phase 5ab: string less-than comparison", {
  env := empty_env();
  // "abc" < "abd"
  cmp_expr := make_infix("<", make_atom(TokenKind.StringLit, "\"abc\""), make_atom(TokenKind.StringLit, "\"abd\""));
  result := evaluate(cmp_expr, &env);
  match(result,
    .None => assert(false, "string < returned None"),
    .Some(r) =>
      match(r.value,
        .BoolVal(b) => assert(b, "abc should be < abd"),
        _ => assert(false, "should return BoolVal")
      )
  );
};

