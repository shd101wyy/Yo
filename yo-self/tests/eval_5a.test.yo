test "Phase 5aj: ArrayVal.remove(1) from [10,20,30]", {
  env := empty_env();
  arr_items := ArrayList(EvalValue).new();
  arr_items.push(.IntLit(String.from("10")));
  arr_items.push(.IntLit(String.from("20")));
  arr_items.push(.IntLit(String.from("30")));
  _ := env.define_val(String.from("arr"), t_unit(), true, .Some(EvalValue.ArrayVal(arr_items)));
  recv_ast := make_atom(TokenKind.Identifier, "arr");
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, "1"));
  dot_tok := make_token(TokenKind.Dot, ".");
  method_tok := make_token(TokenKind.Identifier, "remove");
  method_call := AstExpr.FnCall(usize(0), box(AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), { (dargs := ArrayList(AstExpr).new()); dargs.push(recv_ast); dargs.push(AstExpr.Atom(usize(0), method_tok)); dargs }, true, dot_tok)), call_args, false, method_tok);
  result := evaluate(method_call, &env);
  match(result,
    .None => assert(false, "remove returned None"),
    .Some(r) => match(r.value,
      .ArrayVal(items) => {
        assert((items.len() == usize(2)), "should have 2 elements");
        match(items.get(usize(0)), .Some(ev0) => match(ev0, .IntLit(v) => assert((v.as_str() == "10"), "first should be 10"), _ => assert(false, "expected IntLit")), .None => assert(false, "missing 0"));
        match(items.get(usize(1)), .Some(ev1) => match(ev1, .IntLit(v) => assert((v.as_str() == "30"), "second should be 30"), _ => assert(false, "expected IntLit")), .None => assert(false, "missing 1"));
      },
      _ => assert(false, "expected ArrayVal")
    )
  );
};

