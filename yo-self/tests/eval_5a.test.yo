test "Phase 5aa: clone on IntLit returns same value", {
  env := empty_env();
  // 42.clone()
  dot_tok := make_token(TokenKind.Dot, ".");
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(make_atom(TokenKind.Integer, "42"));
  dot_args.push(make_atom(TokenKind.Identifier, "clone"));
  dot_call := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_expr := AstExpr.FnCall(usize(0), box(dot_call), call_args, false, dot_tok);
  result := evaluate(call_expr, &env);
  match(result,
    .None => assert(false, "clone returned None"),
    .Some(r) =>
      match(r.value,
        .IntLit(v) => assert((v.as_str() == "42"), "clone should return same IntLit"),
        _ => assert(false, "clone should return IntLit")
      )
  );
};

