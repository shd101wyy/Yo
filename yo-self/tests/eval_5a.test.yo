test "Phase 5az: string equality comparison", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "a := \"hello\"; b := \"hello\"; c := \"world\"; eq := (a == b); neq := (a == c); export eq; export neq;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "string eq returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(2)), "2 exports");
        match(vals.get(usize(0)),
          .Some(v0) => match(v0, .BoolVal(b0) => assert(b0, "hello==hello"), _ => assert(false, "not BoolVal 0")),
          .None => assert(false, "no val 0")
        );
        match(vals.get(usize(1)),
          .Some(v1) => match(v1, .BoolVal(b1) => assert((!b1), "hello!=world"), _ => assert(false, "not BoolVal 1")),
          .None => assert(false, "no val 1")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

