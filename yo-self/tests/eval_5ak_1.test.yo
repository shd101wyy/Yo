// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5ak series: abs, len, clone, string +,
/// TypeVal.Ok/Err, is_ok, is_err, ok, err, map_err, flat_map.
///
/// Phases covered:
///   5aka — IntLit.abs() and IntLit.min()
///   5akb — StrLit.len() and ArrayVal.len()
///   5akc — clone() passthrough, StrLit.ends_with(), StrLit.contains()
///   5akd — TypeVal.Ok/Err constructors and is_ok/is_err predicates
///   5ake — EnumVal.ok(), err(), map_err(fn) and ArrayVal.flat_map(fn)
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5aka — IntLit.abs()
// ---------------------------------------------------------------------------
test("Phase 5aka: abs on positive integer returns same value", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "result := i64(5).abs();\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "5"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

