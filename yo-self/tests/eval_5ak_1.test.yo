test("Phase 5ake: EnumVal.map_err transforms Err value", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "result := i64.Err(i64(3)).map_err((fn(e : i64) -> i64)(e + i64(1)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .EnumVal(tag, fields) => {
              assert(tag.as_str() == ".Err", "Err");
              match(
                fields.get(usize(0)),
                .Some(inner) => match(inner,.IntLit(n) => assert(n.as_str() == "4", "4"), _ => assert(false, "t")),
                .None => assert(false, "flds")
              );
            },
            _ => assert(false, "enum")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5ake: ArrayVal.flat_map duplicates each element", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i64(1), i64(2)];\nresult := arr.flat_map((fn(x : i64) -> [i64])([x, x]));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .ArrayVal(items) => {
              assert(items.len() == usize(4), "len4");
              match(items.get(usize(0)),.Some(e0) => match(e0,.IntLit(n) => assert(n.as_str() == "1", "e0"), _ => assert(false, "t")),.None => assert(false, "i0"));
              match(items.get(usize(1)),.Some(e1) => match(e1,.IntLit(n) => assert(n.as_str() == "1", "e1"), _ => assert(false, "t")),.None => assert(false, "i1"));
              match(items.get(usize(2)),.Some(e2) => match(e2,.IntLit(n) => assert(n.as_str() == "2", "e2"), _ => assert(false, "t")),.None => assert(false, "i2"));
              match(items.get(usize(3)),.Some(e3) => match(e3,.IntLit(n) => assert(n.as_str() == "2", "e3"), _ => assert(false, "t")),.None => assert(false, "i3"));
            },
            _ => assert(false, "arr")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
