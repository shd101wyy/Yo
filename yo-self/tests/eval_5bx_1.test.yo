test("Phase 5bxa: sum of elements where value > index in [2,7,4,9,1,6,3,8,5] = 36", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // i=0:2>0✓+2; i=1:7>1✓+7; i=2:4>2✓+4; i=3:9>3✓+9; i=4:1>4✗; i=5:6>5✓+6; i=6:3>6✗; i=7:8>7✓+8; i=8:5>8✗ → 2+7+4+9+6+8=36... wait
  // Let me recheck: 2+7+4+9+6+8 = 36. Hmm but I wrote 37. Let me fix: 2+7+4+9+6+8=36
  src := "arr := [i32(2), i32(7), i32(4), i32(9), i32(1), i32(6), i32(3), i32(8), i32(5)];\ns := i32(0);\ni := i32(0);\nwhile((i < i32(9)), {\nv := arr.get(i).unwrap();\ngt := cond((v > i) => i32(1), true => i32(0));\ns = (s + (gt * v));\ni = (i + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "36", "36"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

