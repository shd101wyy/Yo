test("Phase 5bxc: sum n in 1..12 where n is not divisible by 2 or 3 = 24", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // coprime to 6 in 1..12: 1,5,7,11 → 1+5+7+11=24
  // Wait: 1,5,7,11 for 1..12: correct? 1:neither; 5:neither; 7:neither; 11:neither → sum=24
  src := "s := i32(0);\nn := i32(1);\nwhile((n <= i32(12)), {\nnd2 := cond(((n % i32(2)) != i32(0)) => i32(1), true => i32(0));\nnd3 := cond(((n % i32(3)) != i32(0)) => i32(1), true => i32(0));\ns = (s + ((nd2 * nd3) * n));\nn = (n + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "24", "24"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5bxd — grand combos set 1
// even_idx=15, odd_idx=30, val_gt_idx_sum=36, val_gt_idx_cnt=6
// sq_even=220, cube_odd=496, cnt_sq_lt=4, sum_sq_gt=195
// abs_diff=37, cnt_desc=4, prod_pairs=175, coprime12=24
// ---------------------------------------------------------------------------
test("Phase 5bxd: even_idx + odd_idx + val_gt_idx_sum = 15+30+36 = 81", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(2), i32(7), i32(4), i32(9), i32(1), i32(6), i32(3), i32(8), i32(5)];\ns1 := i32(0);\ni := i32(0);\nwhile((i < i32(9)), {\nv1 := arr.get(i).unwrap();\nie := cond(((i % i32(2)) == i32(0)) => i32(1), true => i32(0));\ns1 = (s1 + (ie * v1));\ni = (i + i32(1));\n});\ns2 := i32(0);\nj := i32(0);\nwhile((j < i32(9)), {\nv2 := arr.get(j).unwrap();\nio := cond(((j % i32(2)) != i32(0)) => i32(1), true => i32(0));\ns2 = (s2 + (io * v2));\nj = (j + i32(1));\n});\ns3 := i32(0);\nk := i32(0);\nwhile((k < i32(9)), {\nv3 := arr.get(k).unwrap();\ngt := cond((v3 > k) => i32(1), true => i32(0));\ns3 = (s3 + (gt * v3));\nk = (k + i32(1));\n});\nresult := ((s1 + s2) + s3);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "81", "81"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

