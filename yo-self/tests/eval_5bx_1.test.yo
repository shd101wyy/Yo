test("Phase 5bxd: cnt_sq_lt + sum_sq_gt + abs_diff = 4+195+37 = 236", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "cnt1 := i32(0);\nn1 := i32(1);\nwhile((n1 <= i32(20)), {\nlhs1 := (n1 * n1);\nrhs1 := ((i32(3) * n1) + i32(10));\nlt := cond((lhs1 < rhs1) => i32(1), true => i32(0));\ncnt1 = (cnt1 + lt);\nn1 = (n1 + i32(1));\n});\ns2 := i32(0);\nn2 := i32(1);\nwhile((n2 <= i32(20)), {\nlhs2 := (n2 * n2);\nrhs2 := (i32(5) * n2);\ngt := cond((lhs2 > rhs2) => i32(1), true => i32(0));\ns2 = (s2 + (gt * n2));\nn2 = (n2 + i32(1));\n});\narr := [i32(2), i32(7), i32(4), i32(9), i32(1), i32(6), i32(3), i32(8), i32(5)];\ns3 := i32(0);\ni := i32(0);\nwhile((i < i32(8)), {\nai := arr.get(i).unwrap();\nbi := arr.get((i + i32(1))).unwrap();\ndi := cond((ai > bi) => (ai - bi), true => (bi - ai));\ns3 = (s3 + di);\ni = (i + i32(1));\n});\nresult := ((cnt1 + s2) + s3);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
