// @skip_wasm32-emscripten
// @skip_wasm32-wasi
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
empty_env :: (fn() -> Environment)(Environment.new(`test`));

// ---------------------------------------------------------------------------
// Phase 5bxa — stride sums and index-based filtering
// arr = [2,7,4,9,1,6,3,8,5]  (9 elements)
// ---------------------------------------------------------------------------
test("Phase 5bxa: sum of elements at even indices in [2,7,4,9,1,6,3,8,5] = 15", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // indices 0,2,4,6,8 → 2+4+1+3+5 = 15
  src := "arr := [i32(2), i32(7), i32(4), i32(9), i32(1), i32(6), i32(3), i32(8), i32(5)];\ns := i32(0);\ni := i32(0);\nwhile((i < i32(9)), {\nv := arr.get(i).unwrap();\nis_even := cond(((i % i32(2)) == i32(0)) => i32(1), true => i32(0));\ns = (s + (is_even * v));\ni = (i + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "15", "15"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

