// ---------------------------------------------------------------------------
// Phase 5bxb — square sums and power-of-2 filters
// ---------------------------------------------------------------------------
test("Phase 5bxb: sum of squares of even numbers in 1..10 = 220", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 2²+4²+6²+8²+10² = 4+16+36+64+100 = 220
  src := "s := i32(0);\nn := i32(1);\nwhile((n <= i32(10)), {\nis_even := cond(((n % i32(2)) == i32(0)) => i32(1), true => i32(0));\ns = (s + (is_even * (n * n)));\nn = (n + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "220", "220"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

