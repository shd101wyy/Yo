  src := "arr := [i32(2), i32(7), i32(4), i32(9), i32(1), i32(6), i32(3), i32(8), i32(5)];\ns := i32(0);\ni := i32(0);\nwhile((i < i32(8)), {\na := arr.get(i).unwrap();\nb := arr.get((i + i32(1))).unwrap();\nd := cond((a > b) => (a - b), true => (b - a));\ns = (s + d);\ni = (i + i32(1));\n});\nexport(s);\n";
