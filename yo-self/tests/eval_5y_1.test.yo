// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5y series: f64 arithmetic, escape/return in
/// functions, usize/u64 operations, box(val), HashMap type constructor, combos.
///
/// Phases covered:
///   5ya — f64 arithmetic in source strings (FloatLit results)
///   5yb — usize operations in source strings
///   5yc — u64 operations in source strings
///   5yd — escape(val) and return(val) inside function bodies
///   5ye — box(val) constructor (PtrVal)
///   5yf — HashMap type constructor (TypeVal placeholder)
///   5yg — Combo tests
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5ya — f64 arithmetic in source strings
// ---------------------------------------------------------------------------
test("Phase 5ya: f64(3.0) + f64(1.5) = FloatLit 4.5", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "a := (f64(3.0) + f64(1.5));\nexport(a);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.FloatLit(raw) => assert(raw.as_str() == "4.5", "4.5"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
