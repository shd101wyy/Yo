test("Phase 5yb: i32.to_usize() in while loop index", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(10), i32(20), i32(30)];\n(sum : i32) = i32(0);\n(i : i32) = i32(0);\nwhile(runtime((i < i32(3))), {\nmatch(arr.get(i.to_usize()), .Some(v) => { sum = (sum + v); }, .None => ());\ni = (i + i32(1));\n});\nexport(sum);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "60", "60"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
