test("Phase 5ye: box(i32(42)) produces a PtrVal", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "a := box(i32(42));\nexport(a);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.PtrVal(_, _) => (), _ => assert(false, "PtrVal")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
