test("Phase 5y: array is_empty on non-empty array", {
  env := empty_env();
  // Build: arr := [10, 20, 30]
  arr_items := ArrayList(AstExpr).new();
  arr_items.push(make_atom(TokenKind.Integer, String.from("10")));
  arr_items.push(make_atom(TokenKind.Integer, String.from("20")));
  arr_items.push(make_atom(TokenKind.Integer, String.from("30")));
  arr_expr := make_fncall_atom("array", arr_items);
  def_expr := make_infix(String.from(":="), make_atom(TokenKind.Identifier, String.from("arr")), arr_expr);
  _ := evaluate(def_expr, env);
  // arr.is_empty()
  dot_tok := make_token(TokenKind.Dot, String.from("."));
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(make_atom(TokenKind.Identifier, String.from("arr")));
  dot_args.push(make_atom(TokenKind.Identifier, String.from("is_empty")));
  dot_expr := AstExpr.FnCall(usize(0), AstExpr.Atom(usize(0), dot_tok), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_expr := AstExpr.FnCall(usize(0), dot_expr, call_args, false, dot_tok);
  result := evaluate(call_expr, env);
  match(
    result,
    .None => assert(false, "is_empty returned None"),
    .Some(r) =>
      match(
        r.value,
        .BoolVal(b) => assert(!(b), "non-empty array should be is_empty=false"),
        _ => assert(false, "is_empty should return(BoolVal)")
      )
  );
});
