test("Phase 5y: extern returns unit", {
  env := empty_env();
  ext_args := ArrayList(AstExpr).new();
  ext_args.push(make_atom(TokenKind.StringLit, String.from("\"puts\"")));
  ext_expr := make_fncall_atom("extern", ext_args);
  result := evaluate(ext_expr, env);
  match(
    result,
    .None => assert(false, "extern returned None"),
    .Some(r) =>
      match(
        r.value,
        .UnitVal => (),
        _ => assert(false, "extern(should return(UnitVal))")
      )
  );
});
