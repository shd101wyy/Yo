      m,
      .ModuleVal(_, v) => {
        match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n == "5", "12345 has 5 digits"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n == "1", "7 has 1 digit"), _ => assert(false, "t")),.None => assert(false, "v"));
