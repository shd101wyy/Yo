  src := "s := \"aabbccdd\";\ns2 := s.replace_all(\"aa\", \"x\");\ns3 := s2.replace_all(\"cc\", \"y\");\nlen := s3.len();\nhas_x := s3.contains(\"x\");\nhas_y := s3.contains(\"y\");\nexport(len);\nexport(has_x);\nexport(has_y);";
  exprs := generate_exprs_from_code(src, exn);
  result := evaluate_module_body(exprs, env);
  // "aabbccdd" -> "xbbccdd" -> "xbbydd" = 6 chars
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n == "6", "xbbydd=6"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(1)),.Some(x) => match(x,.BoolVal(b) => assert(b, "has x"), _ => assert(false, "t")),.None => assert(false, "v"));
        match(v.get(usize(2)),.Some(x) => match(x,.BoolVal(b) => assert(b, "has y"), _ => assert(false, "t")),.None => assert(false, "v"));
      },
      _ => assert(false, "m")
    )
  );
});
