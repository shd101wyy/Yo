  env := empty_env();
  dot_tok := make_token(TokenKind.Dot, String.from("."));
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(make_atom(TokenKind.StringLit, String.from("\"\"")));
  dot_args.push(make_atom(TokenKind.Identifier, String.from("is_empty")));
  dot_call := AstExpr.FnCall(usize(0), AstExpr.Atom(usize(0), dot_tok), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  call_expr := AstExpr.FnCall(usize(0), dot_call, call_args, false, dot_tok);
  result := evaluate(call_expr, env);
  match(
    result,
    .None => assert(false, "is_empty returned None"),
    .Some(r) =>
      match(
        r.value,
        .BoolVal(b) => assert(b, "empty string should be is_empty=true"),
        _ => assert(false, "is_empty should return(BoolVal)")
      )
  );
});
