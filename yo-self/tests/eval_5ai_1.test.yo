// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5ai series: to_string, trim, substring,
/// repeat, char_at, replace_all, index_of (StrLit and ArrayVal).
///
/// Phases covered:
///   5aia — to_string() on IntLit, BoolVal, StrLit
///   5aib — StrLit.trim() and StrLit.substring(start, end)
///   5aic — StrLit.repeat(n) and StrLit.char_at(n)
///   5aid — StrLit.replace_all(from, to) and StrLit.index_of(needle)
///   5aie — ArrayVal.index_of(needle) and complex combos
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5aia — to_string() on various value types
// ---------------------------------------------------------------------------
test("Phase 5aia: i64 to_string produces quoted decimal string", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "result := i64(42).to_string();\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.StrLit(s) => assert(s.as_str() == "\"42\"", "42"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

