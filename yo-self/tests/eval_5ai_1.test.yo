  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [\"apple\", \"banana\", \"cherry\"];\nresult := arr.index_of(\"banana\");\nexport(result);\n";
