// ---------------------------------------------------------------------------
// Phase 5aid — StrLit.replace_all(from, to) and StrLit.index_of(needle)
// ---------------------------------------------------------------------------
test("Phase 5aid: replace_all replaces all occurrences of character", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "result := \"hello world\".replace_all(\"l\", \"r\");\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.StrLit(s) => assert(s.as_str() == "\"herro worrd\"", "herro"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

