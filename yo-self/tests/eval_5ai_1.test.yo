test("Phase 5aie: trim then substring then replace_all pipeline", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := \"  hello world  \";\ntrimmed := s.trim();\nsub := trimmed.substring(i64(6), i64(11));\nresult := sub.replace_all(\"o\", \"0\");\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.StrLit(s) => assert(s.as_str() == "\"w0rld\"", "w0rld"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
