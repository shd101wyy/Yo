/// Phase 13ba -- codegen begin handler tests.
///
/// Exercises `yo-self/codegen/exprs/begin.yo`, the metadata-aware 1-to-1 port
/// of `src/codegen/exprs/begin.ts`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr, BK_BEGIN } :: import("../expr.yo");
{ new_expr_info, expr_info_table_new, expr_info_table_set, ControlFlowFlags }
:: import("../expr_info.yo");
{ Environment } :: import("../env.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ t_i32, t_unit } :: import("../types/creators.yo");
{ set_generate_expr_fn } :: import("../codegen/exprs/expr.yo");
{ generate_expr } :: import("../codegen/exprs.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{
  generate_begin,
  begin_expr_has_metadata,
  format_begin_temp_decl,
  format_begin_assignment_line,
  format_begin_block_open
} :: import("../codegen/exprs/begin.yo");
{ get_type_string_opt } :: import("../codegen/utils/index.yo");

mk_token :: (fn(value : str, kind : TokenKind) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);

mk_ident :: (fn(id : usize, value : str) -> AstExpr)(
  AstExpr.Atom(id, mk_token(value, TokenKind.Identifier))
);

mk_begin :: (fn(id : usize, args : ArrayList(AstExpr)) -> AstExpr)(
  AstExpr.FnCall(
    id,
    box(mk_ident(id + usize(1000), BK_BEGIN)),
    args,
    false,
    mk_token(BK_BEGIN, TokenKind.Identifier)
  )
);

stub_generate_expr :: (
  fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    expr,
    .Atom(_, tok) => Option(String).Some(tok.value.clone()),
    .FnCall(_, _, _, _, _) => Option(String).Some(String.from("begin_call"))
  )
);

ensure_table :: (fn(ctx : CodegenContext) -> typeof(expr_info_table_new()))({
  table := match(ctx.expr_info_table,.Some(t) => t,.None => expr_info_table_new());
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  table
});

set_info :: (
  fn(ctx : CodegenContext, id : usize, ty : TypeValue, variable_name : Option(String)) -> unit
)({
  table := ensure_table(ctx);
  info := new_expr_info(Environment.new(String.from("test")), ty);
  info.variable_name = variable_name;
  expr_info_table_set(table, id, info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
});

test("get_type_string_opt: resolves primitive type for begin's return-type lookup", {
  ctx := CodegenContext.new();
  result := get_type_string_opt(t_i32(), ctx);
  assert(match(result,.Some(s) => (s == String.from("int32_t")),.None => false), "i32 c name");
});

test("begin_expr_has_metadata: detects side-table entry", {
  ctx := CodegenContext.new();
  expr := mk_ident(usize(10), "x");
  assert(!(begin_expr_has_metadata(expr, ctx)), "no metadata initially");
  set_info(ctx, usize(10), t_i32(), Option(String).None);
  assert(begin_expr_has_metadata(expr, ctx), "metadata present");
});

test("generate_begin: missing metadata falls back through dispatcher", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(20), "first"));
  args.push(mk_ident(usize(21), "last"));
  call := mk_begin(usize(22), args);
  direct := generate_begin(call, args, ctx, String.from(""));
  assert(direct.is_none(), "direct handler returns None without metadata");
  dispatched := generate_expr(call, ctx, String.from(""));
  assert(match(dispatched,.Some(s) => (s == String.from("last")),.None => false), "dispatcher fallback");
});

test("generate_begin: expression form declares temp and assigns last value", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(30), "side_effect"));
  args.push(mk_ident(usize(31), "value"));
  call := mk_begin(usize(32), args);
  set_info(ctx, usize(30), t_unit(), Option(String).None);
  set_info(ctx, usize(31), t_i32(), Option(String).None);
  set_info(ctx, usize(32), t_i32(), Option(String).Some(String.from("begin_tmp")));
  result := generate_begin(call, args, ctx, String.from(""));
  output := ctx.emitter.print();
  assert(match(result,.Some(s) => (s == String.from("begin_tmp")),.None => false), "returns temp");
  assert(output.contains(String.from("int32_t begin_tmp;")), "temp declaration");
  assert(output.contains(String.from("{ // begin block")), "block open");
  assert(output.contains(String.from("side_effect;")), "non-last emitted");
  assert(output.contains(String.from("begin_tmp = value;")), "last assigned");
  assert(output.contains(String.from("} // end begin block")), "block close");
});

test("generate_begin: unit control-flow result returns empty string", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(40), "return_value"));
  call := mk_begin(usize(41), args);
  set_info(ctx, usize(40), t_unit(), Option(String).None);
  table := ensure_table(ctx);
  info := new_expr_info(Environment.new(String.from("test")), t_unit());
  info.variable_name = Option(String).Some(String.from("unit_tmp"));
  info.control_flow = Option(ControlFlowFlags).Some(
    ControlFlowFlags(return_flag : true, unwind_flag : false, break_flag : false, continue_flag : false)
  );
  expr_info_table_set(table, usize(41), info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  result := generate_begin(call, args, ctx, String.from(""));
  assert(match(result,.Some(s) => (s.len() == usize(0)),.None => false), "empty result");
});

test("generate_begin: statement form emits block and drops", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(50), "stmt"));
  call := mk_begin(usize(51), args);
  drops := ArrayList(AstExpr).new();
  drops.push(mk_ident(usize(52), "drop_tmp"));
  set_info(ctx, usize(50), t_unit(), Option(String).None);
  table := ensure_table(ctx);
  info := new_expr_info(Environment.new(String.from("test")), t_unit());
  info.deferred_drop_expressions = Option(ArrayList(AstExpr)).Some(drops);
  expr_info_table_set(table, usize(51), info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  result := generate_begin(call, args, ctx, String.from(""));
  output := ctx.emitter.print();
  assert(match(result,.Some(s) => (s.len() == usize(0)),.None => false), "empty statement result");
  assert(output.contains(String.from("stmt;")), "statement emitted");
  assert(output.contains(String.from("drop_tmp;")), "drop emitted");
});
// ─── pure string formatters ─────────────────────────────────────────────────
test("format_begin_temp_decl: composes indented `<type> <name>;`", {
  out := format_begin_temp_decl(
    String.from("  "),
    String.from("int32_t"),
    String.from("tmp")
  );
  assert(out == String.from("  int32_t tmp;"), "begin temp decl shape");
});
test("format_begin_assignment_line: composes `<lhs> = <rhs>;`", {
  out := format_begin_assignment_line(
    String.from("    "),
    String.from("tmp"),
    String.from("value")
  );
  assert(out == String.from("    tmp = value;"), "begin assignment shape");
});
test("format_begin_block_open: emits `<indent>{ // begin block`", {
  out := format_begin_block_open(String.from(""));
  assert(out == String.from("{ // begin block"), "begin block open shape");
});
