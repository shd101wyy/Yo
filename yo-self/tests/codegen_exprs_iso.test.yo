/// Phase 13ax -- codegen Iso handler tests.
///
/// Exercises `yo-self/codegen/exprs/iso.yo`, the 1-to-1 port of
/// `src/codegen/exprs/iso.ts` using the ExprInfo side-table.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr, BF_YO_ISO_EXTRACT, BF_YO_ISO_DISPOSE } :: import("../expr.yo");
{ new_expr_info, expr_info_table_new, expr_info_table_set }
:: import("../expr_info.yo");
{ Environment } :: import("../env.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ t_i32, t_bool, t_iso } :: import("../types/creators.yo");
{ type_to_string } :: import("../types/string.yo");
{ EvalValue, create_type_value } :: import("../value.yo");
{ CodegenContext, CodegenTypeEntry } :: import("../codegen/context.yo");
{ set_generate_expr_fn } :: import("../codegen/exprs/expr.yo");
{
  generate_yo_iso_extract,
  generate_yo_iso_dispose,
  is_iso_type_call,
  generate_iso_type_call,
  iso_expr_value_type,
  format_iso_dispose_call,
  format_iso_create_call,
  format_iso_extract_call,
  format_iso_temp_assignment
} :: import("../codegen/exprs/iso.yo");
{ get_type_string } :: import("../codegen/utils/index.yo");

mk_token :: (fn(value : str, kind : TokenKind) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);

mk_atom :: (fn(id : usize, value : str, kind : TokenKind) -> AstExpr)(
  AstExpr.Atom(id, mk_token(value, kind))
);

mk_call :: (fn(id : usize, name : str, args : ArrayList(AstExpr)) -> AstExpr)(
  AstExpr.FnCall(
    id,
    box(mk_atom(id + usize(1000), name, TokenKind.Identifier)),
    args,
    false,
    mk_token(name, TokenKind.Identifier)
  )
);

stub_generate_expr :: (
  fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    expr,
    .Atom(_, tok) => Option(String).Some(tok.value.clone()),
    .FnCall(_, _, _, _, _) => Option(String).Some(String.from("expr"))
  )
);

install_type :: (fn(ctx : CodegenContext, ty : TypeValue, c_name : str) -> unit)({
  ctx.types.set(
    type_to_string(ty),
    CodegenTypeEntry(type_value : ty, c_name : String.from(c_name))
  );
});

test("get_type_string: reads iso C name from context types", {
  ctx := CodegenContext.new();
  ty := t_iso(t_i32());
  install_type(ctx, ty, "__yo_iso_i32");
  assert(get_type_string(ty, ctx) == String.from("__yo_iso_i32"), "iso c name");
});

test("iso_expr_value_type: extracts TypeVal from func metadata", {
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  iso_ty := t_iso(t_i32());
  info := new_expr_info(env, TypeValue.TypeUni(usize(0)));
  info.value = Option(EvalValue).Some(create_type_value(iso_ty));
  expr_info_table_set(table, usize(10), info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  expr := mk_atom(usize(10), "IsoI32", TokenKind.Identifier);
  match(
    iso_expr_value_type(expr, ctx),
    .None => assert(false, "expected type"),
    .Some(found) => assert(type_to_string(found) == type_to_string(iso_ty), "type found")
  );
});

test("is_iso_type_call: detects Iso(T)(value)", {
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  iso_ty := t_iso(t_i32());
  func_info := new_expr_info(env, TypeValue.TypeUni(usize(0)));
  func_info.value = Option(EvalValue).Some(create_type_value(iso_ty));
  expr_info_table_set(table, usize(20), func_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(21), "value", TokenKind.Identifier));
  call := AstExpr.FnCall(usize(22), box(mk_atom(usize(20), "IsoI32", TokenKind.Identifier)), args, false, mk_token("IsoI32", TokenKind.Identifier));
  assert(is_iso_type_call(call, ctx), "iso type call");
});

test("generate_iso_type_call: registers iso type and emits create call", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  iso_ty := t_iso(t_i32());
  install_type(ctx, iso_ty, "__yo_iso_i32");
  install_type(ctx, t_i32(), "int32_t");
  func_info := new_expr_info(env, TypeValue.TypeUni(usize(0)));
  func_info.value = Option(EvalValue).Some(create_type_value(iso_ty));
  expr_info_table_set(table, usize(30), func_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(31), "value", TokenKind.Identifier));
  call := AstExpr.FnCall(usize(32), box(mk_atom(usize(30), "IsoI32", TokenKind.Identifier)), args, false, mk_token("IsoI32", TokenKind.Identifier));
  result := generate_iso_type_call(call, args, ctx, String.from(""));
  match(
    result,
    .None => assert(false, "expected iso create"),
    .Some(code) => assert(code == String.from("__yo_create_iso___yo_iso_i32(value)"), "create call")
  );
  assert(ctx.iso_types.get(String.from("__yo_iso_i32")).is_some(), "iso registered");
});

test("generate_yo_iso_extract: emits extract call", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  iso_ty := t_iso(t_i32());
  install_type(ctx, iso_ty, "__yo_iso_i32");
  install_type(ctx, t_i32(), "int32_t");
  self_info := new_expr_info(env, iso_ty);
  expr_info_table_set(table, usize(40), self_info);
  call_info := new_expr_info(env, t_i32());
  expr_info_table_set(table, usize(42), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(40), "iso_value", TokenKind.Identifier));
  call := mk_call(usize(42), BF_YO_ISO_EXTRACT, args);
  result := generate_yo_iso_extract(call, args, ctx, String.from(""));
  assert(result == String.from("__yo_iso_extract___yo_iso_i32(iso_value)"), "extract call");
});

test("generate_yo_iso_extract: variable_name emits temp declaration", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  iso_ty := t_iso(t_i32());
  install_type(ctx, iso_ty, "__yo_iso_i32");
  install_type(ctx, t_i32(), "int32_t");
  self_info := new_expr_info(env, iso_ty);
  expr_info_table_set(table, usize(50), self_info);
  call_info := new_expr_info(env, t_i32());
  call_info.variable_name = Option(String).Some(String.from("tmp.extract"));
  expr_info_table_set(table, usize(52), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(50), "iso_value", TokenKind.Identifier));
  call := mk_call(usize(52), BF_YO_ISO_EXTRACT, args);
  result := generate_yo_iso_extract(call, args, ctx, String.from("  "));
  // `.` (byte 46) mangles to `_u46_` under the canonical
  // TS-equivalent `sanitize_for_c_identifier`, so the temp variable
  // name appears as `tmp_u46_extract` in the generated C — no
  // collision with bare `tmp_extract`.
  assert(result == String.from("tmp_u46_extract"), "returns temp");
  assert(
    ctx.emitter.code.contains(
      String.from("  int32_t tmp_u46_extract = __yo_iso_extract___yo_iso_i32(iso_value);")
    ),
    "temp declaration"
  );
});

test("generate_yo_iso_dispose: emits dispose call", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  iso_ty := t_iso(t_i32());
  install_type(ctx, iso_ty, "__yo_iso_i32");
  self_info := new_expr_info(env, iso_ty);
  expr_info_table_set(table, usize(60), self_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(60), "iso_value", TokenKind.Identifier));
  call := mk_call(usize(62), BF_YO_ISO_DISPOSE, args);
  result := generate_yo_iso_dispose(call, args, ctx, String.from(""));
  assert(result == String.from("__yo_iso_dispose___yo_iso_i32(iso_value)"), "dispose call");
});

test("generate_yo_iso_extract: rejects non-Iso self type", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  self_info := new_expr_info(env, t_bool());
  expr_info_table_set(table, usize(70), self_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(70), "not_iso", TokenKind.Identifier));
  call := mk_call(usize(72), BF_YO_ISO_EXTRACT, args);
  result := generate_yo_iso_extract(call, args, ctx, String.from(""));
  assert(result == String.from("// Error: __yo_iso_extract requires an Iso type"), "diagnostic");
});
// ─── pure formatters ────────────────────────────────────────────────────────
test("format_iso_dispose_call: composes __yo_iso_dispose_<c>(<self>)", {
  out := format_iso_dispose_call(
    String.from("Iso_String"),
    String.from("local_x")
  );
  assert(
    out == String.from("__yo_iso_dispose_Iso_String(local_x)"),
    "dispose call shape"
  );
});
test("format_iso_create_call: composes __yo_create_iso_<c>(<value>)", {
  out := format_iso_create_call(
    String.from("Iso_String"),
    String.from("\"hello\"")
  );
  assert(
    out == String.from("__yo_create_iso_Iso_String(\"hello\")"),
    "create call shape"
  );
});
test("format_iso_*_call: complex value passes through", {
  // The formatter doesn't escape or paren-wrap — caller is expected
  // to produce a well-formed primary expression.
  out := format_iso_create_call(
    String.from("Iso_Counter"),
    String.from("Counter { count : 0 }")
  );
  assert(
    out == String.from("__yo_create_iso_Iso_Counter(Counter { count : 0 })"),
    "complex value passthrough"
  );
});
test("format_iso_extract_call: composes __yo_iso_extract_<name>(<self>)", {
  out := format_iso_extract_call(
    String.from("Iso_Foo"),
    String.from("self")
  );
  assert(
    out == String.from("__yo_iso_extract_Iso_Foo(self)"),
    "extract call shape"
  );
});
test("format_iso_temp_assignment: composes indented typed assignment", {
  out := format_iso_temp_assignment(
    String.from("  "),
    String.from("Option_int32_t"),
    String.from("tmp_extract"),
    String.from("__yo_iso_extract_Iso_Foo(self)")
  );
  assert(
    out ==
      String.from("  Option_int32_t tmp_extract = __yo_iso_extract_Iso_Foo(self);"),
    "iso temp assignment shape"
  );
});
