        escape(());
      }
    )
  );
  src := "arr := [i32(15), i32(9), i32(2), i32(11), i32(13), i32(11), i32(6), i32(9)];\ns := i32(0); mn := i32(9999); i := i32(7);\nwhile((i >= i32(0)), {\nv := arr.get(i).unwrap(); mn = cond((v < mn) => v, true => mn); s = (s + mn); i = (i - i32(1));\n});\nr := s;\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "39", "39"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 12rz/10fk: T3 new_max_count of [3,14,15,5,3,15,9,7] = 3", {
  env := empty_env();
