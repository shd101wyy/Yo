  compile_module_to_c,
  compile_test_body_to_c
} :: import("../codegen/driver.yo");
// ---------------------------------------------------------------------------
// AST construction helpers
// ---------------------------------------------------------------------------
make_token_raw :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
make_atom_expr :: (fn(kind : TokenKind, value : str) -> AstExpr)(
  .Atom(usize(0), make_token_raw(kind, value))
);
make_infix_expr :: (fn(op : str, lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  op_tok := make_token_raw(TokenKind.Operator, op);
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), args, true, op_tok)
});
make_unary_expr :: (fn(op : str, operand : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(operand);
  op_tok := make_token_raw(TokenKind.Operator, op);
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), args, false, op_tok)
});
make_fncall_expr :: (fn(name : str, args : ArrayList(AstExpr)) -> AstExpr)({
  name_tok := make_token_raw(TokenKind.Identifier, name);
  .FnCall(usize(0), box(.Atom(usize(0), name_tok)), args, false, name_tok)
});
make_begin_expr :: (fn(stmts : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("begin", stmts)
);
make_cond_expr :: (fn(arms : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("cond", arms)
);
make_cond_arm :: (fn(cond_e : AstExpr, body_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(body_e);
  op_tok := make_token_raw(TokenKind.Operator, "=>");
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), a, true, op_tok)
});
make_if_expr :: (fn(cond_e : AstExpr, then_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(then_e);
  make_fncall_expr("if", a)
});
make_if_else_expr :: (fn(cond_e : AstExpr, then_e : AstExpr, else_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(then_e);
  a.push(else_e);
  make_fncall_expr("if", a)
});
make_while_expr :: (fn(cond_e : AstExpr, body_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(body_e);
  make_fncall_expr("while", a)
});
make_runtime_cond :: (fn(inner : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(inner);
  make_fncall_expr("runtime", a)
});
// Phase 4d helpers ——————————————————————————————————————————————————————————
/// Build `FnCall(Dot, [lhs, rhs], is_infix=true)` — dot field/variant access.
make_dot_expr :: (fn(lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(lhs);
  a.push(rhs);
  dot_tok := make_token_raw(TokenKind.Dot, ".");
  .FnCall(usize(0), box(.Atom(usize(0), dot_tok)), a, true, dot_tok)
});
/// Build `FnCall(FnCall(Dot, [obj, method], true), args, false)` — method call.
make_method_call_expr :: (fn(obj : AstExpr, method : str, args : ArrayList(AstExpr)) -> AstExpr)({
  dot_tok := make_token_raw(TokenKind.Dot, ".");
  method_tok := make_token_raw(TokenKind.Identifier, method);
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(obj);
  dot_args.push(AstExpr.Atom(usize(0), method_tok));
  dot_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  AstExpr.FnCall(usize(0), box(dot_expr), args, false, dot_tok)
});
/// Build `FnCall(":", [name_expr, ty_expr], is_infix=true)` — type annotation.
make_colon_expr :: (fn(name_e : AstExpr, ty_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(name_e);
  a.push(ty_e);
  colon_tok := make_token_raw(TokenKind.Operator, ":");
  .FnCall(usize(0), box(.Atom(usize(0), colon_tok)), a, true, colon_tok)
});
/// Build `FnCall("=", [lhs, rhs], is_infix=true)` — assignment or typed decl.
make_assign_expr :: (fn(lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(lhs);
  a.push(rhs);
  eq_tok := make_token_raw(TokenKind.Operator, "=");
  .FnCall(usize(0), box(.Atom(usize(0), eq_tok)), a, true, eq_tok)
});
/// Build a typed declaration `(x : T) = val`.
make_typed_decl_expr :: (fn(name : str, ty_name : str, val_e : AstExpr) -> AstExpr)(
  make_assign_expr(
    make_colon_expr(
      make_atom_expr(TokenKind.Identifier, name),
      make_atom_expr(TokenKind.Identifier, ty_name)
    ),
    val_e
  )
);
/// Convenience: run generate_expr with a fresh context and empty indent.
run_gen :: (fn(expr : AstExpr) -> Option(String))({
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  ind := String.new();
  generate_expr(expr, pctx, ind)
});
/// Convenience: run generate_expr and also return the emitted code.
run_gen_with_ctx :: (fn(expr : AstExpr) -> CodegenContext)({
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  ind := String.new();
  _r := generate_expr(expr, pctx, ind);
  ctx
});
{ parse, ParseError } :: import("../parser.yo");
/// Build `FnCall(Atom("fn"), params, false)` — fn type prefix.
make_fn_type_prefix :: (fn(params : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("fn", params)
);
/// Build `FnCall(Atom("->"), [fn_prefix, ret_ty], true)` — fn type with return.
make_fn_type :: (fn(params : ArrayList(AstExpr), ret_ty : AstExpr) -> AstExpr)({
  fn_prefix := make_fn_type_prefix(params);
  make_infix_expr("->", fn_prefix, ret_ty)
});
/// Build the whole `(fn(params) -> ret_ty)(body)` function literal application.
make_fn_app :: (fn(params : ArrayList(AstExpr), ret_ty : AstExpr, body : AstExpr) -> AstExpr)({
  fn_type := make_fn_type(params, ret_ty);
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  fn_type_tok := make_token_raw(TokenKind.Operator, "->");
  .FnCall(usize(0), box(fn_type), body_args, false, fn_type_tok)
});
/// Build `FnCall(Atom("::"), [name_atom, fn_app], true)` — named constant define.
make_define_expr :: (fn(name : str, rhs : AstExpr) -> AstExpr)(
  make_infix_expr("::", make_atom_expr(TokenKind.Identifier, name), rhs)
);
/// Build `FnCall(Atom(":"), [name, ty], true)` — typed param (reuses make_colon_expr).
make_param :: (fn(name : str, ty_name : str) -> AstExpr)(
  make_colon_expr(
    make_atom_expr(TokenKind.Identifier, name),
    make_atom_expr(TokenKind.Identifier, ty_name)
  )
);
/// Build a `using(name : Type)` evidence param expression.
make_using_param :: (fn(ev_name : str, ty_name : str) -> AstExpr)({
  inner := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, ev_name),
    make_atom_expr(TokenKind.Identifier, ty_name)
  );
  a := ArrayList(AstExpr).new();
  a.push(inner);
  make_fncall_expr("using", a)
});
// ---------------------------------------------------------------------------
// Phase 4e: Type codegen helpers
// ---------------------------------------------------------------------------
test("struct_c_name and enum_c_name", {
  sn := struct_c_name("yoabc123", usize(5));
  en := enum_c_name("yoabc123", usize(7));
  assert(sn == String.from("__yo_struct_yoabc123_id_5"), "struct c name");
  assert(en == String.from("__yo_enum_yoabc123_id_7"), "enum c name");
});
test("enum_tag_prefix: uppercase module_id and id", {
  p := enum_tag_prefix("yoabc123", usize(3));
  assert(p == String.from("__YO_ENUM_YOABC123_ID_3"), "tag prefix");
});
test("type_value_to_c_field: primitives", {
  assert(
    match(type_value_to_c_field(t_i32()),.Some(s) => (s == String.from("int32_t")),.None => false),
    "i32 → int32_t"
  );
  assert(
    match(type_value_to_c_field(t_f32()),.Some(s) => (s == String.from("float")),.None => false),
    "f32 → float"
  );
  assert(
    match(type_value_to_c_field(t_usize()),.Some(s) => (s == String.from("size_t")),.None => false),
    "usize → size_t"
  );
  assert(
    match(type_value_to_c_field(t_bool()),.Some(s) => (s == String.from("bool")),.None => false),
    "bool → bool"
  );
});
test("generate_type_decl: simple struct Point with two i32 fields", {
  field_labels := ArrayList(String).new();
  field_labels.push(String.from("x"));
  field_labels.push(String.from("y"));
  field_types := ArrayList(TypeValue).new();
  field_types.push(t_i32());
  field_types.push(t_i32());
  tv := TypeValue.Struct(String.from(""), String.from("Point"), field_labels, field_types, false, false, false);
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  result_opt := generate_type_decl(tv, "yomod0001", usize(2), pctx);
  c_name := match(result_opt,.Some(s) => s,.None => String.from("NONE"));
  assert(c_name == String.from("__yo_struct_yomod0001_id_2"), "c name");
  output := ctx.emitter.print();
  assert(output.contains(String.from("typedef struct __yo_struct_yomod0001_id_2_struct")), "fwd decl");
  assert(output.contains(String.from("struct __yo_struct_yomod0001_id_2_struct")), "struct def");
  assert(output.contains(String.from("int32_t x;")), "field x");
  assert(output.contains(String.from("int32_t y;")), "field y");
});
test("generate_type_decl: skips explicit comptime-only struct fields", {
  struct_id := String.from("static_struct");
  field_labels := ArrayList(String).new();
  field_labels.push(String.from("tag"));
  field_labels.push(String.from("value"));
  field_types := ArrayList(TypeValue).new();
  field_types.push(t_comptime_string());
  field_types.push(t_i32());
  fields := ArrayList(TypeField).new();
  fields.push(
    TypeField(
      label : String.from("tag"),
      ty : t_comptime_string(),
      is_comptime : true,
      default_value : Option(EvalValue).None,
      assigned_value : Option(EvalValue).None,
      doc_comment : Option(String).None
    )
  );
  fields.push(
    TypeField(
      label : String.from("value"),
      ty : t_i32(),
      is_comptime : false,
      default_value : Option(EvalValue).None,
      assigned_value : Option(EvalValue).None,
      doc_comment : Option(String).None
    )
  );
  register_struct_fields(struct_id, fields);
  tv := TypeValue.Struct(struct_id, String.from("StaticStruct"), field_labels, field_types, false, false, false);
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  _ := generate_type_decl(tv, "yomod0001", usize(3), pctx);
  output := ctx.emitter.print();
  assert(!(output.contains(String.from(" tag;"))), "static field omitted");
  assert(output.contains(String.from("int32_t value;")), "runtime field emitted");
});
test("generate_type_decl: simple enum Color (all unit variants)", {
  variant_names := ArrayList(String).new();
  variant_names.push(String.from("Red"));
  variant_names.push(String.from("Green"));
  variant_names.push(String.from("Blue"));
  variant_fields := ArrayList(ArrayList(TypeValue)).new();
  variant_fields.push(ArrayList(TypeValue).new());
  variant_fields.push(ArrayList(TypeValue).new());
  variant_fields.push(ArrayList(TypeValue).new());
  tv := TypeValue.EnumT(String.from(""), String.from("Color"), variant_names, variant_fields, Option(String).None, ArrayList(ArrayList(String)).new(), ArrayList(i64).new());
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  result_opt := generate_type_decl(tv, "yomod0001", usize(10), pctx);
  c_name := match(result_opt,.Some(s) => s,.None => String.from("NONE"));
  assert(c_name == String.from("__yo_enum_yomod0001_id_10"), "enum c name");
  output := ctx.emitter.print();
  assert(output.contains(String.from("optimized as simple enum")), "simple enum comment");
  assert(output.contains(String.from("__YO_ENUM_YOMOD0001_ID_10_RED")), "RED variant");
  assert(output.contains(String.from("__YO_ENUM_YOMOD0001_ID_10_GREEN")), "GREEN variant");
  assert(output.contains(String.from("__YO_ENUM_YOMOD0001_ID_10_BLUE")), "BLUE variant");
  assert(output.contains(String.from("} __yo_enum_yomod0001_id_10;")), "closing typedef");
});
test("generate_type_decl: data enum Shape with Circle(f32) and Rect(f32, f32)", {
  variant_names := ArrayList(String).new();
  variant_names.push(String.from("Circle"));
  variant_names.push(String.from("Rect"));
  circle_fields := ArrayList(TypeValue).new();
  circle_fields.push(t_f32());
  rect_fields := ArrayList(TypeValue).new();
  rect_fields.push(t_f32());
  rect_fields.push(t_f32());
  variant_fields := ArrayList(ArrayList(TypeValue)).new();
  variant_fields.push(circle_fields);
  variant_fields.push(rect_fields);
  tv := TypeValue.EnumT(String.from(""), String.from("Shape"), variant_names, variant_fields, Option(String).None, ArrayList(ArrayList(String)).new(), ArrayList(i64).new());
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  result_opt := generate_type_decl(tv, "yomod0001", usize(15), pctx);
  c_name := match(result_opt,.Some(s) => s,.None => String.from("NONE"));
  assert(c_name == String.from("__yo_enum_yomod0001_id_15"), "enum c name");
  output := ctx.emitter.print();
  assert(output.contains(String.from("typedef struct __yo_enum_yomod0001_id_15_struct")), "fwd decl");
  assert(output.contains(String.from("__YO_ENUM_YOMOD0001_ID_15_CIRCLE")), "CIRCLE tag");
  assert(output.contains(String.from("__YO_ENUM_YOMOD0001_ID_15_RECT")), "RECT tag");
  assert(output.contains(String.from("typedef union {")), "union");
  assert(output.contains(String.from("} Circle;")), "Circle member");
  assert(output.contains(String.from("} Rect;")), "Rect member");
  assert(output.contains(String.from("__yo_enum_yomod0001_id_15_tag tag;")), "tag field");
  assert(output.contains(String.from("__yo_enum_yomod0001_id_15_data data;")), "data field");
});
test("generate_type_decl: unsupported TypeValue returns None", {
  tv := TypeValue.Int(u8(32), true);
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  result_opt := generate_type_decl(tv, "yomod0001", usize(1), pctx);
  assert(
    match(result_opt,.None => true,.Some(_) => false),
    "primitive should return(None)"
  );
});
// ---------------------------------------------------------------------------
// Phase 4i: RC/GC helper function generation
// ---------------------------------------------------------------------------
test("rc name builders", {
  s := "__yo_struct_yomod_id_2";
  assert(rc_dispose_name(s) == String.from("__yo_struct_yomod_id_2___dispose"), "dispose name");
  assert(rc_drop_name(s) == String.from("__yo_struct_yomod_id_2___drop"), "drop name");
  assert(rc_dup_name(s) == String.from("__yo_struct_yomod_id_2___dup"), "dup name");
});
test("generate_rc_fns_trivial: struct (has_dispose=true)", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  generate_rc_fns_trivial("__yo_struct_yomod_id_2", true, pctx);
  output := ctx.emitter.print();
  // Forward declarations for all three
  assert(output.contains(String.from("__yo_struct_yomod_id_2___dispose")), "dispose present");
  assert(output.contains(String.from("__yo_struct_yomod_id_2___drop")), "drop present");
  assert(output.contains(String.from("__yo_struct_yomod_id_2___dup")), "dup present");
  // Void signatures for dispose and drop
  assert(output.contains(String.from("void __yo_struct_yomod_id_2___dispose(")), "dispose void sig");
  assert(output.contains(String.from("void __yo_struct_yomod_id_2___drop(")), "drop void sig");
  // Dup returns the type
  assert(output.contains(String.from("__yo_struct_yomod_id_2 __yo_struct_yomod_id_2___dup(")), "dup return(type)");
  // Drop body has return;
  assert(output.contains(String.from("return;")), "drop return");
  // Dup body copies __yo_self
  assert(output.contains(String.from("__yo_struct_yomod_id_2 __yo_dup_tmp = __yo_self;")), "dup copy");
  assert(output.contains(String.from("return(__yo_dup_tmp);")), "dup return(tmp)");
});
test("generate_rc_fns_trivial: enum (has_dispose=false)", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  generate_rc_fns_trivial("__yo_enum_yomod_id_5", false, pctx);
  output := ctx.emitter.print();
  // No dispose for enums
  assert(!(output.contains(String.from("___dispose"))), "no dispose for enum");
  // Drop and dup present
  assert(output.contains(String.from("__yo_enum_yomod_id_5___drop")), "drop present");
  assert(output.contains(String.from("__yo_enum_yomod_id_5___dup")), "dup present");
  // Definitions emitted
  assert(output.contains(String.from("void __yo_enum_yomod_id_5___drop(")), "drop def");
  assert(output.contains(String.from("__yo_enum_yomod_id_5 __yo_enum_yomod_id_5___dup(")), "dup def");
});
test("generate_rc_fns: Struct TypeValue generates all three RC fns", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  field_labels := ArrayList(String).new();
  field_labels.push(String.from("x"));
  field_labels.push(String.from("y"));
  field_types := ArrayList(TypeValue).new();
  field_types.push(t_i32());
  field_types.push(t_i32());
  tv := TypeValue.Struct(String.from(""), String.from("Point"), field_labels, field_types, false, false, false);
  ok := generate_rc_fns(tv, "yomod0001", usize(2), pctx);
  assert(ok, "should return(true for Struct)");
  output := ctx.emitter.print();
  assert(output.contains(String.from("__yo_struct_yomod0001_id_2___dispose")), "dispose");
  assert(output.contains(String.from("__yo_struct_yomod0001_id_2___drop")), "drop");
  assert(output.contains(String.from("__yo_struct_yomod0001_id_2___dup")), "dup");
});
test("generate_rc_fns: EnumT TypeValue generates drop+dup, no dispose", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  variant_names := ArrayList(String).new();
  variant_names.push(String.from("Red"));
  variant_names.push(String.from("Green"));
  variant_names.push(String.from("Blue"));
  variant_fields := ArrayList(ArrayList(TypeValue)).new();
  variant_fields.push(ArrayList(TypeValue).new());
  variant_fields.push(ArrayList(TypeValue).new());
  variant_fields.push(ArrayList(TypeValue).new());
  tv := TypeValue.EnumT(String.from(""), String.from("Color"), variant_names, variant_fields, Option(String).None, ArrayList(ArrayList(String)).new(), ArrayList(i64).new());
  ok := generate_rc_fns(tv, "yomod0001", usize(10), pctx);
  assert(ok, "should return(true for EnumT)");
  output := ctx.emitter.print();
  assert(!(output.contains(String.from("___dispose"))), "no dispose for enum");
  assert(output.contains(String.from("__yo_enum_yomod0001_id_10___drop")), "drop");
  assert(output.contains(String.from("__yo_enum_yomod0001_id_10___dup")), "dup");
});
test("generate_rc_fns: unsupported TypeValue returns false", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  tv := TypeValue.Int(u8(32), true);
  ok := generate_rc_fns(tv, "yomod0001", usize(1), pctx);
  assert(!(ok), "should return(false for non-struct/enum)");
});
// ---------------------------------------------------------------------------
// Phase 4j: Program emission
// ---------------------------------------------------------------------------
test("emit_c_preamble: has standard includes", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  emit_c_preamble("yomod0001", pctx);
  output := ctx.emitter.print();
  assert(output.contains(String.from("#define _DEFAULT_SOURCE")), "_DEFAULT_SOURCE");
  assert(output.contains(String.from("#include <stdbool.h>")), "stdbool.h");
  assert(output.contains(String.from("#include <stdint.h>")), "stdint.h");
  assert(output.contains(String.from("#include <stdio.h>")), "stdio.h");
  assert(output.contains(String.from("#include <string.h>")), "string.h");
});
test("emit_c_preamble: has allocator macros", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  emit_c_preamble("yomod0001", pctx);
  output := ctx.emitter.print();
  assert(output.contains(String.from("#define __yo_malloc")), "malloc macro");
  assert(output.contains(String.from("#define __yo_free")), "free macro");
});
test("emit_c_preamble: has module ID comment", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  emit_c_preamble("yoabc999", pctx);
  output := ctx.emitter.print();
  assert(output.contains(String.from("// Module ID: yoabc999")), "module id comment");
});
test("emit_c_preamble: has process platform and arch constants", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  emit_c_preamble("yomod0001", pctx);
  output := ctx.emitter.print();
  assert(output.contains(String.from("static const char* platform")), "platform constant");
  assert(output.contains(String.from("static const char* arch")), "arch constant");
});
test("emit_main_wrapper: emits int main with user fn call", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  emit_main_wrapper("__yo_user_main", pctx);
  output := ctx.emitter.print();
  assert(output.contains(String.from("int main(void) {")), "main signature");
  assert(output.contains(String.from("__yo_user_main();")), "user fn call");
  assert(output.contains(String.from("return(0);")), "return(0)");
});
test("generate_c_output: combines headers + declarations + code", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  ctx.emitter.emit_header_line("// header");
  ctx.emitter.emit_declaration_line("// decl");
  ctx.emitter.emit_line("// code");
  out := generate_c_output(pctx);
  assert(out.contains(String.from("// header")), "header present");
  assert(out.contains(String.from("// decl")), "decl present");
  assert(out.contains(String.from("// code")), "code present");
});
test("full program: preamble + type + RC + function + main wrapper", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  // 1. Preamble
  emit_c_preamble("yomod0001", pctx);
  // 2. Type declaration for Point struct
  field_labels := ArrayList(String).new();
  field_labels.push(String.from("x"));
  field_labels.push(String.from("y"));
  field_types := ArrayList(TypeValue).new();
  field_types.push(t_i32());
  field_types.push(t_i32());
  tv := TypeValue.Struct(String.from(""), String.from("Point"), field_labels, field_types, false, false, false);
  _c_name := generate_type_decl(tv, "yomod0001", usize(2), pctx);
  // 3. RC functions for Point
  tv2 := TypeValue.Struct(String.from(""), String.from("Point"), field_labels, field_types, false, false, false);
  _ok := generate_rc_fns(tv2, "yomod0001", usize(2), pctx);
  // 4. Main wrapper
  emit_main_wrapper("fn_yomod0001_id_0___main", pctx);
  // 5. Get output
  out := generate_c_output(pctx);
  // Verify structure: preamble in headers, type in decls, RC + main in code
  assert(out.contains(String.from("#include <stdio.h>")), "preamble in output");
  assert(out.contains(String.from("__yo_struct_yomod0001_id_2")), "type in output");
  assert(out.contains(String.from("___dispose")), "RC dispose in output");
  assert(out.contains(String.from("int main(void)")), "main wrapper in output");
});
