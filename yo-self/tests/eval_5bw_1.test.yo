// ---------------------------------------------------------------------------
// Phase 5bwc — CRT filtering and multiples of 6
// ---------------------------------------------------------------------------
test("Phase 5bwc: count n in 1..50 where n%3==1 AND n%4==2 = 4", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := i32(0);\nn := i32(1);\nwhile((n <= i32(50)), {\nr3 := (n % i32(3));\nr4 := (n % i32(4));\nc3 := cond((r3 == i32(1)) => i32(1), true => i32(0));\nc4 := cond((r4 == i32(2)) => i32(1), true => i32(0));\ns = (s + (c3 * c4));\nn = (n + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "4"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

