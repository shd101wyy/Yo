test("Phase 5bwa: sum of consecutive pair max in [5,3,8,1,9,2,7,4] = 53", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(5), i32(3), i32(8), i32(1), i32(9), i32(2), i32(7), i32(4)];\ns := i32(0);\ni := i32(0);\nwhile((i < i32(7)), {\na := arr.get(i).unwrap();\nb := arr.get((i + i32(1))).unwrap();\nm := cond((a > b) => a, true => b);\ns = (s + m);\ni = (i + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "53", "53"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5bwb — divisor sums via loop over divisors
// ---------------------------------------------------------------------------
test("Phase 5bwb: sum of proper divisors of 12 = 16", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "n := i32(12);\ns := i32(0);\nd := i32(1);\nwhile((d < n), {\nrem := (n % d);\nis_div := cond((rem == i32(0)) => i32(1), true => i32(0));\ns = (s + (is_div * d));\nd = (d + i32(1));\n});\nexport(s);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "16", "16"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

