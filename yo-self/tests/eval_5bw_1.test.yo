// ---------------------------------------------------------------------------
// Phase 5bwd — grand combos set 1
// alt_sum=19, run_max=62, run_min=16, cpair_max=53
// prop_div_12=16, prop_div_20=22, all_div_12=28, all_div_20=42
// cnt_CRT50=4, sum_CRT50=112, cnt_mult6=5, sum_mult6=90
// ---------------------------------------------------------------------------
test("Phase 5bwd: alt_sum + run_max + run_min = 19+62+16 = 97", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(5), i32(3), i32(8), i32(1), i32(9), i32(2), i32(7), i32(4)];\nalt := i32(0);\ni := i32(0);\nwhile((i < i32(8)), {\nv1 := arr.get(i).unwrap();\nsign := cond(((i % i32(2)) == i32(0)) => i32(1), true => (i32(0) - i32(1)));\nalt = (alt + (sign * v1));\ni = (i + i32(1));\n});\nrmx := i32(0);\nmx := i32(0);\nj := i32(0);\nwhile((j < i32(8)), {\nv2 := arr.get(j).unwrap();\nmx = cond((v2 > mx) => v2, true => mx);\nrmx = (rmx + mx);\nj = (j + i32(1));\n});\nrmn := i32(0);\nmn := i32(9999);\nk := i32(0);\nwhile((k < i32(8)), {\nv3 := arr.get(k).unwrap();\nmn = cond((v3 < mn) => v3, true => mn);\nrmn = (rmn + mn);\nk = (k + i32(1));\n});\nresult := ((alt + rmx) + rmn);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "97", "97"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bwd: cpair_max + prop_div_12 + prop_div_20 = 53+16+22 = 91", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(5), i32(3), i32(8), i32(1), i32(9), i32(2), i32(7), i32(4)];\ncpm := i32(0);\ni := i32(0);\nwhile((i < i32(7)), {\nai := arr.get(i).unwrap();\nbi := arr.get((i + i32(1))).unwrap();\nmi := cond((ai > bi) => ai, true => bi);\ncpm = (cpm + mi);\ni = (i + i32(1));\n});\nn12 := i32(12);\npd12 := i32(0);\nd12 := i32(1);\nwhile((d12 < n12), {\nr12 := (n12 % d12);\nisd12 := cond((r12 == i32(0)) => i32(1), true => i32(0));\npd12 = (pd12 + (isd12 * d12));\nd12 = (d12 + i32(1));\n});\nn20 := i32(20);\npd20 := i32(0);\nd20 := i32(1);\nwhile((d20 < n20), {\nr20 := (n20 % d20);\nisd20 := cond((r20 == i32(0)) => i32(1), true => i32(0));\npd20 = (pd20 + (isd20 * d20));\nd20 = (d20 + i32(1));\n});\nresult := ((cpm + pd12) + pd20);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "91", "91"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5bwd: all_div_12 + all_div_20 + cnt_CRT50 = 28+42+4 = 74", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "n12 := i32(12);\nad12 := i32(0);\nd := i32(1);\nlim12 := (n12 + i32(1));\nwhile((d < lim12), {\nr := (n12 % d);\nis_d := cond((r == i32(0)) => i32(1), true => i32(0));\nad12 = (ad12 + (is_d * d));\nd = (d + i32(1));\n});\nn20 := i32(20);\nad20 := i32(0);\ne := i32(1);\nlim20 := (n20 + i32(1));\nwhile((e < lim20), {\nr := (n20 % e);\nis_d := cond((r == i32(0)) => i32(1), true => i32(0));\nad20 = (ad20 + (is_d * e));\ne = (e + i32(1));\n});\ncnt := i32(0);\nn := i32(1);\nwhile((n <= i32(50)), {\nr3 := (n % i32(3));\nr4 := (n % i32(4));\nc3 := cond((r3 == i32(1)) => i32(1), true => i32(0));\nc4 := cond((r4 == i32(2)) => i32(1), true => i32(0));\ncnt = (cnt + (c3 * c4));\nn = (n + i32(1));\n});\nresult := ((ad12 + ad20) + cnt);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "74", "74"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

