/// Tests for the self-hosted C code emitter — Phase 4a/4b/4c/4d/4e.

open import "std/fmt";
open import "std/string";
{ ArrayList } :: import "std/collections/array_list";

{ Emitter }          :: import "../codegen/emitter.yo";
{ CodegenContext }   :: import "../codegen/context.yo";
{ AstExpr }          :: import "../expr/expr.yo";
{ TokenKind, Token } :: import "../lexer/token.yo";
{ generate_expr, gen_binary_op, gen_unary_op,
  gen_bool_lit, sanitize_c_ident, is_binary_op, is_unary_prefix_op,
  type_name_to_c, gen_arg_list } :: import "../codegen/exprs.yo";
{ generate_function } :: import "../codegen/functions.yo";
{ TypeValue, t_i32, t_f32, t_usize, t_bool } :: import "../types/type.yo";
{ generate_type_decl, type_value_to_c_field,
  struct_c_name, enum_c_name, enum_tag_prefix } :: import "../codegen/types.yo";

// ---------------------------------------------------------------------------
// AST construction helpers
// ---------------------------------------------------------------------------

make_token_raw :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind:        kind,
    value:       String.from(value),
    row:         usize(0),
    column:      usize(0),
    character:   usize(0),
    module_path: String.from(""),
    input:       String.from("")
  )
);

make_atom_expr :: (fn(kind : TokenKind, value : str) -> AstExpr)(
  .Atom(make_token_raw(kind, value))
);

make_infix_expr :: (fn(op : str, lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  op_tok := make_token_raw(TokenKind.Operator, op);
  .FnCall(box(.Atom(op_tok)), args, true, op_tok)
});

make_unary_expr :: (fn(op : str, operand : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(operand);
  op_tok := make_token_raw(TokenKind.Operator, op);
  .FnCall(box(.Atom(op_tok)), args, false, op_tok)
});

make_fncall_expr :: (fn(name : str, args : ArrayList(AstExpr)) -> AstExpr)({
  name_tok := make_token_raw(TokenKind.Identifier, name);
  .FnCall(box(.Atom(name_tok)), args, false, name_tok)
});

make_begin_expr :: (fn(stmts : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("begin", stmts)
);

make_cond_expr :: (fn(arms : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("cond", arms)
);

make_cond_arm :: (fn(cond_e : AstExpr, body_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(body_e);
  op_tok := make_token_raw(TokenKind.Operator, "=>");
  .FnCall(box(.Atom(op_tok)), a, true, op_tok)
});

make_if_expr :: (fn(cond_e : AstExpr, then_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(then_e);
  make_fncall_expr("if", a)
});

make_if_else_expr :: (fn(cond_e : AstExpr, then_e : AstExpr, else_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(then_e);
  a.push(else_e);
  make_fncall_expr("if", a)
});

make_while_expr :: (fn(cond_e : AstExpr, body_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(body_e);
  make_fncall_expr("while", a)
});

make_runtime_cond :: (fn(inner : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(inner);
  make_fncall_expr("runtime", a)
});

// Phase 4d helpers ——————————————————————————————————————————————————————————

/// Build `FnCall(Dot, [lhs, rhs], is_infix=true)` — dot field/variant access.
make_dot_expr :: (fn(lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(lhs);
  a.push(rhs);
  dot_tok := make_token_raw(TokenKind.Dot, ".");
  .FnCall(box(.Atom(dot_tok)), a, true, dot_tok)
});

/// Build `FnCall(FnCall(Dot, [obj, method], true), args, false)` — method call.
make_method_call_expr :: (fn(obj : AstExpr, method : str, args : ArrayList(AstExpr)) -> AstExpr)({
  dot_tok    := make_token_raw(TokenKind.Dot, ".");
  method_tok := make_token_raw(TokenKind.Identifier, method);
  dot_args   := ArrayList(AstExpr).new();
  dot_args.push(obj);
  dot_args.push(AstExpr.Atom(method_tok));
  dot_expr := AstExpr.FnCall(box(AstExpr.Atom(dot_tok)), dot_args, true, dot_tok);
  AstExpr.FnCall(box(dot_expr), args, false, dot_tok)
});

/// Build `FnCall(":", [name_expr, ty_expr], is_infix=true)` — type annotation.
make_colon_expr :: (fn(name_e : AstExpr, ty_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(name_e);
  a.push(ty_e);
  colon_tok := make_token_raw(TokenKind.Operator, ":");
  .FnCall(box(.Atom(colon_tok)), a, true, colon_tok)
});

/// Build `FnCall("=", [lhs, rhs], is_infix=true)` — assignment or typed decl.
make_assign_expr :: (fn(lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(lhs);
  a.push(rhs);
  eq_tok := make_token_raw(TokenKind.Operator, "=");
  .FnCall(box(.Atom(eq_tok)), a, true, eq_tok)
});

/// Build a typed declaration `(x : T) = val`.
make_typed_decl_expr :: (fn(name : str, ty_name : str, val_e : AstExpr) -> AstExpr)(
  make_assign_expr(
    make_colon_expr(
      make_atom_expr(TokenKind.Identifier, name),
      make_atom_expr(TokenKind.Identifier, ty_name)
    ),
    val_e
  )
);

/// Convenience: run generate_expr with a fresh context and empty indent.
run_gen :: (fn(expr : AstExpr) -> Option(String))({
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;
  ind := String.new();
  generate_expr(expr, pctx, ind)
});

/// Convenience: run generate_expr and also return the emitted code.
run_gen_with_ctx :: (fn(expr : AstExpr) -> CodegenContext)({
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;
  ind := String.new();
  _r := generate_expr(expr, pctx, ind);
  ctx
});

// ---------------------------------------------------------------------------
// Phase 4a — Emitter tests
// ---------------------------------------------------------------------------

test "Emitter: new creates empty buffers", {
  e := Emitter.new();
  output := e.print();
  // headers="", decls="", code="" => "\n\n"
  assert(
    (output == String.from("\n\n")),
    "expected two newlines for empty emitter"
  );
};

test "Emitter: emit appends to code without newline", {
  e := Emitter.new();
  e.emit("int x = 42;");
  output := e.print();
  // code section should end with "int x = 42;" (no extra newline)
  assert(
    output.contains(String.from("int x = 42;")),
    "expected emit to add code"
  );
};

test "Emitter: emit_line appends to code with newline", {
  e := Emitter.new();
  e.emit_line("int x = 1;");
  e.emit_line("int y = 2;");
  output := e.print();
  assert(
    output.contains(String.from("int x = 1;\n")),
    "expected first line with newline"
  );
  assert(
    output.contains(String.from("int y = 2;\n")),
    "expected second line with newline"
  );
};

test "Emitter: emit_header_line appends to headers", {
  e := Emitter.new();
  e.emit_header_line("#include <stdio.h>");
  output := e.print();
  assert(
    output.contains(String.from("#include <stdio.h>")),
    "expected header line in output"
  );
};

test "Emitter: emit_declaration_line appends to declarations", {
  e := Emitter.new();
  e.emit_declaration_line("typedef struct Foo Foo;");
  output := e.print();
  assert(
    output.contains(String.from("typedef struct Foo Foo;")),
    "expected declaration in output"
  );
};

test "Emitter: print preserves section ordering", {
  e := Emitter.new();
  e.emit_header_line("#include <stdint.h>");
  e.emit_declaration_line("typedef int32_t i32;");
  e.emit_line("int main(void) { return 0; }");
  output := e.print();
  // Find positions of each section marker to verify ordering
  h_pos := output.index_of(String.from("#include"), usize(0));
  d_pos := output.index_of(String.from("typedef"), usize(0));
  c_pos := output.index_of(String.from("int main"), usize(0));
  assert(
    match(h_pos,
      .None => false,
      .Some(_) => true
    ),
    "header should be present"
  );
  assert(
    match(d_pos,
      .None => false,
      .Some(_) => true
    ),
    "declaration should be present"
  );
  assert(
    match(c_pos,
      .None => false,
      .Some(_) => true
    ),
    "code should be present"
  );
  match(h_pos,
    .None => assert(false, "unreachable"),
    .Some(h) => match(d_pos,
      .None => assert(false, "unreachable"),
      .Some(d) => match(c_pos,
        .None => assert(false, "unreachable"),
        .Some(c) => {
          assert((h < d), "headers must precede declarations");
          assert((d < c), "declarations must precede code");
        }
      )
    )
  );
};

test "Emitter: emit_string appends String to code", {
  e := Emitter.new();
  e.emit_string(String.from("return 0;"));
  output := e.print();
  assert(
    output.contains(String.from("return 0;")),
    "expected emitted string in output"
  );
};

test "Emitter: multiple emit calls accumulate in code", {
  e := Emitter.new();
  e.emit("foo(");
  e.emit("1");
  e.emit(", ");
  e.emit("2");
  e.emit(")");
  output := e.print();
  assert(
    output.contains(String.from("foo(1, 2)")),
    "expected concatenated code"
  );
};

// ---------------------------------------------------------------------------
// Phase 4b — generate_expr tests
// ---------------------------------------------------------------------------

test "generate_expr: integer literal", {
  expr := make_atom_expr(TokenKind.Integer, "42");
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("42"))),
    "expected '42'"
  );
};

test "generate_expr: float literal", {
  expr := make_atom_expr(TokenKind.Float, "3.14");
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("3.14"))),
    "expected '3.14'"
  );
};

test "generate_expr: bool literal true", {
  expr := make_atom_expr(TokenKind.Bool, "true");
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("1"))),
    "expected '1' for true"
  );
};

test "generate_expr: bool literal false", {
  expr := make_atom_expr(TokenKind.Bool, "false");
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("0"))),
    "expected '0' for false"
  );
};

test "generate_expr: string literal", {
  expr := make_atom_expr(TokenKind.StringLit, "\"hello\"");
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("\"hello\""))),
    "expected string literal verbatim"
  );
};

test "generate_expr: identifier reference", {
  expr := make_atom_expr(TokenKind.Identifier, "my_var");
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("my_var"))),
    "expected identifier name"
  );
};

test "generate_expr: binary addition", {
  lhs  := make_atom_expr(TokenKind.Integer, "1");
  rhs  := make_atom_expr(TokenKind.Integer, "2");
  expr := make_infix_expr("+", lhs, rhs);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("(1 + 2)"))),
    "expected '(1 + 2)'"
  );
};

test "generate_expr: binary subtraction", {
  lhs  := make_atom_expr(TokenKind.Integer, "10");
  rhs  := make_atom_expr(TokenKind.Integer, "3");
  expr := make_infix_expr("-", lhs, rhs);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("(10 - 3)"))),
    "expected '(10 - 3)'"
  );
};

test "generate_expr: binary multiplication", {
  lhs  := make_atom_expr(TokenKind.Integer, "4");
  rhs  := make_atom_expr(TokenKind.Integer, "5");
  expr := make_infix_expr("*", lhs, rhs);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("(4 * 5)"))),
    "expected '(4 * 5)'"
  );
};

test "generate_expr: equality comparison", {
  lhs  := make_atom_expr(TokenKind.Identifier, "x");
  rhs  := make_atom_expr(TokenKind.Integer, "0");
  expr := make_infix_expr("==", lhs, rhs);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("(x == 0)"))),
    "expected '(x == 0)'"
  );
};

test "generate_expr: less-than comparison", {
  lhs  := make_atom_expr(TokenKind.Identifier, "n");
  rhs  := make_atom_expr(TokenKind.Integer, "10");
  expr := make_infix_expr("<", lhs, rhs);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("(n < 10)"))),
    "expected '(n < 10)'"
  );
};

test "generate_expr: logical and", {
  lhs  := make_atom_expr(TokenKind.Identifier, "a");
  rhs  := make_atom_expr(TokenKind.Identifier, "b");
  expr := make_infix_expr("&&", lhs, rhs);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("(a && b)"))),
    "expected '(a && b)'"
  );
};

test "generate_expr: logical or", {
  lhs  := make_atom_expr(TokenKind.Identifier, "x");
  rhs  := make_atom_expr(TokenKind.Identifier, "y");
  expr := make_infix_expr("||", lhs, rhs);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("(x || y)"))),
    "expected '(x || y)'"
  );
};

test "generate_expr: unary negation", {
  operand := make_atom_expr(TokenKind.Integer, "5");
  expr    := make_unary_expr("-", operand);
  result  := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("(-5)"))),
    "expected '(-5)'"
  );
};

test "generate_expr: unary boolean not", {
  operand := make_atom_expr(TokenKind.Identifier, "flag");
  expr    := make_unary_expr("!", operand);
  result  := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("(!flag)"))),
    "expected '(!flag)'"
  );
};

test "generate_expr: nested binary ops", {
  // (1 + 2) * 3
  inner := make_infix_expr("+",
    make_atom_expr(TokenKind.Integer, "1"),
    make_atom_expr(TokenKind.Integer, "2")
  );
  expr := make_infix_expr("*", inner, make_atom_expr(TokenKind.Integer, "3"));
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("((1 + 2) * 3)"))),
    "expected '((1 + 2) * 3)'"
  );
};

test "generate_expr: unsupported expr returns None", {
  // An operator Atom (not an identifier or literal) should return None
  expr := make_atom_expr(TokenKind.Operator, "+");
  result := run_gen(expr);
  assert(
    match(result, .None => true, .Some(_) => false),
    "expected None for unsupported operator atom"
  );
};

test "gen_bool_lit: true maps to 1", {
  assert((gen_bool_lit("true") == String.from("1")), "true -> 1");
};

test "gen_bool_lit: false maps to 0", {
  assert((gen_bool_lit("false") == String.from("0")), "false -> 0");
};

test "gen_binary_op: produces parenthesised output", {
  result := gen_binary_op(String.from("+"), String.from("a"), String.from("b"));
  assert((result == String.from("(a + b)")), "expected '(a + b)'");
};

test "gen_unary_op: produces parenthesised output", {
  result := gen_unary_op(String.from("-"), String.from("x"));
  assert((result == String.from("(-x)")), "expected '(-x)'");
};

test "is_binary_op: recognises all supported ops", {
  assert(is_binary_op("+"),  "+ should be binary");
  assert(is_binary_op("-"),  "- should be binary");
  assert(is_binary_op("*"),  "* should be binary");
  assert(is_binary_op("/"),  "/ should be binary");
  assert(is_binary_op("%"),  "% should be binary");
  assert(is_binary_op("=="), "== should be binary");
  assert(is_binary_op("!="), "!= should be binary");
  assert(is_binary_op("<"),  "< should be binary");
  assert(is_binary_op(">"),  "> should be binary");
  assert(is_binary_op("<="), "<= should be binary");
  assert(is_binary_op(">="), ">= should be binary");
  assert(is_binary_op("&&"), "&& should be binary");
  assert(is_binary_op("||"), "|| should be binary");
  assert((!is_binary_op("=")), "= is not a supported binary op here");
};

test "is_unary_prefix_op: recognises - and !", {
  assert(is_unary_prefix_op("-"),    "- is a unary op");
  assert(is_unary_prefix_op("!"),    "! is a unary op");
  assert((!is_unary_prefix_op("+")), "+ is not a unary op");
};

test "sanitize_c_ident: simple names pass through unchanged", {
  assert((sanitize_c_ident("foo") == String.from("foo")), "foo -> foo");
  assert((sanitize_c_ident("my_var_123") == String.from("my_var_123")), "my_var_123 ok");
};

// ---------------------------------------------------------------------------
// Phase 4c — control flow codegen tests
// ---------------------------------------------------------------------------

test "generate_expr: begin block single expr", {
  // { 42 }  →  "42"
  stmts := ArrayList(AstExpr).new();
  stmts.push(make_atom_expr(TokenKind.Integer, "42"));
  expr := make_begin_expr(stmts);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("42"))),
    "expected '42' as last expr of begin"
  );
};

test "generate_expr: begin block emits non-last stmts", {
  // { 1; x }  →  emitter has "1;\n", result is "x"
  stmts := ArrayList(AstExpr).new();
  stmts.push(make_atom_expr(TokenKind.Integer, "1"));
  stmts.push(make_atom_expr(TokenKind.Identifier, "x"));
  expr := make_begin_expr(stmts);
  ctx := run_gen_with_ctx(expr);
  output := ctx.emitter.print();
  assert(
    output.contains(String.from("1;")),
    "expected '1;' emitted for first stmt"
  );
};

test "generate_expr: empty begin block", {
  stmts := ArrayList(AstExpr).new();
  expr := make_begin_expr(stmts);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("0"))),
    "empty begin block should return '0'"
  );
};

test "generate_expr: cond two arms", {
  // cond(true => 1, true => 2)  →  "(1 ? 1 : 2)"
  arms := ArrayList(AstExpr).new();
  arms.push(make_cond_arm(
    make_atom_expr(TokenKind.Bool, "true"),
    make_atom_expr(TokenKind.Integer, "1")
  ));
  arms.push(make_cond_arm(
    make_atom_expr(TokenKind.Bool, "true"),
    make_atom_expr(TokenKind.Integer, "2")
  ));
  expr := make_cond_expr(arms);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("(1 ? 1 : 2)"))),
    "expected '(1 ? 1 : 2)'"
  );
};

test "generate_expr: cond three arms", {
  // cond(a => 10, b => 20, true => 30)  →  "(a ? 10 : (b ? 20 : 30))"
  arms := ArrayList(AstExpr).new();
  arms.push(make_cond_arm(
    make_atom_expr(TokenKind.Identifier, "a"),
    make_atom_expr(TokenKind.Integer, "10")
  ));
  arms.push(make_cond_arm(
    make_atom_expr(TokenKind.Identifier, "b"),
    make_atom_expr(TokenKind.Integer, "20")
  ));
  arms.push(make_cond_arm(
    make_atom_expr(TokenKind.Bool, "true"),
    make_atom_expr(TokenKind.Integer, "30")
  ));
  expr := make_cond_expr(arms);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("(a ? 10 : (b ? 20 : 30))"))),
    "expected '(a ? 10 : (b ? 20 : 30))'"
  );
};

test "generate_expr: empty cond", {
  arms := ArrayList(AstExpr).new();
  expr := make_cond_expr(arms);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("0"))),
    "empty cond should return '0'"
  );
};

test "generate_expr: if two-branch", {
  // if(c, t, e)  →  "(c ? t : e)"
  expr := make_if_else_expr(
    make_atom_expr(TokenKind.Identifier, "c"),
    make_atom_expr(TokenKind.Identifier, "t"),
    make_atom_expr(TokenKind.Identifier, "e")
  );
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("(c ? t : e)"))),
    "expected '(c ? t : e)'"
  );
};

test "generate_expr: if one-branch", {
  // if(c, t)  →  "(c ? t : 0)"
  expr := make_if_expr(
    make_atom_expr(TokenKind.Identifier, "c"),
    make_atom_expr(TokenKind.Integer, "42")
  );
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("(c ? 42 : 0)"))),
    "expected '(c ? 42 : 0)'"
  );
};

test "generate_expr: while emits loop and returns 0", {
  // while runtime(x), y  →  emits "while (x) {\n  y;\n}\n", result is "0"
  cond_e := make_runtime_cond(make_atom_expr(TokenKind.Identifier, "running"));
  body_e := make_atom_expr(TokenKind.Identifier, "step");
  expr   := make_while_expr(cond_e, body_e);
  ctx    := run_gen_with_ctx(expr);
  output := ctx.emitter.print();
  assert(
    output.contains(String.from("while (running)")),
    "expected 'while (running)' in output"
  );
  assert(
    output.contains(String.from("step;")),
    "expected 'step;' emitted inside loop"
  );
};

// ---------------------------------------------------------------------------
// Phase 4d — type mapping, function calls, dot access, assignment
// ---------------------------------------------------------------------------

test "type_name_to_c: primitive types", {
  assert((type_name_to_c("i8")    == String.from("int8_t")),    "i8");
  assert((type_name_to_c("i16")   == String.from("int16_t")),   "i16");
  assert((type_name_to_c("i32")   == String.from("int32_t")),   "i32");
  assert((type_name_to_c("i64")   == String.from("int64_t")),   "i64");
  assert((type_name_to_c("u8")    == String.from("uint8_t")),   "u8");
  assert((type_name_to_c("u16")   == String.from("uint16_t")),  "u16");
  assert((type_name_to_c("u32")   == String.from("uint32_t")),  "u32");
  assert((type_name_to_c("u64")   == String.from("uint64_t")),  "u64");
  assert((type_name_to_c("usize") == String.from("size_t")),    "usize");
  assert((type_name_to_c("f32")   == String.from("float")),     "f32");
  assert((type_name_to_c("f64")   == String.from("double")),    "f64");
  assert((type_name_to_c("bool")  == String.from("bool")),      "bool");
  assert((type_name_to_c("str")   == String.from("const char*")), "str");
  assert((type_name_to_c("unit")  == String.from("void")),      "unit");
};

test "type_name_to_c: unknown name passes through unchanged", {
  assert((type_name_to_c("MyType") == String.from("MyType")), "user-defined type");
};

test "generate_expr: regular function call no args", {
  // f()  →  "f()"
  args := ArrayList(AstExpr).new();
  expr := make_fncall_expr("f", args);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("f()"))),
    "expected 'f()'"
  );
};

test "generate_expr: regular function call with args", {
  // foo(1, x)  →  "foo(1, x)"
  args := ArrayList(AstExpr).new();
  args.push(make_atom_expr(TokenKind.Integer, "1"));
  args.push(make_atom_expr(TokenKind.Identifier, "x"));
  expr := make_fncall_expr("foo", args);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("foo(1, x)"))),
    "expected 'foo(1, x)'"
  );
};

test "generate_expr: dot field access", {
  // a.b  →  "a.b"
  lhs  := make_atom_expr(TokenKind.Identifier, "a");
  rhs  := make_atom_expr(TokenKind.Identifier, "b");
  expr := make_dot_expr(lhs, rhs);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("a.b"))),
    "expected 'a.b'"
  );
};

test "generate_expr: method call no extra args", {
  // obj.method()  →  "obj.method()"
  obj  := make_atom_expr(TokenKind.Identifier, "obj");
  args := ArrayList(AstExpr).new();
  expr := make_method_call_expr(obj, "method", args);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("obj.method()"))),
    "expected 'obj.method()'"
  );
};

test "generate_expr: method call with args", {
  // vec.push(x)  →  "vec.push(x)"
  obj  := make_atom_expr(TokenKind.Identifier, "vec");
  args := ArrayList(AstExpr).new();
  args.push(make_atom_expr(TokenKind.Identifier, "x"));
  expr := make_method_call_expr(obj, "push", args);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("vec.push(x)"))),
    "expected 'vec.push(x)'"
  );
};

test "generate_expr: bare assignment expression", {
  // x = 5  →  "x = 5"
  lhs  := make_atom_expr(TokenKind.Identifier, "x");
  rhs  := make_atom_expr(TokenKind.Integer, "5");
  expr := make_assign_expr(lhs, rhs);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("x = 5"))),
    "expected 'x = 5'"
  );
};

test "generate_expr: typed declaration emits statement", {
  // (x : i32) = 42  →  emits "int32_t x = 42;" as statement, returns "0"
  expr := make_typed_decl_expr("x", "i32", make_atom_expr(TokenKind.Integer, "42"));
  ctx  := run_gen_with_ctx(expr);
  output := ctx.emitter.print();
  assert(
    output.contains(String.from("int32_t x = 42;")),
    "expected 'int32_t x = 42;' emitted as statement"
  );
};

test "generate_expr: typed declaration returns 0", {
  // (x : i32) = 42  →  returns "0"
  expr   := make_typed_decl_expr("x", "i32", make_atom_expr(TokenKind.Integer, "42"));
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("0"))),
    "typed decl should return '0'"
  );
};

test "generate_expr: nested function call in arg", {
  // f(g(1))  →  "f(g(1))"
  inner_args := ArrayList(AstExpr).new();
  inner_args.push(make_atom_expr(TokenKind.Integer, "1"));
  inner := make_fncall_expr("g", inner_args);
  outer_args := ArrayList(AstExpr).new();
  outer_args.push(inner);
  expr := make_fncall_expr("f", outer_args);
  result := run_gen(expr);
  assert(
    match(result, .None => false, .Some(s) => (s == String.from("f(g(1))"))),
    "expected 'f(g(1))'"
  );
};

test "generate_function: void function with no params", {
  // static void hello() { return 0; }  — body is just integer 0
  params    := ArrayList(String).new();
  param_tys := ArrayList(String).new();
  body      := make_atom_expr(TokenKind.Integer, "0");
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;
  generate_function("hello", "void", params, param_tys, body, pctx);
  output := ctx.emitter.print();
  assert(output.contains(String.from("static void hello()")), "expected function signature");
  assert(output.contains(String.from("{")),  "expected opening brace");
  assert(output.contains(String.from("}")),  "expected closing brace");
};

test "generate_function: int function with params", {
  // static int32_t add(int32_t a, int32_t b) { return (a + b); }
  params    := ArrayList(String).new();
  param_tys := ArrayList(String).new();
  params.push(String.from("a"));
  params.push(String.from("b"));
  param_tys.push(String.from("int32_t"));
  param_tys.push(String.from("int32_t"));
  body := make_infix_expr("+",
    make_atom_expr(TokenKind.Identifier, "a"),
    make_atom_expr(TokenKind.Identifier, "b")
  );
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;
  generate_function("add", "int32_t", params, param_tys, body, pctx);
  output := ctx.emitter.print();
  assert(output.contains(String.from("static int32_t add(int32_t a, int32_t b)")), "signature");
  assert(output.contains(String.from("return")),    "expected return");
  assert(output.contains(String.from("(a + b)")),   "expected body expression");
};

test "generate_function: function with begin block body", {
  // static int32_t const_42() { return 42; }
  // body is a begin block: { 42 }
  stmts := ArrayList(AstExpr).new();
  stmts.push(make_atom_expr(TokenKind.Integer, "42"));
  body      := make_begin_expr(stmts);
  params    := ArrayList(String).new();
  param_tys := ArrayList(String).new();
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;
  generate_function("const_42", "int32_t", params, param_tys, body, pctx);
  output := ctx.emitter.print();
  assert(output.contains(String.from("static int32_t const_42()")), "signature");
  assert(output.contains(String.from("return 42;")), "expected 'return 42;'");
};

// ---------------------------------------------------------------------------
// Phase 4e: Type codegen helpers
// ---------------------------------------------------------------------------

test "struct_c_name and enum_c_name", {
  sn := struct_c_name("yoabc123", usize(5));
  en := enum_c_name("yoabc123", usize(7));
  assert((sn == String.from("__yo_struct_yoabc123_id_5")), "struct c name");
  assert((en == String.from("__yo_enum_yoabc123_id_7")),   "enum c name");
};

test "enum_tag_prefix: uppercase module_id and id", {
  p := enum_tag_prefix("yoabc123", usize(3));
  assert((p == String.from("__YO_ENUM_YOABC123_ID_3")), "tag prefix");
};

test "type_value_to_c_field: primitives", {
  assert(
    match(type_value_to_c_field(t_i32()), .Some(s) => (s == String.from("int32_t")), .None => false),
    "i32 → int32_t"
  );
  assert(
    match(type_value_to_c_field(t_f32()), .Some(s) => (s == String.from("float")), .None => false),
    "f32 → float"
  );
  assert(
    match(type_value_to_c_field(t_usize()), .Some(s) => (s == String.from("size_t")), .None => false),
    "usize → size_t"
  );
  assert(
    match(type_value_to_c_field(t_bool()), .Some(s) => (s == String.from("bool")), .None => false),
    "bool → bool"
  );
};

test "generate_type_decl: simple struct Point with two i32 fields", {
  field_labels := ArrayList(String).new();
  field_labels.push(String.from("x"));
  field_labels.push(String.from("y"));
  field_types := ArrayList(TypeValue).new();
  field_types.push(t_i32());
  field_types.push(t_i32());
  tv := TypeValue.Struct(String.from("Point"), field_labels, field_types);

  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;
  result_opt := generate_type_decl(tv, "yomod0001", usize(2), pctx);
  c_name := match(result_opt, .Some(s) => s, .None => String.from("NONE"));

  assert((c_name == String.from("__yo_struct_yomod0001_id_2")), "c name");

  output := ctx.emitter.print();
  assert(output.contains(String.from("typedef struct __yo_struct_yomod0001_id_2_struct")), "fwd decl");
  assert(output.contains(String.from("struct __yo_struct_yomod0001_id_2_struct")), "struct def");
  assert(output.contains(String.from("int32_t x;")), "field x");
  assert(output.contains(String.from("int32_t y;")), "field y");
};

test "generate_type_decl: simple enum Color (all unit variants)", {
  variant_names := ArrayList(String).new();
  variant_names.push(String.from("Red"));
  variant_names.push(String.from("Green"));
  variant_names.push(String.from("Blue"));
  variant_fields := ArrayList(ArrayList(TypeValue)).new();
  variant_fields.push(ArrayList(TypeValue).new());
  variant_fields.push(ArrayList(TypeValue).new());
  variant_fields.push(ArrayList(TypeValue).new());
  tv := TypeValue.EnumT(String.from("Color"), variant_names, variant_fields);

  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;
  result_opt := generate_type_decl(tv, "yomod0001", usize(10), pctx);
  c_name := match(result_opt, .Some(s) => s, .None => String.from("NONE"));

  assert((c_name == String.from("__yo_enum_yomod0001_id_10")), "enum c name");

  output := ctx.emitter.print();
  assert(output.contains(String.from("optimized as simple enum")), "simple enum comment");
  assert(output.contains(String.from("__YO_ENUM_YOMOD0001_ID_10_RED")),   "RED variant");
  assert(output.contains(String.from("__YO_ENUM_YOMOD0001_ID_10_GREEN")), "GREEN variant");
  assert(output.contains(String.from("__YO_ENUM_YOMOD0001_ID_10_BLUE")),  "BLUE variant");
  assert(output.contains(String.from("} __yo_enum_yomod0001_id_10;")),     "closing typedef");
};

test "generate_type_decl: data enum Shape with Circle(f32) and Rect(f32, f32)", {
  variant_names := ArrayList(String).new();
  variant_names.push(String.from("Circle"));
  variant_names.push(String.from("Rect"));

  circle_fields := ArrayList(TypeValue).new();
  circle_fields.push(t_f32());
  rect_fields := ArrayList(TypeValue).new();
  rect_fields.push(t_f32());
  rect_fields.push(t_f32());
  variant_fields := ArrayList(ArrayList(TypeValue)).new();
  variant_fields.push(circle_fields);
  variant_fields.push(rect_fields);

  tv := TypeValue.EnumT(String.from("Shape"), variant_names, variant_fields);
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;
  result_opt := generate_type_decl(tv, "yomod0001", usize(15), pctx);
  c_name := match(result_opt, .Some(s) => s, .None => String.from("NONE"));

  assert((c_name == String.from("__yo_enum_yomod0001_id_15")), "enum c name");

  output := ctx.emitter.print();
  assert(output.contains(String.from("typedef struct __yo_enum_yomod0001_id_15_struct")), "fwd decl");
  assert(output.contains(String.from("__YO_ENUM_YOMOD0001_ID_15_CIRCLE")), "CIRCLE tag");
  assert(output.contains(String.from("__YO_ENUM_YOMOD0001_ID_15_RECT")),   "RECT tag");
  assert(output.contains(String.from("typedef union {")), "union");
  assert(output.contains(String.from("} Circle;")),       "Circle member");
  assert(output.contains(String.from("} Rect;")),         "Rect member");
  assert(output.contains(String.from("__yo_enum_yomod0001_id_15_tag tag;")),  "tag field");
  assert(output.contains(String.from("__yo_enum_yomod0001_id_15_data data;")), "data field");
};

test "generate_type_decl: unsupported TypeValue returns None", {
  tv := TypeValue.Int(u8(32), true);
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;
  result_opt := generate_type_decl(tv, "yomod0001", usize(1), pctx);
  assert(
    match(result_opt, .None => true, .Some(_) => false),
    "primitive should return None"
  );
};
