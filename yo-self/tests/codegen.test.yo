      }
    )
  );
  src := String.from("Withdraw :: struct(balance : i32); make :: (fn() -> Withdraw)({ (balance : i32) = 100; return({ balance }); }); main :: (fn() -> unit)({ bank := make(); assert(bank.balance == 100); }); export(main);");
  exprs := parse(src, String.from("<test>"), using(exn));
  opt_c := compile_module_to_c(exprs, "return_single_field_struct_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("return (Withdraw){ .balance = balance };")), "return coerces shorthand struct literal");
      assert(!(c.contains(String.from("return balance;"))), "return must not emit bare field value");
    }
  );
});
test("validation: anonymous struct constructors emit direct declarations", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        escape(());
      }
    )
  );
  src := String.from("main :: (fn() -> unit)({ p := (struct(x : i32, y : i32))(3, 4); assert(p.x == 3); (p2 : struct(x : i32, y : i32)) = _(3, 4); assert(p2.y == 4); }); export(main);");
  exprs := parse(src, String.from("<test>"), using(exn));
  opt_c := compile_module_to_c(exprs, "anon_struct_constructor_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("struct { int32_t x; int32_t y; } p = {3, 4};")), "anonymous constructor define emits named variable declaration");
      assert(c.contains(String.from("struct { int32_t x; int32_t y; } p2 = {3, 4};")), "typed anonymous struct assignment emits direct declaration");
      assert(c.contains(String.from("p.x == 3")), "anonymous struct define variable is available");
      assert(c.contains(String.from("p2.y == 4")), "typed anonymous struct variable is available");
    }
  );
});
test("validation: value receiver method calls use inferred function return type", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        escape(());
      }
    )
  );
  src := String.from("Withdraw :: struct(balance : i32); impl(Withdraw, withdraw : (fn(self : *(Self), amount : i32) -> i32)({ self.balance = (self.balance - amount); return(self.balance); })); make_bank :: (fn() -> Withdraw)({ return(Withdraw(100)); }); main :: (fn() -> unit)({ bank := make_bank(); left := bank.withdraw(50); assert(left == 50); }); export(main);");
  exprs := parse(src, String.from("<test>"), using(exn));
  opt_c := compile_module_to_c(exprs, "value_receiver_method_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("__auto_type bank = fn_make_bank();")), "function call binding is emitted");
      assert(c.contains(String.from("__auto_type left = fn_Withdraw_withdraw(&bank, 50);")), "value receiver method call passes receiver address");
      assert(!(c.contains(String.from("bank.withdraw"))), "method syntax must not reach C output");
    }
  );
});
test("validation: local tuple aliases and struct defaults lower to C aggregates", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        escape(());
      }
    )
  );
  src := String.from("main :: (fn() -> unit)({ { Point :: struct(x : i32, (y : i32) ?= 12); p4 :: Point(14); assert(p4.y == 12); }; { SomeStruct :: struct(x : i32, y : bool); Complex :: Tuple(s : SomeStruct); (c : Complex) = (_(3, true),); assert(c.0.x == 3); }; }); export(main);");
  exprs := parse(src, String.from("<test>"), using(exn));
  opt_c := compile_module_to_c(exprs, "local_tuple_defaults_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("__auto_type p4 = (Point){14, 12};")), "positional constructor fills default field");
      assert(c.contains(String.from("typedef struct { SomeStruct _0; SomeStruct s; } Complex;")), "local Tuple alias emits numeric and named fields");
      assert(c.contains(String.from("Complex c = {{3, 1}};")), "typed tuple alias assignment uses brace initializer");
      assert(c.contains(String.from("c._0.x == 3")), "numeric tuple field access maps to C field");
    }
  );
});
test("validation: generic single-field struct methods lower through concrete value type", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        escape(());
      }
    )
  );
  src := String.from("MyStruct :: (fn(comptime(T) : Type) -> comptime(Type))(struct(value : T)); impl(forall(T : Type), MyStruct(T), new : (fn(v : T) -> Self)(Self(v)), another_new : (fn(v : T) -> Self)(Self.new(v)), add : (fn(self : *(Self), value : T, where(T <: Add(T))) -> unit)({ self.value = (self.value + value); }), another_add : (fn(self : *(Self), value : T, where(T <: Add(T))) -> unit)({ self.add(value); })); main :: (fn() -> unit)({ value := 10; x := MyStruct(i32).new(value); y := MyStruct(i32).another_new(value); x.add(3); y.another_add(4); assert(x.value == 13); assert(y.value == 14); }); export(main);");
  exprs := parse(src, String.from("<test>"), using(exn));
  opt_c := compile_module_to_c(exprs, "generic_value_struct_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("typedef struct { int32_t value; } MyStruct_i32;")), "generic type application emits concrete value struct");
      assert(c.contains(String.from("__auto_type x = (MyStruct_i32){value};")), "generic new constructor emits concrete struct");
      assert(c.contains(String.from("(x.value = (x.value + 3));")), "generic value add mutates value field");
      assert(c.contains(String.from("(y.value = (y.value + 4));")), "delegated generic value add mutates value field");
      assert(!(c.contains(String.from(".new("))), "generic static method syntax must not reach C output");
      assert(!(c.contains(String.from(".add("))), "generic value method syntax must not reach C output");
    }
  );
});
// ---------------------------------------------------------------------------
// Phase 5b — handle_define, handle_type_cast, handle_assert, compile_test_body_to_c
// ---------------------------------------------------------------------------
// These tests verify the three new codegen features added for the test runner.
/// Build `FnCall(Atom(":="), [name_atom, rhs], true)` — define expression.
make_walrus_expr :: (fn(name : str, rhs : AstExpr) -> AstExpr)(
  make_infix_expr(":=", make_atom_expr(TokenKind.Identifier, name), rhs)
);
/// Build `FnCall(Atom("assert"), [cond, msg], false)` — assert call.
make_assert_expr :: (fn(cond_e : AstExpr, msg : str) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(make_atom_expr(TokenKind.StringLit, msg));
  make_fncall_expr("assert", a)
});
test("handle_define: x := 42 emits __auto_type x = 42;", {
  // Build `x := 42`
  rhs := make_atom_expr(TokenKind.Integer, "42");
  expr := make_walrus_expr("x", rhs);
  ctx := run_gen_with_ctx(expr);
  code := generate_c_output(&(ctx));
  assert(code.contains(String.from("__auto_type x = 42;")), "define emits __auto_type");
});
test("handle_define: returns unit sentinel 0 so no spurious value emitted", {
  // When used as statement in a begin block, define returns "0" (unit sentinel)
  rhs := make_atom_expr(TokenKind.Integer, "5");
  expr := make_walrus_expr("y", rhs);
  result := run_gen(expr);
  match(
    result,
    .None => assert(false, "expected Some"),
    .Some(v) => assert(v == String.from("0"), "unit sentinel 0")
  );
});
test("handle_type_cast: i32(99) emits (int32_t)(99)", {
  a := ArrayList(AstExpr).new();
  a.push(make_atom_expr(TokenKind.Integer, "99"));
  expr := make_fncall_expr("i32", a);
  result := run_gen(expr);
  match(
    result,
    .None => assert(false, "expected Some"),
    .Some(v) => assert(v.contains(String.from("(int32_t)(99)")), "cast emitted correctly")
  );
});
test("handle_type_cast: u8(x) emits (uint8_t)(x)", {
  a := ArrayList(AstExpr).new();
  a.push(make_atom_expr(TokenKind.Identifier, "x"));
  expr := make_fncall_expr("u8", a);
  result := run_gen(expr);
  match(
    result,
    .None => assert(false, "expected Some"),
    .Some(v) => assert(v.contains(String.from("(uint8_t)(x)")), "u8 cast emitted correctly")
  );
});
test("handle_type_cast: bool(x) emits (bool)(x)", {
  a := ArrayList(AstExpr).new();
  a.push(make_atom_expr(TokenKind.Identifier, "x"));
  expr := make_fncall_expr("bool", a);
  result := run_gen(expr);
  match(
    result,
    .None => assert(false, "expected Some"),
    .Some(v) => assert(v.contains(String.from("(bool)(x)")), "bool cast emitted correctly")
  );
});
test("handle_assert: assert(cond, msg) emits if (!cond) { exit(1); }", {
  cond_e := make_atom_expr(TokenKind.Identifier, "ok");
  expr := make_assert_expr(cond_e, "\"check\"");
  ctx := run_gen_with_ctx(expr);
  code := generate_c_output(&(ctx));
  assert(code.contains(String.from("if (!(ok))")), "if guard");
  assert(code.contains(String.from("exit(1)")), "exit(1) on failure");
});
test("compile_test_body_to_c: empty body compiles to valid C with main wrapper", {
  body := make_begin_expr(ArrayList(AstExpr).new());
  c := compile_test_body_to_c(body, "test_mod", ArrayList(AstExpr).new());
  assert(c.contains(String.from("fn_test_body")), "test body function");
  assert(c.contains(String.from("int main(void)")), "main wrapper");
  assert(c.contains(String.from("#include <stdio.h>")), "preamble");
});
test("compile_test_body_to_c: assert in body emits if guard", {
  cond_e := make_atom_expr(TokenKind.Identifier, "ok");
  assert_e := make_assert_expr(cond_e, "\"msg\"");
  stmts := ArrayList(AstExpr).new();
  stmts.push(assert_e);
  body := make_begin_expr(stmts);
  c := compile_test_body_to_c(body, "test_mod", ArrayList(AstExpr).new());
  assert(c.contains(String.from("if (!(ok))")), "assert guard present in test body C");
});
// ---------------------------------------------------------------------------
// Phase 4f+ — struct/impl support in compile_module_to_c
// ---------------------------------------------------------------------------
/// Build `FnCall(Atom("struct"), [field1, field2, ...], false)` — struct type literal.
make_struct_type_expr :: (fn(fields : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("struct", fields)
);
/// Build a `Name :: struct(fields...)` definition expression.
make_struct_def_expr :: (fn(name : str, fields : ArrayList(AstExpr)) -> AstExpr)(
  make_infix_expr("::", make_atom_expr(TokenKind.Identifier, name), make_struct_type_expr(fields))
);
/// Build an `impl(TypeName, begin_expr)` expression.
make_impl_expr :: (fn(type_name : str, body : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(make_atom_expr(TokenKind.Identifier, type_name));
  a.push(body);
  make_fncall_expr("impl", a)
});
test("extract_struct_def: simple struct with i32 field", {
  // Counter :: struct(value : i32)
  fields := ArrayList(AstExpr).new();
  fields.push(
    make_colon_expr(
      make_atom_expr(TokenKind.Identifier, "value"),
      make_atom_expr(TokenKind.Identifier, "i32")
    )
  );
  expr := make_struct_def_expr("Counter", fields);
  result := extract_struct_def(expr);
  match(
    result,
    .None => assert(false, "expected Some(StructDef)"),
    .Some(sd) => {
      assert(sd.name == String.from("Counter"), "struct name");
      assert(sd.field_names.len() == usize(1), "one field");
      match(
        sd.field_names.get(usize(0)),
        .None => assert(false, "field name missing"),
        .Some(n) => assert(n == String.from("value"), "field name is 'value'")
      );
      match(
        sd.field_tys.get(usize(0)),
        .None => assert(false, "field type missing"),
        .Some(t) => assert(t == String.from("int32_t"), "field type is int32_t")
      );
    }
  );
});
test("extract_struct_def: two fields i32 and bool", {
  fields := ArrayList(AstExpr).new();
  fields.push(
    make_colon_expr(
      make_atom_expr(TokenKind.Identifier, "x"),
      make_atom_expr(TokenKind.Identifier, "i32")
    )
  );
  fields.push(
    make_colon_expr(
      make_atom_expr(TokenKind.Identifier, "enabled"),
      make_atom_expr(TokenKind.Identifier, "bool")
    )
  );
  expr := make_struct_def_expr("Config", fields);
  result := extract_struct_def(expr);
  match(
    result,
    .None => assert(false, "expected Some"),
    .Some(sd) => {
      assert(sd.field_names.len() == usize(2), "two fields");
      match(
        sd.field_tys.get(usize(1)),
        .None => assert(false, "second field type missing"),
        .Some(t) => assert(t == String.from("bool"), "second field is bool")
      );
    }
  );
});
test("extract_struct_def: non-struct expr returns None", {
  // A regular function def should not be recognised as a struct.
  body := make_begin_expr(ArrayList(AstExpr).new());
  ret := make_atom_expr(TokenKind.Identifier, "unit");
  rhs := make_fn_app(ArrayList(AstExpr).new(), ret, body);
  expr := make_define_expr("main", rhs);
  result := extract_struct_def(expr);
  match(
    result,
    .None => (),
    // expected
    .Some(_) => assert(false, "function def should not be a struct")
  );
});
test("emit_struct_to_c: single field emits typedef struct", {
  fields := ArrayList(AstExpr).new();
  fields.push(
    make_colon_expr(
      make_atom_expr(TokenKind.Identifier, "value"),
      make_atom_expr(TokenKind.Identifier, "i32")
    )
  );
  expr := make_struct_def_expr("Counter", fields);
  match(
    extract_struct_def(expr),
    .None => assert(false, "extract failed"),
    .Some(sd) => {
      ctx := CodegenContext.new();
      (pctx : *(CodegenContext)) = &(ctx);
      emit_struct_to_c(sd, pctx);
      c := generate_c_output(&(ctx));
      assert(c.contains(String.from("typedef struct")), "typedef struct keyword");
      assert(c.contains(String.from("int32_t value")), "field emitted");
      assert(c.contains(String.from("} Counter;")), "struct name in typedef");
    }
  );
});
test("compile_module_to_c: struct definition emits typedef before functions", {
  // Point :: struct(x : i32, y : i32);  add_pt :: (fn(p : Point) -> i32)(p.x);  main :: ...
  fields := ArrayList(AstExpr).new();
  fields.push(make_colon_expr(make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "i32")));
  fields.push(make_colon_expr(make_atom_expr(TokenKind.Identifier, "y"), make_atom_expr(TokenKind.Identifier, "i32")));
  struct_expr := make_struct_def_expr("Point", fields);
  body := make_begin_expr(ArrayList(AstExpr).new());
  ret := make_atom_expr(TokenKind.Identifier, "unit");
  rhs := make_fn_app(ArrayList(AstExpr).new(), ret, body);
  main_expr := make_define_expr("main", rhs);
  exprs := ArrayList(AstExpr).new();
  exprs.push(struct_expr);
  exprs.push(main_expr);
  opt_c := compile_module_to_c(exprs, "test_mod", "main");
  match(
    opt_c,
    .None => assert(false, "expected Some"),
    .Some(c) => {
      assert(c.contains(String.from("typedef struct")), "struct typedef present");
      assert(c.contains(String.from("} Point;")), "Point typedef name");
      assert(c.contains(String.from("int32_t x")), "field x in struct");
      assert(c.contains(String.from("int32_t y")), "field y in struct");
      assert(c.contains(String.from("static void fn_main")), "main function");
    }
  );
});
test("extract_impl_fns: extracts method as TypeName_method", {
  // impl(Counter, { get :: (fn(self : Counter) -> i32)(self.value); });
  self_param := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "self"),
    make_atom_expr(TokenKind.Identifier, "Counter")
  );
  params := ArrayList(AstExpr).new();
  params.push(self_param);
  body := make_atom_expr(TokenKind.Identifier, "0");
  ret := make_atom_expr(TokenKind.Identifier, "i32");
  rhs := make_fn_app(params, ret, body);
  method_expr := make_define_expr("get", rhs);
  stmts := ArrayList(AstExpr).new();
  stmts.push(method_expr);
  stmts.push(make_atom_expr(TokenKind.Identifier, "unit")); // trailing unit in begin
  impl_expr := make_impl_expr("Counter", make_begin_expr(stmts));
  fns := extract_impl_fns(impl_expr, "Counter");
  assert(fns.len() == usize(1), "one method extracted");
  match(
    fns.get(usize(0)),
    .None => assert(false, "method missing"),
    .Some(fd) => {
      assert(fd.name == String.from("Counter_get"), "method C name is Counter_get");
      assert(fd.ret_ty_c == String.from("int32_t"), "return(type is int32_t)");
      assert(fd.params.len() == usize(1), "one param");
    }
  );
});
test("extract_impl_fns: extracts multiple inline methods", {
  ret := make_atom_expr(TokenKind.Identifier, "i32");
  first_rhs := make_fn_app(ArrayList(AstExpr).new(), ret, make_atom_expr(TokenKind.Integer, "1"));
  second_rhs := make_fn_app(ArrayList(AstExpr).new(), ret, make_atom_expr(TokenKind.Integer, "2"));
  first_method := make_colon_expr(make_atom_expr(TokenKind.Identifier, "first"), first_rhs);
  second_method := make_colon_expr(make_atom_expr(TokenKind.Identifier, "second"), second_rhs);
  impl_args := ArrayList(AstExpr).new();
  impl_args.push(make_atom_expr(TokenKind.Identifier, "Counter"));
  impl_args.push(first_method);
  impl_args.push(second_method);
  impl_expr := make_fncall_expr("impl", impl_args);
  fns := extract_impl_fns(impl_expr, "Counter");
  assert(fns.len() == usize(2), "two inline impl methods extracted");
  match(
    fns.get(usize(1)),
    .None => assert(false, "second method missing"),
    .Some(fd) => {
      assert(fd.name == String.from("Counter_second"), "second method C name");
    }
  );
});
