  outer_call_args := ArrayList(AstExpr).new();
  outer_call_args.push(inner_call);
  outer_call := make_fncall_expr("double", outer_call_args);
  body2_args := ArrayList(AstExpr).new();
  body2_args.push(outer_call);
  fn_app2 := AstExpr.FnCall(usize(0), box(fn_type2), body2_args, false, fn_tok);
