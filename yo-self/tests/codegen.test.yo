  struct_call := make_fncall_expr("struct", struct_fields);
  vec_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "Vec2"), struct_call);
  exprs.push(vec_def);
  // derive(Vec2, Clone)
  derive_args := ArrayList(AstExpr).new();
  derive_args.push(make_atom_expr(TokenKind.Identifier, "Vec2"));
  derive_args.push(make_atom_expr(TokenKind.Identifier, "Clone"));
  derive_call := make_fncall_expr("derive", derive_args);
  exprs.push(derive_call);
  // main :: (fn() -> unit)(0)
  main_params := ArrayList(AstExpr).new();
  main_body := make_atom_expr(TokenKind.Integer, "0");
  main_fn_inner := make_fncall_expr("fn", main_params);
  main_ret := make_atom_expr(TokenKind.Identifier, "unit");
  main_fn_type := make_infix_expr("->", main_fn_inner, main_ret);
  main_fn_app_args := ArrayList(AstExpr).new();
  main_fn_app_args.push(main_body);
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  main_fn_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_fn_app_args, false, fn_tok);
  main_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_fn_app);
  exprs.push(main_def);
  result := compile_module_to_c(exprs, "test_mod", "main");
  match(
    result,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c_code) => {
      has_clone := c_code.contains(String.from("fn_Vec2_clone"));
      assert(has_clone, "derive(Clone) should emit fn_Vec2_clone");
    }
  );
});
// ---------------------------------------------------------------------------
// Lambda codegen tests — Phase 5p
// ---------------------------------------------------------------------------
/// Helper: make a single-param lambda AST: `(param) => body`
make_lambda_expr :: (fn(param : str, body : AstExpr) -> AstExpr)({
  arrow_tok := make_token_raw(TokenKind.Operator, "->");
  args := ArrayList(AstExpr).new();
  args.push(make_atom_expr(TokenKind.Identifier, param));
  args.push(body);
  AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), arrow_tok)), args, true, arrow_tok)
});
/// Helper: make a multi-param lambda AST: `(p1, p2) => body`
make_multi_lambda_expr :: (fn(params : ArrayList(str), body : AstExpr) -> AstExpr)({
  arrow_tok := make_token_raw(TokenKind.Operator, "->");
  tuple_args := ArrayList(AstExpr).new();
  (i : usize) = usize(0);
  while(runtime(i < params.len()), {
    match(
      params.get(i),
      .Some(p) => {
        tuple_args.push(make_atom_expr(TokenKind.Identifier, p));
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  tuple_tok := make_token_raw(TokenKind.Identifier, "tuple");
  tuple_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), tuple_tok)), tuple_args, false, tuple_tok);
  args := ArrayList(AstExpr).new();
  args.push(tuple_expr);
  args.push(body);
  AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), arrow_tok)), args, true, arrow_tok)
});
test("is_lambda_expr: single-param lambda detected", {
  // (x) => (x + 1)
  body := make_infix_expr("+", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Integer, "1"));
  lam := make_lambda_expr("x", body);
  assert(is_lambda_expr(lam), "single param lambda should be detected");
});
test("is_lambda_expr: multi-param lambda detected", {
  // (x, y) => (x + y)
  body := make_infix_expr("+", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "y"));
  params := ArrayList(str).new();
  params.push("x");
  params.push("y");
  lam := make_multi_lambda_expr(params, body);
  assert(is_lambda_expr(lam), "multi param lambda should be detected");
});
test("is_lambda_expr: plain atom is not lambda", {
  atom := make_atom_expr(TokenKind.Identifier, "foo");
  assert(!(is_lambda_expr(atom)), "atom should not be lambda");
});
test("is_lambda_expr: infix + is not lambda", {
  plus := make_infix_expr("+", make_atom_expr(TokenKind.Integer, "1"), make_atom_expr(TokenKind.Integer, "2"));
  assert(!(is_lambda_expr(plus)), "infix + should not be lambda");
});
test("extract_lambda_param_names: single param extracts name", {
  param_expr := make_atom_expr(TokenKind.Identifier, "x");
  names := extract_lambda_param_names(param_expr);
  assert(names.len() == usize(1), "should extract 1 param name");
  match(
    names.get(usize(0)),
    .Some(n) => assert(n.as_str() == "x", "param name should be x"),
    .None => assert(false, "no param at index 0")
  );
});
test("extract_lambda_param_names: multi param extracts all names", {
  tuple_args := ArrayList(AstExpr).new();
  tuple_args.push(make_atom_expr(TokenKind.Identifier, "a"));
  tuple_args.push(make_atom_expr(TokenKind.Identifier, "b"));
  tuple_args.push(make_atom_expr(TokenKind.Identifier, "c"));
  tuple_tok := make_token_raw(TokenKind.Identifier, "tuple");
  tuple_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), tuple_tok)), tuple_args, false, tuple_tok);
  names := extract_lambda_param_names(tuple_expr);
  assert(names.len() == usize(3), "should extract 3 param names");
  match(names.get(usize(0)),.Some(n) => assert(n.as_str() == "a", "first param a"),.None => assert(false, "no 0"));
  match(names.get(usize(1)),.Some(n) => assert(n.as_str() == "b", "second param b"),.None => assert(false, "no 1"));
  match(names.get(usize(2)),.Some(n) => assert(n.as_str() == "c", "third param c"),.None => assert(false, "no 2"));
});
test("lift_non_capturing_lambda: single param emits static function", {
  ctx := CodegenContext.new();
  // (x) => 42
  body := make_atom_expr(TokenKind.Integer, "42");
  lam := make_lambda_expr("x", body);
  // Function pointer type: int32_t(*_FP_)(int32_t)
  fp_ty := String.from("int32_t(*_FP_)(int32_t)");
  result := lift_non_capturing_lambda(&(ctx), lam, fp_ty);
  match(
    result,
    .None => assert(false, "lift should succeed"),
    .Some(fn_name) => {
      // The lambda name should start with "__lambda_"
      assert(fn_name.starts_with(String.from("__yo_lambda_")), "fn name should start with __yo_lambda_");
      // The emitter should have the static function declaration
      output := ctx.emitter.print();
      assert(output.contains(String.from("static int32_t")), "should have static int32_t return(type)");
      assert(output.contains(String.from("int32_t x")), "should have param declaration");
    }
  );
});
test("lift_non_capturing_lambda: multi param emits correct params", {
  ctx := CodegenContext.new();
  // (a, b) => 0
  body := make_atom_expr(TokenKind.Integer, "0");
  params := ArrayList(str).new();
  params.push("a");
  params.push("b");
  lam := make_multi_lambda_expr(params, body);
  // Function pointer type: int32_t(*_FP_)(int32_t, int32_t)
  fp_ty := String.from("int32_t(*_FP_)(int32_t, int32_t)");
  result := lift_non_capturing_lambda(&(ctx), lam, fp_ty);
  match(
    result,
    .None => assert(false, "lift multi-param should succeed"),
    .Some(fn_name) => {
      output := ctx.emitter.print();
      assert(output.contains(String.from("int32_t a")), "should have param a");
      assert(output.contains(String.from("int32_t b")), "should have param b");
    }
  );
});
// ---------------------------------------------------------------------------
// Integration test: compile a complete program through compile_module_to_c
// ---------------------------------------------------------------------------
test("compile_module_to_c: complete program with struct, fn, and main", {
  // Program:
  //   Point :: struct(x : i32, y : i32);
  //   add_points :: (fn(a : Point, b : Point) -> Point)(
  //     Point(x: (a.x + b.x), y: (a.y + b.y))
  //   );
  //   main :: (fn() -> i32)(0);
  //   export(main);
  exprs := ArrayList(AstExpr).new();
  // Point :: struct(x : i32, y : i32)
  struct_args := ArrayList(AstExpr).new();
  struct_args.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "i32")));
  struct_args.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "y"), make_atom_expr(TokenKind.Identifier, "i32")));
  struct_call := make_fncall_expr("struct", struct_args);
  point_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "Point"), struct_call);
  exprs.push(point_def);
  // add_points :: (fn(a : Point, b : Point) -> Point)(body)
  fn_params := ArrayList(AstExpr).new();
  fn_params.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "a"), make_atom_expr(TokenKind.Identifier, "Point")));
  fn_params.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "b"), make_atom_expr(TokenKind.Identifier, "Point")));
  fn_type_call := make_fncall_expr("fn", fn_params);
  fn_type := make_infix_expr("->", fn_type_call, make_atom_expr(TokenKind.Identifier, "Point"));
  fn_body_args := ArrayList(AstExpr).new();
  fn_body_args.push(make_atom_expr(TokenKind.Integer, "0")); // simplified body
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  fn_app := AstExpr.FnCall(usize(0), box(fn_type), fn_body_args, false, fn_tok);
  add_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "add_points"), fn_app);
  exprs.push(add_def);
  // main :: (fn() -> i32)(0)
  main_params := ArrayList(AstExpr).new();
  main_fn_type_call := make_fncall_expr("fn", main_params);
  main_fn_type := make_infix_expr("->", main_fn_type_call, make_atom_expr(TokenKind.Identifier, "i32"));
  main_body_args := ArrayList(AstExpr).new();
  main_body_args.push(make_atom_expr(TokenKind.Integer, "0"));
  main_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_body_args, false, fn_tok);
  main_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app);
  exprs.push(main_def);
  result := compile_module_to_c(exprs, "point_mod", "main");
  match(
    result,
    .None => assert(false, "full program should compile"),
    .Some(c_code) => {
      // Should contain the struct typedef
      assert(c_code.contains(String.from("typedef struct")), "should have typedef struct");
      assert(c_code.contains(String.from("Point")), "should have Point type");
      // Should contain the function
      assert(c_code.contains(String.from("add_points")), "should have add_points function");
      // Should contain int main()
      assert(c_code.contains(String.from("int main")), "should have main function");
      // Should contain the #include <stdint.h> from preamble
      assert(c_code.contains(String.from("#include")), "should have #include directives");
    }
  );
});
test("compile_module_to_c: program with enum and match emits switch", {
  // Program:
  //   Color :: enum(Red, Green, Blue);
  //   main :: (fn() -> i32)(0);
  //   export(main);
  exprs := ArrayList(AstExpr).new();
  // Color :: enum(Red, Green, Blue)
  enum_args := ArrayList(AstExpr).new();
  enum_args.push(make_atom_expr(TokenKind.Identifier, "Red"));
  enum_args.push(make_atom_expr(TokenKind.Identifier, "Green"));
  enum_args.push(make_atom_expr(TokenKind.Identifier, "Blue"));
  enum_call := make_fncall_expr("enum", enum_args);
  color_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "Color"), enum_call);
  exprs.push(color_def);
  // main :: (fn() -> i32)(0)
  main_params := ArrayList(AstExpr).new();
  main_fn_type_call := make_fncall_expr("fn", main_params);
  main_fn_type := make_infix_expr("->", main_fn_type_call, make_atom_expr(TokenKind.Identifier, "i32"));
  main_body_args := ArrayList(AstExpr).new();
  main_body_args.push(make_atom_expr(TokenKind.Integer, "0"));
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  main_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_body_args, false, fn_tok);
  main_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app);
  exprs.push(main_def);
  result := compile_module_to_c(exprs, "color_mod", "main");
  match(
    result,
    .None => assert(false, "enum program should compile"),
    .Some(c_code) => {
      // Should contain the enum type
      assert(c_code.contains(String.from("Color")), "should have Color enum");
      // Should contain enum variants as defines or enum values
      assert(c_code.contains(String.from("Color_Red")), "should have Color_Red variant");
      assert(c_code.contains(String.from("Color_Green")), "should have Color_Green variant");
      assert(c_code.contains(String.from("Color_Blue")), "should have Color_Blue variant");
      // Should contain int main()
      assert(c_code.contains(String.from("int main")), "should have main");
    }
  );
});
test("compile_module_to_c: program with impl method emits TypeName_method", {
  // Program:
  //   Counter :: struct(count : i32);
  //   impl(Counter, inc : (fn(self : *(Self)) -> unit)(...));
  //   main :: (fn() -> i32)(0);
  //   export(main);
  exprs := ArrayList(AstExpr).new();
  // Counter :: struct(count : i32)
  struct_args := ArrayList(AstExpr).new();
  struct_args.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "count"), make_atom_expr(TokenKind.Identifier, "i32")));
  struct_call := make_fncall_expr("struct", struct_args);
  counter_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "Counter"), struct_call);
  exprs.push(counter_def);
  // impl(Counter, inc : (fn(self : *(Self)) -> unit)(0))
  impl_args := ArrayList(AstExpr).new();
  impl_args.push(make_atom_expr(TokenKind.Identifier, "Counter"));
  // inc : fn_def
  fn_params_i := ArrayList(AstExpr).new();
  fn_params_i.push(
    make_infix_expr(
      ":",
      make_atom_expr(TokenKind.Identifier, "self"),
      make_fncall_expr("*", {
        pa := ArrayList(AstExpr).new();
        pa.push(make_atom_expr(TokenKind.Identifier, "Self"));
        pa
      })
    )
  );
  fn_type_call_i := make_fncall_expr("fn", fn_params_i);
  fn_type_i := make_infix_expr("->", fn_type_call_i, make_atom_expr(TokenKind.Identifier, "unit"));
  fn_body_args_i := ArrayList(AstExpr).new();
  fn_body_args_i.push(make_atom_expr(TokenKind.Integer, "0"));
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  fn_app_i := AstExpr.FnCall(usize(0), box(fn_type_i), fn_body_args_i, false, fn_tok);
  meth_def := make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "inc"), fn_app_i);
  impl_args.push(meth_def);
  impl_call := make_fncall_expr("impl", impl_args);
  exprs.push(impl_call);
  // main :: (fn() -> i32)(0)
  main_params := ArrayList(AstExpr).new();
  main_fn_type_call := make_fncall_expr("fn", main_params);
  main_fn_type := make_infix_expr("->", main_fn_type_call, make_atom_expr(TokenKind.Identifier, "i32"));
  main_body_args := ArrayList(AstExpr).new();
  main_body_args.push(make_atom_expr(TokenKind.Integer, "0"));
  main_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_body_args, false, fn_tok);
  main_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app);
  exprs.push(main_def);
  result := compile_module_to_c(exprs, "counter_mod", "main");
  match(
    result,
    .None => assert(false, "impl program should compile"),
    .Some(c_code) => {
      // Should contain the struct typedef
      assert(c_code.contains(String.from("Counter")), "should have Counter type");
      // Should contain the impl method as Counter_inc
      assert(c_code.contains(String.from("Counter_inc")), "should have Counter_inc method");
      // Should contain int main()
      assert(c_code.contains(String.from("int main")), "should have main");
    }
  );
});
