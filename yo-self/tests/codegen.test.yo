// ---------------------------------------------------------------------------
// Phase 5h — template string codegen
// ---------------------------------------------------------------------------
/// Build `obj.to_string()` — the pattern emitted by parse_template_string
/// for each template-string part.
make_to_string_call :: (fn(obj : AstExpr) -> AstExpr)(
  make_method_call_expr(obj, "to_string", ArrayList(AstExpr).new())
);
/// Build `lhs.+(rhs)` — the chain emitted by parse_template_string to
/// concatenate template-string parts.  Uses TokenKind.Operator for the
/// method name atom, matching what the parser actually produces.
make_ts_concat :: (fn(lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  dot_tok := make_token_raw(TokenKind.Dot, ".");
  plus_tok := make_token_raw(TokenKind.Operator, "+");
  dot_args := ArrayList(AstExpr).new();
  _p1 := dot_args.push(lhs);
  _p2 := dot_args.push(AstExpr.Atom(usize(0), plus_tok));
  dot_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  _p3 := call_args.push(rhs);
  AstExpr.FnCall(usize(0), box(dot_expr), call_args, false, dot_tok)
});
test("template string: to_string() on string literal strips the call", {
  // `"hello "`.to_string() → `"hello "`
  lit_expr := make_atom_expr(TokenKind.StringLit, "\"hello \"");
  ts_expr := make_to_string_call(lit_expr);
  result_opt := run_gen(ts_expr);
  match(
    result_opt,
    .None => assert(false, "generate_expr returned None"),
    .Some(result) => assert(result.as_str() == "\"hello \"", "string literal passed through")
  );
});
test("template string: to_string() on identifier strips the call", {
  // `name`.to_string() → `name`
  id_expr := make_atom_expr(TokenKind.Identifier, "name");
  ts_expr := make_to_string_call(id_expr);
  result_opt := run_gen(ts_expr);
  match(
    result_opt,
    .None => assert(false, "generate_expr returned None"),
    .Some(result) => assert(result.as_str() == "name", "identifier passed through")
  );
});
test("template string: .+(b) emits __yo_str_concat(a, b)", {
  // `"fn_".to_string().+(name.to_string())` — i.e. `fn_${name}`
  lhs := make_to_string_call(make_atom_expr(TokenKind.StringLit, "\"fn_\""));
  rhs := make_to_string_call(make_atom_expr(TokenKind.Identifier, "name"));
  concat_expr := make_ts_concat(lhs, rhs);
  result_opt := run_gen(concat_expr);
  match(
    result_opt,
    .None => assert(false, "generate_expr returned None"),
    .Some(result) => {
      assert(result.contains(String.from("__yo_str_concat")), "__yo_str_concat present");
      assert(result.contains(String.from("\"fn_\"")), "literal part present");
      assert(result.contains(String.from("name")), "identifier part present");
    }
  );
});
test("template string: three-part chain emits nested __yo_str_concat", {
  // `fn_${name}!` → __yo_str_concat(__yo_str_concat("fn_", name), "!")
  lhs1 := make_to_string_call(make_atom_expr(TokenKind.StringLit, "\"fn_\""));
  mid := make_to_string_call(make_atom_expr(TokenKind.Identifier, "name"));
  rhs1 := make_to_string_call(make_atom_expr(TokenKind.StringLit, "\"!\""));
  inner := make_ts_concat(lhs1, mid);
  outer := make_ts_concat(inner, rhs1);
  result_opt := run_gen(outer);
  match(
    result_opt,
    .None => assert(false, "generate_expr returned None"),
    .Some(result) => {
      count := usize(0);
      if(result.contains(String.from("__yo_str_concat")), {
        count = (count + usize(1));
      });
      // The outer __yo_str_concat wraps an inner one — check both parts present
      assert(result.contains(String.from("\"fn_\"")), "prefix literal present");
      assert(result.contains(String.from("name")), "interpolation present");
      assert(result.contains(String.from("\"!\"")), "suffix literal present");
    }
  );
});
test("emit_c_preamble: __yo_str_concat helper is present", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  emit_c_preamble("test_mod", pctx);
  output := generate_c_output(pctx);
  assert(output.contains(String.from("__yo_str_concat")), "__yo_str_concat in preamble");
  assert(output.contains(String.from("memcpy")), "memcpy in concat helper");
});
// Phase 5i: if-with-block-branch emits C if statement, not ternary ----------
/// Build a begin block containing a single expression (like `{ break; }`).
make_single_stmt_begin :: (fn(expr : AstExpr) -> AstExpr)({
  stmts := ArrayList(AstExpr).new();
  stmts.push(expr);
  make_begin_expr(stmts)
});
test("handle_if: block then-branch emits C if statement (not ternary)", {
  // if((x > 0), { break; })  →  should contain "if (" and "break", NOT "? break"
  cond_e := make_infix_expr(
    ">",
    make_atom_expr(TokenKind.Identifier, "x"),
    make_atom_expr(TokenKind.Integer, "0")
  );
  then_e := make_single_stmt_begin(make_atom_expr(TokenKind.Identifier, "break"));
  if_e := make_if_expr(cond_e, then_e);
  ctx := run_gen_with_ctx(if_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("if (")), "C if statement emitted");
  assert(code.contains(String.from("break")), "break present in output");
  assert(!(code.contains(String.from("? break"))), "no ternary with break");
});
test("handle_if: simple expression still emits ternary", {
  // if((x > 0), y)  →  should emit (... ? y : 0)
  cond_e := make_infix_expr(
    ">",
    make_atom_expr(TokenKind.Identifier, "x"),
    make_atom_expr(TokenKind.Integer, "0")
  );
  then_e := make_atom_expr(TokenKind.Identifier, "y");
  if_e := make_if_expr(cond_e, then_e);
  result_opt := run_gen(if_e);
  match(
    result_opt,
    .None => assert(false, "generate_expr returned None"),
    .Some(result) => {
      assert(result.contains(String.from("?")), "ternary operator present");
      assert(result.contains(String.from("y")), "then-value y present");
    }
  );
});
test("handle_if: block else-branch emits C if/else statement", {
  // if(flag, x, { break; })  →  should contain "if (" and "else" and "break"
  cond_e := make_atom_expr(TokenKind.Identifier, "flag");
  then_e := make_atom_expr(TokenKind.Identifier, "x");
  else_e := make_single_stmt_begin(make_atom_expr(TokenKind.Identifier, "break"));
  if_e := make_if_else_expr(cond_e, then_e, else_e);
  ctx := run_gen_with_ctx(if_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("if (")), "C if statement emitted");
  assert(code.contains(String.from("else")), "else branch emitted");
  assert(code.contains(String.from("break")), "break in else branch");
});
test("handle_begin: sibling begin blocks are wrapped in C braces for variable scoping", {
  // { { x := 1; }; { x := 2; }; 3 }
  // The two inner begin blocks both define `x`. Without C brace wrapping they
  // emit two `__auto_type x = ...;` at the same scope → redefinition error.
  // With the fix, each sibling block is wrapped in `{ ... }`.
  inner_stmts1 := ArrayList(AstExpr).new();
  inner_stmts1.push(
    make_assign_expr(
      make_atom_expr(TokenKind.Identifier, "x"),
      make_atom_expr(TokenKind.Integer, "1")
    )
  );
  block1 := make_begin_expr(inner_stmts1);
  inner_stmts2 := ArrayList(AstExpr).new();
  inner_stmts2.push(
    make_assign_expr(
      make_atom_expr(TokenKind.Identifier, "x"),
      make_atom_expr(TokenKind.Integer, "2")
    )
  );
  block2 := make_begin_expr(inner_stmts2);
  outer_stmts := ArrayList(AstExpr).new();
  outer_stmts.push(block1);
  outer_stmts.push(block2);
  outer_stmts.push(make_atom_expr(TokenKind.Integer, "3"));
  outer := make_begin_expr(outer_stmts);
  ctx := run_gen_with_ctx(outer);
  code := ctx.emitter.code;
  // Both inner blocks must be wrapped in C braces
  assert(code.contains(String.from("{")), "opening brace emitted");
  assert(code.contains(String.from("}")), "closing brace emitted");
});
// Phase 5j: while loop codegen tests ----------------------------------------
test("handle_while: 2-arg while(cond, body) emits C while loop", {
  // while(flag, { break; })  →  while (flag) { ... break ... }
  cond_e := make_atom_expr(TokenKind.Identifier, "flag");
  body_e := make_single_stmt_begin(make_atom_expr(TokenKind.Identifier, "break"));
  w_e := make_while_expr(cond_e, body_e);
  ctx := run_gen_with_ctx(w_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("while (")), "C while emitted");
  assert(code.contains(String.from("flag")), "condition present");
  assert(code.contains(String.from("break")), "break in body");
});
test("handle_while: runtime(cond) wrapper is stripped from condition", {
  // while(runtime(i < n), { x; })  →  while (i < n) { ... }
  cond_inner := make_infix_expr(
    "<",
    make_atom_expr(TokenKind.Identifier, "i"),
    make_atom_expr(TokenKind.Identifier, "n")
  );
  cond_e := make_runtime_cond(cond_inner);
  body_e := make_single_stmt_begin(make_atom_expr(TokenKind.Identifier, "x"));
  w_e := make_while_expr(cond_e, body_e);
  ctx := run_gen_with_ctx(w_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("while (")), "C while emitted");
  assert(code.contains(String.from("i")), "i in condition");
  assert(code.contains(String.from("n")), "n in condition");
  assert(!(code.contains(String.from("runtime"))), "runtime wrapper stripped");
});
test("handle_while: 3-arg while(cond, step, body) emits C for loop", {
  // while(cond, i = i + 1, body)  →  for (;cond;...) { body }
  cond_e := make_atom_expr(TokenKind.Identifier, "cond");
  step_e := make_assign_expr(
    make_atom_expr(TokenKind.Identifier, "i"),
    make_infix_expr(
      "+",
      make_atom_expr(TokenKind.Identifier, "i"),
      make_atom_expr(TokenKind.Integer, "1")
    )
  );
  body_e := make_single_stmt_begin(make_atom_expr(TokenKind.Identifier, "x"));
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(step_e);
  a.push(body_e);
  w_e := make_fncall_expr("while", a);
  ctx := run_gen_with_ctx(w_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("for (;")), "C for loop emitted");
  assert(code.contains(String.from("cond")), "condition present");
});
// Phase 5k: for-loop codegen tests -------------------------------------------
test("handle_for: for(iter, elem => body) emits fallback while(1) loop", {
  // for(my_iter, elem => { break; })
  // → __auto_type _yo_tN = my_iter;
  //   while (1) { __auto_type _yo_tM = _yo_tN.next(); if (!_yo_tM) break; __auto_type elem = _yo_tM; break; }
  iter_e := make_atom_expr(TokenKind.Identifier, "my_iter");
  param_e := make_atom_expr(TokenKind.Identifier, "elem");
  body_e := make_single_stmt_begin(make_atom_expr(TokenKind.Identifier, "break"));
  handler_e := make_cond_arm(param_e, body_e);
  a := ArrayList(AstExpr).new();
  a.push(iter_e);
  a.push(handler_e);
  for_e := make_fncall_expr("for", a);
  ctx := run_gen_with_ctx(for_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("while (1)")), "fallback while(1) emitted");
  assert(code.contains(String.from("my_iter")), "iterator present");
  assert(code.contains(String.from("elem")), "param name present");
  assert(code.contains(String.from(".next()")), "next() call present");
  assert(code.contains(String.from("break")), "break in body");
});
test("handle_for: wrong arity (1 arg) returns None", {
  // for(iter_only) — missing handler → None
  iter_e := make_atom_expr(TokenKind.Identifier, "my_iter");
  a := ArrayList(AstExpr).new();
  a.push(iter_e);
  for_e := make_fncall_expr("for", a);
  result_opt := run_gen(for_e);
  match(
    result_opt,
    .None => (),
    .Some(_) => assert(false, "expected None for wrong-arity for")
  );
});
// Phase 5l: escape-as-return codegen tests, plus standalone break/continue ----
test("generate_expr: escape() with no args emits bare return", {
  // escape() — no arguments → should emit `return;`
  a := ArrayList(AstExpr).new();
  esc_e := make_fncall_expr("escape", a);
  ctx := run_gen_with_ctx(esc_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("return;")), "bare return(emitted for escape())");
});
test("generate_expr: escape(unit)(emits return(statement))", {
  // escape(()) — unit argument maps to "0" in the proto-codegen, so escape(())
  // emits `return 0;` (same as return(()) — unit return value maps to 0).
  unit_args := ArrayList(AstExpr).new();
  unit_e := make_fncall_expr("tuple", unit_args);
  a := ArrayList(AstExpr).new();
  a.push(unit_e);
  esc_e := make_fncall_expr("escape", a);
  ctx := run_gen_with_ctx(esc_e);
  code := ctx.emitter.code;
  // Unit return: `return 0;` is emitted (proto-codegen maps unit to 0)
  assert(code.contains(String.from("return 0;")), "return 0 emitted for escape(())");
});
test("generate_expr: escape(expr)(emits return(with value))", {
  // escape(42) -> should emit `return 42;`
  a := ArrayList(AstExpr).new();
  a.push(make_atom_expr(TokenKind.Integer, "42"));
  esc_e := make_fncall_expr("escape", a);
  ctx := run_gen_with_ctx(esc_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("return 42;")), "return with value emitted for escape(42)");
});
test("generate_expr: escape(ident)(emits return(with identifier))", {
  // escape(result) -> should emit `return result;`
  a := ArrayList(AstExpr).new();
  a.push(make_atom_expr(TokenKind.Identifier, "result"));
  esc_e := make_fncall_expr("escape", a);
  ctx := run_gen_with_ctx(esc_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("return result;")), "return with ident emitted for escape(result)");
});
test("generate_expr: break atom is emitted as identifier", {
  // Standalone `break` atom → generate_expr returns "break" as the expression code.
  // When this appears as the last statement in a begin block, the caller emits it.
  break_e := make_atom_expr(TokenKind.Identifier, "break");
  result_opt := run_gen(break_e);
  match(
    result_opt,
    .None => assert(false, "expected Some for break atom"),
    .Some(s) => assert(s == String.from("break"), "break atom generates 'break' string")
  );
});
test("generate_expr: continue atom is emitted as identifier", {
  // Standalone `continue` atom → generate_expr returns "continue" as expression code.
  continue_e := make_atom_expr(TokenKind.Identifier, "continue");
  result_opt := run_gen(continue_e);
  match(
    result_opt,
    .None => assert(false, "expected Some for continue atom"),
    .Some(s) => assert(s == String.from("continue"), "continue atom generates 'continue' string")
  );
});
test("handle_while: break inside body emits break statement in C code", {
  // while runtime(true), { break; } → emits `while((1)({))` and `break;`
  cond_e := make_runtime_cond(make_atom_expr(TokenKind.Bool, "true"));
  body_e := make_single_stmt_begin(make_atom_expr(TokenKind.Identifier, "break"));
  while_e := make_while_expr(cond_e, body_e);
  ctx := run_gen_with_ctx(while_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("while")), "while keyword present");
  assert(code.contains(String.from("break")), "break present in while body");
});
// =============================================================================
// Phase 5n: using(name) unwrapping and given(name) := expr codegen
// =============================================================================
test("Phase 5n: using(name) in arg list passes inner name", {
  // f(x, using(ctx)) → gen_arg_list should emit "x, ctx"
  args := ArrayList(AstExpr).new();
  args.push(make_atom_expr(TokenKind.Integer, "42"));
  // Build using(ctx)
  using_args := ArrayList(AstExpr).new();
  using_args.push(make_atom_expr(TokenKind.Identifier, "ctx"));
  using_call := make_fncall_expr("using", using_args);
  args.push(using_call);
  call_e := make_fncall_expr("my_func", args);
  result := run_gen(call_e);
  match(
    result,
    .None => assert(false, "gen returned None for call with using"),
    .Some(s) => {
      assert(s.contains(String.from("my_func")), "call name present");
      assert(s.contains(String.from("ctx")), "using(ctx) unwrapped to ctx");
      assert(s.contains(String.from("42")), "regular arg present");
    }
  );
});
test("Phase 5n: using(name) as standalone expression returns the identifier", {
  // using(exn) standalone → just emits the inner name "exn"
  using_args := ArrayList(AstExpr).new();
  using_args.push(make_atom_expr(TokenKind.Identifier, "exn"));
  using_call := make_fncall_expr("using", using_args);
  result := run_gen(using_call);
  match(
    result,
    .None => assert(false, "using(exn) returned None"),
    .Some(s) => assert(s == String.from("exn"), "using(exn) emits 'exn'")
  );
});
test("Phase 5n: given(name) as standalone expression returns 0", {
  // given(ctx) standalone → no-op, returns "0"
  given_args := ArrayList(AstExpr).new();
  given_args.push(make_atom_expr(TokenKind.Identifier, "ctx"));
  given_call := make_fncall_expr("given", given_args);
  result := run_gen(given_call);
  match(
    result,
    .None => assert(false, "given(ctx) returned None"),
    .Some(s) => assert(s == String.from("0"), "given(ctx) standalone is no-op '0'")
  );
});
test("Phase 5n: given(name) := rhs emits __auto_type define", {
  // given(handler) := 42  →  __auto_type handler = 42;
  given_args := ArrayList(AstExpr).new();
  given_args.push(make_atom_expr(TokenKind.Identifier, "handler"));
  given_call := make_fncall_expr("given", given_args);
  rhs := make_atom_expr(TokenKind.Integer, "42");
  define_e := make_infix_expr(":=", given_call, rhs);
  ctx := run_gen_with_ctx(define_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("__auto_type")), "auto type declare present");
  assert(code.contains(String.from("handler")), "name is handler");
  assert(code.contains(String.from("42")), "rhs value 42 present");
});
test("Phase 5n: extract_struct_def recognizes object keyword", {
  // Emitter :: object(code : String) → treated same as struct
  fields := ArrayList(AstExpr).new();
  fields.push(
    make_colon_expr(
      make_atom_expr(TokenKind.Identifier, "code"),
      make_atom_expr(TokenKind.Identifier, "String")
    )
  );
  object_type := make_fncall_expr("object", fields);
  expr := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "Emitter"), object_type);
  result := extract_struct_def(expr);
  match(
    result,
    .None => assert(false, "expected Some(StructDef) for object"),
    .Some(sd) => {
      assert(sd.name == String.from("Emitter"), "name is Emitter");
      assert(sd.field_names.len() == usize(1), "one field");
      match(
        sd.field_names.get(usize(0)),
        .None => assert(false, "field name missing"),
        .Some(n) => assert(n == String.from("code"), "field name is 'code'")
      );
    }
  );
});
test("Phase 5n: extract_newtype_def recognizes newtype(u8)", {
  // TokenKind :: newtype(u8) → should extract name="TokenKind", inner="uint8_t"
  nt_args := ArrayList(AstExpr).new();
  nt_args.push(make_atom_expr(TokenKind.Identifier, "u8"));
  newtype_call := make_fncall_expr("newtype", nt_args);
  expr := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "TokenKind"), newtype_call);
  result := extract_newtype_def(expr);
  match(
    result,
    .None => assert(false, "expected Some for newtype(u8)"),
    .Some(pair) => {
      match(
        pair.get(usize(0)),
        .None => assert(false, "name missing"),
        .Some(name_s) => assert(name_s == String.from("TokenKind"), "name is TokenKind")
      );
      match(
        pair.get(usize(1)),
        .None => assert(false, "inner type missing"),
        .Some(ty_s) => assert(ty_s == String.from("uint8_t"), "inner type is uint8_t")
      );
    }
  );
});
test("Phase 5o: extract_enum_def recognizes union keyword", {
  // Value :: union(IntVal(n: i32), BoolVal(b: bool))
  // Build: IntVal(n: i32)
  int_fields := ArrayList(AstExpr).new();
  int_fields.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "n"), make_atom_expr(TokenKind.Identifier, "i32")));
  int_variant := make_fncall_expr("IntVal", int_fields);
  // Build: BoolVal(b: bool)
  bool_fields := ArrayList(AstExpr).new();
  bool_fields.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "b"), make_atom_expr(TokenKind.Identifier, "bool")));
  bool_variant := make_fncall_expr("BoolVal", bool_fields);
  // Build: union(IntVal(...), BoolVal(...))
  union_args := ArrayList(AstExpr).new();
  union_args.push(int_variant);
  union_args.push(bool_variant);
  union_call := make_fncall_expr("union", union_args);
  expr := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "Value"), union_call);
  result := extract_enum_def(expr);
  match(
    result,
    .None => assert(false, "expected Some(EnumDef) for union keyword"),
    .Some(ed) => {
      assert(ed.name == String.from("Value"), "name is Value");
      assert(ed.variants.len() == usize(2), "two variants");
      assert(ed.is_complex, "union with fields is complex");
      match(
        ed.variants.get(usize(0)),
        .None => assert(false, "variant 0 missing"),
        .Some(v0) => {
          assert(v0.name == String.from("IntVal"), "variant 0 is IntVal");
          assert(v0.fields.len() == usize(1), "IntVal has 1 field");
        }
      );
      match(
        ed.variants.get(usize(1)),
        .None => assert(false, "variant 1 missing"),
        .Some(v1) => {
          assert(v1.name == String.from("BoolVal"), "variant 1 is BoolVal");
          assert(v1.fields.len() == usize(1), "BoolVal has 1 field");
        }
      );
    }
  );
});
test("Phase 5o: extract_const_def recognizes string constant", {
  // BK_TUPLE :: "tuple"
  expr := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "BK_TUPLE"), make_atom_expr(TokenKind.StringLit, "\"tuple\""));
  result := extract_const_def(expr);
  match(
    result,
    .None => assert(false, "expected Some(ConstDef) for string constant"),
    .Some(cd) => {
      assert(cd.name == String.from("BK_TUPLE"), "name is BK_TUPLE");
      assert(cd.value == String.from("\"tuple\""), "value is quoted");
      assert(cd.kind == String.from("str"), "kind is str");
    }
  );
});
test("Phase 5o: extract_const_def recognizes integer constant", {
  // MAX_SIZE :: 1024
  expr := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "MAX_SIZE"), make_atom_expr(TokenKind.Integer, "1024"));
  result := extract_const_def(expr);
  match(
    result,
    .None => assert(false, "expected Some(ConstDef) for int constant"),
    .Some(cd) => {
      assert(cd.name == String.from("MAX_SIZE"), "name is MAX_SIZE");
      assert(cd.value == String.from("1024"), "value is 1024");
      assert(cd.kind == String.from("int"), "kind is int");
    }
  );
});
test("Phase 5o: extract_const_def recognizes bool constant", {
  // DEBUG :: true
  expr := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "DEBUG"), make_atom_expr(TokenKind.Identifier, "true"));
  result := extract_const_def(expr);
  match(
    result,
    .None => assert(false, "expected Some(ConstDef) for bool constant"),
    .Some(cd) => {
      assert(cd.name == String.from("DEBUG"), "name is DEBUG");
      assert(cd.value == String.from("1"), "value is 1");
      assert(cd.kind == String.from("bool"), "kind is bool");
    }
  );
});
test("Phase 5o: extract_const_def returns None for function def", {
  // foo :: (fn() -> unit)(...) → should NOT be a const
  fn_args := ArrayList(AstExpr).new();
  fn_body := make_fncall_expr("fn", fn_args);
  expr := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "foo"), fn_body);
  result := extract_const_def(expr);
  match(
    result,
    .None => (),
    .Some(_) => assert(false, "should not match function def as constant")
  );
});
test("Phase 5o: emit_const_to_c emits string constant", {
  ctx := CodegenContext.new();
  cd := ConstDef(name : String.from("MY_STR"), value : String.from("\"hello\""), kind : String.from("str"));
  emit_const_to_c(cd, &(ctx));
  output := ctx.emitter.print();
  assert(output.contains(String.from("static const char* MY_STR")), "has static const char*");
  assert(output.contains(String.from("\"hello\"")), "has value");
});
test("Phase 5o: emit_const_to_c emits int constant as define", {
  ctx := CodegenContext.new();
  cd := ConstDef(name : String.from("MAX_SIZE"), value : String.from("1024"), kind : String.from("int"));
  emit_const_to_c(cd, &(ctx));
  output := ctx.emitter.print();
  assert(output.contains(String.from("#define MAX_SIZE 1024")), "has #define");
});
test("Phase 5o: compile_module_to_c emits constants", {
  exprs := ArrayList(AstExpr).new();
  // Add a constant: MAGIC :: 42
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "MAGIC"), make_atom_expr(TokenKind.Integer, "42")));
  // Add a main fn using existing helpers
  body := make_begin_expr(ArrayList(AstExpr).new());
  ret := make_atom_expr(TokenKind.Identifier, "unit");
  rhs := make_fn_app(ArrayList(AstExpr).new(), ret, body);
  exprs.push(make_define_expr("main", rhs));
  result := compile_module_to_c(exprs, "test_const", "main");
  match(
    result,
    .None => assert(false, "expected C output"),
    .Some(output) => {
      assert(output.contains(String.from("#define MAGIC 42")), "output has MAGIC constant");
    }
  );
});
test("Phase 5o: extract_const_def recognizes float constant", {
  // PI :: 3.14159
  expr := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "PI"), make_atom_expr(TokenKind.Float, "3.14159"));
  result := extract_const_def(expr);
  match(
    result,
    .None => assert(false, "expected Some(ConstDef) for float constant"),
    .Some(cd) => {
      assert(cd.name == String.from("PI"), "name is PI");
      assert(cd.value == String.from("3.14159"), "value is 3.14159");
      assert(cd.kind == String.from("float"), "kind is float");
    }
  );
});
test("Phase 5o: emit_const_to_c emits float as static const double", {
  ctx := CodegenContext.new();
  cd := ConstDef(name : String.from("PI"), value : String.from("3.14159"), kind : String.from("float"));
  emit_const_to_c(cd, &(ctx));
  output := ctx.emitter.print();
  assert(output.contains(String.from("static const double PI")), "has static const double");
  assert(output.contains(String.from("3.14159")), "has value");
});
test("Phase 5o: compile_module_to_c with impl emits method", {
  exprs := ArrayList(AstExpr).new();
  // Define a struct: Counter :: struct(n: i32)
  fields := ArrayList(AstExpr).new();
  fields.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "n"), make_atom_expr(TokenKind.Identifier, "i32")));
  struct_call := make_fncall_expr("struct", fields);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "Counter"), struct_call));
  // impl(Counter, { inc :: (fn() -> unit)({ }); })
  impl_body_stmts := ArrayList(AstExpr).new();
  inc_rhs := make_fn_app(ArrayList(AstExpr).new(), make_atom_expr(TokenKind.Identifier, "unit"), make_begin_expr(ArrayList(AstExpr).new()));
  impl_body_stmts.push(make_define_expr("inc", inc_rhs));
  impl_body := make_begin_expr(impl_body_stmts);
  impl_args := ArrayList(AstExpr).new();
  impl_args.push(make_atom_expr(TokenKind.Identifier, "Counter"));
  impl_args.push(impl_body);
  exprs.push(make_fncall_expr("impl", impl_args));
  // main fn
  main_body := make_begin_expr(ArrayList(AstExpr).new());
  main_ret := make_atom_expr(TokenKind.Identifier, "unit");
  main_rhs := make_fn_app(ArrayList(AstExpr).new(), main_ret, main_body);
  exprs.push(make_define_expr("main", main_rhs));
  result := compile_module_to_c(exprs, "test_impl_pass1", "main");
  match(
    result,
    .None => assert(false, "expected C output"),
    .Some(output) => {
      assert(output.contains(String.from("Counter_inc")), "impl method has correct C name");
    }
  );
});
