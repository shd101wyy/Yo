    output.contains(String.from("int32_t x = 42;")),
    "expected 'int32_t x = 42;' emitted as statement"
  );
});
test("generate_expr: typed declaration returns 0", {
  // (x : i32) = 42  →  returns "0"
  expr := make_typed_decl_expr("x", "i32", make_atom_expr(TokenKind.Integer, "42"));
  result := run_gen(expr);
