  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app));
  result := compile_module_to_c(exprs, "call_mod", "main");
  match(
    result,
    .None => assert(false, "function-calling-function should compile"),
    .Some(c_code) => {
