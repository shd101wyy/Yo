// Struct constructor — is_labeled_arg, all_labeled_args, is_uppercase_start,
//                      handle_struct_constructor, generate_expr integration
// ---------------------------------------------------------------------------
test("is_labeled_arg: colon infix with 2 args is labeled", {
  name_e := make_atom_expr(TokenKind.Identifier, "value");
  val_e := make_atom_expr(TokenKind.Integer, "42");
  labeled := make_colon_expr(name_e, val_e);
  assert(is_labeled_arg(labeled), "colon infix should be labeled arg");
});
test("is_labeled_arg: plain atom is not labeled", {
  e := make_atom_expr(TokenKind.Identifier, "x");
  assert(!(is_labeled_arg(e)), "atom is not a labeled arg");
});
test("is_labeled_arg: non-colon infix is not labeled", {
  lhs := make_atom_expr(TokenKind.Identifier, "a");
  rhs := make_atom_expr(TokenKind.Integer, "1");
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  plus_tok := make_token_raw(TokenKind.Operator, "+");
  e := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), plus_tok)), args, true, plus_tok);
  assert(!(is_labeled_arg(e)), "plus infix is not a labeled arg");
});
test("all_labeled_args: all labeled returns true", {
  f1 := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "x"),
    make_atom_expr(TokenKind.Integer, "1")
  );
  f2 := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "y"),
    make_atom_expr(TokenKind.Integer, "2")
  );
  args := ArrayList(AstExpr).new();
  args.push(f1);
  args.push(f2);
  assert(all_labeled_args(args), "all labeled args");
});
test("all_labeled_args: empty list returns false", {
  empty := ArrayList(AstExpr).new();
  assert(!(all_labeled_args(empty)), "empty list is not all-labeled");
});
test("all_labeled_args: mixed args returns false", {
  f1 := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "x"),
    make_atom_expr(TokenKind.Integer, "1")
  );
  pos := make_atom_expr(TokenKind.Integer, "2");
  args := ArrayList(AstExpr).new();
  args.push(f1);
  args.push(pos);
  assert(!(all_labeled_args(args)), "mixed args not all labeled");
});
test("is_uppercase_start: uppercase name returns true", {
  assert(is_uppercase_start(String.from("Counter")), "Counter starts uppercase");
  assert(is_uppercase_start(String.from("Point")), "Point starts uppercase");
});
test("is_uppercase_start: lowercase name returns false", {
  assert(!(is_uppercase_start(String.from("add"))), "add starts lowercase");
  assert(!(is_uppercase_start(String.from("foo"))), "foo starts lowercase");
});
test("is_uppercase_start: empty string returns false", {
  assert(!(is_uppercase_start(String.from(""))), "empty string has no uppercase start");
});
test("handle_struct_constructor: single field emits compound literal", {
