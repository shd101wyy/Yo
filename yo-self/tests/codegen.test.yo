});
test("validation: str.from_raw_parts lowers to C pointer view", {
  args := ArrayList(AstExpr).new();
  args.push(make_atom_expr(TokenKind.Identifier, "ptr"));
  len_args := ArrayList(AstExpr).new();
  len_args.push(make_atom_expr(TokenKind.Integer, "5"));
  args.push(make_fncall_expr("usize", len_args));
  call_expr := make_method_call_expr(make_atom_expr(TokenKind.Identifier, "str"), "from_raw_parts", args);
  result := run_gen(call_expr);
  match(
    result,
    .None => assert(false, "str.from_raw_parts should generate"),
    .Some(code) => {
      assert(code.contains(String.from("(const char*)")), "should cast pointer to const char*");
      assert(!(code.contains(String.from("str.from_raw_parts"))), "should not emit raw Yo method call");
    }
  );
});
test("validation: Slice(u8).from_raw_parts returns indexable slice wrapper", {
  slice_type_args := ArrayList(AstExpr).new();
  slice_type_args.push(make_atom_expr(TokenKind.Identifier, "u8"));
  slice_type := make_fncall_expr("Slice", slice_type_args);
  args := ArrayList(AstExpr).new();
  args.push(make_atom_expr(TokenKind.Identifier, "ptr"));
  len_args := ArrayList(AstExpr).new();
  len_args.push(make_atom_expr(TokenKind.Integer, "5"));
  args.push(make_fncall_expr("usize", len_args));
  raw_parts := make_method_call_expr(slice_type, "from_raw_parts", args);
  ctx := CodegenContext.new();
  pctx := &(ctx);
  ind := String.new();
  def_expr := make_infix_expr(":=", make_atom_expr(TokenKind.Identifier, "slice"), raw_parts);
  gen_result := generate_expr(def_expr, pctx, ind);
  match(gen_result,.None => assert(false, "slice definition should generate"),.Some(_) => ());
  idx_args := ArrayList(AstExpr).new();
  idx_usize_args := ArrayList(AstExpr).new();
  idx_usize_args.push(make_atom_expr(TokenKind.Integer, "0"));
  idx_args.push(make_fncall_expr("usize", idx_usize_args));
  idx_expr := make_fncall_expr("slice", idx_args);
  idx_result := generate_expr(idx_expr, pctx, ind);
  match(
    idx_result,
    .None => assert(false, "slice index should generate"),
    .Some(code) => {
      assert(code.contains(String.from("slice.data[")), "slice var should index through data field");
    }
  );
});
test("validation: println lowers to printf string output", {
  args := ArrayList(AstExpr).new();
  args.push(make_atom_expr(TokenKind.Identifier, "message"));
  call_expr := make_fncall_expr("println", args);
  ctx := CodegenContext.new();
  pctx := &(ctx);
  ind := String.new();
  result := generate_expr(call_expr, pctx, ind);
  match(result,.None => assert(false, "println should generate"),.Some(_) => ());
  output := ctx.emitter.print();
  assert(output.contains(String.from("printf(\"%s\\n\", message);")), "println should emit printf");
});
test("validation: Self.method static dispatch uses current impl type", {
  args := ArrayList(AstExpr).new();
  args.push(make_atom_expr(TokenKind.Identifier, "n"));
  call_expr := make_method_call_expr(make_atom_expr(TokenKind.Identifier, "Self"), "callee", args);
  ctx := CodegenContext.new();
  ctx.register_fn_with_params(String.from("P_callee"), String.new());
  ctx.set_self_type("P");
  pctx := &(ctx);
  ind := String.new();
  result := generate_expr(call_expr, pctx, ind);
  match(
    result,
    .None => assert(false, "Self.callee should generate"),
    .Some(code) => {
      assert(code == String.from("fn_P_callee(n)"), "Self should resolve to current impl type");
    }
  );
});
test("validation: type-name static dispatch does not require registered struct", {
  args := ArrayList(AstExpr).new();
  args.push(make_atom_expr(TokenKind.Integer, "10"));
  call_expr := make_method_call_expr(make_atom_expr(TokenKind.Identifier, "P"), "caller", args);
  ctx := CodegenContext.new();
  ctx.register_fn_with_params(String.from("P_caller"), String.new());
  pctx := &(ctx);
  ind := String.new();
  result := generate_expr(call_expr, pctx, ind);
  match(
    result,
    .None => assert(false, "P.caller should generate"),
    .Some(code) => {
      assert(code == String.from("fn_P_caller(10)"), "type-name static dispatch should use fn prefix");
    }
  );
});
test("validation: sizeof Option(T) lowers through type_expr_to_c", {
  option_args := ArrayList(AstExpr).new();
  option_args.push(make_atom_expr(TokenKind.Identifier, "MyBox"));
  option_type := make_fncall_expr("Option", option_args);
  sizeof_args := ArrayList(AstExpr).new();
  sizeof_args.push(option_type);
  sizeof_expr := make_fncall_expr("sizeof", sizeof_args);
  result := run_gen(sizeof_expr);
  match(
    result,
    .None => assert(false, "sizeof Option(MyBox) should generate"),
    .Some(code) => {
      assert(code == String.from("sizeof(void*)"), "Option(T) should lower to opaque pointer size");
    }
  );
});
