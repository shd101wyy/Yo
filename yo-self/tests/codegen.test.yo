test("compile_module_to_c: program with assert call", {
  // check :: (fn(x : i32) -> unit)({ assert((x > 0)); });
  // main :: (fn() -> i32)(0);
  exprs := ArrayList(AstExpr).new();
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  fn_params := ArrayList(AstExpr).new();
  fn_params.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "i32")));
  fn_type := make_infix_expr("->", make_fncall_expr("fn", fn_params), make_atom_expr(TokenKind.Identifier, "unit"));
  assert_cond := make_infix_expr(">", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Integer, "0"));
  assert_args := ArrayList(AstExpr).new();
  assert_args.push(assert_cond);
  assert_call := make_fncall_expr("assert", assert_args);
  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(assert_call);
  body := make_begin_expr(body_stmts);
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  fn_app := AstExpr.FnCall(usize(0), box(fn_type), body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "check"), fn_app));
  main_params := ArrayList(AstExpr).new();
  main_fn_type := make_infix_expr("->", make_fncall_expr("fn", main_params), make_atom_expr(TokenKind.Identifier, "i32"));
  main_body_args := ArrayList(AstExpr).new();
  main_body_args.push(make_atom_expr(TokenKind.Integer, "0"));
  main_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app));
  result := compile_module_to_c(exprs, "assert_mod", "main");
  match(
    result,
    .None => assert(false, "assert program should compile"),
    .Some(c_code) => {
      assert(c_code.contains(String.from("check")), "should have check fn");
      assert(c_code.contains(String.from("exit(1)")), "should have exit(1) for assert");
      assert(c_code.contains(String.from("int main")), "should have main");
    }
  );
});
test("compile_module_to_c: program with type cast i32(x)", {
