test("compile_module_to_c: program with if/else emits conditional", {
  // abs :: (fn(x : i32) -> i32)({ if((x < 0), (0 - x), x); });
  // main :: (fn() -> i32)(0);
  exprs := ArrayList(AstExpr).new();
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  fn_params := ArrayList(AstExpr).new();
  fn_params.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "i32")));
  fn_type := make_infix_expr("->", make_fncall_expr("fn", fn_params), make_atom_expr(TokenKind.Identifier, "i32"));
  cond_e := make_infix_expr("<", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Integer, "0"));
  then_e := make_infix_expr("-", make_atom_expr(TokenKind.Integer, "0"), make_atom_expr(TokenKind.Identifier, "x"));
  else_e := make_atom_expr(TokenKind.Identifier, "x");
  if_expr := make_if_else_expr(cond_e, then_e, else_e);
  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(if_expr);
  body := make_begin_expr(body_stmts);
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  fn_app := AstExpr.FnCall(usize(0), box(fn_type), body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "abs"), fn_app));
  main_params := ArrayList(AstExpr).new();
  main_fn_type := make_infix_expr("->", make_fncall_expr("fn", main_params), make_atom_expr(TokenKind.Identifier, "i32"));
  main_body_args := ArrayList(AstExpr).new();
  main_body_args.push(make_atom_expr(TokenKind.Integer, "0"));
  main_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app));
  result := compile_module_to_c(exprs, "if_mod", "main");
  match(
    result,
    .None => assert(false, "if/else program should compile"),
    .Some(c_code) => {
      assert(c_code.contains(String.from("abs")), "should have abs function");
      assert(c_code.contains(String.from("int main")), "should have main");
      has_if := (c_code.contains(String.from("if")) || c_code.contains(String.from("?")));
      assert(has_if, "should have if or ternary");
    }
  );
});
test("compile_module_to_c: program with while loop emits while", {
  // countdown :: (fn(n : i32) -> i32)({
  //   (x : i32) = n; while runtime((x > 0)), { x = (x - 1); }; x;
  // });
  // main :: (fn() -> i32)(0);
  exprs := ArrayList(AstExpr).new();
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  fn_params := ArrayList(AstExpr).new();
  fn_params.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "n"), make_atom_expr(TokenKind.Identifier, "i32")));
  fn_type := make_infix_expr("->", make_fncall_expr("fn", fn_params), make_atom_expr(TokenKind.Identifier, "i32"));
  x_decl := make_assign_expr(
    make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "i32")),
    make_atom_expr(TokenKind.Identifier, "n")
  );
  while_cond := make_runtime_cond(make_infix_expr(">", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Integer, "0")));
  while_body_stmts := ArrayList(AstExpr).new();
  while_body_stmts.push(make_assign_expr(make_atom_expr(TokenKind.Identifier, "x"), make_infix_expr("-", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Integer, "1"))));
  while_body := make_begin_expr(while_body_stmts);
  while_expr := make_while_expr(while_cond, while_body);
  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(x_decl);
  body_stmts.push(while_expr);
  body_stmts.push(make_atom_expr(TokenKind.Identifier, "x"));
  body := make_begin_expr(body_stmts);
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  fn_app := AstExpr.FnCall(usize(0), box(fn_type), body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "countdown"), fn_app));
  main_params := ArrayList(AstExpr).new();
  main_fn_type := make_infix_expr("->", make_fncall_expr("fn", main_params), make_atom_expr(TokenKind.Identifier, "i32"));
  main_body_args := ArrayList(AstExpr).new();
  main_body_args.push(make_atom_expr(TokenKind.Integer, "0"));
  main_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app));
  result := compile_module_to_c(exprs, "while_mod", "main");
  match(
    result,
    .None => assert(false, "while loop program should compile"),
    .Some(c_code) => {
      assert(c_code.contains(String.from("countdown")), "should have countdown function");
      assert(c_code.contains(String.from("while")), "should have while loop");
      assert(c_code.contains(String.from("int main")), "should have main");
    }
  );
});
test("compile_module_to_c: program with function calling function", {
  // double :: (fn(x : i32) -> i32)((x + x));
  // quadruple :: (fn(x : i32) -> i32)(double(double(x)));
