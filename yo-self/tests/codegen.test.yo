});
test("generate_expr: typed declaration emits statement", {
  // (x : i32) = 42  →  emits "int32_t x = 42;" as statement, returns "0"
  expr := make_typed_decl_expr("x", "i32", make_atom_expr(TokenKind.Integer, "42"));
