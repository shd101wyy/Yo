test("generate_expr: break emits break statement", {
  ctx := CodegenContext.new();
  pctx := &(ctx);
  // break() => emits "break;\n" and returns "0"
  break_args := ArrayList(AstExpr).new();
  break_expr := make_fncall_expr("break", break_args);
  result := generate_expr(break_expr, pctx, String.from("  "));
  match(
    result,
    .None => assert(false, "break should return(Some)"),
    .Some(v) => assert(v.as_str() == "0", "break returns 0 sentinel")
  );
  output := ctx.emitter.print();
  assert(output.contains(String.from("break;")), "should contain break;");
});
