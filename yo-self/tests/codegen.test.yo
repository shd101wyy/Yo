  p_first := make_dot_expr(make_atom_expr(TokenKind.Identifier, "p"), make_atom_expr(TokenKind.Identifier, "first"));
  p_second := make_dot_expr(make_atom_expr(TokenKind.Identifier, "p"), make_atom_expr(TokenKind.Identifier, "second"));
  sum_body := make_infix_expr("+", p_first, p_second);
  body_args := ArrayList(AstExpr).new();
