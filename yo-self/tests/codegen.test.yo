test "emit_case_open: named case", {
  ctx  := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;
  emit_case_open("__YO_ENUM_MOD_ID_2_RED", pctx);
  out := ctx.emitter.print();
  assert(out.contains(String.from("case __YO_ENUM_MOD_ID_2_RED: {")), "named case");
};

test "emit_case_open: wildcard emits default", {
  ctx  := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;
  emit_case_open("", pctx);
  out := ctx.emitter.print();
  assert(out.contains(String.from("default: {")), "default case");
};

test "emit_case_body: emits assignment, break, close brace", {
  ctx  := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;
  emit_case_body("_yo_temp_1", "42", pctx);
  out := ctx.emitter.print();
  assert(out.contains(String.from("_yo_temp_1 = 42;")), "assignment");
  assert(out.contains(String.from("break;")),            "break");
  assert(out.contains(String.from("}")),                 "close brace");
};

test "generate_match_simple: switch on unit enum", {
  ctx  := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;

  arms := ArrayList(SimpleArm).new();

  arm_red := SimpleArm(
    tag_const: String.from("__YO_ENUM_MOD_ID_2_RED"),
    body: make_atom_expr(TokenKind.Integer, "0")
  );
  arms.push(arm_red);

  arm_green := SimpleArm(
    tag_const: String.from("__YO_ENUM_MOD_ID_2_GREEN"),
    body: make_atom_expr(TokenKind.Integer, "1")
  );
  arms.push(arm_green);

  arm_blue := SimpleArm(
    tag_const: String.from("__YO_ENUM_MOD_ID_2_BLUE"),
    body: make_atom_expr(TokenKind.Integer, "2")
  );
  arms.push(arm_blue);

  generate_match_simple("c", "int32_t", "_yo_temp_1", arms, generate_expr, pctx, "");
  out := ctx.emitter.print();

  assert(out.contains(String.from("int32_t _yo_temp_1;")),               "temp decl");
  assert(out.contains(String.from("switch (c) {")),                      "switch open");
  assert(out.contains(String.from("case __YO_ENUM_MOD_ID_2_RED: {")),   "RED case");
  assert(out.contains(String.from("case __YO_ENUM_MOD_ID_2_GREEN: {")), "GREEN case");
  assert(out.contains(String.from("case __YO_ENUM_MOD_ID_2_BLUE: {")),  "BLUE case");
  assert(out.contains(String.from("_yo_temp_1 = 0;")),                   "RED body");
  assert(out.contains(String.from("_yo_temp_1 = 1;")),                   "GREEN body");
  assert(out.contains(String.from("_yo_temp_1 = 2;")),                   "BLUE body");
};

test "generate_match_data: switch on data enum with field bindings", {
  ctx  := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;

  // .Circle(r) arm with one binding
  circle_bindings := ArrayList(DataBinding).new();
  circle_b := DataBinding(
    var_name:   String.from("r"),
    field_path: String.from("data.Circle.r"),
    type_c:     String.from("int32_t")
  );
  circle_bindings.push(circle_b);
  circle_arm := DataArm(
    tag_const: String.from("__YO_ENUM_MOD_ID_2_CIRCLE"),
    bindings:  circle_bindings,
    body:      make_atom_expr(TokenKind.Integer, "42")
  );

  // .Rect(w, h) arm with two bindings
  rect_bindings := ArrayList(DataBinding).new();
  rect_w := DataBinding(
    var_name:   String.from("w"),
    field_path: String.from("data.Rect.w"),
    type_c:     String.from("int32_t")
  );
  rect_h := DataBinding(
    var_name:   String.from("h"),
    field_path: String.from("data.Rect.h"),
    type_c:     String.from("int32_t")
  );
  rect_bindings.push(rect_w);
  rect_bindings.push(rect_h);
  rect_arm := DataArm(
    tag_const: String.from("__YO_ENUM_MOD_ID_2_RECT"),
    bindings:  rect_bindings,
    body:      make_atom_expr(TokenKind.Integer, "99")
  );

  arms := ArrayList(DataArm).new();
  arms.push(circle_arm);
  arms.push(rect_arm);

  generate_match_data("shape", "int32_t", "_yo_temp_2", arms, generate_expr, pctx, "");
  out := ctx.emitter.print();

  assert(out.contains(String.from("int32_t _yo_temp_2;")),                      "temp decl");
  assert(out.contains(String.from("switch ((shape).tag) {")),                    "switch open");
  assert(out.contains(String.from("case __YO_ENUM_MOD_ID_2_CIRCLE: {")),        "CIRCLE case");
  assert(out.contains(String.from("int32_t r = shape.data.Circle.r;")),          "r binding");
  assert(out.contains(String.from("case __YO_ENUM_MOD_ID_2_RECT: {")),           "RECT case");
  assert(out.contains(String.from("int32_t w = shape.data.Rect.w;")),            "w binding");
  assert(out.contains(String.from("int32_t h = shape.data.Rect.h;")),            "h binding");
};

test "generate_match_simple: wildcard arm emits default case", {
  ctx  := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;

  arms := ArrayList(SimpleArm).new();
  arm_a := SimpleArm(
    tag_const: String.from("__YO_ENUM_ID_TAG_A"),
    body: make_atom_expr(TokenKind.Integer, "1")
  );
  arms.push(arm_a);
  arm_wild := SimpleArm(
    tag_const: String.from(""),  // wildcard
    body: make_atom_expr(TokenKind.Integer, "0")
  );
  arms.push(arm_wild);

  generate_match_simple("x", "int32_t", "_yo_temp_3", arms, generate_expr, pctx, "");
  out := ctx.emitter.print();
  assert(out.contains(String.from("case __YO_ENUM_ID_TAG_A: {")), "named case");
  assert(out.contains(String.from("default: {")),                  "wildcard default");
};

// ---------------------------------------------------------------------------
// Phase 4j+ — Compiler driver helpers
// ---------------------------------------------------------------------------

/// Build `FnCall(Atom("fn"), params, false)` — fn type prefix.
make_fn_type_prefix :: (fn(params : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("fn", params)
);

/// Build `FnCall(Atom("->"), [fn_prefix, ret_ty], true)` — fn type with return.
make_fn_type :: (fn(params : ArrayList(AstExpr), ret_ty : AstExpr) -> AstExpr)({
  fn_prefix := make_fn_type_prefix(params);
  make_infix_expr("->", fn_prefix, ret_ty)
});

/// Build the whole `(fn(params) -> ret_ty)(body)` function literal application.
make_fn_app :: (fn(params : ArrayList(AstExpr), ret_ty : AstExpr, body : AstExpr) -> AstExpr)({
  fn_type := make_fn_type(params, ret_ty);
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  fn_type_tok := make_token_raw(TokenKind.Operator, "->");
  .FnCall(box(fn_type), body_args, false, fn_type_tok)
});

/// Build `FnCall(Atom("::"), [name_atom, fn_app], true)` — named constant define.
make_define_expr :: (fn(name : str, rhs : AstExpr) -> AstExpr)(
  make_infix_expr("::", make_atom_expr(TokenKind.Identifier, name), rhs)
);

/// Build `FnCall(Atom(":"), [name, ty], true)` — typed param (reuses make_colon_expr).
make_param :: (fn(name : str, ty_name : str) -> AstExpr)(
  make_colon_expr(
    make_atom_expr(TokenKind.Identifier, name),
    make_atom_expr(TokenKind.Identifier, ty_name)
  )
);

/// Build a `using(name : Type)` evidence param expression.
make_using_param :: (fn(ev_name : str, ty_name : str) -> AstExpr)({
  inner := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, ev_name),
    make_atom_expr(TokenKind.Identifier, ty_name)
  );
  a := ArrayList(AstExpr).new();
  a.push(inner);
  make_fncall_expr("using", a)
});

// ---------------------------------------------------------------------------
// Phase 4j+ tests — extract_fn_def
// ---------------------------------------------------------------------------

test "extract_fn_def: simple no-param fn() -> unit", {
  body  := make_begin_expr(ArrayList(AstExpr).new());
  ret   := make_atom_expr(TokenKind.Identifier, "unit");
  rhs   := make_fn_app(ArrayList(AstExpr).new(), ret, body);
  expr  := make_define_expr("main", rhs);

  fd := extract_fn_def(expr);
  match(fd,
    .None    => assert(false, "should extract FnDef"),
    .Some(d) => {
      assert((d.name == String.from("main")),    "name = main");
      assert((d.ret_ty_c == String.from("void")), "ret_ty = void");
      assert((d.params.len() == usize(0)),        "no params");
    }
  );
};

test "extract_fn_def: fn(x : i32) -> i64", {
  params := ArrayList(AstExpr).new();
  params.push(make_param("x", "i32"));
  body  := make_atom_expr(TokenKind.Identifier, "x");
  ret   := make_atom_expr(TokenKind.Identifier, "i64");
  rhs   := make_fn_app(params, ret, body);
  expr  := make_define_expr("double_it", rhs);

  fd := extract_fn_def(expr);
  match(fd,
    .None    => assert(false, "should extract FnDef"),
    .Some(d) => {
      assert((d.name == String.from("double_it")),   "name");
      assert((d.ret_ty_c == String.from("int64_t")), "ret_ty = int64_t");
      assert((d.params.len() == usize(1)),            "one param");
      match(d.param_tys.get(usize(0)),
        .None    => assert(false, "no param ty"),
        .Some(t) => assert((t == String.from("int32_t")), "param ty = int32_t")
      );
    }
  );
};

test "extract_fn_def: using evidence param → void*", {
  params := ArrayList(AstExpr).new();
  params.push(make_using_param("io", "IO"));
  body  := make_begin_expr(ArrayList(AstExpr).new());
  ret   := make_atom_expr(TokenKind.Identifier, "unit");
  rhs   := make_fn_app(params, ret, body);
  expr  := make_define_expr("run", rhs);

  fd := extract_fn_def(expr);
  match(fd,
    .None    => assert(false, "should extract"),
    .Some(d) => {
      assert((d.params.len() == usize(1)), "one evidence param");
      match(d.params.get(usize(0)),
        .None    => assert(false, "no param name"),
        .Some(n) => assert((n == String.from("ev_io")), "param name = ev_io")
      );
      match(d.param_tys.get(usize(0)),
        .None    => assert(false, "no param ty"),
        .Some(t) => assert((t == String.from("void*")), "param ty = void*")
      );
    }
  );
};

test "extract_fn_def: non-define expr returns None", {
  expr := make_atom_expr(TokenKind.Identifier, "hello");
  fd   := extract_fn_def(expr);
  match(fd,
    .None    => (),   // expected
    .Some(_) => assert(false, "should return None for non-define")
  );
};

// ---------------------------------------------------------------------------
// Phase 4j+ tests — compile_module_to_c
// ---------------------------------------------------------------------------

test "compile_module_to_c: trivial main() → generates static fn + int main", {
  body  := make_begin_expr(ArrayList(AstExpr).new());
  ret   := make_atom_expr(TokenKind.Identifier, "unit");
  rhs   := make_fn_app(ArrayList(AstExpr).new(), ret, body);
  expr  := make_define_expr("main", rhs);

  exprs := ArrayList(AstExpr).new();
  exprs.push(expr);

  result := compile_module_to_c(exprs, "test_module", "main");
  match(result,
    .None    => assert(false, "no C output"),
    .Some(c) => {
      assert(c.contains(String.from("static void fn_main")), "static fn decl");
      assert(c.contains(String.from("int main(void)")),       "int main wrapper");
      assert(c.contains(String.from("fn_main();")),           "call in main wrapper");
      assert(c.contains(String.from("#include <stdio.h>")),   "preamble included");
    }
  );
};

test "compile_module_to_c: main not found returns None", {
  body  := make_begin_expr(ArrayList(AstExpr).new());
  ret   := make_atom_expr(TokenKind.Identifier, "unit");
  rhs   := make_fn_app(ArrayList(AstExpr).new(), ret, body);
  expr  := make_define_expr("helper", rhs);   // not "main"

  exprs := ArrayList(AstExpr).new();
  exprs.push(expr);

  result := compile_module_to_c(exprs, "test_module", "main");
  match(result,
    .None    => (),   // expected
    .Some(_) => assert(false, "should be None when main absent")
  );
};

test "compile_module_to_c: fn with i32 param emits correct signature", {
  params := ArrayList(AstExpr).new();
  params.push(make_param("n", "i32"));
  body  := make_atom_expr(TokenKind.Identifier, "n");
  ret   := make_atom_expr(TokenKind.Identifier, "i32");
  rhs   := make_fn_app(params, ret, body);
  expr  := make_define_expr("main", rhs);

  exprs := ArrayList(AstExpr).new();
  exprs.push(expr);

  result := compile_module_to_c(exprs, "test_module", "main");
  match(result,
    .None    => assert(false, "no C output"),
    .Some(c) => {
      assert(c.contains(String.from("int32_t n")), "param in signature");
      assert(c.contains(String.from("static int32_t fn_main")), "return type");
    }
  );
};

// ---------------------------------------------------------------------------
// Phase 4 validation milestone — parse + compile hello_world
// ---------------------------------------------------------------------------
// These tests use the self-hosted lexer+parser to parse Yo source, then call
// compile_module_to_c to produce a complete C11 source file.
// They are the "Phase 4 validation milestone": compile hello_world.yo end-to-end
// through the Yo-written compiler.

{ parse, ParseError } :: import "../parser/parser.yo";

test "validation: parse and compile trivial main() -> unit", {
  given(exn) := Exception(throw: ((err) -> { assert(false, "unexpected parse error"); escape (); }));
  src := String.from("main :: (fn() -> unit)({ }); export main;");
  exprs := parse(src, String.from("<test>"), using(exn));
  opt_c := compile_module_to_c(exprs, "hello_module", "main");
  match(opt_c,
    .None    => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("static void fn_main(")),   "static fn_main declaration");
      assert(c.contains(String.from("int main(void)")),          "int main wrapper");
      assert(c.contains(String.from("fn_main();")),              "call in main");
      assert(c.contains(String.from("#include <stdio.h>")),      "preamble present");
    }
  );
};

test "validation: parse and compile fn with i32 parameter", {
  given(exn) := Exception(throw: ((err) -> { assert(false, "unexpected parse error"); escape (); }));
  src := String.from("add :: (fn(x : i32, y : i32) -> i32)({ x; }); export add;");
  exprs := parse(src, String.from("<test>"), using(exn));
  opt_c := compile_module_to_c(exprs, "arith_module", "add");
  match(opt_c,
    .None    => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("int32_t x")),              "param x: i32");
      assert(c.contains(String.from("int32_t y")),              "param y: i32");
      assert(c.contains(String.from("static int32_t fn_add(")), "fn return type");
    }
  );
};

// ---------------------------------------------------------------------------
// Phase 5b — handle_define, handle_type_cast, handle_assert, compile_test_body_to_c
// ---------------------------------------------------------------------------
// These tests verify the three new codegen features added for the test runner.

/// Build `FnCall(Atom(":="), [name_atom, rhs], true)` — define expression.
make_walrus_expr :: (fn(name : str, rhs : AstExpr) -> AstExpr)(
  make_infix_expr(":=", make_atom_expr(TokenKind.Identifier, name), rhs)
);

/// Build `FnCall(Atom("assert"), [cond, msg], false)` — assert call.
make_assert_expr :: (fn(cond_e : AstExpr, msg : str) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(make_atom_expr(TokenKind.StringLit, msg));
  make_fncall_expr("assert", a)
});

test "handle_define: x := 42 emits __auto_type x = 42;", {
  // Build `x := 42`
  rhs  := make_atom_expr(TokenKind.Integer, "42");
  expr := make_walrus_expr("x", rhs);
  ctx  := run_gen_with_ctx(expr);
  code := generate_c_output(&ctx);
  assert(code.contains(String.from("__auto_type x = 42;")), "define emits __auto_type");
};

test "handle_define: returns unit sentinel 0 so no spurious value emitted", {
  // When used as statement in a begin block, define returns "0" (unit sentinel)
  rhs  := make_atom_expr(TokenKind.Integer, "5");
  expr := make_walrus_expr("y", rhs);
  result := run_gen(expr);
  match(result,
    .None    => assert(false, "expected Some"),
    .Some(v) => assert((v == String.from("0")), "unit sentinel 0")
  );
};

test "handle_type_cast: i32(99) emits (int32_t)(99)", {
  a := ArrayList(AstExpr).new();
  a.push(make_atom_expr(TokenKind.Integer, "99"));
  expr := make_fncall_expr("i32", a);
  result := run_gen(expr);
  match(result,
    .None    => assert(false, "expected Some"),
    .Some(v) => assert(v.contains(String.from("(int32_t)(99)")), "cast emitted correctly")
  );
};

test "handle_type_cast: u8(x) emits (uint8_t)(x)", {
  a := ArrayList(AstExpr).new();
  a.push(make_atom_expr(TokenKind.Identifier, "x"));
  expr := make_fncall_expr("u8", a);
  result := run_gen(expr);
  match(result,
    .None    => assert(false, "expected Some"),
    .Some(v) => assert(v.contains(String.from("(uint8_t)(x)")), "u8 cast emitted correctly")
  );
};

test "handle_type_cast: bool(x) emits (bool)(x)", {
  a := ArrayList(AstExpr).new();
  a.push(make_atom_expr(TokenKind.Identifier, "x"));
  expr := make_fncall_expr("bool", a);
  result := run_gen(expr);
  match(result,
    .None    => assert(false, "expected Some"),
    .Some(v) => assert(v.contains(String.from("(bool)(x)")), "bool cast emitted correctly")
  );
};

test "handle_assert: assert(cond, msg) emits if (!cond) { exit(1); }", {
  cond_e := make_atom_expr(TokenKind.Identifier, "ok");
  expr   := make_assert_expr(cond_e, "\"check\"");
  ctx    := run_gen_with_ctx(expr);
  code   := generate_c_output(&ctx);
  assert(code.contains(String.from("if (!(ok))")), "if guard");
  assert(code.contains(String.from("exit(1)")),    "exit(1) on failure");
};

test "compile_test_body_to_c: empty body compiles to valid C with main wrapper", {
  body := make_begin_expr(ArrayList(AstExpr).new());
  c    := compile_test_body_to_c(body, "test_mod");
  assert(c.contains(String.from("fn_test_body")),  "test body function");
  assert(c.contains(String.from("int main(void)")), "main wrapper");
  assert(c.contains(String.from("#include <stdio.h>")), "preamble");
};

test "compile_test_body_to_c: assert in body emits if guard", {
  cond_e := make_atom_expr(TokenKind.Identifier, "ok");
  assert_e := make_assert_expr(cond_e, "\"msg\"");
  stmts := ArrayList(AstExpr).new();
  stmts.push(assert_e);
  body := make_begin_expr(stmts);
  c    := compile_test_body_to_c(body, "test_mod");
  assert(c.contains(String.from("if (!(ok))")), "assert guard present in test body C");
};

// ---------------------------------------------------------------------------
// Phase 4f+ — struct/impl support in compile_module_to_c
// ---------------------------------------------------------------------------

/// Build `FnCall(Atom("struct"), [field1, field2, ...], false)` — struct type literal.
make_struct_type_expr :: (fn(fields : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("struct", fields)
);

/// Build a `Name :: struct(fields...)` definition expression.
make_struct_def_expr :: (fn(name : str, fields : ArrayList(AstExpr)) -> AstExpr)(
  make_infix_expr("::", make_atom_expr(TokenKind.Identifier, name), make_struct_type_expr(fields))
);

/// Build an `impl(TypeName, begin_expr)` expression.
make_impl_expr :: (fn(type_name : str, body : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(make_atom_expr(TokenKind.Identifier, type_name));
  a.push(body);
  make_fncall_expr("impl", a)
});

test "extract_struct_def: simple struct with i32 field", {
  // Counter :: struct(value : i32)
  fields := ArrayList(AstExpr).new();
  fields.push(make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "value"),
    make_atom_expr(TokenKind.Identifier, "i32")
  ));
  expr := make_struct_def_expr("Counter", fields);
  result := extract_struct_def(expr);
  match(result,
    .None => assert(false, "expected Some(StructDef)"),
    .Some(sd) => {
      assert((sd.name == String.from("Counter")), "struct name");
      assert((sd.field_names.len() == usize(1)), "one field");
      match(sd.field_names.get(usize(0)),
        .None  => assert(false, "field name missing"),
        .Some(n) => assert((n == String.from("value")), "field name is 'value'")
      );
      match(sd.field_tys.get(usize(0)),
        .None  => assert(false, "field type missing"),
        .Some(t) => assert((t == String.from("int32_t")), "field type is int32_t")
      );
    }
  );
};

test "extract_struct_def: two fields i32 and bool", {
  fields := ArrayList(AstExpr).new();
  fields.push(make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "x"),
    make_atom_expr(TokenKind.Identifier, "i32")
  ));
  fields.push(make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "enabled"),
    make_atom_expr(TokenKind.Identifier, "bool")
  ));
  expr := make_struct_def_expr("Config", fields);
  result := extract_struct_def(expr);
  match(result,
    .None => assert(false, "expected Some"),
    .Some(sd) => {
      assert((sd.field_names.len() == usize(2)), "two fields");
      match(sd.field_tys.get(usize(1)),
        .None  => assert(false, "second field type missing"),
        .Some(t) => assert((t == String.from("bool")), "second field is bool")
      );
    }
  );
};

test "extract_struct_def: non-struct expr returns None", {
  // A regular function def should not be recognised as a struct.
  body  := make_begin_expr(ArrayList(AstExpr).new());
  ret   := make_atom_expr(TokenKind.Identifier, "unit");
  rhs   := make_fn_app(ArrayList(AstExpr).new(), ret, body);
  expr  := make_define_expr("main", rhs);
  result := extract_struct_def(expr);
  match(result,
    .None    => (),   // expected
    .Some(_) => assert(false, "function def should not be a struct")
  );
};

test "emit_struct_to_c: single field emits typedef struct", {
  fields := ArrayList(AstExpr).new();
  fields.push(make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "value"),
    make_atom_expr(TokenKind.Identifier, "i32")
  ));
  expr := make_struct_def_expr("Counter", fields);
  match(extract_struct_def(expr),
    .None => assert(false, "extract failed"),
    .Some(sd) => {
      ctx := CodegenContext.new();
      (pctx : *(CodegenContext)) = &ctx;
      emit_struct_to_c(sd, pctx);
      c := generate_c_output(&ctx);
      assert(c.contains(String.from("typedef struct")), "typedef struct keyword");
      assert(c.contains(String.from("int32_t value")), "field emitted");
      assert(c.contains(String.from("} Counter;")), "struct name in typedef");
    }
  );
};

test "compile_module_to_c: struct definition emits typedef before functions", {
  // Point :: struct(x : i32, y : i32);  add_pt :: (fn(p : Point) -> i32)(p.x);  main :: ...
  fields := ArrayList(AstExpr).new();
  fields.push(make_colon_expr(make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "i32")));
  fields.push(make_colon_expr(make_atom_expr(TokenKind.Identifier, "y"), make_atom_expr(TokenKind.Identifier, "i32")));
  struct_expr := make_struct_def_expr("Point", fields);

  body  := make_begin_expr(ArrayList(AstExpr).new());
  ret   := make_atom_expr(TokenKind.Identifier, "unit");
  rhs   := make_fn_app(ArrayList(AstExpr).new(), ret, body);
  main_expr := make_define_expr("main", rhs);

  exprs := ArrayList(AstExpr).new();
  exprs.push(struct_expr);
  exprs.push(main_expr);

  opt_c := compile_module_to_c(exprs, "test_mod", "main");
  match(opt_c,
    .None    => assert(false, "expected Some"),
    .Some(c) => {
      assert(c.contains(String.from("typedef struct")),     "struct typedef present");
      assert(c.contains(String.from("} Point;")),           "Point typedef name");
      assert(c.contains(String.from("int32_t x")),          "field x in struct");
      assert(c.contains(String.from("int32_t y")),          "field y in struct");
      assert(c.contains(String.from("static void fn_main")), "main function");
    }
  );
};

test "extract_impl_fns: extracts method as TypeName_method", {
  // impl(Counter, { get :: (fn(self : Counter) -> i32)(self.value); });
  self_param := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "self"),
    make_atom_expr(TokenKind.Identifier, "Counter")
  );
  params := ArrayList(AstExpr).new();
  params.push(self_param);
  body  := make_atom_expr(TokenKind.Identifier, "0");
  ret   := make_atom_expr(TokenKind.Identifier, "i32");
  rhs   := make_fn_app(params, ret, body);
  method_expr := make_define_expr("get", rhs);

  stmts := ArrayList(AstExpr).new();
  stmts.push(method_expr);
  stmts.push(make_atom_expr(TokenKind.Identifier, "unit")); // trailing unit in begin
  impl_expr := make_impl_expr("Counter", make_begin_expr(stmts));

  fns := extract_impl_fns(impl_expr, "Counter");
  assert((fns.len() == usize(1)), "one method extracted");
  match(fns.get(usize(0)),
    .None => assert(false, "method missing"),
    .Some(fd) => {
      assert((fd.name == String.from("Counter_get")), "method C name is Counter_get");
      assert((fd.ret_ty_c == String.from("int32_t")), "return type is int32_t");
      assert((fd.params.len() == usize(1)), "one param");
    }
  );
};

// ---------------------------------------------------------------------------
// Struct constructor — is_labeled_arg, all_labeled_args, is_uppercase_start,
//                      handle_struct_constructor, generate_expr integration
// ---------------------------------------------------------------------------

test "is_labeled_arg: colon infix with 2 args is labeled", {
  name_e := make_atom_expr(TokenKind.Identifier, "value");
  val_e  := make_atom_expr(TokenKind.Integer, "42");
  labeled := make_colon_expr(name_e, val_e);
  assert(is_labeled_arg(labeled), "colon infix should be labeled arg");
};

test "is_labeled_arg: plain atom is not labeled", {
  e := make_atom_expr(TokenKind.Identifier, "x");
  assert((!is_labeled_arg(e)), "atom is not a labeled arg");
};

test "is_labeled_arg: non-colon infix is not labeled", {
  lhs := make_atom_expr(TokenKind.Identifier, "a");
  rhs := make_atom_expr(TokenKind.Integer, "1");
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  plus_tok := make_token_raw(TokenKind.Operator, "+");
  e := AstExpr.FnCall(box(AstExpr.Atom(plus_tok)), args, true, plus_tok);
  assert((!is_labeled_arg(e)), "plus infix is not a labeled arg");
};

test "all_labeled_args: all labeled returns true", {
  f1 := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "x"),
    make_atom_expr(TokenKind.Integer, "1")
  );
  f2 := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "y"),
    make_atom_expr(TokenKind.Integer, "2")
  );
  args := ArrayList(AstExpr).new();
  args.push(f1);
  args.push(f2);
  assert(all_labeled_args(args), "all labeled args");
};

test "all_labeled_args: empty list returns false", {
  empty := ArrayList(AstExpr).new();
  assert((!all_labeled_args(empty)), "empty list is not all-labeled");
};

test "all_labeled_args: mixed args returns false", {
  f1 := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "x"),
    make_atom_expr(TokenKind.Integer, "1")
  );
  pos := make_atom_expr(TokenKind.Integer, "2");
  args := ArrayList(AstExpr).new();
  args.push(f1);
  args.push(pos);
  assert((!all_labeled_args(args)), "mixed args not all labeled");
};

test "is_uppercase_start: uppercase name returns true", {
  assert(is_uppercase_start(String.from("Counter")), "Counter starts uppercase");
  assert(is_uppercase_start(String.from("Point")), "Point starts uppercase");
};

test "is_uppercase_start: lowercase name returns false", {
  assert((!is_uppercase_start(String.from("add"))), "add starts lowercase");
  assert((!is_uppercase_start(String.from("foo"))), "foo starts lowercase");
};

test "is_uppercase_start: empty string returns false", {
  assert((!is_uppercase_start(String.from(""))), "empty string has no uppercase start");
};

test "handle_struct_constructor: single field emits compound literal", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;
  ind  := String.new();
  field := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "value"),
    make_atom_expr(TokenKind.Integer, "42")
  );
  args := ArrayList(AstExpr).new();
  args.push(field);
  result := handle_struct_constructor(String.from("Counter"), args, pctx, ind);
  match(result,
    .None => assert(false, "expected Some"),
    .Some(s) => assert((s == String.from("(Counter){.value = 42}")), "single field compound literal")
  );
};

test "handle_struct_constructor: two fields", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;
  ind  := String.new();
  f1 := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "x"),
    make_atom_expr(TokenKind.Integer, "3")
  );
  f2 := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "y"),
    make_atom_expr(TokenKind.Integer, "4")
  );
  args := ArrayList(AstExpr).new();
  args.push(f1);
  args.push(f2);
  result := handle_struct_constructor(String.from("Point"), args, pctx, ind);
  match(result,
    .None => assert(false, "expected Some"),
    .Some(s) => assert((s == String.from("(Point){.x = 3, .y = 4}")), "two field compound literal")
  );
};

test "generate_expr: struct constructor via generate_expr dispatch", {
  field := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "value"),
    make_atom_expr(TokenKind.Integer, "99")
  );
  args := ArrayList(AstExpr).new();
  args.push(field);
  ctor_tok := make_token_raw(TokenKind.Identifier, "MyStruct");
  expr := AstExpr.FnCall(box(AstExpr.Atom(ctor_tok)), args, false, ctor_tok);
  result := run_gen(expr);
  match(result,
    .None => assert(false, "expected Some"),
    .Some(s) => assert((s == String.from("(MyStruct){.value = 99}")), "struct ctor dispatch")
  );
};
