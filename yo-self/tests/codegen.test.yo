test("compile_module_to_c: program with continue in while loop", {
  // skip_odds :: (fn(n : i32) -> i32)({
  //   (i : i32) = i32(0); (sum : i32) = i32(0);
  //   while runtime((i < n)), {
  //     i = (i + i32(1));
  //     if(((i % i32(2)) == i32(1)), continue());
  //     sum = (sum + i);
  //   };
  //   sum;
  // });
  // main :: (fn() -> i32)(0);
  exprs := ArrayList(AstExpr).new();
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  fn_params := ArrayList(AstExpr).new();
  fn_params.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "n"), make_atom_expr(TokenKind.Identifier, "i32")));
  fn_type := make_infix_expr("->", make_fncall_expr("fn", fn_params), make_atom_expr(TokenKind.Identifier, "i32"));
  i_decl := make_typed_decl_expr(
    "i",
    "i32",
    make_fncall_expr("i32", {
      a := ArrayList(AstExpr).new();
      a.push(make_atom_expr(TokenKind.Integer, "0"));
      a
    })
  );
  sum_decl := make_typed_decl_expr(
    "sum",
    "i32",
    make_fncall_expr("i32", {
      a := ArrayList(AstExpr).new();
      a.push(make_atom_expr(TokenKind.Integer, "0"));
      a
    })
  );
  while_cond := make_runtime_cond(make_infix_expr("<", make_atom_expr(TokenKind.Identifier, "i"), make_atom_expr(TokenKind.Identifier, "n")));
  i_inc := make_assign_expr(
    make_atom_expr(TokenKind.Identifier, "i"),
    make_infix_expr(
      "+",
      make_atom_expr(TokenKind.Identifier, "i"),
      make_fncall_expr("i32", {
        a := ArrayList(AstExpr).new();
        a.push(make_atom_expr(TokenKind.Integer, "1"));
        a
      })
    )
  );
  // continue()
  cont_args := ArrayList(AstExpr).new();
  cont_call := make_fncall_expr("continue", cont_args);
  // if(((i % 2) == 1), continue())
  mod_expr := make_infix_expr(
    "%",
    make_atom_expr(TokenKind.Identifier, "i"),
    make_fncall_expr("i32", {
      a := ArrayList(AstExpr).new();
      a.push(make_atom_expr(TokenKind.Integer, "2"));
      a
    })
  );
  cmp_expr := make_infix_expr(
    "==",
    mod_expr,
    make_fncall_expr("i32", {
      a := ArrayList(AstExpr).new();
      a.push(make_atom_expr(TokenKind.Integer, "1"));
      a
    })
  );
  if_cont := make_if_expr(cmp_expr, cont_call);
  sum_inc := make_assign_expr(make_atom_expr(TokenKind.Identifier, "sum"), make_infix_expr("+", make_atom_expr(TokenKind.Identifier, "sum"), make_atom_expr(TokenKind.Identifier, "i")));
  while_stmts := ArrayList(AstExpr).new();
  while_stmts.push(i_inc);
  while_stmts.push(if_cont);
  while_stmts.push(sum_inc);
  while_body := make_begin_expr(while_stmts);
  while_expr := make_while_expr(while_cond, while_body);
  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(i_decl);
  body_stmts.push(sum_decl);
  body_stmts.push(while_expr);
  body_stmts.push(make_atom_expr(TokenKind.Identifier, "sum"));
  body := make_begin_expr(body_stmts);
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  fn_app := AstExpr.FnCall(usize(0), box(fn_type), body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "skip_odds"), fn_app));
  main_params := ArrayList(AstExpr).new();
  main_fn_type := make_infix_expr("->", make_fncall_expr("fn", main_params), make_atom_expr(TokenKind.Identifier, "i32"));
  main_body_args := ArrayList(AstExpr).new();
  main_body_args.push(make_atom_expr(TokenKind.Integer, "0"));
  main_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app));
  result := compile_module_to_c(exprs, "continue_mod", "main");
  match(
    result,
    .None => assert(false, "continue program should compile"),
    .Some(c_code) => {
      assert(c_code.contains(String.from("skip_odds")), "should have skip_odds fn");
      assert(c_code.contains(String.from("while")), "should have while loop");
      assert(c_code.contains(String.from("continue")), "should have continue statement");
      assert(c_code.contains(String.from("int main")), "should have main");
    }
  );
});
test("compile_module_to_c: program with nested if/else", {
  // classify :: (fn(x : i32) -> i32)(
  //   if((x > 0), i32(1), if((x < 0), i32(-(1)), i32(0)))
  // );
  // main :: (fn() -> i32)(0);
  exprs := ArrayList(AstExpr).new();
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  fn_params := ArrayList(AstExpr).new();
  fn_params.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "i32")));
  fn_type := make_infix_expr("->", make_fncall_expr("fn", fn_params), make_atom_expr(TokenKind.Identifier, "i32"));
  // Inner if: if((x < 0), i32(-(1)), i32(0))
  inner_cond := make_infix_expr("<", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Integer, "0"));
  neg_one_args := ArrayList(AstExpr).new();
  neg_one_args.push(make_unary_expr("-", make_atom_expr(TokenKind.Integer, "1")));
  neg_one := make_fncall_expr("i32", neg_one_args);
  zero_args := ArrayList(AstExpr).new();
  zero_args.push(make_atom_expr(TokenKind.Integer, "0"));
  zero_cast := make_fncall_expr("i32", zero_args);
  inner_if := make_if_else_expr(inner_cond, neg_one, zero_cast);
  // Outer if: if((x > 0), i32(1), inner_if)
  outer_cond := make_infix_expr(">", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Integer, "0"));
  one_args := ArrayList(AstExpr).new();
  one_args.push(make_atom_expr(TokenKind.Integer, "1"));
  one_cast := make_fncall_expr("i32", one_args);
  outer_if := make_if_else_expr(outer_cond, one_cast, inner_if);
  body_args := ArrayList(AstExpr).new();
  body_args.push(outer_if);
  fn_app := AstExpr.FnCall(usize(0), box(fn_type), body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "classify"), fn_app));
  main_params := ArrayList(AstExpr).new();
  main_fn_type := make_infix_expr("->", make_fncall_expr("fn", main_params), make_atom_expr(TokenKind.Identifier, "i32"));
  main_body_args := ArrayList(AstExpr).new();
  main_body_args.push(make_atom_expr(TokenKind.Integer, "0"));
  main_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_body_args, false, fn_tok);
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_app));
  result := compile_module_to_c(exprs, "nested_if_mod", "main");
  match(
    result,
    .None => assert(false, "nested if program should compile"),
    .Some(c_code) => {
      assert(c_code.contains(String.from("classify")), "should have classify fn");
      assert(c_code.contains(String.from("int main")), "should have main");
    }
  );
});
// ===========================================================================
// Phase 5s — More codegen integration tests: for loop, struct ctor, method call
// ===========================================================================
test("generate_expr: for loop emits iterator-style while loop", {
  // for(collection, (item) => { body })
  // Codegen expects 2-arg form: for(iter_expr, handler_lambda)
  // With a plain identifier as iter_expr, falls back to while(1) pattern
  // Note: for loop emits code to the emitter (side effect) and returns "0"
  for_args := ArrayList(AstExpr).new();
  for_args.push(make_atom_expr(TokenKind.Identifier, "collection"));
  // Build (item) => { item; } — infix => with [item_ident, body_begin]
  lambda_args := ArrayList(AstExpr).new();
  lambda_args.push(make_atom_expr(TokenKind.Identifier, "item"));
  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(make_atom_expr(TokenKind.Identifier, "item"));
  lambda_args.push(make_begin_expr(body_stmts));
  lambda_tok := make_token_raw(TokenKind.Operator, "=>");
  lambda_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), lambda_tok)), lambda_args, true, lambda_tok);
  for_args.push(lambda_expr);
  for_expr := make_fncall_expr("for", for_args);
  ctx := run_gen_with_ctx(for_expr);
  output := ctx.emitter.print();
  assert(output.contains(String.from("while")), "for loop fallback should emit 'while'");
  assert(output.contains(String.from("collection")), "should reference 'collection'");
});
test("generate_expr: method call emits function call with receiver", {
  // obj.push(42) → TypeName_push(obj, 42) or similar
  method_args := ArrayList(AstExpr).new();
  method_args.push(make_atom_expr(TokenKind.Integer, "42"));
  method_call := make_method_call_expr(
    make_atom_expr(TokenKind.Identifier, "obj"),
    "push",
    method_args
  );
  result := run_gen(method_call);
  match(
    result,
    .None => assert(false, "method call gen returned None"),
    .Some(code) => {
      assert(code.contains(String.from("push")), "should contain method name 'push'");
      assert(code.contains(String.from("obj")), "should contain receiver 'obj'");
    }
  );
});
test("generate_expr: dot access on identifier emits field access", {
  // point.x → point.x or point->x
  dot := make_dot_expr(
    make_atom_expr(TokenKind.Identifier, "point"),
    make_atom_expr(TokenKind.Identifier, "x")
