// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5af series: ArrayVal.get/set/remove,
/// StrLit.as_bytes(), IntLit.min/max, and complex pipeline combinations.
///
/// Phases covered:
///   5afa — ArrayVal.get(idx) returns Option
///   5afb — ArrayVal.set(idx, val) and ArrayVal.remove(idx)
///   5afc — StrLit.as_bytes() and IntLit.min/max
///   5afd — min/max via fold, get in loops
///   5afe — Complex state-mutation patterns using set/remove
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5afa — ArrayVal.get(idx) returns Option in source code
// ---------------------------------------------------------------------------
test("Phase 5afa: get(0) on non-empty array returns Some(first)", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(10), i32(20), i32(30)];\nresult := arr.get(usize(0)).unwrap();\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "10", "get0=10"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5afa: get(idx) out of bounds returns None", {
  env := empty_env();
