test("Phase 5afd: as_bytes then fold sum of byte values", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := \"ABC\";\nbytes := s.as_bytes();\ntotal := bytes.fold(i32(0), (fn(acc : i32, b : i32) -> i32)((acc + b)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        // A=65, B=66, C=67, sum = 198
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "198", "sum=198"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5afd: as_bytes then count bytes in range 65-90 (uppercase ASCII)", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := \"Hello World\";\nbytes := s.as_bytes();\nuppercase_count := bytes.filter((fn(b : i32) -> bool)(((b >= i32(65)) && (b <= i32(90))))).len();\nexport(uppercase_count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        // H=72, W=87 — 2 uppercase letters
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "upper=2"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
// ---------------------------------------------------------------------------
// Phase 5afe — Complex state-mutation patterns using set/remove
// ---------------------------------------------------------------------------
test("Phase 5afe: swap two elements using set twice", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(1), i32(2), i32(3), i32(4)];\na := arr.get(usize(0)).unwrap();\nb := arr.get(usize(3)).unwrap();\narr2 := arr.set(usize(0), b);\narr3 := arr2.set(usize(3), a);\nexport(arr3.get(usize(0)).unwrap());\nexport(arr3.get(usize(3)).unwrap());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        // swap arr[0]=1 and arr[3]=4 → arr3[0]=4, arr3[3]=1
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "swapped0=4"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "swapped3=1"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5afe: remove first two elements — check remaining", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(10), i32(20), i32(30), i32(40), i32(50)];\narr2 := arr.remove(usize(0));\narr3 := arr2.remove(usize(0));\nexport(arr3.len());\nexport(arr3.get(usize(0)).unwrap());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        // arr3 = [30, 40, 50]
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "len=3"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "30", "first=30"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5afe: sequential set operations — update multiple indices", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(0), i32(0), i32(0)];\narr2 := arr.set(usize(0), i32(10));\narr3 := arr2.set(usize(1), i32(20));\narr4 := arr3.set(usize(2), i32(30));\nsum := arr4.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(sum);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        // arr4 = [10, 20, 30], sum = 60
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "60", "sum=60"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5afe: min and max of absolute differences between adjacent elements", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(3), i32(7), i32(2), i32(9), i32(5)];\n(min_diff : i32) = i32(9999);\n(max_diff : i32) = i32(0);\n(i : usize) = usize(0);\nwhile(runtime(i < usize(4)), {\n  a := arr.get(i).unwrap();\n  b := arr.get((i + usize(1))).unwrap();\n  diff := (a - b).abs();\n  min_diff = min_diff.min(diff);\n  max_diff = max_diff.max(diff);\n  i = (i + usize(1));\n});\nexport(min_diff);\nexport(max_diff);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        // diffs: |3-7|=4, |7-2|=5, |2-9|=7, |9-5|=4 → min=4, max=7
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "min_diff=4"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "7", "max_diff=7"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
      },
      _ => assert(false, "m")
    )
  );
});
