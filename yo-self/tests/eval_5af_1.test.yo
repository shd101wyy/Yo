test("Phase 5afc: as_bytes() of \"ABC\" returns ASCII codes 65 66 67", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := \"ABC\";\nbytes := s.as_bytes();\nexport(bytes.get(usize(0)).unwrap());\nexport(bytes.get(usize(1)).unwrap());\nexport(bytes.get(usize(2)).unwrap());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "65", "A=65"), _ => assert(false, "t0")),
          .None => assert(false, "v0")
        );
        match(
          v.get(usize(1)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "66", "B=66"), _ => assert(false, "t1")),
          .None => assert(false, "v1")
        );
        match(
          v.get(usize(2)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "67", "C=67"), _ => assert(false, "t2")),
          .None => assert(false, "v2")
        );
      },
      _ => assert(false, "m")
    )
  );
});
