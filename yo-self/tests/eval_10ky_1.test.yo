  src := "arr := [i32(4), i32(4), i32(1), i32(9), i32(18), i32(9), i32(13), i32(10)];\ncnt := i32(0); i := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap(); cnt = cond((v > i32(8)) => (cnt + i32(1)), true => cnt); i = (i + i32(1));\n});\nr := cnt;\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
