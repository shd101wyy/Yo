// ---------------------------------------------------------------------------
// Phase 5awd — Higher-order composition and closure patterns
// ---------------------------------------------------------------------------
test("Phase 5awd: compose double and add-one via sequential calls", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "double := (fn(x : i32) -> i32)((x * i32(2)));\nadd_one := (fn(x : i32) -> i32)((x + i32(1)));\ninput := i32(5);\nresult := double(add_one(input));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "12", "12"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5awd: map with complex predicate then fold", {
