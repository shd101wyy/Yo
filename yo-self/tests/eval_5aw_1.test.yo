      }
    )
  );
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5)];\nclipped := arr.map((fn(x : i32) -> i32)(cond((x > i32(3)) => i32(3), true => x)));\ntotal := clipped.fold(i32(0), (fn(a : i32, x : i32) -> i32)((a + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "12", "12"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

