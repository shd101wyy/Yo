// ---------------------------------------------------------------------------
// Phase 5awe — Grand combo programs
// ---------------------------------------------------------------------------
test("Phase 5awe: concat two arrays filter evens and sum them", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "a := [i32(1), i32(2), i32(3)];\nb := [i32(4), i32(5), i32(6), i32(7), i32(8)];\ncombined := a.concat(b);\nevens := combined.filter((fn(x : i32) -> bool)(((x % i32(2)) == i32(0))));\nsum := evens.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(sum);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "20", "20"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

