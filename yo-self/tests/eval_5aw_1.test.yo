// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5aw series: complex algorithmic programs,
/// multi-step pipelines, and grand combos exercising many eval features together.
///
/// Phases covered:
///   5awa — Numeric algorithms via while loop (GCD, power, Fibonacci, digit sum)
///   5awb — String processing pipelines (split/join/transform)
///   5awc — Struct access and struct-array HOF patterns
///   5awd — Higher-order composition and closure patterns
///   5awe — Grand combo programs combining multiple subsystems
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5awa — Numeric algorithms via while loop
// ---------------------------------------------------------------------------
test("Phase 5awa: GCD of 12 and 8 via Euclidean algorithm is 4", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "(a : i32) = i32(12);\n(b : i32) = i32(8);\nwhile((b != i32(0)), {\ntemp := b;\nb = (a % b);\na = temp;\n});\nexport(a);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "4", "4"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5awa: 2 to the power of 8 via repeated doubling is 256", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "(result : i32) = i32(1);\n(exp : i32) = i32(8);\nwhile((exp > i32(0)), {\nresult = (result * i32(2));\nexp = (exp - i32(1));\n});\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "256", "256"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5awa: sum of digits of 1234 is 10", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "(n : i32) = i32(1234);\n(total : i32) = i32(0);\nwhile((n > i32(0)), {\ntotal = (total + (n % i32(10)));\nn = (n / i32(10));\n});\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
