/// Tests for the literal type-of pass (Phase 2c).
open(import("std/fmt"));
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TokenKind, Token } :: import("../token.yo");
{ AstExpr } :: import("../expr.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ type_value_tag, t_bool, t_u32, t_comptime_int, t_comptime_float, t_comptime_string } :: import("../types/creators.yo");
{ TypeTag } :: import("../types/tags.yo");
{ type_of_literal } :: import("../evaluator/type_of.yo");
{ assert, panic } :: import("std/assert");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
make_token :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
make_atom :: (fn(kind : TokenKind, value : str) -> AstExpr)(
  .Atom(usize(0), make_token(kind, value))
);
make_fn_call_no_args :: (fn(name : str) -> AstExpr)(
  .FnCall(
    usize(0),
    .Atom(usize(0), make_token(TokenKind.Identifier, name)),
    ArrayList(AstExpr).new(),
    false,
    make_token(TokenKind.Identifier, name)
  )
);
check_tag :: (fn(result : Option(TypeValue), expected : TypeTag, label : str) -> unit)(
  match(
    result,
    .Some(t) => {
      got := type_value_tag(t);
      if(got == expected, (), {
        println(`FAIL [${label}]: unexpected tag`);
        assert(false, label);
      });
    },
    .None => {
      println(`FAIL [${label}]: expected Some, got None`);
      assert(false, label);
    }
  )
);
check_none :: (fn(result : Option(TypeValue), label : str) -> unit)(
  match(
    result,
    .Some(_) => {
      println(`FAIL [${label}]: expected None, got Some`);
      assert(false, label);
    },
    .None => ()
  )
);
// ---------------------------------------------------------------------------
// Bool literal
// ---------------------------------------------------------------------------
test("type_of_literal: bool true", {
  e := make_atom(TokenKind.Bool, "true");
  check_tag(type_of_literal(e), TypeTag.TBool, "bool true");
});
test("type_of_literal: bool false", {
  e := make_atom(TokenKind.Bool, "false");
  check_tag(type_of_literal(e), TypeTag.TBool, "bool false");
});
// ---------------------------------------------------------------------------
// Integer literal
// ---------------------------------------------------------------------------
test("type_of_literal: integer", {
  e := make_atom(TokenKind.Integer, "42");
  check_tag(type_of_literal(e), TypeTag.TComptimeInt, "integer 42");
});
test("type_of_literal: zero integer", {
  e := make_atom(TokenKind.Integer, "0");
  check_tag(type_of_literal(e), TypeTag.TComptimeInt, "integer 0");
});
// ---------------------------------------------------------------------------
// Float literal
// ---------------------------------------------------------------------------
test("type_of_literal: float", {
  e := make_atom(TokenKind.Float, "3.14");
  check_tag(type_of_literal(e), TypeTag.TComptimeFloat, "float 3.14");
});
// ---------------------------------------------------------------------------
// String literal
// ---------------------------------------------------------------------------
test("type_of_literal: string literal", {
  e := make_atom(TokenKind.StringLit, "\"hello\"");
  check_tag(type_of_literal(e), TypeTag.TComptimeString, "string literal");
});
// ---------------------------------------------------------------------------
// Template string
// ---------------------------------------------------------------------------
test("type_of_literal: template string", {
  e := make_atom(TokenKind.TemplateString, "`hello`");
  check_tag(type_of_literal(e), TypeTag.TComptimeString, "template string");
});
// ---------------------------------------------------------------------------
// Char literal
// ---------------------------------------------------------------------------
test("type_of_literal: char literal", {
  e := make_atom(TokenKind.CharLit, "'a'");
  check_tag(type_of_literal(e), TypeTag.TU32, "char literal");
});
// ---------------------------------------------------------------------------
// Non-literal atoms → None
// ---------------------------------------------------------------------------
test("type_of_literal: identifier → None", {
  e := make_atom(TokenKind.Identifier, "foo");
  check_none(type_of_literal(e), "identifier should be None");
});
test("type_of_literal: operator → None", {
  e := make_atom(TokenKind.Operator, "+");
  check_none(type_of_literal(e), "operator should be None");
});
test("type_of_literal: semicolon → None", {
  e := make_atom(TokenKind.Semicolon, ";");
  check_none(type_of_literal(e), "semicolon should be None");
});
// ---------------------------------------------------------------------------
// FnCall expressions → None
// ---------------------------------------------------------------------------
test("type_of_literal: fn call → None", {
  e := make_fn_call_no_args("foo");
  check_none(type_of_literal(e), "fn call should be None");
});
