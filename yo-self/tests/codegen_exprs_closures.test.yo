/// Tests for yo-self/codegen/exprs/closures.yo.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ ExprId } :: import("../expr/expr.yo");
{
  ExprInfo,
  ExprInfoTable,
  expr_info_table_new,
  expr_info_table_set,
  new_expr_info
} :: import("../expr/expr_info.yo");
{ Environment, add_variable_to_env } :: import("../env/env.yo");
{ EvalValue } :: import("../evaluator/value.yo");
{
  TypeValue,
  t_i32,
  t_func_simple,
  t_dyn_simple,
  t_fn_trait_simple,
  t_unit
} :: import("../types/type.yo");
{ Token, TokenKind } :: import("../lexer/token.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{
  check_variable_is_closure_captured,
  is_closure_construction,
  resolve_some_type_to_concrete
} :: import("../codegen/exprs/closures.yo");
placeholder_token :: (fn() -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(""),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
test("check_variable_is_closure_captured: missing variable returns false", {
  env := Environment.new(String.from("test"));
  assert(
    !(check_variable_is_closure_captured(String.from("never_defined"), env, usize(0))),
    "missing variable cannot be captured"
  );
});
test("check_variable_is_closure_captured: outer-frame var captured when capture level matches", {
  // env starts with one frame (frame_level == 0). Add `x` there.
  env := Environment.new(String.from("test"));
  _r := add_variable_to_env(
    &(env),
    String.from("x"),
    t_i32(),
    Option(EvalValue).None,
    false,
    false,
    false,
    false,
    placeholder_token()
  );
  // capture_frame_level = 0 ⇒ x's frame_level (0) <= 0 ⇒ captured.
  assert(
    check_variable_is_closure_captured(String.from("x"), env, usize(0)),
    "x at outer frame is captured when capture_frame_level >= 0"
  );
});
test("check_variable_is_closure_captured: inner-frame var is local, not captured", {
  // Outer frame is frame_level 0. Push an inner frame; new vars there
  // get frame_level 1. capture_frame_level = 0 ⇒ inner var's
  // frame_level (1) > 0 ⇒ NOT captured (it's a local).
  env := Environment.new(String.from("test"));
  _push_idx := (&(env)).push_frame(true);
  _r := add_variable_to_env(
    &(env),
    String.from("inner"),
    t_i32(),
    Option(EvalValue).None,
    false,
    false,
    false,
    false,
    placeholder_token()
  );
  assert(
    !(check_variable_is_closure_captured(String.from("inner"), env, usize(0))),
    "inner-frame var is local, not captured by outer closure"
  );
});
/// Build a new ExprInfo with the given `ty` and (optional)
/// closure_function_value, leaving all other slots at their defaults.
mk_info :: (
  fn(env : Environment, ty : TypeValue, cv : Option(EvalValue)) -> ExprInfo
)({
  info := new_expr_info(env, ty);
  info.closure_function_value = cv;
  info
});
test("is_closure_construction: no expr info → false", {
  env := Environment.new(String.from("test"));
  ctx := CodegenContext.new();
  // Without an expr_info_table or matching entry, lookup misses.
  assert(
    !(is_closure_construction(usize(99), &(ctx))),
    "missing info → false"
  );
});
test("is_closure_construction: missing closure_function_value → false", {
  env := Environment.new(String.from("test"));
  fn_trait := t_fn_trait_simple(
    String.from("Fn"),
    ArrayList(TypeValue).new(),
    t_i32()
  );
  required := ArrayList(TypeValue).new();
  required.push(fn_trait);
  fn_ty := t_dyn_simple(required);
  info := mk_info(env, fn_ty, Option(EvalValue).None);
  table := expr_info_table_new();
  expr_info_table_set(table, usize(10), info);
  ctx := CodegenContext.new();
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  // closure_function_value is None → not a closure construction.
  assert(
    !(is_closure_construction(usize(10), &(ctx))),
    "no closure value → false"
  );
});
test("is_closure_construction: Fn trait + closure value → true", {
  env := Environment.new(String.from("test"));
  // Construct a `dyn(Fn() -> i32)` type — the Fn-trait check inspects
  // DynT.required_trait_types for `FnTraitT`.
  fn_trait := t_fn_trait_simple(
    String.from("Fn"),
    ArrayList(TypeValue).new(),
    t_i32()
  );
  required := ArrayList(TypeValue).new();
  required.push(fn_trait);
  fn_ty := t_dyn_simple(required);
  cv := Option(EvalValue).Some(EvalValue.UnitVal);
  info := mk_info(env, fn_ty, cv);
  table := expr_info_table_new();
  expr_info_table_set(table, usize(11), info);
  ctx := CodegenContext.new();
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  assert(
    is_closure_construction(usize(11), &(ctx)),
    "Fn type + closure_function_value → true"
  );
});
test("is_closure_construction: non-Fn type + closure value → false", {
  env := Environment.new(String.from("test"));
  cv := Option(EvalValue).Some(EvalValue.UnitVal);
  // i32 doesn't implement Fn, so even with a closure_function_value
  // the check must return false.
  info := mk_info(env, t_i32(), cv);
  table := expr_info_table_new();
  expr_info_table_set(table, usize(12), info);
  ctx := CodegenContext.new();
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  assert(
    !(is_closure_construction(usize(12), &(ctx))),
    "non-Fn type → false"
  );
});
test("resolve_some_type_to_concrete: stub returns input unchanged", {
  // yo-self's SomeT does not yet carry resolved_concrete_type, so
  // this helper is a no-op until that field is added.
  input_ty := t_i32();
  match(
    resolve_some_type_to_concrete(input_ty),
    .Int({ bits, signed }) => {
      assert(bits == u8(32), "i32 bits");
      assert(signed, "i32 signed");
    },
    _ => assert(false, "expected Int variant returned unchanged")
  );
});
