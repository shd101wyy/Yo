/// Tests for yo-self/evaluator/exprs/open.yo — Phase 2t
///
/// Covers `evaluate_open` — the production handler for `open(module)`.
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr, ast_expr_id, BK_OPEN } :: import("../expr.yo");
{
  ExprInfo,
  new_expr_info,
  expr_info_table_get,
  expr_info_table_set,
  expr_info_runtime_destructurings,
  RuntimeDestructuring
} :: import("../expr_info.yo");
{ Environment } :: import("../env.yo");
{ EvalContext, eval_context_new } :: import("../evaluator/context.yo");
{ EvalValue } :: import("../value.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ t_i32, t_unit } :: import("../types/creators.yo");
{ set_evaluate_expression_fn, set_evaluate_expression_raw_fn, evaluate_expression }
:: import("../evaluator/exprs/expr.yo");
{ evaluate_open } :: import("../evaluator/exprs/open.yo");
{ Exception } :: import("std/error");
{ assert, panic } :: import("std/assert");
mk_token :: (fn(value : str) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);
// Build an `open(module_name)` FnCall.
mk_open_call :: (fn(arg_id : usize, arg_value : str, call_id : usize) -> AstExpr)({
  arg_atom := AstExpr.Atom(arg_id, mk_token(arg_value));
  callee := AstExpr.Atom(call_id + usize(1000), mk_token(BK_OPEN));
  args := ArrayList(AstExpr).new();
  args.push(arg_atom);
  AstExpr.FnCall(call_id, callee, args, false, mk_token(BK_OPEN))
});
// Stub evaluator: pretends every input expression evaluates to a ModuleVal
// with two fields `a : i32 = 1` and `b : i32 = 2`.
stub_evaluate_module :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext
  ) -> AstExpr
)({
  names := ArrayList(String).new();
  names.push(String.from("a"));
  names.push(String.from("b"));
  vals := ArrayList(EvalValue).new();
  vals.push(EvalValue.IntLit(String.from("1")));
  vals.push(EvalValue.IntLit(String.from("2")));
  // Modules are StructVals whose type name carries the source-namespace marker.
  module_val := EvalValue.StructVal(String.from("source_namespace_test"), names, vals);
  info := new_expr_info(env, t_i32());
  info.value =.Some(module_val);
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
/// Raw-seam variant of the stub: same behavior, ignores the custom handler.
stub_evaluate_module_raw :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext,
    exn : Exception
  ) -> AstExpr
)(
  stub_evaluate_module(expr, env, ctx)
);
test("evaluate_open: module — adds each field as a comptime variable", {
  set_evaluate_expression_fn(stub_evaluate_module);
  set_evaluate_expression_raw_fn(stub_evaluate_module_raw);
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  ctx := eval_context_new(String.from("/std"), String.from("test"));
  env := Environment.new(String.from("test"));
  call := mk_open_call(usize(7), "m", usize(42));
  result := evaluate_open(call, env, ctx, exn);
  // Side-effect: ExprInfo for the open call is set with type unit + UnitVal.
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(result));
  assert(match(info_opt,.Some(_) => true,.None => false), "open did not record an ExprInfo");
  info := match(
    info_opt,
    .Some(i) => i,
    .None => new_expr_info(env, t_unit())
  );
  // Both `a` and `b` should now be bound in the resulting env.
  assert(info.env.contains(String.from("a")), "a not bound after open");
  assert(info.env.contains(String.from("b")), "b not bound after open");
  // Module open does not record runtime_destructurings.
  match(
    expr_info_runtime_destructurings(info),
    .Some(_) => assert(false, "module open should not set runtime_destructurings"),
    .None => ()
  );
  // Value should be UnitVal.
  match(
    info.value,
    .Some(v) => match(
      v,
      .UnitVal => (),
      _ => assert(false, "expected UnitVal")
    ),
    .None => assert(false, "expected Some value")
  );
});
