//! Tests for yo-self/evaluator/async/await_analysis_types.yo
//! Mirrors src/evaluator/async/await-analysis-types.ts
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TypeValue } :: import("../types/definitions.yo");
{ t_unit } :: import("../types/creators.yo");
{
  SuspensionPoint,
  SuspensionCapturedVariable
} :: import("../evaluator/shared/suspension_analysis_types.yo");
{ AstExpr } :: import("../expr.yo");
{ TokenKind, Token } :: import("../token.yo");
{ assert, panic } :: import("std/assert");
{
  CapturedVariableKind,
  AwaitPoint,
  CapturedVariable,
  AwaitAnalysisResult,
  await_analysis_result_empty
} :: import("../evaluator/async/await_analysis_types.yo");
make_token :: (fn(v : str) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(v),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
make_sp :: (fn(idx : usize) -> SuspensionPoint)(
  SuspensionPoint(
    index : idx,
    expr : AstExpr.Atom(usize(0), make_token("await_expr")),
    target_variable_id : Option(String).None,
    is_inside_cond : Option(bool).None,
    is_inside_while : Option(bool).None,
    while_nesting_depth : Option(usize).None,
    cond_branch_source_index : Option(usize).None,
    needs_own_cond_branch_field : Option(bool).None,
    enclosing_while_expr : Option(AstExpr).None
  )
);
test("await_analysis_result_empty has no awaits", {
  r := await_analysis_result_empty();
  assert(!(r.has_awaits), "has_awaits false");
  assert(r.await_points.len() == usize(0), "no await points");
  assert(r.captured_variables.len() == usize(0), "no captured vars");
});
test("AwaitPoint base fields accessible", {
  ap := AwaitPoint(
    base : make_sp(usize(3)),
    result_type : t_unit(),
    future_type : Option(TypeValue).None,
    future_variable_id : Option(String).None
  );
  assert(ap.base.index == usize(3), "base index");
  has_ftype := match(ap.future_type,.Some(_) => true,.None => false);
  assert(!(has_ftype), "no future_type");
});
test("AwaitPoint future_type can be set", {
  ap := AwaitPoint(
    base : make_sp(usize(0)),
    result_type : t_unit(),
    future_type : Option(TypeValue).Some(t_unit()),
    future_variable_id : Option(String).Some(String.from("fv0"))
  );
  has_ftype := match(ap.future_type,.Some(_) => true,.None => false);
  assert(has_ftype, "has future_type");
  fvar := match(ap.future_variable_id,.Some(id) => id,.None => String.from(""));
  assert(fvar == "fv0", "future_variable_id");
});
test("AwaitPoint target_variable_id from parent assign", {
  sp := SuspensionPoint(
    index : usize(0),
    expr : AstExpr.Atom(usize(0), make_token("await_call")),
    target_variable_id : Option(String).Some(String.from("var_0")),
    is_inside_cond : Option(bool).None,
    is_inside_while : Option(bool).None,
    while_nesting_depth : Option(usize).None,
    cond_branch_source_index : Option(usize).None,
    needs_own_cond_branch_field : Option(bool).None,
    enclosing_while_expr : Option(AstExpr).None
  );
  ap := AwaitPoint(
    base : sp,
    result_type : t_unit(),
    future_type : Option(TypeValue).None,
    future_variable_id : Option(String).None
  );
  target := match(ap.base.target_variable_id,.Some(id) => id,.None => String.from(""));
  assert(target == "var_0", "target_variable_id");
});
test("CapturedVariableKind Local and Outer variants", {
  local_kind := CapturedVariableKind.Local;
  outer_kind := CapturedVariableKind.Outer;
  is_local := match(local_kind,.Local => true,.Outer => false);
  is_outer := match(outer_kind,.Local => false,.Outer => true);
  assert(is_local, "Local variant");
  assert(is_outer, "Outer variant");
});
test("CapturedVariable base fields and kind", {
  cv := CapturedVariable(
    base : SuspensionCapturedVariable(
      id : String.from("v0"),
      name : String.from("x"),
      ty : t_unit(),
      is_owning_the_same_rc_value_as : Option(Box(SuspensionCapturedVariable)).None,
      decl_site : String.from("")
    ),
    kind : CapturedVariableKind.Local,
    is_owning_the_same_rc_value_as : Option(Box(CapturedVariable)).None
  );
  assert(cv.base.id == "v0", "id");
  assert(cv.base.name == "x", "name");
  is_local := match(cv.kind,.Local => true,.Outer => false);
  assert(is_local, "kind Local");
});
test("CapturedVariable Outer kind for captured-from-outer-scope variable", {
  cv := CapturedVariable(
    base : SuspensionCapturedVariable(
      id : String.from("outer_v"),
      name : String.from("captured"),
      ty : t_unit(),
      is_owning_the_same_rc_value_as : Option(Box(SuspensionCapturedVariable)).None,
      decl_site : String.from("")
    ),
    kind : CapturedVariableKind.Outer,
    is_owning_the_same_rc_value_as : Option(Box(CapturedVariable)).None
  );
  is_outer := match(cv.kind,.Local => false,.Outer => true);
  assert(is_outer, "kind Outer");
});
test("CapturedVariable self-referential field (Box(Self))", {
  inner := Box(CapturedVariable)(
    CapturedVariable(
      base : SuspensionCapturedVariable(
        id : String.from("v1"),
        name : String.from("temp"),
        ty : t_unit(),
        is_owning_the_same_rc_value_as : Option(Box(SuspensionCapturedVariable)).None,
        decl_site : String.from("")
      ),
      kind : CapturedVariableKind.Local,
      is_owning_the_same_rc_value_as : Option(Box(CapturedVariable)).None
    )
  );
  outer := CapturedVariable(
    base : SuspensionCapturedVariable(
      id : String.from("v2"),
      name : String.from("owner"),
      ty : t_unit(),
      is_owning_the_same_rc_value_as : Option(Box(SuspensionCapturedVariable)).None,
      decl_site : String.from("")
    ),
    kind : CapturedVariableKind.Local,
    is_owning_the_same_rc_value_as : Option(Box(CapturedVariable)).Some(inner)
  );
  has_alias := match(outer.is_owning_the_same_rc_value_as,.Some(_) => true,.None => false);
  assert(has_alias, "outer has alias");
});
test("AwaitAnalysisResult can hold await points", {
  r := await_analysis_result_empty();
  ap := AwaitPoint(
    base : make_sp(usize(0)),
    result_type : t_unit(),
    future_type : Option(TypeValue).None,
    future_variable_id : Option(String).None
  );
  r.await_points.push(ap);
  r.has_awaits = true;
  assert(r.await_points.len() == usize(1), "one await point");
  assert(r.has_awaits, "has_awaits true");
});
test("AwaitAnalysisResult variable_id_remapping", {
  r := await_analysis_result_empty();
  r.variable_id_remapping.set(String.from("ssa_v1"), String.from("orig_v0"));
  got := r.variable_id_remapping.get(String.from("ssa_v1"));
  result := match(got,.Some(v) => v,.None => String.from(""));
  assert(result == "orig_v0", "remapping lookup");
});
