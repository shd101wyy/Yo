test("Phase 5bmc: while compute 3 to the power of 6", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 3^6=729
  src := "result := i32(1);\nbase := i32(3);\ni := i32(0);\nwhile((i < i32(6)), {\nresult = (result * base);\ni = (i + i32(1));\n});\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
