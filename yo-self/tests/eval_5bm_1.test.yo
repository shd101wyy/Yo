test("Phase 5bmb: dot product of two arrays", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");

      }
    )
  );
  // a=[1,2,3,4] b=[4,3,2,1] → dot=4+6+6+4=20
  src := "a := [i32(1), i32(2), i32(3), i32(4)];\nb := [i32(4), i32(3), i32(2), i32(1)];\npairs := a.zip(b);\ndot := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)((acc + (p.0 * p.1))));\nexport(dot);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "20", "20"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
