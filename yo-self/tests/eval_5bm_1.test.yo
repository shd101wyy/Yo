      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [1,2,3,4,5,6] even-indexed *2, odd-indexed *3: 1*2+2*3+3*2+4*3+5*2+6*3=2+6+6+12+10+18=54
  src := "arr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6)];\ntotal := i32(0);\ni := i32(0);\nwhile((i < i32(6)), {\nv := arr.get(usize(i));\ntotal = match(v, .Some(x) => {\nmult := cond(((i % i32(2)) == i32(0)) => i32(2), true => i32(3));\n(total + (x * mult))\n}, .None => total);\ni = (i + i32(1));\n});\nexport(total);\n";
