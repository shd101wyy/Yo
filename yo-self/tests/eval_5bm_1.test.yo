test("Phase 5bme: find first perfect square greater than 50", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 64 = 8^2 is the first perfect square > 50
  src := "n := i32(51);\nfound := i32(0);\nwhile((found == i32(0)), {\nsq_root := i32(1);\nwhile(((sq_root * sq_root) < n), {\nsq_root = (sq_root + i32(1));\n});\nfound = cond(((sq_root * sq_root) == n) => n, true => i32(0));\nn = (n + i32(1));\n});\nexport(found);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "64", "64"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bme: sum of consecutive absolute differences", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // [3,7,2,9,1,5] diffs=|4|+|5|+|7|+|8|+|4|=28
  src := "arr := [i32(3), i32(7), i32(2), i32(9), i32(1), i32(5)];\ntotal := i32(0);\ni := i32(1);\nwhile((i < i32(6)), {\nprev := arr.get(usize(i - i32(1)));\ncurr := arr.get(usize(i));\ntotal = match(prev, .Some(p) => match(curr, .Some(c) => {\nd := (c - p);\nabs_d := cond((d < i32(0)) => (i32(0) - d), true => d);\n(total + abs_d)\n}, .None => total), .None => total);\ni = (i + i32(1));\n});\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "28", "28"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bme: count multiples of 7 up to 50", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 7,14,21,28,35,42,49 → count=7
  src := "count := i32(0);\ni := i32(1);\nwhile((i <= i32(50)), {\ncount = cond(((i % i32(7)) == i32(0)) => (count + i32(1)), true => count);\ni = (i + i32(1));\n});\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "7", "7"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bme: grand combo — sum squares + divisors count + power", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // sum squares [1..4]=1+4+9+16=30; divisors(15)=4 (1,3,5,15); 2^4=16; total=30+4+16=50
  src := "arr := [i32(1), i32(2), i32(3), i32(4)];\nsq_sum := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + (x * x))));\nn := i32(15);\nd_count := i32(0);\nj := i32(1);\nwhile((j <= n), {\nd_count = cond(((n % j) == i32(0)) => (d_count + i32(1)), true => d_count);\nj = (j + i32(1));\n});\npow := i32(1);\nk := i32(0);\nwhile((k < i32(4)), {\npow = (pow * i32(2));\nk = (k + i32(1));\n});\ntotal := ((sq_sum + d_count) + pow);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "50", "50"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
