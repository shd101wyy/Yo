test("Phase 5bmc: while countdown multiplying by 2", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // start=10; each iter: if even halve, else multiply by 2; 5 iters: 10→5→10→5→10→5=5
  src := "n := i32(10);\ni := i32(0);\nwhile((i < i32(5)), {\nn = cond(((n % i32(2)) == i32(0)) => (n / i32(2)), true => (n * i32(2)));\ni = (i + i32(1));\n});\nexport(n);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "5"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
