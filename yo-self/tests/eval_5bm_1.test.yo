          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "54", "54"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bmd: dot product + proper-divisors-sum grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // dot([1,2,3],[3,2,1])=3+4+3=10; proper_divs(10)=1+2+5=8; total=10+8=18
  src := "a := [i32(1), i32(2), i32(3)];\nb := [i32(3), i32(2), i32(1)];\npairs := a.zip(b);\ndot := pairs.fold(i32(0), (fn(acc : i32, p : (i32, i32)) -> i32)((acc + (p.0 * p.1))));\npdivs := i32(0);\nj := i32(1);\nwhile((j < dot), {\npdivs = cond(((dot % j) == i32(0)) => (pdivs + j), true => pdivs);\nj = (j + i32(1));\n});\ntotal := (dot + pdivs);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "18", "18"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bmd: grand combo — power + filter + while sum", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");

      }
    )
  );
  // 2^5=32; filter [1..10] >5: [6,7,8,9,10] sum=40; while sum 1..4=10; total=32+40+10=82
  src := "pow := i32(1);\ni := i32(0);\nwhile((i < i32(5)), {\npow = (pow * i32(2));\ni = (i + i32(1));\n});\narr := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6), i32(7), i32(8), i32(9), i32(10)];\nfilt_sum := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)(cond((x > i32(5)) => (acc + x), true => acc)));\nloop_sum := i32(0);\nj := i32(1);\nwhile((j <= i32(4)), {\nloop_sum = (loop_sum + j);\nj = (j + i32(1));\n});\ntotal := ((pow + filt_sum) + loop_sum);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "82", "82"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
