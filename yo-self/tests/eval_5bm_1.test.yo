});
test("Phase 5bma: LCM of 12 and 8 via GCD", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // GCD(12,8)=4; LCM=12*8/4=24
  src := "a := i32(12);\nb := i32(8);\naa := a;\nbb := b;\nwhile((bb != i32(0)), {\nt := bb;\nbb = (aa % bb);\naa = t;\n});\ngcd_val := aa;\nlcm_val := ((a * b) / gcd_val);\nexport(lcm_val);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "24", "24"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
