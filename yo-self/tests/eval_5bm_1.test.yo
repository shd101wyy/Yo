test("Phase 5bmd: digit sum + filter fold grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // digit_sum(9999)=36; filter [5..15] >10 sum=[11..15]=65; total=36+65=101
  src := "n := i32(9999);\nd_sum := i32(0);\nwhile((n > i32(0)), {\nd_sum = (d_sum + (n % i32(10)));\nn = (n / i32(10));\n});\narr := [i32(5), i32(6), i32(7), i32(8), i32(9), i32(10), i32(11), i32(12), i32(13), i32(14), i32(15)];\nfilt_sum := arr.fold(i32(0), (fn(acc : i32, x : i32) -> i32)(cond((x > i32(10)) => (acc + x), true => acc)));\ntotal := (d_sum + filt_sum);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "101", "101"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
