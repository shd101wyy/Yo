// @skip_wasm32-emscripten
// @skip_wasm32-wasi
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
empty_env :: (fn() -> Environment)(Environment.new(`test`));

// ---------------------------------------------------------------------------
// Phase 5bma — arithmetic / number patterns
// ---------------------------------------------------------------------------
test("Phase 5bma: sum squares of digits of 12345", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 1^2+2^2+3^2+4^2+5^2=1+4+9+16+25=55
  src := "n := i32(12345);\nsum := i32(0);\nwhile((n > i32(0)), {\nd := (n % i32(10));\nsum = (sum + (d * d));\nn = (n / i32(10));\n});\nexport(sum);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "55", "55"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bma: sum of proper divisors of 28", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // proper divisors of 28: 1,2,4,7,14 → sum=28 (perfect number)
  src := "n := i32(28);\nsum := i32(0);\ni := i32(1);\nwhile((i < n), {\nsum = cond(((n % i) == i32(0)) => (sum + i), true => sum);\ni = (i + i32(1));\n});\nexport(sum);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "28", "28"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bma: sum of squares of divisors of 6", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // divisors of 6: 1,2,3,6 → squares: 1+4+9+36=50
  src := "n := i32(6);\nsum := i32(0);\ni := i32(1);\nwhile((i <= n), {\nsum = cond(((n % i) == i32(0)) => {\nd := (i * i);\n(sum + d)\n}, true => sum);\ni = (i + i32(1));\n});\nexport(sum);\n";
