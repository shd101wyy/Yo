    throw : (
      (err) -> {
        assert(false, "parse error");
        escape(());
      }
    )
  );
  // Option(i32) should be type constructor
  src := "T := Option(i32);\nexport(T);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(
      mod_val,
      .ModuleVal(names, vals) => {
        match(
          vals.get(usize(0)),
          .Some(v) => match(
            v,
            .TypeVal(_) => assert(true, "Option(i32) is TypeVal"),
            _ => assert(false, "expected TypeVal")
          ),
          .None => assert(false, "no value")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
});
test("Phase 5ez: Option as struct ctor with named field", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "parse error");
        escape(());
      }
    )
  );
  // Option(val: i32(5)) should be struct ctor
  src := "o := Option(val: i32(5));\nr := o.val;\nexport(r);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(
      mod_val,
      .ModuleVal(names, vals) => {
        match(
          vals.get(usize(0)),
          .Some(v) => match(
            v,
            .IntLit(n) => assert(n.as_str() == "5", "Option struct val=5"),
            _ => assert(false, "not IntLit")
          ),
          .None => assert(false, "no value")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
});
test("Phase 5ez: export(multiple with expr)", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "parse error");
        escape(());
      }
    )
  );
  src := "x := i32(10);\nexport(x);\nexport((x + i32(5)));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(
      mod_val,
      .ModuleVal(names, vals) => {
        assert(vals.len() == usize(2), "2 exports");
        match(
          vals.get(usize(0)),
          .Some(v) => match(
            v,
            .IntLit(n) => assert(n.as_str() == "10", "first=10"),
            _ => assert(false, "not IntLit")
          ),
          .None => assert(false, "no value")
        );
        match(
          vals.get(usize(1)),
          .Some(v) => match(
            v,
            .IntLit(n) => assert(n.as_str() == "15", "second=15"),
            _ => assert(false, "not IntLit 2")
          ),
          .None => assert(false, "no value 2")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
});
