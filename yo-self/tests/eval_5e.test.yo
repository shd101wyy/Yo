test("Phase 5ea: recursive count bits set", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "parse error");
        escape(());
      }
    )
  );
  src := "popcount := (fn(n : i32) -> i32)(cond((n == i32(0)) => i32(0), true => ((n % i32(2)) + recur((n / i32(2)))))); r := popcount(i32(255)); export(r);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(
      mod_val,
      .ModuleVal(names, vals) => {
        assert(names.len() == usize(1), "1 export");
        match(
          vals.get(usize(0)),
          .Some(v) => match(
            v,
            .IntLit(n) => assert(n.as_str() == "8", "255=11111111, 8 bits"),
            _ => assert(false, "not IntLit")
          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
});
test("Phase 5ea: while loop find nth fibonacci", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "parse error");
        escape(());
      }
    )
  );
  src := "nth_fib := (fn(n : i32) -> i32)({ (a : i32) = i32(0); (b : i32) = i32(1); (i : i32) = i32(0); while((i < n), { (tmp : i32) = b; b = (a + b); a = tmp; i = (i + i32(1)); }); a }); r := nth_fib(i32(12)); export(r);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(
      mod_val,
      .ModuleVal(names, vals) => {
        assert(names.len() == usize(1), "1 export");
        match(
          vals.get(usize(0)),
          .Some(v) => match(
            v,
            .IntLit(n) => assert(n.as_str() == "144", "fib(12)=144"),
            _ => assert(false, "not IntLit")
          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
});
