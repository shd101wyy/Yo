  src := "isqrt := (fn(n : i32) -> i32)({ (lo : i32) = i32(0); (hi : i32) = n; while(((hi - lo) > i32(1)), { mid := ((lo + hi) / i32(2)); lo = cond(((mid * mid) <= n) => mid, true => lo); hi = cond(((mid * mid) > n) => mid, true => hi); }); lo }); r := isqrt(i32(144)); export(r);";
