test("Phase 5ea: while with complex break condition", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "parse error");
        escape(());
      }
    )
  );
  src := "r := { (i : i32) = i32(2); (found : i32) = i32(0); while(true, { (is_prime : bool) = true; (d : i32) = i32(2); while(((d * d) <= i), { cond(((i % d) == i32(0)) => { is_prime = false; break; }, true => ()); d = (d + i32(1)); }); cond(is_prime => { found = (found + i32(1)); cond((found == i32(5)) => break, true => ()); }, true => ()); i = (i + i32(1)); }); i }; export(r);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(
