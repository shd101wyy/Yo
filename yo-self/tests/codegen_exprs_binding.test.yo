/// Phase 13at — codegen binding handler test.
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr, ast_expr_id } :: import("../expr.yo");
{
  ExprInfo,
  ExprInfoTable,
  new_expr_info,
  expr_info_table_new,
  expr_info_table_set
} :: import("../expr_info.yo");
{ Environment } :: import("../env.yo");
{ TypeValue, t_i32, t_bool } :: import("../types/type.yo");
{ EvalValue } :: import("../value.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{ generate_binding, inner_atom_token_value } :: import("../codegen/exprs/binding.yo");
{ get_variable_type_string, get_variable_type_string_str } :: import("../codegen/utils.yo");
mk_atom :: (fn(id : usize, value : str, kind : TokenKind) -> AstExpr)(
  AstExpr.Atom(
    id,
    Token(
      kind : kind,
      value : String.from(value),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from("test"),
      input : String.from("")
    )
  )
);
mk_fn_call :: (fn(id : usize, fn_name : str, args : ArrayList(AstExpr)) -> AstExpr)(
  AstExpr.FnCall(
    id,
    box(mk_atom(usize(0), fn_name, TokenKind.Identifier)),
    args,
    false,
    Token(
      kind : TokenKind.Identifier,
      value : String.from(fn_name),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from("test"),
      input : String.from("")
    )
  )
);
mk_struct_ty :: (fn(name : str) -> TypeValue)(
  TypeValue.Struct(
    String.from(""),
    String.from(name),
    ArrayList(String).new(),
    ArrayList(TypeValue).new(),
    false,
    false,
    false
  )
);
test("get_variable_type_string: primitive type", {
  ctx := CodegenContext.new();
  out := get_variable_type_string_str(t_i32(), "x", &(ctx));
  assert(out == String.from("int32_t x"), "i32 x");
});
test("get_variable_type_string: bool type", {
  ctx := CodegenContext.new();
  out := get_variable_type_string_str(t_bool(), "flag", &(ctx));
  assert(out == String.from("bool flag"), "bool flag");
});
test("inner_atom_token_value: comptime(name) yields name", {
  inner_args := ArrayList(AstExpr).new();
  inner_args.push(mk_atom(usize(101), "foo", TokenKind.Identifier));
  call := mk_fn_call(usize(102), "comptime", inner_args);
  match(
    inner_atom_token_value(call),
    .Some(s) => assert(s == String.from("foo"), "extracts foo"),
    .None => assert(false, "expected Some")
  );
});
test("generate_binding: plain `x : i32` emits int32_t x;", {
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  lhs_info := new_expr_info(env, t_i32());
  expr_info_table_set(table, usize(110), lhs_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(110), "x", TokenKind.Identifier));
  args.push(mk_atom(usize(111), "i32", TokenKind.Identifier));
  result := generate_binding(args, &(ctx), String.from("  "));
  match(
    result,
    .Some(s) => assert(s == String.from(""), "unit sentinel"),
    .None => assert(false, "expected Some")
  );
  code := ctx.emitter.code;
  assert(code.contains(String.from("int32_t x;")), "declaration emitted");
});
test("generate_binding: `comptime(x) : T` emits nothing when metadata is present", {
  ctx := CodegenContext.new();
  // Install an empty ExprInfoTable so generate_binding does not bail
  // out via the no-evaluator fallback.
  ctx.expr_info_table = Option(ExprInfoTable).Some(expr_info_table_new());
  inner_args := ArrayList(AstExpr).new();
  inner_args.push(mk_atom(usize(120), "x", TokenKind.Identifier));
  comptime_call := mk_fn_call(usize(121), "comptime", inner_args);
  args := ArrayList(AstExpr).new();
  args.push(comptime_call);
  args.push(mk_atom(usize(122), "i32", TokenKind.Identifier));
  result := generate_binding(args, &(ctx), String.from(""));
  assert(result.is_some(), "returns unit");
  assert(ctx.emitter.code == String.new(), "no C code emitted");
});
test("generate_binding: defers to bootstrap when no evaluator pass has run", {
  // With no expr_info_table installed, generate_binding returns None so
  // the dispatcher in `exprs.yo` falls back to `handle_bare_colon_decl`
  // (which still emits the C declaration for `comptime(x) : T`,
  // necessary for the subsequent `x = ...` assignment to compile).
  ctx := CodegenContext.new();
  inner_args := ArrayList(AstExpr).new();
  inner_args.push(mk_atom(usize(170), "x", TokenKind.Identifier));
  comptime_call := mk_fn_call(usize(171), "comptime", inner_args);
  args := ArrayList(AstExpr).new();
  args.push(comptime_call);
  args.push(mk_atom(usize(172), "i32", TokenKind.Identifier));
  result := generate_binding(args, &(ctx), String.from(""));
  assert(result.is_none(), "no evaluator → defer to bootstrap");
});
test("generate_binding: `given(x) : NonStruct` emits nothing", {
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  // Inner expr x has primitive type → not struct → emits nothing.
  inner_info := new_expr_info(env, t_i32());
  expr_info_table_set(table, usize(130), inner_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  inner_args := ArrayList(AstExpr).new();
  inner_args.push(mk_atom(usize(130), "x", TokenKind.Identifier));
  given_call := mk_fn_call(usize(131), "given", inner_args);
  args := ArrayList(AstExpr).new();
  args.push(given_call);
  args.push(mk_atom(usize(132), "i32", TokenKind.Identifier));
  result := generate_binding(args, &(ctx), String.from(""));
  assert(result.is_some(), "returns unit");
  assert(!(ctx.emitter.code.contains(String.from("int32_t"))), "no C decl");
});
test("generate_binding: `given(x) : Struct` emits `<Struct> x;`", {
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  // Inner expr x has Struct type → emits `<fallback_c_type> x;` (the
  // bootstrap type_value_to_c_field returns None for Struct → fallback
  // to int32_t — semantics-equivalent to the TS path before the real
  // struct C-name lookup is wired in).
  inner_info := new_expr_info(env, mk_struct_ty("Counter"));
  expr_info_table_set(table, usize(140), inner_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  inner_args := ArrayList(AstExpr).new();
  inner_args.push(mk_atom(usize(140), "c", TokenKind.Identifier));
  given_call := mk_fn_call(usize(141), "given", inner_args);
  args := ArrayList(AstExpr).new();
  args.push(given_call);
  args.push(mk_atom(usize(142), "Counter", TokenKind.Identifier));
  result := generate_binding(args, &(ctx), String.from("  "));
  assert(result.is_some(), "returns unit");
  code := ctx.emitter.code;
  // With the bootstrap fallback (int32_t), the line is `int32_t c;` —
  // when the real struct C-name lookup lands, this will change to
  // `<Counter_c_name> c;`. The test pins down the current behavior.
  assert(code.contains(String.from(" c;")), "variable declaration emitted");
});
test("generate_binding: returns None when LHS has no metadata", {
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(150), "x", TokenKind.Identifier));
  args.push(mk_atom(usize(151), "i32", TokenKind.Identifier));
  result := generate_binding(args, &(ctx), String.from(""));
  assert(result.is_none(), "no metadata → None");
});
