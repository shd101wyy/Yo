// ---------------------------------------------------------------------------
// Phase 5ajd — EnumVal.and_then(fn) and EnumVal.or_else(fn)
// ---------------------------------------------------------------------------
test("Phase 5ajd: and_then on Some calls fn with inner value", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "result := \"5\".parse_i64().and_then((fn(n : i64) -> i64)(n));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "5"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

