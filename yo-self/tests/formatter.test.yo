/// Tests for yo-self/formatter.yo — partial port of
/// src/tests/formatter.test.ts. Covers the core shape patterns:
/// indentation, comment preservation, template strings, redundant paren
/// removal, operator continuations, and idempotency.
///
/// The remaining ~25 TS test cases (operator-rhs preservation, prefix
/// operator spacing, dot dereference, array/tuple literals, etc.) are
/// not yet ported — they fall under Phase A.10.continued.
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ format_yo_source } :: import("../formatter.yo");
/// Helper: format `source`, compare against `expected`. On mismatch, panic
/// with a diff-style message so the failing test's actual vs expected
/// outputs are visible in the test log.
_assert_format :: (fn(source : String, expected : String, label : String) -> unit)({
  given(exn) := Exception(throw : ((_err) -> panic("unexpected throw from format_yo_source")));
  actual := format_yo_source(source, String.from("<test>"), using(exn));
  msg := `${label}: format mismatch.\n--- source ---\n${source}\n--- expected ---\n${expected}\n--- actual ---\n${actual}`;
  assert(actual.as_str() == expected.as_str(), msg.as_str());
});
test("formats strict Yo syntax with fixed 2-space indentation", {
  source := String.from("{ println }::import(\"std/fmt\");\nmain::(fn( ) -> unit)({println(\"Hello\");if(true,{return();});});\nexport( main );");
  expected := String.from("{ println } :: import(\"std/fmt\");\nmain :: (fn() -> unit)({\n  println(\"Hello\");\n  if(true, {\n    return();\n  });\n});\nexport(main);\n");
  _assert_format(source, expected, String.from("basic-indentation"));
});
test("preserves line and block comments", {
  source := String.from("/// entry point\nmain::(fn()->unit)({\n// say hello\nprintln(\"hello\"); /* trailing */\n});\n");
  expected := String.from("/// entry point\nmain :: (fn() -> unit)({\n  // say hello\n  println(\"hello\"); /* trailing */\n});\n");
  _assert_format(source, expected, String.from("comments"));
});
test("preserves raw template strings", {
  source := String.from("message::`hello ${name}\\n`; export(message);");
  expected := String.from("message :: `hello ${name}\\n`;\nexport(message);\n");
  _assert_format(source, expected, String.from("template-strings"));
});
test("removes redundant grouping parentheses around expressions", {
  source := String.from("main::(fn()->i32)({\nreturn((1 + 2));\n});");
  expected := String.from("main :: (fn() -> i32)({\n  return(1 + 2);\n});\n");
  _assert_format(source, expected, String.from("redundant-parens"));
});
test("is idempotent for formatted source", {
  source := String.from("test(\"format effect\", {\n  Raise :: (fn(msg : String, msg2 : String) -> i32);\n  safe_divide :: (fn(x : i32, y : i32, using(raise : Raise)) -> i32)(\n    cond(\n      (y == 0) => raise(`div-by-zero`, `I don't like it`),\n      true => (x / y)\n    )\n  );\n});\n");
  given(exn) := Exception(throw : ((_err) -> panic("unexpected throw from format_yo_source")));
  once := format_yo_source(source, String.from("<test>"), using(exn));
  twice := format_yo_source(once, String.from("<test>"), using(exn));
  idemp_msg := `idempotency: second pass differs from first.\n--- once ---\n${once}\n--- twice ---\n${twice}`;
  assert(twice.as_str() == once.as_str(), idemp_msg.as_str());
});
test("collapses multiple blank lines to one between statements", {
  source := String.from("open(import(\"std/fmt\"));\n\n\n\nmain :: (fn() -> unit)({\n  println(\"hi\");\n});\n");
  expected := String.from("open(import(\"std/fmt\"));\n\nmain :: (fn() -> unit)({\n  println(\"hi\");\n});\n");
  _assert_format(source, expected, String.from("blank-lines"));
});
test("empty source produces empty output", {
  source := String.from("");
  expected := String.from("");
  _assert_format(source, expected, String.from("empty-source"));
});
test("trailing newline is added to non-empty output", {
  source := String.from("main :: (fn() -> unit)(());");
  expected := String.from("main :: (fn() -> unit)(());\n");
  _assert_format(source, expected, String.from("trailing-newline"));
});
