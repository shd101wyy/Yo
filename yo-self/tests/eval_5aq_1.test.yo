// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5aq series: struct definitions, lambda variables,
/// boolean logic, and mixed struct+array+fold programs.
///
/// Phases covered:
///   5aqa — Named struct definition and field access
///   5aqb — Lambda variables, function composition, two-arg lambdas
///   5aqc — Struct + array: map field extraction, filter by field, struct array length
///   5aqd — Boolean/arithmetic logic: equality, comparisons, two-arg lambda predicates
///   5aqe — Mixed programs: struct+map+fold, lambda+map+fold, lambda+filter pipelines
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5aqa — Named struct definition and field access
// ---------------------------------------------------------------------------
test("Phase 5aqa: struct x field access returns correct value", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "Point :: struct(x: i32, y: i32);\np := Point(x: i32(3), y: i32(4));\nexport(p.x);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

