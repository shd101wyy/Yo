// ---------------------------------------------------------------------------
// Phase 5aqc — Struct + array: map field extraction and filter
// ---------------------------------------------------------------------------
test("Phase 5aqc: map extracts x fields from struct array length is two", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "Point :: struct(x: i32, y: i32);\npts := [Point(x: i32(1), y: i32(2)), Point(x: i32(3), y: i32(4))];\nxs := pts.map((fn(p : Point) -> i32)(p.x));\nexport(xs.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

