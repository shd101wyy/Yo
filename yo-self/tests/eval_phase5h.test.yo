// ---------------------------------------------------------------------------
// Phase 3o — evidence params / using(name : Type) / evidence passing
// ---------------------------------------------------------------------------

/// Build `using(inner_expr)` call — used both for param declarations and
/// call-site evidence passing.
make_using_call :: (fn(inner : AstExpr) -> AstExpr)({
  ua := ArrayList(AstExpr).new();
  ua.push(inner);
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "using"))),
    ua,
    false,
    make_token(TokenKind.Identifier, "using")
  )
});

/// Build `using(name : Type)` param for a function definition.
make_using_param :: (fn(name : str, type_name : str) -> AstExpr)({
  ca := ArrayList(AstExpr).new();
  ca.push(make_ident(name));
  ca.push(make_ident(type_name));
  colon_expr := (AstExpr).FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Operator, ":"))),
    ca,
    true,
    make_token(TokenKind.Operator, ":")
  );
  make_using_call(colon_expr)
});

/// Build `(fn(params…) -> ret_type)(body)` function definition expression.
make_typed_fn_def :: (fn(
  fn_params : ArrayList(AstExpr),
  ret_type  : AstExpr,
  body      : AstExpr
) -> AstExpr)({
  fn_head := (AstExpr).FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "fn"))),
    fn_params,
    false,
    make_token(TokenKind.Identifier, "fn")
  );
  arr_a := ArrayList(AstExpr).new();
  arr_a.push(fn_head);
  arr_a.push(ret_type);
  fn_sig := (AstExpr).FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Operator, "->"))),
    arr_a,
    true,
    make_token(TokenKind.Operator, "->")
  );
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  (AstExpr).FnCall(usize(0), box(fn_sig), body_args, false, make_token(TokenKind.Operator, "->"))
});

