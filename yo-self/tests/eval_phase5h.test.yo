test "Phase 5hz: enum suit card value", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "Suit :: enum(Hearts, Diamonds, Clubs, Spades);\nhand := [Suit.Hearts, Suit.Spades, Suit.Diamonds, Suit.Spades, Suit.Clubs];\n(spade_count : i32) = i32(0);\nfor(card, hand, {\ncond((card == Suit.Spades) => {\nspade_count = (spade_count + i32(1));\n}, true => ());\n});\nexport spade_count;\nexport hand.len();";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "2"), "2 spades"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "5"), "5 cards"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5hz: string repeat and length", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "base := \"abc\";\nrepeated := base.repeat(i32(4));\nexport repeated;\nexport repeated.len();";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .StrLit(s) => assert((s.as_str() == "\"abcabcabcabc\""), "repeated 4x"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "12"), "3*4=12"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5hz: array concat and length", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "a := [i32(1), i32(2), i32(3)];\nb := [i32(4), i32(5)];\nc := a.concat(b);\nexport c.len();\nexport c.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "5"), "3+2=5"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "15"), "1+2+3+4+5=15"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5hz: recursive Jacobsthal numbers", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "jacob := (fn(n : i32) -> i32)(cond((n == i32(0)) => i32(0), (n == i32(1)) => i32(1), true => (recur((n - i32(1))) + (i32(2) * recur((n - i32(2)))))));\nexport jacob(i32(5));\nexport jacob(i32(6));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "11"), "J(5)=11"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "21"), "J(6)=21"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5hz: struct point midpoint", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "Point :: struct(x : i32, y : i32);\np1 := Point(x: i32(2), y: i32(8));\np2 := Point(x: i32(6), y: i32(4));\nmid_x := ((p1.x + p2.x) / i32(2));\nmid_y := ((p1.y + p2.y) / i32(2));\nexport mid_x;\nexport mid_y;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "4"), "mid_x=(2+6)/2=4"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "6"), "mid_y=(8+4)/2=6"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5hz: for loop count vowels in words", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "words := [\"hello\", \"world\", \"foo\"];\n(total_vowels : i32) = i32(0);\nfor(w, words, {\n(i : i32) = i32(0);\nwhile((i < w.len()), {\nch := w.substring(i, (i + i32(1)));\ncond((ch == \"a\") => { total_vowels = (total_vowels + i32(1)); }, (ch == \"e\") => { total_vowels = (total_vowels + i32(1)); }, (ch == \"i\") => { total_vowels = (total_vowels + i32(1)); }, (ch == \"o\") => { total_vowels = (total_vowels + i32(1)); }, (ch == \"u\") => { total_vowels = (total_vowels + i32(1)); }, true => ());\ni = (i + i32(1));\n});\n});\nexport total_vowels;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "5"), "e,o + o + o,o = 5 vowels"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};
