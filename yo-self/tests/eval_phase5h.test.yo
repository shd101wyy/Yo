test "Phase 5ha: struct with computed fields", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "Stats :: struct(min : i32, max : i32, sum : i32);\narr := [i32(5), i32(2), i32(8), i32(1), i32(9)];\n(mn : i32) = i32(5);\n(mx : i32) = i32(5);\n(sm : i32) = i32(0);\nfor(x, arr, {\ncond((x < mn) => { mn = x; }, true => ());\ncond((x > mx) => { mx = x; }, true => ());\nsm = (sm + x);\n});\nresult := Stats(min: mn, max: mx, sum: sm);\nexport result.min;\nexport result.max;\nexport result.sum;";
