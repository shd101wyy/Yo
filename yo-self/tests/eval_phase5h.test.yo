test "Phase 5ha: array map and reduce sum", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "nums := [i32(1), i32(2), i32(3), i32(4), i32(5)];\ncubed := nums.map((fn(x : i32) -> i32)((x * (x * x))));\nsum := cubed.fold(i32(0), (fn(a : i32, b : i32) -> i32)((a + b)));\nexport sum;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "225"), "1+8+27+64+125=225"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

test "Phase 5ha: recursive sum of even numbers", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "sum_even := (fn(n : i32) -> i32)(cond((n <= i32(0)) => i32(0), ((n % i32(2)) == i32(0)) => (n + recur((n - i32(2)))), true => recur((n - i32(1)))));\nexport sum_even(i32(10));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "30"), "2+4+6+8+10=30"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

