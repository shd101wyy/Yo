// ---------------------------------------------------------------------------
// AST construction helpers
// ---------------------------------------------------------------------------
make_token_raw :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
make_atom_expr :: (fn(kind : TokenKind, value : str) -> AstExpr)(
  .Atom(usize(0), make_token_raw(kind, value))
);
make_infix_expr :: (fn(op : str, lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  op_tok := make_token_raw(TokenKind.Operator, op);
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), args, true, op_tok)
});
make_unary_expr :: (fn(op : str, operand : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(operand);
  op_tok := make_token_raw(TokenKind.Operator, op);
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), args, false, op_tok)
});
make_fncall_expr :: (fn(name : str, args : ArrayList(AstExpr)) -> AstExpr)({
  name_tok := make_token_raw(TokenKind.Identifier, name);
  .FnCall(usize(0), box(.Atom(usize(0), name_tok)), args, false, name_tok)
});
make_begin_expr :: (fn(stmts : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("begin", stmts)
);
make_cond_expr :: (fn(arms : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("cond", arms)
);
make_cond_arm :: (fn(cond_e : AstExpr, body_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(body_e);
  op_tok := make_token_raw(TokenKind.Operator, "=>");
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), a, true, op_tok)
});
make_if_expr :: (fn(cond_e : AstExpr, then_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(then_e);
  make_fncall_expr("if", a)
});
make_if_else_expr :: (fn(cond_e : AstExpr, then_e : AstExpr, else_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(then_e);
  a.push(else_e);
  make_fncall_expr("if", a)
});
make_while_expr :: (fn(cond_e : AstExpr, body_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(body_e);
  make_fncall_expr("while", a)
});
make_runtime_cond :: (fn(inner : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(inner);
  make_fncall_expr("runtime", a)
});
// Phase 4d helpers ——————————————————————————————————————————————————————————
/// Build `FnCall(Dot, [lhs, rhs], is_infix=true)` — dot field/variant access.
make_dot_expr :: (fn(lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(lhs);
  a.push(rhs);
  dot_tok := make_token_raw(TokenKind.Dot, ".");
  .FnCall(usize(0), box(.Atom(usize(0), dot_tok)), a, true, dot_tok)
});
/// Build `FnCall(FnCall(Dot, [obj, method], true), args, false)` — method call.
make_method_call_expr :: (fn(obj : AstExpr, method : str, args : ArrayList(AstExpr)) -> AstExpr)({
  dot_tok := make_token_raw(TokenKind.Dot, ".");
  method_tok := make_token_raw(TokenKind.Identifier, method);
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(obj);
  dot_args.push(AstExpr.Atom(usize(0), method_tok));
  dot_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  AstExpr.FnCall(usize(0), box(dot_expr), args, false, dot_tok)
});
/// Build `FnCall(":", [name_expr, ty_expr], is_infix=true)` — type annotation.
make_colon_expr :: (fn(name_e : AstExpr, ty_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(name_e);
  a.push(ty_e);
  colon_tok := make_token_raw(TokenKind.Operator, ":");
  .FnCall(usize(0), box(.Atom(usize(0), colon_tok)), a, true, colon_tok)
});
/// Build `FnCall("=", [lhs, rhs], is_infix=true)` — assignment or typed decl.
make_assign_expr :: (fn(lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(lhs);
  a.push(rhs);
  eq_tok := make_token_raw(TokenKind.Operator, "=");
  .FnCall(usize(0), box(.Atom(usize(0), eq_tok)), a, true, eq_tok)
});
/// Build a typed declaration `(x : T) = val`.
make_typed_decl_expr :: (fn(name : str, ty_name : str, val_e : AstExpr) -> AstExpr)(
  make_assign_expr(
    make_colon_expr(
      make_atom_expr(TokenKind.Identifier, name),
      make_atom_expr(TokenKind.Identifier, ty_name)
    ),
    val_e
  )
);
/// Convenience: run generate_expr with a fresh context and empty indent.
run_gen :: (fn(expr : AstExpr) -> Option(String))({
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  ind := String.new();
  generate_expr(expr, pctx, ind)
});
/// Convenience: run generate_expr and also return the emitted code.
run_gen_with_ctx :: (fn(expr : AstExpr) -> CodegenContext)({
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  ind := String.new();
  _r := generate_expr(expr, pctx, ind);
  ctx
});
{ parse, ParseError } :: import("../parser.yo");
/// Build `FnCall(Atom("fn"), params, false)` — fn type prefix.
make_fn_type_prefix :: (fn(params : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("fn", params)
);
/// Build `FnCall(Atom("->"), [fn_prefix, ret_ty], true)` — fn type with return.
make_fn_type :: (fn(params : ArrayList(AstExpr), ret_ty : AstExpr) -> AstExpr)({
  fn_prefix := make_fn_type_prefix(params);
  make_infix_expr("->", fn_prefix, ret_ty)
});
/// Build the whole `(fn(params) -> ret_ty)(body)` function literal application.
make_fn_app :: (fn(params : ArrayList(AstExpr), ret_ty : AstExpr, body : AstExpr) -> AstExpr)({
  fn_type := make_fn_type(params, ret_ty);
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  fn_type_tok := make_token_raw(TokenKind.Operator, "->");
  .FnCall(usize(0), box(fn_type), body_args, false, fn_type_tok)
});
/// Build `FnCall(Atom("::"), [name_atom, fn_app], true)` — named constant define.
make_define_expr :: (fn(name : str, rhs : AstExpr) -> AstExpr)(
  make_infix_expr("::", make_atom_expr(TokenKind.Identifier, name), rhs)
);
/// Build `FnCall(Atom(":"), [name, ty], true)` — typed param (reuses make_colon_expr).
make_param :: (fn(name : str, ty_name : str) -> AstExpr)(
  make_colon_expr(
    make_atom_expr(TokenKind.Identifier, name),
    make_atom_expr(TokenKind.Identifier, ty_name)
  )
);
/// Build a `using(name : Type)` evidence param expression.
make_using_param :: (fn(ev_name : str, ty_name : str) -> AstExpr)({
  inner := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, ev_name),
    make_atom_expr(TokenKind.Identifier, ty_name)
  );
  a := ArrayList(AstExpr).new();
  a.push(inner);
  make_fncall_expr("using", a)
});
// ---------------------------------------------------------------------------
// Phase 4j+ tests — extract_fn_def
// ---------------------------------------------------------------------------
test("extract_fn_def: simple no-param fn() -> unit", {
  body := make_begin_expr(ArrayList(AstExpr).new());
  ret := make_atom_expr(TokenKind.Identifier, "unit");
  rhs := make_fn_app(ArrayList(AstExpr).new(), ret, body);
  expr := make_define_expr("main", rhs);
  fd := extract_fn_def(expr);
  match(
    fd,
    .None => assert(false, "should extract FnDef"),
    .Some(d) => {
      assert(d.name == String.from("main"), "name = main");
      assert(d.ret_ty_c == String.from("void"), "ret_ty = void");
      assert(d.params.len() == usize(0), "no params");
    }
  );
});
test("extract_fn_def: fn(x : i32) -> i64", {
  params := ArrayList(AstExpr).new();
  params.push(make_param("x", "i32"));
  body := make_atom_expr(TokenKind.Identifier, "x");
  ret := make_atom_expr(TokenKind.Identifier, "i64");
  rhs := make_fn_app(params, ret, body);
  expr := make_define_expr("double_it", rhs);
  fd := extract_fn_def(expr);
  match(
    fd,
    .None => assert(false, "should extract FnDef"),
    .Some(d) => {
      assert(d.name == String.from("double_it"), "name");
      assert(d.ret_ty_c == String.from("int64_t"), "ret_ty = int64_t");
      assert(d.params.len() == usize(1), "one param");
      match(
        d.param_tys.get(usize(0)),
        .None => assert(false, "no param ty"),
        .Some(t) => assert(t == String.from("int32_t"), "param ty = int32_t")
      );
    }
  );
});
test("extract_fn_def: using evidence param → void*", {
  params := ArrayList(AstExpr).new();
  params.push(make_using_param("io", "IO"));
  body := make_begin_expr(ArrayList(AstExpr).new());
  ret := make_atom_expr(TokenKind.Identifier, "unit");
  rhs := make_fn_app(params, ret, body);
  expr := make_define_expr("run", rhs);
  fd := extract_fn_def(expr);
  match(
    fd,
    .None => assert(false, "should extract"),
    .Some(d) => {
      assert(d.params.len() == usize(1), "one evidence param");
      match(
        d.params.get(usize(0)),
        .None => assert(false, "no param name"),
        .Some(n) => assert(n == String.from("ev_io"), "param name = ev_io")
      );
      match(
        d.param_tys.get(usize(0)),
        .None => assert(false, "no param ty"),
        .Some(t) => assert(t == String.from("void*"), "param ty = void*")
      );
    }
  );
});
test("extract_fn_def: non-define expr returns None", {
  expr := make_atom_expr(TokenKind.Identifier, "hello");
  fd := extract_fn_def(expr);
  match(
    fd,
    .None => (),
    // expected
    .Some(_) => assert(false, "should return(None for non-define)")
  );
});
// ---------------------------------------------------------------------------
// Phase 4j+ tests — compile_module_to_c
// ---------------------------------------------------------------------------
test("compile_module_to_c: trivial main() → generates static fn + int main", {
  body := make_begin_expr(ArrayList(AstExpr).new());
  ret := make_atom_expr(TokenKind.Identifier, "unit");
  rhs := make_fn_app(ArrayList(AstExpr).new(), ret, body);
  expr := make_define_expr("main", rhs);
  exprs := ArrayList(AstExpr).new();
  exprs.push(expr);
  result := compile_module_to_c(exprs, "test_module", "main");
  match(
    result,
    .None => assert(false, "no C output"),
    .Some(c) => {
      assert(c.contains(String.from("static void fn_main")), "static fn decl");
      assert(c.contains(String.from("int main(void)")), "int main wrapper");
      assert(c.contains(String.from("fn_main();")), "call in main wrapper");
      assert(c.contains(String.from("#include <stdio.h>")), "preamble included");
    }
  );
});
test("compile_module_to_c: main not found returns None", {
  body := make_begin_expr(ArrayList(AstExpr).new());
  ret := make_atom_expr(TokenKind.Identifier, "unit");
  rhs := make_fn_app(ArrayList(AstExpr).new(), ret, body);
  expr := make_define_expr("helper", rhs); // not "main"
  exprs := ArrayList(AstExpr).new();
  exprs.push(expr);
  result := compile_module_to_c(exprs, "test_module", "main");
  match(
    result,
    .None => (),
    // expected
    .Some(_) => assert(false, "should be None when main absent")
  );
});
test("compile_module_to_c: fn with i32 param emits correct signature", {
  params := ArrayList(AstExpr).new();
  params.push(make_param("n", "i32"));
  body := make_atom_expr(TokenKind.Identifier, "n");
  ret := make_atom_expr(TokenKind.Identifier, "i32");
  rhs := make_fn_app(params, ret, body);
  expr := make_define_expr("main", rhs);
  exprs := ArrayList(AstExpr).new();
  exprs.push(expr);
  result := compile_module_to_c(exprs, "test_module", "main");
  match(
    result,
    .None => assert(false, "no C output"),
    .Some(c) => {
      assert(c.contains(String.from("int32_t n")), "param in signature");
      assert(c.contains(String.from("static int32_t fn_main")), "return(type)");
    }
  );
});
// ---------------------------------------------------------------------------
// Phase 4 validation milestone — parse + compile hello_world
// ---------------------------------------------------------------------------
// These tests use the self-hosted lexer+parser to parse Yo source, then call
// compile_module_to_c to produce a complete C11 source file.
// They are the "Phase 4 validation milestone": compile hello_world.yo end-to-end
// through the Yo-written compiler.
test("validation: parse and compile trivial main() -> unit", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        escape(());
      }
    )
  );
  src := String.from("main :: (fn() -> unit)({ }); export(main);");
  exprs := parse(src, String.from("<test>"), using(exn));
  opt_c := compile_module_to_c(exprs, "hello_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("static void fn_main(")), "static fn_main declaration");
      assert(c.contains(String.from("int main(void)")), "int main wrapper");
      assert(c.contains(String.from("fn_main();")), "call in main");
      assert(c.contains(String.from("#include <stdio.h>")), "preamble present");
    }
  );
});
test("validation: parse and compile fn with i32 parameter", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        escape(());
      }
    )
  );
  src := String.from("add :: (fn(x : i32, y : i32) -> i32)({ x; }); export(add);");
  exprs := parse(src, String.from("<test>"), using(exn));
  opt_c := compile_module_to_c(exprs, "arith_module", "add");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("int32_t x")), "param x: i32");
      assert(c.contains(String.from("int32_t y")), "param y: i32");
      assert(c.contains(String.from("static int32_t fn_add(")), "fn return(type)");
    }
  );
});
test("validation: Array(T, _) constructor infers C array length", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        escape(());
      }
    )
  );
  src := String.from("main :: (fn() -> unit)({ arr1 := Array(i32, _)(1, 2, 3); arr2 := [i32 ; _](4, 5); }); export(main);");
  exprs := parse(src, String.from("<test>"), using(exn));
  opt_c := compile_module_to_c(exprs, "array_infer_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("int32_t arr1[3] = {1, 2, 3};")), "Array(i32, _) infers length 3");
      assert(c.contains(String.from("int32_t arr2[2] = {4, 5};")), "[i32 ; _] infers length 2");
      assert(!(c.contains(String.from("[_]"))), "underscore length must not reach C output");
    }
  );
});
test("validation: Option/Result runtime constructors lower to payload values", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        escape(());
      }
    )
  );
  src := String.from("main :: (fn() -> unit)({ x := Option(i32).Some(i32(42)); assert(x.unwrap() == i32(42)); assert(x.is_some()); assert(!(x.is_none())); y := Result(i32, bool).Ok(i32(7)); assert(y.unwrap() == i32(7)); assert(y.is_ok()); assert(!(y.is_err())); }); export(main);");
  exprs := parse(src, String.from("<test>"), using(exn));
  opt_c := compile_module_to_c(exprs, "option_result_runtime_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("__auto_type x = (int32_t)(42);")), "Option.Some payload");
      assert(c.contains(String.from("__auto_type y = (int32_t)(7);")), "Result.Ok payload");
      assert(!(c.contains(String.from("Option(i32).Some"))), "Option pseudo-call must not reach C");
      assert(!(c.contains(String.from("Result(i32, bool).Ok"))), "Result pseudo-call must not reach C");
    }
  );
});
test("validation: Option/Result unwrap method extraction lowers to macro alias", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        escape(());
      }
    )
  );
  src := String.from("main :: (fn() -> unit)({ f :: Option(i32).unwrap; x := Option(i32).Some(i32(42)); val := f(x); assert(val == i32(42)); g :: Result(i32, bool).unwrap; y := Result(i32, bool).Ok(i32(7)); got := g(y); assert(got == i32(7)); }); export(main);");
  exprs := parse(src, String.from("<test>"), using(exn));
  opt_c := compile_module_to_c(exprs, "option_result_method_extract_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("#define f(__yo_value) (__yo_value)")), "Option unwrap macro");
      assert(c.contains(String.from("#define g(__yo_value) (__yo_value)")), "Result unwrap macro");
      assert(c.contains(String.from("__auto_type val = f(x);")), "extracted Option unwrap call remains macro-expanded by C");
      assert(c.contains(String.from("__auto_type got = g(y);")), "extracted Result unwrap call remains macro-expanded by C");
    }
  );
});
test("validation: generic option-like Some match lowers to payload branch", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        escape(());
      }
    )
  );
  src := String.from("MyOption :: (fn(comptime(T) : Type) -> comptime(Type))(enum(None, Some(value : T))); main :: (fn() -> unit)({ op := MyOption(i32).Some(i32(12)); match(op, .Some(_) => { assert(op.comptime_unwrap() == i32(12)); }, .None => { y := add(i32(4), i32(5)); assert(y == i32(9)); }); }); export(main);");
  exprs := parse(src, String.from("<test>"), using(exn));
  opt_c := compile_module_to_c(exprs, "generic_option_like_some_match_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("__auto_type op = (int32_t)(12);")), "generic Some lowers to payload");
      assert(!(c.contains(String.from(".Some"))), "generic Some pseudo-call must not reach C");
      assert(!(c.contains(String.from(".tag"))), "simplified Some match must not emit enum tag switch");
      assert(!(c.contains(String.from("add("))), "dead None branch should not be emitted");
    }
  );
});
test("validation: Option Some curly binding lowers to payload binding", {
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        escape(());
      }
    )
  );
  src := String.from("main :: (fn() -> unit)({ o := Option(i32).Some(i32(42)); v := match(o, .Some({ value }) => value, .None => i32(0)); assert(v == i32(42)); }); export(main);");
  exprs := parse(src, String.from("<test>"), using(exn));
  opt_c := compile_module_to_c(exprs, "option_some_curly_match_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("__auto_type value = o;")), "curly Some binding should bind payload");
      assert(c.contains(String.from("__auto_type v = value;")), "match result should use bound value");
      assert(!(c.contains(String.from(".Some"))), "Some pseudo-call must not reach C");
      assert(!(c.contains(String.from(".tag"))), "simplified Some match must not emit enum tag switch");
    }
  );
});
test("validation: ArrayList(u8) value return can be indexed directly", {
  given(exn) := Exception(
    throw : (
      (err) -> {
