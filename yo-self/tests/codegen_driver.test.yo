      assert(c.contains(String.from("__auto_type p = (&(*(((size_t)(2) == (size_t)(0)) ? &arr.data0 : ((size_t)(2) == (size_t)(1)) ? &arr.data1 : &arr.data2)));")), "address-of struct Index should address selected field");
