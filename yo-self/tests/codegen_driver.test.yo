        escape(());
      }
    )
  );
  src := String.from("get_list :: (fn() -> ArrayList(u8))({ (list : ArrayList(u8)) = ArrayList(u8).new(); list.push(u8(10)); list.push(u8(20)); list }); main :: (fn() -> unit)({ (val : u8) = get_list()(usize(1)); assert(val == u8(20)); }); export(main);");
