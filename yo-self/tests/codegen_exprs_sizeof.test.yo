/// Codegen tests for `sizeof(expr)` builtin.
///
/// Validates the per-handler module `yo-self/codegen/exprs/sizeof.yo`, which
/// is a 1-to-1 port of `src/codegen/exprs/sizeof.ts`.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr } :: import("../expr.yo");
{ TokenKind, Token } :: import("../token.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{ generate_expr } :: import("../codegen/exprs.yo");
{ set_generate_expr_fn } :: import("../codegen/exprs/expr.yo");
{ generate_sizeof, format_sizeof_call } :: import("../codegen/exprs/sizeof.yo");
make_token :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
test("generate_sizeof: wraps generated argument expression", {
  set_generate_expr_fn(generate_expr);
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  ind := String.new();
  args := ArrayList(AstExpr).new();
  args.push(AstExpr.Atom(usize(0), make_token(TokenKind.Identifier, "value")));
  out := generate_sizeof(args, pctx, ind);
  match(
    out,
    .None => assert(false, "expected sizeof output"),
    .Some(code) => assert(code == "sizeof(value)", "expected sizeof expression")
  );
});
test("generate_sizeof: missing argument returns None", {
  set_generate_expr_fn(generate_expr);
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  ind := String.new();
  args := ArrayList(AstExpr).new();
  out := generate_sizeof(args, pctx, ind);
  match(
    out,
    .None => assert(true, "expected no output"),
    .Some(_) => assert(false, "expected no output")
  );
});
test("format_sizeof_call: wraps argument in sizeof(...)", {
  out := format_sizeof_call(String.from("Color"));
  assert(out == String.from("sizeof(Color)"), "sizeof call shape");
});
