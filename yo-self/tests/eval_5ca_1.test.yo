test("Phase 5cad: prefix_max_sum + suffix_min_sum + new_max_cnt = 75+25+2 = 102", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(6), i32(1), i32(9), i32(2), i32(8), i32(3), i32(7), i32(4), i32(5)];\ns := i32(0); mx := i32(0); i := i32(0);\nwhile((i < i32(9)), {\nv := arr.get(i).unwrap();\nmx = cond((v > mx) => v, true => mx);\ns = (s + mx); i = (i + i32(1));\n});\npms := s;\ns2 := i32(0); mn := i32(9999); j := i32(8);\nwhile((j >= i32(0)), {\nv := arr.get(j).unwrap();\nmn = cond((v < mn) => v, true => mn);\ns2 = (s2 + mn); j = (j - i32(1));\n});\nsms := s2;\ncnt := i32(0); mx2 := i32(0); k := i32(0);\nwhile((k < i32(9)), {\nv := arr.get(k).unwrap();\nis_new := cond((v > mx2) => i32(1), true => i32(0));\ncnt = (cnt + is_new); mx2 = cond((v > mx2) => v, true => mx2);\nk = (k + i32(1));\n});\nr := ((pms + sms) + cnt);\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "102", "102"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

