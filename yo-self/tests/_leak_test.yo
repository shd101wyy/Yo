open(import("std/fmt"));
open(import("std/error"));
open(import("std/string"));
{ generate_exprs_from_code } :: import("../parser.yo");
{ Environment } :: import("../env.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
empty_env :: (fn() -> Environment)(Environment.new(`leak_test`));
main :: (fn() -> unit)({
  exn := Exception(throw : ((_err) -> unwind(())));
  src := String.from("MyOpt :: enum(None, Some(i32)); val := MyOpt.Some(i32(42)); export(val);");
  env := empty_env();
  exprs := generate_exprs_from_code(src, exn);
  _result := evaluate_module_body(exprs, env);
});
export(main);
