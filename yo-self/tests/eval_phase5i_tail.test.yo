  inner := make_begin(inner_stmts);
  outer_stmts := ArrayList(AstExpr).new();
  outer_stmts.push(inner);
  outer := make_begin(outer_stmts);
  result := evaluate(outer, &env);
  match(result,
    .None => assert(false, "nested begin returned None"),
    .Some(r) => match(r.value,
      .IntLit(n) => assert((n.as_str() == "42"), "expected 42"),
      _ => assert(false, "expected IntLit from nested begin")
    )
  );
};

