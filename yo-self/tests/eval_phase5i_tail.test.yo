test "Phase 5ia: for loop with enum matching and accumulation", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "Op :: enum(Add(i32), Sub(i32), Mul(i32));\nops := [Op.Add(i32(5)), Op.Mul(i32(3)), Op.Sub(i32(2)), Op.Add(i32(10))];\n(val : i32) = i32(0);\nfor(op, ops, {\nval = match(op, .Add(n) => (val + n), .Sub(n) => (val - n), .Mul(n) => (val * n));\n});\nexport val;";
