test "Phase 5r: function definition via :: and call", {
  // double :: (fn(comptime(x) : comptime_int) -> comptime_int)((x + x));
  // val := double(7);
  // val should be IntLit("14")
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error in fn def test"); escape (); }));
  src := "double :: (fn(comptime(x) : comptime_int) -> comptime_int)((x + x)); val := double(7); export val;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "fn def+call returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(_, vals) =>
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                .IntLit(raw) => assert((raw.as_str() == "14"), "double(7) should be 14"),
                _ => assert(false, "expected IntLit")
              ),
            .None => assert(false, "no export value")
          ),
        _ => assert(false, "not ModuleVal")
      )
  );
};

