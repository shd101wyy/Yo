test "Phase 5q: chained comparison through begin block", {
  // { a := 3; b := 5; c := (a < b); c; } => BoolVal(true)
  env := empty_env();
  stmts := ArrayList(AstExpr).new();
  stmts.push(make_infix(":=", make_atom(TokenKind.Identifier, "a"), make_atom(TokenKind.Integer, "3")));
  stmts.push(make_infix(":=", make_atom(TokenKind.Identifier, "b"), make_atom(TokenKind.Integer, "5")));
  stmts.push(make_infix(":=", make_atom(TokenKind.Identifier, "c"),
    make_infix("<", make_atom(TokenKind.Identifier, "a"), make_atom(TokenKind.Identifier, "b"))
  ));
  stmts.push(make_atom(TokenKind.Identifier, "c"));
  block := make_begin(stmts);
  result := evaluate(block, &env);
  match(result,
    .None => assert(false, "chained comparison returned None"),
    .Some(r) => match(r.value,
      .BoolVal(b) => assert(b, "expected true"),
      _ => assert(false, "expected BoolVal(true)")
    )
  );
};

