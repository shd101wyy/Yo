test "Phase 5ia: enum Option is_some simulation", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "Maybe :: enum(Just(i32), Nothing);\nis_just := (fn(m : Maybe) -> bool)(match(m, .Just(_) => true, .Nothing => false));\nget_or := (fn(m : Maybe, default : i32) -> i32)(match(m, .Just(v) => v, .Nothing => default));\na := Maybe.Just(i32(42));\nb := Maybe.Nothing;\nexport is_just(a);\nexport is_just(b);\nexport get_or(a, i32(0));\nexport get_or(b, i32(-1));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .BoolVal(b) => assert(b, "Just is some"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .BoolVal(b) => assert(!(b), "Nothing not some"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "42"), "Just(42) unwrap"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(3)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "-1"), "Nothing default -1"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

