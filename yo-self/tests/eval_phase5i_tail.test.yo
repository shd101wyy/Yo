// =========================================================================
// Phase 3am: box/deref, ArrayList, StrLit.substring, ArrayVal.len/get
// =========================================================================

test "Phase 5m: given(name) := rhs binds name in scope", {
  // given(handler) := value — should look up the bound value
  env := empty_env();

  // Build: given(handler) := 42
  handler_atom := make_ident("handler");
  given_args := ArrayList(AstExpr).new();
  given_args.push(handler_atom);
  given_e := make_call("given", given_args);
  rhs_e := make_atom(TokenKind.Integer, "42");
  given_binding := make_infix(":=", given_e, rhs_e);

  bind_res := evaluate(given_binding, &env);
  match(bind_res,
    .None    => assert(false, "given binding returned None"),
    .Some(_) => ()
  );

  // Now `handler` should be in scope
  lookup := evaluate(make_ident("handler"), &env);
  match(lookup,
    .None => assert(false, "handler not found in scope after given binding"),
    .Some(res) =>
      match(res.value,
        .IntLit(raw) => assert((raw.as_str() == "42"), "handler value is 42"),
        _ => assert(false, "expected IntLit(42)")
      )
  );
};

test "Phase 5m: given(name) := rhs binds as compile-time value", {
  // given bindings are always compile-time in Yo
  env := empty_env();

  // Build: given(ctx) := true
  ctx_atom := make_ident("ctx");
  given_args := ArrayList(AstExpr).new();
  given_args.push(ctx_atom);
  given_e := make_call("given", given_args);
  rhs_e := make_atom(TokenKind.Bool, "true");
  given_binding := make_infix(":=", given_e, rhs_e);

  _bind := evaluate(given_binding, &env);

  // Lookup should succeed and value is compile-time
  lookup := evaluate(make_ident("ctx"), &env);
  match(lookup,
    .None => assert(false, "ctx not found after given binding"),
    .Some(res) =>
      // BoolVal is always a compile-time value
      match(res.value,
        .BoolVal(_) => (), // compile-time bool — correct
        _ => assert(false, "expected BoolVal (compile-time bool)")
      )
  );
};

test "Phase 5o: multiple defines in same env", {
  // Verify that defining multiple names in same env works and doesn't clobber
  env := empty_env();
  _r1 := evaluate(
    make_infix("::", make_ident("aaa"),
      make_atom(TokenKind.Integer, "10")),
    &env
  );
  _r2 := evaluate(
    make_infix("::", make_ident("bbb"),
      make_atom(TokenKind.Integer, "20")),
    &env
  );
  ra := evaluate(make_ident("aaa"), &env);
  rb := evaluate(make_ident("bbb"), &env);
  match(ra,
    .None => assert(false, "aaa not found"),
    .Some(va) => assert(
      (va.value == EvalValue.IntLit(String.from("10"))),
      "aaa should be 10"
    )
  );
  match(rb,
    .None => assert(false, "bbb not found"),
    .Some(vb) => assert(
      (vb.value == EvalValue.IntLit(String.from("20"))),
      "bbb should be 20"
    )
  );
};

test "Phase 5o: nested arithmetic evaluation", {
  // ((2 + 3) * (4 - 1)) should equal 15
  env := empty_env();
  two_args := ArrayList(AstExpr).new();
  two_args.push(make_atom(TokenKind.Integer, "2"));
  three_args := ArrayList(AstExpr).new();
  three_args.push(make_atom(TokenKind.Integer, "3"));
  four_args := ArrayList(AstExpr).new();
  four_args.push(make_atom(TokenKind.Integer, "4"));
  one_args := ArrayList(AstExpr).new();
  one_args.push(make_atom(TokenKind.Integer, "1"));
  add := make_infix("+", make_call("i32", two_args), make_call("i32", three_args));
  sub := make_infix("-", make_call("i32", four_args), make_call("i32", one_args));
  mul := make_infix("*", add, sub);
  result := evaluate(mul, &env);
  match(result,
    .None => assert(false, "nested arithmetic returned None"),
    .Some(r) => assert(
      (r.value == EvalValue.IntLit(String.from("15"))),
      "((2+3)*(4-1)) == 15"
    )
  );
};

test "Phase 5p: string literal concatenation", {
  // "hello" + " world" => "hello world"
  env := empty_env();
  lhs := make_atom(TokenKind.StringLit, "\"hello\"");
  rhs := make_atom(TokenKind.StringLit, "\" world\"");
  concat_expr := make_infix("+", lhs, rhs);
  result := evaluate(concat_expr, &env);
  match(result,
    .None => assert(false, "string concat returned None"),
    .Some(r) => assert(
      (r.value == EvalValue.StrLit(String.from("\"hello world\""))),
      "hello + world = hello world"
    )
  );
};

