};

test "eval for break with counter", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "nums := [4, 8, 15, 16, 23, 42, 100, 200];\ncount := i32(0);\nsum := i32(0);\nfor(x, nums, {\n  cond((x > i32(50)) => break, true => { sum = (sum + x); count = (count + i32(1)); });\n});\nexport count;\nexport sum;";
