        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "1 export");
          match(vals.get(usize(0)),
            .Some(v1) =>
              match(v1,
                .StrLit(raw) => assert((raw.as_str() == "\"42\""), "s is string 42"),
                _ => assert(false, "s not StrLit")
              ),
            .None => assert(false, "no s")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

