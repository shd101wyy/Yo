// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator core — Phase 3a/3b/3c/3d (literals + identifier lookup +
/// begin/cond/define/assign + arithmetic/comparison/boolean operators +
/// enum variant construction + match + while loops) through Phase 3ah
/// (integer div/mod + function composition + string equality + impl method call).

open import "std/fmt";
open import "std/string";
open import "std/error";
{ ArrayList } :: import "std/collections/array_list";

{ TokenKind, Token } :: import "../lexer/token.yo";
{ AstExpr, BK_BEGIN, BK_TUPLE, BK_ANON_STRUCT, BK_EXPORT, BK_OPEN, BK_IMPORT,
  BK_ENUM, BK_STRUCT, BK_OBJECT, BK_NEWTYPE, BK_UNION, BK_TRAIT, BK_ARRAY_VAL } :: import "../expr/expr.yo";
{ TypeValue, type_value_tag,
  t_i32, t_bool, t_u32, t_f32, t_type, t_unit,
  t_comptime_int, t_comptime_float, t_comptime_string } :: import "../types/type.yo";
{ TypeTag } :: import "../types/tags.yo";
{ Environment } :: import "../env/env.yo";
{ EvalValue, EvalResult } :: import "../evaluator/value.yo";
{ evaluate, parse_raw_int, evaluate_module_body, set_module_loader } :: import "../evaluator/eval.yo";
{ generate_exprs_from_code } :: import "../parser/parser.yo";

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

make_token :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind:        kind,
    value:       String.from(value),
    row:         usize(0),
    column:      usize(0),
    character:   usize(0),
    module_path: String.from(""),
    input:       String.from("")
  )
);

make_atom :: (fn(kind : TokenKind, value : str) -> AstExpr)(
  .Atom(usize(0), make_token(kind, value))
);

make_ident :: (fn(name : str) -> AstExpr)(
  make_atom(TokenKind.Identifier, name)
);

make_infix :: (fn(op : str, lhs : AstExpr, rhs : AstExpr) -> AstExpr)(
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Operator, op))),
    {
      args := ArrayList(AstExpr).new();
      args.push(lhs);
      args.push(rhs);
      args
    },
    true,
    make_token(TokenKind.Operator, op)
  )
);

/// Build a begin-block `{ stmts… }` from an ArrayList of statements.
make_begin :: (fn(stmts : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, BK_BEGIN))),
    stmts,
    false,
    make_token(TokenKind.Identifier, BK_BEGIN)
  )
);

/// Build the unit expression `()`.
make_unit :: (fn() -> AstExpr)(
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, BK_TUPLE))),
    ArrayList(AstExpr).new(),
    false,
    make_token(TokenKind.Identifier, BK_TUPLE)
  )
);

/// Build a cond arm `condition => body` (infix =>).
make_arm :: (fn(cond_expr : AstExpr, body_expr : AstExpr) -> AstExpr)(
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Operator, "=>"))),
    {
      a := ArrayList(AstExpr).new();
      a.push(cond_expr);
      a.push(body_expr);
      a
    },
    true,
    make_token(TokenKind.Operator, "=>")
  )
);

/// Build `cond(arm1, arm2, …)`.
make_cond :: (fn(arms : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "cond"))),
    arms,
    false,
    make_token(TokenKind.Identifier, "cond")
  )
);

/// Build `keyword(arg1, arg2, …)` — used for enum/struct/union/trait/object/newtype.
make_typedef_call :: (fn(keyword : str, type_args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, keyword))),
    type_args,
    false,
    make_token(TokenKind.Identifier, keyword)
  )
);

/// Build `func_name(arg1, arg2, …)` — a non-infix function call.
make_fncall_atom :: (fn(name : str, call_args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, name))),
    call_args,
    false,
    make_token(TokenKind.Identifier, name)
  )
);

/// Build a `label : type_expr` labeled field expression (infix colon).
make_labeled_field :: (fn(label : str, type_expr : AstExpr) -> AstExpr)(
  .FnCall(usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Operator, ":"))),
    {
      a := ArrayList(AstExpr).new();
      a.push(make_ident(label));
      a.push(type_expr);
      a
    },
    true,
    make_token(TokenKind.Operator, ":")
  )
);

/// Build `VariantName(field1, field2, …)` — enum variant with fields.
make_variant :: (fn(name : str, field_args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, name))),
    field_args,
    false,
    make_token(TokenKind.Identifier, name)
  )
);

empty_env :: (fn() -> Environment)(Environment.new(`test`));

check_some :: (fn(result : Option(EvalResult), label : str) -> unit)(
  match(result,
    .Some(_) => (),
    .None => {
      println(`FAIL [${label}]: expected Some, got None`);
      assert(false, label);
    }
  )
);

check_none :: (fn(result : Option(EvalResult), label : str) -> unit)(
  match(result,
    .Some(_) => {
      println(`FAIL [${label}]: expected None, got Some`);
      assert(false, label);
    },
    .None => ()
  )
);

check_some_eval_val :: (fn(result : Option(EvalValue), label : str) -> unit)(
  match(result,
    .Some(_) => (),
    .None => {
      println(`FAIL [${label}]: expected Some(EvalValue), got None`);
      assert(false, label);
    }
  )
);

// ---------------------------------------------------------------------------
// Bool literals
// ---------------------------------------------------------------------------

test "evaluate_module_body: exports two bindings into ModuleVal", {
  env := empty_env();
  // Body: x := 42; y := true; export x, y;
  define_x := make_infix(":=", make_ident("x"), make_atom(TokenKind.Integer, "42"));
  define_y := make_infix(":=", make_ident("y"), make_atom(TokenKind.Bool, "true"));
  export_names := ArrayList(str).new();
  export_names.push("x");
  export_names.push("y");
  export_expr := make_export(export_names);
  exprs := ArrayList(AstExpr).new();
  exprs.push(define_x);
  exprs.push(define_y);
  exprs.push(export_expr);
  result := evaluate_module_body(exprs, &env);
  match(result,
    .Some(mv) =>
      match(mv,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(2)), "2 exported names");
          assert((vals.len() == usize(2)), "2 exported values");
          match(names.get(usize(0)),
            .Some(n0) => assert((n0.as_str() == "x"), "first export is x"),
            .None => assert(false, "missing first export name")
          );
          match(vals.get(usize(0)),
            .Some(v0) => assert((v0 == EvalValue.IntLit(String.from("42"))), "x == 42"),
            .None => assert(false, "missing first export value")
          );
          match(names.get(usize(1)),
            .Some(n1) => assert((n1.as_str() == "y"), "second export is y"),
            .None => assert(false, "missing second export name")
          );
          match(vals.get(usize(1)),
            .Some(v1) => assert((v1 == EvalValue.BoolVal(true)), "y == true"),
            .None => assert(false, "missing second export value")
          );
        },
        _ => assert(false, "expected ModuleVal")
      ),
    .None => assert(false, "evaluate_module_body returned None")
  );
};

test "validation milestone: evaluate hello_world module", {
  env := empty_env();

  // ── Build the function definition: (fn(using(io : IO)) -> unit)({ io; }) ──
  params_hw := ArrayList(AstExpr).new();
  params_hw.push(make_using_param("io", "IO"));
  stmts_hw := ArrayList(AstExpr).new();
  stmts_hw.push(make_ident("io"));
  fn_def_hw := make_typed_fn_def(params_hw, make_ident("unit"), make_begin(stmts_hw));

  // ── Build: main :: fn_def_hw (infix ::) ──
  bind_main := make_infix("::", make_ident("main"), fn_def_hw);

  // ── Build: export main; ──
  export_names_hw := ArrayList(str).new();
  export_names_hw.push("main");
  export_main_hw := make_export(export_names_hw);

  // ── Assemble the module body ──
  module_exprs := ArrayList(AstExpr).new();
  module_exprs.push(bind_main);
  module_exprs.push(export_main_hw);

  // ── Evaluate the module ──
  result := evaluate_module_body(module_exprs, &env);

  // ── Verify the result is a ModuleVal exporting "main" as a FuncVal ──
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(mod_names, mod_values) => {
          assert((mod_names.len() == usize(1)), "exactly 1 export");
          match(mod_names.get(usize(0)),
            .Some(n) => assert((n.as_str() == "main"), "exported name is main"),
            .None    => assert(false, "no exported name")
          );
          match(mod_values.get(usize(0)),
            .Some(fn_val) => match(fn_val,
              .FuncVal(_, ps, _, ev_ps, _, _, _, _, _) => {
                assert((ps.len() == usize(0)), "main has no regular params");
                assert((ev_ps.len() == usize(1)), "main has 1 evidence param");
                match(ev_ps.get(usize(0)),
                  .Some(evn) => assert((evn.as_str() == "io"), "evidence param is io"),
                  .None      => assert(false, "no evidence param name")
                );
              },
              _ => assert(false, "exported main is not a FuncVal")
            ),
            .None => assert(false, "no exported value")
          );
        },
        _ => assert(false, "result is not a ModuleVal")
      )
  );
};

// ---------------------------------------------------------------------------
// Phase 3z — Type definition keyword handlers
// (enum, struct, object, newtype, union, trait)
// ---------------------------------------------------------------------------

/// Helper: build a fresh env with `T` bound to `TypeVal(i32)`.
make_env_with_T :: (fn() -> Environment)({
  env := Environment.new(`T_env`);
  (ti32 : TypeValue) = t_i32();
  _ := (&env).define_val(
    String.from("T"),
    t_type(),
    true,
    .Some(.TypeVal(box(ti32)))
  );
  env
});

test "evaluate_module_body: enum type definition binds in module env", {
  env := empty_env();

  // Parse: Color :: enum(Red, Green, Blue); export Color;
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  exprs := generate_exprs_from_code(
    "Color :: enum(Red, Green, Blue); export Color;",
    using(exn)
  );

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "1 export");
          match(names.get(usize(0)),
            .Some(n) => assert((n.as_str() == "Color"), "export is Color"),
            .None => assert(false, "no export name")
          );
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                .TypeVal(tyb) =>
                  match(tyb.*,
                    .EnumT(_, _, vnames, _, _, _, _) => {
                      assert((vnames.len() == usize(3)), "3 variants");
                      match(vnames.get(usize(0)), .Some(n) => assert((n.as_str() == "Red"), "Red"), .None => assert(false, "no variant 0"));
                      match(vnames.get(usize(1)), .Some(n) => assert((n.as_str() == "Green"), "Green"), .None => assert(false, "no variant 1"));
                      match(vnames.get(usize(2)), .Some(n) => assert((n.as_str() == "Blue"), "Blue"), .None => assert(false, "no variant 2"));
                    },
                    _ => assert(false, "Color is not EnumT")
                  ),
                _ => assert(false, "Color export is not TypeVal")
              ),
            .None => assert(false, "no export value")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

test "evaluate_module_body: struct type definition binds in module env", {
  env := empty_env();

  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  exprs := generate_exprs_from_code(
    "Point :: struct(x: i32, y: i32); export Point;",
    using(exn)
  );

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "1 export");
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                .TypeVal(tyb) =>
                  match(tyb.*,
                    .Struct(_, _, labels, _, _, _, _) => {
                      assert((labels.len() == usize(2)), "2 fields");
                      match(labels.get(usize(0)), .Some(l) => assert((l.as_str() == "x"), "x field"), .None => assert(false, "no label 0"));
                      match(labels.get(usize(1)), .Some(l) => assert((l.as_str() == "y"), "y field"), .None => assert(false, "no label 1"));
                    },
                    _ => assert(false, "Point is not Struct")
                  ),
                _ => assert(false, "Point is not TypeVal")
              ),
            .None => assert(false, "no export value")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

test "evaluate_module_body: generic comptime function MyOption(i32) returns EnumT", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  src := "MyOption :: (fn(comptime(T) : Type) -> comptime(Type))(enum(None, Some(value: T))); MyI32Opt :: MyOption(i32); export MyI32Opt;";
  exprs := generate_exprs_from_code(src, using(exn));

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "1 export");
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                .TypeVal(tyb) =>
                  match(tyb.*,
                    .EnumT(_, _, vnames, _, _, _, _) => {
                      assert((vnames.len() == usize(2)), "2 variants");
                      match(vnames.get(usize(0)), .Some(n) => assert((n.as_str() == "None"), "None"), .None => assert(false, "no v0"));
                      match(vnames.get(usize(1)), .Some(n) => assert((n.as_str() == "Some"), "Some"), .None => assert(false, "no v1"));
                    },
                    _ => assert(false, "not EnumT")
                  ),
                _ => assert(false, "not TypeVal")
              ),
            .None => assert(false, "no export value")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

// ---------------------------------------------------------------------------
// Phase 3aa — Instance method dispatch via _try_find_receiver_method
// ---------------------------------------------------------------------------

test "evaluate_module_body: impl non-generic method dispatch returns field value", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  // Define struct, impl method, construct instance, call method.
  // The simplified evaluator stores numeric casts as IntLit, not I32Val.
  src := "Point :: struct(x: i32, y: i32); impl(Point, get_x: (fn(self: Point) -> i32)(self.x)); p := Point(x: i32(3), y: i32(4)); val := p.get_x(); export val;";
  exprs := generate_exprs_from_code(src, using(exn));

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "1 export");
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                // The simplified evaluator propagates IntLit (compile-time int literal)
                // through struct fields — i32(3) stores as IntLit("3") not I32Val(3).
                .IntLit(raw) => assert((raw.as_str() == "3"), "val raw is '3'"),
                _ => assert(false, "not IntLit")
              ),
            .None => assert(false, "no export value")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

test "evaluate_module_body: impl method with multiple params dispatch", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  // Method that takes self and an additional argument. (self.count + n)
  src := "Counter :: struct(count: i32); impl(Counter, add: (fn(self: Counter, n: i32) -> i32)((self.count + n))); c := Counter(count: i32(10)); val := c.add(i32(5)); export val;";
  exprs := generate_exprs_from_code(src, using(exn));

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "1 export");
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                // i32(10) + i32(5) = IntLit("15") in the simplified evaluator
                .IntLit(raw) => assert((raw.as_str() == "15"), "val raw is '15'"),
                _ => assert(false, "not IntLit")
              ),
            .None => assert(false, "no export value")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

// ---------------------------------------------------------------------------
// Phase 3ac: closure capture and higher-order function tests
// ---------------------------------------------------------------------------

test "evaluate_module_body: closure captures outer variable (Phase 3ac)", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  // x is defined before add_x; the closure captures x from the outer scope.
  src := "x := i32(10); add_x := (fn(n : i32) -> i32)((n + x)); result := add_x(i32(5)); export result;";
  exprs := generate_exprs_from_code(src, using(exn));

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "1 export");
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                // 5 + 10 = 15
                .IntLit(raw) => assert((raw.as_str() == "15"), "result is 15"),
                _ => assert(false, "not IntLit")
              ),
            .None => assert(false, "no export value")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

test "evaluate_module_body: higher-order function (fn passed as argument)", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  // apply calls f(n); double(x) = x + x; apply(double, 7) = 14
  src := "double := (fn(x : i32) -> i32)((x + x)); apply := (fn(f : i32, n : i32) -> i32)(f(n)); result := apply(double, i32(7)); export result;";
  exprs := generate_exprs_from_code(src, using(exn));

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "1 export");
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                // double(7) = 14
                .IntLit(raw) => assert((raw.as_str() == "14"), "result is 14"),
                _ => assert(false, "not IntLit")
              ),
            .None => assert(false, "no export value")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

test "evaluate_module_body: closure returned from function captures parameter", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  // make_adder returns a closure that adds n; add5(3) should be 8
  src := "make_adder := (fn(n : i32) -> i32)((fn(x : i32) -> i32)((x + n))); add5 := make_adder(i32(5)); result := add5(i32(3)); export result;";
  exprs := generate_exprs_from_code(src, using(exn));

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "1 export");
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                // add5(3) = 3 + 5 = 8
                .IntLit(raw) => assert((raw.as_str() == "8"), "result is 8"),
                _ => assert(false, "not IntLit")
              ),
            .None => assert(false, "no export value")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

test "evaluate_module_body: absolute value using cond and comparison (Phase 3ac)", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  // abs_val: returns 0-x when x<0, else x
  src := "abs_val := (fn(x : i32) -> i32)(cond(((x < i32(0))) => (i32(0) - x), true => x)); r1 := abs_val(i32(-5)); r2 := abs_val(i32(3)); export r1; export r2;";
  exprs := generate_exprs_from_code(src, using(exn));

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(2)), "2 exports");
          // r1 = abs_val(-5) = 5
          match(vals.get(usize(0)),
            .Some(v1) =>
              match(v1,
                .IntLit(r1) => assert((r1.as_str() == "5"), "r1 is 5"),
                _ => assert(false, "r1 not IntLit")
              ),
            .None => assert(false, "no r1")
          );
          // r2 = abs_val(3) = 3
          match(vals.get(usize(1)),
            .Some(v2) =>
              match(v2,
                .IntLit(r2) => assert((r2.as_str() == "3"), "r2 is 3"),
                _ => assert(false, "r2 not IntLit")
              ),
            .None => assert(false, "no r2")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

// ---------------------------------------------------------------------------
// Phase 3ae — while loop accumulator, match .Some(x) binding, nested calls
// ---------------------------------------------------------------------------

test "evaluate_module_body: while loop accumulates sum 1..5 = 15", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { _ := err; assert(false, "parse error"); escape (); }));
  // sum_to_five: accumulate 1+2+3+4+5 using a while loop
  src := "sum_to_five := (fn() -> i32)({ (s : i32) = i32(0); (n : i32) = i32(1); while runtime(((n <= i32(5)))), { s = (s + n); n = (n + i32(1)); }; s }); result := sum_to_five(); export result;";
  exprs := generate_exprs_from_code(src, using(exn));

  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "evaluate_module_body returned None"),
    .Some(mod_val) =>
      match(mod_val,
        .ModuleVal(names, vals) => {
          assert((names.len() == usize(1)), "1 export");
          match(vals.get(usize(0)),
            .Some(v) =>
              match(v,
                // 1+2+3+4+5 = 15
                .IntLit(raw) => assert((raw.as_str() == "15"), "result is 15"),
                _ => assert(false, "not IntLit")
              ),
            .None => assert(false, "no export value")
          );
        },
        _ => assert(false, "not ModuleVal")
      )
  );
};

