// ---------------------------------------------------------------------------
// Phase 5arb — Enum with data and destructuring match
// ---------------------------------------------------------------------------
test("Phase 5arb: enum None variant has empty fields tag is None", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "MyOpt :: enum(None, Some(i32));\nval := MyOpt.None;\nexport(val);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .EnumVal(tag, fields) => {
              assert(tag.as_str() == ".None", "None");
              assert(fields.len() == usize(0), "empty");
            },
            _ => assert(false, "EnumVal")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5arb: enum Some variant holds inner value 42", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "MyOpt :: enum(None, Some(i32));\nval := MyOpt.Some(i32(42));\nexport(val);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .EnumVal(tag, fields) => {
              assert(tag.as_str() == ".Some", ".Some");
              assert(fields.len() == usize(1), "1 field");
              match(
                fields.get(usize(0)),
                .Some(inner) => match(inner,.IntLit(n) => assert(n.as_str() == "42", "42"), _ => assert(false, "inner")),
                .None => assert(false, "fields")
              );
            },
            _ => assert(false, "EnumVal")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

