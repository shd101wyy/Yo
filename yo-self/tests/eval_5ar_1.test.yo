// ---------------------------------------------------------------------------
// Phase 5ard — Enum array mapping and folding
// ---------------------------------------------------------------------------
test("Phase 5ard: map enum array to integers gives length three", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "Color :: enum(Red, Green, Blue);\ncolors := [Color.Red, Color.Green, Color.Blue];\nnums := colors.map((fn(c : Color) -> i32)(match(c, .Red => i32(1), .Green => i32(2), .Blue => i32(3))));\nexport(nums.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5ard: map enum array first element is Red equals one", {
  env := empty_env();
  given(exn) := Exception(
