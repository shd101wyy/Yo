// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5ar series: enum definitions, enum+match dispatch,
/// modulo operator, and complex mixed programs.
///
/// Phases covered:
///   5ara — Simple enum variants and match dispatch to integers
///   5arb — Enum with data (None/Some/Both) and destructuring match
///   5arc — Modulo operator and even/odd filtering
///   5ard — Enum array mapping and folding
///   5are — Mixed: enum+fold, modulo+fold, struct+filter, equality check
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5ara — Simple enum variants and match dispatch
// ---------------------------------------------------------------------------
test("Phase 5ara: enum match dispatches Green to integer two", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "Color :: enum(Red, Green, Blue);\nto_num := (fn(c : Color) -> i32)(match(c, .Red => i32(1), .Green => i32(2), .Blue => i32(3)));\nresult := to_num(Color.Green);\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

