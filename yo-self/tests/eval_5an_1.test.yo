// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5an series: chained method pipelines.
/// Covers parse_i64 + Option chains, string pipelines (trim/case/substring),
/// ArrayVal reverse+get combos, Result.ok/err/unwrap chains, and
/// multi-variable complex programs.
///
/// Phases covered:
///   5ana — parse_i64 chained with is_some/is_none/unwrap_or
///   5anb — String method pipelines (trim+len, to_upper+ends_with, to_lower+starts_with, substring+len)
///   5anc — ArrayVal reverse+first/last and get+is_some/is_none
///   5and — Result.ok/err/unwrap chains
///   5ane — Multi-variable programs: max via variables, uppercase pipeline, filter+len, split+len
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5ana — parse_i64 chained with Option methods
// ---------------------------------------------------------------------------
test("Phase 5ana: parse_i64 on valid string gives is_some true", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "s := \"42\";\nresult := s.parse_i64().is_some();\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "is_some"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

