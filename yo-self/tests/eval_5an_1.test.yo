// ---------------------------------------------------------------------------
// Phase 5anc — ArrayVal reverse+first/last and get+is_some/is_none
// ---------------------------------------------------------------------------
test("Phase 5anc: reverse then first returns last element of original", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(3), i32(1), i32(4)];\nresult := arr.reverse().first();\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(
            x,
            .EnumVal(tag, fields) => {
              assert(tag.as_str() == ".Some", "Some");
              match(
                fields.get(usize(0)),
                .Some(inner) => match(inner,.IntLit(n) => assert(n.as_str() == "4", "4"), _ => assert(false, "t")),
                .None => assert(false, "f")
              );
            },
            _ => assert(false, "t")
          ),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 5anc: reverse then last returns first element of original", {
