              match(
                fields.get(usize(0)),
                .Some(inner) => match(inner,.IntLit(n) => assert(n.as_str() == "3", "3"), _ => assert(false, "t")),
                .None => assert(false, "f")
              );
            },
            _ => assert(false, "t")
          ),
