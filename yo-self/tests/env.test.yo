//! Tests for the self-hosted Environment.

open import "std/string";
{ TypeValue, t_i32, t_bool, t_f32 } :: import "../types/type.yo";
{ Environment } :: import "../env/env.yo";

test "define and lookup in single frame", {
  env := Environment.new(`mod`);
  _d0 := env.define(`x`, t_i32(), false);
  _d1 := env.define(`flag`, t_bool(), true);

  assert(env.contains(`x`), "x bound");
  assert(env.contains(`flag`), "flag bound");
  assert(!(env.contains(`missing`)), "missing not bound");

  match(env.lookup(`x`),
    .Some(v) => {
      assert((v.name == `x`), "x name");
      assert(!(v.is_compile_time_only), "x runtime");
    },
    .None => assert(false, "x lookup must succeed")
  );
  match(env.lookup(`flag`),
    .Some(v) => assert(v.is_compile_time_only, "flag is comptime"),
    .None => assert(false, "flag lookup must succeed")
  );
};

test "push_frame / pop_frame and frame_level", {
  env := Environment.new(`mod`);
  _d2 := env.define(`outer`, t_i32(), false);

  base := env.frame_count();
  pushed_idx := env.push_frame(true);
  assert((env.frame_count() == (base + usize(1))), "frame count grew");
  assert((pushed_idx == base), "pushed index = old count");

  _d3 := env.define(`inner`, t_f32(), false);
  match(env.lookup(`inner`),
    .Some(v) => assert((v.frame_level == base), "inner frame_level"),
    .None => assert(false, "inner must be visible")
  );
  match(env.lookup(`outer`),
    .Some(v) => assert((v.frame_level == usize(0)), "outer frame_level=0"),
    .None => assert(false, "outer must be visible from inner")
  );

  env.pop_frame();
  assert((env.frame_count() == base), "frame count shrank");
  assert(!(env.contains(`inner`)), "inner gone after pop");
  assert(env.contains(`outer`), "outer still here");
};

test "shadowing returns innermost binding", {
  env := Environment.new(`mod`);
  _d4 := env.define(`x`, t_i32(), false);
  _d5 := env.push_frame(true);
  _d6 := env.define(`x`, t_bool(), true);

  match(env.lookup(`x`),
    .Some(v) => {
      assert(v.is_compile_time_only, "innermost is comptime bool");
    },
    .None => assert(false, "x must be visible")
  );

  env.pop_frame();
  match(env.lookup(`x`),
    .Some(v) => assert(!(v.is_compile_time_only), "outer x is runtime i32"),
    .None => assert(false, "outer x must be visible after pop")
  );
};
