/// Tests for yo-self/codegen/exprs/assignment.yo (partial port).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr } :: import("../expr.yo");
{
  is_initialization_assignment_lhs,
  unwrap_initialization_lhs,
  is_skipped_assignment_lhs
} :: import("../codegen/exprs/assignment.yo");
mk_token :: (fn(value : str) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
mk_atom :: (fn(value : str) -> AstExpr)(
  AstExpr.Atom(usize(0), mk_token(value))
);
/// Build a 2-arg call: `func(a, b)`.
mk_call_2 :: (fn(func_name : str, a : AstExpr, b : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(a);
  args.push(b);
  AstExpr.FnCall(
    usize(0),
    box(mk_atom(func_name)),
    args,
    true,
    mk_token(func_name)
  )
});
test("is_initialization_assignment_lhs: bare atom → false", {
  assert(
    !(is_initialization_assignment_lhs(mk_atom("x"))),
    "atom is not init"
  );
});
test("is_initialization_assignment_lhs: `name : T` is the init shape", {
  expr := mk_call_2(":", mk_atom("count"), mk_atom("i32"));
  assert(
    is_initialization_assignment_lhs(expr),
    "name : T → true"
  );
});
test("is_initialization_assignment_lhs: `name + T` is NOT the init shape", {
  expr := mk_call_2("+", mk_atom("count"), mk_atom("1"));
  assert(
    !(is_initialization_assignment_lhs(expr)),
    "+ → false"
  );
});
test("is_initialization_assignment_lhs: 1-arg `:` is NOT init", {
  // The TS check requires exactly 2 args. A 1-arg `:` would only
  // happen in degenerate AST shapes; the helper must reject it.
  args := ArrayList(AstExpr).new();
  args.push(mk_atom("count"));
  expr := AstExpr.FnCall(
    usize(0),
    box(mk_atom(":")),
    args,
    true,
    mk_token(":")
  );
  assert(
    !(is_initialization_assignment_lhs(expr)),
    "1-arg : → false"
  );
});
test("unwrap_initialization_lhs: init form returns the name", {
  inner := mk_atom("count");
  type_ann := mk_atom("i32");
  expr := mk_call_2(":", inner, type_ann);
  match(
    unwrap_initialization_lhs(expr),
    .Atom({ token }) => assert(token.value == String.from("count"), "got count"),
    .FnCall(_, _, _, _, _) => assert(false, "expected atom")
  );
});
test("unwrap_initialization_lhs: non-init form is returned unchanged", {
  expr := mk_call_2("+", mk_atom("a"), mk_atom("b"));
  match(
    unwrap_initialization_lhs(expr),
    .Atom(_, _) => assert(false, "expected fn call"),
    .FnCall({ token }) => assert(token.value == String.from("+"), "+ unchanged")
  );
});
test("unwrap_initialization_lhs: bare atom is returned unchanged", {
  match(
    unwrap_initialization_lhs(mk_atom("x")),
    .Atom({ token }) => assert(token.value == String.from("x"), "x unchanged"),
    .FnCall(_, _, _, _, _) => assert(false, "expected atom")
  );
});
test("is_skipped_assignment_lhs: comptime(x) → true", {
  // assignment.ts skips emit when LHS is `comptime(...)` with any
  // arity. Build a `comptime(y)` shape via mk_fn_call.
  args := ArrayList(AstExpr).new();
  args.push(mk_atom("y"));
  expr := AstExpr.FnCall(
    usize(0),
    box(mk_atom("comptime")),
    args,
    false,
    mk_token("comptime")
  );
  assert(is_skipped_assignment_lhs(expr) == true, "comptime(y)");
});
test("is_skipped_assignment_lhs: given(x) → true", {
  args := ArrayList(AstExpr).new();
  args.push(mk_atom("ctx"));
  expr := AstExpr.FnCall(
    usize(0),
    box(mk_atom("given")),
    args,
    false,
    mk_token("given")
  );
  assert(is_skipped_assignment_lhs(expr) == true, "given(ctx)");
});
test("is_skipped_assignment_lhs: plain identifier → false", {
  // Only `comptime(...)` and `given(...)` call shapes count; bare
  // identifiers fall through to the normal assignment path.
  assert(is_skipped_assignment_lhs(mk_atom("x")) == false, "atom x");
});
test("is_skipped_assignment_lhs: arity-unrestricted", {
  // assignment.ts uses `exprIsFunctionCallOf(lhs, "comptime")` without
  // the arity argument — meaning `comptime()` (zero args) or
  // `comptime(a, b)` (two args) also skip emit. Pin that contract.
  no_args := ArrayList(AstExpr).new();
  zero_arg := AstExpr.FnCall(
    usize(0),
    box(mk_atom("comptime")),
    no_args,
    false,
    mk_token("comptime")
  );
  assert(is_skipped_assignment_lhs(zero_arg) == true, "comptime()");
  two_args := ArrayList(AstExpr).new();
  two_args.push(mk_atom("a"));
  two_args.push(mk_atom("b"));
  two_arg := AstExpr.FnCall(
    usize(0),
    box(mk_atom("comptime")),
    two_args,
    false,
    mk_token("comptime")
  );
  assert(is_skipped_assignment_lhs(two_arg) == true, "comptime(a, b)");
});
