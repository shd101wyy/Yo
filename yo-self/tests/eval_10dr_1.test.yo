// @skip_wasm32-emscripten
// @skip_wasm32-wasi
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
empty_env :: (fn() -> Environment)(Environment.new(`test`));

test("Phase 12qg/10dr: T1 running_max_sum of [10,9,5,3,10,7] = 60", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(10), i32(9), i32(5), i32(3), i32(10), i32(7)];\ns := i32(0); mx := i32(0); i := i32(0);\nwhile((i < i32(6)), {\nv := arr.get(i).unwrap(); mx = cond((v > mx) => v, true => mx); s = (s + mx); i = (i + i32(1));\n});\npms := s;\nr := pms;\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "60", "60"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 12qg/10dr: T2 running_min_sum_rev of [5,10,8,6,3,12,9] = 33", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(5), i32(10), i32(8), i32(6), i32(3), i32(12), i32(9)];\ns := i32(0); mn := i32(9999); i := i32(6);\nwhile((i >= i32(0)), {\nv := arr.get(i).unwrap(); mn = cond((v < mn) => v, true => mn); s = (s + mn); i = (i - i32(1));\n});\nr := s;\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "33", "33"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 12qg/10dr: T3 new_max_count of [1,14,13,10,5,8,10,8] = 2", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(1), i32(14), i32(13), i32(10), i32(5), i32(8), i32(10), i32(8)];\ncnt := i32(0); mx := i32(0); i := i32(0);\nwhile((i < i32(8)), {\nv := arr.get(i).unwrap(); is_new := (v > mx); mx = cond(is_new => v, true => mx); cnt = cond(is_new => (cnt + i32(1)), true => cnt); i = (i + i32(1));\n});\nr := cnt;\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

