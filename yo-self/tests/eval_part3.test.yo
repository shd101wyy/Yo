    match(v.get(usize(1)), .Some(x) => match(x, .EnumVal(_, fields) => match(fields.get(usize(0)), .Some(fv) => match(fv, .IntLit(n) => assert((n.as_str() == "4"), "last=4"), _ => assert(false, "i")), .None => assert(false, "f")), _ => assert(false, "t")), .None => assert(false, "v"));
