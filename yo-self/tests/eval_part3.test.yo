  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "s := \"abracadabra\";\ntarget := \"a\";\n(count : i32) = i32(0);\n(i : i32) = i32(0);\nwhile((i < s.len()), {\ncond((s.char_at(i.to_usize()) == target) => { count = (count + i32(1)); }, true => ());\ni = (i + i32(1));\n});\nexport count;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "5"), "5 a's in abracadabra"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

test "Phase 5he: recursive merge count", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "total_sum := (fn(n : i32, acc : i32) -> i32)(cond((n <= i32(0)) => acc, true => recur((n - i32(1)), (acc + n))));\nexport total_sum(i32(100), i32(0));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "5050"), "sum(100)=5050"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

