test "Phase 5fi: power of 2 check", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "is_pow2 := (fn(n : i32) -> bool)(cond((n <= i32(0)) => false, true => {\n(x : i32) = n;\nwhile (((x % i32(2)) == i32(0))), {\nx = (x / i32(2));\n};\n(x == i32(1))\n}));\nexport is_pow2(i32(16));\nexport is_pow2(i32(15));\nexport is_pow2(i32(1));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .BoolVal(b) => assert(b, "16 pow2"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .BoolVal(b) => assert(!(b), "15 not"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .BoolVal(b) => assert(b, "1 pow2"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

