test "Phase 5gp: cond cascade with accumulator", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "grade := (fn(score : i32) -> i32)(cond((score >= i32(90)) => i32(4), (score >= i32(80)) => i32(3), (score >= i32(70)) => i32(2), (score >= i32(60)) => i32(1), true => i32(0)));\nscores := [i32(95), i32(85), i32(72), i32(55), i32(88)];\n(total_gpa : i32) = i32(0);\nfor(s, scores, { total_gpa = (total_gpa + grade(s)); });\nexport total_gpa;\nexport (total_gpa / scores.len());";
