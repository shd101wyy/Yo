test "Phase 5fi: fibonacci memoize-like array", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "fibs := [i32(0), i32(1)];\n(i : i32) = i32(2);\nwhile (i <= i32(10)), {\nmatch(fibs.get((i - i32(1)).to_usize()), .Some(a) => match(fibs.get((i - i32(2)).to_usize()), .Some(b) => fibs.push((a + b)), .None => ()), .None => ());\ni = (i + i32(1));\n};\nexport fibs.len();\nexport fibs.last();";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "11"), "11 fibs"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .EnumVal(tag, fields) => {
      match(fields.get(usize(0)), .Some(fv) => match(fv, .IntLit(n) => assert((n.as_str() == "55"), "fib(10)=55"), _ => assert(false, "i")), .None => assert(false, "f"));
    }, _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5fi: while with continue", {
