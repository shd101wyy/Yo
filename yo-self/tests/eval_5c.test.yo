// ---------------------------------------------------------------------------
// Phase 3d helpers: build enum-variant AST nodes
// ---------------------------------------------------------------------------

/// Build the dot-token and dot-atom.
make_dot_tok :: (fn() -> Token)(make_token(TokenKind.Dot, "."));
make_dot_atom :: (fn() -> AstExpr)(make_atom(TokenKind.Dot, "."));

/// Build a fieldless enum variant: `.None`
/// Parsed representation: FnCall(Atom(Dot), [Atom(Identifier, "None")], is_infix=true)
make_fieldless_variant :: (fn(name : str) -> AstExpr)(
  .FnCall(usize(0), 
    box(make_dot_atom()),
    {
      a := ArrayList(AstExpr).new();
      a.push(make_ident(name));
      a
    },
    true,
    make_dot_tok()
  )
);

/// Build a variant-with-args call: `.Some(arg)`
/// Representation: FnCall(FnCall(Atom(Dot), [Atom("Some")], true), [arg], false)
make_variant_call :: (fn(name : str, args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(usize(0), 
    box(make_fieldless_variant(name)),
    args,
    false,
    make_token(TokenKind.Identifier, name)
  )
);

/// Build a `match(scrutinee, arm1, …)` call.
make_match :: (fn(scrutinee : AstExpr, arms : ArrayList(AstExpr)) -> AstExpr)({
  all := ArrayList(AstExpr).new();
  all.push(scrutinee);
  (i : usize) = usize(0);
  while(runtime((i < arms.len())), {
    match(arms.get(i),
      .Some(arm) => { all.push(arm); },
      .None => ()
    );
    i = (i + usize(1));
  });
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "match"))),
    all,
    false,
    make_token(TokenKind.Identifier, "match")
  )
});

/// Build `while condition, body`.
make_while :: (fn(cond_expr : AstExpr, body_expr : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(cond_expr);
  args.push(body_expr);
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "while"))),
    args,
    false,
    make_token(TokenKind.Identifier, "while")
  )
});

/// Build `runtime(expr)`.
make_runtime :: (fn(inner : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(inner);
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "runtime"))),
    args,
    false,
    make_token(TokenKind.Identifier, "runtime")
  )
});

