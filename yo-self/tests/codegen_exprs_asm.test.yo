/// Tests for yo-self/codegen/exprs/asm.yo (partial port — pure
/// string helpers).
open(import("std/string"));
{
  is_register_class,
  resolve_constraint,
  transform_template,
  format_asm_placeholder
} :: import("../codegen/exprs/asm.yo");
test("is_register_class: known classes", {
  assert(is_register_class("reg"), "reg");
  assert(is_register_class("reg_byte"), "reg_byte");
  assert(is_register_class("xmm_reg"), "xmm_reg");
  assert(is_register_class("imm"), "imm");
  assert(is_register_class("mem"), "mem");
});
test("is_register_class: unknowns", {
  assert(!(is_register_class("rax")), "rax is a register name");
  assert(!(is_register_class("r")), "r is a GCC letter");
  assert(!(is_register_class("")), "empty");
});
test("resolve_constraint: empty → default r", {
  assert(resolve_constraint("", "x86_64") == String.from("r"), "default");
});
test("resolve_constraint: raw:... passes through", {
  assert(
    resolve_constraint("raw:cc", "x86_64") == String.from("cc"),
    "raw passthrough"
  );
  assert(
    resolve_constraint("raw:&=r", "x86_64") == String.from("&=r"),
    "raw with special chars"
  );
});
test("resolve_constraint: explicit register mapping", {
  assert(
    resolve_constraint("rax", "x86_64") == String.from("a"),
    "rax → a"
  );
  assert(
    resolve_constraint("rsi", "x86_64") == String.from("S"),
    "rsi → S"
  );
  assert(
    resolve_constraint("rdi", "x86_64") == String.from("D"),
    "rdi → D"
  );
});
test("resolve_constraint: register class dispatch", {
  assert(
    resolve_constraint("reg", "x86_64") == String.from("r"),
    "reg/x86_64 → r"
  );
  assert(
    resolve_constraint("xmm_reg", "x86_64") == String.from("x"),
    "xmm_reg/x86_64 → x"
  );
  assert(
    resolve_constraint("xmm_reg", "aarch64") == String.from("w"),
    "xmm_reg/aarch64 → w"
  );
  assert(
    resolve_constraint("mem", "arm") == String.from("m"),
    "mem → m"
  );
});
test("resolve_constraint: unknown → returned unchanged", {
  // Treated as a raw GCC constraint.
  assert(
    resolve_constraint("X", "x86_64") == String.from("X"),
    "X unchanged"
  );
});
test("transform_template: passes through literal text", {
  assert(
    transform_template("nop") == String.from("nop"),
    "no placeholders"
  );
  assert(
    transform_template("") == String.from(""),
    "empty"
  );
});
test("transform_template: {0} → %0", {
  assert(
    transform_template("mov {0}, {1}") == String.from("mov %0, %1"),
    "positional"
  );
});
test("transform_template: {name} → %[name]", {
  assert(
    transform_template("mov {dst}, {src}") == String.from("mov %[dst], %[src]"),
    "named"
  );
});
test("transform_template: {name:e} → %k[name]", {
  // The `e` modifier maps to GCC `k` (32-bit register).
  assert(
    transform_template("mov {dst:e}, {src:e}") == String.from("mov %k[dst], %k[src]"),
    "named + modifier"
  );
});
test("transform_template: {0:e} → %k0", {
  assert(
    transform_template("mov {0:e}, {1:e}") == String.from("mov %k0, %k1"),
    "positional + modifier"
  );
});
test("transform_template: {{ and }} are literal braces", {
  assert(
    transform_template("{{ {0} }}") == String.from("{ %0 }"),
    "double-brace escapes"
  );
});
test("transform_template: unknown modifier passes through", {
  // The `foo` modifier isn't in the per-arch table, so it should be
  // copied through verbatim.
  assert(
    transform_template("{x:foo}") == String.from("%foo[x]"),
    "unknown modifier"
  );
});
test("transform_template: unclosed `{` is copied as-is", {
  assert(
    transform_template("foo {") == String.from("foo {"),
    "unclosed brace"
  );
});
// ─── format_asm_placeholder ─────────────────────────────────────────────────
test("format_asm_placeholder: positional, no modifier → %<n>", {
  out := format_asm_placeholder(Option(str).None, String.from("0"), true);
  assert(out == String.from("%0"), "positional bare");
});
test("format_asm_placeholder: positional + modifier → %<m><n>", {
  out := format_asm_placeholder(Option(str).Some("k"), String.from("0"), true);
  assert(out == String.from("%k0"), "positional w/ modifier");
});
test("format_asm_placeholder: named, no modifier → %[<ref>]", {
  out := format_asm_placeholder(Option(str).None, String.from("reg"), false);
  assert(out == String.from("%[reg]"), "named bare");
});
test("format_asm_placeholder: named + modifier → %<m>[<ref>]", {
  out := format_asm_placeholder(Option(str).Some("k"), String.from("reg"), false);
  assert(out == String.from("%k[reg]"), "named w/ modifier");
});
