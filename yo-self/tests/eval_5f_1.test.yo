        match(vals.get(usize(3)), .Some(v) => match(v, .StrLit(n) => { inner := n.substring(usize(1), (n.len() - usize(1))); assert((inner.as_str() == "medium"), "medium"); }, _ => assert(false, "not str")), .None => assert(false, "no"));
        match(vals.get(usize(4)), .Some(v) => match(v, .StrLit(n) => { inner := n.substring(usize(1), (n.len() - usize(1))); assert((inner.as_str() == "large"), "large"); }, _ => assert(false, "not str")), .None => assert(false, "no"));
