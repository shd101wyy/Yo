  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "arr := [i32(1), i32(2), i32(3)];\nresult := arr.map((fn(x : i32) -> i32)((x + i32(10)))).map((fn(x : i32) -> i32)((x * i32(2))));\nexport result.fold(i32(0), (fn(a : i32, b : i32) -> i32)((a + b)));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "72"), "22+24+26=72"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};
