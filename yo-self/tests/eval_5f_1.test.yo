test "Phase 5fb: module import via loader", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));

  set_module_loader((fn(path : String) -> Option(EvalValue))(
    cond(
      (path.as_str() == "mymod") => {
        names := ArrayList(String).new();
        vals := ArrayList(EvalValue).new();
        names.push(String.from("x"));
        vals.push(EvalValue.IntLit(String.from("99")));
        .Some(EvalValue.ModuleVal(names, vals))
      },
      true => Option(EvalValue).None
    )
  ));

  src := "m :: import \"mymod\";\nexport m;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);

  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .ModuleVal(_, inner_vals) => {
              match(inner_vals.get(usize(0)),
                .Some(iv) => match(iv, .IntLit(n) => assert((n.as_str() == "99"), "x=99"), _ => assert(false, "not IntLit")),
                .None => assert(false, "no inner val")
              );
            },
            _ => assert(false, "not inner ModuleVal")
          ),
          .None => assert(false, "no value")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

