open(import("std/string"));
open(import("std/fmt"));
{
  CompilerInfo,
  SanitizerKind,
  SanitizerFlags,
  get_compiler_info,
  get_sanitizer_flags,
  get_macos_lsan_suppressions
} :: import("../compiler_utils.yo");
// ---------------------------------------------------------------------------
// get_compiler_info
// ---------------------------------------------------------------------------
test("get_compiler_info: clang is not MSVC", {
  info := get_compiler_info(String.from("clang"));
  assert(!(info.is_msvc), "clang is not MSVC");
  assert(!(info.is_emcc), "clang is not emcc");
});
test("get_compiler_info: cl is MSVC", {
  info := get_compiler_info(String.from("cl"));
  assert(info.is_msvc, "cl is MSVC");
});
test("get_compiler_info: emcc is emcc", {
  info := get_compiler_info(String.from("emcc"));
  assert(info.is_emcc, "emcc detected");
  assert(!(info.is_msvc), "emcc is not MSVC");
});
test("get_compiler_info: compiler field preserved", {
  info := get_compiler_info(String.from("gcc"));
  assert(info.compiler == "gcc", "compiler name preserved");
});
// ---------------------------------------------------------------------------
// get_sanitizer_flags — Address sanitizer
// ---------------------------------------------------------------------------
test("get_sanitizer_flags: Address on non-Windows clang has -fsanitize=address", {
  info := get_compiler_info(String.from("clang"));
  // Force is_windows to false for this test — we test on a non-Windows host
  non_win_info := CompilerInfo(
    compiler : info.compiler,
    is_msvc : false,
    is_windows : false,
    is_gcc_on_windows : false,
    is_clang_on_windows : false,
    is_emcc : false
  );
  flags := get_sanitizer_flags(SanitizerKind.Address, non_win_info);
  has_asan := flags.flags.contains(String.from("-fsanitize=address"));
  assert(has_asan, "Address sanitizer includes -fsanitize=address");
  assert(flags.warning == Option(String).None, "no warning for non-Windows clang");
});
test("get_sanitizer_flags: Address on MSVC uses /fsanitize=address", {
  msvc_info := CompilerInfo(
    compiler : String.from("cl"),
    is_msvc : true,
    is_windows : true,
    is_gcc_on_windows : false,
    is_clang_on_windows : false,
    is_emcc : false
  );
  flags := get_sanitizer_flags(SanitizerKind.Address, msvc_info);
  has_msvc_flag := flags.flags.contains(String.from("/fsanitize=address"));
  assert(has_msvc_flag, "MSVC Address sanitizer flag");
});
test("get_sanitizer_flags: Address on MinGW returns empty flags with warning", {
  mingw_info := CompilerInfo(
    compiler : String.from("gcc"),
    is_msvc : false,
    is_windows : true,
    is_gcc_on_windows : true,
    is_clang_on_windows : false,
    is_emcc : false
  );
  flags := get_sanitizer_flags(SanitizerKind.Address, mingw_info);
  assert(flags.flags.len() == usize(0), "MinGW Address: no compiler flags");
  assert(flags.warning != Option(String).None, "MinGW Address: has warning");
});
// ---------------------------------------------------------------------------
// get_sanitizer_flags — Leak sanitizer
// ---------------------------------------------------------------------------
test("get_sanitizer_flags: Leak on non-Windows has -fsanitize=leak", {
  info := CompilerInfo(
    compiler : String.from("gcc"),
    is_msvc : false,
    is_windows : false,
    is_gcc_on_windows : false,
    is_clang_on_windows : false,
    is_emcc : false
  );
  flags := get_sanitizer_flags(SanitizerKind.Leak, info);
  has_leak := flags.flags.contains(String.from("-fsanitize=leak"));
  assert(has_leak, "Leak sanitizer flag on non-Windows");
});
test("get_sanitizer_flags: Leak on MSVC returns warning", {
  msvc_info := CompilerInfo(
    compiler : String.from("cl"),
    is_msvc : true,
    is_windows : true,
    is_gcc_on_windows : false,
    is_clang_on_windows : false,
    is_emcc : false
  );
  flags := get_sanitizer_flags(SanitizerKind.Leak, msvc_info);
  assert(flags.flags.len() == usize(0), "MSVC Leak: no flags");
  assert(flags.warning != Option(String).None, "MSVC Leak: has warning");
});
