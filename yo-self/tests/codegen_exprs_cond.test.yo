/// Tests for yo-self/codegen/exprs/cond.yo's pure string formatters.
///
/// The full `generate_cond` handler is exercised indirectly through
/// the evaluator-driven integration tests; this file pins the pure
/// formatters lifted from the inline emit calls so they keep their
/// canonical shapes under refactors.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{
  format_cond_temp_decl,
  format_cond_assignment_line,
  format_cond_if_open,
  format_cond_else_open,
  format_cond_block_open,
  format_cond_block_close
} :: import("../codegen/exprs/cond.yo");
test("format_cond_temp_decl: composes indented `<type> <name>;`", {
  out := format_cond_temp_decl(
    String.from("  "),
    String.from("int32_t"),
    String.from("tmp_u46_result")
  );
  assert(
    out == String.from("  int32_t tmp_u46_result;"),
    "indented cond temp decl"
  );
});
test("format_cond_temp_decl: empty indent yields bare decl", {
  out := format_cond_temp_decl(
    String.from(""),
    String.from("bool"),
    String.from("ok")
  );
  assert(out == String.from("bool ok;"), "no indent");
});
test("format_cond_assignment_line: composes `<lhs> = <rhs>;`", {
  out := format_cond_assignment_line(
    String.from("    "),
    String.from("tmp"),
    String.from("value")
  );
  assert(
    out == String.from("    tmp = value;"),
    "indented assignment line"
  );
});
test("format_cond_assignment_line: handles compound RHS expression", {
  out := format_cond_assignment_line(
    String.from(""),
    String.from("dest"),
    String.from("(int32_t)(x + 1)")
  );
  assert(
    out == String.from("dest = (int32_t)(x + 1);"),
    "compound RHS"
  );
});
test("format_cond_if_open: composes `<indent>if (<cond>) {`", {
  out := format_cond_if_open(String.from("  "), String.from("x > 0"));
  assert(out == String.from("  if (x > 0) {"), "if open shape");
});
test("format_cond_else_open: emits `<indent>else {`", {
  out := format_cond_else_open(String.from("  "));
  assert(out == String.from("  else {"), "else open shape");
});
test("format_cond_block_open: emits `<indent>{`", {
  out := format_cond_block_open(String.from(""));
  assert(out == String.from("{"), "block open shape");
});
test("format_cond_block_close: emits `<indent>}`", {
  out := format_cond_block_close(String.from("    "));
  assert(out == String.from("    }"), "block close shape");
});
