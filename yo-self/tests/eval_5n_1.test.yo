});
test("Phase 5na: for-loop any-match check in method (early-exit via flag)", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "S :: struct(items : ArrayList(i32), needle : i32);\nimpl(S, Search(\n  contains : (fn(s : S) -> bool)({\n    (found : bool) = false;\n    for(x, s.items, { cond((x == s.needle) => { found = true; }, true => ()); });\n    found\n  })\n));\narr := ArrayList(i32).new();\narr.push(i32(10));\narr.push(i32(42));\narr.push(i32(99));\ns := S(items: arr, needle: i32(42));\nexport(s.contains());\n";
