    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "60", "10*(1+2+3)=60"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5na: for-loop over local array (not struct field) inside method", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(base : i32);\nimpl(N, Math(\n  sum_up_to : (fn(n : N) -> i32)({\n    steps := ArrayList(i32).new();\n    steps.push(n.base);\n    steps.push((n.base + i32(1)));\n    steps.push((n.base + i32(2)));\n    (acc : i32) = i32(0);\n    for(x, steps, { acc = (acc + x); });\n    acc\n  })\n));\nx := N(base: i32(5));\nexport(x.sum_up_to());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "18", "5+6+7=18"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5na: two methods on ArrayList struct — sum and count", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "S :: struct(items : ArrayList(i32));\nimpl(S, Stats(\n  total : (fn(s : S) -> i32)({\n    (acc : i32) = i32(0);\n    for(x, s.items, { acc = (acc + x); });\n    acc\n  }),\n  count : (fn(s : S) -> i32)({\n    (cnt : i32) = i32(0);\n    for(x, s.items, { cnt = (cnt + i32(1)); });\n    cnt\n  })\n));\narr := ArrayList(i32).new();\narr.push(i32(10));\narr.push(i32(20));\narr.push(i32(30));\ns := S(items: arr);\nexport(s.total());\nexport(s.count());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(a) => match(a, .IntLit(n) => assert(n.as_str() == "60", "10+20+30=60"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(b) => match(b, .IntLit(n) => assert(n.as_str() == "3", "count=3"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
