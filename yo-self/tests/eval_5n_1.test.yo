    match(v.get(usize(0)), .Some(x) => match(x, .BoolVal(b) => assert(b, "contains 42 = true"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5na: for-loop combined with struct field mutation + method call", {
