    match(v.get(usize(1)), .Some(b) => match(b, .IntLit(n) => assert(n.as_str() == "20", "4+6+10=20"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
// ---------------------------------------------------------------------------
// Phase 5nb — helper functions callable from inside impl method bodies
