test("Phase 5nb: max helper fn called from impl method", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "max2 := (fn(a : i32, b : i32) -> i32)({ cond((a > b) => a, true => b) });\nN :: struct(a : i32, b : i32, c : i32);\nimpl(N, Max(\n  max_field : (fn(n : N) -> i32)({ max2(max2(n.a, n.b), n.c) })\n));\nx := N(a: i32(3), b: i32(9), c: i32(6));\nexport(x.max_field());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "9", "max=9"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5nb: helper clamp called from method with extra args", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "clamp := (fn(v : i32, lo : i32, hi : i32) -> i32)({ cond((v < lo) => lo, (v > hi) => hi, true => v) });\nN :: struct(v : i32);\nimpl(N, Math(\n  bounded : (fn(n : N) -> i32)({ clamp(n.v, i32(0), i32(10)) })\n));\na := N(v: i32(15));\nb := N(v: i32(-(3)));\nc := N(v: i32(5));\nexport(a.bounded());\nexport(b.bounded());\nexport(c.bounded());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(a) => match(a, .IntLit(n) => assert(n.as_str() == "10", "clamp(15)=10"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(b) => match(b, .IntLit(n) => assert(n.as_str() == "0", "clamp(-3)=0"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(c) => match(c, .IntLit(n) => assert(n.as_str() == "5", "clamp(5)=5"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5nb: recursive helper (factorial) called from impl method", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "fact := (fn(n : i32) -> i32)({ cond((n <= i32(1)) => i32(1), true => (n * recur((n - i32(1))))) });\nN :: struct(v : i32);\nimpl(N, Math(\n  factorial : (fn(n : N) -> i32)({ fact(n.v) })\n));\nx := N(v: i32(5));\nexport(x.factorial());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "120", "5!=120"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5nb: helper function + method calling sibling method", {
