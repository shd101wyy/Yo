// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5n series: for-loops in impl, helper fns, deep nesting.
///
/// Phases covered:
///   5na — for-loop inside impl method bodies (ArrayList field + iteration)
///   5nb — helper (free) functions callable from inside impl method bodies
///   5nc — three-and-four-level struct nesting (deeper than Phase 5la)
///   5nd — complex boolean and string combos in impl methods
///   5ne — free-function + impl + mutation + returning-struct combos

open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5na — for-loop inside impl method bodies
// ---------------------------------------------------------------------------
test("Phase 5na: struct with ArrayList field, sum via for-loop in method", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "S :: struct(items : ArrayList(i32));\nimpl(S, Sum(\n  total : (fn(s : S) -> i32)({\n    (acc : i32) = i32(0);\n    for(x, s.items, { acc = (acc + x); });\n    acc\n  })\n));\narr := ArrayList(i32).new();\narr.push(i32(1));\narr.push(i32(2));\narr.push(i32(3));\ns := S(items: arr);\nexport(s.total());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "6", "1+2+3=6"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5na: for-loop in method accumulating product", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "S :: struct(items : ArrayList(i32));\nimpl(S, Prod(\n  product : (fn(s : S) -> i32)({\n    (acc : i32) = i32(1);\n    for(x, s.items, { acc = (acc * x); });\n    acc\n  })\n));\narr := ArrayList(i32).new();\narr.push(i32(2));\narr.push(i32(3));\narr.push(i32(4));\ns := S(items: arr);\nexport(s.product());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "24", "2*3*4=24"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5na: for-loop counting matching elements in method", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "S :: struct(items : ArrayList(i32), target : i32);\nimpl(S, Count(\n  count_target : (fn(s : S) -> i32)({\n    (cnt : i32) = i32(0);\n    for(x, s.items, { cond((x == s.target) => { cnt = (cnt + i32(1)); }, true => ()); });\n    cnt\n  })\n));\narr := ArrayList(i32).new();\narr.push(i32(5));\narr.push(i32(3));\narr.push(i32(5));\narr.push(i32(7));\narr.push(i32(5));\ns := S(items: arr, target: i32(5));\nexport(s.count_target());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "3", "count(5)=3"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
