  }, _ => assert(false, "m")));
});
test("Phase 5na: for-loop with extra-int-arg method — scale then sum", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "S :: struct(items : ArrayList(i32));\nimpl(S, Scale(\n  scaled_sum : (fn(s : S, factor : i32) -> i32)({\n    (acc : i32) = i32(0);\n    for(x, s.items, { acc = (acc + (x * factor)); });\n    acc\n  })\n));\narr := ArrayList(i32).new();\narr.push(i32(1));\narr.push(i32(2));\narr.push(i32(3));\ns := S(items: arr);\nexport(s.scaled_sum(i32(10)));\n";
