test("Phase 5nb: helper fn + multi-trait impl, each trait using the helper", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "abs_val := (fn(n : i32) -> i32)({ cond((n < i32(0)) => (i32(0) - n), true => n) });\nN :: struct(a : i32, b : i32);\nimpl(N, Math(\n  abs_sum : (fn(n : N) -> i32)({ (abs_val(n.a) + abs_val(n.b)) })\n));\nimpl(N, Logic(\n  both_nonzero : (fn(n : N) -> bool)({ ((abs_val(n.a) > i32(0)) && (abs_val(n.b) > i32(0))) })\n));\nx := N(a: i32(-(3)), b: i32(4));\nexport(x.abs_sum());\nexport(x.both_nonzero());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(a) => match(a, .IntLit(n) => assert(n.as_str() == "7", "3+4=7"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(b) => match(b, .BoolVal(bv) => assert(bv, "both nonzero"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
