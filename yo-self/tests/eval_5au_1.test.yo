      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(1), i32(2), i32(3)];\nrev := arr.reverse();\ndoubled := rev.map((fn(x : i32) -> i32)((x * i32(2))));\nr := doubled.last().unwrap();\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
