// ---------------------------------------------------------------------------
// AST construction helpers
// ---------------------------------------------------------------------------
make_token_raw :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
make_atom_expr :: (fn(kind : TokenKind, value : str) -> AstExpr)(
  .Atom(usize(0), make_token_raw(kind, value))
);
make_infix_expr :: (fn(op : str, lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  op_tok := make_token_raw(TokenKind.Operator, op);
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), args, true, op_tok)
});
make_unary_expr :: (fn(op : str, operand : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(operand);
  op_tok := make_token_raw(TokenKind.Operator, op);
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), args, false, op_tok)
});
make_fncall_expr :: (fn(name : str, args : ArrayList(AstExpr)) -> AstExpr)({
  name_tok := make_token_raw(TokenKind.Identifier, name);
  .FnCall(usize(0), box(.Atom(usize(0), name_tok)), args, false, name_tok)
});
make_begin_expr :: (fn(stmts : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("begin", stmts)
);
make_cond_expr :: (fn(arms : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("cond", arms)
);
make_cond_arm :: (fn(cond_e : AstExpr, body_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(body_e);
  op_tok := make_token_raw(TokenKind.Operator, "=>");
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), a, true, op_tok)
});
make_if_expr :: (fn(cond_e : AstExpr, then_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(then_e);
  make_fncall_expr("if", a)
});
make_if_else_expr :: (fn(cond_e : AstExpr, then_e : AstExpr, else_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(then_e);
  a.push(else_e);
  make_fncall_expr("if", a)
});
make_while_expr :: (fn(cond_e : AstExpr, body_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(body_e);
  make_fncall_expr("while", a)
});
make_runtime_cond :: (fn(inner : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(inner);
  make_fncall_expr("runtime", a)
});
// Phase 4d helpers ——————————————————————————————————————————————————————————
/// Build `FnCall(Dot, [lhs, rhs], is_infix=true)` — dot field/variant access.
make_dot_expr :: (fn(lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(lhs);
  a.push(rhs);
  dot_tok := make_token_raw(TokenKind.Dot, ".");
  .FnCall(usize(0), box(.Atom(usize(0), dot_tok)), a, true, dot_tok)
});
/// Build `FnCall(FnCall(Dot, [obj, method], true), args, false)` — method call.
make_method_call_expr :: (fn(obj : AstExpr, method : str, args : ArrayList(AstExpr)) -> AstExpr)({
  dot_tok := make_token_raw(TokenKind.Dot, ".");
  method_tok := make_token_raw(TokenKind.Identifier, method);
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(obj);
  dot_args.push(AstExpr.Atom(usize(0), method_tok));
  dot_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  AstExpr.FnCall(usize(0), box(dot_expr), args, false, dot_tok)
});
/// Build `FnCall(":", [name_expr, ty_expr], is_infix=true)` — type annotation.
make_colon_expr :: (fn(name_e : AstExpr, ty_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(name_e);
  a.push(ty_e);
  colon_tok := make_token_raw(TokenKind.Operator, ":");
  .FnCall(usize(0), box(.Atom(usize(0), colon_tok)), a, true, colon_tok)
});
/// Build `FnCall("=", [lhs, rhs], is_infix=true)` — assignment or typed decl.
make_assign_expr :: (fn(lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(lhs);
  a.push(rhs);
  eq_tok := make_token_raw(TokenKind.Operator, "=");
  .FnCall(usize(0), box(.Atom(usize(0), eq_tok)), a, true, eq_tok)
});
/// Build a typed declaration `(x : T) = val`.
make_typed_decl_expr :: (fn(name : str, ty_name : str, val_e : AstExpr) -> AstExpr)(
  make_assign_expr(
    make_colon_expr(
      make_atom_expr(TokenKind.Identifier, name),
      make_atom_expr(TokenKind.Identifier, ty_name)
    ),
    val_e
  )
);
/// Convenience: run generate_expr with a fresh context and empty indent.
run_gen :: (fn(expr : AstExpr) -> Option(String))({
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  ind := String.new();
  generate_expr(expr, pctx, ind)
});
/// Convenience: run generate_expr and also return the emitted code.
run_gen_with_ctx :: (fn(expr : AstExpr) -> CodegenContext)({
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  ind := String.new();
  _r := generate_expr(expr, pctx, ind);
  ctx
});
{ parse, ParseError } :: import("../parser.yo");
/// Build `FnCall(Atom("fn"), params, false)` — fn type prefix.
make_fn_type_prefix :: (fn(params : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("fn", params)
);
/// Build `FnCall(Atom("->"), [fn_prefix, ret_ty], true)` — fn type with return.
make_fn_type :: (fn(params : ArrayList(AstExpr), ret_ty : AstExpr) -> AstExpr)({
  fn_prefix := make_fn_type_prefix(params);
  make_infix_expr("->", fn_prefix, ret_ty)
});
/// Build the whole `(fn(params) -> ret_ty)(body)` function literal application.
make_fn_app :: (fn(params : ArrayList(AstExpr), ret_ty : AstExpr, body : AstExpr) -> AstExpr)({
  fn_type := make_fn_type(params, ret_ty);
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  fn_type_tok := make_token_raw(TokenKind.Operator, "->");
  .FnCall(usize(0), box(fn_type), body_args, false, fn_type_tok)
});
/// Build `FnCall(Atom("::"), [name_atom, fn_app], true)` — named constant define.
make_define_expr :: (fn(name : str, rhs : AstExpr) -> AstExpr)(
  make_infix_expr("::", make_atom_expr(TokenKind.Identifier, name), rhs)
);
/// Build `FnCall(Atom(":"), [name, ty], true)` — typed param (reuses make_colon_expr).
make_param :: (fn(name : str, ty_name : str) -> AstExpr)(
  make_colon_expr(
    make_atom_expr(TokenKind.Identifier, name),
    make_atom_expr(TokenKind.Identifier, ty_name)
  )
);
/// Build a `using(name : Type)` evidence param expression.
make_using_param :: (fn(ev_name : str, ty_name : str) -> AstExpr)({
  inner := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, ev_name),
    make_atom_expr(TokenKind.Identifier, ty_name)
  );
  a := ArrayList(AstExpr).new();
  a.push(inner);
  make_fncall_expr("using", a)
});
// ---------------------------------------------------------------------------
// Phase 4d: Match codegen
// ---------------------------------------------------------------------------
test("emit_match_temp_decl: emits type and varname", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  emit_match_temp_decl("int32_t", "_yo_temp_1", pctx);
  out := ctx.emitter.print();
  assert(out.contains(String.from("int32_t _yo_temp_1;")), "temp decl");
});
test("emit_switch_open: simple enum (no tag field)", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  emit_switch_open("c", false, pctx);
  out := ctx.emitter.print();
  assert(out.contains(String.from("switch (c) {")), "simple switch");
});
test("emit_switch_open: data enum (with tag field)", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  emit_switch_open("shape", true, pctx);
  out := ctx.emitter.print();
  assert(out.contains(String.from("switch ((shape).tag) {")), "data switch");
});
test("emit_case_open: named case", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  emit_case_open("__YO_ENUM_MOD_ID_2_RED", pctx);
  out := ctx.emitter.print();
  assert(out.contains(String.from("case __YO_ENUM_MOD_ID_2_RED: {")), "named case");
});
test("emit_case_open: wildcard emits default", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  emit_case_open("", pctx);
  out := ctx.emitter.print();
  assert(out.contains(String.from("default: {")), "default case");
});
test("emit_case_body: emits assignment, break, close brace", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  emit_case_body("_yo_temp_1", "42", pctx);
  out := ctx.emitter.print();
  assert(out.contains(String.from("_yo_temp_1 = 42;")), "assignment");
  assert(out.contains(String.from("break;")), "break");
  assert(out.contains(String.from("}")), "close brace");
});
test("generate_match_simple: switch on unit enum", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  arms := ArrayList(SimpleArm).new();
  arm_red := SimpleArm(
    tag_const : String.from("__YO_ENUM_MOD_ID_2_RED"),
    body : make_atom_expr(TokenKind.Integer, "0")
  );
  arms.push(arm_red);
  arm_green := SimpleArm(
    tag_const : String.from("__YO_ENUM_MOD_ID_2_GREEN"),
    body : make_atom_expr(TokenKind.Integer, "1")
  );
  arms.push(arm_green);
  arm_blue := SimpleArm(
    tag_const : String.from("__YO_ENUM_MOD_ID_2_BLUE"),
    body : make_atom_expr(TokenKind.Integer, "2")
  );
  arms.push(arm_blue);
  generate_match_simple("c", "int32_t", "_yo_temp_1", arms, generate_expr, pctx, "");
  out := ctx.emitter.print();
  assert(out.contains(String.from("int32_t _yo_temp_1;")), "temp decl");
  assert(out.contains(String.from("switch (c) {")), "switch open");
  assert(out.contains(String.from("case __YO_ENUM_MOD_ID_2_RED: {")), "RED case");
  assert(out.contains(String.from("case __YO_ENUM_MOD_ID_2_GREEN: {")), "GREEN case");
  assert(out.contains(String.from("case __YO_ENUM_MOD_ID_2_BLUE: {")), "BLUE case");
  assert(out.contains(String.from("_yo_temp_1 = 0;")), "RED body");
  assert(out.contains(String.from("_yo_temp_1 = 1;")), "GREEN body");
  assert(out.contains(String.from("_yo_temp_1 = 2;")), "BLUE body");
});
test("generate_match_data: switch on data enum with field bindings", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  // .Circle(r) arm with one binding
  circle_bindings := ArrayList(DataBinding).new();
  circle_b := DataBinding(
    var_name : String.from("r"),
    field_path : String.from("data.Circle.r"),
    type_c : String.from("int32_t")
  );
  circle_bindings.push(circle_b);
  circle_arm := DataArm(
    tag_const : String.from("__YO_ENUM_MOD_ID_2_CIRCLE"),
    bindings : circle_bindings,
    body : make_atom_expr(TokenKind.Integer, "42")
  );
  // .Rect(w, h) arm with two bindings
  rect_bindings := ArrayList(DataBinding).new();
  rect_w := DataBinding(
    var_name : String.from("w"),
    field_path : String.from("data.Rect.w"),
    type_c : String.from("int32_t")
  );
  rect_h := DataBinding(
    var_name : String.from("h"),
    field_path : String.from("data.Rect.h"),
    type_c : String.from("int32_t")
  );
  rect_bindings.push(rect_w);
  rect_bindings.push(rect_h);
  rect_arm := DataArm(
    tag_const : String.from("__YO_ENUM_MOD_ID_2_RECT"),
    bindings : rect_bindings,
    body : make_atom_expr(TokenKind.Integer, "99")
  );
  arms := ArrayList(DataArm).new();
  arms.push(circle_arm);
  arms.push(rect_arm);
  generate_match_data("shape", "int32_t", "_yo_temp_2", arms, generate_expr, pctx, "");
  out := ctx.emitter.print();
  assert(out.contains(String.from("int32_t _yo_temp_2;")), "temp decl");
  assert(out.contains(String.from("switch ((shape).tag) {")), "switch open");
  assert(out.contains(String.from("case __YO_ENUM_MOD_ID_2_CIRCLE: {")), "CIRCLE case");
  assert(out.contains(String.from("int32_t r = shape.data.Circle.r;")), "r binding");
  assert(out.contains(String.from("case __YO_ENUM_MOD_ID_2_RECT: {")), "RECT case");
  assert(out.contains(String.from("int32_t w = shape.data.Rect.w;")), "w binding");
  assert(out.contains(String.from("int32_t h = shape.data.Rect.h;")), "h binding");
});
test("generate_match_simple: wildcard arm emits default case", {
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &(ctx);
  arms := ArrayList(SimpleArm).new();
  arm_a := SimpleArm(
    tag_const : String.from("__YO_ENUM_ID_TAG_A"),
    body : make_atom_expr(TokenKind.Integer, "1")
  );
  arms.push(arm_a);
  arm_wild := SimpleArm(
    tag_const : String.from(""),
    // wildcard
    body : make_atom_expr(TokenKind.Integer, "0")
  );
  arms.push(arm_wild);
  generate_match_simple("x", "int32_t", "_yo_temp_3", arms, generate_expr, pctx, "");
  out := ctx.emitter.print();
  assert(out.contains(String.from("case __YO_ENUM_ID_TAG_A: {")), "named case");
  assert(out.contains(String.from("default: {")), "wildcard default");
});
