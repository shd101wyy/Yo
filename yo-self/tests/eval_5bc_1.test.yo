  src := "arr := [i32(3), i32(1), i32(4), i32(1), i32(5), i32(9)];\nresult := arr.fold(i32(100), (fn(acc : i32, x : i32) -> i32)(cond((x < acc) => x, true => acc)));\nexport(result);\n";
  exprs := generate_exprs_from_code(src, using(exn));
