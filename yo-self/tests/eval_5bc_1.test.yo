test("Phase 5bcb: all strings start with letter via contains", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // all words contain at least one vowel: apple(a), cherry(e), banana(a) => true
  src := "words := [\"apple\", \"cherry\", \"banana\"];\nhas_a := words.filter((fn(w : str) -> bool)(w.contains(\"a\")));\nhas_e := words.filter((fn(w : str) -> bool)(w.contains(\"e\")));\nexport(has_a.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          // "apple","banana" contain "a" => 2
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "2", "2"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ─── 5bcc: multi-variable while ─────────────────────────────────────────────
test("Phase 5bcc: parallel counters in while — sum of squares up to n", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // i from 1 to 5: sum_sq = 1+4+9+16+25 = 55
  src := "i := i32(1);\nsum_sq := i32(0);\nwhile((i <= i32(5)), {\nsum_sq = (sum_sq + (i * i));\ni = (i + i32(1));\n});\nexport(sum_sq);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "55", "55"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

