test "Phase 5fh: sum of squares", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "sum_sq := (fn(n : i32) -> i32)({\n(s : i32) = i32(0);\n(i : i32) = i32(1);\nwhile (i <= n), {\ns = (s + (i * i));\ni = (i + i32(1));\n};\ns\n});\nexport sum_sq(i32(5));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "55"), "1+4+9+16+25"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

