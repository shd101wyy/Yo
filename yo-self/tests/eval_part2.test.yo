            _ => assert(false, "x not IntLit")
          ),
          .None => assert(false, "no x")
        );
        match(vals.get(usize(1)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(b, "y=true"),
            _ => assert(false, "y not BoolVal")
