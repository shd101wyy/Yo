// Phase 5dz: edge cases and diverse patterns
test "Phase 5dz: recursive palindrome number check", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "rev_num := (fn(n : i32) -> i32)({ (num : i32) = n; (result : i32) = i32(0); while((num > i32(0)), { result = ((result * i32(10)) + (num % i32(10))); num = (num / i32(10)); }); result }); is_palindrome := (fn(n : i32) -> bool)((n == rev_num(n))); r1 := is_palindrome(i32(121)); r2 := is_palindrome(i32(123)); export r1; export r2;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(2)), "2 exports");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(b, "121 is palindrome"),
            _ => assert(false, "r1 not BoolVal")
          ),
          .None => assert(false, "no r1")
        );
        match(vals.get(usize(1)),
          .Some(v) => match(v,
            .BoolVal(b) => assert(!(b), "123 not palindrome"),
            _ => assert(false, "r2 not BoolVal")
          ),
          .None => assert(false, "no r2")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

