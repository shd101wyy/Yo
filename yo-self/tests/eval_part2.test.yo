test "Phase 5fc: function composition", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "compose := (fn(f : Impl(Fn(i32) -> i32), g : Impl(Fn(i32) -> i32)) -> Impl(Fn(i32) -> i32))((fn(x : i32) -> i32)(f(g(x))));\ninc := (fn(x : i32) -> i32)((x + i32(1)));\ndbl := (fn(x : i32) -> i32)((x * i32(2)));\ninc_then_dbl := compose(dbl, inc);\nexport inc_then_dbl(i32(3));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
