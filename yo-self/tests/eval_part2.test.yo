// Phase 5ej: more while loop and array patterns
test "Phase 5ej: while loop decrement to zero", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "r := { (n : i32) = i32(100); (steps : i32) = i32(0); while((n > i32(0)), { n = (n - i32(7)); steps = (steps + i32(1)); }); steps }; export r;";
  exprs := generate_exprs_from_code(src, using(exn));
