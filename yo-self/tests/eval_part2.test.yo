  src := "nums := [i32(1), i32(2), i32(3), i32(4), i32(5), i32(6)]; result := nums.filter((fn(x : i32) -> bool)((x % i32(2)) == i32(0))).map((fn(x : i32) -> i32)((x * x))); n := result.len(); export n;";
  exprs := generate_exprs_from_code(src, using(exn));
