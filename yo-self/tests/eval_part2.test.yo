      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .EnumVal(tag, fields) => {
              assert((tag.as_str() == ".Ok"), "result is Ok");
              match(fields.get(usize(0)),
                .Some(inner) => match(inner,
                  .IntLit(n) => assert((n.as_str() == "5"), "10/2=5"),
                  _ => assert(false, "not IntLit")
                ),
                .None => assert(false, "no field")
              );
            },
            _ => assert(false, "not EnumVal")
          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

test "Phase 5cb: iterative power computation", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "r := { (base : i32) = i32(2); (exp : i32) = i32(8); (result : i32) = i32(1); while((exp > i32(0)), { result = (result * base); exp = (exp - i32(1)); }); result }; export r;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "power returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        assert((names.len() == usize(1)), "1 export");
        match(vals.get(usize(0)),
          .Some(v) => match(v,
            .IntLit(n) => assert((n.as_str() == "256"), "2^8=256"),
            _ => assert(false, "not IntLit")
          ),
          .None => assert(false, "no export")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

