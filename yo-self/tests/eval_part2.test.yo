test "Phase 5fh: count digits", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "count_digits := (fn(n : i32) -> i32)({\ncond((n == i32(0)) => { return i32(1); }, true => ());\n(count : i32) = i32(0);\n(x : i32) = n;\nwhile (x > i32(0)), {\nx = (x / i32(10));\ncount = (count + i32(1));\n};\ncount\n});\nexport count_digits(i32(12345));\nexport count_digits(i32(0));\nexport count_digits(i32(7));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "5"), "5 digits"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "1"), "1 digit"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "1"), "1 digit"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

