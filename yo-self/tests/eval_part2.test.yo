test "Phase 5fh: recursive power", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "pow := (fn(base : i32, exp : i32) -> i32)(cond((exp == i32(0)) => i32(1), true => (base * recur(base, (exp - i32(1))))));\nexport pow(i32(3), i32(4));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "81"), "3^4=81"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

