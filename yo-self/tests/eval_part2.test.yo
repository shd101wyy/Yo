test "Phase 5fh: LCM via GCD", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "gcd := (fn(a : i32, b : i32) -> i32)(cond((b == i32(0)) => a, true => recur(b, (a % b))));\nlcm := (fn(a : i32, b : i32) -> i32)(((a * b) / gcd(a, b)));\nexport lcm(i32(12), i32(18));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "36"), "lcm(12,18)=36"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

test "Phase 5fh: while countdown", {
