// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5z series: Result methods, i64 arithmetic,
/// integer conversion chains, contains(), Result.map/and_then/map_err,
/// HOF combos, and mixed combos.
///
/// Phases covered:
///   5za — Result.is_ok / is_err / unwrap / unwrap_or
///   5zb — i64 arithmetic and comparison
///   5zc — Integer conversion chains (.to_i64, .to_i32, .to_u64, .to_f64)
///   5zd — StrLit.contains() and ArrayVal.contains()
///   5ze — Result.map, Result.and_then, Result.map_err
///   5zf — HOF combo: map + filter + fold in sequence
///   5zg — Combo tests
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5za — Result.is_ok / is_err / unwrap / unwrap_or
// ---------------------------------------------------------------------------
test("Phase 5za: Result.Ok.is_ok() = true", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "r := Result(i32, str).Ok(i32(42));\nexport(r.is_ok());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.BoolVal(b) => assert(b, "true"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5za: Result.Err.is_ok() = false", {
  env := empty_env();
  given(exn) := Exception(
