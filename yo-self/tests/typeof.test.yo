/// Tests for yo-self/evaluator/exprs/typeof.yo — Phase 2r
///
/// Covers `evaluate_typeof` — the production handler for `typeof(expr)`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr, ast_expr_id, BF_TYPEOF } :: import("../expr.yo");
{ ExprInfo, new_expr_info, expr_info_table_get, expr_info_table_set }
:: import("../expr_info.yo");
{ Environment } :: import("../env.yo");
{ EvalContext, eval_context_new } :: import("../evaluator/context.yo");
{ EvalValue, create_type_value } :: import("../value.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ t_i32 } :: import("../types/creators.yo");
{ type_of_type } :: import("../types/hierarchy.yo");
{ set_evaluate_expression_fn, evaluate_expression }
:: import("../evaluator/exprs/expr.yo");
{ evaluate_typeof } :: import("../evaluator/exprs/typeof.yo");
{ Exception } :: import("std/error");
{ assert, panic } :: import("std/assert");
// Helper: build a token with the given identifier value.
mk_token :: (fn(value : str) -> Token)(
  Token(
    kind : TokenKind.Identifier,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);
// Helper: build a typeof(arg_atom) FnCall expression with stable ids.
mk_typeof_call :: (fn(arg_id : usize, arg_value : str, call_id : usize) -> AstExpr)({
  arg_atom := AstExpr.Atom(arg_id, mk_token(arg_value));
  callee := AstExpr.Atom(call_id + usize(1000), mk_token(BF_TYPEOF));
  args := ArrayList(AstExpr).new();
  args.push(arg_atom);
  AstExpr.FnCall(call_id, callee, args, false, mk_token(BF_TYPEOF))
});
// A stub `evaluate_expression` used by tests. It pretends every input
// is an `i32`-typed expression by writing an ExprInfo with `ty = i32` to
// the side table, then returns the expression unchanged.
stub_evaluate :: (
  fn(
    expr : AstExpr,
    env : Environment,
    ctx : EvalContext
  ) -> AstExpr
)({
  info := new_expr_info(env, t_i32());
  expr_info_table_set(ctx.expr_info_table, ast_expr_id(expr), info);
  expr
});
test("evaluate_typeof: writes TypeVal(i32) into the side table for typeof(x)", {
  set_evaluate_expression_fn(stub_evaluate);
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected error");
        unwind(());
      }
    )
  );
  ctx := eval_context_new(String.from("/std"), String.from("test"));
  env := Environment.new(String.from("test"));
  call := mk_typeof_call(usize(7), "x", usize(42));
  result := evaluate_typeof(call, env, ctx, exn);
  // Side-effect: typeof's own ExprInfo is set with TypeVal(i32) and meta-type Type.
  info_opt := expr_info_table_get(ctx.expr_info_table, ast_expr_id(result));
  assert(match(info_opt,.Some(_) => true,.None => false), "typeof did not record an ExprInfo");
  info := match(
    info_opt,
    .Some(i) => i,
    .None => new_expr_info(env, t_i32())
  );
  // value should be Some(TypeVal(i32))
  match(
    info.value,
    .Some(v) => match(
      v,
      .TypeVal(ty) => match(
        ty,
        .Int(bits, signed) => {
          assert(bits == u8(32), "expected i32 bits=32");
          assert(signed, "expected i32 signed=true");
        },
        _ => assert(false, "expected Int(32, true)")
      ),
      _ => assert(false, "expected TypeVal")
    ),
    .None => assert(false, "expected typeof to set a value")
  );
  // Meta type stored in info.ty should equal type_of_type(i32) = TypeUni(0)
  match(
    info.ty,
    .TypeUni(_) => (),
    _ => assert(false, "expected meta type = TypeUni")
  );
});
// Note: error-path test omitted — closures cannot capture mutable locals or
// globals to communicate back from inside an Exception handler. The typeof
// dispatcher pattern is exercised by the happy path above; arity error logic
// is identical to the parser's error-throwing pattern, which is well-covered
// by parser.test.yo. See issues/closure-capture-mutable.md.
