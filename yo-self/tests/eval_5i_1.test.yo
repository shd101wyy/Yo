test("Phase 5ib: struct distance manhattan", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "Point :: struct(x : i32, y : i32);\npoints := [Point(x: i32(0), y: i32(0)), Point(x: i32(3), y: i32(4)), Point(x: i32(1), y: i32(1))];\n(total_dist : i32) = i32(0);\norigin := Point(x: i32(0), y: i32(0));\nfor(p, points, {\ndx := cond((p.x >= origin.x) => (p.x - origin.x), true => (origin.x - p.x));\ndy := cond((p.y >= origin.y) => (p.y - origin.y), true => (origin.y - p.y));\ntotal_dist = (total_dist + (dx + dy));\n});\nexport(total_dist);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
