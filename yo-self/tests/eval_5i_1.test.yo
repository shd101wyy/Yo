test("Phase 5ia: array min and max difference", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "arr := [i32(4), i32(2), i32(9), i32(1), i32(7)];\n(mn : i32) = i32(999);\n(mx : i32) = i32(-(999));\nfor(x, arr, {\ncond((x < mn) => { mn = x; }, true => ());\ncond((x > mx) => { mx = x; }, true => ());\n});\nexport((mx - mn));\nexport(mn);\nexport(mx);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "8"), "9-1=8"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "1"), "min=1"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "9"), "max=9"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});

test("Phase 5ia: recursive combinatorial C(n,k)", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "choose := (fn(n : i32, k : i32) -> i32)(cond((k == i32(0)) => i32(1), (k == n) => i32(1), true => (recur((n - i32(1)), (k - i32(1))) + recur((n - i32(1)), k))));\nexport(choose(i32(5), i32(2)));\nexport(choose(i32(6), i32(3)));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "10"), "C(5,2)=10"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "20"), "C(6,3)=20"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});

test("Phase 5ia: struct with computed equality", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "RGB :: struct(r : i32, g : i32, b : i32);\nc1 := RGB(r: i32(255), g: i32(128), b: i32(0));\nc2 := RGB(r: i32(255), g: i32(128), b: i32(0));\nc3 := RGB(r: i32(0), g: i32(255), b: i32(0));\nexport((c1 == c2));\nexport((c1 == c3));\nexport(((c1.r + c1.g) + c1.b));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .BoolVal(b) => assert(b, "c1==c2"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .BoolVal(b) => assert(!(b), "c1!=c3"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "383"), "255+128+0=383"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});

test("Phase 5ia: while loop digit extraction", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "(n : i32) = i32(54321);\ndigits := ArrayList(i32).new();\nwhile((n > i32(0)), {\ndigits.push((n - ((n / i32(10)) * i32(10))));\nn = (n / i32(10));\n});\nexport(digits.len());\nexport(digits.fold(i32(0), (fn(a : i32, b : i32) -> i32)((a + b))));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "5"), "5 digits"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "15"), "5+4+3+2+1=15"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});

test("Phase 5ia: enum Option is_some simulation", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "Maybe :: enum(Just(i32), Nothing);\nis_just := (fn(m : Maybe) -> bool)(match(m, .Just(_) => true, .Nothing => false));\nget_or := (fn(m : Maybe, default : i32) -> i32)(match(m, .Just(v) => v, .Nothing => default));\na := Maybe.Just(i32(42));\nb := Maybe.Nothing;\nexport(is_just(a));\nexport(is_just(b));\nexport(get_or(a, i32(0)));\nexport(get_or(b, i32(-(1))));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .BoolVal(b) => assert(b, "Just is some"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .BoolVal(b) => assert(!(b), "Nothing not some"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "42"), "Just(42) unwrap"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(3)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "-1"), "Nothing default -1"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});

