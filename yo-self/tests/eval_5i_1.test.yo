    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "8"), "ways(5)=8"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "21"), "ways(7)=21"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});

test("Phase 5ia: array count greater than average", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "arr := [i32(10), i32(20), i32(30), i32(40), i32(50)];\nsum := arr.fold(i32(0), (fn(a : i32, b : i32) -> i32)((a + b)));\navg := (sum / arr.len());\nabove := arr.filter((fn(x : i32) -> bool)((x > avg))).len();\nexport(avg);\nexport(above);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "30"), "avg=150/5=30"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "2"), "40,50 above avg"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});

test("Phase 5ia: for loop with enum matching and accumulation", {
