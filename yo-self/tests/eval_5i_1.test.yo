test("Phase 5ic: recursive Padovan sequence", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape(()); }));
  src := "padovan := (fn(n : i32) -> i32)(cond((n == i32(0)) => i32(1), (n == i32(1)) => i32(1), (n == i32(2)) => i32(1), true => (recur((n - i32(2))) + recur((n - i32(3))))));\nexport(padovan(i32(5)));\nexport(padovan(i32(7)));";
  exprs := generate_exprs_from_code(src, using(exn));
