// @skip_wasm32-emscripten
// @skip_wasm32-wasi
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
empty_env :: (fn() -> Environment)(Environment.new(`test`));

test("Phase 12pg/10cr: T1 running_max_sum of [3,2,3,3,4,14,10] = 44", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(3), i32(2), i32(3), i32(3), i32(4), i32(14), i32(10)];\ns := i32(0); mx := i32(0); i := i32(0);\nwhile((i < i32(7)), {\nv := arr.get(i).unwrap(); mx = cond((v > mx) => v, true => mx); s = (s + mx); i = (i + i32(1));\n});\npms := s;\nr := pms;\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "44", "44"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 12pg/10cr: T2 running_min_sum_rev of [7,9,13,4,9,15] = 40", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  src := "arr := [i32(7), i32(9), i32(13), i32(4), i32(9), i32(15)];\ns := i32(0); mn := i32(9999); i := i32(5);\nwhile((i >= i32(0)), {\nv := arr.get(i).unwrap(); mn = cond((v < mn) => v, true => mn); s = (s + mn); i = (i - i32(1));\n});\nr := s;\nexport(r);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "40", "40"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

test("Phase 12pg/10cr: T3 new_max_count of [11,4,13,3,12,6,6] = 2", {
  env := empty_env();
  given(exn) := Exception(
