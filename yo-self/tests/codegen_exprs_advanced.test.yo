// ---------------------------------------------------------------------------
// AST construction helpers
// ---------------------------------------------------------------------------
make_token_raw :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
make_atom_expr :: (fn(kind : TokenKind, value : str) -> AstExpr)(
  .Atom(usize(0), make_token_raw(kind, value))
);
make_infix_expr :: (fn(op : str, lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  op_tok := make_token_raw(TokenKind.Operator, op);
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), args, true, op_tok)
});
make_unary_expr :: (fn(op : str, operand : AstExpr) -> AstExpr)({
  args := ArrayList(AstExpr).new();
  args.push(operand);
  op_tok := make_token_raw(TokenKind.Operator, op);
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), args, false, op_tok)
});
make_fncall_expr :: (fn(name : str, args : ArrayList(AstExpr)) -> AstExpr)({
  name_tok := make_token_raw(TokenKind.Identifier, name);
  .FnCall(usize(0), box(.Atom(usize(0), name_tok)), args, false, name_tok)
});
make_begin_expr :: (fn(stmts : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("begin", stmts)
);
make_cond_expr :: (fn(arms : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("cond", arms)
);
make_cond_arm :: (fn(cond_e : AstExpr, body_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(body_e);
  op_tok := make_token_raw(TokenKind.Operator, "=>");
  .FnCall(usize(0), box(.Atom(usize(0), op_tok)), a, true, op_tok)
});
make_if_expr :: (fn(cond_e : AstExpr, then_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(then_e);
  make_fncall_expr("if", a)
});
make_if_else_expr :: (fn(cond_e : AstExpr, then_e : AstExpr, else_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(then_e);
  a.push(else_e);
  make_fncall_expr("if", a)
});
make_while_expr :: (fn(cond_e : AstExpr, body_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(body_e);
  make_fncall_expr("while", a)
});
make_runtime_cond :: (fn(inner : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(inner);
  make_fncall_expr("runtime", a)
});
// Phase 4d helpers ——————————————————————————————————————————————————————————
/// Build `FnCall(Dot, [lhs, rhs], is_infix=true)` — dot field/variant access.
make_dot_expr :: (fn(lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(lhs);
  a.push(rhs);
  dot_tok := make_token_raw(TokenKind.Dot, ".");
  .FnCall(usize(0), box(.Atom(usize(0), dot_tok)), a, true, dot_tok)
});
/// Build `FnCall(FnCall(Dot, [obj, method], true), args, false)` — method call.
make_method_call_expr :: (fn(obj : AstExpr, method : str, args : ArrayList(AstExpr)) -> AstExpr)({
  dot_tok := make_token_raw(TokenKind.Dot, ".");
  method_tok := make_token_raw(TokenKind.Identifier, method);
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(obj);
  dot_args.push(AstExpr.Atom(usize(0), method_tok));
  dot_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  AstExpr.FnCall(usize(0), box(dot_expr), args, false, dot_tok)
});
/// Build `FnCall(":", [name_expr, ty_expr], is_infix=true)` — type annotation.
make_colon_expr :: (fn(name_e : AstExpr, ty_e : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(name_e);
  a.push(ty_e);
  colon_tok := make_token_raw(TokenKind.Operator, ":");
  .FnCall(usize(0), box(.Atom(usize(0), colon_tok)), a, true, colon_tok)
});
/// Build `FnCall("=", [lhs, rhs], is_infix=true)` — assignment or typed decl.
make_assign_expr :: (fn(lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  a := ArrayList(AstExpr).new();
  a.push(lhs);
  a.push(rhs);
  eq_tok := make_token_raw(TokenKind.Operator, "=");
  .FnCall(usize(0), box(.Atom(usize(0), eq_tok)), a, true, eq_tok)
});
/// Build a typed declaration `(x : T) = val`.
make_typed_decl_expr :: (fn(name : str, ty_name : str, val_e : AstExpr) -> AstExpr)(
  make_assign_expr(
    make_colon_expr(
      make_atom_expr(TokenKind.Identifier, name),
      make_atom_expr(TokenKind.Identifier, ty_name)
    ),
    val_e
  )
);
/// Convenience: run generate_expr with a fresh context and empty indent.
run_gen :: (fn(expr : AstExpr) -> Option(String))({
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  ind := String.new();
  generate_expr(expr, pctx, ind)
});
/// Convenience: run generate_expr and also return the emitted code.
run_gen_with_ctx :: (fn(expr : AstExpr) -> CodegenContext)({
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  ind := String.new();
  _r := generate_expr(expr, pctx, ind);
  ctx
});
{ parse, ParseError } :: import("../parser.yo");
/// Build `FnCall(Atom("fn"), params, false)` — fn type prefix.
make_fn_type_prefix :: (fn(params : ArrayList(AstExpr)) -> AstExpr)(
  make_fncall_expr("fn", params)
);
/// Build `FnCall(Atom("->"), [fn_prefix, ret_ty], true)` — fn type with return.
make_fn_type :: (fn(params : ArrayList(AstExpr), ret_ty : AstExpr) -> AstExpr)({
  fn_prefix := make_fn_type_prefix(params);
  make_infix_expr("->", fn_prefix, ret_ty)
});
/// Build the whole `(fn(params) -> ret_ty)(body)` function literal application.
make_fn_app :: (fn(params : ArrayList(AstExpr), ret_ty : AstExpr, body : AstExpr) -> AstExpr)({
  fn_type := make_fn_type(params, ret_ty);
  body_args := ArrayList(AstExpr).new();
  body_args.push(body);
  fn_type_tok := make_token_raw(TokenKind.Operator, "->");
  .FnCall(usize(0), box(fn_type), body_args, false, fn_type_tok)
});
/// Build `FnCall(Atom("::"), [name_atom, fn_app], true)` — named constant define.
make_define_expr :: (fn(name : str, rhs : AstExpr) -> AstExpr)(
  make_infix_expr("::", make_atom_expr(TokenKind.Identifier, name), rhs)
);
/// Build `FnCall(Atom(":"), [name, ty], true)` — typed param (reuses make_colon_expr).
make_param :: (fn(name : str, ty_name : str) -> AstExpr)(
  make_colon_expr(
    make_atom_expr(TokenKind.Identifier, name),
    make_atom_expr(TokenKind.Identifier, ty_name)
  )
);
/// Build a `name : Type` evidence param expression.
make_using_param :: (fn(ev_name : str, ty_name : str) -> AstExpr)({
  inner := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, ev_name),
    make_atom_expr(TokenKind.Identifier, ty_name)
  );
  a := ArrayList(AstExpr).new();
  a.push(inner);
  make_fncall_expr("using", a)
});
// ---------------------------------------------------------------------------
// Struct constructor — is_labeled_arg, all_labeled_args, is_uppercase_start,
//                      handle_struct_constructor, generate_expr integration
// ---------------------------------------------------------------------------
test("is_labeled_arg: colon infix with 2 args is labeled", {
  name_e := make_atom_expr(TokenKind.Identifier, "value");
  val_e := make_atom_expr(TokenKind.Integer, "42");
  labeled := make_colon_expr(name_e, val_e);
  assert(is_labeled_arg(labeled), "colon infix should be labeled arg");
});
test("is_labeled_arg: plain atom is not labeled", {
  e := make_atom_expr(TokenKind.Identifier, "x");
  assert(!(is_labeled_arg(e)), "atom is not a labeled arg");
});
test("is_labeled_arg: non-colon infix is not labeled", {
  lhs := make_atom_expr(TokenKind.Identifier, "a");
  rhs := make_atom_expr(TokenKind.Integer, "1");
  args := ArrayList(AstExpr).new();
  args.push(lhs);
  args.push(rhs);
  plus_tok := make_token_raw(TokenKind.Operator, "+");
  e := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), plus_tok)), args, true, plus_tok);
  assert(!(is_labeled_arg(e)), "plus infix is not a labeled arg");
});
test("all_labeled_args: all labeled returns true", {
  f1 := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "x"),
    make_atom_expr(TokenKind.Integer, "1")
  );
  f2 := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "y"),
    make_atom_expr(TokenKind.Integer, "2")
  );
  args := ArrayList(AstExpr).new();
  args.push(f1);
  args.push(f2);
  assert(all_labeled_args(args), "all labeled args");
});
test("all_labeled_args: empty list returns false", {
  empty := ArrayList(AstExpr).new();
  assert(!(all_labeled_args(empty)), "empty list is not all-labeled");
});
test("all_labeled_args: mixed args returns false", {
  f1 := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "x"),
    make_atom_expr(TokenKind.Integer, "1")
  );
  pos := make_atom_expr(TokenKind.Integer, "2");
  args := ArrayList(AstExpr).new();
  args.push(f1);
  args.push(pos);
  assert(!(all_labeled_args(args)), "mixed args not all labeled");
});
test("is_uppercase_start: uppercase name returns true", {
  assert(is_uppercase_start(String.from("Counter")), "Counter starts uppercase");
  assert(is_uppercase_start(String.from("Point")), "Point starts uppercase");
});
test("is_uppercase_start: lowercase name returns false", {
  assert(!(is_uppercase_start(String.from("add"))), "add starts lowercase");
  assert(!(is_uppercase_start(String.from("foo"))), "foo starts lowercase");
});
test("is_uppercase_start: empty string returns false", {
  assert(!(is_uppercase_start(String.from(""))), "empty string has no uppercase start");
});
test("handle_struct_constructor: single field emits compound literal", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  ind := String.new();
  field := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "value"),
    make_atom_expr(TokenKind.Integer, "42")
  );
  args := ArrayList(AstExpr).new();
  args.push(field);
  result := handle_struct_constructor(String.from("Counter"), args, pctx, ind);
  match(
    result,
    .None => assert(false, "expected Some"),
    .Some(s) => assert(s == String.from("(Counter){.value = 42}"), "single field compound literal")
  );
});
test("handle_struct_constructor: two fields", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  ind := String.new();
  f1 := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "x"),
    make_atom_expr(TokenKind.Integer, "3")
  );
  f2 := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "y"),
    make_atom_expr(TokenKind.Integer, "4")
  );
  args := ArrayList(AstExpr).new();
  args.push(f1);
  args.push(f2);
  result := handle_struct_constructor(String.from("Point"), args, pctx, ind);
  match(
    result,
    .None => assert(false, "expected Some"),
    .Some(s) => assert(s == String.from("(Point){.x = 3, .y = 4}"), "two field compound literal")
  );
});
test("generate_expr: struct constructor via generate_expr dispatch", {
  field := make_colon_expr(
    make_atom_expr(TokenKind.Identifier, "value"),
    make_atom_expr(TokenKind.Integer, "99")
  );
  args := ArrayList(AstExpr).new();
  args.push(field);
  ctor_tok := make_token_raw(TokenKind.Identifier, "MyStruct");
  expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), ctor_tok)), args, false, ctor_tok);
  result := run_gen(expr);
  match(
    result,
    .None => assert(false, "expected Some"),
    .Some(s) => assert(s == String.from("(MyStruct){.value = 99}"), "struct ctor dispatch")
  );
});
// ---------------------------------------------------------------------------
// Cross-function call: fn_ prefix for registered functions
// ---------------------------------------------------------------------------
test("handle_regular_call: registered fn gets fn_ prefix", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  pctx.register_fn(String.from("helper"));
  ind := String.new();
  args := ArrayList(AstExpr).new();
  args.push(make_atom_expr(TokenKind.Integer, "1"));
  result := handle_regular_call(.Some(String.from("helper")), args, pctx, ind);
  match(
    result,
    .None => assert(false, "expected Some"),
    .Some(s) => assert(s == String.from("fn_helper(1)"), "registered fn uses fn_ prefix")
  );
});
test("handle_regular_call: unregistered fn has no prefix", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  ind := String.new();
  args := ArrayList(AstExpr).new();
  args.push(make_atom_expr(TokenKind.Integer, "1"));
  result := handle_regular_call(.Some(String.from("exit")), args, pctx, ind);
  match(
    result,
    .None => assert(false, "expected Some"),
    .Some(s) => assert(s == String.from("exit(1)"), "unregistered fn has no prefix")
  );
});
test("compile_module_to_c: cross-function call uses fn_ prefix", {
  // Build: double :: (fn(x : i32) -> i32)(x + x)
  //        main   :: (fn() -> unit)(double(21))
  dbl_params := ArrayList(AstExpr).new();
  dbl_params.push(
    make_colon_expr(
      make_atom_expr(TokenKind.Identifier, "x"),
      make_atom_expr(TokenKind.Identifier, "i32")
    )
  );
  dbl_body := make_infix_expr(
    "+",
    make_atom_expr(TokenKind.Identifier, "x"),
    make_atom_expr(TokenKind.Identifier, "x")
  );
  dbl_ret := make_atom_expr(TokenKind.Identifier, "i32");
  dbl_def := make_define_expr("double", make_fn_app(dbl_params, dbl_ret, dbl_body));
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom_expr(TokenKind.Integer, "21"));
  call_expr := make_fncall_expr("double", call_args);
  main_stmts := ArrayList(AstExpr).new();
  main_stmts.push(call_expr);
  main_body := make_begin_expr(main_stmts);
  main_ret := make_atom_expr(TokenKind.Identifier, "unit");
  main_def := make_define_expr("main", make_fn_app(ArrayList(AstExpr).new(), main_ret, main_body));
  exprs := ArrayList(AstExpr).new();
  exprs.push(dbl_def);
  exprs.push(main_def);
  opt_c := compile_module_to_c(exprs, "test_cross", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("fn_double(")), "double defined as fn_double");
      assert(c.contains(String.from("fn_double(21)")), "call site uses fn_double prefix");
    }
  );
});
test("compile_module_to_c: forward call emits function prototype", {
  main_args := ArrayList(AstExpr).new();
  main_args.push(make_atom_expr(TokenKind.Integer, "20"));
  main_args.push(make_atom_expr(TokenKind.Integer, "22"));
  main_stmts := ArrayList(AstExpr).new();
  main_stmts.push(make_fncall_expr("add", main_args));
  main_body := make_begin_expr(main_stmts);
  main_ret := make_atom_expr(TokenKind.Identifier, "unit");
  main_def := make_define_expr("main", make_fn_app(ArrayList(AstExpr).new(), main_ret, main_body));
  add_params := ArrayList(AstExpr).new();
  add_params.push(make_colon_expr(make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "i32")));
  add_params.push(make_colon_expr(make_atom_expr(TokenKind.Identifier, "y"), make_atom_expr(TokenKind.Identifier, "i32")));
  add_body := make_infix_expr("+", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "y"));
  add_ret := make_atom_expr(TokenKind.Identifier, "i32");
  add_def := make_define_expr("add", make_fn_app(add_params, add_ret, add_body));
  exprs := ArrayList(AstExpr).new();
  exprs.push(main_def);
  exprs.push(add_def);
  opt_c := compile_module_to_c(exprs, "test_forward", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("static int32_t fn_add(int32_t x, int32_t y);")), "add prototype");
      assert(c.contains(String.from("fn_add(20, 22)")), "call site uses fn_add prefix");
    }
  );
});
// ---------------------------------------------------------------------------
// Phase 5d — handle_match_value, gen_match_arm
// ---------------------------------------------------------------------------
/// Build a `=>` infix arm: `pat => body`.
make_arm_expr :: (fn(pat : AstExpr, body : AstExpr) -> AstExpr)(
  make_infix_expr("=>", pat, body)
);
/// Build a wildcard `_` atom.
make_wildcard_expr :: (fn() -> AstExpr)(
  make_atom_expr(TokenKind.Identifier, "_")
);
test("gen_match_arm: integer pattern emits ternary", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  pat := make_atom_expr(TokenKind.Integer, "5");
  body := make_atom_expr(TokenKind.Integer, "10");
  arm_args := ArrayList(AstExpr).new();
  arm_args.push(pat);
  arm_args.push(body);
  result_opt := gen_match_arm(arm_args, String.from("__m0"), String.from("0"), pctx, String.from(""));
  match(
    result_opt,
    .None => assert(false, "gen_match_arm returned None"),
    .Some(result) => {
      assert(result.contains(String.from("__m0 == 5")), "condition uses temp var");
      assert(result.contains(String.from("10")), "body present");
      assert(result.contains(String.from("0")), "fallback present");
    }
  );
});
test("gen_match_arm: wildcard arm emits body only", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  wildcard := make_wildcard_expr();
  body := make_atom_expr(TokenKind.Integer, "42");
  arm_args := ArrayList(AstExpr).new();
  arm_args.push(wildcard);
  arm_args.push(body);
  result_opt := gen_match_arm(arm_args, String.from("__m0"), String.from("0"), pctx, String.from(""));
  match(
    result_opt,
    .None => assert(false, "gen_match_arm wildcard returned None"),
    .Some(result) => assert(result.contains(String.from("42")), "wildcard body emitted")
  );
});
test("handle_match_value: two-arm match with wildcard", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  scrut := make_atom_expr(TokenKind.Identifier, "x");
  arm1 := make_arm_expr(
    make_atom_expr(TokenKind.Integer, "5"),
    make_atom_expr(TokenKind.Integer, "10")
  );
  wildcard_arm := make_arm_expr(
    make_wildcard_expr(),
    make_atom_expr(TokenKind.Integer, "0")
  );
  args := ArrayList(AstExpr).new();
  args.push(scrut);
  args.push(arm1);
  args.push(wildcard_arm);
  result_opt := handle_match_value(args, pctx, String.from(""));
  match(
    result_opt,
    .None => assert(false, "handle_match_value returned None"),
    .Some(result) => {
      assert(result.contains(String.from("_yo_t")), "temp var declared");
      assert(result.contains(String.from("10")), "arm1 body present");
      assert(result.contains(String.from("0")), "wildcard body present");
    }
  );
});
test("handle_match_value: single wildcard arm emits body", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  scrut := make_atom_expr(TokenKind.Identifier, "y");
  wildcard_arm := make_arm_expr(
    make_wildcard_expr(),
    make_atom_expr(TokenKind.Integer, "99")
  );
  args := ArrayList(AstExpr).new();
  args.push(scrut);
  args.push(wildcard_arm);
  result_opt := handle_match_value(args, pctx, String.from(""));
  match(
    result_opt,
    .None => assert(false, "single wildcard returned None"),
    .Some(result) => assert(result.contains(String.from("99")), "wildcard body emitted")
  );
});
// ---------------------------------------------------------------------------
// Phase 5e — enum type declarations + variant access
// ---------------------------------------------------------------------------
/// Build `Name :: enum(V1, V2, ...)` — enum definition expression.
make_enum_def_expr :: (fn(name : str, variants : ArrayList(str)) -> AstExpr)({
  variant_exprs := ArrayList(AstExpr).new();
  n := variants.len();
  (i : usize) = usize(0);
  while(i < n, {
    i = (i + usize(1));
    match(
      variants.get(i - usize(1)),
      .None => (),
      .Some(vname) => {
        _r := variant_exprs.push(make_atom_expr(TokenKind.Identifier, vname));
        ()
      }
    );
  });
  enum_call := make_fncall_expr("enum", variant_exprs);
  make_infix_expr("::", make_atom_expr(TokenKind.Identifier, name), enum_call)
});
test("extract_enum_def: Color :: enum(Red, Green, Blue)", {
  variants := ArrayList(str).new();
  _r1 := variants.push("Red");
  _r2 := variants.push("Green");
  _r3 := variants.push("Blue");
  expr := make_enum_def_expr("Color", variants);
  ed_opt := extract_enum_def(expr);
  match(
    ed_opt,
    .None => assert(false, "extract_enum_def returned None"),
    .Some(ed) => {
      assert(ed.name == "Color", "enum name");
      assert(ed.variants.len() == usize(3), "3 variants");
    }
  );
});
test("emit_enum_to_c: typedef enum emitted correctly", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  red_ev := EnumVariant(
    name : String.from("Red"),
    disc : usize(0),
    fields : ArrayList(EnumVariantField).new()
  );
  green_ev := EnumVariant(
    name : String.from("Green"),
    disc : usize(1),
    fields : ArrayList(EnumVariantField).new()
  );
  ed := EnumDef(
    name : String.from("Color"),
    variants : ArrayList(EnumVariant).new(),
    is_complex : false
  );
  _ra := ed.variants.push(red_ev);
  _rb := ed.variants.push(green_ev);
  emit_enum_to_c(ed, pctx);
  c := generate_c_output(pctx);
  assert(c.contains(String.from("typedef enum")), "typedef enum keyword");
  assert(c.contains(String.from("Color_Red")), "Color_Red variant");
  assert(c.contains(String.from("Color_Green")), "Color_Green variant");
  assert(c.contains(String.from("} Color;")), "closing Color typedef");
});
test("compile_module_to_c: enum type is declared before functions", {
  // Build: Color :: enum(Red, Green)
  ev := ArrayList(str).new();
  _ra := ev.push("Red");
  _rb := ev.push("Green");
  enum_expr := make_enum_def_expr("Color", ev);
  // Build: main :: (fn() -> unit)({ 0 })
  empty_params := ArrayList(AstExpr).new();
  main_ret := make_atom_expr(TokenKind.Identifier, "unit");
  stmts := ArrayList(AstExpr).new();
  _rs := stmts.push(make_atom_expr(TokenKind.Integer, "0"));
  main_body := make_begin_expr(stmts);
  main_def := make_define_expr("main", make_fn_app(empty_params, main_ret, main_body));
  exprs := ArrayList(AstExpr).new();
  _re := exprs.push(enum_expr);
  _rm := exprs.push(main_def);
  opt_c := compile_module_to_c(exprs, "test_enum", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("typedef enum")), "typedef enum in output");
      assert(c.contains(String.from("Color_Red")), "Color_Red in output");
    }
  );
});
test("handle_dot_access: enum name rewritten to underscore", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  pctx.register_enum(String.from("Color"));
  // Build Color.Red
  color_expr := make_atom_expr(TokenKind.Identifier, "Color");
