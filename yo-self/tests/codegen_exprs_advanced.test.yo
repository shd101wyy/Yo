test("Phase 5o: emit_const_to_c emits string constant", {
  ctx := CodegenContext.new();
  cd := ConstDef(name : String.from("MY_STR"), value : String.from("\"hello\""), kind : String.from("str"));
  emit_const_to_c(cd, ctx);
  output := ctx.emitter.print();
  assert(output.contains(String.from("static const char* MY_STR")), "has static const char*");
  assert(output.contains(String.from("\"hello\"")), "has value");
});
