test("Phase 5p: compile_module_to_c with derive(ToString) emits toString fn", {
  // Build a module with:
  //   Point :: struct(x : i32, y : i32)
  //   derive(Point, ToString)
  //   main :: (fn() -> unit)({ () })
  exprs := ArrayList(AstExpr).new();
  // Point :: struct(x : i32, y : i32)
  struct_fields := ArrayList(AstExpr).new();
  struct_fields.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "i32")));
  struct_fields.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "y"), make_atom_expr(TokenKind.Identifier, "i32")));
  struct_call := make_fncall_expr("struct", struct_fields);
  point_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "Point"), struct_call);
  exprs.push(point_def);
  // derive(Point, ToString)
  derive_args := ArrayList(AstExpr).new();
  derive_args.push(make_atom_expr(TokenKind.Identifier, "Point"));
  derive_args.push(make_atom_expr(TokenKind.Identifier, "ToString"));
  derive_call := make_fncall_expr("derive", derive_args);
  exprs.push(derive_call);
  // main :: (fn() -> unit)(0)
  main_params := ArrayList(AstExpr).new();
  main_body := make_atom_expr(TokenKind.Integer, "0");
  main_fn_inner := make_fncall_expr("fn", main_params);
  main_ret := make_atom_expr(TokenKind.Identifier, "unit");
  main_fn_type := make_infix_expr("->", main_fn_inner, main_ret);
  main_fn_app_args := ArrayList(AstExpr).new();
  main_fn_app_args.push(main_body);
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  main_fn_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_fn_app_args, false, fn_tok);
  main_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_fn_app);
  exprs.push(main_def);
  result := compile_module_to_c(exprs, "test_mod", "main");
  match(
    result,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c_code) => {
      // Verify struct was emitted
      has_struct := c_code.contains(String.from("typedef struct"));
      assert(has_struct, "output should contain typedef struct");
      // Check derive output - the toString function emitted as fn_Point_to_string
      has_tostring := c_code.contains(String.from("fn_Point_to_string"));
      assert(has_tostring, "derive(ToString) should emit fn_Point_to_string");
    }
  );
});
test("Phase 5p: compile_module_to_c with derive(Clone) emits clone fn", {
  exprs := ArrayList(AstExpr).new();
  // Vec2 :: struct(x : f64, y : f64)
  struct_fields := ArrayList(AstExpr).new();
  struct_fields.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "f64")));
  struct_fields.push(make_infix_expr(":", make_atom_expr(TokenKind.Identifier, "y"), make_atom_expr(TokenKind.Identifier, "f64")));
  struct_call := make_fncall_expr("struct", struct_fields);
  vec_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "Vec2"), struct_call);
  exprs.push(vec_def);
  // derive(Vec2, Clone)
  derive_args := ArrayList(AstExpr).new();
  derive_args.push(make_atom_expr(TokenKind.Identifier, "Vec2"));
  derive_args.push(make_atom_expr(TokenKind.Identifier, "Clone"));
  derive_call := make_fncall_expr("derive", derive_args);
  exprs.push(derive_call);
  // main :: (fn() -> unit)(0)
  main_params := ArrayList(AstExpr).new();
  main_body := make_atom_expr(TokenKind.Integer, "0");
  main_fn_inner := make_fncall_expr("fn", main_params);
  main_ret := make_atom_expr(TokenKind.Identifier, "unit");
  main_fn_type := make_infix_expr("->", main_fn_inner, main_ret);
  main_fn_app_args := ArrayList(AstExpr).new();
  main_fn_app_args.push(main_body);
  fn_tok := make_token_raw(TokenKind.Identifier, "");
  main_fn_app := AstExpr.FnCall(usize(0), box(main_fn_type), main_fn_app_args, false, fn_tok);
  main_def := make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "main"), main_fn_app);
  exprs.push(main_def);
  result := compile_module_to_c(exprs, "test_mod", "main");
  match(
    result,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c_code) => {
      has_clone := c_code.contains(String.from("fn_Vec2_clone"));
      assert(has_clone, "derive(Clone) should emit fn_Vec2_clone");
    }
  );
});
// ---------------------------------------------------------------------------
// Lambda codegen tests — Phase 5p
// ---------------------------------------------------------------------------
/// Helper: make a single-param lambda AST: `(param) => body`
make_lambda_expr :: (fn(param : str, body : AstExpr) -> AstExpr)({
  arrow_tok := make_token_raw(TokenKind.Operator, "->");
  args := ArrayList(AstExpr).new();
  args.push(make_atom_expr(TokenKind.Identifier, param));
  args.push(body);
  AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), arrow_tok)), args, true, arrow_tok)
});
/// Helper: make a multi-param lambda AST: `(p1, p2) => body`
make_multi_lambda_expr :: (fn(params : ArrayList(str), body : AstExpr) -> AstExpr)({
  arrow_tok := make_token_raw(TokenKind.Operator, "->");
  tuple_args := ArrayList(AstExpr).new();
  (i : usize) = usize(0);
  while(i < params.len(), {
    match(
      params.get(i),
      .Some(p) => {
        tuple_args.push(make_atom_expr(TokenKind.Identifier, p));
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  tuple_tok := make_token_raw(TokenKind.Identifier, "tuple");
  tuple_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), tuple_tok)), tuple_args, false, tuple_tok);
  args := ArrayList(AstExpr).new();
  args.push(tuple_expr);
  args.push(body);
  AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), arrow_tok)), args, true, arrow_tok)
});
test("is_lambda_expr: single-param lambda detected", {
  // (x) => (x + 1)
  body := make_infix_expr("+", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Integer, "1"));
  lam := make_lambda_expr("x", body);
  assert(is_lambda_expr(lam), "single param lambda should be detected");
});
test("is_lambda_expr: multi-param lambda detected", {
  // (x, y) => (x + y)
  body := make_infix_expr("+", make_atom_expr(TokenKind.Identifier, "x"), make_atom_expr(TokenKind.Identifier, "y"));
  params := ArrayList(str).new();
  params.push("x");
  params.push("y");
  lam := make_multi_lambda_expr(params, body);
  assert(is_lambda_expr(lam), "multi param lambda should be detected");
});
test("is_lambda_expr: plain atom is not lambda", {
  atom := make_atom_expr(TokenKind.Identifier, "foo");
  assert(!(is_lambda_expr(atom)), "atom should not be lambda");
});
test("is_lambda_expr: infix + is not lambda", {
  plus := make_infix_expr("+", make_atom_expr(TokenKind.Integer, "1"), make_atom_expr(TokenKind.Integer, "2"));
  assert(!(is_lambda_expr(plus)), "infix + should not be lambda");
});
test("extract_lambda_param_names: single param extracts name", {
  param_expr := make_atom_expr(TokenKind.Identifier, "x");
  names := extract_lambda_param_names(param_expr);
  assert(names.len() == usize(1), "should extract 1 param name");
  match(
    names.get(usize(0)),
    .Some(n) => assert(n == "x", "param name should be x"),
    .None => assert(false, "no param at index 0")
  );
});
test("extract_lambda_param_names: multi param extracts all names", {
  tuple_args := ArrayList(AstExpr).new();
  tuple_args.push(make_atom_expr(TokenKind.Identifier, "a"));
  tuple_args.push(make_atom_expr(TokenKind.Identifier, "b"));
  tuple_args.push(make_atom_expr(TokenKind.Identifier, "c"));
  tuple_tok := make_token_raw(TokenKind.Identifier, "tuple");
  tuple_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), tuple_tok)), tuple_args, false, tuple_tok);
  names := extract_lambda_param_names(tuple_expr);
  assert(names.len() == usize(3), "should extract 3 param names");
  match(names.get(usize(0)),.Some(n) => assert(n == "a", "first param a"),.None => assert(false, "no 0"));
  match(names.get(usize(1)),.Some(n) => assert(n == "b", "second param b"),.None => assert(false, "no 1"));
  match(names.get(usize(2)),.Some(n) => assert(n == "c", "third param c"),.None => assert(false, "no 2"));
});
test("lift_non_capturing_lambda: single param emits static function", {
  ctx := CodegenContext.new();
  // (x) => 42
  body := make_atom_expr(TokenKind.Integer, "42");
  lam := make_lambda_expr("x", body);
  // Function pointer type: int32_t(*_FP_)(int32_t)
  fp_ty := String.from("int32_t(*_FP_)(int32_t)");
  result := lift_non_capturing_lambda(ctx, lam, fp_ty);
  match(
    result,
    .None => assert(false, "lift should succeed"),
    .Some(fn_name) => {
      // The lambda name should start with "__lambda_"
      assert(fn_name.starts_with(String.from("__yo_lambda_")), "fn name should start with __yo_lambda_");
      // The emitter should have the static function declaration
      output := ctx.emitter.print();
      assert(output.contains(String.from("static int32_t")), "should have static int32_t return(type)");
      assert(output.contains(String.from("int32_t x")), "should have param declaration");
      assert(output.contains(String.from(") {\n  return 42;")), "should emit valid C function body");
    }
  );
});
test("lift_non_capturing_lambda: multi param emits correct params", {
  ctx := CodegenContext.new();
  // (a, b) => 0
  body := make_atom_expr(TokenKind.Integer, "0");
  params := ArrayList(str).new();
  params.push("a");
  params.push("b");
  lam := make_multi_lambda_expr(params, body);
  // Function pointer type: int32_t(*_FP_)(int32_t, int32_t)
  fp_ty := String.from("int32_t(*_FP_)(int32_t, int32_t)");
  result := lift_non_capturing_lambda(ctx, lam, fp_ty);
  match(
    result,
    .None => assert(false, "lift multi-param should succeed"),
    .Some(fn_name) => {
      output := ctx.emitter.print();
      assert(output.contains(String.from("int32_t a")), "should have param a");
      assert(output.contains(String.from("int32_t b")), "should have param b");
    }
  );
});
test("validation: function pointer parameter call is not treated as Index", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  src := String.from("use_cb :: (fn(v : i32, cb : (fn(u : i32) -> i32)) -> i32)({ return(cb(v)); }); main :: (fn() -> unit)({ x := use_cb(10, (u) -> (u + 1)); assert(x == 11, \"callback\"); }); export(main);");
  exprs := parse(src, String.from("<test>"), exn);
  opt_c := compile_module_to_c(exprs, "fn_ptr_callback_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("static int32_t __yo_lambda_0(int32_t u) {\n  return (u + 1);\n}")), "lambda should emit valid C function");
      assert(c.contains(String.from("return cb(v);")), "function pointer parameter call should remain a call");
      assert(c.contains(String.from("fn_use_cb(10, __yo_lambda_0)")), "callback argument should lower to lifted lambda");
    }
  );
});
test("validation: Impl Fn parameter callbacks lower through carrier", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  src := String.from("use_cb :: (fn(v : i32, cb : Impl(Fn(u : i32) -> i32)) -> i32)({ return(cb(v)); }); main :: (fn() -> unit)({ a := i32(2); x := use_cb(i32(10), (u) => ((u + i32(1)) + a)); y := use_cb(i32(20), (u) => (u * i32(2))); b := Box(i32)(i32(5)); z := use_cb(i32(10), (u) => ((u + i32(1)) + b.*)); assert((x == i32(13)), \"x\"); assert((y == i32(40)), \"y\"); assert((z == i32(16)), \"z\"); }); export(main);");
  exprs := parse(src, String.from("<test>"), exn);
  opt_c := compile_module_to_c(exprs, "impl_fn_callback_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("typedef struct { void* data; int32_t (*call)(void*, int32_t); } __yo_impl_fn_i32_i32;")), "Impl Fn should emit carrier type");
      assert(c.contains(String.from("static int32_t fn_use_cb(int32_t v, __yo_impl_fn_i32_i32 cb)")), "callback param should use carrier type");
      assert(c.contains(String.from("return cb.call(cb.data, v);")), "callback call should dispatch through carrier");
      assert(c.contains(String.from("__yo_impl_fn_i32_i32){ .data = NULL, .call = __yo_lambda_1 }")), "non-capturing lambda should pass NULL env");
      assert(c.contains(String.from("__yo_box")), "Box constructor should lower to __yo_box");
    }
  );
});
test("validation: Dyn Fn parameter callbacks lower through carrier", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  src := String.from("use_cb :: (fn(v : i32, cb : Dyn(Fn(u : i32) -> i32)) -> i32)({ return(cb(v)); }); main :: (fn() -> unit)({ a := i32(2); x := use_cb(i32(10), dyn((u) => ((u + i32(1)) + a))); y := use_cb(i32(20), dyn(box((u) => (u * i32(2))))); assert((x == i32(13)), \"x\"); assert((y == i32(40)), \"y\"); }); export(main);");
  exprs := parse(src, String.from("<test>"), exn);
  opt_c := compile_module_to_c(exprs, "dyn_fn_callback_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(c.contains(String.from("static int32_t fn_use_cb(int32_t v, __yo_impl_fn_i32_i32 cb)")), "Dyn callback param should use carrier type");
      assert(c.contains(String.from("return cb.call(cb.data, v);")), "Dyn callback call should dispatch through carrier");
      assert(c.contains(String.from(".data = NULL")), "manual boxed non-capturing Dyn lambda should pass NULL env");
    }
  );
});
test("validation: typeof anonymous struct methods inline at call site", {
  exn := Exception(
    throw : (
      (err) -> {
        assert(false, "unexpected parse error");
        unwind(());
      }
    )
  );
  src := String.from("main :: (fn() -> unit)({ x := i32(1); y := i32(2); closure := { x, y }; impl(typeof(closure), call : (fn(self : Self, z : i32) -> i32)(self.x + (self.y + z))); result := closure.call(i32(3)); assert((result == i32(6)), \"Expected 6\"); }); export(main);");
  exprs := parse(src, String.from("<test>"), exn);
  opt_c := compile_module_to_c(exprs, "anon_typeof_method_module", "main");
  match(
    opt_c,
    .None => assert(false, "compile_module_to_c returned None"),
    .Some(c) => {
      assert(!(c.contains(String.from("closure.call"))), "anonymous typeof method should not emit invalid C method call");
      assert(c.contains(String.from("closure.x")), "inlined method should read x field");
      assert(c.contains(String.from("closure.y")), "inlined method should read y field");
    }
  );
});
