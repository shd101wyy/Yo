  emit_const_to_c(cd, ctx);
  output := ctx.emitter.print();
  assert(output.contains(String.from("#define MAX_SIZE 1024")), "has #define");
});
test("Phase 5o: compile_module_to_c emits constants", {
  exprs := ArrayList(AstExpr).new();
  // Add a constant: MAGIC :: 42
  exprs.push(make_infix_expr("::", make_atom_expr(TokenKind.Identifier, "MAGIC"), make_atom_expr(TokenKind.Integer, "42")));
  // Add a main fn using existing helpers
  body := make_begin_expr(ArrayList(AstExpr).new());
  ret := make_atom_expr(TokenKind.Identifier, "unit");
  rhs := make_fn_app(ArrayList(AstExpr).new(), ret, body);
  exprs.push(make_define_expr("main", rhs));
  result := compile_module_to_c(exprs, "test_const", "main");
  match(
    result,
    .None => assert(false, "expected C output"),
    .Some(output) => {
      assert(output.contains(String.from("#define MAGIC 42")), "output has MAGIC constant");
    }
  );
});
