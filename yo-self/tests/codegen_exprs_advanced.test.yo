});
// ---------------------------------------------------------------------------
// Phase 5h — template string codegen
// ---------------------------------------------------------------------------
/// Build `obj.to_string()` — the pattern emitted by parse_template_string
/// for each template-string part.
make_to_string_call :: (fn(obj : AstExpr) -> AstExpr)(
  make_method_call_expr(obj, "to_string", ArrayList(AstExpr).new())
);
/// Build `lhs.+(rhs)` — the chain emitted by parse_template_string to
/// concatenate template-string parts.  Uses TokenKind.Operator for the
/// method name atom, matching what the parser actually produces.
make_ts_concat :: (fn(lhs : AstExpr, rhs : AstExpr) -> AstExpr)({
  dot_tok := make_token_raw(TokenKind.Dot, ".");
  plus_tok := make_token_raw(TokenKind.Operator, "+");
  dot_args := ArrayList(AstExpr).new();
  _p1 := dot_args.push(lhs);
  _p2 := dot_args.push(AstExpr.Atom(usize(0), plus_tok));
  dot_expr := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dot_tok)), dot_args, true, dot_tok);
  call_args := ArrayList(AstExpr).new();
  _p3 := call_args.push(rhs);
  AstExpr.FnCall(usize(0), box(dot_expr), call_args, false, dot_tok)
});
test("template string: to_string() on string literal strips the call", {
  // `"hello "`.to_string() → `"hello "`
  lit_expr := make_atom_expr(TokenKind.StringLit, "\"hello \"");
  ts_expr := make_to_string_call(lit_expr);
  result_opt := run_gen(ts_expr);
  match(
    result_opt,
    .None => assert(false, "generate_expr returned None"),
    .Some(result) => assert(result == "\"hello \"", "string literal passed through")
  );
});
test("template string: to_string() on identifier strips the call", {
  // `name`.to_string() → `name`
  id_expr := make_atom_expr(TokenKind.Identifier, "name");
  ts_expr := make_to_string_call(id_expr);
  result_opt := run_gen(ts_expr);
  match(
    result_opt,
    .None => assert(false, "generate_expr returned None"),
    .Some(result) => assert(result == "name", "identifier passed through")
  );
});
test("template string: .+(b) emits __yo_str_concat(a, b)", {
  // `"fn_".to_string().+(name.to_string())` — i.e. `fn_${name}`
  lhs := make_to_string_call(make_atom_expr(TokenKind.StringLit, "\"fn_\""));
  rhs := make_to_string_call(make_atom_expr(TokenKind.Identifier, "name"));
  concat_expr := make_ts_concat(lhs, rhs);
  result_opt := run_gen(concat_expr);
  match(
    result_opt,
    .None => assert(false, "generate_expr returned None"),
    .Some(result) => {
      assert(result.contains(String.from("__yo_str_concat")), "__yo_str_concat present");
      assert(result.contains(String.from("\"fn_\"")), "literal part present");
      assert(result.contains(String.from("name")), "identifier part present");
    }
  );
});
test("template string: three-part chain emits nested __yo_str_concat", {
  // `fn_${name}!` → __yo_str_concat(__yo_str_concat("fn_", name), "!")
  lhs1 := make_to_string_call(make_atom_expr(TokenKind.StringLit, "\"fn_\""));
  mid := make_to_string_call(make_atom_expr(TokenKind.Identifier, "name"));
  rhs1 := make_to_string_call(make_atom_expr(TokenKind.StringLit, "\"!\""));
  inner := make_ts_concat(lhs1, mid);
  outer := make_ts_concat(inner, rhs1);
  result_opt := run_gen(outer);
  match(
    result_opt,
    .None => assert(false, "generate_expr returned None"),
    .Some(result) => {
      count := usize(0);
      if(result.contains(String.from("__yo_str_concat")), {
        count = (count + usize(1));
      });
      // The outer __yo_str_concat wraps an inner one — check both parts present
      assert(result.contains(String.from("\"fn_\"")), "prefix literal present");
      assert(result.contains(String.from("name")), "interpolation present");
      assert(result.contains(String.from("\"!\"")), "suffix literal present");
    }
  );
});
test("emit_c_preamble: __yo_str_concat helper is present", {
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  emit_c_preamble("test_mod", pctx);
  output := generate_c_output(pctx);
  assert(output.contains(String.from("__yo_str_concat")), "__yo_str_concat in preamble");
  assert(output.contains(String.from("memcpy")), "memcpy in concat helper");
});
// Phase 5i: if-with-block-branch emits C if statement, not ternary ----------
/// Build a begin block containing a single expression (like `{ break; }`).
make_single_stmt_begin :: (fn(expr : AstExpr) -> AstExpr)({
  stmts := ArrayList(AstExpr).new();
  stmts.push(expr);
  make_begin_expr(stmts)
});
test("handle_if: block then-branch emits C if statement (not ternary)", {
  // if((x > 0), { break; })  →  should contain "if (" and "break", NOT "? break"
  cond_e := make_infix_expr(
    ">",
    make_atom_expr(TokenKind.Identifier, "x"),
    make_atom_expr(TokenKind.Integer, "0")
  );
  then_e := make_single_stmt_begin(make_atom_expr(TokenKind.Identifier, "break"));
  if_e := make_if_expr(cond_e, then_e);
  ctx := run_gen_with_ctx(if_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("if (")), "C if statement emitted");
  assert(code.contains(String.from("break")), "break present in output");
  assert(!(code.contains(String.from("? break"))), "no ternary with break");
});
test("handle_if: simple expression still emits ternary", {
  // if((x > 0), y)  →  should emit (... ? y : 0)
  cond_e := make_infix_expr(
    ">",
    make_atom_expr(TokenKind.Identifier, "x"),
    make_atom_expr(TokenKind.Integer, "0")
  );
  then_e := make_atom_expr(TokenKind.Identifier, "y");
  if_e := make_if_expr(cond_e, then_e);
  result_opt := run_gen(if_e);
  match(
    result_opt,
    .None => assert(false, "generate_expr returned None"),
    .Some(result) => {
      assert(result.contains(String.from("?")), "ternary operator present");
      assert(result.contains(String.from("y")), "then-value y present");
    }
  );
});
test("handle_if: block else-branch emits C if/else statement", {
  // if(flag, x, { break; })  →  should contain "if (" and "else" and "break"
  cond_e := make_atom_expr(TokenKind.Identifier, "flag");
  then_e := make_atom_expr(TokenKind.Identifier, "x");
  else_e := make_single_stmt_begin(make_atom_expr(TokenKind.Identifier, "break"));
  if_e := make_if_else_expr(cond_e, then_e, else_e);
  ctx := run_gen_with_ctx(if_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("if (")), "C if statement emitted");
  assert(code.contains(String.from("else")), "else branch emitted");
  assert(code.contains(String.from("break")), "break in else branch");
});
test("handle_begin: sibling begin blocks are wrapped in C braces for variable scoping", {
  // { { x := 1; }; { x := 2; }; 3 }
  // The two inner begin blocks both define `x`. Without C brace wrapping they
  // emit two `__auto_type x = ...;` at the same scope → redefinition error.
  // With the fix, each sibling block is wrapped in `{ ... }`.
  inner_stmts1 := ArrayList(AstExpr).new();
  inner_stmts1.push(
    make_assign_expr(
      make_atom_expr(TokenKind.Identifier, "x"),
      make_atom_expr(TokenKind.Integer, "1")
    )
  );
  block1 := make_begin_expr(inner_stmts1);
  inner_stmts2 := ArrayList(AstExpr).new();
  inner_stmts2.push(
    make_assign_expr(
      make_atom_expr(TokenKind.Identifier, "x"),
      make_atom_expr(TokenKind.Integer, "2")
    )
  );
  block2 := make_begin_expr(inner_stmts2);
  outer_stmts := ArrayList(AstExpr).new();
  outer_stmts.push(block1);
  outer_stmts.push(block2);
  outer_stmts.push(make_atom_expr(TokenKind.Integer, "3"));
  outer := make_begin_expr(outer_stmts);
  ctx := run_gen_with_ctx(outer);
  code := ctx.emitter.code;
  // Both inner blocks must be wrapped in C braces
  assert(code.contains(String.from("{")), "opening brace emitted");
  assert(code.contains(String.from("}")), "closing brace emitted");
});
// Phase 5j: while loop codegen tests ----------------------------------------
test("handle_while: 2-arg while(cond, body) emits C while loop", {
  // while(flag, { break; })  →  while (flag) { ... break ... }
  cond_e := make_atom_expr(TokenKind.Identifier, "flag");
  body_e := make_single_stmt_begin(make_atom_expr(TokenKind.Identifier, "break"));
  w_e := make_while_expr(cond_e, body_e);
  ctx := run_gen_with_ctx(w_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("while (")), "C while emitted");
  assert(code.contains(String.from("flag")), "condition present");
  assert(code.contains(String.from("break")), "break in body");
});
test("handle_while: runtime(cond) wrapper is stripped from condition", {
  // while(runtime(i < n), { x; })  →  while (i < n) { ... }
  cond_inner := make_infix_expr(
    "<",
    make_atom_expr(TokenKind.Identifier, "i"),
    make_atom_expr(TokenKind.Identifier, "n")
  );
  cond_e := make_runtime_cond(cond_inner);
  body_e := make_single_stmt_begin(make_atom_expr(TokenKind.Identifier, "x"));
  w_e := make_while_expr(cond_e, body_e);
  ctx := run_gen_with_ctx(w_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("while (")), "C while emitted");
  assert(code.contains(String.from("i")), "i in condition");
  assert(code.contains(String.from("n")), "n in condition");
  assert(!(code.contains(String.from("runtime"))), "runtime wrapper stripped");
});
test("handle_while: 3-arg while(cond, step, body) emits C for loop", {
  // while(cond, i = i + 1, body)  →  for (;cond;...) { body }
  cond_e := make_atom_expr(TokenKind.Identifier, "cond");
  step_e := make_assign_expr(
    make_atom_expr(TokenKind.Identifier, "i"),
    make_infix_expr(
      "+",
      make_atom_expr(TokenKind.Identifier, "i"),
      make_atom_expr(TokenKind.Integer, "1")
    )
  );
  body_e := make_single_stmt_begin(make_atom_expr(TokenKind.Identifier, "x"));
  a := ArrayList(AstExpr).new();
  a.push(cond_e);
  a.push(step_e);
  a.push(body_e);
  w_e := make_fncall_expr("while", a);
  ctx := run_gen_with_ctx(w_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("for (;")), "C for loop emitted");
  assert(code.contains(String.from("cond")), "condition present");
});
// Phase 5k: for-loop codegen tests -------------------------------------------
test("handle_for: for(iter, elem => body) emits fallback while(1) loop", {
  // for(my_iter, elem => { break; })
  // → __auto_type _yo_tN = my_iter;
  //   while (1) { __auto_type _yo_tM = _yo_tN.next(); if (!_yo_tM) break; __auto_type elem = _yo_tM; break; }
  iter_e := make_atom_expr(TokenKind.Identifier, "my_iter");
  param_e := make_atom_expr(TokenKind.Identifier, "elem");
  body_e := make_single_stmt_begin(make_atom_expr(TokenKind.Identifier, "break"));
  handler_e := make_cond_arm(param_e, body_e);
  a := ArrayList(AstExpr).new();
  a.push(iter_e);
  a.push(handler_e);
  for_e := make_fncall_expr("for", a);
  ctx := run_gen_with_ctx(for_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("while (1)")), "fallback while(1) emitted");
  assert(code.contains(String.from("my_iter")), "iterator present");
  assert(code.contains(String.from("elem")), "param name present");
  assert(code.contains(String.from(".next()")), "next() call present");
  assert(code.contains(String.from("break")), "break in body");
});
test("handle_for: wrong arity (1 arg) returns None", {
  // for(iter_only) — missing handler → None
  iter_e := make_atom_expr(TokenKind.Identifier, "my_iter");
  a := ArrayList(AstExpr).new();
  a.push(iter_e);
  for_e := make_fncall_expr("for", a);
  result_opt := run_gen(for_e);
  match(
    result_opt,
    .None => (),
    .Some(_) => assert(false, "expected None for wrong-arity for")
  );
});
// Phase 5l: unwind-as-return codegen tests, plus standalone break/continue ----
test("generate_expr: unwind() with no args emits bare return", {
  // unwind() — no arguments → should emit `return;`
  a := ArrayList(AstExpr).new();
  esc_e := make_fncall_expr("unwind", a);
  ctx := run_gen_with_ctx(esc_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("return;")), "bare return(emitted for unwind())");
});
test("generate_expr: unwind(unit)(emits return(statement))", {
  // unwind(()) — unit argument maps to "0" in the proto-codegen, so unwind(())
  // emits `return 0;` (same as return(()) — unit return value maps to 0).
  unit_args := ArrayList(AstExpr).new();
  unit_e := make_fncall_expr("tuple", unit_args);
  a := ArrayList(AstExpr).new();
  a.push(unit_e);
  esc_e := make_fncall_expr("unwind", a);
  ctx := run_gen_with_ctx(esc_e);
  code := ctx.emitter.code;
  // Unit return: `return 0;` is emitted (proto-codegen maps unit to 0)
  assert(code.contains(String.from("return 0;")), "return 0 emitted for unwind(())");
});
test("generate_expr: unwind(expr)(emits return(with value))", {
  // unwind(42) -> should emit `return 42;`
  a := ArrayList(AstExpr).new();
  a.push(make_atom_expr(TokenKind.Integer, "42"));
  esc_e := make_fncall_expr("unwind", a);
  ctx := run_gen_with_ctx(esc_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("return 42;")), "return with value emitted for unwind(42)");
});
test("generate_expr: unwind(ident)(emits return(with identifier))", {
  // unwind(result) -> should emit `return result;`
  a := ArrayList(AstExpr).new();
  a.push(make_atom_expr(TokenKind.Identifier, "result"));
  esc_e := make_fncall_expr("unwind", a);
  ctx := run_gen_with_ctx(esc_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("return result;")), "return with ident emitted for unwind(result)");
});
test("generate_expr: break atom is emitted as identifier", {
  // Standalone `break` atom → generate_expr returns "break" as the expression code.
  // When this appears as the last statement in a begin block, the caller emits it.
  break_e := make_atom_expr(TokenKind.Identifier, "break");
  result_opt := run_gen(break_e);
  match(
    result_opt,
    .None => assert(false, "expected Some for break atom"),
    .Some(s) => assert(s == String.from("break"), "break atom generates 'break' string")
  );
});
test("generate_expr: continue atom is emitted as identifier", {
  // Standalone `continue` atom → generate_expr returns "continue" as expression code.
  continue_e := make_atom_expr(TokenKind.Identifier, "continue");
  result_opt := run_gen(continue_e);
  match(
    result_opt,
    .None => assert(false, "expected Some for continue atom"),
    .Some(s) => assert(s == String.from("continue"), "continue atom generates 'continue' string")
  );
});
test("handle_while: break inside body emits break statement in C code", {
  // while runtime(true), { break; } → emits `while((1)({))` and `break;`
  cond_e := make_runtime_cond(make_atom_expr(TokenKind.Bool, "true"));
  body_e := make_single_stmt_begin(make_atom_expr(TokenKind.Identifier, "break"));
  while_e := make_while_expr(cond_e, body_e);
  ctx := run_gen_with_ctx(while_e);
  code := ctx.emitter.code;
  assert(code.contains(String.from("while")), "while keyword present");
  assert(code.contains(String.from("break")), "break present in while body");
});
