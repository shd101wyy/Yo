open(import("std/string"));
_(ArrayList : ArrayList) :: import("std/collections/array_list");
_(assert : assert, panic : panic) :: import("std/assert");
_(is_local_path : is_local_path, _url_to_dep_name : _url_to_dep_name, _is_all_digits : _is_all_digits, _parse_semver_tag : _parse_semver_tag, _compare_semver : _compare_semver, _parse_tags_for_latest_semver : _parse_tags_for_latest_semver, _build_imports_block : _build_imports_block, _append_dep_to_content : _append_dep_to_content, parse_package_specifier : parse_package_specifier, dependency_exists_in_deps_file : dependency_exists_in_deps_file, parse_dependency_names : parse_dependency_names, regenerate_imports_list : regenerate_imports_list, ParsedPackage : ParsedPackage, SemVer : SemVer) :: import("../install_command.yo");
();
__yo_batch_env :: import("std/env");
main :: (fn() -> unit)({
  io :: __yo_builtin_io;
  match(__yo_batch_env.env.get(`YO_TEST_INDEX`),
    .Some(__yo_test_idx) => cond(
      (__yo_test_idx == `0`) => { begin(assert(is_local_path((String.from)(".")), "dot is local"), ()); },
      (__yo_test_idx == `1`) => { begin(assert(is_local_path((String.from)("..")), "dotdot is local"), ()); },
      (__yo_test_idx == `2`) => { begin(assert(is_local_path((String.from)("./foo")), "./foo is local"), ()); },
      (__yo_test_idx == `3`) => { begin(assert(is_local_path((String.from)("../bar")), "../bar is local"), ()); },
      (__yo_test_idx == `4`) => { begin(assert(is_local_path((String.from)("/abs/path")), "/abs is local"), ()); },
      (__yo_test_idx == `5`) => { begin(assert(!(is_local_path((String.from)("user/repo"))), "user/repo is not local"), ()); },
      (__yo_test_idx == `6`) => { begin(assert(!(is_local_path((String.from)("https://github.com/user/repo"))), "https url not local"), ()); },
      (__yo_test_idx == `7`) => { begin(result := _url_to_dep_name((String.from)("https://github.com/user/myrepo.git")), assert(result == (String.from)("myrepo"), "stripped .git and got last segment"), ()); },
      (__yo_test_idx == `8`) => { begin(result := _url_to_dep_name((String.from)("https://github.com/user/mylib")), assert(result == (String.from)("mylib"), "last segment without .git"), ()); },
      (__yo_test_idx == `9`) => { begin(result := _url_to_dep_name((String.from)("myrepo.git")), assert(result == (String.from)("myrepo"), "no slash, stripped .git"), ()); },
      (__yo_test_idx == `10`) => { begin(result := _url_to_dep_name((String.from)("myrepo")), assert(result == (String.from)("myrepo"), "plain name unchanged"), ()); },
      (__yo_test_idx == `11`) => { begin(assert(_is_all_digits((String.from)("123")), "123 all digits"), ()); },
      (__yo_test_idx == `12`) => { begin(assert(!(_is_all_digits((String.from)(""))), "empty is false"), ()); },
      (__yo_test_idx == `13`) => { begin(assert(!(_is_all_digits((String.from)("12a3"))), "letter makes it false"), ()); },
      (__yo_test_idx == `14`) => { begin(assert(_is_all_digits((String.from)("0")), "single 0 is digits"), ()); },
      (__yo_test_idx == `15`) => { begin(result := _parse_semver_tag((String.from)("v1.2.3")), match(result, .None => assert(false, "expected Some"), .Some(sv) => begin(assert((sv.major) == i32(1), "major is 1"), assert((sv.minor) == i32(2), "minor is 2"), assert((sv.patch) == i32(3), "patch is 3"), ())), ()); },
      (__yo_test_idx == `16`) => { begin(result := _parse_semver_tag((String.from)("V2.0.0")), match(result, .None => assert(false, "expected Some"), .Some(sv) => begin(assert((sv.major) == i32(2), "major is 2"), assert((sv.minor) == i32(0), "minor is 0"), assert((sv.patch) == i32(0), "patch is 0"), ())), ()); },
      (__yo_test_idx == `17`) => { begin(result := _parse_semver_tag((String.from)("3.4.5")), match(result, .None => assert(false, "expected Some"), .Some(sv) => begin(assert((sv.major) == i32(3), "major is 3"), assert((sv.minor) == i32(4), "minor is 4"), assert((sv.patch) == i32(5), "patch is 5"), ())), ()); },
      (__yo_test_idx == `18`) => { begin(result := _parse_semver_tag((String.from)("")), match(result, .None => assert(true, "None as expected"), .Some(_) => assert(false, "expected None for empty")), ()); },
      (__yo_test_idx == `19`) => { begin(result := _parse_semver_tag((String.from)("v1.2")), match(result, .None => assert(true, "None as expected"), .Some(_) => assert(false, "expected None for v1.2")), ()); },
      (__yo_test_idx == `20`) => { begin(result := _parse_semver_tag((String.from)("v1.beta.3")), match(result, .None => assert(true, "None as expected"), .Some(_) => assert(false, "expected None for v1.beta.3")), ()); },
      (__yo_test_idx == `21`) => { begin(a := SemVer(tag : (String.from)("v1.0.0"), major : i32(1), minor : i32(0), patch : i32(0)), b := SemVer(tag : (String.from)("v1.0.0"), major : i32(1), minor : i32(0), patch : i32(0)), assert(_compare_semver(a, b) == i32(0), "equal versions give 0"), ()); },
      (__yo_test_idx == `22`) => { begin(a := SemVer(tag : (String.from)("v2.0.0"), major : i32(2), minor : i32(0), patch : i32(0)), b := SemVer(tag : (String.from)("v1.9.9"), major : i32(1), minor : i32(9), patch : i32(9)), assert(_compare_semver(a, b) > i32(0), "a > b by major"), ()); },
      (__yo_test_idx == `23`) => { begin(a := SemVer(tag : (String.from)("v1.3.0"), major : i32(1), minor : i32(3), patch : i32(0)), b := SemVer(tag : (String.from)("v1.2.9"), major : i32(1), minor : i32(2), patch : i32(9)), assert(_compare_semver(a, b) > i32(0), "a > b by minor"), ()); },
      (__yo_test_idx == `24`) => { begin(a := SemVer(tag : (String.from)("v1.2.3"), major : i32(1), minor : i32(2), patch : i32(3)), b := SemVer(tag : (String.from)("v1.2.2"), major : i32(1), minor : i32(2), patch : i32(2)), assert(_compare_semver(a, b) > i32(0), "a > b by patch"), ()); },
      (__yo_test_idx == `25`) => { begin(result := _parse_tags_for_latest_semver((String.from)("")), match(result, .None => assert(true, "None for empty"), .Some(_) => assert(false, "expected None for empty input")), ()); },
      (__yo_test_idx == `26`) => { begin(raw := (((String.from)("abc123\trefs/tags/v1.0.0\n").concat)((String.from)("def456\trefs/tags/v2.1.0\n")).concat)((String.from)("ghi789\trefs/tags/v1.5.3\n")), result := _parse_tags_for_latest_semver(raw), match(result, .None => assert(false, "expected Some"), .Some(tag) => assert(tag == (String.from)("v2.1.0"), "highest tag is v2.1.0")), ()); },
      (__yo_test_idx == `27`) => { begin(raw := ((String.from)("abc123\trefs/heads/main\n").concat)((String.from)("def456\trefs/tags/v0.3.1\n")), result := _parse_tags_for_latest_semver(raw), match(result, .None => assert(false, "expected Some"), .Some(tag) => assert(tag == (String.from)("v0.3.1"), "picks the tag")), ()); },
      (__yo_test_idx == `28`) => { begin(result := parse_package_specifier((String.from)("user/myrepo")), match(result, .Err(msg) => assert_dyn(false, msg), .Ok(pkg) => match(pkg, .Path(_, _) => assert(false, "expected Git"), .Git(name, url, pinned_ref) => begin(assert(name == (String.from)("myrepo"), "name is myrepo"), assert(url == (String.from)("https://github.com/user/myrepo.git"), "url is github https"), match(pinned_ref, .None => assert(true, "no pinned ref"), .Some(_) => assert(false, "no ref expected")), ()))), ()); },
      (__yo_test_idx == `29`) => { begin(result := parse_package_specifier((String.from)("user/myrepo@v1.2.3")), match(result, .Err(msg) => assert_dyn(false, msg), .Ok(pkg) => match(pkg, .Path(_, _) => assert(false, "expected Git"), .Git(name, url, pinned_ref) => begin(assert(name == (String.from)("myrepo"), "name is myrepo"), match(pinned_ref, .None => assert(false, "expected pinned ref"), .Some(ref) => assert(ref == (String.from)("v1.2.3"), "pinned ref is v1.2.3")), ()))), ()); },
      (__yo_test_idx == `30`) => { begin(result := parse_package_specifier((String.from)("https://github.com/user/repo.git")), match(result, .Err(msg) => assert_dyn(false, msg), .Ok(pkg) => match(pkg, .Path(_, _) => assert(false, "expected Git"), .Git(name, url, _) => begin(assert(name == (String.from)("repo"), "name from url"), assert(url == (String.from)("https://github.com/user/repo.git"), "url preserved"), ()))), ()); },
      (__yo_test_idx == `31`) => { begin(result := parse_package_specifier((String.from)("./my-lib")), match(result, .Err(msg) => assert_dyn(false, msg), .Ok(pkg) => match(pkg, .Git(_, _, _) => assert(false, "expected Path"), .Path(name, rel_path) => begin(assert(name == (String.from)("my-lib"), "name is my-lib"), assert(rel_path == (String.from)("./my-lib"), "rel_path preserved"), ()))), ()); },
      (__yo_test_idx == `32`) => { begin(result := parse_package_specifier((String.from)("notvalid")), match(result, .Ok(_) => assert(false, "expected Err for invalid spec"), .Err(_) => assert(true, "got Err as expected")), ()); },
      (__yo_test_idx == `33`) => { begin(content := (String.from)("mylib :: build.dependency(url: \"https://github.com/u/mylib.git\", ref: \"v1.0.0\");\n"), assert(dependency_exists_in_deps_file(content, (String.from)("mylib")), "git dep found"), ()); },
      (__yo_test_idx == `34`) => { begin(content := (String.from)("locallib :: build.path_dependency(path: \"./local\");\n"), assert(dependency_exists_in_deps_file(content, (String.from)("locallib")), "path dep found"), ()); },
      (__yo_test_idx == `35`) => { begin(content := (String.from)("other :: build.dependency(url: \"https://github.com/u/other.git\", ref: \"v1.0.0\");\n"), assert(!(dependency_exists_in_deps_file(content, (String.from)("mylib"))), "mylib not found"), ()); },
      (__yo_test_idx == `36`) => { begin(content := ((String.from)("mylib :: build.dependency(url: \"https://github.com/u/mylib.git\", ref: \"v1.0.0\");\n").concat)((String.from)("other :: build.dependency(url: \"https://github.com/u/other.git\", ref: \"main\");\n")), names := parse_dependency_names(content), assert((names.len)() == usize(2), "two deps found"), match((names.get)(usize(0)), .None => assert(false, "first dep"), .Some(n) => assert(n == (String.from)("mylib"), "first dep is mylib")), match((names.get)(usize(1)), .None => assert(false, "second dep"), .Some(n) => assert(n == (String.from)("other"), "second dep is other")), ()); },
      (__yo_test_idx == `37`) => { begin(content := (String.from)("locallib :: build.path_dependency(path: \"./local\");\n"), names := parse_dependency_names(content), assert((names.len)() == usize(1), "one dep found"), match((names.get)(usize(0)), .None => assert(false, "first dep"), .Some(n) => assert(n == (String.from)("locallib"), "dep is locallib")), ()); },
      (__yo_test_idx == `38`) => { begin(names := parse_dependency_names((String.from)("")), assert((names.len)() == usize(0), "no deps in empty content"), ()); },
      (__yo_test_idx == `39`) => { begin(result := _build_imports_block((ArrayList(String).new)()), assert((result.contains)((String.from)("ComptimeList(build.ImportEntry)()")), "empty list form"), assert((result.contains)((String.from)("export(imports);")), "export(line present)"), ()); },
      (__yo_test_idx == `40`) => { begin(deps := (ArrayList(String).new)(), (deps.push)((String.from)("mylib")), result := _build_imports_block(deps), assert((result.contains)((String.from)("mylib.module()")), "module() call present"), assert((result.contains)((String.from)("export(imports);")), "export(line present)"), ()); },
      (__yo_test_idx == `41`) => { begin(dep_line := (String.from)("mylib :: build.dependency(url: \"https://github.com/u/mylib.git\", ref: \"v1.0.0\");"), result := _append_dep_to_content((String.from)(""), dep_line), assert((result.contains)(dep_line), "dep line in result"), assert((result.contains)((String.from)("export(imports);")), "imports regenerated"), ()); },
      (__yo_test_idx == `42`) => { begin(content := ((((((String.from)("// --- Dependencies ---\n").concat)((String.from)("other :: build.dependency(url: \"https://github.com/u/other.git\", ref: \"main\");\n")).concat)((String.from)("\n// --- Import list ---\n")).concat)((String.from)("imports :: ComptimeList(build.ImportEntry)(\n")).concat)((String.from)("  { name: \"other\", module: other.module() }\n")).concat)((String.from)(");\nexport(imports);\n")), dep_line := (String.from)("mylib :: build.dependency(url: \"https://github.com/u/mylib.git\", ref: \"v1.0.0\");"), result := _append_dep_to_content(content, dep_line), assert((result.contains)(dep_line), "new dep line present"), assert((result.contains)((String.from)("other")), "existing dep preserved"), assert((result.contains)((String.from)("mylib.module()")), "mylib in imports block"), ()); },
      true => ()
    ),
    .None => ()
  );
});
export(main);
