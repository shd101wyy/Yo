open(import("std/string"));
open(import("std/fmt"));
_(assert : assert, panic : panic) :: import("std/assert");
_(get_global_cache_dir : get_global_cache_dir, get_global_deps_cache_dir : get_global_deps_cache_dir, get_global_versions_cache_dir : get_global_versions_cache_dir, get_version_cache_dir : get_version_cache_dir) :: import("../cache.yo");
();
__yo_batch_env :: import("std/env");
main :: (fn() -> unit)({
  io :: __yo_builtin_io;
  match(__yo_batch_env.env.get(`YO_TEST_INDEX`),
    .Some(__yo_test_idx) => cond(
      (__yo_test_idx == `0`) => { begin(d := get_global_deps_cache_dir(), assert((d.ends_with)((String.from)("/deps")), "deps cache ends with /deps"), ()); },
      (__yo_test_idx == `1`) => { begin(d := get_global_versions_cache_dir(), assert((d.ends_with)((String.from)("/versions")), "versions cache ends with /versions"), ()); },
      (__yo_test_idx == `2`) => { begin(d := get_version_cache_dir((String.from)("0.1.23")), assert((d.ends_with)((String.from)("/versions/0.1.23")), "version dir ends with /versions/0.1.23"), ()); },
      (__yo_test_idx == `3`) => { begin(d := get_global_cache_dir(), assert((d.len)() > usize(0), "cache dir is non-empty"), ()); },
      (__yo_test_idx == `4`) => { begin(root := get_global_cache_dir(), deps := get_global_deps_cache_dir(), assert((deps.starts_with)(root), "deps dir is under cache root"), ()); },
      (__yo_test_idx == `5`) => { begin(root := get_global_cache_dir(), vers := get_global_versions_cache_dir(), assert((vers.starts_with)(root), "versions dir is under cache root"), ()); },
      true => ()
    ),
    .None => ()
  );
});
export(main);
