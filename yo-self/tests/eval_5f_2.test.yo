test "Phase 5fv: binary search iterative", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "arr := [i32(1), i32(3), i32(5), i32(7), i32(9), i32(11), i32(13)];\ntarget := i32(7);\n(lo : i32) = i32(0);\n(hi : i32) = (arr.len() - i32(1));\n(found : i32) = i32(-1);\nwhile (lo <= hi), {\nmid := ((lo + hi) / i32(2));\nmatch(arr.get(mid.to_usize()), .Some(v) => cond((v == target) => { found = mid; lo = (hi + i32(1)); }, (v < target) => { lo = (mid + i32(1)); }, true => { hi = (mid - i32(1)); }), .None => { lo = (hi + i32(1)); });\n};\nexport found;";
