  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "9232"), "collatz(27) max=9232"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "52"), "collatz(7) max=52"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5fz: recursive string length equivalent", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "str_len := (fn(s : str, idx : i32) -> i32)(cond((idx >= s.len()) => i32(0), true => (i32(1) + recur(s, (idx + i32(1))))));\nexport str_len(\"hello\", i32(0));\nexport str_len(\"abcdefghij\", i32(0));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "5"), "hello=5"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "10"), "abcdefghij=10"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5fz: absolute difference array", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "a := [i32(10), i32(20), i32(30), i32(40)];\nb := [i32(8), i32(25), i32(27), i32(45)];\n(total_diff : i32) = i32(0);\n(i : i32) = i32(0);\nwhile (i < a.len()), {\nmatch(a.get(i.to_usize()), .Some(av) => match(b.get(i.to_usize()), .Some(bv) => {\ndiff := cond((av > bv) => (av - bv), true => (bv - av));\ntotal_diff = (total_diff + diff);\n}, .None => ()), .None => ());\ni = (i + i32(1));\n};\nexport total_diff;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "15"), "2+5+3+5=15"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};
