test "Phase 5fk: nested cond with return", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "classify := (fn(n : i32) -> i32)(cond((n < i32(0)) => i32(-1), (n == i32(0)) => i32(0), (n <= i32(10)) => i32(1), (n <= i32(100)) => i32(2), true => i32(3)));\nexport classify(i32(-5));\nexport classify(i32(0));\nexport classify(i32(7));\nexport classify(i32(50));\nexport classify(i32(200));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "-1"), "neg"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "0"), "zero"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "1"), "small"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(3)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "2"), "medium"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(4)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "3"), "large"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

