        .TypeVal(tyb) =>
          match(
            tyb,
            .EnumT(_, _, vnames, _, _, _, vdiscs, _, _) => {
              assert(vnames.len() == usize(3), String.from("3 variants"));
              assert(vdiscs.len() == usize(3), String.from("3 discriminants"));
              match(vdiscs.get(usize(0)),.Some(d) => assert(d == i64(0), String.from("Red=0")),.None => assert(false, String.from("no disc 0")));
              match(vdiscs.get(usize(1)),.Some(d) => assert(d == i64(1), String.from("Green=1")),.None => assert(false, String.from("no disc 1")));
              match(vdiscs.get(usize(2)),.Some(d) => assert(d == i64(2), String.from("Blue=2")),.None => assert(false, String.from("no disc 2")));
            },
            _ => assert(false, String.from("not EnumT"))
          ),
        _ => assert(false, String.from("not TypeVal"))
      ),
    .None => ()
  );
});
test("evaluate: struct(x: i32, y: bool) creates Struct TypeVal", {
  env := empty_env();
  env_ptr := env;
  type_args := ArrayList(AstExpr).new();
  type_args.push(make_labeled_field(String.from("x"), make_ident(String.from("i32"))));
  type_args.push(make_labeled_field(String.from("y"), make_ident(String.from("bool"))));
  expr := make_typedef_call(String.from(BK_STRUCT), type_args);
  result := evaluate(expr, env_ptr);
  check_some(result, String.from("struct"));
  match(
    result,
    .Some(r) => {
      assert(type_value_tag(r.ty) == TypeTag.TType, String.from("ty is TType"));
      match(
        r.value,
        .TypeVal(tyb) =>
          match(
            tyb,
            .Struct({ field_labels : labels, field_types : types, is_reference_semantics : is_ref_sem, is_newtype : is_newtype }) => {
              assert(labels.len() == usize(2), String.from("2 fields"));
              assert(!(is_ref_sem), String.from("not ref sem"));
              assert(!(is_newtype), String.from("not newtype"));
              match(labels.get(usize(0)),.Some(l) => assert(l == "x", String.from("first field x")),.None => assert(false, String.from("no label 0")));
              match(labels.get(usize(1)),.Some(l) => assert(l == "y", String.from("second field y")),.None => assert(false, String.from("no label 1")));
              match(types.get(usize(0)),.Some(t) => assert(type_value_tag(t) == TypeTag.TI32, String.from("x:i32")),.None => assert(false, String.from("no type 0")));
              match(types.get(usize(1)),.Some(t) => assert(type_value_tag(t) == TypeTag.TBool, String.from("y:bool")),.None => assert(false, String.from("no type 1")));
            },
            _ => assert(false, String.from("not Struct"))
          ),
        _ => assert(false, String.from("not TypeVal"))
      );
    },
    .None => ()
  );
});
