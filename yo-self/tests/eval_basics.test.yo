test("evaluate: typed decl counter with while loop", {
  env := Environment.new(`test`);
  // (i : usize) = 0; while runtime(i < 3), { i = (i + 1) }
  // NOTE: raw integer atoms are used (not usize(N)) to keep recursion depth ≤ 6.
  // Using usize(N) would add one more evaluate() frame per literal and
  // overflow the ASAN stack when run after many preceding tests.
  // See: issues/asan-eval-frame-size-after-expr-id.md
  i_init := make_atom(TokenKind.Integer, String.from("0"));
  limit := make_atom(TokenKind.Integer, String.from("3"));
  step := make_atom(TokenKind.Integer, String.from("1"));
  cond_e := make_infix(String.from("<"), make_ident(String.from("i")), limit);
  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(make_infix(String.from("="), make_ident(String.from("i")), make_infix(String.from("+"), make_ident(String.from("i")), step)));
  stmts := ArrayList(AstExpr).new();
  stmts.push(make_typed_decl(String.from("i"), String.from("usize"), i_init));
  stmts.push(make_while(make_runtime(cond_e), make_begin(body_stmts)));
  stmts.push(make_ident(String.from("i")));
  result := evaluate(make_begin(stmts), env);
  check_some(result, String.from("typed counter while"));
  match(
    result,
    .Some(r) => assert(r.value == EvalValue.IntLit(String.from("3")), String.from("i should be 3")),
    .None => ()
  );
});
