  result := evaluate(define_e, env);
  check_some(result, String.from("fn def define"));
  match(
    result,
    .Some(r) => assert(r.value == EvalValue.UnitVal, String.from("define returns unit")),
    .None => ()
  );
  // Look up f — should be FuncVal
  f_res := evaluate(make_ident(String.from("f")), env);
  check_some(f_res, String.from("f is bound"));
  match(
    f_res,
    .Some(r) => match(
      r.value,
      .FuncVal(__fvd, _) => assert(__fvd.*.params.len() == usize(1), String.from("1 param")),
      _ => assert(false, String.from("expected FuncVal"))
    ),
    .None => ()
  );
});
