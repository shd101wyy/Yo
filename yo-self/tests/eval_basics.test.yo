  param_exprs.push(make_forall_param(String.from("A")));
  param_exprs.push(make_typed_param(String.from("x"), String.from("A")));
  // Body: just return A (the TypeVal that should be bound)
  fn_def := make_fn_def_from_param_exprs(param_exprs, make_ident(String.from("A")));
  _d := evaluate(make_infix(String.from(":="), make_ident(String.from("lookup_type")), fn_def), env);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, String.from("99")));
  result := evaluate(make_call(String.from("lookup_type"), call_args), env);
  check_some(result, String.from("lookup_type(99)"));
  match(
    result,
    .Some(r) =>
      match(
        r.value,
        .TypeVal(ty) =>
          // arg was IntLit → type is ComptimeInt
          match(
            ty,
            .ComptimeInt => (),
            _ => {
              assert(false, String.from("A should be TypeVal(ComptimeInt) when called with int"));
            }
          ),
        _ => {
          assert(false, String.from("A inside body should return(TypeVal)"));
        }
      ),
    .None => ()
  );
});
test("evaluate: two forall params both inferred correctly", {
  env := empty_env();
  // swap_types := (fn(forall(A), forall(B), x : A, y : B) -> unit)({ A })
  // When called with (int, bool), A = TypeVal(ComptimeInt)
  param_exprs := ArrayList(AstExpr).new();
  param_exprs.push(make_forall_param(String.from("A")));
  param_exprs.push(make_forall_param(String.from("B")));
  param_exprs.push(make_typed_param(String.from("x"), String.from("A")));
  param_exprs.push(make_typed_param(String.from("y"), String.from("B")));
  fn_def := make_fn_def_from_param_exprs(param_exprs, make_ident(String.from("A")));
  _d := evaluate(make_infix(String.from(":="), make_ident(String.from("type_of_first")), fn_def), env);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, String.from("1")));
  call_args.push(make_atom(TokenKind.Bool, String.from("false")));
  result := evaluate(make_call(String.from("type_of_first"), call_args), env);
  match(
    result,
    .Some(r) =>
      match(
        r.value,
        .TypeVal(ty) =>
          match(
            ty,
            .ComptimeInt => (),
            _ => {
              assert(false, String.from("A should be ComptimeInt"));
            }
          ),
        _ => {
          assert(false, String.from("expected TypeVal for A"));
        }
      ),
    .None => assert(false, String.from("expected Some"))
  );
});
