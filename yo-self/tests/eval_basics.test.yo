test("evaluate: closure captures outer variable (make_adder)", {
  // Verify lexical scoping: inner_fn captures x from the call frame of make_adder.
  // make_adder := (fn(x)(fn(y)(x + y)))
  // add5  := make_adder(5)  — creates closure with x=5 captured
  // result := add5(3)       — evaluates x+y with x=5, y=3 → 8
  env := empty_env();
  // Build inner function body: x + y
  inner_body := make_infix(String.from("+"), make_ident(String.from("x")), make_ident(String.from("y")));
  inner_params := ArrayList(String).new();
  inner_params.push(String.from("y"));
  inner_fn := make_fn_def(inner_params, inner_body);
  // Build outer function: (fn(x) -> unit)(inner_fn)
  outer_params := ArrayList(String).new();
  outer_params.push(String.from("x"));
  make_adder_def := make_fn_def(outer_params, inner_fn);
  // make_adder := make_adder_def
  _d1 := evaluate(make_infix(String.from(":="), make_ident(String.from("make_adder")), make_adder_def), env);
  // add5 := make_adder(5)
  adder_args := ArrayList(AstExpr).new();
  adder_args.push(make_atom(TokenKind.Integer, String.from("5")));
  _d2 := evaluate(
    make_infix(String.from(":="), make_ident(String.from("add5")), make_call(String.from("make_adder"), adder_args)),
    env
  );
  // result := add5(3)
  add5_args := ArrayList(AstExpr).new();
  add5_args.push(make_atom(TokenKind.Integer, String.from("3")));
  result := evaluate(make_call(String.from("add5"), add5_args), env);
  check_some(result, String.from("add5(3) closure"));
  match(
    result,
    .Some(r) => assert(
      r.value == EvalValue.IntLit(String.from("8")),
      String.from("closure: 5+3=8")
    ),
    .None => ()
  );
});
test("evaluate: method dispatch on StructVal (manual registration)", {
  // Manually register Point.get_x := (fn(self) -> i32)(self.x) in env,
  // then call point.get_x() and expect IntLit("1").
  env := empty_env();
  // Register Point.get_x in env
  self_param := ArrayList(String).new();
  self_param.push(String.from("self"));
  get_x_body := make_infix(String.from("."), make_ident(String.from("self")), make_ident(String.from("x")));
  get_x_fn := make_fn_def(self_param, get_x_body);
  match(
    evaluate(get_x_fn, env),
    .Some(fres) => {
      _dm := env.define_val(
        String.from("Point.get_x"),
        fres.ty,
        true,
        .Some(fres.value)
      );
    },
    .None => assert(false, String.from("get_x fn def failed"))
  );
  // point := Point(x: i32(1), y: i32(2))
  one_args := ArrayList(AstExpr).new();
  one_args.push(make_atom(TokenKind.Integer, String.from("1")));
  two_args := ArrayList(AstExpr).new();
  two_args.push(make_atom(TokenKind.Integer, String.from("2")));
  x_arg := make_infix(String.from(":"), make_ident(String.from("x")), make_call(String.from("i32"), one_args));
  y_arg := make_infix(String.from(":"), make_ident(String.from("y")), make_call(String.from("i32"), two_args));
  call_a := ArrayList(AstExpr).new();
  call_a.push(x_arg);
  call_a.push(y_arg);
  _dp := evaluate(make_infix(String.from(":="), make_ident(String.from("point")), make_call(String.from("Point"), call_a)), env);
  // point.get_x()
  empty_args := ArrayList(AstExpr).new();
  method_call := make_infix(String.from("."), make_ident(String.from("point")), make_call(String.from("get_x"), empty_args));
  result := evaluate(method_call, env);
  check_some(result, String.from("point.get_x()"));
  match(
    result,
    .Some(r) => assert(
      r.value == EvalValue.IntLit(String.from("1")),
      String.from("point.get_x() == 1")
    ),
    .None => ()
  );
});
test("evaluate: impl block registers methods", {
  // impl(Point, get_y: (fn(self)(self.y))) then point.get_y() == 2
  env := empty_env();
  // point := Point(x: i32(1), y: i32(2))
  one_args := ArrayList(AstExpr).new();
