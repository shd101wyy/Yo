test("evaluate: anonymous struct literal _(x: 42, y: true)", {
  env := empty_env();
  // Build: _(x: 42, y: true)
  //   = FnCall(Atom("_"), [infix ":" (Atom("x"), Atom("42")), infix ":" (Atom("y"), Atom("true"))], false)
  field_x := make_infix(String.from(":"), make_ident(String.from("x")), make_atom(TokenKind.Integer, String.from("42")));
  field_y := make_infix(String.from(":"), make_ident(String.from("y")), make_atom(TokenKind.Bool, String.from("true")));
  as_args := ArrayList(AstExpr).new();
  as_args.push(field_x);
  as_args.push(field_y);
  anon_struct_expr := make_call(String.from(BK_ANON_STRUCT), as_args);
  result := evaluate(anon_struct_expr, env);
  match(
    result,
    .None => assert(false, String.from("evaluate returned None for anonymous struct")),
    .Some(res) => match(
      res.value,
      .StructVal(_, field_names, field_vals) => {
        assert(field_names.len() == usize(2), String.from("struct has 2 fields"));
        assert(field_vals.len() == usize(2), String.from("struct has 2 values"));
        match(
          field_names.get(usize(0)),
          .Some(n) => assert(n == "x", String.from("first field is x")),
          .None => assert(false, String.from("no first field name"))
        );
        match(
          field_names.get(usize(1)),
          .Some(n) => assert(n == "y", String.from("second field is y")),
          .None => assert(false, String.from("no second field name"))
        );
        match(
          field_vals.get(usize(0)),
          .Some(v) => match(
            v,
            .IntLit(raw) => assert(raw == "42", String.from("x value is 42")),
            _ => assert(false, String.from("x value is not IntLit"))
          ),
          .None => assert(false, String.from("no x value"))
        );
        match(
          field_vals.get(usize(1)),
          .Some(v) => match(
            v,
            .BoolVal(b) => assert(b, String.from("y value is true")),
            _ => assert(false, String.from("y value is not BoolVal"))
          ),
          .None => assert(false, String.from("no y value"))
        );
      },
      _ => assert(false, String.from("result is not StructVal"))
    )
  );
});
