test("evaluate: open(ModuleVal) brings all fields into scope", {
  env := empty_env();
  // Build a module body that exports x = 10 and y = false
  define_x := make_infix(String.from(":="), make_ident(String.from("x")), make_atom(TokenKind.Integer, String.from("10")));
  define_y := make_infix(String.from(":="), make_ident(String.from("y")), make_atom(TokenKind.Bool, String.from("false")));
  export_names := ArrayList(String).new();
  export_names.push(String.from("x"));
  export_names.push(String.from("y"));
  export_expr := make_export(export_names);
  exprs := ArrayList(AstExpr).new();
  exprs.push(define_x);
  exprs.push(define_y);
  exprs.push(export_expr);
  mod_env := empty_env();
  mod_val_opt := evaluate_module_body(exprs, mod_env);
  assert(match(mod_val_opt,.Some(_) => true,.None => false), String.from("module body evaluated"));
  // Bind the module into a variable, then open it
  mod_val := match(mod_val_opt,.Some(v) => v,.None => EvalValue.UnitVal);
  _def := env.define_val(String.from("m"), t_i32(), true,.Some(mod_val));
  open_expr := make_open(make_ident(String.from("m")));
  open_res := evaluate(open_expr, env);
  check_some(open_res, String.from("open returned Some"));
  // Now x and y should be in scope
  x_res := evaluate(make_ident(String.from("x")), env);
  y_res := evaluate(make_ident(String.from("y")), env);
  check_some(x_res, String.from("x is in scope after open"));
  check_some(y_res, String.from("y is in scope after open"));
  match(
    x_res,
    .Some(xr) => assert(xr.value == EvalValue.IntLit(String.from("10")), String.from("x == 10")),
    .None => ()
  );
  match(
    y_res,
    .Some(yr) => assert(yr.value == EvalValue.BoolVal(false), String.from("y == false")),
    .None => ()
  );
});
test("evaluate: { A, B } :: ModuleVal destructures correctly", {
  env := empty_env();
  // Build a module val with exports a = 1, b = 2
  define_a := make_infix(String.from(":="), make_ident(String.from("a")), make_atom(TokenKind.Integer, String.from("1")));
  define_b := make_infix(String.from(":="), make_ident(String.from("b")), make_atom(TokenKind.Integer, String.from("2")));
  export_names := ArrayList(String).new();
  export_names.push(String.from("a"));
  export_names.push(String.from("b"));
  export_expr := make_export(export_names);
  exprs := ArrayList(AstExpr).new();
  exprs.push(define_a);
  exprs.push(define_b);
  exprs.push(export_expr);
  mod_env := empty_env();
  mod_val_opt := evaluate_module_body(exprs, mod_env);
  check_some_eval_val(mod_val_opt, String.from("module body"));
  mod_val := match(mod_val_opt,.Some(v) => v,.None => EvalValue.UnitVal);
  // Bind module as a constant and then destructure: { a, b } :: m
  _def := env.define_val(String.from("m"), t_i32(), true,.Some(mod_val));
  anon_tok := make_token(TokenKind.Identifier, String.from(BK_ANON_STRUCT));
  a_arg_list := ArrayList(AstExpr).new();
  a_arg_list.push(make_ident(String.from("a")));
  a_arg_list.push(make_ident(String.from("b")));
  lhs := (AstExpr).FnCall(usize(0),.Atom(usize(0), anon_tok), a_arg_list, false, anon_tok);
  destr_expr := make_infix(String.from("::"), lhs, make_ident(String.from("m")));
  destr_res := evaluate(destr_expr, env);
  check_some(destr_res, String.from("destructure result"));
  // a and b should now be bound in env
  a_res := evaluate(make_ident(String.from("a")), env);
  b_res := evaluate(make_ident(String.from("b")), env);
  check_some(a_res, String.from("a is bound after destructure"));
  check_some(b_res, String.from("b is bound after destructure"));
  match(
    a_res,
    .Some(ar) => assert(ar.value == EvalValue.IntLit(String.from("1")), String.from("a == 1")),
    .None => ()
  );
  match(
    b_res,
    .Some(br) => assert(br.value == EvalValue.IntLit(String.from("2")), String.from("b == 2")),
    .None => ()
  );
});
test("evaluate: import uses module loader callback", {
  env := empty_env();
  // Register a mock loader that builds the module inline (no closure capture needed)
  set_module_loader(
    (fn(path : String) -> Option(EvalValue))(
      cond(
        (path == "test/my_module") => {
          mock_names_l := ArrayList(String).new();
          mock_names_l.push(String.from("val"));
          mock_vals_l := ArrayList(EvalValue).new();
          mock_vals_l.push(EvalValue.IntLit(String.from("77")));
          .Some(EvalValue.StructVal(String.from("<mock-module>"), mock_names_l, mock_vals_l))
        },
        true => Option(EvalValue).None
      )
    )
  );
  // Evaluate import("test/my_module") and check we get back the module
  import_expr := make_import_expr(String.from("test/my_module"));
  result := evaluate(import_expr, env);
  check_some(result, String.from("import returned Some"));
  match(
    result,
    .Some(r) =>
      match(
        r.value,
        .StructVal(_, names, vals) => {
          assert(names.len() == usize(1), String.from("module has 1 export"));
          match(
            names.get(usize(0)),
            .Some(n) => assert(n == "val", String.from("export(name is val)")),
            .None => assert(false, String.from("missing export(name)"))
          );
          match(
            vals.get(usize(0)),
            .Some(v) => assert(v == EvalValue.IntLit(String.from("77")), String.from("val == 77")),
            .None => assert(false, String.from("missing export(value)"))
          );
        },
        _ => assert(false, String.from("expected ModuleVal from import"))
      ),
    .None => ()
  );
});
