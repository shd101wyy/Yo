// ---------------------------------------------------------------------------
// Phase 3e helpers — function definitions and calls
// ---------------------------------------------------------------------------
/// Build the param-list part of a fn expression: FnCall(Atom("fn"), [p1, p2, …], false).
/// Params are bare atoms (no type annotation) for test simplicity.
make_fn_params :: (fn(param_names : ArrayList(String)) -> AstExpr)({
  param_exprs := ArrayList(AstExpr).new();
  (i : usize) = usize(0);
  while(i < param_names.len(), {
    match(
      param_names.get(i),
      .Some(n) => {
        param_exprs.push(.Atom(usize(0), make_token(TokenKind.Identifier, n.clone())));
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  .FnCall(
    usize(0),
    .Atom(usize(0), make_token(TokenKind.Identifier, String.from("fn"))),
    param_exprs,
    false,
    make_token(TokenKind.Identifier, String.from("fn"))
  )
});
/// Build `(fn(params) -> unit)(body)`.
make_fn_def :: (fn(param_names : ArrayList(String), body : AstExpr) -> AstExpr)({
  fn_expr := make_fn_params(param_names);
  arrow_args := ArrayList(AstExpr).new();
  arrow_args.push(fn_expr);
  arrow_args.push(.Atom(usize(0), make_token(TokenKind.Identifier, String.from("unit"))));
  (fn_sig : AstExpr) =.FnCall(
    usize(0),
    .Atom(usize(0), make_token(TokenKind.Operator, String.from("->"))),
    arrow_args,
    true,
    make_token(TokenKind.Operator, String.from("->"))
  );
  outer_args := ArrayList(AstExpr).new();
  outer_args.push(body);
  (result : AstExpr) =.FnCall(usize(0), fn_sig, outer_args, false, make_token(TokenKind.Operator, String.from("->")));
  result
});
/// Build a function call `name(args…)`.
make_call :: (fn(name : String, call_args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(
    usize(0),
    .Atom(usize(0), make_token(TokenKind.Identifier, name)),
    call_args,
    false,
    make_token(TokenKind.Identifier, name)
  )
);
/// Build `return(expr)`.
make_return :: (fn(expr : AstExpr) -> AstExpr)({
  ret_args := ArrayList(AstExpr).new();
  ret_args.push(expr);
  .FnCall(
    usize(0),
    .Atom(usize(0), make_token(TokenKind.Identifier, String.from("return"))),
    ret_args,
    false,
    make_token(TokenKind.Identifier, String.from("return"))
  )
});
// ---------------------------------------------------------------------------
// Phase 3e — function definitions and calls
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Phase 3f — recur (recursive calls) and :: (constant declarations)
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Phase 3f — type casts: i32(x), u64(x), usize(n), etc.
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Phase 3g helpers — typed declarations and string literals
// ---------------------------------------------------------------------------
/// Build a string-literal atom with the given raw value.
make_str :: (fn(s : String) -> AstExpr)(
  make_atom(TokenKind.StringLit, s)
);
/// Build `(name : type_name) = rhs` — typed variable declaration.
/// e.g. `(x : i32) = i32(5)` → declares x of type i32 with value 5.
make_typed_decl :: (fn(name : String, type_name : String, rhs : AstExpr) -> AstExpr)({
  colon_args := ArrayList(AstExpr).new();
  colon_args.push(make_ident(name));
  colon_args.push(make_ident(type_name));
  (lhs : AstExpr) =.FnCall(
    usize(0),
    .Atom(usize(0), make_token(TokenKind.Operator, String.from(":"))),
    colon_args,
    true,
    make_token(TokenKind.Operator, String.from(":"))
  );
  make_infix(String.from("="), lhs, rhs)
});
// ---------------------------------------------------------------------------
// Phase 3g — typed variable declarations
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Phase 3g — string comparison
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Phase 3h — struct value construction and field access
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Phase 3i — closure capture / lexical scoping
// ---------------------------------------------------------------------------
