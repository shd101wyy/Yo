  y_arg := make_infix(String.from(":"), make_ident(String.from("y")), make_call(String.from("i32"), two_args));
  point_args := ArrayList(AstExpr).new();
  point_args.push(x_arg);
  point_args.push(y_arg);
  _dp := evaluate(make_infix(String.from(":="), make_ident(String.from("point")), make_call(String.from("Point"), point_args)), env);
  // Build impl(Point, get_y: (fn(self)(self.y)))
  self_p := ArrayList(String).new();
  self_p.push(String.from("self"));
  get_y_body := make_infix(String.from("."), make_ident(String.from("self")), make_ident(String.from("y")));
  get_y_fn := make_fn_def(self_p, get_y_body);
  impl_method := make_infix(String.from(":"), make_ident(String.from("get_y")), get_y_fn);
  impl_args := ArrayList(AstExpr).new();
  impl_args.push(make_ident(String.from("Point")));
  impl_args.push(impl_method);
  impl_expr := make_call(String.from("impl"), impl_args);
  _di := evaluate(impl_expr, env);
  // point.get_y()
  empty_a := ArrayList(AstExpr).new();
  method_call := make_infix(String.from("."), make_ident(String.from("point")), make_call(String.from("get_y"), empty_a));
  result := evaluate(method_call, env);
  check_some(result, String.from("point.get_y() via impl"));
  match(
    result,
    .Some(r) => assert(
      r.value == EvalValue.IntLit(String.from("2")),
      String.from("point.get_y() == 2")
    ),
    .None => ()
  );
});
test("evaluate: type identifier i32 resolves to TypeVal", {
  env := empty_env();
  result := evaluate(make_ident(String.from("i32")), env);
  check_some(result, String.from("i32 identifier"));
  match(
    result,
    .Some(r) => {
      match(
        r.value,
        .TypeVal(ty) =>
          match(
            ty,
            .Int(bits, signed) => {
              assert(bits == u8(32), String.from("i32 must have 32 bits"));
              assert(signed, String.from("i32 must be signed"));
            },
            _ => {
              assert(false, String.from("TypeVal ty must be Int(32, true)"));
            }
          ),
        _ => {
          assert(false, String.from("result must be TypeVal"));
        }
      );
      // The type-of a TypeVal is Type (TypeUni level 0)
      match(
        r.ty,
        .TypeUni(_) => (),
        _ => {
          assert(false, String.from("type-of TypeVal must be TypeUni"));
        }
      );
    },
    .None => ()
  );
});
