test("evaluate: identifier found — returns VarRef when no value stored", {
  env := Environment.new(`test`);
  _d := env.define(`x`, t_i32(), false);
  e := make_atom(TokenKind.Identifier, String.from("x"));
  result := evaluate(e, env);
  check_some(result, String.from("identifier x"));
  match(
    result,
    .Some(r) => {
      assert(r.value == EvalValue.VarRef(String.from("x")), String.from("expected VarRef(x)"));
      assert(type_value_tag(r.ty) == TypeTag.TI32, String.from("expected TI32"));
    },
    .None => ()
  );
});
test("evaluate: identifier found — returns stored comptime value", {
  env := Environment.new(`test`);
  _d := env.define_val(`n`, t_comptime_int(), true,.Some(EvalValue.IntLit(String.from("7"))));
  e := make_atom(TokenKind.Identifier, String.from("n"));
  result := evaluate(e, env);
  check_some(result, String.from("identifier n with value"));
  match(
    result,
    .Some(r) => {
      assert(r.value == EvalValue.IntLit(String.from("7")), String.from("expected IntLit(7)"));
      assert(type_value_tag(r.ty) == TypeTag.TComptimeInt, String.from("expected TComptimeInt"));
    },
    .None => ()
  );
});
test("evaluate: identifier not found → None", {
  env := empty_env();
  e := make_atom(TokenKind.Identifier, String.from("unknown"));
  check_none(evaluate(e, env), String.from("unknown identifier"));
});
test("evaluate: identifier in nested frame", {
  env := Environment.new(`test`);
  _d0 := env.define(`outer`, t_bool(), false);
  _pushed := env.push_frame(true);
  _d1 := env.define(`inner`, t_f32(), false);
  e_outer := make_atom(TokenKind.Identifier, String.from("outer"));
  e_inner := make_atom(TokenKind.Identifier, String.from("inner"));
  match(
    evaluate(e_outer, env),
    .Some(r) => assert(type_value_tag(r.ty) == TypeTag.TBool, String.from("outer type")),
    .None => assert(false, String.from("outer must be found"))
  );
  match(
    evaluate(e_inner, env),
    .Some(r) => assert(type_value_tag(r.ty) == TypeTag.TF32, String.from("inner type")),
    .None => assert(false, String.from("inner must be found"))
  );
});
test("evaluate: operator atom → None", {
  e := make_atom(TokenKind.Operator, String.from("+"));
  env := empty_env();
  check_none(evaluate(e, env), String.from("operator atom"));
});
test("evaluate: fn call (unknown fn) → None", {
  (e : AstExpr) =.FnCall(
    usize(0),
    make_ident(String.from("foo")),
    ArrayList(AstExpr).new(),
    false,
    make_token(TokenKind.Identifier, String.from("foo"))
  );
  env := empty_env();
  check_none(evaluate(e, env), String.from("fn call"));
});
