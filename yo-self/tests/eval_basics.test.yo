  _d := evaluate(define_e, env);
  cond_e := make_infix(String.from(">"), make_ident(String.from("n")), make_atom(TokenKind.Integer, String.from("0")));
  body_stmts := ArrayList(AstExpr).new();
  body_stmts.push(make_infix(String.from("="), make_ident(String.from("n")), make_infix(String.from("-"), make_ident(String.from("n")), make_atom(TokenKind.Integer, String.from("1")))));
  body_e := make_begin(body_stmts);
  expr := make_while(cond_e, body_e);
  result := evaluate(expr, env);
  check_some(result, String.from("while runs"));
  // n should be 0 after loop
  n_lookup := evaluate(make_ident(String.from("n")), env);
  check_some(n_lookup, String.from("n after while"));
  match(
    n_lookup,
    .Some(r) => assert(r.value == EvalValue.IntLit(String.from("0")), String.from("n should be 0")),
    .None => ()
  );
});
