test("evaluate: forall param name is extracted into FuncVal.forall_names", {
  env := empty_env();
  // id := (fn(forall(A), x : A) -> unit)(x)
  param_exprs := ArrayList(AstExpr).new();
  param_exprs.push(make_forall_param(String.from("A")));
  param_exprs.push(make_typed_param(String.from("x"), String.from("A")));
  fn_def := make_fn_def_from_param_exprs(param_exprs, make_ident(String.from("x")));
  define_e := make_infix(String.from(":="), make_ident(String.from("id")), fn_def);
  evaluate(define_e, env);
  // Look up id — should be FuncVal with forall_names = ["A"], params = ["x"],
  // param_type_names = ["A"]
  id_res := evaluate(make_ident(String.from("id")), env);
  check_some(id_res, String.from("id is bound"));
  match(
    id_res,
    .Some(r) => match(
      r.value,
      .FuncVal(__fvd, _) => {
        assert(__fvd.*.forall_names.len() == usize(1), String.from("1 forall name"));
        assert(__fvd.*.params.len() == usize(1), String.from("1 value param"));
        assert(__fvd.*.param_type_names.len() == usize(1), String.from("1 param type name"));
        match(
          __fvd.*.forall_names.get(usize(0)),
          .Some(fn_name) => assert(fn_name == "A", String.from("forall name is A")),
          .None => assert(false, String.from("expected forall name A"))
        );
        match(
          __fvd.*.params.get(usize(0)),
          .Some(pn) => assert(pn == "x", String.from("param name is x")),
          .None => assert(false, String.from("expected param x"))
        );
        match(
          __fvd.*.param_type_names.get(usize(0)),
          .Some(ptn) => assert(ptn == "A", String.from("param type name is A")),
          .None => assert(false, String.from("expected param type name A"))
        );
      },
      _ => assert(false, String.from("expected FuncVal"))
    ),
    .None => ()
  );
});
