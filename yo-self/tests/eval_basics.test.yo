  arm_pat_args := ArrayList(AstExpr).new();
  arm_pat_args.push(make_ident(String.from("x")));
  arm := make_arm(make_variant_call(String.from("Some"), arm_pat_args), make_ident(String.from("x")));
  arms := ArrayList(AstExpr).new();
  arms.push(arm);
  expr := make_match(scrutinee, arms);
  _r := evaluate(expr, outer_env);
  // x should not exist outside the match arm
  x_lookup := evaluate(make_ident(String.from("x")), outer_env);
  check_none(x_lookup, String.from("x should not leak out of match arm scope"));
});
