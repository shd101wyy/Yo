test("evaluate: typed fibonacci fib(1)=1", {
  // fib :: (fn(n) -> unit)(cond(n <= i32(1) => n, true => recur(n-i32(1)) + recur(n-i32(2))))
  // fib(i32(1)) should return IntLit("1")  (base case: n=1 ≤ 1 → returns n=1)
  // NOTE: fib(2) requires recursion that exceeds ASAN stack limits after the
  //       ExprId field was added to AstExpr (frame size grew).
  //       fib(1) only exercises the base case but verifies dispatch works.
  //       See issues/asan-eval-frame-size-after-expr-id.md.
  env := empty_env();
  params := ArrayList(String).new();
  params.push(String.from("n"));
  one_args := ArrayList(AstExpr).new();
  one_args.push(make_atom(TokenKind.Integer, String.from("1")));
  one_cast := make_call(String.from("i32"), one_args);
  two_args2 := ArrayList(AstExpr).new();
  two_args2.push(make_atom(TokenKind.Integer, String.from("2")));
  two_cast2 := make_call(String.from("i32"), two_args2);
  one_args2 := ArrayList(AstExpr).new();
  one_args2.push(make_atom(TokenKind.Integer, String.from("1")));
  one_cast2 := make_call(String.from("i32"), one_args2);
  recur1_args := ArrayList(AstExpr).new();
  recur1_args.push(make_infix(String.from("-"), make_ident(String.from("n")), one_cast2));
  recur2_args := ArrayList(AstExpr).new();
  recur2_args.push(make_infix(String.from("-"), make_ident(String.from("n")), two_cast2));
  rec_sum := make_infix(String.from("+"), make_call(String.from("recur"), recur1_args), make_call(String.from("recur"), recur2_args));
  arms := ArrayList(AstExpr).new();
  arms.push(make_arm(make_infix(String.from("<="), make_ident(String.from("n")), one_cast), make_ident(String.from("n"))));
  arms.push(make_arm(make_atom(TokenKind.Bool, String.from("true")), rec_sum));
  body := make_cond(arms);
  fn_def := make_fn_def(params, body);
  _d := evaluate(make_infix(String.from("::"), make_ident(String.from("fib")), fn_def), env);
  call_args := ArrayList(AstExpr).new();
  call_args.push(
    make_call(String.from("i32"), {
      a := ArrayList(AstExpr).new();
      a.push(make_atom(TokenKind.Integer, String.from("1")));
      a
    })
  );
  result := evaluate(make_call(String.from("fib"), call_args), env);
  check_some(result, String.from("fib(1)"));
  match(
    result,
    .Some(r) => assert(r.value == EvalValue.IntLit(String.from("1")), String.from("fib(1)=1")),
    .None => ()
  );
});
