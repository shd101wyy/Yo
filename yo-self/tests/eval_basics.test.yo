test("Phase 3am: box and deref round-trip", {
  // Since the Box/ref rework, `box(42)` is RUNTIME-only (`::` bindings reject
  // it: "can only be used at the runtime") and comptime deref of a plain int
  // (`a :: 42; a.*`) is an eval error in BOTH compilers. The seam under test
  // (box + deref through evaluate_module_body) now round-trips the SHAPE:
  // a runtime box/deref binds and exports `b` (a runtime-unknown i32), so
  // assert the export exists rather than a comptime IntLit value.
  src := String.from("a := box(42); b := a.*; export(b);");
  env := empty_env();
  exn := Exception(
    throw : (
      (err) -> {
        err;
        assert(false, String.from("parse error"));
        unwind(());
      }
    )
  );
  exprs := generate_exprs_from_code(src, exn);
  result := evaluate_module_body(exprs, env);
  match(
    result,
    .None => assert(false, String.from("evaluate_module_body returned None")),
    .Some(mod_val) =>
      match(
        mod_val,
        .StructVal(_, names, _) => {
          assert(names.len() == usize(1), String.from("1 export"));
          match(
            names.get(usize(0)),
            .Some(n) => assert(n == "b", String.from("export is b")),
            .None => assert(false, String.from("no export name"))
          );
        },
        _ => assert(false, String.from("not a module StructVal"))
      )
  );
});
