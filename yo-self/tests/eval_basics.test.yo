    },
    .None => ()
  );
});
test("evaluate: empty begin block → unit", {
  e := make_begin(ArrayList(AstExpr).new());
  env := empty_env();
  result := evaluate(e, env);
  check_some(result, String.from("empty begin"));
  match(
    result,
    .Some(r) => {
      assert(r.value == EvalValue.UnitVal, String.from("expected UnitVal"));
      assert(type_value_tag(r.ty) == TypeTag.TUnit, String.from("expected TUnit"));
    },
    .None => ()
