test("evaluate: recur simple countdown", {
  // count := (fn(n) -> unit)(cond(n > 0 => recur(n - 1), true => n)); count(1) → 0
  // NOTE: macOS native binary has a 32 MB stack reserve (set via -Wl,-stack_size,0x2000000
  //       in src/test-runner.ts). The evaluate() function uses ~1.5 MB per frame at -O0;
  //       count(1) needs ~5 simultaneous frames (~7.5 MB), which exceeded the 8 MB default.
  //       See issues/asan-eval-frame-size-after-expr-id.md.
  env := empty_env();
  params := ArrayList(String).new();
  params.push(String.from("n"));
  // cond(n > 0 => recur(n-1), true => n)
  recur_args := ArrayList(AstExpr).new();
  recur_args.push(make_infix(String.from("-"), make_ident(String.from("n")), make_atom(TokenKind.Integer, String.from("1"))));
  recur_call := make_call(String.from("recur"), recur_args);
  arms := ArrayList(AstExpr).new();
  arms.push(make_arm(make_infix(String.from(">"), make_ident(String.from("n")), make_atom(TokenKind.Integer, String.from("0"))), recur_call));
  arms.push(make_arm(make_atom(TokenKind.Bool, String.from("true")), make_ident(String.from("n"))));
  body := make_cond(arms);
  fn_def := make_fn_def(params, body);
  _d := evaluate(make_infix(String.from(":="), make_ident(String.from("count")), fn_def), env);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, String.from("1")));
  result := evaluate(make_call(String.from("count"), call_args), env);
  check_some(result, String.from("countdown"));
  match(
    result,
    .Some(r) => assert(r.value == EvalValue.IntLit(String.from("0")), String.from("count(1)=0")),
    .None => ()
  );
});
test("evaluate: recur factorial", {
  // fact := (fn(n) -> unit)(cond(n <= 1 => 1, true => n * recur(n-1))); fact(1) → 1
  // NOTE: fact(2) now overflows the ASAN-instrumented stack on macOS ARM64 (8MB).
  //       After adding ExprId field to AstExpr and growing evaluate's frame size,
  //       the infix `*` branch requires too many nested evaluate frames.
  //       We test fact(1) (base-case only) to verify function definition + cond.
  //       Recursion itself is covered by "recur simple countdown".
  //       See issues/asan-eval-frame-size-after-expr-id.md.
  env := empty_env();
  params := ArrayList(String).new();
  params.push(String.from("n"));
  recur_args := ArrayList(AstExpr).new();
  recur_args.push(make_infix(String.from("-"), make_ident(String.from("n")), make_atom(TokenKind.Integer, String.from("1"))));
  mul_recur := make_infix(String.from("*"), make_ident(String.from("n")), make_call(String.from("recur"), recur_args));
  arms := ArrayList(AstExpr).new();
  arms.push(make_arm(make_infix(String.from("<="), make_ident(String.from("n")), make_atom(TokenKind.Integer, String.from("1"))), make_atom(TokenKind.Integer, String.from("1"))));
  arms.push(make_arm(make_atom(TokenKind.Bool, String.from("true")), mul_recur));
  body := make_cond(arms);
  fn_def := make_fn_def(params, body);
  _d := evaluate(make_infix(String.from(":="), make_ident(String.from("fact")), fn_def), env);
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, String.from("1")));
  result := evaluate(make_call(String.from("fact"), call_args), env);
  check_some(result, String.from("fact(1)"));
  match(
    result,
    .Some(r) => assert(r.value == EvalValue.IntLit(String.from("1")), String.from("fact(1)=1")),
    .None => ()
  );
});
test("evaluate: :: constant declaration", {
  // PI :: 314  (simulated constant binding)
  env := empty_env();
  define_e := make_infix(String.from("::"), make_ident(String.from("PI")), make_atom(TokenKind.Integer, String.from("314")));
  result := evaluate(define_e, env);
  check_some(result, String.from(":: define"));
  pi_res := evaluate(make_ident(String.from("PI")), env);
  check_some(pi_res, String.from("PI lookup"));
  match(
    pi_res,
    .Some(r) => assert(r.value == EvalValue.IntLit(String.from("314")), String.from("PI=314")),
    .None => ()
  );
});
