test("evaluate: comptime(Name) param extracted in fn def", {
  env := empty_env();
  // Build param: `comptime(T) : Type` (infix colon with comptime(T) as name)
  ct_inner_args := ArrayList(AstExpr).new();
  ct_inner_args.push(make_ident(String.from("T")));
  ct_param_name := (AstExpr).FnCall(
    usize(0),
    .Atom(usize(0), make_token(TokenKind.Identifier, String.from("comptime"))),
    ct_inner_args,
    false,
    make_token(TokenKind.Identifier, String.from("comptime"))
  );
  colon_args := ArrayList(AstExpr).new();
  colon_args.push(ct_param_name);
  colon_args.push(make_ident(String.from("Type")));
  colon_param := (AstExpr).FnCall(
    usize(0),
    .Atom(usize(0), make_token(TokenKind.Operator, String.from(":"))),
    colon_args,
    true,
    make_token(TokenKind.Operator, String.from(":"))
  );
  // Build (fn(colon_param) -> unit)(T) — body just returns T
  param_list := ArrayList(AstExpr).new();
  param_list.push(colon_param);
  fn_head := (AstExpr).FnCall(
    usize(0),
    .Atom(usize(0), make_token(TokenKind.Identifier, String.from("fn"))),
    param_list,
    false,
    make_token(TokenKind.Identifier, String.from("fn"))
  );
  arrow_args := ArrayList(AstExpr).new();
  arrow_args.push(fn_head);
  arrow_args.push(make_ident(String.from("unit")));
  fn_sig := (AstExpr).FnCall(
    usize(0),
    .Atom(usize(0), make_token(TokenKind.Operator, String.from("->"))),
    arrow_args,
    true,
    make_token(TokenKind.Operator, String.from("->"))
  );
  outer_args := ArrayList(AstExpr).new();
  outer_args.push(make_ident(String.from("T")));
  fn_def := (AstExpr).FnCall(usize(0), fn_sig, outer_args, false, make_token(TokenKind.Operator, String.from("->")));
  // f := fn_def
  _d := evaluate(make_infix(String.from(":="), make_ident(String.from("f")), fn_def), env);
  // Call f(3) — T should be bound to IntLit("3"), body returns T
  call_args := ArrayList(AstExpr).new();
  call_args.push(make_atom(TokenKind.Integer, String.from("3")));
  result := evaluate(make_call(String.from("f"), call_args), env);
  check_some(result, String.from("comptime param call"));
  match(
    result,
    .Some(r) => assert(r.value == EvalValue.IntLit(String.from("3")), String.from("f(3)=3")),
    .None => ()
  );
});
test("evaluate: using param is extracted into FuncVal.evidence_params", {
  env := empty_env();
  // Build (fn(ev : bool) -> bool)(ev)
  params_e := ArrayList(AstExpr).new();
  params_e.push(make_using_param(String.from("ev"), String.from("bool")));
  fn_def_e := make_typed_fn_def(params_e, make_ident(String.from("bool")), make_ident(String.from("ev")));
  // f := fn_def_e
  _d := evaluate(make_infix(String.from(":="), make_ident(String.from("f")), fn_def_e), env);
  // Look up f — FuncVal should have evidence_params=["ev"], params=[]
  f_var := env.lookup(String.from("f"));
  match(
    f_var,
    .Some(v) => match(
      v.value,
      .Some(fval) => match(
        fval,
        .FuncVal(__fvd, _) => {
          assert(__fvd.*.params.len() == usize(0), String.from("no regular params"));
          assert(__fvd.*.evidence_params.len() == usize(1), String.from("1 evidence param"));
          match(
            __fvd.*.evidence_params.get(usize(0)),
            .Some(evn) => assert(evn == "ev", String.from("evidence name is ev")),
            .None => assert(false, String.from("no evidence name"))
          );
        },
        _ => assert(false, String.from("expected FuncVal"))
      ),
      .None => assert(false, String.from("no value"))
    ),
    .None => assert(false, String.from("f not found"))
  );
});
test("evaluate: name at call site evaluates to bound value", {
  env := empty_env();
  // Bind: my_ev = BoolVal(false)
  _d := env.define_val(String.from("my_ev"), t_bool(), true,.Some(EvalValue.BoolVal(false)));
  // Evaluate my_ev — should look up my_ev and return BoolVal(false)
  result := evaluate(make_using_call(make_ident(String.from("my_ev"))), env);
  check_some(result, String.from("my_ev"));
  match(
    result,
    .Some(r) => assert(r.value == EvalValue.BoolVal(false), String.from("my_ev=false")),
    .None => ()
  );
});
test("evaluate: evidence param is in scope inside function body", {
  env := empty_env();
  // Bind: ev_val = BoolVal(true)
  _dv := env.define_val(String.from("ev_val"), t_bool(), true,.Some(EvalValue.BoolVal(true)));
  // Build (fn(ev : bool) -> bool)(ev) — body returns ev
  params_b := ArrayList(AstExpr).new();
  params_b.push(make_using_param(String.from("ev"), String.from("bool")));
  fn_def_b := make_typed_fn_def(params_b, make_ident(String.from("bool")), make_ident(String.from("ev")));
  // f := fn_def_b
  _d := evaluate(make_infix(String.from(":="), make_ident(String.from("f")), fn_def_b), env);
  // Call f(ev_val) — evidence passes BoolVal(true) as ev
  call_args_b := ArrayList(AstExpr).new();
  call_args_b.push(make_using_call(make_ident(String.from("ev_val"))));
  result := evaluate(make_call(String.from("f"), call_args_b), env);
  check_some(result, String.from("evidence in body"));
  match(
    result,
    .Some(r) => assert(r.value == EvalValue.BoolVal(true), String.from("ev=true in body")),
    .None => ()
  );
});
test("evaluate: evidence param passed alongside regular params", {
  env := empty_env();
  // Bind: factor = IntLit("3")
  _dv := env.define_val(String.from("factor"), t_comptime_int(), true,.Some(EvalValue.IntLit(String.from("3"))));
  // Build (fn(x : i32, m : i32) -> i32)(x * m)
  colon_x := make_infix(String.from(":"), make_ident(String.from("x")), make_ident(String.from("i32")));
  params_m := ArrayList(AstExpr).new();
  params_m.push(colon_x);
  params_m.push(make_using_param(String.from("m"), String.from("i32")));
  fn_def_m := make_typed_fn_def(params_m, make_ident(String.from("i32")), make_infix(String.from("*"), make_ident(String.from("x")), make_ident(String.from("m"))));
  _d := evaluate(make_infix(String.from(":="), make_ident(String.from("mul")), fn_def_m), env);
  // Call mul(5, factor) — x=5, m=3 → 15
  call_args_m := ArrayList(AstExpr).new();
  call_args_m.push(make_atom(TokenKind.Integer, String.from("5")));
  call_args_m.push(make_using_call(make_ident(String.from("factor"))));
  result := evaluate(make_call(String.from("mul"), call_args_m), env);
  check_some(result, String.from("mul with evidence"));
  match(
    result,
    .Some(r) => assert(r.value == EvalValue.IntLit(String.from("15")), String.from("5*3=15")),
    .None => ()
  );
});
