test("evaluate: bool literal true", {
  e := make_atom(TokenKind.Bool, String.from("true"));
  env := empty_env();
  result := evaluate(e, env);
  check_some(result, String.from("bool true"));
  match(
    result,
    .Some(r) => {
      assert(r.value == EvalValue.BoolVal(true), String.from("expected BoolVal(true)"));
      assert(type_value_tag(r.ty) == TypeTag.TBool, String.from("expected TBool"));
    },
    .None => ()
  );
});
test("evaluate: bool literal false", {
  e := make_atom(TokenKind.Bool, String.from("false"));
  env := empty_env();
  result := evaluate(e, env);
  check_some(result, String.from("bool false"));
  match(
    result,
    .Some(r) => {
      assert(r.value == EvalValue.BoolVal(false), String.from("expected BoolVal(false)"));
      assert(type_value_tag(r.ty) == TypeTag.TBool, String.from("expected TBool"));
    },
    .None => ()
  );
});
