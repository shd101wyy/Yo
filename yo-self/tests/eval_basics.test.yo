test("evaluate: enum(None, Some(value: T)) creates EnumT TypeVal", {
  env := make_env_with_T();
  env_ptr := env;
  none_expr := make_ident(String.from("None"));
  val_field := make_labeled_field(String.from("value"), make_ident(String.from("T")));
  some_args := ArrayList(AstExpr).new();
  some_args.push(val_field);
  some_expr := make_variant(String.from("Some"), some_args);
  type_args := ArrayList(AstExpr).new();
  type_args.push(none_expr);
  type_args.push(some_expr);
  expr := make_typedef_call(String.from(BK_ENUM), type_args);
  result := evaluate(expr, env_ptr);
  check_some(result, String.from("enum(...)(should return(Some))"));
  match(
    result,
    .Some(r) => {
      assert(type_value_tag(r.ty) == TypeTag.TType, String.from("result.ty should be TType"));
      match(
        r.value,
        .TypeVal(tyb) =>
          match(
            tyb,
            .EnumT(_, _, vnames, vfields_all, _, _, _, _, _) => {
              assert(vnames.len() == usize(2), String.from("should have 2 variants"));
              match(vnames.get(usize(0)),.Some(n) => assert(n == "None", String.from("first variant is None")),.None => assert(false, String.from("no variant 0")));
              match(vnames.get(usize(1)),.Some(n) => assert(n == "Some", String.from("second variant is Some")),.None => assert(false, String.from("no variant 1")));
              match(vfields_all.get(usize(0)),.Some(f) => assert(f.len() == usize(0), String.from("None has no fields")),.None => assert(false, String.from("no fields 0")));
              match(vfields_all.get(usize(1)),.Some(f) => assert(f.len() == usize(1), String.from("Some has 1 field")),.None => assert(false, String.from("no fields 1")));
            },
            _ => assert(false, String.from("not an EnumT"))
          ),
        _ => assert(false, String.from("not a TypeVal"))
      );
    },
    .None => ()
  );
});
test("evaluate: enum(Red, Green, Blue) plain fieldless variants", {
  env := empty_env();
