test("evaluate: string literal type", {
  e := make_atom(TokenKind.StringLit, String.from("hello"));
  env := empty_env();
  result := evaluate(e, env);
  check_some(result, String.from("string lit"));
  match(
    result,
    .Some(r) => {
      match(
        r.value,
        .StrLit(_) => (),
        _ => {
          println(`FAIL: expected StrLit variant`);
          assert(false, String.from("expected StrLit"));
        }
      );
      assert(type_value_tag(r.ty) == TypeTag.TComptimeString, String.from("expected TComptimeString"));
    },
    .None => ()
  );
});
