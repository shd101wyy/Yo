test("evaluate: begin block returns last stmt value", {
  stmts := ArrayList(AstExpr).new();
  stmts.push(make_atom(TokenKind.Integer, String.from("1")));
  stmts.push(make_atom(TokenKind.Integer, String.from("2")));
  stmts.push(make_atom(TokenKind.Integer, String.from("42")));
  e := make_begin(stmts);
  env := empty_env();
  result := evaluate(e, env);
  check_some(result, String.from("begin last value"));
  match(
    result,
    .Some(r) => {
      assert(r.value == EvalValue.IntLit(String.from("42")), String.from("expected IntLit(42)"));
    },
    .None => ()
  );
});
test("evaluate: begin block with define then lookup", {
  // { x := 99; x }
  define_stmt := make_infix(String.from(":="), make_ident(String.from("x")), make_atom(TokenKind.Integer, String.from("99")));
  stmts := ArrayList(AstExpr).new();
  stmts.push(define_stmt);
  stmts.push(make_ident(String.from("x")));
  e := make_begin(stmts);
  env := empty_env();
  result := evaluate(e, env);
  check_some(result, String.from("begin define+lookup"));
  match(
    result,
    .Some(r) => {
      assert(r.value == EvalValue.IntLit(String.from("99")), String.from("expected IntLit(99)"));
      assert(type_value_tag(r.ty) == TypeTag.TComptimeInt, String.from("expected TComptimeInt"));
    },
    .None => ()
  );
});
test("evaluate: begin block scope is isolated from outer env", {
  env := Environment.new(`test`);
  define_stmt := make_infix(String.from(":="), make_ident(String.from("tmp")), make_atom(TokenKind.Integer, String.from("5")));
  stmts := ArrayList(AstExpr).new();
  stmts.push(define_stmt);
  e := make_begin(stmts);
  _r := evaluate(e, env);
  // after the begin block, 'tmp' should NOT be visible in the outer env
  lookup_result := evaluate(make_ident(String.from("tmp")), env);
  check_none(lookup_result, String.from("tmp not visible outside begin"));
});
