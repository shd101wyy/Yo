test("evaluate: TypeVal is comptime", {
  env := empty_env();
  result := evaluate(make_ident(String.from("i32")), env);
  match(
    result,
    .Some(r) => {
      match(
        r.value,
        .TypeVal(_) => (),
        _ => {
          assert(false, String.from("expected TypeVal"));
        }
      );
      // TypeVal equality: two TypeVals for i32 should compare equal
      (tv_a : EvalValue) = EvalValue.TypeVal(t_i32());
      (tv_b : EvalValue) = EvalValue.TypeVal(t_i32());
      assert(tv_a == tv_b, String.from("TypeVal(i32) == TypeVal(i32)"));
      (tv_c : EvalValue) = EvalValue.TypeVal(t_bool());
      assert(!(tv_a == tv_c), String.from("TypeVal(i32) != TypeVal(bool)"));
    },
    .None => {
      assert(false, String.from("expected Some"));
    }
  );
});
