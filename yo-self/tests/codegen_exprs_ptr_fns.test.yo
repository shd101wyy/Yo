/// Tests for yo-self/codegen/exprs/ptr_fns.yo (partial port —
/// pure formatters only).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{
  format_address_of,
  format_address_of_compound_literal,
  format_slice_index_range
} :: import("../codegen/exprs/ptr_fns.yo");
test("format_address_of: wraps an identifier", {
  out := format_address_of(String.from("x"));
  assert(out == String.from("(&x)"), "(&x)");
});
test("format_address_of: wraps a struct field access", {
  out := format_address_of(String.from("self.count"));
  assert(out == String.from("(&self.count)"), "(&self.count)");
});
test("format_address_of: wraps a complex expression verbatim", {
  // TS does no inner parenthesisation — relies on the caller to
  // produce a well-formed primary expression. Mirror exactly.
  out := format_address_of(String.from("foo(bar)"));
  assert(out == String.from("(&foo(bar))"), "complex passthrough");
});
test("format_slice_index_range: exclusive range", {
  out := format_slice_index_range(
    String.from("Slice_i32"),
    String.from("arr"),
    String.from("0"),
    String.from("3"),
    false
  );
  assert(
    out == String.from("(Slice_i32){ .data = &arr.data[0], .length = (3) - (0) }"),
    "exclusive layout"
  );
});
test("format_slice_index_range: inclusive range appends `+ 1`", {
  out := format_slice_index_range(
    String.from("Slice_u8"),
    String.from("buf"),
    String.from("start"),
    String.from("end"),
    true
  );
  assert(
    out == String.from("(Slice_u8){ .data = &buf.data[start], .length = (end) - (start) + 1 }"),
    "inclusive layout"
  );
});
test("format_slice_index_range: complex start/end expressions wrap correctly", {
  // TS pre-wraps `(end)` and `(start)` so caller expressions like
  // `a + b` parse as a single operand inside the subtraction.
  out := format_slice_index_range(
    String.from("S"),
    String.from("a"),
    String.from("i + 1"),
    String.from("n - 1"),
    false
  );
  assert(
    out == String.from("(S){ .data = &a.data[i + 1], .length = (n - 1) - (i + 1) }"),
    "complex expressions"
  );
});
test("format_address_of_compound_literal: numeric value", {
  // `&1` is not valid C; the literal must be wrapped in a compound
  // literal with an explicit type. Pin the exact shape that TS emits
  // (`(&(int32_t){1})`) — note the outer parens around `&...`.
  out := format_address_of_compound_literal(
    String.from("int32_t"),
    String.from("1")
  );
  assert(out == String.from("(&(int32_t){1})"), "numeric compound literal");
});
test("format_address_of_compound_literal: boolean value", {
  out := format_address_of_compound_literal(
    String.from("bool"),
    String.from("true")
  );
  assert(out == String.from("(&(bool){true})"), "boolean compound literal");
});
test("format_address_of_compound_literal: complex type / arg", {
  // The formatter doesn't inspect inputs — it just wraps. Pin the
  // passthrough contract for callers that pre-sanitize.
  out := format_address_of_compound_literal(
    String.from("uint64_t"),
    String.from("(x + 1) * 2")
  );
  assert(
    out == String.from("(&(uint64_t){(x + 1) * 2})"),
    "passthrough composition"
  );
});
