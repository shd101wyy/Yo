/// Tests for yo-self/codegen/exprs/dyn.yo (partial port — leaf path
/// for resolved object / iso underlying types).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue } :: import("../types/definitions.yo");
{ t_i32 } :: import("../types/creators.yo");
{ type_to_string } :: import("../types/string.yo");
{ EvalValue } :: import("../value.yo");
{ CodegenContext, CodegenTypeEntry } :: import("../codegen/context.yo");
{
  generate_dyn_for_resolved_inputs,
  format_dyn_vtable_name,
  format_dyn_compound_literal,
  format_dyn_impl_key,
  format_dyn_struct_decl_header,
  format_dyn_data_init,
  format_dyn_vtable_init,
  format_dyn_struct_decl_close
} :: import("../codegen/exprs/dyn.yo");
mk_struct :: (
  fn(name : str, is_reference_semantics : bool) -> TypeValue
)(
  TypeValue.Struct(
    String.from(""),
    String.from(name),
    ArrayList(String).new(),
    ArrayList(TypeValue).new(),
    is_reference_semantics,
    false,
    false
  )
);
mk_dyn :: (fn() -> TypeValue)({
  empty_traits := ArrayList(TypeValue).new();
  empty_levels := ArrayList(usize).new();
  TypeValue.DynT(
    empty_traits,
    empty_levels,
    empty_traits.clone(),
    empty_levels.clone()
  )
});
install_type :: (
  fn(ctx : *(CodegenContext), ty : TypeValue, c_name : str) -> unit
)({
  entry := CodegenTypeEntry(type_value : ty, c_name : String.from(c_name));
  _ := ctx.*.types.set(type_to_string(ty), entry);
});
test("dyn: non-Dyn target type → None", {
  ctx := CodegenContext.new();
  obj := mk_struct("Counter", true);
  out := generate_dyn_for_resolved_inputs(
    String.from("x"),
    obj,
    t_i32(),
    // not Dyn
    ArrayList(EvalValue).new(),
    String.from("tmp"),
    &(ctx),
    String.from("  ")
  );
  assert(out.is_none(), "t_i32 dyn_type → None");
});
test("dyn: value-semantics struct value → None", {
  ctx := CodegenContext.new();
  // is_reference_semantics=false → not an object, not iso → None.
  val := mk_struct("Point", false);
  out := generate_dyn_for_resolved_inputs(
    String.from("p"),
    val,
    mk_dyn(),
    ArrayList(EvalValue).new(),
    String.from("tmp"),
    &(ctx),
    String.from("  ")
  );
  assert(out.is_none(), "value struct → None");
});
test("dyn: empty temp-var name → None", {
  ctx := CodegenContext.new();
  obj := mk_struct("Counter", true);
  out := generate_dyn_for_resolved_inputs(
    String.from("x"),
    obj,
    mk_dyn(),
    ArrayList(EvalValue).new(),
    String.from(""),
    &(ctx),
    String.from("  ")
  );
  assert(out.is_none(), "no temp var → None");
});
test("dyn: object type + registered c-names emits struct-literal decl", {
  ctx := CodegenContext.new();
  obj := mk_struct("Counter", true);
  install_type(&(ctx), obj, "yo_counter");
  dyn_ty := mk_dyn();
  install_type(&(ctx), dyn_ty, "yo_dyn_show");
  out := generate_dyn_for_resolved_inputs(
    String.from("c"),
    obj,
    dyn_ty,
    ArrayList(EvalValue).new(),
    String.from("d"),
    &(ctx),
    String.from("  ")
  );
  match(
    out,
    .None => assert(false, "expected Some"),
    .Some(s) => assert(s == String.from("d"), "returns temp")
  );
  emitted := ctx.emitter.code;
  // Each emitted line is asserted as a substring.
  assert(
    emitted.contains(String.from("  yo_dyn_show d = {")),
    "decl line"
  );
  assert(
    emitted.contains(String.from("  .data = c,")),
    "data line"
  );
  assert(
    emitted.contains(String.from("  .vtable = &__yo_vtable_yo_counter_yo_dyn_show")),
    "vtable line"
  );
  assert(
    emitted.contains(String.from("};")),
    "closing brace"
  );
});
test("dyn: temp-var name is sanitised", {
  // `.` (byte 46) mangles to `_u46_` via the canonical sanitizer.
  ctx := CodegenContext.new();
  obj := mk_struct("Counter", true);
  install_type(&(ctx), obj, "yo_counter");
  dyn_ty := mk_dyn();
  install_type(&(ctx), dyn_ty, "yo_dyn_show");
  out := generate_dyn_for_resolved_inputs(
    String.from("c"),
    obj,
    dyn_ty,
    ArrayList(EvalValue).new(),
    String.from("tmp.value"),
    &(ctx),
    String.from("  ")
  );
  match(
    out,
    .Some(s) => assert(s == String.from("tmp_u46_value"), "sanitised"),
    .None => assert(false, "expected Some")
  );
});
test("dyn: impl is registered in ctx.dyn_impls", {
  ctx := CodegenContext.new();
  obj := mk_struct("Counter", true);
  install_type(&(ctx), obj, "yo_counter");
  dyn_ty := mk_dyn();
  install_type(&(ctx), dyn_ty, "yo_dyn_show");
  _ := generate_dyn_for_resolved_inputs(
    String.from("c"),
    obj,
    dyn_ty,
    ArrayList(EvalValue).new(),
    String.from("d"),
    &(ctx),
    String.from("  ")
  );
  key := String.from("yo_counter_yo_dyn_show");
  match(
    ctx.dyn_impls.get(key),
    .None => assert(false, "expected impl entry"),
    .Some(_entry) => assert(true, "registered")
  );
});
test("dyn: repeated calls deduplicate impl registration", {
  ctx := CodegenContext.new();
  obj := mk_struct("Counter", true);
  install_type(&(ctx), obj, "yo_counter");
  dyn_ty := mk_dyn();
  install_type(&(ctx), dyn_ty, "yo_dyn_show");
  _ := generate_dyn_for_resolved_inputs(
    String.from("c1"),
    obj,
    dyn_ty,
    ArrayList(EvalValue).new(),
    String.from("d1"),
    &(ctx),
    String.from("  ")
  );
  // Different value_code / temp_var, same (concrete,dyn) pair → should
  // not re-register. The dyn_impls map is dedup'd by impl key.
  before := ctx.dyn_impls.len();
  _ := generate_dyn_for_resolved_inputs(
    String.from("c2"),
    obj,
    dyn_ty,
    ArrayList(EvalValue).new(),
    String.from("d2"),
    &(ctx),
    String.from("  ")
  );
  after := ctx.dyn_impls.len();
  assert(before == after, "second call does not grow dyn_impls");
});
// ─── pure formatters ────────────────────────────────────────────────────────
test("format_dyn_vtable_name: prefixes + sanitises impl_key", {
  // Simple identifier-only key — no sanitisation needed.
  out := format_dyn_vtable_name(String.from("Counter_DynShow"));
  assert(
    out == String.from("__yo_vtable_Counter_DynShow"),
    "no sanitisation"
  );
});
test("format_dyn_vtable_name: sanitises non-identifier chars", {
  // A key with `(`/`)` (e.g. `Box(T)_DynShow`) gets mangled per the
  // canonical sanitizer so the resulting symbol is a valid C
  // identifier.
  out := format_dyn_vtable_name(String.from("Box(T)_DynShow"));
  // Expected: __yo_vtable_Box_u40_T_u41__DynShow
  assert(
    out == String.from("__yo_vtable_Box_u40_T_u41__DynShow"),
    "parens sanitised"
  );
});
test("format_dyn_compound_literal: assembles dyn value", {
  // The compound-literal form used in rvalue positions, parallel to
  // the 4-line named-decl form in `generate_dyn_for_resolved_inputs`.
  out := format_dyn_compound_literal(
    String.from("Dyn_Show"),
    String.from("&local_counter"),
    String.from("__yo_vtable_Counter_Show")
  );
  assert(
    out ==
      String.from(
        "(Dyn_Show){ .data = &local_counter, .vtable = &__yo_vtable_Counter_Show }"
      ),
    "compound literal shape"
  );
});
// ─── struct-literal-line formatters ─────────────────────────────────────────
test("format_dyn_impl_key: joins concrete and dyn with underscore", {
  out := format_dyn_impl_key(String.from("Counter"), String.from("Dyn_Show"));
  assert(out == String.from("Counter_Dyn_Show"), "impl key shape");
});
test("format_dyn_struct_decl_header: composes `<indent><dyn> <temp> = {`", {
  out := format_dyn_struct_decl_header(
    String.from("  "),
    String.from("Dyn_Show"),
    String.from("tmp_dyn")
  );
  assert(out == String.from("  Dyn_Show tmp_dyn = {"), "struct decl header shape");
});
test("format_dyn_data_init: composes `<indent>  .data = <value>,`", {
  out := format_dyn_data_init(String.from(""), String.from("&counter"));
  assert(out == String.from("  .data = &counter,"), "data init shape");
});
test("format_dyn_vtable_init: composes `<indent>  .vtable = &<name>`", {
  out := format_dyn_vtable_init(String.from(""), String.from("__yo_vtable_x"));
  assert(out == String.from("  .vtable = &__yo_vtable_x"), "vtable init shape");
});
test("format_dyn_struct_decl_close: emits `<indent>};`", {
  out := format_dyn_struct_decl_close(String.from("  "));
  assert(out == String.from("  };"), "struct decl close shape");
});
