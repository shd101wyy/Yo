/// Phase 13az -- codegen and/or handler tests.
///
/// Exercises `yo-self/codegen/exprs/and_or.yo`, the 1-to-1 port of
/// `src/codegen/exprs/and-or.ts`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr } :: import("../expr.yo");
{ new_expr_info, expr_info_table_new, expr_info_table_set }
:: import("../expr_info.yo");
{ Environment } :: import("../env.yo");
{ t_bool } :: import("../types/creators.yo");
{ EvalValue } :: import("../value.yo");
{ set_generate_expr_fn } :: import("../codegen/exprs/expr.yo");
{ generate_expr } :: import("../codegen/exprs.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{
  generate_op_and,
  generate_op_or,
  expr_bool_value,
  expr_may_have_side_effects,
  format_and_or_bool_init,
  format_and_or_if_open,
  format_and_or_if_negate_open,
  format_and_or_assignment,
  format_and_or_close_brace
} :: import("../codegen/exprs/and_or.yo");

mk_token :: (fn(value : str, kind : TokenKind) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);

mk_ident :: (fn(id : usize, value : str) -> AstExpr)(
  AstExpr.Atom(id, mk_token(value, TokenKind.Identifier))
);

mk_infix :: (fn(id : usize, op : str, args : ArrayList(AstExpr)) -> AstExpr)(
  AstExpr.FnCall(
    id,
    box(AstExpr.Atom(id + usize(1000), mk_token(op, TokenKind.Operator))),
    args,
    true,
    mk_token(op, TokenKind.Operator)
  )
);

stub_generate_expr :: (
  fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    expr,
    .Atom(_, tok) => Option(String).Some(tok.value.clone()),
    .FnCall(_, _, _, _, _) => Option(String).Some(String.from("call_result"))
  )
);

set_bool_info :: (fn(ctx : CodegenContext, id : usize, value : bool) -> unit)({
  table := match(
    ctx.expr_info_table,
    .Some(t) => t,
    .None => expr_info_table_new()
  );
  info := new_expr_info(Environment.new(String.from("test")), t_bool());
  info.value = Option(EvalValue).Some(EvalValue.BoolVal(value));
  expr_info_table_set(table, id, info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
});

set_variable_info :: (fn(ctx : CodegenContext, id : usize, name : str) -> unit)({
  table := match(
    ctx.expr_info_table,
    .Some(t) => t,
    .None => expr_info_table_new()
  );
  info := new_expr_info(Environment.new(String.from("test")), t_bool());
  info.variable_name = Option(String).Some(String.from(name));
  expr_info_table_set(table, id, info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
});

test("expr_bool_value: reads boolean metadata", {
  ctx := CodegenContext.new();
  expr := mk_ident(usize(10), "ignored");
  set_bool_info(ctx, usize(10), true);
  result := expr_bool_value(expr, ctx);
  assert(match(result,.Some(v) => v,.None => false), "bool metadata");
});

test("expr_may_have_side_effects: variable_name marks side effect", {
  ctx := CodegenContext.new();
  expr := mk_ident(usize(20), "tmp");
  set_variable_info(ctx, usize(20), "tmp");
  assert(expr_may_have_side_effects(expr, ctx), "variable temp is side effect");
});

test("generate_op_and: compile-time false short-circuits", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(30), "a"));
  args.push(mk_ident(usize(31), "b"));
  set_bool_info(ctx, usize(30), false);
  result := generate_op_and(args, String.from(""), ctx);
  assert(match(result,.Some(s) => (s == String.from("false")),.None => false), "false short circuit");
});

test("generate_op_or: compile-time true short-circuits", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(40), "a"));
  args.push(mk_ident(usize(41), "b"));
  set_bool_info(ctx, usize(41), true);
  result := generate_op_or(args, String.from(""), ctx);
  assert(match(result,.Some(s) => (s == String.from("true")),.None => false), "true short circuit");
});

test("generate_op_and: simple args use C operator", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(50), "a"));
  args.push(mk_ident(usize(51), "b"));
  result := generate_op_and(args, String.from(""), ctx);
  assert(match(result,.Some(s) => (s == String.from("(a && b)")),.None => false), "simple and");
});

test("generate_op_or: side-effect arg emits if-chain", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(60), "a"));
  args.push(mk_ident(usize(61), "b"));
  set_variable_info(ctx, usize(61), "b_temp");
  result := generate_op_or(args, String.from(""), ctx);
  output := ctx.emitter.print();
  assert(match(result,.Some(s) => (s == String.from("_yo_t0")),.None => false), "short circuit temp");
  assert(output.contains(String.from("bool _yo_t0 = true;")), "or temp initialized");
  assert(output.contains(String.from("if (!(a))")), "or guard emitted");
  assert(output.contains(String.from("_yo_t0 = b;")), "or assignment emitted");
});

test("generate_expr: infix && dispatches through split handler", {
  set_generate_expr_fn(generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_ident(usize(70), "a"));
  args.push(mk_ident(usize(71), "b"));
  expr := mk_infix(usize(72), "&&", args);
  result := generate_expr(expr, ctx, String.from(""));
  assert(match(result,.Some(s) => (s == String.from("(a && b)")),.None => false), "central dispatch");
});
// ─── pure string formatters ─────────────────────────────────────────────────
test("format_and_or_bool_init: composes `<indent>bool <var> = <value>;`", {
  out := format_and_or_bool_init(String.from("  "), String.from("sc"), "false");
  assert(out == String.from("  bool sc = false;"), "AND bool init");
  out2 := format_and_or_bool_init(String.from(""), String.from("sc"), "true");
  assert(out2 == String.from("bool sc = true;"), "OR bool init");
});
test("format_and_or_if_open: composes `<indent>if (<cond>) {`", {
  out := format_and_or_if_open(String.from("  "), String.from("a"));
  assert(out == String.from("  if (a) {"), "if open shape");
});
test("format_and_or_if_negate_open: composes `<indent>if (!(<cond>)) {`", {
  out := format_and_or_if_negate_open(String.from(""), String.from("b"));
  assert(out == String.from("if (!(b)) {"), "if-negate open shape");
});
test("format_and_or_assignment: composes `<indent><var> = <value>;`", {
  out := format_and_or_assignment(
    String.from("    "),
    String.from("sc"),
    String.from("(x && y)")
  );
  assert(out == String.from("    sc = (x && y);"), "assignment shape");
});
test("format_and_or_close_brace: emits `<indent>}`", {
  out := format_and_or_close_brace(String.from("  "));
  assert(out == String.from("  }"), "close brace shape");
});
