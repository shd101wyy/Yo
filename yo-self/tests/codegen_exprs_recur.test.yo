/// Phase 13aw -- codegen recur handler tests.
///
/// Exercises `yo-self/codegen/exprs/recur.yo`, the 1-to-1 port of
/// `src/codegen/exprs/recur.ts` using the ExprInfo side-table.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr, BF_RECUR } :: import("../expr.yo");
{ new_expr_info, expr_info_table_new, expr_info_table_set }
:: import("../expr_info.yo");
{ Environment } :: import("../env.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ t_i32, t_unit } :: import("../types/creators.yo");
{ set_generate_expr_fn } :: import("../codegen/exprs/expr.yo");
{ CodegenContext } :: import("../codegen/context.yo");
{
  generate_recur,
  recur_append_evidence_args,
  recur_array_contains_string,
  format_typed_temp_assignment
} :: import("../codegen/exprs/recur.yo");
{ format_c_function_call } :: import("../codegen/utils/index.yo");

mk_token :: (fn(value : str, kind : TokenKind) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);

mk_atom :: (fn(id : usize, value : str, kind : TokenKind) -> AstExpr)(
  AstExpr.Atom(id, mk_token(value, kind))
);

mk_recur_call :: (fn(id : usize, args : ArrayList(AstExpr)) -> AstExpr)(
  AstExpr.FnCall(
    id,
    box(mk_atom(id + usize(1000), BF_RECUR, TokenKind.Identifier)),
    args,
    false,
    mk_token(BF_RECUR, TokenKind.Identifier)
  )
);

stub_generate_expr :: (
  fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    expr,
    .Atom(_, tok) => Option(String).Some(tok.value.clone()),
    .FnCall(_, _, _, _, _) => Option(String).Some(String.from("expr"))
  )
);

test("recur_array_contains_string: finds existing string", {
  values := ArrayList(String).new();
  values.push(String.from("a"));
  values.push(String.from("b"));
  assert(recur_array_contains_string(values, String.from("b")), "finds b");
  assert(!(recur_array_contains_string(values, String.from("c"))), "missing c");
});

test("recur_append_evidence_args: appends evidence after explicit args", {
  ctx := CodegenContext.new();
  ctx.current_evidence_param_names.push(String.from("raise__throw"));
  ctx.current_evidence_param_names.push(String.from("io__read"));
  out := recur_append_evidence_args(String.from("x, y"), ctx);
  assert(out == String.from("x, y, raise__throw, io__read"), "evidence appended");
});

test("recur_append_evidence_args: evidence-only call", {
  ctx := CodegenContext.new();
  ctx.current_evidence_param_names.push(String.from("raise__throw"));
  out := recur_append_evidence_args(String.from(""), ctx);
  assert(out == String.from("raise__throw"), "evidence only");
});

test("generate_recur: returns None without metadata for dispatcher fallback", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(10), "x", TokenKind.Identifier));
  call := mk_recur_call(usize(11), args);
  result := generate_recur(call, args, ctx, String.from(""));
  assert(result.is_none(), "missing metadata falls back");
});

test("generate_recur: emits self-call from runtime args", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  ctx.current_fn_name = String.from("fn_countdown");
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  call_info := new_expr_info(env, t_i32());
  runtime_args := ArrayList(AstExpr).new();
  runtime_args.push(mk_atom(usize(20), "n_minus_1", TokenKind.Identifier));
  call_info.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(runtime_args);
  expr_info_table_set(table, usize(21), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  source_args := ArrayList(AstExpr).new();
  source_args.push(mk_atom(usize(22), "ignored", TokenKind.Identifier));
  call := mk_recur_call(usize(21), source_args);
  result := generate_recur(call, source_args, ctx, String.from(""));
  match(
    result,
    .None => assert(false, "expected recur code"),
    .Some(code) => assert(code == String.from("fn_countdown(n_minus_1)"), "self-call")
  );
});

test("generate_recur: forwards current evidence params", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  ctx.current_fn_name = String.from("fn_effectful");
  ctx.current_evidence_param_names.push(String.from("exn__throw"));
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  call_info := new_expr_info(env, t_i32());
  runtime_args := ArrayList(AstExpr).new();
  runtime_args.push(mk_atom(usize(30), "n", TokenKind.Identifier));
  call_info.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(runtime_args);
  expr_info_table_set(table, usize(31), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  call := mk_recur_call(usize(31), args);
  result := generate_recur(call, args, ctx, String.from(""));
  match(
    result,
    .None => assert(false, "expected recur code"),
    .Some(code) => assert(code == String.from("fn_effectful(n, exn__throw)"), "evidence forwarded")
  );
});

test("generate_recur: temp variable declaration for non-unit result", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  ctx.current_fn_name = String.from("fn_loop");
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  call_info := new_expr_info(env, t_i32());
  call_info.variable_name = Option(String).Some(String.from("tmp.recur"));
  runtime_args := ArrayList(AstExpr).new();
  runtime_args.push(mk_atom(usize(40), "next", TokenKind.Identifier));
  call_info.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(runtime_args);
  expr_info_table_set(table, usize(41), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  call := mk_recur_call(usize(41), args);
  result := generate_recur(call, args, ctx, String.from("  "));
  match(
    result,
    .None => assert(false, "expected temp"),
    .Some(code) => assert(code == String.from("tmp_u46_recur"), "returns sanitized temp")
  );
  out := ctx.emitter.code;
  assert(out.contains(String.from("  int32_t tmp_u46_recur = fn_loop(next);")), "temp decl");
});

test("generate_recur: does not declare temp for unit result", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  ctx.current_fn_name = String.from("fn_loop");
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  call_info := new_expr_info(env, t_unit());
  call_info.variable_name = Option(String).Some(String.from("tmp.unit"));
  runtime_args := ArrayList(AstExpr).new();
  call_info.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(runtime_args);
  expr_info_table_set(table, usize(51), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  call := mk_recur_call(usize(51), args);
  result := generate_recur(call, args, ctx, String.from(""));
  match(
    result,
    .None => assert(false, "expected call"),
    .Some(code) => assert(code == String.from("fn_loop()"), "unit returns call")
  );
  assert(ctx.emitter.code == String.from(""), "no temp decl");
});

test("generate_recur: emits deferred drops before temp declaration", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  ctx.current_fn_name = String.from("fn_loop");
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  call_info := new_expr_info(env, t_i32());
  call_info.variable_name = Option(String).Some(String.from("tmp.recur"));
  runtime_args := ArrayList(AstExpr).new();
  runtime_args.push(mk_atom(usize(60), "next", TokenKind.Identifier));
  call_info.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(runtime_args);
  drops := ArrayList(AstExpr).new();
  drops.push(mk_atom(usize(61), "__yo_decr_rc(x)", TokenKind.Identifier));
  call_info.deferred_drop_expressions = Option(ArrayList(AstExpr)).Some(drops);
  expr_info_table_set(table, usize(62), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  call := mk_recur_call(usize(62), args);
  result := generate_recur(call, args, ctx, String.from("  "));
  assert(result.is_some(), "expected code");
  out := ctx.emitter.code;
  assert(
    out.contains(String.from("  __yo_decr_rc(x);\n  int32_t tmp_u46_recur = fn_loop(next);")),
    "drop before temp"
  );
});
// ─── pure string formatters ─────────────────────────────────────────────────
test("format_typed_temp_assignment: composes indented decl + initializer", {
  out := format_typed_temp_assignment(
    String.from("  "),
    String.from("int32_t"),
    String.from("tmp_u46_recur"),
    String.from("fn_loop(next)")
  );
  assert(
    out == String.from("  int32_t tmp_u46_recur = fn_loop(next);"),
    "typed temp assignment shape"
  );
});
test("format_c_function_call: composes fn-name with pre-joined args", {
  out := format_c_function_call("fn_loop", String.from("next, evidence"));
  assert(
    out == String.from("fn_loop(next, evidence)"),
    "function call shape"
  );
});
test("format_c_function_call: empty args yields fn-name + ()", {
  out := format_c_function_call("fn_zero", String.from(""));
  assert(out == String.from("fn_zero()"), "empty args shape");
});
