/// Phase 6f verification: gensym, .car/.cdr, ExprVal Atom equality.
open(import("std/string"));
open(import("std/fmt"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ EvalValue } :: import("../value.yo");
{ has_comment_attribute, Evaluator } :: import("../evaluator/index.yo");
{ MACRO_DISPATCH_ENABLED } :: import("../evaluator/calls/function.yo");
noop_loader :: (fn(_path : String) -> Option(EvalValue))(
  Option(EvalValue).None
);
test("Phase6f: ExprVal Atom equality (callee == quote(=>))", {
  // SKIPPED: requires either:
  //   (a) loading std/prelude.yo so `impl(Expr, ComptimeEq(Expr)(...))` is in
  //       scope to route `==` to `__yo_expr_eq`, OR
  //   (b) deeper investigation of why even direct `__yo_expr_eq(...)` calls
  //       inside a macro body return false in the proper Evaluator.
  // The underlying `eval_value_eq` ExprVal Atom equality (Phase 6f) is
  // correct; the trap is in higher-level dispatch.
  // See: issues/fixed/proper-eval-expr-eq-dispatch.md
  ();
});
test("Phase6f: gensym produces fresh atoms", {
  // Macro dispatch is disabled in committed builds (heap corruption —
  // issues/yo-self-macro-dispatch-corruption.md); re-arms when the flag flips.
  if(MACRO_DISPATCH_ENABLED, {
    exn := Exception(
      throw : (
        (err) -> {
          assert(false, "unexpected error");
          unwind(());
        }
      )
    );
    src := String.from("pragma(Pragma.SkipPrelude);\nmake_pair :: (fn() -> unquote(Expr))({ a :: gensym(\"u\"); b :: gensym(\"v\"); quote({ unquote(a) := 3; unquote(b) := 4; (unquote(a) + unquote(b)) }) });\nv :: make_pair();\nexport(v);\n");
    eval := Evaluator.new(String.from("<phase6f2>"), String.from("<no-std>"), noop_loader, src, exn);
    match(
      eval.get_module_error(),
      .Some(_) => {
        assert(false, "module error");
      },
      .None => ()
    );
    match(
      eval.get_module_value(),
      .None => {
        assert(false, "no module value");
      },
      .Some(mv) => match(
        mv,
        .StructVal(_, names, values) => {
          (i : usize) = usize(0);
          n := names.len();
          (found : Option(usize)) =.None;
          while(i < n, {
            match(
              names.get(i),
              .Some(nm) => cond(
                (nm == "v") => {
                  found =.Some(i);
                },
                true => ()
              ),
              .None => ()
            );
            i = (i + usize(1));
          });
          match(
            found,
            .None => {
              assert(false, "v not found");
            },
            .Some(idx) => match(
              values.get(idx),
              .None => {
                assert(false, "v idx missing");
              },
              .Some(rv) => match(
                rv,
                .IntLit(s) => assert(s == "7", "expected 7"),
                _ => {
                  assert(false, "v not IntLit");
                }
              )
            )
          );
        },
        _ => {
          assert(false, "not ModuleVal");
        }
      )
    );
  });
});
test("Phase6f: .cdr on ComptimeListVal", {
  // Macro dispatch is disabled in committed builds (heap corruption —
  // issues/yo-self-macro-dispatch-corruption.md); re-arms when the flag flips.
  if(MACRO_DISPATCH_ENABLED, {
    exn := Exception(
      throw : (
        (err) -> {
          assert(false, "unexpected error");
          unwind(());
        }
      )
    );
    src := String.from("pragma(Pragma.SkipPrelude);\ncdr_len :: (fn(quote(e) : Expr) -> unquote(Expr))(cond((e.get_args().cdr().len() == 1) => quote(1), true => quote(0)));\nv :: cdr_len((3 + 4));\nexport(v);\n");
    eval := Evaluator.new(String.from("<phase6f3>"), String.from("<no-std>"), noop_loader, src, exn);
    match(
      eval.get_module_error(),
      .Some(_) => {
        assert(false, "module error");
      },
      .None => ()
    );
    match(
      eval.get_module_value(),
      .None => {
        assert(false, "no module value");
      },
      .Some(mv) => match(
        mv,
        .StructVal(_, names, values) => {
          (i : usize) = usize(0);
          n := names.len();
          (found : Option(usize)) =.None;
          while(i < n, {
            match(
              names.get(i),
              .Some(nm) => cond(
                (nm == "v") => {
                  found =.Some(i);
                },
                true => ()
              ),
              .None => ()
            );
            i = (i + usize(1));
          });
          match(
            found,
            .None => {
              assert(false, "v not found");
            },
            .Some(idx) => match(
              values.get(idx),
              .None => {
                assert(false, "v idx missing");
              },
              .Some(rv) => match(
                rv,
                .IntLit(s) => assert(s == "1", "expected 1"),
                _ => {
                  assert(false, "v not IntLit");
                }
              )
            )
          );
        },
        _ => {
          assert(false, "not ModuleVal");
        }
      )
    );
  });
});
