test("Phase 5ja: trait impl method — bool check", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Val :: struct(x : i32);\nimpl(Val, Check(\n  is_positive : (fn(v : Val) -> bool)({ (v.x > i32(0)) })\n));\npos := Val(x: i32(3));\nneg := Val(x: i32(-(1)));\nexport(pos.is_positive());\nexport(neg.is_positive());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.BoolVal(b) => assert(b, "3>0=true"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(1)),.Some(x) => match(x,.BoolVal(b) => assert(!(b), "-1>0=false"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
