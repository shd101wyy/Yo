// Phase 5jb — trait impl with multiple methods
// ---------------------------------------------------------------------------
test("Phase 5jb: trait impl two methods — add and sub", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "P :: struct(x : i32, y : i32);\nimpl(P, Arith(\n  add_fields : (fn(p : P) -> i32)({ (p.x + p.y) }),\n  sub_fields : (fn(p : P) -> i32)({ (p.x - p.y) })\n));\np := P(x: i32(10), y: i32(3));\nexport(p.add_fields());\nexport(p.sub_fields());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "13", "10+3=13"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "7", "10-3=7"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
