test("Phase 5jb: trait impl two methods — constants", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Cfg :: struct(id : i32);\nimpl(Cfg, Info(\n  get_id : (fn(c : Cfg) -> i32)({ c.id }),\n  version : (fn(c : Cfg) -> i32)({ i32(42) })\n));\nc := Cfg(id: i32(7));\nexport(c.get_id());\nexport(c.version());";
  exprs := generate_exprs_from_code(src, using(exn));
