test("Phase 5je: trait impl method — GCD via Euclidean", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Pair :: struct(a : i32, b : i32);\ngcd :: (fn(a : i32, b : i32) -> i32)(\n  cond((b == i32(0)) => a, true => recur(b, (a % b)))\n);\nimpl(Pair, Math(\n  gcd_val : (fn(p : Pair) -> i32)({ gcd(p.a, p.b) })\n));\np := Pair(a: i32(48), b: i32(18));\nexport(p.gcd_val());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "6", "gcd(48,18)=6"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
