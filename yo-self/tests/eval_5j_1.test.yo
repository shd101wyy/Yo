  src := "T :: struct(v : i32);\nimpl(T, Ops(\n  clamp_pos : (fn(t : T) -> i32)({\n    cond((t.v > i32(0)) => t.v, true => i32(0))\n  })\n));\np := T(v: i32(5));\nn := T(v: i32(-(3)));\nexport(p.clamp_pos());\nexport(n.clamp_pos());";
