test("Phase 5je: trait impl method — modulo check", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "N :: struct(v : i32);\nimpl(N, Check(\n  divisible_by3 : (fn(n : N) -> bool)({ ((n.v % i32(3)) == i32(0)) })\n));\na := N(v: i32(9));\nb := N(v: i32(10));\nexport(a.divisible_by3());\nexport(b.divisible_by3());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.BoolVal(b) => assert(b, "9%3==0"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(1)),.Some(x) => match(x,.BoolVal(b) => assert(!(b), "10%3!=0"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5je: trait impl method with while inside", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "T :: struct(n : i32);\nimpl(T, Ops(\n  sum_up_to : (fn(t : T) -> i32)({\n    (acc : i32) = i32(0);\n    (i : i32) = i32(1);\n    while(runtime((i <= t.n)), {\n      acc = (acc + i);\n      i = (i + i32(1));\n    });\n    acc\n  })\n));\nx := T(n: i32(5));\nexport(x.sum_up_to());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "15", "1+2+3+4+5=15"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
