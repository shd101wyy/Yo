  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "Counter :: struct(count : i32);\nimpl(Counter, Ops(\n  get_count : (fn(c : Counter) -> i32)({ c.count })\n));\n(total : i32) = i32(0);\n(i : usize) = usize(1);\nwhile(runtime((i <= usize(5))), {\n  c := Counter(count: i32(i.to_i32()));\n  total = (total + c.get_count());\n  i = (i + usize(1));\n});\nexport(total);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "15", "1+2+3+4+5=15"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
