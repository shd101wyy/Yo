    match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "0", "clamp(-3)=0"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5je: trait impl method with cond two branches", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "T :: struct(n : i32);\nimpl(T, Ops(\n  sign : (fn(t : T) -> i32)({\n    cond(\n      (t.n > i32(0)) => i32(1),\n      (t.n < i32(0)) => i32(-(1)),\n      true => i32(0)\n    )\n  })\n));\na := T(n: i32(5));\nb := T(n: i32(-(3)));\nc := T(n: i32(0));\nexport(a.sign());\nexport(b.sign());\nexport(c.sign());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "1", "sign(5)=1"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(1)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "-1", "sign(-3)=-1"), _ => assert(false, "t")),.None => assert(false, "v"));
    match(v.get(usize(2)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "0", "sign(0)=0"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
