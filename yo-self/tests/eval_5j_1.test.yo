// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5j series: impl with trait constructors.
///
/// Phases covered:
///   5ja — impl with trait constructor (single method), method dispatch
///   5jb — impl with trait constructor (multiple methods), mixed inherent+trait
///   5jc — empty trait / marker impl, method return values, struct computation
///   5jd — trait impl over enum structs, chained method results, array+impl
///   5je — nested struct with trait impl, conditional method logic
///
/// These tests exercise `impl(Type, Trait(method : fn_def, ...))` — the
/// "trait constructor" form of impl that wraps method definitions inside
/// a nominal trait constructor call.
open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ ArrayList } :: import("std/collections/array_list");
{ TokenKind, Token } :: import("../lexer/token.yo");
{
  AstExpr,
  BK_BEGIN,
  BK_TUPLE,
  BK_ANON_STRUCT,
  BK_EXPORT,
  BK_OPEN,
  BK_IMPORT,
  BK_ENUM,
  BK_STRUCT,
  BK_OBJECT,
  BK_NEWTYPE,
  BK_UNION,
  BK_TRAIT,
  BK_ARRAY_VAL
} :: import("../expr/expr.yo");
{
  TypeValue,
  type_value_tag,
  t_i32,
  t_bool,
  t_u32,
  t_f32,
  t_type,
  t_unit,
  t_comptime_int,
  t_comptime_float,
  t_comptime_string
} :: import("../types/type.yo");
{ TypeTag } :: import("../types/tags.yo");
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate, parse_raw_int, evaluate_module_body, set_module_loader } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
make_token :: (fn(kind : TokenKind, value : str) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  )
);
make_atom :: (fn(kind : TokenKind, value : str) -> AstExpr)(
  .Atom(usize(0), make_token(kind, value))
);
make_ident :: (fn(name : str) -> AstExpr)(
  make_atom(TokenKind.Identifier, name)
);
make_infix :: (fn(op : str, lhs : AstExpr, rhs : AstExpr) -> AstExpr)(
  .FnCall(usize(0), box(.Atom(usize(0), make_token(TokenKind.Operator, op))), {
    args := ArrayList(AstExpr).new();
    args.push(lhs);
    args.push(rhs);
    args
  }, true, make_token(TokenKind.Operator, op))
);
/// Build a begin-block `{ stmts… }` from an ArrayList of statements.
make_begin :: (fn(stmts : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, BK_BEGIN))),
    stmts,
    false,
    make_token(TokenKind.Identifier, BK_BEGIN)
  )
);
/// Build the unit expression `()`.
make_unit :: (fn() -> AstExpr)(
  .FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, BK_TUPLE))),
    ArrayList(AstExpr).new(),
    false,
    make_token(TokenKind.Identifier, BK_TUPLE)
  )
);
/// Build a cond arm `condition => body` (infix =>).
make_arm :: (fn(cond_expr : AstExpr, body_expr : AstExpr) -> AstExpr)(
  .FnCall(usize(0), box(.Atom(usize(0), make_token(TokenKind.Operator, "=>"))), {
    a := ArrayList(AstExpr).new();
    a.push(cond_expr);
    a.push(body_expr);
    a
  }, true, make_token(TokenKind.Operator, "=>"))
);
/// Build `cond(arm1, arm2, …)`.
make_cond :: (fn(arms : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "cond"))),
    arms,
    false,
    make_token(TokenKind.Identifier, "cond")
  )
);
/// Build `keyword(arg1, arg2, …)` — used for enum/struct/union/trait/object/newtype.
make_typedef_call :: (fn(keyword : str, type_args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, keyword))),
    type_args,
    false,
    make_token(TokenKind.Identifier, keyword)
  )
);
/// Build `func_name(arg1, arg2, …)` — a non-infix function call.
make_fncall_atom :: (fn(name : str, call_args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, name))),
    call_args,
    false,
    make_token(TokenKind.Identifier, name)
  )
);
/// Build a `label : type_expr` labeled field expression (infix colon).
make_labeled_field :: (fn(label : str, type_expr : AstExpr) -> AstExpr)(
  .FnCall(usize(0), box(.Atom(usize(0), make_token(TokenKind.Operator, ":"))), {
    a := ArrayList(AstExpr).new();
    a.push(make_ident(label));
    a.push(type_expr);
    a
  }, true, make_token(TokenKind.Operator, ":"))
);
/// Build `VariantName(field1, field2, …)` — enum variant with fields.
make_variant :: (fn(name : str, field_args : ArrayList(AstExpr)) -> AstExpr)(
  .FnCall(
    usize(0),
    box(.Atom(usize(0), make_token(TokenKind.Identifier, name))),
    field_args,
    false,
    make_token(TokenKind.Identifier, name)
  )
);
empty_env :: (fn() -> Environment)(Environment.new(`test`));
check_some :: (fn(result : Option(EvalResult), label : str) -> unit)(
  match(
    result,
    .Some(_) => (),
    .None => {
      println(`FAIL [${label}]: expected Some, got None`);
      assert(false, label);
    }
  )
);
check_none :: (fn(result : Option(EvalResult), label : str) -> unit)(
  match(
    result,
    .Some(_) => {
      println(`FAIL [${label}]: expected None, got Some`);
      assert(false, label);
    },
    .None => ()
  )
);
check_some_eval_val :: (fn(result : Option(EvalValue), label : str) -> unit)(
  match(
    result,
    .Some(_) => (),
    .None => {
      println(`FAIL [${label}]: expected Some(EvalValue), got None`);
      assert(false, label);
    }
  )
);
// ---------------------------------------------------------------------------
// Phase 5ja — impl with trait constructor: single method, simple dispatch
// ---------------------------------------------------------------------------
test("Phase 5ja: trait impl single method — identity", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "T :: struct(v : i32);\nimpl(T, Ops(\n  get_v : (fn(t : T) -> i32)({ t.v })\n));\nval := T(v: i32(42));\nexport(val.get_v());";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)),.Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "42", "get_v=42"), _ => assert(false, "t")),.None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
