/// Tests for yo-self/codegen/exprs/rc_fns.yo (partial port —
/// pure RC-builtin call-site formatters).
open(import("std/string"));
{
  format_decr_rc_call,
  format_incr_rc_call,
  format_rc_own,
  format_decr_rc_atomic_call,
  format_incr_rc_atomic_call,
  format_dyn_drop_call,
  format_dyn_dup_call,
  format_rc_count_non_atomic,
  format_rc_count_atomic,
  format_null_checked_decr_rc,
  format_null_checked_incr_rc
} :: import("../codegen/exprs/rc_fns.yo");
test("format_decr_rc_call wraps a simple arg", {
  assert(
    format_decr_rc_call(String.from("x")) == String.from("__yo_decr_rc(x)"),
    "decr simple"
  );
});
test("format_incr_rc_call wraps a simple arg", {
  assert(
    format_incr_rc_call(String.from("y")) == String.from("__yo_incr_rc(y)"),
    "incr simple"
  );
});
test("format_decr_rc_call passes complex args verbatim", {
  // The TS handler does not parenthesise — it relies on the recursive
  // generateExpr to produce a well-formed primary expression. Mirror
  // that behaviour faithfully.
  assert(
    format_decr_rc_call(String.from("(void*)(p.data)")) ==
      String.from("__yo_decr_rc((void*)(p.data))"),
    "complex passthrough"
  );
});
test("format_rc_own is identity (ownership-transfer marker)", {
  arg := String.from("some_local");
  assert(format_rc_own(arg) == String.from("some_local"), "identity");
});
test("format_decr_rc_atomic_call wraps a simple arg", {
  assert(
    format_decr_rc_atomic_call(String.from("z")) ==
      String.from("__yo_decr_rc_atomic(z)"),
    "atomic decr"
  );
});
test("format_incr_rc_atomic_call wraps a simple arg", {
  assert(
    format_incr_rc_atomic_call(String.from("w")) ==
      String.from("__yo_incr_rc_atomic(w)"),
    "atomic incr"
  );
});
test("formatter pair round-trip: decr/incr produce symmetric strings", {
  // Pin the contract that the atomic and non-atomic variants share the
  // same call-shape — only the function name differs.
  a := format_decr_rc_call(String.from("v"));
  b := format_decr_rc_atomic_call(String.from("v"));
  assert(a == String.from("__yo_decr_rc(v)"), "non-atomic");
  assert(b == String.from("__yo_decr_rc_atomic(v)"), "atomic suffix only");
});
test("format_dyn_drop_call wraps arg's .data pointer", {
  // Mirrors TS `generateYoDynDrop`: dyn is a value type whose ref-count
  // lives on its `.data` pointer.
  assert(
    format_dyn_drop_call(String.from("d")) ==
      String.from("__yo_decr_rc((void*)(d).data)"),
    "dyn drop"
  );
});
test("format_dyn_dup_call wraps arg's .data pointer", {
  assert(
    format_dyn_dup_call(String.from("d")) ==
      String.from("__yo_incr_rc((void*)(d).data)"),
    "dyn dup"
  );
});
test("format_dyn_*_call passes complex args verbatim", {
  // Pin the same passthrough contract as the non-dyn formatters: the
  // recursive generateExpr emits a well-formed primary expression and
  // the formatter just wraps it.
  assert(
    format_dyn_drop_call(String.from("(*p).field")) ==
      String.from("__yo_decr_rc((void*)((*p).field).data)"),
    "dyn drop complex"
  );
});
test("format_dyn_drop / format_dyn_dup are symmetric (decr/incr only differ)", {
  drop_s := format_dyn_drop_call(String.from("x"));
  dup_s := format_dyn_dup_call(String.from("x"));
  assert(drop_s == String.from("__yo_decr_rc((void*)(x).data)"), "drop");
  assert(dup_s == String.from("__yo_incr_rc((void*)(x).data)"), "dup");
});
test("format_rc_count_non_atomic: simple identifier", {
  // Pin the TS `generateRcCall` non-atomic branch shape:
  //   ((__yo_ref_header_t*)(<arg>))->ref_count
  out := format_rc_count_non_atomic(String.from("p"));
  assert(
    out == String.from("((__yo_ref_header_t*)(p))->ref_count"),
    "non-atomic shape"
  );
});
test("format_rc_count_non_atomic: complex arg passthrough", {
  out := format_rc_count_non_atomic(String.from("self.head"));
  assert(
    out == String.from("((__yo_ref_header_t*)(self.head))->ref_count"),
    "complex arg"
  );
});
test("format_rc_count_atomic: simple identifier", {
  // Pin the TS `generateRcCall` atomic branch shape — load with
  // acquire ordering through an `_Atomic size_t*` cast.
  out := format_rc_count_atomic(String.from("p"));
  expected := String.from(
    "atomic_load_explicit((_Atomic size_t*)&((__yo_ref_header_t*)(p))->ref_count, memory_order_acquire)"
  );
  assert(out == expected, "atomic shape");
});
test("format_rc_count_atomic: complex arg passthrough", {
  out := format_rc_count_atomic(String.from("queue.front"));
  expected := String.from(
    "atomic_load_explicit((_Atomic size_t*)&((__yo_ref_header_t*)(queue.front))->ref_count, memory_order_acquire)"
  );
  assert(out == expected, "atomic complex");
});
test("format_null_checked_decr_rc: wraps decr_rc in if-NULL guard", {
  // Pin the TS `generateYoSomeTypeDrop` Impl(Future) shape.
  out := format_null_checked_decr_rc(String.from("fut"));
  assert(
    out == String.from("if (fut != NULL) { __yo_decr_rc((void*)fut); }"),
    "null-checked drop shape"
  );
});
test("format_null_checked_incr_rc: symmetric incr_rc variant", {
  out := format_null_checked_incr_rc(String.from("fut"));
  assert(
    out == String.from("if (fut != NULL) { __yo_incr_rc((void*)fut); }"),
    "null-checked dup shape"
  );
});
test("format_null_checked_decr_rc: complex arg passthrough", {
  // Complex args appear twice in the output (once in the check, once
  // in the call). Pin that the formatter doesn't pre-bind the arg.
  out := format_null_checked_decr_rc(String.from("self->fut"));
  assert(
    out ==
      String.from("if (self->fut != NULL) { __yo_decr_rc((void*)self->fut); }"),
    "complex arg appears twice"
  );
});
