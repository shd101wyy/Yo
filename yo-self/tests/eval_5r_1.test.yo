// @skip_wasm32-emscripten — split file (~5min Yo compile alone, C output ~6 MB)
// @skip_wasm32-wasi        — split file (~5min Yo compile alone, C output ~6 MB)
/// Tests for the evaluator — Phase 5r series: flat_map, char_at, repeat, as_bytes,
/// str.index_of, arr.remove, arr.set, arr.find, and self-recursive (recur).
///
/// Phases covered:
///   5ra — arr.flat_map(fn)
///   5rb — str.char_at(i), str.repeat(n)
///   5rc — str.as_bytes(), str.index_of(needle)
///   5rd — arr.remove(i), arr.set(i,val), arr.find(fn)
///   5re — self-recursive functions via recur

open(import("std/fmt"));
open(import("std/string"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
empty_env :: (fn() -> Environment)(Environment.new(`test`));
// ---------------------------------------------------------------------------
// Phase 5ra — arr.flat_map(fn)
// ---------------------------------------------------------------------------
test("Phase 5ra: flat_map doubles each element into pair", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "arr := [i32(1), i32(2), i32(3)];\nresult := arr.flat_map((fn(x : i32) -> i32)({ [x, (x * i32(2))] }));\nexport(result.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "6", "len=6"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ra: flat_map with single-element arrays is identity", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "arr := [i32(10), i32(20), i32(30)];\nresult := arr.flat_map((fn(x : i32) -> i32)({ [x] }));\nexport(result.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
