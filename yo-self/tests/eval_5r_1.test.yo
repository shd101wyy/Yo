test("Phase 5ra: flat_map triples each element — fold sum", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "arr := [i32(2), i32(4)];\nresult := arr.flat_map((fn(x : i32) -> i32)({ [x, x, x] }));\ntotal := result.fold(i32(0), (fn(acc : i32, x : i32) -> i32)({ (acc + x) }));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "18", "sum=18"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ra: flat_map filter evens — only even elements kept", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "arr := [i32(1), i32(2), i32(3), i32(4)];\nresult := arr.flat_map((fn(x : i32) -> i32)({ cond(((x % i32(2)) == i32(0)) => [x], true => []) }));\nexport(result.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
