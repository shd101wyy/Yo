test("Phase 5rb: char_at in loop — count chars equal to target", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "s := \"banana\";\n(count : i32) = i32(0);\n(i : i32) = i32(0);\nwhile(runtime(i < s.len()), {\n  ch := s.char_at(i);\n  cond((ch.starts_with(\"a\")) => { count = (count + i32(1)); }, true => ());\n  i = (i + i32(1));\n});\nexport(count);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "3", "count=3"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
