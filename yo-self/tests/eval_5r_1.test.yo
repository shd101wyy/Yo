test("Phase 5rc: str.index_of of a in banana is position 1", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "s := \"banana\";\npos_opt := s.index_of(\"a\");\npos := pos_opt.unwrap();\nexport(pos);\n";
