  }, _ => assert(false, "m")));
});
test("Phase 5ra: flat_map range expansion — each n maps to [1..n]", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "arr := [i32(1), i32(2), i32(3)];\nexpand := (fn(n : i32) -> i32)({\n  acc := [];\n  (i : i32) = i32(1);\n  while(runtime(i <= n), {\n    acc.push(i);\n    i = (i + i32(1));\n  });\n  acc\n});\nresult := arr.flat_map(expand);\nexport(result.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "6", "len=6"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ra: flat_map sum of expanded ranges", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "arr := [i32(1), i32(2), i32(3)];\nexpand := (fn(n : i32) -> i32)({\n  acc := [];\n  (i : i32) = i32(1);\n  while(runtime(i <= n), {\n    acc.push(i);\n    i = (i + i32(1));\n  });\n  acc\n});\nresult := arr.flat_map(expand);\ntotal := result.fold(i32(0), (fn(a : i32, x : i32) -> i32)({ (a + x) }));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert(n.as_str() == "10", "sum=10"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
});
test("Phase 5ra: flat_map then filter — flatten then filter result", {
  env := empty_env();
  given(exn) := Exception(throw : ((err) -> { assert(false, "e"); escape(()); }));
  src := "arr := [i32(1), i32(2), i32(3)];\nflat := arr.flat_map((fn(x : i32) -> i32)({ [x, (x * i32(10))] }));\nbig := flat.filter((fn(x : i32) -> bool)({ (x > i32(5)) }));\nexport(big.len());\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
