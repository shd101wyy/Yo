/// Phase 13av -- codegen array-fns handler tests.
///
/// Exercises `yo-self/codegen/exprs/array_fns.yo`, the 1-to-1 port of
/// `src/codegen/exprs/array-fns.ts` using the ExprInfo side-table.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr, BK_ARRAY, BF_ARRAY_FILL } :: import("../expr.yo");
{ new_expr_info, expr_info_table_new, expr_info_table_set }
:: import("../expr_info.yo");
{ Environment } :: import("../env.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ t_i32 } :: import("../types/creators.yo");
{ type_to_string } :: import("../types/string.yo");
{ EvalValue, create_type_value } :: import("../value.yo");
{ CodegenContext, CodegenTypeEntry } :: import("../codegen/context.yo");
{ set_generate_expr_fn } :: import("../codegen/exprs/expr.yo");
{
  generate_anonymous_array,
  generate_yo_array_fill,
  extract_array_type_value,
  format_array_compound_literal
} :: import("../codegen/exprs/array_fns.yo");
{
  get_type_string_opt,
  get_variable_type_string_opt_str
} :: import("../codegen/utils/index.yo");

mk_token :: (fn(value : str, kind : TokenKind) -> Token)(
  Token(
    kind : kind,
    value : String.from(value),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from("test"),
    input : String.from("")
  )
);

mk_atom :: (fn(id : usize, value : str, kind : TokenKind) -> AstExpr)(
  AstExpr.Atom(id, mk_token(value, kind))
);

mk_call :: (fn(id : usize, name : str, args : ArrayList(AstExpr)) -> AstExpr)(
  AstExpr.FnCall(
    id,
    box(mk_atom(id + usize(1000), name, TokenKind.Identifier)),
    args,
    false,
    mk_token(name, TokenKind.Identifier)
  )
);

stub_generate_expr :: (
  fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    expr,
    .Atom(_, tok) => Option(String).Some(tok.value.clone()),
    .FnCall(_, _, _, _, _) => Option(String).Some(String.from("expr"))
  )
);

mk_array_ty :: (fn(n : usize) -> TypeValue)(TypeValue.Array(box(t_i32()), n));

install_array_type :: (fn(ctx : CodegenContext, ty : TypeValue, c_name : str) -> unit)({
  ctx.types.set(
    type_to_string(ty),
    CodegenTypeEntry(type_value : ty, c_name : String.from(c_name))
  );
});

test("get_type_string_opt: reads array C name from context types", {
  ctx := CodegenContext.new();
  ty := mk_array_ty(usize(2));
  install_array_type(ctx, ty, "__yo_array_i32_2");
  match(
    get_type_string_opt(ty, ctx),
    .None => assert(false, "expected array c name"),
    .Some(c_name) => assert(c_name == String.from("__yo_array_i32_2"), "array c name")
  );
});

test("get_variable_type_string_opt_str: sanitizes array-temp variable name", {
  ctx := CodegenContext.new();
  ty := mk_array_ty(usize(2));
  install_array_type(ctx, ty, "__yo_array_i32_2");
  match(
    get_variable_type_string_opt_str(ty, "tmp.array", ctx),
    .None => assert(false, "expected variable type string"),
    .Some(s) => assert(
      s == String.from("__yo_array_i32_2 tmp_u46_array"),
      "sanitized variable name"
    )
  );
});

test("generate_anonymous_array: returns None without metadata", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(10), "x", TokenKind.Identifier));
  call := mk_call(usize(11), BK_ARRAY, args);
  result := generate_anonymous_array(call, args, ctx, String.from(""));
  assert(result.is_none(), "no metadata falls back to legacy lowering");
});

test("generate_anonymous_array: emits compound array wrapper", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  ty := mk_array_ty(usize(2));
  install_array_type(ctx, ty, "__yo_array_i32_2");
  call_info := new_expr_info(env, ty);
  runtime_args := ArrayList(AstExpr).new();
  runtime_args.push(mk_atom(usize(20), "x", TokenKind.Identifier));
  runtime_args.push(mk_atom(usize(21), "y", TokenKind.Identifier));
  call_info.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(runtime_args);
  expr_info_table_set(table, usize(22), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  source_args := ArrayList(AstExpr).new();
  source_args.push(mk_atom(usize(23), "ignored", TokenKind.Identifier));
  call := mk_call(usize(22), BK_ARRAY, source_args);
  result := generate_anonymous_array(call, source_args, ctx, String.from("  "));
  match(
    result,
    .None => assert(false, "expected array code"),
    .Some(code) => assert(
      code == String.from("(__yo_array_i32_2){ .data = { x, y } }"),
      "compound array wrapper"
    )
  );
});

test("generate_anonymous_array: variable_name emits temp declaration and returns temp", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  ty := mk_array_ty(usize(2));
  install_array_type(ctx, ty, "__yo_array_i32_2");
  call_info := new_expr_info(env, ty);
  call_info.variable_name = Option(String).Some(String.from("tmp.array"));
  runtime_args := ArrayList(AstExpr).new();
  runtime_args.push(mk_atom(usize(30), "x", TokenKind.Identifier));
  runtime_args.push(mk_atom(usize(31), "y", TokenKind.Identifier));
  call_info.runtime_arg_exprs_in_order = Option(ArrayList(AstExpr)).Some(runtime_args);
  expr_info_table_set(table, usize(32), call_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  call := mk_call(usize(32), BK_ARRAY, args);
  result := generate_anonymous_array(call, args, ctx, String.from("  "));
  match(
    result,
    .None => assert(false, "expected temp"),
    .Some(code) => assert(code == String.from("tmp_u46_array"), "returns sanitized temp")
  );
  out := ctx.emitter.code;
  assert(
    out.contains(String.from("  __yo_array_i32_2 tmp_u46_array = (__yo_array_i32_2){ .data = { x, y } };")),
    "temp declaration emitted"
  );
});

test("extract_array_type_value: reads TypeVal Array from argument metadata", {
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  ty := mk_array_ty(usize(3));
  arg_info := new_expr_info(env, TypeValue.TypeUni(usize(0)));
  arg_info.value = Option(EvalValue).Some(create_type_value(ty));
  expr_info_table_set(table, usize(40), arg_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  arg := mk_atom(usize(40), "ArrayType", TokenKind.Identifier);
  match(
    extract_array_type_value(arg, ctx),
    .None => assert(false, "expected array type"),
    .Some(found) => assert(type_to_string(found) == type_to_string(ty), "array type found")
  );
});

test("generate_yo_array_fill: emits declaration, loop, and returns temp", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  table := expr_info_table_new();
  env := Environment.new(String.from("test"));
  ty := mk_array_ty(usize(3));
  install_array_type(ctx, ty, "__yo_array_i32_3");
  call_info := new_expr_info(env, ty);
  call_info.variable_name = Option(String).Some(String.from("filled.array"));
  expr_info_table_set(table, usize(52), call_info);
  type_arg_info := new_expr_info(env, TypeValue.TypeUni(usize(0)));
  type_arg_info.value = Option(EvalValue).Some(create_type_value(ty));
  expr_info_table_set(table, usize(50), type_arg_info);
  ctx.expr_info_table = Option(typeof(table)).Some(table);
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(50), "ArrayType", TokenKind.Identifier));
  args.push(mk_atom(usize(51), "value", TokenKind.Identifier));
  call := mk_call(usize(52), BF_ARRAY_FILL, args);
  result := generate_yo_array_fill(call, args, ctx, String.from("  "));
  assert(result == String.from("filled_u46_array"), "returns sanitized temp");
  out := ctx.emitter.code;
  assert(out.contains(String.from("  __yo_array_i32_3 filled_u46_array;")), "decl");
  assert(out.contains(String.from("for (int i_")), "loop var");
  assert(out.contains(String.from(" < 3;")), "length");
  assert(out.contains(String.from("filled_u46_array.data[")), "assignment lhs");
  assert(out.contains(String.from("] = value;")), "assignment rhs");
});

test("generate_yo_array_fill: rejects non-TypeVal first argument", {
  set_generate_expr_fn(stub_generate_expr);
  ctx := CodegenContext.new();
  args := ArrayList(AstExpr).new();
  args.push(mk_atom(usize(60), "not_type", TokenKind.Identifier));
  args.push(mk_atom(usize(61), "value", TokenKind.Identifier));
  call := mk_call(usize(62), BF_ARRAY_FILL, args);
  result := generate_yo_array_fill(call, args, ctx, String.from(""));
  assert(
    result == String.from("/* ERROR: __yo_array_fill first argument must be an ArrayType */"),
    "diagnostic"
  );
});
// ─── format_array_compound_literal ──────────────────────────────────────────
test("format_array_compound_literal: composes (Type){ .data = { ... } }", {
  out := format_array_compound_literal(
    String.from("Array_i32_3"),
    String.from("1, 2, 3")
  );
  assert(
    out == String.from("(Array_i32_3){ .data = { 1, 2, 3 } }"),
    "array compound literal"
  );
});
test("format_array_compound_literal: empty args list", {
  // Edge case — a zero-element array still has the `.data = { }`
  // shape so the C compiler emits a valid (but empty) initialiser.
  out := format_array_compound_literal(
    String.from("Array_u8_0"),
    String.from("")
  );
  assert(
    out == String.from("(Array_u8_0){ .data = {  } }"),
    "empty args list"
  );
});
