  }, _ => assert(false, "m")));
};

test "Phase 5fz: collatz max height", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "collatz_max := (fn(n : i32) -> i32)({\n(x : i32) = n;\n(max_val : i32) = n;\nwhile (x != i32(1)), {\ncond(((x % i32(2)) == i32(0)) => { x = (x / i32(2)); }, true => { x = ((i32(3) * x) + i32(1)); });\ncond((x > max_val) => { max_val = x; }, true => ());\n};\nmax_val\n});\nexport collatz_max(i32(27));\nexport collatz_max(i32(7));";
