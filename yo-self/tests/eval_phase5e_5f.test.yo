test "Phase 5fe: multiple modules", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));

  set_module_loader((fn(path : String) -> Option(EvalValue))(
    cond(
      (path.as_str() == "constants") => {
        names := ArrayList(String).new();
        vals := ArrayList(EvalValue).new();
        names.push(String.from("MAX"));
        vals.push(EvalValue.IntLit(String.from("1000")));
        .Some(EvalValue.ModuleVal(names, vals))
      },
      (path.as_str() == "defaults") => {
        names := ArrayList(String).new();
        vals := ArrayList(EvalValue).new();
        names.push(String.from("START"));
        vals.push(EvalValue.IntLit(String.from("1")));
        .Some(EvalValue.ModuleVal(names, vals))
      },
      true => Option(EvalValue).None
    )
  ));

  src := "open import \"constants\";\nopen import \"defaults\";\nexport (MAX + START);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(_, vals) => match(vals.get(usize(0)),
        .Some(v) => match(v, .IntLit(n) => assert((n.as_str() == "1001"), "1000+1=1001"), _ => assert(false, "not IntLit")),
        .None => assert(false, "no value")
      ),
      _ => assert(false, "not ModuleVal")
    )
  );
};

