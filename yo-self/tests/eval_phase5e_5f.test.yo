test "Phase 5fr: bubble sort via set reassign", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "(arr : [i32]) = [i32(4), i32(2), i32(3), i32(1)];\n(n : i32) = arr.len();\nwhile (n > i32(1)), {\n(i : i32) = i32(0);\nwhile (i < (n - i32(1))), {\nmatch(arr.get(i.to_usize()), .Some(a) => match(arr.get((i + i32(1)).to_usize()), .Some(b) => cond((a > b) => {\narr = arr.set(i, b);\narr = arr.set((i + i32(1)), a);\n}, true => ()), .None => ()), .None => ());\ni = (i + i32(1));\n};\nn = (n - i32(1));\n};\nexport arr.first();\nexport arr.last();";
