test "Phase 5fc: cond-based even check", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "is_even := (fn(n : i32) -> bool)(cond((n == i32(0)) => true, (n == i32(1)) => false, (n == i32(2)) => true, (n == i32(3)) => false, (n == i32(4)) => true, true => false));\nexport is_even(i32(4));\nexport is_even(i32(3));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
    .Some(mod_val) => match(mod_val,
      .ModuleVal(names, vals) => {
        match(vals.get(usize(0)),
          .Some(v) => match(v, .BoolVal(b) => assert(b, "4 is even"), _ => assert(false, "not BoolVal")),
          .None => assert(false, "no val 0")
        );
        match(vals.get(usize(1)),
          .Some(v) => match(v, .BoolVal(b) => assert(!(b), "3 is not even"), _ => assert(false, "not BoolVal")),
          .None => assert(false, "no val 1")
        );
      },
      _ => assert(false, "not ModuleVal")
    )
  );
};

