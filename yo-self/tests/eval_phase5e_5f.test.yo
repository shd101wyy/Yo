test "Phase 5fr: modular exponentiation", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "mod_pow := (fn(base : i32, exp : i32, m : i32) -> i32)({\n(result : i32) = i32(1);\n(b : i32) = (base % m);\n(e : i32) = exp;\nwhile (e > i32(0)), {\ncond(((e % i32(2)) == i32(1)) => { result = ((result * b) % m); }, true => ());\ne = (e / i32(2));\nb = ((b * b) % m);\n};\nresult\n});\nexport mod_pow(i32(2), i32(10), i32(1000));\nexport mod_pow(i32(3), i32(5), i32(7));";
