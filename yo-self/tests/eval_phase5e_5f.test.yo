test "Phase 5fb: while with continue", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "parse error"); escape (); }));
  src := "(sum : i32) = i32(0);\n(i : i32) = i32(1);\nwhile (i <= i32(10)), {\n  (cur : i32) = i;\n  i = (i + i32(1));\n  if(((cur % i32(2)) != i32(0)), { continue; });\n  sum = (sum + cur);\n};\nexport sum;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result,
    .None => assert(false, "returned None"),
