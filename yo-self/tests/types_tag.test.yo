//! Sanity test for TypeTag.
open(import("std/string"));
{ TypeTag, type_tag_name } :: import("../types/tags.yo");
{ assert, panic } :: import("std/assert");
test("type_tag_name basic primitives", {
  assert(type_tag_name(TypeTag.TUnit) == `unit`, "unit name");
  assert(type_tag_name(TypeTag.TBool) == `bool`, "bool name");
  assert(type_tag_name(TypeTag.TI32) == `i32`, "i32 name");
  assert(type_tag_name(TypeTag.TU64) == `u64`, "u64 name");
  assert(type_tag_name(TypeTag.TF32) == `f32`, "f32 name");
  assert(type_tag_name(TypeTag.TUsize) == `usize`, "usize name");
});
test("type_tag_name compound and special", {
  assert(type_tag_name(TypeTag.TArray) == `Array`, "Array name");
  assert(type_tag_name(TypeTag.TStr) == `str`, "str name");
  assert(type_tag_name(TypeTag.TTuple) == `Tuple`, "Tuple name");
  assert(type_tag_name(TypeTag.TFunction) == `Function`, "Function name");
  assert(type_tag_name(TypeTag.TPtr) == `Ptr`, "Ptr name");
  assert(type_tag_name(TypeTag.TSomeType) == `SomeType`, "SomeType name");
});
test("TypeTag equality", {
  (a : TypeTag) = TypeTag.TI32;
  (b : TypeTag) = TypeTag.TI32;
  (c : TypeTag) = TypeTag.TI64;
  assert(a == b, "i32 == i32");
  assert(a != c, "i32 != i64");
});
