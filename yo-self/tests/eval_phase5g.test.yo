  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "power := (fn(base : i32, exp : i32) -> i32)(cond((exp == i32(0)) => i32(1), true => (base * recur(base, (exp - i32(1))))));\nexport power(i32(2), i32(10));\nexport power(i32(3), i32(4));";
