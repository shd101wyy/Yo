/// Build a typed param `name : type_name` as an infix `:` FnCall.
make_typed_param :: (fn(name : str, type_name : str) -> AstExpr)(
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Operator, ":"))),
    {
      a := ArrayList(AstExpr).new();
      a.push(make_atom(TokenKind.Identifier, name));
      a.push(make_atom(TokenKind.Identifier, type_name));
      a
    },
    true,
    make_token(TokenKind.Operator, ":")
  )
);

/// Build a forall param `forall(name)` as a non-infix FnCall.
make_forall_param :: (fn(name : str) -> AstExpr)(
  .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "forall"))),
    {
      a := ArrayList(AstExpr).new();
      a.push(make_atom(TokenKind.Identifier, name));
      a
    },
    false,
    make_token(TokenKind.Identifier, "forall")
  )
);

/// Build `(fn(param_exprs…) -> unit)(body)` from an ArrayList of AstExpr params.
/// More general than `make_fn_def` which only accepts bare atom param names.
make_fn_def_from_param_exprs :: (fn(param_exprs : ArrayList(AstExpr), body : AstExpr) -> AstExpr)({
  (fn_expr : AstExpr) = .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Identifier, "fn"))),
    param_exprs,
    false,
    make_token(TokenKind.Identifier, "fn")
  );
  arrow_args := ArrayList(AstExpr).new();
  arrow_args.push(fn_expr);
  arrow_args.push(.Atom(usize(0), make_token(TokenKind.Identifier, "unit")));
  (fn_sig : AstExpr) = .FnCall(usize(0), 
    box(.Atom(usize(0), make_token(TokenKind.Operator, "->"))),
    arrow_args,
    true,
    make_token(TokenKind.Operator, "->")
  );
  outer_args := ArrayList(AstExpr).new();
  outer_args.push(body);
  (result : AstExpr) = .FnCall(usize(0), box(fn_sig), outer_args, false, make_token(TokenKind.Operator, "->"));
  result
});

// ---------------------------------------------------------------------------
// Phase 3l — Generic specialization / forall param binding
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Phase 3m helpers — build export, open, and import AST nodes
// ---------------------------------------------------------------------------

/// Build `export(names…)` as a non-infix FnCall.
make_export :: (fn(names : ArrayList(str)) -> AstExpr)({
  export_tok := make_token(TokenKind.Identifier, BK_EXPORT);
  args := ArrayList(AstExpr).new();
  (i : usize) = usize(0);
  n := names.len();
  while runtime((i < n)), {
    match(names.get(i),
      .Some(name) => { args.push(make_ident(name)); },
      .None => ()
    );
    i = (i + usize(1));
  };
  .FnCall(usize(0), box(.Atom(usize(0), export_tok)), args, false, export_tok)
});

/// Build `open(expr)` as a non-infix FnCall.
make_open :: (fn(expr : AstExpr) -> AstExpr)({
  open_tok := make_token(TokenKind.Identifier, BK_OPEN);
  args := ArrayList(AstExpr).new();
  args.push(expr);
  .FnCall(usize(0), box(.Atom(usize(0), open_tok)), args, false, open_tok)
});

/// Build `import("path")` as a non-infix FnCall (path is a string literal).
make_import_expr :: (fn(path : str) -> AstExpr)({
  import_tok := make_token(TokenKind.Identifier, BK_IMPORT);
  path_lit   := `"${String.from(path)}"`;
  args := ArrayList(AstExpr).new();
  args.push(make_atom(TokenKind.StringLit, path_lit.as_str()));
  .FnCall(usize(0), box(.Atom(usize(0), import_tok)), args, false, import_tok)
});

/// Build `{ A, B } :: import("path")` — anon-struct LHS destructure.
make_destructure_import :: (fn(names : ArrayList(str), path : str) -> AstExpr)({
  anon_tok := make_token(TokenKind.Identifier, BK_ANON_STRUCT);
  name_exprs := ArrayList(AstExpr).new();
  (i : usize) = usize(0);
  n := names.len();
  while runtime((i < n)), {
    match(names.get(i),
      .Some(nm) => { name_exprs.push(make_ident(nm)); },
      .None => ()
    );
    i = (i + usize(1));
  };
  lhs := (AstExpr).FnCall(usize(0), box(.Atom(usize(0), anon_tok)), name_exprs, false, anon_tok);
  rhs := make_import_expr(path);
  make_infix("::", lhs, rhs)
});

