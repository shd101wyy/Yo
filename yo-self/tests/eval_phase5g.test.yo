test "Phase 5ga: while break early pattern", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "arr := [i32(2), i32(4), i32(6), i32(7), i32(8), i32(10)];\n(first_odd : i32) = i32(-1);\n(found : bool) = false;\n(i : i32) = i32(0);\nwhile ((i < arr.len()) && !(found)), {\nmatch(arr.get(i.to_usize()), .Some(v) => cond(((v % i32(2)) != i32(0)) => { first_odd = v; found = true; }, true => ()), .None => ());\ni = (i + i32(1));\n};\nexport first_odd;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "7"), "first odd=7"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

test "Phase 5ga: boolean expression evaluation", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "a := true;\nb := false;\nc := true;\nexport (a && c);\nexport (a || b);\nexport (!(b) && c);\nexport (a && b);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .BoolVal(b) => assert(b, "a&&c"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .BoolVal(b) => assert(b, "a||b"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .BoolVal(b) => assert(b, "!b&&c"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(3)), .Some(x) => match(x, .BoolVal(b) => assert(!(b), "a&&b false"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5ga: count elements above threshold", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "arr := [i32(1), i32(5), i32(3), i32(8), i32(2), i32(9), i32(4)];\nabove4 := arr.filter((fn(x : i32) -> bool)((x > i32(4))));\nabove7 := arr.filter((fn(x : i32) -> bool)((x > i32(7))));\nexport above4.len();\nexport above7.len();";
