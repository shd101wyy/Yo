test "Phase 5ga: Euler totient for small n", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "gcd := (fn(a : i32, b : i32) -> i32)(cond((b == i32(0)) => a, true => recur(b, (a % b))));\ntotient := (fn(n : i32) -> i32)({\n(count : i32) = i32(0);\n(i : i32) = i32(1);\nwhile (i <= n), {\ncond((gcd(i, n) == i32(1)) => { count = (count + i32(1)); }, true => ());\ni = (i + i32(1));\n};\ncount\n});\nexport totient(i32(12));\nexport totient(i32(7));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "4"), "φ(12)=4"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "6"), "φ(7)=6"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5ga: array dot product", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "a := [i32(1), i32(2), i32(3)];\nb := [i32(4), i32(5), i32(6)];\n(dot : i32) = i32(0);\n(i : i32) = i32(0);\nwhile (i < a.len()), {\nmatch(a.get(i.to_usize()), .Some(av) => match(b.get(i.to_usize()), .Some(bv) => { dot = (dot + (av * bv)); }, .None => ()), .None => ());\ni = (i + i32(1));\n};\nexport dot;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "32"), "1*4+2*5+3*6=32"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

test "Phase 5ga: is_palindrome number", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "is_palindrome_num := (fn(n : i32) -> bool)({\nrev := (fn(x : i32) -> i32)({\n(result : i32) = i32(0);\n(v : i32) = x;\nwhile (v > i32(0)), { result = ((result * i32(10)) + (v % i32(10))); v = (v / i32(10)); };\nresult\n});\n(rev(n) == n)\n});\nexport is_palindrome_num(i32(121));\nexport is_palindrome_num(i32(123));\nexport is_palindrome_num(i32(1221));";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .BoolVal(b) => assert(b, "121 palindrome"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .BoolVal(b) => assert(!(b), "123 not"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(2)), .Some(x) => match(x, .BoolVal(b) => assert(b, "1221 palindrome"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

test "Phase 5ga: sum squares vs square sums", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "(sum_sq : i32) = i32(0);\n(sq_sum : i32) = i32(0);\n(i : i32) = i32(1);\nwhile (i <= i32(10)), {\nsum_sq = (sum_sq + (i * i));\nsq_sum = (sq_sum + i);\ni = (i + i32(1));\n};\nsq_sum = (sq_sum * sq_sum);\nexport (sq_sum - sum_sq);";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "2640"), "diff=2640"), _ => assert(false, "t")), .None => assert(false, "v")), _ => assert(false, "m")));
};

test "Phase 5ga: nested struct update chain", {
  env := empty_env();
  given(exn) := Exception(throw: ((err) -> { assert(false, "e"); escape (); }));
  src := "Point :: struct(x : i32, y : i32);\nscale := (fn(p : Point, factor : i32) -> Point)(Point(x: (p.x * factor), y: (p.y * factor)));\ntranslate := (fn(p : Point, dx : i32, dy : i32) -> Point)(Point(x: (p.x + dx), y: (p.y + dy)));\np := Point(x: i32(3), y: i32(4));\np2 := scale(p, i32(2));\np3 := translate(p2, i32(1), i32(1));\nexport p3.x;\nexport p3.y;";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &env);
  match(result, .None => assert(false, "N"), .Some(m) => match(m, .ModuleVal(_, v) => {
    match(v.get(usize(0)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "7"), "x=7"), _ => assert(false, "t")), .None => assert(false, "v"));
    match(v.get(usize(1)), .Some(x) => match(x, .IntLit(n) => assert((n.as_str() == "9"), "y=9"), _ => assert(false, "t")), .None => assert(false, "v"));
  }, _ => assert(false, "m")));
};

