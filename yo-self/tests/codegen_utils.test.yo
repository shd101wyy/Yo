/// Tests for yo-self/codegen/utils/index.yo.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token, TokenKind } :: import("../token.yo");
{ AstExpr } :: import("../expr.yo");
{ TypeValue } :: import("../types/definitions.yo");
{ t_bool, t_i32, t_ptr, t_unit } :: import("../types/creators.yo");
{ type_to_string } :: import("../types/string.yo");
{ EvalValue } :: import("../value.yo");
{ Environment, add_variable_to_env } :: import("../env.yo");
{ CodegenContext, CodegenTypeEntry } :: import("../codegen/context.yo");
{
  sanitize_for_c_identifier,
  sanitize_for_c_identifier_str,
  should_avoid_const,
  can_optimize_as_simple_enum,
  can_optimize_as_nullable_pointer,
  get_enum_variant_c_name,
  get_type_string,
  get_type_string_opt,
  get_variable_type_string,
  get_variable_type_string_str,
  get_variable_name_for_codegen,
  get_deferred_dup_target_atom_name,
  get_deferred_drop_target_atom_name,
  is_deferred_drop_for_closure_capture,
  is_function_value_with_only_builtin_yo_inline_function_call
} :: import("../codegen/utils/index.yo");
mk_struct :: (
  fn(
    name : str,
    is_reference_semantics : bool,
    is_atomic_rc : bool
  ) -> TypeValue
)(
  TypeValue.Struct(
    String.from(""),
    String.from(name),
    ArrayList(String).new(),
    ArrayList(TypeValue).new(),
    is_reference_semantics,
    is_atomic_rc,
    false
  )
);
/// Build an enum with the given list of per-variant field-type lists.
/// Each inner list is the fields of one variant — pass `[]` for an
/// empty variant.
mk_enum :: (
  fn(name : str, variants : ArrayList(ArrayList(TypeValue))) -> TypeValue
)({
  variant_names := ArrayList(String).new();
  variant_field_labels := ArrayList(ArrayList(String)).new();
  variant_discriminants := ArrayList(i64).new();
  i := usize(0);
  while(i < variants.len(), {
    variant_names.push(String.from("V"));
    variant_field_labels.push(ArrayList(String).new());
    variant_discriminants.push(i64(0));
    i = (i + usize(1));
  });
  TypeValue.EnumT(
    String.from(""),
    String.from(name),
    variant_names,
    variants,
    Option(String).None,
    variant_field_labels,
    variant_discriminants
  )
});
test("sanitize: TS-equivalent mangling rejects collisions", {
  // `Slice(u8)` and `Slice u8 ` both contain non-identifier bytes but
  // they mangle to different strings under the canonical mangler.
  a := sanitize_for_c_identifier_str("Slice(u8)");
  b := sanitize_for_c_identifier_str("Slice u8 ");
  assert(a != b, "no collision between distinct inputs");
  assert(a == String.from("Slice_u40_u8_u41_"), "Slice(u8)");
  assert(b == String.from("Slice_u32_u8_u32_"), "Slice u8 ");
});
test("sanitize: reserved word `return` is prefixed", {
  out := sanitize_for_c_identifier(String.from("return"));
  assert(out == String.from("__yo_c_reserved_return"), "reserved");
});
test("should_avoid_const: object types yes, value types no", {
  obj := mk_struct("Counter", true, false);
  val := mk_struct("Point", false, false);
  assert(should_avoid_const(obj), "object → avoid const");
  assert(!(should_avoid_const(val)), "value struct → ok with const");
  assert(!(should_avoid_const(t_i32())), "i32 → ok with const");
  assert(!(should_avoid_const(t_unit())), "unit → ok with const");
});
test("can_optimize_as_simple_enum: data-less enum", {
  empty := ArrayList(TypeValue).new();
  variants := ArrayList(ArrayList(TypeValue)).new();
  variants.push(empty);
  variants.push(ArrayList(TypeValue).new());
  variants.push(ArrayList(TypeValue).new());
  ty := mk_enum("Color", variants);
  assert(can_optimize_as_simple_enum(ty), "three empty variants");
});
test("can_optimize_as_simple_enum: enum with data is rejected", {
  empty := ArrayList(TypeValue).new();
  with_data := ArrayList(TypeValue).new();
  with_data.push(t_i32());
  variants := ArrayList(ArrayList(TypeValue)).new();
  variants.push(empty);
  variants.push(with_data);
  ty := mk_enum("Result", variants);
  assert(!(can_optimize_as_simple_enum(ty)), "data variant disqualifies");
});
test("can_optimize_as_simple_enum: zero-variant enum is rejected", {
  variants := ArrayList(ArrayList(TypeValue)).new();
  ty := mk_enum("Empty", variants);
  assert(!(can_optimize_as_simple_enum(ty)), "no variants → false");
});
test("can_optimize_as_simple_enum: non-enum returns false", {
  assert(!(can_optimize_as_simple_enum(t_i32())), "i32 is not an enum");
});
test("can_optimize_as_nullable_pointer: Option(*i32) → Some(*i32)", {
  // None variant: no fields.
  // Some variant: one Pointer(i32) field.
  none_fields := ArrayList(TypeValue).new();
  some_fields := ArrayList(TypeValue).new();
  some_fields.push(t_ptr(t_i32()));
  variants := ArrayList(ArrayList(TypeValue)).new();
  variants.push(none_fields);
  variants.push(some_fields);
  ty := mk_enum("Option", variants);
  match(
    can_optimize_as_nullable_pointer(ty),
    .None => assert(false, "expected Some pointer type"),
    .Some(child) => match(
      child,
      .Pointer(_) => assert(true, "pointer child"),
      _ => assert(false, "child must be Pointer")
    )
  );
});
test("can_optimize_as_nullable_pointer: order does not matter", {
  // Same as above but with Some first and None second.
  some_fields := ArrayList(TypeValue).new();
  some_fields.push(t_ptr(t_bool()));
  variants := ArrayList(ArrayList(TypeValue)).new();
  variants.push(some_fields);
  variants.push(ArrayList(TypeValue).new());
  ty := mk_enum("Option", variants);
  assert(
    can_optimize_as_nullable_pointer(ty).is_some(),
    "Some-first also optimisable"
  );
});
test("can_optimize_as_nullable_pointer: payload must be a pointer", {
  // None + Some(i32) — i32 is not a pointer, so no nullable-pointer opt.
  some_fields := ArrayList(TypeValue).new();
  some_fields.push(t_i32());
  variants := ArrayList(ArrayList(TypeValue)).new();
  variants.push(ArrayList(TypeValue).new());
  variants.push(some_fields);
  ty := mk_enum("Option", variants);
  assert(
    can_optimize_as_nullable_pointer(ty).is_none(),
    "non-pointer payload rejected"
  );
});
test("can_optimize_as_nullable_pointer: needs exactly two variants", {
  // 3-variant enum: never optimisable.
  v1 := ArrayList(TypeValue).new();
  v2 := ArrayList(TypeValue).new();
  v2.push(t_ptr(t_i32()));
  v3 := ArrayList(TypeValue).new();
  variants := ArrayList(ArrayList(TypeValue)).new();
  variants.push(v1);
  variants.push(v2);
  variants.push(v3);
  ty := mk_enum("Three", variants);
  assert(
    can_optimize_as_nullable_pointer(ty).is_none(),
    "three variants → false"
  );
});
test("can_optimize_as_nullable_pointer: two empty variants rejected", {
  // Two variants both empty — no payload to carry pointer for, rejected.
  v1 := ArrayList(TypeValue).new();
  v2 := ArrayList(TypeValue).new();
  variants := ArrayList(ArrayList(TypeValue)).new();
  variants.push(v1);
  variants.push(v2);
  ty := mk_enum("TwoEmpty", variants);
  assert(
    can_optimize_as_nullable_pointer(ty).is_none(),
    "two empty variants → false"
  );
});
test("can_optimize_as_nullable_pointer: non-enum returns None", {
  assert(
    can_optimize_as_nullable_pointer(t_i32()).is_none(),
    "i32 → None"
  );
});
/// Register `enum_ty` in `ctx.types` under its `type_to_string` key
/// with the given lower-case `c_name`. Mirrors how the bootstrap
/// codegen populates the registry.
install_enum_type :: (
  fn(ctx : CodegenContext, enum_ty : TypeValue, c_name : str) -> unit
)({
  entry := CodegenTypeEntry(type_value : enum_ty, c_name : String.from(c_name));
  _ := ctx.types.set(type_to_string(enum_ty), entry);
});
test("get_enum_variant_c_name: registered enum → UPPER(c_name)_UPPER(variant)", {
  empty_fields := ArrayList(TypeValue).new();
  some_fields := ArrayList(TypeValue).new();
  some_fields.push(t_ptr(t_i32()));
  variants := ArrayList(ArrayList(TypeValue)).new();
  variants.push(empty_fields);
  variants.push(some_fields);
  ty := mk_enum("Option", variants);
  ctx := CodegenContext.new();
  install_enum_type(ctx, ty, "yo_option_i32");
  match(
    get_enum_variant_c_name(ty, String.from("Some"), ctx),
    .None => assert(false, "expected Some"),
    .Some(s) => assert(s == String.from("YO_OPTION_I32_SOME"), "Some tag")
  );
  match(
    get_enum_variant_c_name(ty, String.from("None"), ctx),
    .None => assert(false, "expected Some"),
    .Some(s) => assert(s == String.from("YO_OPTION_I32_NONE"), "None tag")
  );
});
test("get_enum_variant_c_name: unregistered enum → None", {
  variants := ArrayList(ArrayList(TypeValue)).new();
  variants.push(ArrayList(TypeValue).new());
  variants.push(ArrayList(TypeValue).new());
  ty := mk_enum("Unknown", variants);
  ctx := CodegenContext.new();
  // No install_enum_type — the ctx.types map is empty.
  assert(
    get_enum_variant_c_name(ty, String.from("V"), ctx).is_none(),
    "missing registry entry → None"
  );
});
test("get_enum_variant_c_name: variant name with snake_case is uppercased", {
  variants := ArrayList(ArrayList(TypeValue)).new();
  variants.push(ArrayList(TypeValue).new());
  variants.push(ArrayList(TypeValue).new());
  ty := mk_enum("Status", variants);
  ctx := CodegenContext.new();
  install_enum_type(ctx, ty, "yo_status");
  match(
    get_enum_variant_c_name(ty, String.from("not_started"), ctx),
    .None => assert(false, "expected Some"),
    .Some(s) => assert(s == String.from("YO_STATUS_NOT_STARTED"), "snake → SCREAMING_SNAKE")
  );
});
test("get_type_string: primitive falls through to type_value_to_c_field", {
  ctx := CodegenContext.new();
  assert(get_type_string(t_i32(), ctx) == String.from("int32_t"), "i32");
  assert(get_type_string(t_bool(), ctx) == String.from("bool"), "bool");
});
test("get_type_string: unregistered named type falls back to int32_t", {
  // An unregistered Struct type can't be resolved — the TS canonical
  // fallback is `int32_t` (matches the `if (!type) return "int32_t";`
  // guard).
  variants := ArrayList(ArrayList(TypeValue)).new();
  variants.push(ArrayList(TypeValue).new());
  variants.push(ArrayList(TypeValue).new());
  ty := mk_enum("UnregisteredEnum", variants);
  ctx := CodegenContext.new();
  assert(
    get_type_string(ty, ctx) == String.from("int32_t"),
    "unregistered → int32_t"
  );
});
test("get_type_string_opt: unregistered named type returns None", {
  variants := ArrayList(ArrayList(TypeValue)).new();
  variants.push(ArrayList(TypeValue).new());
  ty := mk_enum("Other", variants);
  ctx := CodegenContext.new();
  assert(
    get_type_string_opt(ty, ctx).is_none(),
    "unregistered enum opt → None"
  );
});
test("get_variable_type_string: builds `<type> <name>` for primitive", {
  ctx := CodegenContext.new();
  out := get_variable_type_string_str(t_i32(), "count", ctx);
  assert(out == String.from("int32_t count"), "i32 count");
});
test("get_variable_type_string: sanitises the variable name", {
  ctx := CodegenContext.new();
  out := get_variable_type_string_str(t_bool(), "raise.flag", ctx);
  // `.` (byte 46) mangles to `_u46_`.
  assert(out == String.from("bool raise_u46_flag"), "name sanitised");
});
test("get_variable_type_string: registered enum uses registry C name", {
  variants := ArrayList(ArrayList(TypeValue)).new();
  variants.push(ArrayList(TypeValue).new());
  variants.push(ArrayList(TypeValue).new());
  ty := mk_enum("Color", variants);
  ctx := CodegenContext.new();
  install_enum_type(ctx, ty, "yo_color");
  out := get_variable_type_string_str(ty, "c", ctx);
  assert(out == String.from("yo_color c"), "registry hit");
});
test("get_variable_type_string: reserved C name is prefixed", {
  ctx := CodegenContext.new();
  out := get_variable_type_string_str(t_i32(), "return", ctx);
  assert(out == String.from("int32_t __yo_c_reserved_return"), "reserved");
});
/// Build an `Atom` with the given identifier text. Tokens carry zero
/// row/column/character offsets — the helpers under test only read
/// `Token.value`.
mk_atom :: (fn(value : str) -> AstExpr)(
  AstExpr.Atom(
    usize(0),
    Token(
      kind : TokenKind.Identifier,
      value : String.from(value),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from(""),
      input : String.from("")
    )
  )
);
/// Build a 0-or-N-arg FnCall whose func is an atom with name `func_name`.
mk_call :: (fn(func_name : str, args : ArrayList(AstExpr)) -> AstExpr)(
  AstExpr.FnCall(
    usize(0),
    box(mk_atom(func_name)),
    args,
    false,
    Token(
      kind : TokenKind.Identifier,
      value : String.from(func_name),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from(""),
      input : String.from("")
    )
  )
);
test("get_deferred_dup_target_atom_name: ___dup(x) → Some(x)", {
  args := ArrayList(AstExpr).new();
  args.push(mk_atom("counter"));
  expr := mk_call("___dup", args);
  match(
    get_deferred_dup_target_atom_name(expr),
    .Some(s) => assert(s == String.from("counter"), "extracts arg name"),
    .None => assert(false, "expected Some")
  );
});
test("get_deferred_dup_target_atom_name: (x.___dup)() → Some(x)", {
  // Inner `.` call: dot_args = [Atom(x), Atom(___dup)].
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(mk_atom("counter"));
  dot_args.push(mk_atom("___dup"));
  dot_call := mk_call(".", dot_args);
  // Outer call: FnCall(func=dot_call, args=[])
  outer_args := ArrayList(AstExpr).new();
  outer := AstExpr.FnCall(
    usize(0),
    box(dot_call),
    outer_args,
    false,
    Token(
      kind : TokenKind.Identifier,
      value : String.from(""),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from(""),
      input : String.from("")
    )
  );
  match(
    get_deferred_dup_target_atom_name(outer),
    .Some(s) => assert(s == String.from("counter"), "extracts lhs name"),
    .None => assert(false, "expected Some")
  );
});
test("get_deferred_dup_target_atom_name: bare atom returns None", {
  assert(
    get_deferred_dup_target_atom_name(mk_atom("counter")).is_none(),
    "atom alone is not a dup expr"
  );
});
test("get_deferred_drop_target_atom_name: ___drop(x) → Some(x)", {
  args := ArrayList(AstExpr).new();
  args.push(mk_atom("box"));
  expr := mk_call("___drop", args);
  match(
    get_deferred_drop_target_atom_name(expr),
    .Some(s) => assert(s == String.from("box"), "positional drop"),
    .None => assert(false, "expected Some")
  );
});
test("get_deferred_drop_target_atom_name: (x.___drop)() → Some(x)", {
  dot_args := ArrayList(AstExpr).new();
  dot_args.push(mk_atom("box"));
  dot_args.push(mk_atom("___drop"));
  dot_call := mk_call(".", dot_args);
  outer_args := ArrayList(AstExpr).new();
  outer := AstExpr.FnCall(
    usize(0),
    box(dot_call),
    outer_args,
    false,
    Token(
      kind : TokenKind.Identifier,
      value : String.from(""),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from(""),
      input : String.from("")
    )
  );
  match(
    get_deferred_drop_target_atom_name(outer),
    .Some(s) => assert(s == String.from("box"), "method drop"),
    .None => assert(false, "expected Some")
  );
});
test("get_deferred_drop_target_atom_name: foo(x) (not ___drop) → None", {
  // A regular function call should not match.
  args := ArrayList(AstExpr).new();
  args.push(mk_atom("x"));
  expr := mk_call("foo", args);
  assert(
    get_deferred_drop_target_atom_name(expr).is_none(),
    "non-drop call → None"
  );
});
test("is_deferred_drop_for_closure_capture: captured target → true", {
  args := ArrayList(AstExpr).new();
  args.push(mk_atom("captured_var"));
  drop_expr := mk_call("___drop", args);
  captures := ArrayList(String).new();
  captures.push(String.from("captured_var"));
  captures.push(String.from("other"));
  assert(
    is_deferred_drop_for_closure_capture(drop_expr, captures),
    "captured_var present"
  );
});
test("is_deferred_drop_for_closure_capture: uncaptured target → false", {
  args := ArrayList(AstExpr).new();
  args.push(mk_atom("local_var"));
  drop_expr := mk_call("___drop", args);
  captures := ArrayList(String).new();
  captures.push(String.from("captured_var"));
  assert(
    !(is_deferred_drop_for_closure_capture(drop_expr, captures)),
    "local_var not in captures"
  );
});
test("is_deferred_drop_for_closure_capture: not a drop expr → false", {
  captures := ArrayList(String).new();
  captures.push(String.from("x"));
  assert(
    !(is_deferred_drop_for_closure_capture(mk_atom("x"), captures)),
    "atom alone is not a drop expr"
  );
});
test("get_variable_name_for_codegen: no env → sanitises the raw name", {
  out := get_variable_name_for_codegen(
    String.from("foo.bar"),
    Option(Environment).None
  );
  assert(
    out == String.from("foo_u46_bar"),
    "no env → direct sanitisation"
  );
});
test("get_variable_name_for_codegen: env hit → uses Variable.name", {
  env := Environment.new(String.from("test"));
  placeholder_token := Token(
    kind : TokenKind.Identifier,
    value : String.from(""),
    row : usize(0),
    column : usize(0),
    character : usize(0),
    module_path : String.from(""),
    input : String.from("")
  );
  _r := add_variable_to_env(
    env,
    String.from("count.cur"),
    t_i32(),
    Option(EvalValue).None,
    false,
    false,
    false,
    false,
    placeholder_token
  );
  out := get_variable_name_for_codegen(
    String.from("count.cur"),
    Option(Environment).Some(env)
  );
  // `.` (46) → `_u46_`. The helper looks up the latest binding and
  // sanitises its actual `.name` (which here matches the input).
  assert(out == String.from("count_u46_cur"), "env hit");
});
test("get_variable_name_for_codegen: env miss → sanitises the raw name", {
  env := Environment.new(String.from("test"));
  // Don't add any variables — the lookup should miss and fall back.
  out := get_variable_name_for_codegen(
    String.from("never_added"),
    Option(Environment).Some(env)
  );
  assert(out == String.from("never_added"), "miss → direct sanitisation");
});
test("get_variable_name_for_codegen: reserved-word still gets the prefix", {
  // The TS counterpart bypasses the reserved-word remap for
  // extern-C variables, but yo-self's TypeValue doesn't yet carry
  // that flag — so reserved names always get the prefix.
  out := get_variable_name_for_codegen(
    String.from("return"),
    Option(Environment).None
  );
  assert(
    out == String.from("__yo_c_reserved_return"),
    "reserved word prefixed"
  );
});
/// Build a placeholder FuncVal whose body is the given expression.
mk_func_val :: (fn(body : AstExpr) -> EvalValue)(
  EvalValue.FuncVal(
    ArrayList(String).new(),
    ArrayList(String).new(),
    ArrayList(String).new(),
    ArrayList(String).new(),
    box(body),
    ArrayList(String).new(),
    ArrayList(TypeValue).new(),
    ArrayList(EvalValue).new(),
    String.from("")
  )
);
/// Build a 2-arg FnCall whose func is an atom with name `func_name`.
mk_call_2_atoms :: (
  fn(func_name : str, a_name : str, b_name : str) -> AstExpr
)({
  args := ArrayList(AstExpr).new();
  args.push(
    AstExpr.Atom(
      usize(0),
      Token(
        kind : TokenKind.Identifier,
        value : String.from(a_name),
        row : usize(0),
        column : usize(0),
        character : usize(0),
        module_path : String.from(""),
        input : String.from("")
      )
    )
  );
  args.push(
    AstExpr.Atom(
      usize(0),
      Token(
        kind : TokenKind.Identifier,
        value : String.from(b_name),
        row : usize(0),
        column : usize(0),
        character : usize(0),
        module_path : String.from(""),
        input : String.from("")
      )
    )
  );
  AstExpr.FnCall(
    usize(0),
    box(
      AstExpr.Atom(
        usize(0),
        Token(
          kind : TokenKind.Identifier,
          value : String.from(func_name),
          row : usize(0),
          column : usize(0),
          character : usize(0),
          module_path : String.from(""),
          input : String.from("")
        )
      )
    ),
    args,
    true,
    Token(
      kind : TokenKind.Identifier,
      value : String.from(func_name),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from(""),
      input : String.from("")
    )
  )
});
test("is_function_value_with_only_builtin_yo_inline_function_call: direct __yo_op_add body", {
  body := mk_call_2_atoms("__yo_op_add", "a", "b");
  match(
    is_function_value_with_only_builtin_yo_inline_function_call(mk_func_val(body)),
    .Some(name) => assert(name == String.from("__yo_op_add"), "add returned"),
    .None => assert(false, "expected Some")
  );
});
test("is_function_value_with_only_builtin_yo_inline_function_call: begin-wrapped inline body", {
  // Inner: `__yo_op_eq(a, b)`. Outer: `begin(inner)`.
  inner := mk_call_2_atoms("__yo_op_eq", "a", "b");
  inner_args := ArrayList(AstExpr).new();
  inner_args.push(inner);
  body := AstExpr.FnCall(
    usize(0),
    box(
      AstExpr.Atom(
        usize(0),
        Token(
          kind : TokenKind.Identifier,
          value : String.from("begin"),
          row : usize(0),
          column : usize(0),
          character : usize(0),
          module_path : String.from(""),
          input : String.from("")
        )
      )
    ),
    inner_args,
    false,
    Token(
      kind : TokenKind.Identifier,
      value : String.from("begin"),
      row : usize(0),
      column : usize(0),
      character : usize(0),
      module_path : String.from(""),
      input : String.from("")
    )
  );
  match(
    is_function_value_with_only_builtin_yo_inline_function_call(mk_func_val(body)),
    .Some(name) => assert(name == String.from("__yo_op_eq"), "eq via begin"),
    .None => assert(false, "expected Some")
  );
});
test("is_function_value_with_only_builtin_yo_inline_function_call: __yo_as is excluded", {
  // Even though __yo_as is in BuiltinYoInlineFunctions, the predicate
  // returns None for it because the codegen needs proper call-site
  // handling of its argument expressions.
  body := mk_call_2_atoms("__yo_as", "v", "T");
  assert(
    is_function_value_with_only_builtin_yo_inline_function_call(mk_func_val(body)).is_none(),
    "__yo_as → None"
  );
});
test("is_function_value_with_only_builtin_yo_inline_function_call: non-inline body → None", {
  body := mk_call_2_atoms("foo", "a", "b");
  assert(
    is_function_value_with_only_builtin_yo_inline_function_call(mk_func_val(body)).is_none(),
    "user fn → None"
  );
});
test("is_function_value_with_only_builtin_yo_inline_function_call: non-FuncVal → None", {
  assert(
    is_function_value_with_only_builtin_yo_inline_function_call(EvalValue.UnitVal).is_none(),
    "UnitVal → None"
  );
  assert(
    is_function_value_with_only_builtin_yo_inline_function_call(EvalValue.BoolVal(true)).is_none(),
    "BoolVal → None"
  );
});
