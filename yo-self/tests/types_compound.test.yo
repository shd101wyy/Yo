/// Tests for compound TypeValue construction, stringification, compatibility,
/// and the substitution engine (Phase 2b).
open(import("std/collections/array_list"));
open(import("std/string"));
open(import("std/fmt"));
{ TypeValue } :: import("../types/definitions.yo");
{ t_func_simple, t_trait, t_trait_simple, t_module, t_module_simple, t_some_t, t_ptr, t_i32, t_bool, t_unit, t_usize, t_dyn, t_dyn_simple, type_value_tag } :: import("../types/creators.yo");
{ is_function_type, is_trait_type, is_module_type, is_some_type } :: import("../types/guards.yo");
{ TypeTag } :: import("../types/tags.yo");
{ type_to_string } :: import("../types/string.yo");
{ are_types_compatible } :: import("../types/compatibility.yo");
{ assert, panic } :: import("std/assert");
{ Substitution, subst_new, subst_add, subst_lookup, substitute, substitute_all }
:: import("../types/substitution.yo");
// Helper: assert two Strings are equal, printing both on failure.
check_str :: (fn(actual : String, expected : String, label : str) -> unit)(
  if(actual == expected, (), {
    println(`FAIL [${label}]: expected "${expected}", got "${actual}"`);
    assert(false, label);
  })
);
// ---------------------------------------------------------------------------
// t_func_simple — construction, tag, predicate
// ---------------------------------------------------------------------------
test("t_func_simple: no params", {
  f := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_unit());
  assert(is_function_type(f), "should be function type");
  assert(type_value_tag(f) == TypeTag.TFunction, "tag must be TFunction");
});
test("t_func_simple: one param", {
  labels := ArrayList(String).new();
  types := ArrayList(TypeValue).new();
  labels.push(`x`);
  types.push(t_i32());
  f := t_func_simple(labels, types, t_bool());
  assert(is_function_type(f), "should be function type");
  s := type_to_string(f);
  check_str(s, `fn(x : i32) -> bool`, "t_func_simple: one param");
});
test("t_func_simple: two params", {
  labels := ArrayList(String).new();
  types := ArrayList(TypeValue).new();
  labels.push(`a`);
  types.push(t_i32());
  labels.push(`b`);
  types.push(t_bool());
  f := t_func_simple(labels, types, t_unit());
  s := type_to_string(f);
  check_str(s, `fn(a : i32, b : bool) -> unit`, "t_func_simple: two params");
});
test("t_func_simple: unlabeled params", {
  labels := ArrayList(String).new();
  types := ArrayList(TypeValue).new();
  labels.push(String.from(""));
  types.push(t_i32());
  labels.push(String.from(""));
  types.push(t_bool());
  f := t_func_simple(labels, types, t_unit());
  s := type_to_string(f);
  check_str(s, `fn(i32, bool) -> unit`, "t_func_simple: unlabeled");
});
// ---------------------------------------------------------------------------
// t_trait_simple / t_trait
// ---------------------------------------------------------------------------
test("t_trait_simple: tag and predicate", {
  tr := t_trait_simple(`Eq`);
  assert(is_trait_type(tr), "should be trait type");
  assert(type_value_tag(tr) == TypeTag.TTrait, "tag must be TTrait");
});
test("t_trait_simple: string", {
  tr := t_trait_simple(`Clone`);
  s := type_to_string(tr);
  check_str(s, `Clone`, "t_trait_simple: string");
});
test("t_trait: with fields", {
  fls := ArrayList(String).new();
  fts := ArrayList(TypeValue).new();
  fls.push(`next`);
  fts.push(t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_i32()));
  tr := t_trait(`Iterator`, ArrayList(String).new(), fls, fts);
  s := type_to_string(tr);
  // Named traits print just the name (mirrors TS typeToString printing
  // "Send"); the field dump is the fallback for anonymous traits only.
  check_str(s, `Iterator`, "t_trait: with fields");
});
// ---------------------------------------------------------------------------
// t_module_simple / t_module
// ---------------------------------------------------------------------------
test("t_module_simple: tag and predicate", {
  m := t_module_simple(`Io`);
  assert(is_module_type(m), "should be module type");
  assert(type_value_tag(m) == TypeTag.TModule, "tag must be TModule");
});
test("t_module_simple: string (no fields)", {
  m := t_module_simple(`Io`);
  s := type_to_string(m);
  check_str(s, `module Io`, "t_module_simple: string");
});
test("t_module: string with fields", {
  fls := ArrayList(String).new();
  fts := ArrayList(TypeValue).new();
  fls.push(`read`);
  fts.push(t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_i32()));
  m := t_module(`FS`, fls, fts);
  s := type_to_string(m);
  check_str(s, `module FS(read : fn() -> i32)`, "t_module: with fields");
});
// ---------------------------------------------------------------------------
// t_some_t
// ---------------------------------------------------------------------------
test("t_some_t: tag and predicate", {
  tv := t_some_t(`T`, usize(0));
  assert(is_some_type(tv), "should be some type");
  assert(type_value_tag(tv) == TypeTag.TSomeType, "tag must be TSomeType");
});
test("t_some_t: string (unconstrained)", {
  tv := t_some_t(`T`, usize(0));
  s := type_to_string(tv);
  check_str(s, `T`, "t_some_t: string unconstrained");
});
// ---------------------------------------------------------------------------
// are_types_compatible — Func
// ---------------------------------------------------------------------------
test("compat: identical func types", {
  ls := ArrayList(String).new();
  ts := ArrayList(TypeValue).new();
  ls.push(`x`);
  ts.push(t_i32());
  f1 := t_func_simple(ls, ts, t_bool());
  ls2 := ArrayList(String).new();
  ts2 := ArrayList(TypeValue).new();
  ls2.push(`x`);
  ts2.push(t_i32());
  f2 := t_func_simple(ls2, ts2, t_bool());
  assert(are_types_compatible(f1, f2), "same func types should be compatible");
});
test("compat: func param count mismatch", {
  ls1 := ArrayList(String).new();
  ts1 := ArrayList(TypeValue).new();
  ls1.push(`x`);
  ts1.push(t_i32());
  f1 := t_func_simple(ls1, ts1, t_bool());
  f2 := t_func_simple(ArrayList(String).new(), ArrayList(TypeValue).new(), t_bool());
  assert(!(are_types_compatible(f1, f2)), "different param counts should not be compatible");
});
test("compat: func return(type mismatch)", {
  ls := ArrayList(String).new();
  ts := ArrayList(TypeValue).new();
  ls.push(`x`);
  ts.push(t_i32());
  f1 := t_func_simple(ls, ts, t_bool());
  ls2 := ArrayList(String).new();
  ts2 := ArrayList(TypeValue).new();
  ls2.push(`x`);
  ts2.push(t_i32());
  f2 := t_func_simple(ls2, ts2, t_i32());
  assert(!(are_types_compatible(f1, f2)), "different return(types should not be compatible)");
});
// ---------------------------------------------------------------------------
// are_types_compatible — TraitT / ModuleT / SomeT
// ---------------------------------------------------------------------------
test("compat: same trait name", {
  t1 := t_trait_simple(`Eq`);
  t2 := t_trait_simple(`Eq`);
  assert(are_types_compatible(t1, t2), "same trait should be compatible");
});
test("compat: different trait names", {
  t1 := t_trait_simple(`Eq`);
  t2 := t_trait_simple(`Ord`);
  assert(!(are_types_compatible(t1, t2)), "different traits should not be compatible");
});
test("compat: same module name", {
  m1 := t_module_simple(`Io`);
  m2 := t_module_simple(`Io`);
  assert(are_types_compatible(m1, m2), "same module should be compatible");
});
test("compat: SomeT identity", {
  s1 := t_some_t(`T`, usize(1));
  s2 := t_some_t(`T`, usize(1));
  assert(are_types_compatible(s1, s2), "same SomeT should be compatible");
});
test("compat: SomeT different level", {
  s1 := t_some_t(`T`, usize(0));
  s2 := t_some_t(`T`, usize(1));
  assert(!(are_types_compatible(s1, s2)), "different frame levels should not be compatible");
});
// ---------------------------------------------------------------------------
// Substitution engine
// ---------------------------------------------------------------------------
test("subst_lookup: not found", {
  s := subst_new();
  result := subst_lookup(s, `T`, usize(0));
  match(
    result,
    .Some(_) => assert(false, "should not find"),
    .None => ()
  );
});
test("subst_lookup: found after add", {
  s := subst_new();
  subst_add(s, `T`, usize(0), t_i32());
  result := subst_lookup(s, `T`, usize(0));
  match(
    result,
    .Some(t) => assert(are_types_compatible(t, t_i32()), "should be i32"),
    .None => assert(false, "should be found")
  );
});
test("subst_add: overwrite existing", {
  s := subst_new();
  subst_add(s, `T`, usize(0), t_i32());
  subst_add(s, `T`, usize(0), t_bool());
  result := subst_lookup(s, `T`, usize(0));
  match(
    result,
    .Some(t) => assert(are_types_compatible(t, t_bool()), "should be bool after overwrite"),
    .None => assert(false, "should be found")
  );
});
test("substitute: SomeT replaced", {
  s := subst_new();
  subst_add(s, `T`, usize(0), t_i32());
  tv := t_some_t(`T`, usize(0));
  res := substitute(s, tv);
  assert(are_types_compatible(res, t_i32()), "SomeT should be replaced with i32");
});
test("substitute: SomeT not in subst unchanged", {
  s := subst_new();
  tv := t_some_t(`U`, usize(0));
  res := substitute(s, tv);
  assert(are_types_compatible(res, tv), "unreferenced SomeT should be unchanged");
});
test("substitute: primitive unchanged", {
  s := subst_new();
  subst_add(s, `T`, usize(0), t_i32());
  res := substitute(s, t_bool());
  assert(are_types_compatible(res, t_bool()), "primitive should be unchanged");
});
test("substitute: nested in pointer", {
  s := subst_new();
  subst_add(s, `T`, usize(0), t_i32());
  tv := t_ptr(t_some_t(`T`, usize(0)));
  res := substitute(s, tv);
  assert(are_types_compatible(res, t_ptr(t_i32())), "SomeT inside pointer should be replaced");
});
test("substitute: inside func param", {
  s := subst_new();
  subst_add(s, `T`, usize(0), t_i32());
  ls := ArrayList(String).new();
  ts := ArrayList(TypeValue).new();
  ls.push(`x`);
  ts.push(t_some_t(`T`, usize(0)));
  f := t_func_simple(ls, ts, t_some_t(`T`, usize(0)));
  res := substitute(s, f);
  ls2 := ArrayList(String).new();
  ts2 := ArrayList(TypeValue).new();
  ls2.push(`x`);
  ts2.push(t_i32());
  expected := t_func_simple(ls2, ts2, t_i32());
  assert(are_types_compatible(res, expected), "SomeT in func should be substituted");
});
test("substitute_all: list of types", {
  s := subst_new();
  subst_add(s, `T`, usize(0), t_bool());
  tys := ArrayList(TypeValue).new();
  tys.push(t_some_t(`T`, usize(0)));
  tys.push(t_i32());
  res := substitute_all(s, tys);
  assert(res.len() == usize(2), "length should be 2");
  t0 := match(res.get(usize(0)),.Some(t) => t,.None => t_unit());
  t1 := match(res.get(usize(1)),.Some(t) => t,.None => t_unit());
  assert(are_types_compatible(t0, t_bool()), "first should be bool");
  assert(are_types_compatible(t1, t_i32()), "second should be i32");
});
// ---------------------------------------------------------------------------
// DynT — construction and tag (Phase 2ar)
// ---------------------------------------------------------------------------
test("t_dyn_simple: single trait", {
  required := ArrayList(TypeValue).new();
  required.push(t_trait_simple(`Eq`));
  d := t_dyn_simple(required);
  assert(type_value_tag(d) == TypeTag.TDyn, "tag should be TDyn");
});
test("t_dyn_simple: empty list still constructs", {
  required := ArrayList(TypeValue).new();
  d := t_dyn_simple(required);
  assert(type_value_tag(d) == TypeTag.TDyn, "tag should be TDyn even with no required traits");
});
test("t_dyn: required + negative traits", {
  required := ArrayList(TypeValue).new();
  required.push(t_trait_simple(`Eq`));
  req_levels := ArrayList(usize).new();
  req_levels.push(usize(0));
  negative := ArrayList(TypeValue).new();
  negative.push(t_trait_simple(`Send`));
  neg_levels := ArrayList(usize).new();
  neg_levels.push(usize(0));
  d := t_dyn(required, req_levels, negative, neg_levels);
  assert(type_value_tag(d) == TypeTag.TDyn, "tag should be TDyn");
  // Pattern-match to verify shape (catches arity drift).
  ok := match(
    d,
    .DynT(req, _, neg, _) => ((req.len() == usize(1)) && (neg.len() == usize(1))),
    _ => false
  );
  assert(ok, "DynT should carry 1 required + 1 negative trait");
});
