    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 0+1+1+2+3+5+8+13=33
  src := "sa := i32(0);\nsb := i32(1);\nss := i32(0);\nsi := i32(0);\nss = (ss + sa);\nwhile((si < i32(7)), {\nst := sb;\nsb = (sa + sb);\nsa = st;\nss = (ss + sa);\nsi = (si + i32(1));\n});\nexport(ss);\n";
