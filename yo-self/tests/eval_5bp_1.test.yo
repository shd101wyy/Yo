});

// ---------------------------------------------------------------------------
// Phase 5bpd — grand combo tests
// ---------------------------------------------------------------------------
test("Phase 5bpd: char-sum + GCD(48,36) + F(10) grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 294+12+55=361
  src := "chars := [i32(97),i32(98),i32(99)];\nchar_sum := chars.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nga := i32(48);\ngb := i32(36);\nwhile((gb != i32(0)), {\ngt := gb;\ngb = (ga % gb);\nga = gt;\n});\nfa := i32(0);\nfb := i32(1);\nfi := i32(0);\nwhile((fi < i32(10)), {\nft := fb;\nfb = (fa + fb);\nfa = ft;\nfi = (fi + i32(1));\n});\ntotal := ((char_sum + ga) + fa);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "361", "361"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
