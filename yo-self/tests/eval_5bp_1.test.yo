// ---------------------------------------------------------------------------
// Phase 5bpc — Fibonacci sequences and triangular numbers
// ---------------------------------------------------------------------------
test("Phase 5bpc: Fibonacci F(10) = 55", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // F(0)=0,F(1)=1,...,F(10)=55
  src := "fa := i32(0);\nfb := i32(1);\nfi := i32(0);\nwhile((fi < i32(10)), {\nft := fb;\nfb = (fa + fb);\nfa = ft;\nfi = (fi + i32(1));\n});\nexport(fa);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "55", "55"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bpc: sum of Fibonacci numbers F(0)..F(7)", {
  env := empty_env();
