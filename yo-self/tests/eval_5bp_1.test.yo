test("Phase 5bpe: Collatz(6) + LCM(12,18) + T(8) grand combo", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 8+36+36=80
  src := "cn := i32(6);\ncsteps := i32(0);\nwhile((cn != i32(1)), {\ncn = cond(((cn % i32(2)) == i32(0)) => (cn / i32(2)), true => ((i32(3) * cn) + i32(1)));\ncsteps = (csteps + i32(1));\n});\nla := i32(12);\nlb := i32(18);\nlga := i32(12);\nlgb := i32(18);\nwhile((lgb != i32(0)), {\nlt := lgb;\nlgb = (lga % lgb);\nlga = lt;\n});\nlcm := ((la * lb) / lga);\nts := i32(0);\nti := i32(1);\nwhile((ti <= i32(8)), {\nts = (ts + ti);\nti = (ti + i32(1));\n});\ntotal := ((csteps + lcm) + ts);\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
