// @skip_wasm32-emscripten
// @skip_wasm32-wasi
open(import("std/fmt"));
open(import("std/error"));
{ Environment } :: import("../env/env.yo");
{ EvalValue, EvalResult } :: import("../evaluator/value.yo");
{ evaluate_module_body } :: import("../evaluator/eval.yo");
{ generate_exprs_from_code } :: import("../parser/parser.yo");
empty_env :: (fn() -> Environment)(Environment.new(`test`));

// ---------------------------------------------------------------------------
// Phase 5bpa — char arrays, vowel counting, GCD, LCM
// ---------------------------------------------------------------------------
test("Phase 5bpa: sum of ASCII values of [97,98,99] (a,b,c)", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 97+98+99=294
  src := "chars := [i32(97),i32(98),i32(99)];\ntotal := chars.fold(i32(0), (fn(acc : i32, x : i32) -> i32)((acc + x)));\nexport(total);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "294", "294"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bpa: count vowels in [97,101,105,111,117,98,99]", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // vowels a=97,e=101,i=105,o=111,u=117 → count=5
  src := "chars := [i32(97),i32(101),i32(105),i32(111),i32(117),i32(98),i32(99)];\ncnt := chars.filter((fn(c : i32) -> bool)(cond((c == i32(97)) => true, (c == i32(101)) => true, (c == i32(105)) => true, (c == i32(111)) => true, (c == i32(117)) => true, true => false))).fold(i32(0), (fn(acc : i32, c_unused : i32) -> i32)((acc + i32(1))));\nexport(cnt);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "5", "5"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bpa: GCD(48, 36) via Euclidean algorithm", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // GCD(48,36)=12
  src := "ga := i32(48);\ngb := i32(36);\nwhile((gb != i32(0)), {\ngt := gb;\ngb = (ga % gb);\nga = gt;\n});\nexport(ga);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "12", "12"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
test("Phase 5bpa: LCM(12, 18) via GCD", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // GCD(12,18)=6; LCM=12*18/6=36
  src := "la := i32(12);\nlb := i32(18);\nlga := i32(12);\nlgb := i32(18);\nwhile((lgb != i32(0)), {\nlt := lgb;\nlgb = (lga % lgb);\nlga = lt;\n});\nlcm := ((la * lb) / lga);\nexport(lcm);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "36", "36"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});

// ---------------------------------------------------------------------------
// Phase 5bpb — Collatz steps, digit sums/products
// ---------------------------------------------------------------------------
test("Phase 5bpb: Collatz sequence steps from 6 to 1", {
  env := empty_env();
  given(exn) := Exception(
    throw : (
      (err) -> {
        assert(false, "e");
        escape(());
      }
    )
  );
  // 6→3→10→5→16→8→4→2→1 = 8 steps
  src := "cn := i32(6);\ncsteps := i32(0);\nwhile((cn != i32(1)), {\ncn = cond(((cn % i32(2)) == i32(0)) => (cn / i32(2)), true => ((i32(3) * cn) + i32(1)));\ncsteps = (csteps + i32(1));\n});\nexport(csteps);\n";
  exprs := generate_exprs_from_code(src, using(exn));
  result := evaluate_module_body(exprs, &(env));
  match(
    result,
    .None => assert(false, "N"),
    .Some(m) => match(
      m,
      .ModuleVal(_, v) => {
        match(
          v.get(usize(0)),
          .Some(x) => match(x,.IntLit(n) => assert(n.as_str() == "8", "8"), _ => assert(false, "t")),
          .None => assert(false, "v")
        );
      },
      _ => assert(false, "m")
    )
  );
});
