//! function_value.yo — FunctionValue-adjacent helpers for the self-hosted compiler.
//!
//! 1-to-1 port of `src/function-value.ts`.
//!
//! In TypeScript, `FunctionValue` is an interface with fields like
//! `isControlFunction` and `definitionSiteEnclosingFunctionType`. In yo-self
//! the corresponding shape is the `EvalValue.FuncVal` variant defined in
//! `value.yo`, which doesn't currently carry those two optional fields.
//!
//! This file holds the side-table machinery that emulates those fields:
//!   * `mark_as_control_fn` / `is_control_fn`           — backs `isControlFunction`
//!   * `register_definition_site_return`                — backs
//!     `definitionSiteEnclosingFunctionType.return.type`
//!   * `get_definition_site_return`                     — accessor with
//!     `t_unit()` fallback (mirrors the `?? createUnitType()` pattern in
//!     `evaluateCtlFunctionBodyInline` at `src/evaluator/calls/helper.ts`)
//!
//! Both registries are keyed by `func_id : String` (the unique
//! `FuncValueId` from src/function-value.ts).
open(import("std/string"));
{ HashMap } :: import("std/collections/hash_map");
{ Frame } :: import("./env.yo");
{ TypeValue } :: import("./types/definitions.yo");
{ t_unit } :: import("./types/creators.yo");
// ---------------------------------------------------------------------------
// isControlFunction side-table
// ---------------------------------------------------------------------------
/// Global map from `func_id` → `true` (only entries for control functions exist).
(g_control_fn_registry : HashMap(String, bool)) = HashMap(String, bool).new();
/// Mark a function as a control function (uses `unwind`).
/// Idempotent: calling multiple times with the same id is safe.
///
/// Mirrors setting `functionValue.isControlFunction = true` in TypeScript.
mark_as_control_fn :: (fn(func_id : String) -> unit)({
  g_control_fn_registry.set(func_id.clone(), true);
});
/// Returns true if the function identified by `func_id` is a control function.
///
/// Mirrors reading `functionValue.isControlFunction` in TypeScript.
is_control_fn :: (fn(func_id : String) -> bool)(
  match(
    g_control_fn_registry.get(func_id.clone()),
    .Some(_) => true,
    .None => false
  )
);
// ---------------------------------------------------------------------------
// isClosure side-table
// ---------------------------------------------------------------------------
/// Global map from `func_id` → `true` (only entries for closure functions exist).
/// Mirrors `FunctionType.isClosure` in TS — yo-self's flattened `Func` variant has
/// no such field, so the marker is side-tabled by id (same pattern as the
/// control-fn / default-args / func-type registries). Set when an anon-fn is typed
/// as a closure (`evaluator/calls/closure_type.yo`); read by the codegen
/// function-emission driver to prepend the `void* closure_context` capture param
/// (declarations.ts:405).
(g_closure_fn_registry : HashMap(String, bool)) = HashMap(String, bool).new();
/// Mark a function (by `func_id`) as a closure. Idempotent.
mark_as_closure_fn :: (fn(func_id : String) -> unit)({
  g_closure_fn_registry.set(func_id.clone(), true);
});
/// True if the function identified by `func_id` is a closure (takes a capture
/// context as its first C parameter). Mirrors reading `functionType.isClosure`.
is_closure_fn :: (fn(func_id : String) -> bool)(
  match(
    g_closure_fn_registry.get(func_id.clone()),
    .Some(_) => true,
    .None => false
  )
);
// ---------------------------------------------------------------------------
// Closure capture info side-table (func_id → capture struct type + frame level)
// ---------------------------------------------------------------------------
/// A closure's capture-struct type + the frame level of its defining scope.
/// `generate_function` uses these to set the closure-capture codegen context so
/// the atom emitter rewrites a captured variable `base` to
/// `((<cap>*)closure_context)->base` (`current_closure_capture_type_c_name` +
/// `current_closure_captures` from the struct's field labels +
/// `current_closure_capture_frame_level`). Recorded in
/// `evaluate_anonymous_function_implementation` for io.async closures.
ClosureCaptureInfo :: ref(struct(capture_type : TypeValue, frame_level : usize));
(g_closure_capture_info : HashMap(String, ClosureCaptureInfo)) = HashMap(String, ClosureCaptureInfo).new();
/// Record a closure's capture-struct type + defining frame level, by func_id.
register_closure_capture_info :: (fn(func_id : String, info : ClosureCaptureInfo) -> unit)({
  g_closure_capture_info.set(func_id.clone(), info);
});
/// The recorded capture info for `func_id`, if any.
get_closure_capture_info :: (fn(func_id : String) -> Option(ClosureCaptureInfo))(
  g_closure_capture_info.get(func_id.clone())
);
// ---------------------------------------------------------------------------
// isEffectRecordMember side-table (codegen)
// ---------------------------------------------------------------------------
/// Global map from `func_id` → `true` for functions that are effect-record
/// members (e.g. `Exception.throw` handlers) and so must be emitted as
/// standalone C functions. Mirrors the `functionValue.isEffectRecordMember`
/// flag that TS codegen MUTATES onto the value during function collection;
/// yo-self's `FuncVal` is an immutable enum variant, so the mark lives here.
(g_effect_record_member_registry : HashMap(String, bool)) = HashMap(String, bool).new();
/// Mark a function (by func_id) as an effect-record member. Idempotent.
mark_as_effect_record_member :: (fn(func_id : String) -> unit)({
  g_effect_record_member_registry.set(func_id.clone(), true);
});
/// Returns true if the function identified by `func_id` is an effect-record member.
is_effect_record_member :: (fn(func_id : String) -> bool)(
  match(
    g_effect_record_member_registry.get(func_id.clone()),
    .Some(_) => true,
    .None => false
  )
);
// ---------------------------------------------------------------------------
// definitionSiteEnclosingFunctionType side-table
// ---------------------------------------------------------------------------
/// Global map from `func_id` → return type of the enclosing function at the
/// definition site. Only the return-type portion is stored, since that is
/// the only field used by `evaluateCtlFunctionBodyInline`:
///   `originalFunction.definitionSiteEnclosingFunctionType?.return.type ?? createUnitType()`
(g_definition_site_return_registry : HashMap(String, TypeValue)) =
  HashMap(String, TypeValue).new();
/// Global map from `func_id` → the function's own resolved `Func` TypeValue
/// (the full signature: forall/param/implicit/where types + result + flags).
/// Codegen needs this to emit a function's C prototype, but the registered
/// `FuncVal` carries only param-NAME strings (not structured types) and
/// `type_of_eval_value(FuncVal)` returns unit — so the type is recorded here at
/// function-definition time, where it is known. Resolves Gap 10
/// (issues/codegen-port-type-model-gaps.md): the function-emission driver
/// (functions/generation.ts) reads `get_func_type(func_id)` to build the prototype.
(g_func_type_registry : HashMap(String, TypeValue)) =
  HashMap(String, TypeValue).new();
/// Register the enclosing function's return type at a function's definition site.
///
/// Called when creating a FuncVal (in `evaluator/values/anonymous_function.yo`)
/// if the function is defined inside another function body.
///
/// Mirrors setting `functionValue.definitionSiteEnclosingFunctionType = ...`
/// in `src/evaluator/values/anonymous-function.ts`.
register_definition_site_return :: (fn(func_id : String, return_ty : TypeValue) -> unit)({
  g_definition_site_return_registry.set(func_id.clone(), return_ty);
});
/// Get the enclosing function's return type at a function's definition site.
/// Returns `t_unit()` if the function was not defined inside another function
/// body (e.g., top-level definitions, handlers defined in test blocks).
///
/// Mirrors the `?? createUnitType()` fallback in
/// `src/evaluator/calls/helper.ts:evaluateCtlFunctionBodyInline`.
get_definition_site_return :: (fn(func_id : String) -> TypeValue)(
  match(
    g_definition_site_return_registry.get(func_id.clone()),
    .Some(ty) => ty,
    .None => t_unit()
  )
);
/// Record a function's own resolved `Func` type by func_id (called when the
/// FuncVal is created). Resolves Gap 10 for the codegen function-emission driver.
register_func_type :: (fn(func_id : String, func_ty : TypeValue) -> unit)({
  g_func_type_registry.set(func_id.clone(), func_ty);
});
/// The recorded `Func` type for `func_id`, or `t_unit()` if none was registered.
get_func_type :: (fn(func_id : String) -> TypeValue)(
  match(
    g_func_type_registry.get(func_id.clone()),
    .Some(ty) => ty,
    .None => t_unit()
  )
);
// ---------------------------------------------------------------------------
// parametersFrame side-table (STAGED for def-time body evaluation)
// ---------------------------------------------------------------------------
/// Global map from `func_id` (the `fn(...)` type-expression id) → the parameter-
/// bound `Frame` produced while evaluating the function's parameters.
///
/// TS carries this directly on the function type as `FunctionType.parametersFrame`
/// (`src/types/definitions.ts:877`) and pushes it before body eval
/// (`function-type.ts:380` `pushEnvFrame(env, functionType.parametersFrame)`), so
/// `Self`/trait params like `Idx` are BOUND when the body is type-checked. yo-self's
/// `Func` TypeValue is flattened to parallel arrays with no frame field — putting
/// `Frame` (from env.yo) on `Func` (in definitions.yo) would create a
/// definitions↔env import cycle — so the bound frame is side-tabled here by id,
/// the same pattern as the macro / default-args side-tables.
///
/// STAGED, NOT YET CONSUMED: the capture (in `evaluate_function_type`, immediately
/// after `evaluate_function_parameters`) and the push (in
/// `try_to_implement_function_by_function_type` before body eval) are part of the
/// def-time body-eval wiring — the remaining multi-layer work
/// (plans/DEFTIME_BODY_EVAL.md). This is the proven storage API for that push.
(g_func_parameters_frame : HashMap(String, Frame)) = HashMap(String, Frame).new();
/// Store the parameter-bound frame for a function, keyed by its `fn(...)`
/// type-expression id. (Capture timing is critical — see DEFTIME_BODY_EVAL.md.)
register_func_parameters_frame :: (fn(func_id : String, frame : Frame) -> unit)({
  g_func_parameters_frame.set(func_id.clone(), frame);
});
/// Retrieve a function's parameter-bound frame, if captured.
get_func_parameters_frame :: (fn(func_id : String) -> Option(Frame))(
  g_func_parameters_frame.get(func_id.clone())
);
export(
  mark_as_control_fn,
  is_control_fn,
  mark_as_closure_fn,
  is_closure_fn,
  ClosureCaptureInfo,
  register_closure_capture_info,
  get_closure_capture_info,
  mark_as_effect_record_member,
  is_effect_record_member,
  register_definition_site_return,
  get_definition_site_return,
  register_func_type,
  get_func_type,
  register_func_parameters_frame,
  get_func_parameters_frame
);
