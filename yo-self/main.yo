//! yo-self — Phase 5b CLI entry point for the self-hosted Yo compiler.
//!
//! Usage:
//!   yo-self compile <input.yo> [-o output]
//!   yo-self test <test.yo> [--test-name-pattern <pattern>]
//!
//! compile: Reads a `.yo` source file, parses it with the self-hosted parser,
//!   generates C11 with compile_module_to_c, writes C to a temp file,
//!   compiles it with the system C compiler, and produces an output binary.
//!
//! test: Parses a `.test.yo` file, extracts `test("name", { body })` declarations,
//!   compiles each test body to a standalone C program, and reports pass/fail.
//!   Only supports pure tests (no Io effects, no struct methods) in Phase 5b.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/error"));
open(import("std/fmt"));
{ args, cwd } :: import("std/env");
_(env : proc_env) :: import("std/env");
{ CURRENT_YO_VERSION, read_yo_version } :: import("./version.yo");
{
  cached_binary_path,
  is_version_cached,
  list_cached_versions,
  clean_version_cache,
  ensure_cached_version,
  fetch_remote_versions
} :: import("./version_cache.yo");
{ Regex } :: import("std/regex");
{ Path } :: import("std/path");
{ read_file, write_file, exists } :: import("std/fs/file");
{ metadata } :: import("std/fs/metadata");
{ read_dir, FileType, remove_file, create_dir_all } :: import("std/fs/dir");
{ Command } :: import("std/process/command");
{ exit } :: import("std/libc/stdlib");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, BK_OPEN, BK_IMPORT, BK_TEST, ast_expr_is_fn_call_of, ast_expr_to_string, make_err_expr } :: import("./expr.yo");
{ ExprInfoTable, expr_info_table_new } :: import("./expr_info.yo");
{ TokenKind } :: import("./token.yo");
{ parse } :: import("./parser.yo");
{ InitOptions, init_project } :: import("./init.yo");
{ get_global_cache_dir } :: import("./cache.yo");
{ FetchOptions, run_fetch } :: import("./fetch_command.yo");
{ InstallOptions, run_install } :: import("./install_command.yo");
{ BuildOptions, run_build } :: import("./build_runner.yo");
{ DocCommandOptions, run_doc } :: import("./doc_command.yo");
{ generate_unsafe_report, format_unsafe_report, unsafe_report_to_json } :: import("./unsafe_report.yo");
{ generate_public_safe_report, format_public_safe_report, public_safe_report_to_json } :: import("./public_safe_report.yo");
{ HashMap } :: import("std/collections/hash_map");
{ remove_dir_all } :: import("./fetch.yo");
{ Environment } :: import("./env.yo");
// The demand-driven module loader, the cached prelude env, the shared codegen
// ExprInfoTable and std-path resolution all live in `module_manager.yo` — the
// counterpart of TS's `src/module-manager.ts`. They used to be inline globals
// here, which meant every OTHER subcommand that needs to evaluate a `.yo` file
// (build, fetch, install, doc) would have had to grow its own copy.
{
  ModuleLoadOutcome,
  resolve_std_path,
  set_std_path_override,
  mm_clear_prelude_env,
  mm_set_shared_expr_info_table,
  mm_reset,
  mm_resolve_entry_abs,
  mm_eval_entry_exprs,
  mm_load_file,
  mm_preload_prelude
} :: import("./module_manager.yo");
{ eval_context_new } :: import("./evaluator/context.yo");
{ register_evaluate_expression } :: import("./evaluator/exprs/_expr.yo");
{ evaluate_anonymous_module_begin_exprs } :: import("./evaluator/values/anonymous_module.yo");
{ clear_module_cache } :: import("./evaluator/module_loader.yo");
{ format_yo_source, format_yo_files, FormatYoFilesOptions } :: import("./formatter.yo");
{ host_target, set_current_target, parse_target, TargetInfo, is_target_linux, is_target_windows, is_target_macos, is_target_wasm, is_target_standalone_wasi } :: import("./target.yo");
{ set_target_pointer_size } :: import("./types/utils.yo");
{ compile_module } :: import("./codegen/codegen_c.yo");
{ get_needs_intel_asm_syntax, get_uses_parallelism } :: import("./codegen/utils/index.yo");
{ panic, assert } :: import("std/assert");
// Temporary C source path used during compilation.
C_TMP :: "/tmp/yo_self_out.c";
extract_bare_import_path :: (fn(e : AstExpr) -> Option(String))(
  match(
    e,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, func_box, fn_imp_args, is_infix, _) => cond(
      is_infix => Option(String).None,
      (fn_imp_args.len() != usize(1)) => Option(String).None,
      (
        !(
          match(
            func_box,
            .Atom(_, tok) => (tok.value == BK_IMPORT),
            .FnCall(_, _, _, _, _) => false
          )
        )
      ) => Option(String).None,
      true => match(
        fn_imp_args.get(usize(0)),
        .None => Option(String).None,
        .Some(path_arg) => match(
          path_arg,
          .FnCall(_, _, _, _, _) => Option(String).None,
          .Atom(_, ptok) => {
            raw := ptok.value.clone();
            n := raw.len();
            cond(
              (n < usize(2)) => Option(String).None,
              true => .Some(raw.substring(usize(1), n - usize(1)))
            )
          }
        )
      )
    )
  )
);
/// Extract the import path from any import form:
///   - `{ Names } :: import("path")` (infix `::`, RHS is import call)
///   - `open(import("path"))` (`open` wrapping import call)
///   - `import("path")` (bare import call)
/// Returns the path without surrounding quotes, or .None if not an import expression.
extract_import_path :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, func_box, fn_imp_args, is_infix, _) => {
      fval := match(
        func_box,
        .Atom(_, tok) => tok.value.clone(),
        .FnCall(_, _, _, _, _) => String.new()
      );
      cond(
        // Pattern: open import "path"
        ((fval == BK_OPEN) && (fn_imp_args.len() >= usize(1))) =>
          match(
            fn_imp_args.get(usize(0)),
            .None => Option(String).None,
            .Some(inner) => extract_bare_import_path(inner)
          ),
        // Pattern: { Names } :: import "path" (infix ::)
        (((fval == "::") && is_infix) && (fn_imp_args.len() >= usize(2))) =>
          match(
            fn_imp_args.get(usize(1)),
            .None => Option(String).None,
            .Some(rhs) => extract_bare_import_path(rhs)
          ),
        // Pattern: bare import "path"
        true => extract_bare_import_path(expr)
      )
    }
  )
);
export(extract_bare_import_path, extract_import_path);
/// Recursively collect every `import(...)` path reachable from `expr`,
/// including imports NESTED inside `impl({...})` / module / `begin`
/// bodies. `extract_import_path` only inspects a single expression, so a
/// top-level-only walk misses e.g. `env :: impl({ { getenv, setenv } ::
/// import("./libc/stdlib"); ... })` — the import lives inside the impl
/// body, not at module top level. The preload step (main.yo) needs these
/// nested imports cached, otherwise `evaluate_import` fails with
/// "module not preloaded" when the impl body is evaluated.
///
/// Paths may appear more than once (e.g. a `{ ... } :: import(p)` node
/// yields `p`, and recursing into its `import(p)` child yields `p`
/// again); callers dedup by resolved path.
collect_import_paths_recursive :: (
  fn(expr : AstExpr, out : ArrayList(String)) -> unit
)({
  match(
    extract_import_path(expr),
    .Some(p) => {
      out.push(p);
    },
    .None => ()
  );
  match(
    expr,
    .Atom(_, _) => (),
    .FnCall(_, fb, walk_args, _, _) => {
      recur(fb, out);
      (i : usize) = usize(0);
      while(i < walk_args.len(), {
        match(
          walk_args.get(i),
          .Some(a) => recur(a, out),
          .None => ()
        );
        i = (i + usize(1));
      });
    }
  );
});
export(collect_import_paths_recursive);
// Temporary binary path used for test execution.
TEST_BIN_TMP :: "/tmp/yo_self_test_bin";
/// Derive a simple module ID string from a file path String.
/// For Phase 5a/5b: returns a fixed safe C identifier — sufficient for compilation.
module_id_from_path :: (fn(path : String) -> String)(
  // path reserved for future use (filename stem extraction)
  String.from("yo_module")
);
/// Stream A: try to populate the typed AST metadata table by running the
/// proper evaluator over the parsed top-level expressions. On any failure
/// (the evaluator's coverage of real source files is still incomplete),
/// return `.None` so the codegen dispatcher uses its AST-only bootstrap
/// heuristics. See `plans/BOOTSTRAPPING.md` Path Forward Stream A.
try_populate_expr_info_table :: (
  fn(
    exprs : ArrayList(AstExpr),
    module_path : String
  ) -> Option(ExprInfoTable)
)({
  // Local exception handler: on any throw from the evaluator, unwind this
  // helper with `.None`. The handler is scoped to this function so the
  // outer compile / test pipeline keeps its own top-level handler intact.
  local_exn := Exception(
    throw : (
      (_err) -> unwind(Option(ExprInfoTable).None)
    )
  );
  // Build a fresh Environment + EvalContext for this compilation. std_path
  // is resolved from `YO_STD` (or `./std` fallback) so the modular import
  // handler can find `std/...` modules. The local exception unwind catches
  // any evaluator coverage gap (e.g. unported HKT/RC features in prelude).
  env := Environment.new(module_path);
  ctx := eval_context_new(resolve_std_path(), module_path);
  ctx.is_executing = true;
  // Wire the proper expression-evaluator function pointer.
  register_evaluate_expression();
  // Drive the module body through the proper evaluator. We discard the
  // returned AnonModuleResult and just keep the table that
  // `ctx.expr_info_table` accumulated as a side effect.
  _r := evaluate_anonymous_module_begin_exprs(
    exprs,
    env,
    ctx,
    false,
    false,
    local_exn
  );
  Option(ExprInfoTable).Some(ctx.expr_info_table)
});
/// Extract the test name string from a `test("name", { body })` expression.
/// Returns None if the expression is not a 2-arg test call.
extract_test_name :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, func_box, fn_args, is_infix, _) => cond(
      (is_infix) => Option(String).None,
      (fn_args.len() < usize(2)) => Option(String).None,
      (
        !(
          match(
            func_box,
            .Atom(_, ftok) => (ftok.value == "test"),
            .FnCall(_, _, _, _, _) => false
          )
        )
      ) => Option(String).None,
      true => match(
        fn_args.get(usize(0)),
        .None => Option(String).None,
        .Some(name_expr) => match(
          name_expr,
          .FnCall(_, _, _, _, _) => Option(String).None,
          .Atom(_, ntok) => cond(
            (ntok.kind == TokenKind.StringLit) => {
              // StringLit token values include surrounding double-quotes: "name"
              // Strip them with substring(1, len-1).
              n := ntok.value.len();
              cond(
                (n >= usize(2)) => .Some(ntok.value.substring(usize(1), n - usize(1))),
                true => .Some(ntok.value)
              )
            },
            true => Option(String).None
          )
        )
      )
    )
  )
);
/// Extract the test body expression from a `test("name", { body })` call.
/// Returns the second argument (the body expression).
extract_test_body :: (fn(expr : AstExpr) -> Option(AstExpr))(
  match(
    expr,
    .Atom(_, _) => Option(AstExpr).None,
    .FnCall(_, _, fn_args, _, _) => cond(
      (fn_args.len() < usize(2)) => Option(AstExpr).None,
      true => fn_args.get(usize(1))
    )
  )
);
// ---------------------------------------------------------------------------
// Phase 5g: import resolution helpers
// ---------------------------------------------------------------------------
/// Normalize an import path: append `.yo` if not already present.
normalize_import_path :: (fn(path_str : String) -> String)(
  cond(
    (path_str.ends_with(".yo") || path_str.ends_with(".test.yo")) => path_str.clone(),
    true => `${path_str}.yo`
  )
);
/// Recursively collect all transitive module declarations for a given import.
///
/// - `path_str`: unquoted import path (e.g. `"../types/tags.yo"`)
/// - `base_dir`: directory of the importing file (for relative path resolution)
/// - `visited`: pointer to set of already-visited absolute paths (deduplication)
/// - `all_exprs`: pointer to accumulator; declarations are appended in post-order
///
/// Skips `std/` imports — those are provided by the C preamble headers.
/// Uses DFS post-order so each module's dependencies appear before it.
collect_module_deps :: (
  fn(
    path_str : String,
    base_dir : String,
    std_base : String,
    visited : ArrayList(String),
    all_exprs : ArrayList(AstExpr),
    io : Io,
    exn : Exception
  ) -> unit
)({
  // Standard library imports: when std_base is empty, skip (legacy behavior —
  // codegen handles std symbols via the C preamble). When std_base is set,
  // rewrite `std/foo` → `{std_base}/foo` and follow it like a regular dep so
  // the evaluator can see prelude/std declarations.
  (effective_path : String) = path_str.clone();
  (effective_base : String) = base_dir.clone();
  if(path_str.starts_with("std/"), {
    if(std_base.bytes_len() == usize(0), {
      return(());
    });
    rest := path_str.substring(usize(4), path_str.len());
    effective_path = rest.clone();
    effective_base = std_base.clone();
  });
  // Normalize extension: append .yo if missing
  norm_path := normalize_import_path(effective_path.clone());
  // Resolve absolute path by normalizing base_dir/norm_path as one string.
  // Path.new normalizes ".." segments, which is needed for relative imports like "../types/tags.yo".
  // (Path.join does NOT re-normalize ".." in the second argument.)
  abs_path_raw := Path.new(`${effective_base}/${norm_path}`).to_string();
  // When std_base is empty, also skip paths that resolve into std/ (e.g.
  // relative imports like "../string" from within std/imm/). With std_base
  // set, std/ resolves into std_base and these paths should be followed.
  if((std_base.bytes_len() == usize(0)) &&
    abs_path_raw.clone().starts_with(String.from("std/")), {
    return(());
  });
  // Handle directory modules: if path.yo doesn't exist but path/index.yo does, use the latter.
  (abs_path : String) = abs_path_raw.clone();
  (file_found : bool) = io.await(exists(Path.new(abs_path_raw.clone()), io), io);
  if(!(file_found), {
    // Strip the trailing .yo (3 chars) to get the base name, then try index.yo
    base_len := abs_path_raw.len();
    base_no_ext := abs_path_raw.substring(usize(0), base_len - usize(3));
    index_path := `${base_no_ext}/index.yo`;
    index_found := io.await(exists(Path.new(index_path), io), io);
    cond(
      index_found => {
        abs_path = index_path;
      },
      true => {
        return(());
      }
    );
  });
  // Deduplication: skip if already visited (also handles import cycles)
  nv := visited.len();
  (iv : usize) = usize(0);
  (already_visited : bool) = false;
  while((iv < nv) && (!(already_visited)), {
    iv = (iv + usize(1));
    match(
      visited.get(iv - usize(1)),
      .None => (),
      .Some(v) => {
        if(v == abs_path, {
          already_visited = true;
        });
      }
    );
  });
  if(already_visited, {
    return(());
  });
  // Mark as visited before recursing (prevents infinite loops on cycles)
  visited.push(abs_path.clone());
  // Compute the base directory of the imported module for recursive resolution
  mod_base_dir := match(
    Path.new(abs_path.clone()).parent(),
    .None => String.from("."),
    .Some(p) => p.to_string()
  );
  // Read and parse the imported module
  src_bytes := io.await(read_file(Path.new(abs_path.clone()), io), IoExn(io : io, exn : exn));
  src := String.from_bytes(src_bytes);
  mod_exprs := parse(src, mod_base_dir.clone(), exn);
  // Recursively collect dependencies of this module first (post-order DFS)
  nm := mod_exprs.len();
  (im : usize) = usize(0);
  while(im < nm, {
    im = (im + usize(1));
    match(
      mod_exprs.get(im - usize(1)),
      .None => (),
      .Some(e) => match(
        extract_import_path(e),
        .None => (),
        .Some(child_path) => {
          recur(
            child_path.clone(),
            mod_base_dir.clone(),
            std_base,
            visited,
            all_exprs,
            io,
            exn
          );
        }
      )
    );
  });
  // Append this module's declarations to all_exprs (after its deps)
  im = usize(0);
  while(im < nm, {
    im = (im + usize(1));
    match(
      mod_exprs.get(im - usize(1)),
      .None => (),
      .Some(e) => {
        all_exprs.push(e);
      }
    );
  });
});
/// Resolve a path for exclude comparison: make it absolute against the cwd,
/// normalize separators to `/`, and fold `.`/`..` segments — the value-level
/// equivalent of TS `path.resolve` for matching purposes.
_resolve_for_match :: (fn(p : String) -> String)({
  cwd_str := match(cwd(), .Ok(c) => c.to_string(), .Err(_) => String.from("."));
  (joined : String) = p.clone();
  is_abs := (p.starts_with("/") || ((p.len() > usize(1)) && (p.byte_at(usize(1)) == u8(58))));
  if(!(is_abs), {
    joined = `${cwd_str}/${p}`;
  });
  norm := joined.replace(String.from("\\"), String.from("/"));
  parts := norm.split("/");
  kept := ArrayList(String).new();
  (pi : usize) = usize(0);
  while(pi < parts.len(), {
    part := match(parts.get(pi), .Some(s) => s, .None => String.from(""));
    pi = (pi + usize(1));
    cond(
      ((part == "") || (part == ".")) => (),
      (part == "..") => if(kept.len() > usize(0), {
        _popped := kept.pop();
      }),
      true => {
        _kp := kept.push(part);
      }
    );
  });
  (rebuilt : String) = String.from("");
  (ki : usize) = usize(0);
  while(ki < kept.len(), {
    seg := match(kept.get(ki), .Some(s) => s, .None => String.from(""));
    rebuilt.push_string(String.from("/"));
    rebuilt.push_string(seg);
    ki = (ki + usize(1));
  });
  if(rebuilt.len() == usize(0), {
    rebuilt = String.from("/");
  });
  rebuilt
});
/// Recursive helper for `collect_check_files` — walks a directory
/// tree appending each `.yo` file path to `out`.
_walk_check_dir :: (
  fn(
    dir : String,
    out : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  entries := io.await(read_dir(Path.new(dir.clone()), io), IoExn(io : io, exn : exn));
  (n : usize) = entries.len();
  (i : usize) = usize(0);
  while(i < n, {
    i = (i + usize(1));
    match(
      entries.get(i - usize(1)),
      .None => (),
      .Some(entry) => {
        full := Path.new(dir.clone()).join(Path.new(entry.name.clone())).to_string();
        match(
          entry.file_type,
          .Directory => {
            // Skip noisy infrastructure dirs (mirror src/yo-cli.ts:walkCheckDir).
            skip := cond(
              (entry.name == "node_modules") => true,
              (entry.name == "vendor") => true,
              (entry.name == ".git") => true,
              (entry.name == "vscode-extension") => true,
              (entry.name == "outdated") => true,
              true => false
            );
            if(!(skip), {
              recur(full, out, io, exn);
            });
          },
          .File => {
            // Skip dot-prefixed `.yo` files — auto-generated, not-yet-
            // cleaned-up test-batch artifacts (`.yo_test_batch_*.yo`), not
            // source. Mirrors `walkCheckDir` in `src/yo-cli.ts`.
            if((entry.name.ends_with(String.from(".yo")) || entry.name.ends_with(String.from(".test.yo"))) && !(entry.name.starts_with(String.from("."))), {
              out.push(full);
            });
          },
          .Symlink => (),
          .Other => ()
        );
      }
    );
  });
});
/// Collect every `.yo` file at or under `path_str`. If `path_str` is a
/// file, returns `[path_str]`. If it's a directory, walks recursively
/// and returns sorted absolute paths. `.test.yo` files are included
/// (they have `test("name", { body })` declarations which the
/// evaluator can still typecheck). Noisy infra dirs like
/// `node_modules`/`.git`/`vscode-extension`/`outdated` are skipped.
/// Mirrors `collectCheckFiles` in `src/yo-cli.ts`.
collect_check_files :: (
  fn(
    path_str : String,
    excludes : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> ArrayList(String)
)({
  raw := ArrayList(String).new();
  meta := io.await(metadata(Path.new(path_str.clone()), io), IoExn(io : io, exn : exn));
  cond(
    meta.is_file() => {
      if(path_str.ends_with(String.from(".yo")) || path_str.ends_with(String.from(".test.yo")), {
        raw.push(path_str.clone());
      });
    },
    meta.is_dir() => _walk_check_dir(path_str, raw, io, exn),
    true => ()
  );
  // ANCHORED exclude matching, TS parity (src/yo-cli.ts:58-64): both sides
  // resolve against the cwd, and a file is excluded when it IS the exclude
  // path or lives under it (`p === ex || p.startsWith(ex + sep)`). The old
  // substring `fp.contains(ex)` over-matched — `--exclude tests/fn` also
  // dropped `tests/fn_pointers.test.yo` (P2.5 step 6).
  resolved_excludes := ArrayList(String).new();
  (rei : usize) = usize(0);
  while(rei < excludes.len(), {
    rex := match(excludes.get(rei), .Some(e) => e, .None => String.from(""));
    if(!(rex.is_empty()), {
      resolved_excludes.push(_resolve_for_match(rex));
    });
    rei = (rei + usize(1));
  });
  out := ArrayList(String).new();
  (ri : usize) = usize(0);
  while(ri < raw.len(), {
    fp := match(raw.get(ri), .Some(p) => p, .None => String.from(""));
    fp_res := _resolve_for_match(fp.clone());
    (skip : bool) = false;
    (ei : usize) = usize(0);
    while((ei < resolved_excludes.len()) && !(skip), {
      ex := match(resolved_excludes.get(ei), .Some(e) => e, .None => String.from(""));
      if((fp_res == ex) || fp_res.starts_with(`${ex}/`), {
        skip = true;
      });
      ei = (ei + usize(1));
    });
    if(!(skip), {
      out.push(fp);
    });
    ri = (ri + usize(1));
  });
  // Sort for deterministic check order (TS parity: src/yo-cli.ts:76).
  // Raw readdir order is filesystem-dependent (ext4 hash order varies per
  // checkout), which made `check ./std` order — and therefore whether the
  // prelude was reached as a target before its dependents — a lottery.
  // See issues/fixed/seed-built-stage1-array-fill-method-miss.md.
  out.sort();
  out
});
/// Run the evaluator against a single `.yo` file. Returns `true` on
/// success; on any thrown evaluator error, `mm_load_file`'s local exception
/// handler catches it and the outcome comes back not-ok, so a directory walk
/// keeps going across files. The evaluator's own `evaluate_expression: …`
/// diagnostic has already been printed by the time the throw fires, so the
/// caller just needs to log which file failed.
///
/// The loading itself lives in `module_manager.yo` — `check` is one caller of
/// that service, not its owner.
check_single_file :: (
  fn(
    input_path : String,
    std_path : String,
    io : Io,
    exn : Exception
  ) -> bool
)(
  mm_load_file(input_path, std_path, true, io, exn).ok
);
/// Run the `check` subcommand — evaluator-only.
///
/// Accepts either a single `.yo` file or a directory. For a directory
/// the bootstrap walks `*.yo` (excluding `.test.yo`) and runs each one
/// through the evaluator; cross-file evaluator state pollution is
/// possible but acceptable for the "find evaluator coverage gaps"
/// workflow.
///
/// Exits 0 if every file passes, non-zero if any file's evaluator
/// throws.
run_check :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  if(argv.len() < usize(3), {
    exn.throw(dyn(`check: missing input file. Usage: yo check <input.yo | dir>`));
  });
  // Positional + `--exclude <path>` (repeatable) in any order; unknown
  // options are errors — TS's yargs is .strict() (yo-cli.ts:1348).
  (target_path : String) = String.new();
  excludes := ArrayList(String).new();
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    a := argv(ai);
    cond(
      (a == "--exclude") => {
        next_i := (ai + usize(1));
        if(next_i < argv.len(), {
          excludes.push(argv(next_i));
          ai = (ai + usize(2));
        }, {
          ai = (ai + usize(1));
        });
      },
      a.starts_with(String.from("-")) => {
        exn.throw(dyn(`check: unknown option '${a}'. Usage: yo check <input.yo | dir> [--exclude PATH]`));
      },
      true => {
        target_path = a.clone();
        ai = (ai + usize(1));
      }
    );
  });
  if(target_path.len() == usize(0), {
    exn.throw(dyn(`check: missing input file. Usage: yo check <input.yo | dir>`));
  });
  files := collect_check_files(target_path.clone(), excludes, io, exn);
  if(files.len() == usize(0), {
    exn.throw(dyn(`check: no .yo files found at ${target_path}`));
  });
  std_path := resolve_std_path();
  // Reset the per-module loader cache for this run. Keys are absolute
  // paths, so cache entries are valid for the whole run (a module
  // imported by several files is evaluated once).
  clear_module_cache();
  // Pre-load the prelude so the cached prelude env is a clean prelude-only
  // environment before any file is checked. (mm_load_file also self-bootstraps
  // the prelude, but doing it once here keeps the cached env free of the first
  // file's own bindings.)
  mm_preload_prelude(std_path.clone(), true, io, exn);
  (failed : usize) = usize(0);
  (fi : usize) = usize(0);
  total := files.len();
  while(fi < total, {
    match(
      files.get(fi),
      .None => (),
      .Some(file_path) => {
        if(!(check_single_file(file_path, std_path.clone(), io, exn)), {
          failed = (failed + usize(1));
        });
      }
    );
    fi = (fi + usize(1));
  });
  if(total > usize(1), {
    passed := (total - failed);
    println(`check: ${passed.to_string()}/${total.to_string()} file(s) passed`);
  });
  if(failed > usize(0), {
    exn.throw(dyn(`check: ${failed.to_string()} file(s) failed evaluator coverage`));
  });
});
/// The argv entry following index `i` (the value of a `--flag value` pair), or
/// "" if `i` is the last argument. Used by the `compile` flag parser.
_arg_val :: (fn(argv : ArrayList(String), i : usize) -> String)(
  if((i + usize(1)) < argv.len(), argv(i + usize(1)), String.from(""))
);
/// Like `_arg_val`, but a MISSING trailing value is an error instead of `""`
/// (mirrors yargs `requiresArg` behavior — `yo compile -o` with nothing after
/// silently produced an empty output name and a `.c` sidecar named `.c`).
_arg_val_req :: (
  fn(argv : ArrayList(String), i : usize, flag : String, exn : Exception) -> String
)({
  if((i + usize(1)) < argv.len(), {
    return(argv(i + usize(1)));
  });
  exn.throw(dyn(`compile: option '${flag}' requires a value`));
  String.from("")
});
/// How far the arg cursor advances for a value option: 1 when the value was
/// attached (`--flag=value`), 2 for the space form.
_opt_step :: (fn(attached : Option(String)) -> usize)(
  match(attached, .Some(_) => usize(1), .None => usize(2))
);
/// The value of a value option: the attached `=value` when present, else the
/// (required) next argv entry.
_opt_value :: (
  fn(argv : ArrayList(String), i : usize, flag : String, attached : Option(String), exn : Exception) -> String
)(
  match(attached, .Some(v) => v, .None => _arg_val_req(argv, i, flag, exn))
);
/// `compiler --version` probe (mirrors `checkCompilerAvailable`,
/// src/compiler-utils.ts:66-73 — stdio ignored, availability = exit 0).
_check_compiler_available :: (fn(compiler : String, io : Io) -> bool)({
  probe := Command.new(compiler.clone());
  probe.arg(String.from("--version"));
  // A spawn failure (missing binary) throws through IoExn — treat it as
  // "not available" rather than propagating.
  inner_exn := Exception(throw : ((_e) -> unwind(false)));
  out := io.await(probe.output(io), IoExn(io : io, exn : inner_exn));
  out.status.raw == i32(0)
});
/// First available C compiler, in TS's order (`findAvailableCompiler`,
/// src/compiler-utils.ts:79-88).
_find_available_compiler :: (fn(io : Io) -> Option(String))({
  candidates := ArrayList(String).new();
  candidates.push(String.from("clang"));
  candidates.push(String.from("cc"));
  candidates.push(String.from("gcc"));
  candidates.push(String.from("zig"));
  candidates.push(String.from("cl"));
  (fci : usize) = usize(0);
  while(fci < candidates.len(), {
    c := match(candidates.get(fci), .Some(x) => x, .None => String.from(""));
    if(_check_compiler_available(c.clone(), io), {
      return(Option(String).Some(c));
    });
    fci = (fci + usize(1));
  });
  Option(String).None
});
/// The parent directory of a Windows-or-POSIX path (both separators).
_win_dirname :: (fn(p : String) -> String)({
  (last_sep : isize) = (isize(0) - isize(1));
  (di : usize) = usize(0);
  while(di < p.len(), {
    ch := p.byte_at(di);
    if((ch == u8(47)) || (ch == u8(92)), {
      last_sep = isize(di);
    });
    di = (di + usize(1));
  });
  if(last_sep <= isize(0), {
    return(p.clone());
  });
  p.substring(usize(0), usize(last_sep))
});
/// Windows: the directory holding clang's ASan runtime DLL, to prepend to
/// PATH before running ASan-instrumented test binaries
/// (`findClangAsanDllPath`, src/compiler-utils.ts:231-274 — the DLL lives at
/// `<llvm-root>/lib/clang/<version>/lib/windows`). `.None` on any failure or
/// off Windows.
_find_clang_asan_dll_path :: (fn(compiler : String, io : Io) -> Option(String))({
  if(!(is_target_windows(host_target())), {
    return(Option(String).None);
  });
  inner_exn := Exception(throw : ((_e) -> unwind(Option(String).None)));
  wcmd := Command.new(String.from("where.exe"));
  wcmd.arg(compiler.clone());
  wout := io.await(wcmd.output(io), IoExn(io : io, exn : inner_exn));
  if(wout.status.raw != i32(0), {
    return(Option(String).None);
  });
  wtxt := String.from_bytes(wout.stdout);
  first_line := match(wtxt.split("\n").get(usize(0)), .Some(l) => l.trim(), .None => String.from(""));
  if(first_line.len() == usize(0), {
    return(Option(String).None);
  });
  compiler_dir := _win_dirname(first_line.clone());
  llvm_root := _win_dirname(compiler_dir.clone());
  clang_lib := `${llvm_root}\\lib\\clang`;
  clang_lib_found := io.await(exists(Path.new(clang_lib.clone()), io), io);
  if(!(clang_lib_found), {
    return(Option(String).None);
  });
  ver_entries := io.await(read_dir(Path.new(clang_lib.clone()), io), IoExn(io : io, exn : inner_exn));
  (vei : usize) = usize(0);
  while(vei < ver_entries.len(), {
    ve := match(ver_entries.get(vei), .Some(e) => Option(String).Some(e.name.clone()), .None => Option(String).None);
    vei = (vei + usize(1));
    match(
      ve,
      .Some(vname) => {
        win_lib := `${clang_lib}\\${vname}\\lib\\windows`;
        win_found := io.await(exists(Path.new(win_lib.clone()), io), io);
        if(win_found, {
          return(Option(String).Some(win_lib));
        });
      },
      .None => ()
    );
  });
  Option(String).None
});
/// True when the path's basename carries an extension (TS `path.extname(p) !== ""`).
_path_has_extension :: (fn(p : String) -> bool)({
  (last_slash : isize) = (isize(0) - isize(1));
  (last_dot : isize) = (isize(0) - isize(1));
  (pi : usize) = usize(0);
  while(pi < p.len(), {
    ch := p.byte_at(pi);
    if(ch == u8(47), {
      last_slash = isize(pi);
    });
    if(ch == u8(46), {
      last_dot = isize(pi);
    });
    pi = (pi + usize(1));
  });
  // A dot counts only after the last slash and not as the basename's first
  // character (path.extname(".bashrc") === "" in Node).
  last_dot > (last_slash + isize(1))
});
/// Is liburing available for linking? Mirrors `isLiburingAvailable` in
/// `src/compiler-utils.ts`: probe `pkg-config --exists liburing`.
///
/// LOAD-BEARING ON LINUX. `codegen/async/runtime_io_linux.yo` emits io_uring
/// calls guarded by `#if __has_include(<liburing.h>)`, so when the header IS
/// present the emitted C references `io_uring_*` and the LINK fails without
/// `-luring`. That is exactly how tests/sys/bufio, tests/fs/{file,temp,walker},
/// async_await and imm_string failed in CI with "undefined reference to
/// io_uring_peek_batch_cqe" etc. while passing on macOS, which uses kqueue and
/// never references those symbols. TS adds the flag in TWO places
/// (`codegen/index.ts` and `test-runner.ts`); yo-self funnels `compile` and
/// `test` through one link path, so it is added once here.
///
/// The probe runs under a SWALLOWING handler because `pkg-config` may not exist
/// at all, in which case spawning throws (TS wraps the same probe in try/catch).
/// A swallowed probe leaves `out` empty, read as "not available", so a box
/// without liburing still links — matching TS, which warns and omits the flag.
_probe_liburing :: (fn(io : Io, out : ArrayList(bool)) -> unit)({
  probe_exn := Exception(
    throw : (
      (_e) -> {
        unwind(());
      }
    )
  );
  probe := Command.new(String.from("pkg-config"));
  probe.arg(String.from("--exists"));
  probe.arg(String.from("liburing"));
  st := io.await(probe.status(io), IoExn(io : io, exn : probe_exn));
  out.push(st.raw == i32(0));
});
/// AddressSanitizer functionality probe — faithful port of TS
/// `asanRuntimeIsUsable` (src/compiler-utils.ts): compile a trivial C program
/// with `-fsanitize=address` via the SYSTEM `cc` (matching TS, which probes
/// `cc` regardless of --cc) and run it under a 3-second shell watchdog. A
/// healthy ASan binary exits 0 immediately; a clang/ASan-runtime mismatch
/// (e.g. Nix clang 21 whose libclang_rt.asan deadlocks in its own dyld
/// initializer BEFORE main on this macOS) never returns — the watchdog
/// SIGKILLs it and the probe reports unusable, so the compile proceeds
/// WITHOUT the sanitizer plus the same warning TS prints, instead of
/// emitting a binary that hangs at startup (issues/fixed/yo-self-asan-init-hang.md).
/// Result is cached process-wide (TS caches in _asanUsable).
(g_asan_usable : Option(bool)) = Option(bool).None;
_asan_runtime_is_usable :: (fn(base : String, io : Io) -> bool)({
  match(
    g_asan_usable,
    .Some(u) => {
      return(u);
    },
    .None => ()
  );
  // Any probe-step IO failure means "unusable" (TS's catch -> false).
  probe_exn := Exception(
    throw : (
      (_e) -> {
        unwind(false);
      }
    )
  );
  probe_src := `${base}.asan_probe.c`;
  probe_bin := `${base}.asan_probe`;
  io.await(write_file(Path.new(probe_src.clone()), String.from("int main(void) { return 0; }\n"), io), IoExn(io : io, exn : probe_exn));
  cc_cmd := Command.new(String.from("cc"));
  cc_cmd.arg(String.from("-x"));
  cc_cmd.arg(String.from("c"));
  cc_cmd.arg(String.from("-std=c11"));
  cc_cmd.arg(String.from("-fsanitize=address"));
  cc_cmd.arg(String.from("-o"));
  cc_cmd.arg(probe_bin.clone());
  cc_cmd.arg(probe_src.clone());
  cc_st := io.await(cc_cmd.status(io), IoExn(io : io, exn : probe_exn));
  (usable : bool) = false;
  if(cc_st.success(), {
    // Shell watchdog: `wait $p` yields the probe's own exit status; the
    // backgrounded killer turns an ASan init deadlock into SIGKILL (137,
    // not success). A healthy probe exits 0 long before the 3s fire.
    run_cmd := Command.new(String.from("sh"));
    run_cmd.arg(String.from("-c"));
    run_cmd.arg(String.from("ASAN_OPTIONS=detect_leaks=0 \"$0\" & p=$!; { sleep 3; kill -9 $p; } 2>/dev/null & wait $p"));
    run_cmd.arg(probe_bin.clone());
    run_st := io.await(run_cmd.status(io), IoExn(io : io, exn : probe_exn));
    usable = run_st.success();
  });
  // Cleanup (TS's finally-unlinks). The bin is only present when cc
  // succeeded; a removal failure routes through probe_exn -> false, which
  // is the correct verdict for any probe-environment breakage anyway.
  io.await(remove_file(Path.new(probe_src.clone()), io), IoExn(io : io, exn : probe_exn));
  if(cc_st.success(), {
    io.await(remove_file(Path.new(probe_bin.clone()), io), IoExn(io : io, exn : probe_exn));
  });
  g_asan_usable = Option(bool).Some(usable);
  usable
});
/// Run the `compile` subcommand.
run_compile :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  if(argv.len() < usize(3), {
    exn.throw(dyn(`compile: missing input file. Usage: yo compile <input.yo> [-o out] [--c-compiler cc] [--target <triple>] [--emit-c]`));
  });
  // Parse args. Mirrors the `compile` command options of the TypeScript
  // `yo-cli` (src/yo-cli.ts / src/codegen/index.ts) for the clang/gcc/zig path.
  (input_path : String) = String.from("");
  (output : String) = String.from("a.out");
  // `cc` stays empty until the user passes it; resolution (wasm → emcc, else
  // findAvailableCompiler) happens after the loop, mirroring
  // src/yo-cli.ts:468-486.
  (cc : String) = String.from("");
  (target_triple : String) = String.from("");
  (sysroot : String) = String.from("");
  (allocator : String) = String.from("libc");
  (optimize : String) = String.from(""); // "" = unset; "0".."3"
  (sanitize : String) = String.from(""); // "" / "address" / "leak" / "thread"
  (cflags : String) = String.from("");
  (emit_c : bool) = false;
  // `--emit-c-to <path>`: write the single generated C file to exactly this
  // path instead of the `<output>.c` sidecar. "" = unset.
  (emit_c_to : String) = String.new();
  // `--emcc-environment <web|node>`: mirrors the TS-internal `emccEnvironment`
  // codegen option (codegen/index.ts:187). TS has no CLI flag for it because
  // its build-runner calls codegen in-process; ours SHELLS OUT to `compile`,
  // so the value needs a flag to travel on. "" = unset, which is exactly TS's
  // `undefined` for the plain `yo compile` path and adds `-sNODERAWFS=1`;
  // build_runner passes `web` for wasm targets, which suppresses it.
  (emcc_environment : String) = String.new();
  (skip_cc : bool) = false;
  (skip_codegen : bool) = false;
  (release : bool) = false;
  (debug_gc : bool) = false;
  (debug_parallelism : bool) = false;
  (debug_async_await : bool) = false;
  (debug_symbols : bool) = false; // -g
  (strip_syms : bool) = false; // -s
  (static_link : bool) = false; // --static
  (static_library : bool) = false; // --static-library
  defines := ArrayList(String).new(); // -D
  include_paths := ArrayList(String).new(); // -I
  library_paths := ArrayList(String).new(); // -L
  libraries := ArrayList(String).new(); // -l
  externs := ArrayList(String).new(); // --extern
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    a := argv(ai);
    // `--flag=value` normalization: split at the FIRST '=' (values may
    // themselves contain '=', e.g. `--cflags=-march=native`). Mirrors yargs,
    // and the file's own precedent at the doc/build subcommands.
    (a_name : String) = a.clone();
    (a_val : Option(String)) = Option(String).None;
    if(a.starts_with("--"), {
      (eq_at : isize) = (isize(0) - isize(1));
      (sc_i : usize) = usize(0);
      while((sc_i < a.len()) && (eq_at < isize(0)), {
        if(a.byte_at(sc_i) == u8(61), {
          eq_at = isize(sc_i);
        });
        sc_i = (sc_i + usize(1));
      });
      if(eq_at > isize(0), {
        a_name = a.substring(usize(0), usize(eq_at));
        a_val = Option(String).Some(a.substring(usize(eq_at) + usize(1), a.len()));
      });
    });
    cond(
      (a_name == "-o") => {
        output = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      ((a_name == "--c-compiler") || (a_name == "--cc")) => {
        cc = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      ((a_name == "--target") || (a_name == "-t")) => {
        target_triple = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--sysroot") => {
        sysroot = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--emcc-environment") => {
        emcc_environment = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--allocator") => {
        allocator = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--optimize") => {
        optimize = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--sanitize") => {
        sanitize = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--cflags") => {
        cflags = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      // Array options. Space/`=` forms are GREEDY like yargs `type: "array"`:
      // following non-dash args join the list (`-I a b` = two include paths —
      // previously `b` silently became input_path, a wrong-file success).
      ((a_name == "-D") || (a_name == "--define")) => {
        defines.push(_opt_value(argv, ai, a_name.clone(), a_val.clone(), exn));
        ai = (ai + _opt_step(a_val));
        while((ai < argv.len()) && !(argv(ai).starts_with("-")), {
          defines.push(argv(ai));
          ai = (ai + usize(1));
        });
      },
      (a_name == "-I") => {
        include_paths.push(_opt_value(argv, ai, a_name.clone(), a_val.clone(), exn));
        ai = (ai + _opt_step(a_val));
        while((ai < argv.len()) && !(argv(ai).starts_with("-")), {
          include_paths.push(argv(ai));
          ai = (ai + usize(1));
        });
      },
      (a_name == "-L") => {
        library_paths.push(_opt_value(argv, ai, a_name.clone(), a_val.clone(), exn));
        ai = (ai + _opt_step(a_val));
        while((ai < argv.len()) && !(argv(ai).starts_with("-")), {
          library_paths.push(argv(ai));
          ai = (ai + usize(1));
        });
      },
      (a_name == "-l") => {
        libraries.push(_opt_value(argv, ai, a_name.clone(), a_val.clone(), exn));
        ai = (ai + _opt_step(a_val));
        while((ai < argv.len()) && !(argv(ai).starts_with("-")), {
          libraries.push(argv(ai));
          ai = (ai + usize(1));
        });
      },
      (a_name == "--extern") => {
        externs.push(_opt_value(argv, ai, a_name.clone(), a_val.clone(), exn));
        ai = (ai + _opt_step(a_val));
        while((ai < argv.len()) && !(argv(ai).starts_with("-")), {
          externs.push(argv(ai));
          ai = (ai + usize(1));
        });
      },
      // Attached short forms, gcc-style: `-I./include`, `-L./lib`, `-lm`,
      // `-DFOO=1`, `-oout` (the TS help's own examples, src/yo-cli.ts:320-346).
      // One value each; checked AFTER the exact matches so `-l` alone still
      // takes the next arg.
      (a.starts_with("-I") && ((a.len() > usize(2)) && !(a.starts_with("--")))) => {
        include_paths.push(a.substring(usize(2), a.len()));
        ai = (ai + usize(1));
      },
      (a.starts_with("-L") && ((a.len() > usize(2)) && !(a.starts_with("--")))) => {
        library_paths.push(a.substring(usize(2), a.len()));
        ai = (ai + usize(1));
      },
      (a.starts_with("-l") && ((a.len() > usize(2)) && !(a.starts_with("--")))) => {
        libraries.push(a.substring(usize(2), a.len()));
        ai = (ai + usize(1));
      },
      (a.starts_with("-D") && ((a.len() > usize(2)) && !(a.starts_with("--")))) => {
        defines.push(a.substring(usize(2), a.len()));
        ai = (ai + usize(1));
      },
      (a.starts_with("-o") && ((a.len() > usize(2)) && !(a.starts_with("--")))) => {
        output = a.substring(usize(2), a.len());
        ai = (ai + usize(1));
      },
      // `--emit-c` PRINTS the generated C to stdout and still compiles/links
      // (TS module-manager.ts:473-475); `--skip-c-compiler` gates the link
      // (TS codegen/index.ts:234). Previously conflated.
      (a_name == "--emit-c") => {
        emit_c = true;
        ai = (ai + usize(1));
      },
      // `--emit-c-to <path>` REDIRECTS the sidecar (it does not add a second
      // copy), so the C compiler consumes this same path. Distinct from
      // `--emit-c`, which only prints to stdout.
      (a_name == "--emit-c-to") => {
        emit_c_to = _opt_value(argv, ai, a_name.clone(), a_val.clone(), exn);
        ai = (ai + _opt_step(a_val));
      },
      (a_name == "--skip-c-compiler") => {
        skip_cc = true;
        ai = (ai + usize(1));
      },
      (a == "--skip-codegen") => {
        skip_codegen = true;
        ai = (ai + usize(1));
      },
      (a == "--release") => {
        release = true;
        ai = (ai + usize(1));
      },
      (a == "--debug-gc") => {
        debug_gc = true;
        ai = (ai + usize(1));
      },
      (a == "--debug-parallelism") => {
        debug_parallelism = true;
        ai = (ai + usize(1));
      },
      (a == "--debug-async-await") => {
        debug_async_await = true;
        ai = (ai + usize(1));
      },
      ((a == "-g") || (a == "--debug-symbols")) => {
        debug_symbols = true;
        ai = (ai + usize(1));
      },
      ((a == "-s") || (a == "--strip")) => {
        strip_syms = true;
        ai = (ai + usize(1));
      },
      (a == "--static") => {
        static_link = true;
        ai = (ai + usize(1));
      },
      (a == "--static-library") => {
        static_library = true;
        ai = (ai + usize(1));
      },
      // Accepted for parity; `compile` has no default sanitizer in either
      // compiler (the TEST runner's default is where --disable-sanitize bites).
      (a == "--disable-sanitize") => {
        ai = (ai + usize(1));
      },
      a.starts_with("-") => {
        // yargs is .strict() (src/yo-cli.ts:1358): an unknown option is an
        // error. The old silent catch-all dropped mistyped flags — a
        // `--sanitizer address` typo compiled unsanitized with rc=0.
        exn.throw(dyn(`compile: unknown option '${a}'`));
        ai = (ai + usize(1));
      },
      true => {
        input_path = a;
        ai = (ai + usize(1));
      }
    );
  });
  // ----- choices validation (yargs `choices:` parity, src/yo-cli.ts) -------
  if(((cc != "") && (((cc != "cc") && (cc != "gcc")) && ((cc != "clang") && (cc != "zig")))) && ((cc != "cl") && (cc != "emcc")), {
    exn.throw(dyn(`compile: invalid --c-compiler "${cc}". Choices: cc, gcc, clang, zig, cl, emcc`));
  });
  if((allocator != "mimalloc") && (allocator != "libc"), {
    exn.throw(dyn(`compile: invalid --allocator "${allocator}". Choices: mimalloc, libc`));
  });
  if((optimize != "") && (((optimize != "0") && (optimize != "1")) && ((optimize != "2") && (optimize != "3"))), {
    exn.throw(dyn(`compile: invalid --optimize "${optimize}". Choices: 0, 1, 2, 3`));
  });
  if((sanitize != "") && (((sanitize != "address") && (sanitize != "leak")) && (sanitize != "thread")), {
    exn.throw(dyn(`compile: invalid --sanitize "${sanitize}". Choices: address, leak, thread`));
  });
  if((emcc_environment != "") && ((emcc_environment != "web") && (emcc_environment != "node")), {
    exn.throw(dyn(`compile: invalid --emcc-environment "${emcc_environment}". Choices: web, node`));
  });
  // ----- C compiler resolution (src/yo-cli.ts:468-486) ---------------------
  // Auto-select emcc for wasm targets when --cc was not given; otherwise probe
  // for the first available compiler instead of assuming clang.
  if((cc == "") && target_triple.starts_with("wasm"), {
    cc = String.from("emcc");
  });
  if(cc == "", {
    match(
      _find_available_compiler(io),
      .Some(found_cc) => {
        cc = found_cc;
      },
      .None => {
        exn.throw(dyn(String.from("Error: No C compiler found. Please install a C compiler (cc, gcc, clang, zig, or cl) or specify one using the -cc/--c-compiler flag.")));
      }
    );
  });
  // emcc implies wasm32-emscripten when no target was given (yo-cli.ts:488-490).
  if((cc == "emcc") && (target_triple == ""), {
    target_triple = String.from("wasm32-emscripten");
  });
  // Resolve the compilation target: --target <triple> if given, else host.
  // Placed BEFORE the module is evaluated, matching TS (yo-cli.ts:502-503
  // parses the target, then :521 calls compileModule, which evaluates). It
  // also has to precede the evaluate+emit scope below, because that scope must
  // be free to drop everything it created.
  target := match(
    cond(
      (target_triple == "") => Result(TargetInfo, String).Ok(host_target()),
      true => parse_target(target_triple)
    ),
    .Ok(t) => t,
    .Err(e) => {
      exn.throw(dyn(`compile: invalid --target "${target_triple}": ${e}`));
      return(())
    }
  );
  // Publish the resolved target BEFORE the module is evaluated, so the
  // comptime `__yo_process_platform`/`_arch`/`_pointer_size_bits` builtins
  // fold for the TARGET rather than the emitting host. TS does the same at
  // codegen/index.ts:194. Must precede evaluation: `cond(platform == ...)`
  // arms in std/ are selected during evaluation, and the untaken arm never
  // reaches the AST.
  set_current_target(target);
  // The pointer-size global feeds get_size_of_type's sizeof/alignof folding.
  // TS pairs these two setters at the same spot (codegen/index.ts:194-195);
  // yo-self had NO caller for this setter, so sizeof folded 64-bit pointer
  // layouts into wasm32 C — e.g. sizeof(MapNode) = 16 while typed-pointer
  // `.add()` arithmetic scales by the REAL 8-byte wasm32 element, mixing
  // strides inside std/imm/map's child arrays (the imm_map wasi unwrap-None
  // trap; issues/repros/imm-map-wasm32-unwrap-none.yo). The test runner
  // shells out to `self compile --target ...` per batch, so this one call
  // covers both the compile and test paths.
  set_target_pointer_size(target.pointer_size_bits);
  // Auto-add the output extension when none was given (yo-cli.ts:494-509):
  // emcc → `.wasm` for standalone WASI, else `.html`; Windows targets → `.exe`.
  if((cc == "emcc") && !(_path_has_extension(output)), {
    output = if(is_target_standalone_wasi(target), `${output}.wasm`, `${output}.html`);
  });
  if(is_target_windows(target) && !(_path_has_extension(output)), {
    output = `${output}.exe`;
  });
  // mimalloc isn't available on wasm (codegen/index.ts:193-199) — downgrade
  // BEFORE codegen so the emitted runtime matches the link line.
  if((allocator == "mimalloc") && is_target_wasm(target), {
    allocator = String.from("libc");
  });
  std_path := resolve_std_path();
  // Create the shared ExprInfoTable BEFORE loading the prelude, and publish it
  // via g_shared_expr_info_table now (not after the prelude load). The prelude
  // is def-eval'd inside check_single_file; routing its per-expression metadata
  // into THIS table makes codegen find the body ExprInfo of non-specialized
  // prelude functions (e.g. `assert`'s `cond(flag => (), true => __yo_panic(msg))`).
  // Previously the prelude loaded into a discarded table and g_shared was only
  // set to the entry ctx's table afterwards, so a prelude function emitted
  // directly (not re-specialized at a call site) had no cond ExprInfo →
  // "Failed to transpile cond(...)". See issues/yo-self-cond-panic-arm-codegen.md.
  // Make this compile SELF-CONTAINED. `run_test` calls `run_compile` once per
  // test batch IN-PROCESS, and a fresh ExprInfoTable is created just below — but
  // two caches outlive that table: the module cache (`g_module_cache_*`) and
  // `g_cached_prelude_env`. On a SECOND batch the cached std/prelude ASTs are
  // reused while their ExprInfo lives in the FIRST batch's discarded table, so
  // codegen finds no info for those nodes and emits `// Failed to transpile` for
  // std internals (ArrayList._length/_ptr/_capacity, String._bytes, std/env
  // getenv, ...).
  //
  // MEASURED 2026-08-05: `test ./tests/string` (5 files) emitted 47 FTT markers
  // on the second file's batch while every one of those files passed ALONE, and
  // `test ./tests/internal` did the same with 59 — with an IDENTICAL import list
  // either side, so the trigger was purely "second compile in one process". That
  // is also why every per-file gate was green: they only ever compile one batch.
  //
  // This clearing is DEFENCE IN DEPTH, not the fix — it took 47 markers to 18,
  // because the specialization and impl registries outlive the table too. The
  // actual fix is that `run_test` now compiles each batch in a CHILD PROCESS, so
  // no second in-process compile happens at all. Kept because it makes
  // `run_compile` self-contained (free: a one-compile process starts with these
  // caches empty), which is the invariant the child-process design relies on.
  //
  // TS needs no equivalent: it stores node info ON the AST node (`expr.$`), so a
  // cached AST carries its annotations, whereas yo-self keys a SIDE TABLE by
  // expr id. `run_check` already clears the module cache for the same reason.
  //
  // ---------------------------------------------------------------------
  // EVALUATE + EMIT SCOPE. Everything the evaluator and the code generator
  // build lives inside this block, so that all of it is DROPPED before the
  // C compiler is spawned below.
  //
  // This is not tidiness, it is the fix for a reproducing CI failure
  // (issues/compiler-holds-emit-memory-during-cc.md). On run 31864299243
  // the 140 MB .c was written at 04:36 and the process was STILL holding
  // its ~12 GB evaluator arena at 04:40:59 when it died — while clang,
  // which needs only 3.17 GB on its own, ran alongside it. Neither peak is
  // fatal alone; the SUM on a 16 GB runner is.
  //
  // Nothing after the block reads any of it: `c_path` (declared outside so
  // it survives) and `target` are the only values the link line needs.
  // ---------------------------------------------------------------------
  (c_path : String) = String.new();
  {
    clear_module_cache();
    mm_clear_prelude_env();
    shared_info_table := expr_info_table_new();
    mm_set_shared_expr_info_table(shared_info_table);
    // Ensure the prelude env is cached (provides std types to the evaluator).
    // Quiet: `compile` has no `check:` chatter.
    mm_preload_prelude(std_path.clone(), false, io, exn);
    // Read + parse the input module.
    src_bytes := io.await(read_file(Path.new(input_path.clone()), io), IoExn(io : io, exn : exn));
    src := String.from_bytes(src_bytes);
    exprs := parse(src, input_path.clone(), exn);
    // Demand-driven module loading. The entry module's eval context reuses the
    // shared ExprInfoTable (created above, also used by the prelude load and every
    // demand-loaded module) so codegen has metadata for the bodies of ALL
    // collected functions — the prelude's, every imported module's, and the entry
    // module's. `mm_eval_entry_exprs` applies it from the published slot.
    entry_abs := mm_resolve_entry_abs(input_path.clone(), std_path.clone());
    outcome := mm_eval_entry_exprs(entry_abs, std_path.clone(), exprs, io, exn);
    if(!(outcome.ok), {
      exn.throw(dyn(`compile: failed to evaluate module "${input_path}"`));
      return(());
    });
    module_value := outcome.module_value;
    env := outcome.env;
    ctx := outcome.ctx;
    // --skip-codegen: evaluate only (type-check), emit no C.
    if(skip_codegen, {
      return(());
    });
    // Generate C11 from the evaluated module. A static library has no main()
    // wrapper (is_library = true). Allocator + debug-logging flags are threaded
    // through to the code generator (mirrors CodeGeneratorC.compileModule).
    c_src := compile_module(module_value, ctx.expr_info_table, target, allocator.clone(), debug_gc, debug_parallelism, debug_async_await, static_library, ctx, env, exn);
    // --emit-c prints the generated C to stdout (module-manager.ts:473-475) —
    // and compilation continues; only --skip-c-compiler stops before the link.
    if(emit_c, {
      println(c_src);
    });
    // Strip a target-format extension so `app.html` gets `app.c`, not
    // `app.html.c` (codegen/index.ts:226-228).
    (c_base : String) = output.clone();
    cond(
      c_base.ends_with(".html") => {
        c_base = c_base.substring(usize(0), c_base.len() - usize(5));
      },
      c_base.ends_with(".wasm") => {
        c_base = c_base.substring(usize(0), c_base.len() - usize(5));
      },
      c_base.ends_with(".exe") => {
        c_base = c_base.substring(usize(0), c_base.len() - usize(4));
      },
      c_base.ends_with(".js") => {
        c_base = c_base.substring(usize(0), c_base.len() - usize(3));
      },
      true => ()
    );
    // `--emit-c-to` overrides the derived sidecar path entirely, and its parent
    // directory is created — the point of the flag is to place the file
    // somewhere deliberate (e.g. `dist/yo.c`) that need not exist yet.
    c_path = if(emit_c_to.len() > usize(0), emit_c_to.clone(), `${c_base}.c`);
    if(emit_c_to.len() > usize(0), {
      match(
        Path.new(c_path.clone()).parent(),
        .Some(pdir) => {
          io.await(create_dir_all(pdir, io), IoExn(io : io, exn : exn));
        },
        .None => ()
      );
    });
    io.await(write_file(Path.new(c_path.clone()), c_src, io), IoExn(io : io, exn : exn));
  };
  // The scope above has dropped the AST, the evaluated module, the env, the
  // eval context and the 140 MB C string. The module-manager GLOBALS still
  // pin the rest of the universe, though, and no scope can reach them: the
  // module cache (every evaluated module's values, for the whole import
  // closure), the cached prelude env, and the shared ExprInfoTable. Clearing
  // them is the other half of the fix — either half alone frees nothing,
  // because each still holds a reference to what the other drops.
  // TS equivalent: ModuleManager.resetAllState().
  mm_reset();
  // --skip-c-compiler: write the C and stop.
  if(skip_cc, {
    return(());
  });
  // ----- assemble the C-compiler invocation (mirrors src/codegen/index.ts) ---
  std_root := resolve_std_path();
  cmd := Command.new(cc.clone());
  // `zig` is invoked as `zig cc ...`.
  if(cc == "zig", {
    cmd.arg(String.from("cc"));
  });
  cmd.arg(String.from("-std=c11"));
  cmd.arg(String.from("-fno-strict-aliasing"));
  // -fwrapv: define signed overflow as two's-complement wrap (MEMORY_SAFETY.md
  // Limitation #6); without it the optimizer may exploit overflow-UB.
  cmd.arg(String.from("-fwrapv"));
  // Inline assembly with intel_syntax needs the C compiler in Intel mode
  // (mirrors codegen/index.ts:580-583; skipped for wasm targets).
  if(get_needs_intel_asm_syntax() && !(is_target_wasm(target)), {
    cmd.arg(String.from("-masm=intel"));
  });
  // Optimization + warnings: explicit --optimize wins over --release; the
  // default and explicit `--optimize 0` use -O0 with the noisy warnings
  // suppressed (mirrors the TS option logic).
  cond(
    ((optimize == "") && release) => {
      cmd.arg(String.from("-w"));
      cmd.arg(String.from("-O2"));
    },
    ((optimize != "") && (optimize != "0")) => {
      cmd.arg(String.from("-w"));
      cmd.arg(`-O${optimize}`);
    },
    true => {
      cmd.arg(String.from("-Wall"));
      cmd.arg(String.from("-Wextra"));
      cmd.arg(String.from("-Wno-unused-variable"));
      cmd.arg(String.from("-Wno-unused-parameter"));
      cmd.arg(String.from("-Wno-unused-function"));
      cmd.arg(String.from("-Wno-unused-but-set-variable"));
      cmd.arg(String.from("-Wno-unused-label"));
      cmd.arg(String.from("-Wno-unused-value"));
      cmd.arg(String.from("-Wno-parentheses-equality"));
      cmd.arg(String.from("-O0"));
    }
  );
  if(debug_symbols, {
    cmd.arg(String.from("-g"));
  });
  if(strip_syms, {
    cmd.arg(String.from("-s"));
  });
  if(static_link, {
    cmd.arg(String.from("-static"));
  });
  // Sanitizers (clang/gcc; mirror of TS getSanitizerFlags for the Unix path).
  // emcc takes none — TS gates the whole block on `!isEmcc`
  // (codegen/index.ts:465), and the test path already mirrors that.
  if(cc == "emcc", {
    sanitize = String.from("");
  });
  cond(
    (sanitize == "address") => {
      // Functionality probe first (TS getSanitizerFlags): a clang/ASan
      // runtime mismatch produces binaries that deadlock in ASan's own
      // init before main — skip the flags with TS's warning instead.
      if(_asan_runtime_is_usable(output, io), {
        cmd.arg(String.from("-fsanitize=address"));
        cmd.arg(String.from("-fno-omit-frame-pointer"));
      }, {
        eprintln(String.from("AddressSanitizer is not functional with this compiler setup (likely a version mismatch between clang and the ASAN runtime library). Skipping sanitizer. Install a matching ASAN runtime or use --cc with a compatible compiler."));
      });
    },
    (sanitize == "leak") => cmd.arg(String.from("-fsanitize=leak")),
    (sanitize == "thread") => {
      cmd.arg(String.from("-fsanitize=thread"));
      cmd.arg(String.from("-fno-omit-frame-pointer"));
    },
    true => ()
  );
  // -I include paths, -D defines, -L library search paths.
  (ii : usize) = usize(0);
  while(ii < include_paths.len(), {
    match(include_paths.get(ii), .Some(p) => cmd.arg(`-I${p}`), .None => ());
    ii = (ii + usize(1));
  });
  (di : usize) = usize(0);
  while(di < defines.len(), {
    match(defines.get(di), .Some(d) => cmd.arg(`-D${d}`), .None => ());
    di = (di + usize(1));
  });
  (li : usize) = usize(0);
  while(li < library_paths.len(), {
    match(library_paths.get(li), .Some(p) => cmd.arg(`-L${p}`), .None => ());
    li = (li + usize(1));
  });
  // Arbitrary custom flags (--cflags "a b c").
  if(cflags != "", {
    parts := cflags.split(" ");
    (ci : usize) = usize(0);
    while(ci < parts.len(), {
      match(parts.get(ci), .Some(f) => if(f.len() > usize(0), cmd.arg(f.clone())), .None => ());
      ci = (ci + usize(1));
    });
  });
  // Bundled mimalloc allocator (else libc): add static.c + its include path,
  // guarded by existence with TS's fallback warning (codegen/index.ts:534-555).
  if(allocator == "mimalloc", {
    mim_static := `${std_root}/../vendor/mimalloc/src/static.c`;
    mim_found := io.await(exists(Path.new(mim_static.clone()), io), io);
    if(mim_found, {
      cmd.arg(`-I${std_root}/../vendor/mimalloc/include`);
      cmd.arg(mim_static.clone());
      println(String.from("Using bundled mimalloc"));
    }, {
      eprintln(String.from("Bundled mimalloc not found, falling back to standard malloc"));
    });
  }, {
    println(String.from("Using libc allocator"));
  });
  // Cross-compile target / sysroot pass-through. Skipped entirely for emcc,
  // which handles its own target internally (codegen/index.ts:636-641) — it
  // rejects `--target=wasm32-emscripten`.
  if(cc != "emcc", {
    if(target_triple != "", {
      cmd.arg(`--target=${target_triple}`);
    });
    if(sysroot != "", {
      cmd.arg(`--sysroot=${sysroot}`);
    });
  });
  // Emscripten-specific link flags (codegen/index.ts:605-634).
  if(cc == "emcc", {
    // WASM call_indirect demands exact signature matches, but codegen casts
    // void* to function pointers — without this every such call traps.
    cmd.arg(String.from("-sEMULATE_FUNCTION_POINTER_CASTS=1"));
    // Yo emits C11, not C++. Emscripten 4.0.23+ otherwise fails to link on
    // __cxa_increment_exception_refcount from its JS symbols library.
    cmd.arg(String.from("-fno-exceptions"));
    if(is_target_standalone_wasi(target), {
      // Standalone WASI: a bare .wasm with no JS glue.
      cmd.arg(String.from("-sSTANDALONE_WASM"));
    }, {
      // Node: use the real filesystem instead of MEMFS. Skipped for `web`,
      // where NODERAWFS's require('fs') does not exist.
      if(emcc_environment != "web", {
        cmd.arg(String.from("-sNODERAWFS=1"));
      });
    });
    // `&& !standalone_wasi` — emcc REJECTS the combination outright:
    // "explicitly setting EXIT_RUNTIME not compatible with STANDALONE_WASM".
    // TS's test runner carries this same guard (test-runner.ts:667
    // `usesParallelism && !isWasi`); only its codegen path omits it, and that
    // is the copy this was ported from, so the bug arrived with the port.
    if(get_uses_parallelism() && !(is_target_standalone_wasi(target)), {
      cmd.arg(String.from("-pthread"));
      cmd.arg(String.from("-sPTHREAD_POOL_SIZE=4"));
      cmd.arg(String.from("-sEXIT_RUNTIME=1"));
    });
  });
  // --static-library: compile to a .o (-c -fPIC) then archive into a .a.
  // Otherwise compile + link into an executable.
  if(static_library, {
    obj_path := `${output}.o`;
    cmd.arg(String.from("-c"));
    if(!(is_target_windows(target)), {
      cmd.arg(String.from("-fPIC"));
    });
    cmd.arg(c_path.clone());
    cmd.arg(String.from("-o"));
    cmd.arg(obj_path.clone());
    cst := io.await(cmd.status(io), IoExn(io : io, exn : exn));
    if(cst.raw != i32(0), {
      exn.throw(dyn(`compile: C compiler failed (exit ${cst.code().to_string()}) on ${c_path}`));
      return(())
    });
    ar_out := if(output.clone().ends_with(".a"), output.clone(), `${output}.a`);
    arcmd := Command.new(String.from("ar"));
    arcmd.arg(String.from("rcs"));
    arcmd.arg(ar_out.clone());
    arcmd.arg(obj_path.clone());
    ast := io.await(arcmd.status(io), IoExn(io : io, exn : exn));
    if(ast.raw != i32(0), {
      exn.throw(dyn(`compile: ar failed (exit ${ast.code().to_string()}) creating ${ar_out}`));
    });
    return(())
  });
  // Executable: source + externs, output, then link libraries.
  cmd.arg(c_path.clone());
  (ei : usize) = usize(0);
  while(ei < externs.len(), {
    match(externs.get(ei), .Some(f) => cmd.arg(f.clone()), .None => ());
    ei = (ei + usize(1));
  });
  cmd.arg(String.from("-o"));
  cmd.arg(output.clone());
  // POSIX-only: MSVC has no m.lib (math lives in the CRT — LNK1181 on the
  // first native-Windows probe smoke) and -pthread is meaningless there.
  // (TS passes neither for native targets; kept on POSIX to avoid touching
  // proven link lines.)
  //
  // WASM excluded: TS gates EVERY system library on `!isWasm`
  // (codegen/index.ts:526), and `-pthread` in particular is not inert for
  // emcc — it switches Emscripten into pthreads mode, which changes the shape
  // of the generated output. Passing it unconditionally is why the first
  // self-hosted wasm smoke test built `hello-world.html` but produced no
  // `hello-world.js` for the runner to execute (run 31874422392).
  if(!(is_target_windows(target)) && !(is_target_wasm(target)), {
    cmd.arg(String.from("-lm"));
    cmd.arg(String.from("-pthread"));
  });
  // liburing for async I/O (io_uring) on Linux — see `_probe_liburing`. Without
  // it every emitted `io_uring_*` reference is an undefined symbol at link time.
  if(is_target_linux(target), {
    ur := ArrayList(bool).new();
    _probe_liburing(io, ur);
    if(match(ur.get(usize(0)), .Some(b) => b, .None => false), {
      cmd.arg(String.from("-luring"));
    });
  });
  (xi : usize) = usize(0);
  while(xi < libraries.len(), {
    match(libraries.get(xi), .Some(lib) => cmd.arg(`-l${lib}`), .None => ());
    xi = (xi + usize(1));
  });
  if(is_target_windows(target), {
    cmd.arg(String.from("-lws2_32"));
    cmd.arg(String.from("-lbcrypt"));
    // mimalloc's Windows large-page support needs advapi32
    // (OpenProcessToken/LookupPrivilegeValueA); harmless when unused.
    cmd.arg(String.from("-ladvapi32"));
  });
  st := io.await(cmd.status(io), IoExn(io : io, exn : exn));
  if(st.raw != i32(0), {
    exn.throw(dyn(`compile: C compiler failed (exit ${st.code().to_string()}) on ${c_path}`));
  });
});
/// Recursively collect `*.test.yo` files under `path_str` (or `[path_str]`
/// for a file). Mirrors `findTestFiles` in src/test-runner.ts (reuses the
/// check walker, then filters to `.test.yo`).
_collect_test_files :: (
  fn(
    path_str : String,
    excludes : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> ArrayList(String)
)({
  // `excludes` has the same semantics as `check --exclude`: a path is skipped if
  // it equals an exclude or lives under one. Needed so `test ./tests` can skip
  // `tests/internal`, whose files each pull ~99k lines through their import
  // closure and peak near 6.5 GB — they cannot share a run with the fast
  // language tests. Mirrors the `exclude` option on the TS `test` subcommand
  // (src/yo-cli.ts) and `findTestFiles` (src/test-runner.ts).
  all := collect_check_files(path_str, excludes, io, exn);
  out := ArrayList(String).new();
  (i : usize) = usize(0);
  while(i < all.len(), {
    match(
      all.get(i),
      .Some(f) => if(f.ends_with(String.from(".test.yo")), {
        out.push(f.clone());
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});
/// One extracted `test("name", { body })` declaration (source-string form).
TestDecl :: struct(name : String, body_src : String);
/// Run `*.test.yo` files with the self-hosted pipeline. Port of the TS
/// test runner's BATCHED strategy (src/test-runner.ts): per file, parse and
/// split `test(name, body)` declarations from the non-test content, synthesize
/// ONE program whose `main` dispatches on the `YO_TEST_INDEX` env var over the
/// inlined test bodies (generateBatchedTestProgram, test-runner.ts:340),
/// compile it ONCE through the normal compile driver, then run the binary once
/// per test (the spawn runtime passes the parent environment through, so a
/// parent `setenv` reaches the child). v1 scope: sequential execution
/// (--parallel accepted for CLI compatibility), --bail and
/// --test-name-pattern honored; per-test ✓/✗ lines + the Test Summary
/// footer mirror the TS output (without durations/colors).
///
/// Tests are compiled in batches of `TEST_BATCH_SIZE`, mirroring TS's
/// `DEFAULT_TEST_BATCH_SIZE` (src/test-runner.ts:54).
TEST_BATCH_SIZE :: usize(100);
run_test :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  // The positional path defaults to "." (TS: .positional("path", {default: "."}),
  // src/yo-cli.ts:697-703) — a bare `yo test` runs the current directory.
  (target_path : String) = String.from(".");
  (bail : bool) = false;
  (name_pattern : String) = String.from("");
  (verbose : bool) = false;
  (no_sanitize : bool) = false;
  (test_cc : String) = String.from("");
  (test_target : String) = String.from("");
  (batch_size : usize) = TEST_BATCH_SIZE;
  // `--exclude <path>` (repeatable), same semantics as `check --exclude`.
  excludes := ArrayList(String).new();
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    a := argv(ai);
    cond(
      ((a == "--bail") || (a == "-b")) => {
        bail = true;
        ai = (ai + usize(1));
      },
      (a == "--test-name-pattern") => {
        name_pattern = _arg_val(argv, ai);
        ai = (ai + usize(2));
      },
      ((a == "--parallel") || (a == "-p")) => {
        // Accepted for CLI compatibility; v1 runs sequentially.
        ai = (ai + usize(2));
      },
      (a == "--exclude") => {
        excludes.push(_arg_val(argv, ai));
        ai = (ai + usize(2));
      },
      ((a == "-v") || (a == "--verbose")) => {
        verbose = true;
        ai = (ai + usize(1));
      },
      ((a == "--cc") || (a == "--c-compiler")) => {
        test_cc = _arg_val_req(argv, ai, a.clone(), exn);
        ai = (ai + usize(2));
      },
      (a == "--target") => {
        test_target = _arg_val_req(argv, ai, a.clone(), exn);
        ai = (ai + usize(2));
      },
      (a == "--test-batch-size") => {
        bs_raw := _arg_val_req(argv, ai, a.clone(), exn);
        match(
          bs_raw.parse_u32(),
          .Some(bsv) => if(bsv > u32(0), {
            batch_size = usize(bsv);
          }, {
            exn.throw(dyn(`test: --test-batch-size must be a positive integer, got '${bs_raw}'`));
          }),
          .None => {
            exn.throw(dyn(`test: --test-batch-size must be a positive integer, got '${bs_raw}'`));
          }
        );
        ai = (ai + usize(2));
      },
      (a == "--disable-sanitize") => {
        no_sanitize = true;
        ai = (ai + usize(1));
      },
      // Consumed for CLI compatibility; the sequential in-process runner has
      // no use for them yet — accepted divergence, tracked in
      // plans/P1_CLI_PARITY.md §6.
      ((a == "--keep-generated-files") || (a == "-k") || (a == "--json-summary") || (a == "--profile")) => {
        ai = (ai + usize(1));
      },
