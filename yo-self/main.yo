        // TS's yargs is .strict(): an unknown option is an error, never a
        // path (yo-cli.ts:1348).
        exn.throw(dyn(`test: unknown option '${a}'. Usage: yo test <path> [--bail] [--test-name-pattern P] [--parallel N] [--exclude PATH]`));
      },
      true => {
        target_path = a.clone();
        ai = (ai + usize(1));
      }
    );
  });
  // --test-name-pattern is a REGEX, exactly as TS (`new RegExp(pattern)`,
  // src/test-runner.ts:1469-1477) — the old substring match made anchored
  // patterns like '^test 19' match nothing. Compiled once; an invalid
  // pattern is an error up front.
  (name_regex : Option(Regex)) = Option(Regex).None;
  if(name_pattern.len() > usize(0), {
    match(
      Regex.new(name_pattern.clone(), String.from("")),
      .Ok(re) => {
        name_regex = Option(Regex).Some(re);
      },
      .Err(re_err) => {
        exn.throw(dyn(`test: invalid regex pattern '${name_pattern}': ${re_err}`));
      }
    );
    println(`Filtering tests matching: ${name_pattern}`);
  });
  files := _collect_test_files(target_path, excludes, io, exn);
  // `Pragma.SkipWasm` pre-scan for wasm targets (hasSkipDirectiveForTarget,
  // src/test-runner.ts:152-170 + its filter loop at :1425-1453): a file whose
  // first 50 lines carry `pragma(Pragma.SkipWasm)` — or the targeted
  // `SkipWasm32Wasi`/`SkipWasm32Emscripten` variant — is skipped when the
  // corresponding wasm target is selected (via --target or --cc emcc).
  wasm_target_kind := cond(
    test_target.starts_with("wasm") => test_target.clone(),
    (test_cc == "emcc") => String.from("wasm32-emscripten"),
    true => String.from("")
  );
  // HOW a compiled batch must be built and run. A wasm artifact is NOT a host
  // executable: exec'ing one fails with `permission denied`, which is exactly
  // what both converted wasm legs hit (run 31878327019). WASI runs under
  // wasmtime, Emscripten under node — src/test-runner.ts:448-456 for the
  // extension and :747-775 for the command.
  run_is_wasi := cond(
    (wasm_target_kind == "") => false,
    true => match(
      parse_target(wasm_target_kind.clone()),
      .Ok(wt) => is_target_standalone_wasi(wt),
      .Err(_) => false
    )
  );
  run_is_emcc := ((wasm_target_kind != "") && !(run_is_wasi));
  // The extension is LOAD-BEARING, not cosmetic: emcc selects its OUTPUT
  // FORMAT from it. With the flat `.bin` name this runner used, even
  // `--target wasm-wasi` produced JS glue and the standalone `.wasm` the leg
  // needs was never emitted — after which the failure merely LOOKS like a
  // missing run-command branch. Verified locally with emcc 4.0.12: `-o X.bin`
  // yields `JavaScript source` for BOTH wasm targets.
  batch_ext := cond(
    run_is_wasi => String.from(".wasm"),
    run_is_emcc => String.from(".js"),
    true => String.from(".bin")
  );
  // Resolved once: wasmtime needs the cwd as an explicit --dir grant below.
  run_cwd := match(cwd(), .Ok(rc) => rc.to_string(), .Err(_) => String.from("."));
  if(wasm_target_kind != "", {
    wt_parsed := match(
      parse_target(wasm_target_kind.clone()),
      .Ok(t) => t,
      .Err(e) => {
        exn.throw(dyn(`test: invalid --target "${wasm_target_kind}": ${e}`));
        host_target()
      }
    );
    targeted_variant := if(
      is_target_standalone_wasi(wt_parsed),
      String.from("pragma(Pragma.SkipWasm32Wasi)"),
      String.from("pragma(Pragma.SkipWasm32Emscripten)")
    );
    kept_files := ArrayList(String).new();
    (skipped_n : usize) = usize(0);
    (sfi : usize) = usize(0);
    while(sfi < files.len(), {
      sf := match(files.get(sfi), .Some(f) => f, .None => String.from(""));
      sfi = (sfi + usize(1));
      sf_bytes := io.await(read_file(Path.new(sf.clone()), io), IoExn(io : io, exn : exn));
      sf_src := String.from_bytes(sf_bytes);
      sf_lines := sf_src.split("\n");
      (skip_this : bool) = false;
      (sli : usize) = usize(0);
      while((sli < sf_lines.len()) && ((sli < usize(50)) && !(skip_this)), {
        sline := match(sf_lines.get(sli), .Some(l) => l, .None => String.from(""));
        sli = (sli + usize(1));
        // Whitespace-stripped `contains` == the TS regex's arbitrary
        // intra-call whitespace tolerance; the trailing `)` in the needle
        // keeps `SkipWasm32Wasi` from matching the bare `SkipWasm` needle.
        stripped := sline.replace(String.from(" "), String.from("")).replace(String.from("\t"), String.from(""));
        if(stripped.contains("pragma(Pragma.SkipWasm)") || stripped.contains(targeted_variant.clone()), {
          skip_this = true;
        });
      });
      if(skip_this, {
        skipped_n = (skipped_n + usize(1));
      }, {
        kept_files.push(sf);
      });
    });
    if(skipped_n > usize(0), {
      println(`Skipping ${skipped_n.to_string()} test file(s) with pragma(Pragma.SkipWasm*) for target ${wasm_target_kind}`);
    });
    files = kept_files;
  });
  if(files.len() == usize(0), {
    println(String.from("No test files found."));
    return(());
  });
  (passed : usize) = usize(0);
  (failed : usize) = usize(0);
  (bailed : bool) = false;
  (fi : usize) = usize(0);
  while((fi < files.len()) && !(bailed), {
    file := match(files.get(fi), .Some(f) => f, .None => String.from(""));
    fi = (fi + usize(1));
    println(``);
    println(`${file}`);
    src_bytes := io.await(read_file(Path.new(file.clone()), io), IoExn(io : io, exn : exn));
    src := String.from_bytes(src_bytes);
    prog := parse(src, file.clone(), exn);
    tests := ArrayList(TestDecl).new();
    non_test := ArrayList(String).new();
    (pi : usize) = usize(0);
    while(pi < prog.len(), {
      e := match(prog.get(pi), .Some(x) => x, .None => make_err_expr());
      pi = (pi + usize(1));
      if(ast_expr_is_fn_call_of(e, BK_TEST, .None), {
        targs := match(e, .FnCall(_, _, a2, _, _) => a2, _ => ArrayList(AstExpr).new());
        if(targs.len() >= usize(2), {
          // Go through extract_test_name, which strips the surrounding quotes a
          // StringLit token value carries ("name" -> name). That matches what TS
          // reports: it reads the EVALUATED comptime string
          // (src/test-runner.ts:316) and only falls back to the raw token value.
          // Taking ntok.value directly printed `✓ "name"` and made
          // --test-name-pattern match against the quote characters.
          tname := match(extract_test_name(e), .Some(n) => n, .None => String.from("unnamed_test"));
          tbody := match(extract_test_body(e), .Some(b) => b, .None => make_err_expr());
          keep := match(name_regex, .Some(nre) => nre.test(tname.clone()), .None => true);
          if(keep, {
            tests.push(TestDecl(name : tname, body_src : ast_expr_to_string(tbody)));
          });
        });
      }, {
        non_test.push(ast_expr_to_string(e));
      });
    });
    if(tests.len() == usize(0), {
      println(String.from("  (no tests)"));
    }, {
      // Split the file's tests into batches of TEST_BATCH_SIZE, exactly as TS
      // does (`DEFAULT_TEST_BATCH_SIZE = 100`, src/test-runner.ts:54, sliced at
      // :1312-1315). This is not just parity — a single batch nests ONE BRACE
      // LEVEL PER TEST in the emitted `cond` chain, so a file with >~250 tests
      // exceeded clang's default `-fbracket-depth=256` and failed to compile at
      // all: tests/string/string.test.yo (252 tests) emitted C nested 261 deep
      // and died with "bracket nesting level exceeded maximum of 256". TS never
      // hit it because it was already batching — its emit for the same file
      // peaks at depth 105 across 3 batches.
      // See issues/fixed/yo-self-hollow-language-test-files.md.
      (batch_start : usize) = usize(0);
      (bi : usize) = usize(0);
      while((batch_start < tests.len()) && !(bailed), {
        batch_end := cond(
          ((batch_start + batch_size) < tests.len()) => (batch_start + batch_size),
          true => tests.len()
        );
        // Synthesize the batched program (mirror generateBatchedTestProgram).
        prog_src := String.new();
        (ni : usize) = usize(0);
        while(ni < non_test.len(), {
          match(
            non_test.get(ni),
            .Some(l) => {
              prog_src.push_string(l.clone());
              prog_src.push_str(";\n");
            },
            .None => ()
          );
          ni = (ni + usize(1));
        });
        prog_src.push_str("__yo_batch_env :: import(\"std/env\");\n");
        prog_src.push_str("main :: (fn() -> unit)({\n");
        prog_src.push_str("  io :: __yo_builtin_io;\n");
        prog_src.push_str("  match(__yo_batch_env.env.get(`YO_TEST_INDEX`),\n");
        prog_src.push_str("    .Some(__yo_test_idx) => cond(\n");
        // Arms are numbered RELATIVE to the batch (0..n-1), so YO_TEST_INDEX below
        // is the within-batch index, not the file-wide one.
        (ti : usize) = batch_start;
        while(ti < batch_end, {
          t := match(tests.get(ti), .Some(x) => x, .None => TestDecl(name : String.from(""), body_src : String.from("()")));
          prog_src.push_str("      (__yo_test_idx == `");
          prog_src.push_string((ti - batch_start).to_string());
          prog_src.push_str("`) => { ");
          prog_src.push_string(t.body_src.clone());
          prog_src.push_str("; },\n");
          ti = (ti + usize(1));
        });
        prog_src.push_str("      true => ()\n");
        prog_src.push_str("    ),\n");
        prog_src.push_str("    .None => ()\n");
        prog_src.push_str("  );\n");
        prog_src.push_str("});\n");
        prog_src.push_str("export(main);\n");
        // Write the batch program NEXT TO the test file (mirrors TS
        // compileBatchedBinary: path.join(path.dirname(filePath), baseName)) —
        // the batch must inherit the test file's relative-import base, so a
        // /tmp placement breaks every `import("./...")` in non-test content.
        batch_dir := match(
          file.last_index_of(`/`),
          .Some(sidx) => file.substring(usize(0), sidx),
          .None => String.from(".")
        );
        // The batch index is part of the name so a multi-batch file does not have
        // its batches overwrite each other (and so YO_KEEP_BATCH leaves all of
        // them behind for inspection).
        batch_base := `${batch_dir}/.yo_selftest_batch_${fi.to_string()}_${bi.to_string()}`;
        tmp_yo := `${batch_base}.yo`;
        tmp_bin := `${batch_base}${batch_ext}`;
        // The C sidecar does NOT simply append `.c`: run_compile STRIPS a
        // known target-format extension first (`.html`/`.wasm`/`.exe`/`.js`,
        // main.yo:1341-1358), so `X.js` emits `X.c` while the plain `X.bin`
        // keeps `X.bin.c`. Cleanup must follow the same rule — deleting a path
        // that was never written throws `file or directory not found` and
        // aborts the rest of the cleanup with it.
        tmp_c := if(run_is_wasi || run_is_emcc, `${batch_base}.c`, `${tmp_bin}.c`);
        io.await(write_file(Path.new(tmp_yo.clone()), prog_src.clone(), io), IoExn(io : io, exn : exn));
        // Compile the batch in a CHILD PROCESS, not in-process.
        //
        // WHY: `run_compile` creates a fresh ExprInfoTable, but compiler state lives
        // in module-level globals (func-type registry, specialization caches, impl
        // registry, module cache, prelude env, ...) that OUTLIVE it. A second
        // in-process compile therefore reused cached std ASTs whose ExprInfo was in
        // the first batch's discarded table, and codegen emitted
        // `// Failed to transpile` for std internals (ArrayList._length,
        // String._bytes, Option.unwrap, std/env getenv). MEASURED 2026-08-05: 47
        // markers on `test ./tests/string` — five ORDINARY language tests — and 59
        // on tests/internal, while every one of those files passed ALONE. Batch 1
        // and batch 2 had an IDENTICAL import list, so the trigger was purely
        // "second compile in one process".
        //
        // TS gets fresh state per batch by construction: `src/test-runner.ts:503`
        // does `moduleManager = new ModuleManager()`. yo-self has no instance to
        // re-create, so a fresh PROCESS is the faithful equivalent — and it
        // reproduces EXACTLY the standalone path, which is the verified-green one
        // (all 58 tests/internal and all 187 ./tests files pass standalone).
        //
        // Uses argv(0), so the binary must be invoked by a usable path. CI and every
        // gate script invoke it by explicit path (/tmp/yo-stage1,
        // ./yo-self/yo-self-bin). See issues/fixed/yo-self-second-batch-in-process-ftt.md.
        self_exe := argv(usize(0));
        ccmd := Command.new(self_exe.clone());
        ccmd.arg(String.from("compile"));
        ccmd.arg(tmp_yo.clone());
        ccmd.arg(String.from("-o"));
        ccmd.arg(tmp_bin.clone());
        // Forward the runner's compiler/target choices to the child compile
        // (previously consumed-and-dropped — `yo test --cc gcc` silently
        // compiled with clang; P2.5 step 5).
        if(test_cc != "", {
          ccmd.arg(String.from("--c-compiler"));
          ccmd.arg(test_cc.clone());
        });
        if(test_target != "", {
          ccmd.arg(String.from("--target"));
          ccmd.arg(test_target.clone());
        });
        // WASI batch binaries embed the whole evaluator, whose `evaluate()`
        // has 693+ locals; emcc's defaults (64 KB stack, 16 MB initial
        // memory) cannot hold a frame that size. TS applies these in the TEST
        // RUNNER only (test-runner.ts:655-663), never in plain `compile`, so
        // they travel as --cflags rather than becoming a compile-wide default
        // for every WASI build.
        if(run_is_wasi, {
          ccmd.arg(String.from("--cflags"));
          ccmd.arg(String.from("-sSTACK_SIZE=16777216 -sINITIAL_MEMORY=134217728"));
        });
        // TS's test runner compiles emcc batches at -O2, everything else at
        // -O0 (test-runner.ts:606, `isEmcc ? "-O2" : "-O0"`). This is
        // LOAD-BEARING for stack: the batch main inlines every test body, so
        // at -O0 each multi-KB temp (e.g. a MaybeUninit(Array(u8, 4096))
        // materialization is THREE 4 KB locals) gets its own slot and the
        // frame can exceed emcc's 64 KB default stack — LLVM's stack coloring
        // only runs at -O1+. emcc 4 squeaked under; CI's emcc 6 overflowed on
        // tests/sys/path.test.yo ("Stack overflow detected", realpath test).
        if(run_is_wasi || run_is_emcc, {
          ccmd.arg(String.from("--optimize"));
          ccmd.arg(String.from("2"));
        });
        // Default sanitizer is "address"; YO_TEST_SANITIZE overrides (e.g.
        // "thread" for the TSan CI leg) and --disable-sanitize turns it off.
        // MSVC and emcc take no sanitizer, exactly as TS
        // (src/test-runner.ts:556-566). The child compile owns the flag
        // mapping and the ASan-usability probe.
        san_choice := match(
          proc_env.get(`YO_TEST_SANITIZE`),
          .Some(sv) => sv,
          .None => String.from("address")
        );
        // `run_is_wasi` is part of the emcc test, not just the literal cc
        // string: the WASI leg selects its compiler with `--target wasm-wasi`
        // and never sets `--c-compiler`, so `test_cc` is "" and this gate used
        // to hand `-fsanitize=address` to emcc. TS never does, because it
        // resolves the cc first and reads `isEmcc` off the RESULT.
        if((!(no_sanitize)) && (((test_cc != "cl") && (test_cc != "emcc")) && !(run_is_wasi)), {
          ccmd.arg(String.from("--sanitize"));
          ccmd.arg(san_choice.clone());
        });
        bst := io.await(ccmd.status(io), IoExn(io : io, exn : exn));
        if(bst.raw != i32(0), {
          exn.throw(dyn(`test: batch compile failed (exit ${bst.code().to_string()}) for ${tmp_yo}`));
        });
        // Run each test: YO_TEST_INDEX in the PARENT env (the spawn runtime
        // passes environ through when envp is NULL). The ASan run environment
        // (TS test-runner.ts:776-840 / compiler-utils.ts:305-341) rides the
        // same channel: setting ASAN_OPTIONS/LSAN_OPTIONS on the parent
        // process reaches every test child — process-wide instead of TS's
        // per-child env object, same observable effect for the children.
        host_ti := host_target();
        // Same `run_is_wasi` correction as the --sanitize gate above: without
        // it the WASI leg built an lsan suppression file and applied a
        // LeakSanitizer verdict to an emcc artifact that carries no ASan.
        use_asan := ((!(no_sanitize)) && ((san_choice == "address") && (((test_cc != "cl") && (test_cc != "emcc")) && !(run_is_wasi))));
        // YO_TEST_LEAK_VERDICT=0 stages leak checking off entirely: LSan's
        // OWN nonzero exit fails a leaking child regardless of the runner's
        // verdict, so `detect_leaks` itself must follow the flag — ASan's
        // crash detection (UAF/double-free) stays fully armed either way.
        // The staging ratchet for the pre-existing self-hosted-emit leak
        // debt (issues/self-hosted-emit-leaks-remaining-classes.md); the
        // default stays TS-parity ON.
        leak_verdict := match(
          proc_env.get(`YO_TEST_LEAK_VERDICT`),
          .Some(lv) => (lv != "0"),
          .None => true
        );
        (lsan_supp_file : String) = String.from("");
        if(use_asan, {
          _sv_asan := proc_env.set(String.from("ASAN_OPTIONS"), if(leak_verdict, String.from("detect_leaks=1"), String.from("detect_leaks=0")));
          // macOS: suppress the well-known system-library leak reports
          // (getMacOSLsanSuppressions, compiler-utils.ts:334-341).
          if(is_target_macos(host_ti), {
            lsan_supp_file = `${tmp_bin}.lsan_supp.txt`;
            io.await(write_file(Path.new(lsan_supp_file.clone()), String.from("leak:libobjc\nleak:libdyld\nleak:libxpc\nleak:libsystem_malloc\nleak:dyld"), io), IoExn(io : io, exn : exn));
            _sv_lsan := proc_env.set(String.from("LSAN_OPTIONS"), `suppressions=${lsan_supp_file}`);
          });
          // Windows + clang: the ASan runtime DLL directory must be on PATH
          // (findClangAsanDllPath, compiler-utils.ts:231-274).
          if(is_target_windows(host_ti) && (((test_cc == "") || (test_cc == "cc")) || (test_cc == "clang")), {
            dll_cc := if((test_cc == "") || (test_cc == "cc"), String.from("clang"), test_cc.clone());
            match(
              _find_clang_asan_dll_path(dll_cc, io),
              .Some(dll_dir) => {
                cur_path := match(proc_env.get(`PATH`), .Some(pv) => pv, .None => String.from(""));
                _sv_path := proc_env.set(String.from("PATH"), `${dll_dir};${cur_path}`);
              },
              .None => ()
            );
          });
        });
        (ri : usize) = batch_start;
        while((ri < batch_end) && !(bailed), {
          t := match(tests.get(ri), .Some(x) => x, .None => TestDecl(name : String.from(""), body_src : String.from("()")));
          // std/env's portable wrapper, NOT raw libc setenv — Windows has no
          // setenv (the v0.2.0 windows seed leg failed on it); env.set
          // branches to _putenv_s there.
          _sv := proc_env.set(String.from("YO_TEST_INDEX"), (ri - batch_start).to_string());
          // Capture output (TS stdio:"pipe") — the diagnostics on failure and
          // the LeakSanitizer verdict both need it; the old `.status()` run
          // streamed everything and left a bare `✗ name` undiagnosable.
          // A wasm batch is not a host executable — see run_is_wasi/run_is_emcc.
          tcmd := cond(
            run_is_wasi => {
              wc := Command.new(String.from("wasmtime"));
              // The guest's default stack is far below what this suite's
              // recursion needs (test-runner.ts:750-753).
              wc.arg(String.from("-W"));
              wc.arg(String.from("max-wasm-stack=16777216"));
              // WASI is deny-by-default for the filesystem. All three grants
              // are load-bearing: without them file-I/O tests fail in a way
              // that reads as a compiler bug rather than a missing capability.
              wc.arg(String.from("--dir"));
              wc.arg(batch_dir.clone());
              wc.arg(String.from("--dir"));
              wc.arg(String.from("/tmp"));
              wc.arg(String.from("--dir"));
              wc.arg(run_cwd.clone());
              // --env, NOT proc_env.set: a wasmtime guest does not inherit the
              // host environment, so the process-wide YO_TEST_INDEX set above
              // would leave EVERY test in the batch running as index 0.
              wc.arg(String.from("--env"));
              wc.arg(`YO_TEST_INDEX=${(ri - batch_start).to_string()}`);
              wc.arg(tmp_bin.clone());
              wc
            },
            // Emscripten emits JS glue plus a sibling .wasm; node runs the
            // glue, which inherits the process env normally.
            run_is_emcc => {
              nc := Command.new(String.from("node"));
              nc.arg(tmp_bin.clone());
              nc
            },
            true => Command.new(tmp_bin.clone())
          );
          tout := io.await(tcmd.output(io), IoExn(io : io, exn : exn));
          (combined : String) = String.from_bytes(tout.stdout);
          combined.push_string(String.from_bytes(tout.stderr));
          (t_status : i32) = tout.status.raw;
          // Older ASan runtimes: "detect_leaks is not supported" → retry once
          // without leak detection (test-runner.ts:806-826).
          if(use_asan && combined.contains("detect_leaks is not supported"), {
            _sv_asan2 := proc_env.set(String.from("ASAN_OPTIONS"), String.from("detect_leaks=0"));
            tcmd2 := Command.new(tmp_bin.clone());
            tout2 := io.await(tcmd2.output(io), IoExn(io : io, exn : exn));
            combined = String.from_bytes(tout2.stdout);
            combined.push_string(String.from_bytes(tout2.stderr));
            t_status = tout2.status.raw;
            _sv_asan3 := proc_env.set(String.from("ASAN_OPTIONS"), if(leak_verdict, String.from("detect_leaks=1"), String.from("detect_leaks=0")));
          });
          // A leak is a FAILURE even at exit 0 (test-runner.ts:835-843) —
          // unless staged off via YO_TEST_LEAK_VERDICT=0 (hoisted above,
          // where it also disables LSan's own exit-code).
          has_leak := ((leak_verdict && ((test_cc != "emcc") && use_asan)) && (((combined.contains("LeakSanitizer") || combined.contains("detected memory leaks")) || combined.contains("Direct leak")) || combined.contains("Indirect leak")));
          if((t_status == i32(0)) && !(has_leak), {
            passed = (passed + usize(1));
            println(`  ✓ ${t.name}`);
            // Streamed output parity: tests print through the child's stdout,
            // which is now captured — re-emit it so passing tests keep their
            // visible output exactly as before.
            if(combined.len() > usize(0), {
              print(combined.clone());
            });
          }, {
            failed = (failed + usize(1));
            println(`  ✗ ${t.name}`);
            err_msg := if(
              has_leak,
              `Memory leak detected:\n${combined}`,
              `Test failed with exit code ${t_status.to_string()}\n${combined}`
            );
            // -v prints the whole diagnostic indented; the default prints the
            // first line (test-runner.ts:1263-1276).
            if(verbose, {
              err_lines := err_msg.split("\n");
              (eli : usize) = usize(0);
              while(eli < err_lines.len(), {
                el := match(err_lines.get(eli), .Some(l) => l, .None => String.from(""));
                println(`    ${el}`);
                eli = (eli + usize(1));
              });
            }, {
              first_line := match(err_msg.split("\n").get(usize(0)), .Some(l) => l, .None => String.from(""));
              println(`    ${first_line}`);
            });
            if(bail, {
              bailed = true;
            });
          });
          ri = (ri + usize(1));
        });
        if(lsan_supp_file != "", {
          io.await(remove_file(Path.new(lsan_supp_file.clone()), io), IoExn(io : io, exn : exn));
        });
        // Clean up the batch artifacts (mirrors TS cleanup()) — they live in
        // the test file's directory now, not /tmp. Debug affordance (yo-self
        // only, no TS counterpart): YO_KEEP_BATCH=1 skips the cleanup so a
        // failing batch's .yo/.c can be inspected — batch-only miscompiles
        // (the collections residuals) are unreproducible otherwise.
        if(proc_env.get(`YO_KEEP_BATCH`).is_none(), {
          io.await(remove_file(Path.new(tmp_yo.clone()), io), IoExn(io : io, exn : exn));
          io.await(remove_file(Path.new(tmp_bin.clone()), io), IoExn(io : io, exn : exn));
          io.await(remove_file(Path.new(tmp_c.clone()), io), IoExn(io : io, exn : exn));
          // Emscripten's second output: the JS glue at `tmp_bin` is paired
          // with a sibling `<base>.wasm` that no other cleanup path names, so
          // without this every emcc batch leaks one file into the test tree
          // (TS tracks it as `testWasmPath`, test-runner.ts:459).
          if(run_is_emcc, {
            io.await(remove_file(Path.new(`${batch_base}.wasm`), io), IoExn(io : io, exn : exn));
          });
        });
        batch_start = batch_end;
        bi = (bi + usize(1));
      });
    });
  });
  if(bailed, {
    println(``);
    println(String.from("Bailing out early due to test failure (--bail)"));
  });
  println(``);
  println(String.from("Test Summary"));
  println(String.from("─────────────────────────────────"));
  if(passed > usize(0), {
    println(`${passed.to_string()} passed`);
  });
  if(failed > usize(0), {
    println(`${failed.to_string()} failed`);
  });
  println(`${(passed + failed).to_string()} total`);
  if(failed > usize(0), {
    // Route the nonzero exit through the top-level throw handler (its
    // `unsafe(exit(int(1)))` runs in the ctl-handler context, which exits
    // cleanly); a plain exit() here on the normal path aborts under the
    // self-compiled runtime (SIGABRT in teardown).
    exn.throw(dyn(`${failed.to_string()} test(s) failed`));
  });
});
/// Run the `init` subcommand — scaffold a new Yo project.
///
/// Flag contract mirrors the TS command (`src/yo-cli.ts:840-859`):
///   yo init [dir] [--name <project-name>]
/// `dir` is a POSITIONAL defaulting to "." and `--name` overrides the project
/// name that would otherwise be derived from the directory basename. Anything
/// else is rejected rather than silently swallowed — `main.yo`'s other arg loops
/// assign unrecognized tokens to a path, which is how `yo test ./tests --profile`
/// ends up running against a path literally named `--profile`
/// (plans/P1_CLI_PARITY.md §3). Do not copy that shape here.
run_init :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  (dir : String) = String.from(".");
  (dir_seen : bool) = false;
  (name : Option(String)) = Option(String).None;
  (ai : usize) = usize(2); // skip program name + "init"
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      (arg == "--name") => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("init: --name requires a value")));
        });
        name = Option(String).Some(argv(ai + usize(1)));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--name=")) => {
        name = Option(String).Some(arg.substring(usize(7), arg.len()));
      },
      arg.starts_with(String.from("-")) => {
        exn.throw(dyn(`init: unknown option '${arg}'. Usage: yo init [dir] [--name <name>]`));
      },
      dir_seen => {
        exn.throw(dyn(`init: unexpected extra argument '${arg}'. Usage: yo init [dir] [--name <name>]`));
      },
      true => {
        dir = arg;
        dir_seen = true;
      }
    );
    ai = (ai + usize(1));
  });
  io.await(init_project(InitOptions(dir : dir, name : name), io, exn), IoExn(io : io, exn : exn));
});
run_fmt :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  // Parse arguments — collect positional paths, detect --check flag.
  input_paths := ArrayList(String).new();
  (check_mode : bool) = false;
  (ai : usize) = usize(2); // skip program name + "fmt"
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      (arg == "--check") => {
        check_mode = true;
      },
      arg.starts_with(String.from("-")) => {
        // TS's yargs is .strict(): an unknown option is an error, never a
        // path (yo-cli.ts:1348).
        exn.throw(dyn(`fmt: unknown option '${arg}'. Usage: yo fmt [paths...] [--check]`));
      },
      true => {
        _r := input_paths.push(arg);
      }
    );
    ai = (ai + usize(1));
  });
  // TS resolves against the user's directory (yo-cli.ts:1071:
  // `process.env.YO_ORIGINAL_CWD ?? process.cwd()`).
  fmt_cwd := match(
    proc_env.get(`YO_ORIGINAL_CWD`),
    .Some(oc) => oc,
    .None => match(cwd(), .Ok(cp) => cp.to_string(), .Err(_) => String.from("."))
  );
  // TS wraps the whole handler in try/catch and prints the BARE message —
  // no `yo: error:` prefix (yo-cli.ts:1088-1090).
  fmt_exn := Exception(
    throw : (
      (fmt_err) -> {
        eprintln(`${fmt_err.to_string()}`);
        unsafe(exit(int(1)));
        unwind();
      }
    )
  );
  options := FormatYoFilesOptions(check : check_mode, cwd : fmt_cwd.clone());
  result := format_yo_files(input_paths, options, io, fmt_exn);
  // Report — TS yo-cli.ts:1077-1087: check mode lists cwd-relative paths on
  // STDERR under a header and exits 1; write mode prints one summary line.
  cn := result.changed.len();
  cond(
    check_mode => {
      if(cn > usize(0), {
        eprintln(String.from("The following Yo files need formatting:"));
        (cidx : usize) = usize(0);
        while(cidx < cn, {
          match(
            result.changed.get(cidx),
            .Some(c) => eprintln(
              Path.new(c.clone()).relative_from(Path.new(fmt_cwd.clone())).to_string()
            ),
            .None => ()
          );
          cidx = (cidx + usize(1));
        });
        unsafe(exit(int(1)));
      });
    },
    true => {
      if(cn > usize(0), {
        println(`Formatted ${cn} Yo file(s).`);
      });
    }
  );
});
/// Run the `cache` subcommand — inspect or clear the global dependency cache.
///
/// Flag contract mirrors `src/yo-cli.ts:1141-1164`:
///   yo cache <path|clean>
run_cache :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  if(argv.len() < usize(3), {
    exn.throw(dyn(String.from("cache: missing action. Usage: yo cache <path|clean>")));
  });
  action := argv(usize(2));
  if(argv.len() > usize(3), {
    exn.throw(dyn(`cache: unexpected extra argument '${argv(usize(3))}'. Usage: yo cache <path|clean>`));
  });
  cache_dir := get_global_cache_dir();
  cond(
    (action == "path") => println(cache_dir),
    (action == "clean") => {
      present := io.await(exists(Path.new(cache_dir.clone()), io), io);
      cond(
        present => {
          io.await(remove_dir_all(Path.new(cache_dir.clone()), io, exn), IoExn(io : io, exn : exn));
          println(`Removed cache directory: ${cache_dir}`);
        },
        true => println(`Cache directory does not exist: ${cache_dir}`)
      );
    },
    true => {
      exn.throw(dyn(`cache: unknown action '${action}'. Usage: yo cache <path|clean>`));
    }
  );
});
/// Run the `fetch` subcommand — fetch git dependencies into the global cache.
///
/// Flag contract mirrors `src/yo-cli.ts:861-893`:
///   yo fetch [--build-file <path>] [--verbose|-v] [--update|-u]
run_fetch_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  (build_file : String) = String.from("./build.yo");
  (verbose : bool) = false;
  (update : bool) = false;
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      (arg == "--build-file") => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("fetch: --build-file requires a value")));
        });
        build_file = argv(ai + usize(1));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--build-file=")) => {
        build_file = arg.substring(usize(13), arg.len());
      },
      ((arg == "--verbose") || (arg == "-v")) => {
        verbose = true;
      },
      ((arg == "--update") || (arg == "-u")) => {
        update = true;
      },
      true => {
        exn.throw(dyn(`fetch: unknown option '${arg}'. Usage: yo fetch [--build-file <path>] [--verbose] [--update]`));
      }
    );
    ai = (ai + usize(1));
  });
  io.await(
    run_fetch(FetchOptions(build_file : build_file, verbose : verbose, update : update), io, exn),
    IoExn(io : io, exn : exn)
  );
});
/// Run the `install` subcommand — add a dependency to `deps.yo` and fetch it.
///
/// Flag contract mirrors `src/yo-cli.ts:894-926`:
///   yo install <package> [--build-file <path>] [--verbose|-v]
run_install_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  (package_spec : String) = String.new();
  (package_seen : bool) = false;
  (build_file : String) = String.from("./build.yo");
  (verbose : bool) = false;
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      (arg == "--build-file") => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("install: --build-file requires a value")));
        });
        build_file = argv(ai + usize(1));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--build-file=")) => {
        build_file = arg.substring(usize(13), arg.len());
      },
      ((arg == "--verbose") || (arg == "-v")) => {
        verbose = true;
      },
      arg.starts_with(String.from("-")) => {
        exn.throw(dyn(`install: unknown option '${arg}'. Usage: yo install <package> [--build-file <path>] [--verbose]`));
      },
      package_seen => {
        exn.throw(dyn(`install: unexpected extra argument '${arg}'. Usage: yo install <package> [--build-file <path>] [--verbose]`));
      },
      true => {
        package_spec = arg;
        package_seen = true;
      }
    );
    ai = (ai + usize(1));
  });
  if(!(package_seen), {
    exn.throw(dyn(String.from("install: missing package. Usage: yo install <package> [--build-file <path>] [--verbose]")));
  });
  io.await(
    run_install(
      InstallOptions(package_spec : package_spec, build_file : build_file, verbose : verbose),
      io,
      exn
    ),
    IoExn(io : io, exn : exn)
  );
});
/// Run the `build` subcommand — evaluate `build.yo` and execute the requested
/// steps (default: `install`).
///
/// Flag contract mirrors `src/yo-cli.ts:927-…`:
///   yo build [steps..] [--cc <c>] [-t|--target <triple>] [--sysroot <dir>]
///            [--build-file <path>] [--list-steps] [--dry-run] [--verbose|-v]
///            [--summary] [-D<name>=<value>]
run_build_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  steps := ArrayList(String).new();
  defines := HashMap(String, String).new();
  (c_compiler : Option(String)) = Option(String).None;
  (target_triple : Option(String)) = Option(String).None;
  (sysroot : Option(String)) = Option(String).None;
  (build_file : String) = String.from("./build.yo");
  (list_steps : bool) = false;
  (dry_run : bool) = false;
  (verbose : bool) = false;
  (summary : bool) = false;
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      ((arg == "--cc") || (arg == "--c-compiler")) => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("build: --cc requires a value")));
        });
        c_compiler = Option(String).Some(argv(ai + usize(1)));
        ai = (ai + usize(1));
      },
      ((arg == "-t") || (arg == "--target")) => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("build: --target requires a value")));
        });
        target_triple = Option(String).Some(argv(ai + usize(1)));
        ai = (ai + usize(1));
      },
      (arg == "--sysroot") => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("build: --sysroot requires a value")));
        });
        sysroot = Option(String).Some(argv(ai + usize(1)));
        ai = (ai + usize(1));
      },
      (arg == "--build-file") => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("build: --build-file requires a value")));
        });
        build_file = argv(ai + usize(1));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--build-file=")) => {
        build_file = arg.substring(usize(13), arg.len());
      },
      (arg == "--list-steps") => {
        list_steps = true;
      },
      (arg == "--dry-run") => {
        dry_run = true;
      },
      ((arg == "--verbose") || (arg == "-v")) => {
        verbose = true;
      },
      (arg == "--summary") => {
        summary = true;
      },
      // `-Dname=value` sets a build option declared by `build.option(...)`.
      (arg.starts_with(String.from("-D")) && (arg.len() > usize(2))) => {
        body := arg.substring(usize(2), arg.len());
        match(
          body.index_of(String.from("=")),
          .Some(pos) => {
            _di := defines.set(body.substring(usize(0), pos), body.substring(pos + usize(1), body.len()));
          },
          .None => {
            _di := defines.set(body.clone(), String.from("true"));
          }
        );
      },
      arg.starts_with(String.from("-")) => {
        exn.throw(dyn(`build: unknown option '${arg}'. Usage: yo build [steps..] [--build-file <path>] [--list-steps] [--dry-run] [--verbose] [--summary]`));
      },
      true => {
        steps.push(arg);
      }
    );
    ai = (ai + usize(1));
  });
  io.await(
    run_build(
      BuildOptions(
        steps : steps,
        c_compiler : c_compiler,
        target_triple : target_triple,
        sysroot : sysroot,
        build_file : build_file,
        list_steps : list_steps,
        dry_run : dry_run,
        verbose : verbose,
        summary : summary,
        defines : defines
      ),
      io,
      exn
    ),
    IoExn(io : io, exn : exn)
  );
});
/// Parse `yo doc [path] [options]` argv and run the doc command. Flag
/// surface mirrors the yargs definition in `src/yo-cli.ts` ("doc [path]"):
/// positional path (default "."), -o/--output (default "yo-out/doc"),
/// --title, --document-private, -v/--verbose, -f/--format
/// (html|markdown|json, default html), --version.
/// `yo unsafe-report [path] [--json]` — the unsafe-surface audit (port of
/// the TS subcommand; scanning lives in unsafe_report.yo). A nonexistent
/// path reports on stderr and exits 1, like TS.
run_unsafe_report_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  (target : String) = String.from(".");
  (as_json : bool) = false;
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      (arg == "--json") => {
        as_json = true;
      },
      true => {
        target = arg.clone();
      }
    );
    ai = (ai + usize(1));
  });
  // Path.new(".") normalizes to the empty path, so check the CWD directly.
  target_exists := if(target == ".", true, io.await(exists(Path.new(target.clone()), io), io));
  if(!(target_exists), {
    eprintln(`unsafe-report: path does not exist: ${target}`);
    exn.throw(dyn(`unsafe-report: path does not exist`));
  });
  report := io.await(generate_unsafe_report(target.clone(), io, exn), IoExn(io : io, exn : exn));
  if(as_json, {
    println(unsafe_report_to_json(report));
  }, {
    println(format_unsafe_report(report));
  });
});
/// `yo public-safe-report [path] [--json]` — the public-signature raw-
/// pointer lint (port of the TS subcommand; scanning lives in
/// public_safe_report.yo). Informational: findings do NOT fail the exit.
run_public_safe_report_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  (target : String) = String.from("./std");
  (as_json : bool) = false;
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      (arg == "--json") => {
        as_json = true;
      },
      true => {
        target = arg.clone();
      }
    );
    ai = (ai + usize(1));
  });
  // Path.new(".") normalizes to the empty path, so check the CWD directly.
  target_exists := if(target == ".", true, io.await(exists(Path.new(target.clone()), io), io));
  if(!(target_exists), {
    eprintln(`public-safe-report: path does not exist: ${target}`);
    exn.throw(dyn(`public-safe-report: path does not exist`));
  });
  report := io.await(generate_public_safe_report(target.clone(), io, exn), IoExn(io : io, exn : exn));
  if(as_json, {
    println(public_safe_report_to_json(report));
  }, {
    println(format_public_safe_report(report));
  });
});
run_doc_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  (input : String) = String.from(".");
  (output_dir : String) = String.from("yo-out/doc");
  (title : String) = String.new();
  (include_private : bool) = false;
  (verbose : bool) = false;
  (format : String) = String.from("html");
  (version : String) = String.new();
  (saw_input : bool) = false;
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      ((arg == "-o") || (arg == "--output")) => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("doc: --output requires a value")));
        });
        output_dir = argv(ai + usize(1));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--output=")) => {
        output_dir = arg.substring(usize(9), arg.len());
      },
      (arg == "--title") => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("doc: --title requires a value")));
        });
        title = argv(ai + usize(1));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--title=")) => {
        title = arg.substring(usize(8), arg.len());
      },
      (arg == "--document-private") => {
        include_private = true;
      },
      ((arg == "-v") || (arg == "--verbose")) => {
        verbose = true;
      },
      ((arg == "-f") || (arg == "--format")) => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("doc: --format requires a value")));
        });
        format = argv(ai + usize(1));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--format=")) => {
        format = arg.substring(usize(9), arg.len());
      },
      (arg == "--version") => {
        if((ai + usize(1)) >= argv.len(), {
          exn.throw(dyn(String.from("doc: --version requires a value")));
        });
        version = argv(ai + usize(1));
        ai = (ai + usize(1));
      },
      arg.starts_with(String.from("--version=")) => {
        version = arg.substring(usize(10), arg.len());
      },
      arg.starts_with(String.from("-")) => {
        exn.throw(dyn(`doc: unknown option '${arg}'. Usage: yo doc [path] [-o <dir>] [--title <t>] [--document-private] [-v] [-f html|markdown|json] [--version <v>]`));
      },
      true => {
        if(saw_input, {
          exn.throw(dyn(`doc: unexpected extra positional '${arg}'`));
        });
        input = arg.clone();
        saw_input = true;
      }
    );
    ai = (ai + usize(1));
  });
  if(!((format == "html") || (format == "markdown") || (format == "json")), {
    exn.throw(dyn(`doc: invalid --format '${format}' (choices: html, markdown, json)`));
  });
  run_doc(
    DocCommandOptions(
      input : input,
      output_dir : output_dir,
      include_private : include_private,
      verbose : verbose,
      title : title,
      format : format,
      version : version
    ),
    io,
    exn
  );
});
/// The `version` subcommand — mirrors src/yo-cli.ts's `version [action] [value]`:
/// no action prints the current + pinned version; pin/install/list/clean
/// manage the GitHub-Releases-backed native-bundle cache
/// (plans/P3_DISTRIBUTION.md item 2).
run_version_cmd :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  (action : String) = String.from("");
  (value : String) = String.from("");
  (remote : bool) = false;
  (vi : usize) = usize(2);
  while(vi < argv.len(), {
    a := argv(vi);
    cond(
      (a == "--remote") => {
        remote = true;
        vi = (vi + usize(1));
      },
      a.starts_with("-") => {
        exn.throw(dyn(`version: unknown option '${a}'`));
        vi = (vi + usize(1));
      },
      (action == "") => {
        action = a.clone();
        vi = (vi + usize(1));
      },
      true => {
        value = a.clone();
        vi = (vi + usize(1));
      }
    );
  });
  version_cwd := match(
    proc_env.get(`YO_ORIGINAL_CWD`),
    .Some(oc) => oc,
    .None => match(cwd(), .Ok(cp) => cp.to_string(), .Err(_) => String.from("."))
  );
  if(action == "", {
    current := String.from(CURRENT_YO_VERSION);
    println(`Yo ${current}`);
    pinned := io.await(read_yo_version(Path.new(version_cwd.clone()), io, exn), IoExn(io : io, exn : exn));
    match(
      pinned,
      .Some(pv) => if(pv == current, {
        println(`.yo-version: ${pv} (matches current)`);
      }, {
        println(`.yo-version: ${pv} (current: ${current})`);
      }),
      .None => println(String.from("No .yo-version file found in project."))
    );
    return(());
  });
  cond(
    (action == "pin") => {
      version_to_pin := if(value == "", String.from(CURRENT_YO_VERSION), value.clone());
      if(value != "", {
        remote_versions := io.await(fetch_remote_versions(io, exn), IoExn(io : io, exn : exn));
        (found_pin : bool) = false;
        (rvi : usize) = usize(0);
        while(rvi < remote_versions.len(), {
          match(
            remote_versions.get(rvi),
            .Some(rv) => if(rv == version_to_pin, {
              found_pin = true;
            }),
            .None => ()
          );
          rvi = (rvi + usize(1));
        });
        if(!(found_pin), {
          exn.throw(dyn(`Error: Yo version ${version_to_pin} is not available. Run \`yo version list --remote\` to see the published releases.`));
        });
      });
      io.await(write_file(Path.new(`${version_cwd}/.yo-version`), `${version_to_pin}\n`, io), IoExn(io : io, exn : exn));
      println(`Pinned Yo version to ${version_to_pin} in .yo-version`);
    },
    (action == "install") => {
      if(value == "", {
        exn.throw(dyn(String.from("Error: Specify a version to install.\nUsage: yo version install <version>")));
      });
      already := io.await(is_version_cached(value.clone(), io, exn), IoExn(io : io, exn : exn));
      if(already, {
        println(`Yo v${value} is already cached.`);
      }, {
        _dir := io.await(ensure_cached_version(value.clone(), io, exn), IoExn(io : io, exn : exn));
      });
    },
    (action == "list") => {
      current_v := String.from(CURRENT_YO_VERSION);
      if(remote, {
        remote_versions := io.await(fetch_remote_versions(io, exn), IoExn(io : io, exn : exn));
        println(String.from("Available releases:"));
        (li : usize) = usize(0);
        while(li < remote_versions.len(), {
          match(
            remote_versions.get(li),
            .Some(rv) => {
              cached_mark := if(io.await(is_version_cached(rv.clone(), io, exn), IoExn(io : io, exn : exn)), String.from(" (cached)"), String.from(""));
              current_mark := if(rv == current_v, String.from(" (current)"), String.from(""));
              println(`  ${rv}${current_mark}${cached_mark}`);
            },
            .None => ()
          );
          li = (li + usize(1));
        });
      }, {
        cached_list := io.await(list_cached_versions(io, exn), IoExn(io : io, exn : exn));
        if(cached_list.len() == usize(0), {
          println(String.from("No cached versions. Use `yo version install <version>` to cache a version."));
        }, {
          println(String.from("Cached versions:"));
          (ci : usize) = usize(0);
          while(ci < cached_list.len(), {
            match(
              cached_list.get(ci),
              .Some(cv) => {
                current_mark2 := if(cv == current_v, String.from(" (current)"), String.from(""));
                println(`  ${cv}${current_mark2}`);
              },
              .None => ()
            );
            ci = (ci + usize(1));
          });
        });
      });
    },
    (action == "clean") => {
      if(value != "", {
        was_cached := io.await(is_version_cached(value.clone(), io, exn), IoExn(io : io, exn : exn));
        if(!(was_cached), {
          println(`Yo v${value} is not cached.`);
        }, {
          io.await(clean_version_cache(Option(String).Some(value.clone()), io, exn), IoExn(io : io, exn : exn));
          println(`Removed cached Yo v${value}.`);
        });
      }, {
        cached_list2 := io.await(list_cached_versions(io, exn), IoExn(io : io, exn : exn));
        if(cached_list2.len() == usize(0), {
          println(String.from("No cached versions to remove."));
        }, {
          io.await(clean_version_cache(Option(String).None, io, exn), IoExn(io : io, exn : exn));
          println(`Removed ${cached_list2.len().to_string()} cached version(s).`);
        });
      });
    },
    true => {
      exn.throw(dyn(`Unknown action: ${action}\nAvailable actions: pin, install, list, clean`));
    }
  );
});
/// The top-level usage text (mirrors the TS `.usage(...)` block,
/// src/yo-cli.ts:209-281; the `help` cli-case golden pins this output).
_top_level_help_text :: (fn() -> String)({
  (h : String) = String.from("The Yo Programming Language ");
  h.push_str(CURRENT_YO_VERSION);
  h.push_string(
    `
Usage:

yo compile <file> [options]      Compile a '.yo' file
Examples:
  $ yo compile main.yo -o app
  $ yo compile main.yo -cc clang -o app
  $ yo compile main.yo --target x86_64-linux-gnu -o app
  $ yo compile main.yo -l m -o app
  $ yo compile main.yo -I./include -L./lib -l mylib -o app
  $ yo compile main.yo --release -D NDEBUG -o app
  $ yo compile main.yo -g -o app_debug
  $ yo compile main.yo --release -s --cflags='-march=native' -o app

yo build [steps] [options]       Build project using build.yo
Examples:
  $ yo build                     Build all artifacts (default: install step)
  $ yo build run                 Build and run the application
  $ yo build test                Run the test suite
  $ yo build --list-steps        Show available build steps
  $ yo build --summary           Print build summary tree
  $ yo build -Dstrip=true        Pass build option to build.yo

yo init [dir] [options]          Initialize a new Yo project
Examples:
  $ yo init                      Initialize in current directory
  $ yo init my-project           Initialize in ./my-project

yo fetch [options]               Fetch git dependencies into .yo-cache
Examples:
  $ yo fetch                     Fetch all dependencies from build.yo
  $ yo fetch --verbose           Show detailed fetch progress
  $ yo fetch --update            Re-resolve refs to latest commits

yo install <package>             Install a dependency from GitHub
Examples:
  $ yo install github.com/user/repo          Latest semver tag
  $ yo install github.com/user/repo@v1.0.0   Pinned version
  $ yo install user/repo                     Shorthand for GitHub

yo test [path] [options]         Run tests
Example:
  $ yo test                      Run all *.test.yo files in the workspace
  $ yo test ./tests              Run all *.test.yo files in ./tests directory
  $ yo test ./some-file.yo       Run tests in some-file.yo

yo fmt [paths...] [options]      Format Yo source files
Examples:
  $ yo fmt                       Format all .yo files in the current directory
  $ yo fmt src tests             Format .yo files under src and tests
  $ yo fmt --check               Check formatting without writing files

yo doc [path] [options]          Generate API documentation
Examples:
  $ yo doc                       Document all .yo files in current directory
  $ yo doc ./src                 Document all .yo files in ./src
  $ yo doc ./src/main.yo         Document a single file
  $ yo doc -o docs               Output to ./docs directory
  $ yo doc --title "My Project"  Set doc site title

yo version                       Manage Yo versions
Examples:
  $ yo version                     Show current version and .yo-version
  $ yo version pin                 Pin current version to .yo-version
  $ yo version pin 0.1.12          Pin specific version
  $ yo version install 0.1.12      Pre-download a version
  $ yo version list                List cached versions
  $ yo version clean               Remove all cached versions

yo --help                        Show this help message
yo --version                     Show version number`
  );
  h
});
main :: (fn(io : Io) -> unit)({
  exn := Exception(
    throw : (
      (err) -> {
        eprintln(`yo: error: ${err.to_string()}`);
        unsafe(exit(int(1)));
        unwind();
      }
    )
  );
  raw_argv := args();
  // Global `--std-path <dir>` flag: strip it from argv before subcommand
  // dispatch and stash the override with the module manager. The TS
  // counterpart is the root-level yargs `std-path` option in `yo-cli.ts`.
  argv := ArrayList(String).new();
  ai := usize(0);
  while(ai < raw_argv.len(), {
    a := raw_argv(ai);
    if(a == "--std-path", {
      if((ai + usize(1)) < raw_argv.len(), {
        set_std_path_override(raw_argv(ai + usize(1)).clone());
        ai = (ai + usize(1));
      }, {
        exn.throw(dyn(`--std-path requires a directory argument`));
      });
    }, {
      argv.push(a);
    });
    ai = (ai + usize(1));
  });
  // Top-level `--help` / `--version` (TS: yargs `.help()` + the version
  // middleware, src/yo-cli.ts:1354-1372) — checked BEFORE the subcommand
  // demand so `yo --help` exits 0 with the usage text instead of erroring.
  if((argv.len() >= usize(2)) && ((argv(usize(1)) == "--help") || (argv(usize(1)) == "-h")), {
    println(_top_level_help_text());
    return(());
  });
  if((argv.len() >= usize(2)) && (argv(usize(1)) == "--version"), {
    println(`yo ${String.from(CURRENT_YO_VERSION)}`);
    return(());
  });
  if(argv.len() < usize(2), {
    exn.throw(dyn(`no subcommand given. Usage: yo <compile|test|fmt|check|init|build|fetch|install|cache|doc|version|unsafe-report|public-safe-report> ...`));
  });
  subcmd := argv(usize(1));
  // .yo-version PRE-DISPATCH (src/yo-cli.ts:118-195 parity): before any
  // subcommand runs, a project pinning a DIFFERENT version re-dispatches to
  // that version's cached native binary. Skipped for `version` itself, for
  // --help/--version (handled above), and when already dispatched.
  if(((subcmd != "version") && (subcmd != "lsp")) && match(proc_env.get(`YO_VERSION_DISPATCHED`), .Some(dv) => (dv != "1"), .None => true), {
    dispatch_cwd := match(
      proc_env.get(`YO_ORIGINAL_CWD`),
      .Some(oc) => oc,
      .None => match(cwd(), .Ok(cp) => cp.to_string(), .Err(_) => String.from("."))
    );
    pin_exn := Exception(throw : ((_pe) -> unwind(())));
    pinned_opt := io.await(read_yo_version(Path.new(dispatch_cwd.clone()), io, pin_exn), IoExn(io : io, exn : pin_exn));
    match(
      pinned_opt,
      .Some(pinned_v) => if(pinned_v != String.from(CURRENT_YO_VERSION), {
        cached_dir := io.await(ensure_cached_version(pinned_v.clone(), io, exn), IoExn(io : io, exn : exn));
        bin_path := cached_binary_path(cached_dir);
        bin_found := io.await(exists(Path.new(bin_path.clone()), io), io);
        if(!(bin_found), {
          exn.throw(dyn(`Error: Cached Yo v${pinned_v} is missing its compiler binary at ${bin_path}`));
        });
        _e1 := proc_env.set(String.from("YO_VERSION_DISPATCHED"), String.from("1"));
        _e2 := proc_env.set(String.from("YO_ORIGINAL_CWD"), dispatch_cwd.clone());
        dcmd := Command.new(bin_path.clone());
        (dai : usize) = usize(1);
        while(dai < argv.len(), {
          dcmd.arg(argv(dai));
          dai = (dai + usize(1));
        });
        dst := io.await(dcmd.status(io), IoExn(io : io, exn : exn));
        unsafe(exit(int(dst.raw)));
      }),
      .None => ()
    );
  });
  if(subcmd == "compile", {
    run_compile(argv, io, exn);
  }, if(subcmd == "test", {
    run_test(argv, io, exn);
  }, if(subcmd == "fmt", {
    run_fmt(argv, io, exn);
  }, if(subcmd == "check", {
    run_check(argv, io, exn);
  }, if(subcmd == "init", {
    run_init(argv, io, exn);
  }, if(subcmd == "build", {
    run_build_cmd(argv, io, exn);
  }, if(subcmd == "fetch", {
    run_fetch_cmd(argv, io, exn);
  }, if(subcmd == "install", {
    run_install_cmd(argv, io, exn);
  }, if(subcmd == "cache", {
    run_cache(argv, io, exn);
  }, if(subcmd == "doc", {
    run_doc_cmd(argv, io, exn);
  }, if(subcmd == "unsafe-report", {
    run_unsafe_report_cmd(argv, io, exn);
  }, if(subcmd == "public-safe-report", {
    run_public_safe_report_cmd(argv, io, exn);
  }, if(subcmd == "version", {
    run_version_cmd(argv, io, exn);
  }, {
    exn.throw(dyn(`unknown subcommand '${subcmd}'. Usage: yo <compile|test|fmt|check|init|build|fetch|install|cache|doc|version|unsafe-report|public-safe-report> ...`));
  })))))))))))));
});
export(main);
