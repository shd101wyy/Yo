//! yo-self — Phase 5b CLI entry point for the self-hosted Yo compiler.
//!
//! Usage:
//!   yo-self compile <input.yo> [-o output]
//!   yo-self test <test.yo> [--test-name-pattern <pattern>]
//!
//! compile: Reads a `.yo` source file, parses it with the self-hosted parser,
//!   generates C11 with compile_module_to_c, writes C to a temp file,
//!   compiles it with the system C compiler, and produces an output binary.
//!
//! test: Parses a `.test.yo` file, extracts `test("name", { body })` declarations,
//!   compiles each test body to a standalone C program, and reports pass/fail.
//!   Only supports pure tests (no Io effects, no struct methods) in Phase 5b.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/error"));
open(import("std/fmt"));
{ args } :: import("std/env");
{ Path } :: import("std/path");
{ read_file, write_file, exists } :: import("std/fs/file");
{ metadata } :: import("std/fs/metadata");
{ read_dir, FileType } :: import("std/fs/dir");
{ Command } :: import("std/process/command");
{ exit, getenv } :: import("std/libc/stdlib");
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, BK_OPEN, BK_IMPORT } :: import("./expr.yo");
{ ExprInfoTable, expr_info_table_new } :: import("./expr_info.yo");
{ TokenKind } :: import("./token.yo");
{ parse } :: import("./parser.yo");
{ Environment, clone_env, build_prelude_var_cache } :: import("./env.yo");
// Cached prelude env — populated on first check, reused thereafter.
(g_cached_prelude_env : Option(Environment)) = Option(Environment).None;
// Demand-driven module loader state (set per `check_single_file` run). The
// import handler `ctx.load_module` has a fixed `(path) -> LoadModuleResult`
// signature with no `io`/`exn`, so the loading context is stashed here for the
// on-demand load path. This enables CIRCULAR imports: a module is registered as
// "loading" (with its live env) before its body runs, so a cyclic import reads
// its partial exports instead of failing "module not preloaded".
(g_loader_io : Option(Io)) = Option(Io).None;
(g_loader_std_path : Option(String)) = Option(String).None;
(g_loader_exn : Option(Exception)) = Option(Exception).None;
// Shared ExprInfoTable for codegen: when set (during `compile`), every
// demand-loaded module's eval context writes its per-expression metadata into
// THIS one table instead of a fresh per-module table. Codegen emits the bodies
// of functions collected across ALL modules (e.g. std `println`/`to_string`),
// so their ExprInfo must live in a single table. ExprIds are globally unique
// (alloc_global_expr_id), so a shared table has no cross-module key collisions.
// `.None` during `check`/`test` (each file keeps its own table).
(g_shared_expr_info_table : Option(ExprInfoTable)) = Option(ExprInfoTable).None;
{ EvalContext, eval_context_new, LoadModuleResult } :: import("./evaluator/context.yo");
{ register_evaluate_expression } :: import("./evaluator/exprs/_expr.yo");
{ evaluate_anonymous_module_begin_exprs } :: import("./evaluator/values/anonymous_module.yo");
{ resolve_module_path, ModuleResolveResult, _build_module_val_from_env } :: import("./evaluator/exprs/import.yo");
{ clear_module_cache, module_cache_has, register_module, load_module_from_cache, register_loading, unregister_loading, loading_env } :: import("./evaluator/module_loader.yo");
{ EvalValue } :: import("./value.yo");
{ TypeValue } :: import("./types/definitions.yo");
{ format_yo_source, format_yo_files, FormatYoFilesOptions } :: import("./formatter.yo");
{ host_target, parse_target, TargetInfo, is_target_linux, is_target_windows } :: import("./target.yo");
{ compile_module } :: import("./codegen/codegen_c.yo");
{ panic, assert } :: import("std/assert");
// Temporary C source path used during compilation.
C_TMP :: "/tmp/yo_self_out.c";
extract_bare_import_path :: (fn(e : AstExpr) -> Option(String))(
  match(
    e,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, func_box, fn_imp_args, is_infix, _) => cond(
      is_infix => Option(String).None,
      (fn_imp_args.len() != usize(1)) => Option(String).None,
      (
        !(
          match(
            func_box,
            .Atom(_, tok) => (tok.value == BK_IMPORT),
            .FnCall(_, _, _, _, _) => false
          )
        )
      ) => Option(String).None,
      true => match(
        fn_imp_args.get(usize(0)),
        .None => Option(String).None,
        .Some(path_arg) => match(
          path_arg,
          .FnCall(_, _, _, _, _) => Option(String).None,
          .Atom(_, ptok) => {
            raw := ptok.value.clone();
            n := raw.len();
            cond(
              (n < usize(2)) => Option(String).None,
              true =>.Some(raw.substring(usize(1), n - usize(1)))
            )
          }
        )
      )
    )
  )
);
/// Extract the import path from any import form:
///   - `{ Names } :: import("path")` (infix `::`, RHS is import call)
///   - `open(import("path"))` (`open` wrapping import call)
///   - `import("path")` (bare import call)
/// Returns the path without surrounding quotes, or .None if not an import expression.
extract_import_path :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, func_box, fn_imp_args, is_infix, _) => {
      fval := match(
        func_box,
        .Atom(_, tok) => tok.value.clone(),
        .FnCall(_, _, _, _, _) => String.new()
      );
      cond(
        // Pattern: open import "path"
        ((fval == BK_OPEN) && (fn_imp_args.len() >= usize(1))) =>
          match(
            fn_imp_args.get(usize(0)),
            .None => Option(String).None,
            .Some(inner) => extract_bare_import_path(inner)
          ),
        // Pattern: { Names } :: import "path" (infix ::)
        (((fval == "::") && is_infix) && (fn_imp_args.len() >= usize(2))) =>
          match(
            fn_imp_args.get(usize(1)),
            .None => Option(String).None,
            .Some(rhs) => extract_bare_import_path(rhs)
          ),
        // Pattern: bare import "path"
        true => extract_bare_import_path(expr)
      )
    }
  )
);
export(extract_bare_import_path, extract_import_path);
/// Recursively collect every `import(...)` path reachable from `expr`,
/// including imports NESTED inside `impl({...})` / module / `begin`
/// bodies. `extract_import_path` only inspects a single expression, so a
/// top-level-only walk misses e.g. `env :: impl({ { getenv, setenv } ::
/// import("./libc/stdlib"); ... })` — the import lives inside the impl
/// body, not at module top level. The preload step (main.yo) needs these
/// nested imports cached, otherwise `evaluate_import` fails with
/// "module not preloaded" when the impl body is evaluated.
///
/// Paths may appear more than once (e.g. a `{ ... } :: import(p)` node
/// yields `p`, and recursing into its `import(p)` child yields `p`
/// again); callers dedup by resolved path.
collect_import_paths_recursive :: (
  fn(expr : AstExpr, out : ArrayList(String)) -> unit
)({
  match(
    extract_import_path(expr),
    .Some(p) => {
      out.push(p);
    },
    .None => ()
  );
  match(
    expr,
    .Atom(_, _) => (),
    .FnCall(_, fb, walk_args, _, _) => {
      recur(fb, out);
      (i : usize) = usize(0);
      while(i < walk_args.len(), {
        match(
          walk_args.get(i),
          .Some(a) => recur(a, out),
          .None => ()
        );
        i = (i + usize(1));
      });
    }
  );
});
export(collect_import_paths_recursive);
// Temporary binary path used for test execution.
TEST_BIN_TMP :: "/tmp/yo_self_test_bin";
/// Derive a simple module ID string from a file path String.
/// For Phase 5a/5b: returns a fixed safe C identifier — sufficient for compilation.
module_id_from_path :: (fn(path : String) -> String)(
  // path reserved for future use (filename stem extraction)
  String.from("yo_module")
);
/// Resolve the path to the `std/` directory at the time the bootstrap
/// binary runs. The proper evaluator needs this so `import("std/...")`
/// can be satisfied — without it, prelude can't be loaded and the
/// majority of user code references (`Option`, `Box`, `+`, …) fail
/// with "Variable not found".
///
/// Lookup order (mirrors TS `evaluator/index.ts:142`):
///   1. `YO_STD` env var, if set and non-empty.
///   2. `./std` relative to the current working directory.
resolve_std_path :: (fn() -> String)({
  name_cstr := String.from("YO_STD").to_cstr().ptr().unwrap();
  val_ptr := unsafe(getenv(*(char)(name_cstr)));
  match(
    val_ptr,
    .None => String.from("./std"),
    .Some(ptr) => {
      v := String.from_cstr(*(u8)(ptr)).unwrap();
      cond(
        (v.len() > usize(0)) => v,
        true => String.from("./std")
      )
    }
  )
});
/// Stream A: try to populate the typed AST metadata table by running the
/// proper evaluator over the parsed top-level expressions. On any failure
/// (the evaluator's coverage of real source files is still incomplete),
/// return `.None` so the codegen dispatcher uses its AST-only bootstrap
/// heuristics. See `plans/BOOTSTRAPPING.md` Path Forward Stream A.
try_populate_expr_info_table :: (
  fn(
    exprs : ArrayList(AstExpr),
    module_path : String
  ) -> Option(ExprInfoTable)
)({
  // Local exception handler: on any throw from the evaluator, unwind this
  // helper with `.None`. The handler is scoped to this function so the
  // outer compile / test pipeline keeps its own top-level handler intact.
  local_exn := Exception(
    throw : (
      (_err) -> unwind(Option(ExprInfoTable).None)
    )
  );
  // Build a fresh Environment + EvalContext for this compilation. std_path
  // is resolved from `YO_STD` (or `./std` fallback) so the modular import
  // handler can find `std/...` modules. The local exception unwind catches
  // any evaluator coverage gap (e.g. unported HKT/RC features in prelude).
  env := Environment.new(module_path);
  ctx := eval_context_new(resolve_std_path(), module_path);
  ctx.is_executing = true;
  // Wire the proper expression-evaluator function pointer.
  register_evaluate_expression();
  // Drive the module body through the proper evaluator. We discard the
  // returned AnonModuleResult and just keep the table that
  // `ctx.expr_info_table` accumulated as a side effect.
  _r := evaluate_anonymous_module_begin_exprs(
    exprs,
    env,
    ctx,
    false,
    false,
    local_exn
  );
  Option(ExprInfoTable).Some(ctx.expr_info_table)
});
/// Extract the test name string from a `test("name", { body })` expression.
/// Returns None if the expression is not a 2-arg test call.
extract_test_name :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, func_box, fn_args, is_infix, _) => cond(
      (is_infix) => Option(String).None,
      (fn_args.len() < usize(2)) => Option(String).None,
      (
        !(
          match(
            func_box,
            .Atom(_, ftok) => (ftok.value == "test"),
            .FnCall(_, _, _, _, _) => false
          )
        )
      ) => Option(String).None,
      true => match(
        fn_args.get(usize(0)),
        .None => Option(String).None,
        .Some(name_expr) => match(
          name_expr,
          .FnCall(_, _, _, _, _) => Option(String).None,
          .Atom(_, ntok) => cond(
            (ntok.kind == TokenKind.StringLit) => {
              // StringLit token values include surrounding double-quotes: "name"
              // Strip them with substring(1, len-1).
              n := ntok.value.len();
              cond(
                (n >= usize(2)) =>.Some(ntok.value.substring(usize(1), n - usize(1))),
                true =>.Some(ntok.value)
              )
            },
            true => Option(String).None
          )
        )
      )
    )
  )
);
/// Extract the test body expression from a `test("name", { body })` call.
/// Returns the second argument (the body expression).
extract_test_body :: (fn(expr : AstExpr) -> Option(AstExpr))(
  match(
    expr,
    .Atom(_, _) => Option(AstExpr).None,
    .FnCall(_, _, fn_args, _, _) => cond(
      (fn_args.len() < usize(2)) => Option(AstExpr).None,
      true => fn_args.get(usize(1))
    )
  )
);
// ---------------------------------------------------------------------------
// Phase 5g: import resolution helpers
// ---------------------------------------------------------------------------
/// Normalize an import path: append `.yo` if not already present.
normalize_import_path :: (fn(path_str : String) -> String)(
  cond(
    (path_str.ends_with(".yo") || path_str.ends_with(".test.yo")) => path_str.clone(),
    true => `${path_str}.yo`
  )
);
/// Recursively collect all transitive module declarations for a given import.
///
/// - `path_str`: unquoted import path (e.g. `"../types/tags.yo"`)
/// - `base_dir`: directory of the importing file (for relative path resolution)
/// - `visited`: pointer to set of already-visited absolute paths (deduplication)
/// - `all_exprs`: pointer to accumulator; declarations are appended in post-order
///
/// Skips `std/` imports — those are provided by the C preamble headers.
/// Uses DFS post-order so each module's dependencies appear before it.
collect_module_deps :: (
  fn(
    path_str : String,
    base_dir : String,
    std_base : String,
    visited : ArrayList(String),
    all_exprs : ArrayList(AstExpr),
    io : Io,
    exn : Exception
  ) -> unit
)({
  // Standard library imports: when std_base is empty, skip (legacy behavior —
  // codegen handles std symbols via the C preamble). When std_base is set,
  // rewrite `std/foo` → `{std_base}/foo` and follow it like a regular dep so
  // the evaluator can see prelude/std declarations.
  (effective_path : String) = path_str.clone();
  (effective_base : String) = base_dir.clone();
  if(path_str.starts_with("std/"), {
    if(std_base.bytes_len() == usize(0), {
      return(());
    });
    rest := path_str.substring(usize(4), path_str.len());
    effective_path = rest.clone();
    effective_base = std_base.clone();
  });
  // Normalize extension: append .yo if missing
  norm_path := normalize_import_path(effective_path.clone());
  // Resolve absolute path by normalizing base_dir/norm_path as one string.
  // Path.new normalizes ".." segments, which is needed for relative imports like "../types/tags.yo".
  // (Path.join does NOT re-normalize ".." in the second argument.)
  abs_path_raw := Path.new(`${effective_base}/${norm_path}`).to_string();
  // When std_base is empty, also skip paths that resolve into std/ (e.g.
  // relative imports like "../string" from within std/imm/). With std_base
  // set, std/ resolves into std_base and these paths should be followed.
  if((std_base.bytes_len() == usize(0)) &&
    abs_path_raw.clone().starts_with(String.from("std/")), {
    return(());
  });
  // Handle directory modules: if path.yo doesn't exist but path/index.yo does, use the latter.
  (abs_path : String) = abs_path_raw.clone();
  (file_found : bool) = io.await(exists(Path.new(abs_path_raw.clone()), io), io);
  if(!(file_found), {
    // Strip the trailing .yo (3 chars) to get the base name, then try index.yo
    base_len := abs_path_raw.len();
    base_no_ext := abs_path_raw.substring(usize(0), base_len - usize(3));
    index_path := `${base_no_ext}/index.yo`;
    index_found := io.await(exists(Path.new(index_path), io), io);
    cond(
      index_found => {
        abs_path = index_path;
      },
      true => {
        return(());
      }
    );
  });
  // Deduplication: skip if already visited (also handles import cycles)
  nv := visited.len();
  (iv : usize) = usize(0);
  (already_visited : bool) = false;
  while((iv < nv) && (!(already_visited)), {
    iv = (iv + usize(1));
    match(
      visited.get(iv - usize(1)),
      .None => (),
      .Some(v) => {
        if(v == abs_path, {
          already_visited = true;
        });
      }
    );
  });
  if(already_visited, {
    return(());
  });
  // Mark as visited before recursing (prevents infinite loops on cycles)
  visited.push(abs_path.clone());
  // Compute the base directory of the imported module for recursive resolution
  mod_base_dir := match(
    Path.new(abs_path.clone()).parent(),
    .None => String.from("."),
    .Some(p) => p.to_string()
  );
  // Read and parse the imported module
  src_bytes := io.await(read_file(Path.new(abs_path.clone()), io), IoExn(io : io, exn : exn));
  src := String.from_bytes(src_bytes);
  mod_exprs := parse(src, mod_base_dir.clone(), exn);
  // Recursively collect dependencies of this module first (post-order DFS)
  nm := mod_exprs.len();
  (im : usize) = usize(0);
  while(im < nm, {
    im = (im + usize(1));
    match(
      mod_exprs.get(im - usize(1)),
      .None => (),
      .Some(e) => match(
        extract_import_path(e),
        .None => (),
        .Some(child_path) => {
          recur(
            child_path.clone(),
            mod_base_dir.clone(),
            std_base,
            visited,
            all_exprs,
            io,
            exn
          );
        }
      )
    );
  });
  // Append this module's declarations to all_exprs (after its deps)
  im = usize(0);
  while(im < nm, {
    im = (im + usize(1));
    match(
      mod_exprs.get(im - usize(1)),
      .None => (),
      .Some(e) => {
        all_exprs.push(e);
      }
    );
  });
});
/// Pre-evaluate the dependency tree rooted at `import_path` (as written
/// in an importing file) and register each module's exports in the
/// module-loader cache, so a later `import("…")` resolved by
/// `evaluate_import` finds *just that module's exports* (not the whole
/// flatten-eval env).
///
/// This is the orchestration half of the per-module-isolation design
/// (see `evaluator/module_loader.yo`): it performs the I/O (reading +
/// parsing dependency files) and the per-module evaluation that the
/// pure `ctx.load_module` callback cannot. Post-order DFS guarantees a
/// module's own dependencies are registered before it is evaluated, so
/// its `import("…")` calls hit the cache.
///
/// `base_dir` is the directory of the *importing* file, used to resolve
/// relative paths — and chosen so the resolved `file://` key matches the
/// one `evaluate_import` will compute for the same import.
// Function-pointer slot for the demand loader. `demand_load_module` and
// `_load_module_at_abs` are mutually recursive (the loader sets
// `ctx.load_module` to itself for nested imports) and yo has no forward refs,
// so the loader is wired through this slot (set in the init IIFE below).
(g_demand_loader : Option((fn(path : String) -> LoadModuleResult))) =
  Option((fn(path : String) -> LoadModuleResult)).None;
/// Evaluate a module's top-level exprs, catching any evaluator error
/// locally so the caller can unregister the currently-loading entry
/// before re-throwing. Success: pushes the module value to `out`.
/// Failure: the handler PRINTS the error (handlers cannot capture
/// outer runtime vars, and an unwound String loses its Rc storage)
/// and unwinds — `out` stays empty, which is the caller's signal.
_eval_module_exprs_capturing_error :: (
  fn(
    mod_exprs : ArrayList(AstExpr),
    env : Environment,
    ctx : EvalContext,
    out : ArrayList(EvalValue),
    out_tys : ArrayList(TypeValue)
  ) -> bool
)({
  // Same handler shape as `check_single_file`'s top-level handler:
  // print the error, unwind a bool. Handlers cannot reference outer
  // runtime variables (locals OR module globals), and an unwound String
  // loses its Rc storage — printing here is the only way to preserve
  // the message.
  local_exn := Exception(
    throw : (
      (err) -> {
        eprintln(`check: error in: ${err.to_string()}`);
        unwind(false)
      }
    )
  );
  result := evaluate_anonymous_module_begin_exprs(mod_exprs, env, ctx, false, false, local_exn);
  out.push(result.module_value);
  ___t := out_tys.push(result.module_type);
  true
});
/// Read + parse + evaluate the module at resolved abs `file://` path `abs` and
/// register its exports. Registers it as "loading" (with its live env) BEFORE
/// evaluating, so a circular import resolves to its partial exports. Uses the
/// loader io / std_path / exn stashed by `check_single_file`.
_load_module_at_abs :: (fn(abs : String) -> unit)({
  if(abs.ends_with(String.from("prelude.yo")), {
    return(());
  });
  if(module_cache_has(abs.clone()), {
    return(());
  });
  io := match(g_loader_io,.Some(i) => i,.None => return(()));
  std_path := match(g_loader_std_path,.Some(s) => s,.None => String.from(""));
  exn := match(g_loader_exn,.Some(e) => e,.None => return(()));
  fs_path := abs.replace(String.from("file://"), String.from(""));
  src_bytes := io.await(read_file(Path.new(fs_path.clone()), io), IoExn(io : io, exn : exn));
  src := String.from_bytes(src_bytes);
  mod_exprs := parse(src, abs.clone(), exn);
  env := clone_env(match(g_cached_prelude_env,.Some(pe) => pe,.None => Environment.new(abs.clone())));
  env.module_path = abs.clone();
  ctx := eval_context_new(std_path.clone(), abs.clone());
  ctx.is_executing = true;
  ctx.load_module = g_demand_loader;
  // Codegen: route this module's per-expression metadata into the shared table
  // (see g_shared_expr_info_table). No-op during check/test.
  match(
    g_shared_expr_info_table,
    .Some(t) => {
      ctx.expr_info_table = t;
    },
    .None => ()
  );
  register_evaluate_expression();
  register_loading(abs.clone(), env);
  out_vals := ArrayList(EvalValue).new();
  out_tys := ArrayList(TypeValue).new();
  _eval_module_exprs_capturing_error(mod_exprs, env, ctx, out_vals, out_tys);
  // ALWAYS unregister — a leaked currently-loading entry poisons every
  // LATER check that imports this module: `demand_load_module` then
  // returns partial exports from the dead env (hangs/crashes; see
  // issues/fixed/yo-self-dir-check-state-corruption-after-failure.md).
  unregister_loading(abs.clone());
  match(
    out_vals.get(usize(0)),
    .Some(mv) => {
      reg_ty := match(out_tys.get(usize(0)),.Some(t) => t,.None => TypeValue.Unit);
      register_module(abs.clone(), mv, reg_ty);
    },
    .None => {
      // Root-cause detail printed by the helper's handler.
      exn.throw(dyn(`Failed to evaluate module "${abs}"`));
    }
  );
});
/// Demand-driven `ctx.load_module`. `path` is the resolved `file://` abs path
/// computed by `evaluate_import`. Cache hit -> cached exports; currently-loading
/// (cycle) -> partial exports from the module's live env; else load on demand.
demand_load_module :: (fn(path : String) -> LoadModuleResult)({
  if(module_cache_has(path.clone()), {
    return(load_module_from_cache(path));
  });
  match(
    loading_env(path.clone()),
    .Some(env) => {
      return(
        LoadModuleResult(
          module_value : _build_module_val_from_env(env),
          module_type : TypeValue.Unit,
          module_error : Option(String).None
        )
      );
    },
    .None => ()
  );
  _load_module_at_abs(path.clone());
  load_module_from_cache(path)
});
// Wire the slot (breaks the mutual-recursion forward ref).
_demand_loader_init := (fn() -> bool)({
  g_demand_loader = Option((fn(path : String) -> LoadModuleResult)).Some(demand_load_module);
  true
})();
/// Recursive helper for `collect_check_files` — walks a directory
/// tree appending each `.yo` file path to `out`.
_walk_check_dir :: (
  fn(
    dir : String,
    out : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  entries := io.await(read_dir(Path.new(dir.clone()), io), IoExn(io : io, exn : exn));
  (n : usize) = entries.len();
  (i : usize) = usize(0);
  while(i < n, {
    i = (i + usize(1));
    match(
      entries.get(i - usize(1)),
      .None => (),
      .Some(entry) => {
        full := Path.new(dir.clone()).join(Path.new(entry.name.clone())).to_string();
        match(
          entry.file_type,
          .Directory => {
            // Skip noisy infrastructure dirs (mirror src/yo-cli.ts:walkCheckDir).
            skip := cond(
              (entry.name == "node_modules") => true,
              (entry.name == "vendor") => true,
              (entry.name == ".git") => true,
              (entry.name == "vscode-extension") => true,
              (entry.name == "outdated") => true,
              true => false
            );
            if(!(skip), {
              recur(full, out, io, exn);
            });
          },
          .File => {
            // Skip dot-prefixed `.yo` files — auto-generated, not-yet-
            // cleaned-up test-batch artifacts (`.yo_test_batch_*.yo`), not
            // source. Mirrors `walkCheckDir` in `src/yo-cli.ts`.
            if((entry.name.ends_with(String.from(".yo")) || entry.name.ends_with(String.from(".test.yo"))) && !(entry.name.starts_with(String.from("."))), {
              out.push(full);
            });
          },
          .Symlink => (),
          .Other => ()
        );
      }
    );
  });
});
/// Collect every `.yo` file at or under `path_str`. If `path_str` is a
/// file, returns `[path_str]`. If it's a directory, walks recursively
/// and returns sorted absolute paths. `.test.yo` files are included
/// (they have `test("name", { body })` declarations which the
/// evaluator can still typecheck). Noisy infra dirs like
/// `node_modules`/`.git`/`vscode-extension`/`outdated` are skipped.
/// Mirrors `collectCheckFiles` in `src/yo-cli.ts`.
collect_check_files :: (
  fn(
    path_str : String,
    excludes : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> ArrayList(String)
)({
  raw := ArrayList(String).new();
  meta := io.await(metadata(Path.new(path_str.clone()), io), IoExn(io : io, exn : exn));
  cond(
    meta.is_file() => {
      if(path_str.ends_with(String.from(".yo")) || path_str.ends_with(String.from(".test.yo")), {
        raw.push(path_str.clone());
      });
    },
    meta.is_dir() => _walk_check_dir(path_str, raw, io, exn),
    true => ()
  );
  // Drop any collected path that contains an `--exclude` path as a substring
  // (so `--exclude yo-self/tests` skips that whole subtree from a directory
  // check). Mirrors the exclude filter in `collectCheckFiles` (src/yo-cli.ts);
  // yo-self lacks `path.resolve`, so this uses path-segment containment on the
  // collected absolute paths rather than resolved-prefix matching.
  out := ArrayList(String).new();
  (ri : usize) = usize(0);
  while(ri < raw.len(), {
    fp := match(raw.get(ri),.Some(p) => p,.None => String.from(""));
    (skip : bool) = false;
    (ei : usize) = usize(0);
    while((ei < excludes.len()) && !(skip), {
      ex := match(excludes.get(ei),.Some(e) => e,.None => String.from(""));
      if(!(ex.is_empty()) && fp.contains(ex), {
        skip = true;
      });
      ei = (ei + usize(1));
    });
    if(!(skip), {
      out.push(fp);
    });
    ri = (ri + usize(1));
  });
  out
});
/// Run the evaluator against a single `.yo` file. Returns `true` on
/// success; on any thrown evaluator error, catches via a local
/// exception handler and returns `false` so a directory walk keeps
/// going across files. The evaluator's own `evaluate_expression: …`
/// diagnostic has already been printed by the time the throw fires,
/// so the caller just needs to log which file failed.
check_single_file :: (
  fn(
    input_path : String,
    std_path : String,
    io : Io,
    exn : Exception
  ) -> bool
)({
  // Local exception handler escapes the function body with `false`.
  // Effect-handler bodies cannot capture outer runtime vars (per
  // Yo's `->` rule), so we can't print here — the caller logs the
  // file's pass/fail status from the bool return.
  local_exn := Exception(
    throw : (
      (err) -> {
        eprintln(`check: error in: ${err.to_string()}`);
        unwind(false)
      }
    )
  );
  println(`check: parsing ${input_path}`);
  src_bytes := io.await(read_file(Path.new(input_path.clone()), io), IoExn(io : io, exn : exn));
  src := String.from_bytes(src_bytes);
  exprs := parse(src, input_path.clone(), local_exn);
  println(`check: parsed ${exprs.len().to_string()} top-level exprs`);
  (is_prelude : bool) = input_path.ends_with(String.from("prelude.yo"));
  // ---------------------------------------------------------------------------
  // Prelude: evaluate directly and cache the resulting env. The prelude
  // is injected (cloned) into every other file's env, so it is never
  // routed through the module loader.
  // ---------------------------------------------------------------------------
  if(is_prelude, {
    prelude_env := Environment.new(input_path.clone());
    prelude_ctx := eval_context_new(std_path.clone(), input_path.clone());
    prelude_ctx.is_executing = true;
    // Route the prelude's per-expression metadata into the shared codegen table
    // when set (compile path), so codegen finds the body ExprInfo of prelude
    // functions emitted directly (e.g. `assert`). No-op for `check`/`test`
    // (g_shared is None there → prelude uses its own throwaway table).
    match(
      g_shared_expr_info_table,
      .Some(t) => {
        prelude_ctx.expr_info_table = t;
      },
      .None => ()
    );
    register_evaluate_expression();
    println(`check: invoking evaluate_anonymous_module_begin_exprs (prelude)`);
    // keep_frame_at_end=true so the prelude's bindings survive into the
    // cached env (see issues/yo-self-multi-file-prelude-bindings.md).
    _rp := evaluate_anonymous_module_begin_exprs(
      exprs,
      prelude_env,
      prelude_ctx,
      false,
      true,
      local_exn
    );
    g_cached_prelude_env = Option(Environment).Some(prelude_env);
    println(`check: ${input_path} — evaluator OK`);
    return(true);
  });
  // ---------------------------------------------------------------------------
  // Ensure the prelude env is cached (single-file checks skip the
  // run_check pre-load step).
  // ---------------------------------------------------------------------------
  if(g_cached_prelude_env.is_none(), {
    prelude_path := `${std_path}/prelude.yo`;
    _pre := recur(prelude_path, std_path.clone(), io, exn);
  });
  // ---------------------------------------------------------------------------
  // Demand-driven module loading (supports circular imports). Stash the loader
  // context (io / std_path / exn) for `demand_load_module`, register THIS file
  // as "loading" under its resolved file:// abs path BEFORE evaluating its body
  // (so a dependency that imports it back resolves to its partial exports), wire
  // `ctx.load_module` to the demand loader, then evaluate. Imports load on
  // demand during evaluation — no post-order pre-pass (cannot resolve cycles).
  // ---------------------------------------------------------------------------
  g_loader_io = Option(Io).Some(io);
  g_loader_std_path = Option(String).Some(std_path.clone());
  g_loader_exn = Option(Exception).Some(local_exn);
  entry_abs := match(
    resolve_module_path(input_path.clone(), String.from("."), std_path.clone()),
    .Found(p) => p,
    .NotFound(_) => input_path.clone(),
    .Ambiguous(_) => input_path.clone()
  );
  env := clone_env(match(g_cached_prelude_env,.Some(pe) => pe,.None => Environment.new(entry_abs.clone())));
  env.module_path = entry_abs.clone();
  ctx := eval_context_new(std_path.clone(), entry_abs.clone());
  ctx.is_executing = true;
  ctx.load_module = g_demand_loader;
  register_evaluate_expression();
  register_loading(entry_abs.clone(), env);
  println(`check: invoking evaluate_anonymous_module_begin_exprs`);
  out_vals_cf := ArrayList(EvalValue).new();
  out_tys_cf := ArrayList(TypeValue).new();
  _eval_module_exprs_capturing_error(exprs, env, ctx, out_vals_cf, out_tys_cf);
  // ALWAYS unregister, error or not — a leaked currently-loading entry
  // poisons every LATER file in a directory check (see
  // issues/fixed/yo-self-dir-check-state-corruption-after-failure.md).
  unregister_loading(entry_abs.clone());
  if(out_vals_cf.len() == usize(0), {
    // Root-cause detail printed by the helper's handler.
    return(false);
  });
  println(`check: ${input_path} — evaluator OK`);
  true
});
/// Run the `check` subcommand — evaluator-only.
///
/// Accepts either a single `.yo` file or a directory. For a directory
/// the bootstrap walks `*.yo` (excluding `.test.yo`) and runs each one
/// through the evaluator; cross-file evaluator state pollution is
/// possible but acceptable for the "find evaluator coverage gaps"
/// workflow.
///
/// Exits 0 if every file passes, non-zero if any file's evaluator
/// throws.
run_check :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  if(argv.len() < usize(3), {
    exn.throw(dyn(`check: missing input file. Usage: yo-self check <input.yo | dir>`));
  });
  target_path := argv(usize(2));
  // Parse `--exclude <path>` flags (repeatable) from argv after the target.
  excludes := ArrayList(String).new();
  (ai : usize) = usize(3);
  while(ai < argv.len(), {
    a := argv(ai);
    if(a == "--exclude", {
      next_i := (ai + usize(1));
      if(next_i < argv.len(), {
        excludes.push(argv(next_i));
        ai = (ai + usize(2));
      }, {
        ai = (ai + usize(1));
      });
    }, {
      ai = (ai + usize(1));
    });
  });
  files := collect_check_files(target_path.clone(), excludes, io, exn);
  if(files.len() == usize(0), {
    exn.throw(dyn(`check: no .yo files found at ${target_path}`));
  });
  std_path := resolve_std_path();
  // Reset the per-module loader cache for this run. Keys are absolute
  // paths, so cache entries are valid for the whole run (a module
  // imported by several files is evaluated once).
  clear_module_cache();
  // Pre-load the prelude so g_cached_prelude_env is a clean prelude-only
  // environment before any file is checked. (check_single_file also
  // self-bootstraps the prelude, but doing it once here keeps the cached
  // env free of the first file's own bindings.)
  if(g_cached_prelude_env.is_none(), {
    prelude_path := `${std_path}/prelude.yo`;
    _pre := check_single_file(prelude_path, std_path.clone(), io, exn);
    // Build the O(1) prelude variable cache (called here, not inside
    // check_single_file, to avoid interference with the compile path).
    match(g_cached_prelude_env,.Some(pe) => build_prelude_var_cache(pe),.None => ());
  });
  (failed : usize) = usize(0);
  (fi : usize) = usize(0);
  total := files.len();
  while(fi < total, {
    match(
      files.get(fi),
      .None => (),
      .Some(file_path) => {
        if(!(check_single_file(file_path, std_path.clone(), io, exn)), {
          failed = (failed + usize(1));
        });
      }
    );
    fi = (fi + usize(1));
  });
  if(total > usize(1), {
    passed := (total - failed);
    println(`check: ${passed.to_string()}/${total.to_string()} file(s) passed`);
  });
  if(failed > usize(0), {
    exn.throw(dyn(`check: ${failed.to_string()} file(s) failed evaluator coverage`));
  });
});
/// The argv entry following index `i` (the value of a `--flag value` pair), or
/// "" if `i` is the last argument. Used by the `compile` flag parser.
_arg_val :: (fn(argv : ArrayList(String), i : usize) -> String)(
  if((i + usize(1)) < argv.len(), argv(i + usize(1)), String.from(""))
);
/// Run the `compile` subcommand.
run_compile :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  if(argv.len() < usize(3), {
    exn.throw(dyn(`compile: missing input file. Usage: yo-self compile <input.yo> [-o out] [--c-compiler cc] [--target <triple>] [--emit-c]`));
  });
  // Parse args. Mirrors the `compile` command options of the TypeScript
  // `yo-cli` (src/yo-cli.ts / src/codegen/index.ts) for the clang/gcc/zig path.
  (input_path : String) = String.from("");
  (output : String) = String.from("a.out");
  (cc : String) = String.from("clang");
  (target_triple : String) = String.from("");
  (sysroot : String) = String.from("");
  (allocator : String) = String.from("libc");
  (optimize : String) = String.from(""); // "" = unset; "0".."3"
  (sanitize : String) = String.from(""); // "" / "address" / "leak" / "thread"
  (cflags : String) = String.from("");
  (skip_cc : bool) = false;
  (skip_codegen : bool) = false;
  (release : bool) = false;
  (debug_gc : bool) = false;
  (debug_parallelism : bool) = false;
  (debug_async_await : bool) = false;
  (debug_symbols : bool) = false; // -g
  (strip_syms : bool) = false; // -s
  (static_link : bool) = false; // --static
  (static_library : bool) = false; // --static-library
  defines := ArrayList(String).new(); // -D
  include_paths := ArrayList(String).new(); // -I
  library_paths := ArrayList(String).new(); // -L
  libraries := ArrayList(String).new(); // -l
  externs := ArrayList(String).new(); // --extern
  (ai : usize) = usize(2);
  while(ai < argv.len(), {
    a := argv(ai);
    cond(
      (a == "-o") => {
        output = _arg_val(argv, ai);
        ai = (ai + usize(2));
      },
      ((a == "--c-compiler") || (a == "--cc")) => {
        cc = _arg_val(argv, ai);
        ai = (ai + usize(2));
      },
      ((a == "--target") || (a == "-t")) => {
        target_triple = _arg_val(argv, ai);
        ai = (ai + usize(2));
      },
      (a == "--sysroot") => {
        sysroot = _arg_val(argv, ai);
        ai = (ai + usize(2));
      },
      (a == "--allocator") => {
        allocator = _arg_val(argv, ai);
        ai = (ai + usize(2));
      },
      (a == "--optimize") => {
        optimize = _arg_val(argv, ai);
        ai = (ai + usize(2));
      },
      (a == "--sanitize") => {
        sanitize = _arg_val(argv, ai);
        ai = (ai + usize(2));
      },
      (a == "--cflags") => {
        cflags = _arg_val(argv, ai);
        ai = (ai + usize(2));
      },
      ((a == "-D") || (a == "--define")) => {
        defines.push(_arg_val(argv, ai));
        ai = (ai + usize(2));
      },
      (a == "-I") => {
        include_paths.push(_arg_val(argv, ai));
        ai = (ai + usize(2));
      },
      (a == "-L") => {
        library_paths.push(_arg_val(argv, ai));
        ai = (ai + usize(2));
      },
      (a == "-l") => {
        libraries.push(_arg_val(argv, ai));
        ai = (ai + usize(2));
      },
      (a == "--extern") => {
        externs.push(_arg_val(argv, ai));
        ai = (ai + usize(2));
      },
      ((a == "--emit-c") || (a == "--skip-c-compiler")) => {
        skip_cc = true;
        ai = (ai + usize(1));
      },
      (a == "--skip-codegen") => {
        skip_codegen = true;
        ai = (ai + usize(1));
      },
      (a == "--release") => {
        release = true;
        ai = (ai + usize(1));
      },
      (a == "--debug-gc") => {
        debug_gc = true;
        ai = (ai + usize(1));
      },
      (a == "--debug-parallelism") => {
        debug_parallelism = true;
        ai = (ai + usize(1));
      },
      (a == "--debug-async-await") => {
        debug_async_await = true;
        ai = (ai + usize(1));
      },
      ((a == "-g") || (a == "--debug-symbols")) => {
        debug_symbols = true;
        ai = (ai + usize(1));
      },
      ((a == "-s") || (a == "--strip")) => {
        strip_syms = true;
        ai = (ai + usize(1));
      },
      (a == "--static") => {
        static_link = true;
        ai = (ai + usize(1));
      },
      (a == "--static-library") => {
        static_library = true;
        ai = (ai + usize(1));
      },
      // Accepted for parity; yo-self adds no default sanitizer so it is a no-op.
      (a == "--disable-sanitize") => {
        ai = (ai + usize(1));
      },
      a.starts_with("-") => {
        ai = (ai + usize(1));
      },
      true => {
        input_path = a;
        ai = (ai + usize(1));
      }
    );
  });
  std_path := resolve_std_path();
  // Create the shared ExprInfoTable BEFORE loading the prelude, and publish it
  // via g_shared_expr_info_table now (not after the prelude load). The prelude
  // is def-eval'd inside check_single_file; routing its per-expression metadata
  // into THIS table makes codegen find the body ExprInfo of non-specialized
  // prelude functions (e.g. `assert`'s `cond(flag => (), true => panic(msg))`).
  // Previously the prelude loaded into a discarded table and g_shared was only
  // set to the entry ctx's table afterwards, so a prelude function emitted
  // directly (not re-specialized at a call site) had no cond ExprInfo →
  // "Failed to transpile cond(...)". See issues/yo-self-cond-panic-arm-codegen.md.
  shared_info_table := expr_info_table_new();
  g_shared_expr_info_table = Option(ExprInfoTable).Some(shared_info_table);
  // Ensure the prelude env is cached (provides std types to the evaluator).
  if(g_cached_prelude_env.is_none(), {
    _pre := check_single_file(`${std_path}/prelude.yo`, std_path.clone(), io, exn);
    match(g_cached_prelude_env,.Some(pe) => build_prelude_var_cache(pe),.None => ());
  });
  // Read + parse the input module.
  src_bytes := io.await(read_file(Path.new(input_path.clone()), io), IoExn(io : io, exn : exn));
  src := String.from_bytes(src_bytes);
  exprs := parse(src, input_path.clone(), exn);
  // Demand-driven module loading (mirrors check_single_file's loader setup).
  g_loader_io = Option(Io).Some(io);
  g_loader_std_path = Option(String).Some(std_path.clone());
  g_loader_exn = Option(Exception).Some(exn);
  entry_abs := match(
    resolve_module_path(input_path.clone(), String.from("."), std_path.clone()),
    .Found(p) => p,
    .NotFound(_) => input_path.clone(),
    .Ambiguous(_) => input_path.clone()
  );
  env := clone_env(match(g_cached_prelude_env,.Some(pe) => pe,.None => Environment.new(entry_abs.clone())));
  env.module_path = entry_abs.clone();
  ctx := eval_context_new(std_path.clone(), entry_abs.clone());
  ctx.is_executing = true;
  ctx.load_module = g_demand_loader;
  // Reuse the shared ExprInfoTable (created above, also used by the prelude load
  // and every demand-loaded module) so codegen has metadata for the bodies of
  // ALL collected functions — the prelude's, every imported module's, and the
  // entry module's.
  ctx.expr_info_table = shared_info_table;
  register_evaluate_expression();
  register_loading(entry_abs.clone(), env);
  out_vals := ArrayList(EvalValue).new();
  out_tys := ArrayList(TypeValue).new();
  _eval_module_exprs_capturing_error(exprs, env, ctx, out_vals, out_tys);
  unregister_loading(entry_abs.clone());
  module_value := match(
    out_vals.get(usize(0)),
    .Some(mv) => mv,
    .None => {
      exn.throw(dyn(`compile: failed to evaluate module "${input_path}"`));
      return(())
    }
  );
  // Resolve the compilation target: --target <triple> if given, else host.
  target := match(
    cond(
      (target_triple == "") => Result(TargetInfo, String).Ok(host_target()),
      true => parse_target(target_triple)
    ),
    .Ok(t) => t,
    .Err(e) => {
      exn.throw(dyn(`compile: invalid --target "${target_triple}": ${e}`));
      return(())
    }
  );
  // --skip-codegen: evaluate only (type-check), emit no C.
  if(skip_codegen, {
    return(());
  });
  // Generate C11 from the evaluated module. A static library has no main()
  // wrapper (is_library = true). Allocator + debug-logging flags are threaded
  // through to the code generator (mirrors CodeGeneratorC.compileModule).
  c_src := compile_module(module_value, ctx.expr_info_table, target, allocator.clone(), debug_gc, debug_parallelism, debug_async_await, static_library, ctx, env, exn);
  c_path := `${output}.c`;
  io.await(write_file(Path.new(c_path.clone()), c_src, io), IoExn(io : io, exn : exn));
  // --emit-c / --skip-c-compiler: write the C and stop.
  if(skip_cc, {
    return(());
  });
  // ----- assemble the C-compiler invocation (mirrors src/codegen/index.ts) ---
  std_root := resolve_std_path();
  cmd := Command.new(cc.clone());
  // `zig` is invoked as `zig cc ...`.
  if(cc == "zig", {
    cmd.arg(String.from("cc"));
  });
  cmd.arg(String.from("-std=c11"));
  cmd.arg(String.from("-fno-strict-aliasing"));
  // -fwrapv: define signed overflow as two's-complement wrap (MEMORY_SAFETY.md
  // Limitation #6); without it the optimizer may exploit overflow-UB.
  cmd.arg(String.from("-fwrapv"));
  // Optimization + warnings: explicit --optimize wins over --release; the
  // default and explicit `--optimize 0` use -O0 with the noisy warnings
  // suppressed (mirrors the TS option logic).
  cond(
    ((optimize == "") && release) => {
      cmd.arg(String.from("-w"));
      cmd.arg(String.from("-O2"));
    },
    ((optimize != "") && (optimize != "0")) => {
      cmd.arg(String.from("-w"));
      cmd.arg(`-O${optimize}`);
    },
    true => {
      cmd.arg(String.from("-Wall"));
      cmd.arg(String.from("-Wextra"));
      cmd.arg(String.from("-Wno-unused-variable"));
      cmd.arg(String.from("-Wno-unused-parameter"));
      cmd.arg(String.from("-Wno-unused-function"));
      cmd.arg(String.from("-Wno-unused-but-set-variable"));
      cmd.arg(String.from("-Wno-unused-label"));
      cmd.arg(String.from("-Wno-unused-value"));
      cmd.arg(String.from("-Wno-parentheses-equality"));
      cmd.arg(String.from("-O0"));
    }
  );
  if(debug_symbols, {
    cmd.arg(String.from("-g"));
  });
  if(strip_syms, {
    cmd.arg(String.from("-s"));
  });
  if(static_link, {
    cmd.arg(String.from("-static"));
  });
  // Sanitizers (clang/gcc; mirror of TS getSanitizerFlags for the Unix path).
  cond(
    (sanitize == "address") => {
      cmd.arg(String.from("-fsanitize=address"));
      cmd.arg(String.from("-fno-omit-frame-pointer"));
    },
    (sanitize == "leak") => cmd.arg(String.from("-fsanitize=leak")),
    (sanitize == "thread") => {
      cmd.arg(String.from("-fsanitize=thread"));
      cmd.arg(String.from("-fno-omit-frame-pointer"));
    },
    true => ()
  );
  // -I include paths, -D defines, -L library search paths.
  (ii : usize) = usize(0);
  while(ii < include_paths.len(), {
    match(include_paths.get(ii),.Some(p) => cmd.arg(`-I${p}`),.None => ());
    ii = (ii + usize(1));
  });
  (di : usize) = usize(0);
  while(di < defines.len(), {
    match(defines.get(di),.Some(d) => cmd.arg(`-D${d}`),.None => ());
    di = (di + usize(1));
  });
  (li : usize) = usize(0);
  while(li < library_paths.len(), {
    match(library_paths.get(li),.Some(p) => cmd.arg(`-L${p}`),.None => ());
    li = (li + usize(1));
  });
  // Arbitrary custom flags (--cflags "a b c").
  if(cflags != "", {
    parts := cflags.split(" ");
    (ci : usize) = usize(0);
    while(ci < parts.len(), {
      match(parts.get(ci),.Some(f) => if(f.len() > usize(0), cmd.arg(f.clone())),.None => ());
      ci = (ci + usize(1));
    });
  });
  // Bundled mimalloc allocator (else libc): add static.c + its include path.
  if(allocator == "mimalloc", {
    cmd.arg(`-I${std_root}/../vendor/mimalloc/include`);
    cmd.arg(`${std_root}/../vendor/mimalloc/src/static.c`);
  });
  // Cross-compile target / sysroot pass-through.
  if(target_triple != "", {
    cmd.arg(`--target=${target_triple}`);
  });
  if(sysroot != "", {
    cmd.arg(`--sysroot=${sysroot}`);
  });
  // --static-library: compile to a .o (-c -fPIC) then archive into a .a.
  // Otherwise compile + link into an executable.
  if(static_library, {
    obj_path := `${output}.o`;
    cmd.arg(String.from("-c"));
    if(!(is_target_windows(target)), {
      cmd.arg(String.from("-fPIC"));
    });
    cmd.arg(c_path.clone());
    cmd.arg(String.from("-o"));
    cmd.arg(obj_path.clone());
    cst := io.await(cmd.status(io), IoExn(io : io, exn : exn));
    if(cst.raw != i32(0), {
      exn.throw(dyn(`compile: C compiler failed (exit ${cst.raw.to_string()}) on ${c_path}`));
      return(())
    });
    ar_out := if(output.clone().ends_with(".a"), output.clone(), `${output}.a`);
    arcmd := Command.new(String.from("ar"));
    arcmd.arg(String.from("rcs"));
    arcmd.arg(ar_out.clone());
    arcmd.arg(obj_path.clone());
    ast := io.await(arcmd.status(io), IoExn(io : io, exn : exn));
    if(ast.raw != i32(0), {
      exn.throw(dyn(`compile: ar failed (exit ${ast.raw.to_string()}) creating ${ar_out}`));
    });
    return(())
  });
  // Executable: source + externs, output, then link libraries.
  cmd.arg(c_path.clone());
  (ei : usize) = usize(0);
  while(ei < externs.len(), {
    match(externs.get(ei),.Some(f) => cmd.arg(f.clone()),.None => ());
    ei = (ei + usize(1));
  });
  cmd.arg(String.from("-o"));
  cmd.arg(output.clone());
  cmd.arg(String.from("-lm"));
  cmd.arg(String.from("-pthread"));
  (xi : usize) = usize(0);
  while(xi < libraries.len(), {
    match(libraries.get(xi),.Some(lib) => cmd.arg(`-l${lib}`),.None => ());
    xi = (xi + usize(1));
  });
  if(is_target_windows(target), {
    cmd.arg(String.from("-lws2_32"));
    cmd.arg(String.from("-lbcrypt"));
  });
  st := io.await(cmd.status(io), IoExn(io : io, exn : exn));
  if(st.raw != i32(0), {
    exn.throw(dyn(`compile: C compiler failed (exit ${st.raw.to_string()}) on ${c_path}`));
  });
});
run_test :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  // Test execution requires the C codegen — removed with yo-self/codegen/.
  exn.throw(dyn(`test: the self-hosted codegen was removed pending the codegen port (plans/BOOTSTRAPPING_CODEGEN.md). Use 'check' for evaluator validation or the TypeScript yo-cli to run tests.`));
});
run_fmt :: (
  fn(
    argv : ArrayList(String),
    io : Io,
    exn : Exception
  ) -> unit
)({
  // Parse arguments — collect positional paths, detect --check flag.
  input_paths := ArrayList(String).new();
  (check_mode : bool) = false;
  (ai : usize) = usize(2); // skip program name + "fmt"
  while(ai < argv.len(), {
    arg := argv(ai);
    cond(
      (arg == "--check") => {
        check_mode = true;
      },
      true => {
        _r := input_paths.push(arg);
      }
    );
    ai = (ai + usize(1));
  });
  options := FormatYoFilesOptions(check : check_mode, cwd : String.from("."));
  result := format_yo_files(input_paths, options, io, exn);
  // Report.
  cn := result.changed.len();
  cond(
    check_mode => {
      (cidx : usize) = usize(0);
      while(cidx < cn, {
        match(
          result.changed.get(cidx),
          .Some(c) => println(`would format: ${c}`),
          .None => ()
        );
        cidx = (cidx + usize(1));
      });
      if(cn > usize(0), {
        unsafe(exit(int(1)));
      });
    },
    true => {
      (cidx : usize) = usize(0);
      while(cidx < cn, {
        match(
          result.changed.get(cidx),
          .Some(c) => println(`formatted: ${c}`),
          .None => ()
        );
        cidx = (cidx + usize(1));
      });
    }
  );
});
main :: (fn(io : Io) -> unit)({
  exn := Exception(
    throw : (
      (err) -> {
        eprintln(`yo-self: error: ${err.to_string()}`);
        unsafe(exit(int(1)));
        unwind();
      }
    )
  );
  argv := args();
  if(argv.len() < usize(2), {
    exn.throw(dyn(`no subcommand given. Usage: yo-self <compile|test> ...`));
  });
  subcmd := argv(usize(1));
  if(subcmd == "compile", {
    run_compile(argv, io, exn);
  }, if(subcmd == "test", {
    run_test(argv, io, exn);
  }, if(subcmd == "fmt", {
    run_fmt(argv, io, exn);
  }, if(subcmd == "check", {
    run_check(argv, io, exn);
  }, {
    exn.throw(dyn(`unknown subcommand '${subcmd}'. Usage: yo-self <compile|test|fmt|check> ...`));
  }))));
});
export(main);
