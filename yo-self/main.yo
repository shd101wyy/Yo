//! yo-self — Phase 5a CLI entry point for the self-hosted Yo compiler.
//!
//! Usage:
//!   yo-self compile <input.yo> [-o output]
//!
//! Reads a `.yo` source file, parses it with the self-hosted parser,
//! generates C11 with compile_module_to_c, writes C to a temp file,
//! compiles it with the system C compiler, and produces an output binary.

open import "std/string";
open import "std/error";
open import "std/fmt";
{ args }          :: import "std/env";
{ Path }          :: import "std/path";
{ read_file, write_file } :: import "std/fs/file";
{ Command }       :: import "std/process/command";
{ parse }         :: import "./parser/parser.yo";
{ compile_module_to_c } :: import "./codegen/driver.yo";

// Temporary C source path used during compilation.
C_TMP :: "/tmp/yo_self_out.c";

/// Derive a simple module ID string from a file path String.
/// For Phase 5a: returns a fixed safe C identifier — sufficient for compilation.
module_id_from_path :: (fn(path : String) -> String)(
  // path reserved for future use (filename stem extraction)
  // For now a fixed identifier is sufficient for C compilation.
  String.from("yo_module")
);

main :: (fn(using(io : IO)) -> unit)({
  given(exn) := Exception(throw: ((err) -> {
    eprintln(`yo-self: error: ${err.to_string()}`);
    escape ();
  }));

  argv := args();

  if((argv.len() < usize(2)), {
    exn.throw(dyn `no subcommand given. Usage: yo-self compile <input.yo> [-o output]`);
  });

  subcmd := argv.get(usize(1)).unwrap();

  if((subcmd.as_str() != "compile"), {
    exn.throw(dyn `unknown subcommand. Usage: yo-self compile <input.yo> [-o output]`);
  });

  // --- compile subcommand ---

  if((argv.len() < usize(3)), {
    exn.throw(dyn `compile: missing input file. Usage: yo-self compile <input.yo> [-o output]`);
  });

  input_path := argv.get(usize(2)).unwrap();

  // Determine output path (default: "a.out")
  (output_path : String) = `a.out`;
  if((argv.len() >= usize(5)), {
    flag := argv.get(usize(3)).unwrap();
    if((flag.as_str() == "-o"), {
      output_path = argv.get(usize(4)).unwrap();
    });
  });

  // Derive module id from input filename
  mod_id := module_id_from_path(input_path);

  // Read the input .yo file
  src_bytes := io.await(read_file(Path.new(input_path)));
  src := String.from_bytes(src_bytes);

  // Parse with the self-hosted parser
  exprs := parse(src, input_path, using(exn));

  // Generate C11 source
  opt_c := compile_module_to_c(exprs, mod_id.as_str(), "main");
  (c_src : String) = match(opt_c,
    .None => exn.throw(dyn `compile: no main function found in input file`),
    .Some(c) => c
  );

  // Write C to temp file
  io.await(write_file(Path.new(String.from(C_TMP)), c_src));

  // Compile C with system C compiler
  cc := Command.new(`cc`);
  cc.arg(String.from(C_TMP));
  cc.arg(`-o`);
  cc.arg(output_path);
  st := io.await(cc.status());
  if((!st.success()), {
    exn.throw(dyn `compile: C compilation failed`);
  });
});

export main;
