  s.push_str(".doc-section-content {\n");
  s.push_str("  font-size: 14px;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str("/* Index page */\n");
  s.push_str(".module-grid {\n");
  s.push_str("  display: grid;\n");
  s.push_str("  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n");
  s.push_str("  gap: 12px;\n");
  s.push_str("  margin: 16px 0;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str(".module-card {\n");
  s.push_str("  border: 1px solid var(--border);\n");
  s.push_str("  border-radius: 6px;\n");
  s.push_str("  padding: 16px;\n");
  s.push_str("  transition: box-shadow 0.15s;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str(".module-card:hover {\n");
  s.push_str("  box-shadow: 0 2px 8px var(--shadow);\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str(".module-card h3 {\n");
  s.push_str("  margin: 0 0 6px;\n");
  s.push_str("  font-size: 16px;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str(".module-card h3 a {\n");
  s.push_str("  color: var(--accent);\n");
  s.push_str("  text-decoration: none;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str(".module-card h3 a:hover { text-decoration: underline; }\n");
  s.push_str("\n");
  s.push_str(".module-card .module-desc {\n");
  s.push_str("  font-size: 14px;\n");
  s.push_str("  color: var(--text-secondary);\n");
  s.push_str("  line-height: 1.5;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str(".module-card .module-stats {\n");
  s.push_str("  margin-top: 8px;\n");
  s.push_str("  font-size: 12px;\n");
  s.push_str("  color: var(--text-secondary);\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str(".module-group-header {\n");
  s.push_str("  margin: 24px 0 4px;\n");
  s.push_str("  font-size: 18px;\n");
  s.push_str("  color: var(--text-secondary);\n");
  s.push_str("  border-bottom: 1px solid var(--border-light);\n");
  s.push_str("  padding-bottom: 4px;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str("/* Breadcrumb */\n");
  s.push_str(".breadcrumb {\n");
  s.push_str("  font-size: 14px;\n");
  s.push_str("  color: var(--text-secondary);\n");
  s.push_str("  margin-bottom: 16px;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str(".breadcrumb a {\n");
  s.push_str("  color: var(--accent);\n");
  s.push_str("  text-decoration: none;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str(".breadcrumb a:hover { text-decoration: underline; }\n");
  s.push_str("\n");
  s.push_str("/* Back to top */\n");
  s.push_str(".back-to-top {\n");
  s.push_str("  position: fixed;\n");
  s.push_str("  bottom: 24px;\n");
  s.push_str("  right: 24px;\n");
  s.push_str("  width: 36px;\n");
  s.push_str("  height: 36px;\n");
  s.push_str("  border-radius: 50%;\n");
  s.push_str("  background: var(--accent);\n");
  s.push_str("  color: #fff;\n");
  s.push_str("  border: none;\n");
  s.push_str("  cursor: pointer;\n");
  s.push_str("  font-size: 18px;\n");
  s.push_str("  display: none;\n");
  s.push_str("  align-items: center;\n");
  s.push_str("  justify-content: center;\n");
  s.push_str("  box-shadow: 0 2px 8px var(--shadow);\n");
  s.push_str("  z-index: 20;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str("/* Mobile menu toggle */\n");
  s.push_str(".sidebar-toggle {\n");
  s.push_str("  display: none;\n");
  s.push_str("  position: fixed;\n");
  s.push_str("  top: 12px;\n");
  s.push_str("  left: 12px;\n");
  s.push_str("  z-index: 30;\n");
  s.push_str("  background: var(--accent);\n");
  s.push_str("  color: #fff;\n");
  s.push_str("  border: none;\n");
  s.push_str("  border-radius: 6px;\n");
  s.push_str("  width: 40px;\n");
  s.push_str("  height: 40px;\n");
  s.push_str("  font-size: 20px;\n");
  s.push_str("  cursor: pointer;\n");
  s.push_str("  line-height: 1;\n");
  s.push_str("  box-shadow: 0 2px 8px var(--shadow);\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str(".sidebar-toggle:hover {\n");
  s.push_str("  background: var(--accent-hover);\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str(".sidebar-overlay {\n");
  s.push_str("  display: none;\n");
  s.push_str("  position: fixed;\n");
  s.push_str("  top: 0;\n");
  s.push_str("  left: 0;\n");
  s.push_str("  right: 0;\n");
  s.push_str("  bottom: 0;\n");
  s.push_str("  background: rgba(0,0,0,0.4);\n");
  s.push_str("  z-index: 9;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str("/* Responsive */\n");
  s.push_str("@media (max-width: 768px) {\n");
  s.push_str("  .sidebar-toggle { display: block; }\n");
  s.push_str("  .sidebar {\n");
  s.push_str("    transform: translateX(-100%);\n");
  s.push_str("    transition: transform 0.25s ease;\n");
  s.push_str("    z-index: 15;\n");
  s.push_str("  }\n");
  s.push_str("  .sidebar.open {\n");
  s.push_str("    transform: translateX(0);\n");
  s.push_str("  }\n");
  s.push_str("  .sidebar-overlay.open {\n");
  s.push_str("    display: block;\n");
  s.push_str("  }\n");
  s.push_str("  .main { margin-left: 0; }\n");
  s.push_str("  .content { padding: 60px 16px 16px; }\n");
  s.push_str("  .item-sig { display: none; }\n");
  s.push_str("  .module-grid { grid-template-columns: 1fr; }\n");
  s.push_str("}");
  s
});

generate_search_js :: (fn() -> String)({
  s := String.new();
  s.push_str("(function() {\n");
  s.push_str("  var searchInput = document.getElementById('doc-search');\n");
  s.push_str("  var searchResults = document.getElementById('search-results');\n");
  s.push_str("  var searchIndex = window.__SEARCH_INDEX || [];\n");
  s.push_str("\n");
  s.push_str("  if (!searchInput) return;\n");
  s.push_str("\n");
  s.push_str("  searchInput.addEventListener('input', function() {\n");
  s.push_str("    var query = this.value.toLowerCase().trim();\n");
  s.push_str("    searchResults.innerHTML = '';\n");
  s.push_str("\n");
  s.push_str("    if (!query) return;\n");
  s.push_str("\n");
  s.push_str("    var matches = searchIndex.filter(function(item) {\n");
  s.push_str("      return item.name.toLowerCase().indexOf(query) !== -1 ||\n");
  s.push_str("             (item.doc && item.doc.toLowerCase().indexOf(query) !== -1);\n");
  s.push_str("    }).slice(0, 20);\n");
  s.push_str("\n");
  s.push_str("    matches.forEach(function(item) {\n");
  s.push_str("      var a = document.createElement('a');\n");
  s.push_str("      a.href = item.href;\n");
  s.push_str("      a.textContent = item.name;\n");
  s.push_str("      var span = document.createElement('span');\n");
  s.push_str("      span.className = 'sr-kind';\n");
  s.push_str("      span.textContent = item.kind;\n");
  s.push_str("      a.appendChild(span);\n");
  s.push_str("      searchResults.appendChild(a);\n");
  s.push_str("    });\n");
  s.push_str("  });\n");
  s.push_str("\n");
  s.push_str("  // Back to top\n");
  s.push_str("  var btn = document.getElementById('back-to-top');\n");
  s.push_str("  if (btn) {\n");
  s.push_str("    window.addEventListener('scroll', function() {\n");
  s.push_str("      btn.style.display = window.scrollY > 300 ? 'flex' : 'none';\n");
  s.push_str("    });\n");
  s.push_str("    btn.addEventListener('click', function() {\n");
  s.push_str("      window.scrollTo({ top: 0, behavior: 'smooth' });\n");
  s.push_str("    });\n");
  s.push_str("  }\n");
  s.push_str("\n");
  s.push_str("  // Mobile sidebar toggle\n");
  s.push_str("  var toggle = document.getElementById('sidebar-toggle');\n");
  s.push_str("  var sidebar = document.querySelector('.sidebar');\n");
  s.push_str("  var overlay = document.getElementById('sidebar-overlay');\n");
  s.push_str("  if (toggle && sidebar && overlay) {\n");
  s.push_str("    toggle.addEventListener('click', function() {\n");
  s.push_str("      sidebar.classList.toggle('open');\n");
  s.push_str("      overlay.classList.toggle('open');\n");
  s.push_str("    });\n");
  s.push_str("    overlay.addEventListener('click', function() {\n");
  s.push_str("      sidebar.classList.remove('open');\n");
  s.push_str("      overlay.classList.remove('open');\n");
  s.push_str("    });\n");
  s.push_str("  }\n");
  s.push_str("})();");
  s
});

generate_highlight_js :: (fn() -> String)({
  s := String.new();
  s.push_str("(function() {\n");
  s.push_str("  var KEYWORDS = /\\b(fn|struct|enum|union|module|trait|impl|object|newtype|open|import|export|return|escape|recur|match|cond|if|while|for|break|continue|test|assert|comptime|runtime|comptime_assert|comptime_expect_error|generic|using|given|where|defer|dyn|pub|let|const|type|true|false|else|in|as|self|Self)\\b/g;\n");
  s.push_str("  var TYPES = /\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|rune|str|usize|isize|unit|void|Type|comptime_str|comptime_int|comptime_float)\\b/g;\n");
  s.push_str("  var BUILTINS = /\\b(Option|Result|Box|box|String|Future|Io|Impl|Slice|Array|Pointer|Fn|HashMap|ArrayList|BTreeMap|Deque|LinkedList|HashSet|BTreeSet|Rc|Arc|Mutex|Channel|WaitGroup|Thread|JoinHandle|Range)\\b/g;\n");
  s.push_str("  var STRINGS = /(`(?:[^`\\\\]|\\\\.)*`|\"(?:[^\"\\\\]|\\\\.)*\")/g;\n");
  s.push_str("  var NUMBERS = /\\b(0x[0-9a-fA-F_]+|0b[01_]+|0o[0-7_]+|[0-9][0-9_]*\\.?[0-9_]*(?:[eE][+-]?[0-9_]+)?)\\b/g;\n");
  s.push_str("  var LINE_COMMENTS = /(\\/\\/(?!\\/)[^\\n]*)/g;\n");
  s.push_str("  var DOC_COMMENTS = /(\\/\\/\\/[^\\n]*|\\/\\/![^\\n]*)/g;\n");
  s.push_str("  var BLOCK_COMMENTS = /(\\/\\*[\\s\\S]*?\\*\\/)/g;\n");
  s.push_str("  var OPERATORS = /([=!<>&|+\\-*\\/%^~]+|::|\\.\\.|=>|\\?=|:=)/g;\n");
  s.push_str("  var PROPERTIES = /\\.([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\(|\\b)/g;\n");
  s.push_str("\n");
  s.push_str("  function esc(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }\n");
  s.push_str("\n");
  s.push_str("  function highlight(code) {\n");
  s.push_str("    var tokens = [];\n");
  s.push_str("    var src = code;\n");
  s.push_str("    // Extract strings and comments first (they take priority)\n");
  s.push_str("    var protected_ = [];\n");
  s.push_str("    var placeholder = function(match, cls) {\n");
  s.push_str("      var id = '\\x00_' + protected_.length + '_\\x00';\n");
  s.push_str("      protected_.push('<span class=\"' + cls + '\">' + esc(match) + '</span>');\n");
  s.push_str("      return id;\n");
  s.push_str("    };\n");
  s.push_str("    // Block comments first\n");
  s.push_str("    src = src.replace(BLOCK_COMMENTS, function(m) { return placeholder(m, 'hljs-comment'); });\n");
  s.push_str("    // Doc comments before line comments\n");
  s.push_str("    src = src.replace(DOC_COMMENTS, function(m) { return placeholder(m, 'hljs-comment'); });\n");
  s.push_str("    src = src.replace(LINE_COMMENTS, function(m) { return placeholder(m, 'hljs-comment'); });\n");
  s.push_str("    // Strings (template and double-quoted)\n");
  s.push_str("    src = src.replace(STRINGS, function(m) { return placeholder(m, 'hljs-string'); });\n");
  s.push_str("    // Now highlight the rest\n");
  s.push_str("    src = esc(src);\n");
  s.push_str("    src = src.replace(KEYWORDS, '<span class=\"hljs-keyword\">$1</span>');\n");
  s.push_str("    src = src.replace(TYPES, '<span class=\"hljs-type\">$1</span>');\n");
  s.push_str("    src = src.replace(BUILTINS, '<span class=\"hljs-builtin\">$1</span>');\n");
  s.push_str("    src = src.replace(NUMBERS, '<span class=\"hljs-number\">$1</span>');\n");
  s.push_str("    // Restore protected tokens\n");
  s.push_str("    for (var i = 0; i < protected_.length; i++) {\n");
  s.push_str("      src = src.replace('\\x00_' + i + '_\\x00', protected_[i]);\n");
  s.push_str("    }\n");
  s.push_str("    return src;\n");
  s.push_str("  }\n");
  s.push_str("\n");
  s.push_str("  document.querySelectorAll('pre > code[class*=\"language-\"]').forEach(function(el) {\n");
  s.push_str("    el.innerHTML = highlight(el.textContent || '');\n");
  s.push_str("  });\n");
  s.push_str("\n");
  s.push_str("  document.querySelectorAll('.method-header code, .decl-signature, .impl-header code').forEach(function(el) {\n");
  s.push_str("    el.innerHTML = highlight(el.textContent || '');\n");
  s.push_str("  });\n");
  s.push_str("})();");
  s
});

export(generate_css, generate_search_js, generate_highlight_js);
