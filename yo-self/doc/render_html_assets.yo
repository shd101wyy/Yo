  s.push_str("    --shadow: rgba(0,0,0,0.2);\n");
  s.push_str("  }\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str("* { margin: 0; padding: 0; box-sizing: border-box; }\n");
  s.push_str("\n");
  s.push_str("body {\n");
