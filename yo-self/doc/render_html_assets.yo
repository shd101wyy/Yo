//! doc/render_html_assets — the static CSS / search JS / highlight JS
//! templates for the HTML doc site, extracted VERBATIM from
//! `src/doc/render-html.ts` (generateCSS / generateSearchJS /
//! generateHighlightJS — each returns the template `.trim()`ed, so the
//! extraction trims too) by a script-assisted port. Each template is emitted
//! line-by-line through double-quoted string literals to avoid backtick
//! interpolation hazards (`${`) in the embedded JS.
open(import("std/string"));

generate_css :: (fn() -> String)({
  s := String.new();
  s.push_str(":root {\n");
  s.push_str("  --bg: #fff;\n");
