  s.push_str("  padding: 12px 16px;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str("/* Trait impls */\n");
  s.push_str(".trait-impl-list {\n");
  s.push_str("  display: flex;\n");
  s.push_str("  flex-wrap: wrap;\n");
  s.push_str("  gap: 6px;\n");
  s.push_str("  margin: 8px 0;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str(".trait-impl-badge {\n");
  s.push_str("  font-family: var(--font-mono);\n");
  s.push_str("  font-size: 13px;\n");
  s.push_str("  background: var(--bg-code);\n");
  s.push_str("  padding: 3px 10px;\n");
  s.push_str("  border-radius: 4px;\n");
  s.push_str("  border: 1px solid var(--border);\n");
  s.push_str("  color: var(--accent);\n");
  s.push_str("  text-decoration: none;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str(".trait-impl-badge:hover {\n");
  s.push_str("  background: var(--accent);\n");
  s.push_str("  color: #fff;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str("/* Deprecated items */\n");
  s.push_str(".item-card.deprecated {\n");
  s.push_str("  border-color: #d4a017;\n");
  s.push_str("  opacity: 0.85;\n");
  s.push_str("}\n");
  s.push_str(".deprecated-banner {\n");
  s.push_str("  background: #fff3cd;\n");
  s.push_str("  color: #664d03;\n");
  s.push_str("  border: 1px solid #ffecb5;\n");
  s.push_str("  border-radius: 4px;\n");
  s.push_str("  padding: 8px 12px;\n");
  s.push_str("  margin: 8px 0;\n");
  s.push_str("  font-size: 13px;\n");
  s.push_str("}\n");
  s.push_str("[data-theme=\"dark\"] .deprecated-banner {\n");
  s.push_str("  background: #332701;\n");
  s.push_str("  color: #ffda6a;\n");
  s.push_str("  border-color: #664d03;\n");
  s.push_str("}\n");
  s.push_str("\n");
  s.push_str("/* Doc sections (Returns, Errors, Examples) */\n");
  s.push_str(".doc-section {\n");
  s.push_str("  margin: 12px 0;\n");
  s.push_str("  border-left: 3px solid var(--accent);\n");
  s.push_str("  padding-left: 12px;\n");
  s.push_str("}\n");
  s.push_str(".doc-section h5 {\n");
  s.push_str("  font-size: 13px;\n");
  s.push_str("  font-weight: 600;\n");
  s.push_str("  text-transform: uppercase;\n");
  s.push_str("  letter-spacing: 0.3px;\n");
  s.push_str("  color: var(--text-secondary);\n");
  s.push_str("  margin: 0 0 4px;\n");
