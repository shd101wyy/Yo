//! Core code emitter for the self-hosted Yo C code generator.
//!
//! Mirrors `src/emitter.ts`. Accumulates C source text in three separate
//! string buffers that are concatenated by `print()`:
//!
//!   headers      — #include directives and forward declarations
//!   declarations — struct/enum/typedef declarations
//!   code         — function definitions and other body code
open(import("std/string"));
{ HashSet } :: import("std/collections/hash_set");
{ ArrayList } :: import("std/collections/array_list");
/// True iff `b` is a C identifier byte: [A-Za-z0-9_].
_emitter_is_ident_byte :: (fn(b : u8) -> bool)(
  ((b >= u8(48)) && (b <= u8(57))) || (((b >= u8(65)) && (b <= u8(90))) || (((b >= u8(97)) && (b <= u8(122))) || (b == u8(95))))
);
/// True iff `cn` looks like an eval-minted temp C name: contains `_temp_`
/// followed by ONLY digits to the end (mirrors begin.yo `_looks_like_minted_temp`
/// and TS `isCodegenTempName`). Kept local so this low-level module needs no
/// codegen imports.
_emitter_is_minted_temp :: (fn(cn : String) -> bool)({
  marker := String.from("_temp_");
  match(
    cn.index_of(marker),
    .None => false,
    .Some(idx) => {
      start := (idx + marker.len());
      n := cn.len();
      if(start >= n, {
        return(false);
      });
      (i : usize) = start;
      (ok : bool) = true;
      while(i < n, {
        b := cn.byte_at(i);
        if(!((b >= u8(48)) && (b <= u8(57))), {
          ok = false;
        });
        i = (i + usize(1));
      });
      ok
    }
  )
});
/// True iff `b` can END a C type in a declaration: an identifier byte, `>`,
/// `*`, or `]` (mirrors the TS Emitter DECL_RE class `[\w>*\]]`).
_emitter_is_type_end_byte :: (fn(b : u8) -> bool)(
  _emitter_is_ident_byte(b) || ((b == u8(62)) || ((b == u8(42)) || (b == u8(93))))
);
/// The C variable name DECLARED by `line`, if any: the first occurrence of
/// `<type-end-byte> <ws…> <identifier> [ws…] ( '=' (not '==') | ';' )`.
/// Faithful port of the TS Emitter's DECL_RE (src/emitter.ts): matches an
/// initialized declaration (`T x = …`) AND an uninitialized one (`T x;` — a
/// branch-assigned temp or named local), but NOT an assignment (`x = …`: no
/// type before the name), a field store (`s.f = …`: `.` is not a type-end
/// byte), or a `___drop`/call argument use (`…((cast)(x))`: name wrapped in
/// parens). Byte-indexed throughout (bytes_len/byte_at — a multibyte string
/// constant earlier in the line must not truncate or shift the scan);
/// identifier bytes are ASCII, so the name is rebuilt with push_byte.
_emitter_decl_name :: (fn(line : String) -> Option(String))({
  n := line.bytes_len();
  (p : usize) = usize(0);
  while((p + usize(2)) < n, {
    if(_emitter_is_type_end_byte(line.byte_at(p)), {
      (q : usize) = (p + usize(1));
      ws_start := q;
      while((q < n) && ((line.byte_at(q) == u8(32)) || (line.byte_at(q) == u8(9))), {
        q = (q + usize(1));
      });
      id_start := q;
      if((q > ws_start) && (q < n), {
        first := line.byte_at(q);
        first_is_id_start := ((((first >= u8(65)) && (first <= u8(90))) || ((first >= u8(97)) && (first <= u8(122)))) || (first == u8(95)));
        if(first_is_id_start, {
          while((q < n) && _emitter_is_ident_byte(line.byte_at(q)), {
            q = (q + usize(1));
          });
          id_end := q;
          while((q < n) && ((line.byte_at(q) == u8(32)) || (line.byte_at(q) == u8(9))), {
            q = (q + usize(1));
          });
          if(q < n, {
            c := line.byte_at(q);
            is_decl := ((c == u8(59)) || ((c == u8(61)) && (((q + usize(1)) >= n) || (line.byte_at(q + usize(1)) != u8(61)))));
            if(is_decl, {
              name := String.new();
              (bi : usize) = id_start;
              while(bi < id_end, {
                name.push_byte(line.byte_at(bi));
                bi = (bi + usize(1));
              });
              return(Option(String).Some(name));
            });
          });
        });
      });
    });
    p = (p + usize(1));
  });
  Option(String).None
});
/// When a line declares a minted temp (`<type> <temp> = …` or `<type> <temp>;`),
/// record its C name in `set`. Mirrors the TS Emitter's declaredCVarNames
/// capture: the drop-emission gate skips a `___drop` for any minted temp NOT in
/// declared_c_var_names, and the many temp-decl paths that build the declaration
/// via get_type_string (not get_variable_type_string) otherwise leave their
/// temps untracked → the gate wrongly skips their (live-RC) drops → LEAK.
/// Recorded in C-emission order so forward-ref protection holds; a
/// `___drop((cast)(temp))` use has the temp inside parens (not in declaration
/// position), so genuine never-declared phantoms are never recorded. See
/// issues/yo-self-fixpoint-eval-phase-leak.md.
_emitter_record_declared_temp :: (fn(set : HashSet(String), line : String) -> unit)({
  if(!(line.contains(String.from("_temp_"))), {
    return(());
  });
  match(
    _emitter_decl_name(line),
    .Some(name) => if(_emitter_is_minted_temp(name.clone()), {
      _r := set.add(name);
    }),
    .None => ()
  );
});
/// Pop the block-scope stack back through (and including) the most recent `"{"`
/// sentinel — i.e. close one C block, discarding the names it declared.
_emitter_pop_block :: (fn(stack : ArrayList(String)) -> unit)({
  (done : bool) = false;
  while(!(done) && (stack.len() > usize(0)), {
    match(
      stack.pop(),
      .Some(v) => if(v == String.from("{"), {
        done = true;
      }),
      .None => {
        done = true;
      }
    );
  });
});
/// If `line` DECLARES a C var (`<type> <name> = …` or `<type> <name>;` — see
/// `_emitter_decl_name`), push that name onto the top scope frame. Assignments
/// (`<name> = …`, no type before the name) and field initializers (`.field = …`)
/// declare nothing and are skipped. Called BEFORE brace scanning so a
/// compound-literal decl (`Type name = { … }`) records `name` in the enclosing
/// frame, above the `{` its initializer opens.
_emitter_record_scope_decl :: (fn(stack : ArrayList(String), line : String) -> unit)(
  match(
    _emitter_decl_name(line),
    .Some(name) => {
      _ra := stack.push(name);
    },
    .None => ()
  )
);
/// Maintain the C block-scope stack for the escape-gate liveness signal, encoded
/// as a flat `ArrayList(String)` of declared C var names with `"{"` sentinels
/// marking block boundaries (a real C identifier can never equal `"{"`, so the
/// sentinel is unambiguous). This tracks EVERY C brace — begin-block, `if`/`else`,
/// `switch`/`case`, and compound-literal braces alike — by scanning the emitted
/// line character-by-character (skipping string literals, char literals and `//`
/// comments so braces inside them are not miscounted): each structural `{` pushes
/// a `"{"` sentinel, each `}` pops back through the last sentinel (discarding that
/// block's declared names), and a declaration pushes its name first (recorded in
/// the enclosing frame). Because a closed block's names are popped, the list only
/// ever holds names from currently-open C blocks — so the escape gate keeps a
/// pending drop iff its target APPEARS in the list (declared before this point AND
/// still in C scope). This is the block-scope-aware, C-emission-order signal the
/// flat set and source-token heuristics could not provide: begin-block markers
/// alone are too coarse (a control-flow-initialized local buried in a `switch`/`if`
/// C block goes out of C scope when that block closes, so its escape drop must be
/// skipped, but a marker-only tracker never sees the intervening close). A flat
/// `ArrayList(String)` is used rather than a stack of `HashSet` frames because
/// yo-self's own codegen mis-drops the nested `ArrayList(HashSet(String))` generic
/// (double-free in the self-compiled binary). See
/// issues/yo-self-fixpoint-eval-phase-leak.md.
_emitter_track_scope :: (fn(stack : ArrayList(String), line : String) -> unit)({
  _emitter_record_scope_decl(stack, line.clone());
  // bytes_len, NOT len(): byte_at is byte-indexed while String.len() counts
  // CHARACTERS — a multibyte string constant in the line would otherwise
  // truncate the scan and miss trailing braces (stale scope frames).
  n := line.bytes_len();
  (i : usize) = usize(0);
  (in_str : bool) = false;
  (in_chr : bool) = false;
  while(i < n, {
    b := line.byte_at(i);
    if(in_str, {
      if(b == u8(92), {
        i = (i + usize(1));
      }, if(b == u8(34), {
        in_str = false;
      }));
    }, if(in_chr, {
      if(b == u8(92), {
        i = (i + usize(1));
      }, if(b == u8(39), {
        in_chr = false;
      }));
    }, {
      if((b == u8(47)) && (((i + usize(1)) < n) && (line.byte_at(i + usize(1)) == u8(47))), {
        i = n;
      }, {
        if(b == u8(34), {
          in_str = true;
        });
        if(b == u8(39), {
          in_chr = true;
        });
        if(b == u8(123), {
          _p := stack.push(String.from("{"));
        });
        if(b == u8(125), {
          _emitter_pop_block(stack);
        });
      });
    }));
    i = (i + usize(1));
  });
});
/// Simple string emitter with three output sections.
///
/// Three buffers are maintained separately so that forward declarations
/// and type definitions can be emitted out-of-order and still appear
/// before function bodies in the final output.
Emitter :: ref(
  struct(
    headers : String,
    declarations : String,
    code : String,
    /// When `.Some`, points at the current function's `declared_c_var_names`
    /// (set by generate_function). `emit_*` code-section writes record any
    /// minted-temp declaration into it so the drop-emission gate has the
    /// C-emission-order ground truth. See `_emitter_record_declared_temp`.
    declared_ref : Option(HashSet(String)),
    /// When `.Some`, points at the current function's block-scope stack
    /// (declared_scopes). Each emitted body line pushes/pops `"{"` frames on every
    /// C brace and records named-local + temp decls — the escape gate's
    /// block-scope-aware liveness signal. See `_emitter_track_scope`.
    scope_ref : Option(ArrayList(String))
  )
);
impl(
  Emitter,
  /// Create a new empty emitter.
  new : (fn() -> Self)(
    Self(
      headers : String.new(),
      declarations : String.new(),
      code : String.new(),
      declared_ref : Option(HashSet(String)).None,
      scope_ref : Option(ArrayList(String)).None
    )
  ),
  /// Append text to the code section (no trailing newline).
  emit : (fn(inout(self) : Self, c : str) -> unit)(
    self.code.push_str(c)
  ),
  /// Append text + newline to the code section.
  emit_line : (fn(inout(self) : Self, c : str) -> unit)({
    self.code.push_str(c);
    self.code.push_str("\n");
    match(self.declared_ref,.Some(s) => _emitter_record_declared_temp(s, String.from(c)),.None => ());
    match(self.scope_ref,.Some(st) => _emitter_track_scope(st, String.from(c)),.None => ());
  }),
  /// Append text + newline to the headers section.
  emit_header_line : (fn(inout(self) : Self, c : str) -> unit)({
    self.headers.push_str(c);
    self.headers.push_str("\n");
  }),
  /// Append a raw `String` value to the headers section.
  emit_header_string : (fn(inout(self) : Self, c : String) -> unit)(
    self.headers.push_string(c)
  ),
  /// Append a raw `String` value + newline to the headers section.
  emit_header_string_line : (fn(inout(self) : Self, c : String) -> unit)({
    self.headers.push_string(c);
    self.headers.push_str("\n");
  }),
  /// Append text + newline to the declarations section.
  emit_declaration_line : (fn(inout(self) : Self, c : str) -> unit)({
    self.declarations.push_str(c);
    self.declarations.push_str("\n");
  }),
  /// Append text (no newline) to the declarations section.
  emit_declaration : (fn(inout(self) : Self, c : str) -> unit)(
    self.declarations.push_str(c)
  ),
  /// Append a raw `String` value (no newline) to the declarations section.
  emit_declaration_string : (fn(inout(self) : Self, c : String) -> unit)(
    self.declarations.push_string(c)
  ),
  /// Append a raw `String` value + newline to the declarations section.
  emit_declaration_string_line : (fn(inout(self) : Self, c : String) -> unit)({
    self.declarations.push_string(c);
    self.declarations.push_str("\n");
  }),
  /// Append a raw `String` value to the code section.
  emit_string : (fn(inout(self) : Self, c : String) -> unit)(
    self.code.push_string(c)
  ),
  /// Append a raw `String` value + newline to the code section.
  emit_string_line : (fn(inout(self) : Self, c : String) -> unit)({
    match(self.declared_ref,.Some(s) => _emitter_record_declared_temp(s, c.clone()),.None => ());
    match(self.scope_ref,.Some(st) => _emitter_track_scope(st, c.clone()),.None => ());
    self.code.push_string(c);
    self.code.push_str("\n");
  }),
  /// Return the full C source: headers + "\n" + declarations + "\n" + code.
  print : (fn(inout(self) : Self) -> String)({
    result := String.new();
    result.push_string(self.headers);
    result.push_str("\n");
    result.push_string(self.declarations);
    result.push_str("\n");
    result.push_string(self.code);
    result
  })
);
export(Emitter);
