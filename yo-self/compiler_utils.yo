//! C compiler discovery and flag utilities.
//!
//! Provides platform-aware C compiler detection, sanitizer flag selection,
//! and ASAN environment configuration.
//!
//! This mirrors `src/compiler-utils.ts`.
open(import("std/string"));
{ platform, Platform } :: import("std/process");
{ Command, ExitStatus } :: import("std/process/command");
{ AnyError, Exception, IoExn } :: import("std/error");
{ ArrayList } :: import("std/collections/array_list");
// ---------------------------------------------------------------------------
// Data types
// ---------------------------------------------------------------------------
/// Information about the selected C compiler.
CompilerInfo :: object(
  /// The compiler command (e.g. "gcc", "clang", "cl", "emcc").
  compiler : String,
  /// Whether this is MSVC.
  is_msvc : bool,
  /// Whether we are on Windows.
  is_windows : bool,
  /// Whether this is GCC on Windows (MinGW).
  is_gcc_on_windows : bool,
  /// Whether this is Clang on Windows.
  is_clang_on_windows : bool,
  /// Whether this is Emscripten (emcc) targeting WebAssembly.
  is_emcc : bool
);
/// Sanitizer kind — matches the `--sanitize` CLI option.
SanitizerKind :: enum(Address, Leak);
/// Result of `get_sanitizer_flags`.
SanitizerFlags :: object(
  /// Flags to pass to the C compiler.
  flags : ArrayList(String),
  /// Optional warning to emit to the user.
  warning : Option(String),
  /// Optional informational message.
  info : Option(String)
);
// ---------------------------------------------------------------------------
// CompilerInfo construction
// ---------------------------------------------------------------------------
/// Build a `CompilerInfo` for the given compiler command name.
get_compiler_info :: (fn(compiler : String) -> CompilerInfo)({
  is_msvc := (compiler.as_str() == "cl");
  is_windows := (platform == Platform.Windows);
  is_gcc_on_windows := (is_windows && ((compiler.as_str() == "gcc") || (compiler.as_str() == "cc")));
  is_clang_on_windows := (is_windows && (compiler.as_str() == "clang"));
  is_emcc := (compiler.as_str() == "emcc");
  CompilerInfo(
    compiler : compiler,
    is_msvc : is_msvc,
    is_windows : is_windows,
    is_gcc_on_windows : is_gcc_on_windows,
    is_clang_on_windows : is_clang_on_windows,
    is_emcc : is_emcc
  )
});
// ---------------------------------------------------------------------------
// Compiler availability check
// ---------------------------------------------------------------------------
/// Return `true` if running `compiler --version` exits successfully.
/// Throws `Exception` if the command cannot be spawned at all.
check_compiler_available :: (
  fn(
    compiler : String,
    io : Io,
    exn : Exception
  ) -> Impl(Future(bool, IoExn))
)(
  io.async((io) => {
    cmd := Command.new(compiler);
    cmd.arg(String.from("--version"));
    st := io.await(cmd.status(), io);
    st.success()
  })
);
/// Find the first available C compiler from the preferred list.
/// Tries each candidate in order; returns `.Some(compiler)` for the first
/// that exits with code 0, or `.None` if none succeed.
/// Exceptions from individual candidates are treated as "not available".
find_available_compiler :: (
  fn(
    io : Io
  ) -> Impl(Future(Option(String), Io))
)(
  io.async((io : Io) => {
    candidates := ArrayList(String).new();
    candidates.push(String.from("clang"));
    candidates.push(String.from("cc"));
    candidates.push(String.from("gcc"));
    candidates.push(String.from("zig"));
    candidates.push(String.from("cl"));
    result := Option(String).None;
    i := usize(0);
    while((i < candidates.len()) && (result == Option(String).None), {
      candidate_opt := candidates.get(i);
      match(
        candidate_opt,
        .None => (),
        .Some(cc) => {
          (found : bool) = false;
          // Install a per-candidate exception handler so a "not found" error
          // does not propagate — we just mark the compiler as unavailable.
          try_exn := Exception(
            throw : (
              (err) -> {
                // Compiler not available — set found=false via the mutable binding
                // and resume by returning a dummy ExitStatus (success=false)
                return(ExitStatus(raw : i32(1)));
              }
            )
          );
          cmd := Command.new(cc);
          cmd.arg(String.from("--version"));
          st_res := io.await(cmd.status(), io);
          found = st_res.success();
          if(found, {
            result =.Some(cc);
          });
        }
      );
      i = (i + usize(1));
    });
    result
  })
);
// ---------------------------------------------------------------------------
// Sanitizer flags
// ---------------------------------------------------------------------------
/// Return the C compiler flags needed to enable the requested sanitizer.
get_sanitizer_flags :: (
  fn(
    sanitize : SanitizerKind,
    compiler_info : CompilerInfo
  ) -> SanitizerFlags
)(
  match(
    sanitize,
    .Address =>
      cond(
        compiler_info.is_msvc => {
          flags := ArrayList(String).new();
          flags.push(String.from("/fsanitize=address"));
          SanitizerFlags(
            flags : flags,
            warning :.None,
            info :.Some(String.from("AddressSanitizer enabled (memory errors + leak detection)"))
          )
        },
        compiler_info.is_gcc_on_windows =>
          SanitizerFlags(
            flags : ArrayList(String).new(),
            warning :.Some(String.from("AddressSanitizer is not supported by MinGW GCC on Windows. Use Clang (--cc clang) instead for sanitizer support.")),
            info :.None
          ),
        true => {
          flags := ArrayList(String).new();
          flags.push(String.from("-fsanitize=address"));
          flags.push(String.from("-fno-omit-frame-pointer"));
          SanitizerFlags(
            flags : flags,
            warning :.None,
            info :.Some(String.from("AddressSanitizer enabled (memory errors + leak detection)"))
          )
        }
      ),
    .Leak =>
      cond(
        compiler_info.is_msvc =>
          SanitizerFlags(
            flags : ArrayList(String).new(),
            warning :.Some(String.from("LeakSanitizer is not supported by MSVC, use AddressSanitizer instead")),
            info :.None
          ),
        (compiler_info.is_gcc_on_windows || compiler_info.is_clang_on_windows) =>
          SanitizerFlags(
            flags : ArrayList(String).new(),
            warning :.Some(String.from("LeakSanitizer is not supported on Windows, use AddressSanitizer instead")),
            info :.None
          ),
        true => {
          flags := ArrayList(String).new();
          flags.push(String.from("-fsanitize=leak"));
          SanitizerFlags(
            flags : flags,
            warning :.None,
            info :.Some(String.from("LeakSanitizer enabled (leak detection only)"))
          )
        }
      )
  )
);
// ---------------------------------------------------------------------------
// macOS LSAN suppressions
// ---------------------------------------------------------------------------
/// Return the macOS LSAN suppression list for common system library leaks.
/// Returns an empty string on non-macOS platforms.
get_macos_lsan_suppressions :: (fn() -> str)(
  cond(
    (platform == Platform.Macos) =>
      "leak:libobjc\nleak:libdyld\nleak:libxpc\nleak:libsystem_malloc\nleak:dyld",
    true => ""
  )
);
/// Return `true` if `liburing` is available via `pkg-config` on Linux.
/// Always returns `false` on non-Linux platforms.
is_liburing_available :: (
  fn(
    io : Io,
    exn : Exception
  ) -> Impl(Future(bool, IoExn))
)(
  io.async((io) => {
    if(platform != Platform.Linux, {
      return(false);
    });
    // Check pkg-config exists
    pkg := Command.new(String.from("pkg-config"));
    pkg.arg(String.from("--exists"));
    pkg.arg(String.from("liburing"));
    st := io.await(pkg.status(), io);
    st.success()
  })
);
export(
  CompilerInfo,
  SanitizerKind,
  SanitizerFlags,
  get_compiler_info,
  check_compiler_available,
  find_available_compiler,
  get_sanitizer_flags,
  get_macos_lsan_suppressions,
  is_liburing_available
);
