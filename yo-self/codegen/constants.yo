//! 1-to-1 port of `src/codegen/constants.ts`.
//!
//! Currently exposes one membership predicate:
//!
//!   - `is_builtin_yo_inline_function(name)` — true iff `name` is the
//!     identifier of one of the inline-emit builtins from TS's
//!     `BuiltinYoInlineFunctions` array. The TS code uses an array
//!     plus `.includes()`; yo-self expresses the same membership as
//!     a single `cond` chain so callers don't need a runtime-built
//!     ArrayList.
//!
//! `PrimitiveTypeTags` from the same TS file is left unported until a
//! caller emerges in yo-self codegen.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{
  BF_YO_OP_ADD,
  BF_YO_OP_SUB,
  BF_YO_OP_MUL,
  BF_YO_OP_DIV,
  BF_YO_OP_MOD,
  BF_YO_OP_NEG,
  BF_YO_OP_EQ,
  BF_YO_OP_NEQ,
  BF_YO_OP_LT,
  BF_YO_OP_LTE,
  BF_YO_OP_GT,
  BF_YO_OP_GTE,
  BF_YO_OP_NOT,
  BF_YO_OP_BIT_AND,
  BF_YO_OP_BIT_OR,
  BF_YO_OP_BIT_XOR,
  BF_YO_OP_BIT_COMPLEMENT,
  BF_YO_OP_BIT_LEFT_SHIFT,
  BF_YO_OP_BIT_RIGHT_SHIFT,
  BF_YO_NOOP,
  BF_YO_RETURN_SELF,
  BF_YO_MS_SLEEP,
  BF_YO_PTR_ADD,
  BF_YO_PTR_SUB,
  BF_YO_PTR_DIFF,
  BF_YO_PTR_EQ,
  BF_YO_PTR_NEQ,
  BF_YO_PTR_LT,
  BF_YO_PTR_LTE,
  BF_YO_PTR_GT,
  BF_YO_PTR_GTE,
  BF_YO_SLICE_LEN,
  BF_YO_SLICE_NEW,
  BF_YO_SLICE_PTR,
  BF_YO_AS,
  BF_YO_GETRANDOM,
  BF_YO_ARC4RANDOM_BUF,
  BF_YO_BCRYPT_GEN_RANDOM,
  BF_YO_GETENTROPY,
  BF_YO_MAYBE_UNINIT_NEW,
  BF_YO_MAYBE_UNINIT_AS_PTR,
  BF_YO_MAYBE_UNINIT_ASSUME_INIT,
  BF_YO_ARRAY_INDEX,
  BF_YO_SLICE_INDEX,
  BF_YO_ARRAY_INDEX_RANGE,
  BF_YO_ARRAY_INDEX_RANGE_INCLUSIVE,
  BF_YO_SLICE_INDEX_RANGE,
  BF_YO_SLICE_INDEX_RANGE_INCLUSIVE
} :: import("../expr.yo");
/// True iff `name` is one of the builtin inline-emit function names.
/// Mirrors TS `BuiltinYoInlineFunctions.includes(name)` in
/// `src/codegen/constants.ts`.
is_builtin_yo_inline_function :: (fn(name : str) -> bool)(
  cond(
    // Arithmetic
    (name == BF_YO_OP_ADD) => true,
    (name == BF_YO_OP_SUB) => true,
    (name == BF_YO_OP_MUL) => true,
    (name == BF_YO_OP_DIV) => true,
    (name == BF_YO_OP_MOD) => true,
    (name == BF_YO_OP_NEG) => true,
    // Relational
    (name == BF_YO_OP_EQ) => true,
    (name == BF_YO_OP_NEQ) => true,
    (name == BF_YO_OP_LT) => true,
    (name == BF_YO_OP_LTE) => true,
    (name == BF_YO_OP_GT) => true,
    (name == BF_YO_OP_GTE) => true,
    // Logical
    (name == BF_YO_OP_NOT) => true,
    // Bitwise
    (name == BF_YO_OP_BIT_AND) => true,
    (name == BF_YO_OP_BIT_OR) => true,
    (name == BF_YO_OP_BIT_XOR) => true,
    (name == BF_YO_OP_BIT_COMPLEMENT) => true,
    (name == BF_YO_OP_BIT_LEFT_SHIFT) => true,
    (name == BF_YO_OP_BIT_RIGHT_SHIFT) => true,
    // Pointer operations
    (name == BF_YO_PTR_ADD) => true,
    (name == BF_YO_PTR_SUB) => true,
    (name == BF_YO_PTR_DIFF) => true,
    (name == BF_YO_PTR_EQ) => true,
    (name == BF_YO_PTR_NEQ) => true,
    (name == BF_YO_PTR_LT) => true,
    (name == BF_YO_PTR_LTE) => true,
    (name == BF_YO_PTR_GT) => true,
    (name == BF_YO_PTR_GTE) => true,
    // Slice operations
    (name == BF_YO_SLICE_LEN) => true,
    (name == BF_YO_SLICE_NEW) => true,
    (name == BF_YO_SLICE_PTR) => true,
    // Type casting
    (name == BF_YO_AS) => true,
    // Crypto random
    (name == BF_YO_GETRANDOM) => true,
    (name == BF_YO_ARC4RANDOM_BUF) => true,
    (name == BF_YO_BCRYPT_GEN_RANDOM) => true,
    (name == BF_YO_GETENTROPY) => true,
    // MaybeUninit
    (name == BF_YO_MAYBE_UNINIT_NEW) => true,
    (name == BF_YO_MAYBE_UNINIT_AS_PTR) => true,
    (name == BF_YO_MAYBE_UNINIT_ASSUME_INIT) => true,
    // Array/Slice indexing
    (name == BF_YO_ARRAY_INDEX) => true,
    (name == BF_YO_SLICE_INDEX) => true,
    (name == BF_YO_ARRAY_INDEX_RANGE) => true,
    (name == BF_YO_ARRAY_INDEX_RANGE_INCLUSIVE) => true,
    (name == BF_YO_SLICE_INDEX_RANGE) => true,
    (name == BF_YO_SLICE_INDEX_RANGE_INCLUSIVE) => true,
    // Others
    (name == BF_YO_NOOP) => true,
    (name == BF_YO_RETURN_SELF) => true,
    (name == BF_YO_MS_SLEEP) => true,
    true => false
  )
);
export(is_builtin_yo_inline_function);
