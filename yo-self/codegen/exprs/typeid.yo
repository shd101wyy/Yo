//! Generate code for the `typeid(T)` builtin.
//!
//! 1:1 port of `src/codegen/exprs/typeid.ts`.
//!
//! Behavior:
//!   - Each unique type gets a `static const char __yo_typeid_XXX = 0;`
//!     declaration emitted into the declarations section.
//!   - The expression itself evaluates to `(uintptr_t)&__yo_typeid_XXX`,
//!     a stable pointer value that uniquely identifies the type.
//!
//! Metadata requirement:
//!   The argument's compile-time value must be a `TypeVal`. This requires
//!   the typed-AST pipeline (Phase 13at): a populated
//!   `CodegenContext.expr_info_table` from a prior evaluator pass.
//!   When the metadata is missing, returns `Option(String).None` so the
//!   caller can fall back to a bootstrap heuristic — though no current
//!   bootstrap heuristic handles `typeid`; calls reach this handler only
//!   in the typed-AST pipeline.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ AstExpr, ast_expr_id } :: import("../../expr.yo");
{ ExprInfo } :: import("../../expr_info.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ type_to_string } :: import("../../types/string.yo");
{ EvalValue } :: import("../../value.yo");
{ CodegenContext } :: import("../context.yo");
{ sanitize_for_c_identifier, format_typed_init_line } :: import("../utils/index.yo");
/// Format the typeid static variable name:
///   `__yo_typeid_<sanitized>`
/// Mirrors the prefix-then-append composition used by
/// `register_typeid_static`. Pure string composition.
format_typeid_static_name :: (fn(sanitized : String) -> String)({
  s := String.from("__yo_typeid_");
  s.push_string(sanitized);
  s
});
/// Format the typeid static declaration line:
///   `static const char <name> = 0;`
/// Emitted into the declarations section the first time a given type
/// is encountered. Pure string composition.
format_typeid_static_decl :: (fn(name : String) -> String)(
  // Composes `static const char <name> = 0;` via the canonical
  // typed-init helper — treats `static const char <name>` as the LHS.
  format_typed_init_line(
    String.new(),
    String.from("static const char ") + name,
    String.from("0")
  )
);
/// Format the typeid expression: `(uintptr_t)&<name>`. This is the C
/// value of a `typeid(T)` call — a stable pointer cast to `uintptr_t`
/// for use as a unique integer identifier.
format_typeid_address_expr :: (fn(name : String) -> String)({
  s := String.from("(uintptr_t)&");
  s.push_string(name);
  s
});
/// Extract the `TypeValue` from a `.TypeVal(box)` `EvalValue`, returning
/// `.None` for any other shape.
extract_type_value :: (fn(v : EvalValue) -> Option(TypeValue))(
  match(
    v,
    .TypeVal(box_ty) => Option(TypeValue).Some(box_ty.*),
    _ => Option(TypeValue).None
  )
);
/// Register a `__yo_typeid_<sanitized>` static-`char` declaration for
/// `ty` and return the static's C name. If the type has already been
/// registered (looked up via `type_to_string` key), the existing
/// static name is returned and no extra declaration is emitted —
/// matching TS's deduplication via the `typeIdStatics` map.
///
/// Used by both `generate_typeid` and the downcast emit so the
/// typeid-pointer registration is a single source of truth.
register_typeid_static :: (
  fn(ty : TypeValue, ctx : *(CodegenContext)) -> String
)({
  type_id_str := type_to_string(ty);
  sanitized := sanitize_for_c_identifier(type_id_str);
  static_var_name := format_typeid_static_name(sanitized);
  already_emitted := ctx.*.type_id_statics.get(type_id_str).is_some();
  if(!(already_emitted), {
    _ := ctx.*.type_id_statics.set(type_id_str, static_var_name.clone());
    ctx.*.emitter.emit_declaration_string_line(format_typeid_static_decl(static_var_name));
  });
  // typeid expressions resolve to `(uintptr_t)&__yo_typeid_...`, so
  // the emitted module needs `<stdint.h>` for `uintptr_t`. Mirrors
  // `context.cIncludes.add("<stdint.h>")` in TS `generateTypeid`.
  // yo-self's preamble already unconditionally emits `<stdint.h>` so
  // this is currently a no-op dedup — but wire the call so the
  // include-tracking infrastructure stays accurate once the preamble
  // becomes demand-driven.
  ctx.*.add_c_include(String.from("<stdint.h>"));
  static_var_name
});
/// Generate the C expression for a `typeid(T)` call.
///
/// `args` is the call's argument list (length 1: the type expression).
/// Returns `.Some(cExpr)` on success, `.None` when no metadata is available
/// or when the metadata is not a `TypeVal`.
generate_typeid :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext)
  ) -> Option(String)
)(
  cond(
    (args.len() != usize(1)) => Option(String).None,
    true => match(
      args.get(usize(0)),
      .None => Option(String).None,
      .Some(arg_expr) => match(
        ctx.*.get_expr_info(ast_expr_id(arg_expr)),
        .None => Option(String).None,
        .Some(info) => match(
          info.value,
          .None => Option(String).None,
          .Some(eval_val) => match(
            extract_type_value(eval_val),
            .None => Option(String).None,
            .Some(ty) => {
              static_var_name := register_typeid_static(ty, ctx);
              Option(String).Some(format_typeid_address_expr(static_var_name))
            }
          )
        )
      )
    )
  )
);
export(
  generate_typeid,
  extract_type_value,
  register_typeid_static,
  format_typeid_static_name,
  format_typeid_static_decl,
  format_typeid_address_expr
);
