//! `downcast(dyn_value, T)` emitter — mirrors `src/codegen/exprs/downcast.ts`.
//!
//! Safe downcast returning `Option(T)`. Dyn only wraps object types, so the
//! result is an owned RC reference (we dup, since the Dyn also holds one). The
//! is-check compares the Dyn's vtable type-id against a per-target static whose
//! address is the canonical type id. If `Option` is nullable-pointer-optimized,
//! emits `(check) ? cast : NULL`; otherwise the full tagged-union Some/None.
//!
//! DEFERRED (documented): the `wasBoxed` branch (auto-boxed value types, where
//! `dyn.data` points to a Box struct and the value is extracted via its
//! ___dup) is UNREACHABLE — yo-self `is_boxed_type` is hardcoded false (Box is
//! not modeled in the type system yet). When Box lands, port the dyn_impls scan
//! (it also needs Gap-6 SomeType.resolvedConcreteType). The unboxed object cast
//! is the live path.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr } :: import("../../expr.yo");
{ EvalValue } :: import("../../value.yo");
{ is_dyn_type, is_enum_type } :: import("../../types/guards.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ type_key, get_type_string, sanitize_for_c_identifier, get_enum_variant_c_name, can_optimize_as_nullable_pointer } :: import("../utils/index.yo");
/// Generate code for `downcast(dyn_value, T)`. Mirrors `generateDowncast`.
generate_downcast :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)({
  ei := match(context.base.get_expr_info(expr),.Some(e) => e,.None => return(String.from("/* ERROR: downcast not evaluated */")));
  args := match(expr,.FnCall(_, _, a, _, _) => a,.Atom(_, _) => ArrayList(AstExpr).new());
  dyn_arg := match(args.get(usize(0)),.Some(x) => x,.None => return(String.from("/* ERROR: downcast requires 2 arguments */")));
  type_arg := match(args.get(usize(1)),.Some(x) => x,.None => return(String.from("/* ERROR: downcast requires 2 arguments */")));
  // First argument: the dyn value (runtime).
  dyn_ei := match(context.base.get_expr_info(dyn_arg),.Some(e) => e,.None => return(String.from("/* ERROR: downcast dyn arg not evaluated */")));
  if(!(is_dyn_type(dyn_ei.ty)), {
    return(String.from("/* ERROR: downcast expected Dyn type as first argument */"));
  });
  dyn_code := _call_generate_expr(dyn_arg, indent.clone(), context);
  // Second argument: the target type T (comptime).
  target_type := match(context.base.get_expr_info(type_arg),.Some(tei) => match(tei.value,.Some(v) => match(v,.TypeVal(t) => t, _ => return(String.from("/* ERROR: downcast expected TypeValue as second argument */"))),.None => return(String.from("/* ERROR: downcast expected TypeValue as second argument */"))),.None => return(String.from("/* ERROR: downcast type arg not evaluated */")));
  target_type_c_name := get_type_string(target_type, context.base);
  // Register the typeid static for the target type (address = canonical id).
  type_id := type_key(target_type);
  type_id_c_name := match(context.base.get_type_c_name(type_id.clone()),.Some(cn) => cn,.None => target_type_c_name.clone());
  static_var_name := String.from("__yo_typeid_");
  static_var_name.push_string(sanitize_for_c_identifier(type_id_c_name, false));
  if(!(context.base.type_id_statics.contains_key(type_id.clone())), {
    _r := context.base.type_id_statics.set(type_id.clone(), static_var_name.clone());
    decl := String.from("static const char ");
    decl.push_string(static_var_name.clone());
    decl.push_str(" = 0;");
    em := context.base.emitter;
    em.emit_declaration_string_line(decl);
  });
  context.base.add_c_include(String.from("<stdint.h>"));
  // is-check: the Dyn's vtable type-id equals this target's static address.
  is_check := dyn_code.clone();
  is_check.push_str(".vtable->__yo_type_id == (uintptr_t)&");
  is_check.push_string(static_var_name);
  // Cast: Dyn wraps object types — dup the held object reference. (The wasBoxed
  // branch is unreachable in yo-self; see file header.)
  cast_expr := String.from("((");
  cast_expr.push_string(target_type_c_name);
  cast_expr.push_str(")__yo_incr_rc((void*)");
  cast_expr.push_string(dyn_code);
  cast_expr.push_str(".data))");
  // Result Option type.
  option_type := ei.ty;
  if(!(is_enum_type(option_type)), {
    return(String.from("/* ERROR: downcast expected Option enum as result type */"));
  });
  match(
    can_optimize_as_nullable_pointer(option_type),
    .Some(_) => {
      out := String.from("((");
      out.push_string(is_check);
      out.push_str(") ? ");
      out.push_string(cast_expr);
      out.push_str(" : NULL)");
      out
    },
    .None => {
      option_c_name := get_type_string(option_type, context.base);
      some_tag := get_enum_variant_c_name(option_type, String.from("Some"), context.base);
      none_tag := get_enum_variant_c_name(option_type, String.from("None"), context.base);
      out := String.from("((");
      out.push_string(is_check);
      out.push_str(") ? (");
      out.push_string(option_c_name.clone());
      out.push_str("){ .tag = ");
      out.push_string(some_tag);
      out.push_str(", .data = { .Some = { .value = ");
      out.push_string(cast_expr);
      out.push_str(" } } } : (");
      out.push_string(option_c_name);
      out.push_str("){ .tag = ");
      out.push_string(none_tag);
      out.push_str(" })");
      out
    }
  )
});
export(generate_downcast);
