//! Partial 1-to-1 port of `src/codegen/exprs/downcast.ts`.
//!
//! Covers the non-boxed-object leaf path: when a `Dyn(T)` is
//! downcast to an object target type that does not require
//! box-extraction, the emit is pure string composition over
//! infrastructure that has already landed in yo-self/codegen:
//!
//!   - typeid registration via `register_typeid_static`,
//!   - cast / cName resolution via `get_type_string`,
//!   - tagged-union construction via `get_enum_variant_c_name`,
//!   - nullable-pointer fast-path via
//!     `can_optimize_as_nullable_pointer`,
//!   - the `__yo_incr_rc((void*)x.data)` call shape from `rc_fns.yo`.
//!
//! The boxed-target path (extracting from `Box(T)` via
//! `context.dynImpls`) and the typed-`getDupFunctionForType` branch
//! still wait on the `dyn_impls` map + function-cname table landing
//! in yo-self codegen.
//!
//! The entry point takes already-resolved types and the
//! already-generated dyn-value C string. The AST-to-types glue
//! (reading `info.ty` and the second arg's `info.value.TypeVal`)
//! lives one layer up in the eventual full `generate_downcast` and
//! is therefore not duplicated here.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_id } :: import("../../expr.yo");
{ TypeValue } :: import("../../types/type.yo");
{ is_dyn_type, is_object_type } :: import("../../types/guards.yo");
{ EvalValue } :: import("../../value.yo");
{ CodegenContext } :: import("../context.yo");
{
  get_type_string,
  get_enum_variant_c_name,
  can_optimize_as_nullable_pointer
} :: import("../utils/index.yo");
{ format_incr_rc_call, format_incr_rc_atomic_call } :: import("./rc_fns.yo");
{ register_typeid_static, extract_type_value } :: import("./typeid.yo");
{ call_gen_expr } :: import("./expr.yo");
/// Format the box-extraction subexpression
///   `((<box_c_name>*)<dyn_code>.data)-><box_field_name>`
///
/// Used by the boxed-target branch of `generate_downcast` after the
/// caller has resolved the box type via `ctx.get_dyn_impl(impl_key)`
/// and its single field's label. Pure string composition.
///
/// Mirrors the TS line
///     const extractExpr = `((${boxTypeCName}*)${dynCode}.data)->${boxFieldName}`;
/// in `generateDowncast`.
format_box_extract :: (
  fn(box_c_name : String, dyn_code : String, box_field_name : String) -> String
)({
  s := String.from("((");
  s.push_string(box_c_name);
  s.push_str("*)");
  s.push_string(dyn_code);
  s.push_str(".data)->");
  s.push_string(box_field_name);
  s
});
/// Format a typed-incr-rc cast for an object target:
///   `((<target_c_name>)__yo_incr_rc[_atomic]((void*)<inner_expr>))`
///
/// `atomic` selects between the atomic and non-atomic variants. The
/// shape matches the three call sites in `generateDowncast` that emit
/// a typed cast around a refcount increment (the direct-object branch,
/// the newtype-wrapped-object fallback, and the unwrapped-dyn-data
/// case for non-boxed dyn values).
format_typed_incr_rc_cast :: (
  fn(target_c_name : String, inner_expr : String, atomic : bool) -> String
)({
  void_arg := String.from("(void*)");
  void_arg.push_str(inner_expr.as_str());
  incr := cond(
    atomic => format_incr_rc_atomic_call(void_arg),
    true => format_incr_rc_call(void_arg)
  );
  out := String.from("((");
  out.push_string(target_c_name);
  out.push_str(")");
  out.push_string(incr);
  out.push_str(")");
  out
});
/// Emit the C expression for a `downcast(dyn_value, T)` call where the
/// runtime path is the non-boxed-object branch.
///
/// `dyn_code` is the already-generated C expression for the dyn
/// argument (must evaluate to a value of `dyn_type`).
/// `dyn_type` is the `Dyn(...)` source type.
/// `target_type` is the concrete target `T` — must be an object type
/// (the boxed path is not handled here).
/// `option_type` is the result `Option(T)` enum — its `Some` /
/// `None` variants determine whether the nullable-pointer
/// optimisation applies.
///
/// Returns:
///   - `.Some(c_expr)` on the supported leaf path.
///   - `.None` when any precondition fails (dyn_type is not actually
///     a Dyn, target is not an object, option_type's variant tags are
///     not registered, …). The bootstrap codegen takes over in that
///     case.
generate_downcast_for_resolved_types :: (
  fn(
    dyn_code : String,
    dyn_type : TypeValue,
    target_type : TypeValue,
    option_type : TypeValue,
    ctx : *(CodegenContext)
  ) -> Option(String)
)(
  cond(
    !(is_dyn_type(dyn_type)) => Option(String).None,
    !(is_object_type(target_type)) => Option(String).None,
    true => {
      target_c_name := get_type_string(target_type, ctx);
      // typeid pointer check: `(dyn_code).vtable->__yo_type_id == (uintptr_t)&__yo_typeid_<sanitized>`
      static_var := register_typeid_static(target_type, ctx);
      is_check := String.from("");
      is_check.push_str(dyn_code.as_str());
      is_check.push_str(".vtable->__yo_type_id == (uintptr_t)&");
      is_check.push_string(static_var);
      // Cast expression: `((target_c_name)__yo_incr_rc((void*)dyn_code.data))`.
      // The Dyn data pointer aliases the underlying object; dup it so
      // both the Dyn wrapper's drop and the cast result's drop can
      // each decrement RC.
      dyn_data_expr := String.from(dyn_code.as_str());
      dyn_data_expr.push_str(".data");
      cast_expr := format_typed_incr_rc_cast(target_c_name, dyn_data_expr, false);
      match(
        can_optimize_as_nullable_pointer(option_type),
        // Nullable-pointer fast path: `((is_check) ? cast : NULL)`.
        .Some(_) => {
          out := String.from("((");
          out.push_string(is_check);
          out.push_str(") ? ");
          out.push_string(cast_expr);
          out.push_str(" : NULL)");
          Option(String).Some(out)
        },
        // Tagged-union construction.
        .None => {
          option_c_name := get_type_string(option_type, ctx);
          match(
            get_enum_variant_c_name(option_type, String.from("Some"), ctx),
            .None => Option(String).None,
            .Some(some_tag) => match(
              get_enum_variant_c_name(option_type, String.from("None"), ctx),
              .None => Option(String).None,
              .Some(none_tag) => {
                some_expr := String.from("(");
                some_expr.push_string(option_c_name);
                some_expr.push_str("){ .tag = ");
                some_expr.push_string(some_tag);
                some_expr.push_str(", .data = { .Some = { .value = ");
                some_expr.push_string(cast_expr);
                some_expr.push_str(" } } }");
                none_expr := String.from("(");
                none_expr.push_string(option_c_name);
                none_expr.push_str("){ .tag = ");
                none_expr.push_string(none_tag);
                none_expr.push_str(" }");
                out := String.from("((");
                out.push_string(is_check);
                out.push_str(") ? ");
                out.push_string(some_expr);
                out.push_str(" : ");
                out.push_string(none_expr);
                out.push_str(")");
                Option(String).Some(out)
              }
            )
          )
        }
      )
    }
  )
);
/// AST-level entry point for `downcast(dyn_value, T)` codegen.
///
/// Reads the dyn argument's runtime type, the target type (a
/// `TypeVal` compile-time value on the second argument), and the
/// result `Option(T)` enum type from the ExprInfo table, recursively
/// lowers the dyn argument via `call_gen_expr`, and delegates to
/// `generate_downcast_for_resolved_types`.
///
/// Returns `.None` on any precondition failure so the bootstrap
/// codegen can recover.
generate_downcast_call :: (
  fn(
    call_expr : AstExpr,
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)(
  cond(
    (args.len() < usize(2)) => Option(String).None,
    true => match(
      args.get(usize(0)),
      .None => Option(String).None,
      .Some(dyn_arg) => match(
        args.get(usize(1)),
        .None => Option(String).None,
        .Some(type_arg) => match(
          ctx.*.get_expr_info(ast_expr_id(dyn_arg)),
          .None => Option(String).None,
          .Some(dyn_info) => match(
            ctx.*.get_expr_info(ast_expr_id(type_arg)),
            .None => Option(String).None,
            .Some(type_info) => match(
              type_info.value,
              .None => Option(String).None,
              .Some(type_val) => match(
                extract_type_value(type_val),
                .None => Option(String).None,
                .Some(target_type) => match(
                  ctx.*.get_expr_info(ast_expr_id(call_expr)),
                  .None => Option(String).None,
                  .Some(call_info) => match(
                    call_gen_expr(dyn_arg, ctx, indent),
                    .None => Option(String).None,
                    .Some(dyn_code) => generate_downcast_for_resolved_types(
                      dyn_code,
                      dyn_info.ty,
                      target_type,
                      call_info.ty,
                      ctx
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
);
export(
  generate_downcast_for_resolved_types,
  generate_downcast_call,
  format_box_extract,
  format_typed_incr_rc_cast
);
