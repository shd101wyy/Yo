//! Closure codegen helpers.
//!
//! 1-to-1 partial port of `src/codegen/exprs/closures.ts`. Only the
//! pure utility helpers that do not depend on the closure-capture
//! struct machinery (`context.types[].cName`, `deferredDupExpressions`,
//! state-machine fields, …) are ported here. The main entry points
//! `generateClosureConstruction` / `allocateClosureCapture` are
//! intentionally left to a follow-up port — they hard-depend on
//! infrastructure that the bootstrap codegen does not yet expose.
//!
//! Helpers ported here:
//!   - `check_variable_is_closure_captured(name, env, capture_frame_level)`
//!     — mirror of TS `checkVariableIsClosureCaptured`.
//!   - `is_closure_construction(expr_id, ctx)` — mirror of TS
//!     `isClosureConstruction`, adapted to read the ExprInfo
//!     side-table for `closure_function_value` and the Fn-trait
//!     check via `type_implements_fn`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ExprId, BK_TUPLE } :: import("../../expr.yo");
{ TokenKind } :: import("../../token.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ Environment, Variable, get_variables_from_env } :: import("../../env.yo");
{ type_implements_fn } :: import("../../evaluator/trait_checking.yo");
{ CodegenContext } :: import("../context.yo");
{ sanitize_c_ident } :: import("./atom.yo");
{
  format_typed_init_line,
  format_typed_var_name,
  format_c_function_call
} :: import("../utils/index.yo");
/// True if `expr` is a lambda literal: `(params) -> body` or
/// `(params) => body`.  Used by codegen to detect lambdas being passed
/// as function-pointer arguments.
is_lambda_expr :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, lf, largs, lis_infix, _) => cond(
      (!(lis_infix)) => false,
      (largs.len() != usize(2)) => false,
      true => match(
        lf.*,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, lt) => cond(
          !((lt.value.as_str() == "->") || (lt.value.as_str() == "=>")) => false,
          true => match(
            largs.get(usize(0)),
            .None => false,
            .Some(lhs) => match(
              lhs,
              // Single param: `(u)` is parsed as bare Atom("u") after grouping.
              .Atom(_, lat) => (lat.kind == TokenKind.Identifier),
              // Multi-param tuple: `(u, v)` parsed as FnCall(Atom("tuple"), ...).
              .FnCall(_, llf, _, llis, _) => (
                (!(llis)) && match(
                  llf.*,
                  .FnCall(_, _, _, _, _) => false,
                  .Atom(_, llt) => (llt.value.as_str() == BK_TUPLE)
                )
              )
            )
          )
        )
      )
    )
  )
);
/// Extract parameter names from a lambda params expression.
/// Handles both single bare identifier `(u)` → ["u"] and TUPLE `(u, v)` → ["u", "v"].
extract_lambda_param_names :: (fn(params_expr : AstExpr) -> ArrayList(String))(
  match(
    params_expr,
    // Single param: `(u)` is parsed as bare Atom("u") after grouping.
    .Atom(_, ptok) => {
      names := ArrayList(String).new();
      if(ptok.kind == TokenKind.Identifier, {
        names.push(sanitize_c_ident(ptok.value.as_str()));
      });
      names
    },
    .FnCall(_, _, pargs, _, _) => {
      names := ArrayList(String).new();
      np := pargs.len();
      (pi : usize) = usize(0);
      while(pi < np, {
        match(
          pargs.get(pi),
          .None => (),
          .Some(pe) => match(
            pe,
            .FnCall(_, _, _, _, _) => (),
            .Atom(_, ptok) => {
              if(ptok.kind == TokenKind.Identifier, {
                names.push(sanitize_c_ident(ptok.value.as_str()));
              });
            }
          )
        );
        pi = (pi + usize(1));
      });
      names
    }
  )
);
/// True if the most recent variable named `name` in `env` was bound at
/// a frame level shallower than (or equal to) `capture_frame_level` —
/// i.e. it was captured by an enclosing closure rather than declared
/// locally inside the closure body. Mirrors
/// `checkVariableIsClosureCaptured` in `src/codegen/exprs/closures.ts`.
check_variable_is_closure_captured :: (
  fn(
    name : String,
    env : Environment,
    capture_frame_level : usize
  ) -> bool
)({
  variables := get_variables_from_env(env, name);
  n := variables.len();
  cond(
    (n == usize(0)) => false,
    true => match(
      variables.get(n - usize(1)),
      .None => false,
      .Some(latest) => (latest.frame_level <= capture_frame_level)
    )
  )
});
/// True iff the `ExprInfo` for `expr_id` represents a closure
/// construction — that is, the evaluator attached a
/// `closure_function_value` AND the expression's type implements the
/// `Fn` trait. Mirrors TS `isClosureConstruction`.
///
/// Returns `false` when no `ExprInfo` exists for the id, when the
/// `closure_function_value` slot is `.None`, or when the expression
/// type does not implement `Fn`. Pure read against `ctx`'s
/// ExprInfoTable; no codegen side-state is touched.
is_closure_construction :: (
  fn(expr_id : ExprId, ctx : CodegenContext) -> bool
)(
  match(
    ctx.get_expr_info(expr_id),
    .None => false,
    .Some(info) => cond(
      info.closure_function_value.is_none() => false,
      true => type_implements_fn(info.ty)
    )
  )
);
/// Walk a chain of resolved `SomeType`s and return the concrete type
/// at the end. Mirrors TS `resolveSomeTypeToConcrete` in
/// `src/codegen/exprs/closures.ts`.
///
/// **Stub-as-no-op**: yo-self's `SomeT` does not yet carry the
/// `resolved_concrete_type` field that TS's loop walks, so this
/// helper currently returns `t` unchanged. Once that field is added
/// to `TypeValue.SomeT`, fill in the loop body — the call sites are
/// already wired through the canonical API.
resolve_some_type_to_concrete :: (fn(t : TypeValue) -> TypeValue)(t);
/// Build the C name of the closure constructor function for a given
/// closure C type name: `__yo_create_<closure_c_name>`. Pure string
/// composition — the eventual full `generate_closure_construction`
/// port emits a call to this function.
format_closure_constructor_name :: (fn(closure_c_name : String) -> String)({
  s := String.from("__yo_create_");
  s.push_string(closure_c_name);
  s
});
/// Build the C name of the closure dispose function for a given
/// closure C type name: `__yo_dispose_<closure_c_name>`. Symmetric
/// to `format_closure_constructor_name`.
format_closure_dispose_name :: (fn(closure_c_name : String) -> String)({
  s := String.from("__yo_dispose_");
  s.push_string(closure_c_name);
  s
});
/// Format the dyn-closure construction call site:
///   `__yo_create_<closure_c_name>(<capture_arg>, __yo_dispose_<closure_c_name>, <cast_call_function>)`
///
/// `capture_arg` is either the temp-var name holding the
/// heap-allocated capture struct, or `"NULL"` for closures with no
/// captures. `cast_call_function` is the (∂  type-cast) function-pointer
/// expression for the closure's body.
///
/// Mirrors the two `${constructorName}(...)` return branches in TS
/// `generateClosureConstruction` (with-captures vs without-captures
/// dyn-closure paths). Pure string composition.
format_dyn_closure_construction :: (
  fn(closure_c_name : String, capture_arg : String, cast_call_function : String) -> String
)({
  // Pre-build the comma-joined args: <capture>, __yo_dispose_<name>, <cast>
  args := String.from(capture_arg.as_str());
  args.push_str(", __yo_dispose_");
  args.push_string(closure_c_name);
  args.push_str(", ");
  args.push_str(cast_call_function.as_str());
  format_c_function_call(format_closure_constructor_name(closure_c_name).as_str(), args)
});
/// Build the closure-capture temp variable name:
///   `__capture_<closure_type_id>_<unique_suffix>`
///
/// Mirrors the TS line in `allocateClosureCapture`:
///     `__capture_${closureTypeId}_${uniqueSuffix}`
/// The caller provides `unique_suffix` (typically from a counter or
/// `random_id` call) — the formatter just does the string composition.
format_closure_capture_temp_var :: (
  fn(closure_type_id : String, unique_suffix : String) -> String
)({
  s := String.from("__capture_");
  s.push_string(closure_type_id);
  s.push_str("_");
  s.push_string(unique_suffix);
  s
});
/// Format a stack-allocated closure capture initialisation:
///   `<capture_c_name> <capture_temp_var> = <capture_data_code>;`
///
/// Used by `allocateClosureCapture` when `useStackAllocation` is true
/// (Impl(Fn(...)) closures with no unwind past the current frame).
/// Pure string composition; the heap-alloc counterpart is
/// `format_spawn_heap_alloc` in parallelism.yo.
format_closure_stack_alloc :: (
  fn(capture_c_name : String, capture_temp_var : String, capture_data_code : String) -> String
)(
  // Composes via canonical typed-init helper:
  //   "" + (capture_c_name + " " + capture_temp_var) + " = " + capture_data_code + ";"
  format_typed_init_line(
    String.new(),
    format_typed_var_name(capture_c_name, capture_temp_var),
    capture_data_code
  )
);
export(
  check_variable_is_closure_captured,
  is_closure_construction,
  resolve_some_type_to_concrete,
  format_closure_constructor_name,
  format_closure_dispose_name,
  format_dyn_closure_construction,
  format_closure_capture_temp_var,
  format_closure_stack_alloc,
  is_lambda_expr,
  extract_lambda_param_names
);
