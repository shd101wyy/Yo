//! Codegen helpers for parallelism builtins.
//!
//! Partial 1-to-1 port of `src/codegen/exprs/parallelism.ts`.
//! Two layers:
//!
//!   1. `generate_yo_thread_set_maximum_threads(args, ctx, indent)` —
//!      full metadata-independent handler that recursively lowers the
//!      single numeric argument and emits the runtime call.
//!
//!   2. Pure call-site formatters (no codegen context): used by the
//!      eventual full `generateThreadSpawnCall` / `generateWorkerSpawnCall`
//!      ports after they resolve the spawn-wrapper name and heap-data
//!      variable via `ctx.get_impl_closure(...)` and the closure
//!      heap-alloc machinery. Both spawn calls share the
//!      same `__yo_<kind>_spawn(wrapper_fn, heap_data)` shape.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr } :: import("../../expr.yo");
{ CodegenContext } :: import("../context.yo");
{ format_c_function_call } :: import("../utils/index.yo");
{ call_gen_expr } :: import("./expr.yo");
/// Format `__yo_thread_set_maximum_threads(<num_code>)`. Pure string
/// composition — the runtime call site for the 1-arg builtin.
format_thread_set_max_call :: (fn(num_code : String) -> String)(
  format_c_function_call("__yo_thread_set_maximum_threads", num_code)
);
generate_yo_thread_set_maximum_threads :: (
  fn(args : ArrayList(AstExpr), ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    args.get(usize(0)),
    .None => Option(String).Some(String.from("// Error: __yo_thread_set_maximum_threads requires exactly 1 argument")),
    .Some(num_arg) => match(
      call_gen_expr(num_arg, ctx, indent),
      .None => Option(String).None,
      .Some(num_code) => Option(String).Some(format_thread_set_max_call(num_code))
    )
  )
);
/// Format `__yo_thread_spawn(wrapper_fn, heap_data)`. Mirrors the
/// tail return of TS `generateThreadSpawnCall`. Pure string wrap; the
/// wrapper-fn name and heap-data variable are produced by the
/// (still-pending) closure heap-alloc machinery.
format_thread_spawn_call :: (fn(wrapper_fn : String, heap_data : String) -> String)(
  format_c_function_call(
    "__yo_thread_spawn",
    (wrapper_fn + String.from(", ")) + heap_data
  )
);
/// Format `__yo_worker_spawn(wrapper_fn, heap_data)`. Symmetric to
/// `format_thread_spawn_call` — the only difference is the runtime
/// function name. Mirrors TS `generateWorkerSpawnCall`'s emit line.
format_worker_spawn_call :: (fn(wrapper_fn : String, heap_data : String) -> String)(
  format_c_function_call(
    "__yo_worker_spawn",
    (wrapper_fn + String.from(", ")) + heap_data
  )
);
/// Format the heap-allocation line:
///   `<capture_c_name>* <heap_var> = (<capture_c_name>*)__yo_malloc(sizeof(<capture_c_name>));`
///
/// The two TS spawn handlers emit this verbatim before copying the
/// closure value and dup'ing its RC fields. Pure string wrap — the
/// capture type's C name comes from `getTypeString(concreteType, ctx)`
/// and the heap-var name from a `randomId(...)` call.
format_spawn_heap_alloc :: (
  fn(capture_c_name : String, heap_var : String) -> String
)({
  s := capture_c_name.clone();
  s.push_str("* ");
  s.push_str(heap_var.as_str());
  s.push_str(" = (");
  s.push_str(capture_c_name.as_str());
  s.push_str("*)__yo_malloc(sizeof(");
  s.push_str(capture_c_name.as_str());
  s.push_str("));");
  s
});
export(
  generate_yo_thread_set_maximum_threads,
  format_thread_spawn_call,
  format_worker_spawn_call,
  format_spawn_heap_alloc,
  format_thread_set_max_call
);
