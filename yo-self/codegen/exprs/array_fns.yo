//! Codegen for anonymous arrays and `__yo_array_fill`.
//!
//! 1-to-1 port of `src/codegen/exprs/array-fns.ts`, adapted to yo-self's
//! `ExprInfoTable` side-table for TypeScript `expr.$` metadata.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_id } :: import("../../expr.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_array_type } :: import("../../types/guards.yo");
{ EvalValue } :: import("../../value.yo");
{ random_id } :: import("../../utils.yo");
{ CodegenContext } :: import("../context.yo");
{ call_gen_expr } :: import("./expr.yo");
{
  sanitize_for_c_identifier,
  sanitize_for_c_identifier_str,
  get_type_string_opt,
  get_variable_type_string_opt_str,
  format_indented_stmt,
  format_typed_init_line
} :: import("../utils/index.yo");
// `array_variable_type_string` was a local divergence — its body
// is the canonical `get_variable_type_string_opt_str` in utils.yo.
// Callers are migrated to use the canonical helper directly.
/// Format an array compound literal:
///   `(<array_type_name>){ .data = { <args_list> } }`
///
/// `args_list` is a single pre-joined string of comma-separated
/// element expressions. Mirrors the tail return of TS
/// `generateAnonymousArray` — pure string composition.
format_array_compound_literal :: (
  fn(array_type_name : String, args_list : String) -> String
)({
  s := String.from("(");
  s.push_string(array_type_name);
  s.push_str("){ .data = { ");
  s.push_str(args_list.as_str());
  s.push_str(" } }");
  s
});
// `format_array_indented_stmt` was a local divergence — body identical
// to the canonical `format_indented_stmt` in `codegen/utils/index.yo`.
// Re-exported as an alias for backward compatibility with the test
// import; new callers should import `format_indented_stmt` directly.
format_array_indented_stmt :: (fn(indent : String, code : String) -> String)(
  format_indented_stmt(indent, code)
);
// `format_array_temp_init` was a local divergence — body identical to
// the canonical `format_typed_init_line` in `codegen/utils/index.yo`.
// Re-exported as an alias for backward compatibility with the test
// import; new callers should import `format_typed_init_line` directly.
format_array_temp_init :: (
  fn(indent : String, type_and_name : String, value_code : String) -> String
)(
  format_typed_init_line(indent, type_and_name, value_code)
);
array_apply_deferred_dup :: (
  fn(arg : AstExpr, arg_code : String, ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    ctx.get_expr_info(ast_expr_id(arg)),
    .None => Option(String).Some(arg_code),
    .Some(info) => match(
      info.deferred_dup_expressions,
      .None => Option(String).Some(arg_code),
      .Some(dups) => cond(
        (dups.len() == usize(0)) => Option(String).Some(arg_code),
        true => {
          (i : usize) = usize(0);
          (ok : bool) = true;
          while((i < dups.len()) && ok, {
            match(
              dups.get(i),
              .None => {
                ok = false;
              },
              .Some(dup_expr) => match(
                call_gen_expr(dup_expr, ctx, indent),
                .None => {
                  ok = false;
                },
                .Some(dup_code) => ctx.emitter.emit_string_line(
                  format_array_indented_stmt(indent, dup_code)
                )
              )
            );
            i = (i + usize(1));
          });
          cond(
            (!(ok)) => Option(String).None,
            true => match(
              dups.get(usize(0)),
              .None => Option(String).Some(arg_code),
              .Some(first_dup) => match(
                ctx.get_expr_info(ast_expr_id(first_dup)),
                .None => Option(String).Some(arg_code),
                .Some(dup_info) => match(
                  dup_info.variable_name,
                  .None => Option(String).Some(arg_code),
                  .Some(vn) => Option(String).Some(sanitize_for_c_identifier(vn))
                )
              )
            )
          )
        }
      )
    )
  )
);

array_args_to_c_with_deferred_dup :: (
  fn(args : ArrayList(AstExpr), ctx : CodegenContext, indent : String) -> Option(String)
)({
  out := String.new();
  (i : usize) = usize(0);
  (ok : bool) = true;
  while((i < args.len()) && ok, {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg) => match(
        call_gen_expr(arg, ctx, indent),
        .None => {
          ok = false;
        },
        .Some(arg_code) => match(
          array_apply_deferred_dup(arg, arg_code, ctx, indent),
          .None => {
            ok = false;
          },
          .Some(final_arg_value) => {
            if(i > usize(0), {
              out.push_str(", ");
            });
            out.push_string(final_arg_value);
          }
        )
      )
    );
    i = (i + usize(1));
  });
  cond(ok => Option(String).Some(out), true => Option(String).None)
});

array_value_or_temp :: (
  fn(
    array_ty : TypeValue,
    array_type_name : String,
    args_list : String,
    temp_var : Option(String),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  array_value := format_array_compound_literal(array_type_name, args_list);
  match(
    temp_var,
    .None => Option(String).Some(array_value),
    .Some(tv) => match(
      get_variable_type_string_opt_str(array_ty, tv.as_str(), ctx),
      .None => Option(String).Some(array_value),
      .Some(var_type_and_name) => {
        ctx.emitter.emit_string_line(
          format_array_temp_init(indent, var_type_and_name, array_value)
        );
        Option(String).Some(sanitize_for_c_identifier(tv))
      }
    )
  )
});

generate_anonymous_array :: (
  fn(
    call_expr : AstExpr,
    _args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)(
  match(
    ctx.get_expr_info(ast_expr_id(call_expr)),
    .None => Option(String).None,
    .Some(info) => cond(
      (!(is_array_type(info.ty))) => Option(String).None,
      true => match(
        info.runtime_arg_exprs_in_order,
        .None => Option(String).None,
        .Some(runtime_args) => match(
          get_type_string_opt(info.ty, ctx),
          .None => Option(String).Some(String.from("/* ERROR: array type not found */")),
          .Some(array_type_name) => match(
            array_args_to_c_with_deferred_dup(runtime_args, ctx, indent),
            .None => Option(String).None,
            .Some(args_list) => array_value_or_temp(
              info.ty,
              array_type_name,
              args_list,
              info.variable_name,
              ctx,
              indent
            )
          )
        )
      )
    )
  )
);

extract_array_type_value :: (fn(expr : AstExpr, ctx : CodegenContext) -> Option(TypeValue))(
  match(
    ctx.get_expr_info(ast_expr_id(expr)),
    .None => Option(TypeValue).None,
    .Some(info) => match(
      info.value,
      .None => Option(TypeValue).None,
      .Some(v) => match(
        v,
        .TypeVal(ty) => cond(
          is_array_type(ty.*) => Option(TypeValue).Some(ty.*),
          true => Option(TypeValue).None
        ),
        _ => Option(TypeValue).None
      )
    )
  )
);

array_fill_temp_var_name :: (fn(call_expr : AstExpr, ctx : CodegenContext) -> String)(
  match(
    ctx.get_expr_info(ast_expr_id(call_expr)),
    .Some(info) => match(
      info.variable_name,
      .Some(vn) => sanitize_for_c_identifier(vn),
      .None => (String.from("temp_array_") + random_id(info.env.module_path))
    ),
    .None => (String.from("temp_array_") + random_id(String.from("")))
  )
);

array_fill_index_var_name :: (fn(call_expr : AstExpr, ctx : CodegenContext) -> String)(
  match(
    ctx.get_expr_info(ast_expr_id(call_expr)),
    .Some(info) => (String.from("i_") + random_id(info.env.module_path)),
    .None => (String.from("i_") + random_id(String.from("")))
  )
);

generate_yo_array_fill :: (
  fn(call_expr : AstExpr, args : ArrayList(AstExpr), ctx : CodegenContext, indent : String) -> String
)(
  cond(
    (args.len() < usize(2)) => String.from("/* ERROR: __yo_array_fill requires 2 arguments */"),
    true => match(
      args.get(usize(0)),
      .None => String.from("/* ERROR: __yo_array_fill first argument must be an ArrayType */"),
      .Some(array_type_arg) => match(
        extract_array_type_value(array_type_arg, ctx),
        .None => String.from("/* ERROR: __yo_array_fill first argument must be an ArrayType */"),
        .Some(array_ty) => match(
          args.get(usize(1)),
          .None => String.from("/* ERROR: __yo_array_fill requires fill value */"),
          .Some(fill_value_arg) => match(
            get_type_string_opt(array_ty, ctx),
            .None => String.from("/* ERROR: __yo_array_fill array type not found */"),
            .Some(array_type_name) => match(
              call_gen_expr(fill_value_arg, ctx, indent),
              .None => String.from("/* ERROR: __yo_array_fill failed to generate fill value */"),
              .Some(fill_value_code) => {
                length := match(array_ty,.Array(_, n, _) => n, _ => usize(0));
                temp_var_name := array_fill_temp_var_name(call_expr, ctx);
                index_var_name := array_fill_index_var_name(call_expr, ctx);
                line_decl := indent.clone();
                line_decl.push_string(array_type_name);
                line_decl.push_str(" ");
                line_decl.push_string(temp_var_name);
                line_decl.push_str(";");
                ctx.emitter.emit_string_line(line_decl);
                line_for := indent.clone();
                line_for.push_str("for (int ");
                line_for.push_string(index_var_name);
                line_for.push_str(" = 0; ");
                line_for.push_string(index_var_name);
                line_for.push_str(" < ");
                line_for.push_string(length.to_string());
                line_for.push_str("; ");
                line_for.push_string(index_var_name);
                line_for.push_str("++) {");
                ctx.emitter.emit_string_line(line_for);
                line_assign := indent.clone();
                line_assign.push_str("  ");
                line_assign.push_string(temp_var_name);
                line_assign.push_str(".data[");
                line_assign.push_string(index_var_name);
                line_assign.push_str("] = ");
                line_assign.push_string(fill_value_code);
                line_assign.push_str(";");
                ctx.emitter.emit_string_line(line_assign);
                line_close := indent.clone();
                line_close.push_str("}");
                ctx.emitter.emit_string_line(line_close);
                temp_var_name
              }
            )
          )
        )
      )
    )
  )
);

export(
  generate_anonymous_array,
  generate_yo_array_fill,
  array_args_to_c_with_deferred_dup,
  extract_array_type_value,
  format_array_compound_literal,
  format_array_indented_stmt,
  format_array_temp_init
);
