//! Generate C code for a compile-time `EvalValue`.
//!
//! Partial 1-to-1 port of `src/codegen/exprs/comptime-value.ts`.
//!
//! Currently covers the simple value variants:
//!   - `IntLit(raw)`  → the raw integer text (`123`, `-7`, `0xFF`, …).
//!   - `FloatLit(raw)`  → the raw float text, normalised to include a
//!     decimal point so the C compiler treats it as a `double`.
//!   - `BoolVal(b)`   → `"true"` / `"false"`.
//!   - `StrLit(raw)`  → the raw text. `StringLit`-token raws already
//!     include surrounding `"` and the lexer-preserved escape
//!     sequences, so they're valid C string literals as-is; template
//!     segments (no surrounding quotes) are wrapped and escaped.
//!   - `FuncVal(...)` → the registered C function name, when the
//!     function has been registered via `ctx.register_function`.
//!     Mirrors the TS branch
//!         const cName = context.functions[value.funcId]?.cName;
//!         if (cName) return cName;
//!     and falls back to `.None` when the function has not been
//!     registered yet (caller defers to the bootstrap path).
//!   - `TypeVal(box_ty)` → the C type-name string registered for the
//!     wrapped type, when that type has been registered (typically by
//!     `generate_type_decl`). Mirrors the TS branch
//!         if (context.types[type.id]) return context.types[type.id].cName;
//!     and falls back to `.None` when the type isn't registered.
//!     Note: TS returns an error-comment string instead of None; yo-self
//!     prefers None so the caller can fall back to a bootstrap heuristic
//!     (or to the get_type_string default of `"int32_t"`).
//!
//! Complex variants (`EnumVal`, `StructVal`, `TupleVal`, `ArrayVal`,
//! `PtrVal`, …) require codegen-side type-name lookup
//! (`context.types[id]`), nullable-pointer optimisation, and
//! runtime-type conversion that yo-self's bootstrap codegen does not
//! yet expose. They return `Option(String).None` so callers can defer
//! to the existing AST-only path. Each of those will be ported as the
//! supporting infrastructure lands.
open(import("std/string"));
{ EvalValue } :: import("../../value.yo");
{ TypeValue } :: import("../../types/type.yo");
{ type_to_string } :: import("../../types/string.yo");
{ CodegenContext } :: import("../context.yo");
{ quote_as_c_string } :: import("./panic.yo");
/// Normalise a float-literal raw text so the generated C compiles as a
/// `double`. Adds a `.0` suffix if the raw text has no decimal point
/// (e.g. `"3"` → `"3.0"`). Existing decimal points are preserved.
normalize_float_raw :: (fn(raw : String) -> String)({
  s := raw;
  if(!(s.contains(String.from("."))), {
    s.push_str(".0");
  });
  s
});
/// Format a tag-only enum construction:
///   `(<enum_c_name>){ .tag = <variant_tag> }`
///
/// Used for enums whose selected variant has no data, or whose
/// variants have only unit-typed fields. Pure string composition —
/// the eventual full `generate_comptime_value` for `EnumVal` will
/// call this after looking up `<enum_c_name>` from `ctx.types` and
/// `<variant_tag>` from `get_enum_variant_c_name`. Mirrors the
/// TS branch
///     return `(${cName}){ .tag = ${variantTag} }`;
format_enum_tag_construction :: (
  fn(enum_c_name : String, variant_tag : String) -> String
)({
  s := String.from("(");
  s.push_string(enum_c_name);
  s.push_str("){ .tag = ");
  s.push_string(variant_tag);
  s.push_str(" }");
  s
});
/// Format a tagged-union construction with field initializers:
///   `(<enum_c_name>){ .tag = <variant_tag>, .data = { .<variant_name> = { <field_inits> } } }`
///
/// `field_inits` is a single pre-joined string like
/// `.field0 = v0, .field1 = v1` — the caller is responsible for
/// formatting and joining each field's initialiser. Pure string
/// composition. Mirrors the TS branch
///     return `(${cName}){ .tag = ${variantTag}, .data = { .${variantName} = { ${joined} } } }`;
format_enum_data_construction :: (
  fn(
    enum_c_name : String,
    variant_tag : String,
    variant_name : String,
    field_inits : String
  ) -> String
)({
  s := String.from("(");
  s.push_string(enum_c_name);
  s.push_str("){ .tag = ");
  s.push_string(variant_tag);
  s.push_str(", .data = { .");
  s.push_string(variant_name);
  s.push_str(" = { ");
  s.push_string(field_inits);
  s.push_str(" } } }");
  s
});
/// Format a tuple-struct construction with numeric field initializers:
///   `(<tuple_c_name>){ ._0 = v0, ._1 = v1, ... }`
///
/// `field_inits` is a single pre-joined string of `._<idx> = <code>`
/// pairs. Mirrors the TS tuple-value branch
///     return `(${cName}){ ${fields.join(", ")} }`;
format_tuple_construction :: (
  fn(tuple_c_name : String, field_inits : String) -> String
)({
  s := String.from("(");
  s.push_string(tuple_c_name);
  s.push_str("){ ");
  s.push_string(field_inits);
  s.push_str(" }");
  s
});
/// Generate the C expression for a compile-time `EvalValue`.
/// Returns `.Some(c_expr)` for the supported variants and
/// `.None` for variants whose lowering needs the codegen-side type
/// registry (enums, structs, tuples, arrays, pointers, function
/// values, type values).
generate_comptime_value :: (
  fn(value : EvalValue, ctx : *(CodegenContext)) -> Option(String)
)(
  match(
    value,
    .IntLit(raw) => Option(String).Some(raw),
    .FloatLit(raw) => Option(String).Some(normalize_float_raw(raw)),
    .BoolVal(b) => Option(String).Some(
      cond(
        b => String.from("true"),
        true => String.from("false")
      )
    ),
    .StrLit(raw) => Option(String).Some(quote_as_c_string(raw)),
    .FuncVal({ func_id }) => ctx.*.get_function_c_name(func_id),
    .TypeVal(box_ty) => ctx.*.get_type_c_name(type_to_string(box_ty.*)),
    _ => Option(String).None
  )
);
export(
  generate_comptime_value,
  normalize_float_raw,
  format_enum_tag_construction,
  format_enum_data_construction,
  format_tuple_construction
);
