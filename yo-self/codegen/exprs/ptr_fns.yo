//! Partial 1-to-1 port of `src/codegen/exprs/ptr-fns.ts`.
//!
//! Pure formatters extracted from `generateAddressOf`:
//!
//!   - `format_address_of(arg_code)` — wraps an already-generated C
//!     expression in the `(&...)` address-of form. The tail fallback
//!     path of TS `generateAddressOf`.
//!
//!   - `format_slice_index_range(slice_c_type, array_code, start_code,
//!     end_code, inclusive)` — builds a slice-value compound literal
//!     `(SliceCType){ .data = &<array>.data[<start>], .length = <end> - <start>[+ 1] }`.
//!     Used by the array-range path in `generateAddressOf` for the
//!     forms `*(arr(start..end))` / `*(arr(start..=end))`.
//!
//! Both helpers are pure string transformations — no codegen context,
//! emitter, or AST dispatch required. The remaining specialised
//! paths in `generateAddressOf` (slice/range-target detection,
//! function-pointer extraction, rvalue spill-to-temp) still depend
//! on `context.sliceStructTypes`, the recursive `generateExpr`
//! dispatcher, and the function-cname registry — none yet exposed
//! in yo-self codegen.
open(import("std/string"));
/// Format the C address-of expression `(&arg_code)` — TS
/// `return `(&${argCode})`;` in `generateAddressOf`. Pure string
/// wrap; no codegen context needed.
format_address_of :: (fn(arg_code : String) -> String)({
  s := String.from("(&");
  s.push_str(arg_code.as_str());
  s.push_str(")");
  s
});
/// Build a slice-value compound literal for an array-range expression:
///
///   inclusive=false → `(SliceCType){ .data = &<array>.data[<start>], .length = (<end>) - (<start>) }`
///   inclusive=true  → `(SliceCType){ .data = &<array>.data[<start>], .length = (<end>) - (<start>) + 1 }`
///
/// Mirrors the two return branches inside the `..` / `..=` arm of
/// TS `generateAddressOf`. Pure string composition.
format_slice_index_range :: (
  fn(
    slice_c_type : String,
    array_code : String,
    start_code : String,
    end_code : String,
    inclusive : bool
  ) -> String
)({
  out := String.from("(");
  out.push_string(slice_c_type);
  out.push_str("){ .data = &");
  out.push_str(array_code.as_str());
  out.push_str(".data[");
  out.push_str(start_code.as_str());
  out.push_str("], .length = (");
  out.push_str(end_code.as_str());
  out.push_str(") - (");
  out.push_str(start_code.as_str());
  out.push_str(")");
  if(inclusive, {
    out.push_str(" + 1");
  });
  out.push_str(" }");
  out
});
export(format_address_of, format_slice_index_range);
