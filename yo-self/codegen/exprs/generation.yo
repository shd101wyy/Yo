//! Expression-dispatch body — mirrors `src/codegen/exprs/generation.ts`
//! (`_generateExpr` / `generateFuncCall`). Routes a node to its emitter and is
//! registered as the target of the `_call_generate_expr` indirection
//! (set_generate_expr_fn) so every emitter's recursive calls land here.
//!
//! DEFERRED (documented — emitted as `/* TODO[codegen-port] */` so the
//! differential harness surfaces them): match (match.ts), other-fn-call
//! (other-fn-call.ts — the call/method/trait dispatcher, the real blocker for
//! any program with calls), async/await/spawn/state/JoinHandle (Phase 5), asm/
//! global_asm, unwind (Phase 5 effects), closure-CONSTRUCTION with captures
//! (closures.ts generateClosureConstruction), Index-trait dispatch, the
//! SomeType-Future ___drop/___dup fast path (Phase 5), thread_set_maximum_threads
//! (Phase 5 parallelism). Simple closure/anon-fn VALUES route to
//! generate_comptime_value (the FuncVal), which IS ported.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  ast_expr_token,
  ast_expr_to_string,
  BF_YO_DECR_RC,
  BF_YO_INCR_RC,
  BF_YO_RC_OWN,
  BF_YO_DROP_ARRAY_ELEMENT,
  BF_YO_DUP_ARRAY_ELEMENT,
  BF_YO_DROP_TUPLE_ELEMENT,
  BF_YO_DUP_TUPLE_ELEMENT,
  BF_DROP,
  BF_DUP,
  BF_YO_DYN_DROP,
  BF_YO_DYN_DUP,
  BF_YO_INCR_RC_ATOMIC,
  BF_YO_DECR_RC_ATOMIC,
  BF_YO_ISO_EXTRACT,
  BF_YO_ISO_DISPOSE,
  BF_YO_SOMETYPE_DROP,
  BF_YO_SOMETYPE_DUP,
  BF_YO_GC_COLLECT,
  BF_RC,
  BF_PANIC,
  BF_ASM,
  BF_GLOBAL_ASM,
  BK_TEST,
  BK_OP_AND,
  BK_OP_OR,
  BK_DYN_LOWER,
  BK_RETURN,
  BF_UNWIND,
  BF_ARRAY_FILL,
  BF_DOT,
  BK_BEGIN,
  BK_COND,
  BK_MATCH,
  BF_ADDRESS_OF,
  BK_TUPLE,
  BK_ARRAY_VAL,
  BF_RECUR,
  BF_RUNTIME,
  BF_SIZEOF,
  BF_TYPEID,
  BF_DOWNCAST,
  BK_WHILE,
  BK_FN,
  BF_CONSUME,
  BF_UNSAFE,
  BF_OLD,
  BF_GHOST_FN,
  BF_COMPTIME_EXPECT_ERROR,
  BF_COMPTIME_ASSERT,
  BF_YO_VAR_PRINT_INFO,
  BF_YO_VAR_IS_OWNING_RC,
  BF_YO_VAR_HAS_OTHER_ALIASES,
  BF_REQUIRES,
  BF_ENSURES,
  BF_INVARIANT,
  BF_GHOST,
  BK_OPEN
} :: import("../../expr.yo");
{ has_any_control_flow } :: import("../../expr_info.yo");
{ is_func_val, is_unknown_val } :: import("../../value.yo");
{ is_unit_type } :: import("../../types/guards.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ set_generate_expr_fn, _call_generate_expr } :: import("./_expr.yo");
{ is_builtin_yo_inline_function } :: import("../constants.yo");
{ generate_atom } :: import("./atom.yo");
{ generate_yo_decr_rc, generate_yo_incr_rc, generate_yo_rc_own, generate_yo_decr_rc_atomic, generate_yo_incr_rc_atomic, generate_yo_dyn_drop, generate_yo_dyn_dup, generate_drop, generate_dup, generate_yo_drop_array_element, generate_yo_dup_array_element, generate_yo_drop_tuple_element, generate_yo_dup_tuple_element, generate_yo_sometype_drop, generate_yo_sometype_dup, generate_rc_call } :: import("./rc_fns.yo");
{ generate_yo_iso_extract, generate_yo_iso_dispose, is_iso_type_call, generate_iso_type_call } :: import("./iso.yo");
{ generate_yo_gc_collect } :: import("./gc.yo");
{ generate_panic } :: import("./panic.yo");
{ generate_dyn_call } :: import("./dyn.yo");
{ generate_return } :: import("./return.yo");
{ generate_yo_array_fill, generate_anonymous_array } :: import("./array_fns.yo");
{ generate_binding } :: import("./binding.yo");
{ generate_initialization_assignment } :: import("./init_assignment.yo");
{ generate_assignment } :: import("./assignment.yo");
{ generate_comptime_value } :: import("./comptime_value.yo");
{ generate_field_access } :: import("./property_access.yo");
{ generate_begin } :: import("./begin.yo");
{ generate_cond_expression } :: import("./cond.yo");
{ generate_address_of } :: import("./ptr_fns.yo");
{ generate_anonymous_tuple } :: import("./tuple_fn.yo");
{ generate_recur } :: import("./recur.yo");
{ generate_sizeof } :: import("./sizeof.yo");
{ generate_typeid } :: import("./typeid.yo");
{ generate_downcast } :: import("./downcast.yo");
{ generate_yo_inline_function_call } :: import("./inline_fns.yo");
{ generate_while_loop } :: import("./while_loop.yo");
{ generate_consume } :: import("./consume.yo");
{ generate_open } :: import("./open.yo");
{ generate_op_and, generate_op_or } :: import("./and_or.yo");
{ generate_match_expression } :: import("./match.yo");
{ generate_deferred_dup_expressions } :: import("./drop_dup.yo");
{ get_variable_name_for_codegen } :: import("../utils/index.yo");
{ Environment } :: import("../../env.yo");
/// The callee name of a FnCall (empty for an Atom).
_func_name :: (fn(expr : AstExpr) -> String)(
  match(expr,.FnCall(_, func, _, _, _) => ast_expr_token(func.*).value,.Atom(_, _) => String.from(""))
);
/// Generate the C for a builtin-inline-function call: each arg's code, with
/// deferred-dup rewrite, fed to generate_yo_inline_function_call.
_generate_inline_call :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)({
  ei_opt := context.base.get_expr_info(expr);
  arg_exprs := match(ei_opt,.Some(ei) => match(ei.runtime_arg_exprs_in_order,.Some(ra) => ra,.None => match(expr,.FnCall(_, _, a, _, _) => a,.Atom(_, _) => ArrayList(AstExpr).new())),.None => match(expr,.FnCall(_, _, a, _, _) => a,.Atom(_, _) => ArrayList(AstExpr).new()));
  args := ArrayList(String).new();
  n := arg_exprs.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      arg_exprs.get(i),
      .Some(arg) => {
        arg_code := _call_generate_expr(arg, indent.clone(), context);
        final_code := match(
          context.base.get_expr_info(arg),
          .Some(aei) => match(
            aei.deferred_dup_expressions,
            .Some(dups) => if(dups.len() > usize(0), {
              generate_deferred_dup_expressions(arg, indent.clone(), context);
              match(dups.get(usize(0)),.Some(dup_expr) => if(ast_expr_is_fn_call(dup_expr), match(context.base.get_expr_info(dup_expr),.Some(dei) => match(dei.variable_name,.Some(dvn) => get_variable_name_for_codegen(dvn, Option(Environment).Some(dei.env)),.None => arg_code),.None => arg_code), arg_code),.None => arg_code)
            }, arg_code),
            .None => arg_code
          ),
          .None => arg_code
        );
        _p := args.push(final_code);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  generate_yo_inline_function_call(_func_name(expr), args, expr, context, indent)
});
/// Lower a transparent wrapper (`unsafe`/`old`/`ghost_fn`/`runtime`) to its
/// inner expression's code.
_passthrough_first_arg :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)(
  match(expr,.FnCall(_, _, a, _, _) => match(a.get(usize(0)),.Some(inner) => _call_generate_expr(inner, indent.clone(), context),.None => String.from("")),.Atom(_, _) => String.from(""))
);
/// The function-value of an anon-fn/closure node → its comptime C reference.
_anon_fn_value :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext, err : str) -> String)(
  match(context.base.get_expr_info(expr),.Some(ei) => match(ei.value,.Some(v) => if(is_func_val(v), generate_comptime_value(v, ei.ty, context.base), String.from(err)),.None => String.from(err)),.None => String.from(err))
);
/// Generate a function-call expression. Mirrors `generateFuncCall`.
generate_func_call :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)({
  ei := match(
    context.base.get_expr_info(expr),
    .Some(e) => e,
    .None => {
      out := String.from("// Failed to transpile ");
      out.push_string(ast_expr_to_string(expr));
      return(out);
    }
  );
  // Macro expansion: generate the already-expanded form.
  match(ei.macro_expansion,.Some(mx) => return(_call_generate_expr(mx, indent.clone(), context)),.None => ());
  // (SomeType-Future ___drop/___dup fast path — Phase 5, omitted.)
  // (closure CONSTRUCTION with captures — Phase 3, generateClosureConstruction not ported.)
  // RC builtins.
  if(ast_expr_is_fn_call_of(expr, BF_YO_DECR_RC, Option(usize).None), return(generate_yo_decr_rc(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_INCR_RC, Option(usize).None), return(generate_yo_incr_rc(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_RC_OWN, Option(usize).None), return(generate_yo_rc_own(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_DROP_ARRAY_ELEMENT, Option(usize).None), return(generate_yo_drop_array_element(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_DUP_ARRAY_ELEMENT, Option(usize).None), return(generate_yo_dup_array_element(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_DROP_TUPLE_ELEMENT, Option(usize).None), return(generate_yo_drop_tuple_element(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_DUP_TUPLE_ELEMENT, Option(usize).None), return(generate_yo_dup_tuple_element(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_DUP, Option(usize).None), return(generate_dup(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_DROP, Option(usize).None), return(generate_drop(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_DYN_DROP, Option(usize).None), return(generate_yo_dyn_drop(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_DYN_DUP, Option(usize).None), return(generate_yo_dyn_dup(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_INCR_RC_ATOMIC, Option(usize).None), return(generate_yo_incr_rc_atomic(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_DECR_RC_ATOMIC, Option(usize).None), return(generate_yo_decr_rc_atomic(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_ISO_EXTRACT, Option(usize).None), return(generate_yo_iso_extract(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_ISO_DISPOSE, Option(usize).None), return(generate_yo_iso_dispose(expr, indent.clone(), context)));
  if(is_iso_type_call(expr, context), return(generate_iso_type_call(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_SOMETYPE_DROP, Option(usize).None), return(generate_yo_sometype_drop(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_SOMETYPE_DUP, Option(usize).None), return(generate_yo_sometype_dup(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_YO_GC_COLLECT, Option(usize).None), return(generate_yo_gc_collect(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_RC, Option(usize).None), return(generate_rc_call(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_PANIC, Option(usize).None), return(generate_panic(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_ASM, Option(usize).None), return(String.from("/* TODO[codegen-port]: asm not yet ported */")));
  if(ast_expr_is_fn_call_of(expr, BF_GLOBAL_ASM, Option(usize).None), return(String.from("/* TODO[codegen-port]: global_asm not yet ported */")));
  if(ast_expr_is_fn_call_of(expr, BK_TEST, Option(usize).None), return(String.from("/* test declaration skipped */")));
  if(ast_expr_is_fn_call_of(expr, BK_OP_AND, Option(usize).None), return(generate_op_and(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BK_OP_OR, Option(usize).None), return(generate_op_or(expr, indent.clone(), context)));
  // (io.async / io.await / io.state / io.spawn / JoinHandle.await — Phase 5.)
  if(ast_expr_is_fn_call_of(expr, BK_DYN_LOWER, Option(usize).None), return(generate_dyn_call(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BK_RETURN, Option(usize).None), return(generate_return(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_UNWIND, Option(usize).None), return(String.from("/* TODO[codegen-port]: unwind not yet ported (Phase 5 effects) */")));
  if(ast_expr_is_fn_call_of(expr, BF_ARRAY_FILL, Option(usize).Some(usize(2))), return(generate_yo_array_fill(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, "::", Option(usize).Some(usize(2))), return(String.from("")));
  if(ast_expr_is_fn_call_of(expr, ":", Option(usize).Some(usize(2))), return(generate_binding(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, ":=", Option(usize).Some(usize(2))), match(generate_initialization_assignment(expr, indent.clone(), context),.Some(r) => return(r),.None => ()));
  if(ast_expr_is_fn_call_of(expr, "=", Option(usize).Some(usize(2))), return(generate_assignment(expr, indent.clone(), context)));
  // Already-computed comptime value (non-unit, no control flow).
  match(ei.value,.Some(v) => if((!(is_unknown_val(v)) && !(is_unit_type(ei.ty))) && !(has_any_control_flow(ei.control_flow)), return(generate_comptime_value(v, ei.ty, context.base))),.None => ());
  if(ast_expr_is_fn_call_of(expr, BF_DOT, Option(usize).Some(usize(2))), return(generate_field_access(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BK_BEGIN, Option(usize).None), return(generate_begin(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BK_COND, Option(usize).None), return(generate_cond_expression(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BK_MATCH, Option(usize).None), return(generate_match_expression(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_ADDRESS_OF, Option(usize).Some(usize(1))), return(generate_address_of(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BK_TUPLE, Option(usize).None), return(generate_anonymous_tuple(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BK_ARRAY_VAL, Option(usize).None), match(generate_anonymous_array(expr, indent.clone(), context),.Some(r) => return(r),.None => ()));
  if(ast_expr_is_fn_call_of(expr, BF_RECUR, Option(usize).None), return(generate_recur(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_RUNTIME, Option(usize).Some(usize(1))), return(match(expr,.FnCall(_, _, a, _, _) => match(a.get(usize(0)),.Some(inner) => _call_generate_expr(inner, indent.clone(), context),.None => String.from("")),.Atom(_, _) => String.from(""))));
  if(ast_expr_is_fn_call_of(expr, BF_SIZEOF, Option(usize).Some(usize(1))), return(generate_sizeof(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_TYPEID, Option(usize).Some(usize(1))), return(generate_typeid(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_DOWNCAST, Option(usize).Some(usize(2))), return(generate_downcast(expr, indent.clone(), context)));
  if(is_builtin_yo_inline_function(_func_name(expr)), return(_generate_inline_call(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BK_WHILE, Option(usize).None), return(generate_while_loop(expr, indent.clone(), context)));
  // Anonymous function `fn(x) -> body` → its function value.
  if(ast_expr_is_fn_call_of(expr, "->", Option(usize).Some(usize(2))), {
    arg0_is_fn := match(expr,.FnCall(_, _, a, _, _) => match(a.get(usize(0)),.Some(a0) => ast_expr_is_fn_call_of(a0, BK_FN, Option(usize).None),.None => false),.Atom(_, _) => false);
    if(arg0_is_fn, {
      return(_anon_fn_value(expr, indent.clone(), context, "// Error: Anonymous function missing function value"));
    });
  });
  // Closure `x => body` / `x =>> body` → its function value (capture-struct
  // construction is Phase 3; closure-type annotations fall through).
  if(ast_expr_is_fn_call_of(expr, "=>", Option(usize).Some(usize(2))) || ast_expr_is_fn_call_of(expr, "=>>", Option(usize).Some(usize(2))), {
    is_closure_type := match(expr,.FnCall(_, _, a, _, _) => match(a.get(usize(0)),.Some(a0) => ast_expr_is_fn_call_of(a0, BK_FN, Option(usize).None),.None => false),.Atom(_, _) => false);
    if(!(is_closure_type), {
      return(_anon_fn_value(expr, indent.clone(), context, "// Error: Anonymous closure missing function value"));
    });
  });
  if(ast_expr_is_fn_call_of(expr, BF_CONSUME, Option(usize).None), return(generate_consume(expr, indent.clone(), context)));
  // unsafe / old / ghost_fn — transparent pass-through to the inner expression.
  if(ast_expr_is_fn_call_of(expr, BF_UNSAFE, Option(usize).None), return(_passthrough_first_arg(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_OLD, Option(usize).None), return(_passthrough_first_arg(expr, indent.clone(), context)));
  if(ast_expr_is_fn_call_of(expr, BF_GHOST_FN, Option(usize).None), return(_passthrough_first_arg(expr, indent.clone(), context)));
  // Compile-time-only markers: no C output.
  if(ast_expr_is_fn_call_of(expr, BF_COMPTIME_EXPECT_ERROR, Option(usize).None), return(String.from("")));
  if(ast_expr_is_fn_call_of(expr, BF_COMPTIME_ASSERT, Option(usize).None), return(String.from("")));
  if(ast_expr_is_fn_call_of(expr, BF_YO_VAR_PRINT_INFO, Option(usize).None), return(String.from("")));
  if(ast_expr_is_fn_call_of(expr, BF_YO_VAR_IS_OWNING_RC, Option(usize).None), return(String.from("")));
  if(ast_expr_is_fn_call_of(expr, BF_YO_VAR_HAS_OTHER_ALIASES, Option(usize).None), return(String.from("")));
  if(ast_expr_is_fn_call_of(expr, BF_REQUIRES, Option(usize).None), return(String.from("")));
  if(ast_expr_is_fn_call_of(expr, BF_ENSURES, Option(usize).None), return(String.from("")));
  if(ast_expr_is_fn_call_of(expr, BF_INVARIANT, Option(usize).None), return(String.from("")));
  if(ast_expr_is_fn_call_of(expr, BF_GHOST, Option(usize).None), return(String.from("")));
  if(ast_expr_is_fn_call_of(expr, BK_OPEN, Option(usize).None), return(generate_open(expr, indent.clone(), context)));
  // (Index-trait dispatch — Phase 3, generateIndexTraitCall not ported.)
  // Fallback: ordinary function call (the call/method/trait dispatcher).
  out := String.from("/* TODO[codegen-port]: other-fn-call not yet ported: ");
  out.push_string(ast_expr_to_string(expr));
  out.push_str(" */");
  out
});
/// Top-level expression dispatch. Mirrors `_generateExpr`.
_generate_expr :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)(
  match(expr,.FnCall(_, _, _, _, _) => generate_func_call(expr, indent, context),.Atom(_, _) => generate_atom(expr, context, indent))
);
/// Register `_generate_expr` as the `_call_generate_expr` indirection target.
/// The driver calls this once before walking function bodies.
register_generate_expr :: (fn() -> unit)({
  set_generate_expr_fn(_generate_expr);
});
export(_generate_expr, generate_func_call, register_generate_expr);
