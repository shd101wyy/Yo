//! Codegen for `cond(...)` expressions.
//!
//! 1-to-1 port of `src/codegen/exprs/cond.ts`, adapted to yo-self's
//! `ExprInfoTable` side-table for TypeScript `expr.$` metadata.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_id, BK_BEGIN } :: import("../../expr.yo");
{ EvalValue } :: import("../../value.yo");
{ ExprInfo, has_any_control_flow } :: import("../../expr_info.yo");
{ TypeValue, is_unit_type } :: import("../../types/type.yo");
{ is_temp_variable_name } :: import("../../evaluator/utils.yo");
{ CodegenContext } :: import("../context.yo");
{ call_gen_expr } :: import("./expr.yo");
{
  sanitize_for_c_identifier,
  get_type_string_opt
} :: import("../utils/index.yo");

/// Extract the arm sub-expressions from a cond arm `(cond => body)`.
/// Returns `.None` if the arm is an atom (not a function call).
cond_get_arm_args :: (fn(arm : AstExpr) -> Option(ArrayList(AstExpr)))(
  match(
    arm,
    .Atom(_, _) => Option(ArrayList(AstExpr)).None,
    .FnCall(_, _, arm_args, _, _) => Option(ArrayList(AstExpr)).Some(arm_args)
  )
);

/// True when `cond_expr`'s compile-time value is the boolean `false`.
cond_condition_is_false :: (fn(cond_expr : AstExpr, ctx : *(CodegenContext)) -> bool)(
  match(
    ctx.*.get_expr_info(ast_expr_id(cond_expr)),
    .None => false,
    .Some(info) => match(
      info.value,
      .None => false,
      .Some(v) => match(v,.BoolVal(b) => (!(b)), _ => false)
    )
  )
);

/// True when `cond_expr`'s compile-time value is the boolean `true`.
cond_condition_is_true :: (fn(cond_expr : AstExpr, ctx : *(CodegenContext)) -> bool)(
  match(
    ctx.*.get_expr_info(ast_expr_id(cond_expr)),
    .None => false,
    .Some(info) => match(
      info.value,
      .None => false,
      .Some(v) => match(v,.BoolVal(b) => b, _ => false)
    )
  )
);

/// True when `expr` is a `begin(...)` call.
cond_is_begin_block :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, func_box, _, _, _) => match(
      func_box.*,
      .Atom(_, ftok) => (ftok.value.as_str() == BK_BEGIN),
      .FnCall(_, _, _, _, _) => false
    )
  )
);

/// True when `expr` carries any control-flow metadata (return, escape, break, continue).
cond_has_control_flow :: (fn(expr : AstExpr, ctx : *(CodegenContext)) -> bool)(
  match(
    ctx.*.get_expr_info(ast_expr_id(expr)),
    .None => false,
    .Some(info) => has_any_control_flow(info.control_flow)
  )
);

/// Emit `indent + code + ";\n"` as a C statement.
cond_emit_stmt :: (fn(code : String, ctx : *(CodegenContext), indent : String) -> unit)({
  ctx.*.emitter.emit_string(indent);
  ctx.*.emitter.emit_string(code);
  ctx.*.emitter.emit_line(";");
});
/// Format a bare C variable declaration line:
///   `<indent><c_type> <name>;`
/// Used by `generate_cond` to declare the arm-result temp before the
/// if/else chain emits the body. Pure string composition.
format_cond_temp_decl :: (fn(indent : String, c_type : String, name : String) -> String)({
  s := String.from(indent.as_str());
  s.push_string(c_type);
  s.push_str(" ");
  s.push_string(name);
  s.push_str(";");
  s
});
/// Format an assignment line:
///   `<indent><lhs> = <rhs>;`
/// Used by both `cond_emit_simple_arm` and the last-expression branch
/// of `cond_emit_begin_arm` to assign the arm's value into the
/// pre-declared temp.
format_cond_assignment_line :: (fn(indent : String, lhs : String, rhs : String) -> String)({
  s := String.from(indent.as_str());
  s.push_string(lhs);
  s.push_str(" = ");
  s.push_string(rhs);
  s.push_str(";");
  s
});
/// Format `<indent>if (<cond_code>) {`. Used in two sites:
///   1. The first runtime arm header.
///   2. A nested `else if (...)` inside a subsequent else-block.
/// Pure string composition.
format_cond_if_open :: (fn(indent : String, cond_code : String) -> String)({
  s := String.from(indent.as_str());
  s.push_str("if (");
  s.push_string(cond_code);
  s.push_str(") {");
  s
});
/// Format `<indent>else {`. Subsequent arms in the if-else chain.
format_cond_else_open :: (fn(indent : String) -> String)({
  s := String.from(indent.as_str());
  s.push_str("else {");
  s
});
/// Format `<indent>{`. Used by the first-arm-with-compile-time-true
/// branch to open a plain block without an `if` header.
format_cond_block_open :: (fn(indent : String) -> String)({
  s := String.from(indent.as_str());
  s.push_str("{");
  s
});
/// Format `<indent>}`. Used at multiple close sites in the if-else
/// chain unwind.
format_cond_block_close :: (fn(indent : String) -> String)({
  s := String.from(indent.as_str());
  s.push_str("}");
  s
});

/// Emit all `deferred_drop_expressions` from `info`.
cond_emit_deferred_drops :: (fn(info : ExprInfo, ctx : *(CodegenContext), indent : String) -> unit)({
  match(
    info.deferred_drop_expressions,
    .None => (),
    .Some(drops) => {
      (i : usize) = usize(0);
      while(runtime(i < drops.len()), {
        match(
          drops.get(i),
          .None => (),
          .Some(drop_expr) => match(
            call_gen_expr(drop_expr, ctx, indent),
            .None => (),
            .Some(drop_code) => if(drop_code.len() > usize(0), {
              cond_emit_stmt(drop_code, ctx, indent);
            })
          )
        );
        i = (i + usize(1));
      });
    }
  );
});

/// Emit a `begin(...)` block as the value of a cond arm.
///
/// Mirrors the begin-block handling in `generateCondExpression` (cond.ts lines 209-360).
/// Emits all begin args except the last as statements, assigns the last arg to
/// `temp_var_opt` (when non-unit), then emits deferred drops from the begin block.
cond_emit_begin_arm :: (
  fn(
    begin_expr : AstExpr,
    begin_args : ArrayList(AstExpr),
    temp_var_opt : Option(String),
    is_unit : bool,
    value_indent : String,
    ctx : *(CodegenContext)
  ) -> unit
)({
  inner := (String.from(value_indent.as_str()) + String.from("  "));
  n := begin_args.len();
  (i : usize) = usize(0);
  (stopped : bool) = false;
  // Emit all but the last arg as statements.
  while(runtime((i < n) && (!(stopped))), {
    is_last := (i == (n - usize(1)));
    match(
      begin_args.get(i),
      .None => (),
      .Some(arg) => {
        match(
          call_gen_expr(arg, ctx, inner),
          .None => (),
          .Some(arg_code) => {
            cond(
              is_last => (),
              // handled below
              (arg_code.len() == usize(0)) => (),
              true => {
                should_emit := match(
                  ctx.*.get_expr_info(ast_expr_id(arg)),
                  .None => true,
                  .Some(arg_info) => !(is_temp_variable_name(arg_info.env.module_path, arg_code))
                );
                if(should_emit, {
                  cond_emit_stmt(arg_code, ctx, inner);
                });
                if(cond_has_control_flow(arg, ctx), {
                  stopped = true;
                });
              }
            );
          }
        );
      }
    );
    i = (i + usize(1));
  });
  // Emit the last argument (result of the begin block).
  if((n > usize(0)) && (!(stopped)), {
    match(
      begin_args.get(n - usize(1)),
      .None => (),
      .Some(last_arg) => {
        // Only emit if the last arg has metadata (was evaluated).
        if(ctx.*.get_expr_info(ast_expr_id(last_arg)).is_some(), {
          match(
            call_gen_expr(last_arg, ctx, inner),
            .None => (),
            .Some(last_code) => {
              is_ctrl := cond_has_control_flow(last_arg, ctx);
              cond(
                is_ctrl => cond_emit_stmt(last_code, ctx, inner),
                (last_code.len() == usize(0)) => (),
                (!(is_unit) && temp_var_opt.is_some()) => match(
                  temp_var_opt,
                  .None => (),
                  .Some(tv) => {
                    tv_c := sanitize_for_c_identifier(tv);
                    ctx.*.emitter.emit_string_line(
                      format_cond_assignment_line(inner, tv_c, last_code)
                    );
                  }
                ),
                true => ()
              );
            }
          );
        });
      }
    );
  });
  // Emit deferred drops for the begin block.
  match(
    ctx.*.get_expr_info(ast_expr_id(begin_expr)),
    .None => (),
    .Some(begin_info) => cond_emit_deferred_drops(begin_info, ctx, inner)
  );
});

/// Emit a non-begin expression as the value of a cond arm.
/// Assigns to `temp_var_opt` when non-unit and not control flow.
cond_emit_simple_arm :: (
  fn(
    value_expr : AstExpr,
    temp_var_opt : Option(String),
    is_unit : bool,
    value_indent : String,
    ctx : *(CodegenContext)
  ) -> unit
)({
  match(
    call_gen_expr(value_expr, ctx, value_indent),
    .None => (),
    .Some(value_code) => {
      is_ctrl := cond_has_control_flow(value_expr, ctx);
      cond(
        is_ctrl => cond_emit_stmt(value_code, ctx, value_indent),
        (value_code.len() == usize(0)) => (),
        (!(is_unit) && temp_var_opt.is_some()) => match(
          temp_var_opt,
          .None => (),
          .Some(tv) => {
            tv_c := sanitize_for_c_identifier(tv);
            ctx.*.emitter.emit_string_line(
              format_cond_assignment_line(value_indent, tv_c, value_code)
            );
          }
        ),
        true => ()
      );
    }
  );
});

/// Emit the body of a cond arm — dispatches to begin or simple handler.
cond_emit_arm_value :: (
  fn(
    value_expr : AstExpr,
    temp_var_opt : Option(String),
    is_unit : bool,
    value_indent : String,
    ctx : *(CodegenContext)
  ) -> unit
)(
  match(
    value_expr,
    .Atom(_, _) => cond_emit_simple_arm(value_expr, temp_var_opt, is_unit, value_indent, ctx),
    .FnCall(_, func_box, begin_args, _, _) => cond(
      cond_is_begin_block(value_expr) => cond_emit_begin_arm(value_expr, begin_args, temp_var_opt, is_unit, value_indent, ctx),
      true => cond_emit_simple_arm(value_expr, temp_var_opt, is_unit, value_indent, ctx)
    )
  )
);

/// Generate a `cond(...)` expression using evaluator metadata.
///
/// Returns `.None` when no metadata is available for `expr`, so the caller can
/// fall back to the AST-only `handle_cond` path.
///
/// Mirrors `generateCondExpression` in `src/codegen/exprs/cond.ts`.
generate_cond :: (
  fn(
    expr : AstExpr,
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)(
  match(
    ctx.*.get_expr_info(ast_expr_id(expr)),
    .None => Option(String).None,
    .Some(cond_info) => {
      temp_var_opt := cond_info.variable_name;
      value_type := cond_info.ty;
      is_unit := is_unit_type(value_type);
      n := args.len();

      // First pass: find firstNonFalseBranchIndex — the first arm whose condition
      // is not a compile-time false.
      (first_non_false_idx : i64) = (i64(0) - i64(1));
      (fi : usize) = usize(0);
      while(runtime((fi < n) && (first_non_false_idx < i64(0))), {
        match(
          args.get(fi),
          .None => (),
          .Some(arm) => match(
            cond_get_arm_args(arm),
            .None => (),
            .Some(arm_args) => match(
              arm_args.get(usize(0)),
              .None => (),
              .Some(cond_expr) => {
                if(!(cond_condition_is_false(cond_expr, ctx)), {
                  first_non_false_idx = i64(fi);
                });
              }
            )
          )
        );
        fi = (fi + usize(1));
      });

      // Check canOptimizeToDirect: the first non-false arm has a compile-time-true condition.
      // When true we skip the if-else chain and emit the value directly.
      can_optimize := cond(
        (first_non_false_idx < i64(0)) => false,
        true => match(
          args.get(usize(first_non_false_idx)),
          .None => false,
          .Some(first_arm) => match(
            cond_get_arm_args(first_arm),
            .None => false,
            .Some(faa) => match(
              faa.get(usize(0)),
              .None => false,
              .Some(first_cond) => cond_condition_is_true(first_cond, ctx)
            )
          )
        )
      );

      // Declare the temp variable (non-unit, not direct-optimize).
      // When canOptimizeToDirect the inner expression already has its temp declared.
      if((!(is_unit) && temp_var_opt.is_some()) && (!(can_optimize)), {
        match(
          temp_var_opt,
          .None => (),
          .Some(tv) => {
            match(
              get_type_string_opt(value_type, ctx),
              .None => (),
              .Some(c_type) => {
                tv_c := sanitize_for_c_identifier(tv);
                ctx.*.emitter.emit_string_line(
                  format_cond_temp_decl(indent, c_type, tv_c)
                );
              }
            );
          }
        );
      });

      cond(
        // Direct-optimize path: the first non-false arm is compile-time-true.
        // Emit its value expression inline without an if wrapper.
        can_optimize => {
          if(first_non_false_idx >= i64(0), {
            match(
              args.get(usize(first_non_false_idx)),
              .None => (),
              .Some(arm) => match(
                cond_get_arm_args(arm),
                .None => (),
                .Some(arm_args) => match(
                  arm_args.get(usize(1)),
                  .None => (),
                  .Some(value_expr) => {
                    cond_emit_arm_value(value_expr, temp_var_opt, is_unit, indent, ctx);
                  }
                )
              )
            );
          });
          Option(String).Some(
            cond(
              is_unit => String.new(),
              temp_var_opt.is_some() => match(
                temp_var_opt,
                .None => String.new(),
                .Some(tv) => sanitize_for_c_identifier(tv)
              ),
              true => String.new()
            )
          )
        },
        // Full if-else chain path.
        true => {
          (current_indent : String) = String.from(indent.as_str());
          (else_depth : usize) = usize(0);
          (has_emitted : bool) = false;
          (j : usize) = usize(0);
          (cont : bool) = true;
          while(runtime((j < n) && cont), {
            match(
              args.get(j),
              .None => {
                cont = false;
              },
              .Some(arm) => match(
                cond_get_arm_args(arm),
                .None => {
                  cont = false;
                },
                .Some(arm_args) => {
                  cond_expr_opt := arm_args.get(usize(0));
                  body_opt := arm_args.get(usize(1));
                  match(
                    cond_expr_opt,
                    .None => (),
                    .Some(cond_expr) => {
                      // Skip compile-time false conditions.
                      if(!(cond_condition_is_false(cond_expr, ctx)), {
                        match(
                          body_opt,
                          .None => (),
                          .Some(body_expr) => {
                            is_ct_true := cond_condition_is_true(cond_expr, ctx);

                            // Emit the if/else header for this arm.
                            cond(
                              (!(has_emitted) && is_ct_true) => ctx.*.emitter.emit_string_line(
                                format_cond_block_open(current_indent)
                              ),
                              (!(has_emitted)) => match(
                                call_gen_expr(cond_expr, ctx, current_indent),
                                .None => (),
                                .Some(c_code) => ctx.*.emitter.emit_string_line(
                                  format_cond_if_open(current_indent, c_code)
                                )
                              ),
                              true => {
                                // Subsequent arm: wrap in `else {`.
                                ctx.*.emitter.emit_string_line(format_cond_else_open(current_indent));
                                else_depth = (else_depth + usize(1));
                                current_indent.push_str("  ");
                                if(!(is_ct_true), {
                                  // else if (cond) — nest a runtime condition inside the else.
                                  match(
                                    call_gen_expr(cond_expr, ctx, current_indent),
                                    .None => (),
                                    .Some(c_code) => ctx.*.emitter.emit_string_line(
                                      format_cond_if_open(current_indent, c_code)
                                    )
                                  );
                                });
                              }
                            );
                            has_emitted = true;

                            // Determine the indent for the arm value.
                            // Compile-time true in a subsequent arm uses currentIndent
                            // (no nested `if`); all other arms indent one level deeper.
                            value_indent := cond(
                              (has_emitted && is_ct_true) => String.from(current_indent.as_str()),
                              true => (String.from(current_indent.as_str()) + String.from("  "))
                            );

                            // Emit the arm's value expression.
                            cond_emit_arm_value(body_expr, temp_var_opt, is_unit, value_indent, ctx);

                            // Close the if/block for this arm.
                            // Do NOT close when it's a compile-time-true subsequent arm:
                            // the enclosing else block is closed by the else-depth loop below.
                            needs_closing := !(is_ct_true);
                            if(needs_closing, {
                              ctx.*.emitter.emit_string_line(format_cond_block_close(current_indent));
                            });
                          }
                        );
                      });
                    }
                  );
                }
              )
            );
            j = (j + usize(1));
          });

          // Close all the else blocks that were opened.
          (k : usize) = usize(0);
          while(runtime(k < else_depth), {
            current_indent = current_indent.substring(usize(0), current_indent.len() - usize(2));
            ctx.*.emitter.emit_string_line(format_cond_block_close(current_indent));
            k = (k + usize(1));
          });

          Option(String).Some(
            cond(
              is_unit => String.new(),
              temp_var_opt.is_some() => match(
                temp_var_opt,
                .None => String.new(),
                .Some(tv) => sanitize_for_c_identifier(tv)
              ),
              true => String.new()
            )
          )
        }
      )
    }
  )
);

export(
  generate_cond,
  format_cond_temp_decl,
  format_cond_assignment_line,
  format_cond_if_open,
  format_cond_else_open,
  format_cond_block_open,
  format_cond_block_close
);
