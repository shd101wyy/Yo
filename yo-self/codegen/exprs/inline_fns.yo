//! Codegen for inline builtin function calls (operators, pointer ops,
//! slice helpers, randomness wrappers, sleep, no-op).
//!
//! 1-to-1 port of `src/codegen/exprs/inline-fns.ts`
//! (`generateYoInlineFunctionCall`), including metadata-dependent branches.
//!
//! `generate_yo_inline_function_call` handles metadata-independent builtins.
//! `generate_yo_inline_meta` handles metadata-dependent builtins that need
//! `expr.$.type` (via `ExprInfoTable`): `__yo_as`, `__yo_slice_new`,
//! `__yo_maybe_uninit_new`, `__yo_maybe_uninit_as_ptr`, and index-range ops.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_id } :: import("../../expr.yo");
{ ExprInfo } :: import("../../expr_info.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ CodegenContext } :: import("../context.yo");
{
  can_optimize_as_simple_enum,
  get_type_string_opt,
  format_c_function_call
} :: import("../utils/index.yo");
{
  BF_YO_OP_ADD,
  BF_YO_OP_SUB,
  BF_YO_OP_MUL,
  BF_YO_OP_DIV,
  BF_YO_OP_MOD,
  BF_YO_OP_NEG,
  BF_YO_OP_EQ,
  BF_YO_OP_NEQ,
  BF_YO_OP_LT,
  BF_YO_OP_LTE,
  BF_YO_OP_GT,
  BF_YO_OP_GTE,
  BF_YO_OP_NOT,
  BF_YO_OP_BIT_AND,
  BF_YO_OP_BIT_OR,
  BF_YO_OP_BIT_XOR,
  BF_YO_OP_BIT_COMPLEMENT,
  BF_YO_OP_BIT_LEFT_SHIFT,
  BF_YO_OP_BIT_RIGHT_SHIFT,
  BF_YO_NOOP,
  BF_YO_RETURN_SELF,
  BF_YO_MS_SLEEP,
  BF_YO_PTR_ADD,
  BF_YO_PTR_SUB,
  BF_YO_PTR_DIFF,
  BF_YO_PTR_EQ,
  BF_YO_PTR_NEQ,
  BF_YO_PTR_LT,
  BF_YO_PTR_LTE,
  BF_YO_PTR_GT,
  BF_YO_PTR_GTE,
  BF_YO_SLICE_LEN,
  BF_YO_SLICE_PTR,
  BF_YO_GETRANDOM,
  BF_YO_ARC4RANDOM_BUF,
  BF_YO_BCRYPT_GEN_RANDOM,
  BF_YO_GETENTROPY,
  BF_YO_ARRAY_INDEX,
  BF_YO_SLICE_INDEX,
  BF_YO_DECR_RC,
  BF_YO_MAYBE_UNINIT_ASSUME_INIT,
  BF_YO_AS,
  BF_YO_SLICE_NEW,
  BF_YO_MAYBE_UNINIT_NEW,
  BF_YO_MAYBE_UNINIT_AS_PTR,
  BF_YO_ARRAY_INDEX_RANGE,
  BF_YO_ARRAY_INDEX_RANGE_INCLUSIVE,
  BF_YO_SLICE_INDEX_RANGE,
  BF_YO_SLICE_INDEX_RANGE_INCLUSIVE,
} :: import("../../expr.yo");
emit_binop :: (fn(lhs : str, op : str, rhs : str) -> String)({
  out := String.from("((");
  out.push_str(lhs);
  out.push_str(") ");
  out.push_str(op);
  out.push_str(" (");
  out.push_str(rhs);
  out.push_str("))");
  out
});
emit_unop :: (fn(op : str, operand : str) -> String)({
  out := String.from("(");
  out.push_str(op);
  out.push_str("(");
  out.push_str(operand);
  out.push_str("))");
  out
});
emit_ptr_binop :: (fn(lhs : str, op : str, rhs : str) -> String)({
  out := String.from("(");
  out.push_str(lhs);
  out.push_str(" ");
  out.push_str(op);
  out.push_str(" ");
  out.push_str(rhs);
  out.push_str(")");
  out
});
emit_field :: (fn(base : str, field : str) -> String)({
  out := String.from("(");
  out.push_str(base);
  out.push_str(".");
  out.push_str(field);
  out.push_str(")");
  out
});
emit_call_1 :: (fn(name : str, a0 : str) -> String)(
  format_c_function_call(name, String.from(a0))
);
emit_call_2 :: (fn(name : str, a0 : str, a1 : str) -> String)({
  args := String.from(a0);
  args.push_str(", ");
  args.push_str(a1);
  format_c_function_call(name, args)
});
emit_call_3 :: (fn(name : str, a0 : str, a1 : str, a2 : str) -> String)({
  args := String.from(a0);
  args.push_str(", ");
  args.push_str(a1);
  args.push_str(", ");
  args.push_str(a2);
  format_c_function_call(name, args)
});
emit_array_index :: (fn(arr : str, idx : str) -> String)({
  out := String.from("(&((");
  out.push_str(arr);
  out.push_str(")->data[");
  out.push_str(idx);
  out.push_str("]))");
  out
});
/// Emit a plain C cast expression: `((<target>)(<value>))`. Mirrors the
/// non-tagged-enum branch of `__yo_as` and the body of
/// `__yo_maybe_uninit_as_ptr`. Pure string composition.
emit_cast :: (fn(target_c_type : str, value : str) -> String)({
  out := String.from("((");
  out.push_str(target_c_type);
  out.push_str(")(");
  out.push_str(value);
  out.push_str("))");
  out
});
/// Emit a tag-extracting cast: `((<target>)((<scrutinee>).tag))`. Used
/// by the tagged-enum branch of `__yo_as` when the source is a
/// non-simple enum and we need to grab the discriminant.
emit_cast_enum_tag :: (fn(target_c_type : str, scrutinee : str) -> String)({
  out := String.from("((");
  out.push_str(target_c_type);
  out.push_str(")((");
  out.push_str(scrutinee);
  out.push_str(").tag))");
  out
});
/// Emit the `arc4random_buf` comma-expression call form:
///   `(arc4random_buf(<a0>, <a1>), (void)0)`
/// The trailing `(void)0` lets the call appear as a value expression
/// (returning `void`) — `arc4random_buf` itself returns `void`, so we
/// need to coerce it into a value-of-no-type via the comma operator.
emit_arc4_call :: (fn(a0 : str, a1 : str) -> String)({
  out := String.from("(arc4random_buf(");
  out.push_str(a0);
  out.push_str(", ");
  out.push_str(a1);
  out.push_str("), (void)0)");
  out
});
/// Emit the Windows BCrypt call form:
///   `(int32_t)BCryptGenRandom(NULL, <a0>, <a1>, BCRYPT_USE_SYSTEM_PREFERRED_RNG)`
/// The `int32_t` cast normalises BCrypt's NTSTATUS return type to the
/// portable `i32` Yo expects from `__yo_bcrypt_gen_random`.
emit_bcrypt_call :: (fn(a0 : str, a1 : str) -> String)({
  out := String.from("(int32_t)BCryptGenRandom(NULL, ");
  out.push_str(a0);
  out.push_str(", ");
  out.push_str(a1);
  out.push_str(", BCRYPT_USE_SYSTEM_PREFERRED_RNG)");
  out
});
/// Emit a plain parens-wrap: `(<arg>)`. Used by
/// `__yo_maybe_uninit_assume_init`, whose lowering is the identity on
/// the underlying expression but kept parenthesised for precedence.
emit_paren_wrap :: (fn(arg : str) -> String)({
  out := String.from("(");
  out.push_str(arg);
  out.push_str(")");
  out
});
/// Emit a slice fat-pointer compound literal:
///   `(<slice_c_type>){ .data = <ptr>, .length = <len> }`
/// Mirrors the body of `__yo_slice_new` in TS inline-fns.
emit_slice_construction :: (fn(slice_c_type : str, ptr : str, len : str) -> String)({
  out := String.from("(");
  out.push_str(slice_c_type);
  out.push_str("){ .data = ");
  out.push_str(ptr);
  out.push_str(", .length = ");
  out.push_str(len);
  out.push_str(" }");
  out
});
// `get_type_string_opt` and `can_optimize_as_simple_enum` both live in
// `codegen/utils/index.yo` — the canonical 1-to-1 home for
// `src/codegen/utils/index.ts` helpers. The imports live at the top of
// this file alongside the other utility
// imports.
/// Emit an index-range slice from an array or slice pointer.
/// Mirrors `__yo_array_index_range` / `__yo_slice_index_range` variants in
/// `src/codegen/exprs/inline-fns.ts`.
inline_emit_index_range :: (
  fn(arr : str, range : str, slice_c_type : str, inclusive : bool) -> String
)({
  end_extra := cond(inclusive => String.from(" + 1"), true => String.new());
  out := String.from("(&(");
  out.push_str(slice_c_type);
  out.push_str("){ .data = &((");
  out.push_str(arr);
  out.push_str(")->data[(");
  out.push_str(range);
  out.push_str(").start]), .length = (");
  out.push_str(range);
  out.push_str(").end - (");
  out.push_str(range);
  out.push_str(").start");
  out.push_string(end_extra);
  out.push_str(" })");
  out
});
/// Look up the C type name for a TypeValue.
/// Returns `Option.Some(c_code)` when the builtin is handled; `Option.None` otherwise.
///
/// Mirrors the metadata-dependent branches of `generateYoInlineFunctionCall`
/// in `src/codegen/exprs/inline-fns.ts`.
generate_yo_inline_meta :: (
  fn(
    func_name : str,
    expr : AstExpr,
    args : ArrayList(AstExpr),
    arg_codes : ArrayList(String),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  arg0 := match(arg_codes.get(usize(0)),.None => str(""),.Some(s) => s.as_str());
  arg1 := match(arg_codes.get(usize(1)),.None => str(""),.Some(s) => s.as_str());
  expr_info_opt := ctx.get_expr_info(ast_expr_id(expr));
  cond(
    // __yo_as: cast to target type; for non-simple enums access .tag field.
    (func_name == BF_YO_AS) => match(
      expr_info_opt,
      .None => Option(String).None,
      .Some(info) => match(
        get_type_string_opt(info.ty, ctx),
        .None => Option(String).None,
        .Some(target_c_type) => {
          // Extract str borrow to avoid double-move across cond arms.
          target_c_type_str := target_c_type.as_str();
          // Check if source is a non-simple enum (tagged union) — need .tag access.
          source_is_tagged_enum := match(
            args.get(usize(0)),
            .None => false,
            .Some(arg0_expr) => match(
              ctx.get_expr_info(ast_expr_id(arg0_expr)),
              .None => false,
              .Some(arg0_info) => match(
                arg0_info.ty,
                .EnumT(_, _, _, _, _, _, _) => !(can_optimize_as_simple_enum(arg0_info.ty)),
                _ => false
              )
            )
          );
          result := cond(
            source_is_tagged_enum => emit_cast_enum_tag(target_c_type_str, arg0),
            true => emit_cast(target_c_type_str, arg0)
          );
          Option(String).Some(result)
        }
      )
    ),
    // __yo_slice_new: create a slice fat pointer from a pointer and a length.
    (func_name == BF_YO_SLICE_NEW) => match(
      expr_info_opt,
      .None => Option(String).None,
      .Some(info) => match(
        get_type_string_opt(info.ty, ctx),
        .None => Option(String).None,
        .Some(slice_c_type) => Option(String).Some(
          emit_slice_construction(slice_c_type.as_str(), arg0, arg1)
        )
      )
    ),
    // __yo_maybe_uninit_new: emit an uninitialized C variable and return its name.
    (func_name == BF_YO_MAYBE_UNINIT_NEW) => match(
      expr_info_opt,
      .None => Option(String).None,
      .Some(info) => match(
        get_type_string_opt(info.ty, ctx),
        .None => Option(String).None,
        .Some(self_c_type) => {
          uninit_var := (String.from("__yo_uninit_") + ctx.fresh_temp());
          decl_line := indent.clone();
          decl_line.push_string(self_c_type);
          decl_line.push_str(" ");
          decl_line.push_str(uninit_var.as_str());
          ctx.emitter.emit_string(decl_line);
          ctx.emitter.emit_line(";");
          Option(String).Some(uninit_var)
        }
      )
    ),
    // __yo_maybe_uninit_as_ptr: transparent pointer cast.
    (func_name == BF_YO_MAYBE_UNINIT_AS_PTR) => match(
      expr_info_opt,
      .None => Option(String).None,
      .Some(info) => match(
        get_type_string_opt(info.ty, ctx),
        .None => Option(String).None,
        .Some(return_c_type) => Option(String).Some(
          emit_cast(return_c_type.as_str(), arg0)
        )
      )
    ),
    // __yo_array_index_range / __yo_slice_index_range (exclusive end)
    ((func_name == BF_YO_ARRAY_INDEX_RANGE) || (func_name == BF_YO_SLICE_INDEX_RANGE)) => match(
      expr_info_opt,
      .None => Option(String).None,
      .Some(info) => match(
        info.ty,
        .Pointer(pointee_box) => match(
          get_type_string_opt(pointee_box.*, ctx),
          .None => Option(String).None,
          .Some(slice_c_type) => Option(String).Some(
            inline_emit_index_range(arg0, arg1, slice_c_type.as_str(), false)
          )
        ),
        _ => Option(String).None
      )
    ),
    // __yo_array_index_range_inclusive / __yo_slice_index_range_inclusive
    ((func_name == BF_YO_ARRAY_INDEX_RANGE_INCLUSIVE) || (func_name == BF_YO_SLICE_INDEX_RANGE_INCLUSIVE)) => match(
      expr_info_opt,
      .None => Option(String).None,
      .Some(info) => match(
        info.ty,
        .Pointer(pointee_box) => match(
          get_type_string_opt(pointee_box.*, ctx),
          .None => Option(String).None,
          .Some(slice_c_type) => Option(String).Some(
            inline_emit_index_range(arg0, arg1, slice_c_type.as_str(), true)
          )
        ),
        _ => Option(String).None
      )
    ),
    true => Option(String).None
  )
});
/// True iff `func_name` is a metadata-aware inline builtin handled by
/// `generate_yo_inline_meta`.
is_yo_inline_meta_builtin :: (fn(func_name : str) -> bool)(
  cond(
    (func_name == BF_YO_AS) => true,
    (func_name == BF_YO_SLICE_NEW) => true,
    (func_name == BF_YO_MAYBE_UNINIT_NEW) => true,
    (func_name == BF_YO_MAYBE_UNINIT_AS_PTR) => true,
    (func_name == BF_YO_ARRAY_INDEX_RANGE) => true,
    (func_name == BF_YO_ARRAY_INDEX_RANGE_INCLUSIVE) => true,
    (func_name == BF_YO_SLICE_INDEX_RANGE) => true,
    (func_name == BF_YO_SLICE_INDEX_RANGE_INCLUSIVE) => true,
    true => false
  )
);
/// Look up the inline emission for a builtin by C-emitted argument strings.
/// Returns `Option.Some(c_code)` if `func_name` is a recognised inline
/// builtin and `args` has the right shape; otherwise `Option.None`.
///
/// Mirrors the metadata-independent branches of `generateYoInlineFunctionCall`
/// in `src/codegen/exprs/inline-fns.ts`.
generate_yo_inline_function_call :: (
  fn(func_name : str, arg_codes : ArrayList(String)) -> Option(String)
)({
  arg0 := match(arg_codes.get(usize(0)),.None => str(""),.Some(s) => s.as_str());
  arg1 := match(arg_codes.get(usize(1)),.None => str(""),.Some(s) => s.as_str());
  arg2 := match(arg_codes.get(usize(2)),.None => str(""),.Some(s) => s.as_str());
  cond(
    (func_name == BF_YO_OP_ADD) => Option(String).Some(emit_binop(arg0, "+", arg1)),
    (func_name == BF_YO_OP_SUB) => Option(String).Some(emit_binop(arg0, "-", arg1)),
    (func_name == BF_YO_OP_MUL) => Option(String).Some(emit_binop(arg0, "*", arg1)),
    (func_name == BF_YO_OP_DIV) => Option(String).Some(emit_binop(arg0, "/", arg1)),
    (func_name == BF_YO_OP_MOD) => Option(String).Some(emit_binop(arg0, "%", arg1)),
    (func_name == BF_YO_OP_NEG) => Option(String).Some(emit_unop("-", arg0)),
    (func_name == BF_YO_OP_EQ) => Option(String).Some(emit_binop(arg0, "==", arg1)),
    (func_name == BF_YO_OP_NEQ) => Option(String).Some(emit_binop(arg0, "!=", arg1)),
    (func_name == BF_YO_OP_LT) => Option(String).Some(emit_binop(arg0, "<", arg1)),
    (func_name == BF_YO_OP_LTE) => Option(String).Some(emit_binop(arg0, "<=", arg1)),
    (func_name == BF_YO_OP_GT) => Option(String).Some(emit_binop(arg0, ">", arg1)),
    (func_name == BF_YO_OP_GTE) => Option(String).Some(emit_binop(arg0, ">=", arg1)),
    (func_name == BF_YO_OP_NOT) => Option(String).Some(emit_unop("!", arg0)),
    (func_name == BF_YO_OP_BIT_AND) => Option(String).Some(emit_binop(arg0, "&", arg1)),
    (func_name == BF_YO_OP_BIT_OR) => Option(String).Some(emit_binop(arg0, "|", arg1)),
    (func_name == BF_YO_OP_BIT_XOR) => Option(String).Some(emit_binop(arg0, "^", arg1)),
    (func_name == BF_YO_OP_BIT_COMPLEMENT) => Option(String).Some(emit_unop("~", arg0)),
    (func_name == BF_YO_OP_BIT_LEFT_SHIFT) => Option(String).Some(emit_binop(arg0, "<<", arg1)),
    (func_name == BF_YO_OP_BIT_RIGHT_SHIFT) => Option(String).Some(emit_binop(arg0, ">>", arg1)),
    (func_name == BF_YO_NOOP) => Option(String).Some(String.new()),
    (func_name == BF_YO_RETURN_SELF) => {
      out := String.from("(*");
      out.push_str(arg0);
      out.push_str(")");
      Option(String).Some(out)
    },
    (func_name == BF_YO_MS_SLEEP) => Option(String).Some(emit_call_1("usleep", arg0)),
    (func_name == BF_YO_DECR_RC) => {
      out := String.from("__yo_decr_rc((void*)(");
      out.push_str(arg0);
      out.push_str("))");
      Option(String).Some(out)
    },
    (func_name == BF_YO_PTR_ADD) => Option(String).Some(emit_ptr_binop(arg0, "+", arg1)),
    (func_name == BF_YO_PTR_SUB) => Option(String).Some(emit_ptr_binop(arg0, "-", arg1)),
    (func_name == BF_YO_PTR_DIFF) => Option(String).Some(emit_ptr_binop(arg0, "-", arg1)),
    (func_name == BF_YO_PTR_EQ) => Option(String).Some(emit_ptr_binop(arg0, "==", arg1)),
    (func_name == BF_YO_PTR_NEQ) => Option(String).Some(emit_ptr_binop(arg0, "!=", arg1)),
    (func_name == BF_YO_PTR_LT) => Option(String).Some(emit_ptr_binop(arg0, "<", arg1)),
    (func_name == BF_YO_PTR_LTE) => Option(String).Some(emit_ptr_binop(arg0, "<=", arg1)),
    (func_name == BF_YO_PTR_GT) => Option(String).Some(emit_ptr_binop(arg0, ">", arg1)),
    (func_name == BF_YO_PTR_GTE) => Option(String).Some(emit_ptr_binop(arg0, ">=", arg1)),
    (func_name == BF_YO_SLICE_LEN) => Option(String).Some(emit_field(arg0, "length")),
    (func_name == BF_YO_SLICE_PTR) => Option(String).Some(emit_field(arg0, "data")),
    (func_name == BF_YO_GETRANDOM) => Option(String).Some(emit_call_3("getrandom", arg0, arg1, arg2)),
    (func_name == BF_YO_ARC4RANDOM_BUF) => Option(String).Some(emit_arc4_call(arg0, arg1)),
    (func_name == BF_YO_BCRYPT_GEN_RANDOM) => Option(String).Some(emit_bcrypt_call(arg0, arg1)),
    (func_name == BF_YO_GETENTROPY) => Option(String).Some(emit_call_2("getentropy", arg0, arg1)),
    (func_name == BF_YO_ARRAY_INDEX) => Option(String).Some(emit_array_index(arg0, arg1)),
    (func_name == BF_YO_SLICE_INDEX) => Option(String).Some(emit_array_index(arg0, arg1)),
    (func_name == BF_YO_MAYBE_UNINIT_ASSUME_INIT) => Option(String).Some(emit_paren_wrap(arg0)),
    true => Option(String).None
  )
});
/// True iff `func_name` names an inline builtin handled by
/// `generate_yo_inline_function_call`.
is_yo_inline_builtin :: (fn(func_name : str) -> bool)(
  cond(
    (func_name == BF_YO_OP_ADD) => true,
    (func_name == BF_YO_OP_SUB) => true,
    (func_name == BF_YO_OP_MUL) => true,
    (func_name == BF_YO_OP_DIV) => true,
    (func_name == BF_YO_OP_MOD) => true,
    (func_name == BF_YO_OP_NEG) => true,
    (func_name == BF_YO_OP_EQ) => true,
    (func_name == BF_YO_OP_NEQ) => true,
    (func_name == BF_YO_OP_LT) => true,
    (func_name == BF_YO_OP_LTE) => true,
    (func_name == BF_YO_OP_GT) => true,
    (func_name == BF_YO_OP_GTE) => true,
    (func_name == BF_YO_OP_NOT) => true,
    (func_name == BF_YO_OP_BIT_AND) => true,
    (func_name == BF_YO_OP_BIT_OR) => true,
    (func_name == BF_YO_OP_BIT_XOR) => true,
    (func_name == BF_YO_OP_BIT_COMPLEMENT) => true,
    (func_name == BF_YO_OP_BIT_LEFT_SHIFT) => true,
    (func_name == BF_YO_OP_BIT_RIGHT_SHIFT) => true,
    (func_name == BF_YO_NOOP) => true,
    (func_name == BF_YO_RETURN_SELF) => true,
    (func_name == BF_YO_MS_SLEEP) => true,
    (func_name == BF_YO_DECR_RC) => true,
    (func_name == BF_YO_PTR_ADD) => true,
    (func_name == BF_YO_PTR_SUB) => true,
    (func_name == BF_YO_PTR_DIFF) => true,
    (func_name == BF_YO_PTR_EQ) => true,
    (func_name == BF_YO_PTR_NEQ) => true,
    (func_name == BF_YO_PTR_LT) => true,
    (func_name == BF_YO_PTR_LTE) => true,
    (func_name == BF_YO_PTR_GT) => true,
    (func_name == BF_YO_PTR_GTE) => true,
    (func_name == BF_YO_SLICE_LEN) => true,
    (func_name == BF_YO_SLICE_PTR) => true,
    (func_name == BF_YO_GETRANDOM) => true,
    (func_name == BF_YO_ARC4RANDOM_BUF) => true,
    (func_name == BF_YO_BCRYPT_GEN_RANDOM) => true,
    (func_name == BF_YO_GETENTROPY) => true,
    (func_name == BF_YO_ARRAY_INDEX) => true,
    (func_name == BF_YO_SLICE_INDEX) => true,
    (func_name == BF_YO_MAYBE_UNINIT_ASSUME_INIT) => true,
    true => false
  )
);
export(generate_yo_inline_function_call, is_yo_inline_builtin);
export(generate_yo_inline_meta, is_yo_inline_meta_builtin);
export(
  emit_cast,
  emit_cast_enum_tag,
