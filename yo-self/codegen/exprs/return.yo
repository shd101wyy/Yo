      returned_own := if(
        ast_expr_is_atom(arg) && !(arg_has_dup),
        match(
          context.base.get_expr_info(arg),
          .Some(aei) => {
            name := ast_expr_token(arg).value;
            vars := get_variables_from_env(aei.env, name.clone());
            if(
              vars.len() == usize(0),
              Option(HashSet(String)).None,
              match(
                vars.get(vars.len() - usize(1)),
                .Some(v) => if(v.is_owning_the_rc_value, {
                  s := HashSet(String).new();
                  _a := s.add(name);
                  Option(HashSet(String)).Some(s)
                }, Option(HashSet(String)).None),
                .None => Option(HashSet(String)).None
              )
            )
          },
          .None => Option(HashSet(String)).None
        ),
        Option(HashSet(String)).None
      );
      generate_pending_deferred_drops(indent.clone(), context, expr, false, false, false, returned_own, Option(String).None);
