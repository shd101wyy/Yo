      });
      return_value := if(handled_deferred_dup, arg_code, match(return_temp_var,.Some(rtv) => rtv,.None => arg_code));
      // DEGRADED return for an UNRESOLVED-SomeT fn return. A cee'd function
      // definition whose Impl(...) return check threw mid-body (the divergent-
      // return validation) leaves a half-registered fn in yo-self's mutable
      // registries; its declared return stays an unresolved SomeT (C: void*)
      // while an already-evaluated `return(<concrete>)` would emit e.g.
      // `return <int32_t temp>;` — invalid C ("incompatible integer to
      // pointer conversion", the tests/impl batch clang error). TS never
      // emits such fns (the throw discards the whole definition); yo-self
      // can't roll registrations back, so emit a null-pointer return instead.
      // The fn has no callers — the statements that would call it were
      // dropped by the same throw. Guarded to EXACTLY the mismatch case:
      // declared return still SomeT after resolution AND the returned
      // value's type is concrete (not a SomeT itself).
      declared_ret_unresolved := match(
        context.current_function_type,
        .Some(cft_dr) => match(
          cft_dr,
          .Func({ result : dr_r }) => is_some_type(resolve_some_type_to_concrete(dr_r.clone())),
          _ => false
        ),
        .None => false
      );
      if(declared_ret_unresolved && !(is_some_type(ei.ty)), {
        return(String.from("return (void*)0; // degraded: unresolved Impl(...) return on a definition whose evaluation threw"));
      });
      // DEGRADED return when the VALUE expression itself failed to
      // transpile (its ExprInfo was dropped by an eval throw inside the
      // same definition — e.g. a comptime_expect_error that did not error
      // abandons the fn body's begin). Emitting `return <comment>` splices
      // the next C line into the return ("expected expression", the fn
      // batch clang error). TS never emits such fns (the throw discards
      // the definition); like the Impl(...) degrade above, the fn has no
      // callers — the calling statements were dropped by the same throw.
      if(return_value.starts_with("// Failed to transpile"), {
        return(return_value);
      });
      out := String.from("return ");
      out.push_string(return_value);
