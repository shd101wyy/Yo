          context.in_async_state_machine,
          .Some(_) => match(
            arg_ei_opt,
            .Some(aei_t) => {
              at := aei_t.ty;
              if(!(is_some_type(at)), {
                sm_output_rt = Option(String).Some(get_type_string(at, context.base));
              }, {
                match(
                  at,
                  .SomeT({ id : aid_t }) => match(
                    lookup_some_resolved_concrete(aid_t),
                    .Some(act) => {
                      sm_output_rt = Option(String).Some(get_type_string(act, context.base));
                    },
                    .None => ()
                  ),
                  _ => ()
                );
              });
            },
            .None => ()
          ),
          .None => ()
        );
        match(
          sm_output_rt,
          .Some(srt) => srt,
          .None => {
            raw_rt := get_type_string(ei.ty, context.base);
            cond(
              (raw_rt == "void*") => match(
                context.current_function_type,
                .Some(ft) => match(
                  ft,
                  .Func({ result : r }) => {
                    fr := get_type_string(r, context.base);
                    cond((fr == "void*") => raw_rt, true => fr)
