      // consumed-var escape drops below cannot release any of them a second
      // time. Same pair `generate_pending_deferred_drops` treats as already
      // dropped. Mirrors return.ts's `droppedByThisReturn`.
      dropped_by_this_return := HashSet(String).new();
      match(
        context.base.get_expr_info(expr),
        .Some(rei) => {
          match(
            rei.deferred_drop_expressions,
            .Some(dds) => {
              (ddi : usize) = usize(0);
              while(ddi < dds.len(), {
                match(
                  dds.get(ddi),
                  .Some(de) => match(
                    get_deferred_drop_target_atom_name(de),
                    .Some(vn) => {
                      _a := dropped_by_this_return.add(vn);
                    },
                    .None => ()
                  ),
                  .None => ()
                );
                ddi = (ddi + usize(1));
              });
            },
            .None => ()
          );
          match(
            rei.early_return_only_deferred_drop_expressions,
            .Some(eds) => {
              (edi : usize) = usize(0);
              while(edi < eds.len(), {
                match(
                  eds.get(edi),
                  .Some(de) => match(
                    get_deferred_drop_target_atom_name(de),
                    .Some(vn) => {
                      _a := dropped_by_this_return.add(vn);
                    },
                    .None => ()
                  ),
                  .None => ()
                );
                edi = (edi + usize(1));
              });
            },
            .None => ()
          );
        },
        .None => ()
      );
      generate_deferred_drop_expressions(expr, indent.clone(), context);
      generate_early_return_only_deferred_drop_expressions(expr, indent.clone(), context);
      // Async state-machine return: complete the Future instead of emitting a
      // C `return <value>` (return.ts:653-683) — store the result on the SM,
      // set state -1, spawn the continuation. Without this the closure's tail
      // `return(x)` emitted NOTHING (the old Phase-5 stub returned "") and the
      // machine never completed (fs/file read_string: empty final state).
      match(
        context.in_async_state_machine,
        .Some(iasm) => {
          child_ty := match(
            extract_future_trait_from_type(iasm.future_type),
            .Some(ftt) => match(ftt,.FutureTraitT({ output : o }) => o.clone(), _ => t_unit()),
            .None => t_unit()
          );
          is_unit_result := is_unit_type(child_ty);
          generate_pending_deferred_drops(indent.clone(), context, expr, true, false, false, Option(HashSet(String)).None, Option(String).None);
          em_sm := context.base.emitter;
          em_sm.emit_string_line(`${indent.clone()}// Final state - complete the result Future`);
          result_code := if(
            is_unit_result,
            Option(String).None,
            Option(String).Some(match(return_temp_var,.Some(rtv2) => rtv2,.None => arg_code.clone()))
          );
          emit_async_future_completion(em_sm, indent.clone(), result_code, Option(String).Some(context.base.current_function_name.clone()));
