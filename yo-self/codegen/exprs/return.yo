//! `return` statement emitter — mirrors `src/codegen/exprs/return.ts`.
//!
//! Emits the return value into the evaluator-provided result temp (so deferred
//! drops run after the value is captured), then the enclosing scope's pending
//! deferred drops (filtered by variable identity + declaration position so a
//! same-named shadowing binding never stands in for an outer variable, and
//! consumed/uninitialized variables are skipped), then `return <temp>`.
//!
//! DEFERRED (documented): async state-machine return completion + ctl-handler
//! resume (Phase 5 — emitAsyncFutureCompletion / continuation_variables not
//! ported; gated on in_async_state_machine = .None for the corpus); the
//! inout-param shadow guard uses Variable.isRef which yo-self lacks → false
//! (inside the deferred-dup block, which is empty for the no-RC corpus).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ AstExpr, ast_expr_is_atom, ast_expr_is_fn_call, ast_expr_is_fn_call_of, ast_expr_token, BF_DROP, BF_DOT, BF_UNWIND, BK_RETURN } :: import("../../expr.yo");
{ Token } :: import("../../token.yo");
{ Variable, Environment, get_variables_from_env } :: import("../../env.yo");
{ is_unit_type, is_some_type } :: import("../../types/guards.yo");
{ lookup_some_resolved_concrete } :: import("../../expr_info.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ emit_async_future_escape, emit_async_future_completion } :: import("./async_completion.yo");
{ resolve_some_type_to_concrete } :: import("./closures.yo");
{ extract_future_trait_from_type } :: import("../../evaluator/trait_checking.yo");
{ t_unit } :: import("../../types/creators.yo");
{ generate_atom } :: import("./atom.yo");
{ generate_deferred_drop_expressions, generate_deferred_dup_expressions } :: import("./drop_dup.yo");
{ get_type_string, get_variable_name_for_codegen, get_deferred_drop_target_atom_name, is_deferred_drop_for_closure_capture, sanitize_for_c_identifier, scope_stack_contains } :: import("../utils/index.yo");
/// The atom a `___drop(x)` / `x.___drop()` drop expression targets.
_drop_target_atom :: (fn(drop_expr : AstExpr) -> Option(AstExpr))(
  match(
    drop_expr,
    .FnCall(_, func, args, _, _) => if(
      args.len() == usize(0),
      match(
        func,
        .FnCall(_, _, fargs, _, _) => if(ast_expr_is_fn_call_of(func, BF_DOT, Option(usize).Some(usize(2))), {
          a1_is_drop := match(fargs.get(usize(1)),.Some(a1) => if(ast_expr_is_atom(a1), ast_expr_token(a1).value == BF_DROP, false),.None => false);
          if(a1_is_drop, match(fargs.get(usize(0)),.Some(a0) => if(ast_expr_is_atom(a0), Option(AstExpr).Some(a0), Option(AstExpr).None),.None => Option(AstExpr).None), Option(AstExpr).None)
        }, Option(AstExpr).None),
        .Atom(_, _) => Option(AstExpr).None
      ),
      if(ast_expr_is_fn_call_of(drop_expr, BF_DROP, Option(usize).None), match(args.get(usize(0)),.Some(a0) => if(ast_expr_is_atom(a0), Option(AstExpr).Some(a0), Option(AstExpr).None),.None => Option(AstExpr).None), Option(AstExpr).None)
    ),
    .Atom(_, _) => Option(AstExpr).None
  )
);
/// Whether `drop_expr` targets the C variable named by `escaped_result` — the
/// result temp of a call that just unwound. Mirrors TS's
/// `getDeferredDropTargetCName(dropExpr) === escapedCallResultCName`
/// (src/codegen/exprs/return.ts). The comparison is on the CODEGEN name, not the
/// atom name, because that is the identifier the drop actually emits.
_drop_targets_escaped_result :: (fn(drop_expr : AstExpr, escaped_result : Option(String), context : FunctionGenerationContext) -> bool)(
  match(
    escaped_result,
    .Some(name) => match(
      _drop_target_atom(drop_expr),
      .Some(atom) => match(
        context.base.get_expr_info(atom),
        .Some(aei) => (
          get_variable_name_for_codegen(
            ast_expr_token(atom).value,
            Option(Environment).Some(aei.env)
          ) == name
        ),
        .None => false
      ),
      .None => false
    ),
    .None => false
  )
);
/// The Variable a drop expression targets (resolved via the atom's ExprInfo env).
/// Mirrors `getDeferredDropTargetVariable`.
_get_deferred_drop_target_variable :: (fn(drop_expr : AstExpr, context : FunctionGenerationContext) -> Option(Variable))(
  match(
    _drop_target_atom(drop_expr),
    .Some(atom) => match(
      context.base.get_expr_info(atom),
      .Some(aei) => {
        vars := get_variables_from_env(aei.env, ast_expr_token(atom).value);
        if(vars.len() == usize(0), Option(Variable).None, vars.get(vars.len() - usize(1)))
      },
      .None => Option(Variable).None
    ),
    .None => Option(Variable).None
  )
);
/// Two tokens come from the same source location stream. Mirrors `tokensAreComparable`.
_tokens_are_comparable :: (fn(left : Token, right : Token) -> bool)(
  (left.module_path == right.module_path) && (left.input == right.input)
);
/// `left` is at or before `right` (same stream). Mirrors `tokenIsAtOrBefore`.
_token_is_at_or_before :: (fn(left : Token, right : Token) -> bool)(
  if(!(_tokens_are_comparable(left, right)), false, left.character <= right.character)
);
/// The latest comparable token in `node`'s tree (max character). Mirrors the
/// `visit` walk of `getLastComparableTokenInExpr`.
_max_comparable_token :: (fn(node : AstExpr, reference : Token, best : Token) -> Token)({
  tok := ast_expr_token(node);
  best2 := if(_tokens_are_comparable(tok, reference) && (tok.character > best.character), tok, best);
  match(
    node,
    .FnCall(_, func, args, _, _) => {
      (acc : Token) = recur(func, reference, best2);
      n := args.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          args.get(i),
          .Some(a) => {
            acc = recur(a, reference, acc);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      acc
    },
    .Atom(_, _) => best2
  )
});
/// Mirrors `getLastComparableTokenInExpr`.
_get_last_comparable_token_in_expr :: (fn(expr : AstExpr, reference : Token) -> Token)({
  init := ast_expr_token(expr);
  init2 := if(!(_tokens_are_comparable(init, reference)), reference, init);
  _max_comparable_token(expr, reference, init2)
});
/// Mirrors `variableWasConsumedBeforeCleanupPoint`.
_variable_was_consumed_before_cleanup_point :: (fn(consumed_at_token : Token, cleanup_expr : AstExpr) -> bool)({
  if(!(_tokens_are_comparable(consumed_at_token, ast_expr_token(cleanup_expr))), {
    return(false);
  });
  cleanup_point := _get_last_comparable_token_in_expr(cleanup_expr, consumed_at_token);
  _token_is_at_or_before(consumed_at_token, cleanup_point)
});
/// Resolve which in-scope variable a pending drop targets at a cleanup point.
/// Prefer the id match; on absence decide by declaration position (a target
/// declared AFTER the cleanup point is the shadowing-bug case → skip). Mirrors
/// `resolveDropTargetInScope`.
_resolve_drop_target_in_scope :: (fn(drop_expr : AstExpr, variables : ArrayList(Variable), cleanup_token : Token, context : FunctionGenerationContext) -> Option(Variable))(
  match(
    _get_deferred_drop_target_variable(drop_expr, context),
    .None => if(variables.len() == usize(0), Option(Variable).None, variables.get(variables.len() - usize(1))),
    .Some(tv) => {
      n := variables.len();
      (i : usize) = usize(0);
      (by_id : Option(Variable)) = Option(Variable).None;
      while(i < n, {
        match(
          variables.get(i),
          .Some(v) => if(v.id == tv.id, {
            by_id = Option(Variable).Some(v);
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      match(
        by_id,
        .Some(v) => Option(Variable).Some(v),
        .None => {
          decl_token := match(tv.initialized_at_token,.Some(t) => t,.None => tv.token);
          if(_tokens_are_comparable(decl_token, cleanup_token) && (decl_token.character > cleanup_token.character), Option(Variable).None, if(variables.len() == usize(0), Option(Variable).None, variables.get(variables.len() - usize(1))))
        }
      )
    }
  )
);
/// True if `init_token` (where a variable is initialized) is strictly AFTER
/// the cleanup point of `cleanup_expr` in the SAME comparable token stream —
/// i.e. the variable's C declaration appears LATER than this drop site, so it
/// is not yet in C scope here. Mirrors `_variable_was_consumed_before_cleanup_point`
/// (same token machinery). Conservative: returns false when the tokens are not
/// comparable (different file/synthetic), so a drop is never wrongly suppressed
/// outside the provable same-stream forward-reference case.
_variable_initialized_after_cleanup_point :: (fn(init_token : Token, cleanup_expr : AstExpr) -> bool)({
  if(!(_tokens_are_comparable(init_token, ast_expr_token(cleanup_expr))), {
    return(false);
  });
  cleanup_point := _get_last_comparable_token_in_expr(cleanup_expr, init_token);
  !(_token_is_at_or_before(init_token, cleanup_point))
});
/// Whether a pending drop should be emitted at this return's cleanup point.
_keep_pending_drop :: (fn(drop_expr : AstExpr, expr : AstExpr, already : HashSet(String), additional_skip : Option(HashSet(String)), use_env : bool, context : FunctionGenerationContext) -> bool)({
  var_name := match(get_deferred_drop_target_atom_name(drop_expr),.Some(vn) => vn,.None => return(false));
  if(is_deferred_drop_for_closure_capture(drop_expr, context.current_closure_captures), {
    return(false);
  });
  // The enclosing assignment's save-old-value temp receives ownership only
  // AFTER the assignment completes; while its RHS is being generated an
  // escape here must NOT drop it — the local variable still owns the value
  // and its own scope drop covers it (dropping both double-frees the old
  // value: the round-4 `rhs = evaluate(rhs)` escape UAF in
  // evaluate_initialization_assignment; TS's eval-time env excludes the
  // not-yet-defined temp naturally — its escape lists drop only the local).
  if(match(context.current_assignment_save_temp,.Some(sv) => (sv == var_name),.None => false), {
    return(false);
  });
  if(already.contains(var_name.clone()), {
    return(false);
  });
  if(match(additional_skip,.Some(s) => s.contains(var_name.clone()),.None => false), {
    return(false);
  });
  // C-emission-order guard, applied on ALL paths — including the escape path,
  // where the caller passes skip_env_check=true and the env-based resolution
  // below (which also enforces this via declared_c_var_names at the end) is
  // skipped. A minted codegen temp whose C declaration has NOT been emitted at
  // this point holds no C value, so dropping it emits
  // `__yo_decr_rc((void*)(x))` for an undeclared identifier. yo-self
  // over-materializes some intermediate temps that codegen folds inline (never
  // declaring them) yet still schedules their scope-end drop; TS does not
  // create those frame variables, so its escape path never sees them. Skipping
  // an undeclared temp's drop cannot double-free or leak (no C variable exists).
  // See issues/fixed/yo-self-fixpoint-eval-phase-leak.md.
  guard_cn := sanitize_for_c_identifier(var_name.clone(), false);
  if(guard_cn.contains(String.from("_temp_")) && !(context.base.declared_c_var_names.contains(guard_cn.clone())), {
    return(false);
  });
  if(!(use_env), {
    // Escape path (skip_env_check=true): yo-self's recorded env is END-of-scope,
    // so the env-based filter below wrongly rejects a still-live local (a
    // loop-body `h` across a may-unwind call — the per-call callee_env leak) and
    // wrongly ACCEPTS a local whose C decl follows the escape (`p := if(… raise()
    // …)`). The only sound signal is the block-scope stack maintained by the
    // emitter (`_emitter_track_scope`): keep the drop iff its target C variable is
    // in SOME still-open C block frame — declared BEFORE this escape AND still in
    // scope. This drops a live loop-body/callee local (its frame is open → the
    // callee_env leak this closes) while skipping a control-flow-initialized
    // binding whose C decl lands in an enclosing frame only after its arm frames
    // pop (absent here → op_result_val) and a sibling match-arm binding (its frame
    // popped when the arm closed). Consumption still suppresses the drop.
    // See issues/fixed/yo-self-fixpoint-eval-phase-leak.md.
    match(
      _get_deferred_drop_target_variable(drop_expr, context),
      .Some(tv) => {
        consumed_esc := match(tv.consumed_at_token,.Some(ct) => _variable_was_consumed_before_cleanup_point(ct.*, expr),.None => false);
        if(consumed_esc, {
          return(false);
        });
      },
      .None => ()
    );
    return(scope_stack_contains(context.base.declared_scopes, guard_cn.clone()));
  });
  env := match(context.base.get_expr_info(expr),.Some(ei) => ei.env,.None => return(true));
  variables := get_variables_from_env(env, var_name);
  if(variables.len() == usize(0), {
    return(false);
  });
  latest_var := match(_resolve_drop_target_in_scope(drop_expr, variables, ast_expr_token(expr), context),.Some(v) => v,.None => return(false));
  consumed_before := match(latest_var.consumed_at_token,.Some(ct) => _variable_was_consumed_before_cleanup_point(ct.*, expr),.None => false);
  if(consumed_before, {
    return(false);
  });
  // Skip a variable whose C declaration appears LATER than this drop site: a
  // mid-body escape check (`if(__yo_effect_escaped){...}`) after a call drops
  // the pending list, but that list (accumulated over the whole function body)
  // includes locals declared AFTER this point (forward C references) — dropping
  // them emits `__yo_decr_rc((void*)(x))` for an undeclared `x`. The env check
  // above alone does NOT catch this: the recorded env is the END-of-scope env,
  // which lists those later locals. (Stage-2 self-compile fixpoint; see
  // issues/retired/yo-self-binary-codegen-state.md.)
  //
  // Authoritative C-emission-order guard. The source-order token heuristic below
  // cannot see that a `x := match(...)` / `cond(...)` binding emits its C
  // declaration AFTER the RHS's switch — so a `throw` inside the RHS precedes x's
  // declaration in C, and dropping x here references an undeclared identifier.
  // TS avoids this because each expr carries a point-in-time env (persistent —
  // defineVariable/pushEnvFrame return NEW Environment objects) where the
  // not-yet-completed binding's `initializedAtToken` is still unset; yo-self's
  // recorded env is the END-of-scope env, so we use the emitter-maintained
  // block-scope stack as the C-emission-order ground truth: the drop target's
  // C declaration must have been emitted AND its enclosing C block must still
  // be open at this exact point. The flat declared_c_var_names set is NOT
  // enough — it is monotonic, so a same-named local declared in an earlier,
  // already-CLOSED sibling block keeps the name in the set and the drop would
  // reference an out-of-scope identifier. A target absent from the stack holds
  // no C value here, so skipping its drop cannot double-free or leak.
  c_name := sanitize_for_c_identifier(var_name, false);
  if(!(scope_stack_contains(context.base.declared_scopes, c_name)), {
    return(false);
  });
  match(
    latest_var.initialized_at_token,
    .Some(it) => !(_variable_initialized_after_cleanup_point(it, expr)),
    .None => false
  )
});
/// Generate pending deferred drops from enclosing scopes before an early
/// return. Mirrors `generatePendingDeferredDrops` (the effect-SM consumed-arg
/// clause is Phase 5 and omitted).
/// `escaped_result` is the C name of the result temp of a call that just
/// unwound. On that path the callee discarded its continuation instead of
/// returning, so the temp was never assigned and still holds whatever the ABI
/// left in the return registers — dropping it dereferences garbage. Mirrors
/// TS's `escapedCallResultCName` (src/codegen/exprs/return.ts).
generate_pending_deferred_drops :: (fn(indent : String, context : FunctionGenerationContext, expr : AstExpr, is_completion : bool, skip_already_dropped : bool, skip_env_check : bool, additional_skip : Option(HashSet(String)), escaped_result : Option(String)) -> unit)(
  match(
    context.pending_deferred_drops,
    .Some(pending) => if(pending.len() > usize(0), {
      already := HashSet(String).new();
      if(!(skip_already_dropped), {
        match(
          context.base.get_expr_info(expr),
          .Some(ei) => match(
            ei.deferred_drop_expressions,
            .Some(drops) => {
              nd := drops.len();
              (di : usize) = usize(0);
              while(di < nd, {
                match(
                  drops.get(di),
                  .Some(d) => match(
                    get_deferred_drop_target_atom_name(d),
                    .Some(vn) => {
                      _a := already.add(vn);
                    },
                    .None => ()
                  ),
                  .None => ()
                );
                di = (di + usize(1));
              });
            },
            .None => ()
          ),
          .None => ()
        );
      });
      has_env := match(context.base.get_expr_info(expr),.Some(_) => true,.None => false);
      use_env := (has_env && !(skip_env_check));
      drops_to_emit := ArrayList(AstExpr).new();
      n := pending.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          pending.get(i),
          .Some(de) => if(_keep_pending_drop(de, expr, already, additional_skip, use_env, context) && !(_drop_targets_escaped_result(de, escaped_result, context)), {
            _p := drops_to_emit.push(de);
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      if(drops_to_emit.len() > usize(0), {
        em := context.base.emitter;
        msg := indent.clone();
        msg.push_str(if(is_completion, "// Drop local variables before early completion", "// Drop local variables before early return"));
        em.emit_string_line(msg);
        m := drops_to_emit.len();
        (j : usize) = usize(0);
        while(j < m, {
          match(
            drops_to_emit.get(j),
            .Some(de) => {
              code := _call_generate_expr(de, indent.clone(), context);
              if(code.len() > usize(0), {
                line := indent.clone();
                line.push_string(code);
                line.push_str(";");
                em.emit_string_line(line);
              });
            },
            .None => ()
          );
          j = (j + usize(1));
        });
      });
    }),
    .None => ()
  )
);
/// Generate drops for consumed variables on unwind/escape paths. Mirrors
/// `generateConsumedVarDropsForEscape`.
///
/// `exclude` names variables already released earlier in this same escape
/// sequence (the caller's own deferred drops); re-releasing one here would be a
/// double free. TS spells this as an optional trailing `excludeVarNames`
/// parameter — Yo has no optional parameters, so every call site passes it
/// explicitly (`.None` where TS omits it).
generate_consumed_var_drops_for_escape :: (fn(indent : String, context : FunctionGenerationContext, expr : AstExpr, skip_env_check : bool, exclude : Option(HashSet(String)), escaped_result : Option(String)) -> unit)(
  match(
    context.consumed_var_pending_drops,
    .Some(pending) => if(pending.len() > usize(0), {
      has_env := match(context.base.get_expr_info(expr),.Some(_) => true,.None => false);
      use_env := (has_env && !(skip_env_check));
      drops_to_emit := ArrayList(AstExpr).new();
      n := pending.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          pending.get(i),
          .Some(de) => {
            // Excluded (already released by the caller's own drops) — skip
            // before the env/initialization guards below.
            excluded := if(
              _drop_targets_escaped_result(de, escaped_result, context),
              true,
              match(
                exclude,
                .Some(ex) => match(
                  get_deferred_drop_target_atom_name(de),
                  .Some(vn) => ex.contains(vn),
                  .None => false
                ),
                .None => false
              )
            );
            keep := if(
              excluded,
              false,
              if(
                !(use_env),
                true,
                match(
                  get_deferred_drop_target_atom_name(de),
                  .Some(var_name) => match(
                    context.base.get_expr_info(expr),
                    .Some(ei) => {
                      variables := get_variables_from_env(ei.env, var_name);
                      if(variables.len() == usize(0), false, match(_resolve_drop_target_in_scope(de, variables, ast_expr_token(expr), context),.Some(lv) => match(lv.initialized_at_token,.Some(_) => true,.None => false),.None => false))
                    },
                    .None => false
                  ),
                  .None => false
                )
              )
            );
            if(keep, {
              _p := drops_to_emit.push(de);
            });
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      if(drops_to_emit.len() > usize(0), {
        em := context.base.emitter;
        hdr := indent.clone();
        hdr.push_str("// Drop consumed variables (unwind propagation)");
        em.emit_string_line(hdr);
        m := drops_to_emit.len();
        (j : usize) = usize(0);
        while(j < m, {
          match(
            drops_to_emit.get(j),
            .Some(de) => {
              code := _call_generate_expr(de, indent.clone(), context);
              if(code.len() > usize(0), {
                line := indent.clone();
                line.push_string(code);
                line.push_str(";");
                em.emit_string_line(line);
              });
            },
            .None => ()
          );
          j = (j + usize(1));
        });
      });
    }),
    .None => ()
  )
);
/// Emit the early-return-only deferred drops attached to `expr` (a return/unwind
/// node) — M3. Mirrors `generateEarlyReturnOnlyDeferredDropExpressions`
/// (src/codegen/exprs/return.ts): skip closure-capture drops, emit the rest.
generate_early_return_only_deferred_drop_expressions :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> unit)(
  match(
    context.base.get_expr_info(expr),
    .Some(ei) => match(
      ei.early_return_only_deferred_drop_expressions,
      .Some(early_drops) => {
        em := context.base.emitter;
        (i : usize) = usize(0);
        while(i < early_drops.len(), {
          match(
            early_drops.get(i),
            .Some(drop_expr) => if(!(is_deferred_drop_for_closure_capture(drop_expr, context.current_closure_captures)), {
              // Gate: the drop target's C declaration must have been emitted AND
              // its enclosing C block must still be open at this exact point
              // (block-scope stack — same authoritative C-emission-order signal
              // as _keep_pending_drop; params are seeded at function entry).
              // Source-token gates at attach time cannot see C decl-emission
              // order: a `x := match(...)` binding emits its C declaration
              // AFTER the switch, so a `return` inside an arm precedes it in C
              // while FOLLOWING x's init token in source — with the dup/drop
              // pair optimizer consuming such bindings, the M3-attached drop
              // referenced an undeclared identifier (stage-2 `result` /
              // `temp_var_name`). A target absent from the stack holds no C
              // value here, so skipping cannot double-free or leak. Subsumes
              // the former minted-TEMP declared_c_var_names check.
              skip_undeclared := match(
                get_deferred_drop_target_atom_name(drop_expr),
                .Some(vn) => {
                  cn := sanitize_for_c_identifier(vn, false);
                  !(scope_stack_contains(context.base.declared_scopes, cn))
                },
                .None => false
              );
              if(!(skip_undeclared), {
                code := _call_generate_expr(drop_expr, indent.clone(), context);
                if(code.len() > usize(0), {
                  line := indent.clone();
                  line.push_string(code);
                  line.push_str(";");
                  em.emit_string_line(line);
                });
              });
            }),
            .None => ()
          );
          i = (i + usize(1));
        });
      },
      .None => ()
    ),
    .None => ()
  )
);
/// Deferred-dup handling for an atom return value. Mirrors `handleAtomDeferredDup`.
handle_atom_deferred_dup :: (fn(expr : AstExpr, atom_code : String, indent : String, context : FunctionGenerationContext) -> String)(
  match(
    context.base.get_expr_info(expr),
    .Some(ei) => match(
      ei.deferred_dup_expressions,
      .Some(dups) => if(dups.len() > usize(0), {
        generate_deferred_dup_expressions(expr, indent.clone(), context);
        match(dups.get(usize(0)),.Some(dup_expr) => if(ast_expr_is_fn_call(dup_expr), match(context.base.get_expr_info(dup_expr),.Some(dei) => match(dei.variable_name,.Some(dvn) => get_variable_name_for_codegen(dvn, Option(Environment).Some(dei.env)),.None => atom_code),.None => atom_code), atom_code),.None => atom_code)
      }, atom_code),
      .None => atom_code
    ),
    .None => atom_code
  )
);
/// Deferred-dup handling for a function-call return value. Mirrors `handleFuncCallDeferredDup`.
handle_func_call_deferred_dup :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)({
  ei := match(context.base.get_expr_info(expr),.Some(e) => e,.None => return(_call_generate_expr(expr, indent.clone(), context)));
  match(
    ei.deferred_dup_expressions,
    .Some(dups) => if(dups.len() > usize(0), {
      em := context.base.emitter;
      match(
        ei.variable_name,
        .Some(saved) => {
          ei.variable_name = Option(String).None;
          raw_code := _call_generate_expr(expr, indent.clone(), context);
          ei.variable_name = Option(String).Some(saved.clone());
          expr_temp_var := get_variable_name_for_codegen(saved.clone(), Option(Environment).Some(ei.env));
          if(!(expr_temp_var == raw_code), {
            line := indent.clone();
            line.push_string(get_type_string(ei.ty, context.base));
            line.push_str(" ");
            line.push_string(expr_temp_var.clone());
            line.push_str(" = ");
            line.push_string(raw_code);
            line.push_str(";");
            em.emit_string_line(line);
            // Register the declared temp BEFORE the dup pass below — the dup
            // emitter's undeclared-temp gate silently suppresses the +1 for
            // names not yet in declared_c_var_names (round-3 field-tail UAF).
            _hd := context.base.declared_c_var_names.add(expr_temp_var.clone());
          });
        },
        .None => {
          raw_code := _call_generate_expr(expr, indent.clone(), context);
          line := indent.clone();
          line.push_string(raw_code);
          line.push_str(";");
          em.emit_string_line(line);
        }
      );
      generate_deferred_dup_expressions(expr, indent.clone(), context);
      match(dups.get(usize(0)),.Some(dup_expr) => if(ast_expr_is_fn_call(dup_expr), match(context.base.get_expr_info(dup_expr),.Some(dei) => match(dei.variable_name,.Some(dvn) => return(get_variable_name_for_codegen(dvn, Option(Environment).Some(dei.env))),.None => ()),.None => ()), ()),.None => ());
      _call_generate_expr(expr, indent.clone(), context)
    }, _call_generate_expr(expr, indent.clone(), context)),
    .None => _call_generate_expr(expr, indent.clone(), context)
  )
});
/// Generate a `return` statement. Mirrors `generateReturn`.
generate_return :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)({
  ei := match(context.base.get_expr_info(expr),.Some(e) => e,.None => return(String.from("// Error: return expression missing metadata")));
  args := match(expr,.FnCall(_, _, a, _, _) => a,.Atom(_, _) => ArrayList(AstExpr).new());
  // (ctl-handler resume is Phase 5: FGC has no continuation_variables — omitted.)
  match(
    args.get(usize(0)),
    .Some(arg) => {
      is_unit := is_unit_type(ei.ty);
      no_temp := match(ei.variable_name,.Some(_) => false,.None => true);
      if(no_temp && !(is_unit), {
        return(String.from("// Error: return expression missing temporary variable name"));
      });
      arg_ei_opt := context.base.get_expr_info(arg);
      arg_has_dup := match(arg_ei_opt,.Some(aei) => match(aei.deferred_dup_expressions,.Some(d) => (d.len() > usize(0)),.None => false),.None => false);
      // Deferred-dup-with-temp materialization (port of return.ts:556-598):
      // when the arg has BOTH a variableName and deferred `___dup`s (returning
      // a borrowed FIELD, e.g. `return(p.inner)`), declare the arg's eval temp
      // BEFORE emitting the dup — the dup names that temp, and the dup
      // emitter's undeclared-temp gate silently suppressed the +1 when the
      // declaration had not been emitted yet (`T temp = p->inner;` was emitted
      // AFTER the dup pass by the return-temp block below). The caller's scope
      // drop then over-dropped the field (the round-3 borrowed-field UAF).
      (arg_code : String) = String.from("");
      arg_vn_with_dup := if(
        arg_has_dup,
        match(arg_ei_opt,.Some(aei) => aei.variable_name,.None => Option(String).None),
        Option(String).None
      );
      match(
        arg_vn_with_dup,
        .Some(avn) => {
          aei2 := match(arg_ei_opt,.Some(a) => a,.None => return(String.from("// unreachable: arg_vn_with_dup implies Some")));
          aei2.variable_name = Option(String).None;
          raw_arg_code := _call_generate_expr(arg, indent.clone(), context);
          aei2.variable_name = Option(String).Some(avn.clone());
          arg_temp_var := get_variable_name_for_codegen(avn.clone(), Option(Environment).Some(aei2.env));
          // Skip the temp declaration when the arg is a ref-param atom —
          // `T name = (*name);` would shadow the pointer parameter
          // (return.ts:576-586, issues/inout-multi-stmt-body-shadow.md).
          (is_inout_arg_atom : bool) = false;
          if(ast_expr_is_atom(arg), {
            ia_vars := get_variables_from_env(aei2.env, avn.clone());
            if(ia_vars.len() > usize(0), {
              match(
                ia_vars.get(ia_vars.len() - usize(1)),
                .Some(iav) => if(iav.is_ref, {
                  is_inout_arg_atom = true;
                }),
                .None => ()
              );
            });
          });
          if((!(is_inout_arg_atom)) && (!(arg_temp_var == raw_arg_code)), {
            dline := indent.clone();
            dline.push_string(get_type_string(aei2.ty, context.base));
            dline.push_str(" ");
            dline.push_string(arg_temp_var.clone());
            dline.push_str(" = ");
            dline.push_string(raw_arg_code.clone());
            dline.push_str(";");
            em2 := context.base.emitter;
            em2.emit_string_line(dline);
            _ad := context.base.declared_c_var_names.add(arg_temp_var.clone());
          });
          arg_code = if(is_inout_arg_atom, raw_arg_code, arg_temp_var);
        },
        .None => {
          arg_code = _call_generate_expr(arg, indent.clone(), context);
        }
      );
      (handled_deferred_dup : bool) = false;
      if(arg_has_dup, {
        generate_deferred_dup_expressions(arg, indent.clone(), context);
        match(
          arg_ei_opt,
          .Some(aei) => match(
            aei.deferred_dup_expressions,
            .Some(dups) => match(
              dups.get(usize(0)),
              .Some(dup_expr) => if(
                ast_expr_is_fn_call(dup_expr),
                match(
                  context.base.get_expr_info(dup_expr),
                  .Some(dei) => match(
                    dei.variable_name,
                    .Some(dvn) => {
                      arg_code = get_variable_name_for_codegen(dvn, Option(Environment).Some(dei.env));
                      handled_deferred_dup = true;
                    },
                    .None => ()
                  ),
                  .None => ()
                ),
                ()
              ),
              .None => ()
            ),
            .None => ()
          ),
          .None => ()
        );
      });
      // The return statement yields the FUNCTION's value, so the return temp's
      // C type is the function's (specialized) return type. When the return
      // expression's OWN recorded type is an unresolved SomeT that lowers to
      // `void*` — e.g. a generic operator's declared `_Self` return, which
      // specialization concretizes only in the FUNCTION TYPE (used by the
      // prototype), leaving the body's return-expr node at the abstract SomeT
