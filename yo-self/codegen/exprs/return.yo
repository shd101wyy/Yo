    .None => {
      // Unit return (no argument).
      generate_deferred_drop_expressions(expr, indent.clone(), context);
      generate_early_return_only_deferred_drop_expressions(expr, indent.clone(), context);
      // Async state-machine early unit return: complete the Future
      // (return.ts:740-756). A non-unit future output completes with a
      // zeroed result.
      match(
        context.in_async_state_machine,
        .Some(iasm_u) => {
          child_ty_u := match(
            extract_future_trait_from_type(iasm_u.future_type),
            .Some(ftt_u) => match(ftt_u,.FutureTraitT({ output : ou }) => ou.clone(), _ => t_unit()),
            .None => t_unit()
          );
          is_unit_result_u := is_unit_type(child_ty_u);
          generate_pending_deferred_drops(indent.clone(), context, expr, true, false, false, Option(HashSet(String)).None, Option(String).None);
          em_smu := context.base.emitter;
          em_smu.emit_string_line(`${indent.clone()}// Final state - complete the result Future (early unit return)`);
          result_code_u := if(
            is_unit_result_u,
            Option(String).None,
            Option(String).Some(`(${get_type_string(child_ty_u, context.base)}){0}`)
          );
          emit_async_future_completion(em_smu, indent.clone(), result_code_u, Option(String).Some(context.base.current_function_name.clone()));
          return(String.from(""));
        },
        .None => ()
      );
      generate_pending_deferred_drops(indent.clone(), context, expr, false, false, false, Option(HashSet(String)).None, Option(String).None);
      String.from("return")
    }
  )
});
/// Generate an implicit function-body return. Mirrors `generateImplicitReturnStatement`.
generate_implicit_return_statement :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> unit)({
  em := context.base.emitter;
  match(
    expr,
    .Atom(_, _) => {
      atom_code := generate_atom(expr, context, indent.clone());
      final_code := handle_atom_deferred_dup(expr, atom_code, indent.clone(), context);
      // Own-param scope-end drops (function-scope, excluded from the caller's
      // flush-first — generation.yo non-begin path): AFTER the tail's dup so a
      // borrowed value leaving the fn keeps its +1, BEFORE the return.
      generate_deferred_drop_expressions(expr, indent.clone(), context, false, true);
      line := indent.clone();
      line.push_str("return ");
      line.push_string(final_code);
      line.push_str(";");
      em.emit_string_line(line);
    },
    .FnCall(_, _, _, _, _) => if(ast_expr_is_fn_call_of(expr, BK_RETURN, Option(usize).None) || ast_expr_is_fn_call_of(expr, BF_UNWIND, Option(usize).None), {
      // Control-flow tail (`return(...)` / `unwind(...)`): its generator already emits
      // the full control-flow statement (the escape flag + a `return` for unwind, or the
      // return itself), so emit as-is — do NOT wrap in another `return` (that produced
      // `return return (void*){0};`). Mirrors the `return` special-case; unwind is the
      // same control-flow shape.
      // Own-param drops: a RETURN tail flushes its own node drops inside
      // generate_return (mode-unfiltered), which covers the shared-id body's
      // param drops; an UNWIND tail does not — flush them here first.
      if(ast_expr_is_fn_call_of(expr, BF_UNWIND, Option(usize).None), {
        generate_deferred_drop_expressions(expr, indent.clone(), context, false, true);
      });
      code := _call_generate_expr(expr, indent.clone(), context);
      line := indent.clone();
      line.push_string(code);
      line.push_str(";");
      em.emit_string_line(line);
    }, {
      final_code := handle_func_call_deferred_dup(expr, indent.clone(), context);
      // An EMPTY tail render means the expression emitted as STATEMENTS whose
      // every path already returned (e.g. a tail `match` with returning arms)
      // — a bare `return ;` here is a C constraint violation in a non-void fn
      // ("non-void function should return a value", the install_command
      // batch). Emit nothing: control cannot reach past the statement form.
      if(final_code.trim().len() > usize(0), {
        // Own-param scope-end drops: after the tail's statements/dups (the
        // expression-level flushes skip param targets), before the return.
        generate_deferred_drop_expressions(expr, indent.clone(), context, false, true);
        line := indent.clone();
        line.push_str("return ");
        line.push_string(final_code);
        line.push_str(";");
        em.emit_string_line(line);
      });
    })
  )
});
/// Emit the effect-handler parameter drops (if any) before an escape return.
_emit_effect_handler_param_drops :: (fn(context : FunctionGenerationContext, indent : String) -> unit)(
  match(
    context.effect_handler_param_drops,
    .Some(drops) => {
      em := context.base.emitter;
      (di : usize) = usize(0);
      while(di < drops.len(), {
        d := match(drops.get(di),.Some(s) => s,.None => String.from(""));
        em.emit_string_line(`${indent.clone()}${d};`);
        di = (di + usize(1));
      });
    },
    .None => ()
  )
);
/// Emit the dummy `return` statement for an escaping control function: `return;` for a
/// unit/void result, else `return (RetT){0};` (the caller ignores it once it
/// observes `__yo_effect_escaped`). Mirrors generation.ts:325-342/431-446.
/// Returns "" (emits directly to avoid `return return` double-return from callers
/// that also insert a `return` prefix).
_unwind_dummy_return :: (fn(indent : String, context : FunctionGenerationContext) -> String)({
  rt := match(
    context.current_function_type,
    .Some(ft) => match(ft,.Func({ result : r }) => r, _ => t_unit()),
    .None => t_unit()
  );
  em := context.base.emitter;
  if(is_unit_type(rt), em.emit_string_line(`${indent.clone()}return;`), {
    rts := match(context.override_return_type_str,.Some(s) => s,.None => get_type_string(rt, context.base));
    if(rts == "void", em.emit_string_line(`${indent.clone()}return;`), {
      em.emit_string_line(`${indent.clone()}return (${rts}){0};`);
    })
  });
  String.from("")
});
/// Emit an unwind check after calling a function that may set
/// `__yo_effect_escaped`. Faithful port of `emitEffectUnwindCheck`
/// (other-fn-call.ts:2778). At a handler-installation point
/// (`is_handler_installation = true`) it clears the flag and extracts the
/// unwound value from `__yo_unwind_value` as the call result; at a transitive
/// point it returns a dummy to propagate the escape up the stack.
///
/// NOTE: the async-state-machine branch's segment-local RC arg-temp drop loop
/// (TS 2808-2841) is DEFERRED — it needs `resolve_var_name_in_context` from
/// `other_fn_call.yo`, which would close a `return -> other_fn_call` import
/// cycle. The escape CONTROL FLOW is faithful (flag-clear at install + Future
/// abort via `emit_async_future_escape`); only the leak-prevention drop of
/// segment-local arg temps is omitted (not exercised by the corpus — no
/// async+effect-unwind fixture).
emit_effect_unwind_check :: (fn(indent : String, context : FunctionGenerationContext, is_handler_installation : bool, expr : AstExpr) -> unit)({
  em := context.base.emitter;
  em.emit_string_line(`${indent.clone()}if (__yo_effect_escaped) {`);
  inner := indent.clone();
  inner.push_str("  ");
  // This call's own result temp must never be dropped on the escape path: the
  // handler unwound instead of returning, so the temp was never assigned and
  // still holds whatever the ABI left in the return registers. On x86_64 that is
  // routinely a stack address, so the drop dereferences it and jumps into the
  // stack. See issues/fixed/escape-path-drops-unwound-call-result-temp.md.
  escaped_result := match(
    context.base.get_expr_info(expr),
    .Some(ei) => ei.variable_name,
    .None => Option(String).None
  );
  is_async := match(context.in_async_state_machine,.Some(_) => true,.None => false);
  if(is_async, {
    if(is_handler_installation, {
      em.emit_string_line(`${inner.clone()}__yo_effect_escaped = 0;`);
    });
    emit_async_future_escape(em, inner.clone(), Option(String).None, Option(String).None);
  }, {
    // skip_env_check=true: use the block-scope-stack liveness signal in
    // _keep_pending_drop's !use_env branch (context.declared_scopes), NOT the
    // END-of-scope env which leaks live locals here. Closes the per-call
    // callee_env leak on the __yo_effect_escaped path (stage-2 fixpoint).
    generate_pending_deferred_drops(inner.clone(), context, expr, false, true, true, Option(HashSet(String)).None, escaped_result.clone());
    generate_consumed_var_drops_for_escape(inner.clone(), context, expr, false, Option(HashSet(String)).None, escaped_result.clone());
    ret_ty := match(context.current_function_type,.Some(ft) => match(ft,.Func({ result : r }) => r, _ => t_unit()),.None => t_unit());
    if(is_handler_installation, {
      em.emit_string_line(`${inner.clone()}__yo_effect_escaped = 0;`);
      if(is_unit_type(ret_ty), em.emit_string_line(`${inner.clone()}return;`), {
        cty := match(context.override_return_type_str,.Some(s) => s,.None => get_type_string(ret_ty, context.base));
        if(cty == "void", em.emit_string_line(`${inner.clone()}return;`), {
          em.emit_string_line(`${inner.clone()}${cty.clone()} _unw_result;`);
          em.emit_string_line(`${inner.clone()}memcpy(&_unw_result, __yo_unwind_value, sizeof(${cty}));`);
          em.emit_string_line(`${inner.clone()}return _unw_result;`);
        });
      });
    }, {
      if(is_unit_type(ret_ty), em.emit_string_line(`${inner.clone()}return;`), {
        cty := match(context.override_return_type_str,.Some(s) => s,.None => get_type_string(ret_ty, context.base));
        if(
          cty == "void",
          em.emit_string_line(`${inner.clone()}return;`),
          em.emit_string_line(`${inner.clone()}return (${cty}){0};`)
        );
      });
    });
  });
  em.emit_string_line(`${indent.clone()}}`);
});
/// `unwind(expr)` — discard the continuation and exit the enclosing control
/// function. Faithful port of `generateUnwind` (generation.ts:198-448), minus the
/// nested-resume-handler `continuationVariables` branch (yo-self has no such
/// context field). Async-state-machine context routes through
/// `emit_async_future_escape` (Future aborted). Synchronous effect handlers set
/// the thread-local `__yo_effect_escaped` flag, drop locals, and — for an
/// effect-record-member / evidence-passing handler — stash the unwound value into
/// `__yo_unwind_value` (memcpy) before returning a dummy; otherwise `return <v>`.
generate_unwind :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)({
  arg_opt := match(expr,.FnCall(_, _, a, _, _) => a.get(usize(0)), _ => Option(AstExpr).None);
  em := context.base.emitter;
  is_async := match(context.in_async_state_machine,.Some(_) => true,.None => false);
  if(is_async, {
    match(
      arg_opt,
      .Some(arg) => {
        argc := _call_generate_expr(arg, indent.clone(), context);
        if((argc.len() > usize(0)) && !(argc == "(void)0"), {
          em.emit_string_line(`${indent.clone()}(void)${argc};`);
        });
      },
      .None => ()
    );
    _emit_effect_handler_param_drops(context, indent.clone());
    generate_pending_deferred_drops(indent.clone(), context, expr, false, true, true, Option(HashSet(String)).None, Option(String).None);
    generate_consumed_var_drops_for_escape(indent.clone(), context, expr, true, Option(HashSet(String)).None, Option(String).None);
    emit_async_future_escape(em, indent.clone(), Option(String).None, Option(String).Some(context.base.current_function_name.clone()));
    return(String.from(""));
  });
  // Synchronous effect handler: set the thread-local escape flag.
  em.emit_string_line(`${indent.clone()}__yo_effect_escaped = 1;`);
  match(
    arg_opt,
    .None => {
      _emit_effect_handler_param_drops(context, indent.clone());
      generate_pending_deferred_drops(indent.clone(), context, expr, false, true, true, Option(HashSet(String)).None, Option(String).None);
      if(!(context.is_effect_record_member_function), {
        generate_consumed_var_drops_for_escape(indent.clone(), context, expr, true, Option(HashSet(String)).None, Option(String).None);
      });
      _unwind_dummy_return(indent.clone(), context)
    },
    .Some(arg) => {
      argc := _call_generate_expr(arg, indent.clone(), context);
      _emit_effect_handler_param_drops(context, indent.clone());
      generate_pending_deferred_drops(indent.clone(), context, expr, false, true, true, Option(HashSet(String)).None, Option(String).None);
      if(!(context.is_effect_record_member_function), {
        generate_consumed_var_drops_for_escape(indent.clone(), context, expr, true, Option(HashSet(String)).None, Option(String).None);
      });
      has_evidence := match(context.current_evidence_params,.Some(ep) => (ep.len() > usize(0)),.None => false);
      if(context.is_effect_record_member_function || has_evidence, {
        match(
          context.current_function_type,
          .Some(_) => {
            arg_ty := match(context.base.get_expr_info(arg),.Some(ei) => ei.ty,.None => t_unit());
            if(!(is_unit_type(arg_ty)), {
              ats := get_type_string(arg_ty, context.base);
              em.emit_string_line(`${indent.clone()}{ ${ats.clone()} _unw_val = ${argc.clone()}; memcpy(__yo_unwind_value, &_unw_val, sizeof(${ats})); }`);
            });
          },
          .None => ()
        );
        _unwind_dummy_return(indent.clone(), context)
      }, {
        em.emit_string_line(`${indent.clone()}return ${argc.clone()};`);
        String.from("")
      })
    }
  )
});
export(generate_return, generate_implicit_return_statement, generate_pending_deferred_drops, generate_consumed_var_drops_for_escape, handle_atom_deferred_dup, handle_func_call_deferred_dup, generate_unwind, emit_effect_unwind_check);
