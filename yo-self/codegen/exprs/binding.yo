//! Binding (`x := v` / `(x : T) = v`) declaration emitter — mirrors
//! `src/codegen/exprs/binding.ts` (`generateBinding`).
open(import("std/string"));
{ AstExpr, ast_expr_token, ast_expr_is_fn_call_of, BK_COMPTIME } :: import("../../expr.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ get_variable_type_string } :: import("../utils/index.yo");
/// Emit the C declaration `<type> <name>;` for a binding's left-hand side
/// (the value is assigned separately). Compile-time bindings emit nothing.
/// Returns "" (statement). Mirrors `generateBinding`.
generate_binding :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)({
  lhs := match(expr,.FnCall(_, _, args, _, _) => match(args.get(usize(0)),.Some(a) => a,.None => return(String.from(""))),.Atom(_, _) => return(String.from("")));
  // Compile-time variable (`comptime(x)`) → no C declaration.
  if(ast_expr_is_fn_call_of(lhs, BK_COMPTIME,.Some(usize(1))), {
    return(String.from(""));
  });
  match(
    context.base.get_expr_info(lhs),
    .Some(ei) => {
      var_name := ast_expr_token(lhs).value;
      // NOTE: we cannot apply `const` here (the value is assigned afterwards).
      decl := indent.clone();
      decl.push_string(get_variable_type_string(ei.ty, var_name, context.base));
      decl.push_str(";");
      em := context.base.emitter;
      em.emit_string_line(decl);
    },
    .None => ()
  );
  String.from("")
});
export(generate_binding);
