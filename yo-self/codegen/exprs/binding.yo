//! Generate code for the `name : Type` binding form.
//!
//! 1-to-1 port of `src/codegen/exprs/binding.ts`.
//!
//! For `lhs : Type` (with `:` infix call having 2 args), emits a bare
//! C variable declaration `<type> <name>;` so that a following
//! assignment can write into it. Returns the empty unit sentinel `""`.
//!
//! Special-cased shapes (no C output):
//!   - `comptime(x) : T` — compile-time-only binding, emits nothing.
//!   - `given(x) : T` where `T` is *not* a struct — compile-time
//!     implicit-param binding, emits nothing.
//!
//! Special-cased shapes (with C output):
//!   - `given(x) : Struct` — Phase 4b runtime evidence value; emits the
//!     declaration `<struct_type> x;`.
//!
//! Metadata requirement:
//!   The LHS's `info.ty` from the typed-AST pipeline. With no metadata,
//!   the TS implementation returns an error comment; yo-self returns
//!   `.None` so callers can degrade gracefully.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_id,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  BK_COMPTIME,
  BK_GIVEN
} :: import("../../expr/expr.yo");
{ ExprInfo } :: import("../../expr/expr_info.yo");
{ TypeValue, is_struct_type } :: import("../../types/type.yo");
{ CodegenContext } :: import("../context.yo");
{ type_value_to_c_field } :: import("../types.yo");
{ sanitize_for_c_identifier } :: import("./typeid.yo");
/// Build `"<c_type> <sanitized_var_name>"`. Mirrors TS
/// `getVariableTypeString` (which after a recent refactor is also just
/// `${getTypeString(type)} ${sanitizeForCIdentifier(varName)}`).
get_variable_type_string :: (fn(t : TypeValue, var_name : str) -> String)({
  c_ty := match(
    type_value_to_c_field(t),
    .Some(s) => s,
    .None => String.from("int32_t")
  );
  san := sanitize_for_c_identifier(var_name);
  result := String.new();
  result.push_string(c_ty);
  result.push_str(" ");
  result.push_string(san);
  result
});
/// Extract the inner expression token value from a `comptime(x)` or
/// `given(x)` 1-arg call.
inner_atom_token_value :: (fn(call_expr : AstExpr) -> Option(String))(
  match(
    call_expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, _, inner_args, _, _) => match(
      inner_args.get(usize(0)),
      .None => Option(String).None,
      .Some(inner) => match(
        inner,
        .Atom(_, tok) => Option(String).Some(tok.value),
        .FnCall(_, _, _, _, _) => Option(String).None
      )
    )
  )
);
/// Generate code for `lhs : Type`. `args` is the `:` call's two-argument
/// list: `[lhs, type_expr]`. Returns the empty sentinel on success or
/// `.None` when required metadata is missing.
generate_binding :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)(
  cond(
    (args.len() < usize(1)) => Option(String).None,
    true => match(
      args.get(usize(0)),
      .None => Option(String).None,
      .Some(lhs) => cond(
        // `comptime(x) : T` — compile-time-only, emit nothing.
        (ast_expr_is_fn_call(lhs) && ast_expr_is_fn_call_of(lhs, BK_COMPTIME, Option(usize).Some(usize(1)))) =>
          Option(String).Some(String.from("")),
        // `given(x) : T` — emit only when T is a struct.
        (ast_expr_is_fn_call(lhs) && ast_expr_is_fn_call_of(lhs, BK_GIVEN, Option(usize).Some(usize(1)))) => match(
          inner_atom_token_value(lhs),
          .None => Option(String).Some(String.from("")),
          .Some(inner_name) => match(
            // The TS code reads `innerLhs.$.type`. yo-self can do the
            // same via ExprInfoTable on the inner expression's ExprId.
            // Walk lhs to get the inner atom expr.
            lhs,
            .Atom(_, _) => Option(String).Some(String.from("")),
            .FnCall(_, _, inner_args, _, _) => match(
              inner_args.get(usize(0)),
              .None => Option(String).Some(String.from("")),
              .Some(inner_expr) => match(
                ctx.*.get_expr_info(ast_expr_id(inner_expr)),
                .None => Option(String).Some(String.from("")),
                .Some(inner_info) => cond(
                  (!(is_struct_type(inner_info.ty))) =>
                    Option(String).Some(String.from("")),
                  true => {
                    decl := get_variable_type_string(inner_info.ty, inner_name.as_str());
                    line := String.from(indent.as_str());
                    line.push_string(decl);
                    line.push_str(";");
                    ctx.*.emitter.emit_string_line(line);
                    Option(String).Some(String.from(""))
                  }
                )
              )
            )
          )
        ),
        // Plain `name : T` — emit `<c_type> <name>;`.
        true => match(
          lhs,
          .FnCall(_, _, _, _, _) => Option(String).None,
          .Atom(_, lhs_tok) => match(
            ctx.*.get_expr_info(ast_expr_id(lhs)),
            .None => Option(String).None,
            .Some(lhs_info) => {
              decl := get_variable_type_string(lhs_info.ty, lhs_tok.value.as_str());
              line := String.from(indent.as_str());
              line.push_string(decl);
              line.push_str(";");
              ctx.*.emitter.emit_string_line(line);
              Option(String).Some(String.from(""))
            }
          )
        )
      )
    )
  )
);
export(generate_binding, get_variable_type_string, inner_atom_token_value);
