//! Codegen for the `__yo_gc_collect()` builtin.
//!
//! 1-to-1 port of `src/codegen/exprs/gc.ts` (`generateYoGcCollect`).
//!
//! `__yo_gc_collect()` triggers a manual cycle-collector GC pass.  It takes
//! zero arguments and emits the literal C call `__yo_gc_collect()`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr } :: import("../../expr.yo");
{ CodegenContext } :: import("../context.yo");
/// Generate C code for a `__yo_gc_collect()` call.
///
/// Mirrors `generateYoGcCollect` in `src/codegen/exprs/gc.ts`.
generate_yo_gc_collect :: (
  fn(args : ArrayList(AstExpr), _ctx : *(CodegenContext), _indent : String) -> String
)(
  cond(
    (args.len() != usize(0)) => String.from("// Error: __yo_gc_collect requires exactly 0 arguments"),
    true => String.from("__yo_gc_collect()")
  )
);
export(generate_yo_gc_collect);
