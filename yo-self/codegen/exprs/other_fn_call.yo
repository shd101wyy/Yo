//! Partial 1-to-1 port of `src/codegen/exprs/other-fn-call.ts`.
//!
//! Currently exposes one pure string-parsing helper extracted from
//! the larger TS file:
//!
//!   - `split_top_level_args_list(s)` — splits a comma-separated C
//!     argument list at top level, ignoring commas nested inside
//!     parentheses, square brackets, or braces. Each result has
//!     leading/trailing whitespace trimmed (matching TS's `.trim()`).
//!
//! The full `generateOtherFunctionCall` (and the evidence-call /
//! unwind helpers) wait on a lot of infrastructure that
//! yo-self's codegen does not yet expose (function-cname registry,
//! state-machine variables, evidence-parameter resolution, …).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
/// True iff `b` is an ASCII whitespace byte (` `, `\t`, `\n`, `\r`).
is_ascii_whitespace_byte_ :: (fn(b : u8) -> bool)(
  (b == u8(32)) || ((b == u8(9)) || ((b == u8(10)) || (b == u8(13))))
);
/// Strip leading and trailing ASCII whitespace from `s`. Mirrors TS
/// `String.prototype.trim` for the subset of inputs the C-arg
/// splitter produces.
trim_ascii_whitespace_ :: (fn(s : String) -> String)({
  bytes := s.as_bytes();
  n := bytes.len();
  start := usize(0);
  cont := true;
  while(cont && (start < n), {
    b := match(bytes.get(start),.Some(x) => x,.None => u8(0));
    cond(
      is_ascii_whitespace_byte_(b) => {
        start = (start + usize(1));
      },
      true => {
        cont = false;
      }
    );
  });
  end := n;
  cont2 := true;
  while(cont2 && (end > start), {
    b := match(bytes.get(end - usize(1)),.Some(x) => x,.None => u8(0));
    cond(
      is_ascii_whitespace_byte_(b) => {
        end = (end - usize(1));
      },
      true => {
        cont2 = false;
      }
    );
  });
  out := String.new();
  i := start;
  while(i < end, {
    match(
      bytes.get(i),
      .None => (),
      .Some(b) => {
        out.push_byte(b);
      }
    );
    i = (i + usize(1));
  });
  out
});
/// Split a comma-separated C-argument string at top level (commas
/// inside `()`/`[]`/`{}` do not split). Each piece is trimmed.
/// Mirrors TS `splitTopLevelArgsList`.
///
/// Empty input (or input that only contains whitespace) yields the
/// empty list, matching TS's `cur.trim().length > 0` final guard.
split_top_level_args_list :: (fn(s : String) -> ArrayList(String))({
  out := ArrayList(String).new();
  bytes := s.as_bytes();
  n := bytes.len();
  depth := i32(0);
  cur := String.new();
  i := usize(0);
  while(i < n, {
    b := match(bytes.get(i),.Some(x) => x,.None => u8(0));
    cond(
      ((b == u8(40)) || ((b == u8(91)) || (b == u8(123)))) => {
        // ( or [ or {
        depth = (depth + i32(1));
        cur.push_byte(b);
      },
      ((b == u8(41)) || ((b == u8(93)) || (b == u8(125)))) => {
        // ) or ] or }
        depth = (depth - i32(1));
        cur.push_byte(b);
      },
      ((b == u8(44)) && (depth == i32(0))) => {
        // Top-level comma — split.
        out.push(trim_ascii_whitespace_(cur));
        cur = String.new();
      },
      true => {
        cur.push_byte(b);
      }
    );
    i = (i + usize(1));
  });
  trimmed := trim_ascii_whitespace_(cur);
  if(trimmed.len() > usize(0), {
    out.push(trimmed);
  });
  out
});
export(split_top_level_args_list);
