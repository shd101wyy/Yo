//! Generate code for the `panic` / `panic(msg)` builtin.
//!
//! 1-to-1 port of `src/codegen/exprs/panic.ts`.
//!
//! Semantics:
//!   - `panic()`         — emits `abort();`.
//!   - `panic("lit")`    — when the argument is a compile-time string, emits
//!                         `fprintf(stderr, "%s\n", "lit"); abort();`.
//!   - `panic(rt_expr)`  — when the argument is a runtime value, emits
//!                         `fprintf(stderr, "%s\n", <rt_expr>); abort();`,
//!                         or `fprintf(stderr, "%.*s\n", (int)x.length, x.data); abort();`
//!                         when the argument has the `str` newtype.
//!
//! Because `panic` never returns, the caller still needs an expression with
//! the right type. We emit the unreachable dummy `(*((<retT>*)NULL))`.
//!
//! Metadata requirement:
//!   The call expression's `ExprInfo.ty` (the return type) must be present
//!   so the dummy expression can be typed. The argument expression's value
//!   (for compile-time-string detection) and type (for str-newtype
//!   detection) are also read from `ExprInfoTable` when available. With no
//!   metadata at all the handler returns `.None` and the caller can fall
//!   back to a bootstrap heuristic — though the production TS code paths
//!   require the metadata.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_id } :: import("../../expr.yo");
{ ExprInfo } :: import("../../expr_info.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_str_type } :: import("../../types/guards.yo");
{ EvalValue } :: import("../../value.yo");
{ CodegenContext } :: import("../context.yo");
{ get_type_string, format_indented_line } :: import("../utils/index.yo");
{ call_gen_expr } :: import("./expr.yo");
/// Best-effort recovery of a compile-time string value from an `EvalValue`.
/// In yo-self the analog of TS `ComptimeStringValue` is the `StrLit(raw)`
/// variant — `raw` carries the literal text *with* surrounding `"` for
/// `StringLit` tokens and *without* for template-string segments.
extract_comptime_string_value :: (fn(v : EvalValue) -> Option(String))(
  match(
    v,
    .StrLit(raw) => Option(String).Some(raw),
    _ => Option(String).None
  )
);
// `is_str_type(t)` lives in `types/guards.yo` — same semantics as
// the old local `is_str_newtype` helper; imported below.
// `get_type_string(t, ctx)` lives in `codegen/utils/index.yo` — the
// canonical 1-to-1 home for `getTypeString` in
// `src/codegen/utils/index.ts`. The old `get_c_type_string`
// helper here did not consult the type registry; the canonical
// version does. Imported at the top of this file.
/// Quote `raw` as a C string literal.
///
/// The Yo lexer stores `StringLit` tokens with their surrounding `"` and
/// keeps escape sequences (`\n`, `\t`, `\\`, `\"`, …) byte-for-byte. That
/// representation is *already* a valid C string literal, so the most
/// faithful port simply passes the raw text through.
///
/// For template-string segments (which the lexer stores *without* outer
/// quotes), we add the missing quotes and escape inner backslashes,
/// double quotes, and the common whitespace-control characters so that
/// the resulting C literal is well-formed.
quote_as_c_string :: (fn(raw : String) -> String)({
  bytes := raw.as_bytes();
  n := bytes.len();
  already_quoted := cond(
    (n < usize(2)) => false,
    true => {
      first := match(bytes.get(usize(0)),.Some(x) => x,.None => u8(0));
      last := match(bytes.get(n - usize(1)),.Some(x) => x,.None => u8(0));
      (first == u8(34)) && (last == u8(34))
    }
  );
  cond(
    already_quoted => raw,
    true => {
      buf := String.new();
      buf.push_str("\"");
      (i : usize) = usize(0);
      while(i < n, {
        b := match(bytes.get(i),.Some(x) => x,.None => u8(0));
        cond(
          (b == u8(92)) => buf.push_str("\\\\"),
          // backslash
          (b == u8(34)) => buf.push_str("\\\""),
          // double quote
          (b == u8(10)) => buf.push_str("\\n"),
          // newline
          (b == u8(13)) => buf.push_str("\\r"),
          // carriage return
          (b == u8(9)) => buf.push_str("\\t"),
          // tab
          (b == u8(0)) => buf.push_str("\\0"),
          // NUL
          true => buf.push_byte(b)
        );
        i = (i + usize(1));
      });
      buf.push_str("\"");
      buf
    }
  )
});
/// Format the `<indent>abort();` line emitted at the tail of every
/// `panic(...)` lowering. Pure string composition.
format_panic_abort_line :: (fn(indent : String) -> String)(
  format_indented_line(indent, "abort();")
);
/// Format the C `fprintf(stderr, "%s\n", <msg>);` line for the plain
/// C-string panic message path (compile-time literal or non-`str`
/// runtime expression). Pure string composition.
format_panic_fprintf_cstr :: (fn(indent : String, msg_code : String) -> String)({
  s := String.from(indent.as_str());
  s.push_str("fprintf(stderr, \"%s\\n\", ");
  s.push_string(msg_code);
  s.push_str(");");
  s
});
/// Format the C `fprintf(stderr, "%.*s\n", (int)x.length, x.data);`
/// line used when the panic message argument is a `str` newtype
/// (`Slice(u8)` under the hood). `msg_code` is emitted twice — once
/// for `.length` and once for `.data` — so the caller should pass a
/// side-effect-free expression.
format_panic_fprintf_str_newtype :: (
  fn(indent : String, msg_code : String) -> String
)({
  s := String.from(indent.as_str());
  s.push_str("fprintf(stderr, \"%.*s\\n\", (int)");
  s.push_string(msg_code);
  s.push_str(".length, ");
  s.push_string(msg_code);
  s.push_str(".data);");
  s
});
/// Format the unreachable dummy expression of the panic call's return
/// type: `(*((<type>*)NULL))`. `panic` never returns, but the
/// surrounding C expression still needs a typed sub-expression — this
/// is the canonical placeholder used by TS `generatePanic`.
format_panic_unreachable_dummy :: (fn(return_c_type : String) -> String)({
  s := String.from("(*((");
  s.push_string(return_c_type);
  s.push_str("*)NULL))");
  s
});
/// Generate the C expression for a `panic(...)` call.
///
/// `call_expr` is the full `panic(...)` AST node (used to look up the
/// return type metadata). `args` is the argument list (length 0 or 1).
/// `indent` is the current C indentation prefix used for emitted
/// statements. Returns `.Some(c_expr)` on success or `.None` when the
/// required metadata is unavailable.
generate_panic :: (
  fn(
    call_expr : AstExpr,
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  // The TS implementation reads `expr.$?.type` first and bails out with
  // a comment if it is missing.
  info_opt := ctx.get_expr_info(ast_expr_id(call_expr));
  match(
    info_opt,
    .None => Option(String).None,
    .Some(info) => {
      n := args.len();
      cond(
        (n == usize(0)) => {
          // panic() — just abort.
          ctx.emitter.emit_string_line(format_panic_abort_line(indent));
        },
        (n == usize(1)) => {
          match(
            args.get(usize(0)),
            .None => (),
            .Some(message_arg) => match(
              ctx.get_expr_info(ast_expr_id(message_arg)),
              .None => {
                // Message arg has no metadata — fall back to runtime path
                // with the bootstrap codegen of the message expression.
                match(
                  call_gen_expr(message_arg, ctx, indent),
                  .None => (),
                  .Some(msg_code) => {
                    ctx.emitter.emit_string_line(
                      format_panic_fprintf_cstr(indent, msg_code)
                    );
                  }
                );
                ctx.emitter.emit_string_line(format_panic_abort_line(indent));
              },
              .Some(msg_info) => {
                comptime_str_opt := match(
                  msg_info.value,
                  .None => Option(String).None,
                  .Some(v) => extract_comptime_string_value(v)
                );
                match(
                  comptime_str_opt,
                  .Some(raw) => {
                    quoted := quote_as_c_string(raw);
                    ctx.emitter.emit_string_line(
                      format_panic_fprintf_cstr(indent, quoted)
                    );
                    ctx.emitter.emit_string_line(format_panic_abort_line(indent));
                  },
                  .None => match(
                    call_gen_expr(message_arg, ctx, indent),
                    .None => (),
                    .Some(msg_code) => {
                      // Distinguish str newtype (Slice(u8) under the hood)
                      // from a plain C string.
                      line := cond(
                        is_str_type(msg_info.ty) =>
                          format_panic_fprintf_str_newtype(indent, msg_code),
                        true => format_panic_fprintf_cstr(indent, msg_code)
                      );
                      ctx.emitter.emit_string_line(line);
                      ctx.emitter.emit_string_line(format_panic_abort_line(indent));
                    }
                  )
                );
              }
            )
          );
        },
        true => ()
      );
      // Return the unreachable dummy expression of the panic's return type.
      return_c_ty := get_type_string(info.ty, ctx);
      Option(String).Some(format_panic_unreachable_dummy(return_c_ty))
    }
  )
});
export(
  generate_panic,
  extract_comptime_string_value,
  quote_as_c_string,
  format_panic_abort_line,
  format_panic_fprintf_cstr,
  format_panic_fprintf_str_newtype,
  format_panic_unreachable_dummy
);
