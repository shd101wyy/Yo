//! Codegen for the `consume(expr)` builtin.
//!
//! 1-to-1 port of `src/codegen/exprs/consume.ts` (`generateConsume`).
//!
//! `consume()` means "take ownership of this location without dropping the old
//! value".  Codegen is intentionally a no-op around the argument expression:
//! callers are responsible for ensuring the old value is safe to overwrite.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr } :: import("../../expr.yo");
{ CodegenContext } :: import("../context.yo");
{ call_gen_expr } :: import("./expr.yo");
/// Generate C code for a `consume(expr)` call.
///
/// Mirrors `generateConsume` in `src/codegen/exprs/consume.ts`.
generate_consume :: (
  fn(args : ArrayList(AstExpr), ctx : *(CodegenContext), indent : String) -> Option(String)
)(
  match(
    args.get(usize(0)),
    .None => Option(String).None,
    .Some(arg_expr) => call_gen_expr(arg_expr, ctx, indent)
  )
);
export(generate_consume);
