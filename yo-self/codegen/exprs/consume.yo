//! `consume(...)` emitter — mirrors `src/codegen/exprs/consume.ts`.
open(import("std/string"));
{ AstExpr } :: import("../../expr.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./_expr.yo");
/// `consume(x)` — emits the argument as-is. consume does NOT drop the old
/// value (that is the point: take the location without cleanup). Mirrors
/// `generateConsume`.
generate_consume :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)(
  match(
    expr,
    .FnCall(_, _, args, _, _) => match(
      args.get(usize(0)),
      .Some(arg) => _call_generate_expr(arg, indent, context),
      .None => String.from("// Error: consume requires exactly 1 argument")
    ),
    .Atom(_, _) => String.from("// Error: consume requires a call expression")
  )
);
export(generate_consume);
