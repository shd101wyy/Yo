//! Pure Token-comparison helpers extracted from
//! `src/codegen/exprs/return.ts`.
//!
//! 1-to-1 partial port. These four helpers do not touch the codegen
//! context, the deferred-drop machinery, or the C emitter — they are
//! pure functions over `Token` + `AstExpr` and therefore land ahead of
//! the rest of `return.ts`. The full `generateReturn` /
//! `generatePendingDeferredDrops` ports still depend on infrastructure
//! (drop-dup, async-completion, atom codegen) that yo-self's bootstrap
//! codegen does not yet expose.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Token } :: import("../../lexer/token.yo");
{ AstExpr, ast_expr_token } :: import("../../expr/expr.yo");
/// True iff `left` and `right` come from the same source-position
/// space — same module path *and* identical input string. Mirrors TS
/// `tokensAreComparable`.
tokens_are_comparable :: (fn(left : Token, right : Token) -> bool)(
  (left.module_path == right.module_path) && (left.input == right.input)
);
/// True iff `left` and `right` are comparable *and* `left` is at or
/// before `right` in source order (by character offset). Mirrors TS
/// `tokenIsAtOrBefore`.
token_is_at_or_before :: (fn(left : Token, right : Token) -> bool)(
  cond(
    !(tokens_are_comparable(left, right)) => false,
    true => (left.character <= right.character)
  )
);
/// Helper: walk `node`, threading the best-so-far token `current` and
/// returning the latest token comparable with `reference`. Recurses
/// only through `FnCall` (func + args), matching the TS `visit`
/// closure inside `getLastComparableTokenInExpr`.
walk_for_last_comparable_token :: (
  fn(node : AstExpr, reference : Token, current : Token) -> Token
)({
  own := ast_expr_token(node);
  here := cond(
    (tokens_are_comparable(own, reference) && (own.character > current.character)) => own,
    true => current
  );
  match(
    node,
    .Atom(_, _) => here,
    .FnCall({ func, args }) => {
      after_func := recur(func.*, reference, here);
      i := usize(0);
      acc := after_func;
      while(i < args.len(), {
        match(
          args.get(i),
          .None => (),
          .Some(a) => {
            acc = recur(a, reference, acc);
          }
        );
        i = (i + usize(1));
      });
      acc
    }
  )
});
/// Walk `expr` and return the latest token (by character offset) that
/// is `tokens_are_comparable` with `reference`. Mirrors TS
/// `getLastComparableTokenInExpr`: starts from the root token (or
/// falls back to `reference` if the root is incomparable) and walks
/// every `FnCall` child.
get_last_comparable_token_in_expr :: (
  fn(expr : AstExpr, reference : Token) -> Token
)({
  start := ast_expr_token(expr);
  initial := cond(
    tokens_are_comparable(start, reference) => start,
    true => reference
  );
  walk_for_last_comparable_token(expr, reference, initial)
});
/// True iff `consumed_at_token` is comparable with `cleanup_expr.token`
/// *and* it lies at or before the last comparable token reachable from
/// `cleanup_expr`. Mirrors TS `variableWasConsumedBeforeCleanupPoint`
/// — the precise liveness check that lets the return-codegen skip
/// drops for variables already consumed before the cleanup point.
variable_was_consumed_before_cleanup_point :: (
  fn(consumed_at_token : Token, cleanup_expr : AstExpr) -> bool
)({
  cleanup_tok := ast_expr_token(cleanup_expr);
  cond(
    !(tokens_are_comparable(consumed_at_token, cleanup_tok)) => false,
    true => {
      cleanup_point := get_last_comparable_token_in_expr(cleanup_expr, consumed_at_token);
      token_is_at_or_before(consumed_at_token, cleanup_point)
    }
  )
});
export(
  tokens_are_comparable,
  token_is_at_or_before,
  get_last_comparable_token_in_expr,
  variable_was_consumed_before_cleanup_point,
  walk_for_last_comparable_token
);
