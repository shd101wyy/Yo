//! Partial 1-to-1 port of `src/codegen/exprs/property-access.ts`.
//!
//! Currently exposes two leaf paths of `generateFieldAccess`:
//!
//!   - `generate_newtype_field_access(object_code, object_type,
//!     field_name)` — when `object_type` is a single-field newtype
//!     struct AND `field_name` matches that field's label, returns
//!     `object_code` unchanged (newtype is a zero-cost abstraction;
//!     in C the newtype is typedef'd to the underlying type and the
//!     field access is the identity).
//!
//!   - `generate_method_field_access(call_value, ctx)` — when the
//!     evaluator's typed metadata says the field-access expression's
//!     compile-time value is a `FuncVal` (i.e. `obj.method` resolves
//!     to a function value), return the function's registered C name.
//!     Mirrors the TS branch:
//!         if (expr.$?.value && isFunctionValue(expr.$.value)) {
//!           const cFunctionName =
//!             context.functions[funcId]?.cName || functionValue.funcId;
//!           return cFunctionName;
//!         }
//!
//! Returns `.None` for any other shape so the bootstrap codegen can
//! keep handling struct/enum/module/Rc-method paths. The full
//! `generate_field_access` still depends on state-machine variables,
//! evidence-parameter resolution, late-dispatch trait lookup, and
//! Index-trait dispatch — none yet exposed in yo-self codegen.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue } :: import("../../types/type.yo");
{ is_newtype_type } :: import("../../types/guards.yo");
{ EvalValue } :: import("../../value.yo");
{ CodegenContext } :: import("../context.yo");
/// Emit the C code for `obj.field` when `obj` has a single-field
/// newtype type and `field_name` matches that field's label.
/// Returns `.Some(object_code)` (the newtype access is the
/// identity); `.None` otherwise so the caller can defer.
///
/// Mirrors the newtype branch in TS `generateFieldAccess`:
///
///     if (isNewtypeType(objectType) && objectType.fields.length === 1) {
///       const singleField = objectType.fields[0];
///       if (singleField && singleField.label === fieldName) {
///         return objectCode;
///       }
///     }
generate_newtype_field_access :: (
  fn(object_code : String, object_type : TypeValue, field_name : String) -> Option(String)
)(
  cond(
    !(is_newtype_type(object_type)) => Option(String).None,
    true => match(
      object_type,
      .Struct({ field_labels }) => cond(
        (field_labels.len() != usize(1)) => Option(String).None,
        true => match(
          field_labels.get(usize(0)),
          .None => Option(String).None,
          .Some(label) => cond(
            (label == field_name) => Option(String).Some(object_code),
            true => Option(String).None
          )
        )
      ),
      _ => Option(String).None
    )
  )
);
/// Emit the C code for `obj.method` when the typed AST says the
/// expression's compile-time value is a `FuncVal` (i.e. the
/// evaluator already resolved the method to a concrete function
/// value). Returns `.Some(c_name)` if the function is registered in
/// `ctx.functions`, falling back to the raw `func_id` otherwise —
/// matching the TS `?? functionValue.funcId` short-circuit.
///
/// Returns `.None` when `call_value` is not a `FuncVal`, so the
/// caller can defer to a different lowering branch (newtype access,
/// late-dispatch trait lookup, evidence resolution, …).
///
/// Mirrors the method-access branch of TS `generateFieldAccess`.
generate_method_field_access :: (
  fn(call_value : EvalValue, ctx : *(CodegenContext)) -> Option(String)
)(
  match(
    call_value,
    .FuncVal({ func_id }) => match(
      ctx.*.get_function_c_name(func_id),
      .Some(c_name) => Option(String).Some(c_name),
      .None => Option(String).Some(func_id)
    ),
    _ => Option(String).None
  )
);
export(generate_newtype_field_access, generate_method_field_access);
