//! Generate code for the `open(struct_value)` runtime destructuring form.
//!
//! 1-to-1 port of `src/codegen/exprs/open.ts`.
//!
//! When the evaluator records non-empty `runtime_destructurings` on the
//! `open(...)` call and the argument is a runtime `Struct` value (no
//! compile-time value), the handler emits a local variable declaration
//! per destructured field:
//!
//!   ```c
//!   <field_c_type> <var_name> = <struct_code>.<field_label>;
//!   ```
//!
//! The expression itself evaluates to `""` — `open` is a statement-style
//! form; the resulting Yo value is `unit`.
//!
//! Metadata requirement:
//!   `expr.$.runtimeDestructurings` and `argExpr.$.type` from the typed-
//!   AST pipeline. With no metadata at all (no evaluator pass), this
//!   handler is unreachable from the production code paths — the TS
//!   implementation also early-returns when the metadata is missing.
//!   Yo-self returns `.None` so callers can fall back to the bootstrap
//!   heuristic in `exprs.yo`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_id } :: import("../../expr.yo");
{ ExprInfo, RuntimeDestructuring } :: import("../../expr_info.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_struct_type } :: import("../../types/guards.yo");
{ EvalValue } :: import("../../value.yo");
{ CodegenContext } :: import("../context.yo");
{ call_gen_expr } :: import("./expr.yo");
{
  sanitize_for_c_identifier,
  get_type_string,
  format_typed_var_name,
  format_typed_init_line
} :: import("../utils/index.yo");
// `get_type_string(t, ctx)` (in codegen/utils/index.yo) replaces the old
// local `get_field_c_type` helper. The canonical helper consults the
// type registry first, then falls back to the primitive lowering, then
// to the TS-canonical `"int32_t"` default.
/// Format a destructuring-field declaration line:
///   `<indent><field_type> <var_name> = <struct_code>.<field_label>;`
///
/// Pure string composition — mirrors the inline build inside the
/// `runtime_destructurings` loop in `generate_open`. The variant in
/// `match.yo`'s `format_data_binding_decl` bakes in a `"  "` indent
/// for case-block nesting; this version is indent-parameterized so
/// runtime callers (the destructuring loop) can pass through the
/// caller's emit indent.
format_destructure_field_decl :: (
  fn(
    indent : String,
    field_type : String,
    var_name : String,
    struct_code : String,
    field_label : String
  ) -> String
)({
  // Compose `<type> <var>` then `<struct>.<field>` then route through
  // the canonical typed-init line formatter.
  type_and_name := format_typed_var_name(field_type, var_name);
  field_access := String.from(struct_code.as_str());
  field_access.push_str(".");
  field_access.push_string(field_label);
  format_typed_init_line(indent, type_and_name, field_access)
});
/// Generate code for `open(arg_expr)`.
///
/// Reads `expr.runtime_destructurings` and the arg's type/value from the
/// `ExprInfoTable` via the `CodegenContext`. Emits one
/// `T var = struct.label;` statement per destructured field and returns
/// the empty Yo unit sentinel `""` when destructurings were present.
/// Returns `.None` when no metadata is attached to the call.
generate_open :: (
  fn(
    call_expr : AstExpr,
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)(
  match(
    ctx.get_expr_info(ast_expr_id(call_expr)),
    .None => Option(String).None,
    .Some(info) => match(
      info.runtime_destructurings,
      .None => Option(String).Some(String.from("")),
      .Some(destructurings) => cond(
        (destructurings.len() == usize(0)) => Option(String).Some(String.from("")),
        true => match(
          args.get(usize(0)),
          .None => Option(String).Some(String.from("")),
          .Some(arg_expr) => match(
            ctx.get_expr_info(ast_expr_id(arg_expr)),
            .None => Option(String).Some(String.from("")),
            .Some(arg_info) => cond(
              // Only emit code for *runtime* struct values: the type is
              // a Struct AND there is no compile-time value attached.
              (!(is_struct_type(arg_info.ty) && arg_info.value.is_none())) =>
                Option(String).Some(String.from("")),
              true => match(
                call_gen_expr(arg_expr, ctx, indent),
                .None => Option(String).None,
                .Some(struct_code) => {
                  n := destructurings.len();
                  (i : usize) = usize(0);
                  while(i < n, {
                    match(
                      destructurings.get(i),
                      .None => (),
                      .Some(d) => {
                        field_type := get_type_string(d.ty, ctx);
                        var_name := sanitize_for_c_identifier(d.variable_name);
                        field_label := sanitize_for_c_identifier(d.label);
                        ctx.emitter.emit_string_line(
                          format_destructure_field_decl(
                            indent,
                            field_type,
                            var_name,
                            struct_code,
                            field_label
                          )
                        );
                      }
                    );
                    i = (i + usize(1));
                  });
                  Option(String).Some(String.from(""))
                }
              )
            )
          )
        )
      )
    )
  )
);
export(generate_open, format_destructure_field_decl);
