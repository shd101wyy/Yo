//! Shared helpers for emitting async Future completion boilerplate.
//!
//! 1-to-1 port of `src/codegen/exprs/async-completion.ts`.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ Emitter } :: import("../../emitter.yo");
{
  indent_plus_two,
  format_indented_line,
  format_typed_init_line
} :: import("../utils/index.yo");
AsyncCompletionOptions :: object(
  emitter : Emitter,
  indent : String,
  result_code : Option(String),
  debug_label : Option(String)
);
// `format_indented_line` is now defined in `codegen/utils/index.yo` and
// imported at the top of this file. The existing export list keeps the
// name available so existing test imports continue to work.
/// Compose the `sm->result = <code>;` assignment with leading indent.
/// Routed through the canonical `format_typed_init_line` helper —
/// the LHS is the literal `sm->result` (no real type, just the
/// state-machine result field).
format_async_result_assign :: (fn(indent : String, result_code : String) -> String)(
  format_typed_init_line(indent, String.from("sm->result"), result_code)
);
/// Compose an ASYNC_DEBUG log line: `<indent>ASYNC_DEBUG("<label><tail>`
/// where `tail` is the verbatim text following the label — including
/// the closing `");` and any printf-style argument list. Indent is
/// prepended verbatim, so callers pass extra spaces (`"  "`) when the
/// debug line is nested inside the `if (continuation_fn != NULL)` block.
format_async_debug_line :: (fn(indent : String, label : String, tail : str) -> String)({
  s := indent.clone();
  s.push_str("ASYNC_DEBUG(\"");
  s.push_string(label);
  s.push_str(tail);
  s
});
emit_async_future_completion :: (fn(opts : AsyncCompletionOptions) -> unit)({
  match(
    opts.result_code,
    .None => (),
    .Some(result_code) => opts.emitter.emit_string_line(
      format_async_result_assign(opts.indent, result_code)
    )
  );
  match(
    opts.debug_label,
    .None => (),
    .Some(debug_label) => opts.emitter.emit_string_line(
      format_async_debug_line(opts.indent, debug_label, ": Setting state to COMPLETED\\n\");")
    )
  );
  opts.emitter.emit_string_line(
    format_indented_line(opts.indent, "sm->state = -1;  // -1 = completed")
  );
  opts.emitter.emit_line("");
  opts.emitter.emit_string_line(
    format_indented_line(opts.indent, "void (*continuation_fn)(void*) = (void (*)(void*))sm->continuation_fn;")
  );
  opts.emitter.emit_string_line(
    format_indented_line(opts.indent, "void* continuation_sm = sm->continuation_sm;")
  );
  opts.emitter.emit_line("");
  opts.emitter.emit_string_line(
    format_indented_line(opts.indent, "if (continuation_fn != NULL) {")
  );
  match(
    opts.debug_label,
    .None => (),
    .Some(debug_label2) => opts.emitter.emit_string_line(
      format_async_debug_line(
        indent_plus_two(opts.indent),
        debug_label2,
        ": Spawning continuation: resume_fn=%p, sm=%p\\n\", (void*)continuation_fn, continuation_sm);"
      )
    )
  );
  opts.emitter.emit_line("");
  opts.emitter.emit_string_line(format_indented_line(opts.indent, "  sm->continuation_fn = NULL;"));
  opts.emitter.emit_string_line(format_indented_line(opts.indent, "  sm->continuation_sm = NULL;"));
  opts.emitter.emit_line("");
  opts.emitter.emit_string_line(
    format_indented_line(opts.indent, "  __yo_async_spawn_task(continuation_fn, continuation_sm);")
  );
  opts.emitter.emit_string_line(format_indented_line(opts.indent, "}"));
  opts.emitter.emit_line("");
  opts.emitter.emit_string_line(format_indented_line(opts.indent, "__yo_decr_rc((void*)sm);"));
  opts.emitter.emit_line("");
  opts.emitter.emit_string_line(format_indented_line(opts.indent, "return;"));
});
emit_async_future_unwind :: (fn(opts : AsyncCompletionOptions) -> unit)({
  match(
    opts.result_code,
    .None => (),
    .Some(result_code) => opts.emitter.emit_string_line(
      format_async_result_assign(opts.indent, result_code)
    )
  );
  match(
    opts.debug_label,
    .None => (),
    .Some(debug_label) => opts.emitter.emit_string_line(
      format_async_debug_line(
        opts.indent,
        debug_label,
        ": Setting state to ESCAPED (effect handler escape)\\n\");"
      )
    )
  );
  opts.emitter.emit_string_line(
    format_indented_line(opts.indent, "sm->state = -2;  // -2 = escaped")
  );
  opts.emitter.emit_line("");
  opts.emitter.emit_string_line(
    format_indented_line(opts.indent, "void (*continuation_fn)(void*) = (void (*)(void*))sm->continuation_fn;")
  );
  opts.emitter.emit_string_line(
    format_indented_line(opts.indent, "void* continuation_sm = sm->continuation_sm;")
  );
  opts.emitter.emit_line("");
  opts.emitter.emit_string_line(
    format_indented_line(opts.indent, "if (continuation_fn != NULL) {")
  );
  match(
    opts.debug_label,
    .None => (),
    .Some(debug_label2) => opts.emitter.emit_string_line(
      format_async_debug_line(
        indent_plus_two(opts.indent),
        debug_label2,
        ": Spawning continuation for escaped future: resume_fn=%p, sm=%p\\n\", (void*)continuation_fn, continuation_sm);"
      )
    )
  );
  opts.emitter.emit_line("");
  opts.emitter.emit_string_line(format_indented_line(opts.indent, "  sm->continuation_fn = NULL;"));
  opts.emitter.emit_string_line(format_indented_line(opts.indent, "  sm->continuation_sm = NULL;"));
  opts.emitter.emit_line("");
  opts.emitter.emit_string_line(
    format_indented_line(opts.indent, "  __yo_async_spawn_task(continuation_fn, continuation_sm);")
  );
  opts.emitter.emit_string_line(format_indented_line(opts.indent, "}"));
  opts.emitter.emit_line("");
  opts.emitter.emit_string_line(format_indented_line(opts.indent, "__yo_decr_rc((void*)sm);"));
  opts.emitter.emit_line("");
  opts.emitter.emit_string_line(format_indented_line(opts.indent, "return;"));
});
export(
  AsyncCompletionOptions,
  emit_async_future_completion,
  emit_async_future_unwind,
  format_indented_line,
  format_async_result_assign,
  format_async_debug_line
);
