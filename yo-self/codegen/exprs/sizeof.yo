//! Codegen for the `sizeof(expr)` builtin.
//!
//! 1-to-1 port of `src/codegen/exprs/sizeof.ts` (`generateSizeOf`).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr } :: import("../../expr.yo");
{ CodegenContext } :: import("../context.yo");
{ format_c_function_call } :: import("../utils/index.yo");
{ call_gen_expr } :: import("./expr.yo");
/// Format the C `sizeof(<arg>)` expression. Pure string composition;
/// mirrors the tail of TS `generateSizeOf`.
format_sizeof_call :: (fn(arg_code : String) -> String)(
  format_c_function_call("sizeof", arg_code)
);
/// Generate C code for a `sizeof(expr)` call.
///
/// Mirrors `generateSizeOf` in `src/codegen/exprs/sizeof.ts`.
generate_sizeof :: (
  fn(args : ArrayList(AstExpr), ctx : *(CodegenContext), indent : String) -> Option(String)
)(
  match(
    args.get(usize(0)),
    .None => Option(String).None,
    .Some(arg_expr) => match(
      call_gen_expr(arg_expr, ctx, indent),
      .None => Option(String).None,
      .Some(arg_code) => Option(String).Some(format_sizeof_call(arg_code))
    )
  )
);
export(generate_sizeof, format_sizeof_call);
