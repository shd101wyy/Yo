//! Partial 1-to-1 port of `src/codegen/exprs/rc-fns.ts`.
//!
//! Covers the pure string-formatting wrappers that produce the C call
//! sites for the RC builtins:
//!
//!   - `__yo_decr_rc` / `__yo_incr_rc` (non-atomic refcount ops)
//!   - `__yo_decr_rc_atomic` / `__yo_incr_rc_atomic` (atomic variants
//!     used by Object types with `atomic` modifier and `Iso(T)`)
//!   - `__yo_rc_own` (ownership-transfer marker; identity in C)
//!   - `__yo_dyn_drop` / `__yo_dyn_dup` (Dyn is value-typed; the
//!     ref-count lives on its `.data` pointer)
//!   - `rc(x)` ref-count read — non-atomic header-field access and
//!     the atomic-ordering variant for atomic-object types
//!   - null-checked decr/incr — the `if (x != NULL) { … }` shape used
//!     by `__yo_sometype_drop` / `…dup` for `Impl(Future(T))` values
//!     to skip refcount adjustments on aborted-Future placeholders.
//!
//! These are the formatter primitives that the full handler ports
//! (`generateYoDecrRc` / `…IncrRc` / `…RcOwn` / `…DynDrop` / `…DynDup`
//! / `generateRcCall` / `…SomeTypeDrop` / `…SomeTypeDup`) will call
//! after recursively lowering the argument expression via the main
//! expr dispatcher.
//!
//! The array/tuple element variants
//! (`generateYoDropArrayElement` / `generateYoDupArrayElement`) need
//! the recursive emitter + `get_drop_function_for_type` /
//! `get_dup_function_for_type` lookups and stay in the bootstrap
//! codegen until the type-name + function-cname registries land.
//! The concrete-`___drop` dispatch branch of `generateYoSomeTypeDrop`
//! similarly waits on the trait fields' `assigned_value` slot.
open(import("std/string"));
{ format_c_function_call, format_void_ptr_data_cast } :: import("../utils/index.yo");
/// Format the C call site `__yo_decr_rc(arg_code)`. Mirrors the body of
/// TS `generateYoDecrRc` — pure string wrap.
format_decr_rc_call :: (fn(arg_code : String) -> String)(
  format_c_function_call("__yo_decr_rc", arg_code)
);
/// Format the C call site `__yo_incr_rc(arg_code)`. Mirrors the body of
/// TS `generateYoIncrRc` — pure string wrap.
format_incr_rc_call :: (fn(arg_code : String) -> String)(
  format_c_function_call("__yo_incr_rc", arg_code)
);
/// Identity-style "rc-own" formatter — returns `arg_code` as-is.
/// Mirrors TS `generateYoRcOwn`: an ownership-transfer marker has no
/// runtime effect on the generated C expression.
format_rc_own :: (fn(arg_code : String) -> String)(arg_code);
/// Format the atomic-variant call site `__yo_decr_rc_atomic(arg_code)`.
/// Used by the `drop-dup` leaf emit when the type is atomic-Object or
/// `Iso(T)`. Lives in `rc_fns.yo` rather than `drop_dup.yo` so the
/// builtin-wrapper formatters stay grouped.
format_decr_rc_atomic_call :: (fn(arg_code : String) -> String)(
  format_c_function_call("__yo_decr_rc_atomic", arg_code)
);
/// Format `__yo_incr_rc_atomic(arg_code)` — symmetric counterpart to
/// `format_decr_rc_atomic_call`.
format_incr_rc_atomic_call :: (fn(arg_code : String) -> String)(
  format_c_function_call("__yo_incr_rc_atomic", arg_code)
);
/// Format the `__yo_dyn_drop` call site:
///   `__yo_decr_rc((void*)(arg_code).data)`
///
/// Dyn is a value type; the ref-count lives on its `.data` pointer.
/// Mirrors the body of TS `generateYoDynDrop` — pure string wrap.
format_dyn_drop_call :: (fn(arg_code : String) -> String)(
  format_decr_rc_call(format_void_ptr_data_cast(arg_code))
);
/// Format the `__yo_dyn_dup` call site:
///   `__yo_incr_rc((void*)(arg_code).data)`
///
/// Symmetric counterpart to `format_dyn_drop_call`. Mirrors the body
/// of TS `generateYoDynDup`.
format_dyn_dup_call :: (fn(arg_code : String) -> String)(
  format_incr_rc_call(format_void_ptr_data_cast(arg_code))
);
/// Format the non-atomic `rc(x)` read site:
///   `((__yo_ref_header_t*)(arg_code))->ref_count`
///
/// Mirrors the non-atomic-object branch of TS `generateRcCall`. The
/// builtin returns a runtime `usize` so the C lowering is a direct
/// header-field access through a cast.
format_rc_count_non_atomic :: (fn(arg_code : String) -> String)({
  s := String.from("((__yo_ref_header_t*)(");
  s.push_str(arg_code.as_str());
  s.push_str("))->ref_count");
  s
});
/// Format the atomic `rc(x)` read site:
///   `atomic_load_explicit((_Atomic size_t*)&((__yo_ref_header_t*)(arg_code))->ref_count, memory_order_acquire)`
///
/// Mirrors the atomic-object branch of TS `generateRcCall`. Reads
/// through `atomic_load_explicit` with acquire ordering so the
/// observed count is consistent across threads.
format_rc_count_atomic :: (fn(arg_code : String) -> String)({
  s := String.from("atomic_load_explicit((_Atomic size_t*)&((__yo_ref_header_t*)(");
  s.push_str(arg_code.as_str());
  s.push_str("))->ref_count, memory_order_acquire)");
  s
});
/// Format the null-checked decr-rc statement used by
/// `generateYoSomeTypeDrop` for `Impl(Future(T))` values:
///   `if (<arg_code> != NULL) { __yo_decr_rc((void*)<arg_code>); }`
///
/// `Impl(Future(T))` is heap-backed and ref-counted; the state
/// machine is freed when the refcount hits zero. The null check
/// guards against an aborted-Future placeholder (`state == -2`).
/// Pure string composition.
format_null_checked_decr_rc :: (fn(arg_code : String) -> String)({
  s := String.from("if (");
  s.push_str(arg_code.as_str());
  s.push_str(" != NULL) { __yo_decr_rc((void*)");
  s.push_str(arg_code.as_str());
  s.push_str("); }");
  s
});
/// Symmetric `incr_rc` variant used by `generateYoSomeTypeDup`:
///   `if (<arg_code> != NULL) { __yo_incr_rc((void*)<arg_code>); }`
format_null_checked_incr_rc :: (fn(arg_code : String) -> String)({
  s := String.from("if (");
  s.push_str(arg_code.as_str());
  s.push_str(" != NULL) { __yo_incr_rc((void*)");
  s.push_str(arg_code.as_str());
  s.push_str("); }");
  s
});
export(
  format_decr_rc_call,
  format_incr_rc_call,
  format_rc_own,
  format_decr_rc_atomic_call,
  format_incr_rc_atomic_call,
  format_dyn_drop_call,
  format_dyn_dup_call,
  format_rc_count_non_atomic,
  format_rc_count_atomic,
  format_null_checked_decr_rc,
  format_null_checked_incr_rc
);
