//! Recursive expression-codegen trampoline.
//!
//! 1-to-1 port of `src/codegen/exprs/expr.ts`.
//!
//! This module stores the real `generate_expr` function pointer after the
//! monolithic dispatcher has been defined.  Per-handler modules can import
//! `call_gen_expr` without importing `exprs.yo` and creating a cycle.
open(import("std/string"));
{ AstExpr } :: import("../../expr.yo");
{ CodegenContext } :: import("../context.yo");
GenerateExprFn :: (fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String));
(g_generate_expr_fn : Option(GenerateExprFn)) =.None;
set_generate_expr_fn :: (fn(generator : GenerateExprFn) -> unit)({
  g_generate_expr_fn =.Some(generator);
});
call_gen_expr :: (fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String))(
  match(
    g_generate_expr_fn,
    .None => Option(String).None,
    .Some(generator) => generator(expr, ctx, indent)
  )
);
export(GenerateExprFn, set_generate_expr_fn, call_gen_expr);
