//! Partial 1-to-1 port of `src/codegen/exprs/dyn.ts`.
//!
//! Covers the leaf path of `generate_dyn_for_resolved_inputs`: when
//! the dyn wrapper type and the underlying object type are already
//! resolved (no boxed-closure or async-state-machine special cases),
//! the emit is a pure registration + struct-literal pair:
//!
//!   1. Compute the impl key
//!        `${concrete_type_c_name}_${dyn_type_c_name}`.
//!   2. Register an entry in `ctx.dyn_impls` (deduplicated by impl
//!      key) so the post-handler vtable emitter can later generate
//!      the matching `__yo_vtable_${implKey}` definition.
//!   3. Emit a C compound literal:
//!        `${DynCName} ${tempVar} = { .data = <code>, .vtable = &__yo_vtable_<key> };`
//!      and return the temp-var name as the dyn value's C expression.
//!
//! The full `generate_dyn_call` (which walks the AST, resolves
//! types from `ExprInfo`, handles boxed-closure auto-extraction, and
//! routes around the async state machine's SM-field slots) is still
//! pending — it needs evaluator-side `runtime_arg_exprs_in_order`
//! plus state-machine variables that yo-self's codegen does not yet
//! expose.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_id } :: import("../../expr.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_dyn_type, is_object_type, is_iso_type } :: import("../../types/guards.yo");
{ EvalValue } :: import("../../value.yo");
{ extract_fn_trait_from_type } :: import("../../evaluator/trait_checking.yo");
{ CodegenContext, CodegenDynImplEntry } :: import("../context.yo");
{
  get_type_string,
  get_type_string_opt,
  sanitize_for_c_identifier,
  format_indented_line
} :: import("../utils/index.yo");
{ call_gen_expr } :: import("./expr.yo");
/// Build the C identifier for a dyn vtable: `__yo_vtable_<sanitized(impl_key)>`.
///
/// The vtable generator (a separate post-handler pass) consumes
/// `ctx.dyn_impls` and emits one `static const __yo_vtable_t
/// __yo_vtable_<key> = { ... };` per entry. Pure string composition;
/// the impl key is canonical-sanitised so the resulting identifier
/// is a valid C symbol even if the underlying type-name characters
/// would not be.
format_dyn_vtable_name :: (fn(impl_key : String) -> String)({
  s := String.from("__yo_vtable_");
  s.push_string(sanitize_for_c_identifier(impl_key));
  s
});
/// Build the C compound-literal for a fully-resolved dyn value:
///
///   `(<dyn_c_name>){ .data = <value_code>, .vtable = &<vtable_name> }`
///
/// Used inside `generate_dyn_for_resolved_inputs` as a one-line
/// alternative to the 4-line struct-literal declaration; useful for
/// rvalue positions (function arguments, return slot) where a
/// compound literal is preferred over a named temp.
format_dyn_compound_literal :: (
  fn(dyn_c_name : String, value_code : String, vtable_name : String) -> String
)({
  s := String.from("(");
  s.push_string(dyn_c_name);
  s.push_str("){ .data = ");
  s.push_str(value_code.as_str());
  s.push_str(", .vtable = &");
  s.push_string(vtable_name);
  s.push_str(" }");
  s
});
/// Format the dyn-impl dedup key: `<concrete_c_name>_<dyn_c_name>`.
/// The first `dyn(value)` lowering registers this key in `ctx.dyn_impls`;
/// subsequent lowerings of the same (concrete, dyn) pair are deduped.
format_dyn_impl_key :: (fn(concrete_c_name : String, dyn_c_name : String) -> String)({
  s := concrete_c_name.clone();
  s.push_str("_");
  s.push_string(dyn_c_name);
  s
});
/// Format the dyn struct-literal declaration header:
///   `<indent><dyn_c_name> <temp> = {`
/// First line of the 4-line dyn temp declaration emitted by
/// `generate_dyn_for_resolved_inputs`.
format_dyn_struct_decl_header :: (
  fn(indent : String, dyn_c_name : String, temp_name : String) -> String
)({
  s := indent.clone();
  s.push_string(dyn_c_name);
  s.push_str(" ");
  s.push_string(temp_name);
  s.push_str(" = {");
  s
});
/// Format the dyn struct-literal `.data = ...` line:
///   `<indent>  .data = <value_code>,`
format_dyn_data_init :: (fn(indent : String, value_code : String) -> String)({
  s := indent.clone();
  s.push_str("  .data = ");
  s.push_str(value_code.as_str());
  s.push_str(",");
  s
});
/// Format the dyn struct-literal `.vtable = &...` line:
///   `<indent>  .vtable = &<vtable_name>`
format_dyn_vtable_init :: (fn(indent : String, vtable_name : String) -> String)({
  s := indent.clone();
  s.push_str("  .vtable = &");
  s.push_string(vtable_name);
  s
});
/// Format the closing line of the dyn struct-literal declaration:
///   `<indent>};`
format_dyn_struct_decl_close :: (fn(indent : String) -> String)(
  format_indented_line(indent, "};")
);
/// Emit the C declaration for a `dyn(value)` cast given pre-resolved
/// types. Returns `.Some(temp_var_name)` on success or `.None` when
/// any precondition fails.
///
/// Preconditions:
///   - `dyn_type` is a `Dyn(Trait)` type.
///   - `data_type` is an `Object` or `Iso` type (the runtime data
///     slot must be a single reference). Boxed value types (which
///     auto-extract from `Box(T)`) are not handled here — the full
///     port will route them through the `dyn_impls` map's
///     `data_type` field.
///   - `temp_var_name` is non-empty.
generate_dyn_for_resolved_inputs :: (
  fn(
    value_code : String,
    value_type : TypeValue,
    dyn_type : TypeValue,
    trait_values : ArrayList(EvalValue),
    temp_var_name : String,
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)(
  cond(
    !(is_dyn_type(dyn_type)) => Option(String).None,
    (!(is_object_type(value_type)) && !(is_iso_type(value_type))) =>
      Option(String).None,
    (temp_var_name.len() == usize(0)) => Option(String).None,
    true => {
      dyn_c_name := get_type_string(dyn_type, ctx);
      // Concrete-type C-name resolution mirrors the IIFE in
      // generateDynCall: first try the direct registry lookup, then
      // fall back to the underlying FnTrait's C name (for boxed
      // closures whose concrete type is the Impl wrapper of an Fn
      // trait), then to the canonical int32_t default.
      concrete_c_name := match(
        get_type_string_opt(value_type, ctx),
        .Some(name) => name,
        .None => match(
          extract_fn_trait_from_type(value_type),
          .None => String.from("int32_t"),
          .Some(fn_trait) => get_type_string(fn_trait, ctx)
        )
      );
      // Impl key: `${concrete_c_name}_${dyn_c_name}`.
      impl_key := format_dyn_impl_key(concrete_c_name, dyn_c_name);
      // Dedup-register in ctx.dyn_impls via the canonical helper. The
      // first emission stores the (dyn, concrete, data) triple +
      // trait_values; subsequent emissions are no-ops. Mirrors the TS
      // `context.dynImpls.set(implKey, …)` call in `generateDynCall`.
      if(ctx.get_dyn_impl(impl_key).is_none(), {
        entry := CodegenDynImplEntry(
          dyn_type : dyn_type,
          concrete_type : value_type,
          data_type : value_type,
          trait_values : trait_values
        );
        ctx.register_dyn_impl(impl_key.clone(), entry);
      });
      // Build the C `__yo_vtable_${implKey}` symbol — the vtable's
      // C identifier may contain non-identifier bytes if the impl
      // key already does (it shouldn't, since type_to_string-driven
      // c_name's are pre-sanitised, but the canonical mangler is
      // safe to apply regardless).
      vtable_name := format_dyn_vtable_name(impl_key);
      san_temp := sanitize_for_c_identifier(temp_var_name);
      // Emit the four-line struct-literal declaration.
      ctx.emitter.emit_string_line(
        format_dyn_struct_decl_header(indent, dyn_c_name, san_temp)
      );
      ctx.emitter.emit_string_line(format_dyn_data_init(indent, value_code));
      ctx.emitter.emit_string_line(format_dyn_vtable_init(indent, vtable_name));
      ctx.emitter.emit_string_line(format_dyn_struct_decl_close(indent));
      Option(String).Some(san_temp)
    }
  )
);
/// AST-level entry point for `dyn(value)` codegen.
///
/// Resolves the dyn-wrapper type and trait values from the call's
/// `ExprInfo`, recursively lowers the value argument (using the
/// runtime-arg list if present, else `args[0]`), validates that the
/// runtime data slot is an object / iso type, and delegates to
/// `generate_dyn_for_resolved_inputs`.
///
/// Returns `.None` when any precondition fails (no `ExprInfo`,
/// missing trait values, missing value type, missing temp-var name,
/// non-Dyn result type, value type is not object/iso, …). The
/// bootstrap codegen takes over in that case.
///
/// The Box(T) auto-extraction branch (which TS handles by reading
/// `valueType.fields[0]!.type` as the impl-concrete type while
/// keeping `Box(T)` as the runtime data slot) still waits on the
/// is_boxed_type predicate landing — yo-self currently stubs that
/// to `false`.
generate_dyn_call :: (
  fn(
    call_expr : AstExpr,
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  call_info_opt := ctx.get_expr_info(ast_expr_id(call_expr));
  match(
    call_info_opt,
    .None => Option(String).None,
    .Some(call_info) => match(
      call_info.dyn_call_trait_values,
      .None => Option(String).None,
      .Some(trait_values) => cond(
        (trait_values.len() == usize(0)) => Option(String).None,
        true => cond(
          !(is_dyn_type(call_info.ty)) => Option(String).None,
          true => {
            // Prefer the runtime-arg list (with full ExprInfo
            // attached); fall back to the AST args[0].
            value_arg_opt := match(
              call_info.runtime_arg_exprs_in_order,
              .Some(rt) => rt.get(usize(0)),
              .None => args.get(usize(0))
            );
            match(
              value_arg_opt,
              .None => Option(String).None,
              .Some(value_arg) => match(
                ctx.get_expr_info(ast_expr_id(value_arg)),
                .None => Option(String).None,
                .Some(value_info) => match(
                  call_info.variable_name,
                  .None => Option(String).None,
                  .Some(temp_var) => match(
                    call_gen_expr(value_arg, ctx, indent),
                    .None => Option(String).None,
                    .Some(value_code) => generate_dyn_for_resolved_inputs(
                      value_code,
                      value_info.ty,
                      call_info.ty,
                      trait_values,
                      temp_var,
                      ctx,
                      indent
                    )
                  )
                )
              )
            )
          }
        )
      )
    )
  )
});
export(
  generate_dyn_for_resolved_inputs,
  generate_dyn_call,
  format_dyn_vtable_name,
  format_dyn_compound_literal,
  format_dyn_impl_key,
  format_dyn_struct_decl_header,
  format_dyn_data_init,
  format_dyn_vtable_init,
  format_dyn_struct_decl_close
);
