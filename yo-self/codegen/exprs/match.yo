//! Match expression C code generation for the self-hosted Yo compiler.
//!
//! 1-to-1 partial port of `src/codegen/exprs/match.ts`. The full
//! `generateMatchExpression` port (1182 lines in TS) is still pending
//! because it needs the function-generation context (pending deferred
//! drops, consumed-var pending drops, inside-match flag, ...).
//!
//! Pure helpers (no codegen context):
//!   - `is_control_flow_code(c)` — true iff the emitted C string
//!     represents an unconditional control-flow exit (empty,
//!     `break`, `continue`, a `goto`, or a `return` keyword).
//!   - `is_or_pattern(e)` — true iff the AST node is a `|`-infix
//!     binary call (used inside `match` arms to combine patterns).
//!   - `flatten_or_pattern(e)` — left/right flatten an or-pattern
//!     into a list of individual sub-patterns.
//!   - `c_literal_from_eval_value(v)` — emit the C literal text for
//!     a `BoolVal` / `IntLit` `EvalValue` (`true`, `false`, `42`,
//!     etc.). Returns `.None` for any other shape.
//!
//! Switch-statement generators (require `CodegenContext`):
//!
//!   generate_match_simple — for unit-only enums; uses `switch (scrutinee)`.
//!   generate_match_data   — for data enums; uses `switch ((scrutinee).tag)`.
//!
//! C output pattern (simple enum):
//!   ResultType _temp;
//!   switch (scrutinee) {
//!   case __YO_ENUM_MOD_ID_N_RED: {
//!     _temp = body;
//!     break;
//!   }
//!   ...
//!   }
//!   // caller uses _temp as the expression value
//!
//! C output pattern (data enum):
//!   ResultType _temp;
//!   switch ((scrutinee).tag) {
//!   case __YO_ENUM_MOD_ID_N_CIRCLE: {
//!     int32_t r = scrutinee.data.Circle.r;
//!     _temp = body;
//!     break;
//!   }
//!   ...
//!   }
//!
//! Wildcard arms (tag_const = "") emit a `default:` case.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of
} :: import("../../expr.yo");
{ TokenKind } :: import("../../token.yo");
{ EvalValue } :: import("../../value.yo");
{ CodegenContext } :: import("../context.yo");
{
  format_typed_init_line,
  format_typed_var_name,
  format_typed_decl_line
} :: import("../utils/index.yo");
// ---------------------------------------------------------------------------
// AST shape predicates (moved from codegen/exprs.yo in Phase A.8.5).
// Pure helpers that classify match arm patterns and extract variant names.
// ---------------------------------------------------------------------------
/// Extract the arm args from a `cond` arm (which is `FnCall("=>", [c, b], true)`).
get_arm_args :: (fn(arm : AstExpr) -> Option(ArrayList(AstExpr)))(
  match(
    arm,
    .Atom(_, _) => Option(ArrayList(AstExpr)).None,
    .FnCall(_, _, arm_args, _, _) =>.Some(arm_args)
  )
);
/// True if `expr` is a `|`-pattern: `FnCall(Atom('|'), [left, right], infix=true)`.
_is_or_pattern :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, pf, pargs, pinfix, _) => cond(
      (!(pinfix)) => false,
      (pargs.len() != usize(2)) => false,
      true => match(
        pf.*,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, pftok) => (pftok.value.as_str() == "|")
      )
    )
  )
);
/// True if the match arm pattern is a data-enum arm (`.Variant(bindings...)`).
_is_data_arm_pattern :: (fn(pat_expr : AstExpr) -> bool)(
  match(
    pat_expr,
    .Atom(_, _) => false,
    .FnCall(_, pat_func, _, pat_infix, _) => cond(
      pat_infix => false,
      // .V(bindings...) form: outer func is FnCall(Atom('.'), [V])
      match(
        pat_func.*,
        .Atom(_, _) => false,
        .FnCall(_, inner_func, inner_args, inner_infix, _) => cond(
          inner_infix => false,
          (inner_args.len() != usize(1)) => false,
          true => match(
            inner_func.*,
            .FnCall(_, _, _, _, _) => false,
            .Atom(_, ifatom) => (ifatom.kind == TokenKind.Dot)
          )
        )
      ) => true,
      true => false
    )
  )
);
/// Extract the variant name from a data-arm pattern `.Variant(bindings)`.
/// Returns `None` for non-data-arm patterns.
data_arm_variant_name :: (fn(pat_expr : AstExpr) -> Option(String))(
  match(
    pat_expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, pat_func, _, pat_infix, _) => cond(
      pat_infix => Option(String).None,
      true => match(
        pat_func.*,
        .Atom(_, _) => Option(String).None,
        .FnCall(_, inner_func, inner_args, inner_infix, _) => cond(
          inner_infix => Option(String).None,
          (inner_args.len() != usize(1)) => Option(String).None,
          true => match(
            inner_func.*,
            .FnCall(_, _, _, _, _) => Option(String).None,
            .Atom(_, dot_tok) => cond(
              (dot_tok.kind != TokenKind.Dot) => Option(String).None,
              true => match(
                inner_args.get(usize(0)),
                .None => Option(String).None,
                .Some(variant_expr) => match(
                  variant_expr,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, variant_tok) => Option(String).Some(variant_tok.value)
                )
              )
            )
          )
        )
      )
    )
  )
);
/// Extract the variant name from either a data arm `.V(bindings)` or a bare
/// unit arm `.V` (no parentheses).
///
/// Returns `None` for wildcards (`_`) and non-variant patterns.
_get_arm_variant_name :: (fn(pat_expr : AstExpr) -> Option(String))(
  match(
    data_arm_variant_name(pat_expr),
    .Some(vn) => Option(String).Some(vn),
    .None => match(
      pat_expr,
      .Atom(_, _) => Option(String).None,
      .FnCall(_, pfunc, pargs, pinfix, _) => cond(
        pinfix => Option(String).None,
        (pargs.len() != usize(1)) => Option(String).None,
        true => match(
          pfunc.*,
          .FnCall(_, _, _, _, _) => Option(String).None,
          .Atom(_, ptok) => cond(
            (ptok.kind != TokenKind.Dot) => Option(String).None,
            true => match(
              pargs.get(usize(0)),
              .None => Option(String).None,
              .Some(vexpr) => match(
                vexpr,
                .FnCall(_, _, _, _, _) => Option(String).None,
                .Atom(_, vtok) => Option(String).Some(vtok.value)
              )
            )
          )
        )
      )
    )
  )
);
/// True if `expr` is `match(scrut, ...)` where any arm pattern is `.Variant(bindings...)`.
/// Used to decide whether to use `generate_match_data` instead of ternary chains.
_has_data_arm :: (fn(args : ArrayList(AstExpr)) -> bool)({
  n := args.len();
  (i : usize) = usize(1);
  (found : bool) = false;
  while((i < n) && (!(found)), {
    match(
      args.get(i),
      .None => (),
      .Some(arm_expr) => match(
        get_arm_args(arm_expr),
        .None => (),
        .Some(arm_args) => match(
          arm_args.get(usize(0)),
          .None => (),
          .Some(pat_expr) => {
            if(_is_data_arm_pattern(pat_expr), {
              found = true;
            });
          }
        )
      )
    );
    i = (i + usize(1));
  });
  found
});
/// True iff `byte` is part of a C identifier (`[A-Za-z0-9_]`).
is_c_word_byte_ :: (fn(byte : u8) -> bool)(
  ((byte >= u8(65)) && (byte <= u8(90))) ||
    (
      ((byte >= u8(97)) && (byte <= u8(122))) ||
        (((byte >= u8(48)) && (byte <= u8(57))) || (byte == u8(95)))
    )
);
/// Helper: true iff `code` contains the bare word `return` (not as a
/// prefix or suffix of a longer identifier). Mirrors the TS
/// `/\breturn\b/` regex by checking each candidate match's
/// surrounding byte against the C identifier byte set.
contains_return_word :: (fn(code : String) -> bool)({
  needle := String.from("return");
  needle_str := needle.as_str();
  needle_bytes := needle.as_bytes();
  needle_len := needle_bytes.len();
  haystack_bytes := code.as_bytes();
  haystack_len := haystack_bytes.len();
  cond(
    (haystack_len < needle_len) => false,
    true => {
      // Walk every candidate start position and check (a) the bytes
      // there spell `return` and (b) the byte before / after is not
      // an identifier-byte (so we reject `return_flag` and `noreturn`).
      i := usize(0);
      end := (haystack_len - needle_len);
      found := false;
      while((i <= end) && !(found), {
        // Match the needle bytes at position `i`.
        matches := true;
        k := usize(0);
        while((k < needle_len) && matches, {
          h := match(haystack_bytes.get(i + k),.Some(b) => b,.None => u8(0));
          n := match(needle_bytes.get(k),.Some(b) => b,.None => u8(1));
          if(h != n, {
            matches = false;
          });
          k = (k + usize(1));
        });
        if(matches, {
          before_ok := cond(
            (i == usize(0)) => true,
            true => {
              prev := match(haystack_bytes.get(i - usize(1)),.Some(b) => b,.None => u8(0));
              !(is_c_word_byte_(prev))
            }
          );
          after_ok := {
            after_i := (i + needle_len);
            cond(
              (after_i >= haystack_len) => true,
              true => {
                next := match(haystack_bytes.get(after_i),.Some(b) => b,.None => u8(0));
                !(is_c_word_byte_(next))
              }
            )
          };
          if(before_ok && after_ok, {
            found = true;
          });
        });
        i = (i + usize(1));
      });
      found
    }
  )
});
/// True iff `code` is an empty string or has the shape of a C control
/// flow exit (`break`, `continue`, a `goto <label>` prefix, or a
/// statement containing the `return` keyword).
///
/// Mirrors TS `isControlFlowCode`. The `return` check uses a word
/// boundary (so identifiers like `return_flag` don't match) — yo-self
/// approximates that with prefix / suffix-of-word checks against the
/// surrounding bytes.
is_control_flow_code :: (fn(code : String) -> bool)({
  s := code.as_str();
  cond(
    (code.len() == usize(0)) => true,
    (s == "break") => true,
    (s == "continue") => true,
    code.starts_with(String.from("goto")) => true,
    true => contains_return_word(code)
  )
});
/// True iff `e` is an infix `|`-call with exactly two arguments —
/// the shape `match` arms use to combine alternate patterns
/// (`.A | .B => …`).
is_or_pattern :: (fn(e : AstExpr) -> bool)(
  ast_expr_is_fn_call_of(e, "|", Option(usize).Some(usize(2)))
);
/// Left/right flatten an or-pattern into a list of individual
/// patterns. Non-or-patterns wrap into a singleton list. Mirrors TS
/// `flattenOrPattern`.
flatten_or_pattern :: (fn(e : AstExpr) -> ArrayList(AstExpr))({
  out := ArrayList(AstExpr).new();
  cond(
    !(is_or_pattern(e)) => {
      out.push(e);
    },
    true => match(
      e,
      .Atom(_, _) => {
        out.push(e);
      },
      .FnCall({ args }) => match(
        args.get(usize(0)),
        .None => (),
        .Some(left) => match(
          args.get(usize(1)),
          .None => (),
          .Some(right) => {
            left_flat := recur(left);
            right_flat := recur(right);
            i := usize(0);
            while(i < left_flat.len(), {
              match(
                left_flat.get(i),
                .None => (),
                .Some(p) => {
                  out.push(p);
                }
              );
              i = (i + usize(1));
            });
            j := usize(0);
            while(j < right_flat.len(), {
              match(
                right_flat.get(j),
                .None => (),
                .Some(p) => {
                  out.push(p);
                }
              );
              j = (j + usize(1));
            });
          }
        )
      )
    )
  );
  out
});
/// Emit the C literal text for a compile-time `EvalValue` that's
/// either a boolean or an integer literal. Used by primitive `switch`
/// case labels. Returns `.None` for any other shape (floats / strings
/// / enums / structs / etc. need richer lowering).
///
/// Mirrors TS `getCLiteralFromValue` — number values are stringified
/// directly, booleans become the C `true` / `false` keywords.
c_literal_from_eval_value :: (fn(v : EvalValue) -> Option(String))(
  match(
    v,
    .BoolVal(b) => Option(String).Some(
      cond(b => String.from("true"), true => String.from("false"))
    ),
    .IntLit(raw) => Option(String).Some(raw),
    _ => Option(String).None
  )
);
// ---------------------------------------------------------------------------
// Data structures for resolved match arms
// ---------------------------------------------------------------------------
/// A single field binding inside a data-enum arm.
///
/// E.g., in `.Circle(r) => body`:
///   var_name  = "r"
///   field_path = "data.Circle.r"   (C field path within the scrutinee value)
///   type_c    = "int32_t"
DataBinding :: struct(
  var_name : String,
  field_path : String,
  type_c : String
);
/// A single arm in a simple (unit-variant-only) match.
SimpleArm :: struct(
  /// The C tag constant, e.g., `"__YO_ENUM_MOD_ID_N_RED"`.
  /// Empty string means wildcard (`_ =>`) → emits `default:`.
  tag_const : String,
  /// The arm body AST node.
  body : AstExpr
);
/// A single arm in a data-enum match (may also be unit if bindings is empty).
DataArm :: struct(
  /// The C tag constant.  Empty string means wildcard → `default:`.
  tag_const : String,
  /// Field bindings (empty for unit variants or wildcards).
  bindings : ArrayList(DataBinding),
  /// The arm body AST node.
  body : AstExpr
);
// ---------------------------------------------------------------------------
// Shared emitter helpers (require CodegenContext)
// ---------------------------------------------------------------------------
/// Indent string for one extra level inside the switch body.
SWITCH_INDENT :: "  ";
/// Emit `ResultType tempname;\n` into the code section.
/// Format a single data-arm binding declaration:
///   `  <type_c> <var_name> = <scrutinee_c>.<field_path>;`
///
/// The leading two-space indent matches the in-case nesting level
/// used by `emit_data_bindings`. Mirrors the inline composition in TS
/// `emitDataBindings`.
format_data_binding_decl :: (
  fn(type_c : str, var_name : str, scrutinee_c : str, field_path : str) -> String
)({
  type_and_name := format_typed_var_name(String.from(type_c), String.from(var_name));
  field_access := String.from(scrutinee_c);
  field_access.push_str(".");
  field_access.push_str(field_path);
  format_typed_init_line(String.from("  "), type_and_name, field_access)
});
/// Format the match-result temp declaration line:
///   `<result_type_c> <temp_name>;`
/// No leading indent — match emits at column 0 since it's a
/// top-level lowering (the surrounding scope owns the indent).
/// Composed from canonical helpers (wrapping `str` params to `String`).
format_match_temp_decl_line :: (fn(result_type_c : str, temp_name : str) -> String)(
  format_typed_decl_line(
    String.new(),
    format_typed_var_name(String.from(result_type_c), String.from(temp_name))
  )
);
emit_match_temp_decl :: (
  fn(
    result_type_c : str,
    temp_name : str,
    ctx : CodegenContext
  ) -> unit
)({
  ctx.emitter.emit_line(format_match_temp_decl_line(result_type_c, temp_name).as_str());
});
/// Format the C switch header line:
///   - `switch (<scrutinee_c>) {`              (use_tag_field=false)
///   - `switch ((<scrutinee_c>).tag) {`        (use_tag_field=true)
/// The tagged form is used for data enums where the scrutinee is the
/// compound (tag + payload) struct.
format_match_switch_open :: (fn(scrutinee_c : str, use_tag_field : bool) -> String)({
  s := String.from("switch (");
  if(use_tag_field, {
    s.push_str("(");
    s.push_str(scrutinee_c);
    s.push_str(").tag");
  }, {
    s.push_str(scrutinee_c);
  });
  s.push_str(") {");
  s
});
/// Format a case header line:
///   - `default: {`                  when `tag_const` is the empty string
///   - `case <tag_const>: {`         otherwise
format_match_case_open :: (fn(tag_const : str) -> String)(
  if(tag_const == "", String.from("default: {"), {
    s := String.from("case ");
    s.push_str(tag_const);
    s.push_str(": {");
    s
  })
);
/// Format the case-arm assignment line: `  <temp_name> = <body_c>;`.
/// The `  ` prefix matches the case-block indent — the arm value
/// gets written into the result temp before the trailing `break;`.
/// Composed from `format_typed_init_line` (wrapping `str` to `String`).
format_match_case_assignment :: (fn(temp_name : str, body_c : str) -> String)(
  format_typed_init_line(String.from("  "), String.from(temp_name), String.from(body_c))
);
/// Emit `switch (scrutinee_c) {` or `switch ((scrutinee_c).tag) {`.
emit_switch_open :: (
  fn(
    scrutinee_c : str,
    use_tag_field : bool,
    ctx : CodegenContext
  ) -> unit
)({
  ctx.emitter.emit_line(format_match_switch_open(scrutinee_c, use_tag_field).as_str());
});
/// Emit `case TAG: {` or `default: {`.
emit_case_open :: (fn(tag_const : str, ctx : CodegenContext) -> unit)({
  ctx.emitter.emit_line(format_match_case_open(tag_const).as_str());
});
/// Emit `  temp_name = body_c;\n  break;\n}`.
emit_case_body :: (
  fn(
    temp_name : str,
    body_c : str,
    ctx : CodegenContext
  ) -> unit
)({
  ctx.emitter.emit_line(format_match_case_assignment(temp_name, body_c).as_str());
  ctx.emitter.emit_line("  break;");
  ctx.emitter.emit_line("}");
});
// ---------------------------------------------------------------------------
// Simple match (unit enums)
// ---------------------------------------------------------------------------
/// Generate a `switch` statement for a unit-only enum match.
///
/// `scrutinee_c`  — the C expression for the value being matched
/// `result_type_c` — the C return type of the match expression
/// `temp_name`     — the name of the temp variable that captures each arm result
/// `arms`          — the resolved arm list (tag_const + body AstExpr)
/// `gen_body`      — callback to compile an arm body: `(body, ctx, indent) -> Option(String)`
///
/// Returns the temp variable name (callers use it as the expression value).
generate_match_simple :: (
  fn(
    scrutinee_c : str,
    result_type_c : str,
    temp_name : str,
    arms : ArrayList(SimpleArm),
    gen_body : (fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String)),
    ctx : CodegenContext,
    indent : str
  ) -> unit
)({
  emit_match_temp_decl(result_type_c, temp_name, ctx);
  emit_switch_open(scrutinee_c, false, ctx);
  (i : usize) = usize(0);
  n := arms.len();
  while(i < n, {
    arm_opt := arms.get(i);
    match(
      arm_opt,
      .Some(arm) => {
        emit_case_open(arm.tag_const.as_str(), ctx);
        body_c_opt := gen_body(arm.body, ctx, String.from(indent));
        match(
          body_c_opt,
          .Some(body_c) => emit_case_body(temp_name, body_c.as_str(), ctx),
          .None => ()
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  ctx.emitter.emit_line("}");
});
// ---------------------------------------------------------------------------
// Data match (data enums with field bindings)
// ---------------------------------------------------------------------------
/// Emit field binding declarations for a data enum arm.
///
/// For each binding:
///   `type_c var_name = scrutinee_c.field_path;`
emit_data_bindings :: (
  fn(
    scrutinee_c : str,
    bindings : ArrayList(DataBinding),
    ctx : CodegenContext
  ) -> unit
)({
  (i : usize) = usize(0);
  n := bindings.len();
  while(i < n, {
    b_opt := bindings.get(i);
    match(
      b_opt,
      .Some(b) => {
        decl := format_data_binding_decl(
          b.type_c.as_str(),
          b.var_name.as_str(),
          scrutinee_c,
          b.field_path.as_str()
        );
        ctx.emitter.emit_line(decl.as_str());
      },
      .None => ()
    );
    i = (i + usize(1));
  });
});
/// Generate a `switch ((scrutinee).tag)` statement for a data enum match.
///
/// Works for enums that may have a mix of unit variants (no bindings) and
/// data variants (with bindings).  Wildcards use an empty `tag_const`.
generate_match_data :: (
  fn(
    scrutinee_c : str,
    result_type_c : str,
    temp_name : str,
    arms : ArrayList(DataArm),
    gen_body : (fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String)),
    ctx : CodegenContext,
    indent : str
  ) -> unit
)({
  emit_match_temp_decl(result_type_c, temp_name, ctx);
  emit_switch_open(scrutinee_c, true, ctx);
  (i : usize) = usize(0);
  n := arms.len();
  while(i < n, {
    arm_opt := arms.get(i);
    match(
      arm_opt,
      .Some(arm) => {
        emit_case_open(arm.tag_const.as_str(), ctx);
        emit_data_bindings(scrutinee_c, arm.bindings, ctx);
        body_c_opt := gen_body(arm.body, ctx, String.from(indent));
        match(
          body_c_opt,
          .Some(body_c) => emit_case_body(temp_name, body_c.as_str(), ctx),
          .None => ()
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  ctx.emitter.emit_line("}");
});
export(
  is_control_flow_code,
  is_or_pattern,
  flatten_or_pattern,
  c_literal_from_eval_value,
  DataBinding,
  SimpleArm,
  DataArm,
  emit_match_temp_decl,
  emit_switch_open,
  emit_case_open,
  emit_case_body,
  emit_data_bindings,
  format_data_binding_decl,
  format_match_temp_decl_line,
  format_match_switch_open,
  format_match_case_open,
  format_match_case_assignment,
  generate_match_simple,
  generate_match_data,
  get_arm_args,
  _is_or_pattern,
  _is_data_arm_pattern,
  data_arm_variant_name,
  _get_arm_variant_name,
  _has_data_arm
);
