//! Match-expression emitter — mirrors `src/codegen/exprs/match.ts`. COMPLETE.
//!
//! generate_match_expression dispatches all enum paths after the header
//! (result-temp decl, subject materialization, isPrimitiveMatch delegation,
//! ptr/ref-semantics deref): primitive (int/bool → C switch), nullable-pointer
//! (if/else), simple-enum (tag switch), and tagged-union (tag switch with
//! `.data.<Variant>.<field>` destructuring — labeled + positional, via the EnumT
//! parallel arrays variant_names/variant_field_labels/variant_fields, since
//! yo-self EnumT has no `.variants[].fields[]` objects). Per-arm bodies via
//! generate_case_body; comptime-eliminated arms (case_executed) are skipped.
//!
//! DEFERRED (documented, not hit by the no-RC/no-async corpus): the deferred-dup
//! rewrite of a begin-block final expression in generate_case_body (Phase 4);
//! state-machine storage of destructured variables (Phase 5, gated on in_async).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ AstExpr, ast_expr_is_atom, ast_expr_is_fn_call_of, ast_expr_token, BK_BEGIN, BF_DOT } :: import("../../expr.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ has_any_control_flow } :: import("../../expr_info.yo");
{ is_unit_type, is_pointer_type, is_reference_struct_type, is_reference_enum_type, is_enum_type } :: import("../../types/guards.yo");
{ Environment, get_variables_from_env } :: import("../../env.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ generate_deferred_drop_expressions, generate_deferred_dup_expressions } :: import("./drop_dup.yo");
{ get_type_string, get_variable_name_for_codegen, type_key, sanitize_for_c_identifier, can_optimize_as_nullable_pointer, can_optimize_as_simple_enum, get_enum_variant_c_name } :: import("../utils/index.yo");
/// True for an ASCII word byte ([A-Za-z0-9_]).
_is_word_byte :: (fn(b : u8) -> bool)(
  ((b >= u8(97)) && (b <= u8(122))) || (((b >= u8(65)) && (b <= u8(90))) || (((b >= u8(48)) && (b <= u8(57))) || (b == u8(95))))
);
/// Whether `s` contains "return" as a whole word (the TS `\breturn\b` regex).
_contains_word_return :: (fn(s : String) -> bool)({
  word := String.from("return");
  wlen := usize(6);
  slen := s.len();
  (from : usize) = usize(0);
  while(true, {
    match(
      s.index_of(word.clone(), from),
      .Some(idx) => {
        before_ok := if(idx == usize(0), true, !(_is_word_byte(s.byte_at(idx - usize(1)))));
        after_idx := (idx + wlen);
        after_ok := if(after_idx >= slen, true, !(_is_word_byte(s.byte_at(after_idx))));
        if(before_ok && after_ok, {
          return(true);
        }, {
          from = (idx + usize(1));
        });
      },
      .None => {
        return(false);
      }
    );
  });
  false
});
/// Whether generated code is control flow that must NOT be assigned to a temp.
/// Mirrors `isControlFlowCode`.
_is_control_flow_code :: (fn(code : String) -> bool)(
  (code.len() == usize(0)) || ((code == String.from("break")) || ((code == String.from("continue")) || (code.starts_with("goto") || _contains_word_return(code))))
);
/// Args of a FnCall (empty for an Atom).
_args :: (fn(e : AstExpr) -> ArrayList(AstExpr))(
  match(e,.FnCall(_, _, a, _, _) => a,.Atom(_, _) => ArrayList(AstExpr).new())
);
/// True if `expr` is an or-pattern `a | b`. Mirrors `isOrPattern`.
_is_or_pattern :: (fn(expr : AstExpr) -> bool)(
  ast_expr_is_fn_call_of(expr, "|", Option(usize).Some(usize(2)))
);
/// Flatten an or-pattern into its individual patterns. Mirrors `flattenOrPattern`.
_flatten_or_pattern :: (fn(expr : AstExpr) -> ArrayList(AstExpr))(
  if(!(_is_or_pattern(expr)), {
    out := ArrayList(AstExpr).new();
    _p := out.push(expr);
    out
  }, {
    args := _args(expr);
    out := ArrayList(AstExpr).new();
    match(
      args.get(usize(0)),
      .Some(left) => {
        l := recur(left);
        nl := l.len();
        (i : usize) = usize(0);
        while(i < nl, {
          match(
            l.get(i),
            .Some(e) => {
              _p := out.push(e);
            },
            .None => ()
          );
          i = (i + usize(1));
        });
      },
      .None => ()
    );
    match(
      args.get(usize(1)),
      .Some(right) => {
        r := recur(right);
        nr := r.len();
        (j : usize) = usize(0);
        while(j < nr, {
          match(
            r.get(j),
            .Some(e) => {
              _p := out.push(e);
            },
            .None => ()
          );
          j = (j + usize(1));
        });
      },
      .None => ()
    );
    out
  })
);
/// A C literal for a compile-time value (number / bool). Mirrors `getCLiteralFromValue`.
_c_literal_from_value :: (fn(value : EvalValue) -> Option(String))(
  match(value,.IntLit(r) => Option(String).Some(r),.FloatLit(r) => Option(String).Some(r),.BoolVal(b) => Option(String).Some(if(b, String.from("true"), String.from("false"))), _ => Option(String).None)
);
/// Concatenate `current` then `prev` (both optional) into a fresh drop list.
_concat_drops :: (fn(current : Option(ArrayList(AstExpr)), prev : Option(ArrayList(AstExpr))) -> ArrayList(AstExpr))({
  out := ArrayList(AstExpr).new();
  match(
    current,
    .Some(cd) => {
      n := cd.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          cd.get(i),
          .Some(e) => {
            _p := out.push(e);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .None => ()
  );
  match(
    prev,
    .Some(pp) => {
      n := pp.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          pp.get(i),
          .Some(e) => {
            _p := out.push(e);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .None => ()
  );
  out
});
/// Generate a match/cond case body (begin blocks inline their statements and
/// yield the final expression). Mirrors `generateCaseBody`. (The begin-final
/// deferred-dup rewrite is Phase 4 — empty for the no-RC corpus.)
generate_case_body :: (fn(body_expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)(
  if(ast_expr_is_fn_call_of(body_expr, BK_BEGIN, Option(usize).None), {
    em := context.base.emitter;
    begin_args := _args(body_expr);
    vei_opt := context.base.get_expr_info(body_expr);
    cur_drops := match(vei_opt,.Some(vei) => vei.deferred_drop_expressions,.None => Option(ArrayList(AstExpr)).None);
    cur_consumed := match(vei_opt,.Some(vei) => vei.consumed_variable_drop_expressions,.None => Option(ArrayList(AstExpr)).None);
    prev_pending := context.pending_deferred_drops;
    prev_consumed := context.consumed_var_pending_drops;
    context.pending_deferred_drops = Option(ArrayList(AstExpr)).Some(_concat_drops(cur_drops, prev_pending));
    context.consumed_var_pending_drops = Option(ArrayList(AstExpr)).Some(_concat_drops(cur_consumed, prev_consumed));
    n := begin_args.len();
    // All statements except the last.
    if(n > usize(0), {
      (j : usize) = usize(0);
      (stop : bool) = false;
      while((j < (n - usize(1))) && !(stop), {
        match(
          begin_args.get(j),
          .Some(arg) => {
            arg_code := _call_generate_expr(arg, indent.clone(), context);
            if(arg_code.len() > usize(0), {
              line := indent.clone();
              line.push_string(arg_code);
              line.push_str(";");
              em.emit_string_line(line);
            });
            match(
              context.base.get_expr_info(arg),
              .Some(aei) => if(has_any_control_flow(aei.control_flow), {
                stop = true;
              }),
              .None => ()
            );
          },
          .None => ()
        );
        j = (j + usize(1));
      });
    });
    // Final expression.
    final_code := if(n > usize(0), match(begin_args.get(n - usize(1)),.Some(final_expr) => _call_generate_expr(final_expr, indent.clone(), context),.None => String.from("")), String.from(""));
    generate_deferred_drop_expressions(body_expr, indent.clone(), context);
    context.pending_deferred_drops = prev_pending;
    context.consumed_var_pending_drops = prev_consumed;
    final_code
  }, {
    // Non-begin: emit deferred dups, then the expression.
    generate_deferred_dup_expressions(body_expr, indent.clone(), context);
    _call_generate_expr(body_expr, indent.clone(), context)
  })
);
/// Emit one case body + temp assignment / break. Shared by the primitive
/// (default + value) arms.
_emit_case_body_and_break :: (fn(case_body : AstExpr, indent : String, body_indent : String, temp_var_opt : Option(String), is_unit : bool, context : FunctionGenerationContext) -> unit)({
  em := context.base.emitter;
  body_code := generate_case_body(case_body, body_indent.clone(), context);
  assigned := match(
    temp_var_opt,
    .Some(tv) => if((!(is_unit) && (body_code.len() > usize(0))) && !(_is_control_flow_code(body_code)), {
      line := body_indent.clone();
      line.push_string(tv.clone());
      line.push_str(" = ");
      line.push_string(body_code.clone());
      line.push_str(";");
      em.emit_string_line(line);
      true
    }, false),
    .None => false
  );
  if(!(assigned) && (body_code.len() > usize(0)), {
    line := body_indent.clone();
    line.push_string(body_code);
    line.push_str(";");
    em.emit_string_line(line);
  });
  brk := body_indent.clone();
  brk.push_str("break;");
  em.emit_string_line(brk);
});
/// Generate a primitive (int/bool) match as a C switch. Mirrors
/// `generatePrimitiveMatchExpression`.
generate_primitive_match_expression :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext, matched_value_code : String, match_value_type : TypeValue, temp_var_opt : Option(String), is_unit : bool) -> String)({
  saved_inside_match := context.base.inside_match;
  context.base.inside_match = true;
  em := context.base.emitter;
  body_indent := indent.clone();
  body_indent.push_str("  ");
  hdr := indent.clone();
  hdr.push_str("switch (");
  hdr.push_string(matched_value_code);
  hdr.push_str(") {");
  em.emit_string_line(hdr);
  args := _args(expr);
  n := args.len();
  (i : usize) = usize(1);
  while(i < n, {
    match(
      args.get(i),
      .Some(case_expr) => if(ast_expr_is_fn_call_of(case_expr, "=>", Option(usize).Some(usize(2))), {
        cargs := _args(case_expr);
        case_value := match(cargs.get(usize(0)),.Some(cv) => cv,.None => case_expr);
        case_body := match(cargs.get(usize(1)),.Some(cb) => cb,.None => case_expr);
        executed := match(context.base.get_expr_info(case_value),.Some(cei) => match(cei.case_executed,.Some(b) => b,.None => false),.None => false);
        if(executed, {
          is_wildcard := (ast_expr_is_atom(case_value) && (ast_expr_token(case_value).value == String.from("_")));
          if(is_wildcard, {
            d := indent.clone();
            d.push_str("default: {");
            em.emit_string_line(d);
            _emit_case_body_and_break(case_body, indent.clone(), body_indent.clone(), temp_var_opt, is_unit, context);
            cl := indent.clone();
            cl.push_str("}");
            em.emit_string_line(cl);
          }, {
            // Emit `case <literal>:` for each pattern value.
            emitted_any := match(
              context.base.get_expr_info(case_value),
              .Some(cei) => match(
                cei.primitive_pattern_values,
                .Some(pvs) => if(pvs.len() > usize(0), {
                  np := pvs.len();
                  (pi : usize) = usize(0);
                  while(pi < np, {
                    match(
                      pvs.get(pi),
                      .Some(vopt) => match(
                        vopt,
                        .Some(v) => match(
                          _c_literal_from_value(v),
                          .Some(lit) => {
                            cl := indent.clone();
                            cl.push_str("case ");
                            cl.push_string(lit);
                            cl.push_str(":");
                            em.emit_string_line(cl);
                          },
                          .None => ()
                        ),
                        .None => ()
                      ),
                      .None => ()
                    );
                    pi = (pi + usize(1));
                  });
                  true
                }, false),
                .None => false
              ),
              .None => false
            );
            if(!(emitted_any), {
              // Fallback: literals from the flattened pattern expressions.
              flat := _flatten_or_pattern(case_value);
              nf := flat.len();
              (fi : usize) = usize(0);
              while(fi < nf, {
                match(
                  flat.get(fi),
                  .Some(pe) => match(
                    context.base.get_expr_info(pe),
                    .Some(pei) => match(
                      pei.value,
                      .Some(v) => match(
                        _c_literal_from_value(v),
                        .Some(lit) => {
                          cl := indent.clone();
                          cl.push_str("case ");
                          cl.push_string(lit);
                          cl.push_str(":");
                          em.emit_string_line(cl);
                        },
                        .None => ()
                      ),
                      .None => ()
                    ),
                    .None => ()
                  ),
                  .None => ()
                );
                fi = (fi + usize(1));
              });
            });
            ob := indent.clone();
            ob.push_str("{");
            em.emit_string_line(ob);
            _emit_case_body_and_break(case_body, indent.clone(), body_indent.clone(), temp_var_opt, is_unit, context);
            cb := indent.clone();
            cb.push_str("}");
            em.emit_string_line(cb);
          });
        });
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  context.base.inside_match = saved_inside_match;
  close := indent.clone();
  close.push_str("}");
  em.emit_string_line(close);
  generate_deferred_drop_expressions(expr, indent.clone(), context);
  if(is_unit, String.from(""), match(temp_var_opt,.Some(tv) => tv,.None => String.from("")))
});
/// Whether a match arm's pattern was executed (comptime branch elimination).
_case_executed :: (fn(case_value : AstExpr, context : FunctionGenerationContext) -> bool)(
  match(context.base.get_expr_info(case_value),.Some(cei) => match(cei.case_executed,.Some(b) => b,.None => false),.None => false)
);
/// The variant name of a `.Variant(...)` / `.Variant` pattern (its first arg's token).
_variant_name :: (fn(case_value : AstExpr) -> String)(
  match(case_value,.FnCall(_, _, a, _, _) => match(a.get(usize(0)),.Some(v) => ast_expr_token(v).value,.None => String.from("")),.Atom(_, _) => String.from(""))
);
/// Nullable-pointer-optimized enum match → if/else (null vs pointer case).
/// Mirrors the `nullablePointerType` branch of `generateMatchExpression`.
_gen_nullable_ptr_match :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext, matched_value_code : String, nullable_inner : TypeValue, is_ptr : bool, temp_var_opt : Option(String), is_unit : bool) -> String)({
  em := context.base.emitter;
  body_indent := indent.clone();
  body_indent.push_str("  ");
  args := _args(expr);
  n := args.len();
  // Classify arms into null-case body and pointer-case (body + pattern).
  (null_body : Option(AstExpr)) = Option(AstExpr).None;
  (ptr_body : Option(AstExpr)) = Option(AstExpr).None;
  (ptr_pattern : Option(AstExpr)) = Option(AstExpr).None;
  (i : usize) = usize(1);
  while(i < n, {
    match(
      args.get(i),
      .Some(ce) => if(ast_expr_is_fn_call_of(ce, "=>", Option(usize).Some(usize(2))), {
        cargs := _args(ce);
        match(
          cargs.get(usize(0)),
          .Some(cv) => match(
            cargs.get(usize(1)),
            .Some(cb) => if(_case_executed(cv, context), {
              // `.None` (caseValue itself is a `.` call) → null case; `.Some(v)` → pointer case.
              if(ast_expr_is_fn_call_of(cv, BF_DOT, Option(usize).None), {
                null_body = Option(AstExpr).Some(cb);
              }, {
                ptr_body = Option(AstExpr).Some(cb);
                ptr_pattern = Option(AstExpr).Some(cv);
              });
            }),
            .None => ()
          ),
          .None => ()
        );
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  // if (<*?>matched != NULL) { <bind payload> <body> } else { <null body> }
  star := if(is_ptr, String.from("*"), String.from(""));
  hdr := indent.clone();
  hdr.push_str("if (");
  hdr.push_string(star);
  hdr.push_string(matched_value_code.clone());
  hdr.push_str(" != NULL) {");
  em.emit_string_line(hdr);
  match(
    ptr_pattern,
    .Some(pat) => {
      // Bind the destructured payload to the pointer value.
      match(
        pat,
        .FnCall(_, _, pargs, _, _) => match(
          pargs.get(usize(0)),
          .Some(dvar) => if(ast_expr_is_atom(dvar), {
            dvn := sanitize_for_c_identifier(ast_expr_token(dvar).value, false);
            decl := body_indent.clone();
            decl.push_string(get_type_string(nullable_inner, context.base));
            decl.push_str(" ");
            decl.push_string(dvn);
            decl.push_str(" = ");
            decl.push_string(matched_value_code.clone());
            decl.push_str(";");
            em.emit_string_line(decl);
          }),
          .None => ()
        ),
        .Atom(_, _) => ()
      );
    },
    .None => ()
  );
  match(
    ptr_body,
    .Some(pb) => {
      body_code := generate_case_body(pb, body_indent.clone(), context);
      if(
        (!(is_unit)) && !(_is_control_flow_code(body_code)),
        match(
          temp_var_opt,
          .Some(tv) => {
            result := if(body_code.len() > usize(0), body_code.clone(), matched_value_code.clone());
            line := body_indent.clone();
            line.push_string(tv.clone());
            line.push_str(" = ");
            line.push_string(result);
            line.push_str(";");
            em.emit_string_line(line);
          },
          .None => if(body_code.len() > usize(0), {
            line := body_indent.clone();
            line.push_string(body_code.clone());
            line.push_str(";");
            em.emit_string_line(line);
          })
        ),
        if(body_code.len() > usize(0), {
          line := body_indent.clone();
          line.push_string(body_code);
          line.push_str(";");
          em.emit_string_line(line);
        })
      );
    },
    .None => ()
  );
  mid := indent.clone();
  mid.push_str("} else {");
  em.emit_string_line(mid);
  match(
    null_body,
    .Some(nb) => {
      body_code := generate_case_body(nb, body_indent.clone(), context);
      if(
        (!(is_unit)) && !(_is_control_flow_code(body_code)),
        match(
          temp_var_opt,
          .Some(tv) => {
            line := body_indent.clone();
            line.push_string(tv.clone());
            line.push_str(" = ");
            line.push_string(body_code.clone());
            line.push_str(";");
            em.emit_string_line(line);
          },
          .None => if(body_code.len() > usize(0), {
            line := body_indent.clone();
            line.push_string(body_code.clone());
            line.push_str(";");
            em.emit_string_line(line);
          })
        ),
        if(body_code.len() > usize(0), {
          line := body_indent.clone();
          line.push_string(body_code);
          line.push_str(";");
          em.emit_string_line(line);
        })
      );
    },
    .None => ()
  );
  close := indent.clone();
  close.push_str("}");
  em.emit_string_line(close);
  if(is_unit, String.from(""), match(temp_var_opt,.Some(tv) => tv,.None => String.from("")))
});
/// Simple (fieldless) enum match → C switch on the tag. Mirrors the
/// `simpleEnumOptimizable` branch of `generateMatchExpression`.
_gen_simple_enum_match :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext, matched_value_code : String, enum_type : TypeValue, deref_star : String, temp_var_opt : Option(String), is_unit : bool) -> String)({
  em := context.base.emitter;
  saved := context.base.inside_match;
  context.base.inside_match = true;
  body_indent := indent.clone();
  body_indent.push_str("  ");
  hdr := indent.clone();
  hdr.push_str("switch (");
  hdr.push_string(deref_star);
  hdr.push_string(matched_value_code);
  hdr.push_str(") {");
  em.emit_string_line(hdr);
  args := _args(expr);
  n := args.len();
  (i : usize) = usize(1);
  while(i < n, {
    match(
      args.get(i),
      .Some(ce) => if(ast_expr_is_fn_call_of(ce, "=>", Option(usize).Some(usize(2))), {
        cargs := _args(ce);
        match(
          cargs.get(usize(0)),
          .Some(cv) => match(
            cargs.get(usize(1)),
            .Some(cb) => if(_case_executed(cv, context), {
              if(ast_expr_is_atom(cv) && (ast_expr_token(cv).value == String.from("_")), {
                d := indent.clone();
                d.push_str("default: {");
                em.emit_string_line(d);
                _emit_case_body_and_break(cb, indent.clone(), body_indent.clone(), temp_var_opt, is_unit, context);
                cl := indent.clone();
                cl.push_str("}");
                em.emit_string_line(cl);
              }, if(ast_expr_is_fn_call_of(cv, BF_DOT, Option(usize).Some(usize(1))), {
                variant_tag := get_enum_variant_c_name(enum_type, _variant_name(cv), context.base);
                h := indent.clone();
                h.push_str("case ");
                h.push_string(variant_tag);
                h.push_str(": {");
                em.emit_string_line(h);
                _emit_case_body_and_break(cb, indent.clone(), body_indent.clone(), temp_var_opt, is_unit, context);
                cl := indent.clone();
                cl.push_str("}");
                em.emit_string_line(cl);
              }));
            }),
            .None => ()
          ),
          .None => ()
        );
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  context.base.inside_match = saved;
  close := indent.clone();
  close.push_str("}");
  em.emit_string_line(close);
  if(is_unit, String.from(""), match(temp_var_opt,.Some(tv) => tv,.None => String.from("")))
});
/// Add a name to the function's local-shadowed-variables set (creating it if
/// absent). A shadowed name resolves in `generate_atom` to its sanitized
/// SOURCE name (the arm-block C declaration), not the evaluator's temp.
_shadow_add :: (fn(context : FunctionGenerationContext, name : String) -> unit)({
  match(
    context.local_shadowed_variables,
    .Some(s) => {
      _a := s.add(name);
    },
    .None => {
      ns := HashSet(String).new();
      _a := ns.add(name);
      context.local_shadowed_variables = Option(HashSet(String)).Some(ns);
    }
  );
});
/// Remove a name from the local-shadowed-variables set (after an arm body, so
/// the shadow does not leak to sibling arms / outer scope).
_shadow_remove :: (fn(context : FunctionGenerationContext, name : String) -> unit)({
  match(
    context.local_shadowed_variables,
    .Some(s) => {
      _r := s.remove(name);
    },
    .None => ()
  );
});
/// Remove the shadows a tagged-union arm's destructuring added, mirroring the
/// var extraction in `_emit_destructure_binds` (labeled `label : var` → var is
/// arg[1]; positional → the atom itself). Called after the arm body.
_remove_arm_shadows :: (fn(params : ArrayList(AstExpr), context : FunctionGenerationContext) -> unit)({
  // Mirror the curly unwrap in _emit_destructure_binds so curly-bound vars are
  // also un-shadowed.
  is_curly := ((params.len() == usize(1)) && (match(params.get(usize(0)),.Some(p0) => ast_expr_is_fn_call_of(p0, "_", Option(usize).None),.None => false)));
  dparams := if(is_curly, match(params.get(usize(0)),.Some(p0) => _args(p0),.None => params.clone()), params.clone());
  np := dparams.len();
  (pi : usize) = usize(0);
  while(pi < np, {
    match(
      dparams.get(pi),
      .Some(p) => {
        var_atom := if(ast_expr_is_fn_call_of(p, ":", Option(usize).Some(usize(2))), match(_args(p).get(usize(1)),.Some(v) => v,.None => p), p);
        if(ast_expr_is_atom(var_atom) && !(ast_expr_token(var_atom).value == String.from("_")), {
          _shadow_remove(context, sanitize_for_c_identifier(ast_expr_token(var_atom).value, false));
        });
      },
      .None => ()
    );
    pi = (pi + usize(1));
  });
});
/// Emit the destructuring binds for a tagged-union arm: `<T> <v> =
/// <matched><access>data.<Variant>.<field>;` per bound field, via the EnumT
/// parallel arrays (variant_names / variant_field_labels / variant_fields).
/// Labeled (`.Circle(r : radius)`) and positional (`.Point(x, y)`) forms.
/// Each bound var's source name is added to local_shadowed_variables so the
/// arm body resolves it to the local C declaration (not the evaluator temp);
/// the caller removes them after the body. (SM storage is Phase 5 — gated.)
_emit_destructure_binds :: (fn(enum_type : TypeValue, variant_name : String, params : ArrayList(AstExpr), matched_value_code : String, access : str, body_indent : String, context : FunctionGenerationContext) -> unit)(
  match(
    enum_type,
    .EnumT({ variant_names : vns, variant_fields : vfs, variant_field_labels : vfls }) => {
      em := context.base.emitter;
      // A match-arm variant pattern carries the leading `.` of `.Variant`; the
      // EnumT's variant_names are clean. Strip it so the lookup matches (else no
      // bind is emitted and the body references an undeclared variable) and so
      // the `.data.<variant>` field name is valid.
      cvariant := if(variant_name.starts_with("."), variant_name.substring(usize(1), variant_name.len()), variant_name.clone());
      // Find the variant index.
      (vi : usize) = vns.len();
      nv := vns.len();
      (vk : usize) = usize(0);
      while(vk < nv, {
        match(
          vns.get(vk),
          .Some(vn) => if(vn == cvariant, {
            vi = vk;
          }),
          .None => ()
        );
        vk = (vk + usize(1));
      });
      if(vi < nv, {
        labels := match(vfls.get(vi),.Some(l) => l,.None => ArrayList(String).new());
        types := match(vfs.get(vi),.Some(t) => t,.None => ArrayList(TypeValue).new());
        // Curly destructuring `.Variant({a, b : alias})`: the single param is a
        // `_`(...) call (the evaluator's curly representation). Lift its inner
        // args so the labeled/positional logic below binds the fields. (`{a}`
        // atoms bind positionally to the field at that index — correct when the
        // curly fields are in declaration order; `{a : alias}` `:` pairs bind by
        // label.)
        is_curly := ((params.len() == usize(1)) && (match(params.get(usize(0)),.Some(p0) => ast_expr_is_fn_call_of(p0, "_", Option(usize).None),.None => false)));
        dparams := if(is_curly, match(params.get(usize(0)),.Some(p0) => _args(p0),.None => params.clone()), params.clone());
        // Labeled if any param is a `:`(2) pair.
        (has_labeled : bool) = false;
        np := dparams.len();
        (pk : usize) = usize(0);
        while(pk < np, {
          match(
            dparams.get(pk),
            .Some(p) => if(ast_expr_is_fn_call_of(p, ":", Option(usize).Some(usize(2))), {
              has_labeled = true;
            }),
            .None => ()
          );
          pk = (pk + usize(1));
        });
        if(has_labeled, {
          (pi : usize) = usize(0);
          while(pi < np, {
            match(
              dparams.get(pi),
              .Some(param) => if(ast_expr_is_fn_call_of(param, ":", Option(usize).Some(usize(2))), {
                pargs := _args(param);
                label := match(pargs.get(usize(0)),.Some(le) => if(ast_expr_is_atom(le), ast_expr_token(le).value, String.from("")),.None => String.from(""));
                match(
                  pargs.get(usize(1)),
                  .Some(var_expr) => if((ast_expr_is_atom(var_expr) && !(ast_expr_token(var_expr).value == String.from("_"))) && (label.len() > usize(0)), {
                    // Find the field index for this label.
                    (fi : usize) = labels.len();
                    nl := labels.len();
                    (lk : usize) = usize(0);
                    while(lk < nl, {
                      match(
                        labels.get(lk),
                        .Some(fl) => if(fl == label, {
                          fi = lk;
                        }),
                        .None => ()
                      );
                      lk = (lk + usize(1));
                    });
                    if(fi < labels.len(), {
                      ftype := match(types.get(fi),.Some(t) => t,.None => TypeValue.Unit);
                      if(!(is_unit_type(ftype)), {
                        decl := body_indent.clone();
                        decl.push_string(get_type_string(ftype, context.base));
                        decl.push_str(" ");
                        decl.push_string(sanitize_for_c_identifier(ast_expr_token(var_expr).value, false));
                        decl.push_str(" = ");
                        decl.push_string(matched_value_code.clone());
                        decl.push_str(access);
                        decl.push_str("data.");
                        decl.push_string(cvariant.clone());
                        decl.push_str(".");
                        decl.push_string(sanitize_for_c_identifier(label.clone(), false));
                        decl.push_str(";");
                        em.emit_string_line(decl);
                        _shadow_add(context, sanitize_for_c_identifier(ast_expr_token(var_expr).value, false));
                      });
                    });
                  }),
                  .None => ()
                );
              }),
              .None => ()
            );
            pi = (pi + usize(1));
          });
        }, {
          // Positional.
          limit := if(np < labels.len(), np, labels.len());
          (fi : usize) = usize(0);
          while(fi < limit, {
            match(
              dparams.get(fi),
              .Some(var_expr) => if(ast_expr_is_atom(var_expr) && !(ast_expr_token(var_expr).value == String.from("_")), {
                field_label := match(labels.get(fi),.Some(fl) => fl,.None => String.from(""));
                ftype := match(types.get(fi),.Some(t) => t,.None => TypeValue.Unit);
                if(!(is_unit_type(ftype)), {
                  decl := body_indent.clone();
                  decl.push_string(get_type_string(ftype, context.base));
                  decl.push_str(" ");
                  decl.push_string(sanitize_for_c_identifier(ast_expr_token(var_expr).value, false));
                  decl.push_str(" = ");
                  decl.push_string(matched_value_code.clone());
                  decl.push_str(access);
                  decl.push_str("data.");
                  decl.push_string(cvariant.clone());
                  decl.push_str(".");
                  decl.push_string(sanitize_for_c_identifier(field_label, false));
                  decl.push_str(";");
                  em.emit_string_line(decl);
                  _shadow_add(context, sanitize_for_c_identifier(ast_expr_token(var_expr).value, false));
                });
              }),
              .None => ()
            );
            fi = (fi + usize(1));
          });
        });
      });
    },
    _ => ()
  )
);
/// The variant name + destructuring params of a tagged-union arm pattern,
/// handling both parse forms (`."(Variant, p...)` and `(.Variant)(p...)`).
/// Returns ("", empty) if the pattern is not a variant.
_arm_variant_and_params :: (fn(case_value : AstExpr) -> Option(String))(
  match(case_value,.FnCall(_, func, args, _, _) => match(func,.Atom(_, tok) => if((tok.value == String.from(BF_DOT)) && (args.len() >= usize(1)), match(args.get(usize(0)),.Some(v) => Option(String).Some(ast_expr_token(v).value),.None => Option(String).None), Option(String).None),.FnCall(_, ffunc, fargs, _, _) => if(match(ffunc,.Atom(_, ft) => (ft.value == String.from(BF_DOT)),.FnCall(_, _, _, _, _) => false) && (fargs.len() == usize(1)), match(fargs.get(usize(0)),.Some(v) => Option(String).Some(ast_expr_token(v).value),.None => Option(String).None), Option(String).None)),.Atom(_, _) => Option(String).None)
);
/// The destructuring params of a tagged-union arm: `args[1..]` for form 1
/// (func is the `.` atom) or all `args` for form 2 (func is `.Variant`).
_arm_params :: (fn(case_value : AstExpr) -> ArrayList(AstExpr))(
  match(
    case_value,
    .FnCall(_, func, args, _, _) => match(
      func,
      .Atom(_, _) => {
        out := ArrayList(AstExpr).new();
        n := args.len();
        (i : usize) = usize(1);
        while(i < n, {
          match(
            args.get(i),
            .Some(a) => {
              _p := out.push(a);
            },
            .None => ()
          );
          i = (i + usize(1));
        });
        out
      },
      .FnCall(_, _, _, _, _) => args
    ),
    .Atom(_, _) => ArrayList(AstExpr).new()
  )
);
/// Tagged-union enum match → C switch on the tag with per-arm destructuring.
/// Mirrors the final (default) branch of `generateMatchExpression`.
_gen_tagged_union_match :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext, matched_value_code : String, match_value_type : TypeValue, enum_type : TypeValue, is_ref_or_ptr : bool, temp_var_opt : Option(String), is_unit : bool) -> String)({
  em := context.base.emitter;
  saved := context.base.inside_match;
  context.base.inside_match = true;
  body_indent := indent.clone();
  body_indent.push_str("  ");
  access := if(is_ref_or_ptr, "->", ".");
  tag_expr := if(is_ref_or_ptr, {
    t := matched_value_code.clone();
    t.push_str("->tag");
    t
  }, {
    t := String.from("(");
    t.push_string(matched_value_code.clone());
    t.push_str(").tag");
    t
  });
  hdr := indent.clone();
  hdr.push_str("switch (");
  hdr.push_string(tag_expr);
  hdr.push_str(") {");
  em.emit_string_line(hdr);
  args := _args(expr);
  n := args.len();
  (i : usize) = usize(1);
  while(i < n, {
    match(
      args.get(i),
      .Some(ce) => if(ast_expr_is_fn_call_of(ce, "=>", Option(usize).Some(usize(2))), {
        cargs := _args(ce);
        match(
          cargs.get(usize(0)),
          .Some(cv) => match(
            cargs.get(usize(1)),
            .Some(cb0) => if(_case_executed(cv, context), {
              if(ast_expr_is_atom(cv) && (ast_expr_token(cv).value == String.from("_")), {
                d := indent.clone();
                d.push_str("default: {");
                em.emit_string_line(d);
                _emit_case_body_and_break(cb0, indent.clone(), body_indent.clone(), temp_var_opt, is_unit, context);
                cl := indent.clone();
                cl.push_str("}");
                em.emit_string_line(cl);
              }, match(
                _arm_variant_and_params(cv),
                .Some(variant_name) => {
                  variant_tag := get_enum_variant_c_name(enum_type, variant_name.clone(), context.base);
                  h := indent.clone();
                  h.push_str("case ");
                  h.push_string(variant_tag);
                  h.push_str(": {");
                  em.emit_string_line(h);
                  params := _arm_params(cv);
                  if(params.len() > usize(0), {
                    _emit_destructure_binds(enum_type, variant_name, params, matched_value_code.clone(), access, body_indent.clone(), context);
                  });
                  // `=> rename` caseBody form: bind the whole matched value to a name.
                  cb := if(ast_expr_is_fn_call_of(cb0, "=>", Option(usize).Some(usize(2))), {
                    rargs := _args(cb0);
                    match(
                      rargs.get(usize(0)),
                      .Some(rename_expr) => {
                        rdecl := body_indent.clone();
                        rdecl.push_string(get_type_string(match_value_type, context.base));
                        rdecl.push_str(" ");
                        rdecl.push_string(sanitize_for_c_identifier(ast_expr_token(rename_expr).value, false));
                        rdecl.push_str(" = ");
                        rdecl.push_string(matched_value_code.clone());
                        rdecl.push_str(";");
                        em.emit_string_line(rdecl);
                      },
                      .None => ()
                    );
                    match(rargs.get(usize(1)),.Some(v) => v,.None => cb0)
                  }, cb0);
                  _emit_case_body_and_break(cb, indent.clone(), body_indent.clone(), temp_var_opt, is_unit, context);
                  // Remove this arm's destructuring shadows so they don't leak.
                  _remove_arm_shadows(params, context);
                  cl := indent.clone();
                  cl.push_str("}");
                  em.emit_string_line(cl);
                },
                .None => ()
              ));
            }),
            .None => ()
          ),
          .None => ()
        );
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  context.base.inside_match = saved;
  close := indent.clone();
  close.push_str("}");
  em.emit_string_line(close);
  generate_deferred_drop_expressions(expr, indent.clone(), context);
  if(is_unit, String.from(""), match(temp_var_opt,.Some(tv) => tv,.None => String.from("")))
});
/// Generate a match expression. Mirrors `generateMatchExpression`.
generate_match_expression :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)({
  ei := match(context.base.get_expr_info(expr),.Some(e) => e,.None => return(String.from("/* \"match\" expression is not evaluated */")));
  temp_var_opt := ei.variable_name;
  value_type := ei.ty;
  is_unit := is_unit_type(value_type);
  em := context.base.emitter;
  if(
    !(is_unit),
    match(
      temp_var_opt,
      .Some(tv) => {
        d := indent.clone();
        d.push_string(get_type_string(value_type, context.base));
        d.push_str(" ");
        d.push_string(tv.clone());
        d.push_str(";");
        em.emit_string_line(d);
      },
      .None => ()
    )
  );
  args := _args(expr);
  subject := match(args.get(usize(0)),.Some(s) => s,.None => return(String.from("// Error: \"match\" expression requires a subject")));
  subject_ei := match(context.base.get_expr_info(subject),.Some(e) => e,.None => return(String.from("// Error: \"match\" expression requires a valid type")));
  match_value_type := subject_ei.ty;
  (matched_value_code : String) = _call_generate_expr(subject, indent.clone(), context);
  // Materialize the subject into its temp var when the evaluator assigned one.
  // Skip when the subject is a `ref`-param atom: emitting `T name = (*name);`
  // declares a local that shadows the pointer parameter and triggers a C
  // redefinition error (e.g. a derived enum `clone` whose `inout(self)` subject
  // is matched). Mirrors the isInoutAtom guard in match.ts (and begin.ts).
  match(
    subject_ei.variable_name,
    .Some(svn) => {
      subject_var_name := get_variable_name_for_codegen(svn, Option(Environment).Some(subject_ei.env));
      is_inout_atom := if(ast_expr_is_atom(subject), {
        vs := get_variables_from_env(subject_ei.env, svn.clone());
        cond(
          (vs.len() == usize(0)) => false,
          true => match(vs.get(vs.len() - usize(1)),.Some(v) => v.is_ref,.None => false)
        )
      }, false);
      if(!(is_inout_atom) && !(matched_value_code == subject_var_name), {
        decl := indent.clone();
        decl.push_string(get_type_string(match_value_type, context.base));
        decl.push_str(" ");
        decl.push_string(subject_var_name.clone());
        decl.push_str(" = ");
        decl.push_string(matched_value_code.clone());
        decl.push_str(";");
        em.emit_string_line(decl);
        matched_value_code = subject_var_name;
      });
    },
    .None => ()
  );
  // Primitive (int/bool) match.
  if(match(ei.is_primitive_match,.Some(b) => b,.None => false), {
    return(generate_primitive_match_expression(expr, indent.clone(), context, matched_value_code, match_value_type, temp_var_opt, is_unit));
  });
  // Dereference pointer / ref-semantics one level to the enum type.
  is_ptr := is_pointer_type(match_value_type);
  is_ref_sem := (!(is_ptr) && (is_reference_struct_type(match_value_type) || is_reference_enum_type(match_value_type)));
  enum_type := if(is_ptr, match(match_value_type,.Pointer(p) => p, _ => match_value_type), match_value_type);
  if(!(is_enum_type(enum_type)), {
    return(String.from("// Error: \"match\" expression requires an enum type"));
  });
  match(context.base.get_type_c_name(type_key(enum_type)),.None => return(String.from("// Error: \"match\" expression enum type has no C name")),.Some(_) => ());
  deref_star := if(is_ptr, String.from("*"), String.from(""));
  // Nullable-pointer optimization.
  match(can_optimize_as_nullable_pointer(enum_type),.Some(nullable_inner) => return(_gen_nullable_ptr_match(expr, indent.clone(), context, matched_value_code, nullable_inner, is_ptr, temp_var_opt, is_unit)),.None => ());
  // Simple (fieldless) enum.
  if(can_optimize_as_simple_enum(enum_type), {
    return(_gen_simple_enum_match(expr, indent.clone(), context, matched_value_code, enum_type, deref_star, temp_var_opt, is_unit));
  });
  // Tagged-union destructuring.
  _gen_tagged_union_match(expr, indent.clone(), context, matched_value_code, match_value_type, enum_type, is_ptr || is_ref_sem, temp_var_opt, is_unit)
});
export(generate_case_body, generate_primitive_match_expression, generate_match_expression);
