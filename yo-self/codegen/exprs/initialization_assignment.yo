//! Partial 1-to-1 port of
//! `src/codegen/exprs/initialization-assignment.ts`.
//!
//! Currently exposes two pure helpers:
//!
//!   - `is_skipped_init_lhs(lhs)` — true iff the LHS of `:=` is
//!     `comptime(x)` or `given(x)` (a 1-arg call), in which case
//!     the TS handler emits an empty C string (no runtime code).
//!     Mirrors the two early-returns near the top of TS
//!     `generateInitializationAssignment`.
//!
//!   - `destructuring_field_name(label)` — pure string helper that
//!     resolves a destructuring field label to its C field name. For
//!     all-digit labels (tuple positional fields) it prepends `_` to
//!     get `_0`, `_1`, … ; otherwise it routes through the canonical
//!     `sanitize_for_c_identifier` to handle operator-named fields
//!     and reserved-word remapping. Mirrors the TS line
//!         label.match(/^\d+$/) ? `_${label}` : sanitizeForCIdentifier(label)
//!     in the `runtimeDestructurings.forEach` body.
//!
//! The full `:=` lowering — state-machine variable-load detection,
//! tag-only enum init, struct compound literals, RC drop/dup of the
//! consumed RHS — still depends on state-machine variables, the
//! function-cname registry, and a recursive value-side dispatcher,
//! none of which is yet exposed in yo-self codegen.
open(import("std/string"));
{
  AstExpr,
  ast_expr_is_fn_call_of,
  BK_COMPTIME,
  BK_GIVEN
} :: import("../../expr.yo");
{ sanitize_for_c_identifier } :: import("../utils/index.yo");
/// True iff `lhs` is the LHS shape `comptime(x)` or `given(x)`
/// (1-arg call). The TS handler returns an empty C string for these
/// because they are compile-time-only bindings.
is_skipped_init_lhs :: (fn(lhs : AstExpr) -> bool)(
  ast_expr_is_fn_call_of(lhs, BK_COMPTIME, Option(usize).Some(usize(1))) ||
    ast_expr_is_fn_call_of(lhs, BK_GIVEN, Option(usize).Some(usize(1)))
);
/// True iff every byte of `s` is an ASCII digit (`0`..`9`). An empty
/// string is treated as "not all digits" — matching the TS `match(/^\d+$/)`
/// behaviour which requires at least one digit.
_is_all_digits :: (fn(s : String) -> bool)({
  bytes := s.as_bytes();
  n := bytes.len();
  if(n == usize(0), {
    return(false);
  });
  (i : usize) = usize(0);
  (all_digits : bool) = true;
  while((i < n) && all_digits, {
    b := match(bytes.get(i),.Some(x) => x,.None => u8(0));
    if((b < u8(48)) || (b > u8(57)), {
      all_digits = false;
    });
    i = (i + usize(1));
  });
  all_digits
});
/// Resolve a destructuring field's `label` to its C field name.
/// All-digit labels (tuple-positional fields like `0`, `1`) get a
/// leading underscore to form valid C identifiers; everything else
/// goes through `sanitize_for_c_identifier`.
///
/// Mirrors the inline TS expression
///     label.match(/^\d+$/) ? `_${label}` : sanitizeForCIdentifier(label)
/// in `runtimeDestructurings.forEach`.
destructuring_field_name :: (fn(label : String) -> String)(
  cond(
    _is_all_digits(label) => {
      s := String.from("_");
      s.push_string(label);
      s
    },
    true => sanitize_for_c_identifier(label)
  )
);
export(is_skipped_init_lhs, destructuring_field_name);
