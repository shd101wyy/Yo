  // Parallel lists: temp var name per operand index (empty = none).
  temp_names := ArrayList(String).new();
  {
    (oi : usize) = usize(0);
    while(oi < operands.len(), {
      temp_names.push(String.new());
      oi = (oi + usize(1));
    });
  };
