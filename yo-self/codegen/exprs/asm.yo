    _cg_comptime_str(template_e, context),
    .Some(template) => {
      decl := String.from("__asm__(");
      decl.push_string(_c_string_literal(template));
      decl.push_str(");");
      em := context.base.emitter;
      em.emit_declaration_string(decl);
    },
    .None => ()
  );
  String.new()
});
export(generate_asm, generate_global_asm);
