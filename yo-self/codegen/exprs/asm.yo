//! Partial 1-to-1 port of `src/codegen/exprs/asm.ts`.
//!
//! Currently exposes the three pure string-transformation helpers
//! from the larger TS file:
//!
//!   - `is_register_class(name)` — true iff `name` is one of the Yo
//!     register-class identifiers (`reg`, `reg_byte`, `xmm_reg`, …).
//!     Used by `extractConstraintString` to decide whether an atom
//!     operand is a class name vs. a free-form constraint.
//!
//!   - `resolve_constraint(constraint, arch)` — translate a Yo
//!     constraint string into the matching GCC inline-asm constraint
//!     letter, dispatched by architecture (`x86_64`, `aarch64`, `x86`,
//!     `arm`). `raw:...` passes through; explicit register names
//!     (`rax`, `eax`, `ax`, …) map to single-letter constraints;
//!     register-class names dispatch through a per-arch table; raw
//!     GCC strings are returned unchanged.
//!
//!   - `transform_template(template)` — rewrite a Yo asm template
//!     string into GCC's `%0` / `%[name]` syntax, with `{{` / `}}`
//!     escapes. Recognises per-arch register modifiers (`{name:e}`
//!     → `%k[name]`, etc.).
//!
//! The remaining 600+ lines of the full `generate_asm` /
//! `generate_global_asm` handlers wait on the operand parser, the
//! evaluator's comptime-string detection on `:=`-typed atoms, and
//! the function-body emitter — none yet exposed in yo-self codegen.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
/// True iff `name` is one of the Yo register-class identifiers
/// recognised by `extractConstraintString`. Mirrors TS
/// `isRegisterClass` exactly.
is_register_class :: (fn(name : str) -> bool)(
  cond(
    (name == "reg") => true,
    (name == "reg_byte") => true,
    (name == "reg_abcd") => true,
    (name == "xmm_reg") => true,
    (name == "ymm_reg") => true,
    (name == "imm") => true,
    (name == "mem") => true,
    true => false
  )
);
/// Look up the explicit-register → GCC-constraint-letter mapping for
/// the common x86_64 registers. Returns `.None` for any other input.
/// Mirrors the `EXPLICIT_REGISTER_CONSTRAINTS` table in TS.
explicit_register_constraint_ :: (fn(reg : str) -> Option(str))(
  cond(
    (reg == "rax") => Option(str).Some("a"),
    (reg == "eax") => Option(str).Some("a"),
    (reg == "ax") => Option(str).Some("a"),
    (reg == "al") => Option(str).Some("a"),
    (reg == "rbx") => Option(str).Some("b"),
    (reg == "ebx") => Option(str).Some("b"),
    (reg == "bx") => Option(str).Some("b"),
    (reg == "bl") => Option(str).Some("b"),
    (reg == "rcx") => Option(str).Some("c"),
    (reg == "ecx") => Option(str).Some("c"),
    (reg == "cx") => Option(str).Some("c"),
    (reg == "cl") => Option(str).Some("c"),
    (reg == "rdx") => Option(str).Some("d"),
    (reg == "edx") => Option(str).Some("d"),
    (reg == "dx") => Option(str).Some("d"),
    (reg == "dl") => Option(str).Some("d"),
    (reg == "rsi") => Option(str).Some("S"),
    (reg == "esi") => Option(str).Some("S"),
    (reg == "si") => Option(str).Some("S"),
    (reg == "rdi") => Option(str).Some("D"),
    (reg == "edi") => Option(str).Some("D"),
    (reg == "di") => Option(str).Some("D"),
    true => Option(str).None
  )
);
/// Look up the register-class → GCC-letter mapping for a given Yo
/// register-class name + arch. The TS table has a `x86_64` entry for
/// every class; archs without a specific entry fall back to the
/// `x86_64` letter, then to `"r"`. Returns `.None` only when `cls` is
/// not a recognised register class.
register_class_to_gcc_ :: (fn(cls : str, arch : str) -> Option(str))(
  cond(
    (cls == "reg") => cond(
      ((arch == "x86_64") || ((arch == "aarch64") || ((arch == "x86") || (arch == "arm")))) =>
        Option(str).Some("r"),
      true => Option(str).Some("r")
    ),
    (cls == "reg_byte") => cond(
      ((arch == "x86_64") || (arch == "x86")) => Option(str).Some("q"),
      true => Option(str).Some("q")
    ),
    (cls == "reg_abcd") => cond(
      ((arch == "x86_64") || (arch == "x86")) => Option(str).Some("Q"),
      true => Option(str).Some("Q")
    ),
    (cls == "xmm_reg") => cond(
      (arch == "aarch64") => Option(str).Some("w"),
      true => Option(str).Some("x")
    ),
    (cls == "ymm_reg") => Option(str).Some("x"),
    (cls == "imm") => Option(str).Some("i"),
    (cls == "mem") => Option(str).Some("m"),
    true => Option(str).None
  )
);
/// Translate a Yo constraint string into the matching GCC inline-asm
/// constraint letter, dispatched by `arch`. Mirrors TS
/// `resolveConstraint`. Empty input defaults to `"r"`.
///   1. `raw:...` passes the suffix through verbatim.
///   2. Explicit register names map via `EXPLICIT_REGISTER_CONSTRAINTS`.
///   3. Register-class names dispatch through the per-arch table.
///   4. Anything else is treated as a raw GCC constraint and returned
///      unchanged.
resolve_constraint :: (fn(constraint : str, arch : str) -> String)(
  cond(
    (constraint.len() == usize(0)) => String.from("r"),
    String.from(constraint).starts_with(String.from("raw:")) => {
      // Drop the `raw:` prefix (4 bytes).
      bytes := String.from(constraint).as_bytes();
      out := String.new();
      i := usize(4);
      while(i < bytes.len(), {
        match(
          bytes.get(i),
          .None => (),
          .Some(b) => {
            out.push_byte(b);
          }
        );
        i = (i + usize(1));
      });
      out
    },
    true => match(
      explicit_register_constraint_(constraint),
      .Some(letter) => String.from(letter),
      .None => match(
        register_class_to_gcc_(constraint, arch),
        .Some(letter) => String.from(letter),
        .None => String.from(constraint)
      )
    )
  )
);
/// Translate a Yo per-arch register template modifier (`e`/`x`/`l`/
/// `h`/`w`) into the matching GCC modifier letter. Mirrors the
/// `TEMPLATE_MODIFIERS` table. Returns the input unchanged for any
/// other modifier (so `{name:foo}` becomes `%foo[name]`).
template_modifier_for_arch_ :: (fn(mod_in : str) -> str)(
  cond(
    (mod_in == "e") => "k",
    (mod_in == "x") => "w",
    (mod_in == "l") => "b",
    (mod_in == "h") => "h",
    (mod_in == "w") => "w",
    true => mod_in
  )
);
/// True iff `s` represents a (possibly multi-digit) non-negative
/// decimal integer. Used by `transform_template` to decide whether a
/// `{...}` placeholder is positional (`{0}`) or named (`{name}`).
all_decimal_digits_ :: (fn(s : str) -> bool)({
  bs := String.from(s).as_bytes();
  n := bs.len();
  cond(
    (n == usize(0)) => false,
    true => {
      (all : bool) = true;
      (i : usize) = usize(0);
      while((i < n) && all, {
        b := match(bs.get(i),.Some(x) => x,.None => u8(0));
        if(!((b >= u8(48)) && (b <= u8(57))), {
          all = false;
        });
        i = (i + usize(1));
      });
      all
    }
  )
});
/// Format a single GCC inline-asm operand placeholder. Combines the
/// four branches that `transform_template` distinguishes:
///
///   - positional + no modifier      → `%<ref>`         (e.g. `%0`)
///   - positional + modifier `m`     → `%<m><ref>`      (e.g. `%k0`)
///   - named + no modifier           → `%[<ref>]`       (e.g. `%[reg]`)
///   - named + modifier `m`          → `%<m>[<ref>]`    (e.g. `%k[reg]`)
///
/// Pure string composition.
format_asm_placeholder :: (
  fn(modifier_opt : Option(str), ref : String, is_positional : bool) -> String
)({
  s := String.from("%");
  match(
    modifier_opt,
    .Some(m) => s.push_str(m),
    .None => ()
  );
  if(!(is_positional), {
    s.push_str("[");
  });
  s.push_string(ref);
  if(!(is_positional), {
    s.push_str("]");
  });
  s
});
/// Rewrite a Yo asm template into GCC's inline-asm operand syntax:
///   `{name}`      → `%[name]`
///   `{0}`         → `%0`
///   `{name:e}`    → `%k[name]`
///   `{0:e}`       → `%k0`
///   `{{` / `}}`   → literal `{` / `}`
/// Mirrors TS `transformTemplate`.
transform_template :: (fn(template : str) -> String)({
  result := String.new();
  bytes := String.from(template).as_bytes();
  n := bytes.len();
  i := usize(0);
  while(i < n, {
    b := match(bytes.get(i),.Some(x) => x,.None => u8(0));
    cond(
      (b == u8(123)) => {
        // '{'
        next := match(bytes.get(i + usize(1)),.Some(x) => x,.None => u8(0));
        cond(
          // {{ → literal {
          (((i + usize(1)) < n) && (next == u8(123))) => {
            result.push_byte(u8(123));
            i = (i + usize(2));
          },
          true => {
            // Find closing '}'.
            close_idx := usize(0);
            found := false;
            (j : usize) = (i + usize(1));
            while((j < n) && !(found), {
              bj := match(bytes.get(j),.Some(x) => x,.None => u8(0));
              if(bj == u8(125), {
                close_idx = j;
                found = true;
              });
              j = (j + usize(1));
            });
            cond(
              !(found) => {
                // No close — copy '{' literally.
                result.push_byte(u8(123));
                i = (i + usize(1));
              },
              true => {
                // Extract inner text bytes[i+1..close_idx).
                inner := String.new();
                (k : usize) = (i + usize(1));
                while(k < close_idx, {
                  match(
                    bytes.get(k),
                    .None => (),
                    .Some(bk) => {
                      inner.push_byte(bk);
                    }
                  );
                  k = (k + usize(1));
                });
                // Split at first ':'.
                inner_bytes := inner.as_bytes();
                colon_idx := usize(0);
                colon_found := false;
                (m : usize) = usize(0);
                while((m < inner_bytes.len()) && !(colon_found), {
                  bm := match(inner_bytes.get(m),.Some(x) => x,.None => u8(0));
                  if(bm == u8(58), {
                    colon_idx = m;
                    colon_found = true;
                  });
                  m = (m + usize(1));
                });
                ref := String.new();
                modifier := String.new();
                cond(
                  colon_found => {
                    (p : usize) = usize(0);
                    while(p < colon_idx, {
                      match(
                        inner_bytes.get(p),
                        .None => (),
                        .Some(bp) => {
                          ref.push_byte(bp);
                        }
                      );
                      p = (p + usize(1));
                    });
                    (q : usize) = (colon_idx + usize(1));
                    while(q < inner_bytes.len(), {
                      match(
                        inner_bytes.get(q),
                        .None => (),
                        .Some(bq) => {
                          modifier.push_byte(bq);
                        }
                      );
                      q = (q + usize(1));
                    });
                  },
                  true => {
                    ref = inner;
                  }
                );
                gcc_mod_opt := cond(
                  colon_found => Option(str).Some(template_modifier_for_arch_(modifier.as_str())),
                  true => Option(str).None
                );
                is_positional := all_decimal_digits_(ref.as_str());
                result.push_string(format_asm_placeholder(gcc_mod_opt, ref, is_positional));
                i = (close_idx + usize(1));
              }
            );
          }
        );
      },
      (b == u8(125)) => {
        // '}' — handle `}}` → literal `}`.
        next := match(bytes.get(i + usize(1)),.Some(x) => x,.None => u8(0));
        cond(
          (((i + usize(1)) < n) && (next == u8(125))) => {
            result.push_byte(u8(125));
            i = (i + usize(2));
          },
          true => {
            result.push_byte(u8(125));
            i = (i + usize(1));
          }
        );
      },
      true => {
        result.push_byte(b);
        i = (i + usize(1));
      }
    );
  });
  result
});
export(
  is_register_class,
  resolve_constraint,
  transform_template,
  format_asm_placeholder
);
