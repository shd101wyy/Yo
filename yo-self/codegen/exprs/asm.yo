  });
  return_exprs := ArrayList(String).new();
  {
    (oi : usize) = usize(0);
    while(oi < operands.len(), {
      match(
        operands.get(oi),
        .Some(op) => {
          skip := (
            (op.is_discarded || op.is_variable_target) ||
              (((op.kind == String.from("in")) || (op.kind == String.from("const_val"))) || (op.kind == String.from("sym")))
