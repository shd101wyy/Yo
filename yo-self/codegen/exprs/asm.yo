});
/// Generate C code for global_asm() (asm.ts:743-761).
generate_global_asm :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> String)({
  indent;
  if(is_target_wasm(context.base.target_info), {
    return(String.from("/* global_asm skipped: not supported on this target */"));
  });
