//! Codegen for `while(...)`.
//!
//! 1-to-1 port of `src/codegen/exprs/while.ts`, adapted to yo-self's
//! `ExprInfoTable` side-table for TypeScript `expr.$` metadata.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, BK_BEGIN, ast_expr_id } :: import("../../expr.yo");
{ TokenKind } :: import("../../lexer/token.yo");
{ random_id } :: import("../../evaluator/utils.yo");
{ CodegenContext } :: import("../context.yo");
{ call_gen_expr } :: import("./expr.yo");

expr_is_function_call_of :: (fn(expr : AstExpr, name : str, arity : usize) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, func_box, args, _, _) => match(
      func_box.*,
      .FnCall(_, _, _, _, _) => false,
      .Atom(_, tok) => ((tok.value.as_str() == name) && (args.len() == arity))
    )
  )
);

expr_is_assignment :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, func_box, args, is_infix, _) => match(
      func_box.*,
      .FnCall(_, _, _, _, _) => false,
      .Atom(_, tok) =>
        (
          (is_infix && (tok.kind == TokenKind.Operator)) &&
            ((tok.value.as_str() == "=") && (args.len() == usize(2)))
        )
    )
  )
);

append_step_assignment :: (
  fn(out : *(String), first : *(bool), assignment_expr : AstExpr, ctx : *(CodegenContext)) -> unit
)({
  match(
    assignment_expr,
    .Atom(_, _) => (),
    .FnCall(_, _, args, _, _) => match(
      args.get(usize(0)),
      .None => (),
      .Some(lhs) => match(
        args.get(usize(1)),
        .None => (),
        .Some(rhs) => match(
          call_gen_expr(lhs, ctx, String.new()),
          .None => (),
          .Some(lhs_code) => match(
            call_gen_expr(rhs, ctx, String.new()),
            .None => (),
            .Some(rhs_code) => {
              if(!(first.*), {
                out.*.push_str(", ");
              });
              out.*.push_string(lhs_code);
              out.*.push_str(" = ");
              out.*.push_string(rhs_code);
              first.* = false;
            }
          )
        )
      )
    )
  );
});

generate_step_expression :: (fn(step_expr : AstExpr, ctx : *(CodegenContext)) -> String)(
  cond(
    expr_is_function_call_of(step_expr, BK_BEGIN, match(step_expr,.Atom(_, _) => usize(0),.FnCall(_, _, args, _, _) => args.len())) => {
      assignments := String.new();
      first := true;
      match(
        step_expr,
        .Atom(_, _) => (),
        .FnCall(_, _, args, _, _) => {
          i := usize(0);
          while(runtime(i < args.len()), {
            match(
              args.get(i),
              .None => (),
              .Some(arg) => {
                if(expr_is_assignment(arg), {
                  append_step_assignment(&(assignments), &(first), arg, ctx);
                });
              }
            );
            i = (i + usize(1));
          });
        }
      );
      assignments
    },
    expr_is_assignment(step_expr) => {
      assignment := String.new();
      first := true;
      append_step_assignment(&(assignment), &(first), step_expr, ctx);
      assignment
    },
    true => match(
      call_gen_expr(step_expr, ctx, String.new()),
      .None => String.new(),
      .Some(code) => code
    )
  )
);

emit_loop_body_deferred_drops :: (fn(body_expr : AstExpr, indent : String, ctx : *(CodegenContext)) -> unit)({
  match(
    ctx.*.get_expr_info(ast_expr_id(body_expr)),
    .None => (),
    .Some(info) => match(
      info.deferred_drop_expressions,
      .None => (),
      .Some(drop_exprs) => {
        i := usize(0);
        while(runtime(i < drop_exprs.len()), {
          match(
            drop_exprs.get(i),
            .None => (),
            .Some(drop_expr) => match(
              call_gen_expr(drop_expr, ctx, indent),
              .None => (),
              .Some(drop_code) => if(drop_code.len() > usize(0), {
                ctx.*.emitter.emit_string(indent);
                ctx.*.emitter.emit_string(drop_code);
                ctx.*.emitter.emit_line(";");
              })
            )
          );
          i = (i + usize(1));
        });
      }
    )
  );
});

generate_loop_body :: (fn(body_expr : AstExpr, indent : String, ctx : *(CodegenContext)) -> unit)({
  if(expr_is_function_call_of(body_expr, BK_BEGIN, match(body_expr,.Atom(_, _) => usize(0),.FnCall(_, _, args, _, _) => args.len())), {
    match(
      body_expr,
      .Atom(_, _) => (),
      .FnCall(_, _, args, _, _) => {
        i := usize(0);
        while(runtime(i < args.len()), {
          match(
            args.get(i),
            .None => (),
            .Some(arg) => match(
              call_gen_expr(arg, ctx, indent),
              .None => (),
              .Some(arg_code) => if(arg_code.len() > usize(0), {
                ctx.*.emitter.emit_string(indent);
                ctx.*.emitter.emit_string(arg_code);
                ctx.*.emitter.emit_line(";");
              })
            )
          );
          i = (i + usize(1));
        });
      }
    );
    emit_loop_body_deferred_drops(body_expr, indent, ctx);
  }, {
    match(
      call_gen_expr(body_expr, ctx, indent),
      .None => (),
      .Some(body_code) => if(body_code.len() > usize(0), {
        ctx.*.emitter.emit_string(indent);
        ctx.*.emitter.emit_string(body_code);
        ctx.*.emitter.emit_line(";");
      })
    );
  });
});

strip_comptime_condition :: (fn(raw_condition_expr : AstExpr) -> AstExpr)(
  cond(
    (expr_is_function_call_of(raw_condition_expr, "comptime", usize(1)) || expr_is_function_call_of(raw_condition_expr, "runtime", usize(1))) => match(
      raw_condition_expr,
      .Atom(_, _) => raw_condition_expr,
      .FnCall(_, _, args, _, _) => match(
        args.get(usize(0)),
        .None => raw_condition_expr,
        .Some(inner) => inner
      )
    ),
    true => raw_condition_expr
  )
);

fresh_loop_label :: (fn(prefix : str) -> String)({
  out := String.from(prefix);
  out.push_string(random_id(String.from("loop")));
  out
});

generate_comptime_unrolled_bodies :: (
  fn(call_expr : AstExpr, indent : String, ctx : *(CodegenContext)) -> bool
)(
  match(
    ctx.*.get_expr_info(ast_expr_id(call_expr)),
    .None => false,
    .Some(info) => match(
      info.comptime_unrolled_bodies,
      .None => false,
      .Some(bodies) => {
        i := usize(0);
        while(runtime(i < bodies.len()), {
          match(
            bodies.get(i),
            .None => (),
            .Some(body) => generate_loop_body(body, indent, ctx)
          );
          i = (i + usize(1));
        });
        true
      }
    )
  )
);

generate_while_loop :: (
  fn(call_expr : AstExpr, args : ArrayList(AstExpr), ctx : *(CodegenContext), indent : String) -> Option(String)
)({
  if(generate_comptime_unrolled_bodies(call_expr, indent, ctx), {
    return(Option(String).Some(String.new()));
  });
  cond(
    (args.len() == usize(2)) => match(
      args.get(usize(0)),
      .None => Option(String).Some(String.new()),
      .Some(raw_condition_expr) => match(
        args.get(usize(1)),
        .None => Option(String).Some(String.new()),
        .Some(body_expr) => {
          condition_expr := strip_comptime_condition(raw_condition_expr);
          saved_loop_label := ctx.*.current_loop_label;
          loop_label := fresh_loop_label("loop_");
          ctx.*.current_loop_label = loop_label;
          ctx.*.emitter.emit_string(indent);
          ctx.*.emitter.emit_line("while (true) {");
          condition_code := match(
            call_gen_expr(condition_expr, ctx, String.from(indent.as_str()) + String.from("  ")),
            .None => String.from("0"),
            .Some(code) => code
          );
          ctx.*.emitter.emit_string(indent);
          ctx.*.emitter.emit("  if (!(");
          ctx.*.emitter.emit_string(condition_code);
          ctx.*.emitter.emit_line(")) {");
          ctx.*.emitter.emit_string(indent);
          ctx.*.emitter.emit_line("    break;");
          ctx.*.emitter.emit_string(indent);
          ctx.*.emitter.emit_line("  }");
          generate_loop_body(body_expr, String.from(indent.as_str()) + String.from("  "), ctx);
          ctx.*.emitter.emit_string(indent);
          ctx.*.emitter.emit_line("}");
          ctx.*.emitter.emit_string(indent);
          ctx.*.emitter.emit_string(loop_label);
          ctx.*.emitter.emit_line(":;");
          ctx.*.current_loop_label = saved_loop_label;
          Option(String).Some(String.new())
        }
      )
    ),
    (args.len() == usize(3)) => match(
      args.get(usize(0)),
      .None => Option(String).Some(String.new()),
      .Some(raw_condition_expr3) => match(
        args.get(usize(1)),
        .None => Option(String).Some(String.new()),
        .Some(step_expr) => match(
          args.get(usize(2)),
          .None => Option(String).Some(String.new()),
          .Some(body_expr) => {
            condition_expr := strip_comptime_condition(raw_condition_expr3);
            saved_loop_label := ctx.*.current_loop_label;
            saved_continue_label := ctx.*.current_continue_label;
            loop_label := fresh_loop_label("loop_");
            continue_label := fresh_loop_label("continue_");
            ctx.*.current_loop_label = loop_label;
            ctx.*.current_continue_label = continue_label;
            ctx.*.emitter.emit_string(indent);
            ctx.*.emitter.emit_line("while (true) {");
            condition_code := match(
              call_gen_expr(condition_expr, ctx, String.from(indent.as_str()) + String.from("  ")),
              .None => String.from("0"),
              .Some(code) => code
            );
            ctx.*.emitter.emit_string(indent);
            ctx.*.emitter.emit("  if (!(");
            ctx.*.emitter.emit_string(condition_code);
            ctx.*.emitter.emit_line(")) {");
            ctx.*.emitter.emit_string(indent);
            ctx.*.emitter.emit_line("    break;");
            ctx.*.emitter.emit_string(indent);
            ctx.*.emitter.emit_line("  }");
            generate_loop_body(body_expr, String.from(indent.as_str()) + String.from("  "), ctx);
            ctx.*.emitter.emit_string(indent);
            ctx.*.emitter.emit_string(continue_label);
            ctx.*.emitter.emit_line(":;");
            step_code := generate_step_expression(step_expr, ctx);
            ctx.*.emitter.emit_string(indent);
            ctx.*.emitter.emit("  ");
            ctx.*.emitter.emit_string(step_code);
            ctx.*.emitter.emit_line(";");
            ctx.*.emitter.emit_string(indent);
            ctx.*.emitter.emit_line("}");
            ctx.*.emitter.emit_string(indent);
            ctx.*.emitter.emit_string(loop_label);
            ctx.*.emitter.emit_line(":;");
            ctx.*.current_loop_label = saved_loop_label;
            ctx.*.current_continue_label = saved_continue_label;
            Option(String).Some(String.new())
          }
        )
      )
    ),
    true => {
      ctx.*.emitter.emit_string(indent);
      ctx.*.emitter.emit("/* Error: while loop expects 2 or 3 arguments, got ");
      ctx.*.emitter.emit_string(args.len().to_string());
      ctx.*.emitter.emit_line(" */");
      Option(String).Some(String.new())
    }
  )
});

export(
  generate_step_expression,
  generate_loop_body,
  generate_while_loop,
  strip_comptime_condition,
  expr_is_function_call_of
);
