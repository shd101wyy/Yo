//! Codegen for anonymous tuple values.
//!
//! 1-to-1 port of `src/codegen/exprs/tuple-fn.ts` (`generateAnonymousTuple`),
//! adapted to yo-self's `ExprInfoTable` side-table for TypeScript `expr.$`
//! metadata.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_id, ast_expr_is_fn_call } :: import("../../expr.yo");
{ ExprInfo } :: import("../../expr_info.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_unit_type } :: import("../../types/guards.yo");
{ type_to_string } :: import("../../types/string.yo");
{ CodegenContext } :: import("../context.yo");
{ call_gen_expr } :: import("./expr.yo");
{
  sanitize_for_c_identifier,
  sanitize_for_c_identifier_str,
  get_type_string_opt,
  get_variable_type_string_opt_str,
  format_indented_stmt,
  format_typed_init_line
} :: import("../utils/index.yo");
// `tuple_variable_type_string` was a local divergence — its body
// is the canonical `get_variable_type_string_opt_str` in utils.yo.
// Callers are migrated to use the canonical helper directly.
/// Format an anonymous tuple compound literal:
///   `(<c_name>){ <args_list> }`
///
/// `args_list` is the pre-joined `._0 = a, ._1 = b, …` payload. Pure
/// string composition — mirrors the inline build of `tupleValue` in
/// TS `generateAnonymousTuple`.
format_tuple_compound_literal :: (fn(c_name : String, args_list : String) -> String)({
  s := String.from("(");
  s.push_string(c_name);
  s.push_str("){ ");
  s.push_string(args_list);
  s.push_str(" }");
  s
});
/// Format a single tuple-field designated initializer: `._<i> = <value>`.
/// Used by `tuple_args_to_c` / `tuple_args_to_c_with_deferred_dup` while
/// building the comma-separated argument list. Pure string composition.
format_tuple_field_assignment :: (fn(index : usize, value_code : String) -> String)({
  s := String.from("._");
  s.push_string(index.to_string());
  s.push_str(" = ");
  s.push_string(value_code);
  s
});
// `format_tuple_indented_stmt` was a local divergence — body identical
// to the canonical `format_indented_stmt` in `codegen/utils/index.yo`.
// Re-exported as an alias for backward compatibility with the test
// import; new callers should import `format_indented_stmt` directly.
format_tuple_indented_stmt :: (fn(indent : String, code : String) -> String)(
  format_indented_stmt(indent, code)
);
// `format_tuple_temp_init` was a local divergence — body identical to
// the canonical `format_typed_init_line` in `codegen/utils/index.yo`.
// Re-exported as an alias for backward compatibility with the test
// import; new callers should import `format_typed_init_line` directly.
format_tuple_temp_init :: (
  fn(indent : String, type_and_name : String, value_code : String) -> String
)(
  format_typed_init_line(indent, type_and_name, value_code)
);
/// If an argument has deferred dup expressions, emit them and use the first
/// dup expression's temp variable as the final field value, matching the TS
/// handler's `generateDeferredDupExpressions(...); return dupExpr.$.variableName`.
tuple_apply_deferred_dup :: (
  fn(arg : AstExpr, arg_code : String, ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    ctx.get_expr_info(ast_expr_id(arg)),
    .None => Option(String).Some(arg_code),
    .Some(info) => match(
      info.deferred_dup_expressions,
      .None => Option(String).Some(arg_code),
      .Some(dups) => cond(
        (dups.len() == usize(0)) => Option(String).Some(arg_code),
        true => {
          (i : usize) = usize(0);
          (ok : bool) = true;
          while((i < dups.len()) && ok, {
            match(
              dups.get(i),
              .None => {
                ok = false;
              },
              .Some(dup_expr) => match(
                call_gen_expr(dup_expr, ctx, indent),
                .None => {
                  ok = false;
                },
                .Some(dup_code) => ctx.emitter.emit_string_line(
                  format_tuple_indented_stmt(indent, dup_code)
                )
              )
            );
            i = (i + usize(1));
          });
          cond(
            (!(ok)) => Option(String).None,
            true => match(
              dups.get(usize(0)),
              .None => Option(String).Some(arg_code),
              .Some(first_dup) => cond(
                ast_expr_is_fn_call(first_dup) => match(
                  ctx.get_expr_info(ast_expr_id(first_dup)),
                  .None => Option(String).Some(arg_code),
                  .Some(dup_info) => match(
                    dup_info.variable_name,
                    .None => Option(String).Some(arg_code),
                    .Some(vn) => Option(String).Some(sanitize_for_c_identifier(vn))
                  )
                ),
                true => Option(String).Some(arg_code)
              )
            )
          )
        }
      )
    )
  )
);

tuple_args_to_c_with_deferred_dup :: (
  fn(args : ArrayList(AstExpr), ctx : CodegenContext, indent : String) -> Option(String)
)({
  out := String.new();
  (i : usize) = usize(0);
  (ok : bool) = true;
  while((i < args.len()) && ok, {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg) => match(
        call_gen_expr(arg, ctx, indent),
        .None => {
          ok = false;
        },
        .Some(arg_code) => match(
          tuple_apply_deferred_dup(arg, arg_code, ctx, indent),
          .None => {
            ok = false;
          },
          .Some(final_arg_value) => {
            if(i > usize(0), {
              out.push_str(", ");
            });
            out.push_string(format_tuple_field_assignment(i, final_arg_value));
          }
        )
      )
    );
    i = (i + usize(1));
  });
  cond(ok => Option(String).Some(out), true => Option(String).None)
});

tuple_args_to_c :: (
  fn(args : ArrayList(AstExpr), ctx : CodegenContext, indent : String) -> Option(String)
)({
  out := String.new();
  (i : usize) = usize(0);
  (ok : bool) = true;
  while((i < args.len()) && ok, {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg) => match(
        call_gen_expr(arg, ctx, indent),
        .None => {
          ok = false;
        },
        .Some(arg_code) => {
          if(i > usize(0), {
            out.push_str(", ");
          });
          out.push_string(format_tuple_field_assignment(i, arg_code));
        }
      )
    );
    i = (i + usize(1));
  });
  cond(ok => Option(String).Some(out), true => Option(String).None)
});

tuple_value_or_temp :: (
  fn(
    tuple_ty : TypeValue,
    c_name : String,
    args_list : String,
    temp_var : Option(String),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  tuple_value := format_tuple_compound_literal(c_name, args_list);
  match(
    temp_var,
    .None => Option(String).Some(tuple_value),
    .Some(tv) => cond(
      is_unit_type(tuple_ty) => Option(String).Some(String.from("")),
      true => match(
        get_variable_type_string_opt_str(tuple_ty, tv.as_str(), ctx),
        .None => Option(String).Some(tuple_value),
        .Some(var_type_and_name) => {
          ctx.emitter.emit_string_line(
            format_tuple_temp_init(indent, var_type_and_name, tuple_value)
          );
          Option(String).Some(sanitize_for_c_identifier(tv))
        }
      )
    )
  )
});

/// Generate C code for an anonymous tuple call.
///
/// Returns `.None` when no metadata is attached, allowing `exprs.yo` to fall
/// back to its older AST-only tuple lowering during the transition.
generate_anonymous_tuple :: (
  fn(
    call_expr : AstExpr,
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)(
  match(
    ctx.get_expr_info(ast_expr_id(call_expr)),
    .None => cond(
      (args.len() == usize(0)) => Option(String).Some(String.from("")),
      true => Option(String).None
    ),
    .Some(info) => match(
      get_type_string_opt(info.ty, ctx),
      .None => cond(
        (args.len() == usize(0)) => Option(String).Some(String.from("")),
        true => {
          err := String.from("/* Error: tuple type not found - typeId: ");
          err.push_string(type_to_string(info.ty));
          err.push_str(" */");
          Option(String).Some(err)
        }
      ),
      .Some(c_name) => match(
        info.runtime_arg_exprs_in_order,
        .Some(runtime_args) => match(
          tuple_args_to_c_with_deferred_dup(runtime_args, ctx, indent),
          .None => Option(String).None,
          .Some(args_list) => tuple_value_or_temp(
            info.ty,
            c_name,
            args_list,
            info.variable_name,
            ctx,
            indent
          )
        ),
        .None => cond(
          (args.len() == usize(0)) => Option(String).Some(String.from("")),
          true => match(
            tuple_args_to_c(args, ctx, indent),
            .None => Option(String).None,
            .Some(args_list) => tuple_value_or_temp(
              info.ty,
              c_name,
              args_list,
              info.variable_name,
              ctx,
              indent
            )
          )
        )
      )
    )
  )
);

/// Emit an anonymous tuple literal using C99 compound-literal syntax with
/// `__typeof__` field types: `(struct { __typeof__(v0) _0; __typeof__(v1) _1; ... }){
/// ._0 = v0, ._1 = v1, ... }`.
///
/// Used by the bootstrap codegen for `tuple(...)` expressions where the
/// element types are not known up-front; `__typeof__` defers to the C
/// compiler. Moved here from `codegen/exprs.yo` in Phase A.8.4.
handle_tuple_literal :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  // Generate codes for each element first.
  arg_codes := ArrayList(String).new();
  (i : usize) = usize(0);
  (ok : bool) = true;
  while((i < n) && ok, {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(ae) => match(
        call_gen_expr(ae, ctx, indent),
        .None => {
          ok = false;
        },
        .Some(ac) => {
          arg_codes.push(ac);
        }
      )
    );
    i = (i + usize(1));
  });
  cond(
    (!(ok)) => Option(String).None,
    true => {
      result := String.from("(struct { ");
      // struct fields: __typeof__(val) _0; __typeof__(val) _1; …
      (j : usize) = usize(0);
      while(j < n, {
        match(
          arg_codes.get(j),
          .None => (),
          .Some(ac) => {
            result.push_str("__typeof__(");
            result.push_string(ac);
            result.push_str(") _");
            result.push_string(j.to_string());
            result.push_str("; ");
          }
        );
        j = (j + usize(1));
      });
      result.push_str("}){");
      // initialiser: ._0 = a, ._1 = b, …
      (k : usize) = usize(0);
      while(k < n, {
        match(
          arg_codes.get(k),
          .None => (),
          .Some(ac) => {
            if(k > usize(0), {
              result.push_str(", ");
            });
            result.push_str("._");
            result.push_string(k.to_string());
            result.push_str(" = ");
            result.push_string(ac);
          }
        );
        k = (k + usize(1));
      });
      result.push_str("}");
      Option(String).Some(result)
    }
  )
});
export(
  generate_anonymous_tuple,
  tuple_args_to_c,
  tuple_args_to_c_with_deferred_dup,
  tuple_apply_deferred_dup,
  format_tuple_compound_literal,
  format_tuple_field_assignment,
  format_tuple_indented_stmt,
  format_tuple_temp_init,
  handle_tuple_literal
);
