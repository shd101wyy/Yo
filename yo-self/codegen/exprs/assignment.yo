//! Partial 1-to-1 port of `src/codegen/exprs/assignment.ts`.
//!
//! Currently exposes two small pure-AST helpers used by the eventual
//! full `generate_assignment` handler:
//!
//!   - `is_initialization_assignment_lhs(lhs)` — true iff the LHS is
//!     a binding form `name : Type`, which the TS handler interprets
//!     as "declare + assign" rather than "mutate". Mirrors the TS
//!     check
//!         exprIsFunctionCall(lhs) && exprIsFunctionCallOf(lhs, ":", 2)
//!
//!   - `unwrap_initialization_lhs(lhs)` — when the LHS is the
//!     binding form, returns the inner declared variable expression
//!     (`name`); otherwise returns `lhs` unchanged. Mirrors the
//!     `lhs = lhs.args[0]!;` step.
//!
//! The full `generate_assignment` body (compile-time-skip detection,
//! module-level-variable handling, state-machine-slot routing, RC
//! drop/dup of the old value) waits on the function-cname registry,
//! state-machine variables, and a dispatch into the value-side
//! `generateExpr` — none of which is exposed in yo-self codegen.
open(import("std/string"));
{
  AstExpr,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  BK_COLON
} :: import("../../expr.yo");
/// True iff `lhs` is a 2-arg `:` call — the LHS shape used by
/// `lhs := rhs` initialisations. Mirrors TS's
///   `exprIsFunctionCall(lhs) && exprIsFunctionCallOf(lhs, ":", 2)`.
is_initialization_assignment_lhs :: (fn(lhs : AstExpr) -> bool)(
  ast_expr_is_fn_call_of(lhs, BK_COLON, Option(usize).Some(usize(2)))
);
/// If `lhs` is an initialisation `name : T`, return the `name`
/// sub-expression (the actual variable being assigned). Otherwise
/// return `lhs` unchanged.
///
/// Mirrors the `lhs = lhs.args[0]!` unwrap after the
/// `isInitialization` check in TS `generateAssignment`.
unwrap_initialization_lhs :: (fn(lhs : AstExpr) -> AstExpr)(
  cond(
    is_initialization_assignment_lhs(lhs) => match(
      lhs,
      .Atom(_, _) => lhs,
      .FnCall({ args }) => match(
        args.get(usize(0)),
        .None => lhs,
        .Some(inner) => inner
      )
    ),
    true => lhs
  )
);
export(
  is_initialization_assignment_lhs,
  unwrap_initialization_lhs
);
