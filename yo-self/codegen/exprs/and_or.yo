//! Codegen for `&&` and `||`.
//!
//! 1-to-1 port of `src/codegen/exprs/and-or.ts`, adapted to yo-self's
//! `ExprInfoTable` side-table for TypeScript `expr.$` metadata.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_id } :: import("../../expr.yo");
{ EvalValue } :: import("../../evaluator/value.yo");
{ CodegenContext } :: import("../context.yo");
{ call_gen_expr } :: import("./expr.yo");

expr_bool_value :: (fn(expr : AstExpr, ctx : *(CodegenContext)) -> Option(bool))(
  match(
    ctx.*.get_expr_info(ast_expr_id(expr)),
    .None => Option(bool).None,
    .Some(info) => match(
      info.value,
      .None => Option(bool).None,
      .Some(value) => match(value,.BoolVal(b) => Option(bool).Some(b), _ => Option(bool).None)
    )
  )
);

expr_may_have_side_effects :: (fn(expr : AstExpr, ctx : *(CodegenContext)) -> bool)(
  match(
    ctx.*.get_expr_info(ast_expr_id(expr)),
    .Some(info) => cond(
      info.variable_name.is_some() => true,
      info.value.is_some() => false,
      true => false
    ),
    .None => false
  ) ||
    match(
      expr,
      .Atom(_, _) => false,
      .FnCall(_, func_box, args, _, _) => {
        found := false;
        i := usize(0);
        while(runtime((i < args.len()) && (!(found))), {
          match(
            args.get(i),
            .None => (),
            .Some(arg) => {
              found = recur(arg, ctx);
            }
          );
          i = (i + usize(1));
        });
        cond(found => true, true => recur(func_box.*, ctx))
      }
    )
);

collect_runtime_args_for_and :: (
  fn(args : ArrayList(AstExpr), ctx : *(CodegenContext), out : *(ArrayList(AstExpr))) -> Option(String)
)({
  i := usize(0);
  while(runtime(i < args.len()), {
    match(
      args.get(i),
      .None => (),
      .Some(arg) => match(
        expr_bool_value(arg, ctx),
        .Some(value) => {
          if(!(value), {
            return(Option(String).Some(String.from("false")));
          });
        },
        .None => {
          out.*.push(arg);
        }
      )
    );
    i = (i + usize(1));
  });
  Option(String).None
});

collect_runtime_args_for_or :: (
  fn(args : ArrayList(AstExpr), ctx : *(CodegenContext), out : *(ArrayList(AstExpr))) -> Option(String)
)({
  i := usize(0);
  while(runtime(i < args.len()), {
    match(
      args.get(i),
      .None => (),
      .Some(arg) => match(
        expr_bool_value(arg, ctx),
        .Some(value) => {
          if(value, {
            return(Option(String).Some(String.from("true")));
          });
        },
        .None => {
          out.*.push(arg);
        }
      )
    );
    i = (i + usize(1));
  });
  Option(String).None
});

runtime_args_need_if_chain :: (
  fn(args : ArrayList(AstExpr), ctx : *(CodegenContext)) -> bool
)({
  found := false;
  i := usize(1);
  while(runtime((i < args.len()) && (!(found))), {
    match(
      args.get(i),
      .None => (),
      .Some(arg) => {
        found = expr_may_have_side_effects(arg, ctx);
      }
    );
    i = (i + usize(1));
  });
  found
});

join_runtime_args :: (
  fn(args : ArrayList(AstExpr), separator : str, indent : String, ctx : *(CodegenContext)) -> Option(String)
)({
  out := String.from("(");
  ok := true;
  i := usize(0);
  while(runtime((i < args.len()) && ok), {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg) => match(
        call_gen_expr(arg, ctx, indent),
        .None => {
          ok = false;
        },
        .Some(code) => {
          if(i > usize(0), {
            out.push_str(separator);
          });
          out.push_string(code);
        }
      )
    );
    i = (i + usize(1));
  });
  out.push_str(")");
  cond(ok => Option(String).Some(out), true => Option(String).None)
});

indent_plus_two :: (fn(indent : String) -> String)(String.from(indent.as_str()) + String.from("  "));

indent_minus_two :: (fn(indent : String) -> String)(
  cond(
    (indent.len() >= usize(2)) => indent.substring(usize(0), indent.len() - usize(2)),
    true => String.new()
  )
);

emit_if_chain_for_and :: (
  fn(args : ArrayList(AstExpr), indent : String, ctx : *(CodegenContext)) -> Option(String)
)({
  sc_var := ctx.*.fresh_temp();
  ctx.*.emitter.emit_string(indent);
  ctx.*.emitter.emit("bool ");
  ctx.*.emitter.emit_string(sc_var);
  ctx.*.emitter.emit_line(" = false;");
  current_indent := String.from(indent.as_str());
  i := usize(0);
  ok := true;
  while(runtime((i < args.len()) && ok), {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg) => match(
        call_gen_expr(arg, ctx, current_indent),
        .None => {
          ok = false;
        },
        .Some(arg_code) => cond(
          (i < (args.len() - usize(1))) => {
            ctx.*.emitter.emit_string(current_indent);
            ctx.*.emitter.emit("if (");
            ctx.*.emitter.emit_string(arg_code);
            ctx.*.emitter.emit_line(") {");
            current_indent = indent_plus_two(current_indent);
          },
          true => {
            ctx.*.emitter.emit_string(current_indent);
            ctx.*.emitter.emit_string(sc_var);
            ctx.*.emitter.emit(" = ");
            ctx.*.emitter.emit_string(arg_code);
            ctx.*.emitter.emit_line(";");
          }
        )
      )
    );
    i = (i + usize(1));
  });
  depth := cond((args.len() > usize(0)) => (args.len() - usize(1)), true => usize(0));
  j := usize(0);
  while(runtime(j < depth), {
    current_indent = indent_minus_two(current_indent);
    ctx.*.emitter.emit_string(current_indent);
    ctx.*.emitter.emit_line("}");
    j = (j + usize(1));
  });
  cond(ok => Option(String).Some(sc_var), true => Option(String).None)
});

emit_if_chain_for_or :: (
  fn(args : ArrayList(AstExpr), indent : String, ctx : *(CodegenContext)) -> Option(String)
)({
  sc_var := ctx.*.fresh_temp();
  ctx.*.emitter.emit_string(indent);
  ctx.*.emitter.emit("bool ");
  ctx.*.emitter.emit_string(sc_var);
  ctx.*.emitter.emit_line(" = true;");
  current_indent := String.from(indent.as_str());
  i := usize(0);
  ok := true;
  while(runtime((i < args.len()) && ok), {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg) => match(
        call_gen_expr(arg, ctx, current_indent),
        .None => {
          ok = false;
        },
        .Some(arg_code) => cond(
          (i < (args.len() - usize(1))) => {
            ctx.*.emitter.emit_string(current_indent);
            ctx.*.emitter.emit("if (!(");
            ctx.*.emitter.emit_string(arg_code);
            ctx.*.emitter.emit_line(")) {");
            current_indent = indent_plus_two(current_indent);
          },
          true => {
            ctx.*.emitter.emit_string(current_indent);
            ctx.*.emitter.emit_string(sc_var);
            ctx.*.emitter.emit(" = ");
            ctx.*.emitter.emit_string(arg_code);
            ctx.*.emitter.emit_line(";");
          }
        )
      )
    );
    i = (i + usize(1));
  });
  depth := cond((args.len() > usize(0)) => (args.len() - usize(1)), true => usize(0));
  j := usize(0);
  while(runtime(j < depth), {
    current_indent = indent_minus_two(current_indent);
    ctx.*.emitter.emit_string(current_indent);
    ctx.*.emitter.emit_line("}");
    j = (j + usize(1));
  });
  cond(ok => Option(String).Some(sc_var), true => Option(String).None)
});

generate_op_and :: (
  fn(args : ArrayList(AstExpr), indent : String, ctx : *(CodegenContext)) -> Option(String)
)(
  cond(
    (args.len() == usize(0)) => Option(String).Some(String.from("true")),
    (args.len() == usize(1)) => match(args.get(usize(0)),.None => Option(String).None,.Some(arg) => call_gen_expr(arg, ctx, indent)),
    true => {
      runtime_args := ArrayList(AstExpr).new();
      short_circuit := collect_runtime_args_for_and(args, ctx, &(runtime_args));
      match(
        short_circuit,
        .Some(value) => Option(String).Some(value),
        .None => cond(
          (runtime_args.len() == usize(0)) => Option(String).Some(String.from("true")),
          (runtime_args.len() == usize(1)) => match(runtime_args.get(usize(0)),.None => Option(String).None,.Some(arg2) => call_gen_expr(arg2, ctx, indent)),
          runtime_args_need_if_chain(runtime_args, ctx) => emit_if_chain_for_and(runtime_args, indent, ctx),
          true => join_runtime_args(runtime_args, " && ", indent, ctx)
        )
      )
    }
  )
);

generate_op_or :: (
  fn(args : ArrayList(AstExpr), indent : String, ctx : *(CodegenContext)) -> Option(String)
)(
  cond(
    (args.len() == usize(0)) => Option(String).Some(String.from("false")),
    (args.len() == usize(1)) => match(args.get(usize(0)),.None => Option(String).None,.Some(arg) => call_gen_expr(arg, ctx, indent)),
    true => {
      runtime_args := ArrayList(AstExpr).new();
      short_circuit := collect_runtime_args_for_or(args, ctx, &(runtime_args));
      match(
        short_circuit,
        .Some(value) => Option(String).Some(value),
        .None => cond(
          (runtime_args.len() == usize(0)) => Option(String).Some(String.from("false")),
          (runtime_args.len() == usize(1)) => match(runtime_args.get(usize(0)),.None => Option(String).None,.Some(arg2) => call_gen_expr(arg2, ctx, indent)),
          runtime_args_need_if_chain(runtime_args, ctx) => emit_if_chain_for_or(runtime_args, indent, ctx),
          true => join_runtime_args(runtime_args, " || ", indent, ctx)
        )
      )
    }
  )
);

export(generate_op_and, generate_op_or, expr_bool_value, expr_may_have_side_effects);
