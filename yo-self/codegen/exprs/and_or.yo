//! Codegen for `&&` and `||`.
//!
//! 1-to-1 port of `src/codegen/exprs/and-or.ts`, adapted to yo-self's
//! `ExprInfoTable` side-table for TypeScript `expr.$` metadata.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_id } :: import("../../expr.yo");
{ EvalValue } :: import("../../value.yo");
{ CodegenContext } :: import("../context.yo");
{
  indent_plus_two,
  indent_minus_two,
  format_typed_init_line,
  format_indented_close_brace,
  format_if_open,
  format_if_negate_open
} :: import("../utils/index.yo");
{ call_gen_expr } :: import("./expr.yo");

expr_bool_value :: (fn(expr : AstExpr, ctx : CodegenContext) -> Option(bool))(
  match(
    ctx.get_expr_info(ast_expr_id(expr)),
    .None => Option(bool).None,
    .Some(info) => match(
      info.value,
      .None => Option(bool).None,
      .Some(value) => match(value,.BoolVal(b) => Option(bool).Some(b), _ => Option(bool).None)
    )
  )
);

expr_may_have_side_effects :: (fn(expr : AstExpr, ctx : CodegenContext) -> bool)(
  match(
    ctx.get_expr_info(ast_expr_id(expr)),
    .Some(info) => cond(
      info.variable_name.is_some() => true,
      info.value.is_some() => false,
      true => false
    ),
    .None => false
  ) ||
    match(
      expr,
      .Atom(_, _) => false,
      .FnCall(_, func_box, args, _, _) => {
        found := false;
        i := usize(0);
        while((i < args.len()) && (!(found)), {
          match(
            args.get(i),
            .None => (),
            .Some(arg) => {
              found = recur(arg, ctx);
            }
          );
          i = (i + usize(1));
        });
        cond(found => true, true => recur(func_box.*, ctx))
      }
    )
);

collect_runtime_args_for_and :: (
  fn(args : ArrayList(AstExpr), ctx : CodegenContext, out : ArrayList(AstExpr)) -> Option(String)
)({
  i := usize(0);
  while(i < args.len(), {
    match(
      args.get(i),
      .None => (),
      .Some(arg) => match(
        expr_bool_value(arg, ctx),
        .Some(value) => {
          if(!(value), {
            return(Option(String).Some(String.from("false")));
          });
        },
        .None => {
          out.push(arg);
        }
      )
    );
    i = (i + usize(1));
  });
  Option(String).None
});

collect_runtime_args_for_or :: (
  fn(args : ArrayList(AstExpr), ctx : CodegenContext, out : ArrayList(AstExpr)) -> Option(String)
)({
  i := usize(0);
  while(i < args.len(), {
    match(
      args.get(i),
      .None => (),
      .Some(arg) => match(
        expr_bool_value(arg, ctx),
        .Some(value) => {
          if(value, {
            return(Option(String).Some(String.from("true")));
          });
        },
        .None => {
          out.push(arg);
        }
      )
    );
    i = (i + usize(1));
  });
  Option(String).None
});

runtime_args_need_if_chain :: (
  fn(args : ArrayList(AstExpr), ctx : CodegenContext) -> bool
)({
  found := false;
  i := usize(1);
  while((i < args.len()) && (!(found)), {
    match(
      args.get(i),
      .None => (),
      .Some(arg) => {
        found = expr_may_have_side_effects(arg, ctx);
      }
    );
    i = (i + usize(1));
  });
  found
});

join_runtime_args :: (
  fn(args : ArrayList(AstExpr), separator : str, indent : String, ctx : CodegenContext) -> Option(String)
)({
  out := String.from("(");
  ok := true;
  i := usize(0);
  while((i < args.len()) && ok, {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg) => match(
        call_gen_expr(arg, ctx, indent),
        .None => {
          ok = false;
        },
        .Some(code) => {
          if(i > usize(0), {
            out.push_str(separator);
          });
          out.push_string(code);
        }
      )
    );
    i = (i + usize(1));
  });
  out.push_str(")");
  cond(ok => Option(String).Some(out), true => Option(String).None)
});

// `indent_plus_two` / `indent_minus_two` moved to `codegen/utils/index.yo`
// for sharing across handlers — re-imported at the top of this file.
/// Format a bool short-circuit init line:
///   `<indent>bool <var> = <value>;`
/// Used at the top of both `emit_if_chain_for_and` (with `false`) and
/// `emit_if_chain_for_or` (with `true`). Pure string composition.
format_and_or_bool_init :: (fn(indent : String, var : String, value : str) -> String)(
  // Compose via canonical typed-init helper:
  //   indent + ("bool " + var) + " = " + value + ";"
  format_typed_init_line(
    indent,
    String.from("bool ") + var,
    String.from(value)
  )
);
// `format_and_or_if_open` / `format_and_or_if_negate_open` were local
// divergences — bodies identical to canonical helpers
// `format_if_open` / `format_if_negate_open` in
// `codegen/utils/index.yo`. Re-exported as aliases for backward
// compatibility with the test imports.
format_and_or_if_open :: (fn(indent : String, cond_code : String) -> String)(
  format_if_open(indent, cond_code)
);
format_and_or_if_negate_open :: (fn(indent : String, cond_code : String) -> String)(
  format_if_negate_open(indent, cond_code)
);
// `format_and_or_assignment` and `format_and_or_close_brace` were local
// divergences — bodies identical to canonical helpers in
// `codegen/utils/index.yo`. Re-exported as aliases for backward
// compatibility with the test imports.
format_and_or_assignment :: (fn(indent : String, var : String, value_code : String) -> String)(
  format_typed_init_line(indent, var, value_code)
);
format_and_or_close_brace :: (fn(indent : String) -> String)(
  format_indented_close_brace(indent)
);

emit_if_chain_for_and :: (
  fn(args : ArrayList(AstExpr), indent : String, ctx : CodegenContext) -> Option(String)
)({
  sc_var := ctx.fresh_temp();
  ctx.emitter.emit_string_line(format_and_or_bool_init(indent, sc_var, "false"));
  current_indent := indent.clone();
  i := usize(0);
  ok := true;
  while((i < args.len()) && ok, {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg) => match(
        call_gen_expr(arg, ctx, current_indent),
        .None => {
          ok = false;
        },
        .Some(arg_code) => cond(
          (i < (args.len() - usize(1))) => {
            ctx.emitter.emit_string_line(format_and_or_if_open(current_indent, arg_code));
            current_indent = indent_plus_two(current_indent);
          },
          true => ctx.emitter.emit_string_line(
            format_and_or_assignment(current_indent, sc_var, arg_code)
          )
        )
      )
    );
    i = (i + usize(1));
  });
  depth := cond((args.len() > usize(0)) => (args.len() - usize(1)), true => usize(0));
  j := usize(0);
  while(j < depth, {
    current_indent = indent_minus_two(current_indent);
    ctx.emitter.emit_string_line(format_and_or_close_brace(current_indent));
    j = (j + usize(1));
  });
  cond(ok => Option(String).Some(sc_var), true => Option(String).None)
});

emit_if_chain_for_or :: (
  fn(args : ArrayList(AstExpr), indent : String, ctx : CodegenContext) -> Option(String)
)({
  sc_var := ctx.fresh_temp();
  ctx.emitter.emit_string_line(format_and_or_bool_init(indent, sc_var, "true"));
  current_indent := indent.clone();
  i := usize(0);
  ok := true;
  while((i < args.len()) && ok, {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg) => match(
        call_gen_expr(arg, ctx, current_indent),
        .None => {
          ok = false;
        },
        .Some(arg_code) => cond(
          (i < (args.len() - usize(1))) => {
            ctx.emitter.emit_string_line(
              format_and_or_if_negate_open(current_indent, arg_code)
            );
            current_indent = indent_plus_two(current_indent);
          },
          true => ctx.emitter.emit_string_line(
            format_and_or_assignment(current_indent, sc_var, arg_code)
          )
        )
      )
    );
    i = (i + usize(1));
  });
  depth := cond((args.len() > usize(0)) => (args.len() - usize(1)), true => usize(0));
  j := usize(0);
  while(j < depth, {
    current_indent = indent_minus_two(current_indent);
    ctx.emitter.emit_string_line(format_and_or_close_brace(current_indent));
    j = (j + usize(1));
  });
  cond(ok => Option(String).Some(sc_var), true => Option(String).None)
});

generate_op_and :: (
  fn(args : ArrayList(AstExpr), indent : String, ctx : CodegenContext) -> Option(String)
)(
  cond(
    (args.len() == usize(0)) => Option(String).Some(String.from("true")),
    (args.len() == usize(1)) => match(args.get(usize(0)),.None => Option(String).None,.Some(arg) => call_gen_expr(arg, ctx, indent)),
    true => {
      runtime_args := ArrayList(AstExpr).new();
      short_circuit := collect_runtime_args_for_and(args, ctx, runtime_args);
      match(
        short_circuit,
        .Some(value) => Option(String).Some(value),
        .None => cond(
          (runtime_args.len() == usize(0)) => Option(String).Some(String.from("true")),
          (runtime_args.len() == usize(1)) => match(runtime_args.get(usize(0)),.None => Option(String).None,.Some(arg2) => call_gen_expr(arg2, ctx, indent)),
          runtime_args_need_if_chain(runtime_args, ctx) => emit_if_chain_for_and(runtime_args, indent, ctx),
          true => join_runtime_args(runtime_args, " && ", indent, ctx)
        )
      )
    }
  )
);

generate_op_or :: (
  fn(args : ArrayList(AstExpr), indent : String, ctx : CodegenContext) -> Option(String)
)(
  cond(
    (args.len() == usize(0)) => Option(String).Some(String.from("false")),
    (args.len() == usize(1)) => match(args.get(usize(0)),.None => Option(String).None,.Some(arg) => call_gen_expr(arg, ctx, indent)),
    true => {
      runtime_args := ArrayList(AstExpr).new();
      short_circuit := collect_runtime_args_for_or(args, ctx, runtime_args);
      match(
        short_circuit,
        .Some(value) => Option(String).Some(value),
        .None => cond(
          (runtime_args.len() == usize(0)) => Option(String).Some(String.from("false")),
          (runtime_args.len() == usize(1)) => match(runtime_args.get(usize(0)),.None => Option(String).None,.Some(arg2) => call_gen_expr(arg2, ctx, indent)),
          runtime_args_need_if_chain(runtime_args, ctx) => emit_if_chain_for_or(runtime_args, indent, ctx),
          true => join_runtime_args(runtime_args, " || ", indent, ctx)
        )
      )
    }
  )
);

export(
  generate_op_and,
  generate_op_or,
  expr_bool_value,
  expr_may_have_side_effects,
  format_and_or_bool_init,
  format_and_or_if_open,
  format_and_or_if_negate_open,
  format_and_or_assignment,
  format_and_or_close_brace
);
