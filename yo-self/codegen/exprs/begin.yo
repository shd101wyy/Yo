//! Codegen for `begin(...)` blocks.
//!
//! 1-to-1 port of `src/codegen/exprs/begin.ts`, adapted to yo-self's
//! `ExprInfoTable` side-table for TypeScript `expr.$` metadata.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_id } :: import("../../expr.yo");
{ ExprInfo, has_any_control_flow } :: import("../../expr_info.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_unit_type } :: import("../../types/guards.yo");
{ is_temp_variable_name } :: import("../../evaluator/utils.yo");
{ CodegenContext } :: import("../context.yo");
{
  get_type_string_opt,
  indent_plus_two,
  format_typed_init_line,
  format_typed_var_name,
  format_typed_decl_line,
  format_indented_line,
  format_indented_stmt
} :: import("../utils/index.yo");
{ call_gen_expr } :: import("./expr.yo");
{ tuple_apply_deferred_dup } :: import("./tuple_fn.yo");

// `begin_indent_inner` was a local divergence — body identical to the
// canonical `indent_plus_two` in `codegen/utils/index.yo`. Callers
// migrated to use the canonical helper directly.
begin_indent_inner :: (fn(indent : String) -> String)(indent_plus_two(indent));
// `format_begin_temp_decl` was a local divergence — body identical to
// `format_typed_decl_line(indent, format_typed_var_name(type_name, var_name))`
// composed from canonical helpers in `codegen/utils/index.yo`.
// Re-exported as an alias for backward compatibility with the test
// import.
format_begin_temp_decl :: (
  fn(indent : String, type_name : String, var_name : String) -> String
)(
  format_typed_decl_line(indent, format_typed_var_name(type_name, var_name))
);
// `format_begin_assignment_line` was a local divergence — body identical
// to the canonical `format_typed_init_line` in `codegen/utils/index.yo`.
// Re-exported as an alias for backward compatibility with the test
// import.
format_begin_assignment_line :: (
  fn(indent : String, lhs : String, rhs : String) -> String
)(
  format_typed_init_line(indent, lhs, rhs)
);
/// Format the begin-block open header: `<indent>{ // begin block`.
/// Composed via `format_indented_line` for the literal block-open
/// shape.
format_begin_block_open :: (fn(indent : String) -> String)(
  format_indented_line(indent, "{ // begin block")
);

begin_emit_statement :: (fn(code : String, ctx : *(CodegenContext), indent : String) -> unit)({
  ctx.*.emitter.emit_string_line(format_indented_stmt(indent, code));
});

begin_expr_has_metadata :: (fn(expr : AstExpr, ctx : *(CodegenContext)) -> bool)(
  ctx.*.get_expr_info(ast_expr_id(expr)).is_some()
);

begin_should_emit_arg_code :: (
  fn(arg : AstExpr, arg_code : String, is_last_expr : bool, is_returning_value : bool, ctx : *(CodegenContext)) -> bool
)(
  cond(
    (arg_code.len() == usize(0)) => false,
    (is_last_expr && is_returning_value) => false,
    true => match(
      ctx.*.get_expr_info(ast_expr_id(arg)),
      .None => true,
      .Some(arg_info) => !(is_temp_variable_name(arg_info.env.module_path, arg_code))
    )
  )
);

begin_emit_deferred_drops :: (fn(info : ExprInfo, ctx : *(CodegenContext), indent : String) -> unit)({
  match(
    info.deferred_drop_expressions,
    .None => (),
    .Some(drop_exprs) => {
      i := usize(0);
      while(runtime(i < drop_exprs.len()), {
        match(
          drop_exprs.get(i),
          .None => (),
          .Some(drop_expr) => match(
            call_gen_expr(drop_expr, ctx, indent),
            .None => (),
            .Some(drop_code) => if(drop_code.len() > usize(0), {
              begin_emit_statement(drop_code, ctx, indent);
            })
          )
        );
        i = (i + usize(1));
      });
    }
  );
});

begin_generate_args_immediate :: (
  fn(
    args : ArrayList(AstExpr),
    value_type : TypeValue,
    block_info : ExprInfo,
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(ArrayList(String))
)({
  args_code := ArrayList(String).new();
  is_returning_value := (!(is_unit_type(value_type)) && !(has_any_control_flow(block_info.control_flow)));
  inner := begin_indent_inner(indent);
  i := usize(0);
  ok := true;
  stopped := false;
  while(runtime((i < args.len()) && (ok && (!(stopped)))), {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg) => match(
        ctx.*.get_expr_info(ast_expr_id(arg)),
        .None => {
          stopped = true;
        },
        .Some(arg_info) => match(
          call_gen_expr(arg, ctx, inner),
          .None => {
            ok = false;
          },
          .Some(result) => {
            args_code.push(result);
            is_last_expr := (i == (args.len() - usize(1)));
            if(begin_should_emit_arg_code(arg, result, is_last_expr, is_returning_value, ctx), {
              begin_emit_statement(result, ctx, inner);
            });
            if(has_any_control_flow(arg_info.control_flow), {
              stopped = true;
            });
          }
        )
      )
    );
    i = (i + usize(1));
  });
  cond(ok => Option(ArrayList(String)).Some(args_code), true => Option(ArrayList(String)).None)
});

begin_generate_statement_args :: (
  fn(args : ArrayList(AstExpr), ctx : *(CodegenContext), indent : String) -> Option(ArrayList(String))
)({
  args_code := ArrayList(String).new();
  inner := begin_indent_inner(indent);
  ok := true;
  i := usize(0);
  while(runtime((i < args.len()) && ok), {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg) => match(
        call_gen_expr(arg, ctx, inner),
        .None => {
          args_code.push(String.new());
        },
        .Some(arg_code) => {
          args_code.push(arg_code);
          if(arg_code.len() > usize(0), {
            begin_emit_statement(arg_code, ctx, inner);
          });
        }
      )
    );
    i = (i + usize(1));
  });
  cond(ok => Option(ArrayList(String)).Some(args_code), true => Option(ArrayList(String)).None)
});

begin_last_code :: (fn(args_code : ArrayList(String)) -> String)(
  cond(
    (args_code.len() == usize(0)) => String.new(),
    true => match(
      args_code.get(args_code.len() - usize(1)),
      .Some(code) => code,
      .None => String.new()
    )
  )
);

begin_apply_return_deferred_dup :: (
  fn(last_arg : AstExpr, last_arg_code : String, ctx : *(CodegenContext), indent : String) -> Option(String)
)(
  match(
    ctx.*.get_expr_info(ast_expr_id(last_arg)),
    .None => Option(String).Some(last_arg_code),
    .Some(last_info) => match(
      last_info.deferred_dup_expressions,
      .None => Option(String).Some(last_arg_code),
      .Some(dups) => cond(
        (dups.len() == usize(0)) => Option(String).Some(last_arg_code),
        true => tuple_apply_deferred_dup(last_arg, last_arg_code, ctx, indent)
      )
    )
  )
);

generate_begin :: (
  fn(call_expr : AstExpr, args : ArrayList(AstExpr), ctx : *(CodegenContext), indent : String) -> Option(String)
)(
  match(
    ctx.*.get_expr_info(ast_expr_id(call_expr)),
    .None => Option(String).None,
    .Some(info) => match(
      info.variable_name,
      .Some(temp_variable_name) => {
        value_type := info.ty;
        is_returning_value := (!(is_unit_type(value_type)) && !(has_any_control_flow(info.control_flow)));
        if(is_returning_value, {
          match(
            get_type_string_opt(value_type, ctx),
            .None => (),
            .Some(type_name) => ctx.*.emitter.emit_string_line(
              format_begin_temp_decl(indent, type_name, temp_variable_name)
            )
          );
        });
        ctx.*.emitter.emit_string_line(format_begin_block_open(indent));
        args_code_opt := begin_generate_args_immediate(args, value_type, info, ctx, indent);
        match(
          args_code_opt,
          .None => (),
          .Some(args_code) => if(is_returning_value && (args.len() > usize(0)), {
            match(
              args.get(args.len() - usize(1)),
              .None => (),
              .Some(last_arg) => {
                last_arg_code := begin_last_code(args_code);
                match(
                  begin_apply_return_deferred_dup(last_arg, last_arg_code, ctx, begin_indent_inner(indent)),
                  .None => (),
                  .Some(final_last_arg_code) => ctx.*.emitter.emit_string_line(
                    format_begin_assignment_line(
                      begin_indent_inner(indent),
                      temp_variable_name,
                      final_last_arg_code
                    )
                  )
                );
              }
            );
          })
        );
        begin_emit_deferred_drops(info, ctx, begin_indent_inner(indent));
        ctx.*.emitter.emit_string_line(format_indented_line(indent, "} // end begin block"));
        Option(String).Some(
          cond(
            (is_unit_type(value_type) || has_any_control_flow(info.control_flow)) => String.new(),
            true => temp_variable_name
          )
        )
      },
      .None => {
        ctx.*.emitter.emit_string_line(format_begin_block_open(indent));
        _args_code := begin_generate_statement_args(args, ctx, indent);
        begin_emit_deferred_drops(info, ctx, begin_indent_inner(indent));
        ctx.*.emitter.emit_string_line(format_indented_line(indent, "} // end begin block"));
        Option(String).Some(String.new())
      }
    )
  )
);

export(
  generate_begin,
  begin_expr_has_metadata,
  format_begin_temp_decl,
  format_begin_assignment_line,
  format_begin_block_open
);
