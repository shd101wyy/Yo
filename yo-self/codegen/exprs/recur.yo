//! Codegen for `recur(...)`.
//!
//! 1-to-1 port of `src/codegen/exprs/recur.ts`, adapted to yo-self's
//! `ExprInfoTable` side-table for TypeScript `expr.$` metadata.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_id, ast_expr_to_string } :: import("../../expr.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_unit_type } :: import("../../types/guards.yo");
{ CodegenContext } :: import("../context.yo");
{ call_gen_expr } :: import("./expr.yo");
{
  sanitize_for_c_identifier,
  get_type_string_opt,
  format_indented_stmt,
  format_typed_var_name,
  format_typed_init_line,
  format_c_function_call
} :: import("../utils/index.yo");
{ tuple_apply_deferred_dup } :: import("./tuple_fn.yo");

// `format_typed_temp_assignment` was a local divergence — body
// identical to `format_typed_init_line(indent, format_typed_var_name(c_type, name), value)`
// composed from the canonical helpers in `codegen/utils/index.yo`.
// Re-exported as an alias for backward compatibility with the test
// import.
format_typed_temp_assignment :: (
  fn(indent : String, c_type : String, name : String, value_code : String) -> String
)(
  format_typed_init_line(indent, format_typed_var_name(c_type, name), value_code)
);
// `format_c_function_call` moved to `codegen/utils/index.yo` for
// sharing across handlers. Imports updated at call sites.
// `format_indented_stmt_line` was a local divergence — body identical
// to the canonical `format_indented_stmt` in `codegen/utils/index.yo`.
// Re-exported as an alias for backward compatibility with the test
// import; new callers should import `format_indented_stmt` directly.
format_indented_stmt_line :: (fn(indent : String, code : String) -> String)(
  format_indented_stmt(indent, code)
);
recur_array_contains_string :: (fn(items : ArrayList(String), needle : String) -> bool)({
  found := false;
  i := usize(0);
  while((i < items.len()) && (!(found)), {
    match(
      items.get(i),
      .Some(item) => {
        found = (item == needle);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});

recur_args_to_c :: (
  fn(args : ArrayList(AstExpr), ctx : CodegenContext, indent : String) -> Option(String)
)({
  out := String.new();
  (i : usize) = usize(0);
  (ok : bool) = true;
  while((i < args.len()) && ok, {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg) => match(
        call_gen_expr(arg, ctx, indent),
        .None => {
          ok = false;
        },
        .Some(arg_code) => match(
          tuple_apply_deferred_dup(arg, arg_code, ctx, indent),
          .None => {
            ok = false;
          },
          .Some(final_arg_value) => {
            if(i > usize(0), {
              out.push_str(", ");
            });
            out.push_string(final_arg_value);
          }
        )
      )
    );
    i = (i + usize(1));
  });
  cond(ok => Option(String).Some(out), true => Option(String).None)
});

recur_append_evidence_args :: (fn(args_list : String, ctx : CodegenContext) -> String)({
  out := args_list.clone();
  i := usize(0);
  while(i < ctx.current_evidence_param_names.len(), {
    match(
      ctx.current_evidence_param_names.get(i),
      .Some(ep_name) => {
        if(out.len() > usize(0), {
          out.push_str(", ");
        });
        out.push_string(ep_name);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  out
});

recur_emit_deferred_drops :: (
  fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> bool
)(
  match(
    ctx.get_expr_info(ast_expr_id(expr)),
    .None => true,
    .Some(info) => match(
      info.deferred_drop_expressions,
      .None => true,
      .Some(drops) => {
        (i : usize) = usize(0);
        (ok : bool) = true;
        while((i < drops.len()) && ok, {
          match(
            drops.get(i),
            .None => {
              ok = false;
            },
            .Some(drop_expr) => match(
              call_gen_expr(drop_expr, ctx, indent),
              .None => {
                ok = false;
              },
              .Some(drop_code) => ctx.emitter.emit_string_line(
                format_indented_stmt_line(indent, drop_code)
              )
            )
          );
          i = (i + usize(1));
        });
        ok
      }
    )
  )
);

recur_emit_temp_if_needed :: (
  fn(call_expr : AstExpr, call_code : String, ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    ctx.get_expr_info(ast_expr_id(call_expr)),
    .None => Option(String).Some(call_code),
    .Some(info) => match(
      info.variable_name,
      .None => Option(String).Some(call_code),
      .Some(temp_var) => cond(
        is_unit_type(info.ty) => Option(String).Some(call_code),
        true => match(
          get_type_string_opt(info.ty, ctx),
          .None => Option(String).Some(call_code),
          .Some(c_type) => {
            temp_var_name := sanitize_for_c_identifier(temp_var);
            if(!(recur_array_contains_string(ctx.declared_temp_vars, temp_var_name)), {
              ctx.declared_temp_vars.push(temp_var_name);
              ctx.emitter.emit_string_line(
                format_typed_temp_assignment(indent, c_type, temp_var_name, call_code)
              );
            });
            Option(String).Some(temp_var_name)
          }
        )
      )
    )
  )
);

generate_recur :: (
  fn(call_expr : AstExpr, _args : ArrayList(AstExpr), ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    ctx.get_expr_info(ast_expr_id(call_expr)),
    .None => Option(String).None,
    .Some(info) => match(
      info.runtime_arg_exprs_in_order,
      .None => {
        msg := String.from("// Error: No arguments for recur call ");
        msg.push_string(ast_expr_to_string(call_expr));
        msg.push_str("\n");
        Option(String).Some(msg)
      },
      .Some(runtime_args) => match(
        recur_args_to_c(runtime_args, ctx, indent),
        .None => Option(String).None,
        .Some(args_list) => {
          full_args := recur_append_evidence_args(args_list, ctx);
          call_code := format_c_function_call(ctx.current_fn_name.as_str(), full_args);
          cond(
            (!(recur_emit_deferred_drops(call_expr, ctx, indent))) => Option(String).None,
            true => recur_emit_temp_if_needed(call_expr, call_code, ctx, indent)
          )
        }
      )
    )
  )
);

export(
  generate_recur,
  recur_args_to_c,
  recur_append_evidence_args,
  recur_emit_deferred_drops,
  recur_array_contains_string,
  format_typed_temp_assignment,
  format_indented_stmt_line
);
