//! Partial 1-to-1 port of `src/codegen/exprs/drop-dup.ts`.
//!
//! Covers the leaf-type drop emit: for `Dyn`, atomic-`Object`,
//! `Object`, and `Iso` values, the generated C string is a pure
//! `__yo_decr_rc[_atomic]((void*)x[.data])` and needs no type-name
//! registry or emitter. Returns `Option(String).Some(...)` for those
//! four shapes and `Option(String).None` for everything else so the
//! bootstrap codegen can keep handling the remaining cases (struct /
//! enum drops via `___drop`, array/tuple recursive drops via the C
//! emitter, dup paths that need `getTypeString`).
//!
//! Full ports of `generateDupCodeForValue`, the array / tuple
//! recursion, and `getDropFunctionForType` /
//! `getDupFunctionForType` (which look up
//! `context.functions[funcId].cName`) wait on the type-name registry +
//! function-cname table landing in yo-self codegen.
open(import("std/string"));
{ TypeValue } :: import("../../types/type.yo");
{
  is_dyn_type,
  is_atomic_object_type,
  is_object_type,
  is_iso_type
} :: import("../../types/guards.yo");
{
  format_decr_rc_call,
  format_decr_rc_atomic_call
} :: import("./rc_fns.yo");
/// Emit the C drop expression for a leaf RC type shape, given the
/// already-generated `value_code` and its static `ty`.
///
/// Returns:
///   - `Some("__yo_decr_rc((void*)(value_code).data)")` for `Dyn(T)`
///   - `Some("__yo_decr_rc_atomic((void*)(value_code))")` for atomic
///     object types and `Iso(T)`
///   - `Some("__yo_decr_rc((void*)(value_code))")` for non-atomic
///     object types
///   - `None` for everything else (the bootstrap codegen handles these)
///
/// Matches the corresponding branches of `generateDropCodeForValue` in
/// TS, post-`resolveSomeType` / `typeContainsRcType` filtering — that
/// is, the call site is expected to have already established that the
/// value participates in RC.
generate_drop_code_for_leaf_type :: (
  fn(value_code : String, ty : TypeValue) -> Option(String)
)(
  cond(
    is_dyn_type(ty) => {
      arg := String.from("(void*)(");
      arg.push_str(value_code.as_str());
      arg.push_str(").data");
      Option(String).Some(format_decr_rc_call(arg))
    },
    // Atomic object check MUST precede the general object check
    // because `is_atomic_object_type` is the more specific predicate.
    is_atomic_object_type(ty) => {
      arg := String.from("(void*)(");
      arg.push_str(value_code.as_str());
      arg.push_str(")");
      Option(String).Some(format_decr_rc_atomic_call(arg))
    },
    is_object_type(ty) => {
      arg := String.from("(void*)(");
      arg.push_str(value_code.as_str());
      arg.push_str(")");
      Option(String).Some(format_decr_rc_call(arg))
    },
    is_iso_type(ty) => {
      arg := String.from("(void*)(");
      arg.push_str(value_code.as_str());
      arg.push_str(")");
      Option(String).Some(format_decr_rc_atomic_call(arg))
    },
    true => Option(String).None
  )
);
export(generate_drop_code_for_leaf_type);
