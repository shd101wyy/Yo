//! Drop / dup code generation — mirrors `src/codegen/exprs/drop-dup.ts`.
//!
//! `get_drop_function_for_type` / `get_dup_function_for_type` resolve a type's
//! `___drop` / `___dup` C function. TS reads `type.trait.fields[].assignedValue`;
//! yo-self Struct/EnumT carry NO `.trait` field, so this routes through the
//! type-trait-method REGISTRY (`evaluator/values/type_trait_methods.yo`) — the
//! faithful equivalent (resolves Gap 9 for the RC layer).
//!
//! `generate_drop_code_for_value` / `generate_dup_code_for_value` recurse through
//! arrays/tuples and emit RC decr/incr (or the type's drop/dup fn) for
//! object/dyn/iso/struct/enum values. `generate_deferred_{drop,dup}_expressions`
//! emit the evaluator-deferred RC ops (closure-capture + short-circuit-handled
//! skips).
//!
//! DEFERRED (documented): `SomeType.resolvedConcreteType` (Gap 6) — yo-self
//! SomeT carries no resolved concrete type, so `concrete_type := value_type`.
//! For the monomorphized corpus the value type is already concrete, so this is
//! a no-op; unresolved-SomeT params (Phase-3 generics) need Gap-6 resolution.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_is_atom, ast_expr_is_fn_call, ast_expr_is_fn_call_of, ast_expr_token, BF_DROP, BF_DUP, BF_DOT } :: import("../../expr.yo");
{ EvalValue } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_array_type, is_tuple_type, is_dyn_type, is_atomic_reference_struct_type, is_reference_struct_type, is_atomic_reference_enum_type, is_reference_enum_type, is_iso_type, is_struct_type, is_enum_type, is_some_type, is_newtype_type } :: import("../../types/guards.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{ random_id, is_temp_variable_name } :: import("../../utils.yo");
{ MethodEntry, get_type_trait_methods_by_name, type_id_or_empty } :: import("../../evaluator/values/type_trait_methods.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ _call_generate_expr } :: import("./_expr.yo");
{ get_type_string, get_variable_name_for_codegen, get_deferred_drop_target_atom_name, get_deferred_dup_target_atom_name, is_deferred_drop_for_closure_capture, get_enum_variant_c_name, sanitize_for_c_identifier, can_optimize_as_nullable_pointer, get_runtime_struct_fields, type_key } :: import("../utils/index.yo");
{ Environment } :: import("../../env.yo");
/// The registered C name of the first `method_name` entry for `type`, if it is
/// a function value registered in the codegen function table.
_method_c_name :: (fn(type : TypeValue, method_name : str, context : FunctionGenerationContext) -> Option(String))({
  if(!(is_struct_type(type) || (is_enum_type(type) || (is_dyn_type(type) || (is_some_type(type) || is_iso_type(type))))), {
    return(Option(String).None);
  });
  methods := get_type_trait_methods_by_name(type_id_or_empty(type), String.from(method_name));
  match(methods.get(usize(0)),.Some(entry) => match(entry.value,.Some(v) => match(v,.FuncVal(__fvd1, _) => match(context.base.get_function_entry(__fvd1.*.func_id),.Some(e) => Option(String).Some(e.c_name),.None => Option(String).None), _ => Option(String).None),.None => Option(String).None),.None => Option(String).None)
});
/// The C name of `type`'s `___drop` function, if any. Mirrors
/// `getDropFunctionForType`.
get_drop_function_for_type :: (fn(type : TypeValue, context : FunctionGenerationContext) -> Option(String))(
  _method_c_name(type, BF_DROP, context)
);
/// The C name of `type`'s `___dup` function, if any. Mirrors
/// `getDupFunctionForType`.
get_dup_function_for_type :: (fn(type : TypeValue, context : FunctionGenerationContext) -> Option(String))(
  _method_c_name(type, BF_DUP, context)
);
/// The C name of `type`'s `___dispose` function, if any. Used by the
/// object-constructor emitter to stamp the dispose type tag onto the RC header.
get_dispose_function_for_type :: (fn(type : TypeValue, context : FunctionGenerationContext) -> Option(String))(
  _method_c_name(type, "___dispose", context)
);
/// The C name of `type`'s monomorphized `trace` method (the Trace trait), if any.
/// Used by the cycle-GC traversal generators: a container whose elements live in a
/// malloc'd buffer (which the auto-derived field walk can't reach) carries an
/// explicit Trace impl, and its `traverse_fn` delegates to this `trace`. Returns
/// None for types that use the auto-derived field-walk traversal. Mirrors the
/// registry-lookup half of `findUserTraceMethodForType` (the specialized `trace`
/// is registered under the concrete type id by `collect_trace_methods_from_generic_impls`).
get_trace_function_for_type :: (fn(type : TypeValue, context : FunctionGenerationContext) -> Option(String))({
  // trace is registered under type_key(type) (instantiation-precise), not the
  // raw shared struct id — see collection.yo _specialize_and_register_trace.
  if(!(is_struct_type(type) || (is_enum_type(type) || (is_dyn_type(type) || (is_some_type(type) || is_iso_type(type))))), {
    return(Option(String).None);
  });
  methods := get_type_trait_methods_by_name(type_key(type), String.from("trace"));
  match(
    methods.get(usize(0)),
    .Some(entry) => match(
      entry.value,
      .Some(v) => match(
        v,
        .FuncVal(__fvd2, _) => match(
          context.base.get_function_entry(__fvd2.*.func_id),
          .Some(e) => Option(String).Some(e.c_name),
          .None => Option(String).None
        ),
        _ => Option(String).None
      ),
      .None => Option(String).None
    ),
    .None => Option(String).None
  )
});
/// If `value_arg` is a forall-typed (SomeType) parameter atom, recover its
/// concrete parameter type from the enclosing function signature. Mirrors
/// `resolveSomeTypeParamType` (the SomeType.resolvedConcreteType branches are
/// Gap-6-deferred — yo-self has no such field).
resolve_some_type_param_type :: (fn(value_arg : AstExpr, value_type : TypeValue, context : FunctionGenerationContext) -> TypeValue)({
  if(!(is_some_type(value_type)), {
    return(value_type);
  });
  if(!(ast_expr_is_atom(value_arg)), {
    return(value_type);
  });
  ft := match(context.current_function_type,.Some(t) => t,.None => return(value_type));
  var_name := ast_expr_token(value_arg).value;
  match(
    ft,
    .Func({ param_types : pts, meta : __fm1 }) => {
      pls := __fm1.*.param_labels;
      n := pls.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          pls.get(i),
          .Some(lbl) => if(lbl == var_name, {
            match(
              pts.get(i),
              .Some(pt) => if(!(is_some_type(pt)), {
                return(pt);
              }),
              .None => ()
            );
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  );
  value_type
});
/// Generate drop code for a value of any type (recursive for arrays/tuples).
/// Mirrors `generateDropCodeForValue`. Note: emits at column 0 (no indent),
/// faithful to the TS emitLine calls.
generate_drop_code_for_value :: (fn(value_code : String, value_type : TypeValue, context : FunctionGenerationContext) -> String)({
  concrete_type := value_type;
  if(!(type_contains_rc_type(concrete_type)), {
    return(String.from(""));
  });
  em := context.base.emitter;
  cond(
    is_array_type(concrete_type) => match(
      concrete_type,
      .Array(element, length, length_var) => {
        if(length_var.len() > usize(0), {
          return(String.from("/* Error: array has non-constant length */"));
        });
        hdr := String.from("for (size_t i = 0; i < ");
        hdr.push_string(length.to_string());
        hdr.push_str("; i++) {");
        em.emit_string_line(hdr);
        ec := String.from("(");
        ec.push_string(value_code.clone());
        ec.push_str(").data[i]");
        elem_drop := recur(ec, element, context);
        if(elem_drop.len() > usize(0), {
          line := String.from("  ");
          line.push_string(elem_drop);
          line.push_str(";");
          em.emit_string_line(line);
        });
        em.emit_string_line(String.from("}"));
        String.from("")
      },
      _ => String.from("")
    ),
    is_tuple_type(concrete_type) => match(
      concrete_type,
      .Tuple({ field_types : fts }) => {
        n := fts.len();
        (i : usize) = usize(0);
        while(i < n, {
          match(
            fts.get(i),
            .Some(ft) => if(type_contains_rc_type(ft), {
              fc := String.from("(");
              fc.push_string(value_code.clone());
              fc.push_str(")._");
              fc.push_string(i.to_string());
              fd := recur(fc, ft, context);
              if(fd.len() > usize(0), {
                line := fd;
                line.push_str(";");
                em.emit_string_line(line);
              });
            }),
            .None => ()
          );
          i = (i + usize(1));
        });
        String.from("")
      },
      _ => String.from("")
    ),
    is_dyn_type(concrete_type) => {
      out := String.from("__yo_decr_rc((void*)(");
      out.push_string(value_code.clone());
      out.push_str(").data)");
      out
    },
    is_atomic_reference_struct_type(concrete_type) => {
      out := String.from("__yo_decr_rc_atomic((void*)(");
      out.push_string(value_code.clone());
      out.push_str("))");
      out
    },
    is_reference_struct_type(concrete_type) => {
      out := String.from("__yo_decr_rc((void*)(");
      out.push_string(value_code.clone());
      out.push_str("))");
      out
    },
    is_iso_type(concrete_type) => {
      out := String.from("__yo_decr_rc_atomic((void*)(");
      out.push_string(value_code.clone());
      out.push_str("))");
      out
    },
    // Reference-semantics enums (`ref(enum(…))`) are RC handles — decrement the
    // ref-count directly, exactly like reference-semantics structs above. (TS
    // routes ref-enum ___drop through an evaluator-synthesized method; yo-self
    // stores trait methods in a side-registry, not on the type, so it lowers RC
    // the same direct way it already does for ref-structs — identical effect.)
    is_atomic_reference_enum_type(concrete_type) => {
      out := String.from("__yo_decr_rc_atomic((void*)(");
      out.push_string(value_code.clone());
      out.push_str("))");
      out
    },
    is_reference_enum_type(concrete_type) => {
      out := String.from("__yo_decr_rc((void*)(");
      out.push_string(value_code.clone());
      out.push_str("))");
      out
    },
    // Value enum carrying RC fields: drop the active variant's RC fields INLINE — yo-self
    // lowers RC operations directly rather than via a side-registry method (same rationale
    // as the reference-enum branch above; registering a ___drop method instead makes
    // `(___drop)(x)` resolve via method dispatch, which mis-lowers). Mirrors the per-variant
    // walk in generateRefEnumTraversalFunctions, adapted to a value (not a handle).
    is_enum_type(concrete_type) => match(
      can_optimize_as_nullable_pointer(concrete_type),
      // Nullable-pointer enum: the value IS the inner pointer (NULL = the empty variant).
      .Some(inner) => {
        inner_drop := recur(value_code.clone(), inner, context);
        if(inner_drop.len() > usize(0), {
          line := String.from("if ((");
          line.push_string(value_code.clone());
          line.push_str(") != NULL) { ");
          line.push_string(inner_drop);
          line.push_str("; }");
          em.emit_string_line(line);
        });
        String.from("")
      },
      // Tagged representation: switch on the discriminant, drop each RC field of the arm.
      .None => match(
        concrete_type,
        .EnumT({ variant_names, variant_fields, variant_field_labels }) => {
          em.emit_string_line(`switch ((${value_code.clone()}).tag) {`);
          nv := variant_names.len();
          (vi : usize) = usize(0);
          while(vi < nv, {
            vname := match(variant_names.get(vi),.Some(v) => v,.None => String.from(""));
            fields := match(variant_fields.get(vi),.Some(f) => f,.None => ArrayList(TypeValue).new());
            labels := match(variant_field_labels.get(vi),.Some(l) => l,.None => ArrayList(String).new());
            nf := fields.len();
            (has_rc : bool) = false;
            (ci : usize) = usize(0);
            while(ci < nf, {
              match(
                fields.get(ci),
                .Some(ft) => if(type_contains_rc_type(ft), {
                  has_rc = true;
                }),
                .None => ()
              );
              ci = (ci + usize(1));
            });
            if(has_rc, {
              tag_c := get_enum_variant_c_name(concrete_type, vname.clone(), context.base);
              em.emit_string_line(`  case ${tag_c}: {`);
              (fi : usize) = usize(0);
              while(fi < nf, {
                match(
                  fields.get(fi),
                  .Some(ft) => if(type_contains_rc_type(ft), {
                    flabel := match(labels.get(fi),.Some(l) => l,.None => String.from(""));
                    fname := sanitize_for_c_identifier(flabel, false);
                    access := `(${value_code.clone()}).data.${vname.clone()}.${fname}`;
                    fd := recur(access, ft, context);
                    if(fd.len() > usize(0), {
                      line := String.from("    ");
                      line.push_string(fd);
                      line.push_str(";");
                      em.emit_string_line(line);
                    });
                  }),
                  .None => ()
                );
                fi = (fi + usize(1));
              });
              em.emit_string_line(String.from("    break;"));
              em.emit_string_line(String.from("  }"));
            });
            vi = (vi + usize(1));
          });
          em.emit_string_line(String.from("  default: break;"));
          em.emit_string_line(String.from("}"));
          String.from("")
        },
        _ => String.from("")
      )
    ),
    // Value struct carrying RC fields: drop via its synthesized ___drop method, if any.
    is_struct_type(concrete_type) => match(
      get_drop_function_for_type(concrete_type, context),
      .Some(fn) => {
        out := fn;
        out.push_str("(");
        out.push_string(value_code.clone());
        out.push_str(")");
        out
      },
      .None => String.from("")
    ),
    true => String.from("")
  )
});
/// Generate dup code for a value of any type (recursive for arrays/tuples).
/// Mirrors `generateDupCodeForValue`.
generate_dup_code_for_value :: (fn(value_code : String, value_type : TypeValue, context : FunctionGenerationContext) -> String)({
  concrete_type := value_type;
  em := context.base.emitter;
  cond(
    is_array_type(concrete_type) => match(
      concrete_type,
      .Array(element, length, length_var) => {
        if(length_var.len() > usize(0), {
          return(String.from("/* Error: array has non-constant length */"));
        });
        temp_var := String.from("temp_dup_");
        temp_var.push_string(random_id(String.from("")));
        loop_var := String.from("i_");
        loop_var.push_string(random_id(String.from("")));
        array_c_name := get_type_string(concrete_type, context.base);
        decl := array_c_name;
        decl.push_str(" ");
        decl.push_string(temp_var.clone());
        decl.push_str(" = ");
        decl.push_string(value_code.clone());
        decl.push_str(";");
        em.emit_string_line(decl);
        hdr := String.from("for (size_t ");
        hdr.push_string(loop_var.clone());
        hdr.push_str(" = 0; ");
        hdr.push_string(loop_var.clone());
        hdr.push_str(" < ");
        hdr.push_string(length.to_string());
        hdr.push_str("; ");
        hdr.push_string(loop_var.clone());
        hdr.push_str("++) {");
        em.emit_string_line(hdr);
        elem_ref := temp_var.clone();
        elem_ref.push_str(".data[");
        elem_ref.push_string(loop_var.clone());
        elem_ref.push_str("]");
        elem_dup := recur(elem_ref.clone(), element, context);
        asn := String.from("  ");
        asn.push_string(elem_ref);
        asn.push_str(" = ");
        asn.push_string(elem_dup);
        asn.push_str(";");
        em.emit_string_line(asn);
        em.emit_string_line(String.from("}"));
        temp_var
      },
      _ => value_code.clone()
    ),
    is_tuple_type(concrete_type) => match(
      concrete_type,
      .Tuple({ field_types : fts }) => {
        temp_var := String.from("temp_dup_tuple_");
        temp_var.push_string(random_id(String.from("")));
        tuple_c_name := get_type_string(concrete_type, context.base);
        decl := tuple_c_name;
        decl.push_str(" ");
        decl.push_string(temp_var.clone());
        decl.push_str(" = ");
        decl.push_string(value_code.clone());
        decl.push_str(";");
        em.emit_string_line(decl);
        n := fts.len();
        (i : usize) = usize(0);
        while(i < n, {
          match(
            fts.get(i),
            .Some(ft) => if(type_contains_rc_type(ft), {
              fref := temp_var.clone();
              fref.push_str("._");
              fref.push_string(i.to_string());
              fdup := recur(fref.clone(), ft, context);
              asn := fref;
              asn.push_str(" = ");
              asn.push_string(fdup);
              asn.push_str(";");
              em.emit_string_line(asn);
            }),
            .None => ()
          );
          i = (i + usize(1));
        });
        temp_var
      },
      _ => value_code.clone()
    ),
    is_dyn_type(concrete_type) => {
      dyn_c_name := get_type_string(concrete_type, context.base);
      out := String.from("((");
      out.push_string(dyn_c_name);
      out.push_str("){ .data = __yo_incr_rc((void*)(");
      out.push_string(value_code.clone());
      out.push_str(").data), .vtable = (");
      out.push_string(value_code.clone());
      out.push_str(").vtable })");
      out
    },
    is_atomic_reference_struct_type(concrete_type) => {
      obj_c_name := get_type_string(concrete_type, context.base);
      out := String.from("((");
      out.push_string(obj_c_name);
      out.push_str(")__yo_incr_rc_atomic((void*)(");
      out.push_string(value_code.clone());
      out.push_str(")))");
      out
    },
    is_reference_struct_type(concrete_type) => {
      obj_c_name := get_type_string(concrete_type, context.base);
      out := String.from("((");
      out.push_string(obj_c_name);
      out.push_str(")__yo_incr_rc((void*)(");
      out.push_string(value_code.clone());
      out.push_str(")))");
      out
    },
    is_iso_type(concrete_type) => {
      iso_c_name := get_type_string(concrete_type, context.base);
      out := String.from("((");
      out.push_string(iso_c_name);
      out.push_str(")__yo_incr_rc_atomic((void*)(");
      out.push_string(value_code.clone());
      out.push_str(")))");
      out
    },
    // Reference-semantics enums (`ref(enum(…))`): increment the ref-count and
    // return the same handle pointer, exactly like reference-semantics structs.
    is_atomic_reference_enum_type(concrete_type) => {
      en_c_name := get_type_string(concrete_type, context.base);
      out := String.from("((");
      out.push_string(en_c_name);
      out.push_str(")__yo_incr_rc_atomic((void*)(");
      out.push_string(value_code.clone());
      out.push_str(")))");
      out
    },
    is_reference_enum_type(concrete_type) => {
      en_c_name := get_type_string(concrete_type, context.base);
      out := String.from("((");
      out.push_string(en_c_name);
      out.push_str(")__yo_incr_rc((void*)(");
      out.push_string(value_code.clone());
      out.push_str(")))");
      out
    },
    // Newtype (`newtype(_f : Inner)`): a TRANSPARENT typedef to `Inner` at the
    // C ABI (no struct wrapper, no `._f` member — see codegen/types/generation
    // "newtype - zero-cost abstraction"). So its value IS the inner value: dup
    // it by recursing on the inner field's type with the SAME value_code (NOT
    // the per-field `temp._f = …` path below, which emits an invalid member
    // access — e.g. `String._bytes` on the typedef'd `Option(ArrayList(u8))`).
    // Faithful inline equivalent of TS calling the newtype's auto-derived
    // ___dup, which dups the underlying value.
    is_newtype_type(concrete_type) => {
      rfs := get_runtime_struct_fields(concrete_type);
      match(
        rfs.get(usize(0)),
        .Some(f) => cond(
          type_contains_rc_type(f.ty) => recur(value_code.clone(), f.ty, context),
          true => value_code.clone()
        ),
        .None => value_code.clone()
      )
    },
    // Value struct (reference structs handled above): dup is a per-field dup —
    // materialize a copy temp, dup each RC runtime field IN PLACE, return the temp.
    // Mirrors the tuple-dup case + TS generateDupFunctionCodeForStructType (value-with-RC
    // branch); yo-self lowers it inline (no ___dup method), exactly as it lowers the
    // value-enum drop inline. Without this, copying a value struct that holds an RC field
    // (e.g. `bucket := (data_ptr &+ i).*` in HashMap.get) did not dup the field, so the
    // RC was unbalanced (the auto-derived field walk could not see the buffer copy). A
    // value struct with no RC field falls through to a bare value copy.
    is_struct_type(concrete_type) => {
      rfs := get_runtime_struct_fields(concrete_type);
      (has_rc : bool) = false;
      (ci : usize) = usize(0);
      while(ci < rfs.len(), {
        match(
          rfs.get(ci),
          .Some(f) => if(type_contains_rc_type(f.ty), {
            has_rc = true;
          }),
          .None => ()
        );
        ci = (ci + usize(1));
      });
      cond(
        !(has_rc) => value_code.clone(),
        true => {
          temp_var := String.from("temp_dup_struct_");
          temp_var.push_string(random_id(String.from("")));
          struct_c_name := get_type_string(concrete_type, context.base);
          decl := struct_c_name;
          decl.push_str(" ");
          decl.push_string(temp_var.clone());
          decl.push_str(" = ");
          decl.push_string(value_code.clone());
          decl.push_str(";");
          em.emit_string_line(decl);
          (fi : usize) = usize(0);
          while(fi < rfs.len(), {
            match(
              rfs.get(fi),
              .Some(f) => if(type_contains_rc_type(f.ty), {
                fref := temp_var.clone();
                fref.push_str(".");
                fref.push_string(sanitize_for_c_identifier(f.label.clone(), false));
                fdup := recur(fref.clone(), f.ty, context);
                asn := fref;
                asn.push_str(" = ");
                asn.push_string(fdup);
                asn.push_str(";");
                em.emit_string_line(asn);
              }),
              .None => ()
            );
            fi = (fi + usize(1));
          });
          temp_var
        }
      )
    },
    is_enum_type(concrete_type) => match(
      get_dup_function_for_type(concrete_type, context),
      .Some(fn) => {
        out := fn;
        out.push_str("(");
        out.push_string(value_code.clone());
        out.push_str(")");
        out
      },
      .None => value_code.clone()
    ),
    true => value_code.clone()
  )
});
/// Emit the evaluator-deferred drop expressions for `expr` (closure-capture and
/// short-circuit-handled drops are skipped). Mirrors `generateDeferredDropExpressions`.
{ _looks_like_minted_temp } :: import("./begin.yo");
generate_deferred_drop_expressions :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> unit)(
  match(
    context.base.get_expr_info(expr),
    .Some(ei) => match(
      ei.deferred_drop_expressions,
      .Some(drops) => {
        em := context.base.emitter;
        n := drops.len();
        (i : usize) = usize(0);
        while(i < n, {
          match(
            drops.get(i),
            .Some(drop_expr) => {
              skip_capture := is_deferred_drop_for_closure_capture(drop_expr, context.current_closure_captures);
              // Skip a drop whose target TEMP was never emitted as a C declaration
              // (declaration elided while its deferred-drop survived) — emitting
              // `__yo_decr_rc(undeclared_temp)` is an undeclared-identifier error.
              // Gated to temp names (is_temp_variable_name) so function params /
              // user vars (declared in the C signature, not via get_variable_type_string)
              // are never skipped. Safe: a never-declared C variable cannot be
              // double-freed and holds no value to leak.
              undeclared_temp := match(
                get_deferred_drop_target_atom_name(drop_expr),
                .Some(nm) => {
                  cn := sanitize_for_c_identifier(nm, false);
                  (is_temp_variable_name(ei.env.module_path.clone(), cn.clone()) || _looks_like_minted_temp(cn.clone())) && !(context.base.declared_c_var_names.contains(cn))
                },
                .None => false
              );
              if(!(skip_capture) && !(undeclared_temp), {
                sc_skip := match(
                  context.short_circuit_handled_drop_var_names,
                  .Some(handled) => match(
                    get_deferred_drop_target_atom_name(drop_expr),
                    .Some(t) => if(handled.contains(t.clone()), {
                      _r := handled.remove(t);
                      true
                    }, false),
                    .None => false
                  ),
                  .None => false
                );
                if(!(sc_skip), {
                  code := _call_generate_expr(drop_expr, indent.clone(), context);
                  if(code.len() > usize(0), {
                    line := indent.clone();
                    line.push_string(code);
                    line.push_str(";");
                    em.emit_string_line(line);
                  });
                });
              });
            },
            .None => ()
          );
          i = (i + usize(1));
        });
      },
      .None => ()
    ),
    .None => ()
  )
);
/// Emit the evaluator-deferred dup expressions for `expr`. Mirrors
/// `generateDeferredDupExpressions`.
generate_deferred_dup_expressions :: (fn(expr : AstExpr, indent : String, context : FunctionGenerationContext) -> unit)(
  match(
    context.base.get_expr_info(expr),
    .Some(ei) => match(
      ei.deferred_dup_expressions,
      .Some(dups) => {
        em := context.base.emitter;
        n := dups.len();
        (i : usize) = usize(0);
        while(i < n, {
          match(
            dups.get(i),
            .Some(dup_expr) => if(ast_expr_is_fn_call(dup_expr), {
              code := _call_generate_expr(dup_expr, indent.clone(), context);
              if(code.len() > usize(0), {
                line := indent.clone();
                line.push_string(code);
                line.push_str(";");
                em.emit_string_line(line);
              });
            }),
            .None => ()
          );
          i = (i + usize(1));
        });
      },
      .None => ()
    ),
    .None => ()
  )
);
/// Emit `expr`'s deferred `___dup` expression(s), if any, then return the
/// dup-result temp's C name (so the dup'd copy is what gets stored/passed);
/// otherwise return `fallback_code` unchanged. Shared by the codegen
/// dup-on-store sites (init-assignment RHS, ref-struct ctor args, ...).
/// Mirrors the `deferredDupExpressions` blocks in `src/codegen/exprs/*`.
emit_deferred_dup_or_code :: (fn(expr : AstExpr, fallback_code : String, indent : String, context : FunctionGenerationContext) -> String)(
  match(
    context.base.get_expr_info(expr),
    .Some(ei) => match(
      ei.deferred_dup_expressions,
      .Some(dups) => if(dups.len() > usize(0), {
        em := context.base.emitter;
        // The dup result's C variable name: Some for value-type dups (their inline form
        // materializes a result temp), None for ref-handle dups (which lower to
        // `incr_rc(arg)` with no result temp — the caller keeps using the raw value).
        dup_result_name := match(
          dups.get(usize(0)),
          .Some(dup_expr) => if(
            ast_expr_is_fn_call(dup_expr),
            match(
              context.base.get_expr_info(dup_expr),
              .Some(dei) => match(
                dei.variable_name,
                .Some(dvn) => Option(String).Some(get_variable_name_for_codegen(dvn, Option(Environment).Some(dei.env))),
                .None => Option(String).None
              ),
              .None => Option(String).None
            ),
            Option(String).None
          ),
          .None => Option(String).None
        );
        // A ref-handle dup (`incr_rc(arg)`, no result temp) whose SOURCE is an inlined
        // field access (`x.f`): the dup's argument is the source's temp variableName,
        // which codegen never declares (the field read is inlined at the use site), so
        // `incr_rc(<temp>)` references an undeclared identifier — e.g. HashMap.get's
        // `Some(bucket.value)`. Materialize the field value once into that temp (exactly
        // TS's materialize-then-dup), so the dup references a real local and the temp is
        // the dup'd value the caller uses. Safe: the field access is evaluated once.
        dup_target := match(dups.get(usize(0)),.Some(de) => get_deferred_dup_target_atom_name(de),.None => Option(String).None);
        t_name := sanitize_for_c_identifier(match(dup_target,.Some(s) => s,.None => String.from("")), false);
        // Only materialize when the source is NOT already materialized into the dup
        // target temp: if the caller's fallback code already IS that temp (some paths
        // declare it before this call — e.g. `set`'s old-value extraction), declaring it
        // again would redefine it. When the fallback is the raw field access (`get`'s
        // `Some(bucket.value)`), the temp is a never-declared phantom → materialize.
        needs_materialize := match(
          dup_result_name,
          .None => ((ast_expr_is_fn_call_of(expr, BF_DOT, Option(usize).Some(usize(2))) && dup_target.is_some()) && (fallback_code != t_name)),
          .Some(_) => false
        );
        cond(
          needs_materialize => {
            decl := get_type_string(ei.ty, context.base);
            decl.push_str(" ");
            decl.push_string(t_name.clone());
            decl.push_str(" = ");
            decl.push_string(fallback_code.clone());
            decl.push_str(";");
            em.emit_string_line(decl);
            generate_deferred_dup_expressions(expr, indent.clone(), context);
            t_name
          },
          true => {
            generate_deferred_dup_expressions(expr, indent.clone(), context);
            match(dup_result_name,.Some(n) => n,.None => fallback_code)
          }
        )
      }, fallback_code),
      .None => fallback_code
    ),
    .None => fallback_code
  )
);
export(get_drop_function_for_type, get_dup_function_for_type, get_dispose_function_for_type, get_trace_function_for_type, resolve_some_type_param_type, generate_drop_code_for_value, generate_dup_code_for_value, generate_deferred_drop_expressions, generate_deferred_dup_expressions, emit_deferred_dup_or_code);
