//! Partial 1-to-1 port of `src/codegen/exprs/drop-dup.ts`.
//!
//! Covers the leaf-type drop AND dup emit: for `Dyn`,
//! atomic-`Object`, `Object`, and `Iso` values, the generated C
//! string follows TS exactly:
//!
//!   - drop emits `__yo_decr_rc[_atomic]((void*)x[.data])`;
//!   - dup emits `((TypeCName)__yo_incr_rc[_atomic]((void*)x))` or
//!     for Dyn `((TypeCName){ .data = __yo_incr_rc(...), .vtable = ... })`.
//!
//! Returns `Option(String).Some(...)` for those four shapes and
//! `Option(String).None` for everything else so the bootstrap codegen
//! can keep handling the remaining cases (struct / enum drops via
//! `___drop`, array/tuple recursive drops via the C emitter, and
//! struct/enum dups via `___dup`).
//!
//! Full ports of the array / tuple recursion and
//! `getDropFunctionForType` / `getDupFunctionForType` (which look up
//! `context.functions[funcId].cName`) wait on the
//! function-cname registry landing in yo-self codegen.
open(import("std/string"));
{ TypeValue } :: import("../../types/definitions.yo");
{
  is_dyn_type,
  is_atomic_object_type,
  is_object_type,
  is_iso_type
} :: import("../../types/guards.yo");
{ CodegenContext } :: import("../context.yo");
{
  get_type_string,
  format_void_ptr_cast,
  format_void_ptr_data_cast
} :: import("../utils/index.yo");
{
  format_decr_rc_call,
  format_decr_rc_atomic_call,
  format_incr_rc_call,
  format_incr_rc_atomic_call
} :: import("./rc_fns.yo");
// `format_void_ptr_cast` and `format_void_ptr_data_cast` moved to
// `codegen/utils/index.yo` for sharing with rc_fns.yo. Re-imported at
// the top of this file.
/// Format the typed-cast wrap `((<c_name>)<value_code>)`. Used by the
/// dup paths for non-Dyn shapes to cast the void* returned by
/// `__yo_incr_rc[_atomic]` back to the value's concrete C type.
format_typed_rc_cast :: (fn(c_name : String, value_code : String) -> String)({
  s := String.from("((");
  s.push_string(c_name);
  s.push_str(")");
  s.push_string(value_code);
  s.push_str(")");
  s
});
/// Format the Dyn dup rebuild compound literal:
///   `((<dyn_c_name>){ .data = <incr>, .vtable = (<value_code>).vtable })`
/// Reconstructs a Dyn fat-pointer after dup'ing only the data side.
format_dyn_dup_rebuild :: (
  fn(dyn_c_name : String, incr : String, value_code : String) -> String
)({
  s := String.from("((");
  s.push_string(dyn_c_name);
  s.push_str("){ .data = ");
  s.push_string(incr);
  s.push_str(", .vtable = (");
  s.push_str(value_code.as_str());
  s.push_str(").vtable })");
  s
});
/// Emit the C drop expression for a leaf RC type shape, given the
/// already-generated `value_code` and its static `ty`.
///
/// Returns:
///   - `Some("__yo_decr_rc((void*)(value_code).data)")` for `Dyn(T)`
///   - `Some("__yo_decr_rc_atomic((void*)(value_code))")` for atomic
///     object types and `Iso(T)`
///   - `Some("__yo_decr_rc((void*)(value_code))")` for non-atomic
///     object types
///   - `None` for everything else (the bootstrap codegen handles these)
///
/// Matches the corresponding branches of `generateDropCodeForValue` in
/// TS, post-`resolveSomeType` / `typeContainsRcType` filtering — that
/// is, the call site is expected to have already established that the
/// value participates in RC.
generate_drop_code_for_leaf_type :: (
  fn(value_code : String, ty : TypeValue) -> Option(String)
)(
  cond(
    is_dyn_type(ty) => Option(String).Some(
      format_decr_rc_call(format_void_ptr_data_cast(value_code))
    ),
    // Atomic object check MUST precede the general object check
    // because `is_atomic_object_type` is the more specific predicate.
    is_atomic_object_type(ty) => Option(String).Some(
      format_decr_rc_atomic_call(format_void_ptr_cast(value_code))
    ),
    is_object_type(ty) => Option(String).Some(
      format_decr_rc_call(format_void_ptr_cast(value_code))
    ),
    is_iso_type(ty) => Option(String).Some(
      format_decr_rc_atomic_call(format_void_ptr_cast(value_code))
    ),
    true => Option(String).None
  )
);
/// Emit the C dup expression for a leaf RC type shape, given the
/// already-generated `value_code`, its static `ty`, and the codegen
/// context (used to resolve the type's C name).
///
/// Returns:
///   - `Some("((TypeCName){ .data = __yo_incr_rc((void*)(x).data), .vtable = (x).vtable })")`
///     for `Dyn(T)`
///   - `Some("((TypeCName)__yo_incr_rc_atomic((void*)(x)))")` for
///     atomic object types and `Iso(T)`
///   - `Some("((TypeCName)__yo_incr_rc((void*)(x)))")` for non-atomic
///     object types
///   - `None` for everything else (the bootstrap codegen handles these)
///
/// Matches the four leaf cases of `generateDupCodeForValue` in TS,
/// post-`resolveSomeType` filtering. The struct/enum branch (which
/// calls `getDupFunctionForType` for the per-type `___dup` function)
/// is intentionally not handled here — it needs the function-cname
/// registry.
generate_dup_code_for_leaf_type :: (
  fn(value_code : String, ty : TypeValue, ctx : CodegenContext) -> Option(String)
)(
  cond(
    is_dyn_type(ty) => {
      dyn_c_name := get_type_string(ty, ctx);
      incr := format_incr_rc_call(format_void_ptr_data_cast(value_code));
      Option(String).Some(format_dyn_dup_rebuild(dyn_c_name, incr, value_code))
    },
    // Atomic object check MUST precede the general object check.
    is_atomic_object_type(ty) => {
      c_name := get_type_string(ty, ctx);
      incr := format_incr_rc_atomic_call(format_void_ptr_cast(value_code));
      Option(String).Some(format_typed_rc_cast(c_name, incr))
    },
    is_object_type(ty) => {
      c_name := get_type_string(ty, ctx);
      incr := format_incr_rc_call(format_void_ptr_cast(value_code));
      Option(String).Some(format_typed_rc_cast(c_name, incr))
    },
    is_iso_type(ty) => {
      c_name := get_type_string(ty, ctx);
      incr := format_incr_rc_atomic_call(format_void_ptr_cast(value_code));
      Option(String).Some(format_typed_rc_cast(c_name, incr))
    },
    true => Option(String).None
  )
);
export(
  generate_drop_code_for_leaf_type,
  generate_dup_code_for_leaf_type,
  format_typed_rc_cast,
  format_dyn_dup_rebuild
);
