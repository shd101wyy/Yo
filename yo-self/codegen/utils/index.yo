//! Shared codegen utilities — 1-to-1 partial port of
//! `src/codegen/utils/index.ts`.
//!
//! Currently exposed:
//!
//! * `sanitize_for_c_identifier` / `sanitize_for_c_identifier_str` —
//!   canonical identifier-mangling helper used by every codegen
//!   handler that names a C symbol after a Yo variable / field /
//!   type-string. Each non-`[A-Za-z0-9_]` byte is replaced with
//!   `"_u" + decimal(byte) + "_"` so different special characters do
//!   not collide (e.g. `Slice(u8)` → `Slice_u40_u8_u41_`). C / C11
//!   reserved words and common stdlib macros are prefixed with
//!   `__yo_c_reserved_`.
//!
//! * `should_avoid_const` — true for reference-counted object types
//!   that need RC ops on the refcount field, so emitting `const` is
//!   wrong even when the value is not mutated.
//!
//! * `can_optimize_as_simple_enum` — true for enums whose every
//!   variant has no data; lowered to a plain C `enum` rather than a
//!   tagged-union struct.
//!
//! * `can_optimize_as_nullable_pointer` — for `Option(*T)`-shaped
//!   enums, returns the inner `Pointer(T)` so the C lowering can use
//!   the pointer slot with `NULL` standing in for the empty variant.
//!
//! Also ported: `get_type_string` (+ `get_type_string_opt`),
//! `get_variable_type_string` (+ `_str` / `_opt` / `_opt_str`
//! variants), `get_enum_variant_c_name`, `get_variable_name_for_codegen`,
//! `get_deferred_dup_target_atom_name`,
//! `get_deferred_drop_target_atom_name`,
//! `is_deferred_drop_for_closure_capture`, and
//! `is_function_value_with_only_builtin_yo_inline_function_call`.
//!
//! Still pending (4): `is_comptime_only_struct_field` and
//! `get_runtime_struct_fields` (yo-self Struct doesn't yet carry the
//! per-field `isCompileTimeOnly` flag), `is_comptime_function`
//! (needs `Func.return.isCompileTimeOnly`), `find_returned_async_block`
//! (async-runtime traversal).
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_object_type, is_pointer_type } :: import("../../types/guards.yo");
{ type_to_string } :: import("../../types/string.yo");
{ Environment, get_variables_from_env } :: import("../../env.yo");
{
  AstExpr,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  BF_DOT,
  BF_DROP,
  BF_DUP,
  BF_YO_AS,
  BK_BEGIN
} :: import("../../expr.yo");
{ EvalValue } :: import("../../value.yo");
{ type_value_to_c_field } :: import("../types/generation.yo");
{ CodegenContext } :: import("../context.yo");
{ is_builtin_yo_inline_function } :: import("../constants.yo");
is_c_identifier_byte_ :: (fn(byte : u8) -> bool)(
  ((byte >= u8(65)) && (byte <= u8(90))) ||
    (
      ((byte >= u8(97)) && (byte <= u8(122))) ||
        (((byte >= u8(48)) && (byte <= u8(57))) || (byte == u8(95)))
    )
);
append_string_bytes_ :: (fn(out : ArrayList(u8), value : String) -> unit)({
  bytes := value.as_bytes();
  i := usize(0);
  while(i < bytes.len(), i = (i + usize(1)), {
    match(
      bytes.get(i),
      .Some(byte) => {
        out.push(byte);
      },
      .None => ()
    );
  });
});
is_c_reserved_word_ :: (fn(name : String) -> bool)(
  cond(
    (name == String.from("auto")) => true,
    (name == String.from("break")) => true,
    (name == String.from("case")) => true,
    (name == String.from("char")) => true,
    (name == String.from("const")) => true,
    (name == String.from("continue")) => true,
    (name == String.from("default")) => true,
    (name == String.from("do")) => true,
    (name == String.from("double")) => true,
    (name == String.from("else")) => true,
    (name == String.from("enum")) => true,
    (name == String.from("extern")) => true,
    (name == String.from("float")) => true,
    (name == String.from("for")) => true,
    (name == String.from("goto")) => true,
    (name == String.from("if")) => true,
    (name == String.from("inline")) => true,
    (name == String.from("int")) => true,
    (name == String.from("long")) => true,
    (name == String.from("register")) => true,
    (name == String.from("restrict")) => true,
    (name == String.from("return")) => true,
    (name == String.from("short")) => true,
    (name == String.from("signed")) => true,
    (name == String.from("sizeof")) => true,
    (name == String.from("static")) => true,
    (name == String.from("struct")) => true,
    (name == String.from("switch")) => true,
    (name == String.from("typedef")) => true,
    (name == String.from("union")) => true,
    (name == String.from("unsigned")) => true,
    (name == String.from("void")) => true,
    (name == String.from("volatile")) => true,
    (name == String.from("while")) => true,
    (name == String.from("_Alignas")) => true,
    (name == String.from("_Alignof")) => true,
    (name == String.from("_Atomic")) => true,
    (name == String.from("_Bool")) => true,
    (name == String.from("_Complex")) => true,
    (name == String.from("_Generic")) => true,
    (name == String.from("_Imaginary")) => true,
    (name == String.from("_Noreturn")) => true,
    (name == String.from("_Static_assert")) => true,
    (name == String.from("_Thread_local")) => true,
    (name == String.from("errno")) => true,
    (name == String.from("stdin")) => true,
    (name == String.from("stdout")) => true,
    (name == String.from("stderr")) => true,
    (name == String.from("NULL")) => true,
    (name == String.from("true")) => true,
    (name == String.from("false")) => true,
    true => false
  )
);
/// Mangle `value` into a valid C identifier:
///   - keep `[A-Za-z0-9_]` bytes;
///   - replace every other byte with `_u<decimal byte>_`;
///   - prepend `__yo_c_reserved_` if the result is a C / C11 keyword
///     or a well-known stdlib macro.
///
/// 1-to-1 port of `sanitizeForCIdentifier` in
/// `src/codegen/utils/index.ts`. The TS version takes an optional
/// `isExternC` flag that skips the reserved-word remap; the yo-self
/// callers never need that path, so it is omitted until a caller does.
sanitize_for_c_identifier :: (fn(value : String) -> String)({
  bytes := value.as_bytes();
  out := ArrayList(u8).with_capacity(bytes.len());
  i := usize(0);
  while(i < bytes.len(), i = (i + usize(1)), {
    match(
      bytes.get(i),
      .Some(byte) => cond(
        is_c_identifier_byte_(byte) => {
          out.push(byte);
        },
        true => {
          append_string_bytes_(out, String.from("_u"));
          append_string_bytes_(out, byte.to_string());
          append_string_bytes_(out, String.from("_"));
        }
      ),
      .None => ()
    );
  });
  sanitized := String.from_bytes(out);
  return(
    cond(
      is_c_reserved_word_(sanitized) =>
        (String.from("__yo_c_reserved_") + sanitized),
      true => sanitized
    )
  );
});
/// Convenience overload: when callers already have a `str` slice
/// (e.g. from `String::as_str`) they can call this instead of wrapping
/// it in `String::from`. Behaviour is identical.
sanitize_for_c_identifier_str :: (fn(s : str) -> String)(
  sanitize_for_c_identifier(String.from(s))
);
/// True iff a value of type `t` should NOT be marked `const` in the
/// emitted C, even when not mutable — because reference-counted object
/// types need to support RC ops (dup / drop / aliasing) that mutate
/// the underlying refcount field. Mirrors TS `shouldAvoidConst` in
/// `src/codegen/utils/index.ts`.
should_avoid_const :: (fn(t : TypeValue) -> bool)(is_object_type(t));
/// Return `indent + "  "` — a fresh String that is two spaces wider
/// than `indent`. The standard one-level deeper indent used by every
/// block-style codegen (cond arms, begin blocks, while bodies, async
/// continuations, …). Pure string composition.
indent_plus_two :: (fn(indent : String) -> String)(
  indent.clone() + String.from("  ")
);
/// Return `indent` with the trailing two spaces removed (or the empty
/// string when `indent` is shorter than 2). Mirror of
/// `indent_plus_two`. Used by depth-unwind loops in the AND/OR if-chain
/// emitters.
indent_minus_two :: (fn(indent : String) -> String)(
  cond(
    (indent.len() >= usize(2)) => indent.substring(usize(0), indent.len() - usize(2)),
    true => String.new()
  )
);
/// Format an indented C statement line: `<indent><code>;`. The canonical
/// shape used by virtually every codegen handler when emitting a
/// runtime statement (drop calls, dup calls, side-effecting begin-arm
/// args, etc.). Pure string composition; no semicolon-checking — the
/// caller is responsible for ensuring `code` is a valid C expression
/// rather than a statement (and thus needs its own trailing `;`).
format_indented_stmt :: (fn(indent : String, code : String) -> String)({
  s := indent.clone();
  s.push_string(code);
  s.push_str(";");
  s
});
/// Format an indented C line *without* a trailing semicolon:
///   `<indent><body>`
/// Used by async-completion emitters that produce already-complete
/// statements (the body string is expected to include its own `;` or
/// is itself a block-shape line like `if (...) {`). Pure string
/// composition.
format_indented_line :: (fn(indent : String, body : str) -> String)({
  s := indent.clone();
  s.push_str(body);
  s
});
/// Format a typed C variable-init line:
///   `<indent><type_and_name> = <value_code>;`
/// `type_and_name` is the pre-joined "C-type C-name" string (produced
/// by `get_variable_type_string_str` or `format_typed_var_name`).
/// Used by the tuple/array/iso/recur temp-result emitters.
format_typed_init_line :: (
  fn(indent : String, type_and_name : String, value_code : String) -> String
)({
  s := indent.clone();
  s.push_string(type_and_name);
  s.push_str(" = ");
  s.push_string(value_code);
  s.push_str(";");
  s
});
/// Format a bare C variable-decl line (no initializer):
///   `<indent><type_and_name>;`
/// `type_and_name` is the pre-joined "C-type C-name" string. Used by
/// the binding-form codegen for `name : T` declarations and by the
/// cond/begin/match result-temp pre-declarations.
format_typed_decl_line :: (
  fn(indent : String, type_and_name : String) -> String
)({
  s := indent.clone();
  s.push_string(type_and_name);
  s.push_str(";");
  s
});
/// Format an indented closing brace: `<indent>}`. The standard block
/// terminator shared by cond/while/and-or/if-else chain emitters and
/// match's case-block close. Pure string composition.
format_indented_close_brace :: (fn(indent : String) -> String)({
  s := indent.clone();
  s.push_str("}");
  s
});
/// Format a C function call: `<fn_name>(<args_code>)`. The args
/// payload is pre-joined by the caller (commas for multi-arg).
/// Used by recur (`<current_fn>(<args>)`), parallelism
/// (`__yo_thread_spawn(...)`), iso (`__yo_iso_*`), and many other
/// builtin-call emitters.
format_c_function_call :: (fn(fn_name : str, args_code : String) -> String)({
  s := String.from(fn_name);
  s.push_str("(");
  s.push_string(args_code);
  s.push_str(")");
  s
});
/// Format a C cast to `void*`: `(void*)(<value_code>)`. The standard
/// way to pass any pointer-bearing value through the RC runtime
/// (`__yo_*_rc[_atomic]`). Used heavily in drop/dup paths.
format_void_ptr_cast :: (fn(value_code : String) -> String)({
  s := String.from("(void*)(");
  s.push_str(value_code.as_str());
  s.push_str(")");
  s
});
/// Format a Dyn-data cast: `(void*)(<value_code>).data`. Dyn is a
/// fat-pointer struct; the RC-bearing pointer lives on its `.data`
/// field. Used by `format_dyn_drop_call`, `format_dyn_dup_call`, and
/// the Dyn drop/dup leaf emitters.
format_void_ptr_data_cast :: (fn(value_code : String) -> String)({
  s := String.from("(void*)(");
  s.push_str(value_code.as_str());
  s.push_str(").data");
  s
});
/// Format an if-statement opening: `<indent>if (<cond_code>) {`. Shared
/// by cond's first-runtime-arm header and and-or's intermediate-AND
/// chain header.
format_if_open :: (fn(indent : String, cond_code : String) -> String)({
  s := indent.clone();
  s.push_str("if (");
  s.push_string(cond_code);
  s.push_str(") {");
  s
});
/// Format a negated-if-statement opening: `<indent>if (!(<cond_code>)) {`.
/// Used by and-or's intermediate-OR chain header and while's
/// break-on-condition-false guard.
format_if_negate_open :: (fn(indent : String, cond_code : String) -> String)({
  s := indent.clone();
  s.push_str("if (!(");
  s.push_string(cond_code);
  s.push_str(")) {");
  s
});
/// True iff `t` is an enum whose every variant carries no data — so
/// it can be lowered to a plain C `enum` instead of a tagged-union
/// struct. Equivalent to TS `canOptimizeAsSimpleEnum` in
/// `src/codegen/utils/index.ts`. Non-enum types return false.
can_optimize_as_simple_enum :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .EnumT(_, _, _, variant_fields, _, _, _) => {
      // All variant field lists must be empty AND there must be at
      // least one variant.
      all_empty := true;
      i := usize(0);
      while(i < variant_fields.len(), {
        match(
          variant_fields.get(i),
          .None => (),
          .Some(fields) => {
            if(fields.len() > usize(0), {
              all_empty = false;
            });
          }
        );
        i = (i + usize(1));
      });
      all_empty && (variant_fields.len() > usize(0))
    },
    _ => false
  )
);
/// If `t` is an enum that can be represented as a nullable pointer in
/// C (exactly two variants — one empty, one carrying a single
/// `Pointer(_)` field), returns `.Some(child_pointer_type)`;
/// otherwise `.None`. Mirrors TS `canOptimizeAsNullablePointer`.
///
/// The Option(T) / Option(*T) family is the canonical example: lowered
/// to `*T` with `NULL` standing in for `None`.
can_optimize_as_nullable_pointer :: (fn(t : TypeValue) -> Option(TypeValue))(
  match(
    t,
    .EnumT(_, _, _, variant_fields, _, _, _) => cond(
      (variant_fields.len() != usize(2)) => Option(TypeValue).None,
      true => {
        // Track the matched empty / pointer variants. We use sentinel
        // `Option`s rather than booleans so a malformed shape (e.g.
        // two empty variants or two pointer variants) is rejected.
        (empty_found : bool) = false;
        (pointer_payload : Option(TypeValue)) = Option(TypeValue).None;
        (bad : bool) = false;
        (i : usize) = usize(0);
        while((i < variant_fields.len()) && !(bad), {
          match(
            variant_fields.get(i),
            .None => {
              bad = true;
            },
            .Some(fields) => cond(
              (fields.len() == usize(0)) => cond(
                empty_found => {
                  bad = true;
                },
                true => {
                  empty_found = true;
                }
              ),
              (fields.len() == usize(1)) => match(
                fields.get(usize(0)),
                .None => {
                  bad = true;
                },
                .Some(child) => cond(
                  is_pointer_type(child) => cond(
                    pointer_payload.is_some() => {
                      bad = true;
                    },
                    true => {
                      pointer_payload = Option(TypeValue).Some(child);
                    }
                  ),
                  true => {
                    bad = true;
                  }
                )
              ),
              true => {
                bad = true;
              }
            )
          );
          i = (i + usize(1));
        });
        cond(
          bad => Option(TypeValue).None,
          (empty_found && pointer_payload.is_some()) => pointer_payload,
          true => Option(TypeValue).None
        )
      }
    ),
    _ => Option(TypeValue).None
  )
);
/// Look up the C type name for `t`. First consults the registered
/// types in `ctx.types` (keyed by `type_to_string(t)` in yo-self), then
/// falls back to the primitive lowering in `type_value_to_c_field`.
/// Returns `.None` when neither path succeeds.
///
/// `get_type_string` (below) wraps this with the canonical TS
/// `getTypeString` fallback of `"int32_t"` — use that when the caller
/// always wants a string.
get_type_string_opt :: (
  fn(t : TypeValue, ctx : CodegenContext) -> Option(String)
)({
  key := type_to_string(t);
  match(
    ctx.get_type_c_name(key),
    .Some(c_name) => Option(String).Some(c_name),
    .None => type_value_to_c_field(t)
  )
});
/// Canonical C type name for `t`. 1-to-1 port of `getTypeString` in
/// `src/codegen/utils/index.ts`, but without the per-variant tag
/// dispatch — yo-self consults the registry first and only falls back
/// to the simple primitive lowering. Defaults to `"int32_t"` to match
/// TS's outer fallback (the same default the TS `if (!type)` guard
/// uses).
get_type_string :: (
  fn(t : TypeValue, ctx : CodegenContext) -> String
)(
  match(
    get_type_string_opt(t, ctx),
    .Some(s) => s,
    .None => String.from("int32_t")
  )
);
/// Build `"<c_type> <sanitized_var_name>"` — the declaration prefix
/// for a C local with type `t` and Yo name `var_name`. Mirrors TS
/// `getVariableTypeString` in `src/codegen/utils/index.ts`:
///
///     `${getTypeString(type, context)} ${sanitizeForCIdentifier(varName)}`
///
/// Returns a `String` (TS-canonical shape — `int32_t` fallback inside
/// `get_type_string`). The two-argument convenience `_str` overload
/// accepts an already-`str`-typed name.
/// Format `<c_type> <sanitized_name>` — the canonical
/// declaration-fragment shape used by both `get_variable_type_string`
/// (always-Some) and `get_variable_type_string_opt` (defers when the
/// type is unresolved).
format_typed_var_name :: (fn(c_type : String, sanitized_name : String) -> String)({
  s := String.new();
  s.push_string(c_type);
  s.push_str(" ");
  s.push_string(sanitized_name);
  s
});
get_variable_type_string :: (
  fn(t : TypeValue, var_name : String, ctx : CodegenContext) -> String
)({
  c_ty := get_type_string(t, ctx);
  san := sanitize_for_c_identifier(var_name);
  format_typed_var_name(c_ty, san)
});
/// Convenience overload accepting `str` for the variable name.
get_variable_type_string_str :: (
  fn(t : TypeValue, var_name : str, ctx : CodegenContext) -> String
)(get_variable_type_string(t, String.from(var_name), ctx));
/// Deferral variant of `get_variable_type_string`: returns `.None`
/// when `get_type_string_opt(t, ctx)` misses (i.e. the type is neither
/// in the registry nor a primitive). Useful for handlers that want to
/// defer to the legacy bootstrap codegen rather than emit an
/// `int32_t` cast that would be wrong.
get_variable_type_string_opt :: (
  fn(t : TypeValue, var_name : String, ctx : CodegenContext) -> Option(String)
)(
  match(
    get_type_string_opt(t, ctx),
    .None => Option(String).None,
    .Some(c_ty) => Option(String).Some(
      format_typed_var_name(c_ty, sanitize_for_c_identifier(var_name))
    )
  )
);
/// Convenience `str` overload of `get_variable_type_string_opt`.
get_variable_type_string_opt_str :: (
  fn(t : TypeValue, var_name : str, ctx : CodegenContext) -> Option(String)
)(get_variable_type_string_opt(t, String.from(var_name), ctx));
/// C name for the variant `variant_name` of enum `enum_ty`. Mirrors
/// TS `getEnumVariantCName` in `src/codegen/utils/index.ts`:
///
///     `${UPPER(enumCName)}_${UPPER(variant_name)}`
///
/// Returns `.None` when the enum is not yet registered in
/// `ctx.types` (the TS counterpart throws; yo-self defers to the
/// caller so the bootstrap path can recover). The registry is keyed
/// by `type_to_string(enum_ty)` in yo-self (TS keys by `enum.id`); the
/// payload's `c_name` field carries the canonical lower-case form.
get_enum_variant_c_name :: (
  fn(enum_ty : TypeValue, variant_name : String, ctx : CodegenContext) -> Option(String)
)({
  key := type_to_string(enum_ty);
  match(
    ctx.get_type_c_name(key),
    .None => Option(String).None,
    .Some(c_name) => {
      result := c_name.to_uppercase();
      result.push_str("_");
      result.push_string(variant_name.to_uppercase());
      Option(String).Some(result)
    }
  )
});
/// Sanitised C name for the variable named `variable_name`. When
/// `env` is `.Some`, looks up the most-recent binding of that name
/// and uses its actual `Variable.name` (so `getVariableNameForCodegen`
/// returns the underlying variable, not a parameter alias). Mirrors
/// TS `getVariableNameForCodegen` in `src/codegen/utils/index.ts`.
///
/// **Divergence note:** TS passes `variable.type.isExtern === "c"` as
/// the `isExternC` flag so reserved-word remapping is skipped for
/// extern-C names. yo-self's `TypeValue` does not yet carry the
/// `is_extern` field, so the canonical mangler always applies the
/// reserved-word remap. This is documented at the
/// `sanitize_for_c_identifier` declaration.
get_variable_name_for_codegen :: (
  fn(variable_name : String, env : Option(Environment)) -> String
)(
  match(
    env,
    .None => sanitize_for_c_identifier(variable_name),
    .Some(e) => {
      variables := get_variables_from_env(e, variable_name);
      n := variables.len();
      cond(
        (n == usize(0)) => sanitize_for_c_identifier(variable_name),
        true => match(
          variables.get(n - usize(1)),
          .None => sanitize_for_c_identifier(variable_name),
          .Some(latest) => sanitize_for_c_identifier(latest.name)
        )
      )
    }
  )
);
/// Walk a `___dup`-style expression and extract the variable name it
/// targets. Two shapes are recognised, matching TS
/// `getDeferredDupTargetAtomName` in `src/codegen/utils/index.ts`:
///
///   1. `___dup(x)`         — pre-evaluation form (positional call).
///   2. `(x.___dup)()`      — post-evaluation method-style call where
///                            `x.___dup` is a `(.)` FnCall with two
///                            atom args (`x`, `___dup`).
///
/// Returns the variable name on match, `.None` otherwise. Pure — no
/// codegen context, env, or evaluator required.
get_deferred_dup_target_atom_name :: (
  fn(dup_expr : AstExpr) -> Option(String)
)(
  match(
    dup_expr,
    .Atom(_, _) => Option(String).None,
    .FnCall({ func, args }) => cond(
      // Form 1: a positional call with >=1 arg whose first arg is an
      // atom. Always wins when matched — even if the func happens to
      // be `.` (no real-world call site shares both forms).
      (args.len() >= usize(1)) => match(
        args.get(usize(0)),
        .None => Option(String).None,
        .Some(first) => match(
          first,
          .Atom({ token }) => Option(String).Some(token.value),
          .FnCall(_, _, _, _, _) => Option(String).None
        )
      ),
      // Form 2: zero args, func is `(x.___dup)`.
      (args.len() == usize(0)) => cond(
        ast_expr_is_fn_call_of(func.*, BF_DOT, Option(usize).Some(usize(2))) => match(
          func.*,
          .Atom(_, _) => Option(String).None,
          .FnCall({ args : dot_args }) => match(
            dot_args.get(usize(0)),
            .None => Option(String).None,
            .Some(lhs) => match(
              dot_args.get(usize(1)),
              .None => Option(String).None,
              .Some(rhs) => match(
                lhs,
                .Atom({ token : lhs_tok }) => match(
                  rhs,
                  .Atom({ token : rhs_tok }) => cond(
                    (rhs_tok.value == BF_DUP) =>
                      Option(String).Some(lhs_tok.value),
                    true => Option(String).None
                  ),
                  .FnCall(_, _, _, _, _) => Option(String).None
                ),
                .FnCall(_, _, _, _, _) => Option(String).None
              )
            )
          )
        ),
        true => Option(String).None
      ),
      true => Option(String).None
    )
  )
);
/// Walk a `___drop`-style expression and extract the variable name it
/// targets. Two shapes are recognised, matching TS
/// `getDeferredDropTargetAtomName`:
///
///   1. `(x.___drop)()`     — method-style call (checked first so it
///                            wins when the same shape happens to also
///                            match form 2 below — TS code orders them
///                            identically).
///   2. `___drop(x)`        — positional call.
///
/// Returns the variable name on match, `.None` otherwise.
get_deferred_drop_target_atom_name :: (
  fn(drop_expr : AstExpr) -> Option(String)
)(
  match(
    drop_expr,
    .Atom(_, _) => Option(String).None,
    .FnCall({ func, args }) => cond(
      // Form 1: method-style `(x.___drop)()`.
      (
        (args.len() == usize(0)) &&
          ast_expr_is_fn_call_of(func.*, BF_DOT, Option(usize).Some(usize(2)))
      ) => match(
        func.*,
        .Atom(_, _) => Option(String).None,
        .FnCall({ args : dot_args }) => match(
          dot_args.get(usize(0)),
          .None => Option(String).None,
          .Some(lhs) => match(
            dot_args.get(usize(1)),
            .None => Option(String).None,
            .Some(rhs) => match(
              lhs,
              .Atom({ token : lhs_tok }) => match(
                rhs,
                .Atom({ token : rhs_tok }) => cond(
                  (rhs_tok.value == BF_DROP) =>
                    Option(String).Some(lhs_tok.value),
                  true => Option(String).None
                ),
                .FnCall(_, _, _, _, _) => Option(String).None
              ),
              .FnCall(_, _, _, _, _) => Option(String).None
            )
          )
        )
      ),
      // Form 2: positional `___drop(x)`.
      (
        ast_expr_is_fn_call_of(drop_expr, BF_DROP, Option(usize).None) &&
          (args.len() >= usize(1))
      ) => match(
        args.get(usize(0)),
        .None => Option(String).None,
        .Some(first) => match(
          first,
          .Atom({ token }) => Option(String).Some(token.value),
          .FnCall(_, _, _, _, _) => Option(String).None
        )
      ),
      true => Option(String).None
    )
  )
);
/// True iff `drop_expr` targets a variable that the current closure
/// has captured. Mirrors TS `isDeferredDropForClosureCapture`. The
/// captures list is supplied by the caller (the enclosing function's
/// `CodegenContext` carries it during closure-body emission).
is_deferred_drop_for_closure_capture :: (
  fn(drop_expr : AstExpr, current_closure_captures : ArrayList(String)) -> bool
)(
  match(
    get_deferred_drop_target_atom_name(drop_expr),
    .None => false,
    .Some(target) => {
      found := false;
      i := usize(0);
      while((i < current_closure_captures.len()) && !(found), {
        match(
          current_closure_captures.get(i),
          .None => (),
          .Some(name) => if(name == target, {
            found = true;
          })
        );
        i = (i + usize(1));
      });
      found
    }
  )
);
/// Helper: extract the func-token value from a FnCall whose func is
/// an Atom (returns `.None` for nested FnCall funcs or for Atom-shaped
/// expressions). Used by `is_function_value_with_only_builtin_yo_inline_function_call`.
_fn_call_func_atom_name :: (fn(e : AstExpr) -> Option(String))(
  match(
    e,
    .Atom(_, _) => Option(String).None,
    .FnCall({ func }) => match(
      func.*,
      .Atom({ token }) => Option(String).Some(token.value),
      .FnCall(_, _, _, _, _) => Option(String).None
    )
  )
);
/// True iff `body` is a 1-arg `begin(inner_call)` whose inner call is
/// itself a `FnCall(<inline-builtin>, ...)`. Used to recognise the
/// `(_) -> { __yo_op_add(_,_) }` body shape that wraps a single
/// inline-emit builtin call.
_body_is_begin_wrapping_inline_call :: (fn(body : AstExpr) -> Option(String))(
  cond(
    !(ast_expr_is_fn_call_of(body, BK_BEGIN, Option(usize).Some(usize(1)))) =>
      Option(String).None,
    true => match(
      body,
      .Atom(_, _) => Option(String).None,
      .FnCall({ args }) => match(
        args.get(usize(0)),
        .None => Option(String).None,
        .Some(inner) => match(
          _fn_call_func_atom_name(inner),
          .None => Option(String).None,
          .Some(name) => cond(
            is_builtin_yo_inline_function(name.as_str()) => Option(String).Some(name),
            true => Option(String).None
          )
        )
      )
    )
  )
);
/// Detect a `FuncVal` whose body is a direct call to (or a
/// 1-arg-begin-wrapped call to) one of the inline-emit builtins.
/// Returns the operator name when eligible, `.None` otherwise.
///
/// Mirrors TS `isFunctionValueWithOnlyBuiltinYoInlineFunctionCall` in
/// `src/codegen/utils/index.ts`. The `__yo_as` builtin is excluded
/// because its argument expression needs proper function-call
/// handling.
///
/// Used by the codegen dispatcher to recognise functions that can
/// be inlined into the call site (e.g. `fn add(x, y) :: x + y` →
/// emit `x + y` directly at the call site rather than
/// `add(x, y)`).
is_function_value_with_only_builtin_yo_inline_function_call :: (
  fn(func_val : EvalValue) -> Option(String)
)(
  match(
    func_val,
    .FuncVal({ body }) => match(
      _body_is_begin_wrapping_inline_call(body.*),
      .Some(name) => cond(
        (name == BF_YO_AS) => Option(String).None,
        true => Option(String).Some(name)
      ),
      .None => match(
        _fn_call_func_atom_name(body.*),
        .None => Option(String).None,
        .Some(name) => cond(
          (name == BF_YO_AS) => Option(String).None,
          is_builtin_yo_inline_function(name.as_str()) => Option(String).Some(name),
          true => Option(String).None
        )
      )
    ),
    _ => Option(String).None
  )
);
export(
  sanitize_for_c_identifier,
  sanitize_for_c_identifier_str,
  should_avoid_const,
  can_optimize_as_simple_enum,
  can_optimize_as_nullable_pointer,
  get_enum_variant_c_name,
  get_type_string,
  get_type_string_opt,
  get_variable_type_string,
  get_variable_type_string_str,
  get_variable_type_string_opt,
  get_variable_type_string_opt_str,
  format_typed_var_name,
  indent_plus_two,
  indent_minus_two,
  format_indented_stmt,
  format_indented_line,
  format_typed_init_line,
  format_typed_decl_line,
  format_indented_close_brace,
  format_if_open,
  format_if_negate_open,
  format_c_function_call,
  format_void_ptr_cast,
  format_void_ptr_data_cast,
  get_variable_name_for_codegen,
  get_deferred_dup_target_atom_name,
  get_deferred_drop_target_atom_name,
  is_deferred_drop_for_closure_capture,
  is_function_value_with_only_builtin_yo_inline_function_call
);
