//! 1-to-1 port of `src/codegen/utils/fixup.ts`.
//!
//! After type generation runs and every `dyn_impls` entry's
//! `dyn_type` / `concrete_type` have registered C names, rebuild
//! the impl-keys to use those C names instead of pre-generation
//! ids.
//!
//! yo-self's `generate_dyn_for_resolved_inputs` already keys its
//! entries by `${concrete_c_name}_${dyn_c_name}` at insertion time
//! (using `get_type_string` for the lookup), so for the yo-self
//! pipeline this fixup is a no-op rather than a rename. Keeping
//! the function present and signature-faithful means TS porters
//! find the same identifier, and any future evaluator that
//! registers `dyn_impls` with id-style keys (e.g. before type
//! registration) gets a working fix-up pass automatically.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TypeValue } :: import("../../types/definitions.yo");
{ extract_fn_trait_from_type } :: import("../../evaluator/trait_checking.yo");
{ CodegenContext, CodegenDynImplEntry } :: import("../context.yo");
{ get_type_string_opt } :: import("./index.yo");
{ format_dyn_impl_key } :: import("../exprs/dyn.yo");
/// Compute the impl-key form `${concrete_c_name}_${dyn_c_name}` for a
/// registered `dyn_impls` entry. Uses the canonical
/// `get_type_string_opt` chain (registry → primitive → None) and
/// falls back through `extract_fn_trait_from_type` for boxed closures
/// whose concrete type is the `Impl(Fn(...))` wrapper. Mirrors the
/// `(() => { ... })()` IIFE in TS `fixupDynImplKeys`.
_impl_key_for_entry :: (fn(entry : CodegenDynImplEntry, ctx : CodegenContext) -> String)({
  dyn_c_name := match(
    get_type_string_opt(entry.dyn_type, ctx),
    .Some(s) => s,
    .None => String.from("int32_t")
  );
  concrete_c_name := match(
    get_type_string_opt(entry.concrete_type, ctx),
    .Some(s) => s,
    .None => match(
      extract_fn_trait_from_type(entry.concrete_type),
      .None => String.from("int32_t"),
      .Some(fn_trait) => match(
        get_type_string_opt(fn_trait, ctx),
        .Some(s) => s,
        .None => String.from("int32_t")
      )
    )
  );
  format_dyn_impl_key(concrete_c_name, dyn_c_name)
});
/// Walk every entry in `ctx.dyn_impls`, compute its new key via
/// `_impl_key_for_entry`, and append to the parallel `out_keys` /
/// `out_entries` lists. yo-self's `HashMap` doesn't expose a
/// stable `.entries()`, so we walk the keys iterator and
/// `.get(k)` each one in turn.
for_each_dyn_impl_ :: (
  fn(ctx : CodegenContext, out_keys : ArrayList(String), out_entries : ArrayList(CodegenDynImplEntry)) -> unit
)({
  // Collect old keys first.
  old_keys := ArrayList(String).new();
  keys_iter := ctx.dyn_impls.keys();
  while(true, {
    match(
      keys_iter.next(),
      .None => break,
      .Some(k) => {
        old_keys.push(k);
      }
    );
  });
  i := usize(0);
  while(i < old_keys.len(), {
    match(
      old_keys.get(i),
      .None => (),
      .Some(k) => match(
        ctx.dyn_impls.get(k),
        .None => (),
        .Some(entry) => {
          new_key := _impl_key_for_entry(entry, ctx);
          out_keys.push(new_key);
          out_entries.push(entry);
        }
      )
    );
    i = (i + usize(1));
  });
});
/// Rebuild `ctx.dyn_impls` with C-name-based keys. After this
/// runs every entry is keyed by `${concrete_c_name}_${dyn_c_name}`.
/// Mirrors TS `fixupDynImplKeys`.
fixup_dyn_impl_keys :: (fn(ctx : CodegenContext) -> unit)({
  // Collect new (key, entry) pairs first so we don't mutate the
  // map while iterating.
  new_keys := ArrayList(String).new();
  new_entries := ArrayList(CodegenDynImplEntry).new();
  for_each_dyn_impl_(ctx, new_keys, new_entries);
  // Replace the entire map.
  ctx.dyn_impls = HashMap(String, CodegenDynImplEntry).new();
  i := usize(0);
  while(i < new_keys.len(), {
    match(
      new_keys.get(i),
      .None => (),
      .Some(k) => match(
        new_entries.get(i),
        .None => (),
        .Some(e) => {
          _ := ctx.dyn_impls.set(k, e);
        }
      )
    );
    i = (i + usize(1));
  });
});
export(fixup_dyn_impl_keys);
