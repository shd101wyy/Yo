//! Reachable-type collection — mirrors `src/codegen/types/collection.ts`.
//!
//! PORT STATUS (incremental, plans/BOOTSTRAPPING_CODEGEN.md Phase 1): this
//! file currently carries the TYPE-structural collectors (collect_type +
//! collect_types_from_function_type + the SomeType-in-fn-fields helpers). The
//! EXPR walkers (collect_types_from_expr / collect_required_types) are
//! deferred: they thread the ExprInfoTable and mutually import
//! functions/collection (findFunctionCallsInExpr) — added with that cluster.
//!
//! DIVERGENCES (issues/codegen-port-type-model-gaps.md):
//!   * Gap 6: yo-self `SomeT` has no resolvedConcreteType, so collect_type
//!     conservatively SKIPS SomeTypes (generic — monomorphized before codegen
//!     in the supported corpus); the TS Fn/Future/resolvedConcreteType
//!     branches are pending the env+substitute re-architecting.
//!   * Gap 3: extern-C type names (`type.externName`) aren't modelled
//!     generally, so C names are `sanitize(__yo_<type_key>)`.
//!   * SourceNamespace/Trait field-FUNCTION collection (TS `field.assignedValue`)
//!     is deferred — yo-self types carry no field values; those functions are
//!     reached from the module StructVal via the expr walker instead.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ TypeValue } :: import("../../types/definitions.yo");
{ AstExpr, ast_expr_id, ast_expr_is_fn_call_of, make_err_expr, BK_TEST } :: import("../../expr.yo");
{ ExprInfoTable, expr_info_table_get } :: import("../../expr_info.yo");
{ EvalValue, is_func_val, is_type_value, type_of_eval_value } :: import("../../value.yo");
{ is_control_fn, get_func_type } :: import("../../function_value.yo");
{
  is_struct_type,
  is_enum_type,
  is_union_type,
  is_tuple_type,
  is_dyn_type,
  is_iso_type,
  is_module_type,
  is_trait_type,
  is_some_type,
  is_function_type,
  is_array_type
} :: import("../../types/guards.yo");
{ type_contains_some_type } :: import("../../types/utils.yo");
{
  CodeGenContext,
  type_key,
  get_type_string,
  get_runtime_struct_fields,
  sanitize_for_c_identifier
} :: import("../utils/index.yo");
// Cross-file cycle: functions/collection imports collect_type from here; we
// import its find-fn through the indirection call-through (which reads a
// runtime-set global, so it does not reference find_function_calls_in_expr at
// import time). The circular-import loader resolves the top-level exports.
{ _call_find_function_calls_in_expr, set_collect_type_fn } :: import("../functions/collection.yo");
/// A struct whose only SomeType content lives inside function-typed fields is
/// still registerable as a concrete C type — the fn-ptr fields get type-erased
/// at the C ABI. Mirrors `structSomeTypeIsOnlyInFunctionFields`.
_struct_some_type_is_only_in_function_fields :: (
  fn(type : TypeValue, visited : HashSet(String)) -> bool
)(
  match(
    type,
    .Struct({ id, field_types }) => {
      if(visited.contains(id.clone()), {
        return(true); // cyclic reference is fine
      });
      _a := visited.add(id.clone());
      (ok : bool) = true;
      n := field_types.len();
      (i : usize) = usize(0);
      while((i < n) && ok, {
        ft := match(field_types.get(i),.Some(t) => t,.None => TypeValue.Unit);
        cond(
          is_function_type(ft) => (),
          // fn-ptr field — fine
          (is_struct_type(ft) && recur(ft, visited)) => (),
          // nested ok
          type_contains_some_type(ft) => {
            ok = false;
          },
          true => ()
        );
        i = (i + usize(1));
      });
      ok
    },
    _ => false
  )
);
/// Check if an enum's SomeType content is only in function-typed variant
/// fields. Mirrors `enumSomeTypeIsOnlyInFunctionFields`.
_enum_some_type_is_only_in_function_fields :: (
  fn(type : TypeValue, visited : HashSet(String)) -> bool
)(
  match(
    type,
    .EnumT({ id, variant_fields }) => {
      if(visited.contains(id.clone()), {
        return(true);
      });
      _a := visited.add(id.clone());
      (ok : bool) = true;
      nv := variant_fields.len();
      (vi : usize) = usize(0);
      while((vi < nv) && ok, {
        fields := match(variant_fields.get(vi),.Some(f) => f,.None => ArrayList(TypeValue).new());
        nf := fields.len();
        (fi : usize) = usize(0);
        while((fi < nf) && ok, {
          ft := match(fields.get(fi),.Some(t) => t,.None => TypeValue.Unit);
          cond(
            is_function_type(ft) => (),
            (is_struct_type(ft) && _struct_some_type_is_only_in_function_fields(ft, visited)) => (),
            is_dyn_type(ft) => (),
            type_contains_some_type(ft) => {
              ok = false;
            },
            true => ()
          );
          fi = (fi + usize(1));
        });
        vi = (vi + usize(1));
      });
      ok
    },
    _ => false
  )
);
/// Collect a single type if it's a user-defined / structural type, registering
/// it in `context.types` and recursing into its component types. Mirrors
/// `collectType` (TYPE-structural portion; see header for deferred branches).
collect_type :: (fn(type : TypeValue, context : CodeGenContext) -> unit)({
  if(context.get_type_entry(type_key(type)).is_some(), {
    return(()); // Already collected this type
  });
  // Gap 6: SomeTypes (generic) — conservatively skip (monomorphized before
  // codegen in the supported corpus). The TS Fn/Future/resolvedConcreteType
  // branches need env+substitute resolution.
  if(is_some_type(type), {
    return(());
  });
  // Skip types that contain SomeType (generic params), except struct/enum
  // whose only SomeType content is inside function-typed fields.
  if(type_contains_some_type(type), {
    keep := (
      (is_struct_type(type) && _struct_some_type_is_only_in_function_fields(type, HashSet(String).new()))
      || (is_enum_type(type) && _enum_some_type_is_only_in_function_fields(type, HashSet(String).new()))
    );
    if(!(keep), {
      return(());
    });
  });
  // Concrete-length arrays lower to a generated `struct { T data[N]; }` wrapper.
  // get_type_string registers it (array_struct_types) but only LAZILY when a
  // value/body references the type — which is AFTER generate_array_struct_
  // declarations runs in the type-decl phase. Register it here, during
  // collection, so the typedef is emitted before any reference; also collect
  // the element type. (Mirrors the Iso side-effect registration below.)
  if(is_array_type(type), {
    match(type,.Array({ element }) => recur(element.*, context), _ => ());
    _gs := get_type_string(type, context);
    return(());
  });
  is_registerable := (
    (
      ((is_struct_type(type) || is_union_type(type)) || (is_enum_type(type) || is_tuple_type(type)))
      || (is_dyn_type(type) || is_trait_type(type))
    )
    || (is_module_type(type) || is_iso_type(type))
  );
  if(is_registerable, {
    // Gap 3: extern-C names not modelled generally — use a sanitized mangled
    // name derived from the registry key.
    raw_name := String.from("__yo_");
    raw_name.push_string(type_key(type));
    c_name := sanitize_for_c_identifier(raw_name, false);
    context.register_type(type_key(type), type, c_name, Option(String).None);
    // Struct fields (skip function-typed fields — emitted inline at call sites).
    match(
      type,
      .Struct({}) => {
        runtime_fields := get_runtime_struct_fields(type);
        n := runtime_fields.len();
        (i : usize) = usize(0);
        while(i < n, {
          match(
            runtime_fields.get(i),
            .Some(rf) => if(!(is_function_type(rf.ty)), {
              recur(rf.ty, context);
            }),
            .None => ()
          );
          i = (i + usize(1));
        });
      },
      _ => ()
    );
    // Enum variant fields.
    match(
      type,
      .EnumT({ variant_fields }) => {
        nv := variant_fields.len();
        (vi : usize) = usize(0);
        while(vi < nv, {
          fields := match(variant_fields.get(vi),.Some(f) => f,.None => ArrayList(TypeValue).new());
          nf := fields.len();
          (fi : usize) = usize(0);
          while(fi < nf, {
            match(
              fields.get(fi),
              .Some(ft) => if(!(is_function_type(ft)), {
                recur(ft, context);
              }),
              .None => ()
            );
            fi = (fi + usize(1));
          });
          vi = (vi + usize(1));
        });
      },
      _ => ()
    );
    // Union fields.
    match(
      type,
      .Union({ field_types }) => {
        n := field_types.len();
        (i : usize) = usize(0);
        while(i < n, {
          match(field_types.get(i),.Some(ft) => recur(ft, context),.None => ());
          i = (i + usize(1));
        });
      },
      _ => ()
    );
    // Dyn required traits.
    match(
      type,
      .DynT({ required_trait_types }) => {
        n := required_trait_types.len();
        (i : usize) = usize(0);
        while(i < n, {
          match(required_trait_types.get(i),.Some(tt) => recur(tt, context),.None => ());
          i = (i + usize(1));
        });
      },
      _ => ()
    );
    // Iso child + register the Iso type (via get_type_string side-effect).
    match(
      type,
      .IsoT({ child }) => {
        recur(child.*, context);
        _gs := get_type_string(type, context);
      },
      _ => ()
    );
    // SourceNamespace / Trait field TYPES (field-function collection deferred).
    // A trait METHOD is a `Func` field type; `collect_type(Func)` erases the
    // function and never walks its param/return types, so a method's return type
    // (which codegen LOWERS when emitting the trait's Dyn vtable) goes
    // uncollected — e.g. `Error.source : fn(self : Self) -> Option(Dyn(Error))`
    // leaves `Option(Dyn(Error))` uncollected → "type not collected before
    // lowering" when compiling any module using `std/error` (lexer.yo). So for a
    // Func field, recur into its param + result types. (Can't call
    // `collect_types_from_function_type` — it is defined after this; no forward
    // refs. The register-before-recurse order above breaks the Error→source→Error
    // cycle: the second encounter early-returns on the already-registered key.)
    match(
      type,
      .TraitT({ field_types }) => {
        n := field_types.len();
        (i : usize) = usize(0);
        while(i < n, {
          match(
            field_types.get(i),
            .Some(ft) => match(
              ft,
              .Func({ param_types : __mpt, result : __mres }) => {
                (__mpi : usize) = usize(0);
                while(__mpi < __mpt.len(), {
                  match(__mpt.get(__mpi),.Some(__pt) => recur(__pt, context),.None => ());
                  __mpi = (__mpi + usize(1));
                });
                recur(__mres.*, context);
              },
              _ => recur(ft, context)
            ),
            .None => ()
          );
          i = (i + usize(1));
        });
      },
      _ => ()
    );
  });
});
/// Collect types from a function type signature (parameters, forall params,
/// return). Mirrors `collectTypesFromFunctionType`.
collect_types_from_function_type :: (fn(function_type : TypeValue, context : CodeGenContext) -> unit)(
  match(
    function_type,
    .Func({ param_types, forall_types, result }) => {
      np := param_types.len();
      (pi : usize) = usize(0);
      while(pi < np, {
        match(param_types.get(pi),.Some(pt) => collect_type(pt, context),.None => ());
        pi = (pi + usize(1));
      });
      nf := forall_types.len();
      (fi : usize) = usize(0);
      while(fi < nf, {
        match(forall_types.get(fi),.Some(ft) => collect_type(ft, context),.None => ());
        fi = (fi + usize(1));
      });
      collect_type(result.*, context);
    },
    _ => ()
  )
);
/// func_id of a FuncVal EvalValue, or "".
_fv_id :: (fn(v : EvalValue) -> String)(
  match(v,.FuncVal(_, _, _, _, _, _, _, _, fid) => fid, _ => String.from(""))
);
/// body AstExpr of a FuncVal EvalValue, or an error placeholder.
_fv_body :: (fn(v : EvalValue) -> AstExpr)(
  match(v,.FuncVal(_, _, _, _, b, _, _, _, _) => b.*, _ => make_err_expr())
);
/// Collect types referenced by an expression (its evaluated type, any function
/// value it resolves to, deferred drops, macro expansion, runtime
/// destructurings, capture struct, and recursively its sub-expressions).
/// Mirrors `collectTypesFromExpr`.
///
/// DIVERGENCES: the per-function SIGNATURE-type collection
/// (collectTypesFromFunctionType(functionValue.type)) is omitted — yo-self's
/// FuncVal carries no Func type (Gap 2); signature types are picked up by
/// walking the body. The SomeType-Future-resolvedConcrete skip (Gap 6) and the
/// captureType.trait function-collection are also omitted (corpus-safe).
collect_types_from_expr :: (fn(expr : AstExpr, context : CodeGenContext, info : ExprInfoTable) -> unit)({
  ei_opt := expr_info_table_get(info, ast_expr_id(expr));
  match(
    ei_opt,
    .Some(ei) => {
      // The expression's own type.
      collect_type(ei.ty, context);
      // A function value it resolves to (e.g. method lookups like temp.___drop).
      match(
        ei.value,
        .Some(v) => if(is_func_val(v), {
          fid := _fv_id(v);
          cond(
            is_control_fn(fid.clone()) => {
              _call_find_function_calls_in_expr(_fv_body(v), context, info);
            },
            (!(context.has_function(fid.clone()))) => {
              context.register_function(fid.clone(), v, sanitize_for_c_identifier(fid.clone(), false));
              _call_find_function_calls_in_expr(_fv_body(v), context, info);
            },
            true => ()
          );
        }),
        .None => ()
      );
      // Deferred drop expressions.
      match(
        ei.deferred_drop_expressions,
        .Some(drops) => {
          nd := drops.len();
          (di : usize) = usize(0);
          while(di < nd, {
            match(drops.get(di),.Some(de) => recur(de, context, info),.None => ());
            di = (di + usize(1));
          });
        },
        .None => ()
      );
      // Macro expansion.
      match(ei.macro_expansion,.Some(me) => recur(me, context, info),.None => ());
      // Runtime destructurings (comptime→runtime conversions).
      match(
        ei.runtime_destructurings,
        .Some(rds) => {
          nr := rds.len();
          (ri : usize) = usize(0);
          while(ri < nr, {
            match(rds.get(ri),.Some(rd) => collect_type(rd.ty, context),.None => ());
            ri = (ri + usize(1));
          });
        },
        .None => ()
      );
      // Capture struct type for closures / async blocks (registers + recurses
      // into field types via collect_type).
      match(ei.capture_type,.Some(ct) => collect_type(ct, context),.None => ());
    },
    .None => ()
  );
  match(
    expr,
    .FnCall(_, func_box, args, _, _) => {
      // Skip test blocks — they should not generate code.
      if(ast_expr_is_fn_call_of(expr, BK_TEST,.None), {
        return(());
      });
      recur(func_box.*, context, info);
      n := args.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(args.get(i),.Some(a) => recur(a, context, info),.None => ());
        i = (i + usize(1));
      });
    },
    .Atom(_, _) => match(
      ei_opt,
      .Some(ei) => if(is_type_value(ei.value), {
        match(ei.value,.Some(v) => match(v,.TypeVal(t) => collect_type(t.*, context), _ => ()),.None => ());
      }),
      .None => ()
    )
  );
});
/// Collect all user-defined types reachable from a module value: from each
/// exported function's body, from module-level non-function fields, and then
/// (fixpoint) from every function discovered along the way. Mirrors
/// `collectRequiredTypes`. (Signature-type collection omitted — Gap 2; the
/// moduleLevelInitExprs pass is deferred until the context carries them.)
collect_required_types :: (fn(module_value : EvalValue, context : CodeGenContext, info : ExprInfoTable) -> unit)({
  match(
    module_value,
    .StructVal(_, _, field_values) => {
      n := field_values.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          field_values.get(i),
          .Some(value) => cond(
            is_func_val(value) => {
              // Collect the function's SIGNATURE types (param + return), not just
              // its body — a param type used only in the signature (e.g. a
              // non-async `main(io : Io)` whose body never mentions Io) would
              // otherwise never be collected. Bridges Gap 2 via the get_func_type
              // side-table. Mirrors collectTypesFromFunctionType (collection.ts:127).
              collect_types_from_function_type(get_func_type(_fv_id(value)), context);
              collect_types_from_expr(_fv_body(value), context, info);
            },
            true => {
              vt := type_of_eval_value(value);
              if(!(is_function_type(vt)), {
                collect_type(vt, context);
              });
            }
          ),
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  );
  // Fixpoint: keep collecting from newly-discovered functions until none are
  // new. Snapshot the keys each pass (the registry grows during collection).
  processed := HashSet(String).new();
  (found_new : bool) = true;
  while(found_new, {
    found_new = false;
    keys := ArrayList(String).new();
    kit := context.functions.keys();
    (kdone : bool) = false;
    while(!(kdone), {
      match(
        kit.next(),
        .Some(k) => {
          _kp := keys.push(k);
        },
        .None => {
          kdone = true;
        }
      );
    });
    nk := keys.len();
    (ki : usize) = usize(0);
    while(ki < nk, {
      key := match(keys.get(ki),.Some(k) => k,.None => String.from(""));
      if(!(processed.contains(key.clone())), {
        _p := processed.add(key.clone());
        found_new = true;
        match(
          context.get_function_entry(key.clone()),
          .Some(entry) => {
            // Signature types (param + return) in addition to the body — see the
            // module-level branch above. Mirrors collectTypesFromFunctionType.
            collect_types_from_function_type(get_func_type(key.clone()), context);
            collect_types_from_expr(_fv_body(entry.value), context, info);
          },
          .None => ()
        );
      });
      ki = (ki + usize(1));
    });
  });
});
/// Register collect_type into functions/collection's indirection global so its
/// find_function_calls_in_expr can collect comptime-returned types. Call once
/// at init (alongside register_find_function_calls_in_expr).
register_collect_type :: (fn() -> unit)(
  set_collect_type_fn(collect_type)
);
export(collect_type, collect_types_from_function_type, collect_types_from_expr, collect_required_types, register_collect_type);
