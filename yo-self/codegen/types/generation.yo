//! Type declaration + per-type RC helper-function code generation for the
//! self-hosted Yo C code generator. Partial port of
//! `src/codegen/types/generation.ts` (the TS file is ~1300 lines and also
//! handles the more complex iso/dyn/some/forall lowering cases).
//!
//! Phase 4e: generate C type declarations (struct/enum/union layouts) from
//! `TypeValue` instances.
//!
//! Phase 4i (folded in from the former `codegen/rc.yo`): generate per-type
//! `___dispose` / `___drop` / `___dup` helper functions for structs and
//! enums whose fields are all primitive (no heap-allocated RC objects).
//!
//! C naming conventions (mirrors the TypeScript compiler):
//!   Struct:  __yo_struct_{module_id}_id_{type_id}
//!   Enum:    __yo_enum_{module_id}_id_{type_id}
//!
//! Simple enums (all unit variants) compile to a `typedef enum { ... }`.
//! Data enums compile to a forward-declared struct containing a tag enum and
//! a data union.
//! Structs compile to a forward-declared struct.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue } :: import("../../types/definitions.yo");
{ get_struct_fields } :: import("../../evaluator/types/field.yo");
{ CodegenContext } :: import("../context.yo");
// ---------------------------------------------------------------------------
// C name helpers
// ---------------------------------------------------------------------------
/// Build `__yo_struct_{module_id}_id_{type_id}`.
struct_c_name :: (fn(module_id : str, type_id : usize) -> String)({
  result := String.from("__yo_struct_");
  result.push_str(module_id);
  result.push_str("_id_");
  result.push_string(type_id.to_string());
  result
});
/// Build `__yo_enum_{module_id}_id_{type_id}`.
enum_c_name :: (fn(module_id : str, type_id : usize) -> String)({
  result := String.from("__yo_enum_");
  result.push_str(module_id);
  result.push_str("_id_");
  result.push_string(type_id.to_string());
  result
});
/// Build the uppercase prefix used for enum variant tag constants:
/// `__YO_ENUM_{MODULE_ID_UPPER}_ID_{TYPE_ID}`.
enum_tag_prefix :: (fn(module_id : str, type_id : usize) -> String)({
  prefix := String.from("__YO_ENUM_");
  mid := String.from(module_id);
  prefix.push_string(mid.to_uppercase());
  prefix.push_str("_ID_");
  prefix.push_string(type_id.to_string());
  prefix
});
// ---------------------------------------------------------------------------
// Field type mapping: TypeValue → C type string
// ---------------------------------------------------------------------------
/// Map a `TypeValue` to its C type string for use in struct/enum field
/// declarations.  Handles primitives and common C types.
///
/// Returns `None` for types that cannot be mapped without additional
/// context (e.g., user-defined named types without C name info).
type_value_to_c_field :: (fn(t : TypeValue) -> Option(String))(
  match(
    t,
    .Unit => Option(String).Some(String.from("void")),
    .BoolT => Option(String).Some(String.from("bool")),
    .Void => Option(String).Some(String.from("void")),
    .Int(bits, signed) => cond(
      (signed && (bits == u8(8))) => Option(String).Some(String.from("int8_t")),
      (signed && (bits == u8(16))) => Option(String).Some(String.from("int16_t")),
      (signed && (bits == u8(32))) => Option(String).Some(String.from("int32_t")),
      (signed && (bits == u8(64))) => Option(String).Some(String.from("int64_t")),
      ((!(signed)) && (bits == u8(8))) => Option(String).Some(String.from("uint8_t")),
      ((!(signed)) && (bits == u8(16))) => Option(String).Some(String.from("uint16_t")),
      ((!(signed)) && (bits == u8(32))) => Option(String).Some(String.from("uint32_t")),
      true => Option(String).Some(String.from("uint64_t"))
    ),
    .Float(bits) => cond(
      (bits == u8(32)) => Option(String).Some(String.from("float")),
      true => Option(String).Some(String.from("double"))
    ),
    .Usize => Option(String).Some(String.from("size_t")),
    .Isize => Option(String).Some(String.from("ptrdiff_t")),
    .CChar => Option(String).Some(String.from("char")),
    .CInt => Option(String).Some(String.from("int")),
    .CLong => Option(String).Some(String.from("long")),
    .CLongLong => Option(String).Some(String.from("long long")),
    .CUInt => Option(String).Some(String.from("unsigned int")),
    .CULong => Option(String).Some(String.from("unsigned long")),
    .CULongLong => Option(String).Some(String.from("unsigned long long")),
    _ => Option(String).None
  )
);
// ---------------------------------------------------------------------------
// Struct declaration
// ---------------------------------------------------------------------------
/// Emit a C struct type declaration into `ctx.emitter.declarations`.
///
/// Emits:
/// ```c
/// typedef struct __yo_struct_{mod}_id_{id}_struct __yo_struct_{mod}_id_{id}; // Forward declaration
/// struct __yo_struct_{mod}_id_{id}_struct { // {name}
///   field_type0 field_label0;
///   ...
/// };
/// ```
///
/// Fields whose types cannot be mapped are silently skipped.
/// Format the struct forward declaration line:
///   `typedef struct <c_name>_struct <c_name>; // Forward declaration`
format_struct_forward_decl :: (fn(c_name : String) -> String)({
  s := String.from("typedef struct ");
  s.push_string(c_name);
  s.push_str("_struct ");
  s.push_string(c_name);
  s.push_str("; // Forward declaration");
  s
});
/// Format the struct-definition opening header line:
///   `struct <c_name>_struct { // <human_name>`
format_struct_def_header :: (fn(c_name : String, human_name : String) -> String)({
  s := String.from("struct ");
  s.push_string(c_name);
  s.push_str("_struct { // ");
  s.push_string(human_name);
  s
});
/// Format a struct-field declaration line: `  <c_type> <label>;`.
/// Pure string composition — used by `generate_struct_decl` and (via a
/// parallel inline build) by the data-enum-variant emitter.
format_struct_field_line :: (fn(c_type : String, label : String) -> String)({
  s := String.from("  ");
  s.push_string(c_type);
  s.push_str(" ");
  s.push_string(label);
  s.push_str(";");
  s
});
/// Returns the C name for the struct type (for use as a field type elsewhere).
generate_struct_decl :: (
  fn(
    struct_id : String,
    name : String,
    field_labels : ArrayList(String),
    field_types : ArrayList(TypeValue),
    module_id : str,
    type_id : usize,
    ctx : CodegenContext
  ) -> String
)({
  c_name := struct_c_name(module_id, type_id);
  registered_fields := get_struct_fields(struct_id);
  // Forward declaration.
  ctx.emitter.emit_declaration_string_line(format_struct_forward_decl(c_name));
  // Struct definition header.
  ctx.emitter.emit_declaration_string_line(format_struct_def_header(c_name, name));
  // Fields
  n := cond(
    (field_labels.len() < field_types.len()) => field_labels.len(),
    true => field_types.len()
  );
  (i : usize) = usize(0);
  while(i < n, {
    skip_field := match(
      registered_fields,
      .Some(fields) => match(
        fields.get(i),
        .Some(field) => field.is_comptime,
        .None => false
      ),
      .None => false
    );
    label_opt := field_labels.get(i);
    ty_opt := field_types.get(i);
    if(!(skip_field), {
      match(
        label_opt,
        .None => (),
        .Some(label) => match(
          ty_opt,
          .None => (),
          .Some(ty) => match(
            type_value_to_c_field(ty),
            .None => (),
            .Some(c_ty) => ctx.emitter.emit_declaration_string_line(
              format_struct_field_line(c_ty, label)
            )
          )
        )
      );
    });
    i = (i + usize(1));
  });
  ctx.emitter.emit_declaration_line("};");
  c_name
});
// ---------------------------------------------------------------------------
// Enum declaration: simple (unit variants only) vs data (has non-unit variants)
// ---------------------------------------------------------------------------
/// True iff every variant in the enum has zero fields (pure unit variant).
all_unit_variants :: (fn(variant_fields : ArrayList(ArrayList(TypeValue))) -> bool)({
  n := variant_fields.len();
  (i : usize) = usize(0);
  (all_unit : bool) = true;
  while((i < n) && all_unit, {
    match(
      variant_fields.get(i),
      .None => (),
      .Some(fields) => {
        if(fields.len() > usize(0), {
          all_unit = false;
        });
      }
    );
    i = (i + usize(1));
  });
  all_unit
});
/// Format the simple-enum header line:
///   `typedef enum { // <human_name> (optimized as simple enum)`
/// Used by `emit_simple_enum`. The trailing parenthetical marker
/// distinguishes the simple-enum optimisation from the data-enum tag
/// type in the generated C.
format_simple_enum_header :: (fn(human_name : String) -> String)({
  s := String.from("typedef enum { // ");
  s.push_string(human_name);
  s.push_str(" (optimized as simple enum)");
  s
});
/// Format the `__dup` body's local copy line:
///   `  <c_type_name> __yo_dup_tmp = __yo_self;`
/// Used by `emit_dup_fn` to make a shallow copy of `__yo_self` before
/// returning it (so the compiler is free to optimise the copy when the
/// type is by-value).
format_rc_dup_tmp_decl :: (fn(c_type_name : str) -> String)({
  s := String.from("  ");
  s.push_str(c_type_name);
  s.push_str(" __yo_dup_tmp = __yo_self;");
  s
});
/// Format an enum variant entry line:
///   `  <tag_prefix>_<VNAME_UPPER> = <disc_val>[,]`
/// Used by both `emit_simple_enum` and the tag-enum block of
/// `emit_data_enum`. The `with_comma` flag controls whether the
/// trailing comma is appended (true for all but the last variant).
format_enum_variant_entry :: (
  fn(tag_prefix : String, vname_upper : String, disc_val : String, with_comma : bool) -> String
)({
  s := String.from("  ");
  s.push_string(tag_prefix);
  s.push_str("_");
  s.push_string(vname_upper);
  s.push_str(" = ");
  s.push_string(disc_val);
  if(with_comma, {
    s.push_str(",");
  });
  s
});
/// Format an enum close-and-typedef line:
///   `} <c_name><suffix>;`
/// where `suffix` is `""` for the simple-enum close, `"_tag"` for the
/// data-enum's tag-type close, and `"_data"` for the union-type close.
format_enum_close_line :: (fn(c_name : String, suffix : str) -> String)({
  s := String.from("} ");
  s.push_string(c_name);
  s.push_str(suffix);
  s.push_str(";");
  s
});
/// Format a tag-or-data struct field line for the combined enum
/// struct: `  <c_name>_<sub_type> <field_name>;`
///
/// `sub_type` is `tag` or `data`; `field_name` is also `tag` or `data`
/// (matching the type-suffix). Used twice in `emit_data_enum`.
format_enum_struct_subfield :: (
  fn(c_name : String, sub_type : str, field_name : str) -> String
)({
  s := String.from("  ");
  s.push_string(c_name);
  s.push_str("_");
  s.push_str(sub_type);
  s.push_str(" ");
  s.push_str(field_name);
  s.push_str(";");
  s
});
/// Format a data-enum variant's positional union-field line:
///   `    <c_type> _f<index>;`
/// Used per-field inside the inner `struct { ... }` of each variant in
/// the data union.
format_enum_union_field :: (fn(c_type : String, index : usize) -> String)({
  s := String.from("    ");
  s.push_string(c_type);
  s.push_str(" _f");
  s.push_string(index.to_string());
  s.push_str(";");
  s
});
/// Format a data-enum variant's union-member closing line:
///   `  } <variant_name>;`
/// Closes the inner positional-fields struct and names it after the
/// variant.
format_enum_variant_member :: (fn(variant_name : String) -> String)({
  s := String.from("  } ");
  s.push_string(variant_name);
  s.push_str(";");
  s
});
/// Emit a simple enum (all unit variants) into `ctx.emitter.declarations`.
///
/// ```c
/// typedef enum { // {name} (optimized as simple enum)
///   __YO_ENUM_..._VARIANT0 = 0,
///   ...
/// } __yo_enum_...;
/// ```
emit_simple_enum :: (
  fn(
    name : String,
    variant_names : ArrayList(String),
    variant_discriminants : ArrayList(i64),
    module_id : str,
    type_id : usize,
    ctx : CodegenContext
  ) -> String
)({
  c_name := enum_c_name(module_id, type_id);
  tag_prefix := enum_tag_prefix(module_id, type_id);
  // Header: typedef enum { // Name (optimized as simple enum)
  ctx.emitter.emit_declaration_string_line(format_simple_enum_header(name));
  // Variant entries: __YO_ENUM_..._VARIANTNAME = N,
  n := variant_names.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      variant_names.get(i),
      .None => (),
      .Some(vname) => {
        disc_val := match(
          variant_discriminants.get(i),
          .Some(d) => d.to_string(),
          .None => i64(i).to_string()
        );
        ctx.emitter.emit_declaration_string_line(
          format_enum_variant_entry(tag_prefix, vname.to_uppercase(), disc_val, i < (n - usize(1)))
        );
      }
    );
    i = (i + usize(1));
  });
  // Closing: } __yo_enum_...;
  ctx.emitter.emit_declaration_string_line(format_enum_close_line(c_name, ""));
  c_name
});
/// Emit a data enum (at least one variant has fields) into
/// `ctx.emitter.declarations`.
///
/// Emits a forward declaration, a tag enum, a data union, and the combined
/// struct:
/// ```c
/// typedef struct __yo_enum_..._struct __yo_enum_...;  // Forward declaration
/// typedef enum { __YO_ENUM_..._V0 = 0, ... } __yo_enum_..._tag;
/// typedef union { struct { ... } V0; ... } __yo_enum_..._data;
/// struct __yo_enum_..._struct { // Name
///   __yo_enum_..._tag tag;
///   __yo_enum_..._data data;
/// };
/// ```
emit_data_enum :: (
  fn(
    name : String,
    variant_names : ArrayList(String),
    variant_fields : ArrayList(ArrayList(TypeValue)),
    variant_discriminants : ArrayList(i64),
    module_id : str,
    type_id : usize,
    ctx : CodegenContext
  ) -> String
)({
  c_name := enum_c_name(module_id, type_id);
  tag_prefix := enum_tag_prefix(module_id, type_id);
  // Forward declaration.
  ctx.emitter.emit_declaration_string_line(format_struct_forward_decl(c_name));
  // Tag enum.
  ctx.emitter.emit_declaration_line("typedef enum {");
  n := variant_names.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      variant_names.get(i),
      .None => (),
      .Some(vname) => {
        disc_val_de := match(
          variant_discriminants.get(i),
          .Some(d) => d.to_string(),
          .None => i64(i).to_string()
        );
        ctx.emitter.emit_declaration_string_line(
          format_enum_variant_entry(tag_prefix, vname.to_uppercase(), disc_val_de, i < (n - usize(1)))
        );
      }
    );
    i = (i + usize(1));
  });
  ctx.emitter.emit_declaration_string_line(format_enum_close_line(c_name, "_tag"));
  // Data union
  ctx.emitter.emit_declaration_line("typedef union {");
  (j : usize) = usize(0);
  while(j < n, {
    v_name_opt := variant_names.get(j);
    v_fields_opt := variant_fields.get(j);
    match(
      v_name_opt,
      .None => (),
      .Some(vname) => {
        ctx.emitter.emit_declaration_line("  struct {");
        match(
          v_fields_opt,
          .None => (),
          .Some(fields) => {
            nf := fields.len();
            (fi : usize) = usize(0);
            while(fi < nf, {
              match(
                fields.get(fi),
                .None => (),
                .Some(fty) => match(
                  type_value_to_c_field(fty),
                  .None => (),
                  .Some(c_fty) => ctx.emitter.emit_declaration_string_line(
                    format_enum_union_field(c_fty, fi)
                  )
                )
              );
              fi = (fi + usize(1));
            });
          }
        );
        ctx.emitter.emit_declaration_string_line(format_enum_variant_member(vname));
      }
    );
    j = (j + usize(1));
  });
  ctx.emitter.emit_declaration_string_line(format_enum_close_line(c_name, "_data"));
  // Combined struct.
  ctx.emitter.emit_declaration_string_line(format_struct_def_header(c_name, name));
  ctx.emitter.emit_declaration_string_line(format_enum_struct_subfield(c_name, "tag", "tag"));
  ctx.emitter.emit_declaration_string_line(format_enum_struct_subfield(c_name, "data", "data"));
  ctx.emitter.emit_declaration_line("};");
  c_name
});
// ---------------------------------------------------------------------------
// Top-level dispatcher
// ---------------------------------------------------------------------------
/// Generate a C type declaration for a `TypeValue`.
///
/// Handles:
///   - `Struct(...)` → forward declaration + struct definition
///   - `EnumT(...)` with all unit variants → simple `typedef enum`
///   - `EnumT(...)` with data variants → forward + tag enum + data union + struct
///
/// Returns the C type name for the generated type (used when referencing this
/// type as a field type in another declaration), or `None` for unsupported
/// TypeValue variants.
generate_type_decl :: (
  fn(
    type_val : TypeValue,
    module_id : str,
    type_id : usize,
    ctx : CodegenContext
  ) -> Option(String)
)(
  match(
    type_val,
    .Struct({ id, name, field_labels, field_types }) => {
      c_name := generate_struct_decl(id, name, field_labels, field_types, module_id, type_id, ctx);
      // Populate the codegen types registry so downstream handlers
      // (downcast / dyn / typeid / comptime-value) can resolve this
      // struct's C name via `ctx.get_type_c_name(id)`. Mirrors the TS
      // pattern of populating `context.types[id] = { type, cName }`
      // during type-declaration emission.
      ctx.register_type(id, type_val, c_name.clone());
      Option(String).Some(c_name)
    },
    .EnumT(id, name, variant_names, variant_fields, _, _, discs) => {
      c_name := cond(
        all_unit_variants(variant_fields) =>
          emit_simple_enum(name, variant_names, discs, module_id, type_id, ctx),
        true =>
          emit_data_enum(name, variant_names, variant_fields, discs, module_id, type_id, ctx)
      );
      ctx.register_type(id, type_val, c_name.clone());
      Option(String).Some(c_name)
    },
    _ => Option(String).None
  )
);
// ===========================================================================
// Per-type RC helper-function generation (was yo-self/codegen/types/generation.yo)
//
// In the TS reference, type-declaration emission and the associated
// __dispose / __drop / __dup function generation both live in
// `src/codegen/types/generation.ts`. Keep that grouping here.
//
// Phase 4i scope: only types whose fields are all primitive (no
// heap-allocated RC objects). Semantics for non-RC types:
//   __dispose(self) — no-op (would recursively dispose RC children)
//   __drop(self)    — no-op (drops the value; decrements child RCs if any)
//   __dup(self)     — returns a shallow copy
//
// Phase 4i naming uses the type's C name directly:
//   {c_type_name}___dispose
//   {c_type_name}___drop
//   {c_type_name}___dup
// (The TS compiler uses ID-based names; matching that is a later phase.)
//
// Forward declarations go into ctx.emitter.declarations; bodies into
// ctx.emitter.code.
// ===========================================================================
/// The C attribute prefix used on all RC helper functions.
RC_ATTR :: "static inline __attribute__((always_inline)) ";
/// Format an RC void-function forward declaration:
///   `<RC_ATTR>void <fn_name>(<c_type_name> __yo_self);`
/// Used for both `__dispose` and `__drop` forward decls (they share
/// the same shape).
format_rc_void_forward_decl :: (fn(fn_name : String, c_type_name : str) -> String)({
  s := String.from(RC_ATTR);
  s.push_str("void ");
  s.push_string(fn_name);
  s.push_str("(");
  s.push_str(c_type_name);
  s.push_str(" __yo_self);");
  s
});
/// Format the `__dup` function's forward declaration:
///   `<RC_ATTR><c_type_name> <fn_name>(<c_type_name> __yo_self);`
/// `__dup` returns the type itself rather than `void`, so this needs a
/// separate formatter from the void variant.
format_rc_dup_forward_decl :: (fn(fn_name : String, c_type_name : str) -> String)({
  s := String.from(RC_ATTR);
  s.push_str(c_type_name);
  s.push_str(" ");
  s.push_string(fn_name);
  s.push_str("(");
  s.push_str(c_type_name);
  s.push_str(" __yo_self);");
  s
});
/// Format an RC void-function definition's signature line:
///   `<RC_ATTR>void <fn_name>(<c_type_name> __yo_self) {`
/// Same shape as `format_rc_void_forward_decl` but with `{` instead of `;`.
format_rc_void_sig :: (fn(fn_name : String, c_type_name : str) -> String)({
  s := String.from(RC_ATTR);
  s.push_str("void ");
  s.push_string(fn_name);
  s.push_str("(");
  s.push_str(c_type_name);
  s.push_str(" __yo_self) {");
  s
});
/// Format the `__dup` definition's signature line:
///   `<RC_ATTR><c_type_name> <fn_name>(<c_type_name> __yo_self) {`
format_rc_dup_sig :: (fn(fn_name : String, c_type_name : str) -> String)({
  s := String.from(RC_ATTR);
  s.push_str(c_type_name);
  s.push_str(" ");
  s.push_string(fn_name);
  s.push_str("(");
  s.push_str(c_type_name);
  s.push_str(" __yo_self) {");
  s
});
/// Build `{c_type_name}___dispose`.
rc_dispose_name :: (fn(c_type_name : str) -> String)({
  n := String.from(c_type_name);
  n.push_str("___dispose");
  n
});
/// Build `{c_type_name}___drop`.
rc_drop_name :: (fn(c_type_name : str) -> String)({
  n := String.from(c_type_name);
  n.push_str("___drop");
  n
});
/// Build `{c_type_name}___dup`.
rc_dup_name :: (fn(c_type_name : str) -> String)({
  n := String.from(c_type_name);
  n.push_str("___dup");
  n
});
/// Emit forward declarations for RC functions into the declarations section.
///
/// For structs (has_dispose=true): dispose + drop + dup
/// For enums (has_dispose=false): drop + dup only
emit_rc_forward_decls :: (
  fn(
    c_type_name : str,
    has_dispose : bool,
    ctx : CodegenContext
  ) -> unit
)({
  if(has_dispose, {
    ctx.emitter.emit_declaration_string_line(
      format_rc_void_forward_decl(rc_dispose_name(c_type_name), c_type_name)
    );
  });
  ctx.emitter.emit_declaration_string_line(
    format_rc_void_forward_decl(rc_drop_name(c_type_name), c_type_name)
  );
  ctx.emitter.emit_declaration_string_line(
    format_rc_dup_forward_decl(rc_dup_name(c_type_name), c_type_name)
  );
});
/// Emit the `__dispose` function body (no-op for non-RC types).
emit_dispose_fn :: (fn(c_type_name : str, ctx : CodegenContext) -> unit)({
  ctx.emitter.emit_line(format_rc_void_sig(rc_dispose_name(c_type_name), c_type_name).as_str());
  ctx.emitter.emit_line("}");
});
/// Emit the `__drop` function body (no-op for non-RC types).
emit_drop_fn :: (fn(c_type_name : str, ctx : CodegenContext) -> unit)({
  ctx.emitter.emit_line(format_rc_void_sig(rc_drop_name(c_type_name), c_type_name).as_str());
  ctx.emitter.emit_line("  return;");
  ctx.emitter.emit_line("}");
});
/// Emit the `__dup` function body (shallow copy for non-RC types).
emit_dup_fn :: (fn(c_type_name : str, ctx : CodegenContext) -> unit)({
  ctx.emitter.emit_line(format_rc_dup_sig(rc_dup_name(c_type_name), c_type_name).as_str());
  ctx.emitter.emit_line(format_rc_dup_tmp_decl(c_type_name).as_str());
  ctx.emitter.emit_line("  return(__yo_dup_tmp);");
  ctx.emitter.emit_line("}");
});
/// Generate forward declarations and definitions for the three RC helper
/// functions for a type with no heap-allocated (RC) fields.
///
/// `c_type_name` — the C typedef name as a `str` (e.g., `"__yo_struct_mod_id_2"`)
/// `has_dispose` — true for struct types, false for enum types
///
/// Forward declarations go into `ctx.emitter.declarations`.
/// Function bodies go into `ctx.emitter.code`.
generate_rc_fns_trivial :: (
  fn(
    c_type_name : str,
    has_dispose : bool,
    ctx : CodegenContext
  ) -> unit
)({
  emit_rc_forward_decls(c_type_name, has_dispose, ctx);
  if(has_dispose, {
    emit_dispose_fn(c_type_name, ctx);
  });
  emit_drop_fn(c_type_name, ctx);
  emit_dup_fn(c_type_name, ctx);
});
/// Generate RC helper functions for a `TypeValue`.
///
/// Currently handles:
///   Struct — with __dispose + __drop + __dup
///   EnumT  — with __drop + __dup (no __dispose for unit enums)
///
/// Returns `true` if RC functions were generated, `false` for unsupported types.
generate_rc_fns :: (
  fn(
    type_val : TypeValue,
    module_id : str,
    type_id : usize,
    ctx : CodegenContext
  ) -> bool
)(
  match(
    type_val,
    .Struct({ id : _ }) => {
      c_name := struct_c_name(module_id, type_id);
      generate_rc_fns_trivial(c_name.as_str(), true, ctx);
      true
    },
    .EnumT(_, _, _, _, _, _, _) => {
      c_name := enum_c_name(module_id, type_id);
      generate_rc_fns_trivial(c_name.as_str(), false, ctx);
      true
    },
    _ => false
  )
);
export(
  type_value_to_c_field,
  struct_c_name,
  enum_c_name,
  enum_tag_prefix,
  generate_struct_decl,
  emit_simple_enum,
  emit_data_enum,
  generate_type_decl,
  RC_ATTR,
  rc_dispose_name,
  rc_drop_name,
  rc_dup_name,
  emit_rc_forward_decls,
  emit_dispose_fn,
  emit_drop_fn,
  emit_dup_fn,
  generate_rc_fns_trivial,
  generate_rc_fns,
  format_struct_forward_decl,
  format_struct_def_header,
  format_struct_field_line,
  format_enum_variant_entry,
  format_enum_close_line,
  format_enum_struct_subfield,
  format_enum_union_field,
  format_enum_variant_member,
  format_rc_void_forward_decl,
  format_rc_dup_forward_decl,
  format_rc_void_sig,
  format_rc_dup_sig,
  format_simple_enum_header,
  format_rc_dup_tmp_decl
);
