//! state_machine — async/effect state-machine codegen (Phase 5).
//! Incremental 1:1 port of `src/codegen/async/state-machine.ts` (2605 LOC).
//!
//! PORT STATUS: bottom-up. The leaf type-guard `is_io_future_type` lands first;
//! the StateMachineInfo model, the FSM transformation, and the resume/struct
//! emitters follow (they consume `suspension_codegen.yo` + `async_completion.yo`
//! and the `g_some_resolved_concrete` side-table).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ HashSet } :: import("std/collections/hash_set");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_some_type, is_concrete_trait_type, is_struct_type } :: import("../../types/guards.yo");
{ type_implements_future, extract_future_trait_from_type } :: import("../../evaluator/trait_checking.yo");
{ lookup_some_resolved_concrete } :: import("../../expr_info.yo");
{ AwaitAnalysisResult, AwaitPoint, CapturedVariable, CapturedVariableKind } :: import("../../evaluator/async/await_analysis_types.yo");
{ StateSegment, split_into_state_segments, generate_await_expression } :: import("./state_code_gen.yo");
{ is_io_async_call, is_io_await_call } :: import("../../evaluator/async/await_analysis.yo");
{ AstExpr, ast_expr_is_atom, ast_expr_is_atom_of, ast_expr_is_fn_call, ast_expr_is_fn_call_of, ast_expr_token, BK_COND, BK_MATCH, BK_WHILE, BK_BEGIN } :: import("../../expr.yo");
{ _call_generate_expr } :: import("../exprs/_expr.yo");
{ _c_string_literal } :: import("../exprs/comptime_value.yo");
{ TokenKind } :: import("../../token.yo");
{ Variable, get_variables_from_env } :: import("../../env.yo");
{ type_contains_rc_type } :: import("../../types/utils.yo");
{ FunctionGenerationContext } :: import("../functions/context.yo");
{ get_type_string } :: import("../utils/index.yo");
{ get_state_machine_field_name } :: import("./state_machine_naming.yo");
/// True when `ty` is an io.async/io.await Future SomeType (vs an extern
/// `__yo_io_future_t`). Mirrors `isIoFutureType` (state-machine.ts:496).
///
/// TS has TWO signals:
///   (1) `resolvedConcreteType` is itself an EXTERN SomeType — an extern C type
///       like `__yo_io_future_t` (so NOT a state-machine Future).
///   (2) any required trait is a `Concrete(...)` trait.
/// Branch (2) is ported faithfully. Branch (1) is a DOCUMENTED GAP: yo-self's
/// `SomeT` has no `is_extern` field, so although the resolved concrete type is
/// available via `g_some_resolved_concrete`, its extern-ness is unrepresentable
/// (a second SomeT model gap alongside resolved-concrete; see
/// plans/BOOTSTRAPPING_CODEGEN.md Phase 5 #3 — needs a `g_some_is_extern`
/// side-table or a SomeT field). The `lookup_some_resolved_concrete` read is kept
/// to mark the wiring point. Inert until the FSM emitters call this.
is_io_future_type :: (fn(ty : TypeValue) -> bool)({
  if(!(is_some_type(ty)), {
    return(false);
  });
  // Branch (1): resolved concrete is an extern SomeType — wiring point present,
  // extern check pending the SomeT `is_extern` model gap (see doc above).
  some_id := match(ty,.SomeT({ id }) => id, _ => String.from(""));
  _rc := lookup_some_resolved_concrete(some_id);
  // Branch (2): any required trait is a `Concrete(...)` trait.
  rts := match(ty,.SomeT({ required_trait_types }) => required_trait_types, _ => ArrayList(TypeValue).new());
  (i : usize) = usize(0);
  while(i < rts.len(), {
    rt := match(rts.get(i),.Some(t) => t,.None => TypeValue.Unit);
    if(is_concrete_trait_type(rt), {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
/// Information about a generated state machine. Mirrors `StateMachineInfo`
/// (state-machine.ts:516).
StateMachineInfo :: object(
  /// The C struct name for this state machine.
  struct_name : String,
  /// The C function name for the resume function.
  resume_function_name : String,
  /// Analysis result containing await points and captured variables.
  analysis : AwaitAnalysisResult
);
/// Emit the forward declaration for the resume function. Mirrors
/// `generateResumeFunctionDeclaration` (state-machine.ts:535).
generate_resume_function_declaration :: (
  fn(info : StateMachineInfo, context : FunctionGenerationContext) -> unit
)({
  em := context.base.emitter;
  line := String.from("void ");
  line.push_string(info.resume_function_name.clone());
  line.push_str("(");
  line.push_string(info.struct_name.clone());
  line.push_str("* sm);");
  em.emit_declaration_string_line(line);
});
/// The state-machine field name for the Future being awaited. Prefers the
/// captured Future variable's field (`<name>` for an outer capture, `var_<id>`
/// for a local) over a dedicated `await_future_<index>` field. Mirrors
/// `getFutureFieldName` (state-machine.ts:461).
get_future_field_name :: (
  fn(await_point : AwaitPoint, analysis : AwaitAnalysisResult) -> String
)({
  match(
    await_point.future_variable_id,
    .Some(fvid) => {
      cvs := analysis.captured_variables;
      (i : usize) = usize(0);
      (found : Option(CapturedVariable)) = Option(CapturedVariable).None;
      while((i < cvs.len()) && found.is_none(), {
        match(
          cvs.get(i),
          .Some(cv) => if(cv.base.id == fvid, {
            found = Option(CapturedVariable).Some(cv);
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      match(
        found,
        .Some(cv) => match(
          cv.kind,
          .Outer => return(cv.base.name.clone()),
          .Local => {
            s := String.from("var_");
            s.push_string(cv.base.id.clone());
            return(s);
          }
        ),
        .None => ()
      );
    },
    .None => ()
  );
  out := String.from("await_future_");
  out.push_string(await_point.base.index.to_string());
  out
});
/// The cleanup "segment" pseudo-index. TS uses `-1`; yo-self uses `usize.MAX`
/// (segment counts are tiny, so this never collides with a real state number)
/// to keep the segment sets unsigned. A variable referenced only here lives in
/// the struct because the body-level deferred drops run in the last segment.
CLEANUP_SEGMENT :: usize.MAX;
/// Collect the IDs of all runtime variables referenced in `expr` into `refs`,
/// resolving SSA remapping and RC-ownership aliasing. Skips nested async-block
/// bodies (their refs belong to the inner state machine) but still walks their
/// deferred dup expressions. Mirrors `collectVariableRefsInExpr`
/// (state-machine.ts:76). yo-self threads `context` because the ExprInfo (env +
/// deferred expressions) lives in the codegen side-table, not on the expr.
collect_variable_refs_in_expr :: (
  fn(
    expr : AstExpr,
    refs : HashSet(String),
    variable_id_remapping : HashMap(String, String),
    context : FunctionGenerationContext
  ) -> unit
)({
  ei_opt := context.base.get_expr_info(expr);
  // Atom case: an identifier that resolves to a non-comptime env variable.
  if(ast_expr_is_atom(expr), {
    tok := ast_expr_token(expr);
    if(tok.kind == TokenKind.Identifier, {
      match(
        ei_opt,
        .Some(ei) => {
          var_name := tok.value;
          variables := get_variables_from_env(ei.env, var_name);
          if(variables.len() > usize(0), {
            // The last binding wins (innermost scope).
            variable := match(
              variables.get(variables.len() - usize(1)),
              .Some(v) => v,
              .None => return()
            );
            if(!(variable.is_compile_time_only), {
              // Resolve SSA remapping, then RC owner.
              canonical_id := match(
                variable_id_remapping.get(variable.id.clone()),
                .Some(c) => c,
                .None => variable.id.clone()
              );
              owner_id := match(
                variable.is_owning_the_same_rc_value_as,
                .Some(ob) => ob.*.id.clone(),
                .None => canonical_id
              );
              refs.add(owner_id);
            });
          });
        },
        .None => ()
      );
    });
    return();
  });
  // FnCall case.
  if(ast_expr_is_fn_call(expr), {
    if(is_io_async_call(expr), {
      // Nested async block — skip its body, but walk its deferred dups (captures).
      match(
        ei_opt,
        .Some(ei) => match(
          ei.deferred_dup_expressions,
          .Some(dups) => {
            (di : usize) = usize(0);
            while(di < dups.len(), {
              match(
                dups.get(di),
                .Some(d) => {
                  recur(d, refs, variable_id_remapping, context);
                },
                .None => ()
              );
              di = (di + usize(1));
            });
          },
          .None => ()
        ),
        .None => ()
      );
      return();
    });
    func_expr := match(expr,.FnCall(_, fb, _, _, _) => fb.*, _ => expr);
    recur(func_expr, refs, variable_id_remapping, context);
    args := match(expr,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
    (ai : usize) = usize(0);
    while(ai < args.len(), {
      match(
        args.get(ai),
        .Some(a) => {
          recur(a, refs, variable_id_remapping, context);
        },
        .None => ()
      );
      ai = (ai + usize(1));
    });
    // Also walk deferred drop/dup expressions.
    match(
      ei_opt,
      .Some(ei) => {
        match(
          ei.deferred_drop_expressions,
          .Some(drops) => {
            (dri : usize) = usize(0);
            while(dri < drops.len(), {
              match(
                drops.get(dri),
                .Some(d) => {
                  recur(d, refs, variable_id_remapping, context);
                },
                .None => ()
              );
              dri = (dri + usize(1));
            });
          },
          .None => ()
        );
        match(
          ei.deferred_dup_expressions,
          .Some(dups2) => {
            (dui : usize) = usize(0);
            while(dui < dups2.len(), {
              match(
                dups2.get(dui),
                .Some(d) => {
                  recur(d, refs, variable_id_remapping, context);
                },
                .None => ()
              );
              dui = (dui + usize(1));
            });
          },
          .None => ()
        );
      },
      .None => ()
    );
  });
});
/// Result of cross-boundary variable analysis. Mirrors `CrossBoundaryResult`
/// (state-machine.ts:152). `variable_segments` maps each variable id to the set
/// of segment indices it is referenced in (`CLEANUP_SEGMENT` = body-level drops).
CrossBoundaryResult :: object(
  /// Variable IDs that must be stored as struct fields (cross await boundaries).
  cross_boundary_ids : HashSet(String),
  /// Maps temp variable IDs to their `await_future_N` field name (Phase 1b dedup).
  await_future_temp_var_aliases : HashMap(String, String),
  /// Maps each captured variable id to the segment indices where it is referenced.
  variable_segments : HashMap(String, HashSet(usize))
);
/// Add `seg` to the segment set of `var_id` in `variable_segments`
/// (get-mutate-set-back: always stores the mutated set back so the map reflects
/// any resize). Helper for `compute_cross_boundary_variables`.
_add_variable_segment :: (
  fn(variable_segments : HashMap(String, HashSet(usize)), var_id : String, seg : usize) -> unit
)({
  existing := match(
    variable_segments.get(var_id.clone()),
    .Some(s) => s,
    .None => HashSet(usize).new()
  );
  existing.add(seg);
  variable_segments.set(var_id.clone(), existing);
});
/// Determine which captured local variables cross await boundaries (referenced in
/// more than one state segment, or in the cleanup segment, or in a single
/// branching-await segment). Such variables must be stored as struct fields;
/// segment-local ones in non-branching segments can be C locals. Mirrors
/// `computeCrossBoundaryVariables` (state-machine.ts:171).
compute_cross_boundary_variables :: (
  fn(body_expr : AstExpr, analysis : AwaitAnalysisResult, context : FunctionGenerationContext) -> CrossBoundaryResult
)({
  await_points := analysis.await_points;
  captured_variables := analysis.captured_variables;
  variable_id_remapping := analysis.variable_id_remapping;
  // No await points → nothing crosses a boundary.
  if(await_points.len() == usize(0), {
    return(
      CrossBoundaryResult(
        cross_boundary_ids : HashSet(String).new(),
        await_future_temp_var_aliases : HashMap(String, String).new(),
        variable_segments : HashMap(String, HashSet(usize)).new()
      )
    );
  });
  segments := split_into_state_segments(body_expr, await_points);
  // Segment indices whose await point branches (cond/while): a variable found
  // ONLY in such a segment must stay in the struct (continuation runs elsewhere).
  branching_await_segment_indices := HashSet(usize).new();
  (sgi : usize) = usize(0);
  while(sgi < segments.len(), {
    match(
      segments.get(sgi),
      .Some(seg) => match(
        seg.await_point,
        .Some(ap) => {
          in_cond := match(ap.base.is_inside_cond,.Some(b) => b,.None => false);
          in_while := match(ap.base.is_inside_while,.Some(b) => b,.None => false);
          if(in_cond || in_while, {
            branching_await_segment_indices.add(seg.state_number);
          });
        },
        .None => ()
      ),
      .None => ()
    );
    sgi = (sgi + usize(1));
  });
  // For each segment, collect referenced variable ids and record the segment.
  variable_segments := HashMap(String, HashSet(usize)).new();
  (sgj : usize) = usize(0);
  while(sgj < segments.len(), {
    match(
      segments.get(sgj),
      .Some(seg) => {
        refs := HashSet(String).new();
        (ei : usize) = usize(0);
        while(ei < seg.expressions.len(), {
          match(
            seg.expressions.get(ei),
            .Some(e) => {
              collect_variable_refs_in_expr(e, refs, variable_id_remapping, context);
            },
            .None => ()
          );
          ei = (ei + usize(1));
        });
        ref_iter := refs.into_iter();
        (go : bool) = true;
        while(go, {
          match(
            ref_iter.next(),
            .Some(var_id) => {
              _add_variable_segment(variable_segments, var_id, seg.state_number);
            },
            .None => {
              go = false;
            }
          );
        });
      },
      .None => ()
    );
    sgj = (sgj + usize(1));
  });
  // Body-level deferred drops run at the end → CLEANUP_SEGMENT.
  body_ei_opt := context.base.get_expr_info(body_expr);
  match(
    body_ei_opt,
    .Some(body_ei) => match(
      body_ei.deferred_drop_expressions,
      .Some(body_drops) => {
        body_drop_refs := HashSet(String).new();
        (bi : usize) = usize(0);
        while(bi < body_drops.len(), {
          match(
            body_drops.get(bi),
            .Some(d) => {
              collect_variable_refs_in_expr(d, body_drop_refs, variable_id_remapping, context);
            },
            .None => ()
          );
          bi = (bi + usize(1));
        });
        bd_iter := body_drop_refs.into_iter();
        (bgo : bool) = true;
        while(bgo, {
          match(
            bd_iter.next(),
            .Some(var_id) => {
              _add_variable_segment(variable_segments, var_id, CLEANUP_SEGMENT);
            },
            .None => {
              bgo = false;
            }
          );
        });
      },
      .None => ()
    ),
    .None => ()
  );
  // A captured local crosses a boundary if used in >1 segment, in cleanup, or in
  // a single branching-await segment. Outer vars live in __capture (skipped).
  cross_boundary_ids := HashSet(String).new();
  (cvi : usize) = usize(0);
  while(cvi < captured_variables.len(), {
    match(
      captured_variables.get(cvi),
      .Some(v) => {
        is_outer := match(v.kind,.Outer => true,.Local => false);
        if(!(is_outer), {
          vid := v.base.id.clone();
          match(
            variable_segments.get(vid.clone()),
            .None => {
              // Not found in any segment — keep in struct (conservative).
              cross_boundary_ids.add(vid.clone());
            },
            .Some(segs_used) => {
              if(segs_used.len() > usize(1), {
                cross_boundary_ids.add(vid.clone());
              }, {
                if(segs_used.contains(CLEANUP_SEGMENT), {
                  cross_boundary_ids.add(vid.clone());
                }, {
                  // Exactly one numbered segment — struct only if it branches.
                  seg_iter := segs_used.into_iter();
                  single := match(seg_iter.next(),.Some(s) => s,.None => usize(0));
                  if(branching_await_segment_indices.contains(single), {
                    cross_boundary_ids.add(vid.clone());
                  });
                });
              });
            }
          );
        });
      },
      .None => ()
    );
    cvi = (cvi + usize(1));
  });
  // Phase 1b: temp vars holding futures already stored in await_future_N — alias
  // them to that field and drop them from the struct.
  await_future_temp_var_aliases := HashMap(String, String).new();
  (api : usize) = usize(0);
  while(api < await_points.len(), {
    match(
      await_points.get(api),
      .Some(ap) => {
        // Named future variables are already aliased — skip.
        has_named := match(ap.future_variable_id,.Some(_) => true,.None => false);
        if(!(has_named), {
          await_expr := ap.base.expr;
          if(ast_expr_is_fn_call(await_expr), {
            future_arg_opt := match(await_expr,.FnCall(_, _, a, _, _) => a.get(usize(0)), _ => Option(AstExpr).None);
            match(
              future_arg_opt,
              .Some(future_arg) => {
                tmp_name_opt := match(context.base.get_expr_info(future_arg),.Some(fei) => fei.variable_name,.None => Option(String).None);
                match(
                  tmp_name_opt,
                  .Some(temp_var_name) => {
                    // Find the captured local matching this temp var name/id.
                    (cfi : usize) = usize(0);
                    (matched : Option(String)) = Option(String).None;
                    while((cfi < captured_variables.len()) && matched.is_none(), {
                      match(
                        captured_variables.get(cfi),
                        .Some(cv2) => {
                          is_local := match(cv2.kind,.Local => true,.Outer => false);
                          if(is_local && ((cv2.base.name == temp_var_name) || (cv2.base.id == temp_var_name)), {
                            matched = Option(String).Some(cv2.base.id.clone());
                          });
                        },
                        .None => ()
                      );
                      cfi = (cfi + usize(1));
                    });
                    match(
                      matched,
                      .Some(cap_id) => {
                        field := String.from("await_future_");
                        field.push_string(ap.base.index.to_string());
                        await_future_temp_var_aliases.set(cap_id.clone(), field);
                        cross_boundary_ids.remove(cap_id);
                      },
                      .None => ()
                    );
                  },
                  .None => ()
                );
              },
              .None => ()
            );
          });
        });
      },
      .None => ()
    );
    api = (api + usize(1));
  });
  CrossBoundaryResult(
    cross_boundary_ids : cross_boundary_ids,
    await_future_temp_var_aliases : await_future_temp_var_aliases,
    variable_segments : variable_segments
  )
});
/// A variable's live range `[min_segment, max_segment]` over numbered segments.
_SlotRange :: object(min : usize, max : usize);
/// An overlapping storage slot shared by ≥2 non-RC value vars with disjoint live
/// ranges. Mirrors `OverlappingSlot` (state-machine.ts:310).
OverlappingSlot :: object(
  /// The struct field name, e.g. `slot_0`.
  field_name : String,
  /// The C type string for this slot.
  c_type : String,
  /// Variable names sharing this slot (for comments).
  variable_names : ArrayList(String)
);
/// Result of overlapping storage analysis. Mirrors `OverlappingStorageResult`
/// (state-machine.ts:322).
OverlappingStorageResult :: object(
  /// Maps variable IDs to their aliased slot field name.
  slot_aliases : HashMap(String, String),
  /// Slot field definitions for the struct.
  slots : ArrayList(OverlappingSlot)
);
/// Find the eligible captured variable with the given id. Helper for slot naming.
_find_captured_by_id :: (
  fn(eligible : ArrayList(CapturedVariable), id : String) -> Option(CapturedVariable)
)({
  (i : usize) = usize(0);
  (found : Option(CapturedVariable)) = Option(CapturedVariable).None;
  while((i < eligible.len()) && found.is_none(), {
    match(
      eligible.get(i),
      .Some(v) => if(v.base.id == id, {
        found = Option(CapturedVariable).Some(v);
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// Compute overlapping storage slots for cross-boundary variables: same-C-type
/// non-RC value vars whose live ranges don't overlap can share one struct field
/// (greedy graph coloring per type group). Mirrors `computeOverlappingSlots`
/// (state-machine.ts:339). NOTE: yo-self HashMap is not insertion-ordered, so
/// type/var iteration is driven off the ordered `eligible`/`ordered_c_types`
/// lists to keep slot assignment deterministic (any valid coloring is correct —
/// disjoint live ranges never collide — so the exact slot_N numbering may differ
/// from the TS reference without affecting correctness).
compute_overlapping_slots :: (
  fn(
    cross_boundary_ids : HashSet(String),
    variable_segments : HashMap(String, HashSet(usize)),
    captured_variables : ArrayList(CapturedVariable),
    await_future_temp_var_aliases : HashMap(String, String),
    context : FunctionGenerationContext
  ) -> OverlappingStorageResult
)({
  empty_result := OverlappingStorageResult(
    slot_aliases : HashMap(String, String).new(),
    slots : ArrayList(OverlappingSlot).new()
  );
  // Eligible = cross-boundary local vars of non-RC value type, not future-aliased.
  eligible := ArrayList(CapturedVariable).new();
  (e0 : usize) = usize(0);
  while(e0 < captured_variables.len(), {
    match(
      captured_variables.get(e0),
      .Some(v) => {
        is_local := match(v.kind,.Local => true,.Outer => false);
        if(((is_local && cross_boundary_ids.contains(v.base.id.clone())) && !(await_future_temp_var_aliases.contains_key(v.base.id.clone()))) && !(type_contains_rc_type(v.base.ty)), {
          eligible.push(v);
        });
      },
      .None => ()
    );
    e0 = (e0 + usize(1));
  });
  if(eligible.len() < usize(2), {
    return(empty_result);
  });
  // Live range [min,max] over numbered segments (exclude CLEANUP_SEGMENT).
  ranges := HashMap(String, _SlotRange).new();
  (r0 : usize) = usize(0);
  while(r0 < eligible.len(), {
    match(
      eligible.get(r0),
      .Some(v) => match(
        variable_segments.get(v.base.id.clone()),
        .Some(segs) => {
          (has_any : bool) = false;
          (mn : usize) = usize(0);
          (mx : usize) = usize(0);
          seg_it := segs.into_iter();
          (sgo : bool) = true;
          while(sgo, {
            match(
              seg_it.next(),
              .Some(s) => if(s != CLEANUP_SEGMENT, {
                if(!(has_any), {
                  mn = s;
                  mx = s;
                  has_any = true;
                }, {
                  if(s < mn, {
                    mn = s;
                  });
                  if(s > mx, {
                    mx = s;
                  });
                });
              }),
              .None => {
                sgo = false;
              }
            );
          });
          if(has_any, {
            ranges.set(v.base.id.clone(), _SlotRange(min : mn, max : mx));
          });
        },
        .None => ()
      ),
      .None => ()
    );
    r0 = (r0 + usize(1));
  });
  if(ranges.len() < usize(2), {
    return(empty_result);
  });
  // Group eligible vars (that have a range) by C type — iterate `eligible` order
  // for determinism; `ordered_c_types` records first-appearance order.
  by_type := HashMap(String, ArrayList(String)).new();
  ordered_c_types := ArrayList(String).new();
  (g0 : usize) = usize(0);
  while(g0 < eligible.len(), {
    match(
      eligible.get(g0),
      .Some(v) => {
        vid := v.base.id.clone();
        if(ranges.contains_key(vid.clone()), {
          ctype := get_type_string(v.base.ty, context.base);
          if(!(by_type.contains_key(ctype.clone())), {
            ordered_c_types.push(ctype.clone());
          });
          group := match(by_type.get(ctype.clone()),.Some(grp) => grp,.None => ArrayList(String).new());
          group.push(vid.clone());
          by_type.set(ctype.clone(), group);
        });
      },
      .None => ()
    );
    g0 = (g0 + usize(1));
  });
  slot_aliases := HashMap(String, String).new();
  slots := ArrayList(OverlappingSlot).new();
  (next_slot_index : usize) = usize(0);
  (ot : usize) = usize(0);
  while(ot < ordered_c_types.len(), {
    ctype := match(ordered_c_types.get(ot),.Some(c) => c,.None => String.new());
    var_ids := match(by_type.get(ctype.clone()),.Some(g) => g,.None => ArrayList(String).new());
    if(var_ids.len() >= usize(2), {
      // Interference graph: two vars conflict if their ranges overlap.
      conflicts := HashMap(String, HashSet(String)).new();
      (ii : usize) = usize(0);
      while(ii < var_ids.len(), {
        id_i := match(var_ids.get(ii),.Some(x) => x,.None => String.new());
        (jj : usize) = (ii + usize(1));
        while(jj < var_ids.len(), {
          id_j := match(var_ids.get(jj),.Some(x) => x,.None => String.new());
          ra := match(ranges.get(id_i.clone()),.Some(r) => r,.None => _SlotRange(min : usize(0), max : usize(0)));
          rb := match(ranges.get(id_j.clone()),.Some(r) => r,.None => _SlotRange(min : usize(0), max : usize(0)));
          if((ra.min <= rb.max) && (rb.min <= ra.max), {
            ci := match(conflicts.get(id_i.clone()),.Some(s) => s,.None => HashSet(String).new());
            ci.add(id_j.clone());
            conflicts.set(id_i.clone(), ci);
            cj := match(conflicts.get(id_j.clone()),.Some(s) => s,.None => HashSet(String).new());
            cj.add(id_i.clone());
            conflicts.set(id_j.clone(), cj);
          });
          jj = (jj + usize(1));
        });
        ii = (ii + usize(1));
      });
      // Greedy coloring.
      colors := HashMap(String, usize).new();
      (ki : usize) = usize(0);
      while(ki < var_ids.len(), {
        var_id := match(var_ids.get(ki),.Some(x) => x,.None => String.new());
        used_colors := HashSet(usize).new();
        cset := match(conflicts.get(var_id.clone()),.Some(s) => s,.None => HashSet(String).new());
        c_it := cset.into_iter();
        (cgo : bool) = true;
        while(cgo, {
          match(
            c_it.next(),
            .Some(conflict_id) => match(
              colors.get(conflict_id),
              .Some(col) => {
                used_colors.add(col);
              },
              .None => ()
            ),
            .None => {
              cgo = false;
            }
          );
        });
        (color : usize) = usize(0);
        while(used_colors.contains(color), {
          color = (color + usize(1));
        });
        colors.set(var_id.clone(), color);
        ki = (ki + usize(1));
      });
      // Group var_ids by color (iterate var_ids order; ordered_colors for output).
      color_to_vars := HashMap(usize, ArrayList(String)).new();
      ordered_colors := ArrayList(usize).new();
      (cti : usize) = usize(0);
      while(cti < var_ids.len(), {
        var_id := match(var_ids.get(cti),.Some(x) => x,.None => String.new());
        col := match(colors.get(var_id.clone()),.Some(c) => c,.None => usize(0));
        if(!(color_to_vars.contains_key(col)), {
          ordered_colors.push(col);
        });
        cgroup := match(color_to_vars.get(col),.Some(g) => g,.None => ArrayList(String).new());
        cgroup.push(var_id.clone());
        color_to_vars.set(col, cgroup);
        cti = (cti + usize(1));
      });
      // Create a slot per color group with ≥2 members (actual sharing).
      (oci : usize) = usize(0);
      while(oci < ordered_colors.len(), {
        col := match(ordered_colors.get(oci),.Some(c) => c,.None => usize(0));
        group_var_ids := match(color_to_vars.get(col),.Some(g) => g,.None => ArrayList(String).new());
        if(group_var_ids.len() >= usize(2), {
          field_name := String.from("slot_");
          field_name.push_string(next_slot_index.to_string());
          var_names := ArrayList(String).new();
          (vni : usize) = usize(0);
          while(vni < group_var_ids.len(), {
            gid := match(group_var_ids.get(vni),.Some(x) => x,.None => String.new());
            nm := match(
              _find_captured_by_id(eligible, gid.clone()),
              .Some(fv) => fv.base.name.clone(),
              .None => gid.clone()
            );
            var_names.push(nm);
            slot_aliases.set(gid.clone(), field_name.clone());
            vni = (vni + usize(1));
          });
          slots.push(
            OverlappingSlot(field_name : field_name.clone(), c_type : ctype.clone(), variable_names : var_names)
          );
          next_slot_index = (next_slot_index + usize(1));
        });
        oci = (oci + usize(1));
      });
    });
    ot = (ot + usize(1));
  });
  OverlappingStorageResult(slot_aliases : slot_aliases, slots : slots)
});
/// True when an expression contains a `return`. Mirrors `exprContainsReturn`
/// (state-machine.ts:2346) — the resume generator's local copy (TS keeps a
/// duplicate of `exprContainsReturnStatement` in this file).
expr_contains_return :: (fn(expr : AstExpr) -> bool)({
  if(ast_expr_is_atom_of(expr, "return"), {
    return(true);
  });
  if(ast_expr_is_fn_call_of(expr, "return", Option(usize).None), {
    return(true);
  });
  if(ast_expr_is_fn_call(expr), {
    args := match(expr,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
    (i : usize) = usize(0);
    while(i < args.len(), {
      arg := match(args.get(i),.Some(a) => a,.None => expr);
      if(recur(arg), {
        return(true);
      });
      i = (i + usize(1));
    });
  });
  false
});
/// True when `future_type` must be driven through the GENERIC Future vtable
/// (`__yo_set_effect_fn` etc.) rather than a concrete capture struct — i.e. it is
/// a Future SomeType with no concrete C type registered (nor a registered
/// resolved-concrete). Mirrors `usesGenericFutureInterface` (state-machine.ts:2366).
uses_generic_future_interface :: (fn(future_type : TypeValue, context : FunctionGenerationContext) -> bool)({
  if(!(is_some_type(future_type) && type_implements_future(future_type)), {
    return(false);
  });
  fid := match(future_type,.SomeT({ id }) => id, _ => String.from(""));
  if(context.base.types.contains_key(fid.clone()), {
    return(false);
  });
  match(
    lookup_some_resolved_concrete(fid),
    .Some(rc) => {
      if(is_some_type(rc), {
        rcid := match(rc,.SomeT({ id }) => id, _ => String.from(""));
        if(context.base.types.contains_key(rcid), {
          return(false);
        });
      });
      if(is_struct_type(rc), {
        capture_id := match(rc,.Struct({ id }) => id, _ => String.from(""));
        it := context.base.types.into_iter();
        (go : bool) = true;
        while(go, {
          match(
            it.next(),
            .Some(bucket) => {
              ety := bucket.value.ty;
              if(is_some_type(ety) && type_implements_future(ety), {
                esid := match(ety,.SomeT({ id }) => id, _ => String.from(""));
                match(
                  lookup_some_resolved_concrete(esid),
                  .Some(erc) => if(is_struct_type(erc), {
                    ercid := match(erc,.Struct({ id }) => id, _ => String.from(""));
                    if(ercid == capture_id, {
                      return(false);
                    });
                  }),
                  .None => ()
                );
              });
            },
            .None => {
              go = false;
            }
          );
        });
      });
    },
    .None => ()
  );
  extract_future_trait_from_type(future_type).is_some()
});
/// Emit the effect-injection line for one captured effect member of a Future:
/// the generic vtable `__yo_set_effect_fn` call for generic-interface Futures, or
/// a direct `__capture.<label>` store for concrete Futures. Mirrors
/// `emitFutureEffectInjectionLine` (state-machine.ts:2401).
emit_future_effect_injection_line :: (
  fn(
    future_type : TypeValue,
    future_access : String,
    field_label : String,
    member_code : String,
    indent : String,
    context : FunctionGenerationContext
  ) -> unit
)({
  em := context.base.emitter;
  if(uses_generic_future_interface(future_type, context), {
    lbl := _c_string_literal(field_label.clone());
    em.emit_string_line(`${indent}if (${future_access}->__yo_set_effect_fn) ${future_access}->__yo_set_effect_fn((void*)${future_access}, ${lbl}, (void*)${member_code});`);
    return();
  });
  em.emit_string_line(`${indent}${future_access}->__capture.${field_label} = (void*)${member_code};`);
});
/// Store the awaited Future for an EXTRA await in a cond/match branch (chained
/// awaits): a `:= await` / standalone `io.await` stores into the SM future field;
/// a nested cond/match/while/begin delegates to `generate_await_expression`.
/// Mirrors `generateRemainingExprFuture` (state-machine.ts:2257).
generate_remaining_expr_future :: (
  fn(expr : AstExpr, await_point : AwaitPoint, analysis : AwaitAnalysisResult, indent : String, context : FunctionGenerationContext) -> unit
)({
  em := context.base.emitter;
  future_field_name := get_future_field_name(await_point, analysis);
  // varName := await(futureExpr)
  if(ast_expr_is_fn_call(expr) && ast_expr_is_fn_call_of(expr, ":=", Option(usize).None), {
    args := match(expr,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
    match(
      args.get(usize(1)),
      .Some(value_expr) => if(ast_expr_is_fn_call(value_expr) && is_io_await_call(value_expr), {
        v_args := match(value_expr,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
        match(
          v_args.get(usize(0)),
          .Some(future_expr) => {
            fc := _call_generate_expr(future_expr, indent, context);
            em.emit_string_line(`${indent}// Store Future for additional await in cond branch`);
            em.emit_string_line(`${indent}sm->${future_field_name} = ${fc};`);
          },
          .None => ()
        );
      }),
      .None => ()
    );
    return();
  });
  // Standalone io.await(futureExpr)
  if(ast_expr_is_fn_call(expr) && is_io_await_call(expr), {
    args := match(expr,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
    match(
      args.get(usize(0)),
      .Some(future_expr) => {
        fc := _call_generate_expr(future_expr, indent, context);
        em.emit_string_line(`${indent}// Store Future for additional await in cond branch`);
        em.emit_string_line(`${indent}sm->${future_field_name} = ${fc};`);
      },
      .None => ()
    );
    return();
  });
  // Nested cond / match / while / begin → delegate to the await emitter.
  is_block := (((ast_expr_is_fn_call_of(expr, BK_COND, Option(usize).None) || ast_expr_is_fn_call_of(expr, BK_MATCH, Option(usize).None)) || ast_expr_is_fn_call_of(expr, BK_WHILE, Option(usize).None)) || ast_expr_is_fn_call_of(expr, BK_BEGIN, Option(usize).None));
  if(ast_expr_is_fn_call(expr) && is_block, {
    generate_await_expression(expr, await_point, usize(0), indent, context);
    return();
  });
  em.emit_string_line(`${indent}// Warning: unhandled await pattern in remaining expressions`);
});
export(
  is_io_future_type,
  StateMachineInfo,
  generate_resume_function_declaration,
  get_state_machine_field_name,
  get_future_field_name,
  CrossBoundaryResult,
  collect_variable_refs_in_expr,
  compute_cross_boundary_variables,
  OverlappingSlot,
  OverlappingStorageResult,
  compute_overlapping_slots,
  expr_contains_return,
  uses_generic_future_interface,
  emit_future_effect_injection_line,
  generate_remaining_expr_future
);
