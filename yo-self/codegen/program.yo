//! Top-level C program assembly for the self-hosted Yo compiler.
//!
//! Phase 4j: combine C preamble + type declarations + RC helpers +
//! function definitions into a compilable C11 file.
//!
//! Key entry points:
//!   emit_c_preamble(module_id, ctx)    — headers section (#include, typedefs, allocator)
//!   emit_main_wrapper(fn_name, ctx)    — int main() { fn_name(); return 0; }
//!   generate_c_output(ctx) -> String   — call ctx.emitter.print()
//!
//! Typical usage:
//!   1. emit_c_preamble(module_id, ctx)
//!   2. generate_type_decl(tv, mod, id, ctx) per type
//!   3. generate_rc_fns(tv, mod, id, ctx) per type
//!   4. generate_function(name, ret, params, tys, body, ctx) per fn
//!   5. emit_main_wrapper("__yo_user_main", ctx)
//!   6. generate_c_output(ctx) -> full C source
open(import("std/string"));
{ CodegenContext } :: import("./context.yo");
// ---------------------------------------------------------------------------
// Preamble
// ---------------------------------------------------------------------------
/// Emit the minimal C11 preamble required for compiled Yo programs.
///
/// Emits into the headers section:
///   - `#define _DEFAULT_SOURCE` / `_GNU_SOURCE`
///   - Standard C headers
///   - Libc allocator macros
///   - Module ID comment
emit_c_preamble :: (fn(module_id : str, ctx : *(CodegenContext)) -> unit)({
  e := &(
    ctx.*.emitter;
    // Feature macros
    e.*.emit_header_line("#define _DEFAULT_SOURCE");
    e.*.emit_header_line("#define _GNU_SOURCE");
    e.*.emit_header_line("");
    // Standard C headers
    e.*.emit_header_line("#include <stdbool.h>");
    e.*.emit_header_line("#include <stdint.h>");
    e.*.emit_header_line("#include <stddef.h>");
    e.*.emit_header_line("#include <stdarg.h>");
    e.*.emit_header_line("#include <stdlib.h>");
    e.*.emit_header_line("#include <stdio.h>");
    e.*.emit_header_line("#include <string.h>");
    e.*.emit_header_line("#include <errno.h>");
    e.*.emit_header_line("");
    // Allocator abstraction (libc default)
    e.*.emit_header_line("// Using libc allocator");
    e.*.emit_header_line("#define __yo_malloc  malloc");
    e.*.emit_header_line("#define __yo_calloc  calloc");
    e.*.emit_header_line("#define __yo_realloc realloc");
    e.*.emit_header_line("#define __yo_free    free");
    e.*.emit_header_line("");
    // Template string helpers: concatenate and convert-to-string.
    // Used by the self-hosted codegen to implement `\`...${x}...\`` expressions.
    e.*.emit_header_line("#include <inttypes.h>");
    e.*.emit_header_line("// Template string helpers");
    e.*.emit_header_line("static inline char* __yo_str_concat(const char* a, const char* b) {");
    e.*.emit_header_line("  size_t la = strlen(a), lb = strlen(b);");
    e.*.emit_header_line("  char* buf = (char*)__yo_malloc(la + lb + 1);");
    e.*.emit_header_line("  memcpy(buf, a, la); memcpy(buf + la, b, lb);");
    e.*.emit_header_line("  buf[la + lb] = '\\0';");
    e.*.emit_header_line("  return(buf);");
    e.*.emit_header_line("}");
    e.*.emit_header_line("static inline char* __yo_int_to_str(int64_t n) {");
    e.*.emit_header_line("  char* buf = (char*)__yo_malloc(32);");
    e.*.emit_header_line("  snprintf(buf, 32, \"%lld\", (long long)n);");
    e.*.emit_header_line("  return buf;");
    e.*.emit_header_line("}");
    e.*.emit_header_line("static inline char* __yo_uint_to_str(uint64_t n) {");
    e.*.emit_header_line("  char* buf = (char*)__yo_malloc(32);");
    e.*.emit_header_line("  snprintf(buf, 32, \"%llu\", (unsigned long long)n);");
    e.*.emit_header_line("  return buf;");
    e.*.emit_header_line("}");
    e.*.emit_header_line("static inline char* __yo_float_to_str(double d) {");
    e.*.emit_header_line("  char* buf = (char*)__yo_malloc(32);");
    e.*.emit_header_line("  snprintf(buf, 32, \"%g\", d);");
    e.*.emit_header_line("  return buf;");
    e.*.emit_header_line("}");
    e.*.emit_header_line("static inline const char* __yo_bool_to_str(_Bool b) {");
    e.*.emit_header_line("  return b ? \"true\" : \"false\";");
    e.*.emit_header_line("}");
    e.*.emit_header_line("");
    // box(v) — heap-allocate a value and return a typed pointer to it.
    // Uses __typeof__ (GCC/Clang extension enabled via _GNU_SOURCE) and C99/C11
    // compound literals to create a temporary lvalue without statement expressions.
    e.*.emit_header_line("// box(v) — heap allocate and return a typed pointer");
    e.*.emit_header_line("static inline void* __yo_box_impl(void* src, size_t sz) {");
    e.*.emit_header_line("  void* p = __yo_malloc(sz); memcpy(p, src, sz); return(p);");
    e.*.emit_header_line("}");
    e.*.emit_header_line("#define __yo_box(v) ((__typeof__(v)*)__yo_box_impl(&(__typeof__(v)){(v)}, sizeof(__typeof__(v))))");
    e.*.emit_header_line("");
    // Primitive Yo type aliases
    // `rune` is a zero-cost newtype over u32 (Unicode code point).
    // `String` is simplified to `const char*` for the self-hosted bootstrap runner.
    e.*.emit_header_line("// Yo primitive type aliases");
    e.*.emit_header_line("typedef uint32_t rune;");
    e.*.emit_header_line("typedef const char* String;");
    e.*.emit_header_line("");
    e.*.emit_header_line("// Process target constants");
    e.*.emit_header_line("#if defined(_WIN32)");
    e.*.emit_header_line("static const char* platform = \"windows\";");
    e.*.emit_header_line("#elif defined(__APPLE__) && defined(__MACH__)");
    e.*.emit_header_line("static const char* platform = \"macos\";");
    e.*.emit_header_line("#elif defined(__FreeBSD__)");
    e.*.emit_header_line("static const char* platform = \"freebsd\";");
    e.*.emit_header_line("#elif defined(__EMSCRIPTEN__)");
    e.*.emit_header_line("static const char* platform = \"emscripten\";");
    e.*.emit_header_line("#elif defined(__wasi__)");
    e.*.emit_header_line("static const char* platform = \"wasi\";");
    e.*.emit_header_line("#else");
    e.*.emit_header_line("static const char* platform = \"linux\";");
    e.*.emit_header_line("#endif");
    e.*.emit_header_line("#if defined(__x86_64__) || defined(_M_X64)");
    e.*.emit_header_line("static const char* arch = \"x86_64\";");
    e.*.emit_header_line("#elif defined(__aarch64__) || defined(_M_ARM64)");
    e.*.emit_header_line("static const char* arch = \"aarch64\";");
    e.*.emit_header_line("#elif defined(__i386__) || defined(_M_IX86)");
    e.*.emit_header_line("static const char* arch = \"x86\";");
    e.*.emit_header_line("#elif defined(__arm__) || defined(_M_ARM)");
    e.*.emit_header_line("static const char* arch = \"arm\";");
    e.*.emit_header_line("#elif defined(__wasm32__)");
    e.*.emit_header_line("static const char* arch = \"wasm32\";");
    e.*.emit_header_line("#else");
    e.*.emit_header_line("static const char* arch = \"unknown\";");
    e.*.emit_header_line("#endif");
    e.*.emit_header_line("");
    e.*.emit_header_line("// Bootstrap-only slice specializations");
    e.*.emit_header_line("typedef struct { uint8_t* data; size_t length; } YoSlice_u8;");
    // Record the baseline slice type in the codegen registry so
    // downstream handlers can dedupe and reuse it via
    // `ctx.has_slice_struct_type("YoSlice_u8")` instead of hardcoding
    // the name. Mirrors the TS pattern of pre-populating
    // `context.sliceStructTypes` with the always-emitted baselines.
    ctx.*.register_slice_struct_type(String.from("YoSlice_u8"),
    String.from("uint8_t"));
    e.*.emit_header_line("");
    e.*.emit_header_line("// Bootstrap-only returned array specializations");
    e.*.emit_header_line("typedef struct { int32_t data[1024]; size_t length; } YoArray_i32;");
    // Same baseline-registration treatment for the array type.
    ctx.*.register_array_struct_type(
      String.from("YoArray_i32"),
      String.from("int32_t"),
      usize(1024)
    );
    e.*.emit_header_line("static inline YoArray_i32 __yo_array_i32_fill(size_t length, int32_t value) {");
    e.*.emit_header_line("  YoArray_i32 result; result.length = length;");
    e.*.emit_header_line("  for (size_t i = 0; i < length && i < 1024; i++) { result.data[i] = value; }");
    e.*.emit_header_line("  return result;");
    e.*.emit_header_line("}");
    e.*.emit_header_line("");
    e.*.emit_header_line("// Bootstrap-only ArrayList specializations");
    e.*.emit_header_line("typedef struct { uint8_t data[1024]; size_t length; uint8_t* _ptr; } ArrayList_u8;");
    e.*.emit_header_line("");
    // Module ID comment
    mod_comment := String.from("// Module ID: ");
    mod_comment.push_str(module_id);
    e.*.emit_header_line(mod_comment.as_str());
  }
);
// ---------------------------------------------------------------------------
// main() wrapper
// ---------------------------------------------------------------------------
/// Emit the C `main()` entry point that calls the user's Yo main function.
///
/// ```c
/// int main(void) {
///   <user_main_c_name>();
///   return 0;
/// }
/// ```
emit_main_wrapper :: (fn(user_main_c_name : str, ctx : *(CodegenContext)) -> unit)({
  e := &(
    ctx.*.emitter;
    e.*.emit_line("int main(void) {");
    call_line := String.from("  ");
    call_line.push_str(user_main_c_name);
    call_line.push_str("();");
    e.*.emit_line(call_line.as_str());
    e.*.emit_line("  return(0);");
    e.*.emit_line("}");
  }
);
// ---------------------------------------------------------------------------
// Output assembly
// ---------------------------------------------------------------------------
/// Produce the complete C source by concatenating headers + declarations + code.
///
/// This is a thin wrapper around `ctx.emitter.print()` that makes the
/// intent explicit.
generate_c_output :: (fn(ctx : *(CodegenContext)) -> String)(
  ctx.*.emitter.print()
);
export(emit_c_preamble, emit_main_wrapper, generate_c_output);
