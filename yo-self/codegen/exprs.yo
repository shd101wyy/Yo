                  .None => Option(String).None,
                  .Some(deque_push_arg_c) => {
                    deque_push_code := String.from("(");
                    deque_push_code.push_string(recv_code);
                    deque_push_code.push_str(".data[(");
                    deque_push_code.push_string(recv_code);
                    deque_push_code.push_str(".head + ");
                    deque_push_code.push_string(recv_code);
                    deque_push_code.push_str(".length) % (size_t)(1024)] = ");
                    deque_push_code.push_string(deque_push_arg_c);
                    deque_push_code.push_str(", ");
                    deque_push_code.push_string(recv_code);
                    deque_push_code.push_str(".length++)");
                    Option(String).Some(deque_push_code)
                  }
                )
              )
            )
          ),
          (ctx.get_var_type(recv_code.as_str()).is_some() && ((method_name == "pop_front") && (args.len() == usize(0)))) => match(
            ctx.get_var_type(recv_code.as_str()),
            .None => Option(String).None,
            .Some(recv_ty_for_deque_pop) => cond(
              (!(is_deque_c_type(recv_ty_for_deque_pop.as_str()))) => Option(String).None,
              true => {
                deque_pop_code := String.from("(");
                deque_pop_code.push_string(recv_code);
                deque_pop_code.push_str(".head = (");
                deque_pop_code.push_string(recv_code);
                deque_pop_code.push_str(".head + (size_t)(1)) % (size_t)(1024), ");
                deque_pop_code.push_string(recv_code);
                deque_pop_code.push_str(".length = (");
                deque_pop_code.push_string(recv_code);
                deque_pop_code.push_str(".length - (size_t)(1)))");
                Option(String).Some(deque_pop_code)
              }
            )
          ),
          (ctx.get_var_type(recv_code.as_str()).is_some() && ((method_name == "len") && (args.len() == usize(0)))) => match(
            ctx.get_var_type(recv_code.as_str()),
            .None => Option(String).None,
            .Some(recv_ty_for_deque_len) => cond(
              (!(is_deque_c_type(recv_ty_for_deque_len.as_str()))) => Option(String).None,
              true => {
                deque_len_code := String.new();
                deque_len_code.push_string(recv_code);
                deque_len_code.push_str(".length");
                Option(String).Some(deque_len_code)
              }
            )
          ),
          // `str_lit.len()` / `str_const.len()` / `string.bytes_len()` → strlen(recv)
          (((method_name == "len") || (method_name == "bytes_len")) && (args.len() == usize(0))) => {
            sl_len2 := String.from("strlen(");
            sl_len2.push_string(recv_code);
            sl_len2.push_str(")");
            Option(String).Some(sl_len2)
          },
          // `x.to_string()` — check for derive(ToString) first, else strip (template string part).
          ((method_name == "to_string") && (args.len() == usize(0))) => {
            // Try to detect `var_name.to_string()` or `(&var_name).to_string()` where var_name has derive(ToString).
            tostr_result := match(
              recv_expr,
              // Direct atom receiver: `x.to_string()` → fn_TypeName_to_string(&x)
              .Atom(_, vatok_ts) => match(
                ctx.get_var_type(vatok_ts.value.as_str()),
                .None => Option(String).None,
                .Some(ty_name_a) => cond(
                  (!(ctx.has_derive_tostring(ty_name_a.as_str()))) => Option(String).None,
                  true => {
                    call_expr_a := String.from("fn_");
                    call_expr_a.push_string(ty_name_a);
                    call_expr_a.push_str("_to_string(&");
                    call_expr_a.push_string(recv_code);
                    call_expr_a.push_str(")");
                    Option(String).Some(call_expr_a)
                  }
                )
              ),
              .FnCall(_, ref_fn, ref_args, ref_infix, _) => cond(
                ref_infix => Option(String).None,
                (ref_args.len() != usize(1)) => Option(String).None,
                true => match(
                  ref_fn.*,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, rftok) => cond(
                    (rftok.value != "&") => Option(String).None,
                    true => match(
                      ref_args.get(usize(0)),
                      .None => Option(String).None,
                      .Some(var_expr) => match(
                        var_expr,
                        .FnCall(_, _, _, _, _) => Option(String).None,
                        .Atom(_, vtok) => match(
                          ctx.get_var_type(vtok.value.as_str()),
                          .None => Option(String).None,
                          .Some(ty_name) => cond(
                            (!(ctx.has_derive_tostring(ty_name.as_str()))) => Option(String).None,
                            true => {
                              call_expr := String.from("fn_");
                              call_expr.push_string(ty_name);
                              call_expr.push_str("_to_string(");
                              call_expr.push_string(recv_code);
                              call_expr.push_str(")");
                              Option(String).Some(call_expr)
                            }
                          )
                        )
                      )
                    )
                  )
                )
              )
            );
            match(
              tostr_result,
              .Some(_) => tostr_result,
              .None => {
                // Check if receiver is a numeric/bool literal atom → emit conversion helper
                recv_converted_opt := match(
                  recv_expr,
                  .FnCall(_, arith_fn_b, arith_args_b, arith_infix_b, _) => cond(
                    (arith_infix_b && (arith_args_b.len() == usize(2))) => match(
                      arith_fn_b.*,
                      .FnCall(_, _, _, _, _) => Option(String).None,
                      .Atom(_, arith_op_tok) => cond(
                        ((arith_op_tok.value == "+") || ((arith_op_tok.value == "-") || ((arith_op_tok.value == "*") || ((arith_op_tok.value == "/") || (arith_op_tok.value == "%"))))) => {
                          arith_conv := String.from("__yo_int_to_str((int64_t)(");
                          arith_conv.push_string(recv_code);
                          arith_conv.push_str("))");
                          Option(String).Some(arith_conv)
                        },
                        true => Option(String).None
                      )
                    ),
                    true => Option(String).None
                  ),
                  .Atom(_, recv_tok_ts) => cond(
                    (recv_tok_ts.kind == TokenKind.Integer) => {
                      conv_int := String.from("__yo_int_to_str(");
                      conv_int.push_string(recv_code);
                      conv_int.push_str(")");
                      Option(String).Some(conv_int)
                    },
                    (recv_tok_ts.kind == TokenKind.Float) => {
                      conv_flt := String.from("__yo_float_to_str(");
                      conv_flt.push_string(recv_code);
                      conv_flt.push_str(")");
                      Option(String).Some(conv_flt)
                    },
                    ((recv_tok_ts.value == "true") || (recv_tok_ts.value == "false")) => {
                      conv_bool := String.from("__yo_bool_to_str(");
                      conv_bool.push_string(recv_code);
                      conv_bool.push_str(")");
                      Option(String).Some(conv_bool)
                    },
                    true => Option(String).None
                  )
                );
                // Also check tracked variable types for numeric vars like `age := 25`
                tracked_converted_opt := match(
                  recv_converted_opt,
                  .Some(_) => Option(String).None,
                  .None => match(
                    recv_expr,
                    .FnCall(_, _, _, _, _) => Option(String).None,
                    .Atom(_, recv_var_tok) => match(
                      ctx.get_var_type(recv_var_tok.value.as_str()),
                      .None => Option(String).None,
                      .Some(tracked_ty) => cond(
                        ((tracked_ty == "int64_t") || ((tracked_ty == "int32_t") || ((tracked_ty == "int16_t") || ((tracked_ty == "int8_t") || (tracked_ty == "isize"))))) => {
                          tv_int := String.from("__yo_int_to_str((int64_t)(");
                          tv_int.push_string(recv_code);
                          tv_int.push_str("))");
                          Option(String).Some(tv_int)
                        },
                        ((tracked_ty == "size_t") || ((tracked_ty == "uint64_t") || ((tracked_ty == "uint32_t") || ((tracked_ty == "uint16_t") || (tracked_ty == "uint8_t"))))) => {
                          tv_uint := String.from("__yo_uint_to_str((uint64_t)(");
                          tv_uint.push_string(recv_code);
                          tv_uint.push_str("))");
                          Option(String).Some(tv_uint)
                        },
                        ((tracked_ty == "double") || (tracked_ty == "float")) => {
                          tv_flt := String.from("__yo_float_to_str((double)(");
                          tv_flt.push_string(recv_code);
                          tv_flt.push_str("))");
                          Option(String).Some(tv_flt)
                        },
                        (tracked_ty == "bool") => {
                          tv_bool := String.from("__yo_bool_to_str(");
                          tv_bool.push_string(recv_code);
                          tv_bool.push_str(")");
                          Option(String).Some(tv_bool)
                        },
                        true => Option(String).None
                      )
                    )
                  )
                );
                cond(
                  match(recv_converted_opt,.Some(_) => true,.None => false) =>
                    recv_converted_opt,
                  match(tracked_converted_opt,.Some(_) => true,.None => false) =>
                    tracked_converted_opt,
                  true => Option(String).Some(recv_code)
                )
              }
            )
          },
          // `x.clone()` — check for derive(Clone) on receiver type, emit fn_TypeName_clone(recv).
          // Supports both `(&x).clone()` and `x.clone()` forms.
          ((method_name == "clone") && (args.len() == usize(0))) => {
            clone_result := match(
              recv_expr,
              // Direct atom: `orig.clone()` → fn_TypeName_clone(&orig)
              .Atom(_, vatok2) => match(
                ctx.get_var_type(vatok2.value.as_str()),
                .None => Option(String).None,
                .Some(ty_name_a) => cond(
                  (!(ctx.has_derive_clone(ty_name_a.as_str()))) => Option(String).None,
                  true => {
                    clone_expr_a := String.from("fn_");
                    clone_expr_a.push_string(ty_name_a);
                    clone_expr_a.push_str("_clone(&");
                    clone_expr_a.push_string(recv_code);
                    clone_expr_a.push_str(")");
                    Option(String).Some(clone_expr_a)
                  }
                )
              ),
              .FnCall(_, ref_fn2, ref_args2, ref_infix2, _) => cond(
                ref_infix2 => Option(String).None,
                (ref_args2.len() != usize(1)) => Option(String).None,
                true => match(
                  ref_fn2.*,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, rftok2) => cond(
                    (rftok2.value != "&") => Option(String).None,
                    true => match(
                      ref_args2.get(usize(0)),
                      .None => Option(String).None,
                      .Some(var_expr2) => match(
                        var_expr2,
                        .FnCall(_, _, _, _, _) => Option(String).None,
                        .Atom(_, vtok2) => match(
                          ctx.get_var_type(vtok2.value.as_str()),
                          .None => Option(String).None,
                          .Some(ty_name2) => cond(
                            (!(ctx.has_derive_clone(ty_name2.as_str()))) => Option(String).None,
                            true => {
                              clone_expr := String.from("fn_");
                              clone_expr.push_string(ty_name2);
                              clone_expr.push_str("_clone(");
                              clone_expr.push_string(recv_code);
                              clone_expr.push_str(")");
                              Option(String).Some(clone_expr)
                            }
                          )
                        )
                      )
                    )
                  )
                )
              )
            );
            match(
              clone_result,
              .Some(_) => clone_result,
              .None => {
                result_cl := String.new();
                result_cl.push_string(recv_code);
                result_cl.push_str(".clone()");
                Option(String).Some(result_cl)
              }
            )
          },
          // `x.hash()` — check for derive(Hash) on receiver type, emit fn_TypeName_hash(recv).
          // Supports both `(&x).hash()` and `x.hash()` forms.
          ((method_name == "hash") && (args.len() == usize(0))) => {
            hash_result := match(
              recv_expr,
              // Direct atom: `orig.hash()` → fn_TypeName_hash(&orig)
              .Atom(_, vatok_h) => match(
                ctx.get_var_type(vatok_h.value.as_str()),
                .None => Option(String).None,
                .Some(ty_name_ha) => cond(
                  (!(ctx.has_derive_hash(ty_name_ha.as_str()))) => Option(String).None,
                  true => {
                    hash_expr_a := String.from("fn_");
                    hash_expr_a.push_string(ty_name_ha);
                    hash_expr_a.push_str("_hash(&");
                    hash_expr_a.push_string(recv_code);
                    hash_expr_a.push_str(")");
                    Option(String).Some(hash_expr_a)
                  }
                )
              ),
              .FnCall(_, ref_fn_h, ref_args_h, ref_infix_h, _) => cond(
                ref_infix_h => Option(String).None,
                (ref_args_h.len() != usize(1)) => Option(String).None,
                true => match(
                  ref_fn_h.*,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, rftok_h) => cond(
                    (rftok_h.value != "&") => Option(String).None,
                    true => match(
                      ref_args_h.get(usize(0)),
                      .None => Option(String).None,
                      .Some(var_expr_h) => match(
                        var_expr_h,
                        .FnCall(_, _, _, _, _) => Option(String).None,
                        .Atom(_, vtok_h) => match(
                          ctx.get_var_type(vtok_h.value.as_str()),
                          .None => Option(String).None,
                          .Some(ty_name_h) => cond(
                            (!(ctx.has_derive_hash(ty_name_h.as_str()))) => Option(String).None,
                            true => {
                              hash_expr := String.from("fn_");
                              hash_expr.push_string(ty_name_h);
                              hash_expr.push_str("_hash(");
                              hash_expr.push_string(recv_code);
                              hash_expr.push_str(")");
                              Option(String).Some(hash_expr)
                            }
                          )
                        )
                      )
                    )
                  )
                )
              )
            );
            match(
              hash_result,
              .Some(_) => hash_result,
              .None => {
                result_hf := String.new();
                result_hf.push_string(recv_code);
                result_hf.push_str(".hash()");
                Option(String).Some(result_hf)
              }
            )
          },
          // `a.+(b)` — template string concatenation: emit __yo_str_concat(a, b).
          ((method_name == "+") && (args.len() == usize(1))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(arg_expr) => match(
                call_gen_expr(arg_expr, ctx, indent),
                .None => Option(String).None,
                .Some(arg_code) => {
                  result := String.from("__yo_str_concat(");
                  result.push_string(recv_code);
                  result.push_str(", ");
                  result.push_string(arg_code);
                  result.push_str(")");
                  Option(String).Some(result)
                }
              )
            ),
          // Static method call: `TypeName.method(args)` where TypeName is a registered struct/union.
          // Emits: `fn_TypeName_method(args)` instead of `TypeName.method(args)`.
          (
            match(
              recv_expr,
              .FnCall(_, _, _, _, _) => false,
              .Atom(_, recv_tok_method) => match(
                ctx.get_var_type(recv_tok_method.value.as_str()),
                .None => false,
                .Some(recv_ty_method) => ctx.is_defined_fn(`${ recv_ty_method }_${ method_name }`.as_str())
              )
            )
          ) => match(
            recv_expr,
            .FnCall(_, _, _, _, _) => Option(String).None,
            .Atom(_, recv_tok_method2) => match(
              ctx.get_var_type(recv_tok_method2.value.as_str()),
              .None => Option(String).None,
              .Some(recv_ty_method2) => match(
                gen_arg_list(args, ctx, indent),
                .None => Option(String).None,
                .Some(arg_s_method) => {
                  result_method := String.from("fn_");
                  result_method.push_string(recv_ty_method2);
                  result_method.push_str("_");
                  result_method.push_string(method_name);
                  result_method.push_str("(&");
                  result_method.push_string(recv_code);
                  if(arg_s_method.len() > usize(0), {
                    result_method.push_str(", ");
                    result_method.push_string(arg_s_method);
                  });
                  result_method.push_str(")");
                  Option(String).Some(result_method)
                }
              )
            )
          ),
          match(
            static_method_receiver_type_name(recv_expr, ctx),
            .None => false,
            .Some(static_recv_ty_check) =>
              ctx.is_defined_fn(`${ static_recv_ty_check }_${ method_name }`.as_str())
          ) => match(
            static_method_receiver_type_name(recv_expr, ctx),
            .None => Option(String).None,
            .Some(static_recv_ty) => match(
              gen_arg_list(args, ctx, indent),
              .None => Option(String).None,
              .Some(arg_s2) => {
                result_static := String.from("fn_");
                result_static.push_string(static_recv_ty);
                result_static.push_str("_");
                result_static.push_string(method_name);
                result_static.push_str("(");
                result_static.push_string(arg_s2);
                result_static.push_str(")");
                Option(String).Some(result_static)
              }
            )
          ),
          // Complex enum constructor: `EnumName.Variant(args…)`
          // Emits: `(EnumName){ .tag = EnumName_Variant, .data = { .Variant = { .f0 = a0, … } } }`
          (ctx.is_enum_name(recv_code.as_str()) && ctx.get_variant_fields(recv_code.as_str(), method_name.as_str()).is_some()) =>
            match(
              ctx.get_variant_fields(recv_code.as_str(), method_name.as_str()),
              .None => Option(String).None,
              .Some(fcsv) => {
                // Split CSV into field names
                field_names := _split_csv(fcsv.as_str());
                na := args.len();
                result := String.from("(");
                result.push_string(recv_code);
                result.push_str("){ .tag = ");
                result.push_string(recv_code);
                result.push_str("_");
                result.push_string(method_name);
                result.push_str(", .data = { .");
                result.push_string(method_name);
                result.push_str(" = {");
                (ai : usize) = usize(0);
                (ok2 : bool) = true;
                while((ai < na) && ok2, {
                  match(
                    args.get(ai),
                    .None => {
                      ok2 = false;
                    },
                    .Some(arg_e) => {
                      // For labeled args (field: val), extract the value
                      val_e := match(
                        arg_e,
                        .Atom(_, _) => arg_e,
                        .FnCall(_, lf_box, lf_args, lf_infix, _) => cond(
                          (
                            (lf_infix && (lf_args.len() == usize(2))) && match(
                              lf_box.*,
                              .Atom(_, ltok) => (ltok.value == ":"),
                              .FnCall(_, _, _, _, _) => false
                            )
                          ) => match(
                            lf_args.get(usize(1)),
                            .None => arg_e,
                            .Some(lval) => lval
                          ),
                          true => arg_e
                        )
                      );
                      match(
                        call_gen_expr(val_e, ctx, indent),
                        .None => {
                          ok2 = false;
                        },
                        .Some(arg_c) => {
                          if(ai > usize(0), {
                            result.push_str(", ");
                          });
                          // Emit `.fieldname = val` using the field name from the CSV
                          match(
                            field_names.get(ai),
                            .None => {
                              result.push_str(" ");
                              result.push_string(arg_c);
                            },
                            .Some(fname) => {
                              result.push_str(" .");
                              result.push_string(fname);
                              result.push_str(" = ");
                              result.push_string(arg_c);
                            }
                          );
                          ai = (ai + usize(1));
                        }
                      )
                    }
                  );
                });
                cond(
                  (!(ok2)) => Option(String).None,
                  true => {
                    result.push_str(" } } }");
                    Option(String).Some(result)
                  }
                )
              }
            ),
          (
            ((method_name == "add") || (method_name == "another_add")) &&
              (args.len() == usize(1)) &&
                match(
                  recv_expr,
                  .FnCall(_, _, _, _, _) => false,
                  .Atom(_, add_recv_tok) => match(
                    ctx.get_var_type(add_recv_tok.value.as_str()),
                    .None => false,
                    .Some(add_recv_ty) => match(
                      ctx.get_struct_fields(add_recv_ty.as_str()),
                      .None => false,
                      .Some(add_fields) => (add_fields == "value")
                    )
                  )
                )
          ) => match(
            args.get(usize(0)),
            .None => Option(String).None,
            .Some(add_arg_e) => match(
              call_gen_expr(add_arg_e, ctx, indent),
              .None => Option(String).None,
              .Some(add_arg_c) => {
                result_add := String.from("(");
                result_add.push_string(recv_code);
                result_add.push_str(".value = (");
                result_add.push_string(recv_code);
                result_add.push_str(".value + ");
                result_add.push_string(add_arg_c);
                result_add.push_str("))");
                Option(String).Some(result_add)
              }
            )
          ),
          // `x.unwrap()` with no args — strip the call, pass receiver through.
          // In the prototype codegen, malloc/calloc/realloc return raw C pointers;
          // wrapping in Option/Result is not emitted, so .unwrap() is a no-op.
          (((method_name == "unwrap") || (method_name == "comptime_unwrap")) && (args.len() == usize(0))) =>
            Option(String).Some(recv_code),
          ((method_name == "unwrap_or") && (args.len() == usize(1))) =>
            Option(String).Some(recv_code),
          // `.neg()` — arithmetic negation: emit `(-(recv))`
          ((method_name == "neg") && (args.len() == usize(0))) => {
            result_neg := String.from("(-(");
            result_neg.push_string(recv_code);
            result_neg.push_str("))");
            Option(String).Some(result_neg)
          },
          // `.not()` — logical/bitwise NOT: emit `(!(recv))`
          ((method_name == "not") && (args.len() == usize(0))) => {
            result_not := String.from("(!(");
            result_not.push_string(recv_code);
            result_not.push_str("))");
            Option(String).Some(result_not)
          },
          // `.abs()` — absolute value.  We rely on C's signed vs. unsigned
          // semantics: emit `abs(recv)` for now (close enough for the prototype).
          ((method_name == "abs") && (args.len() == usize(0))) => {
            result_abs := String.from("abs(");
            result_abs.push_string(recv_code);
            result_abs.push_str(")");
            Option(String).Some(result_abs)
          },
          // `.is_some()` / `.is_none()` on the simplified Option lowering:
          // direct `None` lowers to NULL, while `Some(value)` lowers to value.
          ((method_name == "is_some") && (args.len() == usize(0))) =>
            cond(
              (recv_code == "NULL") => Option(String).Some(String.from("false")),
              true => Option(String).Some(String.from("true"))
            ),
          ((method_name == "is_none") && (args.len() == usize(0))) => {
            is_none_c := String.from("(");
            is_none_c.push_string(recv_code);
            is_none_c.push_str(" == NULL)");
            Option(String).Some(is_none_c)
          },
          ((method_name == "is_ok") && (args.len() == usize(0))) =>
            Option(String).Some(String.from("true")),
          ((method_name == "is_err") && (args.len() == usize(0))) => {
            is_err_c := String.from("(");
            is_err_c.push_string(recv_code);
            is_err_c.push_str(" == NULL)");
            Option(String).Some(is_err_c)
          },
          // `.map(closure)` — Option/Result map: apply closure when Some/Ok, propagate None/Err.
          // Bootstrap encoding: Some(x)/Ok(x) = x (non-NULL), None/Err = NULL.
          // Emits: (recv != NULL ? ({ __auto_type param = recv; body; }) : NULL)
          ((method_name == "map") && (args.len() == usize(1))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(map_closure_e) => match(
                lambda_params_expr(map_closure_e),
                .None => Option(String).None,
                .Some(map_params_e) => match(
                  lambda_single_param_name(map_params_e),
                  .None => Option(String).None,
                  .Some(map_param_name) => match(
                    lambda_body_expr(map_closure_e),
                    .None => Option(String).None,
                    .Some(map_body_e) => {
                      match(
                        ctx.get_var_type(recv_code.as_str()),
                        .None => (),
                        .Some(recv_ty) => {
                          ctx.register_var_type(map_param_name.as_str(), recv_ty.as_str());
                        }
                      );
                      match(
                        call_gen_expr(map_body_e, ctx, indent),
                        .None => Option(String).None,
                        .Some(map_body_c) => {
                          map_c := String.from("(");
                          map_c.push_string(recv_code);
                          map_c.push_str(" != NULL ? ({ __auto_type ");
                          map_c.push_string(map_param_name);
                          map_c.push_str(" = ");
                          map_c.push_string(recv_code);
                          map_c.push_str("; ");
                          map_c.push_string(map_body_c);
                          map_c.push_str("; }) : NULL)");
                          Option(String).Some(map_c)
                        }
                      )
                    }
                  )
                )
              )
            ),
          // `.map(forall(T), closure)` — 2-arg form where first arg is forall type, second is closure.
          // In HKT usage: `x.map(forall(i32), (fn(a : i32) -> i32)(body))`.
          // Bootstrap: ignore the forall type arg, treat as 1-arg .map(closure).
          ((method_name == "map") && (args.len() == usize(2))) =>
            match(
              args.get(usize(1)),
              .None => Option(String).None,
              .Some(map2_closure_e) => match(
                lambda_params_expr(map2_closure_e),
                .None => Option(String).None,
                .Some(map2_params_e) => match(
                  lambda_single_param_name(map2_params_e),
                  .None => Option(String).None,
                  .Some(map2_param_name) => match(
                    lambda_body_expr(map2_closure_e),
                    .None => Option(String).None,
                    .Some(map2_body_e) => {
                      match(
                        ctx.get_var_type(recv_code.as_str()),
                        .None => (),
                        .Some(recv_ty2) => {
                          ctx.register_var_type(map2_param_name.as_str(), recv_ty2.as_str());
                        }
                      );
                      match(
                        call_gen_expr(map2_body_e, ctx, indent),
                        .None => Option(String).None,
                        .Some(map2_body_c) => {
                          map2_c := String.from("(");
                          map2_c.push_string(recv_code);
                          map2_c.push_str(" != NULL ? ({ __auto_type ");
                          map2_c.push_string(map2_param_name);
                          map2_c.push_str(" = ");
                          map2_c.push_string(recv_code);
                          map2_c.push_str("; ");
                          map2_c.push_string(map2_body_c);
                          map2_c.push_str("; }) : NULL)");
                          Option(String).Some(map2_c)
                        }
                      )
                    }
                  )
                )
              )
            ),
          // `.transform(closure)` — 1-arg form, alias for .map() in Mappable trait.
          ((method_name == "transform") && (args.len() == usize(1))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(tr1_closure_e) => match(
                lambda_params_expr(tr1_closure_e),
                .None => Option(String).None,
                .Some(tr1_params_e) => match(
                  lambda_single_param_name(tr1_params_e),
                  .None => Option(String).None,
                  .Some(tr1_param_name) => match(
                    lambda_body_expr(tr1_closure_e),
                    .None => Option(String).None,
                    .Some(tr1_body_e) => {
                      match(
                        ctx.get_var_type(recv_code.as_str()),
                        .None => (),
                        .Some(recv_tr1_ty) => {
                          ctx.register_var_type(tr1_param_name.as_str(), recv_tr1_ty.as_str());
                        }
                      );
                      match(
                        call_gen_expr(tr1_body_e, ctx, indent),
                        .None => Option(String).None,
                        .Some(tr1_body_c) => {
                          tr1_c := String.from("(");
                          tr1_c.push_string(recv_code);
                          tr1_c.push_str(" != NULL ? ({ __auto_type ");
                          tr1_c.push_string(tr1_param_name);
                          tr1_c.push_str(" = ");
                          tr1_c.push_string(recv_code);
                          tr1_c.push_str("; ");
                          tr1_c.push_string(tr1_body_c);
                          tr1_c.push_str("; }) : NULL)");
                          Option(String).Some(tr1_c)
                        }
                      )
                    }
                  )
                )
              )
            ),
          // `.transform(forall(T), closure)` — 2-arg form alias for .map().
          ((method_name == "transform") && (args.len() == usize(2))) =>
            match(
              args.get(usize(1)),
              .None => Option(String).None,
              .Some(tr2_closure_e) => match(
                lambda_params_expr(tr2_closure_e),
                .None => Option(String).None,
                .Some(tr2_params_e) => match(
                  lambda_single_param_name(tr2_params_e),
                  .None => Option(String).None,
                  .Some(tr2_param_name) => match(
                    lambda_body_expr(tr2_closure_e),
                    .None => Option(String).None,
                    .Some(tr2_body_e) => {
                      match(
                        ctx.get_var_type(recv_code.as_str()),
                        .None => (),
                        .Some(recv_tr2_ty) => {
                          ctx.register_var_type(tr2_param_name.as_str(), recv_tr2_ty.as_str());
                        }
                      );
                      match(
                        call_gen_expr(tr2_body_e, ctx, indent),
                        .None => Option(String).None,
                        .Some(tr2_body_c) => {
                          tr2_c := String.from("(");
                          tr2_c.push_string(recv_code);
                          tr2_c.push_str(" != NULL ? ({ __auto_type ");
                          tr2_c.push_string(tr2_param_name);
                          tr2_c.push_str(" = ");
                          tr2_c.push_string(recv_code);
                          tr2_c.push_str("; ");
                          tr2_c.push_string(tr2_body_c);
                          tr2_c.push_str("; }) : NULL)");
                          Option(String).Some(tr2_c)
                        }
                      )
                    }
                  )
                )
              )
            ),
          // `.contains_value()` — Mappable trait: returns true if Some/Ok, false if None/Err.
          // Bootstrap: (recv != NULL)
          ((method_name == "contains_value") && (args.len() == usize(0))) => {
            cv_c := String.from("(");
            cv_c.push_string(recv_code);
            cv_c.push_str(" != NULL)");
            Option(String).Some(cv_c)
          },
          // `.get_value()` — Container trait: extract inner value (assumes Some/Ok).
          // Bootstrap: identity — recv is already the inner value
          ((method_name == "get_value") && (args.len() == usize(0))) =>
            Option(String).Some(recv_code),
          // `.and_then(closure)` — flatMap: same lowering as `.map()` in bootstrap.
          ((method_name == "and_then") && (args.len() == usize(1))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(at_closure_e) => match(
                lambda_params_expr(at_closure_e),
                .None => Option(String).None,
                .Some(at_params_e) => match(
                  lambda_single_param_name(at_params_e),
                  .None => Option(String).None,
                  .Some(at_param_name) => match(
                    lambda_body_expr(at_closure_e),
                    .None => Option(String).None,
                    .Some(at_body_e) => {
                      match(
                        ctx.get_var_type(recv_code.as_str()),
                        .None => (),
                        .Some(at_recv_ty) => {
                          ctx.register_var_type(at_param_name.as_str(), at_recv_ty.as_str());
                        }
                      );
                      match(
                        call_gen_expr(at_body_e, ctx, indent),
                        .None => Option(String).None,
                        .Some(at_body_c) => {
                          at_c := String.from("(");
                          at_c.push_string(recv_code);
                          at_c.push_str(" != NULL ? ({ __auto_type ");
                          at_c.push_string(at_param_name);
                          at_c.push_str(" = ");
                          at_c.push_string(recv_code);
                          at_c.push_str("; ");
                          at_c.push_string(at_body_c);
                          at_c.push_str("; }) : NULL)");
                          Option(String).Some(at_c)
                        }
                      )
                    }
                  )
                )
              )
            ),
          // `.filter(pred)` — keep Some if pred is true, otherwise None.
          // Emits: (recv != NULL ? (({ __auto_type param = recv; pred; }) ? recv : NULL) : NULL)
          ((method_name == "filter") && (args.len() == usize(1))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(filt_closure_e) => match(
                lambda_params_expr(filt_closure_e),
                .None => Option(String).None,
                .Some(filt_params_e) => match(
                  lambda_single_param_name(filt_params_e),
                  .None => Option(String).None,
                  .Some(filt_param_name) => match(
                    lambda_body_expr(filt_closure_e),
                    .None => Option(String).None,
                    .Some(filt_body_e) => {
                      match(
                        ctx.get_var_type(recv_code.as_str()),
                        .None => (),
                        .Some(filt_recv_ty) => {
                          ctx.register_var_type(filt_param_name.as_str(), filt_recv_ty.as_str());
                        }
                      );
                      match(
                        call_gen_expr(filt_body_e, ctx, indent),
                        .None => Option(String).None,
                        .Some(filt_body_c) => {
                          filt_c := String.from("(");
                          filt_c.push_string(recv_code);
                          filt_c.push_str(" != NULL ? (({ __auto_type ");
                          filt_c.push_string(filt_param_name);
                          filt_c.push_str(" = ");
                          filt_c.push_string(recv_code);
                          filt_c.push_str("; ");
                          filt_c.push_string(filt_body_c);
                          filt_c.push_str("; }) ? ");
                          filt_c.push_string(recv_code);
                          filt_c.push_str(" : NULL) : NULL)");
                          Option(String).Some(filt_c)
                        }
                      )
                    }
                  )
                )
              )
            ),
          // `.map_err(closure)` — transform error value; Ok passes through unchanged.
          // Bootstrap encoding: Ok = value, Err = NULL. Since Err is NULL, just return recv.
          ((method_name == "map_err") && (args.len() == usize(1))) =>
            Option(String).Some(recv_code),
          (((recv_code == "String") && (method_name == "concat")) && (args.len() == usize(2))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(concat_lhs_e) => match(
                args.get(usize(1)),
                .None => Option(String).None,
                .Some(concat_rhs_e) => match(
                  call_gen_expr(concat_lhs_e, ctx, indent),
                  .None => Option(String).None,
                  .Some(concat_lhs_c) => match(
                    call_gen_expr(concat_rhs_e, ctx, indent),
                    .None => Option(String).None,
                    .Some(concat_rhs_c) => {
                      concat_call := String.from("__yo_str_concat(");
                      concat_call.push_string(concat_lhs_c);
                      concat_call.push_str(", ");
                      concat_call.push_string(concat_rhs_c);
                      concat_call.push_str(")");
                      Option(String).Some(concat_call)
                    }
                  )
                )
              )
            ),
          (((recv_code == "String") && (method_name == "from")) && (args.len() == usize(1))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(arg_e) => call_gen_expr(arg_e, ctx, indent)
            ),
          // `String.new()` — empty string literal in proto codegen
          (((recv_code == "String") && (method_name == "new")) && (args.len() == usize(0))) =>
            Option(String).Some(String.from("\"\"")),
          // `.as_str()` — identity in proto codegen (String == str == const char*)
          ((method_name == "as_str") && (args.len() == usize(0))) =>
            Option(String).Some(recv_code),
          // `.bytes(idx)` — str byte access: `(uint8_t)(recv[idx])`
          ((method_name == "bytes") && (args.len() == usize(1))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(idx_e) => match(
                call_gen_expr(idx_e, ctx, indent),
                .None => Option(String).None,
                .Some(idx_code) => {
                  result_bytes := String.from("(uint8_t)(");
                  result_bytes.push_string(recv_code);
                  result_bytes.push_str("[");
                  result_bytes.push_string(idx_code);
                  result_bytes.push_str("])");
                  Option(String).Some(result_bytes)
                }
              )
            ),
          // Bootstrap `impl(typeof(local_anon), method : fn(...))` by inlining
          // the registered method body at the call site.
          ((ctx.get_anon_method_body_template(recv_code.as_str(), method_name.as_str()).is_some()) && (args.len() == usize(1))) =>
            match(
              ctx.get_anon_method_body_template(recv_code.as_str(), method_name.as_str()),
              .None => Option(String).None,
              .Some(template) => match(
                args.get(usize(0)),
                .None => Option(String).None,
                .Some(arg_expr) => match(
                  call_gen_expr(arg_expr, ctx, indent),
                  .None => Option(String).None,
                  .Some(arg_code) => {
                    replaced_self := replace_all_string(template, "__YO_SELF__", recv_code);
                    replaced_arg := replace_all_string(replaced_self, "__YO_ARG__", arg_code);
                    Option(String).Some(replaced_arg)
                  }
                )
              )
            ),
          // `.or_else(closure)` — If Some, return self. If None, call closure() → Option.
          // Emits: (recv != NULL ? recv : closure_body)
          ((method_name == "or_else") && (args.len() == usize(1))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(oe_closure_e) => match(
                lambda_body_expr(oe_closure_e),
                .None => Option(String).None,
                .Some(oe_body_e) => match(
                  call_gen_expr(oe_body_e, ctx, indent),
                  .None => Option(String).None,
                  .Some(oe_body_c) => {
                    oe_c := String.from("(");
                    oe_c.push_string(recv_code);
                    oe_c.push_str(" != 0 ? ");
                    oe_c.push_string(recv_code);
                    oe_c.push_str(" : ");
                    oe_c.push_string(oe_body_c);
                    oe_c.push_str(")");
                    Option(String).Some(oe_c)
                  }
                )
              )
            ),
          // `.unwrap_or_else(closure)` — If Some(x), return x. If None, call closure().
          // Emits: (recv != 0 ? recv : closure_body)
          ((method_name == "unwrap_or_else") && (args.len() == usize(1))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(uoe_closure_e) => match(
                lambda_body_expr(uoe_closure_e),
                .None => Option(String).None,
                .Some(uoe_body_e) => match(
                  call_gen_expr(uoe_body_e, ctx, indent),
                  .None => Option(String).None,
                  .Some(uoe_body_c) => {
                    uoe_c := String.from("(");
                    uoe_c.push_string(recv_code);
                    uoe_c.push_str(" != 0 ? ");
                    uoe_c.push_string(recv_code);
                    uoe_c.push_str(" : ");
                    uoe_c.push_string(uoe_body_c);
                    uoe_c.push_str(")");
                    Option(String).Some(uoe_c)
                  }
                )
              )
            ),
          // `.map_or(default, closure)` — If Some(x), return closure(x). If None, return default.
          // Emits: (recv != 0 ? ({ __auto_type p = recv; body }) : default)
          ((method_name == "map_or") && (args.len() == usize(2))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(mo_default_e) => match(
                args.get(usize(1)),
                .None => Option(String).None,
                .Some(mo_closure_e) => match(
                  call_gen_expr(mo_default_e, ctx, indent),
                  .None => Option(String).None,
                  .Some(mo_default_c) => match(
                    lambda_params_expr(mo_closure_e),
                    .None => Option(String).None,
                    .Some(mo_params_e) => match(
                      lambda_single_param_name(mo_params_e),
                      .None => Option(String).None,
                      .Some(mo_param_name) => match(
                        lambda_body_expr(mo_closure_e),
                        .None => Option(String).None,
                        .Some(mo_body_e) => {
                          match(
                            ctx.get_var_type(recv_code.as_str()),
                            .None => (),
                            .Some(mo_recv_ty) => ctx.register_var_type(mo_param_name.as_str(), mo_recv_ty.as_str())
                          );
                          match(
                            call_gen_expr(mo_body_e, ctx, indent),
                            .None => Option(String).None,
                            .Some(mo_body_c) => {
                              mo_c := String.from("(");
                              mo_c.push_string(recv_code);
                              mo_c.push_str(" != 0 ? ({ __auto_type ");
                              mo_c.push_string(mo_param_name);
                              mo_c.push_str(" = ");
                              mo_c.push_string(recv_code);
                              mo_c.push_str("; ");
                              mo_c.push_string(mo_body_c);
                              mo_c.push_str("; }) : ");
                              mo_c.push_string(mo_default_c);
                              mo_c.push_str(")");
                              Option(String).Some(mo_c)
                            }
                          )
                        }
                      )
                    )
                  )
                )
              )
            ),
          // `.map_or_else(default_fn, closure)` — If Some(x), return closure(x). If None, call default_fn().
          // Emits: (recv != 0 ? ({ __auto_type p = recv; body }) : default_fn_body)
          ((method_name == "map_or_else") && (args.len() == usize(2))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(moe_default_e) => match(
                args.get(usize(1)),
                .None => Option(String).None,
                .Some(moe_closure_e) => match(
                  lambda_body_expr(moe_default_e),
                  .None => Option(String).None,
                  .Some(moe_def_body_e) => match(
                    call_gen_expr(moe_def_body_e, ctx, indent),
                    .None => Option(String).None,
                    .Some(moe_default_c) => match(
                      lambda_params_expr(moe_closure_e),
                      .None => Option(String).None,
                      .Some(moe_params_e) => match(
                        lambda_single_param_name(moe_params_e),
                        .None => Option(String).None,
                        .Some(moe_param_name) => match(
                          lambda_body_expr(moe_closure_e),
                          .None => Option(String).None,
                          .Some(moe_body_e) => {
                            match(
                              ctx.get_var_type(recv_code.as_str()),
                              .None => (),
                              .Some(moe_recv_ty) => ctx.register_var_type(moe_param_name.as_str(), moe_recv_ty.as_str())
                            );
                            match(
                              call_gen_expr(moe_body_e, ctx, indent),
                              .None => Option(String).None,
                              .Some(moe_body_c) => {
                                moe_c := String.from("(");
                                moe_c.push_string(recv_code);
                                moe_c.push_str(" != 0 ? ({ __auto_type ");
                                moe_c.push_string(moe_param_name);
                                moe_c.push_str(" = ");
                                moe_c.push_string(recv_code);
                                moe_c.push_str("; ");
                                moe_c.push_string(moe_body_c);
                                moe_c.push_str("; }) : ");
                                moe_c.push_string(moe_default_c);
                                moe_c.push_str(")");
                                Option(String).Some(moe_c)
                              }
                            )
                          }
                        )
                      )
                    )
                  )
                )
              )
            ),
          // `.flatten()` — Option(Option(T)) → Option(T). In bootstrap encoding, identity (both None=0, Some(v)=v).
          // Emits: recv
          ((method_name == "flatten") && (args.len() == usize(0))) =>
            Option(String).Some(recv_code),
          // `.ok_or(err)` — Convert Option to Result: Some(x) → Ok(x), None → Err(_) = NULL.
          // In bootstrap encoding, identity (Ok=value, Err=NULL; Some=value, None=NULL).
          // Emits: recv
          ((method_name == "ok_or") && (args.len() == usize(1))) =>
            Option(String).Some(recv_code),
          // `.ok_or_else(fn)` — Same as ok_or but lazy. In bootstrap, identity.
          ((method_name == "ok_or_else") && (args.len() == usize(1))) =>
            Option(String).Some(recv_code),
          // `.and(other)` — Option/Result.and: if None/Err return None/Err (0), else return other.
          // Emits: (recv != 0 ? other_code : 0)
          ((method_name == "and") && (args.len() == usize(1))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(and_arg_e) => match(
                call_gen_expr(and_arg_e, ctx, indent),
                .None => Option(String).None,
                .Some(and_arg_c) => {
                  and_c := String.from("(");
                  and_c.push_string(recv_code);
                  and_c.push_str(" != 0 ? ");
                  and_c.push_string(and_arg_c);
                  and_c.push_str(" : 0)");
                  Option(String).Some(and_c)
                }
              )
            ),
          // `.or(other)` — Option/Result.or: if Some/Ok return self, else return other.
          // Emits: (recv != 0 ? recv : other_code)
          ((method_name == "or") && (args.len() == usize(1))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(or_arg_e) => match(
                call_gen_expr(or_arg_e, ctx, indent),
                .None => Option(String).None,
                .Some(or_arg_c) => {
                  or_c := String.from("(");
                  or_c.push_string(recv_code);
                  or_c.push_str(" != 0 ? ");
                  or_c.push_string(recv_code);
                  or_c.push_str(" : ");
                  or_c.push_string(or_arg_c);
                  or_c.push_str(")");
                  Option(String).Some(or_c)
                }
              )
            ),
          // `.ok()` — Result → Option: Ok(x) → Some(x), Err(_) → None. In bootstrap, identity.
          ((method_name == "ok") && (args.len() == usize(0))) =>
            Option(String).Some(recv_code),
          // `.err()` — Result → Option: Ok(_) → None, Err(e) → Some(e). In bootstrap, invert.
          // Ok=value (non-zero), Err=NULL (0). .err() → None if Ok (0), Some if Err (but Err=0 too).
          // Bootstrap simplification: emit 0 (always None since Err discards its value).
          ((method_name == "err") && (args.len() == usize(0))) =>
            Option(String).Some(String.from("0")),
          // Default: emit as C method call `recv.method(args)`
          true => match(
            gen_arg_list(args, ctx, indent),
            .None => Option(String).None,
            .Some(arg_s) => {
              result := String.new();
              result.push_string(recv_code);
              result.push_str(".");
              result.push_string(method_name);
              result.push_str("(");
              result.push_string(arg_s);
              result.push_str(")");
              .Some(result)
            }
          )
        )
      )
    )
  )
});
/// Generate a C compound literal for an anonymous struct initialiser `_(args…)`.
///
/// Three forms are recognised by inspecting the argument structure:
///   • Labeled  – all args are `field: val` (infix `:`)  → `(T){.field=val, …}`
///   • Shorthand – all args are bare identifier atoms      → `(T){.name=name, …}`
///   • Positional – everything else (literals / exprs)    → `(T){val, …}`
///
/// Returns `None` if any arg fails to generate.
gen_anon_struct_compound :: (
  fn(
    struct_args : ArrayList(AstExpr),
    type_name : String,
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  n := struct_args.len();
  // Classify: check if ALL args are labeled (infix `:`)
  all_labeled_f := {
    (al : bool) = (n > usize(0));
    (ali : usize) = usize(0);
    while((ali < n) && al, {
      match(
        struct_args.get(ali),
        .None => {
          al = false;
        },
        .Some(ae_l) => match(
          ae_l,
          .Atom(_, _) => {
            al = false;
          },
          .FnCall(_, ff_l, fa_l, finfix_l, _) => {
            is_colon_pair := (
              finfix_l && (
                match(
                  ff_l.*,
                  .Atom(_, ftok_l) => (ftok_l.value == ":"),
                  .FnCall(_, _, _, _, _) => false
                ) && (fa_l.len() == usize(2))
              )
            );
            if(!(is_colon_pair), {
              al = false;
            });
          }
        )
      );
      ali = (ali + usize(1));
    });
    al
  };
  // Check if ALL args are bare identifier atoms (shorthand form)
  all_bare_idents := {
    (ok_f : bool) = true;
    (ii : usize) = usize(0);
    while((ii < n) && ok_f, {
      match(
        struct_args.get(ii),
        .None => {
          ok_f = false;
        },
        .Some(ae) => match(
          ae,
          .FnCall(_, _, _, _, _) => {
            ok_f = false;
          },
          .Atom(_, atk) => {
            if(!(atk.kind == TokenKind.Identifier), {
              ok_f = false;
            });
          }
        )
      );
      ii = (ii + usize(1));
    });
    ok_f
  };
  result := String.from("(");
  result.push_string(type_name);
  result.push_str("){");
  (i2 : usize) = usize(0);
  (ok2 : bool) = true;
  while((i2 < n) && ok2, {
    match(
      struct_args.get(i2),
      .None => {
        ok2 = false;
      },
      .Some(arg_expr) => cond(
        // Labeled arg: `field: val` → `.field = val`
        all_labeled_f => match(
          arg_expr,
          .Atom(_, _) => {
            ok2 = false;
          },
          .FnCall(_, ff2, fa2, finfix2, _) => cond(
            (!(finfix2)) => {
              ok2 = false;
            },
            true => {
              fname_opt2 := match(
                fa2.get(usize(0)),
                .None => Option(String).None,
                .Some(fe2) => match(
                  fe2,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, fntok2) => Option(String).Some(fntok2.value)
                )
              );
              fval_opt2 := match(
                fa2.get(usize(1)),
                .None => Option(String).None,
                .Some(ve2) => aggregate_initializer_to_c(ve2, ctx, indent)
              );
              match(
                fname_opt2,
                .None => {
                  ok2 = false;
                },
                .Some(fn2) => match(
                  fval_opt2,
                  .None => {
                    ok2 = false;
                  },
                  .Some(fv2) => {
                    if(i2 > usize(0), {
                      result.push_str(", ");
                    });
                    result.push_str(".");
                    result.push_string(fn2);
                    result.push_str(" = ");
                    result.push_string(fv2);
                  }
                )
              );
            }
          )
        ),
        // Shorthand bare-ident arg: `x` → `.x = x`
        all_bare_idents => match(
          arg_expr,
          .FnCall(_, _, _, _, _) => {
            ok2 = false;
          },
          .Atom(_, atok2) => {
            if(i2 > usize(0), {
              result.push_str(", ");
            });
            result.push_str(".");
            result.push_string(atok2.value);
            result.push_str(" = ");
            result.push_string(atok2.value);
          }
        ),
        // Positional: emit value directly
        true => match(
          aggregate_initializer_to_c(arg_expr, ctx, indent),
          .None => {
            ok2 = false;
          },
          .Some(av2) => {
            if(i2 > usize(0), {
              result.push_str(", ");
            });
            result.push_string(av2);
          }
        )
      )
    );
    i2 = (i2 + usize(1));
  });
  cond(
    (!(ok2)) => Option(String).None,
    true => {
      result.push_str("}");
      Option(String).Some(result)
    }
  )
});
/// Handle `x = val` (bare assignment), `(x : T) = val` (typed declaration),
/// and compound LHS assignment like `c.*.field = val` or `arr.data = val`.
///
/// - Bare assignment: returns C expression `"x = val"`.
/// - Typed declaration: emits `"T_c x = val;\n"` and returns `"0"`.
/// - Compound LHS: returns C expression `"lhs_code = val"`.
handle_assignment :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  lhs_opt := args.get(usize(0));
  rhs_opt := args.get(usize(1));
  match(
    lhs_opt,
    .None => Option(String).None,
    .Some(lhs_expr) => match(
      rhs_opt,
      .None => Option(String).None,
      .Some(rhs_expr) => {
        // --- Special path: (arr : [T; N]) = [v0, v1, ...] ---
        // typed-decl with Array type + array literal RHS → emit `T arr[N] = {v0, v1, ...};`
        arr_typed_decl_opt := match(
          lhs_expr,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, lcolon_box, lcolon_args, lcolon_infix, _) => cond(
            (
              !(
                lcolon_infix && match(
                  lcolon_box.*,
                  .Atom(_, lctok) => ((lctok.kind == TokenKind.Operator) && (lctok.value == ":")),
                  .FnCall(_, _, _, _, _) => false
                )
              )
            ) => Option(String).None,
            true => match(
              lcolon_args.get(usize(0)),
              .None => Option(String).None,
              .Some(lname_e) => match(
                lname_e,
                .FnCall(_, _, _, _, _) => Option(String).None,
                .Atom(_, lname_tok) => cond(
                  (lname_tok.kind != TokenKind.Identifier) => Option(String).None,
                  true => match(
                    lcolon_args.get(usize(1)),
                    .None => Option(String).None,
                    .Some(lty_e) => match(
                      lty_e,
                      .Atom(_, _) => Option(String).None,
                      .FnCall(_, lty_fn, lty_args, lty_infix, _) => cond(
                        lty_infix => Option(String).None,
                        (lty_args.len() != usize(2)) => Option(String).None,
                        true => match(
                          lty_fn.*,
                          .FnCall(_, _, _, _, _) => Option(String).None,
                          .Atom(_, ltytok) => cond(
                            (ltytok.value != "Array") => Option(String).None,
                            true => {
                              // [T; N] or Array(T, N) → extract elem type and size
                              elem_c_opt := match(
                                lty_args.get(usize(0)),
                                .None => Option(String).None,
                                .Some(elem_e) => type_expr_to_c(elem_e)
                              );
                              size_str_opt := match(
                                lty_args.get(usize(1)),
                                .None => Option(String).None,
                                .Some(sz_e) => match(
                                  sz_e,
                                  .FnCall(_, _, _, _, _) => Option(String).None,
                                  .Atom(_, sz_tok) => cond(
                                    (sz_tok.kind == TokenKind.Integer) => Option(String).Some(sz_tok.value),
                                    (sz_tok.value == "_") => Option(String).None,
                                    true => Option(String).None
                                  )
                                )
                              );
                              match(
                                elem_c_opt,
                                .None => Option(String).None,
                                .Some(elem_c) => match(
                                  size_str_opt,
                                  .None => Option(String).None,
                                  .Some(size_str) => {
                                    // Now emit the array declaration
                                    san_arr_name := sanitize_c_ident(lname_tok.value.as_str());
                                    // RHS must be an array literal or generate as initializer
                                    rhs_init_opt := match(
                                      rhs_expr,
                                      .Atom(_, _) => call_gen_expr(rhs_expr, ctx, indent),
                                      .FnCall(_, rhs_arr_fn, rhs_arr_args, rhs_arr_infix, _) => cond(
                                        rhs_arr_infix => call_gen_expr(rhs_expr, ctx, indent),
                                        true => match(
                                          rhs_arr_fn.*,
                                          .FnCall(_, _, _, _, _) => call_gen_expr(rhs_expr, ctx, indent),
                                          .Atom(_, ratok) => cond(
                                            (ratok.value != "array") => call_gen_expr(rhs_expr, ctx, indent),
                                            true => {
                                              // Build `{v0, v1, ...}` initializer
                                              n_rv := rhs_arr_args.len();
                                              init_rv := String.from("{");
                                              (rvi : usize) = usize(0);
                                              (rv_ok : bool) = true;
                                              while((rvi < n_rv) && rv_ok, {
                                                match(
                                                  rhs_arr_args.get(rvi),
                                                  .None => {
                                                    rv_ok = false;
                                                  },
                                                  .Some(rv_e) => match(
                                                    call_gen_expr(rv_e, ctx, indent),
                                                    .None => {
                                                      rv_ok = false;
                                                    },
                                                    .Some(rv_c) => {
                                                      if(rvi > usize(0), {
                                                        init_rv.push_str(", ");
                                                      });
                                                      init_rv.push_string(rv_c);
                                                      rvi = (rvi + usize(1));
                                                    }
                                                  )
                                                );
                                              });
                                              cond(
                                                (!(rv_ok)) => Option(String).None,
                                                true => {
                                                  init_rv.push_str("}");
                                                  Option(String).Some(init_rv)
                                                }
                                              )
                                            }
                                          )
                                        )
                                      )
                                    );
                                    match(
                                      rhs_init_opt,
                                      .None => Option(String).None,
                                      .Some(rhs_init) => {
                                        ctx.emitter.emit_string(indent);
                                        ctx.emitter.emit_string(elem_c);
                                        ctx.emitter.emit(" ");
                                        ctx.emitter.emit_string(san_arr_name);
                                        ctx.emitter.emit("[");
                                        ctx.emitter.emit_string(size_str);
                                        ctx.emitter.emit("] = ");
                                        ctx.emitter.emit_string(rhs_init);
                                        ctx.emitter.emit_line(";");
                                        ctx.register_array_var_with_size(lname_tok.value.as_str(), size_str.as_str());
                                        Option(String).Some(String.from("0"))
                                      }
                                    )
                                  }
                                )
                              )
                            }
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        );
        // Detect: RHS is a non-empty anonymous struct init `_(args…)`.
        // When combined with a typed-decl LHS `(x : T) = _(…)`, we need the LHS
        // type to generate the C compound literal `(T){…}`.  We must handle this
        // *before* calling call_gen_expr(rhs_expr) because `_()` with args returns None.
        rhs_is_anon_struct := match(
          rhs_expr,
          .Atom(_, _) => false,
          .FnCall(_, rhs_fn_box, rhs_fn_args, rhs_fn_infix, _) => (
            (!(rhs_fn_infix)) &&
              (rhs_fn_args.len() > usize(0)) &&
                match(
                  rhs_fn_box.*,
                  .FnCall(_, _, _, _, _) => false,
                  .Atom(_, rfntok) => (rfntok.value == BK_ANON_STRUCT)
                )
          )
        );
        typed_anon_struct_decl_opt := match(
          lhs_expr,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, colon_box_a, colon_args_a, colon_infix_a, _) => cond(
            (
              !(
                colon_infix_a && match(
                  colon_box_a.*,
                  .Atom(_, ctoka) => ((ctoka.kind == TokenKind.Operator) && (ctoka.value == ":")),
                  .FnCall(_, _, _, _, _) => false
                )
              )
            ) => Option(String).None,
            true => {
              name_opt_a := match(
                colon_args_a.get(usize(0)),
                .None => Option(String).None,
                .Some(ne_a) => match(
                  ne_a,
                  .Atom(_, ntoka) => Option(String).Some(ntoka.value),
                  .FnCall(_, _, _, _, _) => Option(String).None
                )
              );
              ty_args_opt_a := match(
                colon_args_a.get(usize(1)),
                .None => Option(ArrayList(AstExpr)).None,
                .Some(te_a) => match(
                  te_a,
                  .Atom(_, _) => Option(ArrayList(AstExpr)).None,
                  .FnCall(_, ty_fn_a, ty_args_a, ty_infix_a, _) => cond(
                    ty_infix_a => Option(ArrayList(AstExpr)).None,
                    true => match(
                      ty_fn_a.*,
                      .FnCall(_, _, _, _, _) => Option(ArrayList(AstExpr)).None,
                      .Atom(_, ty_tok_a) => cond(
                        (ty_tok_a.value == "struct") => Option(ArrayList(AstExpr)).Some(ty_args_a),
                        true => Option(ArrayList(AstExpr)).None
                      )
                    )
                  )
                )
              );
              rhs_args_opt_a := match(
                rhs_expr,
                .Atom(_, _) => Option(ArrayList(AstExpr)).None,
                .FnCall(_, rhs_fn_a, rhs_args_a, rhs_infix_a, _) => cond(
                  rhs_infix_a => Option(ArrayList(AstExpr)).None,
                  true => match(
                    rhs_fn_a.*,
                    .FnCall(_, _, _, _, _) => Option(ArrayList(AstExpr)).None,
                    .Atom(_, rhs_tok_a) => cond(
                      (rhs_tok_a.value == BK_ANON_STRUCT) => Option(ArrayList(AstExpr)).Some(rhs_args_a),
                      true => Option(ArrayList(AstExpr)).None
                    )
                  )
                )
              );
              match(
                name_opt_a,
                .None => Option(String).None,
                .Some(var_name_a) => match(
                  ty_args_opt_a,
                  .None => Option(String).None,
                  .Some(type_args_a) => match(
                    rhs_args_opt_a,
                    .None => Option(String).None,
                    .Some(value_args_a) => match(
                      anon_struct_type_to_c(type_args_a),
                      .None => Option(String).None,
                      .Some(anon_ty_a) => match(
                        anon_struct_initializer_to_c(value_args_a, ctx, indent),
                        .None => Option(String).None,
                        .Some(init_a) => {
                          ctx.emitter.emit_string(indent);
                          ctx.emitter.emit_string(anon_ty_a);
                          ctx.emitter.emit(" ");
                          ctx.emitter.emit_string(sanitize_c_ident(var_name_a.as_str()));
                          ctx.emitter.emit(" = ");
                          ctx.emitter.emit_string(init_a);
                          ctx.emitter.emit_line(";");
                          Option(String).Some(String.from("0"))
                        }
                      )
                    )
                  )
                )
              )
            }
          )
        );
        typed_tuple_decl_opt := match(
          rhs_expr,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, tuple_rhs_fn, _, tuple_rhs_infix, _) => cond(
            tuple_rhs_infix => Option(String).None,
            true => match(
              tuple_rhs_fn.*,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, tuple_rhs_tok) => cond(
                (tuple_rhs_tok.value != BK_TUPLE) => Option(String).None,
                true => match(
                  lhs_expr,
                  .Atom(_, _) => Option(String).None,
                  .FnCall(_, colon_box_t, colon_args_t, colon_infix_t, _) => cond(
                    (
                      !(
                        colon_infix_t && match(
                          colon_box_t.*,
                          .Atom(_, ctokt) => ((ctokt.kind == TokenKind.Operator) && (ctokt.value == ":")),
                          .FnCall(_, _, _, _, _) => false
                        )
                      )
                    ) => Option(String).None,
                    true => {
                      name_opt_t := match(
                        colon_args_t.get(usize(0)),
                        .None => Option(String).None,
                        .Some(ne_t) => match(
                          ne_t,
                          .Atom(_, ntokt) => Option(String).Some(ntokt.value),
                          .FnCall(_, _, _, _, _) => Option(String).None
                        )
                      );
                      ty_opt_t := match(
                        colon_args_t.get(usize(1)),
                        .None => Option(String).None,
                        .Some(te_t) => type_expr_to_c(te_t)
                      );
                      init_opt_t := aggregate_initializer_to_c(rhs_expr, ctx, indent);
                      match(
                        name_opt_t,
                        .None => Option(String).None,
                        .Some(var_name_t) => match(
                          ty_opt_t,
                          .None => Option(String).None,
                          .Some(c_ty_t) => match(
                            init_opt_t,
                            .None => Option(String).None,
                            .Some(init_t) => {
                              ctx.emitter.emit_string(indent);
                              ctx.emitter.emit_string(build_typed_decl(c_ty_t.as_str(), sanitize_c_ident(var_name_t.as_str()).as_str()));
                              ctx.emitter.emit(" = ");
                              ctx.emitter.emit_string(init_t);
                              ctx.emitter.emit_line(";");
                              Option(String).Some(String.from("0"))
                            }
                          )
                        )
                      )
                    }
                  )
                )
              )
            )
          )
        );
        typed_closure_decl_opt := match(
          lhs_expr,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, closure_colon_box, closure_colon_args, closure_colon_infix, _) => cond(
            !(
              closure_colon_infix && match(
                closure_colon_box.*,
                .Atom(_, closure_colon_tok) =>
                  ((closure_colon_tok.kind == TokenKind.Operator) && (closure_colon_tok.value == ":")),
                .FnCall(_, _, _, _, _) => false
              )
            ) => Option(String).None,
            true => match(
              closure_colon_args.get(usize(0)),
              .None => Option(String).None,
              .Some(closure_name_expr) => match(
                closure_name_expr,
                .FnCall(_, _, _, _, _) => Option(String).None,
                .Atom(_, closure_name_tok) => match(
                  closure_colon_args.get(usize(1)),
                  .None => Option(String).None,
                  .Some(closure_type_expr) => {
                    closure_param_opt := match(
                      closure_param_name_from_impl_fn(closure_type_expr),
                      .Some(param_name) => Option(String).Some(param_name),
                      .None => match(
                        closure_type_expr,
                        .FnCall(_, _, _, _, _) => Option(String).None,
                        .Atom(_, closure_type_tok) => ctx.get_closure_alias_param_name(closure_type_tok.value.as_str())
                      )
                    );
                    match(
                      closure_param_opt,
                      .None => Option(String).None,
                      .Some(closure_param_name) => {
                        closure_body_opt := match(
                          lambda_body_expr(rhs_expr),
                          .Some(body_expr) => Option(AstExpr).Some(body_expr),
                          .None => dyn_lambda_body_expr(rhs_expr)
                        );
                        closure_env_is_ptr := match(
                          closure_type_expr,
                          .FnCall(_, closure_type_fn_box, _, closure_type_infix, _) => cond(
                            closure_type_infix => false,
                            true => match(
                              closure_type_fn_box.*,
                              .FnCall(_, _, _, _, _) => false,
                              .Atom(_, closure_type_name_tok) => (closure_type_name_tok.value == "Dyn")
                            )
                          ),
                          .Atom(_, _) => false
                        );
                        match(
                          closure_body_opt,
                          .None => Option(String).None,
                          .Some(closure_body_expr) => cond(
                            emit_simple_closure_value(
                              closure_name_tok.value.as_str(),
                              closure_body_expr,
                              closure_param_name.as_str(),
                              ctx,
                              indent,
                              closure_env_is_ptr
                            ) => Option(String).Some(String.from("0")),
                            true => Option(String).None
                          )
                        )
                      }
                    )
                  }
                )
              )
            )
          )
        );
        cond(
          // --- Special path: (arr : [T; N]) = [v0, v1, ...] ---
          match(arr_typed_decl_opt,.Some(_) => true,.None => false) => arr_typed_decl_opt,
          // --- Special path: (p : struct(...)) = _(...) ---
          match(typed_anon_struct_decl_opt,.Some(_) => true,.None => false) => typed_anon_struct_decl_opt,
          // --- Special path: (p : TupleAlias) = (v0, v1, ...) ---
          match(typed_tuple_decl_opt,.Some(_) => true,.None => false) => typed_tuple_decl_opt,
          // --- Special path: (closure : Impl(Fn(...))) = ((x) => { ... }) ---
          match(typed_closure_decl_opt,.Some(_) => true,.None => false) => typed_closure_decl_opt,
          // --- Special path: arr = [v0, v1, ...] for known array var (element-by-element) ---
          match(
            lhs_expr,
            .Atom(_, lna_tok) => ctx.is_array_var(lna_tok.value.as_str()),
            .FnCall(_, _, _, _, _) => false
          ) =>
            match(
              lhs_expr,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, lna_tok) => match(
                rhs_expr,
                .Atom(_, _) => Option(String).None,
                .FnCall(_, ala_fn, ala_args, ala_infix, _) => cond(
                  ala_infix => Option(String).None,
                  true => match(
                    ala_fn.*,
                    .FnCall(_, _, _, _, _) => Option(String).None,
                    .Atom(_, ala_tok) => cond(
                      (ala_tok.value != "array") => Option(String).None,
                      true => {
                        san_arr := sanitize_c_ident(lna_tok.value.as_str());
                        n_ala := ala_args.len();
                        (ala_i : usize) = usize(0);
                        (ala_ok : bool) = true;
                        while((ala_i < n_ala) && ala_ok, {
                          match(
                            ala_args.get(ala_i),
                            .None => {
                              ala_ok = false;
                            },
                            .Some(ala_e) => match(
                              call_gen_expr(ala_e, ctx, indent),
                              .None => {
                                ala_ok = false;
                              },
                              .Some(ala_c) => {
                                ctx.emitter.emit_string(indent);
                                ctx.emitter.emit_string(san_arr);
                                ctx.emitter.emit("[");
                                ctx.emitter.emit_string(ala_i.to_string());
                                ctx.emitter.emit("] = ");
                                ctx.emitter.emit_string(ala_c);
                                ctx.emitter.emit_line(";");
                                ala_i = (ala_i + usize(1));
                              }
                            )
                          );
                        });
                        cond(
                          (!(ala_ok)) => Option(String).None,
                          true => Option(String).Some(String.from("0"))
                        )
                      }
                    )
                  )
                )
              )
            ),
          // --- Special path: typed-decl + anon-struct RHS ---
          rhs_is_anon_struct => match(
            lhs_expr,
            // Not a typed decl (just an atom LHS) — skip to general path
            .Atom(_, _) => Option(String).None,
            .FnCall(_, colon_box_a, colon_args_a, colon_infix_a, _) => cond(
              // Not a colon-typed-decl — fall through
              (
                !(
                  colon_infix_a && match(
                    colon_box_a.*,
                    .Atom(_, ctoka) => ((ctoka.kind == TokenKind.Operator) && (ctoka.value == ":")),
                    .FnCall(_, _, _, _, _) => false
                  )
                )
              ) => Option(String).None,
              true => {
                // Extract var name
                name_opt_a := match(
                  colon_args_a.get(usize(0)),
                  .None => Option(String).None,
                  .Some(ne_a) => match(
                    ne_a,
                    .Atom(_, ntoka) => Option(String).Some(ntoka.value),
                    .FnCall(_, _, _, _, _) => Option(String).None
                  )
                );
                // Extract C type name
                ty_opt_a := match(
                  colon_args_a.get(usize(1)),
                  .None => Option(String).None,
                  .Some(te_a) => type_expr_to_c(te_a)
                );
                match(
                  name_opt_a,
                  .None => Option(String).None,
                  .Some(var_name_a) => match(
                    ty_opt_a,
                    .None => Option(String).None,
                    .Some(c_ty_a) => cond(
                      (c_ty_a == "Type") => Option(String).None,
                      true => {
                        // Extract the anon-struct args
                        struct_args_opt := match(
                          rhs_expr,
                          .Atom(_, _) => Option(ArrayList(AstExpr)).None,
                          .FnCall(_, _, san_args, _, _) => Option(ArrayList(AstExpr)).Some(san_args)
                        );
                        match(
                          struct_args_opt,
                          .None => Option(String).None,
                          .Some(san_args2) => match(
                            gen_anon_struct_compound(san_args2, c_ty_a, ctx, indent),
                            .None => Option(String).None,
                            .Some(rhs_code_a) => {
                              ctx.emitter.emit_string(indent);
                              ctx.emitter.emit_string(c_ty_a);
                              ctx.emitter.emit(" ");
                              ctx.emitter.emit_string(sanitize_c_ident(var_name_a.as_str()));
                              ctx.emitter.emit(" = ");
                              ctx.emitter.emit_string(rhs_code_a);
                              ctx.emitter.emit_line(";");
                              Option(String).Some(String.from("0"))
                            }
                          )
                        )
                      }
                    )
                  )
                )
              }
            )
          ),
          // --- General path: compute RHS first, then handle LHS ---
          true => match(
            call_gen_expr(rhs_expr, ctx, indent),
            .None => Option(String).None,
            .Some(rhs_code) => match(
              lhs_expr,
              // Bare atom: x = val — C assignment expression
              .Atom(_, name_tok) => {
                result := String.new();
                result.push_string(sanitize_c_ident(name_tok.value.as_str()));
                result.push_str(" = ");
                result.push_string(rhs_code);
                Option(String).Some(result)
              },
              // FnCall LHS: either (x : T) = val  OR  compound expr like c.*.field = val
              .FnCall(_, colon_box, colon_args, colon_infix, _) => cond(
                // Check if it's a typed declaration: (x : T) = val
                (
                  colon_infix && match(
                    colon_box.*,
                    .Atom(_, ctok) => ((ctok.kind == TokenKind.Operator) && (ctok.value == ":")),
                    .FnCall(_, _, _, _, _) => false
                  )
                ) => {
                  name_opt := match(
                    colon_args.get(usize(0)),
                    .None => Option(String).None,
                    .Some(ne) => match(
                      ne,
                      .Atom(_, ntok) => Option(String).Some(ntok.value),
                      // comptime(x) : T — extract name from comptime(name) pattern
                      .FnCall(_, cf_box3, cf_args3, cf_infix3, _) => cond(
                        cf_infix3 => Option(String).None,
                        (!(cf_args3.len() == usize(1))) => Option(String).None,
                        true => match(
                          cf_box3.*,
                          .FnCall(_, _, _, _, _) => Option(String).None,
                          .Atom(_, cftok3) => cond(
                            (!(cftok3.value == "comptime")) => Option(String).None,
                            true => match(
                              cf_args3.get(usize(0)),
                              .None => Option(String).None,
                              .Some(inner3) => match(
                                inner3,
                                .FnCall(_, _, _, _, _) => Option(String).None,
                                .Atom(_, itok3) => cond(
                                  (itok3.kind == TokenKind.Identifier) => Option(String).Some(itok3.value),
                                  true => Option(String).None
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  );
                  // Track whether the LHS name came from `comptime(name)` pattern.
                  // Comptime type aliases like `(comptime(T) : Type) = i32` must not
                  // generate any C code (they are purely compile-time constructs).
                  name_is_comptime := match(
                    colon_args.get(usize(0)),
                    .None => false,
                    .Some(ne_c) => match(
                      ne_c,
                      .Atom(_, _) => false,
                      .FnCall(_, cf_box_c, _, cf_infix_c, _) => (
                        (!(cf_infix_c)) &&
                          match(
                            cf_box_c.*,
                            .FnCall(_, _, _, _, _) => false,
                            .Atom(_, tok_c) => (tok_c.value == "comptime")
                          )
                      )
                    )
                  );
                  ty_opt := match(
                    colon_args.get(usize(1)),
                    .None => Option(String).None,
                    .Some(te) => match(
                      te,
                      .Atom(_, _) => type_expr_to_c(te),
                      .FnCall(_, tuple_ty_fn, _, tuple_ty_infix, _) => cond(
                        tuple_ty_infix => type_expr_to_c(te),
                        true => match(
                          tuple_ty_fn.*,
                          .FnCall(_, _, _, _, _) => type_expr_to_c(te),
                          .Atom(_, tuple_ty_tok) => cond(
                            (tuple_ty_tok.value == "Tuple") => Option(String).None,
                            true => type_expr_to_c(te)
                          )
                        )
                      )
                    )
                  );
                  // When `name_is_comptime = true`, skip declarations whose type has no C
                  // representation (not a primitive, not a registered struct or enum).
                  // This avoids emitting invalid C like `Pair x = ...` when `Pair` is a
                  // compile-time-only Yo tuple alias without a C typedef.
                  // Declarations like `(comptime(x) : bool) = true` still emit normally.
                  comptime_type_has_no_c_repr := (
                    name_is_comptime && match(
                      colon_args.get(usize(1)),
                      .None => false,
                      .Some(te_chk) => match(
                        te_chk,
                        .FnCall(_, _, _, _, _) => true,
                        .Atom(_, ty_atom_chk) => {
                          yn := ty_atom_chk.value.as_str();
                          !(
                            is_c_type_name(yn) ||
                              ctx.is_struct_name(yn) ||
                                ctx.is_enum_name(yn)
                          )
                        }
                      )
                    )
                  );
                  match(
                    name_opt,
                    .None => Option(String).None,
                    .Some(var_name) => match(
                      ty_opt,
                      // No C type available — check for named tuple, else __auto_type fallback.
                      // Skip comptime patterns: `(comptime(T) : Type) = SomeType`.
                      .None => cond(
                        name_is_comptime => Option(String).None,
                        (var_name.len() == usize(0)) => Option(String).None,
                        true => {
                          // Named tuple: `(t2 : Tuple(a:T, b:T2, c:T3)) = rhs`
                          // Emit a double-field struct `struct { T _0; T2 _1; ... T a; T2 b; ... }`
                          // so both index (._N) and label (.name) access work.
                          named_tuple_opt := match(
                            colon_args.get(usize(1)),
                            .None => Option(String).None,
                            .Some(nt_type_e) => match(
                              nt_type_e,
                              .Atom(_, _) => Option(String).None,
                              .FnCall(_, nt_fb, nt_fa, nt_fi, _) => cond(
                                nt_fi => Option(String).None,
                                (nt_fa.len() < usize(2)) => Option(String).None,
                                true => match(
                                  nt_fb.*,
                                  .FnCall(_, _, _, _, _) => Option(String).None,
                                  .Atom(_, nt_tok) => cond(
                                    (nt_tok.value != "Tuple") => Option(String).None,
                                    true => {
                                      n_nt := nt_fa.len();
                                      (nt_ok : bool) = true;
                                      (nt_fnames : ArrayList(String)) = ArrayList(String).new();
                                      (nt_fctypes : ArrayList(String)) = ArrayList(String).new();
                                      (nti : usize) = usize(0);
                                      while((nti < n_nt) && nt_ok, {
                                        match(
                                          nt_fa.get(nti),
                                          .None => {
                                            nt_ok = false;
                                          },
                                          .Some(nt_arg) => match(
                                            nt_arg,
                                            .Atom(_, _) => {
                                              nt_ok = false;
                                            },
                                            .FnCall(_, nt_af, nt_aa, nt_ai, _) => cond(
                                              (!(nt_ai)) => {
                                                nt_ok = false;
                                              },
                                              (nt_aa.len() != usize(2)) => {
                                                nt_ok = false;
                                              },
                                              true => match(
                                                nt_af.*,
                                                .FnCall(_, _, _, _, _) => {
                                                  nt_ok = false;
                                                },
                                                .Atom(_, nt_at) => cond(
                                                  (nt_at.value != ":") => {
                                                    nt_ok = false;
                                                  },
                                                  true => match(
                                                    nt_aa.get(usize(0)),
                                                    .None => {
                                                      nt_ok = false;
                                                    },
                                                    .Some(fn_e) => match(
                                                      fn_e,
                                                      .FnCall(_, _, _, _, _) => {
                                                        nt_ok = false;
                                                      },
                                                      .Atom(_, fn_tok) => match(
                                                        nt_aa.get(usize(1)),
                                                        .None => {
                                                          nt_ok = false;
                                                        },
                                                        .Some(ft_e) => match(
                                                          type_expr_to_c(ft_e),
                                                          .None => {
                                                            nt_ok = false;
                                                          },
                                                          .Some(fct) => {
                                                            nt_fnames.push(fn_tok.value);
                                                            nt_fctypes.push(fct);
                                                          }
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        );
                                        nti = (nti + usize(1));
                                      });
                                      cond(
                                        (!(nt_ok)) => Option(String).None,
                                        true => {
                                          // Temp var to hold RHS without re-evaluation.
                                          nt_tmp := ctx.fresh_temp();
                                          ctx.emitter.emit_string(indent);
                                          ctx.emitter.emit("__auto_type ");
                                          ctx.emitter.emit_string(nt_tmp);
                                          ctx.emitter.emit(" = ");
                                          ctx.emitter.emit_string(rhs_code);
                                          ctx.emitter.emit_line(";");
                                          // struct { T _0; T2 _1; ... T a; T2 b; ... } name = { ... };
                                          ctx.emitter.emit_string(indent);
                                          ctx.emitter.emit("struct { ");
                                          (pi : usize) = usize(0);
                                          while(pi < n_nt, {
                                            match(
                                              nt_fctypes.get(pi),
                                              .None => (),
                                              .Some(pct) => {
                                                ctx.emitter.emit_string(pct);
                                                ctx.emitter.emit(" _");
                                                ctx.emitter.emit_string(pi.to_string());
                                                ctx.emitter.emit("; ");
                                              }
                                            );
                                            pi = (pi + usize(1));
                                          });
                                          (ni2 : usize) = usize(0);
                                          while(ni2 < n_nt, {
                                            match(
                                              nt_fctypes.get(ni2),
                                              .None => (),
                                              .Some(nct) => match(
                                                nt_fnames.get(ni2),
                                                .None => (),
                                                .Some(nfn) => {
                                                  ctx.emitter.emit_string(nct);
                                                  ctx.emitter.emit(" ");
                                                  ctx.emitter.emit_string(nfn);
                                                  ctx.emitter.emit("; ");
                                                }
                                              )
                                            );
                                            ni2 = (ni2 + usize(1));
                                          });
                                          ctx.emitter.emit("} ");
                                          ctx.emitter.emit_string(var_name);
                                          ctx.emitter.emit(" = {");
                                          // ._0 = tmp._0, ._1 = tmp._1, ...
                                          (ii : usize) = usize(0);
                                          while(ii < n_nt, {
                                            if(ii > usize(0), {
                                              ctx.emitter.emit(", ");
                                            });
                                            ctx.emitter.emit("._");
                                            ctx.emitter.emit_string(ii.to_string());
                                            ctx.emitter.emit(" = ");
                                            ctx.emitter.emit_string(nt_tmp);
                                            ctx.emitter.emit("._");
                                            ctx.emitter.emit_string(ii.to_string());
                                            ii = (ii + usize(1));
                                          });
                                          // .a = tmp._0, .b = tmp._1, ...
                                          (ii2 : usize) = usize(0);
                                          while(ii2 < n_nt, {
                                            ctx.emitter.emit(", .");
                                            match(
                                              nt_fnames.get(ii2),
                                              .None => (),
                                              .Some(nfn2) => ctx.emitter.emit_string(nfn2)
                                            );
                                            ctx.emitter.emit(" = ");
                                            ctx.emitter.emit_string(nt_tmp);
                                            ctx.emitter.emit("._");
                                            ctx.emitter.emit_string(ii2.to_string());
                                            ii2 = (ii2 + usize(1));
                                          });
                                          ctx.emitter.emit_line("};");
                                          Option(String).Some(String.from("0"))
                                        }
                                      )
                                    }
                                  )
                                )
                              )
                            )
                          );
                          match(
                            named_tuple_opt,
                            .Some(_) => named_tuple_opt,
                            .None => {
                              ctx.emitter.emit_string(indent);
                              ctx.emitter.emit("__auto_type ");
                              ctx.emitter.emit_string(sanitize_c_ident(var_name.as_str()));
                              ctx.emitter.emit(" = ");
                              ctx.emitter.emit_string(rhs_code);
                              ctx.emitter.emit_line(";");
                              Option(String).Some(String.from("0"))
                            }
                          )
                        }
                      ),
                      .Some(c_ty) => cond(
                        // Skip: `(comptime(T) : Type) = SomeType` — Type is a meta-type.
                        // Skip: `(comptime(x) : PureYoType) = val` — type has no C representation.
                        (comptime_type_has_no_c_repr || (c_ty == "Type")) => Option(String).None,
                        true => {
                          // Emit: indent + "c_ty name" + " = " + rhs + ";"
                          san_cty_name := sanitize_c_ident(var_name.as_str());
                          decl_cty := build_typed_decl(c_ty.as_str(), san_cty_name.as_str());
                          ctx.emitter.emit_string(indent);
                          ctx.emitter.emit_string(decl_cty);
                          ctx.emitter.emit(" = ");
                          ctx.emitter.emit_string(rhs_code);
                          ctx.emitter.emit_line(";");
                          ctx.register_var_type(var_name.as_str(), c_ty.as_str());
                          // If the type annotation is Option(T) or Result(T, E) with a numeric inner T,
                          // register the variable as T instead of void* so .map() closure params
                          // can infer the correct numeric type for to_string() and arithmetic.
                          //
                          // Only applies to Option/Result (the void-pointer payload encoding).
                          // ArrayList(T), Deque(T), HashMap(K,V), etc. keep their concrete C
                          // type so subsequent method dispatch (e.g. .push, .len) routes to
                          // the proper helper.
                          match(
                            colon_args.get(usize(1)),
                            .None => (),
                            .Some(inner_type_e) => cond(
                              type_app_receiver_is(inner_type_e, "Option") => match(
                                generic_type_app_field_c_type(inner_type_e),
                                .None => (),
                                .Some(inner_c_ty) => if(is_numeric_c_type(inner_c_ty.as_str()), {
                                  ctx.register_var_type(var_name.as_str(), inner_c_ty.as_str());
                                })
                              ),
                              type_app_receiver_is(inner_type_e, "Result") => match(
                                generic_type_app_field_c_type(inner_type_e),
                                .None => (),
                                .Some(inner_c_ty) => if(is_numeric_c_type(inner_c_ty.as_str()), {
                                  ctx.register_var_type(var_name.as_str(), inner_c_ty.as_str());
                                })
                              ),
                              true => ()
                            )
                          );
                          .Some(String.from("0"))
                        }
                      )
                    )
                  )
                },
                // Comptime field mutation: `const_var.field = val` or `const_var.0 = val`
                // where `const_var` was declared with `::`.
                // Skip (no-op): `::` bindings are comptime constants; any mutations to their
                // fields are comptime-only and all dependent asserts are `comptime_assert` (no-ops).
                should_skip_comptime_field_assignment(ctx, lhs_expr) => Option(String).Some(String.from("0")),
                // Compound LHS: e.g. c.*.field = val, arr.data = val
                // Guard: if LHS is an unsupported non-infix Index trait assignment,
                // emit a no-op. This keeps comptime-only mutations like `p(0) = val`
                // out of generated C, while allowing runtime struct/ArrayList Index
                // assignments that this bootstrapper can lower to real lvalues.
                should_skip_unsupported_index_assignment(ctx, lhs_expr) => Option(String).Some(String.from("0")),
                // Compound LHS: e.g. c.*.field = val, arr.data = val
                // Generate the LHS as an expression and return "lhs = rhs"
                true => match(
                  call_gen_expr(lhs_expr, ctx, indent),
                  .None => Option(String).None,
                  .Some(lhs_code) => {
                    result := String.new();
                    result.push_string(lhs_code);
                    result.push_str(" = ");
                    result.push_string(rhs_code);
                    Option(String).Some(result)
                  }
                )
              )
            )
          )
        )
      }
    )
  )
});
// ---------------------------------------------------------------------------
// Core entry point
// ---------------------------------------------------------------------------
/// Handle `assert(cond, msg)` — emit a test assertion as a C if-check.
///
/// Generates: `if (!(cond)) { exit(1); }` into the code buffer.
/// Returns `"0"` (the unit sentinel).
/// The `msg` argument (second arg) is evaluated but discarded for Phase 5b.
handle_assert :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)(
  match(
    args.get(usize(0)),
    .None => Option(String).None,
    .Some(cond_expr) => match(
      call_gen_expr(cond_expr, ctx, indent),
      .None => Option(String).None,
      .Some(cond_code) => {
        ctx.emitter.emit_string(indent);
        ctx.emitter.emit("if (!(");
        ctx.emitter.emit_string(cond_code);
        ctx.emitter.emit_line(")) { exit(1); }");
        .Some(String.from("0"))
      }
    )
  )
);
/// Handle `println(value)` for bootstrap tests by printing string-like values.
handle_println :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)(
  match(
    args.get(usize(0)),
    .None => Option(String).None,
    .Some(value_expr) => match(
      call_gen_expr(value_expr, ctx, indent),
      .None => Option(String).None,
      .Some(value_code) => {
        // Wrap non-string values with a to-string helper so printf("%s\n", ...) is safe.
        print_arg := cond(
          (value_code.starts_with(String.from("\"")) || (value_code.contains(String.from("__yo_")) || match(ctx.get_var_type(value_code.as_str()),.None => false,.Some(pln_vty) => (pln_vty == "const char*")))) =>
            value_code,
          true => match(
            value_expr,
            .Atom(_, pln_atom_tok) => cond(
              (pln_atom_tok.kind == TokenKind.Integer) => {
                pln_wi := String.from("__yo_int_to_str(");
                pln_wi.push_string(value_code);
                pln_wi.push_str(")");
                pln_wi
              },
              (pln_atom_tok.kind == TokenKind.Float) => {
                pln_wf := String.from("__yo_float_to_str(");
                pln_wf.push_string(value_code);
                pln_wf.push_str(")");
                pln_wf
              },
              ((pln_atom_tok.value == "true") || (pln_atom_tok.value == "false")) => {
                pln_wb := String.from("__yo_bool_to_str(");
                pln_wb.push_string(value_code);
                pln_wb.push_str(")");
                pln_wb
              },
              true => match(
                ctx.get_var_type(value_code.as_str()),
                .None => value_code,
                .Some(pln_ty) => cond(
                  ((pln_ty == "int64_t") || ((pln_ty == "int32_t") || ((pln_ty == "int16_t") || ((pln_ty == "int8_t") || (pln_ty == "isize"))))) => {
                    pln_ti := String.from("__yo_int_to_str((int64_t)(");
                    pln_ti.push_string(value_code);
                    pln_ti.push_str("))");
                    pln_ti
                  },
                  ((pln_ty == "size_t") || ((pln_ty == "uint64_t") || ((pln_ty == "uint32_t") || ((pln_ty == "uint16_t") || (pln_ty == "uint8_t"))))) => {
                    pln_tu := String.from("__yo_uint_to_str((uint64_t)(");
                    pln_tu.push_string(value_code);
                    pln_tu.push_str("))");
                    pln_tu
                  },
                  ((pln_ty == "double") || (pln_ty == "float")) => {
                    pln_tf := String.from("__yo_float_to_str((double)(");
                    pln_tf.push_string(value_code);
                    pln_tf.push_str("))");
                    pln_tf
                  },
                  (pln_ty == "bool") => {
                    pln_tbl := String.from("__yo_bool_to_str(");
                    pln_tbl.push_string(value_code);
                    pln_tbl.push_str(")");
                    pln_tbl
                  },
                  true => value_code
                )
              )
            ),
            .FnCall(_, pln_fn_b, pln_fn_args_b, pln_infix_b, _) => cond(
              (!(pln_infix_b) && (pln_fn_args_b.len() == usize(1))) => match(
                pln_fn_b.*,
                .FnCall(_, _, _, _, _) => value_code,
                .Atom(_, pln_cast_tok) => cond(
                  ((pln_cast_tok.value == "i8") || ((pln_cast_tok.value == "i16") || ((pln_cast_tok.value == "i32") || ((pln_cast_tok.value == "i64") || (pln_cast_tok.value == "isize"))))) => {
                    pln_ci := String.from("__yo_int_to_str((int64_t)(");
                    pln_ci.push_string(value_code);
                    pln_ci.push_str("))");
                    pln_ci
                  },
                  ((pln_cast_tok.value == "u8") || ((pln_cast_tok.value == "u16") || ((pln_cast_tok.value == "u32") || ((pln_cast_tok.value == "u64") || (pln_cast_tok.value == "usize"))))) => {
                    pln_cu := String.from("__yo_uint_to_str((uint64_t)(");
                    pln_cu.push_string(value_code);
                    pln_cu.push_str("))");
                    pln_cu
                  },
                  ((pln_cast_tok.value == "f32") || (pln_cast_tok.value == "f64")) => {
                    pln_cf := String.from("__yo_float_to_str((double)(");
                    pln_cf.push_string(value_code);
                    pln_cf.push_str("))");
                    pln_cf
                  },
                  true => value_code
                )
              ),
              true => value_code
            )
          )
        );
        ctx.emitter.emit_string(indent);
        ctx.emitter.emit("printf(\"%s\\n\", ");
        ctx.emitter.emit_string(print_arg);
        ctx.emitter.emit_line(");");
        .Some(String.from("0"))
      }
    )
  )
);
/// True if `expr` is a labeled argument: `FnCall(Atom(":"), [name, val], true)`.
is_labeled_arg :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, ff, fa, finfix, _) => (
      finfix && (
        match(
          ff.*,
          .Atom(_, ftok) => (ftok.value == ":"),
          .FnCall(_, _, _, _, _) => false
        ) && (fa.len() == usize(2))
      )
    )
  )
);
/// True if all elements of `args` are labeled (`field: val`) args AND args is non-empty.
all_labeled_args :: (fn(args : ArrayList(AstExpr)) -> bool)({
  n := args.len();
  cond(
    (n == usize(0)) => false,
    true => {
      (all : bool) = true;
      (i : usize) = usize(0);
      while((i < n) && all, {
        match(
          args.get(i),
          .None => {
            all = false;
          },
          .Some(e) => {
            if(!(is_labeled_arg(e)), {
              all = false;
            });
          }
        );
        i = (i + usize(1));
      });
      all
    }
  )
});
/// True if `s` starts with an uppercase ASCII letter (A–Z).
/// Used to distinguish struct type names from lowercase function names.
is_uppercase_start :: (fn(s : String) -> bool)(
  match(
    s.at(usize(0)),
    .None => false,
    .Some(r) => ((r.char >= u32(65)) && (r.char <= u32(90)))
  )
);
/// Handle a non-empty tuple literal `(a, b, …)`.
///
/// Generates a C anonymous-struct compound literal using `__typeof__` so we
/// don't need to know the concrete type at this phase:
///
///   `(struct { __typeof__(a) _0; __typeof__(b) _1; }){._0 = a, ._1 = b}`
///
/// Field names use the `_N` (underscore-prefix) convention that matches the
/// full Yo code-gen output (tuple fields are `_0`, `_1`, …).
// Phase A.8.4: `handle_tuple_literal` was relocated to `./exprs/tuple_fn.yo`.
/// → `(TypeName){.field1 = val1, .field2 = val2}`.
///
/// All args must be labeled (`:` infix). The type name must start with an
/// uppercase letter (Yo convention for types).
handle_struct_constructor :: (
  fn(
    type_name : String,
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  result := String.from("(");
  result.push_string(type_name);
  result.push_str("){");
  n := args.len();
  (i : usize) = usize(0);
  (all_ok : bool) = true;
  (first : bool) = true;
  provided_fields := ArrayList(String).new();
  while((i < n) && all_ok, {
    match(
      args.get(i),
      .None => {
        all_ok = false;
      },
      .Some(field_expr) => match(
        field_expr,
        .Atom(_, _) => {
          all_ok = false;
        },
        .FnCall(_, ff, fa, _, _) => {
          field_name_opt := match(
            fa.get(usize(0)),
            .None => Option(String).None,
            .Some(name_e) => match(
              name_e,
              .Atom(_, ntok) => Option(String).Some(ntok.value),
              .FnCall(_, _, _, _, _) => Option(String).None
            )
          );
          field_val_opt := match(
            fa.get(usize(1)),
            .None => Option(String).None,
            .Some(val_e) => call_gen_expr(val_e, ctx, indent)
          );
          match(
            field_name_opt,
            .None => {
              all_ok = false;
            },
            .Some(fname) => match(
              field_val_opt,
              .None => {
                all_ok = false;
              },
              .Some(fval) => {
                if(!(first), {
                  result.push_str(", ");
                });
                result.push_str(".");
                result.push_string(fname);
                result.push_str(" = ");
                result.push_string(fval);
                provided_fields.push(String.from(fname.as_str()));
                first = false;
              }
            )
          );
        }
      )
    );
    i = (i + usize(1));
  });
  cond(
    (!(all_ok)) => Option(String).None,
    true => {
      match(
        ctx.get_struct_defaults(type_name.as_str()),
        .None => (),
        .Some(defaults_csv) => match(
          ctx.get_struct_fields(type_name.as_str()),
          .None => (),
          .Some(fields_csv) => {
            default_values := _split_csv(defaults_csv.as_str());
            field_names := _split_csv(fields_csv.as_str());
            n_defaults := default_values.len();
            (di : usize) = usize(0);
            while(di < n_defaults, {
              match(
                default_values.get(di),
                .None => (),
                .Some(default_value) => {
                  if(default_value != "__yo_no_default", {
                    field_name_opt := field_names.get(di);
                    match(
                      field_name_opt,
                      .None => (),
                      .Some(default_field_name) => {
                        (already_provided : bool) = false;
                        (pi : usize) = usize(0);
                        while((pi < provided_fields.len()) && (!(already_provided)), {
                          match(
                            provided_fields.get(pi),
                            .None => (),
                            .Some(provided_name) => {
                              if(provided_name == default_field_name, {
                                already_provided = true;
                              });
                            }
                          );
                          pi = (pi + usize(1));
                        });
                        if(!(already_provided), {
                          if(!(first), {
                            result.push_str(", ");
                          });
                          result.push_str(".");
                          result.push_string(default_field_name);
                          result.push_str(" = ");
                          result.push_string(default_value);
                          first = false;
                        });
                      }
                    );
                  });
                }
              );
              di = (di + usize(1));
            });
          }
        )
      );
      result.push_str("}");
      .Some(result)
    }
  )
});
/// Generate a C expression string for a Yo AST expression.
///
/// May emit C statements into `ctx.emitter` as side effects (for begin blocks,
/// while loops, etc.).  Returns the C expression that represents the value of
/// `expr`, or `None` for unsupported constructs.
generate_expr :: (fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String))(
  match(
    expr,
    // --- Atom expressions ---
    .Atom(_, tok) => cond(
      ((tok.kind == TokenKind.Identifier) && (tok.value == "continue")) => Option(String).Some(
        cond(
          (ctx.current_continue_label.len() > usize(0)) => {
            continue_code := String.from("goto ");
            continue_code.push_string(ctx.current_continue_label);
            continue_code
          },
          true => String.from("continue")
        )
      ),
      ((tok.kind == TokenKind.Identifier) && (tok.value == "break")) => Option(String).Some(String.from("break")),
      (tok.kind == TokenKind.Integer) =>.Some(gen_integer_lit(tok.value)),
      (tok.kind == TokenKind.Float) =>.Some(gen_float_lit(tok.value)),
      (tok.kind == TokenKind.Bool) =>.Some(gen_bool_lit(tok.value.as_str())),
      (tok.kind == TokenKind.StringLit) =>.Some(gen_string_lit(tok.value)),
      (tok.kind == TokenKind.Identifier) =>.Some(sanitize_c_ident(tok.value.as_str())),
      true => Option(String).None
    ),
    // --- FnCall expressions ---
    .FnCall(_, func_box, args, is_infix, _) => {
      op_opt := extract_op(func_box);
      ident_opt := fncall_func_ident(func_box);
      cond(
        // Binary infix arithmetic/comparison/logical: (a OP b)
        (
          is_infix && match(
            op_opt,
            .None => false,
            .Some(op) => ((op == "&&") || (op == "||"))
          )
        ) => match(
          op_opt,
          .None => Option(String).None,
          .Some(op) => cond(
            (op == "&&") => generate_op_and(args, indent, ctx),
            true => generate_op_or(args, indent, ctx)
          )
        ),
        (
          is_infix && match(
            op_opt,
            .None => false,
            .Some(op) => ((args.len() == usize(2)) && is_binary_op(op.as_str()))
          )
        ) => match(
          op_opt,
          .None => Option(String).None,
          .Some(op) => handle_infix_op(op, args, ctx, indent)
        ),
        // Unary prefix: (OP a)
        (
          (!(is_infix)) && match(
            op_opt,
            .None => false,
            .Some(op) => ((args.len() == usize(1)) && is_unary_prefix_op(op.as_str()))
          )
        ) => match(
          op_opt,
          .None => Option(String).None,
          .Some(op) => handle_prefix_op(op, args, ctx, indent)
        ),
        // Non-empty tuple literal: (a, b, …) → C anonymous-struct compound literal.
        // Uses __typeof__ to avoid needing explicit type info.
        (
          (!(is_infix)) &&
            (args.len() > usize(0)) &&
              match(
                ident_opt,
                .None => false,
                .Some(id) => (id == BK_TUPLE)
              )
        ) => match(
          generate_anonymous_tuple(expr, args, ctx, indent),
          .Some(tuple_code) => Option(String).Some(tuple_code),
          .None => handle_tuple_literal(args, ctx, indent)
        ),
        // Iso(T)(value) — metadata-aware Iso value constructor.
        // Mirrors `src/codegen/exprs/generation.ts` Iso type call dispatch.
        ((!(is_infix)) && is_iso_type_call(expr, ctx)) => generate_iso_type_call(expr, args, ctx, indent),
        // Labeled anonymous struct: { field1: val1, field2: val2 }
        // Generates a C compound literal with __typeof__ for type inference.
        // This is the expression form; `x := { ... }` is handled in handle_define.
        (
          (!(is_infix)) &&
            (args.len() > usize(0)) &&
              match(
                ident_opt,
                .None => false,
                .Some(id) => (id == BK_ANON_STRUCT)
              ) &&
                all_labeled_args(args)
        ) => {
          // Use current function return type if it's a known named struct;
          // otherwise build an anonymous C struct type inline.
          anon_ret_ty := ctx.current_fn_return_type.as_str();
          use_named_ty_anon := ((anon_ret_ty.len() > usize(0)) && ctx.is_struct_name(anon_ret_ty));
          result_anon := cond(
            use_named_ty_anon => {
              r := String.from("(");
              r.push_str(anon_ret_ty);
              r.push_str("){");
              r
            },
            true => String.from("(struct { ")
          );
          n_anon := args.len();
          (ai_anon : usize) = usize(0);
          (ok_anon : bool) = true;
          // First pass: collect field names and val codes
          field_names_anon := ArrayList(String).new();
          field_vals_anon := ArrayList(String).new();
          while((ai_anon < n_anon) && ok_anon, {
            match(
              args.get(ai_anon),
              .None => {
                ok_anon = false;
              },
              .Some(ae_a) => match(
                ae_a,
                .Atom(_, _) => {
                  ok_anon = false;
                },
                .FnCall(_, _, fa_a, _, _) => match(
                  fa_a.get(usize(0)),
                  .None => {
                    ok_anon = false;
                  },
                  .Some(fn_e) => match(
                    fn_e,
                    .FnCall(_, _, _, _, _) => {
                      ok_anon = false;
                    },
                    .Atom(_, fntok) => match(
                      fa_a.get(usize(1)),
                      .None => {
                        ok_anon = false;
                      },
                      .Some(fval_e) => match(
                        call_gen_expr(fval_e, ctx, indent),
                        .None => {
                          ok_anon = false;
                        },
                        .Some(fval_c) => {
                          field_names_anon.push(fntok.value);
                          field_vals_anon.push(fval_c);
                        }
                      )
                    )
                  )
                )
              )
            );
            ai_anon = (ai_anon + usize(1));
          });
          cond(
            (!(ok_anon)) => Option(String).None,
            true => {
              // Build struct type + initializer (or just initializer for named type)
              if(!(use_named_ty_anon), {
                (bi : usize) = usize(0);
                while(bi < n_anon, {
                  bi = (bi + usize(1));
                  match(
                    field_vals_anon.get(bi - usize(1)),
                    .None => (),
                    .Some(fval_s) => match(
                      field_names_anon.get(bi - usize(1)),
                      .None => (),
                      .Some(fn_s) => {
                        result_anon.push_str("__typeof__(");
                        result_anon.push_string(fval_s);
                        result_anon.push_str(") ");
                        result_anon.push_string(fn_s);
                        result_anon.push_str("; ");
                      }
                    )
                  );
                });
                result_anon.push_str("}){ ");
              });
              (ci : usize) = usize(0);
              while(ci < n_anon, {
                ci = (ci + usize(1));
                if(ci > usize(1), {
                  result_anon.push_str(", ");
                });
                match(
                  field_names_anon.get(ci - usize(1)),
                  .None => (),
                  .Some(fn_s) => {
                    result_anon.push_str(".");
                    result_anon.push_string(fn_s);
                    result_anon.push_str(" = ");
                  }
                );
                match(
                  field_vals_anon.get(ci - usize(1)),
                  .None => (),
                  .Some(fval_s) => {
                    result_anon.push_string(fval_s);
                  }
                );
              });
              result_anon.push_str(" }");
              Option(String).Some(result_anon)
            }
          )
        },
        // Shorthand anonymous struct (all bare identifiers): { x, y }
        // Each field = its own identifier value.
        (
          (!(is_infix)) &&
            (args.len() > usize(0)) &&
              match(
                ident_opt,
                .None => false,
                .Some(id) => (id == BK_ANON_STRUCT)
              ) &&
                ({
                  n_sh := args.len();
                  (ok_sh : bool) = true;
                  (shi : usize) = usize(0);
                  while((shi < n_sh) && ok_sh, {
                    match(
                      args.get(shi),
                      .None => {
                        ok_sh = false;
                      },
                      .Some(ae_sh) => match(
                        ae_sh,
                        .FnCall(_, _, _, _, _) => {
                          ok_sh = false;
                        },
                        .Atom(_, atsh) => {
                          if(!(atsh.kind == TokenKind.Identifier), {
                            ok_sh = false;
                          });
                        }
                      )
                    );
                    shi = (shi + usize(1));
                  });
                  ok_sh
                })
        ) => {
          // Use current function return type if it's a known named struct.
          sh_ret_ty := ctx.current_fn_return_type.as_str();
          use_named_ty_sh := ((sh_ret_ty.len() > usize(0)) && ctx.is_struct_name(sh_ret_ty));
          result_sh := cond(
            use_named_ty_sh => {
              r := String.from("(");
              r.push_str(sh_ret_ty);
              r.push_str("){");
              r
            },
            true => String.from("(struct { ")
          );
          n_sh2 := args.len();
          (fi_sh : usize) = usize(0);
          // Collect field names (all identifiers)
          field_names_sh := ArrayList(String).new();
          while(fi_sh < n_sh2, {
            fi_sh = (fi_sh + usize(1));
            match(
              args.get(fi_sh - usize(1)),
              .None => (),
              .Some(ae_sh2) => match(
                ae_sh2,
                .FnCall(_, _, _, _, _) => (),
                .Atom(_, atsh2) => {
                  field_names_sh.push(atsh2.value);
                }
              )
            );
          });
          if(!(use_named_ty_sh), {
            (gi_sh : usize) = usize(0);
            while(gi_sh < n_sh2, {
              gi_sh = (gi_sh + usize(1));
              match(
                field_names_sh.get(gi_sh - usize(1)),
                .None => (),
                .Some(fn_sh) => {
                  result_sh.push_str("__typeof__(");
                  result_sh.push_string(fn_sh);
                  result_sh.push_str(") ");
                  result_sh.push_string(fn_sh);
                  result_sh.push_str("; ");
                }
              );
            });
            result_sh.push_str("}){ ");
          });
          (hi_sh : usize) = usize(0);
          while(hi_sh < n_sh2, {
            hi_sh = (hi_sh + usize(1));
            if(hi_sh > usize(1), {
              result_sh.push_str(", ");
            });
            match(
              field_names_sh.get(hi_sh - usize(1)),
              .None => (),
              .Some(fn_sh) => {
                result_sh.push_str(".");
                result_sh.push_string(fn_sh);
                result_sh.push_str(" = ");
                result_sh.push_string(fn_sh);
              }
            );
          });
          result_sh.push_str(" }");
          Option(String).Some(result_sh)
        },
        // Unit value: FnCall(Atom("tuple"), [], …)  ← parser synthesizes this at end of begin
        // Empty anon struct: FnCall(Atom("_"), [], …) ← parser produces for `{ }` with no args
        // Both represent Yo unit () — emit the sentinel "0" (void functions skip it).
        (
          (!(is_infix)) &&
            (args.len() == usize(0)) &&
              match(
                ident_opt,
                .None => false,
                .Some(id) => ((id == BK_TUPLE) || (id == BK_ANON_STRUCT))
              )
        ) =>.Some(String.from("0")),
        // open NAME — emit `__auto_type field = name.field;` for each known field.
        // Looks up the variable's field CSV in the context, then emits bindings.
        (
          (!(is_infix)) &&
            (args.len() == usize(1)) &&
              match(
                ident_opt,
                .None => false,
                .Some(id) => (id == "open")
              )
        ) => match(
          args.get(usize(0)),
          .None => Option(String).None,
          .Some(open_arg) => match(
            call_gen_expr(open_arg, ctx, indent),
            .None => Option(String).None,
            .Some(open_recv) => {
              // First look for direct anon-var tracking, then registered struct fields
              fields_opt := match(
                ctx.get_open_var_fields(open_recv.as_str()),
                .Some(f) => Option(String).Some(f),
                .None => ctx.get_struct_fields(open_recv.as_str())
              );
              match(
                fields_opt,
                .None => Option(String).None,
                .Some(fcsv) => {
                  // Split CSV and emit bindings
                  field_list := _split_csv(fcsv.as_str());
                  nflds := field_list.len();
                  (fi_open : usize) = usize(0);
                  while(fi_open < nflds, {
                    fi_open = (fi_open + usize(1));
                    match(
                      field_list.get(fi_open - usize(1)),
                      .None => (),
                      .Some(fname_open) => {
                        ctx.emitter.emit_string(indent);
                        ctx.emitter.emit("__auto_type ");
                        ctx.emitter.emit_string(fname_open);
                        ctx.emitter.emit(" = ");
                        ctx.emitter.emit_string(open_recv);
                        ctx.emitter.emit(".");
                        ctx.emitter.emit_string(fname_open);
                        ctx.emitter.emit_line(";");
                      }
                    );
                  });
                  Option(String).Some(String.from("0"))
                }
              )
            }
          )
        ),
        // Pointer type cast: *(T)(expr) — generated as (T*)(expr) in C.
        // AST: FnCall(FnCall(Atom("*"), [TypeExpr], false), [arg], false)
        (
          (!(is_infix)) &&
            (args.len() == usize(1)) &&
              match(
                func_box.*,
                .Atom(_, _) => false,
                .FnCall(_, inner_func_box, inner_args, inner_infix, _) => (
                  (!(inner_infix)) &&
                    (inner_args.len() == usize(1)) &&
                      match(
                        inner_func_box.*,
                        .FnCall(_, _, _, _, _) => false,
                        .Atom(_, ibtok) => (ibtok.value == "*")
                      )
                )
              )
        ) => match(
          func_box.*,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, _, inner_args2, _, _) => match(
            inner_args2.get(usize(0)),
            .None => Option(String).None,
            .Some(ty_expr_cast) => match(
              type_expr_to_c(ty_expr_cast),
              .None => Option(String).None,
              .Some(c_ty_cast) => match(
                args.get(usize(0)),
                .None => Option(String).None,
                .Some(val_expr_cast) => match(
                  call_gen_expr(val_expr_cast, ctx, indent),
                  .None => Option(String).None,
                  .Some(val_code_cast) => {
                    result_cast := String.from("(");
                    result_cast.push_string(c_ty_cast);
                    result_cast.push_str("*)(");
                    result_cast.push_string(val_code_cast);
                    result_cast.push_str(")");
                    Option(String).Some(result_cast)
                  }
                )
              )
            )
          )
        ),
        // begin block: { stmt1; …; last_expr }
        match(
          ident_opt,
          .None => false,
          .Some(id) => (id == BK_BEGIN)
        ) => match(
          generate_begin(expr, args, ctx, indent),
          .Some(code) => Option(String).Some(code),
          .None => handle_begin(args, ctx, indent)
        ),
        // return(expr) — emit `return(expr);\n` and return "0" sentinel
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "return")
          )
        ) => match(
          args.get(usize(0)),
          .None => {
            ctx.emitter.emit_string(indent);
            ctx.emitter.emit_line("return;");
            .Some(String.from("0"))
          },
          .Some(ret_expr) => {
            single_field_return := match(
              ret_expr,
              .Atom(_, _) => Option(String).None,
              .FnCall(_, ret_fn_box, ret_args, ret_infix, _) => cond(
                ret_infix => Option(String).None,
                (ret_args.len() != usize(1)) => Option(String).None,
                true => match(
                  ret_fn_box.*,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, ret_begin_tok) => cond(
                    ((ret_begin_tok.value == BK_BEGIN) && (ctx.current_fn_return_type.len() > usize(0))) => match(
                      ret_args.get(usize(0)),
                      .None => Option(String).None,
                      .Some(ret_field_expr) => match(
                        ret_field_expr,
                        .FnCall(_, _, _, _, _) => Option(String).None,
                        .Atom(_, ret_field_tok) => {
                          c := String.from("(");
                          c.push_string(ctx.current_fn_return_type);
                          c.push_str("){ .");
                          c.push_string(ret_field_tok.value);
                          c.push_str(" = ");
                          c.push_string(sanitize_c_ident(ret_field_tok.value.as_str()));
                          c.push_str(" }");
                          Option(String).Some(c)
                        }
                      )
                    ),
                    true => Option(String).None
                  )
                )
              )
            );
            ret_code_opt := match(
              single_field_return,
              .Some(single_ret_code) => Option(String).Some(single_ret_code),
              .None => call_gen_expr(ret_expr, ctx, indent)
            );
            match(
              ret_code_opt,
              .None => Option(String).None,
              .Some(ret_code) => {
                ctx.emitter.emit_string(indent);
                ctx.emitter.emit("return ");
                ctx.emitter.emit_string(ret_code);
                ctx.emitter.emit_line(";");
                .Some(String.from("0"))
              }
            )
          }
        ),
        // unwind(expr) — in the prototype codegen, treated identically to `return`.
        // In the full codegen, `unwind` discards the continuation and exits the
        // enclosing handler-installed function.  For prototype purposes, emitting
        // `return(expr);` is correct for all non-async, non-effect code paths.
        // If the argument is unit (empty tuple, generates None) we emit a bare `return;`.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "unwind")
          )
        ) => match(
          args.get(usize(0)),
          .None => {
            ctx.emitter.emit_string(indent);
            ctx.emitter.emit_line("return;");
            .Some(String.from("0"))
          },
          .Some(esc_expr) => match(
            call_gen_expr(esc_expr, ctx, indent),
            // Unit unwind (tuple() → None): emit bare return
            .None => {
              ctx.emitter.emit_string(indent);
              ctx.emitter.emit_line("return;");
              .Some(String.from("0"))
            },
            .Some(esc_code) => {
              ctx.emitter.emit_string(indent);
              ctx.emitter.emit("return ");
              ctx.emitter.emit_string(esc_code);
              ctx.emitter.emit_line(";");
              .Some(String.from("0"))
            }
          )
        ),
        // break — emit C `break;`
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "break")
          )
        ) => {
          ctx.emitter.emit_string(indent);
          ctx.emitter.emit_line("break;");
          .Some(String.from("0"))
        },
        // continue — emit C `continue;`
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "continue")
          )
        ) => {
          ctx.emitter.emit_string(indent);
          if(ctx.current_continue_label.len() > usize(0), {
            ctx.emitter.emit("goto ");
            ctx.emitter.emit_string(ctx.current_continue_label);
            ctx.emitter.emit_line(";");
          }, {
            ctx.emitter.emit_line("continue;");
          });
          .Some(String.from("0"))
        },
        // cond(arm1, arm2, …)
        match(
          ident_opt,
          .None => false,
          .Some(id) => (id == "cond")
        ) => match(
          generate_cond(expr, args, ctx, indent),
          .Some(result) => Option(String).Some(result),
          .None => handle_cond(args, ctx, indent)
        ),
        // match(scrut, pat => body, …) — value-pattern ternary chain or data-enum switch
        match(
          ident_opt,
          .None => false,
          .Some(id) => (id == "match")
        ) => cond(
          _has_data_arm(args) => handle_match_data(args, ctx, indent),
          true => handle_match_value(args, ctx, indent)
        ),
        // while runtime(cond), body
        match(
          ident_opt,
          .None => false,
          .Some(id) => (id == "while")
        ) => generate_while_loop(expr, args, ctx, indent),
        // for iter_expr, (param) => { body } — iterator for-loop macro
        match(
          ident_opt,
          .None => false,
          .Some(id) => (id == "for")
        ) => handle_for(args, ctx, indent),
        // if(cond, then) / if(cond, then, else)
        match(
          ident_opt,
          .None => false,
          .Some(id) => (id == "if")
        ) => handle_if(args, ctx, indent),
        // Dot field access: a.b — infix FnCall with Dot func
        (is_infix && func_box_is_dot(func_box)) => handle_dot_access(args, ctx, indent),
        // Bare enum variant pattern: .Variant — non-infix, Dot func, exactly 1 arg.
        // Used in match arm patterns; resolves to `EnumName_Variant` via variant registry.
        ((!(is_infix)) && (func_box_is_dot(func_box) && (args.len() == usize(1)))) => handle_bare_dot_variant(args, ctx, indent),
        // Method call: a.method(args) — func_box is itself a dot-dispatch FnCall
        (
          (!(is_infix)) &&
            (
              (args.len() == usize(0)) &&
                (
                  func_box_static_type_app_method_is(func_box, "HashMap", "new") ||
                    func_box_static_type_app_method_is(func_box, "BTreeMap", "new")
                )
            )
        ) => match(
          get_dispatch_receiver(func_box),
          .None => Option(String).None,
          .Some(static_map_recv) => match(
            type_expr_to_c(static_map_recv),
            .None => Option(String).None,
            .Some(static_map_c_ty) => {
              if(is_hashmap_c_type(static_map_c_ty.as_str()), {
                ensure_runtime_map_c_type(ctx, static_map_c_ty.as_str(), "HashMap_");
              });
              if(is_btreemap_c_type(static_map_c_ty.as_str()), {
                ensure_runtime_map_c_type(ctx, static_map_c_ty.as_str(), "BTreeMap_");
              });
              static_map_new := String.from("(");
              static_map_new.push_string(static_map_c_ty);
              static_map_new.push_str("){.keys = {0}, .values = {0}, .length = 0}");
              Option(String).Some(static_map_new)
            }
          )
        ),
        // Box(T)(arg) — prelude object constructor form for Box values.
        (
          (!(is_infix)) &&
            (
              (args.len() == usize(1)) &&
                match(
                  func_box.*,
                  .Atom(_, _) => false,
                  .FnCall(_, box_type_fn_box_early, box_type_args_early, box_type_infix_early, _) => (
                    ((!(box_type_infix_early)) && (box_type_args_early.len() == usize(1))) &&
                      match(
                        box_type_fn_box_early.*,
                        .FnCall(_, _, _, _, _) => false,
                        .Atom(_, box_type_tok_early) => (box_type_tok_early.value == "Box")
                      )
                  )
                )
            )
        ) => match(
          args.get(usize(0)),
          .None => Option(String).None,
          .Some(box_ctor_arg_expr_early) => match(
            call_gen_expr(box_ctor_arg_expr_early, ctx, indent),
            .None => Option(String).None,
            .Some(box_ctor_arg_c_early) => {
              box_ctor_result_early := String.from("__yo_box(");
              box_ctor_result_early.push_string(box_ctor_arg_c_early);
              box_ctor_result_early.push_str(")");
              Option(String).Some(box_ctor_result_early)
            }
          )
        ),
        func_box_is_dot_dispatch(func_box) => handle_method_call(func_box, args, ctx, indent),
        // Index directly into a call result: `make_list()(idx)`.
        (
          (!(is_infix)) &&
            (
              (args.len() == usize(1)) &&
                (ident_opt.is_none() && is_plain_identifier_call_expr(func_box.*))
            )
        ) => match(
          func_box.*,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, _, _, _, _) => match(
            call_gen_expr(func_box.*, ctx, indent),
            .None => Option(String).None,
            .Some(callee_c) => match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(index_expr) => match(
                call_gen_expr(index_expr, ctx, indent),
                .None => Option(String).None,
                .Some(index_c) => {
                  indexed_result := String.from("(");
                  indexed_result.push_string(callee_c);
                  indexed_result.push_str(").data[");
                  indexed_result.push_string(index_c);
                  indexed_result.push_str("]");
                  Option(String).Some(indexed_result)
                }
              )
            )
          )
        ),
        // assert(cond, msg) — runtime test assertion: emits if(!(cond)){exit(1);}
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "assert")
          )
        ) => handle_assert(args, ctx, indent),
        // println(value) — bootstrap lowering for std/fmt string output.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "println")
          )
        ) => handle_println(args, ctx, indent),
        // comptime_assert(cond) / comptime_expect_error(expr) — compile-time only, no-op in prototype.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => ((id == "comptime_assert") || (id == "comptime_expect_error"))
          )
        ) =>.Some(String.from("0")),
        // name — strip the wrapper, emit the inner argument directly.
        // At expression level this appears as passing an evidence parameter.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "using")
          )
        ) => match(
          args.get(usize(0)),
          .None =>.Some(String.from("NULL")),
          .Some(inner) => match(
            inner,
            .FnCall(_, _, _, _, _) => call_gen_expr(inner, ctx, indent),
            .Atom(_, inner_tok) => cond(
              ((inner_tok.value == "io") && ctx.get_var_type("io").is_none()) =>
                Option(String).Some(String.from("NULL")),
              true => call_gen_expr(inner, ctx, indent)
            )
          )
        ),
        // given(name) — compile-time binding, no runtime effect. Emit "0".
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "given")
          )
        ) =>.Some(String.from("0")),
        // Struct constructor: TypeName(field1: val1, field2: val2)
        // Detected by: non-infix, uppercase-start name, all args labeled.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (is_uppercase_start(id) && all_labeled_args(args))
          )
        ) => match(
          ident_opt,
          .None => Option(String).None,
          .Some(id) => {
            resolved_id := cond(
              (id == "Self") => {
                st := ctx.get_self_type();
                cond(
                  (st.len() > usize(0)) => String.from(st),
                  true => id
                )
              },
              true => id
            );
            handle_struct_constructor(resolved_id, args, ctx, indent)
          }
        ),
        // Positional struct constructor: TypeName(arg1, arg2, ...)
        // Detected by: non-infix, uppercase-start name, registered struct, all args unlabeled.
        // Emits C compound literal: (TypeName){arg1, arg2, ...}
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => {
              effective_id := cond(
                (id == "Self") => {
                  st := ctx.get_self_type();
                  cond(
                    (st.len() > usize(0)) => String.from(st),
                    true => id
                  )
                },
                true => id
              );
              is_uppercase_start(effective_id) && ctx.is_struct_name(effective_id.as_str())
            }
          )
        ) => match(
          ident_opt,
          .None => Option(String).None,
          .Some(id) => {
            effective_id2 := cond(
              (id == "Self") => {
                st := ctx.get_self_type();
                cond(
                  (st.len() > usize(0)) => String.from(st),
                  true => id
                )
              },
              true => id
            );
            result2 := String.from("(");
            result2.push_string(effective_id2);
            result2.push_str("){");
            n_args2 := args.len();
            (ai : usize) = usize(0);
            (args_ok : bool) = true;
            while((ai < n_args2) && args_ok, {
              match(
                args.get(ai),
                .None => {
                  args_ok = false;
                },
                .Some(aexpr) => match(
                  call_gen_expr(aexpr, ctx, indent),
                  .None => {
                    args_ok = false;
                  },
                  .Some(av) => {
                    if(ai > usize(0), {
                      result2.push_str(", ");
                    });
                    result2.push_string(av);
                  }
                )
              );
              ai = (ai + usize(1));
            });
            match(
              ctx.get_struct_defaults(effective_id2.as_str()),
              .None => (),
              .Some(defaults_csv2) => {
                default_values2 := _split_csv(defaults_csv2.as_str());
                n_defaults2 := default_values2.len();
                while((ai < n_defaults2) && args_ok, {
                  match(
                    default_values2.get(ai),
                    .None => (),
                    .Some(default_value2) => {
                      if(default_value2 != "__yo_no_default", {
                        if(ai > usize(0), {
                          result2.push_str(", ");
                        });
                        result2.push_string(default_value2);
                      });
                    }
                  );
                  ai = (ai + usize(1));
                });
              }
            );
            if(args_ok, {
              result2.push_str("}");
            });
            cond(
              args_ok => Option(String).Some(result2),
              true => Option(String).None
            )
          }
        ),
        // __yo_gc_collect() — trigger garbage collection.
        // Mirrors `src/codegen/exprs/generation.ts` BuiltinFunctions.__yo_gc_collect dispatch.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "__yo_gc_collect")
          )
        ) => Option(String).Some(generate_yo_gc_collect(args, ctx, indent)),
        // panic([message]) — print message (if present), abort, and return an
        // unreachable dummy value of the expression's typed return type.
        // Mirrors `src/codegen/exprs/generation.ts` BuiltinFunctions.panic dispatch.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "panic")
          )
        ) => generate_panic(expr, args, ctx, indent),
        // __yo_thread_set_maximum_threads(n) — configure parallelism runtime.
        // Mirrors `src/codegen/exprs/generation.ts` BuiltinFunctions.__yo_thread_set_maximum_threads dispatch.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "__yo_thread_set_maximum_threads")
          )
        ) => generate_yo_thread_set_maximum_threads(args, ctx, indent),
        // array(v0, v1, ...) — metadata-aware anonymous array lowering.
        // Mirrors `src/codegen/exprs/generation.ts` BuiltinKeywords.array dispatch.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "array")
          )
        ) => match(
          generate_anonymous_array(expr, args, ctx, indent),
          .Some(array_code) => Option(String).Some(array_code),
          .None => handle_regular_call(ident_opt, args, ctx, indent)
        ),
        // __yo_array_fill(Array(T, N), value) — macro expansion for Array.fill.
        // Mirrors `src/codegen/exprs/generation.ts` BuiltinFunctions.__yo_array_fill dispatch.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "__yo_array_fill")
          )
        ) => Option(String).Some(generate_yo_array_fill(expr, args, ctx, indent)),
        // __yo_iso_extract(iso_value) — extract inner value from Iso wrapper.
        // Mirrors `src/codegen/exprs/generation.ts` BuiltinFunctions.__yo_iso_extract dispatch.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "__yo_iso_extract")
          )
        ) => Option(String).Some(generate_yo_iso_extract(expr, args, ctx, indent)),
        // __yo_iso_dispose(iso_value) — dispose Iso wrapper.
        // Mirrors `src/codegen/exprs/generation.ts` BuiltinFunctions.__yo_iso_dispose dispatch.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "__yo_iso_dispose")
          )
        ) => Option(String).Some(generate_yo_iso_dispose(expr, args, ctx, indent)),
        // open(struct_value) — emit runtime destructuring declarations when
        // typed metadata records `runtime_destructurings`.
        // Mirrors `src/codegen/exprs/generation.ts` BuiltinKeywords.open dispatch.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "open")
          )
        ) => match(
          generate_open(expr, args, ctx, indent),
          .Some(open_code) => Option(String).Some(open_code),
          .None => handle_regular_call(ident_opt, args, ctx, indent)
        ),
        // sizeof(type_name) — translate Yo type name to C type
        (
          (!(is_infix)) && (
            (args.len() == usize(1)) && match(
              ident_opt,
              .None => false,
              .Some(id) => (id == "sizeof")
            )
          )
        ) => match(
          args.get(usize(0)),
          .None => Option(String).None,
          .Some(sz_arg) =>
            match(
              type_expr_to_c(sz_arg),
              .None => generate_sizeof(args, ctx, indent),
              .Some(sz_str) => {
                r := String.from("sizeof(");
                r.push_string(sz_str);
                r.push_str(")");
                Option(String).Some(r)
              }
            )
        ),
        // typeid(T) — metadata-aware handler emits a deduped static type-id
        // declaration and returns the address expression.
        // Mirrors `src/codegen/exprs/generation.ts` BuiltinFunctions.typeid dispatch.
        (
          (!(is_infix)) && (
            (args.len() == usize(1)) && match(
              ident_opt,
              .None => false,
              .Some(id) => (id == "typeid")
            )
          )
        ) => generate_typeid(args, ctx),
        // Regular function call: f(args) — identifier func, not a builtin keyword
        // recur(args) — self-recursive call to the current function
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "recur")
          )
        ) => match(
          generate_recur(expr, args, ctx, indent),
          .Some(recur_code) => Option(String).Some(recur_code),
          .None => match(
            gen_arg_list(args, ctx, indent),
            .None => Option(String).None,
            .Some(arg_s) => {
              result := String.new();
              result.push_string(ctx.current_fn_name);
              result.push_str("(");
              result.push_string(arg_s);
              result.push_str(")");
              Option(String).Some(result)
            }
          )
        ),
        // box(arg) — heap-allocate a value and return a typed pointer to it
        (
          ((!(is_infix)) && (args.len() == usize(1))) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "box")
          )
        ) => match(
          args.get(usize(0)),
          .None => Option(String).None,
          .Some(arg_expr) => match(
            call_gen_expr(arg_expr, ctx, indent),
            .None => Option(String).None,
            .Some(arg_c) => {
              result := String.from("__yo_box(");
              result.push_string(arg_c);
              result.push_str(")");
              Option(String).Some(result)
            }
          )
        ),
        // dyn(lambda) / dyn(box(lambda)) — bootstrap Dyn(Fn(i32)->i32) carrier.
        (
          ((!(is_infix)) && (args.len() == usize(1))) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "dyn")
          )
        ) => match(
          args.get(usize(0)),
          .None => Option(String).None,
          .Some(dyn_arg_expr) => {
            lambda_arg_opt := cond(
              is_lambda_expr(dyn_arg_expr) => Option(AstExpr).Some(dyn_arg_expr),
              true => match(
                dyn_arg_expr,
                .FnCall(_, dyn_box_fn_box, dyn_box_args, dyn_box_infix, _) => cond(
                  (dyn_box_infix || (!(dyn_box_args.len() == usize(1)))) => Option(AstExpr).None,
                  true => match(
                    dyn_box_fn_box.*,
                    .FnCall(_, _, _, _, _) => Option(AstExpr).None,
                    .Atom(_, dyn_box_tok) => cond(
                      (dyn_box_tok.value == "box") => dyn_box_args.get(usize(0)),
                      true => Option(AstExpr).Some(dyn_arg_expr)
                    )
                  )
                ),
                .Atom(_, _) => Option(AstExpr).None
              )
            );
            match(
              lambda_arg_opt,
              .None => Option(String).None,
              .Some(lambda_arg_expr) => cond(
                is_lambda_expr(lambda_arg_expr) => lift_impl_fn_i32_i32_lambda(ctx, lambda_arg_expr, indent),
                true => Option(String).None
              )
            )
          }
        ),
        // Special case: primitive type cast — i32(x) → (int32_t)(x)
        (
          (!(is_infix)) &&
            (
              (args.len() == usize(1)) &&
                match(
                  ident_opt,
                  .None => false,
                  .Some(id) => is_primitive_type_cast(id.as_str())
                )
            )
        ) => match(
          ident_opt,
          .None => Option(String).None,
          .Some(id) => handle_type_cast(id, args, ctx, indent)
        ),
        (
          (!(is_infix)) &&
            match(
              func_box.*,
              .Atom(_, _) => false,
              .FnCall(_, _, _, _, _) => match(
                generic_type_app_base_name(func_box.*),
                .None => false,
                .Some(generic_base) => ctx.get_generic_struct_template_fields(generic_base.as_str()).is_some()
              )
            )
        ) => match(
          func_box.*,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, _, _, _, _) => generic_struct_constructor_to_c(func_box.*, args, ctx, indent)
        ),
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id == "impl")
          )
        ) => {
          register_anon_typeof_impl(args, ctx, indent);
          Option(String).Some(String.from("0"))
        },
        // Metadata-aware inline builtins: __yo_as, __yo_slice_new, __yo_maybe_uninit_new,
        // __yo_maybe_uninit_as_ptr, __yo_array_index_range*, __yo_slice_index_range*.
        // Mirrors the metadata-dependent branches of `generateYoInlineFunctionCall`
        // in src/codegen/exprs/inline-fns.ts.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => is_yo_inline_meta_builtin(id.as_str())
          )
        ) => match(
          ident_opt,
          .None => Option(String).None,
          .Some(meta_id) => {
            meta_arg_codes := ArrayList(String).new();
            (i_meta : usize) = usize(0);
            (n_meta : usize) = args.len();
            (ok_meta : bool) = true;
            while((i_meta < n_meta) && ok_meta, {
              match(
                args.get(i_meta),
                .None => {
                  ok_meta = false;
                },
                .Some(a_expr) => match(
                  call_gen_expr(a_expr, ctx, indent),
                  .None => {
                    ok_meta = false;
                  },
                  .Some(a_code) => {
                    meta_arg_codes.push(a_code);
                  }
                )
              );
              i_meta = (i_meta + usize(1));
            });
            cond(
              ok_meta => match(
                generate_yo_inline_meta(meta_id.as_str(), expr, args, meta_arg_codes, ctx, indent),
                .Some(meta_code) => Option(String).Some(meta_code),
                .None => handle_regular_call(ident_opt, args, ctx, indent)
              ),
              true => Option(String).None
            )
          }
        ),
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (!(is_builtin_keyword(id.as_str())))
          )
        ) => handle_regular_call(ident_opt, args, ctx, indent),
        // Assignment: x = val  OR  typed declaration: (x : T) = val
        (
          is_infix && match(
            op_opt,
            .None => false,
            .Some(op) => (op == "=")
          )
        ) => handle_assignment(args, ctx, indent),
        // Bare type annotation: x : T  →  emit "T_c x;"
        (
          is_infix && match(
            op_opt,
            .None => false,
            .Some(op) => (op == ":")
          )
        ) => match(
          generate_binding(args, ctx, indent),
          .Some(binding_code) => Option(String).Some(binding_code),
          .None => handle_bare_colon_decl(args, ctx, indent)
        ),
        // Variable definition: x := val  →  __auto_type x = val;
        (
          is_infix && match(
            op_opt,
            .None => false,
            .Some(op) => (op == ":=")
          )
        ) => handle_define(args, ctx, indent),
        // Constant binding: name :: val.
        // - If RHS is a literal → emit `__auto_type name = lit;` (comptime constant)
        // - If RHS is a call to a registered function → emit `__auto_type name = fn_callee(args);`
        // - If RHS is a struct constructor for a registered struct → emit `__auto_type name = (T){...};`
        // - Otherwise → "0" (no-op; function defs/type aliases are pre-hoisted or skipped)
        (
          is_infix && match(
            op_opt,
            .None => false,
            .Some(op) => (op == "::")
          )
        ) => {
          lhs_name_opt := match(
            args.get(usize(0)),
            .None => Option(String).None,
            .Some(lhs_e) => match(
              lhs_e,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, ltok) => cond(
                (ltok.kind == TokenKind.Identifier) => Option(String).Some(ltok.value),
                true => Option(String).None
              )
            )
          );
          // Determine if the RHS is something we can generate:
          //   (a) a literal atom, (b) a call to a registered function,
          // Determine if the RHS is something we can generate.
          // We skip RHS that are function/enum/object/impl definitions (pre-hoisted or not runtime values),
          // type names (unit, etc.), and other meta-expressions.
          rhs_is_eligible := match(
            args.get(usize(1)),
            .None => false,
            .Some(rhs_e) => match(
              rhs_e,
              .Atom(_, rtok) => cond(
                (rtok.kind == TokenKind.Integer) => true,
                (rtok.kind == TokenKind.Float) => true,
                (rtok.kind == TokenKind.Bool) => true,
                (rtok.kind == TokenKind.StringLit) => true,
                // Identifier atoms: allow only known-defined names (variables)
                (rtok.kind == TokenKind.Identifier) => ctx.is_defined_fn(rtok.value.as_str()),
                true => false
              ),
              .FnCall(_, rhs_func, rhs_fargs, rhs_infix, _) => cond(
                // Infix `->` (function type expression) — not a runtime value
                (
                  rhs_infix && match(
                    rhs_func.*,
                    .Atom(_, rftok_i) => (rftok_i.value == "->"),
                    .FnCall(_, _, _, _, _) => false
                  )
                ) => false,
                // Infix `=`, `:=`, `::`, `:` — assignment/definition patterns — not values
                (
                  rhs_infix && match(
                    rhs_func.*,
                    .Atom(_, rftok_asgn) => {
                      v := rftok_asgn.value.as_str();
                      ((v == "=") || (v == ":=")) || ((v == "::") || (v == ":"))
                    },
                    .FnCall(_, _, _, _, _) => false
                  )
                ) => false,
                // Dot-access infix `.` — field/method access — not a simple const value
                (
                  rhs_infix && match(
                    rhs_func.*,
                    .Atom(_, rftok_dot) => (rftok_dot.value == "."),
                    .FnCall(_, _, _, _, _) => false
                  )
                ) => false,
                // Other infix binary arithmetic/bitwise/comparison ops (|, &, ^, +, -, *, /, <<, >>, %, ==, !=, <, >, &&, ||)
                // are runtime-eligible if all referenced identifiers are known C variables.
                // Exception: `+` on string operands is invalid C — reject it.
                (
                  rhs_infix && match(
                    rhs_func.*,
                    .Atom(_, rftok_b) => is_binary_op(rftok_b.value.as_str()),
                    .FnCall(_, _, _, _, _) => false
                  )
                ) => {
                  // Check if this is a string `+` — reject to avoid C pointer arithmetic
                  is_str_add := match(
                    rhs_func.*,
                    .FnCall(_, _, _, _, _) => false,
                    .Atom(_, rftok_op) => cond(
                      (rftok_op.value != "+") => false,
                      true => {
                        has_str_atom := match(
                          args.get(usize(1)),
                          .None => false,
                          .Some(chk_e) => match(
                            chk_e,
                            .Atom(_, chk_tok) => (chk_tok.kind == TokenKind.StringLit),
                            .FnCall(_, _, chk_args, _, _) => cond(
                              // (str_id + ...) or (... + str_id): check if any arg is a string lit or string const var
                              true => {
                                (has_sl : bool) = false;
                                (sli : usize) = usize(0);
                                while((sli < chk_args.len()) && (!(has_sl)), {
                                  match(
                                    chk_args.get(sli),
                                    .None => (),
                                    .Some(sa) => match(
                                      sa,
                                      .Atom(_, sa_tok) => cond(
                                        (sa_tok.kind == TokenKind.StringLit) => {
                                          has_sl = true;
                                        },
                                        ((sa_tok.kind == TokenKind.Identifier) && ctx.is_string_const(sa_tok.value.as_str())) => {
                                          has_sl = true;
                                        },
                                        true => ()
                                      ),
                                      .FnCall(_, _, _, _, _) => ()
                                    )
                                  );
                                  sli = (sli + usize(1));
                                });
                                has_sl
                              }
                            )
                          )
                        );
                        has_str_atom
                      }
                    )
                  );
                  // Check both args to ensure all identifiers are available
                  all_ok := match(
                    args.get(usize(1)),
                    .None => false,
                    .Some(rhs_check) => ((!(is_str_add)) && expr_all_ids_known(rhs_check, ctx))
                  );
                  all_ok
                },
                rhs_infix => false,
                // Non-empty tuple literal: (a, b, …) — always eligible
                (
                  match(
                    rhs_func.*,
                    .Atom(_, rftok2) => ((rhs_fargs.len() > usize(0)) && (rftok2.value == BK_TUPLE)),
                    .FnCall(_, _, _, _, _) => false
                  )
                ) => true,
                // Enum constructor: `EnumName.Variant(args)` where EnumName is registered.
                // e.g. `c1 :: Shape.Circle(5.0)` → eligible (emits full enum struct init).
                // Also requires that the variant has registered C fields (non-comptime-only).
                (
                  match(
                    rhs_func.*,
                    .FnCall(_, ect_fn, ect_args, ect_infix, _) => (
                      ect_infix &&
                        match(
                          ect_fn.*,
                          .Atom(_, ectok) => (ectok.value == "."),
                          .FnCall(_, _, _, _, _) => false
                        ) &&
                          match(
                            ect_args.get(usize(0)),
                            .None => false,
                            .Some(ect_recv) => match(
                              ect_recv,
                              .Atom(_, ect_recv_tok) => (
                                ctx.is_enum_name(ect_recv_tok.value.as_str()) &&
                                  // Variant must have registered non-empty C fields; if fields are
                                  // comptime-only (e.g. comptime_int), get_variant_fields returns None
                                  // and we fall through to the no-op path.
                                  match(
                                    ect_args.get(usize(1)),
                                    .None => false,
                                    .Some(ect_var) => match(
                                      ect_var,
                                      .Atom(_, ect_var_tok) => ctx.get_variant_fields(
                                        ect_recv_tok.value.as_str(),
                                        ect_var_tok.value.as_str()
                                      ).is_some(),
                                      .FnCall(_, _, _, _, _) => false
                                    )
                                  )
                              ),
                              .FnCall(_, _, _, _, _) => false
                            )
                          )
                    ),
                    .Atom(_, _) => false
                  )
                ) => true,
                // Method call on a compound func (e.g. `5.neg()`, `arr.len()`) — eligible if
                // all referenced identifiers are known C variables.
                match(
                  rhs_func.*,
                  .FnCall(_, _, _, _, _) => true,
                  .Atom(_, _) => false
                ) => match(
                  args.get(usize(1)),
                  .None => false,
                  .Some(rhs_mc_chk) => expr_all_ids_known(rhs_mc_chk, ctx)
                ),
                true => match(
                  rhs_func.*,
                  .FnCall(_, _, _, _, _) => false,
                  .Atom(_, rftok) => cond(
                    // Skip: function definition body
                    (rftok.value == "fn") => false,
                    // Skip: enum/object/impl/forall definitions
                    (rftok.value == "enum") => false,
                    (rftok.value == "object") => false,
                    (rftok.value == "impl") => false,
                    (rftok.value == "forall") => false,
                    (rftok.value == "where") => false,
                    // Unary/binary operator symbol (non-identifier) → eligible if all identifier
                    // args reference known C variables.
                    // e.g., `n :: (-1000)` → `__auto_type n = (-1000);`
                    // e.g., `not_mask :: ~(u32(0xFF))` → `__auto_type not_mask = (~(uint32_t)(0xFF));`
                    (rftok.kind != TokenKind.Identifier) => match(
                      args.get(usize(1)),
                      .None => false,
                      .Some(rhs_unary_chk) => expr_all_ids_known(rhs_unary_chk, ctx)
                    ),
                    // Registered function call: callee is a known Yo function
                    (ctx.is_defined_fn(rftok.value.as_str())) => true,
                    // Registered struct constructor: callee starts uppercase and is a known struct
                    (ctx.is_struct_name(rftok.value.as_str())) => true,
                    // Primitive type cast: i32(0), u8(5), etc.
                    (is_primitive_type_cast(rftok.value.as_str())) => true,
                    true => false
                  )
                )
              )
            )
          );
          match(
            lhs_name_opt,
            .None =>.Some(String.from("0")),
            .Some(c_name) => match(
              args.get(usize(1)),
              .None =>.Some(String.from("0")),
              .Some(rhs_e2) => {
                method_extract_const_emitted := emit_method_extraction_macro_if_supported(c_name.as_str(), rhs_e2, ctx, indent);
                closure_alias_registered := match(
                  closure_param_name_from_impl_fn(rhs_e2),
                  .None => false,
                  .Some(closure_param_name) => {
                    ctx.register_closure_alias(c_name.as_str(), closure_param_name.as_str());
                    true
                  }
                );
                generic_struct_template_registered := register_generic_struct_template_if_supported(c_name.as_str(), rhs_e2, ctx);
                inline_type_alias_emitted := match(
                  rhs_e2,
                  .Atom(_, alias_atom_tok) => cond(
                    (alias_atom_tok.kind != TokenKind.Identifier) => false,
                    !(
                      ctx.is_struct_name(alias_atom_tok.value.as_str()) ||
                        ctx.is_enum_name(alias_atom_tok.value.as_str())
                    ) => false,
                    true => {
                      san_type_name := sanitize_c_ident(c_name.as_str());
                      ctx.emitter.emit_string(indent);
                      ctx.emitter.emit("typedef ");
                      ctx.emitter.emit_string(sanitize_c_ident(alias_atom_tok.value.as_str()));
                      ctx.emitter.emit(" ");
                      ctx.emitter.emit_string(san_type_name);
                      ctx.emitter.emit_line(";");
                      cond(
                        ctx.is_struct_name(alias_atom_tok.value.as_str()) => {
                          ctx.register_struct(String.from(c_name.as_str()));
                          true
                        },
                        true => {
                          ctx.register_enum(String.from(c_name.as_str()));
                          true
                        }
                      )
                    }
                  ),
                  .FnCall(_, type_alias_fn, _, type_alias_infix, _) => cond(
                    type_alias_infix => false,
                    true => match(
                      type_alias_fn.*,
                      .FnCall(_, _, _, _, _) => false,
                      .Atom(_, type_alias_tok) => {
                        type_alias_c_opt := cond(
                          (type_alias_tok.value == "struct") => match(
                            rhs_e2,
                            .Atom(_, _) => Option(String).None,
                            .FnCall(_, _, type_alias_args, _, _) => anon_struct_type_to_c(type_alias_args)
                          ),
                          (type_alias_tok.value == "Tuple") => type_expr_to_c(rhs_e2),
                          true => Option(String).None
                        );
                        match(
                          type_alias_c_opt,
                          .None => false,
                          .Some(type_alias_c) => {
                            san_type_name := sanitize_c_ident(c_name.as_str());
                            defaults_csv_for_alias := match(
                              rhs_e2,
                              .Atom(_, _) => String.new(),
                              .FnCall(_, _, type_alias_args2, _, _) => cond(
                                (type_alias_tok.value == "struct") =>
                                  struct_default_values_csv(type_alias_args2, ctx, indent),
                                true => String.new()
                              )
                            );
                            has_defaults_for_alias := struct_defaults_has_value(defaults_csv_for_alias);
                            should_emit_alias := (
                              (!(type_alias_c.contains(String.from("Self")))) &&
                                (
                                  (type_alias_tok.value == "Tuple") ||
                                    has_defaults_for_alias ||
                                      (!(ctx.is_struct_name(c_name.as_str())))
                                )
                            );
                            if(should_emit_alias, {
                              ctx.emitter.emit_string(indent);
                              ctx.emitter.emit("typedef ");
                              ctx.emitter.emit_string(type_alias_c);
                              ctx.emitter.emit(" ");
                              ctx.emitter.emit_string(san_type_name);
                              ctx.emitter.emit_line(";");
                              ctx.register_struct(String.from(c_name.as_str()));
                            });
                            if(has_defaults_for_alias, {
                              ctx.register_struct_defaults(c_name.as_str(), defaults_csv_for_alias.as_str());
                            });
                            should_emit_alias || has_defaults_for_alias
                          }
                        )
                      }
                    )
                  )
                );
                cond(
                  closure_alias_registered =>.Some(String.from("0")),
                  generic_struct_template_registered =>.Some(String.from("0")),
                  method_extract_const_emitted =>.Some(String.from("0")),
                  inline_type_alias_emitted =>.Some(String.from("0")),
                  // Inline array literal: `arr :: [v0, v1, ...]`
                  // Emit C array declaration and register as array var, same as `:=`.
                  (
                    (!(rhs_is_eligible)) && match(
                      rhs_e2,
                      .Atom(_, _) => false,
                      .FnCall(_, il_fn_b, il_fn_a, il_fi, _) => (
                        ((!(il_fi)) && (il_fn_a.len() > usize(0))) &&
                          match(
                            il_fn_b.*,
                            .FnCall(_, _, _, _, _) => false,
                            .Atom(_, il_tok) => (il_tok.value == "array")
                          )
                      )
                    )
                  ) => match(
                    rhs_e2,
                    .Atom(_, _) =>.Some(String.from("0")),
                    .FnCall(_, _, il_args2, _, _) => {
                      n_il2 := il_args2.len();
                      init_il2 := String.from("{");
                      (il2_i : usize) = usize(0);
                      (il2_ok : bool) = true;
                      while((il2_i < n_il2) && il2_ok, {
                        match(
                          il_args2.get(il2_i),
                          .None => {
                            il2_ok = false;
                          },
                          .Some(il_e2) => match(
                            call_gen_expr(il_e2, ctx, indent),
                            .None => {
                              il2_ok = false;
                            },
                            .Some(il_c2) => {
                              if(il2_i > usize(0), {
                                init_il2.push_str(", ");
                              });
                              init_il2.push_string(il_c2);
                              il2_i = (il2_i + usize(1));
                            }
                          )
                        );
                      });
                      cond(
                        (!(il2_ok)) =>.Some(String.from("0")),
                        true => {
                          init_il2.push_str("}");
                          first_opt2 := match(
                            il_args2.get(usize(0)),
                            .None => Option(String).None,
                            .Some(fe2) => call_gen_expr(fe2, ctx, indent)
                          );
                          match(
                            first_opt2,
                            .None =>.Some(String.from("0")),
                            .Some(first2) => {
                              san_il := sanitize_c_ident(c_name.as_str());
                              ctx.emitter.emit_string(indent);
                              ctx.emitter.emit("__typeof__(");
                              ctx.emitter.emit_string(first2);
                              ctx.emitter.emit(") ");
                              ctx.emitter.emit_string(san_il);
                              ctx.emitter.emit("[");
                              ctx.emitter.emit_string(n_il2.to_string());
                              ctx.emitter.emit("] = ");
                              ctx.emitter.emit_string(init_il2);
                              ctx.emitter.emit_line(";");
                              ctx.register_array_var_with_size(c_name.as_str(), n_il2.to_string().as_str());
                              .Some(String.from("0"))
                            }
                          )
                        }
                      )
                    }
                  ),
                  // Skip if RHS is a function definition (pre-hoisted) or not eligible
                  (!(rhs_is_eligible)) =>.Some(String.from("0")),
                  true => match(
                    call_gen_expr(rhs_e2, ctx, indent),
                    .None =>.Some(String.from("0")),
                    .Some(rhs_code) => {
                      ctx.emitter.emit_string(indent);
                      ctx.emitter.emit("__auto_type ");
                      ctx.emitter.emit_string(c_name);
                      ctx.emitter.emit(" = ");
                      ctx.emitter.emit_string(rhs_code);
                      ctx.emitter.emit_line(";");
                      ctx.register_const_var(c_name.as_str());
                      // Track string constants so we can reject string `+` in dependent bindings
                      is_str_rhs := match(
                        rhs_e2,
                        .Atom(_, str_tok) => (str_tok.kind == TokenKind.StringLit),
                        .FnCall(_, _, _, _, _) => false
                      );
                      if(is_str_rhs, {
                        ctx.register_string_const(c_name.as_str());
                      });
                      .Some(String.from("0"))
                    }
                  )
                )
              }
            )
          )
        },
        true => Option(String).None
      )
    }
  )
);
// Initialize the g_gen_expr_fn pointer after generate_expr is defined.
_gen_expr_fn_init := (fn() -> bool)({
  set_generate_expr_fn(generate_expr);
  true
})();
export(generate_expr, sanitize_c_ident, is_binary_op, is_unary_prefix_op);
export(gen_integer_lit, gen_float_lit, gen_bool_lit, gen_string_lit);
export(gen_binary_op, gen_unary_op);
export(type_name_to_c, type_expr_to_c, is_c_type_name, is_builtin_keyword, is_primitive_type_cast, build_typed_decl, ensure_arraylist_c_type, ensure_impl_fn_c_type);
export(register_generic_struct_template_if_supported);
export(gen_arg_list, handle_regular_call, handle_dot_access, handle_method_call, handle_assignment);
export(handle_define, handle_bare_colon_decl, handle_type_cast, handle_assert);
export(is_labeled_arg, all_labeled_args, is_uppercase_start, handle_struct_constructor);
export(gen_match_arm, handle_match_value, handle_match_data, handle_bare_dot_variant);
export(func_box_is_dot, func_box_is_dot_dispatch);
export(is_begin_block);
export(gen_anon_struct_compound, handle_tuple_literal);
export(is_lambda_expr, extract_lambda_param_names, lift_non_capturing_lambda);
