            ),
          ((type_app_receiver_is(recv_expr, "Result") && (method_name == "Ok")) && (args.len() == usize(1))) =>
            match(args.get(usize(0)),.None => Option(String).None,.Some(v) => call_gen_expr(v, ctx, indent)),
          // Err(e) lowers to NULL (the error value is discarded in the prototype encoding).
          ((type_app_receiver_is(recv_expr, "Result") && (method_name == "Err")) && (args.len() == usize(1))) =>
            Option(String).Some(String.from("NULL")),
          (
            ((method_name == "new") || (method_name == "another_new")) &&
