            ),
          ((type_app_receiver_is(recv_expr, "Option") && (method_name == "Some")) && (args.len() == usize(1))) =>
            match(args.get(usize(0)),.None => Option(String).None,.Some(v) => call_gen_expr(v, ctx, indent)),
          ((type_app_receiver_is(recv_expr, "Option") && (method_name == "None")) && (args.len() == usize(0))) =>
            match(
