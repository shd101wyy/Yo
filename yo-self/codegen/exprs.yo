                      .None => Option(String).None,
                      .Some(map_value_c) => {
                        map_set_code := String.from("(");
                        map_set_code.push_string(recv_code);
                        map_set_code.push_str(".keys[(size_t)(");
                        map_set_code.push_string(map_key_c);
                        map_set_code.push_str(")] = ");
                        map_set_code.push_string(map_key_c);
                        map_set_code.push_str(", ");
                        map_set_code.push_string(recv_code);
                        map_set_code.push_str(".values[(size_t)(");
                        map_set_code.push_string(map_key_c);
                        map_set_code.push_str(")] = ");
                        map_set_code.push_string(map_value_c);
                        map_set_code.push_str(", ");
                        map_set_code.push_string(recv_code);
                        map_set_code.push_str(".length++)");
                        Option(String).Some(map_set_code)
