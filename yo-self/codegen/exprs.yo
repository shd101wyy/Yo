//! Expression and statement code generation for the self-hosted Yo C code
//! generator.
//!
//! Phase 4b: literals (integer, float, bool, string), variable references,
//! binary infix operators, and unary prefix operators.
//!
//! Phase 4c: control flow — begin blocks, cond expressions, while loops,
//! if expressions.
//!
//! ASAN note: `generate_expr` is large but far below the ~700-variable
//! threshold that forced `evaluate()` to use the `g_eval_fn` pointer trick.
//! All Phase 4c control-flow helpers are factored into module-level functions.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, BK_BEGIN, BK_ANON_STRUCT, BK_TUPLE } :: import("../expr/expr.yo");
{ TokenKind } :: import("../lexer/token.yo");
{ CodegenContext } :: import("./context.yo");
{ DataBinding, DataArm, generate_match_data } :: import("./match.yo");
// ---------------------------------------------------------------------------
// Phase 4b helpers — one per kind of C literal/expression
// ---------------------------------------------------------------------------
/// Generate C code for an integer literal: emit the numeric string as-is.
gen_integer_lit :: (fn(value : String) -> String)(value);
/// Generate C code for a float literal: emit the numeric string as-is.
gen_float_lit :: (fn(value : String) -> String)(value);
/// Generate C code for a bool literal: `true` → `1`, `false` → `0`.
gen_bool_lit :: (fn(value : str) -> String)(
  cond(
    (value == "true") => String.from("1"),
    (value == "false") => String.from("0"),
    true => String.from(value)
  )
);
/// Generate C code for a string literal.
///
/// The Yo lexer stores StringLit token values with the surrounding quotes
/// intact and uses the same escape sequences as C, so we emit them verbatim.
gen_string_lit :: (fn(value : String) -> String)(value);
/// Produce a valid C identifier from a Yo name.
///
/// Most Yo identifiers are already valid C names.  Future phases will need
/// to handle names that clash with C keywords or contain special characters;
/// for now we return the name unchanged.
/// Map a Yo identifier to a C-safe identifier.
///
/// Some Yo names collide with C reserved words, keywords, or common macros
/// (e.g. `errno`, `restrict`, `register`, `_Bool`).  We prefix those with
/// `_yo_` so the emitted C compiles cleanly.
sanitize_c_ident :: (fn(name : str) -> String)(
  cond(
    // C keywords that are also valid Yo identifiers
    (name == "auto") => String.from("_yo_auto"),
    (name == "register") => String.from("_yo_register"),
    (name == "restrict") => String.from("_yo_restrict"),
    (name == "volatile") => String.from("_yo_volatile"),
    (name == "inline") => String.from("_yo_inline"),
    (name == "signed") => String.from("_yo_signed"),
    (name == "unsigned") => String.from("_yo_unsigned"),
    (name == "extern") => String.from("_yo_extern"),
    (name == "static") => String.from("_yo_static"),
    (name == "typedef") => String.from("_yo_typedef"),
    (name == "union") => String.from("_yo_union"),
    (name == "struct") => String.from("_yo_struct"),
    (name == "enum") => String.from("_yo_enum"),
    (name == "goto") => String.from("_yo_goto"),
    (name == "switch") => String.from("_yo_switch"),
    (name == "case") => String.from("_yo_case"),
    (name == "default") => String.from("_yo_default"),
    (name == "do") => String.from("_yo_do"),
    (name == "char") => String.from("_yo_char"),
    (name == "short") => String.from("_yo_short"),
    (name == "long") => String.from("_yo_long"),
    (name == "float") => String.from("_yo_float"),
    (name == "double") => String.from("_yo_double"),
    (name == "int") => String.from("_yo_int"),
    (name == "void") => String.from("_yo_void"),
    // Common C macros that collide
    (name == "errno") => String.from("_yo_errno"),
    (name == "NULL") => String.from("_yo_NULL"),
    (name == "EOF") => String.from("_yo_EOF"),
    (name == "stdin") => String.from("_yo_stdin"),
    (name == "stdout") => String.from("_yo_stdout"),
    (name == "stderr") => String.from("_yo_stderr"),
    (name == "assert") => String.from("_yo_assert"),
    (name == "min") => String.from("_yo_min"),
    (name == "max") => String.from("_yo_max"),
    true => String.from(name)
  )
);
/// True iff `op` is a supported binary infix operator.
is_binary_op :: (fn(op : str) -> bool)(
  cond(
    (op == "+") => true,
    (op == "-") => true,
    (op == "*") => true,
    (op == "/") => true,
    (op == "%") => true,
    (op == "==") => true,
    (op == "!=") => true,
    (op == "<") => true,
    (op == ">") => true,
    (op == "<=") => true,
    (op == ">=") => true,
    (op == "&&") => true,
    (op == "||") => true,
    (op == "|") => true,
    (op == "&") => true,
    (op == "^") => true,
    (op == "<<") => true,
    (op == ">>") => true,
    true => false
  )
);
/// True iff `op` is a supported unary prefix operator.
is_unary_prefix_op :: (fn(op : str) -> bool)(
  cond(
    (op == "-") => true,
    (op == "!") => true,
    (op == "&") => true,
    (op == "~") => true,
    true => false
  )
);
/// Emit `(lhs OP rhs)`.
gen_binary_op :: (fn(op : String, lhs : String, rhs : String) -> String)({
  result := String.from("(");
  result.push_string(lhs);
  result.push_str(" ");
  result.push_string(op);
  result.push_str(" ");
  result.push_string(rhs);
  result.push_str(")");
  result
});
/// Emit `(OP operand)`.
gen_unary_op :: (fn(op : String, operand : String) -> String)({
  result := String.from("(");
  result.push_string(op);
  result.push_string(operand);
  result.push_str(")");
  result
});
// ---------------------------------------------------------------------------
// Module-level function pointer — avoids direct recursion in generate_expr
// ---------------------------------------------------------------------------
//
// Yo standalone functions cannot call themselves directly (no forward
// declarations).  We store a pointer to generate_expr and route recursive
// calls through call_gen_expr, mirroring the g_eval_fn trick in eval.yo.
(g_gen_expr_fn : Option(fn(expr : AstExpr, ctx : *(CodegenContext), indent : String) -> Option(String))) =.None;
call_gen_expr :: (fn(expr : AstExpr, ctx : *(CodegenContext), indent : String) -> Option(String))(
  match(
    g_gen_expr_fn,
    .None => Option(String).None,
    .Some(f) => f(expr, ctx, indent)
  )
);
// ---------------------------------------------------------------------------
// Phase 4b helpers — infix/prefix sub-expression generation
// ---------------------------------------------------------------------------
gen_infix_side :: (fn(args : ArrayList(AstExpr), idx : usize, ctx : *(CodegenContext), indent : String) -> Option(String))(
  match(
    args.get(idx),
    .None => Option(String).None,
    .Some(e) => call_gen_expr(e, ctx, indent)
  )
);
handle_infix_op :: (
  fn(
    op : String,
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  lhs := gen_infix_side(args, usize(0), ctx, indent);
  rhs := gen_infix_side(args, usize(1), ctx, indent);
  match(
    lhs,
    .None => Option(String).None,
    .Some(l) => match(
      rhs,
      .None => Option(String).None,
      .Some(r) => {
        // Use strcmp for string equality/inequality comparisons.
        // Detect: either side is a C string literal (starts with '"') or
        // a to_string() call (contains "_to_string(").
        lhs_is_str := (l.starts_with(String.from("\"")) || l.contains(String.from("_to_string(")));
        rhs_is_str := (r.starts_with(String.from("\"")) || r.contains(String.from("_to_string(")));
        // box var check: `box(T)` returns a pointer; compare via deref (*x == *y).
        lhs_is_box := ctx.*.is_box_var(l.as_str());
        // Derive-Eq type check: look up the type of lhs variable and check for registered Eq.
        lhs_eq_type := match(
          ctx.*.get_var_type(l.as_str()),
          .None => Option(String).None,
          .Some(t) => cond(
            ctx.*.has_derive_eq(t.as_str()) => Option(String).Some(t),
            true => Option(String).None
          )
        );
        // Derive-Ord type check: look up type of lhs and check for registered Ord.
        lhs_ord_type := match(
          ctx.*.get_var_type(l.as_str()),
          .None => Option(String).None,
          .Some(t) => cond(
            ctx.*.has_derive_ord(t.as_str()) => Option(String).Some(t),
            true => Option(String).None
          )
        );
        is_cmp_op := ((op.as_str() == "<") || ((op.as_str() == "<=") || ((op.as_str() == ">") || (op.as_str() == ">="))));
        cond(
          ((lhs_is_str || rhs_is_str) && (op.as_str() == "==")) => {
            out := String.from("(strcmp(");
            out.push_string(l);
            out.push_str(", ");
            out.push_string(r);
            out.push_str(") == 0)");
            Option(String).Some(out)
          },
          ((lhs_is_str || rhs_is_str) && (op.as_str() == "!=")) => {
            out2 := String.from("(strcmp(");
            out2.push_string(l);
            out2.push_str(", ");
            out2.push_string(r);
            out2.push_str(") != 0)");
            Option(String).Some(out2)
          },
          // box var: compare dereferenced values (*x == *y)
          (lhs_is_box && (op.as_str() == "==")) => {
            out_box := String.from("(*");
            out_box.push_string(l);
            out_box.push_str(" == *");
            out_box.push_string(r);
            out_box.push_str(")");
            Option(String).Some(out_box)
          },
          (lhs_is_box && (op.as_str() == "!=")) => {
            out_box2 := String.from("(*");
            out_box2.push_string(l);
            out_box2.push_str(" != *");
            out_box2.push_string(r);
            out_box2.push_str(")");
            Option(String).Some(out_box2)
          },
          ((op.as_str() == "==") && lhs_eq_type.is_some()) => match(
            lhs_eq_type,
            .None =>.Some(gen_binary_op(op, l, r)),
            .Some(ty_name) => {
              out3 := String.from("fn_");
              out3.push_string(ty_name);
              out3.push_str("_eq(&");
              out3.push_string(l);
              out3.push_str(", &");
              out3.push_string(r);
              out3.push_str(")");
              Option(String).Some(out3)
            }
          ),
          ((op.as_str() == "!=") && lhs_eq_type.is_some()) => match(
            lhs_eq_type,
            .None =>.Some(gen_binary_op(op, l, r)),
            .Some(ty_name2) => {
              out4 := String.from("(!fn_");
              out4.push_string(ty_name2);
              out4.push_str("_eq(&");
              out4.push_string(l);
              out4.push_str(", &");
              out4.push_string(r);
              out4.push_str("))");
              Option(String).Some(out4)
            }
          ),
          // Derive-Ord: dispatch `<`, `<=`, `>`, `>=` to fn_TypeName_cmp
          (is_cmp_op && lhs_ord_type.is_some()) => match(
            lhs_ord_type,
            .None =>.Some(gen_binary_op(op, l, r)),
            .Some(ord_ty) => {
              cmp_call := String.from("fn_");
              cmp_call.push_string(ord_ty);
              cmp_call.push_str("_cmp(&");
              cmp_call.push_string(l);
              cmp_call.push_str(", &");
              cmp_call.push_string(r);
              cmp_call.push_str(")");
              // `< 0`, `<= 0`, `> 0`, `>= 0`
              cmp_rhs := String.from("0");
              out_cmp := String.from("(");
              out_cmp.push_string(cmp_call);
              out_cmp.push_str(" ");
              out_cmp.push_string(op);
              out_cmp.push_str(" ");
              out_cmp.push_string(cmp_rhs);
              out_cmp.push_str(")");
              Option(String).Some(out_cmp)
            }
          ),
          true =>.Some(gen_binary_op(op, l, r))
        )
      }
    )
  )
});
handle_prefix_op :: (
  fn(
    op : String,
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)(
  match(
    args.get(usize(0)),
    .None => Option(String).None,
    .Some(e) => match(
      call_gen_expr(e, ctx, indent),
      .None => Option(String).None,
      .Some(a) =>.Some(gen_unary_op(op, a))
    )
  )
);
/// Extract the operator string from a FnCall func expression.
extract_op :: (fn(func_box : Box(AstExpr)) -> Option(String))(
  match(
    func_box.*,
    .Atom(_, ftok) => cond(
      (ftok.kind == TokenKind.Operator) =>.Some(ftok.value),
      true => Option(String).None
    ),
    .FnCall(_, _, _, _, _) => Option(String).None
  )
);
// ---------------------------------------------------------------------------
// Phase 4c helpers — control flow
// ---------------------------------------------------------------------------
/// Emit a single expression as a C statement: `{indent}{expr_code};\n`.
/// Returns unit; used internally to emit non-last statements in begin blocks.
emit_as_stmt :: (fn(code : String, ctx : *(CodegenContext), indent : String) -> unit)({
  ctx.*.emitter.emit_string(indent);
  ctx.*.emitter.emit_string(code);
  ctx.*.emitter.emit_line(";");
});
/// Returns true if `expr` is a begin block (`{ ... }`), i.e. a FnCall whose
/// func is an Atom with value `BK_BEGIN`.  These blocks contain statement-level
/// side-effects (break / continue / return) that must NOT appear inside a C
/// ternary operand — they need a C `if` statement instead.
is_begin_block :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, func_box, _, _, _) => match(
      func_box.*,
      .FnCall(_, _, _, _, _) => false,
      .Atom(_, ftok) => (ftok.value.as_str() == BK_BEGIN)
    )
  )
);
/// Generate a `begin` block.
///
/// Emits all statements except the last into `ctx.emitter` and returns the
/// last expression as the block's value.  An empty begin block returns `"0"`.
///
/// Nested begin blocks that appear as non-last statements are wrapped in C
/// `{ }` so that variable declarations inside each block are properly scoped
/// and don't conflict with declarations in sibling blocks.
handle_begin :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  cond(
    (n == usize(0)) =>.Some(String.from("0")),
    true => {
      // Emit all but the last statement
      (i : usize) = usize(0);
      inner := {
        result_so_far := String.from(indent.as_str());
        result_so_far.push_str("  ");
        result_so_far
      };
      while(runtime(i < (n - usize(1))), {
        match(
          args.get(i),
          .None => (),
          .Some(s) => cond(
            // Nested begin block: wrap in C { } for proper variable scoping.
            // Without wrapping, the same variable name (e.g. `x`) in two sibling
            // begin blocks would cause a C "redefinition" compile error.
            is_begin_block(s) => {
              ctx.*.emitter.emit_string(indent);
              ctx.*.emitter.emit_line("{");
              _nested_val := call_gen_expr(s, ctx, inner);
              ctx.*.emitter.emit_string(indent);
              ctx.*.emitter.emit_line("}");
            },
            true => match(
              call_gen_expr(s, ctx, inner),
              .None => (),
              .Some(code) => emit_as_stmt(code, ctx, indent)
            )
          )
        );
        i = (i + usize(1));
      });
      // Return the last expression as the block value
      match(
        args.get(n - usize(1)),
        .None =>.Some(String.from("0")),
        .Some(e) => call_gen_expr(e, ctx, indent)
      )
    }
  )
});
/// True if `expr` requires statement-level emission and cannot appear
/// inside a C ternary operand.
///
/// Matches: `continue`, `break`, `return(expr)`, and begin blocks
/// that contain any statement-level expression (e.g. `{ x = 1; break; }`).
///
/// Note: the Yo parser appends a trailing `tuple()` sentinel to begin blocks
/// that end with `;`, so we scan ALL elements (not just the last) to detect
/// `break`/`continue`/`return` hidden before the sentinel.
is_stmt_body_expr :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, tok) => cond(
      (tok.kind != TokenKind.Identifier) => false,
      (tok.value.as_str() == "continue") => true,
      (tok.value.as_str() == "break") => true,
      true => false
    ),
    .FnCall(_, func_box, args, _, _) => {
      is_ret := match(
        func_box.*,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, ftok) => ((ftok.kind == TokenKind.Identifier) && (ftok.value.as_str() == "return"))
      );
      is_begin := match(
        func_box.*,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, ftok) => (ftok.value.as_str() == BK_BEGIN)
      );
      cond(
        is_ret => true,
        is_begin => {
          // Scan ALL elements — parser may add trailing tuple() before closing }
          na := args.len();
          cond(
            (na == usize(0)) => false,
            true => {
              (found : bool) = false;
              (k : usize) = usize(0);
              while(runtime((k < na) && (!(found))), {
                match(
                  args.get(k),
                  .None => (),
                  .Some(e) => {
                    found = recur(e);
                  }
                );
                k = (k + usize(1));
              });
              found
            }
          )
        },
        true => false
      )
    }
  )
);
/// Extract the arm args from a `cond` arm (which is `FnCall("=>", [c, b], true)`).
get_arm_args :: (fn(arm : AstExpr) -> Option(ArrayList(AstExpr)))(
  match(
    arm,
    .Atom(_, _) => Option(ArrayList(AstExpr)).None,
    .FnCall(_, _, arm_args, _, _) =>.Some(arm_args)
  )
);
/// Emit a `cond(...)` as a series of C `if / else if / else` statements.
///
/// Used when one or more arm bodies contain statement-level constructs
/// (`continue`, `break`, `return`) that are invalid inside a C ternary.
///
/// Emits side effects into `ctx.emitter` and returns `Some("0")` as unit sentinel.
emit_cond_as_if_else :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  inner := String.from(indent.as_str());
  inner.push_str("  ");
  (i : usize) = usize(0);
  (ok : bool) = true;
  while(runtime((i < n) && ok), {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arm) => match(
        get_arm_args(arm),
        .None => {
          ok = false;
        },
        .Some(arm_args) => match(
          arm_args.get(usize(0)),
          .None => {
            ok = false;
          },
          .Some(cond_expr) => match(
            arm_args.get(usize(1)),
            .None => {
              ok = false;
            },
            .Some(body_expr) => {
              is_first := (i == usize(0));
              is_last := (i == (n - usize(1)));
              is_true_catch := match(
                cond_expr,
                .Atom(_, ctok) => ((ctok.kind == TokenKind.Bool) && (ctok.value.as_str() == "true")),
                .FnCall(_, _, _, _, _) => false
              );
              cond(
                // cond(true => body) with no prior arms — just emit body
                (is_first && is_true_catch) => {
                  match(
                    call_gen_expr(body_expr, ctx, indent),
                    .None => (),
                    .Some(bs) => {
                      emit_as_stmt(bs, ctx, indent);
                    }
                  );
                },
                // else { body; } — the catch-all arm
                is_true_catch => {
                  ctx.*.emitter.emit(" else {\n");
                  match(
                    call_gen_expr(body_expr, ctx, inner),
                    .None => (),
                    .Some(bs) => {
                      emit_as_stmt(bs, ctx, inner);
                    }
                  );
                  ctx.*.emitter.emit_string(indent);
                  ctx.*.emitter.emit("}\n");
                },
                // if (cond) { body; }  or  } else if (cond) { body; }
                true => {
                  cond(
                    is_first => {
                      ctx.*.emitter.emit_string(indent);
                      ctx.*.emitter.emit("if (");
                    },
                    true => {
                      ctx.*.emitter.emit(" else if (");
                    }
                  );
                  match(
                    call_gen_expr(cond_expr, ctx, indent),
                    .None => {
                      ok = false;
                    },
                    .Some(c) => {
                      ctx.*.emitter.emit_string(c);
                      ctx.*.emitter.emit(") {\n");
                      match(
                        call_gen_expr(body_expr, ctx, inner),
                        .None => (),
                        .Some(bs) => {
                          emit_as_stmt(bs, ctx, inner);
                        }
                      );
                      ctx.*.emitter.emit_string(indent);
                      cond(
                        is_last => {
                          ctx.*.emitter.emit("}\n");
                        },
                        true => {
                          ctx.*.emitter.emit("}");
                        }
                      );
                    }
                  )
                }
              );
            }
          )
        )
      )
    );
    i = (i + usize(1));
  });
  cond(
    ok =>.Some(String.from("0")),
    true => Option(String).None
  )
});
/// True if `expr` is an Atom with token value equal to `val`.
_is_atom_value :: (fn(expr : AstExpr, val : str) -> bool)(
  match(
    expr,
    .Atom(_, tok) => (tok.value.as_str() == val),
    .FnCall(_, _, _, _, _) => false
  )
);
/// Generate a single `cond` arm as: `(cond_expr ? body_expr : rest)`.
/// `rest` is the "else" branch (another ternary or the fallback value).
gen_cond_arm :: (
  fn(
    arm_args : ArrayList(AstExpr),
    rest : String,
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  cond_expr_opt := arm_args.get(usize(0));
  body_expr_opt := arm_args.get(usize(1));
  match(
    cond_expr_opt,
    .None => Option(String).None,
    .Some(cond_expr) => match(
      body_expr_opt,
      .None => Option(String).None,
      .Some(body_expr) => {
        // Constant folding: `true =>` always takes this branch; `false =>` skips it.
        // Note: constant folding at codegen level is important for avoiding dead code
        // (e.g. `cond(true => 42, false => undefined_fn())` must not emit `undefined_fn`).
        is_lit_true := _is_atom_value(cond_expr, "true");
        is_lit_false := _is_atom_value(cond_expr, "false");
        cond(
          is_lit_true => call_gen_expr(body_expr, ctx, indent),
          is_lit_false => Option(String).Some(rest),
          true => {
            c_opt := call_gen_expr(cond_expr, ctx, indent);
            b_opt := call_gen_expr(body_expr, ctx, indent);
            match(
              c_opt,
              .None => Option(String).None,
              .Some(c) => match(
                b_opt,
                .None => Option(String).None,
                .Some(b) => {
                  result := String.from("(");
                  result.push_string(c);
                  result.push_str(" ? ");
                  result.push_string(b);
                  result.push_str(" : ");
                  result.push_string(rest);
                  result.push_str(")");
                  Option(String).Some(result)
                }
              )
            )
          }
        )
      }
    )
  )
});
/// Generate a `cond(arm1, arm2, …)` expression as a right-nested C ternary,
/// or as a series of `if / else if / else` statements when any arm body is
/// a statement-level construct (continue, break, return, or a begin block
/// ending with one of those).
///
/// Ternary path: built right-to-left; last arm becomes the else branch.
/// If-else path: emitted left-to-right as `if (c1) { b1; } else if (c2) { b2; } …`.
handle_cond :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  cond(
    (n == usize(0)) =>.Some(String.from("0")),
    true => {
      // Check if any arm body requires statement-level emission.
      has_stmt_body := {
        (k : usize) = usize(0);
        (found : bool) = false;
        while(runtime((k < n) && (!(found))), {
          match(
            args.get(k),
            .None => (),
            .Some(arm) => match(
              get_arm_args(arm),
              .None => (),
              .Some(arm_args) => match(
                arm_args.get(usize(1)),
                .None => (),
                .Some(body_expr) => {
                  found = is_stmt_body_expr(body_expr);
                }
              )
            )
          );
          k = (k + usize(1));
        });
        found
      };
      cond(
        has_stmt_body => emit_cond_as_if_else(args, ctx, indent),
        true => {
          // Build right-to-left, starting from the last arm's body as the default.
          last_arm_opt := args.get(n - usize(1));
          (acc : Option(String)) = match(
            last_arm_opt,
            .None => Option(String).None,
            .Some(last_arm) => match(
              get_arm_args(last_arm),
              .None => Option(String).None,
              .Some(la) => match(
                la.get(usize(1)),
                .None => Option(String).None,
                .Some(body) => call_gen_expr(body, ctx, indent)
              )
            )
          );
          (i : usize) = cond(
            (n > usize(1)) => (n - usize(2)),
            true => usize(0)
          );
          (done : bool) = (n <= usize(1));
          while(runtime(!(done)), {
            match(
              acc,
              .None => {
                done = true;
              },
              .Some(rest_str) => {
                match(
                  args.get(i),
                  .None => {
                    done = true;
                  },
                  .Some(arm) => {
                    match(
                      get_arm_args(arm),
                      .None => {
                        done = true;
                      },
                      .Some(arm_args) => {
                        acc = gen_cond_arm(arm_args, rest_str, ctx, indent);
                      }
                    );
                  }
                );
                cond(
                  (i == usize(0)) => {
                    done = true;
                  },
                  true => {
                    i = (i - usize(1));
                  }
                )
              }
            );
          });
          acc
        }
      )
    }
  )
});
/// True if `expr` is a `|`-pattern: `FnCall(Atom('|'), [left, right], infix=true)`.
_is_or_pattern :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, pf, pargs, pinfix, _) => cond(
      (!(pinfix)) => false,
      (pargs.len() != usize(2)) => false,
      true => match(
        pf.*,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, pftok) => (pftok.value.as_str() == "|")
      )
    )
  )
);
/// Build a C boolean condition for a single match arm pattern.
/// For simple patterns (not `|`): `(scrut_temp == pattern)`.
/// For or-patterns `(a | b)`: `((scrut_temp == a) || (scrut_temp == b))`.
_build_match_condition :: (
  fn(
    pat_expr : AstExpr,
    scrut_temp : String,
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)(
  cond(
    _is_or_pattern(pat_expr) => match(
      pat_expr,
      .Atom(_, _) => Option(String).None,
      .FnCall(_, _, pargs, _, _) => match(
        pargs.get(usize(0)),
        .None => Option(String).None,
        .Some(left) => match(
          pargs.get(usize(1)),
          .None => Option(String).None,
          .Some(right) => match(
            recur(left, scrut_temp, ctx, indent),
            .None => Option(String).None,
            .Some(left_cond) => match(
              recur(right, scrut_temp, ctx, indent),
              .None => Option(String).None,
              .Some(right_cond) => {
                oc := String.from("(");
                oc.push_string(left_cond);
                oc.push_str(" || ");
                oc.push_string(right_cond);
                oc.push_str(")");
                .Some(oc)
              }
            )
          )
        )
      )
    ),
    true => match(
      call_gen_expr(pat_expr, ctx, indent),
      .None => Option(String).None,
      .Some(p) => {
        ec := String.from("(");
        ec.push_string(scrut_temp);
        ec.push_str(" == ");
        ec.push_string(p);
        ec.push_str(")");
        .Some(ec)
      }
    )
  )
);
/// Generate a single `match` arm as: `(condition ? body : rest)`.
/// Wildcard pattern `_` skips the condition: returns body directly.
/// Or-patterns `(a | b)` expand to `((scrut == a) || (scrut == b))`.
gen_match_arm :: (
  fn(
    arm_args : ArrayList(AstExpr),
    scrut_temp : String,
    rest : String,
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  pat_opt := arm_args.get(usize(0));
  body_opt := arm_args.get(usize(1));
  match(
    pat_opt,
    .None => Option(String).None,
    .Some(pat_expr) => match(
      body_opt,
      .None => Option(String).None,
      .Some(body_expr) => {
        is_wild := match(
          pat_expr,
          .Atom(_, ptok) => (ptok.value.as_str() == "_"),
          .FnCall(_, _, _, _, _) => false
        );
        match(
          call_gen_expr(body_expr, ctx, indent),
          .None => Option(String).None,
          .Some(b) => cond(
            is_wild =>.Some(b),
            true => match(
              _build_match_condition(pat_expr, scrut_temp, ctx, indent),
              .None => Option(String).None,
              .Some(condition) => {
                result := String.from("(");
                result.push_string(condition);
                result.push_str(" ? ");
                result.push_string(b);
                result.push_str(" : ");
                result.push_string(rest);
                result.push_str(")");
                .Some(result)
              }
            )
          )
        )
      }
    )
  )
});
/// Generate a `match(scrut, pat => body, ...)` expression as a ternary chain.
///
/// The scrutinee is emitted into a `__auto_type` temp variable first to
/// avoid repeated evaluation. Arms are processed right-to-left into a nested
/// ternary: `(temp == pat1 ? b1 : (temp == pat2 ? b2 : ... default))`.
/// Emit `match(scrut, arm1, arm2, …)` as C `if / else if / else` statements.
///
/// Used when one or more arm bodies contain statement-level constructs
/// (`continue`, `break`, `return`) that are invalid inside a C ternary.
///
/// Emits side effects into `ctx.emitter` and returns `Some("0")` as unit sentinel.
emit_match_value_as_if_else :: (
  fn(
    scrut_temp : String,
    arms : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  n := arms.len();
  inner := String.from(indent.as_str());
  inner.push_str("  ");
  (i : usize) = usize(0);
  (ok : bool) = true;
  while(runtime((i < n) && ok), {
    match(
      arms.get(i),
      .None => {
        ok = false;
      },
      .Some(arm) => match(
        get_arm_args(arm),
        .None => {
          ok = false;
        },
        .Some(arm_args) => match(
          arm_args.get(usize(0)),
          .None => {
            ok = false;
          },
          .Some(pat_expr) => match(
            arm_args.get(usize(1)),
            .None => {
              ok = false;
            },
            .Some(body_expr) => {
              is_first := (i == usize(0));
              is_last := (i == (n - usize(1)));
              is_wild := _is_atom_value(pat_expr, "_");
              cond(
                // Wildcard `_` → else { body }
                is_wild => {
                  ctx.*.emitter.emit(" else {\n");
                  match(
                    call_gen_expr(body_expr, ctx, inner),
                    .None => (),
                    .Some(bs) => {
                      emit_as_stmt(bs, ctx, inner);
                    }
                  );
                  ctx.*.emitter.emit_string(indent);
                  ctx.*.emitter.emit("}\n");
                },
                // Regular arm → if (temp == pat) { body } or } else if (temp == pat) {
                true =>
                  match(
                    call_gen_expr(pat_expr, ctx, indent),
                    .None => {
                      ok = false;
                    },
                    .Some(pat_code) => {
                      cond(
                        is_first => {
                          ctx.*.emitter.emit_string(indent);
                          ctx.*.emitter.emit("if ((");
                        },
                        true => {
                          ctx.*.emitter.emit(" else if ((");
                        }
                      );
                      ctx.*.emitter.emit_string(scrut_temp);
                      ctx.*.emitter.emit(" == ");
                      ctx.*.emitter.emit_string(pat_code);
                      ctx.*.emitter.emit(")) {\n");
                      match(
                        call_gen_expr(body_expr, ctx, inner),
                        .None => (),
                        .Some(bs) => {
                          emit_as_stmt(bs, ctx, inner);
                        }
                      );
                      ctx.*.emitter.emit_string(indent);
                      cond(
                        is_last => {
                          ctx.*.emitter.emit("}\n");
                        },
                        true => {
                          ctx.*.emitter.emit("}");
                        }
                      );
                    }
                  )
              );
            }
          )
        )
      )
    );
    i = (i + usize(1));
  });
  cond(
    ok =>.Some(String.from("0")),
    true => Option(String).None
  )
});
/// A `_` wildcard arm becomes the default (outermost else).
///
/// Only handles simple value patterns. Data-enum arms (`.Variant(bindings)`)
/// are not yet supported and fall through to `None`.
handle_match_value :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  cond(
    (n < usize(2)) => Option(String).None,
    true => {
      scrut_opt := args.get(usize(0));
      match(
        scrut_opt,
        .None => Option(String).None,
        .Some(scrut_expr) => match(
          call_gen_expr(scrut_expr, ctx, indent),
          .None => Option(String).None,
          .Some(scrut_code) => {
            // Emit scrutinee into a temp to avoid re-evaluation
            temp := ctx.*.fresh_temp();
            ctx.*.emitter.emit_string(indent);
            ctx.*.emitter.emit("__auto_type ");
            ctx.*.emitter.emit_string(temp);
            ctx.*.emitter.emit(" = ");
            ctx.*.emitter.emit_string(scrut_code);
            ctx.*.emitter.emit_line(";");
            // Check if any arm body requires statement-level emission.
            arm_count := (n - usize(1));
            has_stmt := {
              (k : usize) = usize(1);
              (found : bool) = false;
              while(runtime((k < n) && (!(found))), {
                match(
                  args.get(k),
                  .None => (),
                  .Some(arm) => match(
                    get_arm_args(arm),
                    .None => (),
                    .Some(arm_args) => match(
                      arm_args.get(usize(1)),
                      .None => (),
                      .Some(body_expr) => {
                        found = is_stmt_body_expr(body_expr);
                      }
                    )
                  )
                );
                k = (k + usize(1));
              });
              found
            };
            cond(
              has_stmt => {
                // Build arm list from args[1..]
                arms := ArrayList(AstExpr).new();
                (k : usize) = usize(1);
                while(runtime(k < n), {
                  match(
                    args.get(k),
                    .None => (),
                    .Some(arm) => {
                      _r := arms.push(arm);
                      ()
                    }
                  );
                  k = (k + usize(1));
                });
                emit_match_value_as_if_else(temp, arms, ctx, indent)
              },
              true => {
                // Build ternary chain right-to-left (arms are args[1..])
                last_arm_opt := args.get(n - usize(1));
                (acc : Option(String)) = match(
                  last_arm_opt,
                  .None => Option(String).None,
                  .Some(last_arm) => match(
                    get_arm_args(last_arm),
                    .None => Option(String).None,
                    .Some(la) => match(
                      la.get(usize(1)),
                      .None => Option(String).None,
                      .Some(body) => call_gen_expr(body, ctx, indent)
                    )
                  )
                );
                (i : usize) = cond(
                  (arm_count > usize(1)) => (arm_count - usize(2)),
                  true => usize(0)
                );
                (done : bool) = (arm_count <= usize(1));
                while(runtime(!(done)), {
                  match(
                    acc,
                    .None => {
                      done = true;
                    },
                    .Some(rest_str) => {
                      match(
                        args.get(i + usize(1)),
                        .None => {
                          done = true;
                        },
                        .Some(arm) => {
                          match(
                            get_arm_args(arm),
                            .None => {
                              done = true;
                            },
                            .Some(arm_args) => {
                              acc = gen_match_arm(arm_args, temp, rest_str, ctx, indent);
                            }
                          );
                        }
                      );
                      cond(
                        (i == usize(0)) => {
                          done = true;
                        },
                        true => {
                          i = (i - usize(1));
                        }
                      )
                    }
                  );
                });
                acc
              }
            )
          }
        )
      )
    }
  )
});
/// Split a comma-separated string like "r" or "w,h" into an ArrayList of field name Strings.
_split_csv :: (fn(csv : str) -> ArrayList(String))({
  parts := ArrayList(String).new();
  n := csv.len();
  base_ptr := csv.ptr();
  (i : usize) = usize(0);
  (start : usize) = usize(0);
  while(runtime(i <= n), {
    is_sep := cond(
      (i == n) => true,
      true => (csv.bytes(i) == u8(44)) // 44 = ','
    );
    if(is_sep, {
      seg_len := (i - start);
      if(seg_len > usize(0), {
        seg_ptr := (base_ptr &+ start);
        part := str.from_raw_parts(seg_ptr, seg_len);
        _r := parts.push(String.from(part));
        ()
      });
      start = (i + usize(1));
    });
    i = (i + usize(1));
  });
  parts
});
/// Extract DataArm info from a single match arm pattern expression.
///
/// Returns `(tag_const, bindings)`:
/// - `tag_const` is empty for wildcard arms; otherwise "EnumName_VariantName".
/// - `bindings` is a list of (var_name, field_path, type_c) for data bindings.
///
/// Supported pattern forms:
/// - `Atom('_')` — wildcard → ("", [])
/// - `FnCall(Atom('.'), [Atom(V)])` — unit dot variant → ("EnumName_V", [])
/// - `FnCall(FnCall(Atom('.'), [Atom(V)]), [bindings...])` — data variant
///   - Each binding is `Atom(local_name)` (positional) or
///     `FnCall(Atom(':'), [Atom(field_name), Atom(local_name)], infix=true)` (labeled).
_extract_data_arm :: (
  fn(
    pat_expr : AstExpr,
    variant_name_out : *(String),
    bindings_out : *(ArrayList(DataBinding)),
    ctx : *(CodegenContext)
  ) -> String
)({
  // Case 1: wildcard `_`
  is_wild := match(
    pat_expr,
    .Atom(_, wtok) => (wtok.value.as_str() == "_"),
    .FnCall(_, _, _, _, _) => false
  );
  cond(
    is_wild => String.new(),
    // Case 2: bare dot variant `.V`  or  data variant `.V(bindings...)`
    true => match(
      pat_expr,
      .Atom(_, _) => String.new(),
      .FnCall(_, pat_func, pat_args, pat_infix, _) => cond(
        pat_infix => String.new(),
        // Case 2a: `.V` — unit dot variant: FnCall(Atom('.'), [Atom('V')], infix=false)
        match(
          pat_func.*,
          .Atom(_, pfatom) => (pfatom.kind == TokenKind.Dot),
          .FnCall(_, _, _, _, _) => false
        ) => match(
          pat_args.get(usize(0)),
          .None => String.new(),
          .Some(variant_atom) => match(
            variant_atom,
            .FnCall(_, _, _, _, _) => String.new(),
            .Atom(_, vatom) => match(
              ctx.*.get_enum_for_variant(vatom.value.as_str()),
              .None => String.new(),
              .Some(enum_name) => {
                variant_name_out.* = vatom.value;
                result := String.new();
                result.push_string(enum_name);
                result.push_str("_");
                result.push_string(vatom.value);
                result
              }
            )
          )
        ),
        // Case 2b: `.V(bindings...)` — data variant:
        // FnCall(func=FnCall(Atom('.'), [Atom('V')], infix=false), args=[...], infix=false)
        match(
          pat_func.*,
          .Atom(_, _) => false,
          .FnCall(_, inner_func, inner_args, inner_infix, _) => cond(
            inner_infix => false,
            (inner_args.len() != usize(1)) => false,
            true => match(
              inner_func.*,
              .FnCall(_, _, _, _, _) => false,
              .Atom(_, ifatom) => (ifatom.kind == TokenKind.Dot)
            )
          )
        ) => match(
          pat_func.*,
          .Atom(_, _) => String.new(),
          .FnCall(_, _, inner_args2, _, _) => match(
            inner_args2.get(usize(0)),
            .None => String.new(),
            .Some(variant_atom2) => match(
              variant_atom2,
              .FnCall(_, _, _, _, _) => String.new(),
              .Atom(_, vatom2) => match(
                ctx.*.get_enum_for_variant(vatom2.value.as_str()),
                .None => String.new(),
                .Some(enum_name2) => {
                  variant_name_out.* = vatom2.value;
                  // Build tag constant (owned String — no dangling pointer risk)
                  tag := String.new();
                  tag.push_string(enum_name2);
                  tag.push_str("_");
                  tag.push_string(vatom2.value);
                  // Build bindings from pat_args
                  fields_csv_opt := ctx.*.get_variant_fields(enum_name2.as_str(), vatom2.value.as_str());
                  fields := match(
                    fields_csv_opt,
                    .None => ArrayList(String).new(),
                    .Some(fcsv) => _split_csv(fcsv.as_str())
                  );
                  nba := pat_args.len();
                  (bi : usize) = usize(0);
                  while(runtime(bi < nba), {
                    match(
                      pat_args.get(bi),
                      .None => (),
                      .Some(barg) => {
                        match(
                          barg,
                          // Positional binding: Atom(local_name)
                          .Atom(_, batom) => cond(
                            (batom.value.as_str() == "_") => (),
                            // wildcard, skip
                            true => match(
                              fields.get(bi),
                              .None => (),
                              .Some(field_name) => {
                                path := String.from("data.");
                                path.push_string(vatom2.value);
                                path.push_str(".");
                                path.push_string(field_name);
                                db := DataBinding(
                                  var_name : batom.value,
                                  field_path : path,
                                  type_c : String.from("__auto_type")
                                );
                                _rr := bindings_out.*.push(db);
                                ();
                              }
                            )
                          ),
                          // Labeled binding: `field_name : local_name` (infix ':')
                          .FnCall(_, bfunc, bargs, binfix, _) => cond(
                            // Curly shorthand: `_(field1, field2, ...)` or `_(field: alias, ...)`
                            // Each inner arg is either:
                            //   Atom("name")       → bind field "name" as var "name"
                            //   FnCall(":", [field, alias]) → bind field as alias
                            //   FnCall(":", [field, _])    → wildcard, skip
                            (
                              (!(binfix)) && match(
                                bfunc.*,
                                .Atom(_, cftok) => (cftok.value.as_str() == BK_ANON_STRUCT),
                                .FnCall(_, _, _, _, _) => false
                              )
                            ) => {
                              nc := bargs.len();
                              (ci : usize) = usize(0);
                              while(runtime(ci < nc), {
                                match(
                                  bargs.get(ci),
                                  .None => (),
                                  .Some(ci_arg) => match(
                                    ci_arg,
                                    // Bare atom: `width` → bind field "width" as var "width"
                                    .Atom(_, ci_atm) => cond(
                                      (ci_atm.value.as_str() == "_") => (),
                                      true => {
                                        path_c := String.from("data.");
                                        path_c.push_string(vatom2.value);
                                        path_c.push_str(".");
                                        path_c.push_string(ci_atm.value);
                                        db_c := DataBinding(
                                          var_name : ci_atm.value,
                                          field_path : path_c,
                                          type_c : String.from("__auto_type")
                                        );
                                        _rc := bindings_out.*.push(db_c);
                                        ();
                                      }
                                    ),
                                    // Labeled: `field: alias` or `field: _`
                                    .FnCall(_, lb_func, lb_args, lb_infix, _) => cond(
                                      (!(lb_infix)) => (),
                                      (lb_args.len() < usize(2)) => (),
                                      (
                                        !(
                                          match(
                                            lb_func.*,
                                            .Atom(_, lbtok) => (lbtok.value.as_str() == ":"),
                                            .FnCall(_, _, _, _, _) => false
                                          )
                                        )
                                      ) => (),
                                      true => match(
                                        lb_args.get(usize(0)),
                                        .None => (),
                                        .Some(f_e) => match(
                                          lb_args.get(usize(1)),
                                          .None => (),
                                          .Some(v_e) => match(
                                            f_e,
                                            .FnCall(_, _, _, _, _) => (),
                                            .Atom(_, f_tok) => match(
                                              v_e,
                                              .FnCall(_, _, _, _, _) => (),
                                              .Atom(_, v_tok) => cond(
                                                (v_tok.value.as_str() == "_") => (),
                                                true => {
                                                  path_l := String.from("data.");
                                                  path_l.push_string(vatom2.value);
                                                  path_l.push_str(".");
                                                  path_l.push_string(f_tok.value);
                                                  db_l := DataBinding(
                                                    var_name : v_tok.value,
                                                    field_path : path_l,
                                                    type_c : String.from("__auto_type")
                                                  );
                                                  _rl := bindings_out.*.push(db_l);
                                                  ();
                                                }
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                );
                                ci = (ci + usize(1));
                              });
                            },
                            (!(binfix)) => (),
                            (bargs.len() < usize(2)) => (),
                            (
                              !(
                                match(
                                  bfunc.*,
                                  .Atom(_, bfatom) => (bfatom.value.as_str() == ":"),
                                  .FnCall(_, _, _, _, _) => false
                                )
                              )
                            ) => (),
                            true => match(
                              bargs.get(usize(0)),
                              .None => (),
                              .Some(field_expr) => match(
                                bargs.get(usize(1)),
                                .None => (),
                                .Some(local_expr) => match(
                                  field_expr,
                                  .FnCall(_, _, _, _, _) => (),
                                  .Atom(_, fnatom) => match(
                                    local_expr,
                                    .FnCall(_, _, _, _, _) => (),
                                    .Atom(_, lnatom) => cond(
                                      (lnatom.value.as_str() == "_") => (),
                                      // wildcard, skip
                                      true => {
                                        path2 := String.from("data.");
                                        path2.push_string(vatom2.value);
                                        path2.push_str(".");
                                        path2.push_string(fnatom.value);
                                        db2 := DataBinding(
                                          var_name : lnatom.value,
                                          field_path : path2,
                                          type_c : String.from("__auto_type")
                                        );
                                        _rr2 := bindings_out.*.push(db2);
                                        ();
                                      }
                                    )
                                  )
                                )
                              )
                            )
                          )
                        );
                      }
                    );
                    bi = (bi + usize(1));
                  });
                  tag
                }
              )
            )
          )
        ),
        true => String.new()
      )
    )
  )
});
/// True if the match arm pattern is a data-enum arm (`.Variant(bindings...)`).
_is_data_arm_pattern :: (fn(pat_expr : AstExpr) -> bool)(
  match(
    pat_expr,
    .Atom(_, _) => false,
    .FnCall(_, pat_func, _, pat_infix, _) => cond(
      pat_infix => false,
      // .V(bindings...) form: outer func is FnCall(Atom('.'), [V])
      match(
        pat_func.*,
        .Atom(_, _) => false,
        .FnCall(_, inner_func, inner_args, inner_infix, _) => cond(
          inner_infix => false,
          (inner_args.len() != usize(1)) => false,
          true => match(
            inner_func.*,
            .FnCall(_, _, _, _, _) => false,
            .Atom(_, ifatom) => (ifatom.kind == TokenKind.Dot)
          )
        )
      ) => true,
      true => false
    )
  )
);
data_arm_variant_name :: (fn(pat_expr : AstExpr) -> Option(String))(
  match(
    pat_expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, pat_func, _, pat_infix, _) => cond(
      pat_infix => Option(String).None,
      true => match(
        pat_func.*,
        .Atom(_, _) => Option(String).None,
        .FnCall(_, inner_func, inner_args, inner_infix, _) => cond(
          inner_infix => Option(String).None,
          (inner_args.len() != usize(1)) => Option(String).None,
          true => match(
            inner_func.*,
            .FnCall(_, _, _, _, _) => Option(String).None,
            .Atom(_, dot_tok) => cond(
              (dot_tok.kind != TokenKind.Dot) => Option(String).None,
              true => match(
                inner_args.get(usize(0)),
                .None => Option(String).None,
                .Some(variant_expr) => match(
                  variant_expr,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, variant_tok) => Option(String).Some(variant_tok.value)
                )
              )
            )
          )
        )
      )
    )
  )
);
emit_simplified_some_bindings :: (
  fn(pat_expr : AstExpr, scrut_code : String, ctx : *(CodegenContext), indent : String) -> unit
)(
  match(
    pat_expr,
    .Atom(_, _) => (),
    .FnCall(_, pat_func, pat_args, pat_infix, _) => cond(
      pat_infix => (),
      true => match(
        pat_func.*,
        .Atom(_, _) => (),
        .FnCall(_, _, _, _, _) => {
          n := pat_args.len();
          (i : usize) = usize(0);
          while(runtime(i < n), {
            match(
              pat_args.get(i),
              .None => (),
              .Some(binding_expr) => match(
                binding_expr,
                .FnCall(_, _, _, _, _) => (),
                .Atom(_, binding_tok) => cond(
                  (binding_tok.value.as_str() == "_") => (),
                  true => {
                    ctx.*.emitter.emit_string(indent);
                    ctx.*.emitter.emit("__auto_type ");
                    ctx.*.emitter.emit_string(sanitize_c_ident(binding_tok.value.as_str()));
                    ctx.*.emitter.emit(" = ");
                    ctx.*.emitter.emit_string(scrut_code);
                    ctx.*.emitter.emit_line(";");
                  }
                )
              )
            );
            i = (i + usize(1));
          });
        }
      )
    )
  )
);
/// True if `expr` is `match(scrut, ...)` where any arm pattern is `.Variant(bindings...)`.
/// Used to decide whether to use `generate_match_data` instead of ternary chains.
_has_data_arm :: (fn(args : ArrayList(AstExpr)) -> bool)({
  n := args.len();
  (i : usize) = usize(1);
  (found : bool) = false;
  while(runtime((i < n) && (!(found))), {
    match(
      args.get(i),
      .None => (),
      .Some(arm_expr) => match(
        get_arm_args(arm_expr),
        .None => (),
        .Some(arm_args) => match(
          arm_args.get(usize(0)),
          .None => (),
          .Some(pat_expr) => {
            if(_is_data_arm_pattern(pat_expr), {
              found = true;
            });
          }
        )
      )
    );
    i = (i + usize(1));
  });
  found
});
/// Generate a `match(scrut, .Var(f) => body, ...)` expression using a C switch
/// on the tagged union's `.tag` field.
///
/// Used when any arm uses the `.Variant(bindings)` destructuring form.
/// Simple arms (`.Variant` or `_`) are also handled within the same switch.
///
/// Returns the temp variable name holding the result, or `None` on failure.
handle_match_data :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  cond(
    (n < usize(2)) => Option(String).None,
    true => match(
      args.get(usize(0)),
      .None => Option(String).None,
      .Some(scrut_expr) => match(
        call_gen_expr(scrut_expr, ctx, indent),
        .None => Option(String).None,
        .Some(scrut_code) => {
          // If scrutinee is a pointer variable, auto-deref for the switch.
          // We detect this by checking if the scrutinee variable has a registered
          // type ending in '*'.
          scrut_c := match(
            ctx.*.get_var_type(scrut_code.as_str()),
            .None => scrut_code,
            .Some(vtype) => {
              len := vtype.len();
              is_ptr := cond(
                (len == usize(0)) => false,
                true => match(
                  vtype.at(len - usize(1)),
                  .None => false,
                  .Some(r) => (r.char == u32(42)) // 42 = ASCII '*'
                )
              );
              cond(
                is_ptr => {
                  deref := String.from("(*");
                  deref.push_string(scrut_code);
                  deref.push_str(")");
                  deref
                },
                true => scrut_code
              )
            }
          );
          can_simplify_some_match := match(
            ctx.*.get_var_type(scrut_code.as_str()),
            .None => true,
            .Some(vt) => (vt.as_str() == "__auto_type")
          );
          simplified_some_body := {
            (si : usize) = usize(1);
            (found_some : Option(AstExpr)) = Option(AstExpr).None;
            while(runtime(can_simplify_some_match && ((si < n) && found_some.is_none())), {
              match(
                args.get(si),
                .None => (),
                .Some(arm_expr2) => match(
                  get_arm_args(arm_expr2),
                  .None => (),
                  .Some(arm_args2) => match(
                    arm_args2.get(usize(0)),
                    .None => (),
                    .Some(pat_expr2) => match(
                      data_arm_variant_name(pat_expr2),
                      .None => (),
                      .Some(vn) => cond(
                        (vn.as_str() != "Some") => (),
                        true => match(
                          arm_args2.get(usize(1)),
                          .None => (),
                          .Some(body_expr2) => {
                            emit_simplified_some_bindings(pat_expr2, scrut_c, ctx, indent);
                            found_some = Option(AstExpr).Some(body_expr2);
                          }
                        )
                      )
                    )
                  )
                )
              );
              si = (si + usize(1));
            });
            found_some
          };
          match(
            simplified_some_body,
            .Some(body_expr3) => {
              body_code := call_gen_expr(body_expr3, ctx, indent);
              match(
                body_code,
                .None => Option(String).Some(String.from("0")),
                .Some(body_c) => Option(String).Some(body_c)
              )
            },
            .None => {
              temp := ctx.*.fresh_temp();
              data_arms := ArrayList(DataArm).new();
              (i : usize) = usize(1);
              while(runtime(i < n), {
                match(
                  args.get(i),
                  .None => (),
                  .Some(arm_expr) => match(
                    get_arm_args(arm_expr),
                    .None => (),
                    .Some(arm_args) => match(
                      arm_args.get(usize(0)),
                      .None => (),
                      .Some(pat_expr) => {
                        variant_name_buf := String.new();
                        bindings := ArrayList(DataBinding).new();
                        tag_const_str := _extract_data_arm(pat_expr, &(variant_name_buf), &(bindings), ctx);
                        body_expr_opt := arm_args.get(usize(1));
                        match(
                          body_expr_opt,
                          .None => (),
                          .Some(body_expr) => {
                            arm := DataArm(
                              tag_const : tag_const_str,
                              bindings : bindings,
                              body : body_expr
                            );
                            _r := data_arms.push(arm);
                            ();
                          }
                        );
                      }
                    )
                  )
                );
                i = (i + usize(1));
              });
              generate_match_data(
                scrut_c.as_str(),
                "int32_t",
                temp.as_str(),
                data_arms,
                call_gen_expr,
                ctx,
                indent.as_str()
              );
              .Some(temp)
            }
          )
        }
      )
    )
  )
});
///
/// Emits a C `while` loop into `ctx.emitter` and returns `"0"` (void result).
/// Convert a `while` step expression to a C expression string.
///
/// For a `begin(e0, e1, …)` step (multi-step), produce a C comma expression
/// `(e0, e1, …)`.  Each element is converted WITHOUT letting `handle_begin`
/// emit them as side-effect statements — crucial because begin-block handling
/// normally emits intermediate statements directly to the emitter.
///
/// For any other step expression, just call `call_gen_expr` normally.
step_to_c_expr :: (
  fn(
    step_expr : AstExpr,
    ctx : *(CodegenContext),
    indent : String
  ) -> String
)({
  // This first statement ensures the body is a begin block, not a struct literal.
  is_begin_step := match(
    step_expr,
    .Atom(_, _) => false,
    .FnCall(_, sf, _, _, _) => match(
      sf.*,
      .FnCall(_, _, _, _, _) => false,
      .Atom(_, stok) => (stok.value.as_str() == BK_BEGIN)
    )
  );
  cond(
    is_begin_step => match(
      step_expr,
      .Atom(_, _) => String.from("0"),
      .FnCall(_, _, sargs, _, _) => {
        // Build comma-joined C expression directly from begin block elements,
        // bypassing handle_begin to avoid premature side-effect emission.
        sn := sargs.len();
        cond(
          (sn == usize(0)) => String.from("0"),
          true => {
            result_s := String.new();
            (k : usize) = usize(0);
            (first : bool) = true;
            while(runtime(k < sn), {
              match(
                sargs.get(k),
                .None => (),
                .Some(se) => {
                  // Skip tuple() / _() unit sentinels
                  is_unit_sentinel := match(
                    se,
                    .Atom(_, _) => false,
                    .FnCall(_, sef, seargs, _, _) => match(
                      sef.*,
                      .FnCall(_, _, _, _, _) => false,
                      .Atom(_, setok) => (
                        ((setok.value.as_str() == BK_TUPLE) || (setok.value.as_str() == BK_ANON_STRUCT)) && (seargs.len() == usize(0))
                      )
                    )
                  );
                  if(!(is_unit_sentinel), {
                    match(
                      call_gen_expr(se, ctx, indent),
                      .None => (),
                      .Some(se_code) => {
                        if(!(first), {
                          result_s.push_str(", ");
                        });
                        result_s.push_string(se_code);
                        first = false;
                      }
                    );
                  });
                }
              );
              k = (k + usize(1));
            });
            cond(
              (result_s.len() == usize(0)) => String.from("0"),
              true => result_s
            )
          }
        )
      }
    ),
    true => match(
      call_gen_expr(step_expr, ctx, indent),
      .None => String.from("0"),
      .Some(s) => s
    )
  )
});
/// Handle `for iter_expr, (param) => { body }` — iterator for-loop macro.
///
/// In the Yo language, `for` is a macro that expands to:
///   iter_var := iter_expr;
///   while runtime(true), {
///     temp := &iter_var.next();
///     match(temp, .Some(param) => body, .None => { break; })
///   }
///
/// In the prototype codegen:
/// - If `iter_expr` is `(&arr_var).iter()` where `arr_var` is a registered C array,
///   emit a direct C `for` loop: `for (size_t _i = 0; _i < N; _i++) { T* param = &arr[_i]; body }`.
/// - Otherwise, fall through to emitting a `while(1)` loop calling `.next()`.
handle_for :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  (nargs : usize) = args.len();
  cond(
    (nargs != usize(2)) => Option(String).None,
    true => match(
      args.get(usize(0)),
      .None => Option(String).None,
      .Some(iter_expr) => match(
        args.get(usize(1)),
        .None => Option(String).None,
        .Some(handle_expr) => {
          // Destructure handle: should be `(param) => { body }` — infix `=>` with 2 args
          handle_opt := match(
            handle_expr,
            .Atom(_, _) => Option(String).None,
            .FnCall(_, hfn, hargs, hinfix, _) => cond(
              (!(hinfix)) => Option(String).None,
              (hargs.len() != usize(2)) => Option(String).None,
              true => match(
                hfn.*,
                .FnCall(_, _, _, _, _) => Option(String).None,
                .Atom(_, htok) => cond(
                  (htok.value.as_str() != "=>") => Option(String).None,
                  true => Option(String).Some(String.from("ok"))
                )
              )
            )
          );
          match(
            handle_opt,
            .None => Option(String).None,
            .Some(_) => match(
              handle_expr,
              .Atom(_, _) => Option(String).None,
              .FnCall(_, _, hargs2, _, _) => {
                param_expr_opt := hargs2.get(usize(0));
                body_expr_opt := hargs2.get(usize(1));
                // Extract param name
                param_name_opt := match(
                  param_expr_opt,
                  .None => Option(String).None,
                  .Some(pe) => match(
                    pe,
                    .FnCall(_, _, _, _, _) => Option(String).None,
                    .Atom(_, ptok) => cond(
                      (ptok.kind != TokenKind.Identifier) => Option(String).None,
                      true => Option(String).Some(ptok.value)
                    )
                  )
                );
                // Try to detect `(&arr_var).iter()` pattern for array iteration
                // `(&arr_var)` = FnCall(Atom("*"?), no wait — `&arr_var` = FnCall(Atom("&"), [arr_var])
                // `(&arr_var).iter()` = method call on `(&arr_var)` with method `iter`
                // After parsing: FnCall(FnCall(Atom("."), [&arr_var, "iter"]), [], ...)
                // Detect: iter_expr is a method call `.iter()` with no args on `(&arr_var)`
                arr_iter_name_opt := match(
                  iter_expr,
                  .Atom(_, _) => Option(String).None,
                  .FnCall(_, iter_fn, iter_args, _, _) => cond(
                    (iter_args.len() != usize(0)) => Option(String).None,
                    true => match(
                      iter_fn.*,
                      .Atom(_, _) => Option(String).None,
                      .FnCall(_, dot_fn, dot_args, dot_infix, _) => cond(
                        (!(dot_infix)) => Option(String).None,
                        (dot_args.len() != usize(2)) => Option(String).None,
                        true => match(
                          dot_fn.*,
                          .FnCall(_, _, _, _, _) => Option(String).None,
                          .Atom(_, dtok) => cond(
                            (dtok.value.as_str() != ".") => Option(String).None,
                            true => match(
                              dot_args.get(usize(1)),
                              .None => Option(String).None,
                              .Some(method_e) => match(
                                method_e,
                                .FnCall(_, _, _, _, _) => Option(String).None,
                                .Atom(_, mtok) => cond(
                                  (mtok.value.as_str() != "iter") => Option(String).None,
                                  true =>
                                    // Receiver is dot_args[0]: should be `&arr_var`
                                    match(
                                      dot_args.get(usize(0)),
                                      .None => Option(String).None,
                                      .Some(recv_e) => match(
                                        recv_e,
                                        .Atom(_, _) => Option(String).None,
                                        .FnCall(_, ref_fn, ref_args, ref_infix, _) => cond(
                                          ref_infix => Option(String).None,
                                          (ref_args.len() != usize(1)) => Option(String).None,
                                          true => match(
                                            ref_fn.*,
                                            .FnCall(_, _, _, _, _) => Option(String).None,
                                            .Atom(_, rftok) => cond(
                                              (rftok.value.as_str() != "&") => Option(String).None,
                                              true => match(
                                                ref_args.get(usize(0)),
                                                .None => Option(String).None,
                                                .Some(arr_name_e) => match(
                                                  arr_name_e,
                                                  .FnCall(_, _, _, _, _) => Option(String).None,
                                                  .Atom(_, antok) => cond(
                                                    (!(ctx.*.is_array_var(antok.value.as_str()) || ctx.*.is_slice_var(antok.value.as_str()))) => Option(String).None,
                                                    true => Option(String).Some(antok.value)
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                );
                inner := {
                  r := String.from(indent.as_str());
                  r.push_str("  ");
                  r
                };
                cond(
                  // Fast path: emit C for loop over array or slice
                  match(arr_iter_name_opt,.Some(_) => true,.None => false) =>
                    match(
                      arr_iter_name_opt,
                      .None => Option(String).None,
                      .Some(arr_name) => match(
                        param_name_opt,
                        .None => Option(String).None,
                        .Some(param_name) => match(
                          body_expr_opt,
                          .None => Option(String).None,
                          .Some(body_expr) => {
                            san_arr := sanitize_c_ident(arr_name.as_str());
                            san_param := sanitize_c_ident(param_name.as_str());
                            iter_var := ctx.*.fresh_temp();
                            ctx.*.emitter.emit_string(indent);
                            ctx.*.emitter.emit("for (size_t ");
                            ctx.*.emitter.emit_string(iter_var);
                            ctx.*.emitter.emit(" = 0; ");
                            ctx.*.emitter.emit_string(iter_var);
                            ctx.*.emitter.emit(" < ");
                            cond(
                              ctx.*.is_slice_var(arr_name.as_str()) => {
                                // slice: use slice.length
                                ctx.*.emitter.emit_string(san_arr);
                                ctx.*.emitter.emit(".length");
                              },
                              true => {
                                // array: use known size constant
                                size_str := match(
                                  ctx.*.get_array_var_size(arr_name.as_str()),
                                  .None => String.from("0"),
                                  .Some(sz) => sz
                                );
                                ctx.*.emitter.emit_string(size_str);
                              }
                            );
                            ctx.*.emitter.emit("; ");
                            ctx.*.emitter.emit_string(iter_var);
                            ctx.*.emitter.emit_line("++) {");
                            ctx.*.emitter.emit_string(inner);
                            ctx.*.emitter.emit("__auto_type* ");
                            ctx.*.emitter.emit_string(san_param);
                            ctx.*.emitter.emit(" = &");
                            ctx.*.emitter.emit_string(san_arr);
                            cond(
                              ctx.*.is_slice_var(arr_name.as_str()) => {
                                ctx.*.emitter.emit(".data[");
                              },
                              true => {
                                ctx.*.emitter.emit("[");
                              }
                            );
                            ctx.*.emitter.emit_string(iter_var);
                            ctx.*.emitter.emit_line("];");
                            match(
                              call_gen_expr(body_expr, ctx, inner),
                              .None => (),
                              .Some(body_code) => emit_as_stmt(body_code, ctx, inner)
                            );
                            ctx.*.emitter.emit_string(indent);
                            ctx.*.emitter.emit_line("}");
                            Option(String).Some(String.from("0"))
                          }
                        )
                      )
                    ),
                  // Fallback: emit while(1) { var = iter.next(); if None break; body }
                  true => match(
                    param_name_opt,
                    .None => Option(String).None,
                    .Some(param_name) => match(
                      body_expr_opt,
                      .None => Option(String).None,
                      .Some(body_expr) => match(
                        call_gen_expr(iter_expr, ctx, indent),
                        .None => Option(String).None,
                        .Some(iter_code) => {
                          san_param := sanitize_c_ident(param_name.as_str());
                          iter_var := ctx.*.fresh_temp();
                          next_var := ctx.*.fresh_temp();
                          // iter_var = iter;
                          ctx.*.emitter.emit_string(indent);
                          ctx.*.emitter.emit("__auto_type ");
                          ctx.*.emitter.emit_string(iter_var);
                          ctx.*.emitter.emit(" = ");
                          ctx.*.emitter.emit_string(iter_code);
                          ctx.*.emitter.emit_line(";");
                          // while (1) { ... }
                          ctx.*.emitter.emit_string(indent);
                          ctx.*.emitter.emit_line("while (1) {");
                          // next_var = iter_var.next()
                          ctx.*.emitter.emit_string(inner);
                          ctx.*.emitter.emit("__auto_type ");
                          ctx.*.emitter.emit_string(next_var);
                          ctx.*.emitter.emit(" = ");
                          ctx.*.emitter.emit_string(iter_var);
                          ctx.*.emitter.emit_line(".next();");
                          // if (next_var.is_none) break;
                          ctx.*.emitter.emit_string(inner);
                          ctx.*.emitter.emit("if (!");
                          ctx.*.emitter.emit_string(next_var);
                          ctx.*.emitter.emit_line(") break;");
                          // param = *next_var  (unwrap Some)
                          ctx.*.emitter.emit_string(inner);
                          ctx.*.emitter.emit("__auto_type ");
                          ctx.*.emitter.emit_string(san_param);
                          ctx.*.emitter.emit(" = ");
                          ctx.*.emitter.emit_string(next_var);
                          ctx.*.emitter.emit_line(";");
                          // body
                          match(
                            call_gen_expr(body_expr, ctx, inner),
                            .None => (),
                            .Some(body_code) => emit_as_stmt(body_code, ctx, inner)
                          );
                          ctx.*.emitter.emit_string(indent);
                          ctx.*.emitter.emit_line("}");
                          Option(String).Some(String.from("0"))
                        }
                      )
                    )
                  )
                )
              }
            )
          )
        }
      )
    )
  )
});
handle_while :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  cond_arg_opt := args.get(usize(0));
  // 3-arg form: while(cond, step, body)   →  for(;cond;step){body}
  // 2-arg form: while(cond, body)         →  while(cond){body}
  has_step := (n >= usize(3));
  step_opt := cond(has_step => args.get(usize(1)), true => Option(AstExpr).None);
  body_arg_opt := cond(has_step => args.get(usize(2)), true => args.get(usize(1)));
  match(
    cond_arg_opt,
    .None => Option(String).None,
    .Some(raw_cond) => {
      // Unwrap `runtime(inner)` or `comptime(inner)` wrapper if present
      cond_expr := match(
        raw_cond,
        .FnCall(_, rt_func, rt_args, _, _) => match(
          rt_func.*,
          .Atom(_, rttok) => cond(
            ((rttok.value.as_str() == "runtime") || (rttok.value.as_str() == "comptime")) => match(
              rt_args.get(usize(0)),
              .Some(inner) => inner,
              .None => raw_cond
            ),
            true => raw_cond
          ),
          .FnCall(_, _, _, _, _) => raw_cond
        ),
        .Atom(_, _) => raw_cond
      );
      match(
        call_gen_expr(cond_expr, ctx, indent),
        .None => Option(String).None,
        .Some(c_cond) => {
          inner := {
            r := String.from(indent.as_str());
            r.push_str("  ");
            r
          };
          cond(
            has_step => {
              // 3-arg: emit `for (;cond;step) { body }` so `continue` executes step
              // Use step_to_c_expr to avoid premature side-effect emission from begin blocks
              step_code := match(
                step_opt,
                .None => String.from("0"),
                .Some(step_expr) => step_to_c_expr(step_expr, ctx, indent)
              );
              ctx.*.emitter.emit_string(indent);
              ctx.*.emitter.emit("for (;");
              ctx.*.emitter.emit_string(c_cond);
              ctx.*.emitter.emit(";");
              ctx.*.emitter.emit_string(step_code);
              ctx.*.emitter.emit_line(") {");
              match(
                body_arg_opt,
                .None => (),
                .Some(body_expr) =>
                  match(
                    call_gen_expr(body_expr, ctx, inner),
                    .None => (),
                    .Some(body_code) => emit_as_stmt(body_code, ctx, inner)
                  )
              );
              ctx.*.emitter.emit_string(indent);
              ctx.*.emitter.emit_line("}");
            },
            true => {
              // 2-arg: emit `while (cond) { body }`
              ctx.*.emitter.emit_string(indent);
              ctx.*.emitter.emit("while (");
              ctx.*.emitter.emit_string(c_cond);
              ctx.*.emitter.emit_line(") {");
              match(
                body_arg_opt,
                .None => (),
                .Some(body_expr) =>
                  match(
                    call_gen_expr(body_expr, ctx, inner),
                    .None => (),
                    .Some(body_code) => emit_as_stmt(body_code, ctx, inner)
                  )
              );
              ctx.*.emitter.emit_string(indent);
              ctx.*.emitter.emit_line("}");
            }
          );
          .Some(String.from("0"))
        }
      )
    }
  )
});
/// Generate `if(cond, then)` or `if(cond, then, else)`.
///
/// When the then- or else-branch is a begin block, a C `if`/`else` statement
/// is emitted into `ctx.emitter` and `"0"` is returned as the expression
/// value.  This is necessary because control-flow keywords like `break`,
/// `continue`, and `return` cannot appear inside a C ternary operand.
///
/// When both branches are simple expressions (no begin block), a C ternary
/// `(cond ? then : else)` is returned instead.
handle_if :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  cond_opt := args.get(usize(0));
  then_opt := args.get(usize(1));
  else_opt := cond(
    (n >= usize(3)) => args.get(usize(2)),
    true => Option(AstExpr).None
  );
  match(
    cond_opt,
    .None => Option(String).None,
    .Some(cond_expr) => match(
      then_opt,
      .None => Option(String).None,
      .Some(then_expr) => {
        then_is_begin := is_begin_block(then_expr);
        else_is_begin := match(
          else_opt,
          .None => false,
          .Some(e) => is_begin_block(e)
        );
        cond(
          // One or both branches is a block: emit a C if/else statement so
          // that break/continue/return fire only when the condition is true.
          (then_is_begin || else_is_begin) => {
            c_opt := call_gen_expr(cond_expr, ctx, indent);
            match(
              c_opt,
              .None => Option(String).None,
              .Some(c) => {
                inner := {
                  r := String.from(indent.as_str());
                  r.push_str("  ");
                  r
                };
                ctx.*.emitter.emit_string(indent);
                ctx.*.emitter.emit("if (");
                ctx.*.emitter.emit_string(c);
                ctx.*.emitter.emit_line(") {");
                match(
                  call_gen_expr(then_expr, ctx, inner),
                  .None => (),
                  .Some(body_code) => emit_as_stmt(body_code, ctx, inner)
                );
                ctx.*.emitter.emit_string(indent);
                ctx.*.emitter.emit("}");
                match(
                  else_opt,
                  .None => ctx.*.emitter.emit_line(""),
                  .Some(else_expr) => {
                    ctx.*.emitter.emit_line(" else {");
                    match(
                      call_gen_expr(else_expr, ctx, inner),
                      .None => (),
                      .Some(else_code) => emit_as_stmt(else_code, ctx, inner)
                    );
                    ctx.*.emitter.emit_string(indent);
                    ctx.*.emitter.emit_line("}");
                  }
                );
                .Some(String.from("0"))
              }
            )
          },
          // Both branches are simple expressions: emit a C ternary.
          true => {
            c_opt := call_gen_expr(cond_expr, ctx, indent);
            t_opt := call_gen_expr(then_expr, ctx, indent);
            else_code := match(
              else_opt,
              .None => String.from("0"),
              .Some(e_ex) => match(
                call_gen_expr(e_ex, ctx, indent),
                .None => String.from("0"),
                .Some(s) => s
              )
            );
            match(
              c_opt,
              .None => Option(String).None,
              .Some(c) => match(
                t_opt,
                .None => Option(String).None,
                .Some(t) => {
                  result := String.from("(");
                  result.push_string(c);
                  result.push_str(" ? ");
                  result.push_string(t);
                  result.push_str(" : ");
                  result.push_string(else_code);
                  result.push_str(")");
                  .Some(result)
                }
              )
            )
          }
        )
      }
    )
  )
});
/// Get the string value from a FnCall's func if it is an Identifier atom.
fncall_func_ident :: (fn(func_box : Box(AstExpr)) -> Option(String))(
  match(
    func_box.*,
    .Atom(_, ftok) => cond(
      (ftok.kind == TokenKind.Identifier) =>.Some(ftok.value),
      true => Option(String).None
    ),
    .FnCall(_, _, _, _, _) => Option(String).None
  )
);
is_plain_identifier_call_expr :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, inner_func, _, inner_infix, _) => (
      (!(inner_infix)) &&
        match(
          inner_func.*,
          .Atom(_, inner_tok) => (inner_tok.kind == TokenKind.Identifier),
          .FnCall(_, _, _, _, _) => false
        )
    )
  )
);
// ---------------------------------------------------------------------------
// Phase 4d helpers — type mapping, function calls, dot access, assignment
// ---------------------------------------------------------------------------
/// Map a simple Yo type name to its C equivalent.
///
/// Only handles primitive types.  User-defined names pass through unchanged.
/// Generic types (e.g. `Option(i32)`) require Phase 4e type codegen.
type_name_to_c :: (fn(name : str) -> String)(
  cond(
    (name == "i8") => String.from("int8_t"),
    (name == "i16") => String.from("int16_t"),
    (name == "i32") => String.from("int32_t"),
    (name == "i64") => String.from("int64_t"),
    (name == "u8") => String.from("uint8_t"),
    (name == "u16") => String.from("uint16_t"),
    (name == "u32") => String.from("uint32_t"),
    (name == "u64") => String.from("uint64_t"),
    (name == "usize") => String.from("size_t"),
    (name == "isize") => String.from("intptr_t"),
    (name == "f32") => String.from("float"),
    (name == "f64") => String.from("double"),
    (name == "bool") => String.from("bool"),
    (name == "str") => String.from("const char*"),
    (name == "String") => String.from("const char*"),
    (name == "unit") => String.from("void"),
    (name == "rune") => String.from("uint32_t"),
    true => String.from(name)
  )
);
/// Convert a type-annotation AST node to a C type string.
///
/// Handles:
///  - Simple atomic type names (`i32` → `int32_t`, `str` → `const char*`, etc.)
///  - Pointer types (`*(T)` → `T*`, where T is a simple atomic type)
///
/// Other complex types (generic applications, slices) return `None`.
/// True if `name` is a Yo type that has a direct C equivalent.
///
/// Meta-types like `Type`, `Expr`, `comptime_int`, etc. have no C equivalent
/// and cannot be used as C variable or parameter types.
is_c_type_name :: (fn(name : str) -> bool)(
  cond(
    (name == "i8") => true,
    (name == "i16") => true,
    (name == "i32") => true,
    (name == "i64") => true,
    (name == "u8") => true,
    (name == "u16") => true,
    (name == "u32") => true,
    (name == "u64") => true,
    (name == "usize") => true,
    (name == "isize") => true,
    (name == "f32") => true,
    (name == "f64") => true,
    (name == "bool") => true,
    (name == "str") => true,
    (name == "unit") => true,
    (name == "rune") => true,
    true => false
  )
);
type_expr_to_c :: (fn(ty_expr : AstExpr) -> Option(String))(
  match(
    ty_expr,
    .Atom(_, ttok) => cond(
      (ttok.kind != TokenKind.Identifier) => Option(String).None,
      // Yo meta-types have no C equivalent — return None so callers fall back to void*.
      // (Type, Expr, Trait, DeriveContext, Module, comptime_int, comptime_float, comptime_string, ComptimeList)
      (ttok.value.as_str() == "Type") => Option(String).None,
      (ttok.value.as_str() == "Expr") => Option(String).None,
      (ttok.value.as_str() == "Trait") => Option(String).None,
      (ttok.value.as_str() == "DeriveContext") => Option(String).None,
      (ttok.value.as_str() == "Module") => Option(String).None,
      (ttok.value.as_str() == "comptime_int") => Option(String).None,
      (ttok.value.as_str() == "comptime_float") => Option(String).None,
      (ttok.value.as_str() == "comptime_string") => Option(String).None,
      true =>.Some(type_name_to_c(ttok.value.as_str()))
    ),
    .FnCall(_, func_box, func_args, is_infix, _) => cond(
      // fn(params) -> RetType — infix `->` with exactly 2 args → C function pointer type.
      // Encoded as "RET(*_FP_)(P1, P2, ...)" so build_typed_decl can insert the name.
      (is_infix && (func_args.len() == usize(2))) => match(
        func_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, ftok) => cond(
          (ftok.value.as_str() != "->") => Option(String).None,
          true => {
            ret_c := match(
              func_args.get(usize(1)),
              .None => String.from("void"),
              .Some(re) => match(
                recur(re),
                .Some(s) => s,
                .None => String.from("void")
              )
            );
            fn_expr_opt := func_args.get(usize(0));
            params_c := match(
              fn_expr_opt,
              .None => String.from(""),
              .Some(fn_expr) => match(
                fn_expr,
                .Atom(_, _) => String.from(""),
                .FnCall(_, fn_f, fn_args, fn_infix, _) => cond(
                  fn_infix => String.from(""),
                  true => match(
                    fn_f.*,
                    .FnCall(_, _, _, _, _) => String.from(""),
                    .Atom(_, fn_ftok) => cond(
                      (fn_ftok.value.as_str() != "fn") => String.from(""),
                      true => {
                        sb := String.new();
                        n_fn := fn_args.len();
                        (pi : usize) = usize(0);
                        while(runtime(pi < n_fn), {
                          match(
                            fn_args.get(pi),
                            .None => (),
                            .Some(parg) => {
                              p_ty_opt := match(
                                parg,
                                .Atom(_, _) => Option(AstExpr).None,
                                .FnCall(_, pf, pas, pinfix, _) => cond(
                                  (!(pinfix && (pas.len() == usize(2)))) => Option(AstExpr).None,
                                  true => match(
                                    pf.*,
                                    .FnCall(_, _, _, _, _) => Option(AstExpr).None,
                                    .Atom(_, ptok) => cond(
                                      (ptok.value.as_str() != ":") => Option(AstExpr).None,
                                      true => pas.get(usize(1))
                                    )
                                  )
                                )
                              );
                              p_c := match(
                                p_ty_opt,
                                .None => String.from("void*"),
                                .Some(pt) => match(
                                  recur(pt),
                                  .Some(s) => s,
                                  .None => String.from("void*")
                                )
                              );
                              if(sb.len() > usize(0), {
                                sb.push_str(", ");
                              });
                              sb.push_string(p_c);
                            }
                          );
                          pi = (pi + usize(1));
                        });
                        sb
                      }
                    )
                  )
                )
              )
            );
            result := String.new();
            result.push_string(ret_c);
            result.push_str("(*_FP_)(");
            result.push_string(params_c);
            result.push_str(")");
            Option(String).Some(result)
          }
        )
      ),
      (is_infix) => Option(String).None,
      (
        (func_args.len() != usize(1)) &&
          match(
            func_box.*,
            .FnCall(_, _, _, _, _) => true,
            .Atom(_, arity_tok) => ((arity_tok.value.as_str() != "Tuple") && (arity_tok.value.as_str() != "Array"))
          )
      ) => Option(String).None,
      true => match(
        func_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, ftok) => cond(
          // comptime(T) — unwrap to T only if T is not a pure Yo meta-type.
          // Meta-types like `Type`, `Expr`, comptime_int, comptime_float, comptime_string
          // have no C equivalent → return None.  All other identifiers (primitives,
          // user-defined structs/enums) are passed through as-is.
          (ftok.value.as_str() == "comptime") => match(
            func_args.get(usize(0)),
            .None => Option(String).None,
            .Some(inner) => match(
              inner,
              .FnCall(_, _, _, _, _) => recur(inner),
              .Atom(_, itok) => cond(
                (itok.kind != TokenKind.Identifier) => Option(String).None,
                (itok.value.as_str() == "Type") => Option(String).None,
                (itok.value.as_str() == "Expr") => Option(String).None,
                (itok.value.as_str() == "Trait") => Option(String).None,
                (itok.value.as_str() == "DeriveContext") => Option(String).None,
                (itok.value.as_str() == "Module") => Option(String).None,
                (itok.value.as_str() == "comptime_int") => Option(String).None,
                (itok.value.as_str() == "comptime_float") => Option(String).None,
                (itok.value.as_str() == "comptime_string") => Option(String).None,
                (itok.value.as_str() == "ComptimeList") => Option(String).None,
                (itok.value.as_str() == "comptime_bool") => Option(String).None,
                true => recur(inner)
              )
            )
          ),
          // Tuple(T1, T2, ...) or Tuple(name : T, ...) — lower to an inline C
          // struct type with numeric fields, plus named aliases for labeled fields.
          (ftok.value.as_str() == "Array") => match(
            func_args.get(usize(0)),
            .None => Option(String).None,
            .Some(array_elem_e) => match(
              array_elem_e,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, array_elem_tok) => cond(
                (array_elem_tok.value.as_str() == "i32") => Option(String).Some(String.from("YoArray_i32")),
                true => Option(String).None
              )
            )
          ),
          (ftok.value.as_str() == "Slice") => match(
            func_args.get(usize(0)),
            .None => Option(String).None,
            .Some(slice_elem_e) => match(
              slice_elem_e,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, slice_elem_tok) => cond(
                (slice_elem_tok.value.as_str() == "u8") => Option(String).Some(String.from("YoSlice_u8")),
                true => Option(String).None
              )
            )
          ),
          (ftok.value.as_str() == "Tuple") => {
            n_tuple := func_args.len();
            cond(
              (n_tuple == usize(0)) => Option(String).None,
              true => {
                tuple_ty := String.from("struct { ");
                (ti : usize) = usize(0);
                (tuple_ok : bool) = true;
                while(runtime((ti < n_tuple) && tuple_ok), {
                  match(
                    func_args.get(ti),
                    .None => {
                      tuple_ok = false;
                    },
                    .Some(tuple_arg) => {
                      named_field_opt := match(
                        tuple_arg,
                        .Atom(_, _) => Option(String).None,
                        .FnCall(_, tf_box, tf_args, tf_infix, _) => cond(
                          (!(tf_infix && (tf_args.len() == usize(2)))) => Option(String).None,
                          true => match(
                            tf_box.*,
                            .FnCall(_, _, _, _, _) => Option(String).None,
                            .Atom(_, tf_tok) => cond(
                              (tf_tok.value.as_str() != ":") => Option(String).None,
                              true => match(
                                tf_args.get(usize(0)),
                                .None => Option(String).None,
                                .Some(tf_name_e) => match(
                                  tf_name_e,
                                  .FnCall(_, _, _, _, _) => Option(String).None,
                                  .Atom(_, tf_name_tok) => Option(String).Some(tf_name_tok.value)
                                )
                              )
                            )
                          )
                        )
                      );
                      ty_expr_opt := match(
                        named_field_opt,
                        .None => Option(AstExpr).Some(tuple_arg),
                        .Some(_) => match(
                          tuple_arg,
                          .Atom(_, _) => Option(AstExpr).None,
                          .FnCall(_, _, tf_args2, _, _) => tf_args2.get(usize(1))
                        )
                      );
                      match(
                        ty_expr_opt,
                        .None => {
                          tuple_ok = false;
                        },
                        .Some(ty_expr_inner) => match(
                          recur(ty_expr_inner),
                          .None => {
                            tuple_ok = false;
                          },
                          .Some(field_c_ty) => {
                            tuple_ty.push_string(field_c_ty);
                            tuple_ty.push_str(" _");
                            tuple_ty.push_string(ti.to_string());
                            tuple_ty.push_str("; ");
                            match(
                              named_field_opt,
                              .None => (),
                              .Some(named_field) => {
                                tuple_ty.push_string(field_c_ty);
                                tuple_ty.push_str(" ");
                                tuple_ty.push_string(sanitize_c_ident(named_field.as_str()));
                                tuple_ty.push_str("; ");
                              }
                            );
                          }
                        )
                      );
                    }
                  );
                  ti = (ti + usize(1));
                });
                cond(
                  (!(tuple_ok)) => Option(String).None,
                  true => {
                    tuple_ty.push_str("}");
                    Option(String).Some(tuple_ty)
                  }
                )
              }
            )
          },
          // *(T) — pointer type: non-infix call to "*" with one arg (T must be an atom)
          (!(ftok.value.as_str() == "*")) => cond(
            // Bootstrap specialization: ArrayList(u8) has a concrete value layout.
            (ftok.value.as_str() == "ArrayList") => match(
              func_args.get(usize(0)),
              .None => Option(String).Some(String.from("void*")),
              .Some(list_arg) => match(
                list_arg,
                .FnCall(_, _, _, _, _) => Option(String).Some(String.from("void*")),
                .Atom(_, list_arg_tok) => cond(
                  (list_arg_tok.value.as_str() == "u8") => Option(String).Some(String.from("ArrayList_u8")),
                  true => Option(String).Some(String.from("void*"))
                )
              )
            ),
            // Other generic container types still use the opaque prototype representation.
            (ftok.value.as_str() == "HashMap") =>
              Option(String).Some(String.from("void*")),
            (ftok.value.as_str() == "Option") => Option(String).Some(String.from("void*")),
            (ftok.value.as_str() == "Result") => Option(String).Some(String.from("void*")),
            (ftok.value.as_str() == "Box") => Option(String).Some(String.from("void*")),
            (ftok.value.as_str() == "Impl") => Option(String).Some(String.from("void*")),
            true => Option(String).None
          ),
          true => match(
            func_args.get(usize(0)),
            .None => Option(String).None,
            .Some(inner_ty) => match(
              inner_ty,
              .Atom(_, ittok) => cond(
                (ittok.kind == TokenKind.Identifier) => {
                  inner_c := type_name_to_c(ittok.value.as_str());
                  inner_c.push_str("*");
                  Option(String).Some(inner_c)
                },
                true => Option(String).None
              ),
              .FnCall(_, _, _, _, _) => Option(String).None
            )
          )
        )
      )
    )
  )
);
/// Build a C declaration string combining a type and a variable name.
///
/// For regular types: `"int32_t"` + `"x"` → `"int32_t x"`.
/// For function pointer types encoded as `"RET(*_FP_)(PARAMS)"`:
/// replace the `_FP_` placeholder with the actual name →
/// `"int32_t (*cb)(int32_t)"`.
build_typed_decl :: (fn(c_ty : str, name : str) -> String)({
  ty_s := String.from(c_ty);
  marker := String.from("_FP_");
  cond(
    (ty_s.contains(marker)) => ty_s.replace(marker, String.from(name)),
    true => {
      result := String.from(c_ty);
      result.push_str(" ");
      result.push_str(name);
      result
    }
  )
});
///
/// These names are used for explicit type-cast expressions: `i32(x)` → `(int32_t)(x)`.
is_primitive_type_cast :: (fn(name : str) -> bool)(
  cond(
    (name == "i8") => true,
    (name == "i16") => true,
    (name == "i32") => true,
    (name == "i64") => true,
    (name == "u8") => true,
    (name == "u16") => true,
    (name == "u32") => true,
    (name == "u64") => true,
    (name == "usize") => true,
    (name == "isize") => true,
    (name == "f32") => true,
    (name == "f64") => true,
    (name == "bool") => true,
    true => false
  )
);
/// Check whether all identifier atoms referenced in `expr` are available as C variables
/// (either known to ctx or previously-emitted `::` constants). Used to determine if a
/// `::` infix binary op binding is safe to emit.
expr_all_ids_known :: (fn(expr : AstExpr, ctx : *(CodegenContext)) -> bool)(
  match(
    expr,
    .Atom(_, tok) => cond(
      (tok.kind == TokenKind.Identifier) => (
        is_primitive_type_cast(tok.value.as_str()) ||
          ctx.*.is_defined_fn(tok.value.as_str()) ||
            ctx.*.is_struct_name(tok.value.as_str()) ||
              ctx.*.is_enum_name(tok.value.as_str()) ||
                ctx.*.is_const_var(tok.value.as_str()) ||
                  ctx.*.is_array_var(tok.value.as_str()) ||
                    ctx.*.is_slice_var(tok.value.as_str())
      ),
      true => true
    ),
    .FnCall(_, fn2, args2, _, is_infix2) => {
      // For infix dot-dispatch `obj.method` (infix=true, func=Atom(".")):
      // args2 = [receiver, method_name].  The method_name is not a variable — skip it.
      // Only check the receiver (args2[0]), AND only if the method is one that
      // handle_method_call can emit as valid C (whitelist: neg, len, as_str, is_some, is_none).
      is_dot2 := match(
        fn2.*,
        .Atom(_, ftok2) => (ftok2.value.as_str() == "."),
        .FnCall(_, _, _, _, _) => false
      );
      (ok2 : bool) = match(
        is_dot2,
        true => {
          method_safe := match(
            args2.get(usize(1)),
            .None => false,
            .Some(mname_e) => match(
              mname_e,
              .Atom(_, mname_tok) => (
                (mname_tok.value.as_str() == "neg") ||
                  (mname_tok.value.as_str() == "len") ||
                    (mname_tok.value.as_str() == "as_str") ||
                      (mname_tok.value.as_str() == "is_some") ||
                        (mname_tok.value.as_str() == "is_none")
              ),
              .FnCall(_, _, _, _, _) => false
            )
          );
          cond(
            (!(method_safe)) => false,
            true => match(
              args2.get(usize(0)),
              .None => false,
              .Some(recv2) => recur(recv2, ctx)
            )
          )
        },
        false => {
          (ok2i : bool) = recur(fn2.*, ctx);
          n2 := args2.len();
          (i2 : usize) = usize(0);
          while(runtime((i2 < n2) && ok2i), {
            match(
              args2.get(i2),
              .None => {
                ok2i = false;
              },
              .Some(ae2) => {
                if(!(recur(ae2, ctx)), {
                  ok2i = false;
                });
              }
            );
            i2 = (i2 + usize(1));
          });
          ok2i
        }
      );
      ok2
    }
  )
);
/// Handle a primitive type cast: `i32(x)` → `(int32_t)(x)`.
handle_type_cast :: (
  fn(
    type_name : String,
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)(
  match(
    args.get(usize(0)),
    .None => Option(String).None,
    .Some(arg) => {
      // Special case: `i32(EnumName.Variant(args…))` — extract the discriminant
      // integer rather than trying to cast a tagged-union struct.
      // We detect this as: arg is a non-infix FnCall whose func is itself an infix
      // dot-dispatch (method call), whose receiver is a registered enum name and
      // whose method is a registered complex variant.
      //
      // Inline the dot-dispatch detection here (func_box_is_dot_dispatch /
      // get_dispatch_receiver / get_dispatch_method are defined later in the file).
      is_complex_variant_cast := match(
        arg,
        .Atom(_, _) => false,
        .FnCall(_, inner_func, _, _, _) => match(
          inner_func.*,
          .Atom(_, _) => false,
          .FnCall(_, dot_fn, dot_args, dot_infix, _) => (
            dot_infix && (
              match(
                dot_fn.*,
                .Atom(_, dtok) => (dtok.kind == TokenKind.Dot),
                .FnCall(_, _, _, _, _) => false
              ) && match(
                dot_args.get(usize(0)),
                .None => false,
                .Some(recv_e) => match(
                  call_gen_expr(recv_e, ctx, indent),
                  .None => false,
                  .Some(recv_c) => (
                    ctx.*.is_enum_name(recv_c.as_str()) && match(
                      dot_args.get(usize(1)),
                      .None => false,
                      .Some(method_e) => match(
                        method_e,
                        .FnCall(_, _, _, _, _) => false,
                        .Atom(_, mtok) => ctx.*.get_variant_fields(recv_c.as_str(), mtok.value.as_str()).is_some()
                      )
                    )
                  )
                )
              )
            )
          )
        )
      );
      cond(
        is_complex_variant_cast => match(
          arg,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, inner_func2, _, _, _) => match(
            inner_func2.*,
            .Atom(_, _) => Option(String).None,
            .FnCall(_, _, dot_args2, _, _) => match(
              dot_args2.get(usize(0)),
              .None => Option(String).None,
              .Some(recv_e2) => match(
                call_gen_expr(recv_e2, ctx, indent),
                .None => Option(String).None,
                .Some(recv_c2) => match(
                  dot_args2.get(usize(1)),
                  .None => Option(String).None,
                  .Some(method_e2) => match(
                    method_e2,
                    .FnCall(_, _, _, _, _) => Option(String).None,
                    .Atom(_, mtok2) => {
                      // Emit `(int32_t)(EnumName_Variant)` — the tag constant value
                      result := String.from("(");
                      result.push_string(type_name_to_c(type_name.as_str()));
                      result.push_str(")(");
                      result.push_string(recv_c2);
                      result.push_str("_");
                      result.push_string(mtok2.value);
                      result.push_str(")");
                      .Some(result)
                    }
                  )
                )
              )
            )
          )
        ),
        true => {
          // Check if this is a simple identifier with a registered complex-enum type.
          // e.g. `i32(shape)` where `shape : Shape` → `(int32_t)(shape.tag)`
          is_complex_enum_var := match(
            arg,
            .FnCall(_, _, _, _, _) => false,
            .Atom(_, atk) => match(
              ctx.*.get_var_type(atk.value.as_str()),
              .None => false,
              .Some(vtype) => ctx.*.is_complex_enum_name(vtype.as_str())
            )
          );
          cond(
            is_complex_enum_var => match(
              arg,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, atk2) => {
                result2 := String.from("(");
                result2.push_string(type_name_to_c(type_name.as_str()));
                result2.push_str(")(");
                result2.push_string(atk2.value);
                result2.push_str(".tag)");
                .Some(result2)
              }
            ),
            true => match(
              call_gen_expr(arg, ctx, indent),
              .None => Option(String).None,
              .Some(val) => {
                result := String.from("(");
                result.push_string(type_name_to_c(type_name.as_str()));
                result.push_str(")(");
                result.push_string(val);
                result.push_str(")");
                .Some(result)
              }
            )
          )
        }
      )
    }
  )
);
/// Handle bare type annotation `x : T` → emit `T_c x;` as an uninitialized
/// C variable declaration and return `"0"` (unit sentinel).
///
/// This handles the Yo form `x : i32;` (declare without initial value).
/// For `comptime(x) : T` the LHS is a FnCall; we skip it since comptime
/// variables have no runtime representation in the prototype codegen.
handle_bare_colon_decl :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  lhs_opt := args.get(usize(0));
  rhs_opt := args.get(usize(1));
  match(
    lhs_opt,
    .None => Option(String).None,
    .Some(lhs_expr) => match(
      rhs_opt,
      .None => Option(String).None,
      .Some(ty_expr) => match(
        lhs_expr,
        // x : T  →  emit "T_c x;"  (or "T_c x[N] = {0};" for Array types)
        .Atom(_, name_tok) => {
          san_name := sanitize_c_ident(name_tok.value.as_str());
          // Special case: Array(T, N) or [T; N] bare declaration
          array_decl_emitted := match(
            ty_expr,
            .Atom(_, _) => false,
            .FnCall(_, atf, ata, ati, _) => cond(
              ati => false,
              (ata.len() != usize(2)) => false,
              true => match(
                atf.*,
                .FnCall(_, _, _, _, _) => false,
                .Atom(_, attok) => cond(
                  (attok.value.as_str() != "Array") => false,
                  true => {
                    elem_c_opt := match(
                      ata.get(usize(0)),
                      .None => Option(String).None,
                      .Some(e) => type_expr_to_c(e)
                    );
                    size_opt := match(
                      ata.get(usize(1)),
                      .None => Option(String).None,
                      .Some(s) => match(
                        s,
                        .FnCall(_, _, _, _, _) => Option(String).None,
                        .Atom(_, stok) => cond(
                          (stok.kind == TokenKind.Integer) => Option(String).Some(stok.value),
                          (stok.kind == TokenKind.Identifier) => Option(String).Some(stok.value),
                          true => Option(String).None
                        )
                      )
                    );
                    match(
                      elem_c_opt,
                      .None => false,
                      .Some(ec) => match(
                        size_opt,
                        .None => false,
                        .Some(sz) => {
                          ctx.*.emitter.emit_string(indent);
                          ctx.*.emitter.emit_string(ec);
                          ctx.*.emitter.emit(" ");
                          ctx.*.emitter.emit_string(san_name);
                          ctx.*.emitter.emit("[");
                          ctx.*.emitter.emit_string(sz);
                          ctx.*.emitter.emit_line("] = {0};");
                          ctx.*.register_array_var_with_size(name_tok.value.as_str(), sz.as_str());
                          true
                        }
                      )
                    )
                  }
                )
              )
            )
          );
          cond(
            array_decl_emitted => Option(String).Some(String.from("0")),
            true => match(
              type_expr_to_c(ty_expr),
              .None => Option(String).None,
              .Some(c_ty) => {
                decl := build_typed_decl(c_ty.as_str(), san_name.as_str());
                ctx.*.emitter.emit_string(indent);
                ctx.*.emitter.emit_string(decl);
                ctx.*.emitter.emit_line(";");
                Option(String).Some(String.from("0"))
              }
            )
          )
        },
        // comptime(x) : T — emit "T_c x;" for primitive T; skip for Type (meta-type)
        .FnCall(_, cf_box, cf_args, cf_infix, _) => cond(
          cf_infix =>.Some(String.from("0")),
          (!(cf_args.len() == usize(1))) =>.Some(String.from("0")),
          true => match(
            cf_box.*,
            .FnCall(_, _, _, _, _) =>.Some(String.from("0")),
            .Atom(_, cftok) => cond(
              (!(cftok.value.as_str() == "comptime")) =>.Some(String.from("0")),
              true => match(
                cf_args.get(usize(0)),
                .None =>.Some(String.from("0")),
                .Some(inner) => match(
                  inner,
                  .FnCall(_, _, _, _, _) =>.Some(String.from("0")),
                  .Atom(_, itok) => cond(
                    (itok.kind != TokenKind.Identifier) =>.Some(String.from("0")),
                    true => {
                      is_meta_type := match(
                        ty_expr,
                        .Atom(_, ttok) => (ttok.value.as_str() == "Type"),
                        .FnCall(_, _, _, _, _) => false
                      );
                      cond(
                        is_meta_type =>.Some(String.from("0")),
                        true => match(
                          type_expr_to_c(ty_expr),
                          .None =>.Some(String.from("0")),
                          .Some(c_ty) => cond(
                            // Skip `comptime(name) : fn_type` declarations — these are deferred
                            // bindings that need explicit assignment (mutual recursion pattern).
                            // Emitting an uninitialized function pointer causes runtime crashes.
                            (c_ty.contains(String.from("_FP_"))) =>.Some(String.from("0")),
                            true => {
                              san_name := sanitize_c_ident(itok.value.as_str());
                              decl := build_typed_decl(c_ty.as_str(), san_name.as_str());
                              ctx.*.emitter.emit_string(indent);
                              ctx.*.emitter.emit_string(decl);
                              ctx.*.emitter.emit_line(";");
                              .Some(String.from("0"))
                            }
                          )
                        )
                      )
                    }
                  )
                )
              )
            )
          )
        )
      )
    )
  )
});
/// Convert a small index (0-9) to a C tuple field reference "._N".
/// Returns "._0" for 0, "._1" for 1, etc. (up to 9).
_tuple_field_ref :: (fn(idx : usize) -> String)({
  r := String.from("._");
  if(idx == usize(0), {
    r.push_str("0");
  });
  if(idx == usize(1), {
    r.push_str("1");
  });
  if(idx == usize(2), {
    r.push_str("2");
  });
  if(idx == usize(3), {
    r.push_str("3");
  });
  if(idx == usize(4), {
    r.push_str("4");
  });
  if(idx == usize(5), {
    r.push_str("5");
  });
  if(idx == usize(6), {
    r.push_str("6");
  });
  if(idx == usize(7), {
    r.push_str("7");
  });
  if(idx == usize(8), {
    r.push_str("8");
  });
  if(idx == usize(9), {
    r.push_str("9");
  });
  r
});
type_app_receiver_is :: (fn(expr : AstExpr, type_name : str) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, type_fn_box, _, type_infix, _) => cond(
      type_infix => false,
      true => match(
        type_fn_box.*,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, type_tok) => (type_tok.value.as_str() == type_name)
      )
    )
  )
);
array_i32_size_arg_to_c :: (
  fn(expr : AstExpr, ctx : *(CodegenContext), indent : String) -> Option(String)
)(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, type_fn_box, type_args, type_infix, _) => cond(
      type_infix => Option(String).None,
      (type_args.len() != usize(2)) => Option(String).None,
      true => match(
        type_fn_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, type_tok) => cond(
          (type_tok.value.as_str() != "Array") => Option(String).None,
          true => match(
            type_args.get(usize(0)),
            .None => Option(String).None,
            .Some(elem_e) => match(
              elem_e,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, elem_tok) => cond(
                (elem_tok.value.as_str() != "i32") => Option(String).None,
                true => match(
                  type_args.get(usize(1)),
                  .None => Option(String).None,
                  .Some(size_e) => call_gen_expr(size_e, ctx, indent)
                )
              )
            )
          )
        )
      )
    )
  )
);
type_app_receiver_arg_is :: (fn(expr : AstExpr, type_name : str, arg_name : str) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, type_fn_box, type_args, type_infix, _) => cond(
      type_infix => false,
      (type_args.len() != usize(1)) => false,
      true => match(
        type_fn_box.*,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, type_tok) => cond(
          (type_tok.value.as_str() != type_name) => false,
          true => match(
            type_args.get(usize(0)),
            .None => false,
            .Some(arg_expr) => match(
              arg_expr,
              .FnCall(_, _, _, _, _) => false,
              .Atom(_, arg_tok) => (arg_tok.value.as_str() == arg_name)
            )
          )
        )
      )
    )
  )
);
is_slice_u8_from_raw_parts_call :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, call_fn_box, call_args, call_infix, _) => cond(
      call_infix => false,
      (call_args.len() != usize(2)) => false,
      true => match(
        call_fn_box.*,
        .Atom(_, _) => false,
        .FnCall(_, dot_fn_box, dot_args, dot_infix, _) => cond(
          (!(dot_infix && (dot_args.len() == usize(2)))) => false,
          true => match(
            dot_fn_box.*,
            .FnCall(_, _, _, _, _) => false,
            .Atom(_, dot_tok) => cond(
              (dot_tok.value.as_str() != ".") => false,
              true => match(
                dot_args.get(usize(0)),
                .None => false,
                .Some(recv_e) => cond(
                  (!(type_app_receiver_arg_is(recv_e, "Slice", "u8"))) => false,
                  true => match(
                    dot_args.get(usize(1)),
                    .None => false,
                    .Some(method_e) => match(
                      method_e,
                      .FnCall(_, _, _, _, _) => false,
                      .Atom(_, method_tok) => (method_tok.value.as_str() == "from_raw_parts")
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
);
var_type_is :: (fn(ctx : *(CodegenContext), name : str, c_type : str) -> bool)(
  match(
    ctx.*.get_var_type(name),
    .None => false,
    .Some(actual) => (actual.as_str() == c_type)
  )
);
generic_type_app_c_name :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, type_fn_box, type_args, type_infix, _) => cond(
      type_infix => Option(String).None,
      (type_args.len() != usize(1)) => Option(String).None,
      true => match(
        type_fn_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, type_tok) => match(
          type_args.get(usize(0)),
          .None => Option(String).None,
          .Some(arg_expr) => match(
            arg_expr,
            .FnCall(_, _, _, _, _) => Option(String).None,
            .Atom(_, arg_tok) => cond(
              (arg_tok.kind != TokenKind.Identifier) => Option(String).None,
              true => {
                result := sanitize_c_ident(type_tok.value.as_str());
                result.push_str("_");
                result.push_string(sanitize_c_ident(arg_tok.value.as_str()));
                Option(String).Some(result)
              }
            )
          )
        )
      )
    )
  )
);
generic_type_app_field_c_type :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, _, type_args, type_infix, _) => cond(
      type_infix => Option(String).None,
      (type_args.len() != usize(1)) => Option(String).None,
      true => match(
        type_args.get(usize(0)),
        .None => Option(String).None,
        .Some(arg_expr) => type_expr_to_c(arg_expr)
      )
    )
  )
);
ensure_generic_value_struct :: (fn(ctx : *(CodegenContext), type_name : String, field_c_ty : String) -> unit)({
  if(!(ctx.*.is_struct_name(type_name.as_str())), {
    decl := String.from("typedef struct { ");
    decl.push_string(field_c_ty);
    decl.push_str(" value; } ");
    decl.push_string(type_name);
    decl.push_str(";");
    ctx.*.emitter.emit_declaration_string_line(decl);
    ctx.*.register_struct(String.from(type_name.as_str()));
    ctx.*.register_struct_fields(type_name.as_str(), "value");
    ctx.*.register_struct_field_types(type_name.as_str(), field_c_ty.as_str());
  });
});
generic_static_constructor_type_from_call :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, call_fn_box, call_args, call_infix, _) => cond(
      call_infix => Option(String).None,
      (call_args.len() != usize(1)) => Option(String).None,
      true => match(
        call_fn_box.*,
        .Atom(_, _) => Option(String).None,
        .FnCall(_, dot_fn, dot_args, dot_infix, _) => cond(
          (!(dot_infix && (dot_args.len() == usize(2)))) => Option(String).None,
          true => match(
            dot_fn.*,
            .FnCall(_, _, _, _, _) => Option(String).None,
            .Atom(_, dot_tok) => cond(
              (dot_tok.value.as_str() != ".") => Option(String).None,
              true => match(
                dot_args.get(usize(1)),
                .None => Option(String).None,
                .Some(method_e) => match(
                  method_e,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, method_tok) => cond(
                    !((method_tok.value.as_str() == "new") || (method_tok.value.as_str() == "another_new")) =>
                      Option(String).None,
                    true => match(
                      dot_args.get(usize(0)),
                      .None => Option(String).None,
                      .Some(recv_e) => generic_type_app_c_name(recv_e)
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
);
emit_method_extraction_macro_if_supported :: (
  fn(name : str, rhs_expr : AstExpr, ctx : *(CodegenContext), indent : String) -> bool
)(
  match(
    rhs_expr,
    .Atom(_, _) => false,
    .FnCall(_, me_fn_box, me_args, me_infix, _) => cond(
      (!(me_infix)) => false,
      (me_args.len() != usize(2)) => false,
      true => match(
        me_fn_box.*,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, me_dot_tok) => cond(
          (me_dot_tok.value.as_str() != ".") => false,
          true => match(
            me_args.get(usize(0)),
            .None => false,
            .Some(me_recv) => match(
              me_args.get(usize(1)),
              .None => false,
              .Some(me_method_expr) => match(
                me_method_expr,
                .FnCall(_, _, _, _, _) => false,
                .Atom(_, me_method_tok) => cond(
                  (me_method_tok.value.as_str() != "unwrap") => false,
                  (!(type_app_receiver_is(me_recv, "Option") || type_app_receiver_is(me_recv, "Result"))) => false,
                  true => {
                    ctx.*.emitter.emit_string(indent);
                    ctx.*.emitter.emit("#define ");
                    ctx.*.emitter.emit_string(sanitize_c_ident(name));
                    ctx.*.emitter.emit_line("(__yo_value) (__yo_value)");
                    true
                  }
                )
              )
            )
          )
        )
      )
    )
  )
);
anon_struct_type_to_c :: (fn(type_args : ArrayList(AstExpr)) -> Option(String))({
  n := type_args.len();
  result := String.from("struct { ");
  (i : usize) = usize(0);
  (ok : bool) = true;
  while(runtime((i < n) && ok), {
    match(
      type_args.get(i),
      .None => {
        ok = false;
      },
      .Some(field_expr) => match(
        field_expr,
        .Atom(_, _) => {
          ok = false;
        },
        .FnCall(_, colon_box, colon_args, colon_infix, _) => cond(
          (!(colon_infix && (colon_args.len() == usize(2)))) => {
            ok = false;
          },
          true => match(
            colon_box.*,
            .FnCall(_, _, _, _, _) => {
              ok = false;
            },
            .Atom(_, colon_tok) => cond(
              !((colon_tok.value.as_str() == ":") || (colon_tok.value.as_str() == "?=")) => {
                ok = false;
              },
              true => {
                actual_args_opt := cond(
                  (colon_tok.value.as_str() == ":") => Option(ArrayList(AstExpr)).Some(colon_args),
                  true => match(
                    colon_args.get(usize(0)),
                    .None => Option(ArrayList(AstExpr)).None,
                    .Some(inner_field_expr) => match(
                      inner_field_expr,
                      .Atom(_, _) => Option(ArrayList(AstExpr)).None,
                      .FnCall(_, inner_colon_box, inner_colon_args, inner_colon_infix, _) => cond(
                        (!(inner_colon_infix && (inner_colon_args.len() == usize(2)))) =>
                          Option(ArrayList(AstExpr)).None,
                        true => match(
                          inner_colon_box.*,
                          .FnCall(_, _, _, _, _) => Option(ArrayList(AstExpr)).None,
                          .Atom(_, inner_colon_tok) => cond(
                            (inner_colon_tok.value.as_str() != ":") => Option(ArrayList(AstExpr)).None,
                            true => Option(ArrayList(AstExpr)).Some(inner_colon_args)
                          )
                        )
                      )
                    )
                  )
                );
                field_name_opt := match(
                  actual_args_opt,
                  .None => Option(String).None,
                  .Some(actual_args) => match(
                    actual_args.get(usize(0)),
                    .None => Option(String).None,
                    .Some(name_expr) => match(
                      name_expr,
                      .FnCall(_, _, _, _, _) => Option(String).None,
                      .Atom(_, name_tok) => Option(String).Some(name_tok.value)
                    )
                  )
                );
                field_ty_opt := match(
                  actual_args_opt,
                  .None => Option(String).None,
                  .Some(actual_args2) => match(
                    actual_args2.get(usize(1)),
                    .None => Option(String).None,
                    .Some(ty_expr) => type_expr_to_c(ty_expr)
                  )
                );
                match(
                  field_name_opt,
                  .None => {
                    ok = false;
                  },
                  .Some(field_name) => match(
                    field_ty_opt,
                    .None => {
                      ok = false;
                    },
                    .Some(field_ty) => {
                      result.push_string(field_ty);
                      result.push_str(" ");
                      result.push_string(sanitize_c_ident(field_name.as_str()));
                      result.push_str("; ");
                    }
                  )
                );
              }
            )
          )
        )
      )
    );
    i = (i + usize(1));
  });
  cond(
    (!(ok)) => Option(String).None,
    true => {
      result.push_str("}");
      Option(String).Some(result)
    }
  )
});
anon_struct_initializer_to_c :: (
  fn(
    value_args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  result := String.from("{");
  n := value_args.len();
  (i : usize) = usize(0);
  (ok : bool) = true;
  while(runtime((i < n) && ok), {
    match(
      value_args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg_expr) => match(
        call_gen_expr(arg_expr, ctx, indent),
        .None => {
          ok = false;
        },
        .Some(arg_code) => {
          if(i > usize(0), {
            result.push_str(", ");
          });
          result.push_string(arg_code);
        }
      )
    );
    i = (i + usize(1));
  });
  cond(
    (!(ok)) => Option(String).None,
    true => {
      result.push_str("}");
      Option(String).Some(result)
    }
  )
});
struct_default_values_csv :: (
  fn(
    type_args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> String
)({
  result := String.new();
  n := type_args.len();
  (i : usize) = usize(0);
  while(runtime(i < n), {
    if(i > usize(0), {
      result.push_str(",");
    });
    default_code_opt := match(
      type_args.get(i),
      .None => Option(String).None,
      .Some(field_expr) => match(
        field_expr,
        .Atom(_, _) => Option(String).None,
        .FnCall(_, field_fn, field_args, field_infix, _) => cond(
          (!(field_infix && (field_args.len() == usize(2)))) => Option(String).None,
          true => match(
            field_fn.*,
            .FnCall(_, _, _, _, _) => Option(String).None,
            .Atom(_, field_tok) => cond(
              (field_tok.value.as_str() != "?=") => Option(String).None,
              true => match(
                field_args.get(usize(1)),
                .None => Option(String).None,
                .Some(default_expr) => call_gen_expr(default_expr, ctx, indent)
              )
            )
          )
        )
      )
    );
    match(
      default_code_opt,
      .None => result.push_str("__yo_no_default"),
      .Some(default_code) => result.push_string(default_code)
    );
    i = (i + usize(1));
  });
  result
});
struct_defaults_has_value :: (fn(defaults_csv : String) -> bool)({
  parts := _split_csv(defaults_csv.as_str());
  n := parts.len();
  (i : usize) = usize(0);
  (found : bool) = false;
  while(runtime((i < n) && (!(found))), {
    match(
      parts.get(i),
      .None => (),
      .Some(part) => {
        if(part.as_str() != "__yo_no_default", {
          found = true;
        });
      }
    );
    i = (i + usize(1));
  });
  found
});
aggregate_initializer_to_c :: (
  fn(
    expr : AstExpr,
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)(
  match(
    expr,
    .Atom(_, _) => call_gen_expr(expr, ctx, indent),
    .FnCall(_, agg_fn, agg_args, agg_infix, _) => cond(
      agg_infix => call_gen_expr(expr, ctx, indent),
      true => match(
        agg_fn.*,
        .FnCall(_, _, _, _, _) => call_gen_expr(expr, ctx, indent),
        .Atom(_, agg_tok) => cond(
          !((agg_tok.value.as_str() == BK_TUPLE) || (agg_tok.value.as_str() == BK_ANON_STRUCT)) =>
            call_gen_expr(expr, ctx, indent),
          true => {
            result := String.from("{");
            n := agg_args.len();
            (i : usize) = usize(0);
            (ok : bool) = true;
            while(runtime((i < n) && ok), {
              match(
                agg_args.get(i),
                .None => {
                  ok = false;
                },
                .Some(arg_expr) => {
                  if(i > usize(0), {
                    result.push_str(", ");
                  });
                  arg_is_labeled := match(
                    arg_expr,
                    .Atom(_, _) => false,
                    .FnCall(_, label_fn, label_args, label_infix, _) => (
                      label_infix &&
                        (label_args.len() == usize(2)) &&
                          match(
                            label_fn.*,
                            .Atom(_, label_tok) => (label_tok.value.as_str() == ":"),
                            .FnCall(_, _, _, _, _) => false
                          )
                    )
                  );
                  cond(
                    ((agg_tok.value.as_str() == BK_ANON_STRUCT) && arg_is_labeled) => match(
                      arg_expr,
                      .Atom(_, _) => {
                        ok = false;
                      },
                      .FnCall(_, _, label_args2, _, _) => match(
                        label_args2.get(usize(0)),
                        .None => {
                          ok = false;
                        },
                        .Some(label_name_e) => match(
                          label_args2.get(usize(1)),
                          .None => {
                            ok = false;
                          },
                          .Some(label_value_e) => match(
                            label_name_e,
                            .FnCall(_, _, _, _, _) => {
                              ok = false;
                            },
                            .Atom(_, label_name_tok) => match(
                              recur(label_value_e, ctx, indent),
                              .None => {
                                ok = false;
                              },
                              .Some(label_value_c) => {
                                result.push_str(".");
                                result.push_string(sanitize_c_ident(label_name_tok.value.as_str()));
                                result.push_str(" = ");
                                result.push_string(label_value_c);
                              }
                            )
                          )
                        )
                      )
                    ),
                    true => match(
                      recur(arg_expr, ctx, indent),
                      .None => {
                        ok = false;
                      },
                      .Some(arg_c) => {
                        result.push_string(arg_c);
                      }
                    )
                  );
                }
              );
              i = (i + usize(1));
            });
            cond(
              (!(ok)) => Option(String).None,
              true => {
                result.push_str("}");
                Option(String).Some(result)
              }
            )
          }
        )
      )
    )
  )
);
/// Handle variable definition `name := val` → emit `__auto_type name = val;\n` as a
/// statement and return `"0"` (the unit sentinel).
///
/// Uses `__auto_type` (GCC/Clang extension) for type inference, avoiding the need
/// to know the type at this phase.
handle_define :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  lhs_opt := args.get(usize(0));
  rhs_opt := args.get(usize(1));
  match(lhs_opt,.None => Option(String).None,.Some(lhs_expr) => match(
    rhs_opt,
    .None => Option(String).None,
    .Some(rhs_expr) => match(
      lhs_expr,
      // Simple: x := val — auto-type variable declaration
      .Atom(_, name_tok) => {
        // Check if RHS is a labeled anon struct `{ field: val, ... }`.
        // If so, track the field names so `open name` can emit field bindings.
        rhs_labeled_fields_opt := match(
          rhs_expr,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, rf_box, rf_args, rf_infix, _) => cond(
            rf_infix => Option(String).None,
            (!(rf_args.len() > usize(0))) => Option(String).None,
            true => match(
              rf_box.*,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, rftok) => cond(
                (!(rftok.value.as_str() == BK_ANON_STRUCT)) => Option(String).None,
                true => {
                  csv_buf := String.new();
                  n_rf := rf_args.len();
                  (rf_i : usize) = usize(0);
                  (all_ok : bool) = true;
                  while(runtime((rf_i < n_rf) && all_ok), {
                    match(
                      rf_args.get(rf_i),
                      .None => {
                        all_ok = false;
                      },
                      .Some(rf_arg) => match(
                        rf_arg,
                        .Atom(_, ratom) => {
                          if(rf_i > usize(0), {
                            csv_buf.push_str(",");
                          });
                          csv_buf.push_string(ratom.value);
                        },
                        .FnCall(_, rf_ff, rf_fa, rf_finfix, _) => {
                          is_lbl := (
                            (rf_finfix && (rf_fa.len() == usize(2))) && match(
                              rf_ff.*,
                              .Atom(_, rf_ftok) => (rf_ftok.value.as_str() == ":"),
                              .FnCall(_, _, _, _, _) => false
                            )
                          );
                          cond(
                            (!(is_lbl)) => {
                              all_ok = false;
                            },
                            true => match(
                              rf_fa.get(usize(0)),
                              .None => {
                                all_ok = false;
                              },
                              .Some(rf_name_e) => match(
                                rf_name_e,
                                .FnCall(_, _, _, _, _) => {
                                  all_ok = false;
                                },
                                .Atom(_, rf_natom) => {
                                  if(rf_i > usize(0), {
                                    csv_buf.push_str(",");
                                  });
                                  csv_buf.push_string(rf_natom.value);
                                }
                              )
                            )
                          );
                        }
                      )
                    );
                    rf_i = (rf_i + usize(1));
                  });
                  cond(
                    ((!(all_ok)) || (csv_buf.len() == usize(0))) => Option(String).None,
                    true => Option(String).Some(csv_buf)
                  )
                }
              )
            )
          )
        );
        match(
          rhs_labeled_fields_opt,
          .None => {
            // Also track named struct constructor calls `name := StructType(args)` so
            // that spread destructuring `{f: v, ...} := name` can resolve remaining fields.
            match(
              rhs_expr,
              .Atom(_, _) => (),
              .FnCall(_, sc_fn_box, _, sc_fn_infix, _) => cond(
                sc_fn_infix => (),
                true => match(
                  sc_fn_box.*,
                  .FnCall(_, _, _, _, _) => (),
                  .Atom(_, sctok) => match(
                    ctx.*.get_struct_fields(sctok.value.as_str()),
                    .None => (),
                    .Some(sfields) => {
                      ctx.*.track_open_var(name_tok.value.as_str(), sfields.as_str());
                    }
                  )
                )
              )
            );
          },
          .Some(csv_s) => {
            ctx.*.track_open_var(name_tok.value.as_str(), csv_s.as_str());
          }
        );
        anon_struct_constructor_emitted := match(
          rhs_expr,
          .Atom(_, _) => false,
          .FnCall(_, rhs_ctor_fn, rhs_ctor_args, rhs_ctor_infix, _) => cond(
            rhs_ctor_infix => false,
            true => match(
              rhs_ctor_fn.*,
              .Atom(_, _) => false,
              .FnCall(_, rhs_ty_fn, rhs_ty_args, rhs_ty_infix, _) => cond(
                rhs_ty_infix => false,
                true => match(
                  rhs_ty_fn.*,
                  .FnCall(_, _, _, _, _) => false,
                  .Atom(_, rhs_ty_tok) => cond(
                    (rhs_ty_tok.value.as_str() != "struct") => false,
                    true => match(
                      anon_struct_type_to_c(rhs_ty_args),
                      .None => false,
                      .Some(anon_c_ty) => match(
                        anon_struct_initializer_to_c(rhs_ctor_args, ctx, indent),
                        .None => false,
                        .Some(init_c) => {
                          ctx.*.emitter.emit_string(indent);
                          ctx.*.emitter.emit_string(anon_c_ty);
                          ctx.*.emitter.emit(" ");
                          ctx.*.emitter.emit_string(sanitize_c_ident(name_tok.value.as_str()));
                          ctx.*.emitter.emit(" = ");
                          ctx.*.emitter.emit_string(init_c);
                          ctx.*.emitter.emit_line(";");
                          true
                        }
                      )
                    )
                  )
                )
              )
            )
          )
        );
        assignment_value_emitted := match(
          rhs_expr,
          .Atom(_, _) => false,
          .FnCall(_, asn_fn_box, asn_args, asn_infix, _) => cond(
            (!(asn_infix)) => false,
            (asn_args.len() != usize(2)) => false,
            true => match(
              asn_fn_box.*,
              .FnCall(_, _, _, _, _) => false,
              .Atom(_, asn_tok) => cond(
                (asn_tok.value.as_str() != "=") => false,
                true => match(
                  asn_args.get(usize(0)),
                  .None => false,
                  .Some(assign_lhs) => match(
                    assign_lhs,
                    .FnCall(_, _, _, _, _) => false,
                    .Atom(_, assign_lhs_tok) => cond(
                      ctx.*.is_array_var(assign_lhs_tok.value.as_str()) => match(
                        ctx.*.get_array_var_size(assign_lhs_tok.value.as_str()),
                        .None => false,
                        .Some(array_sz) => {
                          san_src_array := sanitize_c_ident(assign_lhs_tok.value.as_str());
                          san_old_array := sanitize_c_ident(name_tok.value.as_str());
                          ctx.*.emitter.emit_string(indent);
                          ctx.*.emitter.emit("__typeof__(");
                          ctx.*.emitter.emit_string(san_src_array);
                          ctx.*.emitter.emit("[0]) ");
                          ctx.*.emitter.emit_string(san_old_array);
                          ctx.*.emitter.emit("[");
                          ctx.*.emitter.emit_string(array_sz);
                          ctx.*.emitter.emit_line("];");
                          ctx.*.emitter.emit_string(indent);
                          ctx.*.emitter.emit("memcpy(");
                          ctx.*.emitter.emit_string(san_old_array);
                          ctx.*.emitter.emit(", ");
                          ctx.*.emitter.emit_string(san_src_array);
                          ctx.*.emitter.emit(", sizeof(");
                          ctx.*.emitter.emit_string(san_old_array);
                          ctx.*.emitter.emit_line("));");
                          ctx.*.register_array_var_with_size(name_tok.value.as_str(), array_sz.as_str());
                          match(
                            call_gen_expr(rhs_expr, ctx, indent),
                            .None => (),
                            .Some(assign_code) => if(assign_code.as_str() != "0", {
                              emit_as_stmt(assign_code, ctx, indent);
                            })
                          );
                          true
                        }
                      ),
                      true => {
                        ctx.*.emitter.emit_string(indent);
                        ctx.*.emitter.emit("__auto_type ");
                        ctx.*.emitter.emit_string(sanitize_c_ident(name_tok.value.as_str()));
                        ctx.*.emitter.emit(" = ");
                        ctx.*.emitter.emit_string(sanitize_c_ident(assign_lhs_tok.value.as_str()));
                        ctx.*.emitter.emit_line(";");
                        match(
                          call_gen_expr(rhs_expr, ctx, indent),
                          .None => (),
                          .Some(assign_code2) => if(assign_code2.as_str() != "0", {
                            emit_as_stmt(assign_code2, ctx, indent);
                          })
                        );
                        true
                      }
                    )
                  )
                )
              )
            )
          )
        );
        method_extraction_emitted := emit_method_extraction_macro_if_supported(name_tok.value.as_str(), rhs_expr, ctx, indent);
        // Special case: `b := arr_var` where arr_var is a registered C array — array copy.
        // Emit `__typeof__(arr_var[0]) b[N]; memcpy(b, arr_var, sizeof(b));`
        // and register b as an array var with the same size.
        arr_copy_emitted := match(
          rhs_expr,
          .FnCall(_, _, _, _, _) => false,
          .Atom(_, arr_cp_tok) => cond(
            (arr_cp_tok.kind != TokenKind.Identifier) => false,
            (!(ctx.*.is_array_var(arr_cp_tok.value.as_str()))) => false,
            true => match(
              ctx.*.get_array_var_size(arr_cp_tok.value.as_str()),
              .None => false,
              .Some(sz) => {
                san_src := sanitize_c_ident(arr_cp_tok.value.as_str());
                san_dst := sanitize_c_ident(name_tok.value.as_str());
                ctx.*.emitter.emit_string(indent);
                ctx.*.emitter.emit("__typeof__(");
                ctx.*.emitter.emit_string(san_src);
                ctx.*.emitter.emit("[0]) ");
                ctx.*.emitter.emit_string(san_dst);
                ctx.*.emitter.emit("[");
                ctx.*.emitter.emit_string(sz);
                ctx.*.emitter.emit_line("];");
                ctx.*.emitter.emit_string(indent);
                ctx.*.emitter.emit("memcpy(");
                ctx.*.emitter.emit_string(san_dst);
                ctx.*.emitter.emit(", ");
                ctx.*.emitter.emit_string(san_src);
                ctx.*.emitter.emit(", sizeof(");
                ctx.*.emitter.emit_string(san_dst);
                ctx.*.emitter.emit_line("));");
                ctx.*.register_array_var_with_size(name_tok.value.as_str(), sz.as_str());
                true
              }
            )
          )
        );
        // Special case: `b := Array(T, N)()` or `b := Array(T, N)(v0, v1, ...)`.
        // Array type-constructor call: FnCall(FnCall(Atom("Array"), [T, N], false), args, false).
        // Emit `T_c b[N] = {v0, v1, ...};` (or `= {0}` for empty args).
        arr_constructor_emitted := cond(
          arr_copy_emitted => false,
          true => match(
            rhs_expr,
            .Atom(_, _) => false,
            .FnCall(_, ac_fn_box, ac_fn_args, ac_fn_infix, _) => cond(
              ac_fn_infix => false,
              true => match(
                ac_fn_box.*,
                .Atom(_, _) => false,
                .FnCall(_, ac_inner_fn, ac_inner_args, ac_inner_infix, _) => cond(
                  ac_inner_infix => false,
                  (ac_inner_args.len() != usize(2)) => false,
                  true => match(
                    ac_inner_fn.*,
                    .FnCall(_, _, _, _, _) => false,
                    .Atom(_, ac_name_tok) => cond(
                      (ac_name_tok.value.as_str() != "Array") => false,
                      true => {
                        elem_c_opt := match(
                          ac_inner_args.get(usize(0)),
                          .None => Option(String).None,
                          .Some(e) => type_expr_to_c(e)
                        );
                        size_opt := match(
                          ac_inner_args.get(usize(1)),
                          .None => Option(String).None,
                          .Some(s) => match(
                            s,
                            .FnCall(_, _, _, _, _) => Option(String).None,
                            .Atom(_, stok) => cond(
                              (stok.kind == TokenKind.Integer) => Option(String).Some(stok.value),
                              (stok.kind == TokenKind.Identifier) => cond(
                                (stok.value.as_str() == "_") => Option(String).Some(ac_fn_args.len().to_string()),
                                true => Option(String).Some(stok.value)
                              ),
                              true => Option(String).None
                            )
                          )
                        );
                        match(
                          elem_c_opt,
                          .None => false,
                          .Some(ec) => match(
                            size_opt,
                            .None => false,
                            .Some(sz) => {
                              san_dst2 := sanitize_c_ident(name_tok.value.as_str());
                              // Build initializer list from constructor args (or {0} if empty)
                              init_buf := cond(
                                (ac_fn_args.len() == usize(0)) => String.from("{0}"),
                                true => {
                                  ib := String.from("{");
                                  (ib_i : usize) = usize(0);
                                  (ib_ok : bool) = true;
                                  while(runtime((ib_i < ac_fn_args.len()) && ib_ok), {
                                    match(
                                      ac_fn_args.get(ib_i),
                                      .None => {
                                        ib_ok = false;
                                      },
                                      .Some(av) => match(
                                        call_gen_expr(av, ctx, indent),
                                        .None => {
                                          ib_ok = false;
                                        },
                                        .Some(avc) => {
                                          if(ib_i > usize(0), {
                                            ib.push_str(", ");
                                          });
                                          ib.push_string(avc);
                                          ib_i = (ib_i + usize(1));
                                        }
                                      )
                                    );
                                  });
                                  ib.push_str("}");
                                  ib
                                }
                              );
                              ctx.*.emitter.emit_string(indent);
                              ctx.*.emitter.emit_string(ec);
                              ctx.*.emitter.emit(" ");
                              ctx.*.emitter.emit_string(san_dst2);
                              ctx.*.emitter.emit("[");
                              ctx.*.emitter.emit_string(sz);
                              ctx.*.emitter.emit("] = ");
                              ctx.*.emitter.emit_string(init_buf);
                              ctx.*.emitter.emit_line(";");
                              ctx.*.register_array_var_with_size(name_tok.value.as_str(), sz.as_str());
                              true
                            }
                          )
                        )
                      }
                    )
                  )
                )
              )
            )
          )
        );
        // Special case: `b := [v0, v1, v2]` — inline array literal.
        // `array` FnCall: FnCall(Atom("array"), [v0, v1, ...], false).
        // Emit `__typeof__(v0) b[N] = {v0, v1, ...};` using first element type via __typeof__.
        inline_array_emitted := match(
          rhs_expr,
          .Atom(_, _) => false,
          .FnCall(_, il_fn_box, il_fn_args, il_fn_infix, _) => cond(
            il_fn_infix => false,
            (il_fn_args.len() == usize(0)) => false,
            true => match(
              il_fn_box.*,
              .FnCall(_, _, _, _, _) => false,
              .Atom(_, il_fn_tok) => cond(
                (il_fn_tok.value.as_str() != "array") => false,
                true => {
                  n_il := il_fn_args.len();
                  // Generate all element expressions
                  init_il := String.from("{");
                  (il_i : usize) = usize(0);
                  (il_ok : bool) = true;
                  while(runtime((il_i < n_il) && il_ok), {
                    match(
                      il_fn_args.get(il_i),
                      .None => {
                        il_ok = false;
                      },
                      .Some(il_e) => match(
                        call_gen_expr(il_e, ctx, indent),
                        .None => {
                          il_ok = false;
                        },
                        .Some(il_c) => {
                          if(il_i > usize(0), {
                            init_il.push_str(", ");
                          });
                          init_il.push_string(il_c);
                          il_i = (il_i + usize(1));
                        }
                      )
                    );
                  });
                  cond(
                    (!(il_ok)) => false,
                    true => {
                      init_il.push_str("}");
                      // Emit: `__typeof__(v0) name[N] = {v0, v1, ...};`
                      // We regenerate first element for __typeof__ — or use
                      // the already-generated init_il[0] via a compound literal.
                      first_code_opt := match(
                        il_fn_args.get(usize(0)),
                        .None => Option(String).None,
                        .Some(fe) => call_gen_expr(fe, ctx, indent)
                      );
                      match(
                        first_code_opt,
                        .None => false,
                        .Some(first_c) => {
                          san_name := sanitize_c_ident(name_tok.value.as_str());
                          ctx.*.emitter.emit_string(indent);
                          ctx.*.emitter.emit("__typeof__(");
                          ctx.*.emitter.emit_string(first_c);
                          ctx.*.emitter.emit(") ");
                          ctx.*.emitter.emit_string(san_name);
                          ctx.*.emitter.emit("[");
                          ctx.*.emitter.emit_string(n_il.to_string());
                          ctx.*.emitter.emit("] = ");
                          ctx.*.emitter.emit_string(init_il);
                          ctx.*.emitter.emit_line(";");
                          ctx.*.register_array_var_with_size(name_tok.value.as_str(), n_il.to_string().as_str());
                          true
                        }
                      )
                    }
                  )
                }
              )
            )
          )
        );
        // Special case: `b := ArrayAlias(v0, v1, ...)` where `ArrayAlias :: [T; N]`.
        // Emit `elem_type b[N] = {v0, v1, ...};` instead of `__auto_type b = ...`.
        array_decl_emitted := cond(
          inline_array_emitted => true,
          true => match(
            rhs_expr,
            .Atom(_, _) => false,
            .FnCall(_, arr_fn_box, arr_fn_args, arr_fn_infix, _) => cond(
              arr_fn_infix => false,
              true => match(
                arr_fn_box.*,
                .FnCall(_, _, _, _, _) => false,
                .Atom(_, arr_fn_tok) => cond(
                  (arr_fn_tok.kind != TokenKind.Identifier) => false,
                  true => match(
                    ctx.*.get_array_alias_elem(arr_fn_tok.value.as_str()),
                    .None => false,
                    .Some(elem_c) => match(
                      ctx.*.get_array_alias_size(arr_fn_tok.value.as_str()),
                      .None => false,
                      .Some(arr_sz) => {
                        // Build initializer list `{v0, v1, ...}`
                        init_buf := String.from("{");
                        n_av := arr_fn_args.len();
                        (av_i : usize) = usize(0);
                        (av_ok : bool) = true;
                        while(runtime((av_i < n_av) && av_ok), {
                          match(
                            arr_fn_args.get(av_i),
                            .None => {
                              av_ok = false;
                            },
                            .Some(av_e) => match(
                              call_gen_expr(av_e, ctx, indent),
                              .None => {
                                av_ok = false;
                              },
                              .Some(av_c) => {
                                if(av_i > usize(0), {
                                  init_buf.push_str(", ");
                                });
                                init_buf.push_string(av_c);
                                av_i = (av_i + usize(1));
                              }
                            )
                          );
                        });
                        cond(
                          (!(av_ok)) => false,
                          true => {
                            init_buf.push_str("}");
                            // Emit: `elem_type name[N] = {v0, v1, ...};`
                            ctx.*.emitter.emit_string(indent);
                            ctx.*.emitter.emit_string(elem_c);
                            ctx.*.emitter.emit(" ");
                            ctx.*.emitter.emit_string(sanitize_c_ident(name_tok.value.as_str()));
                            ctx.*.emitter.emit("[");
                            ctx.*.emitter.emit_string(arr_sz.to_string());
                            ctx.*.emitter.emit("] = ");
                            ctx.*.emitter.emit_string(init_buf);
                            ctx.*.emitter.emit_line(";");
                            // Register as C array variable so arr(idx) → arr[idx]
                            ctx.*.register_array_var_with_size(name_tok.value.as_str(), arr_sz.to_string().as_str());
                            true
                          }
                        )
                      }
                    )
                  )
                )
              )
            )
          );
          cond(
            (anon_struct_constructor_emitted || (assignment_value_emitted || (method_extraction_emitted || (arr_copy_emitted || arr_constructor_emitted)))) =>
              Option(String).Some(String.from("0")),
            array_decl_emitted => Option(String).Some(String.from("0")),
            true => match(
              call_gen_expr(rhs_expr, ctx, indent),
              .None => Option(String).None,
              .Some(rhs_code) => {
                ctx.*.emitter.emit_string(indent);
                ctx.*.emitter.emit("__auto_type ");
                san_def_name := sanitize_c_ident(name_tok.value.as_str());
                ctx.*.emitter.emit_string(san_def_name);
                ctx.*.emitter.emit(" = ");
                ctx.*.emitter.emit_string(rhs_code);
                ctx.*.emitter.emit_line(";");
                // If RHS was an array/slice range call, register LHS as slice var
                is_slice_rhs := match(
                  rhs_expr,
                  .Atom(_, _) => false,
                  .FnCall(_, def_rhs_fn, def_rhs_args, def_rhs_infix, _) => cond(
                    def_rhs_infix => false,
                    (def_rhs_args.len() != usize(1)) => false,
                    true => match(
                      def_rhs_fn.*,
                      .FnCall(_, _, _, _, _) => false,
                      .Atom(_, def_rhs_tok) => cond(
                        (!(ctx.*.is_array_var(def_rhs_tok.value.as_str()) || ctx.*.is_slice_var(def_rhs_tok.value.as_str()))) => false,
                        true => match(
                          def_rhs_args.get(usize(0)),
                          .None => false,
                          .Some(range_arg) => match(
                            range_arg,
                            .Atom(_, _) => false,
                            .FnCall(_, range_fn2, range_args2, range_infix2, _) => cond(
                              (!(range_infix2 && (range_args2.len() == usize(2)))) => false,
                              true => match(
                                range_fn2.*,
                                .FnCall(_, _, _, _, _) => false,
                                .Atom(_, rtok2) => ((rtok2.value.as_str() == "..") || (rtok2.value.as_str() == "..="))
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                );
                if(is_slice_rhs, {
                  ctx.*.register_slice_var(name_tok.value.as_str());
                });
                if(is_slice_u8_from_raw_parts_call(rhs_expr), {
                  ctx.*.register_slice_var(name_tok.value.as_str());
                  ctx.*.register_var_type(name_tok.value.as_str(), "YoSlice_u8");
                });
                // If RHS is a `box(...)` call, register LHS as a box var for deref equality.
                is_box_rhs := match(
                  rhs_expr,
                  .Atom(_, _) => false,
                  .FnCall(_, box_fn, _box_args, box_infix, _) => cond(
                    box_infix => false,
                    true => match(
                      box_fn.*,
                      .FnCall(_, _, _, _, _) => false,
                      .Atom(_, box_tok) => (box_tok.value.as_str() == "box")
                    )
                  )
                );
                if(is_box_rhs, {
                  ctx.*.register_box_var(name_tok.value.as_str());
                });
                // If RHS is a struct/enum constructor call, track LHS variable's type
                // so that `(&var).to_string()` dispatch can find the type name.
                rhs_ctor_type := match(
                  rhs_expr,
                  .Atom(_, _) => Option(String).None,
                  .FnCall(_, def_rhs_fn, def_rhs_ctor_args, def_rhs_infix2, _) => cond(
                    // Non-infix: struct constructor `TypeName(...)` or enum `EnumName.Variant(...)`
                    (!(def_rhs_infix2)) => match(
                      def_rhs_fn.*,
                      // Plain constructor: `TypeName(...)` — fn is Atom
                      .Atom(_, def_rhs_ctok) => {
                        ctor_name := def_rhs_ctok.value.as_str();
                        cond(
                          (ctx.*.is_struct_name(ctor_name) || ctx.*.is_enum_name(ctor_name)) =>
                            Option(String).Some(String.from(ctor_name)),
                          true => Option(String).None
                        )
                      },
                      // Complex enum constructor: `EnumName.Variant(...)` — fn is dot-access FnCall
                      .FnCall(_, inner_fn, inner_args, inner_infix, _) => cond(
                        (!(inner_infix)) => Option(String).None,
                        (inner_args.len() != usize(2)) => Option(String).None,
                        true => match(
                          inner_fn.*,
                          .FnCall(_, _, _, _, _) => Option(String).None,
                          .Atom(_, dot_tok) => cond(
                            (dot_tok.value.as_str() != ".") => Option(String).None,
                            true => match(
                              inner_args.get(usize(0)),
                              .None => Option(String).None,
                              .Some(en_e) => match(
                                en_e,
                                .FnCall(_, _, _, _, _) => Option(String).None,
                                .Atom(_, etok2) => cond(
                                  (ctx.*.is_enum_name(etok2.value.as_str())) =>
                                    Option(String).Some(etok2.value),
                                  true => Option(String).None
                                )
                              )
                            )
                          )
                        )
                      )
                    ),
                    // Infix dot: `EnumName.Variant` (no args) → type is `EnumName`
                    true => cond(
                      (def_rhs_ctor_args.len() != usize(2)) => Option(String).None,
                      true => match(
                        def_rhs_fn.*,
                        .FnCall(_, _, _, _, _) => Option(String).None,
                        .Atom(_, def_rhs_dot_tok) => cond(
                          (def_rhs_dot_tok.value.as_str() != ".") => Option(String).None,
                          true => match(
                            def_rhs_ctor_args.get(usize(0)),
                            .None => Option(String).None,
                            .Some(lhs_e) => match(
                              lhs_e,
                              .FnCall(_, _, _, _, _) => Option(String).None,
                              .Atom(_, etok) => cond(
                                (ctx.*.is_enum_name(etok.value.as_str())) =>
                                  Option(String).Some(etok.value),
                                true => Option(String).None
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                );
                match(
                  rhs_ctor_type,
                  .None => {
                    // Also propagate type for `v2 := (&v1).clone()` or `v2 := v1.clone()`
                    // by detecting clone() method calls and copying the source var's type.
                    // If the RHS is a dot-method call with 0 args, extract the receiver var name.
                    clone_recv_var := match(
                      rhs_expr,
                      .Atom(_, _) => Option(String).None,
                      .FnCall(_, dot_box, dot_args, dot_infix, _) => cond(
                        dot_infix => Option(String).None,
                        (dot_args.len() != usize(0)) => Option(String).None,
                        true => match(
                          dot_box.*,
                          .Atom(_, _) => Option(String).None,
                          .FnCall(_, dot_fn2, dot_args2, dot_infix2, _) => cond(
                            (!(dot_infix2)) => Option(String).None,
                            (dot_args2.len() != usize(2)) => Option(String).None,
                            true => match(
                              dot_fn2.*,
                              .FnCall(_, _, _, _, _) => Option(String).None,
                              .Atom(_, dot_tok2) => cond(
                                (dot_tok2.value.as_str() != ".") => Option(String).None,
                                true => match(
                                  dot_args2.get(usize(1)),
                                  .None => Option(String).None,
                                  .Some(mname_e) => match(
                                    mname_e,
                                    .FnCall(_, _, _, _, _) => Option(String).None,
                                    .Atom(_, mname_tok) => cond(
                                      (mname_tok.value.as_str() != "clone") => Option(String).None,
                                      true => match(
                                        dot_args2.get(usize(0)),
                                        .None => Option(String).None,
                                        // Direct receiver: `v1.clone()` → receiver var is "v1"
                                        .Some(recv_e) => match(
                                          recv_e,
                                          .Atom(_, recv_tok) => cond(
                                            (recv_tok.kind != TokenKind.Identifier) => Option(String).None,
                                            true => Option(String).Some(recv_tok.value)
                                          ),
                                          // Ref receiver: `(&v1).clone()` → unwrap the `&`
                                          .FnCall(_, ref_fn3, ref_args3, ref_infix3, _) => cond(
                                            ref_infix3 => Option(String).None,
                                            (ref_args3.len() != usize(1)) => Option(String).None,
                                            true => match(
                                              ref_fn3.*,
                                              .FnCall(_, _, _, _, _) => Option(String).None,
                                              .Atom(_, ref_tok3) => cond(
                                                (ref_tok3.value.as_str() != "&") => Option(String).None,
                                                true => match(
                                                  ref_args3.get(usize(0)),
                                                  .None => Option(String).None,
                                                  .Some(rv3) => match(
                                                    rv3,
                                                    .FnCall(_, _, _, _, _) => Option(String).None,
                                                    .Atom(_, rvtok3) => cond(
                                                      (rvtok3.kind != TokenKind.Identifier) => Option(String).None,
                                                      true => Option(String).Some(rvtok3.value)
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    );
                    // Propagate type from the clone source var to the define target
                    match(
                      clone_recv_var,
                      .None => {
                        match(
                          generic_static_constructor_type_from_call(rhs_expr),
                          .Some(generic_ctor_ty) => {
                            ctx.*.register_var_type(name_tok.value.as_str(), generic_ctor_ty.as_str());
                          },
                          .None => {
                            fn_return_ty := match(
                              rhs_expr,
                              .Atom(_, _) => Option(String).None,
                              .FnCall(_, ret_fn_box, _ret_args, ret_infix, _) => cond(
                                ret_infix => Option(String).None,
                                true => match(
                                  ret_fn_box.*,
                                  .FnCall(_, _, _, _, _) => Option(String).None,
                                  .Atom(_, ret_fn_tok) => ctx.*.get_fn_return_type(ret_fn_tok.value.as_str())
                                )
                              )
                            );
                            match(
                              fn_return_ty,
                              .None => (),
                              .Some(ret_ty_name) => {
                                ctx.*.register_var_type(name_tok.value.as_str(), ret_ty_name.as_str());
                              }
                            );
                          }
                        );
                      },
                      .Some(src_var) => match(
                        ctx.*.get_var_type(src_var.as_str()),
                        .None => (),
                        .Some(src_ty) => {
                          ctx.*.register_var_type(name_tok.value.as_str(), src_ty.as_str());
                        }
                      )
                    );
                  },
                  .Some(ctor_ty) => {
                    ctx.*.register_var_type(name_tok.value.as_str(), ctor_ty.as_str());
                  }
                );
                Option(String).Some(String.from("0"))
              }
            )
          )
        },
        // Destructuring: (a, b, c) := rhs  OR  {x, y} := rhs  OR  {x: a, y: b} := rhs
        // Also handles: given(name) := rhs — emit as regular define of inner name.
        .FnCall(_, destr_func, destr_args, destr_infix, _) => cond(
          // Single-field struct destructuring `{ x : alias } := rhs` can parse as
          // the bare infix `x : alias` rather than an anonymous-struct wrapper.
          destr_infix => match(
            destr_func.*,
            .FnCall(_, _, _, _, _) => Option(String).None,
            .Atom(_, single_field_tok) => cond(
              ((single_field_tok.value.as_str() == ":") && (destr_args.len() == usize(2))) => match(
                destr_args.get(usize(0)),
                .None => Option(String).None,
                .Some(single_field_e) => match(
                  single_field_e,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, single_field_name) => match(
                    destr_args.get(usize(1)),
                    .None => Option(String).None,
                    .Some(single_var_e) => match(
                      single_var_e,
                      .FnCall(_, _, _, _, _) => Option(String).None,
                      .Atom(_, single_var_name) => match(
                        call_gen_expr(rhs_expr, ctx, indent),
                        .None => Option(String).None,
                        .Some(single_rhs_code) => {
                          tmp_single := ctx.*.fresh_temp();
                          ctx.*.emitter.emit_string(indent);
                          ctx.*.emitter.emit("__auto_type ");
                          ctx.*.emitter.emit_string(tmp_single);
                          ctx.*.emitter.emit(" = ");
                          ctx.*.emitter.emit_string(single_rhs_code);
                          ctx.*.emitter.emit_line(";");
                          ctx.*.emitter.emit_string(indent);
                          ctx.*.emitter.emit("__auto_type ");
                          ctx.*.emitter.emit_string(sanitize_c_ident(single_var_name.value.as_str()));
                          ctx.*.emitter.emit(" = ");
                          ctx.*.emitter.emit_string(tmp_single);
                          ctx.*.emitter.emit(".");
                          ctx.*.emitter.emit_string(single_field_name.value);
                          ctx.*.emitter.emit_line(";");
                          Option(String).Some(String.from("0"))
                        }
                      )
                    )
                  )
                )
              ),
              true => Option(String).None
            )
          ),
          true => {
            // Check for `given(name) := rhs` — treat as regular variable define
            is_given := match(
              destr_func.*,
              .FnCall(_, _, _, _, _) => false,
              .Atom(_, gtok) => (gtok.value.as_str() == "given")
            );
            cond(
              (is_given && (destr_args.len() == usize(1))) =>
                match(
                  destr_args.get(usize(0)),
                  .None => Option(String).None,
                  .Some(inner_name_e) => match(
                    inner_name_e,
                    .FnCall(_, _, _, _, _) => Option(String).None,
                    .Atom(_, inner_tok) => match(
                      call_gen_expr(rhs_expr, ctx, indent),
                      .None => Option(String).None,
                      .Some(rhs_code) => {
                        san := sanitize_c_ident(inner_tok.value.as_str());
                        ctx.*.emitter.emit_string(indent);
                        ctx.*.emitter.emit("__auto_type ");
                        ctx.*.emitter.emit_string(san);
                        ctx.*.emitter.emit(" = ");
                        ctx.*.emitter.emit_string(rhs_code);
                        ctx.*.emitter.emit_line(";");
                        .Some(String.from("0"))
                      }
                    )
                  )
                ),
              true => {
                destr_kind_opt := match(
                  destr_func.*,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, dtok) => cond(
                    (dtok.value.as_str() == BK_TUPLE) => Option(String).Some(String.from("tuple")),
                    (dtok.value.as_str() == BK_ANON_STRUCT) => Option(String).Some(String.from("struct")),
                    (
                      (dtok.value.as_str() == BK_BEGIN) && (
                        (destr_args.len() == usize(1)) &&
                          match(
                            destr_args.get(usize(0)),
                            .None => false,
                            .Some(single_begin_arg) => match(
                              single_begin_arg,
                              .Atom(_, _) => true,
                              .FnCall(_, single_begin_fn, single_begin_args, single_begin_infix, _) => (
                                (single_begin_infix && (single_begin_args.len() == usize(2))) &&
                                  match(
                                    single_begin_fn.*,
                                    .Atom(_, single_begin_tok) => (single_begin_tok.value.as_str() == ":"),
                                    .FnCall(_, _, _, _, _) => false
                                  )
                              )
                            )
                          )
                      )
                    ) => Option(String).Some(String.from("struct")),
                    true => Option(String).None
                  )
                );
                match(
                  destr_kind_opt,
                  .None => Option(String).None,
                  .Some(destr_kind) => {
                    // Check if args are labeled (field: var) or positional
                    all_labeled := {
                      (la : bool) = (destr_args.len() > usize(0));
                      (lai : usize) = usize(0);
                      while(runtime((lai < destr_args.len()) && la), {
                        match(
                          destr_args.get(lai),
                          .None => {
                            la = false;
                          },
                          .Some(da) => match(
                            da,
                            // A plain atom means this is a positional (not labeled) destructuring.
                            .Atom(_, _) => {
                              la = false;
                            },
                            .FnCall(_, dff, dfa, dfinfix, _) => {
                              is_colon_pair2 := (
                                (dfinfix && (dfa.len() == usize(2))) && match(
                                  dff.*,
                                  .Atom(_, dftok) => (dftok.value.as_str() == ":"),
                                  .FnCall(_, _, _, _, _) => false
                                )
                              );
                              if(!(is_colon_pair2), {
                                la = false;
                              });
                            }
                          )
                        );
                        lai = (lai + usize(1));
                      });
                      la
                    };
                    // Generate RHS expression first
                    rhs_code_opt := call_gen_expr(rhs_expr, ctx, indent);
                    match(
                      rhs_code_opt,
                      .None => Option(String).None,
                      .Some(rhs_code) => {
                        // Use a temp variable to avoid evaluating RHS multiple times
                        tmp := ctx.*.fresh_temp();
                        tmp_decl := String.from(indent.as_str());
                        tmp_decl.push_str("__auto_type ");
                        tmp_decl.push_string(tmp);
                        tmp_decl.push_str(" = ");
                        tmp_decl.push_string(rhs_code);
                        tmp_decl.push_str(";");
                        ctx.*.emitter.emit_string_line(tmp_decl);
                        // Emit per-field bindings
                        nd := destr_args.len();
                        (di : usize) = usize(0);
                        (ok_destr : bool) = true;
                        // Track bound field names for spread (`...`) support.
                        (bound_fields : ArrayList(String)) = ArrayList(String).new();
                        while(runtime((di < nd) && ok_destr), {
                          match(
                            destr_args.get(di),
                            .None => {
                              ok_destr = false;
                            },
                            .Some(da) => cond(
                              // Labeled: (field: var_name) or {field: var_name}
                              all_labeled => match(
                                da,
                                .Atom(_, _) => {
                                  ok_destr = false;
                                },
                                .FnCall(_, _, dfa2, _, _) => match(
                                  dfa2.get(usize(0)),
                                  .None => {
                                    ok_destr = false;
                                  },
                                  .Some(field_e) => match(
                                    field_e,
                                    .FnCall(_, _, _, _, _) => {
                                      ok_destr = false;
                                    },
                                    .Atom(_, field_tok) => match(
                                      dfa2.get(usize(1)),
                                      .None => {
                                        ok_destr = false;
                                      },
                                      .Some(var_e) => match(
                                        var_e,
                                        .FnCall(_, _, _, _, _) => {
                                          ok_destr = false;
                                        },
                                        .Atom(_, var_tok) => cond(
                                          // Spread `...`: emit remaining unbound fields from source struct.
                                          (field_tok.value.as_str() == "...") => {
                                            match(
                                              ctx.*.get_open_var_fields(rhs_code.as_str()),
                                              .None => (),
                                              .Some(all_fields_csv) => {
                                                all_fields := _split_csv(all_fields_csv.as_str());
                                                (af_i : usize) = usize(0);
                                                while(runtime(af_i < all_fields.len()), {
                                                  match(
                                                    all_fields.get(af_i),
                                                    .None => (),
                                                    .Some(af_name) => {
                                                      // Skip if already bound.
                                                      (already_bound : bool) = false;
                                                      (bf_i : usize) = usize(0);
                                                      while(runtime((bf_i < bound_fields.len()) && (!(already_bound))), {
                                                        match(
                                                          bound_fields.get(bf_i),
                                                          .None => (),
                                                          .Some(bf) => {
                                                            if(bf.as_str() == af_name.as_str(), {
                                                              already_bound = true;
                                                            });
                                                          }
                                                        );
                                                        bf_i = (bf_i + usize(1));
                                                      });
                                                      if(!(already_bound), {
                                                        spread_bind := String.from(indent.as_str());
                                                        spread_bind.push_str("__auto_type ");
                                                        spread_bind.push_string(af_name);
                                                        spread_bind.push_str(" = ");
                                                        spread_bind.push_string(tmp);
                                                        spread_bind.push_str(".");
                                                        spread_bind.push_string(af_name);
                                                        spread_bind.push_str(";");
                                                        ctx.*.emitter.emit_string_line(spread_bind);
                                                      });
                                                    }
                                                  );
                                                  af_i = (af_i + usize(1));
                                                });
                                              }
                                            );
                                          },
                                          // Normal labeled binding.
                                          true => {
                                            bound_fields.push(field_tok.value);
                                            binding := String.from(indent.as_str());
                                            binding.push_str("__auto_type ");
                                            binding.push_string(var_tok.value);
                                            binding.push_str(" = ");
                                            binding.push_string(tmp);
                                            binding.push_str(".");
                                            binding.push_string(field_tok.value);
                                            binding.push_str(";");
                                            ctx.*.emitter.emit_string_line(binding);
                                          }
                                        )
                                      )
                                    )
                                  )
                                )
                              ),
                              // Positional: each arg is a plain atom (var name)
                              true => match(
                                da,
                                .FnCall(_, _, _, _, _) => {
                                  ok_destr = false;
                                },
                                .Atom(_, datom) => {
                                  var_name_p := datom.value;
                                  // Build "._N" for tuple (positional) or ".name" for struct (by name).
                                  field_ref := cond(
                                    (destr_kind.as_str() == "tuple") => _tuple_field_ref(di),
                                    true => {
                                      r2 := String.from(".");
                                      r2.push_string(var_name_p);
                                      r2
                                    }
                                  );
                                  binding2 := String.from(indent.as_str());
                                  binding2.push_str("__auto_type ");
                                  binding2.push_string(var_name_p);
                                  binding2.push_str(" = ");
                                  binding2.push_string(tmp);
                                  binding2.push_string(field_ref);
                                  binding2.push_str(";");
                                  ctx.*.emitter.emit_string_line(binding2);
                                }
                              )
                            )
                          );
                          di = (di + usize(1));
                        });
                        cond(
                          ok_destr => Option(String).Some(String.from("0")),
                          true => Option(String).None
                        )
                      }
                    )
                  }
                )
              }
            )
          }
        )
      )
    )
  }
);
/// True if `name` is a builtin keyword handled specially by `generate_expr`.
///
/// These names must NOT be treated as regular function calls.
is_builtin_keyword :: (fn(name : str) -> bool)(
  cond(
    (name == BK_BEGIN) => true,
    (name == "cond") => true,
    (name == "while") => true,
    (name == "for") => true,
    (name == "if") => true,
    (name == "runtime") => true,
    (name == "match") => true,
    (name == "recur") => true,
    (name == "escape") => true,
    (name == "return") => true,
    (name == "assert") => true,
    (name == "comptime_assert") => true,
    (name == "comptime_expect_error") => true,
    // Unit value: FnCall(Atom("tuple"), [], …) — the zero-arg tuple is unit
    (name == BK_TUPLE) => true,
    // Empty anon struct: FnCall(Atom("_"), [], …) from `{ }` — also unit
    (name == BK_ANON_STRUCT) => true,
    // Yo language keywords with no C equivalent — return None in generate_expr
    (name == "struct") => true,
    (name == "enum") => true,
    (name == "trait") => true,
    (name == "typeof") => true,
    (name == "forall") => true,
    // Runtime constructs not supported in prototype codegen — return None
    (name == "box") => true,
    (name == "array") => true,
    // Note: "open" is handled explicitly before this check in generate_expr
    (name == "import") => true,
    // using(name) at expression level — strip wrapper, emit inner
    (name == "using") => true,
    // given(name) at expression level — compile-time only, skip
    (name == "given") => true,
    (name == "break") => true,
    (name == "continue") => true,
    true => false
  )
);
/// True if `func_box` wraps a `TokenKind.Dot` atom.
///
/// Handle bare `.Variant` pattern in match arms (no receiver).
///
/// `.Variant` is parsed as `FnCall(Dot, [Atom("Variant")], is_infix=false)`.
/// Looks up the variant name in the context's variant registry to find the
/// owning enum name, then returns `"EnumName_Variant"`.
///
/// Returns `None` if the variant is not registered in the context.
handle_bare_dot_variant :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext)
  ) -> Option(String)
)(
  match(
    args.get(usize(0)),
    .None => Option(String).None,
    .Some(variant_expr) => match(
      variant_expr,
      .FnCall(_, _, _, _, _) => Option(String).None,
      .Atom(_, vtok) => match(
        ctx.*.get_enum_for_variant(vtok.value.as_str()),
        .None => Option(String).None,
        .Some(enum_name) => {
          result := String.new();
          result.push_string(enum_name);
          result.push_str("_");
          result.push_string(vtok.value);
          Option(String).Some(result)
        }
      )
    )
  )
);
func_box_is_dot :: (fn(func_box : Box(AstExpr)) -> bool)(
  match(
    func_box.*,
    .Atom(_, ftok) => (ftok.kind == TokenKind.Dot),
    .FnCall(_, _, _, _, _) => false
  )
);
/// True if `func_box` wraps a FnCall that is itself a dot-access expression.
///
/// This pattern identifies method calls of the form `a.method(args)`, which
/// are parsed as `FnCall(FnCall(Dot, [a, method], true), [args], false)`.
func_box_is_dot_dispatch :: (fn(func_box : Box(AstExpr)) -> bool)(
  match(
    func_box.*,
    .Atom(_, _) => false,
    .FnCall(_, inner_func, _, inner_infix, _) => (
      inner_infix && match(
        inner_func.*,
        .Atom(_, ftok) => (ftok.kind == TokenKind.Dot),
        .FnCall(_, _, _, _, _) => false
      )
    )
  )
);
/// True if `expr` is a non-capturing lambda: infix `->` with a TUPLE or bare-identifier LHS.
/// e.g. `(u) -> (u + 1)` — single param parsed as bare Atom after grouping.
/// e.g. `(u, v) -> (u + v)` — multi-param parsed as a TUPLE FnCall.
/// As opposed to a function-type annotation `fn(u:i32) -> i32`.
is_lambda_expr :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, lf, largs, lis_infix, _) => cond(
      (!(lis_infix)) => false,
      (largs.len() != usize(2)) => false,
      true => match(
        lf.*,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, lt) => cond(
          (lt.value.as_str() != "->") => false,
          true => match(
            largs.get(usize(0)),
            .None => false,
            .Some(lhs) => match(
              lhs,
              // Single param: `(u)` is parsed as bare Atom("u") after grouping.
              .Atom(_, lat) => (lat.kind == TokenKind.Identifier),
              // Multi-param tuple: `(u, v)` parsed as FnCall(Atom("tuple"), ...).
              .FnCall(_, llf, _, llis, _) => (
                (!(llis)) && match(
                  llf.*,
                  .FnCall(_, _, _, _, _) => false,
                  .Atom(_, llt) => (llt.value.as_str() == BK_TUPLE)
                )
              )
            )
          )
        )
      )
    )
  )
);
/// Extract parameter names from a lambda params expression.
/// Handles both single bare identifier `(u)` → ["u"] and TUPLE `(u, v)` → ["u", "v"].
extract_lambda_param_names :: (fn(params_expr : AstExpr) -> ArrayList(String))(
  match(
    params_expr,
    // Single param: `(u)` is parsed as bare Atom("u") after grouping.
    .Atom(_, ptok) => {
      names := ArrayList(String).new();
      if(ptok.kind == TokenKind.Identifier, {
        names.push(sanitize_c_ident(ptok.value.as_str()));
      });
      names
    },
    .FnCall(_, _, pargs, _, _) => {
      names := ArrayList(String).new();
      np := pargs.len();
      (pi : usize) = usize(0);
      while(runtime(pi < np), {
        match(
          pargs.get(pi),
          .None => (),
          .Some(pe) => match(
            pe,
            .FnCall(_, _, _, _, _) => (),
            .Atom(_, ptok) => {
              if(ptok.kind == TokenKind.Identifier, {
                names.push(sanitize_c_ident(ptok.value.as_str()));
              });
            }
          )
        );
        pi = (pi + usize(1));
      });
      names
    }
  )
);
/// Split a C params string like `"int32_t, bool"` by `, ` or `,` into a list.
/// Handles simple types only (no nested function pointer params).
_split_c_params :: (fn(params_str : str) -> ArrayList(String))({
  result := ArrayList(String).new();
  total := params_str.len();
  cond(
    (total == usize(0)) => (),
    true => {
      s := String.from(params_str);
      (start : usize) = usize(0);
      while(runtime(start <= total), {
        sep_opt := s.index_of(String.from(","), start);
        sep := match(sep_opt,.Some(p) => p,.None => total);
        piece := s.substring(start, sep);
        // Trim leading spaces
        trimmed := {
          (ts : usize) = usize(0);
          pl := piece.len();
          while(runtime(ts < pl), {
            match(
              piece.at(ts),
              .None => {
                break;
              },
              .Some(r) => {
                if(r.char == u32(32), {
                  ts = (ts + usize(1));
                }, {
                  break;
                });
              }
            );
          });
          piece.substring(ts, pl)
        };
        if(trimmed.len() > usize(0), {
          result.push(trimmed);
        });
        start = (sep + usize(1));
      });
    }
  );
  result
});
/// Lift a non-capturing lambda to a static C function.
/// `lambda` must be `is_lambda_expr`. `fp_c_ty` is the expected function
/// pointer type like `"int32_t(*_FP_)(int32_t)"`.
/// Emits the static function to the declarations section and returns the name.
lift_non_capturing_lambda :: (
  fn(
    ctx : *(CodegenContext),
    lambda : AstExpr,
    fp_c_ty : String
  ) -> Option(String)
)(
  match(
    lambda,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, _, largs, _, _) => {
      params_expr_opt := largs.get(usize(0));
      body_expr_opt := largs.get(usize(1));
      match(
        params_expr_opt,
        .None => Option(String).None,
        .Some(params_expr) => match(
          body_expr_opt,
          .None => Option(String).None,
          .Some(body_expr) => {
            // Extract param names from TUPLE
            param_names := extract_lambda_param_names(params_expr);
            // Parse fp_c_ty to get ret type and param types.
            // Format: "ret(*_FP_)(p1, p2, ...)"
            fp_s := fp_c_ty.as_str();
            // Find "(*_FP_)(" marker — 8 chars
            marker := String.from("(*_FP_)(");
            marker_pos_opt := fp_c_ty.index_of(marker, usize(0));
            match(
              marker_pos_opt,
              .None => Option(String).None,
              .Some(mpos) => {
                ret_ty := fp_c_ty.substring(usize(0), mpos);
                // After marker comes params string then ")"
                params_start := (mpos + usize(8));
                total_len := fp_c_ty.len();
                // params end just before final ")"
                params_end := cond(
                  (total_len > usize(0)) => (total_len - usize(1)),
                  true => usize(0)
                );
                params_str := fp_c_ty.substring(params_start, params_end);
                param_types := _split_c_params(params_str.as_str());
                n_pt := param_types.len();
                n_pn := param_names.len();
                // Generate a unique lambda name
                fn_name := ctx.*.fresh_lambda_name();
                // Build the C function declaration string
                lambda_code := {
                  sb := String.from("static ");
                  sb.push_string(ret_ty);
                  sb.push_str(" ");
                  sb.push_string(fn_name);
                  sb.push_str("(");
                  // params
                  n_params := cond(
                    (n_pt < n_pn) => n_pt,
                    true => n_pn
                  );
                  (pi : usize) = usize(0);
                  while(runtime(pi < n_params), {
                    if(pi > usize(0), {
                      sb.push_str(", ");
                    });
                    p_ty := match(param_types.get(pi),.Some(s) => s,.None => String.from("void*"));
                    p_nm := match(param_names.get(pi),.Some(s) => s,.None => String.from("_p"));
                    sb.push_string(build_typed_decl(p_ty.as_str(), p_nm.as_str()));
                    pi = (pi + usize(1));
                  });
                  // If no params, emit void
                  if((n_params == usize(0)) && (n_pt == usize(0)), {
                    sb.push_str("void");
                  });
                  sb.push_str(")({\n  return)");
                  // Register params temporarily so body can use them
                  {
                    (ri : usize) = usize(0);
                    while(runtime(ri < n_params), {
                      p_ty2 := match(param_types.get(ri),.Some(s) => s,.None => String.from("void*"));
                      p_nm2 := match(param_names.get(ri),.Some(s) => s,.None => String.from("_p"));
                      ctx.*.register_var_type(p_nm2.as_str(), p_ty2.as_str());
                      ri = (ri + usize(1));
                    });
                  };
                  body_code := match(
                    call_gen_expr(body_expr, ctx, String.from("  ")),
                    .None => String.from("0"),
                    .Some(c) => c
                  );
                  sb.push_string(body_code);
                  sb.push_str(";\n}");
                  sb
                };
                ctx.*.emitter.emit_declaration_string_line(lambda_code);
                .Some(fn_name)
              }
            )
          }
        )
      )
    }
  )
);
/// Generate a comma-separated C argument list for `args`.
///
/// Returns `Some("")` for zero args.  Returns `None` if any arg fails to
/// generate.
gen_arg_list :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  result := String.new();
  (i : usize) = usize(0);
  (ok : bool) = true;
  while(runtime((i < n) && ok), {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg) => {
        // Unwrap `using(name)` at call sites: strip the `using` wrapper and
        // generate just the inner argument. In C, the evidence param is passed
        // like a regular argument.
        actual_arg := match(
          arg,
          .FnCall(_, ua_fn, ua_args, ua_infix, _) => cond(
            ((!(ua_infix)) && (ua_args.len() == usize(1))) =>
              match(
                ua_fn.*,
                .Atom(_, ua_tok) => cond(
                  (ua_tok.value.as_str() == "using") =>
                    match(
                      ua_args.get(usize(0)),
                      .Some(inner) => inner,
                      .None => arg
                    ),
                  true => arg
                ),
                .FnCall(_, _, _, _, _) => arg
              ),
            true => arg
          ),
          .Atom(_, _) => arg
        );
        match(
          call_gen_expr(actual_arg, ctx, indent),
          .None => {
            ok = false;
          },
          .Some(code) => {
            if(i > usize(0), {
              result.push_str(", ");
            });
            result.push_string(code);
          }
        );
      }
    );
    i = (i + usize(1));
  });
  cond(
    ok =>.Some(result),
    true => Option(String).None
  )
});
/// Handle regular function call `f(a, b)` → `f(a, b)`.
handle_regular_call :: (
  fn(
    ident_opt : Option(String),
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)(
  match(
    ident_opt,
    .None => Option(String).None,
    .Some(id) =>
      // Check array var first, then do regular arg list + call building.
      cond(
        // consume(expr) — no-op: just return the expression (emitted as stmt by caller)
        ((id.as_str() == "consume") && (args.len() == usize(1))) =>
          match(
            args.get(usize(0)),
            .None => Option(String).None,
            .Some(e) => call_gen_expr(e, ctx, indent)
          ),
        // Returned-array wrapper indexing: `arr(idx)` → `arr.data[idx]`.
        ((args.len() == usize(1)) && var_type_is(ctx, id.as_str(), "YoArray_i32")) => match(
          ctx.*.get_var_type(id.as_str()),
          .None => Option(String).None,
          .Some(id_ty) => cond(
            (id_ty.as_str() != "YoArray_i32") => Option(String).None,
            true => match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(array_idx_e) => match(
                call_gen_expr(array_idx_e, ctx, indent),
                .None => Option(String).None,
                .Some(array_idx_c) => {
                  array_index_code := String.new();
                  array_index_code.push_string(id);
                  array_index_code.push_str(".data[");
                  array_index_code.push_string(array_idx_c);
                  array_index_code.push_str("]");
                  Option(String).Some(array_index_code)
                }
              )
            )
          )
        ),
        // arr(start..end) — slice creation: emit compound literal {.data=&arr[start], .length=end-start}
        (ctx.*.is_array_var(id.as_str()) && (args.len() == usize(1))) =>
          match(
            args.get(usize(0)),
            .None => Option(String).None,
            .Some(arg_e) =>
              // Check if arg is a range `..` expression
              match(
                arg_e,
                .Atom(_, _) =>
                  // Plain index: arr[idx]
                  match(
                    call_gen_expr(arg_e, ctx, indent),
                    .None => Option(String).None,
                    .Some(idx_c) => {
                      r := String.new();
                      r.push_string(id);
                      r.push_str("[");
                      r.push_string(idx_c);
                      r.push_str("]");
                      Option(String).Some(r)
                    }
                  ),
                .FnCall(_, range_fn, range_args, range_infix, _) => cond(
                  // Is it an infix `..` with 2 args?
                  (range_infix && (range_args.len() == usize(2))) =>
                    match(
                      range_fn.*,
                      .FnCall(_, _, _, _, _) =>
                        // Not a range — treat as regular index
                        match(
                          call_gen_expr(arg_e, ctx, indent),
                          .None => Option(String).None,
                          .Some(idx_c) => {
                            r2 := String.new();
                            r2.push_string(id);
                            r2.push_str("[");
                            r2.push_string(idx_c);
                            r2.push_str("]");
                            Option(String).Some(r2)
                          }
                        ),
                      .Atom(_, rtok) => cond(
                        ((rtok.value.as_str() != "..") && (rtok.value.as_str() != "..=")) =>
                          // Not a range — treat as regular index
                          match(
                            call_gen_expr(arg_e, ctx, indent),
                            .None => Option(String).None,
                            .Some(idx_c) => {
                              r3 := String.new();
                              r3.push_string(id);
                              r3.push_str("[");
                              r3.push_string(idx_c);
                              r3.push_str("]");
                              Option(String).Some(r3)
                            }
                          ),
                        true =>
                          // Range or inclusive range — emit slice compound literal
                          match(
                            range_args.get(usize(0)),
                            .None => Option(String).None,
                            .Some(start_e) => match(
                              range_args.get(usize(1)),
                              .None => Option(String).None,
                              .Some(end_e) => match(
                                call_gen_expr(start_e, ctx, indent),
                                .None => Option(String).None,
                                .Some(start_c) => match(
                                  call_gen_expr(end_e, ctx, indent),
                                  .None => Option(String).None,
                                  .Some(end_c) => {
                                    san_arr := sanitize_c_ident(id.as_str());
                                    // Inclusive ..= adds 1 to the length
                                    length_expr := cond(
                                      (rtok.value.as_str() == "..=") => {
                                        le := String.from("(");
                                        le.push_string(end_c);
                                        le.push_str(") - (");
                                        le.push_string(start_c);
                                        le.push_str(") + 1");
                                        le
                                      },
                                      true => {
                                        le2 := String.from("(");
                                        le2.push_string(end_c);
                                        le2.push_str(") - (");
                                        le2.push_string(start_c);
                                        le2.push_str(")");
                                        le2
                                      }
                                    );
                                    // (struct { __typeof__(arr[0])* data; size_t length; }){.data=&arr[start], .length=...}
                                    r4 := String.from("(struct { __typeof__(");
                                    r4.push_string(san_arr);
                                    r4.push_str("[0])* data; size_t length; }){.data = &");
                                    r4.push_string(san_arr);
                                    r4.push_str("[");
                                    r4.push_string(start_c);
                                    r4.push_str("], .length = ");
                                    r4.push_string(length_expr);
                                    r4.push_str("}");
                                    Option(String).Some(r4)
                                  }
                                )
                              )
                            )
                          )
                      )
                    ),
                  true =>
                    // Not range — treat as regular index
                    match(
                      call_gen_expr(arg_e, ctx, indent),
                      .None => Option(String).None,
                      .Some(idx_c) => {
                        r5 := String.new();
                        r5.push_string(id);
                        r5.push_str("[");
                        r5.push_string(idx_c);
                        r5.push_str("]");
                        Option(String).Some(r5)
                      }
                    )
                )
              )
          ),
        // slice(idx) or slice(start..end) — slice element access or slice-of-slice
        (ctx.*.is_slice_var(id.as_str()) && (args.len() == usize(1))) =>
          match(
            args.get(usize(0)),
            .None => Option(String).None,
            .Some(sidx_e) =>
              match(
                sidx_e,
                .Atom(_, _) =>
                  // Plain index: slice.data[idx]
                  match(
                    call_gen_expr(sidx_e, ctx, indent),
                    .None => Option(String).None,
                    .Some(sidx_c) => {
                      rs := String.new();
                      rs.push_string(id);
                      rs.push_str(".data[");
                      rs.push_string(sidx_c);
                      rs.push_str("]");
                      Option(String).Some(rs)
                    }
                  ),
                .FnCall(_, srange_fn, srange_args, srange_infix, _) => cond(
                  (srange_infix && (srange_args.len() == usize(2))) =>
                    match(
                      srange_fn.*,
                      .FnCall(_, _, _, _, _) =>
                        match(
                          call_gen_expr(sidx_e, ctx, indent),
                          .None => Option(String).None,
                          .Some(sc) => {
                            rss := String.new();
                            rss.push_string(id);
                            rss.push_str(".data[");
                            rss.push_string(sc);
                            rss.push_str("]");
                            Option(String).Some(rss)
                          }
                        ),
                      .Atom(_, srtok) => cond(
                        ((srtok.value.as_str() != "..") && (srtok.value.as_str() != "..=")) =>
                          match(
                            call_gen_expr(sidx_e, ctx, indent),
                            .None => Option(String).None,
                            .Some(sc2) => {
                              rss2 := String.new();
                              rss2.push_string(id);
                              rss2.push_str(".data[");
                              rss2.push_string(sc2);
                              rss2.push_str("]");
                              Option(String).Some(rss2)
                            }
                          ),
                        true =>
                          // Slice-of-slice: {.data = &slice.data[start], .length = ...}
                          match(
                            srange_args.get(usize(0)),
                            .None => Option(String).None,
                            .Some(ss_start) => match(
                              srange_args.get(usize(1)),
                              .None => Option(String).None,
                              .Some(ss_end) => match(
                                call_gen_expr(ss_start, ctx, indent),
                                .None => Option(String).None,
                                .Some(ss_start_c) => match(
                                  call_gen_expr(ss_end, ctx, indent),
                                  .None => Option(String).None,
                                  .Some(ss_end_c) => {
                                    san_sl := sanitize_c_ident(id.as_str());
                                    ss_length := cond(
                                      (srtok.value.as_str() == "..=") => {
                                        sle := String.from("(");
                                        sle.push_string(ss_end_c);
                                        sle.push_str(") - (");
                                        sle.push_string(ss_start_c);
                                        sle.push_str(") + 1");
                                        sle
                                      },
                                      true => {
                                        sle2 := String.from("(");
                                        sle2.push_string(ss_end_c);
                                        sle2.push_str(") - (");
                                        sle2.push_string(ss_start_c);
                                        sle2.push_str(")");
                                        sle2
                                      }
                                    );
                                    rss3 := String.from("(struct { __typeof__(");
                                    rss3.push_string(san_sl);
                                    rss3.push_str(".data[0])* data; size_t length; }){.data = &");
                                    rss3.push_string(san_sl);
                                    rss3.push_str(".data[");
                                    rss3.push_string(ss_start_c);
                                    rss3.push_str("], .length = ");
                                    rss3.push_string(ss_length);
                                    rss3.push_str("}");
                                    Option(String).Some(rss3)
                                  }
                                )
                              )
                            )
                          )
                      )
                    ),
                  true =>
                    match(
                      call_gen_expr(sidx_e, ctx, indent),
                      .None => Option(String).None,
                      .Some(sc3) => {
                        rss4 := String.new();
                        rss4.push_string(id);
                        rss4.push_str(".data[");
                        rss4.push_string(sc3);
                        rss4.push_str("]");
                        Option(String).Some(rss4)
                      }
                    )
                )
              )
          ),
        // slice(start..end) — handled in the slice branch above.
        // (No dead branch needed here.)
        true => {
          n_rc := args.len();
          result_args := String.new();
          (i_rc : usize) = usize(0);
          (ok_rc : bool) = true;
          while(runtime((i_rc < n_rc) && ok_rc), {
            match(
              args.get(i_rc),
              .None => {
                ok_rc = false;
              },
              .Some(arg_rc) => {
                arg_code_opt := cond(
                  // If this arg is a non-capturing lambda, try to lift it.
                  is_lambda_expr(arg_rc) => {
                    param_ty_opt := ctx.*.get_fn_param_ty_at(id.as_str(), i_rc);
                    match(
                      param_ty_opt,
                      .None => call_gen_expr(arg_rc, ctx, indent),
                      .Some(cb_ty) => cond(
                        (cb_ty.contains(String.from("_FP_"))) =>
                          lift_non_capturing_lambda(ctx, arg_rc, cb_ty),
                        true => call_gen_expr(arg_rc, ctx, indent)
                      )
                    )
                  },
                  true => call_gen_expr(arg_rc, ctx, indent)
                );
                match(
                  arg_code_opt,
                  .None => {
                    ok_rc = false;
                  },
                  .Some(code_rc) => {
                    if(i_rc > usize(0), {
                      result_args.push_str(", ");
                    });
                    result_args.push_string(code_rc);
                  }
                );
              }
            );
            i_rc = (i_rc + usize(1));
          });
          cond(
            (!(ok_rc)) => Option(String).None,
            // If the callee is a comptime-only function, emit `0` (a no-op placeholder).
            ctx.*.is_skipped_fn(id.as_str()) => Option(String).Some(String.from("0")),
            true => {
              result := String.new();
              if(ctx.*.is_defined_fn(id.as_str()), {
                result.push_str("fn_");
              });
              result.push_string(id);
              result.push_str("(");
              result.push_string(result_args);
              result.push_str(")");
              Option(String).Some(result)
            }
          )
        }
      )
  )
);
/// Handle dot field access `obj.field` → `obj.field` (struct) or `Enum_Variant` (enum).
///
/// `args[0]` is the receiver; `args[1]` is expected to be an Atom holding
/// the field/variant name.
///
/// If the object is an enum type registered in `ctx` (e.g. `Color`), emits
/// `Color_Red` instead of `Color.Red` to match the C enum constant convention.
handle_dot_access :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  obj_opt := args.get(usize(0));
  field_opt := args.get(usize(1));
  match(
    obj_opt,
    .None => Option(String).None,
    .Some(obj_expr) => match(
      field_opt,
      .None => Option(String).None,
      .Some(field_expr) => match(
        call_gen_expr(obj_expr, ctx, indent),
        .None => Option(String).None,
        .Some(obj_code) => {
          field_name_opt := match(
            field_expr,
            .Atom(_, ftok) => Option(String).Some(ftok.value),
            .FnCall(_, _, _, _, _) => Option(String).None
          );
          match(
            field_name_opt,
            .None => Option(String).None,
            .Some(fname) => {
              is_enum := ctx.*.is_enum_name(obj_code.as_str());
              is_deref := (fname.as_str() == "*");
              // Check if `obj_code` is a pointer variable — if so, emit `obj->field`.
              is_ptr_var := ctx.*.var_type_is_ptr(obj_code.as_str());
              // `rune` is a zero-cost newtype over u32.  In C it is `typedef uint32_t rune;`
              // so there is no `.char` field — the `.char` accessor is an identity.
              is_char_field := (fname.as_str() == "char");
              is_arraylist_u8 := match(
                ctx.*.get_var_type(obj_code.as_str()),
                .None => false,
                .Some(obj_ty) => (obj_ty.as_str() == "ArrayList_u8")
              );
              cond(
                is_deref => {
                  // c.* → (*c) — pointer dereference
                  result := String.from("(*");
                  result.push_string(obj_code);
                  result.push_str(")");
                  Option(String).Some(result)
                },
                is_char_field => Option(String).Some(obj_code),
                (is_arraylist_u8 && (fname.as_str() == "_ptr")) => {
                  result_ptr := String.from("((");
                  result_ptr.push_string(obj_code);
                  result_ptr.push_str(".length > 0) ? &");
                  result_ptr.push_string(obj_code);
                  result_ptr.push_str(".data[0] : NULL)");
                  Option(String).Some(result_ptr)
                },
                is_enum => {
                  result := String.new();
                  result.push_string(obj_code);
                  result.push_str("_");
                  result.push_string(fname);
                  Option(String).Some(result)
                },
                is_ptr_var => {
                  // Pointer variable: emit `obj->field`
                  result := String.new();
                  result.push_string(obj_code);
                  result.push_str("->");
                  is_index_field := match(
                    fname.at(usize(0)),
                    .None => false,
                    .Some(r) => ((r.char >= u32(48)) && (r.char <= u32(57)))
                  );
                  field_c_name := fname.replace(String.from("."), String.from("._"));
                  if(is_index_field, {
                    result.push_str("_");
                  });
                  result.push_string(field_c_name);
                  Option(String).Some(result)
                },
                true => {
                  result := String.new();
                  result.push_string(obj_code);
                  result.push_str(".");
                  // Tuple/array index access: .0, .1, … → ._0, ._1, …
                  // In C, tuple fields are named _0, _1, … (underscore prefix).
                  is_index_field := match(
                    fname.at(usize(0)),
                    .None => false,
                    .Some(r) => ((r.char >= u32(48)) && (r.char <= u32(57)))
                  );
                  field_c_name := fname.replace(String.from("."), String.from("._"));
                  if(is_index_field, {
                    result.push_str("_");
                  });
                  result.push_string(field_c_name);
                  Option(String).Some(result)
                }
              )
            }
          )
        }
      )
    )
  )
});
/// Extract the receiver expression from a dot-dispatch `func_box`.
get_dispatch_receiver :: (fn(func_box : Box(AstExpr)) -> Option(AstExpr))(
  match(
    func_box.*,
    .Atom(_, _) => Option(AstExpr).None,
    .FnCall(_, _, dot_args, _, _) => dot_args.get(usize(0))
  )
);
/// Extract the method name string from a dot-dispatch `func_box`.
get_dispatch_method :: (fn(func_box : Box(AstExpr)) -> Option(String))(
  match(
    func_box.*,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, _, dot_args, _, _) => match(
      dot_args.get(usize(1)),
      .None => Option(String).None,
      .Some(method_expr) => match(
        method_expr,
        .Atom(_, mtok) => Option(String).Some(mtok.value),
        .FnCall(_, _, _, _, _) => Option(String).None
      )
    )
  )
);
/// Handle method call `obj.method(args)` → C method call expression.
///
/// Two special cases support template string codegen:
///
/// - `x.to_string()` (zero args): the Yo parser emits this for every part of a
///   template string.  We strip the call and pass the receiver through, so
///   `"hello ".to_string()` → `"hello "` and `name.to_string()` → `name`.
///
/// - `a.+(b)` (one arg, Operator "+" as method): the Yo parser emits this to
///   chain template-string parts.  We emit `__yo_str_concat(a, b)` which is
///   defined in the generated C preamble.
///
/// All other method calls are emitted as `recv.method(args)`.
handle_method_call :: (
  fn(
    func_box : Box(AstExpr),
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  recv_opt := get_dispatch_receiver(func_box);
  method_opt := get_dispatch_method(func_box);
  match(
    recv_opt,
    .None => Option(String).None,
    .Some(recv_expr) => match(
      method_opt,
      .None => Option(String).None,
      .Some(method_name) => match(
        call_gen_expr(recv_expr, ctx, indent),
        .None => Option(String).None,
        .Some(recv_code) => cond(
          // Prototype lowering for standard Option/Result constructors. The
          // bootstrap codegen represents Some/Ok/Err as the payload value and
          // None as NULL; runtime methods below are lowered accordingly.
          (((recv_code.as_str() == "str") && (method_name.as_str() == "from_raw_parts")) && (args.len() == usize(2))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(str_ptr_e) => match(
                call_gen_expr(str_ptr_e, ctx, indent),
                .None => Option(String).None,
                .Some(str_ptr_c) => {
                  str_raw := String.from("(const char*)(");
                  str_raw.push_string(str_ptr_c);
                  str_raw.push_str(")");
                  Option(String).Some(str_raw)
                }
              )
            ),
          ((type_app_receiver_arg_is(recv_expr, "Slice", "u8") && (method_name.as_str() == "from_raw_parts")) && (args.len() == usize(2))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(slice_ptr_e) => match(
                args.get(usize(1)),
                .None => Option(String).None,
                .Some(slice_len_e) => match(
                  call_gen_expr(slice_ptr_e, ctx, indent),
                  .None => Option(String).None,
                  .Some(slice_ptr_c) => match(
                    call_gen_expr(slice_len_e, ctx, indent),
                    .None => Option(String).None,
                    .Some(slice_len_c) => {
                      slice_raw := String.from("(YoSlice_u8){.data = ");
                      slice_raw.push_string(slice_ptr_c);
                      slice_raw.push_str(", .length = ");
                      slice_raw.push_string(slice_len_c);
                      slice_raw.push_str("}");
                      Option(String).Some(slice_raw)
                    }
                  )
                )
              )
            ),
          ((type_app_receiver_is(recv_expr, "Array") && (method_name.as_str() == "fill")) && (args.len() == usize(1))) => match(
            array_i32_size_arg_to_c(recv_expr, ctx, indent),
            .None => Option(String).None,
            .Some(array_size_c) => match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(fill_value_e) => match(
                call_gen_expr(fill_value_e, ctx, indent),
                .None => Option(String).None,
                .Some(fill_value_c) => {
                  fill_call := String.from("__yo_array_i32_fill(");
                  fill_call.push_string(array_size_c);
                  fill_call.push_str(", ");
                  fill_call.push_string(fill_value_c);
                  fill_call.push_str(")");
                  Option(String).Some(fill_call)
                }
              )
            )
          ),
          ((type_app_receiver_is(recv_expr, "ArrayList") && (method_name.as_str() == "new")) && (args.len() == usize(0))) =>
            Option(String).Some(String.from("(ArrayList_u8){.data = {0}, .length = 0, ._ptr = NULL}")),
          ((generic_type_app_c_name(recv_expr).is_some() && (method_name.as_str() == "Some")) && (args.len() == usize(1))) =>
            match(args.get(usize(0)),.None => Option(String).None,.Some(v) => call_gen_expr(v, ctx, indent)),
          ((generic_type_app_c_name(recv_expr).is_some() && (method_name.as_str() == "None")) && (args.len() == usize(0))) =>
            Option(String).Some(String.from("NULL")),
          ((type_app_receiver_is(recv_expr, "Option") && (method_name.as_str() == "Some")) && (args.len() == usize(1))) =>
            match(args.get(usize(0)),.None => Option(String).None,.Some(v) => call_gen_expr(v, ctx, indent)),
          ((type_app_receiver_is(recv_expr, "Option") && (method_name.as_str() == "None")) && (args.len() == usize(0))) =>
            Option(String).Some(String.from("NULL")),
          ((type_app_receiver_is(recv_expr, "Result") && ((method_name.as_str() == "Ok") || (method_name.as_str() == "Err"))) && (args.len() == usize(1))) =>
            match(args.get(usize(0)),.None => Option(String).None,.Some(v) => call_gen_expr(v, ctx, indent)),
          (
            ((method_name.as_str() == "new") || (method_name.as_str() == "another_new")) &&
              (args.len() == usize(1)) &&
                (!(type_app_receiver_is(recv_expr, "Option") || type_app_receiver_is(recv_expr, "Result")))
          ) => match(
            generic_type_app_c_name(recv_expr),
            .None => Option(String).None,
            .Some(generic_type_name) => match(
              generic_type_app_field_c_type(recv_expr),
              .None => Option(String).None,
              .Some(generic_field_ty) => match(
                args.get(usize(0)),
                .None => Option(String).None,
                .Some(arg_e) => match(
                  call_gen_expr(arg_e, ctx, indent),
                  .None => Option(String).None,
                  .Some(arg_c) => {
                    ensure_generic_value_struct(ctx, generic_type_name, generic_field_ty);
                    result_generic_ctor := String.from("(");
                    result_generic_ctor.push_string(generic_type_name);
                    result_generic_ctor.push_str("){");
                    result_generic_ctor.push_string(arg_c);
                    result_generic_ctor.push_str("}");
                    Option(String).Some(result_generic_ctor)
                  }
                )
              )
            )
          ),
          // `arr.len()` on a registered C array variable — emit the known size constant.
          ((method_name.as_str() == "len") && ((args.len() == usize(0)) && ctx.*.is_array_var(recv_code.as_str()))) =>
            match(
              ctx.*.get_array_var_size(recv_code.as_str()),
              .None => Option(String).None,
              .Some(sz) => Option(String).Some(sz)
            ),
          // `slice.len()` on a registered C slice variable — emit `slice.length`.
          ((method_name.as_str() == "len") && ((args.len() == usize(0)) && ctx.*.is_slice_var(recv_code.as_str()))) => {
            sl_len := String.new();
            sl_len.push_string(recv_code);
            sl_len.push_str(".length");
            Option(String).Some(sl_len)
          },
          (ctx.*.get_var_type(recv_code.as_str()).is_some() && ((method_name.as_str() == "len") && (args.len() == usize(0)))) => match(
            ctx.*.get_var_type(recv_code.as_str()),
            .None => Option(String).None,
            .Some(recv_ty_for_array_len) => cond(
              (recv_ty_for_array_len.as_str() != "YoArray_i32") => Option(String).None,
              true => {
                array_len_code := String.new();
                array_len_code.push_string(recv_code);
                array_len_code.push_str(".length");
                Option(String).Some(array_len_code)
              }
            )
          ),
          // Bootstrap ArrayList(u8) value operations.
          (ctx.*.get_var_type(recv_code.as_str()).is_some() && ((method_name.as_str() == "push") && (args.len() == usize(1)))) => match(
            ctx.*.get_var_type(recv_code.as_str()),
            .None => Option(String).None,
            .Some(recv_ty_for_push) => cond(
              (recv_ty_for_push.as_str() != "ArrayList_u8") => Option(String).None,
              true => match(
                args.get(usize(0)),
                .None => Option(String).None,
                .Some(push_arg_expr) => match(
                  call_gen_expr(push_arg_expr, ctx, indent),
                  .None => Option(String).None,
                  .Some(push_arg_c) => {
                    push_code := String.from("(");
                    push_code.push_string(recv_code);
                    push_code.push_str(".data[");
                    push_code.push_string(recv_code);
                    push_code.push_str(".length++] = ");
                    push_code.push_string(push_arg_c);
                    push_code.push_str(", ");
                    push_code.push_string(recv_code);
                    push_code.push_str("._ptr = &");
                    push_code.push_string(recv_code);
                    push_code.push_str(".data[0])");
                    Option(String).Some(push_code)
                  }
                )
              )
            )
          ),
          (ctx.*.get_var_type(recv_code.as_str()).is_some() && ((method_name.as_str() == "len") && (args.len() == usize(0)))) => match(
            ctx.*.get_var_type(recv_code.as_str()),
            .None => Option(String).None,
            .Some(recv_ty_for_len) => cond(
              (recv_ty_for_len.as_str() != "ArrayList_u8") => Option(String).None,
              true => {
                list_len_code := String.new();
                list_len_code.push_string(recv_code);
                list_len_code.push_str(".length");
                Option(String).Some(list_len_code)
              }
            )
          ),
          // `str_lit.len()` / `str_const.len()` — str/String .len() → strlen(recv)
          ((method_name.as_str() == "len") && (args.len() == usize(0))) => {
            sl_len2 := String.from("strlen(");
            sl_len2.push_string(recv_code);
            sl_len2.push_str(")");
            Option(String).Some(sl_len2)
          },
          // `x.to_string()` — check for derive(ToString) first, else strip (template string part).
          ((method_name.as_str() == "to_string") && (args.len() == usize(0))) => {
            // Try to detect `var_name.to_string()` or `(&var_name).to_string()` where var_name has derive(ToString).
            tostr_result := match(
              recv_expr,
              // Direct atom receiver: `x.to_string()` → fn_TypeName_to_string(&x)
              .Atom(_, vatok_ts) => match(
                ctx.*.get_var_type(vatok_ts.value.as_str()),
                .None => Option(String).None,
                .Some(ty_name_a) => cond(
                  (!(ctx.*.has_derive_tostring(ty_name_a.as_str()))) => Option(String).None,
                  true => {
                    call_expr_a := String.from("fn_");
                    call_expr_a.push_string(ty_name_a);
                    call_expr_a.push_str("_to_string(&");
                    call_expr_a.push_string(recv_code);
                    call_expr_a.push_str(")");
                    Option(String).Some(call_expr_a)
                  }
                )
              ),
              .FnCall(_, ref_fn, ref_args, ref_infix, _) => cond(
                ref_infix => Option(String).None,
                (ref_args.len() != usize(1)) => Option(String).None,
                true => match(
                  ref_fn.*,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, rftok) => cond(
                    (rftok.value.as_str() != "&") => Option(String).None,
                    true => match(
                      ref_args.get(usize(0)),
                      .None => Option(String).None,
                      .Some(var_expr) => match(
                        var_expr,
                        .FnCall(_, _, _, _, _) => Option(String).None,
                        .Atom(_, vtok) => match(
                          ctx.*.get_var_type(vtok.value.as_str()),
                          .None => Option(String).None,
                          .Some(ty_name) => cond(
                            (!(ctx.*.has_derive_tostring(ty_name.as_str()))) => Option(String).None,
                            true => {
                              call_expr := String.from("fn_");
                              call_expr.push_string(ty_name);
                              call_expr.push_str("_to_string(");
                              call_expr.push_string(recv_code);
                              call_expr.push_str(")");
                              Option(String).Some(call_expr)
                            }
                          )
                        )
                      )
                    )
                  )
                )
              )
            );
            match(
              tostr_result,
              .Some(_) => tostr_result,
              .None => Option(String).Some(recv_code)
            )
          },
          // `x.clone()` — check for derive(Clone) on receiver type, emit fn_TypeName_clone(recv).
          // Supports both `(&x).clone()` and `x.clone()` forms.
          ((method_name.as_str() == "clone") && (args.len() == usize(0))) => {
            clone_result := match(
              recv_expr,
              // Direct atom: `orig.clone()` → fn_TypeName_clone(&orig)
              .Atom(_, vatok2) => match(
                ctx.*.get_var_type(vatok2.value.as_str()),
                .None => Option(String).None,
                .Some(ty_name_a) => cond(
                  (!(ctx.*.has_derive_clone(ty_name_a.as_str()))) => Option(String).None,
                  true => {
                    clone_expr_a := String.from("fn_");
                    clone_expr_a.push_string(ty_name_a);
                    clone_expr_a.push_str("_clone(&");
                    clone_expr_a.push_string(recv_code);
                    clone_expr_a.push_str(")");
                    Option(String).Some(clone_expr_a)
                  }
                )
              ),
              .FnCall(_, ref_fn2, ref_args2, ref_infix2, _) => cond(
                ref_infix2 => Option(String).None,
                (ref_args2.len() != usize(1)) => Option(String).None,
                true => match(
                  ref_fn2.*,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, rftok2) => cond(
                    (rftok2.value.as_str() != "&") => Option(String).None,
                    true => match(
                      ref_args2.get(usize(0)),
                      .None => Option(String).None,
                      .Some(var_expr2) => match(
                        var_expr2,
                        .FnCall(_, _, _, _, _) => Option(String).None,
                        .Atom(_, vtok2) => match(
                          ctx.*.get_var_type(vtok2.value.as_str()),
                          .None => Option(String).None,
                          .Some(ty_name2) => cond(
                            (!(ctx.*.has_derive_clone(ty_name2.as_str()))) => Option(String).None,
                            true => {
                              clone_expr := String.from("fn_");
                              clone_expr.push_string(ty_name2);
                              clone_expr.push_str("_clone(");
                              clone_expr.push_string(recv_code);
                              clone_expr.push_str(")");
                              Option(String).Some(clone_expr)
                            }
                          )
                        )
                      )
                    )
                  )
                )
              )
            );
            match(
              clone_result,
              .Some(_) => clone_result,
              .None => {
                result_cl := String.new();
                result_cl.push_string(recv_code);
                result_cl.push_str(".clone()");
                Option(String).Some(result_cl)
              }
            )
          },
          // `x.hash()` — check for derive(Hash) on receiver type, emit fn_TypeName_hash(recv).
          // Supports both `(&x).hash()` and `x.hash()` forms.
          ((method_name.as_str() == "hash") && (args.len() == usize(0))) => {
            hash_result := match(
              recv_expr,
              // Direct atom: `orig.hash()` → fn_TypeName_hash(&orig)
              .Atom(_, vatok_h) => match(
                ctx.*.get_var_type(vatok_h.value.as_str()),
                .None => Option(String).None,
                .Some(ty_name_ha) => cond(
                  (!(ctx.*.has_derive_hash(ty_name_ha.as_str()))) => Option(String).None,
                  true => {
                    hash_expr_a := String.from("fn_");
                    hash_expr_a.push_string(ty_name_ha);
                    hash_expr_a.push_str("_hash(&");
                    hash_expr_a.push_string(recv_code);
                    hash_expr_a.push_str(")");
                    Option(String).Some(hash_expr_a)
                  }
                )
              ),
              .FnCall(_, ref_fn_h, ref_args_h, ref_infix_h, _) => cond(
                ref_infix_h => Option(String).None,
                (ref_args_h.len() != usize(1)) => Option(String).None,
                true => match(
                  ref_fn_h.*,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, rftok_h) => cond(
                    (rftok_h.value.as_str() != "&") => Option(String).None,
                    true => match(
                      ref_args_h.get(usize(0)),
                      .None => Option(String).None,
                      .Some(var_expr_h) => match(
                        var_expr_h,
                        .FnCall(_, _, _, _, _) => Option(String).None,
                        .Atom(_, vtok_h) => match(
                          ctx.*.get_var_type(vtok_h.value.as_str()),
                          .None => Option(String).None,
                          .Some(ty_name_h) => cond(
                            (!(ctx.*.has_derive_hash(ty_name_h.as_str()))) => Option(String).None,
                            true => {
                              hash_expr := String.from("fn_");
                              hash_expr.push_string(ty_name_h);
                              hash_expr.push_str("_hash(");
                              hash_expr.push_string(recv_code);
                              hash_expr.push_str(")");
                              Option(String).Some(hash_expr)
                            }
                          )
                        )
                      )
                    )
                  )
                )
              )
            );
            match(
              hash_result,
              .Some(_) => hash_result,
              .None => {
                result_hf := String.new();
                result_hf.push_string(recv_code);
                result_hf.push_str(".hash()");
                Option(String).Some(result_hf)
              }
            )
          },
          // `a.+(b)` — template string concatenation: emit __yo_str_concat(a, b).
          ((method_name.as_str() == "+") && (args.len() == usize(1))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(arg_expr) => match(
                call_gen_expr(arg_expr, ctx, indent),
                .None => Option(String).None,
                .Some(arg_code) => {
                  result := String.from("__yo_str_concat(");
                  result.push_string(recv_code);
                  result.push_str(", ");
                  result.push_string(arg_code);
                  result.push_str(")");
                  Option(String).Some(result)
                }
              )
            ),
          // Static method call: `TypeName.method(args)` where TypeName is a registered struct/union.
          // Emits: `fn_TypeName_method(args)` instead of `TypeName.method(args)`.
          (
            match(
              recv_expr,
              .FnCall(_, _, _, _, _) => false,
              .Atom(_, recv_tok_method) => match(
                ctx.*.get_var_type(recv_tok_method.value.as_str()),
                .None => false,
                .Some(recv_ty_method) => ctx.*.is_defined_fn(`${ recv_ty_method }_${ method_name }`.as_str())
              )
            )
          ) => match(
            recv_expr,
            .FnCall(_, _, _, _, _) => Option(String).None,
            .Atom(_, recv_tok_method2) => match(
              ctx.*.get_var_type(recv_tok_method2.value.as_str()),
              .None => Option(String).None,
              .Some(recv_ty_method2) => match(
                gen_arg_list(args, ctx, indent),
                .None => Option(String).None,
                .Some(arg_s_method) => {
                  result_method := String.from("fn_");
                  result_method.push_string(recv_ty_method2);
                  result_method.push_str("_");
                  result_method.push_string(method_name);
                  result_method.push_str("(&");
                  result_method.push_string(recv_code);
                  if(arg_s_method.len() > usize(0), {
                    result_method.push_str(", ");
                    result_method.push_string(arg_s_method);
                  });
                  result_method.push_str(")");
                  Option(String).Some(result_method)
                }
              )
            )
          ),
          (ctx.*.is_struct_name(recv_code.as_str()) && ctx.*.is_defined_fn(`${ recv_code }_${ method_name }`.as_str())) =>
            match(
              gen_arg_list(args, ctx, indent),
              .None => Option(String).None,
              .Some(arg_s2) => {
                result_static := String.from("fn_");
                result_static.push_string(recv_code);
                result_static.push_str("_");
                result_static.push_string(method_name);
                result_static.push_str("(");
                result_static.push_string(arg_s2);
                result_static.push_str(")");
                Option(String).Some(result_static)
              }
            ),
          // Complex enum constructor: `EnumName.Variant(args…)`
          // Emits: `(EnumName){ .tag = EnumName_Variant, .data = { .Variant = { .f0 = a0, … } } }`
          (ctx.*.is_enum_name(recv_code.as_str()) && ctx.*.get_variant_fields(recv_code.as_str(), method_name.as_str()).is_some()) =>
            match(
              ctx.*.get_variant_fields(recv_code.as_str(), method_name.as_str()),
              .None => Option(String).None,
              .Some(fcsv) => {
                // Split CSV into field names
                field_names := _split_csv(fcsv.as_str());
                na := args.len();
                result := String.from("(");
                result.push_string(recv_code);
                result.push_str("){ .tag = ");
                result.push_string(recv_code);
                result.push_str("_");
                result.push_string(method_name);
                result.push_str(", .data = { .");
                result.push_string(method_name);
                result.push_str(" = {");
                (ai : usize) = usize(0);
                (ok2 : bool) = true;
                while(runtime((ai < na) && ok2), {
                  match(
                    args.get(ai),
                    .None => {
                      ok2 = false;
                    },
                    .Some(arg_e) => {
                      // For labeled args (field: val), extract the value
                      val_e := match(
                        arg_e,
                        .Atom(_, _) => arg_e,
                        .FnCall(_, lf_box, lf_args, lf_infix, _) => cond(
                          (
                            (lf_infix && (lf_args.len() == usize(2))) && match(
                              lf_box.*,
                              .Atom(_, ltok) => (ltok.value.as_str() == ":"),
                              .FnCall(_, _, _, _, _) => false
                            )
                          ) => match(
                            lf_args.get(usize(1)),
                            .None => arg_e,
                            .Some(lval) => lval
                          ),
                          true => arg_e
                        )
                      );
                      match(
                        call_gen_expr(val_e, ctx, indent),
                        .None => {
                          ok2 = false;
                        },
                        .Some(arg_c) => {
                          if(ai > usize(0), {
                            result.push_str(", ");
                          });
                          // Emit `.fieldname = val` using the field name from the CSV
                          match(
                            field_names.get(ai),
                            .None => {
                              result.push_str(" ");
                              result.push_string(arg_c);
                            },
                            .Some(fname) => {
                              result.push_str(" .");
                              result.push_string(fname);
                              result.push_str(" = ");
                              result.push_string(arg_c);
                            }
                          );
                          ai = (ai + usize(1));
                        }
                      )
                    }
                  );
                });
                cond(
                  (!(ok2)) => Option(String).None,
                  true => {
                    result.push_str(" } } }");
                    Option(String).Some(result)
                  }
                )
              }
            ),
          (
            ((method_name.as_str() == "add") || (method_name.as_str() == "another_add")) &&
              (args.len() == usize(1)) &&
                match(
                  recv_expr,
                  .FnCall(_, _, _, _, _) => false,
                  .Atom(_, add_recv_tok) => match(
                    ctx.*.get_var_type(add_recv_tok.value.as_str()),
                    .None => false,
                    .Some(add_recv_ty) => match(
                      ctx.*.get_struct_fields(add_recv_ty.as_str()),
                      .None => false,
                      .Some(add_fields) => (add_fields.as_str() == "value")
                    )
                  )
                )
          ) => match(
            args.get(usize(0)),
            .None => Option(String).None,
            .Some(add_arg_e) => match(
              call_gen_expr(add_arg_e, ctx, indent),
              .None => Option(String).None,
              .Some(add_arg_c) => {
                result_add := String.from("(");
                result_add.push_string(recv_code);
                result_add.push_str(".value = (");
                result_add.push_string(recv_code);
                result_add.push_str(".value + ");
                result_add.push_string(add_arg_c);
                result_add.push_str("))");
                Option(String).Some(result_add)
              }
            )
          ),
          // `x.unwrap()` with no args — strip the call, pass receiver through.
          // In the prototype codegen, malloc/calloc/realloc return raw C pointers;
          // wrapping in Option/Result is not emitted, so .unwrap() is a no-op.
          (((method_name.as_str() == "unwrap") || (method_name.as_str() == "comptime_unwrap")) && (args.len() == usize(0))) =>
            Option(String).Some(recv_code),
          ((method_name.as_str() == "unwrap_or") && (args.len() == usize(1))) =>
            Option(String).Some(recv_code),
          // `.neg()` — arithmetic negation: emit `(-(recv))`
          ((method_name.as_str() == "neg") && (args.len() == usize(0))) => {
            result_neg := String.from("(-(");
            result_neg.push_string(recv_code);
            result_neg.push_str("))");
            Option(String).Some(result_neg)
          },
          // `.not()` — logical/bitwise NOT: emit `(!(recv))`
          ((method_name.as_str() == "not") && (args.len() == usize(0))) => {
            result_not := String.from("(!(");
            result_not.push_string(recv_code);
            result_not.push_str("))");
            Option(String).Some(result_not)
          },
          // `.abs()` — absolute value.  We rely on C's signed vs. unsigned
          // semantics: emit `abs(recv)` for now (close enough for the prototype).
          ((method_name.as_str() == "abs") && (args.len() == usize(0))) => {
            result_abs := String.from("abs(");
            result_abs.push_string(recv_code);
            result_abs.push_str(")");
            Option(String).Some(result_abs)
          },
          // `.is_some()` / `.is_none()` on the simplified Option lowering:
          // direct `None` lowers to NULL, while `Some(value)` lowers to value.
          ((method_name.as_str() == "is_some") && (args.len() == usize(0))) =>
            cond(
              (recv_code.as_str() == "NULL") => Option(String).Some(String.from("false")),
              true => Option(String).Some(String.from("true"))
            ),
          ((method_name.as_str() == "is_none") && (args.len() == usize(0))) =>
            cond(
              (recv_code.as_str() == "NULL") => Option(String).Some(String.from("true")),
              true => Option(String).Some(String.from("false"))
            ),
          ((method_name.as_str() == "is_ok") && (args.len() == usize(0))) =>
            Option(String).Some(String.from("true")),
          ((method_name.as_str() == "is_err") && (args.len() == usize(0))) =>
            Option(String).Some(String.from("false")),
          // `String.from(s)` — identity in proto codegen (String == const char*)
          (((recv_code.as_str() == "String") && (method_name.as_str() == "from")) && (args.len() == usize(1))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(arg_e) => call_gen_expr(arg_e, ctx, indent)
            ),
          // `String.new()` — empty string literal in proto codegen
          (((recv_code.as_str() == "String") && (method_name.as_str() == "new")) && (args.len() == usize(0))) =>
            Option(String).Some(String.from("\"\"")),
          // `.as_str()` — identity in proto codegen (String == str == const char*)
          ((method_name.as_str() == "as_str") && (args.len() == usize(0))) =>
            Option(String).Some(recv_code),
          // `.bytes(idx)` — str byte access: `(uint8_t)(recv[idx])`
          ((method_name.as_str() == "bytes") && (args.len() == usize(1))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(idx_e) => match(
                call_gen_expr(idx_e, ctx, indent),
                .None => Option(String).None,
                .Some(idx_code) => {
                  result_bytes := String.from("(uint8_t)(");
                  result_bytes.push_string(recv_code);
                  result_bytes.push_str("[");
                  result_bytes.push_string(idx_code);
                  result_bytes.push_str("])");
                  Option(String).Some(result_bytes)
                }
              )
            ),
          // Default: emit as C method call `recv.method(args)`
          true => match(
            gen_arg_list(args, ctx, indent),
            .None => Option(String).None,
            .Some(arg_s) => {
              result := String.new();
              result.push_string(recv_code);
              result.push_str(".");
              result.push_string(method_name);
              result.push_str("(");
              result.push_string(arg_s);
              result.push_str(")");
              .Some(result)
            }
          )
        )
      )
    )
  )
});
/// Generate a C compound literal for an anonymous struct initialiser `_(args…)`.
///
/// Three forms are recognised by inspecting the argument structure:
///   • Labeled  – all args are `field: val` (infix `:`)  → `(T){.field=val, …}`
///   • Shorthand – all args are bare identifier atoms      → `(T){.name=name, …}`
///   • Positional – everything else (literals / exprs)    → `(T){val, …}`
///
/// Returns `None` if any arg fails to generate.
gen_anon_struct_compound :: (
  fn(
    struct_args : ArrayList(AstExpr),
    type_name : String,
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  n := struct_args.len();
  // Classify: check if ALL args are labeled (infix `:`)
  all_labeled_f := {
    (al : bool) = (n > usize(0));
    (ali : usize) = usize(0);
    while(runtime((ali < n) && al), {
      match(
        struct_args.get(ali),
        .None => {
          al = false;
        },
        .Some(ae_l) => match(
          ae_l,
          .Atom(_, _) => {
            al = false;
          },
          .FnCall(_, ff_l, fa_l, finfix_l, _) => {
            is_colon_pair := (
              finfix_l && (
                match(
                  ff_l.*,
                  .Atom(_, ftok_l) => (ftok_l.value.as_str() == ":"),
                  .FnCall(_, _, _, _, _) => false
                ) && (fa_l.len() == usize(2))
              )
            );
            if(!(is_colon_pair), {
              al = false;
            });
          }
        )
      );
      ali = (ali + usize(1));
    });
    al
  };
  // Check if ALL args are bare identifier atoms (shorthand form)
  all_bare_idents := {
    (ok_f : bool) = true;
    (ii : usize) = usize(0);
    while(runtime((ii < n) && ok_f), {
      match(
        struct_args.get(ii),
        .None => {
          ok_f = false;
        },
        .Some(ae) => match(
          ae,
          .FnCall(_, _, _, _, _) => {
            ok_f = false;
          },
          .Atom(_, atk) => {
            if(!(atk.kind == TokenKind.Identifier), {
              ok_f = false;
            });
          }
        )
      );
      ii = (ii + usize(1));
    });
    ok_f
  };
  result := String.from("(");
  result.push_string(type_name);
  result.push_str("){");
  (i2 : usize) = usize(0);
  (ok2 : bool) = true;
  while(runtime((i2 < n) && ok2), {
    match(
      struct_args.get(i2),
      .None => {
        ok2 = false;
      },
      .Some(arg_expr) => cond(
        // Labeled arg: `field: val` → `.field = val`
        all_labeled_f => match(
          arg_expr,
          .Atom(_, _) => {
            ok2 = false;
          },
          .FnCall(_, ff2, fa2, finfix2, _) => cond(
            (!(finfix2)) => {
              ok2 = false;
            },
            true => {
              fname_opt2 := match(
                fa2.get(usize(0)),
                .None => Option(String).None,
                .Some(fe2) => match(
                  fe2,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, fntok2) => Option(String).Some(fntok2.value)
                )
              );
              fval_opt2 := match(
                fa2.get(usize(1)),
                .None => Option(String).None,
                .Some(ve2) => aggregate_initializer_to_c(ve2, ctx, indent)
              );
              match(
                fname_opt2,
                .None => {
                  ok2 = false;
                },
                .Some(fn2) => match(
                  fval_opt2,
                  .None => {
                    ok2 = false;
                  },
                  .Some(fv2) => {
                    if(i2 > usize(0), {
                      result.push_str(", ");
                    });
                    result.push_str(".");
                    result.push_string(fn2);
                    result.push_str(" = ");
                    result.push_string(fv2);
                  }
                )
              );
            }
          )
        ),
        // Shorthand bare-ident arg: `x` → `.x = x`
        all_bare_idents => match(
          arg_expr,
          .FnCall(_, _, _, _, _) => {
            ok2 = false;
          },
          .Atom(_, atok2) => {
            if(i2 > usize(0), {
              result.push_str(", ");
            });
            result.push_str(".");
            result.push_string(atok2.value);
            result.push_str(" = ");
            result.push_string(atok2.value);
          }
        ),
        // Positional: emit value directly
        true => match(
          aggregate_initializer_to_c(arg_expr, ctx, indent),
          .None => {
            ok2 = false;
          },
          .Some(av2) => {
            if(i2 > usize(0), {
              result.push_str(", ");
            });
            result.push_string(av2);
          }
        )
      )
    );
    i2 = (i2 + usize(1));
  });
  cond(
    (!(ok2)) => Option(String).None,
    true => {
      result.push_str("}");
      Option(String).Some(result)
    }
  )
});
/// Handle `x = val` (bare assignment), `(x : T) = val` (typed declaration),
/// and compound LHS assignment like `c.*.field = val` or `arr.data = val`.
///
/// - Bare assignment: returns C expression `"x = val"`.
/// - Typed declaration: emits `"T_c x = val;\n"` and returns `"0"`.
/// - Compound LHS: returns C expression `"lhs_code = val"`.
handle_assignment :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  lhs_opt := args.get(usize(0));
  rhs_opt := args.get(usize(1));
  match(
    lhs_opt,
    .None => Option(String).None,
    .Some(lhs_expr) => match(
      rhs_opt,
      .None => Option(String).None,
      .Some(rhs_expr) => {
        // --- Special path: (arr : [T; N]) = [v0, v1, ...] ---
        // typed-decl with Array type + array literal RHS → emit `T arr[N] = {v0, v1, ...};`
        arr_typed_decl_opt := match(
          lhs_expr,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, lcolon_box, lcolon_args, lcolon_infix, _) => cond(
            (
              !(
                lcolon_infix && match(
                  lcolon_box.*,
                  .Atom(_, lctok) => ((lctok.kind == TokenKind.Operator) && (lctok.value.as_str() == ":")),
                  .FnCall(_, _, _, _, _) => false
                )
              )
            ) => Option(String).None,
            true => match(
              lcolon_args.get(usize(0)),
              .None => Option(String).None,
              .Some(lname_e) => match(
                lname_e,
                .FnCall(_, _, _, _, _) => Option(String).None,
                .Atom(_, lname_tok) => cond(
                  (lname_tok.kind != TokenKind.Identifier) => Option(String).None,
                  true => match(
                    lcolon_args.get(usize(1)),
                    .None => Option(String).None,
                    .Some(lty_e) => match(
                      lty_e,
                      .Atom(_, _) => Option(String).None,
                      .FnCall(_, lty_fn, lty_args, lty_infix, _) => cond(
                        lty_infix => Option(String).None,
                        (lty_args.len() != usize(2)) => Option(String).None,
                        true => match(
                          lty_fn.*,
                          .FnCall(_, _, _, _, _) => Option(String).None,
                          .Atom(_, ltytok) => cond(
                            (ltytok.value.as_str() != "Array") => Option(String).None,
                            true => {
                              // [T; N] or Array(T, N) → extract elem type and size
                              elem_c_opt := match(
                                lty_args.get(usize(0)),
                                .None => Option(String).None,
                                .Some(elem_e) => type_expr_to_c(elem_e)
                              );
                              size_str_opt := match(
                                lty_args.get(usize(1)),
                                .None => Option(String).None,
                                .Some(sz_e) => match(
                                  sz_e,
                                  .FnCall(_, _, _, _, _) => Option(String).None,
                                  .Atom(_, sz_tok) => cond(
                                    (sz_tok.kind == TokenKind.Integer) => Option(String).Some(sz_tok.value),
                                    (sz_tok.value.as_str() == "_") => Option(String).None,
                                    true => Option(String).None
                                  )
                                )
                              );
                              match(
                                elem_c_opt,
                                .None => Option(String).None,
                                .Some(elem_c) => match(
                                  size_str_opt,
                                  .None => Option(String).None,
                                  .Some(size_str) => {
                                    // Now emit the array declaration
                                    san_arr_name := sanitize_c_ident(lname_tok.value.as_str());
                                    // RHS must be an array literal or generate as initializer
                                    rhs_init_opt := match(
                                      rhs_expr,
                                      .Atom(_, _) => call_gen_expr(rhs_expr, ctx, indent),
                                      .FnCall(_, rhs_arr_fn, rhs_arr_args, rhs_arr_infix, _) => cond(
                                        rhs_arr_infix => call_gen_expr(rhs_expr, ctx, indent),
                                        true => match(
                                          rhs_arr_fn.*,
                                          .FnCall(_, _, _, _, _) => call_gen_expr(rhs_expr, ctx, indent),
                                          .Atom(_, ratok) => cond(
                                            (ratok.value.as_str() != "array") => call_gen_expr(rhs_expr, ctx, indent),
                                            true => {
                                              // Build `{v0, v1, ...}` initializer
                                              n_rv := rhs_arr_args.len();
                                              init_rv := String.from("{");
                                              (rvi : usize) = usize(0);
                                              (rv_ok : bool) = true;
                                              while(runtime((rvi < n_rv) && rv_ok), {
                                                match(
                                                  rhs_arr_args.get(rvi),
                                                  .None => {
                                                    rv_ok = false;
                                                  },
                                                  .Some(rv_e) => match(
                                                    call_gen_expr(rv_e, ctx, indent),
                                                    .None => {
                                                      rv_ok = false;
                                                    },
                                                    .Some(rv_c) => {
                                                      if(rvi > usize(0), {
                                                        init_rv.push_str(", ");
                                                      });
                                                      init_rv.push_string(rv_c);
                                                      rvi = (rvi + usize(1));
                                                    }
                                                  )
                                                );
                                              });
                                              cond(
                                                (!(rv_ok)) => Option(String).None,
                                                true => {
                                                  init_rv.push_str("}");
                                                  Option(String).Some(init_rv)
                                                }
                                              )
                                            }
                                          )
                                        )
                                      )
                                    );
                                    match(
                                      rhs_init_opt,
                                      .None => Option(String).None,
                                      .Some(rhs_init) => {
                                        ctx.*.emitter.emit_string(indent);
                                        ctx.*.emitter.emit_string(elem_c);
                                        ctx.*.emitter.emit(" ");
                                        ctx.*.emitter.emit_string(san_arr_name);
                                        ctx.*.emitter.emit("[");
                                        ctx.*.emitter.emit_string(size_str);
                                        ctx.*.emitter.emit("] = ");
                                        ctx.*.emitter.emit_string(rhs_init);
                                        ctx.*.emitter.emit_line(";");
                                        ctx.*.register_array_var_with_size(lname_tok.value.as_str(), size_str.as_str());
                                        Option(String).Some(String.from("0"))
                                      }
                                    )
                                  }
                                )
                              )
                            }
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        );
        // Detect: RHS is a non-empty anonymous struct init `_(args…)`.
        // When combined with a typed-decl LHS `(x : T) = _(…)`, we need the LHS
        // type to generate the C compound literal `(T){…}`.  We must handle this
        // *before* calling call_gen_expr(rhs_expr) because `_()` with args returns None.
        rhs_is_anon_struct := match(
          rhs_expr,
          .Atom(_, _) => false,
          .FnCall(_, rhs_fn_box, rhs_fn_args, rhs_fn_infix, _) => (
            (!(rhs_fn_infix)) &&
              (rhs_fn_args.len() > usize(0)) &&
                match(
                  rhs_fn_box.*,
                  .FnCall(_, _, _, _, _) => false,
                  .Atom(_, rfntok) => (rfntok.value.as_str() == BK_ANON_STRUCT)
                )
          )
        );
        typed_anon_struct_decl_opt := match(
          lhs_expr,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, colon_box_a, colon_args_a, colon_infix_a, _) => cond(
            (
              !(
                colon_infix_a && match(
                  colon_box_a.*,
                  .Atom(_, ctoka) => ((ctoka.kind == TokenKind.Operator) && (ctoka.value.as_str() == ":")),
                  .FnCall(_, _, _, _, _) => false
                )
              )
            ) => Option(String).None,
            true => {
              name_opt_a := match(
                colon_args_a.get(usize(0)),
                .None => Option(String).None,
                .Some(ne_a) => match(
                  ne_a,
                  .Atom(_, ntoka) => Option(String).Some(ntoka.value),
                  .FnCall(_, _, _, _, _) => Option(String).None
                )
              );
              ty_args_opt_a := match(
                colon_args_a.get(usize(1)),
                .None => Option(ArrayList(AstExpr)).None,
                .Some(te_a) => match(
                  te_a,
                  .Atom(_, _) => Option(ArrayList(AstExpr)).None,
                  .FnCall(_, ty_fn_a, ty_args_a, ty_infix_a, _) => cond(
                    ty_infix_a => Option(ArrayList(AstExpr)).None,
                    true => match(
                      ty_fn_a.*,
                      .FnCall(_, _, _, _, _) => Option(ArrayList(AstExpr)).None,
                      .Atom(_, ty_tok_a) => cond(
                        (ty_tok_a.value.as_str() == "struct") => Option(ArrayList(AstExpr)).Some(ty_args_a),
                        true => Option(ArrayList(AstExpr)).None
                      )
                    )
                  )
                )
              );
              rhs_args_opt_a := match(
                rhs_expr,
                .Atom(_, _) => Option(ArrayList(AstExpr)).None,
                .FnCall(_, rhs_fn_a, rhs_args_a, rhs_infix_a, _) => cond(
                  rhs_infix_a => Option(ArrayList(AstExpr)).None,
                  true => match(
                    rhs_fn_a.*,
                    .FnCall(_, _, _, _, _) => Option(ArrayList(AstExpr)).None,
                    .Atom(_, rhs_tok_a) => cond(
                      (rhs_tok_a.value.as_str() == BK_ANON_STRUCT) => Option(ArrayList(AstExpr)).Some(rhs_args_a),
                      true => Option(ArrayList(AstExpr)).None
                    )
                  )
                )
              );
              match(
                name_opt_a,
                .None => Option(String).None,
                .Some(var_name_a) => match(
                  ty_args_opt_a,
                  .None => Option(String).None,
                  .Some(type_args_a) => match(
                    rhs_args_opt_a,
                    .None => Option(String).None,
                    .Some(value_args_a) => match(
                      anon_struct_type_to_c(type_args_a),
                      .None => Option(String).None,
                      .Some(anon_ty_a) => match(
                        anon_struct_initializer_to_c(value_args_a, ctx, indent),
                        .None => Option(String).None,
                        .Some(init_a) => {
                          ctx.*.emitter.emit_string(indent);
                          ctx.*.emitter.emit_string(anon_ty_a);
                          ctx.*.emitter.emit(" ");
                          ctx.*.emitter.emit_string(sanitize_c_ident(var_name_a.as_str()));
                          ctx.*.emitter.emit(" = ");
                          ctx.*.emitter.emit_string(init_a);
                          ctx.*.emitter.emit_line(";");
                          Option(String).Some(String.from("0"))
                        }
                      )
                    )
                  )
                )
              )
            }
          )
        );
        typed_tuple_decl_opt := match(
          rhs_expr,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, tuple_rhs_fn, _, tuple_rhs_infix, _) => cond(
            tuple_rhs_infix => Option(String).None,
            true => match(
              tuple_rhs_fn.*,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, tuple_rhs_tok) => cond(
                (tuple_rhs_tok.value.as_str() != BK_TUPLE) => Option(String).None,
                true => match(
                  lhs_expr,
                  .Atom(_, _) => Option(String).None,
                  .FnCall(_, colon_box_t, colon_args_t, colon_infix_t, _) => cond(
                    (
                      !(
                        colon_infix_t && match(
                          colon_box_t.*,
                          .Atom(_, ctokt) => ((ctokt.kind == TokenKind.Operator) && (ctokt.value.as_str() == ":")),
                          .FnCall(_, _, _, _, _) => false
                        )
                      )
                    ) => Option(String).None,
                    true => {
                      name_opt_t := match(
                        colon_args_t.get(usize(0)),
                        .None => Option(String).None,
                        .Some(ne_t) => match(
                          ne_t,
                          .Atom(_, ntokt) => Option(String).Some(ntokt.value),
                          .FnCall(_, _, _, _, _) => Option(String).None
                        )
                      );
                      ty_opt_t := match(
                        colon_args_t.get(usize(1)),
                        .None => Option(String).None,
                        .Some(te_t) => type_expr_to_c(te_t)
                      );
                      init_opt_t := aggregate_initializer_to_c(rhs_expr, ctx, indent);
                      match(
                        name_opt_t,
                        .None => Option(String).None,
                        .Some(var_name_t) => match(
                          ty_opt_t,
                          .None => Option(String).None,
                          .Some(c_ty_t) => match(
                            init_opt_t,
                            .None => Option(String).None,
                            .Some(init_t) => {
                              ctx.*.emitter.emit_string(indent);
                              ctx.*.emitter.emit_string(build_typed_decl(c_ty_t.as_str(), sanitize_c_ident(var_name_t.as_str()).as_str()));
                              ctx.*.emitter.emit(" = ");
                              ctx.*.emitter.emit_string(init_t);
                              ctx.*.emitter.emit_line(";");
                              Option(String).Some(String.from("0"))
                            }
                          )
                        )
                      )
                    }
                  )
                )
              )
            )
          )
        );
        cond(
          // --- Special path: (arr : [T; N]) = [v0, v1, ...] ---
          match(arr_typed_decl_opt,.Some(_) => true,.None => false) => arr_typed_decl_opt,
          // --- Special path: (p : struct(...)) = _(...) ---
          match(typed_anon_struct_decl_opt,.Some(_) => true,.None => false) => typed_anon_struct_decl_opt,
          // --- Special path: (p : TupleAlias) = (v0, v1, ...) ---
          match(typed_tuple_decl_opt,.Some(_) => true,.None => false) => typed_tuple_decl_opt,
          // --- Special path: arr = [v0, v1, ...] for known array var (element-by-element) ---
          match(
            lhs_expr,
            .Atom(_, lna_tok) => ctx.*.is_array_var(lna_tok.value.as_str()),
            .FnCall(_, _, _, _, _) => false
          ) =>
            match(
              lhs_expr,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, lna_tok) => match(
                rhs_expr,
                .Atom(_, _) => Option(String).None,
                .FnCall(_, ala_fn, ala_args, ala_infix, _) => cond(
                  ala_infix => Option(String).None,
                  true => match(
                    ala_fn.*,
                    .FnCall(_, _, _, _, _) => Option(String).None,
                    .Atom(_, ala_tok) => cond(
                      (ala_tok.value.as_str() != "array") => Option(String).None,
                      true => {
                        san_arr := sanitize_c_ident(lna_tok.value.as_str());
                        n_ala := ala_args.len();
                        (ala_i : usize) = usize(0);
                        (ala_ok : bool) = true;
                        while(runtime((ala_i < n_ala) && ala_ok), {
                          match(
                            ala_args.get(ala_i),
                            .None => {
                              ala_ok = false;
                            },
                            .Some(ala_e) => match(
                              call_gen_expr(ala_e, ctx, indent),
                              .None => {
                                ala_ok = false;
                              },
                              .Some(ala_c) => {
                                ctx.*.emitter.emit_string(indent);
                                ctx.*.emitter.emit_string(san_arr);
                                ctx.*.emitter.emit("[");
                                ctx.*.emitter.emit_string(ala_i.to_string());
                                ctx.*.emitter.emit("] = ");
                                ctx.*.emitter.emit_string(ala_c);
                                ctx.*.emitter.emit_line(";");
                                ala_i = (ala_i + usize(1));
                              }
                            )
                          );
                        });
                        cond(
                          (!(ala_ok)) => Option(String).None,
                          true => Option(String).Some(String.from("0"))
                        )
                      }
                    )
                  )
                )
              )
            ),
          // --- Special path: typed-decl + anon-struct RHS ---
          rhs_is_anon_struct => match(
            lhs_expr,
            // Not a typed decl (just an atom LHS) — skip to general path
            .Atom(_, _) => Option(String).None,
            .FnCall(_, colon_box_a, colon_args_a, colon_infix_a, _) => cond(
              // Not a colon-typed-decl — fall through
              (
                !(
                  colon_infix_a && match(
                    colon_box_a.*,
                    .Atom(_, ctoka) => ((ctoka.kind == TokenKind.Operator) && (ctoka.value.as_str() == ":")),
                    .FnCall(_, _, _, _, _) => false
                  )
                )
              ) => Option(String).None,
              true => {
                // Extract var name
                name_opt_a := match(
                  colon_args_a.get(usize(0)),
                  .None => Option(String).None,
                  .Some(ne_a) => match(
                    ne_a,
                    .Atom(_, ntoka) => Option(String).Some(ntoka.value),
                    .FnCall(_, _, _, _, _) => Option(String).None
                  )
                );
                // Extract C type name
                ty_opt_a := match(
                  colon_args_a.get(usize(1)),
                  .None => Option(String).None,
                  .Some(te_a) => type_expr_to_c(te_a)
                );
                match(
                  name_opt_a,
                  .None => Option(String).None,
                  .Some(var_name_a) => match(
                    ty_opt_a,
                    .None => Option(String).None,
                    .Some(c_ty_a) => cond(
                      (c_ty_a.as_str() == "Type") => Option(String).None,
                      true => {
                        // Extract the anon-struct args
                        struct_args_opt := match(
                          rhs_expr,
                          .Atom(_, _) => Option(ArrayList(AstExpr)).None,
                          .FnCall(_, _, san_args, _, _) => Option(ArrayList(AstExpr)).Some(san_args)
                        );
                        match(
                          struct_args_opt,
                          .None => Option(String).None,
                          .Some(san_args2) => match(
                            gen_anon_struct_compound(san_args2, c_ty_a, ctx, indent),
                            .None => Option(String).None,
                            .Some(rhs_code_a) => {
                              ctx.*.emitter.emit_string(indent);
                              ctx.*.emitter.emit_string(c_ty_a);
                              ctx.*.emitter.emit(" ");
                              ctx.*.emitter.emit_string(sanitize_c_ident(var_name_a.as_str()));
                              ctx.*.emitter.emit(" = ");
                              ctx.*.emitter.emit_string(rhs_code_a);
                              ctx.*.emitter.emit_line(";");
                              Option(String).Some(String.from("0"))
                            }
                          )
                        )
                      }
                    )
                  )
                )
              }
            )
          ),
          // --- General path: compute RHS first, then handle LHS ---
          true => match(
            call_gen_expr(rhs_expr, ctx, indent),
            .None => Option(String).None,
            .Some(rhs_code) => match(
              lhs_expr,
              // Bare atom: x = val — C assignment expression
              .Atom(_, name_tok) => {
                result := String.new();
                result.push_string(sanitize_c_ident(name_tok.value.as_str()));
                result.push_str(" = ");
                result.push_string(rhs_code);
                Option(String).Some(result)
              },
              // FnCall LHS: either (x : T) = val  OR  compound expr like c.*.field = val
              .FnCall(_, colon_box, colon_args, colon_infix, _) => cond(
                // Check if it's a typed declaration: (x : T) = val
                (
                  colon_infix && match(
                    colon_box.*,
                    .Atom(_, ctok) => ((ctok.kind == TokenKind.Operator) && (ctok.value.as_str() == ":")),
                    .FnCall(_, _, _, _, _) => false
                  )
                ) => {
                  name_opt := match(
                    colon_args.get(usize(0)),
                    .None => Option(String).None,
                    .Some(ne) => match(
                      ne,
                      .Atom(_, ntok) => Option(String).Some(ntok.value),
                      // comptime(x) : T — extract name from comptime(name) pattern
                      .FnCall(_, cf_box3, cf_args3, cf_infix3, _) => cond(
                        cf_infix3 => Option(String).None,
                        (!(cf_args3.len() == usize(1))) => Option(String).None,
                        true => match(
                          cf_box3.*,
                          .FnCall(_, _, _, _, _) => Option(String).None,
                          .Atom(_, cftok3) => cond(
                            (!(cftok3.value.as_str() == "comptime")) => Option(String).None,
                            true => match(
                              cf_args3.get(usize(0)),
                              .None => Option(String).None,
                              .Some(inner3) => match(
                                inner3,
                                .FnCall(_, _, _, _, _) => Option(String).None,
                                .Atom(_, itok3) => cond(
                                  (itok3.kind == TokenKind.Identifier) => Option(String).Some(itok3.value),
                                  true => Option(String).None
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  );
                  // Track whether the LHS name came from `comptime(name)` pattern.
                  // Comptime type aliases like `(comptime(T) : Type) = i32` must not
                  // generate any C code (they are purely compile-time constructs).
                  name_is_comptime := match(
                    colon_args.get(usize(0)),
                    .None => false,
                    .Some(ne_c) => match(
                      ne_c,
                      .Atom(_, _) => false,
                      .FnCall(_, cf_box_c, _, cf_infix_c, _) => (
                        (!(cf_infix_c)) &&
                          match(
                            cf_box_c.*,
                            .FnCall(_, _, _, _, _) => false,
                            .Atom(_, tok_c) => (tok_c.value.as_str() == "comptime")
                          )
                      )
                    )
                  );
                  ty_opt := match(
                    colon_args.get(usize(1)),
                    .None => Option(String).None,
                    .Some(te) => match(
                      te,
                      .Atom(_, _) => type_expr_to_c(te),
                      .FnCall(_, tuple_ty_fn, _, tuple_ty_infix, _) => cond(
                        tuple_ty_infix => type_expr_to_c(te),
                        true => match(
                          tuple_ty_fn.*,
                          .FnCall(_, _, _, _, _) => type_expr_to_c(te),
                          .Atom(_, tuple_ty_tok) => cond(
                            (tuple_ty_tok.value.as_str() == "Tuple") => Option(String).None,
                            true => type_expr_to_c(te)
                          )
                        )
                      )
                    )
                  );
                  // When `name_is_comptime = true`, skip declarations whose type has no C
                  // representation (not a primitive, not a registered struct or enum).
                  // This avoids emitting invalid C like `Pair x = ...` when `Pair` is a
                  // compile-time-only Yo tuple alias without a C typedef.
                  // Declarations like `(comptime(x) : bool) = true` still emit normally.
                  comptime_type_has_no_c_repr := (
                    name_is_comptime && match(
                      colon_args.get(usize(1)),
                      .None => false,
                      .Some(te_chk) => match(
                        te_chk,
                        .FnCall(_, _, _, _, _) => true,
                        .Atom(_, ty_atom_chk) => {
                          yn := ty_atom_chk.value.as_str();
                          !(
                            is_c_type_name(yn) ||
                              ctx.*.is_struct_name(yn) ||
                                ctx.*.is_enum_name(yn)
                          )
                        }
                      )
                    )
                  );
                  match(
                    name_opt,
                    .None => Option(String).None,
                    .Some(var_name) => match(
                      ty_opt,
                      // No C type available — check for named tuple, else __auto_type fallback.
                      // Skip comptime patterns: `(comptime(T) : Type) = SomeType`.
                      .None => cond(
                        name_is_comptime => Option(String).None,
                        (var_name.len() == usize(0)) => Option(String).None,
                        true => {
                          // Named tuple: `(t2 : Tuple(a:T, b:T2, c:T3)) = rhs`
                          // Emit a double-field struct `struct { T _0; T2 _1; ... T a; T2 b; ... }`
                          // so both index (._N) and label (.name) access work.
                          named_tuple_opt := match(
                            colon_args.get(usize(1)),
                            .None => Option(String).None,
                            .Some(nt_type_e) => match(
                              nt_type_e,
                              .Atom(_, _) => Option(String).None,
                              .FnCall(_, nt_fb, nt_fa, nt_fi, _) => cond(
                                nt_fi => Option(String).None,
                                (nt_fa.len() < usize(2)) => Option(String).None,
                                true => match(
                                  nt_fb.*,
                                  .FnCall(_, _, _, _, _) => Option(String).None,
                                  .Atom(_, nt_tok) => cond(
                                    (nt_tok.value.as_str() != "Tuple") => Option(String).None,
                                    true => {
                                      n_nt := nt_fa.len();
                                      (nt_ok : bool) = true;
                                      (nt_fnames : ArrayList(String)) = ArrayList(String).new();
                                      (nt_fctypes : ArrayList(String)) = ArrayList(String).new();
                                      (nti : usize) = usize(0);
                                      while(runtime((nti < n_nt) && nt_ok), {
                                        match(
                                          nt_fa.get(nti),
                                          .None => {
                                            nt_ok = false;
                                          },
                                          .Some(nt_arg) => match(
                                            nt_arg,
                                            .Atom(_, _) => {
                                              nt_ok = false;
                                            },
                                            .FnCall(_, nt_af, nt_aa, nt_ai, _) => cond(
                                              (!(nt_ai)) => {
                                                nt_ok = false;
                                              },
                                              (nt_aa.len() != usize(2)) => {
                                                nt_ok = false;
                                              },
                                              true => match(
                                                nt_af.*,
                                                .FnCall(_, _, _, _, _) => {
                                                  nt_ok = false;
                                                },
                                                .Atom(_, nt_at) => cond(
                                                  (nt_at.value.as_str() != ":") => {
                                                    nt_ok = false;
                                                  },
                                                  true => match(
                                                    nt_aa.get(usize(0)),
                                                    .None => {
                                                      nt_ok = false;
                                                    },
                                                    .Some(fn_e) => match(
                                                      fn_e,
                                                      .FnCall(_, _, _, _, _) => {
                                                        nt_ok = false;
                                                      },
                                                      .Atom(_, fn_tok) => match(
                                                        nt_aa.get(usize(1)),
                                                        .None => {
                                                          nt_ok = false;
                                                        },
                                                        .Some(ft_e) => match(
                                                          type_expr_to_c(ft_e),
                                                          .None => {
                                                            nt_ok = false;
                                                          },
                                                          .Some(fct) => {
                                                            nt_fnames.push(fn_tok.value);
                                                            nt_fctypes.push(fct);
                                                          }
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        );
                                        nti = (nti + usize(1));
                                      });
                                      cond(
                                        (!(nt_ok)) => Option(String).None,
                                        true => {
                                          // Temp var to hold RHS without re-evaluation.
                                          nt_tmp := ctx.*.fresh_temp();
                                          ctx.*.emitter.emit_string(indent);
                                          ctx.*.emitter.emit("__auto_type ");
                                          ctx.*.emitter.emit_string(nt_tmp);
                                          ctx.*.emitter.emit(" = ");
                                          ctx.*.emitter.emit_string(rhs_code);
                                          ctx.*.emitter.emit_line(";");
                                          // struct { T _0; T2 _1; ... T a; T2 b; ... } name = { ... };
                                          ctx.*.emitter.emit_string(indent);
                                          ctx.*.emitter.emit("struct { ");
                                          (pi : usize) = usize(0);
                                          while(runtime(pi < n_nt), {
                                            match(
                                              nt_fctypes.get(pi),
                                              .None => (),
                                              .Some(pct) => {
                                                ctx.*.emitter.emit_string(pct);
                                                ctx.*.emitter.emit(" _");
                                                ctx.*.emitter.emit_string(pi.to_string());
                                                ctx.*.emitter.emit("; ");
                                              }
                                            );
                                            pi = (pi + usize(1));
                                          });
                                          (ni2 : usize) = usize(0);
                                          while(runtime(ni2 < n_nt), {
                                            match(
                                              nt_fctypes.get(ni2),
                                              .None => (),
                                              .Some(nct) => match(
                                                nt_fnames.get(ni2),
                                                .None => (),
                                                .Some(nfn) => {
                                                  ctx.*.emitter.emit_string(nct);
                                                  ctx.*.emitter.emit(" ");
                                                  ctx.*.emitter.emit_string(nfn);
                                                  ctx.*.emitter.emit("; ");
                                                }
                                              )
                                            );
                                            ni2 = (ni2 + usize(1));
                                          });
                                          ctx.*.emitter.emit("} ");
                                          ctx.*.emitter.emit_string(var_name);
                                          ctx.*.emitter.emit(" = {");
                                          // ._0 = tmp._0, ._1 = tmp._1, ...
                                          (ii : usize) = usize(0);
                                          while(runtime(ii < n_nt), {
                                            if(ii > usize(0), {
                                              ctx.*.emitter.emit(", ");
                                            });
                                            ctx.*.emitter.emit("._");
                                            ctx.*.emitter.emit_string(ii.to_string());
                                            ctx.*.emitter.emit(" = ");
                                            ctx.*.emitter.emit_string(nt_tmp);
                                            ctx.*.emitter.emit("._");
                                            ctx.*.emitter.emit_string(ii.to_string());
                                            ii = (ii + usize(1));
                                          });
                                          // .a = tmp._0, .b = tmp._1, ...
                                          (ii2 : usize) = usize(0);
                                          while(runtime(ii2 < n_nt), {
                                            ctx.*.emitter.emit(", .");
                                            match(
                                              nt_fnames.get(ii2),
                                              .None => (),
                                              .Some(nfn2) => ctx.*.emitter.emit_string(nfn2)
                                            );
                                            ctx.*.emitter.emit(" = ");
                                            ctx.*.emitter.emit_string(nt_tmp);
                                            ctx.*.emitter.emit("._");
                                            ctx.*.emitter.emit_string(ii2.to_string());
                                            ii2 = (ii2 + usize(1));
                                          });
                                          ctx.*.emitter.emit_line("};");
                                          Option(String).Some(String.from("0"))
                                        }
                                      )
                                    }
                                  )
                                )
                              )
                            )
                          );
                          match(
                            named_tuple_opt,
                            .Some(_) => named_tuple_opt,
                            .None => {
                              ctx.*.emitter.emit_string(indent);
                              ctx.*.emitter.emit("__auto_type ");
                              ctx.*.emitter.emit_string(sanitize_c_ident(var_name.as_str()));
                              ctx.*.emitter.emit(" = ");
                              ctx.*.emitter.emit_string(rhs_code);
                              ctx.*.emitter.emit_line(";");
                              Option(String).Some(String.from("0"))
                            }
                          )
                        }
                      ),
                      .Some(c_ty) => cond(
                        // Skip: `(comptime(T) : Type) = SomeType` — Type is a meta-type.
                        // Skip: `(comptime(x) : PureYoType) = val` — type has no C representation.
                        (comptime_type_has_no_c_repr || (c_ty.as_str() == "Type")) => Option(String).None,
                        true => {
                          // Emit: indent + "c_ty name" + " = " + rhs + ";"
                          san_cty_name := sanitize_c_ident(var_name.as_str());
                          decl_cty := build_typed_decl(c_ty.as_str(), san_cty_name.as_str());
                          ctx.*.emitter.emit_string(indent);
                          ctx.*.emitter.emit_string(decl_cty);
                          ctx.*.emitter.emit(" = ");
                          ctx.*.emitter.emit_string(rhs_code);
                          ctx.*.emitter.emit_line(";");
                          ctx.*.register_var_type(var_name.as_str(), c_ty.as_str());
                          .Some(String.from("0"))
                        }
                      )
                    )
                  )
                },
                // Comptime field mutation: `const_var.field = val` or `const_var.0 = val`
                // where `const_var` was declared with `::`.
                // Skip (no-op): `::` bindings are comptime constants; any mutations to their
                // fields are comptime-only and all dependent asserts are `comptime_assert` (no-ops).
                match(
                  lhs_expr,
                  .Atom(_, _) => false,
                  .FnCall(_, cm_fn, cm_args, cm_infix, _) => (
                    cm_infix &&
                      match(
                        cm_fn.*,
                        .Atom(_, cm_tok) => (cm_tok.value.as_str() == "."),
                        .FnCall(_, _, _, _, _) => false
                      ) &&
                        match(
                          cm_args.get(usize(0)),
                          .None => false,
                          .Some(cm_recv) => match(
                            cm_recv,
                            .Atom(_, cm_recv_tok) => (
                              (cm_recv_tok.kind == TokenKind.Identifier) &&
                                ctx.*.is_const_var(cm_recv_tok.value.as_str())
                            ),
                            .FnCall(_, _, _, _, _) => false
                          )
                        )
                  )
                ) => Option(String).Some(String.from("0")),
                // Compound LHS: e.g. c.*.field = val, arr.data = val
                // Guard: if LHS is a non-infix FnCall where the callee is neither a
                // registered array var nor a registered function (i.e., it's a struct
                // variable being indexed via the Index trait), emit a no-op.
                // This handles comptime-only mutations like `p(0) = val` where `p` is a
                // struct with a ComptimeIndex impl — all asserts around it are comptime.
                match(
                  lhs_expr,
                  .Atom(_, _) => false,
                  .FnCall(_, nai_fn, nai_args, nai_infix, _) => (
                    ((!(nai_infix)) && (nai_args.len() == usize(1))) &&
                      match(
                        nai_fn.*,
                        .FnCall(_, _, _, _, _) => false,
                        .Atom(_, nai_tok) => {
                          is_non_array_index := (
                            (nai_tok.kind == TokenKind.Identifier) &&
                              (!(ctx.*.is_array_var(nai_tok.value.as_str()))) &&
                                (!(ctx.*.is_slice_var(nai_tok.value.as_str()))) &&
                                  (!(ctx.*.is_defined_fn(nai_tok.value.as_str())))
                          );
                          is_non_array_index
                        }
                      )
                  )
                ) => Option(String).Some(String.from("0")),
                // Compound LHS: e.g. c.*.field = val, arr.data = val
                // Generate the LHS as an expression and return "lhs = rhs"
                true => match(
                  call_gen_expr(lhs_expr, ctx, indent),
                  .None => Option(String).None,
                  .Some(lhs_code) => {
                    result := String.new();
                    result.push_string(lhs_code);
                    result.push_str(" = ");
                    result.push_string(rhs_code);
                    Option(String).Some(result)
                  }
                )
              )
            )
          )
        )
      }
    )
  )
});
// ---------------------------------------------------------------------------
// Core entry point
// ---------------------------------------------------------------------------
/// Handle `assert(cond, msg)` — emit a test assertion as a C if-check.
///
/// Generates: `if (!(cond)) { exit(1); }` into the code buffer.
/// Returns `"0"` (the unit sentinel).
/// The `msg` argument (second arg) is evaluated but discarded for Phase 5b.
handle_assert :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)(
  match(
    args.get(usize(0)),
    .None => Option(String).None,
    .Some(cond_expr) => match(
      call_gen_expr(cond_expr, ctx, indent),
      .None => Option(String).None,
      .Some(cond_code) => {
        ctx.*.emitter.emit_string(indent);
        ctx.*.emitter.emit("if (!(");
        ctx.*.emitter.emit_string(cond_code);
        ctx.*.emitter.emit_line(")) { exit(1); }");
        .Some(String.from("0"))
      }
    )
  )
);
/// True if `expr` is a labeled argument: `FnCall(Atom(":"), [name, val], true)`.
is_labeled_arg :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, ff, fa, finfix, _) => (
      finfix && (
        match(
          ff.*,
          .Atom(_, ftok) => (ftok.value.as_str() == ":"),
          .FnCall(_, _, _, _, _) => false
        ) && (fa.len() == usize(2))
      )
    )
  )
);
/// True if all elements of `args` are labeled (`field: val`) args AND args is non-empty.
all_labeled_args :: (fn(args : ArrayList(AstExpr)) -> bool)({
  n := args.len();
  cond(
    (n == usize(0)) => false,
    true => {
      (all : bool) = true;
      (i : usize) = usize(0);
      while(runtime((i < n) && all), {
        match(
          args.get(i),
          .None => {
            all = false;
          },
          .Some(e) => {
            if(!(is_labeled_arg(e)), {
              all = false;
            });
          }
        );
        i = (i + usize(1));
      });
      all
    }
  )
});
/// True if `s` starts with an uppercase ASCII letter (A–Z).
/// Used to distinguish struct type names from lowercase function names.
is_uppercase_start :: (fn(s : String) -> bool)(
  match(
    s.at(usize(0)),
    .None => false,
    .Some(r) => ((r.char >= u32(65)) && (r.char <= u32(90)))
  )
);
/// Handle a non-empty tuple literal `(a, b, …)`.
///
/// Generates a C anonymous-struct compound literal using `__typeof__` so we
/// don't need to know the concrete type at this phase:
///
///   `(struct { __typeof__(a) _0; __typeof__(b) _1; }){._0 = a, ._1 = b}`
///
/// Field names use the `_N` (underscore-prefix) convention that matches the
/// full Yo code-gen output (tuple fields are `_0`, `_1`, …).
handle_tuple_literal :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  // Generate codes for each element first.
  arg_codes := ArrayList(String).new();
  (i : usize) = usize(0);
  (ok : bool) = true;
  while(runtime((i < n) && ok), {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(ae) => match(
        call_gen_expr(ae, ctx, indent),
        .None => {
          ok = false;
        },
        .Some(ac) => {
          arg_codes.push(ac);
        }
      )
    );
    i = (i + usize(1));
  });
  cond(
    (!(ok)) => Option(String).None,
    true => {
      result := String.from("(struct { ");
      // struct fields: __typeof__(val) _0; __typeof__(val) _1; …
      (j : usize) = usize(0);
      while(runtime(j < n), {
        match(
          arg_codes.get(j),
          .None => (),
          .Some(ac) => {
            result.push_str("__typeof__(");
            result.push_string(ac);
            result.push_str(") _");
            result.push_string(j.to_string());
            result.push_str("; ");
          }
        );
        j = (j + usize(1));
      });
      result.push_str("}){");
      // initialiser: ._0 = a, ._1 = b, …
      (k : usize) = usize(0);
      while(runtime(k < n), {
        match(
          arg_codes.get(k),
          .None => (),
          .Some(ac) => {
            if(k > usize(0), {
              result.push_str(", ");
            });
            result.push_str("._");
            result.push_string(k.to_string());
            result.push_str(" = ");
            result.push_string(ac);
          }
        );
        k = (k + usize(1));
      });
      result.push_str("}");
      Option(String).Some(result)
    }
  )
});
/// → `(TypeName){.field1 = val1, .field2 = val2}`.
///
/// All args must be labeled (`:` infix). The type name must start with an
/// uppercase letter (Yo convention for types).
handle_struct_constructor :: (
  fn(
    type_name : String,
    args : ArrayList(AstExpr),
    ctx : *(CodegenContext),
    indent : String
  ) -> Option(String)
)({
  result := String.from("(");
  result.push_string(type_name);
  result.push_str("){");
  n := args.len();
  (i : usize) = usize(0);
  (all_ok : bool) = true;
  (first : bool) = true;
  provided_fields := ArrayList(String).new();
  while(runtime((i < n) && all_ok), {
    match(
      args.get(i),
      .None => {
        all_ok = false;
      },
      .Some(field_expr) => match(
        field_expr,
        .Atom(_, _) => {
          all_ok = false;
        },
        .FnCall(_, ff, fa, _, _) => {
          field_name_opt := match(
            fa.get(usize(0)),
            .None => Option(String).None,
            .Some(name_e) => match(
              name_e,
              .Atom(_, ntok) => Option(String).Some(ntok.value),
              .FnCall(_, _, _, _, _) => Option(String).None
            )
          );
          field_val_opt := match(
            fa.get(usize(1)),
            .None => Option(String).None,
            .Some(val_e) => call_gen_expr(val_e, ctx, indent)
          );
          match(
            field_name_opt,
            .None => {
              all_ok = false;
            },
            .Some(fname) => match(
              field_val_opt,
              .None => {
                all_ok = false;
              },
              .Some(fval) => {
                if(!(first), {
                  result.push_str(", ");
                });
                result.push_str(".");
                result.push_string(fname);
                result.push_str(" = ");
                result.push_string(fval);
                provided_fields.push(String.from(fname.as_str()));
                first = false;
              }
            )
          );
        }
      )
    );
    i = (i + usize(1));
  });
  cond(
    (!(all_ok)) => Option(String).None,
    true => {
      match(
        ctx.*.get_struct_defaults(type_name.as_str()),
        .None => (),
        .Some(defaults_csv) => match(
          ctx.*.get_struct_fields(type_name.as_str()),
          .None => (),
          .Some(fields_csv) => {
            default_values := _split_csv(defaults_csv.as_str());
            field_names := _split_csv(fields_csv.as_str());
            n_defaults := default_values.len();
            (di : usize) = usize(0);
            while(runtime(di < n_defaults), {
              match(
                default_values.get(di),
                .None => (),
                .Some(default_value) => {
                  if(default_value.as_str() != "__yo_no_default", {
                    field_name_opt := field_names.get(di);
                    match(
                      field_name_opt,
                      .None => (),
                      .Some(default_field_name) => {
                        (already_provided : bool) = false;
                        (pi : usize) = usize(0);
                        while(runtime((pi < provided_fields.len()) && (!(already_provided))), {
                          match(
                            provided_fields.get(pi),
                            .None => (),
                            .Some(provided_name) => {
                              if(provided_name.as_str() == default_field_name.as_str(), {
                                already_provided = true;
                              });
                            }
                          );
                          pi = (pi + usize(1));
                        });
                        if(!(already_provided), {
                          if(!(first), {
                            result.push_str(", ");
                          });
                          result.push_str(".");
                          result.push_string(default_field_name);
                          result.push_str(" = ");
                          result.push_string(default_value);
                          first = false;
                        });
                      }
                    );
                  });
                }
              );
              di = (di + usize(1));
            });
          }
        )
      );
      result.push_str("}");
      .Some(result)
    }
  )
});
/// Generate a C expression string for a Yo AST expression.
///
/// May emit C statements into `ctx.emitter` as side effects (for begin blocks,
/// while loops, etc.).  Returns the C expression that represents the value of
/// `expr`, or `None` for unsupported constructs.
generate_expr :: (fn(expr : AstExpr, ctx : *(CodegenContext), indent : String) -> Option(String))(
  match(
    expr,
    // --- Atom expressions ---
    .Atom(_, tok) => cond(
      (tok.kind == TokenKind.Integer) =>.Some(gen_integer_lit(tok.value)),
      (tok.kind == TokenKind.Float) =>.Some(gen_float_lit(tok.value)),
      (tok.kind == TokenKind.Bool) =>.Some(gen_bool_lit(tok.value.as_str())),
      (tok.kind == TokenKind.StringLit) =>.Some(gen_string_lit(tok.value)),
      (tok.kind == TokenKind.Identifier) =>.Some(sanitize_c_ident(tok.value.as_str())),
      true => Option(String).None
    ),
    // --- FnCall expressions ---
    .FnCall(_, func_box, args, is_infix, _) => {
      op_opt := extract_op(func_box);
      ident_opt := fncall_func_ident(func_box);
      cond(
        // Binary infix arithmetic/comparison/logical: (a OP b)
        (
          is_infix && match(
            op_opt,
            .None => false,
            .Some(op) => ((args.len() == usize(2)) && is_binary_op(op.as_str()))
          )
        ) => match(
          op_opt,
          .None => Option(String).None,
          .Some(op) => handle_infix_op(op, args, ctx, indent)
        ),
        // Unary prefix: (OP a)
        (
          (!(is_infix)) && match(
            op_opt,
            .None => false,
            .Some(op) => ((args.len() == usize(1)) && is_unary_prefix_op(op.as_str()))
          )
        ) => match(
          op_opt,
          .None => Option(String).None,
          .Some(op) => handle_prefix_op(op, args, ctx, indent)
        ),
        // Non-empty tuple literal: (a, b, …) → C anonymous-struct compound literal.
        // Uses __typeof__ to avoid needing explicit type info.
        (
          (!(is_infix)) &&
            (args.len() > usize(0)) &&
              match(
                ident_opt,
                .None => false,
                .Some(id) => (id.as_str() == BK_TUPLE)
              )
        ) => handle_tuple_literal(args, ctx, indent),
        // Labeled anonymous struct: { field1: val1, field2: val2 }
        // Generates a C compound literal with __typeof__ for type inference.
        // This is the expression form; `x := { ... }` is handled in handle_define.
        (
          (!(is_infix)) &&
            (args.len() > usize(0)) &&
              match(
                ident_opt,
                .None => false,
                .Some(id) => (id.as_str() == BK_ANON_STRUCT)
              ) &&
                all_labeled_args(args)
        ) => {
          // Use current function return type if it's a known named struct;
          // otherwise build an anonymous C struct type inline.
          anon_ret_ty := ctx.*.current_fn_return_type.as_str();
          use_named_ty_anon := ((anon_ret_ty.len() > usize(0)) && ctx.*.is_struct_name(anon_ret_ty));
          result_anon := cond(
            use_named_ty_anon => {
              r := String.from("(");
              r.push_str(anon_ret_ty);
              r.push_str("){");
              r
            },
            true => String.from("(struct { ")
          );
          n_anon := args.len();
          (ai_anon : usize) = usize(0);
          (ok_anon : bool) = true;
          // First pass: collect field names and val codes
          field_names_anon := ArrayList(String).new();
          field_vals_anon := ArrayList(String).new();
          while(runtime((ai_anon < n_anon) && ok_anon), {
            match(
              args.get(ai_anon),
              .None => {
                ok_anon = false;
              },
              .Some(ae_a) => match(
                ae_a,
                .Atom(_, _) => {
                  ok_anon = false;
                },
                .FnCall(_, _, fa_a, _, _) => match(
                  fa_a.get(usize(0)),
                  .None => {
                    ok_anon = false;
                  },
                  .Some(fn_e) => match(
                    fn_e,
                    .FnCall(_, _, _, _, _) => {
                      ok_anon = false;
                    },
                    .Atom(_, fntok) => match(
                      fa_a.get(usize(1)),
                      .None => {
                        ok_anon = false;
                      },
                      .Some(fval_e) => match(
                        call_gen_expr(fval_e, ctx, indent),
                        .None => {
                          ok_anon = false;
                        },
                        .Some(fval_c) => {
                          field_names_anon.push(fntok.value);
                          field_vals_anon.push(fval_c);
                        }
                      )
                    )
                  )
                )
              )
            );
            ai_anon = (ai_anon + usize(1));
          });
          cond(
            (!(ok_anon)) => Option(String).None,
            true => {
              // Build struct type + initializer (or just initializer for named type)
              if(!(use_named_ty_anon), {
                (bi : usize) = usize(0);
                while(runtime(bi < n_anon), {
                  bi = (bi + usize(1));
                  match(
                    field_vals_anon.get(bi - usize(1)),
                    .None => (),
                    .Some(fval_s) => match(
                      field_names_anon.get(bi - usize(1)),
                      .None => (),
                      .Some(fn_s) => {
                        result_anon.push_str("__typeof__(");
                        result_anon.push_string(fval_s);
                        result_anon.push_str(") ");
                        result_anon.push_string(fn_s);
                        result_anon.push_str("; ");
                      }
                    )
                  );
                });
                result_anon.push_str("}){ ");
              });
              (ci : usize) = usize(0);
              while(runtime(ci < n_anon), {
                ci = (ci + usize(1));
                if(ci > usize(1), {
                  result_anon.push_str(", ");
                });
                match(
                  field_names_anon.get(ci - usize(1)),
                  .None => (),
                  .Some(fn_s) => {
                    result_anon.push_str(".");
                    result_anon.push_string(fn_s);
                    result_anon.push_str(" = ");
                  }
                );
                match(
                  field_vals_anon.get(ci - usize(1)),
                  .None => (),
                  .Some(fval_s) => {
                    result_anon.push_string(fval_s);
                  }
                );
              });
              result_anon.push_str(" }");
              Option(String).Some(result_anon)
            }
          )
        },
        // Shorthand anonymous struct (all bare identifiers): { x, y }
        // Each field = its own identifier value.
        (
          (!(is_infix)) &&
            (args.len() > usize(0)) &&
              match(
                ident_opt,
                .None => false,
                .Some(id) => (id.as_str() == BK_ANON_STRUCT)
              ) &&
                ({
                  n_sh := args.len();
                  (ok_sh : bool) = true;
                  (shi : usize) = usize(0);
                  while(runtime((shi < n_sh) && ok_sh), {
                    match(
                      args.get(shi),
                      .None => {
                        ok_sh = false;
                      },
                      .Some(ae_sh) => match(
                        ae_sh,
                        .FnCall(_, _, _, _, _) => {
                          ok_sh = false;
                        },
                        .Atom(_, atsh) => {
                          if(!(atsh.kind == TokenKind.Identifier), {
                            ok_sh = false;
                          });
                        }
                      )
                    );
                    shi = (shi + usize(1));
                  });
                  ok_sh
                })
        ) => {
          // Use current function return type if it's a known named struct.
          sh_ret_ty := ctx.*.current_fn_return_type.as_str();
          use_named_ty_sh := ((sh_ret_ty.len() > usize(0)) && ctx.*.is_struct_name(sh_ret_ty));
          result_sh := cond(
            use_named_ty_sh => {
              r := String.from("(");
              r.push_str(sh_ret_ty);
              r.push_str("){");
              r
            },
            true => String.from("(struct { ")
          );
          n_sh2 := args.len();
          (fi_sh : usize) = usize(0);
          // Collect field names (all identifiers)
          field_names_sh := ArrayList(String).new();
          while(runtime(fi_sh < n_sh2), {
            fi_sh = (fi_sh + usize(1));
            match(
              args.get(fi_sh - usize(1)),
              .None => (),
              .Some(ae_sh2) => match(
                ae_sh2,
                .FnCall(_, _, _, _, _) => (),
                .Atom(_, atsh2) => {
                  field_names_sh.push(atsh2.value);
                }
              )
            );
          });
          if(!(use_named_ty_sh), {
            (gi_sh : usize) = usize(0);
            while(runtime(gi_sh < n_sh2), {
              gi_sh = (gi_sh + usize(1));
              match(
                field_names_sh.get(gi_sh - usize(1)),
                .None => (),
                .Some(fn_sh) => {
                  result_sh.push_str("__typeof__(");
                  result_sh.push_string(fn_sh);
                  result_sh.push_str(") ");
                  result_sh.push_string(fn_sh);
                  result_sh.push_str("; ");
                }
              );
            });
            result_sh.push_str("}){ ");
          });
          (hi_sh : usize) = usize(0);
          while(runtime(hi_sh < n_sh2), {
            hi_sh = (hi_sh + usize(1));
            if(hi_sh > usize(1), {
              result_sh.push_str(", ");
            });
            match(
              field_names_sh.get(hi_sh - usize(1)),
              .None => (),
              .Some(fn_sh) => {
                result_sh.push_str(".");
                result_sh.push_string(fn_sh);
                result_sh.push_str(" = ");
                result_sh.push_string(fn_sh);
              }
            );
          });
          result_sh.push_str(" }");
          Option(String).Some(result_sh)
        },
        // Unit value: FnCall(Atom("tuple"), [], …)  ← parser synthesizes this at end of begin
        // Empty anon struct: FnCall(Atom("_"), [], …) ← parser produces for `{ }` with no args
        // Both represent Yo unit () — emit the sentinel "0" (void functions skip it).
        (
          (!(is_infix)) &&
            (args.len() == usize(0)) &&
              match(
                ident_opt,
                .None => false,
                .Some(id) => ((id.as_str() == BK_TUPLE) || (id.as_str() == BK_ANON_STRUCT))
              )
        ) =>.Some(String.from("0")),
        // open NAME — emit `__auto_type field = name.field;` for each known field.
        // Looks up the variable's field CSV in the context, then emits bindings.
        (
          (!(is_infix)) &&
            (args.len() == usize(1)) &&
              match(
                ident_opt,
                .None => false,
                .Some(id) => (id.as_str() == "open")
              )
        ) => match(
          args.get(usize(0)),
          .None => Option(String).None,
          .Some(open_arg) => match(
            call_gen_expr(open_arg, ctx, indent),
            .None => Option(String).None,
            .Some(open_recv) => {
              // First look for direct anon-var tracking, then registered struct fields
              fields_opt := match(
                ctx.*.get_open_var_fields(open_recv.as_str()),
                .Some(f) => Option(String).Some(f),
                .None => ctx.*.get_struct_fields(open_recv.as_str())
              );
              match(
                fields_opt,
                .None => Option(String).None,
                .Some(fcsv) => {
                  // Split CSV and emit bindings
                  field_list := _split_csv(fcsv.as_str());
                  nflds := field_list.len();
                  (fi_open : usize) = usize(0);
                  while(runtime(fi_open < nflds), {
                    fi_open = (fi_open + usize(1));
                    match(
                      field_list.get(fi_open - usize(1)),
                      .None => (),
                      .Some(fname_open) => {
                        ctx.*.emitter.emit_string(indent);
                        ctx.*.emitter.emit("__auto_type ");
                        ctx.*.emitter.emit_string(fname_open);
                        ctx.*.emitter.emit(" = ");
                        ctx.*.emitter.emit_string(open_recv);
                        ctx.*.emitter.emit(".");
                        ctx.*.emitter.emit_string(fname_open);
                        ctx.*.emitter.emit_line(";");
                      }
                    );
                  });
                  Option(String).Some(String.from("0"))
                }
              )
            }
          )
        ),
        // Pointer type cast: *(T)(expr) — generated as (T*)(expr) in C.
        // AST: FnCall(FnCall(Atom("*"), [TypeExpr], false), [arg], false)
        (
          (!(is_infix)) &&
            (args.len() == usize(1)) &&
              match(
                func_box.*,
                .Atom(_, _) => false,
                .FnCall(_, inner_func_box, inner_args, inner_infix, _) => (
                  (!(inner_infix)) &&
                    (inner_args.len() == usize(1)) &&
                      match(
                        inner_func_box.*,
                        .FnCall(_, _, _, _, _) => false,
                        .Atom(_, ibtok) => (ibtok.value.as_str() == "*")
                      )
                )
              )
        ) => match(
          func_box.*,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, _, inner_args2, _, _) => match(
            inner_args2.get(usize(0)),
            .None => Option(String).None,
            .Some(ty_expr_cast) => match(
              type_expr_to_c(ty_expr_cast),
              .None => Option(String).None,
              .Some(c_ty_cast) => match(
                args.get(usize(0)),
                .None => Option(String).None,
                .Some(val_expr_cast) => match(
                  call_gen_expr(val_expr_cast, ctx, indent),
                  .None => Option(String).None,
                  .Some(val_code_cast) => {
                    result_cast := String.from("(");
                    result_cast.push_string(c_ty_cast);
                    result_cast.push_str("*)(");
                    result_cast.push_string(val_code_cast);
                    result_cast.push_str(")");
                    Option(String).Some(result_cast)
                  }
                )
              )
            )
          )
        ),
        // begin block: { stmt1; …; last_expr }
        match(
          ident_opt,
          .None => false,
          .Some(id) => (id.as_str() == BK_BEGIN)
        ) => handle_begin(args, ctx, indent),
        // return(expr) — emit `return(expr);\n` and return "0" sentinel
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id.as_str() == "return")
          )
        ) => match(
          args.get(usize(0)),
          .None => {
            ctx.*.emitter.emit_string(indent);
            ctx.*.emitter.emit_line("return;");
            .Some(String.from("0"))
          },
          .Some(ret_expr) => {
            single_field_return := match(
              ret_expr,
              .Atom(_, _) => Option(String).None,
              .FnCall(_, ret_fn_box, ret_args, ret_infix, _) => cond(
                ret_infix => Option(String).None,
                (ret_args.len() != usize(1)) => Option(String).None,
                true => match(
                  ret_fn_box.*,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, ret_begin_tok) => cond(
                    ((ret_begin_tok.value.as_str() == BK_BEGIN) && (ctx.*.current_fn_return_type.len() > usize(0))) => match(
                      ret_args.get(usize(0)),
                      .None => Option(String).None,
                      .Some(ret_field_expr) => match(
                        ret_field_expr,
                        .FnCall(_, _, _, _, _) => Option(String).None,
                        .Atom(_, ret_field_tok) => {
                          c := String.from("(");
                          c.push_string(ctx.*.current_fn_return_type);
                          c.push_str("){ .");
                          c.push_string(ret_field_tok.value);
                          c.push_str(" = ");
                          c.push_string(sanitize_c_ident(ret_field_tok.value.as_str()));
                          c.push_str(" }");
                          Option(String).Some(c)
                        }
                      )
                    ),
                    true => Option(String).None
                  )
                )
              )
            );
            ret_code_opt := match(
              single_field_return,
              .Some(single_ret_code) => Option(String).Some(single_ret_code),
              .None => call_gen_expr(ret_expr, ctx, indent)
            );
            match(
              ret_code_opt,
              .None => Option(String).None,
              .Some(ret_code) => {
                ctx.*.emitter.emit_string(indent);
                ctx.*.emitter.emit("return ");
                ctx.*.emitter.emit_string(ret_code);
                ctx.*.emitter.emit_line(";");
                .Some(String.from("0"))
              }
            )
          }
        ),
        // escape(expr) — in the prototype codegen, treated identically to `return`.
        // In the full codegen, `escape` discards the continuation and exits the
        // enclosing handler-installed function.  For prototype purposes, emitting
        // `return(expr);` is correct for all non-async, non-effect code paths.
        // If the argument is unit (empty tuple, generates None) we emit a bare `return;`.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id.as_str() == "escape")
          )
        ) => match(
          args.get(usize(0)),
          .None => {
            ctx.*.emitter.emit_string(indent);
            ctx.*.emitter.emit_line("return;");
            .Some(String.from("0"))
          },
          .Some(esc_expr) => match(
            call_gen_expr(esc_expr, ctx, indent),
            // Unit escape (tuple() → None): emit bare return
            .None => {
              ctx.*.emitter.emit_string(indent);
              ctx.*.emitter.emit_line("return;");
              .Some(String.from("0"))
            },
            .Some(esc_code) => {
              ctx.*.emitter.emit_string(indent);
              ctx.*.emitter.emit("return ");
              ctx.*.emitter.emit_string(esc_code);
              ctx.*.emitter.emit_line(";");
              .Some(String.from("0"))
            }
          )
        ),
        // break — emit C `break;`
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id.as_str() == "break")
          )
        ) => {
          ctx.*.emitter.emit_string(indent);
          ctx.*.emitter.emit_line("break;");
          .Some(String.from("0"))
        },
        // continue — emit C `continue;`
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id.as_str() == "continue")
          )
        ) => {
          ctx.*.emitter.emit_string(indent);
          ctx.*.emitter.emit_line("continue;");
          .Some(String.from("0"))
        },
        // cond(arm1, arm2, …)
        match(
          ident_opt,
          .None => false,
          .Some(id) => (id.as_str() == "cond")
        ) => handle_cond(args, ctx, indent),
        // match(scrut, pat => body, …) — value-pattern ternary chain or data-enum switch
        match(
          ident_opt,
          .None => false,
          .Some(id) => (id.as_str() == "match")
        ) => cond(
          _has_data_arm(args) => handle_match_data(args, ctx, indent),
          true => handle_match_value(args, ctx, indent)
        ),
        // while runtime(cond), body
        match(
          ident_opt,
          .None => false,
          .Some(id) => (id.as_str() == "while")
        ) => handle_while(args, ctx, indent),
        // for iter_expr, (param) => { body } — iterator for-loop macro
        match(
          ident_opt,
          .None => false,
          .Some(id) => (id.as_str() == "for")
        ) => handle_for(args, ctx, indent),
        // if(cond, then) / if(cond, then, else)
        match(
          ident_opt,
          .None => false,
          .Some(id) => (id.as_str() == "if")
        ) => handle_if(args, ctx, indent),
        // Dot field access: a.b — infix FnCall with Dot func
        (is_infix && func_box_is_dot(func_box)) => handle_dot_access(args, ctx, indent),
        // Bare enum variant pattern: .Variant — non-infix, Dot func, exactly 1 arg.
        // Used in match arm patterns; resolves to `EnumName_Variant` via variant registry.
        ((!(is_infix)) && (func_box_is_dot(func_box) && (args.len() == usize(1)))) => handle_bare_dot_variant(args, ctx),
        // Method call: a.method(args) — func_box is itself a dot-dispatch FnCall
        func_box_is_dot_dispatch(func_box) => handle_method_call(func_box, args, ctx, indent),
        // Index directly into a call result: `make_list()(idx)`.
        (
          (!(is_infix)) &&
            (
              (args.len() == usize(1)) &&
                (ident_opt.is_none() && is_plain_identifier_call_expr(func_box.*))
            )
        ) => match(
          func_box.*,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, _, _, _, _) => match(
            call_gen_expr(func_box.*, ctx, indent),
            .None => Option(String).None,
            .Some(callee_c) => match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(index_expr) => match(
                call_gen_expr(index_expr, ctx, indent),
                .None => Option(String).None,
                .Some(index_c) => {
                  indexed_result := String.from("(");
                  indexed_result.push_string(callee_c);
                  indexed_result.push_str(").data[");
                  indexed_result.push_string(index_c);
                  indexed_result.push_str("]");
                  Option(String).Some(indexed_result)
                }
              )
            )
          )
        ),
        // assert(cond, msg) — runtime test assertion: emits if(!(cond)){exit(1);}
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id.as_str() == "assert")
          )
        ) => handle_assert(args, ctx, indent),
        // comptime_assert(cond) / comptime_expect_error(expr) — compile-time only, no-op in prototype.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => ((id.as_str() == "comptime_assert") || (id.as_str() == "comptime_expect_error"))
          )
        ) =>.Some(String.from("0")),
        // using(name) — strip the wrapper, emit the inner argument directly.
        // At expression level this appears as passing an evidence parameter.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id.as_str() == "using")
          )
        ) => match(
          args.get(usize(0)),
          .None =>.Some(String.from("0")),
          .Some(inner) => call_gen_expr(inner, ctx, indent)
        ),
        // given(name) — compile-time binding, no runtime effect. Emit "0".
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id.as_str() == "given")
          )
        ) =>.Some(String.from("0")),
        // Struct constructor: TypeName(field1: val1, field2: val2)
        // Detected by: non-infix, uppercase-start name, all args labeled.
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (is_uppercase_start(id) && all_labeled_args(args))
          )
        ) => match(
          ident_opt,
          .None => Option(String).None,
          .Some(id) => {
            resolved_id := cond(
              (id.as_str() == "Self") => {
                st := ctx.*.get_self_type();
                cond(
                  (st.len() > usize(0)) => String.from(st),
                  true => id
                )
              },
              true => id
            );
            handle_struct_constructor(resolved_id, args, ctx, indent)
          }
        ),
        // Positional struct constructor: TypeName(arg1, arg2, ...)
        // Detected by: non-infix, uppercase-start name, registered struct, all args unlabeled.
        // Emits C compound literal: (TypeName){arg1, arg2, ...}
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => {
              effective_id := cond(
                (id.as_str() == "Self") => {
                  st := ctx.*.get_self_type();
                  cond(
                    (st.len() > usize(0)) => String.from(st),
                    true => id
                  )
                },
                true => id
              );
              is_uppercase_start(effective_id) && ctx.*.is_struct_name(effective_id.as_str())
            }
          )
        ) => match(
          ident_opt,
          .None => Option(String).None,
          .Some(id) => {
            effective_id2 := cond(
              (id.as_str() == "Self") => {
                st := ctx.*.get_self_type();
                cond(
                  (st.len() > usize(0)) => String.from(st),
                  true => id
                )
              },
              true => id
            );
            result2 := String.from("(");
            result2.push_string(effective_id2);
            result2.push_str("){");
            n_args2 := args.len();
            (ai : usize) = usize(0);
            (args_ok : bool) = true;
            while(runtime((ai < n_args2) && args_ok), {
              match(
                args.get(ai),
                .None => {
                  args_ok = false;
                },
                .Some(aexpr) => match(
                  call_gen_expr(aexpr, ctx, indent),
                  .None => {
                    args_ok = false;
                  },
                  .Some(av) => {
                    if(ai > usize(0), {
                      result2.push_str(", ");
                    });
                    result2.push_string(av);
                  }
                )
              );
              ai = (ai + usize(1));
            });
            match(
              ctx.*.get_struct_defaults(effective_id2.as_str()),
              .None => (),
              .Some(defaults_csv2) => {
                default_values2 := _split_csv(defaults_csv2.as_str());
                n_defaults2 := default_values2.len();
                while(runtime((ai < n_defaults2) && args_ok), {
                  match(
                    default_values2.get(ai),
                    .None => (),
                    .Some(default_value2) => {
                      if(default_value2.as_str() != "__yo_no_default", {
                        if(ai > usize(0), {
                          result2.push_str(", ");
                        });
                        result2.push_string(default_value2);
                      });
                    }
                  );
                  ai = (ai + usize(1));
                });
              }
            );
            if(args_ok, {
              result2.push_str("}");
            });
            cond(
              args_ok => Option(String).Some(result2),
              true => Option(String).None
            )
          }
        ),
        // sizeof(type_name) — translate Yo type name to C type
        (
          (!(is_infix)) && (
            (args.len() == usize(1)) && match(
              ident_opt,
              .None => false,
              .Some(id) => (id.as_str() == "sizeof")
            )
          )
        ) => match(
          args.get(usize(0)),
          .None => Option(String).None,
          .Some(sz_arg) => {
            sz_c := match(
              sz_arg,
              .FnCall(_, _, _, _, _) => call_gen_expr(sz_arg, ctx, indent),
              .Atom(_, sz_tok) => {
                c_ty := type_name_to_c(sz_tok.value.as_str());
                Option(String).Some(c_ty)
              }
            );
            match(
              sz_c,
              .None => Option(String).None,
              .Some(sz_str) => {
                r := String.from("sizeof(");
                r.push_string(sz_str);
                r.push_str(")");
                Option(String).Some(r)
              }
            )
          }
        ),
        // Regular function call: f(args) — identifier func, not a builtin keyword
        // recur(args) — self-recursive call to the current function
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id.as_str() == "recur")
          )
        ) => match(
          gen_arg_list(args, ctx, indent),
          .None => Option(String).None,
          .Some(arg_s) => {
            result := String.new();
            result.push_string(ctx.*.current_fn_name);
            result.push_str("(");
            result.push_string(arg_s);
            result.push_str(")");
            Option(String).Some(result)
          }
        ),
        // box(arg) — heap-allocate a value and return a typed pointer to it
        (
          ((!(is_infix)) && (args.len() == usize(1))) && match(
            ident_opt,
            .None => false,
            .Some(id) => (id.as_str() == "box")
          )
        ) => match(
          args.get(usize(0)),
          .None => Option(String).None,
          .Some(arg_expr) => match(
            call_gen_expr(arg_expr, ctx, indent),
            .None => Option(String).None,
            .Some(arg_c) => {
              result := String.from("__yo_box(");
              result.push_string(arg_c);
              result.push_str(")");
              Option(String).Some(result)
            }
          )
        ),
        // Special case: primitive type cast — i32(x) → (int32_t)(x)
        (
          (!(is_infix)) &&
            (
              (args.len() == usize(1)) &&
                match(
                  ident_opt,
                  .None => false,
                  .Some(id) => is_primitive_type_cast(id.as_str())
                )
            )
        ) => match(
          ident_opt,
          .None => Option(String).None,
          .Some(id) => handle_type_cast(id, args, ctx, indent)
        ),
        (
          (!(is_infix)) && match(
            ident_opt,
            .None => false,
            .Some(id) => (!(is_builtin_keyword(id.as_str())))
          )
        ) => handle_regular_call(ident_opt, args, ctx, indent),
        // Assignment: x = val  OR  typed declaration: (x : T) = val
        (
          is_infix && match(
            op_opt,
            .None => false,
            .Some(op) => (op.as_str() == "=")
          )
        ) => handle_assignment(args, ctx, indent),
        // Bare type annotation: x : T  →  emit "T_c x;"
        (
          is_infix && match(
            op_opt,
            .None => false,
            .Some(op) => (op.as_str() == ":")
          )
        ) => handle_bare_colon_decl(args, ctx, indent),
        // Variable definition: x := val  →  __auto_type x = val;
        (
          is_infix && match(
            op_opt,
            .None => false,
            .Some(op) => (op.as_str() == ":=")
          )
        ) => handle_define(args, ctx, indent),
        // Constant binding: name :: val.
        // - If RHS is a literal → emit `__auto_type name = lit;` (comptime constant)
        // - If RHS is a call to a registered function → emit `__auto_type name = fn_callee(args);`
        // - If RHS is a struct constructor for a registered struct → emit `__auto_type name = (T){...};`
        // - Otherwise → "0" (no-op; function defs/type aliases are pre-hoisted or skipped)
        (
          is_infix && match(
            op_opt,
            .None => false,
            .Some(op) => (op.as_str() == "::")
          )
        ) => {
          lhs_name_opt := match(
            args.get(usize(0)),
            .None => Option(String).None,
            .Some(lhs_e) => match(
              lhs_e,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, ltok) => cond(
                (ltok.kind == TokenKind.Identifier) => Option(String).Some(ltok.value),
                true => Option(String).None
              )
            )
          );
          // Determine if the RHS is something we can generate:
          //   (a) a literal atom, (b) a call to a registered function,
          // Determine if the RHS is something we can generate.
          // We skip RHS that are function/enum/object/impl definitions (pre-hoisted or not runtime values),
          // type names (unit, etc.), and other meta-expressions.
          rhs_is_eligible := match(
            args.get(usize(1)),
            .None => false,
            .Some(rhs_e) => match(
              rhs_e,
              .Atom(_, rtok) => cond(
                (rtok.kind == TokenKind.Integer) => true,
                (rtok.kind == TokenKind.Float) => true,
                (rtok.kind == TokenKind.Bool) => true,
                (rtok.kind == TokenKind.StringLit) => true,
                // Identifier atoms: allow only known-defined names (variables)
                (rtok.kind == TokenKind.Identifier) => ctx.*.is_defined_fn(rtok.value.as_str()),
                true => false
              ),
              .FnCall(_, rhs_func, rhs_fargs, rhs_infix, _) => cond(
                // Infix `->` (function type expression) — not a runtime value
                (
                  rhs_infix && match(
                    rhs_func.*,
                    .Atom(_, rftok_i) => (rftok_i.value.as_str() == "->"),
                    .FnCall(_, _, _, _, _) => false
                  )
                ) => false,
                // Infix `=`, `:=`, `::`, `:` — assignment/definition patterns — not values
                (
                  rhs_infix && match(
                    rhs_func.*,
                    .Atom(_, rftok_asgn) => {
                      v := rftok_asgn.value.as_str();
                      ((v == "=") || (v == ":=")) || ((v == "::") || (v == ":"))
                    },
                    .FnCall(_, _, _, _, _) => false
                  )
                ) => false,
                // Dot-access infix `.` — field/method access — not a simple const value
                (
                  rhs_infix && match(
                    rhs_func.*,
                    .Atom(_, rftok_dot) => (rftok_dot.value.as_str() == "."),
                    .FnCall(_, _, _, _, _) => false
                  )
                ) => false,
                // Other infix binary arithmetic/bitwise/comparison ops (|, &, ^, +, -, *, /, <<, >>, %, ==, !=, <, >, &&, ||)
                // are runtime-eligible if all referenced identifiers are known C variables.
                // Exception: `+` on string operands is invalid C — reject it.
                (
                  rhs_infix && match(
                    rhs_func.*,
                    .Atom(_, rftok_b) => is_binary_op(rftok_b.value.as_str()),
                    .FnCall(_, _, _, _, _) => false
                  )
                ) => {
                  // Check if this is a string `+` — reject to avoid C pointer arithmetic
                  is_str_add := match(
                    rhs_func.*,
                    .FnCall(_, _, _, _, _) => false,
                    .Atom(_, rftok_op) => cond(
                      (rftok_op.value.as_str() != "+") => false,
                      true => {
                        has_str_atom := match(
                          args.get(usize(1)),
                          .None => false,
                          .Some(chk_e) => match(
                            chk_e,
                            .Atom(_, chk_tok) => (chk_tok.kind == TokenKind.StringLit),
                            .FnCall(_, _, chk_args, _, _) => cond(
                              // (str_id + ...) or (... + str_id): check if any arg is a string lit or string const var
                              true => {
                                (has_sl : bool) = false;
                                (sli : usize) = usize(0);
                                while(runtime((sli < chk_args.len()) && (!(has_sl))), {
                                  match(
                                    chk_args.get(sli),
                                    .None => (),
                                    .Some(sa) => match(
                                      sa,
                                      .Atom(_, sa_tok) => cond(
                                        (sa_tok.kind == TokenKind.StringLit) => {
                                          has_sl = true;
                                        },
                                        ((sa_tok.kind == TokenKind.Identifier) && ctx.*.is_string_const(sa_tok.value.as_str())) => {
                                          has_sl = true;
                                        },
                                        true => ()
                                      ),
                                      .FnCall(_, _, _, _, _) => ()
                                    )
                                  );
                                  sli = (sli + usize(1));
                                });
                                has_sl
                              }
                            )
                          )
                        );
                        has_str_atom
                      }
                    )
                  );
                  // Check both args to ensure all identifiers are available
                  all_ok := match(
                    args.get(usize(1)),
                    .None => false,
                    .Some(rhs_check) => ((!(is_str_add)) && expr_all_ids_known(rhs_check, ctx))
                  );
                  all_ok
                },
                rhs_infix => false,
                // Non-empty tuple literal: (a, b, …) — always eligible
                (
                  match(
                    rhs_func.*,
                    .Atom(_, rftok2) => ((rhs_fargs.len() > usize(0)) && (rftok2.value.as_str() == BK_TUPLE)),
                    .FnCall(_, _, _, _, _) => false
                  )
                ) => true,
                // Enum constructor: `EnumName.Variant(args)` where EnumName is registered.
                // e.g. `c1 :: Shape.Circle(5.0)` → eligible (emits full enum struct init).
                // Also requires that the variant has registered C fields (non-comptime-only).
                (
                  match(
                    rhs_func.*,
                    .FnCall(_, ect_fn, ect_args, ect_infix, _) => (
                      ect_infix &&
                        match(
                          ect_fn.*,
                          .Atom(_, ectok) => (ectok.value.as_str() == "."),
                          .FnCall(_, _, _, _, _) => false
                        ) &&
                          match(
                            ect_args.get(usize(0)),
                            .None => false,
                            .Some(ect_recv) => match(
                              ect_recv,
                              .Atom(_, ect_recv_tok) => (
                                ctx.*.is_enum_name(ect_recv_tok.value.as_str()) &&
                                  // Variant must have registered non-empty C fields; if fields are
                                  // comptime-only (e.g. comptime_int), get_variant_fields returns None
                                  // and we fall through to the no-op path.
                                  match(
                                    ect_args.get(usize(1)),
                                    .None => false,
                                    .Some(ect_var) => match(
                                      ect_var,
                                      .Atom(_, ect_var_tok) => ctx.*.get_variant_fields(
                                        ect_recv_tok.value.as_str(),
                                        ect_var_tok.value.as_str()
                                      ).is_some(),
                                      .FnCall(_, _, _, _, _) => false
                                    )
                                  )
                              ),
                              .FnCall(_, _, _, _, _) => false
                            )
                          )
                    ),
                    .Atom(_, _) => false
                  )
                ) => true,
                // Method call on a compound func (e.g. `5.neg()`, `arr.len()`) — eligible if
                // all referenced identifiers are known C variables.
                match(
                  rhs_func.*,
                  .FnCall(_, _, _, _, _) => true,
                  .Atom(_, _) => false
                ) => match(
                  args.get(usize(1)),
                  .None => false,
                  .Some(rhs_mc_chk) => expr_all_ids_known(rhs_mc_chk, ctx)
                ),
                true => match(
                  rhs_func.*,
                  .FnCall(_, _, _, _, _) => false,
                  .Atom(_, rftok) => cond(
                    // Skip: function definition body
                    (rftok.value.as_str() == "fn") => false,
                    // Skip: enum/object/impl/forall definitions
                    (rftok.value.as_str() == "enum") => false,
                    (rftok.value.as_str() == "object") => false,
                    (rftok.value.as_str() == "impl") => false,
                    (rftok.value.as_str() == "forall") => false,
                    (rftok.value.as_str() == "where") => false,
                    // Unary/binary operator symbol (non-identifier) → eligible if all identifier
                    // args reference known C variables.
                    // e.g., `n :: (-1000)` → `__auto_type n = (-1000);`
                    // e.g., `not_mask :: ~(u32(0xFF))` → `__auto_type not_mask = (~(uint32_t)(0xFF));`
                    (rftok.kind != TokenKind.Identifier) => match(
                      args.get(usize(1)),
                      .None => false,
                      .Some(rhs_unary_chk) => expr_all_ids_known(rhs_unary_chk, ctx)
                    ),
                    // Registered function call: callee is a known Yo function
                    (ctx.*.is_defined_fn(rftok.value.as_str())) => true,
                    // Registered struct constructor: callee starts uppercase and is a known struct
                    (ctx.*.is_struct_name(rftok.value.as_str())) => true,
                    // Primitive type cast: i32(0), u8(5), etc.
                    (is_primitive_type_cast(rftok.value.as_str())) => true,
                    true => false
                  )
                )
              )
            )
          );
          match(
            lhs_name_opt,
            .None =>.Some(String.from("0")),
            .Some(c_name) => match(
              args.get(usize(1)),
              .None =>.Some(String.from("0")),
              .Some(rhs_e2) => {
                method_extract_const_emitted := emit_method_extraction_macro_if_supported(c_name.as_str(), rhs_e2, ctx, indent);
                inline_type_alias_emitted := match(
                  rhs_e2,
                  .Atom(_, alias_atom_tok) => cond(
                    (alias_atom_tok.kind != TokenKind.Identifier) => false,
                    !(
                      ctx.*.is_struct_name(alias_atom_tok.value.as_str()) ||
                        ctx.*.is_enum_name(alias_atom_tok.value.as_str())
                    ) => false,
                    true => {
                      san_type_name := sanitize_c_ident(c_name.as_str());
                      ctx.*.emitter.emit_string(indent);
                      ctx.*.emitter.emit("typedef ");
                      ctx.*.emitter.emit_string(sanitize_c_ident(alias_atom_tok.value.as_str()));
                      ctx.*.emitter.emit(" ");
                      ctx.*.emitter.emit_string(san_type_name);
                      ctx.*.emitter.emit_line(";");
                      cond(
                        ctx.*.is_struct_name(alias_atom_tok.value.as_str()) => {
                          ctx.*.register_struct(String.from(c_name.as_str()));
                          true
                        },
                        true => {
                          ctx.*.register_enum(String.from(c_name.as_str()));
                          true
                        }
                      )
                    }
                  ),
                  .FnCall(_, type_alias_fn, _, type_alias_infix, _) => cond(
                    type_alias_infix => false,
                    true => match(
                      type_alias_fn.*,
                      .FnCall(_, _, _, _, _) => false,
                      .Atom(_, type_alias_tok) => {
                        type_alias_c_opt := cond(
                          (type_alias_tok.value.as_str() == "struct") => match(
                            rhs_e2,
                            .Atom(_, _) => Option(String).None,
                            .FnCall(_, _, type_alias_args, _, _) => anon_struct_type_to_c(type_alias_args)
                          ),
                          (type_alias_tok.value.as_str() == "Tuple") => type_expr_to_c(rhs_e2),
                          true => Option(String).None
                        );
                        match(
                          type_alias_c_opt,
                          .None => false,
                          .Some(type_alias_c) => {
                            san_type_name := sanitize_c_ident(c_name.as_str());
                            defaults_csv_for_alias := match(
                              rhs_e2,
                              .Atom(_, _) => String.new(),
                              .FnCall(_, _, type_alias_args2, _, _) => cond(
                                (type_alias_tok.value.as_str() == "struct") =>
                                  struct_default_values_csv(type_alias_args2, ctx, indent),
                                true => String.new()
                              )
                            );
                            has_defaults_for_alias := struct_defaults_has_value(defaults_csv_for_alias);
                            should_emit_alias := (
                              (!(type_alias_c.contains(String.from("Self")))) &&
                                (
                                  (type_alias_tok.value.as_str() == "Tuple") ||
                                    has_defaults_for_alias ||
                                      (!(ctx.*.is_struct_name(c_name.as_str())))
                                )
                            );
                            if(should_emit_alias, {
                              ctx.*.emitter.emit_string(indent);
                              ctx.*.emitter.emit("typedef ");
                              ctx.*.emitter.emit_string(type_alias_c);
                              ctx.*.emitter.emit(" ");
                              ctx.*.emitter.emit_string(san_type_name);
                              ctx.*.emitter.emit_line(";");
                              ctx.*.register_struct(String.from(c_name.as_str()));
                            });
                            if(has_defaults_for_alias, {
                              ctx.*.register_struct_defaults(c_name.as_str(), defaults_csv_for_alias.as_str());
                            });
                            should_emit_alias || has_defaults_for_alias
                          }
                        )
                      }
                    )
                  )
                );
                cond(
                  method_extract_const_emitted =>.Some(String.from("0")),
                  inline_type_alias_emitted =>.Some(String.from("0")),
                  // Inline array literal: `arr :: [v0, v1, ...]`
                  // Emit C array declaration and register as array var, same as `:=`.
                  (
                    (!(rhs_is_eligible)) && match(
                      rhs_e2,
                      .Atom(_, _) => false,
                      .FnCall(_, il_fn_b, il_fn_a, il_fi, _) => (
                        ((!(il_fi)) && (il_fn_a.len() > usize(0))) &&
                          match(
                            il_fn_b.*,
                            .FnCall(_, _, _, _, _) => false,
                            .Atom(_, il_tok) => (il_tok.value.as_str() == "array")
                          )
                      )
                    )
                  ) => match(
                    rhs_e2,
                    .Atom(_, _) =>.Some(String.from("0")),
                    .FnCall(_, _, il_args2, _, _) => {
                      n_il2 := il_args2.len();
                      init_il2 := String.from("{");
                      (il2_i : usize) = usize(0);
                      (il2_ok : bool) = true;
                      while(runtime((il2_i < n_il2) && il2_ok), {
                        match(
                          il_args2.get(il2_i),
                          .None => {
                            il2_ok = false;
                          },
                          .Some(il_e2) => match(
                            call_gen_expr(il_e2, ctx, indent),
                            .None => {
                              il2_ok = false;
                            },
                            .Some(il_c2) => {
                              if(il2_i > usize(0), {
                                init_il2.push_str(", ");
                              });
                              init_il2.push_string(il_c2);
                              il2_i = (il2_i + usize(1));
                            }
                          )
                        );
                      });
                      cond(
                        (!(il2_ok)) =>.Some(String.from("0")),
                        true => {
                          init_il2.push_str("}");
                          first_opt2 := match(
                            il_args2.get(usize(0)),
                            .None => Option(String).None,
                            .Some(fe2) => call_gen_expr(fe2, ctx, indent)
                          );
                          match(
                            first_opt2,
                            .None =>.Some(String.from("0")),
                            .Some(first2) => {
                              san_il := sanitize_c_ident(c_name.as_str());
                              ctx.*.emitter.emit_string(indent);
                              ctx.*.emitter.emit("__typeof__(");
                              ctx.*.emitter.emit_string(first2);
                              ctx.*.emitter.emit(") ");
                              ctx.*.emitter.emit_string(san_il);
                              ctx.*.emitter.emit("[");
                              ctx.*.emitter.emit_string(n_il2.to_string());
                              ctx.*.emitter.emit("] = ");
                              ctx.*.emitter.emit_string(init_il2);
                              ctx.*.emitter.emit_line(";");
                              ctx.*.register_array_var_with_size(c_name.as_str(), n_il2.to_string().as_str());
                              .Some(String.from("0"))
                            }
                          )
                        }
                      )
                    }
                  ),
                  // Skip if RHS is a function definition (pre-hoisted) or not eligible
                  (!(rhs_is_eligible)) =>.Some(String.from("0")),
                  true => match(
                    call_gen_expr(rhs_e2, ctx, indent),
                    .None =>.Some(String.from("0")),
                    .Some(rhs_code) => {
                      ctx.*.emitter.emit_string(indent);
                      ctx.*.emitter.emit("__auto_type ");
                      ctx.*.emitter.emit_string(c_name);
                      ctx.*.emitter.emit(" = ");
                      ctx.*.emitter.emit_string(rhs_code);
                      ctx.*.emitter.emit_line(";");
                      ctx.*.register_const_var(c_name.as_str());
                      // Track string constants so we can reject string `+` in dependent bindings
                      is_str_rhs := match(
                        rhs_e2,
                        .Atom(_, str_tok) => (str_tok.kind == TokenKind.StringLit),
                        .FnCall(_, _, _, _, _) => false
                      );
                      if(is_str_rhs, {
                        ctx.*.register_string_const(c_name.as_str());
                      });
                      .Some(String.from("0"))
                    }
                  )
                )
              }
            )
          )
        },
        true => Option(String).None
      )
    }
  )
);
// Initialize the g_gen_expr_fn pointer after generate_expr is defined.
_gen_expr_fn_init := (fn() -> bool)({
  g_gen_expr_fn =.Some(generate_expr);
  true
})();
export(generate_expr, sanitize_c_ident, is_binary_op, is_unary_prefix_op);
export(gen_integer_lit, gen_float_lit, gen_bool_lit, gen_string_lit);
export(gen_binary_op, gen_unary_op);
export(type_name_to_c, type_expr_to_c, is_c_type_name, is_builtin_keyword, is_primitive_type_cast, build_typed_decl);
export(gen_arg_list, handle_regular_call, handle_dot_access, handle_method_call, handle_assignment);
export(handle_define, handle_bare_colon_decl, handle_type_cast, handle_assert);
export(is_labeled_arg, all_labeled_args, is_uppercase_start, handle_struct_constructor);
export(gen_match_arm, handle_match_value, handle_match_data, handle_bare_dot_variant);
export(func_box_is_dot, func_box_is_dot_dispatch);
export(is_begin_block);
export(gen_anon_struct_compound, handle_tuple_literal);
export(is_lambda_expr, extract_lambda_param_names, lift_non_capturing_lambda);
