            )
          ),
          (ctx.get_var_type(recv_code.as_str()).is_some() && ((method_name == "get") && (args.len() == usize(1)))) => match(
            ctx.get_var_type(recv_code.as_str()),
            .None => Option(String).None,
            .Some(recv_ty_for_get) => cond(
              (!(is_arraylist_c_type(recv_ty_for_get.as_str()))) => Option(String).None,
              true => match(
                args.get(usize(0)),
                .None => Option(String).None,
