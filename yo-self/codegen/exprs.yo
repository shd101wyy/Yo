          ((generic_type_app_c_name(recv_expr).is_some() && (method_name == "Some")) && (args.len() == usize(1))) =>
            match(args.get(usize(0)),.None => Option(String).None,.Some(v) => call_gen_expr(v, ctx, indent)),
          ((generic_type_app_c_name(recv_expr).is_some() && (method_name == "None")) && (args.len() == usize(0))) =>
            match(
              generic_type_app_field_c_type(recv_expr),
