                    get_code.push_string(recv_code);
                    get_code.push_str(".data[");
                    get_code.push_string(get_idx_c);
                    get_code.push_str("])");
                    Option(String).Some(get_code)
                  }
                )
              )
            )
          ),
          (ctx.get_var_type(recv_code.as_str()).is_some() && ((method_name == "dispose") && (args.len() == usize(0)))) => match(
            ctx.get_var_type(recv_code.as_str()),
            .None => Option(String).None,
            .Some(recv_ty_for_dispose) => cond(
              is_arraylist_c_type(recv_ty_for_dispose.as_str()) => Option(String).Some(String.from("0")),
              true => Option(String).None
            )
          ),
          (ctx.get_var_type(recv_code.as_str()).is_some() && ((method_name == "set") && (args.len() == usize(2)))) => match(
            ctx.get_var_type(recv_code.as_str()),
            .None => Option(String).None,
            .Some(recv_ty_for_map_set) => cond(
              (!(is_runtime_map_c_type(recv_ty_for_map_set.as_str()))) => Option(String).None,
              true => match(
