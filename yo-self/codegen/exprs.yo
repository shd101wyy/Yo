//! Expression and statement code generation for the self-hosted Yo C code
//! generator.
//!
//! Phase 4b: literals (integer, float, bool, string), variable references,
//! binary infix operators, and unary prefix operators.
//!
//! Phase 4c: control flow — begin blocks, cond expressions, while loops,
//! if expressions.
//!
//! ASAN note: `generate_expr` is large but far below the ~700-variable
//! threshold that forced `evaluate()` to use the `g_eval_fn` pointer trick.
//! All Phase 4c control-flow helpers are factored into module-level functions.
//!
//! **Structural mapping vs src/**: this file is the **bootstrap codegen
//! dispatch** — the AST-walking counterpart to `evaluator/eval.yo`. It
//! pattern-matches the raw `AstExpr` AST and emits C, *without using the
//! evaluator*. src/ has no equivalent file: production codegen lives in
//! `src/codegen/{exprs,functions,types}/*.ts` and consumes the typed AST
//! from the evaluator, never the raw AST.
//!
//! Phases A.8.1-A.8.5 extracted the **genuinely 1-to-1 portable pieces**
//! into their proper src/-mirroring homes:
//!   * `codegen/exprs/atom.yo`     (Phase A.8.1) — `gen_*_lit`, `sanitize_c_ident`,
//!                                  `is_*_op`, `gen_binary_op`, `gen_unary_op`
//!   * `codegen/exprs/closures.yo` (Phase A.8.2) — `is_lambda_expr`,
//!                                  `extract_lambda_param_names`
//!   * `codegen/exprs/begin.yo`    (Phase A.8.3) — `emit_as_stmt`,
//!                                  `is_begin_block`, `is_stmt_body_expr`
//!   * `codegen/exprs/tuple_fn.yo` (Phase A.8.4) — `handle_tuple_literal`
//!   * `codegen/exprs/match.yo`    (Phase A.8.5) — match AST predicates
//!
//! The remaining ~12.7K lines here are **bootstrap-specific**: helpers
//! that have no src/ counterpart (e.g. `_split_csv` for CSV-encoded field
//! lists, `register_box_var`/`register_array_var` C-aggregate-shape
//! heuristics, generic-struct-instance-on-demand machinery, and the
//! giant `generate_expr` AST-pattern-matching dispatch). All of this
//! will be deleted once yo-self can use its own typed AST (the typed-AST
//! pivot, roadmap Phase 13at).
//!
//! Like `codegen/driver.yo` (A.6) and `evaluator/eval.yo` (A.7), the
//! remainder of this file is an **acceptable divergence
//! (bootstrap-specific)** with no further 1-to-1 decomposition target.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, BK_BEGIN, BK_ANON_STRUCT, BK_TUPLE } :: import("../expr.yo");
{ TokenKind } :: import("../token.yo");
{ CodegenContext } :: import("./context.yo");
{
  DataBinding,
  DataArm,
  generate_match_data,
  get_arm_args,
  _is_or_pattern,
  _is_data_arm_pattern,
  data_arm_variant_name,
  _get_arm_variant_name,
  _has_data_arm
} :: import("./exprs/match.yo");
{ set_generate_expr_fn, call_gen_expr } :: import("./exprs/expr.yo");
{ generate_consume } :: import("./exprs/consume.yo");
{ generate_yo_gc_collect } :: import("./exprs/gc.yo");
{ generate_yo_thread_set_maximum_threads } :: import("./exprs/parallelism.yo");
{ generate_sizeof } :: import("./exprs/sizeof.yo");
{ generate_yo_inline_function_call, is_yo_inline_builtin, generate_yo_inline_meta, is_yo_inline_meta_builtin } :: import("./exprs/inline_fns.yo");
{ generate_typeid } :: import("./exprs/typeid.yo");
{ generate_panic } :: import("./exprs/panic.yo");
{ generate_open } :: import("./exprs/open.yo");
{ generate_binding } :: import("./exprs/binding.yo");
{ generate_anonymous_tuple, handle_tuple_literal } :: import("./exprs/tuple_fn.yo");
{ generate_anonymous_array, generate_yo_array_fill } :: import("./exprs/array_fns.yo");
{ generate_recur } :: import("./exprs/recur.yo");
{ generate_yo_iso_extract, generate_yo_iso_dispose, is_iso_type_call, generate_iso_type_call }
:: import("./exprs/iso.yo");
{ generate_while_loop } :: import("./exprs/while.yo");
{ generate_op_and, generate_op_or } :: import("./exprs/and_or.yo");
{ generate_begin, emit_as_stmt, is_begin_block, is_stmt_body_expr } :: import("./exprs/begin.yo");
{ generate_cond } :: import("./exprs/cond.yo");
// Phase A.8.1: atom/op helpers (gen_*_lit, sanitize_c_ident, is_*_op,
// gen_binary_op, gen_unary_op) extracted to ./exprs/atom.yo.
{
  gen_integer_lit,
  gen_float_lit,
  gen_bool_lit,
  gen_string_lit,
  sanitize_c_ident,
  is_binary_op,
  is_unary_prefix_op,
  gen_binary_op,
  gen_unary_op
} :: import("./exprs/atom.yo");
{ is_lambda_expr, extract_lambda_param_names } :: import("./exprs/closures.yo");
// ---------------------------------------------------------------------------
// Phase 4b helpers — infix/prefix sub-expression generation
// ---------------------------------------------------------------------------
gen_infix_side :: (fn(args : ArrayList(AstExpr), idx : usize, ctx : CodegenContext, indent : String) -> Option(String))(
  match(
    args.get(idx),
    .None => Option(String).None,
    .Some(e) => call_gen_expr(e, ctx, indent)
  )
);
handle_infix_op :: (
  fn(
    op : String,
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  lhs := gen_infix_side(args, usize(0), ctx, indent);
  rhs := gen_infix_side(args, usize(1), ctx, indent);
  match(
    lhs,
    .None => Option(String).None,
    .Some(l) => match(
      rhs,
      .None => Option(String).None,
      .Some(r) => {
        // Use strcmp for string equality/inequality comparisons.
        // Detect: either side is a C string literal (starts with '"') or
        // a to_string() call (contains "_to_string(").
        lhs_is_str := (l.starts_with(String.from("\"")) || (l.contains(String.from("_to_string(")) || (l.contains(String.from("__yo_")) || match(ctx.get_var_type(l.as_str()),.None => false,.Some(ltyp) => (ltyp == "const char*")))));
        rhs_is_str := (r.starts_with(String.from("\"")) || (r.contains(String.from("_to_string(")) || (r.contains(String.from("__yo_")) || match(ctx.get_var_type(r.as_str()),.None => false,.Some(rtyp) => (rtyp == "const char*")))));
        // box var check: `box(T)` returns a pointer; compare via deref (*x == *y).
        lhs_is_box := ctx.is_box_var(l.as_str());
        // Derive-Eq type check: look up the type of lhs variable and check for registered Eq.
        lhs_eq_type := match(
          ctx.get_var_type(l.as_str()),
          .None => Option(String).None,
          .Some(t) => cond(
            ctx.has_derive_eq(t.as_str()) => Option(String).Some(t),
            true => Option(String).None
          )
        );
        // Derive-Ord type check: look up type of lhs and check for registered Ord.
        lhs_ord_type := match(
          ctx.get_var_type(l.as_str()),
          .None => Option(String).None,
          .Some(t) => cond(
            ctx.has_derive_ord(t.as_str()) => Option(String).Some(t),
            true => Option(String).None
          )
        );
        is_cmp_op := ((op == "<") || ((op == "<=") || ((op == ">") || (op == ">="))));
        cond(
          ((lhs_is_str || rhs_is_str) && (op == "==")) => {
            out := String.from("(strcmp(");
            out.push_string(l);
            out.push_str(", ");
            out.push_string(r);
            out.push_str(") == 0)");
            Option(String).Some(out)
          },
          ((lhs_is_str || rhs_is_str) && (op == "!=")) => {
            out2 := String.from("(strcmp(");
            out2.push_string(l);
            out2.push_str(", ");
            out2.push_string(r);
            out2.push_str(") != 0)");
            Option(String).Some(out2)
          },
          // box var: compare dereferenced values (*x == *y)
          (lhs_is_box && (op == "==")) => {
            out_box := String.from("(*");
            out_box.push_string(l);
            out_box.push_str(" == *");
            out_box.push_string(r);
            out_box.push_str(")");
            Option(String).Some(out_box)
          },
          (lhs_is_box && (op == "!=")) => {
            out_box2 := String.from("(*");
            out_box2.push_string(l);
            out_box2.push_str(" != *");
            out_box2.push_string(r);
            out_box2.push_str(")");
            Option(String).Some(out_box2)
          },
          ((op == "==") && lhs_eq_type.is_some()) => match(
            lhs_eq_type,
            .None =>.Some(gen_binary_op(op, l, r)),
            .Some(ty_name) => {
              out3 := String.from("fn_");
              out3.push_string(ty_name);
              out3.push_str("_eq(&");
              out3.push_string(l);
              out3.push_str(", &");
              out3.push_string(r);
              out3.push_str(")");
              Option(String).Some(out3)
            }
          ),
          ((op == "!=") && lhs_eq_type.is_some()) => match(
            lhs_eq_type,
            .None =>.Some(gen_binary_op(op, l, r)),
            .Some(ty_name2) => {
              out4 := String.from("(!fn_");
              out4.push_string(ty_name2);
              out4.push_str("_eq(&");
              out4.push_string(l);
              out4.push_str(", &");
              out4.push_string(r);
              out4.push_str("))");
              Option(String).Some(out4)
            }
          ),
          // Derive-Ord: dispatch `<`, `<=`, `>`, `>=` to fn_TypeName_cmp
          (is_cmp_op && lhs_ord_type.is_some()) => match(
            lhs_ord_type,
            .None =>.Some(gen_binary_op(op, l, r)),
            .Some(ord_ty) => {
              cmp_call := String.from("fn_");
              cmp_call.push_string(ord_ty);
              cmp_call.push_str("_cmp(&");
              cmp_call.push_string(l);
              cmp_call.push_str(", &");
              cmp_call.push_string(r);
              cmp_call.push_str(")");
              // `< 0`, `<= 0`, `> 0`, `>= 0`
              cmp_rhs := String.from("0");
              out_cmp := String.from("(");
              out_cmp.push_string(cmp_call);
              out_cmp.push_str(" ");
              out_cmp.push_string(op);
              out_cmp.push_str(" ");
              out_cmp.push_string(cmp_rhs);
              out_cmp.push_str(")");
              Option(String).Some(out_cmp)
            }
          ),
          true =>.Some(gen_binary_op(op, l, r))
        )
      }
    )
  )
});
handle_prefix_op :: (
  fn(
    op : String,
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)(
  match(
    args.get(usize(0)),
    .None => Option(String).None,
    .Some(e) => match(
      call_gen_expr(e, ctx, indent),
      .None => Option(String).None,
      .Some(a) =>.Some(gen_unary_op(op, a))
    )
  )
);
/// Extract the operator string from a FnCall func expression.
extract_op :: (fn(func_box : Box(AstExpr)) -> Option(String))(
  match(
    func_box.*,
    .Atom(_, ftok) => cond(
      (ftok.kind == TokenKind.Operator) =>.Some(ftok.value),
      true => Option(String).None
    ),
    .FnCall(_, _, _, _, _) => Option(String).None
  )
);
// ---------------------------------------------------------------------------
// Phase 4c helpers — control flow
// ---------------------------------------------------------------------------
// Phase A.8.3: emit_as_stmt + is_begin_block + is_stmt_body_expr were
// relocated to `./exprs/begin.yo`.
/// Generate a `begin` block.
///
/// Emits all statements except the last into `ctx.emitter` and returns the
/// last expression as the block's value.  An empty begin block returns `"0"`.
///
/// Nested begin blocks that appear as non-last statements are wrapped in C
/// `{ }` so that variable declarations inside each block are properly scoped
/// and don't conflict with declarations in sibling blocks.
handle_begin :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  cond(
    (n == usize(0)) =>.Some(String.from("0")),
    true => {
      // Emit all but the last statement
      (i : usize) = usize(0);
      inner := {
        result_so_far := String.from(indent.as_str());
        result_so_far.push_str("  ");
        result_so_far
      };
      while(i < (n - usize(1)), {
        match(
          args.get(i),
          .None => (),
          .Some(s) => cond(
            // Nested begin block: wrap in C { } for proper variable scoping.
            // Without wrapping, the same variable name (e.g. `x`) in two sibling
            // begin blocks would cause a C "redefinition" compile error.
            is_begin_block(s) => {
              ctx.emitter.emit_string(indent);
              ctx.emitter.emit_line("{");
              _nested_val := call_gen_expr(s, ctx, inner);
              ctx.emitter.emit_string(indent);
              ctx.emitter.emit_line("}");
            },
            true => match(
              call_gen_expr(s, ctx, inner),
              .None => (),
              .Some(code) => emit_as_stmt(code, ctx, indent)
            )
          )
        );
        i = (i + usize(1));
      });
      // Return the last expression as the block value
      match(
        args.get(n - usize(1)),
        .None =>.Some(String.from("0")),
        .Some(e) => call_gen_expr(e, ctx, indent)
      )
    }
  )
});
// Phase A.8.5: `get_arm_args` and other match AST predicates relocated to
// `./exprs/match.yo`.
/// Emit a `cond(...)` as a series of C `if / else if / else` statements.
///
/// Used when one or more arm bodies contain statement-level constructs
/// (`continue`, `break`, `return`) that are invalid inside a C ternary.
///
/// Emits side effects into `ctx.emitter` and returns `Some("0")` as unit sentinel.
emit_cond_as_if_else :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  inner := String.from(indent.as_str());
  inner.push_str("  ");
  (i : usize) = usize(0);
  (ok : bool) = true;
  while((i < n) && ok, {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arm) => match(
        get_arm_args(arm),
        .None => {
          ok = false;
        },
        .Some(arm_args) => match(
          arm_args.get(usize(0)),
          .None => {
            ok = false;
          },
          .Some(cond_expr) => match(
            arm_args.get(usize(1)),
            .None => {
              ok = false;
            },
            .Some(body_expr) => {
              is_first := (i == usize(0));
              is_last := (i == (n - usize(1)));
              is_true_catch := match(
                cond_expr,
                .Atom(_, ctok) => ((ctok.kind == TokenKind.Bool) && (ctok.value == "true")),
                .FnCall(_, _, _, _, _) => false
              );
              cond(
                // cond(true => body) with no prior arms — just emit body
                (is_first && is_true_catch) => {
                  match(
                    call_gen_expr(body_expr, ctx, indent),
                    .None => (),
                    .Some(bs) => {
                      emit_as_stmt(bs, ctx, indent);
                    }
                  );
                },
                // else { body; } — the catch-all arm
                is_true_catch => {
                  ctx.emitter.emit(" else {\n");
                  match(
                    call_gen_expr(body_expr, ctx, inner),
                    .None => (),
                    .Some(bs) => {
                      emit_as_stmt(bs, ctx, inner);
                    }
                  );
                  ctx.emitter.emit_string(indent);
                  ctx.emitter.emit("}\n");
                },
                // if (cond) { body; }  or  } else if (cond) { body; }
                true => {
                  cond(
                    is_first => {
                      ctx.emitter.emit_string(indent);
                      ctx.emitter.emit("if (");
                    },
                    true => {
                      ctx.emitter.emit(" else if (");
                    }
                  );
                  match(
                    call_gen_expr(cond_expr, ctx, indent),
                    .None => {
                      ok = false;
                    },
                    .Some(c) => {
                      ctx.emitter.emit_string(c);
                      ctx.emitter.emit(") {\n");
                      match(
                        call_gen_expr(body_expr, ctx, inner),
                        .None => (),
                        .Some(bs) => {
                          emit_as_stmt(bs, ctx, inner);
                        }
                      );
                      ctx.emitter.emit_string(indent);
                      cond(
                        is_last => {
                          ctx.emitter.emit("}\n");
                        },
                        true => {
                          ctx.emitter.emit("}");
                        }
                      );
                    }
                  )
                }
              );
            }
          )
        )
      )
    );
    i = (i + usize(1));
  });
  cond(
    ok =>.Some(String.from("0")),
    true => Option(String).None
  )
});
emit_returning_branch_body :: (
  fn(
    branch_body : AstExpr,
    ctx : CodegenContext,
    inner : String
  ) -> bool
)(
  match(
    call_gen_expr(branch_body, ctx, inner),
    .None => false,
    .Some(bs) => {
      if(bs != "0", {
        ctx.emitter.emit_string(inner);
        ctx.emitter.emit("return ");
        ctx.emitter.emit_string(bs);
        ctx.emitter.emit_line(";");
      });
      true
    }
  )
);
emit_cond_as_return_if_else :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  inner := String.from(indent.as_str());
  inner.push_str("  ");
  (i : usize) = usize(0);
  (ok : bool) = true;
  while((i < n) && ok, {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arm) => match(
        get_arm_args(arm),
        .None => {
          ok = false;
        },
        .Some(arm_args) => match(
          arm_args.get(usize(0)),
          .None => {
            ok = false;
          },
          .Some(cond_expr) => match(
            arm_args.get(usize(1)),
            .None => {
              ok = false;
            },
            .Some(body_expr) => {
              is_first := (i == usize(0));
              is_last := (i == (n - usize(1)));
              is_true_catch := match(
                cond_expr,
                .Atom(_, ctok) => ((ctok.kind == TokenKind.Bool) && (ctok.value == "true")),
                .FnCall(_, _, _, _, _) => false
              );
              cond(
                (is_first && is_true_catch) => {
                  ok = emit_returning_branch_body(body_expr, ctx, inner);
                },
                is_true_catch => {
                  ctx.emitter.emit(" else {\n");
                  ok = emit_returning_branch_body(body_expr, ctx, inner);
                  ctx.emitter.emit_string(indent);
                  ctx.emitter.emit("}\n");
                },
                true => {
                  cond(
                    is_first => {
                      ctx.emitter.emit_string(indent);
                      ctx.emitter.emit("if (");
                    },
                    true => {
                      ctx.emitter.emit(" else if (");
                    }
                  );
                  match(
                    call_gen_expr(cond_expr, ctx, indent),
                    .None => {
                      ok = false;
                    },
                    .Some(c) => {
                      ctx.emitter.emit_string(c);
                      ctx.emitter.emit(") {\n");
                      ok = emit_returning_branch_body(body_expr, ctx, inner);
                      ctx.emitter.emit_string(indent);
                      cond(
                        is_last => {
                          ctx.emitter.emit("}\n");
                        },
                        true => {
                          ctx.emitter.emit("}");
                        }
                      );
                    }
                  )
                }
              );
            }
          )
        )
      )
    );
    i = (i + usize(1));
  });
  cond(
    ok =>.Some(String.from("0")),
    true => Option(String).None
  )
});
/// True if `expr` is an Atom with token value equal to `val`.
_is_atom_value :: (fn(expr : AstExpr, val : str) -> bool)(
  match(
    expr,
    .Atom(_, tok) => (tok.value == val),
    .FnCall(_, _, _, _, _) => false
  )
);
/// Generate a single `cond` arm as: `(cond_expr ? body_expr : rest)`.
/// `rest` is the "else" branch (another ternary or the fallback value).
gen_cond_arm :: (
  fn(
    arm_args : ArrayList(AstExpr),
    rest : String,
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  cond_expr_opt := arm_args.get(usize(0));
  body_expr_opt := arm_args.get(usize(1));
  match(
    cond_expr_opt,
    .None => Option(String).None,
    .Some(cond_expr) => match(
      body_expr_opt,
      .None => Option(String).None,
      .Some(body_expr) => {
        // Constant folding: `true =>` always takes this branch; `false =>` skips it.
        // Note: constant folding at codegen level is important for avoiding dead code
        // (e.g. `cond(true => 42, false => undefined_fn())` must not emit `undefined_fn`).
        is_lit_true := _is_atom_value(cond_expr, "true");
        is_lit_false := _is_atom_value(cond_expr, "false");
        cond(
          is_lit_true => call_gen_expr(body_expr, ctx, indent),
          is_lit_false => Option(String).Some(rest),
          true => {
            c_opt := call_gen_expr(cond_expr, ctx, indent);
            b_opt := call_gen_expr(body_expr, ctx, indent);
            match(
              c_opt,
              .None => Option(String).None,
              .Some(c) => match(
                b_opt,
                .None => Option(String).None,
                .Some(b) => {
                  result := String.from("(");
                  result.push_string(c);
                  result.push_str(" ? ");
                  result.push_string(b);
                  result.push_str(" : ");
                  result.push_string(rest);
                  result.push_str(")");
                  Option(String).Some(result)
                }
              )
            )
          }
        )
      }
    )
  )
});
/// Generate a `cond(arm1, arm2, …)` expression as a right-nested C ternary,
/// or as a series of `if / else if / else` statements when any arm body is
/// a statement-level construct (continue, break, return, or a begin block
/// ending with one of those).
///
/// Ternary path: built right-to-left; last arm becomes the else branch.
/// If-else path: emitted left-to-right as `if (c1) { b1; } else if (c2) { b2; } …`.
handle_cond :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  cond(
    (n == usize(0)) =>.Some(String.from("0")),
    true => {
      // Check if any arm body requires statement-level emission.
      has_stmt_body := {
        (k : usize) = usize(0);
        (found : bool) = false;
        while((k < n) && (!(found)), {
          match(
            args.get(k),
            .None => (),
            .Some(arm) => match(
              get_arm_args(arm),
              .None => (),
              .Some(arm_args) => match(
                arm_args.get(usize(1)),
                .None => (),
                .Some(body_expr) => {
                  found = is_stmt_body_expr(body_expr);
                }
              )
            )
          );
          k = (k + usize(1));
        });
        found
      };
      has_begin_body := {
        (bk : usize) = usize(0);
        (found_begin : bool) = false;
        while((bk < n) && (!(found_begin)), {
          match(
            args.get(bk),
            .None => (),
            .Some(arm_b) => match(
              get_arm_args(arm_b),
              .None => (),
              .Some(arm_args_b) => match(
                arm_args_b.get(usize(1)),
                .None => (),
                .Some(body_expr_b) => {
                  found_begin = is_begin_block(body_expr_b);
                }
              )
            )
          );
          bk = (bk + usize(1));
        });
        found_begin
      };
      can_return_from_cond := ((ctx.current_fn_return_type.len() > usize(0)) && (ctx.current_fn_return_type != "void"));
      cond(
        ((has_begin_body && (!(has_stmt_body))) && can_return_from_cond) => emit_cond_as_return_if_else(args, ctx, indent),
        (has_stmt_body || has_begin_body) => emit_cond_as_if_else(args, ctx, indent),
        true => {
          // Build right-to-left, starting from the last arm's body as the default.
          last_arm_opt := args.get(n - usize(1));
          (acc : Option(String)) = match(
            last_arm_opt,
            .None => Option(String).None,
            .Some(last_arm) => match(
              get_arm_args(last_arm),
              .None => Option(String).None,
              .Some(la) => match(
                la.get(usize(1)),
                .None => Option(String).None,
                .Some(body) => call_gen_expr(body, ctx, indent)
              )
            )
          );
          (i : usize) = cond(
            (n > usize(1)) => (n - usize(2)),
            true => usize(0)
          );
          (done : bool) = (n <= usize(1));
          while(!(done), {
            match(
              acc,
              .None => {
                done = true;
              },
              .Some(rest_str) => {
                match(
                  args.get(i),
                  .None => {
                    done = true;
                  },
                  .Some(arm) => {
                    match(
                      get_arm_args(arm),
                      .None => {
                        done = true;
                      },
                      .Some(arm_args) => {
                        acc = gen_cond_arm(arm_args, rest_str, ctx, indent);
                      }
                    );
                  }
                );
                cond(
                  (i == usize(0)) => {
                    done = true;
                  },
                  true => {
                    i = (i - usize(1));
                  }
                )
              }
            );
          });
          acc
        }
      )
    }
  )
});
/// Build a C boolean condition for a single match arm pattern.
/// For simple patterns (not `|`): `(scrut_temp == pattern)`.
/// For or-patterns `(a | b)`: `((scrut_temp == a) || (scrut_temp == b))`.
_build_match_condition :: (
  fn(
    pat_expr : AstExpr,
    scrut_temp : String,
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)(
  cond(
    _is_or_pattern(pat_expr) => match(
      pat_expr,
      .Atom(_, _) => Option(String).None,
      .FnCall(_, _, pargs, _, _) => match(
        pargs.get(usize(0)),
        .None => Option(String).None,
        .Some(left) => match(
          pargs.get(usize(1)),
          .None => Option(String).None,
          .Some(right) => match(
            recur(left, scrut_temp, ctx, indent),
            .None => Option(String).None,
            .Some(left_cond) => match(
              recur(right, scrut_temp, ctx, indent),
              .None => Option(String).None,
              .Some(right_cond) => {
                oc := String.from("(");
                oc.push_string(left_cond);
                oc.push_str(" || ");
                oc.push_string(right_cond);
                oc.push_str(")");
                .Some(oc)
              }
            )
          )
        )
      )
    ),
    true => match(
      call_gen_expr(pat_expr, ctx, indent),
      .None => Option(String).None,
      .Some(p) => {
        ec := String.from("(");
        ec.push_string(scrut_temp);
        ec.push_str(" == ");
        ec.push_string(p);
        ec.push_str(")");
        .Some(ec)
      }
    )
  )
);
/// Generate a single `match` arm as: `(condition ? body : rest)`.
/// Wildcard pattern `_` skips the condition: returns body directly.
/// Or-patterns `(a | b)` expand to `((scrut == a) || (scrut == b))`.
gen_match_arm :: (
  fn(
    arm_args : ArrayList(AstExpr),
    scrut_temp : String,
    rest : String,
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  pat_opt := arm_args.get(usize(0));
  body_opt := arm_args.get(usize(1));
  match(
    pat_opt,
    .None => Option(String).None,
    .Some(pat_expr) => match(
      body_opt,
      .None => Option(String).None,
      .Some(body_expr) => {
        is_wild := match(
          pat_expr,
          .Atom(_, ptok) => (ptok.value == "_"),
          .FnCall(_, _, _, _, _) => false
        );
        match(
          call_gen_expr(body_expr, ctx, indent),
          .None => Option(String).None,
          .Some(b) => cond(
            is_wild =>.Some(b),
            true => match(
              _build_match_condition(pat_expr, scrut_temp, ctx, indent),
              .None => Option(String).None,
              .Some(condition) => {
                result := String.from("(");
                result.push_string(condition);
                result.push_str(" ? ");
                result.push_string(b);
                result.push_str(" : ");
                result.push_string(rest);
                result.push_str(")");
                .Some(result)
              }
            )
          )
        )
      }
    )
  )
});
/// Generate a `match(scrut, pat => body, ...)` expression as a ternary chain.
///
/// The scrutinee is emitted into a `__auto_type` temp variable first to
/// avoid repeated evaluation. Arms are processed right-to-left into a nested
/// ternary: `(temp == pat1 ? b1 : (temp == pat2 ? b2 : ... default))`.
/// Emit `match(scrut, arm1, arm2, …)` as C `if / else if / else` statements.
///
/// Used when one or more arm bodies contain statement-level constructs
/// (`continue`, `break`, `return`) that are invalid inside a C ternary.
///
/// Emits side effects into `ctx.emitter` and returns `Some("0")` as unit sentinel.
emit_match_value_as_if_else :: (
  fn(
    scrut_temp : String,
    arms : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  n := arms.len();
  inner := String.from(indent.as_str());
  inner.push_str("  ");
  (i : usize) = usize(0);
  (ok : bool) = true;
  while((i < n) && ok, {
    match(
      arms.get(i),
      .None => {
        ok = false;
      },
      .Some(arm) => match(
        get_arm_args(arm),
        .None => {
          ok = false;
        },
        .Some(arm_args) => match(
          arm_args.get(usize(0)),
          .None => {
            ok = false;
          },
          .Some(pat_expr) => match(
            arm_args.get(usize(1)),
            .None => {
              ok = false;
            },
            .Some(body_expr) => {
              is_first := (i == usize(0));
              is_last := (i == (n - usize(1)));
              is_wild := _is_atom_value(pat_expr, "_");
              cond(
                // Wildcard `_` → else { body }
                is_wild => {
                  ctx.emitter.emit(" else {\n");
                  match(
                    call_gen_expr(body_expr, ctx, inner),
                    .None => (),
                    .Some(bs) => {
                      emit_as_stmt(bs, ctx, inner);
                    }
                  );
                  ctx.emitter.emit_string(indent);
                  ctx.emitter.emit("}\n");
                },
                // Regular arm → if (temp == pat) { body } or } else if (temp == pat) {
                true =>
                  match(
                    call_gen_expr(pat_expr, ctx, indent),
                    .None => {
                      ok = false;
                    },
                    .Some(pat_code) => {
                      cond(
                        is_first => {
                          ctx.emitter.emit_string(indent);
                          ctx.emitter.emit("if ((");
                        },
                        true => {
                          ctx.emitter.emit(" else if ((");
                        }
                      );
                      ctx.emitter.emit_string(scrut_temp);
                      ctx.emitter.emit(" == ");
                      ctx.emitter.emit_string(pat_code);
                      ctx.emitter.emit(")) {\n");
                      match(
                        call_gen_expr(body_expr, ctx, inner),
                        .None => (),
                        .Some(bs) => {
                          emit_as_stmt(bs, ctx, inner);
                        }
                      );
                      ctx.emitter.emit_string(indent);
                      cond(
                        is_last => {
                          ctx.emitter.emit("}\n");
                        },
                        true => {
                          ctx.emitter.emit("}");
                        }
                      );
                    }
                  )
              );
            }
          )
        )
      )
    );
    i = (i + usize(1));
  });
  cond(
    ok =>.Some(String.from("0")),
    true => Option(String).None
  )
});
/// A `_` wildcard arm becomes the default (outermost else).
///
/// Only handles simple value patterns. Data-enum arms (`.Variant(bindings)`)
/// are not yet supported and fall through to `None`.
handle_match_value :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  cond(
    (n < usize(2)) => Option(String).None,
    true => {
      scrut_opt := args.get(usize(0));
      match(
        scrut_opt,
        .None => Option(String).None,
        .Some(scrut_expr) => match(
          call_gen_expr(scrut_expr, ctx, indent),
          .None => Option(String).None,
          .Some(scrut_code) => {
            // Emit scrutinee into a temp to avoid re-evaluation
            temp := ctx.fresh_temp();
            ctx.emitter.emit_string(indent);
            ctx.emitter.emit("__auto_type ");
            ctx.emitter.emit_string(temp);
            ctx.emitter.emit(" = ");
            ctx.emitter.emit_string(scrut_code);
            ctx.emitter.emit_line(";");
            // Check if any arm body requires statement-level emission.
            arm_count := (n - usize(1));
            has_stmt := {
              (k : usize) = usize(1);
              (found : bool) = false;
              while((k < n) && (!(found)), {
                match(
                  args.get(k),
                  .None => (),
                  .Some(arm) => match(
                    get_arm_args(arm),
                    .None => (),
                    .Some(arm_args) => match(
                      arm_args.get(usize(1)),
                      .None => (),
                      .Some(body_expr) => {
                        found = is_stmt_body_expr(body_expr);
                      }
                    )
                  )
                );
                k = (k + usize(1));
              });
              found
            };
            cond(
              has_stmt => {
                // Build arm list from args[1..]
                arms := ArrayList(AstExpr).new();
                (k : usize) = usize(1);
                while(k < n, {
                  match(
                    args.get(k),
                    .None => (),
                    .Some(arm) => {
                      _r := arms.push(arm);
                      ()
                    }
                  );
                  k = (k + usize(1));
                });
                emit_match_value_as_if_else(temp, arms, ctx, indent)
              },
              true => {
                // Build ternary chain right-to-left (arms are args[1..])
                last_arm_opt := args.get(n - usize(1));
                (acc : Option(String)) = match(
                  last_arm_opt,
                  .None => Option(String).None,
                  .Some(last_arm) => match(
                    get_arm_args(last_arm),
                    .None => Option(String).None,
                    .Some(la) => match(
                      la.get(usize(1)),
                      .None => Option(String).None,
                      .Some(body) => call_gen_expr(body, ctx, indent)
                    )
                  )
                );
                (i : usize) = cond(
                  (arm_count > usize(1)) => (arm_count - usize(2)),
                  true => usize(0)
                );
                (done : bool) = (arm_count <= usize(1));
                while(!(done), {
                  match(
                    acc,
                    .None => {
                      done = true;
                    },
                    .Some(rest_str) => {
                      match(
                        args.get(i + usize(1)),
                        .None => {
                          done = true;
                        },
                        .Some(arm) => {
                          match(
                            get_arm_args(arm),
                            .None => {
                              done = true;
                            },
                            .Some(arm_args) => {
                              acc = gen_match_arm(arm_args, temp, rest_str, ctx, indent);
                            }
                          );
                        }
                      );
                      cond(
                        (i == usize(0)) => {
                          done = true;
                        },
                        true => {
                          i = (i - usize(1));
                        }
                      )
                    }
                  );
                });
                acc
              }
            )
          }
        )
      )
    }
  )
});
/// Split a comma-separated string like "r" or "w,h" into an ArrayList of field name Strings.
_split_csv :: (fn(csv : str) -> ArrayList(String))({
  parts := ArrayList(String).new();
  n := csv.len();
  base_ptr := csv.ptr();
  (i : usize) = usize(0);
  (start : usize) = usize(0);
  while(i <= n, {
    is_sep := cond(
      (i == n) => true,
      true => (csv.bytes(i) == u8(44)) // 44 = ','
    );
    if(is_sep, {
      seg_len := (i - start);
      if(seg_len > usize(0), {
        seg_ptr := (base_ptr &+ start);
        part := str.from_raw_parts(seg_ptr, seg_len);
        _r := parts.push(String.from(part));
        ()
      });
      start = (i + usize(1));
    });
    i = (i + usize(1));
  });
  parts
});
/// Extract DataArm info from a single match arm pattern expression.
///
/// Returns `(tag_const, bindings)`:
/// - `tag_const` is empty for wildcard arms; otherwise "EnumName_VariantName".
/// - `bindings` is a list of (var_name, field_path, type_c) for data bindings.
///
/// Supported pattern forms:
/// - `Atom('_')` — wildcard → ("", [])
/// - `FnCall(Atom('.'), [Atom(V)])` — unit dot variant → ("EnumName_V", [])
/// - `FnCall(FnCall(Atom('.'), [Atom(V)]), [bindings...])` — data variant
///   - Each binding is `Atom(local_name)` (positional) or
///     `FnCall(Atom(':'), [Atom(field_name), Atom(local_name)], infix=true)` (labeled).
_extract_data_arm :: (
  fn(
    pat_expr : AstExpr,
    ref(variant_name_out) : String,
    bindings_out : ArrayList(DataBinding),
    ctx : CodegenContext
  ) -> String
)({
  // Case 1: wildcard `_`
  is_wild := match(
    pat_expr,
    .Atom(_, wtok) => (wtok.value == "_"),
    .FnCall(_, _, _, _, _) => false
  );
  cond(
    is_wild => String.new(),
    // Case 2: bare dot variant `.V`  or  data variant `.V(bindings...)`
    true => match(
      pat_expr,
      .Atom(_, _) => String.new(),
      .FnCall(_, pat_func, pat_args, pat_infix, _) => cond(
        pat_infix => String.new(),
        // Case 2a: `.V` — unit dot variant: FnCall(Atom('.'), [Atom('V')], infix=false)
        match(
          pat_func.*,
          .Atom(_, pfatom) => (pfatom.kind == TokenKind.Dot),
          .FnCall(_, _, _, _, _) => false
        ) => match(
          pat_args.get(usize(0)),
          .None => String.new(),
          .Some(variant_atom) => match(
            variant_atom,
            .FnCall(_, _, _, _, _) => String.new(),
            .Atom(_, vatom) => match(
              ctx.get_enum_for_variant(vatom.value.as_str()),
              .None => String.new(),
              .Some(enum_name) => {
                variant_name_out = vatom.value;
                result := String.new();
                result.push_string(enum_name);
                result.push_str("_");
                result.push_string(vatom.value);
                result
              }
            )
          )
        ),
        // Case 2b: `.V(bindings...)` — data variant:
        // FnCall(func=FnCall(Atom('.'), [Atom('V')], infix=false), args=[...], infix=false)
        match(
          pat_func.*,
          .Atom(_, _) => false,
          .FnCall(_, inner_func, inner_args, inner_infix, _) => cond(
            inner_infix => false,
            (inner_args.len() != usize(1)) => false,
            true => match(
              inner_func.*,
              .FnCall(_, _, _, _, _) => false,
              .Atom(_, ifatom) => (ifatom.kind == TokenKind.Dot)
            )
          )
        ) => match(
          pat_func.*,
          .Atom(_, _) => String.new(),
          .FnCall(_, _, inner_args2, _, _) => match(
            inner_args2.get(usize(0)),
            .None => String.new(),
            .Some(variant_atom2) => match(
              variant_atom2,
              .FnCall(_, _, _, _, _) => String.new(),
              .Atom(_, vatom2) => match(
                ctx.get_enum_for_variant(vatom2.value.as_str()),
                .None => String.new(),
                .Some(enum_name2) => {
                  variant_name_out = vatom2.value;
                  // Build tag constant (owned String — no dangling pointer risk)
                  tag := String.new();
                  tag.push_string(enum_name2);
                  tag.push_str("_");
                  tag.push_string(vatom2.value);
                  // Build bindings from pat_args
                  fields_csv_opt := ctx.get_variant_fields(enum_name2.as_str(), vatom2.value.as_str());
                  fields := match(
                    fields_csv_opt,
                    .None => ArrayList(String).new(),
                    .Some(fcsv) => _split_csv(fcsv.as_str())
                  );
                  nba := pat_args.len();
                  (bi : usize) = usize(0);
                  while(bi < nba, {
                    match(
                      pat_args.get(bi),
                      .None => (),
                      .Some(barg) => {
                        match(
                          barg,
                          // Positional binding: Atom(local_name)
                          .Atom(_, batom) => cond(
                            (batom.value == "_") => (),
                            // wildcard, skip
                            true => match(
                              fields.get(bi),
                              .None => (),
                              .Some(field_name) => {
                                path := String.from("data.");
                                path.push_string(vatom2.value);
                                path.push_str(".");
                                path.push_string(field_name);
                                db := DataBinding(
                                  var_name : batom.value,
                                  field_path : path,
                                  type_c : String.from("__auto_type")
                                );
                                _rr := bindings_out.push(db);
                                ();
                              }
                            )
                          ),
                          // Labeled binding: `field_name : local_name` (infix ':')
                          .FnCall(_, bfunc, bargs, binfix, _) => cond(
                            // Curly shorthand: `_(field1, field2, ...)` or `_(field: alias, ...)`
                            // Each inner arg is either:
                            //   Atom("name")       → bind field "name" as var "name"
                            //   FnCall(":", [field, alias]) → bind field as alias
                            //   FnCall(":", [field, _])    → wildcard, skip
                            (
                              (!(binfix)) && match(
                                bfunc.*,
                                .Atom(_, cftok) => (cftok.value == BK_ANON_STRUCT),
                                .FnCall(_, _, _, _, _) => false
                              )
                            ) => {
                              nc := bargs.len();
                              (ci : usize) = usize(0);
                              while(ci < nc, {
                                match(
                                  bargs.get(ci),
                                  .None => (),
                                  .Some(ci_arg) => match(
                                    ci_arg,
                                    // Bare atom: `width` → bind field "width" as var "width"
                                    .Atom(_, ci_atm) => cond(
                                      (ci_atm.value == "_") => (),
                                      true => {
                                        path_c := String.from("data.");
                                        path_c.push_string(vatom2.value);
                                        path_c.push_str(".");
                                        path_c.push_string(ci_atm.value);
                                        db_c := DataBinding(
                                          var_name : ci_atm.value,
                                          field_path : path_c,
                                          type_c : String.from("__auto_type")
                                        );
                                        _rc := bindings_out.push(db_c);
                                        ();
                                      }
                                    ),
                                    // Labeled: `field: alias` or `field: _`
                                    .FnCall(_, lb_func, lb_args, lb_infix, _) => cond(
                                      (!(lb_infix)) => (),
                                      (lb_args.len() < usize(2)) => (),
                                      (
                                        !(
                                          match(
                                            lb_func.*,
                                            .Atom(_, lbtok) => (lbtok.value == ":"),
                                            .FnCall(_, _, _, _, _) => false
                                          )
                                        )
                                      ) => (),
                                      true => match(
                                        lb_args.get(usize(0)),
                                        .None => (),
                                        .Some(f_e) => match(
                                          lb_args.get(usize(1)),
                                          .None => (),
                                          .Some(v_e) => match(
                                            f_e,
                                            .FnCall(_, _, _, _, _) => (),
                                            .Atom(_, f_tok) => match(
                                              v_e,
                                              .FnCall(_, _, _, _, _) => (),
                                              .Atom(_, v_tok) => cond(
                                                (v_tok.value == "_") => (),
                                                true => {
                                                  path_l := String.from("data.");
                                                  path_l.push_string(vatom2.value);
                                                  path_l.push_str(".");
                                                  path_l.push_string(f_tok.value);
                                                  db_l := DataBinding(
                                                    var_name : v_tok.value,
                                                    field_path : path_l,
                                                    type_c : String.from("__auto_type")
                                                  );
                                                  _rl := bindings_out.push(db_l);
                                                  ();
                                                }
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                );
                                ci = (ci + usize(1));
                              });
                            },
                            (!(binfix)) => (),
                            (bargs.len() < usize(2)) => (),
                            (
                              !(
                                match(
                                  bfunc.*,
                                  .Atom(_, bfatom) => (bfatom.value == ":"),
                                  .FnCall(_, _, _, _, _) => false
                                )
                              )
                            ) => (),
                            true => match(
                              bargs.get(usize(0)),
                              .None => (),
                              .Some(field_expr) => match(
                                bargs.get(usize(1)),
                                .None => (),
                                .Some(local_expr) => match(
                                  field_expr,
                                  .FnCall(_, _, _, _, _) => (),
                                  .Atom(_, fnatom) => match(
                                    local_expr,
                                    .FnCall(_, _, _, _, _) => (),
                                    .Atom(_, lnatom) => cond(
                                      (lnatom.value == "_") => (),
                                      // wildcard, skip
                                      true => {
                                        path2 := String.from("data.");
                                        path2.push_string(vatom2.value);
                                        path2.push_str(".");
                                        path2.push_string(fnatom.value);
                                        db2 := DataBinding(
                                          var_name : lnatom.value,
                                          field_path : path2,
                                          type_c : String.from("__auto_type")
                                        );
                                        _rr2 := bindings_out.push(db2);
                                        ();
                                      }
                                    )
                                  )
                                )
                              )
                            )
                          )
                        );
                      }
                    );
                    bi = (bi + usize(1));
                  });
                  tag
                }
              )
            )
          )
        ),
        true => String.new()
      )
    )
  )
});
emit_simplified_some_binding_name :: (
  fn(binding_name : str, scrut_code : String, ctx : CodegenContext, indent : String) -> unit
)(
  if(binding_name != "_", {
    ctx.emitter.emit_string(indent);
    ctx.emitter.emit("__auto_type ");
    ctx.emitter.emit_string(sanitize_c_ident(binding_name));
    ctx.emitter.emit(" = ");
    ctx.emitter.emit_string(scrut_code);
    ctx.emitter.emit_line(";");
  })
);
emit_simplified_some_binding_expr :: (
  fn(binding_expr : AstExpr, scrut_code : String, ctx : CodegenContext, indent : String) -> unit
)(
  match(
    binding_expr,
    .Atom(_, binding_tok) =>
      emit_simplified_some_binding_name(binding_tok.value.as_str(), scrut_code, ctx, indent),
    .FnCall(_, binding_func_box, binding_args, binding_infix, _) => cond(
      binding_infix => match(
        binding_func_box.*,
        .FnCall(_, _, _, _, _) => (),
        .Atom(_, binding_func_tok) => if(binding_func_tok.value == ":", {
          match(
            binding_args.get(usize(1)),
            .None => (),
            .Some(alias_expr) => match(
              alias_expr,
              .FnCall(_, _, _, _, _) => (),
              .Atom(_, alias_tok) =>
                emit_simplified_some_binding_name(alias_tok.value.as_str(), scrut_code, ctx, indent)
            )
          );
        })
      ),
      true => match(
        binding_func_box.*,
        .FnCall(_, _, _, _, _) => (),
        .Atom(_, binding_func_tok2) => if(binding_func_tok2.value == BK_ANON_STRUCT, {
          (i : usize) = usize(0);
          n := binding_args.len();
          while(i < n, {
            match(
              binding_args.get(i),
              .None => (),
              .Some(inner_binding_expr) => recur(inner_binding_expr, scrut_code, ctx, indent)
            );
            i = (i + usize(1));
          });
        })
      )
    )
  )
);
build_struct_field_index_expr :: (fn(var_name : String, fields_csv : String, idx_c : String) -> Option(String))({
  fields := _split_csv(fields_csv.as_str());
  n := fields.len();
  cond(
    (n == usize(0)) => Option(String).None,
    true => {
      result := String.from("(*(");
      (i : usize) = usize(0);
      while(i < n, {
        match(
          fields.get(i),
          .None => (),
          .Some(field_name) => {
            if(i < (n - usize(1)), {
              result.push_str("(");
              result.push_string(idx_c);
              result.push_str(" == (size_t)(");
              result.push_string(i.to_string());
              result.push_str(")) ? &");
            }, {
              result.push_str("&");
            });
            result.push_string(var_name);
            result.push_str(".");
            result.push_string(field_name);
            if(i < (n - usize(1)), {
              result.push_str(" : ");
            });
          }
        );
        i = (i + usize(1));
      });
      result.push_str("))");
      Option(String).Some(result)
    }
  )
});
// Phase A.8.5: `_get_arm_variant_name` was relocated to `./exprs/match.yo`.
emit_simplified_some_bindings :: (
  fn(pat_expr : AstExpr, scrut_code : String, ctx : CodegenContext, indent : String) -> unit
)(
  match(
    pat_expr,
    .Atom(_, _) => (),
    .FnCall(_, pat_func, pat_args, pat_infix, _) => cond(
      pat_infix => (),
      true => match(
        pat_func.*,
        .Atom(_, _) => (),
        .FnCall(_, _, _, _, _) => {
          n := pat_args.len();
          (i : usize) = usize(0);
          while(i < n, {
            match(
              pat_args.get(i),
              .None => (),
              .Some(binding_expr) => emit_simplified_some_binding_expr(binding_expr, scrut_code, ctx, indent)
            );
            i = (i + usize(1));
          });
        }
      )
    )
  )
);
/// Emit an `if (scrut != NULL) { .Some/Ok body } else { .None/Err body }` block
/// for an Option or Result match using the void-pointer bootstrap encoding.
///
/// Used when no enum is registered for `Some`/`Ok` (i.e. the value is encoded as
/// `void*`: non-NULL for Some/Ok, NULL for None/Err).
///
/// Arms are scanned from `args[1..n]`. The first `.Some`/`.Ok` arm is used for
/// the non-NULL branch (with bindings emitted via `emit_simplified_some_bindings`).
/// The first `.None`/`.Err` arm (or `_` wildcard) is used for the NULL branch.
emit_option_null_if_else :: (
  fn(
    scrut_c : String,
    n : usize,
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> unit
)({
  inner := String.from(indent.as_str());
  inner.push_str("  ");
  (i : usize) = usize(1);
  (some_pat_expr : Option(AstExpr)) = Option(AstExpr).None;
  (some_body_expr : Option(AstExpr)) = Option(AstExpr).None;
  (none_body_expr : Option(AstExpr)) = Option(AstExpr).None;
  (wild_body_expr : Option(AstExpr)) = Option(AstExpr).None;
  while(i < n, {
    match(
      args.get(i),
      .None => (),
      .Some(arm_expr) => match(
        get_arm_args(arm_expr),
        .None => (),
        .Some(arm_args) => match(
          arm_args.get(usize(0)),
          .None => (),
          .Some(pat_e) => match(
            arm_args.get(usize(1)),
            .None => (),
            .Some(body_e) => {
              is_wild := _is_atom_value(pat_e, "_");
              cond(
                is_wild => {
                  if(wild_body_expr.is_none(), {
                    wild_body_expr = Option(AstExpr).Some(body_e);
                  });
                },
                true => match(
                  _get_arm_variant_name(pat_e),
                  .None => (),
                  .Some(vn) => cond(
                    ((vn == "Some") || (vn == "Ok")) => {
                      if(some_body_expr.is_none(), {
                        some_body_expr = Option(AstExpr).Some(body_e);
                        some_pat_expr = Option(AstExpr).Some(pat_e);
                      });
                    },
                    ((vn == "None") || (vn == "Err")) => {
                      if(none_body_expr.is_none(), {
                        none_body_expr = Option(AstExpr).Some(body_e);
                      });
                    },
                    true => ()
                  )
                )
              );
            }
          )
        )
      )
    );
    i = (i + usize(1));
  });
  ctx.emitter.emit_string(indent);
  ctx.emitter.emit("if (");
  ctx.emitter.emit_string(scrut_c);
  ctx.emitter.emit(" != NULL) {\n");
  match(
    some_body_expr,
    .None => (),
    .Some(sb) => {
      match(
        some_pat_expr,
        .None => (),
        .Some(sp) => emit_simplified_some_bindings(sp, scrut_c, ctx, inner)
      );
      match(
        call_gen_expr(sb, ctx, inner),
        .None => (),
        .Some(bc) => emit_as_stmt(bc, ctx, inner)
      );
    }
  );
  ctx.emitter.emit_string(indent);
  ctx.emitter.emit("} else {\n");
  actual_none_body := match(
    none_body_expr,
    .Some(_) => none_body_expr,
    .None => wild_body_expr
  );
  match(
    actual_none_body,
    .None => (),
    .Some(nb) => match(
      call_gen_expr(nb, ctx, inner),
      .None => (),
      .Some(nc) => emit_as_stmt(nc, ctx, inner)
    )
  );
  ctx.emitter.emit_string(indent);
  ctx.emitter.emit("}\n");
});
/// True if `expr` is `match(scrut, ...)` where any arm pattern is `.Variant(bindings...)`.
/// Used to decide whether to use `generate_match_data` instead of ternary chains.
// Phase A.8.5: `_has_data_arm` was relocated to `./exprs/match.yo`.
/// Generate a `match(scrut, .Var(f) => body, ...)` expression using a C switch
/// on the tagged union's `.tag` field.
///
/// Used when any arm uses the `.Variant(bindings)` destructuring form.
/// Simple arms (`.Variant` or `_`) are also handled within the same switch.
///
/// Returns the temp variable name holding the result, or `None` on failure.
handle_match_data :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  cond(
    (n < usize(2)) => Option(String).None,
    true => match(
      args.get(usize(0)),
      .None => Option(String).None,
      .Some(scrut_expr) => match(
        call_gen_expr(scrut_expr, ctx, indent),
        .None => Option(String).None,
        .Some(scrut_code) => {
          // If scrutinee is a pointer variable, auto-deref for the switch.
          // We detect this by checking if the scrutinee variable has a registered
          // type ending in '*'.
          scrut_c := match(
            ctx.get_var_type(scrut_code.as_str()),
            .None => scrut_code,
            .Some(vtype) => {
              len := vtype.len();
              is_ptr := cond(
                (len == usize(0)) => false,
                true => match(
                  vtype.at(len - usize(1)),
                  .None => false,
                  .Some(r) => (r.char == u32(42)) // 42 = ASCII '*'
                )
              );
              cond(
                is_ptr => {
                  deref := String.from("(*");
                  deref.push_string(scrut_code);
                  deref.push_str(")");
                  deref
                },
                true => scrut_code
              )
            }
          );
          // The simplified-Some bootstrap path treats `Option(T).Some(x)` and
          // `Result(T,E).Ok(x)` as just their payload `x` (Phase 13d encoding).
          // It applies whenever the scrutinee uses the payload-as-value
          // representation rather than a tagged-union value.
          //
          // - Unregistered scrutinee expressions (e.g. `toks.get(i)`) default
          //   to the simplified path because they almost always carry an
          //   Option payload directly.
          // - `__auto_type` temps and registered C primitive/string types are
          //   also payload-as-value (Phase 13d/e lowering).
          // - Registered tagged-union scrutinees (e.g. variables of a real
          //   data enum like `Shape`) take the proper `generate_match_data`
          //   switch path.
          //
          // It is NOT correct when `Some` has been registered as a real
          // data-enum variant — in that case `generate_match_data` must drive
          // the dispatch through the tagged union.
          can_simplify_some_match := match(
            ctx.get_enum_for_variant("Some"),
            .Some(_) => false,
            .None => match(
              ctx.get_var_type(scrut_code.as_str()),
              .None => true,
              .Some(vt) => cond(
                (vt == "__auto_type") => true,
                (vt == "int8_t") => true,
                (vt == "int16_t") => true,
                (vt == "int32_t") => true,
                (vt == "int64_t") => true,
                (vt == "uint8_t") => true,
                (vt == "uint16_t") => true,
                (vt == "uint32_t") => true,
                (vt == "uint64_t") => true,
                (vt == "size_t") => true,
                (vt == "isize") => true,
                (vt == "double") => true,
                (vt == "float") => true,
                (vt == "bool") => true,
                (vt == "const char*") => true,
                true => false
              )
            )
          );
          simplified_some_body := {
            (si : usize) = usize(1);
            (found_some : Option(AstExpr)) = Option(AstExpr).None;
            while(can_simplify_some_match && ((si < n) && found_some.is_none()), {
              match(
                args.get(si),
                .None => (),
                .Some(arm_expr2) => match(
                  get_arm_args(arm_expr2),
                  .None => (),
                  .Some(arm_args2) => match(
                    arm_args2.get(usize(0)),
                    .None => (),
                    .Some(pat_expr2) => match(
                      data_arm_variant_name(pat_expr2),
                      .None => (),
                      .Some(vn) => cond(
                        (vn != "Some") => (),
                        true => match(
                          arm_args2.get(usize(1)),
                          .None => (),
                          .Some(body_expr2) => {
                            emit_simplified_some_bindings(pat_expr2, scrut_c, ctx, indent);
                            found_some = Option(AstExpr).Some(body_expr2);
                          }
                        )
                      )
                    )
                  )
                )
              );
              si = (si + usize(1));
            });
            found_some
          };
          match(
            simplified_some_body,
            .Some(body_expr3) => {
              body_code := call_gen_expr(body_expr3, ctx, indent);
              match(
                body_code,
                .None => Option(String).Some(String.from("0")),
                .Some(body_c) => Option(String).Some(body_c)
              )
            },
            .None => {
              // The void-pointer Option/Result encoding only applies when the
              // match arms reference Option/Result variants AND `Some` has not
              // been registered to a real data enum. If any arm names a variant
              // that is registered (e.g. `Shape.Rectangle`), we must take the
              // proper `generate_match_data` switch path instead. Otherwise we
              // would emit `if (s != NULL)` against a non-pointer enum value.
              (any_arm_registered : bool) = false;
              {
                (ci : usize) = usize(1);
                while((ci < n) && (!(any_arm_registered)), {
                  match(
                    args.get(ci),
                    .None => (),
                    .Some(arm_check) => match(
                      get_arm_args(arm_check),
                      .None => (),
                      .Some(arm_args_check) => match(
                        arm_args_check.get(usize(0)),
                        .None => (),
                        .Some(pat_check) => match(
                          data_arm_variant_name(pat_check),
                          .None => (),
                          .Some(vn_check) => match(
                            ctx.get_enum_for_variant(vn_check.as_str()),
                            .None => (),
                            .Some(_) => {
                              any_arm_registered = true;
                            }
                          )
                        )
                      )
                    )
                  );
                  ci = (ci + usize(1));
                });
              };
              is_void_ptr_opt := cond(
                any_arm_registered => false,
                true => match(
                  ctx.get_enum_for_variant("Some"),
                  .Some(_) => false,
                  .None => true
                )
              );
              cond(
                is_void_ptr_opt => {
                  emit_option_null_if_else(scrut_c, n, args, ctx, indent);
                  Option(String).Some(String.from("0"))
                },
                true => {
                  temp := ctx.fresh_temp();
                  data_arms := ArrayList(DataArm).new();
                  (i : usize) = usize(1);
                  while(i < n, {
                    match(
                      args.get(i),
                      .None => (),
                      .Some(arm_expr) => match(
                        get_arm_args(arm_expr),
                        .None => (),
                        .Some(arm_args) => match(
                          arm_args.get(usize(0)),
                          .None => (),
                          .Some(pat_expr) => {
                            variant_name_buf := String.new();
                            bindings := ArrayList(DataBinding).new();
                            tag_const_str := _extract_data_arm(pat_expr, variant_name_buf, bindings, ctx);
                            body_expr_opt := arm_args.get(usize(1));
                            match(
                              body_expr_opt,
                              .None => (),
                              .Some(body_expr) => {
                                arm := DataArm(
                                  tag_const : tag_const_str,
                                  bindings : bindings,
                                  body : body_expr
                                );
                                _r := data_arms.push(arm);
                                ();
                              }
                            );
                          }
                        )
                      )
                    );
                    i = (i + usize(1));
                  });
                  generate_match_data(
                    scrut_c.as_str(),
                    "int32_t",
                    temp.as_str(),
                    data_arms,
                    call_gen_expr,
                    ctx,
                    indent.as_str()
                  );
                  .Some(temp)
                }
              )
            }
          )
        }
      )
    )
  )
});
///
/// Emits a C `while` loop into `ctx.emitter` and returns `"0"` (void result).
/// Convert a `while` step expression to a C expression string.
///
/// For a `begin(e0, e1, …)` step (multi-step), produce a C comma expression
/// `(e0, e1, …)`.  Each element is converted WITHOUT letting `handle_begin`
/// emit them as side-effect statements — crucial because begin-block handling
/// normally emits intermediate statements directly to the emitter.
///
/// For any other step expression, just call `call_gen_expr` normally.
step_to_c_expr :: (
  fn(
    step_expr : AstExpr,
    ctx : CodegenContext,
    indent : String
  ) -> String
)({
  // This first statement ensures the body is a begin block, not a struct literal.
  is_begin_step := match(
    step_expr,
    .Atom(_, _) => false,
    .FnCall(_, sf, _, _, _) => match(
      sf.*,
      .FnCall(_, _, _, _, _) => false,
      .Atom(_, stok) => (stok.value == BK_BEGIN)
    )
  );
  cond(
    is_begin_step => match(
      step_expr,
      .Atom(_, _) => String.from("0"),
      .FnCall(_, _, sargs, _, _) => {
        // Build comma-joined C expression directly from begin block elements,
        // bypassing handle_begin to avoid premature side-effect emission.
        sn := sargs.len();
        cond(
          (sn == usize(0)) => String.from("0"),
          true => {
            result_s := String.new();
            (k : usize) = usize(0);
            (first : bool) = true;
            while(k < sn, {
              match(
                sargs.get(k),
                .None => (),
                .Some(se) => {
                  // Skip tuple() / _() unit sentinels
                  is_unit_sentinel := match(
                    se,
                    .Atom(_, _) => false,
                    .FnCall(_, sef, seargs, _, _) => match(
                      sef.*,
                      .FnCall(_, _, _, _, _) => false,
                      .Atom(_, setok) => (
                        ((setok.value == BK_TUPLE) || (setok.value == BK_ANON_STRUCT)) && (seargs.len() == usize(0))
                      )
                    )
                  );
                  if(!(is_unit_sentinel), {
                    match(
                      call_gen_expr(se, ctx, indent),
                      .None => (),
                      .Some(se_code) => {
                        if(!(first), {
                          result_s.push_str(", ");
                        });
                        result_s.push_string(se_code);
                        first = false;
                      }
                    );
                  });
                }
              );
              k = (k + usize(1));
            });
            cond(
              (result_s.len() == usize(0)) => String.from("0"),
              true => result_s
            )
          }
        )
      }
    ),
    true => match(
      call_gen_expr(step_expr, ctx, indent),
      .None => String.from("0"),
      .Some(s) => s
    )
  )
});
/// Handle `for iter_expr, (param) => { body }` — iterator for-loop macro.
///
/// In the Yo language, `for` is a macro that expands to:
///   iter_var := iter_expr;
///   while runtime(true), {
///     temp := &iter_var.next();
///     match(temp, .Some(param) => body, .None => { break; })
///   }
///
/// In the prototype codegen:
/// - If `iter_expr` is `(&arr_var).iter()` where `arr_var` is a registered C array,
///   emit a direct C `for` loop: `for (size_t _i = 0; _i < N; _i++) { T* param = &arr[_i]; body }`.
/// - Otherwise, fall through to emitting a `while(1)` loop calling `.next()`.
handle_for :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  (nargs : usize) = args.len();
  cond(
    (nargs != usize(2)) => Option(String).None,
    true => match(
      args.get(usize(0)),
      .None => Option(String).None,
      .Some(iter_expr) => match(
        args.get(usize(1)),
        .None => Option(String).None,
        .Some(handle_expr) => {
          // Destructure handle: should be `(param) => { body }` — infix `=>` with 2 args
          handle_opt := match(
            handle_expr,
            .Atom(_, _) => Option(String).None,
            .FnCall(_, hfn, hargs, hinfix, _) => cond(
              (!(hinfix)) => Option(String).None,
              (hargs.len() != usize(2)) => Option(String).None,
              true => match(
                hfn.*,
                .FnCall(_, _, _, _, _) => Option(String).None,
                .Atom(_, htok) => cond(
                  (htok.value != "=>") => Option(String).None,
                  true => Option(String).Some(String.from("ok"))
                )
              )
            )
          );
          match(
            handle_opt,
            .None => Option(String).None,
            .Some(_) => match(
              handle_expr,
              .Atom(_, _) => Option(String).None,
              .FnCall(_, _, hargs2, _, _) => {
                param_expr_opt := hargs2.get(usize(0));
                body_expr_opt := hargs2.get(usize(1));
                // Extract param name
                param_name_opt := match(
                  param_expr_opt,
                  .None => Option(String).None,
                  .Some(pe) => match(
                    pe,
                    .FnCall(_, _, _, _, _) => Option(String).None,
                    .Atom(_, ptok) => cond(
                      (ptok.kind != TokenKind.Identifier) => Option(String).None,
                      true => Option(String).Some(ptok.value)
                    )
                  )
                );
                // Try to detect `(&arr_var).iter()` pattern for array iteration
                // `(&arr_var)` = FnCall(Atom("*"?), no wait — `&arr_var` = FnCall(Atom("&"), [arr_var])
                // `(&arr_var).iter()` = method call on `(&arr_var)` with method `iter`
                // After parsing: FnCall(FnCall(Atom("."), [&arr_var, "iter"]), [], ...)
                // Detect: iter_expr is a method call `.iter()` with no args on `(&arr_var)`
                arr_iter_name_opt := match(
                  iter_expr,
                  .Atom(_, _) => Option(String).None,
                  .FnCall(_, iter_fn, iter_args, _, _) => cond(
                    (iter_args.len() != usize(0)) => Option(String).None,
                    true => match(
                      iter_fn.*,
                      .Atom(_, _) => Option(String).None,
                      .FnCall(_, dot_fn, dot_args, dot_infix, _) => cond(
                        (!(dot_infix)) => Option(String).None,
                        (dot_args.len() != usize(2)) => Option(String).None,
                        true => match(
                          dot_fn.*,
                          .FnCall(_, _, _, _, _) => Option(String).None,
                          .Atom(_, dtok) => cond(
                            (dtok.value != ".") => Option(String).None,
                            true => match(
                              dot_args.get(usize(1)),
                              .None => Option(String).None,
                              .Some(method_e) => match(
                                method_e,
                                .FnCall(_, _, _, _, _) => Option(String).None,
                                .Atom(_, mtok) => cond(
                                  (mtok.value != "iter") => Option(String).None,
                                  true =>
                                    // Receiver is dot_args[0]: should be `&arr_var`
                                    match(
                                      dot_args.get(usize(0)),
                                      .None => Option(String).None,
                                      .Some(recv_e) => match(
                                        recv_e,
                                        .Atom(_, _) => Option(String).None,
                                        .FnCall(_, ref_fn, ref_args, ref_infix, _) => cond(
                                          ref_infix => Option(String).None,
                                          (ref_args.len() != usize(1)) => Option(String).None,
                                          true => match(
                                            ref_fn.*,
                                            .FnCall(_, _, _, _, _) => Option(String).None,
                                            .Atom(_, rftok) => cond(
                                              (rftok.value != "&") => Option(String).None,
                                              true => match(
                                                ref_args.get(usize(0)),
                                                .None => Option(String).None,
                                                .Some(arr_name_e) => match(
                                                  arr_name_e,
                                                  .FnCall(_, _, _, _, _) => Option(String).None,
                                                  .Atom(_, antok) => cond(
                                                    (!(ctx.is_array_var(antok.value.as_str()) || ctx.is_slice_var(antok.value.as_str()))) => Option(String).None,
                                                    true => Option(String).Some(antok.value)
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                );
                inner := {
                  r := String.from(indent.as_str());
                  r.push_str("  ");
                  r
                };
                cond(
                  // Fast path: emit C for loop over array or slice
                  match(arr_iter_name_opt,.Some(_) => true,.None => false) =>
                    match(
                      arr_iter_name_opt,
                      .None => Option(String).None,
                      .Some(arr_name) => match(
                        param_name_opt,
                        .None => Option(String).None,
                        .Some(param_name) => match(
                          body_expr_opt,
                          .None => Option(String).None,
                          .Some(body_expr) => {
                            san_arr := sanitize_c_ident(arr_name.as_str());
                            san_param := sanitize_c_ident(param_name.as_str());
                            iter_var := ctx.fresh_temp();
                            ctx.emitter.emit_string(indent);
                            ctx.emitter.emit("for (size_t ");
                            ctx.emitter.emit_string(iter_var);
                            ctx.emitter.emit(" = 0; ");
                            ctx.emitter.emit_string(iter_var);
                            ctx.emitter.emit(" < ");
                            cond(
                              ctx.is_slice_var(arr_name.as_str()) => {
                                // slice: use slice.length
                                ctx.emitter.emit_string(san_arr);
                                ctx.emitter.emit(".length");
                              },
                              true => {
                                // array: use known size constant
                                size_str := match(
                                  ctx.get_array_var_size(arr_name.as_str()),
                                  .None => String.from("0"),
                                  .Some(sz) => sz
                                );
                                ctx.emitter.emit_string(size_str);
                              }
                            );
                            ctx.emitter.emit("; ");
                            ctx.emitter.emit_string(iter_var);
                            ctx.emitter.emit_line("++) {");
                            ctx.emitter.emit_string(inner);
                            ctx.emitter.emit("__auto_type* ");
                            ctx.emitter.emit_string(san_param);
                            ctx.emitter.emit(" = &");
                            ctx.emitter.emit_string(san_arr);
                            cond(
                              ctx.is_slice_var(arr_name.as_str()) => {
                                ctx.emitter.emit(".data[");
                              },
                              true => {
                                ctx.emitter.emit("[");
                              }
                            );
                            ctx.emitter.emit_string(iter_var);
                            ctx.emitter.emit_line("];");
                            match(
                              call_gen_expr(body_expr, ctx, inner),
                              .None => (),
                              .Some(body_code) => emit_as_stmt(body_code, ctx, inner)
                            );
                            ctx.emitter.emit_string(indent);
                            ctx.emitter.emit_line("}");
                            Option(String).Some(String.from("0"))
                          }
                        )
                      )
                    ),
                  // Fallback: emit while(1) { var = iter.next(); if None break; body }
                  true => match(
                    param_name_opt,
                    .None => Option(String).None,
                    .Some(param_name) => match(
                      body_expr_opt,
                      .None => Option(String).None,
                      .Some(body_expr) => match(
                        call_gen_expr(iter_expr, ctx, indent),
                        .None => Option(String).None,
                        .Some(iter_code) => {
                          san_param := sanitize_c_ident(param_name.as_str());
                          iter_var := ctx.fresh_temp();
                          next_var := ctx.fresh_temp();
                          // iter_var = iter;
                          ctx.emitter.emit_string(indent);
                          ctx.emitter.emit("__auto_type ");
                          ctx.emitter.emit_string(iter_var);
                          ctx.emitter.emit(" = ");
                          ctx.emitter.emit_string(iter_code);
                          ctx.emitter.emit_line(";");
                          // while (1) { ... }
                          ctx.emitter.emit_string(indent);
                          ctx.emitter.emit_line("while (1) {");
                          // next_var = iter_var.next()
                          ctx.emitter.emit_string(inner);
                          ctx.emitter.emit("__auto_type ");
                          ctx.emitter.emit_string(next_var);
                          ctx.emitter.emit(" = ");
                          ctx.emitter.emit_string(iter_var);
                          ctx.emitter.emit_line(".next();");
                          // if (next_var.is_none) break;
                          ctx.emitter.emit_string(inner);
                          ctx.emitter.emit("if (!");
                          ctx.emitter.emit_string(next_var);
                          ctx.emitter.emit_line(") break;");
                          // param = *next_var  (unwrap Some)
                          ctx.emitter.emit_string(inner);
                          ctx.emitter.emit("__auto_type ");
                          ctx.emitter.emit_string(san_param);
                          ctx.emitter.emit(" = ");
                          ctx.emitter.emit_string(next_var);
                          ctx.emitter.emit_line(";");
                          // body
                          match(
                            call_gen_expr(body_expr, ctx, inner),
                            .None => (),
                            .Some(body_code) => emit_as_stmt(body_code, ctx, inner)
                          );
                          ctx.emitter.emit_string(indent);
                          ctx.emitter.emit_line("}");
                          Option(String).Some(String.from("0"))
                        }
                      )
                    )
                  )
                )
              }
            )
          )
        }
      )
    )
  )
});
handle_while :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  cond_arg_opt := args.get(usize(0));
  // 3-arg form: while(cond, step, body)   →  for(;cond;step){body}
  // 2-arg form: while(cond, body)         →  while(cond){body}
  has_step := (n >= usize(3));
  step_opt := cond(has_step => args.get(usize(1)), true => Option(AstExpr).None);
  body_arg_opt := cond(has_step => args.get(usize(2)), true => args.get(usize(1)));
  match(
    cond_arg_opt,
    .None => Option(String).None,
    .Some(raw_cond) => {
      // Unwrap `runtime(inner)` or `comptime(inner)` wrapper if present
      cond_expr := match(
        raw_cond,
        .FnCall(_, rt_func, rt_args, _, _) => match(
          rt_func.*,
          .Atom(_, rttok) => cond(
            ((rttok.value == "runtime") || (rttok.value == "comptime")) => match(
              rt_args.get(usize(0)),
              .Some(inner) => inner,
              .None => raw_cond
            ),
            true => raw_cond
          ),
          .FnCall(_, _, _, _, _) => raw_cond
        ),
        .Atom(_, _) => raw_cond
      );
      match(
        call_gen_expr(cond_expr, ctx, indent),
        .None => Option(String).None,
        .Some(c_cond) => {
          inner := {
            r := String.from(indent.as_str());
            r.push_str("  ");
            r
          };
          cond(
            has_step => {
              // 3-arg: emit `for (;cond;step) { body }` so `continue` executes step
              // Use step_to_c_expr to avoid premature side-effect emission from begin blocks
              step_code := match(
                step_opt,
                .None => String.from("0"),
                .Some(step_expr) => step_to_c_expr(step_expr, ctx, indent)
              );
              ctx.emitter.emit_string(indent);
              ctx.emitter.emit("for (;");
              ctx.emitter.emit_string(c_cond);
              ctx.emitter.emit(";");
              ctx.emitter.emit_string(step_code);
              ctx.emitter.emit_line(") {");
              match(
                body_arg_opt,
                .None => (),
                .Some(body_expr) =>
                  match(
                    call_gen_expr(body_expr, ctx, inner),
                    .None => (),
                    .Some(body_code) => emit_as_stmt(body_code, ctx, inner)
                  )
              );
              ctx.emitter.emit_string(indent);
              ctx.emitter.emit_line("}");
            },
            true => {
              // 2-arg: emit `while (cond) { body }`
              ctx.emitter.emit_string(indent);
              ctx.emitter.emit("while (");
              ctx.emitter.emit_string(c_cond);
              ctx.emitter.emit_line(") {");
              match(
                body_arg_opt,
                .None => (),
                .Some(body_expr) =>
                  match(
                    call_gen_expr(body_expr, ctx, inner),
                    .None => (),
                    .Some(body_code) => emit_as_stmt(body_code, ctx, inner)
                  )
              );
              ctx.emitter.emit_string(indent);
              ctx.emitter.emit_line("}");
            }
          );
          .Some(String.from("0"))
        }
      )
    }
  )
});
/// Generate `if(cond, then)` or `if(cond, then, else)`.
///
/// When the then- or else-branch is a begin block, a C `if`/`else` statement
/// is emitted into `ctx.emitter` and `"0"` is returned as the expression
/// value.  This is necessary because control-flow keywords like `break`,
/// `continue`, and `return` cannot appear inside a C ternary operand.
///
/// When both branches are simple expressions (no begin block), a C ternary
/// `(cond ? then : else)` is returned instead.
handle_if :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  cond_opt := args.get(usize(0));
  then_opt := args.get(usize(1));
  else_opt := cond(
    (n >= usize(3)) => args.get(usize(2)),
    true => Option(AstExpr).None
  );
  match(
    cond_opt,
    .None => Option(String).None,
    .Some(cond_expr) => match(
      then_opt,
      .None => Option(String).None,
      .Some(then_expr) => {
        then_is_begin := is_begin_block(then_expr);
        else_is_begin := match(
          else_opt,
          .None => false,
          .Some(e) => is_begin_block(e)
        );
        cond(
          // One or both branches is a block: emit a C if/else statement so
          // that break/continue/return fire only when the condition is true.
          (then_is_begin || else_is_begin) => {
            c_opt := call_gen_expr(cond_expr, ctx, indent);
            match(
              c_opt,
              .None => Option(String).None,
              .Some(c) => {
                inner := {
                  r := String.from(indent.as_str());
                  r.push_str("  ");
                  r
                };
                ctx.emitter.emit_string(indent);
                ctx.emitter.emit("if (");
                ctx.emitter.emit_string(c);
                ctx.emitter.emit_line(") {");
                match(
                  call_gen_expr(then_expr, ctx, inner),
                  .None => (),
                  .Some(body_code) => emit_as_stmt(body_code, ctx, inner)
                );
                ctx.emitter.emit_string(indent);
                ctx.emitter.emit("}");
                match(
                  else_opt,
                  .None => ctx.emitter.emit_line(""),
                  .Some(else_expr) => {
                    ctx.emitter.emit_line(" else {");
                    match(
                      call_gen_expr(else_expr, ctx, inner),
                      .None => (),
                      .Some(else_code) => emit_as_stmt(else_code, ctx, inner)
                    );
                    ctx.emitter.emit_string(indent);
                    ctx.emitter.emit_line("}");
                  }
                );
                .Some(String.from("0"))
              }
            )
          },
          // Both branches are simple expressions: emit a C ternary.
          true => {
            c_opt := call_gen_expr(cond_expr, ctx, indent);
            t_opt := call_gen_expr(then_expr, ctx, indent);
            else_code := match(
              else_opt,
              .None => String.from("0"),
              .Some(e_ex) => match(
                call_gen_expr(e_ex, ctx, indent),
                .None => String.from("0"),
                .Some(s) => s
              )
            );
            match(
              c_opt,
              .None => Option(String).None,
              .Some(c) => match(
                t_opt,
                .None => Option(String).None,
                .Some(t) => {
                  result := String.from("(");
                  result.push_string(c);
                  result.push_str(" ? ");
                  result.push_string(t);
                  result.push_str(" : ");
                  result.push_string(else_code);
                  result.push_str(")");
                  .Some(result)
                }
              )
            )
          }
        )
      }
    )
  )
});
/// Get the string value from a FnCall's func if it is an Identifier atom.
fncall_func_ident :: (fn(func_box : Box(AstExpr)) -> Option(String))(
  match(
    func_box.*,
    .Atom(_, ftok) => cond(
      (ftok.kind == TokenKind.Identifier) =>.Some(ftok.value),
      true => Option(String).None
    ),
    .FnCall(_, _, _, _, _) => Option(String).None
  )
);
is_plain_identifier_call_expr :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, inner_func, _, inner_infix, _) => (
      (!(inner_infix)) &&
        match(
          inner_func.*,
          .Atom(_, inner_tok) => (inner_tok.kind == TokenKind.Identifier),
          .FnCall(_, _, _, _, _) => false
        )
    )
  )
);
// ---------------------------------------------------------------------------
// Phase 4d helpers — type mapping, function calls, dot access, assignment
// ---------------------------------------------------------------------------
/// Map a simple Yo type name to its C equivalent.
///
/// Only handles primitive types.  User-defined names pass through unchanged.
/// Generic types (e.g. `Option(i32)`) require Phase 4e type codegen.
type_name_to_c :: (fn(name : str) -> String)(
  cond(
    (name == "i8") => String.from("int8_t"),
    (name == "i16") => String.from("int16_t"),
    (name == "i32") => String.from("int32_t"),
    (name == "i64") => String.from("int64_t"),
    (name == "u8") => String.from("uint8_t"),
    (name == "u16") => String.from("uint16_t"),
    (name == "u32") => String.from("uint32_t"),
    (name == "u64") => String.from("uint64_t"),
    (name == "usize") => String.from("size_t"),
    (name == "isize") => String.from("intptr_t"),
    (name == "f32") => String.from("float"),
    (name == "f64") => String.from("double"),
    (name == "bool") => String.from("bool"),
    (name == "str") => String.from("const char*"),
    (name == "String") => String.from("const char*"),
    (name == "unit") => String.from("void"),
    (name == "rune") => String.from("uint32_t"),
    true => String.from(name)
  )
);
two_arg_type_app_name_to_c :: (fn(container_name : str, args : ArrayList(AstExpr)) -> Option(String))(
  cond(
    (args.len() != usize(2)) => Option(String).Some(String.from("void*")),
    true => match(
      args.get(usize(0)),
      .None => Option(String).Some(String.from("void*")),
      .Some(key_expr) => match(
        key_expr,
        .FnCall(_, _, _, _, _) => Option(String).Some(String.from("void*")),
        .Atom(_, key_tok) => cond(
          (key_tok.kind != TokenKind.Identifier) => Option(String).Some(String.from("void*")),
          true => match(
            args.get(usize(1)),
            .None => Option(String).Some(String.from("void*")),
            .Some(value_expr) => match(
              value_expr,
              .FnCall(_, _, _, _, _) => Option(String).Some(String.from("void*")),
              .Atom(_, value_tok) => cond(
                (value_tok.kind != TokenKind.Identifier) => Option(String).Some(String.from("void*")),
                true => {
                  result := sanitize_c_ident(container_name);
                  result.push_str("_");
                  result.push_string(sanitize_c_ident(key_tok.value.as_str()));
                  result.push_str("_");
                  result.push_string(sanitize_c_ident(value_tok.value.as_str()));
                  Option(String).Some(result)
                }
              )
            )
          )
        )
      )
    )
  )
);
/// Convert a type-annotation AST node to a C type string.
///
/// Handles:
///  - Simple atomic type names (`i32` → `int32_t`, `str` → `const char*`, etc.)
///  - Pointer types (`*(T)` → `T*`, where T is a simple atomic type)
///
/// Other complex types (generic applications, slices) return `None`.
/// True if `name` is a Yo type that has a direct C equivalent.
///
/// Meta-types like `Type`, `Expr`, `comptime_int`, etc. have no C equivalent
/// and cannot be used as C variable or parameter types.
is_c_type_name :: (fn(name : str) -> bool)(
  cond(
    (name == "i8") => true,
    (name == "i16") => true,
    (name == "i32") => true,
    (name == "i64") => true,
    (name == "u8") => true,
    (name == "u16") => true,
    (name == "u32") => true,
    (name == "u64") => true,
    (name == "usize") => true,
    (name == "isize") => true,
    (name == "f32") => true,
    (name == "f64") => true,
    (name == "bool") => true,
    (name == "str") => true,
    (name == "unit") => true,
    (name == "rune") => true,
    true => false
  )
);
impl_fn_i32_i32_c_type_from_expr :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, impl_box, impl_args, impl_infix, _) => cond(
      impl_infix => Option(String).None,
      (impl_args.len() != usize(1)) => Option(String).None,
      true => match(
        impl_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, impl_tok) => cond(
          !((impl_tok.value == "Impl") || (impl_tok.value == "Dyn")) =>
            Option(String).None,
          true => match(
            impl_args.get(usize(0)),
            .None => Option(String).None,
            .Some(fn_type_expr) => match(
              fn_type_expr,
              .Atom(_, _) => Option(String).None,
              .FnCall(_, arrow_box, arrow_args, arrow_infix, _) => cond(
                (!(arrow_infix && (arrow_args.len() == usize(2)))) => Option(String).None,
                true => match(
                  arrow_box.*,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, arrow_tok) => cond(
                    (arrow_tok.value != "->") => Option(String).None,
                    true => match(
                      arrow_args.get(usize(1)),
                      .None => Option(String).None,
                      .Some(ret_expr) => match(
                        ret_expr,
                        .FnCall(_, _, _, _, _) => Option(String).None,
                        .Atom(_, ret_tok) => cond(
                          (ret_tok.value != "i32") => Option(String).None,
                          true => match(
                            arrow_args.get(usize(0)),
                            .None => Option(String).None,
                            .Some(fn_head_expr) => match(
                              fn_head_expr,
                              .Atom(_, _) => Option(String).None,
                              .FnCall(_, fn_head_box, fn_head_args, fn_head_infix, _) => cond(
                                fn_head_infix => Option(String).None,
                                (fn_head_args.len() != usize(1)) => Option(String).None,
                                true => match(
                                  fn_head_box.*,
                                  .FnCall(_, _, _, _, _) => Option(String).None,
                                  .Atom(_, fn_tok) => cond(
                                    !((fn_tok.value == "Fn") || (fn_tok.value == "fn")) =>
                                      Option(String).None,
                                    true => match(
                                      fn_head_args.get(usize(0)),
                                      .None => Option(String).None,
                                      .Some(param_expr) => match(
                                        param_expr,
                                        .Atom(_, _) => Option(String).None,
                                        .FnCall(_, colon_box, colon_args, colon_infix, _) => cond(
                                          (!(colon_infix && (colon_args.len() == usize(2)))) =>
                                            Option(String).None,
                                          true => match(
                                            colon_box.*,
                                            .FnCall(_, _, _, _, _) => Option(String).None,
                                            .Atom(_, colon_tok) => cond(
                                              (colon_tok.value != ":") => Option(String).None,
                                              true => match(
                                                colon_args.get(usize(1)),
                                                .None => Option(String).None,
                                                .Some(param_ty_expr) => match(
                                                  param_ty_expr,
                                                  .FnCall(_, _, _, _, _) => Option(String).None,
                                                  .Atom(_, param_ty_tok) => cond(
                                                    (param_ty_tok.value == "i32") =>
                                                      Option(String).Some(String.from("__yo_impl_fn_i32_i32")),
                                                    true => Option(String).None
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
);
type_expr_to_c :: (fn(ty_expr : AstExpr) -> Option(String))(
  match(
    ty_expr,
    .Atom(_, ttok) => cond(
      (ttok.kind != TokenKind.Identifier) => Option(String).None,
      // Yo meta-types have no C equivalent — return None so callers fall back to void*.
      // (Type, Expr, Trait, DeriveContext, Module, comptime_int, comptime_float, comptime_string, ComptimeList)
      (ttok.value == "Type") => Option(String).None,
      (ttok.value == "Expr") => Option(String).None,
      (ttok.value == "Trait") => Option(String).None,
      (ttok.value == "DeriveContext") => Option(String).None,
      (ttok.value == "Module") => Option(String).None,
      (ttok.value == "comptime_int") => Option(String).None,
      (ttok.value == "comptime_float") => Option(String).None,
      (ttok.value == "comptime_string") => Option(String).None,
      true =>.Some(type_name_to_c(ttok.value.as_str()))
    ),
    .FnCall(_, func_box, func_args, is_infix, _) => cond(
      // fn(params) -> RetType — infix `->` with exactly 2 args → C function pointer type.
      // Encoded as "RET(*_FP_)(P1, P2, ...)" so build_typed_decl can insert the name.
      (is_infix && (func_args.len() == usize(2))) => match(
        func_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, ftok) => cond(
          (ftok.value != "->") => Option(String).None,
          true => {
            ret_c := match(
              func_args.get(usize(1)),
              .None => String.from("void"),
              .Some(re) => match(
                recur(re),
                .Some(s) => s,
                .None => String.from("void")
              )
            );
            fn_expr_opt := func_args.get(usize(0));
            params_c := match(
              fn_expr_opt,
              .None => String.from(""),
              .Some(fn_expr) => match(
                fn_expr,
                .Atom(_, _) => String.from(""),
                .FnCall(_, fn_f, fn_args, fn_infix, _) => cond(
                  fn_infix => String.from(""),
                  true => match(
                    fn_f.*,
                    .FnCall(_, _, _, _, _) => String.from(""),
                    .Atom(_, fn_ftok) => cond(
                      (fn_ftok.value != "fn") => String.from(""),
                      true => {
                        sb := String.new();
                        n_fn := fn_args.len();
                        (pi : usize) = usize(0);
                        while(pi < n_fn, {
                          match(
                            fn_args.get(pi),
                            .None => (),
                            .Some(parg) => {
                              p_ty_opt := match(
                                parg,
                                .Atom(_, _) => Option(AstExpr).None,
                                .FnCall(_, pf, pas, pinfix, _) => cond(
                                  (!(pinfix && (pas.len() == usize(2)))) => Option(AstExpr).None,
                                  true => match(
                                    pf.*,
                                    .FnCall(_, _, _, _, _) => Option(AstExpr).None,
                                    .Atom(_, ptok) => cond(
                                      (ptok.value != ":") => Option(AstExpr).None,
                                      true => pas.get(usize(1))
                                    )
                                  )
                                )
                              );
                              p_c := match(
                                p_ty_opt,
                                .None => String.from("void*"),
                                .Some(pt) => match(
                                  recur(pt),
                                  .Some(s) => s,
                                  .None => String.from("void*")
                                )
                              );
                              if(sb.len() > usize(0), {
                                sb.push_str(", ");
                              });
                              sb.push_string(p_c);
                            }
                          );
                          pi = (pi + usize(1));
                        });
                        sb
                      }
                    )
                  )
                )
              )
            );
            result := String.new();
            result.push_string(ret_c);
            result.push_str("(*_FP_)(");
            result.push_string(params_c);
            result.push_str(")");
            Option(String).Some(result)
          }
        )
      ),
      (is_infix) => Option(String).None,
      (
        (func_args.len() != usize(1)) &&
          match(
            func_box.*,
            .FnCall(_, _, _, _, _) => true,
            .Atom(_, arity_tok) =>
              (
                ((arity_tok.value != "Tuple") && (arity_tok.value != "Array")) &&
                  ((arity_tok.value != "HashMap") && (arity_tok.value != "BTreeMap"))
              )
          )
      ) => Option(String).None,
      true => match(
        func_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, ftok) => cond(
          // comptime(T) — unwrap to T only if T is not a pure Yo meta-type.
          // Meta-types like `Type`, `Expr`, comptime_int, comptime_float, comptime_string
          // have no C equivalent → return None.  All other identifiers (primitives,
          // user-defined structs/enums) are passed through as-is.
          (ftok.value == "comptime") => match(
            func_args.get(usize(0)),
            .None => Option(String).None,
            .Some(inner) => match(
              inner,
              .FnCall(_, _, _, _, _) => recur(inner),
              .Atom(_, itok) => cond(
                (itok.kind != TokenKind.Identifier) => Option(String).None,
                (itok.value == "Type") => Option(String).None,
                (itok.value == "Expr") => Option(String).None,
                (itok.value == "Trait") => Option(String).None,
                (itok.value == "DeriveContext") => Option(String).None,
                (itok.value == "Module") => Option(String).None,
                (itok.value == "comptime_int") => Option(String).None,
                (itok.value == "comptime_float") => Option(String).None,
                (itok.value == "comptime_string") => Option(String).None,
                (itok.value == "ComptimeList") => Option(String).None,
                (itok.value == "comptime_bool") => Option(String).None,
                true => recur(inner)
              )
            )
          ),
          // Tuple(T1, T2, ...) or Tuple(name : T, ...) — lower to an inline C
          // struct type with numeric fields, plus named aliases for labeled fields.
          (ftok.value == "Array") => match(
            func_args.get(usize(0)),
            .None => Option(String).None,
            .Some(array_elem_e) => match(
              array_elem_e,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, array_elem_tok) => cond(
                (array_elem_tok.value == "i32") => Option(String).Some(String.from("YoArray_i32")),
                true => Option(String).None
              )
            )
          ),
          (ftok.value == "Slice") => match(
            func_args.get(usize(0)),
            .None => Option(String).None,
            .Some(slice_elem_e) => match(
              slice_elem_e,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, slice_elem_tok) => cond(
                (slice_elem_tok.value == "u8") => Option(String).Some(String.from("YoSlice_u8")),
                true => Option(String).None
              )
            )
          ),
          (ftok.value == "HashMap") => two_arg_type_app_name_to_c("HashMap", func_args),
          (ftok.value == "BTreeMap") => two_arg_type_app_name_to_c("BTreeMap", func_args),
          (ftok.value == "Tuple") => {
            n_tuple := func_args.len();
            cond(
              (n_tuple == usize(0)) => Option(String).None,
              true => {
                tuple_ty := String.from("struct { ");
                (ti : usize) = usize(0);
                (tuple_ok : bool) = true;
                while((ti < n_tuple) && tuple_ok, {
                  match(
                    func_args.get(ti),
                    .None => {
                      tuple_ok = false;
                    },
                    .Some(tuple_arg) => {
                      named_field_opt := match(
                        tuple_arg,
                        .Atom(_, _) => Option(String).None,
                        .FnCall(_, tf_box, tf_args, tf_infix, _) => cond(
                          (!(tf_infix && (tf_args.len() == usize(2)))) => Option(String).None,
                          true => match(
                            tf_box.*,
                            .FnCall(_, _, _, _, _) => Option(String).None,
                            .Atom(_, tf_tok) => cond(
                              (tf_tok.value != ":") => Option(String).None,
                              true => match(
                                tf_args.get(usize(0)),
                                .None => Option(String).None,
                                .Some(tf_name_e) => match(
                                  tf_name_e,
                                  .FnCall(_, _, _, _, _) => Option(String).None,
                                  .Atom(_, tf_name_tok) => Option(String).Some(tf_name_tok.value)
                                )
                              )
                            )
                          )
                        )
                      );
                      ty_expr_opt := match(
                        named_field_opt,
                        .None => Option(AstExpr).Some(tuple_arg),
                        .Some(_) => match(
                          tuple_arg,
                          .Atom(_, _) => Option(AstExpr).None,
                          .FnCall(_, _, tf_args2, _, _) => tf_args2.get(usize(1))
                        )
                      );
                      match(
                        ty_expr_opt,
                        .None => {
                          tuple_ok = false;
                        },
                        .Some(ty_expr_inner) => match(
                          recur(ty_expr_inner),
                          .None => {
                            tuple_ok = false;
                          },
                          .Some(field_c_ty) => {
                            tuple_ty.push_string(field_c_ty);
                            tuple_ty.push_str(" _");
                            tuple_ty.push_string(ti.to_string());
                            tuple_ty.push_str("; ");
                            match(
                              named_field_opt,
                              .None => (),
                              .Some(named_field) => {
                                tuple_ty.push_string(field_c_ty);
                                tuple_ty.push_str(" ");
                                tuple_ty.push_string(sanitize_c_ident(named_field.as_str()));
                                tuple_ty.push_str("; ");
                              }
                            );
                          }
                        )
                      );
                    }
                  );
                  ti = (ti + usize(1));
                });
                cond(
                  (!(tuple_ok)) => Option(String).None,
                  true => {
                    tuple_ty.push_str("}");
                    Option(String).Some(tuple_ty)
                  }
                )
              }
            )
          },
          // *(T) — pointer type: non-infix call to "*" with one arg (T must be an atom)
          (!(ftok.value == "*")) => cond(
            // Bootstrap specialization: ArrayList(T) has a concrete value layout
            // when T is an identifier. The typedef is emitted lazily by
            // ensure_arraylist_c_type before the C type is used in signatures or
            // constructors.
            (ftok.value == "ArrayList") => match(
              func_args.get(usize(0)),
              .None => Option(String).Some(String.from("void*")),
              .Some(list_arg) => match(
                list_arg,
                .FnCall(_, _, _, _, _) => match(
                  recur(list_arg),
                  .None => Option(String).Some(String.from("void*")),
                  .Some(nested_list_ty) => cond(
                    (nested_list_ty == "void*") => Option(String).Some(String.from("void*")),
                    true => {
                      list_ty := String.from("ArrayList_");
                      list_ty.push_string(sanitize_c_ident(nested_list_ty.as_str()));
                      Option(String).Some(list_ty)
                    }
                  )
                ),
                .Atom(_, list_arg_tok) => cond(
                  (list_arg_tok.kind != TokenKind.Identifier) => Option(String).Some(String.from("void*")),
                  true => {
                    list_ty := String.from("ArrayList_");
                    list_ty.push_string(sanitize_c_ident(list_arg_tok.value.as_str()));
                    Option(String).Some(list_ty)
                  }
                )
              )
            ),
            (ftok.value == "Deque") => match(
              func_args.get(usize(0)),
              .None => Option(String).Some(String.from("void*")),
              .Some(deque_arg) => match(
                deque_arg,
                .FnCall(_, _, _, _, _) => match(
                  recur(deque_arg),
                  .None => Option(String).Some(String.from("void*")),
                  .Some(nested_deque_ty) => cond(
                    (nested_deque_ty == "void*") => Option(String).Some(String.from("void*")),
                    true => {
                      deque_ty := String.from("Deque_");
                      deque_ty.push_string(sanitize_c_ident(nested_deque_ty.as_str()));
                      Option(String).Some(deque_ty)
                    }
                  )
                ),
                .Atom(_, deque_arg_tok) => cond(
                  (deque_arg_tok.kind != TokenKind.Identifier) => Option(String).Some(String.from("void*")),
                  true => {
                    deque_ty2 := String.from("Deque_");
                    deque_ty2.push_string(sanitize_c_ident(deque_arg_tok.value.as_str()));
                    Option(String).Some(deque_ty2)
                  }
                )
              )
            ),
            // Other generic container types still use the opaque prototype representation.
            (ftok.value == "Option") => Option(String).Some(String.from("void*")),
            (ftok.value == "Result") => Option(String).Some(String.from("void*")),
            (ftok.value == "Box") => Option(String).Some(String.from("void*")),
            ((ftok.value == "Impl") || (ftok.value == "Dyn")) => match(
              impl_fn_i32_i32_c_type_from_expr(ty_expr),
              .Some(impl_fn_ty) => Option(String).Some(impl_fn_ty),
              .None => Option(String).Some(String.from("void*"))
            ),
            true => Option(String).None
          ),
          true => match(
            func_args.get(usize(0)),
            .None => Option(String).None,
            .Some(inner_ty) => match(
              inner_ty,
              .Atom(_, ittok) => cond(
                (ittok.kind == TokenKind.Identifier) => {
                  inner_c := type_name_to_c(ittok.value.as_str());
                  inner_c.push_str("*");
                  Option(String).Some(inner_c)
                },
                true => Option(String).None
              ),
              .FnCall(_, _, _, _, _) => Option(String).None
            )
          )
        )
      )
    )
  )
);
/// Build a C declaration string combining a type and a variable name.
///
/// For regular types: `"int32_t"` + `"x"` → `"int32_t x"`.
/// For function pointer types encoded as `"RET(*_FP_)(PARAMS)"`:
/// replace the `_FP_` placeholder with the actual name →
/// `"int32_t (*cb)(int32_t)"`.
build_typed_decl :: (fn(c_ty : str, name : str) -> String)({
  ty_s := String.from(c_ty);
  marker := String.from("_FP_");
  cond(
    (ty_s.contains(marker)) => ty_s.replace(marker, String.from(name)),
    true => {
      result := String.from(c_ty);
      result.push_str(" ");
      result.push_str(name);
      result
    }
  )
});
///
/// These names are used for explicit type-cast expressions: `i32(x)` → `(int32_t)(x)`.
is_primitive_type_cast :: (fn(name : str) -> bool)(
  cond(
    (name == "i8") => true,
    (name == "i16") => true,
    (name == "i32") => true,
    (name == "i64") => true,
    (name == "u8") => true,
    (name == "u16") => true,
    (name == "u32") => true,
    (name == "u64") => true,
    (name == "usize") => true,
    (name == "isize") => true,
    (name == "f32") => true,
    (name == "f64") => true,
    (name == "bool") => true,
    true => false
  )
);
/// Check whether all identifier atoms referenced in `expr` are available as C variables
/// (either known to ctx or previously-emitted `::` constants). Used to determine if a
/// `::` infix binary op binding is safe to emit.
expr_all_ids_known :: (fn(expr : AstExpr, ctx : CodegenContext) -> bool)(
  match(
    expr,
    .Atom(_, tok) => cond(
      (tok.kind == TokenKind.Identifier) => (
        is_primitive_type_cast(tok.value.as_str()) ||
          ctx.is_defined_fn(tok.value.as_str()) ||
            ctx.is_struct_name(tok.value.as_str()) ||
              ctx.is_enum_name(tok.value.as_str()) ||
                ctx.is_const_var(tok.value.as_str()) ||
                  ctx.is_array_var(tok.value.as_str()) ||
                    ctx.is_slice_var(tok.value.as_str())
      ),
      true => true
    ),
    .FnCall(_, fn2, args2, _, is_infix2) => {
      // For infix dot-dispatch `obj.method` (infix=true, func=Atom(".")):
      // args2 = [receiver, method_name].  The method_name is not a variable — skip it.
      // Only check the receiver (args2[0]), AND only if the method is one that
      // handle_method_call can emit as valid C (whitelist: neg, len, as_str, is_some, is_none).
      is_dot2 := match(
        fn2.*,
        .Atom(_, ftok2) => (ftok2.value == "."),
        .FnCall(_, _, _, _, _) => false
      );
      (ok2 : bool) = match(
        is_dot2,
        true => {
          method_safe := match(
            args2.get(usize(1)),
            .None => false,
            .Some(mname_e) => match(
              mname_e,
              .Atom(_, mname_tok) => (
                (mname_tok.value == "neg") ||
                  (mname_tok.value == "len") ||
                    (mname_tok.value == "as_str") ||
                      (mname_tok.value == "is_some") ||
                        (mname_tok.value == "is_none")
              ),
              .FnCall(_, _, _, _, _) => false
            )
          );
          cond(
            (!(method_safe)) => false,
            true => match(
              args2.get(usize(0)),
              .None => false,
              .Some(recv2) => recur(recv2, ctx)
            )
          )
        },
        false => {
          (ok2i : bool) = recur(fn2.*, ctx);
          n2 := args2.len();
          (i2 : usize) = usize(0);
          while((i2 < n2) && ok2i, {
            match(
              args2.get(i2),
              .None => {
                ok2i = false;
              },
              .Some(ae2) => {
                if(!(recur(ae2, ctx)), {
                  ok2i = false;
                });
              }
            );
            i2 = (i2 + usize(1));
          });
          ok2i
        }
      );
      ok2
    }
  )
);
/// Handle a primitive type cast: `i32(x)` → `(int32_t)(x)`.
handle_type_cast :: (
  fn(
    type_name : String,
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)(
  match(
    args.get(usize(0)),
    .None => Option(String).None,
    .Some(arg) => {
      // Special case: `i32(EnumName.Variant(args…))` — extract the discriminant
      // integer rather than trying to cast a tagged-union struct.
      // We detect this as: arg is a non-infix FnCall whose func is itself an infix
      // dot-dispatch (method call), whose receiver is a registered enum name and
      // whose method is a registered complex variant.
      //
      // Inline the dot-dispatch detection here (func_box_is_dot_dispatch /
      // get_dispatch_receiver / get_dispatch_method are defined later in the file).
      is_complex_variant_cast := match(
        arg,
        .Atom(_, _) => false,
        .FnCall(_, inner_func, _, _, _) => match(
          inner_func.*,
          .Atom(_, _) => false,
          .FnCall(_, dot_fn, dot_args, dot_infix, _) => (
            dot_infix && (
              match(
                dot_fn.*,
                .Atom(_, dtok) => (dtok.kind == TokenKind.Dot),
                .FnCall(_, _, _, _, _) => false
              ) && match(
                dot_args.get(usize(0)),
                .None => false,
                .Some(recv_e) => match(
                  call_gen_expr(recv_e, ctx, indent),
                  .None => false,
                  .Some(recv_c) => (
                    ctx.is_enum_name(recv_c.as_str()) && match(
                      dot_args.get(usize(1)),
                      .None => false,
                      .Some(method_e) => match(
                        method_e,
                        .FnCall(_, _, _, _, _) => false,
                        .Atom(_, mtok) => ctx.get_variant_fields(recv_c.as_str(), mtok.value.as_str()).is_some()
                      )
                    )
                  )
                )
              )
            )
          )
        )
      );
      cond(
        is_complex_variant_cast => match(
          arg,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, inner_func2, _, _, _) => match(
            inner_func2.*,
            .Atom(_, _) => Option(String).None,
            .FnCall(_, _, dot_args2, _, _) => match(
              dot_args2.get(usize(0)),
              .None => Option(String).None,
              .Some(recv_e2) => match(
                call_gen_expr(recv_e2, ctx, indent),
                .None => Option(String).None,
                .Some(recv_c2) => match(
                  dot_args2.get(usize(1)),
                  .None => Option(String).None,
                  .Some(method_e2) => match(
                    method_e2,
                    .FnCall(_, _, _, _, _) => Option(String).None,
                    .Atom(_, mtok2) => {
                      // Emit `(int32_t)(EnumName_Variant)` — the tag constant value
                      result := String.from("(");
                      result.push_string(type_name_to_c(type_name.as_str()));
                      result.push_str(")(");
                      result.push_string(recv_c2);
                      result.push_str("_");
                      result.push_string(mtok2.value);
                      result.push_str(")");
                      .Some(result)
                    }
                  )
                )
              )
            )
          )
        ),
        true => {
          // Check if this is a simple identifier with a registered complex-enum type.
          // e.g. `i32(shape)` where `shape : Shape` → `(int32_t)(shape.tag)`
          is_complex_enum_var := match(
            arg,
            .FnCall(_, _, _, _, _) => false,
            .Atom(_, atk) => match(
              ctx.get_var_type(atk.value.as_str()),
              .None => false,
              .Some(vtype) => ctx.is_complex_enum_name(vtype.as_str())
            )
          );
          cond(
            is_complex_enum_var => match(
              arg,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, atk2) => {
                result2 := String.from("(");
                result2.push_string(type_name_to_c(type_name.as_str()));
                result2.push_str(")(");
                result2.push_string(atk2.value);
                result2.push_str(".tag)");
                .Some(result2)
              }
            ),
            true => match(
              call_gen_expr(arg, ctx, indent),
              .None => Option(String).None,
              .Some(val) => {
                result := String.from("(");
                result.push_string(type_name_to_c(type_name.as_str()));
                result.push_str(")(");
                result.push_string(val);
                result.push_str(")");
                .Some(result)
              }
            )
          )
        }
      )
    }
  )
);
/// Handle bare type annotation `x : T` → emit `T_c x;` as an uninitialized
/// C variable declaration and return `"0"` (unit sentinel).
///
/// This handles the Yo form `x : i32;` (declare without initial value).
/// For `comptime(x) : T` the LHS is a FnCall; we skip it since comptime
/// variables have no runtime representation in the prototype codegen.
handle_bare_colon_decl :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  lhs_opt := args.get(usize(0));
  rhs_opt := args.get(usize(1));
  match(
    lhs_opt,
    .None => Option(String).None,
    .Some(lhs_expr) => match(
      rhs_opt,
      .None => Option(String).None,
      .Some(ty_expr) => match(
        lhs_expr,
        // x : T  →  emit "T_c x;"  (or "T_c x[N] = {0};" for Array types)
        .Atom(_, name_tok) => {
          san_name := sanitize_c_ident(name_tok.value.as_str());
          // Special case: Array(T, N) or [T; N] bare declaration
          array_decl_emitted := match(
            ty_expr,
            .Atom(_, _) => false,
            .FnCall(_, atf, ata, ati, _) => cond(
              ati => false,
              (ata.len() != usize(2)) => false,
              true => match(
                atf.*,
                .FnCall(_, _, _, _, _) => false,
                .Atom(_, attok) => cond(
                  (attok.value != "Array") => false,
                  true => {
                    elem_c_opt := match(
                      ata.get(usize(0)),
                      .None => Option(String).None,
                      .Some(e) => type_expr_to_c(e)
                    );
                    size_opt := match(
                      ata.get(usize(1)),
                      .None => Option(String).None,
                      .Some(s) => match(
                        s,
                        .FnCall(_, _, _, _, _) => Option(String).None,
                        .Atom(_, stok) => cond(
                          (stok.kind == TokenKind.Integer) => Option(String).Some(stok.value),
                          (stok.kind == TokenKind.Identifier) => Option(String).Some(stok.value),
                          true => Option(String).None
                        )
                      )
                    );
                    match(
                      elem_c_opt,
                      .None => false,
                      .Some(ec) => match(
                        size_opt,
                        .None => false,
                        .Some(sz) => {
                          ctx.emitter.emit_string(indent);
                          ctx.emitter.emit_string(ec);
                          ctx.emitter.emit(" ");
                          ctx.emitter.emit_string(san_name);
                          ctx.emitter.emit("[");
                          ctx.emitter.emit_string(sz);
                          ctx.emitter.emit_line("] = {0};");
                          ctx.register_array_var_with_size(name_tok.value.as_str(), sz.as_str());
                          true
                        }
                      )
                    )
                  }
                )
              )
            )
          );
          cond(
            array_decl_emitted => Option(String).Some(String.from("0")),
            true => match(
              type_expr_to_c(ty_expr),
              .None => Option(String).None,
              .Some(c_ty) => {
                decl := build_typed_decl(c_ty.as_str(), san_name.as_str());
                ctx.emitter.emit_string(indent);
                ctx.emitter.emit_string(decl);
                ctx.emitter.emit_line(";");
                Option(String).Some(String.from("0"))
              }
            )
          )
        },
        // comptime(x) : T — emit "T_c x;" for primitive T; skip for Type (meta-type)
        .FnCall(_, cf_box, cf_args, cf_infix, _) => cond(
          cf_infix =>.Some(String.from("0")),
          (!(cf_args.len() == usize(1))) =>.Some(String.from("0")),
          true => match(
            cf_box.*,
            .FnCall(_, _, _, _, _) =>.Some(String.from("0")),
            .Atom(_, cftok) => cond(
              (!(cftok.value == "comptime")) =>.Some(String.from("0")),
              true => match(
                cf_args.get(usize(0)),
                .None =>.Some(String.from("0")),
                .Some(inner) => match(
                  inner,
                  .FnCall(_, _, _, _, _) =>.Some(String.from("0")),
                  .Atom(_, itok) => cond(
                    (itok.kind != TokenKind.Identifier) =>.Some(String.from("0")),
                    true => {
                      is_meta_type := match(
                        ty_expr,
                        .Atom(_, ttok) => (ttok.value == "Type"),
                        .FnCall(_, _, _, _, _) => false
                      );
                      cond(
                        is_meta_type =>.Some(String.from("0")),
                        true => match(
                          type_expr_to_c(ty_expr),
                          .None =>.Some(String.from("0")),
                          .Some(c_ty) => cond(
                            // Skip `comptime(name) : fn_type` declarations — these are deferred
                            // bindings that need explicit assignment (mutual recursion pattern).
                            // Emitting an uninitialized function pointer causes runtime crashes.
                            (c_ty.contains(String.from("_FP_"))) =>.Some(String.from("0")),
                            true => {
                              san_name := sanitize_c_ident(itok.value.as_str());
                              decl := build_typed_decl(c_ty.as_str(), san_name.as_str());
                              ctx.emitter.emit_string(indent);
                              ctx.emitter.emit_string(decl);
                              ctx.emitter.emit_line(";");
                              .Some(String.from("0"))
                            }
                          )
                        )
                      )
                    }
                  )
                )
              )
            )
          )
        )
      )
    )
  )
});
/// Convert a small index (0-9) to a C tuple field reference "._N".
/// Returns "._0" for 0, "._1" for 1, etc. (up to 9).
_tuple_field_ref :: (fn(idx : usize) -> String)({
  r := String.from("._");
  if(idx == usize(0), {
    r.push_str("0");
  });
  if(idx == usize(1), {
    r.push_str("1");
  });
  if(idx == usize(2), {
    r.push_str("2");
  });
  if(idx == usize(3), {
    r.push_str("3");
  });
  if(idx == usize(4), {
    r.push_str("4");
  });
  if(idx == usize(5), {
    r.push_str("5");
  });
  if(idx == usize(6), {
    r.push_str("6");
  });
  if(idx == usize(7), {
    r.push_str("7");
  });
  if(idx == usize(8), {
    r.push_str("8");
  });
  if(idx == usize(9), {
    r.push_str("9");
  });
  r
});
/// Returns true if the C type name is a numeric/scalar primitive.
/// Used to decide whether Option(T).None should emit `(T)0` vs `NULL`.
is_numeric_c_type :: (fn(ty : str) -> bool)(
  (ty == "int32_t") || ((ty == "int64_t") || ((ty == "uint32_t") || ((ty == "uint64_t") || ((ty == "int8_t") || ((ty == "int16_t") || ((ty == "uint8_t") || ((ty == "uint16_t") || ((ty == "isize") || ((ty == "size_t") || ((ty == "double") || ((ty == "float") || (ty == "bool"))))))))))))
);

type_app_receiver_is :: (fn(expr : AstExpr, type_name : str) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, type_fn_box, _, type_infix, _) => cond(
      type_infix => false,
      true => match(
        type_fn_box.*,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, type_tok) => (type_tok.value == type_name)
      )
    )
  )
);
array_i32_size_arg_to_c :: (
  fn(expr : AstExpr, ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, type_fn_box, type_args, type_infix, _) => cond(
      type_infix => Option(String).None,
      (type_args.len() != usize(2)) => Option(String).None,
      true => match(
        type_fn_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, type_tok) => cond(
          (type_tok.value != "Array") => Option(String).None,
          true => match(
            type_args.get(usize(0)),
            .None => Option(String).None,
            .Some(elem_e) => match(
              elem_e,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, elem_tok) => cond(
                (elem_tok.value != "i32") => Option(String).None,
                true => match(
                  type_args.get(usize(1)),
                  .None => Option(String).None,
                  .Some(size_e) => call_gen_expr(size_e, ctx, indent)
                )
              )
            )
          )
        )
      )
    )
  )
);
type_app_receiver_arg_is :: (fn(expr : AstExpr, type_name : str, arg_name : str) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, type_fn_box, type_args, type_infix, _) => cond(
      type_infix => false,
      (type_args.len() != usize(1)) => false,
      true => match(
        type_fn_box.*,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, type_tok) => cond(
          (type_tok.value != type_name) => false,
          true => match(
            type_args.get(usize(0)),
            .None => false,
            .Some(arg_expr) => match(
              arg_expr,
              .FnCall(_, _, _, _, _) => false,
              .Atom(_, arg_tok) => (arg_tok.value == arg_name)
            )
          )
        )
      )
    )
  )
);
is_slice_u8_from_raw_parts_call :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, call_fn_box, call_args, call_infix, _) => cond(
      call_infix => false,
      (call_args.len() != usize(2)) => false,
      true => match(
        call_fn_box.*,
        .Atom(_, _) => false,
        .FnCall(_, dot_fn_box, dot_args, dot_infix, _) => cond(
          (!(dot_infix && (dot_args.len() == usize(2)))) => false,
          true => match(
            dot_fn_box.*,
            .FnCall(_, _, _, _, _) => false,
            .Atom(_, dot_tok) => cond(
              (dot_tok.value != ".") => false,
              true => match(
                dot_args.get(usize(0)),
                .None => false,
                .Some(recv_e) => cond(
                  (!(type_app_receiver_arg_is(recv_e, "Slice", "u8"))) => false,
                  true => match(
                    dot_args.get(usize(1)),
                    .None => false,
                    .Some(method_e) => match(
                      method_e,
                      .FnCall(_, _, _, _, _) => false,
                      .Atom(_, method_tok) => (method_tok.value == "from_raw_parts")
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
);
var_type_is :: (fn(ctx : CodegenContext, name : str, c_type : str) -> bool)(
  match(
    ctx.get_var_type(name),
    .None => false,
    .Some(actual) => (actual == c_type)
  )
);
static_method_receiver_type_name :: (fn(expr : AstExpr, ctx : CodegenContext) -> Option(String))(
  match(
    expr,
    .FnCall(_, _, _, _, _) => Option(String).None,
    .Atom(_, tok) => cond(
      (tok.value == "Self") => {
        self_ty := ctx.get_self_type();
        cond(
          (self_ty == "") => Option(String).None,
          true => Option(String).Some(String.from(self_ty))
        )
      },
      match(tok.value.at(usize(0)),.Some(r) => ((r.char >= u32(65)) && (r.char <= u32(90))),.None => false) =>
        Option(String).Some(tok.value),
      true => Option(String).None
    )
  )
);
generic_type_app_c_name :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, type_fn_box, type_args, type_infix, _) => cond(
      type_infix => Option(String).None,
      (type_args.len() != usize(1)) => Option(String).None,
      true => match(
        type_fn_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, type_tok) => match(
          type_args.get(usize(0)),
          .None => Option(String).None,
          .Some(arg_expr) => match(
            arg_expr,
            .FnCall(_, _, _, _, _) => Option(String).None,
            .Atom(_, arg_tok) => cond(
              (arg_tok.kind != TokenKind.Identifier) => Option(String).None,
              true => {
                result := sanitize_c_ident(type_tok.value.as_str());
                result.push_str("_");
                result.push_string(sanitize_c_ident(arg_tok.value.as_str()));
                Option(String).Some(result)
              }
            )
          )
        )
      )
    )
  )
);
generic_type_app_base_name :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, type_fn_box, type_args, type_infix, _) => cond(
      type_infix => Option(String).None,
      (type_args.len() != usize(1)) => Option(String).None,
      true => match(
        type_fn_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, type_tok) => Option(String).Some(type_tok.value)
      )
    )
  )
);
generic_type_app_field_c_type :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, _, type_args, type_infix, _) => cond(
      type_infix => Option(String).None,
      (type_args.len() != usize(1)) => Option(String).None,
      true => match(
        type_args.get(usize(0)),
        .None => Option(String).None,
        .Some(arg_expr) => type_expr_to_c(arg_expr)
      )
    )
  )
);
struct_template_field_names_csv :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, struct_fn_box, struct_args, struct_infix, _) => cond(
      struct_infix => Option(String).None,
      true => match(
        struct_fn_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, struct_tok) => cond(
          (struct_tok.value != "struct") => Option(String).None,
          true => {
            csv := String.new();
            n := struct_args.len();
            (i : usize) = usize(0);
            (ok : bool) = true;
            while((i < n) && ok, {
              match(
                struct_args.get(i),
                .None => {
                  ok = false;
                },
                .Some(field_expr) => match(
                  field_expr,
                  .Atom(_, _) => {
                    ok = false;
                  },
                  .FnCall(_, field_fn, field_args, field_infix, _) => cond(
                    (!(field_infix && (field_args.len() >= usize(2)))) => {
                      ok = false;
                    },
                    true => match(
                      field_fn.*,
                      .FnCall(_, _, _, _, _) => {
                        ok = false;
                      },
                      .Atom(_, field_tok) => cond(
                        (field_tok.value != ":") => {
                          ok = false;
                        },
                        true => match(
                          field_args.get(usize(0)),
                          .None => {
                            ok = false;
                          },
                          .Some(field_name_expr) => match(
                            field_name_expr,
                            .FnCall(_, _, _, _, _) => {
                              ok = false;
                            },
                            .Atom(_, field_name_tok) => {
                              if(i > usize(0), {
                                csv.push_str(",");
                              });
                              csv.push_string(field_name_tok.value);
                            }
                          )
                        )
                      )
                    )
                  )
                )
              );
              i = (i + usize(1));
            });
            cond(
              ((!(ok)) || (csv.len() == usize(0))) => Option(String).None,
              true => Option(String).Some(csv)
            )
          }
        )
      )
    )
  )
);
generic_struct_template_fields_from_alias_rhs :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, alias_fn_box, alias_args, alias_infix, _) => cond(
      alias_infix => Option(String).None,
      (alias_args.len() != usize(1)) => Option(String).None,
      true => match(
        alias_fn_box.*,
        .Atom(_, _) => Option(String).None,
        .FnCall(_, _, _, _, _) => match(
          alias_args.get(usize(0)),
          .None => Option(String).None,
          .Some(body_expr) => struct_template_field_names_csv(body_expr)
        )
      )
    )
  )
);
register_generic_struct_template_if_supported :: (
  fn(name : str, rhs_expr : AstExpr, ctx : CodegenContext) -> bool
)(
  match(
    generic_struct_template_fields_from_alias_rhs(rhs_expr),
    .None => false,
    .Some(fields_csv) => {
      ctx.register_generic_struct_template(name, fields_csv.as_str());
      true
    }
  )
);
ensure_generic_struct_instance :: (fn(ctx : CodegenContext, type_app_expr : AstExpr) -> Option(String))(
  match(
    generic_type_app_base_name(type_app_expr),
    .None => Option(String).None,
    .Some(base_name) => match(
      ctx.get_generic_struct_template_fields(base_name.as_str()),
      .None => Option(String).None,
      .Some(fields_csv) => match(
        generic_type_app_c_name(type_app_expr),
        .None => Option(String).None,
        .Some(concrete_name) => match(
          generic_type_app_field_c_type(type_app_expr),
          .None => Option(String).None,
          .Some(field_c_ty) => {
            if(!(ctx.is_struct_name(concrete_name.as_str())), {
              fields := _split_csv(fields_csv.as_str());
              decl := String.from("typedef struct { ");
              field_types_csv := String.new();
              n := fields.len();
              (i : usize) = usize(0);
              while(i < n, {
                match(
                  fields.get(i),
                  .None => (),
                  .Some(field_name) => {
                    decl.push_string(field_c_ty);
                    decl.push_str(" ");
                    decl.push_string(field_name);
                    decl.push_str("; ");
                    if(i > usize(0), {
                      field_types_csv.push_str(",");
                    });
                    field_types_csv.push_string(field_c_ty);
                  }
                );
                i = (i + usize(1));
              });
              decl.push_str("} ");
              decl.push_string(concrete_name);
              decl.push_str(";");
              ctx.emitter.emit_declaration_string_line(decl);
              ctx.register_struct(String.from(concrete_name.as_str()));
              ctx.register_struct_fields(concrete_name.as_str(), fields_csv.as_str());
              ctx.register_struct_field_types(concrete_name.as_str(), field_types_csv.as_str());
            });
            Option(String).Some(concrete_name)
          }
        )
      )
    )
  )
);
generic_struct_constructor_to_c :: (
  fn(type_app_expr : AstExpr, args : ArrayList(AstExpr), ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    ensure_generic_struct_instance(ctx, type_app_expr),
    .None => Option(String).None,
    .Some(concrete_name) => match(
      ctx.get_struct_fields(concrete_name.as_str()),
      .None => Option(String).None,
      .Some(fields_csv) => {
        fields := _split_csv(fields_csv.as_str());
        cond(
          (fields.len() != args.len()) => Option(String).None,
          true => {
            result := String.from("(");
            result.push_string(concrete_name);
            result.push_str("){");
            n := args.len();
            (i : usize) = usize(0);
            (ok : bool) = true;
            while((i < n) && ok, {
              match(
                fields.get(i),
                .None => {
                  ok = false;
                },
                .Some(field_name) => match(
                  args.get(i),
                  .None => {
                    ok = false;
                  },
                  .Some(arg_expr) => match(
                    call_gen_expr(arg_expr, ctx, indent),
                    .None => {
                      ok = false;
                    },
                    .Some(arg_c) => {
                      if(i > usize(0), {
                        result.push_str(", ");
                      });
                      result.push_str(".");
                      result.push_string(field_name);
                      result.push_str(" = ");
                      result.push_string(arg_c);
                    }
                  )
                )
              );
              i = (i + usize(1));
            });
            result.push_str("}");
            cond(
              ok => Option(String).Some(result),
              true => Option(String).None
            )
          }
        )
      }
    )
  )
);
generic_struct_constructor_type_from_call :: (fn(expr : AstExpr, ctx : CodegenContext) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, ctor_fn_box, _, ctor_infix, _) => cond(
      ctor_infix => Option(String).None,
      true => match(
        ctor_fn_box.*,
        .Atom(_, _) => Option(String).None,
        .FnCall(_, _, _, _, _) => ensure_generic_struct_instance(ctx, ctor_fn_box.*)
      )
    )
  )
);
ensure_generic_value_struct :: (fn(ctx : CodegenContext, type_name : String, field_c_ty : String) -> unit)({
  if(!(ctx.is_struct_name(type_name.as_str())), {
    decl := String.from("typedef struct { ");
    decl.push_string(field_c_ty);
    decl.push_str(" value; } ");
    decl.push_string(type_name);
    decl.push_str(";");
    ctx.emitter.emit_declaration_string_line(decl);
    ctx.register_struct(String.from(type_name.as_str()));
    ctx.register_struct_fields(type_name.as_str(), "value");
    ctx.register_struct_field_types(type_name.as_str(), field_c_ty.as_str());
  });
});
is_arraylist_c_type :: (fn(c_ty : str) -> bool)(
  String.from(c_ty).starts_with(String.from("ArrayList_"))
);
is_deque_c_type :: (fn(c_ty : str) -> bool)(
  String.from(c_ty).starts_with(String.from("Deque_"))
);
is_hashmap_c_type :: (fn(c_ty : str) -> bool)(
  String.from(c_ty).starts_with(String.from("HashMap_"))
);
is_btreemap_c_type :: (fn(c_ty : str) -> bool)(
  String.from(c_ty).starts_with(String.from("BTreeMap_"))
);
is_runtime_map_c_type :: (fn(c_ty : str) -> bool)(
  is_hashmap_c_type(c_ty) || is_btreemap_c_type(c_ty)
);
/// True if `c_ty` is one of the bootstrap compound-literal C types — i.e. the
/// concrete value layout backing `ArrayList(T)`, `Deque(T)`, `HashMap(K,V)`,
/// `BTreeMap(K,V)`, or a `YoSlice_*` / `YoArray_*` specialization. These all
/// initialize via `(T){.data = ..., ...}` compound literals, so a `name :=`
/// binding whose RHS starts with `(T){` should register the LHS as type `T`.
is_compound_aggregate_c_type :: (fn(c_ty : str) -> bool)(
  ((is_arraylist_c_type(c_ty) || is_deque_c_type(c_ty)) || is_runtime_map_c_type(c_ty)) ||
    (String.from(c_ty).starts_with(String.from("YoSlice_")) || String.from(c_ty).starts_with(String.from("YoArray_")))
);
is_runtime_index_assignable_type :: (fn(ctx : CodegenContext, c_ty : str) -> bool)(
  ((is_arraylist_c_type(c_ty) || is_deque_c_type(c_ty)) || is_runtime_map_c_type(c_ty)) ||
    match(
      ctx.get_struct_fields(c_ty),
      .None => false,
      .Some(_) => true
    )
);
is_runtime_index_callable_type :: (fn(ctx : CodegenContext, c_ty : str) -> bool)(
  (c_ty == "const char*") || is_runtime_index_assignable_type(ctx, c_ty)
);
should_skip_comptime_field_assignment :: (fn(ctx : CodegenContext, lhs_expr : AstExpr) -> bool)(
  match(
    lhs_expr,
    .Atom(_, _) => false,
    .FnCall(_, cm_fn, cm_args, cm_infix, _) => (
      cm_infix &&
        match(
          cm_fn.*,
          .Atom(_, cm_tok) => (cm_tok.value == "."),
          .FnCall(_, _, _, _, _) => false
        ) &&
          match(
            cm_args.get(usize(0)),
            .None => false,
            .Some(cm_recv) => match(
              cm_recv,
              .Atom(_, cm_recv_tok) => (
                (cm_recv_tok.kind == TokenKind.Identifier) &&
                  ctx.is_const_var(cm_recv_tok.value.as_str())
              ),
              .FnCall(_, _, _, _, _) => false
            )
          )
    )
  )
);
should_skip_unsupported_index_assignment :: (fn(ctx : CodegenContext, lhs_expr : AstExpr) -> bool)(
  match(
    lhs_expr,
    .Atom(_, _) => false,
    .FnCall(_, nai_fn, nai_args, nai_infix, _) => (
      ((!(nai_infix)) && (nai_args.len() == usize(1))) &&
        match(
          nai_fn.*,
          .FnCall(_, _, _, _, _) => false,
          .Atom(_, nai_tok) => cond(
            (nai_tok.kind != TokenKind.Identifier) => false,
            ctx.is_array_var(nai_tok.value.as_str()) => false,
            ctx.is_slice_var(nai_tok.value.as_str()) => false,
            ctx.is_defined_fn(nai_tok.value.as_str()) => false,
            true => match(
              ctx.get_var_type(nai_tok.value.as_str()),
              .None => true,
              .Some(nai_var_ty) => cond(
                is_runtime_index_assignable_type(ctx, nai_var_ty.as_str()) => false,
                true => true
              )
            )
          )
        )
    )
  )
);
arraylist_elem_c_type_from_name :: (fn(c_ty : str) -> Option(String))({
  c_ty_s := String.from(c_ty);
  prefix := String.from("ArrayList_");
  cond(
    (!(c_ty_s.starts_with(prefix))) => Option(String).None,
    true => {
      elem_name := c_ty_s.substring(prefix.len(), c_ty_s.len());
      Option(String).Some(type_name_to_c(elem_name.as_str()))
    }
  )
});
ensure_arraylist_c_type :: (fn(ctx : CodegenContext, c_ty : str) -> unit)({
  if(((c_ty != "ArrayList_u8") && is_arraylist_c_type(c_ty)) && (!(ctx.is_struct_name(c_ty))), {
    match(
      arraylist_elem_c_type_from_name(c_ty),
      .None => (),
      .Some(elem_c_ty) => {
        if(is_arraylist_c_type(elem_c_ty.as_str()), {
          recur(ctx, elem_c_ty.as_str());
        });
        decl := String.from("typedef struct { ");
        decl.push_string(elem_c_ty);
        decl.push_str(" data[1024]; size_t length; ");
        decl.push_string(elem_c_ty);
        decl.push_str("* _ptr; } ");
        decl.push_str(c_ty);
        decl.push_str(";");
        ctx.emitter.emit_declaration_string_line(decl);
        ctx.register_struct(String.from(c_ty));
        ctx.register_struct_fields(c_ty, "data,length,_ptr");
      }
    );
  });
});
is_impl_fn_c_type :: (fn(c_ty : str) -> bool)(
  c_ty == "__yo_impl_fn_i32_i32"
);
ensure_impl_fn_c_type :: (fn(ctx : CodegenContext, c_ty : str) -> unit)({
  if((is_impl_fn_c_type(c_ty)) && (!(ctx.is_struct_name(c_ty))), {
    ctx.emitter.emit_declaration_string_line(
      String.from("typedef struct { void* data; int32_t (*call)(void*, int32_t); } __yo_impl_fn_i32_i32;")
    );
    ctx.register_struct(String.from(c_ty));
    ctx.register_struct_fields(c_ty, "data,call");
  });
});
deque_elem_c_type_from_name :: (fn(c_ty : str) -> Option(String))({
  c_ty_s := String.from(c_ty);
  prefix := String.from("Deque_");
  cond(
    (!(c_ty_s.starts_with(prefix))) => Option(String).None,
    true => {
      elem_name := c_ty_s.substring(prefix.len(), c_ty_s.len());
      Option(String).Some(type_name_to_c(elem_name.as_str()))
    }
  )
});
ensure_deque_c_type :: (fn(ctx : CodegenContext, c_ty : str) -> unit)({
  if(is_deque_c_type(c_ty) && (!(ctx.is_struct_name(c_ty))), {
    match(
      deque_elem_c_type_from_name(c_ty),
      .None => (),
      .Some(elem_c_ty) => {
        decl := String.from("typedef struct { ");
        decl.push_string(elem_c_ty);
        decl.push_str(" data[1024]; size_t head; size_t length; } ");
        decl.push_str(c_ty);
        decl.push_str(";");
        ctx.emitter.emit_declaration_string_line(decl);
        ctx.register_struct(String.from(c_ty));
        ctx.register_struct_fields(c_ty, "data,head,length");
      }
    );
  });
});
map_key_c_type_from_name :: (fn(c_ty : str, prefix : str) -> Option(String))({
  c_ty_s := String.from(c_ty);
  prefix_s := String.from(prefix);
  cond(
    (!(c_ty_s.starts_with(prefix_s))) => Option(String).None,
    true => {
      suffix := c_ty_s.substring(prefix_s.len(), c_ty_s.len());
      match(
        suffix.index_of(String.from("_"), usize(0)),
        .None => Option(String).None,
        .Some(sep) => {
          key_name := suffix.substring(usize(0), sep);
          Option(String).Some(type_name_to_c(key_name.as_str()))
        }
      )
    }
  )
});
map_value_c_type_from_name :: (fn(c_ty : str, prefix : str) -> Option(String))({
  c_ty_s := String.from(c_ty);
  prefix_s := String.from(prefix);
  cond(
    (!(c_ty_s.starts_with(prefix_s))) => Option(String).None,
    true => {
      suffix := c_ty_s.substring(prefix_s.len(), c_ty_s.len());
      match(
        suffix.index_of(String.from("_"), usize(0)),
        .None => Option(String).None,
        .Some(sep) => {
          value_name := suffix.substring(sep + usize(1), suffix.len());
          Option(String).Some(type_name_to_c(value_name.as_str()))
        }
      )
    }
  )
});
ensure_runtime_map_c_type :: (fn(ctx : CodegenContext, c_ty : str, prefix : str) -> unit)({
  if((String.from(c_ty).starts_with(String.from(prefix))) && (!(ctx.is_struct_name(c_ty))), {
    match(
      map_key_c_type_from_name(c_ty, prefix),
      .None => (),
      .Some(key_c_ty) => match(
        map_value_c_type_from_name(c_ty, prefix),
        .None => (),
        .Some(value_c_ty) => {
          decl := String.from("typedef struct { ");
          decl.push_string(key_c_ty);
          decl.push_str(" keys[1024]; ");
          decl.push_string(value_c_ty);
          decl.push_str(" values[1024]; size_t length; } ");
          decl.push_str(c_ty);
          decl.push_str(";");
          ctx.emitter.emit_declaration_string_line(decl);
          ctx.register_struct(String.from(c_ty));
          ctx.register_struct_fields(c_ty, "keys,values,length");
        }
      )
    );
  });
});
generic_static_constructor_type_from_call :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, call_fn_box, call_args, call_infix, _) => cond(
      call_infix => Option(String).None,
      (call_args.len() != usize(1)) => Option(String).None,
      true => match(
        call_fn_box.*,
        .Atom(_, _) => Option(String).None,
        .FnCall(_, dot_fn, dot_args, dot_infix, _) => cond(
          (!(dot_infix && (dot_args.len() == usize(2)))) => Option(String).None,
          true => match(
            dot_fn.*,
            .FnCall(_, _, _, _, _) => Option(String).None,
            .Atom(_, dot_tok) => cond(
              (dot_tok.value != ".") => Option(String).None,
              true => match(
                dot_args.get(usize(1)),
                .None => Option(String).None,
                .Some(method_e) => match(
                  method_e,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, method_tok) => cond(
                    !((method_tok.value == "new") || (method_tok.value == "another_new")) =>
                      Option(String).None,
                    true => match(
                      dot_args.get(usize(0)),
                      .None => Option(String).None,
                      .Some(recv_e) => generic_type_app_c_name(recv_e)
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
);
box_constructor_elem_c_type :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, box_call_fn_box, box_call_args, box_call_infix, _) => cond(
      box_call_infix => Option(String).None,
      (box_call_args.len() != usize(1)) => Option(String).None,
      true => match(
        box_call_fn_box.*,
        .Atom(_, _) => Option(String).None,
        .FnCall(_, box_type_fn_box, box_type_args, box_type_infix, _) => cond(
          box_type_infix => Option(String).None,
          (box_type_args.len() != usize(1)) => Option(String).None,
          true => match(
            box_type_fn_box.*,
            .FnCall(_, _, _, _, _) => Option(String).None,
            .Atom(_, box_type_tok) => cond(
              (box_type_tok.value != "Box") => Option(String).None,
              true => match(
                box_type_args.get(usize(0)),
                .None => Option(String).None,
                .Some(box_elem_ty_expr) => type_expr_to_c(box_elem_ty_expr)
              )
            )
          )
        )
      )
    )
  )
);
emit_method_extraction_macro_if_supported :: (
  fn(name : str, rhs_expr : AstExpr, ctx : CodegenContext, indent : String) -> bool
)(
  match(
    rhs_expr,
    .Atom(_, _) => false,
    .FnCall(_, me_fn_box, me_args, me_infix, _) => cond(
      (!(me_infix)) => false,
      (me_args.len() != usize(2)) => false,
      true => match(
        me_fn_box.*,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, me_dot_tok) => cond(
          (me_dot_tok.value != ".") => false,
          true => match(
            me_args.get(usize(0)),
            .None => false,
            .Some(me_recv) => match(
              me_args.get(usize(1)),
              .None => false,
              .Some(me_method_expr) => match(
                me_method_expr,
                .FnCall(_, _, _, _, _) => false,
                .Atom(_, me_method_tok) => cond(
                  (me_method_tok.value != "unwrap") => false,
                  (!(type_app_receiver_is(me_recv, "Option") || type_app_receiver_is(me_recv, "Result"))) => false,
                  true => {
                    ctx.emitter.emit_string(indent);
                    ctx.emitter.emit("#define ");
                    ctx.emitter.emit_string(sanitize_c_ident(name));
                    ctx.emitter.emit_line("(__yo_value) (__yo_value)");
                    true
                  }
                )
              )
            )
          )
        )
      )
    )
  )
);
anon_struct_type_to_c :: (fn(type_args : ArrayList(AstExpr)) -> Option(String))({
  n := type_args.len();
  result := String.from("struct { ");
  (i : usize) = usize(0);
  (ok : bool) = true;
  while((i < n) && ok, {
    match(
      type_args.get(i),
      .None => {
        ok = false;
      },
      .Some(field_expr) => match(
        field_expr,
        .Atom(_, _) => {
          ok = false;
        },
        .FnCall(_, colon_box, colon_args, colon_infix, _) => cond(
          (!(colon_infix && (colon_args.len() == usize(2)))) => {
            ok = false;
          },
          true => match(
            colon_box.*,
            .FnCall(_, _, _, _, _) => {
              ok = false;
            },
            .Atom(_, colon_tok) => cond(
              !((colon_tok.value == ":") || (colon_tok.value == "?=")) => {
                ok = false;
              },
              true => {
                actual_args_opt := cond(
                  (colon_tok.value == ":") => Option(ArrayList(AstExpr)).Some(colon_args),
                  true => match(
                    colon_args.get(usize(0)),
                    .None => Option(ArrayList(AstExpr)).None,
                    .Some(inner_field_expr) => match(
                      inner_field_expr,
                      .Atom(_, _) => Option(ArrayList(AstExpr)).None,
                      .FnCall(_, inner_colon_box, inner_colon_args, inner_colon_infix, _) => cond(
                        (!(inner_colon_infix && (inner_colon_args.len() == usize(2)))) =>
                          Option(ArrayList(AstExpr)).None,
                        true => match(
                          inner_colon_box.*,
                          .FnCall(_, _, _, _, _) => Option(ArrayList(AstExpr)).None,
                          .Atom(_, inner_colon_tok) => cond(
                            (inner_colon_tok.value != ":") => Option(ArrayList(AstExpr)).None,
                            true => Option(ArrayList(AstExpr)).Some(inner_colon_args)
                          )
                        )
                      )
                    )
                  )
                );
                field_name_opt := match(
                  actual_args_opt,
                  .None => Option(String).None,
                  .Some(actual_args) => match(
                    actual_args.get(usize(0)),
                    .None => Option(String).None,
                    .Some(name_expr) => match(
                      name_expr,
                      .FnCall(_, _, _, _, _) => Option(String).None,
                      .Atom(_, name_tok) => Option(String).Some(name_tok.value)
                    )
                  )
                );
                field_ty_opt := match(
                  actual_args_opt,
                  .None => Option(String).None,
                  .Some(actual_args2) => match(
                    actual_args2.get(usize(1)),
                    .None => Option(String).None,
                    .Some(ty_expr) => type_expr_to_c(ty_expr)
                  )
                );
                match(
                  field_name_opt,
                  .None => {
                    ok = false;
                  },
                  .Some(field_name) => match(
                    field_ty_opt,
                    .None => {
                      ok = false;
                    },
                    .Some(field_ty) => {
                      result.push_string(field_ty);
                      result.push_str(" ");
                      result.push_string(sanitize_c_ident(field_name.as_str()));
                      result.push_str("; ");
                    }
                  )
                );
              }
            )
          )
        )
      )
    );
    i = (i + usize(1));
  });
  cond(
    (!(ok)) => Option(String).None,
    true => {
      result.push_str("}");
      Option(String).Some(result)
    }
  )
});
anon_struct_initializer_to_c :: (
  fn(
    value_args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  result := String.from("{");
  n := value_args.len();
  (i : usize) = usize(0);
  (ok : bool) = true;
  while((i < n) && ok, {
    match(
      value_args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg_expr) => match(
        call_gen_expr(arg_expr, ctx, indent),
        .None => {
          ok = false;
        },
        .Some(arg_code) => {
          if(i > usize(0), {
            result.push_str(", ");
          });
          result.push_string(arg_code);
        }
      )
    );
    i = (i + usize(1));
  });
  cond(
    (!(ok)) => Option(String).None,
    true => {
      result.push_str("}");
      Option(String).Some(result)
    }
  )
});
struct_default_values_csv :: (
  fn(
    type_args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> String
)({
  result := String.new();
  n := type_args.len();
  (i : usize) = usize(0);
  while(i < n, {
    if(i > usize(0), {
      result.push_str(",");
    });
    default_code_opt := match(
      type_args.get(i),
      .None => Option(String).None,
      .Some(field_expr) => match(
        field_expr,
        .Atom(_, _) => Option(String).None,
        .FnCall(_, field_fn, field_args, field_infix, _) => cond(
          (!(field_infix && (field_args.len() == usize(2)))) => Option(String).None,
          true => match(
            field_fn.*,
            .FnCall(_, _, _, _, _) => Option(String).None,
            .Atom(_, field_tok) => cond(
              (field_tok.value != "?=") => Option(String).None,
              true => match(
                field_args.get(usize(1)),
                .None => Option(String).None,
                .Some(default_expr) => call_gen_expr(default_expr, ctx, indent)
              )
            )
          )
        )
      )
    );
    match(
      default_code_opt,
      .None => result.push_str("__yo_no_default"),
      .Some(default_code) => result.push_string(default_code)
    );
    i = (i + usize(1));
  });
  result
});
struct_defaults_has_value :: (fn(defaults_csv : String) -> bool)({
  parts := _split_csv(defaults_csv.as_str());
  n := parts.len();
  (i : usize) = usize(0);
  (found : bool) = false;
  while((i < n) && (!(found)), {
    match(
      parts.get(i),
      .None => (),
      .Some(part) => {
        if(part != "__yo_no_default", {
          found = true;
        });
      }
    );
    i = (i + usize(1));
  });
  found
});
aggregate_initializer_to_c :: (
  fn(
    expr : AstExpr,
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)(
  match(
    expr,
    .Atom(_, _) => call_gen_expr(expr, ctx, indent),
    .FnCall(_, agg_fn, agg_args, agg_infix, _) => cond(
      agg_infix => call_gen_expr(expr, ctx, indent),
      true => match(
        agg_fn.*,
        .FnCall(_, _, _, _, _) => call_gen_expr(expr, ctx, indent),
        .Atom(_, agg_tok) => cond(
          !((agg_tok.value == BK_TUPLE) || (agg_tok.value == BK_ANON_STRUCT)) =>
            call_gen_expr(expr, ctx, indent),
          true => {
            result := String.from("{");
            n := agg_args.len();
            (i : usize) = usize(0);
            (ok : bool) = true;
            while((i < n) && ok, {
              match(
                agg_args.get(i),
                .None => {
                  ok = false;
                },
                .Some(arg_expr) => {
                  if(i > usize(0), {
                    result.push_str(", ");
                  });
                  arg_is_labeled := match(
                    arg_expr,
                    .Atom(_, _) => false,
                    .FnCall(_, label_fn, label_args, label_infix, _) => (
                      label_infix &&
                        (label_args.len() == usize(2)) &&
                          match(
                            label_fn.*,
                            .Atom(_, label_tok) => (label_tok.value == ":"),
                            .FnCall(_, _, _, _, _) => false
                          )
                    )
                  );
                  cond(
                    ((agg_tok.value == BK_ANON_STRUCT) && arg_is_labeled) => match(
                      arg_expr,
                      .Atom(_, _) => {
                        ok = false;
                      },
                      .FnCall(_, _, label_args2, _, _) => match(
                        label_args2.get(usize(0)),
                        .None => {
                          ok = false;
                        },
                        .Some(label_name_e) => match(
                          label_args2.get(usize(1)),
                          .None => {
                            ok = false;
                          },
                          .Some(label_value_e) => match(
                            label_name_e,
                            .FnCall(_, _, _, _, _) => {
                              ok = false;
                            },
                            .Atom(_, label_name_tok) => match(
                              recur(label_value_e, ctx, indent),
                              .None => {
                                ok = false;
                              },
                              .Some(label_value_c) => {
                                result.push_str(".");
                                result.push_string(sanitize_c_ident(label_name_tok.value.as_str()));
                                result.push_str(" = ");
                                result.push_string(label_value_c);
                              }
                            )
                          )
                        )
                      )
                    ),
                    true => match(
                      recur(arg_expr, ctx, indent),
                      .None => {
                        ok = false;
                      },
                      .Some(arg_c) => {
                        result.push_string(arg_c);
                      }
                    )
                  );
                }
              );
              i = (i + usize(1));
            });
            cond(
              (!(ok)) => Option(String).None,
              true => {
                result.push_str("}");
                Option(String).Some(result)
              }
            )
          }
        )
      )
    )
  )
);
expr_contains_ident_name :: (fn(expr : AstExpr, name : str) -> bool)(
  match(
    expr,
    .Atom(_, tok) => ((tok.kind == TokenKind.Identifier) && (tok.value == name)),
    .FnCall(_, func_box, args, _, _) => {
      (found : bool) = recur(func_box.*, name);
      (i : usize) = usize(0);
      while((i < args.len()) && (!(found)), {
        match(
          args.get(i),
          .None => (),
          .Some(arg_expr) => {
            if(recur(arg_expr, name), {
              found = true;
            });
          }
        );
        i = (i + usize(1));
      });
      found
    }
  )
);
closure_param_name_from_impl_fn :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, impl_fn_box, impl_args, impl_infix, _) => cond(
      impl_infix => Option(String).None,
      (impl_args.len() != usize(1)) => Option(String).None,
      true => match(
        impl_fn_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, impl_tok) => cond(
          !((impl_tok.value == "Impl") || (impl_tok.value == "Dyn")) => Option(String).None,
          true => match(
            impl_args.get(usize(0)),
            .None => Option(String).None,
            .Some(fn_type_expr) => match(
              fn_type_expr,
              .Atom(_, _) => Option(String).None,
              .FnCall(_, arrow_fn_box, arrow_args, arrow_infix, _) => cond(
                (!(arrow_infix)) => Option(String).None,
                (arrow_args.len() != usize(2)) => Option(String).None,
                true => match(
                  arrow_fn_box.*,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, arrow_tok) => cond(
                    (arrow_tok.value != "->") => Option(String).None,
                    true => match(
                      arrow_args.get(usize(0)),
                      .None => Option(String).None,
                      .Some(fn_head_expr) => match(
                        fn_head_expr,
                        .Atom(_, _) => Option(String).None,
                        .FnCall(_, fn_head_box, fn_head_args, fn_head_infix, _) => cond(
                          fn_head_infix => Option(String).None,
                          (fn_head_args.len() != usize(1)) => Option(String).None,
                          true => match(
                            fn_head_box.*,
                            .FnCall(_, _, _, _, _) => Option(String).None,
                            .Atom(_, fn_tok) => cond(
                              !((fn_tok.value == "Fn") || (fn_tok.value == "fn")) =>
                                Option(String).None,
                              true => match(
                                fn_head_args.get(usize(0)),
                                .None => Option(String).None,
                                .Some(param_expr) => match(
                                  param_expr,
                                  .Atom(_, param_tok) => Option(String).Some(param_tok.value),
                                  .FnCall(_, colon_fn_box, colon_args, colon_infix, _) => cond(
                                    (!(colon_infix)) => Option(String).None,
                                    (colon_args.len() != usize(2)) => Option(String).None,
                                    true => match(
                                      colon_fn_box.*,
                                      .FnCall(_, _, _, _, _) => Option(String).None,
                                      .Atom(_, colon_tok) => cond(
                                        (colon_tok.value != ":") => Option(String).None,
                                        true => match(
                                          colon_args.get(usize(0)),
                                          .None => Option(String).None,
                                          .Some(param_name_expr) => match(
                                            param_name_expr,
                                            .FnCall(_, _, _, _, _) => Option(String).None,
                                            .Atom(_, param_name_tok) => Option(String).Some(param_name_tok.value)
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
);
simple_closure_capture_from_body :: (fn(body_expr : AstExpr, param_name : str) -> Option(String))(
  match(
    body_expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, begin_fn_box, begin_args, begin_infix, _) => cond(
      begin_infix => Option(String).None,
      true => match(
        begin_fn_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, begin_tok) => cond(
          (begin_tok.value != BK_BEGIN) => Option(String).None,
          true => {
            (i : usize) = usize(0);
            (result : Option(String)) = Option(String).None;
            while((i < begin_args.len()) && match(result,.None => true,.Some(_) => false), {
              match(
                begin_args.get(i),
                .None => (),
                .Some(stmt_expr) => match(
                  stmt_expr,
                  .Atom(_, _) => (),
                  .FnCall(_, assign_fn_box, assign_args, assign_infix, _) => if(assign_infix && (assign_args.len() == usize(2)), {
                    assign_is_eq := match(
                      assign_fn_box.*,
                      .FnCall(_, _, _, _, _) => false,
                      .Atom(_, assign_tok) => (assign_tok.value == "=")
                    );
                    if(assign_is_eq, {
                      lhs_name_opt := match(
                        assign_args.get(usize(0)),
                        .None => Option(String).None,
                        .Some(lhs_expr) => match(
                          lhs_expr,
                          .FnCall(_, lhs_dot_box, lhs_dot_args, lhs_dot_infix, _) => cond(
                            (!(lhs_dot_infix)) => Option(String).None,
                            (lhs_dot_args.len() != usize(2)) => Option(String).None,
                            true => match(
                              lhs_dot_box.*,
                              .FnCall(_, _, _, _, _) => Option(String).None,
                              .Atom(_, lhs_dot_tok) => cond(
                                (lhs_dot_tok.value != ".") => Option(String).None,
                                true => match(
                                  lhs_dot_args.get(usize(1)),
                                  .None => Option(String).None,
                                  .Some(lhs_field_expr) => match(
                                    lhs_field_expr,
                                    .FnCall(_, _, _, _, _) => Option(String).None,
                                    .Atom(_, lhs_field_tok) => cond(
                                      (lhs_field_tok.value != "*") => Option(String).None,
                                      true => match(
                                        lhs_dot_args.get(usize(0)),
                                        .None => Option(String).None,
                                        .Some(lhs_base_expr) => match(
                                          lhs_base_expr,
                                          .FnCall(_, _, _, _, _) => Option(String).None,
                                          .Atom(_, lhs_base_tok) => Option(String).Some(lhs_base_tok.value)
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          ),
                          .Atom(_, lhs_tok) => Option(String).Some(lhs_tok.value)
                        )
                      );
                      rhs_mentions_param := match(
                        assign_args.get(usize(1)),
                        .None => false,
                        .Some(rhs_expr) => expr_contains_ident_name(rhs_expr, param_name)
                      );
                      if(rhs_mentions_param, {
                        result = lhs_name_opt;
                      });
                    });
                  })
                )
              );
              i = (i + usize(1));
            });
            result
          }
        )
      )
    )
  )
);
simple_closure_capture_from_body_or_cond :: (fn(body_expr : AstExpr, param_name : str) -> Option(String))({
  direct := simple_closure_capture_from_body(body_expr, param_name);
  match(
    direct,
    .Some(_) => direct,
    .None => match(
      body_expr,
      .Atom(_, _) => Option(String).None,
      .FnCall(_, begin_fn_box, begin_args, begin_infix, _) => cond(
        begin_infix => Option(String).None,
        true => match(
          begin_fn_box.*,
          .FnCall(_, _, _, _, _) => Option(String).None,
          .Atom(_, begin_tok) => cond(
            (begin_tok.value != BK_BEGIN) => Option(String).None,
            true => {
              (i : usize) = usize(0);
              (result : Option(String)) = Option(String).None;
              while((i < begin_args.len()) && match(result,.None => true,.Some(_) => false), {
                match(
                  begin_args.get(i),
                  .None => (),
                  .Some(stmt_expr) => match(
                    stmt_expr,
                    .Atom(_, _) => (),
                    .FnCall(_, cond_fn_box, cond_args, cond_infix, _) => if(!(cond_infix), {
                      is_cond_expr := match(
                        cond_fn_box.*,
                        .FnCall(_, _, _, _, _) => false,
                        .Atom(_, cond_tok) => (cond_tok.value == "cond")
                      );
                      if(is_cond_expr, {
                        (ci : usize) = usize(0);
                        while((ci < cond_args.len()) && match(result,.None => true,.Some(_) => false), {
                          match(
                            cond_args.get(ci),
                            .None => (),
                            .Some(arm_expr) => match(
                              arm_expr,
                              .Atom(_, _) => (),
                              .FnCall(_, arm_fn_box, arm_args, arm_infix, _) => if(arm_infix && (arm_args.len() == usize(2)), {
                                is_arrow := match(
                                  arm_fn_box.*,
                                  .FnCall(_, _, _, _, _) => false,
                                  .Atom(_, arm_tok) => (arm_tok.value == "=>")
                                );
                                if(is_arrow, {
                                  match(
                                    arm_args.get(usize(1)),
                                    .None => (),
                                    .Some(arm_body_expr) => {
                                      result = simple_closure_capture_from_body(arm_body_expr, param_name);
                                    }
                                  );
                                });
                              })
                            )
                          );
                          ci = (ci + usize(1));
                        });
                      });
                    })
                  )
                );
                i = (i + usize(1));
              });
              result
            }
          )
        )
      )
    )
  )
});
/// Check if a fn_box is a typed fn-type: `fn(params) -> RetType` parsed as
/// `FnCall(fn=Atom("->"), args=[FnCall(fn=Atom("fn"), params), RetType], infix=true)`.
/// Returns `Some(params_expr)` (the first arg of `fn(...)`) if so.
typed_lambda_fn_box_params :: (fn(fn_box : AstExpr) -> Option(AstExpr))(
  match(
    fn_box,
    .Atom(_, _) => Option(AstExpr).None,
    .FnCall(_, arrow_box, arrow_args, arrow_infix, _) => cond(
      (!(arrow_infix && (arrow_args.len() == usize(2)))) => Option(AstExpr).None,
      true => match(
        arrow_box.*,
        .FnCall(_, _, _, _, _) => Option(AstExpr).None,
        .Atom(_, arrow_tok) => cond(
          (arrow_tok.value != "->") => Option(AstExpr).None,
          true => match(
            arrow_args.get(usize(0)),
            .None => Option(AstExpr).None,
            .Some(fn_params_e) => match(
              fn_params_e,
              .Atom(_, _) => Option(AstExpr).None,
              .FnCall(_, fn_kw_box, fn_kw_args, fn_kw_infix, _) => cond(
                (fn_kw_infix || (fn_kw_args.len() != usize(1))) => Option(AstExpr).None,
                true => match(
                  fn_kw_box.*,
                  .FnCall(_, _, _, _, _) => Option(AstExpr).None,
                  .Atom(_, fn_kw_tok) => cond(
                    (fn_kw_tok.value != "fn") => Option(AstExpr).None,
                    true => fn_kw_args.get(usize(0))
                  )
                )
              )
            )
          )
        )
      )
    )
  )
);
lambda_body_expr :: (fn(expr : AstExpr) -> Option(AstExpr))(
  match(
    expr,
    .Atom(_, _) => Option(AstExpr).None,
    .FnCall(_, lambda_fn_box, lambda_args, lambda_infix, _) => cond(
      // Normal lambda: `params => body` or `params -> body` (infix form, 2 args)
      (lambda_infix && (lambda_args.len() == usize(2))) => match(
        lambda_fn_box.*,
        .FnCall(_, _, _, _, _) => Option(AstExpr).None,
        .Atom(_, lambda_tok) => cond(
          !((lambda_tok.value == "->") || (lambda_tok.value == "=>")) =>
            Option(AstExpr).None,
          true => match(
            lambda_args.get(usize(1)),
            .None => Option(AstExpr).None,
            .Some(body_expr) => Option(AstExpr).Some(body_expr)
          )
        )
      ),
      // Typed lambda: `(fn(a : T) -> RetType)(body)` (non-infix, 1 arg, fn box is `->` infix)
      ((!(lambda_infix)) && (lambda_args.len() == usize(1))) => match(
        typed_lambda_fn_box_params(lambda_fn_box.*),
        .None => Option(AstExpr).None,
        .Some(_) => lambda_args.get(usize(0))
      ),
      true => Option(AstExpr).None
    )
  )
);
/// Extract the params expression from a `(params) => body` or `(params) -> body` lambda,
/// or from a typed lambda `(fn(a : T) -> RetType)(body)`.
/// Returns the first argument (the params) of the `=>` / `->` infix expression.
lambda_params_expr :: (fn(expr : AstExpr) -> Option(AstExpr))(
  match(
    expr,
    .Atom(_, _) => Option(AstExpr).None,
    .FnCall(_, lambda_fn_box, lambda_args, lambda_infix, _) => cond(
      // Normal lambda: `params => body` or `params -> body` (infix form, 2 args)
      (lambda_infix && (lambda_args.len() == usize(2))) => match(
        lambda_fn_box.*,
        .FnCall(_, _, _, _, _) => Option(AstExpr).None,
        .Atom(_, lambda_tok) => cond(
          !((lambda_tok.value == "->") || (lambda_tok.value == "=>")) =>
            Option(AstExpr).None,
          true => match(
            lambda_args.get(usize(0)),
            .None => Option(AstExpr).None,
            .Some(params_expr) => Option(AstExpr).Some(params_expr)
          )
        )
      ),
      // Typed lambda: `(fn(a : T) -> RetType)(body)` (non-infix, 1 arg, fn box is `->` infix)
      ((!(lambda_infix)) && (lambda_args.len() == usize(1))) => match(
        typed_lambda_fn_box_params(lambda_fn_box.*),
        .None => Option(AstExpr).None,
        .Some(single_param_e) => Option(AstExpr).Some(single_param_e)
      ),
      true => Option(AstExpr).None
    )
  )
);
/// Extract a single parameter name from a lambda params expression.
/// Handles: bare identifier `x`, and typed param `x : T`.
lambda_single_param_name :: (fn(params_expr : AstExpr) -> Option(String))(
  match(
    params_expr,
    .Atom(_, ptok) => cond(
      (ptok.kind == TokenKind.Identifier) => Option(String).Some(sanitize_c_ident(ptok.value.as_str())),
      true => Option(String).None
    ),
    .FnCall(_, op_box, pargs, pinfix, _) => cond(
      (!(pinfix)) => Option(String).None,
      (pargs.len() != usize(2)) => Option(String).None,
      true => match(
        op_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, op_tok) => cond(
          (op_tok.value != ":") => Option(String).None,
          true => match(
            pargs.get(usize(0)),
            .None => Option(String).None,
            .Some(name_expr) => match(
              name_expr,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, name_tok) => cond(
                (name_tok.kind == TokenKind.Identifier) =>
                  Option(String).Some(sanitize_c_ident(name_tok.value.as_str())),
                true => Option(String).None
              )
            )
          )
        )
      )
    )
  )
);
dyn_lambda_body_expr :: (fn(expr : AstExpr) -> Option(AstExpr))(
  match(
    expr,
    .Atom(_, _) => Option(AstExpr).None,
    .FnCall(_, dyn_fn_box, dyn_args, dyn_infix, _) => cond(
      dyn_infix => Option(AstExpr).None,
      (dyn_args.len() != usize(1)) => Option(AstExpr).None,
      true => match(
        dyn_fn_box.*,
        .FnCall(_, _, _, _, _) => Option(AstExpr).None,
        .Atom(_, dyn_tok) => cond(
          (dyn_tok.value != "dyn") => Option(AstExpr).None,
          true => match(
            dyn_args.get(usize(0)),
            .None => Option(AstExpr).None,
            .Some(dyn_inner_expr) => match(
              lambda_body_expr(dyn_inner_expr),
              .Some(body_expr) => Option(AstExpr).Some(body_expr),
              .None => match(
                dyn_inner_expr,
                .Atom(_, _) => Option(AstExpr).None,
                .FnCall(_, box_fn_box, box_args, box_infix, _) => cond(
                  box_infix => Option(AstExpr).None,
                  (box_args.len() != usize(1)) => Option(AstExpr).None,
                  true => match(
                    box_fn_box.*,
                    .FnCall(_, _, _, _, _) => Option(AstExpr).None,
                    .Atom(_, box_tok) => cond(
                      (box_tok.value != "box") => Option(AstExpr).None,
                      true => match(
                        box_args.get(usize(0)),
                        .None => Option(AstExpr).None,
                        .Some(boxed_lambda_expr) => lambda_body_expr(boxed_lambda_expr)
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
);
emit_simple_closure_value :: (
  fn(
    var_name : str,
    body_expr : AstExpr,
    param_name : str,
    ctx : CodegenContext,
    indent : String,
    env_is_ptr : bool
  ) -> bool
)(
  match(
    simple_closure_capture_from_body_or_cond(body_expr, param_name),
    .None => false,
    .Some(capture_name) => {
      san_var := sanitize_c_ident(var_name);
      san_capture := sanitize_c_ident(capture_name.as_str());
      env_type := String.from("__yo_closure_env_");
      env_type.push_string(san_var);
      capture_by_ref := match(
        ctx.get_var_type(capture_name.as_str()),
        .None => false,
        .Some(capture_ty) => match(
          ctx.get_struct_fields(capture_ty.as_str()),
          .None => false,
          .Some(fields_csv) => (fields_csv == "_0")
        )
      );
      ctx.emitter.emit_string(indent);
      ctx.emitter.emit("typedef struct { __typeof__(");
      if(capture_by_ref, {
        ctx.emitter.emit("&");
      });
      ctx.emitter.emit_string(san_capture);
      ctx.emitter.emit(") ");
      ctx.emitter.emit_string(san_capture);
      ctx.emitter.emit("; } ");
      ctx.emitter.emit_string(env_type);
      ctx.emitter.emit_line(";");
      ctx.emitter.emit_string(indent);
      if(env_is_ptr, {
        storage_name := String.from("__yo_closure_storage_");
        storage_name.push_string(san_var);
        ctx.emitter.emit_string(env_type);
        ctx.emitter.emit(" ");
        ctx.emitter.emit_string(storage_name);
        ctx.emitter.emit(" = { .");
        ctx.emitter.emit_string(san_capture);
        ctx.emitter.emit(" = ");
        if(capture_by_ref, {
          ctx.emitter.emit("&");
        });
        ctx.emitter.emit_string(san_capture);
        ctx.emitter.emit_line(" };");
        ctx.emitter.emit_string(indent);
        ctx.emitter.emit_string(env_type);
        ctx.emitter.emit("* ");
        ctx.emitter.emit_string(san_var);
        ctx.emitter.emit(" = &");
        ctx.emitter.emit_string(storage_name);
        ctx.emitter.emit_line(";");
        ctx.register_var_type(var_name, "__yo_closure_env_ptr");
      }, {
        ctx.emitter.emit_string(env_type);
        ctx.emitter.emit(" ");
        ctx.emitter.emit_string(san_var);
        ctx.emitter.emit(" = { .");
        ctx.emitter.emit_string(san_capture);
        ctx.emitter.emit(" = ");
        if(capture_by_ref, {
          ctx.emitter.emit("&");
        });
        ctx.emitter.emit_string(san_capture);
        ctx.emitter.emit_line(" };");
      });
      ctx.register_simple_closure_var(var_name, capture_name.as_str(), param_name);
      true
    }
  )
);
capture_access_for_closure_var :: (
  fn(
    closure_var_name : str,
    capture_name : str,
    ctx : CodegenContext
  ) -> String
)({
  san_var := sanitize_c_ident(closure_var_name);
  san_capture := sanitize_c_ident(capture_name);
  result := String.from(san_var.as_str());
  closure_is_env_ptr := match(
    ctx.get_var_type(closure_var_name),
    .None => false,
    .Some(closure_ty) => (closure_ty == "__yo_closure_env_ptr")
  );
  if(closure_is_env_ptr, {
    result.push_str("->");
  }, {
    result.push_str(".");
  });
  result.push_string(san_capture);
  should_use_payload := match(
    ctx.get_var_type(capture_name),
    .None => false,
    .Some(capture_ty) => match(
      ctx.get_struct_fields(capture_ty.as_str()),
      .None => false,
      .Some(fields_csv) => (fields_csv == "_0")
    )
  );
  if(should_use_payload, {
    result.push_str("->_0");
  });
  result
});
emit_simple_closure_constructor :: (
  fn(
    var_name : str,
    rhs_expr : AstExpr,
    ctx : CodegenContext,
    indent : String
  ) -> bool
)(
  match(
    rhs_expr,
    .Atom(_, _) => false,
    .FnCall(_, ctor_fn_box, ctor_args, ctor_infix, _) => cond(
      ctor_infix => false,
      (ctor_args.len() != usize(1)) => false,
      true => match(
        ctor_fn_box.*,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, ctor_tok) => match(
          ctx.get_closure_alias_param_name(ctor_tok.value.as_str()),
          .None => false,
          .Some(param_name) => match(
            ctor_args.get(usize(0)),
            .None => false,
            .Some(body_expr) =>
              emit_simple_closure_value(var_name, body_expr, param_name.as_str(), ctx, indent, false)
          )
        )
      )
    )
  )
);
/// Handle variable definition `name := val` → emit `__auto_type name = val;\n` as a
/// statement and return `"0"` (the unit sentinel).
///
/// Uses `__auto_type` (GCC/Clang extension) for type inference, avoiding the need
/// to know the type at this phase.
handle_define :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  lhs_opt := args.get(usize(0));
  rhs_opt := args.get(usize(1));
  match(lhs_opt,.None => Option(String).None,.Some(lhs_expr) => match(
    rhs_opt,
    .None => Option(String).None,
    .Some(rhs_expr) => match(
      lhs_expr,
      // Simple: x := val — auto-type variable declaration
      .Atom(_, name_tok) => {
        // Check if RHS is a labeled anon struct `{ field: val, ... }`.
        // If so, track the field names so `open name` can emit field bindings.
        rhs_labeled_fields_opt := match(
          rhs_expr,
          .Atom(_, _) => Option(String).None,
          .FnCall(_, rf_box, rf_args, rf_infix, _) => cond(
            rf_infix => Option(String).None,
            (!(rf_args.len() > usize(0))) => Option(String).None,
            true => match(
              rf_box.*,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, rftok) => cond(
                (!(rftok.value == BK_ANON_STRUCT)) => Option(String).None,
                true => {
                  csv_buf := String.new();
                  n_rf := rf_args.len();
                  (rf_i : usize) = usize(0);
                  (all_ok : bool) = true;
                  while((rf_i < n_rf) && all_ok, {
                    match(
                      rf_args.get(rf_i),
                      .None => {
                        all_ok = false;
                      },
                      .Some(rf_arg) => match(
                        rf_arg,
                        .Atom(_, ratom) => {
                          if(rf_i > usize(0), {
                            csv_buf.push_str(",");
                          });
                          csv_buf.push_string(ratom.value);
                        },
                        .FnCall(_, rf_ff, rf_fa, rf_finfix, _) => {
                          is_lbl := (
                            (rf_finfix && (rf_fa.len() == usize(2))) && match(
                              rf_ff.*,
                              .Atom(_, rf_ftok) => (rf_ftok.value == ":"),
                              .FnCall(_, _, _, _, _) => false
                            )
                          );
                          cond(
                            (!(is_lbl)) => {
                              all_ok = false;
                            },
                            true => match(
                              rf_fa.get(usize(0)),
                              .None => {
                                all_ok = false;
                              },
                              .Some(rf_name_e) => match(
                                rf_name_e,
                                .FnCall(_, _, _, _, _) => {
                                  all_ok = false;
                                },
                                .Atom(_, rf_natom) => {
                                  if(rf_i > usize(0), {
                                    csv_buf.push_str(",");
                                  });
                                  csv_buf.push_string(rf_natom.value);
                                }
                              )
                            )
                          );
                        }
                      )
                    );
                    rf_i = (rf_i + usize(1));
                  });
                  cond(
                    ((!(all_ok)) || (csv_buf.len() == usize(0))) => Option(String).None,
                    true => Option(String).Some(csv_buf)
                  )
                }
              )
            )
          )
        );
        match(
          rhs_labeled_fields_opt,
          .None => {
            // Also track named struct constructor calls `name := StructType(args)` so
            // that spread destructuring `{f: v, ...} := name` can resolve remaining fields.
            match(
              rhs_expr,
              .Atom(_, _) => (),
              .FnCall(_, sc_fn_box, _, sc_fn_infix, _) => cond(
                sc_fn_infix => (),
                true => match(
                  sc_fn_box.*,
                  .FnCall(_, _, _, _, _) => (),
                  .Atom(_, sctok) => match(
                    ctx.get_struct_fields(sctok.value.as_str()),
                    .None => (),
                    .Some(sfields) => {
                      ctx.track_open_var(name_tok.value.as_str(), sfields.as_str());
                    }
                  )
                )
              )
            );
          },
          .Some(csv_s) => {
            ctx.track_open_var(name_tok.value.as_str(), csv_s.as_str());
          }
        );
        discard_binding_emitted := cond(
          (name_tok.value == "_") => match(
            call_gen_expr(rhs_expr, ctx, indent),
            .None => false,
            .Some(discard_code) => {
              if(discard_code != "0", {
                emit_as_stmt(discard_code, ctx, indent);
              });
              true
            }
          ),
          true => false
        );
        anon_struct_constructor_emitted := cond(
          discard_binding_emitted => false,
          true => match(
            rhs_expr,
            .Atom(_, _) => false,
            .FnCall(_, rhs_ctor_fn, rhs_ctor_args, rhs_ctor_infix, _) => cond(
              rhs_ctor_infix => false,
              true => match(
                rhs_ctor_fn.*,
                .Atom(_, _) => false,
                .FnCall(_, rhs_ty_fn, rhs_ty_args, rhs_ty_infix, _) => cond(
                  rhs_ty_infix => false,
                  true => match(
                    rhs_ty_fn.*,
                    .FnCall(_, _, _, _, _) => false,
                    .Atom(_, rhs_ty_tok) => cond(
                      (rhs_ty_tok.value != "struct") => false,
                      true => match(
                        anon_struct_type_to_c(rhs_ty_args),
                        .None => false,
                        .Some(anon_c_ty) => match(
                          anon_struct_initializer_to_c(rhs_ctor_args, ctx, indent),
                          .None => false,
                          .Some(init_c) => {
                            ctx.emitter.emit_string(indent);
                            ctx.emitter.emit_string(anon_c_ty);
                            ctx.emitter.emit(" ");
                            ctx.emitter.emit_string(sanitize_c_ident(name_tok.value.as_str()));
                            ctx.emitter.emit(" = ");
                            ctx.emitter.emit_string(init_c);
                            ctx.emitter.emit_line(";");
                            true
                          }
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        );
        assignment_value_emitted := cond(
          discard_binding_emitted => false,
          true => match(
            rhs_expr,
            .Atom(_, _) => false,
            .FnCall(_, asn_fn_box, asn_args, asn_infix, _) => cond(
              (!(asn_infix)) => false,
              (asn_args.len() != usize(2)) => false,
              true => match(
                asn_fn_box.*,
                .FnCall(_, _, _, _, _) => false,
                .Atom(_, asn_tok) => cond(
                  (asn_tok.value != "=") => false,
                  true => match(
                    asn_args.get(usize(0)),
                    .None => false,
                    .Some(assign_lhs) => match(
                      assign_lhs,
                      .FnCall(_, _, _, _, _) => false,
                      .Atom(_, assign_lhs_tok) => cond(
                        ctx.is_array_var(assign_lhs_tok.value.as_str()) => match(
                          ctx.get_array_var_size(assign_lhs_tok.value.as_str()),
                          .None => false,
                          .Some(array_sz) => {
                            san_src_array := sanitize_c_ident(assign_lhs_tok.value.as_str());
                            san_old_array := sanitize_c_ident(name_tok.value.as_str());
                            ctx.emitter.emit_string(indent);
                            ctx.emitter.emit("__typeof__(");
                            ctx.emitter.emit_string(san_src_array);
                            ctx.emitter.emit("[0]) ");
                            ctx.emitter.emit_string(san_old_array);
                            ctx.emitter.emit("[");
                            ctx.emitter.emit_string(array_sz);
                            ctx.emitter.emit_line("];");
                            ctx.emitter.emit_string(indent);
                            ctx.emitter.emit("memcpy(");
                            ctx.emitter.emit_string(san_old_array);
                            ctx.emitter.emit(", ");
                            ctx.emitter.emit_string(san_src_array);
                            ctx.emitter.emit(", sizeof(");
                            ctx.emitter.emit_string(san_old_array);
                            ctx.emitter.emit_line("));");
                            ctx.register_array_var_with_size(name_tok.value.as_str(), array_sz.as_str());
                            match(
                              call_gen_expr(rhs_expr, ctx, indent),
                              .None => (),
                              .Some(assign_code) => if(assign_code != "0", {
                                emit_as_stmt(assign_code, ctx, indent);
                              })
                            );
                            true
                          }
                        ),
                        true => {
                          ctx.emitter.emit_string(indent);
                          ctx.emitter.emit("__auto_type ");
                          ctx.emitter.emit_string(sanitize_c_ident(name_tok.value.as_str()));
                          ctx.emitter.emit(" = ");
                          ctx.emitter.emit_string(sanitize_c_ident(assign_lhs_tok.value.as_str()));
                          ctx.emitter.emit_line(";");
                          match(
                            call_gen_expr(rhs_expr, ctx, indent),
                            .None => (),
                            .Some(assign_code2) => if(assign_code2 != "0", {
                              emit_as_stmt(assign_code2, ctx, indent);
                            })
                          );
                          true
                        }
                      )
                    )
                  )
                )
              )
            )
          )
        );
        method_extraction_emitted := cond(
          discard_binding_emitted => false,
          true => emit_method_extraction_macro_if_supported(name_tok.value.as_str(), rhs_expr, ctx, indent)
        );
        simple_closure_emitted := cond(
          discard_binding_emitted => false,
          true => emit_simple_closure_constructor(name_tok.value.as_str(), rhs_expr, ctx, indent)
        );
        // Special case: `b := arr_var` where arr_var is a registered C array — array copy.
        // Emit `__typeof__(arr_var[0]) b[N]; memcpy(b, arr_var, sizeof(b));`
        // and register b as an array var with the same size.
        arr_copy_emitted := cond(
          discard_binding_emitted => false,
          true => match(
            rhs_expr,
            .FnCall(_, _, _, _, _) => false,
            .Atom(_, arr_cp_tok) => cond(
              (arr_cp_tok.kind != TokenKind.Identifier) => false,
              (!(ctx.is_array_var(arr_cp_tok.value.as_str()))) => false,
              true => match(
                ctx.get_array_var_size(arr_cp_tok.value.as_str()),
                .None => false,
                .Some(sz) => {
                  san_src := sanitize_c_ident(arr_cp_tok.value.as_str());
                  san_dst := sanitize_c_ident(name_tok.value.as_str());
                  ctx.emitter.emit_string(indent);
                  ctx.emitter.emit("__typeof__(");
                  ctx.emitter.emit_string(san_src);
                  ctx.emitter.emit("[0]) ");
                  ctx.emitter.emit_string(san_dst);
                  ctx.emitter.emit("[");
                  ctx.emitter.emit_string(sz);
                  ctx.emitter.emit_line("];");
                  ctx.emitter.emit_string(indent);
                  ctx.emitter.emit("memcpy(");
                  ctx.emitter.emit_string(san_dst);
                  ctx.emitter.emit(", ");
                  ctx.emitter.emit_string(san_src);
                  ctx.emitter.emit(", sizeof(");
                  ctx.emitter.emit_string(san_dst);
                  ctx.emitter.emit_line("));");
                  ctx.register_array_var_with_size(name_tok.value.as_str(), sz.as_str());
                  true
                }
              )
            )
          )
        );
        // Special case: `b := Array(T, N)()` or `b := Array(T, N)(v0, v1, ...)`.
        // Array type-constructor call: FnCall(FnCall(Atom("Array"), [T, N], false), args, false).
        // Emit `T_c b[N] = {v0, v1, ...};` (or `= {0}` for empty args).
        arr_constructor_emitted := cond(
          discard_binding_emitted => false,
          arr_copy_emitted => false,
          true => match(
            rhs_expr,
            .Atom(_, _) => false,
            .FnCall(_, ac_fn_box, ac_fn_args, ac_fn_infix, _) => cond(
              ac_fn_infix => false,
              true => match(
                ac_fn_box.*,
                .Atom(_, _) => false,
                .FnCall(_, ac_inner_fn, ac_inner_args, ac_inner_infix, _) => cond(
                  ac_inner_infix => false,
                  (ac_inner_args.len() != usize(2)) => false,
                  true => match(
                    ac_inner_fn.*,
                    .FnCall(_, _, _, _, _) => false,
                    .Atom(_, ac_name_tok) => cond(
                      (ac_name_tok.value != "Array") => false,
                      true => {
                        elem_c_opt := match(
                          ac_inner_args.get(usize(0)),
                          .None => Option(String).None,
                          .Some(e) => type_expr_to_c(e)
                        );
                        size_opt := match(
                          ac_inner_args.get(usize(1)),
                          .None => Option(String).None,
                          .Some(s) => match(
                            s,
                            .FnCall(_, _, _, _, _) => Option(String).None,
                            .Atom(_, stok) => cond(
                              (stok.kind == TokenKind.Integer) => Option(String).Some(stok.value),
                              (stok.kind == TokenKind.Identifier) => cond(
                                (stok.value == "_") => Option(String).Some(ac_fn_args.len().to_string()),
                                true => Option(String).Some(stok.value)
                              ),
                              true => Option(String).None
                            )
                          )
                        );
                        match(
                          elem_c_opt,
                          .None => false,
                          .Some(ec) => match(
                            size_opt,
                            .None => false,
                            .Some(sz) => {
                              san_dst2 := sanitize_c_ident(name_tok.value.as_str());
                              // Build initializer list from constructor args (or {0} if empty)
                              init_buf := cond(
                                (ac_fn_args.len() == usize(0)) => String.from("{0}"),
                                true => {
                                  ib := String.from("{");
                                  (ib_i : usize) = usize(0);
                                  (ib_ok : bool) = true;
                                  while((ib_i < ac_fn_args.len()) && ib_ok, {
                                    match(
                                      ac_fn_args.get(ib_i),
                                      .None => {
                                        ib_ok = false;
                                      },
                                      .Some(av) => match(
                                        call_gen_expr(av, ctx, indent),
                                        .None => {
                                          ib_ok = false;
                                        },
                                        .Some(avc) => {
                                          if(ib_i > usize(0), {
                                            ib.push_str(", ");
                                          });
                                          ib.push_string(avc);
                                          ib_i = (ib_i + usize(1));
                                        }
                                      )
                                    );
                                  });
                                  ib.push_str("}");
                                  ib
                                }
                              );
                              ctx.emitter.emit_string(indent);
                              ctx.emitter.emit_string(ec);
                              ctx.emitter.emit(" ");
                              ctx.emitter.emit_string(san_dst2);
                              ctx.emitter.emit("[");
                              ctx.emitter.emit_string(sz);
                              ctx.emitter.emit("] = ");
                              ctx.emitter.emit_string(init_buf);
                              ctx.emitter.emit_line(";");
                              ctx.register_array_var_with_size(name_tok.value.as_str(), sz.as_str());
                              true
                            }
                          )
                        )
                      }
                    )
                  )
                )
              )
            )
          )
        );
        // Special case: `b := [v0, v1, v2]` — inline array literal.
        // `array` FnCall: FnCall(Atom("array"), [v0, v1, ...], false).
        // Emit `__typeof__(v0) b[N] = {v0, v1, ...};` using first element type via __typeof__.
        inline_array_emitted := cond(
          discard_binding_emitted => false,
          true => match(
            rhs_expr,
            .Atom(_, _) => false,
            .FnCall(_, il_fn_box, il_fn_args, il_fn_infix, _) => cond(
              il_fn_infix => false,
              (il_fn_args.len() == usize(0)) => false,
              true => match(
                il_fn_box.*,
                .FnCall(_, _, _, _, _) => false,
                .Atom(_, il_fn_tok) => cond(
                  (il_fn_tok.value != "array") => false,
                  true => {
                    n_il := il_fn_args.len();
                    // Generate all element expressions
                    init_il := String.from("{");
                    (il_i : usize) = usize(0);
                    (il_ok : bool) = true;
                    while((il_i < n_il) && il_ok, {
                      match(
                        il_fn_args.get(il_i),
                        .None => {
                          il_ok = false;
                        },
                        .Some(il_e) => match(
                          call_gen_expr(il_e, ctx, indent),
                          .None => {
                            il_ok = false;
                          },
                          .Some(il_c) => {
                            if(il_i > usize(0), {
                              init_il.push_str(", ");
                            });
                            init_il.push_string(il_c);
                            il_i = (il_i + usize(1));
                          }
                        )
                      );
                    });
                    cond(
                      (!(il_ok)) => false,
                      true => {
                        init_il.push_str("}");
                        // Emit: `__typeof__(v0) name[N] = {v0, v1, ...};`
                        // We regenerate first element for __typeof__ — or use
                        // the already-generated init_il[0] via a compound literal.
                        first_code_opt := match(
                          il_fn_args.get(usize(0)),
                          .None => Option(String).None,
                          .Some(fe) => call_gen_expr(fe, ctx, indent)
                        );
                        match(
                          first_code_opt,
                          .None => false,
                          .Some(first_c) => {
                            san_name := sanitize_c_ident(name_tok.value.as_str());
                            ctx.emitter.emit_string(indent);
                            ctx.emitter.emit("__typeof__(");
                            ctx.emitter.emit_string(first_c);
                            ctx.emitter.emit(") ");
                            ctx.emitter.emit_string(san_name);
                            ctx.emitter.emit("[");
                            ctx.emitter.emit_string(n_il.to_string());
                            ctx.emitter.emit("] = ");
                            ctx.emitter.emit_string(init_il);
                            ctx.emitter.emit_line(";");
                            ctx.register_array_var_with_size(name_tok.value.as_str(), n_il.to_string().as_str());
                            true
                          }
                        )
                      }
                    )
                  }
                )
              )
            )
          )
        );
        // Special case: `b := ArrayAlias(v0, v1, ...)` where `ArrayAlias :: [T; N]`.
        // Emit `elem_type b[N] = {v0, v1, ...};` instead of `__auto_type b = ...`.
        array_decl_emitted := cond(
          discard_binding_emitted => false,
          inline_array_emitted => true,
          true => match(
            rhs_expr,
            .Atom(_, _) => false,
            .FnCall(_, arr_fn_box, arr_fn_args, arr_fn_infix, _) => cond(
              arr_fn_infix => false,
              true => match(
                arr_fn_box.*,
                .FnCall(_, _, _, _, _) => false,
                .Atom(_, arr_fn_tok) => cond(
                  (arr_fn_tok.kind != TokenKind.Identifier) => false,
                  true => match(
                    ctx.get_array_alias_elem(arr_fn_tok.value.as_str()),
                    .None => false,
                    .Some(elem_c) => match(
                      ctx.get_array_alias_size(arr_fn_tok.value.as_str()),
                      .None => false,
                      .Some(arr_sz) => {
                        // Build initializer list `{v0, v1, ...}`
                        init_buf := String.from("{");
                        n_av := arr_fn_args.len();
                        (av_i : usize) = usize(0);
                        (av_ok : bool) = true;
                        while((av_i < n_av) && av_ok, {
                          match(
                            arr_fn_args.get(av_i),
                            .None => {
                              av_ok = false;
                            },
                            .Some(av_e) => match(
                              call_gen_expr(av_e, ctx, indent),
                              .None => {
                                av_ok = false;
                              },
                              .Some(av_c) => {
                                if(av_i > usize(0), {
                                  init_buf.push_str(", ");
                                });
                                init_buf.push_string(av_c);
                                av_i = (av_i + usize(1));
                              }
                            )
                          );
                        });
                        cond(
                          (!(av_ok)) => false,
                          true => {
                            init_buf.push_str("}");
                            // Emit: `elem_type name[N] = {v0, v1, ...};`
                            ctx.emitter.emit_string(indent);
                            ctx.emitter.emit_string(elem_c);
                            ctx.emitter.emit(" ");
                            ctx.emitter.emit_string(sanitize_c_ident(name_tok.value.as_str()));
                            ctx.emitter.emit("[");
                            ctx.emitter.emit_string(arr_sz.to_string());
                            ctx.emitter.emit("] = ");
                            ctx.emitter.emit_string(init_buf);
                            ctx.emitter.emit_line(";");
                            // Register as C array variable so arr(idx) → arr[idx]
                            ctx.register_array_var_with_size(name_tok.value.as_str(), arr_sz.to_string().as_str());
                            true
                          }
                        )
                      }
                    )
                  )
                )
              )
            )
          );
          cond(
            discard_binding_emitted => Option(String).Some(String.from("0")),
            (anon_struct_constructor_emitted || (assignment_value_emitted || (method_extraction_emitted || (simple_closure_emitted || (arr_copy_emitted || arr_constructor_emitted))))) =>
              Option(String).Some(String.from("0")),
            array_decl_emitted => Option(String).Some(String.from("0")),
            true => match(
              call_gen_expr(rhs_expr, ctx, indent),
              .None => Option(String).None,
              .Some(rhs_code) => {
                ctx.emitter.emit_string(indent);
                ctx.emitter.emit("__auto_type ");
                san_def_name := sanitize_c_ident(name_tok.value.as_str());
                ctx.emitter.emit_string(san_def_name);
                ctx.emitter.emit(" = ");
                ctx.emitter.emit_string(rhs_code);
                ctx.emitter.emit_line(";");
                match(
                  rhs_expr,
                  .FnCall(_, _, _, _, _) => (),
                  .Atom(_, rhs_atom_tok) => match(
                    ctx.get_simple_closure_capture_name(rhs_atom_tok.value.as_str()),
                    .None => (),
                    .Some(copy_capture_name) => match(
                      ctx.get_simple_closure_param_name(rhs_atom_tok.value.as_str()),
                      .None => (),
                      .Some(copy_param_name) => ctx.register_simple_closure_var(
                        name_tok.value.as_str(),
                        copy_capture_name.as_str(),
                        copy_param_name.as_str()
                      )
                    )
                  )
                );
                match(
                  rhs_expr,
                  .FnCall(_, _, _, _, _) => (),
                  .Atom(_, rhs_atom_tok2) => match(
                    ctx.get_var_type(rhs_atom_tok2.value.as_str()),
                    .None => (),
                    .Some(rhs_var_ty) => if(rhs_var_ty == "__yo_closure_env_ptr", {
                      ctx.register_var_type(name_tok.value.as_str(), "__yo_closure_env_ptr");
                    })
                  )
                );
                // Track numeric/bool literal types so `to_string()` can emit proper conversions.
                match(
                  rhs_expr,
                  .FnCall(_, _, _, _, _) => (),
                  .Atom(_, rhs_lit_tok) => cond(
                    (rhs_lit_tok.kind == TokenKind.Integer) =>
                      ctx.register_var_type(name_tok.value.as_str(), "int64_t"),
                    (rhs_lit_tok.kind == TokenKind.Float) =>
                      ctx.register_var_type(name_tok.value.as_str(), "double"),
                    ((rhs_lit_tok.kind == TokenKind.Bool) || ((rhs_lit_tok.value == "true") || (rhs_lit_tok.value == "false"))) =>
                      ctx.register_var_type(name_tok.value.as_str(), "bool"),
                    true => ()
                  )
                );
                // Track const char* for string-producing RHS (string literals, __yo_ helpers, propagation).
                rhs_is_cstr := (rhs_code.starts_with(String.from("\"")) || (rhs_code.contains(String.from("__yo_int_to_str(")) || (rhs_code.contains(String.from("__yo_uint_to_str(")) || (rhs_code.contains(String.from("__yo_float_to_str(")) || (rhs_code.contains(String.from("__yo_bool_to_str(")) || rhs_code.contains(String.from("__yo_str_concat(")))))));
                if(rhs_is_cstr, {
                  ctx.register_var_type(name_tok.value.as_str(), "const char*");
                });
                if(!(rhs_is_cstr), {
                  match(
                    ctx.get_var_type(rhs_code.as_str()),
                    .None => (),
                    .Some(rhs_prop_ty) => if(rhs_prop_ty == "const char*", {
                      ctx.register_var_type(name_tok.value.as_str(), "const char*");
                    })
                  );
                });
                // Track numeric type-cast patterns: i32(x) → (int32_t)(x).
                // This allows closure params (e.g., in .map()) to infer their type
                // from the receiver variable's tracked type for to_string() dispatch.
                if(!(rhs_is_cstr), {
                  cond(
                    rhs_code.starts_with(String.from("(int32_t)(")) =>
                      ctx.register_var_type(name_tok.value.as_str(), "int32_t"),
                    rhs_code.starts_with(String.from("(int64_t)(")) =>
                      ctx.register_var_type(name_tok.value.as_str(), "int64_t"),
                    rhs_code.starts_with(String.from("(uint32_t)(")) =>
                      ctx.register_var_type(name_tok.value.as_str(), "uint32_t"),
                    rhs_code.starts_with(String.from("(uint64_t)(")) =>
                      ctx.register_var_type(name_tok.value.as_str(), "uint64_t"),
                    rhs_code.starts_with(String.from("(double)(")) =>
                      ctx.register_var_type(name_tok.value.as_str(), "double"),
                    rhs_code.starts_with(String.from("(float)(")) =>
                      ctx.register_var_type(name_tok.value.as_str(), "float"),
                    rhs_code.starts_with(String.from("(bool)(")) =>
                      ctx.register_var_type(name_tok.value.as_str(), "bool"),
                    rhs_code.starts_with(String.from("(int8_t)(")) =>
                      ctx.register_var_type(name_tok.value.as_str(), "int8_t"),
                    rhs_code.starts_with(String.from("(int16_t)(")) =>
                      ctx.register_var_type(name_tok.value.as_str(), "int16_t"),
                    rhs_code.starts_with(String.from("(uint8_t)(")) =>
                      ctx.register_var_type(name_tok.value.as_str(), "uint8_t"),
                    rhs_code.starts_with(String.from("(uint16_t)(")) =>
                      ctx.register_var_type(name_tok.value.as_str(), "uint16_t"),
                    rhs_code.starts_with(String.from("(isize)(")) =>
                      ctx.register_var_type(name_tok.value.as_str(), "isize"),
                    rhs_code.starts_with(String.from("(size_t)(")) =>
                      ctx.register_var_type(name_tok.value.as_str(), "size_t"),
                    true => ()
                  );
                });
                // Track compound-literal-typed RHS: `(T){...}` lowering used by
                // bootstrap ArrayList(T)/Deque(T)/HashMap(K,V)/etc. constructors.
                // Register the LHS with the concrete C type T so method dispatch
                // (e.g. list.push, list.len) finds the proper helper instead of
                // falling through to `strlen(list)` style catch-alls.
                if(!(rhs_is_cstr), {
                  if(rhs_code.starts_with(String.from("(")), {
                    close_paren_brace := rhs_code.index_of(String.from("){"), usize(0));
                    match(
                      close_paren_brace,
                      .None => (),
                      .Some(cpb_idx) => {
                        compound_c_ty := rhs_code.substring(usize(1), cpb_idx);
                        if(is_compound_aggregate_c_type(compound_c_ty.as_str()), {
                          ctx.register_var_type(name_tok.value.as_str(), compound_c_ty.as_str());
                        });
                      }
                    );
                  });
                });
                // If RHS was an array/slice range call, register LHS as slice var
                is_slice_rhs := match(
                  rhs_expr,
                  .Atom(_, _) => false,
                  .FnCall(_, def_rhs_fn, def_rhs_args, def_rhs_infix, _) => cond(
                    def_rhs_infix => false,
                    (def_rhs_args.len() != usize(1)) => false,
                    true => match(
                      def_rhs_fn.*,
                      .FnCall(_, _, _, _, _) => false,
                      .Atom(_, def_rhs_tok) => cond(
                        (!(ctx.is_array_var(def_rhs_tok.value.as_str()) || ctx.is_slice_var(def_rhs_tok.value.as_str()))) => false,
                        true => match(
                          def_rhs_args.get(usize(0)),
                          .None => false,
                          .Some(range_arg) => match(
                            range_arg,
                            .Atom(_, _) => false,
                            .FnCall(_, range_fn2, range_args2, range_infix2, _) => cond(
                              (!(range_infix2 && (range_args2.len() == usize(2)))) => false,
                              true => match(
                                range_fn2.*,
                                .FnCall(_, _, _, _, _) => false,
                                .Atom(_, rtok2) => ((rtok2.value == "..") || (rtok2.value == "..="))
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                );
                if(is_slice_rhs, {
                  ctx.register_slice_var(name_tok.value.as_str());
                });
                if(is_slice_u8_from_raw_parts_call(rhs_expr), {
                  ctx.register_slice_var(name_tok.value.as_str());
                  ctx.register_var_type(name_tok.value.as_str(), "YoSlice_u8");
                });
                // If RHS is a `box(...)` call, register LHS as a box var for deref equality.
                is_box_rhs := match(
                  rhs_expr,
                  .Atom(_, _) => false,
                  .FnCall(_, box_fn, _box_args, box_infix, _) => cond(
                    box_infix => false,
                    true => match(
                      box_fn.*,
                      .FnCall(_, _, _, _, _) => false,
                      .Atom(_, box_tok) => (box_tok.value == "box")
                    )
                  )
                );
                if(is_box_rhs, {
                  ctx.register_box_var(name_tok.value.as_str());
                });
                match(
                  box_constructor_elem_c_type(rhs_expr),
                  .None => (),
                  .Some(box_elem_ty) => {
                    box_ptr_ty := String.from(box_elem_ty.as_str());
                    box_ptr_ty.push_str("*");
                    ctx.register_var_type(name_tok.value.as_str(), box_ptr_ty.as_str());
                    ctx.register_box_var(name_tok.value.as_str());
                  }
                );
                // If RHS is a struct/enum constructor call, track LHS variable's type
                // so that `(&var).to_string()` dispatch can find the type name.
                rhs_ctor_type := match(
                  rhs_expr,
                  .Atom(_, _) => Option(String).None,
                  .FnCall(_, def_rhs_fn, def_rhs_ctor_args, def_rhs_infix2, _) => cond(
                    // Non-infix: struct constructor `TypeName(...)` or enum `EnumName.Variant(...)`
                    (!(def_rhs_infix2)) => match(
                      def_rhs_fn.*,
                      // Plain constructor: `TypeName(...)` — fn is Atom
                      .Atom(_, def_rhs_ctok) => {
                        ctor_name := def_rhs_ctok.value.as_str();
                        cond(
                          (ctx.is_struct_name(ctor_name) || ctx.is_enum_name(ctor_name)) =>
                            Option(String).Some(String.from(ctor_name)),
                          true => Option(String).None
                        )
                      },
                      // Complex enum constructor: `EnumName.Variant(...)` — fn is dot-access FnCall
                      .FnCall(_, inner_fn, inner_args, inner_infix, _) => cond(
                        (!(inner_infix)) => Option(String).None,
                        (inner_args.len() != usize(2)) => Option(String).None,
                        true => match(
                          inner_fn.*,
                          .FnCall(_, _, _, _, _) => Option(String).None,
                          .Atom(_, dot_tok) => cond(
                            (dot_tok.value != ".") => Option(String).None,
                            true => match(
                              inner_args.get(usize(0)),
                              .None => Option(String).None,
                              .Some(en_e) => match(
                                en_e,
                                .FnCall(_, _, _, _, _) => Option(String).None,
                                .Atom(_, etok2) => cond(
                                  (ctx.is_enum_name(etok2.value.as_str())) =>
                                    Option(String).Some(etok2.value),
                                  true => Option(String).None
                                )
                              )
                            )
                          )
                        )
                      )
                    ),
                    // Infix dot: `EnumName.Variant` (no args) → type is `EnumName`
                    true => cond(
                      (def_rhs_ctor_args.len() != usize(2)) => Option(String).None,
                      true => match(
                        def_rhs_fn.*,
                        .FnCall(_, _, _, _, _) => Option(String).None,
                        .Atom(_, def_rhs_dot_tok) => cond(
                          (def_rhs_dot_tok.value != ".") => Option(String).None,
                          true => match(
                            def_rhs_ctor_args.get(usize(0)),
                            .None => Option(String).None,
                            .Some(lhs_e) => match(
                              lhs_e,
                              .FnCall(_, _, _, _, _) => Option(String).None,
                              .Atom(_, etok) => cond(
                                (ctx.is_enum_name(etok.value.as_str())) =>
                                  Option(String).Some(etok.value),
                                true => Option(String).None
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                );
                match(
                  rhs_ctor_type,
                  .None => {
                    // Also propagate type for `v2 := (&v1).clone()` or `v2 := v1.clone()`
                    // by detecting clone() method calls and copying the source var's type.
                    // If the RHS is a dot-method call with 0 args, extract the receiver var name.
                    clone_recv_var := match(
                      rhs_expr,
                      .Atom(_, _) => Option(String).None,
                      .FnCall(_, dot_box, dot_args, dot_infix, _) => cond(
                        dot_infix => Option(String).None,
                        (dot_args.len() != usize(0)) => Option(String).None,
                        true => match(
                          dot_box.*,
                          .Atom(_, _) => Option(String).None,
                          .FnCall(_, dot_fn2, dot_args2, dot_infix2, _) => cond(
                            (!(dot_infix2)) => Option(String).None,
                            (dot_args2.len() != usize(2)) => Option(String).None,
                            true => match(
                              dot_fn2.*,
                              .FnCall(_, _, _, _, _) => Option(String).None,
                              .Atom(_, dot_tok2) => cond(
                                (dot_tok2.value != ".") => Option(String).None,
                                true => match(
                                  dot_args2.get(usize(1)),
                                  .None => Option(String).None,
                                  .Some(mname_e) => match(
                                    mname_e,
                                    .FnCall(_, _, _, _, _) => Option(String).None,
                                    .Atom(_, mname_tok) => cond(
                                      (mname_tok.value != "clone") => Option(String).None,
                                      true => match(
                                        dot_args2.get(usize(0)),
                                        .None => Option(String).None,
                                        // Direct receiver: `v1.clone()` → receiver var is "v1"
                                        .Some(recv_e) => match(
                                          recv_e,
                                          .Atom(_, recv_tok) => cond(
                                            (recv_tok.kind != TokenKind.Identifier) => Option(String).None,
                                            true => Option(String).Some(recv_tok.value)
                                          ),
                                          // Ref receiver: `(&v1).clone()` → unwrap the `&`
                                          .FnCall(_, ref_fn3, ref_args3, ref_infix3, _) => cond(
                                            ref_infix3 => Option(String).None,
                                            (ref_args3.len() != usize(1)) => Option(String).None,
                                            true => match(
                                              ref_fn3.*,
                                              .FnCall(_, _, _, _, _) => Option(String).None,
                                              .Atom(_, ref_tok3) => cond(
                                                (ref_tok3.value != "&") => Option(String).None,
                                                true => match(
                                                  ref_args3.get(usize(0)),
                                                  .None => Option(String).None,
                                                  .Some(rv3) => match(
                                                    rv3,
                                                    .FnCall(_, _, _, _, _) => Option(String).None,
                                                    .Atom(_, rvtok3) => cond(
                                                      (rvtok3.kind != TokenKind.Identifier) => Option(String).None,
                                                      true => Option(String).Some(rvtok3.value)
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    );
                    // Propagate type from the clone source var to the define target
                    match(
                      clone_recv_var,
                      .None => {
                        match(
                          generic_struct_constructor_type_from_call(rhs_expr, ctx),
                          .Some(generic_struct_ctor_ty) => {
                            ctx.register_var_type(name_tok.value.as_str(), generic_struct_ctor_ty.as_str());
                          },
                          .None => match(
                            generic_static_constructor_type_from_call(rhs_expr),
                            .Some(generic_ctor_ty) => {
                              ctx.register_var_type(name_tok.value.as_str(), generic_ctor_ty.as_str());
                            },
                            .None => {
                              fn_return_ty := match(
                                rhs_expr,
                                .Atom(_, _) => Option(String).None,
                                .FnCall(_, ret_fn_box, _ret_args, ret_infix, _) => cond(
                                  ret_infix => Option(String).None,
                                  true => match(
                                    ret_fn_box.*,
                                    .FnCall(_, _, _, _, _) => Option(String).None,
                                    .Atom(_, ret_fn_tok) => ctx.get_fn_return_type(ret_fn_tok.value.as_str())
                                  )
                                )
                              );
                              match(
                                fn_return_ty,
                                .None => (),
                                .Some(ret_ty_name) => {
                                  ctx.register_var_type(name_tok.value.as_str(), ret_ty_name.as_str());
                                }
                              )
                            }
                          )
                        );
                      },
                      .Some(src_var) => match(
                        ctx.get_var_type(src_var.as_str()),
                        .None => (),
                        .Some(src_ty) => {
                          ctx.register_var_type(name_tok.value.as_str(), src_ty.as_str());
                        }
                      )
                    );
                  },
                  .Some(ctor_ty) => {
                    ctx.register_var_type(name_tok.value.as_str(), ctor_ty.as_str());
                  }
                );
                Option(String).Some(String.from("0"))
              }
            )
          )
        },
        // Destructuring: (a, b, c) := rhs  OR  {x, y} := rhs  OR  {x: a, y: b} := rhs
        // Also handles: name := rhs — emit as regular define of inner name.
        .FnCall(_, destr_func, destr_args, destr_infix, _) => cond(
          // Single-field struct destructuring `{ x : alias } := rhs` can parse as
          // the bare infix `x : alias` rather than an anonymous-struct wrapper.
          destr_infix => match(
            destr_func.*,
            .FnCall(_, _, _, _, _) => Option(String).None,
            .Atom(_, single_field_tok) => cond(
              ((single_field_tok.value == ":") && (destr_args.len() == usize(2))) => match(
                destr_args.get(usize(0)),
                .None => Option(String).None,
                .Some(single_field_e) => match(
                  single_field_e,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, single_field_name) => match(
                    destr_args.get(usize(1)),
                    .None => Option(String).None,
                    .Some(single_var_e) => match(
                      single_var_e,
                      .FnCall(_, _, _, _, _) => Option(String).None,
                      .Atom(_, single_var_name) => match(
                        call_gen_expr(rhs_expr, ctx, indent),
                        .None => Option(String).None,
                        .Some(single_rhs_code) => {
                          tmp_single := ctx.fresh_temp();
                          ctx.emitter.emit_string(indent);
                          ctx.emitter.emit("__auto_type ");
                          ctx.emitter.emit_string(tmp_single);
                          ctx.emitter.emit(" = ");
                          ctx.emitter.emit_string(single_rhs_code);
                          ctx.emitter.emit_line(";");
                          ctx.emitter.emit_string(indent);
                          ctx.emitter.emit("__auto_type ");
                          ctx.emitter.emit_string(sanitize_c_ident(single_var_name.value.as_str()));
                          ctx.emitter.emit(" = ");
                          ctx.emitter.emit_string(tmp_single);
                          ctx.emitter.emit(".");
                          ctx.emitter.emit_string(single_field_name.value);
                          ctx.emitter.emit_line(";");
                          Option(String).Some(String.from("0"))
                        }
                      )
                    )
                  )
                )
              ),
              true => Option(String).None
            )
          ),
          true => {
            // Check for `name := rhs` — treat as regular variable define
            is_given := match(
              destr_func.*,
              .FnCall(_, _, _, _, _) => false,
              .Atom(_, gtok) => (gtok.value == "given")
            );
            cond(
              (is_given && (destr_args.len() == usize(1))) =>
                match(
                  destr_args.get(usize(0)),
                  .None => Option(String).None,
                  .Some(inner_name_e) => match(
                    inner_name_e,
                    .FnCall(_, _, _, _, _) => Option(String).None,
                    .Atom(_, inner_tok) => match(
                      call_gen_expr(rhs_expr, ctx, indent),
                      .None => Option(String).None,
                      .Some(rhs_code) => {
                        san := sanitize_c_ident(inner_tok.value.as_str());
                        ctx.emitter.emit_string(indent);
                        ctx.emitter.emit("__auto_type ");
                        ctx.emitter.emit_string(san);
                        ctx.emitter.emit(" = ");
                        ctx.emitter.emit_string(rhs_code);
                        ctx.emitter.emit_line(";");
                        .Some(String.from("0"))
                      }
                    )
                  )
                ),
              true => {
                destr_kind_opt := match(
                  destr_func.*,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, dtok) => cond(
                    (dtok.value == BK_TUPLE) => Option(String).Some(String.from("tuple")),
                    (dtok.value == BK_ANON_STRUCT) => Option(String).Some(String.from("struct")),
                    (
                      (dtok.value == BK_BEGIN) && (
                        (destr_args.len() == usize(1)) &&
                          match(
                            destr_args.get(usize(0)),
                            .None => false,
                            .Some(single_begin_arg) => match(
                              single_begin_arg,
                              .Atom(_, _) => true,
                              .FnCall(_, single_begin_fn, single_begin_args, single_begin_infix, _) => (
                                (single_begin_infix && (single_begin_args.len() == usize(2))) &&
                                  match(
                                    single_begin_fn.*,
                                    .Atom(_, single_begin_tok) => (single_begin_tok.value == ":"),
                                    .FnCall(_, _, _, _, _) => false
                                  )
                              )
                            )
                          )
                      )
                    ) => Option(String).Some(String.from("struct")),
                    true => Option(String).None
                  )
                );
                match(
                  destr_kind_opt,
                  .None => Option(String).None,
                  .Some(destr_kind) => {
                    // Check if args are labeled (field: var) or positional
                    all_labeled := {
                      (la : bool) = (destr_args.len() > usize(0));
                      (lai : usize) = usize(0);
                      while((lai < destr_args.len()) && la, {
                        match(
                          destr_args.get(lai),
                          .None => {
                            la = false;
                          },
                          .Some(da) => match(
                            da,
                            // A plain atom means this is a positional (not labeled) destructuring.
                            .Atom(_, _) => {
                              la = false;
                            },
                            .FnCall(_, dff, dfa, dfinfix, _) => {
                              is_colon_pair2 := (
                                (dfinfix && (dfa.len() == usize(2))) && match(
                                  dff.*,
                                  .Atom(_, dftok) => (dftok.value == ":"),
                                  .FnCall(_, _, _, _, _) => false
                                )
                              );
                              if(!(is_colon_pair2), {
                                la = false;
                              });
                            }
                          )
                        );
                        lai = (lai + usize(1));
                      });
                      la
                    };
                    // Generate RHS expression first
                    rhs_code_opt := call_gen_expr(rhs_expr, ctx, indent);
                    match(
                      rhs_code_opt,
                      .None => Option(String).None,
                      .Some(rhs_code) => {
                        // Use a temp variable to avoid evaluating RHS multiple times
                        tmp := ctx.fresh_temp();
                        tmp_decl := String.from(indent.as_str());
                        tmp_decl.push_str("__auto_type ");
                        tmp_decl.push_string(tmp);
                        tmp_decl.push_str(" = ");
                        tmp_decl.push_string(rhs_code);
                        tmp_decl.push_str(";");
                        ctx.emitter.emit_string_line(tmp_decl);
                        // Emit per-field bindings
                        nd := destr_args.len();
                        (di : usize) = usize(0);
                        (ok_destr : bool) = true;
                        // Track bound field names for spread (`...`) support.
                        (bound_fields : ArrayList(String)) = ArrayList(String).new();
                        while((di < nd) && ok_destr, {
                          match(
                            destr_args.get(di),
                            .None => {
                              ok_destr = false;
                            },
                            .Some(da) => cond(
                              // Labeled: (field: var_name) or {field: var_name}
                              all_labeled => match(
                                da,
                                .Atom(_, _) => {
                                  ok_destr = false;
                                },
                                .FnCall(_, _, dfa2, _, _) => match(
                                  dfa2.get(usize(0)),
                                  .None => {
                                    ok_destr = false;
                                  },
                                  .Some(field_e) => match(
                                    field_e,
                                    .FnCall(_, _, _, _, _) => {
                                      ok_destr = false;
                                    },
                                    .Atom(_, field_tok) => match(
                                      dfa2.get(usize(1)),
                                      .None => {
                                        ok_destr = false;
                                      },
                                      .Some(var_e) => match(
                                        var_e,
                                        .FnCall(_, _, _, _, _) => {
                                          ok_destr = false;
                                        },
                                        .Atom(_, var_tok) => cond(
                                          // Spread `...`: emit remaining unbound fields from source struct.
                                          (field_tok.value == "...") => {
                                            match(
                                              ctx.get_open_var_fields(rhs_code.as_str()),
                                              .None => (),
                                              .Some(all_fields_csv) => {
                                                all_fields := _split_csv(all_fields_csv.as_str());
                                                (af_i : usize) = usize(0);
                                                while(af_i < all_fields.len(), {
                                                  match(
                                                    all_fields.get(af_i),
                                                    .None => (),
                                                    .Some(af_name) => {
                                                      // Skip if already bound.
                                                      (already_bound : bool) = false;
                                                      (bf_i : usize) = usize(0);
                                                      while((bf_i < bound_fields.len()) && (!(already_bound)), {
                                                        match(
                                                          bound_fields.get(bf_i),
                                                          .None => (),
                                                          .Some(bf) => {
                                                            if(bf == af_name, {
                                                              already_bound = true;
                                                            });
                                                          }
                                                        );
                                                        bf_i = (bf_i + usize(1));
                                                      });
                                                      if(!(already_bound), {
                                                        spread_bind := String.from(indent.as_str());
                                                        spread_bind.push_str("__auto_type ");
                                                        spread_bind.push_string(af_name);
                                                        spread_bind.push_str(" = ");
                                                        spread_bind.push_string(tmp);
                                                        spread_bind.push_str(".");
                                                        spread_bind.push_string(af_name);
                                                        spread_bind.push_str(";");
                                                        ctx.emitter.emit_string_line(spread_bind);
                                                      });
                                                    }
                                                  );
                                                  af_i = (af_i + usize(1));
                                                });
                                              }
                                            );
                                          },
                                          // Normal labeled binding.
                                          true => {
                                            bound_fields.push(field_tok.value);
                                            binding := String.from(indent.as_str());
                                            binding.push_str("__auto_type ");
                                            binding.push_string(var_tok.value);
                                            binding.push_str(" = ");
                                            binding.push_string(tmp);
                                            binding.push_str(".");
                                            binding.push_string(field_tok.value);
                                            binding.push_str(";");
                                            ctx.emitter.emit_string_line(binding);
                                          }
                                        )
                                      )
                                    )
                                  )
                                )
                              ),
                              // Positional: each arg is a plain atom (var name)
                              true => match(
                                da,
                                .FnCall(_, _, _, _, _) => {
                                  ok_destr = false;
                                },
                                .Atom(_, datom) => {
                                  var_name_p := datom.value;
                                  // Build "._N" for tuple (positional) or ".name" for struct (by name).
                                  field_ref := cond(
                                    (destr_kind == "tuple") => _tuple_field_ref(di),
                                    true => {
                                      r2 := String.from(".");
                                      r2.push_string(var_name_p);
                                      r2
                                    }
                                  );
                                  binding2 := String.from(indent.as_str());
                                  binding2.push_str("__auto_type ");
                                  binding2.push_string(var_name_p);
                                  binding2.push_str(" = ");
                                  binding2.push_string(tmp);
                                  binding2.push_string(field_ref);
                                  binding2.push_str(";");
                                  ctx.emitter.emit_string_line(binding2);
                                }
                              )
                            )
                          );
                          di = (di + usize(1));
                        });
                        cond(
                          ok_destr => Option(String).Some(String.from("0")),
                          true => Option(String).None
                        )
                      }
                    )
                  }
                )
              }
            )
          }
        )
      )
    )
  }
);
/// True if `name` is a builtin keyword handled specially by `generate_expr`.
///
/// These names must NOT be treated as regular function calls.
is_builtin_keyword :: (fn(name : str) -> bool)(
  cond(
    (name == BK_BEGIN) => true,
    (name == "cond") => true,
    (name == "while") => true,
    (name == "for") => true,
    (name == "if") => true,
    (name == "runtime") => true,
    (name == "match") => true,
    (name == "recur") => true,
    (name == "unwind") => true,
    (name == "return") => true,
    (name == "assert") => true,
    (name == "comptime_assert") => true,
    (name == "comptime_expect_error") => true,
    // Unit value: FnCall(Atom("tuple"), [], …) — the zero-arg tuple is unit
    (name == BK_TUPLE) => true,
    // Empty anon struct: FnCall(Atom("_"), [], …) from `{ }` — also unit
    (name == BK_ANON_STRUCT) => true,
    // Yo language keywords with no C equivalent — return None in generate_expr
    (name == "struct") => true,
    (name == "enum") => true,
    (name == "trait") => true,
    (name == "typeof") => true,
    (name == "forall") => true,
    // Runtime constructs not supported in prototype codegen — return None
    (name == "box") => true,
    (name == "array") => true,
    // Note: "open" is handled explicitly before this check in generate_expr
    (name == "import") => true,
    // name at expression level — strip wrapper, emit inner
    (name == "using") => true,
    // given(name) at expression level — compile-time only, skip
    (name == "given") => true,
    (name == "break") => true,
    (name == "continue") => true,
    true => false
  )
);
/// True if `func_box` wraps a `TokenKind.Dot` atom.
///
/// Handle bare `.Variant` pattern in match arms (no receiver).
///
/// `.Variant` is parsed as `FnCall(Dot, [Atom("Variant")], is_infix=false)`.
/// Looks up the variant name in the context's variant registry to find the
/// owning enum name, then returns `"EnumName_Variant"`.
///
/// Returns `None` if the variant is not registered in the context.
handle_bare_dot_variant :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)(
  match(
    args.get(usize(0)),
    .None => Option(String).None,
    .Some(variant_expr) => match(
      variant_expr,
      .Atom(_, vtok) => match(
        ctx.get_enum_for_variant(vtok.value.as_str()),
        .None => cond(
          // `.None` without a registered enum → bootstrap encoding is NULL (void*/0)
          (vtok.value == "None") => Option(String).Some(String.from("NULL")),
          true => Option(String).None
        ),
        .Some(enum_name) => {
          result := String.new();
          result.push_string(enum_name);
          result.push_str("_");
          result.push_string(vtok.value);
          Option(String).Some(result)
        }
      ),
      // `.Some(inner)` or `.Ok(inner)` / `.Err(inner)` without a registered enum
      // → bootstrap encoding is the inner value itself
      .FnCall(_, vfn_box, vfn_args, vfn_infix, _) => cond(
        vfn_infix => Option(String).None,
        (vfn_args.len() != usize(1)) => Option(String).None,
        true => match(
          vfn_box.*,
          .FnCall(_, _, _, _, _) => Option(String).None,
          .Atom(_, vftok) => cond(
            (
              (vftok.value == "Some") ||
                ((vftok.value == "Ok") || (vftok.value == "Err"))
            ) => match(
              ctx.get_enum_for_variant(vftok.value.as_str()),
              .Some(_) => Option(String).None,
              .None => match(
                vfn_args.get(usize(0)),
                .None => Option(String).None,
                .Some(inner_e) => call_gen_expr(inner_e, ctx, indent)
              )
            ),
            true => Option(String).None
          )
        )
      )
    )
  )
);
func_box_is_dot :: (fn(func_box : Box(AstExpr)) -> bool)(
  match(
    func_box.*,
    .Atom(_, ftok) => (ftok.kind == TokenKind.Dot),
    .FnCall(_, _, _, _, _) => false
  )
);
/// True if `func_box` wraps a FnCall that is itself a dot-access expression.
///
/// This pattern identifies method calls of the form `a.method(args)`, which
/// are parsed as `FnCall(FnCall(Dot, [a, method], true), [args], false)`.
func_box_is_dot_dispatch :: (fn(func_box : Box(AstExpr)) -> bool)(
  match(
    func_box.*,
    .Atom(_, _) => false,
    .FnCall(_, inner_func, _, inner_infix, _) => (
      inner_infix && match(
        inner_func.*,
        .Atom(_, ftok) => (ftok.kind == TokenKind.Dot),
        .FnCall(_, _, _, _, _) => false
      )
    )
  )
);
anon_typeof_receiver_name :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, fn_box, fn_args, fn_infix, _) => cond(
      fn_infix => Option(String).None,
      (fn_args.len() != usize(1)) => Option(String).None,
      true => match(
        fn_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, ftok) => cond(
          (ftok.value != "typeof") => Option(String).None,
          true => match(
            fn_args.get(usize(0)),
            .None => Option(String).None,
            .Some(recv_expr) => match(
              recv_expr,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, recv_tok) => cond(
                (recv_tok.kind == TokenKind.Identifier) => Option(String).Some(recv_tok.value),
                true => Option(String).None
              )
            )
          )
        )
      )
    )
  )
);
replace_all_string :: (fn(input : String, needle : str, replacement : String) -> String)({
  result := input;
  needle_string := String.from(needle);
  while(result.contains(needle_string), {
    result = result.replace(needle_string, replacement);
  });
  result
});
anon_method_template_expr_to_c :: (
  fn(expr : AstExpr, self_name : str, param_name : str, ctx : CodegenContext, indent : String) -> Option(String)
)(
  match(
    expr,
    .Atom(_, tok) => cond(
      ((tok.kind == TokenKind.Identifier) && (tok.value == param_name)) => Option(String).Some(String.from("__YO_ARG__")),
      true => call_gen_expr(expr, ctx, indent)
    ),
    .FnCall(_, func_box, expr_args, expr_infix, _) => cond(
      (
        expr_infix &&
          (func_box_is_dot(func_box) && (expr_args.len() == usize(2)))
      ) => {
        recv_is_self := match(
          expr_args.get(usize(0)),
          .None => false,
          .Some(recv_expr) => match(
            recv_expr,
            .FnCall(_, _, _, _, _) => false,
            .Atom(_, recv_tok) => ((recv_tok.kind == TokenKind.Identifier) && (recv_tok.value == self_name))
          )
        );
        field_name := match(
          expr_args.get(usize(1)),
          .None => String.new(),
          .Some(field_expr) => match(
            field_expr,
            .FnCall(_, _, _, _, _) => String.new(),
            .Atom(_, field_tok) => field_tok.value
          )
        );
        cond(
          (!(recv_is_self)) => call_gen_expr(expr, ctx, indent),
          (field_name.len() == usize(0)) => Option(String).None,
          true => {
            result := String.from("__YO_SELF__.");
            result.push_string(field_name);
            Option(String).Some(result)
          }
        )
      },
      (
        expr_infix &&
          match(
            func_box.*,
            .FnCall(_, _, _, _, _) => false,
            .Atom(_, op_tok2) => is_binary_op(op_tok2.value.as_str())
          ) &&
            (expr_args.len() == usize(2))
      ) => match(
        expr_args.get(usize(0)),
        .None => Option(String).None,
        .Some(lhs_expr) => match(
          expr_args.get(usize(1)),
          .None => Option(String).None,
          .Some(rhs_expr) => match(
            recur(lhs_expr, self_name, param_name, ctx, indent),
            .None => Option(String).None,
            .Some(lhs_c) => match(
              recur(rhs_expr, self_name, param_name, ctx, indent),
              .None => Option(String).None,
              .Some(rhs_c) => {
                op_s := match(
                  func_box.*,
                  .FnCall(_, _, _, _, _) => String.from("?"),
                  .Atom(_, op_tok3) => op_tok3.value
                );
                result := String.from("(");
                result.push_string(lhs_c);
                result.push_str(" ");
                result.push_string(op_s);
                result.push_str(" ");
                result.push_string(rhs_c);
                result.push_str(")");
                Option(String).Some(result)
              }
            )
          )
        )
      ),
      (
        (!(expr_infix)) &&
          (expr_args.len() == usize(1)) &&
            match(
              func_box.*,
              .FnCall(_, _, _, _, _) => false,
              .Atom(_, tuple_tok) => (tuple_tok.value == BK_TUPLE)
            )
      ) => match(
        expr_args.get(usize(0)),
        .None => Option(String).None,
        .Some(inner_expr) => recur(inner_expr, self_name, param_name, ctx, indent)
      ),
      true => call_gen_expr(expr, ctx, indent)
    )
  )
);
param_name_from_colon_or_atom :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, tok) => cond(
      (tok.kind == TokenKind.Identifier) => Option(String).Some(tok.value),
      true => Option(String).None
    ),
    .FnCall(_, func_box, args, is_infix, _) => cond(
      (!(is_infix)) => Option(String).None,
      (args.len() != usize(2)) => Option(String).None,
      true => match(
        func_box.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, op_tok) => cond(
          (op_tok.value != ":") => Option(String).None,
          true => match(
            args.get(usize(0)),
            .None => Option(String).None,
            .Some(name_expr) => match(
              name_expr,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, name_tok) => cond(
                (name_tok.kind == TokenKind.Identifier) => Option(String).Some(name_tok.value),
                true => Option(String).None
              )
            )
          )
        )
      )
    )
  )
);
register_anon_typeof_impl :: (
  fn(args : ArrayList(AstExpr), ctx : CodegenContext, indent : String) -> bool
)({
  result := false;
  if(args.len() >= usize(2), {
    recv_name_opt := match(args.get(usize(0)),.None => Option(String).None,.Some(type_expr) => anon_typeof_receiver_name(type_expr));
    match(
      recv_name_opt,
      .None => (),
      .Some(recv_name) => match(
        args.get(usize(1)),
        .None => (),
        .Some(binding_expr) => match(
          binding_expr,
          .Atom(_, _) => (),
          .FnCall(_, bind_func, bind_args, bind_infix, _) => if(bind_infix && (bind_args.len() == usize(2)), {
            is_colon := match(
              bind_func.*,
              .FnCall(_, _, _, _, _) => false,
              .Atom(_, bind_tok) => (bind_tok.value == ":")
            );
            if(is_colon, {
              method_name_opt := match(
                bind_args.get(usize(0)),
                .None => Option(String).None,
                .Some(method_expr) => match(
                  method_expr,
                  .FnCall(_, _, _, _, _) => Option(String).None,
                  .Atom(_, method_tok) => cond(
                    (method_tok.kind == TokenKind.Identifier) => Option(String).Some(method_tok.value),
                    true => Option(String).None
                  )
                )
              );
              match(
                method_name_opt,
                .None => (),
                .Some(method_name) => match(
                  bind_args.get(usize(1)),
                  .None => (),
                  .Some(fn_app) => match(
                    fn_app,
                    .Atom(_, _) => (),
                    .FnCall(_, app_func, app_args, _, _) => if(app_args.len() == usize(1), {
                      match(
                        app_func.*,
                        .Atom(_, _) => (),
                        .FnCall(_, arrow_func, arrow_args, arrow_infix, _) => if(arrow_infix && (arrow_args.len() == usize(2)), {
                          is_arrow := match(
                            arrow_func.*,
                            .FnCall(_, _, _, _, _) => false,
                            .Atom(_, arrow_tok) => (arrow_tok.value == "->")
                          );
                          if(is_arrow, {
                            fn_type_expr := match(arrow_args.get(usize(0)),.None => fn_app,.Some(e) => e);
                            match(
                              fn_type_expr,
                              .Atom(_, _) => (),
                              .FnCall(_, fn_func, fn_params, fn_infix, _) => if((!(fn_infix)) && (fn_params.len() >= usize(2)), {
                                is_fn := match(
                                  fn_func.*,
                                  .FnCall(_, _, _, _, _) => false,
                                  .Atom(_, fn_tok) => (fn_tok.value == "fn")
                                );
                                if(is_fn, {
                                  match(
                                    fn_params.get(usize(1)),
                                    .None => (),
                                    .Some(param_expr) => match(
                                      param_name_from_colon_or_atom(param_expr),
                                      .None => (),
                                      .Some(param_name) => match(
                                        app_args.get(usize(0)),
                                        .None => (),
                                        .Some(body_expr) => match(
                                          anon_method_template_expr_to_c(body_expr, "self", param_name.as_str(), ctx, indent),
                                          .None => (),
                                          .Some(template) => {
                                            ctx.register_anon_method(
                                              recv_name.as_str(),
                                              method_name.as_str(),
                                              template.as_str()
                                            );
                                            result = true;
                                          }
                                        )
                                      )
                                    )
                                  );
                                });
                              })
                            );
                          });
                        })
                      );
                    })
                  )
                )
              );
            });
          })
        )
      )
    );
  });
  result
});
/// True if `expr` is a non-capturing lambda: infix `->` with a TUPLE or bare-identifier LHS.
/// e.g. `(u) -> (u + 1)` — single param parsed as bare Atom after grouping.
/// e.g. `(u, v) -> (u + v)` — multi-param parsed as a TUPLE FnCall.
/// As opposed to a function-type annotation `fn(u:i32) -> i32`.
// Phase A.8.2: `is_lambda_expr` and `extract_lambda_param_names` were
// relocated to `./exprs/closures.yo`. `lift_non_capturing_lambda` remains
// here because it depends on `build_typed_decl` and `_split_c_params`.
/// Split a C params string like `"int32_t, bool"` by `, ` or `,` into a list.
/// Handles simple types only (no nested function pointer params).
_split_c_params :: (fn(params_str : str) -> ArrayList(String))({
  result := ArrayList(String).new();
  total := params_str.len();
  cond(
    (total == usize(0)) => (),
    true => {
      s := String.from(params_str);
      (start : usize) = usize(0);
      while(start <= total, {
        sep_opt := s.index_of(String.from(","), start);
        sep := match(sep_opt,.Some(p) => p,.None => total);
        piece := s.substring(start, sep);
        // Trim leading spaces
        trimmed := {
          (ts : usize) = usize(0);
          pl := piece.len();
          while(ts < pl, {
            match(
              piece.at(ts),
              .None => {
                break;
              },
              .Some(r) => {
                if(r.char == u32(32), {
                  ts = (ts + usize(1));
                }, {
                  break;
                });
              }
            );
          });
          piece.substring(ts, pl)
        };
        if(trimmed.len() > usize(0), {
          result.push(trimmed);
        });
        start = (sep + usize(1));
      });
    }
  );
  result
});
first_captured_ident_name :: (
  fn(expr : AstExpr, param_name : str, ctx : CodegenContext) -> Option(String)
)(
  match(
    expr,
    .Atom(_, tok) => cond(
      (tok.kind != TokenKind.Identifier) => Option(String).None,
      (tok.value == param_name) => Option(String).None,
      is_c_type_name(tok.value.as_str()) => Option(String).None,
      is_primitive_type_cast(tok.value.as_str()) => Option(String).None,
      is_builtin_keyword(tok.value.as_str()) => Option(String).None,
      ctx.is_defined_fn(tok.value.as_str()) => Option(String).None,
      true => Option(String).Some(tok.value)
    ),
    .FnCall(_, capture_func_box, capture_args, _, _) => {
      found := recur(capture_func_box.*, param_name, ctx);
      (capture_i : usize) = usize(0);
      while((capture_i < capture_args.len()) && match(found,.None => true,.Some(_) => false), {
        match(
          capture_args.get(capture_i),
          .None => (),
          .Some(capture_arg) => {
            found = recur(capture_arg, param_name, ctx);
          }
        );
        capture_i = (capture_i + usize(1));
      });
      found
    }
  )
);
lift_impl_fn_i32_i32_lambda :: (
  fn(
    ctx : CodegenContext,
    lambda : AstExpr,
    indent : String
  ) -> Option(String)
)(
  match(
    lambda,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, _, largs, _, _) => match(
      largs.get(usize(0)),
      .None => Option(String).None,
      .Some(params_expr) => match(
        largs.get(usize(1)),
        .None => Option(String).None,
        .Some(body_expr) => {
          param_names := extract_lambda_param_names(params_expr);
          match(
            param_names.get(usize(0)),
            .None => Option(String).None,
            .Some(param_name) => {
              fn_name := ctx.fresh_lambda_name();
              ctx.register_var_type(param_name.as_str(), "int32_t");
              capture_opt := first_captured_ident_name(body_expr, param_name.as_str(), ctx);
              env_type := {
                s := String.from(fn_name.as_str());
                s.push_str("_env");
                s
              };
              match(
                capture_opt,
                .None => {
                  body_code := match(
                    call_gen_expr(body_expr, ctx, String.from("  ")),
                    .None => String.from("0"),
                    .Some(c) => c
                  );
                  lambda_code := String.from("static int32_t ");
                  lambda_code.push_string(fn_name);
                  lambda_code.push_str("(void* __yo_env, int32_t ");
                  lambda_code.push_string(param_name);
                  lambda_code.push_str(") {\n  (void)__yo_env;\n  return ");
                  lambda_code.push_string(body_code);
                  lambda_code.push_str(";\n}");
                  ctx.emitter.emit_declaration_string_line(lambda_code);
                  result := String.from("(__yo_impl_fn_i32_i32){ .data = NULL, .call = ");
                  result.push_string(fn_name);
                  result.push_str(" }");
                  Option(String).Some(result)
                },
                .Some(capture_name) => {
                  capture_ty := match(
                    ctx.get_var_type(capture_name.as_str()),
                    .None => String.from("int32_t"),
                    .Some(existing_capture_ty) => existing_capture_ty
                  );
                  ctx.register_var_type(capture_name.as_str(), capture_ty.as_str());
                  env_var := {
                    s2 := String.from(fn_name.as_str());
                    s2.push_str("_env_value");
                    s2
                  };
                  san_capture := sanitize_c_ident(capture_name.as_str());
                  decl := String.from("typedef struct { ");
                  decl.push_string(capture_ty);
                  decl.push_str(" ");
                  decl.push_string(san_capture);
                  decl.push_str("; } ");
                  decl.push_string(env_type);
                  decl.push_str(";\nstatic int32_t ");
                  decl.push_string(fn_name);
                  decl.push_str("(void* __yo_env, int32_t ");
                  decl.push_string(param_name);
                  decl.push_str(") {\n  ");
                  decl.push_string(env_type);
                  decl.push_str("* __yo_capture = (");
                  decl.push_string(env_type);
                  decl.push_str("*)__yo_env;\n  ");
                  decl.push_string(capture_ty);
                  decl.push_str(" ");
                  decl.push_string(san_capture);
                  decl.push_str(" = __yo_capture->");
                  decl.push_string(san_capture);
                  decl.push_str(";\n  return ");
                  body_code2 := match(
                    call_gen_expr(body_expr, ctx, String.from("  ")),
                    .None => String.from("0"),
                    .Some(c2) => c2
                  );
                  decl.push_string(body_code2);
                  decl.push_str(";\n}");
                  ctx.emitter.emit_declaration_string_line(decl);
                  ctx.emitter.emit_string(indent);
                  ctx.emitter.emit_string(env_type);
                  ctx.emitter.emit(" ");
                  ctx.emitter.emit_string(env_var);
                  ctx.emitter.emit(" = { .");
                  ctx.emitter.emit_string(san_capture);
                  ctx.emitter.emit(" = ");
                  ctx.emitter.emit_string(san_capture);
                  ctx.emitter.emit_line(" };");
                  result2 := String.from("(__yo_impl_fn_i32_i32){ .data = &");
                  result2.push_string(env_var);
                  result2.push_str(", .call = ");
                  result2.push_string(fn_name);
                  result2.push_str(" }");
                  Option(String).Some(result2)
                }
              )
            }
          )
        }
      )
    )
  )
);
/// Lift a non-capturing lambda to a static C function.
/// `lambda` must be `is_lambda_expr`. `fp_c_ty` is the expected function
/// pointer type like `"int32_t(*_FP_)(int32_t)"`.
/// Emits the static function to the declarations section and returns the name.
lift_non_capturing_lambda :: (
  fn(
    ctx : CodegenContext,
    lambda : AstExpr,
    fp_c_ty : String
  ) -> Option(String)
)(
  match(
    lambda,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, _, largs, _, _) => {
      params_expr_opt := largs.get(usize(0));
      body_expr_opt := largs.get(usize(1));
      match(
        params_expr_opt,
        .None => Option(String).None,
        .Some(params_expr) => match(
          body_expr_opt,
          .None => Option(String).None,
          .Some(body_expr) => {
            // Extract param names from TUPLE
            param_names := extract_lambda_param_names(params_expr);
            // Parse fp_c_ty to get ret type and param types.
            // Format: "ret(*_FP_)(p1, p2, ...)"
            fp_s := fp_c_ty.as_str();
            // Find "(*_FP_)(" marker — 8 chars
            marker := String.from("(*_FP_)(");
            marker_pos_opt := fp_c_ty.index_of(marker, usize(0));
            match(
              marker_pos_opt,
              .None => Option(String).None,
              .Some(mpos) => {
                ret_ty := fp_c_ty.substring(usize(0), mpos);
                // After marker comes params string then ")"
                params_start := (mpos + usize(8));
                total_len := fp_c_ty.len();
                // params end just before final ")"
                params_end := cond(
                  (total_len > usize(0)) => (total_len - usize(1)),
                  true => usize(0)
                );
                params_str := fp_c_ty.substring(params_start, params_end);
                param_types := _split_c_params(params_str.as_str());
                n_pt := param_types.len();
                n_pn := param_names.len();
                // Generate a unique lambda name
                fn_name := ctx.fresh_lambda_name();
                // Build the C function declaration string
                lambda_code := {
                  sb := String.from("static ");
                  sb.push_string(ret_ty);
                  sb.push_str(" ");
                  sb.push_string(fn_name);
                  sb.push_str("(");
                  // params
                  n_params := cond(
                    (n_pt < n_pn) => n_pt,
                    true => n_pn
                  );
                  (pi : usize) = usize(0);
                  while(pi < n_params, {
                    if(pi > usize(0), {
                      sb.push_str(", ");
                    });
                    p_ty := match(param_types.get(pi),.Some(s) => s,.None => String.from("void*"));
                    p_nm := match(param_names.get(pi),.Some(s) => s,.None => String.from("_p"));
                    sb.push_string(build_typed_decl(p_ty.as_str(), p_nm.as_str()));
                    pi = (pi + usize(1));
                  });
                  // If no params, emit void
                  if((n_params == usize(0)) && (n_pt == usize(0)), {
                    sb.push_str("void");
                  });
                  sb.push_str(") {\n  return ");
                  // Register params temporarily so body can use them
                  {
                    (ri : usize) = usize(0);
                    while(ri < n_params, {
                      p_ty2 := match(param_types.get(ri),.Some(s) => s,.None => String.from("void*"));
                      p_nm2 := match(param_names.get(ri),.Some(s) => s,.None => String.from("_p"));
                      ctx.register_var_type(p_nm2.as_str(), p_ty2.as_str());
                      ri = (ri + usize(1));
                    });
                  };
                  body_code := match(
                    call_gen_expr(body_expr, ctx, String.from("  ")),
                    .None => String.from("0"),
                    .Some(c) => c
                  );
                  sb.push_string(body_code);
                  sb.push_str(";\n}");
                  sb
                };
                ctx.emitter.emit_declaration_string_line(lambda_code);
                .Some(fn_name)
              }
            )
          }
        )
      )
    }
  )
);
/// Generate a comma-separated C argument list for `args`.
///
/// Returns `Some("")` for zero args.  Returns `None` if any arg fails to
/// generate.
gen_arg_list :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  n := args.len();
  result := String.new();
  (i : usize) = usize(0);
  (ok : bool) = true;
  while((i < n) && ok, {
    match(
      args.get(i),
      .None => {
        ok = false;
      },
      .Some(arg) => {
        // Unwrap `name` at call sites: strip the `using` wrapper and
        // generate just the inner argument. In C, the evidence param is passed
        // like a regular argument.
        actual_arg := match(
          arg,
          .FnCall(_, ua_fn, ua_args, ua_infix, _) => cond(
            ((!(ua_infix)) && (ua_args.len() == usize(1))) =>
              match(
                ua_fn.*,
                .Atom(_, ua_tok) => cond(
                  (ua_tok.value == "using") =>
                    match(
                      ua_args.get(usize(0)),
                      .Some(inner) => inner,
                      .None => arg
                    ),
                  true => arg
                ),
                .FnCall(_, _, _, _, _) => arg
              ),
            true => arg
          ),
          .Atom(_, _) => arg
        );
        arg_code_opt := match(
          actual_arg,
          .FnCall(_, _, _, _, _) => call_gen_expr(actual_arg, ctx, indent),
          .Atom(_, actual_tok) => cond(
            ((actual_tok.value == "io") && ctx.get_var_type("io").is_none()) =>
              Option(String).Some(String.from("NULL")),
            true => call_gen_expr(actual_arg, ctx, indent)
          )
        );
        match(
          arg_code_opt,
          .None => {
            ok = false;
          },
          .Some(code) => {
            if(i > usize(0), {
              result.push_str(", ");
            });
            result.push_string(code);
          }
        );
      }
    );
    i = (i + usize(1));
  });
  cond(
    ok =>.Some(result),
    true => Option(String).None
  )
});
/// Handle regular function call `f(a, b)` → `f(a, b)`.
handle_regular_call :: (
  fn(
    ident_opt : Option(String),
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)(
  match(
    ident_opt,
    .None => Option(String).None,
    .Some(id) =>
      // Check array var first, then do regular arg list + call building.
      cond(
        // consume(expr) — no-op: just return the expression (emitted as stmt by caller)
        ((id == "consume") && (args.len() == usize(1))) =>
          generate_consume(args, ctx, indent),
        // Inline builtins (operators, ptr ops, slice helpers, randomness wrappers).
        // Mirrors `generateYoInlineFunctionCall` dispatch in src/codegen/exprs/generation.ts.
        is_yo_inline_builtin(id.as_str()) => {
          arg_codes := ArrayList(String).new();
          (i_inline : usize) = usize(0);
          (n_inline : usize) = args.len();
          (ok_inline : bool) = true;
          while((i_inline < n_inline) && ok_inline, {
            match(
              args.get(i_inline),
              .None => {
                ok_inline = false;
              },
              .Some(a_expr) => match(
                call_gen_expr(a_expr, ctx, indent),
                .None => {
                  ok_inline = false;
                },
                .Some(a_code) => {
                  arg_codes.push(a_code);
                }
              )
            );
            i_inline = (i_inline + usize(1));
          });
          cond(
            ok_inline => generate_yo_inline_function_call(id.as_str(), arg_codes),
            true => Option(String).None
          )
        },
        ((args.len() == usize(1)) && ctx.get_simple_closure_capture_name(id.as_str()).is_some()) => match(
          ctx.get_simple_closure_capture_name(id.as_str()),
          .None => Option(String).None,
          .Some(capture_name) => match(
            args.get(usize(0)),
            .None => Option(String).None,
            .Some(arg_expr) => match(
              call_gen_expr(arg_expr, ctx, indent),
              .None => Option(String).None,
              .Some(arg_c) => {
                capture_access := capture_access_for_closure_var(id.as_str(), capture_name.as_str(), ctx);
                result := String.from("((");
                result.push_string(capture_access);
                result.push_str(" = (");
                result.push_string(capture_access);
                result.push_str(" + ");
                result.push_string(arg_c);
                result.push_str(")), ");
                result.push_string(capture_access);
                result.push_str(")");
                Option(String).Some(result)
              }
            )
          )
        ),
        ((args.len() == usize(1)) && match(ctx.get_var_type(id.as_str()),.None => false,.Some(id_impl_fn_ty) => is_impl_fn_c_type(id_impl_fn_ty.as_str()))) =>
          match(
            args.get(usize(0)),
            .None => Option(String).None,
            .Some(impl_arg_expr) => match(
              call_gen_expr(impl_arg_expr, ctx, indent),
              .None => Option(String).None,
              .Some(impl_arg_c) => {
                impl_call := String.new();
                impl_call.push_string(sanitize_c_ident(id.as_str()));
                impl_call.push_str(".call(");
                impl_call.push_string(sanitize_c_ident(id.as_str()));
                impl_call.push_str(".data, ");
                impl_call.push_string(impl_arg_c);
                impl_call.push_str(")");
                Option(String).Some(impl_call)
              }
            )
          ),
        // Returned-array wrapper indexing: `arr(idx)` → `arr.data[idx]`.
        ((args.len() == usize(1)) && var_type_is(ctx, id.as_str(), "YoArray_i32")) => match(
          ctx.get_var_type(id.as_str()),
          .None => Option(String).None,
          .Some(id_ty) => cond(
            (id_ty != "YoArray_i32") => Option(String).None,
            true => match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(array_idx_e) => match(
                call_gen_expr(array_idx_e, ctx, indent),
                .None => Option(String).None,
                .Some(array_idx_c) => {
                  array_index_code := String.new();
                  array_index_code.push_string(id);
                  array_index_code.push_str(".data[");
                  array_index_code.push_string(array_idx_c);
                  array_index_code.push_str("]");
                  Option(String).Some(array_index_code)
                }
              )
            )
          )
        ),
        // Bootstrap Index lowering for runtime indexable values.
        (
          (args.len() == usize(1)) &&
            (
              match(
                ctx.get_var_type(id.as_str()),
                .None => false,
                .Some(id_index_candidate_ty) =>
                  is_runtime_index_callable_type(ctx, id_index_candidate_ty.as_str())
              ) &&
                ((!(ctx.is_array_var(id.as_str()))) && (!(ctx.is_slice_var(id.as_str()))))
            )
        ) => match(
          ctx.get_var_type(id.as_str()),
          .None => Option(String).None,
          .Some(id_ty_for_index) => cond(
            (id_ty_for_index == "const char*") => match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(str_idx_expr) => match(
                call_gen_expr(str_idx_expr, ctx, indent),
                .None => Option(String).None,
                .Some(str_idx_c) => {
                  str_index_code := String.from("(uint8_t)(");
                  str_index_code.push_string(sanitize_c_ident(id.as_str()));
                  str_index_code.push_str("[");
                  str_index_code.push_string(str_idx_c);
                  str_index_code.push_str("])");
                  Option(String).Some(str_index_code)
                }
              )
            ),
            is_arraylist_c_type(id_ty_for_index.as_str()) => match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(list_idx_expr) => match(
                call_gen_expr(list_idx_expr, ctx, indent),
                .None => Option(String).None,
                .Some(list_idx_c) => {
                  list_index_code := String.new();
                  list_index_code.push_string(sanitize_c_ident(id.as_str()));
                  list_index_code.push_str(".data[");
                  list_index_code.push_string(list_idx_c);
                  list_index_code.push_str("]");
                  Option(String).Some(list_index_code)
                }
              )
            ),
            is_deque_c_type(id_ty_for_index.as_str()) => match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(deque_idx_expr) => match(
                call_gen_expr(deque_idx_expr, ctx, indent),
                .None => Option(String).None,
                .Some(deque_idx_c) => {
                  deque_index_code := String.new();
                  deque_index_code.push_string(sanitize_c_ident(id.as_str()));
                  deque_index_code.push_str(".data[(");
                  deque_index_code.push_string(sanitize_c_ident(id.as_str()));
                  deque_index_code.push_str(".head + ");
                  deque_index_code.push_string(deque_idx_c);
                  deque_index_code.push_str(") % (size_t)(1024)]");
                  Option(String).Some(deque_index_code)
                }
              )
            ),
            is_runtime_map_c_type(id_ty_for_index.as_str()) => match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(map_idx_expr) => match(
                call_gen_expr(map_idx_expr, ctx, indent),
                .None => Option(String).None,
                .Some(map_idx_c) => {
                  map_index_code := String.new();
                  map_index_code.push_string(sanitize_c_ident(id.as_str()));
                  map_index_code.push_str(".values[(size_t)(");
                  map_index_code.push_string(map_idx_c);
                  map_index_code.push_str(")]");
                  Option(String).Some(map_index_code)
                }
              )
            ),
            true => match(
              ctx.get_struct_fields(id_ty_for_index.as_str()),
              .None => Option(String).None,
              .Some(struct_fields_csv) => match(
                args.get(usize(0)),
                .None => Option(String).None,
                .Some(struct_idx_expr) => match(
                  call_gen_expr(struct_idx_expr, ctx, indent),
                  .None => Option(String).None,
                  .Some(struct_idx_c) =>
                    build_struct_field_index_expr(sanitize_c_ident(id.as_str()), struct_fields_csv, struct_idx_c)
                )
              )
            )
          )
        ),
        // arr(start..end) — slice creation: emit compound literal {.data=&arr[start], .length=end-start}
        (ctx.is_array_var(id.as_str()) && (args.len() == usize(1))) =>
          match(
            args.get(usize(0)),
            .None => Option(String).None,
            .Some(arg_e) =>
              // Check if arg is a range `..` expression
              match(
                arg_e,
                .Atom(_, _) =>
                  // Plain index: arr[idx]
                  match(
                    call_gen_expr(arg_e, ctx, indent),
                    .None => Option(String).None,
                    .Some(idx_c) => {
                      r := String.new();
                      r.push_string(id);
                      r.push_str("[");
                      r.push_string(idx_c);
                      r.push_str("]");
                      Option(String).Some(r)
                    }
                  ),
                .FnCall(_, range_fn, range_args, range_infix, _) => cond(
                  // Is it an infix `..` with 2 args?
                  (range_infix && (range_args.len() == usize(2))) =>
                    match(
                      range_fn.*,
                      .FnCall(_, _, _, _, _) =>
                        // Not a range — treat as regular index
                        match(
                          call_gen_expr(arg_e, ctx, indent),
                          .None => Option(String).None,
                          .Some(idx_c) => {
                            r2 := String.new();
                            r2.push_string(id);
                            r2.push_str("[");
                            r2.push_string(idx_c);
                            r2.push_str("]");
                            Option(String).Some(r2)
                          }
                        ),
                      .Atom(_, rtok) => cond(
                        ((rtok.value != "..") && (rtok.value != "..=")) =>
                          // Not a range — treat as regular index
                          match(
                            call_gen_expr(arg_e, ctx, indent),
                            .None => Option(String).None,
                            .Some(idx_c) => {
                              r3 := String.new();
                              r3.push_string(id);
                              r3.push_str("[");
                              r3.push_string(idx_c);
                              r3.push_str("]");
                              Option(String).Some(r3)
                            }
                          ),
                        true =>
                          // Range or inclusive range — emit slice compound literal
                          match(
                            range_args.get(usize(0)),
                            .None => Option(String).None,
                            .Some(start_e) => match(
                              range_args.get(usize(1)),
                              .None => Option(String).None,
                              .Some(end_e) => match(
                                call_gen_expr(start_e, ctx, indent),
                                .None => Option(String).None,
                                .Some(start_c) => match(
                                  call_gen_expr(end_e, ctx, indent),
                                  .None => Option(String).None,
                                  .Some(end_c) => {
                                    san_arr := sanitize_c_ident(id.as_str());
                                    // Inclusive ..= adds 1 to the length
                                    length_expr := cond(
                                      (rtok.value == "..=") => {
                                        le := String.from("(");
                                        le.push_string(end_c);
                                        le.push_str(") - (");
                                        le.push_string(start_c);
                                        le.push_str(") + 1");
                                        le
                                      },
                                      true => {
                                        le2 := String.from("(");
                                        le2.push_string(end_c);
                                        le2.push_str(") - (");
                                        le2.push_string(start_c);
                                        le2.push_str(")");
                                        le2
                                      }
                                    );
                                    // (struct { __typeof__(arr[0])* data; size_t length; }){.data=&arr[start], .length=...}
                                    r4 := String.from("(struct { __typeof__(");
                                    r4.push_string(san_arr);
                                    r4.push_str("[0])* data; size_t length; }){.data = &");
                                    r4.push_string(san_arr);
                                    r4.push_str("[");
                                    r4.push_string(start_c);
                                    r4.push_str("], .length = ");
                                    r4.push_string(length_expr);
                                    r4.push_str("}");
                                    Option(String).Some(r4)
                                  }
                                )
                              )
                            )
                          )
                      )
                    ),
                  true =>
                    // Not range — treat as regular index
                    match(
                      call_gen_expr(arg_e, ctx, indent),
                      .None => Option(String).None,
                      .Some(idx_c) => {
                        r5 := String.new();
                        r5.push_string(id);
                        r5.push_str("[");
                        r5.push_string(idx_c);
                        r5.push_str("]");
                        Option(String).Some(r5)
                      }
                    )
                )
              )
          ),
        // slice(idx) or slice(start..end) — slice element access or slice-of-slice
        (ctx.is_slice_var(id.as_str()) && (args.len() == usize(1))) =>
          match(
            args.get(usize(0)),
            .None => Option(String).None,
            .Some(sidx_e) =>
              match(
                sidx_e,
                .Atom(_, _) =>
                  // Plain index: slice.data[idx]
                  match(
                    call_gen_expr(sidx_e, ctx, indent),
                    .None => Option(String).None,
                    .Some(sidx_c) => {
                      rs := String.new();
                      rs.push_string(id);
                      rs.push_str(".data[");
                      rs.push_string(sidx_c);
                      rs.push_str("]");
                      Option(String).Some(rs)
                    }
                  ),
                .FnCall(_, srange_fn, srange_args, srange_infix, _) => cond(
                  (srange_infix && (srange_args.len() == usize(2))) =>
                    match(
                      srange_fn.*,
                      .FnCall(_, _, _, _, _) =>
                        match(
                          call_gen_expr(sidx_e, ctx, indent),
                          .None => Option(String).None,
                          .Some(sc) => {
                            rss := String.new();
                            rss.push_string(id);
                            rss.push_str(".data[");
                            rss.push_string(sc);
                            rss.push_str("]");
                            Option(String).Some(rss)
                          }
                        ),
                      .Atom(_, srtok) => cond(
                        ((srtok.value != "..") && (srtok.value != "..=")) =>
                          match(
                            call_gen_expr(sidx_e, ctx, indent),
                            .None => Option(String).None,
                            .Some(sc2) => {
                              rss2 := String.new();
                              rss2.push_string(id);
                              rss2.push_str(".data[");
                              rss2.push_string(sc2);
                              rss2.push_str("]");
                              Option(String).Some(rss2)
                            }
                          ),
                        true =>
                          // Slice-of-slice: {.data = &slice.data[start], .length = ...}
                          match(
                            srange_args.get(usize(0)),
                            .None => Option(String).None,
                            .Some(ss_start) => match(
                              srange_args.get(usize(1)),
                              .None => Option(String).None,
                              .Some(ss_end) => match(
                                call_gen_expr(ss_start, ctx, indent),
                                .None => Option(String).None,
                                .Some(ss_start_c) => match(
                                  call_gen_expr(ss_end, ctx, indent),
                                  .None => Option(String).None,
                                  .Some(ss_end_c) => {
                                    san_sl := sanitize_c_ident(id.as_str());
                                    ss_length := cond(
                                      (srtok.value == "..=") => {
                                        sle := String.from("(");
                                        sle.push_string(ss_end_c);
                                        sle.push_str(") - (");
                                        sle.push_string(ss_start_c);
                                        sle.push_str(") + 1");
                                        sle
                                      },
                                      true => {
                                        sle2 := String.from("(");
                                        sle2.push_string(ss_end_c);
                                        sle2.push_str(") - (");
                                        sle2.push_string(ss_start_c);
                                        sle2.push_str(")");
                                        sle2
                                      }
                                    );
                                    rss3 := String.from("(struct { __typeof__(");
                                    rss3.push_string(san_sl);
                                    rss3.push_str(".data[0])* data; size_t length; }){.data = &");
                                    rss3.push_string(san_sl);
                                    rss3.push_str(".data[");
                                    rss3.push_string(ss_start_c);
                                    rss3.push_str("], .length = ");
                                    rss3.push_string(ss_length);
                                    rss3.push_str("}");
                                    Option(String).Some(rss3)
                                  }
                                )
                              )
                            )
                          )
                      )
                    ),
                  true =>
                    match(
                      call_gen_expr(sidx_e, ctx, indent),
                      .None => Option(String).None,
                      .Some(sc3) => {
                        rss4 := String.new();
                        rss4.push_string(id);
                        rss4.push_str(".data[");
                        rss4.push_string(sc3);
                        rss4.push_str("]");
                        Option(String).Some(rss4)
                      }
                    )
                )
              )
          ),
        // slice(start..end) — handled in the slice branch above.
        // (No dead branch needed here.)
        true => {
          n_rc := args.len();
          result_args := String.new();
          (i_rc : usize) = usize(0);
          (ok_rc : bool) = true;
          while((i_rc < n_rc) && ok_rc, {
            match(
              args.get(i_rc),
              .None => {
                ok_rc = false;
              },
              .Some(arg_rc) => {
                arg_code_opt := cond(
                  // If this arg is a non-capturing lambda, try to lift it.
                  is_lambda_expr(arg_rc) => {
                    param_ty_opt := ctx.get_fn_param_ty_at(id.as_str(), i_rc);
                    match(
                      param_ty_opt,
                      .None => call_gen_expr(arg_rc, ctx, indent),
                      .Some(cb_ty) => cond(
                        (is_impl_fn_c_type(cb_ty.as_str())) =>
                          lift_impl_fn_i32_i32_lambda(ctx, arg_rc, indent),
                        (cb_ty.contains(String.from("_FP_"))) =>
                          lift_non_capturing_lambda(ctx, arg_rc, cb_ty),
                        true => call_gen_expr(arg_rc, ctx, indent)
                      )
                    )
                  },
                  true => call_gen_expr(arg_rc, ctx, indent)
                );
                match(
                  arg_code_opt,
                  .None => {
                    ok_rc = false;
                  },
                  .Some(code_rc) => {
                    if(i_rc > usize(0), {
                      result_args.push_str(", ");
                    });
                    result_args.push_string(code_rc);
                  }
                );
              }
            );
            i_rc = (i_rc + usize(1));
          });
          cond(
            (!(ok_rc)) => Option(String).None,
            // If the callee is a comptime-only function, emit `0` (a no-op placeholder).
            ctx.is_skipped_fn(id.as_str()) => Option(String).Some(String.from("0")),
            true => {
              result := String.new();
              if(ctx.is_defined_fn(id.as_str()), {
                result.push_str("fn_");
              });
              result.push_string(id);
              result.push_str("(");
              result.push_string(result_args);
              result.push_str(")");
              Option(String).Some(result)
            }
          )
        }
      )
  )
);
/// Handle dot field access `obj.field` → `obj.field` (struct) or `Enum_Variant` (enum).
///
/// `args[0]` is the receiver; `args[1]` is expected to be an Atom holding
/// the field/variant name.
///
/// If the object is an enum type registered in `ctx` (e.g. `Color`), emits
/// `Color_Red` instead of `Color.Red` to match the C enum constant convention.
handle_dot_access :: (
  fn(
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  obj_opt := args.get(usize(0));
  field_opt := args.get(usize(1));
  match(
    obj_opt,
    .None => Option(String).None,
    .Some(obj_expr) => match(
      field_opt,
      .None => Option(String).None,
      .Some(field_expr) => match(
        call_gen_expr(obj_expr, ctx, indent),
        .None => Option(String).None,
        .Some(obj_code) => {
          field_name_opt := match(
            field_expr,
            .Atom(_, ftok) => Option(String).Some(ftok.value),
            .FnCall(_, _, _, _, _) => Option(String).None
          );
          match(
            field_name_opt,
            .None => Option(String).None,
            .Some(fname) => {
              is_enum := ctx.is_enum_name(obj_code.as_str());
              is_deref := (fname == "*");
              // Check if `obj_code` is a pointer variable — if so, emit `obj->field`.
              is_ptr_var := ctx.var_type_is_ptr(obj_code.as_str());
              // `rune` is a zero-cost newtype over u32.  In C it is `typedef uint32_t rune;`
              // so there is no `.char` field — the `.char` accessor is an identity.
              is_char_field := (fname == "char");
              is_arraylist_u8 := match(
                ctx.get_var_type(obj_code.as_str()),
                .None => false,
                .Some(obj_ty) => (obj_ty == "ArrayList_u8")
              );
              deref_is_value_payload := match(
                ctx.get_var_type(obj_code.as_str()),
                .None => false,
                .Some(obj_ty2) => match(
                  ctx.get_struct_fields(obj_ty2.as_str()),
                  .None => false,
                  .Some(fields_csv) => (fields_csv == "_0")
                )
              );
              cond(
                // Type constructor field access without parens: Option(T).None → typed zero or NULL
                (type_app_receiver_is(obj_expr, "Option") && (fname == "None")) =>
                  match(
                    generic_type_app_field_c_type(obj_expr),
                    .None => Option(String).Some(String.from("NULL")),
                    .Some(inner_c_ty3) => cond(
                      is_numeric_c_type(inner_c_ty3.as_str()) => {
                        z3 := String.from("(");
                        z3.push_string(inner_c_ty3);
                        z3.push_str(")0");
                        Option(String).Some(z3)
                      },
                      true => Option(String).Some(String.from("NULL"))
                    )
                  ),
                (type_app_receiver_is(obj_expr, "Result") && (fname == "Err")) =>
                  Option(String).Some(String.from("NULL")),
                (generic_type_app_c_name(obj_expr).is_some() && (fname == "None")) =>
                  match(
                    generic_type_app_field_c_type(obj_expr),
                    .None => Option(String).Some(String.from("NULL")),
                    .Some(inner_c_ty4) => cond(
                      is_numeric_c_type(inner_c_ty4.as_str()) => {
                        z4 := String.from("(");
                        z4.push_string(inner_c_ty4);
                        z4.push_str(")0");
                        Option(String).Some(z4)
                      },
                      true => Option(String).Some(String.from("NULL"))
                    )
                  ),
                (is_deref && deref_is_value_payload) => {
                  result := String.from(obj_code.as_str());
                  result.push_str("._0");
                  Option(String).Some(result)
                },
                is_deref => {
                  // c.* → (*c) — pointer dereference
                  result := String.from("(*");
                  result.push_string(obj_code);
                  result.push_str(")");
                  Option(String).Some(result)
                },
                is_char_field => Option(String).Some(obj_code),
                (is_arraylist_u8 && (fname == "_ptr")) => {
                  result_ptr := String.from("((");
                  result_ptr.push_string(obj_code);
                  result_ptr.push_str(".length > 0) ? &");
                  result_ptr.push_string(obj_code);
                  result_ptr.push_str(".data[0] : NULL)");
                  Option(String).Some(result_ptr)
                },
                is_enum => {
                  result := String.new();
                  result.push_string(obj_code);
                  result.push_str("_");
                  result.push_string(fname);
                  Option(String).Some(result)
                },
                is_ptr_var => {
                  // Pointer variable: emit `obj->field`
                  result := String.new();
                  result.push_string(obj_code);
                  result.push_str("->");
                  is_index_field := match(
                    fname.at(usize(0)),
                    .None => false,
                    .Some(r) => ((r.char >= u32(48)) && (r.char <= u32(57)))
                  );
                  field_c_name := fname.replace(String.from("."), String.from("._"));
                  if(is_index_field, {
                    result.push_str("_");
                  });
                  result.push_string(field_c_name);
                  Option(String).Some(result)
                },
                true => {
                  result := String.new();
                  result.push_string(obj_code);
                  result.push_str(".");
                  // Tuple/array index access: .0, .1, … → ._0, ._1, …
                  // In C, tuple fields are named _0, _1, … (underscore prefix).
                  is_index_field := match(
                    fname.at(usize(0)),
                    .None => false,
                    .Some(r) => ((r.char >= u32(48)) && (r.char <= u32(57)))
                  );
                  field_c_name := fname.replace(String.from("."), String.from("._"));
                  if(is_index_field, {
                    result.push_str("_");
                  });
                  result.push_string(field_c_name);
                  Option(String).Some(result)
                }
              )
            }
          )
        }
      )
    )
  )
});
/// Extract the receiver expression from a dot-dispatch `func_box`.
get_dispatch_receiver :: (fn(func_box : Box(AstExpr)) -> Option(AstExpr))(
  match(
    func_box.*,
    .Atom(_, _) => Option(AstExpr).None,
    .FnCall(_, _, dot_args, _, _) => dot_args.get(usize(0))
  )
);
/// Extract the method name string from a dot-dispatch `func_box`.
get_dispatch_method :: (fn(func_box : Box(AstExpr)) -> Option(String))(
  match(
    func_box.*,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, _, dot_args, _, _) => match(
      dot_args.get(usize(1)),
      .None => Option(String).None,
      .Some(method_expr) => match(
        method_expr,
        .Atom(_, mtok) => Option(String).Some(mtok.value),
        .FnCall(_, _, _, _, _) => Option(String).None
      )
    )
  )
);
func_box_static_type_app_method_is :: (fn(func_box : Box(AstExpr), type_name : str, method_name : str) -> bool)(
  func_box_is_dot_dispatch(func_box) &&
    match(
      get_dispatch_method(func_box),
      .None => false,
      .Some(found_method) => (found_method == method_name)
    ) &&
      match(
        get_dispatch_receiver(func_box),
        .None => false,
        .Some(recv_expr) => type_app_receiver_is(recv_expr, type_name)
      )
);
/// Handle method call `obj.method(args)` → C method call expression.
///
/// Two special cases support template string codegen:
///
/// - `x.to_string()` (zero args): the Yo parser emits this for every part of a
///   template string.  We strip the call and pass the receiver through, so
///   `"hello ".to_string()` → `"hello "` and `name.to_string()` → `name`.
///
/// - `a.+(b)` (one arg, Operator "+" as method): the Yo parser emits this to
///   chain template-string parts.  We emit `__yo_str_concat(a, b)` which is
///   defined in the generated C preamble.
///
/// All other method calls are emitted as `recv.method(args)`.
handle_method_call :: (
  fn(
    func_box : Box(AstExpr),
    args : ArrayList(AstExpr),
    ctx : CodegenContext,
    indent : String
  ) -> Option(String)
)({
  recv_opt := get_dispatch_receiver(func_box);
  method_opt := get_dispatch_method(func_box);
  match(
    recv_opt,
    .None => Option(String).None,
    .Some(recv_expr) => match(
      method_opt,
      .None => Option(String).None,
      .Some(method_name) => match(
        call_gen_expr(recv_expr, ctx, indent),
        .None => Option(String).None,
        .Some(recv_code) => cond(
          // Prototype lowering for standard Option/Result constructors. The
          // bootstrap codegen represents Some/Ok/Err as the payload value and
          // None as NULL; runtime methods below are lowered accordingly.
          (((recv_code == "io") && (method_name == "await")) && (args.len() == usize(1))) =>
            Option(String).Some(String.from("0")),
          (((recv_code == "Worker") && (method_name == "set_num_threads")) && (args.len() == usize(1))) =>
            Option(String).Some(String.from("0")),
          (((recv_code == "Worker") && (method_name == "spawn")) && (args.len() == usize(1))) =>
            Option(String).Some(String.from("0")),
          (((recv_code == "str") && (method_name == "from_raw_parts")) && (args.len() == usize(2))) =>
            match(
              args.get(usize(0)),
              .None => Option(String).None,
              .Some(str_ptr_e) => match(
                call_gen_expr(str_ptr_e, ctx, indent),
