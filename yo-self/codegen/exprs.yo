          (ctx.get_var_type(recv_code.as_str()).is_some() && ((method_name == "len") && (args.len() == usize(0)))) => match(
            ctx.get_var_type(recv_code.as_str()),
            .None => Option(String).None,
            .Some(recv_ty_for_len) => cond(
              (!(is_arraylist_c_type(recv_ty_for_len.as_str()))) => Option(String).None,
              true => {
