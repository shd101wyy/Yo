//! Function-level C code generation for the self-hosted Yo compiler.
//!
//! Phase 4d: generate a complete C function definition from a name,
//! parameter list, return type, and body expression.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr } :: import("../expr.yo");
{ CodegenContext } :: import("./context.yo");
{ generate_expr, build_typed_decl, ensure_arraylist_c_type, ensure_impl_fn_c_type } :: import("./exprs.yo");
build_param_list :: (
  fn(params : ArrayList(String), param_tys : ArrayList(String)) -> String
)({
  n_params := cond(
    (params.len() < param_tys.len()) => params.len(),
    true => param_tys.len()
  );
  sb := String.new();
  (i : usize) = usize(0);
  while(runtime(i < n_params), {
    if(i > usize(0), {
      sb.push_str(", ");
    });
    ty_s := match(param_tys.get(i),.Some(s) => s,.None => String.from("void*"));
    p_s := match(params.get(i),.Some(s) => s,.None => String.from("_p"));
    sb.push_string(build_typed_decl(ty_s.as_str(), p_s.as_str()));
    i = (i + usize(1));
  });
  sb
});
/// Emit a C forward declaration for a generated function into declarations.
emit_function_declaration :: (
  fn(
    name : str,
    ret_type : str,
    params : ArrayList(String),
    param_tys : ArrayList(String),
    ctx : *(CodegenContext)
  ) -> unit
)({
  ensure_arraylist_c_type(ctx, ret_type);
  ensure_impl_fn_c_type(ctx, ret_type);
  {
    n_pt := param_tys.len();
    (pt_i : usize) = usize(0);
    while(runtime(pt_i < n_pt), {
      match(
        param_tys.get(pt_i),
        .None => (),
        .Some(pt) => {
          ensure_arraylist_c_type(ctx, pt.as_str());
          ensure_impl_fn_c_type(ctx, pt.as_str());
        }
      );
      pt_i = (pt_i + usize(1));
    });
  };
  param_list := build_param_list(params, param_tys);
  ctx.*.emitter.emit_declaration("static ");
  ctx.*.emitter.emit_declaration(ret_type);
  ctx.*.emitter.emit_declaration(" ");
  ctx.*.emitter.emit_declaration(name);
  ctx.*.emitter.emit_declaration("(");
  ctx.*.emitter.emit_declaration_string(param_list);
  ctx.*.emitter.emit_declaration_line(");");
});
/// Emit a complete C function definition into `ctx.emitter.code`.
///
/// Signature format:
/// ```c
///   static ret_type name(ty0 p0, ty1 p1, ...) {
///     // body statements (emitted as side effects)
///     return last_expr;   // omitted when ret_type == "void" and last == "0"
///   }
/// ```
///
/// `params` and `param_tys` are parallel arrays (same length expected).
/// If they differ, the shorter length is used.
///
/// The `body` expression is passed to `generate_expr` with a two-space indent.
/// Any statements emitted during body codegen accumulate in `ctx.emitter`
/// directly (they appear between the `{` and `return` lines).
generate_function :: (
  fn(
    name : str,
    ret_type : str,
    params : ArrayList(String),
    param_tys : ArrayList(String),
    body : AstExpr,
    ctx : *(CodegenContext)
  ) -> unit
)({
  ensure_arraylist_c_type(ctx, ret_type);
  ensure_impl_fn_c_type(ctx, ret_type);
  {
    n_pt := param_tys.len();
    (pt_i : usize) = usize(0);
    while(runtime(pt_i < n_pt), {
      match(
        param_tys.get(pt_i),
        .None => (),
        .Some(pt) => {
          ensure_arraylist_c_type(ctx, pt.as_str());
          ensure_impl_fn_c_type(ctx, pt.as_str());
        }
      );
      pt_i = (pt_i + usize(1));
    });
  };
  // Build parameter list: "ty0 p0, ty1 p1, ..."
  n_params := cond(
    (params.len() < param_tys.len()) => params.len(),
    true => param_tys.len()
  );
  param_list := build_param_list(params, param_tys);
  // Register parameter types for type-cast detection (e.g. `i32(shape)` → `(int32_t)(shape.tag)`)
  // Also register struct fields for struct-typed parameters to support `open p` in function bodies.
  {
    (ip : usize) = usize(0);
    while(runtime(ip < n_params), {
      ty_p := match(param_tys.get(ip),.Some(s) => s,.None => String.from("void*"));
      p_p := match(params.get(ip),.Some(s) => s,.None => String.from("_p"));
      ctx.*.register_var_type(p_p.as_str(), ty_p.as_str());
      // If the parameter type is a registered struct, track open var fields
      match(
        ctx.*.get_struct_fields(ty_p.as_str()),
        .None => (),
        .Some(fcsv) => {
          ctx.*.track_open_var(p_p.as_str(), fcsv.as_str());
        }
      );
      ip = (ip + usize(1));
    });
  };
  // Track current function name so `recur(args)` can be emitted as `name(args)`.
  // Track return type so anonymous struct literals can use the named type.
  ctx.*.current_fn_name = String.from(name);
  ctx.*.current_fn_return_type = String.from(ret_type);
  // Emit: static ret_type name(params) {
  ctx.*.emitter.emit("static ");
  ctx.*.emitter.emit(ret_type);
  ctx.*.emitter.emit(" ");
  ctx.*.emitter.emit(name);
  ctx.*.emitter.emit("(");
  ctx.*.emitter.emit_string(param_list);
  ctx.*.emitter.emit_line(") {");
  // Generate body — side-effect statements go into ctx.emitter automatically
  indent := String.from("  ");
  body_val := generate_expr(body, ctx, indent);
  // Emit return (or a void expression as statement)
  cond(
    (ret_type == "void") => match(
      body_val,
      .None => (),
      .Some(last) => cond(
        // "0" is the sentinel for "nothing meaningful" — skip for void
        (last == String.from("0")) => (),
        true => {
          ctx.*.emitter.emit("  ");
          ctx.*.emitter.emit_string(last);
          ctx.*.emitter.emit_line(";");
        }
      )
    ),
    true => match(
      body_val,
      .None => ctx.*.emitter.emit_line("  /* codegen error: body returned None */"),
      .Some(last) => cond(
        // "0" is the sentinel for "nothing meaningful" (e.g., function ended with an
        // explicit `return` statement).  Skip the trailing `return(0);` — it would be
        // a type error for non-void return types, and the explicit return already ran.
        (last.as_str() == "0") => (),
        true => {
          ctx.*.emitter.emit("  return ");
          ctx.*.emitter.emit_string(last);
          ctx.*.emitter.emit_line(";");
        }
      )
    )
  );
  ctx.*.emitter.emit_line("}");
});
export(generate_function, emit_function_declaration);
