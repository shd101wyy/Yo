//! Function code-generation context types.
//!
//! This is the Yo counterpart of `src/codegen/functions/context.ts`. It keeps
//! the TypeScript field layout visible while adjacent codegen modules are
//! ported incrementally.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ HashSet } :: import("std/collections/hash_set");
{ AstExpr } :: import("../../expr.yo");
{ TypeValue } :: import("../../types/type.yo");
{ CodegenContext } :: import("../context.yo");
{ AwaitAnalysisResult, CapturedVariable } :: import("../../evaluator/async/await_analysis_types.yo");

/// Implicit parameter wrapper (mirrors `FunctionImplicitParameter` in `declarations.ts`).
FunctionImplicitParameter :: object(
  label : String,
  type_value : TypeValue,
  is_effect_row_spread : bool
);

/// Evidence parameter — represents an effect record member that becomes an
/// explicit C function pointer parameter via evidence passing.
EvidenceParameter :: object(
  /// The label of the implicit parameter, e.g. `raise_mod`.
  implicit_label : String,
  /// The field label within the module, e.g. `raise` or `errors__raise`.
  field_label : String,
  /// Path of field labels for navigating nested evidence records.
  field_path : ArrayList(String),
  /// The function type of the evidence field.
  field_function_type : TypeValue,
  /// The C parameter name: sanitized `{implicitLabel}_{fieldLabel}`.
  c_param_name : String
);

FunctionEntry :: object(
  value_id : String,
  c_name : String,
  effect_state_machine_info : Option(String),
  /// The Yo function type (`value.type` in TypeScript).
  type_value : TypeValue,
  /// `value.type.isClosure` — true for closure function types.
  is_closure : bool,
  /// `value.isEffectRecordMember` — true for effect record members.
  is_effect_record_member : bool,
  /// `value.isIoAsyncStateMachineClosure`.
  is_io_async_state_machine_closure : bool,
  /// `isComptimeFunction(value)` = `value.type.return.isCompileTimeOnly`.
  is_comptime_return : bool,
  /// `isFunctionTypeHardGeneric(value.type)` — comptime/forall/SomeType params.
  is_hard_generic : bool,
  /// `isFunctionTypeGeneric(value.type)` — includes implicit params.
  is_generic : bool,
  /// `isFunctionValueWithOnlyBuiltinYoInlineFunctionCall(value)`.
  has_builtin_inline_call : bool,
  /// `value.body?.$?.effectAnalysis?.hasEffects`.
  is_effectful : bool,
  /// `value.specializedType` if any.
  specialized_type : Option(TypeValue),
  /// `value.specializedFunctionCaches?.length ?? 0`.
  specialized_function_caches_len : usize,
  /// `value.body` if any.
  body : Option(AstExpr)
);

ExternFunctionEntry :: object(
  function_type : TypeValue,
  c_name : String,
  c_include : Option(String),
  /// `type.isExtern` — "yo", "c", or "".
  is_extern : String
);

AsyncStateMachineContext :: object(
  function_value_id : String,
  function_name : String,
  function_type : TypeValue,
  body : AstExpr,
  captured_variables : ArrayList(CapturedVariable),
  await_analysis : AwaitAnalysisResult,
  state_struct_name : String,
  state_function_name : String,
  future_type : TypeValue
);

ContinuationVariableInfo :: object(
  type_name : String,
  pointer_name : String
);

DeferredAsyncBlock :: object(
  lambda_expr : AstExpr,
  call_expr : AstExpr,
  result_var : String,
  await_analysis : AwaitAnalysisResult
);

AsyncCondBranchSegment :: object(
  condition : AstExpr,
  body_expr : AstExpr,
  next_state : i32,
  is_else : bool
);

ChainedAsyncCondBranches :: object(
  branches : ArrayList(AsyncCondBranchSegment)
);

AsyncCondBranchInfo :: object(
  condition : AstExpr,
  then_branch : AstExpr,
  else_branch : AstExpr,
  chained_branches : Option(ChainedAsyncCondBranches),
  await_analysis : AwaitAnalysisResult,
  result_var : String,
  result_type : TypeValue,
  then_state : i32,
  else_state : i32,
  continuation_state : i32,
  needs_result_storage : bool
);

AsyncWhileLoopInfo :: object(
  condition : AstExpr,
  body : AstExpr,
  await_analysis : AwaitAnalysisResult,
  loop_head_state : i32,
  body_state : i32,
  continuation_state : i32,
  outer_while_loop : Option(Box(Self))
);

AsyncDeferResourceInfo :: object(
  name : String,
  type_value : TypeValue
);

AsyncDeferFrameInfo :: object(
  resources : ArrayList(AsyncDeferResourceInfo),
  cleanup_states : ArrayList(i32)
);

AsyncDeferInfo :: object(
  frames : ArrayList(AsyncDeferFrameInfo)
);

AsyncEffectHandlerInfo :: object(
  expr : AstExpr,
  state_id : i32,
  state_name : String,
  continuation_state : i32,
  await_analysis : AwaitAnalysisResult
);

AsyncReturnContext :: object(
  state_machine : AsyncStateMachineContext,
  final_state : i32,
  result_field : String,
  result_type : TypeValue
);

FunctionGenerationContext :: object(
  /// Embedded base codegen context. TypeScript expresses this as
  /// `extends CodeGenContext`; Yo models it compositionally for now.
  base : CodegenContext,
  functions : HashMap(String, FunctionEntry),
  extern_functions : HashMap(String, ExternFunctionEntry),
  current_function_name : String,
  inside_async_function : bool,
  async_state_machine : Option(AsyncStateMachineContext),
  async_current_state : Option(i32),
  async_result_var : Option(String),
  async_continuation_state : Option(i32),
  async_state_counter : Option(Box(i32)),
  async_continuation_variables : Option(HashMap(String, ContinuationVariableInfo)),
  async_await_state_map : Option(HashMap(String, i32)),
  async_deferred_blocks : Option(ArrayList(DeferredAsyncBlock)),
  async_cond_branches : Option(HashMap(String, AsyncCondBranchInfo)),
  async_cond_branch_counter : Option(Box(i32)),
  async_while_loops : Option(HashMap(String, AsyncWhileLoopInfo)),
  async_while_loop_stack : Option(ArrayList(AsyncWhileLoopInfo)),
  async_while_loop_counter : Option(Box(i32)),
  async_defer_stack : Option(AsyncDeferInfo),
  async_effect_handlers : Option(ArrayList(AsyncEffectHandlerInfo)),
  async_return_context : Option(AsyncReturnContext),
  async_handler_result_var : Option(String),
  current_function_return_type : Option(TypeValue),
  current_function_type : Option(TypeValue),
  generic_param_names : HashSet(String),
  original_forall_parameters : Option(ArrayList(String)),
  lambda_body_overrides : Option(HashMap(String, AstExpr)),
  original_function_type : Option(TypeValue),
  original_params : Option(ArrayList(String)),
  evidence_parameters : HashMap(String, ArrayList(EvidenceParameter)),
  direct_throw_handler_params : Option(HashMap(String, String)),
  current_effect_operation_members : Option(HashMap(String, String)),
  /// `context.usesAsync` — true when async functions are present.
  uses_async : bool,
  /// `context.usesParallelism` — true when parallel runtime is used.
  uses_parallelism : bool,
  /// Pre-sanitized C names of Yo-exported functions for label checking.
  exported_function_labels : ArrayList(String)
);

export(
  FunctionImplicitParameter,
  EvidenceParameter,
  FunctionEntry,
  ExternFunctionEntry,
  AsyncStateMachineContext,
  ContinuationVariableInfo,
  DeferredAsyncBlock,
  AsyncCondBranchSegment,
  ChainedAsyncCondBranches,
  AsyncCondBranchInfo,
  AsyncWhileLoopInfo,
  AsyncDeferResourceInfo,
  AsyncDeferFrameInfo,
  AsyncDeferInfo,
  AsyncEffectHandlerInfo,
  AsyncReturnContext,
  FunctionGenerationContext
);
