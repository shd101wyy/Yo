//! Function declaration emission — mirrors `src/codegen/functions/declarations.ts`.
//!
//! PORT STATUS (incremental, plans/BOOTSTRAPPING_CODEGEN.md): this file
//! carries the EvidenceParameter slice (used by functions/collection.ts) and
//! generate_function_prototype. The remaining declaration emitters
//! (generateFunctionDeclarations / generateFunctionDeclaration / object+closure
//! constructor declarations / specialized declarations) are pending.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_function_type, is_struct_type, is_module_type, is_object_type } :: import("../../types/guards.yo");
{ type_contains_some_type } :: import("../../types/utils.yo");
{ CodeGenContext, get_type_string, sanitize_for_c_identifier, get_runtime_struct_fields, RuntimeStructField } :: import("../utils/index.yo");
/// One evidence parameter threaded into a function that uses effect-record
/// evidence passing. Mirrors the `EvidenceParameter` interface.
EvidenceParameter :: object(
  /// The label of the implicit parameter (e.g. "raise_mod").
  implicit_label : String,
  /// The field label within the module (e.g. "raise", or "errors__raise" for nested).
  field_label : String,
  /// Path of field labels for navigating nested evidence records.
  field_path : ArrayList(String),
  /// The function type (`Func` TypeValue) of the evidence field.
  field_function_type : TypeValue,
  /// The C parameter name: sanitized "{implicit_label}__{field_label}".
  c_param_name : String
);
/// Join a path of field labels with "__". Mirrors TS `fieldPath.join("__")`.
_join_double_underscore :: (fn(parts : ArrayList(String)) -> String)({
  out := String.from("");
  n := parts.len();
  (i : usize) = usize(0);
  while(i < n, {
    if(i > usize(0), {
      out.push_str("__");
    });
    match(parts.get(i),.Some(p) => out.push_string(p),.None => ());
    i = (i + usize(1));
  });
  out
});
/// Recursively collect evidence parameters from an effect-record type.
/// For function-typed fields, appends an EvidenceParameter; for record-typed
/// fields, recurses into the nested record. Mirrors `collectEvidenceFromRecord`.
/// (Defined before get_evidence_parameters — Yo has no forward references.)
collect_evidence_from_record :: (
  fn(
    implicit_label : String,
    effect_record_type : TypeValue,
    path_prefix : ArrayList(String),
    result : ArrayList(EvidenceParameter)
  ) -> unit
)(
  match(
    effect_record_type,
    .Struct({ field_labels, field_types }) => {
      n := field_labels.len();
      (i : usize) = usize(0);
      while(i < n, {
        field_label := match(field_labels.get(i),.Some(l) => l,.None => String.from(""));
        field_ty := match(field_types.get(i),.Some(t) => t,.None => TypeValue.Unit);
        cond(
          is_function_type(field_ty) => {
            // Forall function fields are passed as void* and cast at each call site.
            field_path := path_prefix.clone();
            field_path.push(field_label.clone());
            joined := _join_double_underscore(field_path.clone());
            c_param := String.from("");
            c_param.push_string(implicit_label.clone());
            c_param.push_str("__");
            c_param.push_string(joined.clone());
            result.push(
              EvidenceParameter(
                implicit_label : implicit_label.clone(),
                field_label : joined,
                field_path : field_path,
                field_function_type : field_ty,
                c_param_name : sanitize_for_c_identifier(c_param, false)
              )
            );
          },
          (is_module_type(field_ty) || is_struct_type(field_ty)) => {
            nested_prefix := path_prefix.clone();
            nested_prefix.push(field_label.clone());
            recur(implicit_label.clone(), field_ty, nested_prefix, result);
          },
          true => ()
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  )
);
/// Extract evidence parameters from a function type's implicit parameters.
/// Mirrors `getEvidenceParameters`.
///
/// DIVERGENCE: TS hardcodes `expandImplicitParameters([])` (the implicit-param
/// expansion is currently a no-op — effects evidence is handled elsewhere), so
/// this yields no evidence parameters. `function_type` is unused (mirrors the
/// TS `_functionType`). `collect_evidence_from_record` above is the real logic
/// for when implicit expansion is implemented. yo-self flattened TS's
/// `FunctionParameter` to parallel arrays, so `expandImplicitParameters`
/// (an identity over `FunctionParameter[]`) is folded into this no-op.
get_evidence_parameters :: (fn(_function_type : TypeValue) -> ArrayList(EvidenceParameter))(
  ArrayList(EvidenceParameter).new()
);
/// Generate a C function prototype string `<ret> <cName>(<params>)`.
/// Mirrors `generateFunctionPrototype`.
///
/// `override_return_type` (`.Some(s)` overrides the computed return type) and
/// the recursion for function-pointer parameters use the callee-name slot
/// directly (`(*name)`) instead of TS's `(*)`+string-replace.
///
/// DIVERGENCES (yo-self Func model): the `param.isCompileTimeOnly` filter is a
/// no-op (yo-self Func.param_types are the runtime params); the `isClosure`
/// closure-context param is omitted (Func has no is_closure — closures are
/// Phase 3); the SomeType-Future resolvedConcreteType param branch is omitted
/// (Gap 6); evidence params come from get_evidence_parameters (currently
/// empty — see above).
generate_function_prototype :: (
  fn(function_type : TypeValue, c_function_name : String, context : CodeGenContext, override_return_type : Option(String)) -> String
)(
  match(
    function_type,
    .Func({ param_types, param_is_ref, result, result_is_ref }) => {
      return_type_str := match(
        override_return_type,
        .Some(s) => s,
        .None => {
          base := get_type_string(result.*, context);
          if(result_is_ref, {
            base.push_str("*");
          });
          base
        }
      );
      params := String.from("");
      n := param_types.len();
      (i : usize) = usize(0);
      while(i < n, {
        if(i > usize(0), {
          params.push_str(", ");
        });
        pt := match(param_types.get(i),.Some(t) => t,.None => TypeValue.Unit);
        pname := String.from("param");
        pname.push_string(i.to_string());
        cond(
          is_function_type(pt) => {
            // Function-pointer parameter: <ret> (*paramN)(<paramTypes>).
            callee := String.from("(*");
            callee.push_string(pname.clone());
            callee.push_str(")");
            params.push_string(recur(pt, callee, context, Option(String).None));
          },
          true => {
            pts := get_type_string(pt, context);
            is_ref := match(param_is_ref.get(i),.Some(b) => b,.None => false);
            if(is_ref, {
              pts.push_str("*");
            });
            params.push_string(pts);
            params.push_str(" ");
            params.push_string(pname.clone());
          }
        );
        i = (i + usize(1));
      });
      out := return_type_str.clone();
      out.push_str(" ");
      out.push_string(c_function_name.clone());
      out.push_str("(");
      out.push_string(params);
      out.push_str(")");
      out
    },
    _ => {
      // Not a function type — emit a void() prototype as a safe fallback.
      r := String.from("void ");
      r.push_string(c_function_name.clone());
      r.push_str("(void)");
      r
    }
  )
);
/// True if any runtime field of the struct contains a SomeType (generic).
/// Same predicate the constructor BODY emitter (constructors.yo) uses, so the
/// forward declaration and the definition agree on which objects get a ctor.
_object_decl_has_generic_fields :: (fn(fields : ArrayList(RuntimeStructField)) -> bool)({
  n := fields.len();
  (i : usize) = usize(0);
  (found : bool) = false;
  while((i < n) && !(found), {
    match(
      fields.get(i),
      .Some(field) => if(type_contains_some_type(field.ty), {
        found = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
/// Generate constructor + RC/GC forward declarations for objects. Mirrors
/// `generateObjectConstructorDeclarations`.
///
/// DIVERGENCE (decl/def consistency): the per-object parameter list uses
/// `get_runtime_struct_fields` (the same source the constructor BODY in
/// constructors.yo uses), not the raw `type.fields` TS reads here — for objects
/// these coincide, and sharing the source guarantees the forward declaration's
/// parameter list matches the definition's exactly.
generate_object_constructor_declarations :: (fn(context : CodeGenContext) -> unit)({
  em := context.emitter;
  // Builtin reference counting functions (static — single C file).
  em.emit_declaration_line("static inline void __yo_decr_rc(void* ptr); // Decrement reference count");
  em.emit_declaration_line("static inline void* __yo_incr_rc(void* ptr); // Increment reference count");
  // GC function declarations.
  em.emit_declaration_line("static void __yo_gc_register(void* ptr); // Register object for cycle detection");
  em.emit_declaration_line("static void __yo_gc_unregister(void* ptr); // Unregister object from cycle detection");
  em.emit_declaration_line("static void __yo_gc_collect(); // Trigger garbage collection");
  em.emit_declaration_line("static void __yo_gc_init_thread(); // Initialize thread-local GC state (for worker threads)");
  em.emit_declaration_line("static void __yo_cleanup_thread_gc(); // Clean up thread-local GC state");
  em.emit_declaration_line("static void __yo_init_process_cleanup(void); // Initialize process cleanup");
  // Per-object constructor declarations.
  vals := context.types.values();
  (go : bool) = true;
  while(go, {
    match(
      vals.next(),
      .Some(entry) => if(is_object_type(entry.ty), {
        runtime_fields := get_runtime_struct_fields(entry.ty);
        if(!(_object_decl_has_generic_fields(runtime_fields)), {
          params := String.from("");
          nf := runtime_fields.len();
          (pi : usize) = usize(0);
          while(pi < nf, {
            match(
              runtime_fields.get(pi),
              .Some(field) => {
                if(pi > usize(0), {
                  params.push_str(", ");
                });
                params.push_string(get_type_string(field.ty, context));
                params.push_str(" ");
                params.push_string(sanitize_for_c_identifier(field.label.clone(), false));
              },
              .None => ()
            );
            pi = (pi + usize(1));
          });
          line := String.from("static ");
          line.push_string(entry.c_name.clone());
          line.push_str("* __yo_new_");
          line.push_string(entry.c_name.clone());
          line.push_str("(");
          line.push_string(params);
          line.push_str("); // Constructor");
          em.emit_declaration_string_line(line);
        });
      }),
      .None => {
        go = false;
      }
    );
  });
});
/// Generate constructor declarations for closures. No-op: Impl(Fn(...)) closures
/// use concrete capture structs + direct calls; Dyn(Fn(...)) uses dyn
/// constructors generated elsewhere. Faithful port of the TS no-op.
generate_closure_constructor_declarations :: (fn(context : CodeGenContext) -> unit)(
  ()
);
/// Generate forward declarations for closure capture-dispose functions. Mirrors
/// `generateCaptureDisposeFunctionDeclarations`. DEFERRED: driven by
/// closureCaptureMap, which yo-self's context does not model yet (Phase 5
/// closure support) — the map is empty for the corpus, so this emits nothing.
generate_capture_dispose_function_declarations :: (fn(context : CodeGenContext) -> unit)(
  ()
);
/// Generate vtable instance declarations for closures. No-op: closures create
/// vtables dynamically (no static vtable instances). Faithful port of the TS no-op.
generate_closure_vtable_declarations :: (fn(context : CodeGenContext) -> unit)(
  ()
);
export(EvidenceParameter, collect_evidence_from_record, get_evidence_parameters, generate_function_prototype, generate_object_constructor_declarations, generate_closure_constructor_declarations, generate_capture_dispose_function_declarations, generate_closure_vtable_declarations);
