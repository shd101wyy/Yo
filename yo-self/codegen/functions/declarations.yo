//! Function declaration support types.
//!
//! Mirrors the evidence-parameter model and extraction helpers from
//! `src/codegen/functions/declarations.ts`. The full declarations driver is
//! still pending and will be ported as the surrounding context catches up.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ TypeValue } :: import("../../types/definitions.yo");
{ type_to_string } :: import("../../types/string.yo");
{ CodegenContext } :: import("../context.yo");
{ type_value_to_c_field } :: import("../types/generation.yo");
{
  FunctionImplicitParameter,
  EvidenceParameter,
  FunctionEntry,
  ExternFunctionEntry,
  FunctionGenerationContext
} :: import("./context.yo");
{ sanitize_for_c_identifier } :: import("../utils/index.yo");

/// Format a C function prototype:
///   `<return_type> <c_function_name>(<params_joined>)`
/// Pure string composition — the tail return of `generate_function_prototype`.
/// `params_joined` is the pre-joined comma-separated parameter list.
format_fn_prototype :: (
  fn(return_type : String, c_function_name : String, params_joined : String) -> String
)((return_type + String.from(" ")) + ((c_function_name + String.from("(")) + (params_joined + String.from(")"))));
/// Format a C parameter: `<c_type> <param_name>`. Used for both the
/// function-prototype parameter list and constructor parameter list.
format_fn_param :: (fn(c_type : String, param_name : String) -> String)(
  (c_type + String.from(" ")) + param_name
);
/// Format an extern-C function declaration line:
///   `<linkage_prefix><prototype>; // <yo_type_str>`
format_fn_declaration_with_comment :: (
  fn(linkage_prefix : String, prototype : String, yo_type_str : String) -> String
)(((linkage_prefix + prototype) + String.from("; // ")) + yo_type_str);
/// Format a struct constructor forward declaration line:
///   `static <c_struct_name>* <ctor_name>(<params_joined>); // Constructor`
format_struct_ctor_decl :: (
  fn(c_struct_name : String, ctor_name : String, params_joined : String) -> String
)(
  (((String.from("static ") + c_struct_name) + String.from("* ")) + ctor_name) +
    ((String.from("(") + params_joined) + String.from("); // Constructor"))
);
/// Format a closure dispose forward declaration line:
///   `static void <dispose_fn_name>(void* closure_ptr);`
format_closure_dispose_decl :: (fn(dispose_fn_name : String) -> String)(
  (String.from("static void ") + dispose_fn_name) + String.from("(void* closure_ptr);")
);
/// Format a default positional parameter name when the source label is
/// empty or missing: `param<idx>`. Mirrors the TS fallback used by
/// `generate_function_prototype` for unnamed parameters.
format_default_param_name :: (fn(i : usize) -> String)(
  String.from("param") + i.to_string()
);
copy_path_with_label_ :: (fn(path_prefix : ArrayList(String), label : String) -> ArrayList(String))({
  path := ArrayList(String).new();
  i := usize(0);
  while(i < path_prefix.len(), i = (i + usize(1)), {
    match(
      path_prefix.get(i),
      .Some(segment) => {
        path.push(segment);
      },
      .None => ()
    );
  });
  path.push(label);
  path
});

collect_evidence_from_record_ :: (
  fn(
    implicit_label : String,
    field_labels : ArrayList(String),
    field_types : ArrayList(TypeValue),
    path_prefix : ArrayList(String),
    result : ArrayList(EvidenceParameter)
  ) -> unit
)({
  i := usize(0);
  while(i < field_labels.len(), i = (i + usize(1)), {
    label_opt := field_labels.get(i);
    type_opt := field_types.get(i);
    match(
      label_opt,
      .Some(field_label) => match(
        type_opt,
        .Some(field_type) => match(
          field_type,
          .Func({ result : _ }) => {
            field_path := copy_path_with_label_(path_prefix, field_label);
            sep := String.from("__");
            joined_field_label := sep.join(field_path);
            result.push(
              EvidenceParameter(
                implicit_label : implicit_label,
                field_label : joined_field_label,
                field_path : field_path,
                field_function_type : field_type,
                c_param_name : sanitize_for_c_identifier((implicit_label + String.from("__")) + joined_field_label)
              )
            );
          },
          .Struct({ field_labels : nested_labels, field_types : nested_types }) => {
            nested_path := copy_path_with_label_(path_prefix, field_label);
            recur(implicit_label, nested_labels, nested_types, nested_path, result);
          },
          _ => ()
        ),
        .None => ()
      ),
      .None => ()
    );
  });
});

expand_implicit_parameters :: (fn(function_type : TypeValue) -> ArrayList(FunctionImplicitParameter))({
  expanded := ArrayList(FunctionImplicitParameter).new();
  match(
    function_type,
    .Func({ implicit_labels, implicit_types, implicit_spreads }) => {
      i := usize(0);
      while(i < implicit_labels.len(), i = (i + usize(1)), {
        label_opt := implicit_labels.get(i);
        type_opt := implicit_types.get(i);
        spread := match(implicit_spreads.get(i),.Some(value) => value,.None => false);
        match(
          label_opt,
          .Some(label) => match(
            type_opt,
            .Some(type_value) => cond(
              spread => match(
                type_value,
                .EffectsRowT(row_labels, row_types) => {
                  j := usize(0);
                  while(j < row_labels.len(), j = (j + usize(1)), {
                    row_label_opt := row_labels.get(j);
                    row_type_opt := row_types.get(j);
                    match(
                      row_label_opt,
                      .Some(row_label) => match(
                        row_type_opt,
                        .Some(row_type) => {
                          expanded.push(
                            FunctionImplicitParameter(
                              label : row_label,
                              type_value : row_type,
                              is_effect_row_spread : false
                            )
                          );
                        },
                        .None => ()
                      ),
                      .None => ()
                    );
                  });
                },
                _ => ()
              ),
              true => {
                expanded.push(
                  FunctionImplicitParameter(
                    label : label,
                    type_value : type_value,
                    is_effect_row_spread : false
                  )
                );
              }
            ),
            .None => ()
          ),
          .None => ()
        );
      });
    },
    _ => ()
  );
  expanded
});

get_evidence_parameters :: (fn(function_type : TypeValue) -> ArrayList(EvidenceParameter))({
  result := ArrayList(EvidenceParameter).new();
  implicits := expand_implicit_parameters(function_type);
  i := usize(0);
  while(i < implicits.len(), i = (i + usize(1)), {
    match(
      implicits.get(i),
      .Some(implicit) => match(
        implicit.type_value,
        .Struct({ field_labels : labels, field_types : types }) => {
          collect_evidence_from_record_(implicit.label, labels, types, ArrayList(String).new(), result);
        },
        .Func({ result : _ }) => {
          field_path := ArrayList(String).new();
          field_path.push(implicit.label);
          result.push(
            EvidenceParameter(
              implicit_label : implicit.label,
              field_label : implicit.label,
              field_path : field_path,
              field_function_type : implicit.type_value,
              c_param_name : sanitize_for_c_identifier(implicit.label)
            )
          );
        },
        _ => ()
      ),
      .None => ()
    );
  });
  result
});

type_value_to_c_name_ :: (fn(type_value : TypeValue) -> String)(
  match(
    type_value_to_c_field(type_value),
    .Some(c_name) => c_name,
    .None => String.from("void*")
  )
);

function_type_has_forall_ :: (fn(function_type : TypeValue) -> bool)(
  match(
    function_type,
    .Func({ forall_labels }) => (forall_labels.len() > usize(0)),
    _ => false
  )
);

generate_function_prototype :: (
  fn(
    function_type : TypeValue,
    c_function_name : String,
    override_return_type : Option(String),
    original_function_type : Option(TypeValue)
  ) -> String
)({
  match(
    function_type,
    .Func({ param_labels, param_types, result : result_type }) => {
      return_type_str := match(
        override_return_type,
        .Some(override_value) => override_value,
        .None => type_value_to_c_name_(result_type.*)
      );
      param_strings := ArrayList(String).new();
      i := usize(0);
      while(i < param_types.len(), i = (i + usize(1)), {
        param_type := match(param_types.get(i),.Some(value) => value,.None => TypeValue.Unit);
        raw_param_name := match(
          param_labels.get(i),
          .Some(label) => cond(
            label.is_empty() => format_default_param_name(i),
            true => label
          ),
          .None => format_default_param_name(i)
        );
        param_name := sanitize_for_c_identifier(raw_param_name);
        match(
          param_type,
          .Func({ result : _ }) => {
            function_pointer_type := recur(param_type, String.from("(*)"),.None,.None).replace(String.from(" (*)("), (String.from(" (*") + param_name) + String.from(")("));
            param_strings.push(function_pointer_type);
          },
          _ => {
            param_strings.push(format_fn_param(type_value_to_c_name_(param_type), param_name));
          }
        );
      });
      evidence_source := match(original_function_type,.Some(original) => original,.None => function_type);
      evidence_params := get_evidence_parameters(evidence_source);
      j := usize(0);
      while(j < evidence_params.len(), j = (j + usize(1)), {
        match(
          evidence_params.get(j),
          .Some(ep) => cond(
            function_type_has_forall_(ep.field_function_type) => {
              param_strings.push(String.from("void* ") + ep.c_param_name);
            },
            true => {
              fn_ptr_proto := recur(ep.field_function_type, String.from("(*)"),.None,.None).replace(String.from(" (*)("), (String.from(" (*") + ep.c_param_name) + String.from(")("));
              param_strings.push(fn_ptr_proto);
            }
          ),
          .None => ()
        );
      });
      sep := String.from(", ");
      return(format_fn_prototype(return_type_str, c_function_name, sep.join(param_strings)));
    },
    _ => return((String.from("void ") + c_function_name) + String.from("()"))
  );
});

is_rc_function_name_ :: (fn(c_function_name : String) -> bool)(
  c_function_name.contains(String.from("___drop")) || (c_function_name.contains(String.from("___dup")) || c_function_name.contains(String.from("___dispose")))
);

function_declaration_linkage_prefix :: (
  fn(c_function_name : String, is_extern : bool, is_exported_by_name : bool) -> String
)(
  cond(
    is_extern => String.from("extern "),
    (is_exported_by_name || (c_function_name == String.from("__yo_user_main"))) => String.from(""),
    is_rc_function_name_(c_function_name) => String.from("static inline __attribute__((always_inline)) "),
    true => String.from("static inline ")
  )
);

generate_function_declaration :: (
  fn(
    function_type : TypeValue,
    c_function_name : String,
    is_extern : bool,
    ctx : CodegenContext,
    override_return_type : Option(String),
    original_function_type : Option(TypeValue),
    is_exported_by_name : bool
  ) -> unit
)({
  function_prototype := generate_function_prototype(function_type, c_function_name, override_return_type, original_function_type);
  linkage_prefix := function_declaration_linkage_prefix(c_function_name, is_extern, is_exported_by_name);
  yo_type_str := type_to_string(function_type);
  ctx.emitter.emit_declaration_string_line(
    format_fn_declaration_with_comment(linkage_prefix, function_prototype, yo_type_str)
  );
});

type_value_contains_some_type_ :: (fn(type_value : TypeValue) -> bool)(
  match(
    type_value,
    .SomeT(_, _, _, _, _, _, _, _, _, _) => true,
    .TypeAppT(_, _) => true,
    .Pointer(child) => recur(child.*),
    .Slice(child) => recur(child.*),
    .Array(child, _, _) => recur(child.*),
    .ComptimeListT(child) => recur(child.*),
    .IsoT(child) => recur(child.*),
    .Tuple(_, tuple_field_types) => {
      i := usize(0);
      found := false;
      while((i < tuple_field_types.len()) && (!(found)), {
        match(
          tuple_field_types.get(i),
          .Some(field_type) => {
            found = recur(field_type);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    .Func({ forall_types, param_types, implicit_types, where_types, result : result_type }) => {
      found := false;
      i := usize(0);
      while((i < forall_types.len()) && (!(found)), {
        match(
          forall_types.get(i),
          .Some(child) => {
            found = recur(child);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      i = usize(0);
      while((i < param_types.len()) && (!(found)), {
        match(
          param_types.get(i),
          .Some(child) => {
            found = recur(child);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      i = usize(0);
      while((i < implicit_types.len()) && (!(found)), {
        match(
          implicit_types.get(i),
          .Some(child) => {
            found = recur(child);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      i = usize(0);
      while((i < where_types.len()) && (!(found)), {
        match(
          where_types.get(i),
          .Some(child) => {
            found = recur(child);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      found || recur(result_type.*)
    },
    .Struct({ field_types : struct_field_types }) => {
      i := usize(0);
      found := false;
      while((i < struct_field_types.len()) && (!(found)), {
        match(
          struct_field_types.get(i),
          .Some(child) => {
            found = recur(child);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    .EnumT(_, _, _, variant_fields, _, _, _) => {
      i := usize(0);
      found := false;
      while((i < variant_fields.len()) && (!(found)), {
        match(
          variant_fields.get(i),
          .Some(fields) => {
            j := usize(0);
            while((j < fields.len()) && (!(found)), {
              match(
                fields.get(j),
                .Some(child) => {
                  found = recur(child);
                },
                .None => ()
              );
              j = (j + usize(1));
            });
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    .Union(_, _, union_field_types) => {
      i := usize(0);
      found := false;
      while((i < union_field_types.len()) && (!(found)), {
        match(
          union_field_types.get(i),
          .Some(child) => {
            found = recur(child);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    .TraitT(_, _, _, _, _, _, _, _) => false,
    .EffectsRowT(_, implicit_types) => {
      i := usize(0);
      found := false;
      while((i < implicit_types.len()) && (!(found)), {
        match(
          implicit_types.get(i),
          .Some(child) => {
            found = recur(child);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    .DynT(required_trait_types, _, negative_trait_types, _) => {
      i := usize(0);
      found := false;
      while((i < required_trait_types.len()) && (!(found)), {
        match(
          required_trait_types.get(i),
          .Some(child) => {
            found = recur(child);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      i = usize(0);
      while((i < negative_trait_types.len()) && (!(found)), {
        match(
          negative_trait_types.get(i),
          .Some(child) => {
            found = recur(child);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    .FnTraitT(_, _, call_param_types, call_result, _, implicit_types, _) => {
      found := recur(call_result.*);
      i := usize(0);
      while((i < call_param_types.len()) && (!(found)), {
        match(
          call_param_types.get(i),
          .Some(child) => {
            found = recur(child);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      i = usize(0);
      while((i < implicit_types.len()) && (!(found)), {
        match(
          implicit_types.get(i),
          .Some(child) => {
            found = recur(child);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    .FutureTraitT(_, output, _, effect_types, _) => {
      found := recur(output.*);
      i := usize(0);
      while((i < effect_types.len()) && (!(found)), {
        match(
          effect_types.get(i),
          .Some(child) => {
            found = recur(child);
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    _ => false
  )
);

field_types_contain_some_type_ :: (fn(field_types : ArrayList(TypeValue)) -> bool)({
  i := usize(0);
  found := false;
  while((i < field_types.len()) && (!(found)), {
    match(
      field_types.get(i),
      .Some(field_type) => {
        found = type_value_contains_some_type_(field_type);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});

generate_object_constructor_declarations :: (fn(ctx : CodegenContext) -> unit)({
  ctx.emitter.emit_declaration_line("static inline void __yo_decr_rc(void* ptr); // Decrement reference count");
  ctx.emitter.emit_declaration_line("static inline void* __yo_incr_rc(void* ptr); // Increment reference count");
  ctx.emitter.emit_declaration_line("static void __yo_gc_register(void* ptr); // Register object for cycle detection");
  ctx.emitter.emit_declaration_line("static void __yo_gc_unregister(void* ptr); // Unregister object from cycle detection");
  ctx.emitter.emit_declaration_line("static void __yo_gc_collect(); // Trigger garbage collection");
  ctx.emitter.emit_declaration_line("static void __yo_gc_init_thread(); // Initialize thread-local GC state (for worker threads)");
  ctx.emitter.emit_declaration_line("static void __yo_cleanup_thread_gc(); // Clean up thread-local GC state");
  ctx.emitter.emit_declaration_line("static void __yo_init_process_cleanup(void); // Initialize process cleanup");

  iter := ctx.types.values();
  more := true;
  while(more, {
    match(
      iter.next(),
      .None => {
        more = false;
      },
      .Some(entry) => match(
        entry.type_value,
        .Struct({ field_labels, field_types, is_reference_semantics }) => cond(
          (is_reference_semantics && (!(field_types_contain_some_type_(field_types)))) => {
            constructor_name := (String.from("__yo_new_") + entry.c_name);
            param_strings := ArrayList(String).new();
            i := usize(0);
            while(i < field_types.len(), i = (i + usize(1)), {
              match(
                field_types.get(i),
                .Some(field_type) => {
                  raw_field_name := match(field_labels.get(i),.Some(label) => label,.None => (String.from("_f") + i.to_string()));
                  field_name := sanitize_for_c_identifier(raw_field_name);
                  param_strings.push(format_fn_param(type_value_to_c_name_(field_type), field_name));
                },
                .None => ()
              );
            });
            sep := String.from(", ");
            ctx.emitter.emit_declaration_string_line(
              format_struct_ctor_decl(entry.c_name, constructor_name, sep.join(param_strings))
            );
          },
          true => ()
        ),
        _ => ()
      )
    );
  });
});

generate_closure_constructor_declarations :: (fn(_ctx : CodegenContext) -> unit)(());

generate_capture_dispose_function_declarations :: (fn(ctx : CodegenContext) -> unit)({
  iter := ctx.closure_capture_map.keys();
  more := true;
  while(more, {
    match(
      iter.next(),
      .None => {
        more = false;
      },
      .Some(closure_instance_id) => {
        dispose_function_name := (String.from("__yo_dispose_closure_") + closure_instance_id);
        ctx.emitter.emit_declaration_string_line(format_closure_dispose_decl(dispose_function_name));
      }
    );
  });
});

generate_closure_vtable_declarations :: (fn(_ctx : CodegenContext) -> unit)(());

/// Returns true when `name` is one of the threading macro wrapper functions
/// that must not get a separate `extern` declaration.
is_threading_macro_function_ :: (fn(name : str) -> bool)(
  cond(
    (name == "__yo_mutex_init") => true,
    (name == "__yo_mutex_destroy") => true,
    (name == "__yo_mutex_lock") => true,
    (name == "__yo_mutex_unlock") => true,
    (name == "__yo_cond_init") => true,
    (name == "__yo_cond_destroy") => true,
    (name == "__yo_cond_wait") => true,
    (name == "__yo_cond_signal") => true,
    (name == "__yo_cond_broadcast") => true,
    (name == "__yo_thread_join") => true,
    (name == "__yo_thread_self") => true,
    true => false
  )
);

/// Returns true when any type in `implicit_types` is a function type (`Func`).
/// Mirrors the `isFunctionType` check in `generateFunctionDeclarations`.
implicit_types_contain_func_type_ :: (fn(implicit_types : ArrayList(TypeValue)) -> bool)({
  i := usize(0);
  found := false;
  while((i < implicit_types.len()) && !(found), {
    match(
      implicit_types.get(i),
      .Some(it) => {
        found = match(it,.Func({ result : _ }) => true, _ => false);
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});

/// Returns true when any evidence parameter of `function_type` has a
/// `field_function_type` with forall parameters.  Mirrors the
/// `origEvidenceParams.some(ep => ep.fieldFunctionType.forallParameters.length > 0)`
/// check in `generateSpecializedFunctionDeclarations`.
evidence_params_have_forall_ :: (fn(function_type : TypeValue) -> bool)({
  evid := get_evidence_parameters(function_type);
  i := usize(0);
  found := false;
  while((i < evid.len()) && !(found), {
    match(
      evid.get(i),
      .Some(ep) => {
        found = match(
          ep.field_function_type,
          .Func({ forall_labels }) => (forall_labels.len() > usize(0)),
          _ => false
        );
      },
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});

/// Mirrors `generateFunctionDeclarations` in `src/codegen/functions/declarations.ts`.
generate_function_declarations :: (fn(ctx : FunctionGenerationContext) -> unit)({
  base := ctx.base;
  base.emitter.emit_declaration_line("// Function declarations");

  base.emitter.emit_declaration_line("/// Extern functions");
  ext_iter := ctx.extern_functions.values();
  ext_more := true;
  while(ext_more, {
    match(
      ext_iter.next(),
      .None => {
        ext_more = false;
      },
      .Some(entry) => {
        is_extern_str := entry.is_extern.as_str();
        cond(
          (is_extern_str == "yo") => {
            if(is_threading_macro_function_(entry.c_name.as_str()), {
              return();
            });
            generate_function_declaration(entry.function_type, entry.c_name, true, base, Option(String).None, Option(TypeValue).None, false);
          },
          ((is_extern_str == "c") && entry.c_include.is_some()) => (),
          (entry.c_name.starts_with(String.from("__atomic_")) || entry.c_name.starts_with(String.from("__sync_"))) => (),
          true => {
            generate_function_declaration(entry.function_type, entry.c_name, true, base, Option(String).None, Option(TypeValue).None, false);
          }
        );
      }
    );
  });
  base.emitter.emit_declaration_string_line(String.from(""));

  if(ctx.uses_async, {
    base.emitter.emit_declaration_line("/// Async runtime functions");
    base.emitter.emit_declaration_line("static void __yo_async_spawn_task(void (*resume_fn)(void*), void* state_machine);");
    base.emitter.emit_declaration_string_line(String.from(""));
  });

  base.emitter.emit_declaration_line("/// Object constructors");
  generate_object_constructor_declarations(base);
  base.emitter.emit_declaration_string_line(String.from(""));

  base.emitter.emit_declaration_line("/// Closure constructors");
  generate_closure_constructor_declarations(base);
  base.emitter.emit_declaration_string_line(String.from(""));

  base.emitter.emit_declaration_line("/// Capture dispose functions");
  generate_capture_dispose_function_declarations(base);
  base.emitter.emit_declaration_string_line(String.from(""));

  base.emitter.emit_declaration_line("/// Dyn type constructors");
  base.emitter.emit_declaration_string_line(String.from(""));

  base.emitter.emit_declaration_line("/// Regular functions");
  fn_iter := ctx.functions.values();
  fn_more := true;
  while(fn_more, {
    match(
      fn_iter.next(),
      .None => {
        fn_more = false;
      },
      .Some(entry) => {
        is_user_main := (entry.c_name == String.from("__yo_user_main"));

        if(!(is_user_main) && (!(entry.is_closure) && (!(entry.is_effect_record_member) && (entry.specialized_function_caches_len > usize(0)))), {
          return();
        });

        has_implicit_func_params := match(
          entry.type_value,
          .Func({ implicit_types }) => implicit_types_contain_func_type_(implicit_types),
          _ => false
        );
        has_unresolved_implicit := (
          !(is_user_main) &&
            !(entry.is_effectful) &&
              !(entry.is_effect_record_member) &&
                !(entry.is_closure) &&
                  entry.specialized_type.is_none() &&
                    (entry.specialized_function_caches_len == usize(0)) &&
                      (get_evidence_parameters(entry.type_value).len() == usize(0)) &&
                        has_implicit_func_params
        );
        if(has_unresolved_implicit, {
          return();
        });

        func_type_for_check := match(entry.specialized_type,.Some(st) => st,.None => entry.type_value);
        has_evidence_params := (get_evidence_parameters(func_type_for_check).len() > usize(0));

        if(!(is_user_main) && entry.is_io_async_state_machine_closure, {
          return();
        });

        if(!(is_user_main) &&
          !(entry.is_effectful) &&
            !(has_evidence_params) &&
              !(entry.is_effect_record_member) &&
                (
                  ((entry.is_hard_generic) && !(entry.is_closure)) ||
                    ((entry.specialized_function_caches_len > usize(0)) && !(entry.is_closure)) ||
                      entry.is_comptime_return ||
                        entry.has_builtin_inline_call ||
                          entry.is_io_async_state_machine_closure
                ), {
          return();
        });

        func_type := match(entry.specialized_type,.Some(st) => st,.None => entry.type_value);
        has_generic_params := match(
          func_type,
          .Func({ forall_labels, param_types }) => (
            (!(entry.is_effectful) && !(entry.is_effect_record_member)) &&
              ((forall_labels.len() > usize(0)) || field_types_contain_some_type_(param_types))
          ),
          _ => false
        );
        has_generic_return := match(
          func_type,
          .Func({ result }) => type_value_contains_some_type_(result.*),
          _ => false
        );
        returns_plain_impl := match(
          func_type,
          .Func({ result }) => match(
            result.*,
            .SomeT(_, _, _, _, required_trait_types, _, _, _, _, _) => (required_trait_types.len() > usize(0)),
            _ => false
          ),
          _ => false
        );
        if(has_generic_params || (
          has_generic_return &&
            !(returns_plain_impl) &&
              !(entry.is_effect_record_member)
        ), {
          return();
        });

        orig_type_override := cond(
          (
            entry.specialized_type.is_some() &&
              (get_evidence_parameters(func_type).len() == usize(0)) &&
                evidence_params_have_forall_(entry.type_value)
          ) => Option(TypeValue).Some(entry.type_value),
          true => Option(TypeValue).None
        );

        generate_function_declaration(
          func_type,
          entry.c_name,
          false,
          base,
          Option(String).None,
          orig_type_override,
          false
        );
      }
    );
  });

  base.emitter.emit_declaration_line("/// Closure vtable instances");
  generate_closure_vtable_declarations(base);
  base.emitter.emit_declaration_string_line(String.from(""));
});

/// Mirrors `generateSpecializedFunctionDeclarations` in
/// `src/codegen/functions/declarations.ts`.
generate_specialized_function_declarations :: (fn(ctx : FunctionGenerationContext) -> unit)({
  base := ctx.base;
  generated := HashSet(String).new();
  iter := ctx.functions.values();
  more := true;
  while(more, {
    match(
      iter.next(),
      .None => {
        more = false;
      },
      .Some(entry) => {
        if(entry.is_comptime_return, {
          return();
        });

        if(entry.specialized_type.is_none(), {
          return();
        });
        spec_type := match(
          entry.specialized_type,
          .Some(st) => st,
          .None => entry.type_value
        );
        if(!(entry.is_generic), {
          return();
        });

        spec_has_forall := match(
          spec_type,
          .Func({ forall_labels }) => (forall_labels.len() > usize(0)),
          _ => false
        );
        if(spec_has_forall, {
          return();
        });

        spec_has_some_type_params := match(
          spec_type,
          .Func({ param_types }) => {
            i := usize(0);
            found := false;
            while((i < param_types.len()) && !(found), {
              match(
                param_types.get(i),
                .Some(pt) => {
                  found = match(pt,.SomeT(_, _, _, _, _, _, _, _, _, _) => true, _ => false);
                },
                .None => ()
              );
              i = (i + usize(1));
            });
            found
          },
          _ => false
        );
        if(spec_has_some_type_params, {
          return();
        });

        has_generic_params := match(
          spec_type,
          .Func({ param_types }) => field_types_contain_some_type_(param_types),
          _ => false
        );
        has_generic_return := match(
          spec_type,
          .Func({ result }) => type_value_contains_some_type_(result.*),
          _ => false
        );
        if(has_generic_params || has_generic_return, {
          return();
        });

        if(evidence_params_have_forall_(entry.type_value), {
          return();
        });

        if(generated.contains(entry.value_id), {
          return();
        });
        generated.add(entry.value_id);

        is_rc_fn := (
          entry.c_name.contains(String.from("___drop")) ||
            entry.c_name.contains(String.from("___dup")) ||
              entry.c_name.contains(String.from("___dispose"))
        );
        prefix := cond(
          is_rc_fn => String.from("static inline __attribute__((always_inline)) "),
          true => String.from("static inline ")
        );
        proto := generate_function_prototype(spec_type, entry.c_name, Option(String).None, Option(TypeValue).None);
        type_str := type_to_string(entry.type_value);
        base.emitter.emit_declaration_string_line(
          ((prefix + proto) + String.from("; // specialized function: ")) + type_str
        );
      }
    );
  });
});

export(
  FunctionImplicitParameter,
  EvidenceParameter,
  expand_implicit_parameters,
  get_evidence_parameters,
  generate_function_prototype,
  function_declaration_linkage_prefix,
  generate_function_declaration,
  generate_object_constructor_declarations,
  generate_closure_constructor_declarations,
  generate_capture_dispose_function_declarations,
  generate_closure_vtable_declarations,
  generate_function_declarations,
  generate_specialized_function_declarations,
  format_fn_prototype,
  format_fn_param,
  format_fn_declaration_with_comment,
  format_struct_ctor_decl,
  format_closure_dispose_decl,
  format_default_param_name
);
