//! Reachable-function collection — mirrors `src/codegen/functions/collection.ts`.
//!
//! Mutual recursion (find_function_calls_in_expr ↔ collect_effect_record_members
//! ↔ collect_required_functions) cannot be expressed by ordering alone (Yo has
//! no forward references), so find_function_calls_in_expr is reached through a
//! module-global function pointer (set by register_find_function_calls_in_expr),
//! mirroring the evaluator's set_evaluate_expression_fn pattern.
//!
//! DEFERRED (Phase-3, fields absent on yo-self FuncVal / branches don't fire
//! for the supported corpus — is_function_specializable is a `false` stub):
//! specializedType / specializedFunctionCaches / isFunctionTypeHardGeneric /
//! resolvedConcreteType branches; collectDisposeMethodsFromGenericImpls
//! (needs findMethodsFromGenericImpls). See issues/codegen-port-type-model-gaps.md.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, ast_expr_id, ast_expr_is_atom, ast_expr_is_fn_call, ast_expr_is_fn_call_of, make_err_expr, BK_TEST, BF_COMPTIME_EXPECT_ERROR } :: import("../../expr.yo");
{ ExprInfoTable, expr_info_table_get } :: import("../../expr_info.yo");
{ EvalValue, is_func_val, is_struct_val, is_type_value, is_unknown_val } :: import("../../value.yo");
{ TypeValue } :: import("../../types/definitions.yo");
{ is_function_type, is_unit_type } :: import("../../types/guards.yo");
{ is_control_fn, mark_as_effect_record_member } :: import("../../function_value.yo");
{ CodeGenContext, type_key, sanitize_for_c_identifier } :: import("../utils/index.yo");
// NOTE: collect_type (types/collection) is reached through an indirection
// global rather than a direct import, so the dependency between this file and
// types/collection is ONE-WAY (types/collection imports from here). A direct
// mutual destructuring import cannot be resolved by the circular-import loader.
// --- mutual-recursion indirection for find_function_calls_in_expr ----------
FindFunctionCallsFn :: (fn(expr : AstExpr, context : CodeGenContext, info : ExprInfoTable) -> unit);
(g_find_function_calls_in_expr : Option(FindFunctionCallsFn)) = Option(FindFunctionCallsFn).None;
// --- indirection for collect_type (defined in types/collection) ------------
CollectTypeFn :: (fn(type : TypeValue, context : CodeGenContext) -> unit);
(g_collect_type : Option(CollectTypeFn)) = Option(CollectTypeFn).None;
/// Register types/collection's collect_type. Call once at init.
set_collect_type_fn :: (fn(f : CollectTypeFn) -> unit)({
  g_collect_type = Option(CollectTypeFn).Some(f);
  ()
});
/// Call the registered collect_type (panics if unregistered).
_call_collect_type :: (fn(type : TypeValue, context : CodeGenContext) -> unit)(
  match(
    g_collect_type,
    .Some(f) => f(type, context),
    .None => panic("collect_type called before set_collect_type_fn")
  )
);
/// Call the registered find_function_calls_in_expr (panics if unregistered).
_call_find_function_calls_in_expr :: (fn(expr : AstExpr, context : CodeGenContext, info : ExprInfoTable) -> unit)(
  match(
    g_find_function_calls_in_expr,
    .Some(f) => f(expr, context, info),
    .None => panic("find_function_calls_in_expr called before register_find_function_calls_in_expr")
  )
);
/// True if `t` is an extern function type (any language).
_type_is_extern :: (fn(t : TypeValue) -> bool)(
  match(t,.Func({ is_extern }) => is_extern.is_some(), _ => false)
);
/// Whether an expression's evaluated value is an UnknownValue (not fully
/// evaluated), recursing through calls / macro expansions / deferred drops.
/// An extern-fn-typed or unit-typed unknown is treated as known. Mirrors
/// `exprContainsUnknownValue`.
expr_contains_unknown_value :: (fn(expr : AstExpr, info : ExprInfoTable) -> bool)({
  ei_opt := expr_info_table_get(info, ast_expr_id(expr));
  match(
    ei_opt,
    .Some(ei) => match(
      ei.value,
      .Some(v) => if(is_unknown_val(v), {
        cond(
          (is_function_type(ei.ty) && _type_is_extern(ei.ty)) => (),
          // known extern fn
          is_unit_type(ei.ty) => (),
          true => {
            return(true);
          }
        );
      }),
      .None => ()
    ),
    .None => ()
  );
  // Recurse into function calls.
  match(
    expr,
    .FnCall(_, func_box, args, _, _) => {
      if(recur(func_box.*, info), {
        return(true);
      });
      n := args.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          args.get(i),
          .Some(arg) => {
            arg_is_unit := match(
              expr_info_table_get(info, ast_expr_id(arg)),
              .Some(aei) => is_unit_type(aei.ty),
              .None => false
            );
            if((!(arg_is_unit)) && recur(arg, info), {
              return(true);
            });
          },
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .Atom(_, _) => ()
  );
  // Macro expansion.
  match(
    ei_opt,
    .Some(ei) => match(
      ei.macro_expansion,
      .Some(me) => {
        if(is_unit_type(ei.ty), {
          return(false);
        });
        if(recur(me, info), {
          return(true);
        });
      },
      .None => ()
    ),
    .None => ()
  );
  // Deferred dup / drop expressions.
  match(
    ei_opt,
    .Some(ei) => {
      match(
        ei.deferred_dup_expressions,
        .Some(dups) => {
          nd := dups.len();
          (di : usize) = usize(0);
          while(di < nd, {
            match(
              dups.get(di),
              .Some(de) => if(recur(de, info), {
                return(true);
              }),
              .None => ()
            );
            di = (di + usize(1));
          });
        },
        .None => ()
      );
      match(
        ei.deferred_drop_expressions,
        .Some(drops) => {
          nr := drops.len();
          (ri : usize) = usize(0);
          while(ri < nr, {
            match(
              drops.get(ri),
              .Some(re) => if(recur(re, info), {
                return(true);
              }),
              .None => ()
            );
            ri = (ri + usize(1));
          });
        },
        .None => ()
      );
    },
    .None => ()
  );
  false
});
/// Recursively collect function values from a struct namespace (and nested
/// records), marking them effect-record members so they compile standalone.
/// Mirrors `collectEffectRecordMembers`.
collect_effect_record_members :: (fn(mv : EvalValue, context : CodeGenContext, info : ExprInfoTable) -> unit)(
  match(
    mv,
    .StructVal(_, _, field_values) => {
      n := field_values.len();
      (i : usize) = usize(0);
      while(i < n, {
        match(
          field_values.get(i),
          .Some(fv) => cond(
            is_func_val(fv) => {
              func_id := match(fv,.FuncVal(_, _, _, _, _, _, _, _, fid) => fid, _ => String.from(""));
              if(!(context.has_function(func_id.clone())), {
                mark_as_effect_record_member(func_id.clone());
                context.register_function(func_id.clone(), fv, sanitize_for_c_identifier(func_id.clone(), false));
                body := match(fv,.FuncVal(_, _, _, _, b, _, _, _, _) => b.*, _ => make_err_expr());
                _call_find_function_calls_in_expr(body, context, info);
              });
              // specializedFunctionCaches: deferred (Phase 3).
            },
            is_struct_val(fv) => {
              recur(fv, context, info);
            },
            true => ()
          ),
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  )
);
/// Callee atom token value of a FnCall, or "" otherwise.
_callee_token_value :: (fn(expr : AstExpr) -> String)(
  match(
    expr,
    .FnCall(_, func_box, _, _, _) => match(func_box.*,.Atom(_, tok) => tok.value,.FnCall(_, _, _, _, _) => String.from("")),
    .Atom(_, _) => String.from("")
  )
);
/// func_id of a FuncVal EvalValue, or "".
_func_val_id :: (fn(v : EvalValue) -> String)(
  match(v,.FuncVal(_, _, _, _, _, _, _, _, fid) => fid, _ => String.from(""))
);
/// body AstExpr of a FuncVal EvalValue, or an error placeholder.
_func_val_body :: (fn(v : EvalValue) -> AstExpr)(
  match(v,.FuncVal(_, _, _, _, b, _, _, _, _) => b.*, _ => make_err_expr())
);
/// Register one module field as a reachable function if it is a FuncVal,
/// applying the main / library / executable C-naming rules, then collect the
/// functions its body calls. Mirrors the per-field body of collectRequiredFunctions.
_collect_required_function_field :: (
  fn(label : String, value : EvalValue, context : CodeGenContext, info : ExprInfoTable, is_top_level_export : bool) -> unit
)({
  if(!(is_func_val(value)), {
    return(());
  });
  func_id := _func_val_id(value);
  cond(
    (label == "main") => {
      // Rename user's main to __yo_user_main — we wrap it.
      context.register_function(func_id.clone(), value, String.from("__yo_user_main"));
    },
    true => {
      // Library and executable modes share the same plain-vs-mangled logic:
      // top-level exports from the CURRENT module use their plain label (for
      // external linkage) unless that plain name collides; everything else is
      // mangled by func_id.
      from_current_module := (
        is_top_level_export
        && match(
          context.current_module_id,
          .Some(mid) => {
            prefix := String.from("fn_");
            prefix.push_string(mid.clone());
            prefix.push_str("_");
            func_id.clone().starts_with(prefix)
          },
          .None => false
        )
      );
      cond(
        from_current_module => {
          plain := sanitize_for_c_identifier(label.clone(), false);
          cond(
            (!(context.has_function_with_c_name(plain.clone()))) => {
              context.register_function(func_id.clone(), value, plain.clone());
              context.set_exported_function_label(func_id.clone(), label.clone());
            },
            true => {
              context.register_function(func_id.clone(), value, sanitize_for_c_identifier(func_id.clone(), false));
            }
          );
        },
        true => {
          context.register_function(func_id.clone(), value, sanitize_for_c_identifier(func_id.clone(), false));
        }
      );
    }
  );
  // Recursively collect functions called by this function.
  _call_find_function_calls_in_expr(_func_val_body(value), context, info);
});
/// First pass: collect all functions that need to be generated, starting from
/// a module value's exported fields. Mirrors `collectRequiredFunctions`.
collect_required_functions :: (
  fn(module_value : EvalValue, context : CodeGenContext, info : ExprInfoTable, is_top_level_export : bool) -> unit
)(
  match(
    module_value,
    .StructVal(_, field_names, field_values) => {
      n := field_names.len();
      (i : usize) = usize(0);
      while(i < n, {
        label := match(field_names.get(i),.Some(l) => l,.None => String.from(""));
        match(
          field_values.get(i),
          .Some(value) => _collect_required_function_field(label, value, context, info, is_top_level_export),
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    .TraitVal(_, field_names, field_values) => {
      n := field_names.len();
      (i : usize) = usize(0);
      while(i < n, {
        label := match(field_names.get(i),.Some(l) => l,.None => String.from(""));
        match(
          field_values.get(i),
          .Some(opt_value) => match(
            opt_value,
            .Some(value) => _collect_required_function_field(label, value, context, info, is_top_level_export),
            .None => ()
          ),
          .None => ()
        );
        i = (i + usize(1));
      });
    },
    _ => ()
  )
);
/// Find function calls in an expression and collect the reachable functions.
/// Mirrors `findFunctionCallsInExpr` (Phase-3 specialization/dyn-data branches
/// deferred — see file header). All self-recursion uses `recur`.
find_function_calls_in_expr :: (fn(expr : AstExpr, context : CodeGenContext, info : ExprInfoTable) -> unit)({
  ei_opt := expr_info_table_get(info, ast_expr_id(expr));
  // Effect-handler functions living inside compile-time struct-namespace values.
  match(
    ei_opt,
    .Some(ei) => match(
      ei.value,
      .Some(v) => if(is_struct_val(v), {
        collect_effect_record_members(v, context, info);
      }),
      .None => ()
    ),
    .None => ()
  );
  // Skip test / comptime_expect_error blocks — no C codegen.
  if(ast_expr_is_fn_call(expr) && (ast_expr_is_fn_call_of(expr, BK_TEST,.None) || ast_expr_is_fn_call_of(expr, BF_COMPTIME_EXPECT_ERROR,.None)), {
    return(());
  });
  // Macro expansion, effect-handler body, closure fn, index method.
  match(
    ei_opt,
    .Some(ei) => {
      match(ei.macro_expansion,.Some(me) => recur(me, context, info),.None => ());
      match(
        ei.effect_analysis,
        .Some(ea) => match(
          ea.handler_value,
          .Some(hv) => if(is_func_val(hv), {
            recur(_func_val_body(hv), context, info);
          }),
          .None => ()
        ),
        .None => ()
      );
      match(
        ei.closure_function_value,
        .Some(cfv) => if(is_func_val(cfv), {
          cid := _func_val_id(cfv);
          if(!(context.has_function(cid.clone())), {
            context.register_function(cid.clone(), cfv, sanitize_for_c_identifier(cid.clone(), false));
            recur(_func_val_body(cfv), context, info);
          });
        }),
        .None => ()
      );
      match(
        ei.index_method_value,
        .Some(imv) => if(is_func_val(imv), {
          iid := _func_val_id(imv);
          if(!(context.has_function(iid.clone())), {
            context.register_function(iid.clone(), imv, sanitize_for_c_identifier(iid.clone(), false));
            recur(_func_val_body(imv), context, info);
          });
        }),
        .None => ()
      );
    },
    .None => ()
  );
  // FnCall: collect the callee and recurse into func + args.
  match(
    expr,
    .FnCall(_, func_box, args, _, _) => {
      callee := func_box.*;
      // "?=" default-value assignment — skip.
      if(_callee_token_value(expr) == "?=", {
        return(());
      });
      match(
        expr_info_table_get(info, ast_expr_id(callee)),
        .Some(cei) => if(is_function_type(cei.ty), {
          is_comptime_only := match(cei.ty,.Func({ result_is_comptime_only }) => result_is_comptime_only, _ => false);
          match(
            cei.value,
            .Some(fv) => cond(
              // ctl handler: inlined at the call site; recurse body, don't collect.
              (is_func_val(fv) && is_control_fn(_func_val_id(fv))) => {
                recur(_func_val_body(fv), context, info);
              },
              is_func_val(fv) => cond(
                // Skip CTFE (compile-time-only return) functions.
                is_comptime_only => (),
                // Phase-3 specializable/specialized branches deferred (stub false).
                context.has_function(_func_val_id(fv)) => (),
                expr_contains_unknown_value(_func_val_body(fv), info) => (),
                true => {
                  context.register_function(_func_val_id(fv), fv, sanitize_for_c_identifier(_func_val_id(fv), false));
                  recur(_func_val_body(fv), context, info);
                }
              ),
              true => ()
            ),
            // No callee value → extern "c"/"yo": register as an extern function.
            .None => match(
              cei.ty,
              .Func({ is_extern, extern_name }) => match(
                is_extern,
                .Some(lang) => {
                  is_internal := match(extern_name,.Some(en) => en.clone().starts_with(String.from("__yo_")),.None => false);
                  if((lang == "c") || (!(is_internal)), {
                    c_name := match(
                      extern_name,
                      .Some(en) => if(lang == "c", en.clone(), sanitize_for_c_identifier(en.clone(), false)),
                      .None => {
                        tok := _callee_token_value(expr);
                        if(lang == "c", tok.clone(), sanitize_for_c_identifier(tok.clone(), false))
                      }
                    );
                    context.register_extern_function(type_key(cei.ty), cei.ty, c_name, Option(String).None);
                  });
                },
                .None => ()
              ),
              _ => ()
            )
          );
        }),
        .None => ()
      );
      recur(callee, context, info);
      na := args.len();
      (ai : usize) = usize(0);
      while(ai < na, {
        match(args.get(ai),.Some(a) => recur(a, context, info),.None => ());
        ai = (ai + usize(1));
      });
    },
    .Atom(_, _) => ()
  );
  // Anonymous function value bound to this expression.
  match(
    ei_opt,
    .Some(ei) => match(
      ei.value,
      .Some(v) => if(is_func_val(v) && is_function_type(ei.ty), {
        cond(
          is_control_fn(_func_val_id(v)) => {
            mark_as_effect_record_member(_func_val_id(v));
            if(!(context.has_function(_func_val_id(v))), {
              context.register_function(_func_val_id(v), v, sanitize_for_c_identifier(_func_val_id(v), false));
            });
            recur(_func_val_body(v), context, info);
          },
          // is_function_specializable is a false stub → the unspecialized-generic
          // skip branch never fires; collect normally.
          context.has_function(_func_val_id(v)) => (),
          expr_contains_unknown_value(_func_val_body(v), info) => (),
          true => {
            context.register_function(_func_val_id(v), v, sanitize_for_c_identifier(_func_val_id(v), false));
            recur(_func_val_body(v), context, info);
          }
        );
      }),
      .None => ()
    ),
    .None => ()
  );
  // Comptime function call returning a type → collect the type.
  match(
    ei_opt,
    .Some(ei) => if(is_type_value(ei.value), {
      match(ei.value,.Some(v) => match(v,.TypeVal(t) => _call_collect_type(t.*, context), _ => ()),.None => ());
    }),
    .None => ()
  );
  // Deferred dup / drop expressions, and dyn() trait values.
  match(
    ei_opt,
    .Some(ei) => {
      match(
        ei.deferred_dup_expressions,
        .Some(dups) => {
          nd := dups.len();
          (di : usize) = usize(0);
          while(di < nd, {
            match(dups.get(di),.Some(de) => recur(de, context, info),.None => ());
            di = (di + usize(1));
          });
        },
        .None => ()
      );
      match(
        ei.deferred_drop_expressions,
        .Some(drops) => {
          nr := drops.len();
          (ri : usize) = usize(0);
          while(ri < nr, {
            match(drops.get(ri),.Some(re) => recur(re, context, info),.None => ());
            ri = (ri + usize(1));
          });
        },
        .None => ()
      );
      match(
        ei.dyn_call_trait_values,
        .Some(tvs) => {
          nt := tvs.len();
          (ti : usize) = usize(0);
          while(ti < nt, {
            match(tvs.get(ti),.Some(tv) => collect_required_functions(tv, context, info, false),.None => ());
            ti = (ti + usize(1));
          });
        },
        .None => ()
      );
    },
    .None => ()
  );
});
/// Register find_function_calls_in_expr in its indirection global. Call once.
register_find_function_calls_in_expr :: (fn() -> unit)({
  g_find_function_calls_in_expr = Option(FindFunctionCallsFn).Some(find_function_calls_in_expr);
  ()
});
export(
  expr_contains_unknown_value,
  collect_effect_record_members,
  collect_required_functions,
  find_function_calls_in_expr,
  _call_find_function_calls_in_expr,
  set_collect_type_fn,
  register_find_function_calls_in_expr
);
