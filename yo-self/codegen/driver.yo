//! Compiler driver — connects the parser output to the C code generator.
//!
//! Phase 4j+: given a parsed module body (ArrayList(AstExpr)), extract function
//! definitions and generate a complete, compilable C11 source file.
//!
//! Key entry points:
//!   extract_fn_def(expr) -> Option(FnDef)
//!     Extract a FnDef from a `name :: (fn(params) -> T)(body)` AST node.
//!
//!   compile_module_to_c(exprs, module_id, main_name) -> Option(String)
//!     Walk module body, generate C for every function, assemble the program.
//!
//! Limitations (simplified for Phase 4j+):
//!   - Only simple atomic type names (i32, u8, bool, unit, str, …) are mapped.
//!   - `…` evidence params are emitted as `void*`.
//!   - No type declarations, RC helpers, or async support yet.
//!
//! **Structural mapping vs src/**: this file is the **bootstrap codegen
//! pipeline** — it pattern-matches the raw `AstExpr` AST directly and emits
//! C, *without going through the evaluator*. src/ has no equivalent: the
//! production compiler always runs `evaluator → codegen-c.ts` on the typed
//! AST, with codegen logic spread across `src/codegen/{functions,types,exprs}/`.
//! Every `extract_*_def` / `emit_*_to_c` function here is a yo-self-only
//! AST-walker that will be deleted once yo-self can use its own typed AST
//! (the typed-AST pivot, roadmap Phase 13at). Until then, `driver.yo` is
//! an **acceptable divergence (bootstrap-specific)** with no src/
//! counterpart to align against.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ AstExpr, BK_IMPORT, BK_OPEN, BK_ARRAY, BK_BEGIN } :: import("../expr.yo");
{ TokenKind, Token } :: import("../token.yo");
{ ExprInfoTable } :: import("../expr_info.yo");
{ CodegenContext } :: import("./context.yo");
{ type_expr_to_c, type_name_to_c, is_begin_block, sanitize_c_ident, build_typed_decl, register_generic_struct_template_if_supported, is_primitive_type_cast, generate_expr } :: import("./exprs.yo");
{ generate_function, emit_function_declaration } :: import("./functions/generation.yo");
{ emit_c_preamble, emit_main_wrapper, generate_c_output } :: import("./codegen_c.yo");
// ---------------------------------------------------------------------------
// Pipeline-scoped ExprInfoTable handoff
// ---------------------------------------------------------------------------
/// One-shot slot for the typed AST metadata produced by an evaluator pass.
/// `compile_module_to_c` (and its `*_with_info_table` variant) reads this
/// slot, installs the table on its `CodegenContext`, and then clears it
/// back to `.None` so subsequent compilations start clean.
///
/// Mirrors the pattern already used by `g_evaluate_expression` in
/// `evaluator/exprs/expr.yo` — a module-level function-pointer / state
/// slot, set by the caller right before invoking the consumer.
///
/// Wiring the evaluator into `yo-self/main.yo` is the goal of Stream A
/// (see `plans/BOOTSTRAPPING.md` Path Forward). Today the slot stays
/// `.None` for every caller, so codegen continues to use the AST-only
/// bootstrap heuristics and per-handler ports fall through.
(g_pipeline_expr_info_table : Option(ExprInfoTable)) =.None;
/// Set the ExprInfoTable that the next `compile_module_to_c` call will
/// install on its CodegenContext. The slot is one-shot: `compile_module_to_c`
/// reads it, installs it, and resets it to `.None` before returning.
set_pipeline_expr_info_table :: (fn(table : Option(ExprInfoTable)) -> unit)({
  g_pipeline_expr_info_table = table;
});
// ---------------------------------------------------------------------------
// FnDef — extracted function definition record
// ---------------------------------------------------------------------------
/// A function definition extracted from a `name :: (fn(params) -> T)(body)` node.
FnDef :: struct(
  /// Yo-level function name (e.g. "main").
  name : String,
  /// C return type string (e.g. "void", "int32_t").
  ret_ty_c : String,
  /// Parameter names.
  params : ArrayList(String),
  /// C type strings for each parameter (parallel to `params`).
  param_tys : ArrayList(String),
  /// Function body expression.
  body : AstExpr,
  /// True if this function was extracted from an `impl(TypeName, { ... })` block.
  is_impl : bool,
  /// When `is_impl` is true, holds the implementing type name (e.g. "SomeUnion").
  /// Used to resolve `Self` in the method body during codegen.
  impl_type : String
);
// ---------------------------------------------------------------------------
// StructDef — extracted struct definition record
// ---------------------------------------------------------------------------
/// A struct definition extracted from a `Name :: struct(field : Type, ...)` node.
StructDef :: struct(
  /// Yo-level struct name (e.g. "Counter").
  name : String,
  /// Field names (parallel to `field_tys`).
  field_names : ArrayList(String),
  /// C type strings for each field (parallel to `field_names`).
  field_tys : ArrayList(String)
);
// ---------------------------------------------------------------------------
// EnumDef — extracted enum definition record
// ---------------------------------------------------------------------------
/// A single field of a complex enum variant (e.g. `r : i32` in `Circle(r: i32)`).
EnumVariantField :: struct(
  /// Yo-level field name (e.g. "r").
  name : String,
  /// C type string (e.g. "int32_t").
  c_ty : String
);
/// A single enum variant, possibly carrying associated data fields.
///
/// Simple variant example: `Red` → name="Red", fields=[], disc=0
/// Complex variant example: `Circle(r: i32) = 2` → name="Circle", fields=[{r, int32_t}], disc=2
EnumVariant :: struct(
  /// Yo-level variant name.
  name : String,
  /// Associated field definitions (empty for simple variants).
  fields : ArrayList(EnumVariantField),
  /// Discriminant value (explicit or auto-assigned).
  disc : usize
);
/// An enum definition extracted from a `Name :: enum(Var1, Var2, ...)` node.
EnumDef :: struct(
  /// Yo-level enum name (e.g. "Color").
  name : String,
  /// All variants (simple and complex).
  variants : ArrayList(EnumVariant),
  /// True if any variant carries associated data fields.
  is_complex : bool
);
// ---------------------------------------------------------------------------
// Helpers — AST pattern recognisers
// ---------------------------------------------------------------------------
/// Check whether `func_expr` is an infix `->` operator FnCall.
is_arrow_op :: (fn(func_expr : AstExpr) -> bool)(
  match(
    func_expr,
    .Atom(_, _) => false,
    .FnCall(_, inner_func, _, is_infix, _) => cond(
      (!(is_infix)) => false,
      true => match(
        inner_func.*,
        .Atom(_, ftok) => (ftok.value.as_str() == "->"),
        .FnCall(_, _, _, _, _) => false
      )
    )
  )
);
/// Return the identifier string if `expr` is an Identifier Atom, else None.
atom_ident :: (fn(expr : AstExpr) -> Option(str))(
  match(
    expr,
    .Atom(_, tok) => cond(
      (tok.kind == TokenKind.Identifier) =>.Some(tok.value.as_str()),
      true => Option(str).None
    ),
    .FnCall(_, _, _, _, _) => Option(str).None
  )
);
/// Return a C field name for struct/object field declarations.
/// Yo object single-field syntax uses `(*) : T`; the bootstrap C layout names
/// that payload field `_0` so `value.*` can lower to `value._0`.
struct_field_c_name :: (fn(expr : AstExpr) -> Option(str))(
  match(
    atom_ident(expr),
    .Some(name) => Option(str).Some(name),
    .None => match(
      expr,
      .FnCall(_, _, _, _, _) => Option(str).None,
      .Atom(_, tok) => cond(
        (tok.value.as_str() == "*") => Option(str).Some("_0"),
        true => Option(str).None
      )
    )
  )
);
// ---------------------------------------------------------------------------
// is_comptime_expr
// ---------------------------------------------------------------------------
/// Returns true if `expr` is a `comptime(...)` wrapper — i.e. a non-infix FnCall whose function
/// is the atom "comptime".
is_comptime_expr :: (fn(expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, f, _, infix, _) => cond(
      infix => false,
      true => match(
        f.*,
        .FnCall(_, _, _, _, _) => false,
        .Atom(_, tok) => (tok.value.as_str() == "comptime")
      )
    )
  )
);
// ---------------------------------------------------------------------------
// extract_fn_def
// ---------------------------------------------------------------------------
/// Try to extract a `FnDef` from a top-level expression.
///
/// Recognises the pattern:
/// ```
///   FnCall(Atom("::"), [Atom(name), fn_app], is_infix=true)
/// ```
/// where `fn_app` is:
/// ```
///   FnCall(fn_type, [body], is_infix=false)
///   fn_type = FnCall(Atom("->"), [FnCall(Atom("fn"), params), ret_ty], is_infix=true)
/// ```
extract_fn_def :: (fn(expr : AstExpr) -> Option(FnDef))(
  // Step 1: must be an infix `::` FnCall with exactly 2 args.
  match(
    expr,
    .Atom(_, _) => Option(FnDef).None,
    .FnCall(_, top_func, top_args, top_infix, _) => cond(
      (!(top_infix)) => Option(FnDef).None,
      true => match(
        top_func.*,
        .FnCall(_, _, _, _, _) => Option(FnDef).None,
        .Atom(_, ttok) => cond(
          (ttok.value.as_str() != "::") => Option(FnDef).None,
          (top_args.len() != usize(2)) => Option(FnDef).None,
          true => {
            // Step 2: extract the name atom.
            name_expr := match(
              top_args.get(usize(0)),
              .Some(e) => e,
              .None => {
                return(Option(FnDef).None);
              }
            );
            name_str := match(
              atom_ident(name_expr),
              .Some(n) => n,
              .None => {
                return(Option(FnDef).None);
              }
            );
            // Step 3: the RHS must be a fn application: fn_type(body).
            fn_app := match(
              top_args.get(usize(1)),
              .Some(e) => e,
              .None => {
                return(Option(FnDef).None);
              }
            );
            match(
              fn_app,
              .Atom(_, _) => Option(FnDef).None,
              .FnCall(_, app_func, app_args, _, _) => cond(
                // The fn type must be `->` infix.
                (!(is_arrow_op(app_func.*))) => Option(FnDef).None,
                true => match(
                  app_func.*,
                  .Atom(_, _) => Option(FnDef).None,
                  .FnCall(_, arrow_func, arrow_args, _, _) => {
                    // arrow_args[0] = FnCall(Atom("fn"), params_list)
                    // arrow_args[1] = return type expression
                    (ignore : str) = match(
                      arrow_func.*,
                      .Atom(_, _) => "",
                      .FnCall(_, _, _, _, _) => ""
                    );
                    ignore;
                    fn_expr := match(
                      arrow_args.get(usize(0)),
                      .Some(e) => e,
                      .None => {
                        return(Option(FnDef).None);
                      }
                    );
                    ret_ty_expr := match(
                      arrow_args.get(usize(1)),
                      .Some(e) => e,
                      .None => {
                        return(Option(FnDef).None);
                      }
                    );
                    // Skip functions whose return type is comptime(X) where X has no C representation.
                    // e.g. comptime(Trait), comptime(Expr), comptime(Type) → skip.
                    // But comptime(i32), comptime(bool) etc. → don't skip (inner type is C-representable).
                    should_skip_fn := match(
                      ret_ty_expr,
                      .Atom(_, _) => false,
                      .FnCall(_, cf_sk, cargs_sk, cinfix_sk, _) => cond(
                        cinfix_sk => false,
                        true => match(
                          cf_sk.*,
                          .FnCall(_, _, _, _, _) => false,
                          .Atom(_, ctok_sk) => cond(
                            (ctok_sk.value.as_str() != "comptime") => false,
                            true => match(
                              cargs_sk.get(usize(0)),
                              .None => true,
                              .Some(inner_e) => match(
                                type_expr_to_c(inner_e),
                                .Some(_) => false,
                                .None => true
                              )
                            )
                          )
                        )
                      )
                    );
                    if(should_skip_fn, {
                      return(Option(FnDef).None);
                    });
                    // ret_ty_expr → C return type string
                    ret_ty_c := match(
                      type_expr_to_c(ret_ty_expr),
                      .Some(s) => s,
                      .None => String.from("void*")
                    );
                    // fn_expr must be FnCall(Atom("fn"), params)
                    params_list := match(
                      fn_expr,
                      .Atom(_, _) => {
                        return(Option(FnDef).None);
                      },
                      .FnCall(_, fn_func, fn_params, _, _) => cond(
                        (
                          !(
                            match(
                              fn_func.*,
                              .Atom(_, fntok) => (fntok.value.as_str() == "fn"),
                              .FnCall(_, _, _, _, _) => false
                            )
                          )
                        ) => {
                          return(Option(FnDef).None);
                        },
                        true => fn_params
                      )
                    );
                    // Extract each param from params_list.
                    //
                    // Supported forms:
                    //   FnCall(Atom(":"), [Atom(name), type_expr], true)  — typed param
                    //   FnCall(Atom("using"), [FnCall(Atom(":"), [...])], false) — evidence param
                    //   Atom(name) — bare param (untyped)
                    out_params := ArrayList(String).new();
                    out_param_tys := ArrayList(String).new();
                    n_p := params_list.len();
                    (pi : usize) = usize(0);
                    while(pi < n_p, {
                      pi = (pi + usize(1));
                      match(
                        params_list.get(pi - usize(1)),
                        .None => (),
                        .Some(param_expr) => match(
                          param_expr,
                          // bare Atom identifier → untyped param (void*)
                          .Atom(_, ptok) => cond(
                            (ptok.kind == TokenKind.Identifier) => {
                              out_params.push(sanitize_c_ident(ptok.value.as_str()));
                              out_param_tys.push(String.from("void*"));
                            },
                            true => ()
                          ),
                          .FnCall(_, pf, pargs, pinfix, _) => match(
                            pf.*,
                            .FnCall(_, _, _, _, _) => (),
                            .Atom(_, pftok) => cond(
                              // typed param:  FnCall(Atom(":"), [name, type], true)
                              // name can be a bare Atom("name") or comptime(name)
                              ((pftok.value.as_str() == ":") && pinfix) => {
                                // Check if this is `comptime(Name) : MetaType` — a type-variable parameter.
                                // When the name side is `comptime(...)` and the type side is a meta-type
                                // (Type, Trait, Expr, etc.) that has no C equivalent, the function is generic
                                // and cannot be emitted as C — return None immediately.
                                is_comptime_name := match(
                                  pargs.get(usize(0)),
                                  .None => false,
                                  .Some(pne_chk) => match(
                                    pne_chk,
                                    .Atom(_, _) => false,
                                    .FnCall(_, cpf_chk, _, cp_infix_chk, _) => cond(
                                      cp_infix_chk => false,
                                      true => match(
                                        cpf_chk.*,
                                        .FnCall(_, _, _, _, _) => false,
                                        .Atom(_, cptok_chk) => (cptok_chk.value.as_str() == "comptime")
                                      )
                                    )
                                  )
                                );
                                is_meta_type_param := (
                                  is_comptime_name && match(
                                    pargs.get(usize(1)),
                                    .None => false,
                                    .Some(pty_e) => match(
                                      type_expr_to_c(pty_e),
                                      .Some(_) => false,
                                      .None => true
                                    )
                                  )
                                );
                                if(is_meta_type_param, {
                                  return(Option(FnDef).None);
                                });
                                p_name := match(
                                  pargs.get(usize(0)),
                                  .Some(ne) => match(
                                    ne,
                                    // Simple atom name
                                    .Atom(_, ntok) => cond(
                                      (ntok.kind == TokenKind.Identifier) => ntok.value.as_str(),
                                      true => ""
                                    ),
                                    // comptime(name) — extract inner name for C param
                                    .FnCall(_, cpf, cpargs, cp_infix, _) => cond(
                                      cp_infix => "",
                                      true => match(
                                        cpf.*,
                                        .FnCall(_, _, _, _, _) => "",
                                        .Atom(_, cptok) => cond(
                                          (cptok.value.as_str() != "comptime") => "",
                                          true => match(
                                            cpargs.get(usize(0)),
                                            .None => "",
                                            .Some(inner) => match(
                                              atom_ident(inner),
                                              .Some(n) => n,
                                              .None => ""
                                            )
                                          )
                                        )
                                      )
                                    )
                                  ),
                                  .None => ""
                                );
                                p_ty_c := match(
                                  pargs.get(usize(1)),
                                  .Some(te) => match(
                                    type_expr_to_c(te),
                                    .Some(s) => s,
                                    .None => String.from("void*")
                                  ),
                                  .None => String.from("void*")
                                );
                                if(p_name != "", {
                                  out_params.push(sanitize_c_ident(p_name));
                                  out_param_tys.push(p_ty_c);
                                });
                              },
                              // … evidence param — emit as void* ev_<name>
                              (pftok.value.as_str() == "using") => match(
                                pargs.get(usize(0)),
                                // If no inner arg — skip this param
                                .None => (),
                                .Some(using_inner) => {
                                  ev_name := match(
                                    using_inner,
                                    // name — bare evidence reference
                                    .Atom(_, utok) => utok.value.as_str(),
                                    // name : Type — typed evidence
                                    .FnCall(_, uf, uargs, _, _) => match(
                                      uf.*,
                                      .Atom(_, uftok) => cond(
                                        (uftok.value.as_str() == ":") => match(
                                          uargs.get(usize(0)),
                                          .Some(une) => match(
                                            atom_ident(une),
                                            .Some(n) => n,
                                            .None => "ev"
                                          ),
                                          .None => "ev"
                                        ),
                                        true => "ev"
                                      ),
                                      .FnCall(_, _, _, _, _) => "ev"
                                    )
                                  );
                                  ev_param_name := `ev_${ String.from(ev_name) }`;
                                  out_params.push(ev_param_name);
                                  out_param_tys.push(String.from("void*"));
                                }
                              ),
                              // forall param → the whole function is generic; skip it entirely
                              (pftok.value.as_str() == "forall") => return(Option(FnDef).None),
                              // other — skip
                              true => ()
                            )
                          )
                        )
                      );
                    });
                    // body is the first element of app_args.
                    body := match(
                      app_args.get(usize(0)),
                      .Some(e) => e,
                      .None => {
                        return(Option(FnDef).None);
                      }
                    );
                    .Some(
                      FnDef(
                        name : String.from(name_str),
                        ret_ty_c : ret_ty_c,
                        params : out_params,
                        param_tys : out_param_tys,
                        body : body,
                        is_impl : false,
                        impl_type : String.new()
                      )
                    )
                  }
                )
              )
            )
          }
        )
      )
    )
  )
);
// ---------------------------------------------------------------------------
// extract_struct_def
// ---------------------------------------------------------------------------
/// True if a C type string contains "Self" (used in self-referential struct fields).
/// Structs with `Self`-typed fields cannot be emitted as valid C.
c_type_has_self :: (fn(c_ty : String) -> bool)(
  cond(
    (c_ty.as_str() == "Self") => true,
    (c_ty.as_str() == "Self*") => true,
    (c_ty.as_str() == "Self**") => true,
    true => false
  )
);
/// True if any field type of a `StructDef` contains "Self".
struct_has_self_fields :: (fn(sd : StructDef) -> bool)({
  n := sd.field_tys.len();
  (i : usize) = usize(0);
  (found : bool) = false;
  while((i < n) && (!(found)), {
    match(
      sd.field_tys.get(i),
      .None => (),
      .Some(ty) => {
        if(c_type_has_self(ty), {
          found = true;
        });
      }
    );
    i = (i + usize(1));
  });
  found
});
/// Try to extract a `StructDef` from a top-level expression.
///
/// Recognises the pattern:
/// ```
///   FnCall(Atom("::"), [Atom(Name), FnCall(Atom("struct"), [...fields...])], is_infix=true)
/// ```
/// where each field is:
/// ```
///   FnCall(Atom(":"), [Atom(field_name), type_expr], is_infix=true)
/// ```
extract_struct_def :: (fn(expr : AstExpr) -> Option(StructDef))(
  match(
    expr,
    .Atom(_, _) => Option(StructDef).None,
    .FnCall(_, top_func, top_args, top_infix, _) => cond(
      (!(top_infix)) => Option(StructDef).None,
      true => match(
        top_func.*,
        .FnCall(_, _, _, _, _) => Option(StructDef).None,
        .Atom(_, op_tok) => cond(
          (!(op_tok.value.as_str() == "::")) => Option(StructDef).None,
          (top_args.len() < usize(2)) => Option(StructDef).None,
          true => match(
            top_args.get(usize(0)),
            .None => Option(StructDef).None,
            .Some(name_expr) => match(
              atom_ident(name_expr),
              .None => Option(StructDef).None,
              .Some(name_str) => match(
                top_args.get(usize(1)),
                .None => Option(StructDef).None,
                .Some(rhs) => match(
                  rhs,
                  .Atom(_, _) => Option(StructDef).None,
                  .FnCall(_, rhs_func, rhs_args, rhs_infix, _) => cond(
                    // rhs must be a non-infix call to "struct"
                    (rhs_infix) => Option(StructDef).None,
                    true => match(
                      rhs_func.*,
                      .FnCall(_, _, _, _, _) => Option(StructDef).None,
                      .Atom(_, rhs_tok) => cond(
                        // Accept both "struct" and "object" (object = struct + RC in full compiler)
                        (!((rhs_tok.value.as_str() == "struct") || (rhs_tok.value.as_str() == "object"))) => Option(StructDef).None,
                        true => {
                          // Extract field names and C types from the struct args.
                          out_names := ArrayList(String).new();
                          out_tys := ArrayList(String).new();
                          nf := rhs_args.len();
                          (fi : usize) = usize(0);
                          while(fi < nf, {
                            fi = (fi + usize(1));
                            match(
                              rhs_args.get(fi - usize(1)),
                              .None => (),
                              .Some(field_expr) => match(
                                field_expr,
                                .Atom(_, _) => (),
                                .FnCall(_, ff, fa, f_infix, _) => cond(
                                  (!(f_infix)) => (),
                                  true => match(
                                    ff.*,
                                    .FnCall(_, _, _, _, _) => (),
                                    .Atom(_, ftok) => cond(
                                      // Plain field: `name : type`
                                      (ftok.value.as_str() == ":") => cond(
                                        (fa.len() < usize(2)) => (),
                                        true => match(
                                          fa.get(usize(0)),
                                          .None => (),
                                          .Some(field_name_e) => match(
                                            struct_field_c_name(field_name_e),
                                            .None => (),
                                            .Some(fname) => match(
                                              fa.get(usize(1)),
                                              .None => (),
                                              .Some(ty_e) => match(
                                                type_expr_to_c(ty_e),
                                                .None => (),
                                                .Some(c_ty) => {
                                                  out_names.push(String.from(fname));
                                                  out_tys.push(c_ty);
                                                }
                                              )
                                            )
                                          )
                                        )
                                      ),
                                      // Default-value field: `(name : type) ?= default`
                                      // fa[0] is the inner `name : type` FnCall, fa[1] is the default.
                                      (ftok.value.as_str() == "?=") => cond(
                                        (fa.len() < usize(2)) => (),
                                        true => match(
                                          fa.get(usize(0)),
                                          .None => (),
                                          .Some(inner_colon) => match(
                                            inner_colon,
                                            .Atom(_, _) => (),
                                            .FnCall(_, ic_func, ic_args, ic_infix, _) => cond(
                                              (!(ic_infix)) => (),
                                              true => match(
                                                ic_func.*,
                                                .FnCall(_, _, _, _, _) => (),
                                                .Atom(_, ic_tok) => cond(
                                                  (!(ic_tok.value.as_str() == ":")) => (),
                                                  (ic_args.len() < usize(2)) => (),
                                                  true => match(
                                                    ic_args.get(usize(0)),
                                                    .None => (),
                                                    .Some(field_name_e2) => match(
                                                      struct_field_c_name(field_name_e2),
                                                      .None => (),
                                                      .Some(fname2) => match(
                                                        ic_args.get(usize(1)),
                                                        .None => (),
                                                        .Some(ty_e2) => match(
                                                          type_expr_to_c(ty_e2),
                                                          .None => (),
                                                          .Some(c_ty2) => {
                                                            out_names.push(String.from(fname2));
                                                            out_tys.push(c_ty2);
                                                          }
                                                        )
                                                      )
                                                    )
                                                  )
                                                )
                                              )
                                            )
                                          )
                                        )
                                      ),
                                      true => ()
                                    )
                                  )
                                )
                              )
                            );
                          });
                          .Some(
                            StructDef(
                              name : String.from(name_str),
                              field_names : out_names,
                              field_tys : out_tys
                            )
                          )
                        }
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
);
/// Emit a C typedef struct for a `StructDef` into the context's declarations buffer.
///
/// For `Counter` with fields `value: i32, name: str`, emits:
/// ```c
/// typedef struct { int32_t value; const char* name; } Counter;
/// ```
emit_struct_to_c :: (fn(sd : StructDef, ctx : CodegenContext) -> unit)({
  // Skip if already registered (avoid C typedef redefinition error when the same
  // struct name is defined in multiple nested scopes)
  // Also skip structs with Self-typed fields (cannot be emitted as valid C without
  // forward declarations and struct-tag syntax)
  if((!(ctx.is_struct_name(sd.name.as_str()))) && (!(struct_has_self_fields(sd))), {
    ctx.register_struct(String.from(sd.name.as_str()));
    // Build field names CSV for open/destructuring support
    fields_csv_buf := String.new();
    // Build field types CSV for derive(ToString) support
    field_tys_csv_buf := String.new();
    nf := sd.field_names.len();
    (fi : usize) = usize(0);
    while(fi < nf, {
      fi = (fi + usize(1));
      match(
        sd.field_names.get(fi - usize(1)),
        .None => (),
        .Some(fname) => {
          if(fi > usize(1), {
            fields_csv_buf.push_str(",");
          });
          fields_csv_buf.push_string(fname);
        }
      );
      match(
        sd.field_tys.get(fi - usize(1)),
        .None => (),
        .Some(fty) => {
          if(fi > usize(1), {
            field_tys_csv_buf.push_str(",");
          });
          field_tys_csv_buf.push_string(fty);
        }
      );
    });
    ctx.register_struct_fields(sd.name.as_str(), fields_csv_buf.as_str());
    ctx.register_struct_field_types(sd.name.as_str(), field_tys_csv_buf.as_str());
    line := String.from("typedef struct { ");
    (fi2 : usize) = usize(0);
    while(fi2 < nf, {
      fi2 = (fi2 + usize(1));
      match(
        sd.field_names.get(fi2 - usize(1)),
        .None => (),
        .Some(fname) => match(
          sd.field_tys.get(fi2 - usize(1)),
          .None => (),
          .Some(fty) => {
            line.push_string(fty);
            line.push_str(" ");
            line.push_string(fname);
            line.push_str("; ");
          }
        )
      );
    });
    line.push_str("} ");
    line.push_string(sd.name);
    line.push_str(";");
    ctx.emitter.emit_declaration_string_line(line);
  });
});
// ---------------------------------------------------------------------------
// UnionDef — extracted union definition record
// ---------------------------------------------------------------------------
/// A union definition extracted from a `Name :: union(field : Type, ...)` node.
UnionDef :: struct(
  /// Yo-level union name (e.g. "SomeUnion").
  name : String,
  /// Field names (parallel to `field_tys`).
  field_names : ArrayList(String),
  /// C type strings for each field (parallel to `field_names`).
  field_tys : ArrayList(String)
);
/// Try to extract a `UnionDef` from a top-level expression.
/// Recognises `Name :: union(field1 : Type1, field2 : Type2, ...)`.
extract_union_def :: (fn(expr : AstExpr) -> Option(UnionDef))(
  match(
    expr,
    .Atom(_, _) => Option(UnionDef).None,
    .FnCall(_, ef, eargs, top_infix, _) => cond(
      (!(top_infix)) => Option(UnionDef).None,
      (eargs.len() < usize(2)) => Option(UnionDef).None,
      true => match(
        ef.*,
        .FnCall(_, _, _, _, _) => Option(UnionDef).None,
        .Atom(_, op_tok) => cond(
          (!(op_tok.value.as_str() == "::")) => Option(UnionDef).None,
          (eargs.len() < usize(2)) => Option(UnionDef).None,
          true => match(
            eargs.get(usize(0)),
            .None => Option(UnionDef).None,
            .Some(lhs_expr) => match(
              atom_ident(lhs_expr),
              .None => Option(UnionDef).None,
              .Some(uname) => match(
                eargs.get(usize(1)),
                .None => Option(UnionDef).None,
                .Some(rhs_expr) => match(
                  rhs_expr,
                  .Atom(_, _) => Option(UnionDef).None,
                  .FnCall(_, rf, rargs, rhs_infix, _) => cond(
                    (rhs_infix) => Option(UnionDef).None,
                    true => match(
                      rf.*,
                      .FnCall(_, _, _, _, _) => Option(UnionDef).None,
                      .Atom(_, rhs_tok) => cond(
                        (!(rhs_tok.value.as_str() == "union")) => Option(UnionDef).None,
                        true => {
                          udef := UnionDef(
                            name : String.from(uname),
                            field_names : ArrayList(String).new(),
                            field_tys : ArrayList(String).new()
                          );
                          nfields := rargs.len();
                          (fi : usize) = usize(0);
                          (ok : bool) = true;
                          while((fi < nfields) && ok, {
                            fi = (fi + usize(1));
                            match(
                              rargs.get(fi - usize(1)),
                              .None => {
                                ok = false;
                              },
                              .Some(fexpr) => match(
                                fexpr,
                                .Atom(_, _) => {
                                  ok = false;
                                },
                                .FnCall(_, ff2, fargs2, finfix2, _) => cond(
                                  (!(finfix2)) => {
                                    ok = false;
                                  },
                                  (fargs2.len() < usize(2)) => {
                                    ok = false;
                                  },
                                  true => match(
                                    ff2.*,
                                    .FnCall(_, _, _, _, _) => {
                                      ok = false;
                                    },
                                    .Atom(_, ftok2) => cond(
                                      (!(ftok2.value.as_str() == ":")) => {
                                        ok = false;
                                      },
                                      true => match(
                                        fargs2.get(usize(0)),
                                        .None => {
                                          ok = false;
                                        },
                                        .Some(fname_e) => match(
                                          atom_ident(fname_e),
                                          .None => {
                                            ok = false;
                                          },
                                          .Some(fname_s) => match(
                                            fargs2.get(usize(1)),
                                            .None => {
                                              ok = false;
                                            },
                                            .Some(fty_e) => match(
                                              type_expr_to_c(fty_e),
                                              .None => {
                                                ok = false;
                                              },
                                              .Some(fty_c) => {
                                                udef.field_names.push(String.from(fname_s));
                                                udef.field_tys.push(fty_c);
                                              }
                                            )
                                          )
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            );
                          });
                          cond(
                            ok => Option(UnionDef).Some(udef),
                            true => Option(UnionDef).None
                          )
                        }
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
);
/// Emit a C typedef union for a `UnionDef` into the context's declarations buffer.
emit_union_to_c :: (fn(ud : UnionDef, ctx : CodegenContext) -> unit)({
  if(!(ctx.is_struct_name(ud.name.as_str())), {
    ctx.register_struct(String.from(ud.name.as_str()));
    // Build field names CSV for destructuring support
    fields_csv_buf := String.new();
    nf := ud.field_names.len();
    (fi : usize) = usize(0);
    while(fi < nf, {
      fi = (fi + usize(1));
      match(
        ud.field_names.get(fi - usize(1)),
        .None => (),
        .Some(fname) => {
          if(fi > usize(1), {
            fields_csv_buf.push_str(",");
          });
          fields_csv_buf.push_string(fname);
        }
      );
    });
    ctx.register_struct_fields(ud.name.as_str(), fields_csv_buf.as_str());
    line := String.from("typedef union { ");
    (fi2 : usize) = usize(0);
    while(fi2 < nf, {
      fi2 = (fi2 + usize(1));
      match(
        ud.field_names.get(fi2 - usize(1)),
        .None => (),
        .Some(fname) => match(
          ud.field_tys.get(fi2 - usize(1)),
          .None => (),
          .Some(fty) => {
            line.push_string(fty);
            line.push_str(" ");
            line.push_string(fname);
            line.push_str("; ");
          }
        )
      );
    });
    line.push_str("} ");
    line.push_string(ud.name);
    line.push_str(";");
    ctx.emitter.emit_declaration_string_line(line);
  });
});
// ---------------------------------------------------------------------------
// extract_newtype_def / emit_newtype_to_c
// ---------------------------------------------------------------------------
/// Try to extract a newtype definition from `Name :: newtype(InnerType)`.
/// Returns (name, inner_type_c) or None.
extract_newtype_def :: (fn(expr : AstExpr) -> Option(ArrayList(String)))(
  match(
    expr,
    .Atom(_, _) => Option(ArrayList(String)).None,
    .FnCall(_, top_func, top_args, top_infix, _) => cond(
      (!(top_infix)) => Option(ArrayList(String)).None,
      (top_args.len() < usize(2)) => Option(ArrayList(String)).None,
      true => match(
        top_func.*,
        .FnCall(_, _, _, _, _) => Option(ArrayList(String)).None,
        .Atom(_, op_tok) => cond(
          (!(op_tok.value.as_str() == "::")) => Option(ArrayList(String)).None,
          true => match(
            top_args.get(usize(0)),
            .None => Option(ArrayList(String)).None,
            .Some(name_expr) => match(
              atom_ident(name_expr),
              .None => Option(ArrayList(String)).None,
              .Some(name_str) => match(
                top_args.get(usize(1)),
                .None => Option(ArrayList(String)).None,
                .Some(rhs) => match(
                  rhs,
                  .Atom(_, _) => Option(ArrayList(String)).None,
                  .FnCall(_, rhs_func, rhs_args, rhs_infix, _) => cond(
                    rhs_infix => Option(ArrayList(String)).None,
                    true => match(
                      rhs_func.*,
                      .FnCall(_, _, _, _, _) => Option(ArrayList(String)).None,
                      .Atom(_, rhs_tok) => cond(
                        (!(rhs_tok.value.as_str() == "newtype")) => Option(ArrayList(String)).None,
                        (rhs_args.len() != usize(1)) => Option(ArrayList(String)).None,
                        true => match(
                          rhs_args.get(usize(0)),
                          .None => Option(ArrayList(String)).None,
                          .Some(inner_te) => match(
                            type_expr_to_c(inner_te),
                            .None => Option(ArrayList(String)).None,
                            .Some(inner_c) => {
                              result := ArrayList(String).new();
                              result.push(String.from(name_str));
                              result.push(inner_c);
                              .Some(result)
                            }
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
);
/// Emit `typedef inner_type Name;` for a newtype definition.
emit_newtype_to_c :: (fn(name : str, inner_c : str, ctx : CodegenContext) -> unit)({
  ctx.emitter.emit_declaration("typedef ");
  ctx.emitter.emit_declaration(inner_c);
  ctx.emitter.emit_declaration(" ");
  ctx.emitter.emit_declaration(name);
  ctx.emitter.emit_declaration_line(";");
  ()
});
// ---------------------------------------------------------------------------
// extract_const_def — module-level constants: Name :: literal
// ---------------------------------------------------------------------------
/// A compile-time constant definition: `Name :: literal`.
/// Represents the result of extracting a module-level constant.
ConstDef :: struct(
  name : String,
  value : String,
  kind : String
);
derive(ConstDef, Clone);
/// A module-level mutable variable declaration:
///   x := expr          (infix `:=`)
///   (x : T) = expr     (infix `=` with annotated binding lhs)
MutableVarDef :: struct(
  name : String,
  c_type : String,
  rhs : AstExpr
);
derive(MutableVarDef, Clone);
/// Try to extract a module-level constant `Name :: literal` from an AST expr.
/// Recognises string literals, integers, and booleans.
/// Returns None for function defs, type defs, or non-literal RHS.
extract_const_def :: (fn(expr : AstExpr) -> Option(ConstDef))(
  match(
    expr,
    .Atom(_, _) => Option(ConstDef).None,
    .FnCall(_, top_func, top_args, top_infix, _) => cond(
      (!(top_infix)) => Option(ConstDef).None,
      (top_args.len() < usize(2)) => Option(ConstDef).None,
      true => match(
        top_func.*,
        .FnCall(_, _, _, _, _) => Option(ConstDef).None,
        .Atom(_, op_tok) => cond(
          (!(op_tok.value.as_str() == "::")) => Option(ConstDef).None,
          true => match(
            top_args.get(usize(0)),
            .None => Option(ConstDef).None,
            .Some(name_expr) => match(
              atom_ident(name_expr),
              .None => Option(ConstDef).None,
              .Some(name_str) => match(
                top_args.get(usize(1)),
                .None => Option(ConstDef).None,
                .Some(rhs) => match(
                  rhs,
                  .FnCall(_, _, _, _, _) => Option(ConstDef).None,
                  .Atom(_, rhs_tok) => {
                    val_str := rhs_tok.value.as_str();
                    cond(
                      (rhs_tok.kind == TokenKind.StringLit) =>.Some(
                        ConstDef(
                          name : String.from(name_str),
                          value : String.from(val_str),
                          kind : String.from("str")
                        )
                      ),
                      (rhs_tok.kind == TokenKind.Integer) =>.Some(
                        ConstDef(
                          name : String.from(name_str),
                          value : String.from(val_str),
                          kind : String.from("int")
                        )
                      ),
                      (rhs_tok.kind == TokenKind.Float) =>.Some(
                        ConstDef(
                          name : String.from(name_str),
                          value : String.from(val_str),
                          kind : String.from("float")
                        )
                      ),
                      ((val_str == "true") || (val_str == "false")) =>.Some(
                        ConstDef(
                          name : String.from(name_str),
                          value : cond((val_str == "true") => String.from("1"), true => String.from("0")),
                          kind : String.from("bool")
                        )
                      ),
                      true => Option(ConstDef).None
                    )
                  }
                )
              )
            )
          )
        )
      )
    )
  )
);
/// Emit a module-level constant to C declarations.
/// - Strings: `static const char* Name = "value";`
/// - Integers/booleans: `#define Name value`
/// - Floats: `static const double Name = value;`
emit_const_to_c :: (fn(cd : ConstDef, ctx : CodegenContext) -> unit)({
  cond(
    (cd.kind.as_str() == "str") => {
      ctx.emitter.emit_declaration("static const char* ");
      ctx.emitter.emit_declaration(cd.name.as_str());
      ctx.emitter.emit_declaration(" = ");
      ctx.emitter.emit_declaration(cd.value.as_str());
      ctx.emitter.emit_declaration_line(";");
      ()
    },
    (cd.kind.as_str() == "float") => {
      ctx.emitter.emit_declaration("static const double ");
      ctx.emitter.emit_declaration(cd.name.as_str());
      ctx.emitter.emit_declaration(" = ");
      ctx.emitter.emit_declaration(cd.value.as_str());
      ctx.emitter.emit_declaration_line(";");
      ()
    },
    true => {
      ctx.emitter.emit_declaration("#define ");
      ctx.emitter.emit_declaration(cd.name.as_str());
      ctx.emitter.emit_declaration(" ");
      ctx.emitter.emit_declaration_line(cd.value.as_str());
      ()
    }
  );
});
// ---------------------------------------------------------------------------
// extract_enum_def / emit_enum_to_c
// ---------------------------------------------------------------------------
/// Parse an ASCII decimal string like "0", "10", "255" into a usize.
/// Returns 0 on empty or non-numeric input.
_parse_usize :: (fn(s : str) -> usize)({
  n := s.len();
  (i : usize) = usize(0);
  (acc : usize) = usize(0);
  while(i < n, {
    c := s.bytes(i);
    digit_ord := (usize(c) - usize(48));
    acc = ((acc * usize(10)) + digit_ord);
    i = (i + usize(1));
  });
  acc
});
/// Returns `Some((field_name, c_type))` or `None`.
_parse_variant_field :: (fn(field_expr : AstExpr) -> Option(EnumVariantField))(
  match(
    field_expr,
    .Atom(_, _) => Option(EnumVariantField).None,
    .FnCall(_, ff, fargs, finfix, _) => cond(
      (!(finfix)) => Option(EnumVariantField).None,
      (fargs.len() < usize(2)) => Option(EnumVariantField).None,
      true => match(
        ff.*,
        .FnCall(_, _, _, _, _) => Option(EnumVariantField).None,
        .Atom(_, ftok) => cond(
          (!(ftok.value.as_str() == ":")) => Option(EnumVariantField).None,
          true => match(
            fargs.get(usize(0)),
            .None => Option(EnumVariantField).None,
            .Some(name_e) => match(
              atom_ident(name_e),
              .None => Option(EnumVariantField).None,
              .Some(fname) => match(
                fargs.get(usize(1)),
                .None => Option(EnumVariantField).None,
                .Some(ty_e) => match(
                  type_expr_to_c(ty_e),
                  .None => Option(EnumVariantField).None,
                  .Some(cty) => Option(EnumVariantField).Some(
                    EnumVariantField(name : String.from(fname), c_ty : cty)
                  )
                )
              )
            )
          )
        )
      )
    )
  )
);
/// Parse a complex variant body `VariantName(field: Type, ...)` (non-infix FnCall).
/// Returns `Some((variant_name, fields, disc=0))` or `None` if not a complex variant form.
/// The caller must set the correct discriminant before using the returned EnumVariant.
_parse_complex_variant :: (fn(call_expr : AstExpr) -> Option(EnumVariant))(
  match(
    call_expr,
    .Atom(_, _) => Option(EnumVariant).None,
    .FnCall(_, vf, vargs, vinfix, _) => cond(
      (vinfix) => Option(EnumVariant).None,
      true => match(
        vf.*,
        .FnCall(_, _, _, _, _) => Option(EnumVariant).None,
        .Atom(_, vtok) => {
          vname := vtok.value.as_str();
          fields := ArrayList(EnumVariantField).new();
          nf := vargs.len();
          (fi : usize) = usize(0);
          (ok : bool) = true;
          while((fi < nf) && ok, {
            fi = (fi + usize(1));
            match(
              vargs.get(fi - usize(1)),
              .None => {
                ok = false;
              },
              .Some(fexpr) => match(
                _parse_variant_field(fexpr),
                .None => {
                  ok = false;
                },
                .Some(vf2) => {
                  _r := fields.push(vf2);
                  ()
                }
              )
            );
          });
          cond(
            (!(ok)) => Option(EnumVariant).None,
            true => Option(EnumVariant).Some(
              EnumVariant(name : String.from(vname), fields : fields, disc : usize(0))
            )
          )
        }
      )
    )
  )
);
/// Extract one variant entry from a variant expression inside `enum(...)`.
///
/// Handles:
///   - `Atom("Red")`                     — simple, auto disc
///   - `=(Red, 0)` infix                 — simple with explicit discriminant
///   - `Circle(r : i32)`                 — complex, auto disc
///   - `=(Circle(r : i32), 2)` infix     — complex with explicit discriminant
_extract_one_variant :: (fn(v_expr : AstExpr, next_disc : usize) -> Option(EnumVariant))(
  match(
    v_expr,
    // Simple atom variant: `Red`
    .Atom(_, vtok) => Option(EnumVariant).Some(
      EnumVariant(
        name : String.from(vtok.value.as_str()),
        fields : ArrayList(EnumVariantField).new(),
        disc : next_disc
      )
    ),
    .FnCall(_, vf, vargs, vinfix, _) => cond(
      // Non-infix FnCall: complex variant `Circle(r: i32, ...)`
      (!(vinfix)) => match(
        _parse_complex_variant(v_expr),
        .None => Option(EnumVariant).None,
        .Some(ev) => Option(EnumVariant).Some(
          EnumVariant(name : ev.name, fields : ev.fields, disc : next_disc)
        )
      ),
      // Infix `=`: explicit discriminant  `Red = 0`  or  `Circle(r: i32) = 2`
      (vargs.len() < usize(2)) => Option(EnumVariant).None,
      true => match(
        vf.*,
        .FnCall(_, _, _, _, _) => Option(EnumVariant).None,
        .Atom(_, op_tok) => cond(
          (!(op_tok.value.as_str() == "=")) => Option(EnumVariant).None,
          true => match(
            vargs.get(usize(0)),
            .None => Option(EnumVariant).None,
            .Some(lhs) => match(
              vargs.get(usize(1)),
              .None => Option(EnumVariant).None,
              .Some(disc_e) => {
                // Extract discriminant value: handles both Integer literals
                // (e.g. `= 4`) and Identifier constants (e.g. `= MY_CONST`).
                disc_str_opt := match(
                  disc_e,
                  .FnCall(_, _, _, _, _) => Option(str).None,
                  .Atom(_, dtok) => Option(str).Some(dtok.value.as_str())
                );
                match(
                  disc_str_opt,
                  .None => Option(EnumVariant).None,
                  .Some(disc_str) => {
                    disc_val := _parse_usize(disc_str);
                    // Parse the LHS: either a simple atom or a complex variant
                    base_opt := match(
                      lhs,
                      .Atom(_, ln) => Option(EnumVariant).Some(
                        EnumVariant(
                          name : String.from(ln.value.as_str()),
                          fields : ArrayList(EnumVariantField).new(),
                          disc : disc_val
                        )
                      ),
                      .FnCall(_, _, _, _, _) => match(
                        _parse_complex_variant(lhs),
                        .None => Option(EnumVariant).None,
                        .Some(ev) => Option(EnumVariant).Some(
                          EnumVariant(name : ev.name, fields : ev.fields, disc : disc_val)
                        )
                      )
                    );
                    base_opt
                  }
                )
              }
            )
          )
        )
      )
    )
  )
);
/// Try to extract an `EnumDef` from a top-level expression.
///
/// Recognises:
/// ```
///   FnCall(Atom("::"), [Atom(Name), FnCall(Atom("enum"), [...variants...])], is_infix=true)
/// ```
/// where each variant is an Identifier Atom, a complex `VariantName(field: Type, ...)`,
/// or either form followed by `= discriminant`.
extract_enum_def :: (fn(expr : AstExpr) -> Option(EnumDef))(
  match(
    expr,
    .Atom(_, _) => Option(EnumDef).None,
    .FnCall(_, top_func, top_args, top_infix, _) => cond(
      (!(top_infix)) => Option(EnumDef).None,
      (top_args.len() < usize(2)) => Option(EnumDef).None,
      true => match(
        top_func.*,
        .FnCall(_, _, _, _, _) => Option(EnumDef).None,
        .Atom(_, op_tok) => cond(
          (!(op_tok.value.as_str() == "::")) => Option(EnumDef).None,
          true => match(
            top_args.get(usize(0)),
            .None => Option(EnumDef).None,
            .Some(name_expr) => match(
              atom_ident(name_expr),
              .None => Option(EnumDef).None,
              .Some(name_str) => match(
                top_args.get(usize(1)),
                .None => Option(EnumDef).None,
                .Some(rhs) => match(
                  rhs,
                  .Atom(_, _) => Option(EnumDef).None,
                  .FnCall(_, rhs_func, rhs_args, rhs_infix, _) => cond(
                    (rhs_infix) => Option(EnumDef).None,
                    true => match(
                      rhs_func.*,
                      .FnCall(_, _, _, _, _) => Option(EnumDef).None,
                      .Atom(_, rhs_tok) => cond(
                        (!((rhs_tok.value.as_str() == "enum") || (rhs_tok.value.as_str() == "union"))) => Option(EnumDef).None,
                        true => {
                          variants := ArrayList(EnumVariant).new();
                          (is_complex : bool) = false;
                          nv := rhs_args.len();
                          (vi : usize) = usize(0);
                          (next_disc : usize) = usize(0);
                          (failed : bool) = false;
                          while((vi < nv) && (!(failed)), {
                            vi = (vi + usize(1));
                            match(
                              rhs_args.get(vi - usize(1)),
                              .None => (),
                              .Some(v_expr) => match(
                                _extract_one_variant(v_expr, next_disc),
                                // Skip unrecognised variant expressions rather than failing
                                .None => (),
                                .Some(ev) => {
                                  if(ev.fields.len() > usize(0), {
                                    is_complex = true;
                                  });
                                  next_disc = (ev.disc + usize(1));
                                  _r := variants.push(ev);
                                  ()
                                }
                              )
                            );
                          });
                          Option(EnumDef).Some(
                            EnumDef(
                              name : String.from(name_str),
                              variants : variants,
                              is_complex : is_complex
                            )
                          )
                        }
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
);
/// Module-level helper: register all variants from `ed` into `ctx`.
/// No C is emitted — this is used for non-last occurrences of an enum name
/// so that variant field metadata stays current while the typedef is emitted
/// only once (for the last occurrence).
_register_enum_variants :: (fn(ed : EnumDef, ctx : CodegenContext) -> unit)({
  nv := ed.variants.len();
  (vi : usize) = usize(0);
  while(vi < nv, {
    vi = (vi + usize(1));
    match(
      ed.variants.get(vi - usize(1)),
      .None => (),
      .Some(ev) => {
        nf := ev.fields.len();
        fields_csv := String.new();
        (fi : usize) = usize(0);
        while(fi < nf, {
          fi = (fi + usize(1));
          match(
            ev.fields.get(fi - usize(1)),
            .None => (),
            .Some(fld) => {
              if(fi > usize(1), {
                fields_csv.push_str(",");
              });
              fields_csv.push_string(fld.name);
            }
          );
        });
        ctx.register_variant(ev.name.as_str(), ed.name.as_str(), fields_csv.as_str());
      }
    );
  });
});
/// Emit C type declaration(s) for an `EnumDef` into the context's declarations buffer.
///
/// **Simple enum** (no variant carries fields):
/// ```c
/// typedef enum { Color_Red = 0, Color_Green = 1, Color_Blue = 2 } Color;
/// ```
///
/// **Complex enum** (at least one variant carries fields):
/// ```c
/// typedef enum { Shape_Circle = 0, Shape_Rectangle = 1 } Shape_tag;
/// typedef union {
///   struct { int32_t r; } Circle;
///   struct { int32_t w; int32_t h; } Rectangle;
/// } Shape_data;
/// typedef struct { Shape_tag tag; Shape_data data; } Shape;
/// ```
///
/// Always registers the enum name and all variants in the context.
/// Callers are responsible for calling this only once per enum name (the last
/// definition wins) via `emit_local_type_defs`.
emit_enum_to_c :: (fn(ed : EnumDef, ctx : CodegenContext) -> unit)({
  ctx.register_enum(String.from(ed.name.as_str()));
  _register_enum_variants(ed, ctx);
  nv := ed.variants.len();
  cond(
    // ---------------------------------------------------------------
    // Simple enum: typedef enum { Name_V = disc, ... } Name;
    // ---------------------------------------------------------------
    (!(ed.is_complex)) => {
      line := String.from("typedef enum { ");
      (vi : usize) = usize(0);
      while(vi < nv, {
        vi = (vi + usize(1));
        match(
          ed.variants.get(vi - usize(1)),
          .None => (),
          .Some(ev) => {
            line.push_string(ed.name);
            line.push_str("_");
            line.push_string(ev.name);
            line.push_str(" = ");
            line.push_string(ev.disc.to_string());
            if(vi < nv, {
              line.push_str(", ");
            });
          }
        );
      });
      line.push_str(" } ");
      line.push_string(ed.name);
      line.push_str(";");
      ctx.emitter.emit_declaration_string_line(line);
    },
    // ---------------------------------------------------------------
    // Complex enum: tagged union  (Shape_tag + Shape_data + Shape)
    // ---------------------------------------------------------------
    true => {
      // --- 1) typedef enum { Shape_Circle = 0, ... } Shape_tag; ---
      tag_line := String.from("typedef enum { ");
      (vi2 : usize) = usize(0);
      while(vi2 < nv, {
        vi2 = (vi2 + usize(1));
        match(
          ed.variants.get(vi2 - usize(1)),
          .None => (),
          .Some(ev) => {
            tag_line.push_string(ed.name);
            tag_line.push_str("_");
            tag_line.push_string(ev.name);
            tag_line.push_str(" = ");
            tag_line.push_string(ev.disc.to_string());
            if(vi2 < nv, {
              tag_line.push_str(", ");
            });
          }
        );
      });
      tag_line.push_str(" } ");
      tag_line.push_string(ed.name);
      tag_line.push_str("_tag;");
      ctx.emitter.emit_declaration_string_line(tag_line);
      // --- 2) typedef union { struct { T f; } V; ... } Name_data; ---
      ctx.emitter.emit_declaration_line("typedef union {");
      (vi3 : usize) = usize(0);
      while(vi3 < nv, {
        vi3 = (vi3 + usize(1));
        match(
          ed.variants.get(vi3 - usize(1)),
          .None => (),
          .Some(ev) => {
            nf := ev.fields.len();
            cond(
              // Simple variant inside a complex enum: add a dummy byte member
              // so the union is always non-empty and consistent.
              (nf == usize(0)) => {
                struct_line := String.from("  struct { char _dummy; } ");
                struct_line.push_string(ev.name);
                struct_line.push_str(";");
                ctx.emitter.emit_declaration_string_line(struct_line);
              },
              true => {
                ctx.emitter.emit_declaration_line("  struct {");
                (fi2 : usize) = usize(0);
                while(fi2 < nf, {
                  fi2 = (fi2 + usize(1));
                  match(
                    ev.fields.get(fi2 - usize(1)),
                    .None => (),
                    .Some(fld) => {
                      fld_line := String.from("    ");
                      fld_line.push_string(fld.c_ty);
                      fld_line.push_str(" ");
                      fld_line.push_string(fld.name);
                      fld_line.push_str(";");
                      ctx.emitter.emit_declaration_string_line(fld_line);
                    }
                  );
                });
                close_line := String.from("  } ");
                close_line.push_string(ev.name);
                close_line.push_str(";");
                ctx.emitter.emit_declaration_string_line(close_line);
              }
            );
          }
        );
      });
      union_close := String.from("} ");
      union_close.push_string(ed.name);
      union_close.push_str("_data;");
      ctx.emitter.emit_declaration_string_line(union_close);
      // --- 3) typedef struct { Name_tag tag; Name_data data; } Name; ---
      struct_line2 := String.from("typedef struct { ");
      struct_line2.push_string(ed.name);
      struct_line2.push_str("_tag tag; ");
      struct_line2.push_string(ed.name);
      struct_line2.push_str("_data data; } ");
      struct_line2.push_string(ed.name);
      struct_line2.push_str(";");
      ctx.emitter.emit_declaration_string_line(struct_line2);
    }
  );
});
/// Substitute "Self" with `concrete_type` in a C type string.
/// Used when extracting impl method signatures: `Self` is resolved to the implementing type.
subst_self_ty :: (fn(ty_str : String, concrete_type : str) -> String)({
  s := ty_str.as_str();
  cond(
    (s == "Self") => String.from(concrete_type),
    (s == "Self*") => {
      r := String.from(concrete_type);
      r.push_str("*");
      r
    },
    (s == "Self**") => {
      r2 := String.from(concrete_type);
      r2.push_str("**");
      r2
    },
    true => ty_str
  )
});
/// Apply `subst_self_ty` to every element of a parallel type list, returning a new list.
subst_self_ty_list :: (fn(tys : ArrayList(String), concrete_type : str) -> ArrayList(String))({
  result := ArrayList(String).new();
  n := tys.len();
  (i : usize) = usize(0);
  while(i < n, {
    match(
      tys.get(i),
      .None => (),
      .Some(ty_s) => {
        result.push(subst_self_ty(ty_s, concrete_type));
      }
    );
    i = (i + usize(1));
  });
  result
});
/// Try to extract a `FnDef` from a `name : fn_expr` (single-colon) pattern.
///
/// This handles the short-form used in `impl` blocks:
/// ```
///   impl(T, method_name : (fn(...) -> R)(body))
/// ```
/// where the method binding uses `:` instead of `::`.
/// Returns `None` if the expression does not match the pattern.
extract_colon_fn_def :: (fn(expr : AstExpr) -> Option(FnDef))(
  match(
    expr,
    .Atom(_, _) => Option(FnDef).None,
    .FnCall(_, top_func, top_args, top_infix, _) => cond(
      (!(top_infix)) => Option(FnDef).None,
      (top_args.len() != usize(2)) => Option(FnDef).None,
      true => match(
        top_func.*,
        .FnCall(_, _, _, _, _) => Option(FnDef).None,
        .Atom(_, ttok) => cond(
          (ttok.value.as_str() != ":") => Option(FnDef).None,
          true => {
            name_expr := match(
              top_args.get(usize(0)),
              .Some(e) => e,
              .None => {
                return(Option(FnDef).None);
              }
            );
            name_str := match(
              atom_ident(name_expr),
              .Some(n) => n,
              .None => {
                return(Option(FnDef).None);
              }
            );
            fn_app := match(
              top_args.get(usize(1)),
              .Some(e) => e,
              .None => {
                return(Option(FnDef).None);
              }
            );
            match(
              fn_app,
              .Atom(_, _) => Option(FnDef).None,
              .FnCall(_, app_func, app_args, _, _) => cond(
                (!(is_arrow_op(app_func.*))) => Option(FnDef).None,
                (app_args.len() != usize(1)) => Option(FnDef).None,
                true => match(
                  app_func.*,
                  .Atom(_, _) => Option(FnDef).None,
                  .FnCall(_, arrow_func, arrow_args, _, _) => {
                    fn_expr2 := match(
                      arrow_args.get(usize(0)),
                      .Some(e) => e,
                      .None => {
                        return(Option(FnDef).None);
                      }
                    );
                    ret_ty_expr2 := match(
                      arrow_args.get(usize(1)),
                      .Some(e) => e,
                      .None => {
                        return(Option(FnDef).None);
                      }
                    );
                    (ignore2 : str) = match(
                      arrow_func.*,
                      .Atom(_, _) => "",
                      .FnCall(_, _, _, _, _) => ""
                    );
                    ignore2;
                    ret_ty_c2 := match(
                      type_expr_to_c(ret_ty_expr2),
                      .Some(s) => s,
                      .None => String.from("void*")
                    );
                    params_list2 := match(
                      fn_expr2,
                      .Atom(_, _) => {
                        return(Option(FnDef).None);
                      },
                      .FnCall(_, fn_func2, fn_params2, _, _) => cond(
                        (
                          !(
                            match(
                              fn_func2.*,
                              .Atom(_, fntok2) => (fntok2.value.as_str() == "fn"),
                              .FnCall(_, _, _, _, _) => false
                            )
                          )
                        ) => {
                          return(Option(FnDef).None);
                        },
                        true => fn_params2
                      )
                    );
                    out_params2 := ArrayList(String).new();
                    out_param_tys2 := ArrayList(String).new();
                    n_p2 := params_list2.len();
                    (pi2 : usize) = usize(0);
                    while(pi2 < n_p2, {
                      pi2 = (pi2 + usize(1));
                      match(
                        params_list2.get(pi2 - usize(1)),
                        .None => (),
                        .Some(param_expr2) => match(
                          param_expr2,
                          .Atom(_, ptok2) => cond(
                            (ptok2.kind == TokenKind.Identifier) => {
                              out_params2.push(String.from(ptok2.value.as_str()));
                              out_param_tys2.push(String.from("void*"));
                            },
                            true => ()
                          ),
                          .FnCall(_, pf2, pargs2, pinfix2, _) => match(
                            pf2.*,
                            .FnCall(_, _, _, _, _) => (),
                            .Atom(_, pftok2) => cond(
                              ((pftok2.value.as_str() == ":") && pinfix2) => {
                                p_name2 := match(
                                  pargs2.get(usize(0)),
                                  .Some(ne2) => match(
                                    ne2,
                                    .Atom(_, ntok2) => cond(
                                      (ntok2.kind == TokenKind.Identifier) => ntok2.value.as_str(),
                                      true => ""
                                    ),
                                    .FnCall(_, cpf2, cpargs2, cp_infix2, _) => cond(
                                      cp_infix2 => "",
                                      true => match(
                                        cpf2.*,
                                        .FnCall(_, _, _, _, _) => "",
                                        .Atom(_, cptok2) => cond(
                                          (cptok2.value.as_str() != "comptime") => "",
                                          true => match(
                                            cpargs2.get(usize(0)),
                                            .None => "",
                                            .Some(inner2) => match(
                                              atom_ident(inner2),
                                              .Some(n2) => n2,
                                              .None => ""
                                            )
                                          )
                                        )
                                      )
                                    )
                                  ),
                                  .None => ""
                                );
                                p_ty_c2 := match(
                                  pargs2.get(usize(1)),
                                  .Some(te2) => match(
                                    type_expr_to_c(te2),
                                    .Some(s2) => s2,
                                    .None => String.from("void*")
                                  ),
                                  .None => String.from("void*")
                                );
                                if(p_name2 != "", {
                                  out_params2.push(String.from(p_name2));
                                  out_param_tys2.push(p_ty_c2);
                                });
                              },
                              (pftok2.value.as_str() == "using") => (),
                              true => ()
                            )
                          )
                        )
                      );
                    });
                    body2 := match(
                      app_args.get(usize(0)),
                      .Some(b2) => b2,
                      .None => {
                        return(Option(FnDef).None);
                      }
                    );
                    Option(FnDef).Some(
                      FnDef(
                        name : String.from(name_str),
                        ret_ty_c : ret_ty_c2,
                        params : out_params2,
                        param_tys : out_param_tys2,
                        body : body2,
                        is_impl : false,
                        impl_type : String.new()
                      )
                    )
                  }
                )
              )
            )
          }
        )
      )
    )
  )
);
/// Try to extract function definitions from an `impl(TypeName, { ... })` block.
///
/// Recognises:
/// ```
///   FnCall(Atom("impl"), [Atom(TypeName), begin_expr], is_infix=false)
/// ```
/// where `begin_expr` contains `method_name :: (fn(...) -> T)(body)` definitions,
/// or a single `method_name : fn_expr` inline form.
///
/// Methods are renamed to `TypeName_method_name` in C to avoid collisions.
/// Returns a list of `FnDef` entries extracted from the impl body.
extract_impl_fns :: (fn(expr : AstExpr, type_prefix : str) -> ArrayList(FnDef))({
  results := ArrayList(FnDef).new();
  match(
    expr,
    .Atom(_, _) => results,
    .FnCall(_, top_func, top_args, top_infix, _) => cond(
      (top_infix) => results,
      (top_args.len() < usize(2)) => results,
      true => match(
        top_func.*,
        .FnCall(_, _, _, _, _) => results,
        .Atom(_, ftok) => cond(
          (!(ftok.value.as_str() == "impl")) => results,
          true => match(
            top_args.get(usize(1)),
            .None => results,
            .Some(body_expr) => match(
              body_expr,
              .Atom(_, _) => results,
              .FnCall(_, bf, ba, _, _) => match(
                bf.*,
                .FnCall(_, _, _, _, _) => results,
                .Atom(_, btok) => cond(
                  (btok.value.as_str() == "begin") => {
                    nm := ba.len();
                    (mi : usize) = usize(0);
                    while(mi < nm, {
                      mi = (mi + usize(1));
                      match(
                        ba.get(mi - usize(1)),
                        .None => (),
                        .Some(method_expr) => {
                          // Try `::` form first, then `:` form.
                          fd_opt := match(
                            extract_fn_def(method_expr),
                            .Some(fd_a) => Option(FnDef).Some(fd_a),
                            .None => extract_colon_fn_def(method_expr)
                          );
                          match(
                            fd_opt,
                            .None => (),
                            .Some(fd) => {
                              // Prefix the method C name: TypeName_method
                              c_name := String.from(type_prefix);
                              c_name.push_str("_");
                              c_name.push_string(fd.name);
                              results.push(
                                FnDef(
                                  name : c_name,
                                  ret_ty_c : subst_self_ty(fd.ret_ty_c, type_prefix),
                                  params : fd.params,
                                  param_tys : subst_self_ty_list(fd.param_tys, type_prefix),
                                  body : fd.body,
                                  is_impl : true,
                                  impl_type : String.from(type_prefix)
                                )
                              );
                            }
                          )
                        }
                      );
                    });
                    results
                  },
                  // Single inline method: `impl(T, method : fn_expr)` or `impl(T, method :: fn_expr)`
                  true => {
                    fd_opt2 := match(
                      extract_fn_def(body_expr),
                      .Some(fd_b) => Option(FnDef).Some(fd_b),
                      .None => extract_colon_fn_def(body_expr)
                    );
                    match(
                      fd_opt2,
                      .None => (),
                      .Some(fd2) => {
                        c_name2 := String.from(type_prefix);
                        c_name2.push_str("_");
                        c_name2.push_string(fd2.name);
                        results.push(
                          FnDef(
                            name : c_name2,
                            ret_ty_c : subst_self_ty(fd2.ret_ty_c, type_prefix),
                            params : fd2.params,
                            param_tys : subst_self_ty_list(fd2.param_tys, type_prefix),
                            body : fd2.body,
                            is_impl : true,
                            impl_type : String.from(type_prefix)
                          )
                        );
                      }
                    );
                    // Multi-method impls parse as `impl(T, method1 : ..., method2 : ..., ...)`.
                    // The first method is `body_expr`; remaining methods live in top_args[2..].
                    (extra_i : usize) = usize(2);
                    while(extra_i < top_args.len(), {
                      match(
                        top_args.get(extra_i),
                        .None => (),
                        .Some(extra_method_expr) => {
                          extra_fd_opt := match(
                            extract_fn_def(extra_method_expr),
                            .Some(fd_c) => Option(FnDef).Some(fd_c),
                            .None => extract_colon_fn_def(extra_method_expr)
                          );
                          match(
                            extra_fd_opt,
                            .None => (),
                            .Some(extra_fd) => {
                              extra_c_name := String.from(type_prefix);
                              extra_c_name.push_str("_");
                              extra_c_name.push_string(extra_fd.name);
                              results.push(
                                FnDef(
                                  name : extra_c_name,
                                  ret_ty_c : subst_self_ty(extra_fd.ret_ty_c, type_prefix),
                                  params : extra_fd.params,
                                  param_tys : subst_self_ty_list(extra_fd.param_tys, type_prefix),
                                  body : extra_fd.body,
                                  is_impl : true,
                                  impl_type : String.from(type_prefix)
                                )
                              );
                            }
                          );
                        }
                      );
                      extra_i = (extra_i + usize(1));
                    });
                    results
                  }
                )
              )
            )
          )
        )
      )
    )
  )
});
// ---------------------------------------------------------------------------
// build_param_tys_pipe
// ---------------------------------------------------------------------------
/// Build a pipe-separated string of C parameter types for lambda-lifting lookup.
/// e.g. ["int32_t", "int32_t(*_FP_)(int32_t)"] → "int32_t|int32_t(*_FP_)(int32_t)"
build_param_tys_pipe :: (fn(param_tys : ArrayList(String)) -> String)({
  sb := String.new();
  n := param_tys.len();
  (i : usize) = usize(0);
  while(i < n, {
    i = (i + usize(1));
    match(
      param_tys.get(i - usize(1)),
      .None => (),
      .Some(ty_s) => {
        if(sb.len() > usize(0), {
          sb.push_str("|");
        });
        sb.push_string(ty_s);
      }
    );
  });
  sb
});
export(
  FnDef,
  extract_fn_def,
  is_comptime_expr,
  StructDef,
  extract_struct_def,
  emit_struct_to_c,
  c_type_has_self,
  struct_has_self_fields,
  EnumVariantField,
  EnumVariant,
  EnumDef,
  extract_enum_def,
  emit_enum_to_c,
  extract_newtype_def,
  emit_newtype_to_c,
  ConstDef,
  extract_const_def,
  emit_const_to_c,
  extract_impl_fns
);
// ---------------------------------------------------------------------------
// extract_import_path — Phase 5g import resolution
// ---------------------------------------------------------------------------
/// Extract the path string from a bare `import("path")` expression.
/// Returns the path without surrounding double-quotes, or .None if not a bare import.
extract_bare_import_path :: (fn(e : AstExpr) -> Option(String))(
  match(
    e,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, func_box, fn_args, is_infix, _) => cond(
      is_infix => Option(String).None,
      (fn_args.len() != usize(1)) => Option(String).None,
      (
        !(
          match(
            func_box.*,
            .Atom(_, tok) => (tok.value.as_str() == BK_IMPORT),
            .FnCall(_, _, _, _, _) => false
          )
        )
      ) => Option(String).None,
      true => match(
        fn_args.get(usize(0)),
        .None => Option(String).None,
        .Some(path_arg) => match(
          path_arg,
          .FnCall(_, _, _, _, _) => Option(String).None,
          .Atom(_, ptok) => {
            raw := ptok.value.as_str();
            n := raw.len();
            cond(
              (n < usize(2)) => Option(String).None,
              true =>.Some(String.from(raw).substring(usize(1), n - usize(1)))
            )
          }
        )
      )
    )
  )
);
/// Extract the import path from any import form:
///   - `{ Names } :: import("path")` (infix `::`, RHS is import call)
///   - `open(import("path"))` (`open` wrapping import call)
///   - `import("path")` (bare import call)
/// Returns the path without surrounding quotes, or .None if not an import expression.
extract_import_path :: (fn(expr : AstExpr) -> Option(String))(
  match(
    expr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, func_box, fn_args, is_infix, _) => {
      fval := match(
        func_box.*,
        .Atom(_, tok) => tok.value.as_str(),
        .FnCall(_, _, _, _, _) => ""
      );
      cond(
        // Pattern: open import "path"
        ((fval == BK_OPEN) && (fn_args.len() >= usize(1))) =>
          match(
            fn_args.get(usize(0)),
            .None => Option(String).None,
            .Some(inner) => extract_bare_import_path(inner)
          ),
        // Pattern: { Names } :: import "path" (infix ::)
        (((fval == "::") && is_infix) && (fn_args.len() >= usize(2))) =>
          match(
            fn_args.get(usize(1)),
            .None => Option(String).None,
            .Some(rhs) => extract_bare_import_path(rhs)
          ),
        // Pattern: bare import "path"
        true => extract_bare_import_path(expr)
      )
    }
  )
);
export(extract_bare_import_path, extract_import_path);
/// Recursively collect every `import(...)` path reachable from `expr`,
/// including imports NESTED inside `impl({...})` / module / `begin`
/// bodies. `extract_import_path` only inspects a single expression, so a
/// top-level-only walk misses e.g. `env :: impl({ { getenv, setenv } ::
/// import("./libc/stdlib"); ... })` — the import lives inside the impl
/// body, not at module top level. The preload step (main.yo) needs these
/// nested imports cached, otherwise `evaluate_import` fails with
/// "module not preloaded" when the impl body is evaluated.
///
/// Paths may appear more than once (e.g. a `{ ... } :: import(p)` node
/// yields `p`, and recursing into its `import(p)` child yields `p`
/// again); callers dedup by resolved path.
collect_import_paths_recursive :: (
  fn(expr : AstExpr, out : ArrayList(String)) -> unit
)({
  match(
    extract_import_path(expr),
    .Some(p) => {
      out.push(p);
    },
    .None => ()
  );
  match(
    expr,
    .Atom(_, _) => (),
    .FnCall(_, fb, args, _, _) => {
      recur(fb.*, out);
      (i : usize) = usize(0);
      while(i < args.len(), {
        match(
          args.get(i),
          .Some(a) => recur(a, out),
          .None => ()
        );
        i = (i + usize(1));
      });
    }
  );
});
export(collect_import_paths_recursive);
// ---------------------------------------------------------------------------
// Test body compilation
// ---------------------------------------------------------------------------
/// Return `true` if `name` appears as a **call site** anywhere in `expr`,
/// skipping `::` binding definitions (which define, not call).
///
/// This is used to determine whether a locally-defined function is actually
/// invoked from the test body, so we only hoist functions that are needed.
is_fn_name_called :: (fn(name : str, expr : AstExpr) -> bool)(
  match(
    expr,
    .Atom(_, _) => false,
    .FnCall(_, func_box, args, is_infix, _) => {
      // Skip `::` bindings entirely — they define, not call.
      is_coloncolon := cond(
        is_infix => match(
          func_box.*,
          .Atom(_, optok) => ((optok.kind == TokenKind.Operator) && (optok.value.as_str() == "::")),
          .FnCall(_, _, _, _, _) => false
        ),
        true => false
      );
      // Recurse into all arguments to find calls anywhere in the expression tree.
      // For `::` bindings we skip the node itself (it defines, not calls) but
      // still descend into the RHS args so that `z :: some_fn()` counts as
      // calling `some_fn`.
      {
        this_is_call := (
          (!(is_infix)) && (
            (!(is_coloncolon)) && match(
              func_box.*,
              .Atom(_, ftok) => ((ftok.kind == TokenKind.Identifier) && (ftok.value.as_str() == name)),
              .FnCall(_, _, _, _, _) => false
            )
          )
        );
        cond(
          this_is_call => true,
          true => {
            found_in_func := match(
              func_box.*,
              .Atom(_, _) => false,
              .FnCall(_, _, _, _, _) => recur(name, func_box.*)
            );
            cond(
              found_in_func => true,
              true => {
                n := args.len();
                (i : usize) = usize(0);
                (found : bool) = false;
                while((i < n) && (!(found)), {
                  match(
                    args.get(i),
                    .None => (),
                    .Some(a) => {
                      if(recur(name, a), {
                        found = true;
                      });
                    }
                  );
                  i = (i + usize(1));
                });
                found
              }
            )
          }
        )
      }
    }
  )
);
/// Collect all `Name :: enum(...)` definitions reachable from `expr` into
/// `result` (DFS pre-order, so outer definitions come before inner ones).
/// Used by `emit_local_type_defs` to implement last-wins deduplication.
collect_all_enum_defs :: (fn(expr : AstExpr, result : ArrayList(EnumDef)) -> unit)(
  match(
    expr,
    .Atom(_, _) => (),
    .FnCall(_, _, args, _, _) => cond(
      is_begin_block(expr) => {
        n := args.len();
        (i : usize) = usize(0);
        while(i < n, {
          match(
            args.get(i),
            .None => (),
            .Some(stmt) => {
              match(
                extract_enum_def(stmt),
                .Some(ed) => cond(
                  (ed.variants.len() == usize(0)) => recur(stmt, result),
                  true => {
                    _r := result.push(ed);
                    ();
                  }
                ),
                .None => recur(stmt, result)
              );
            }
          );
          i = (i + usize(1));
        });
      },
      true => ()
    )
  )
);
merge_enum_defs_for_name :: (fn(all_eds : ArrayList(EnumDef), enum_name : str) -> EnumDef)({
  merged_variants := ArrayList(EnumVariant).new();
  is_complex := false;
  n_all := all_eds.len();
  (i : usize) = usize(0);
  while(i < n_all, {
    match(
      all_eds.get(i),
      .None => (),
      .Some(ed) => if(ed.name.as_str() == enum_name, {
        nv := ed.variants.len();
        (vi : usize) = usize(0);
        while(vi < nv, {
          match(
            ed.variants.get(vi),
            .None => (),
            .Some(ev) => {
              (later_same_variant : bool) = false;
              (j : usize) = (i + usize(1));
              while((j < n_all) && (!(later_same_variant)), {
                match(
                  all_eds.get(j),
                  .None => (),
                  .Some(later_ed) => if(later_ed.name.as_str() == enum_name, {
                    later_nv := later_ed.variants.len();
                    (later_vi : usize) = usize(0);
                    while((later_vi < later_nv) && (!(later_same_variant)), {
                      match(
                        later_ed.variants.get(later_vi),
                        .None => (),
                        .Some(later_ev) => if(later_ev.name.as_str() == ev.name.as_str(), {
                          later_same_variant = true;
                        })
                      );
                      later_vi = (later_vi + usize(1));
                    });
                  })
                );
                j = (j + usize(1));
              });
              if(!(later_same_variant), {
                if(ev.fields.len() > usize(0), {
                  is_complex = true;
                });
                merged_variants.push(ev);
              });
            }
          );
          vi = (vi + usize(1));
        });
      })
    );
    i = (i + usize(1));
  });
  EnumDef(name : String.from(enum_name), variants : merged_variants, is_complex : is_complex)
});
/// Recursively scan a begin-block AST for local `Name :: struct(...)` and
/// `Name :: enum(...)` definitions at any nesting depth.
///
/// For enums: uses **last-wins** deduplication so that when the same enum name
/// appears in multiple nested scopes, the last (innermost/deepest) definition
/// governs the emitted C typedef. All definitions still register their variants
/// so that variant names remain resolvable regardless of scope.
///
/// For structs: first-wins (unchanged, structs rarely conflict).
///
/// Used by `compile_test_body_to_c` (Pass 2.5) to emit type definitions
/// declared inside a test body before any hoisted function definitions.
emit_local_type_defs :: (fn(expr : AstExpr, ctx : CodegenContext) -> unit)({
  // --- Enums: collect all, then emit last occurrence of each name ---
  all_eds := ArrayList(EnumDef).new();
  collect_all_enum_defs(expr, all_eds);
  ned := all_eds.len();
  (ei : usize) = usize(0);
  while(ei < ned, {
    match(
      all_eds.get(ei),
      .None => (),
      .Some(ed) => {
        // Determine whether this is the last (rightmost) definition for this name.
        (j : usize) = (ei + usize(1));
        (later_found : bool) = false;
        while((j < ned) && (!(later_found)), {
          match(
            all_eds.get(j),
            .None => (),
            .Some(ed2) => {
              if(ed2.name.as_str() == ed.name.as_str(), {
                later_found = true;
              });
            }
          );
          j = (j + usize(1));
        });
        cond(
          // Last occurrence → emit one merged typedef and register variants.
          // Same-named local enums can appear in separate lexical scopes; the
          // bootstrap C backend has module-level typedefs, so merge distinct
          // variant names while allowing later definitions of the same variant
          // to win for field names/discriminants.
          (!(later_found)) => {
            merged_ed := merge_enum_defs_for_name(all_eds, ed.name.as_str());
            emit_enum_to_c(merged_ed, ctx);
          },
          // Earlier occurrence → only register variants (no C emit)
          true => _register_enum_variants(ed, ctx)
        );
      }
    );
    ei = (ei + usize(1));
  });
  // --- Structs: first-wins (walk begin blocks recursively) ---
  _emit_struct_defs :: (fn(e : AstExpr, c : CodegenContext) -> unit)(
    match(
      e,
      .Atom(_, _) => (),
      .FnCall(_, _, eargs, _, _) => cond(
        is_begin_block(e) => {
          en := eargs.len();
          (si : usize) = usize(0);
          while(si < en, {
            match(
              eargs.get(si),
              .None => (),
              .Some(stmt) => {
                match(
                  extract_struct_def(stmt),
                  .Some(sd) => emit_struct_to_c(sd, c),
                  .None => match(
                    extract_union_def(stmt),
                    .Some(ud) => emit_union_to_c(ud, c),
                    .None => {
                      // Check for type alias: `Name :: OtherTypeName`
                      // If OtherTypeName is a registered struct/enum, emit typedef.
                      alias_emitted := match(
                        stmt,
                        .Atom(_, _) => false,
                        .FnCall(_, alias_fn, alias_args, alias_infix, _) => cond(
                          (!(alias_infix && (alias_args.len() == usize(2)))) => false,
                          true => match(
                            alias_fn.*,
                            .FnCall(_, _, _, _, _) => false,
                            .Atom(_, alias_op) => cond(
                              (!(alias_op.value.as_str() == "::")) => false,
                              true => match(
                                alias_args.get(usize(0)),
                                .None => false,
                                .Some(lhs_e) => match(
                                  alias_args.get(usize(1)),
                                  .None => false,
                                  .Some(rhs_e) => match(
                                    lhs_e,
                                    .FnCall(_, _, _, _, _) => false,
                                    .Atom(_, lhs_tok) => cond(
                                      (lhs_tok.kind != TokenKind.Identifier) => false,
                                      true => match(
                                        rhs_e,
                                        .FnCall(_, _, _, _, _) => false,
                                        .Atom(_, rhs_tok) => cond(
                                          (rhs_tok.kind != TokenKind.Identifier) => false,
                                          // RHS must be a registered struct or enum
                                          (c.is_struct_name(rhs_tok.value.as_str())) => {
                                            // Emit: typedef RhsName LhsName;
                                            td := String.from("typedef ");
                                            td.push_string(rhs_tok.value);
                                            td.push_str(" ");
                                            td.push_string(lhs_tok.value);
                                            td.push_str(";");
                                            c.emitter.emit_declaration_string_line(td);
                                            // Register alias as struct with same fields
                                            match(
                                              c.get_struct_fields(rhs_tok.value.as_str()),
                                              .None => {
                                                c.register_struct(String.from(lhs_tok.value.as_str()));
                                              },
                                              .Some(fcsv) => {
                                                c.register_struct(String.from(lhs_tok.value.as_str()));
                                                c.register_struct_fields(lhs_tok.value.as_str(), fcsv.as_str());
                                              }
                                            );
                                            true
                                          },
                                          (c.is_enum_name(rhs_tok.value.as_str())) => {
                                            // Emit: typedef RhsName LhsName;
                                            td := String.from("typedef ");
                                            td.push_string(rhs_tok.value);
                                            td.push_str(" ");
                                            td.push_string(lhs_tok.value);
                                            td.push_str(";");
                                            c.emitter.emit_declaration_string_line(td);
                                            c.register_enum(String.from(lhs_tok.value.as_str()));
                                            true
                                          },
                                          true => false
                                        )
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      );
                      if(!(alias_emitted), {
                        recur(stmt, c);
                      });
                    }
                  )
                );
              }
            );
            si = (si + usize(1));
          });
        },
        true => ()
      )
    )
  );
  _emit_struct_defs(expr, ctx);
  // --- Array type aliases: `NAME :: [T; N]` ---
  // Walk the body recursively and register each fixed-size array alias so that
  // `b := NAME(v1, v2, ...)` can be emitted as `elem_type b[N] = {v1, v2, ...}`.
  _collect_array_aliases :: (fn(e : AstExpr, c : CodegenContext) -> unit)(
    match(
      e,
      .Atom(_, _) => (),
      .FnCall(_, ef_box, ef_args, ef_infix, _) => cond(
        is_begin_block(e) => {
          na_e := ef_args.len();
          (ia : usize) = usize(0);
          while(ia < na_e, {
            match(
              ef_args.get(ia),
              .None => (),
              .Some(stmt) => {
                recur(stmt, c);
              }
            );
            ia = (ia + usize(1));
          });
        },
        // `NAME :: Array(T, N)` — infix `::` with RHS = FnCall(Atom("Array"), [T, N])
        (ef_infix && (ef_args.len() == usize(2))) => match(
          ef_box.*,
          .FnCall(_, _, _, _, _) => (),
          .Atom(_, op_tok) => cond(
            (!(op_tok.value.as_str() == "::")) => (),
            true => match(
              ef_args.get(usize(0)),
              .None => (),
              .Some(name_e) => match(
                name_e,
                .FnCall(_, _, _, _, _) => (),
                .Atom(_, name_tok) => cond(
                  (name_tok.kind != TokenKind.Identifier) => (),
                  true => match(
                    ef_args.get(usize(1)),
                    .None => (),
                    .Some(rhs_e) => match(
                      rhs_e,
                      .Atom(_, _) => (),
                      .FnCall(_, rhs_fn, rhs_args, rhs_infix, _) => cond(
                        rhs_infix => (),
                        (rhs_args.len() != usize(2)) => (),
                        true => match(
                          rhs_fn.*,
                          .FnCall(_, _, _, _, _) => (),
                          .Atom(_, rfntok) => cond(
                            (!(rfntok.value.as_str() == BK_ARRAY)) => (),
                            true => match(
                              rhs_args.get(usize(0)),
                              .None => (),
                              .Some(elem_e) => match(
                                type_expr_to_c(elem_e),
                                .None => (),
                                .Some(elem_c) => match(
                                  rhs_args.get(usize(1)),
                                  .None => (),
                                  .Some(size_e) => match(
                                    size_e,
                                    .FnCall(_, _, _, _, _) => (),
                                    .Atom(_, sz_tok) => cond(
                                      (sz_tok.kind != TokenKind.Integer) => (),
                                      true => {
                                        // Parse the size integer
                                        sz_str := sz_tok.value.as_str();
                                        sz := usize(0);
                                        (si : usize) = usize(0);
                                        while(si < sz_str.len(), {
                                          ch_opt := sz_tok.value.at(si);
                                          match(
                                            ch_opt,
                                            .None => (),
                                            .Some(ch) => {
                                              if((ch.char >= u32(48)) && (ch.char <= u32(57)), {
                                                sz = ((sz * usize(10)) + usize(ch.char - u32(48)));
                                              });
                                            }
                                          );
                                          si = (si + usize(1));
                                        });
                                        c.register_array_alias(name_tok.value.as_str(), elem_c.as_str(), sz);
                                      }
                                    )
                                  )
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        ),
        true => ()
      )
    )
  );
  _collect_array_aliases(expr, ctx);
});
/// Scan a begin-block for `NAME :: literal` comptime constant definitions and
/// emit them as C `#define NAME value` macros.
///
/// Only simple literal values are handled: integer, float, bool.
/// Complex RHS expressions are silently ignored.
///
/// Called in `compile_test_body_to_c` before hoisting functions so that
/// any referenced constant names resolve in hoisted C functions.
emit_comptime_const_defs :: (fn(body : AstExpr, ctx : CodegenContext) -> unit)(
  match(
    body,
    .Atom(_, _) => (),
    .FnCall(_, _, bargs, _, _) => cond(
      is_begin_block(body) => {
        nb := bargs.len();
        (ib : usize) = usize(0);
        while(ib < nb, {
          match(
            bargs.get(ib),
            .None => (),
            .Some(stmt) => match(
              stmt,
              .Atom(_, _) => (),
              .FnCall(_, sfunc, sargs, sinfix, _) => cond(
                // Must be infix `::` with 2 args
                (!(sinfix)) => (),
                (sargs.len() != usize(2)) => (),
                (
                  !(
                    match(
                      sfunc.*,
                      .Atom(_, sfatom) => (sfatom.value.as_str() == "::"),
                      .FnCall(_, _, _, _, _) => false
                    )
                  )
                ) => (),
                true => match(
                  sargs.get(usize(0)),
                  .None => (),
                  .Some(name_expr) => match(
                    sargs.get(usize(1)),
                    .None => (),
                    .Some(val_expr) => match(
                      name_expr,
                      .FnCall(_, _, _, _, _) => (),
                      .Atom(_, natom) => cond(
                        (natom.kind != TokenKind.Identifier) => (),
                        true => match(
                          val_expr,
                          .FnCall(_, _, _, _, _) => (),
                          .Atom(_, vatom) => cond(
                            (vatom.kind == TokenKind.Integer) => {
                              line := String.from("static const int32_t ");
                              line.push_string(natom.value);
                              line.push_str(" = ");
                              line.push_string(vatom.value);
                              line.push_str(";");
                              ctx.emitter.emit_line(line.as_str());
                            },
                            (vatom.kind == TokenKind.Float) => {
                              line := String.from("static const double ");
                              line.push_string(natom.value);
                              line.push_str(" = ");
                              line.push_string(vatom.value);
                              line.push_str(";");
                              ctx.emitter.emit_line(line.as_str());
                            },
                            (vatom.kind == TokenKind.Bool) => {
                              line := String.from("static const bool ");
                              line.push_string(natom.value);
                              line.push_str(" = ");
                              line.push_string(vatom.value);
                              line.push_str(";");
                              ctx.emitter.emit_line(line.as_str());
                            },
                            true => ()
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          );
          ib = (ib + usize(1));
        });
      },
      true => ()
    )
  )
);
/// Infer a C type string from a simple RHS expression.
///
/// Handles:
///   - `i32(0)`, `u8(0)`, `bool(false)`, etc. — primitive type casts
///   - `true` / `false` atoms — bool
///   - integer literals — int32_t
///   - float literals — double
/// Returns None for complex expressions that cannot be inferred.
infer_c_type_from_rhs :: (fn(rhs : AstExpr) -> Option(String))(
  match(
    rhs,
    .Atom(_, tok) => cond(
      (tok.kind == TokenKind.Integer) => Option(String).Some(String.from("int32_t")),
      (tok.kind == TokenKind.Float) => Option(String).Some(String.from("double")),
      ((tok.value.as_str() == "true") || (tok.value.as_str() == "false")) => Option(String).Some(String.from("bool")),
      true => Option(String).None
    ),
    .FnCall(_, func, args, infix, _) => cond(
      infix => Option(String).None,
      (args.len() != usize(1)) => Option(String).None,
      true => match(
        func.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, ftok) => cond(
          (is_primitive_type_cast(ftok.value.as_str())) => Option(String).Some(type_name_to_c(ftok.value.as_str())),
          true => Option(String).None
        )
      )
    )
  )
);
/// Extract a module-level mutable variable declaration from an AST expression.
///
/// Handles two Yo forms:
///   1. `x := expr`           — infix `:=` with atom LHS (type inferred)
///   2. `(x : T) = expr`      — infix `=` with colon-annotated LHS (explicit type)
///
/// Returns None for function defs, constants (`::`) or anything else.
extract_module_var_def :: (fn(expr : AstExpr) -> Option(MutableVarDef))(
  match(
    expr,
    .Atom(_, _) => Option(MutableVarDef).None,
    .FnCall(_, top_func, top_args, top_infix, _) => cond(
      (!(top_infix)) => Option(MutableVarDef).None,
      (top_args.len() < usize(2)) => Option(MutableVarDef).None,
      true => match(
        top_func.*,
        .FnCall(_, _, _, _, _) => Option(MutableVarDef).None,
        .Atom(_, op_tok) => cond(
          // Form 1: name := rhs
          (op_tok.value.as_str() == ":=") => match(
            top_args.get(usize(0)),
            .None => Option(MutableVarDef).None,
            .Some(lhs) => match(
              atom_ident(lhs),
              .None => Option(MutableVarDef).None,
              .Some(var_name) => match(
                top_args.get(usize(1)),
                .None => Option(MutableVarDef).None,
                .Some(rhs) => match(
                  infer_c_type_from_rhs(rhs),
                  .None => Option(MutableVarDef).None,
                  .Some(c_ty) => Option(MutableVarDef).Some(
                    MutableVarDef(name : String.from(var_name), c_type : c_ty, rhs : rhs)
                  )
                )
              )
            )
          ),
          // Form 2: (name : T) = rhs
          (op_tok.value.as_str() == "=") => match(
            top_args.get(usize(0)),
            .None => Option(MutableVarDef).None,
            .Some(lhs) => match(
              lhs,
              .Atom(_, _) => Option(MutableVarDef).None,
              .FnCall(_, colon_func, colon_args, colon_infix, _) => cond(
                (!(colon_infix)) => Option(MutableVarDef).None,
                (colon_args.len() < usize(2)) => Option(MutableVarDef).None,
                (
                  !(
                    match(
                      colon_func.*,
                      .Atom(_, ctok) => (ctok.value.as_str() == ":"),
                      .FnCall(_, _, _, _, _) => false
                    )
                  )
                ) => Option(MutableVarDef).None,
                true => match(
                  colon_args.get(usize(0)),
                  .None => Option(MutableVarDef).None,
                  .Some(name_expr) => match(
                    atom_ident(name_expr),
                    .None => Option(MutableVarDef).None,
                    .Some(var_name) => match(
                      colon_args.get(usize(1)),
                      .None => Option(MutableVarDef).None,
                      .Some(ty_expr) => match(
                        type_expr_to_c(ty_expr),
                        .None => Option(MutableVarDef).None,
                        .Some(c_ty) => match(
                          top_args.get(usize(1)),
                          .None => Option(MutableVarDef).None,
                          .Some(rhs) => Option(MutableVarDef).Some(
                            MutableVarDef(name : String.from(var_name), c_type : c_ty, rhs : rhs)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          ),
          true => Option(MutableVarDef).None
        )
      )
    )
  )
);
/// Emit module-level mutable variable declarations to the declarations buffer.
///
/// Each variable is emitted as: `static C_TYPE name = init_val;`
/// Uses emit_declaration_line so it appears before all function bodies.
/// Also registers each variable's C type in the context for codegen of
/// function bodies that reference the variable.
emit_module_level_vars :: (fn(module_exprs : ArrayList(AstExpr), ctx : CodegenContext) -> unit)({
  ne := module_exprs.len();
  (ie : usize) = usize(0);
  indent := String.new();
  while(ie < ne, {
    ie = (ie + usize(1));
    match(
      module_exprs.get(ie - usize(1)),
      .None => (),
      .Some(mexpr) => match(
        extract_module_var_def(mexpr),
        .None => (),
        .Some(mvd) => {
          rhs_c := generate_expr(mvd.rhs, ctx, indent);
          rhs_str := match(rhs_c,.None => String.from("0"),.Some(s) => s);
          line := String.from("static ");
          line.push_string(mvd.c_type);
          line.push_str(" ");
          line.push_string(mvd.name);
          line.push_str(" = ");
          line.push_string(rhs_str);
          line.push_str("; /* module-level mutable variable */");
          ctx.emitter.emit_declaration_line(line.as_str());
          ctx.register_var_type(mvd.name.as_str(), mvd.c_type.as_str());
        }
      )
    );
  });
});
/// Recursively scan a begin-block AST for local `name :: fn` definitions.
///
/// Walks the expression tree depth-first. Any statement that matches
/// `extract_fn_def` is appended to `result`. Nested begin blocks are
/// scanned recursively so inner scopes are also covered.
///
/// Used by `compile_test_body_to_c` to hoist local function definitions
/// before the test body function, enabling forward-declaration-free C output.
collect_local_fn_defs :: (fn(expr : AstExpr, result : ArrayList(FnDef)) -> unit)({
  match(
    expr,
    .Atom(_, _) => (),
    .FnCall(_, top_func, args, top_infix, _) => {
      // Try to extract this expression itself as a fn definition.
      match(
        extract_fn_def(expr),
        .Some(fd) => {
          _r := result.push(fd);
          ()
        },
        .None => {
          // Try to extract impl methods from `impl(TypeName, { ... })`.
          cond(
            top_infix => (),
            true => match(
              top_func.*,
              .FnCall(_, _, _, _, _) => (),
              .Atom(_, ftok) => cond(
                (!(ftok.value.as_str() == "impl")) => (),
                (args.len() < usize(1)) => (),
                true => match(
                  args.get(usize(0)),
                  .None => (),
                  .Some(ty_expr) => match(
                    atom_ident(ty_expr),
                    .None => (),
                    .Some(type_prefix) => {
                      impl_fns := extract_impl_fns(expr, type_prefix);
                      nim := impl_fns.len();
                      (im : usize) = usize(0);
                      while(im < nim, {
                        im = (im + usize(1));
                        match(
                          impl_fns.get(im - usize(1)),
                          .None => (),
                          .Some(ifd) => {
                            _ri := result.push(ifd);
                            ()
                          }
                        );
                      });
                    }
                  )
                )
              )
            )
          );
        }
      );
      // If this is a begin block, recurse into each statement.
      cond(
        is_begin_block(expr) => {
          n := args.len();
          (i : usize) = usize(0);
          while(i < n, {
            match(
              args.get(i),
              .None => (),
              .Some(s) => recur(s, result)
            );
            i = (i + usize(1));
          });
        },
        true => ()
      );
    }
  );
});
/// Scan `expr` and register any `name :: fn...` definition that `extract_fn_def` would skip
/// (because the function has a comptime-only return type) into `ctx.skipped_fn_names`.
/// Call sites to these names will later emit `0` instead of an undeclared-function call.
collect_skipped_fn_names :: (fn(expr : AstExpr, ctx : CodegenContext) -> unit)({
  match(
    expr,
    .Atom(_, _) => (),
    .FnCall(_, top_func, top_args, top_infix, _) => {
      // Check if this is a `name :: ...` (infix `::`) with 2 args.
      cond(
        (!(top_infix)) => (),
        true => match(
          top_func.*,
          .FnCall(_, _, _, _, _) => (),
          .Atom(_, ttok) => cond(
            (ttok.value.as_str() != "::") => (),
            (top_args.len() != usize(2)) => (),
            true => match(
              extract_fn_def(expr),
              .Some(_) => (),
              // Only register as skipped if the RHS is a function application
              // (i.e., it has the `->` arrow operator pattern).
              // Non-function `::` bindings like `arr :: [1, 2, 3]` or `n :: 42`
              // should NOT be registered as skipped functions.
              .None => match(
                top_args.get(usize(1)),
                .None => (),
                .Some(rhs_check) => match(
                  rhs_check,
                  .Atom(_, _) => (),
                  .FnCall(_, app_func_chk, _, _, _) => cond(
                    (!(is_arrow_op(app_func_chk.*))) => (),
                    true => match(
                      top_args.get(usize(0)),
                      .None => (),
                      .Some(name_expr) => match(
                        atom_ident(name_expr),
                        .None => (),
                        .Some(name_s) => ctx.register_skipped_fn(name_s)
                      )
                    )
                  )
                )
              )
            )
          )
        )
      );
      // Recurse into begin blocks.
      cond(
        is_begin_block(expr) => {
          n := top_args.len();
          (i : usize) = usize(0);
          while(i < n, {
            match(
              top_args.get(i),
              .None => (),
              .Some(s) => recur(s, ctx)
            );
            i = (i + usize(1));
          });
        },
        true => ()
      );
    }
  );
});
/// True if the C type `c_ty` needs an snprintf buffer (i.e. is not already a string).
_c_type_needs_snprintf :: (fn(c_ty : str) -> bool)(
  !((c_ty == "const char*") || ((c_ty == "char*") || (c_ty == "String")))
);
/// Return the snprintf format specifier for a numeric C type.
_c_type_format_spec :: (fn(c_ty : str) -> str)(
  cond(
    (c_ty == "int32_t") => "%d",
    (c_ty == "int64_t") => "%lld",
    (c_ty == "int16_t") => "%hd",
    (c_ty == "int8_t") => "%hhd",
    (c_ty == "uint32_t") => "%u",
    (c_ty == "uint64_t") => "%llu",
    (c_ty == "uint16_t") => "%hu",
    (c_ty == "uint8_t") => "%hhu",
    (c_ty == "size_t") => "%zu",
    (c_ty == "float") => "%g",
    (c_ty == "double") => "%g",
    (c_ty == "bool") => "%d",
    true => "%s"
  )
);
/// Build a left-nested `__yo_str_concat(a, b, c, ...)` chain from a list of parts.
/// parts[0] is the seed; parts[1..] are wrapped one by one.
_build_concat_chain :: (fn(parts : ArrayList(String)) -> String)({
  n := parts.len();
  cond(
    (n == usize(0)) => String.from("\"\""),
    (n == usize(1)) => match(
      parts.get(usize(0)),
      .None => String.from("\"\""),
      .Some(p) => p
    ),
    true => {
      (result : String) = match(
        parts.get(usize(0)),
        .None => String.from("\"\""),
        .Some(p) => p
      );
      (i : usize) = usize(1);
      while(i < n, {
        match(
          parts.get(i),
          .None => (),
          .Some(p) => {
            new_result := String.from("__yo_str_concat(");
            new_result.push_string(result);
            new_result.push_str(", ");
            new_result.push_string(p);
            new_result.push_str(")");
            result = new_result;
          }
        );
        i = (i + usize(1));
      });
      result
    }
  )
});
/// Emit a `static const char* fn_TypeName_to_string(TypeName* self)` function for a struct.
emit_struct_tostring_fn :: (fn(sd : StructDef, ctx : CodegenContext) -> unit)({
  type_name := sd.name.as_str();
  n := sd.field_names.len();
  ctx.emitter.emit_declaration("static const char* fn_");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("_to_string(");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration_line("* self) {");
  // Collect parts for concat chain; emit snprintf buffers for numeric fields
  parts := ArrayList(String).new();
  // Opening string: "TypeName("
  open_str := String.from("\"");
  open_str.push_str(type_name);
  open_str.push_str("(\"");
  parts.push(open_str);
  (buf_idx : usize) = usize(0);
  (fi : usize) = usize(0);
  while(fi < n, {
    match(
      sd.field_names.get(fi),
      .None => (),
      .Some(fname) => match(
        sd.field_tys.get(fi),
        .None => (),
        .Some(fty) => {
          // Separator before all fields except the first
          if(fi > usize(0), {
            sep := String.from("\", \"");
            parts.push(sep);
          });
          // Field access expression: self->field_name
          access := String.from("self->");
          access.push_string(fname);
          cond(
            (_c_type_needs_snprintf(fty.as_str())) => {
              // Emit snprintf buffer: `  char _ts0[64]; snprintf(_ts0, 64, "%d", self->field);\n`
              buf_name := String.from("_ts");
              buf_name.push_string(buf_idx.to_string());
              ctx.emitter.emit_declaration("  char ");
              ctx.emitter.emit_declaration_string(buf_name);
              ctx.emitter.emit_declaration("[64]; snprintf(");
              ctx.emitter.emit_declaration_string(buf_name);
              ctx.emitter.emit_declaration(", 64, \"");
              ctx.emitter.emit_declaration(_c_type_format_spec(fty.as_str()));
              ctx.emitter.emit_declaration("\", ");
              ctx.emitter.emit_declaration_string(access);
              ctx.emitter.emit_declaration_line(");");
              buf_idx = (buf_idx + usize(1));
              parts.push(buf_name);
            },
            true => {
              // String-like: use access directly
              parts.push(access);
            }
          );
        }
      )
    );
    fi = (fi + usize(1));
  });
  // Closing ")"
  parts.push(String.from("\")\""));
  concat_expr := _build_concat_chain(parts);
  ctx.emitter.emit_declaration("  return ");
  ctx.emitter.emit_declaration_string(concat_expr);
  ctx.emitter.emit_declaration_line(";");
  ctx.emitter.emit_declaration_line("}");
});
/// Emit a `static const char* fn_TypeName_to_string(TypeName* self)` function for a simple enum.
emit_simple_enum_tostring_fn :: (fn(ed : EnumDef, ctx : CodegenContext) -> unit)({
  type_name := ed.name.as_str();
  nv := ed.variants.len();
  ctx.emitter.emit_declaration("static const char* fn_");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("_to_string(");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration_line("* self) {");
  ctx.emitter.emit_declaration_line("  switch (*self) {");
  (vi : usize) = usize(0);
  while(vi < nv, {
    match(
      ed.variants.get(vi),
      .None => (),
      .Some(ev) => {
        // case TypeName_VariantName: return "TypeName.VariantName";
        ctx.emitter.emit_declaration("    case ");
        ctx.emitter.emit_declaration(type_name);
        ctx.emitter.emit_declaration("_");
        ctx.emitter.emit_declaration_string(ev.name);
        ctx.emitter.emit_declaration(": return \"");
        ctx.emitter.emit_declaration(type_name);
        ctx.emitter.emit_declaration(".");
        ctx.emitter.emit_declaration_string(ev.name);
        ctx.emitter.emit_declaration_line("\";");
      }
    );
    vi = (vi + usize(1));
  });
  ctx.emitter.emit_declaration_line("    default: return \"unknown\";");
  ctx.emitter.emit_declaration_line("  }");
  ctx.emitter.emit_declaration_line("}");
});
/// Emit a `static const char* fn_TypeName_to_string(TypeName* self)` function for a complex enum.
emit_complex_enum_tostring_fn :: (fn(ed : EnumDef, ctx : CodegenContext) -> unit)({
  type_name := ed.name.as_str();
  nv := ed.variants.len();
  ctx.emitter.emit_declaration("static const char* fn_");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("_to_string(");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration_line("* self) {");
  ctx.emitter.emit_declaration_line("  switch (self->tag) {");
  (vi : usize) = usize(0);
  while(vi < nv, {
    match(
      ed.variants.get(vi),
      .None => (),
      .Some(ev) => {
        vn := ev.name.as_str();
        nf := ev.fields.len();
        cond(
          // Simple variant inside complex enum: just return name
          (nf == usize(0)) => {
            ctx.emitter.emit_declaration("    case ");
            ctx.emitter.emit_declaration(type_name);
            ctx.emitter.emit_declaration("_");
            ctx.emitter.emit_declaration(vn);
            ctx.emitter.emit_declaration(": return \"");
            ctx.emitter.emit_declaration(type_name);
            ctx.emitter.emit_declaration(".");
            ctx.emitter.emit_declaration(vn);
            ctx.emitter.emit_declaration_line("\";");
          },
          // Data variant: build concat expression
          true => {
            ctx.emitter.emit_declaration("    case ");
            ctx.emitter.emit_declaration(type_name);
            ctx.emitter.emit_declaration("_");
            ctx.emitter.emit_declaration(vn);
            ctx.emitter.emit_declaration_line(": {");
            // Collect concat parts, emit snprintf buffers for numeric fields
            parts := ArrayList(String).new();
            open_str := String.from("\"");
            open_str.push_str(type_name);
            open_str.push_str(".");
            open_str.push_str(vn);
            open_str.push_str("(\"");
            parts.push(open_str);
            (buf_idx : usize) = usize(0);
            (fi : usize) = usize(0);
            while(fi < nf, {
              match(
                ev.fields.get(fi),
                .None => (),
                .Some(fld) => {
                  if(fi > usize(0), {
                    sep := String.from("\", \"");
                    parts.push(sep);
                  });
                  // Access: self->data.VariantName.field_name
                  access := String.from("self->data.");
                  access.push_str(vn);
                  access.push_str(".");
                  access.push_string(fld.name);
                  cond(
                    (_c_type_needs_snprintf(fld.c_ty.as_str())) => {
                      buf_name := String.from("_ts");
                      buf_name.push_string(buf_idx.to_string());
                      ctx.emitter.emit_declaration("      char ");
                      ctx.emitter.emit_declaration_string(buf_name);
                      ctx.emitter.emit_declaration("[64]; snprintf(");
                      ctx.emitter.emit_declaration_string(buf_name);
                      ctx.emitter.emit_declaration(", 64, \"");
                      ctx.emitter.emit_declaration(_c_type_format_spec(fld.c_ty.as_str()));
                      ctx.emitter.emit_declaration("\", ");
                      ctx.emitter.emit_declaration_string(access);
                      ctx.emitter.emit_declaration_line(");");
                      buf_idx = (buf_idx + usize(1));
                      parts.push(buf_name);
                    },
                    true => {
                      parts.push(access);
                    }
                  );
                }
              );
              fi = (fi + usize(1));
            });
            // Closing ")"
            parts.push(String.from("\")\""));
            concat_expr := _build_concat_chain(parts);
            ctx.emitter.emit_declaration("      return ");
            ctx.emitter.emit_declaration_string(concat_expr);
            ctx.emitter.emit_declaration_line(";");
            ctx.emitter.emit_declaration_line("    }");
          }
        );
      }
    );
    vi = (vi + usize(1));
  });
  ctx.emitter.emit_declaration_line("    default: return \"unknown\";");
  ctx.emitter.emit_declaration_line("  }");
  ctx.emitter.emit_declaration_line("}");
});
/// Check if `ToString` appears in a list of derive trait arguments
/// (starting from index 1 of the derive call).
_has_tostring_trait :: (fn(args : ArrayList(AstExpr)) -> bool)({
  n := args.len();
  (i : usize) = usize(1);
  (found : bool) = false;
  while((i < n) && (!(found)), {
    match(
      args.get(i),
      .None => (),
      .Some(a) => match(
        a,
        .FnCall(_, _, _, _, _) => (),
        .Atom(_, tok) => {
          if((tok.kind == TokenKind.Identifier) && (tok.value.as_str() == "ToString"), {
            found = true;
          });
        }
      )
    );
    i = (i + usize(1));
  });
  found
});
/// Scan `exprs` and `body` for `derive(TypeName, ..., ToString, ...)` calls.
/// For each such call, emit the corresponding `fn_TypeName_to_string` C function
/// using the struct/enum definition found in `exprs`.
/// Also registers the type name in `ctx.derive_tostring_names`.
process_derive_tostring :: (fn(exprs : ArrayList(AstExpr), body : AstExpr, ctx : CodegenContext) -> unit)({
  n := exprs.len();
  (ie : usize) = usize(0);
  while(ie < n, {
    match(
      exprs.get(ie),
      .None => (),
      .Some(mexpr) => match(
        mexpr,
        .Atom(_, _) => (),
        .FnCall(_, mf, margs, minfix, _) => cond(
          // Look for `derive(TypeName, ..., ToString, ...)` — a non-infix call
          // to `derive` with at least 2 args where one of the args is `ToString`.
          (minfix || (margs.len() < usize(2))) => (),
          true => match(
            mf.*,
            .FnCall(_, _, _, _, _) => (),
            .Atom(_, dtok) => cond(
              (dtok.value.as_str() != "derive") => (),
              (!(_has_tostring_trait(margs))) => (),
              true => {
                // Extract the type name (first arg)
                match(
                  margs.get(usize(0)),
                  .None => (),
                  .Some(ty_arg) => match(
                    atom_ident(ty_arg),
                    .None => (),
                    .Some(type_name) => {
                      // Don't register/emit twice
                      if(!(ctx.has_derive_tostring(type_name)), {
                        // Find the struct or enum definition for this type
                        found_struct := {
                          (je : usize) = usize(0);
                          (sd_opt : Option(StructDef)) = Option(StructDef).None;
                          while((je < n) && match(sd_opt,.None => true,.Some(_) => false), {
                            match(
                              exprs.get(je),
                              .None => (),
                              .Some(def_expr) => match(
                                extract_struct_def(def_expr),
                                .None => (),
                                .Some(sd) => {
                                  if(sd.name.as_str() == type_name, {
                                    sd_opt = Option(StructDef).Some(sd);
                                  });
                                }
                              )
                            );
                            je = (je + usize(1));
                          });
                          sd_opt
                        };
                        found_enum := {
                          (ke : usize) = usize(0);
                          (ed_opt : Option(EnumDef)) = Option(EnumDef).None;
                          while((ke < n) && match(ed_opt,.None => true,.Some(_) => false), {
                            match(
                              exprs.get(ke),
                              .None => (),
                              .Some(def_expr) => match(
                                extract_enum_def(def_expr),
                                .None => (),
                                .Some(ed) => {
                                  if(ed.name.as_str() == type_name, {
                                    ed_opt = Option(EnumDef).Some(ed);
                                  });
                                }
                              )
                            );
                            ke = (ke + usize(1));
                          });
                          ed_opt
                        };
                        match(
                          found_struct,
                          .Some(sd) => {
                            ctx.register_derive_tostring(type_name);
                            emit_struct_tostring_fn(sd, ctx);
                          },
                          .None => match(
                            found_enum,
                            .None => (),
                            .Some(ed) => {
                              ctx.register_derive_tostring(type_name);
                              cond(
                                (!(ed.is_complex)) => emit_simple_enum_tostring_fn(ed, ctx),
                                true => emit_complex_enum_tostring_fn(ed, ctx)
                              );
                            }
                          )
                        );
                      });
                    }
                  )
                );
              }
            )
          )
        )
      )
    );
    ie = (ie + usize(1));
  });
});
// ---------------------------------------------------------------------------
// derive(Clone) code generation helpers
// ---------------------------------------------------------------------------
/// True if the C type `c_ty` is a heap-allocated string that needs `strdup` when cloning.
_c_field_needs_strdup :: (fn(c_ty : str) -> bool)(
  (c_ty == "const char*") || (c_ty == "char*")
);
/// Emit a `static TypeName fn_TypeName_clone(const TypeName* self)` function for a struct.
emit_struct_clone_fn :: (fn(sd : StructDef, ctx : CodegenContext) -> unit)({
  type_name := sd.name.as_str();
  n := sd.field_names.len();
  ctx.emitter.emit_declaration("static ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration(" fn_");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("_clone(const ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration_line("* self) {");
  ctx.emitter.emit_declaration("  ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration_line(" result;");
  (fi : usize) = usize(0);
  while(fi < n, {
    match(
      sd.field_names.get(fi),
      .None => (),
      .Some(fname) => match(
        sd.field_tys.get(fi),
        .None => (),
        .Some(fty) => {
          ctx.emitter.emit_declaration("  result.");
          ctx.emitter.emit_declaration_string(fname);
          cond(
            (_c_field_needs_strdup(fty.as_str())) => {
              ctx.emitter.emit_declaration(" = strdup(self->");
              ctx.emitter.emit_declaration_string(fname);
              ctx.emitter.emit_declaration_line(");");
            },
            true => {
              ctx.emitter.emit_declaration(" = self->");
              ctx.emitter.emit_declaration_string(fname);
              ctx.emitter.emit_declaration_line(";");
            }
          );
        }
      )
    );
    fi = (fi + usize(1));
  });
  ctx.emitter.emit_declaration_line("  return result;");
  ctx.emitter.emit_declaration_line("}");
});
/// Emit a `static TypeName fn_TypeName_clone(const TypeName* self)` function for a complex enum.
emit_complex_enum_clone_fn :: (fn(ed : EnumDef, ctx : CodegenContext) -> unit)({
  type_name := ed.name.as_str();
  nv := ed.variants.len();
  ctx.emitter.emit_declaration("static ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration(" fn_");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("_clone(const ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration_line("* self) {");
  ctx.emitter.emit_declaration("  ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration_line(" result;");
  ctx.emitter.emit_declaration_line("  result.tag = self->tag;");
  ctx.emitter.emit_declaration_line("  switch (self->tag) {");
  (vi : usize) = usize(0);
  while(vi < nv, {
    match(
      ed.variants.get(vi),
      .None => (),
      .Some(ev) => {
        vn := ev.name.as_str();
        nf := ev.fields.len();
        ctx.emitter.emit_declaration("    case ");
        ctx.emitter.emit_declaration(type_name);
        ctx.emitter.emit_declaration("_");
        ctx.emitter.emit_declaration(vn);
        ctx.emitter.emit_declaration_line(": {");
        cond(
          (nf == usize(0)) => {
            // Simple variant: copy the _dummy field
            ctx.emitter.emit_declaration("      result.data.");
            ctx.emitter.emit_declaration(vn);
            ctx.emitter.emit_declaration("._dummy = self->data.");
            ctx.emitter.emit_declaration(vn);
            ctx.emitter.emit_declaration_line("._dummy;");
          },
          true => {
            // Data variant: copy each field
            (fi : usize) = usize(0);
            while(fi < nf, {
              match(
                ev.fields.get(fi),
                .None => (),
                .Some(fld) => {
                  ctx.emitter.emit_declaration("      result.data.");
                  ctx.emitter.emit_declaration(vn);
                  ctx.emitter.emit_declaration(".");
                  ctx.emitter.emit_declaration_string(fld.name);
                  cond(
                    (_c_field_needs_strdup(fld.c_ty.as_str())) => {
                      ctx.emitter.emit_declaration(" = strdup(self->data.");
                      ctx.emitter.emit_declaration(vn);
                      ctx.emitter.emit_declaration(".");
                      ctx.emitter.emit_declaration_string(fld.name);
                      ctx.emitter.emit_declaration_line(");");
                    },
                    true => {
                      ctx.emitter.emit_declaration(" = self->data.");
                      ctx.emitter.emit_declaration(vn);
                      ctx.emitter.emit_declaration(".");
                      ctx.emitter.emit_declaration_string(fld.name);
                      ctx.emitter.emit_declaration_line(";");
                    }
                  );
                }
              );
              fi = (fi + usize(1));
            });
          }
        );
        ctx.emitter.emit_declaration_line("      break;");
        ctx.emitter.emit_declaration_line("    }");
      }
    );
    vi = (vi + usize(1));
  });
  ctx.emitter.emit_declaration_line("  }");
  ctx.emitter.emit_declaration_line("  return result;");
  ctx.emitter.emit_declaration_line("}");
});
// ---------------------------------------------------------------------------
// derive(Eq) code generation helpers
// ---------------------------------------------------------------------------
/// Emit a `static bool fn_TypeName_eq(const TypeName* a, const TypeName* b)` for a struct.
emit_struct_eq_fn :: (fn(sd : StructDef, ctx : CodegenContext) -> unit)({
  type_name := sd.name.as_str();
  n := sd.field_names.len();
  ctx.emitter.emit_declaration("static bool fn_");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("_eq(const ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("* a, const ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration_line("* b) {");
  (fi : usize) = usize(0);
  while(fi < n, {
    match(
      sd.field_names.get(fi),
      .None => (),
      .Some(fname) => match(
        sd.field_tys.get(fi),
        .None => (),
        .Some(fty) => {
          cond(
            (_c_field_needs_strdup(fty.as_str())) => {
              ctx.emitter.emit_declaration("  if (strcmp(a->");
              ctx.emitter.emit_declaration_string(fname);
              ctx.emitter.emit_declaration(", b->");
              ctx.emitter.emit_declaration_string(fname);
              ctx.emitter.emit_declaration_line(") != 0) return false;");
            },
            true => {
              cond(
                (ctx.has_derive_eq(fty.as_str())) => {
                  // Nested struct/enum: use recursive eq dispatch
                  ctx.emitter.emit_declaration("  if (!fn_");
                  ctx.emitter.emit_declaration(fty.as_str());
                  ctx.emitter.emit_declaration("_eq(&a->");
                  ctx.emitter.emit_declaration_string(fname);
                  ctx.emitter.emit_declaration(", &b->");
                  ctx.emitter.emit_declaration_string(fname);
                  ctx.emitter.emit_declaration_line(")) return false;");
                },
                true => {
                  ctx.emitter.emit_declaration("  if (a->");
                  ctx.emitter.emit_declaration_string(fname);
                  ctx.emitter.emit_declaration(" != b->");
                  ctx.emitter.emit_declaration_string(fname);
                  ctx.emitter.emit_declaration_line(") return false;");
                }
              );
            }
          );
        }
      )
    );
    fi = (fi + usize(1));
  });
  ctx.emitter.emit_declaration_line("  return true;");
  ctx.emitter.emit_declaration_line("}");
});
/// Emit a `static bool fn_TypeName_eq(const TypeName* a, const TypeName* b)` for a complex enum.
emit_complex_enum_eq_fn :: (fn(ed : EnumDef, ctx : CodegenContext) -> unit)({
  type_name := ed.name.as_str();
  nv := ed.variants.len();
  ctx.emitter.emit_declaration("static bool fn_");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("_eq(const ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("* a, const ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration_line("* b) {");
  ctx.emitter.emit_declaration_line("  if (a->tag != b->tag) return false;");
  ctx.emitter.emit_declaration_line("  switch (a->tag) {");
  (vi : usize) = usize(0);
  while(vi < nv, {
    match(
      ed.variants.get(vi),
      .None => (),
      .Some(ev) => {
        vn := ev.name.as_str();
        nf := ev.fields.len();
        ctx.emitter.emit_declaration("    case ");
        ctx.emitter.emit_declaration(type_name);
        ctx.emitter.emit_declaration("_");
        ctx.emitter.emit_declaration(vn);
        ctx.emitter.emit_declaration_line(": {");
        cond(
          (nf == usize(0)) => {
            ctx.emitter.emit_declaration_line("      return true;");
          },
          true => {
            // Build condition: compare each field
            (fi : usize) = usize(0);
            (first_field : bool) = true;
            ctx.emitter.emit_declaration("      return ");
            while(fi < nf, {
              match(
                ev.fields.get(fi),
                .None => (),
                .Some(fld) => {
                  if(!(first_field), {
                    ctx.emitter.emit_declaration(" && ");
                  });
                  cond(
                    (_c_field_needs_strdup(fld.c_ty.as_str())) => {
                      ctx.emitter.emit_declaration("(strcmp(a->data.");
                      ctx.emitter.emit_declaration(vn);
                      ctx.emitter.emit_declaration(".");
                      ctx.emitter.emit_declaration_string(fld.name);
                      ctx.emitter.emit_declaration(", b->data.");
                      ctx.emitter.emit_declaration(vn);
                      ctx.emitter.emit_declaration(".");
                      ctx.emitter.emit_declaration_string(fld.name);
                      ctx.emitter.emit_declaration(") == 0)");
                    },
                    true => {
                      ctx.emitter.emit_declaration("(a->data.");
                      ctx.emitter.emit_declaration(vn);
                      ctx.emitter.emit_declaration(".");
                      ctx.emitter.emit_declaration_string(fld.name);
                      ctx.emitter.emit_declaration(" == b->data.");
                      ctx.emitter.emit_declaration(vn);
                      ctx.emitter.emit_declaration(".");
                      ctx.emitter.emit_declaration_string(fld.name);
                      ctx.emitter.emit_declaration(")");
                    }
                  );
                  first_field = false;
                }
              );
              fi = (fi + usize(1));
            });
            ctx.emitter.emit_declaration_line(";");
          }
        );
        ctx.emitter.emit_declaration_line("    }");
      }
    );
    vi = (vi + usize(1));
  });
  ctx.emitter.emit_declaration_line("    default: return false;");
  ctx.emitter.emit_declaration_line("  }");
  ctx.emitter.emit_declaration_line("}");
});
// ---------------------------------------------------------------------------
// derive(Hash) code generation helpers
// ---------------------------------------------------------------------------
/// Emit `static size_t fn_TypeName_hash(const TypeName* self)` for a struct.
/// Uses a simple multiplicative hash mix: h ^= field * 2654435761.
emit_struct_hash_fn :: (fn(sd : StructDef, ctx : CodegenContext) -> unit)({
  type_name := sd.name.as_str();
  n := sd.field_names.len();
  ctx.emitter.emit_declaration("static size_t fn_");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("_hash(const ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration_line("* self) {");
  ctx.emitter.emit_declaration_line("  size_t h = 0;");
  (fi : usize) = usize(0);
  while(fi < n, {
    match(
      sd.field_names.get(fi),
      .None => (),
      .Some(fname) => match(
        sd.field_tys.get(fi),
        .None => (),
        .Some(fty) => {
          cond(
            (_c_field_needs_strdup(fty.as_str())) => {
              // str field: hash each character
              ctx.emitter.emit_declaration("  { const char* __s = self->");
              ctx.emitter.emit_declaration_string(fname);
              ctx.emitter.emit_declaration_line("; size_t __sh = 0; while(*__s) __sh = __sh * 31 + (unsigned char)*__s++; h ^= __sh * 2654435761ULL; }");
            },
            (ctx.has_derive_hash(fty.as_str())) => {
              // Nested struct/enum: use recursive hash dispatch
              ctx.emitter.emit_declaration("  h ^= fn_");
              ctx.emitter.emit_declaration(fty.as_str());
              ctx.emitter.emit_declaration("_hash(&self->");
              ctx.emitter.emit_declaration_string(fname);
              ctx.emitter.emit_declaration_line(");");
            },
            true => {
              ctx.emitter.emit_declaration("  h ^= (size_t)self->");
              ctx.emitter.emit_declaration_string(fname);
              ctx.emitter.emit_declaration_line(" * 2654435761ULL;");
            }
          );
        }
      )
    );
    fi = (fi + usize(1));
  });
  ctx.emitter.emit_declaration_line("  return h;");
  ctx.emitter.emit_declaration_line("}");
});
/// Emit `static size_t fn_TypeName_hash(const TypeName* self)` for a fieldless enum.
emit_fieldless_enum_hash_fn :: (fn(type_name : str, ctx : CodegenContext) -> unit)({
  ctx.emitter.emit_declaration("static size_t fn_");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("_hash(const ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration_line("* self) {");
  ctx.emitter.emit_declaration_line("  return (size_t)*self;");
  ctx.emitter.emit_declaration_line("}");
});
// ---------------------------------------------------------------------------
// derive(Ord) code generation helpers
// ---------------------------------------------------------------------------
/// Emit `static int32_t fn_TypeName_cmp(const TypeName* a, const TypeName* b)` for a struct.
/// Lexicographic: compare fields in order.
emit_struct_ord_fn :: (fn(sd : StructDef, ctx : CodegenContext) -> unit)({
  type_name := sd.name.as_str();
  n := sd.field_names.len();
  ctx.emitter.emit_declaration("static int32_t fn_");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("_cmp(const ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("* a, const ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration_line("* b) {");
  (fi : usize) = usize(0);
  while(fi < n, {
    match(
      sd.field_names.get(fi),
      .None => (),
      .Some(fname) => match(
        sd.field_tys.get(fi),
        .None => (),
        .Some(fty) => {
          cond(
            (ctx.has_derive_ord(fty.as_str())) => {
              // Nested struct: use recursive cmp dispatch
              ctx.emitter.emit_declaration("  { int32_t __c = fn_");
              ctx.emitter.emit_declaration(fty.as_str());
              ctx.emitter.emit_declaration("_cmp(&a->");
              ctx.emitter.emit_declaration_string(fname);
              ctx.emitter.emit_declaration(", &b->");
              ctx.emitter.emit_declaration_string(fname);
              ctx.emitter.emit_declaration_line("); if (__c != 0) return __c; }");
            },
            true => {
              ctx.emitter.emit_declaration("  if (a->");
              ctx.emitter.emit_declaration_string(fname);
              ctx.emitter.emit_declaration(" != b->");
              ctx.emitter.emit_declaration_string(fname);
              ctx.emitter.emit_declaration_line(") return (a->");
              ctx.emitter.emit_declaration_string(fname);
              ctx.emitter.emit_declaration(" < b->");
              ctx.emitter.emit_declaration_string(fname);
              ctx.emitter.emit_declaration_line(") ? -1 : 1;");
            }
          );
        }
      )
    );
    fi = (fi + usize(1));
  });
  ctx.emitter.emit_declaration_line("  return 0;");
  ctx.emitter.emit_declaration_line("}");
});
/// Emit `static int32_t fn_TypeName_cmp(const TypeName* a, const TypeName* b)` for a fieldless enum.
emit_fieldless_enum_ord_fn :: (fn(type_name : str, ctx : CodegenContext) -> unit)({
  ctx.emitter.emit_declaration("static int32_t fn_");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("_cmp(const ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("* a, const ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration_line("* b) {");
  ctx.emitter.emit_declaration_line("  return ((int32_t)*a) - ((int32_t)*b);");
  ctx.emitter.emit_declaration_line("}");
});
// ---------------------------------------------------------------------------
// derive(Clone) for fieldless enum
// ---------------------------------------------------------------------------
/// Emit `static TypeName fn_TypeName_clone(const TypeName* self)` for a fieldless enum.
emit_fieldless_enum_clone_fn :: (fn(type_name : str, ctx : CodegenContext) -> unit)({
  ctx.emitter.emit_declaration("static ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration(" fn_");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration("_clone(const ");
  ctx.emitter.emit_declaration(type_name);
  ctx.emitter.emit_declaration_line("* self) {");
  ctx.emitter.emit_declaration_line("  return *self;");
  ctx.emitter.emit_declaration_line("}");
});
/// True if the `Hash` atom appears in a list of derive trait arguments (starting from index 1).
_has_hash_trait :: (fn(args : ArrayList(AstExpr)) -> bool)({
  n := args.len();
  (i : usize) = usize(1);
  (found : bool) = false;
  while((i < n) && (!(found)), {
    match(
      args.get(i),
      .None => (),
      .Some(a) => match(
        a,
        .FnCall(_, _, _, _, _) => (),
        .Atom(_, tok) => {
          if((tok.kind == TokenKind.Identifier) && (tok.value.as_str() == "Hash"), {
            found = true;
          });
        }
      )
    );
    i = (i + usize(1));
  });
  found
});
/// True if `Ord` or `Ord(TypeName)` appears in a list of derive trait arguments (starting from index 1).
_has_ord_trait :: (fn(args : ArrayList(AstExpr)) -> bool)({
  n := args.len();
  (i : usize) = usize(1);
  (found : bool) = false;
  while((i < n) && (!(found)), {
    match(
      args.get(i),
      .None => (),
      .Some(a) => match(
        a,
        // `Ord(TypeName)` call form
        .FnCall(_, ord_fn, _, ord_infix, _) => {
          if(!(ord_infix), {
            match(
              ord_fn.*,
              .FnCall(_, _, _, _, _) => (),
              .Atom(_, etok) => {
                if(etok.value.as_str() == "Ord", {
                  found = true;
                });
              }
            );
          });
        },
        // bare `Ord` atom form
        .Atom(_, tok) => {
          if((tok.kind == TokenKind.Identifier) && (tok.value.as_str() == "Ord"), {
            found = true;
          });
        }
      )
    );
    i = (i + usize(1));
  });
  found
});
/// Scan `exprs` for `derive(TypeName, ..., Hash, ...)` calls and emit hash functions.
process_derive_hash :: (fn(exprs : ArrayList(AstExpr), ctx : CodegenContext) -> unit)({
  n := exprs.len();
  (ie : usize) = usize(0);
  while(ie < n, {
    match(
      exprs.get(ie),
      .None => (),
      .Some(mexpr) => match(
        mexpr,
        .Atom(_, _) => (),
        .FnCall(_, mf, margs, minfix, _) => cond(
          (minfix || (margs.len() < usize(2))) => (),
          true => match(
            mf.*,
            .FnCall(_, _, _, _, _) => (),
            .Atom(_, dtok) => cond(
              (dtok.value.as_str() != "derive") => (),
              (!(_has_hash_trait(margs))) => (),
              true => {
                match(
                  margs.get(usize(0)),
                  .None => (),
                  .Some(ty_arg) => match(
                    atom_ident(ty_arg),
                    .None => (),
                    .Some(type_name) => {
                      if(!(ctx.has_derive_hash(type_name)), {
                        found_struct := {
                          (je : usize) = usize(0);
                          (sd_opt : Option(StructDef)) = Option(StructDef).None;
                          while((je < n) && match(sd_opt,.None => true,.Some(_) => false), {
                            match(
                              exprs.get(je),
                              .None => (),
                              .Some(def_expr) => match(
                                extract_struct_def(def_expr),
                                .None => (),
                                .Some(sd) => {
                                  if(sd.name.as_str() == type_name, {
                                    sd_opt = Option(StructDef).Some(sd);
                                  });
                                }
                              )
                            );
                            je = (je + usize(1));
                          });
                          sd_opt
                        };
                        found_enum := {
                          (ke : usize) = usize(0);
                          (ed_opt : Option(EnumDef)) = Option(EnumDef).None;
                          while((ke < n) && match(ed_opt,.None => true,.Some(_) => false), {
                            match(
                              exprs.get(ke),
                              .None => (),
                              .Some(def_expr) => match(
                                extract_enum_def(def_expr),
                                .None => (),
                                .Some(ed) => {
                                  if(ed.name.as_str() == type_name, {
                                    ed_opt = Option(EnumDef).Some(ed);
                                  });
                                }
                              )
                            );
                            ke = (ke + usize(1));
                          });
                          ed_opt
                        };
                        match(
                          found_struct,
                          .Some(sd) => {
                            ctx.register_derive_hash(type_name);
                            emit_struct_hash_fn(sd, ctx);
                          },
                          .None => match(
                            found_enum,
                            .None => (),
                            .Some(ed) => {
                              ctx.register_derive_hash(type_name);
                              if(!(ed.is_complex), {
                                emit_fieldless_enum_hash_fn(type_name, ctx);
                              });
                            }
                          )
                        );
                      });
                    }
                  )
                );
              }
            )
          )
        )
      )
    );
    ie = (ie + usize(1));
  });
});
/// Scan `exprs` for `derive(TypeName, ..., Ord(...), ...)` calls and emit cmp functions.
process_derive_ord :: (fn(exprs : ArrayList(AstExpr), ctx : CodegenContext) -> unit)({
  n := exprs.len();
  (ie : usize) = usize(0);
  while(ie < n, {
    match(
      exprs.get(ie),
      .None => (),
