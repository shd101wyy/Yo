/// Scan `exprs` for `derive(TypeName, ..., Clone, ...)` calls and emit clone functions.
process_derive_clone :: (fn(exprs : ArrayList(AstExpr), ctx : CodegenContext) -> unit)({
  n := exprs.len();
  (ie : usize) = usize(0);
  while(ie < n, {
    match(
      exprs.get(ie),
      .None => (),
      .Some(mexpr) => match(
        mexpr,
        .Atom(_, _) => (),
        .FnCall(_, mf, margs, minfix, _) => cond(
          (minfix || (margs.len() < usize(2))) => (),
          true => match(
            mf.*,
            .FnCall(_, _, _, _, _) => (),
            .Atom(_, dtok) => cond(
              (dtok.value.as_str() != "derive") => (),
              (!(_has_clone_trait(margs))) => (),
              true => {
                match(
                  margs.get(usize(0)),
                  .None => (),
                  .Some(ty_arg) => match(
                    atom_ident(ty_arg),
                    .None => (),
                    .Some(type_name) => {
                      if(!(ctx.has_derive_clone(type_name)), {
                        found_struct := {
                          (je : usize) = usize(0);
                          (sd_opt : Option(StructDef)) = Option(StructDef).None;
                          while((je < n) && match(sd_opt,.None => true,.Some(_) => false), {
                            match(
                              exprs.get(je),
                              .None => (),
                              .Some(def_expr) => match(
                                extract_struct_def(def_expr),
                                .None => (),
                                .Some(sd) => {
                                  if(sd.name.as_str() == type_name, {
                                    sd_opt = Option(StructDef).Some(sd);
                                  });
                                }
                              )
                            );
                            je = (je + usize(1));
                          });
                          sd_opt
                        };
                        found_enum := {
                          (ke : usize) = usize(0);
                          (ed_opt : Option(EnumDef)) = Option(EnumDef).None;
                          while((ke < n) && match(ed_opt,.None => true,.Some(_) => false), {
                            match(
                              exprs.get(ke),
                              .None => (),
                              .Some(def_expr) => match(
                                extract_enum_def(def_expr),
                                .None => (),
                                .Some(ed) => {
                                  if(ed.name.as_str() == type_name, {
                                    ed_opt = Option(EnumDef).Some(ed);
                                  });
                                }
                              )
                            );
                            ke = (ke + usize(1));
                          });
                          ed_opt
                        };
                        match(
                          found_struct,
                          .Some(sd) => {
                            ctx.register_derive_clone(type_name);
                            emit_struct_clone_fn(sd, ctx);
                          },
                          .None => match(
                            found_enum,
                            .None => (),
                            .Some(ed) => {
                              ctx.register_derive_clone(type_name);
                              cond(
                                ed.is_complex => emit_complex_enum_clone_fn(ed, ctx),
                                true => emit_fieldless_enum_clone_fn(type_name, ctx)
                              );
                            }
                          )
                        );
                      });
                    }
                  )
                );
              }
            )
          )
        )
      )
    );
    ie = (ie + usize(1));
  });
});
/// Extract the type name from a `comptime_eval("derive(TypeName, ...)")` call.
/// The token value includes surrounding double-quotes, e.g. `"derive(EvalPoint, Eq(EvalPoint))"`.
/// Returns None if the expression doesn't match.
_extract_comptime_eval_derive_typename :: (fn(mexpr : AstExpr) -> Option(String))(
  match(
    mexpr,
    .Atom(_, _) => Option(String).None,
    .FnCall(_, mf_ce, margs_ce, minfix_ce, _) => cond(
      minfix_ce => Option(String).None,
      (margs_ce.len() != usize(1)) => Option(String).None,
      true => match(
        mf_ce.*,
        .FnCall(_, _, _, _, _) => Option(String).None,
        .Atom(_, ce_tok) => cond(
          (ce_tok.value.as_str() != "comptime_eval") => Option(String).None,
          true => match(
            margs_ce.get(usize(0)),
            .None => Option(String).None,
            .Some(slit) => match(
              slit,
              .FnCall(_, _, _, _, _) => Option(String).None,
              .Atom(_, stok) => {
                raw := stok.value;
                // Must start with `"derive(` (quote + derive + open paren = 8 chars)
                prefix := String.from("\"derive(");
                cond(
                  (!(raw.starts_with(prefix))) => Option(String).None,
                  true => {
                    // Strip `"derive(` prefix → rest is `TypeName, ...)"`
                    rest := raw.substring(prefix.len(), raw.len());
                    // Find first `,` or `)` to get end of type name
                    comma_opt := rest.index_of(String.from(","));
                    paren_opt := rest.index_of(String.from(")"));
                    // Use Option(usize) to avoid early return
                    end_pos_opt := cond(
                      match(comma_opt,.Some(cp) => match(paren_opt,.Some(pp) => (cp < pp),.None => true),.None => false) =>
                        Option(usize).Some(match(comma_opt,.Some(cp2) => cp2,.None => usize(0))),
                      match(paren_opt,.Some(_) => true,.None => false) =>
                        Option(usize).Some(match(paren_opt,.Some(pp2) => pp2,.None => usize(0))),
                      true => Option(usize).None
                    );
                    match(
                      end_pos_opt,
                      .None => Option(String).None,
                      .Some(end_pos) => {
                        type_name := rest.substring(usize(0), end_pos).trim();
                        cond(
                          (type_name.len() == usize(0)) => Option(String).None,
                          true => Option(String).Some(type_name)
                        )
                      }
                    )
                  }
                )
              }
            )
          )
        )
      )
    )
  )
);
/// Check whether a raw derive string like `"derive(TypeName, Eq(TypeName))"` contains a given trait name.
_derive_string_contains_trait :: (fn(raw : String, trait_name : str) -> bool)(
  raw.contains(String.from(trait_name))
);
/// Scan `exprs` for `derive(TypeName, ..., Eq(...), ...)` calls and emit eq functions.
process_derive_eq :: (fn(exprs : ArrayList(AstExpr), ctx : CodegenContext) -> unit)({
  n := exprs.len();
  (ie : usize) = usize(0);
  while(ie < n, {
    match(
      exprs.get(ie),
      .None => (),
      .Some(mexpr) => {
        // Handle `comptime_eval("derive(TypeName, ..., Eq(...), ...)")` form.
        ce_typename_opt := _extract_comptime_eval_derive_typename(mexpr);
        match(
          ce_typename_opt,
          .Some(ce_typename) => {
            // Check if the raw string contains "Eq"
            raw_str := match(
              mexpr,
              .Atom(_, _) => String.new(),
              .FnCall(_, _, ce_margs, _, _) => match(
                ce_margs.get(usize(0)),
                .None => String.new(),
                .Some(slit) => match(
                  slit,
                  .Atom(_, stok) => stok.value,
                  .FnCall(_, _, _, _, _) => String.new()
                )
              )
            );
            if(_derive_string_contains_trait(raw_str, "Eq") && (!(ctx.has_derive_eq(ce_typename.as_str()))), {
              // Look up struct/enum def in exprs
              (je2 : usize) = usize(0);
              (ce_sd_opt : Option(StructDef)) = Option(StructDef).None;
              while((je2 < n) && match(ce_sd_opt,.None => true,.Some(_) => false), {
                match(
                  exprs.get(je2),
                  .None => (),
                  .Some(def_e) => match(
                    extract_struct_def(def_e),
                    .None => (),
                    .Some(sd2) => {
                      if(sd2.name.as_str() == ce_typename.as_str(), {
                        ce_sd_opt = Option(StructDef).Some(sd2);
                      });
                    }
                  )
                );
                je2 = (je2 + usize(1));
              });
              (ke2 : usize) = usize(0);
              (ce_ed_opt : Option(EnumDef)) = Option(EnumDef).None;
              while((ke2 < n) && match(ce_ed_opt,.None => true,.Some(_) => false), {
                match(
                  exprs.get(ke2),
                  .None => (),
                  .Some(def_e2) => match(
                    extract_enum_def(def_e2),
                    .None => (),
                    .Some(ed2) => {
                      if(ed2.name.as_str() == ce_typename.as_str(), {
                        ce_ed_opt = Option(EnumDef).Some(ed2);
                      });
                    }
                  )
                );
                ke2 = (ke2 + usize(1));
              });
              match(
                ce_sd_opt,
                .Some(sd3) => {
                  ctx.register_derive_eq(ce_typename.as_str());
                  emit_struct_eq_fn(sd3, ctx);
                },
                .None => match(
                  ce_ed_opt,
                  .None => (),
                  .Some(ed3) => {
                    if(ed3.is_complex, {
                      ctx.register_derive_eq(ce_typename.as_str());
                      emit_complex_enum_eq_fn(ed3, ctx);
                    });
                  }
                )
              );
            });
          },
          .None => ()
        );
        // Handle regular `derive(TypeName, ..., Eq(...), ...)` form.
        match(
          mexpr,
          .Atom(_, _) => (),
          .FnCall(_, mf, margs, minfix, _) => cond(
            (minfix || (margs.len() < usize(2))) => (),
            true => match(
              mf.*,
              .FnCall(_, _, _, _, _) => (),
              .Atom(_, dtok) => cond(
                (dtok.value.as_str() != "derive") => (),
                (!(_has_eq_trait(margs))) => (),
                true => {
                  match(
                    margs.get(usize(0)),
                    .None => (),
                    .Some(ty_arg) => match(
                      atom_ident(ty_arg),
                      .None => (),
                      .Some(type_name) => {
                        if(!(ctx.has_derive_eq(type_name)), {
                          found_struct := {
                            (je : usize) = usize(0);
                            (sd_opt : Option(StructDef)) = Option(StructDef).None;
                            while((je < n) && match(sd_opt,.None => true,.Some(_) => false), {
                              match(
                                exprs.get(je),
                                .None => (),
                                .Some(def_expr) => match(
                                  extract_struct_def(def_expr),
                                  .None => (),
                                  .Some(sd) => {
                                    if(sd.name.as_str() == type_name, {
                                      sd_opt = Option(StructDef).Some(sd);
                                    });
                                  }
                                )
                              );
                              je = (je + usize(1));
                            });
                            sd_opt
                          };
                          found_enum := {
                            (ke : usize) = usize(0);
                            (ed_opt : Option(EnumDef)) = Option(EnumDef).None;
                            while((ke < n) && match(ed_opt,.None => true,.Some(_) => false), {
                              match(
                                exprs.get(ke),
                                .None => (),
                                .Some(def_expr) => match(
                                  extract_enum_def(def_expr),
                                  .None => (),
                                  .Some(ed) => {
                                    if(ed.name.as_str() == type_name, {
                                      ed_opt = Option(EnumDef).Some(ed);
                                    });
                                  }
                                )
                              );
                              ke = (ke + usize(1));
                            });
                            ed_opt
                          };
                          match(
                            found_struct,
                            .Some(sd) => {
                              ctx.register_derive_eq(type_name);
                              emit_struct_eq_fn(sd, ctx);
                            },
                            .None => match(
                              found_enum,
                              .None => (),
                              .Some(ed) => {
                                // Only register and emit eq function for complex enums.
                                // Simple enums are represented as C integers and C == works natively.
                                if(ed.is_complex, {
                                  ctx.register_derive_eq(type_name);
                                  emit_complex_enum_eq_fn(ed, ctx);
                                });
                              }
                            )
                          );
                        });
                      }
                    )
                  );
                }
              )
            )
          )
        )
      }
    );
    ie = (ie + usize(1));
  });
});
///
/// The body is wrapped in a `static void fn_test_body(void)` function.
// ---------------------------------------------------------------------------
// compile_module_to_c
// ---------------------------------------------------------------------------
/// Recursively scan a function body for local type definitions
/// (`Name :: struct(...)`, `Name :: enum(...)`, `Name :: newtype(...)`,
/// `Name :: union(...)`) and emit them as top-level C typedefs.
///
/// This walks into nested begin blocks (e.g. inside if branches, while bodies)
/// so type definitions at any depth get hoisted to the C file's top level.
scan_and_emit_local_defs :: (
  fn(body : AstExpr, ctx : CodegenContext) -> unit
)(
  match(
    body,
    .Atom(_, _) => (),
    .FnCall(_, func_box, args, _, _) => {
      // First, try to extract a type def from the expr itself
      sd_opt := extract_struct_def(body);
      match(
        sd_opt,
        .Some(sd) => emit_struct_to_c(sd, ctx),
        .None => {
          ed_opt := extract_enum_def(body);
          match(
            ed_opt,
            .Some(ed) => emit_enum_to_c(ed, ctx),
            .None => {
              ud_opt := extract_union_def(body);
              match(
                ud_opt,
                .Some(ud) => emit_union_to_c(ud, ctx),
                .None => ()
              );
            }
          );
        }
      );
      // Recurse into begin block children to find nested defs
      is_begin := match(
        func_box.*,
        .Atom(_, ftok) => (ftok.value.as_str() == BK_BEGIN),
        .FnCall(_, _, _, _, _) => false
      );
      if(is_begin, {
        (i : usize) = usize(0);
        n := args.len();
        while(i < n, {
          match(args.get(i),.None => (),.Some(child) => recur(child, ctx));
          i = (i + usize(1));
        });
      });
    }
  )
);
// ---------------------------------------------------------------------------
/// Walk a parsed module body and generate a complete C11 source file.
///
/// * Every `name :: (fn(…) -> T)(body)` top-level expression is compiled as a
///   static C function.
/// * A `int main(void)` wrapper that calls the function named `main_name` is
///   appended.
/// * Returns `None` if no functions were found or the main function is absent.
compile_module_to_c :: (
  fn(
    exprs : ArrayList(AstExpr),
    module_id : str,
    main_name : str
  ) -> Option(String)
)({
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  // One-shot handoff: install the pipeline's ExprInfoTable (if the
  // caller staged one via `set_pipeline_expr_info_table`) and reset
  // the slot so the next compilation starts clean.
  ctx.expr_info_table = g_pipeline_expr_info_table;
  g_pipeline_expr_info_table = Option(ExprInfoTable).None;
  emit_c_preamble(module_id, pctx);
  n := exprs.len();
  (i : usize) = usize(0);
  // === Pass 1: register all top-level Yo function names ===
  // This allows forward calls (foo calls bar defined later) to receive the
  // correct `fn_` prefix in the generated C.
  while(i < n, {
    i = (i + usize(1));
    match(
      exprs.get(i - usize(1)),
      .None => (),
      .Some(expr) => {
        match(
          extract_fn_def(expr),
          .Some(fd) => {
            name_copy := String.from(fd.name.as_str());
            pctx.register_fn_with_params(name_copy, build_param_tys_pipe(fd.param_tys));
            pctx.register_fn_return_type(fd.name.as_str(), fd.ret_ty_c.as_str());
          },
          .None => {
            // Also register impl method names for forward reference support.
            match(
              expr,
              .Atom(_, _) => (),
              .FnCall(_, imp_func, imp_args, imp_infix, _) => cond(
                (imp_infix) => (),
                (imp_args.len() < usize(2)) => (),
                true => match(
                  imp_func.*,
                  .FnCall(_, _, _, _, _) => (),
                  .Atom(_, itok) => cond(
                    (!(itok.value.as_str() == "impl")) => (),
                    true => match(
                      imp_args.get(usize(0)),
                      .None => (),
                      .Some(tn_e) => match(
                        atom_ident(tn_e),
                        .None => (),
                        .Some(type_name) => {
                          impl_fns := extract_impl_fns(expr, type_name);
                          nim := impl_fns.len();
                          (mi : usize) = usize(0);
                          while(mi < nim, {
                            mi = (mi + usize(1));
                            match(
                              impl_fns.get(mi - usize(1)),
                              .None => (),
                              .Some(ifd) => {
                                iname := String.from(ifd.name.as_str());
                                pctx.register_fn_with_params(iname, build_param_tys_pipe(ifd.param_tys));
                                pctx.register_fn_return_type(ifd.name.as_str(), ifd.ret_ty_c.as_str());
                              }
                            );
                          });
                        }
                      )
                    )
                  )
                )
              )
            );
          }
        );
      }
    );
  });
  // === Pass 1.5: emit module-level mutable variable declarations ===
  emit_module_level_vars(exprs, pctx);
  // === Pass 2: emit structs, functions, and impl methods ===
  i = usize(0);
  (main_found : bool) = false;
  (main_c_name : String) = String.new();
  while(i < n, {
    i = (i + usize(1));
    match(
      exprs.get(i - usize(1)),
      .None => (),
      .Some(expr) => {
        // First: try to extract a function definition.
        fn_opt := extract_fn_def(expr);
        match(
          fn_opt,
          .Some(fd) => {
            // Build C function name: fn_<yo_name> (simple convention)
            c_name := `fn_${ fd.name }`;
            if(fd.name.as_str() == main_name, {
              main_found = true;
              main_c_name = c_name;
            });
            // Pre-scan body for local type definitions and emit them as
            // top-level C typedefs before generating the function body.
            scan_and_emit_local_defs(fd.body, pctx);
            emit_function_declaration(
              c_name.as_str(),
              fd.ret_ty_c.as_str(),
              fd.params,
              fd.param_tys,
              pctx
            );
            generate_function(
              c_name.as_str(),
              fd.ret_ty_c.as_str(),
              fd.params,
              fd.param_tys,
              fd.body,
              pctx
            );
          },
          .None => {
            // Second: try to extract an enum definition.
            ed_opt := extract_enum_def(expr);
            match(
              ed_opt,
              .Some(ed) => {
                emit_enum_to_c(ed, pctx);
              },
              .None => {
                // Third: try to extract a struct definition.
                sd_opt := extract_struct_def(expr);
                match(
                  sd_opt,
                  .Some(sd) => {
                    emit_struct_to_c(sd, pctx);
                  },
                  .None => {
                    // Third-b: try to extract a newtype definition.
                    nt_opt := extract_newtype_def(expr);
                    match(
                      nt_opt,
                      .Some(nt_pair) => {
                        nt_name := match(
                          nt_pair.get(usize(0)),
                          .Some(nt_n) => nt_n,
                          .None => String.new()
                        );
                        nt_inner := match(
                          nt_pair.get(usize(1)),
                          .Some(nt_t) => nt_t,
                          .None => String.new()
                        );
                        if(nt_name.len() > usize(0), {
                          emit_newtype_to_c(nt_name.as_str(), nt_inner.as_str(), pctx);
                        });
                      },
                      .None => {
                        // Fourth: try to extract impl methods.
                        // We detect `impl(TypeName, { ... })` by checking if the
                        // expression starts with `impl` and has 2 args.
                        impl_fns := match(
                          expr,
                          .Atom(_, _) => ArrayList(FnDef).new(),
                          .FnCall(_, imp_func, imp_args, imp_infix, _) => cond(
                            (imp_infix) => ArrayList(FnDef).new(),
                            (imp_args.len() < usize(2)) => ArrayList(FnDef).new(),
                            true => match(
                              imp_func.*,
                              .FnCall(_, _, _, _, _) => ArrayList(FnDef).new(),
                              .Atom(_, itok) => cond(
                                (!(itok.value.as_str() == "impl")) => ArrayList(FnDef).new(),
                                true => match(
                                  imp_args.get(usize(0)),
                                  .None => ArrayList(FnDef).new(),
                                  .Some(tn_e) => match(
                                    atom_ident(tn_e),
                                    .None => ArrayList(FnDef).new(),
                                    .Some(type_name) => extract_impl_fns(expr, type_name)
                                  )
                                )
                              )
                            )
                          )
                        );
                        nm := impl_fns.len();
                        (mi : usize) = usize(0);
                        while(mi < nm, {
                          mi = (mi + usize(1));
                          match(
                            impl_fns.get(mi - usize(1)),
                            .None => (),
                            .Some(fd) => {
                              if(fd.name.as_str() == main_name, {
                                main_found = true;
                                main_c_name = fd.name;
                              });
                              emit_function_declaration(
                                fd.name.as_str(),
                                fd.ret_ty_c.as_str(),
                                fd.params,
                                fd.param_tys,
                                pctx
                              );
                              generate_function(
                                fd.name.as_str(),
                                fd.ret_ty_c.as_str(),
                                fd.params,
                                fd.param_tys,
                                fd.body,
                                pctx
                              );
                            }
                          );
                        });
                        // Fifth: try to extract a module-level constant.
                        if(nm == usize(0), {
                          generic_template_registered := match(
                            expr,
                            .Atom(_, _) => false,
                            .FnCall(_, gen_func, gen_args, gen_infix, _) => cond(
                              (!(gen_infix && (gen_args.len() >= usize(2)))) => false,
                              true => match(
                                gen_func.*,
                                .FnCall(_, _, _, _, _) => false,
                                .Atom(_, gen_op_tok) => cond(
                                  (gen_op_tok.value.as_str() != "::") => false,
                                  true => match(
                                    gen_args.get(usize(0)),
                                    .None => false,
                                    .Some(gen_name_expr) => match(
                                      atom_ident(gen_name_expr),
                                      .None => false,
                                      .Some(gen_name) => match(
                                        gen_args.get(usize(1)),
                                        .None => false,
                                        .Some(gen_rhs) =>
                                          register_generic_struct_template_if_supported(gen_name, gen_rhs, pctx)
                                      )
                                    )
                                  )
                                )
                              )
                            )
                          );
                          if(!(generic_template_registered), {
                            match(
                              extract_const_def(expr),
                              .Some(cd) => emit_const_to_c(cd, pctx),
                              .None => ()
                            );
                          });
                        });
                      }
                    )
                  }
                )
              }
            )
          }
        );
      }
    );
  });
  // === Pass 3: derive code generation ===
  // Process derive(ToString), derive(Clone), derive(Eq), derive(Hash), derive(Ord)
  // for any types that have derive annotations.
  // Note: compile_module_to_c does not have a test body, so pass a dummy begin expr.
  dummy_body_args := ArrayList(AstExpr).new();
  dummy_tok := Token(kind : TokenKind.Identifier, value : String.from("begin"), row : usize(0), column : usize(0), character : usize(0), module_path : String.new(), input : String.new());
  dummy_body := AstExpr.FnCall(usize(0), box(AstExpr.Atom(usize(0), dummy_tok)), dummy_body_args, false, dummy_tok);
  process_derive_tostring(exprs, dummy_body, pctx);
  process_derive_clone(exprs, pctx);
  process_derive_eq(exprs, pctx);
  process_derive_hash(exprs, pctx);
  process_derive_ord(exprs, pctx);
  cond(
    (!(main_found)) => Option(String).None,
    true => {
      emit_main_wrapper(main_c_name.as_str(), pctx);
      .Some(generate_c_output(pctx))
    }
  )
});
export(compile_module_to_c, set_pipeline_expr_info_table);
/// An `int main(void)` wrapper calls `fn_test_body()`.
///
/// `assert(cond, msg)` in the body emits `if (!(cond)) { exit(1); }` via
/// the `handle_assert` hook in `generate_expr`.
///
/// `module_exprs` should be the full list of top-level AST nodes from the
/// test file. Any `name :: (fn(...) -> T)(body)` definitions are:
///   1. Registered so call sites get the `fn_` prefix.
///   2. Emitted as C functions before the test body so calls can resolve.
/// Struct definitions and impl methods are also emitted.
/// Test declarations (`test("name", { body })`) are skipped.
///
/// Returns the full C source string.
compile_test_body_to_c :: (fn(body : AstExpr, module_id : str, module_exprs : ArrayList(AstExpr)) -> String)({
  ctx := CodegenContext.new();
  (pctx : CodegenContext) = ctx;
  // === Pass 1: register all top-level function names ===
  ne := module_exprs.len();
  (ie : usize) = usize(0);
  while(ie < ne, {
    ie = (ie + usize(1));
    match(
      module_exprs.get(ie - usize(1)),
      .None => (),
      .Some(mexpr) => {
        match(
          extract_fn_def(mexpr),
          .None => {
            // Register any skipped (comptime-return) function names from module-level exprs.
            collect_skipped_fn_names(mexpr, pctx);
            // Also register impl methods so static calls get fn_ prefix
            impl_fns_pass1 := extract_impl_fns(mexpr, "");
            // The prefix is "" here; actual name is already prefixed in extract_impl_fns
            // But we call it with "" so we need to actually extract the type name first
            match(
              mexpr,
              .Atom(_, _) => (),
              .FnCall(_, mf, margs, minfix, _) => cond(
                minfix => (),
                (margs.len() < usize(1)) => (),
                true => match(
                  mf.*,
                  .FnCall(_, _, _, _, _) => (),
                  .Atom(_, mtok) => cond(
                    (!(mtok.value.as_str() == "impl")) => (),
                    true => match(
                      margs.get(usize(0)),
                      .None => (),
                      .Some(ty_expr) => match(
                        atom_ident(ty_expr),
                        .None => (),
                        .Some(tp) => {
                          impl_fns_tp := extract_impl_fns(mexpr, tp);
                          n_imp := impl_fns_tp.len();
                          (ii : usize) = usize(0);
                          while(ii < n_imp, {
                            ii = (ii + usize(1));
                            match(
                              impl_fns_tp.get(ii - usize(1)),
                              .None => (),
                              .Some(ifd) => {
                                pctx.register_fn_with_params(String.from(ifd.name.as_str()), build_param_tys_pipe(ifd.param_tys));
                                pctx.register_fn_return_type(ifd.name.as_str(), ifd.ret_ty_c.as_str());
                              }
                            );
                          });
                        }
                      )
                    )
                  )
                )
              )
            );
          },
          .Some(fd) => {
            name_copy := String.from(fd.name.as_str());
            pctx.register_fn_with_params(name_copy, build_param_tys_pipe(fd.param_tys));
            pctx.register_fn_return_type(fd.name.as_str(), fd.ret_ty_c.as_str());
          }
        );
      }
    );
  });
  emit_c_preamble(module_id, pctx);
  // === Pass 1.5: emit module-level mutable variable declarations ===
  // These become `static C_TYPE name = init_val;` in the declarations section,
  // which precedes all function bodies. This mirrors TS emitModuleLevelVariableDeclarations().
  emit_module_level_vars(module_exprs, pctx);
  // === Pass 2: emit helper structs and functions ===
  ie = usize(0);
  while(ie < ne, {
    ie = (ie + usize(1));
    match(
      module_exprs.get(ie - usize(1)),
      .None => (),
      .Some(mexpr) => {
        // Emit top-level function definitions (skip test declarations)
        match(
          extract_fn_def(mexpr),
          .Some(fd) => {
            c_name := `fn_${ fd.name }`;
            emit_function_declaration(
              c_name.as_str(),
              fd.ret_ty_c.as_str(),
              fd.params,
              fd.param_tys,
              pctx
            );
            generate_function(
              c_name.as_str(),
              fd.ret_ty_c.as_str(),
              fd.params,
              fd.param_tys,
              fd.body,
              pctx
            );
          },
          .None => {
            // Emit enum definitions
            match(
              extract_enum_def(mexpr),
              .Some(ed) => cond(
                (ed.variants.len() == usize(0)) => (),
                true => {
                  emit_enum_to_c(ed, pctx);
                }
              ),
              .None => {
                // Emit struct definitions
                match(
                  extract_struct_def(mexpr),
                  .Some(sd) => {
                    emit_struct_to_c(sd, pctx);
                  },
                  .None => {
                    // Emit union definitions
                    match(
                      extract_union_def(mexpr),
                      .Some(ud) => {
                        emit_union_to_c(ud, pctx);
                      },
                      .None => {
                        match(
                          mexpr,
                          .Atom(_, _) => (),
                          .FnCall(_, gen_func2, gen_args2, gen_infix2, _) => if(gen_infix2 && (gen_args2.len() >= usize(2)), {
                            match(
                              gen_func2.*,
                              .FnCall(_, _, _, _, _) => (),
                              .Atom(_, gen_op_tok2) => if(gen_op_tok2.value.as_str() == "::", {
                                match(
                                  gen_args2.get(usize(0)),
                                  .None => (),
                                  .Some(gen_name_expr2) => match(
                                    atom_ident(gen_name_expr2),
                                    .None => (),
                                    .Some(gen_name2) => match(
                                      gen_args2.get(usize(1)),
                                      .None => (),
                                      .Some(gen_rhs2) => {
                                        register_generic_struct_template_if_supported(gen_name2, gen_rhs2, pctx);
                                      }
                                    )
                                  )
                                );
                              })
                            );
                          })
                        );
                        // Emit impl methods
                        match(
                          mexpr,
                          .Atom(_, _) => (),
                          .FnCall(_, mf2, margs2, minfix2, _) => cond(
                            minfix2 => (),
                            (margs2.len() < usize(1)) => (),
                            true => match(
                              mf2.*,
                              .FnCall(_, _, _, _, _) => (),
                              .Atom(_, mtok2) => cond(
                                (!(mtok2.value.as_str() == "impl")) => (),
                                true => match(
                                  margs2.get(usize(0)),
                                  .None => (),
                                  .Some(ty_expr2) => match(
                                    atom_ident(ty_expr2),
                                    .None => (),
                                    .Some(tp2) => {
                                      impl_fns2 := extract_impl_fns(mexpr, tp2);
                                      n_impl2 := impl_fns2.len();
                                      (ii2 : usize) = usize(0);
                                      while(ii2 < n_impl2, {
                                        ii2 = (ii2 + usize(1));
                                        match(
                                          impl_fns2.get(ii2 - usize(1)),
                                          .None => (),
                                          .Some(ifd2) => {
                                            c_name3 := `fn_${ ifd2.name }`;
                                            // Determine the implementing type (strip leading `TypeName_` prefix)
                                            // tp2 holds the Yo type name (e.g. "SomeUnion").
                                            pctx.set_self_type(tp2);
                                            emit_function_declaration(
                                              c_name3.as_str(),
                                              ifd2.ret_ty_c.as_str(),
                                              ifd2.params,
                                              ifd2.param_tys,
                                              pctx
                                            );
                                            generate_function(
                                              c_name3.as_str(),
                                              ifd2.ret_ty_c.as_str(),
                                              ifd2.params,
                                              ifd2.param_tys,
                                              ifd2.body,
                                              pctx
                                            );
                                            pctx.set_self_type("");
                                          }
                                        );
                                      });
                                    }
                                  )
                                )
                              )
                            )
                          )
                        );
                      }
                    );
                  }
                );
              }
            );
          }
        );
      }
    );
  });
  // === Pass 2.5: emit struct/enum type definitions from the test body ===
  //
  // Test bodies may define types inline (e.g., `Color :: enum(Red, Green, Blue)`).
  // These must be emitted as C typedef declarations BEFORE any hoisted functions
  // that take those types as parameters.
  emit_local_type_defs(body, pctx);
  emit_comptime_const_defs(body, pctx);
  // === Pass 2.7: emit derive(ToString) / derive(Clone) / derive(Eq) / derive(Hash) / derive(Ord) functions ===
  //
  // Scan module_exprs for `derive(TypeName, ..., ToString/Clone/Eq/Hash/Ord, ...)` and emit
  // the corresponding C helper functions for each such type.
  process_derive_tostring(module_exprs, body, pctx);
  process_derive_clone(module_exprs, pctx);
  process_derive_eq(module_exprs, pctx);
  process_derive_hash(module_exprs, pctx);
  process_derive_ord(module_exprs, pctx);
  // === Pass 3: hoist local function definitions from inside the test body ===
  //
  // Yo allows function definitions anywhere in a begin block. C requires all
  // functions at file scope. We recursively scan the test body for any
  // `name :: fn` bindings and emit them as C functions before the test body
  // function so that call sites can resolve without forward declarations.
  //
  // Only hoist functions that are actually called in the test body. Functions
  // that are only defined (but never called from the test body scope) are
  // skipped. This avoids hoisting complex functions with comptime types or
  // unsupported constructs that would fail to compile.
  //
  // Impl methods (from `impl(TypeName, { ... })`) are always hoisted since
  // they are called as `TypeName.method()` and `is_fn_name_called` won't
  // detect them.
  local_fns := ArrayList(FnDef).new();
  collect_local_fn_defs(body, local_fns);
  collect_skipped_fn_names(body, pctx);
  nf := local_fns.len();
  // First pass: register impl method names so call sites get fn_ prefix.
  (jf0 : usize) = usize(0);
  while(jf0 < nf, {
    jf0 = (jf0 + usize(1));
    match(
      local_fns.get(jf0 - usize(1)),
      .None => (),
      .Some(lfd0) => {
        // Only pre-register impl method names (called as TypeName.method()).
        if(lfd0.is_impl, {
          pctx.register_fn_with_params(String.from(lfd0.name.as_str()), build_param_tys_pipe(lfd0.param_tys));
          pctx.register_fn_return_type(lfd0.name.as_str(), lfd0.ret_ty_c.as_str());
        });
      }
    );
  });
  hoisted_names := ArrayList(String).new();
  (jf : usize) = usize(0);
  while(jf < nf, {
    jf = (jf + usize(1));
    match(
      local_fns.get(jf - usize(1)),
      .None => (),
      .Some(lfd) => {
        // Only hoist if:
        // 1. Name has not already been hoisted (avoid duplicate C symbols)
        // 2. Either it is called in the test body (regular fn) OR it's an impl method
        //    (impl methods are called as TypeName.method() which won't match is_fn_name_called)
        already_hoisted := {
          hn := hoisted_names.len();
          (hi : usize) = usize(0);
          (found_dup : bool) = false;
          while((hi < hn) && (!(found_dup)), {
            match(
              hoisted_names.get(hi),
              .None => (),
              .Some(hn_s) => {
                if(hn_s.as_str() == lfd.name.as_str(), {
                  found_dup = true;
                });
              }
            );
            hi = (hi + usize(1));
          });
          found_dup
        };
        cond(
          already_hoisted => (),
          (lfd.is_impl && (!(is_fn_name_called(lfd.name.as_str(), body)))) => {
            // Impl method not directly called — hoist unconditionally since it's
            // invoked as TypeName.method() which is_fn_name_called won't detect.
            c_name2 := `fn_${ lfd.name }`;
            pctx.set_self_type(lfd.impl_type.as_str());
            emit_function_declaration(
              c_name2.as_str(),
              lfd.ret_ty_c.as_str(),
              lfd.params,
              lfd.param_tys,
              pctx
            );
            generate_function(
              c_name2.as_str(),
              lfd.ret_ty_c.as_str(),
              lfd.params,
              lfd.param_tys,
              lfd.body,
              pctx
            );
            pctx.set_self_type("");
            _rh2 := hoisted_names.push(String.from(lfd.name.as_str()));
            ()
          },
          (is_fn_name_called(lfd.name.as_str(), body)) => {
            // Regular local function that is directly called in the test body.
            name_copy2 := String.from(lfd.name.as_str());
            pctx.register_fn_with_params(name_copy2, build_param_tys_pipe(lfd.param_tys));
            pctx.register_fn_return_type(lfd.name.as_str(), lfd.ret_ty_c.as_str());
            c_name2 := `fn_${ lfd.name }`;
            emit_function_declaration(
              c_name2.as_str(),
              lfd.ret_ty_c.as_str(),
              lfd.params,
              lfd.param_tys,
              pctx
            );
            generate_function(
              c_name2.as_str(),
              lfd.ret_ty_c.as_str(),
              lfd.params,
              lfd.param_tys,
              lfd.body,
              pctx
            );
            _rh := hoisted_names.push(String.from(lfd.name.as_str()));
            ()
          },
          true => ()
        );
      }
    );
  });
  // === Emit the test body as a standalone function ===
  params := ArrayList(String).new();
  param_tys := ArrayList(String).new();
  emit_function_declaration("fn_test_body", "void", params, param_tys, pctx);
  generate_function("fn_test_body", "void", params, param_tys, body, pctx);
  emit_main_wrapper("fn_test_body", pctx);
  generate_c_output(pctx)
});
export(compile_test_body_to_c);
