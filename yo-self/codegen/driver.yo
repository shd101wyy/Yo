          (minfix || (margs.len() < usize(2))) => (),
          true => match(
            mf.*,
            .FnCall(_, _, _, _, _) => (),
            .Atom(_, dtok) => cond(
              (dtok.value.as_str() != "derive") => (),
              (!(_has_ord_trait(margs))) => (),
              true => {
                match(
                  margs.get(usize(0)),
                  .None => (),
                  .Some(ty_arg) => match(
                    atom_ident(ty_arg),
                    .None => (),
                    .Some(type_name) => {
                      if(!(ctx.has_derive_ord(type_name)), {
                        found_struct := {
                          (je : usize) = usize(0);
                          (sd_opt : Option(StructDef)) = Option(StructDef).None;
                          while((je < n) && match(sd_opt,.None => true,.Some(_) => false), {
                            match(
                              exprs.get(je),
                              .None => (),
                              .Some(def_expr) => match(
                                extract_struct_def(def_expr),
                                .None => (),
                                .Some(sd) => {
                                  if(sd.name.as_str() == type_name, {
                                    sd_opt = Option(StructDef).Some(sd);
                                  });
                                }
                              )
                            );
                            je = (je + usize(1));
                          });
                          sd_opt
                        };
                        found_enum := {
                          (ke : usize) = usize(0);
                          (ed_opt : Option(EnumDef)) = Option(EnumDef).None;
                          while((ke < n) && match(ed_opt,.None => true,.Some(_) => false), {
                            match(
                              exprs.get(ke),
                              .None => (),
                              .Some(def_expr) => match(
                                extract_enum_def(def_expr),
                                .None => (),
                                .Some(ed) => {
                                  if(ed.name.as_str() == type_name, {
                                    ed_opt = Option(EnumDef).Some(ed);
                                  });
                                }
                              )
                            );
                            ke = (ke + usize(1));
                          });
                          ed_opt
                        };
                        match(
                          found_struct,
                          .Some(sd) => {
                            ctx.register_derive_ord(type_name);
                            emit_struct_ord_fn(sd, ctx);
                          },
                          .None => match(
                            found_enum,
                            .None => (),
                            .Some(ed) => {
                              ctx.register_derive_ord(type_name);
                              if(!(ed.is_complex), {
                                emit_fieldless_enum_ord_fn(type_name, ctx);
                              });
                            }
                          )
                        );
                      });
                    }
                  )
                );
              }
            )
          )
        )
      )
    );
    ie = (ie + usize(1));
  });
});
