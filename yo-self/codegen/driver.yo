//! Compiler driver — connects the parser output to the C code generator.
//!
//! Phase 4j+: given a parsed module body (ArrayList(AstExpr)), extract function
//! definitions and generate a complete, compilable C11 source file.
//!
//! Key entry points:
//!   extract_fn_def(expr) -> Option(FnDef)
//!     Extract a FnDef from a `name :: (fn(params) -> T)(body)` AST node.
//!
//!   compile_module_to_c(exprs, module_id, main_name) -> Option(String)
//!     Walk module body, generate C for every function, assemble the program.
//!
//! Limitations (simplified for Phase 4j+):
//!   - Only simple atomic type names (i32, u8, bool, unit, str, …) are mapped.
//!   - `using(…)` evidence params are emitted as `void*`.
//!   - No type declarations, RC helpers, or async support yet.

open import "std/string";
{ ArrayList } :: import "std/collections/array_list";
{ AstExpr }           :: import "../expr/expr.yo";
{ TokenKind }         :: import "../lexer/token.yo";
{ CodegenContext }    :: import "./context.yo";
{ type_expr_to_c }    :: import "./exprs.yo";
{ generate_function } :: import "./functions.yo";
{ emit_c_preamble, emit_main_wrapper, generate_c_output } :: import "./program.yo";

// ---------------------------------------------------------------------------
// FnDef — extracted function definition record
// ---------------------------------------------------------------------------

/// A function definition extracted from a `name :: (fn(params) -> T)(body)` node.
FnDef :: struct(
  /// Yo-level function name (e.g. "main").
  name     : String,
  /// C return type string (e.g. "void", "int32_t").
  ret_ty_c : String,
  /// Parameter names.
  params   : ArrayList(String),
  /// C type strings for each parameter (parallel to `params`).
  param_tys : ArrayList(String),
  /// Function body expression.
  body     : AstExpr
);

// ---------------------------------------------------------------------------
// Helpers — AST pattern recognisers
// ---------------------------------------------------------------------------

/// Check whether `func_expr` is an infix `->` operator FnCall.
is_arrow_op :: (fn(func_expr : AstExpr) -> bool)(
  match(func_expr,
    .Atom(_)                              => false,
    .FnCall(inner_func, _, is_infix, _) => cond(
      (!(is_infix)) => false,
      true          => match(inner_func.*,
        .Atom(ftok) => (ftok.value.as_str() == "->"),
        .FnCall(_, _, _, _) => false
      )
    )
  )
);

/// Return the identifier string if `expr` is an Identifier Atom, else None.
atom_ident :: (fn(expr : AstExpr) -> Option(str))(
  match(expr,
    .Atom(tok) => cond(
      (tok.kind == TokenKind.Identifier) => .Some(tok.value.as_str()),
      true                               => Option(str).None
    ),
    .FnCall(_, _, _, _) => Option(str).None
  )
);

// ---------------------------------------------------------------------------
// extract_fn_def
// ---------------------------------------------------------------------------

/// Try to extract a `FnDef` from a top-level expression.
///
/// Recognises the pattern:
/// ```
///   FnCall(Atom("::"), [Atom(name), fn_app], is_infix=true)
/// ```
/// where `fn_app` is:
/// ```
///   FnCall(fn_type, [body], is_infix=false)
///   fn_type = FnCall(Atom("->"), [FnCall(Atom("fn"), params), ret_ty], is_infix=true)
/// ```
extract_fn_def :: (fn(expr : AstExpr) -> Option(FnDef))({
  // Step 1: must be an infix `::` FnCall with exactly 2 args.
  match(expr,
    .Atom(_) => Option(FnDef).None,
    .FnCall(top_func, top_args, top_infix, _) => cond(
      (!(top_infix)) => Option(FnDef).None,
      true => match(top_func.*,
        .FnCall(_, _, _, _) => Option(FnDef).None,
        .Atom(ttok) => cond(
          (ttok.value.as_str() != "::") => Option(FnDef).None,
          (top_args.len() != usize(2))  => Option(FnDef).None,
          true => {
            // Step 2: extract the name atom.
            name_expr := match(top_args.get(usize(0)),
              .Some(e) => e,
              .None    => { return Option(FnDef).None; }
            );
            name_str := match(atom_ident(name_expr),
              .Some(n) => n,
              .None    => { return Option(FnDef).None; }
            );

            // Step 3: the RHS must be a fn application: fn_type(body).
            fn_app := match(top_args.get(usize(1)),
              .Some(e) => e,
              .None    => { return Option(FnDef).None; }
            );

            match(fn_app,
              .Atom(_) => Option(FnDef).None,
              .FnCall(app_func, app_args, _, _) => cond(
                // The fn type must be `->` infix.
                (!(is_arrow_op(app_func.*))) => Option(FnDef).None,
                true => match(app_func.*,
                  .Atom(_) => Option(FnDef).None,
                  .FnCall(arrow_func, arrow_args, _, _) => {
                    // arrow_args[0] = FnCall(Atom("fn"), params_list)
                    // arrow_args[1] = return type expression
                    (ignore : str) = match(arrow_func.*,
                      .Atom(_) => "",
                      .FnCall(_, _, _, _) => ""
                    );
                    (ignore);

                    fn_expr := match(arrow_args.get(usize(0)),
                      .Some(e) => e,
                      .None    => { return Option(FnDef).None; }
                    );
                    ret_ty_expr := match(arrow_args.get(usize(1)),
                      .Some(e) => e,
                      .None    => { return Option(FnDef).None; }
                    );

                    // ret_ty_expr → C return type string
                    ret_ty_c := match(type_expr_to_c(ret_ty_expr),
                      .Some(s) => s,
                      .None    => String.from("void*")
                    );

                    // fn_expr must be FnCall(Atom("fn"), params)
                    params_list := match(fn_expr,
                      .Atom(_) => { return Option(FnDef).None; },
                      .FnCall(fn_func, fn_params, _, _) => cond(
                        (!(match(fn_func.*,
                          .Atom(fntok) => (fntok.value.as_str() == "fn"),
                          .FnCall(_, _, _, _) => false
                        ))) => { return Option(FnDef).None; },
                        true => fn_params
                      )
                    );

                    // Extract each param from params_list.
                    //
                    // Supported forms:
                    //   FnCall(Atom(":"), [Atom(name), type_expr], true)  — typed param
                    //   FnCall(Atom("using"), [FnCall(Atom(":"), [...])], false) — evidence param
                    //   Atom(name) — bare param (untyped)
                    out_params    := ArrayList(String).new();
                    out_param_tys := ArrayList(String).new();
                    n_p := params_list.len();
                    (pi : usize) = usize(0);
                    while runtime((pi < n_p)), {
                      pi = (pi + usize(1));
                      match(params_list.get(pi - usize(1)),
                        .None => (),
                        .Some(param_expr) => match(param_expr,
                          // bare Atom identifier → untyped param (void*)
                          .Atom(ptok) => cond(
                            (ptok.kind == TokenKind.Identifier) => {
                              out_params.push(String.from(ptok.value.as_str()));
                              out_param_tys.push(String.from("void*"));
                            },
                            true => ()
                          ),
                          .FnCall(pf, pargs, pinfix, _) => match(pf.*,
                            .FnCall(_, _, _, _) => (),
                            .Atom(pftok) => cond(
                              // typed param:  FnCall(Atom(":"), [name, type], true)
                              ((pftok.value.as_str() == ":") && pinfix) => {
                                p_name := match(pargs.get(usize(0)),
                                  .Some(ne) => match(atom_ident(ne),
                                    .Some(n) => n,
                                    .None    => ""
                                  ),
                                  .None => ""
                                );
                                p_ty_c := match(pargs.get(usize(1)),
                                  .Some(te) => match(type_expr_to_c(te),
                                    .Some(s) => s,
                                    .None    => String.from("void*")
                                  ),
                                  .None => String.from("void*")
                                );
                                if((p_name != ""), {
                                  out_params.push(String.from(p_name));
                                  out_param_tys.push(p_ty_c);
                                });
                              },
                              // using(…) evidence param — emit as void* ev_<name>
                              (pftok.value.as_str() == "using") => match(pargs.get(usize(0)),
                                // If no inner arg — skip this param
                                .None => (),
                                .Some(using_inner) => {
                                ev_name := match(using_inner,
                                  // using(name) — bare evidence reference
                                  .Atom(utok) => utok.value.as_str(),
                                  // using(name : Type) — typed evidence
                                  .FnCall(uf, uargs, _, _) => match(uf.*,
                                    .Atom(uftok) => cond(
                                      (uftok.value.as_str() == ":") => match(uargs.get(usize(0)),
                                        .Some(une) => match(atom_ident(une),
                                          .Some(n) => n,
                                          .None    => "ev"
                                        ),
                                        .None => "ev"
                                      ),
                                      true => "ev"
                                    ),
                                    .FnCall(_, _, _, _) => "ev"
                                  )
                                );
                                ev_param_name := `ev_${ String.from(ev_name) }`;
                                out_params.push(ev_param_name);
                                out_param_tys.push(String.from("void*"));
                                }
                              ),
                              // forall / other — skip
                              true => ()
                            )
                          )
                        )
                      );
                    };

                    // body is the first element of app_args.
                    body := match(app_args.get(usize(0)),
                      .Some(e) => e,
                      .None    => { return Option(FnDef).None; }
                    );

                    .Some(FnDef(
                      name:      String.from(name_str),
                      ret_ty_c:  ret_ty_c,
                      params:    out_params,
                      param_tys: out_param_tys,
                      body:      body
                    ))
                  }
                )
              )
            )
          }
        )
      )
    )
  )
});

// ---------------------------------------------------------------------------
// compile_module_to_c
// ---------------------------------------------------------------------------

/// Walk a parsed module body and generate a complete C11 source file.
///
/// * Every `name :: (fn(…) -> T)(body)` top-level expression is compiled as a
///   static C function.
/// * A `int main(void)` wrapper that calls the function named `main_name` is
///   appended.
/// * Returns `None` if no functions were found or the main function is absent.
compile_module_to_c :: (fn(
  exprs     : ArrayList(AstExpr),
  module_id : str,
  main_name : str
) -> Option(String))({
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;

  emit_c_preamble(module_id, pctx);

  n := exprs.len();
  (i : usize) = usize(0);
  (main_found : bool) = false;
  (main_c_name : String) = String.new();

  while runtime((i < n)), {
    i = (i + usize(1));
    match(exprs.get(i - usize(1)),
      .None => (),
      .Some(expr) => match(extract_fn_def(expr),
        .None => (),
        .Some(fd) => {
          // Build C function name: fn_<yo_name> (simple convention)
          c_name := `fn_${ fd.name }`;
          if((fd.name.as_str() == main_name), {
            main_found = true;
            main_c_name = c_name;
          });
          generate_function(
            c_name.as_str(),
            fd.ret_ty_c.as_str(),
            fd.params,
            fd.param_tys,
            fd.body,
            pctx
          );
        }
      )
    );
  };

  cond(
    (!(main_found)) => Option(String).None,
    true => {
      emit_main_wrapper(main_c_name.as_str(), pctx);
      .Some(generate_c_output(pctx))
    }
  )
});

export FnDef, extract_fn_def, compile_module_to_c;

// ---------------------------------------------------------------------------
// Test body compilation
// ---------------------------------------------------------------------------

/// Generate a complete C11 test program from a bare test body expression.
///
/// The body is wrapped in a `static void fn_test_body(void)` function.
/// An `int main(void)` wrapper calls `fn_test_body()`.
///
/// `assert(cond, msg)` in the body emits `if (!(cond)) { exit(1); }` via
/// the `handle_assert` hook in `generate_expr`.
///
/// Returns the full C source string.
compile_test_body_to_c :: (fn(body : AstExpr, module_id : str) -> String)({
  ctx := CodegenContext.new();
  (pctx : *(CodegenContext)) = &ctx;

  emit_c_preamble(module_id, pctx);

  params    := ArrayList(String).new();
  param_tys := ArrayList(String).new();
  generate_function("fn_test_body", "void", params, param_tys, body, pctx);

  emit_main_wrapper("fn_test_body", pctx);
  generate_c_output(pctx)
});

export compile_test_body_to_c;
