  /// Register a Yo-level struct name as declared in this module.
  /// Struct constructor calls `Name(args)` are then emitted as `(Name){args}`.
  /// `fields_csv` is a comma-separated list of field names (may be empty).
  register_struct : (fn(ref(self) : Self, name : String) -> unit)({
    self.defined_structs.push(name);
    self.struct_field_csvs.push(String.new());
    self.struct_default_value_csvs.push(String.new());
    self.struct_field_type_csvs.push(String.new());
  }),
  /// Register a struct name with its field names (CSV).
  register_struct_fields : (fn(ref(self) : Self, name : str, fields_csv : str) -> unit)({
    n := self.defined_structs.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.defined_structs.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            self.struct_field_csvs(i) = String.from(fields_csv);
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
  }),
  /// Return the CSV of field names for a registered struct, or `None` if not found or empty.
  get_struct_fields : (fn(ref(self) : Self, name : str) -> Option(String))({
    n := self.defined_structs.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while((i < n) && match(result,.None => true,.Some(_) => false), {
      match(
        self.defined_structs.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            result = match(
              self.struct_field_csvs.get(i),
              .None => Option(String).None,
              .Some(fcsv) => cond(
                (fcsv.len() == usize(0)) => Option(String).None,
                true => Option(String).Some(String.from(fcsv.as_str()))
              )
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  register_generic_struct_template : (fn(ref(self) : Self, name : str, fields_csv : str) -> unit)({
    n := self.generic_struct_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.generic_struct_names.get(i),
        .None => (),
        .Some(existing) => {
          if(existing == name, {
            self.generic_struct_field_csvs(i) = String.from(fields_csv);
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    if(!(found), {
      self.generic_struct_names.push(String.from(name));
      self.generic_struct_field_csvs.push(String.from(fields_csv));
    });
  }),
  get_generic_struct_template_fields : (fn(ref(self) : Self, name : str) -> Option(String))({
    n := self.generic_struct_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while((i < n) && match(result,.None => true,.Some(_) => false), {
      match(
        self.generic_struct_names.get(i),
        .None => (),
        .Some(existing) => {
          if(existing == name, {
            result = match(
              self.generic_struct_field_csvs.get(i),
              .None => Option(String).None,
              .Some(fields) => cond(
                (fields.len() == usize(0)) => Option(String).None,
                true => Option(String).Some(String.from(fields.as_str()))
              )
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  register_struct_defaults : (fn(ref(self) : Self, name : str, defaults_csv : str) -> unit)({
    n := self.defined_structs.len();
    (i : usize) = usize(0);
    while(i < n, {
      match(
        self.defined_structs.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            self.struct_default_value_csvs(i) = String.from(defaults_csv);
          });
        }
      );
      i = (i + usize(1));
    });
  }),
  get_struct_defaults : (fn(ref(self) : Self, name : str) -> Option(String))({
    n := self.defined_structs.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while(i < n, {
      match(
        self.defined_structs.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            result = match(
              self.struct_default_value_csvs.get(i),
              .None => Option(String).None,
              .Some(dcsv) => cond(
                (dcsv.len() == usize(0)) => Option(String).None,
                true => Option(String).Some(String.from(dcsv.as_str()))
              )
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// Register field names (CSV) for a local variable created from an anon struct.
  /// Used to support `open var` when `var := { field1: val1, field2: val2 }`.
  track_open_var : (fn(ref(self) : Self, var_name : str, fields_csv : str) -> unit)({
    self.open_var_names.push(String.from(var_name));
    self.open_var_field_csvs.push(String.from(fields_csv));
  }),
  /// Return the field CSV for a variable tracked via `track_open_var`.
  /// Returns `None` if not found.
  get_open_var_fields : (fn(ref(self) : Self, var_name : str) -> Option(String))({
    n := self.open_var_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while((i < n) && match(result,.None => true,.Some(_) => false), {
      match(
        self.open_var_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == var_name, {
            result = match(
              self.open_var_field_csvs.get(i),
              .None => Option(String).None,
              .Some(fcsv) => cond(
                (fcsv.len() == usize(0)) => Option(String).None,
                true => Option(String).Some(String.from(fcsv.as_str()))
              )
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// True if `name` was registered via `register_struct`.
  is_struct_name : (fn(ref(self) : Self, name : str) -> bool)({
    n := self.defined_structs.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.defined_structs.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register a (variant_name, enum_name, fields_csv) entry.
  /// `fields_csv` is a comma-separated list of field names for complex variants
  /// (e.g. "r" for Circle(r: i32), "w,h" for Rectangle(w: i32, h: i32)).
  /// Pass "" for simple (no-data) variants.
  ///
  /// If a variant with the same name AND the same enum_name is already registered,
  /// its `fields_csv` is updated in-place (so the most-recently-seen definition
  /// wins for field names).  Variants from different enums are stored as separate
  /// entries even when they share a name (e.g. `MyResult.Err` and
  /// `HalfComptResult.Err` are kept distinct).
  register_variant : (fn(ref(self) : Self, variant : str, enum_name : str, fields_csv : str) -> unit)({
    n := self.variant_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.variant_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == variant, {
            // Only treat as a match when both the variant name AND the owning enum
            // match — different enums may legitimately share variant names.
            enum_matches := match(
              self.variant_enums.get(i),
              .Some(e) => (e == enum_name),
              .None => false
            );
            if(enum_matches, {
              self.variant_fields_csv(i) = String.from(fields_csv);
              found = true;
            });
          });
        }
      );
      i = (i + usize(1));
    });
    if(!(found), {
      self.variant_names.push(String.from(variant));
      self.variant_enums.push(String.from(enum_name));
      self.variant_fields_csv.push(String.from(fields_csv));
    });
  }),
  /// Register the C type of a local variable or function parameter.
  register_var_type : (fn(ref(self) : Self, var_name : str, c_type : str) -> unit)({
    self.var_names.push(String.from(var_name));
    self.var_types.push(String.from(c_type));
  }),
  /// Return the registered C type of `var_name`, or `None` if not tracked.
  get_var_type : (fn(ref(self) : Self, var_name : str) -> Option(String))({
    n := self.var_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while(i < n, {
      match(
        self.var_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == var_name, {
            result = match(
              self.var_types.get(i),
              .Some(t) => Option(String).Some(t),
              .None => Option(String).None
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// True if enum `name` has at least one complex (data-carrying) variant registered.
  /// Used to decide whether `i32(var)` for a variable of that enum type should be
  /// emitted as `(int32_t)(var.tag)` rather than a plain cast.
  is_complex_enum_name : (fn(ref(self) : Self, name : str) -> bool)({
    n := self.variant_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.variant_enums.get(i),
        .None => (),
        .Some(e) => {
          if(e == name, {
            match(
              self.variant_fields_csv.get(i),
              .None => (),
              .Some(fcsv) => {
                if(fcsv.len() > usize(0), {
                  found = true;
                });
              }
            );
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Return the enum name for `variant`, or `None` if not registered.
  get_enum_for_variant : (fn(ref(self) : Self, variant : str) -> Option(String))({
    n := self.variant_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while((i < n) && match(result,.None => true,.Some(_) => false), {
      match(
        self.variant_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == variant, {
            result = match(
              self.variant_enums.get(i),
              .Some(e) => Option(String).Some(e),
              .None => Option(String).None
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// Return the CSV of field names for `variant` of the given `enum_name` if it is
  /// a complex (data-carrying) variant, or `None` if the variant is simple (no
  /// fields) or not registered.  Using the enum name avoids returning fields from
  /// a same-named variant of a different enum (e.g. `MyResult.Err` vs
  /// `HalfComptResult.Err`).
  get_variant_fields : (fn(ref(self) : Self, enum_name : str, variant : str) -> Option(String))({
    n := self.variant_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while((i < n) && match(result,.None => true,.Some(_) => false), {
      match(
        self.variant_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == variant, {
            enum_matches := match(
              self.variant_enums.get(i),
              .Some(e) => (e == enum_name),
              .None => false
            );
            if(enum_matches, {
              match(
                self.variant_fields_csv.get(i),
                .None => (),
                .Some(fcsv) => {
                  if(fcsv.len() > usize(0), {
                    result = Option(String).Some(String.from(fcsv.as_str()));
                  });
                }
              );
            });
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// Set the current `Self` type for impl method codegen.
  /// Call before generating an impl method body, and clear with "" afterward.
  set_self_type : (fn(ref(self) : Self, type_name : str) -> unit)({
    self.self_type = String.from(type_name);
  }),
  /// Get the current `Self` type name, or "" if not inside an impl method.
  get_self_type : (fn(ref(self) : Self) -> str)(
    self.self_type.as_str()
  ),
  /// True if `var_name` is a registered variable whose C type ends with `*`
  /// (i.e., it is a pointer). Used to emit `->` instead of `.` for field access.
  var_type_is_ptr : (fn(ref(self) : Self, var_name : str) -> bool)(
    match(
      self.get_var_type(var_name),
      .None => false,
      .Some(ty) => {
        n := ty.len();
        cond(
          (n == usize(0)) => false,
          true => match(
            ty.at(n - usize(1)),
            .None => false,
            .Some(r) => (r.char == u32(42))
          )
        )
      }
    )
  ),
  /// Register a fixed-size array type alias `NAME :: [T; N]`.
  /// `elem_c` is the C element type (e.g. `"int32_t"`), `size` is the array length.
  register_array_alias : (fn(ref(self) : Self, name : str, elem_c : str, size : usize) -> unit)({
    self.array_alias_names.push(String.from(name));
    self.array_alias_elems.push(String.from(elem_c));
    self.array_alias_sizes.push(size);
  }),
  /// Return the C element type for array alias `name`, or `None` if not registered.
  get_array_alias_elem : (fn(ref(self) : Self, name : str) -> Option(String))({
    n := self.array_alias_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while((i < n) && match(result,.None => true,.Some(_) => false), {
      match(
        self.array_alias_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            result = match(
              self.array_alias_elems.get(i),
              .Some(e) => Option(String).Some(e),
              .None => Option(String).None
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// Return the array size for array alias `name`, or `None` if not registered.
  get_array_alias_size : (fn(ref(self) : Self, name : str) -> Option(usize))({
    n := self.array_alias_names.len();
    (i : usize) = usize(0);
    (result : Option(usize)) = Option(usize).None;
    while((i < n) && match(result,.None => true,.Some(_) => false), {
      match(
        self.array_alias_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            result = match(
              self.array_alias_sizes.get(i),
              .Some(sz) => Option(usize).Some(sz),
              .None => Option(usize).None
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// Register the C field types CSV for struct `name`.
  /// e.g. `"const char*,int32_t"` for `struct(name: String, age: i32)`.
  /// Parallel to `register_struct_fields`.
  register_struct_field_types : (fn(ref(self) : Self, name : str, types_csv : str) -> unit)({
    n := self.defined_structs.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.defined_structs.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            self.struct_field_type_csvs(i) = String.from(types_csv);
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
  }),
  /// Return the CSV of C field types for struct `name`, or `None` if not found.
  get_struct_field_types : (fn(ref(self) : Self, name : str) -> Option(String))({
    n := self.defined_structs.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while((i < n) && match(result,.None => true,.Some(_) => false), {
      match(
        self.defined_structs.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            result = match(
              self.struct_field_type_csvs.get(i),
              .None => Option(String).None,
              .Some(tcsv) => cond(
                (tcsv.len() == usize(0)) => Option(String).None,
                true => Option(String).Some(String.from(tcsv.as_str()))
              )
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// Register `type_name` as having `derive(ToString)`.
  register_derive_tostring : (fn(ref(self) : Self, type_name : str) -> unit)({
    self.derive_tostring_names.push(String.from(type_name));
  }),
  /// True if `type_name` was registered via `register_derive_tostring`.
  has_derive_tostring : (fn(ref(self) : Self, type_name : str) -> bool)({
    n := self.derive_tostring_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.derive_tostring_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == type_name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register `type_name` as having `derive(Clone)`.
  register_derive_clone : (fn(ref(self) : Self, type_name : str) -> unit)({
    self.derive_clone_names.push(String.from(type_name));
  }),
  /// True if `type_name` was registered via `register_derive_clone`.
  has_derive_clone : (fn(ref(self) : Self, type_name : str) -> bool)({
    n := self.derive_clone_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.derive_clone_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == type_name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register `type_name` as having `derive(Eq(...))`.
  register_derive_eq : (fn(ref(self) : Self, type_name : str) -> unit)({
    self.derive_eq_names.push(String.from(type_name));
  }),
  /// True if `type_name` was registered via `register_derive_eq`.
  has_derive_eq : (fn(ref(self) : Self, type_name : str) -> bool)({
    n := self.derive_eq_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.derive_eq_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == type_name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register `type_name` as having `derive(Hash)`.
  register_derive_hash : (fn(ref(self) : Self, type_name : str) -> unit)({
    self.derive_hash_names.push(String.from(type_name));
  }),
  /// True if `type_name` was registered via `register_derive_hash`.
  has_derive_hash : (fn(ref(self) : Self, type_name : str) -> bool)({
    n := self.derive_hash_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.derive_hash_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == type_name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register `type_name` as having `derive(Ord(...))`.
  register_derive_ord : (fn(ref(self) : Self, type_name : str) -> unit)({
    self.derive_ord_names.push(String.from(type_name));
  }),
  /// True if `type_name` was registered via `register_derive_ord`.
  has_derive_ord : (fn(ref(self) : Self, type_name : str) -> bool)({
    n := self.derive_ord_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.derive_ord_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == type_name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register `name` as a comptime-only function whose call sites should emit `0`.
  register_skipped_fn : (fn(ref(self) : Self, name : str) -> unit)({
    self.skipped_fn_names.push(String.from(name));
  }),
  /// True if `name` was registered as a comptime-only skipped function.
  is_skipped_fn : (fn(ref(self) : Self, name : str) -> bool)({
    n := self.skipped_fn_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.skipped_fn_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  register_closure_alias : (fn(ref(self) : Self, alias_name : str, param_name : str) -> unit)({
    self.closure_alias_names.push(String.from(alias_name));
    self.closure_alias_param_names.push(String.from(param_name));
  }),
  get_closure_alias_param_name : (fn(ref(self) : Self, alias_name : str) -> Option(String))({
    n := self.closure_alias_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while((i < n) && match(result,.None => true,.Some(_) => false), {
      match(
        self.closure_alias_names.get(i),
        .None => (),
        .Some(name) => if(name == alias_name, {
          result = self.closure_alias_param_names.get(i);
        })
      );
      i = (i + usize(1));
    });
    result
  }),
  register_simple_closure_var : (fn(ref(self) : Self, var_name : str, capture_name : str, param_name : str) -> unit)({
    self.closure_var_names.push(String.from(var_name));
    self.closure_capture_names.push(String.from(capture_name));
    self.closure_param_names.push(String.from(param_name));
  }),
  get_simple_closure_capture_name : (fn(ref(self) : Self, var_name : str) -> Option(String))({
    n := self.closure_var_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while((i < n) && match(result,.None => true,.Some(_) => false), {
      match(
        self.closure_var_names.get(i),
        .None => (),
        .Some(name) => if(name == var_name, {
          result = self.closure_capture_names.get(i);
        })
      );
      i = (i + usize(1));
    });
    result
  }),
  get_simple_closure_param_name : (fn(ref(self) : Self, var_name : str) -> Option(String))({
    n := self.closure_var_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while((i < n) && match(result,.None => true,.Some(_) => false), {
      match(
        self.closure_var_names.get(i),
        .None => (),
        .Some(name) => if(name == var_name, {
          result = self.closure_param_names.get(i);
        })
      );
      i = (i + usize(1));
    });
    result
  }),
  register_anon_method : (fn(ref(self) : Self, var_name : str, method_name : str, body_template : str) -> unit)({
    self.anon_method_var_names.push(String.from(var_name));
    self.anon_method_names.push(String.from(method_name));
    self.anon_method_body_templates.push(String.from(body_template));
  }),
  get_anon_method_body_template : (fn(ref(self) : Self, var_name : str, method_name : str) -> Option(String))({
    n := self.anon_method_var_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while((i < n) && match(result,.None => true,.Some(_) => false), {
      var_matches := match(
        self.anon_method_var_names.get(i),
        .None => false,
        .Some(name) => (name == var_name)
      );
      method_matches := match(
        self.anon_method_names.get(i),
        .None => false,
        .Some(name2) => (name2 == method_name)
      );
      if(var_matches && method_matches, {
        result = self.anon_method_body_templates.get(i);
      });
      i = (i + usize(1));
    });
    result
  })
);
export(
  CodegenTypeEntry,
  CodegenClosureCaptureEntry,
  CodegenIsoTypeEntry,
  CodegenDynImplEntry,
  CodegenFunctionEntry,
  CodegenSliceStructEntry,
  CodegenArrayStructEntry,
  CodegenExternFunctionEntry,
  CodegenImplClosureEntry,
  CodegenContext
);
