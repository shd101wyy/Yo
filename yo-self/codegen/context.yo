//! Code-generation context for the self-hosted Yo C code generator.
//!
//! Holds the `Emitter` and the mutable state that expression/statement
//! generators need to share.
//!
//! **Structural mapping vs src/**: `CodegenContext` is the rough analog of
//! `FunctionGenerationContext` in `src/codegen/functions/context.ts` (which
//! itself extends `CodeGenContext` in `src/codegen/utils/index.ts`). The TS
//! interface is data-only — operations on the context are scattered
//! standalone functions across many src/ files. yo-self's idiom is to
//! bundle struct methods inside an `impl(...)` block, which is why this
//! file consolidates both the data definition and the ~60 helper methods
//! (`register_fn`, `register_array_var`, `is_box_var`, …).
//!
//! Most of those helper methods are **bootstrap-specific heuristics** with
//! no src/ counterpart at all — they exist because the bootstrap codegen
//! has not yet adopted the typed-AST pipeline, so it must track things
//! like "this variable was declared as a C array" or "this name was
//! emitted as a `__auto_type` constant" out of band. Once the typed AST
//! pivot lands those heuristics go away.
//!
//! Accordingly, `codegen/context.yo` is an **acceptable divergence**: the
//! 1-to-1 with src/ would require either (a) breaking the Yo idiom and
//! scattering the methods, or (b) waiting for the bootstrap codegen to
//! migrate to typed AST. Neither is in scope today.
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TypeValue } :: import("../types/definitions.yo");
{ ExprId } :: import("../expr.yo");
{ ExprInfo, ExprInfoTable, expr_info_table_get } :: import("../expr_info.yo");
{ EvalValue } :: import("../value.yo");
{ Emitter } :: import("../emitter.yo");
CodegenTypeEntry :: object(
  type_value : TypeValue,
  c_name : String
);
CodegenClosureCaptureEntry :: object(
  closure_type : TypeValue,
  closure_c_name : String,
  capture_type : TypeValue,
  capture_c_name : String
);
CodegenIsoTypeEntry :: object(
  child_type_c_name : String,
  iso_type : TypeValue,
  option_type_c_name : Option(String),
  struct_generated : bool,
  create_generated : bool,
  extract_generated : bool,
  dispose_generated : bool
);
/// Codegen state for a registered `dyn(Trait)` impl. Mirrors the
/// per-entry shape of `CodeGenContext.dynImpls` in
/// `src/codegen/exprs/dyn.ts`: dynType is the wrapper `Dyn(Trait)`
/// type, concreteType is the underlying concrete (e.g. `Dog`),
/// dataType is what the runtime `.data` slot points at (the
/// concrete type itself for object types, or a `Box(...)` for
/// boxed value types). traitValues holds the evaluator's resolved
/// trait-impl values that the vtable generator needs.
CodegenDynImplEntry :: object(
  dyn_type : TypeValue,
  concrete_type : TypeValue,
  data_type : TypeValue,
  trait_values : ArrayList(EvalValue)
);
/// Codegen state for a registered function. Mirrors the per-entry
/// shape of `CodeGenContext.functions` in `src/codegen/utils/index.ts`:
///   { value: FunctionValue, cName: string,
///     effectStateMachineInfo?: unknown }
///
/// `value` is the evaluator's `FuncVal` for the function. `c_name`
/// is the canonical mangled C identifier used everywhere the
/// function is referenced (call sites, function-pointer values,
/// `comptime_value` lowering for function values, `__yo_thread_spawn`
/// closure wrappers, etc.).
///
/// `effect_state_machine_info` is the slot TS uses for the effect-
/// handler state-machine info object. yo-self's effect runtime is
/// not yet ported, so the slot is left abstract as `Option(EvalValue)`
/// — concrete shape will land when the effect runtime does.
CodegenFunctionEntry :: object(
  value : EvalValue,
  c_name : String,
  effect_state_machine_info : Option(EvalValue)
);
/// Codegen state for a generated `Slice_<elem>` struct type. Mirrors
/// the per-entry shape of `CodeGenContext.sliceStructTypes` in
/// `src/codegen/utils/index.ts`: `{ childType: string }`.
///
/// `child_type` is the C type string of the slice element (e.g.
/// `"int32_t"` for `Slice_i32`). The slice-type generator emits a
/// `typedef struct { childType* data; size_t length; } sliceTypeName;`
/// for every entry in this map.
CodegenSliceStructEntry :: object(child_type : String);
/// Codegen state for a generated `Array_<elem>_<len>` struct type.
/// Mirrors the per-entry shape of `CodeGenContext.arrayStructTypes`
/// in `src/codegen/utils/index.ts`:
///   `{ childType: string, length: number }`.
CodegenArrayStructEntry :: object(child_type : String, length : usize);
/// Codegen state for an extern C function. Mirrors the per-entry
/// shape of `CodeGenContext.externFunctions` in
/// `src/codegen/utils/index.ts`:
///   `{ type: FunctionType, cName: string, cInclude?: string }`.
///
/// Keyed by the FunctionType's type id. Populated when codegen
/// encounters a function declared as `extern "C"` or a `c_include`
/// directive — the registry lets the emitter dedupe extern decls
/// and emit `#include` lines in the headers section.
///
/// The `is_extern` field is a yo-self-specific extension that
/// matches the pre-existing `ExternFunctionEntry` in
/// `codegen/functions/context.yo`. TS encodes the same information
/// on `FunctionType.isExtern` ("yo" | "c" | undefined); yo-self
/// stores it on the entry directly so the declaration emitter can
/// branch on it without re-traversing the function type. Empty
/// string means "not extern".
CodegenExternFunctionEntry :: object(
  function_type : TypeValue,
  c_name : String,
  c_include : Option(String),
  is_extern : String
);
/// Codegen state for an `Impl(Fn(...))` static-dispatch closure entry.
/// Mirrors the per-entry shape of `CodeGenContext.implClosureCallMap`
/// in `src/codegen/utils/index.ts`:
///
///   { functionCName: string,
///     callTypeId: TypeId,
///     callType?: FunctionType,
///     consumedCaptures?: string[] }
///
/// For static-dispatch closures, the runtime value is the
/// resolved-concrete capture struct. Direct calls dispatch to the
/// generated closure implementation function for that concrete type,
/// without a vtable lookup. Used by parallelism handlers
/// (`__yo_thread_spawn` / `__yo_worker_spawn`) and async closure
/// codegen.
///
/// `call_type` is `.None` when the entry was registered without the
/// Fn-call type information (rare); `consumed_captures` is `.None`
/// when no captured field is consumed inside the closure body via
/// `own(self)`.
CodegenImplClosureEntry :: object(
  function_c_name : String,
  call_type_id : String,
  call_type : Option(TypeValue),
  consumed_captures : Option(ArrayList(String))
);
/// Shared mutable context passed to every `generate_*` function.
///
/// Phase 4b/4c fields:
///   `emitter`      — the three-section C output accumulator
///   `temp_count`   — counter used to generate unique temp variable names
/// Phase 5c fields:
///   `defined_fns`  — Yo names of user-defined functions in the current module.
///                    Call sites check this to decide whether to add `fn_` prefix.
/// Phase 5e fields:
///   `defined_enums` — Yo names of enum types declared in this module.
///                     Dot-access `EnumName.Variant` is rewritten to `EnumName_Variant`.
/// Phase 5f fields:
///   `defined_structs` — Yo names of struct types declared in this module.
///                       `StructName(args)` constructor calls are emitted as
///                       C compound literals `(StructName){arg1, arg2, …}`.
/// Phase 5h fields:
///   `variant_names` / `variant_enums` — parallel lists mapping each registered
///                    enum variant name to its owning enum name.  Used to resolve
///                    bare `.Variant` patterns in match arms.
///   `variant_fields_csv` — parallel to `variant_names`; comma-separated field
///                    names for complex variants (e.g. "r" for Circle(r: i32),
///                    "w,h" for Rectangle(w: i32, h: i32)).  Empty string `""`
///                    for simple (no-data) variants.
/// Phase 5i fields:
///   `var_names` / `var_types` — parallel lists tracking C type of local variables
///                    and function parameters. Used to detect complex-enum variables
///                    in type-cast expressions so `i32(shape)` → `(int32_t)(shape.tag)`.
CodegenContext :: object(
  // Collected types that need declarations/constructor functions.
  // Mirrors `CodeGenContext.types` in `src/codegen/utils/index.ts`.
  types : HashMap(String, CodegenTypeEntry),
  // Closure-to-capture type mapping for capture-specific dispose declarations.
  // Mirrors `CodeGenContext.closureCaptureMap`.
  closure_capture_map : HashMap(String, CodegenClosureCaptureEntry),
  // Iso type registry keyed by Iso type C name.
  // Mirrors `CodeGenContext.isoTypes`.
  iso_types : HashMap(String, CodegenIsoTypeEntry),
  emitter : Emitter,
  temp_count : usize,
  defined_fns : ArrayList(String),
  defined_enums : ArrayList(String),
  defined_structs : ArrayList(String),
  struct_field_csvs : ArrayList(String),
  struct_default_value_csvs : ArrayList(String),
  variant_names : ArrayList(String),
  variant_enums : ArrayList(String),
  variant_fields_csv : ArrayList(String),
  var_names : ArrayList(String),
  var_types : ArrayList(String),
  // Separate arrays for tracking local variables that were created from
  // anonymous struct assignments, for use by `open` statements.
  open_var_names : ArrayList(String),
  open_var_field_csvs : ArrayList(String),
  // Current implementing type name for resolving `Self` in impl method bodies.
  // Empty string means we are not currently inside an impl method body.
  self_type : String,
  // Array type aliases: `NAME :: [T; N]` → elem C type + size.
  array_alias_names : ArrayList(String),
  array_alias_elems : ArrayList(String),
  array_alias_sizes : ArrayList(usize),
  // Current function name (C-level) used to emit `recur(args)` as `fn_name(args)`.
  // Empty string when outside any function body.
  current_fn_name : String,
  // Current function's C return type. Used to coerce anonymous struct literals
  // `{ field }` → `(ReturnType){ .field = field }` when the return type is a
  // known named struct. Empty string when outside any function body.
  current_fn_return_type : String,
  // Lambda lifting: counter for unique lambda names, and a buffer for emitting
  // lifted lambdas before the current function.
  lambda_count : usize,
  pre_fn_code : String,
  // Parallel to `defined_fns`: pipe-separated C param type strings for each function.
  // Used for lambda lifting to infer callback param types.
  fn_param_ty_lists : ArrayList(String),
  // Function return type registry, keyed by Yo-level function name.
  fn_return_names : ArrayList(String),
  fn_return_tys : ArrayList(String),
  // C array variables: variable names that are declared as C arrays (e.g. `int32_t arr[3]`).
  // Indexing syntax `arr(idx)` → `arr[idx]` for these variables.
  array_var_names : ArrayList(String),
  // Parallel to `array_var_names`: the size (as string) of each C array variable.
  // Used to emit the constant for `arr.len()`.
  array_var_sizes : ArrayList(String),
  // C slice variables: variable names that are declared as C slices ({data, length} structs).
  // Indexing syntax `slice(idx)` → `slice.data[idx]` for these variables.
  slice_var_names : ArrayList(String),
  // Emitted `::` constant bindings: names that have been emitted as C `__auto_type` variables.
  // Used to check if a `::` binding's dependencies are all available.
  emitted_const_names : ArrayList(String),
  // `::` constant bindings whose RHS was a string literal — used to reject string `+` in C.
  string_const_names : ArrayList(String),
  // Parallel to `defined_structs`: CSV of C type strings for each field.
  // e.g. "const char*,int32_t" for struct(name: String, age: i32).
  // Populated by `register_struct_field_types` alongside `register_struct_fields`.
  struct_field_type_csvs : ArrayList(String),
  // Bootstrap generic struct templates: `Name :: fn(comptime(T)) struct(x: T, ...)`.
  // We instantiate these lazily as concrete C structs such as `Name_i32`.
  generic_struct_names : ArrayList(String),
  generic_struct_field_csvs : ArrayList(String),
  // Types that have `derive(ToString)` registered.
  // When calling `to_string()` on a pointer to one of these types, dispatch to
  // the pre-generated `fn_TypeName_to_string` C function.
  derive_tostring_names : ArrayList(String),
  // Types that have `derive(Clone)` registered.
  // When calling `.clone()` on a pointer to one of these types, dispatch to
  // the pre-generated `fn_TypeName_clone` C function.
  derive_clone_names : ArrayList(String),
  // Types that have `derive(Eq(...))` registered.
  // When comparing two values of one of these types with `==` or `!=`, dispatch
  // to the pre-generated `fn_TypeName_eq` C function.
  derive_eq_names : ArrayList(String),
  // Types that have `derive(Hash)` registered.
  // When calling `.hash()` on a pointer to one of these types, dispatch to
  // the pre-generated `fn_TypeName_hash` C function.
  derive_hash_names : ArrayList(String),
  // Types that have `derive(Ord(...))` registered.
  // When comparing two values with `<`, `<=`, `>`, `>=`, dispatch to
  // `fn_TypeName_cmp` C function.
  derive_ord_names : ArrayList(String),
  // Function names that were skipped during codegen because their return type
  // is a comptime-only meta-type (Trait, Type, DeriveContext, …).
  // Call sites to these names emit `0` instead of a real C call.
  skipped_fn_names : ArrayList(String),
  // Variables that were created with `box(...)`: emitting `x == y` for these
  // should be `(*x == *y)` since box returns a pointer to the heap-allocated value.
  box_var_names : ArrayList(String),
  // Bootstrap closure aliases: `ClosureType :: Impl(Fn(y : i32) -> i32)`.
  closure_alias_names : ArrayList(String),
  closure_alias_param_names : ArrayList(String),
  // Bootstrap closure values with one captured mutable field.
  closure_var_names : ArrayList(String),
  closure_capture_names : ArrayList(String),
  closure_param_names : ArrayList(String),
  // Bootstrap local anonymous-struct methods from `impl(typeof(var), method : fn...)`.
  anon_method_var_names : ArrayList(String),
  anon_method_names : ArrayList(String),
  anon_method_body_templates : ArrayList(String),
  /// Typed AST metadata table populated by the evaluator. When `.Some`, the
  /// codegen handlers may consult it (via `get_expr_info`) for type and
  /// compile-time-value information attached to expression nodes — mirroring
  /// the TypeScript `expr.$` annotation. When `.None`, no evaluator pass has
  /// run for this compilation unit and handlers must fall back to the
  /// AST-only bootstrap heuristics.
  ///
  /// Wiring this end-to-end is the goal of the typed-AST pivot
  /// (Phase 13at). Today the field is always `.None`; ported metadata-aware
  /// handlers should check `is_some()` and degrade gracefully.
  expr_info_table : Option(ExprInfoTable),
  /// Deduplication map for `typeid(T)` static declarations.
  /// Maps the unique string id of a type to the C name of the emitted
  /// `static const char __yo_typeid_<sanitized>_NN = 0;` declaration.
  /// Mirrors `CodeGenContext.typeIdStatics` in `src/codegen/utils/index.ts`.
  type_id_statics : HashMap(String, String),
  /// Registered `dyn(Trait)` impls, keyed by the impl-key
  /// `${concrete_type_c_name}_${dyn_type_c_name}`. The vtable
  /// generator consumes this map after all dyn-using handlers have
  /// run, so the table only needs uniqueness on the key — the entry
  /// value carries the dyn/concrete/data types and the evaluator's
  /// resolved trait-impl values. Mirrors `CodeGenContext.dynImpls`
  /// in `src/codegen/utils/index.ts`.
  dyn_impls : HashMap(String, CodegenDynImplEntry),
  /// Registered functions, keyed by `FuncVal.func_id`. The codegen
  /// reads `.c_name` from this map to resolve function-pointer
  /// references in `comptime_value` lowering, drop/dup function
  /// lookups, `__yo_thread_spawn` closure wrappers, dyn vtables, etc.
  /// Mirrors `CodeGenContext.functions` in
  /// `src/codegen/utils/index.ts`.
  functions : HashMap(String, CodegenFunctionEntry),
  /// Generated slice-struct types, keyed by the slice's C type name
  /// (`Slice_<sanitized_elem>`). Populated lazily by `&`-of-array-
  /// range, `&`-of-slice-range, slice-result type lowering, and
  /// extern-C slice receivers. Consumed by the type-declaration
  /// emitter, which emits one `typedef struct { … } sliceTypeName;`
  /// per entry. Mirrors `CodeGenContext.sliceStructTypes` in
  /// `src/codegen/utils/index.ts`.
  slice_struct_types : HashMap(String, CodegenSliceStructEntry),
  /// Generated array-struct types, keyed by the array's C type name
  /// (`Array_<sanitized_elem>_<len>`). Mirrors
  /// `CodeGenContext.arrayStructTypes` in
  /// `src/codegen/utils/index.ts`. Same lazy-population +
  /// typedef-emission pattern as `slice_struct_types`.
  array_struct_types : HashMap(String, CodegenArrayStructEntry),
  /// Extern C functions, keyed by the FunctionType's `id`. Populated
  /// by the function-collection pass for `extern "C"` declarations and
  /// `c_include` directives. The emitter walks the map to:
  ///   (a) emit one `#include` per unique `c_include` value, and
  ///   (b) emit one `extern <ret> <c_name>(<params>);` per entry.
  /// Mirrors `CodeGenContext.externFunctions` in
  /// `src/codegen/utils/index.ts`.
  extern_functions : HashMap(String, CodegenExternFunctionEntry),
  /// C header `#include` lines that need to land in the preamble.
  /// Populated lazily by handlers like `typeid` and `downcast` that
  /// depend on `<stdint.h>`, by extern-C declarations that name
  /// libc headers, and by the C-collection pass. Mirrors
  /// `CodeGenContext.cIncludes` (a `Set<string>` in TS) — yo-self
  /// uses an `ArrayList(String)` with a contains-check on insert,
  /// since `std/collections/hash_set` isn't pulled into codegen yet.
  ///
  /// Each entry is the literal `#include` operand including angle
  /// brackets or quotes, e.g. `"<stdint.h>"` or `"\"foo.h\""`.
  c_includes : ArrayList(String),
  /// `Impl(Fn(...))` static-dispatch closure registry, keyed by the
  /// concrete capture-struct type id. Mirrors
  /// `CodeGenContext.implClosureCallMap` in
  /// `src/codegen/utils/index.ts`. Populated by `closures.ts` when it
  /// generates the closure implementation function; read by
  /// `parallelism.ts` (`__yo_thread_spawn` / `__yo_worker_spawn`) and
  /// `async.ts` to dispatch directly to the impl function for a
  /// concrete closure value.
  impl_closure_call_map : HashMap(String, CodegenImplClosureEntry),
  // Note: `current_function_type` is NOT on CodegenContext — the
  // pre-existing `FunctionCtx` (in `codegen/functions/context.yo`) is
  // the yo-self analogue of TS `FunctionGenerationContext` and already
  // carries it. Handlers that need the enclosing FunctionType reach
  // for it via the FunctionCtx, not via CodegenContext, matching the
  // separation yo-self maintains between the two contexts.
  /// True iff codegen is currently inside the body of an async state
  /// machine. Mirrors `FunctionGenerationContext.inAsyncStateMachine`
  /// (TS uses an object-or-undefined; yo-self uses bool until the
  /// futureType payload is needed). Async/await codegen and atom
  /// codegen both gate state-machine variable resolution on this flag.
  in_async_state_machine : bool,
  /// True iff codegen is currently inside the body of an effect state
  /// machine. Mirrors `FunctionGenerationContext.inEffectStateMachine`
  /// in `src/codegen/functions/context.ts`. Used alongside
  /// `in_async_state_machine` to gate state-machine variable resolution.
  in_effect_state_machine : bool,
  /// True iff codegen is currently inside a `match` expression — which
  /// in C compiles to a `switch`, so a bare `break` would break the
  /// switch instead of an outer loop. Mirrors `CodeGenContext.insideMatch`
  /// in `src/codegen/utils/index.ts`. cond / match / break / continue
  /// codegen consult this to decide whether to emit a labelled `goto`
  /// instead of `break`.
  inside_match : bool,
  /// True iff at least one object type can form RC cycles. When `false`,
  /// the runtime GC infrastructure is omitted: `__yo_ref_header_t` is
  /// smaller, `__yo_decr_rc` skips cycle-collector checks, and the
  /// `__yo_gc_*` runtime functions become no-ops. Mirrors
  /// `CodeGenContext.needsCycleGC` in `src/codegen/utils/index.ts`.
  needs_cycle_gc : bool,
  /// True iff compiling as a library (no `main()` wrapper, exported
  /// functions use plain unmangled names). Mirrors
  /// `CodeGenContext.isLibrary`.
  is_library : bool,
  /// Module ID of the current module being compiled (e.g.
  /// `"yo3818ce2d"`). Used in library mode to distinguish user-defined
  /// exports from std library functions. Mirrors
  /// `CodeGenContext.currentModuleId`. Empty when not yet set.
  current_module_id : String,
  /// Evidence parameter C names currently in scope for function codegen.
  /// Mirrors the values of `FunctionGenerationContext.currentEvidenceParams`.
  /// Recur calls forward these names to the recursive self-call.
  current_evidence_param_names : ArrayList(String),
  /// Temp variable names already declared in the current function body.
  /// Mirrors `FunctionGenerationContext.declaredTempVars`.
  declared_temp_vars : ArrayList(String),
  /// Label after the current generated loop body.
  /// Mirrors `CodeGenContext.currentLoopLabel`.
  current_loop_label : String,
  /// Label for the current generated loop's continue target.
  /// Mirrors `CodeGenContext.currentContinueLabel`.
  current_continue_label : String
);
impl(
  CodegenContext,
  /// Create a new empty context.
  new : (fn() -> Self)(
    Self(
      types : HashMap(String, CodegenTypeEntry).new(),
      closure_capture_map : HashMap(String, CodegenClosureCaptureEntry).new(),
      iso_types : HashMap(String, CodegenIsoTypeEntry).new(),
      emitter : Emitter.new(),
      temp_count : usize(0),
      defined_fns : ArrayList(String).new(),
      defined_enums : ArrayList(String).new(),
      defined_structs : ArrayList(String).new(),
      struct_field_csvs : ArrayList(String).new(),
      struct_default_value_csvs : ArrayList(String).new(),
      variant_names : ArrayList(String).new(),
      variant_enums : ArrayList(String).new(),
      variant_fields_csv : ArrayList(String).new(),
      var_names : ArrayList(String).new(),
      var_types : ArrayList(String).new(),
      open_var_names : ArrayList(String).new(),
      open_var_field_csvs : ArrayList(String).new(),
      self_type : String.new(),
      array_alias_names : ArrayList(String).new(),
      array_alias_elems : ArrayList(String).new(),
      array_alias_sizes : ArrayList(usize).new(),
      current_fn_name : String.new(),
      current_fn_return_type : String.new(),
      lambda_count : usize(0),
      pre_fn_code : String.new(),
      fn_param_ty_lists : ArrayList(String).new(),
      fn_return_names : ArrayList(String).new(),
      fn_return_tys : ArrayList(String).new(),
      array_var_names : ArrayList(String).new(),
      array_var_sizes : ArrayList(String).new(),
      slice_var_names : ArrayList(String).new(),
      emitted_const_names : ArrayList(String).new(),
      string_const_names : ArrayList(String).new(),
      struct_field_type_csvs : ArrayList(String).new(),
      generic_struct_names : ArrayList(String).new(),
      generic_struct_field_csvs : ArrayList(String).new(),
      derive_tostring_names : ArrayList(String).new(),
      derive_clone_names : ArrayList(String).new(),
      derive_eq_names : ArrayList(String).new(),
      derive_hash_names : ArrayList(String).new(),
      derive_ord_names : ArrayList(String).new(),
      skipped_fn_names : ArrayList(String).new(),
      box_var_names : ArrayList(String).new(),
      closure_alias_names : ArrayList(String).new(),
      closure_alias_param_names : ArrayList(String).new(),
      closure_var_names : ArrayList(String).new(),
      closure_capture_names : ArrayList(String).new(),
      closure_param_names : ArrayList(String).new(),
      anon_method_var_names : ArrayList(String).new(),
      anon_method_names : ArrayList(String).new(),
      anon_method_body_templates : ArrayList(String).new(),
      expr_info_table : Option(ExprInfoTable).None,
      type_id_statics : HashMap(String, String).new(),
      dyn_impls : HashMap(String, CodegenDynImplEntry).new(),
      functions : HashMap(String, CodegenFunctionEntry).new(),
      slice_struct_types : HashMap(String, CodegenSliceStructEntry).new(),
      array_struct_types : HashMap(String, CodegenArrayStructEntry).new(),
      extern_functions : HashMap(String, CodegenExternFunctionEntry).new(),
      c_includes : ArrayList(String).new(),
      impl_closure_call_map : HashMap(String, CodegenImplClosureEntry).new(),
      in_async_state_machine : false,
      in_effect_state_machine : false,
      inside_match : false,
      needs_cycle_gc : false,
      is_library : false,
      current_module_id : String.new(),
      current_evidence_param_names : ArrayList(String).new(),
      declared_temp_vars : ArrayList(String).new(),
      current_loop_label : String.new(),
      current_continue_label : String.new()
    )
  ),
  /// Look up the typed metadata attached to expression `id` (set by the
  /// evaluator). Returns `.None` when no evaluator pass has run for this
  /// compilation unit or when the evaluator did not record an entry for
  /// this expression — handlers should fall back to bootstrap heuristics
  /// in that case.
  get_expr_info : (fn(ref(self) : Self, id : ExprId) -> Option(ExprInfo))(
    match(
      self.expr_info_table,
      .None => Option(ExprInfo).None,
      .Some(table) => expr_info_table_get(table, id)
    )
  ),
  /// Register a function under `func_id` with its assigned C name and
  /// `FuncVal`. Mirrors the TS pattern of populating
  /// `context.functions[funcId] = { value, cName, ... }`. Subsequent
  /// `get_function_c_name(func_id)` lookups return `.Some(c_name)`.
  ///
  /// The effect-state-machine slot is initialised to `.None` — the
  /// effect-runtime port (Stream C) will set it when wiring up
  /// effect handlers.
  register_function : (
    fn(
      ref(self) : Self,
      func_id : String,
      func_value : EvalValue,
      c_name : String
    ) -> unit
  )({
    entry := CodegenFunctionEntry(
      value : func_value,
      c_name : c_name,
      effect_state_machine_info : Option(EvalValue).None
    );
    self.functions.set(func_id, entry);
    ()
  }),
  /// Look up the C name of a previously-registered function by its
  /// `FuncVal.func_id`. Returns `.None` if the function has not been
  /// registered yet (caller should fall back to bootstrap heuristics or
  /// register the function first).
  ///
  /// Mirrors the `context.functions[funcId]?.cName` access pattern used
  /// across `src/codegen/exprs/{atom,drop-dup,comptime-value,async,…}.ts`.
  get_function_c_name : (fn(ref(self) : Self, func_id : String) -> Option(String))(
    match(
      self.functions.get(func_id),
      .None => Option(String).None,
      .Some(entry) => Option(String).Some(entry.c_name)
    )
  ),
  /// Look up the full `CodegenFunctionEntry` for `func_id`. Useful for
  /// callers that need the registered `FuncVal` or the effect-state-
  /// machine slot in addition to the C name.
  get_function_entry : (fn(ref(self) : Self, func_id : String) -> Option(CodegenFunctionEntry))(
    self.functions.get(func_id)
  ),
  /// Register a slice-struct type by its C type name (e.g. `Slice_i32`)
  /// and the C type string of its element. Idempotent — re-registering
  /// the same name keeps the most-recent `child_type`. Mirrors the TS
  /// pattern of
  ///   if (!context.sliceStructTypes.has(name)) {
  ///     context.sliceStructTypes.set(name, { childType: … });
  ///   }
  /// at every call-site that emits a slice value.
  register_slice_struct_type : (
    fn(ref(self) : Self, slice_c_name : String, child_type : String) -> unit
  )({
    self.slice_struct_types.set(
      slice_c_name,
      CodegenSliceStructEntry(child_type : child_type)
    );
    ()
  }),
  /// Look up the element type of a previously-registered slice-struct
  /// type. Returns `.None` if the slice type hasn't been seen yet.
  has_slice_struct_type : (fn(ref(self) : Self, slice_c_name : String) -> bool)(
    self.slice_struct_types.get(slice_c_name).is_some()
  ),
  /// Register an array-struct type. See `register_slice_struct_type`
  /// for the idempotency / mirroring rationale.
  register_array_struct_type : (
    fn(
      ref(self) : Self,
      array_c_name : String,
      child_type : String,
      length : usize
    ) -> unit
  )({
    self.array_struct_types.set(
      array_c_name,
      CodegenArrayStructEntry(child_type : child_type, length : length)
    );
    ()
  }),
  /// True iff an array-struct type with this C name is already
  /// registered.
  has_array_struct_type : (fn(ref(self) : Self, array_c_name : String) -> bool)(
    self.array_struct_types.get(array_c_name).is_some()
  ),
  /// Register an extern C function. The key is the FunctionType id —
  /// this lets duplicate `extern fn foo` declarations across modules
  /// dedupe naturally. `c_include` is `.None` when no explicit
  /// `c_include(...)` clause was attached.
  register_extern_function : (
    fn(
      ref(self) : Self,
      type_id : String,
      function_type : TypeValue,
      c_name : String,
      c_include : Option(String),
      is_extern : String
    ) -> unit
  )({
    self.extern_functions.set(
      type_id,
      CodegenExternFunctionEntry(
        function_type : function_type,
        c_name : c_name,
        c_include : c_include,
        is_extern : is_extern
      )
    );
    ()
  }),
  /// Look up the extern-function entry for a FunctionType id. Returns
  /// `.None` if not yet registered.
  get_extern_function : (
    fn(ref(self) : Self, type_id : String) -> Option(CodegenExternFunctionEntry)
  )(self.extern_functions.get(type_id)),
  /// True iff `include` is already present in the `c_includes` set.
  has_c_include : (fn(ref(self) : Self, include : String) -> bool)({
    n := self.c_includes.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.c_includes.get(i),
        .None => (),
        .Some(existing) => {
          if(existing == include, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Add a header to the set of `#include`s the codegen preamble must
  /// emit. Idempotent — re-adding the same include is a no-op. Mirrors
  /// `context.cIncludes.add(include)` in TS (which uses `Set<string>`).
  ///
  /// `include` should be the literal include operand (`"<stdint.h>"`,
  /// `"\"foo.h\""`, …) — the emitter wraps it in `#include`.
  add_c_include : (fn(ref(self) : Self, include : String) -> unit)(
    cond(
      self.has_c_include(include) => (),
      true => {
        self.c_includes.push(include);
        ()
      }
    )
  ),
  /// Register an `Impl(Fn(...))` closure for static dispatch. The key
  /// is the concrete capture-struct type id; later `__yo_thread_spawn`
  /// / `__yo_worker_spawn` / async-closure handlers look up
  /// `function_c_name` to dispatch directly.
  register_impl_closure : (
    fn(
      ref(self) : Self,
      concrete_type_id : String,
      function_c_name : String,
      call_type_id : String,
      call_type : Option(TypeValue),
      consumed_captures : Option(ArrayList(String))
    ) -> unit
  )({
    self.impl_closure_call_map.set(
      concrete_type_id,
      CodegenImplClosureEntry(
        function_c_name : function_c_name,
        call_type_id : call_type_id,
        call_type : call_type,
        consumed_captures : consumed_captures
      )
    );
    ()
  }),
  /// Look up the impl-closure entry for a concrete type id. Returns
  /// `.None` if not yet registered.
  get_impl_closure : (
    fn(ref(self) : Self, concrete_type_id : String) -> Option(CodegenImplClosureEntry)
  )(self.impl_closure_call_map.get(concrete_type_id)),
  /// Register a type's generated C name. Mirrors the TS pattern of
  /// `context.types[id] = { type, cName }`. The eventual type
  /// declaration emitter walks this map once at the end of compilation.
  register_type : (
    fn(ref(self) : Self, type_id : String, type_value : TypeValue, c_name : String) -> unit
  )({
    self.types.set(
      type_id,
      CodegenTypeEntry(type_value : type_value, c_name : c_name)
    );
    ()
  }),
  /// Look up the C name registered for a given type id. Returns `.None`
  /// when the type hasn't been registered — caller falls back to
  /// `get_type_string` derivation or to the bootstrap heuristic.
  /// Mirrors the TS `context.types[id]?.cName` access.
  get_type_c_name : (fn(ref(self) : Self, type_id : String) -> Option(String))(
    match(
      self.types.get(type_id),
      .None => Option(String).None,
      .Some(entry) => Option(String).Some(entry.c_name)
    )
  ),
  /// Register a `dyn(Trait)` impl entry, keyed by impl-key
  /// `${concrete_c_name}_${dyn_c_name}`. The vtable generator
  /// consumes this map after all dyn-using handlers have run.
  /// Mirrors `context.dynImpls.set(...)` in TS.
  register_dyn_impl : (
    fn(ref(self) : Self, impl_key : String, entry : CodegenDynImplEntry) -> unit
  )({
    self.dyn_impls.set(impl_key, entry);
    ()
  }),
  /// Look up a `dyn(Trait)` impl entry by its impl-key.
  get_dyn_impl : (
    fn(ref(self) : Self, impl_key : String) -> Option(CodegenDynImplEntry)
  )(self.dyn_impls.get(impl_key)),
  /// Register a closure-to-capture-type mapping. Mirrors
  /// `context.closureCaptureMap.set(...)` in TS.
  register_closure_capture : (
    fn(ref(self) : Self, closure_type_id : String, entry : CodegenClosureCaptureEntry) -> unit
  )({
    self.closure_capture_map.set(closure_type_id, entry);
    ()
  }),
  /// Look up the closure-capture entry for a closure type id.
  get_closure_capture : (
    fn(ref(self) : Self, closure_type_id : String) -> Option(CodegenClosureCaptureEntry)
  )(self.closure_capture_map.get(closure_type_id)),
  /// Register an `Iso(T)` type entry, keyed by the Iso type's C name.
  /// Mirrors `context.isoTypes.set(...)` in TS.
  register_iso_type : (
    fn(ref(self) : Self, iso_c_name : String, entry : CodegenIsoTypeEntry) -> unit
  )({
    self.iso_types.set(iso_c_name, entry);
    ()
  }),
  /// Look up an `Iso(T)` type entry by its C name.
  get_iso_type : (
    fn(ref(self) : Self, iso_c_name : String) -> Option(CodegenIsoTypeEntry)
  )(self.iso_types.get(iso_c_name)),
  /// Allocate the next unique temporary C variable name (`_yo_t0`, `_yo_t1`, …).
  fresh_temp : (fn(ref(self) : Self) -> String)({
    n := self.temp_count;
    self.temp_count = (n + usize(1));
    result := String.from("_yo_t");
    result.push_string(n.to_string());
    result
  }),
  /// Allocate the next unique lambda function name (`__yo_lambda_0`, …).
  fresh_lambda_name : (fn(ref(self) : Self) -> String)({
    n := self.lambda_count;
    self.lambda_count = (n + usize(1));
    result := String.from("__yo_lambda_");
    result.push_string(n.to_string());
    result
  }),
  /// Register a Yo-level function name as defined in this module.
  register_fn : (fn(ref(self) : Self, name : String) -> unit)({
    self.defined_fns.push(name);
    self.fn_param_ty_lists.push(String.new());
  }),
  /// Register a function with its pipe-separated C param type list.
  /// Each entry in `param_tys_pipe` is a C type string separated by '|'.
  register_fn_with_params : (fn(ref(self) : Self, name : String, param_tys_pipe : String) -> unit)({
    self.defined_fns.push(name);
    self.fn_param_ty_lists.push(param_tys_pipe);
  }),
  register_fn_return_type : (fn(ref(self) : Self, name : str, ret_ty : str) -> unit)({
    self.fn_return_names.push(String.from(name));
    self.fn_return_tys.push(String.from(ret_ty));
  }),
  get_fn_return_type : (fn(ref(self) : Self, name : str) -> Option(String))({
    n := self.fn_return_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while((i < n) && match(result,.None => true,.Some(_) => false), {
      match(
        self.fn_return_names.get(i),
        .None => (),
        .Some(fn_name) => if(fn_name == name, {
          result = self.fn_return_tys.get(i);
        })
      );
      i = (i + usize(1));
    });
    result
  }),
  /// Return the C param type at position `param_idx` for function `fn_name`, or None.
  get_fn_param_ty_at : (fn(ref(self) : Self, fn_name : str, param_idx : usize) -> Option(String))({
    n_fns := self.defined_fns.len();
    (fi : usize) = usize(0);
    (found_list_idx : Option(usize)) = Option(usize).None;
    while((fi < n_fns) && match(found_list_idx,.None => true,.Some(_) => false), {
      match(
        self.defined_fns.get(fi),
        .None => (),
        .Some(s) => {
          if(s == fn_name, {
            found_list_idx =.Some(fi);
          });
        }
      );
      fi = (fi + usize(1));
    });
    match(
      found_list_idx,
      .None => Option(String).None,
      .Some(list_fi) => match(
        self.fn_param_ty_lists.get(list_fi),
        .None => Option(String).None,
        .Some(pipe_csv) => {
          // Split pipe-separated string to get the param_idx-th element.
          tys_len := pipe_csv.len();
          (cur_start : usize) = usize(0);
          (cur_count : usize) = usize(0);
          (result_ty : Option(String)) = Option(String).None;
          while((cur_count <= param_idx) && (cur_start <= tys_len), {
            sep_pos := match(
              pipe_csv.index_of(String.from("|"), cur_start),
              .Some(p) => p,
              .None => tys_len
            );
            if(cur_count == param_idx, {
              result_ty =.Some(pipe_csv.substring(cur_start, sep_pos));
            });
            cur_start = (sep_pos + usize(1));
            cur_count = (cur_count + usize(1));
          });
          result_ty
        }
      )
    )
  }),
  /// Register a variable as a C array (so `name(idx)` emits `name[idx]`).
  register_array_var : (fn(ref(self) : Self, name : str) -> unit)({
    self.array_var_names.push(String.from(name));
    self.array_var_sizes.push(String.from("0"));
  }),
  /// Register a variable as a C array with its size string.
  register_array_var_with_size : (fn(ref(self) : Self, name : str, size : str) -> unit)({
    self.array_var_names.push(String.from(name));
    self.array_var_sizes.push(String.from(size));
  }),
  /// Return the size string for a C array variable, or None.
  get_array_var_size : (fn(ref(self) : Self, name : str) -> Option(String))({
    n := self.array_var_names.len();
    (i : usize) = usize(0);
    (found_idx : Option(usize)) = Option(usize).None;
    while((i < n) && match(found_idx,.None => true,.Some(_) => false), {
      match(
        self.array_var_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            found_idx =.Some(i);
          });
        }
      );
      i = (i + usize(1));
    });
    match(
      found_idx,
      .None => Option(String).None,
      .Some(idx) => self.array_var_sizes.get(idx)
    )
  }),
  /// True if `name` was registered as a C array variable.
  is_array_var : (fn(ref(self) : Self, name : str) -> bool)({
    n := self.array_var_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.array_var_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register a variable as a C slice (so `name(idx)` → `name.data[idx]`).
  register_slice_var : (fn(ref(self) : Self, name : str) -> unit)({
    self.slice_var_names.push(String.from(name));
  }),
  /// True if `name` was registered as a C slice variable.
  is_slice_var : (fn(ref(self) : Self, name : str) -> bool)({
    n := self.slice_var_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.slice_var_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register a variable as being created with `box(...)` so that equality
  /// comparisons on it dereference the pointer.
  register_box_var : (fn(ref(self) : Self, name : str) -> unit)({
    self.box_var_names.push(String.from(name));
  }),
  /// True if `name` was registered as a box variable.
  is_box_var : (fn(ref(self) : Self, name : str) -> bool)({
    n := self.box_var_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.box_var_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register a `::` constant binding as emitted (so it can be referenced by later bindings).
  register_const_var : (fn(ref(self) : Self, name : str) -> unit)({
    self.emitted_const_names.push(String.from(name));
  }),
  /// True if `name` was registered as an emitted `::` C constant.
  is_const_var : (fn(ref(self) : Self, name : str) -> bool)({
    n := self.emitted_const_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.emitted_const_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register `name` as a string `::` constant (its RHS was a string literal).
  register_string_const : (fn(ref(self) : Self, name : str) -> unit)({
    self.string_const_names.push(String.from(name));
  }),
  /// True if `name` was registered as a string `::` constant.
  is_string_const : (fn(ref(self) : Self, name : str) -> bool)({
    n := self.string_const_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.string_const_names.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// True if `name` was registered via `register_fn` — i.e., it is a
  /// user-defined function whose C name uses the `fn_` prefix.
  is_defined_fn : (fn(ref(self) : Self, name : str) -> bool)({
    n := self.defined_fns.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
      match(
        self.defined_fns.get(i),
        .None => (),
        .Some(s) => {
          if(s == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register a Yo-level enum name as declared in this module.
  register_enum : (fn(ref(self) : Self, name : String) -> unit)({
    self.defined_enums.push(name);
  }),
  /// True if `name` was registered via `register_enum`.
  is_enum_name : (fn(ref(self) : Self, name : str) -> bool)({
    n := self.defined_enums.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while((i < n) && (!(found)), {
