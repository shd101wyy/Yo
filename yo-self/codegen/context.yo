//! Minimal code-generation context for the self-hosted Yo C code generator.
//!
//! Holds the `Emitter` and any mutable state that expression/statement
//! generators need to share.  More fields will be added in Phases 4c–4i.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ Emitter } :: import("./emitter.yo");
/// Shared mutable context passed to every `generate_*` function.
///
/// Phase 4b/4c fields:
///   `emitter`      — the three-section C output accumulator
///   `temp_count`   — counter used to generate unique temp variable names
/// Phase 5c fields:
///   `defined_fns`  — Yo names of user-defined functions in the current module.
///                    Call sites check this to decide whether to add `fn_` prefix.
/// Phase 5e fields:
///   `defined_enums` — Yo names of enum types declared in this module.
///                     Dot-access `EnumName.Variant` is rewritten to `EnumName_Variant`.
/// Phase 5f fields:
///   `defined_structs` — Yo names of struct types declared in this module.
///                       `StructName(args)` constructor calls are emitted as
///                       C compound literals `(StructName){arg1, arg2, …}`.
/// Phase 5h fields:
///   `variant_names` / `variant_enums` — parallel lists mapping each registered
///                    enum variant name to its owning enum name.  Used to resolve
///                    bare `.Variant` patterns in match arms.
///   `variant_fields_csv` — parallel to `variant_names`; comma-separated field
///                    names for complex variants (e.g. "r" for Circle(r: i32),
///                    "w,h" for Rectangle(w: i32, h: i32)).  Empty string `""`
///                    for simple (no-data) variants.
/// Phase 5i fields:
///   `var_names` / `var_types` — parallel lists tracking C type of local variables
///                    and function parameters. Used to detect complex-enum variables
///                    in type-cast expressions so `i32(shape)` → `(int32_t)(shape.tag)`.
CodegenContext :: object(
  emitter : Emitter,
  temp_count : usize,
  defined_fns : ArrayList(String),
  defined_enums : ArrayList(String),
  defined_structs : ArrayList(String),
  struct_field_csvs : ArrayList(String),
  variant_names : ArrayList(String),
  variant_enums : ArrayList(String),
  variant_fields_csv : ArrayList(String),
  var_names : ArrayList(String),
  var_types : ArrayList(String),
  // Separate arrays for tracking local variables that were created from
  // anonymous struct assignments, for use by `open` statements.
  open_var_names : ArrayList(String),
  open_var_field_csvs : ArrayList(String),
  // Current implementing type name for resolving `Self` in impl method bodies.
  // Empty string means we are not currently inside an impl method body.
  self_type : String,
  // Array type aliases: `NAME :: [T; N]` → elem C type + size.
  array_alias_names : ArrayList(String),
  array_alias_elems : ArrayList(String),
  array_alias_sizes : ArrayList(usize),
  // Current function name (C-level) used to emit `recur(args)` as `fn_name(args)`.
  // Empty string when outside any function body.
  current_fn_name : String,
  // Current function's C return type. Used to coerce anonymous struct literals
  // `{ field }` → `(ReturnType){ .field = field }` when the return type is a
  // known named struct. Empty string when outside any function body.
  current_fn_return_type : String,
  // Lambda lifting: counter for unique lambda names, and a buffer for emitting
  // lifted lambdas before the current function.
  lambda_count : usize,
  pre_fn_code : String,
  // Parallel to `defined_fns`: pipe-separated C param type strings for each function.
  // Used for lambda lifting to infer callback param types.
  fn_param_ty_lists : ArrayList(String),
  // C array variables: variable names that are declared as C arrays (e.g. `int32_t arr[3]`).
  // Indexing syntax `arr(idx)` → `arr[idx]` for these variables.
  array_var_names : ArrayList(String),
  // Parallel to `array_var_names`: the size (as string) of each C array variable.
  // Used to emit the constant for `arr.len()`.
  array_var_sizes : ArrayList(String),
  // C slice variables: variable names that are declared as C slices ({data, length} structs).
  // Indexing syntax `slice(idx)` → `slice.data[idx]` for these variables.
  slice_var_names : ArrayList(String),
  // Emitted `::` constant bindings: names that have been emitted as C `__auto_type` variables.
  // Used to check if a `::` binding's dependencies are all available.
  emitted_const_names : ArrayList(String),
  // `::` constant bindings whose RHS was a string literal — used to reject string `+` in C.
  string_const_names : ArrayList(String),
  // Parallel to `defined_structs`: CSV of C type strings for each field.
  // e.g. "const char*,int32_t" for struct(name: String, age: i32).
  // Populated by `register_struct_field_types` alongside `register_struct_fields`.
  struct_field_type_csvs : ArrayList(String),
  // Types that have `derive(ToString)` registered.
  // When calling `to_string()` on a pointer to one of these types, dispatch to
  // the pre-generated `fn_TypeName_to_string` C function.
  derive_tostring_names : ArrayList(String),
  // Types that have `derive(Clone)` registered.
  // When calling `.clone()` on a pointer to one of these types, dispatch to
  // the pre-generated `fn_TypeName_clone` C function.
  derive_clone_names : ArrayList(String),
  // Types that have `derive(Eq(...))` registered.
  // When comparing two values of one of these types with `==` or `!=`, dispatch
  // to the pre-generated `fn_TypeName_eq` C function.
  derive_eq_names : ArrayList(String),
  // Types that have `derive(Hash)` registered.
  // When calling `.hash()` on a pointer to one of these types, dispatch to
  // the pre-generated `fn_TypeName_hash` C function.
  derive_hash_names : ArrayList(String),
  // Types that have `derive(Ord(...))` registered.
  // When comparing two values with `<`, `<=`, `>`, `>=`, dispatch to
  // `fn_TypeName_cmp` C function.
  derive_ord_names : ArrayList(String),
  // Function names that were skipped during codegen because their return type
  // is a comptime-only meta-type (Trait, Type, DeriveContext, …).
  // Call sites to these names emit `0` instead of a real C call.
  skipped_fn_names : ArrayList(String),
  // Variables that were created with `box(...)`: emitting `x == y` for these
  // should be `(*x == *y)` since box returns a pointer to the heap-allocated value.
  box_var_names : ArrayList(String)
);
impl(
  CodegenContext,
  /// Create a new empty context.
  new : (fn() -> Self)(
    Self(
      emitter : Emitter.new(),
      temp_count : usize(0),
      defined_fns : ArrayList(String).new(),
      defined_enums : ArrayList(String).new(),
      defined_structs : ArrayList(String).new(),
      struct_field_csvs : ArrayList(String).new(),
      variant_names : ArrayList(String).new(),
      variant_enums : ArrayList(String).new(),
      variant_fields_csv : ArrayList(String).new(),
      var_names : ArrayList(String).new(),
      var_types : ArrayList(String).new(),
      open_var_names : ArrayList(String).new(),
      open_var_field_csvs : ArrayList(String).new(),
      self_type : String.new(),
      array_alias_names : ArrayList(String).new(),
      array_alias_elems : ArrayList(String).new(),
      array_alias_sizes : ArrayList(usize).new(),
      current_fn_name : String.new(),
      current_fn_return_type : String.new(),
      lambda_count : usize(0),
      pre_fn_code : String.new(),
      fn_param_ty_lists : ArrayList(String).new(),
      array_var_names : ArrayList(String).new(),
      array_var_sizes : ArrayList(String).new(),
      slice_var_names : ArrayList(String).new(),
      emitted_const_names : ArrayList(String).new(),
      string_const_names : ArrayList(String).new(),
      struct_field_type_csvs : ArrayList(String).new(),
      derive_tostring_names : ArrayList(String).new(),
      derive_clone_names : ArrayList(String).new(),
      derive_eq_names : ArrayList(String).new(),
      derive_hash_names : ArrayList(String).new(),
      derive_ord_names : ArrayList(String).new(),
      skipped_fn_names : ArrayList(String).new(),
      box_var_names : ArrayList(String).new()
    )
  ),
  /// Allocate the next unique temporary C variable name (`_yo_t0`, `_yo_t1`, …).
  fresh_temp : (fn(self : *(Self)) -> String)({
    n := self.*.temp_count;
    self.*.temp_count = (n + usize(1));
    result := String.from("_yo_t");
    result.push_string(n.to_string());
    result
  }),
  /// Allocate the next unique lambda function name (`__yo_lambda_0`, …).
  fresh_lambda_name : (fn(self : *(Self)) -> String)({
    n := self.*.lambda_count;
    self.*.lambda_count = (n + usize(1));
    result := String.from("__yo_lambda_");
    result.push_string(n.to_string());
    result
  }),
  /// Register a Yo-level function name as defined in this module.
  register_fn : (fn(self : *(Self), name : String) -> unit)({
    self.*.defined_fns.push(name);
    self.*.fn_param_ty_lists.push(String.new());
  }),
  /// Register a function with its pipe-separated C param type list.
  /// Each entry in `param_tys_pipe` is a C type string separated by '|'.
  register_fn_with_params : (fn(self : *(Self), name : String, param_tys_pipe : String) -> unit)({
    self.*.defined_fns.push(name);
    self.*.fn_param_ty_lists.push(param_tys_pipe);
  }),
  /// Return the C param type at position `param_idx` for function `fn_name`, or None.
  get_fn_param_ty_at : (fn(self : *(Self), fn_name : str, param_idx : usize) -> Option(String))({
    n_fns := self.*.defined_fns.len();
    (fi : usize) = usize(0);
    (found_list_idx : Option(usize)) = Option(usize).None;
    while(runtime((fi < n_fns) && match(found_list_idx,.None => true,.Some(_) => false)), {
      match(
        self.*.defined_fns.get(fi),
        .None => (),
        .Some(s) => {
          if(s.as_str() == fn_name, {
            found_list_idx =.Some(fi);
          });
        }
      );
      fi = (fi + usize(1));
    });
    match(
      found_list_idx,
      .None => Option(String).None,
      .Some(list_fi) => match(
        self.*.fn_param_ty_lists.get(list_fi),
        .None => Option(String).None,
        .Some(pipe_csv) => {
          // Split pipe-separated string to get the param_idx-th element.
          tys_len := pipe_csv.len();
          (cur_start : usize) = usize(0);
          (cur_count : usize) = usize(0);
          (result_ty : Option(String)) = Option(String).None;
          while(runtime((cur_count <= param_idx) && (cur_start <= tys_len)), {
            sep_pos := match(
              pipe_csv.index_of(String.from("|"), cur_start),
              .Some(p) => p,
              .None => tys_len
            );
            if(cur_count == param_idx, {
              result_ty =.Some(pipe_csv.substring(cur_start, sep_pos));
            });
            cur_start = (sep_pos + usize(1));
            cur_count = (cur_count + usize(1));
          });
          result_ty
        }
      )
    )
  }),
  /// Register a variable as a C array (so `name(idx)` emits `name[idx]`).
  register_array_var : (fn(self : *(Self), name : str) -> unit)({
    self.*.array_var_names.push(String.from(name));
    self.*.array_var_sizes.push(String.from("0"));
  }),
  /// Register a variable as a C array with its size string.
  register_array_var_with_size : (fn(self : *(Self), name : str, size : str) -> unit)({
    self.*.array_var_names.push(String.from(name));
    self.*.array_var_sizes.push(String.from(size));
  }),
  /// Return the size string for a C array variable, or None.
  get_array_var_size : (fn(self : *(Self), name : str) -> Option(String))({
    n := self.*.array_var_names.len();
    (i : usize) = usize(0);
    (found_idx : Option(usize)) = Option(usize).None;
    while(runtime((i < n) && match(found_idx,.None => true,.Some(_) => false)), {
      match(
        self.*.array_var_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            found_idx =.Some(i);
          });
        }
      );
      i = (i + usize(1));
    });
    match(
      found_idx,
      .None => Option(String).None,
      .Some(idx) => self.*.array_var_sizes.get(idx)
    )
  }),
  /// True if `name` was registered as a C array variable.
  is_array_var : (fn(self : *(Self), name : str) -> bool)({
    n := self.*.array_var_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.array_var_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register a variable as a C slice (so `name(idx)` → `name.data[idx]`).
  register_slice_var : (fn(self : *(Self), name : str) -> unit)({
    self.*.slice_var_names.push(String.from(name));
  }),
  /// True if `name` was registered as a C slice variable.
  is_slice_var : (fn(self : *(Self), name : str) -> bool)({
    n := self.*.slice_var_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.slice_var_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register a variable as being created with `box(...)` so that equality
  /// comparisons on it dereference the pointer.
  register_box_var : (fn(self : *(Self), name : str) -> unit)({
    self.*.box_var_names.push(String.from(name));
  }),
  /// True if `name` was registered as a box variable.
  is_box_var : (fn(self : *(Self), name : str) -> bool)({
    n := self.*.box_var_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.box_var_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register a `::` constant binding as emitted (so it can be referenced by later bindings).
  register_const_var : (fn(self : *(Self), name : str) -> unit)({
    self.*.emitted_const_names.push(String.from(name));
  }),
  /// True if `name` was registered as an emitted `::` C constant.
  is_const_var : (fn(self : *(Self), name : str) -> bool)({
    n := self.*.emitted_const_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.emitted_const_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register `name` as a string `::` constant (its RHS was a string literal).
  register_string_const : (fn(self : *(Self), name : str) -> unit)({
    self.*.string_const_names.push(String.from(name));
  }),
  /// True if `name` was registered as a string `::` constant.
  is_string_const : (fn(self : *(Self), name : str) -> bool)({
    n := self.*.string_const_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.string_const_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// True if `name` was registered via `register_fn` — i.e., it is a
  /// user-defined function whose C name uses the `fn_` prefix.
  is_defined_fn : (fn(self : *(Self), name : str) -> bool)({
    n := self.*.defined_fns.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.defined_fns.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register a Yo-level enum name as declared in this module.
  register_enum : (fn(self : *(Self), name : String) -> unit)({
    self.*.defined_enums.push(name);
  }),
  /// True if `name` was registered via `register_enum`.
  is_enum_name : (fn(self : *(Self), name : str) -> bool)({
    n := self.*.defined_enums.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.defined_enums.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register a Yo-level struct name as declared in this module.
  /// Struct constructor calls `Name(args)` are then emitted as `(Name){args}`.
  /// `fields_csv` is a comma-separated list of field names (may be empty).
  register_struct : (fn(self : *(Self), name : String) -> unit)({
    self.*.defined_structs.push(name);
    self.*.struct_field_csvs.push(String.new());
    self.*.struct_field_type_csvs.push(String.new());
  }),
  /// Register a struct name with its field names (CSV).
  register_struct_fields : (fn(self : *(Self), name : str, fields_csv : str) -> unit)({
    n := self.*.defined_structs.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.defined_structs.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            (&(self.*.struct_field_csvs)).index(i).* = String.from(fields_csv);
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
  }),
  /// Return the CSV of field names for a registered struct, or `None` if not found or empty.
  get_struct_fields : (fn(self : *(Self), name : str) -> Option(String))({
    n := self.*.defined_structs.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while(runtime((i < n) && match(result,.None => true,.Some(_) => false)), {
      match(
        self.*.defined_structs.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            result = match(
              self.*.struct_field_csvs.get(i),
              .None => Option(String).None,
              .Some(fcsv) => cond(
                (fcsv.len() == usize(0)) => Option(String).None,
                true => Option(String).Some(String.from(fcsv.as_str()))
              )
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// Register field names (CSV) for a local variable created from an anon struct.
  /// Used to support `open var` when `var := { field1: val1, field2: val2 }`.
  track_open_var : (fn(self : *(Self), var_name : str, fields_csv : str) -> unit)({
    self.*.open_var_names.push(String.from(var_name));
    self.*.open_var_field_csvs.push(String.from(fields_csv));
  }),
  /// Return the field CSV for a variable tracked via `track_open_var`.
  /// Returns `None` if not found.
  get_open_var_fields : (fn(self : *(Self), var_name : str) -> Option(String))({
    n := self.*.open_var_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while(runtime((i < n) && match(result,.None => true,.Some(_) => false)), {
      match(
        self.*.open_var_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == var_name, {
            result = match(
              self.*.open_var_field_csvs.get(i),
              .None => Option(String).None,
              .Some(fcsv) => cond(
                (fcsv.len() == usize(0)) => Option(String).None,
                true => Option(String).Some(String.from(fcsv.as_str()))
              )
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// True if `name` was registered via `register_struct`.
  is_struct_name : (fn(self : *(Self), name : str) -> bool)({
    n := self.*.defined_structs.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.defined_structs.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register a (variant_name, enum_name, fields_csv) entry.
  /// `fields_csv` is a comma-separated list of field names for complex variants
  /// (e.g. "r" for Circle(r: i32), "w,h" for Rectangle(w: i32, h: i32)).
  /// Pass "" for simple (no-data) variants.
  ///
  /// If a variant with the same name AND the same enum_name is already registered,
  /// its `fields_csv` is updated in-place (so the most-recently-seen definition
  /// wins for field names).  Variants from different enums are stored as separate
  /// entries even when they share a name (e.g. `MyResult.Err` and
  /// `HalfComptResult.Err` are kept distinct).
  register_variant : (fn(self : *(Self), variant : str, enum_name : str, fields_csv : str) -> unit)({
    n := self.*.variant_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.variant_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == variant, {
            // Only treat as a match when both the variant name AND the owning enum
            // match — different enums may legitimately share variant names.
            enum_matches := match(
              self.*.variant_enums.get(i),
              .Some(e) => (e.as_str() == enum_name),
              .None => false
            );
            if(enum_matches, {
              (&(self.*.variant_fields_csv)).index(i).* = String.from(fields_csv);
              found = true;
            });
          });
        }
      );
      i = (i + usize(1));
    });
    if(!(found), {
      self.*.variant_names.push(String.from(variant));
      self.*.variant_enums.push(String.from(enum_name));
      self.*.variant_fields_csv.push(String.from(fields_csv));
    });
  }),
  /// Register the C type of a local variable or function parameter.
  register_var_type : (fn(self : *(Self), var_name : str, c_type : str) -> unit)({
    self.*.var_names.push(String.from(var_name));
    self.*.var_types.push(String.from(c_type));
  }),
  /// Return the registered C type of `var_name`, or `None` if not tracked.
  get_var_type : (fn(self : *(Self), var_name : str) -> Option(String))({
    n := self.*.var_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while(runtime((i < n) && match(result,.None => true,.Some(_) => false)), {
      match(
        self.*.var_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == var_name, {
            result = match(
              self.*.var_types.get(i),
              .Some(t) => Option(String).Some(t),
              .None => Option(String).None
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// True if enum `name` has at least one complex (data-carrying) variant registered.
  /// Used to decide whether `i32(var)` for a variable of that enum type should be
  /// emitted as `(int32_t)(var.tag)` rather than a plain cast.
  is_complex_enum_name : (fn(self : *(Self), name : str) -> bool)({
    n := self.*.variant_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.variant_enums.get(i),
        .None => (),
        .Some(e) => {
          if(e.as_str() == name, {
            match(
              self.*.variant_fields_csv.get(i),
              .None => (),
              .Some(fcsv) => {
                if(fcsv.len() > usize(0), {
                  found = true;
                });
              }
            );
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Return the enum name for `variant`, or `None` if not registered.
  get_enum_for_variant : (fn(self : *(Self), variant : str) -> Option(String))({
    n := self.*.variant_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while(runtime((i < n) && match(result,.None => true,.Some(_) => false)), {
      match(
        self.*.variant_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == variant, {
            result = match(
              self.*.variant_enums.get(i),
              .Some(e) => Option(String).Some(e),
              .None => Option(String).None
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// Return the CSV of field names for `variant` of the given `enum_name` if it is
  /// a complex (data-carrying) variant, or `None` if the variant is simple (no
  /// fields) or not registered.  Using the enum name avoids returning fields from
  /// a same-named variant of a different enum (e.g. `MyResult.Err` vs
  /// `HalfComptResult.Err`).
  get_variant_fields : (fn(self : *(Self), enum_name : str, variant : str) -> Option(String))({
    n := self.*.variant_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while(runtime((i < n) && match(result,.None => true,.Some(_) => false)), {
      match(
        self.*.variant_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == variant, {
            enum_matches := match(
              self.*.variant_enums.get(i),
              .Some(e) => (e.as_str() == enum_name),
              .None => false
            );
            if(enum_matches, {
              match(
                self.*.variant_fields_csv.get(i),
                .None => (),
                .Some(fcsv) => {
                  if(fcsv.len() > usize(0), {
                    result = Option(String).Some(String.from(fcsv.as_str()));
                  });
                }
              );
            });
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// Set the current `Self` type for impl method codegen.
  /// Call before generating an impl method body, and clear with "" afterward.
  set_self_type : (fn(self : *(Self), type_name : str) -> unit)({
    self.*.self_type = String.from(type_name);
  }),
  /// Get the current `Self` type name, or "" if not inside an impl method.
  get_self_type : (fn(self : *(Self)) -> str)(
    self.*.self_type.as_str()
  ),
  /// True if `var_name` is a registered variable whose C type ends with `*`
  /// (i.e., it is a pointer). Used to emit `->` instead of `.` for field access.
  var_type_is_ptr : (fn(self : *(Self), var_name : str) -> bool)(
    match(
      self.*.get_var_type(var_name),
      .None => false,
      .Some(ty) => {
        n := ty.len();
        cond(
          (n == usize(0)) => false,
          true => match(
            ty.at(n - usize(1)),
            .None => false,
            .Some(r) => (r.char == u32(42))
          )
        )
      }
    )
  ),
  /// Register a fixed-size array type alias `NAME :: [T; N]`.
  /// `elem_c` is the C element type (e.g. `"int32_t"`), `size` is the array length.
  register_array_alias : (fn(self : *(Self), name : str, elem_c : str, size : usize) -> unit)({
    self.*.array_alias_names.push(String.from(name));
    self.*.array_alias_elems.push(String.from(elem_c));
    self.*.array_alias_sizes.push(size);
  }),
  /// Return the C element type for array alias `name`, or `None` if not registered.
  get_array_alias_elem : (fn(self : *(Self), name : str) -> Option(String))({
    n := self.*.array_alias_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while(runtime((i < n) && match(result,.None => true,.Some(_) => false)), {
      match(
        self.*.array_alias_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            result = match(
              self.*.array_alias_elems.get(i),
              .Some(e) => Option(String).Some(e),
              .None => Option(String).None
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// Return the array size for array alias `name`, or `None` if not registered.
  get_array_alias_size : (fn(self : *(Self), name : str) -> Option(usize))({
    n := self.*.array_alias_names.len();
    (i : usize) = usize(0);
    (result : Option(usize)) = Option(usize).None;
    while(runtime((i < n) && match(result,.None => true,.Some(_) => false)), {
      match(
        self.*.array_alias_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            result = match(
              self.*.array_alias_sizes.get(i),
              .Some(sz) => Option(usize).Some(sz),
              .None => Option(usize).None
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// Register the C field types CSV for struct `name`.
  /// e.g. `"const char*,int32_t"` for `struct(name: String, age: i32)`.
  /// Parallel to `register_struct_fields`.
  register_struct_field_types : (fn(self : *(Self), name : str, types_csv : str) -> unit)({
    n := self.*.defined_structs.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.defined_structs.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            (&(self.*.struct_field_type_csvs)).index(i).* = String.from(types_csv);
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
  }),
  /// Return the CSV of C field types for struct `name`, or `None` if not found.
  get_struct_field_types : (fn(self : *(Self), name : str) -> Option(String))({
    n := self.*.defined_structs.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while(runtime((i < n) && match(result,.None => true,.Some(_) => false)), {
      match(
        self.*.defined_structs.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            result = match(
              self.*.struct_field_type_csvs.get(i),
              .None => Option(String).None,
              .Some(tcsv) => cond(
                (tcsv.len() == usize(0)) => Option(String).None,
                true => Option(String).Some(String.from(tcsv.as_str()))
              )
            );
          });
        }
      );
      i = (i + usize(1));
    });
    result
  }),
  /// Register `type_name` as having `derive(ToString)`.
  register_derive_tostring : (fn(self : *(Self), type_name : str) -> unit)({
    self.*.derive_tostring_names.push(String.from(type_name));
  }),
  /// True if `type_name` was registered via `register_derive_tostring`.
  has_derive_tostring : (fn(self : *(Self), type_name : str) -> bool)({
    n := self.*.derive_tostring_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.derive_tostring_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == type_name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register `type_name` as having `derive(Clone)`.
  register_derive_clone : (fn(self : *(Self), type_name : str) -> unit)({
    self.*.derive_clone_names.push(String.from(type_name));
  }),
  /// True if `type_name` was registered via `register_derive_clone`.
  has_derive_clone : (fn(self : *(Self), type_name : str) -> bool)({
    n := self.*.derive_clone_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.derive_clone_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == type_name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register `type_name` as having `derive(Eq(...))`.
  register_derive_eq : (fn(self : *(Self), type_name : str) -> unit)({
    self.*.derive_eq_names.push(String.from(type_name));
  }),
  /// True if `type_name` was registered via `register_derive_eq`.
  has_derive_eq : (fn(self : *(Self), type_name : str) -> bool)({
    n := self.*.derive_eq_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.derive_eq_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == type_name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register `type_name` as having `derive(Hash)`.
  register_derive_hash : (fn(self : *(Self), type_name : str) -> unit)({
    self.*.derive_hash_names.push(String.from(type_name));
  }),
  /// True if `type_name` was registered via `register_derive_hash`.
  has_derive_hash : (fn(self : *(Self), type_name : str) -> bool)({
    n := self.*.derive_hash_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.derive_hash_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == type_name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register `type_name` as having `derive(Ord(...))`.
  register_derive_ord : (fn(self : *(Self), type_name : str) -> unit)({
    self.*.derive_ord_names.push(String.from(type_name));
  }),
  /// True if `type_name` was registered via `register_derive_ord`.
  has_derive_ord : (fn(self : *(Self), type_name : str) -> bool)({
    n := self.*.derive_ord_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.derive_ord_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == type_name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register `name` as a comptime-only function whose call sites should emit `0`.
  register_skipped_fn : (fn(self : *(Self), name : str) -> unit)({
    self.*.skipped_fn_names.push(String.from(name));
  }),
  /// True if `name` was registered as a comptime-only skipped function.
  is_skipped_fn : (fn(self : *(Self), name : str) -> bool)({
    n := self.*.skipped_fn_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.skipped_fn_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  })
);
export(CodegenContext);
