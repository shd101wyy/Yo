  /// True if `type_name` was registered via `register_derive_hash`.
  has_derive_hash : (fn(self : *(Self), type_name : str) -> bool)({
    n := self.*.derive_hash_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.derive_hash_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == type_name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register `type_name` as having `derive(Ord(...))`.
  register_derive_ord : (fn(self : *(Self), type_name : str) -> unit)({
    self.*.derive_ord_names.push(String.from(type_name));
  }),
  /// True if `type_name` was registered via `register_derive_ord`.
  has_derive_ord : (fn(self : *(Self), type_name : str) -> bool)({
    n := self.*.derive_ord_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.derive_ord_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == type_name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  /// Register `name` as a comptime-only function whose call sites should emit `0`.
  register_skipped_fn : (fn(self : *(Self), name : str) -> unit)({
    self.*.skipped_fn_names.push(String.from(name));
  }),
  /// True if `name` was registered as a comptime-only skipped function.
  is_skipped_fn : (fn(self : *(Self), name : str) -> bool)({
    n := self.*.skipped_fn_names.len();
    (i : usize) = usize(0);
    (found : bool) = false;
    while(runtime((i < n) && (!(found))), {
      match(
        self.*.skipped_fn_names.get(i),
        .None => (),
        .Some(s) => {
          if(s.as_str() == name, {
            found = true;
          });
        }
      );
      i = (i + usize(1));
    });
    found
  }),
  register_closure_alias : (fn(self : *(Self), alias_name : str, param_name : str) -> unit)({
    self.*.closure_alias_names.push(String.from(alias_name));
    self.*.closure_alias_param_names.push(String.from(param_name));
  }),
  get_closure_alias_param_name : (fn(self : *(Self), alias_name : str) -> Option(String))({
    n := self.*.closure_alias_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while(runtime((i < n) && match(result,.None => true,.Some(_) => false)), {
      match(
        self.*.closure_alias_names.get(i),
        .None => (),
        .Some(name) => if(name.as_str() == alias_name, {
          result = self.*.closure_alias_param_names.get(i);
        })
      );
      i = (i + usize(1));
    });
    result
  }),
  register_simple_closure_var : (fn(self : *(Self), var_name : str, capture_name : str, param_name : str) -> unit)({
    self.*.closure_var_names.push(String.from(var_name));
    self.*.closure_capture_names.push(String.from(capture_name));
    self.*.closure_param_names.push(String.from(param_name));
  }),
  get_simple_closure_capture_name : (fn(self : *(Self), var_name : str) -> Option(String))({
    n := self.*.closure_var_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while(runtime((i < n) && match(result,.None => true,.Some(_) => false)), {
      match(
        self.*.closure_var_names.get(i),
        .None => (),
        .Some(name) => if(name.as_str() == var_name, {
          result = self.*.closure_capture_names.get(i);
        })
      );
      i = (i + usize(1));
    });
    result
  }),
  get_simple_closure_param_name : (fn(self : *(Self), var_name : str) -> Option(String))({
    n := self.*.closure_var_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while(runtime((i < n) && match(result,.None => true,.Some(_) => false)), {
      match(
        self.*.closure_var_names.get(i),
        .None => (),
        .Some(name) => if(name.as_str() == var_name, {
          result = self.*.closure_param_names.get(i);
        })
      );
      i = (i + usize(1));
    });
    result
  }),
  register_anon_method : (fn(self : *(Self), var_name : str, method_name : str, body_template : str) -> unit)({
    self.*.anon_method_var_names.push(String.from(var_name));
    self.*.anon_method_names.push(String.from(method_name));
    self.*.anon_method_body_templates.push(String.from(body_template));
  }),
  get_anon_method_body_template : (fn(self : *(Self), var_name : str, method_name : str) -> Option(String))({
    n := self.*.anon_method_var_names.len();
    (i : usize) = usize(0);
    (result : Option(String)) = Option(String).None;
    while(runtime((i < n) && match(result,.None => true,.Some(_) => false)), {
      var_matches := match(
        self.*.anon_method_var_names.get(i),
        .None => false,
        .Some(name) => (name.as_str() == var_name)
      );
      method_matches := match(
        self.*.anon_method_names.get(i),
        .None => false,
        .Some(name2) => (name2.as_str() == method_name)
      );
      if(var_matches && method_matches, {
        result = self.*.anon_method_body_templates.get(i);
      });
      i = (i + usize(1));
    });
    result
  })
);
export(
  CodegenTypeEntry,
  CodegenClosureCaptureEntry,
  CodegenIsoTypeEntry,
  CodegenDynImplEntry,
  CodegenFunctionEntry,
  CodegenContext
);
