//! Type guard predicates.
//!
//! Mirrors `src/types/guards.ts` — 1:1 port of every exported guard.
//!
//! Functions that require TypeValue variants or per-parameter flags not yet
//! present in Phase 2a are stubbed to return `false` with a `// Phase 2b`
//! comment. The full implementations will be added once the relevant TypeValue
//! variants and field flags are wired in.
//!
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashSet } :: import("std/collections/hash_set");
{ TypeValue } :: import("./definitions.yo");
{ type_value_tag, resolve_enum_shell, resolve_struct_shell } :: import("./creators.yo");
// ---------------------------------------------------------------------------
// Extern opaque-Type registry. `extern("Yo", X : Type)` declares an opaque type
// whose value is a SomeT PLACEHOLDER (e.g. `__yo_thread_t`); codegen emits a
// concrete C type for it, so it is NOT a codegen-blocking generic. TS marks
// these via `SomeType.isExtern` (src/types/utils.ts:10); yo-self's SomeT has no
// such field, so the extern declaration records the type NAME here (extern.yo)
// and the codegen-generic checks (type_contains_some_type_for_codegen_param)
// exclude a SomeT whose name is registered. Empty during pure evaluation.
// ---------------------------------------------------------------------------
(g_extern_type_names : HashSet(String)) = HashSet(String).new();
register_extern_type_name :: (fn(name : String) -> unit)({
  if(name.len() > usize(0), {
    _r := g_extern_type_names.add(name);
  });
  ()
});
is_extern_type_name :: (fn(name : String) -> bool)(g_extern_type_names.contains(name));
// ---------------------------------------------------------------------------
// Resolved-concrete bridge indirection (mirrors TS reading
// `someType.resolvedConcreteType`). guards.yo is low-level and cannot import
// expr_info.yo's `lookup_some_resolved_concrete` (would cycle), so the lookup is
// injected at codegen init via `set_lookup_some_resolved_concrete` — the same
// indirection pattern as `set_collect_type_fn` in codegen/functions/collection.yo.
// When unset (e.g. during evaluation, before codegen) it reports "no concrete",
// preserving prior behavior.
// ---------------------------------------------------------------------------
LookupSomeResolvedConcreteFn :: (fn(some_id : String) -> Option(TypeValue));
(g_lookup_some_resolved_concrete : Option(LookupSomeResolvedConcreteFn)) = Option(LookupSomeResolvedConcreteFn).None;
set_lookup_some_resolved_concrete :: (fn(f : LookupSomeResolvedConcreteFn) -> unit)({
  g_lookup_some_resolved_concrete = Option(LookupSomeResolvedConcreteFn).Some(f);
  ()
});
_some_param_has_resolved_concrete :: (fn(some_id : String) -> bool)(
  match(g_lookup_some_resolved_concrete,.Some(f) => f(some_id).is_some(),.None => false)
);
// ---------------------------------------------------------------------------
// Variant-shape predicates — were in `type.yo` before Phase A.3.2; relocated
// here to mirror `src/types/guards.ts`. These are one-line wrappers around a
// `match` on the TypeValue variant, used pervasively by callers that want a
// boolean test rather than a tag enum comparison.
// ---------------------------------------------------------------------------
is_int_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Int(_, _) => true, _ => false)
);
is_float_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Float(_) => true, _ => false)
);
is_signed_int_type :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .Int(_, signed) => signed,
    .Isize => true,
    _ => false
  )
);
is_numeric_type :: (fn(t : TypeValue) -> bool)(
  cond(
    is_int_type(t) => true,
    is_float_type(t) => true,
    true => match(
      t,
      .Usize => true,
      .Isize => true,
      .ComptimeInt => true,
      .ComptimeFloat => true,
      _ => false
    )
  )
);
is_pointer_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Pointer(_) => true, _ => false)
);
is_array_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Array(_, _, _) => true, _ => false)
);
is_function_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Func({ result : _ }) => true, _ => false)
);
is_some_type :: (fn(t : TypeValue) -> bool)(
  match(t,.SomeT(name : _) => true, _ => false)
);
is_trait_type :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .TraitT(name : _) => true,
    .FnTraitT(base_name : _) => true,
    .FutureTraitT(base_name : _) => true,
    _ => false
  )
);
/// True for source-namespace structs (anonymous modules / imports).
/// Mirrors TS `isSourceNamespaceType` (guards.ts:191) — TS has no module
/// type; the legacy name is kept for the existing call sites.
is_module_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Struct({ is_source_namespace : sns }) => sns, _ => false)
);
/// Mirrors TS `isStructType` (guards.ts:161): EXCLUDES source-namespace
/// structs, exactly as TS does.
is_struct_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Struct({ is_source_namespace : sns }) => !(sns), _ => false)
);
is_enum_type :: (fn(t : TypeValue) -> bool)(
  match(t,.EnumT(_, _, _, _, _, _, _, _, _) => true, _ => false)
);
is_unit_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Unit => true, _ => false)
);
is_bool_type :: (fn(t : TypeValue) -> bool)(
  match(t,.BoolT => true, _ => false)
);
// ---------------------------------------------------------------------------
// Basic primitive guards
// ---------------------------------------------------------------------------
is_primitive_type :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .Unit => true,
    .BoolT => true,
    .Usize => true,
    .Isize => true,
    .Int(_, _) => true,
    .Float(_) => true,
    .CChar => true,
    .CShort => true,
    .CUShort => true,
    .CInt => true,
    .CUInt => true,
    .CLong => true,
    .CULong => true,
    .CLongLong => true,
    .CULongLong => true,
    .CLongDouble => true,
    _ => false
  )
);
is_comptime_int_type :: (fn(t : TypeValue) -> bool)(
  match(t,.ComptimeInt => true, _ => false)
);
is_comptime_float_type :: (fn(t : TypeValue) -> bool)(
  match(t,.ComptimeFloat => true, _ => false)
);
is_comptime_string_type :: (fn(t : TypeValue) -> bool)(
  match(t,.ComptimeString => true, _ => false)
);
is_comptime_list_type :: (fn(t : TypeValue) -> bool)(
  match(t,.ComptimeListT(_) => true, _ => false)
);
is_expr_list_type :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .ComptimeListT(child) => match(child,.ExprT => true, _ => false),
    _ => false
  )
);
is_usize_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Usize => true, _ => false)
);
is_isize_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Isize => true, _ => false)
);
is_u8_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Int(bits, signed) => ((bits == u8(8)) && !(signed)), _ => false)
);
is_i8_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Int(bits, signed) => ((bits == u8(8)) && signed), _ => false)
);
is_u16_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Int(bits, signed) => ((bits == u8(16)) && !(signed)), _ => false)
);
is_i16_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Int(bits, signed) => ((bits == u8(16)) && signed), _ => false)
);
is_u32_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Int(bits, signed) => ((bits == u8(32)) && !(signed)), _ => false)
);
is_i32_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Int(bits, signed) => ((bits == u8(32)) && signed), _ => false)
);
is_u64_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Int(bits, signed) => ((bits == u8(64)) && !(signed)), _ => false)
);
is_i64_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Int(bits, signed) => ((bits == u8(64)) && signed), _ => false)
);
is_f32_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Float(bits) => (bits == u8(32)), _ => false)
);
is_f64_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Float(bits) => (bits == u8(64)), _ => false)
);
is_expr_type :: (fn(t : TypeValue) -> bool)(
  match(t,.ExprT => true, _ => false)
);
// ---------------------------------------------------------------------------
// Compound type guards
// ---------------------------------------------------------------------------
is_tuple_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Tuple(_, _) => true, _ => false)
);
is_union_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Union(_, _, _) => true, _ => false)
);
/// Reference-semantics struct: `ref(struct(...))`. Mirrors
/// `isReferenceStructType` in `src/types/guards.ts`.
is_reference_struct_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Struct({ is_reference_semantics : is_ref }) => is_ref, _ => false)
);
// Atomic reference-semantics struct: `atomic(ref(struct(...)))`.
// Mirrors `isAtomicReferenceStructType` in `src/types/guards.ts`, which
// requires BOTH `is_reference_semantics` AND `is_atomic_rc`. A
// value-semantics struct with `is_atomic_rc = true` is malformed but should
// not pass.
is_atomic_reference_struct_type :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .Struct({ is_reference_semantics : is_ref, is_atomic_rc : is_atomic }) =>
      (is_ref && is_atomic),
    _ => false
  )
);
/// Reference-semantics enum: `ref(enum(...))`. Mirrors
/// `isReferenceEnumType` in `src/types/guards.ts`.
is_reference_enum_type :: (fn(t : TypeValue) -> bool)(
  match(t,.EnumT({ is_reference_semantics : is_ref }) => is_ref, _ => false)
);
/// Atomic reference-semantics enum: `atomic(ref(enum(...)))`. Mirrors
/// `isAtomicReferenceEnumType` in `src/types/guards.ts`.
is_atomic_reference_enum_type :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .EnumT({ is_reference_semantics : is_ref, is_atomic_rc : is_atomic }) =>
      (is_ref && is_atomic),
    _ => false
  )
);
// Phase 2b : Type.Struct needs `isNewtype` flag.
is_newtype_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Struct({ is_newtype : is_nt }) => is_nt, _ => false)
);
/// True if `t` is the builtin `str` static string view (TypeValue.Str).
/// Used by `panic` / `fprintf` codegen to choose between `%s` and `%.*s`
/// format specifiers.
is_str_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Str => true, _ => false)
);
/// True if `t` is `Box(T)` — a single-field reference-semantics Struct
/// whose name starts with `Box(` and whose only field is labeled `*`.
/// Used by RC and downcast codegen to look through the Box wrapper.
is_box_type :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .Struct({ name, field_labels, is_reference_semantics : is_ref }) => cond(
      (!(is_ref)) => false,
      (field_labels.len() != usize(1)) => false,
      (!(name.clone().starts_with(String.from("Box(")))) => false,
      true => match(
        field_labels.get(usize(0)),
        .Some(label) => (label == "*"),
        .None => false
      )
    ),
    _ => false
  )
);
is_fn_trait_type :: (fn(t : TypeValue) -> bool)(
  match(t,.FnTraitT(base_name : _) => true, _ => false)
);
is_function_type_and_is_type_function :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .Func({ result : r }) => match(r,.TypeUni(_) => true, _ => false),
    _ => false
  )
);
// Phase 2b: Func return type needs `isUnquote` flag.
is_function_type_and_is_macro_function :: (fn(t : TypeValue) -> bool)(false);
/// Check if a TypeValue is comptime-only (never a runtime type).
///
/// Mirrors the subset of `typeImplementsComptimeBuiltin` that returns definitively
/// `true` for comptime-only types. Primitives like `i32`, `bool`, and `unit` are
/// NOT comptime-only because they also implement runtime.
is_comptime_only_type_simple :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .ComptimeInt => true,
    .ComptimeFloat => true,
    .ComptimeString => true,
    .TypeUni(_) => true,
    // Source-namespace structs (anonymous modules / imports) are
    // comptime-only; ordinary structs are not.
    .Struct({ is_source_namespace : sns2 }) => sns2,
    .TraitT(name : _) => true,
    .FnTraitT(base_name : _) => true,
    .FutureTraitT(base_name : _) => true,
    .ExprT => true,
    .ComptimeListT(_) => true,
    _ => false
  )
);
/// True if `t` is a function type whose return type is comptime-only.
///
/// Mirrors `isFunctionTypeAndReturnsComptimeValue` in `src/types/guards.ts`.
is_function_type_and_returns_comptime_value :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    // TS reads the RETURN SPEC FLAG (`functionType.return.isCompileTimeOnly`),
    // not a property of the result type: `-> comptime(unit)` has a plain unit
    // result type with the comptime-ness carried in the meta flag. The
    // type-based test alone made every "runtime binding in a comptime-only
    // fn body" gate silently never fire (tests/fn.test.yo).
    .Func({ result : r, meta : __gm }) => (__gm.*.result_is_comptime_only || is_comptime_only_type_simple(r)),
    _ => false
  )
);
// ---------------------------------------------------------------------------
// Type universe guards
// ---------------------------------------------------------------------------
/// Corresponds to `isTypeHierarchyType` — the `Type`, `Type(1)`, … universe.
is_type_hierarchy_type :: (fn(t : TypeValue) -> bool)(
  match(t,.TypeUni(_) => true, _ => false)
);
is_type_0 :: (fn(t : TypeValue) -> bool)(
  match(t,.TypeUni(level) => (level == usize(0)), _ => false)
);
// ---------------------------------------------------------------------------
// Pointer / reference / dyn guards
// ---------------------------------------------------------------------------
is_iso_type :: (fn(t : TypeValue) -> bool)(
  match(t,.IsoT(_) => true, _ => false)
);
is_dyn_type :: (fn(t : TypeValue) -> bool)(
  match(t,.DynT(required_trait_types : _) => true, _ => false)
);
is_type_application_type :: (fn(t : TypeValue) -> bool)(
  match(t,.TypeAppT(constructor : _) => true, _ => false)
);
// ---------------------------------------------------------------------------
// Numeric type guards (extended versions)
// ---------------------------------------------------------------------------
/// True for all integer types, including pointer-sized integers.
///
/// This is intentionally broader than `is_int_type` in type.yo, which only
/// checks the fixed-width `Int(bits, signed)` variant.
is_integer_type :: (fn(t : TypeValue) -> bool)(
  cond(
    is_int_type(t) => true,
    true => match(
      t,
      .Usize => true,
      .Isize => true,
      _ => false
    )
  )
);
is_unsigned_integer_type :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .Int(_, signed) => !(signed),
    .Usize => true,
    _ => false
  )
);
// ---------------------------------------------------------------------------
// C-compatible type guards
// ---------------------------------------------------------------------------
is_char_type :: (fn(t : TypeValue) -> bool)(
  match(t,.CChar => true, _ => false)
);
is_short_type :: (fn(t : TypeValue) -> bool)(
  match(t,.CShort => true, _ => false)
);
is_u_short_type :: (fn(t : TypeValue) -> bool)(
  match(t,.CUShort => true, _ => false)
);
is_c_int_type :: (fn(t : TypeValue) -> bool)(
  match(t,.CInt => true, _ => false)
);
is_c_uint_type :: (fn(t : TypeValue) -> bool)(
  match(t,.CUInt => true, _ => false)
);
is_long_type :: (fn(t : TypeValue) -> bool)(
  match(t,.CLong => true, _ => false)
);
is_u_long_type :: (fn(t : TypeValue) -> bool)(
  match(t,.CULong => true, _ => false)
);
is_long_long_type :: (fn(t : TypeValue) -> bool)(
  match(t,.CLongLong => true, _ => false)
);
is_u_long_long_type :: (fn(t : TypeValue) -> bool)(
  match(t,.CULongLong => true, _ => false)
);
is_long_double_type :: (fn(t : TypeValue) -> bool)(
  match(t,.CLongDouble => true, _ => false)
);
is_void_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Void => true, _ => false)
);
is_future_trait_type :: (fn(t : TypeValue) -> bool)(
  match(t,.FutureTraitT(base_name : _) => true, _ => false)
);
/// `true` when `t` is a `Concrete(T)` trait type (its `is_concrete` marker is
/// `.Some`). Mirrors TS `isConcreteTraitType` (`isTraitType(t) && t.isConcrete
/// !== undefined`). The `TraitT` variant carries `is_concrete :
/// Option(Box(Self))`; this was a `=> false` stub until the async-Future type
/// plumbing (Phase 5) needed it (`is_io_future_type`).
is_concrete_trait_type :: (fn(t : TypeValue) -> bool)(
  match(t,.TraitT({ is_concrete }) => is_concrete.is_some(), _ => false)
);
/// Return `true` if `t` itself is an RC-managed type (not recursively).
///
/// An RC type is:
///   - A `ref(struct(...))` struct (`is_reference_semantics = true`)
///   - A `ref(enum(...))` enum (`is_reference_semantics = true`)
///   - A `DynT` trait-object (always heap-allocated)
///   - An `IsoT` (atomic reference-counted)
///   - A `SomeT` that has a Future trait constraint (Futures are always RC)
///
/// Mirrors `isRcType` in `src/types/guards.ts`.
is_rc_type :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    // Resolve a leaked recursive SELF-SHELL before reading the flag: shells
    // lose `is_reference_semantics`, so a shell of a ref(enum)/ref(struct)
    // (e.g. EvalValue during its own definition) read as NON-RC here — the
    // dup-on-store predicate then skipped the element retain when
    // specializing ArrayList(EvalValue).push, producing a push that stores
    // WITHOUT +1 (the stage-2 t1.yo rc=138 UAF: impl method registry read a
    // method value freed by the pusher's scope-end drop). Same shell-resolve
    // pattern as type_key / eval-match (yo-self-recursive-enum-self-shell).
    .Struct({ is_reference_semantics : is_ref }) => match(
      resolve_struct_shell(t),
      .Struct({ is_reference_semantics : r_res }) => r_res,
      _ => is_ref
    ),
    // Reference-semantics enums (`ref(enum(…))`) are RC-managed like objects.
    .EnumT({ is_reference_semantics : is_ref }) => match(
      resolve_enum_shell(t),
      .EnumT({ is_reference_semantics : r_res }) => r_res,
      _ => is_ref
    ),
    .DynT(required_trait_types : _) => true,
    .IsoT(_) => true,
    .SomeT(required_trait_types : req_traits) => {
      // Check if any required trait is a Future trait
      (found : bool) = false;
      (i : usize) = usize(0);
      while((i < req_traits.len()) && !(found), {
        match(
          req_traits.get(i),
          .Some(tr) => {
            if(is_future_trait_type(tr), {
              found = true;
            });
          },
          .None => ()
        );
        i = (i + usize(1));
      });
      found
    },
    _ => false
  )
);
is_c_compatible_type :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .CChar => true,
    .CShort => true,
    .CUShort => true,
    .CInt => true,
    .CUInt => true,
    .CLong => true,
    .CULong => true,
    .CLongLong => true,
    .CULongLong => true,
    .CLongDouble => true,
    _ => false
  )
);
// ---------------------------------------------------------------------------
// Function genericity guards
// ---------------------------------------------------------------------------
/// Check if a function type has generic parameters requiring specialization.
///
/// Partial Phase 2a implementation: detects generic parameters and implicit
/// (using/effect) parameters from the TypeValue.Func variant fields.
///
/// Phase 2b: extend to also check per-parameter `isCompileTimeOnly` flags,
/// variadic `isQuote` flags, and non-Future SomeType parameters.
is_function_type_generic :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .Func({ param_types : pts, meta : __fm1 }) =>
      cond(
        (__fm1.*.forall_labels.len() > usize(0)) => true,
        (__fm1.*.implicit_labels.len() > usize(0)) => true,
        // Partial: check if any param is SomeT (Phase 2b: exclude Future SomeType)
        true => {
          found := false;
          i := usize(0);
          n := pts.len();
          while(i < n, {
            match(
              pts.get(i),
              .Some(pt) => match(
                pt,
                .SomeT(name : _) => {
                  found = true;
                },
                _ => ()
              ),
              .None => ()
            );
            if(found, {
              break;
            });
            i = (i + usize(1));
          });
          found
        }
      ),
    _ => false
  )
);
/// Check if a function type has "hard" generic parameters that make the
/// unspecialized form invalid for C codegen.
///
/// Partial Phase 2a implementation: detects generic parameters and SomeType
/// parameters without a resolved concrete type.
///
/// Phase 2b: extend to check per-parameter `isCompileTimeOnly` flags and
/// `resolvedConcreteType` on SomeType parameters.
is_function_type_hard_generic :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .Func({ param_types : pts, meta : __fm2 }) =>
      cond(
        (__fm2.*.forall_labels.len() > usize(0)) => true,
        // A SomeType param makes the unspecialized form hard-generic — UNLESS it
        // has a resolved concrete type, in which case codegen can lower it via the
        // concrete (e.g. a closure-typed param `cb : Impl(Fn(...))` resolved to its
        // capture struct). Mirrors TS guards.ts:490 (`!p.type.resolvedConcreteType`).
        true => {
          found := false;
          i := usize(0);
          n := pts.len();
          while(i < n, {
            match(
              pts.get(i),
              .Some(pt) => match(
                pt,
                .SomeT(id : sid, name : _) => {
                  if(!(_some_param_has_resolved_concrete(sid)), {
                    found = true;
                  });
                },
                // A `comptime(K) : Type` param (the type UNIVERSE) can never
                // be a runtime C parameter — the prototype renders
                // `// Unknown type: Type K` ("invalid storage class
                // specifier", the imm_map/imm_set family). Same
                // classification as TS guards.ts:466 hasCompileTimeParams.
                .TypeUni(_) => {
                  found = true;
                },
                // An Array with an UNRESOLVED length variable
                // (`Array(i32, n)` — value-generic length) has no valid C
                // rendering either: the prototype printed
                // `// Unknown type: Array(i32, n)` and ate the line
                // (array.test batch clang errors). Same classification as
                // TS guards.ts hasCompileTimeParams reaching the length.
                .Array(_, _, hg_lvar) => if(hg_lvar.len() > usize(0), {
                  found = true;
                }),
                _ => ()
              ),
              .None => ()
            );
            if(found, {
              break;
            });
            i = (i + usize(1));
          });
          found
        }
      ),
    _ => false
  )
);
// Phase 2b: requires FunctionValue with `specializedFunctionCaches` field.
is_function_specializable :: (fn(t : TypeValue) -> bool)(false);
// ---------------------------------------------------------------------------
// Box / effects-row guards
// ---------------------------------------------------------------------------
// Mirrors `isBoxedType` (src/types/guards.ts:529): a reference-semantics
// struct with exactly one field labeled `*` whose typeName starts with
// "Box(" — i.e. the prelude `Box(T)` wrapper.
is_boxed_type :: (fn(t : TypeValue) -> bool)(
  if(
    !(is_reference_struct_type(t)),
    false,
    match(
      t,
      .Struct({ name, field_labels }) =>
        (((field_labels.len() == usize(1)) && match(field_labels.get(usize(0)),.Some(l) => (l == "*"),.None => false)) && name.starts_with("Box(")),
      _ => false
    )
  )
);
is_effects_row_type :: (fn(t : TypeValue) -> bool)(
  match(t,.EffectsRowT(implicit_labels : _) => true, _ => false)
);
// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------
export(
  // Variant-shape predicates (relocated from type.yo in Phase A.3.2)
  is_int_type,
  is_float_type,
  is_signed_int_type,
  is_numeric_type,
  is_pointer_type,
  is_array_type,
  is_function_type,
  is_trait_type,
  is_module_type,
  is_some_type,
  is_struct_type,
  is_enum_type,
  is_unit_type,
  is_bool_type,
  // Primitive guards
  is_primitive_type,
  is_comptime_int_type,
  is_comptime_float_type,
  is_comptime_string_type,
  is_comptime_list_type,
  is_expr_list_type,
  is_usize_type,
  is_isize_type,
  is_u8_type,
  is_i8_type,
  is_u16_type,
  is_i16_type,
  is_u32_type,
  is_i32_type,
  is_u64_type,
  is_i64_type,
  is_f32_type,
  is_f64_type,
  is_expr_type,
  // Compound type guards
  is_tuple_type,
  is_union_type,
  is_reference_struct_type,
  is_atomic_reference_struct_type,
  is_reference_enum_type,
  is_atomic_reference_enum_type,
  is_newtype_type,
  is_str_type,
  is_box_type,
  is_fn_trait_type,
  is_function_type_and_is_type_function,
  is_function_type_and_is_macro_function,
  is_comptime_only_type_simple,
  is_function_type_and_returns_comptime_value,
  // Type universe guards
  is_type_hierarchy_type,
  is_type_0,
  // Pointer / reference guards
  is_iso_type,
  is_dyn_type,
  is_type_application_type,
  is_rc_type,
  // Numeric extended guards
  is_integer_type,
  is_unsigned_integer_type,
  // C-compatible guards
  is_char_type,
  is_short_type,
  is_u_short_type,
  is_c_int_type,
  is_c_uint_type,
  is_long_type,
  is_u_long_type,
  is_long_long_type,
  is_u_long_long_type,
  is_long_double_type,
  is_void_type,
  is_future_trait_type,
  is_concrete_trait_type,
  is_c_compatible_type,
  // Function genericity guards
  is_function_type_generic,
  is_function_type_hard_generic,
  set_lookup_some_resolved_concrete,
  register_extern_type_name,
  is_extern_type_name,
  is_function_specializable,
  // Box / effects-row guards
  is_boxed_type,
  is_effects_row_type
);
