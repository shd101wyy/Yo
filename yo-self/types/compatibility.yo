//! are_types_compatible — structural compatibility check (Phase 2f).
//!
//! Mirrors `areTypesCompatible` in `src/types/compatibility.ts`.
//!
//! Argument convention (opposite of TypeScript):
//!   `actual`   = the type we have        (TS: `given`)
//!   `expected` = the type context expects (TS: `expected`)
//!
//! Public API:
//!   are_types_compatible(actual, expected) -> bool
//!   are_types_compatible_exact(actual, expected) -> bool
//!   are_function_types_compatible(actual, expected) -> bool
pragma(Pragma.AllowUnsafe);
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue } :: import("./definitions.yo");
{ type_value_tag, resolve_enum_shell } :: import("./creators.yo");
{ is_int_type, is_float_type, is_some_type, is_dyn_type } :: import("./guards.yo");
{ type_contains_some_type } :: import("./utils.yo");
{ TypeTag } :: import("./tags.yo");
{
  is_comptime_int_type,
  is_comptime_float_type,
  is_comptime_string_type,
  is_u8_type,
  is_char_type,
  is_c_compatible_type
} :: import("./guards.yo");
// ---------------------------------------------------------------------------
// Internal helpers
// ---------------------------------------------------------------------------
_visited_contains :: (fn(visited : ArrayList(String), key : String) -> bool)({
  i := usize(0);
  n := visited.len();
  while(i < n, {
    s := match(visited.get(i),.Some(v) => v,.None => ``);
    if(s == key, {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
_is_in_used :: (fn(used : ArrayList(usize), idx : usize) -> bool)({
  i := usize(0);
  n := used.len();
  while(i < n, {
    ui := match(used.get(i),.Some(v) => v,.None => usize(999999));
    if(ui == idx, {
      return(true);
    });
    i = (i + usize(1));
  });
  false
});
// Flatten effects arrays into out_labels / out_types, expanding EffectsRowT spreads.
// ArrayList is RC-shared — mutations to out_* are visible to the caller.
_flatten_effects :: (
  fn(
    labels : ArrayList(String),
    types : ArrayList(TypeValue),
    spreads : ArrayList(bool),
    out_labels : ArrayList(String),
    out_types : ArrayList(TypeValue)
  ) -> unit
)({
  i := usize(0);
  n := labels.len();
  while(i < n, {
    lbl := match(labels.get(i),.Some(v) => v,.None => ``);
    ty := match(types.get(i),.Some(v) => v,.None => TypeValue.Unit);
    sp := match(spreads.get(i),.Some(v) => v,.None => false);
    if(sp, {
      match(
        ty,
        .EffectsRowT(implicit_labels : row_labels, implicit_types : row_types) => {
          j := usize(0);
          m := row_labels.len();
          while(j < m, {
            rl := match(row_labels.get(j),.Some(v) => v,.None => ``);
            rt := match(row_types.get(j),.Some(v) => v,.None => TypeValue.Unit);
            out_labels.push(rl);
            out_types.push(rt);
            j = (j + usize(1));
          });
        },
        _ => {
          out_labels.push(lbl);
          out_types.push(ty);
        }
      );
    }, {
      out_labels.push(lbl);
      out_types.push(ty);
    });
    i = (i + usize(1));
  });
});
// ---------------------------------------------------------------------------
// trait-implements hook (types/ -> evaluator/ cycle breaker)
// ---------------------------------------------------------------------------
/// Hook to `type_implements_trait_bool` (evaluator/trait_checking.yo), installed
/// by its init block. Routed through a fn-pointer slot because compatibility.yo
/// (types/) cannot import evaluator/ modules (trait_checking.yo imports THIS
/// file). Used by the concrete-vs-constrained-SomeT rule in `_compat_impl`.
CompatImplementsTraitFn :: (fn(t : TypeValue, trait_type : TypeValue) -> bool);
(g_compat_type_implements_trait_fn : Option(CompatImplementsTraitFn)) =
  Option(CompatImplementsTraitFn).None;
set_compat_type_implements_trait_fn :: (fn(f : CompatImplementsTraitFn) -> unit)({
  g_compat_type_implements_trait_fn = Option(CompatImplementsTraitFn).Some(f);
});
// ---------------------------------------------------------------------------
// Core implementation
// ---------------------------------------------------------------------------
_compat_impl :: (
  fn(
    actual : TypeValue,
    expected : TypeValue,
    require_exact : bool,
    visited : ArrayList(String)
  ) -> bool
)({
  // --- ComptimeInt widening -------------------------------------------------
  if(is_comptime_int_type(actual), {
    return(
      match(
        expected,
        .ComptimeInt => true,
        _ => cond(
          require_exact => false,
          true => match(
            expected,
            .Int(_, _) => true,
            .Usize => true,
            .Isize => true,
            .Float(_) => true,
            .ComptimeFloat => true,
            .CChar => true,
            .CShort => true,
            .CUShort => true,
            .CInt => true,
            .CUInt => true,
            .CLong => true,
            .CULong => true,
            .CLongLong => true,
            .CULongLong => true,
            _ => false
          )
        )
      )
    );
  });
  // --- ComptimeFloat widening -----------------------------------------------
  if(is_comptime_float_type(actual), {
    return(
      match(
        expected,
        .ComptimeFloat => true,
        _ => cond(
          require_exact => false,
          true => match(
            expected,
            .Float(_) => true,
            _ => false
          )
        )
      )
    );
  });
  // --- ComptimeString widening ----------------------------------------------
  if(is_comptime_string_type(actual), {
    return(
      match(
        expected,
        .ComptimeString => true,
        _ => cond(
          require_exact => false,
          true => match(
            expected,
            .Str => true,
            .Pointer(einner) => cond(
              is_u8_type(einner) => true,
              is_char_type(einner) => true,
              true => false
            ),
            _ => false
          )
        )
      )
    );
  });
  // --- C-compatible types ---------------------------------------------------
  if(is_c_compatible_type(actual), {
    if(!(is_c_compatible_type(expected)), {
      return(false);
    });
    return(type_value_tag(actual) == type_value_tag(expected));
  });
  // --- SomeType vs DynType --------------------------------------------------
  // A DynType is compatible with a SomeType parameter. If the SomeType has
  // required traits (e.g. `Self <: ToString` introduced by a where-clause),
  // each must be satisfied by some trait the DynType carries. This lets a
  // `dyn(Error)` receiver match a `Self`-constrained `self` param when the
  // dyn's required traits (incl. expanded supertraits) cover the constraint.
  // Checked before the tag-mismatch guard since the tags differ.
  // Mirrors `areTypesCompatible` (src/types/compatibility.ts:662-684).
  if(is_some_type(actual) && is_dyn_type(expected), {
    artt := match(
      actual,
      .SomeT(required_trait_types : rtt) => rtt,
      _ => ArrayList(TypeValue).new()
    );
    drtt := match(
      expected,
      .DynT(required_trait_types : rtt) => rtt,
      _ => ArrayList(TypeValue).new()
    );
    i := usize(0);
    while(i < artt.len(), {
      req := match(artt.get(i),.Some(v) => v,.None => TypeValue.Unit);
      satisfied := false;
      j := usize(0);
      while(j < drtt.len(), {
        dt := match(drtt.get(j),.Some(v) => v,.None => TypeValue.Unit);
        if(recur(req, dt, false, visited), {
          satisfied = true;
        });
        if(satisfied, {
          break;
        });
        j = (j + usize(1));
      });
      if(!(satisfied), {
        return(false);
      });
      i = (i + usize(1));
    });
    return(true);
  });
  // --- DynType (actual) vs SomeType (expected) ------------------------------
  // The mirror of the rule above, for the (actual, expected) arg order used
  // by `_filter_receiver_methods` (`are_types_compatible(receiver, pointee)`):
  // a `Dyn(Trait)` RECEIVER must satisfy a `Self`-constrained pointee `*(Self)`
  // so the filter flags `needs_pointer_conversion` and the call site addresses
  // it. Maps to TS `areTypesCompatible(expected=SomeType, given=Dyn)`
  // (compatibility.ts:662-684) — yo-self's actual≈given. Without it, a dyn
  // method call (`value.print()` on `value : Dyn(TestDyn)`, self : `*(Self)`)
  // synthesized `*(Self)` vs the bare `dyn(...)` arg and failed the
  // tag-mismatch guard (tests/dyn.test.yo).
  if(is_dyn_type(actual) && is_some_type(expected), {
    erts := match(
      expected,
      .SomeT(required_trait_types : rtt) => rtt,
      _ => ArrayList(TypeValue).new()
    );
    adrtt := match(
      actual,
      .DynT(required_trait_types : rtt) => rtt,
      _ => ArrayList(TypeValue).new()
    );
    i := usize(0);
    while(i < erts.len(), {
      req := match(erts.get(i),.Some(v) => v,.None => TypeValue.Unit);
      satisfied := false;
      j := usize(0);
      while(j < adrtt.len(), {
        dt := match(adrtt.get(j),.Some(v) => v,.None => TypeValue.Unit);
        if(recur(req, dt, false, visited), {
          satisfied = true;
        });
        if(satisfied, {
          break;
        });
        j = (j + usize(1));
      });
      if(!(satisfied), {
        return(false);
      });
      i = (i + usize(1));
    });
    return(true);
  });
  // --- Concrete (actual) vs SomeType (expected) ------------------------------
  // Mirrors TS compatibility.ts:800-828 ("Given is a concrete type, expected is
  // SomeType"): an UNCONSTRAINED SomeType (bare forall param, e.g. a ctl
  // handler's free `ResumeType`) accepts ANY concrete type — non-exact only
  // (exact/cache comparisons keep them distinct, like TS's requireExactMatch
  // branch). A CONSTRAINED SomeType accepts a concrete type that implements ALL
  // its required traits (`typeImplementsTraitBool`, routed through the hook
  // above). Without this rule every concrete-vs-SomeT pair fell to the
  // tag-mismatch guard below: a match/cond arm evaluated under a
  // constrained-SomeT expected type (the prelude `(!)` operator module's
  // `_Self : (LogicalNot)` param during overload trials) threw "Incompatible
  // type with expected type", and a throw-arm's free `ResumeType` refused to
  // unify with a concrete sibling arm — both def-time body-eval halts (stage-2
  // "Failed to transpile" holes).
  if(((!(require_exact)) && is_some_type(expected)) && !(is_some_type(actual)), {
    erts2 := match(
      expected,
      .SomeT(required_trait_types : rtt2) => rtt2,
      _ => ArrayList(TypeValue).new()
    );
    if(erts2.len() == usize(0), {
      return(true);
    });
    match(
      g_compat_type_implements_trait_fn,
      .Some(impl_check) => {
        (all_ok : bool) = true;
        (ri2 : usize) = usize(0);
        while((ri2 < erts2.len()) && all_ok, {
          req2 := match(erts2.get(ri2),.Some(v) => v,.None => TypeValue.Unit);
          if(!(impl_check(actual, req2)), {
            all_ok = false;
          });
          ri2 = (ri2 + usize(1));
        });
        if(all_ok, {
          return(true);
        });
      },
      .None => ()
    );
  });
  // --- Empty struct == unit (non-exact) -------------------------------------
  // `{}` parses to the `_()` anon-struct literal (BK_ANON_STRUCT) — a 0-field,
  // zero-size value used as a no-op match/cond arm (`.None => {}` / `_ => {}`).
  // It must unify with a `()`/unit sibling arm. TS accepts this (verified:
  // `./yo-cli compile` accepts `match(.Some(x) => (), .None => {})`); without
  // this rule the tag-mismatch guard below rejects unit-vs-empty-struct, so
  // every empty-`{}` arm paired with a unit sibling throws "Incompatible types"
  // at def-time and loses the match's ExprInfo -> "Failed to transpile" marker.
  // Exact compatibility (cache keys) stays strict (different tags). See
  // issues/yo-self-p1-transpile-tail.md (arm-type / Incompatible-types cluster).
  if(!(require_exact), {
    unit_empty_struct := match(
      actual,
      .Unit => match(expected,.Struct({ field_types : eft }) => (eft.len() == usize(0)), _ => false),
      .Struct({ field_types : aft }) => match(expected,.Unit => (aft.len() == usize(0)), _ => false),
      _ => false
    );
    if(unit_empty_struct, {
      return(true);
    });
  });
  // --- Tag mismatch ---------------------------------------------------------
  if(type_value_tag(actual) != type_value_tag(expected), {
    return(false);
  });
  // --- Main structural match ------------------------------------------------
  match(
    actual,
    // Primitives
    .Unit => match(expected,.Unit => true, _ => false),
    .BoolT => match(expected,.BoolT => true, _ => false),
    .Void => match(expected,.Void => true, _ => false),
    .Usize => match(expected,.Usize => true, _ => false),
    .Isize => match(expected,.Isize => true, _ => false),
    .Str => match(expected,.Str => true, _ => false),
    .ComptimeInt => match(expected,.ComptimeInt => true, _ => false),
    .ComptimeFloat => match(expected,.ComptimeFloat => true, _ => false),
    .ComptimeString => match(expected,.ComptimeString => true, _ => false),
    .Int(abits, asigned) => match(
      expected,
      .Int(ebits, esigned) => ((abits == ebits) && (asigned == esigned)),
      _ => false
    ),
    .Float(abits) => match(
      expected,
      .Float(ebits) => (abits == ebits),
      _ => false
    ),
    .TypeUni(alvl) => match(
      expected,
      .TypeUni(elvl) => (alvl == elvl),
      _ => false
    ),
    // Pointer children always use require_exact=true (TS semantics)
    .Pointer(ainner) => match(
      expected,
      .Pointer(einner) => recur(ainner, einner, true, visited),
      _ => false
    ),
    .Array(ainner, alen, alvar) => match(
      expected,
      .Array(einner, elen, elvar) => {
        // Variable-length arrays (forall `U : usize` patterns) are
        // length-compatible with anything; concrete lengths must match.
        len_ok := cond(
          ((alvar.len() > usize(0)) || (elvar.len() > usize(0))) => true,
          true => (alen == elen)
        );
        len_ok && recur(ainner, einner, require_exact, visited)
      },
      _ => false
    ),
    .Tuple(alabels, atypes) => match(
      expected,
      .Tuple(elabels, etypes) => {
        n := atypes.len();
        if(n != etypes.len(), {
          return(false);
        });
        i := usize(0);
        while(i < n, {
          at := match(atypes.get(i),.Some(v) => v,.None => TypeValue.Unit);
          et := match(etypes.get(i),.Some(v) => v,.None => TypeValue.Unit);
          al := match(alabels.get(i),.Some(v) => v,.None => ``);
          el := match(elabels.get(i),.Some(v) => v,.None => ``);
          if(al != el, {
            return(false);
          });
          if(!(recur(at, et, require_exact, visited)), {
            return(false);
          });
          i = (i + usize(1));
        });
        true
      },
      _ => false
    ),
    // Function types: compare forall count, param count, types, return
    .Func({ forall_types : afts, param_types : apts, result : aret }) => match(
      expected,
      .Func({ forall_types : efts, param_types : epts, result : eret }) => {
        if(afts.len() != efts.len(), {
          return(false);
        });
        if(apts.len() != epts.len(), {
          return(false);
        });
        i := usize(0);
        while(i < afts.len(), {
          at := match(afts.get(i),.Some(v) => v,.None => TypeValue.Unit);
          et := match(efts.get(i),.Some(v) => v,.None => TypeValue.Unit);
          if(!(recur(at, et, require_exact, visited)), {
            return(false);
          });
          i = (i + usize(1));
        });
        i = usize(0);
        while(i < apts.len(), {
          at := match(apts.get(i),.Some(v) => v,.None => TypeValue.Unit);
          et := match(epts.get(i),.Some(v) => v,.None => TypeValue.Unit);
          if(!(recur(at, et, require_exact, visited)), {
            return(false);
          });
          i = (i + usize(1));
        });
        recur(aret, eret, require_exact, visited)
      },
      _ => false
    ),
    // Named user types. Non-exact (general compatibility): name-only (Phase 2f).
    // `require_exact` (cache identity — TS `requireExactMatch=true`): compare
    // STRUCTURALLY (equal field labels + recursively-exact field types), with a
    // cycle guard. All yo-self structs carry an empty `name` (struct.yo sets
    // `""`), so name-only would treat ALL anonymous structs as equal — that
    // caused a comptime-fn cache collision where `(?*)(Bucket(String,
    // ArrayList(ME)))` hit a cached `(?*)(ME)` entry (both name=""), collapsing
    // HashMap's `data` field to `?*(ME)`. Structural exact comparison
    // distinguishes them (e.g. labels `[key, value]` vs `[name, kind]`).
    .Struct({ id : aid, name : aname, field_labels : alabels, field_types : atypes, is_reference_semantics : aref, is_atomic_rc : aatomic, is_newtype : anew, constructor_func_id : acfid, type_arguments : ata }) => match(
      expected,
      .Struct({ id : eid, name : ename, field_labels : elabels, field_types : etypes, is_reference_semantics : eref, is_atomic_rc : eatomic, is_newtype : enew, constructor_func_id : ecfid, type_arguments : eta }) => cond(
        // Lenient: name equality, with EMPTY names as wildcards — types
        // reconstructed from values (type_of_eval_value) and pre-stamping
        // instantiations carry "" while `::`-bound types are now STAMPED
        // ("ArgParser" vs ""), and the mixed pair must stay compatible
        // (previously everything was "" so this never arose).
        //
        // Non-exact struct compat. TS (compatibility.ts:288-331) has NO name-only
        // shortcut for structs: it rejects only on field-count / nominal-distinctness
        // and otherwise recurses field types. yo-self's old name-only rule rejected
        // two instantiations of the SAME constructor whose STAMPED names differ —
        // e.g. `Box(V)` (forall placeholder, or a recursive `Box(Self)` field whose
        // name embeds the unresolved `__self_shell`) vs the resolved `Box(<final>)` —
        // even though their fields are compatible. Restore TS behavior: accept the
        // empty-name / equal-name wildcard fast paths, reject only genuinely-distinct
        // nominals (different non-empty names, NO SomeT either side, DIFFERENT
        // constructor_func_id — TS's `functionValue.funcId` check), and otherwise
        // recurse field types (which resolves `__self_shell`s via the EnumT arm and
        // treats a forall SomeT as compatible). See
        // issues/yo-self-recursive-enum-nested-member-shell.md.
        !(require_exact) => cond(
          (((aname == ename) || (aname.len() == usize(0))) || (ename.len() == usize(0))) => true,
          ((!(type_contains_some_type(actual)) && !(type_contains_some_type(expected))) && !((acfid.len() > usize(0)) && (acfid == ecfid))) => false,
          (alabels.len() != elabels.len()) => false,
          true => {
            vkey_ne := ((aid.clone() + String.from("=>ne")) + eid);
            cond(
              _visited_contains(visited, vkey_ne) => true,
              true => {
                visited.push(vkey_ne);
                (ok_ne : bool) = true;
                (si_ne : usize) = usize(0);
                while((si_ne < alabels.len()) && ok_ne, {
                  al_ne := match(alabels.get(si_ne),.Some(v) => v,.None => ``);
                  el_ne := match(elabels.get(si_ne),.Some(v) => v,.None => ``);
                  at_ne := match(atypes.get(si_ne),.Some(v) => v,.None => TypeValue.Unit);
                  et_ne := match(etypes.get(si_ne),.Some(v) => v,.None => TypeValue.Unit);
                  if((al_ne != el_ne) || !(recur(at_ne, et_ne, false, visited)), {
                    ok_ne = false;
                  });
                  si_ne = (si_ne + usize(1));
                });
                ok_ne
              }
            )
          }
        ),
        // DISTINCT generic instantiations: two structs whose concrete
        // `type_arguments` differ are DIFFERENT types even when they share a
        // base `id` (yo-self ids churn) and their `field_types` are still the
        // generic placeholder (`SomeT(T)` in both, so the field comparison below
        // wrongly matches). e.g. `Iter(usize)` vs `Iter(String)` collapsed the
        // specialization cache → one `.next()` served both, its return baked to
        // whichever registered first → "incompatible type". Only fires when BOTH
        // carry non-empty type_arguments of equal length and some arg is
        // exact-incompatible; same-args (same instantiation) falls through to the
        // id/field checks unchanged, so non-generic and identical structs are
        // untouched.
        ({
          (ta_differ : bool) = false;
          if((ata.len() > usize(0)) && (ata.len() == eta.len()), {
            (tai : usize) = usize(0);
            while((tai < ata.len()) && !(ta_differ), {
              at2 := match(ata.get(tai),.Some(v) => v,.None => TypeValue.Unit);
              et2 := match(eta.get(tai),.Some(v) => v,.None => TypeValue.Unit);
              if(!(recur(at2, et2, true, visited)), {
                ta_differ = true;
              });
              tai = (tai + usize(1));
            });
          });
          ta_differ
        }) => false,
        (aid == eid) => true,
        // Self-SHELL identity (exact only): a struct self-shell is an
        // EMPTY-FIELDS, empty-name struct sharing its FINAL's struct_id
        // (struct.yo:76-95) — "distinguished from the final purely by its
        // empty field list". Under exact comparison an empty-fields side must
        // therefore compare by ID ONLY: two different structs' shells are both
        // 0-field ""-named and would wrongly compare STRUCTURALLY EQUAL,
        // colliding the comptime-fn CTFE cache — `Box(Self)` inside the
        // SECOND `ref(struct(... : Option(Box(Self))))` hit the FIRST struct's
        // cached `Box(shell)` entry, so e.g. SuspensionCapturedVariable's
        // `is_owning_the_same_rc_value_as` field emitted as
        // `Option(Box(Variable))` (stage-2 `__yo_t628 → __yo_t114`
        // incompatible-type cluster). TS has no shells — its `Self` IS the
        // final object mutated in place, so a cached Self arg "grows" with the
        // final and never matches another struct's empty in-progress type;
        // id-only comparison for shells is the faithful equivalent of that
        // object identity. (aid == eid already returned true above, so
        // reaching here with an empty side means different ids → distinct.)
        ((atypes.len() == usize(0)) || (etypes.len() == usize(0))) => false,
        // Exact, different ids → structural. But the SEMANTICS KIND must match
        // first: a value `struct`, a reference `object`, an `atomic object`, and
        // a `newtype` with IDENTICAL fields are DISTINCT types. Without this, the
        // comptime-fn CTFE cache (keyed via `are_types_compatible_exact`) collides
        // them — e.g. `Type.impls(AtomicPoint, Send)` and
        // `Type.impls(RegularPoint, Send)` over `object(x:i32,y:i32)` share a cache
        // entry, so the second query returns the first's result.
        (((aref != eref) || (aatomic != eatomic)) || (anew != enew)) => false,
        // NOMINAL distinctness (mirrors TS compatibility.ts:288-306): two structs
        // with DIFFERENT non-empty names are DISTINCT types under exact match,
        // UNLESS either contains a SomeT (a specialization placeholder). yo-self's
        // struct `id` churns across generic instantiations (no stable funcId), so
        // the stamped NAME is the nominal identity here — same-named instantiations
        // (Box(i32) vs Box(String)) and ""-named reconstructions still fall through
        // to the structural field comparison below. Without this, CodegenTypeEntry
        // vs CodegenExternFnEntry (identical fields, distinct names) collided in the
        // comptime-fn CTFE cache, collapsing HashMap(_, CodegenTypeEntry).values()
        // and HashMap(_, CodegenExternFnEntry).values() to one instantiation.
        ((((aname.len() != usize(0)) && (ename.len() != usize(0))) && (aname != ename)) && ((!(type_contains_some_type(actual))) && (!(type_contains_some_type(expected))))) => false,
        // SAME-NAMED DISTINCT DECLARATIONS (mirrors TS requireExactMatch's
        // strict type-ID comparison, helper.ts:2288-2292): reaching here means
        // aid != eid (the id-equality arm above returned true otherwise). Two
        // structs with the SAME non-empty stamped name, different ids, no
        // SomeT on either side and NO type_arguments are DISTINCT
        // declarations — e.g. per-test local `Counter :: struct(...)` in a
        // batched test file. Falling through to the structural tail collided
        // the specialization cache: ONE `ident(T)` spec served both Counters,
        // its param C type from the first and its return from the second
        // (arc.test.yo class). Generic instantiations/copies are untouched:
        // instantiations carry type_arguments, and cfid-empty copies SHARE
        // their original's id (caught by the id-equality arm). See
        // issues/yo-self-same-name-local-struct-spec-cache-collision.md.
        (((aname.len() != usize(0)) && (aname == ename)) && (((ata.len() == usize(0)) && (eta.len() == usize(0))) && ((!(type_contains_some_type(actual))) && (!(type_contains_some_type(expected)))))) => false,
        (alabels.len() != elabels.len()) => false,
        true => {
          vkey := ((aid.clone() + String.from("=>")) + eid);
          cond(
            _visited_contains(visited, vkey) => true,
            true => {
              visited.push(vkey);
              (ok : bool) = true;
              (si : usize) = usize(0);
              while((si < alabels.len()) && ok, {
                al := match(alabels.get(si),.Some(v) => v,.None => ``);
                el := match(elabels.get(si),.Some(v) => v,.None => ``);
                at := match(atypes.get(si),.Some(v) => v,.None => TypeValue.Unit);
                et := match(etypes.get(si),.Some(v) => v,.None => TypeValue.Unit);
                if((al != el) || !(recur(at, et, true, visited)), {
                  ok = false;
                });
                si = (si + usize(1));
              });
              ok
            }
          )
        }
      ),
      _ => false
    ),
    .EnumT(_, _, _, _, _, _, _, _, _) => match(
      // Resolve empty-variant Self shells (enum.yo) to their finalized
      // forms before comparing — pointer/exact children otherwise see a
      // 0-variant shell vs the real enum (`*(JsonValue)` vs
      // `*(<enum:..__self_shell>)`, std/encoding/json.yo).
      resolve_enum_shell(actual),
      .EnumT(aid, aname, avns, avfs, _, avls, _, _, _) => match(
        resolve_enum_shell(expected),
        // Non-exact keeps the empty-name wildcard rule ("TomlValue" vs a
        // ""-named reconstruction of the same enum). Under `require_exact`
        // (cache identity), name-only is unsound for the same reason as the
        // Struct arm: all yo-self enums carry an empty name, so e.g. the
        // CTFE cache key `Option(JsonValue)` matched a stale `Option(T)`
        // entry and returned `Option(Option(T))` (std/encoding/json.yo).
        // Mirror TS compatibility.ts:344-399: equal ids → true; otherwise
        // compare variant names, field labels, and field types exactly,
        // with the same cycle guard as the Struct arm.
        .EnumT(eid, ename, evns, evfs, _, evls, _, _, _) => cond(
          !(require_exact) => (((aname == ename) || (aname.len() == usize(0))) || (ename.len() == usize(0))),
          (aid == eid) => true,
          (avns.len() != evns.len()) => false,
          true => {
            vkey := ((aid.clone() + String.from("=>")) + eid);
            cond(
              _visited_contains(visited, vkey) => true,
              true => {
                visited.push(vkey);
                (ok : bool) = true;
                (vi : usize) = usize(0);
                while((vi < avns.len()) && ok, {
                  avn := match(avns.get(vi),.Some(v) => v,.None => ``);
                  evn := match(evns.get(vi),.Some(v) => v,.None => ``);
                  if(avn != evn, {
                    ok = false;
                  });
                  if(ok, {
                    afl := match(avfs.get(vi),.Some(v) => v,.None => ArrayList(TypeValue).new());
                    efl := match(evfs.get(vi),.Some(v) => v,.None => ArrayList(TypeValue).new());
                    all := match(avls.get(vi),.Some(v) => v,.None => ArrayList(String).new());
                    ell := match(evls.get(vi),.Some(v) => v,.None => ArrayList(String).new());
                    if(afl.len() != efl.len(), {
                      ok = false;
                    }, {
                      (fi : usize) = usize(0);
                      while((fi < afl.len()) && ok, {
                        at := match(afl.get(fi),.Some(v) => v,.None => TypeValue.Unit);
                        et := match(efl.get(fi),.Some(v) => v,.None => TypeValue.Unit);
                        al := match(all.get(fi),.Some(v) => v,.None => ``);
                        el := match(ell.get(fi),.Some(v) => v,.None => ``);
                        if((al != el) || !(recur(at, et, true, visited)), {
                          ok = false;
                        });
                        fi = (fi + usize(1));
                      });
                    });
                  });
                  vi = (vi + usize(1));
                });
                ok
              }
            )
          }
        ),
        _ => false
      ),
      _ => false
    ),
    .Union(aname, _, _) => match(
      expected,
      .Union(ename, _, _) => (((aname == ename) || (aname.len() == usize(0))) || (ename.len() == usize(0))),
      _ => false
    ),
    // TraitT: nominal comparison; FnTraitT/FutureTraitT: structural
    .TraitT(name : aname) => match(
      expected,
      .TraitT(name : ename) => (aname == ename),
      _ => false
    ),
    // SomeT: name + frame_level identity (Phase 2f: no env resolution)
    .SomeT(name : aname, frame_level : alvl) => match(
      expected,
      .SomeT(name : ename, frame_level : elvl) => ((aname == ename) && (alvl == elvl)),
      _ => false
    ),
    // -----------------------------------------------------------------------
    // Phase 2f variants
    // -----------------------------------------------------------------------
    .ExprT => match(expected,.ExprT => true, _ => false),
    .ComptimeListT(achild) => match(
      expected,
      .ComptimeListT(echild) => recur(achild, echild, require_exact, visited),
      _ => false
    ),
    .EffectsRowT(implicit_labels : als, implicit_types : ats) => match(
      expected,
      .EffectsRowT(implicit_labels : els, implicit_types : ets) => {
        if(als.len() != els.len(), {
          return(false);
        });
        i := usize(0);
        while(i < als.len(), {
          al := match(als.get(i),.Some(v) => v,.None => ``);
          el := match(els.get(i),.Some(v) => v,.None => ``);
          at := match(ats.get(i),.Some(v) => v,.None => TypeValue.Unit);
          et := match(ets.get(i),.Some(v) => v,.None => TypeValue.Unit);
          if(al != el, {
            return(false);
          });
          if(!(recur(at, et, require_exact, visited)), {
            return(false);
          });
          i = (i + usize(1));
        });
        true
      },
      _ => false
    ),
    .TypeAppT(constructor : acon, args : aargs) => match(
      expected,
      .TypeAppT(constructor : econ, args : eargs) => {
        // Both constructors must be SomeT and share the same unique ID
        acid_valid := match(acon,.SomeT(id : _) => true, _ => false);
        ecid_valid := match(econ,.SomeT(id : _) => true, _ => false);
        if((!(acid_valid)) || (!(ecid_valid)), {
          return(false);
        });
        acid := match(acon,.SomeT(id : cid) => cid, _ => ``);
        ecid := match(econ,.SomeT(id : cid) => cid, _ => ``);
        if(acid != ecid, {
          return(false);
        });
        if(aargs.len() != eargs.len(), {
          return(false);
        });
        i := usize(0);
        while(i < aargs.len(), {
          at := match(aargs.get(i),.Some(v) => v,.None => TypeValue.Unit);
          et := match(eargs.get(i),.Some(v) => v,.None => TypeValue.Unit);
          if(!(recur(at, et, require_exact, visited)), {
            return(false);
          });
          i = (i + usize(1));
        });
        true
      },
      _ => false
    ),
    .IsoT(achild) => match(
      expected,
      .IsoT(echild) => recur(achild, echild, require_exact, visited),
      _ => false
    ),
    // DynT: subset-based — all expected required traits must appear in actual;
    // none of expected's negative traits may appear in actual's required traits.
    .DynT(required_trait_types : artt, required_trait_levels : _, negative_trait_types : antt, negative_trait_levels : _) =>
      match(
        expected,
        .DynT(required_trait_types : ertt, negative_trait_types : entt) => {
          i := usize(0);
          while(i < ertt.len(), {
            et := match(ertt.get(i),.Some(v) => v,.None => TypeValue.Unit);
            found := false;
            j := usize(0);
            while(j < artt.len(), {
              at := match(artt.get(j),.Some(v) => v,.None => TypeValue.Unit);
              if(recur(et, at, require_exact, visited), {
                found = true;
              });
              if(found, {
                break;
              });
              j = (j + usize(1));
            });
            if(!(found), {
              return(false);
            });
            i = (i + usize(1));
          });
          i = usize(0);
          while(i < entt.len(), {
            et := match(entt.get(i),.Some(v) => v,.None => TypeValue.Unit);
            j := usize(0);
            while(j < artt.len(), {
              at := match(artt.get(j),.Some(v) => v,.None => TypeValue.Unit);
              if(recur(et, at, require_exact, visited), {
                return(false);
              });
              j = (j + usize(1));
            });
            i = (i + usize(1));
          });
          true
        },
        _ => false
      ),
    // FnTraitT: structural — same base_name, pairwise params, compatible result
    .FnTraitT(base_name : abn, call_param_types : apts, call_result : aret) => match(
      expected,
      .FnTraitT(base_name : ebn, call_param_types : epts, call_result : eret) => {
        if(abn != ebn, {
          return(false);
        });
        if(apts.len() != epts.len(), {
          return(false);
        });
        i := usize(0);
        while(i < apts.len(), {
          at := match(apts.get(i),.Some(v) => v,.None => TypeValue.Unit);
          et := match(epts.get(i),.Some(v) => v,.None => TypeValue.Unit);
          if(!(recur(at, et, require_exact, visited)), {
            return(false);
          });
          i = (i + usize(1));
        });
        recur(aret, eret, require_exact, visited)
      },
      _ => false
    ),
    // FutureTraitT: same base_name, compatible output, order-independent effects
    .FutureTraitT(base_name : abn, output : aout, effect_labels : aels, effect_types : aets, effect_spreads : aesp) =>
      match(
        expected,
        .FutureTraitT(base_name : ebn, output : eout, effect_labels : eels, effect_types : eets, effect_spreads : eesp) => {
          if(abn != ebn, {
            return(false);
          });
          if(!(recur(aout, eout, require_exact, visited)), {
            return(false);
          });
          flat_a_labels := ArrayList(String).new();
          flat_a_types := ArrayList(TypeValue).new();
          flat_e_labels := ArrayList(String).new();
          flat_e_types := ArrayList(TypeValue).new();
          _flatten_effects(aels, aets, aesp, flat_a_labels, flat_a_types);
          _flatten_effects(eels, eets, eesp, flat_e_labels, flat_e_types);
          // Backward compat: empty effects on either side → compatible
          if((flat_a_types.len() == usize(0)) || (flat_e_types.len() == usize(0)), {
            return(true);
          });
          if(flat_a_types.len() != flat_e_types.len(), {
            return(false);
          });
          // Order-independent set matching
          used := ArrayList(usize).new();
          ei := usize(0);
          while(ei < flat_e_types.len(), {
            et := match(flat_e_types.get(ei),.Some(v) => v,.None => TypeValue.Unit);
            el := match(flat_e_labels.get(ei),.Some(v) => v,.None => ``);
            found := false;
            ai := usize(0);
            while(ai < flat_a_types.len(), {
              if(!(_is_in_used(used, ai)), {
                at := match(flat_a_types.get(ai),.Some(v) => v,.None => TypeValue.Unit);
                al := match(flat_a_labels.get(ai),.Some(v) => v,.None => ``);
                if((al == el) && recur(et, at, require_exact, visited), {
                  used.push(ai);
                  found = true;
                });
              });
              if(found, {
                break;
              });
              ai = (ai + usize(1));
            });
            if(!(found), {
              return(false);
            });
            ei = (ei + usize(1));
          });
          true
        },
        _ => false
      ),
    _ => false
  )
});
// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------
are_types_compatible :: (fn(actual : TypeValue, expected : TypeValue) -> bool)(
  _compat_impl(actual, expected, false, ArrayList(String).new())
);
are_types_compatible_exact :: (fn(actual : TypeValue, expected : TypeValue) -> bool)(
  _compat_impl(actual, expected, true, ArrayList(String).new())
);
are_function_types_compatible :: (fn(actual : TypeValue, expected : TypeValue) -> bool)(
  _compat_impl(actual, expected, false, ArrayList(String).new())
);
export(are_types_compatible, are_types_compatible_exact, are_function_types_compatible, set_compat_type_implements_trait_fn);
