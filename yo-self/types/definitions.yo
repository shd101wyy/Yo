//! TypeValue — the central representation of types in the Yo type system.
//!
//! Mirrors `src/types/definitions.ts` but uses a Yo `enum` with per-variant
//! data instead of the TS fat-node interface. See `plans/BOOTSTRAPPING.md`
//! § "Architecture Decisions / 2. Type representation".
//!
//! Notes:
//!   * Fixed-width integers are encoded as `Int(bits, signed)`. Pointer-sized
//!     integers (`usize`/`isize`) and C-compatible types (whose width is
//!     platform-dependent) get their own variants.
//!   * Compound variants store children via `Box(Self)` to allow recursion.
//!   * Tuple/Struct field types are stored as parallel `ArrayList`s so we
//!     don't need a separate mutually-recursive struct (which would require
//!     a forward-reference dance during evaluation).
//!   * Generic / unresolved type information (`SomeType`, `TypeApplication`,
//!     `EffectsRow`, traits with associated types, …) is intentionally kept
//!     minimal in this iteration — Phase 2b will fill in the details.
//!
//! Phase A.3.3: this file holds the TypeValue enum only. Type constructors
//! (`t_unit`, `t_some_t`, …) and `type_value_tag` live in `creators.yo`.
//! Variant-shape predicates (`is_int_type`, …) live in `guards.yo`.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
/// The Yo type universe.
TypeValue :: enum(
  // Primitive value types ---------------------------------------------------
  Unit,
  BoolT,
  Void,
  /// `str` — builtin immutable fat-pointer view of STATIC string bytes.
  /// Mirrors TS `StrType` (tag TypeTag.Str, fieldless). C lowering:
  /// `typedef struct { const uint8_t* ptr; size_t len; } __yo_str;`
  Str,
  /// Fixed-width integer. `bits` ∈ {8, 16, 32, 64}; `signed` distinguishes
  /// `iN` vs `uN`.
  Int(bits : u8, signed : bool),
  /// Floating-point. `bits` ∈ {32, 64}.
  Float(bits : u8),
  /// Pointer-sized unsigned integer.
  Usize,
  /// Pointer-sized signed integer.
  Isize,
  // Compile-time numeric / string types -------------------------------------
  ComptimeInt,
  ComptimeFloat,
  ComptimeString,
  // C-compatible types (platform-dependent width) ---------------------------
  CChar,
  CShort,
  CUShort,
  CInt,
  CUInt,
  CLong,
  CULong,
  CLongLong,
  CULongLong,
  CLongDouble,
  // Type universes ---------------------------------------------------------
  /// `Type`, `Type(1)`, `Type(2)`, …  `level` ∈ {0,1,2,…}.
  TypeUni(level : usize),
  // Compound types ---------------------------------------------------------
  Pointer(pointee : Box(Self)),
  /// `length_var` mirrors the VALUE-ness of TS `ArrayType.length: Value`:
  /// "" = `length` is the concrete element count; non-empty = the length is
  /// an unresolved forall VARIABLE of that name (e.g. the `U` in
  /// `impl(forall(T : Type, U : usize), Array(T, U), ...)`) and `length`
  /// is a meaningless placeholder. TS stores an UnknownValue carrying
  /// `variableName` and binds it during synthesis (synthesizer.ts:884).
  Array(element : Box(Self), length : usize, length_var : String),
  /// Anonymous tuple. `field_labels(i)` is the optional label for the i-th
  /// field (empty `String` means positional). `field_types(i)` is the type.
  Tuple(field_labels : ArrayList(String), field_types : ArrayList(Self)),
  /// Function type. Phase 2b: forall type-vars, implicit (using) params,
  /// effect-row-spread flags, and where-clause constraint types.
  Func(
    forall_labels : ArrayList(String),
    // forall type-var names
    forall_types : ArrayList(Self),
    // forall type-var kinds (usually TypeUni)
    param_labels : ArrayList(String),
    // normal parameter labels
    param_types : ArrayList(Self),
    // normal parameter types
    implicit_labels : ArrayList(String),
    // ... parameter labels
    implicit_types : ArrayList(Self),
    // ... parameter types
    implicit_spreads : ArrayList(bool),
    // isEffectRowSpread flags
    where_types : ArrayList(Self),
    // where-clause constraint types
    result : Box(Self),
    // return type
    /// Mirrors `FunctionType.return.isCompileTimeOnly` in
    /// `src/types/definitions.ts` (TS models the return as a
    /// `FunctionParameter { type, isCompileTimeOnly, … }`; yo-self flattened
    /// that to a bare `result`, so this restores the one bit the CTFE gate
    /// needs). True when the declared return is `comptime(...)` — i.e. the
    /// function is a compile-time-only function (a type constructor, macro,
    /// or comptime-value producer). `helper.ts:1731` gates CTFE on this; the
    /// FuncVal-call delegation + `evaluate_comptime_fn_call`'s `should_cache`
    /// use it so type-constructor calls whose return RESOLVED to a concrete
    /// struct (not bare `Type`) are still routed through memoization.
    result_is_comptime_only : bool,
    /// Per-parameter `ref` flags, parallel to `param_labels`/`param_types`.
    /// `param_is_ref(i)` is true when the i-th parameter was declared
    /// `ref(name) : T` (a by-reference borrow). Mirrors
    /// `FunctionParameter.isRef` in `src/types/definitions.ts` (yo-self
    /// flattened FunctionParameter to parallel arrays, so this restores the
    /// `isRef` bit). Used by `is_flowable_expr` (the `ref(T)`-flow soundness
    /// check). Empty/all-false for functions with no `ref` parameters.
    param_is_ref : ArrayList(bool),
    /// Per-parameter `own` flags, parallel to param_labels/param_types.
    /// `param_is_owning(i)` is true when the i-th parameter was declared
    /// `own(name) : T` (the callee takes ownership of the Rc value). Mirrors
    /// `FunctionParameter.isOwningTheRcValue`. Used by
    /// `require_ref_own_argument_exclusivity` to reject calls that pass the
    /// same object as both a ref-rooted and an own argument.
    param_is_owning : ArrayList(bool),
    /// True when the return type was declared `-> ref(T)` (a by-reference
    /// return borrow). Mirrors `FunctionType.return.isRef`. Used by
    /// `is_flowable_expr` to require the return expression be flowable.
    result_is_ref : bool,
    /// True when the parameter list ends with a `...` variadic marker
    /// (C-style variadic externs like `snprintf`). Mirrors
    /// `FunctionType.variadicParameter` in `src/types/definitions.ts`
    /// (yo-self restores just the presence bit; the variadic parameter's
    /// optional type annotation is not yet carried). The call-site
    /// argument-count check is skipped when set (TS helper.ts:965
    /// `if (!functionType.variadicParameter)`).
    has_variadic : bool,
    /// FFI language tag when this function was declared inside an
    /// `extern "c"`/`extern "yo"` block or a `c_include(...)` (mirrors
    /// `FunctionType.isExtern: ExternLanguage` in `src/types/definitions.ts`).
    /// `Some("c")`/`Some("yo")` for FFI symbols, `None` for ordinary Yo
    /// functions. Set by `evaluate_extern`/`evaluate_c_include` on the field
    /// type (mirrors `extern.ts:138-161`). Read by the extern-call
    /// `unsafe(...)` gate in `calls/function.yo` (plans/EXTERN_UNSAFE_WRAP.md):
    /// a call to an `is_extern == Some("c")` function outside `unsafe(...)`
    /// and outside an auto-generated expansion is rejected. (The original
    /// port dropped this as "codegen-only" — wrong: the gate lives in the
    /// evaluator call path, not codegen.)
    is_extern : Option(String),
    /// The FFI symbol name to bind, when known (mirrors
    /// `FunctionType.externName`). `Some(field.label)` for extern function
    /// declarations, `None` otherwise. Used only for the gate's diagnostic
    /// message (the call-site falls back to the printed callee expression
    /// when this is `None`).
    extern_name : Option(String),
    /// True when this is a `ctl(...) -> ret` control-function type (declared
    /// with the `ctl` constructor instead of `fn`). Mirrors
    /// `FunctionType.isControl` in `src/types/definitions.ts`. A `ctl` value
    /// is FRAME-BOUND — its body may `unwind` out of the enclosing install
    /// frame — so it must not escape (be stored at module level, captured by a
    /// closure, or have a pointer formed to it). Read by `type_is_control_bound`
    /// (types/utils.yo) and the §4 escape-boundary checks (the algebraic-effect
    /// ctl rules). A plain `fn(...)` whose params/return merely reference `ctl`
    /// is NOT control-bound — only the `ctl` value itself carries the CF.
    is_control : bool
  ),
  // Named user-defined types ------------------------------------------------
  /// `id` uniquely identifies this struct definition (mirrors `StructType.id`
  /// in `src/types/definitions.ts`).  Set to `""` for types reconstructed
  /// from runtime values via `type_of_eval_value`.
  /// `is_reference_semantics` = true for `object(...)`, false for `struct(...)`.
  /// `is_atomic_rc` = true for `atomic object(...)`.
  /// `is_newtype` = true for `newtype(...)`.
  /// `constructor_func_id` mirrors `StructType.functionValue` in
  /// `src/types/definitions.ts:222`: the `funcId` of the comptime
  /// type-constructor that produced this type (set at the comptime-fn call
  /// site, `src/evaluator/calls/comptime-fn.ts:274`). The synthesizer uses
  /// it to unify two instantiations of the SAME generic constructor
  /// (`src/evaluator/types/synthesizer.ts:662` compares `functionValue.funcId`).
  /// `""` = unknown origin (mirrors TS `functionValue` being optional).
  /// Only the `funcId` is stored, not the whole `FunctionValue`, because
  /// `TypeValue` (this module) cannot import `EvalValue` (`value.yo`) without
  /// a cycle — and `funcId` is the only part the synthesizer reads.
  Struct(
    id : String,
    name : String,
    field_labels : ArrayList(String),
    field_types : ArrayList(Self),
    is_reference_semantics : bool,
    is_atomic_rc : bool,
    is_newtype : bool,
    constructor_func_id : String,
    /// Concrete type arguments of a generic instantiation, in constructor-
    /// parameter order (`HashMap(String, String)` → `[String, String]`). Empty
    /// for non-generic or not-yet-instantiated structs. Faithful stand-in for
    /// `StructType.env` (TS carries the instantiation env): a method dispatched
    /// on this struct binds its `forall` params positionally from here. See
    /// plans/STRUCT_TYPE_ARGUMENTS.md.
    type_arguments : ArrayList(Self),
    /// True for source-namespace structs — anonymous modules (`impl({...})`,
    /// extern blocks) and imported modules. Mirrors TS
    /// `StructType.isSourceNamespace` (`SourceNamespaceType`,
    /// src/types/definitions.ts:514-518): TS has NO separate module type;
    /// modules ARE structs with this marker. See
    /// plans/MODULE_AS_STRUCT_ALIGNMENT.md.
    is_source_namespace : bool
  ),
  /// `EnumT` rather than `Enum` to avoid clashing with the keyword.
  /// Each variant has a name and an `ArrayList` of field types (possibly empty).
  /// `selected_variant_name` is set when the type has been narrowed to a specific
  /// variant (e.g. after pattern matching or destructuring).
  /// Mirrors `EnumType.selectedVariantName` in `src/types/definitions.ts`.
  /// `variant_field_labels` holds the per-variant label names in declaration
  /// order — used by labeled destructuring and match (Phase 2ae+).
  /// `id` uniquely identifies this enum definition (mirrors `EnumType.id`).
  /// `variant_discriminants` holds one discriminant value per variant (in order).
  /// Mirrors `EnumVariant.discriminant` in `src/types/definitions.ts`.
  EnumT(
    id : String,
    name : String,
    variant_names : ArrayList(String),
    variant_fields : ArrayList(ArrayList(Self)),
    selected_variant_name : Option(String),
    variant_field_labels : ArrayList(ArrayList(String)),
    variant_discriminants : ArrayList(i64)
  ),
  Union(
    name : String,
    field_labels : ArrayList(String),
    field_types : ArrayList(Self)
  ),
  // Traits / modules --------------------------------------------------------
  /// Named trait type. Phase 2b: associated type names and method/field list.
  /// Phase 2aq: `id` for unique identity, `is_concrete` for `Concrete(T)` marker
  /// (mirrors TypeScript `TraitType.id` and `TraitType.isConcrete`).
  /// Phase 2az: `self_constraints` and `neg_self_constraints` mirror
  /// TypeScript `TraitType.selfConstraints` / `TraitType.negativeSelfConstraints`.
  TraitT(
    name : String,
    assoc_type_names : ArrayList(String),
    // names of associated type members
    field_labels : ArrayList(String),
    // method / field names
    field_types : ArrayList(Self),
    // method / field types
    id : String,
    // unique identity string
    is_concrete : Option(Box(Self)),
    // Some(T) when this is `Concrete(T)`
    self_constraints : ArrayList(Self),
    // where-clause constraints on Self
    neg_self_constraints : ArrayList(Self) // negative where-clause constraints on Self
  ),
  // Generic / unresolved ----------------------------------------------------
  /// A `SomeType` introduced by `forall` or by a yet-to-be-resolved generic
  /// parameter. `frame_level` is the env frame at which it was introduced.
  /// Phase 2b: required and negative trait constraint lists.
  /// Phase 2d: `id` for unique identity (mirrors TypeScript SomeType.id).
  /// Phase 2e: `parent_type` — the meta-type of this type variable (usually TypeUni(0)).
  ///           Mirrors TypeScript `SomeType.parentType`.
  SomeT(
    id : String,
    // unique identity string
    name : String,
    frame_level : usize,
    parent_type : Box(Self),
    // meta-type (TypeUni(0) by default)
    required_trait_types : ArrayList(Self),
    // required trait constraints
    required_trait_levels : ArrayList(usize),
    // frame-level of each constraint
    negative_trait_types : ArrayList(Self),
    // negative trait constraints
    negative_trait_levels : ArrayList(usize),
    // frame-level of each negative constraint
    is_effects_row : bool,
    // true when this SomeType represents an effect-row spread `E : Type.Struct`
    // When present, this SomeT represents a higher-kinded type variable
    // (e.g. `F : (fn(T : Type) -> Type)`). The boxed `Func` TypeValue
    // captures the kind so `F(A)` can be evaluated as a TypeApplication.
    // Mirrors `SomeType.kindFunctionType` in `src/types/definitions.ts:238`.
    kind_function_type : Option(Box(Self))
  ),
  // Phase 2f: advanced type variants ----------------------------------------
  /// The Yo `Expr` type (a quoted expression node).
  ExprT,
  /// A compile-time homogeneous list. `child` is the element type.
  ComptimeListT(child : Box(Self)),
  /// An effects row — labels and types for `...` constraints.
  EffectsRowT(
    implicit_labels : ArrayList(String),
    implicit_types : ArrayList(Self)
  ),
  /// Application of a generic type constructor to arguments.
  /// `constructor` is always a `SomeT` (the type-constructor variable).
  TypeAppT(
    constructor : Box(Self),
    args : ArrayList(Self)
  ),
  /// Iso-wrapped type (linear / unique reference).
  IsoT(child : Box(Self)),
  /// Dynamic-dispatch type with trait bounds.
  DynT(
    required_trait_types : ArrayList(Self),
    required_trait_levels : ArrayList(usize),
    negative_trait_types : ArrayList(Self),
    negative_trait_levels : ArrayList(usize)
  ),
  /// Fn-trait type (Fn / FnMut / FnOnce).
  FnTraitT(
    base_name : String,
    call_param_labels : ArrayList(String),
    call_param_types : ArrayList(Self),
    call_result : Box(Self),
    implicit_labels : ArrayList(String),
    implicit_types : ArrayList(Self),
    implicit_spreads : ArrayList(bool)
  ),
  /// Future-trait type with associated output and effects.
  FutureTraitT(
    base_name : String,
    output : Box(Self),
    effect_labels : ArrayList(String),
    effect_types : ArrayList(Self),
    effect_spreads : ArrayList(bool)
  )
);
// Cycle-aware, SHARE-on-recursion Clone for TypeValue (replaces
// `derive(TypeValue, Clone)`).
//
// The compiler's own `TypeValue` enum is SELF-REFERENTIAL (its variants hold
// `Box(Self)` / `ArrayList(Self)`), so a naive deep clone recurses forever on a
// cyclic value (e.g. a `TypeValue` reached via capture analysis), overflowing the
// stack. It is also ruinously expensive even when finite: during the self-compile,
// the def-time body eval of the compiler's own giant functions stores each expr's
// type into ExprInfo via a clone, and those types are frequently the ~40-variant
// `TypeValue` / `AstExpr` enums — deep-cloning all their variant field types
// thousands of times peaked the unified `main.yo` self-compile at ~10 GB and then
// OOM-killed it (Phase-6 P2; see plans/BOOTSTRAPPING_CODEGEN.md).
//
// Both problems have the SAME fix: the recursive, nested-type collection fields
// (`EnumT.variant_fields`, `Struct.field_types` + `type_arguments`, and `TraitT`'s
// method func types `tft`) are SHARED (RC-bump) rather than deep-cloned.
// `ArrayList` is an RC object, so passing the matched binding straight through
// bumps its refcount instead of deep-copying every element `TypeValue`. This is
// sound because TypeValues are rebuilt-not-mutated: `substitute` and every other
// consumer construct FRESH ArrayLists, and a codebase-wide audit found NO in-place
// mutation of these fields. Sharing also breaks self-reference cycles
// UNCONDITIONALLY — the clone never recurses into the shared fields, and every
// type cycle must pass through a NAMED type (enum/struct/trait), so the former
// path-based cycle guard (`g_tv_clone_path`) is no longer needed. Every
// non-recursive scalar/label field is still cloned (cheap). All OTHER variant arms
// recurse one shallow level, but their `TypeValue` children clone cheaply by the
// same rule. `EvalValue` clones are fixed TRANSITIVELY (its derived clone delegates
// here for `TypeValue` fields).
impl(
  TypeValue,
  Clone(
    clone : (fn(ref(self) : Self) -> Self)(
      match(
        self,
        .Unit => TypeValue.Unit,
        .BoolT => TypeValue.BoolT,
        .Void => TypeValue.Void,
        .Str => TypeValue.Str,
        .Int(ibits, isigned) => TypeValue.Int(ibits, isigned),
        .Float(fbits) => TypeValue.Float(fbits),
        .Usize => TypeValue.Usize,
        .Isize => TypeValue.Isize,
        .ComptimeInt => TypeValue.ComptimeInt,
        .ComptimeFloat => TypeValue.ComptimeFloat,
        .ComptimeString => TypeValue.ComptimeString,
        .CChar => TypeValue.CChar,
        .CShort => TypeValue.CShort,
        .CUShort => TypeValue.CUShort,
        .CInt => TypeValue.CInt,
        .CUInt => TypeValue.CUInt,
        .CLong => TypeValue.CLong,
        .CULong => TypeValue.CULong,
        .CLongLong => TypeValue.CLongLong,
        .CULongLong => TypeValue.CULongLong,
        .CLongDouble => TypeValue.CLongDouble,
        .TypeUni(tlevel) => TypeValue.TypeUni(tlevel),
        .ExprT => TypeValue.ExprT,
        .Pointer(inner) => TypeValue.Pointer(inner.clone()),
        .Array(el, len, lvar) => TypeValue.Array(el.clone(), len, lvar.clone()),
        .Tuple(labels, types) => TypeValue.Tuple(labels.clone(), types.clone()),
        .Func({ forall_labels : fls, forall_types : fts, param_labels : pls, param_types : pts, implicit_labels : ils, implicit_types : its, implicit_spreads : isp, where_types : wts, result : ret, result_is_comptime_only : rico, param_is_ref : pir, param_is_owning : pio, result_is_ref : rir, has_variadic : hv, is_extern : ie, extern_name : en, is_control : ic }) => TypeValue.Func(fls.clone(), fts.clone(), pls.clone(), pts.clone(), ils.clone(), its.clone(), isp.clone(), wts.clone(), ret.clone(), rico, pir.clone(), pio.clone(), rir, hv, ie.clone(), en.clone(), ic),
        // SHARE (RC-bump) `field_types` + `type_arguments` — the recursive
        // nested-type collections — instead of deep-cloning. (See the rationale
        // on the impl above; `ArrayList` is RC, so sharing is a refcount bump and
        // is sound because these fields are rebuilt-not-mutated.)
        .Struct({ id : sid, name : snm, field_labels : sfl, field_types : sft, is_reference_semantics : irs, is_atomic_rc : iar, is_newtype : isnt, constructor_func_id : cfid, type_arguments : sta, is_source_namespace : isns }) =>
          TypeValue.Struct(sid.clone(), snm.clone(), sfl.clone(), sft, irs, iar, isnt, cfid.clone(), sta, isns),
        // SHARE (RC-bump) `variant_fields` — the ArrayList(ArrayList(TypeValue))
        // holding every variant's field types — instead of deep-cloning it. This
        // is the single biggest self-compile win: an expr of type `TypeValue` /
        // `AstExpr` stored its ~40-variant enum type into ExprInfo thousands of
        // times, each formerly a deep clone of all variant field types. (Same
        // RC-share rationale + safety as the impl doc above.)
        .EnumT(eid, enm, evns, evfs, esvn, evfl, edis) =>
          TypeValue.EnumT(eid.clone(), enm.clone(), evns.clone(), evfs, esvn.clone(), evfl.clone(), edis.clone()),
        .Union(unm, ufl, uft) => TypeValue.Union(unm.clone(), ufl.clone(), uft.clone()),
        // SHARE (RC-bump) `tft` — the trait's method func types — instead of
        // deep-cloning. This also subsumes the former self-referential-trait cycle
        // guard (e.g. std `Error`'s `source : fn(self) -> Option(Dyn(Error))`,
        // whose `tft` reaches its own `TraitT` via `Option(Dyn(Error))`). (Same
        // RC-share rationale + safety as the impl doc above.)
        .TraitT(tnm, tatn, tfl, tft, tid, tisc, tsc, tnsc) =>
          TypeValue.TraitT(tnm.clone(), tatn.clone(), tfl.clone(), tft, tid.clone(), tisc.clone(), tsc.clone(), tnsc.clone()),
        .SomeT(smid, snm2, slvl, spt, srtt, srtl, sntt, sntl, sier, skft) => TypeValue.SomeT(smid.clone(), snm2.clone(), slvl, spt.clone(), srtt.clone(), srtl.clone(), sntt.clone(), sntl.clone(), sier, skft.clone()),
        .ComptimeListT(clchild) => TypeValue.ComptimeListT(clchild.clone()),
        .EffectsRowT(erl, ert) => TypeValue.EffectsRowT(erl.clone(), ert.clone()),
        .TypeAppT(tac, taa) => TypeValue.TypeAppT(tac.clone(), taa.clone()),
        .IsoT(isochild) => TypeValue.IsoT(isochild.clone()),
        .DynT(drtt, drtl, dntt, dntl) => TypeValue.DynT(drtt.clone(), drtl.clone(), dntt.clone(), dntl.clone()),
        .FnTraitT(base_name : fnbn, call_param_labels : fncpl, call_param_types : fncpt, call_result : fncr, implicit_labels : fnil, implicit_types : fnit, implicit_spreads : fnisp) => TypeValue.FnTraitT(base_name : fnbn.clone(), call_param_labels : fncpl.clone(), call_param_types : fncpt.clone(), call_result : fncr.clone(), implicit_labels : fnil.clone(), implicit_types : fnit.clone(), implicit_spreads : fnisp.clone()),
        .FutureTraitT(base_name : ftbn, output : ftout, effect_labels : ftel, effect_types : ftet, effect_spreads : ftesp) => TypeValue.FutureTraitT(base_name : ftbn.clone(), output : ftout.clone(), effect_labels : ftel.clone(), effect_types : ftet.clone(), effect_spreads : ftesp.clone())
      )
    )
  )
);
// ---------------------------------------------------------------------------
// Struct per-field compile-time-only flags — side-table (Gap 1).
// ---------------------------------------------------------------------------
/// Side-table: struct id → per-field "is compile-time only" flags, parallel
/// to the `Struct` variant's `field_types`. TS carries this on each
/// `TypeField.isCompileTimeOnly`; yo-self's `Struct` variant has no per-field
/// flag, so codegen's `get_runtime_struct_fields` reads it from here.
/// Populated at struct construction (`evaluator/types/struct.yo`). Structs
/// with no entry (e.g. reconstructed from runtime values, id == "") are
/// treated as all-runtime by the consumer. See
/// issues/codegen-port-type-model-gaps.md Gap 1.
(g_struct_field_comptime_flags : HashMap(String, ArrayList(bool))) =
  HashMap(String, ArrayList(bool)).new();
/// Register the per-field compile-time-only flags for a struct id.
register_struct_field_comptime_flags :: (
  fn(struct_id : String, flags : ArrayList(bool)) -> unit
)({
  ___ := g_struct_field_comptime_flags.set(struct_id.clone(), flags);
  ()
});
/// Get the per-field compile-time-only flags for a struct id (`.None` if the
/// struct was not registered — treat as all-runtime).
get_struct_field_comptime_flags :: (
  fn(struct_id : String) -> Option(ArrayList(bool))
)(
  g_struct_field_comptime_flags.get(struct_id.clone())
);
export(TypeValue, register_struct_field_comptime_flags, get_struct_field_comptime_flags);
