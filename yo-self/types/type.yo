//! TypeValue — the central representation of types in the Yo type system.
//!
//! Mirrors `src/types/definitions.ts` but uses a Yo `enum` with per-variant
//! data instead of the TS fat-node interface. See `plans/BOOTSTRAPPING.md`
//! § "Architecture Decisions / 2. Type representation".
//!
//! Notes:
//!   * Fixed-width integers are encoded as `Int(bits, signed)`. Pointer-sized
//!     integers (`usize`/`isize`) and C-compatible types (whose width is
//!     platform-dependent) get their own variants.
//!   * Compound variants store children via `Box(Self)` to allow recursion.
//!   * Tuple/Struct field types are stored as parallel `ArrayList`s so we
//!     don't need a separate mutually-recursive struct (which would require
//!     a forward-reference dance during evaluation).
//!   * Generic / unresolved type information (`SomeType`, `TypeApplication`,
//!     `EffectsRow`, traits with associated types, …) is intentionally kept
//!     minimal in this iteration — Phase 2b will fill in the details.
open(import("std/string"));
open(import("std/fmt"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeTag } :: import("./tags.yo");
/// The Yo type universe.
TypeValue :: enum(
  // Primitive value types ---------------------------------------------------
  Unit,
  BoolT,
  Void,
  /// Fixed-width integer. `bits` ∈ {8, 16, 32, 64}; `signed` distinguishes
  /// `iN` vs `uN`.
  Int(bits : u8, signed : bool),
  /// Floating-point. `bits` ∈ {32, 64}.
  Float(bits : u8),
  /// Pointer-sized unsigned integer.
  Usize,
  /// Pointer-sized signed integer.
  Isize,
  // Compile-time numeric / string types -------------------------------------
  ComptimeInt,
  ComptimeFloat,
  ComptimeString,
  // C-compatible types (platform-dependent width) ---------------------------
  CChar,
  CShort,
  CUShort,
  CInt,
  CUInt,
  CLong,
  CULong,
  CLongLong,
  CULongLong,
  CLongDouble,
  // Type universes ---------------------------------------------------------
  /// `Type`, `Type(1)`, `Type(2)`, …  `level` ∈ {0,1,2,…}.
  TypeUni(level : usize),
  // Compound types ---------------------------------------------------------
  Pointer(pointee : Box(Self)),
  Slice(element : Box(Self)),
  Array(element : Box(Self), length : usize),
  /// Anonymous tuple. `field_labels(i)` is the optional label for the i-th
  /// field (empty `String` means positional). `field_types(i)` is the type.
  Tuple(field_labels : ArrayList(String), field_types : ArrayList(Self)),
  /// Function type. Phase 2b: forall type-vars, implicit (using) params,
  /// effect-row-spread flags, and where-clause constraint types.
  Func(
    forall_labels : ArrayList(String),
    // forall type-var names
    forall_types : ArrayList(Self),
    // forall type-var kinds (usually TypeUni)
    param_labels : ArrayList(String),
    // normal parameter labels
    param_types : ArrayList(Self),
    // normal parameter types
    implicit_labels : ArrayList(String),
    // ... parameter labels
    implicit_types : ArrayList(Self),
    // ... parameter types
    implicit_spreads : ArrayList(bool),
    // isEffectRowSpread flags
    where_types : ArrayList(Self),
    // where-clause constraint types
    result : Box(Self) // return type
  ),
  // Named user-defined types ------------------------------------------------
  /// `id` uniquely identifies this struct definition (mirrors `StructType.id`
  /// in `src/types/definitions.ts`).  Set to `""` for types reconstructed
  /// from runtime values via `type_of_eval_value`.
  /// `is_reference_semantics` = true for `object(...)`, false for `struct(...)`.
  /// `is_atomic_rc` = true for `atomic object(...)`.
  /// `is_newtype` = true for `newtype(...)`.
  Struct(
    id : String,
    name : String,
    field_labels : ArrayList(String),
    field_types : ArrayList(Self),
    is_reference_semantics : bool,
    is_atomic_rc : bool,
    is_newtype : bool
  ),
  /// `EnumT` rather than `Enum` to avoid clashing with the keyword.
  /// Each variant has a name and an `ArrayList` of field types (possibly empty).
  /// `selected_variant_name` is set when the type has been narrowed to a specific
  /// variant (e.g. after pattern matching or destructuring).
  /// Mirrors `EnumType.selectedVariantName` in `src/types/definitions.ts`.
  /// `variant_field_labels` holds the per-variant label names in declaration
  /// order — used by labeled destructuring and match (Phase 2ae+).
  /// `id` uniquely identifies this enum definition (mirrors `EnumType.id`).
  /// `variant_discriminants` holds one discriminant value per variant (in order).
  /// Mirrors `EnumVariant.discriminant` in `src/types/definitions.ts`.
  EnumT(
    id : String,
    name : String,
    variant_names : ArrayList(String),
    variant_fields : ArrayList(ArrayList(Self)),
    selected_variant_name : Option(String),
    variant_field_labels : ArrayList(ArrayList(String)),
    variant_discriminants : ArrayList(i64)
  ),
  Union(
    name : String,
    field_labels : ArrayList(String),
    field_types : ArrayList(Self)
  ),
  // Traits / modules --------------------------------------------------------
  /// Named trait type. Phase 2b: associated type names and method/field list.
  /// Phase 2aq: `id` for unique identity, `is_concrete` for `Concrete(T)` marker
  /// (mirrors TypeScript `TraitType.id` and `TraitType.isConcrete`).
  /// Phase 2az: `self_constraints` and `neg_self_constraints` mirror
  /// TypeScript `TraitType.selfConstraints` / `TraitType.negativeSelfConstraints`.
  TraitT(
    name : String,
    assoc_type_names : ArrayList(String),
    // names of associated type members
    field_labels : ArrayList(String),
    // method / field names
    field_types : ArrayList(Self),
    // method / field types
    id : String,
    // unique identity string
    is_concrete : Option(Box(Self)),
    // Some(T) when this is `Concrete(T)`
    self_constraints : ArrayList(Self),
    // where-clause constraints on Self
    neg_self_constraints : ArrayList(Self) // negative where-clause constraints on Self
  ),
  /// Named module type. Phase 2b: function-field list.
  /// Phase 2au: `id` added for nominal identity (mirrors TypeScript ModuleType.id).
  ModuleT(
    id : String,
    // unique module type identity
    name : String,
    field_labels : ArrayList(String),
    // function / field names
    field_types : ArrayList(Self) // function / field types
  ),
  // Generic / unresolved ----------------------------------------------------
  /// A `SomeType` introduced by `forall` or by a yet-to-be-resolved generic
  /// parameter. `frame_level` is the env frame at which it was introduced.
  /// Phase 2b: required and negative trait constraint lists.
  /// Phase 2d: `id` for unique identity (mirrors TypeScript SomeType.id).
  /// Phase 2e: `parent_type` — the meta-type of this type variable (usually TypeUni(0)).
  ///           Mirrors TypeScript `SomeType.parentType`.
  SomeT(
    id : String,
    // unique identity string
    name : String,
    frame_level : usize,
    parent_type : Box(Self),
    // meta-type (TypeUni(0) by default)
    required_trait_types : ArrayList(Self),
    // required trait constraints
    required_trait_levels : ArrayList(usize),
    // frame-level of each constraint
    negative_trait_types : ArrayList(Self),
    // negative trait constraints
    negative_trait_levels : ArrayList(usize),
    // frame-level of each negative constraint
    is_effects_row : bool,
    // true when this SomeType represents an effect-row spread `E : Type.Struct`
    // When present, this SomeT represents a higher-kinded type variable
    // (e.g. `F : (fn(T : Type) -> Type)`). The boxed `Func` TypeValue
    // captures the kind so `F(A)` can be evaluated as a TypeApplication.
    // Mirrors `SomeType.kindFunctionType` in `src/types/definitions.ts:238`.
    kind_function_type : Option(Box(Self))
  ),
  // Phase 2f: advanced type variants ----------------------------------------
  /// The Yo `Expr` type (a quoted expression node).
  ExprT,
  /// A compile-time homogeneous list. `child` is the element type.
  ComptimeListT(child : Box(Self)),
  /// An effects row — labels and types for `...` constraints.
  EffectsRowT(
    implicit_labels : ArrayList(String),
    implicit_types : ArrayList(Self)
  ),
  /// Application of a generic type constructor to arguments.
  /// `constructor` is always a `SomeT` (the type-constructor variable).
  TypeAppT(
    constructor : Box(Self),
    args : ArrayList(Self)
  ),
  /// Iso-wrapped type (linear / unique reference).
  IsoT(child : Box(Self)),
  /// Dynamic-dispatch type with trait bounds.
  DynT(
    required_trait_types : ArrayList(Self),
    required_trait_levels : ArrayList(usize),
    negative_trait_types : ArrayList(Self),
    negative_trait_levels : ArrayList(usize)
  ),
  /// Fn-trait type (Fn / FnMut / FnOnce).
  FnTraitT(
    base_name : String,
    call_param_labels : ArrayList(String),
    call_param_types : ArrayList(Self),
    call_result : Box(Self),
    implicit_labels : ArrayList(String),
    implicit_types : ArrayList(Self),
    implicit_spreads : ArrayList(bool)
  ),
  /// Future-trait type with associated output and effects.
  FutureTraitT(
    base_name : String,
    output : Box(Self),
    effect_labels : ArrayList(String),
    effect_types : ArrayList(Self),
    effect_spreads : ArrayList(bool)
  )
);
derive(TypeValue, Clone);
// ---------------------------------------------------------------------------
// Global counter for generating unique SomeType IDs.
// Mirrors the `IdMap` counter in `src/utils.ts:generateVarialeId`.
// ---------------------------------------------------------------------------
(g_some_type_id_counter : usize) = usize(0);
generate_some_type_id :: (fn() -> String)({
  local_c := g_some_type_id_counter;
  s := local_c.to_string();
  g_some_type_id_counter = (g_some_type_id_counter + usize(1));
  s
});
// ---------------------------------------------------------------------------
// Convenience constructors for primitive and pointer-sized types
// ---------------------------------------------------------------------------
t_unit :: (fn() -> TypeValue)(.Unit);
t_bool :: (fn() -> TypeValue)(.BoolT);
t_void :: (fn() -> TypeValue)(.Void);
t_i8 :: (fn() -> TypeValue)(.Int(u8(8), true));
t_i16 :: (fn() -> TypeValue)(.Int(u8(16), true));
t_i32 :: (fn() -> TypeValue)(.Int(u8(32), true));
t_i64 :: (fn() -> TypeValue)(.Int(u8(64), true));
t_u8 :: (fn() -> TypeValue)(.Int(u8(8), false));
t_u16 :: (fn() -> TypeValue)(.Int(u8(16), false));
t_u32 :: (fn() -> TypeValue)(.Int(u8(32), false));
t_u64 :: (fn() -> TypeValue)(.Int(u8(64), false));
t_f32 :: (fn() -> TypeValue)(.Float(u8(32)));
t_f64 :: (fn() -> TypeValue)(.Float(u8(64)));
t_usize :: (fn() -> TypeValue)(.Usize);
t_isize :: (fn() -> TypeValue)(.Isize);
t_comptime_int :: (fn() -> TypeValue)(.ComptimeInt);
t_comptime_float :: (fn() -> TypeValue)(.ComptimeFloat);
t_comptime_string :: (fn() -> TypeValue)(.ComptimeString);
t_type :: (fn() -> TypeValue)(.TypeUni(usize(0)));
// TypeUni(1) — the "kind" for Module and Trait (one level above Type(0))
t_type_1 :: (fn() -> TypeValue)(.TypeUni(usize(1)));
// C-compatible types (platform-dependent size; no compile-time arithmetic)
t_c_char :: (fn() -> TypeValue)(.CChar);
t_c_short :: (fn() -> TypeValue)(.CShort);
t_c_ushort :: (fn() -> TypeValue)(.CUShort);
t_c_int :: (fn() -> TypeValue)(.CInt);
t_c_uint :: (fn() -> TypeValue)(.CUInt);
t_c_long :: (fn() -> TypeValue)(.CLong);
t_c_ulong :: (fn() -> TypeValue)(.CULong);
t_c_longlong :: (fn() -> TypeValue)(.CLongLong);
t_c_ulonglong :: (fn() -> TypeValue)(.CULongLong);
t_c_longdouble :: (fn() -> TypeValue)(.CLongDouble);
t_ptr :: (fn(pointee : TypeValue) -> TypeValue)(.Pointer(box(pointee)));
t_slice :: (fn(element : TypeValue) -> TypeValue)(.Slice(box(element)));
t_array :: (fn(element : TypeValue, length : usize) -> TypeValue)(
  .Array(box(element), length, String.from(""))
);
// ---------------------------------------------------------------------------
// Convenience constructors for compound types (Phase 2b)
// ---------------------------------------------------------------------------
/// Create a simple function type (no forall, implicit, or where constraints).
t_func_simple :: (
  fn(
    param_labels : ArrayList(String),
    param_types : ArrayList(TypeValue),
    result : TypeValue
  ) -> TypeValue
)(
  .Func(
    ArrayList(String).new(),
    ArrayList(TypeValue).new(),
    param_labels,
    param_types,
    ArrayList(String).new(),
    ArrayList(TypeValue).new(),
    ArrayList(bool).new(),
    ArrayList(TypeValue).new(),
    box(result)
  )
);
/// Create a trait type with associated-type names and method/field lists.
t_trait :: (
  fn(
    name : String,
    assoc_names : ArrayList(String),
    field_labels : ArrayList(String),
    field_types : ArrayList(TypeValue)
  ) -> TypeValue
)(
  .TraitT(name, assoc_names, field_labels, field_types, String.from(""), Option(Box(TypeValue)).None, ArrayList(TypeValue).new(), ArrayList(TypeValue).new())
);
/// Create a named trait type with no fields.
t_trait_simple :: (fn(name : String) -> TypeValue)(
  .TraitT(name, ArrayList(String).new(), ArrayList(String).new(), ArrayList(TypeValue).new(), String.from(""), Option(Box(TypeValue)).None, ArrayList(TypeValue).new(), ArrayList(TypeValue).new())
);
/// Create a module type with field lists.
t_module :: (
  fn(
    name : String,
    field_labels : ArrayList(String),
    field_types : ArrayList(TypeValue)
  ) -> TypeValue
)(
  .ModuleT(String.from(""), name, field_labels, field_types)
);
/// Create a named module type with no fields.
t_module_simple :: (fn(name : String) -> TypeValue)(
  .ModuleT(String.from(""), name, ArrayList(String).new(), ArrayList(TypeValue).new())
);
// ---------------------------------------------------------------------------
// Convenience constructors for Phase 2f variants
// ---------------------------------------------------------------------------
t_expr_t :: (fn() -> TypeValue)(.ExprT);
t_comptime_list :: (fn(child : TypeValue) -> TypeValue)(
  .ComptimeListT(box(child))
);
t_effects_row :: (fn(labels : ArrayList(String), types : ArrayList(TypeValue)) -> TypeValue)(
  .EffectsRowT(labels, types)
);
t_type_app :: (fn(constructor : TypeValue, args : ArrayList(TypeValue)) -> TypeValue)(
  .TypeAppT(box(constructor), args)
);
t_iso :: (fn(child : TypeValue) -> TypeValue)(
  .IsoT(box(child))
);
t_dyn :: (
  fn(
    required_trait_types : ArrayList(TypeValue),
    required_trait_levels : ArrayList(usize),
    negative_trait_types : ArrayList(TypeValue),
    negative_trait_levels : ArrayList(usize)
  ) -> TypeValue
)(
  .DynT(required_trait_types, required_trait_levels, negative_trait_types, negative_trait_levels)
);
t_dyn_simple :: (fn(required_trait_types : ArrayList(TypeValue)) -> TypeValue)(
  .DynT(required_trait_types, ArrayList(usize).new(), ArrayList(TypeValue).new(), ArrayList(usize).new())
);
t_fn_trait :: (
  fn(
    base_name : String,
    call_param_labels : ArrayList(String),
    call_param_types : ArrayList(TypeValue),
    call_result : TypeValue,
    implicit_labels : ArrayList(String),
    implicit_types : ArrayList(TypeValue),
    implicit_spreads : ArrayList(bool)
  ) -> TypeValue
)(
  .FnTraitT(base_name, call_param_labels, call_param_types, box(call_result), implicit_labels, implicit_types, implicit_spreads)
);
t_fn_trait_simple :: (
  fn(
    base_name : String,
    call_param_types : ArrayList(TypeValue),
    call_result : TypeValue
  ) -> TypeValue
)(
  .FnTraitT(base_name, ArrayList(String).new(), call_param_types, box(call_result), ArrayList(String).new(), ArrayList(TypeValue).new(), ArrayList(bool).new())
);
t_future_trait :: (
  fn(
    base_name : String,
    output : TypeValue,
    effect_labels : ArrayList(String),
    effect_types : ArrayList(TypeValue),
    effect_spreads : ArrayList(bool)
  ) -> TypeValue
)(
  .FutureTraitT(base_name, box(output), effect_labels, effect_types, effect_spreads)
);
t_future_trait_simple :: (fn(base_name : String, output : TypeValue) -> TypeValue)(
  .FutureTraitT(base_name, box(output), ArrayList(String).new(), ArrayList(TypeValue).new(), ArrayList(bool).new())
);
/// Create an unconstrained SomeType (generic type variable).
t_some_t :: (fn(name : String, frame_level : usize) -> TypeValue)(
  .SomeT(
    generate_some_type_id(),
    name,
    frame_level,
    Box(TypeValue)(.TypeUni(usize(0))),
    ArrayList(TypeValue).new(),
    ArrayList(usize).new(),
    ArrayList(TypeValue).new(),
    ArrayList(usize).new(),
    false,
    Option(Box(TypeValue)).None
  )
);
// ---------------------------------------------------------------------------
// Tag accessor — useful for fast dispatch and equality short-circuits.
// ---------------------------------------------------------------------------
type_value_tag :: (fn(t : TypeValue) -> TypeTag)(
  match(
    t,
    .Unit => TypeTag.TUnit,
    .BoolT => TypeTag.TBool,
    .Void => TypeTag.TVoid,
    .Int(bits, signed) => cond(
      signed => cond(
        (bits == u8(8)) => TypeTag.TI8,
        (bits == u8(16)) => TypeTag.TI16,
        (bits == u8(32)) => TypeTag.TI32,
        true => TypeTag.TI64
      ),
      true => cond(
        (bits == u8(8)) => TypeTag.TU8,
        (bits == u8(16)) => TypeTag.TU16,
        (bits == u8(32)) => TypeTag.TU32,
        true => TypeTag.TU64
      )
    ),
    .Float(bits) => cond(
      (bits == u8(32)) => TypeTag.TF32,
      true => TypeTag.TF64
    ),
    .Usize => TypeTag.TUsize,
    .Isize => TypeTag.TIsize,
    .ComptimeInt => TypeTag.TComptimeInt,
    .ComptimeFloat => TypeTag.TComptimeFloat,
    .ComptimeString => TypeTag.TComptimeString,
    .CChar => TypeTag.TCChar,
    .CShort => TypeTag.TCShort,
    .CUShort => TypeTag.TCUShort,
    .CInt => TypeTag.TCInt,
    .CUInt => TypeTag.TCUInt,
    .CLong => TypeTag.TCLong,
    .CULong => TypeTag.TCULong,
    .CLongLong => TypeTag.TCLongLong,
    .CULongLong => TypeTag.TCULongLong,
    .CLongDouble => TypeTag.TCLongDouble,
    .TypeUni(_) => TypeTag.TType,
    .Pointer(_) => TypeTag.TPtr,
    .Slice(_) => TypeTag.TSlice,
    .Array(_, _, _) => TypeTag.TArray,
    .Tuple(_, _) => TypeTag.TTuple,
    .Func({ result : _ }) => TypeTag.TFunction,
    .Struct({ id : _ }) => TypeTag.TStruct,
    .EnumT(_, _, _, _, _, _, _) => TypeTag.TEnum,
    .Union(_, _, _) => TypeTag.TUnion,
    .TraitT(name : _) => TypeTag.TTrait,
    .ModuleT(_, _, _, _) => TypeTag.TModule,
    .SomeT(name : _) => TypeTag.TSomeType,
    .ExprT => TypeTag.TExpr,
    .ComptimeListT(_) => TypeTag.TComptimeList,
    .EffectsRowT(_, _) => TypeTag.TEffectsRow,
    .TypeAppT(_, _) => TypeTag.TTypeApplication,
    .IsoT(_) => TypeTag.TIso,
    .DynT(_, _, _, _) => TypeTag.TDyn,
    .FnTraitT(base_name : _) => TypeTag.TTrait,
    .FutureTraitT(base_name : _) => TypeTag.TTrait
  )
);
// ---------------------------------------------------------------------------
// Predicates — replace TS `isXxxType` guards.
// ---------------------------------------------------------------------------
is_int_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Int(_, _) => true, _ => false)
);
is_float_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Float(_) => true, _ => false)
);
is_signed_int_type :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .Int(_, signed) => signed,
    .Isize => true,
    _ => false
  )
);
is_numeric_type :: (fn(t : TypeValue) -> bool)(
  cond(
    is_int_type(t) => true,
    is_float_type(t) => true,
    true => match(
      t,
      .Usize => true,
      .Isize => true,
      .ComptimeInt => true,
      .ComptimeFloat => true,
      _ => false
    )
  )
);
is_pointer_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Pointer(_) => true, _ => false)
);
is_slice_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Slice(_) => true, _ => false)
);
is_array_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Array(_, _, _) => true, _ => false)
);
is_function_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Func({ result : _ }) => true, _ => false)
);
is_some_type :: (fn(t : TypeValue) -> bool)(
  match(t,.SomeT(name : _) => true, _ => false)
);
is_trait_type :: (fn(t : TypeValue) -> bool)(
  match(
    t,
    .TraitT(name : _) => true,
    .FnTraitT(base_name : _) => true,
    .FutureTraitT(base_name : _) => true,
    _ => false
  )
);
is_module_type :: (fn(t : TypeValue) -> bool)(
  match(t,.ModuleT(_, _, _, _) => true, _ => false)
);
is_struct_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Struct({ id : _ }) => true, _ => false)
);
is_enum_type :: (fn(t : TypeValue) -> bool)(
  match(t,.EnumT(_, _, _, _, _, _, _) => true, _ => false)
);
is_union_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Union(_, _, _) => true, _ => false)
);
is_tuple_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Tuple(_, _) => true, _ => false)
);
is_unit_type :: (fn(t : TypeValue) -> bool)(
  match(t,.Unit => true, _ => false)
);
is_bool_type :: (fn(t : TypeValue) -> bool)(
  match(t,.BoolT => true, _ => false)
);
// Reference-semantics / dyn / iso / newtype / str / box guards live in
// `yo-self/types/guards.yo` to mirror `src/types/guards.ts`.
export(
  TypeValue,
  type_value_tag,
  t_unit,
  t_bool,
  t_void,
  t_i8,
  t_i16,
  t_i32,
  t_i64,
  t_u8,
  t_u16,
  t_u32,
  t_u64,
  t_f32,
  t_f64,
  t_usize,
  t_isize,
  t_comptime_int,
  t_comptime_float,
  t_comptime_string,
  t_type,
  t_ptr,
  t_slice,
  t_array,
  t_func_simple,
  t_trait,
  t_trait_simple,
  t_module,
  t_module_simple,
  t_some_t,
  generate_some_type_id,
  t_expr_t,
  t_comptime_list,
  t_effects_row,
  t_type_app,
  t_iso,
  t_dyn,
  t_dyn_simple,
  t_fn_trait,
  t_fn_trait_simple,
  t_future_trait,
  t_future_trait_simple,
  t_type_1,
  t_c_char,
  t_c_short,
  t_c_ushort,
  t_c_int,
  t_c_uint,
  t_c_long,
  t_c_ulong,
  t_c_longlong,
  t_c_ulonglong,
  t_c_longdouble,
  is_int_type,
  is_float_type,
  is_signed_int_type,
  is_numeric_type,
  is_pointer_type,
  is_slice_type,
  is_array_type,
  is_function_type,
  is_trait_type,
  is_module_type,
  is_some_type,
  is_struct_type,
  is_enum_type,
  is_union_type,
  is_tuple_type,
  is_unit_type,
  is_bool_type
);
