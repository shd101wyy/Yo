//! Structural type-key (`type_key`) — the codegen C-type-identity function,
//! extracted into `types/` so BOTH codegen and the evaluator can import it
//! (the evaluator's specialization signature must align with codegen's C-type
//! merging; see evaluator/calls/helper.yo compute_compile_time_signature).
//! Verbatim move of the cluster formerly in codegen/utils/index.yo:
//! g_struct_cfid_keys / g_enum_sig_keys / _lookup_or_register_enum_sig /
//! g_tk_visited / _tk_seen / _type_key_at / type_key.
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ HashMap } :: import("std/collections/hash_map");
{ TypeValue } :: import("./definitions.yo");
{ type_to_string } :: import("./string.yo");
{ resolve_enum_shell, resolve_struct_shell } :: import("./creators.yo");
{ is_type_hierarchy_type, is_unit_type, is_some_type } :: import("./guards.yo");
(g_struct_cfid_keys : HashMap(String, String)) = HashMap(String, String).new();

// Enum structural-signature dedup (the enum analogue of g_struct_cfid_keys).
// `Struct` carries a `constructor_func_id` + `type_arguments` that give every
// generic instantiation a stable codegen key; `EnumT` has NO such field, so two
// structurally-identical generic enum instantiations (e.g. `Option(i32)` reached
// once via `ArrayList.get()` and once via the iterator `next()`'s `-> Option(T)`
// return) get DISTINCT eval ids → distinct id-based type keys → two incompatible
// C structs (`assigning from incompatible type` when one is stored into the
// other). TS avoids this entirely: its eval unifies the ids via the comptime-fn
// cache and codegen keys the registry by `type.id` (collection.ts:805). yo-self's
// eval mints fresh ids per instantiation (same divergence the struct cfid scheme
// already compensates for), so we dedup at codegen here: map an enum's STRUCTURAL
// signature (variant names + discriminants + field-type keys, NO id) to the
// FIRST-seen full key, and reuse that for later structural duplicates. Single
// enums are unaffected (they register their own key and get it back), so this is
// minimal — only genuine duplicates collapse, and only to a C-layout-identical
// peer. Reference-semantics enums are excluded (they key by id for recursion
// termination). See issues/yo-self-iterator-option-identity.md.
// sig → canonical_key, FIRST registration wins (HashMap — same O(n²)-scan
// fix as g_struct_cfid_keys above).
(g_enum_sig_keys : HashMap(String, String)) = HashMap(String, String).new();
/// Look up the canonical key for a structural signature; register `full_key` as
/// the canonical for `sig` on first sight.
_lookup_or_register_enum_sig :: (fn(sig : String, full_key : String) -> String)(
  match(
    g_enum_sig_keys.get(sig),
    // CLONE the stored canonical: a returned String shares the map value's
    // buffer, so an in-place push by any caller would corrupt the canonical
    // (the IoError stage-2 typedef split). Same hardening on the struct
    // cfid-key returns below.
    .Some(k) => k.clone(),
    .None => {
      g_enum_sig_keys.set(sig.clone(), full_key.clone());
      full_key
    }
  )
);

// Monotonic set of named-type ids currently on the `_type_key_at` expansion
// path (reset per top-level `type_key` call). A named type re-encountered
// while already being expanded renders id-only — the SAME cycle-guard
// discipline as types/intern.yo's type_intern_key. WHY: the compiler's own
// giant recursive enums (TypeValue/AstExpr/EvalValue) reach _type_key_at
// through `ArrayList(AstExpr)` → Struct arm → recurse into AstExpr → EnumT arm
// → its own `ArrayList(AstExpr)` field → … The direct-ref-enum-field id-only
// shortcut does NOT catch this (the recursion goes THROUGH a Struct wrapper),
// so only the depth-4 cap bounded it: 40-way variant fanout × depth 4 built
// multi-MB key strings per lookup, thousands of times → a ~300 MB/s runaway
// during prototype emission (footprint 7→62 GB). The guard bounds each key to
// O(distinct types on path) and is MORE precise than depth truncation (each
// distinct type still gets a distinct key), so C-type identity is preserved.
(g_tk_visited : ArrayList(String)) = ArrayList(String).new();
/// Resolve a SomeT TYPE-ARGUMENT slot through its resolution-cell chain
/// (cycle-guarded) before keying. Bare-id keying of argument slots split one
/// logical instantiation into two C types whenever two records held the same
/// resolution behind DIFFERENT SomeT identities — the closure-F family:
/// `IterFilter(CountIter, F)` minted once with the where-clause forall `F`
/// and once with the synthetic `__impl_fn` wrapper, both resolving to the
/// SAME capture struct. Scoped to argument slots only: a top-level SomeT
/// (dyn/box closure wrappers) keys by its own id — hopping there over-merged
/// the wrapper's fat call/data struct with the capture struct.
_tk_resolve_arg_slot :: (fn(t_in : TypeValue) -> TypeValue)({
  (cur : TypeValue) = t_in;
  (seen : ArrayList(String)) = ArrayList(String).new();
  (walk : bool) = true;
  while(walk, {
    match(
      cur,
      .SomeT({ id : ras_id, name : ras_nm, resolved_concrete : ras_rc }) => {
        // Annotation-era wrappers (reserved name "Impl" —
        // builtins/impl_constraint.yo) and the dyn-coercion wrappers (minted
        // NAMELESS, values/dyn.yo:336) keep their OWN identity: the dyn/box
        // closure machinery lowers them to a distinct fat call/data C struct,
        // and hopping to the capture struct merged the two ("no member named
        // 'call'" across the dyn corpus). Only where-clause foralls and the
        // synthetic `__impl_fn` hop.
        if((ras_nm == "Impl") || (ras_nm.len() == usize(0)), {
          return(t_in);
        });
        (revisit : bool) = false;
        (ri : usize) = usize(0);
        while(ri < seen.len(), {
          match(
            seen.get(ri),
            .Some(rs) => if(rs == ras_id, {
              revisit = true;
            }),
            .None => ()
          );
          ri = (ri + usize(1));
        });
        if(revisit, {
          walk = false;
        }, {
          seen.push(ras_id.clone());
          match(
            ras_rc.get(usize(0)),
            .Some(nx) => {
              cur = nx;
            },
            .None => {
              walk = false;
            }
          );
        });
      },
      _ => {
        walk = false;
      }
    );
  });
  // An unresolved chain keeps the ORIGINAL slot (bare-id keying as before).
  if(is_some_type(cur), t_in, cur)
});
_tk_seen :: (fn(id : String) -> bool)({
  n := g_tk_visited.len();
  (i : usize) = usize(0);
  (found : bool) = false;
  while((i < n) && !(found), {
    // Compare in place — the old `e.clone()` deep-copied the byte buffer of
    // every visited entry per probe (342 M ArrayList(u8) allocations per
    // self-emit, the #2 string-churn site) just to == it and drop it.
    // Compact bool-valued arm form (an r3-era self-hosted miscompile of
    // this shape was fixed by later work — restored 2026-08-07 with the
    // fixpoint as judge; issues/retired/yo-self-bool-match-arm-miscompile.md).
    found = match(g_tk_visited.get(i),.Some(e) => (e == id),.None => false);
    i = (i + usize(1));
  });
  found
});
_type_key_at :: (fn(t : TypeValue, depth : usize) -> String)(
  match(
    t,
    .Struct({ id, constructor_func_id : cfid, type_arguments : tas, field_types : fts, is_reference_semantics : t_is_ref }) => {
      // Resolve a leaked recursive-struct SELF-SHELL to its final so the shell and
      // its final share ONE C type key. Mirrors the EnumT branch below. No-op for
      // non-shells. See resolve_struct_shell (creators.yo).
      st := resolve_struct_shell(t);
      (sid, scfid, stas, sfts, s_is_ref) := match(
        st,
        .Struct({ id : rid, constructor_func_id : rcfid, type_arguments : rtas, field_types : rfts, is_reference_semantics : rirs }) => (rid, rcfid, rtas, rfts, rirs),
        _ => (id, cfid, tas, fts, t_is_ref)
      );
      // #30: a reference-semantics struct (`ref(struct …)` → emitted as a pointer
      // field) and a value struct with the SAME fields have DIFFERENT C layouts
      // and MUST NOT share a C type id. `type_key` historically omitted this, so
      // two `Bucket(K,V)` instantiations — one with a ref `value` field, one with
      // a value `value` field — collapsed onto one id; the GC traverse fn built for
      // the ref layout was then emitted for the value layout (`if(struct){…}` — a
      // clang scalar-type error, main.yo-only). Prefix ref-semantics struct keys so
      // they never collide with value structs; ref structs still dedup among
      // themselves (constant marker). See issues/yo-self-gc-traverse-value-struct-field.md.
      ref_pfx := if(s_is_ref, String.from("R#"), String.from(""));
      // Cycle guard (see g_tk_visited): a struct id already on the expansion
      // path renders via its recorded cfid-key / id — no re-recursion into
      // its (already-being-expanded) type arguments.
      if((sid.len() > usize(0)) && _tk_seen(sid), {
        cyc_inner := match(
          g_struct_cfid_keys.get(sid),
          // A POISONED slot ("!AMBIG" — multiple instantiations share this
          // sid) must NOT leak the sentinel as a key: two different nested
          // types would both render "!AMBIG" and collide (the sentinel
          // appeared inside specialized C fn names, merging distinct
          // ArrayList instantiations — the stage-2 binary's runtime hang).
          // Fall back to the bare sid: the cycle guard only fires for a
          // type already ON the expansion path, where id-only rendering is
          // the pre-poison behavior for self-references.
          .Some(k) => if(k == "!AMBIG", sid.clone(), k.clone()),
          .None => sid.clone()
        );
        cyc_out := ref_pfx.clone();
        cyc_out.push_string(cyc_inner);
        return(cyc_out);
      });
      if(sid.len() > usize(0), {
        g_tk_visited.push(sid.clone());
      });
      raw_key := cond(
        // GENERIC INSTANTIATION with stable identity: key by (constructor_func_id, type_arguments).
        // NO depth cap: the g_tk_visited cycle guard already bounds recursion;
        // a depth cap made every generic nested deeper than the cap fall back
        // to the g_struct_cfid_keys[sid] single slot, which is
        // first-registration-wins and thus WRONG for shared-id generics like
        // Bucket(K,V) (all instantiations share one eval struct id) — the
        // flaky GC-tracer .label/.ty cluster: a deep Bucket keyed as the
        // FIRST-seen instantiation, collapsing two different layouts onto one
        // C name, order-dependent per emit. Long keys are ugly but correct.
        ((scfid.len() > usize(0)) && (stas.len() > usize(0))) => {
          key := `gs_${scfid.clone()}`;
          (tk_has_uni : bool) = false;
          (ti : usize) = usize(0);
          while(ti < stas.len(), {
            match(
              stas.get(ti),
              .Some(ta_raw) => {
                // Resolve a SomeT slot through its cell chain first (the
                // closure-F identity repair — see _tk_resolve_arg_slot).
                ta := _tk_resolve_arg_slot(ta_raw);
                // `Type` AND `unit` argument slots are value-erased: a comptime
                // VALUE argument (`N : usize`) has no TypeValue representation,
                // so the stamp records `unit` (fresh re-stamps) or `Type`
                // (def-era binder) in its slot.
                if(is_type_hierarchy_type(ta) || is_unit_type(ta), {
                  tk_has_uni = true;
                });
                key.push_str("_");
                key.push_string(recur(ta, depth + usize(1)));
              },
              .None => ()
            );
            ti = (ti + usize(1));
          });
          // VALUE-generic stamps: a `Type` argument slot erases the VALUE —
          // `_ArrayIter(i32, 0)` and `_ArrayIter(i32, 3)` both render
          // `[i32, Type]` (a comptime usize is not representable as a
          // TypeValue argument), so keying by (cfid, args) alone collapsed
          // the two layouts onto ONE C type (`._arr = self` with a
          // 3-element self against a 0-element member). Append the FIELD
          // structure, which carries the distinguishing Array length.
          if(tk_has_uni, {
            (tkf : usize) = usize(0);
            while(tkf < sfts.len(), {
              match(
                sfts.get(tkf),
                .Some(tk_ft) => {
                  key.push_str("_f");
                  key.push_string(recur(tk_ft, depth + usize(1)));
                },
                .None => ()
              );
              tkf = (tkf + usize(1));
            });
          });
          // Record the cfid-key for this struct id so cfid-empty copies use
          // it — but ONLY while the sid maps to ONE instantiation key. When a
          // SECOND different key arrives (shared-id generics: every
          // Bucket(K,V) instantiation shares one eval struct id), POISON the
          // slot: a cfid-empty copy can then no longer be attributed to any
          // single instantiation and must key STRUCTURALLY (below). The old
          // first-registration-wins slot pinned every cfid-empty copy to the
          // FIRST instantiation — one specialized Bucket tracer served 36
          // different Bucket layouts (the flaky GC-tracer .label/.ty cluster),
          // with registration order deciding the winner per emit.
          if(sid.len() > usize(0), {
            match(
              g_struct_cfid_keys.get(sid),
              .Some(prev) => if(!((prev == key) || (prev == "!AMBIG")), {
                g_struct_cfid_keys.set(sid.clone(), String.from("!AMBIG"));
              }),
              .None => {
                g_struct_cfid_keys.set(sid.clone(), key.clone());
              }
            );
          });
          key
        },
        // No cfid: look up a previously-recorded cfid-key for this struct id.
        // A POISONED slot (multiple instantiations share this sid) keys
        // STRUCTURALLY — sid + per-field type keys — so two cfid-empty copies
        // with different layouts get different, DETERMINISTIC keys (the enum
        // analogue: g_enum_sig_keys). A NEVER-REGISTERED sid (.None) with
        // known field types ALSO keys structurally: shared-id generics whose
        // instantiations are all cfid-empty (Bucket(K,V) — created by the
        // with_capacity Type(1) path, so NO instantiation ever records a gs_
        // key) otherwise render bare-sid everywhere and every layout collapses
        // onto ONE key — one GcTracer visit specialization served all Bucket
        // layouts and walked the wrong fields (TS emits 47 distinct Bucket
        // visit fns, one per instantiation). Unpoisoned REGISTERED sids
        // (.Some non-poison) behave exactly as before.
        (sid.len() > usize(0)) => {
          slot := g_struct_cfid_keys.get(sid);
          need_structural := match(
            slot,
            .Some(k) => (k == "!AMBIG"),
            .None => (sfts.len() > usize(0))
          );
          if(need_structural, {
            skey := sid.clone();
            (sfi : usize) = usize(0);
            while(sfi < sfts.len(), {
              match(
                sfts.get(sfi),
                .Some(sft) => {
                  skey.push_str("_");
                  skey.push_string(recur(sft, depth + usize(1)));
                },
                .None => ()
              );
              sfi = (sfi + usize(1));
            });
            skey
          }, match(
            slot,
            .Some(k) => k.clone(),
            .None => sid.clone()
          ))
        },
        true => type_to_string(st)
      );
      out_key := ref_pfx.clone();
      out_key.push_string(raw_key);
      out_key
    },
    .EnumT({ id, variant_fields : vfs }) => {
      // Resolve a leaked recursive-enum SELF-SHELL to its final so the shell and
      // its final share ONE C type key (else a `Box(Self)` field two levels deep
      // keys/emits a separate empty `..._self_shell` enum — "use of empty enum").
      // Passthrough for any non-shell enum. See
      // issues/.../recursive-enum-self-shell.md.
      rs := resolve_enum_shell(t);
      eid := match(rs,.EnumT({ id : rid }) => rid, _ => id.clone());
      evfs := match(rs,.EnumT({ variant_fields : rvfs }) => rvfs, _ => vfs);
      evns := match(rs,.EnumT({ variant_names : rvns }) => rvns, _ => ArrayList(String).new());
      evds := match(rs,.EnumT({ variant_discriminants : rvds }) => rvds, _ => ArrayList(i64).new());
      e_is_ref := match(rs,.EnumT({ is_reference_semantics : rirs }) => rirs, _ => false);
      evfls := match(rs,.EnumT({ variant_field_labels : rvfls }) => rvfls, _ => ArrayList(ArrayList(String)).new());
      // Cycle guard (see g_tk_visited): an enum id already on the expansion
      // path renders id-only rather than re-expanding its variant fields.
      if((eid.len() > usize(0)) && _tk_seen(eid), {
        return(eid.clone());
      });
      if(eid.len() > usize(0), {
        g_tk_visited.push(eid.clone());
      });
      // An EMPTY-id enum must still be keyed STRUCTURALLY (via the sig path
      // below), not by `type_to_string` — the name alone drops the payload, so
      // `create_option_type`'s synthesized `Option` (id="", name="Option", used
      // by downcast/await/rc) collapsed EVERY instantiation to one C type
      // `Option`, giving e.g. `downcast(err, MathError)` a result whose Some
      // field was typed `String` ("initializing __yo_t30 with __yo_t10",
      // tests/error.test.yo). The sig (variant names + discriminants +
      // field types) distinguishes `Option(String)` from `Option(MathError)`
      // AND still collapses the synthetic rendition with real `Option(T)`
      // instances (same sig). Only the DEPTH guard keeps the name-only shortcut
      // (recursion bound); empty-id enums are leaf-shaped here (no id-keyed
      // cycle guard), so the depth bound suffices.
      if(depth > usize(4), if(eid.len() > usize(0), eid.clone(), type_to_string(rs)), {
        // Build the per-field structural suffix ONCE (used in both the full key
        // and the structural signature).
        field_part := String.new();
        (vi : usize) = usize(0);
        while(vi < evfs.len(), {
          match(
            evfs.get(vi),
            .Some(fields) => {
              (fi : usize) = usize(0);
              while(fi < fields.len(), {
                match(
                  fields.get(fi),
                  .Some(ft) => {
                    field_part.push_str("_");
                    // Field LABEL joins the key: two enums with identical
                    // variant names/discriminants/field TYPES but different
                    // field labels (`Err(msg : i32)` vs `Err(error : i32)`)
                    // emit different C member names — merging them made the
                    // second enum's designated initializer reference a
                    // nonexistent member (tests/basic arms 19+8 batch:
                    // "field designator 'msg' does not refer to any field").
                    match(
                      evfls.get(vi),
                      .Some(vfl_row) => match(
                        vfl_row.get(fi),
                        .Some(fl_nm) => {
                          field_part.push_string(fl_nm);
                          field_part.push_str(":");
                        },
                        .None => ()
                      ),
                      .None => ()
                    );
                    // A reference-semantics enum field (`ref(enum(…))`) is a
                    // POINTER, so key it by its shell-resolved `id` ALONE. This
                    // terminates self-referential `ref(enum(…))` recursion with
                    // a STABLE key — identical across the shell / pre-final /
                    // final layers — so the recursive field and the registered
                    // type get the SAME C name (else they diverge into distinct
                    // depth-expanded names → "field has incomplete type").
                    // Value-enum fields still expand, distinguishing generic
                    // instantiations (Option(Token) vs Option(u8)).
                    rft := resolve_enum_shell(ft);
                    fk := match(
                      rft,
                      .EnumT({ id : rid, is_reference_semantics : rrs }) =>
                        if(rrs && (rid.len() > usize(0)), rid.clone(), recur(ft, depth + usize(1))),
                      _ => recur(ft, depth + usize(1))
                    );
                    field_part.push_string(fk);
                  },
                  .None => ()
                );
                fi = (fi + usize(1));
              });
            },
            .None => ()
          );
          vi = (vi + usize(1));
        });
        // Full key = id-based (UNCHANGED behavior). This is what a single,
        // first-seen enum gets.
        key := eid.clone();
        key.push_string(field_part);
        // Reference-semantics enums keep the id-based key verbatim (no structural
        // dedup — their id is load-bearing for recursion termination).
        if(e_is_ref, key, {
          // Structural signature = variant names + discriminants + field suffix
          // (NO id). Two generic instantiations of the same enum (e.g. two
          // `Option(i32)` with distinct eval ids) produce the SAME sig and so
          // collapse to one C type; distinct enums differ in variant names,
          // discriminants, or field types. Discriminants are included so two
          // same-named/same-fielded variants with different tag values do NOT
          // merge.
          sig := String.from("e");
          (si : usize) = usize(0);
          while(si < evns.len(), {
            sig.push_str("_");
            match(evns.get(si),.Some(vn) => sig.push_string(vn),.None => ());
            match(
              evds.get(si),
              .Some(d) => {
                sig.push_str("=");
                sig.push_string(d.to_string());
              },
              .None => ()
            );
            si = (si + usize(1));
          });
          sig.push_string(field_part);
          _lookup_or_register_enum_sig(sig, key)
        })
      })
    },
    // NOTE: a SomeT keys by its OWN id — NOT through its resolution cell. A
    // blanket resolved-hop here was measured to over-merge: the dyn/box
    // closure-wrapper family keys the WRAPPER SomeT as a distinct C type (the
    // fat call/data struct) whose id-keyed identity must NOT collapse onto
    // the capture struct ("no member named 'call'" across the dyn corpus).
    // The closure-F identity split is instead repaired where it actually
    // occurs: the Struct arm resolves SomeT TYPE-ARGUMENT slots through
    // their cells (see _tk_resolve_arg_slot below).
    .SomeT({ id }) => if(id.len() > usize(0), id.clone(), type_to_string(t)),
    .TraitT({ id }) => if(id.len() > usize(0), id.clone(), type_to_string(t)),
    // Key a Dyn by its trait IDS (each trait keyed by the stable TraitT arm
    // above, which uses the id WITHOUT recursing into method signatures), NOT
    // by `type_to_string`. For a self-referential trait like `Error`
    // (`source : fn(self) -> Option(Dyn(Error))`), `type_to_string` spells the
    // method sig differently across contexts (full `(source : fn… -> <enum>)`
    // vs abbreviated `_`), so the same `Dyn(Error)` got TWO C type names — the
    // vtable `source` slot vs its wrapper's return type mismatched (fn-ptr type
    // error). Trait-id keying is stable and still distinguishes distinct Dyns.
    .DynT({ required_trait_types : drtt, negative_trait_types : dntt }) => {
      key := String.from("dyn");
      (di : usize) = usize(0);
      while(di < drtt.len(), {
        match(
          drtt.get(di),
          .Some(tt) => {
            key.push_str("_");
            key.push_string(recur(tt, depth + usize(1)));
          },
          .None => ()
        );
        di = (di + usize(1));
      });
      (ni : usize) = usize(0);
      while(ni < dntt.len(), {
        match(
          dntt.get(ni),
          .Some(tt) => {
            key.push_str("_n");
            key.push_string(recur(tt, depth + usize(1)));
          },
          .None => ()
        );
        ni = (ni + usize(1));
      });
      key
    },
    // Pointer: recurse into the pointee so `*(anon-generic-instantiation)`
    // inherits the struct machinery's instantiation-precise key. The plain
    // `_ => type_to_string` fallback rendered `*(<struct:yo_id_N>)` — N being
    // the shared DECLARATION id — so pointers to different instantiations
    // produced identical keys and collided (the shared GcTracer visit
    // specialization class; TS keys every type by its unique numeric
    // `type.id`). Re-applied 2026-07-17: the 2026-07-15 revert's "stage-2
    // startup heap corruption" verdict came from an invalidated bisect — the
    // corruption was the since-fixed RC leak + GC-teardown double-free. See
    // issues/fixed/yo-self-specialization-signature-type-identity.md.
    .Pointer(pointee) => {
      key := String.from("*(");
      key.push_string(recur(pointee, depth + usize(1)));
      key.push_str(")");
      key
    },
    // Tuple: key by the RECURSED keys of the field types (labels included for
    // record-tuples), NOT by `type_to_string`. Tuples are structural — the
    // render fallback embedded the EVALUATOR's type-argument spelling, so
    // `Tuple(0 : Box(V))` (a signature rendered before `V` resolved) and
    // `Tuple(0 : Box(i32))` minted TWO C types for one layout (both fields
    // `__yo_t18*` — the SAME Box instance) and `z._0 = (…){…}` failed to
    // C-compile (tests/rc.test.yo "Rc in different data structures", rc
    // layer 2 in the Gap-6 ledger). Per-field recursion inherits the struct
    // arm's instantiation merging, so layout-identical tuples share one key.
    .Tuple(tk_labels, tk_fts) => {
      key := String.from("tup");
      (ti : usize) = usize(0);
      while(ti < tk_fts.len(), {
        key.push_str("_");
        match(
          tk_labels.get(ti),
          .Some(tl) => if(tl.len() > usize(0), {
            key.push_string(tl);
            key.push_str(":");
          }),
          .None => ()
        );
        match(
          tk_fts.get(ti),
          .Some(ft) => {
            key.push_string(recur(ft, depth + usize(1)));
          },
          .None => ()
        );
        ti = (ti + usize(1));
      });
      key
    },
    _ => type_to_string(t)
  )
);
type_key :: (fn(t : TypeValue) -> String)({
  // Fresh expansion-path set per top-level key build (see g_tk_visited).
  g_tk_visited = ArrayList(String).new();
  _type_key_at(t, usize(0))
});
// ---------------------------------------------------------------------------
// stable_type_identity — a PURE structural identity render.
// ---------------------------------------------------------------------------
// Like `type_key` but consulting NO mutable key registries (the
// g_struct_cfid_keys first-registration/poison transitions make `type_key`'s
// render of one type EVOLVE over a compile): this render never changes.
// `collect_type` uses it to detect "same type re-collected under an EVOLVED
// type_key" — the duplicate-C-declaration family (enumerator/typeid
// redefinitions, one struct split across two C types). It is NOT a type_key
// replacement: instantiation COPIES that type_key deliberately merges may
// render distinctly here (by their own sid), which only means a missed
// alias — never a wrong merge, since equal renders imply equal structure.
(g_sti_visited : ArrayList(String)) = ArrayList(String).new();
_sti_seen :: (fn(id : String) -> bool)({
  n := g_sti_visited.len();
  (i : usize) = usize(0);
  (found : bool) = false;
  while((i < n) && !(found), {
    match(
      g_sti_visited.get(i),
      .Some(v) => if(v == id, {
        found = true;
      }),
      .None => ()
    );
    i = (i + usize(1));
  });
  found
});
_stable_identity_at :: (fn(t : TypeValue, depth : usize) -> String)({
  // DEPTH CAP: the id-based cycle guard below cuts CYCLES, but a memoized
  // instantiation CHAIN (Option(RBNode(Option(RBNode(…)))) where every level
  // is a DISTINCT instance with a fresh id) is an infinite NON-cyclic graph —
  // the guard never fires and the render recursed forever (the imm_sorted_set
  // / btree_map batch compile STALL: 100% CPU in this walker). Render a
  // cut marker that keeps the node's own identity (id or tag) so two types
  // differing at the cut still render distinctly — a false MERGE here would
  // collapse different layouts onto one C type.
  if(depth > usize(32), {
    cut := String.from("d#");
    cut.push_string(
      match(
        t,
        .Struct({ id : cut_sid }) => cut_sid.clone(),
        .EnumT(cut_eid, _, _, _, _, _, _, _, _) => cut_eid.clone(),
        _ => type_to_string(t)
      )
    );
    return(cut);
  });
  match(
    t,
    .Struct({ id, field_labels : fls, field_types : fts, is_reference_semantics : t_is_ref }) => {
      st := resolve_struct_shell(t);
      (sid, sfls, sfts, s_is_ref) := match(
        st,
        .Struct({ id : rid, field_labels : rfls, field_types : rfts, is_reference_semantics : rirs }) => (rid, rfls, rfts, rirs),
        _ => (id, fls, fts, t_is_ref)
      );
      pfx := if(s_is_ref, String.from("R#"), String.from(""));
      if((sid.len() > usize(0)) && _sti_seen(sid), {
        out_cyc := pfx.clone();
        out_cyc.push_string(sid);
        return(out_cyc);
      });
      if(sid.len() > usize(0), {
        g_sti_visited.push(sid.clone());
      });
      out := pfx;
      out.push_string(sid);
      (i : usize) = usize(0);
      while(i < sfts.len(), {
        ft := match(sfts.get(i),.Some(x) => x,.None => TypeValue.Unit);
        fl := match(sfls.get(i),.Some(x) => x,.None => String.from(""));
        out.push_str("_");
        out.push_string(fl);
        out.push_str(":");
        out.push_string(recur(ft, depth + usize(1)));
        i = (i + usize(1));
      });
      out
    },
    .EnumT({ id, variant_names : vns0, variant_fields : vfs0, is_reference_semantics : e_is_ref0 }) => {
      rs := resolve_enum_shell(t);
      eid := match(rs,.EnumT({ id : rid }) => rid, _ => id.clone());
      evns := match(rs,.EnumT({ variant_names : rvns }) => rvns, _ => vns0);
      evfs := match(rs,.EnumT({ variant_fields : rvfs }) => rvfs, _ => vfs0);
      e_is_ref := match(rs,.EnumT({ is_reference_semantics : rirs }) => rirs, _ => e_is_ref0);
      pfx := if(e_is_ref, String.from("R#"), String.from(""));
      if((eid.len() > usize(0)) && _sti_seen(eid), {
        out_cyc := pfx.clone();
        out_cyc.push_string(eid);
        return(out_cyc);
      });
      if(eid.len() > usize(0), {
        g_sti_visited.push(eid.clone());
      });
      out := pfx;
      out.push_string(eid);
      (vi : usize) = usize(0);
      while(vi < evfs.len(), {
        vn := match(evns.get(vi),.Some(x) => x,.None => String.from(""));
        out.push_str("_");
        out.push_string(vn);
        match(
          evfs.get(vi),
          .Some(fields) => {
            (fi : usize) = usize(0);
            while(fi < fields.len(), {
              ft := match(fields.get(fi),.Some(x) => x,.None => TypeValue.Unit);
              out.push_str(":");
              out.push_string(recur(ft, depth + usize(1)));
              fi = (fi + usize(1));
            });
          },
          .None => ()
        );
        vi = (vi + usize(1));
      });
      out
    },
    .Pointer(pointee) => {
      out := String.from("*(");
      out.push_string(recur(pointee, depth + usize(1)));
      out.push_str(")");
      out
    },
    // Tuple: parity with `type_key`'s Tuple arm — RECURSE into the field
    // types. Without this arm a tuple fell to `type_to_string`, which renders
    // a Struct field by NAME, so two sibling blocks each declaring a local
    // `S` and `C :: Tuple(S)` both rendered `Tuple(0 : S)` — collect_type then
    // ALIASED the second tuple's type_key onto the first's C type and emitted
    // one `__yo_tN` for two different layouts (basic.test.yo arm 12; the
    // handoff-2026-08-02/07 A2 patch, re-landed after the get_type_string
    // cycle guard removed the stage-2 crash that blocked its control run).
    .Tuple(sti_labels, sti_fts) => {
      out := String.from("tup");
      (sti_i : usize) = usize(0);
      while(sti_i < sti_fts.len(), {
        out.push_str("_");
        match(
          sti_labels.get(sti_i),
          .Some(sti_l) => if(sti_l.len() > usize(0), {
            out.push_string(sti_l);
            out.push_str(":");
          }),
          .None => ()
        );
        match(
          sti_fts.get(sti_i),
          .Some(sti_ft) => {
            out.push_string(recur(sti_ft, depth + usize(1)));
          },
          .None => ()
        );
        sti_i = (sti_i + usize(1));
      });
      out
    },
    _ => type_to_string(t)
  )
});
stable_type_identity :: (fn(t : TypeValue) -> String)({
  g_sti_visited = ArrayList(String).new();
  _stable_identity_at(t, usize(0))
});
export(type_key, stable_type_identity);
