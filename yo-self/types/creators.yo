//! Type-value constructors and tag accessor.
//!
//! Mirrors `src/types/creators.ts`. Provides:
//!   * `generate_some_type_id` — global counter for fresh SomeType IDs
//!   * `t_unit` / `t_bool` / `t_i32` / … — primitive constructors
//!   * `t_ptr` / `t_array` — pointer/array constructors
//!   * `t_func_simple` / `t_trait` / `t_trait_simple` / `t_module` / `t_module_simple`
//!   * `t_some_t` — SomeType constructor (consumes a fresh id from the counter)
//!   * `t_expr_t` / `t_comptime_list` / `t_effects_row` / `t_type_app` / `t_iso`
//!   * `t_dyn` / `t_dyn_simple` / `t_fn_trait` / `t_fn_trait_simple`
//!   * `t_future_trait` / `t_future_trait_simple`
//!   * `type_value_tag` — extract the `TypeTag` discriminator from a TypeValue
//!
//! Phase A.3.3: this file was split out of the former monolithic `type.yo`,
//! so that yo-self mirrors src/'s split between `definitions.ts` (just the
//! TypeValue enum) and `creators.ts` (constructors).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{ TypeValue, FuncMeta } :: import("./definitions.yo");
{ TypeTag } :: import("./tags.yo");
// ---------------------------------------------------------------------------
// Global counter for generating unique SomeType IDs.
// Mirrors the `IdMap` counter in `src/utils.ts:generateVarialeId`.
// ---------------------------------------------------------------------------
(g_some_type_id_counter : usize) = usize(0);
generate_some_type_id :: (fn() -> String)({
  local_c := g_some_type_id_counter;
  s := local_c.to_string();
  g_some_type_id_counter = (g_some_type_id_counter + usize(1));
  s
});
// ---------------------------------------------------------------------------
// Convenience constructors for primitive and pointer-sized types
// ---------------------------------------------------------------------------
t_unit :: (fn() -> TypeValue)(.Unit);
/// `str` — the builtin static string view (mirrors TS TypeTag.Str: a
/// dedicated fieldless tag; impl registry keys it by id "str").
t_str :: (fn() -> TypeValue)(.Str);
t_bool :: (fn() -> TypeValue)(.BoolT);
t_void :: (fn() -> TypeValue)(.Void);
t_i8 :: (fn() -> TypeValue)(.Int(u8(8), true));
t_i16 :: (fn() -> TypeValue)(.Int(u8(16), true));
t_i32 :: (fn() -> TypeValue)(.Int(u8(32), true));
t_i64 :: (fn() -> TypeValue)(.Int(u8(64), true));
t_u8 :: (fn() -> TypeValue)(.Int(u8(8), false));
t_u16 :: (fn() -> TypeValue)(.Int(u8(16), false));
t_u32 :: (fn() -> TypeValue)(.Int(u8(32), false));
t_u64 :: (fn() -> TypeValue)(.Int(u8(64), false));
t_f32 :: (fn() -> TypeValue)(.Float(u8(32)));
t_f64 :: (fn() -> TypeValue)(.Float(u8(64)));
t_usize :: (fn() -> TypeValue)(.Usize);
t_isize :: (fn() -> TypeValue)(.Isize);
t_comptime_int :: (fn() -> TypeValue)(.ComptimeInt);
t_comptime_float :: (fn() -> TypeValue)(.ComptimeFloat);
t_comptime_string :: (fn() -> TypeValue)(.ComptimeString);
t_type :: (fn() -> TypeValue)(.TypeUni(usize(0)));
// TypeUni(1) — the "kind" for Module and Trait (one level above Type(0))
t_type_1 :: (fn() -> TypeValue)(.TypeUni(usize(1)));
// C-compatible types (platform-dependent size; no compile-time arithmetic)
t_c_char :: (fn() -> TypeValue)(.CChar);
t_c_short :: (fn() -> TypeValue)(.CShort);
t_c_ushort :: (fn() -> TypeValue)(.CUShort);
t_c_int :: (fn() -> TypeValue)(.CInt);
t_c_uint :: (fn() -> TypeValue)(.CUInt);
t_c_long :: (fn() -> TypeValue)(.CLong);
t_c_ulong :: (fn() -> TypeValue)(.CULong);
t_c_longlong :: (fn() -> TypeValue)(.CLongLong);
t_c_ulonglong :: (fn() -> TypeValue)(.CULongLong);
t_c_longdouble :: (fn() -> TypeValue)(.CLongDouble);
t_ptr :: (fn(pointee : TypeValue) -> TypeValue)(.Pointer(pointee));
t_array :: (fn(element : TypeValue, length : usize) -> TypeValue)(
  .Array(element, length, String.from(""))
);
/// Array type whose LENGTH is an unresolved forall variable (`Array(T, U)`
/// with `U : usize` in a forall list). `length` is a placeholder 0; the
/// synthesizer binds `length_var` to the concrete count during matching
/// (mirrors TS ArrayType.length being an UnknownValue with variableName).
t_array_var :: (fn(element : TypeValue, length_var : String) -> TypeValue)(
  .Array(element, usize(0), length_var)
);
// ---------------------------------------------------------------------------
// Convenience constructors for compound types (Phase 2b)
// ---------------------------------------------------------------------------
/// Create a simple function type (no forall, implicit, or where constraints).
t_func_simple :: (
  fn(
    param_labels : ArrayList(String),
    param_types : ArrayList(TypeValue),
    result : TypeValue
  ) -> TypeValue
)(
  .Func(
    ArrayList(TypeValue).new(),
    param_types,
    ArrayList(TypeValue).new(),
    ArrayList(TypeValue).new(),
    result,
    box(
      FuncMeta(
        forall_labels : ArrayList(String).new(),
        param_labels : param_labels,
        implicit_labels : ArrayList(String).new(),
        implicit_spreads : ArrayList(bool).new(),
        result_is_comptime_only : false,
        // simple (runtime) function type
        param_is_ref : ArrayList(bool).new(),
        // no ref params in a synthesized type
        param_is_owning : ArrayList(bool).new(),
        // no own params in a synthesized type
        result_is_ref : false,
        has_variadic : false,
        is_extern : Option(String).None,
        // synthesized types are never FFI
        extern_name : Option(String).None,
        is_control : false // synthesized `fn` type, not `ctl`
      )
    )
  )
);
/// Create a trait type with associated-type names and method/field lists.
t_trait :: (
  fn(
    name : String,
    assoc_names : ArrayList(String),
    field_labels : ArrayList(String),
    field_types : ArrayList(TypeValue)
  ) -> TypeValue
)(
  .TraitT(name, assoc_names, field_labels, field_types, String.from(""), Option(TypeValue).None, ArrayList(TypeValue).new(), ArrayList(TypeValue).new())
);
/// Create a named trait type with no fields.
t_trait_simple :: (fn(name : String) -> TypeValue)(
  .TraitT(name, ArrayList(String).new(), ArrayList(String).new(), ArrayList(TypeValue).new(), String.from(""), Option(TypeValue).None, ArrayList(TypeValue).new(), ArrayList(TypeValue).new())
);
/// Create a module type with field lists.
t_module :: (
  fn(
    name : String,
    field_labels : ArrayList(String),
    field_types : ArrayList(TypeValue)
  ) -> TypeValue
)(
  // Source-namespace STRUCT — TS has no module type (SourceNamespaceType,
  // src/types/definitions.ts:514). plans/MODULE_AS_STRUCT_ALIGNMENT.md.
  .Struct(String.from(""), name, field_labels, field_types, false, false, false, String.from(""), ArrayList(TypeValue).new(), true)
);
/// Create a named module type with no fields.
t_module_simple :: (fn(name : String) -> TypeValue)(
  .Struct(String.from(""), name, ArrayList(String).new(), ArrayList(TypeValue).new(), false, false, false, String.from(""), ArrayList(TypeValue).new(), true)
);
// ---------------------------------------------------------------------------
// Convenience constructors for Phase 2f variants
// ---------------------------------------------------------------------------
t_expr_t :: (fn() -> TypeValue)(.ExprT);
t_comptime_list :: (fn(child : TypeValue) -> TypeValue)(
  .ComptimeListT(child)
);
t_effects_row :: (fn(labels : ArrayList(String), types : ArrayList(TypeValue)) -> TypeValue)(
  .EffectsRowT(labels, types)
);
t_type_app :: (fn(constructor : TypeValue, args : ArrayList(TypeValue)) -> TypeValue)(
  .TypeAppT(constructor, args)
);
t_iso :: (fn(child : TypeValue) -> TypeValue)(
  .IsoT(child)
);
t_dyn :: (
  fn(
    required_trait_types : ArrayList(TypeValue),
    required_trait_levels : ArrayList(usize),
    negative_trait_types : ArrayList(TypeValue),
    negative_trait_levels : ArrayList(usize)
  ) -> TypeValue
)(
  .DynT(required_trait_types, required_trait_levels, negative_trait_types, negative_trait_levels)
);
t_dyn_simple :: (fn(required_trait_types : ArrayList(TypeValue)) -> TypeValue)(
  .DynT(required_trait_types, ArrayList(usize).new(), ArrayList(TypeValue).new(), ArrayList(usize).new())
);
t_fn_trait :: (
  fn(
    base_name : String,
    call_param_labels : ArrayList(String),
    call_param_types : ArrayList(TypeValue),
    call_result : TypeValue,
    implicit_labels : ArrayList(String),
    implicit_types : ArrayList(TypeValue),
    implicit_spreads : ArrayList(bool)
  ) -> TypeValue
)(
  .FnTraitT(base_name, call_param_labels, call_param_types, call_result, implicit_labels, implicit_types, implicit_spreads)
);
t_fn_trait_simple :: (
  fn(
    base_name : String,
    call_param_types : ArrayList(TypeValue),
    call_result : TypeValue
  ) -> TypeValue
)(
  .FnTraitT(base_name, ArrayList(String).new(), call_param_types, call_result, ArrayList(String).new(), ArrayList(TypeValue).new(), ArrayList(bool).new())
);
t_future_trait :: (
  fn(
    base_name : String,
    output : TypeValue,
    effect_labels : ArrayList(String),
    effect_types : ArrayList(TypeValue),
    effect_spreads : ArrayList(bool)
  ) -> TypeValue
)(
  .FutureTraitT(base_name, output, effect_labels, effect_types, effect_spreads)
);
t_future_trait_simple :: (fn(base_name : String, output : TypeValue) -> TypeValue)(
  .FutureTraitT(base_name, output, ArrayList(String).new(), ArrayList(TypeValue).new(), ArrayList(bool).new())
);
/// Create an unconstrained SomeType (generic type variable).
t_some_t :: (fn(name : String, frame_level : usize) -> TypeValue)(
  .SomeT(
    generate_some_type_id(),
    name,
    frame_level,
    .TypeUni(usize(0)),
    ArrayList(TypeValue).new(),
    ArrayList(usize).new(),
    ArrayList(TypeValue).new(),
    ArrayList(usize).new(),
    false,
    Option(TypeValue).None
  )
);
/// Create a SomeType with a `kind_function_type` set — represents a
/// higher-kinded type variable like `F : (fn(T : Type) -> Type)`.
/// `kind` must be a `Func` TypeValue. Mirrors TS's `SomeType.kindFunctionType`
/// path; used by `evaluate_function_parameter` when binding HKT-kinded
/// forall params so `F(A)` can later be evaluated as a TypeApplication.
t_some_t_with_kind :: (fn(name : String, frame_level : usize, kind : TypeValue) -> TypeValue)(
  .SomeT(
    generate_some_type_id(),
    name,
    frame_level,
    .TypeUni(usize(0)),
    ArrayList(TypeValue).new(),
    ArrayList(usize).new(),
    ArrayList(TypeValue).new(),
    ArrayList(usize).new(),
    false,
    Option(TypeValue).Some(kind)
  )
);
// ---------------------------------------------------------------------------
// Tag accessor — useful for fast dispatch and equality short-circuits.
// ---------------------------------------------------------------------------
type_value_tag :: (fn(t : TypeValue) -> TypeTag)(
  match(
    t,
    .Unit => TypeTag.TUnit,
    .BoolT => TypeTag.TBool,
    .Void => TypeTag.TVoid,
    .Int(bits, signed) => cond(
      signed => cond(
        (bits == u8(8)) => TypeTag.TI8,
        (bits == u8(16)) => TypeTag.TI16,
        (bits == u8(32)) => TypeTag.TI32,
        true => TypeTag.TI64
      ),
      true => cond(
        (bits == u8(8)) => TypeTag.TU8,
        (bits == u8(16)) => TypeTag.TU16,
        (bits == u8(32)) => TypeTag.TU32,
        true => TypeTag.TU64
      )
    ),
    .Float(bits) => cond(
      (bits == u8(32)) => TypeTag.TF32,
      true => TypeTag.TF64
    ),
    .Usize => TypeTag.TUsize,
    .Isize => TypeTag.TIsize,
    .ComptimeInt => TypeTag.TComptimeInt,
    .ComptimeFloat => TypeTag.TComptimeFloat,
    .ComptimeString => TypeTag.TComptimeString,
    .CChar => TypeTag.TCChar,
    .CShort => TypeTag.TCShort,
    .CUShort => TypeTag.TCUShort,
    .CInt => TypeTag.TCInt,
    .CUInt => TypeTag.TCUInt,
    .CLong => TypeTag.TCLong,
    .CULong => TypeTag.TCULong,
    .CLongLong => TypeTag.TCLongLong,
    .CULongLong => TypeTag.TCULongLong,
    .CLongDouble => TypeTag.TCLongDouble,
    .TypeUni(_) => TypeTag.TType,
    .Pointer(_) => TypeTag.TPtr,
    .Str => TypeTag.TStr,
    .Array(_, _, _) => TypeTag.TArray,
    .Tuple(_, _) => TypeTag.TTuple,
    .Func({ result : _ }) => TypeTag.TFunction,
    // Source-namespace structs keep the TModule tag (yo-self TypeTag is
    // internal; TS has no module tag at all).
    .Struct({ is_source_namespace : sns_tag }) => cond(sns_tag => TypeTag.TModule, true => TypeTag.TStruct),
    .EnumT(_, _, _, _, _, _, _, _, _) => TypeTag.TEnum,
    .Union(_, _, _) => TypeTag.TUnion,
    .TraitT(name : _) => TypeTag.TTrait,
    .SomeT(name : _) => TypeTag.TSomeType,
    .ExprT => TypeTag.TExpr,
    .ComptimeListT(_) => TypeTag.TComptimeList,
    .EffectsRowT(_, _) => TypeTag.TEffectsRow,
    .TypeAppT(_, _) => TypeTag.TTypeApplication,
    .IsoT(_) => TypeTag.TIso,
    .DynT(_, _, _, _) => TypeTag.TDyn,
    .FnTraitT(base_name : _) => TypeTag.TTrait,
    .FutureTraitT(base_name : _) => TypeTag.TTrait
  )
);
/// Replace an empty-variant/empty-field `Self` shell (matched by id +
/// emptiness) with `final_ty` anywhere inside `t`. One-level rebuild over
/// the standard type containers; the inserted `final_ty` itself still
/// carries shells one level deeper — those resolve via the enum/struct-final
/// registries at use sites (resolve_enum_shell / resolve_struct_shell).
/// Shared by enum.yo (recursive enums) and struct.yo (recursive structs);
/// the `shell_id` passed at the call site is unique per type, so the
/// enum and struct arms never cross-fire.
_patch_self_shell :: (
  fn(t : TypeValue, shell_id : String, final_ty : TypeValue) -> TypeValue
)(
  match(
    t,
    .EnumT({ id, name, variant_names, variant_fields, selected_variant_name, variant_field_labels, variant_discriminants, is_reference_semantics, is_atomic_rc }) => cond(
      ((id == shell_id) && (variant_names.len() == usize(0))) => final_ty,
      // Recurse into every variant field so a shell nested inside a generic
      // enum instantiation (e.g. `Option(Self)` / `Result(Self, E)`) is patched
      // too. Mirrors the `.Struct` branch below — EnumT has no separate
      // type_arguments list, the instantiated element types live in the variant
      // fields. Without this, the shell inside `Option(Self)` stays an empty
      // placeholder and `can_type_form_rc_cycle` never reaches back to the root.
      true => {
        new_vfs := ArrayList(ArrayList(TypeValue)).new();
        (vi : usize) = usize(0);
        while(vi < variant_fields.len(), {
          inner := match(variant_fields.get(vi),.Some(x) => x,.None => ArrayList(TypeValue).new());
          new_inner := ArrayList(TypeValue).new();
          (fi : usize) = usize(0);
          while(fi < inner.len(), {
            ft := match(inner.get(fi),.Some(x) => x,.None => t_unit());
            new_inner.push(recur(ft, shell_id, final_ty));
            fi = (fi + usize(1));
          });
          new_vfs.push(new_inner);
          vi = (vi + usize(1));
        });
        .EnumT(id, name, variant_names, new_vfs, selected_variant_name, variant_field_labels, variant_discriminants, is_reference_semantics, is_atomic_rc)
      }
    ),
    .Pointer(inner) =>.Pointer(recur(inner, shell_id, final_ty)),
    .Array(el, n, lv) =>.Array(recur(el, shell_id, final_ty), n, lv),
    .ComptimeListT(el) =>.ComptimeListT(recur(el, shell_id, final_ty)),
    .Struct({ id, name, field_labels, field_types, is_reference_semantics, is_atomic_rc, is_newtype, constructor_func_id, type_arguments, is_source_namespace }) => cond(
      ((id == shell_id) && (field_types.len() == usize(0))) => final_ty,
      true => {
        new_fts := ArrayList(TypeValue).new();
        (i : usize) = usize(0);
        while(i < field_types.len(), {
          ft := match(field_types.get(i),.Some(x) => x,.None => t_unit());
          new_fts.push(recur(ft, shell_id, final_ty));
          i = (i + usize(1));
        });
        new_tas := ArrayList(TypeValue).new();
        (j : usize) = usize(0);
        while(j < type_arguments.len(), {
          ta := match(type_arguments.get(j),.Some(x) => x,.None => t_unit());
          new_tas.push(recur(ta, shell_id, final_ty));
          j = (j + usize(1));
        });
        .Struct(id, name, field_labels, new_fts, is_reference_semantics, is_atomic_rc, is_newtype, constructor_func_id, new_tas, is_source_namespace)
      }
    ),
    _ => t
  )
);
// Enum finalization side-table: `enum_id -> finalized EnumT`. During an
// enum's own definition, `Self` is bound to a PRELIMINARY empty-variant
// shell (enum.yo). TS mutates one object in place, so anything that
// captured `Self` sees the populated fields later;
// yo-self TypeValues are value-typed snapshots, so leaked shells keep 0
// variants forever (e.g. `ArrayList(Self)` instantiations CACHED with the
// shell element — "Cannot unify incompatible enum types" with a 0-variant
// side, std/encoding/json.yo). The registry lets use sites swap a shell
// for its final form BY ID — the faithful value-semantics mirror of TS's
// object identity.
EnumFinalEntry :: struct(enum_id : String, ty : TypeValue);
(g_enum_finals : ArrayList(EnumFinalEntry)) = ArrayList(EnumFinalEntry).new();
register_enum_final :: (fn(enum_id : String, ty : TypeValue) -> unit)({
  if(enum_id.len() > usize(0), {
    g_enum_finals.push(EnumFinalEntry(enum_id : enum_id, ty : ty));
  });
});
/// Resolve an empty-variant EnumT shell to its finalized form (no-op for
/// non-enums, populated enums, and unknown ids).
resolve_enum_shell :: (fn(t : TypeValue) -> TypeValue)(
  match(
    t,
    .EnumT(eid, _, vns, _, _, _, _, _, _) => {
      if(vns.len() > usize(0), {
        return(t);
      });
      (i : usize) = usize(0);
      n := g_enum_finals.len();
      (r : Option(TypeValue)) = Option(TypeValue).None;
      while((i < n) && r.is_none(), {
        match(
          g_enum_finals.get(i),
          .Some(e) => if(e.enum_id == eid, {
            r = Option(TypeValue).Some(e.ty);
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      match(r,.Some(f) => f,.None => t)
    },
    _ => t
  )
);
// Struct finalization side-table: `struct_id -> finalized Struct`. During a
// struct's own definition `Self` is bound to a PRELIMINARY empty-field shell
// (struct.yo) carrying the SAME `struct_id` as the final (UNLIKE enum.yo,
// which uses a distinct `__self_shell` id). The shell is distinguished from
// the final purely by its EMPTY field list, so id-based comparisons treat
// shell and final as one type for free and only FIELD-reading sites must
// resolve. yo-self TypeValues are value-typed snapshots, so a leaked shell
// keeps 0 fields forever (`box.*.field` on recursive structs like Variable
// degenerates to unit); the registry lets field-read sites swap a 0-field
// shell for its final form BY ID — the value-semantics mirror of TS's
// in-place object mutation.
StructFinalEntry :: struct(struct_id : String, ty : TypeValue);
(g_struct_finals : ArrayList(StructFinalEntry)) = ArrayList(StructFinalEntry).new();
register_struct_final :: (fn(struct_id : String, ty : TypeValue) -> unit)({
  if(struct_id.len() > usize(0), {
    g_struct_finals.push(StructFinalEntry(struct_id : struct_id, ty : ty));
  });
});
/// Resolve an empty-field Struct shell to its finalized form (no-op for
/// non-structs, populated structs, and unknown ids).
resolve_struct_shell :: (fn(t : TypeValue) -> TypeValue)(
  match(
    t,
    .Struct({ id : sid, field_types : fts }) => {
      if(fts.len() > usize(0), {
        return(t);
      });
      (i : usize) = usize(0);
      n := g_struct_finals.len();
      (r : Option(TypeValue)) = Option(TypeValue).None;
      while((i < n) && r.is_none(), {
        match(
          g_struct_finals.get(i),
          .Some(e) => if(e.struct_id == sid, {
            r = Option(TypeValue).Some(e.ty);
          }),
          .None => ()
        );
        i = (i + usize(1));
      });
      match(r,.Some(f) => f,.None => t)
    },
    _ => t
  )
);

export(register_enum_final, resolve_enum_shell, _patch_self_shell);
export(register_struct_final, resolve_struct_shell);
export(
  generate_some_type_id,
  t_unit,
  t_str,
  t_bool,
  t_void,
  t_i8,
  t_i16,
  t_i32,
  t_i64,
  t_u8,
  t_u16,
  t_u32,
  t_u64,
  t_f32,
  t_f64,
  t_usize,
  t_isize,
  t_comptime_int,
  t_comptime_float,
  t_comptime_string,
  t_type,
  t_type_1,
  t_c_char,
  t_c_short,
  t_c_ushort,
  t_c_int,
  t_c_uint,
  t_c_long,
  t_c_ulong,
  t_c_longlong,
  t_c_ulonglong,
  t_c_longdouble,
  t_ptr,
  t_array,
  t_array_var,
  t_func_simple,
  t_trait,
  t_trait_simple,
  t_module,
  t_module_simple,
  t_some_t,
  t_some_t_with_kind,
  t_expr_t,
  t_comptime_list,
  t_effects_row,
  t_type_app,
  t_iso,
  t_dyn,
  t_dyn_simple,
  t_fn_trait,
  t_fn_trait_simple,
  t_future_trait,
  t_future_trait_simple,
  type_value_tag
);
