//! Flowability check for `ref(T)`-yielding expressions.
//!
//! 1:1 port of `src/types/flowability.ts`. Implements the structural soundness
//! rule from `plans/ITERATOR_REDESIGN.md`: an expression is "flowable" iff it
//! roots back to a `ref`-bound parameter (or another `ref`-bound local with a
//! flowable initializer) along a projection-respecting chain.
//!
//! Rules (numbered to match the plan):
//!   R1.  A name reference is flowable iff its binding `is_ref`.
//!   R2.  `expr.field` is flowable iff `expr` is flowable.
//!   R3.  `expr(args)` is flowable iff the callee's return slot is `ref(T)`
//!        AND every `ref`-typed argument it receives is itself flowable.
//!   R4.  `cond` / `match` arms each return-flow independently.
//!
//! yo-self adaptations of the TS shape:
//!   * The evaluated `ExprInfo` (TS `expr.$`) is looked up in
//!     `ctx.expr_info_table` by expr id, so this takes an `EvalContext`.
//!   * TS resolves the callee `FunctionType` from `call.func.$.value`
//!     (a `FunctionValue.type`) or `call.func.$.type`. yo-self's `FuncVal`
//!     carries no type, but the callee expr's `ExprInfo.ty` holds the `Func`
//!     type in both the direct-call and method-call cases, so we read that.
//!   * Options are passed as a `FlowOptions` object (TS used an options bag).
open(import("std/string"));
{ ArrayList } :: import("std/collections/array_list");
{
  AstExpr,
  ast_expr_token,
  ast_expr_id,
  ast_expr_is_atom,
  ast_expr_is_fn_call,
  ast_expr_is_fn_call_of,
  BK_BEGIN,
  BK_TUPLE,
  BF_DOT,
  BF_PANIC,
  BF_UNSAFE,
  make_err_expr
} :: import("../expr.yo");
{ ExprInfo, expr_info_table_get, has_any_control_flow, lookup_method_callee_type }
:: import("../expr_info.yo");
{ Variable, Environment, RefBorrowMark, get_variables_from_env } :: import("../env.yo");
{ format_error_message } :: import("../error.yo");
{ Exception } :: import("std/error");
{ is_type_val } :: import("../value.yo");
{ EvalContext } :: import("../evaluator/context.yo");
{ TypeValue } :: import("./definitions.yo");
{ is_function_type } :: import("./guards.yo");
{ type_may_provide_slice_source, type_representation_contains_raw_ptr }
:: import("./utils.yo");
/// A 1-element mutable box flagging that an error thrown during a swallowed
/// def-time body eval is a deliberate flow-soundness REJECTION (a
/// `ref(name) := …` non-flowable RHS), not an unported-feature eval error.
/// `_trial_eval_fn_body`'s handler cannot capture the real outer `exn` (effect
/// handlers are capture-free `->` functions), so instead: the binding-site
/// flags the violation before throwing; the throw is swallowed as usual; then
/// the def-time CALLER re-raises it via the real `exn` after the trial eval
/// returns. TS reaches the same rejection because its def-time body eval
/// propagates errors. An `ArrayList` mutated only inside the top-level
/// `flag_/clear_` fns is used rather than a reassignable global, so yo-self can
/// check this very source (which forbids reassigning a module-level global from
/// inside a closure).
(g_flow_violation_box : ArrayList(bool)) = ArrayList(bool).new();
/// Parallel 1-element box holding the rejection's message, so the def-time
/// caller re-raises the SAME diagnostic the swallowed throw would have.
(g_flow_violation_msg : ArrayList(String)) = ArrayList(String).new();
/// Mark that the error about to be thrown is a flow-soundness rejection,
/// recording its message for the def-time re-raise.
flag_flow_violation :: (fn(msg : String) -> unit)({
  g_flow_violation_box.clear();
  _ := g_flow_violation_box.push(true);
  g_flow_violation_msg.clear();
  _ := g_flow_violation_msg.push(msg);
  ()
});
/// Reset the flag (called before each def-time body eval and after each catch).
clear_flow_violation :: (fn() -> unit)({
  g_flow_violation_box.clear();
  g_flow_violation_msg.clear();
  ()
});
/// True iff a flow-soundness rejection was flagged since the last reset.
flow_violation_pending :: (fn() -> bool)(
  match(g_flow_violation_box.get(usize(0)),.Some(v) => v,.None => false)
);
/// The flagged rejection's message (empty if none).
flow_violation_message :: (fn() -> String)(
  match(g_flow_violation_msg.get(usize(0)),.Some(m) => m,.None => String.from(""))
);
/// "Propagate all def-time body-eval errors" mode. Normally `_trial_eval_fn_body`
/// SWALLOWS any error thrown while evaluating a function body at definition time
/// (the def-eval wall: it masks yo-self's own porting-gap false-positives so
/// `check` stays green). But `comptime_expect_error(expr)` must OBSERVE such an
/// error — TS uses a plain `try { evaluate(expr) } catch { ok }`
/// (comptime-expect-error.ts:23-42) and the def-time body eval propagates there.
/// While this flag is set (only around a `comptime_expect_error` argument eval),
/// the def-time caller re-raises a swallowed body error via the real `exn` so it
/// reaches the `comptime_expect_error` catch. The flag is a global box (not a
/// ctx field) for the same reason as `g_flow_violation_box`: it must survive the
/// child-context construction at each call frame, and yo-self forbids reassigning
/// a module-level global from inside a closure. comptime_expect_error sets it
/// false again deterministically (the eval's local-unwinding exn returns control
/// to the caller, which clears it), so no non-expect-error path is affected.
(g_propagate_def_time_errors_box : ArrayList(bool)) = ArrayList(bool).new();
/// Enter/leave "propagate all def-time body-eval errors" mode.
set_propagate_def_time_errors :: (fn(on : bool) -> unit)({
  g_propagate_def_time_errors_box.clear();
  _ := g_propagate_def_time_errors_box.push(on);
  ()
});
/// True iff def-time body-eval errors should propagate (set during a
/// `comptime_expect_error` argument eval).
propagate_def_time_errors :: (fn() -> bool)(
  match(g_propagate_def_time_errors_box.get(usize(0)),.Some(v) => v,.None => false)
);
/// Options refining the base R1–R4 rule. Mirrors the TS options bag.
FlowOptions :: object(
  /// Accept a same-frame (non-module) local — the `ref(name) := …` binding
  /// site. Bounded by `max_local_frame_level` when that is `.Some`.
  allow_same_frame_local : bool,
  /// Accept a parameter of the enclosing function (slice-flowability).
  allow_parameter_source : bool,
  /// Accept a `comptime`-bound name / string-ish literal (slice-flowability).
  allow_comptime_source : bool,
  /// Scope bound for `allow_same_frame_local` (the assignment target's frame
  /// level); a same-frame local is accepted only if its level is no deeper.
  max_local_frame_level : Option(usize)
);
/// Default options (strict R1–R4, the function-return enforcement form).
flow_options_default :: (fn() -> FlowOptions)(
  FlowOptions(
    allow_same_frame_local : false,
    allow_parameter_source : false,
    allow_comptime_source : false,
    max_local_frame_level : Option(usize).None
  )
);
/// Strip outer `begin(...)` wrapper(s) — single-expression bodies after
/// evaluation often appear as `begin((expr))`. Mirrors `unwrapBeginBlocks`.
_unwrap_begin_blocks :: (fn(expr : AstExpr) -> AstExpr)({
  (current : AstExpr) = expr;
  (go : bool) = true;
  while(go, {
    if(ast_expr_is_fn_call(current) && ast_expr_is_fn_call_of(current, BK_BEGIN, Option(usize).None), {
      args := match(current,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
      if(args.len() == usize(0), {
        go = false;
      }, {
        current = match(args.get(args.len() - usize(1)),.Some(a) => a,.None => current);
      });
    }, {
      go = false;
    });
  });
  current
});
/// Look up the evaluated `ExprInfo` for `expr` (TS `expr.$`).
_info :: (fn(ctx : EvalContext, expr : AstExpr) -> Option(ExprInfo))(
  expr_info_table_get(ctx.expr_info_table, ast_expr_id(expr))
);
/// Walk `expr` and return `true` iff it satisfies R1–R4. `expr` must already be
/// evaluated (so its `ExprInfo` and bindings are available). Mirrors
/// `isFlowableExpr` in `src/types/flowability.ts`.
is_flowable_expr :: (fn(expr_in : AstExpr, ctx : EvalContext, opts : FlowOptions) -> bool)({
  expr := _unwrap_begin_blocks(expr_in);
  // Strip a `label : value` wrapper — labeled arguments (constructor fields
  // `Identifier(name : "x")`, named call args) are transparent for flow
  // purposes; the VALUE side is what flows. Mirrors flowability.ts.
  if(ast_expr_is_fn_call(expr) && ast_expr_is_fn_call_of(expr, ":",.Some(usize(2))), {
    labeled_args := match(expr,.FnCall(_, _, la, _, _) => la, _ => ArrayList(AstExpr).new());
    match(
      labeled_args.get(usize(1)),
      .Some(lv) => {
        return(recur(lv, ctx, opts));
      },
      .None => ()
    );
  });
  // Divergent expressions never yield a value here — accept vacuously.
  info_opt := _info(ctx, expr);
  has_cf := match(info_opt,.Some(i) => has_any_control_flow(i.control_flow),.None => false);
  if(has_cf, {
    return(true);
  });
  if(ast_expr_is_fn_call(expr) && ast_expr_is_fn_call_of(expr, BF_PANIC, Option(usize).None), {
    return(true);
  });
  // Trusted escape hatch: `unsafe(expr)` in privileged code is flowable.
  if(ast_expr_is_fn_call(expr) && ast_expr_is_fn_call_of(expr, BF_UNSAFE, Option(usize).None), {
    return(true);
  });
  // R1: bare name → check binding flags.
  if(ast_expr_is_atom(expr), {
    tok := ast_expr_token(expr);
    // Literal atoms (string/char/template-string) live in static storage.
    if(opts.allow_comptime_source, {
      is_lit := match(
        tok.kind,
        .StringLit => true,
        .CharLit => true,
        .TemplateString => true,
        _ => false
      );
      if(is_lit, {
        return(true);
      });
    });
    info := match(
      info_opt,
      .Some(i) => i,
      .None => {
        return(false);
      }
    );
    var_name := match(
      info.variable_name,
      .Some(n) => n,
      .None => {
        return(false);
      }
    );
    vars := get_variables_from_env(info.env, var_name);
    if(vars.len() == usize(0), {
      return(false);
    });
    v := match(
      vars.get(vars.len() - usize(1)),
      .Some(x) => x,
      .None => {
        return(false);
      }
    );
    if(v.is_ref, {
      return(true);
    });
    // R1' (binding-site only): a same-frame non-module local, bounded by
    // `max_local_frame_level` when set.
    if(opts.allow_same_frame_local && !(v.is_module_level), {
      ok := match(
        opts.max_local_frame_level,
        .None => true,
        .Some(maxl) => (v.frame_level <= maxl)
      );
      if(ok, {
        return(true);
      });
    });
    // R1'' (slice-flowability): a parameter of the enclosing function.
    if(opts.allow_parameter_source && v.is_parameter, {
      return(true);
    });
    // R1''' (slice-flowability): a comptime-bound name (static storage).
    if(opts.allow_comptime_source && v.is_compile_time_only, {
      return(true);
    });
    return(false);
  });
  if(!(ast_expr_is_fn_call(expr)), {
    return(false);
  });
  call_func := match(expr,.FnCall(_, f, _, _, _) => f.*, _ => expr);
  call_args := match(expr,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
  // R2: `expr.field` — a 2-arg `.` call. Flowable iff the base is flowable.
  if(ast_expr_is_fn_call_of(expr, BF_DOT, Option(usize).Some(usize(2))), {
    base := match(
      call_args.get(usize(0)),
      .Some(a) => a,
      .None => {
        return(false);
      }
    );
    // A `.`/2 whose receiver evaluates to a TYPE is a no-argument qualified
    // variant constructor (`Option(str).None`), NOT a field projection — it
    // carries no smuggled pointer, so it is flowable. Mirrors flowability.ts.
    base_is_type := match(
      _info(ctx, base),
      .Some(bi) => match(bi.value,.Some(bv) => is_type_val(bv),.None => false),
      .None => false
    );
    if(base_is_type, {
      return(true);
    });
    return(recur(base, ctx, opts));
  });
  // R4: `cond(arm1, arm2, …)` — every `=>` arm body must be flowable.
  if(ast_expr_is_fn_call_of(expr, "cond", Option(usize).None), {
    (i : usize) = usize(0);
    while(i < call_args.len(), {
      arm := match(call_args.get(i),.Some(a) => a,.None => make_err_expr());
      if(ast_expr_is_fn_call(arm) && ast_expr_is_fn_call_of(arm, "=>", Option(usize).Some(usize(2))), {
        arm_args := match(arm,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
        arm_body := match(arm_args.get(usize(1)),.Some(a) => a,.None => make_err_expr());
        if(!(recur(arm_body, ctx, opts)), {
          return(false);
        });
      }, {
        return(false);
      });
      i = (i + usize(1));
    });
    return(true);
  });
  // R4 (match form): `match(scrutinee, .Variant => arm, …)` — arms are args 1+.
  if(ast_expr_is_fn_call_of(expr, "match", Option(usize).None), {
    (i : usize) = usize(1);
    while(i < call_args.len(), {
      arm := match(call_args.get(i),.Some(a) => a,.None => make_err_expr());
      if(ast_expr_is_fn_call(arm) && ast_expr_is_fn_call_of(arm, "=>", Option(usize).Some(usize(2))), {
        arm_args := match(arm,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
        arm_body := match(arm_args.get(usize(1)),.Some(a) => a,.None => make_err_expr());
        if(!(recur(arm_body, ctx, opts)), {
          return(false);
        });
      }, {
        return(false);
      });
      i = (i + usize(1));
    });
    return(true);
  });
  // Pointer arithmetic: `base &+ off` / `base &- off` yields a pointer into the
  // SAME storage as `base`. Flowable iff `base` is flowable.
  if(ast_expr_is_fn_call_of(expr, "&+", Option(usize).Some(usize(2))) ||
    ast_expr_is_fn_call_of(expr, "&-", Option(usize).Some(usize(2))), {
    base := match(
      call_args.get(usize(0)),
      .Some(a) => a,
      .None => {
        return(false);
      }
    );
    return(recur(base, ctx, opts));
  });
  // Enum/variant construction: `.Variant(args…)` — `call.func` is a `.`/1 call
  // or a `.`-typed atom. Flowable iff every arg whose representation carries a
  // raw pointer is flowable. ALSO the QUALIFIED applied form `Enum.Variant(args)`
  // (`Option(str).Some("a")`): `call.func` is a `.`/2 selector whose receiver
  // evaluates to a TYPE. Its selector node carries no resolved constructor Func
  // type, so the R3 path below can't resolve it; detect it here and check args.
  // Mirrors flowability.ts.
  is_qualified_variant_ctor := cond(
    (ast_expr_is_fn_call(call_func) && ast_expr_is_fn_call_of(call_func, BF_DOT, Option(usize).Some(usize(2)))) => {
      qrecv := match(
        call_func,
        .FnCall(_, _, cf_args, _, _) => match(cf_args.get(usize(0)),.Some(r) => r,.None => make_err_expr()),
        _ => make_err_expr()
      );
      match(
        _info(ctx, qrecv),
        .Some(qi) => match(qi.value,.Some(qv) => is_type_val(qv),.None => false),
        .None => false
      )
    },
    true => false
  );
  // Plain struct/type constructor: the CALLEE itself evaluates to a TYPE
  // value (`Identifier(name : "x")` where `Identifier :: struct(name : str)`).
  // Same reasoning as the variant-ctor forms: a freshly constructed value can
  // only carry a raw pointer through its arguments. Mirrors flowability.ts
  // `isTypeCtorCall`.
  is_type_ctor_call := match(
    _info(ctx, call_func),
    .Some(cfi) => match(cfi.value,.Some(cfv) => is_type_val(cfv),.None => false),
    .None => false
  );
  is_variant_ctor := (
    (ast_expr_is_fn_call(call_func) && ast_expr_is_fn_call_of(call_func, BF_DOT, Option(usize).Some(usize(1)))) ||
      (ast_expr_is_atom(call_func) && match(ast_expr_token(call_func).kind,.Dot => true, _ => false))
      || (is_qualified_variant_ctor || is_type_ctor_call)
  );
  if(is_variant_ctor, {
    (i : usize) = usize(0);
    while(i < call_args.len(), {
      (a : AstExpr) = match(call_args.get(i),.Some(x) => x,.None => make_err_expr());
      // Look THROUGH a `label : value` wrapper: the labeled pair node may
      // carry no ExprInfo type of its own, which would silently SKIP the
      // check and accept a constructor smuggling a local-backed slice
      // (`SliceWrapper(s : local_slice)`). The VALUE side is what flows.
      // Mirrors flowability.ts.
      if(ast_expr_is_fn_call(a) && ast_expr_is_fn_call_of(a, ":",.Some(usize(2))), {
        a = match(
          a,
          .FnCall(_, _, la2, _, _) => match(la2.get(usize(1)),.Some(v) => v,.None => a),
          _ => a
        );
      });
      a_ty_opt := match(_info(ctx, a),.Some(inf) => Option(TypeValue).Some(inf.ty),.None => Option(TypeValue).None);
      needs := match(a_ty_opt,.Some(t) => type_representation_contains_raw_ptr(t),.None => false);
      if(needs && !(recur(a, ctx, opts)), {
        return(false);
      });
      i = (i + usize(1));
    });
    return(true);
  });
  // Tuple construction `(e0, e1, …)` (a `tuple(...)` call): flowable iff every
  // element whose representation carries a raw pointer is flowable. Needed for
  // destructuring-assignment RHS `(a, b) = (seed, 1)`. Mirrors flowability.ts.
  if(ast_expr_is_fn_call(expr) && ast_expr_is_fn_call_of(expr, BK_TUPLE, Option(usize).None), {
    (ti : usize) = usize(0);
    while(ti < call_args.len(), {
      (te : AstExpr) = match(call_args.get(ti),.Some(x) => x,.None => make_err_expr());
      if(ast_expr_is_fn_call(te) && ast_expr_is_fn_call_of(te, ":",.Some(usize(2))), {
        te = match(
          te,
          .FnCall(_, _, tla, _, _) => match(tla.get(usize(1)),.Some(v) => v,.None => te),
          _ => te
        );
      });
      te_ty_opt := match(_info(ctx, te),.Some(inf) => Option(TypeValue).Some(inf.ty),.None => Option(TypeValue).None);
      te_needs := match(te_ty_opt,.Some(t) => type_representation_contains_raw_ptr(t),.None => false);
      if(te_needs && !(recur(te, ctx, opts)), {
        return(false);
      });
      ti = (ti + usize(1));
    });
    return(true);
  });
  // R3: regular function call. Resolve the callee `Func` type from the callee
  // expr's ExprInfo.ty (holds the Func type for both direct + method calls in
  // yo-self). The receiver of a method call (`call_func` args[0]) is the
  // implicit first argument.
  is_method_call := ast_expr_is_fn_call_of(call_func, BF_DOT, Option(usize).Some(usize(2)));
  // The callee's Func type comes from its ExprInfo (set for direct calls). For
  // a METHOD call the `.`/2 callee sub-expr has no Func-typed ExprInfo, so fall
  // back to the method-callee side-table (keyed by this CALL's expr id,
  // populated during method dispatch). Mirrors TS `call.func.$.type`.
  callee_ty_opt := match(
    _info(ctx, call_func),
    .Some(inf) => Option(TypeValue).Some(inf.ty),
    .None => lookup_method_callee_type(ast_expr_id(expr))
  );
  callee_ty := match(
    callee_ty_opt,
    .Some(t) => t,
    .None => {
      return(false);
    }
  );
  if(!(is_function_type(callee_ty)), {
    return(false);
  });
  // Extract the Func's return/ref/param info.
  is_ref_return := match(callee_ty,.Func({ result_is_ref : r }) => r, _ => false);
  ret_ty := match(callee_ty,.Func({ result : rb }) => rb.*, _ => TypeValue.Unit);
  _slice_pre := (opts.allow_parameter_source && !(is_ref_return));
  is_slice_return := (_slice_pre && type_representation_contains_raw_ptr(ret_ty));
  if(!(is_ref_return) && !(is_slice_return), {
    return(false);
  });
  param_types := match(callee_ty,.Func({ param_types : pts }) => pts, _ => ArrayList(TypeValue).new());
  param_is_ref := match(callee_ty,.Func({ param_is_ref : pir }) => pir, _ => ArrayList(bool).new());
  // Build the effective argument list (receiver as implicit arg 0 for methods).
  eff_args := ArrayList(AstExpr).new();
  if(is_method_call, {
    cf_args := match(call_func,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
    match(
      cf_args.get(usize(0)),
      .Some(recv) => {
        _r := eff_args.push(recv);
      },
      .None => ()
    );
  });
  (ai : usize) = usize(0);
  while(ai < call_args.len(), {
    match(
      call_args.get(ai),
      .Some(a) => {
        _r := eff_args.push(a);
      },
      .None => ()
    );
    ai = (ai + usize(1));
  });
  // For every ref-typed param (or, in slice mode, a slice-source-capable param),
  // the corresponding argument must be flowable.
  (pi : usize) = usize(0);
  (all_ok : bool) = true;
  while((pi < param_types.len()) && all_ok, {
    p_is_ref := match(param_is_ref.get(pi),.Some(b) => b,.None => false);
    p_ty := match(param_types.get(pi),.Some(t) => t,.None => TypeValue.Unit);
    _slice_src := (is_slice_return && type_may_provide_slice_source(p_ty));
    needs_check := (p_is_ref || _slice_src);
    if(needs_check, {
      match(
        eff_args.get(pi),
        .Some(a) => {
          if(!(recur(a, ctx, opts)), {
            all_ok = false;
          });
        },
        .None => {
          all_ok = false;
        }
      );
    });
    pi = (pi + usize(1));
  });
  all_ok
});
/// Collect the LOCAL VARIABLES a `ref(name) := rhs;` borrow roots in.
///
/// Walks the same structure `is_flowable_expr` accepts (R1 names, R2
/// projections, R3 borrowing-call arguments incl. method receivers, R4
/// cond/match arms, `&+`/`&-` bases, `unsafe(...)` interiors) and pushes
/// every same-frame variable that can be the borrow's backing into `out`.
/// `ref`-bound parameters are NOT collected — their backing lives in a
/// caller frame and cannot be invalidated by anything this scope does.
/// Mirrors `collectRefBorrowSources` in src/evaluator/types/flowability.ts.
collect_ref_borrow_sources :: (
  fn(
    expr_in : AstExpr,
    ctx : EvalContext,
    out : ArrayList(Variable)
  ) -> unit
)({
  expr := _unwrap_begin_blocks(expr_in);
  if(ast_expr_is_fn_call(expr) && ast_expr_is_fn_call_of(expr, ":", Option(usize).Some(usize(2))), {
    largs := match(expr,.FnCall(_, _, la, _, _) => la, _ => ArrayList(AstExpr).new());
    match(
      largs.get(usize(1)),
      .Some(lv) => {
        recur(lv, ctx, out);
        return(());
      },
      .None => ()
    );
  });
  // R1: bare name — collect the variable unless it is a ref-bound param.
  if(ast_expr_is_atom(expr), {
    info := match(
      _info(ctx, expr),
      .Some(i) => i,
      .None => {
        return(());
      }
    );
    var_name := match(
      info.variable_name,
      .Some(n) => n,
      .None => {
        return(());
      }
    );
    vars := get_variables_from_env(info.env, var_name);
    if(vars.len() == usize(0), {
      return(());
    });
    v := match(
      vars.get(vars.len() - usize(1)),
      .Some(x) => x,
      .None => {
        return(());
      }
    );
    if(!(v.is_ref), {
      out.push(v);
    });
    return(());
  });
  if(!(ast_expr_is_fn_call(expr)), {
    return(());
  });
  call_func := match(expr,.FnCall(_, f, _, _, _) => f.*, _ => expr);
  call_args := match(expr,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
  // unsafe(...) — collect inside the trusted interior.
  if(ast_expr_is_fn_call_of(expr, BF_UNSAFE, Option(usize).None), {
    (ui : usize) = usize(0);
    while(ui < call_args.len(), {
      match(
        call_args.get(ui),
        .Some(a) => {
          recur(a, ctx, out);
        },
        .None => ()
      );
      ui = (ui + usize(1));
    });
    return(());
  });
  // R2: projection — collect from the base (TYPE receivers are variant ctors).
  if(ast_expr_is_fn_call_of(expr, BF_DOT, Option(usize).Some(usize(2))), {
    base := match(
      call_args.get(usize(0)),
      .Some(a) => a,
      .None => {
        return(());
      }
    );
    base_is_type := match(
      _info(ctx, base),
      .Some(bi) => match(bi.value,.Some(bv) => is_type_val(bv),.None => false),
      .None => false
    );
    if(!(base_is_type), {
      recur(base, ctx, out);
    });
    return(());
  });
  // R4: cond/match — collect from every arm body.
  if(ast_expr_is_fn_call_of(expr, "cond", Option(usize).None), {
    (ci : usize) = usize(0);
    while(ci < call_args.len(), {
      arm := match(call_args.get(ci),.Some(a) => a,.None => make_err_expr());
      if(ast_expr_is_fn_call(arm) && ast_expr_is_fn_call_of(arm, "=>", Option(usize).Some(usize(2))), {
        arm_args := match(arm,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
        match(
          arm_args.get(usize(1)),
          .Some(ab) => {
            recur(ab, ctx, out);
          },
          .None => ()
        );
      });
      ci = (ci + usize(1));
    });
    return(());
  });
  if(ast_expr_is_fn_call_of(expr, "match", Option(usize).None), {
    (mi : usize) = usize(1);
    while(mi < call_args.len(), {
      arm := match(call_args.get(mi),.Some(a) => a,.None => make_err_expr());
      if(ast_expr_is_fn_call(arm) && ast_expr_is_fn_call_of(arm, "=>", Option(usize).Some(usize(2))), {
        arm_args := match(arm,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
        match(
          arm_args.get(usize(1)),
          .Some(ab) => {
            recur(ab, ctx, out);
          },
          .None => ()
        );
      });
      mi = (mi + usize(1));
    });
    return(());
  });
  // Pointer arithmetic — collect from the base.
  if(ast_expr_is_fn_call_of(expr, "&+", Option(usize).Some(usize(2))) ||
    ast_expr_is_fn_call_of(expr, "&-", Option(usize).Some(usize(2))), {
    match(
      call_args.get(usize(0)),
      .Some(b) => {
        recur(b, ctx, out);
      },
      .None => ()
    );
    return(());
  });
  // R3: borrowing call (incl. method dispatch) — collect from every argument
  // that can source the borrow (ref params + slice-source-capable params).
  is_method_call := ast_expr_is_fn_call_of(call_func, BF_DOT, Option(usize).Some(usize(2)));
  callee_ty_opt := match(
    _info(ctx, call_func),
    .Some(inf) => Option(TypeValue).Some(inf.ty),
    .None => lookup_method_callee_type(ast_expr_id(expr))
  );
  callee_ty := match(
    callee_ty_opt,
    .Some(t) => t,
    .None => {
      return(());
    }
  );
  if(!(is_function_type(callee_ty)), {
    return(());
  });
  param_types := match(callee_ty,.Func({ param_types : pts }) => pts, _ => ArrayList(TypeValue).new());
  param_is_ref := match(callee_ty,.Func({ param_is_ref : pir }) => pir, _ => ArrayList(bool).new());
  eff_args := ArrayList(AstExpr).new();
  if(is_method_call, {
    cf_args := match(call_func,.FnCall(_, _, a, _, _) => a, _ => ArrayList(AstExpr).new());
    match(
      cf_args.get(usize(0)),
      .Some(recv) => {
        _r := eff_args.push(recv);
      },
      .None => ()
    );
  });
  (ai : usize) = usize(0);
  while(ai < call_args.len(), {
    match(
      call_args.get(ai),
      .Some(a) => {
        _r := eff_args.push(a);
      },
      .None => ()
    );
    ai = (ai + usize(1));
  });
  (pi : usize) = usize(0);
  while(pi < param_types.len(), {
    p_is_ref := match(param_is_ref.get(pi),.Some(b) => b,.None => false);
    p_ty := match(param_types.get(pi),.Some(t) => t,.None => TypeValue.Unit);
    needs_check := (p_is_ref || type_may_provide_slice_source(p_ty));
    if(needs_check, {
      match(
        eff_args.get(pi),
        .Some(a) => {
          recur(a, ctx, out);
        },
        .None => ()
      );
    });
    pi = (pi + usize(1));
  });
});

/// Mirrors `findLiveBorrowerOfVariable` (src/evaluator/types/flowability.ts):
/// if `variable` is a borrow SOURCE constrained by a still-live
/// `ref(name) := …` binding, return that mark (liveness id-checked against
/// the current env so stale marks from exited blocks don't constrain).
find_live_borrower_of_variable :: (
  fn(variable : Variable, env : Environment) -> Option(RefBorrowMark)
)({
  (found : Option(RefBorrowMark)) = Option(RefBorrowMark).None;
  (rbi : usize) = usize(0);
  while(rbi < variable.ref_borrowed_by.len(), {
    match(
      variable.ref_borrowed_by.get(rbi),
      .Some(mark) => {
        live_refs := get_variables_from_env(env, mark.ref_name);
        (lri : usize) = usize(0);
        while(lri < live_refs.len(), {
          match(
            live_refs.get(lri),
            .Some(lr) => {
              if(lr.id == mark.ref_variable_id, {
                found = Option(RefBorrowMark).Some(mark);
              });
            },
            .None => ()
          );
          lri = (lri + usize(1));
        });
      },
      .None => ()
    );
    rbi = (rbi + usize(1));
  });
  found
});
/// Mirrors `aliasGroupRoot` (flowability.ts): follow
/// `is_owning_the_same_rc_value_as` links to the primary owner's id
/// (step-capped in place of TS's identity-set cycle guard).
alias_group_root :: (fn(variable : Variable) -> String)({
  (cur : Variable) = variable;
  (root_id : String) = variable.id.clone();
  (steps : usize) = usize(0);
  (done : bool) = false;
  while(!(done) && (steps < usize(64)), {
    match(
      cur.is_owning_the_same_rc_value_as,
      .Some(next_box) => {
        cur = next_box.*;
        root_id = cur.id.clone();
      },
      .None => {
        done = true;
      }
    );
    steps = (steps + usize(1));
  });
  root_id
});
/// Mirrors `collectAliasGroup` (flowability.ts): all live variables in
/// `env` that alias the same RC object as `variable` (same alias-group
/// root), including `variable` itself. Used by the borrow gate so
/// PRE-EXISTING aliases (`xs2 := xs` before the borrow) are constrained.
collect_alias_group :: (
  fn(variable : Variable, env : Environment) -> ArrayList(Variable)
)({
  root_id := alias_group_root(variable);
  group := ArrayList(Variable).new();
  group.push(variable);
  (fi : usize) = usize(0);
  while(fi < env.frames.len(), {
    match(
      env.frames.get(fi),
      .Some(frame) => {
        (vi : usize) = usize(0);
        while(vi < frame.variables.len(), {
          match(
            frame.variables.get(vi),
            .Some(v) => {
              if(!(v.id == variable.id), {
                if(alias_group_root(v) == root_id, {
                  group.push(v);
                });
              });
            },
            .None => ()
          );
          vi = (vi + usize(1));
        });
      },
      .None => ()
    );
    fi = (fi + usize(1));
  });
  group
});
/// Mirrors `requireNotLiveBorrowSourceForCall` (flowability.ts): while a
/// `ref(name) := …` binding borrows from a variable, the variable may not
/// be used as a method receiver or call argument — object reference
/// semantics make mutation signature-invisible, so any call could free or
/// move the borrowed backing
/// (issues/flowability-growth-invalidation-method-calls.md).
require_not_live_borrow_source_for_call :: (
  fn(expr : AstExpr, env : Environment, use_desc : str, exn : Exception) -> unit
)({
  if(!(ast_expr_is_atom(expr)), {
    return(());
  });
  atom_tok := ast_expr_token(expr);
  vars := get_variables_from_env(env, atom_tok.value);
  if(vars.len() == usize(0), {
    return(());
  });
  variable := match(
    vars.get(vars.len() - usize(1)),
    .Some(v) => v,
    .None => {
      return(());
    }
  );
  match(
    find_live_borrower_of_variable(variable, env),
    .Some(mark) => {
      exn.throw(
        dyn(
          format_error_message(
            atom_tok,
            `Cannot use "${atom_tok.value}" as ${use_desc} while 'ref(${mark.ref_name}) := …' borrows from it. A call could mutate it (e.g. grow/free the storage the reference points into) — method signatures on object types cannot prove otherwise.\n\nEnd the borrowing block first, or copy the element out (e.g. ".get(i)") instead of borrowing it.`,
            false,
            .None
          )
        )
      );
    },
    .None => ()
  );
});
export(
  FlowOptions,
  flow_options_default,
  is_flowable_expr,
  collect_ref_borrow_sources,
  flag_flow_violation,
  clear_flow_violation,
  flow_violation_pending,
  flow_violation_message,
  find_live_borrower_of_variable,
  alias_group_root,
  collect_alias_group,
  require_not_live_borrow_source_for_call,
  set_propagate_def_time_errors,
  propagate_def_time_errors
);
