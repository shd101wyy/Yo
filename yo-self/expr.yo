export(make_err_expr, ast_expr_token, ast_expr_id, ast_expr_is_atom, ast_expr_is_fn_call, ast_expr_is_atom_and_operator, ast_expr_is_infix_op_fn_call, ast_expr_to_string);
// ---------------------------------------------------------------------------
// Atom / FnCall predicate helpers (mirrors src/expr.ts exprIsAtomOf, etc.)
// ---------------------------------------------------------------------------
/// True if `e` is an Atom whose token value equals `value`.
/// Mirrors the `typeof values === "string"` branch of `exprIsAtomOf`.
ast_expr_is_atom_of :: (fn(e : AstExpr, value : str) -> bool)(
  match(
    e,
    .Atom(_, tok) => (tok.value == String.from(value)),
    .FnCall(_, _, _, _, _) => false
  )
);
/// True if `e` is an Atom whose token value is found in `values`.
/// Mirrors the `values.includes(expr.token.value)` branch of `exprIsAtomOf`.
ast_expr_is_atom_of_any :: (fn(e : AstExpr, values : ArrayList(str)) -> bool)(
  match(
    e,
    .Atom(_, tok) => {
      n := values.len();
      i := usize(0);
      while(i < n, {
        v := match(values.get(i),.Some(s) => s,.None => "~unreachable~");
        if(tok.value == String.from(v), {
          return(true);
        });
        i = (i + usize(1));
      });
      false
    },
    .FnCall(_, _, _, _, _) => false
  )
);
/// True if `e` is a FnCall whose func is an Atom equal to `func_name`,
/// and whose argument count equals `arg_count` (if `.Some`).
/// Mirrors `exprIsFunctionCallOf` in `src/expr.ts`.
ast_expr_is_fn_call_of :: (fn(e : AstExpr, func_name : str, arg_count : Option(usize)) -> bool)(
  match(
    e,
    .Atom(_, _) => false,
    .FnCall(_, func_box, args, _, _) => {
      func_name_matches := match(
        func_box.*,
        .Atom(_, tok) => (tok.value == String.from(func_name)),
        .FnCall(_, _, _, _, _) => false
      );
      if(!(func_name_matches), {
        return(false);
      });
      count_ok := match(
        arg_count,
        .None => true,
        .Some(n) => (args.len() == n)
      );
      count_ok
    }
  )
);
/// True if `e` is a FnCall whose func is an Atom found in `func_names`,
/// and whose argument count equals `arg_count` (if `.Some`).
/// Mirrors the `funcNames.includes(funcName)` branch of `exprIsFunctionCallOf`.
ast_expr_is_fn_call_of_any :: (fn(e : AstExpr, func_names : ArrayList(str), arg_count : Option(usize)) -> bool)(
  match(
    e,
    .Atom(_, _) => false,
    .FnCall(_, func_box, args, _, _) => {
      func_name_in_list := match(
        func_box.*,
        .Atom(_, tok) => {
          n := func_names.len();
          i := usize(0);
          found := false;
          while(i < n, {
            v := match(func_names.get(i),.Some(s) => s,.None => "~unreachable~");
            if(tok.value == String.from(v), {
              found = true;
              return(found);
            });
            i = (i + usize(1));
          });
          found
        },
        .FnCall(_, _, _, _, _) => false
      );
      if(!(func_name_in_list), {
        return(false);
      });
      count_ok := match(
        arg_count,
        .None => true,
        .Some(n) => (args.len() == n)
      );
      count_ok
    }
  )
);
/// Structural equality for two AstExpr nodes.
/// Atoms are equal if their token values are equal.
/// FnCalls are equal if their func and all args are recursively equal.
///
/// Mirrors `exprsAreEqual` in `src/expr.ts`.
exprs_are_equal :: (fn(e1 : AstExpr, e2 : AstExpr) -> bool)(
  match(
    e1,
    .Atom(_, tok1) => match(
      e2,
      .Atom(_, tok2) => (tok1.value == tok2.value),
      .FnCall(_, _, _, _, _) => false
    ),
    .FnCall(_, func1, args1, _, _) => match(
      e2,
      .Atom(_, _) => false,
      .FnCall(_, func2, args2, _, _) => {
        if(!(recur(func1.*, func2.*)), {
          return(false);
        });
        n1 := args1.len();
        n2 := args2.len();
        if(n1 != n2, {
          return(false);
        });
        i := usize(0);
        while(i < n1, {
          a1 := match(args1.get(i),.Some(a) => a,.None => make_err_expr());
          a2 := match(args2.get(i),.Some(a) => a,.None => make_err_expr());
          if(!(recur(a1, a2)), {
            return(false);
          });
          i = (i + usize(1));
        });
        true
      }
    )
  )
);
// ---------------------------------------------------------------------------
// Expr traversal helpers
// ---------------------------------------------------------------------------
/// True if `expr` introduces a new function/closure boundary and should NOT
/// be recursed into when scanning for unwind/return/await.
///
/// Mirrors `isFunctionBoundaryArrow` in `src/expr-traversal.ts`.
/// A simplified port: checks for `->`, `=>`, `=>>` operators, and the
/// `(fn(...) -> T)({body})` pattern (outer FnCall whose func is a fn-type call).
is_function_boundary_arrow :: (fn(e : AstExpr) -> bool)(
  match(
    e,
    .Atom(_, _) => false,
    .FnCall(_, func_box, _, _, _) => match(
      func_box.*,
      .Atom(_, tok) => {
        v := tok.value.clone();
        (v == "->") || ((v == "=>") || (v == "=>>"))
      },
      .FnCall(_, inner_func_box, _, _, _) => match(
        inner_func_box.*,
        .Atom(_, inner_tok) => {
          iv := inner_tok.value.clone();
          (iv == BK_FN) || ((iv == BK_UNSAFE_FN) || ((iv == BK_CTL) || (iv == BK_FN_TRAIT)))
        },
        .FnCall(_, _, _, _, _) => false
      )
    )
  )
);
/// Traverse an evaluated expression tree checking for an `unwind` keyword usage.
/// Skips new function/closure boundaries (`->`, `=>`, function type calls).
/// Recurses into `cond`/`match` branches without treating branch arrows as
/// function boundaries.
///
// `evaluated_body_contains_unwind` and `expr_tree_contains_return` were
// relocated to `./expr_traversal.yo` (mirrors `src/expr-traversal.ts`).
export(BK_FN, BK_UNSAFE_FN, BK_CTL, BK_FN_TRAIT, BK_ATOMIC, BK_OBJECT, BK_STRUCT, BK_NEWTYPE, BK_ENUM, BK_UNION);
